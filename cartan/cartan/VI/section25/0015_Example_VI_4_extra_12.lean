import Mathlib

-- Semantic recall note: no `lean_leansearch` tool was available in this runner, so the quotient
-- covering and quotient-homeomorphism APIs were verified directly from mathlib sources.

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open Complex

/-- The continuous map `z ↦ exp (2π i z)` from `ℂ` to the nonzero complex numbers. -/
def complex_two_pi_I_exp : C(ℂ, {w : ℂ // w ≠ 0}) where
  toFun z := ⟨exp ((2 * Real.pi * I) * z), exp_ne_zero _⟩
  continuous_toFun :=
    (continuous_exp.comp <| continuous_const.mul continuous_id).subtype_mk
      fun z ↦ exp_ne_zero ((2 * Real.pi * I) * z)

/-- The fibers of `complex_two_pi_I_exp` are exactly the cosets of the integer lattice
generated by `1 : ℂ`. -/
theorem complex_two_pi_I_exp_ker_iff (z w : ℂ) :
    Setoid.ker complex_two_pi_I_exp z w ↔
      QuotientAddGroup.leftRel (AddSubgroup.zmultiples (1 : ℂ)) z w := by
  -- Compare equality of exponential values with the standard period relation for `exp`.
  change ((⟨exp ((2 * Real.pi * I) * z), exp_ne_zero _⟩ : {w : ℂ // w ≠ 0}) =
      ⟨exp ((2 * Real.pi * I) * w), exp_ne_zero _⟩) ↔
    QuotientAddGroup.leftRel (AddSubgroup.zmultiples (1 : ℂ)) z w
  rw [Subtype.ext_iff, eq_comm, Complex.exp_eq_exp_iff_exists_int,
    QuotientAddGroup.leftRel_apply, AddSubgroup.mem_zmultiples_iff]
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    have hmul : (2 * Real.pi * I) * w = (2 * Real.pi * I) * (z + n) := by
      calc
        (2 * Real.pi * I) * w = (2 * Real.pi * I) * z + (n : ℂ) * (2 * Real.pi * I) := hn
        _ = (2 * Real.pi * I) * z + (2 * Real.pi * I) * n := by
              rw [mul_comm (n : ℂ) (2 * Real.pi * I)]
        _ = (2 * Real.pi * I) * (z + n) := by rw [mul_add]
    have hzw : w = z + n := mul_left_cancel₀ Complex.two_pi_I_ne_zero hmul
    simpa [zsmul_eq_mul, eq_add_neg_iff_add_eq, add_comm] using hzw.symm
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    have hzw : z + n = w := by
      simpa [zsmul_eq_mul, eq_add_neg_iff_add_eq, add_comm] using hn
    rw [← hzw, mul_add, mul_comm (2 * Real.pi * I) (n : ℂ)]

/-- Helper for Example VI.4-extra-12: the rescaled complex exponential is surjective onto
the nonzero complex numbers. -/
lemma complex_two_pi_I_exp_surjective : Function.Surjective complex_two_pi_I_exp := by
  intro z
  refine ⟨Complex.log z / (2 * Real.pi * I), ?_⟩
  -- The logarithm provides a representative whose exponential recovers `z`.
  apply Subtype.ext
  change exp ((2 * Real.pi * I) * (Complex.log z / (2 * Real.pi * I))) = z
  have hmul : (2 * Real.pi * I) * (Complex.log z / (2 * Real.pi * I)) = Complex.log z := by
    field_simp [Complex.two_pi_I_ne_zero]
  rw [hmul]
  exact Complex.exp_log z.2

/-
`Complex.isAddQuotientCoveringMap_exp` is the core owner theorem in mathlib: it treats
`Complex.exp` as the quotient covering by the period lattice generated by `2 * π * I`.
This file keeps the textbook rescaling to period `1` as the source-facing example.
-/
/-- Example VI.4-extra-12 (1): the map `z ↦ exp (2π i z)` is the quotient covering map whose
fibers are the translates of the subgroup `ℤ ⊆ ℂ` generated by `1`. -/
theorem complex_two_pi_I_exp_isAddQuotientCoveringMap :
    IsAddQuotientCoveringMap complex_two_pi_I_exp
      (AddSubgroup.zmultiples (1 : ℂ)) := by
  -- Follow the owner proof for `Complex.exp`, with the source rescaled by `2π i`.
  refine Topology.IsQuotientMap.isAddQuotientCoveringMap_of_addSubgroup ?_
    _ ⟨NormedSpace.discreteTopology_zmultiples _⟩ fun {z w} ↦ ?_
  · refine IsOpenMap.isQuotientMap ?_ (by fun_prop) complex_two_pi_I_exp_surjective
    refine (IsOpen.isOpenEmbedding_subtypeVal isClosed_singleton.1).isOpenMap_iff.mpr ?_
    -- Openness comes from the open mapping theorem for `exp` after multiplying by `2π i`.
    simpa [smul_eq_mul] using
      Complex.isOpenMap_exp.comp (isOpenMap_smul₀ Complex.two_pi_I_ne_zero)
  · -- The fibres are exactly the cosets of the integer lattice generated by `1`.
    simpa [QuotientAddGroup.leftRel_apply, sub_eq_add_neg, add_comm] using
      (complex_two_pi_I_exp_ker_iff z w)

/-- Example VI.4-extra-12 (2): passing to the quotient by the subgroup generated by `1 : ℂ`
induces a homeomorphism from `ℂ / ℤ` onto the nonzero complex numbers. -/
def complex_mod_integer_exp_homeomorph :
    (ℂ ⧸ AddSubgroup.zmultiples (1 : ℂ)) ≃ₜ {w : ℂ // w ≠ 0} :=
  (Homeomorph.Quotient.congrRight fun z w ↦ (complex_two_pi_I_exp_ker_iff z w).symm).trans <|
    Topology.IsQuotientMap.homeomorph
      complex_two_pi_I_exp_isAddQuotientCoveringMap.toIsQuotientMap

/-- The induced homeomorphism sends the class of `z` to `exp (2π i z)`. -/
theorem complex_mod_integer_exp_homeomorph_apply_mk (z : ℂ) :
    complex_mod_integer_exp_homeomorph (QuotientAddGroup.mk z) =
      ⟨exp ((2 * Real.pi * I) * z), exp_ne_zero _⟩ := by
  -- Unfold the quotient construction and evaluate both quotient identifications on `z`.
  unfold complex_mod_integer_exp_homeomorph
  change complex_two_pi_I_exp_isAddQuotientCoveringMap.toIsQuotientMap.homeomorph
      (Quotient.mk (Setoid.ker complex_two_pi_I_exp) z) =
    ⟨exp ((2 * Real.pi * I) * z), exp_ne_zero _⟩
  unfold Topology.IsQuotientMap.homeomorph Setoid.quotientKerEquivOfSurjective
    Setoid.quotientKerEquivOfRightInverse
  rfl

/-- Example VI.4-extra-12 (3): the induced homeomorphism intertwines addition on `ℂ / ℤ`
with multiplication on the nonzero complex numbers, giving the topological-group isomorphism
described in the text. -/
theorem complex_mod_integer_exp_homeomorph_map_add
    (z w : ℂ ⧸ AddSubgroup.zmultiples (1 : ℂ)) :
    (complex_mod_integer_exp_homeomorph (z + w) : ℂ) =
      complex_mod_integer_exp_homeomorph z * complex_mod_integer_exp_homeomorph w := by
  -- Reduce to representatives and compute with the exponential addition formula.
  refine Quotient.inductionOn₂ z w fun z w ↦ ?_
  change (complex_mod_integer_exp_homeomorph (QuotientAddGroup.mk (z + w)) : ℂ) =
    complex_mod_integer_exp_homeomorph (QuotientAddGroup.mk z) *
      complex_mod_integer_exp_homeomorph (QuotientAddGroup.mk w)
  rw [complex_mod_integer_exp_homeomorph_apply_mk, complex_mod_integer_exp_homeomorph_apply_mk,
    complex_mod_integer_exp_homeomorph_apply_mk]
  simp [mul_add, Complex.exp_add]
