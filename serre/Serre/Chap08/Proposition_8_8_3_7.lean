import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v w

section

open Representation

variable {p : ℕ}
variable {k : Type u} [CommRing k] [CharP k p] [Fact p.Prime]
variable {G : Type v} [Group G] [Finite G]
variable {V : Type w} [AddCommGroup V] [Module k V] [Nontrivial V]

/-- Proposition 8-8.3-7: for a representation of a finite `p`-group on a nonzero module over a
commutative ring of characteristic `p`, the submodule of invariant vectors is nontrivial. -/
-- Proof sketch: choose a nonzero vector, take the additive subgroup generated by its finite
-- `G`-orbit, apply the fixed-point congruence for `p`-group actions from Lemma 8-8.3-6 to obtain a
-- nonzero fixed point, and regard it as a vector in `ρ.invariants`.
theorem invariants_ne_bot_of_isPGroup_charP (ρ : Representation k G V) (hG : IsPGroup p G) :
    ρ.invariants ≠ ⊥ := by
  classical
  letI : Fintype G := Fintype.ofFinite G
  obtain ⟨x, hx⟩ := exists_ne (0 : V)
  letI : MulAction G V :=
    { smul := fun g v ↦ ρ g v
      one_smul := by
        intro v
        change (ρ 1) v = v
        rw [map_one]
        rfl
      mul_smul := by
        intro g h v
        change (ρ (g * h)) v = (ρ g) ((ρ h) v)
        rw [map_mul]
        rfl }
  letI : Algebra (ZMod p) k := ZMod.algebra k p
  letI : Module (ZMod p) V := Module.compHom V (algebraMap (ZMod p) k)
  let orbit : Set V := Set.range fun g : G ↦ ρ g x
  let W : Submodule (ZMod p) V := Submodule.span (ZMod p) orbit
  have hxW : x ∈ W := Submodule.subset_span ⟨1, by simp⟩
  have hW_stable : ∀ g y, y ∈ W → ρ g y ∈ W := by
    intro g y hy
    induction hy using Submodule.span_induction with
    | mem z hz =>
        rcases hz with ⟨s, rfl⟩
        exact Submodule.subset_span ⟨g * s, by simp [map_mul]⟩
    | zero =>
        simp
    | add u v _ _ hu hv =>
        simpa [map_add] using Submodule.add_mem W hu hv
    | smul a u _ hu =>
        simpa using Submodule.smul_mem W a hu
  letI : FiniteDimensional (ZMod p) W := FiniteDimensional.span_of_finite (ZMod p)
    (Set.finite_range fun g : G ↦ ρ g x)
  letI : Finite W := Module.finite_of_finite (ZMod p)
  have hxW0 : (⟨x, hxW⟩ : W) ≠ 0 := by
    intro h
    exact hx <| by simpa using congrArg Subtype.val h
  letI : Nontrivial W := ⟨⟨x, hxW⟩, 0, hxW0⟩
  letI : SMul G W := ⟨fun g y ↦ ⟨ρ g y.1, hW_stable g y.1 y.2⟩⟩
  letI : MulAction G W := Subtype.coe_injective.mulAction Subtype.val fun _ _ ↦ rfl
  have hW0 : (0 : W) ∈ MulAction.fixedPoints G W := by
    rw [MulAction.mem_fixedPoints]
    intro g
    ext
    change (ρ g) 0 = 0
    simp
  have hcard : p ∣ Nat.card W := by
    rw [← FiniteField.pow_finrank_eq_natCard p W]
    exact dvd_pow_self p (Nat.ne_zero_of_lt Module.finrank_pos)
  obtain ⟨y, hy, hy0⟩ := hG.exists_fixed_point_of_prime_dvd_card_of_fixed_point W hcard hW0
  have hy_mem : y.1 ∈ ρ.invariants := by
    rw [ρ.mem_invariants y.1]
    intro g
    exact congrArg Subtype.val ((MulAction.mem_fixedPoints.mp hy) g)
  have hy_ne_zero : y.1 ≠ 0 := fun h ↦ hy0 (Subtype.ext h.symm)
  exact ρ.invariants.ne_bot_iff.mpr ⟨y.1, hy_mem, hy_ne_zero⟩

-- The equivalent source-facing existence form is obtained directly from `Submodule.ne_bot_iff`
-- together with `Representation.mem_invariants`, so we do not keep a separate wrapper theorem.

end
