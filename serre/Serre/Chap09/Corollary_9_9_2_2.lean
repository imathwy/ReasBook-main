namespace Subgroup

section

variable {G : Type u} [Group G] [Finite G]

/-- The finite family of cyclic subgroups of a finite group. -/
abbrev cyclicSubgroups (G : Type u) [Group G] [Finite G] : Finset (Subgroup G) := by
  classical
  let _ : Fintype G := Fintype.ofFinite G
  exact Finset.univ.filter fun H : Subgroup G ↦ IsCyclic H

@[simp] theorem mem_cyclicSubgroups {H : Subgroup G} :
    H ∈ cyclicSubgroups G ↔ IsCyclic H := by
  classical
  simp [cyclicSubgroups]

end

end Subgroup

section

variable {G : Type u} [Group G] [Finite G]

/-- The cyclic subgroups of a finite group form a conjugacy cover. -/
theorem Subgroup.is_conjugacy_cover_cyclicSubgroups :
    is_conjugacy_cover (Subgroup.cyclicSubgroups G) := by
  rw [is_conjugacy_cover_iff]
  intro g
  refine ⟨Subgroup.zpowers g, Subgroup.mem_cyclicSubgroups.2 inferInstance, ?_⟩
  exact Group.subset_conjugatesOfSet (Subgroup.mem_zpowers g)

end

namespace Representation

section

variable {G : Type} [Group G] [Finite G]
variable {A : Type} [CommSemiring A] [Algebra A ℂ]

local instance instFintypeGCyclicInducedCharacterSpan : Fintype G := Fintype.ofFinite G
local instance instFintypeSubgroupCyclicInducedCharacterSpan (H : Subgroup G) : Fintype H :=
  Fintype.ofFinite H

-- Source/core/bridge triage:
-- * source-facing: the ambient `A`-span of characters induced from cyclic subgroups.
-- * core/canonical: the owner submodule `cyclicInducedCharacterSubmodule G ⊆ R(G)`.
-- * bridge/view: `cyclicInducedCharacterSpan A G`, the ambient realization in `G → ℂ`.
--
-- Primitive data: the canonical induction maps `R(H) → R(G)` for cyclic subgroups `H`.
-- Derived API: the owner submodule in `R(G)` and its ambient scalar-span in complex functions.
/-- The cyclic specialization of the Chapter 9 Artin-induction owner submodule. -/
abbrev cyclicInducedCharacterSubmodule (G : Type) [Group G] [Finite G] : Submodule ℤ (R(G)) :=
  artinInducedCharacterSubmodule (Subgroup.cyclicSubgroups G)

/-- The `A`-submodule of complex-valued functions on `G` generated by the characters induced from
the integral character rings of cyclic subgroups of `G`. -/
def cyclicInducedCharacterSpan (A : Type) [CommSemiring A] [Algebra A ℂ]
    (G : Type) [Group G] [Finite G] : Submodule A (G → ℂ) :=
  Submodule.span A (((↑) : R(G) → G → ℂ) '' (cyclicInducedCharacterSubmodule G : Set (R(G))))

/-- Every class function induced from the character ring of a cyclic subgroup belongs to the cyclic
induced-character span. -/
theorem inducedClassFunction_mem_cyclicInducedCharacterSpan
    (H : Subgroup G) (hH : IsCyclic H) (χ : R(H)) :
    Ind[H]((χ : H → ℂ)) ∈ cyclicInducedCharacterSpan A G := by
  rw [cyclicInducedCharacterSpan]
  refine Submodule.subset_span ?_
  refine ⟨H.characterRingInduction χ, ?_, ?_⟩
  · simpa [cyclicInducedCharacterSubmodule] using
      (show H.characterRingInduction χ ∈
          artinInducedCharacterSubmodule (Subgroup.cyclicSubgroups G) from
        (show LinearMap.range H.characterRingInduction ≤
            artinInducedCharacterSubmodule (Subgroup.cyclicSubgroups G) from
          le_iSup (fun K : Subgroup.cyclicSubgroups G ↦
            LinearMap.range K.1.characterRingInduction)
            ⟨H, Subgroup.mem_cyclicSubgroups.2 hH⟩) ⟨χ, rfl⟩)
  · ext g
    simp [Subgroup.characterRingInduction_apply]

end

end Representation

