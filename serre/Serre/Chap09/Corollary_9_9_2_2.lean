variable {G : Type} [Group G] [Finite G]

local instance instFintypeGCor9922 : Fintype G := Fintype.ofFinite G

-- Proof sketch: specialize the owner-level theorem
-- `is_conjugacy_cover_iff_characterRingScalarExtension_eq_span_induced` to the family of cyclic
-- subgroups of `G`, which is a conjugacy cover because each element generates a cyclic subgroup.
-- Then pass from the owner-level rationalized subgroup characters to the source-facing span of
-- induced genuine subgroup characters for cyclic subgroups, and rewrite the result as
-- `cyclicInducedCharacterSpan ℚ G`.
/-- Corollary 9-9.2-2: each character of a finite group belongs to the `ℚ`-span of the characters
induced from characters of cyclic subgroups. -/
theorem character_mem_ratSpan_inducedCharacter_from_cyclicSubgroups
    (V : FDRep ℂ G) :
    V.character ∈ cyclicInducedCharacterSpan ℚ G := by
  have hspan :
      characterRingScalarExtension ℚ G = cyclicInducedCharacterSpan ℚ G := by
    simpa [cyclicInducedCharacterSpan, artinInducedCharacterSpan] using
      (is_conjugacy_cover_iff_characterRingScalarExtension_eq_span_induced
        (Subgroup.cyclicSubgroups G)).1
        Subgroup.is_conjugacy_cover_cyclicSubgroups
  have hV : V.character ∈ characterRingScalarExtension ℚ G :=
    mem_characterRingScalarExtension_of_mem_characterRing V.character
      (rep_character_mem_characterRing (Rep.of V.ρ))
  simpa [hspan] using hV

end
