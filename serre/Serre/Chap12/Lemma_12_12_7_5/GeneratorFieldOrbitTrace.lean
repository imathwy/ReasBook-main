import Serre.Chap12.Lemma_12_12_7_5.GeneratorFieldModel

open Representation
open scoped Pointwise Representation

noncomputable section

universe u v w

section Representation

variable {G : Type u} [Group G] [Finite G]
variable {L : Type v} [Field L] [NumberField L]
variable [IsCyclotomicExtension {Monoid.exponent G} ℚ L]
variable (K : IntermediateField ℚ L) (x : G)

/-- Helper for Lemma 12-12.7-5: a private `Fintype` witness for the finite group `G`. -/
@[reducible] private def instFintypeAssociatedGammaPElementaryGroup : Fintype G :=
  Fintype.ofFinite G

attribute [local instance] instFintypeAssociatedGammaPElementaryGroup

local notation "ΓK" => Γ[K](G)
local notation "N(" x ")" => N[ΓK](x)
local notation "C" => Subgroup.zpowers x

/-- Helper for Lemma 12-12.7-5: Serre's generator field `K(β(x))` is finite-dimensional over
`K`, because it is generated by one algebraic character value. -/
@[reducible] private def instFiniteDimensionalLemma121275GeneratorFieldCarrier
    (β : C →* (AlgebraicClosure K)ˣ) :
    FiniteDimensional K (generatorFieldCarrier (K := K) (x := x) β) :=
  IntermediateField.adjoin.finiteDimensional
    ((generatorField_generator_isAlgebraic (K := K) (x := x) β).isIntegral)

attribute [local instance] instFiniteDimensionalLemma121275GeneratorFieldCarrier

/-- Helper for Lemma 12-12.7-5: a concrete `Fintype` witness for the `K`-embeddings of Serre's
generator field into the algebraic closure. -/
@[reducible] private def instFintypeLemma121275GeneratorFieldEmbeddings
    (β : C →* (AlgebraicClosure K)ˣ) :
    Fintype (generatorFieldCarrier (K := K) (x := x) β →ₐ[K] AlgebraicClosure K) :=
  minpoly.AlgHom.fintype K (generatorFieldCarrier (K := K) (x := x) β) (AlgebraicClosure K)

attribute [local instance] instFintypeLemma121275GeneratorFieldEmbeddings

/-- Helper for Lemma 12-12.7-5: the source-faithful generator-field model records the action of
the distinguished generator `x` by the field trace of the corresponding character value. -/
theorem generatorField_model_generator_character_eq_trace
    (β : C →* (AlgebraicClosure K)ˣ) :
    (generatorField_linearCharacter_representation (K := K) (x := x) β).character
        (zpowers_generator (x := x)) =
      Algebra.trace K (generatorFieldCarrier (K := K) (x := x) β)
        (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) := by
  -- This local alias keeps the source route explicit in the target file: the generator action is
  -- already reduced to a field-trace computation on `K(β(x))`.
  simpa using
    generatorField_linearCharacter_character_generator_eq_trace (K := K) (x := x) β

/-- Helper for Lemma 12-12.7-5: scalar extension to `AlgebraicClosure K` transports a
`K`-character by applying the coefficient map pointwise. -/
theorem scalarExtension_character_eq_map_to_algClosure
    {H : Type*} [Group H] [Finite H]
    {W : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    (τ : Representation K H W) :
    (Representation.scalarExtension (k := AlgebraicClosure K) τ).character =
      fun g ↦ algebraMap K (AlgebraicClosure K) (τ.character g) := by
  -- The base-changed trace is the coefficientwise image of the original trace.
  ext g
  exact LinearMap.trace_baseChange (τ g) (AlgebraicClosure K)

/-- Helper for Lemma 12-12.7-5: after normalizing an element of `C = ⟨x⟩` to a power of the
distinguished generator, the generator-field character is still given by the same trace formula. -/
theorem generatorField_model_character_eq_trace_on_generator_powers
    (β : C →* (AlgebraicClosure K)ˣ) (n : ℤ) :
    (generatorField_linearCharacter_representation (K := K) (x := x) β).character
        ((zpowers_generator (x := x)) ^ n) =
      Algebra.trace K (generatorFieldCarrier (K := K) (x := x) β)
        (⟨(((β ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            ((zpowers_generator (x := x)) ^ n)⟩ :
            generatorFieldCarrier (K := K) (x := x) β) := by
  -- This is the power-normal form required by the source proof before comparing orbit traces.
  simpa using
    generatorField_linearCharacter_character_eq_trace (K := K) (x := x) β
      ((zpowers_generator (x := x)) ^ n)

/-- Helper for Lemma 12-12.7-5: after passing to the algebraic closure, the character of Serre's
generator-field model on a power of `x` is the sum of the corresponding embeddings of
`β(x^n)` from `K(β(x))`. -/
theorem generatorField_model_character_eq_sum_embeddings_on_generator_powers
    (β : C →* (AlgebraicClosure K)ˣ) (n : ℤ) :
    algebraMap K (AlgebraicClosure K)
        ((generatorField_linearCharacter_representation (K := K) (x := x) β).character
          ((zpowers_generator (x := x)) ^ n)) =
      ∑ σ : generatorFieldCarrier (K := K) (x := x) β →ₐ[K] AlgebraicClosure K,
        σ (⟨((β ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            ((zpowers_generator (x := x)) ^ n)⟩ :
            generatorFieldCarrier (K := K) (x := x) β) := by
  -- First rewrite the character as a field trace on `K(β(x))`; then convert that trace into the
  -- sum over all `K`-embeddings of the same simple field.
  let a : generatorFieldCarrier (K := K) (x := x) β :=
    ⟨((β ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K),
      linear_character_value_mem_generatorField (K := K) (x := x) β
        ((zpowers_generator (x := x)) ^ n)⟩
  have htrace :
      algebraMap K (AlgebraicClosure K)
          (Algebra.trace K (generatorFieldCarrier (K := K) (x := x) β) a) =
        ∑ σ : generatorFieldCarrier (K := K) (x := x) β →ₐ[K] AlgebraicClosure K, σ a := by
    simpa [a] using
      (trace_eq_sum_embeddings
        (K := K)
        (L := generatorFieldCarrier (K := K) (x := x) β)
        (E := AlgebraicClosure K)
        (x := a))
  rw [generatorField_model_character_eq_trace_on_generator_powers (K := K) (x := x) β n]
  simpa [a] using htrace

/-- Helper for Lemma 12-12.7-5: the generator case of the orbit-trace comparison is the `n = 1`
specialization of the power formula. -/
theorem generatorField_model_generator_character_eq_sum_embeddings
    (β : C →* (AlgebraicClosure K)ˣ) :
    algebraMap K (AlgebraicClosure K)
        ((generatorField_linearCharacter_representation (K := K) (x := x) β).character
          (zpowers_generator (x := x))) =
      ∑ σ : generatorFieldCarrier (K := K) (x := x) β →ₐ[K] AlgebraicClosure K,
        σ (⟨((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) := by
  -- This keeps the source generator `β(x)` visible before the full power-indexed orbit sum is
  -- used later in the irreducible comparison.
  simpa using
    generatorField_model_character_eq_sum_embeddings_on_generator_powers
      (K := K) (x := x) β (1 : ℤ)

/-- Helper for Lemma 12-12.7-5: evaluating a `Γ_K`-power twist at an element of `C = ⟨x⟩`
amounts to raising the original character value to the corresponding power. -/
theorem linearCharacter_twist_apply_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c : C) :
    linearCharacter_twist (G := G) (K := K) (x := x) β t c =
      β c ^ galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ) := by
  -- Unfold the twist only far enough to read it as precomposition by the power endomorphism.
  change β (c ^ galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) = _
  rw [map_pow]

/-- Helper for Lemma 12-12.7-5: on the fixed carrier `K(β(x))`, the twisted value of the
distinguished generator is the corresponding `Γ_K`-power of the original generator value. -/
theorem twisted_generator_value_eq_generator_power_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        linearCharacter_twist_value_mem_generatorField_public
          (G := G) (K := K) (x := x) β t (zpowers_generator (x := x))⟩ :
      generatorFieldCarrier (K := K) (x := x) β) =
      (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        linear_character_value_mem_generatorField (K := K) (x := x) β
          (zpowers_generator (x := x))⟩ :
        generatorFieldCarrier (K := K) (x := x) β) ^
        galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ) := by
  -- This rewrites the target twisted generator entirely inside the fixed simple field `K(β(x))`.
  apply Subtype.ext
  simp [linearCharacter_twist_apply_local]

/-- Helper for Lemma 12-12.7-5: the twisted value of the distinguished generator is still
integral over `K`, because it is a power of the original generator value. -/
theorem twisted_generator_value_isIntegral_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    IsIntegral K
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) := by
  -- After rewriting to a power of `β(x)`, integrality is preserved by taking powers.
  rw [linearCharacter_twist_apply_local]
  exact (generatorField_generator_isAlgebraic (K := K) (x := x) β).isIntegral.pow _

/-- Helper for Lemma 12-12.7-5: any chosen root of the generator minimal polynomial defines the
universal `K`-algebra map out of Serre's simple field `K(β(x))`. -/
noncomputable def generatorField_algHom_of_generator_root
    (β : C →* (AlgebraicClosure K)ˣ)
    {a : AlgebraicClosure K}
    (ha : a ∈
      (minpoly K
        (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K))).aroots (AlgebraicClosure K)) :
    generatorFieldCarrier (K := K) (x := x) β →ₐ[K] AlgebraicClosure K :=
  (IntermediateField.algHomAdjoinIntegralEquiv K
      (generatorField_generator_isAlgebraic (K := K) (x := x) β).isIntegral).symm ⟨a, ha⟩

/-- Helper for Lemma 12-12.7-5: the universal map associated to a chosen root sends the
distinguished generator of `K(β(x))` to that root. -/
theorem generatorField_algHom_of_generator_root_apply_generator
    (β : C →* (AlgebraicClosure K)ˣ)
    {a : AlgebraicClosure K}
    (ha : a ∈
      (minpoly K
        (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K))).aroots (AlgebraicClosure K)) :
    generatorField_algHom_of_generator_root (K := K) (x := x) β ha
        (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) =
      a := by
  -- Route correction: this packages the simple-field universal property once, so the remaining
  -- source-faithful blockers can use a named map instead of rebuilding the adjoin machinery.
  simpa [generatorField_algHom_of_generator_root] using
    IntermediateField.algHomAdjoinIntegralEquiv_symm_apply_gen K
      (generatorField_generator_isAlgebraic (K := K) (x := x) β).isIntegral ⟨a, ha⟩

/-- Helper for Lemma 12-12.7-5: if two `Γ_K`-power witnesses send the distinguished generator `x`
to the same power, then the corresponding twisted linear characters agree on that generator. -/
theorem generator_twist_eq_of_generator_power_eq_local
    (β : C →* (AlgebraicClosure K)ˣ) {t u : ΓK}
    (hxu : (x ^ t : G) = x ^ u) :
    linearCharacter_twist (G := G) (K := K) (x := x) β t
        (zpowers_generator (x := x)) =
      linearCharacter_twist (G := G) (K := K) (x := x) β u
        (zpowers_generator (x := x)) := by
  -- On the cyclic generator, equality of the two power witnesses becomes equality in `C`.
  change
    β ((zpowers_generator (x := x)) ^
        galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) =
      β ((zpowers_generator (x := x)) ^
        galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ))
  apply congrArg β
  apply Subtype.ext
  simpa [pow_subgroup_eq_pow_nat] using hxu

/-- Helper for Lemma 12-12.7-5: if two `Γ_K`-power witnesses send `x` to the same power, then
they induce the same twisted linear character on all of `C = ⟨x⟩`. -/
theorem linearCharacter_twist_eq_of_generator_power_eq_local
    (β : C →* (AlgebraicClosure K)ˣ) {t u : ΓK}
    (hxu : (x ^ t : G) = x ^ u) :
    linearCharacter_twist (G := G) (K := K) (x := x) β t =
      linearCharacter_twist (G := G) (K := K) (x := x) β u := by
  -- A linear character of the cyclic group is determined by its value on the distinguished
  -- generator, so it suffices to compare the two twists on powers of that generator.
  ext c
  rcases Subgroup.mem_zpowers_iff.mp c.2 with ⟨n, hn⟩
  have hc : c = (zpowers_generator (x := x)) ^ n := by
    apply Subtype.ext
    simpa using hn.symm
  have hgen_cast :
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) =
        (((linearCharacter_twist (G := G) (K := K) (x := x) β u
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) := by
    exact congrArg (fun a : (AlgebraicClosure K)ˣ ↦ (a : AlgebraicClosure K))
      (generator_twist_eq_of_generator_power_eq_local (G := G) (K := K) (x := x) β hxu)
  simpa [hc, linearCharacter_twist_apply_local, map_zpow, zpow_natCast, zpow_mul, mul_comm] using
    congrArg (fun a : AlgebraicClosure K ↦ a ^ n) hgen_cast

/-- Helper for Lemma 12-12.7-5: once two `Γ_K`-power witnesses agree on the distinguished
generator, the corresponding fixed-carrier twisted cyclic representations are literally the same.
-/
theorem generatorField_twisted_linearCharacter_representation_eq_of_generator_power_eq_local
    (β : C →* (AlgebraicClosure K)ˣ) {t u : ΓK}
    (hxu : (x ^ t : G) = x ^ u) :
    generatorField_twisted_linearCharacter_representation
        (G := G) (K := K) (x := x) β t =
      generatorField_twisted_linearCharacter_representation
        (G := G) (K := K) (x := x) β u := by
  -- The fixed carrier `K(β(x))` is unchanged; only the multiplier coming from the twisted
  -- character depends on the chosen witness, and that multiplier is already witness-independent.
  ext c z
  have htwist :
      linearCharacter_twist (G := G) (K := K) (x := x) β t c =
        linearCharacter_twist (G := G) (K := K) (x := x) β u c := by
    exact
      congrArg (fun γ : C →* (AlgebraicClosure K)ˣ ↦ γ c)
        (linearCharacter_twist_eq_of_generator_power_eq_local
          (G := G) (K := K) (x := x) β hxu)
  simpa [generatorField_twisted_linearCharacter_representation, htwist]

/-- Helper for Lemma 12-12.7-5: the same witness-independence can be read on the fixed-carrier
characters after restricting the twisted action to `K(β(x))`. -/
theorem generatorField_twisted_linearCharacter_character_eq_of_generator_power_eq_local
    (β : C →* (AlgebraicClosure K)ˣ) {t u : ΓK}
    (hxu : (x ^ t : G) = x ^ u) :
    (generatorField_twisted_linearCharacter_representation
        (G := G) (K := K) (x := x) β t).character =
      (generatorField_twisted_linearCharacter_representation
        (G := G) (K := K) (x := x) β u).character := by
  -- Character equality is now a direct corollary of representation equality on the fixed
  -- carrier, so later witness-independence arguments can stay at the representation level.
  simpa [generatorField_twisted_linearCharacter_representation_eq_of_generator_power_eq_local
    (G := G) (K := K) (x := x) β hxu]

/-- Helper for Lemma 12-12.7-5: on the fixed carrier `K(β(x))`, the twisted cyclic action still
has character given by the field trace of the twisted multiplier. -/
theorem generatorField_twisted_linearCharacter_character_eq_trace_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c : C) :
    (generatorField_twisted_linearCharacter_representation
        (G := G) (K := K) (x := x) β t).character c =
      Algebra.trace K (generatorFieldCarrier (K := K) (x := x) β)
        (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
            (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          linearCharacter_twist_value_mem_generatorField_public
            (G := G) (K := K) (x := x) β t c⟩ :
            generatorFieldCarrier (K := K) (x := x) β) := by
  -- The fixed-carrier twisted model is defined by left multiplication with the twisted value.
  rw [Representation.character, generatorField_twisted_linearCharacter_representation,
    Algebra.trace_apply]
  rfl

/-- Helper for Lemma 12-12.7-5: if two `Γ_K`-witnesses describe the same conjugation action on
the distinguished generator `x`, then they induce the same fixed-carrier twisted cyclic model. -/
theorem generatorField_twisted_linearCharacter_representation_eq_of_same_conjugation_local
    (β : C →* (AlgebraicClosure K)ˣ) {y : G} {t u : ΓK}
    (ht : y * x * y⁻¹ = x ^ t) (hu : y * x * y⁻¹ = x ^ u) :
    generatorField_twisted_linearCharacter_representation
        (G := G) (K := K) (x := x) β t =
      generatorField_twisted_linearCharacter_representation
        (G := G) (K := K) (x := x) β u := by
  -- The witness-independence step is reduced to equality of the two induced powers of `x`.
  exact
    generatorField_twisted_linearCharacter_representation_eq_of_generator_power_eq_local
      (G := G) (K := K) (x := x) β (ht.symm.trans hu)

end Representation
