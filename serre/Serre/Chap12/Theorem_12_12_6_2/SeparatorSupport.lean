import Mathlib

noncomputable section

universe v

namespace Representation

section

variable {A : Type v} [CommRing A]

/-- Helper for Theorem 12-12.6-2: a natural number coprime to `p` stays outside every prime ideal
of `A` containing the principal ideal generated by `p`. This is the coefficient-ring input used
by Serre's separator argument. -/
lemma nat_cast_not_mem_primeIdealOverPrime_of_coprime
    (p m : ℕ) (hcop : Nat.Coprime p m) (Q : PrimeSpectrum A)
    (hQ : Ideal.span {(p : A)} ≤ Q.asIdeal) :
    (m : A) ∉ Q.asIdeal := by
  -- Use the Bézout identity for `p` and `m`; if both lay in the prime ideal, then so would `1`.
  have hp_mem : (p : A) ∈ Q.asIdeal := by
    exact hQ (Ideal.subset_span (by simp))
  intro hm_mem
  have hbezZ :
      (1 : ℤ) = p * Nat.gcdA p m + m * Nat.gcdB p m := by
    simpa [hcop.gcd_eq_one] using (Nat.gcd_eq_gcd_ab p m)
  have hbezA :
      (1 : A) = (p : A) * (Nat.gcdA p m : A) + (m : A) * (Nat.gcdB p m : A) := by
    simpa using congrArg (fun z : ℤ ↦ (z : A)) hbezZ
  have h1_mem : (1 : A) ∈ Q.asIdeal := by
    rw [hbezA]
    refine Q.asIdeal.add_mem ?_ ?_
    · exact Q.asIdeal.mul_mem_right _ hp_mem
    · exact Q.asIdeal.mul_mem_right _ hm_mem
  have htop : Q.asIdeal = ⊤ :=
    Ideal.eq_top_of_isUnit_mem Q.asIdeal h1_mem (by simp)
  exact Q.isPrime.ne_top htop

end

end Representation
