/-- Helper for Exercise 12-12.3-3: the one-dimensional representation attached to `β` is
multiplicative. -/
private theorem oneDimensionalRepresentation_map_mul_local {K : Type*} [Field K]
    {H : Type*} [Group H]
    (β : H →* Kˣ) (x y : H) :
    LinearMap.lsmul K K ((β (x * y) : Kˣ) : K) =
      LinearMap.lsmul K K ((β x : Kˣ) : K) *
        LinearMap.lsmul K K ((β y : Kˣ) : K) := by
  -- Composition of scalar multiplications multiplies the scalars.
  ext z
  simp [LinearMap.lsmul_apply, mul_comm]

/-- Helper for Exercise 12-12.3-3: the linear character `β` yields a one-dimensional
representation over `K`. -/
private def oneDimensionalRepresentation_local {K : Type*} [Field K]
    {H : Type*} [Group H]
    (β : H →* Kˣ) : Representation K H K where
  toFun h := LinearMap.lsmul K K ((β h : Kˣ) : K)
  map_one' := oneDimensionalRepresentation_map_one_local (K := K) β
  map_mul' x y := oneDimensionalRepresentation_map_mul_local (K := K) β x y

