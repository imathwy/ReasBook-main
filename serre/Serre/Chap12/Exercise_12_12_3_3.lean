/-- Helper for Exercise 12-12.3-3: the character field is the `ℚ`-subfield of `ℂ` generated by
the values of the character. -/
private abbrev characterField_local (χ : G → ℂ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ (Set.range χ)

local notation "characterField" => characterField_local

/-- Helper for Exercise 12-12.3-3: `m • χ` is realizable over the character field of `χ`. -/
private def RealizableOverCharacterField_local (χ : G → ℂ) (m : ℕ+) : Prop :=
  ∃ (τ : Rep.{v} (characterField χ) G) (_ : FiniteDimensional (characterField χ) τ),
    (fun g ↦ algebraMap (characterField χ) ℂ (τ.ρ.character g)) =
      (((m : ℕ) : ℂ) • χ)

/-- Helper for Exercise 12-12.3-3: Serre's Schur index condition over the character field. -/
private def HasSchurIndex_local (χ : G → ℂ) (m : ℕ+) : Prop :=
  RealizableOverCharacterField_local.{u, v} χ m ∧
    ∀ n : ℕ+, RealizableOverCharacterField_local.{u, v} χ n → m ≤ n

local notation "HasSchurIndex" => HasSchurIndex_local

/-- Helper for Exercise 12-12.3-3: unpacking the local Schur-index wrapper gives the explicit
realizability-and-minimality data. -/
private theorem hasSchurIndex_iff_local (χ : G → ℂ) (m : ℕ+) :
    HasSchurIndex_local χ m ↔
        (∃ (τ : Rep.{v} (characterField χ) G) (_ : FiniteDimensional (characterField χ) τ),
        (fun g ↦ algebraMap (characterField χ) ℂ (τ.ρ.character g)) =
          (((m : ℕ) : ℂ) • χ)) ∧
        ∀ n : ℕ+, (∃ (τ : Rep.{v} (characterField χ) G)
          (_ : FiniteDimensional (characterField χ) τ),
          (fun g ↦ algebraMap (characterField χ) ℂ (τ.ρ.character g)) =
            (((n : ℕ) : ℂ) • χ)) → m ≤ n := by
  -- This is only the direct unfolding of the local wrapper definitions.
  rfl

/-- Helper for Exercise 12-12.3-3: scalar extension transports a `K`-character by applying the
coefficient map `K → ℂ`. -/
private theorem scalarExtension_character_eq_map_local
    {K : Type*} [Field K]
    {W : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    [Algebra K ℂ]
    (τ : Representation K G W) :
    (Representation.scalarExtension τ).character = fun g ↦ algebraMap K ℂ (τ.character g) := by
  -- Trace is preserved by base change, so scalar extension just applies the coefficient map.
  ext g
  exact LinearMap.trace_baseChange (τ g) ℂ

/-- Helper for Exercise 12-12.3-3: the trace of an endomorphism preserving a submodule splits as
the sum of the traces on the submodule and on the induced quotient map. -/
private theorem trace_eq_trace_restrict_add_trace_mapQ_local
    {K : Type*} [Field K]
    {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (f : V →ₗ[K] V) (W : Submodule K V) (hW : W ≤ W.comap f) :
    LinearMap.trace K V f =
      LinearMap.trace K W (f.restrict hW) +
        LinearMap.trace K (V ⧸ W) (W.mapQ W f hW) := by
  classical
  obtain ⟨Q, hQ⟩ := Submodule.exists_isCompl W
  let e : (W × Q) ≃ₗ[K] V := W.prodEquivOfIsCompl Q hQ
  let qEquiv : (V ⧸ W) ≃ₗ[K] Q := W.quotientEquivOfIsCompl Q hQ
  let qBlock : Q →ₗ[K] Q := Q.linearProjOfIsCompl W hQ.symm ∘ₗ f ∘ₗ Q.subtype
  let cross : Q →ₗ[K] W :=
    LinearMap.fst K W Q ∘ₗ (e.symm.conj f) ∘ₗ LinearMap.inr K W Q
  let offdiag : (W × Q) →ₗ[K] (W × Q) :=
    LinearMap.inl K W Q ∘ₗ cross ∘ₗ LinearMap.snd K W Q
  let block : (W × Q) →ₗ[K] (W × Q) := LinearMap.prodMap (f.restrict hW) qBlock
  have hq : ∀ q : Q,
      (Submodule.Quotient.mk ((qBlock q : Q) : V) : V ⧸ W) =
        Submodule.Quotient.mk (f (q : V)) := by
    intro q
    rw [Submodule.Quotient.eq']
    have hEq :
        -((Submodule.IsCompl.projection hQ.symm) (f q)) + f q =
          (Submodule.IsCompl.projection hQ) (f q) := by
      rw [(Submodule.IsCompl.projection_eq_self_sub_projection hQ)]
      abel
    suffices
        -((Submodule.IsCompl.projection hQ.symm) (f q)) + f q ∈ W by
      simpa [qBlock]
    rw [hEq]
    exact (Submodule.IsCompl.projection_apply_mem hQ) (f q)
  have hqBlock : qBlock = qEquiv.conj (W.mapQ W f hW) := by
    ext q
    exact congrArg (fun x : Q => (x : V)) <| by
      apply qEquiv.symm.injective
      simpa [LinearEquiv.conj_apply_apply] using hq q
  have hleft : ∀ w : W, e.symm.conj f (w, 0) = block (w, 0) := by
    intro w
    have hwmem : f (w : V) ∈ W := hW w.2
    ext <;> simp [LinearEquiv.symm_conj_apply, e, block, qBlock, hwmem]
  have hright : ∀ q : Q, e.symm.conj f (0, q) = offdiag (0, q) + block (0, q) := by
    intro q
    ext <;> simp [LinearEquiv.symm_conj_apply, e, block, offdiag, cross, qBlock]
  have hsplit : e.symm.conj f = block + offdiag := by
    apply LinearMap.ext
    intro x
    rcases x with ⟨w, q⟩
    have hpair : (w, q) = (w, 0) + (0, q) := by
      ext <;> simp
    have hblock_split : block (w, q) = block (w, 0) + block (0, q) := by
      rw [hpair, map_add]
    have hoffdiag_eq : offdiag (w, q) = offdiag (0, q) := by
      ext <;> simp [offdiag, cross]
    calc
      e.symm.conj f (w, q) = e.symm.conj f (w, 0) + e.symm.conj f (0, q) := by
        rw [hpair, map_add]
      _ = block (w, 0) + (offdiag (0, q) + block (0, q)) := by
        rw [hleft, hright]
      _ = block (w, q) + offdiag (w, q) := by
        rw [hblock_split, hoffdiag_eq]
        abel
      _ = (block + offdiag) (w, q) := rfl
  have hsq : offdiag * offdiag = 0 := by
    apply LinearMap.ext
    intro x
    rcases x with ⟨w, q⟩
    have hoff : offdiag (w, q) = (cross q, 0) := by
      ext <;> simp [offdiag, cross]
    rw [show (offdiag * offdiag) (w, q) = offdiag (offdiag (w, q)) by rfl, hoff]
    simp [offdiag]
  have hnil : IsNilpotent offdiag := by
    refine ⟨2, ?_⟩
    simpa [pow_two] using hsq
  have htr_block :
      LinearMap.trace K (W × Q) block =
        LinearMap.trace K W (f.restrict hW) + LinearMap.trace K Q qBlock := by
    simpa [block] using LinearMap.trace_prodMap' (f.restrict hW) qBlock
  have htr_q :
      LinearMap.trace K Q qBlock = LinearMap.trace K (V ⧸ W) (W.mapQ W f hW) := by
    rw [hqBlock]
    simpa using (LinearMap.trace_conj' (W.mapQ W f hW) qEquiv)
  have htr_off : LinearMap.trace K (W × Q) offdiag = 0 := by
    exact IsNilpotent.eq_zero <|
      LinearMap.isNilpotent_trace_of_isNilpotent (R := K) (M := W × Q) hnil
  calc
    LinearMap.trace K V f = LinearMap.trace K (W × Q) (e.symm.conj f) := by
      simpa [e] using (LinearMap.trace_conj' f e.symm)
    _ = LinearMap.trace K (W × Q) block + LinearMap.trace K (W × Q) offdiag := by
      rw [hsplit, map_add]
    _ = LinearMap.trace K W (f.restrict hW) + LinearMap.trace K Q qBlock := by
      rw [htr_block, htr_off, add_zero]
    _ = LinearMap.trace K W (f.restrict hW) + LinearMap.trace K (V ⧸ W) (W.mapQ W f hW) := by
      rw [htr_q]

/-- Helper for Exercise 12-12.3-3: the character of a representation is the sum of the
characters of a stable subrepresentation and its quotient. -/
private theorem character_eq_add_character_quotient_of_invariant_submodule_local
    {K : Type*} [Field K]
    {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (ρ : Representation K G V) (W : Submodule K V) (hW : ∀ g, W ≤ W.comap (ρ g)) :
    ρ.character = (ρ.subrepresentation W hW).character + (ρ.quotient W hW).character := by
  -- Apply the trace decomposition pointwise to the endomorphisms `ρ g`.
  ext g
  simpa [Representation.character] using
    trace_eq_trace_restrict_add_trace_mapQ_local (f := ρ g) (W := W) (hW := hW g)

/-- Helper for Exercise 12-12.3-3: a non-irreducible nontrivial representation has a nonzero
proper subrepresentation. -/
private theorem exists_proper_nonzero_subrepresentation_of_not_isIrreducible_local
    {K : Type*} [Field K]
    (ρ : Rep K G) [Nontrivial ρ] (hρ : ¬ ρ.ρ.IsIrreducible) :
    ∃ W : Subrepresentation ρ.ρ, W ≠ ⊥ ∧ W ≠ ⊤ := by
  -- Collapse of the carrier would force `⊥ = ⊤` in the subrepresentation lattice.
  have hbot_top : (⊥ : Subrepresentation ρ.ρ) ≠ ⊤ := by
    intro h
    obtain ⟨x, hx⟩ := exists_ne (0 : ρ)
    have hxmem : x ∈ (⊥ : Subrepresentation ρ.ρ) := by
      have hxTop : x ∈ (⊤ : Subrepresentation ρ.ρ) := by
        change x ∈ ((⊤ : Subrepresentation ρ.ρ).toSubmodule)
        exact Submodule.mem_top
      rw [← h] at hxTop
      exact hxTop
    exact hx <| by simpa using hxmem
  letI : Nontrivial (Subrepresentation ρ.ρ) := ⟨⟨⊥, ⊤, hbot_top⟩⟩
  have hnot : ¬ ∀ W : Subrepresentation ρ.ρ, W = ⊥ ∨ W = ⊤ := by
    intro hsimple
    exact hρ ⟨hsimple⟩
  rcases not_forall.mp hnot with ⟨W, hW⟩
  refine ⟨W, ?_, ?_⟩
  · intro hWbot
    exact hW (Or.inl hWbot)
  · intro hWtop
    exact hW (Or.inr hWtop)

/-- Helper for Exercise 12-12.3-3: the normalized pairing is additive over finite integer linear
combinations in its left argument. -/
private theorem groupFunctionPairing_sum_zsmul_left_complex_local
    {ι : Type*} (s : Finset ι) (a : ι → ℤ) (χ : ι → G → ℂ) (ψ : G → ℂ) :
    ⟪∑ j ∈ s, a j • χ j, ψ⟫ = ∑ j ∈ s, ((a j : ℤ) : ℂ) * ⟪χ j, ψ⟫ := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp [Representation.groupFunctionPairingOverField]
  | insert i s hi ih =>
      -- Rewrite the inserted integer multiple into the scalar form used by the pairing API.
      have hzsmul : (a i • χ i : G → ℂ) = (((a i : ℤ) : ℂ) • χ i) := by
        ext g
        simp [zsmul_eq_mul, smul_eq_mul]
      rw [Finset.sum_insert hi, groupFunctionPairing_add_left, hzsmul,
        groupFunctionPairing_smul_left, ih, Finset.sum_insert hi]

/-- Helper for Exercise 12-12.3-3: pairing a complex character-ring element with an irreducible
basis character reads off the corresponding basis coefficient. -/
private theorem complex_basis_coefficient_pairing_eq_local
    {ι : Type*} [Fintype ι]
    (π : ι → FDRep ℂ G)
    (hπ_pairwise : PairwiseNonisomorphic π)
    (hπ_complete : IsCompleteIrreducibleFamily π)
    (x : R[ℂ](G)) (i : ι) :
    ⟪(x : G → ℂ), (π i).character⟫ =
      (((irreducible_characters_basis_of_complete_family ℂ π hπ_pairwise hπ_complete).repr x i :
        ℤ) : ℂ) := by
  let b := irreducible_characters_basis_of_complete_family ℂ π hπ_pairwise hπ_complete
  let c := b.repr x
  have hx :
      ∑ j, c j • (π j).character = (x : G → ℂ) := by
    -- Expand the representation-ring element in the irreducible basis and forget the subtype.
    simpa [b, c, irreducible_characters_basis_of_complete_family_apply,
      FDRep.irreducibleCharacter_apply] using
      congrArg (fun z : R[ℂ](G) ↦ (z : G → ℂ)) (b.sum_repr x)
  calc
    ⟪(x : G → ℂ), (π i).character⟫
        = ⟪∑ j, c j • (π j).character, (π i).character⟫ := by
            simpa [hx] using
              congrArg (fun χ : G → ℂ ↦ groupFunctionPairingOverField ℂ χ (π i).character)
                hx.symm
    _ = ∑ j, ((c j : ℤ) : ℂ) * ⟪(π j).character, (π i).character⟫ := by
          simpa [c] using
            groupFunctionPairing_sum_zsmul_left_complex_local
              (s := Finset.univ) (a := c) (χ := fun j ↦ (π j).character)
              (ψ := (π i).character)
    _ = (((c i : ℤ) : ℂ) * ⟪(π i).character, (π i).character⟫) := by
          refine Finset.sum_eq_single i ?_ ?_
          · intro j _ hji
            have hji' : ¬ Nonempty ((π j).ρ.Equiv (π i).ρ) := by
              intro hjiIso
              exact hπ_pairwise hji ⟨hjiIso.some.toFDRepIso⟩
            have horth : ⟪(π j).character, (π i).character⟫ = (0 : ℂ) := by
              simpa [hji'] using
                (Representation.char_orthonormal (ρ := (π j).ρ) (σ := (π i).ρ))
            simp [horth]
          · intro hi
            exact (hi (Finset.mem_univ i)).elim
    _ = (((c i : ℤ) : ℂ) : ℂ) := by
          letI : Simple (π i) := hπ_complete.isSimple i
          letI : (π i).ρ.IsIrreducible := by
            simpa using (FDRep.isIrreducible_of_simple (π i))
          have hself : ⟪(π i).character, (π i).character⟫ = (1 : ℂ) := by
            let hii : Nonempty ((π i).ρ.Equiv (π i).ρ) := ⟨Representation.Equiv.refl _⟩
            simpa [hii] using
              (Representation.char_orthonormal (ρ := (π i).ρ) (σ := (π i).ρ))
          simp [hself]

/-- Helper for Exercise 12-12.3-3: any realizing model for a positive multiple of an irreducible
complex character has nontrivial carrier. -/
private theorem realizing_model_nontrivial_local
    (ρ : Rep.{v} ℂ G)
    [ρ.ρ.IsIrreducible]
    (τ : Rep.{v} (characterField ρ.ρ.character) G)
    [FiniteDimensional (characterField ρ.ρ.character) τ]
    (m : ℕ+)
    (hτchar :
      (fun g ↦ algebraMap (characterField ρ.ρ.character) ℂ (τ.ρ.character g)) =
        (((m : ℕ) : ℂ) • ρ.ρ.character)) :
    Nontrivial τ := by
  let K := characterField ρ.ρ.character
  letI : FiniteDimensional ℂ ρ := Representation.IsIrreducible.finiteDimensional_of_finite ρ.ρ
  have hρ_nontriv : Nontrivial ρ := irreducible_representation_nontrivial (ρ := ρ.ρ)
  have hρ_char_one_ne : ρ.ρ.character 1 ≠ 0 := by
    -- The irreducible target character has positive degree.
    simpa [Representation.char_one] using
      (Nat.cast_ne_zero.mpr ((Module.finrank_pos_iff.mpr hρ_nontriv).ne'))
  by_contra hτ_sub
  letI : Subsingleton τ := not_nontrivial_iff_subsingleton.mp hτ_sub
  have hτ_char_one : τ.ρ.character 1 = 0 := by
    -- A subsingleton carrier has degree zero, hence zero character at `1`.
    simpa [Representation.char_one] using
      (show (Module.finrank K τ : K) = 0 by
        simp [Module.finrank_zero_of_subsingleton])
  have hpoint := congrFun hτchar 1
  have hm_ne : (((m : ℕ) : ℂ)) ≠ 0 := Nat.cast_ne_zero.mpr m.2.ne'
  have hmul_zero : (((m : ℕ) : ℂ) * ρ.ρ.character 1) = 0 := by
    simpa [hτ_char_one, smul_eq_mul] using hpoint.symm
  rcases mul_eq_zero.mp hmul_zero with hm_zero | hρ_zero
  · exact hm_ne hm_zero
  · exact hρ_char_one_ne hρ_zero

/-- Helper for Exercise 12-12.3-3: if two mapped `K`-characters add up to `m` copies of an
irreducible complex character, then each mapped summand is a smaller multiple of that same
irreducible character. -/
private theorem mapped_summand_characters_eq_nat_smul_of_add_eq_mul_irreducible_local
    {K : Type*} [Field K] [CharZero K] [Algebra K ℂ]
    (ρ : Rep.{v} ℂ G) [ρ.ρ.IsIrreducible]
    (σ τ : Rep.{v} K G) [FiniteDimensional K σ] [FiniteDimensional K τ]
    (m : ℕ+)
    (hchar :
      (fun g ↦ algebraMap K ℂ (σ.ρ.character g)) +
          (fun g ↦ algebraMap K ℂ (τ.ρ.character g)) =
        (((m : ℕ) : ℂ) • ρ.ρ.character)) :
    ∃ a b : ℕ, a + b = (m : ℕ) ∧
      (fun g ↦ algebraMap K ℂ (σ.ρ.character g)) = (((a : ℕ) : ℂ) • ρ.ρ.character) ∧
      (fun g ↦ algebraMap K ℂ (τ.ρ.character g)) = (((b : ℕ) : ℂ) • ρ.ρ.character) := by
  let σC : Rep ℂ G := Rep.of (Representation.scalarExtension σ.ρ)
  let τC : Rep ℂ G := Rep.of (Representation.scalarExtension τ.ρ)
  letI : FiniteDimensional ℂ ρ := Representation.IsIrreducible.finiteDimensional_of_finite ρ.ρ
  have hσC_char :
      σC.ρ.character = (fun g ↦ algebraMap K ℂ (σ.ρ.character g)) := by
    -- Scalar extension only applies the coefficient map to the original `K`-character.
    simpa [σC] using scalarExtension_character_eq_map_local (G := G) (τ := σ.ρ)
  have hτC_char :
      τC.ρ.character = (fun g ↦ algebraMap K ℂ (τ.ρ.character g)) := by
    -- The same scalar-extension formula applies to the second summand.
    simpa [τC] using scalarExtension_character_eq_map_local (G := G) (τ := τ.ρ)
  have hcard_ne : (Nat.card G : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  letI : NeZero (Nat.card G : ℂ) := ⟨hcard_ne⟩
  obtain ⟨ι, _, π, hπ_pairwise, hπ_complete⟩ :=
    exists_complete_pairwise_nonisomorphic_simple_family (k := ℂ) (G := G)
  letI : Fintype ι := inferInstance
  letI : Simple (FDRep.of ρ.ρ) := FDRep.simple_of_isIrreducible (FDRep.of ρ.ρ)
  obtain ⟨i, hi⟩ := hπ_complete.exists_iso (FDRep.of ρ.ρ) inferInstance
  rcases hi with ⟨eρ⟩
  let xσ : R[ℂ](G) := ⟨σC.ρ.character,
    Representation.rep_character_mem_characterRingOverField (K := ℂ) (G := G) σC⟩
  let xτ : R[ℂ](G) := ⟨τC.ρ.character,
    Representation.rep_character_mem_characterRingOverField (K := ℂ) (G := G) τC⟩
  let b := irreducible_characters_basis_of_complete_family ℂ π hπ_pairwise hπ_complete
  let cσ := b.repr xσ
  let cτ := b.repr xτ
  have hxσ :
      ∑ j, cσ j • (π j).character = (xσ : G → ℂ) := by
    -- Expand the first scalar-extended character in the irreducible basis.
    simpa [b, cσ, xσ, irreducible_characters_basis_of_complete_family_apply,
      FDRep.irreducibleCharacter_apply] using
      congrArg (fun z : R[ℂ](G) ↦ (z : G → ℂ)) (b.sum_repr xσ)
  have hxτ :
      ∑ j, cτ j • (π j).character = (xτ : G → ℂ) := by
    -- Expand the second scalar-extended character in the same irreducible basis.
    simpa [b, cτ, xτ, irreducible_characters_basis_of_complete_family_apply,
      FDRep.irreducibleCharacter_apply] using
      congrArg (fun z : R[ℂ](G) ↦ (z : G → ℂ)) (b.sum_repr xτ)
  have hcoeff_sigma :
      ∀ j, (((cσ j : ℤ) : ℂ)) =
        (Module.finrank ℂ ((π j).ρ.IntertwiningMap σC.ρ) : ℂ) := by
    intro j
    -- Pairing the honest complex character with `π j` computes the multiplicity of `π j`.
    calc
      (((cσ j : ℤ) : ℂ)) = ⟪(xσ : G → ℂ), (π j).character⟫ := by
        simpa [cσ] using
          (complex_basis_coefficient_pairing_eq_local
            (G := G) (π := π) hπ_pairwise hπ_complete xσ j).symm
      _ = ⟪(π j).character, (xσ : G → ℂ)⟫ := by
            rw [groupFunctionPairing_comm]
      _ = (Module.finrank ℂ ((π j).ρ.IntertwiningMap σC.ρ) : ℂ) := by
            simpa [xσ, σC] using
              (Representation.groupFunctionPairingOverField_character_eq_finrank_intertwiningMap
                ℂ (π j).ρ σC.ρ)
  have hcoeff_tau :
      ∀ j, (((cτ j : ℤ) : ℂ)) =
        (Module.finrank ℂ ((π j).ρ.IntertwiningMap τC.ρ) : ℂ) := by
    intro j
    -- The same multiplicity formula identifies the coefficients of the second summand.
    calc
      (((cτ j : ℤ) : ℂ)) = ⟪(xτ : G → ℂ), (π j).character⟫ := by
        simpa [cτ] using
          (complex_basis_coefficient_pairing_eq_local
            (G := G) (π := π) hπ_pairwise hπ_complete xτ j).symm
      _ = ⟪(π j).character, (xτ : G → ℂ)⟫ := by
            rw [groupFunctionPairing_comm]
      _ = (Module.finrank ℂ ((π j).ρ.IntertwiningMap τC.ρ) : ℂ) := by
            simpa [xτ, τC] using
              (Representation.groupFunctionPairingOverField_character_eq_finrank_intertwiningMap
                ℂ (π j).ρ τC.ρ)
  have hcoeff_offdiag :
      ∀ j, j ≠ i → cσ j = 0 ∧ cτ j = 0 := by
    intro j hji
    have hnot : ¬ Nonempty ((π j).ρ.Equiv ρ.ρ) := by
      intro hjρ
      exact hπ_pairwise hji ⟨(hjρ.some.trans eρ.symm.toRepresentationEquiv).toFDRepIso⟩
    have hpair_zero :
        ⟪ρ.ρ.character, (π j).character⟫ = (0 : ℂ) := by
      simpa [hnot] using
        (Representation.char_orthonormal (ρ := ρ.ρ) (σ := (π j).ρ))
    let a : ℕ := Module.finrank ℂ ((π j).ρ.IntertwiningMap σC.ρ)
    let b' : ℕ := Module.finrank ℂ ((π j).ρ.IntertwiningMap τC.ρ)
    have hsum :
        (a : ℂ) + (b' : ℂ) = 0 := by
      -- Pair the global character identity with the off-diagonal irreducible basis vector.
      calc
        (a : ℂ) + (b' : ℂ)
            = ⟪(fun g ↦ algebraMap K ℂ (σ.ρ.character g)) +
                (fun g ↦ algebraMap K ℂ (τ.ρ.character g)), (π j).character⟫ := by
                  rw [← hσC_char, ← hτC_char]
                  rw [groupFunctionPairing_add_left, ← hcoeff_sigma, ← hcoeff_tau]
            _ = ⟪(((m : ℕ) : ℂ) • ρ.ρ.character, (π j).character⟫ := by rw [hchar]
            _ = 0 := by rw [groupFunctionPairing_smul_left, hpair_zero, mul_zero]
    have hsum_nat : a + b' = 0 := by
      exact_mod_cast hsum
    have ha_zero : a = 0 := Nat.eq_zero_of_add_eq_zero_left hsum_nat
    have hb_zero : b' = 0 := by simpa [ha_zero] using hsum_nat
    constructor
    · apply Int.cast_injective (R := ℂ)
      simpa [a, ha_zero] using hcoeff_sigma j
    · apply Int.cast_injective (R := ℂ)
      simpa [b', hb_zero] using hcoeff_tau j
  let a : ℕ := Module.finrank ℂ ((π i).ρ.IntertwiningMap σC.ρ)
  let b' : ℕ := Module.finrank ℂ ((π i).ρ.IntertwiningMap τC.ρ)
  have hpair_diag :
      (a : ℂ) + (b' : ℂ) = (m : ℕ) := by
    have hpair_one : ⟪ρ.ρ.character, (π i).character⟫ = (1 : ℂ) := by
      let hii : Nonempty (ρ.ρ.Equiv (π i).ρ) := ⟨eρ.toRepresentationEquiv.symm⟩
      simpa [hii] using
        (Representation.char_orthonormal (ρ := ρ.ρ) (σ := (π i).ρ))
    -- Pair the global equality with the unique irreducible basis vector equivalent to `ρ`.
    calc
      (a : ℂ) + (b' : ℂ)
          = ⟪(fun g ↦ algebraMap K ℂ (σ.ρ.character g)) +
              (fun g ↦ algebraMap K ℂ (τ.ρ.character g)), (π i).character⟫ := by
                rw [← hσC_char, ← hτC_char]
                rw [groupFunctionPairing_add_left, ← hcoeff_sigma, ← hcoeff_tau]
      _ = ⟪(((m : ℕ) : ℂ) • ρ.ρ.character, (π i).character⟫ := by rw [hchar]
      _ = (m : ℕ) := by
            rw [groupFunctionPairing_smul_left, hpair_one, mul_one]
  have hab : a + b' = (m : ℕ) := by
    exact_mod_cast hpair_diag
  have hsigma_eq :
      (fun g ↦ algebraMap K ℂ (σ.ρ.character g)) = (((a : ℕ) : ℂ) • ρ.ρ.character) := by
    -- All off-diagonal irreducible coefficients vanish, so only the `ρ`-coordinate survives.
    calc
      (fun g ↦ algebraMap K ℂ (σ.ρ.character g)) = (xσ : G → ℂ) := by
        simpa [xσ] using hσC_char.symm
      _ = ∑ j, cσ j • (π j).character := by simpa using hxσ.symm
      _ = cσ i • (π i).character := by
            refine Finset.sum_eq_single i ?_ ?_
            · intro j _ hji
              rcases hcoeff_offdiag j hji with ⟨hσj, _⟩
              simp [hσj]
            · intro hi_mem
              exact (hi_mem (Finset.mem_univ i)).elim
      _ = (((a : ℕ) : ℂ) • (π i).character) := by
            ext g
            apply Int.cast_injective (R := ℂ) at (hcoeff_sigma i)
            have hci : cσ i = a := by simpa [a] using hcoeff_sigma i
            simp [hci, zsmul_eq_mul, smul_eq_mul]
      _ = (((a : ℕ) : ℂ) • ρ.ρ.character) := by
            rw [← FDRep.char_iso eρ]
  have htau_eq :
      (fun g ↦ algebraMap K ℂ (τ.ρ.character g)) = (((b' : ℕ) : ℂ) • ρ.ρ.character) := by
    -- The same basis argument collapses the second summand to the diagonal `ρ`-coordinate.
    calc
      (fun g ↦ algebraMap K ℂ (τ.ρ.character g)) = (xτ : G → ℂ) := by
        simpa [xτ] using hτC_char.symm
      _ = ∑ j, cτ j • (π j).character := by simpa using hxτ.symm
      _ = cτ i • (π i).character := by
            refine Finset.sum_eq_single i ?_ ?_
            · intro j _ hji
              rcases hcoeff_offdiag j hji with ⟨_, hτj⟩
              simp [hτj]
            · intro hi_mem
              exact (hi_mem (Finset.mem_univ i)).elim
      _ = (((b' : ℕ) : ℂ) • (π i).character) := by
            ext g
            apply Int.cast_injective (R := ℂ) at (hcoeff_tau i)
            have hci : cτ i = b' := by simpa [b'] using hcoeff_tau i
            simp [hci, zsmul_eq_mul, smul_eq_mul]
      _ = (((b' : ℕ) : ℂ) • ρ.ρ.character) := by
            rw [← FDRep.char_iso eρ]
  exact ⟨a, b', hab, hsigma_eq, htau_eq⟩

/-- Helper for Exercise 12-12.3-3: a minimal realizing model for `m • χ_ρ` over the character
field is irreducible. -/
private theorem minimal_realization_is_irreducible_local
    (ρ : Rep.{v} ℂ G)
    [ρ.ρ.IsIrreducible]
    (τ : Rep.{v} (characterField ρ.ρ.character) G)
    [FiniteDimensional (characterField ρ.ρ.character) τ]
    (m : ℕ+)
    (hτchar :
      (fun g ↦ algebraMap (characterField ρ.ρ.character) ℂ (τ.ρ.character g)) =
        (((m : ℕ) : ℂ) • ρ.ρ.character))
    (hmin :
      ∀ n : ℕ+, (∃ (τ' : Rep.{v} (characterField ρ.ρ.character) G)
        (_ : FiniteDimensional (characterField ρ.ρ.character) τ'),
        (fun g ↦ algebraMap (characterField ρ.ρ.character) ℂ (τ'.ρ.character g)) =
          (((n : ℕ) : ℂ) • ρ.ρ.character)) → m ≤ n) :
    τ.ρ.IsIrreducible := by
  let K := characterField ρ.ρ.character
  letI : FiniteDimensional ℂ ρ := Representation.IsIrreducible.finiteDimensional_of_finite ρ.ρ
  have hτ_nontriv : Nontrivial τ :=
    realizing_model_nontrivial_local (ρ := ρ) (τ := τ) (m := m) hτchar
  letI : Nontrivial τ := hτ_nontriv
  by_contra hτ_not_irreducible
  obtain ⟨W, hWbot, hWtop⟩ :=
    exists_proper_nonzero_subrepresentation_of_not_isIrreducible_local
      (ρ := τ) hτ_not_irreducible
  have hWbot' : W.toSubmodule ≠ ⊥ := by
    intro hWbotSub
    exact hWbot (Subrepresentation.toSubmodule_injective hWbotSub)
  have hWtop' : W.toSubmodule ≠ ⊤ := by
    intro hWtopSub
    exact hWtop (Subrepresentation.toSubmodule_injective hWtopSub)
  let τW : Rep.{v} K G := Rep.of W.toRepresentation
  let τQ : Rep.{v} K G := Rep.of (τ.ρ.quotient W.toSubmodule W.apply_mem_toSubmodule)
  have hsplit :
      τ.ρ.character = τW.ρ.character + τQ.ρ.character := by
    -- Split the realizing character along the nonzero proper invariant subrepresentation.
    simpa [τW, τQ, Rep.of_ρ] using
      character_eq_add_character_quotient_of_invariant_submodule_local
        (ρ := τ.ρ) (W := W.toSubmodule) (hW := W.apply_mem_toSubmodule)
  have hsplit_map :
      (fun g ↦ algebraMap K ℂ (τW.ρ.character g)) +
          (fun g ↦ algebraMap K ℂ (τQ.ρ.character g)) =
        (((m : ℕ) : ℂ) • ρ.ρ.character) := by
    -- Apply the coefficient map to the character splitting and compare with the target equality.
    ext g
    calc
      algebraMap K ℂ (τW.ρ.character g) + algebraMap K ℂ (τQ.ρ.character g)
          = algebraMap K ℂ (τ.ρ.character g) := by
              rw [← map_add, ← congrFun hsplit g]
      _ = ((((m : ℕ) : ℂ) • ρ.ρ.character) g) := by
            simpa using congrFun hτchar g
  obtain ⟨a, b, hab, hτWchar, hτQchar⟩ :=
    mapped_summand_characters_eq_nat_smul_of_add_eq_mul_irreducible_local
      (K := K) (ρ := ρ) (σ := τW) (τ := τQ) (m := m) hsplit_map
  have hW_nontriv : Nontrivial W.toSubmodule := Submodule.nontrivial_iff_ne_bot.mpr hWbot'
  have hW_pos : 0 < Module.finrank K W.toSubmodule := (Module.finrank_pos_iff).2 hW_nontriv
  have hτ_pos : 0 < Module.finrank K τ := (Module.finrank_pos_iff).2 hτ_nontriv
  have hQ_pos : 0 < Module.finrank K (τ ⧸ W.toSubmodule) := by
    have hsum :
        Module.finrank K (τ ⧸ W.toSubmodule) + Module.finrank K W.toSubmodule =
          Module.finrank K τ := by
      simpa using (Submodule.finrank_quotient_add_finrank (R := K) (M := τ) W.toSubmodule)
    omega
  have hτW_char_one_ne : algebraMap K ℂ (τW.ρ.character 1) ≠ 0 := by
    have hτW_char_one_neK : τW.ρ.character 1 ≠ 0 := by
      simpa [τW, Rep.of_ρ, Representation.char_one] using
        (Nat.cast_ne_zero.mpr hW_pos.ne')
    intro hzero
    exact hτW_char_one_neK ((algebraMap K ℂ).injective hzero)
  have hτQ_char_one_ne : algebraMap K ℂ (τQ.ρ.character 1) ≠ 0 := by
    have hτQ_char_one_neK : τQ.ρ.character 1 ≠ 0 := by
      simpa [τQ, Rep.of_ρ, Representation.char_one] using
        (Nat.cast_ne_zero.mpr hQ_pos.ne')
    intro hzero
    exact hτQ_char_one_neK ((algebraMap K ℂ).injective hzero)
  have ha_pos : 0 < a := by
    -- Evaluating the first summand at `1` shows its multiplicity is strictly positive.
    by_contra ha_not_pos
    have ha_zero : a = 0 := Nat.eq_zero_of_not_pos ha_not_pos
    have hpoint := congrFun hτWchar 1
    apply hτW_char_one_ne
    simpa [ha_zero, smul_eq_mul] using hpoint
  have hb_pos : 0 < b := by
    -- The quotient summand is also nonzero, so its multiplicity is strictly positive.
    by_contra hb_not_pos
    have hb_zero : b = 0 := Nat.eq_zero_of_not_pos hb_not_pos
    have hpoint := congrFun hτQchar 1
    apply hτQ_char_one_ne
    simpa [hb_zero, smul_eq_mul] using hpoint
  have ha_lt_m : a < (m : ℕ) := by
    omega
  let a' : ℕ+ := ⟨a, ha_pos⟩
  have hm_le_a' : m ≤ a' := by
    -- The first summand realizes a smaller positive multiple, contradicting minimality.
    exact hmin a' ⟨τW, inferInstance, by simpa [a'] using hτWchar⟩
  have hm_le_a : (m : ℕ) ≤ a := by
    simpa [a'] using hm_le_a'
  omega

/-- Helper for Exercise 12-12.3-3: scalar extension transports a character by applying the
coefficient map to each value. -/
private theorem scalarExtension_character_eq_map_overField_local
    {F : Type*} [Field F]
    {E : Type*} [Field E] [Algebra F E]
    {V : Type*} [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (τ : Representation F G V) :
    (Representation.scalarExtension τ).character = fun g ↦ algebraMap F E (τ.character g) := by
  -- Trace commutes with base change, so scalar extension only changes coefficients.
  ext g
  exact LinearMap.trace_baseChange (τ g) E

/-- Helper for Exercise 12-12.3-3: coefficientwise extension of a virtual character stays in the
target character ring. -/
private theorem map_mem_characterRingOverField_local
    {F : Type*} [Field F]
    {E : Type*} [Field E]
    (f : F →ₐ[ℤ] E)
    (χ : G → F)
    (hχ : χ ∈ R[F](G)) :
    (f.compLeft G) χ ∈ R[E](G) := by
  letI : Algebra F E := f.toRingHom.toAlgebra
  -- Check the claim on irreducible generators and close under the algebra operations.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hχ
  · intro ψ hψ
    rcases hψ with ⟨ρ, hρfd, _hρirr, rfl⟩
    letI : FiniteDimensional F ρ := hρfd
    let ρE : Rep E G := Rep.of (Representation.scalarExtension ρ.ρ)
    have hchar :
        (f.compLeft G) ρ.ρ.character = ρE.ρ.character := by
      ext g
      simpa [ρE] using
        (congrFun
          (scalarExtension_character_eq_map_overField_local
            (G := G) (τ := ρ.ρ)) g).symm
    exact hchar.symm ▸ by
      simpa using
        (Representation.rep_character_mem_characterRingOverField
          (K := E) (G := G) (Rep.of (Representation.scalarExtension ρ.ρ)))
  · intro n
    change (fun _ : G ↦ f (algebraMap ℤ F n)) ∈ R[E](G)
    have hconst : (fun _ : G ↦ f (algebraMap ℤ F n)) = algebraMap ℤ (G → E) n := by
      ext g
      simpa using (f.commutes n)
    rw [hconst]
    exact (R[E](G)).algebraMap_mem n
  · intro φ ψ _ _ hφ hψ
    simpa using (R[E](G)).add_mem hφ hψ
  · intro φ ψ _ _ hφ hψ
    simpa using (R[E](G)).mul_mem hφ hψ

/-- Helper for Exercise 12-12.3-3: the complex realization of `R[K](G)` is contained in `R(G)`.
-/
private theorem characterRingOverFieldInExtension_le_characterRing_local
    {K : Type*} [Field K] [Algebra K ℂ] :
    characterRingOverFieldInExtension K ℂ G ≤ R(G) := by
  intro χ hχ
  rcases Subalgebra.mem_map.mp hχ with ⟨χK, hχK, rfl⟩
  simpa using
    map_mem_characterRingOverField_local
      (G := G)
      (f := (IsScalarTower.toAlgHom ℤ K ℂ))
      χK
      hχK

