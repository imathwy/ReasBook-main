/-- Helper for Exercise 12-12.3-3: a unit-valued homomorphism over `K` defines a
one-dimensional `K`-representation. -/
private theorem oneDimensionalRepresentation_map_one_local {K : Type*} [Field K]
    {H : Type*} [Group H]
    (β : H →* Kˣ) :
    LinearMap.lsmul K K ((β 1 : Kˣ) : K) = 1 := by
  -- At the identity, the action is scalar multiplication by `1`.
  ext x
  simp [LinearMap.lsmul_apply]

