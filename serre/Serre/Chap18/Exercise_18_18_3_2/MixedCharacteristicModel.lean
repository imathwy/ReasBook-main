import Mathlib

noncomputable section

universe u

namespace Representation

open Polynomial

section MixedCharacteristicModel

variable {p : ℕ} [Fact p.Prime]

/-- Helper for Exercise 18-18.3-2: for Witt vectors over a perfect residue field, the maximal
ideal is generated by `p`. This isolates the residue-field owner needed in the mixed-character
construction. -/
theorem wittVector_maximalIdeal_eq_span_prime
    (k : Type u) [Field k] [CharP k p] [PerfectRing k p] :
    IsLocalRing.maximalIdeal (WittVector p k) = Ideal.span {((p : ℕ) : WittVector p k)} := by
  -- Compare the maximal ideal with the kernel of `constantCoeff`, then invoke the standard
  -- Witt-vector kernel computation.
  calc
    IsLocalRing.maximalIdeal (WittVector p k) =
        RingHom.ker (WittVector.constantCoeff : WittVector p k →+* k) := by
          symm
          exact
            IsLocalRing.ker_eq_maximalIdeal
              (WittVector.constantCoeff : WittVector p k →+* k)
              (WittVector.constantCoeff_surjective (p := p))
    _ = Ideal.span {((p : ℕ) : WittVector p k)} := by
      simpa using (WittVector.ker_constantCoeff (p := p) (k := k))

/-- Helper for Exercise 18-18.3-2: the residue field of the Witt-vector DVR over `k` is
canonically `k`. This is the residue-field part of the mixed-character owner package. -/
noncomputable def wittVector_residueField_ringEquiv
    (k : Type u) [Field k] [CharP k p] [PerfectRing k p] :
    IsLocalRing.ResidueField (WittVector p k) ≃+* k :=
  let hker :
      RingHom.ker (WittVector.constantCoeff : WittVector p k →+* k) =
        IsLocalRing.maximalIdeal (WittVector p k) :=
    IsLocalRing.ker_eq_maximalIdeal
      (WittVector.constantCoeff : WittVector p k →+* k)
      (WittVector.constantCoeff_surjective (p := p))
  -- Move from the residue-field quotient to the kernel quotient, then evaluate by `constantCoeff`.
  (Ideal.quotEquivOfEq hker.symm).trans <|
    RingHom.quotientKerEquivOfSurjective (WittVector.constantCoeff_surjective (p := p))

variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k p]
variable {G : Type u} [Group G] [Finite G]

/-- Helper for Exercise 18-18.3-2: Serre's positive branch adjoins a root of the shifted
`p`-power cyclotomic polynomial `Φ_{p^(n+1)}(X + 1)` over `W(k)`. -/
private abbrev shifted_prime_power_cyclotomic_polynomial (n : ℕ) : (WittVector p k)[X] :=
  (((cyclotomic (p ^ (n + 1)) ℤ).map (Int.castRingHom (WittVector p k))).comp
    (X + C (1 : WittVector p k)))

/-- Helper for Exercise 18-18.3-2: after transporting Serre's shifted cyclotomic polynomial from
`ℤ` to `W(k)`, it is still Eisenstein at the maximal ideal `(p)`. This is the arithmetic input for
the totally ramified mixed-character extension. -/
theorem shifted_prime_power_cyclotomic_isEisenstein_over_wittVector (n : ℕ) :
    (((cyclotomic (p ^ (n + 1)) ℤ).map (Int.castRingHom (WittVector p k))).comp
        (X + C (1 : WittVector p k)) :
      (WittVector p k)[X]).IsEisensteinAt (IsLocalRing.maximalIdeal (WittVector p k)) := by
  -- Rewrite the maximal ideal as `(p)` so the mapped cyclotomic Eisenstein criterion applies.
  rw [wittVector_maximalIdeal_eq_span_prime (p := p) (k := k)]
  let φ : ℤ →+* WittVector p k := Int.castRingHom (WittVector p k)
  have hweak :
      (((Polynomial.map φ ((cyclotomic (p ^ (n + 1)) ℤ).comp (X + C (1 : ℤ)))) :
          (WittVector p k)[X]).IsWeaklyEisensteinAt
        (Ideal.span ({((p : ℕ) : WittVector p k)} : Set (WittVector p k)))) := by
    -- Map the already-proved integer Eisenstein polynomial to the Witt-vector DVR.
    simpa [φ, Ideal.map_span, Set.image_singleton] using
      (cyclotomic_prime_pow_comp_X_add_one_isEisensteinAt (p := p) n).isWeaklyEisensteinAt.map φ
  have hmonic :
      (((Polynomial.map φ ((cyclotomic (p ^ (n + 1)) ℤ).comp (X + C (1 : ℤ)))) :
          (WittVector p k)[X]).Monic) := by
    -- The shifted cyclotomic polynomial is monic before and after mapping to `W(k)`.
    simpa [φ] using
      ((cyclotomic.monic (p ^ (n + 1)) ℤ).comp (monic_X_add_C (1 : ℤ)) (by
        rw [natDegree_X_add_C]
        exact one_ne_zero)).map φ
  have hnotmem :
      (((Polynomial.map φ ((cyclotomic (p ^ (n + 1)) ℤ).comp (X + C (1 : ℤ)))) :
          (WittVector p k)[X]).coeff 0) ∉
        (Ideal.span ({((p : ℕ) : WittVector p k)} : Set (WittVector p k)) :
          Ideal (WittVector p k)) ^ 2 := by
    -- Read the constant term explicitly: after the shift it is exactly `p`, hence not in `(p)^2`.
    rw [coeff_map, coeff_zero_eq_eval_zero, eval_comp,
      cyclotomic_prime_pow_eq_geom_sum (R := ℤ) (p := p) (n := n) (Fact.out : Nat.Prime p),
      eval_add, eval_X, eval_C, zero_add, eval_finset_sum]
    simp only [eval_pow, eval_X, one_pow, Finset.sum_const, Finset.card_range]
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    rintro ⟨a, ha⟩
    have hp0 : ((p : ℕ) : WittVector p k) ≠ 0 := WittVector.p_nonzero p k
    have h1 : (p : WittVector p k) * a = 1 := by
      -- If `p ∈ (p)^2`, then `p` would become a unit after cancelling one copy of `p`.
      apply mul_left_cancel₀ hp0
      calc
        (p : WittVector p k) * ((p : WittVector p k) * a) =
            ((p : WittVector p k) * (p : WittVector p k)) * a := by
              simp [mul_assoc]
        _ = (p : WittVector p k) := by
              simpa [pow_two, mul_assoc] using ha.symm
        _ = (p : WittVector p k) * 1 := by simp
    have hpunit : IsUnit ((p : ℕ) : WittVector p k) :=
      isUnit_iff_exists_inv.mpr ⟨a, h1⟩
    exact (WittVector.irreducible (p := p) (k := k)).1 hpunit
  -- Reassemble the strong Eisenstein statement from the weak coefficient divisibility, monicity,
  -- and the explicit constant-term calculation.
  refine Polynomial.Monic.isEisensteinAt_of_mem_of_notMem ?_ ?_ ?_ ?_
  · simpa [Polynomial.map_comp, φ] using hmonic
  · exact
      Ideal.IsPrime.ne_top
        ((Ideal.span_singleton_prime (WittVector.p_nonzero p k)).2
          (WittVector.irreducible (p := p) (k := k)).prime)
  · intro i hi
    have hi' :
        i <
          (Polynomial.map φ ((cyclotomic (p ^ (n + 1)) ℤ).comp (X + C (1 : ℤ)))).natDegree := by
      simpa [Polynomial.map_comp, φ] using hi
    simpa [Polynomial.map_comp, φ] using hweak.mem hi'
  · simpa [Polynomial.map_comp, φ] using hnotmem

/-- Helper for Exercise 18-18.3-2: Serre's shifted `p`-power cyclotomic polynomial stays
irreducible over `W(k)`. This isolates the domain input for the positive `AdjoinRoot` branch. -/
private theorem shifted_prime_power_cyclotomic_irreducible_over_wittVector (n : ℕ) :
    Irreducible (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n) := by
  let f := shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n
  have hE :
      f.IsEisensteinAt (IsLocalRing.maximalIdeal (WittVector p k)) := by
    simpa [f, shifted_prime_power_cyclotomic_polynomial] using
      shifted_prime_power_cyclotomic_isEisenstein_over_wittVector
      (p := p) (k := k) n
  have hmonic : f.Monic := by
    -- Read the shifted cyclotomic polynomial as a mapped monic cyclotomic composed with `X + 1`.
    dsimp [f, shifted_prime_power_cyclotomic_polynomial]
    simpa using
      (((cyclotomic.monic (p ^ (n + 1)) ℤ)).map (Int.castRingHom (WittVector p k))).comp
        (monic_X_add_C (1 : WittVector p k))
        (by
          rw [natDegree_X_add_C]
          exact one_ne_zero)
  have hdeg : 0 < f.natDegree := by
    -- Compute the degree from the source cyclotomic polynomial and the shift by `X + 1`.
    dsimp [f, shifted_prime_power_cyclotomic_polynomial]
    rw [natDegree_comp, natDegree_X_add_C, Nat.mul_one]
    rw [((cyclotomic.monic (p ^ (n + 1)) ℤ)).natDegree_map (Int.castRingHom (WittVector p k))]
    rw [natDegree_cyclotomic]
    exact (Nat.totient_pos).2 (pow_pos (Nat.Prime.pos (Fact.out : Nat.Prime p)) _)
  have hprime :
      (IsLocalRing.maximalIdeal (WittVector p k)).IsPrime := by
    infer_instance
  -- Eisenstein irreducibility is the source-faithful input for the totally ramified branch.
  exact hE.irreducible hprime hmonic.isPrimitive hdeg

/-- Helper for Exercise 18-18.3-2: in the positive branch, the adjoined element `root + 1`
already satisfies the unshifted cyclotomic equation. This isolates the arithmetic half of the
primitive-root step from the remaining DVR-owner packaging. -/
private theorem shifted_prime_power_cyclotomic_root_plus_one_isRoot (n : ℕ) :
    IsRoot
      ((((cyclotomic (p ^ (n + 1)) ℤ).map (Int.castRingHom (WittVector p k))).map
        (AdjoinRoot.of (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))) :
          (AdjoinRoot
            (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))[X])
      (AdjoinRoot.root (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n) + 1) := by
  have hroot :
      IsRoot
        (((shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n).map
          (AdjoinRoot.of
            (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))) :
          (AdjoinRoot
            (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))[X])
        (AdjoinRoot.root (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) :=
    AdjoinRoot.isRoot_root _
  -- Evaluate the defining shifted polynomial at `AdjoinRoot.root`; this rewrites to the original
  -- cyclotomic polynomial evaluated at `AdjoinRoot.root + 1`.
  rw [IsRoot, eval_map]
  simpa [shifted_prime_power_cyclotomic_polynomial, IsRoot, eval_map, eval₂_comp, add_comm,
    add_left_comm, add_assoc, eval₂_X, eval₂_C] using hroot

/-- Helper for Exercise 18-18.3-2: once the positive-branch `AdjoinRoot` is known to be a domain
with characteristic-zero fraction field, the image of `AdjoinRoot.root + 1` is the required
primitive root of order `p^(n+1)`. -/
theorem shifted_prime_power_cyclotomic_root_isPrimitiveRoot
    (n : ℕ)
    (K1 : Type u)
    [Field K1]
    [Algebra
      (AdjoinRoot (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) K1]
    [IsFractionRing
      (AdjoinRoot (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) K1]
    [CharZero K1] :
    IsPrimitiveRoot
      (algebraMap
        (AdjoinRoot (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) K1
        (AdjoinRoot.root (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n) + 1))
      (p ^ (n + 1)) := by
  let z : K1 :=
    algebraMap
      (AdjoinRoot (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) K1
      (AdjoinRoot.root (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n) + 1)
  have hrootK :
      IsRoot
        (((((cyclotomic (p ^ (n + 1)) ℤ).map (Int.castRingHom (WittVector p k))).map
          (AdjoinRoot.of (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))).map
          (algebraMap
            (AdjoinRoot (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) K1)) :
          K1[X]) z := by
    -- First map the cyclotomic root from the `AdjoinRoot` owner to its characteristic-zero
    -- fraction field.
    simpa [z] using
      (Polynomial.IsRoot.map
        (f := algebraMap
          (AdjoinRoot (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) K1)
        (shifted_prime_power_cyclotomic_root_plus_one_isRoot (p := p) (k := k) n))
  have hrootK' : IsRoot (cyclotomic (p ^ (n + 1)) K1) z := by
    -- The iterated coefficient maps collapse to the standard cyclotomic polynomial over `K1`.
    simpa [Polynomial.map_map] using hrootK
  -- Over the characteristic-zero field `K1`, being a cyclotomic root is equivalent to being
  -- primitive of the corresponding order.
  exact
    (Polynomial.isRoot_cyclotomic_iff_charZero (R := K1) (μ := z)
      (show 0 < p ^ (n + 1) by
        exact pow_pos (show 0 < p from Nat.Prime.pos (Fact.out : Nat.Prime p)) _)).1 hrootK'

/-- Helper for Exercise 18-18.3-2: isolate the only genuinely missing owner in Serre's source
route, namely a mixed-characteristic DVR over `W(k)` whose fraction field contains a primitive
root of unity of order equal to the `p`-part of `Monoid.exponent G`. -/
private theorem wittVector_henselianLocalRing :
    HenselianLocalRing (WittVector p k) := by
  have hH : HenselianRing (WittVector p k) (Ideal.span {((p : ℕ) : WittVector p k)}) := by
    infer_instance
  refine
    { toIsLocalRing := inferInstance
      is_henselian := ?_ }
  intro f hf a₀ h₁ h₂
  -- Rewrite the maximal ideal as `(p)` so the generic `p`-adic Henselian owner applies.
  rw [wittVector_maximalIdeal_eq_span_prime (p := p) (k := k)] at h₁ ⊢
  have h₂' :
      IsUnit
        (Ideal.Quotient.mk (Ideal.span {((p : ℕ) : WittVector p k)}) (f.derivative.eval a₀)) := by
    exact IsUnit.map (Ideal.Quotient.mk (Ideal.span {((p : ℕ) : WittVector p k)})) h₂
  simpa using hH.is_henselian f hf a₀ h₁ h₂'

/-- Helper for Exercise 18-18.3-2: the Witt-vector DVR over a characteristic-`p` field has
characteristic zero, so its fraction field does as well. -/
private theorem wittVector_charZero :
    CharZero (WittVector p k) := by
  refine charZero_of_inj_zero ?_
  intro n hn
  induction n using Nat.strong_induction_on with
  | h n ih =>
      by_cases hn0 : n = 0
      · exact hn0
      have hconst : (n : k) = 0 := by
        -- The constant coefficient of a natural Witt vector is the same natural number in `k`.
        simpa using congrArg (WittVector.constantCoeff : WittVector p k →+* k) hn
      have hpdvd : p ∣ n := (CharP.cast_eq_zero_iff k p n).mp hconst
      rcases hpdvd with ⟨m, rfl⟩
      have hm_mul_zero : ((m : WittVector p k) * (p : WittVector p k)) = 0 := by
        -- Peel off one factor of `p` from the vanished natural Witt vector.
        simpa [Nat.cast_mul, mul_comm, mul_left_comm, mul_assoc] using hn
      have hm_zero : (m : WittVector p k) = 0 :=
        WittVector.eq_zero_of_p_mul_eq_zero (p := p) (k := k) (x := (m : WittVector p k))
          hm_mul_zero
      have hm0 : m ≠ 0 := by
        intro hm0
        exact hn0 (by simp [hm0])
      have hm_lt : m < p * m := by
        -- Dividing by `p` strictly decreases a positive natural number because `p > 1`.
        calc
          m = 1 * m := by simp
          _ < p * m := by
              exact
                Nat.mul_lt_mul_of_pos_right (show 1 < p from (Fact.out : Nat.Prime p).one_lt)
                  (Nat.pos_of_ne_zero hm0)
      have hm_eq_zero : m = 0 := ih m hm_lt hm_zero
      simp [hm_eq_zero]

/-- Helper for Exercise 18-18.3-2: isolate the only genuinely missing owner in Serre's source
route, namely a mixed-characteristic DVR over `W(k)` whose fraction field contains a primitive
root of unity of order equal to the `p`-part of `Monoid.exponent G`. -/
private theorem exists_totally_ramified_p_power_root_extension_over_wittVector_of_factorization_eq_zero
    (hpow : Nat.factorization (Monoid.exponent G) p = 0) :
    ∃ (A1 : Type u) (_ : CommRing A1) (_ : IsLocalRing A1) (_ : HenselianLocalRing A1)
      (_ : IsDomain A1) (_ : IsDiscreteValuationRing A1) (_ : Algebra (WittVector p k) A1)
      (K1 : Type u) (_ : Field K1) (_ : Algebra A1 K1) (_ : IsFractionRing A1 K1)
      (_ : CharZero K1) (e1 : IsLocalRing.ResidueField A1 ≃+* k) (ζp : K1),
        IsPrimitiveRoot ζp (p ^ Nat.factorization (Monoid.exponent G) p) := by
  -- When the `p`-part of the exponent is trivial, Serre's mixed-character owner is already the
  -- base Witt-vector DVR and the required primitive root is `1`.
  haveI : CharZero (WittVector p k) := wittVector_charZero (p := p) (k := k)
  refine ⟨WittVector p k, inferInstance, inferInstance,
    wittVector_henselianLocalRing (p := p) (k := k), inferInstance,
    inferInstance, inferInstance, FractionRing (WittVector p k), inferInstance, inferInstance,
    inferInstance, inferInstance,
    wittVector_residueField_ringEquiv (p := p) (k := k),
    (1 : FractionRing (WittVector p k)), ?_⟩
  -- The only primitive root of order `1` is `1` itself.
  simpa [hpow] using (IsPrimitiveRoot.one (M := FractionRing (WittVector p k)))

/-- Helper for Exercise 18-18.3-2: isolate the only genuinely missing owner in Serre's source
route, namely a mixed-characteristic DVR over `W(k)` whose fraction field contains a primitive
root of unity of order equal to the `p`-part of `Monoid.exponent G`. -/
theorem exists_totally_ramified_p_power_root_extension_over_wittVector :
    ∃ (A1 : Type u) (_ : CommRing A1) (_ : IsLocalRing A1) (_ : HenselianLocalRing A1)
      (_ : IsDomain A1) (_ : IsDiscreteValuationRing A1) (_ : Algebra (WittVector p k) A1)
      (K1 : Type u) (_ : Field K1) (_ : Algebra A1 K1) (_ : IsFractionRing A1 K1)
      (_ : CharZero K1) (e1 : IsLocalRing.ResidueField A1 ≃+* k) (ζp : K1),
        IsPrimitiveRoot ζp (p ^ Nat.factorization (Monoid.exponent G) p) := by
  -- Route correction: keep the source proof anchored at `W(k)` and isolate only the unsolved
  -- `p`-power cyclotomic extension, rather than reopening the downstream Cartan transport.
  let r := Nat.factorization (Monoid.exponent G) p
  cases hr : r with
  | zero =>
      -- The trivial `p`-part branch is already packaged by the base Witt-vector DVR.
      exact
        exists_totally_ramified_p_power_root_extension_over_wittVector_of_factorization_eq_zero
          (p := p) (k := k) (G := G) (by simpa [r] using hr)
  | succ n =>
      let f := shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n
      let A1 := AdjoinRoot f
      have hfirr : Irreducible f :=
        shifted_prime_power_cyclotomic_irreducible_over_wittVector (p := p) (k := k) n
      have hmonic : f.Monic := by
        -- Keep the positive branch aligned with the shifted cyclotomic owner fixed above.
        dsimp [f, shifted_prime_power_cyclotomic_polynomial]
        simpa using
          (((cyclotomic.monic (p ^ (n + 1)) ℤ)).map (Int.castRingHom (WittVector p k))).comp
            (monic_X_add_C (1 : WittVector p k))
            (by
              rw [natDegree_X_add_C]
              exact one_ne_zero)
      have hdeg : 0 < f.natDegree := by
        -- The newly isolated irreducibility theorem already rules out the constant case.
        exact hmonic.natDegree_pos.mpr hfirr.ne_one
      have hdeg_ne_zero : f.degree ≠ 0 := by
        exact ne_of_gt ((natDegree_pos_iff_degree_pos).mp hdeg)
      haveI : IsDomain A1 := AdjoinRoot.isDomain_of_prime hfirr.prime
      have hA1_injective : Function.Injective (AdjoinRoot.of f) :=
        AdjoinRoot.of.injective_of_degree_ne_zero hdeg_ne_zero
      haveI : CharZero A1 := by
        letI : CharZero (WittVector p k) := wittVector_charZero (p := p) (k := k)
        refine charZero_of_inj_zero ?_
        intro m hm
        have hm' : ((m : WittVector p k)) = 0 := by
          apply hA1_injective
          simpa [AdjoinRoot.algebraMap_eq] using hm
        exact_mod_cast hm'
      haveI :
          Field
            (FractionRing
              (AdjoinRoot
                (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))) :=
        FractionRing.field
          (AdjoinRoot
            (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))
      haveI :
          IsFractionRing
            (AdjoinRoot
              (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))
            (FractionRing
              (AdjoinRoot
                (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))) := by
        change
          IsLocalization
            (nonZeroDivisors
              (AdjoinRoot
                (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)))
            (Localization
              (nonZeroDivisors
                (AdjoinRoot
                  (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))))
        exact
          Localization.isLocalization
            (M := nonZeroDivisors
              (AdjoinRoot
                (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)))
      haveI :
          Algebra
            (AdjoinRoot
              (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))
            (FractionRing
              (AdjoinRoot
                (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))) := by
        change
          Algebra
            (AdjoinRoot
              (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))
            (Localization
              (nonZeroDivisors
                (AdjoinRoot
                  (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))))
        infer_instance
      haveI :
          CharZero
            (FractionRing
              (AdjoinRoot
                (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))) := by
        infer_instance
      let ζp :
          FractionRing
            (AdjoinRoot
              (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) :=
        algebraMap
          (AdjoinRoot
            (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))
          (FractionRing
            (AdjoinRoot
              (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)))
          (AdjoinRoot.root f + 1)
      have hζp_explicit :
          IsPrimitiveRoot
            (algebraMap
              (AdjoinRoot
                (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))
              (FractionRing
                (AdjoinRoot
                  (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)))
              (AdjoinRoot.root
                  (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n) + 1))
            (p ^ (n + 1)) :=
        by
          let z :
              FractionRing
                (AdjoinRoot
                  (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)) :=
            algebraMap
              (AdjoinRoot
                (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))
              (FractionRing
                (AdjoinRoot
                  (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)))
              (AdjoinRoot.root f + 1)
          have hrootK :
              IsRoot
                (((((cyclotomic (p ^ (n + 1)) ℤ).map (Int.castRingHom (WittVector p k))).map
                  (AdjoinRoot.of
                    (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))).map
