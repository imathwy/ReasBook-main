import Mathlib
import Mathlib.Tactic.Recall

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory Limits

universe u v w

/-
Domain-style sampling for Definition 18.17.1:
- primary domain: global generation and global presentations of sheaves of modules;
- inspected owner declarations:
  `SheafOfModules.free`,
  `SheafOfModules.GeneratingSections`,
  `SheafOfModules.GeneratingSections.IsFiniteType`,
  `SheafOfModules.Presentation`,
  `SheafOfModules.IsLocallyGeneratedBy`;
- owner abstractions: `GeneratingSections` for global generators and `Presentation` for global
  presentations, together with the chapter owner `IsLocallyGeneratedBy` for the corresponding
  local rank-`r` notion;
- primitive data: isomorphisms with free sheaves, generating families of global sections,
  epimorphisms from `free (ULift (Fin r))`, and presentations by free sheaves;
- derived API: the source-facing global rank-`r` and finite global generation predicates built
  from those owners.

Layer triage:
- `source-facing`: freeness, finite freeness, “generated by `r` global sections”, “finitely
  globally generated”, and “has finite global presentation”;
- `core/canonical`: `free`, `GeneratingSections`, `Presentation`, and the chapter owner pattern
  `IsLocallyGeneratedBy`;
- `bridge/view`: the source-facing predicates `IsGeneratedBy` and `IsFiniteGloballyGenerated`
  relating the textbook wording to the owner data above.

The exact duplicate wrapper predicates around `GeneratingSections` and `Presentation` are therefore
removed below in favor of `Nonempty ℱ.GeneratingSections`, `Nonempty ℱ.Presentation`, and
`Nonempty {P : ℱ.Presentation // P.IsFinite}`. For the new source-facing content in parts (4) and
(5), the public layer is refined to the short chapter-style owners `IsGeneratedBy ℱ r` and
`IsFiniteGloballyGenerated ℱ`, rather than exposing subtype and `ULift` bookkeeping directly.
-/
namespace SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable {𝒪 : Sheaf J RingCat.{w}}
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [J.HasSheafCompose (forget₂ RingCat.{w} AddCommGrpCat.{w})]
variable (ℱ : SheafOfModules.{w} 𝒪)

/-- Definition 18.17.1 (1): a sheaf of `\mathcal O`-modules is free if it is isomorphic to a
free sheaf `\bigoplus_{i \in I} \mathcal O`. -/
class IsFree (ℱ : SheafOfModules.{w} 𝒪) : Prop where
  exists_iso_free : ∃ I : Type w, Nonempty (ℱ ≅ free I)

/-- Definition 18.17.1 (2): a sheaf of `\mathcal O`-modules is finite free if it is isomorphic to
a finite coproduct of copies of `\mathcal O`. -/
class IsFiniteFree (ℱ : SheafOfModules.{w} 𝒪) : Prop where
  exists_iso_free :
    ∃ I : Type w, Finite I ∧ Nonempty (ℱ ≅ free I)

/- Definition 18.17.1 (3): a sheaf of `\mathcal O`-modules is generated by global sections iff it
admits a family of generating sections, i.e. iff `Nonempty ℱ.GeneratingSections`. -/
#check (Nonempty ℱ.GeneratingSections)

/- Companion recall: `ℱ.GeneratingSections` is the canonical owner for a chosen family of
generating global sections. -/
recall SheafOfModules.GeneratingSections

/-- Definition 18.17.1 (4): a sheaf of `\mathcal O`-modules is generated by `r` global sections
if it admits an epimorphism `\mathcal O^{\oplus r} \to \mathcal F`. -/
class IsGeneratedBy (ℱ : SheafOfModules.{w} 𝒪) (r : ℕ) : Prop where
  exists_epi :
    ∃ π : free (ULift.{w} (Fin r)) ⟶ ℱ, Epi π

/-- A generating family indexed by `r` elements is equivalently an epimorphism
`\mathcal O^{\oplus r} \to \mathcal F`. -/
theorem isGeneratedBy_iff_nonempty_generatingSections_equiv_fin
    (ℱ : SheafOfModules.{w} 𝒪) (r : ℕ) :
    IsGeneratedBy ℱ r ↔
      Nonempty {σ : ℱ.GeneratingSections // Nonempty (σ.I ≃ ULift.{w} (Fin r))} := sorry

/-- Definition 18.17.1 (5): a sheaf of `\mathcal O`-modules is finitely globally generated if it
is generated by `r` global sections for some `r`. -/
class IsFiniteGloballyGenerated (ℱ : SheafOfModules.{w} 𝒪) : Prop where
  exists_num : ∃ r : ℕ, IsGeneratedBy ℱ r

/-- A sheaf is finitely globally generated iff it admits a finite-type family of generating
sections. -/
theorem isFiniteGloballyGenerated_iff_nonempty_finiteGeneratingSections
    (ℱ : SheafOfModules.{w} 𝒪) :
    IsFiniteGloballyGenerated ℱ ↔
      Nonempty {σ : ℱ.GeneratingSections // σ.IsFiniteType} := sorry

/- Definition 18.17.1 (6): a sheaf of `\mathcal O`-modules has a global presentation iff it
admits one, i.e. iff `Nonempty ℱ.Presentation`. -/
#check (Nonempty ℱ.Presentation)

/- Companion recall: `ℱ.Presentation` is the canonical owner for a chosen global presentation. -/
recall SheafOfModules.Presentation

/- Definition 18.17.1 (7): a sheaf of `\mathcal O`-modules has a global finite presentation iff
it admits a finite global presentation, i.e. iff
`Nonempty {P : ℱ.Presentation // P.IsFinite}`. -/
#check (Nonempty {P : ℱ.Presentation // P.IsFinite})

/-- A free sheaf of modules is free. -/
instance free_isFree (I : Type w) : IsFree (free I : SheafOfModules.{w} 𝒪) := sorry

/-- A free sheaf on a finite index type is finite free. -/
instance free_isFiniteFree (I : Type w) [Finite I] :
    IsFiniteFree (free I : SheafOfModules.{w} 𝒪) := sorry

/-- A finite free sheaf is free. -/
instance isFiniteFree_to_isFree (ℱ : SheafOfModules.{w} 𝒪) [IsFiniteFree ℱ] :
    IsFree ℱ := sorry

/-- A free sheaf is globally generated by its tautological basis sections. -/
instance free_generatingSections (I : Type w) :
    Nonempty (free I : SheafOfModules.{w} 𝒪).GeneratingSections := sorry

/-- The free sheaf `\mathcal O^{\oplus r}` is generated by `r` global sections. -/
instance free_fin_isGeneratedBy (r : ℕ) :
    IsGeneratedBy (free (ULift.{w} (Fin r)) : SheafOfModules.{w} 𝒪) r := sorry

/-- Being generated by `r` global sections implies being generated by global sections. -/
theorem generatingSections_of_isGeneratedBy
    (ℱ : SheafOfModules.{w} 𝒪) (r : ℕ) [IsGeneratedBy ℱ r] :
    Nonempty ℱ.GeneratingSections := sorry

/-- Being generated by `r` global sections implies finite global generation. -/
theorem isFiniteGloballyGenerated_of_isGeneratedBy
    (ℱ : SheafOfModules.{w} 𝒪) (r : ℕ) [IsGeneratedBy ℱ r] :
    IsFiniteGloballyGenerated ℱ := sorry

/-- A finitely globally generated sheaf is generated by global sections. -/
instance isFiniteGloballyGenerated_to_generatingSections
    (ℱ : SheafOfModules.{w} 𝒪) [IsFiniteGloballyGenerated ℱ] :
    Nonempty ℱ.GeneratingSections := sorry

/-- A free sheaf has a global presentation. -/
instance free_presentation (I : Type w) :
    Nonempty (free I : SheafOfModules.{w} 𝒪).Presentation := sorry

/-- A finite free sheaf has a finite global presentation. -/
instance free_finitePresentation (I : Type w) [Finite I] :
    Nonempty {P : (free I : SheafOfModules.{w} 𝒪).Presentation // P.IsFinite} := sorry

/-- A finite global presentation is, in particular, a global presentation. -/
instance finitePresentation_to_presentation
    (ℱ : SheafOfModules.{w} 𝒪) [Nonempty {P : ℱ.Presentation // P.IsFinite}] :
    Nonempty ℱ.Presentation := sorry

end SheafOfModules
