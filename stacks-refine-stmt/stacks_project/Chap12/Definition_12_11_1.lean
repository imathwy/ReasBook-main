variable (A : Type u) [Category.{v} A] [Abelian A]

/- Domain-style sampling for Definition 12.11.1:
- primary domain: Grothendieck groups of abelian categories, presented by short-exact-sequence
  relations on the free abelian group of objects;
- sampled owner declarations: `ShortComplex.ShortExact`, `FreeAbelianGroup.lift`,
  `QuotientAddGroup.lift`, and the monoid-style universal property
  `Algebra.GrothendieckGroup.lift`;
- best owner abstraction in this file: the quotient of `FreeAbelianGroup A` by the subgroup
  generated by the short-exact relations;
- primitive data: the ambient abelian category and its short exact sequences;
- derived API: the class map `of`, the universal morphism `lift`, and the additivity theorem
  `of_shortExact`.
-/

/-- The Grothendieck relation `[X₂] - [X₁] - [X₃]` attached to a short exact sequence
`0 ⟶ X₁ ⟶ X₂ ⟶ X₃ ⟶ 0`. -/
private def relation (S : { S : ShortComplex A // S.ShortExact }) : FreeAbelianGroup A :=
  FreeAbelianGroup.of S.1.X₂ - FreeAbelianGroup.of S.1.X₁ - FreeAbelianGroup.of S.1.X₃

/-- The subgroup of the free abelian group on `A` generated by the Grothendieck relations coming
from short exact sequences. -/
def relations : AddSubgroup (FreeAbelianGroup A) :=
  AddSubgroup.closure (Set.range (relation A))

/-- The Grothendieck relation attached to a short exact sequence lies in `AbelianK0.relations`. -/
theorem sub_mem_relations_of_shortExact (S : ShortComplex A) (hS : S.ShortExact) :
    FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃ ∈ relations A :=
  AddSubgroup.subset_closure <| Set.mem_range.2 ⟨⟨S, hS⟩, rfl⟩

end

variable {A : Type u} [Category.{v} A] [Abelian A]

end AbelianK0

/-- Definition 12.11.1: the zeroth `K`-group `K₀(C)` of an abelian category `C` is the quotient
of the free abelian group on the objects of `C` by the relations `[X₂] = [X₁] + [X₃]` coming
from all short exact sequences `0 ⟶ X₁ ⟶ X₂ ⟶ X₃ ⟶ 0`. -/
abbrev AbelianK0 (A : Type u) [Category.{v} A] [Abelian A] : Type u :=
  FreeAbelianGroup A ⧸ AbelianK0.relations A

namespace AbelianK0

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- The class of an object of an abelian category in its Grothendieck group. -/
abbrev of (X : A) : AbelianK0 A :=
  QuotientAddGroup.mk' (relations A) (FreeAbelianGroup.of X)

/-- An additive invariant on objects of an abelian category descends to `K₀` as soon as it kills
the short-exact-sequence relations. -/
def lift {M : Type _} [AddCommGroup M] (f : A → M)
    (hf : relations A ≤ (FreeAbelianGroup.lift f).ker) :
    AbelianK0 A →+ M :=
  QuotientAddGroup.lift (relations A) (FreeAbelianGroup.lift f) hf

/-- The descended additive invariant evaluates on the class of an object by the original function.
-/
@[simp] theorem lift_of {M : Type _} [AddCommGroup M] (f : A → M)
    (hf : relations A ≤ (FreeAbelianGroup.lift f).ker) (X : A) :
    lift f hf (of X) = f X := by
  simp [lift, of]

/-- Class notation for the class of an object in `K₀`. -/
notation:max "K₀[" X "]" => AbelianK0.of X

-- Proof sketch: the quotient map `FreeAbelianGroup A → AbelianK0 A` kills every generator of
-- `AbelianK0.relations A`. Apply this to the generator coming from the given short exact
-- sequence and rearrange the resulting equality in the quotient group.
/-- The class map to `K₀(C)` is additive on short exact sequences in `C`. -/
theorem of_shortExact (S : ShortComplex A) (hS : S.ShortExact) :
    K₀[S.X₂] = K₀[S.X₁] + K₀[S.X₃] := by
  have hrelation₀ :
      QuotientAddGroup.mk' (relations A)
          (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0 :=
    (QuotientAddGroup.eq_zero_iff
      (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃)).2
      (sub_mem_relations_of_shortExact A S hS)
  have hrelation : K₀[S.X₂] - K₀[S.X₁] - K₀[S.X₃] = 0 := by
    simpa [of] using hrelation₀
  simpa [add_comm] using eq_add_of_sub_eq (sub_eq_zero.mp hrelation)

end AbelianK0

end CategoryTheory
