open Module
open scoped IntermediateField

universe u v

section

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]

/- Domain-style sampling for Lemma 9.24.3:
- primary domain: Kummer-style simple extensions and their intermediate fields;
- sampled owner declarations:
  `exists_root_adjoin_eq_top_of_isCyclic`,
  `IntermediateField.adjoin.finrank`,
  `IntermediateField.finrank_dvd_of_le_left`;
- best owner abstraction: `IntermediateField K L` is the ambient owner for subextensions, and for a
  fixed intermediate field `L'` the canonical divisor is its intrinsic index `finrank L' L`;
- primitive data: a generator `α : L` with `K⟮α⟯ = ⊤`, together with the conditions that
  `α ^ [L : K]` and every `[L : K]`th root of unity already lie in the base field `K`;
- derived API: the source divisor `d` is not primitive data; the owner-level choice
  `d := finrank L' L` and the divisibility statement come from
  `IntermediateField.finrank_dvd_of_le_left`.

Source/core/bridge triage:
- `source-facing`: the Stacks lemma that every intermediate field of the Kummer simple extension is
  generated by a suitable power of `α`;
- `core/canonical`: there is no upstream owner theorem for this exact intermediate-field statement,
  so the owner information is used internally through `IntermediateField K L` and `finrank L' L`;
- `bridge/view`: the canonical choice `d := finrank L' L`, kept internal to the proof rather than
  exposed as a second public theorem.

This file should therefore expose only the source-facing existence theorem. The finrank-indexed
choice of exponent is part of the proof architecture, not a parallel public owner API.
-/

/-- Lemma 9.24.3, source-facing form: every intermediate field of the Kummer simple extension
`L/K` is generated by a power `α ^ d`, where `d` divides `[L : K]`. The divisor `d` is derived
canonically from the intermediate field as `d = [L : L']`. -/
lemma exists_intermediateField_eq_adjoin_pow_of_kummer_simple_extension
    (α : L)
    (hgen : K⟮α⟯ = ⊤)
    (ha : α ^ finrank K L ∈ (⊥ : IntermediateField K L))
    (hroots : ∀ ζ : L, ζ ^ finrank K L = 1 → ζ ∈ (⊥ : IntermediateField K L))
    (L' : IntermediateField K L) :
    ∃ d : ℕ, d ∣ finrank K L ∧ L' = K⟮α ^ d⟯ := by
  have hpow : L' = K⟮α ^ finrank L' L⟯ := by
    sorry
  refine ⟨finrank L' L, ?_, hpow⟩
  simpa using
    (IntermediateField.finrank_dvd_of_le_left bot_le :
      finrank L' L ∣ finrank (⊥ : IntermediateField K L) L)

end
