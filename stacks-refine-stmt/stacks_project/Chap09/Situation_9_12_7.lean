import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

section

variable (F : Type u) (K : Type v)
variable [Field F] [Field K] [Algebra F K]

namespace Situation_9_12_7

/- Domain-style sampling:
* primary domain: finite field extensions generated by finitely many elements, intermediate
  fields obtained by adjoining successive generators, and minimal polynomials over those stages;
* sampled owner declarations:
  `IntermediateField.adjoin`,
  `IntermediateField.restrictScalars`,
  `_root_.minpoly`;
* best owner abstraction: the source-facing stage family `K_i = F(α₁, ..., αᵢ)` built inside the
  canonical owner `IntermediateField F K`;
* primitive data: a tuple of generators `α : Fin n → K`;
* derived API: the stage notation `K[F, α; i]` and the minimal-polynomial notation
  `P[F, α; i]`.

Source/core/bridge triage:
* `source-facing`: the stages `K_i` and the polynomials `P_i`;
* `core/canonical`: `IntermediateField.adjoin` and `minpoly`;
* `bridge/view`: the finite generated extension setup packaged below.
-/

variable {K}
variable {n : ℕ}

/-- The subset of `K` consisting of the first `i` chosen generators in the tuple `α`. -/
private def prefixGenerators (α : Fin n → K) (i : Fin (n + 1)) : Set K :=
  {x | ∃ j : Fin n, j.1 < i.1 ∧ α j = x}

open scoped IntermediateField

/-- The stage `K_i = F(α₁, ..., αᵢ)` in the tower attached to a tuple of generators
`α : Fin n → K`. -/
def stage (α : Fin n → K) (i : Fin (n + 1)) : IntermediateField F K :=
  IntermediateField.adjoin F (prefixGenerators α i)

scoped[Situation_9_12_7] notation "K[" F ", " α "; " i "]" => stage F α i

/-- The minimal polynomial of the generator `α i` over the preceding stage `K_{i - 1}` in the
tower attached to `α`. -/
scoped[Situation_9_12_7] notation "P[" F ", " α "; " i "]" =>
  minpoly (K[F, α; Fin.castSucc i]) (α i)

section

variable [FiniteDimensional F K]

/-- Situation 9.12.7: a finite extension `K/F` generated by a finite tuple
`α₁, ..., αₙ ∈ K`, encoded by the tuple of generators together with the condition that the last
stage `K_n = F(α₁, ..., αₙ)` is all of `K`. The algebraic closure fixed in the source is
represented canonically in later developments by `AlgebraicClosure F`. -/
structure GeneratedExtensionTower (K : Type v) [Field K] [Algebra F K] [FiniteDimensional F K] where
  /-- The number of chosen generators. -/
  n : ℕ
  /-- The ordered tuple of chosen generators of `K/F`. -/
  generators : Fin n → K
  /-- The last stage of the generator tower is the whole extension field `K`. -/
  top_stage : K[F, generators; Fin.last n] = ⊤

/-- A generated extension tower coerces to its ordered tuple of generators. -/
instance : CoeFun (GeneratedExtensionTower F K) (fun T ↦ Fin T.n → K) where
  coe T := T.generators

end

end Situation_9_12_7

end
