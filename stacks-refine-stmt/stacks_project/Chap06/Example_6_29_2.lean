/-- The points of the two-closed-points space from Example 6.29.2. -/
inductive TwoClosedPointsPoint where
  | s1
  | s2
  | xi (n : ℕ)

deriving DecidableEq

open TwoClosedPointsPoint

/-- The set of generic points `xi_n`. -/
def twoClosedPointsXiSet : Set TwoClosedPointsPoint :=
  {x | ∃ n : ℕ, x = xi n}

/-- The basic open containing `s1` and all generic points. -/
def twoClosedPointsS1BasicOpen : Set TwoClosedPointsPoint :=
  {s1} ∪ twoClosedPointsXiSet

/-- The basic open containing `s2` and all generic points. -/
def twoClosedPointsS2BasicOpen : Set TwoClosedPointsPoint :=
  {s2} ∪ twoClosedPointsXiSet

/-- The explicit topology used in Example 6.29.2. -/
instance : TopologicalSpace TwoClosedPointsPoint :=
  TopologicalSpace.generateFrom
    {U | (∃ n : ℕ, U = ({xi n} : Set TwoClosedPointsPoint)) ∨
        U = twoClosedPointsS1BasicOpen ∨ U = twoClosedPointsS2BasicOpen}

/-- The topological space with closed points `s1`, `s2` and generic points `xi_n`. -/
noncomputable abbrev twoClosedPointsSpace : TopCat :=
  TopCat.of TwoClosedPointsPoint

local notation "JX" => Opens.grothendieckTopology twoClosedPointsSpace

/-- The first closed point as a point of `twoClosedPointsSpace`. -/
noncomputable abbrev twoClosedPointsS1Point : twoClosedPointsSpace :=
  s1

/-- The second closed point as a point of `twoClosedPointsSpace`. -/
noncomputable abbrev twoClosedPointsS2Point : twoClosedPointsSpace :=
  s2

/-- The tail subset `U_n = {xi_n, xi_{n+1}, ...}`. -/
def tailOpenSet (n : ℕ) : Set twoClosedPointsSpace :=
  {x | ∃ m : ℕ, n ≤ m ∧ x = xi m}

-- Proof sketch: `U_n` is the union of the singleton basic opens `{xi_m}` for `m ≥ n`, hence it is
-- open in the topology generated by those singleton opens together with the neighborhoods of `s1`
-- and `s2`.
/-- The tail subset `U_n` is open in the topology of the two-closed-points space. -/
theorem tailOpenSet_isOpen (n : ℕ) : IsOpen (tailOpenSet n) := sorry

/-- The open subset `U_n` of the two-closed-points space. -/
def tailOpen (n : ℕ) : Opens twoClosedPointsSpace :=
  ⟨tailOpenSet n, tailOpenSet_isOpen n⟩

/-- The open subspace attached to `U_n`. -/
noncomputable abbrev tailOpenSpace (n : ℕ) : TopCat :=
  (Opens.toTopCat twoClosedPointsSpace).obj (tailOpen n)

/-- The inclusion `j_n : U_n -> X`. -/
noncomputable abbrev tailOpenInclusion (n : ℕ) :
    tailOpenSpace n ⟶ twoClosedPointsSpace :=
  Opens.inclusion' (tailOpen n)

/-- The constant `Z`-sheaf on the open subspace `U_n`. -/
noncomputable abbrev tailConstantIntegerSheaf (n : ℕ) :
    TopCat.Sheaf AddCommGrpCat (tailOpenSpace n) :=
  (constantSheaf (Opens.grothendieckTopology (tailOpenSpace n)) AddCommGrpCat).obj
    (AddCommGrpCat.of ℤ)

private abbrev tailSectionIndex (n : ℕ) (U : Opens twoClosedPointsSpace) :=
  {m : ℕ // n ≤ m ∧ xi m ∈ U}

private noncomputable abbrev tailSectionValue (n : ℕ) (U : Opens twoClosedPointsSpace) :
    AddCommGrpCat :=
  AddCommGrpCat.of (tailSectionIndex n U → ℤ)

private noncomputable def tailSectionRestriction (n : ℕ) {U V : Opens twoClosedPointsSpace}
    (i : U ≤ V) :
    tailSectionValue n V ⟶ tailSectionValue n U :=
  AddCommGrpCat.ofHom
    { toFun := fun f x ↦ f ⟨x.1, x.2.1, i x.2.2⟩
      map_zero' := by
        ext x
        rfl
      map_add' := by
        intro a b
        ext x
        rfl }

/-- An explicit internal model for `j_{n,*}\underline{Z}` whose sections over `U`
are functions on the indices `m ≥ n` with `ξ_m ∈ U`. -/
private noncomputable def tailPushforwardIntegerSheafModelPresheaf (n : ℕ) :
    TopCat.Presheaf AddCommGrpCat twoClosedPointsSpace where
  obj U := tailSectionValue n U.unop
  map {U V} i := tailSectionRestriction n i.unop.le
  map_id := by
    intro U
    ext f x
    rfl
  map_comp := by
    intro U V W i j
    ext f x
    rfl

/-- The explicit internal sheaf model for `j_{n,*}\underline{Z}`. -/
private noncomputable def tailPushforwardIntegerSheafModel (n : ℕ) :
    TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace :=
  ⟨tailPushforwardIntegerSheafModelPresheaf n, by sorry⟩

/-- The canonical pushforward sheaf `j_{n,*}\underline{Z}` from Example 6.29.2. -/
noncomputable abbrev tailPushforwardIntegerSheaf (n : ℕ) :
    TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace :=
  (pushforward AddCommGrpCat (tailOpenInclusion n)).obj (tailConstantIntegerSheaf n)

private noncomputable abbrev tailOpenSectionValue (n : ℕ) (W : Opens (tailOpenSpace n)) :
    AddCommGrpCat :=
  AddCommGrpCat.of (W → ℤ)

private noncomputable def tailOpenSectionRestriction (n : ℕ)
    {U V : Opens (tailOpenSpace n)} (i : U ≤ V) :
    tailOpenSectionValue n V ⟶ tailOpenSectionValue n U :=
  AddCommGrpCat.ofHom
    { toFun := fun f x ↦ f ⟨x.1, i x.2⟩
      map_zero' := by
        ext x
        rfl
      map_add' := by
        intro a b
        ext x
        rfl }

private noncomputable def tailIntegerFunctionSheafPresheaf (n : ℕ) :
    TopCat.Presheaf AddCommGrpCat (tailOpenSpace n) where
  obj U := tailOpenSectionValue n U.unop
  map {U V} i := tailOpenSectionRestriction n i.unop.le
  map_id := by
    intro U
    ext f x
    rfl
  map_comp := by
    intro U V W i j
    ext f x
    rfl

private noncomputable def tailIntegerFunctionSheaf (n : ℕ) :
    TopCat.Sheaf AddCommGrpCat (tailOpenSpace n) :=
  ⟨tailIntegerFunctionSheafPresheaf n, by sorry⟩

private noncomputable def tailConstantIntegerSheafToFunctionSheafPresheafMap (n : ℕ) :
    (Functor.const (Opens (tailOpenSpace n))ᵒᵖ).obj (AddCommGrpCat.of ℤ) ⟶
      (tailIntegerFunctionSheaf n).presheaf where
  app W :=
    AddCommGrpCat.ofHom
      { toFun := fun z _ ↦ z
        map_zero' := by
          ext x
          rfl
        map_add' := by
          intro a b
          ext x
          rfl }
  naturality := by
    intro U V i
    ext z
    rfl

private noncomputable def tailConstantIntegerSheafToFunctionSheaf (n : ℕ) :
    tailConstantIntegerSheaf n ⟶ tailIntegerFunctionSheaf n :=
  ⟨sheafifyLift (Opens.grothendieckTopology (tailOpenSpace n))
      (tailConstantIntegerSheafToFunctionSheafPresheafMap n)
      (tailIntegerFunctionSheaf n).property⟩

private def tailOpenPreimagePointOfIndex (n : ℕ) {U : Opens twoClosedPointsSpace}
    (x : tailSectionIndex n U) :
    (Opens.map (tailOpenInclusion n)).obj U :=
  ⟨⟨xi x.1, ⟨x.1, x.2.1, rfl⟩⟩, x.2.2⟩

private noncomputable def tailIntegerFunctionSheafPushforwardToModel (n : ℕ) :
    (pushforward AddCommGrpCat (tailOpenInclusion n)).obj (tailIntegerFunctionSheaf n) ⟶
      tailPushforwardIntegerSheafModel n :=
  ObjectProperty.homMk
    { app := fun U ↦
        AddCommGrpCat.ofHom
          { toFun := fun f x ↦ f (tailOpenPreimagePointOfIndex n x)
            map_zero' := by
              ext x
              rfl
            map_add' := by
              intro a b
              ext x
              rfl }
      naturality := by
        intro U V i
        ext f
        rfl }

/-- The comparison morphism from the pushforward sheaf `j_{n,*}\underline{Z}` to the explicit
index-function model. -/
private noncomputable def tailPushforwardIntegerSheafToModel (n : ℕ) :
    tailPushforwardIntegerSheaf n ⟶ tailPushforwardIntegerSheafModel n :=
  (pushforward AddCommGrpCat (tailOpenInclusion n)).map
      (tailConstantIntegerSheafToFunctionSheaf n) ≫
    tailIntegerFunctionSheafPushforwardToModel n

private instance tailConstantIntegerSheafToFunctionSheaf_isIso (n : ℕ) :
    IsIso (tailConstantIntegerSheafToFunctionSheaf n) := by
  sorry

private instance tailIntegerFunctionSheafPushforwardToModel_isIso (n : ℕ) :
    IsIso (tailIntegerFunctionSheafPushforwardToModel n) := by
  sorry

private instance tailPushforwardIntegerSheafToModel_isIso (n : ℕ) :
    IsIso (tailPushforwardIntegerSheafToModel n) := by
  change IsIso
    ((pushforward AddCommGrpCat (tailOpenInclusion n)).map
        (tailConstantIntegerSheafToFunctionSheaf n) ≫
      tailIntegerFunctionSheafPushforwardToModel n)
  infer_instance

private noncomputable abbrev tailPushforwardIntegerSheafModelIso (n : ℕ) :
    tailPushforwardIntegerSheaf n ≅ tailPushforwardIntegerSheafModel n :=
  asIso (tailPushforwardIntegerSheafToModel n)

private noncomputable def tailPushforwardIntegerSheafModelMap {i j : ℕ} (h : i ≤ j) :
    tailPushforwardIntegerSheafModel i ⟶ tailPushforwardIntegerSheafModel j :=
  ObjectProperty.homMk
    { app := fun U ↦
        AddCommGrpCat.ofHom
          { toFun := fun f x ↦ f ⟨x.1, le_trans h x.2.1, x.2.2⟩
            map_zero' := by
              ext x
              rfl
            map_add' := by
              intro a b
              ext x
              rfl }
      naturality := by
        intro U V i
        ext f
        rfl }

private theorem tailPushforwardIntegerSheafModelMap_id (i : ℕ) :
    tailPushforwardIntegerSheafModelMap (le_rfl : i ≤ i) = 𝟙 (tailPushforwardIntegerSheafModel i) := by
  apply Sheaf.hom_ext
  ext U f
  rfl

private theorem tailPushforwardIntegerSheafModelMap_comp {i j k : ℕ}
    (hij : i ≤ j) (hjk : j ≤ k) :
    tailPushforwardIntegerSheafModelMap (le_trans hij hjk) =
      tailPushforwardIntegerSheafModelMap hij ≫ tailPushforwardIntegerSheafModelMap hjk := by
  apply Sheaf.hom_ext
  ext U s
  rfl

/-- The canonical transition morphisms `j_{i,*}\underline{Z} → j_{j,*}\underline{Z}` for `i ≤ j`,
given by restriction on the explicit index-function model. -/
noncomputable def tailPushforwardIntegerSheafMap {i j : ℕ} (h : i ≤ j) :
    tailPushforwardIntegerSheaf i ⟶ tailPushforwardIntegerSheaf j :=
  tailPushforwardIntegerSheafToModel i ≫
    tailPushforwardIntegerSheafModelMap h ≫
      (tailPushforwardIntegerSheafModelIso j).inv

@[simp] theorem tailPushforwardIntegerSheafMap_id (i : ℕ) :
    tailPushforwardIntegerSheafMap (le_rfl : i ≤ i) = 𝟙 (tailPushforwardIntegerSheaf i) := by
  simp [tailPushforwardIntegerSheafMap, tailPushforwardIntegerSheafModelMap_id]

theorem tailPushforwardIntegerSheafMap_comp {i j k : ℕ}
    (hij : i ≤ j) (hjk : j ≤ k) :
    tailPushforwardIntegerSheafMap (le_trans hij hjk) =
      tailPushforwardIntegerSheafMap hij ≫ tailPushforwardIntegerSheafMap hjk := by
  have hcomp :=
    congrArg
      (fun t ↦ tailPushforwardIntegerSheafToModel i ≫ t ≫
        (tailPushforwardIntegerSheafModelIso k).inv)
      (tailPushforwardIntegerSheafModelMap_comp hij hjk)
  simpa [tailPushforwardIntegerSheafMap, Category.assoc] using hcomp

/-- The product `\prod_{m \ge n} Z` appearing in Example 6.29.2. -/
noncomputable abbrev tailIntegerProduct (n : ℕ) : AddCommGrpCat :=
  AddCommGrpCat.of ({m : ℕ // n ≤ m} → ℤ)

/-- The restriction maps in the direct system `n ↦ \prod_{m \ge n} Z`. -/
noncomputable def tailIntegerProductMap {i j : ℕ} (h : i ≤ j) :
    tailIntegerProduct i ⟶ tailIntegerProduct j :=
  AddCommGrpCat.ofHom
    { toFun := fun f x ↦ f ⟨x.1, le_trans h x.2⟩
      map_zero' := by ext x; rfl
      map_add' := by
        intro a b
        ext x
        rfl }

/-- The direct system `n ↦ \prod_{m \ge n} Z`. -/
noncomputable def tailIntegerProductFunctor : ℕ ⥤ AddCommGrpCat where
  obj n := tailIntegerProduct n
  map h := tailIntegerProductMap h.down.down
  map_id i := by
    ext f x
    rfl
  map_comp f g := by
    ext x y
    rfl

/-- The colimit `M = colim_n \prod_{m \ge n} Z`. -/
noncomputable abbrev eventualIntegerSequenceColimit : AddCommGrpCat :=
  colimit tailIntegerProductFunctor

/-- The direct system `n ↦ j_{n,*}\underline{Z}` on the two-closed-points space. -/
noncomputable def tailPushforwardIntegerSheafFunctor :
    ℕ ⥤ TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace where
  obj n := tailPushforwardIntegerSheaf n
  map h := tailPushforwardIntegerSheafMap h.down.down
  map_id := by
    intro i
    exact tailPushforwardIntegerSheafMap_id i
  map_comp := by
    intro i j k f g
    exact tailPushforwardIntegerSheafMap_comp f.down.down g.down.down

/-- The colimit sheaf `\mathcal{F} = \operatorname{colim}_n j_{n,*}\underline{Z}` from
Example 6.29.2. -/
noncomputable abbrev tailPushforwardIntegerSheafColimit :
    TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace :=
  colimit tailPushforwardIntegerSheafFunctor

/-- The sheaf identified in Example 6.29.2 as the direct sum of the two skyscraper sheaves with
value `M` at `s1` and `s2`. In the sheaf category this direct sum is the binary biproduct. -/
noncomputable abbrev twoClosedPointsSkyscraperPairSheaf :
    TopCat.Sheaf AddCommGrpCat twoClosedPointsSpace :=
  biprod
    (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
    (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)

/-- The canonical map from the global sections of the skyscraper sheaf at `s1` to its value `M`. -/
private noncomputable def s1SkyscraperGlobalSectionsToValue :
    (skyscraperPresheaf twoClosedPointsS1Point eventualIntegerSequenceColimit).obj (op ⊤) ⟶
      eventualIntegerSequenceColimit :=
  TopCat.Presheaf.Γgerm
      (skyscraperPresheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
        twoClosedPointsS1Point ≫
    (skyscraperPresheafStalkOfSpecializes twoClosedPointsS1Point eventualIntegerSequenceColimit
      specializes_rfl).hom

/-- The canonical map from the global sections of the skyscraper sheaf at `s2` to its value `M`. -/
private noncomputable def s2SkyscraperGlobalSectionsToValue :
    (skyscraperPresheaf twoClosedPointsS2Point eventualIntegerSequenceColimit).obj (op ⊤) ⟶
      eventualIntegerSequenceColimit :=
  TopCat.Presheaf.Γgerm
      (skyscraperPresheaf twoClosedPointsS2Point eventualIntegerSequenceColimit)
        twoClosedPointsS2Point ≫
    (skyscraperPresheafStalkOfSpecializes twoClosedPointsS2Point eventualIntegerSequenceColimit
      specializes_rfl).hom

private noncomputable def tailPushforwardIntegerSheafModelGlobalSectionsToProduct (n : ℕ) :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj (tailPushforwardIntegerSheafModel n) ⟶
      tailIntegerProduct n :=
  AddCommGrpCat.ofHom
    { toFun := fun f x ↦ f ⟨x.1, x.2, by simp⟩
      map_zero' := by
        ext x
        rfl
      map_add' := by
        intro a b
        ext x
        rfl }

/-- The canonical identification of the global sections of `j_{n,*}\underline{Z}` with the product
`\prod_{m \ge n} \mathbf{Z}`. -/
noncomputable def tailPushforwardIntegerSheafGlobalSectionsToProduct (n : ℕ) :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj (tailPushforwardIntegerSheaf n) ⟶
      tailIntegerProduct n :=
  ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map (tailPushforwardIntegerSheafToModel n) ≫
    tailPushforwardIntegerSheafModelGlobalSectionsToProduct n

theorem tailPushforwardIntegerSheafGlobalSectionsToProduct_naturality {i j : ℕ}
    (h : i ⟶ j) :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).map (tailPushforwardIntegerSheafFunctor.map h) ≫
        tailPushforwardIntegerSheafGlobalSectionsToProduct j =
      tailPushforwardIntegerSheafGlobalSectionsToProduct i ≫
        tailIntegerProductFunctor.map h := sorry

/-- The direct system of global sections `n ↦ Γ(X, j_{n,*}\underline{Z})`. -/
noncomputable abbrev tailPushforwardIntegerSheafGlobalSectionsFunctor : ℕ ⥤ AddCommGrpCat :=
  tailPushforwardIntegerSheafFunctor ⋙ (sheafSections JX AddCommGrpCat).obj (op ⊤)

/-- The canonical morphism of filtered systems from `n ↦ Γ(X, j_{n,*}\underline{Z})` to
`n ↦ \prod_{m \ge n} \mathbf{Z}`. -/
noncomputable def tailPushforwardIntegerSheafGlobalSectionsToProductNatTrans :
    tailPushforwardIntegerSheafGlobalSectionsFunctor ⟶ tailIntegerProductFunctor where
  app n := tailPushforwardIntegerSheafGlobalSectionsToProduct n
  naturality := by
    intro i j h
    exact tailPushforwardIntegerSheafGlobalSectionsToProduct_naturality h

private theorem tailPushforwardIntegerSheafGlobalSectionsColimitCocone_naturality {i j : ℕ}
    (h : i ⟶ j) :
    tailPushforwardIntegerSheafGlobalSectionsFunctor.map h ≫
        (tailPushforwardIntegerSheafGlobalSectionsToProduct j ≫
          colimit.ι tailIntegerProductFunctor j) =
      tailPushforwardIntegerSheafGlobalSectionsToProduct i ≫
        colimit.ι tailIntegerProductFunctor i := by
  sorry

private noncomputable def tailPushforwardIntegerSheafGlobalSectionsColimitCocone :
    Cocone tailPushforwardIntegerSheafGlobalSectionsFunctor where
  pt := eventualIntegerSequenceColimit
  ι :=
    { app := fun n ↦
        (tailPushforwardIntegerSheafGlobalSectionsToProductNatTrans.app n) ≫
          colimit.ι tailIntegerProductFunctor n
      naturality := by
        intro i j h
        exact tailPushforwardIntegerSheafGlobalSectionsColimitCocone_naturality h }

/-- The colimit of the global sections of the system `j_{n,*}\underline{Z}`. -/
noncomputable abbrev tailPushforwardIntegerSheafGlobalSectionsColimit : AddCommGrpCat :=
  colimit tailPushforwardIntegerSheafGlobalSectionsFunctor

/-- The canonical comparison from the colimit of the global sections of the system
`j_{n,*}\underline{Z}` to `M = \operatorname{colim}_n \prod_{m \ge n} \mathbf{Z}`. -/
noncomputable def tailPushforwardIntegerSheafGlobalSectionsColimitComparison :
    tailPushforwardIntegerSheafGlobalSectionsColimit ⟶
      eventualIntegerSequenceColimit :=
  colimit.desc _ tailPushforwardIntegerSheafGlobalSectionsColimitCocone

/-- The canonical comparison from the global sections of the example sheaf to the direct sum of its
two skyscraper values. -/
private noncomputable def twoClosedPointsSkyscraperPairGlobalSectionsComparison :
    ((sheafSections JX AddCommGrpCat).obj (op ⊤)).obj twoClosedPointsSkyscraperPairSheaf ⟶
      eventualIntegerSequenceColimit ⊞ eventualIntegerSequenceColimit :=
  Functor.biprodComparison
      ((sheafSections JX AddCommGrpCat).obj (op ⊤))
      (skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit)
      (skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit) ≫
    biprod.map s1SkyscraperGlobalSectionsToValue s2SkyscraperGlobalSectionsToValue

private theorem tailAllGenericsMem_of_s1_mem {U : Opens twoClosedPointsSpace}
    (hU : twoClosedPointsS1Point ∈ U) :
    ∀ m : ℕ, xi m ∈ U := by
  sorry

private theorem tailAllGenericsMem_of_s2_mem {U : Opens twoClosedPointsSpace}
    (hU : twoClosedPointsS2Point ∈ U) :
    ∀ m : ℕ, xi m ∈ U := by
  sorry

private noncomputable def tailSectionValueToColimitOfS1Mem (n : ℕ)
    {U : Opens twoClosedPointsSpace} (hU : twoClosedPointsS1Point ∈ U) :
    tailSectionValue n U ⟶ eventualIntegerSequenceColimit :=
  AddCommGrpCat.ofHom
    { toFun := fun f ↦
        colimit.ι tailIntegerProductFunctor n
          (fun x ↦ f ⟨x.1, x.2, tailAllGenericsMem_of_s1_mem hU x.1⟩)
      map_zero' := by
        sorry
      map_add' := by
        intro a b
        sorry }

private noncomputable def tailSectionValueToColimitOfS2Mem (n : ℕ)
    {U : Opens twoClosedPointsSpace} (hU : twoClosedPointsS2Point ∈ U) :
    tailSectionValue n U ⟶ eventualIntegerSequenceColimit :=
  AddCommGrpCat.ofHom
    { toFun := fun f ↦
        colimit.ι tailIntegerProductFunctor n
          (fun x ↦ f ⟨x.1, x.2, tailAllGenericsMem_of_s2_mem hU x.1⟩)
      map_zero' := by
        sorry
      map_add' := by
        intro a b
        sorry }

private noncomputable def tailPushforwardIntegerSheafModelToS1Skyscraper (n : ℕ) :
    tailPushforwardIntegerSheafModel n ⟶
      skyscraperSheaf twoClosedPointsS1Point eventualIntegerSequenceColimit :=
  ObjectProperty.homMk
    { app := fun U ↦ by
        classical
        by_cases hU : twoClosedPointsS1Point ∈ U.unop
        · exact tailSectionValueToColimitOfS1Mem n hU ≫ eqToHom (if_pos hU).symm
        · exact terminal.from _ ≫ eqToHom (if_neg hU).symm
      naturality := by
        sorry }

private noncomputable def tailPushforwardIntegerSheafModelToS2Skyscraper (n : ℕ) :
    tailPushforwardIntegerSheafModel n ⟶
      skyscraperSheaf twoClosedPointsS2Point eventualIntegerSequenceColimit :=
  ObjectProperty.homMk
    { app := fun U ↦ by
        classical
        by_cases hU : twoClosedPointsS2Point ∈ U.unop
        · exact tailSectionValueToColimitOfS2Mem n hU ≫ eqToHom (if_pos hU).symm
        · exact terminal.from _ ≫ eqToHom (if_neg hU).symm
      naturality := by
        sorry }

private noncomputable def tailPushforwardIntegerSheafModelToSkyscraperPair (n : ℕ) :
    tailPushforwardIntegerSheafModel n ⟶ twoClosedPointsSkyscraperPairSheaf :=
  biprod.lift
    (tailPushforwardIntegerSheafModelToS1Skyscraper n)
    (tailPushforwardIntegerSheafModelToS2Skyscraper n)

private theorem tailPushforwardIntegerSheafModelToSkyscraperPair_naturality {i j : ℕ}
    (h : i ⟶ j) :
    tailPushforwardIntegerSheafModelMap h.down.down ≫
      tailPushforwardIntegerSheafModelToSkyscraperPair j =
      tailPushforwardIntegerSheafModelToSkyscraperPair i := by
  sorry

private noncomputable def tailPushforwardColimitComparisonCocone :
    Cocone tailPushforwardIntegerSheafFunctor where
  pt := twoClosedPointsSkyscraperPairSheaf
  ι :=
    { app := fun n ↦
        tailPushforwardIntegerSheafToModel n ≫
          tailPushforwardIntegerSheafModelToSkyscraperPair n
      naturality := by
        intro i j h
        sorry }

/-- The canonical comparison map from `\mathcal{F} = \operatorname{colim}_n j_{n,*}\underline{Z}`
to the skyscraper-pair sheaf of Example 6.29.2. -/
noncomputable def tailPushforwardColimitComparison :
    tailPushforwardIntegerSheafColimit ⟶ twoClosedPointsSkyscraperPairSheaf :=
  colimit.desc _ tailPushforwardColimitComparisonCocone

-- Proof sketch: compute the stalks of `j_{n,*}\underline{Z}` at the points `xi_m`, `s1`, and `s2`,
-- identify the colimit stalkwise, and then use the skyscraper-sheaf description from Section 6.27
-- to recognize the resulting sheaf as the direct sum of the two skyscraper sheaves with value `M`.
private theorem tailPushforwardColimitComparison_isIso :
