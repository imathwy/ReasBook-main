universe u v w x y

/-
Domain-style sampling for Lemma 15.8.1:
- primary domain: determinantal ideals of matrices over a commutative ring and their basic
  functoriality/block-decomposition properties;
- sampled downstream owner-level declarations:
  `presentationFittingIdeal`,
  `LinearMap.rankMinorIdeal`,
  `exists_mul_eq_smul_one_of_mem_minorIdeal`,
  `pow_mem_minorIdeal_of_exists_mul_eq_smul_one`;
- best owner abstraction: the matrix-level owner `Matrix.minorIdeal`; the Fitting-ideal and
  linear-map constructions in later files are derived API built from this owner rather than
  separate competing notions, while the Lean surface notation `I_(r)(A)` records the textbook
  determinantal ideal `I_r(A)`;
- primitive data: a size `r` and a matrix `A`;
- derived API: membership of a chosen minor, antitonicity in `r`, behavior under restricting rows,
  left multiplication, and block-diagonal decomposition.

Source/core/bridge triage:
- `source-facing`: the textbook determinantal ideal of the `r × r` minors of a matrix;
- `core/canonical`: `Matrix.minorIdeal`;
- `bridge/view`: the later presentation/Fitting-ideal and linear-map specializations. -/

section

variable {R : Type u} [CommRing R]

namespace Matrix

/-- The ideal generated by the `r × r` minors of a matrix. This realizes the conventions
`I_0(A) = R` and `I_r(A) = 0` when `r` exceeds the number of available rows or columns. We use
the Lean notation `I_(r)(A)` for this ideal. -/
def minorIdeal {ι : Type v} {κ : Type w} (r : ℕ) (A : Matrix ι κ R) : Ideal R :=
  Ideal.span <| Set.range fun p : (Fin r ↪ ι) × (Fin r ↪ κ) ↦
    (A.submatrix p.1 p.2).det

notation:max "I_(" r:max ")(" A:arg ")" => minorIdeal r A

/-- Every `r × r` minor of `A` belongs to the ideal generated by all `r × r` minors of `A`. -/
-- Proof sketch: unfold `I_(r)(A)` and use the defining inclusion of each generator into
-- `Ideal.span`.
theorem det_submatrix_mem_minorIdeal {ι : Type v} {κ : Type w}
    (r : ℕ) (A : Matrix ι κ R) (e₁ : Fin r ↪ ι) (e₂ : Fin r ↪ κ) :
    (A.submatrix e₁ e₂).det ∈ I_(r)(A) := sorry

/-- Lemma 15.8.1: for a fixed matrix `A`, the ideals generated by its minors form a descending
chain as the minor size increases. -/
-- Proof sketch: expand an `(r + 1) × (r + 1)` determinant along a row or column. Each resulting
-- term is an entry times an `r × r` minor, so every generator of `I_(r + 1)(A)` lies in
-- `I_(r)(A)`.
theorem minorIdeal_antitone {ι : Type v} {κ : Type w}
    (A : Matrix ι κ R) : Antitone (fun r ↦ I_(r)(A)) := sorry

/-- Passing from a matrix to its first rows can only increase the corresponding minor ideals after
adjusting the minor size by the number of deleted rows. -/
-- Proof sketch: any `(r + n') × (r + n')` minor of `B` must use at least `r` rows from the first
-- `n` rows. Expanding the determinant along the remaining rows expresses that minor in the ideal
-- generated by `I_(r)(B.submatrix (Fin.castAdd n') id)`.
theorem minorIdeal_initialRows_le {n n' m : ℕ} (r : ℕ)
    (B : Matrix (Fin (n + n')) (Fin m) R) :
    I_((r + n'))(B) ≤ I_(r)((B.submatrix (Fin.castAdd n') id)) := sorry

/-- Left multiplication by a square matrix does not enlarge the ideal generated by fixed-size
minors. -/
-- Proof sketch: apply Cauchy-Binet to each `r × r` minor of `C * A`. It becomes an `R`-linear
-- combination of `r × r` minors of `A`, hence belongs to `I_(r)(A)`.
theorem minorIdeal_mul_left_le {ι : Type v} {κ : Type w} [Fintype ι]
    (r : ℕ) (C : Matrix ι ι R) (A : Matrix ι κ R) :
    I_(r)((C * A)) ≤ I_(r)(A) := sorry

/-- For a block diagonal matrix, the ideal of `r × r` minors is the sum of products of the minor
ideals of the diagonal blocks over all decompositions `r = r₁ + r₂`. -/
-- Proof sketch: a nonzero minor of a block diagonal matrix must choose `r₁` rows and columns in
-- the first block and `r₂` rows and columns in the second block. The determinant then factors as
-- the product of the corresponding block minors, and summing over `Finset.antidiagonal r` gives
-- the full ideal `I_(r)(fromBlocks A₁ 0 0 A₂)`.
theorem minorIdeal_fromBlocks {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x} {κ₂ : Type y}
    (r : ℕ) (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R) :
    I_(r)((fromBlocks A₁ 0 0 A₂)) =
      Finset.sum (Finset.antidiagonal r) fun p ↦ I_((p.1))(A₁) * I_((p.2))(A₂) := sorry

end Matrix

end
