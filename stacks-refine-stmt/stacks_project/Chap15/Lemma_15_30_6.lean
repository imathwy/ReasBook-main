import Mathlib
import stacks_project.Chap10.Definition_10_69_1
import stacks_project.Chap15.Definition_15_30_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R]
variable {M : Type u} [AddCommGroup M] [Module R M]

/- Domain triage:
* primary domain: module-valued `H₁`-regularity and quasi-regularity for finite families in
  commutative algebra;
* sampled owner declarations: `IsH1RegularOn`, `IsQuasiRegular`,
  `IsRegular.isQuasiRegular`, and `IsH1RegularOn.of_flat_of_isBaseChange`;
* best owner abstraction: `IsH1RegularOn` is the source-facing owner on the hypothesis side, while
  `IsQuasiRegular` is the Chapter 10 owner for the associated-graded criterion;
* primitive data vs derived API: the primitive data is just the finite family `f`; the
  quasi-regularity conclusion is derived bridge data and should therefore be exposed as an
  owner-style theorem under `IsH1RegularOn`, not as a parallel freestanding wrapper.
-/

-- Proof sketch: identify quasi-regularity with the graded coefficient criterion for
-- `quasiRegularSequenceAssociatedGradedMap M (List.ofFn f)`. The `H₁`-regularity hypothesis
-- forces the degree-one Koszul relations to be generated by the trivial ones, and the argument in
-- the Stacks proof uses Lemmas `15.30.4`, `15.30.5`, and `15.28.4` to induct on the total degree
-- of a homogeneous relation and conclude that every coefficient lies in the ideal generated by
-- `f`, yielding bijectivity of the associated-graded map.
namespace IsH1RegularOn

/-- Lemma 15.30.6, owner form: if a finite family `f` is `M`-`H_1`-regular, then the associated
finite sequence `List.ofFn f` is `M`-quasi-regular. -/
theorem isQuasiRegular {r : ℕ} {f : Fin r → R} (hH1 : IsH1RegularOn M f) :
    IsQuasiRegular M (List.ofFn f) := sorry

end IsH1RegularOn

end RingTheory.Sequence
