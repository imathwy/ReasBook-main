universe w₂ w₁ v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] {U : C}

/- Domain-style sampling for Definition 7.8.2:
- primary domain: fixed-target families of arrows, viewed as objects of
  `SemiRepresentableFamily.Over U`, together with the presieves and sieves they generate;
- sampled owner declarations:
  `SemiRepresentableFamily.Over` from `Definition_7_8_1`,
  `Presieve.ofArrows_comp_eq_of_surjective`,
  `Sieve.ofArrows`,
  `CategoryTheory.Sites.Descent.DescentData.exists_equivalence_of_sieve_eq`;
- best owner abstraction: the source-facing owner remains `SemiRepresentableFamily.Over U`;
  `toPresieve` and `toSieve` are bridge/view API from that owner to the canonical mathlib presieve
  and sieve constructions on indexed arrow families;
- primitive data: a fixed-target family `𝒰 : Over U`;
- derived API: the generated presieve/sieve and the equivalence relations defined in terms of those
  canonical generated objects.

Source/core/bridge triage:
- `source-facing`: `CombinatoriallyEquivalent`, `TautologicallyEquivalent`;
- `core/canonical`: `SemiRepresentableFamily.Over U`;
- `bridge/view`: `toPresieve`, `toSieve`.
-/

namespace SemiRepresentableFamily

namespace Over

/-- The canonical presieve on `U` generated by a fixed-target family. -/
abbrev toPresieve (𝒰 : Over U) : Presieve U :=
  Presieve.ofArrows (fun i ↦ (𝒰.obj i).left) fun i ↦ (𝒰.obj i).hom

@[simp] theorem toPresieve_ofArrows {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    (ofArrows Uᵢ π).toPresieve = Presieve.ofArrows Uᵢ π :=
  rfl

@[simp] theorem toPresieve_ofArrows_ulift {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    (ofArrows (fun i : ULift.{w₂} I ↦ Uᵢ i.down) fun i ↦ π i.down).toPresieve =
      Presieve.ofArrows Uᵢ π := by
  simpa [toPresieve] using
    (Presieve.ofArrows_comp_eq_of_surjective π ULift.down_surjective)

/-- The canonical sieve on `U` generated by a fixed-target family. -/
abbrev toSieve (𝒰 : Over U) : Sieve U :=
  Sieve.generate 𝒰.toPresieve

@[simp] theorem toSieve_ofArrows {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    (ofArrows Uᵢ π).toSieve = Sieve.ofArrows Uᵢ π :=
  rfl

@[simp] theorem toSieve_ofArrows_ulift {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    (ofArrows (fun i : ULift.{w₂} I ↦ Uᵢ i.down) fun i ↦ π i.down).toSieve =
      Sieve.ofArrows Uᵢ π := by
  simpa [toSieve, Sieve.ofArrows] using congrArg Sieve.generate (toPresieve_ofArrows_ulift Uᵢ π)

/-- A fixed-target family is covering for a precoverage precisely when the presieve it generates as
an indexed family belongs to that precoverage. This applies in particular to pretopologies. -/
abbrev IsCovering (K : Precoverage C) (𝒰 : Over U) : Prop :=
  𝒰.toPresieve ∈ K U

/-- Definition 7.8.2 (1): in canonical form, two families of morphisms with fixed target `U` are
combinatorially equivalent when they determine the same presieve on `U`, equivalently when each
member of either family is literally one of the members of the other family after a reindexing. -/
def CombinatoriallyEquivalent
    (𝒰 𝒱 : Over U) : Prop :=
  𝒰.toPresieve = 𝒱.toPresieve

/-- Definition 7.8.2 (2): two families of morphisms with fixed target `U` are tautologically
equivalent if they admit reindexings in both directions whose component maps are isomorphisms in
the slice category `C / U`. -/
def TautologicallyEquivalent
    (𝒰 𝒱 : Over U) : Prop :=
  ∃ f : 𝒰 ⟶ 𝒱, ∃ g : 𝒱 ⟶ 𝒰,
    (∀ i : 𝒰.index, IsIso (f.f i)) ∧ ∀ j : 𝒱.index, IsIso (g.f j)

private theorem over_obj_eq_of_left_eq_hom
    {A B : CategoryTheory.Over U}
    (hleft : B.left = A.left)
    (hhom : A.hom = eqToHom hleft.symm ≫ B.hom) :
    A = B := by
  simpa using
    (CostructuredArrow.obj_ext A B hleft.symm hhom.symm)

private theorem over_hom_eq_eqToHom_comp_hom
    {A B : CategoryTheory.Over U} (h : A = B) :
    A.hom = eqToHom (congrArg (fun X : CategoryTheory.Over U ↦ X.left) h) ≫ B.hom := by
  cases h
  simp

/-- Companion source-facing formulation of combinatorial equivalence: two fixed-target families are
combinatorially equivalent exactly when each is obtained from the other by reindexing its members
without changing the corresponding objects of the slice category. -/
theorem combinatoriallyEquivalent_iff_exists_reindexings
    {𝒰 𝒱 : Over U} :
    CombinatoriallyEquivalent 𝒰 𝒱 ↔
      ∃ α : 𝒰.index → 𝒱.index, ∃ β : 𝒱.index → 𝒰.index,
        (∀ i : 𝒰.index, 𝒰.obj i = 𝒱.obj (α i)) ∧
          ∀ j : 𝒱.index, 𝒱.obj j = 𝒰.obj (β j) := by
  constructor
  · intro h
    have hα :
        ∀ i : 𝒰.index, ∃ j : 𝒱.index, 𝒰.obj i = 𝒱.obj j := by
      intro i
      have hi₀ : 𝒰.toPresieve ((𝒰.obj i).hom) := Presieve.ofArrows.mk i
      let hi : 𝒱.toPresieve ((𝒰.obj i).hom) := by
        exact h.le _ _ hi₀
      refine ⟨hi.idx, ?_⟩
      exact over_obj_eq_of_left_eq_hom hi.obj_idx (hi.eq_eqToHom_comp_hom_idx)
    have hβ :
        ∀ j : 𝒱.index, ∃ i : 𝒰.index, 𝒱.obj j = 𝒰.obj i := by
      intro j
      have hj₀ : 𝒱.toPresieve ((𝒱.obj j).hom) := Presieve.ofArrows.mk j
      let hj : 𝒰.toPresieve ((𝒱.obj j).hom) := by
        exact h.ge _ _ hj₀
      refine ⟨hj.idx, ?_⟩
      exact over_obj_eq_of_left_eq_hom hj.obj_idx (hj.eq_eqToHom_comp_hom_idx)
    choose α hα using hα
    choose β hβ using hβ
    exact ⟨α, β, hα, hβ⟩
  · rintro ⟨α, β, hα, hβ⟩
    apply le_antisymm
    · rw [Presieve.ofArrows_le_iff]
      intro i
      refine Presieve.ofArrows.mk' (α i) ?_ ?_
      · exact congrArg (fun X : CategoryTheory.Over U ↦ X.left) (hα i)
      · simpa using over_hom_eq_eqToHom_comp_hom (hα i)
    · rw [Presieve.ofArrows_le_iff]
      intro j
      refine Presieve.ofArrows.mk' (β j) ?_ ?_
      · exact congrArg (fun X : CategoryTheory.Over U ↦ X.left) (hβ j)
      · simpa using over_hom_eq_eqToHom_comp_hom (hβ j)

/-- A presieve inclusion between fixed-target families yields a refinement whose components are
isomorphisms in the slice category. -/
private theorem exists_componentwiseIso_hom_of_toPresieve_le
    {𝒰 𝒱 : Over U} (h : 𝒰.toPresieve ≤ 𝒱.toPresieve) :
    ∃ f : 𝒰 ⟶ 𝒱, ∀ i : 𝒰.index, IsIso (f.f i) := by
  classical
  have hi :
      ∀ i : 𝒰.index,
        ∃ j : 𝒱.index,
          ∃ hobj : (𝒱.obj j).left = (𝒰.obj i).left,
            (𝒰.obj i).hom = eqToHom hobj.symm ≫ (𝒱.obj j).hom := by
    intro i
    exact Presieve.ofArrows_surj (fun j : 𝒱.index ↦ (𝒱.obj j).hom) ((𝒰.obj i).hom)
      (h _ _ (Presieve.ofArrows.mk i))
  choose α hαobj hαhom using hi
  refine ⟨
    { α := α
      f := fun i ↦
        (Over.isoMk
          (eqToIso (hαobj i).symm)
          (by simpa using (hαhom i).symm)).hom },
    ?_⟩
  intro i
  change IsIso
    ((Over.isoMk
      (eqToIso (hαobj i).symm)
      (by simpa using (hαhom i).symm)).hom)
  infer_instance

-- Proof sketch: a combinatorial equivalence is equality of the canonical presieves, so each
-- direction gives a refinement whose components are slice isomorphisms.
/-- Lemma 7.8.3 (1): combinatorially equivalent families of morphisms with fixed target are
tautologically equivalent. -/
theorem combinatoriallyEquivalent_implies_tautologicallyEquivalent
    {𝒰 𝒱 : Over U}
    (h : CombinatoriallyEquivalent 𝒰 𝒱) :
    TautologicallyEquivalent 𝒰 𝒱 := by
  rcases exists_componentwiseIso_hom_of_toPresieve_le h.le with ⟨f, hf⟩
  rcases exists_componentwiseIso_hom_of_toPresieve_le h.ge with ⟨g, hg⟩
  exact ⟨f, g, hf, hg⟩

/-- A morphism of fixed-target families induces inclusion of the generated sieves. -/
theorem toSieve_le_of_hom {𝒰 𝒱 : Over U} (φ : 𝒰 ⟶ 𝒱) :
    𝒰.toSieve ≤ 𝒱.toSieve := by
  rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  intro i
  exact ⟨_, (φ.f i).left, _, Presieve.ofArrows.mk (φ.α i), by simpa using Over.w (φ.f i)⟩

-- Proof sketch: a tautological equivalence supplies morphisms in both directions, and any
-- morphism of fixed-target families induces inclusion of the generated sieves.
/-- Tautologically equivalent fixed-target families generate the same sieve. -/
theorem toSieve_eq_of_tautologicallyEquivalent
    {𝒰 𝒱 : Over U} (h : TautologicallyEquivalent 𝒰 𝒱) :
    𝒰.toSieve = 𝒱.toSieve := by
  rcases h with ⟨f, g, -, -⟩
  exact le_antisymm (toSieve_le_of_hom f) (toSieve_le_of_hom g)

end Over
end SemiRepresentableFamily

end CategoryTheory
