import Mathlib
import stacks_project.Chap10.Example_10_28_6

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open MvPolynomial

universe u v

section

variable {R : Type u} [CommRing R]

/- The primary owner abstraction here is `Ideal.IsOka`; Remark 10.28.13 uses the chapter
specialization `Ideal.isOka_spanRank_le` for the predicate `I.spanRank ≤ κ` with `κ` infinite. -/
recall Ideal.isOka_spanRank_le
recall Ideal.IsOka.isPrime_of_maximal_not

end

/-- The variables used in the explicit quotient-ring model from Remark 10.28.13. -/
private inductive Remark102813Var (T : Type v)
  | x : ℕ → Remark102813Var T
  | z : T → ℕ → Remark102813Var T

section

variable (k : Type u) [Field k] (T : Type v)

/-- The polynomial variable corresponding to `x_(n + 1)` in the model of Remark 10.28.13. -/
private noncomputable def remark102813X (n : ℕ) : MvPolynomial (Remark102813Var T) k :=
  X (Remark102813Var.x n)

/-- The polynomial variable `z_{t,n}` in the model of Remark 10.28.13. -/
private noncomputable def remark102813Z (t : T) (n : ℕ) : MvPolynomial (Remark102813Var T) k :=
  X (Remark102813Var.z t n)

/-- The defining relations used in the explicit quotient-ring example of Remark 10.28.13. -/
private noncomputable def remark102813Relations : Set (MvPolynomial (Remark102813Var T) k) :=
  Set.range (fun n : ℕ ↦ remark102813X k T n ^ 2) ∪
    Set.range (fun p : T × ℕ ↦ remark102813Z k T p.1 p.2 ^ 2) ∪
      Set.range
        (fun p : T × ℕ ↦
          remark102813X k T (p.2 + 1) *
              remark102813Z k T p.1 (p.2 + 1) -
            remark102813Z k T p.1 p.2)

/-- The ideal of defining relations for the quotient ring in Remark 10.28.13. -/
private noncomputable def remark102813RelationsIdeal : Ideal (MvPolynomial (Remark102813Var T) k) :=
  Ideal.span (remark102813Relations k T)

/-- The explicit quotient ring used in Remark 10.28.13. -/
noncomputable def remark102813Ring : Type (max u v) :=
  MvPolynomial (Remark102813Var T) k ⧸ remark102813RelationsIdeal k T

instance : CommRing (remark102813Ring k T) :=
  inferInstanceAs
    (CommRing (MvPolynomial (Remark102813Var T) k ⧸ remark102813RelationsIdeal k T))

/-- The ideal `(x_n)` inside the quotient ring from Remark 10.28.13. -/
noncomputable def remark102813MaximalIdeal : Ideal (remark102813Ring k T) :=
  Ideal.span <|
    Set.range fun n : ℕ ↦
      Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n)

/-- The ideal `(z_{t,n})` inside the quotient ring from Remark 10.28.13. -/
noncomputable def remark102813BadIdeal : Ideal (remark102813Ring k T) :=
  Ideal.span <|
    Set.range fun p : T × ℕ ↦
      Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813Z k T p.1 p.2)

/-- The explicit ring of Remark 10.28.13 is local with maximal ideal generated by the images of
the variables `x_n`. -/
-- Proof sketch: show every quotient element with nonzero constant term is a unit, so the ideal
-- generated by the images of the `x_n` is the unique maximal ideal.
instance remark102813_ring_isLocal :
    IsLocalRing (remark102813Ring k T) := sorry

/-- An ideal of the explicit ring in Remark 10.28.13 is prime exactly when it is `(x_n)`. -/
-- Proof sketch: the relations force any prime ideal to contain each `x_n²` and `z_{t,n}²`, hence
-- every `x_n` and `z_{t,n}`. The recursive relation then identifies the resulting prime ideal with
-- the ideal generated by the images of the `x_n`.
lemma remark102813_unique_prime
    (P : Ideal (remark102813Ring k T)) :
    P.IsPrime ↔ P = remark102813MaximalIdeal k T := sorry

/-- The unique prime ideal `(x_n)` in Remark 10.28.13 has span rank at most `ℵ₀`. -/
-- Proof sketch: the generators are exactly the countable family indexed by `ℕ`, so this ideal is
-- the span of a countable set.
lemma remark102813_maximalIdeal_spanRank_le_aleph0 :
    (remark102813MaximalIdeal k T).spanRank ≤ Cardinal.aleph0 := sorry

/-- If `T` is uncountable, then the ideal `(z_{t,n})` in Remark 10.28.13 does not have span rank at
most `ℵ₀`. -/
-- Proof sketch: the relations force every countable generating family to involve only countably
-- many indices `t`, while the ideal contains generators `z_{t,0}` for uncountably many `t`.
lemma remark102813_badIdeal_not_spanRank_le_aleph0 [Uncountable T] :
    ¬ (remark102813BadIdeal k T).spanRank ≤ Cardinal.aleph0 := sorry

/-- Remark 10.28.13: the explicit quotient ring
`k[{x_n}_{n ≥ 1}, {z_{t,n}}_{t ∈ T, n ≥ 0}] / (x_n^2, z_{t,n}^2, x_{n+1} z_{t,n+1} - z_{t,n})`
shows that all prime ideals have span rank at most `ℵ₀` while some ideal does not. This is the
canonical formulation of the countable-generation assertion. -/
-- Proof sketch: the only prime ideal is `(x_n)`, so every prime ideal has span rank at most `ℵ₀`
-- by the previous lemma. The ideal `(z_{t,n})` does not when `T` is uncountable.
theorem prime_ideals_spanRank_le_aleph0_but_some_ideal_is_not [Uncountable T] :
    (∀ P : Ideal (remark102813Ring k T), P.IsPrime → P.spanRank ≤ Cardinal.aleph0) ∧
      ∃ I : Ideal (remark102813Ring k T), ¬ I.spanRank ≤ Cardinal.aleph0 := sorry

end
