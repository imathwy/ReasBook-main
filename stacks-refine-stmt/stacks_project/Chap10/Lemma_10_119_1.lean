import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

section

variable {R : Type u} {K : Type v}
variable [CommRing R] [IsDomain R] [IsLocalRing R] [IsNoetherianRing R]
variable [Field K] [Algebra R K] [IsFractionRing R K]

/-
Domain triage:
* primary domain: local overrings of a Noetherian local domain inside its fraction field;
* sampled owner API:
  - `LocalSubring.exists_le_valuationSubring` for dominating local overrings of a field;
  - `RingHom.EssFiniteType` / `Algebra.EssFiniteType` for the essentially finite type condition;
  - `ringKrullDim` for the Krull-dimension owner recalled in Definition `10.60.2`.
* best owner abstractions:
  - `source-facing`: the existence of an intermediate `R`-subalgebra of `K`;
  - `core/canonical`: domination is expressed through the local-map owner
    `IsLocalHom (algebraMap R A)` together with `IsLocalRing A`, and finite-type data belongs to
    `Algebra.EssFiniteType R A`.
* primitive vs. derived:
  - the primitive conclusion data are the intermediate subalgebra `A`, its local structure, the
    locality of `R → A`, the dimension statement, and essential finite type over `R`;
  - Noetherianity of `A` is derived from `Algebra.EssFiniteType R A` and the ambient
    `[IsNoetherianRing R]`, so it should not be stored as separate primitive output data.
-/

-- Proof sketch: choose a valuation overring of `R` in `K` dominating `R` via
-- `LocalSubring.exists_le_valuationSubring`. Let `x₁, …, x_r` be a minimal generating set of the
-- maximal ideal, form the finitely generated `R`-subalgebra generated by the quotients `xᵢ / x_r`,
-- and localize at a minimal prime over the principal ideal generated by `x_r`. Krull's principal
-- ideal theorem gives Krull dimension `1`, the localization is local Noetherian, and the map from
-- `R` remains local and essentially of finite type.
/-- Lemma 10.119.1: if `R` is a local Noetherian domain with fraction field `K` and `R` is not a
field, then there exists an intermediate `R`-subalgebra `A ⊆ K` such that `A` is local, has
Krull dimension `1`, the map `R → A` is local, and `A` is essentially of finite type over `R`.
Since `R` is Noetherian, the last condition canonically implies that `A` is Noetherian as well. -/
theorem exists_one_dimensional_dominating_essFiniteType_overring_of_not_isField
    (hR : ¬ IsField R) :
    ∃ A : Subalgebra R K,
      ringKrullDim A = 1 ∧
        IsLocalRing A ∧
        IsLocalHom (algebraMap R A) ∧
        Algebra.EssFiniteType R A := sorry

end
