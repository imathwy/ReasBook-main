import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open MvPolynomial

universe u

section

variable {A : Type u} [CommRing A]
variable {k : Type u} [Field k]
variable {n : ℕ}

/-- The coordinate ideal generated by the variables `X i` with `r ≤ i.1`, corresponding to the
textbook ideal `(y_{r + 1}, \ldots, y_n)` in `k[y_1, \ldots, y_n]`. -/
noncomputable def tailVariablesIdeal (A : Type u) [CommRing A] (n r : ℕ) :
    Ideal (MvPolynomial (Fin n) A) :=
  Ideal.span {f | ∃ i : Fin n, r ≤ i.1 ∧ f = (X i : MvPolynomial (Fin n) A)}

-- Proof sketch: unfold `tailVariablesIdeal`; the statement is exactly its defining equation.
/-- Unfolding `tailVariablesIdeal` identifies it with the span of the tail coordinate variables. -/
theorem tailVariablesIdeal_def (A : Type u) [CommRing A] (n r : ℕ) :
    tailVariablesIdeal A n r =
      Ideal.span {f | ∃ i : Fin n, r ≤ i.1 ∧ f = (X i : MvPolynomial (Fin n) A)} :=
  rfl

-- Proof sketch: argue by induction on the number of variables. If the residue-field
-- transcendence degree already equals `n`, then the prime is zero. Otherwise choose a nonconstant
-- polynomial in `q`, use Lemma `10.115.2` to shear it so that it becomes monic in the last
-- variable, obtain a finite map by sending the last source variable to that monic polynomial, and
-- then apply the induction hypothesis to the contracted prime in the first `n - 1` variables.
/-- Lemma 10.115.6: if `q` is a prime ideal of `k[x_1, \ldots, x_n]` and
`r = Cardinal.toNat (Algebra.trdeg k q.ResidueField)`, then there exists a finite `k`-algebra map
from another `n`-variable polynomial ring to `k[x_1, \ldots, x_n]` whose contraction of `q` is
the coordinate ideal `(y_{r + 1}, \ldots, y_n)`. -/
theorem exists_finite_selfAlgHom_comap_eq_tailVariablesIdeal
    (q : Ideal (MvPolynomial (Fin n) k)) [q.IsPrime] :
    ∃ φ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k,
      φ.Finite ∧
        Ideal.comap φ q =
          tailVariablesIdeal k n (Cardinal.toNat (Algebra.trdeg k q.ResidueField)) := sorry

end
