import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Ideal IsLocalRing

section

variable {A : Type u} [CommRing A]

-- Proof sketch: combine the existing DVR TFAE in mathlib with the chapter's bridge results:
-- DVRs are regular local rings of dimension `1`, a regular local ring of dimension `1` has
-- principal maximal ideal, valuation rings are integrally closed, and a one-dimensional
-- Noetherian local normal domain has principal maximal ideal by the finite birational extension
-- argument from the text.
/-- Lemma 10.119.7: for a commutative ring `A`, the following are equivalent: `A` is a discrete
valuation ring; `A` is a valuation ring that is Noetherian but not a field; `A` is a regular local
ring of dimension `1`; `A` is a Noetherian local domain whose maximal ideal is generated by a
single nonzero element; `A` is a Noetherian local normal domain of dimension `1`. -/
theorem discreteValuationRing_tfae :
    List.TFAE
      [ (∃ (_ : IsDomain A), IsDiscreteValuationRing A),
        ∃ (_ : IsDomain A) (_ : IsNoetherianRing A), ValuationRing A ∧ ¬ IsField A,
        IsRegularLocalRing A ∧ ringKrullDim A = 1,
        ∃ (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : IsDomain A),
          maximalIdeal A ≠ ⊥ ∧ (maximalIdeal A).IsPrincipal,
        ∃ (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : IsDomain A)
          (_ : IsIntegrallyClosed A), ringKrullDim A = 1 ] := sorry

/-- Companion bridge for Lemma 10.119.7: the source-facing statement that `A` is a discrete
valuation ring is equivalent to the canonical regular-local owner together with the dimension-one
conclusion. -/
theorem discreteValuationRing_iff_regularLocalRing_dim_one :
    (∃ (_ : IsDomain A), IsDiscreteValuationRing A) ↔
      IsRegularLocalRing A ∧ ringKrullDim A = 1 := by
  simpa using
    (show List.TFAE
        [ (∃ (_ : IsDomain A), IsDiscreteValuationRing A),
          ∃ (_ : IsDomain A) (_ : IsNoetherianRing A), ValuationRing A ∧ ¬ IsField A,
          IsRegularLocalRing A ∧ ringKrullDim A = 1,
          ∃ (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : IsDomain A),
            maximalIdeal A ≠ ⊥ ∧ (maximalIdeal A).IsPrincipal,
          ∃ (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : IsDomain A)
            (_ : IsIntegrallyClosed A), ringKrullDim A = 1 ] from
      discreteValuationRing_tfae).out 0 2

variable [IsDomain A] [IsDiscreteValuationRing A]

-- Proof sketch: identify `π` as a uniformizer from `hπ`, use the DVR valuation to define the
-- exponent of a nonzero element, and then show the residual factor is a unit; uniqueness follows
-- from comparing valuations of two expressions `u * π^n`.
/-- If `π` generates the maximal ideal of a discrete valuation ring, then every nonzero element has
a unique expression as a unit times a power of `π`. This is the normal form promised by the
textbook after the equivalent characterizations. -/
theorem existsUnique_unit_mul_pow_of_span_maximalIdeal (π a : A)
    (hπ : maximalIdeal A = Ideal.span {π}) (ha : a ≠ 0) :
    ∃! p : Aˣ × ℕ, a = (p.1 : A) * π ^ p.2 := sorry

end
