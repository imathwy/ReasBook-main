import Mathlib
import stacks_project.Chap10.Definition_10_69_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

open Ideal

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-
Domain triage:
* primary domain: quasi-regular sequences and the canonical quotient-by-prefix construction in
  commutative algebra;
* sampled owner API:
  `RingTheory.Sequence.IsQuasiRegular`,
  `RingTheory.Sequence.IsWeaklyRegular`,
  `RingTheory.Sequence.isWeaklyRegular_append_iff'`,
  `RingTheory.Sequence.IsWeaklyRegular.recIterModByRegularWithRing`;
* core/canonical owner abstraction: the successive quotient-by-prefix owner encoded by
  `IsWeaklyRegular` on the prefix-quotient module
  `M ⧸ (Ideal.ofList (rs.take i) • ⊤ : Submodule R M)` together with the image sequence in
  `R ⧸ Ideal.ofList (rs.take i)`;
* primitive vs derived split: the quotient module and quotient-ring images are canonical primitive
  data; the weakly-regular tail criterion lives in the owner API, while quasi-regularity of that
  tail quotient is the derived source-facing bridge statement proved here;
* layer: `bridge/view`, since the item transports the source-facing owner `IsQuasiRegular` across
  the canonical quotient-by-prefix construction already organizing the regular-sequence API.
-/

-- Proof sketch: reduce to the case of quotienting by one initial element and iterate. On the
-- graded module attached to the ideal generated by the remaining tail, the quasi-regularity
-- criterion identifies the associated graded of the quotient module with the quotient by the first
-- variable, so the tail relation remains homogeneous and forces its coefficients into the tail
-- ideal.
namespace IsQuasiRegular

/-- Lemma 10.69.5: if `rs` is an `M`-quasi-regular sequence, then after quotienting `R` by the
ideal generated by the first `i` terms and quotienting `M` by the corresponding submodule, the
remaining tail sequence is quasi-regular on the quotient module. -/
theorem tail_quotient {rs : List R} (hqr : IsQuasiRegular M rs) (i : ℕ) :
    IsQuasiRegular (M ⧸ (ofList (rs.take i) • (⊤ : Submodule R M)))
      ((rs.drop i).map (Ideal.Quotient.mk (ofList (rs.take i)))) := sorry

end IsQuasiRegular

end RingTheory.Sequence
