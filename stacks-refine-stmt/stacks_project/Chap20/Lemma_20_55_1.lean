noncomputable section

namespace AlgebraicGeometry.RingedSpace

variable {X : RingedSpace}
variable {ℐ : (RingedSpace.Modules X)}

/- Domain-style sampling for Lemma 20.55.1:
- primary domain: ideal sheaf inclusions in the category of `\mathcal O_X`-modules on a ringed
  space;
- inspected owner declarations:
  `satisfies_locally_principal_regular_ideal_condition`,
  `SheafOfModules.IsFiniteLocallyFreeOfRank`,
  `SheafOfModules.RingedSite.IsInvertible`,
  `SheafOfModules.RingedSite.unit_isInvertible`,
  `SheafOfModules.RingedSite.isFiniteLocallyFree_of_isFiniteLocallyFreeOfRank`,
  `locally_principal_regular_ideal_situation`,
- best owner abstraction: the source-facing local-condition owner
  `satisfies_locally_principal_regular_ideal_condition`, with the canonical downstream owners
  `SheafOfModules.IsFiniteLocallyFreeOfRank` and `SheafOfModules.RingedSite.IsInvertible`;
- primitive data: an inclusion `ι : ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X)`;
- derived API: the source-facing theorem below and the canonical instance bridges to rank-one
  local freeness and invertibility.

Layer triage:
- `source-facing`: the local principal regular ideal condition on an ideal sheaf inclusion;
- `core/canonical`: `SheafOfModules.IsFiniteLocallyFreeOfRank` and
  `SheafOfModules.RingedSite.IsInvertible`;
- `bridge/view`: the source-facing theorem below together with the instance bridges from
  `locally_principal_regular_ideal_situation` to those canonical owners, without introducing a
  parallel invertibility or local-freeness wrapper. -/

-- Proof sketch: on each neighbourhood supplied by
-- `satisfies_locally_principal_regular_ideal_condition`, the
-- restricted ideal sheaf is isomorphic to the structure sheaf, hence to the free rank-one module
-- sheaf. These local trivializations are exactly the data required for
-- `IsFiniteLocallyFreeOfRank 1`.
/-- A locally principal ideal sheaf generated by a regular local section is finite locally free of
rank `1`. -/
theorem isFiniteLocallyFreeOfRank_one_of_isLocallyPrincipalRegularIdeal
    (ι : ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X))
    (hprincipal : satisfies_locally_principal_regular_ideal_condition ι) :
    SheafOfModules.IsFiniteLocallyFreeOfRank 1 ℐ := sorry

/-- Instance bridge: Situation `20.55.2` makes the ideal sheaf finite locally free of rank `1`. -/
instance instIsFiniteLocallyFreeOfRankOneOfLocallyPrincipalRegularIdealSituation
    (ι : outParam (ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X)))
    [hι : locally_principal_regular_ideal_situation ℐ ι] :
    SheafOfModules.IsFiniteLocallyFreeOfRank 1 ℐ :=
  isFiniteLocallyFreeOfRank_one_of_isLocallyPrincipalRegularIdeal ι hι.condition

variable [MonoidalCategory (RingedSpace.Modules X)]

-- Proof sketch: first apply
-- `isFiniteLocallyFreeOfRank_one_of_isLocallyPrincipalRegularIdeal` to obtain local rank-one
-- freeness, then invoke Lemma `17.25.4 (1)` to conclude that the ideal sheaf is invertible as an
-- `\mathcal O_X`-module.
/-- Lemma 20.55.1 (1): if an ideal sheaf is locally generated by one section whose multiplication
map on the local structure sheaf is injective, then it is invertible as an
`\mathcal O_X`-module. -/
theorem isInvertible_of_isLocallyPrincipalRegularIdeal
    (ι : ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X))
    (hprincipal : satisfies_locally_principal_regular_ideal_condition ι) :
    IsInvertible ℐ := sorry

/-- Instance bridge: Situation `20.55.2` makes the ideal sheaf invertible. -/
instance instIsInvertibleOfLocallyPrincipalRegularIdealSituation
    (ι : outParam (ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X)))
    [hι : locally_principal_regular_ideal_situation ℐ ι] :
    IsInvertible ℐ :=
  isInvertible_of_isLocallyPrincipalRegularIdeal ι hι.condition

-- Proof sketch: by Lemma `17.25.4 (2)`, an invertible ideal sheaf on a ringed space with local
-- stalk rings is finite locally free of rank `1`. After shrinking around any point, choose a
-- rank-one trivialization of the ideal sheaf; transporting the inclusion into the structure sheaf
-- across this trivialization identifies it with multiplication by a local section. The monomorphism
-- hypothesis on the ideal inclusion makes that section regular, giving the stated local principal
-- description.
/-- Lemma 20.55.1 (2): if all stalks `\mathcal O_{X, x}` are local rings, then every invertible
ideal sheaf of `\mathcal O_X` is locally principal and generated by a regular section. -/
theorem isLocallyPrincipalRegularIdeal_of_isInvertible_of_stalk_isLocalRing
    (ι : ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X))
    [Mono ι] (hlocal : ∀ x : X, IsLocalRing (X.presheaf.stalk x)) [IsInvertible ℐ] :
    satisfies_locally_principal_regular_ideal_condition ι := sorry

end AlgebraicGeometry.RingedSpace
