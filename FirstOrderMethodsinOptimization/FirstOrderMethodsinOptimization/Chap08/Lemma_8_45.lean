import Mathlib
import FirstOrderMethodsinOptimization.Chap08.Assumption_8_41
import FirstOrderMethodsinOptimization.Chap08.Algorithm_8_14
import FirstOrderMethodsinOptimization.Chap08.Definition_8_21
import FirstOrderMethodsinOptimization.Chap08.Definition_8_22

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open WithLp (toLp)
open scoped BigOperators

section

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable {m : ℕ}

local notation "Λ" => EuclideanSpace ℝ (Fin m)

/-- The nonnegative multiplier function `λ : Fin m → ℝ≥0` viewed as the corresponding Euclidean
multiplier vector in `ℝ^m`. -/
def dual_projected_subgradient_multiplier_vector (lam : Fin m → NNReal) : Λ :=
  toLp 2 (fun i ↦ (lam i : ℝ))

-- Proof sketch: unfold `dual_projected_subgradient_multiplier_vector`; the `i`-th coordinate is
-- definitionally the real coercion of the `i`-th nonnegative multiplier coordinate.
/-- Evaluating `dual_projected_subgradient_multiplier_vector lam` at `i` returns the real value of
the `i`-th multiplier coordinate. -/
@[simp] theorem dual_projected_subgradient_multiplier_vector_apply
    (lam : Fin m → NNReal) (i : Fin m) :
    dual_projected_subgradient_multiplier_vector lam i = (lam i : ℝ) := sorry

section

variable {X XStar : Set E} {f : E → ℝ} {g : Fin m → E → ℝ} {fOpt L ρ : ℝ}
variable (xSel : (Fin m → NNReal) → {x // x ∈ X}) (γ : ℕ → ℝ) (lam0 : Fin m → NNReal)

local notation "lamSeq" =>
  dual_projected_subgradient_method X g xSel γ lam0

local notation "xSeq" =>
  dual_projected_subgradient_primal_iterate X g xSel γ lam0

local notation "constraintSeq" =>
  fun n ↦ dual_projected_subgradient_constraint_vector g (xSeq n : E)

local notation "lamVecSeq" =>
  fun n ↦ dual_projected_subgradient_multiplier_vector (lamSeq n)

local notation "fullAvg" =>
  full_averaging_sequence (fun n ↦ (xSeq n : E)) γ constraintSeq

local notation "partialAvg" =>
  partial_averaging_sequence (fun n ↦ (xSeq n : E)) γ constraintSeq

/- Lemma 8.45 is `source-facing`: it gives the primal-dual gap estimates for the two averaged
primal sequences attached to the dual projected subgradient method. Domain sampling against the
nearby Chapter 8 owners shows that the canonical public surface is the generated multiplier and
primal iterate sequences from `dual_projected_subgradient_method` and the two previously defined
averaging operators `full_averaging_sequence` and `partial_averaging_sequence`. The only new local
bridge is the Euclidean multiplier-vector coercion needed to state the norm term `‖λ^k‖₂`. -/

-- Proof sketch: apply the one-step multiplier recursion to obtain the telescoping estimate
-- (8.72), convert it to the averaged inequality (8.74) using the uniform bound
-- `‖g(x)‖ ≤ L`, combine this with optimality of each selected primal minimizer and Jensen's
-- inequality, and finally choose `λ̄` to be the norm-`ρ` positive-part direction of the averaged
-- constraint vector. The specializations `p = 0` and `p = k / 2` give the two displayed bounds.
/-- Lemma 8.45: under Assumption 8.41, if the constraint vectors satisfy `‖g(x)‖₂ ≤ L` on `X`,
then for every `k ≥ 2` the full-history averaged iterate and the suffix-window averaged iterate
generated by the dual projected subgradient method satisfy the primal-dual gap bounds (8.70) and
(8.71). -/
theorem dual_projected_subgradient_full_and_partial_average_gap_le
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    (hρ : 0 < ρ) {k : ℕ} (hk : 2 ≤ k) :
    (f (fullAvg k) - fOpt +
        ρ * ‖dual_projected_subgradient_constraint_vector g (fullAvg k)‖ ≤
      (L / 2) *
        ((‖dual_projected_subgradient_multiplier_vector lam0‖ + ρ) ^ (2 : ℕ) +
            Finset.sum (Finset.range (k + 1)) fun n ↦ (γ n) ^ (2 : ℕ)) /
          Finset.sum (Finset.range (k + 1)) γ) ∧
      (f (partialAvg k) - fOpt +
          ρ * ‖dual_projected_subgradient_constraint_vector g (partialAvg k)‖ ≤
        (L / 2) *
          ((‖lamVecSeq (k / 2)‖ + ρ) ^ (2 : ℕ) +
              Finset.sum (Finset.Icc (k / 2) k) fun n ↦ (γ n) ^ (2 : ℕ)) /
            Finset.sum (Finset.Icc (k / 2) k) γ) := sorry

-- Proof sketch: extract the first conjunct from
-- `dual_projected_subgradient_full_and_partial_average_gap_le`.
/-- The full-history averaged primal iterate satisfies the bound (8.70). -/
theorem dual_projected_subgradient_full_average_gap_le
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    (hρ : 0 < ρ) {k : ℕ} (hk : 2 ≤ k) :
    f (fullAvg k) - fOpt +
        ρ * ‖dual_projected_subgradient_constraint_vector g (fullAvg k)‖ ≤
      (L / 2) *
        ((‖dual_projected_subgradient_multiplier_vector lam0‖ + ρ) ^ (2 : ℕ) +
            Finset.sum (Finset.range (k + 1)) fun n ↦ (γ n) ^ (2 : ℕ)) /
          Finset.sum (Finset.range (k + 1)) γ := sorry

-- Proof sketch: extract the second conjunct from
-- `dual_projected_subgradient_full_and_partial_average_gap_le`.
/-- The suffix-window averaged primal iterate satisfies the bound (8.71). -/
theorem dual_projected_subgradient_partial_average_gap_le
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible : dual_projected_subgradient_method_is_admissible X f g xSel γ)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    (hρ : 0 < ρ) {k : ℕ} (hk : 2 ≤ k) :
    f (partialAvg k) - fOpt +
        ρ * ‖dual_projected_subgradient_constraint_vector g (partialAvg k)‖ ≤
      (L / 2) *
        ((‖lamVecSeq (k / 2)‖ + ρ) ^ (2 : ℕ) +
            Finset.sum (Finset.Icc (k / 2) k) fun n ↦ (γ n) ^ (2 : ℕ)) /
          Finset.sum (Finset.Icc (k / 2) k) γ := sorry

end

end
