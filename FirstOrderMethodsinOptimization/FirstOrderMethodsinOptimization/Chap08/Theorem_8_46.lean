import Mathlib
import FirstOrderMethodsinOptimization.Chap08.Lemma_8_45
import FirstOrderMethodsinOptimization.Chap08.Theorem_8_42

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

section

variable {E : Type u} [NormedAddCommGroup E] [NormedSpace ℝ E]
variable {m : ℕ} [NeZero m]
variable {X XStar : Set E} {f : E → ℝ} {g : Fin m → E → ℝ} {fOpt L : ℝ}
variable (xSel : (Fin m → NNReal) → {x // x ∈ X}) (lam0 : Fin m → NNReal)

local notation "γdyn" => fun n : ℕ ↦ (1 : ℝ) / Real.sqrt ((n : ℝ) + 1)

local notation "xSeq" =>
  dual_projected_subgradient_primal_iterate X g xSel γdyn lam0

local notation "constraintSeq" =>
  fun n ↦ dual_projected_subgradient_constraint_vector g (xSeq n : E)

local notation "fullAvg" =>
  full_averaging_sequence (fun n ↦ (xSeq n : E)) γdyn constraintSeq

/- Theorem 8.46 is `source-facing`: it gives the `O(log(k) / √k)` ergodic rate for the full
averaging sequence generated by the dual projected subgradient method with the explicit dynamic
stepsizes `γ_k = 1 / √(k + 1)`. The owner abstractions are already present in the Chapter 8 API:
the standing problem class `IsDualProjectedSubgradientProblem`, the generated primal sequence from
`dual_projected_subgradient_primal_iterate`, the full averaging operator
`full_averaging_sequence`, and the strict-feasibility margin from Theorem 8.42. The two textbook
inequalities share a single right-hand side and a single Slater constant, so the clean main
declaration is a scaled `max` estimate; the two displayed bounds are then recovered by companion
projection lemmas. -/

/-- The Slater constant
`α = (f xBar - fOpt) / min_i {-g_i(xBar)}`
attached to a strict feasible point `xBar`. -/
def dual_projected_subgradient_slater_constant
    (f : E → ℝ) (g : Fin m → E → ℝ) (fOpt : ℝ) (xBar : E) : ℝ :=
  (f xBar - fOpt) / strict_feasibility_margin g xBar

-- Proof sketch: unfold `dual_projected_subgradient_slater_constant`; this is exactly the ratio
-- `(f xBar - fOpt) / min_i {-g_i(xBar)}` with the denominator expressed by
-- `strict_feasibility_margin g xBar`.
/-- Unfolding `dual_projected_subgradient_slater_constant f g fOpt xBar` recovers the ratio
`(f xBar - fOpt) / strict_feasibility_margin g xBar`. -/
@[simp] theorem dual_projected_subgradient_slater_constant_def
    (f : E → ℝ) (g : Fin m → E → ℝ) (fOpt : ℝ) (xBar : E) :
    dual_projected_subgradient_slater_constant f g fOpt xBar =
      (f xBar - fOpt) / strict_feasibility_margin g xBar := sorry

-- Proof sketch: specialize
-- `dual_projected_subgradient_full_average_gap_le` to the dynamic stepsizes
-- `γ_n = 1 / √(n + 1)` and to `ρ = 2 * dual_projected_subgradient_slater_constant f g fOpt xBar`.
-- Then apply the harmonic-ratio estimate from Lemma 8.27 to the resulting quotient of sums, and
-- use the Slater-point multiplier bound from Corollary 8.43 to convert the penalized estimate
-- into simultaneous control of the objective gap and the scaled constraint norm.
/-- Theorem 8.46: under Assumption 8.41, if `‖g x‖ ≤ L` on `X` and `xBar` is a strict feasible
point, then the full-history averaged iterate generated by the dual projected subgradient method
with stepsizes `γ_k = 1 / √(k + 1)` satisfies the `O(log(k) / √k)` bound on the maximum of the
objective gap and the Slater-scaled constraint norm. -/
theorem dual_projected_subgradient_full_average_rate_max_le_log_over_sqrt
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γdyn)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    {k : ℕ} (hk : 1 ≤ k) :
    let α := dual_projected_subgradient_slater_constant f g fOpt xBar
    let rhs :=
      (L / 2) *
        ((‖dual_projected_subgradient_multiplier_vector lam0‖ + 2 * α) ^ (2 : ℕ) +
            1 + Real.log ((k : ℝ) + 1)) /
          Real.sqrt ((k : ℝ) + 1)
    max
        (f (fullAvg k) - fOpt)
        (α * ‖dual_projected_subgradient_constraint_vector g (fullAvg k)‖) ≤
      rhs := sorry

-- Proof sketch: apply `le_max_left` to
-- `dual_projected_subgradient_full_average_rate_max_le_log_over_sqrt`.
/-- The full-history averaged iterate satisfies the objective-gap half of the
`O(log(k) / √k)` rate bound. -/
theorem dual_projected_subgradient_full_average_objective_gap_le_log_over_sqrt
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γdyn)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    {k : ℕ} (hk : 1 ≤ k) :
    f (fullAvg k) - fOpt ≤
      (L / 2) *
        ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
              2 * dual_projected_subgradient_slater_constant f g fOpt xBar) ^ (2 : ℕ) +
            1 + Real.log ((k : ℝ) + 1)) /
          Real.sqrt ((k : ℝ) + 1) := sorry

-- Proof sketch: apply `le_max_right` to
-- `dual_projected_subgradient_full_average_rate_max_le_log_over_sqrt`, and then divide by the
-- positive Slater constant `dual_projected_subgradient_slater_constant f g fOpt xBar`.
/-- If the Slater constant is positive, the full-history averaged iterate also satisfies the
constraint-norm half of the `O(log(k) / √k)` rate bound. -/
theorem dual_projected_subgradient_full_average_constraint_norm_le_log_over_sqrt
    (h_problem : IsDualProjectedSubgradientProblem X XStar f g fOpt)
    (h_admissible :
      dual_projected_subgradient_method_is_admissible X f g xSel γdyn)
    (h_constraint_bound :
      ∀ x ∈ X, ‖dual_projected_subgradient_constraint_vector g x‖ ≤ L)
    {xBar : E} (hxBar : xBar ∈ X) (hgBar : ∀ i : Fin m, g i xBar < 0)
    (hAlpha : 0 < dual_projected_subgradient_slater_constant f g fOpt xBar)
    {k : ℕ} (hk : 1 ≤ k) :
    ‖dual_projected_subgradient_constraint_vector g (fullAvg k)‖ ≤
      ((L / (2 * dual_projected_subgradient_slater_constant f g fOpt xBar)) *
          ((‖dual_projected_subgradient_multiplier_vector lam0‖ +
                2 * dual_projected_subgradient_slater_constant f g fOpt xBar) ^ (2 : ℕ) +
              1 + Real.log ((k : ℝ) + 1))) /
        Real.sqrt ((k : ℝ) + 1) := sorry

end
