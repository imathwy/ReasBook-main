/-- Theorem 10.26: under Assumption 10.1, if `f` is convex and `x^k` is generated by the
proximal gradient method in the admissible constant/B2 stepsize regime from Remark 10.19 with
upper-rate factor `α`, and if the theorem-specific lower factor `β` satisfies `β L_f ≤ L_n` on
the prefix `0 ≤ n ≤ k`, then for every minimizer `xStar ∈ X^*` the best gradient-mapping norm
up to iteration `k` at the canonical parameter `α L_f` satisfies the textbook `O(1 / k)` bound
`min_{0 ≤ n ≤ k} ‖G_(α L_f)(x^n)‖ ≤ 2 α L_f ‖x^0 - xStar‖ / (β (k + 1))`. -/
theorem proximal_gradient_best_gradient_mapping_norm_le_sublinear_rate
    (htraj : is_proximal_gradient_trajectory f g x L)
    (hrule : hproblem.SublinearRateStepsizeRule x L htraj α)
    (hxStar : xStar ∈ XStar) (k : ℕ)
    (hLlower : ∀ ⦃n : ℕ⦄, n ≤ k → (β : ℝ) * (Lf : ℝ) ≤ (L n : ℝ)) :
    R[htraj; hproblem.sublinearRateResidualStepsize htraj α hrule, k] ≤
      2 * α * (Lf : ℝ) * ‖x 0 - xStar‖ / ((β : ℝ) * (k + 1 : ℝ)) := sorry

end
