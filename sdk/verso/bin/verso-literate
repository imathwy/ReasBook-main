#!/usr/bin/env bash
set -euo pipefail

SDK_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
COMMON_ROOT="$(cd -- "$SDK_ROOT/../common" && pwd)"
if [[ -n "${PYTHONPATH:-}" ]]; then
  export PYTHONPATH="$SDK_ROOT/src:$COMMON_ROOT/src:${PYTHONPATH}"
else
  export PYTHONPATH="$SDK_ROOT/src:$COMMON_ROOT/src"
fi
exec "$COMMON_ROOT/bin/python" -c \
  'import sys; from verso_build_sdk.literate import main; raise SystemExit(main(sys.argv[1:]))' \
  "$@"
