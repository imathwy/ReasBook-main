namespace Convex

omit [OrderTopology 𝕜] [IsStrictOrderedRing 𝕜] [CompleteSpace 𝕜] in
/-- Bridge/view owner lemma: projecting the positive-height homogenization slice to the second
coordinate gives exactly the positive scalar ray. -/
private theorem snd_image_positiveLift_eq_positiveRay (S : Set E) :
    (LinearMap.snd 𝕜 𝕜 E) '' {p : 𝕜 × E | 0 < p.1 ∧ p.2 ∈ p.1 • S} = 𝕜>0 • S := by
  ext x
  constructor
  · rintro ⟨p, hp, rfl⟩
    rcases Set.mem_smul_set.mp hp.2 with ⟨y, hy, hxy⟩
    exact Set.mem_smul.mpr ⟨p.1, hp.1, y, hy, hxy⟩
  · intro hx
    rcases Set.mem_smul.mp hx with ⟨a, ha, y, hy, rfl⟩
    exact ⟨(a, a • y), ⟨ha, Set.mem_smul_set.mpr ⟨y, hy, rfl⟩⟩, rfl⟩

/-- Text 6.19: for a nonempty convex set in a finite-dimensional normed space over `𝕜`, the
relative interior of the convex cone generated by `C`, formalized by the chapter owner
`cone[𝕜] C`, is exactly the positive ray generated by `ri[𝕜](C)`. -/
-- Proof sketch: use Corollary 6.8.1 in its canonical cone-owner form for the lifted cone
-- `cone[𝕜] (L[𝕜 | C])`, then push relative interiors forward along the second projection
-- `LinearMap.snd`. The image-cone bridge is the owner theorem
-- `PointedCone.snd_image_cone_unitLift_eq_cone`, and the projected relative-interior description is
-- exactly the positive ray over `ri[𝕜](C)`.
@[simp] theorem intrinsicInterior_cone_eq_positiveRay {C : Set E}
    [FiniteDimensional 𝕜 E]
    (hC : Convex 𝕜 C) (hCne : C.Nonempty) :
    ri[𝕜](cone[𝕜] C) = 𝕜>0 • ri[𝕜](C) := by
  let sndMap : 𝕜 × E →ₗ[𝕜] E := LinearMap.snd 𝕜 𝕜 E
  let liftCone : PointedCone 𝕜 (𝕜 × E) := cone[𝕜] (L[𝕜 | C])
  have hliftCone_convex :
      Convex 𝕜 (liftCone : Set (𝕜 × E)) :=
    liftCone.convex
  have hmap : sndMap '' (liftCone : Set (𝕜 × E)) = (cone[𝕜] C : Set E) := by
    simpa [liftCone, sndMap] using
      (PointedCone.snd_image_cone_unitLift_eq_cone (R := 𝕜) (C := C))
  calc
    ri[𝕜](cone[𝕜] C) = ri[𝕜](sndMap '' (liftCone : Set (𝕜 × E))) := by
      rw [hmap]
    _ = sndMap '' ri[𝕜]((liftCone : Set (𝕜 × E))) := by
      simpa [sndMap] using hliftCone_convex.intrinsicInterior_linear_image sndMap
    _ = sndMap '' {p : 𝕜 × E | 0 < p.1 ∧ p.2 ∈ p.1 • ri[𝕜](C)} := by
      simpa [liftCone] using
        congrArg
          (fun s : Set (𝕜 × E) ↦ sndMap '' s)
          (intrinsicInterior_homogenizationCone_eq hC hCne)
    _ = 𝕜>0 • ri[𝕜](C) := by
      simpa [sndMap] using
        snd_image_positiveLift_eq_positiveRay (S := ri[𝕜](C))

end Convex

end
