noncomputable section

universe u v v'

open scoped Rockafellar

namespace Bifunction

open SaddleFunction

/-!
Source/core/bridge triage:

- `source-facing`: Theorem 34.2 describes the class `Ω(F)` generated by a closed convex
  bifunction `F : U → X → WithTopBot 𝕜`: it is an equivalence class of closed concave-convex
  saddle-functions `K : U → XStar → WithTopBot 𝕜` bounded between the lower and upper
  representatives attached to `F`, and every closed concave-convex saddle-function on that
  paired surface arises from a unique such `F`.
- `core/canonical`: the owner layer already lives in `Defn_34_2`: the saddle-function notions
  `SaddleFunction.IsConcaveConvex`, `SaddleFunction.IsClosed`,
  together with the Chapter 34 equivalence owner `Bifunction.equivalence` from `Defn_34_4`,
  and the bifunction owners
  `Bifunction.IsClosedConvex`, `lowerPairing`, `upperAdjointPairing`, `omegaAdjoint`,
  and the self-dual specialization owners `upperPairing`, `omega`.
- `bridge/view`: the theorem-level work here is to connect both the intrinsic sandwich class
  `ΩAdj[UStar](F)` and the self-dual source surface `Ω(F)` with the canonical owner relation `∼`
  and with the source reconstruction statement.

Domain-style sampling used here:
- `Bifunction.equivalence` and `Bifunction.equivalent_iff` from `Defn_34_4`;
- `SaddleFunction.IsClosed` from `Defn_34_2`;
- `Bifunction.IsClosedConvex` from `Defn_34_2`;
- bifunction-domain notation `dom ·` from `Chap06.Definition_6_29_8`;
- `Bifunction.lowerPairing`, `Bifunction.upperAdjointPairing`, `ΩAdj[·](·)`, and the self-dual
  `Bifunction.upperPairing`, `Ω(·)` from `Defn_34_2`.

Primitive data vs derived API:
- primitive source data: a closed convex bifunction `F`, or a concave-convex closed
  saddle-function `K : U → XStar → WithTopBot 𝕜`;
- primitive owner objects reused here: `ΩAdj[UStar](F)`, `Ω(F)`, `lowerPairing XStar F`,
  `upperAdjointPairing XStar UStar F`, `upperPairing XStar F`, `dom ·`, and `∼`;
- derived API: the intrinsic characterization of `ΩAdj[UStar](F)` and the source-facing
  characterization of `Ω(F)` as classes of closed
  concave-convex saddle-functions equivalent to `lowerPairing XStar F`, the equivalence-class
  companion, the source-domain clauses stated directly with the canonical owner
  `dom ·`, the recovery formulas for `F` and its adjoint from an arbitrary
  `K ∈ Ω(F)`, the equality-on-`ri` clause, the closedness and concave-convexity of its members,
  and the converse unique-generator statement.

Layer target: `source-facing` theorem consequences built directly on the owner layer from
`Defn_34_2`.
-/

section OmegaAdjointShape

variable {𝕜 : Type*} {U : Type u} {UStar : Type*} {X : Type v} {XStar : Type v'}
variable [Ring 𝕜] [ConditionallyCompleteLinearOrder 𝕜] [TopologicalSpace 𝕜]
variable [TopologicalSpace U] [TopologicalSpace X] [TopologicalSpace XStar]
variable [AddCommMonoid U] [SMul 𝕜 U] [HasPairing U UStar 𝕜]
variable [AddCommMonoid X] [SMul 𝕜 X] [HasPairing X XStar 𝕜]
variable [Neg UStar] [HasPairing (U × X) (UStar × XStar) 𝕜]

/-- Intrinsic Chapter 34 shape form: for a closed convex bifunction `F`, the class
`ΩAdj[UStar](F)` consists exactly of the closed concave-convex saddle-functions equivalent to
`lowerPairing XStar F`. -/
theorem mem_omegaAdjoint_iff_isConcaveConvex_and_isClosed_and_equivalent_lowerPairing
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜) :
    K ∈ ΩAdj[UStar](F) ↔ IsConcaveConvex 𝕜 K ∧ IsClosed K ∧ K ∼ lowerPairing XStar F := by
  sorry

/-- Every member of `ΩAdj[UStar](F)` is a concave-convex saddle-function. -/
theorem isConcaveConvex_of_mem_omegaAdjoint
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F)
    (K : U → XStar → WithTopBot 𝕜) (hK : K ∈ ΩAdj[UStar](F)) : IsConcaveConvex 𝕜 K := by
  exact
    (mem_omegaAdjoint_iff_isConcaveConvex_and_isClosed_and_equivalent_lowerPairing
      (UStar := UStar) F hF K).1 hK |>.1

/-- Every member of `ΩAdj[UStar](F)` is a closed saddle-function. -/
theorem isClosed_of_mem_omegaAdjoint
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F)
    (K : U → XStar → WithTopBot 𝕜) (hK : K ∈ ΩAdj[UStar](F)) : IsClosed K := by
  exact
    (mem_omegaAdjoint_iff_isConcaveConvex_and_isClosed_and_equivalent_lowerPairing
      (UStar := UStar) F hF K).1 hK |>.2.1

end OmegaAdjointShape

section OmegaAdjointCore

variable {𝕜 : Type*} {U : Type u} {UStar : Type*} {X : Type v} {XStar : Type v'}
variable [Ring 𝕜] [ConditionallyCompleteLinearOrder 𝕜] [TopologicalSpace 𝕜]
variable [TopologicalSpace U] [TopologicalSpace X] [TopologicalSpace XStar]
variable [AddCommMonoid U] [SMul 𝕜 U] [HasPairing U UStar 𝕜]
variable [AddCommMonoid X] [SMul 𝕜 X] [HasPairing X XStar 𝕜]
variable [Neg UStar] [HasPairing (U × X) (UStar × XStar) 𝕜]

/-- Intrinsic Chapter 34 equivalence-class companion: for a closed convex bifunction `F`,
membership in `ΩAdj[UStar](F)` is equivalent to equivalence with the lower representative
`lowerPairing XStar F`. -/
theorem mem_omegaAdjoint_iff_equivalent_lowerPairing
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    : K ∈ ΩAdj[UStar](F) ↔ K ∼ lowerPairing XStar F := by
  sorry

/-- The lower representative generated by a closed convex bifunction belongs to
`ΩAdj[UStar](F)`. -/
theorem lowerPairing_mem_omegaAdjoint
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F)
    : lowerPairing XStar F ∈ ΩAdj[UStar](F) := by
  refine
    (mem_omegaAdjoint_iff_equivalent_lowerPairing (UStar := UStar) F hF
      (lowerPairing XStar F)).2 ?_
  exact (equivalent_iff (lowerPairing XStar F) (lowerPairing XStar F)).2 ⟨rfl, rfl⟩

/-- The adjoint-side upper representative generated by a closed convex bifunction belongs to
`ΩAdj[UStar](F)`. -/
theorem upperAdjointPairing_mem_omegaAdjoint
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F)
    : upperAdjointPairing XStar UStar F ∈ ΩAdj[UStar](F) := by
  sorry

end OmegaAdjointCore

section OmegaShape

variable {𝕜 : Type*} {U : Type u} {X : Type v} {XStar : Type v'}
variable [Ring 𝕜] [ConditionallyCompleteLinearOrder 𝕜] [TopologicalSpace 𝕜]
variable [TopologicalSpace U] [TopologicalSpace X] [TopologicalSpace XStar]
variable [AddCommMonoid U] [SMul 𝕜 U] [Neg U] [HasPairing U U 𝕜]
variable [AddCommMonoid X] [SMul 𝕜 X] [HasPairing X XStar 𝕜]

/-- Theorem 34.2, self-dual source-facing form: for a closed convex bifunction `F`, the class
`Ω(F)`
consists exactly of the closed concave-convex saddle-functions equivalent to the lower
representative `lowerPairing XStar F`. -/
theorem mem_omega_iff_isConcaveConvex_and_isClosed_and_equivalent_lowerPairing
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    : K ∈ Ω(F) ↔ IsConcaveConvex 𝕜 K ∧ IsClosed K ∧ K ∼ lowerPairing XStar F := by
  sorry

/-- Every member of `Ω(F)` is a concave-convex saddle-function. -/
theorem isConcaveConvex_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F)
    (K : U → XStar → WithTopBot 𝕜) (hK : K ∈ Ω(F)) : IsConcaveConvex 𝕜 K := by
  exact
    (mem_omega_iff_isConcaveConvex_and_isClosed_and_equivalent_lowerPairing F hF K).1 hK |>.1

/-- The converse clause of Theorem 34.2: every closed concave-convex saddle-function is
generated by a unique closed convex bifunction. -/
theorem existsUnique_closedConvex_generator
    (K : U → XStar → WithTopBot 𝕜)
    (hK_shape : IsConcaveConvex 𝕜 K)
    (hK_closed : IsClosed K) :
    ∃! F : U → X → WithTopBot 𝕜, IsClosedConvex F ∧ K ∈ Ω(F) := by
  sorry

end OmegaShape

section OmegaCore

variable {𝕜 : Type*} {U : Type u} {X : Type v} {XStar : Type v'}
variable [Ring 𝕜] [ConditionallyCompleteLinearOrder 𝕜] [TopologicalSpace 𝕜]
variable [TopologicalSpace U] [TopologicalSpace X] [TopologicalSpace XStar]
variable [AddCommMonoid U] [SMul 𝕜 U] [Neg U] [HasPairing U U 𝕜]
variable [AddCommMonoid X] [SMul 𝕜 X] [HasPairing X XStar 𝕜]
variable (F : U → X → WithTopBot 𝕜)

local notation "F⋆" => (adjoint XStar U F : XStar → U → WithTopBot 𝕜)

/-- Theorem 34.2, equivalence-class companion: for a closed convex bifunction `F`, membership in
`Ω(F)` is equivalent to equivalence with the lower representative `lowerPairing XStar F`. -/
theorem mem_omega_iff_equivalent_lowerPairing
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    : K ∈ Ω(F) ↔ K ∼ lowerPairing XStar F := by
  sorry

/-- Theorem 34.2: the lower representative generated by a closed convex bifunction belongs to its
own class `Ω(F)`. -/
theorem lowerPairing_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F)
    : lowerPairing XStar F ∈ Ω(F) := by
  refine (mem_omega_iff_equivalent_lowerPairing F hF (lowerPairing XStar F)).2 ?_
  exact (equivalent_iff (lowerPairing XStar F) (lowerPairing XStar F)).2 ⟨rfl, rfl⟩

/-- Theorem 34.2: the upper representative generated by a closed convex bifunction belongs to the
same equivalence class `Ω(F)`. -/
theorem upperPairing_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F)
    : upperPairing XStar F ∈ Ω(F) := by
  sorry

/-- Bridge theorem: the first Chapter 34 coordinate domain of the lower representative generated
by `F` is exactly the canonical primal source-domain owner `dom F`. -/
theorem dom₁_lowerPairing_eq_dom
    (F : U → X → WithTopBot 𝕜) :
    dom₁ (lowerPairing XStar F) = dom F := by
  sorry

/-- Bridge theorem: the second Chapter 34 coordinate domain of the lower representative generated
by `F` is exactly the canonical adjoint-side source-domain owner
`dom (-F⋆)`. -/
theorem dom₂_lowerPairing_eq_dom_neg_adjoint
    (F : U → X → WithTopBot 𝕜) :
    dom₂ (lowerPairing XStar F) = dom (-F⋆) := by
  sorry

/-- Bridge theorem: the Chapter 34 product domain of the lower representative generated by `F` is
the canonical source product domain
`dom F ×ˢ dom (-F⋆)`. -/
theorem dom_lowerPairing_eq_prod_dom_dom_neg_adjoint
    (F : U → X → WithTopBot 𝕜) :
    dom (lowerPairing XStar F) = dom F ×ˢ dom (-F⋆) := by
  sorry

/-- Theorem 34.2, source domain clause: every member of `Ω(F)` has the same first source domain
as `F`, stated on the canonical primal source-domain owner `dom F`. -/
theorem dom₁_eq_dom_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) :
    dom₁ K = dom F := by
  sorry

/-- Theorem 34.2, source domain clause: every member of `Ω(F)` has the same second source domain
as `F*`, stated on the canonical adjoint-side source-domain owner
`dom (-F⋆)`. -/
theorem dom₂_eq_dom_neg_adjoint_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) :
    dom₂ K = dom (-F⋆) := by
  sorry

/-- Bridge companion: every `K ∈ Ω(F)` has the same first Chapter 34 coordinate domain as the
lower representative generated by `F`. -/
theorem dom₁_eq_lowerPairing_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) :
    dom₁ K = dom₁ (lowerPairing XStar F) := by
  sorry

/-- Bridge companion: every `K ∈ Ω(F)` has the same second Chapter 34 coordinate domain as the
lower representative generated by `F`. -/
theorem dom₂_eq_lowerPairing_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) :
    dom₂ K = dom₂ (lowerPairing XStar F) := by
  sorry

/-- Theorem 34.2, source domain clause: every `K ∈ Ω(F)` has the product domain
`dom F ×ˢ dom (-F⋆)`. -/
theorem dom_eq_prod_dom_dom_neg_adjoint_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) :
    dom K = dom F ×ˢ dom (-F⋆) := by
  sorry

/-- Bridge companion: every `K ∈ Ω(F)` has the same Chapter 34 product domain as the lower
representative generated by `F`. -/
theorem dom_eq_lowerPairing_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) :
    dom K = dom (lowerPairing XStar F) := by
  sorry

/-- Theorem 34.2, recovery formula for the adjoint generator: if `K ∈ Ω(F)`, then each dual
slice of `F⋆` is recovered as the concave conjugate of the corresponding
first-variable slice of `K`. -/
theorem adjoint_eq_concaveConjugate_slice_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) (xStar : XStar) :
    F⋆ xStar = (fun u ↦ K u xStar)∗ := by
  sorry

/-- Every member of `Ω(F)` is a closed saddle-function. -/
theorem isClosed_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) : IsClosed K := by
  sorry

end OmegaCore

section OmegaPrimalRecovery

variable {𝕜 : Type*} {U : Type u} {X : Type v} {XStar : Type v'}
variable [Ring 𝕜] [ConditionallyCompleteLinearOrder 𝕜] [TopologicalSpace 𝕜]
variable [TopologicalSpace U] [TopologicalSpace X] [TopologicalSpace XStar]
variable [AddCommMonoid U] [SMul 𝕜 U] [Neg U] [HasPairing U U 𝕜]
variable [AddCommMonoid X] [SMul 𝕜 X] [HasPairing X XStar 𝕜]
variable [HasPairing XStar X 𝕜]

/-- Theorem 34.2, recovery formula for the primal generator: if `K ∈ Ω(F)`, then each primal
slice of `F` is recovered pointwise as the Fenchel conjugate `(K u)⋆` of the corresponding
slice of `K`.
-/
theorem eq_convexConjugate_slice_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) (u : U) (x : X) :
    F u x = (K u)⋆ x := by
  sorry

end OmegaPrimalRecovery

section RelativeInterior

variable {𝕜 : Type*} {U : Type u} {X : Type v} {XStar : Type v'}
variable [Ring 𝕜] [ConditionallyCompleteLinearOrder 𝕜] [TopologicalSpace 𝕜]
variable [TopologicalSpace U] [TopologicalSpace X] [TopologicalSpace XStar]
variable [AddCommGroup U] [Module 𝕜 U] [HasPairing U U 𝕜]
variable [AddCommMonoid X] [SMul 𝕜 X] [HasPairing X XStar 𝕜]
variable [AddCommGroup XStar] [Module 𝕜 XStar]

/-- Theorem 34.2, equality-on-`ri` clause: on the relative interior of the common Chapter 34
product domain `dom K`, every member of `Ω(F)` agrees with the lower representative. -/
theorem eqOn_intrinsicInterior_dom_lowerPairing_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) :
    Set.EqOn (Function.uncurry K) (Function.uncurry (lowerPairing XStar F))
      ri[𝕜](dom K) := by
  sorry

/-- Theorem 34.2, equality-on-`ri` clause: on the relative interior of the common Chapter 34
product domain `dom K`, every member of `Ω(F)` agrees with the upper representative. -/
theorem eqOn_intrinsicInterior_dom_upperPairing_of_mem_omega
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    (hK : K ∈ Ω(F)) :
    Set.EqOn (Function.uncurry K) (Function.uncurry (upperPairing XStar F))
      ri[𝕜](dom K) := by
  sorry

end RelativeInterior

