open MeasureTheory

/-- The Bernoulli sequence space `{0,1}^ℕ`, modeled as `ℕ → Bool`. -/
abbrev BernoulliSequence := ℕ → Bool

/-- The fair Bernoulli product measure on `{0,1}^ℕ`. -/
noncomputable def fairBernoulliMeasure : Measure BernoulliSequence :=
  Measure.infinitePi fun _ : ℕ ↦ (PMF.uniformOfFintype Bool).toMeasure

-- Proof sketch: the product measurable space on `ℕ → Bool` is defined as the supremum of the
-- pulled-back measurable spaces along the coordinate evaluations, so this is exactly the
-- `σ`-algebra generated by the coordinate maps.
/-- Exercise 1.4.4 (1): the product `σ`-algebra on `{0,1}^ℕ` is the `σ`-algebra generated by the
coordinate maps `X_n`. -/
theorem bernoulliSigmaAlgebra_eq_iSup_coordinateComap :
    (inferInstance : MeasurableSpace BernoulliSequence) =
      ⨆ n : ℕ, MeasurableSpace.comap (Function.eval n)
        (inferInstance : MeasurableSpace Bool) :=
  rfl

/-
Exercise 1.4.4 (2): the binary-expansion map `U`, formalized by `Real.fromBinary`, is continuous
from the Bernoulli sequence space to `[0,1]`.
-/
recall Real.fromBinary_continuous : Continuous (Real.fromBinary : BernoulliSequence → unitInterval)

/-- Exercise 1.4.4 (2): the binary-expansion map `U`, formalized by `Real.fromBinary`, is
measurable from the Bernoulli sequence space to `[0,1]`. -/
theorem measurable_fromBinary :
    Measurable (Real.fromBinary : BernoulliSequence → unitInterval) :=
  Real.fromBinary_continuous.measurable

-- Proof sketch: compare the pushforward of the fair Bernoulli product measure under
-- `Real.fromBinary` with the canonical probability measure `volume` on `unitInterval`; the intended
-- proof identifies both measures on dyadic intervals and then uses measure extensionality.
/-- Exercise 1.4.4 (3): the image measure of the fair Bernoulli product measure under the
binary-expansion map is the uniform measure on `[0,1]`. -/
theorem map_fromBinary_fairBernoulliMeasure :
    Measure.map (Real.fromBinary : BernoulliSequence → unitInterval) fairBernoulliMeasure =
      volume := sorry

/-- The canonical subset of binary sequences: those with infinitely many zeros, together with the
constant-one sequence representing the endpoint `1`. -/
def canonicalBinaryDomain : Set BernoulliSequence :=
  {ω | (∀ N : ℕ, ∃ n ≥ N, ω n = false) ∨ ∀ n : ℕ, ω n = true}

/-- The canonical binary digits of a point of `[0,1]`: greedy base-two digits on `[0,1)`, and the
constant-one expansion at the endpoint `1`. -/
noncomputable def canonicalBinaryDigits (x : unitInterval) : BernoulliSequence :=
  if (x : ℝ) = 1 then
    fun _ ↦ true
  else
    fun n ↦ finTwoEquiv (Real.digits (x : ℝ) 2 n)

/-- The canonical digit sequence of a point in `[0,1]` belongs to the chosen domain of canonical
binary expansions. -/
-- Proof sketch: for `x = 1` the digits are constantly `true`; for `x < 1`, the greedy base-two
-- expansion supplied by `Real.digits` is the terminating-zero expansion of dyadic rationals, hence
-- has infinitely many zeros.
theorem canonicalBinaryDigits_mem_domain (x : unitInterval) :
    canonicalBinaryDigits x ∈ canonicalBinaryDomain := sorry

/-- The inverse map from `[0,1]` to the chosen domain of canonical binary expansions. -/
noncomputable def canonicalBinaryInverse (x : unitInterval) : canonicalBinaryDomain :=
  ⟨canonicalBinaryDigits x, canonicalBinaryDigits_mem_domain x⟩

-- Proof sketch: prove measurability of `canonicalBinaryDomain` from its eventual-zero/eventual-one
-- description, then show that restricting `Real.fromBinary` to this subset removes exactly the
-- ambiguous eventually-one expansions while retaining the constant-one sequence for `1`.
/-- The chosen domain of canonical binary expansions is measurable. -/
theorem measurableSet_canonicalBinaryDomain :
    MeasurableSet canonicalBinaryDomain := sorry

/-- The restriction of the binary-expansion map to the chosen domain of canonical binary
expansions is bijective onto `[0,1]`. -/
theorem bijective_fromBinary_canonicalBinaryDomain :
    Function.Bijective (fun ω : canonicalBinaryDomain ↦ Real.fromBinary ω.1) := sorry

/-- Exercise 1.4.4 (4): the subset of canonical binary expansions is measurable, and the
restriction of the binary-expansion map to it is bijective onto `[0,1]`. -/
theorem canonicalBinaryDomain_measurableSet_and_fromBinary_bijective :
    MeasurableSet canonicalBinaryDomain ∧
      Function.Bijective (fun ω : canonicalBinaryDomain ↦ Real.fromBinary ω.1) :=
  ⟨measurableSet_canonicalBinaryDomain, bijective_fromBinary_canonicalBinaryDomain⟩

-- Proof sketch: use the explicit formula for `canonicalBinaryInverse`; measurability follows from
-- the measurability of the digit maps `x ↦ Real.digits x 2 n` on `[0,1)` together with the
-- measurable singleton `{1}`.
/-- Exercise 1.4.4 (5): the inverse of the bijective restriction of the binary-expansion map is
measurable. -/
theorem measurable_canonicalBinaryInverse :
    Measurable canonicalBinaryInverse := sorry

-- Proof sketch: unfold `canonicalBinaryInverse` and read off the `n`th coordinate of the chosen
-- canonical digit sequence.
/-- The `n`th coordinate of the canonical inverse is the `n`th canonical binary digit. -/
@[simp] theorem canonicalBinaryInverse_apply (n : ℕ) (x : unitInterval) :
    (canonicalBinaryInverse x).1 n = canonicalBinaryDigits x n :=
  rfl

/-- Exercise 1.4.4 (6): composing the `n`th coordinate map with the inverse of the canonical
binary-expansion bijection returns the `n`th binary digit of the canonical expansion of a point in
`[0,1]`. -/
theorem coordinateMap_canonicalBinaryInverse_eq_canonicalBinaryDigit (n : ℕ) :
    (fun x : unitInterval ↦ (canonicalBinaryInverse x).1 n) = fun x ↦ canonicalBinaryDigits x n :=
  rfl
