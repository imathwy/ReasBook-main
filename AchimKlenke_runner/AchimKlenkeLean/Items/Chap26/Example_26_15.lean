-- Proof sketch: for weak existence, start from a Brownian motion `X`, define
-- `W_t = ∫_0^t sign(X_s) dX_s`, and use Lévy's characterization to show that `W` is Brownian, so
-- the resulting package is a weak solution of the sign SDE. For non-adaptedness, approximate
-- `|x|` by even convex `C²` functions, apply Itô's formula to rewrite `W_t` as a functional of
-- `(|X_s|)_{s ≤ t}`, and conclude that `σ(W) ⊆ σ(|X|) ⊊ σ(X)`, so `X` cannot be adapted to the
-- filtration generated by `W`.
/-- Example 26.15: the one-dimensional SDE `dX_t = sign(X_t) dW_t` with initial value `X₀ = 0`
admits a weak solution, but in every weak solution the scalar state process is not adapted to the
filtration generated by the scalar Brownian driver. -/
theorem sign_sde_hasWeakSolution_and_state_not_adapted_to_driver :
    Nonempty
      (GeneralizedWeakSDESolution
        (Measure.dirac (oneDimensionalState (0 : ℝ)))
        (oneDimensionalDiffusion (fun _ x ↦ Real.sign x))
        (oneDimensionalDrift (fun _ _ ↦ (0 : ℝ)))) ∧
      ∀ L :
          GeneralizedWeakSDESolution
            (Measure.dirac (oneDimensionalState (0 : ℝ)))
            (oneDimensionalDiffusion (fun _ x ↦ Real.sign x))
            (oneDimensionalDrift (fun _ _ ↦ (0 : ℝ))),
        ¬ Adapted
          (processFiltration (fun t ω ↦ L.W t ω 0))
          (fun t ω ↦ (L ω t) 0) := sorry

end ProbabilityTheory
