import Mathlib
import chapter1_reference_format.Chap01.Definition_1_1_91

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open scoped Nat

namespace IsPrimitiveRoot

variable {n : ℕ} [NeZero n]

/-- A primitive root modulo `n` generates the whole unit group of `ZMod n`. -/
theorem unit_mem_zpowers {g : (ZMod n)ˣ} (hg : IsPrimitiveRoot g n.totient)
    (u : (ZMod n)ˣ) : u ∈ Subgroup.zpowers g := by
  -- Write `u` as the power determined by its discrete logarithm.
  rw [Subgroup.mem_zpowers_iff]
  refine ⟨hg.log u, ?_⟩
  rw [zpow_natCast]
  exact (hg.pow_log u).symm

/-- Helper for Proposition 1.1.92: the textbook index is the additive coordinate obtained from
`hg.zmodEquivZPowers.symm` on the cyclic subgroup generated by the primitive root. -/
lemma index_eq_zmodEquivZPowers_symm {g : (ZMod n)ˣ} (hg : IsPrimitiveRoot g n.totient)
    (u : (ZMod n)ˣ) :
    ind_{hg} u = hg.zmodEquivZPowers.symm ⟨u, hg.unit_mem_zpowers u⟩ := by
  have hs : (⟨g ^ (hg.log u : ℕ), hg.unit_mem_zpowers (g ^ (hg.log u : ℕ))⟩ :
      Subgroup.zpowers g) = ⟨u, hg.unit_mem_zpowers u⟩ := by
    apply Subtype.ext
    exact (hg.pow_log u).symm
  -- Compare both sides with the exponent returned by the discrete logarithm.
  calc
    ind_{hg} u = (hg.log u : ZMod n.totient) := rfl
    _ = hg.zmodEquivZPowers.symm ⟨g ^ (hg.log u : ℕ), hg.unit_mem_zpowers (g ^ (hg.log u : ℕ))⟩ := by
      symm
      simpa using hg.zmodEquivZPowers_symm_apply_pow' (ζ := g) (i := (hg.log u : ℕ))
    _ = hg.zmodEquivZPowers.symm ⟨u, hg.unit_mem_zpowers u⟩ := by
      simpa using congrArg hg.zmodEquivZPowers.symm hs

/-- Equal indices are equivalent to equal units modulo `n`. -/
-- Proof sketch: `ind_{hg} u` is the additive discrete-log coordinate of a unit with respect to the
-- primitive root `g`, so equal indices mean equal powers of `g`.
theorem index_eq_iff {g u v : (ZMod n)ˣ} (hg : IsPrimitiveRoot g n.totient) :
    ind_{hg} u = ind_{hg} v ↔ u = v := by
  constructor
  · intro h
    -- Move the equality to the cyclic subgroup coordinates and use injectivity of the equivalence.
    have h' : hg.zmodEquivZPowers.symm ⟨u, hg.unit_mem_zpowers u⟩ =
        hg.zmodEquivZPowers.symm ⟨v, hg.unit_mem_zpowers v⟩ := by
      simpa [hg.index_eq_zmodEquivZPowers_symm] using h
    have hs : (⟨u, hg.unit_mem_zpowers u⟩ : Subgroup.zpowers g) =
        ⟨v, hg.unit_mem_zpowers v⟩ := hg.zmodEquivZPowers.symm.injective h'
    exact congrArg Subtype.val hs
  · intro h
    simp [h]

/-- Proposition 1.1.92 (1): the index of the unit element is zero. -/
-- Proof sketch: `1` is `g^0`, so its discrete logarithm is `0`.
theorem index_one {g : (ZMod n)ˣ} (hg : IsPrimitiveRoot g n.totient) :
    ind_{hg} 1 = 0 := by
  -- The unit element is the zeroth power of the primitive root.
  change (hg.log 1 : ZMod n.totient) = (0 : ZMod n.totient)
  have h0 : hg.log 1 = (0 : Fin n.totient) := by
    exact (hg.log_eq_iff 1 (0 : Fin n.totient)).2 (by simp)
  simp [h0]

/-- Proposition 1.1.92 (2): the primitive root itself has index one. -/
-- Proof sketch: apply the discrete logarithm to the power `g^1 = g`.
theorem index_generator {g : (ZMod n)ˣ} (hg : IsPrimitiveRoot g n.totient) :
    ind_{hg} g = 1 := by
  -- The primitive root itself is the first power of `g`.
  change (hg.log g : ZMod n.totient) = (1 : ZMod n.totient)
  have hpow : g = g ^ ((1 : Fin n.totient) : ℕ) := by
    calc
      g = g ^ 1 := by
        simp
      _ = g ^ (1 % n.totient) := by
        exact pow_eq_pow_mod (a := g) 1 hg.pow_eq_one
      _ = g ^ ((1 : Fin n.totient) : ℕ) := by
        rfl
  have h1 : hg.log g = (1 : Fin n.totient) := by
    exact (hg.log_eq_iff g (1 : Fin n.totient)).2 hpow
  simp [h1]

/-- Proposition 1.1.92 (3): the index turns multiplication of units modulo `n` into addition in
`ZMod n.totient`. -/
-- Proof sketch: write both units as powers of `g`, multiply the exponents, and use additivity in
-- `ZMod n.totient`.
theorem index_mul {g u v : (ZMod n)ˣ} (hg : IsPrimitiveRoot g n.totient) :
    ind_{hg} (u * v) = ind_{hg} u + ind_{hg} v := by
  -- Transport multiplication in the subgroup to addition in `ZMod (φ n)`.
  calc
    ind_{hg} (u * v) = hg.zmodEquivZPowers.symm ⟨u * v, hg.unit_mem_zpowers (u * v)⟩ :=
      hg.index_eq_zmodEquivZPowers_symm (u * v)
    _ = hg.zmodEquivZPowers.symm (⟨u, hg.unit_mem_zpowers u⟩ + ⟨v, hg.unit_mem_zpowers v⟩) := by
      rfl
    _ = hg.zmodEquivZPowers.symm ⟨u, hg.unit_mem_zpowers u⟩ +
          hg.zmodEquivZPowers.symm ⟨v, hg.unit_mem_zpowers v⟩ := by
      rw [map_add]
    _ = ind_{hg} u + ind_{hg} v := by
      rw [hg.index_eq_zmodEquivZPowers_symm, hg.index_eq_zmodEquivZPowers_symm]

/-- Proposition 1.1.92 (4): the index of a power is the corresponding multiple of the index. -/
-- Proof sketch: iterate the multiplicative formula for the index, or evaluate the discrete
-- logarithm on the power `u ^ m`.
theorem index_pow {g u : (ZMod n)ˣ} (hg : IsPrimitiveRoot g n.totient) (m : ℕ) :
    ind_{hg} (u ^ m) = (m : ZMod n.totient) * ind_{hg} u := by
  induction m with
  | zero =>
      -- The zeroth power reduces to the previous computation for `1`.
      rw [pow_zero, hg.index_one]
      simp
  | succ m hm =>
      -- One more factor of `u` adds one more copy of the index.
      rw [pow_succ, hg.index_mul, hm]
      calc
        (m : ZMod n.totient) * ind_{hg} u + ind_{hg} u
            = ((m : ZMod n.totient) + 1) * ind_{hg} u := by
              rw [add_mul, one_mul]
        _ = ((m + 1 : ℕ) : ZMod n.totient) * ind_{hg} u := by
              norm_num

/-- Proposition 1.1.92 (5): changing the primitive root rescales indices by the index of the new
primitive root with respect to the old one. -/
-- Proof sketch: express `g'` as a power of `g`; then every `u` written as a power of `g'` is also
-- a power of `g`, and the exponents differ by multiplication in `ZMod n.totient`.
theorem index_change_generator {g g' u : (ZMod n)ˣ}
    (hg : IsPrimitiveRoot g n.totient) (hg' : IsPrimitiveRoot g' n.totient) :
    ind_{hg} u = ind_{hg'} u * ind_{hg} g' := by
  -- Rewrite `u` using the alternate primitive root, then transport that exponent back to `g`.
  calc
    ind_{hg} u = ind_{hg} (g' ^ (hg'.log u : ℕ)) := by
      exact congrArg (fun x : (ZMod n)ˣ ↦ ind_{hg} x) (hg'.pow_log u)
    _ = (hg'.log u : ZMod n.totient) * ind_{hg} g' := by
      simpa using hg.index_pow (u := g') (m := (hg'.log u : ℕ))
    _ = ind_{hg'} u * ind_{hg} g' := by
      rfl

/-- Proposition 1.1.92 (6): two integers prime to `n` have the same index exactly when they define
the same residue class modulo `n`, equivalently when they are congruent modulo `n`. -/
-- Proof sketch: pass from integers prime to `n` to units using `ZMod.unitOfIsCoprime`, apply
-- `index_eq_iff`, and rewrite equality of those units as equality in `ZMod n`.
theorem index_int_eq_iff {g : (ZMod n)ˣ} (hg : IsPrimitiveRoot g n.totient)
    (a b : ℤ) (ha : IsCoprime a (n : ℤ)) (hb : IsCoprime b (n : ℤ)) :
    ind_{hg} (ZMod.unitOfIsCoprime a ha) = ind_{hg} (ZMod.unitOfIsCoprime b hb) ↔
      (a : ZMod n) = (b : ZMod n) := by
  -- Reduce the statement to injectivity of the index map on units.
  simpa [Units.ext_iff, ZMod.coe_unitOfIsCoprime] using
    (hg.index_eq_iff (u := ZMod.unitOfIsCoprime a ha) (v := ZMod.unitOfIsCoprime b hb))

end IsPrimitiveRoot
