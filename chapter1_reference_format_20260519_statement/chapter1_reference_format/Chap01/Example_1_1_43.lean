import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

-- Proof sketch: extensionality reduces this to the fact that an element belongs to the zero ideal
-- exactly when it is zero.
/-- Example 1.1.43 (1): for a semiring `R`, hence in particular for a unital ring `R`, the zero
ideal `(0)` consists exactly of the additive identity `0`. -/
theorem zero_ideal_carrier_eq_singleton_zero (R : Type u) [Semiring R] :
    ((0 : Ideal R) : Set R) = ({0} : Set R) := by
  ext x
  simp

/- Example 1.1.43 (2): the integers carry their canonical commutative ring structure. -/
#check (inferInstance : CommRing ℤ)

/- Example 1.1.43 (3): the integers form an integral domain. -/
#check (inferInstance : IsDomain ℤ)

-- Proof sketch: identify `nℤ` with the principal ideal generated by `n`; membership in that
-- ideal is equivalent to divisibility, hence to being an integer multiple of `n`.
/-- Example 1.1.43 (4): for each integer `n`, the set `nℤ = {nk | k ∈ ℤ}` is exactly the carrier
of the principal ideal generated by `n` in `ℤ`. -/
theorem int_span_singleton_carrier_eq_set_of_multiples (n : ℤ) :
    ((Ideal.span ({n} : Set ℤ)) : Set ℤ) = {m : ℤ | ∃ k : ℤ, m = n * k} := by
  ext m
  change m ∈ Ideal.span ({n} : Set ℤ) ↔ ∃ k : ℤ, m = n * k
  rw [Ideal.mem_span_singleton, dvd_iff_exists_eq_mul_right]
