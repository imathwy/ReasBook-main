import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section FiniteGroup

variable (G : Type u) [Group G]

/- Definition 1.1.84 (1): a finite group is a group whose underlying type is finite. -/
#check (Finite G)

variable [Finite G]

/- The order of a finite group `G` is the cardinality `Nat.card G` of its underlying finite type.
-/
#check Nat.card G

end FiniteGroup

section ElementOrder

variable {G : Type u} [Group G] (g : G)

/- Definition 1.1.84 (2): for an element `g : G`, the order of `g` is the canonical natural
number `orderOf g`, which agrees with the cardinality of the cyclic subgroup `Subgroup.zpowers g`
generated by `g`. -/
#check orderOf g

/- The subgroup generated by `g` has cardinality `orderOf g`. -/
#check Nat.card_zpowers g

end ElementOrder
