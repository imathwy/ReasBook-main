import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open scoped IntermediateField

universe u

variable {K : Type u} [Field K] [Algebra ℚ K]

/-- Definition 1.4.49: the degree of an algebraic number `α` is the `ℚ`-dimension of the simple
extension `ℚ⟮α⟯`. -/
noncomputable def algebraicNumberDegree (α : { x : K // IsAlgebraic ℚ x }) : ℕ :=
  letI := IntermediateField.adjoin.finiteDimensional α.2.isIntegral
  Module.finrank ℚ ℚ⟮(α : K)⟯

-- Proof sketch: apply `IntermediateField.adjoin.finrank` to the simple extension `ℚ⟮α⟯`
-- generated by the algebraic element `α`.
/-- The degree of an algebraic number is the degree of its minimal polynomial over `ℚ`. -/
theorem algebraicNumberDegree_eq_natDegree (α : { x : K // IsAlgebraic ℚ x }) :
    algebraicNumberDegree α = (minpoly ℚ (α : K)).natDegree := by
  simpa [algebraicNumberDegree] using
    IntermediateField.adjoin.finrank α.2.isIntegral
