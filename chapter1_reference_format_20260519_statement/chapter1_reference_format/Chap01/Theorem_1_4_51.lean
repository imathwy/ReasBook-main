import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open scoped IntermediateField

universe u

variable (K : Type u) [Field K] [NumberField K]

/- Theorem 1.4.51: every number field is a simple extension of `ℚ`; equivalently, there exists
`α : K` such that the intermediate field `ℚ⟮α⟯` generated by `α` is all of `K`. This is the
canonical primitive-element theorem `Field.exists_primitive_element`, specialized to the
number-field extension `K / ℚ`. -/
#check
  (show ∃ α : K, ℚ⟮α⟯ = (⊤ : IntermediateField ℚ K) from
    Field.exists_primitive_element ℚ K)
