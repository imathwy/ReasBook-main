import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

variable {ι : Type u}

/- Definition 1.1.61: for a finite family of integers indexed by a finset `s`, the least common
multiple is the canonical `Finset.lcm` of that family in `ℤ`; equivalently, it is the unique
nonnegative generator of the intersection of the principal ideals `a i ℤ`. -/
#check (Finset.lcm : Finset ι → (ι → ℤ) → ℤ)

-- Proof sketch: identify membership in a principal ideal `Ideal.span ({z} : Set ℤ)` with
-- divisibility by `z`, rewrite membership in the finite infimum of ideals as simultaneous
-- membership in each ideal, and then apply the universal property `Finset.lcm_dvd_iff`.
/-- The intersection of the principal ideals generated by a finite family of integers is the
principal ideal generated by its least common multiple. -/
theorem finset_inf_span_singleton_eq_span_lcm (s : Finset ι) (a : ι → ℤ) :
    (s.inf fun i ↦ Ideal.span {a i}) = Ideal.span {s.lcm a} := by
  ext x
  simp [Ideal.mem_span_singleton, Finset.lcm_dvd_iff]
