import Mathlib
import ConvexAnalysis_Rockafellar_1970.Chap01.Definition_2_6_10
import ConvexAnalysis_Rockafellar_1970.Chap02.RecessionConeConeBridge
import ConvexAnalysis_Rockafellar_1970.Chap04.Theorem_18_7

-- Declarations for this item will be appended below by the statement pipeline.

open Set
open scoped Pointwise Rockafellar

section

variable {𝕜 : Type*} [NormedField 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  [OrderTopology 𝕜]
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace 𝕜 E]

omit [OrderTopology 𝕜] in
private theorem mem_recessionCone_of_mem_pointedCone {L : PointedCone 𝕜 E} {y : E}
    (hy : y ∈ (L : Set E)) :
    y ∈ 0⁺[𝕜] (L : Set E) := by
  rw [Set.mem_recessionCone_iff]
  intro x hx a ha
  exact L.add_mem hx <| L.smul_mem ha hy

omit [OrderTopology 𝕜] in
private theorem recessionConeCone_eq_toConvexCone (K : PointedCone 𝕜 E) :
    (Set.recessionConeCone (K : Set E) 𝕜) = (K : ConvexCone 𝕜 E) := by
  ext y
  constructor
  · intro hy
    have hy_mem : y ∈ 0⁺[𝕜] (K : Set E) := by simpa using hy
    have hyK := (Set.mem_recessionCone_iff.mp hy_mem) 0 K.zero_mem 1 zero_le_one
    simpa using hyK
  · intro hy
    exact by
      simpa using (mem_recessionCone_of_mem_pointedCone (L := K) hy)

omit [OrderTopology 𝕜] in
private theorem originRay_subset_cone_of_mem {T : Set E} {x : E}
    (hxT : x ∈ T) (hx0 : x ≠ 0) :
    originRay (rayOfNeZero 𝕜 x hx0) ⊆ (cone[𝕜] T : Set E) := by
  intro y hy
  rw [originRay_eq_nonnegative_smul_singleton hx0] at hy
  rcases Set.mem_smul.mp hy with ⟨a, ha, z, hz, rfl⟩
  have hz' : z = x := by
    simpa using hz
  subst hz'
  exact (cone[𝕜] T).smul_mem ha <| PointedCone.subset_hull hxT

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 18.7.1 says that a closed convex cone with no lines is the closure of
  the convex cone generated by any subset `T ⊆ K` that supplies one generator for each exposed
  ray of `K`.
- `core/canonical`: the owner abstractions are the bundled cone `PointedCone 𝕜 E`, the generated
  cone `cone[𝕜] T`, the canonical closure `(cone[𝕜] T).closure`, the lineality owner
  `PointedCone.lineal`, the exposed-ray predicate `IsExposedRay`, and the exposed direction owner
  `Set.exposedDirections` together with `rayOfDirections`.
- `bridge/view`: the textbook phrase “an exposed ray is generated by some `x ∈ T`” is kept as the
  direct source-facing hypothesis that every exposed-ray subset contains a nonzero point of `T`,
  rather than by a separate wrapper predicate.

Domain-style sampling used here:
- `IsExposedRay`;
- `Set.exposedDirections`;
- `rayOfDirections`;
- `eq_cone_of_extremeRay_generating_subset`;
- `eq_closure_mixedConvexHull_exposedPoints_rayOfExposedDirections`;
- `PointedCone.lineal`.

Primitive data vs derived API:
- primitive inputs: the closed cone `K`, the subset `T ⊆ K`, the exclusion of nontrivial lines in
  `K` expressed canonically as `K.lineal = ⊥`, and the direct source-facing generator condition on
  exposed rays stated via `IsExposedRay`;
- derived API: the equality identifying `K` with the closure of the canonical cone generated by
  `T`.

Ambient refinement:
- the neighboring source-facing owners `eq_cone_of_extremeRay_generating_subset` and
  `eq_closure_mixedConvexHull_exposedPoints_rayOfExposedDirections` already live on arbitrary
  ordered normed fields and finite-dimensional affine-direction layers, so concrete ambient models
  are unnecessary here.

Layer target: `source-facing`, expressed directly with the canonical owners
`PointedCone.lineal`, `cone[𝕜]`, `PointedCone.closure`, `IsExposedRay`,
`Set.exposedDirections`, and `rayOfDirections`.
-/

/-- Corollary 18.7.1: over an ordered normed field `𝕜`, if a closed convex cone `K` contains no
nontrivial line through the origin and every exposed ray of `K` is generated by some vector of a
subset `T ⊆ K`, then `K` is the closure of the convex cone generated by `T`. Specializing to
`𝕜 = ℝ` and `E = EuclideanSpace ℝ (Fin n)` recovers the textbook `ℝ^n` formulation. -/
-- Proof sketch: apply Theorem 18.7 to the carrier set of `K`. For a cone, the exposed-point part
-- reduces to the origin, and the hypothesis on `T` identifies the exposed-direction contribution
-- with the rays generated by vectors of `T`. The mixed convex hull description from Theorem 18.7
-- therefore collapses to the pointed-cone hull of `T`, after which the closedness of `K` yields
-- the stated closure equality.
theorem eq_closure_hull_of_exposedRay_generating_subset
    {K : PointedCone 𝕜 E} {T : Set E} (hK_closed : IsClosed (K : Set E))
    [FiniteDimensional 𝕜 (affineSpan 𝕜 (K : Set E)).direction]
    [FiniteDimensional 𝕜 (affineSpan 𝕜 (lin[𝕜]((K : Set E)))).direction]
    (hK_lineal : K.lineal = ⊥)
    (hT_subset : T ⊆ K)
    (hT_exposed :
      ∀ ⦃S : Set E⦄, IsExposedRay (K : ConvexCone 𝕜 E) S → ∃ x ∈ T, x ≠ 0 ∧ x ∈ S) :
    K = (cone[𝕜] T).closure := by
  let L : PointedCone 𝕜 E := (cone[𝕜] T).closure
  have hK_convex : Convex 𝕜 (K : Set E) := K.convex
  have hK_not_hasAffineLine : ¬ Set.HasAffineLine 𝕜 (K : Set E) := by
    intro hline
    have hK_nonempty : ((K : Set E).Nonempty) := ⟨0, K.zero_mem⟩
    rcases
        (Set.hasAffineLine_iff_exists_ne_zero_mem_lineal hK_nonempty hK_closed hK_convex).mp
          hline with
      ⟨y, hy0, hy_lineal⟩
    rw [Submodule.eq_bot_iff] at hK_lineal
    apply hy0
    apply hK_lineal y
    rw [PointedCone.mem_lineal]
    rw [Set.mem_lineal_iff] at hy_lineal
    constructor
    · have hy_mem := (Set.mem_recessionCone_iff.mp hy_lineal.1) 0 K.zero_mem 1 zero_le_one
      simpa using hy_mem
    · have hneg_mem := (Set.mem_recessionCone_iff.mp hy_lineal.2) 0 K.zero_mem 1 zero_le_one
      simpa using hneg_mem
  have hpoints :
      (K : Set E).exposedPoints 𝕜 ⊆ (L : Set E) := by
    intro z hz
    have hz_ext : z ∈ (K : Set E).extremePoints 𝕜 :=
      exposedPoints_subset_extremePoints hz
    by_cases hz0 : z = 0
    · exact hz0 ▸ subset_closure (cone[𝕜] T).zero_mem
    · rcases mem_extremePoints.mp hz_ext with ⟨hzK, hz_extreme⟩
      have h2z : (2 : 𝕜) • z ∈ (K : Set E) := K.smul_mem (by norm_num) hzK
      have hz_seg : z ∈ openSegment 𝕜 (0 : E) ((2 : 𝕜) • z) := by
        rw [openSegment_eq_image_lineMap]
        refine ⟨(1 / 2 : 𝕜), by constructor <;> norm_num, ?_⟩
        simp [AffineMap.lineMap_apply_module]
      have hz_eq : (0 : E) = z := (hz_extreme 0 K.zero_mem ((2 : 𝕜) • z) h2z hz_seg).1
      exact (hz0 hz_eq.symm).elim
  have hdirections :
      ray ((K : Set E).exposedDirections 𝕜) ⊆ 0⁺[𝕜] (L : Set E) := by
    intro y hy
    rcases (mem_ray_iff ((K : Set E).exposedDirections 𝕜) y).mp hy with
        rfl | ⟨hy0, hr⟩
    · rw [Set.mem_recessionCone_iff]
      intro x hx a ha
      simpa using hx
    · have hExposedRay :
          IsExposedRay (K : ConvexCone 𝕜 E) (originRay (rayOfNeZero 𝕜 y hy0)) := by
        have hExposedDir :
            (K : ConvexCone 𝕜 E).IsExposedRay (rayOfNeZero 𝕜 y hy0) := by
          simpa [recessionConeCone_eq_toConvexCone K] using
            hK_convex.isExposedRay_recessionCone_of_mem_exposedDirections hK_closed hr
        exact (isExposedRay_originRay_iff (K := (K : ConvexCone 𝕜 E))
          (r := rayOfNeZero 𝕜 y hy0)).2 hExposedDir
      rcases hT_exposed hExposedRay with ⟨x, hxT, hx0, hxray⟩
      have hy_ray : y ∈ originRay (rayOfNeZero 𝕜 y hy0) :=
        (mem_originRay_iff).2 <| Or.inr ⟨hy0, rfl⟩
      rcases (mem_originRay_iff.mp hxray) with rfl | ⟨hx0', hxy⟩
      · exact (hx0 rfl).elim
      · have hy_cone : y ∈ (cone[𝕜] T : Set E) := by
          have hx_cone :
              originRay (rayOfNeZero 𝕜 x hx0') ⊆ (cone[𝕜] T : Set E) :=
            originRay_subset_cone_of_mem hxT hx0'
          exact hx_cone <| by simpa [hxy] using hy_ray
        exact mem_recessionCone_of_mem_pointedCone <| subset_closure hy_cone
  have hmixed_subset :
      mixedConvexHull 𝕜 ((K : Set E).exposedPoints 𝕜) (ray ((K : Set E).exposedDirections 𝕜)) ⊆
        (L : Set E) :=
    mixedConvexHull_min 𝕜 L.convex hpoints hdirections
  have hK_subset_L : (K : Set E) ⊆ (L : Set E) := by
    rw [eq_closure_mixedConvexHull_exposedPoints_rayOfExposedDirections
      hK_closed hK_convex hK_not_hasAffineLine]
    simpa [L] using closure_minimal hmixed_subset isClosed_closure
  have hcone_subset : (cone[𝕜] T : Set E) ⊆ (K : Set E) := by
    have hcone_le : PointedCone.hull 𝕜 T ≤ K := Submodule.span_le.mpr hT_subset
    exact hcone_le
  have hL_subset_K : (L : Set E) ⊆ (K : Set E) := by
    simpa [L] using closure_minimal hcone_subset hK_closed
  exact le_antisymm hK_subset_L hL_subset_K

end
