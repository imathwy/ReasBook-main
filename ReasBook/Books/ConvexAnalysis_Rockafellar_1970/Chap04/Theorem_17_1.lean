import Mathlib
import ConvexAnalysis_Rockafellar_1970.Chap04.Proposition_17_0_8
import ConvexAnalysis_Rockafellar_1970.Chap04.Definition_17_0_13

-- Declarations for this item will be appended below by the statement pipeline.

section

universe u v

open Set
open scoped Rockafellar

/-!
Source/core/bridge triage:

- `source-facing`: Theorem 17.1 is Rockafellar's Carathéodory theorem for mixed hulls generated by
  points and directions. Its two atomic clauses are the bounded-cardinality mixed-combination
  criterion and the full-dimensional generalized-simplex cover of the mixed hull, organized here
  around the set-level owner `Set.fullDimensionalMixedSimplices points directions`.
- `core/canonical`: the owner abstractions already fixed in this chapter are
  `mconv[R](points | ray directions)`, the mixed-combination predicate
  `IsMixedConvexCombination`, its primitive finite-certificate form
  `IsMixedConvexCombinationWith`, the mixed affine-independence owner
  `mixedAffineIndependent`, and the mixed affine hull `maff[R](points | ray directions)`.
- `bridge/view`: the textbook generalized `d`-simplices are rendered canonically as members of
  `Set.fullDimensionalMixedSimplices points directions`, namely mixed hulls of finite
  mixed-affinely-independent families whose mixed affine hull has the same affine dimension as the
  ambient mixed hull.

Domain-style sampling used here:
- `mem_mixedConvexHull_iff_isMixedConvexCombination`;
- `exists_convex_combination_card_le_of_mem_conv`;
- `mixedAffineIndependent_iff_affineDim_eq`;
- `maff`.

Primitive data vs derived API:
- primitive inputs: the point set `points`, the direction-ray set `directions`, and the vector
  `x`;
- derived API: the bounded-cardinality mixed-combination witness, and the source-facing family
  `Set.fullDimensionalMixedSimplices points directions` of full-dimensional generalized simplices
  generated by finite subfamilies of `points` and `directions`.

Layer target: `source-facing`, expressed directly through the chapter's mixed-hull owners rather
than through a new package of finite data.
-/

variable {R : Type v} {E : Type u}
variable [Field R] [LinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E] [FiniteDimensional R E]

-- Proof sketch: combine the mixed-hull membership theorem
-- `mem_mixedConvexHull_iff_isMixedConvexCombination` with the finite-dimensional
-- Carathéodory bound from Theorem 17.0.3 after passing to the lifted cone description of
-- Proposition 17.0.10.
/-- Theorem 17.1 (1): a vector belongs to the mixed convex hull generated by `points` and
`directions` if and only if it is a mixed convex combination using at most
`Module.finrank R E + 1` total entries from those points and directions. This is the mixed
points-and-directions form of Carathéodory's theorem. -/
theorem mem_mixedConvexHull_iff_exists_isMixedConvexCombination_card_le
    (points : Set E) (directions : Set (Module.Ray R E)) (x : E) :
    x ∈ mconv[R](points | ray directions) ↔
      ∃ (ι κ : Type u), ∃ (_ : Fintype ι) (_ : Fintype κ),
        Fintype.card ι + Fintype.card κ ≤ Module.finrank R E + 1 ∧
          IsMixedConvexCombinationWith R points (ray directions) x ι κ := sorry

namespace Set

/-- The family of full-dimensional generalized simplices generated by finite subfamilies of
`points` and `directions`. Each member is the mixed convex hull of a mixed-affinely-independent
finite family drawn from the original generators whose mixed affine hull has the same affine
dimension as the ambient mixed affine hull. -/
def fullDimensionalMixedSimplices
    (points : Set E) (directions : Set (Module.Ray R E)) : Set (Set E) :=
  {s | ∃ (ι κ : Type u), ∃ (_ : Fintype ι) (_ : Fintype κ),
      ∃ pts : ι → E, ∃ dirs : κ → E,
      range pts ⊆ points ∧
      range dirs ⊆ ray directions ∧
      maffind[R](pts | dirs) ∧
      (maff[R](range pts | range dirs)).affineDim =
        (maff[R](points | ray directions)).affineDim ∧
      s = mconv[R](range pts | range dirs)}

/-- Unfolding the generalized-simplex owner gives the finite-family mixed-hull witness data used
in Definition 17.0.13. -/
theorem mem_fullDimensionalMixedSimplices_iff
    {points : Set E} {directions : Set (Module.Ray R E)} {s : Set E} :
    s ∈ fullDimensionalMixedSimplices points directions ↔
      ∃ (ι κ : Type u), ∃ (_ : Fintype ι) (_ : Fintype κ),
        ∃ pts : ι → E, ∃ dirs : κ → E,
        range pts ⊆ points ∧
        range dirs ⊆ ray directions ∧
        maffind[R](pts | dirs) ∧
        (maff[R](range pts | range dirs)).affineDim =
          (maff[R](points | ray directions)).affineDim ∧
        s = mconv[R](range pts | range dirs) :=
by
  constructor <;> intro hs
  · simpa [fullDimensionalMixedSimplices] using hs
  · simpa [fullDimensionalMixedSimplices] using hs

end Set

-- Proof sketch: for `⊆`, apply the bounded-cardinality clause above and then discard dependent
-- generators until the remaining finite family is mixed affinely independent, using
-- `mixedAffineIndependent_iff_affineDim_eq` to read the resulting generalized simplex as
-- `d`-dimensional with `d = (maff[R](points | ray directions)).affineDim`. For `⊇`, each
-- member of `Set.fullDimensionalMixedSimplices points directions` is built from generators
-- already lying in `points` and `ray directions`, so `mixedConvexHull_min` places it inside the
-- ambient mixed hull.
/-- Theorem 17.1 (2): the mixed convex hull generated by `points` and `directions` is the union
of all generalized simplices of affine dimension
`(maff[R](points | ray directions)).affineDim` generated by finite subfamilies of
`points` and `directions`; equivalently, it is the union of the source-facing family
`Set.fullDimensionalMixedSimplices points directions` of full-dimensional mixed hulls coming from
mixed-affinely-independent finite families drawn from the original generators. -/
theorem mixedConvexHull_eq_sUnion_fullDimensionalMixedSimplices
    (points : Set E) (directions : Set (Module.Ray R E)) :
    mconv[R](points | ray directions) =
      ⋃₀ Set.fullDimensionalMixedSimplices points directions := sorry

end
