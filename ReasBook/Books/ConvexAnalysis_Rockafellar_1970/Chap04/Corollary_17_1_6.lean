import Mathlib
import ConvexAnalysis_Rockafellar_1970.Chap01.Text_5_4_7

-- Declarations for this item will be appended below by the statement pipeline.

section

open scoped BigOperators

universe u v

namespace Function

variable {R : Type v} {E : Type u}
variable [Field R] [ConditionallyCompleteLinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E] [FiniteDimensional R E]

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 17.1.6 gives the value formula for the positively homogeneous convex
  function generated by an arbitrary function `f`, at a nonzero vector `x`, in terms of conic
  combinations with at most `n` generators.
- `core/canonical`: the owner abstraction already fixed earlier in the project is
  `Function.sublinearHull f`, the positively homogeneous convex function generated by `f`.
- `bridge/view`: `Function.sublinearHull_eq_sInf_verticalHeights` rewrites the value of
  `sublinearHull f` as an
  infimum over heights in the generated epigraph cone, and Corollary 17.1.2 supplies the
  Carathéodory reduction from arbitrary conic combinations to ones with at most
  `Module.finrank R E` generators and, in the refined form, linearly independent generators.

Domain-style sampling used here:
- `Function.sublinearHull`;
- `Function.sublinearHull_eq_sInf_verticalHeights`;
- `PointedCone.mem_hull_set`;
- `exists_linearIndependent_positiveCombination_of_ne_zero_mem_cone_iUnion`.

Primitive data vs derived API:
- primitive inputs: the function `f` and the nonzero vector `x`;
- derived output: the infimum formula for `sublinearHull f x`, first over arbitrary nonnegative
  conic representations, then over linearly independent positive ones.
- ambient minimization: neither theorem uses topology, norm, inner product, or any genuinely
  real-specific structure, so the source-facing statements live over the weakest shared scalar
  layer required by the reused owner API and the Chapter 17 Carathéodory reduction:
  an ordered field `R` with conditional completeness.

Layer target: `source-facing`, stated directly for the canonical owner `sublinearHull` rather than
through a surrogate package of coefficient data.
-/

-- Proof sketch: rewrite `sublinearHull f x` with
-- `Function.sublinearHull_eq_sInf_verticalHeights`, so the value is
-- the infimum of the heights `μ` for which `(x, μ)` lies in the cone generated by `epi f`.
-- Expand conic-hull membership with `PointedCone.mem_hull_set`, combine duplicate support
-- points, and project to the first and second coordinates to obtain the displayed finite-support
-- weighted-sum formula.
-- Corollary 17.1.2 gives the Carathéodory bound reducing the number of generators to at most
-- `Module.finrank R E`.
/-- Corollary 17.1.6: for a nonzero vector `x`, the positively homogeneous convex function
generated by `f`, represented canonically by `sublinearHull f`, equals the infimum of the weighted
sums `∑ λᵢ f(xᵢ)` over all finite-support nonnegative linear combinations of `x` with support
cardinality at most `Module.finrank R E`. Specializing to `R = ℝ` and `E = Fin n → ℝ` recovers
the textbook `R^n`
formula with `n` vectors; equivalently, this is the function generated by `conv(f)`. -/
theorem sublinearHull_eq_sInf_nonnegativeCombination_values_of_ne_zero
    (f : E → WithBotTop R) (x : E) (hx : x ≠ 0) :
    sublinearHull f x =
      sInf {r : WithBotTop R |
          ∃ s : Finset E, s.card ≤ Module.finrank R E ∧
            ∃ a : s → R,
              (∀ y : s, 0 ≤ a y) ∧
                x = ∑ y : s, a y • (y : E) ∧
                  r = ∑ y : s, (a y : WithBotTop R) * f (y : E)} := sorry

-- Proof sketch: start from the nonnegative conic-combination formula above and delete the
-- zero-coefficient generators; the remaining generators have strictly positive coefficients and
-- still represent the same point and value. Applying Corollary 17.1.2 to the projected epigraph
-- generators then yields a representation by at most `Module.finrank R E` linearly independent
-- vectors, and taking the infimum over those reduced witnesses leaves the value unchanged.
/-- The same conic value formula for `sublinearHull f x` may be restricted to linearly independent
generators with strictly positive coefficients. -/
theorem sublinearHull_eq_sInf_linearIndependent_positiveCombination_values_of_ne_zero
    (f : E → WithBotTop R) (x : E) (hx : x ≠ 0) :
    sublinearHull f x =
      sInf {r : WithBotTop R |
          ∃ s : Finset E, s.card ≤ Module.finrank R E ∧
            LinearIndependent R ((↑) : s → E) ∧
            ∃ a : s → R,
              (∀ y : s, 0 < a y) ∧
                x = ∑ y : s, a y • (y : E) ∧
                  r = ∑ y : s, (a y : WithBotTop R) * f (y : E)} := sorry

end Function

end
