section

variable (k : Type v) {V : Type u} {P : Type w}
variable [Ring k] [AddCommGroup V] [Module k V] [AddTorsor V P]

/-!
Source/core/bridge triage for this item.

- `source-facing`: Definition 17.0.12 introduces the mixed affine hull generated by a set of
  points and a set of recession directions.
- `core/canonical`: the owner lives at the intrinsic affine-space layer as `affineSpan` of
  `span directions +ᵥ points`.
- `source-facing owner`: this owner is surfaced in textbook form as
  `maff[k](points | directions)`.
- `bridge/view`: source phrasing with recession cones is kept as a theorem-level bridge from the
  intrinsic direction-owner statement.

Domain-style sampling used here:
- mathlib's affine-span owner API `affineSpan`, `subset_affineSpan`, `affineSpan_le_of_subset_coe`,
  and `affineSpan_eq_bot`;
- the submodule owner API `Submodule.span`, `Submodule.subset_span`, and `Submodule.span_le`;
- the affine recession bridge `AffineSubspace.recessionCone_eq_direction`.

Primitive data vs derived API:
- primitive source-facing data: the point set `points` and the direction set `directions`;
- derived API: `mixedAffineHull` and intrinsic containment/direction/minimality theorems, plus the
  recession-cone bridge.

Layer target: `source-facing`.
-/

/-- Definition 17.0.12: the mixed affine hull generated by points `points` and directions
`directions` is the affine span of all translates `v +ᵥ x` with `x ∈ points` and
`v ∈ span directions`. The scalar type is an explicit owner parameter, since it cannot be
recovered from the point/direction sets alone. -/
def mixedAffineHull (points : Set P) (directions : Set V) : AffineSubspace k P :=
  affineSpan k ((Submodule.span k directions : Set V) +ᵥ points)

/-- Textbook notation for the mixed affine hull generated by points and directions. -/
scoped[Rockafellar] notation3:max "maff[" k "](" points " | " directions ")" =>
  mixedAffineHull k points directions

-- Proof sketch: every point `x ∈ points` is the translate `0 +ᵥ x`, and `0 ∈ span directions`.
/-- The point set lies in its mixed affine hull. -/
theorem subset_mixedAffineHull (points : Set P) (directions : Set V) :
    points ⊆ (maff[k](points | directions) : Set P) := by
  intro x hx
  refine subset_affineSpan k ((Submodule.span k directions : Set V) +ᵥ points) ?_
  exact Set.mem_vadd.mpr ⟨0, by simp, x, hx, by simp⟩

-- Proof sketch: fix one base point in `points`; then `x` and `y +ᵥ x` both lie in the mixed affine
-- hull for each `y ∈ directions`, so `y = (y +ᵥ x) -ᵥ x` lies in the direction submodule.
/-- If the point set is nonempty, every listed direction lies in the direction submodule of the
mixed affine hull. -/
theorem directions_subset_direction_mixedAffineHull
    {points : Set P} {directions : Set V} (h_points : points.Nonempty) :
    directions ⊆ (maff[k](points | directions)).direction := by
  rcases h_points with ⟨x, hx⟩
  intro y hy
  have hx_hull : x ∈ (maff[k](points | directions) : Set P) :=
    subset_mixedAffineHull k points directions hx
  have hxy_hull : y +ᵥ x ∈ (maff[k](points | directions) : Set P) := by
    refine subset_affineSpan k ((Submodule.span k directions : Set V) +ᵥ points) ?_
    exact Set.mem_vadd.mpr ⟨y, Submodule.subset_span hy, x, hx, rfl⟩
  have hy_dir : (y +ᵥ x) -ᵥ x ∈ (maff[k](points | directions)).direction :=
    (maff[k](points | directions)).vsub_mem_direction hxy_hull hx_hull
  simpa using hy_dir

-- Proof sketch: if the point set is nonempty, every generator direction lies in the mixed-hull
-- direction submodule, hence so does their linear span.
theorem span_directions_le_direction_mixedAffineHull
    {points : Set P} {directions : Set V} (h_points : points.Nonempty) :
    Submodule.span k directions ≤ (maff[k](points | directions)).direction := by
  refine Submodule.span_le.mpr ?_
  exact directions_subset_direction_mixedAffineHull k
    (points := points) (directions := directions) h_points

-- Proof sketch: every generator `v +ᵥ x` with `x ∈ points` and `v ∈ span directions` lies in `A`
-- if `A` contains `points` and its direction submodule contains `span directions`; `affineSpan` is
-- then the least affine subspace containing those generators.
/-- Canonical minimality form: the mixed affine hull is the smallest affine set containing
`points` and whose direction submodule contains `span directions`. -/
theorem mixedAffineHull_le_of_span_le {points : Set P} {directions : Set V}
    {A : AffineSubspace k P}
    (h_points : points ⊆ (A : Set P))
    (h_directions : Submodule.span k directions ≤ A.direction) :
    maff[k](points | directions) ≤ A := by
  rw [mixedAffineHull, affineSpan_le]
  intro z hz
  rcases Set.mem_vadd.mp hz with ⟨v, hv, x, hx, rfl⟩
  have hxA : x ∈ (A : Set P) := h_points hx
  have hvA : v ∈ A.direction := h_directions hv
  exact A.vadd_mem_of_mem_direction hvA hxA

/-- Source-facing minimality form: the mixed affine hull is the smallest affine set containing
`points` and whose direction submodule contains the listed `directions`. -/
theorem mixedAffineHull_le {points : Set P} {directions : Set V} {A : AffineSubspace k P}
    (h_points : points ⊆ (A : Set P))
    (h_directions : directions ⊆ A.direction) :
    maff[k](points | directions) ≤ A := by
  exact mixedAffineHull_le_of_span_le k h_points (Submodule.span_le.mpr h_directions)

-- Proof sketch: if `points = ∅`, then there are no translates `v +ᵥ x`, so the spanning set is
-- empty and its affine span is `⊥`.
/-- If there are no points, then the mixed affine hull is empty. -/
theorem mixedAffineHull_empty_points (directions : Set V) :
    maff[k]((∅ : Set P) | directions) = ⊥ := by
  rw [mixedAffineHull, Set.vadd_empty, affineSpan_eq_bot]

/-- The mixed affine hull is empty exactly when the point set is empty. -/
theorem mixedAffineHull_eq_bot_iff_points_eq_empty
    (points : Set P) (directions : Set V) :
    maff[k](points | directions) = ⊥ ↔ points = ∅ := by
  constructor
  · intro h_bot
    by_contra h_points
    rcases Set.nonempty_iff_ne_empty.mpr h_points with ⟨x, hx⟩
    have hx_hull : x ∈ (maff[k](points | directions) : Set P) :=
      subset_mixedAffineHull k points directions hx
    simp [h_bot] at hx_hull
  · intro h_points
    rcases h_points with rfl
    exact mixedAffineHull_empty_points (k := k) (P := P) directions

end

section RecessionBridge

variable (k : Type v) {E : Type u}
variable [Ring k] [LE k] [ZeroLEOneClass k]
variable [AddCommGroup E] [Module k E]

-- Proof sketch: if `points` is nonempty, use
-- `AffineSubspace.recessionCone_eq_direction` and the intrinsic span-direction theorem above. If
-- `points = ∅`, then the mixed affine hull is `⊥ = ∅` and its recession cone is `univ`.
/-- Canonical recession-bridge form: the span of listed directions is contained in the recession
cone of the mixed affine hull. -/
theorem span_directions_subset_recessionCone_mixedAffineHull
    (points directions : Set E) :
    (Submodule.span k directions : Set E) ⊆ 0⁺[k] (maff[k](points | directions)) := by
  by_cases h_points : points.Nonempty
  · have h_nonempty : Nonempty (maff[k](points | directions)) :=
      ⟨⟨h_points.choose,
        subset_mixedAffineHull k points directions h_points.choose_spec⟩⟩
    letI : Nonempty (maff[k](points | directions)) := h_nonempty
    intro y hy
    rw [(maff[k](points | directions)).recessionCone_eq_direction]
    exact span_directions_le_direction_mixedAffineHull k
      (points := points) (directions := directions) h_points hy
  · have h_points_empty : points = ∅ := Set.not_nonempty_iff_eq_empty.mp h_points
    intro y hy
    have h_bot : maff[k](points | directions) = ⊥ := by
      rw [mixedAffineHull_eq_bot_iff_points_eq_empty (k := k) (P := E)
        (points := points) (directions := directions)]
      exact h_points_empty
    simp [h_bot]

/-- Every listed direction is a recession direction of the mixed affine hull. This is the
source-facing recession-cone bridge from the intrinsic span-level owner API. -/
theorem directions_subset_recessionCone_mixedAffineHull
    (points directions : Set E) :
    directions ⊆ 0⁺[k] (maff[k](points | directions)) := by
  intro y hy
  exact span_directions_subset_recessionCone_mixedAffineHull k points directions
    (Submodule.subset_span hy)

end RecessionBridge
