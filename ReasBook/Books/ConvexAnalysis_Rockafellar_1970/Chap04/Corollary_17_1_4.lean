/-!
Source/core/bridge triage:

- `source-facing`: Corollary 17.1.4 gives the Carathéodory-reduced conic value formula for the
  greatest positively homogeneous convex minorant of a family of convex functions.
- `core/canonical`: the owner abstractions already fixed earlier are the family convex hull
  `conv(⨅ i, f i)` and the positively homogeneous convex hull `sublinearHull`.
- `bridge/view`: Corollary 17.1.3 supplies the affine-independent family convex-hull formula, and
  Corollary 17.1.6 supplies the linearly independent conic reduction for `sublinearHull`; the
  theorem below states their combined source-facing consequence directly on the canonical owner
  `sublinearHull (conv(⨅ i, f i))`.
- Primitive data vs derived API:
  the primitive inputs are the family `f` and the nonzero vector `x`; the bounded support,
  positive coefficients, chosen points, and linear independence are derived witness data.
- Redundant-source-assumption audit:
  as in Corollary 17.1.3, the essential epigraph-side exclusion is the pointwise condition
  `∀ i x, ⊥ < f i x`; the nonempty-domain part of `Function.IsProper` is recorded only in the
  thin companion theorem below.
- Layer target: `source-facing`, but organized around the canonical chapter owners
  `conv(·)` and `sublinearHull`.
-/

namespace Function

variable {E : Type u} {I : Type v} {R : Type w}
variable [Field R] [ConditionallyCompleteLinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E] [FiniteDimensional R E]

local instance instSMulWithTopBot1714 : SMul R (WithTopBot R) where
  smul c x :=
    match x with
    | ⊥ => ⊥
    | (a : R) => (c * a : R)
    | ⊤ => ⊤

-- Proof sketch: apply Corollary 17.1.6 to the single function `conv(⨅ i, f i)`, so the value at
-- a nonzero `x` is an infimum over linearly independent positive conic representations whose
-- costs are computed with `conv(⨅ i, f i)`. Then use Corollary 17.1.3 on each participating
-- evaluation of `conv(⨅ i, f i)` to refine those costs to values of the original family members
-- `f i` at affinely independent epigraph points, and flatten the resulting finite data into one
-- support indexed by a `Finset I`.
/-- Corollary 17.1.4: if `fᵢ`, `i ∈ I`, are convex `[-∞, +∞]`-valued functions and never take the
value `⊥`, then the positively homogeneous convex function generated by their convex hull,
represented canonically by `sublinearHull (conv (⨅ i, f i))`, has at each nonzero `x` the
Carathéodory-reduced conic value formula
`inf {∑ λⱼ f_{iⱼ}(xⱼ) | x = ∑ λⱼ xⱼ}` over supports of size at most `Module.finrank R E`, with
strictly positive coefficients and linearly independent support vectors. Recording only the
nonzero coefficients via a finite support `s : Finset I` matches the textbook phrase “at most
`n` coefficients are nonzero”. The properness-form textbook statement is recovered by the
companion theorem below. -/
theorem sublinearHull_convexHull_iInf_eq_sInf_linearIndependent_positiveCombination_values_of_ne_zero
    (f : I → E → WithTopBot R)
    (hf_convex : ∀ i : I, ConvexOn R Set.univ (f i))
    (hf_bot : ∀ i x, ⊥ < f i x)
    (x : E) (hx : x ≠ 0) :
    sublinearHull (conv(⨅ i, f i)) x =
      sInf
        {r : WithTopBot R |
          ∃ s : Finset I, s.card ≤ Module.finrank R E ∧
            ∃ z : (i : s) → E,
              LinearIndependent R z ∧
                ∃ a : s → R,
                  (∀ i : s, 0 < a i) ∧
                    x = ∑ i : s, a i • z i ∧
                      r = ∑ i : s, (a i : WithTopBot R) * f i (z i)} := sorry

-- Proof sketch: the main theorem only needs the pointwise exclusion `∀ i x, ⊥ < f i x`; a
-- properness hypothesis provides exactly that exclusion through `Function.IsProper.bot_lt`, so the
-- properness-form source statement is the direct specialization of the owner theorem above.
/-- Properness-form restatement of the Corollary 17.1.4 value formula. This companion adds no new
mathematics beyond replacing the owner-side hypothesis `∀ i x, ⊥ < f i x` by the textbook
assumption that each `f i` is proper. -/
theorem
    sublinearHull_convexHull_iInf_eq_sInf_linearIndependent_positiveCombination_values_of_ne_zero_of_proper
    (f : I → E → WithTopBot R)
    (hf_convex : ∀ i : I, ConvexOn R Set.univ (f i))
    (hf_proper : ∀ i : I, (f i).IsProper)
    (x : E) (hx : x ≠ 0) :
    sublinearHull (conv(⨅ i, f i)) x =
      sInf
        {r : WithTopBot R |
          ∃ s : Finset I, s.card ≤ Module.finrank R E ∧
            ∃ z : (i : s) → E,
              LinearIndependent R z ∧
                ∃ a : s → R,
                  (∀ i : s, 0 < a i) ∧
                    x = ∑ i : s, a i • z i ∧
                      r = ∑ i : s, (a i : WithTopBot R) * f i (z i)} := sorry

end Function

end
