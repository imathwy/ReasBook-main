namespace Set.IsFinitelyGeneratedConvex

variable {R : Type*} [Semifield R] [PartialOrder R] [IsStrictOrderedRing R]
  [PosMulReflectLT R]
variable {E : Type*} [AddCommMonoid E] [Module R E]

private theorem sameRay_exists_nonneg_right {x y : E} (h : SameRay R x y)
    (hy : y ≠ 0) :
    ∃ r : R, 0 ≤ r ∧ x = r • y := by
  by_cases hx : x = 0
  · exact ⟨0, le_rfl, by simp [hx]⟩
  · rcases h.exists_pos hx hy with ⟨r₁, r₂, hr₁, hr₂, hxy⟩
    refine ⟨r₁⁻¹ * r₂, mul_nonneg (inv_nonneg.mpr hr₁.le) hr₂.le, ?_⟩
    calc
      x = r₁⁻¹ • (r₁ • x) := by rw [inv_smul_smul₀ hr₁.ne']
      _ = r₁⁻¹ • (r₂ • y) := by rw [hxy]
      _ = (r₁⁻¹ * r₂) • y := by rw [mul_smul]

-- Proof sketch: unpack a finite mixed point-direction presentation of `C`. The generated cone of
-- that mixed hull is the cone generated by finitely many rays: the original direction rays and
-- the rays through the nonzero point generators. The point generators already lie in the new
-- cone, the old direction rays lie in `C` because `0 ∈ C`, and span minimality upgrades the
-- generator inclusions to equality of pointed cones.
/-- If a finitely generated convex set contains the origin, then its generated cone is again
finitely generated. -/
theorem «cone» {C : Set E} (hC : C.IsFinitelyGeneratedConvex R) (h0C : (0 : E) ∈ C) :
    (cone[R] C : Set E).IsFinitelyGeneratedConvex R := by
  classical
  rcases hC with ⟨points, directions, hpoints_finite, hdirections_finite, rfl⟩
  let pointGenerators : Set E := {x | x ∈ points ∧ x ≠ 0}
  have hpointGenerators_finite : pointGenerators.Finite :=
    hpoints_finite.subset fun _ hx ↦ hx.1
  let pointDirections : Set (Module.Ray R E) :=
    (fun x : pointGenerators ↦ rayOfNeZero R x.1 x.2.2) '' Set.univ
  have hpointDirections_finite : pointDirections.Finite := by
    letI : Fintype pointGenerators := hpointGenerators_finite.fintype
    exact (Set.toFinite (Set.univ : Set pointGenerators)).image _
  let directions' : Set (Module.Ray R E) := pointDirections ∪ directions
  have hdirections'_finite : directions'.Finite :=
    hpointDirections_finite.union hdirections_finite
  have hpoints_subset :
      points ⊆ (PointedCone.hull R (ray directions') : Set E) := by
    intro x hx
    by_cases hx0 : x = 0
    · simp [hx0]
    · have hxdir : rayOfNeZero R x hx0 ∈ pointDirections := by
        refine ⟨⟨x, ⟨hx, hx0⟩⟩, by simp, by simp⟩
      exact PointedCone.subset_hull <|
        (mem_ray_iff directions' x).2 <| Or.inr ⟨hx0, Or.inl hxdir⟩
  have hconvexHull_points_subset :
      convexHull R points ⊆ (PointedCone.hull R (ray directions') : Set E) :=
    convexHull_min hpoints_subset (PointedCone.hull R (ray directions')).convex
  have hrayDirections_subset :
      ray directions ⊆ (PointedCone.hull R (ray directions') : Set E) := by
    intro y hy
    rcases (mem_ray_iff directions y).1 hy with rfl | ⟨hy0, hydir⟩
    · exact (PointedCone.hull R (ray directions')).zero_mem
    · exact PointedCone.subset_hull <|
        (mem_ray_iff directions' y).2 <| Or.inr ⟨hy0, Or.inr hydir⟩
  have hconeDirections_subset :
      (PointedCone.hull R (ray directions) : Set E) ⊆
        (PointedCone.hull R (ray directions') : Set E) :=
    Submodule.span_le.mpr hrayDirections_subset
  have hC_subset :
      mixedConvexHull R points (ray directions) ⊆
        (PointedCone.hull R (ray directions') : Set E) := by
    rw [mixedConvexHull_eq_convexHull_add_cone (R := R) points (ray directions)]
    intro x hx
    rcases Set.mem_add.mp hx with ⟨u, hu, v, hv, rfl⟩
    exact
      (PointedCone.hull R (ray directions')).add_mem
        (hconvexHull_points_subset hu) (hconeDirections_subset hv)
  have hcone_le :
      (PointedCone.hull R (mixedConvexHull R points (ray directions)) : Set E) ⊆
        (PointedCone.hull R (ray directions') : Set E) :=
    Submodule.span_le.mpr hC_subset
  have hrayDirections'_subset :
      ray directions' ⊆ (cone[R] (mixedConvexHull R points (ray directions)) : Set E) := by
    intro y hy
    rcases (mem_ray_iff directions' y).1 hy with rfl | ⟨hy0, hydir'⟩
    · exact (cone[R] (mixedConvexHull R points (ray directions))).zero_mem
    · rcases hydir' with hyPoint | hyDirection
      · rcases hyPoint with ⟨x, -, hxy⟩
        have hsame : SameRay R y x.1 := (ray_eq_iff hy0 x.2.2).1 hxy.symm
        rcases sameRay_exists_nonneg_right (R := R) (E := E) hsame x.2.2 with ⟨a, ha, rfl⟩
        exact (cone[R] (mixedConvexHull R points (ray directions))).smul_mem ha <|
          PointedCone.subset_hull <|
            subset_mixedConvexHull R points (ray directions) x.2.1
      · have hyRecession :
          y ∈ 0⁺[R] (mixedConvexHull R points (ray directions)) :=
            directions_subset_recessionCone_mixedConvexHull R points (ray directions) <|
              (mem_ray_iff directions y).2 <| Or.inr ⟨hy0, hyDirection⟩
        have hyC : y ∈ mixedConvexHull R points (ray directions) := by
          simpa [one_smul, zero_add] using
            (Set.mem_recessionCone_iff.mp hyRecession) 0 h0C 1 zero_le_one
        exact PointedCone.subset_hull hyC
  have hcone_ge :
      (PointedCone.hull R (ray directions') : Set E) ⊆
        (PointedCone.hull R (mixedConvexHull R points (ray directions)) : Set E) :=
    Submodule.span_le.mpr hrayDirections'_subset
  have hcone_eq :
      (PointedCone.hull R (mixedConvexHull R points (ray directions)) : Set E) =
        (PointedCone.hull R (ray directions') : Set E) :=
    Set.Subset.antisymm hcone_le hcone_ge
  have howner :
      mixedConvexHull R ({0} : Set E) (ray directions') =
        (PointedCone.hull R (ray directions') : Set E) := by
    simpa using (cone_eq_mixedConvexHull_zero (ray directions')).symm
  refine ⟨{0}, directions', Set.finite_singleton 0, hdirections'_finite, ?_⟩
  calc
    (PointedCone.hull R (mixedConvexHull R points (ray directions)) : Set E) =
        (PointedCone.hull R (ray directions') : Set E) :=
      hcone_eq
    _ = mixedConvexHull R ({0} : Set E) (ray directions') := howner.symm

end Set.IsFinitelyGeneratedConvex

namespace Set.IsPolyhedral

variable {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  [TopologicalSpace 𝕜] [OrderTopology 𝕜]
variable {E : Type*} [TopologicalSpace E] [AddCommGroup E] [Module 𝕜 E]
  [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E]
  [FiniteDimensional 𝕜 E]

-- Proof sketch: move immediately to the Chapter 19 owner abstraction
-- `Set.IsFinitelyGeneratedConvex`. The previous theorem gives finite generation of `cone[𝕜] C`
-- from `0 ∈ C`, and Theorem 19.1 upgrades that owner-level statement back to polyhedrality.
/-- Corollary 19.7.1: if a polyhedral convex set `C` in a finite-dimensional
topological `𝕜`-module contains the origin, then the convex cone generated by `C`,
written as `cone[𝕜] C`, is
polyhedral convex. -/
theorem «cone» {C : Set E} (hC : C.IsPolyhedral 𝕜)
    (h0C : (0 : E) ∈ C) : (cone[𝕜] C : Set E).IsPolyhedral 𝕜 :=
  (hC.isFinitelyGeneratedConvex.cone h0C).isPolyhedral

end Set.IsPolyhedral

end
