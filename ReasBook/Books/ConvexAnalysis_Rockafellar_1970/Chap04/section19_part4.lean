    simpa [Sx, hrepr x] using hsInf_le_obj
  have hobj_leE : ((∑ i, lam i * α i : ℝ) : EReal) ≤ (μ : EReal) := by
    exact_mod_cast hobj_le
  have hfx_le_mu : f x ≤ (μ : EReal) := le_trans hfx_le_obj hobj_leE
  exact (mem_epigraph_univ_iff (f := f)).2 hfx_le_mu

