        calc
          (((f x0).toReal : ℝ) : EReal) = f x0 := hcoe
          _ ≤ (((f x0).toReal - 1 : ℝ) : EReal) := hAllMu ((f x0).toReal - 1)
      have hleToRealReal : (f x0).toReal ≤ (f x0).toReal - 1 := by
        exact_mod_cast hleToReal
