            (n := n) (k := k) (m := m) (b := b) (β := β) (x := x) (μ := μ)
            (by simpa [g, C] using hgμ) i hi
      have hdot :
          dotProduct z
            (prodLinearEquiv_append_coord (n := n) (b i, (-1 : ℝ))) =
            (∑ j, x j * b i j) - μ := by
        calc
          dotProduct z
              (prodLinearEquiv_append_coord (n := n) (b i, (-1 : ℝ)))
