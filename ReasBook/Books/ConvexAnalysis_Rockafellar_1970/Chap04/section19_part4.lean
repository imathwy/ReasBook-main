    exact (mem_epigraph_univ_iff (f := g)).2 (by simp [g, indicatorFunction])
  refine ⟨((fun _ : Fin 1 => (-1 : ℝ)), (0 : ℝ)), ?_, rfl⟩
  exact hmemEpi

