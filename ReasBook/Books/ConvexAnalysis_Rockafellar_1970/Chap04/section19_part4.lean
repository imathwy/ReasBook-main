    · have htriv : dotProduct z (0 : Fin (n + 1) → ℝ) ≤ (0 : ℝ) := by
        simp
      simp [bDom, βDom, hki, closedHalfSpaceLE] at htriv ⊢
  · intro hz i hki
    have hzi : z ∈ closedHalfSpaceLE (n + 1) (bDom i) (βDom i) :=
