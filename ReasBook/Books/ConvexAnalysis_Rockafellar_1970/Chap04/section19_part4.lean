              (Finset.sum (Finset.univ.filter (fun i : Fin m => (i : ℕ) < k))
                (fun i => lam i)) = 1 ∧
              (∀ i, 0 ≤ lam i) ∧
              r = ((∑ i, lam i * α i : ℝ) : EReal)})
    {x : Fin n → ℝ} {μ : ℝ}
    {lam : Fin m → ℝ}
    (hlin : ∀ j, (∑ i, lam i * a i j) = x j)
    (hnorm :
      (Finset.sum (Finset.univ.filter (fun i : Fin m => (i : ℕ) < k))
        (fun i => lam i)) = 1)
    (hnonneg : ∀ i, 0 ≤ lam i)
    (hobj_le : (∑ i, lam i * α i : ℝ) ≤ μ) :
    (x, μ) ∈ epigraph (Set.univ : Set (Fin n → ℝ)) f := by
  let Sx : Set EReal :=
    {r : EReal |
      ∃ (lam : Fin m → ℝ),
        (∀ j, (∑ i, lam i * a i j) = x j) ∧
        (Finset.sum (Finset.univ.filter (fun i : Fin m => (i : ℕ) < k))
          (fun i => lam i)) = 1 ∧
