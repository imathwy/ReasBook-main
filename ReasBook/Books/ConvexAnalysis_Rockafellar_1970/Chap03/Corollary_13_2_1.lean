open scoped Rockafellar

variable {𝕜 : Type*} {X : Type u} {Y : Type v}
variable [Field 𝕜] [ConditionallyCompleteLinearOrder 𝕜] [IsOrderedAddMonoid 𝕜]
variable [TopologicalSpace 𝕜]
variable [TopologicalSpace X] [AddCommGroup X] [Module 𝕜 X] [FiniteDimensional 𝕜 X]
variable [AddCommMonoid Y] [Module 𝕜 Y]
variable [HasLinearPairing X Y 𝕜] [HasContinuousPairing X Y 𝕜]

-- Proof sketch: use the owner support-function formula for the lower-semicontinuous hull of the
-- positively homogeneous convex minorant generated by `f`, then rewrite its canonical nonpositive
-- conjugate sublevel set `{x⋆ | f⋆ x⋆ ≤ 0}` using the bridge theorem above. This keeps the
-- source-facing support set while avoiding a parallel local support-function owner.
/-- Corollary 13.2.1 in owner form: for a positively homogeneous proper convex function on a
finite-dimensional module carrying a continuous linear pairing to a dual-side space, the closure
`cl(f)` is
the support function of the canonical nonpositive conjugate sublevel set `{x⋆ | f⋆ x⋆ ≤ 0}`. -/
theorem lowerSemicontinuousHull_eq_supportFunction_nonpositiveSublevel_convexConjugate
    (f : X → WithTopBot 𝕜) (hf_hom : f.PositivelyHomogeneous 𝕜)
    (hf_convexOn : ConvexOn 𝕜 (Set.univ : Set X) f)
    (hf_proper : f.IsProper) :
    cl(f) =
      δᵛ(· | {yStar : Y | f⋆ yStar ≤ 0}) := sorry

/-- Corollary 13.2.1, in canonical ambient form: if `f` is a positively homogeneous proper convex
function on a finite-dimensional module carrying a continuous linear pairing to a dual-side space,
then its closure `cl(f)` is the support function
`δᵛ(· | {y⋆ | ∀ x, ⟪x, y⋆⟫ₚ ≤ f x})`. -/
theorem lowerSemicontinuousHull_eq_supportFunction_setOf_forall_pairing_le
    (f : X → WithTopBot 𝕜) (hf_hom : f.PositivelyHomogeneous 𝕜)
    (hf_convexOn : ConvexOn 𝕜 (Set.univ : Set X) f)
    (hf_proper : f.IsProper) :
    cl(f) =
      δᵛ(· | {yStar : Y | ∀ x : X, ⟪x, yStar⟫ₚ ≤ f x}) := by
  have hmain :
      cl(f) = δᵛ(· | {yStar : Y | f⋆ yStar ≤ 0}) :=
    lowerSemicontinuousHull_eq_supportFunction_nonpositiveSublevel_convexConjugate
      f hf_hom hf_convexOn hf_proper
  simpa [nonpositiveSublevel_convexConjugate_eq_setOf_forall_pairing_le (f := f)] using hmain

end
