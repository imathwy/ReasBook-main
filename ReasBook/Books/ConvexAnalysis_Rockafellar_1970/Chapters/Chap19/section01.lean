/-! ### Corollary_19_1_1 (from Chap04) -/
section

open scoped Rockafellar

variable {K : Type*} [CommSemiring K] [PartialOrder K] [IsStrictOrderedRing K]
variable {E : Type*} [AddCommMonoid E] [Module K E]

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 19.1.1 uses finite mixed generators and concludes that only finitely
  many extreme points and extreme directions occur.
- `core/canonical`: the owner predicates and sets are `C.IsFinitelyGeneratedConvex K`,
  `C.extremePoints K`, and `C.extremeDirections K`.
- `bridge/view`: unpack finite mixed generators, then apply
  `extremePoints_subset_of_generators` and `extremeDirections_subset_of_generators` to place
  extreme-owner sets in finite generating families.

Domain-style sampling used here:
- `Set.IsFinitelyGeneratedConvex`;
- `extremePoints_subset_of_generators`;
- `extremeDirections_subset_of_generators`;
- `Set.Finite`.

Primitive data vs derived API:
- primitive input: finite mixed generating data for `C`;
- primitive bridge input for extreme points: `extremePoints_subset_of_generators`;
- extra primitive bridge input for extreme directions: preservation of boundedness by
  `convexHull K` and unboundedness of affine half-lines;
- derived API: finiteness of `C.extremePoints K` and `C.extremeDirections K`, with each theorem
  carrying only the assumptions required for its own owner.

Layer target: `source-facing`, attached directly to the primitive owner
`Set.IsFinitelyGeneratedConvex`.

Ambient refinement:
- the extreme-point owner consequence is already available at the weaker ordered-semiring module
  layer via `extremePoints_subset_of_generators`;
- only the extreme-direction owner consequence needs the bornological boundedness bridges from
  `Text_18_5_1`;
- this file therefore splits theorem surfaces by owner needs instead of forcing the stronger
  direction assumptions onto the point theorem.
-/

namespace Set

/-- Primitive extreme-point finiteness bridge: if `C` is a mixed convex hull generated by a finite
point set, then `C` has only finitely many extreme points. -/
-- Proof sketch: `extremePoints_subset_of_generators` puts `C.extremePoints K` inside the finite
-- point-generator set.
theorem finite_extremePoints_of_eq_mixedConvexHull
    {C points : Set E} {directions : Set (Module.Ray K E)}
    (hpoints_finite : points.Finite)
    (hC : C = mconv[K](points | ray directions)) :
    (C.extremePoints K).Finite := by
  have hsubset : C.extremePoints K ⊆ points :=
    extremePoints_subset_of_generators hC
  exact hpoints_finite.subset hsubset

end Set

namespace Set.IsFinitelyGeneratedConvex

/-- A finitely generated convex set has only finitely many extreme points. -/
-- Proof sketch: unpack finite mixed generators for `C`; each extreme point belongs to the point
-- generator set by `extremePoints_subset_of_generators`, so finiteness follows by
-- subset of a finite set.
theorem finite_extremePoints
    {C : Set E} (hC : C.IsFinitelyGeneratedConvex K) :
    (C.extremePoints K).Finite := by
  rcases hC with ⟨points, directions, hpoints_finite, _, hC_eq⟩
  exact Set.finite_extremePoints_of_eq_mixedConvexHull hpoints_finite hC_eq

end Set.IsFinitelyGeneratedConvex

end

section

open Bornology Set

open scoped Rockafellar

variable {K : Type*} [CommSemiring K] [PartialOrder K] [IsStrictOrderedRing K]
variable {E : Type*} [Bornology E] [AddCancelCommMonoid E] [Module K E]

namespace Set

/-- Primitive extreme-direction finiteness bridge: if `C` is generated by a bounded point set and
a finite direction-ray set, then `C` has only finitely many extreme directions. -/
-- Proof sketch: `extremeDirections_subset_of_generators` puts `C.extremeDirections K` inside the
-- finite direction-generator set, using the boundedness bridge for point-generator intersections
-- with affine half-lines.
theorem finite_extremeDirections_of_eq_mixedConvexHull
    {C points : Set E} {directions : Set (Module.Ray K E)}
    (hpoints_bounded : IsBounded points) (hdirections_finite : directions.Finite)
    (hbounded_convexHull :
      ∀ {s : Set E}, IsBounded s → IsBounded (convexHull K s))
    (hnot_isBounded_affineHalfLine :
      ∀ (x : E) (r : Module.Ray K E), ¬ IsBounded (affineHalfLine x r))
    (hC : C = mconv[K](points | ray directions)) :
    (C.extremeDirections K).Finite := by
  have hsubset : C.extremeDirections K ⊆ directions :=
    extremeDirections_subset_of_generators
      hC hbounded_convexHull hnot_isBounded_affineHalfLine <| by
      intro x r _
      exact hpoints_bounded.subset
        (inter_subset_left : points ∩ affineHalfLine x r ⊆ points)
  exact hdirections_finite.subset hsubset

end Set

namespace Set.IsFinitelyGeneratedConvex

/-- A finitely generated convex set has only finitely many extreme directions. -/
-- Proof sketch: unpack finite mixed generators for `C` and apply the primitive bridge theorem
-- `Set.finite_extremeDirections_of_eq_mixedConvexHull`.
theorem finite_extremeDirections
    {C : Set E} (hC : C.IsFinitelyGeneratedConvex K)
    (hbounded_convexHull :
      ∀ {s : Set E}, IsBounded s → IsBounded (convexHull K s))
    (hnot_isBounded_affineHalfLine :
      ∀ (x : E) (r : Module.Ray K E), ¬ IsBounded (affineHalfLine x r)) :
    (C.extremeDirections K).Finite := by
  rcases hC with ⟨points, directions, hpoints_finite, hdirections_finite, hC_eq⟩
  exact Set.finite_extremeDirections_of_eq_mixedConvexHull
    hpoints_finite.isBounded hdirections_finite
    hbounded_convexHull hnot_isBounded_affineHalfLine hC_eq

/-- Corollary 19.1.1: a finitely generated convex set has only finitely many extreme points and
extreme directions. -/
-- Proof sketch: combine the owner-level consequences
-- `hC.finite_extremePoints` and `hC.finite_extremeDirections`.
theorem finite_extremePoints_and_extremeDirections
    {C : Set E} (hC : C.IsFinitelyGeneratedConvex K)
    (hbounded_convexHull :
      ∀ {s : Set E}, IsBounded s → IsBounded (convexHull K s))
    (hnot_isBounded_affineHalfLine :
      ∀ (x : E) (r : Module.Ray K E), ¬ IsBounded (affineHalfLine x r)) :
    (C.extremePoints K).Finite ∧ (C.extremeDirections K).Finite :=
  ⟨hC.finite_extremePoints,
    hC.finite_extremeDirections hbounded_convexHull hnot_isBounded_affineHalfLine⟩

end Set.IsFinitelyGeneratedConvex

end

/-! ### Theorem_19_1 (from Chap04) -/
section

open scoped Rockafellar

variable {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  [TopologicalSpace 𝕜] [OrderTopology 𝕜]
variable {E : Type*} [TopologicalSpace E] [AddCommGroup E] [Module 𝕜 E]
  [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E] [FiniteDimensional 𝕜 E]

/-!
Source/core/bridge triage for the main item:

  finite-dimensional topological module over a linearly ordered topological field:
  polyhedrality, closedness with finitely many faces, and finite generation by points and
  directions.
- `core/canonical`: the owner predicates already present in the project are
  `Set.IsPolyhedral`, `Set.IsFace.faces` (notation `𝓕[𝕜](C)`),
  `Set.IsFinitelyGeneratedConvex`, and `List.TFAE`.
- `bridge/view`: no extra bridge owner is introduced for "finite faces"; the clause is stated
  directly as finiteness of the canonical face family `(𝓕[𝕜](C)).Finite`.

Domain-style sampling used here:
- `Set.IsPolyhedral`;
- `Set.IsFace`;
- `Set.IsFace.trans`;
- `Set.IsFinitelyGeneratedConvex`;
- `List.TFAE`.

Primitive data vs derived API:
- primitive input: the set `C`;
- derived API: the three equivalent structural descriptions of `C`, with convexity carried in the
  middle owner clause rather than as an external theorem argument.

Layer target: `source-facing`, stated directly in terms of the chapter's existing owner predicates
for polyhedrality, faces, and mixed finite generation.

Ambient refinement: the owner predicates `Set.IsPolyhedral`, `Set.IsFace`, and
`Set.IsFinitelyGeneratedConvex` are already coordinate-free, and the nearby Chapter 18 face theory
has already been lifted from `EuclideanSpace ℝ (Fin n)` to arbitrary finite-dimensional ambient
spaces. The source `R^n` model is therefore a presentation, not the owner level, so the public
theorem is stated directly on that finite-dimensional topological owner layer and uses the same
ordered topological field scalar assumptions as the Chapter 18 bridge surface rather than a
normed/completeness specialization.
-/

namespace Set.IsPolyhedral

/-- Theorem 19.1 in canonical owner form: for `C` in a finite-dimensional topological `𝕜`-module,
polyhedrality, convexity+closedness with finite face family `(𝓕[𝕜](C)).Finite`, and finite
generation by points and directions are equivalent. -/
-- Proof sketch: prove `(a) → (b)` by showing every face of a polyhedral set arises from one of
-- finitely many choices of ambient half-spaces versus boundary hyperplanes, so only finitely many
-- faces can occur. For `(b) → (c)`, first treat the pointed case using Theorem 18.5 to generate
-- `C` from its extreme points and extreme directions, both finite because there are only finitely
-- many faces; then split off the lineality space in the general case. For `(c) → (b)`, apply
-- Caratheodory's theorem to cover `C` by finitely many generalized simplices, obtaining
-- closedness and finiteness of faces from the finite generating family. Finally, `(b) → (a)`
-- follows because an `n`-dimensional closed convex set is the intersection of its tangent closed
-- half-spaces, and each tangent half-space corresponds to an exposed face; finitely many faces
-- therefore give finitely many tangent half-spaces.
theorem tfae {C : Set E} :
    List.TFAE
      [ C.IsPolyhedral 𝕜,
        Convex 𝕜 C ∧ IsClosed C ∧ (𝓕[𝕜](C)).Finite,
        C.IsFinitelyGeneratedConvex 𝕜 ] := sorry

/-- Polyhedrality is equivalent to convexity together with closedness and finiteness of faces. -/
theorem iff_convex_isClosed_finiteFaces {C : Set E} :
    C.IsPolyhedral 𝕜 ↔ Convex 𝕜 C ∧ IsClosed C ∧ (𝓕[𝕜](C)).Finite :=
  (tfae (C := C)).out 0 1

/-- Convex-input bridge: polyhedrality is equivalent to closedness and finiteness of faces. -/
theorem iff_isClosed_finiteFaces {C : Set E} (hC_convex : Convex 𝕜 C) :
    C.IsPolyhedral 𝕜 ↔ IsClosed C ∧ (𝓕[𝕜](C)).Finite := by
  constructor
  · intro hC_polyhedral
    exact (iff_convex_isClosed_finiteFaces (C := C)).1 hC_polyhedral |>.2
  · intro hC_closed_finiteFaces
    exact (iff_convex_isClosed_finiteFaces (C := C)).2
      ⟨hC_convex, hC_closed_finiteFaces⟩

/-- Polyhedrality is equivalent to finite generation by points and directions. -/
theorem iff_isFinitelyGeneratedConvex {C : Set E} :
    C.IsPolyhedral 𝕜 ↔ C.IsFinitelyGeneratedConvex 𝕜 := by
  constructor
  · intro hC_polyhedral
    exact ((tfae (C := C)).out 0 2).1
      hC_polyhedral
  · intro hC_finitely_generated
    exact ((tfae (C := C)).out 0 2).2
      hC_finitely_generated

/-- A polyhedral convex set is closed and has finitely many faces. -/
theorem isClosed_hasFiniteFaces {C : Set E} (hC : C.IsPolyhedral 𝕜) :
    IsClosed C ∧ (𝓕[𝕜](C)).Finite :=
  (iff_convex_isClosed_finiteFaces (C := C)).mp hC |>.2

/-- A polyhedral convex set is finitely
generated. -/
theorem isFinitelyGeneratedConvex {C : Set E} (hC : C.IsPolyhedral 𝕜) :
    C.IsFinitelyGeneratedConvex 𝕜 :=
  (iff_isFinitelyGeneratedConvex (C := C)).mp hC

end Set.IsPolyhedral

namespace Set.IsFinitelyGeneratedConvex

/-- A finitely generated convex set is
polyhedral convex. -/
theorem isPolyhedral {C : Set E} (hC : C.IsFinitelyGeneratedConvex 𝕜) :
    C.IsPolyhedral 𝕜 :=
  (Set.IsPolyhedral.iff_isFinitelyGeneratedConvex (C := C)).mpr hC

end Set.IsFinitelyGeneratedConvex

namespace Set.IsPolytope

/-- Every polytope is polyhedral convex. -/
theorem isPolyhedral {C : Set E} (hC : C.IsPolytope 𝕜) : C.IsPolyhedral 𝕜 :=
  hC.isFinitelyGeneratedConvex.isPolyhedral

end Set.IsPolytope

end

/-! ### Corollary_19_1_2 (from Chap04) -/
