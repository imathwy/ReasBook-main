/-! ### Corollary_19_7_1 (from Chap04) -/
section

open scoped Pointwise

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 19.7.1 says that if a polyhedral convex set `C` contains the origin,
  then the convex cone generated by `C` is again polyhedral.
- `core/canonical`: the primitive Chapter 19 owner is `Set.IsFinitelyGeneratedConvex`; the
  source-facing cone is the canonical owner `cone[𝕜] C`.
- `bridge/view`: the source-facing polyhedral corollary is obtained by first proving the weaker
  owner theorem that a finitely generated convex set containing `0` has finitely generated cone,
  then upgrading back to `Set.IsPolyhedral` through `Set.IsFinitelyGeneratedConvex.isPolyhedral`.

Domain-style sampling used here:
- `Set.IsFinitelyGeneratedConvex`;
- `mixedConvexHull_eq_convexHull_add_cone`;
- `subset_mixedConvexHull`;
- `directions_subset_recessionCone_mixedConvexHull`;
- `Set.IsPolyhedral.isFinitelyGeneratedConvex`;
- `Set.IsFinitelyGeneratedConvex.isPolyhedral`.

Primitive data vs derived API:
- primitive owner data: a finite mixed point-direction presentation of `C` together with `0 ∈ C`;
- derived owner API: a finite direction presentation of `cone[𝕜] C`;
- derived source-facing API: polyhedrality of `cone[𝕜] C` in the finite-dimensional Chapter 19
  ambient.

Layer target:
- the new owner theorem on `Set.IsFinitelyGeneratedConvex` is `core/canonical`;
- the numbered corollary remains `source-facing`.
-/

namespace Set.IsFinitelyGeneratedConvex

variable {R : Type*} [Semifield R] [PartialOrder R] [IsStrictOrderedRing R]
  [PosMulReflectLT R]
variable {E : Type*} [AddCommMonoid E] [Module R E]

private theorem sameRay_exists_nonneg_right {x y : E} (h : SameRay R x y)
    (hy : y ≠ 0) :
    ∃ r : R, 0 ≤ r ∧ x = r • y := by
  by_cases hx : x = 0
  · exact ⟨0, le_rfl, by simp [hx]⟩
  · rcases h.exists_pos hx hy with ⟨r₁, r₂, hr₁, hr₂, hxy⟩
    refine ⟨r₁⁻¹ * r₂, mul_nonneg (inv_nonneg.mpr hr₁.le) hr₂.le, ?_⟩
    calc
      x = r₁⁻¹ • (r₁ • x) := by rw [inv_smul_smul₀ hr₁.ne']
      _ = r₁⁻¹ • (r₂ • y) := by rw [hxy]
      _ = (r₁⁻¹ * r₂) • y := by rw [mul_smul]

-- Proof sketch: unpack a finite mixed point-direction presentation of `C`. The generated cone of
-- that mixed hull is the cone generated by finitely many rays: the original direction rays and
-- the rays through the nonzero point generators. The point generators already lie in the new
-- cone, the old direction rays lie in `C` because `0 ∈ C`, and span minimality upgrades the
-- generator inclusions to equality of pointed cones.
/-- If a finitely generated convex set contains the origin, then its generated cone is again
finitely generated. -/
theorem «cone» {C : Set E} (hC : C.IsFinitelyGeneratedConvex R) (h0C : (0 : E) ∈ C) :
    (cone[R] C : Set E).IsFinitelyGeneratedConvex R := by
  classical
  rcases hC with ⟨points, directions, hpoints_finite, hdirections_finite, rfl⟩
  let pointGenerators : Set E := {x | x ∈ points ∧ x ≠ 0}
  have hpointGenerators_finite : pointGenerators.Finite :=
    hpoints_finite.subset fun _ hx ↦ hx.1
  let pointDirections : Set (Module.Ray R E) :=
    (fun x : pointGenerators ↦ rayOfNeZero R x.1 x.2.2) '' Set.univ
  have hpointDirections_finite : pointDirections.Finite := by
    letI : Fintype pointGenerators := hpointGenerators_finite.fintype
    exact (Set.toFinite (Set.univ : Set pointGenerators)).image _
  let directions' : Set (Module.Ray R E) := pointDirections ∪ directions
  have hdirections'_finite : directions'.Finite :=
    hpointDirections_finite.union hdirections_finite
  have hpoints_subset :
      points ⊆ (PointedCone.hull R (ray directions') : Set E) := by
    intro x hx
    by_cases hx0 : x = 0
    · simp [hx0]
    · have hxdir : rayOfNeZero R x hx0 ∈ pointDirections := by
        refine ⟨⟨x, ⟨hx, hx0⟩⟩, by simp, by simp⟩
      exact PointedCone.subset_hull <|
        (mem_ray_iff directions' x).2 <| Or.inr ⟨hx0, Or.inl hxdir⟩
  have hconvexHull_points_subset :
      convexHull R points ⊆ (PointedCone.hull R (ray directions') : Set E) :=
    convexHull_min hpoints_subset (PointedCone.hull R (ray directions')).convex
  have hrayDirections_subset :
      ray directions ⊆ (PointedCone.hull R (ray directions') : Set E) := by
    intro y hy
    rcases (mem_ray_iff directions y).1 hy with rfl | ⟨hy0, hydir⟩
    · exact (PointedCone.hull R (ray directions')).zero_mem
    · exact PointedCone.subset_hull <|
        (mem_ray_iff directions' y).2 <| Or.inr ⟨hy0, Or.inr hydir⟩
  have hconeDirections_subset :
      (PointedCone.hull R (ray directions) : Set E) ⊆
        (PointedCone.hull R (ray directions') : Set E) :=
    Submodule.span_le.mpr hrayDirections_subset
  have hC_subset :
      mixedConvexHull R points (ray directions) ⊆
        (PointedCone.hull R (ray directions') : Set E) := by
    rw [mixedConvexHull_eq_convexHull_add_cone (R := R) points (ray directions)]
    intro x hx
    rcases Set.mem_add.mp hx with ⟨u, hu, v, hv, rfl⟩
    exact
      (PointedCone.hull R (ray directions')).add_mem
        (hconvexHull_points_subset hu) (hconeDirections_subset hv)
  have hcone_le :
      (PointedCone.hull R (mixedConvexHull R points (ray directions)) : Set E) ⊆
        (PointedCone.hull R (ray directions') : Set E) :=
    Submodule.span_le.mpr hC_subset
  have hrayDirections'_subset :
      ray directions' ⊆ (cone[R] (mixedConvexHull R points (ray directions)) : Set E) := by
    intro y hy
    rcases (mem_ray_iff directions' y).1 hy with rfl | ⟨hy0, hydir'⟩
    · exact (cone[R] (mixedConvexHull R points (ray directions))).zero_mem
    · rcases hydir' with hyPoint | hyDirection
      · rcases hyPoint with ⟨x, -, hxy⟩
        have hsame : SameRay R y x.1 := (ray_eq_iff hy0 x.2.2).1 hxy.symm
        rcases sameRay_exists_nonneg_right (R := R) (E := E) hsame x.2.2 with ⟨a, ha, rfl⟩
        exact (cone[R] (mixedConvexHull R points (ray directions))).smul_mem ha <|
          PointedCone.subset_hull <|
            subset_mixedConvexHull R points (ray directions) x.2.1
      · have hyRecession :
          y ∈ 0⁺[R] (mixedConvexHull R points (ray directions)) :=
            directions_subset_recessionCone_mixedConvexHull R points (ray directions) <|
              (mem_ray_iff directions y).2 <| Or.inr ⟨hy0, hyDirection⟩
        have hyC : y ∈ mixedConvexHull R points (ray directions) := by
          simpa [one_smul, zero_add] using
            (Set.mem_recessionCone_iff.mp hyRecession) 0 h0C 1 zero_le_one
        exact PointedCone.subset_hull hyC
  have hcone_ge :
      (PointedCone.hull R (ray directions') : Set E) ⊆
        (PointedCone.hull R (mixedConvexHull R points (ray directions)) : Set E) :=
    Submodule.span_le.mpr hrayDirections'_subset
  have hcone_eq :
      (PointedCone.hull R (mixedConvexHull R points (ray directions)) : Set E) =
        (PointedCone.hull R (ray directions') : Set E) :=
    Set.Subset.antisymm hcone_le hcone_ge
  have howner :
      mixedConvexHull R ({0} : Set E) (ray directions') =
        (PointedCone.hull R (ray directions') : Set E) := by
    simpa using (cone_eq_mixedConvexHull_zero (ray directions')).symm
  refine ⟨{0}, directions', Set.finite_singleton 0, hdirections'_finite, ?_⟩
  calc
    (PointedCone.hull R (mixedConvexHull R points (ray directions)) : Set E) =
        (PointedCone.hull R (ray directions') : Set E) :=
      hcone_eq
    _ = mixedConvexHull R ({0} : Set E) (ray directions') := howner.symm

end Set.IsFinitelyGeneratedConvex

namespace Set.IsPolyhedral

variable {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
  [TopologicalSpace 𝕜] [OrderTopology 𝕜]
variable {E : Type*} [TopologicalSpace E] [AddCommGroup E] [Module 𝕜 E]
  [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E]
  [FiniteDimensional 𝕜 E]

-- Proof sketch: move immediately to the Chapter 19 owner abstraction
-- `Set.IsFinitelyGeneratedConvex`. The previous theorem gives finite generation of `cone[𝕜] C`
-- from `0 ∈ C`, and Theorem 19.1 upgrades that owner-level statement back to polyhedrality.
/-- Corollary 19.7.1: if a polyhedral convex set `C` in a finite-dimensional
topological `𝕜`-module contains the origin, then the convex cone generated by `C`,
written as `cone[𝕜] C`, is
polyhedral convex. -/
theorem «cone» {C : Set E} (hC : C.IsPolyhedral 𝕜)
    (h0C : (0 : E) ∈ C) : (cone[𝕜] C : Set E).IsPolyhedral 𝕜 :=
  (hC.isFinitelyGeneratedConvex.cone h0C).isPolyhedral

end Set.IsPolyhedral

end

/-! ### Theorem_19_7 (from Chap04) -/
section

open scoped Pointwise
open PointedCone

/-!
Source/core/bridge triage:

- `source-facing`: Theorem 19.7 studies a nonempty polyhedral convex set `C`, the closure `K`
  of the convex cone generated by `C`, and the decomposition of `K` into positive dilates of `C`
  together with the recession cone `0⁺ C`. Clause (1) is organized first at the
  `Set.IsFinitelyGeneratedConvex` owner layer, then bridged back to `Set.IsPolyhedral`. Clause
  (2) is organized through the primitive nonnegative-ray owner surface first and then bridged to
  the source-facing positive-ray statement.
- `core/canonical`: the owner expressions already used in the project are the generated-cone
  notation `cone[𝕜] C` (raw owner `PointedCone.hull 𝕜 C`), its canonical closure
  `((cone[𝕜] C).closure : Set E)`, its intrinsic-topology companion
  `intrinsicClosure 𝕜 (cone[𝕜] C : Set E)`, the Chapter 19 core owner
  `Set.IsFinitelyGeneratedConvex`, the source-facing bridge owner `Set.IsPolyhedral`, and the
  chapter owner `0⁺[𝕜] C`.
- `bridge/view`: the textbook family `{λ C | λ > 0 or λ = 0⁺}` is rendered by the pointwise
  nonnegative/positive rays `𝕜≥0 • C` and `𝕜>0 • C` together with
  `0⁺[𝕜] C`, matching the owner-side Chapter 2 bridge for pointed-cone closures.

Domain-style sampling used here:
- `Set.IsFinitelyGeneratedConvex`;
- `Set.IsPolyhedral`;
- `PointedCone.hull`;
- `PointedCone.closure_cone_eq_nonnegativeRay_union_recessionCone`;
- `PointedCone.closure_cone_eq_positiveRay_union_recessionCone`;
- `Set.IsPolyhedral.smul`;
- `Set.IsPolyhedral.recessionCone`;
- `0⁺`.

Primitive data vs derived API:
- primitive input for the owner-level clause (1): a subset `C : Set E` and its
  finite-generation owner data `Set.IsFinitelyGeneratedConvex 𝕜`, at the weaker Chapter 19
  ambient;
- additional source-facing input for clause (2): nonemptiness of `C`, together with the stronger
  ambient needed by the Chapter 2 closure formula;
- derived outputs: finite-generation and polyhedrality of the closure of the generated cone, and
  both nonnegative-ray and positive-ray decomposition formulas for that closure, with intrinsic
  closure companion surfaces under closed-affine-span hypotheses.

Layer target: split `core/canonical` then `source-facing`, with ambient-closure and
intrinsic-closure companion surfaces stated directly on the canonical generated-cone owners
rather than a surrogate wrapper for the generated cone.
-/

namespace Set.IsFinitelyGeneratedConvex

variable {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [TopologicalSpace 𝕜] [OrderTopology 𝕜]
  [IsStrictOrderedRing 𝕜]
variable {E : Type*} [TopologicalSpace E] [AddCommGroup E] [Module 𝕜 E]
  [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E] [FiniteDimensional 𝕜 E]

-- Proof sketch: unpack finite point-direction data for `C`, homogenize those generators for
-- `cone[𝕜] C`, and show the closure preserves a finite mixed presentation in finite-dimensional
-- ambient spaces.
/-- Theorem 19.7 (1), core owner form: if `C` is finitely generated convex, then the closure of
the generated cone `cone[𝕜] C` is again finitely generated convex. -/
theorem closure_cone {C : Set E} (hC : C.IsFinitelyGeneratedConvex 𝕜) :
    ((cone[𝕜] C).closure : Set E).IsFinitelyGeneratedConvex 𝕜 := sorry

end Set.IsFinitelyGeneratedConvex

namespace Set.IsPolyhedral

variable {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [TopologicalSpace 𝕜] [OrderTopology 𝕜]
  [IsStrictOrderedRing 𝕜]
variable {E : Type*} [TopologicalSpace E] [AddCommGroup E] [Module 𝕜 E]
  [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E] [FiniteDimensional 𝕜 E]

-- Proof sketch: move from polyhedrality to the Chapter 19 core owner
-- `Set.IsFinitelyGeneratedConvex`, apply the core owner theorem, then bridge back.
/-- Theorem 19.7 (1), source-facing bridge form: if `C` is polyhedral convex, then the closure of
the generated cone `cone[𝕜] C` is polyhedral convex. -/
theorem closure_cone {C : Set E} (hC : C.IsPolyhedral 𝕜) :
    ((cone[𝕜] C).closure : Set E).IsPolyhedral 𝕜 := by
  exact hC.isFinitelyGeneratedConvex.closure_cone.isPolyhedral

end Set.IsPolyhedral

variable {𝕜 : Type*} [Field 𝕜] [LinearOrder 𝕜] [TopologicalSpace 𝕜] [OrderTopology 𝕜]
  [IsStrictOrderedRing 𝕜]
variable {E : Type*} [AddCommGroup E] [Module 𝕜 E] [TopologicalSpace E]
  [IsTopologicalAddGroup E] [ContinuousSMul 𝕜 E] [FiniteDimensional 𝕜 E]
local notation "𝕜≥0" => Set.Ici (0 : 𝕜)
local notation "𝕜>0" => Set.Ioi (0 : 𝕜)

namespace Set.IsFinitelyGeneratedConvex

-- Proof sketch: when `0 ∉ C`, convert to polyhedral/closed-convex and apply the Chapter 2 owner
-- theorem `PointedCone.closure_cone_eq_nonnegativeRay_union_recessionCone`; the `0 ∈ C`
-- branch is the remaining endpoint case.
/-- Theorem 19.7 (2), core owner form: for a nonempty finitely generated convex set `C`, the
closure of `cone[𝕜] C` is the union of nonnegative dilates of `C` and its recession cone. -/
theorem closure_cone_eq_nonnegativeRay_union_recessionCone
    {C : Set E} (hC : C.IsFinitelyGeneratedConvex 𝕜) (hC_nonempty : C.Nonempty) :
    ((cone[𝕜] C).closure : Set E) =
      𝕜≥0 • C ∪ 0⁺[𝕜] C := by
  by_cases h0C : (0 : E) ∈ C
  · have hcone_fg : (cone[𝕜] C : Set E).IsFinitelyGeneratedConvex 𝕜 := hC.cone h0C
    have hcone_poly : (cone[𝕜] C : Set E).IsPolyhedral 𝕜 := hcone_fg.isPolyhedral
    have hcone_closed : IsClosed (cone[𝕜] C : Set E) := hcone_poly.isClosed_hasFiniteFaces.1
    have hrec_subset : (0⁺[𝕜] C : Set E) ⊆ (cone[𝕜] C : Set E) := by
      intro y hy
      have hyC : y ∈ C := by
        simpa [one_smul, zero_add] using
          (Set.mem_recessionCone_iff.mp hy) 0 h0C 1 zero_le_one
      exact PointedCone.subset_hull hyC
    have hright_nonneg :
        𝕜≥0 • C ∪ 0⁺[𝕜] C = (cone[𝕜] C : Set E) := by
      calc
        𝕜≥0 • C ∪ 0⁺[𝕜] C = (cone[𝕜] C : Set E) ∪ 0⁺[𝕜] C := by
          simp [PointedCone.cone_eq_nonnegativeRay_of_convex C hC.convex hC_nonempty]
        _ = (cone[𝕜] C : Set E) := Set.union_eq_left.2 hrec_subset
    calc
      ((cone[𝕜] C).closure : Set E) = (cone[𝕜] C : Set E) := hcone_closed.closure_eq
      _ = 𝕜≥0 • C ∪ 0⁺[𝕜] C := hright_nonneg.symm
  · have hC_poly : C.IsPolyhedral 𝕜 := hC.isPolyhedral
    have hC_closed : IsClosed C := hC_poly.isClosed_hasFiniteFaces.1
    simpa using
      PointedCone.closure_cone_eq_nonnegativeRay_union_recessionCone
        C hC_nonempty hC_closed hC.convex h0C

/-- Intrinsic-topology companion of Theorem 19.7 (2), core owner form: the same nonnegative-ray
decomposition written with `intrinsicClosure 𝕜 (cone[𝕜] C : Set E)` instead of ambient closure. -/
theorem intrinsicClosure_cone_eq_nonnegativeRay_union_recessionCone
    {C : Set E} (hC : C.IsFinitelyGeneratedConvex 𝕜)
    (hC_nonempty : C.Nonempty) :
    intrinsicClosure 𝕜 (cone[𝕜] C : Set E) =
      𝕜≥0 • C ∪ 0⁺[𝕜] C := by
  have hclosed_aff : IsClosed (affineSpan 𝕜 (cone[𝕜] C : Set E) : Set E) := by
    infer_instance
  have hclosure :
      intrinsicClosure 𝕜 (cone[𝕜] C : Set E) = closure (cone[𝕜] C : Set E) :=
    Set.intrinsicClosure_eq_closure_of_isClosed_affineSpan (𝕜 := 𝕜)
      (C := (cone[𝕜] C : Set E)) hclosed_aff
  simpa [PointedCone.coe_closure, hclosure] using
    closure_cone_eq_nonnegativeRay_union_recessionCone hC hC_nonempty

/-- Theorem 19.7 (2), source-facing bridge form: for a nonempty finitely generated convex set
`C`, the closure of `cone[𝕜] C` is the union of positive dilates of `C` and its recession cone. -/
theorem closure_cone_eq_positiveRay_union_recessionCone
    {C : Set E} (hC : C.IsFinitelyGeneratedConvex 𝕜) (hC_nonempty : C.Nonempty) :
    ((cone[𝕜] C).closure : Set E) =
      𝕜>0 • C ∪ 0⁺[𝕜] C := by
  calc
    ((cone[𝕜] C).closure : Set E) = 𝕜≥0 • C ∪ 0⁺[𝕜] C := by
      exact closure_cone_eq_nonnegativeRay_union_recessionCone hC hC_nonempty
    _ = 𝕜>0 • C ∪ 0⁺[𝕜] C := by
      simpa using
        nonnegativeRay_union_recessionCone_eq_positiveRay_union_recessionCone C
          hC_nonempty

/-- Intrinsic-topology companion of Theorem 19.7 (2), core owner form: the same positive-ray
decomposition written with `intrinsicClosure 𝕜 (cone[𝕜] C : Set E)` instead of ambient closure. -/
theorem intrinsicClosure_cone_eq_positiveRay_union_recessionCone
    {C : Set E} (hC : C.IsFinitelyGeneratedConvex 𝕜)
    (hC_nonempty : C.Nonempty) :
    intrinsicClosure 𝕜 (cone[𝕜] C : Set E) =
      𝕜>0 • C ∪ 0⁺[𝕜] C := by
  calc
    intrinsicClosure 𝕜 (cone[𝕜] C : Set E) = 𝕜≥0 • C ∪ 0⁺[𝕜] C := by
      exact
        intrinsicClosure_cone_eq_nonnegativeRay_union_recessionCone
          hC hC_nonempty
    _ = 𝕜>0 • C ∪ 0⁺[𝕜] C := by
      simpa using
        nonnegativeRay_union_recessionCone_eq_positiveRay_union_recessionCone C
          hC_nonempty

end Set.IsFinitelyGeneratedConvex

namespace Set.IsPolyhedral

-- Proof sketch: transport to the core owner `Set.IsFinitelyGeneratedConvex`, apply the core
-- theorem, then return to the source-facing polyhedral surface.
/-- Theorem 19.7 (2), source-facing bridge form with the primitive nonnegative-ray owner:
for a nonempty polyhedral convex set `C`, the closure of `cone[𝕜] C` is the union of nonnegative
dilates of `C` and its recession cone. -/
theorem closure_cone_eq_nonnegativeRay_union_recessionCone
    {C : Set E} (hC : C.IsPolyhedral 𝕜) (hC_nonempty : C.Nonempty) :
    ((cone[𝕜] C).closure : Set E) =
      𝕜≥0 • C ∪ 0⁺[𝕜] C := by
  simpa using hC.isFinitelyGeneratedConvex.closure_cone_eq_nonnegativeRay_union_recessionCone
    hC_nonempty

/-- Intrinsic-topology companion of Theorem 19.7 (2), source-facing bridge form with the
primitive nonnegative-ray owner. -/
theorem intrinsicClosure_cone_eq_nonnegativeRay_union_recessionCone
    {C : Set E} (hC : C.IsPolyhedral 𝕜)
    (hC_nonempty : C.Nonempty) :
    intrinsicClosure 𝕜 (cone[𝕜] C : Set E) =
      𝕜≥0 • C ∪ 0⁺[𝕜] C := by
  simpa using
    hC.isFinitelyGeneratedConvex
      .intrinsicClosure_cone_eq_nonnegativeRay_union_recessionCone
        hC_nonempty

-- Proof sketch: transport to the core owner `Set.IsFinitelyGeneratedConvex`, apply the core
-- theorem, then return to the source-facing polyhedral surface.
/-- Theorem 19.7 (2), source-facing form: for a nonempty polyhedral convex set `C` in a
finite-dimensional topological `𝕜`-module, the closure of `cone[𝕜] C` is the union of all positive
dilates of `C` together with the recession cone `0⁺ C`. -/
theorem closure_cone_eq_positiveRay_union_recessionCone
    {C : Set E} (hC : C.IsPolyhedral 𝕜) (hC_nonempty : C.Nonempty) :
    ((cone[𝕜] C).closure : Set E) =
      𝕜>0 • C ∪ 0⁺[𝕜] C := by
  calc
    ((cone[𝕜] C).closure : Set E) = 𝕜≥0 • C ∪ 0⁺[𝕜] C := by
      exact closure_cone_eq_nonnegativeRay_union_recessionCone hC hC_nonempty
    _ = 𝕜>0 • C ∪ 0⁺[𝕜] C := by
      simpa using
        nonnegativeRay_union_recessionCone_eq_positiveRay_union_recessionCone C
          hC_nonempty

/-- Intrinsic-topology companion of Theorem 19.7 (2), source-facing form: the same positive-ray
decomposition phrased via `intrinsicClosure 𝕜 (cone[𝕜] C : Set E)`. -/
theorem intrinsicClosure_cone_eq_positiveRay_union_recessionCone
    {C : Set E} (hC : C.IsPolyhedral 𝕜)
    (hC_nonempty : C.Nonempty) :
    intrinsicClosure 𝕜 (cone[𝕜] C : Set E) =
      𝕜>0 • C ∪ 0⁺[𝕜] C := by
  calc
    intrinsicClosure 𝕜 (cone[𝕜] C : Set E) = 𝕜≥0 • C ∪ 0⁺[𝕜] C := by
      exact
        intrinsicClosure_cone_eq_nonnegativeRay_union_recessionCone
          hC hC_nonempty
    _ = 𝕜>0 • C ∪ 0⁺[𝕜] C := by
      simpa using
        nonnegativeRay_union_recessionCone_eq_positiveRay_union_recessionCone C
          hC_nonempty

end Set.IsPolyhedral

end
