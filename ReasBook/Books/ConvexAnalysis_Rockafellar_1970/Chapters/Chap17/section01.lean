-- Proof sketch: apply Theorem 3.3 to write `x` as a simplex-weighted combination of one point
-- from each member of a finite subfamily of `C`. Regard those chosen points as a finite subset of
-- `⋃ i, C i` and apply Theorem 17.0.3 to the chapter hull `conv[R] (⋃ i, C i)` (equivalently,
-- mathlib's
-- `eq_pos_convex_span_of_mem_convexHull`) to reduce to an affinely independent family of
-- cardinality at most `Module.finrank R (vectorSpan R (⋃ i, C i)) + 1`. If two surviving points
-- lie in the same `C i`,
-- coalesce them using convexity of `C i`; iterating the textbook reduction yields an equivalent
-- representation in which the selected family indices are pairwise distinct, recorded canonically
-- by a finite support `s : Finset ι`.
/-- Corollary 17.1.1: if `x` lies in the convex hull of the union of a family of convex sets, then
`x` can be written as a convex combination of at most
`Module.finrank R (vectorSpan R (⋃ i, C i)) + 1` affinely
independent points, each chosen from a different member of the family. The selected family members
are recorded by a finite support `s : Finset ι`. Specializing to
`R = ℝ` and `E = Fin n → ℝ` recovers the textbook `R^n` formulation with `n + 1` or fewer
points. -/
theorem exists_affineIndependent_convexCombination_of_mem_convexHull_iUnion
    (C : ι → Set E) (hconv : ∀ i, Convex R (C i)) (x : E)
    [FiniteDimensional R (vectorSpan R (⋃ i, C i))]
    (hx : x ∈ conv[R] (⋃ i, C i)) :
    ∃ s : Finset ι, s.card ≤ Module.finrank R (vectorSpan R (⋃ i, C i)) + 1 ∧
      ∃ z : (i : s) → C i,
        AffineIndependent R (fun i ↦ (z i : E)) ∧
        ∃ w : StdSimplex R s,
          x = (w.map (fun i ↦ (z i : E))).convexCombination := sorry

end

/-! ### Theorem_17_1 (from Chap04) -/
section

universe u v

open Set
open scoped Rockafellar

/-!
Source/core/bridge triage:

- `source-facing`: Theorem 17.1 is Rockafellar's Carathéodory theorem for mixed hulls generated by
  points and directions. Its two atomic clauses are the bounded-cardinality mixed-combination
  criterion and the full-dimensional generalized-simplex cover of the mixed hull, organized here
  around the set-level owner `Set.fullDimensionalMixedSimplices points directions`.
- `core/canonical`: the owner abstractions already fixed in this chapter are
  `mconv[R](points | ray directions)`, the mixed-combination predicate
  `IsMixedConvexCombination`, its primitive finite-certificate form
  `IsMixedConvexCombinationWith`, the mixed affine-independence owner
  `mixedAffineIndependent`, and the mixed affine hull `maff[R](points | ray directions)`.
- `bridge/view`: the textbook generalized `d`-simplices are rendered canonically as members of
  `Set.fullDimensionalMixedSimplices points directions`, namely mixed hulls of finite
  mixed-affinely-independent families whose mixed affine hull has the same affine dimension as the
  ambient mixed hull.

Domain-style sampling used here:
- `mem_mixedConvexHull_iff_isMixedConvexCombination`;
- `exists_convex_combination_card_le_of_mem_conv`;
- `mixedAffineIndependent_iff_affineDim_eq`;
- `maff`.

Primitive data vs derived API:
- primitive inputs: the point set `points`, the direction-ray set `directions`, and the vector
  `x`;
- derived API: the bounded-cardinality mixed-combination witness, and the source-facing family
  `Set.fullDimensionalMixedSimplices points directions` of full-dimensional generalized simplices
  generated by finite subfamilies of `points` and `directions`.

Layer target: `source-facing`, expressed directly through the chapter's mixed-hull owners rather
than through a new package of finite data.
-/

variable {R : Type v} {E : Type u}
variable [Field R] [LinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E] [FiniteDimensional R E]

-- Proof sketch: combine the mixed-hull membership theorem
-- `mem_mixedConvexHull_iff_isMixedConvexCombination` with the finite-dimensional
-- Carathéodory bound from Theorem 17.0.3 after passing to the lifted cone description of
-- Proposition 17.0.10.
/-- Theorem 17.1 (1): a vector belongs to the mixed convex hull generated by `points` and
`directions` if and only if it is a mixed convex combination using at most
`Module.finrank R E + 1` total entries from those points and directions. This is the mixed
points-and-directions form of Carathéodory's theorem. -/
theorem mem_mixedConvexHull_iff_exists_isMixedConvexCombination_card_le
    (points : Set E) (directions : Set (Module.Ray R E)) (x : E) :
    x ∈ mconv[R](points | ray directions) ↔
      ∃ (ι κ : Type u), ∃ (_ : Fintype ι) (_ : Fintype κ),
        Fintype.card ι + Fintype.card κ ≤ Module.finrank R E + 1 ∧
          IsMixedConvexCombinationWith R points (ray directions) x ι κ := sorry

namespace Set

/-- The family of full-dimensional generalized simplices generated by finite subfamilies of
`points` and `directions`. Each member is the mixed convex hull of a mixed-affinely-independent
finite family drawn from the original generators whose mixed affine hull has the same affine
dimension as the ambient mixed affine hull. -/
def fullDimensionalMixedSimplices
    (points : Set E) (directions : Set (Module.Ray R E)) : Set (Set E) :=
  {s | ∃ (ι κ : Type u), ∃ (_ : Fintype ι) (_ : Fintype κ),
      ∃ pts : ι → E, ∃ dirs : κ → E,
      range pts ⊆ points ∧
      range dirs ⊆ ray directions ∧
      maffind[R](pts | dirs) ∧
      (maff[R](range pts | range dirs)).affineDim =
        (maff[R](points | ray directions)).affineDim ∧
      s = mconv[R](range pts | range dirs)}

/-- Unfolding the generalized-simplex owner gives the finite-family mixed-hull witness data used
in Definition 17.0.13. -/
theorem mem_fullDimensionalMixedSimplices_iff
    {points : Set E} {directions : Set (Module.Ray R E)} {s : Set E} :
    s ∈ fullDimensionalMixedSimplices points directions ↔
      ∃ (ι κ : Type u), ∃ (_ : Fintype ι) (_ : Fintype κ),
        ∃ pts : ι → E, ∃ dirs : κ → E,
        range pts ⊆ points ∧
        range dirs ⊆ ray directions ∧
        maffind[R](pts | dirs) ∧
        (maff[R](range pts | range dirs)).affineDim =
          (maff[R](points | ray directions)).affineDim ∧
        s = mconv[R](range pts | range dirs) :=
by
  constructor <;> intro hs
  · simpa [fullDimensionalMixedSimplices] using hs
  · simpa [fullDimensionalMixedSimplices] using hs

end Set

-- Proof sketch: for `⊆`, apply the bounded-cardinality clause above and then discard dependent
-- generators until the remaining finite family is mixed affinely independent, using
-- `mixedAffineIndependent_iff_affineDim_eq` to read the resulting generalized simplex as
-- `d`-dimensional with `d = (maff[R](points | ray directions)).affineDim`. For `⊇`, each
-- member of `Set.fullDimensionalMixedSimplices points directions` is built from generators
-- already lying in `points` and `ray directions`, so `mixedConvexHull_min` places it inside the
-- ambient mixed hull.
/-- Theorem 17.1 (2): the mixed convex hull generated by `points` and `directions` is the union
of all generalized simplices of affine dimension
`(maff[R](points | ray directions)).affineDim` generated by finite subfamilies of
`points` and `directions`; equivalently, it is the union of the source-facing family
`Set.fullDimensionalMixedSimplices points directions` of full-dimensional mixed hulls coming from
mixed-affinely-independent finite families drawn from the original generators. -/
theorem mixedConvexHull_eq_sUnion_fullDimensionalMixedSimplices
    (points : Set E) (directions : Set (Module.Ray R E)) :
    mconv[R](points | ray directions) =
      ⋃₀ Set.fullDimensionalMixedSimplices points directions := sorry

end

/-! ### Corollary_17_1_2 (from Chap04) -/
section

open scoped BigOperators Rockafellar

universe u v w

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 17.1.2 is the conical form of Carathéodory's theorem for a union of
  convex sets: a nonzero vector in the generated cone `cone[R] (⋃ i, C i)` is a nonnegative
  linear combination of at most `finrank R (vectorSpan R (⋃ i, C i))` linearly independent
  generators drawn
  from pairwise distinct members of the family, canonically recorded by a finite support
  `s : Finset ι`.
- `core/canonical`: the owner abstractions are `cone[R] (⋃ i, C i)`,
  the bridge theorem
  `ConvexCone.mem_hull_iff_exists_positiveLinearCombination`,
  `LinearIndependent`, and finite sums indexed by a finite support `s : Finset ι`.
- `bridge/view`: Corollary 17.1.1 gives the corresponding convex-hull statement with an
  affinely independent family of size at most
  `finrank R (vectorSpan R (⋃ i, C i)) + 1`; adjoining and then removing the origin converts that
  affine statement into the present cone statement.
- Domain-style sampling used here:
  `PointedCone.cone`,
  `PointedCone.subset_hull`,
  `ConvexCone.mem_hull_iff_exists_positiveLinearCombination`,
  `exists_affineIndependent_convexCombination_of_mem_convexHull_iUnion`,
  `affineIndependent_iff_linearIndependent_vsub`.
- Primitive data vs derived API:
  the primitive inputs are the family `C`, its convexity, and the vector `x`;
  the bounded finite support, chosen generators, linear independence, and nonnegative
  coefficients are derived witness data.
- Redundant-source-assumption check:
  the textbook assumes every `C i` is nonempty, but this does not affect the generated cone
  `(cone[R] (⋃ i, C i) : Set E)`, so the Lean statement omits that redundant hypothesis.
- Layer target: `source-facing`.
-/

variable {ι : Type u} {R : Type v} {E : Type w}
variable [Field R] [LinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E]

-- Proof sketch: start from a positive linear-combination witness for
-- `x ∈ (cone[R] (⋃ i, C i) : Set E)` via the bridge theorem
-- `ConvexCone.mem_hull_iff_exists_positiveLinearCombination`, normalize the coefficients to obtain
-- a convex combination, and adjoin the origin. Applying Corollary 17.1.1 to that normalized
-- convex-hull representation yields at most
-- `finrank R (vectorSpan R (⋃ i, C i)) + 1` affinely independent points taken from pairwise
-- distinct sets, recorded by a finite support `s : Finset ι`. Since `x ≠ 0`,
-- removing the origin lowers the bound by one and turns affine independence relative to the
-- origin into linear independence of the remaining generators, with the displayed coefficients
-- then viewed on the weaker nonnegative surface required by the textbook statement.
/-- Corollary 17.1.2: if `x` is a nonzero vector in the convex cone generated by the union of a
family of convex sets, then `x` is a nonnegative linear combination of at most
`Module.finrank R (vectorSpan R (⋃ i, C i))` linearly independent vectors, each drawn from a
different member of the family. The selected family members are recorded by a finite support
`s : Finset ι`. Specializing to `R = ℝ` and `E = Fin n → ℝ` recovers the textbook `R^n`
statement with `n` or fewer generators. -/
theorem exists_linearIndependent_nonnegativeCombination_of_ne_zero_mem_cone_iUnion
    (C : ι → Set E) (hconv : ∀ i, Convex R (C i)) (x : E)
    [FiniteDimensional R (vectorSpan R (⋃ i, C i))]
    (hx : x ∈ (cone[R] (⋃ i, C i) : Set E)) (hx0 : x ≠ 0) :
    ∃ s : Finset ι, s.card ≤ Module.finrank R (vectorSpan R (⋃ i, C i)) ∧
      ∃ z : (i : s) → C i,
        LinearIndependent R (fun i ↦ (z i : E)) ∧
          ∃ a : s → R, (∀ i, 0 ≤ a i) ∧ x = ∑ i, a i • (z i : E) := sorry

end

/-! ### Corollary_17_1_3 (from Chap04) -/
section

universe u v

variable {E : Type u} {I : Type v} {R : Type*}
variable [Field R] [ConditionallyCompleteLinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E] [FiniteDimensional R E]

local instance instSMulWithTopBot : SMul R (WithTopBot R) := WithBotTop.instSMul

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 17.1.3 refines the family convex-hull value formula by showing that
  the infimum may be taken only over convex-combination representations using at most
  `dim E + 1` nonzero coefficients, with the participating points affinely independent.
- `core/canonical`: the owner abstraction already present in the project is the family convex hull
  `conv(⨅ i, f i)` from `Theorem_5_6`, together with the canonical convexity owner
  `ConvexOn R Set.univ`; the needed height-side exclusion is the owner-side pointwise condition
  `∀ i x, ⊥ < f i x`.
- `bridge/view`: Corollary 17.1.1 is the finite-dimensional Carathéodory theorem for a union of
  convex sets. Applying it to the family of epigraphs `epi (f i)` yields the stated restricted
  infimum formula for the family convex hull.

Domain-style sampling used here:
- `Function.convexHull_iInf_eq_sInf_convexCombination_values`;
- `exists_affineIndependent_convexCombination_of_mem_convexHull_iUnion`;
- `StdSimplex.sum`;
- `ConvexOn`;
- `Function.IsProper.bot_lt`.

Primitive data vs derived API:
- primitive inputs: the family `f` of convex functions on a finite-dimensional `R`-vector space,
  together with the pointwise exclusion `∀ i x, ⊥ < f i x`, where `R` is an ordered field with
  enough order completeness to form the `sInf` appearing in the convex-hull owner theorem;
- derived output: the Carathéodory-restricted `sInf` formula for `conv(⨅ i, f i)`.

Redundant-source-assumption audit:
- convexity is essential because the proof passes through convexity of each epigraph `epi (f i)`;
- the needed exclusion is only that epigraph fibers contain no full vertical line, and in the
  owner language this is exactly the pointwise condition `∀ i x, ⊥ < f i x`;
- the nonempty-domain half of `Function.IsProper` does not change the value formula, so a
  properness-form restatement belongs only as a thin companion.

Layer target: `source-facing`, stated directly as a refinement of the family convex-hull value
formula rather than by introducing a new wrapper for admissible coefficient packages.
-/

namespace Function

-- Proof sketch: start from the family convex-hull value theorem
-- `convexHull_iInf_eq_sInf_convexCombination_values`, which identifies `conv(⨅ i, f i) x` with
-- the vertical infimum over convex combinations of epigraph points. Apply Corollary 17.1.1 to the
-- family of convex epigraphs `epi (f i)` in `E × R` to reduce each admissible epigraph point to a
-- simplex with at most `Module.finrank R E + 1` vertices coming from pairwise distinct indices.
-- The pointwise exclusion `∀ i x, ⊥ < f i x` removes vertical-line degeneracies, so one may
-- lower the height within the same simplex to a minimal value and thereby arrange that all
-- participating coefficients are positive and the corresponding points in `E` are affinely
-- independent.
/-- Corollary 17.1.3: if `fᵢ`, `i ∈ I`, are convex `[-∞, +∞]`-valued functions on a
finite-dimensional vector space over an ordered field `R` with conditionally complete order, and
never take the value `⊥`, then `conv(⨅ i, f i)` is their convex hull and
`conv(⨅ i, f i) x` is the infimum of the weighted sums `∑ λⱼ f_{iⱼ}(xⱼ)` over all convex
combinations of `x` with at most `Module.finrank R E + 1` positive coefficients, taken from
pairwise distinct family indices, whose support points are affinely independent. The distinct
index condition is recorded canonically by a finite support `s : Finset I`, so the theorem uses
the same owner surface as Corollary 17.1.1 instead of a separate embedding `Fin m ↪ I`.
Specializing to `R = ℝ` and `E = EuclideanSpace ℝ (Fin n)` recovers the textbook `R^n` statement
with `n + 1` or fewer nonzero coefficients. -/
theorem convexHull_iInf_eq_sInf_affineIndependent_convexCombination_values
    (f : I → E → WithTopBot R)
    (hf_convex : ∀ i : I, ConvexOn R Set.univ (f i))
    (hf_bot : ∀ i x, ⊥ < f i x)
    (x : E) :
    conv(⨅ i, f i) x =
      sInf
        {r : WithTopBot R |
          ∃ s : Finset I, s.card ≤ Module.finrank R E + 1 ∧
            ∃ z : (i : s) → E,
              AffineIndependent R z ∧
                ∃ w : StdSimplex R s,
                  (∀ i : s, 0 < w.weights i) ∧
                    x = (w.map z).convexCombination ∧
                      r = w.sum (fun i a ↦ (a : WithTopBot R) * f i (z i))} := sorry

/-- Properness-form restatement of Corollary 17.1.3. This companion adds no new mathematics: its
only use of `Function.IsProper (f i)` is to recover the pointwise exclusion `∀ i x, ⊥ < f i x`
required by the main theorem. -/
theorem convexHull_iInf_eq_sInf_affineIndependent_convexCombination_values_of_proper
    (f : I → E → WithTopBot R)
    (hf_convex : ∀ i : I, ConvexOn R Set.univ (f i))
    (hf_proper : ∀ i : I, (f i).IsProper)
    (x : E) :
    conv(⨅ i, f i) x =
      sInf
        {r : WithTopBot R |
          ∃ s : Finset I, s.card ≤ Module.finrank R E + 1 ∧
            ∃ z : (i : s) → E,
              AffineIndependent R z ∧
                ∃ w : StdSimplex R s,
                  (∀ i : s, 0 < w.weights i) ∧
                    x = (w.map z).convexCombination ∧
                      r = w.sum (fun i a ↦ (a : WithTopBot R) * f i (z i))} := by
  exact
    convexHull_iInf_eq_sInf_affineIndependent_convexCombination_values
      f hf_convex (fun i x ↦ (hf_proper i).bot_lt x) x

end Function

end

/-! ### Corollary_17_1_4 (from Chap04) -/
section

open scoped BigOperators

universe u v w

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 17.1.4 gives the Carathéodory-reduced conic value formula for the
  greatest positively homogeneous convex minorant of a family of convex functions.
- `core/canonical`: the owner abstractions already fixed earlier are the family convex hull
  `conv(⨅ i, f i)` and the positively homogeneous convex hull `sublinearHull`.
- `bridge/view`: Corollary 17.1.3 supplies the affine-independent family convex-hull formula, and
  Corollary 17.1.6 supplies the linearly independent conic reduction for `sublinearHull`; the
  theorem below states their combined source-facing consequence directly on the canonical owner
  `sublinearHull (conv(⨅ i, f i))`.
- Primitive data vs derived API:
  the primitive inputs are the family `f` and the nonzero vector `x`; the bounded support,
  positive coefficients, chosen points, and linear independence are derived witness data.
- Redundant-source-assumption audit:
  as in Corollary 17.1.3, the essential epigraph-side exclusion is the pointwise condition
  `∀ i x, ⊥ < f i x`; the nonempty-domain part of `Function.IsProper` is recorded only in the
  thin companion theorem below.
- Layer target: `source-facing`, but organized around the canonical chapter owners
  `conv(·)` and `sublinearHull`.
-/

namespace Function

variable {E : Type u} {I : Type v} {R : Type w}
variable [Field R] [ConditionallyCompleteLinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E] [FiniteDimensional R E]

-- Proof sketch: apply Corollary 17.1.6 to the single function `conv(⨅ i, f i)`, so the value at
-- a nonzero `x` is an infimum over linearly independent positive conic representations whose
-- costs are computed with `conv(⨅ i, f i)`. Then use Corollary 17.1.3 on each participating
-- evaluation of `conv(⨅ i, f i)` to refine those costs to values of the original family members
-- `f i` at affinely independent epigraph points, and flatten the resulting finite data into one
-- support indexed by a `Finset I`.
/-- Corollary 17.1.4: if `fᵢ`, `i ∈ I`, are convex `[-∞, +∞]`-valued functions and never take the
value `⊥`, then the positively homogeneous convex function generated by their convex hull,
represented canonically by `sublinearHull (conv (⨅ i, f i))`, has at each nonzero `x` the
Carathéodory-reduced conic value formula
`inf {∑ λⱼ f_{iⱼ}(xⱼ) | x = ∑ λⱼ xⱼ}` over supports of size at most `Module.finrank R E`, with
strictly positive coefficients and linearly independent support vectors. Recording only the
nonzero coefficients via a finite support `s : Finset I` matches the textbook phrase “at most
`n` coefficients are nonzero”. The properness-form textbook statement is recovered by the
companion theorem below. -/
theorem sublinearHull_convexHull_iInf_eq_sInf_linearIndependent_positiveCombination_values_of_ne_zero
    (f : I → E → WithTopBot R)
    (hf_convex : ∀ i : I, ConvexOn R Set.univ (f i))
    (hf_bot : ∀ i x, ⊥ < f i x)
    (x : E) (hx : x ≠ 0) :
    sublinearHull (conv(⨅ i, f i)) x =
      sInf
        {r : WithTopBot R |
          ∃ s : Finset I, s.card ≤ Module.finrank R E ∧
            ∃ z : (i : s) → E,
              LinearIndependent R z ∧
                ∃ a : s → R,
                  (∀ i : s, 0 < a i) ∧
                    x = ∑ i : s, a i • z i ∧
                      r = ∑ i : s, (a i : WithTopBot R) * f i (z i)} := sorry

-- Proof sketch: the main theorem only needs the pointwise exclusion `∀ i x, ⊥ < f i x`; a
-- properness hypothesis provides exactly that exclusion through `Function.IsProper.bot_lt`, so the
-- properness-form source statement is the direct specialization of the owner theorem above.
/-- Properness-form restatement of the Corollary 17.1.4 value formula. This companion adds no new
mathematics beyond replacing the owner-side hypothesis `∀ i x, ⊥ < f i x` by the textbook
assumption that each `f i` is proper. -/
theorem
    sublinearHull_convexHull_iInf_eq_sInf_linearIndependent_positiveCombination_values_of_ne_zero_of_proper
    (f : I → E → WithTopBot R)
    (hf_convex : ∀ i : I, ConvexOn R Set.univ (f i))
    (hf_proper : ∀ i : I, (f i).IsProper)
    (x : E) (hx : x ≠ 0) :
    sublinearHull (conv(⨅ i, f i)) x =
      sInf
        {r : WithTopBot R |
          ∃ s : Finset I, s.card ≤ Module.finrank R E ∧
            ∃ z : (i : s) → E,
              LinearIndependent R z ∧
                ∃ a : s → R,
                  (∀ i : s, 0 < a i) ∧
                    x = ∑ i : s, a i • z i ∧
                      r = ∑ i : s, (a i : WithTopBot R) * f i (z i)} := sorry

end Function

end

/-! ### Corollary_17_1_5 (from Chap04) -/
section

universe u v

variable {E : Type u} {R : Type v}
variable [Field R] [ConditionallyCompleteLinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E]

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 17.1.5 states the Carathéodory refinement of Rockafellar's value
  formula for `conv(f)`, reducing the infimum from arbitrary finite convex combinations to ones
  using at most `n + 1` points in ambient dimension `n`, and then to ones with affinely
  independent support, where the same `n + 1` bound is then theorem-level data rather than
  primitive witness data.
- `core/canonical`: the owner abstractions already fixed in the project are `conv(f)` for the
  convex hull of a function, `Function.convexCombinationValues` for the unrestricted admissible
  value set, together with the chapter's finite-support simplex surface `StdSimplex R s`,
  `(w.map z).convexCombination`, and the canonical simplex sum surface `w.sum`.
- `bridge/view`: Theorem 17.0.3 supplies the finite-dimensional Carathéodory restriction from the
  unrestricted owner `Function.convexCombinationValues` to bounded-cardinality witnesses, while
  mathlib's `eq_pos_convex_span_of_mem_convexHull` is the affine-independent pruning owner for the
  unrestricted convex-hull side. In finite dimension,
  `AffineIndependent.card_le_finrank_succ` together with `Submodule.finrank_le` then recovers the
  cardinality bound automatically from the affine-independent support.

Domain-style sampling used here:
- `Function.convexHull_eq_sInf_convexCombination_values`;
- `Function.convexCombinationValues`;
- `StdSimplex.map_convexCombination_eq_sum`;
- `StdSimplex.sum`;
- `exists_convex_combination_card_le_of_mem_conv`;
- `eq_pos_convex_span_of_mem_convexHull`.
- `AffineIndependent`.

Primitive data vs derived API:
- primitive input: an arbitrary extended-real-valued function `f`;
- derived output: the Carathéodory-refined `sInf` formulas for `conv(f) x`, expressed directly as
  restrictions of the canonical owner surface `Function.convexCombinationValues`; the first uses a
  finite-dimensional cardinality bound, while in the second formula affine independence is
  primitive and the `finrank + 1` bound is only a derived finite-dimensional corollary of that
  affine-independent support.
  The represented point is written on the canonical owner surface
  `(w.map ((↑) : s → E)).convexCombination` rather than through its weighted-sum bridge.

Ambient minimization:
- the unrestricted owner `Function.convexHull_eq_sInf_convexCombination_values` already lives over
  an ordered field with conditionally complete order;
- Theorem 17.0.3 has the same ordered-field scalar layer, so the bounded-cardinality clause does
  not need to be specialized to `ℝ`;
- the affine-independent clause is only a finite-support pruning refinement, so it also does not
  need a finite-dimensional ambient hypothesis.

Layer target: `source-facing`, stated directly on the existing owners without introducing a local
package for admissible witness data.
-/

namespace Function

-- Proof sketch: start from `Function.convexHull_eq_sInf_convexCombination_values`, which writes
-- `conv(f) x` as the infimum over arbitrary finite convex combinations of epigraph points of `f`.
-- Apply Theorem 17.0.3 to the relevant epigraph convex-hull witness to replace each such witness
-- by one with at most `Module.finrank R E + 1` support points while preserving the same
-- represented base point `x` and the same height. State the represented point through the
-- canonical simplex surface `(w.map ((↑) : s → E)).convexCombination`, leaving the
-- weighted-sum equation only as an upstream bridge theorem. This yields the bounded-cardinality
-- formula.
/-- Corollary 17.1.5 (1): for an arbitrary function `f` on a finite-dimensional vector space over
an ordered field `R`, `conv(f) x` is the infimum of the weighted sums `∑ λᵢ f(xᵢ)` over
convex-combination representations of `x` using at most `Module.finrank R E + 1` points.
Specializing to `R = ℝ` and `E = EuclideanSpace ℝ (Fin n)` recovers the textbook `R^n`
statement with `n + 1` points. -/
theorem convexHull_eq_sInf_convexCombination_values_card_le_finrank_succ
    [FiniteDimensional R E]
    (f : E → WithBotTop R) (x : E) :
    conv(f) x =
      sInf
        {r : WithBotTop R |
          ∃ s : Finset E, s.card ≤ Module.finrank R E + 1 ∧
            ∃ w : StdSimplex R s,
              x = (letI : ConvexSpace R E := inferInstance
                ; ConvexSpace.convexCombination (w.map ((↑) : s → E))) ∧
                r = w.sum (fun i a ↦ (a : WithBotTop R) * f i)} := sorry

-- Proof sketch: refine the bounded-cardinality representation above by the usual Carathéodory
-- pruning argument inside the supporting simplex: discard affine dependencies among the support
-- points while keeping the represented point `x` and the same height on the epigraph side. This
-- affine-independent pruning is a finite-support phenomenon and does not use finite-dimensionality.
-- In finite dimension the surviving affine-independent support automatically has cardinality at
-- most `Module.finrank R E + 1` by `AffineIndependent.card_le_finrank_succ`.
/-- Corollary 17.1.5 (2): the same value formula remains valid when the support points are
required to be affinely independent; in finite dimension the `Module.finrank R E + 1` bound is a
derived consequence of affine independence, not extra primitive witness data. -/
theorem convexHull_eq_sInf_affineIndependent_convexCombination_values
    (f : E → WithBotTop R) (x : E) :
    conv(f) x =
      sInf
        {r : WithBotTop R |
          ∃ s : Finset E, AffineIndependent R ((↑) : s → E) ∧
            ∃ w : StdSimplex R s,
              x = (letI : ConvexSpace R E := inferInstance
                ; ConvexSpace.convexCombination (w.map ((↑) : s → E))) ∧
                r = w.sum (fun i a ↦ (a : WithBotTop R) * f i)} := sorry

end Function

end

/-! ### Corollary_17_1_6 (from Chap04) -/
section

open scoped BigOperators

universe u v

namespace Function

variable {R : Type v} {E : Type u}
variable [Field R] [ConditionallyCompleteLinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E] [FiniteDimensional R E]

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 17.1.6 gives the value formula for the positively homogeneous convex
  function generated by an arbitrary function `f`, at a nonzero vector `x`, in terms of conic
  combinations with at most `n` generators.
- `core/canonical`: the owner abstraction already fixed earlier in the project is
  `Function.sublinearHull f`, the positively homogeneous convex function generated by `f`.
- `bridge/view`: `Function.sublinearHull_eq_sInf_verticalHeights` rewrites the value of
  `sublinearHull f` as an
  infimum over heights in the generated epigraph cone, and Corollary 17.1.2 supplies the
  Carathéodory reduction from arbitrary conic combinations to ones with at most
  `Module.finrank R E` generators and, in the refined form, linearly independent generators.

Domain-style sampling used here:
- `Function.sublinearHull`;
- `Function.sublinearHull_eq_sInf_verticalHeights`;
- `PointedCone.mem_hull_set`;
- `exists_linearIndependent_positiveCombination_of_ne_zero_mem_cone_iUnion`.

Primitive data vs derived API:
- primitive inputs: the function `f` and the nonzero vector `x`;
- derived output: the infimum formula for `sublinearHull f x`, first over arbitrary nonnegative
  conic representations, then over linearly independent positive ones.
- ambient minimization: neither theorem uses topology, norm, inner product, or any genuinely
  real-specific structure, so the source-facing statements live over the weakest shared scalar
  layer required by the reused owner API and the Chapter 17 Carathéodory reduction:
  an ordered field `R` with conditional completeness.

Layer target: `source-facing`, stated directly for the canonical owner `sublinearHull` rather than
through a surrogate package of coefficient data.
-/

-- Proof sketch: rewrite `sublinearHull f x` with
-- `Function.sublinearHull_eq_sInf_verticalHeights`, so the value is
-- the infimum of the heights `μ` for which `(x, μ)` lies in the cone generated by `epi f`.
-- Expand conic-hull membership with `PointedCone.mem_hull_set`, combine duplicate support
-- points, and project to the first and second coordinates to obtain the displayed finite-support
-- weighted-sum formula.
-- Corollary 17.1.2 gives the Carathéodory bound reducing the number of generators to at most
-- `Module.finrank R E`.
/-- Corollary 17.1.6: for a nonzero vector `x`, the positively homogeneous convex function
generated by `f`, represented canonically by `sublinearHull f`, equals the infimum of the weighted
sums `∑ λᵢ f(xᵢ)` over all finite-support nonnegative linear combinations of `x` with support
cardinality at most `Module.finrank R E`. Specializing to `R = ℝ` and `E = Fin n → ℝ` recovers
the textbook `R^n`
formula with `n` vectors; equivalently, this is the function generated by `conv(f)`. -/
theorem sublinearHull_eq_sInf_nonnegativeCombination_values_of_ne_zero
    (f : E → WithBotTop R) (x : E) (hx : x ≠ 0) :
    sublinearHull f x =
      sInf {r : WithBotTop R |
          ∃ s : Finset E, s.card ≤ Module.finrank R E ∧
            ∃ a : s → R,
              (∀ y : s, 0 ≤ a y) ∧
                x = ∑ y : s, a y • (y : E) ∧
                  r = ∑ y : s, (a y : WithBotTop R) * f (y : E)} := sorry

-- Proof sketch: start from the nonnegative conic-combination formula above and delete the
-- zero-coefficient generators; the remaining generators have strictly positive coefficients and
-- still represent the same point and value. Applying Corollary 17.1.2 to the projected epigraph
-- generators then yields a representation by at most `Module.finrank R E` linearly independent
-- vectors, and taking the infimum over those reduced witnesses leaves the value unchanged.
/-- The same conic value formula for `sublinearHull f x` may be restricted to linearly independent
generators with strictly positive coefficients. -/
theorem sublinearHull_eq_sInf_linearIndependent_positiveCombination_values_of_ne_zero
    (f : E → WithBotTop R) (x : E) (hx : x ≠ 0) :
    sublinearHull f x =
      sInf {r : WithBotTop R |
          ∃ s : Finset E, s.card ≤ Module.finrank R E ∧
            LinearIndependent R ((↑) : s → E) ∧
            ∃ a : s → R,
              (∀ y : s, 0 < a y) ∧
                x = ∑ y : s, a y • (y : E) ∧
                  r = ∑ y : s, (a y : WithBotTop R) * f (y : E)} := sorry

end Function

end
