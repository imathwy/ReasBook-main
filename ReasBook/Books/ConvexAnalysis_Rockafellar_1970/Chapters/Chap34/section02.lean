/-- Intrinsic Chapter 34 equivalence-class companion: for a closed convex bifunction `F`,
membership in `ΩAdj[UStar](F)` is equivalent to equivalence with the lower representative
`lowerPairing XStar F`. -/
theorem mem_omegaAdjoint_iff_equivalent_lowerPairing
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F) (K : U → XStar → WithTopBot 𝕜)
    : K ∈ ΩAdj[UStar](F) ↔ K ∼ lowerPairing XStar F := by
  sorry

/-- The lower representative generated by a closed convex bifunction belongs to
`ΩAdj[UStar](F)`. -/
theorem lowerPairing_mem_omegaAdjoint
    (F : U → X → WithTopBot 𝕜) (hF : IsClosedConvex F)
    : lowerPairing XStar F ∈ ΩAdj[UStar](F) := by
  refine
    (mem_omegaAdjoint_iff_equivalent_lowerPairing (UStar := UStar) F hF
      (lowerPairing XStar F)).2 ?_
  exact (equivalent_iff (lowerPairing XStar F) (lowerPairing XStar F)).2 ⟨rfl, rfl⟩

