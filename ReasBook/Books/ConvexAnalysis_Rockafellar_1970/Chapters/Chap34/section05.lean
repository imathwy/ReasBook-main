noncomputable section

universe u v

open scoped Rockafellar

namespace SaddleFunction

section

open Bifunction

variable {U : Type u} {X : Type v}
variable [NormedAddCommGroup U] [NormedSpace ℝ U] [FiniteDimensional ℝ U]
variable [NormedAddCommGroup X] [NormedSpace ℝ X] [FiniteDimensional ℝ X]
variable [Module ℝ EReal] [PosSMulMono ℝ EReal]

/-- A closed proper saddle-function has the prescribed kernel from `K` on `C × D` when its
domain is exactly `C ×ˢ D` and its values agree with `K` on the relative interior of
that product domain. -/
def HasPrescribedKernel (L : U → X → EReal) (K : U → X → ℝ) (C : Set U) (D : Set X) : Prop :=
  dom L = C ×ˢ D ∧
    Set.EqOn (Function.uncurry L) (fun p ↦ (K p.1 p.2 : EReal)) (ri[ℝ](C ×ˢ D))

-- Proof sketch: unfold `HasPrescribedKernel`; the predicate is definitionally the conjunction of
-- the effective-domain identity and equality with `K` on the relative interior of that domain.
/-- Unfolded form of the prescribed-kernel predicate. -/
theorem hasPrescribedKernel_iff
    (L : U → X → EReal) (K : U → X → ℝ) (C : Set U) (D : Set X) :
    HasPrescribedKernel L K C D ↔
      dom L = C ×ˢ D ∧
        Set.EqOn (Function.uncurry L) (fun p ↦ (K p.1 p.2 : EReal)) (ri[ℝ](C ×ˢ D)) := sorry

/-- The Chapter 34 equivalence class of a representative `L₀`, restricted to closed proper
concave-convex saddle-functions. -/
def closedProperConcaveConvexEquivalenceClass (L₀ : U → X → EReal) :
    Set (U → X → EReal) :=
  {L | IsConcaveConvex ℝ L ∧ IsClosed L ∧ IsProper L ∧ L ∼ L₀}

-- Proof sketch: unfold `closedProperConcaveConvexEquivalenceClass`; membership is definitionally
-- the conjunction of concave-convexity, closedness, properness, and Chapter 34 equivalence to
-- the chosen representative.
/-- Membership in the closed proper concave-convex equivalence class of `L₀` is exactly the
conjunction of concave-convexity, closedness, properness, and equivalence to `L₀`. -/
theorem mem_closedProperConcaveConvexEquivalenceClass_iff
    (L₀ : U → X → EReal) (L : U → X → EReal) :
    L ∈ closedProperConcaveConvexEquivalenceClass L₀ ↔
      IsConcaveConvex ℝ L ∧ IsClosed L ∧ IsProper L ∧ L ∼ L₀ := sorry

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 34.5.1 asserts existence and uniqueness of the Chapter 34
  equivalence class determined by a finite concave-convex kernel on `C × D`.
- `core/canonical`: the natural owner layer is the existing Chapter 34 equivalence-class owner
  `closedProperConcaveConvexEquivalenceClass`, together with the source-facing kernel predicate
  `HasPrescribedKernel`.
- `bridge/view`: a predicate on subsets of saddle-functions saying that the subset is exactly such
  an equivalence class for some representative with the prescribed kernel.

Domain-style sampling used here:
- `Bifunction.equivalence` and the class owner
  `closedProperConcaveConvexEquivalenceClass`;
- `SaddleFunction.HasPrescribedKernel` from this file;
- `SaddleFunction.SameKernel`-style bridge design from `Theorem_34_4`, where a kernel condition is
  factored into a reusable predicate rather than repeated in a large conjunction.

Primitive data vs derived API:
- primitive source data: `K : U → X → ℝ` and convex sets `C`, `D`;
- primitive owner already present: the Chapter 34 equivalence class generated by a representative;
- derived bridge API added here: the predicate
  `IsPrescribedKernelEquivalenceClass Ω K C D` and the membership characterization theorem below.

Layer target: `source-facing`, with the labeled corollary reduced to the unique-existence clause
and the membership characterization separated as companion API.
-/

/-- A saddle-function is a closed proper concave-convex representative with prescribed kernel
when it is concave-convex, closed, proper, and has the kernel induced by `K` on `C × D`. -/
class IsClosedProperConcaveConvexWithPrescribedKernel
    (L : U → X → EReal) (K : U → X → ℝ) (C : Set U) (D : Set X) : Prop where
  isConcaveConvex : IsConcaveConvex ℝ L
  isClosed : IsClosed L
  isProper : IsProper L
  hasPrescribedKernel : HasPrescribedKernel L K C D

/-- A set `Ω` is the Chapter 34 equivalence class prescribed by `K` on `C × D` when it is the
closed proper concave-convex equivalence class of some representative whose kernel on
`ri[ℝ](C ×ˢ D)` is given by `K`. -/
def IsPrescribedKernelEquivalenceClass
    (Ω : Set (U → X → EReal)) (K : U → X → ℝ) (C : Set U) (D : Set X) : Prop :=
  ∃ L₀ : U → X → EReal,
    IsClosedProperConcaveConvexWithPrescribedKernel L₀ K C D ∧
      Ω = closedProperConcaveConvexEquivalenceClass L₀

-- Proof sketch: unpack the chosen representative from
-- `IsPrescribedKernelEquivalenceClass Ω K C D`; then combine
-- `mem_closedProperConcaveConvexEquivalenceClass_iff` with Theorem 34.4 to transfer the kernel
-- condition across the Chapter 34 equivalence relation inside the class.
/-- Membership in a prescribed-kernel equivalence class is exactly the condition of being a
closed proper concave-convex saddle-function with the prescribed kernel. -/
theorem mem_iff_of_isPrescribedKernelEquivalenceClass
    {Ω : Set (U → X → EReal)} {C : Set U} {D : Set X} {K : U → X → ℝ}
    (hΩ : IsPrescribedKernelEquivalenceClass Ω K C D) (L : U → X → EReal) :
    L ∈ Ω ↔ IsClosedProperConcaveConvexWithPrescribedKernel L K C D := sorry

-- Proof sketch: existence comes from the Chapter 34.5 simple-extension construction, which
-- produces a closed proper concave-convex representative with the prescribed kernel. Uniqueness
-- then follows from Theorem 34.4, which says that closed proper concave-convex saddle-functions
-- with the same kernel are equivalent, so any two such classes coincide.
/-- Corollary 34.5.1: if `C` and `D` are nonempty convex sets and `K` is a finite concave-convex
kernel on `C × D`, then there exists exactly one Chapter 34 equivalence class of closed proper
concave-convex saddle-functions on the ambient spaces whose kernel is the restriction of `K` to
`ri[ℝ](C ×ˢ D)`. -/
theorem existsUnique_closedProperConcaveConvexEquivalenceClass_with_prescribedKernel
    {C : Set U} {D : Set X} {K : U → X → ℝ}
    (hC_nonempty : C.Nonempty) (hD_nonempty : D.Nonempty)
    (hC_convex : Convex ℝ C) (hD_convex : Convex ℝ D)
    (hK_shape : IsConcaveConvexOn ℝ C D K) :
    ∃! Ω : Set (U → X → EReal), IsPrescribedKernelEquivalenceClass Ω K C D := sorry

end

end SaddleFunction

/-! ### Theorem_34_5 (from Chap07) -/
noncomputable section

universe u v

open scoped Rockafellar
open SaddleFunction

namespace Bifunction

section

variable {U : Type u} {X : Type v}
variable [NormedAddCommGroup U] [NormedSpace ℝ U] [FiniteDimensional ℝ U]
variable [NormedAddCommGroup X] [NormedSpace ℝ X] [FiniteDimensional ℝ X]
variable [Module ℝ EReal] [PosSMulMono ℝ EReal]

/-!
Source/core/bridge triage:

- `source-facing`: Theorem 34.5 compares the iterated closures `lowerClosure K` and
  `upperClosure K` of a proper simple concave-convex saddle-function `K`, then characterizes the
  concave-convex saddle-functions lying between them.
- `core/canonical`: the owner layer is already present in Chapter 34: `lowerClosure`,
  `upperClosure`, the equivalence relation `∼`, the closedness and properness owners
  `SaddleFunction.IsClosed` and `SaddleFunction.IsProper`, the simplicity owner
  `SaddleFunction.IsSimple`, and the kernel-comparison owner `SaddleFunction.SameKernel`.
- `bridge/view`: the final source sentence is best expressed as a sandwich characterization among
  concave-convex saddle-functions, rather than by introducing a new packaged equivalence-class
  object.

Domain-style sampling used here:
- `Bifunction.lowerClosure` and `Bifunction.upperClosure` from `Defn_34_1`;
- `Bifunction.equivalence` and `Bifunction.equivalent_iff` from `Defn_34_4`;
- `SaddleFunction.IsSimple` from `Chap07.Defn_34_5`;
- `SaddleFunction.SameKernel` from `Theorem_34_4`.

Primitive data vs derived API:
- primitive source data: a saddle-function `K : U → X → EReal`;
- primitive owner hypotheses: `IsConcaveConvex ℝ K`, `IsProper K`, and `IsSimple ℝ K`;
- derived API: equivalence of the two closure representatives, their order relation, and the
  sandwich characterization of the whole equivalence class determined by `K`.

Layer target: `source-facing`, split into atomic clauses: equivalence of the two closure
representatives, their order relation, the three forward consequences of the sandwich condition,
and the reverse implication from closedness, properness, and common kernel back to the sandwich.
-/

-- Proof sketch: use Theorem 34.1 to make `lowerClosure K` lower closed and `upperClosure K`
-- upper closed. Corollary 34.2.2 upgrades both to closed saddle-functions. Simplicity preserves
-- the kernel under each partial closure, so Theorem 34.4 identifies the two closed proper
-- representatives as equivalent.
/-- Theorem 34.5 (1): if `K` is a proper simple concave-convex saddle-function, then its lower
closure `cl₂ (cl₁ K)` and upper closure `cl₁ (cl₂ K)` are equivalent. -/
theorem lowerClosure_equivalent_upperClosure_of_isSimple
    {K : U → X → EReal}
    (hK_shape : IsConcaveConvex ℝ K)
    (hK_proper : IsProper K)
    (hK_simple : IsSimple ℝ K) :
    lowerClosure K ∼ upperClosure K := sorry

-- Proof sketch: once the two closures are known to belong to the same closed equivalence class by
-- the previous clause, Corollary 34.2.2 identifies the lower-closed representative as the least
-- element and the upper-closed representative as the greatest element of that class, yielding the
-- pointwise inequality.
/-- Theorem 34.5 (2): for a proper simple concave-convex saddle-function `K`, the lower closure is
pointwise below the upper closure. -/
theorem lowerClosure_le_upperClosure_of_isSimple
    {K : U → X → EReal}
    (hK_shape : IsConcaveConvex ℝ K)
    (hK_proper : IsProper K)
    (hK_simple : IsSimple ℝ K) :
    lowerClosure K ≤ upperClosure K := sorry

-- Proof sketch: use the order interval between the two closure representatives together with
-- Theorem 34.1 and Corollary 34.2.2 to place any intermediate concave-convex representative in
-- the same closed equivalence class, yielding closedness.
/-- Theorem 34.5 (3): among concave-convex saddle-functions, any function lying between the lower
and upper closures of a proper simple saddle-function `K` is closed. -/
theorem isClosed_of_between_closures_of_isSimple
    {K L : U → X → EReal}
    (hK_shape : IsConcaveConvex ℝ K)
    (hK_proper : IsProper K)
    (hK_simple : IsSimple ℝ K)
    (hL_shape : IsConcaveConvex ℝ L) :
    lowerClosure K ≤ L ∧ L ≤ upperClosure K →
      SaddleFunction.IsClosed L := sorry

-- Proof sketch: the same sandwich argument identifies any intermediate concave-convex
-- representative with members of the proper closed equivalence class determined by the two
-- closure representatives, so properness transports to `L`.
/-- Theorem 34.5 (4): among concave-convex saddle-functions, any function lying between the lower
and upper closures of a proper simple saddle-function `K` is proper. -/
theorem isProper_of_between_closures_of_isSimple
    {K L : U → X → EReal}
    (hK_shape : IsConcaveConvex ℝ K)
    (hK_proper : IsProper K)
    (hK_simple : IsSimple ℝ K)
    (hL_shape : IsConcaveConvex ℝ L) :
    lowerClosure K ≤ L ∧ L ≤ upperClosure K →
      IsProper L := sorry

-- Proof sketch: use the simplicity hypothesis to transport the kernel from `K` to the two
-- closure representatives, then apply the same closed-equivalence-class argument to any
-- intermediate `L` to identify its kernel with that of `K`.
/-- Theorem 34.5 (5): among concave-convex saddle-functions, any function lying between the lower
and upper closures of a proper simple saddle-function `K` has the same kernel as `K`. -/
theorem sameKernel_of_between_closures_of_isSimple
    {K L : U → X → EReal}
    (hK_shape : IsConcaveConvex ℝ K)
    (hK_proper : IsProper K)
    (hK_simple : IsSimple ℝ K)
    (hL_shape : IsConcaveConvex ℝ L) :
    lowerClosure K ≤ L ∧ L ≤ upperClosure K →
      SameKernel L K := sorry

-- Proof sketch: apply Theorem 34.4 to a closed proper concave-convex `L` with `SameKernel L K`
-- to place `L` in the same equivalence class as the two closure representatives of `K`, then use
-- the lower-closed and upper-closed extremality statements from Corollary 34.2.2 to recover the
-- two sandwich inequalities.
/-- Theorem 34.5 (6): among concave-convex saddle-functions, a closed proper function with the
same kernel as a proper simple saddle-function `K` lies between the lower and upper closures of
`K`. -/
theorem between_closures_of_isClosed_of_isProper_of_sameKernel_of_isSimple
    {K L : U → X → EReal}
    (hK_shape : IsConcaveConvex ℝ K)
    (hK_proper : IsProper K)
    (hK_simple : IsSimple ℝ K)
    (hL_shape : IsConcaveConvex ℝ L)
    (hL_closed : SaddleFunction.IsClosed L)
    (hL_proper : IsProper L)
    (hLK_kernel : SameKernel L K) :
    lowerClosure K ≤ L ∧ L ≤ upperClosure K := sorry

end

end Bifunction
