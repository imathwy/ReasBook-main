open scoped Pointwise
open scoped Rockafellar

section

variable
    {𝕜 E : Type*}
    [NontriviallyNormedField 𝕜] [LinearOrder 𝕜] [OrderTopology 𝕜]
    [IsStrictOrderedRing 𝕜] [CompleteSpace 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E]

/-
Source/core/bridge triage:
- `source-facing`: Corollary 6.8.1 identifies the relative interior of the homogenization cone of
  a convex set `C ⊆ E`, equivalently the convex cone generated by the lift `{(1, x) | x ∈ C}`.
- `core/canonical`: the owner notions are the source-facing `K[𝕜 | C]` from
  Proposition 2.6.12, its bridge `PointedCone.hull 𝕜 (Prod.mk 1 '' C)`, and
  `intrinsicInterior 𝕜` for Rockafellar's relative interior.
- `bridge/view`: the source description of points of `ri K` becomes the canonical set
  `{p | 0 < p.1 ∧ p.2 ∈ p.1 • intrinsicInterior 𝕜 C}` in the product space `𝕜 × E`.
- Primitive data vs derived API: the only primitive data are the set `C` and its convexity
  hypothesis; the relative-interior description is derived directly from the owner constructions
  `homogenizationSet`, `PointedCone.hull 𝕜`, and `intrinsicInterior 𝕜`. The source nonemptiness
  hypothesis is redundant for the resulting set equality, so it is removed from the public API.
- Domain-style sampling: this item is guided by `homogenizationSet`, the chapter theorem
  `homogenizationSet_eq_pointedConeHull`,
  `Convex.intrinsicInterior_linear_image` specialized to `LinearMap.lsmul`, and the
  product-fiber relative-interior theorem
  `Convex.mem_ri_iff_mem_ri_base_and_fiber`.
- Layer target: the main statement is a `bridge/view` theorem written directly in terms of the
  source-facing owner `K[𝕜 | C]`, with `PointedCone.hull` kept only as an internal
  bridge, and it belongs on the existing `Convex` owner surface used by the surrounding Chapter 6
  API.
-/

namespace Convex

/-- Corollary 6.8.1, source-facing homogenization-set form: for a convex subset `C` in a
finite-dimensional ambient `E`, the relative interior of `K[𝕜 | C]` consists
exactly of the pairs `(λ, x)` with `λ > 0` and `x ∈ λ • intrinsicInterior 𝕜 C`. When `C` is
nonempty, Proposition 2.6.12 identifies this with the relative interior of the convex cone in
`𝕜 × E`
generated by the lift `{(1, x) | x ∈ C}`. -/
-- Proof sketch: if `C = ∅`, both sides are empty. Otherwise apply the preceding relative-interior
-- theorem for a product decomposition `𝕜 × E` directly to `K[𝕜 | C]`. The projection
-- to the first coordinate is `Set.Ici 0`, and the fiber at a positive height `λ` is `λ • C`, so
-- `Convex.intrinsicInterior_linear_image` with `LinearMap.lsmul` rewrites the fiber
-- relative interior as `λ • intrinsicInterior 𝕜 C`.
theorem intrinsicInterior_homogenizationSet_eq {C : Set E}
    [FiniteDimensional 𝕜 E]
    (hC : Convex 𝕜 C) :
    ri[𝕜](K[𝕜 | C]) = {p : 𝕜 × E | 0 < p.1 ∧ p.2 ∈ p.1 • ri[𝕜](C)} := by
  have hK : Convex 𝕜 (K[𝕜 | C] : Set (𝕜 × E)) := hC.homogenizationSet
  by_cases hCne : C.Nonempty
  · have hproj : Prod.fst '' (K[𝕜 | C] : Set (𝕜 × E)) = Set.Ici (0 : 𝕜) := by
      ext a
      constructor
      · rintro ⟨⟨μ, x⟩, hp, rfl⟩
        rw [mem_homogenizationSet_iff 𝕜 C] at hp
        exact hp.1
      · intro ha
        rcases hCne with ⟨x, hx⟩
        refine ⟨(a, a • x), ?_, rfl⟩
        rw [mem_homogenizationSet_iff 𝕜 C]
        exact ⟨ha, Set.mem_smul_set.mpr ⟨x, hx, rfl⟩⟩
    have hbase :
        ri[𝕜](Prod.fst '' (K[𝕜 | C] : Set (𝕜 × E))) = Set.Ioi (0 : 𝕜) := by
      rw [hproj, ri_Ici]
    have hfiber (a : 𝕜) (ha : 0 < a) :
        Prod.mk a ⁻¹' (K[𝕜 | C] : Set (𝕜 × E)) = a • C := by
      ext x
      constructor
      · intro hx
        change (a, x) ∈ K[𝕜 | C] at hx
        rw [mem_homogenizationSet_iff 𝕜 C] at hx
        exact hx.2
      · intro hx
        change (a, x) ∈ K[𝕜 | C]
        rw [mem_homogenizationSet_iff 𝕜 C]
        exact ⟨ha.le, hx⟩
    have hfiber_ri (a : 𝕜) (ha : 0 < a) :
        ri[𝕜](Prod.mk a ⁻¹' (K[𝕜 | C] : Set (𝕜 × E))) = a • ri[𝕜](C) := by
      simpa [hfiber a ha] using
        hC.intrinsicInterior_linear_image (LinearMap.lsmul 𝕜 E a)
    ext p
    change p ∈ ri[𝕜]((K[𝕜 | C] : Set (𝕜 × E))) ↔ (0 < p.1 ∧ p.2 ∈ p.1 • ri[𝕜](C))
    have hmem :
        p ∈ ri[𝕜]((K[𝕜 | C] : Set (𝕜 × E))) ↔
          p.1 ∈ ri[𝕜](Prod.fst '' (K[𝕜 | C] : Set (𝕜 × E))) ∧
            p.2 ∈ ri[𝕜](Prod.mk p.1 ⁻¹' (K[𝕜 | C] : Set (𝕜 × E))) := by
      change (p.1, p.2) ∈ ri[𝕜]((K[𝕜 | C] : Set (𝕜 × E))) ↔
          p.1 ∈ ri[𝕜](Prod.fst '' (K[𝕜 | C] : Set (𝕜 × E))) ∧
            p.2 ∈ ri[𝕜](Prod.mk p.1 ⁻¹' (K[𝕜 | C] : Set (𝕜 × E)))
      simpa using hK.mem_ri_iff_mem_ri_base_and_fiber
    constructor
    · intro hp
      rcases hmem.mp hp with ⟨hp1, hp2⟩
      have hp1' : 0 < p.1 := by
        simpa [hbase] using hp1
      have hp2' : p.2 ∈ p.1 • ri[𝕜](C) := by
        simpa [hfiber_ri p.1 hp1'] using hp2
      exact ⟨hp1', hp2'⟩
    · rintro ⟨hp1, hp2⟩
      have hp1' :
          p.1 ∈ ri[𝕜](Prod.fst '' (K[𝕜 | C] : Set (𝕜 × E))) := by
        simpa [hbase] using hp1
      have hp2' :
          p.2 ∈ ri[𝕜](Prod.mk p.1 ⁻¹' (K[𝕜 | C] : Set (𝕜 × E))) := by
        simpa [hfiber_ri p.1 hp1] using hp2
      exact hmem.mpr ⟨hp1', hp2'⟩
  · have hCempty : C = ∅ := Set.not_nonempty_iff_eq_empty.mp hCne
    subst hCempty
    have hKempty : (K[𝕜 | (∅ : Set E)] : Set (𝕜 × E)) = ∅ := by
      ext p
      rw [mem_homogenizationSet_iff 𝕜 (∅ : Set E)]
      simp
    ext p
    simp [hKempty]

end Convex

end

section

variable
    {𝕜 E : Type*}
    [NontriviallyNormedField 𝕜] [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
    [TopologicalSpace E] [AddCommGroup E] [Module 𝕜 E]

namespace Convex

/-- Corollary 6.8.1, canonical cone-owner form: for a nonempty convex set `C`, the relative
interior of the generated cone `cone[𝕜] (L[𝕜 | C])` has the same relative interior as the
source-facing homogenization owner `K[𝕜 | C]`. -/
@[simp] theorem intrinsicInterior_homogenizationCone_eq_intrinsicInterior_homogenizationSet
    {C : Set E} (hC : Convex 𝕜 C) (hCne : C.Nonempty) :
    ri[𝕜](cone[𝕜] (L[𝕜 | C])) = ri[𝕜](K[𝕜 | C]) := by
  simp [pointedConeHull_lift_eq_homogenizationSet C hC hCne]

end Convex

end

section

variable
    {𝕜 E : Type*}
    [NontriviallyNormedField 𝕜] [LinearOrder 𝕜] [OrderTopology 𝕜]
    [IsStrictOrderedRing 𝕜] [CompleteSpace 𝕜]
    [NormedAddCommGroup E] [NormedSpace 𝕜 E]

namespace Convex

/-- Corollary 6.8.1, canonical cone-owner form: for a nonempty convex set `C`, the relative
interior of the generated cone `cone[𝕜] (L[𝕜 | C])` is exactly the positive-height lift of
`ri[𝕜](C)`. -/
theorem intrinsicInterior_homogenizationCone_eq {C : Set E}
    [FiniteDimensional 𝕜 E]
    (hC : Convex 𝕜 C) (hCne : C.Nonempty) :
    ri[𝕜](cone[𝕜] (L[𝕜 | C])) =
      {p : 𝕜 × E | 0 < p.1 ∧ p.2 ∈ p.1 • ri[𝕜](C)} := by
  calc
    ri[𝕜](cone[𝕜] (L[𝕜 | C])) = ri[𝕜](K[𝕜 | C]) := by
      exact intrinsicInterior_homogenizationCone_eq_intrinsicInterior_homogenizationSet hC hCne
    _ = {p : 𝕜 × E | 0 < p.1 ∧ p.2 ∈ p.1 • ri[𝕜](C)} := by
      exact intrinsicInterior_homogenizationSet_eq hC

end Convex

end

