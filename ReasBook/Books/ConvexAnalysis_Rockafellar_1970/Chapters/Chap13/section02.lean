          exact supportFunction_eq_sSup_image (L := WithTopBot ℝ) (C := (B : Set E)) (x := xStar)
    _ = sSup ((fun y : E ↦ ((xStar y : ℝ) : WithTopBot ℝ)) '' B) := by
