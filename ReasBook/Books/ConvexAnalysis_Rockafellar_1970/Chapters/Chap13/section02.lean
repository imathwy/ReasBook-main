    [SeminormedAddCommGroup X]
    (hunit : ∀ xStar : X, δᵛ(xStar | (B : Set E)) = (‖xStar‖ : WithTopBot ℝ))
    (a : E) (r : ℝ) (hr : 0 ≤ r) (xStar : X) :
    δᵛ(xStar | closedBall a r) =
      (⟪xStar, a⟫ₚ + r * ‖xStar‖ : WithTopBot ℝ) := by
