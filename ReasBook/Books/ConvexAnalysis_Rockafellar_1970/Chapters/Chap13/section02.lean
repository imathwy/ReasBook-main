    _ = (⟪xStar, a⟫ₚ : WithTopBot ℝ) + ((r * ‖xStar‖ : ℝ) : WithTopBot ℝ) := by
          simp
    _ = (⟪xStar, a⟫ₚ + r * ‖xStar‖ : WithTopBot ℝ) := by
