/-! ### Corollary_18_3_1 (from Chap04) -/
open Bornology Set
open scoped Rockafellar

section

variable {R E : Type*} [Semiring R] [PartialOrder R]
variable [AddCommMonoid E] [Module R E]
variable {points directions : Set E}

/-- Corollary 18.3.1 (1), primitive owner form: every extreme point of a mixed convex hull
generated by points and raw direction vectors is one of the original point generators. -/
-- Proof sketch: if `x` is an extreme point, then `{x}` is a nonempty extreme face of
-- `mixedConvexHull points directions`. Apply the owner theorem
-- `Set.IsFace.eq_mixedConvexHull_inter_recessionCone` to that singleton face.
-- If
-- `points ∩ {x}` were empty, then `mixedConvexHull_eq_empty_of_points_eq_empty` would force
-- `{x}` to be empty, contradiction. Hence `x ∈ points`.
theorem mem_points_of_mem_extremePoints_mixedConvexHull
    {x : E} (hx : x ∈ (mconv[R](points | directions)).extremePoints R) :
    x ∈ points := by
  have hface : ({x} : Set E).IsFace R (mconv[R](points | directions)) := by
    simpa using
      Set.IsFace.singleton_of_mem_extremePoints
        (C := mconv[R](points | directions)) (x := x) hx
  have hEq :
      ({x} : Set E) =
        mconv[R](points ∩ ({x} : Set E) | directions ∩ 0⁺[R] ({x} : Set E)) := by
    simpa using hface.eq_mixedConvexHull_inter_recessionCone
  by_contra hx_points
  have hpoints_empty : points ∩ ({x} : Set E) = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.2
    intro y hy
    rcases hy with ⟨hy_points, hy_singleton⟩
    rcases Set.mem_singleton_iff.mp hy_singleton with rfl
    exact hx_points hy_points
  have hnonempty :
      (mconv[R](points ∩ ({x} : Set E) | directions ∩ 0⁺[R] ({x} : Set E))).Nonempty := by
    rw [← hEq]
    simp
  rw [mixedConvexHull_eq_empty_of_points_eq_empty R hpoints_empty] at hnonempty
  simp at hnonempty

end

section

variable {K : Type*} [CommSemiring K] [PartialOrder K] [IsStrictOrderedRing K]
variable {E : Type*} [AddCommMonoid E] [Module K E]
variable {points : Set E} {directions : Set (Module.Ray K E)}

/-- Corollary 18.3.1 (1), source-facing owner form: every extreme point of the mixed convex hull
generated by point generators `points` and direction generators `directions` belongs to `points`.
The direction generators are represented canonically as rays and fed to `mixedConvexHull` through
`ray directions`. -/
theorem mem_points_of_mem_extremePoints_mixedConvexHull_of_rayDirections
    {x : E} (hx : x ∈ (mconv[K](points | ray directions)).extremePoints K) :
    x ∈ points := by
  exact mem_points_of_mem_extremePoints_mixedConvexHull
    (points := points) (directions := ray directions) hx

end

section

variable {K : Type*} [CommSemiring K] [PartialOrder K] [IsStrictOrderedRing K]
variable {E : Type*} [Bornology E] [AddCancelCommMonoid E] [Module K E]
variable {points : Set E} {directions : Set (Module.Ray K E)}

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 18.3.1 extracts from Theorem 18.3 the two singleton and half-line
  special cases: extreme points come from the original point generators, and, under the stated
  boundedness exclusion on point generators lying on half-lines, extreme directions come from the
  original direction generators.
- `core/canonical`: the owner abstractions already present in the project are
  `mconv[K](points | ray directions)` for the generated set,
  `C.extremePoints K` for extreme points, `C.extremeDirections K` for extreme directions,
  and `Set.IsFace.eq_mixedConvexHull_inter_recessionCone` for faces of mixed
  convex hulls.
- `bridge/view`: the textbook set of directions is represented by rays
  `directions : Set (Module.Ray K E)`, which enter the mixed hull through the chapter notation
  `ray directions`.

Domain-style sampling used here:
- `mixedConvexHull_eq_empty_of_points_eq_empty`;
- `rayOfDirections`;
- `Set.extremePoints` and `mem_extremePoints`;
- `C.extremeDirections` and `mem_extremeDirections_iff`;
- `Set.IsFace.eq_mixedConvexHull_inter_recessionCone`.

Primitive data vs derived API:
- primitive inputs: the point generators and the direction generators;
- derived API: the point-membership and direction-membership consequences for extreme faces of the
  generated mixed convex hull.

Ambient refinement:
- the primitive owner theorem
  `mem_points_of_mem_extremePoints_mixedConvexHull` is stated on raw direction vectors;
- the source-facing ray theorem
  `mem_points_of_mem_extremePoints_mixedConvexHull_of_rayDirections` is a bridge onto the
  chapter's ray-owner surface `mconv[K](points | ray directions)`;
- the direction statements use only two primitive boundedness bridges:
  preservation of boundedness by `convexHull`, and unboundedness of affine half-lines;
  both are exposed as theorem inputs so the owner surface stays at the scalar-generic
  ordered-semiring layer.

Layer target: `source-facing`, stated directly with the canonical project owners and without
introducing a wrapper around mixed hulls generated by points and directions.
-/

/-- Corollary 18.3.1 (2): assume boundedness is preserved by `convexHull`, every affine half-line
is unbounded, and every affine half-line contained in the mixed convex hull generated by `points`
and `directions` meets the point generators in a bounded set. Then every extreme direction of that
mixed convex hull belongs to the original direction set. -/
-- Proof sketch: let `r` be an extreme direction, witnessed by an extreme affine half-line
-- `affineHalfLine x r`. Apply
-- `Set.IsFace.eq_mixedConvexHull_inter_recessionCone` to that nonempty face.
-- The
-- resulting generating point set is `points ∩ affineHalfLine x r`, which is bounded by
-- hypothesis. If no generator from `directions` points along `r`, then the induced mixed hull is
-- generated only by that bounded point set, so it cannot equal the whole affine half-line.
-- Therefore one of the induced direction generators must have ray `r`, and hence `r ∈ directions`.
theorem mem_directions_of_mem_extremeDirections_mixedConvexHull
    (hbounded_convexHull :
      ∀ {s : Set E}, IsBounded s → IsBounded (convexHull K s))
    (hnot_isBounded_affineHalfLine :
      ∀ (x : E) (r' : Module.Ray K E), ¬ IsBounded (affineHalfLine x r'))
    (hpoints_on_affineHalfLine :
      ∀ ⦃x : E⦄ ⦃r' : Module.Ray K E⦄,
        affineHalfLine x r' ⊆ mconv[K](points | ray directions) →
          IsBounded (points ∩ affineHalfLine x r'))
    {r : Module.Ray K E}
    (hr : r ∈ (mconv[K](points | ray directions)).extremeDirections K) :
    r ∈ directions := by
  rcases mem_extremeDirections_iff.mp hr with ⟨x, hx⟩
  have hF_eq :
      affineHalfLine x r =
        mconv[K](points ∩ affineHalfLine x r |
          ray directions ∩ 0⁺[K] (affineHalfLine x r)) := by
    simpa using Set.IsFace.eq_mixedConvexHull_inter_recessionCone hx
  have hpoints_bounded : IsBounded (points ∩ affineHalfLine x r) := by
    exact hpoints_on_affineHalfLine hx.subset
  by_contra hr_not_mem
  have hdirections_zero :
      ray directions ∩ 0⁺[K] (affineHalfLine x r) ⊆ ({0} : Set E) := by
    intro v hv
    rcases hv with ⟨hvdir, hvrecession⟩
    rcases (mem_ray_iff directions v).1 hvdir with rfl | ⟨hv0, hvdir'⟩
    · simp
    · have hvr : rayOfNeZero K v hv0 = r :=
        rayOfNeZero_eq_of_mem_recessionCone_affineHalfLine hvrecession hv0
      exact False.elim <| hr_not_mem <| by simpa [hvr] using hvdir'
  have hF_bounded : IsBounded (affineHalfLine x r) := by
    rw [hF_eq, mixedConvexHull_eq_convexHull_of_directions_subset_zero K hdirections_zero]
    exact hbounded_convexHull hpoints_bounded
  exact (hnot_isBounded_affineHalfLine x r) hF_bounded

/-- If boundedness is preserved by `convexHull`, every affine half-line is unbounded, and the
point generators are bounded, then every extreme direction of the generated mixed convex hull
already belongs to the prescribed direction set. -/
-- Proof sketch: apply
-- `mem_directions_of_mem_extremeDirections_mixedConvexHull`; the intersection of a bounded set of
-- points with any affine half-line remains bounded.
theorem mem_directions_of_mem_extremeDirections_mixedConvexHull_of_bounded_points
    (hbounded_convexHull :
      ∀ {s : Set E}, IsBounded s → IsBounded (convexHull K s))
    (hnot_isBounded_affineHalfLine :
      ∀ (x : E) (r' : Module.Ray K E), ¬ IsBounded (affineHalfLine x r'))
    (hpoints_bounded : IsBounded points) {r : Module.Ray K E}
    (hr : r ∈ (mconv[K](points | ray directions)).extremeDirections K) :
    r ∈ directions := by
  refine mem_directions_of_mem_extremeDirections_mixedConvexHull
    hbounded_convexHull hnot_isBounded_affineHalfLine ?_ hr
  intro x r' _
  exact hpoints_bounded.subset (inter_subset_left : points ∩ affineHalfLine x r' ⊆ points)

end

/-! ### Text_18_3_1 (from Chap04) -/
universe u v

section

open Set
open scoped Rockafellar

variable {𝕜 : Type v} [Semiring 𝕜]
variable {E : Type u} [AddCommGroup E] [Module 𝕜 E]

/-!
Source/core/bridge triage:

- `source-facing`: the text says that if the lineality space of `C` is nontrivial, then `C` has
  no extreme points.
- `core/canonical`: the owner objects are the project-level `Set.lineal` and mathlib's
  `Set.extremePoints 𝕜 C`.
- `bridge/view`: the source-facing nontriviality condition
  `Set.lineal 𝕜 C ≠ ({0} : Set E)` is kept as a bridge corollary. The primitive public theorem
  uses the owner-side data `∃ y, y ≠ 0 ∧ y ∈ lin[𝕜](C)`.

Domain-style sampling used here:
- `Set.lineal`;
- `Set.mem_lineal_iff`;
- `Set.mem_lineal_iff_forall`;
- `Set.extremePoints`;
- `openSegment`.

Primitive data vs derived API:
- the primitive input is the set `C` together with the existence of a nonzero direction in
  `lin[𝕜](C)`;
- midpoint data are primitive in this abstraction layer: we assume the existence of
  `a : 𝕜` with `0 < a` and `a + a = 1`;
- the source-facing nontriviality condition `lin[𝕜](C) ≠ ({0} : Set E)` is kept as a bridge form;
- the conclusion that `C` has no extreme points is theorem-level content, best expressed as
  `C.extremePoints 𝕜 = ∅`.

Ambient refinement:
- the proof only uses the canonical owners `lin[𝕜](C)` and `C.extremePoints 𝕜`, plus the direct
  open-segment witness at coefficients `(a, a)` where `a + a = 1`;
- the `⅟2` specialization is kept only as a convenience bridge.

The textbook mentions convexity, but for the canonical lineal owner the conclusion only uses the
existence of a nonzero direction in `lin[𝕜](C)`, so no separate convexity hypothesis is needed in
the statement.
-/

/- Text 18.3.1: if the lineality space of `C` is nontrivial, then `C` has no extreme points.
For nonempty `C`, this hypothesis implies that `C` contains a line; the file keeps the stronger
canonical lineality-space hypothesis rather than asserting that geometric reformulation as an
equivalence. -/
-- Proof sketch: choose a nonzero `v ∈ lin[𝕜](C)`. For any `x ∈ C`, membership in the
-- lineality space gives `x + v ∈ C` and `x - v ∈ C`, while `x` is the midpoint of those two
-- distinct points. Hence `x` lies in a nontrivial open segment with endpoints in `C`, so
-- `x ∉ C.extremePoints 𝕜`. Therefore `C.extremePoints 𝕜 = ∅`.
/-- Primitive public form of Text 18.3.1: a nonzero direction in `lin[𝕜](C)` forces the
extreme-point set of `C` to be empty, assuming explicit midpoint data. -/
theorem extremePoints_eq_empty_of_exists_ne_zero_mem_lineal_of_exists_midpoint
    [PartialOrder 𝕜] [ZeroLEOneClass 𝕜]
    {C : Set E}
    (hmid : ∃ a : 𝕜, 0 < a ∧ a + a = 1)
    (hlineal : ∃ y : E, y ≠ 0 ∧ y ∈ lin[𝕜](C)) :
    C.extremePoints 𝕜 = ∅ := by
  rw [eq_empty_iff_forall_notMem]
  intro x hxext
  rcases hmid with ⟨a, ha_pos, ha_sum⟩
  rcases hlineal with ⟨y, hy0, hy⟩
  rcases mem_extremePoints.mp hxext with ⟨hxC, hxextreme⟩
  have hy_forall := mem_lineal_iff_forall.mp hy
  have hx_sub : x - y ∈ C := by
    simpa [sub_eq_add_neg] using hy_forall.1 x hxC 1 zero_le_one
  have hx_add : x + y ∈ C := by
    simpa using hy_forall.2 x hxC 1 zero_le_one
  have hx_seg : x ∈ openSegment 𝕜 (x - y) (x + y) := by
    refine ⟨a, a, ha_pos, ha_pos, ha_sum, ?_⟩
    calc
      a • (x - y) + a • (x + y) = a • ((x - y) + (x + y)) := by rw [← smul_add]
      _ = a • (x + x) := by abel_nf
      _ = a • x + a • x := by rw [smul_add]
      _ = (a + a) • x := by rw [add_smul]
      _ = (1 : 𝕜) • x := by rw [ha_sum]
      _ = x := by simp
  have hx_eq := hxextreme (x - y) hx_sub (x + y) hx_add hx_seg
  have hy_zero : y = 0 := by
    have hx_eq' : x + y = x + 0 := by
      simpa using hx_eq.2
    exact add_left_cancel hx_eq'
  exact hy0 hy_zero

/-- Source-facing bridge form of Text 18.3.1: nontrivial lineality
`lin[𝕜](C) ≠ ({0} : Set E)` forces the extreme-point set to be empty. -/
theorem extremePoints_eq_empty_of_lineal_nontrivial_of_exists_midpoint
    [PartialOrder 𝕜] [ZeroLEOneClass 𝕜]
    {C : Set E}
    (hmid : ∃ a : 𝕜, 0 < a ∧ a + a = 1)
    (hlineal : lin[𝕜](C) ≠ ({0} : Set E)) :
    C.extremePoints 𝕜 = ∅ := by
  have hzero : (0 : E) ∈ lin[𝕜](C) := by
    rw [mem_lineal_iff_forall]
    constructor <;> intro x hx a ha <;> simpa using hx
  have hnonzero : ∃ y : E, y ≠ 0 ∧ y ∈ lin[𝕜](C) := by
    by_contra hnonzero
    apply hlineal
    rw [Set.eq_singleton_iff_unique_mem]
    exact ⟨hzero, fun y hy ↦ by
      by_contra hy0
      exact hnonzero ⟨y, hy0, hy⟩⟩
  exact extremePoints_eq_empty_of_exists_ne_zero_mem_lineal_of_exists_midpoint hmid hnonzero

/-- Ordered-ring convenience corollary of
`extremePoints_eq_empty_of_exists_ne_zero_mem_lineal_of_exists_midpoint`. -/
theorem extremePoints_eq_empty_of_exists_ne_zero_mem_lineal_of_invOf_two_pos {C : Set E}
    [PartialOrder 𝕜] [ZeroLEOneClass 𝕜] [Invertible (2 : 𝕜)]
    (hhalf_pos : 0 < ⅟(2 : 𝕜))
    (hlineal : ∃ y : E, y ≠ 0 ∧ y ∈ lin[𝕜](C)) :
    C.extremePoints 𝕜 = ∅ := by
  refine extremePoints_eq_empty_of_exists_ne_zero_mem_lineal_of_exists_midpoint
    (hmid := ⟨⅟(2 : 𝕜), hhalf_pos, invOf_two_add_invOf_two⟩)
    hlineal

/-- Lineality-nontrivial bridge corollary using `⅟2`: if `⅟2` is positive, then
`lin[𝕜](C) ≠ ({0} : Set E)` forces `C.extremePoints 𝕜 = ∅`. -/
theorem extremePoints_eq_empty_of_lineal_nontrivial_of_invOf_two_pos {C : Set E}
    [PartialOrder 𝕜] [ZeroLEOneClass 𝕜] [Invertible (2 : 𝕜)]
    (hhalf_pos : 0 < ⅟(2 : 𝕜))
    (hlineal : lin[𝕜](C) ≠ ({0} : Set E)) :
    C.extremePoints 𝕜 = ∅ := by
  refine extremePoints_eq_empty_of_lineal_nontrivial_of_exists_midpoint
    (hmid := ⟨⅟(2 : 𝕜), hhalf_pos, invOf_two_add_invOf_two⟩)
    hlineal

/-- Ordered-ring convenience corollary of
`extremePoints_eq_empty_of_exists_ne_zero_mem_lineal_of_invOf_two_pos`. -/
theorem extremePoints_eq_empty_of_exists_ne_zero_mem_lineal {C : Set E}
    [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] [Invertible (2 : 𝕜)]
    (hlineal : ∃ y : E, y ≠ 0 ∧ y ∈ lin[𝕜](C)) :
    C.extremePoints 𝕜 = ∅ := by
  exact extremePoints_eq_empty_of_exists_ne_zero_mem_lineal_of_invOf_two_pos
    ((invOf_pos (a := (2 : 𝕜))).2 two_pos) hlineal

/-- Ordered-ring convenience corollary of
`extremePoints_eq_empty_of_lineal_nontrivial_of_invOf_two_pos`. -/
theorem extremePoints_eq_empty_of_lineal_nontrivial {C : Set E}
    [LinearOrder 𝕜] [IsStrictOrderedRing 𝕜] [Invertible (2 : 𝕜)]
    (hlineal : lin[𝕜](C) ≠ ({0} : Set E)) :
    C.extremePoints 𝕜 = ∅ := by
  exact extremePoints_eq_empty_of_lineal_nontrivial_of_invOf_two_pos
    ((invOf_pos (a := (2 : 𝕜))).2 two_pos) hlineal

end

/-! ### Theorem_18_3 (from Chap04) -/
section

variable {R E : Type*} [Semiring R] [PartialOrder R] [AddCommMonoid E] [SMul R E]

open scoped Rockafellar

/-!
Source/core/bridge triage:

- Primary mathematical domain: extreme subsets and faces of mixed convex hulls over an ordered
  semiring scalar-action space.
- `source-facing`: Theorem 18.3 says that a face of a mixed convex hull is itself the
  mixed convex hull generated by the original points lying in that face together with the original
  directions that are recession directions of the face.
- `core/canonical`: the owner abstractions are the chapter face predicate `Set.IsFace` together
  with the chapter owners `mixedConvexHull` and `recessionCone`; the extreme-subset predicate
  `IsExtreme` is primitive data internal to the face owner.
- `bridge/view`: the proof route can be organized through the primitive pair consisting of the
  extreme-subset predicate `IsExtreme` and the convexity of the face.

Domain-style sampling used here:
- mathlib's owner `IsExtreme`;
- `Set.IsFace`;
- `mixedConvexHull` and `mixedConvexHull_min`;
- `directions_subset_recessionCone_mixedConvexHull`;
- the Chapter 2 owner `0⁺[R] C`.

Primitive data vs derived API:
- primitive proof input: the original sets of points and directions, an extreme subset `C'`, its
  convexity, and the owner mixed-convex-hull / recession-cone data;
- owner input: the source-facing face hypothesis `C'.IsFace R (...)`, whose convexity and
  extreme-set components project to the primitive proof input;
- derived API: the equality identifying the face `C'` with the mixed convex hull generated by the
  induced point set and induced recession-direction set.

Layer target:
- `source-facing` for the public theorem on `Set.IsFace`.

Ambient refinement: the owner declarations `Set.IsFace`, `mixedConvexHull`, and `recessionCone`
already live on the ordered-semiring scalar-action layer. A stronger relative-interior proof route
may use additional structure internally, but that proof debt should not be frozen into the public
statement.
-/

namespace Set.IsFace

/-- Theorem 18.3 on the canonical owner surface: any face `F` of
`mconv[R](points | directions)` is exactly the mixed convex hull generated by the original points
lying in `F` and the original directions that belong to the recession cone of `F`. -/
-- Proof sketch: the inclusion from right to left follows from minimality of `mconv[R](· | ·)`,
-- because `F` is convex, contains `points ∩ F`, and recedes in every direction from
-- `directions ∩ 0⁺[R] F`. For the reverse inclusion, one may pass through a stronger
-- relative-interior argument on finitely generated auxiliary mixed hulls, but that proof debt is
-- internal and does not belong in the theorem statement. If `F = ∅`,
-- then `points ∩ F = ∅`, so `mixedConvexHull_eq_empty_of_points_eq_empty` handles the empty
-- case directly.
theorem eq_mixedConvexHull_inter_recessionCone
    {points directions F : Set E}
    (hF : F.IsFace R (mconv[R](points | directions))) :
    F = mconv[R](points ∩ F | directions ∩ 0⁺[R] F) := by
  sorry

/-- Bridge form of Theorem 18.3: if a face is stated against an ambient `C` equipped with a mixed
convex-hull presentation, rewrite to the owner form
`eq_mixedConvexHull_inter_recessionCone`. -/
theorem eq_mixedConvexHull_inter_recessionCone_of_eq_mixedConvexHull
    {C points directions F : Set E}
    (hF : F.IsFace R C) (hC : C = mconv[R](points | directions)) :
    F = mconv[R](points ∩ F | directions ∩ 0⁺[R] F) := by
  subst hC
  simpa using hF.eq_mixedConvexHull_inter_recessionCone

/-- Face-family notation form of Theorem 18.3: if `F ∈ 𝓕[R](mconv[R](points | directions))`,
then `F` is the mixed convex hull generated by points in `F` and directions in `F`'s
recession cone. -/
theorem eq_mixedConvexHull_inter_recessionCone_of_mem_faces
    {points directions F : Set E}
    (hF : F ∈ 𝓕[R](mconv[R](points | directions))) :
    F = mconv[R](points ∩ F | directions ∩ 0⁺[R] F) := by
  exact (mem_faces_iff.mp hF).eq_mixedConvexHull_inter_recessionCone

/-- Face-family notation bridge form of Theorem 18.3: if `F ∈ 𝓕[R](C)` and `C` is given by a
mixed-convex-hull presentation, rewrite to the canonical mixed-hull description of `F`. -/
theorem eq_mixedConvexHull_inter_recessionCone_of_mem_faces_of_eq_mixedConvexHull
    {C points directions F : Set E}
    (hF : F ∈ 𝓕[R](C)) (hC : C = mconv[R](points | directions)) :
    F = mconv[R](points ∩ F | directions ∩ 0⁺[R] F) := by
  exact
    (mem_faces_iff.mp hF).eq_mixedConvexHull_inter_recessionCone_of_eq_mixedConvexHull hC

end Set.IsFace

end
