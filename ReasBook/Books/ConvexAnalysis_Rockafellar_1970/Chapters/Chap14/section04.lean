/-- The textbook coordinate involution `(λ⋆, x⋆, μ⋆) ↦ (-μ⋆, x⋆, -λ⋆)` on triples. -/
def dualCoordinateTransform {𝕜 : Type*} [Ring 𝕜] {X : Type*} [AddCommMonoid X] [Module 𝕜 X] :
    T[𝕜;X] ≃ₗ[𝕜] T[𝕜;X] :=
  (LinearEquiv.prodAssoc 𝕜 𝕜 X 𝕜).symm.trans <|
    (LinearEquiv.prodComm 𝕜 (𝕜 × X) 𝕜).trans <|
      ((LinearEquiv.neg 𝕜).prodCongr (LinearEquiv.prodComm 𝕜 𝕜 X)).trans <|
        (LinearEquiv.refl 𝕜 𝕜).prodCongr
          ((LinearEquiv.refl 𝕜 X).prodCongr (LinearEquiv.neg 𝕜))

@[simp] theorem dualCoordinateTransform_apply {𝕜 : Type*} [Ring 𝕜] {X : Type*}
    [AddCommMonoid X] [Module 𝕜 X] (p : T[𝕜;X]) :
    dualCoordinateTransform p = (-p.2.2, p.2.1, -p.1) := by
  rfl

variable {𝕜 : Type w}
variable [Field 𝕜] [PartialOrder 𝕜] [IsOrderedRing 𝕜]
variable [TopologicalSpace 𝕜] [TopologicalSpace (WithTopBot 𝕜)]
variable {E : Type u} {F : Type v}
variable [TopologicalSpace E] [AddCommGroup E] [Module 𝕜 E]
variable [TopologicalSpace F] [AddCommMonoid F] [Module 𝕜 F]
variable [FiniteDimensional 𝕜 E]
variable [HasLinearPairing E F 𝕜]
local notation "IsClosedProperConvex[" 𝕜 "]" => Function.IsClosedProperConvex (𝕜 := 𝕜)

variable (f : E → WithTopBot 𝕜)

local notation "f⋆" => (convexConjugate f : F → WithTopBot 𝕜)

/-- The Chapter 14 primal cone generated by the height-one epigraph slice of `f`. -/
def primalEpigraphCone : PointedCone 𝕜 T[𝕜;E] :=
  cone[𝕜] ({(1 : 𝕜)} ×ˢ epi f : Set T[𝕜;E])

/-- The Chapter 14 dual-side cone generated by the height-one epigraph slice of `f⋆`. -/
def conjugateEpigraphCone : PointedCone 𝕜 T[𝕜;F] :=
  cone[𝕜] ({(1 : 𝕜)} ×ˢ epi f⋆ : Set T[𝕜;F])

-- Proof sketch: let
-- `K := cone[𝕜] ({(1 : 𝕜)} ×ˢ epi f : Set T[𝕜;E])`.
-- Properness puts the relevant closure of `K` in the half-space `λ ≥ 0` without collapsing it to
-- its boundary, so the chapter polar/closure bridge identifies the source polar set
-- `{y | ∀ z ∈ K, (⟪z, y⟫ₚ : 𝕜) ≤ 0}` with the closure of the cone generated by its section at
-- `λ⋆ = -1` after the coordinate transform
-- `(λ⋆, x⋆, μ⋆) ↦ (-μ⋆, x⋆, -λ⋆)`. Unfolding the defining inequality against the generators
-- `(1, x, μ)` with `μ ≥ f x` rewrites it as `μ⋆ ≥ f⋆ x⋆`, so the transformed section is exactly
-- the primal height-one slice for `f⋆`.
/-- Theorem 14.4: for a closed proper convex function `f` on a finite-dimensional topological
`𝕜`-module `E`, paired with a dual space `F` for the Fenchel conjugate and the chapter cone-polar
owner, if `K := primalEpigraphCone f` and `K⋆ := conjugateEpigraphCone f`, then
`((conjugateEpigraphCone f).closure : Set T[𝕜;F]) =
  dualCoordinateTransform ⁻¹' ((primalEpigraphCone f)ᵒ[𝕜] : Set T[𝕜;F])`.
In the source triple coordinates, this is exactly the textbook identity
`cl K⋆ = {(λ⋆, x⋆, μ⋆) | (-μ⋆, x⋆, -λ⋆) ∈ Kᵒ[𝕜]}`. -/
theorem closure_conjugateEpigraphCone_eq_preimage_polarCone
    (hf : IsClosedProperConvex[𝕜] f) :
    ((conjugateEpigraphCone f).closure : Set T[𝕜;F]) =
      dualCoordinateTransform ⁻¹' ((primalEpigraphCone f)ᵒ[𝕜] : Set T[𝕜;F]) := by
  sorry

end
