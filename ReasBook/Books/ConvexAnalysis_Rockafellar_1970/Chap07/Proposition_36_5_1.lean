import Mathlib
import ConvexAnalysis_Rockafellar_1970.Chap01.HasPairing
import ConvexAnalysis_Rockafellar_1970.Chap06.Definition_6_29_15
import ConvexAnalysis_Rockafellar_1970.Chap06.Definition_6_30_11
import ConvexAnalysis_Rockafellar_1970.Chap06.Definition_6_30_4
import ConvexAnalysis_Rockafellar_1970.Chap06.Definition_6_30_14
import ConvexAnalysis_Rockafellar_1970.Chap07.Definition33_0_1
import ConvexAnalysis_Rockafellar_1970.Chap07.Definition33_0_42
import ConvexAnalysis_Rockafellar_1970.Chap07.Theorem_36_5

noncomputable section

open scoped Rockafellar

universe u v w

namespace Bifunction

section Reconstruction

variable {U : Type u} {X : Type v} {UStar : Type w}

/-!
Source/core/bridge triage:

- `source-facing`: Proposition 36.5.1 computes the primal and dual objective values attached to
  the bifunction reconstructed from an upper closed concave-convex saddle-function `L`.
- `core/canonical`: the owner abstractions are the Chapter 6/7 Lagrangian owner
  `lagrangian (toOrderDual (-L))`, the Chapter 6 value owners `optimalValue` and
  `upperPerturbationFunction`, the zero-slice objective `(·)₀`, and the adjoint bifunction owner
  `adjoint`.
- `bridge/view`: Theorem 36.5 identifies `lagrangian (toOrderDual (-L))` with the Chapter 34
  representative `upperConcavePairing (Function.swap L)`, so the source formulas are stated on
  the canonical Lagrangian owner and only use the Chapter 34 presentation as a companion bridge.

Domain-style sampling used here:
- `lagrangian_toOrderDual_eq_upperConcavePairing_inverse` and
  `lagrangian_toOrderDual_eq_iInf_pairing_sub_inverse` from `Chap07.Theorem_36_5`;
- `optimalValue` and `optimalValue_eq_iInf` from `Chap06.Definition_6_29_15`;
- `upperPerturbationFunction` and `upperPerturbationFunction_zero_eq_iSup_objective` from
  `Chap06.Definition_6_30_11`;
- `concaveConjugate` / `(·)∗` from `Chap06.Definition_6_30_4`;
- `lagrangian` from `Chap06.Definition_6_30_13`, reused through `Chap07.Theorem_36_5`;
- `(·)₀` from `Chap06.Definition_6_29_12`;
- `adjoint` and `objective_adjoint_apply` from `Chap06.Definition_6_30_14`;
- `SaddleFunction.IsConcaveConvex` and `SaddleFunction.IsUpperClosed` from
  `Definition33_0_1` and `Definition33_0_42`.

Primitive data vs derived API:
- primitive source data: the saddle-function `L : UStar → X → WithBotTop α`;
- primitive owner surface reused here: the reconstructed bifunction
  `-lagrangian (toOrderDual (-L))`, the Chapter 6 value owners `optimalValue` and
  `upperPerturbationFunction`, the zero-slice notation `(·)₀`, and the adjoint owner;
- derived API recorded here: the five source formulas of Proposition 36.5.1.

Layer target: `bridge/view`.
-/

section Primal

/-
The primal formulas use the Chapter 6 zero-perturbation owners `(·)₀` and `optimalValue`, so the
ambient perturbation space `U` must carry its canonical zero point here.
-/
variable {α : Type*}
variable [AddCommGroup α] [ConditionallyCompleteLinearOrder α]
variable [HasPairing U UStar α]

local instance : HasPairing UStar U (WithBotTop α) := HasPairing.swap

variable [Zero U]

variable (L : UStar → X → WithBotTop α)

local notation "Lrec" => (-lagrangian (toOrderDual (-L)) : U → X → WithBotTop α)

-- Proof sketch: evaluate the zero slice `(-lagrangian (toOrderDual (-L)))₀` at `x`, then
-- simplify the pairing term `⟪0, u⋆⟫ₚ`.
/-- Proposition 36.5.1 (1): the primal objective attached to the bifunction reconstructed from
`L` is the pointwise supremum `x ↦ sup_{u⋆} L(u⋆, x)`. -/
theorem objective_reconstruction_eq_iSup
    (x : X) :
    ((Lrec)₀) x = ⨆ uStar : UStar, L uStar x := sorry

-- Proof sketch: apply `iInf` to `objective_reconstruction_eq_iSup`, then rewrite the left-hand
-- side by `optimalValue_eq_iInf`.
/-- Proposition 36.5.1 (2): the primal optimal value of the program generated by the
reconstruction of `L` is `inf_x sup_{u⋆} L(u⋆, x)`. -/
theorem optimalValue_reconstruction_eq_iInf_iSup :
    optimalValue Lrec = ⨅ x : X, ⨆ uStar : UStar, L uStar x := sorry

end Primal

section Dual

/-
Abstraction boundary note:

- clauses (3)–(5) stay on the same canonical owner layer as `lagrangian`/`adjoint` and
  `concaveConjugate`;
- this owner layer is codomain-generic over `WithBotTop 𝕜`, so the source formulas below are
  stated directly at that abstraction level.
-/

variable {𝕜 : Type*} {XStar : Type*}
variable [Semiring 𝕜] [AddCommGroup 𝕜] [ConditionallyCompleteLinearOrder 𝕜]
variable [TopologicalSpace 𝕜]
variable [TopologicalSpace UStar] [AddCommMonoid UStar] [Neg UStar] [SMul 𝕜 UStar]
variable [TopologicalSpace X] [AddCommMonoid X] [SMul 𝕜 X]
variable [Zero XStar]
variable [HasPairing U UStar 𝕜] [HasPairing X XStar 𝕜]

local instance : HasPairing UStar U (WithBotTop 𝕜) := HasPairing.swap

variable (L : UStar → X → WithBotTop 𝕜)

local notation "Lrec" => (-lagrangian (toOrderDual (-L)) : U → X → WithBotTop 𝕜)
local notation "Lrec⋆" =>
  ((Lrec : U → X → WithBotTop 𝕜)⋆ : XStar → UStar → WithBotTop 𝕜)

-- Proof sketch: under the upper-closed concave-convex hypotheses, the adjoint of the
-- reconstructed kernel recovers the concave conjugate of the `u⋆`-slice `x ↦ L(u⋆, x)`.
/-- Owner form of Proposition 36.5.1 (3): for an upper closed concave-convex saddle-function
`L`, the adjoint of the reconstructed bifunction is the concave conjugate of the `u⋆`-slice of
`L`. -/
theorem adjointFunction_reconstruction_eq_concaveConjugate
    (hL_concaveConvex : SaddleFunction.IsConcaveConvex 𝕜 L)
    (hL_upperClosed : SaddleFunction.IsUpperClosed L)
    (xStar : XStar) (uStar : UStar) :
    Lrec⋆ xStar uStar = (L uStar)∗ xStar := sorry

-- Proof sketch: rewrite the concave conjugate above by its defining infimum formula.
/-- Proposition 36.5.1 (3): for an upper closed concave-convex saddle-function `L`, the adjoint
relation for the reconstructed bifunction identifies the adjoint slice at `x⋆` with the function
`u⋆ ↦ inf_{x'} (⟪x', x⋆⟫ₚ - L(u⋆, x'))`. -/
theorem adjointFunction_reconstruction_eq_iInf_pairing_sub
    (hL_concaveConvex : SaddleFunction.IsConcaveConvex 𝕜 L)
    (hL_upperClosed : SaddleFunction.IsUpperClosed L)
    (xStar : XStar) (uStar : UStar) :
    Lrec⋆ xStar uStar = ⨅ x' : X, ⟪x', xStar⟫ₚ - L uStar x' := sorry

-- Proof sketch: specialize `adjointFunction_reconstruction_eq_iInf_pairing_sub` to `x⋆ = 0`,
-- then simplify `⟪x', 0⟫ₚ`.
/-- Proposition 36.5.1 (4): for an upper closed concave-convex saddle-function `L`, the dual
objective of the reconstructed bifunction is the pointwise infimum
`u⋆ ↦ inf_x (-L(u⋆, x))`. -/
theorem objective_adjointFunction_reconstruction_eq_iInf
    (hL_concaveConvex : SaddleFunction.IsConcaveConvex 𝕜 L)
    (hL_upperClosed : SaddleFunction.IsUpperClosed L)
    (uStar : UStar) :
    ((Lrec⋆)₀) uStar = ⨅ x : X, -L uStar x := sorry

-- Proof sketch: apply `iSup` to `objective_adjointFunction_reconstruction_eq_iInf`, then rewrite
-- the left-hand side by `upperPerturbationFunction_zero_eq_iSup_objective`.
/-- Proposition 36.5.1 (5): for an upper closed concave-convex saddle-function `L`, the dual
optimal value of the reconstructed bifunction is `sup_{u⋆} inf_x (-L(u⋆, x))`. -/
theorem upperPerturbationFunction_adjointFunction_reconstruction_zero_eq_iSup_iInf
    (hL_concaveConvex : SaddleFunction.IsConcaveConvex 𝕜 L)
    (hL_upperClosed : SaddleFunction.IsUpperClosed L) :
    upperPerturbationFunction (Lrec⋆) 0 =
      ⨆ uStar : UStar, ⨅ x : X, -L uStar x := sorry

end Dual

end Reconstruction

end Bifunction
