import Mathlib
import ConvexAnalysis_Rockafellar_1970.Chap06.Theorem_6_30_11
import ConvexAnalysis_Rockafellar_1970.Chap07.Defn_34_2
import ConvexAnalysis_Rockafellar_1970.Chap07.Defn_34_3

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u v

open Function
open scoped Rockafellar

namespace Bifunction

section

open SaddleFunction

variable {U : Type u} {X : Type v}
variable [NormedAddCommGroup U] [NormedSpace ℝ U] [FiniteDimensional ℝ U]
variable [NormedAddCommGroup X] [NormedSpace ℝ X] [FiniteDimensional ℝ X]
variable [HasLinearPairing U U ℝ] [HasContinuousPairing U U ℝ]
variable [HasLinearPairing X X ℝ] [HasContinuousPairing X X ℝ]

local instance : Neg (WithBotTop ℝ) := WithBotTop.instNeg

/-!
Source/core/bridge triage for this item.

- `source-facing`: Text 34.2.4 says that if a closed convex bifunction `F` is proper, then every
  saddle-function in the generated class `Ω(F)` is proper in the Chapter 34 sense. For this
  properness conclusion, the source's closedness hypothesis is redundant.
- `core/canonical`: the owner layer is already present upstream: `Ω(F)` from `Defn_34_2`,
  graph-function properness as `(uncurry F).IsProper`, and Chapter 34 saddle properness
  `SaddleFunction.IsProper`.
- `bridge/view`: the proof should therefore reuse the source-domain nonemptiness owners
  `Function.IsProper.nonempty_dom` and `adjointFunction_isProper_iff`, together with the sandwich
  owner `K ∈ Ω(F)`, rather than introducing a second local wrapper around properness.

Primary mathematical domain:
- Chapter 34 saddle classes generated by a closed convex bifunction, together with graph
  properness and the two source domains `dom F` and `dom (-adjoint X U F)`.

Domain-style sampling used here:
- `Bifunction.mem_omega_iff` from `Defn_34_2`;
- `SaddleFunction.IsProper` and `SaddleFunction.isProper_iff` from `Defn_34_3`;
- `Function.IsProper.nonempty_dom` from `Chap01.Definition_4_6`;
- `Bifunction.adjointFunction_isProper_iff` from `Chap06.Theorem_6_30_11`.

Primitive data vs derived API:
- primitive source data: a convex bifunction `F : U → X → WithBotTop ℝ` and a saddle-function
  `K ∈ Ω(F)`;
- primitive owner hypotheses: `(uncurry F).IsConvex ℝ`, `(uncurry F).IsProper`, and `K ∈ Ω(F)`;
- derived API: the Chapter 34 properness conclusion `SaddleFunction.IsProper K`.

Layer target: `source-facing`, stated directly on the existing owner layer from
`Defn_34_2` / `Defn_34_3` and the Chapter 6 adjoint-properness owner.
-/

-- Proof sketch: choose a finite graph point `(u, x)` of `F` from `hF_proper.nonempty_dom`, and a
-- finite graph point `(x⋆, u⋆)` of `-adjoint X U F` using `adjointFunction_isProper_iff`.
-- Membership `K ∈ Ω(F)` gives
-- `lowerPairing X F ≤ K ≤ upperPairing F`. The witness `u` forces `u ∈ dom₁ K` because each
-- lower-pairing value at `u` is bounded below by one finite pairing term, and the witness `x⋆`
-- forces `x⋆ ∈ dom₂ K` because each upper-pairing value at `x⋆` is bounded above by one finite
-- adjoint-slice pairing term.
/-- Text 34.2.4, properness clause: under the graph-convexity and graph-properness hypotheses,
every saddle-function `K ∈ Ω(F)` is proper in the Chapter 34 sense. The source's closedness
hypothesis is redundant for this conclusion. -/
theorem isProper_of_mem_omega_of_uncurry_isConvex_of_uncurry_isProper
    {F : U → X → WithBotTop ℝ}
    (hF_convex : (uncurry F).IsConvex ℝ)
    (hF_proper : (uncurry F).IsProper)
    {K : U → X → WithBotTop ℝ}
    (hK : K ∈ Ω(F)) :
    IsProper K := by
  rcases (mem_omega_iff F K).1 hK with ⟨hLower, hUpper⟩
  rcases hF_proper.nonempty_dom with ⟨⟨u, x⟩, hx⟩
  have hx' : F u x < ⊤ := by simpa [uncurry] using hx
  have hu_dom₁ : u ∈ dom₁ K := by
    intro xStar
    have hterm : ⊥ < (((⟪x, xStar⟫ₚ : ℝ) : WithBotTop ℝ) - F u x) := by
      simpa [sub_eq_add_neg] using
        (WithBotTop.bot_lt_add_iff.2
          ⟨(WithBot.bot_lt_iff_ne_bot).2 (WithBotTop.coe_ne_bot _),
            (WithBot.bot_lt_iff_ne_bot).2 <| by
              change -F u x ≠ (⊥ : WithBotTop ℝ)
              simpa [WithBotTop.neg_eq_bot_iff] using
                (ne_of_lt hx' : F u x ≠ (⊤ : WithBotTop ℝ))⟩)
    have hlower_ux : ⊥ < lowerPairing X F u xStar := by
      change ⊥ < convexConjugate (F u) xStar
      rw [convexConjugate_eq_iSup_pairing_sub]
      exact
        lt_of_lt_of_le hterm <|
          le_iSup (fun x' : X ↦ ((⟪x', xStar⟫ₚ : ℝ) : WithBotTop ℝ) - F u x') x
    exact lt_of_lt_of_le hlower_ux (hLower u xStar)
  have hAdj_proper : (uncurry (-adjoint X U F)).IsProper := by
    change (-uncurry (adjoint X U F)).IsProper
    simpa using
      (adjointFunction_isProper_iff (XStar := X) (UStar := U) F hF_convex).2 hF_proper
  rcases hAdj_proper.nonempty_dom with ⟨⟨xStar, uStar⟩, huStar⟩
  have huStar' : (-adjoint X U F) xStar uStar < ⊤ := by
    simpa [uncurry] using huStar
  have hxStar_dom₂ : xStar ∈ dom₂ K := by
    intro u'
    have hterm :
        (((⟪uStar, u'⟫ₚ : ℝ) : WithBotTop ℝ) - adjoint X U F xStar uStar) < ⊤ := by
      simpa [sub_eq_add_neg] using
        WithBotTop.add_lt_top
          (WithBotTop.coe_ne_top (⟪uStar, u'⟫ₚ : ℝ))
          (ne_of_lt huStar')
    have hupper_ux : upperPairing X F u' xStar < ⊤ := by
      simpa [upperPairing_apply, concaveConjugate_eq_iInf_pairing_sub] using
        (lt_of_le_of_lt
          (iInf_le
            (fun u'' : U ↦ ((⟪u'', u'⟫ₚ : ℝ) : WithBotTop ℝ) - adjoint X U F xStar u'') uStar)
          hterm)
    exact lt_of_le_of_lt (hUpper u' xStar) hupper_ux
  exact (isProper_iff K).2 ⟨⟨u, hu_dom₁⟩, ⟨xStar, hxStar_dom₂⟩⟩

end

end Bifunction
