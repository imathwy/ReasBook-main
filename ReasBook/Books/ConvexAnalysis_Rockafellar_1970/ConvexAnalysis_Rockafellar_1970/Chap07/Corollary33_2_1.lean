import ConvexAnalysis_Rockafellar_1970.Chap06.Definition_6_29_24
import ConvexAnalysis_Rockafellar_1970.Chap06.Definition_6_30_8
import ConvexAnalysis_Rockafellar_1970.Chap02.Text_6_8
import ConvexAnalysis_Rockafellar_1970.Chap07.Definition33_0_4
import ConvexAnalysis_Rockafellar_1970.Chap07.Definition33_0_8
import ConvexAnalysis_Rockafellar_1970.Chap07.Definition33_0_29
import ConvexAnalysis_Rockafellar_1970.Chap07.Defn_34_2
import ConvexAnalysis_Rockafellar_1970.Chap07.Theorem33_1

noncomputable section

universe u v u' v' w

open scoped Rockafellar

namespace Bifunction

/-!
Source/core/bridge triage:

- `source-facing`: Theorem33.2 identifies the mixed one-variable closures of the Chapter 33
  pairings generated by a convex-or-concave bifunction.
- `core/canonical`: the chapter already owns the relevant surfaces as `lowerPairing`,
  `upperAdjointPairing`, the partial closures `cl₁` and `cl₂`, and the bifunction closure `cl F`.
- `bridge/view`: the textbook formulas `⟪u, F⋆ x⋆⟫ᶜ = cl_u ⟪F u, x⋆⟫ᶠ` and
  `cl_{x⋆} ⟪u, F⋆ x⋆⟫ᶜ = ⟪(cl F) u, x⋆⟫ᶠ` are therefore stated directly as equalities of those
  existing owner bifunctions, rather than through a new wrapper around pointwise closure
  operators.

Domain-style sampling used here:
- `Bifunction.lowerPairing` and `Bifunction.upperAdjointPairing` from `Defn_34_2`;
- `Bifunction.closure1` and `Bifunction.closure2` from `Definition33_0_4`;
- `Bifunction.lowerPairing_lowerPairing_eq_closure2_of_uncurry_isConvex` from `Theorem33_1`;
- `Bifunction.biadjointFunction_eq_closure` from `Theorem_6_30_11`;
- `concᵇ[𝕜](F)` from `Definition_6_30_8`.

Primitive data vs derived API:
- primitive data: a bifunction `F : U → X → WithBotTop 𝕜`;
- primitive owners already present in the project: `lowerPairing XStar F`,
  `upperAdjointPairing XStar UStar F`, `cl₁`, `cl₂`, and `cl F`;
- derived API here: the two closure identities of Theorem33.2, split into atomic clauses.

Layer target: `source-facing`, on the canonical Chapter 33 owner surface.
-/

section

variable {𝕜 : Type w}
variable [Field 𝕜] [ConditionallyCompleteLinearOrder 𝕜] [IsStrictOrderedRing 𝕜]
variable [TopologicalSpace 𝕜] [TopologicalSpace (WithBotTop 𝕜)] [OrderTopology 𝕜]
variable [Module 𝕜 (WithBotTop 𝕜)] [PosSMulMono 𝕜 (WithBotTop 𝕜)]
variable {U : Type u} {X : Type v} {UStar : Type u'} {XStar : Type v'}
variable [TopologicalSpace U] [AddCommGroup U] [Module 𝕜 U]
variable [IsTopologicalAddGroup U] [ContinuousSMul 𝕜 U] [FiniteDimensional 𝕜 U] [T2Space U]
variable [TopologicalSpace X] [AddCommGroup X] [Module 𝕜 X]
variable [IsTopologicalAddGroup X] [ContinuousSMul 𝕜 X] [FiniteDimensional 𝕜 X] [T2Space X]
variable [TopologicalSpace UStar] [AddCommGroup UStar] [Module 𝕜 UStar]
variable [IsTopologicalAddGroup UStar] [ContinuousSMul 𝕜 UStar]
variable [FiniteDimensional 𝕜 UStar] [T2Space UStar]
variable [TopologicalSpace XStar] [AddCommGroup XStar] [Module 𝕜 XStar]
variable [IsTopologicalAddGroup XStar] [ContinuousSMul 𝕜 XStar]
variable [FiniteDimensional 𝕜 XStar] [T2Space XStar]
variable [HasLinearPairing U UStar 𝕜] [HasContinuousPairing U UStar 𝕜]
variable [HasLinearPairing X XStar 𝕜] [HasContinuousPairing X XStar 𝕜]
variable (F : U → X → WithBotTop 𝕜)

/-- The swapped primal-dual pairing used to read concave pairings of adjoint slices at primal
points. -/
local instance pairingEquationAtReversedPairing : HasPairing UStar U 𝕜 := HasPairing.swap

local notation "F⋆" => adjoint XStar UStar F

-- Proof sketch: view `u ↦ ⟪F u, x⋆⟫ᶠ` as the first-variable slice of `lowerPairing XStar F`,
-- apply the Chapter 33 reconstruction theorem to the swapped pairing picture, and identify the
-- resulting first-variable concave closure with `upperAdjointPairing XStar UStar F`.
/-- Theorem33.2 (1): for a convex or concave bifunction `F`, the first-variable partial closure
of the lower pairing representative is the upper adjoint pairing representative. Equivalently,
`cl_u ⟪F u, x⋆⟫ᶠ = ⟪u, F⋆ x⋆⟫ᶜ`. -/
theorem closure1_lowerPairing_eq_upperAdjointPairing_of_uncurry_isConvex_or_isConcave
    (hF : (Function.uncurry F).IsConvex 𝕜 ∨ concᵇ[𝕜](F)) :
    cl₁ (lowerPairing XStar F) = upperAdjointPairing XStar UStar F := sorry

-- Proof sketch: apply the first clause to the adjoint bifunction, then replace its biadjoint by
-- `cl F` using the Chapter 6 biconjugacy theorem `biadjointFunction_eq_closure`.
/-- Theorem33.2 (2): for a convex or concave bifunction `F`, the second-variable partial closure
of the upper adjoint pairing representative is the lower pairing representative of the closed
bifunction `cl F`. Equivalently,
`cl_{x⋆} ⟪u, F⋆ x⋆⟫ᶜ = ⟪(cl F) u, x⋆⟫ᶠ`. -/
theorem closure2_upperAdjointPairing_eq_lowerPairing_closure_of_uncurry_isConvex_or_isConcave
    (hF : (Function.uncurry F).IsConvex 𝕜 ∨ concᵇ[𝕜](F)) :
    cl₂ (upperAdjointPairing XStar UStar F) = lowerPairing XStar (cl F) := sorry

-- Proof sketch: if `u ∈ ri[𝕜](dom F)`, apply Theorem 33.2 to the first-variable slice of
-- `lowerPairing XStar F` and read the resulting equality as `PairingEquationAt F u xStar`.
-- If `F` is closed and `xStar ∈ ri[𝕜](dom (-F⋆))`, apply the second clause of Theorem 33.2 and
-- use the fixed-point identity `cl F = F` coming from lower semicontinuity of `uncurry F`.
/-- Corollary33.2.1: for a convex or concave bifunction `F`, the Chapter 33 pairing equation
holds at `(u, x⋆)` whenever either `u ∈ ri[𝕜](dom F)`, or `F` is closed and
`x⋆ ∈ ri[𝕜](dom (-F⋆))`; this is the project's source-facing rendering of the source clauses
`u ∈ ri(dom F)` and `x⋆ ∈ ri(dom F*)`. -/
theorem pairingEquationAt_of_mem_ri_dom_or_closed_mem_ri_dom_neg_adjoint
    (hF : (Function.uncurry F).IsConvex 𝕜 ∨ concᵇ[𝕜](F))
    (u : U) (xStar : XStar)
    (h : u ∈ ri[𝕜](dom F) ∨
      LowerSemicontinuous (Function.uncurry F) ∧ xStar ∈ ri[𝕜](dom (-F⋆))) :
    ⟪F u, xStar⟫ᶠ = ⟪u, F⋆ xStar⟫ᶜ := sorry

end

end Bifunction
