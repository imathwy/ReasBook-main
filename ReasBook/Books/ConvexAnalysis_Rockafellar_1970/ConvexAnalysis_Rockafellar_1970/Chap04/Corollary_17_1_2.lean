import Mathlib
import ConvexAnalysis_Rockafellar_1970.Chap01.Definition_2_6_10
import ConvexAnalysis_Rockafellar_1970.Chap01.Corollary_2_6_2
import ConvexAnalysis_Rockafellar_1970.Chap04.Corollary_17_1_1

-- Declarations for this item will be appended below by the statement pipeline.

section

open scoped BigOperators Rockafellar

universe u v w

/-!
Source/core/bridge triage:

- `source-facing`: Corollary 17.1.2 is the conical form of Carathéodory's theorem for a union of
  convex sets: a nonzero vector in the generated cone `cone[R] (⋃ i, C i)` is a nonnegative
  linear combination of at most `finrank R (vectorSpan R (⋃ i, C i))` linearly independent
  generators drawn
  from pairwise distinct members of the family, canonically recorded by a finite support
  `s : Finset ι`.
- `core/canonical`: the owner abstractions are `cone[R] (⋃ i, C i)`,
  the bridge theorem
  `ConvexCone.mem_hull_iff_exists_positiveLinearCombination`,
  `LinearIndependent`, and finite sums indexed by a finite support `s : Finset ι`.
- `bridge/view`: Corollary 17.1.1 gives the corresponding convex-hull statement with an
  affinely independent family of size at most
  `finrank R (vectorSpan R (⋃ i, C i)) + 1`; adjoining and then removing the origin converts that
  affine statement into the present cone statement.
- Domain-style sampling used here:
  `PointedCone.cone`,
  `PointedCone.subset_hull`,
  `ConvexCone.mem_hull_iff_exists_positiveLinearCombination`,
  `exists_affineIndependent_convexCombination_of_mem_convexHull_iUnion`,
  `affineIndependent_iff_linearIndependent_vsub`.
- Primitive data vs derived API:
  the primitive inputs are the family `C`, its convexity, and the vector `x`;
  the bounded finite support, chosen generators, linear independence, and nonnegative
  coefficients are derived witness data.
- Redundant-source-assumption check:
  the textbook assumes every `C i` is nonempty, but this does not affect the generated cone
  `(cone[R] (⋃ i, C i) : Set E)`, so the Lean statement omits that redundant hypothesis.
- Layer target: `source-facing`.
-/

variable {ι : Type u} {R : Type v} {E : Type w}
variable [Field R] [LinearOrder R] [IsStrictOrderedRing R]
variable [AddCommGroup E] [Module R E]

-- Proof sketch: start from a positive linear-combination witness for
-- `x ∈ (cone[R] (⋃ i, C i) : Set E)` via the bridge theorem
-- `ConvexCone.mem_hull_iff_exists_positiveLinearCombination`, normalize the coefficients to obtain
-- a convex combination, and adjoin the origin. Applying Corollary 17.1.1 to that normalized
-- convex-hull representation yields at most
-- `finrank R (vectorSpan R (⋃ i, C i)) + 1` affinely independent points taken from pairwise
-- distinct sets, recorded by a finite support `s : Finset ι`. Since `x ≠ 0`,
-- removing the origin lowers the bound by one and turns affine independence relative to the
-- origin into linear independence of the remaining generators, with the displayed coefficients
-- then viewed on the weaker nonnegative surface required by the textbook statement.
/-- Corollary 17.1.2: if `x` is a nonzero vector in the convex cone generated by the union of a
family of convex sets, then `x` is a nonnegative linear combination of at most
`Module.finrank R (vectorSpan R (⋃ i, C i))` linearly independent vectors, each drawn from a
different member of the family. The selected family members are recorded by a finite support
`s : Finset ι`. Specializing to `R = ℝ` and `E = Fin n → ℝ` recovers the textbook `R^n`
statement with `n` or fewer generators. -/
theorem exists_linearIndependent_nonnegativeCombination_of_ne_zero_mem_cone_iUnion
    (C : ι → Set E) (hconv : ∀ i, Convex R (C i)) (x : E)
    [FiniteDimensional R (vectorSpan R (⋃ i, C i))]
    (hx : x ∈ (cone[R] (⋃ i, C i) : Set E)) (hx0 : x ≠ 0) :
    ∃ s : Finset ι, s.card ≤ Module.finrank R (vectorSpan R (⋃ i, C i)) ∧
      ∃ z : (i : s) → C i,
        LinearIndependent R (fun i ↦ (z i : E)) ∧
          ∃ a : s → R, (∀ i, 0 ≤ a i) ∧ x = ∑ i, a i • (z i : E) := sorry

end
