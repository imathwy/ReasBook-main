/-- Helper for Example 10.1.9: the normalized lift stays in the closed upper hemisphere. -/
private theorem surfaceSquareProjectiveLift_model_third_nonneg (x : surfaceSquareClosedBall) :
    0 ≤ sphereTwoModelVec (surfaceSquareProjectiveLift x) 2 := by
  -- The normalization scalar is nonnegative, so it preserves the nonnegative third coordinate.
