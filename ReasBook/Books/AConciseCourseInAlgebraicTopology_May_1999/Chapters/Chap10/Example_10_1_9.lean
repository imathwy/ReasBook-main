/-- Helper for Example 10.1.9: a boundary antipode in the closed-square model becomes one of the
generating projective-plane square identifications. -/
private theorem realProjectivePlaneSquareSetoid_of_boundaryAntipode {p q : I × I}
    (hboundary : ‖(surfaceSquareFaceParam.symm p).1‖ = 1)
    (hneg : (surfaceSquareFaceParam.symm q).1 = -(surfaceSquareFaceParam.symm p).1) :
    realProjectivePlaneSquareSetoid p q := by
  have hreflect : q.1 = unitInterval.symm p.1 ∧ q.2 = unitInterval.symm p.2 :=
    (surfaceSquareFaceParam_symm_neg_iff p q).mp hneg
  rcases hreflect with ⟨hq1, hq2⟩
  rcases surfaceSquareFaceParam_boundary_cases hboundary with hp1 | hp1 | hp2 | hp2
  · -- A left-edge point is identified directly with the reflected right-edge point.
    have hq1' : q.1 = 1 := by simpa [hp1] using hq1
    have hq2' : p.2 = unitInterval.symm q.2 := by
      simpa using (congrArg unitInterval.symm hq2).symm
    exact Relation.EqvGen.rel _ _
      (Or.inl ⟨congrArg Subtype.val hp1, congrArg Subtype.val hq1', hq2'⟩)
  · -- A right-edge point uses the symmetric form of the same generator.
    have hq1' : q.1 = 0 := by simpa [hp1] using hq1
    exact Relation.EqvGen.symm _ _ <|
      Relation.EqvGen.rel _ _
        (Or.inl ⟨congrArg Subtype.val hq1', congrArg Subtype.val hp1, hq2⟩)
  · -- A bottom-edge point is identified directly with the reflected top-edge point.
    have hq2' : q.2 = 1 := by simpa [hp2] using hq2
    have hq1' : p.1 = unitInterval.symm q.1 := by
      simpa using (congrArg unitInterval.symm hq1).symm
    exact Relation.EqvGen.rel _ _
      (Or.inr ⟨congrArg Subtype.val hp2, congrArg Subtype.val hq2', hq1'⟩)
  · -- A top-edge point uses the symmetric form of the same generator.
    have hq2' : q.2 = 0 := by simpa [hp2] using hq2
    exact Relation.EqvGen.symm _ _ <|
      Relation.EqvGen.rel _ _
        (Or.inr ⟨congrArg Subtype.val hq2', congrArg Subtype.val hp2, hq1⟩)

