/-- The generating edge identifications for the standard Klein-bottle quotient of the square. -/
def kleinBottleSquareEdgeRel (p q : I × I) : Prop :=
  (((p.1 : ℝ) = 0) ∧ ((q.1 : ℝ) = 1) ∧ p.2 = q.2) ∨
    (((p.2 : ℝ) = 0) ∧ ((q.2 : ℝ) = 1) ∧ p.1 = unitInterval.symm q.1)

/-- The equivalence relation on `I × I` generated by the Klein-bottle edge identifications. -/
def kleinBottleSquareSetoid : Setoid (I × I) :=
  Relation.EqvGen.setoid kleinBottleSquareEdgeRel

/-- The Klein bottle obtained from the square `I × I` by identifying one pair of opposite edges
with the same orientation and the other pair with reversed orientation. -/
abbrev KleinBottleFromSquare :=
  Quotient kleinBottleSquareSetoid

/-- A generating edge identification in the square model becomes an equality in
`KleinBottleFromSquare`. -/
theorem kleinBottleFromSquare_mk_eq_mk {p q : I × I} (h : kleinBottleSquareEdgeRel p q) :
    (Quotient.mk'' p : KleinBottleFromSquare) = Quotient.mk'' q :=
  Quotient.sound (Relation.EqvGen.rel _ _ h)

/-- In `KleinBottleFromSquare`, the left and right edges of the square are identified with the
same orientation. -/
theorem kleinBottleFromSquare_left_eq_right (t : I) :
    (Quotient.mk'' ((0 : I), t) : KleinBottleFromSquare) = Quotient.mk'' (1, t) :=
  kleinBottleFromSquare_mk_eq_mk <| Or.inl ⟨rfl, rfl, rfl⟩

/-- In `KleinBottleFromSquare`, the bottom and top edges of the square are identified with
reversed orientation. -/
theorem kleinBottleFromSquare_bottom_eq_top (t : I) :
    (Quotient.mk'' (t, (0 : I)) : KleinBottleFromSquare) =
      Quotient.mk'' (unitInterval.symm t, 1) :=
  kleinBottleFromSquare_mk_eq_mk <| Or.inr ⟨rfl, rfl, by simp⟩

/-- Helper for Example 10.1.9: the order-two symmetry used to flip the strip model of the Klein
bottle. -/
private inductive KleinBottleStripSymmetry where
  | one
  | flip
deriving DecidableEq, Fintype

private instance : One KleinBottleStripSymmetry := ⟨KleinBottleStripSymmetry.one⟩

private instance : Mul KleinBottleStripSymmetry where
  mul g h :=
    match g, h with
    | .one, h => h
    | .flip, .one => .flip
    | .flip, .flip => .one

private instance : Inv KleinBottleStripSymmetry where
  inv g := g

private instance : Group KleinBottleStripSymmetry where
  one_mul g := by cases g <;> rfl
  mul_one g := by cases g <;> rfl
  mul_assoc g h k := by cases g <;> cases h <;> cases k <;> rfl
  inv_mul_cancel g := by cases g <;> rfl

private instance : TopologicalSpace KleinBottleStripSymmetry := ⊥

private instance : DiscreteTopology KleinBottleStripSymmetry := ⟨rfl⟩

/-- Helper for Example 10.1.9: the strip involution `(u, t) ↦ (-u, unitInterval.symm t)`. -/
private def kleinBottleStripFlip (x : AddCircle (1 : ℝ) × I) :
    AddCircle (1 : ℝ) × I :=
  (-x.1, unitInterval.symm x.2)

/-- Helper for Example 10.1.9: the Klein-bottle strip flip is an involution. -/
private theorem kleinBottleStripFlip_involutive (x : AddCircle (1 : ℝ) × I) :
    kleinBottleStripFlip (kleinBottleStripFlip x) = x := by
  -- Both coordinates are flipped by involutions.
  ext <;> simp [kleinBottleStripFlip]

/-- Helper for Example 10.1.9: the order-two strip symmetry acts by either the identity or the
strip flip. -/
private def kleinBottleStripSymmetrySmul
    (g : KleinBottleStripSymmetry) (x : AddCircle (1 : ℝ) × I) :
    AddCircle (1 : ℝ) × I :=
  match g with
  | .one => x
  | .flip => kleinBottleStripFlip x

private instance : SMul KleinBottleStripSymmetry (AddCircle (1 : ℝ) × I) where
  smul := kleinBottleStripSymmetrySmul

private instance : MulAction KleinBottleStripSymmetry (AddCircle (1 : ℝ) × I) where
  one_smul x := by
    rfl
  mul_smul g h x := by
    -- The nontrivial group element acts by the strip involution.
    change
      kleinBottleStripSymmetrySmul (g * h) x =
        kleinBottleStripSymmetrySmul g (kleinBottleStripSymmetrySmul h x)
    cases g <;> cases h <;> simp [kleinBottleStripSymmetrySmul, kleinBottleStripFlip_involutive]

private instance : ContinuousConstSMul KleinBottleStripSymmetry (AddCircle (1 : ℝ) × I) where
  continuous_const_smul g := by
    cases g
    · simpa [kleinBottleStripSymmetrySmul] using
        (continuous_id : Continuous fun x : AddCircle (1 : ℝ) × I ↦ x)
    · -- The nontrivial action is the product of negation on `AddCircle` and reflection on `I`.
      change Continuous fun x : AddCircle (1 : ℝ) × I ↦ kleinBottleStripFlip x
      -- The strip involution is the product of negation on `AddCircle` and reflection on `I`.
      simpa [kleinBottleStripFlip] using
        (((continuous_neg :
            Continuous fun u : AddCircle (1 : ℝ) ↦ -u).comp
            (continuous_fst : Continuous fun x : AddCircle (1 : ℝ) × I ↦ x.1)).prodMk
          ((unitInterval.continuous_symm).comp
            (continuous_snd : Continuous fun x : AddCircle (1 : ℝ) × I ↦ x.2)))

/-- Helper for Example 10.1.9: the orbit quotient of the Klein-bottle strip involution is
Hausdorff. -/
private instance kleinBottleStripOrbit_t2Space :
    T2Space
      (MulAction.orbitRel.Quotient KleinBottleStripSymmetry (AddCircle (1 : ℝ) × I)) := by
  -- Convert the finite properly discontinuous action into a proper action and invoke the general
  -- Hausdorff quotient instance.
  let _ : ProperSMul KleinBottleStripSymmetry (AddCircle (1 : ℝ) × I) :=
    (properlyDiscontinuousSMul_iff_properSMul
      (G := KleinBottleStripSymmetry) (X := AddCircle (1 : ℝ) × I)).mp inferInstance
  infer_instance

/-- The quotient model `TorusFromSquare` is Hausdorff. -/
instance instT2SpaceTorusFromSquare : T2Space TorusFromSquare := by
  -- Once the kernel relation is identified, Hausdorffness transports back from the product torus.
  exact torusFromSquareHomeomorphProductCircle.symm.t2Space

/-- Helper for Example 10.1.9: an interior point of the torus square model is fixed by the
generated quotient relation, because every generator lives on the boundary. -/
private theorem torusSquareSetoid_interiorFixed
    {p q : I × I}
    (hp₁0 : (p.1 : ℝ) ≠ 0) (hp₁1 : (p.1 : ℝ) ≠ 1)
    (hp₂0 : (p.2 : ℝ) ≠ 0) (hp₂1 : (p.2 : ℝ) ≠ 1)
    (hpq : torusSquareSetoid p q) :
    q = p := by
  let s : I × I := p
  let fixesInterior : (I × I) → (I × I) → Prop := fun a b ↦ a = s ↔ b = s
  have hfixes_equiv : Equivalence fixesInterior := by
    refine ⟨?_, ?_, ?_⟩
    · intro a
      rfl
    · intro a b hab
      exact hab.symm
    · intro a b c hab hbc
      exact hab.trans hbc
  have hrel :
      ∀ a b : I × I, torusSquareEdgeRel a b → fixesInterior a b := by
    intro a b hab
    constructor
    · intro ha
      subst ha
      rcases hab with hxy | hxy
      · rcases hxy with ⟨hx0, _, _⟩
        exact (hp₁0 hx0).elim
      · rcases hxy with ⟨hy0, _, _⟩
        exact (hp₂0 hy0).elim
    · intro hb
      subst hb
      rcases hab with hxy | hxy
      · rcases hxy with ⟨_, hy1, _⟩
        exact (hp₁1 hy1).elim
      · rcases hxy with ⟨_, hy1, _⟩
        exact (hp₂1 hy1).elim
  have hpq' : Relation.EqvGen torusSquareEdgeRel p q := hpq
  have hfixed : fixesInterior s q := by
    -- Push the boundary-supported generating relation through the quotient closure.
    exact (Equivalence.eqvGen_iff hfixes_equiv).1 (Relation.EqvGen.mono hrel hpq')
  -- Since `s` is related to itself, the induced equivalence forces `q = s`.
  exact hfixed.mp rfl

/-- Helper for Example 10.1.9: an interior point of the Klein-bottle square model is fixed by the
generated quotient relation, because every generator lives on the boundary. -/
private theorem kleinBottleSquareSetoid_interiorFixed
    {p q : I × I}
    (hp₁0 : (p.1 : ℝ) ≠ 0) (hp₁1 : (p.1 : ℝ) ≠ 1)
    (hp₂0 : (p.2 : ℝ) ≠ 0) (hp₂1 : (p.2 : ℝ) ≠ 1)
    (hpq : kleinBottleSquareSetoid p q) :
    q = p := by
  let s : I × I := p
  let fixesInterior : (I × I) → (I × I) → Prop := fun a b ↦ a = s ↔ b = s
  have hfixes_equiv : Equivalence fixesInterior := by
    refine ⟨?_, ?_, ?_⟩
    · intro a
      rfl
    · intro a b hab
      exact hab.symm
    · intro a b c hab hbc
      exact hab.trans hbc
  have hrel :
      ∀ a b : I × I, kleinBottleSquareEdgeRel a b → fixesInterior a b := by
    intro a b hab
    constructor
    · intro ha
      subst ha
      rcases hab with hxy | hxy
      · rcases hxy with ⟨hx0, _, _⟩
        exact (hp₁0 hx0).elim
      · rcases hxy with ⟨hy0, _, _⟩
        exact (hp₂0 hy0).elim
    · intro hb
      subst hb
      rcases hab with hxy | hxy
      · rcases hxy with ⟨_, hy1, _⟩
        exact (hp₁1 hy1).elim
      · rcases hxy with ⟨_, hy1, _⟩
        exact (hp₂1 hy1).elim
  have hpq' : Relation.EqvGen kleinBottleSquareEdgeRel p q := hpq
  have hfixed : fixesInterior s q := by
    exact (Equivalence.eqvGen_iff hfixes_equiv).1 (Relation.EqvGen.mono hrel hpq')
  -- Since `s` is related to itself, the induced equivalence forces `q = s`.
  exact hfixed.mp rfl

/-- Helper for Example 10.1.9: the cylinder model for the Klein bottle only identifies equal
points and opposite boundary points related by the bottom-top twist. -/
private def kleinBottleCylinderRel (z z' : AddCircle (1 : ℝ) × I) : Prop :=
  z = z' ∨
    (z.2 = 0 ∧ z'.2 = 1 ∧ z.1 = -z'.1) ∨
      (z.2 = 1 ∧ z'.2 = 0 ∧ -z.1 = z'.1)

/-- Helper for Example 10.1.9: the cylinder boundary relation is reflexive. -/
private theorem kleinBottleCylinderRel_refl (z : AddCircle (1 : ℝ) × I) :
    kleinBottleCylinderRel z z :=
  Or.inl rfl

/-- Helper for Example 10.1.9: the cylinder boundary relation is symmetric. -/
private theorem kleinBottleCylinderRel_symm {z z' : AddCircle (1 : ℝ) × I}
    (h : kleinBottleCylinderRel z z') :
    kleinBottleCylinderRel z' z := by
  rcases h with rfl | h | h
  · exact kleinBottleCylinderRel_refl z
  · rcases h with ⟨hz, hz', hneg⟩
    exact Or.inr <| Or.inr ⟨hz', hz, by simpa [hneg]⟩
  · rcases h with ⟨hz, hz', hneg⟩
    exact Or.inr <| Or.inl ⟨hz', hz, by simpa [hneg]⟩

/-- Helper for Example 10.1.9: the cylinder boundary relation is transitive. -/
private theorem kleinBottleCylinderRel_trans {x y z : AddCircle (1 : ℝ) × I}
    (hxy : kleinBottleCylinderRel x y) (hyz : kleinBottleCylinderRel y z) :
    kleinBottleCylinderRel x z := by
  have hzeroNeOne : (((0 : I) : ℝ)) ≠ 1 := by
    norm_num
  rcases hxy with rfl | ⟨hx0, hy1, hxy⟩ | ⟨hx1, hy0, hxy⟩
  · -- If the first step is trivial, the second step already gives the composite relation.
    simpa using hyz
  · rcases hyz with rfl | ⟨hy0, hz1, hyz⟩ | ⟨hy1', hz0, hyz⟩
    · -- If the second step is trivial, we keep the original bottom-top twist.
      exact Or.inr <| Or.inl ⟨hx0, hy1, hxy⟩
    · -- Two bottom-top twists would force the middle point to lie on both boundary circles.
      exfalso
      apply hzeroNeOne
      exact congrArg Subtype.val <| hy0.symm.trans hy1
    · -- A bottom-top twist followed by a top-bottom twist collapses to literal equality.
      apply Or.inl
      ext
      · exact hxy.trans hyz
      · exact congrArg Subtype.val (hx0.trans hz0.symm)
  · rcases hyz with rfl | ⟨hy0', hz1, hyz⟩ | ⟨hy1, hz0, hyz⟩
    · -- If the second step is trivial, we keep the original top-bottom twist.
      exact Or.inr <| Or.inr ⟨hx1, hy0, hxy⟩
    · -- A top-bottom twist followed by a bottom-top twist also collapses to equality.
      apply Or.inl
      ext
      · calc
          x.1 = -y.1 := by simpa using congrArg Neg.neg hxy
          _ = z.1 := by simpa using congrArg Neg.neg hyz
      · exact congrArg Subtype.val (hx1.trans hz1.symm)
    · -- Two top-bottom twists would again force the middle point onto both boundary circles.
      exfalso
      apply hzeroNeOne
      exact congrArg Subtype.val <| hy0.symm.trans hy1

/-- Helper for Example 10.1.9: the cylinder boundary relation is an equivalence relation. -/
private theorem kleinBottleCylinderRel_equivalence :
    Equivalence kleinBottleCylinderRel := by
  refine ⟨kleinBottleCylinderRel_refl, ?_, ?_⟩
  · intro x y hxy
    exact kleinBottleCylinderRel_symm hxy
  · intro x y z hxy hyz
    exact kleinBottleCylinderRel_trans hxy hyz

/-- Helper for Example 10.1.9: the explicit cylinder boundary relation defines a setoid. -/
private def kleinBottleCylinderSetoid : Setoid (AddCircle (1 : ℝ) × I) where
  r := kleinBottleCylinderRel
  iseqv := kleinBottleCylinderRel_equivalence

/-- Helper for Example 10.1.9: the square comparison map to the cylinder-boundary quotient is
continuous. -/
private theorem kleinBottleCylinderComparison_continuous :
    Continuous
      (fun p : I × I ↦
        (Quotient.mk''
          ((((p.1 : ℝ) : AddCircle (1 : ℝ)), p.2)) :
            Quotient kleinBottleCylinderSetoid)) := by
  -- Compose the coordinate quotient-to-circle map with the canonical quotient projection.
  exact continuous_quotient_mk'.comp <|
    ((AddCircle.continuous_mk' (1 : ℝ)).comp
        (continuous_subtype_val.comp continuous_fst)).prodMk
      continuous_snd

/-- Helper for Example 10.1.9: the comparison map from the square to the cylinder-boundary
quotient. -/
private noncomputable def kleinBottleCylinderComparison :
    C(I × I, Quotient kleinBottleCylinderSetoid) :=
  ⟨fun p ↦ Quotient.mk'' ((((p.1 : ℝ) : AddCircle (1 : ℝ)), p.2)),
    kleinBottleCylinderComparison_continuous⟩

/-- Helper for Example 10.1.9: every circle coordinate has a representative in `I`. -/
private theorem addCircle_exists_unitInterval_rep (u : AddCircle (1 : ℝ)) :
    ∃ x : I, (((x : ℝ) : AddCircle (1 : ℝ))) = u := by
  have hu_image : u ∈ (((↑) : ℝ → AddCircle (1 : ℝ)) '' Set.Icc (0 : ℝ) 1) := by
    simpa using
      (show u ∈ (((↑) : ℝ → AddCircle (1 : ℝ)) '' Set.Icc (0 : ℝ) ((0 : ℝ) + 1)) by
        rw [AddCircle.coe_image_Icc_eq (p := (1 : ℝ)) (a := (0 : ℝ))]
        simp)
  rcases hu_image with ⟨x, hx, hxeq⟩
  exact ⟨⟨x, hx⟩, by simpa using hxeq⟩

/-- Helper for Example 10.1.9: the square comparison map to the cylinder quotient is surjective. -/
private theorem kleinBottleCylinderComparison_surjective :
    Function.Surjective kleinBottleCylinderComparison := by
  intro z
  refine Quotient.inductionOn z ?_
  intro u
  rcases addCircle_exists_unitInterval_rep u.1 with ⟨x, hx⟩
  refine ⟨(x, u.2), ?_⟩
  change Quotient.mk'' ((((x : ℝ) : AddCircle (1 : ℝ)), u.2)) = Quotient.mk'' u
  simpa [hx]

/-- Helper for Example 10.1.9: the explicit cylinder boundary relation is a closed subset of
`((AddCircle × I) × (AddCircle × I))`. -/
private theorem kleinBottleCylinderRel_closed :
    IsClosed
      ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
          kleinBottleCylinderRel p.1 p.2} : Set ((AddCircle (1 : ℝ) × I) ×
            (AddCircle (1 : ℝ) × I))) := by
  have hdiag :
      IsClosed
        ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) | p.1 = p.2} : Set _) := by
    -- The diagonal is closed because `AddCircle × I` is Hausdorff.
    exact isClosed_eq continuous_fst continuous_snd
  have hbottomTop :
      IsClosed
        ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
            p.1.2 = 0 ∧ p.2.2 = 1 ∧ p.1.1 = -p.2.1} : Set _) := by
    -- Each boundary condition is an equality of continuous coordinate maps.
    have hBottom :
        IsClosed
          ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
              p.1.2 = (0 : I)} : Set _) := by
      exact isClosed_eq (continuous_snd.comp continuous_fst) continuous_const
    have hTop :
        IsClosed
          ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
              p.2.2 = (1 : I)} : Set _) := by
      exact isClosed_eq (continuous_snd.comp continuous_snd) continuous_const
    have hTwist :
        IsClosed
          ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
              p.1.1 = -p.2.1} : Set _) := by
      exact isClosed_eq (continuous_fst.comp continuous_fst)
        (continuous_neg.comp (continuous_fst.comp continuous_snd))
    simpa [Set.setOf_and] using hBottom.inter (hTop.inter hTwist)
  have htopBottom :
      IsClosed
        ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
            p.1.2 = 1 ∧ p.2.2 = 0 ∧ -p.1.1 = p.2.1} : Set _) := by
    -- The opposite boundary-twist branch is closed by the same coordinate-equality argument.
    have hTop :
        IsClosed
          ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
              p.1.2 = (1 : I)} : Set _) := by
      exact isClosed_eq (continuous_snd.comp continuous_fst) continuous_const
    have hBottom :
        IsClosed
          ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
              p.2.2 = (0 : I)} : Set _) := by
      exact isClosed_eq (continuous_snd.comp continuous_snd) continuous_const
    have hTwist :
        IsClosed
          ({p : ((AddCircle (1 : ℝ) × I) × (AddCircle (1 : ℝ) × I)) |
              -p.1.1 = p.2.1} : Set _) := by
      exact isClosed_eq (continuous_neg.comp (continuous_fst.comp continuous_fst))
        (continuous_fst.comp continuous_snd)
    simpa [Set.setOf_and] using hTop.inter (hBottom.inter hTwist)
  -- The full relation is the finite union of the diagonal and the two twisted boundary pieces.
  simpa [kleinBottleCylinderRel, Set.setOf_or, Set.setOf_and] using
    hdiag.union (hbottomTop.union htopBottom)

/-- Helper for Example 10.1.9: for a closed relation on a compact Hausdorff space, each
equivalence class is closed. -/
private theorem isClosed_setOf_related_right
    {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X] (S : Setoid X)
    (hS : IsClosed ({p : X × X | S.r p.1 p.2} : Set (X × X))) (x : X) :
    IsClosed ({y : X | S.r x y} : Set X) := by
  let R : Set (X × X) := {p : X × X | p.1 = x ∧ S.r p.1 p.2}
  have hRClosed : IsClosed R := by
    have hEq : IsClosed ({p : X × X | p.1 = x} : Set (X × X)) := by
      exact isClosed_eq continuous_fst continuous_const
    simpa [R, Set.setOf_and] using hEq.inter hS
  have hRCompact : IsCompact R := isCompact_univ.of_isClosed_subset hRClosed (by simp [R])
  have hImageClosed : IsClosed (Prod.snd '' R) := (hRCompact.image continuous_snd).isClosed
  have hImageEq : Prod.snd '' R = ({y : X | S.r x y} : Set X) := by
    ext y
    constructor
    · rintro ⟨⟨x', y'⟩, hx'y', rfl⟩
      rcases hx'y' with ⟨rfl, hxy⟩
      simpa using hxy
    · intro hxy
      exact ⟨(x, y), ⟨rfl, hxy⟩, rfl⟩
  simpa [hImageEq] using hImageClosed

/-- Helper for Example 10.1.9: a quotient map by a closed relation on a compact Hausdorff space is
closed. -/
private theorem isClosedMap_quotient_mk'_of_isClosed_relation
    {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X] (S : Setoid X)
    (hS : IsClosed ({p : X × X | S.r p.1 p.2} : Set (X × X))) :
    IsClosedMap (Quotient.mk' : X → Quotient S) := by
  let q : X → Quotient S := Quotient.mk'
  have hq : Topology.IsQuotientMap q := isQuotientMap_quotient_mk'
  intro A hA
  let R : Set (X × X) := {p : X × X | p.1 ∈ A ∧ S.r p.1 p.2}
  have hRClosed : IsClosed R := by
    have hAClosed : IsClosed ({p : X × X | p.1 ∈ A} : Set (X × X)) := hA.preimage continuous_fst
    simpa [R, Set.setOf_and] using hAClosed.inter hS
  have hSatClosed : IsClosed (Prod.snd '' R) := by
    exact (isCompact_univ.of_isClosed_subset hRClosed (by simp [R])).image continuous_snd |>.isClosed
  have hSat :
      q ⁻¹' (q '' A) = Prod.snd '' R := by
    ext x
    constructor
    · intro hx
      rcases hx with ⟨a, haA, hax⟩
      change Quotient.mk'' a = Quotient.mk'' x at hax
      rw [Quotient.eq''] at hax
      exact ⟨(a, x), ⟨haA, hax⟩, rfl⟩
    · rintro ⟨⟨a, x'⟩, hax, rfl⟩
      exact ⟨a, hax.1, Quotient.sound hax.2⟩
  -- Closedness of the saturation characterizes closedness downstairs for quotient maps.
  exact (((Topology.isQuotientMap_iff_isClosed (f := q)).1 hq).2 (q '' A)).2 <| by
    simpa [hSat] using hSatClosed

/-- Helper for Example 10.1.9: a surjective closed map from a compact Hausdorff space to a `T1`
space has Hausdorff codomain. -/
private theorem t2Space_of_surjective_closedMap_from_compactHausdorff
    {K Z : Type*} [TopologicalSpace K] [CompactSpace K] [T2Space K]
    [TopologicalSpace Z] [T1Space Z]
    {f : K → Z} (hf_cont : Continuous f) (hf_surj : Function.Surjective f)
    (hf_closed : IsClosedMap f) :
    T2Space Z := by
  rw [t2Space_iff]
  intro x y hxy
  let A : Set K := f ⁻¹' {x}
  let B : Set K := f ⁻¹' {y}
  have hAClosed : IsClosed A := by
    simpa [A] using isClosed_singleton.preimage hf_cont
  have hBClosed : IsClosed B := by
    simpa [B] using isClosed_singleton.preimage hf_cont
  have hACompact : IsCompact A := isCompact_univ.of_isClosed_subset hAClosed (by simp [A])
  have hBCompact : IsCompact B := isCompact_univ.of_isClosed_subset hBClosed (by simp [B])
  have hABDisjoint : Disjoint A B := by
    rw [Set.disjoint_left]
    intro a haA haB
    have hx : f a = x := by
      simpa [A] using haA
    have hy : f a = y := by
      simpa [B] using haB
    exact hxy (hx.symm.trans hy)
  -- Separate the two compact fibers upstairs and push those neighborhoods downstairs.
  obtain ⟨U, V, hUOpen, hVOpen, hAU, hBV, hUV⟩ :=
    SeparatedNhds.of_isCompact_isCompact_isClosed hACompact hBCompact hBClosed hABDisjoint
  have hUImageClosed : IsClosed (f '' Uᶜ) := hf_closed _ hUOpen.isClosed_compl
  have hVImageClosed : IsClosed (f '' Vᶜ) := hf_closed _ hVOpen.isClosed_compl
  refine
    ⟨(f '' Uᶜ)ᶜ, (f '' Vᶜ)ᶜ, hUImageClosed.isOpen_compl, hVImageClosed.isOpen_compl, ?_, ?_,
      ?_⟩
  · change x ∉ f '' Uᶜ
    intro hxU
    rcases hxU with ⟨a, haU, hfa⟩
    exact haU <| hAU <| by simp [A, hfa]
  · change y ∉ f '' Vᶜ
    intro hyV
    rcases hyV with ⟨a, haV, hfa⟩
    exact haV <| hBV <| by simp [B, hfa]
  · rw [Set.disjoint_left]
    intro z hzU hzV
    rcases hf_surj z with ⟨a, rfl⟩
    have haU : a ∈ U := by
      by_contra haU
      exact hzU ⟨a, haU, rfl⟩
    have haV : a ∈ V := by
      by_contra haV
      exact hzV ⟨a, haV, rfl⟩
    exact hUV.le_bot ⟨haU, haV⟩

/-- Helper for Example 10.1.9: a quotient by a closed relation on a compact Hausdorff space is
`T1`. -/
private theorem t1Space_quotient_of_isClosed_relation
    {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X] (S : Setoid X)
    (hS : IsClosed ({p : X × X | S.r p.1 p.2} : Set (X × X))) :
    T1Space (Quotient S) := by
  let q : X → Quotient S := Quotient.mk'
  have hqClosed : IsClosedMap q := isClosedMap_quotient_mk'_of_isClosed_relation S hS
  refine ⟨fun x ↦ ?_⟩
  let a : X := Quotient.out x
  have hClassClosed : IsClosed ({y : X | S.r a y} : Set X) :=
    isClosed_setOf_related_right S hS a
  have hSingleton :
      q '' ({y : X | S.r a y} : Set X) = ({x} : Set (Quotient S)) := by
    ext y
    constructor
    · rintro ⟨z, hz, rfl⟩
      rw [Set.mem_singleton_iff]
      exact (Quotient.sound hz).symm.trans (Quotient.out_eq' x)
    · intro hy
      rw [Set.mem_singleton_iff] at hy
      subst y
      exact ⟨a, S.refl a, Quotient.out_eq' x⟩
  simpa [hSingleton] using hqClosed _ hClassClosed

/-- Helper for Example 10.1.9: the explicit cylinder boundary quotient is Hausdorff because its
defining relation is closed. -/
private theorem kleinBottleCylinderQuotient_t2Space :
    T2Space (Quotient kleinBottleCylinderSetoid) := by
  let _ : T1Space (Quotient kleinBottleCylinderSetoid) :=
    t1Space_quotient_of_isClosed_relation kleinBottleCylinderSetoid kleinBottleCylinderRel_closed
  let q : AddCircle (1 : ℝ) × I → Quotient kleinBottleCylinderSetoid :=
    @Quotient.mk' (AddCircle (1 : ℝ) × I) kleinBottleCylinderSetoid
  have hq_cont : Continuous q := by
    simpa [q] using
      (continuous_quotient_mk' :
        Continuous
          (@Quotient.mk' (AddCircle (1 : ℝ) × I) kleinBottleCylinderSetoid))
  have hq_closed : IsClosedMap q := by
    simpa [q] using
      (isClosedMap_quotient_mk'_of_isClosed_relation
        kleinBottleCylinderSetoid kleinBottleCylinderRel_closed :
          IsClosedMap
            (@Quotient.mk' (AddCircle (1 : ℝ) × I) kleinBottleCylinderSetoid))
  -- Route correction: prove the quotient map is closed directly from the closed equivalence
  -- relation, then separate quotient points via the compact-Hausdorff source.
  exact
    t2Space_of_surjective_closedMap_from_compactHausdorff hq_cont
      (by
        intro z
        refine Quotient.inductionOn z ?_
        intro a
        exact ⟨a, rfl⟩)
      hq_closed

/-- Helper for Example 10.1.9: the square-to-cylinder comparison map carries the quotient
topology because it is a surjective continuous map from a compact square to a Hausdorff space. -/
private theorem kleinBottleCylinderComparison_isQuotientMap :
    Topology.IsQuotientMap kleinBottleCylinderComparison := by
  let _ : T2Space (Quotient kleinBottleCylinderSetoid) := kleinBottleCylinderQuotient_t2Space
  -- A surjective continuous map from the compact square to a Hausdorff space is a quotient map.
  exact IsQuotientMap.of_surjective_continuous
    kleinBottleCylinderComparison_surjective kleinBottleCylinderComparison.continuous

/-- Helper for Example 10.1.9: horizontal edge changes in the square do not change the quotient
class. -/
private theorem kleinBottleSquareSetoid_horizontalChange
    {x y t : I} (hxy : (x = 0 ∧ y = 1) ∨ (x = 1 ∧ y = 0)) :
    kleinBottleSquareSetoid (x, t) (y, t) := by
  rcases hxy with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact Relation.EqvGen.rel _ _ (Or.inl ⟨rfl, rfl, rfl⟩)
  · exact Relation.EqvGen.symm _ _ <| Relation.EqvGen.rel _ _
      (Or.inl ⟨rfl, rfl, rfl⟩)

/-- Helper for Example 10.1.9: the twisted bottom-top edge change is one generating relation of
the Klein-bottle square quotient. -/
private theorem kleinBottleSquareSetoid_verticalChange (x y : I) (hxy : x = unitInterval.symm y) :
    kleinBottleSquareSetoid (x, (0 : I)) (y, 1) := by
  exact Relation.EqvGen.rel _ _ (Or.inr ⟨rfl, rfl, hxy⟩)

/-- Helper for Example 10.1.9: the square quotient relation is exactly the kernel of the
cylinder-boundary comparison map. -/
private theorem kleinBottleCylinderComparison_rel_iff (p p' : I × I) :
    kleinBottleSquareSetoid p p' ↔
      kleinBottleCylinderComparison p = kleinBottleCylinderComparison p' := by
  constructor
  · intro hpq
    -- Rewrite each square generator directly in the cylinder quotient, then pass through the
    -- generated equivalence relation.
    induction hpq with
    | rel x y hxy =>
        change
          Quotient.mk'' ((((x.1 : ℝ) : AddCircle (1 : ℝ)), x.2)) =
            Quotient.mk'' ((((y.1 : ℝ) : AddCircle (1 : ℝ)), y.2))
        rw [Quotient.eq'']
        rcases hxy with hxy | hxy
        · rcases hxy with ⟨hx0, hy1, h₂⟩
          apply Or.inl
          ext
          · calc
              (((x.1 : ℝ) : AddCircle (1 : ℝ))) = ((0 : ℝ) : AddCircle (1 : ℝ)) := by
                simpa [hx0]
              _ = ((1 : ℝ) : AddCircle (1 : ℝ)) := by
                symm
                simpa using (AddCircle.coe_add_period (p := (1 : ℝ)) (x := (0 : ℝ)))
              _ = ((y.1 : ℝ) : AddCircle (1 : ℝ)) := by
                simpa [hy1]
          · simpa [h₂]
        · rcases hxy with ⟨hx0, hy1, h₁⟩
          exact Or.inr <| Or.inl ⟨Subtype.ext hx0, Subtype.ext hy1,
            by simpa [h₁] using unitInterval_symm_addCircle_eq_neg y.1⟩
    | refl x =>
        rfl
    | symm x y hxy ih =>
        exact ih.symm
    | trans x y z hxy hyz ihxy ihyz =>
        exact ihxy.trans ihyz
  · intro hpq
    change
      Quotient.mk'' ((((p.1 : ℝ) : AddCircle (1 : ℝ)), p.2)) =
        Quotient.mk'' ((((p'.1 : ℝ) : AddCircle (1 : ℝ)), p'.2)) at hpq
    rw [Quotient.eq''] at hpq
    have sameHeightStep :
        ∀ {a b : I × I},
          a.2 = b.2 →
            (((a.1 : ℝ) : AddCircle (1 : ℝ)) = ((b.1 : ℝ) : AddCircle (1 : ℝ))) →
              kleinBottleSquareSetoid a b := by
      intro a b hab2 hab1
      rcases a with ⟨a1, a2⟩
      rcases b with ⟨b1, b2⟩
      change a2 = b2 at hab2
      change (((a1 : ℝ) : AddCircle (1 : ℝ))) = (((b1 : ℝ) : AddCircle (1 : ℝ))) at hab1
      have hab1' :
          a1 = b1 ∨ (a1 = 0 ∧ b1 = 1) ∨ (a1 = 1 ∧ b1 = 0) :=
        (unitInterval_addCircle_eq_iff a1 b1).mp hab1
      rcases hab1' with hab1' | ⟨ha0, hb1⟩ | ⟨ha1, hb0⟩
      · have hab : (a1, a2) = (b1, b2) := by
          ext
          · exact congrArg Subtype.val hab1'
          · exact congrArg Subtype.val hab2
        simpa [hab] using (Relation.EqvGen.refl (a1, a2) :
          kleinBottleSquareSetoid (a1, a2) (a1, a2))
      · simpa [ha0, hb1, hab2] using
          (kleinBottleSquareSetoid_horizontalChange (t := a2) (Or.inl ⟨ha0, hb1⟩))
      · simpa [ha1, hb0, hab2] using
          (kleinBottleSquareSetoid_horizontalChange (t := a2) (Or.inr ⟨ha1, hb0⟩))
    have bottomTopStep :
        ∀ {a b : I × I},
          a.2 = 0 →
            b.2 = 1 →
              (((a.1 : ℝ) : AddCircle (1 : ℝ)) = -((b.1 : ℝ) : AddCircle (1 : ℝ))) →
                kleinBottleSquareSetoid a b := by
      intro a b ha0 hb1 hab
      rcases a with ⟨a1, a2⟩
      rcases b with ⟨b1, b2⟩
      change a2 = 0 at ha0
      change b2 = 1 at hb1
      subst a2
      subst b2
      -- Convert the circle equality back to the interval endpoint cases.
      have hab' :
          a1 = unitInterval.symm b1 ∨
            (a1 = 0 ∧ unitInterval.symm b1 = 1) ∨
              (a1 = 1 ∧ unitInterval.symm b1 = 0) := by
        have hcircle :
            (((a1 : ℝ) : AddCircle (1 : ℝ))) =
              ((((unitInterval.symm b1 : I) : ℝ) : AddCircle (1 : ℝ))) := by
          calc
            (((a1 : ℝ) : AddCircle (1 : ℝ))) = -((b1 : ℝ) : AddCircle (1 : ℝ)) := hab
            _ = ((((unitInterval.symm b1 : I) : ℝ) : AddCircle (1 : ℝ))) := by
              symm
              simpa using unitInterval_symm_addCircle_eq_neg b1
        exact (unitInterval_addCircle_eq_iff a1 (unitInterval.symm b1)).mp hcircle
      rcases hab' with hdirect | ⟨haLeft, hRight⟩ | ⟨haRight, hLeft⟩
      · -- The direct branch is exactly the twisted vertical generator.
        exact kleinBottleSquareSetoid_verticalChange a1 b1 hdirect
      · -- Endpoint mismatch `0 ~ 1` needs one horizontal move before the vertical generator.
        let r : I × I := (1, (0 : I))
        have hfirst : kleinBottleSquareSetoid (a1, 0) r := by
          simpa [r, haLeft] using
            (kleinBottleSquareSetoid_horizontalChange (t := (0 : I))
              (Or.inl ⟨haLeft, rfl⟩))
        have hsecond : kleinBottleSquareSetoid r (b1, 1) := by
          simpa [r] using kleinBottleSquareSetoid_verticalChange (1 : I) b1 hRight.symm
        exact Relation.EqvGen.trans _ r _ hfirst hsecond
      · -- Endpoint mismatch `1 ~ 0` is handled by the symmetric horizontal move first.
        let r : I × I := (0, (0 : I))
        have hfirst : kleinBottleSquareSetoid (a1, 0) r := by
          simpa [r, haRight] using
            (kleinBottleSquareSetoid_horizontalChange (t := (0 : I))
              (Or.inr ⟨haRight, rfl⟩))
        have hsecond : kleinBottleSquareSetoid r (b1, 1) := by
          simpa [r] using kleinBottleSquareSetoid_verticalChange (0 : I) b1 hLeft.symm
        exact Relation.EqvGen.trans _ r _ hfirst hsecond
    rcases hpq with hpq | ⟨hp0, hp'1, hneg⟩ | ⟨hp1, hp'0, hneg⟩
    · -- Equal cylinder points differ only by a possible horizontal endpoint identification.
      have hsnd : p.2 = p'.2 :=
        congrArg (fun z : AddCircle (1 : ℝ) × I ↦ z.2) hpq
      have hfst :
          (((p.1 : ℝ) : AddCircle (1 : ℝ))) =
            (((p'.1 : ℝ) : AddCircle (1 : ℝ))) :=
        congrArg (fun z : AddCircle (1 : ℝ) × I ↦ z.1) hpq
      exact sameHeightStep hsnd hfst
    · -- Bottom-top twists are rebuilt directly from the square generators.
      exact bottomTopStep hp0 hp'1 hneg
    · -- Top-bottom twists reduce to the previous branch after reversing the square relation.
      exact Relation.EqvGen.symm _ _ <| bottomTopStep hp'0 hp1 (by simpa using hneg.symm)

/-- Helper for Example 10.1.9: the Klein-bottle square quotient is homeomorphic to the explicit
cylinder-boundary quotient used to detect its kernel relation. -/
private noncomputable def kleinBottleFromSquareHomeomorphCylinderQuotient :
    KleinBottleFromSquare ≃ₜ Quotient kleinBottleCylinderSetoid :=
  quotientHomeomorphOfRelIff kleinBottleCylinderComparison
    kleinBottleCylinderComparison_isQuotientMap kleinBottleSquareSetoid
    kleinBottleCylinderComparison_rel_iff

/-- The quotient model `KleinBottleFromSquare` is Hausdorff. -/
instance instT2SpaceKleinBottleFromSquare : T2Space KleinBottleFromSquare := by
  -- Route correction: replace the broken global strip involution by the correct quotient of the
  -- cylinder that only twists the two boundary circles.
  -- Once the kernel is identified, Hausdorffness transports back along the quotient homeomorphism.
  let _ : T2Space (Quotient kleinBottleCylinderSetoid) := kleinBottleCylinderQuotient_t2Space
  exact kleinBottleFromSquareHomeomorphCylinderQuotient.symm.t2Space

/-- Helper for Example 10.1.9: if a CW complex has no cells above dimension `2`, then its
canonical skeleton already stabilizes at degree `2`. -/
private theorem dimLE_two_of_isEmpty_higherCells
    {X : Type*} [TopologicalSpace X] [T2Space X]
    [Topology.CWComplex (Set.univ : Set X)]
    (hcell :
      ∀ n : ℕ, 2 < n → IsEmpty (Topology.CWComplex.cell (Set.univ : Set X) n)) :
    Topology.RelCWComplex.dimLE (Set.univ : Set X) 2 := by
  ext x
  constructor
  · intro hx
    simp
  · intro _
    -- Start from the union of all skeleta and pick an open cell containing `x`.
    have hxUnion : x ∈ ⋃ n : ℕ, Topology.CWComplex.skeleton (Set.univ : Set X) n := by
      simpa [Topology.CWComplex.iUnion_skeleton_eq_complex]
    rcases Set.mem_iUnion.mp hxUnion with ⟨n, hn⟩
    rcases (Topology.CWComplex.exists_mem_openCell_of_mem_skeleton (C := (Set.univ : Set X))).mp hn
      with ⟨m, hm, j, hj⟩
    -- The chosen cell cannot live in a dimension above `2`, because such cell types are empty.
    have hm2 : m ≤ 2 := by
      by_contra hm2
      exact (hcell m (lt_of_not_ge hm2)).false j
    have hxSkelM : x ∈ Topology.CWComplex.skeleton (Set.univ : Set X) m :=
      Topology.CWComplex.openCell_subset_skeleton (C := (Set.univ : Set X)) m j hj
    exact Topology.CWComplex.skeleton_mono (C := (Set.univ : Set X))
      (show (m : ℕ∞) ≤ 2 by exact_mod_cast hm2) hxSkelM

/-- Helper for Example 10.1.9: the common square-presentation cell family has one `0`-cell,
two `1`-cells, one `2`-cell, and no higher-dimensional cells. -/
private abbrev surfaceSquareCell : ℕ → Type
  | 0 => Fin 1
  | 1 => Fin 2
  | 2 => Fin 1
  | _ => PEmpty

/-- Helper for Example 10.1.9: the common square-presentation cell family is finite in every
dimension. -/
private theorem surfaceSquareCell_finite (n : ℕ) : Finite (surfaceSquareCell n) := by
  -- The only nonempty dimensions are `0`, `1`, and `2`, each with a finite index type.
  rcases n with _ | _ | _ | n
  · simpa [surfaceSquareCell] using (inferInstance : Finite (Fin 1))
  · simpa [surfaceSquareCell] using (inferInstance : Finite (Fin 2))
  · simpa [surfaceSquareCell] using (inferInstance : Finite (Fin 1))
  · simpa [surfaceSquareCell] using (inferInstance : Finite PEmpty.{1})

/-- Helper for Example 10.1.9: the common square-presentation cell family is empty above
dimension `2`. -/
private theorem surfaceSquareCell_isEmpty_of_two_lt (n : ℕ) (hn : 2 < n) :
    IsEmpty (surfaceSquareCell n) := by
  -- Once `n ≥ 3`, the cell family definition reduces to `PEmpty`.
  rcases n with _ | _ | _ | n
  · omega
  · omega
  · omega
  · simpa [surfaceSquareCell] using (inferInstance : IsEmpty PEmpty.{1})

/-- Helper for Example 10.1.9: the common square-presentation cell family is eventually empty. -/
private theorem surfaceSquareCell_eventuallyIsEmpty :
    ∀ᶠ n in Filter.atTop, IsEmpty (surfaceSquareCell n) := by
  -- Starting from degree `3`, every cell index type is definitionally empty.
  simp only [Filter.eventually_atTop, ge_iff_le]
  refine ⟨3, ?_⟩
  intro n hn
  exact surfaceSquareCell_isEmpty_of_two_lt n (by omega)

/-- Helper for Example 10.1.9: the open `1`-ball source used by the square-presentation edge
cells. -/
private abbrev surfaceEdgeOpenBall :=
  Metric.ball (0 : Fin 1 → ℝ) 1

/-- Helper for Example 10.1.9: an interior interval parameter maps under
`surfaceEdgeParamHomeomorph.symm` to the open unit ball. -/
private theorem surfaceEdgeParamHomeomorph_symm_mem_ball_of_mem_Ioo
    {t : ℝ} (ht : t ∈ Set.Ioo (0 : ℝ) 1) :
    (((surfaceEdgeParamHomeomorph.symm ⟨t, ⟨le_of_lt ht.1, le_of_lt ht.2⟩⟩ :
        surfaceEdgeClosedBall) : Fin 1 → ℝ) ∈ surfaceEdgeOpenBall) := by
  -- The inverse coordinate is the constant function `2 * t - 1`, whose absolute value is `< 1`
  -- exactly when `0 < t < 1`.
  rw [mem_ball_zero_iff]
  have hcoord :
      (((surfaceEdgeParamHomeomorph.symm ⟨t, ⟨le_of_lt ht.1, le_of_lt ht.2⟩⟩ :
          surfaceEdgeClosedBall) : Fin 1 → ℝ)) =
        fun _ ↦ 2 * t - 1 := by
    ext i
    have hi : i = 0 := Subsingleton.elim _ _
    subst hi
    exact surfaceEdgeParamHomeomorph_symm_coord ⟨t, ⟨le_of_lt ht.1, le_of_lt ht.2⟩⟩
  have habs : |2 * t - 1| < 1 := by
    rw [abs_lt]
    constructor
    · nlinarith [ht.1]
    · nlinarith [ht.2]
  have hnorm : ‖(fun _ : Fin 1 ↦ 2 * t - 1)‖ < 1 := by
    calc
      ‖(fun _ : Fin 1 ↦ 2 * t - 1)‖ = ‖2 * t - 1‖ := by
        simpa using
          (pi_norm_const' (2 * t - 1) :
            ‖fun _ : Fin 1 ↦ 2 * t - 1‖ = ‖2 * t - 1‖)
      _ = |2 * t - 1| := by rw [Real.norm_eq_abs]
      _ < 1 := habs
  simpa [surfaceEdgeOpenBall, hcoord] using hnorm

