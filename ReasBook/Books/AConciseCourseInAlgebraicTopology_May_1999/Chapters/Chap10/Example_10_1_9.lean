/-- Helper for Example 10.1.9: the square-pyramid denominator is positive and dominates the two
horizontal coordinates. -/
private theorem surfaceSquarePyramidDenominatorBounds
    (u : EuclideanSpace ℝ (Fin 3)) (hu₂ : 0 ≤ u 2) (hu_norm : ‖u‖ = 1) :
    let m : ℝ := max ‖u 0‖ ‖u 1‖
    let a : ℝ := m + u 2
    0 < a ∧ m ≤ a ∧ ‖u 0‖ ≤ a ∧ ‖u 1‖ ≤ a := by
  let m : ℝ := max ‖u 0‖ ‖u 1‖
  let a : ℝ := m + u 2
  have hm_nonneg : 0 ≤ m := by
    simp [m]
  have hm_le_a : m ≤ a := by
    show m ≤ m + u 2
    linarith
  have hu0_le_m : ‖u 0‖ ≤ m := by
    simp [m]
  have hu1_le_m : ‖u 1‖ ≤ m := by
    simp [m]
  have hu0_le_a : ‖u 0‖ ≤ a := hu0_le_m.trans hm_le_a
  have hu1_le_a : ‖u 1‖ ≤ a := hu1_le_m.trans hm_le_a
  have ha_nonneg : 0 ≤ a := hm_nonneg.trans hm_le_a
  have ha_ne_zero : a ≠ 0 := by
    intro ha_zero
    have hm_zero : m = 0 := by
      linarith
    have hu2_zero : u 2 = 0 := by
      linarith
    have hu0_zero : u 0 = 0 := by
      apply norm_eq_zero.mp
      exact le_antisymm (by simpa [hm_zero] using hu0_le_m) (norm_nonneg _)
    have hu1_zero : u 1 = 0 := by
      apply norm_eq_zero.mp
      exact le_antisymm (by simpa [hm_zero] using hu1_le_m) (norm_nonneg _)
    have hu_zero : u = 0 := by
      ext i
      fin_cases i
      · exact hu0_zero
      · exact hu1_zero
      · exact hu2_zero
    have hzero_one : (0 : ℝ) = 1 := by
      simpa [hu_zero] using hu_norm
    norm_num at hzero_one
  exact ⟨lt_of_le_of_ne ha_nonneg fun h ↦ ha_ne_zero h.symm, hm_le_a, hu0_le_a, hu1_le_a⟩

