  exact IsQuotientMap.of_surjective_continuous
    realProjectivePlaneSquareComparison_surjective realProjectivePlaneSquareComparison.continuous

/-- The square quotient with reversed edge identifications is a source-facing model of
`RealProjectiveSpace 2`. -/
theorem realProjectivePlaneSquareQuotient_homeomorphic_realProjectiveSpace :
