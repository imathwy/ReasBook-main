/-- Helper for Example 10.1.9: every projective class has a representative in the image of the
square comparison map. -/
private theorem realProjectivePlaneSquareComparison_surjective :
    Function.Surjective realProjectivePlaneSquareComparison := by
  intro z
  rcases sphereToRealProjectiveSpace_surjective 2 z with ⟨y, rfl⟩
  let u : EuclideanSpace ℝ (Fin 3) := (TopCat.sphereModelHomeomorph 2 y).1
  by_cases hy₂ : 0 ≤ u 2
  · rcases surfaceSquarePyramidRepresentative_of_nonnegThird y hy₂ with ⟨x, hx⟩
    refine ⟨surfaceSquareFaceParam x, ?_⟩
    -- The chosen square point maps back to the original projective class.
    simpa [realProjectivePlaneSquareComparison, hx]
  · have hneg₂ : 0 ≤ (TopCat.sphereModelHomeomorph 2 (-y)).1 2 := by
      -- Flipping the sphere representative reverses the sign of the third coordinate.
      have hcoord :
          (TopCat.sphereModelHomeomorph 2 (-y)).1 2 = -(u 2) := by
        simpa [u] using congrArg (fun v : EuclideanSpace ℝ (Fin 3) ↦ v 2)
          (show (TopCat.sphereModelHomeomorph 2 (-y)).1 = -u by rfl)
      linarith [lt_of_not_ge hy₂]
    rcases surfaceSquarePyramidRepresentative_of_nonnegThird (-y) hneg₂ with ⟨x, hx⟩
    refine ⟨surfaceSquareFaceParam x, ?_⟩
    -- The antipodal sphere representative determines the same projective point.
    calc
      realProjectivePlaneSquareComparison (surfaceSquareFaceParam x)
          = sphereToRealProjectiveSpace 2 (-y) := by
              simpa [realProjectivePlaneSquareComparison, hx]
      _ = sphereToRealProjectiveSpace 2 y := by
            exact (sphereToRealProjectiveSpace_eq_iff 2).2 (Or.inr rfl)

/-- Helper for Example 10.1.9: the square comparison map is a quotient map because it is
continuous and surjective onto the Hausdorff projective plane. -/
private theorem realProjectivePlaneSquareComparison_isQuotientMap :
