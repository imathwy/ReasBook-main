/-- The generating edge identifications for the standard torus quotient of the square. -/
def torusSquareEdgeRel (p q : I × I) : Prop :=
  (((p.1 : ℝ) = 0) ∧ ((q.1 : ℝ) = 1) ∧ p.2 = q.2) ∨
    (((p.2 : ℝ) = 0) ∧ ((q.2 : ℝ) = 1) ∧ p.1 = q.1)

/-- The equivalence relation on `I × I` generated by the torus edge identifications. -/
def torusSquareSetoid : Setoid (I × I) :=
  Relation.EqvGen.setoid torusSquareEdgeRel

/-- The torus obtained from the square `I × I` by identifying both pairs of opposite edges with
the same orientation. -/
abbrev TorusFromSquare :=
  Quotient torusSquareSetoid

/-- A generating edge identification in the square model becomes an equality in
`TorusFromSquare`. -/
theorem torusFromSquare_mk_eq_mk {p q : I × I} (h : torusSquareEdgeRel p q) :
    (Quotient.mk'' p : TorusFromSquare) = Quotient.mk'' q :=
  Quotient.sound (Relation.EqvGen.rel _ _ h)

/-- In `TorusFromSquare`, the left and right edges of the square are identified with the same
orientation. -/
theorem torusFromSquare_left_eq_right (t : I) :
    (Quotient.mk'' ((0 : I), t) : TorusFromSquare) = Quotient.mk'' (1, t) :=
  torusFromSquare_mk_eq_mk <| Or.inl ⟨rfl, rfl, rfl⟩

/-- In `TorusFromSquare`, the bottom and top edges of the square are identified with the same
orientation. -/
theorem torusFromSquare_bottom_eq_top (t : I) :
    (Quotient.mk'' (t, (0 : I)) : TorusFromSquare) = Quotient.mk'' (t, 1) :=
  torusFromSquare_mk_eq_mk <| Or.inr ⟨rfl, rfl, rfl⟩

/-- Helper for Example 10.1.9: if a quotient map identifies exactly the classes of a setoid, then
the setoid quotient is homeomorphic to the codomain. -/
private noncomputable def quotientHomeomorphOfRelIff
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    (q : C(X, Y)) (hq : Topology.IsQuotientMap q) (r : Setoid X)
    (hrel : ∀ x y : X, r x y ↔ q x = q y) :
    Quotient r ≃ₜ Y := by
  have hker : Setoid.ker q = r := by
    ext x y
    exact (hrel x y).symm
  -- Repackage the quotient topology through the kernel relation of the quotient map.
  exact hker ▸ Topology.IsQuotientMap.homeomorph hq

/-- Helper for Example 10.1.9: taking the product of a quotient map with the identity on a locally
compact factor is again a quotient map. -/
private theorem isQuotientMap_prodMap_right
    {X Y K : Type*} [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace K]
    [LocallyCompactSpace K] (π : X → Y) (hπ : Topology.IsQuotientMap π) :
    Topology.IsQuotientMap (fun p : K × X ↦ (p.1, π p.2)) := by
  let qK : K × X → K × Y := fun p ↦ (p.1, π p.2)
  refine ⟨?_, ?_⟩
  · -- Surjectivity is inherited from the quotient map on the right factor.
    intro p
    rcases hπ.surjective p.2 with ⟨x, hx⟩
    refine ⟨(p.1, x), ?_⟩
    ext <;> simp [hx]
  · have hqK : Continuous qK := continuous_fst.prodMk (hπ.continuous.comp continuous_snd)
    have hCoinducedLe :
        TopologicalSpace.coinduced qK (inferInstance : TopologicalSpace (K × X)) ≤
          (inferInstance : TopologicalSpace (K × Y)) :=
      continuous_iff_coinduced_le.mp hqK
    have hLeCoinduced :
        (inferInstance : TopologicalSpace (K × Y)) ≤
          TopologicalSpace.coinduced qK (inferInstance : TopologicalSpace (K × X)) := by
      rw [← continuous_id_iff_le]
      let _ : TopologicalSpace (K × Y) :=
        TopologicalSpace.coinduced qK (inferInstance : TopologicalSpace (K × X))
      -- The product-lift API reconstructs continuity from continuity after precomposing with `π`.
      exact
        @Topology.IsQuotientMap.continuous_lift_prod_right
          X Y K (K × Y)
          inferInstance inferInstance inferInstance
          (TopologicalSpace.coinduced qK (inferInstance : TopologicalSpace (K × X)))
          inferInstance π hπ id continuous_coinduced_rng
    exact le_antisymm hLeCoinduced hCoinducedLe

/-- Helper for Example 10.1.9: taking the product of the identity with a quotient map on a locally
compact factor is again a quotient map. -/
private theorem isQuotientMap_prodMap_left
    {X Y K : Type*} [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace K]
    [LocallyCompactSpace K] (π : X → Y) (hπ : Topology.IsQuotientMap π) :
    Topology.IsQuotientMap (fun p : X × K ↦ (π p.1, p.2)) := by
  let qK : X × K → Y × K := fun p ↦ (π p.1, p.2)
  refine ⟨?_, ?_⟩
  · -- Surjectivity is inherited from the quotient map on the left factor.
    intro p
    rcases hπ.surjective p.1 with ⟨x, hx⟩
    refine ⟨(x, p.2), ?_⟩
    ext <;> simp [hx]
  · have hqK : Continuous qK := (hπ.continuous.comp continuous_fst).prodMk continuous_snd
    have hCoinducedLe :
        TopologicalSpace.coinduced qK (inferInstance : TopologicalSpace (X × K)) ≤
          (inferInstance : TopologicalSpace (Y × K)) :=
      continuous_iff_coinduced_le.mp hqK
    have hLeCoinduced :
        (inferInstance : TopologicalSpace (Y × K)) ≤
          TopologicalSpace.coinduced qK (inferInstance : TopologicalSpace (X × K)) := by
      rw [← continuous_id_iff_le]
      let _ : TopologicalSpace (Y × K) :=
        TopologicalSpace.coinduced qK (inferInstance : TopologicalSpace (X × K))
      -- This is the left-handed version of the same quotient-product reconstruction.
      exact
        @Topology.IsQuotientMap.continuous_lift_prod_left
          X Y K (Y × K)
          inferInstance inferInstance inferInstance
          (TopologicalSpace.coinduced qK (inferInstance : TopologicalSpace (X × K)))
          inferInstance π hπ id continuous_coinduced_rng
    exact le_antisymm hLeCoinduced hCoinducedLe

/-- Helper for Example 10.1.9: two points of `I` have the same image in `AddCircle (1 : ℝ)`
exactly when they agree or are opposite endpoints of the interval. -/
private theorem unitInterval_addCircle_eq_iff (x y : I) :
    (((x : ℝ) : AddCircle (1 : ℝ)) = ((y : ℝ) : AddCircle (1 : ℝ))) ↔
      x = y ∨ (x = 0 ∧ y = 1) ∨ (x = 1 ∧ y = 0) := by
  constructor
  · intro hxy
    by_cases hx1 : x = 1
    · by_cases hy1 : y = 1
      · -- If both points are the right endpoint then they coincide.
        exact Or.inl (hx1.trans hy1.symm)
      · -- Otherwise equality in the quotient forces the other representative to be `0`.
        have hyIco : (y : ℝ) ∈ Set.Ico (0 : ℝ) 1 := by
          refine ⟨y.2.1, lt_of_le_of_ne y.2.2 ?_⟩
          intro hyEq
          exact hy1 (Subtype.ext hyEq)
        have hy0 : y = 0 := by
          apply Subtype.ext
          exact (AddCircle.coe_eq_zero_iff_of_mem_Ico (p := (1 : ℝ)) hyIco).mp <|
            calc
              (((y : ℝ) : AddCircle (1 : ℝ))) = ((x : ℝ) : AddCircle (1 : ℝ)) := hxy.symm
              _ = ((1 : ℝ) : AddCircle (1 : ℝ)) := by simpa [hx1]
              _ = 0 := by
                simpa using (AddCircle.coe_add_period (p := (1 : ℝ)) (x := (0 : ℝ)))
        exact Or.inr (Or.inr ⟨hx1, hy0⟩)
    · by_cases hy1 : y = 1
      · -- This is the symmetric endpoint-identification case.
        have hxIco : (x : ℝ) ∈ Set.Ico (0 : ℝ) 1 := by
          refine ⟨x.2.1, lt_of_le_of_ne x.2.2 ?_⟩
          intro hxEq
          exact hx1 (Subtype.ext hxEq)
        have hx0 : x = 0 := by
          apply Subtype.ext
          exact (AddCircle.coe_eq_zero_iff_of_mem_Ico (p := (1 : ℝ)) hxIco).mp <|
            calc
              (((x : ℝ) : AddCircle (1 : ℝ))) = ((y : ℝ) : AddCircle (1 : ℝ)) := hxy
              _ = ((1 : ℝ) : AddCircle (1 : ℝ)) := by simpa [hy1]
              _ = 0 := by
                simpa using (AddCircle.coe_add_period (p := (1 : ℝ)) (x := (0 : ℝ)))
        exact Or.inr (Or.inl ⟨hx0, hy1⟩)
      · -- Away from the right endpoint, the quotient map is injective on `[0, 1)`.
        have hxIco : (x : ℝ) ∈ Set.Ico (0 : ℝ) 1 := by
          refine ⟨x.2.1, lt_of_le_of_ne x.2.2 ?_⟩
          intro hxEq
          exact hx1 (Subtype.ext hxEq)
        have hyIco : (y : ℝ) ∈ Set.Ico (0 : ℝ) 1 := by
          refine ⟨y.2.1, lt_of_le_of_ne y.2.2 ?_⟩
          intro hyEq
          exact hy1 (Subtype.ext hyEq)
        have hxy_real : (x : ℝ) = (y : ℝ) := by
          exact
            (AddCircle.coe_eq_coe_iff_of_mem_Ico
              (p := (1 : ℝ)) (a := (0 : ℝ)) (by simpa [zero_add] using hxIco)
              (by simpa [zero_add] using hyIco)).mp hxy
        exact Or.inl (Subtype.ext hxy_real)
  · rintro (rfl | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · rfl
    · simpa using (AddCircle.coe_add_period (p := (1 : ℝ)) (x := (0 : ℝ))).symm
    · simpa using (AddCircle.coe_add_period (p := (1 : ℝ)) (x := (0 : ℝ)))

/-- Helper for Example 10.1.9: reflecting a point of `I` across the midpoint negates its
`AddCircle (1 : ℝ)` coordinate. -/
private theorem unitInterval_symm_addCircle_eq_neg (x : I) :
    (((unitInterval.symm x : I) : ℝ) : AddCircle (1 : ℝ)) =
      -((x : ℝ) : AddCircle (1 : ℝ)) := by
  -- Rewrite the reflected coordinate as `-x + 1` and then absorb the period `1`.
  rw [unitInterval.coe_symm_eq]
  have hrewrite : 1 - (x : ℝ) = -(x : ℝ) + 1 := by ring
  rw [hrewrite]
  calc
    (((-(x : ℝ) + 1 : ℝ)) : AddCircle (1 : ℝ)) = ((-(x : ℝ) : ℝ) : AddCircle (1 : ℝ)) := by
      simpa [add_assoc, add_comm, add_left_comm] using
        (AddCircle.coe_add_period (p := (1 : ℝ)) (x := (-(x : ℝ))))
    _ = -((x : ℝ) : AddCircle (1 : ℝ)) := by simp

/-- Helper for Example 10.1.9: the closed `1`-ball source used by CW `1`-cells. -/
private abbrev surfaceEdgeClosedBall :=
  Metric.closedBall (0 : Fin 1 → ℝ) 1

/-- Helper for Example 10.1.9: the closed `2`-ball source used by the square-face model. -/
private abbrev surfaceSquareClosedBall :=
  Metric.closedBall (0 : Fin 2 → ℝ) 1

/-- Helper for Example 10.1.9: evaluating the unique coordinate identifies the closed `1`-ball
with `[-1, 1]`. -/
private noncomputable def surfaceEdgeClosedBallHomeomorphIcc :
    surfaceEdgeClosedBall ≃ₜ Set.Icc (-1 : ℝ) 1 where
  toEquiv :=
    { toFun := fun x ↦
        ⟨x.1 0, by
          -- Read the closed-ball bound on the unique coordinate.
          have hxnorm : ‖x.1‖ ≤ 1 := by
            exact mem_closedBall_zero_iff.mp x.2
          have hxcoord : ‖x.1 0‖ ≤ 1 :=
            (pi_norm_le_iff_of_nonneg zero_le_one).1 hxnorm 0
          simpa [Real.norm_eq_abs, abs_le] using hxcoord⟩
      invFun := fun t ↦
        ⟨fun _ ↦ (t : ℝ), by
          -- The constant function with value in `[-1, 1]` lies in the closed `1`-ball.
          have htcoord : ∀ i : Fin 1, ‖(t : ℝ)‖ ≤ 1 := by
            intro i
            have htbounds : (-1 : ℝ) ≤ (t : ℝ) ∧ (t : ℝ) ≤ 1 := by
              exact t.2
            simpa [Real.norm_eq_abs, abs_le] using htbounds
          have htnorm : ‖(fun _ : Fin 1 ↦ (t : ℝ))‖ ≤ 1 :=
            (pi_norm_le_iff_of_nonneg zero_le_one).2 htcoord
          simpa [surfaceEdgeClosedBall, Metric.mem_closedBall, dist_zero_right] using htnorm⟩
      left_inv := by
        intro x
        -- Functions on `Fin 1` are determined by their unique coordinate.
        apply Subtype.ext
        ext i
        have hi : i = 0 := Subsingleton.elim _ _
        subst hi
        rfl
      right_inv := by
        intro t
        -- The coordinate extractor is inverse to the constant-function reconstruction.
        apply Subtype.ext
        rfl }
  continuous_toFun := by
    -- The forward map is just evaluation at the unique coordinate.
    refine Continuous.subtype_mk ?_ ?_
    exact
      (continuous_apply 0 : Continuous fun x : Fin 1 → ℝ ↦ x 0).comp continuous_subtype_val
  continuous_invFun := by
    -- The inverse map is the continuous constant-function inclusion.
    refine Continuous.subtype_mk ?_ ?_
    continuity

/-- Helper for Example 10.1.9: the shared `1`-cell reparameterization from the closed `1`-ball to
`I`. -/
private noncomputable def surfaceEdgeParamHomeomorph :
    surfaceEdgeClosedBall ≃ₜ I :=
  surfaceEdgeClosedBallHomeomorphIcc.trans (iccHomeoI (-1 : ℝ) 1 (by norm_num))

/-- Helper for Example 10.1.9: each coordinate of a point in the square closed ball already gives
an edge closed-ball parameter. -/
private theorem surfaceSquareClosedBall_coord_mem (x : surfaceSquareClosedBall) (i : Fin 2) :
    (fun _ : Fin 1 ↦ x.1 i) ∈ surfaceEdgeClosedBall := by
  -- Read the square closed-ball bound coordinatewise, then forget to the unique coordinate of
  -- `Fin 1`.
  have hxnorm : ‖x.1‖ ≤ 1 := mem_closedBall_zero_iff.mp x.2
  have hxcoord : ∀ j : Fin 2, ‖x.1 j‖ ≤ 1 :=
    (pi_norm_le_iff_of_nonneg zero_le_one).1 hxnorm
  have hnorm : ‖(fun _ : Fin 1 ↦ x.1 i)‖ ≤ 1 := by
    refine (pi_norm_le_iff_of_nonneg zero_le_one).2 ?_
    intro j
    have hj : j = 0 := Subsingleton.elim _ _
    subst hj
    simpa using hxcoord i
  exact mem_closedBall_zero_iff.mpr hnorm

/-- Helper for Example 10.1.9: combining two edge closed-ball parameters produces a point of the
square closed ball. -/
private theorem surfaceSquareClosedBall_pair_mem
    (u v : surfaceEdgeClosedBall) :
    ![u.1 0, v.1 0] ∈ surfaceSquareClosedBall := by
  -- Each edge parameter is bounded by `1`, so the two-coordinate function is also bounded by `1`.
  have hunorm : ‖u.1‖ ≤ 1 := mem_closedBall_zero_iff.mp u.2
  have hvnorm : ‖v.1‖ ≤ 1 := mem_closedBall_zero_iff.mp v.2
  have hucoord : ∀ j : Fin 1, ‖u.1 j‖ ≤ 1 :=
    (pi_norm_le_iff_of_nonneg zero_le_one).1 hunorm
  have hvcoord : ∀ j : Fin 1, ‖v.1 j‖ ≤ 1 :=
    (pi_norm_le_iff_of_nonneg zero_le_one).1 hvnorm
  have hnorm : ‖(![u.1 0, v.1 0] : Fin 2 → ℝ)‖ ≤ 1 := by
    refine (pi_norm_le_iff_of_nonneg zero_le_one).2 ?_
    intro i
    fin_cases i
    · simpa using hucoord 0
    · simpa using hvcoord 0
  exact mem_closedBall_zero_iff.mpr hnorm

/-- Helper for Example 10.1.9: the square closed ball projects to its two edge coordinates. -/
private def surfaceSquareClosedBallToEdgePair (x : surfaceSquareClosedBall) :
    surfaceEdgeClosedBall × surfaceEdgeClosedBall :=
  (⟨fun _ : Fin 1 ↦ x.1 0, surfaceSquareClosedBall_coord_mem x 0⟩,
    ⟨fun _ : Fin 1 ↦ x.1 1, surfaceSquareClosedBall_coord_mem x 1⟩)

/-- Helper for Example 10.1.9: a pair of edge coordinates reconstructs a square closed-ball
point. -/
private def surfaceSquareClosedBallFromEdgePairAux
    (p : surfaceEdgeClosedBall × surfaceEdgeClosedBall) : Fin 2 → ℝ :=
  ![p.1.1 0, p.2.1 0]

/-- Helper for Example 10.1.9: a pair of edge coordinates reconstructs a square closed-ball
point. -/
private def surfaceSquareClosedBallFromEdgePair (p : surfaceEdgeClosedBall × surfaceEdgeClosedBall) :
    surfaceSquareClosedBall :=
  ⟨surfaceSquareClosedBallFromEdgePairAux p, surfaceSquareClosedBall_pair_mem p.1 p.2⟩

/-- Helper for Example 10.1.9: reconstructing from the projected edge pair returns the original
square point. -/
private theorem surfaceSquareClosedBall_left_inv (x : surfaceSquareClosedBall) :
    surfaceSquareClosedBallFromEdgePair (surfaceSquareClosedBallToEdgePair x) = x := by
  -- The reconstruction reads back exactly the two coordinates of the original square point.
  apply Subtype.ext
  ext i
  fin_cases i <;> rfl

/-- Helper for Example 10.1.9: projecting a reconstructed edge pair returns the original pair. -/
private theorem surfaceSquareClosedBall_right_inv
    (p : surfaceEdgeClosedBall × surfaceEdgeClosedBall) :
    surfaceSquareClosedBallToEdgePair (surfaceSquareClosedBallFromEdgePair p) = p := by
  -- Each `Fin 1` parameter is determined by its unique coordinate.
  rcases p with ⟨u, v⟩
  apply Prod.ext
  · apply Subtype.ext
    ext i
    have hi : i = 0 := Subsingleton.elim _ _
    subst hi
    rfl
  · apply Subtype.ext
    ext i
    have hi : i = 0 := Subsingleton.elim _ _
    subst hi
    rfl

/-- Helper for Example 10.1.9: the edge-pair projection of the square closed ball is continuous. -/
private theorem surfaceSquareClosedBallToEdgePair_continuous :
    Continuous surfaceSquareClosedBallToEdgePair := by
  -- Continuity is coordinatewise on the two square coordinates.
  refine
    (Continuous.subtype_mk ?_ fun x ↦ surfaceSquareClosedBall_coord_mem x 0).prodMk
      (Continuous.subtype_mk ?_ fun x ↦ surfaceSquareClosedBall_coord_mem x 1)
  · refine continuous_pi ?_
    intro i
    have hi : i = 0 := Subsingleton.elim _ _
    subst hi
    exact (continuous_apply 0 : Continuous fun y : Fin 2 → ℝ ↦ y 0).comp continuous_subtype_val
  · refine continuous_pi ?_
    intro i
    have hi : i = 0 := Subsingleton.elim _ _
    subst hi
    exact (continuous_apply 1 : Continuous fun y : Fin 2 → ℝ ↦ y 1).comp continuous_subtype_val

/-- Helper for Example 10.1.9: reconstructing a square point from the two edge parameters is
continuous. -/
private theorem surfaceSquareClosedBallFromEdgePairAux_continuous :
    Continuous surfaceSquareClosedBallFromEdgePairAux := by
  -- The ambient reconstruction only reads the unique coordinate from each edge parameter.
  refine continuous_pi ?_
  intro i
  fin_cases i
  · exact
      (continuous_apply 0 : Continuous fun y : Fin 1 → ℝ ↦ y 0).comp
        (continuous_subtype_val.comp continuous_fst)
  · exact
      (continuous_apply 0 : Continuous fun y : Fin 1 → ℝ ↦ y 0).comp
        (continuous_subtype_val.comp continuous_snd)

/-- Helper for Example 10.1.9: reconstructing a square point from the two edge parameters is
continuous. -/
private theorem surfaceSquareClosedBallFromEdgePair_continuous :
    Continuous surfaceSquareClosedBallFromEdgePair := by
  -- The reconstruction is continuous on each of the two recovered coordinates.
  exact
    Continuous.subtype_mk surfaceSquareClosedBallFromEdgePairAux_continuous
      (fun p ↦ surfaceSquareClosedBall_pair_mem p.1 p.2)

/-- Helper for Example 10.1.9: the square closed ball is homeomorphic to the product of the two
edge closed balls. -/
private noncomputable def surfaceSquareClosedBallHomeomorphProd :
    surfaceSquareClosedBall ≃ₜ surfaceEdgeClosedBall × surfaceEdgeClosedBall where
  toEquiv :=
    { toFun := surfaceSquareClosedBallToEdgePair
      invFun := surfaceSquareClosedBallFromEdgePair
      left_inv := surfaceSquareClosedBall_left_inv
      right_inv := surfaceSquareClosedBall_right_inv }
  continuous_toFun := surfaceSquareClosedBallToEdgePair_continuous
  continuous_invFun := surfaceSquareClosedBallFromEdgePair_continuous

/-- Helper for Example 10.1.9: the shared square-face reparameterization from the closed square
model `surfaceSquareClosedBall` to `I × I`. -/
private noncomputable def surfaceSquareFaceParam :
    surfaceSquareClosedBall ≃ₜ I × I :=
  -- Route correction: avoid paying the closed-ball transport cost through `Fin.appendIsometryOfEq`
  -- inline by naming the subtype-level product homeomorphism once and reusing it here.
  (surfaceSquareClosedBallHomeomorphProd).trans
    (surfaceEdgeParamHomeomorph.prodCongr surfaceEdgeParamHomeomorph)

/-- Helper for Example 10.1.9: the torus square quotient is compared to the product of the two
circle quotients by recording the two interval coordinates modulo endpoint identification. -/
private noncomputable def torusSquareComparison :
    C(I × I, AddCircle (1 : ℝ) × AddCircle (1 : ℝ)) :=
  ⟨fun p ↦ (((p.1 : ℝ) : AddCircle (1 : ℝ)), ((p.2 : ℝ) : AddCircle (1 : ℝ))),
    by
      -- The comparison map is just the product of the two endpoint-quotient maps.
      refine
        ((AddCircle.continuous_mk' (1 : ℝ)).comp
            (continuous_subtype_val.comp continuous_fst)).prodMk
          ((AddCircle.continuous_mk' (1 : ℝ)).comp
            (continuous_subtype_val.comp continuous_snd))⟩

/-- Helper for Example 10.1.9: the torus square comparison is a quotient map because every pair of
circle coordinates has representatives in the closed interval `[0, 1]`. -/
private theorem torusSquareComparison_isQuotientMap :
    Topology.IsQuotientMap torusSquareComparison := by
  refine IsQuotientMap.of_surjective_continuous ?_ torusSquareComparison.continuous
  intro z
  -- Pick representatives of both circle coordinates in the closed interval `[0, 1]`.
  have hx_image : z.1 ∈ (((↑) : ℝ → AddCircle (1 : ℝ)) '' Set.Icc (0 : ℝ) 1) := by
    simpa using
      (show z.1 ∈ (((↑) : ℝ → AddCircle (1 : ℝ)) '' Set.Icc (0 : ℝ) ((0 : ℝ) + 1)) by
        rw [AddCircle.coe_image_Icc_eq (p := (1 : ℝ)) (a := (0 : ℝ))]
        simp)
  have hy_image : z.2 ∈ (((↑) : ℝ → AddCircle (1 : ℝ)) '' Set.Icc (0 : ℝ) 1) := by
    simpa using
      (show z.2 ∈ (((↑) : ℝ → AddCircle (1 : ℝ)) '' Set.Icc (0 : ℝ) ((0 : ℝ) + 1)) by
        rw [AddCircle.coe_image_Icc_eq (p := (1 : ℝ)) (a := (0 : ℝ))]
        simp)
  rcases hx_image with ⟨x, hx, hxeq⟩
  rcases hy_image with ⟨y, hy, hyeq⟩
  refine ⟨⟨⟨x, hx⟩, ⟨y, hy⟩⟩, ?_⟩
  change (((x : ℝ) : AddCircle (1 : ℝ)), ((y : ℝ) : AddCircle (1 : ℝ))) = z
  simp [hxeq, hyeq]

/-- Helper for Example 10.1.9: two square points have the same torus comparison image exactly when
they are equivalent under the generated opposite-edge identification relation. -/
private theorem torusSquareComparison_rel_iff (p p' : I × I) :
    torusSquareSetoid p p' ↔ torusSquareComparison p = torusSquareComparison p' := by
  have hfirstChange :
      ∀ {x y t : I}, ((x = 0 ∧ y = 1) ∨ (x = 1 ∧ y = 0)) →
        torusSquareSetoid (x, t) (y, t) := by
    intro x y t hxy
    rcases hxy with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · -- This is exactly the generating left-right edge identification.
      exact Relation.EqvGen.rel _ _ (Or.inl ⟨rfl, rfl, rfl⟩)
    · -- Reversing the same generator gives the opposite endpoint orientation.
      exact Relation.EqvGen.symm _ _ <| Relation.EqvGen.rel _ _
        (Or.inl ⟨rfl, rfl, rfl⟩)
  have hsecondChange :
      ∀ {x t u : I}, ((t = 0 ∧ u = 1) ∨ (t = 1 ∧ u = 0)) →
        torusSquareSetoid (x, t) (x, u) := by
    intro x t u htu
    rcases htu with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · -- This is exactly the generating bottom-top edge identification.
      exact Relation.EqvGen.rel _ _ (Or.inr ⟨rfl, rfl, rfl⟩)
    · -- Reversing the same generator gives the opposite endpoint orientation.
      exact Relation.EqvGen.symm _ _ <| Relation.EqvGen.rel _ _
        (Or.inr ⟨rfl, rfl, rfl⟩)
  constructor
  · intro hpq
    -- Reduce the generated edge relation to equality in both circle coordinates.
    induction hpq with
    | rel x y hxy =>
        rcases hxy with hxy | hxy
        · rcases hxy with ⟨hx0, hy1, h₂⟩
          change
            ((((x.1 : ℝ) : AddCircle (1 : ℝ)), ((x.2 : ℝ) : AddCircle (1 : ℝ))) =
              (((y.1 : ℝ) : AddCircle (1 : ℝ)), ((y.2 : ℝ) : AddCircle (1 : ℝ))))
          ext
          · calc
              (((x.1 : ℝ) : AddCircle (1 : ℝ))) = ((0 : ℝ) : AddCircle (1 : ℝ)) := by
                simpa [hx0]
              _ = ((1 : ℝ) : AddCircle (1 : ℝ)) := by
                symm
                simpa using (AddCircle.coe_add_period (p := (1 : ℝ)) (x := (0 : ℝ)))
              _ = ((y.1 : ℝ) : AddCircle (1 : ℝ)) := by
                simpa [hy1]
          · simpa [h₂]
        · rcases hxy with ⟨hx0, hy1, h₁⟩
          change
            ((((x.1 : ℝ) : AddCircle (1 : ℝ)), ((x.2 : ℝ) : AddCircle (1 : ℝ))) =
              (((y.1 : ℝ) : AddCircle (1 : ℝ)), ((y.2 : ℝ) : AddCircle (1 : ℝ))))
          ext
          · simpa [h₁]
          · calc
              (((x.2 : ℝ) : AddCircle (1 : ℝ))) = ((0 : ℝ) : AddCircle (1 : ℝ)) := by
                simpa [hx0]
              _ = ((1 : ℝ) : AddCircle (1 : ℝ)) := by
                symm
                simpa using (AddCircle.coe_add_period (p := (1 : ℝ)) (x := (0 : ℝ)))
              _ = ((y.2 : ℝ) : AddCircle (1 : ℝ)) := by
                simpa [hy1]
    | refl x =>
        rfl
    | symm x y hxy ih =>
        exact ih.symm
    | trans x y z hxy hyz ihxy ihyz =>
        exact ihxy.trans ihyz
  · intro hpq
    -- Equality in the torus model means each coordinate either agrees or differs by the
    -- endpoint identification, so the square setoid reaches `p'` in at most two steps.
    have hfst :
        p.1 = p'.1 ∨ (p.1 = 0 ∧ p'.1 = 1) ∨ (p.1 = 1 ∧ p'.1 = 0) := by
      exact unitInterval_addCircle_eq_iff p.1 p'.1 |>.mp (congrArg Prod.fst hpq)
    have hsnd :
        p.2 = p'.2 ∨ (p.2 = 0 ∧ p'.2 = 1) ∨ (p.2 = 1 ∧ p'.2 = 0) := by
      exact unitInterval_addCircle_eq_iff p.2 p'.2 |>.mp (congrArg Prod.snd hpq)
    let r : I × I := (p'.1, p.2)
    have hfirstStep : torusSquareSetoid p r := by
      rcases hfst with hfst | hfst | hfst
      · have hpEq : p = r := by
          ext <;> simp [r, hfst]
        simpa [hpEq] using (Relation.EqvGen.refl p : torusSquareSetoid p p)
      · simpa [r] using hfirstChange (t := p.2) (Or.inl hfst)
      · simpa [r] using hfirstChange (t := p.2) (Or.inr hfst)
    have hsecondStep : torusSquareSetoid r p' := by
      rcases hsnd with hsnd | hsnd | hsnd
      · have hrEq : r = p' := by
          ext <;> simp [r, hsnd]
        simpa [hrEq] using (Relation.EqvGen.refl p' : torusSquareSetoid p' p')
      · simpa [r] using hsecondChange (x := p'.1) (Or.inl hsnd)
      · simpa [r] using hsecondChange (x := p'.1) (Or.inr hsnd)
    exact Relation.EqvGen.trans _ r _ hfirstStep hsecondStep

/-- Helper for Example 10.1.9: the torus square quotient is homeomorphic to the product
`AddCircle (1 : ℝ) × AddCircle (1 : ℝ)`. -/
private noncomputable def torusFromSquareHomeomorphProductCircle :
    TorusFromSquare ≃ₜ AddCircle (1 : ℝ) × AddCircle (1 : ℝ) :=
  quotientHomeomorphOfRelIff torusSquareComparison torusSquareComparison_isQuotientMap
    torusSquareSetoid torusSquareComparison_rel_iff

/-- The generating edge identifications for the standard real-projective-plane quotient of the
square. -/
def realProjectivePlaneSquareEdgeRel (p q : I × I) : Prop :=
  (((p.1 : ℝ) = 0) ∧ ((q.1 : ℝ) = 1) ∧ p.2 = unitInterval.symm q.2) ∨
    (((p.2 : ℝ) = 0) ∧ ((q.2 : ℝ) = 1) ∧ p.1 = unitInterval.symm q.1)

/-- The equivalence relation on `I × I` generated by the real-projective-plane edge
identifications. -/
def realProjectivePlaneSquareSetoid : Setoid (I × I) :=
  Relation.EqvGen.setoid realProjectivePlaneSquareEdgeRel

/-- A generating edge identification in the square model becomes an equality in the quotient
presentation of the real projective plane. -/
theorem realProjectivePlaneSquareQuotient_mk_eq_mk {p q : I × I}
    (h : realProjectivePlaneSquareEdgeRel p q) :
    (Quotient.mk'' p : Quotient realProjectivePlaneSquareSetoid) = Quotient.mk'' q :=
  Quotient.sound (Relation.EqvGen.rel _ _ h)

/-- In the square-quotient presentation of the real projective plane, the left and right edges are
identified with reversed orientation. -/
theorem realProjectivePlaneSquareQuotient_left_eq_right (t : I) :
    (Quotient.mk'' ((0 : I), t) : Quotient realProjectivePlaneSquareSetoid) =
      Quotient.mk'' (1, unitInterval.symm t) :=
  realProjectivePlaneSquareQuotient_mk_eq_mk <| Or.inl ⟨rfl, rfl, by simp⟩

/-- In the square-quotient presentation of the real projective plane, the bottom and top edges are
identified with reversed orientation. -/
theorem realProjectivePlaneSquareQuotient_bottom_eq_top (t : I) :
    (Quotient.mk'' (t, (0 : I)) : Quotient realProjectivePlaneSquareSetoid) =
      Quotient.mk'' (unitInterval.symm t, 1) :=
  realProjectivePlaneSquareQuotient_mk_eq_mk <| Or.inr ⟨rfl, rfl, by simp⟩

/-- Helper for Example 10.1.9: the antipodal quotient map `S² → RP²` is surjective. -/
private theorem sphereToRealProjectiveSpace_surjective (n : ℕ) :
    Function.Surjective (sphereToRealProjectiveSpace n) := by
  -- Unpack a projective class into the representative used to define the quotient.
  intro x
  refine Quotient.inductionOn x ?_
  intro y
  exact ⟨y, rfl⟩

/-- Helper for Example 10.1.9: the antipodal quotient map `S² → RP²` carries the quotient
topology. -/
private theorem sphereToRealProjectiveSpace_isQuotientMap (n : ℕ) :
    Topology.IsQuotientMap (sphereToRealProjectiveSpace n) := by
  -- A surjective covering map is automatically a quotient map.
  exact (sphereToRealProjectiveSpace_isCoveringMap n).isQuotientMap
    (sphereToRealProjectiveSpace_surjective n)

/-- Helper for Example 10.1.9: an interior point of the projective-plane square model is fixed by
the generated quotient relation, because every generator lives on the boundary. -/
private theorem realProjectivePlaneSquareSetoid_interiorFixed
    {p q : I × I}
    (hp₁0 : (p.1 : ℝ) ≠ 0) (hp₁1 : (p.1 : ℝ) ≠ 1)
    (hp₂0 : (p.2 : ℝ) ≠ 0) (hp₂1 : (p.2 : ℝ) ≠ 1)
    (hpq : realProjectivePlaneSquareSetoid p q) :
    q = p := by
  let s : I × I := p
  let fixesInterior : (I × I) → (I × I) → Prop := fun a b ↦ a = s ↔ b = s
  have hfixes_equiv : Equivalence fixesInterior := by
    refine ⟨?_, ?_, ?_⟩
    · intro a
      rfl
    · intro a b hab
      exact hab.symm
    · intro a b c hab hbc
      exact hab.trans hbc
  have hrel :
      ∀ a b : I × I, realProjectivePlaneSquareEdgeRel a b → fixesInterior a b := by
    intro a b hab
    constructor
    · intro ha
      subst ha
      rcases hab with hxy | hxy
      · rcases hxy with ⟨hx0, _, _⟩
        exact (hp₁0 hx0).elim
      · rcases hxy with ⟨hy0, _, _⟩
        exact (hp₂0 hy0).elim
    · intro hb
      subst hb
      rcases hab with hxy | hxy
      · rcases hxy with ⟨_, hy1, _⟩
        exact (hp₁1 hy1).elim
      · rcases hxy with ⟨_, hy1, _⟩
        exact (hp₂1 hy1).elim
  have hpq' : Relation.EqvGen realProjectivePlaneSquareEdgeRel p q := hpq
  have hfixed : fixesInterior s q := by
    exact (Equivalence.eqvGen_iff hfixes_equiv).1 (Relation.EqvGen.mono hrel hpq')
  -- Since `s` is related to itself, the induced equivalence forces `q = s`.
  exact hfixed.mp rfl

/-- Helper for Example 10.1.9: the raw square-to-projective comparison vector records the two
square coordinates together with the boundary height `1 - ‖x.1‖`. -/
private def surfaceSquareProjectiveRaw (x : surfaceSquareClosedBall) :
    EuclideanSpace ℝ (Fin 3) :=
  !₂[x.1 0, x.1 1, 1 - ‖x.1‖]

/-- Helper for Example 10.1.9: the third coordinate of the raw comparison vector is nonnegative on
the closed square ball. -/
private theorem surfaceSquareProjectiveRaw_third_nonneg (x : surfaceSquareClosedBall) :
    0 ≤ surfaceSquareProjectiveRaw x 2 := by
  -- The closed-ball condition says `‖x.1‖ ≤ 1`, so the height `1 - ‖x.1‖` is nonnegative.
  have hxnorm : ‖x.1‖ ≤ 1 := mem_closedBall_zero_iff.mp x.2
  simpa [surfaceSquareProjectiveRaw] using sub_nonneg.mpr hxnorm

/-- Helper for Example 10.1.9: the raw square-to-projective comparison vector never vanishes. -/
private theorem surfaceSquareProjectiveRaw_ne_zero (x : surfaceSquareClosedBall) :
    surfaceSquareProjectiveRaw x ≠ 0 := by
  intro hzero
  -- First read off that both square coordinates vanish.
  have hx0 : x.1 0 = 0 := by
    simpa [surfaceSquareProjectiveRaw] using congrArg (fun v : EuclideanSpace ℝ (Fin 3) ↦ v 0) hzero
  have hx1 : x.1 1 = 0 := by
    simpa [surfaceSquareProjectiveRaw] using congrArg (fun v : EuclideanSpace ℝ (Fin 3) ↦ v 1) hzero
  -- Then the square point itself has norm `0`.
  have hnorm_le_zero : ‖x.1‖ ≤ 0 := by
    refine (pi_norm_le_iff_of_nonneg (show (0 : ℝ) ≤ 0 by simp)).2 ?_
    intro i
    fin_cases i
    · simpa [hx0]
    · simpa [hx1]
  have hnorm_zero : ‖x.1‖ = 0 := le_antisymm hnorm_le_zero (norm_nonneg _)
  -- The third coordinate would then be `1`, contradicting the vanishing assumption.
  have hthird : surfaceSquareProjectiveRaw x 2 = 0 := by
    simpa using congrArg (fun v : EuclideanSpace ℝ (Fin 3) ↦ v 2) hzero
  simp [surfaceSquareProjectiveRaw, hnorm_zero] at hthird

/-- Helper for Example 10.1.9: normalizing the raw comparison vector yields a sphere-valued lift of
the square-ball model. -/
private noncomputable def surfaceSquareProjectiveLift (x : surfaceSquareClosedBall) : TopCat.sphere 2 :=
  (TopCat.sphereModelHomeomorph 2).symm
    ⟨(‖surfaceSquareProjectiveRaw x‖)⁻¹ • surfaceSquareProjectiveRaw x, by
      -- Normalize the nonzero raw vector onto the Euclidean unit sphere.
      simpa [TopCat.SphereModel, Metric.mem_sphere, dist_eq_norm] using
        (norm_smul_inv_norm (𝕜 := ℝ) (x := surfaceSquareProjectiveRaw x)
          (surfaceSquareProjectiveRaw_ne_zero x))⟩

/-- Helper for Example 10.1.9: the fixed Euclidean coordinate model of `S²`. -/
private noncomputable abbrev sphereTwoModelVec (y : TopCat.sphere 2) : EuclideanSpace ℝ (Fin 3) :=
  (TopCat.sphereModelHomeomorph 2 y).1

/-- Helper for Example 10.1.9: the fixed Euclidean sphere model commutes with antipodal negation. -/
private theorem sphereTwoModelVec_neg (y : TopCat.sphere 2) :
    sphereTwoModelVec (-y) = - sphereTwoModelVec y := by
  rfl

/-- Helper for Example 10.1.9: the inverse edge parameterization sends `t ∈ I` to the unique
closed-ball coordinate `2t - 1`. -/
private theorem surfaceEdgeParamHomeomorph_symm_coord (t : I) :
    (surfaceEdgeParamHomeomorph.symm t).1 0 = 2 * (t : ℝ) - 1 := by
  -- Unfold the affine interval homeomorphism once and simplify the resulting affine formula.
  simp [surfaceEdgeParamHomeomorph, surfaceEdgeClosedBallHomeomorphIcc, iccHomeoI_symm_apply_coe]
  ring

/-- Helper for Example 10.1.9: the first coordinate of the square-face inverse parameterization is
`2x - 1`. -/
private theorem surfaceSquareFaceParam_symm_coord_zero (p : I × I) :
    (surfaceSquareFaceParam.symm p).1 0 = 2 * (p.1 : ℝ) - 1 := by
  -- The square-face inverse is just the product of the two edge inverse parameterizations.
  simp [surfaceSquareFaceParam, surfaceSquareClosedBallHomeomorphProd,
    surfaceSquareClosedBallFromEdgePair, surfaceSquareClosedBallFromEdgePairAux,
    surfaceEdgeParamHomeomorph_symm_coord]

/-- Helper for Example 10.1.9: the second coordinate of the square-face inverse parameterization
is `2y - 1`. -/
private theorem surfaceSquareFaceParam_symm_coord_one (p : I × I) :
    (surfaceSquareFaceParam.symm p).1 1 = 2 * (p.2 : ℝ) - 1 := by
  -- The second coordinate comes from the second edge inverse parameterization in the same way.
  simp [surfaceSquareFaceParam, surfaceSquareClosedBallHomeomorphProd,
    surfaceSquareClosedBallFromEdgePair, surfaceSquareClosedBallFromEdgePairAux,
    surfaceEdgeParamHomeomorph_symm_coord]

/-- Helper for Example 10.1.9: negating the closed-square point corresponds to reflecting both
interval coordinates across the midpoint. -/
private theorem surfaceSquareFaceParam_symm_reflect (p : I × I) :
    (surfaceSquareFaceParam.symm (unitInterval.symm p.1, unitInterval.symm p.2)).1 =
      -(surfaceSquareFaceParam.symm p).1 := by
  -- Compare the reflected inverse parameterization coordinatewise.
  ext i
  fin_cases i
  · simpa [Pi.neg_apply, surfaceSquareFaceParam_symm_coord_zero, unitInterval.coe_symm_eq] using
      (show 2 * (1 - (p.1 : ℝ)) - 1 = -(2 * (p.1 : ℝ) - 1) by ring)
  · simpa [Pi.neg_apply, surfaceSquareFaceParam_symm_coord_one, unitInterval.coe_symm_eq] using
      (show 2 * (1 - (p.2 : ℝ)) - 1 = -(2 * (p.2 : ℝ) - 1) by ring)

/-- Helper for Example 10.1.9: negating the closed-square point corresponds to reflecting both
interval coordinates across the midpoint. -/
private theorem surfaceSquareFaceParam_symm_neg_iff (p q : I × I) :
    (surfaceSquareFaceParam.symm q).1 = -(surfaceSquareFaceParam.symm p).1 ↔
      q.1 = unitInterval.symm p.1 ∧ q.2 = unitInterval.symm p.2 := by
  constructor
  · intro hneg
    -- Compare the negated point with the canonical reflected inverse parameterization.
    have hsub :
        surfaceSquareFaceParam.symm q =
          surfaceSquareFaceParam.symm (unitInterval.symm p.1, unitInterval.symm p.2) := by
      apply Subtype.ext
      exact hneg.trans (surfaceSquareFaceParam_symm_reflect p).symm
    have hpair : q = (unitInterval.symm p.1, unitInterval.symm p.2) :=
      surfaceSquareFaceParam.symm.injective hsub
    exact ⟨by simpa using congrArg Prod.fst hpair, by simpa using congrArg Prod.snd hpair⟩
  · rintro ⟨hq1, hq2⟩
    -- Rebuild `q` as the reflected point and apply the direct reflection formula.
    have hpair : q = (unitInterval.symm p.1, unitInterval.symm p.2) := by
      ext
      · simpa using congrArg Subtype.val hq1
      · simpa using congrArg Subtype.val hq2
    simpa [hpair] using surfaceSquareFaceParam_symm_reflect p

/-- Helper for Example 10.1.9: any square point lying on one of the four sides maps to a
closed-square point of norm exactly `1`. -/
private theorem surfaceSquareFaceParam_symm_norm_eq_one_of_boundary {p : I × I}
    (hp : p.1 = 0 ∨ p.1 = 1 ∨ p.2 = 0 ∨ p.2 = 1) :
    ‖(surfaceSquareFaceParam.symm p).1‖ = 1 := by
  have hle : ‖(surfaceSquareFaceParam.symm p).1‖ ≤ 1 := by
    exact mem_closedBall_zero_iff.mp (surfaceSquareFaceParam.symm p).2
  have hge : 1 ≤ ‖(surfaceSquareFaceParam.symm p).1‖ := by
    rcases hp with hp0 | hp1 | hp2 | hp3
    · have hcoord : ‖(surfaceSquareFaceParam.symm p).1 0‖ = 1 := by
        rw [surfaceSquareFaceParam_symm_coord_zero, hp0]
        norm_num
      calc
        1 = ‖(surfaceSquareFaceParam.symm p).1 0‖ := hcoord.symm
        _ ≤ ‖(surfaceSquareFaceParam.symm p).1‖ := norm_le_pi_norm _ 0
    · have hcoord : ‖(surfaceSquareFaceParam.symm p).1 0‖ = 1 := by
        rw [surfaceSquareFaceParam_symm_coord_zero, hp1]
        norm_num
      calc
        1 = ‖(surfaceSquareFaceParam.symm p).1 0‖ := hcoord.symm
        _ ≤ ‖(surfaceSquareFaceParam.symm p).1‖ := norm_le_pi_norm _ 0
    · have hcoord : ‖(surfaceSquareFaceParam.symm p).1 1‖ = 1 := by
        rw [surfaceSquareFaceParam_symm_coord_one, hp2]
        norm_num
      calc
        1 = ‖(surfaceSquareFaceParam.symm p).1 1‖ := hcoord.symm
        _ ≤ ‖(surfaceSquareFaceParam.symm p).1‖ := norm_le_pi_norm _ 1
    · have hcoord : ‖(surfaceSquareFaceParam.symm p).1 1‖ = 1 := by
        rw [surfaceSquareFaceParam_symm_coord_one, hp3]
        norm_num
      calc
        1 = ‖(surfaceSquareFaceParam.symm p).1 1‖ := hcoord.symm
        _ ≤ ‖(surfaceSquareFaceParam.symm p).1‖ := norm_le_pi_norm _ 1
  exact le_antisymm hle hge

/-- Helper for Example 10.1.9: a closed-square point of norm `1` comes from one of the four sides
of the square. -/
private theorem surfaceSquareFaceParam_boundary_cases {p : I × I}
    (hp : ‖(surfaceSquareFaceParam.symm p).1‖ = 1) :
    p.1 = 0 ∨ p.1 = 1 ∨ p.2 = 0 ∨ p.2 = 1 := by
  by_contra hboundary
  push_neg at hboundary
  have hp10 : 0 < (p.1 : ℝ) := by
    exact lt_of_le_of_ne p.1.2.1 fun h0 ↦ hboundary.1 (Subtype.ext h0.symm)
  have hp11 : (p.1 : ℝ) < 1 := by
    exact lt_of_le_of_ne p.1.2.2 fun h1 ↦ hboundary.2.1 (Subtype.ext h1)
  have hp20 : 0 < (p.2 : ℝ) := by
    exact lt_of_le_of_ne p.2.2.1 fun h0 ↦ hboundary.2.2.1 (Subtype.ext h0.symm)
  have hp21 : (p.2 : ℝ) < 1 := by
    exact lt_of_le_of_ne p.2.2.2 fun h1 ↦ hboundary.2.2.2 (Subtype.ext h1)
  have hcoord0 : ‖(surfaceSquareFaceParam.symm p).1 0‖ < 1 := by
    rw [surfaceSquareFaceParam_symm_coord_zero, Real.norm_eq_abs]
    refine abs_lt.mpr ?_
    constructor <;> linarith
  have hcoord1 : ‖(surfaceSquareFaceParam.symm p).1 1‖ < 1 := by
    rw [surfaceSquareFaceParam_symm_coord_one, Real.norm_eq_abs]
    refine abs_lt.mpr ?_
    constructor <;> linarith
  have hnorm_lt : ‖(surfaceSquareFaceParam.symm p).1‖ < 1 := by
    refine (pi_norm_lt_iff zero_lt_one).2 ?_
    intro i
    fin_cases i
    · simpa using hcoord0
    · simpa using hcoord1
  linarith

