module

public import Mathlib.Logic.Relation
public import Mathlib.Topology.Constructions.SumProd
public import Mathlib.Topology.UnitInterval

public section

open scoped unitInterval

universe u v

variable {X₀ : Type u} {J : Type v}

/-- The generating endpoint-identification relation on `X₀ ⊕ (J × I)` for the realization of a
graph whose edges are indexed by an arbitrary family `boundary : J → Fin 2 → X₀` of attaching
maps. Unlike `graphRealizationRel`, this allows distinct edges to have the same ordered pair of
endpoints. -/
def graphRealizationOfFamilyRel (boundary : J → Fin 2 → X₀) :
    (X₀ ⊕ (J × I)) → (X₀ ⊕ (J × I)) → Prop
  | Sum.inr (j, t), Sum.inl x => (t = 0 ∧ x = boundary j 0) ∨ (t = 1 ∧ x = boundary j 1)
  | Sum.inl x, Sum.inr (j, t) => (x = boundary j 0 ∧ t = 0) ∨ (x = boundary j 1 ∧ t = 1)
  | _, _ => False

/-- The setoid generated by the endpoint identifications from an arbitrary edge family
`boundary : J → Fin 2 → X₀`. -/
def graphRealizationOfFamilySetoid (boundary : J → Fin 2 → X₀) : Setoid (X₀ ⊕ (J × I)) :=
  Relation.EqvGen.setoid (graphRealizationOfFamilyRel boundary)

/-- The realization of a graph presented by a discrete vertex set `X₀` and an arbitrary family of
edge-attaching maps `boundary : J → Fin 2 → X₀`. This allows parallel edges and repeated loops. -/
abbrev graphRealizationOfFamily (boundary : J → Fin 2 → X₀) :=
  Quotient (graphRealizationOfFamilySetoid boundary)

/-- The source `X₀ ⊕ (J × I)` of `graphRealizationOfFamily boundary` carries the discrete
topologies on `X₀` and `J` together with the usual topology on `I`. -/
abbrev graphRealizationOfFamilySourceTopologicalSpace : TopologicalSpace (X₀ ⊕ (J × I)) :=
  let _ : TopologicalSpace X₀ := ⊥
  let _ : TopologicalSpace J := ⊥
  inferInstance

/-- The carrier `graphRealizationOfFamily boundary` inherits the quotient topology induced from the
discrete topologies on `X₀` and `J` and the usual topology on `I`. -/
instance graphRealizationOfFamilyTopologicalSpace (boundary : J → Fin 2 → X₀) :
    TopologicalSpace (graphRealizationOfFamily boundary) :=
  let _ : TopologicalSpace (X₀ ⊕ (J × I)) := graphRealizationOfFamilySourceTopologicalSpace
  inferInstance

/-- The image of a vertex in `graphRealizationOfFamily boundary`. -/
def graphRealizationOfFamilyVertex (boundary : J → Fin 2 → X₀) (x : X₀) :
    graphRealizationOfFamily boundary :=
  Quotient.mk (graphRealizationOfFamilySetoid boundary) (Sum.inl x)

/-- The image of a point on the edge indexed by `j` in `graphRealizationOfFamily boundary`. -/
def graphRealizationOfFamilyEdgePoint (boundary : J → Fin 2 → X₀) (j : J) (t : I) :
    graphRealizationOfFamily boundary :=
  Quotient.mk (graphRealizationOfFamilySetoid boundary) (Sum.inr (j, t))

/-- The endpoint `0` of the edge `j` is identified with its initial vertex in
`graphRealizationOfFamily boundary`. -/
theorem graphRealizationOfFamily_vertex_boundary_zero_eq_edgePoint_zero
    (boundary : J → Fin 2 → X₀) (j : J) :
    graphRealizationOfFamilyVertex boundary (boundary j 0) =
      graphRealizationOfFamilyEdgePoint boundary j 0 := by
  exact Quotient.sound <| Relation.EqvGen.rel _ _ (Or.inl ⟨rfl, rfl⟩)

/-- The endpoint `1` of the edge `j` is identified with its terminal vertex in
`graphRealizationOfFamily boundary`. -/
theorem graphRealizationOfFamily_vertex_boundary_one_eq_edgePoint_one
    (boundary : J → Fin 2 → X₀) (j : J) :
    graphRealizationOfFamilyVertex boundary (boundary j 1) =
      graphRealizationOfFamilyEdgePoint boundary j 1 := by
  exact Quotient.sound <| Relation.EqvGen.rel _ _ (Or.inr ⟨rfl, rfl⟩)
