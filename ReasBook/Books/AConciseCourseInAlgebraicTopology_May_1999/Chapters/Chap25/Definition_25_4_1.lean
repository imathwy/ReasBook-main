module

public import Mathlib.Algebra.FreeAlgebra
public import Mathlib.Algebra.RingQuot
public import Mathlib.RingTheory.ZMod

public section

noncomputable section

-- Semantic recall via `lean_leansearch` surfaced no verified pre-existing `SteenrodAlgebra`
-- owner in the current environment. This file therefore records Definition 25.4.1 by the
-- concrete quotient of the free associative `ZMod 2`-algebra on generators `Sq^i` by the
-- standard mod-`2` Adem relations together with `Sq^0 = 1`, rather than by the ambient
-- operation-family owner from Theorem 22.5.5.

/-- The indices of the standard mod-`2` Adem relations `Sq^i Sq^j = ∑_k (...) Sq^{i + j - k} Sq^k`,
which occur exactly for pairs `(i, j)` with `i < 2 * j`. -/
abbrev SteenrodAdemRelationIndex :=
  {ij : ℕ × ℕ // ij.1 < 2 * ij.2}

/-- The relation element corresponding to one admissible pair `(i, j)` in the standard mod-`2`
Adem presentation, viewed inside the free associative `ZMod 2`-algebra on generators indexed
by `ℕ`. The defining quotient relation sets this element equal to `0`. -/
def steenrodAdemRelation (r : SteenrodAdemRelationIndex) : FreeAlgebra (ZMod 2) ℕ :=
  let i := r.1.1
  let j := r.1.2
  FreeAlgebra.ι (ZMod 2) i * FreeAlgebra.ι (ZMod 2) j -
    Finset.sum (Finset.range (i / 2 + 1)) fun k ↦
      if Nat.choose (j - k - 1) (i - 2 * k) % 2 = 1 then
        FreeAlgebra.ι (ZMod 2) (i + j - k) * FreeAlgebra.ι (ZMod 2) k
      else 0

/-- The indices of the defining presentation relations for the mod-`2` Steenrod algebra:
the admissible Adem relations together with the normalization relation `Sq^0 = 1`. -/
abbrev SteenrodPresentationRelationIndex :=
  SteenrodAdemRelationIndex ⊕ Unit

/-- A defining relation for the standard presentation of the mod-`2` Steenrod algebra inside the
free associative `ZMod 2`-algebra on generators indexed by `ℕ`. The `Sum.inr ()` case records
the normalization relation `Sq^0 - 1 = 0`. -/
def steenrodPresentationRelation (r : SteenrodPresentationRelationIndex) :
    FreeAlgebra (ZMod 2) ℕ :=
  match r with
  | Sum.inl adem => steenrodAdemRelation adem
  | Sum.inr _ => FreeAlgebra.ι (ZMod 2) 0 - 1

/-- The generating relation for the standard mod-`2` Steenrod presentation: each defining relation
element is identified with `0` in the quotient. -/
def steenrodPresentationPair : FreeAlgebra (ZMod 2) ℕ → FreeAlgebra (ZMod 2) ℕ → Prop :=
  fun x y ↦ x - y ∈ Set.range steenrodPresentationRelation

/-- Definition 25.4.1. The mod-`2` Steenrod algebra `A` is the quotient of the free associative
`ZMod 2`-algebra on generators `Sq^i` by the congruence generated from the standard Adem
relations together with the normalization relation `Sq^0 = 1`, equivalently by the two-sided
ideal they generate. This gives a source-facing owner for the algebra presented by generators
`Sq^i` subject to those relations, without introducing the extra ambient cohomology-theory
parameters of `SteenrodSquareFamily`. -/
abbrev ModTwoSteenrodAlgebra : Type :=
  RingQuot steenrodPresentationPair

/-- The two-sided ideal generated by the defining presentation relations for
`ModTwoSteenrodAlgebra`. This records the ideal-level companion to the source-facing
`RingQuot` owner. -/
abbrev modTwoSteenrodAlgebraIdeal : Ideal (FreeAlgebra (ZMod 2) ℕ) :=
  Ideal.ofRel steenrodPresentationPair

/-- Each defining presentation relation lies in the ideal generated by the presentation
relations. This records the ideal-level companion to the source-facing quotient owner
`ModTwoSteenrodAlgebra`. -/
theorem steenrodPresentationRelation_mem_modTwoSteenrodAlgebraIdeal
    (r : SteenrodPresentationRelationIndex) :
    steenrodPresentationRelation r ∈ modTwoSteenrodAlgebraIdeal := by
  apply Ideal.subset_span
  refine ⟨steenrodPresentationRelation r, 0, ?_, by simp⟩
  dsimp [steenrodPresentationPair]
  simpa only [sub_zero] using
    (Set.mem_range_self r :
      steenrodPresentationRelation r ∈ Set.range steenrodPresentationRelation)

/-- The canonical generator `Sq^i` of `ModTwoSteenrodAlgebra`, given by the image of the free
generator `FreeAlgebra.ι (ZMod 2) i` in the defining quotient. Use the scoped notation `Sq^i`
from `open scoped SteenrodAlgebra` for the standard textbook surface. -/
abbrev modTwoSteenrodAlgebraSq (i : ℕ) : ModTwoSteenrodAlgebra :=
  RingQuot.mkRingHom steenrodPresentationPair (FreeAlgebra.ι (ZMod 2) i)

/-- Lean notation for the standard Steenrod generator `Sq^i ∈ ModTwoSteenrodAlgebra`. -/
scoped[SteenrodAlgebra] notation "Sq^" i:max => modTwoSteenrodAlgebraSq i

open scoped SteenrodAlgebra

/-- Each defining presentation relation vanishes in the quotient `ModTwoSteenrodAlgebra`. -/
theorem modTwoSteenrodAlgebra_relation_eq_zero (r : SteenrodPresentationRelationIndex) :
    RingQuot.mkRingHom steenrodPresentationPair (steenrodPresentationRelation r) = 0 := by
  have hr : steenrodPresentationPair (steenrodPresentationRelation r) 0 := by
    dsimp [steenrodPresentationPair]
    simpa only [sub_zero] using
      (Set.mem_range_self r :
        steenrodPresentationRelation r ∈ Set.range steenrodPresentationRelation)
  simpa using
    RingQuot.mkRingHom_rel hr

/-- In `ModTwoSteenrodAlgebra`, the generator `Sq^0` is identified with the multiplicative unit. -/
theorem modTwoSteenrodAlgebraSq_zero :
    Sq^0 = 1 := by
  have hq : Sq^0 - 1 = 0 := by
    simpa [modTwoSteenrodAlgebraSq, steenrodPresentationRelation] using
      modTwoSteenrodAlgebra_relation_eq_zero (Sum.inr ())
  exact sub_eq_zero.mp hq

/-- In `ModTwoSteenrodAlgebra`, the generators `Sq^i` satisfy the standard mod-`2` Adem
relation whenever `i < 2 * j`. -/
theorem modTwoSteenrodAlgebra_adem (i j : ℕ) (h : i < 2 * j) :
    Sq^i * Sq^j =
      Finset.sum (Finset.range (i / 2 + 1)) fun k ↦
        if Nat.choose (j - k - 1) (i - 2 * k) % 2 = 1 then
          Sq^(i + j - k) * Sq^k
        else 0 := by
  have hq :
      (Sq^i * Sq^j -
        Finset.sum (Finset.range (i / 2 + 1)) fun k ↦
          RingQuot.mkRingHom steenrodPresentationPair
            (if Nat.choose (j - k - 1) (i - 2 * k) % 2 = 1 then
              FreeAlgebra.ι (ZMod 2) (i + j - k) * FreeAlgebra.ι (ZMod 2) k
            else 0)) = 0 := by
    simpa [steenrodPresentationRelation, steenrodAdemRelation, modTwoSteenrodAlgebraSq] using
      modTwoSteenrodAlgebra_relation_eq_zero (Sum.inl ⟨(i, j), h⟩)
  have hs :
      Finset.sum (Finset.range (i / 2 + 1)) (fun k ↦
        RingQuot.mkRingHom steenrodPresentationPair
          (if Nat.choose (j - k - 1) (i - 2 * k) % 2 = 1 then
            FreeAlgebra.ι (ZMod 2) (i + j - k) * FreeAlgebra.ι (ZMod 2) k
          else 0)) =
        Finset.sum (Finset.range (i / 2 + 1)) fun k ↦
          if Nat.choose (j - k - 1) (i - 2 * k) % 2 = 1 then
            Sq^(i + j - k) * Sq^k
          else 0 := by
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    split_ifs <;> simp [modTwoSteenrodAlgebraSq]
  have hq' :
      (Sq^i * Sq^j -
        Finset.sum (Finset.range (i / 2 + 1)) fun k ↦
          if Nat.choose (j - k - 1) (i - 2 * k) % 2 = 1 then
            Sq^(i + j - k) * Sq^k
          else 0) = 0 := by
    simpa [hs] using hq
  exact sub_eq_zero.mp hq'
