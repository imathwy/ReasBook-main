import Mathlib.LinearAlgebra.Quotient.Basic
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap13.Definition_13_2_11

noncomputable section

universe u

open CategoryTheory
open Topology
open scoped CellularChainGroup

-- Semantic recall via `lean_leansearch`: no canonical reduced-cellular-chain owner surfaced in
-- the current environment. The verified local analogue is
-- `cellularChainComplex`/`cellularHomology`, so the reduced theory is packaged by quotienting the
-- degree-`0` cellular chains by the base `0`-cell summand and then taking homology.

variable (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]

/-- The degree-`0` cellular chains generated by the chosen base `0`-cell `x₀`. -/
def reducedCellularDegreeZeroSubmodule
    (x0 : cellularCell X 0)
    : Submodule ℤ (C[0](X)) :=
  Submodule.span ℤ ({FreeAbelianGroup.of x0} : Set (C[0](X)))

/-- `reducedCellularDegreeZeroSubmodule X x₀` is the span of the degree-`0` generator attached to
the chosen base cell `x₀`. -/
theorem reducedCellularDegreeZeroSubmodule_eq_span
    (x0 : cellularCell X 0) :
    reducedCellularDegreeZeroSubmodule X x0 =
      Submodule.span ℤ ({FreeAbelianGroup.of x0} : Set (C[0](X))) :=
  rfl

/-- The degreewise reduced cellular chain groups: degree `0` is quotiented by the basepoint
summand, and positive degrees agree with the unreduced cellular chain groups. -/
def reducedCellularChainGroup
    (x0 : cellularCell X 0)
    : ℕ → ModuleCat ℤ
  | 0 => ModuleCat.of ℤ (C[0](X) ⧸ reducedCellularDegreeZeroSubmodule X x0)
  | n + 1 => ModuleCat.of ℤ (C[n + 1](X))

/-- Lean notation for the reduced cellular chain groups `C̃_n(X)` based at the chosen `0`-cell
`x₀`. -/
scoped[CellularChainGroup] notation "C̃[" n "](" X ", " x0 ")" =>
  reducedCellularChainGroup X x0 n

/-- In degree `0`, `reducedCellularChainGroup X x₀` is the quotient of `C₀(X)` by the subgroup
generated by the base `0`-cell. -/
@[simp] theorem reducedCellularChainGroup_zero
    (x0 : cellularCell X 0) :
    C̃[0](X, x0) = ModuleCat.of ℤ (C[0](X) ⧸ reducedCellularDegreeZeroSubmodule X x0) :=
  rfl

/-- In positive degrees, `reducedCellularChainGroup X x₀` agrees with the ordinary cellular chain
group of `X`. -/
@[simp] theorem reducedCellularChainGroup_succ
    (x0 : cellularCell X 0) (n : ℕ) :
    C̃[n + 1](X, x0) = ModuleCat.of ℤ (C[n + 1](X)) :=
  rfl

/-- The reduced cellular differentials induced from a chosen family of ordinary cellular
differentials by quotienting degree `0` by the basepoint summand. -/
def reducedCellularDifferential
    (data : CellularDifferentialFamily X) (x0 : cellularCell X 0) (n : ℕ) :
    C̃[n + 1](X, x0) ⟶ C̃[n](X, x0) :=
  match n with
  | 0 =>
      ModuleCat.ofHom
        ((reducedCellularDegreeZeroSubmodule X x0).mkQ.comp
          (data.differential 0).toIntLinearMap)
  | n + 1 => ModuleCat.ofHom (data.differential (n + 1)).toIntLinearMap

/-- In degree `0`, the reduced cellular differential is the ordinary degree-`0` cellular
differential followed by the quotient map. -/
@[simp] theorem reducedCellularDifferential_zero
    (data : CellularDifferentialFamily X) (x0 : cellularCell X 0) :
    reducedCellularDifferential X data x0 0 =
      ModuleCat.ofHom
        ((reducedCellularDegreeZeroSubmodule X x0).mkQ.comp
          (data.differential 0).toIntLinearMap) :=
  rfl

/-- In positive target degrees, `reducedCellularDifferential` agrees with the ordinary cellular
differential. -/
@[simp] theorem reducedCellularDifferential_succ
    (data : CellularDifferentialFamily X) (x0 : cellularCell X 0) (n : ℕ) :
    reducedCellularDifferential X data x0 (n + 1) =
      ModuleCat.ofHom (data.differential (n + 1)).toIntLinearMap :=
  rfl

/-- Consecutive reduced cellular differentials compose to zero. -/
theorem reducedCellularChainComplex_sq
    (data : CellularDifferentialFamily X) (x0 : cellularCell X 0)
    (n : ℕ) :
    reducedCellularDifferential X data x0 (n + 1) ≫
      reducedCellularDifferential X data x0 n = 0 := by
  cases n with
  | zero =>
      rw [reducedCellularDifferential_succ, reducedCellularDifferential_zero]
      have hcomp :
          ModuleCat.ofHom (data.differential (0 + 1)).toIntLinearMap ≫
              ModuleCat.ofHom
                ((reducedCellularDegreeZeroSubmodule X x0).mkQ.comp
                  (data.differential 0).toIntLinearMap) =
            ModuleCat.ofHom
              (((reducedCellularDegreeZeroSubmodule X x0).mkQ.comp
                  (data.differential 0).toIntLinearMap).comp
                (data.differential 1).toIntLinearMap) := by
        simp [ModuleCat.ofHom_comp]
      refine hcomp.trans ?_
      change
        ModuleCat.ofHom
            (((reducedCellularDegreeZeroSubmodule X x0).mkQ.comp
                (data.differential 0).toIntLinearMap).comp
              (data.differential 1).toIntLinearMap) =
          ModuleCat.ofHom 0
      exact congrArg ModuleCat.ofHom <| by
        ext x
        rw [LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.zero_apply,
          Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        have hx :
            data.lowDegree.differential
                ((cellularDifferentialFromDegrees X 1 (data.positiveDegree 1).attachingDegree) x) =
              0 := by
          simpa using congrArg (fun f ↦ f x) (cellularDifferential_squareZero X data 0)
        simp [hx]
  | succ n =>
      ext x
      simpa [reducedCellularDifferential] using
        congrArg (fun f ↦ f x) (cellularDifferential_squareZero X data (n + 1))

/-- Definition 13.3.1 (1). For a based CW complex `X`, represented here by a chosen base `0`-cell
`x₀`, the reduced cellular chains `C̃_*(X)` are the quotient of `C_*(X)` by the image of
`C_*(*) → C_*(X)`. Concretely, this quotients degree `0` by the subgroup generated by `x₀` and
leaves the positive-degree cellular chain groups unchanged. -/
abbrev reducedCellularChainComplex
    (data : CellularDifferentialFamily X) (x0 : cellularCell X 0)
    : ChainComplex (ModuleCat ℤ) ℕ :=
  ChainComplex.of
    (reducedCellularChainGroup X x0)
    (reducedCellularDifferential X data x0)
    (reducedCellularChainComplex_sq X data x0)

/-- The differential of `reducedCellularChainComplex X data x₀` in degree `n` is the reduced
cellular differential in degree `n`. -/
@[simp] theorem reducedCellularChainComplex_d
    (data : CellularDifferentialFamily X) (x0 : cellularCell X 0)
    (n : ℕ) :
    (reducedCellularChainComplex X data x0).d (n + 1) n =
      reducedCellularDifferential X data x0 n := by
  exact
    ChainComplex.of_d
      (reducedCellularChainGroup X x0)
      (reducedCellularDifferential X data x0)
      (reducedCellularChainComplex_sq X data x0)
      n

/-- Definition 13.3.1 (2). Reduced homology `H̃_*(X)` is the homology of the reduced cellular
chain complex `C̃_*(X)`. -/
abbrev reducedCellularHomology
    (data : CellularDifferentialFamily X) (x0 : cellularCell X 0)
    (n : ℕ) : ModuleCat ℤ :=
  (reducedCellularChainComplex X data x0).homology n

/-- Lean notation for the reduced cellular homology groups `H̃_n(X)` attached to the chosen
cellular differential family and base `0`-cell. -/
scoped[CellularHomology] notation "H̃[" n "](" X ", " data ", " x0 ")" =>
  reducedCellularHomology X data x0 n

open scoped CellularHomology

/-- Evaluating `reducedCellularHomology X data x₀` in degree `n` gives the degree-`n` homology of
the reduced cellular chain complex `C̃_*(X)`. -/
@[simp] theorem reducedCellularHomology_apply
    (data : CellularDifferentialFamily X) (x0 : cellularCell X 0)
    (n : ℕ) :
    H̃[n](X, data, x0) =
      (reducedCellularChainComplex X data x0).homology n :=
  rfl
