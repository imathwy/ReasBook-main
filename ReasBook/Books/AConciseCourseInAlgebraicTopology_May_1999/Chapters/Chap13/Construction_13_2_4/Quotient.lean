import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.Definition_8_2_2

universe u

noncomputable section

/-- Helper for Construction 13.2.4: the `k`-ification of any topology is compactly generated. -/
private theorem uCompactlyGeneratedSpace_compactlyGenerated
    (X : Type u) [TopologicalSpace X] :
    @UCompactlyGeneratedSpace.{u} X (TopologicalSpace.compactlyGenerated.{u} X) := by
  let f : (Σ (i : (S : CompHaus.{u}) × C(S, X)), i.fst) → X := fun x ↦ x.1.2 x.2
  -- The coinduced presentation of `TopologicalSpace.compactlyGenerated` supplies the instance.
  have hf :
      @Continuous ((Σ (i : (S : CompHaus.{u}) × C(S, X)), i.fst)) X
        instTopologicalSpaceSigma (TopologicalSpace.coinduced f inferInstance) f := by
    rw [continuous_iff_coinduced_le]
  exact @uCompactlyGeneratedSpace_of_coinduced.{u, _, _}
    ((Σ (i : (S : CompHaus.{u}) × C(S, X)), i.fst)) X instTopologicalSpaceSigma
    (TopologicalSpace.coinduced f inferInstance) inferInstance f hf rfl

/-- The relation collapsing `A ⊆ X` to a single point in the quotient model `X / A`. -/
def collapseSubsetRel {X : Type u} [TopologicalSpace X] (A : Set X) : X → X → Prop :=
  fun x y ↦ x = y ∨ (x ∈ A ∧ y ∈ A)

/-- The setoid presenting the quotient space `X / A`. -/
def collapseSubsetSetoid {X : Type u} [TopologicalSpace X] (A : Set X) : Setoid X :=
  Relation.EqvGen.setoid (collapseSubsetRel A)

/-- The quotient-model carrier `X / A` obtained by collapsing `A` to a point. -/
abbrev collapseSubsetType (X : Type u) [TopologicalSpace X] (A : Set X) :=
  Quotient (collapseSubsetSetoid A)

/-- The subset `Xⁿ⁻² ⊆ Xⁿ⁻¹` viewed inside the subtype carrier `Xⁿ⁻¹`. -/
def previousSkeletonLowerSubset {X : Type u} [TopologicalSpace X]
    (Xnm2 Xnm1 : Set X) : Set Xnm1 :=
  { x | x.1 ∈ Xnm2 }

/-- The quotient `Xⁿ⁻¹ / Xⁿ⁻²` carries the compactly generated replacement of its quotient
topology. -/
instance previousSkeletonQuotientTypeTopologicalSpace {X : Type u} [TopologicalSpace X]
    (Xnm2 Xnm1 : Set X) :
    TopologicalSpace (collapseSubsetType Xnm1 (previousSkeletonLowerSubset Xnm2 Xnm1)) :=
  TopologicalSpace.compactlyGenerated.{u, u}
    (collapseSubsetType Xnm1 (previousSkeletonLowerSubset Xnm2 Xnm1))

/-- The quotient `Xⁿ⁻¹ / Xⁿ⁻²` is compactly generated by construction. -/
instance previousSkeletonQuotientType_uCompactlyGeneratedSpace {X : Type u} [TopologicalSpace X]
    (Xnm2 Xnm1 : Set X) :
    UCompactlyGeneratedSpace.{u}
      (collapseSubsetType Xnm1 (previousSkeletonLowerSubset Xnm2 Xnm1)) := by
  -- The chosen topology is already the `k`-ification of the quotient topology.
  let _ : TopologicalSpace (collapseSubsetType Xnm1 (previousSkeletonLowerSubset Xnm2 Xnm1)) :=
    instTopologicalSpaceQuotient
  simpa [previousSkeletonQuotientTypeTopologicalSpace] using
    uCompactlyGeneratedSpace_compactlyGenerated
      (collapseSubsetType Xnm1 (previousSkeletonLowerSubset Xnm2 Xnm1))

/-- The distinguished collapsed point of `Xⁿ⁻¹ / Xⁿ⁻²` coming from a chosen point of `Xⁿ⁻²`. -/
abbrev previousSkeletonQuotientPoint {X : Type u} [TopologicalSpace X]
    {Xnm2 Xnm1 : Set X} (h : Xnm2 ⊆ Xnm1) (x0 : Xnm2) :
    collapseSubsetType Xnm1 (previousSkeletonLowerSubset Xnm2 Xnm1) :=
  Quotient.mk'' ⟨x0.1, h x0.2⟩

/-- The based compactly generated quotient `Xⁿ⁻¹ / Xⁿ⁻²`. -/
def previousSkeletonQuotientPointed {X : Type u} [TopologicalSpace X]
    {Xnm2 Xnm1 : Set X} (h : Xnm2 ⊆ Xnm1) (x0 : Xnm2) : PointedCompactlyGenerated :=
  PointedCompactlyGenerated.of
    (CompactlyGenerated.of
      (collapseSubsetType Xnm1 (previousSkeletonLowerSubset Xnm2 Xnm1)))
    (previousSkeletonQuotientPoint h x0)

/-- Any two chosen points of `Xⁿ⁻²` define the same collapsed point of `Xⁿ⁻¹ / Xⁿ⁻²`. -/
theorem previousSkeletonQuotientPoint_eq {X : Type u} [TopologicalSpace X]
    {Xnm2 Xnm1 : Set X} (h : Xnm2 ⊆ Xnm1) (x0 y0 : Xnm2) :
    previousSkeletonQuotientPoint h x0 = previousSkeletonQuotientPoint h y0 := by
  -- Both representatives lie in the collapsed lower skeleton, so they define the same quotient
  -- point.
  apply Quotient.sound
  apply Relation.EqvGen.rel
  right
  constructor <;> simp [previousSkeletonLowerSubset]
