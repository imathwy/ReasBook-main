import Mathlib.Topology.CWComplex.Classical.Subcomplex
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap13.Construction_13_2_4.Quotient
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap13.Definition_13_3_1
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap13.Lemma_13_2_10

noncomputable section

universe u

open CategoryTheory
open Topology
open Topology.CWComplex.Subcomplex
open scoped CellularChainGroup CellularHomology

-- Semantic recall via `lean_leansearch` did not surface a canonical relative-cellular-chain owner
-- in the current environment. Local Chapter 13 precedent already fixes `cellularChainComplex` and
-- `reducedCellularChainComplex`, while mathlib's canonical subcomplex owner is
-- `Topology.CWComplex.Subcomplex`. The relative theory is therefore packaged here as the quotient
-- of the ambient cellular chains by the submodule generated by the cells of the chosen
-- subcomplex.

namespace Topology.CWComplex.Subcomplex

/-- The underlying set of a subcomplex is nonempty. -/
abbrev Nonempty
    {X : Type u} [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) : Prop :=
  Set.Nonempty (A : Set X)

end Topology.CWComplex.Subcomplex

/-- The degree-`n` inclusion of the cellular chains of a subcomplex `A` into the cellular chains
of the ambient CW complex `X`, induced by the inclusion of `n`-cells `A.I n ↪ cellularCell X n`.
-/
def subcomplexCellularChainInclusion
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) (n : ℕ) :
    ModuleCat.of ℤ (FreeAbelianGroup (A.I n)) ⟶ ModuleCat.of ℤ (cellularChainGroup X n) :=
  ModuleCat.ofHom
    ((FreeAbelianGroup.map fun i : A.I n ↦ (i : cellularCell X n)).toIntLinearMap)

/-- On the generator corresponding to an `n`-cell of the subcomplex `A`, the inclusion
`subcomplexCellularChainInclusion X A n` returns the corresponding ambient cellular generator. -/
@[simp] theorem subcomplexCellularChainInclusion_apply_of
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) (n : ℕ) (i : A.I n) :
    subcomplexCellularChainInclusion X A n (FreeAbelianGroup.of i) =
      FreeAbelianGroup.of (i : cellularCell X n) := by
  simp [subcomplexCellularChainInclusion]

/-- The submodule of `C_n(X)` generated by the `n`-cells belonging to the subcomplex `A`. This is
the image of the degree-`n` cellular-chain inclusion `C_n(A) → C_n(X)`. -/
def subcomplexCellularChainSubmodule
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) (n : ℕ) :
    Submodule ℤ (cellularChainGroup X n) :=
  (subcomplexCellularChainInclusion X A n).hom.range

/-- Unfolding `subcomplexCellularChainSubmodule X A n` gives the range of the canonical
degree-`n` inclusion from the cellular chains of `A` into those of `X`. -/
@[simp] theorem subcomplexCellularChainSubmodule_def
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) (n : ℕ) :
    subcomplexCellularChainSubmodule X A n =
      (subcomplexCellularChainInclusion X A n).hom.range :=
  rfl

/-- The degree-`n` relative cellular chain group `C_n(X, A)`, realized as the quotient of the
ambient cellular chain group `C_n(X)` by the image of the degree-`n` cellular chains of the
subcomplex `A`. -/
def relativeCellularChainGroup
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) (n : ℕ) :
    ModuleCat ℤ :=
  ModuleCat.of ℤ ((cellularChainGroup X n) ⧸ subcomplexCellularChainSubmodule X A n)

/-- Lean notation for the relative cellular chain groups `C_n(X, A)`. -/
scoped[CellularChainGroup] notation "C[" n "](" X ", " A ")" =>
  relativeCellularChainGroup X A n

/-- Unfolding `relativeCellularChainGroup X A n` gives the quotient `C_n(X) / C_n(A)` modeled by
the image of the degree-`n` cellular-chain inclusion of `A` into `X`. -/
@[simp] theorem relativeCellularChainGroup_def
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) (n : ℕ) :
    C[n](X, A) =
      ModuleCat.of ℤ ((cellularChainGroup X n) ⧸ subcomplexCellularChainSubmodule X A n) :=
  rfl

/-- A chosen cellular differential on `X` preserves the submodule generated by the cells of the
subcomplex `A` in every degree, so it descends to the relative quotient groups `C_(n + 1)(X, A) →
C_n(X, A)`. -/
class RelativeCellularDifferentialDescends
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X) : Prop where
  descends :
    ∀ n : ℕ,
      subcomplexCellularChainSubmodule X A (n + 1) ≤
        (subcomplexCellularChainSubmodule X A n).comap ((data.differential n).toIntLinearMap)

/-- The chosen cellular differential on `X` preserves the submodule generated by the cells of the
subcomplex `A` in degree `n + 1`. -/
theorem subcomplexCellularChainSubmodule_le_comap
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [h : RelativeCellularDifferentialDescends X A data] (n : ℕ) :
    subcomplexCellularChainSubmodule X A (n + 1) ≤
      (subcomplexCellularChainSubmodule X A n).comap ((data.differential n).toIntLinearMap) :=
  h.descends n

/-- The relative cellular differential induced from the chosen cellular differential on `X` after
passing to the quotient by the subcomplex-generated cellular submodules. -/
def relativeCellularDifferential
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [hdesc : RelativeCellularDifferentialDescends X A data]
    (n : ℕ) :
    C[n + 1](X, A) ⟶ C[n](X, A) :=
  ModuleCat.ofHom
    ((subcomplexCellularChainSubmodule X A (n + 1)).mapQ
      (subcomplexCellularChainSubmodule X A n)
      (data.differential n).toIntLinearMap
      (subcomplexCellularChainSubmodule_le_comap X A data n))

/-- Unfolding `relativeCellularDifferential X A data n` gives the quotient-linear map induced by
`data.differential n : C_(n + 1)(X) → C_n(X)`. -/
@[simp] theorem relativeCellularDifferential_def
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [hdesc : RelativeCellularDifferentialDescends X A data] (n : ℕ) :
    relativeCellularDifferential X A data n =
      ModuleCat.ofHom
        ((subcomplexCellularChainSubmodule X A (n + 1)).mapQ
          (subcomplexCellularChainSubmodule X A n)
          (data.differential n).toIntLinearMap
          (subcomplexCellularChainSubmodule_le_comap X A data n)) :=
  rfl

/-- Consecutive relative cellular differentials compose to zero. -/
theorem relativeCellularChainComplex_sq
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [hdesc : RelativeCellularDifferentialDescends X A data] (n : ℕ) :
    relativeCellularDifferential X A data (n + 1) ≫
      relativeCellularDifferential X A data n = 0 := sorry

/-- Definition 13.3.2 (1). For a subcomplex `A ⊆ X`, the relative cellular chain complex
`C_*(X, A)` is the quotient cellular chain complex `C_*(X) / C_*(A)`, modeled degreewise by the
quotients `C_n(X) / im(C_n(A) → C_n(X))`. -/
abbrev relativeCellularChainComplex
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [hdesc : RelativeCellularDifferentialDescends X A data] :
    ChainComplex (ModuleCat ℤ) ℕ :=
  ChainComplex.of
    (relativeCellularChainGroup X A)
    (relativeCellularDifferential X A data)
    (relativeCellularChainComplex_sq X A data)

/-- The differential of `relativeCellularChainComplex X A data` in degree `n` is the descended
relative cellular differential in degree `n`. -/
@[simp] theorem relativeCellularChainComplex_d
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [hdesc : RelativeCellularDifferentialDescends X A data] (n : ℕ) :
    (relativeCellularChainComplex X A data).d (n + 1) n =
      relativeCellularDifferential X A data n := by
  exact
    ChainComplex.of_d
      (relativeCellularChainGroup X A)
      (relativeCellularDifferential X A data)
      (relativeCellularChainComplex_sq X A data)
      n

/-- The indexing family for the quotient CW model induced by collapsing `A`: in degree `0` one has
the collapsed vertex together with the ambient `0`-cells not lying in `A`, and in positive degrees
one has the ambient cells of `X` that do not belong to `A`. -/
def relativeCellularQuotientCellIndex
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) : ℕ → Type u :=
  fun
    | 0 =>
        PUnit ⊕
          {q : cellularCell X 0 |
            q ∉ Set.range fun i : A.I 0 ↦ (i : cellularCell X 0)}
    | n + 1 =>
        {q : cellularCell X (n + 1) |
          q ∉ Set.range fun i : A.I (n + 1) ↦ (i : cellularCell X (n + 1))}

/-- In degree `0`, `relativeCellularQuotientCellIndex X A` is the disjoint union of the collapsed
vertex and the ambient `0`-cells not contained in `A`. -/
@[simp] theorem relativeCellularQuotientCellIndex_zero
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) :
    relativeCellularQuotientCellIndex X A 0 =
      (PUnit ⊕
        {q : cellularCell X 0 |
          q ∉ Set.range fun i : A.I 0 ↦ (i : cellularCell X 0)}) :=
  rfl

/-- In positive degrees, `relativeCellularQuotientCellIndex X A` consists of the ambient cells of
`X` that do not belong to the subcomplex `A`. -/
@[simp] theorem relativeCellularQuotientCellIndex_succ
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X)) (n : ℕ) :
    relativeCellularQuotientCellIndex X A (n + 1) =
      {q : cellularCell X (n + 1) |
        q ∉ Set.range fun i : A.I (n + 1) ↦ (i : cellularCell X (n + 1))} :=
  rfl

/-- For a nonempty subcomplex `A ⊆ X`, the reduced cellular chain complex attached to a chosen CW
structure on the quotient `X / A`, a chosen quotient-side cellular differential family, and a
chosen quotient `0`-cell. -/
abbrev relativeCellularQuotientReducedChainComplex
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    [CWComplex (Set.univ : Set (collapseSubsetType X A))]
    (quotientData : CellularDifferentialFamily (collapseSubsetType X A))
    (collapsedZeroCell : cellularCell (collapseSubsetType X A) 0) :
    ChainComplex (ModuleCat ℤ) ℕ :=
  reducedCellularChainComplex
    (collapseSubsetType X A)
    quotientData
    collapsedZeroCell

/-- Unfolding `relativeCellularQuotientReducedChainComplex X A quotientData collapsedZeroCell`
gives the reduced cellular chain complex determined by the chosen quotient-side cellular
differential and the chosen quotient `0`-cell. -/
@[simp] theorem relativeCellularQuotientReducedChainComplex_def
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    [CWComplex (Set.univ : Set (collapseSubsetType X A))]
    (quotientData : CellularDifferentialFamily (collapseSubsetType X A))
    (collapsedZeroCell : cellularCell (collapseSubsetType X A) 0) :
    relativeCellularQuotientReducedChainComplex X A quotientData collapsedZeroCell =
      reducedCellularChainComplex
        (collapseSubsetType X A)
        quotientData
        collapsedZeroCell :=
  rfl

/-- Definition 13.3.2 (2). For a nonempty subcomplex `A ⊆ X`, the relative cellular chain
complex `C_*(X, A)` is isomorphic to a reduced cellular chain complex for the pointed quotient
`X / A`. In this development the quotient-side data are kept explicit: a CW structure on `X / A`,
an identification of its cells with the collapsed vertex together with the cells of `X` outside
`A`, a chosen quotient-side cellular differential family, and a chosen quotient `0`-cell
representing the collapsed vertex. -/
theorem relativeCellularChainComplexReducedQuotientIso
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [RelativeCellularDifferentialDescends X A data]
    (hA : CWComplex.Subcomplex.Nonempty A)
    [CWComplex (Set.univ : Set (collapseSubsetType X A))]
    (cellEquiv :
      ∀ n : ℕ, cellularCell (collapseSubsetType X A) n ≃ relativeCellularQuotientCellIndex X A n)
    (quotientData : CellularDifferentialFamily (collapseSubsetType X A))
    (collapsedZeroCell : cellularCell (collapseSubsetType X A) 0)
    (collapsedZeroCell_spec : cellEquiv 0 collapsedZeroCell = Sum.inl PUnit.unit) :
    Nonempty
      (relativeCellularChainComplex X A data ≅
        relativeCellularQuotientReducedChainComplex X A quotientData collapsedZeroCell) := sorry

/-- Definition 13.3.2 (3). Relative cellular homology `H_*(X, A)` is the homology of the relative
cellular chain complex `C_*(X, A)`. -/
abbrev relativeCellularHomology
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [hdesc : RelativeCellularDifferentialDescends X A data] :
    ℕ → ModuleCat ℤ :=
  fun n ↦ (relativeCellularChainComplex X A data).homology n

/-- Lean notation for the relative cellular homology groups `H_n(X, A)` computed from the chosen
cellular differential family `data`. -/
scoped[CellularHomology] notation "H[" n "](" X ", " A ", " data ")" =>
  relativeCellularHomology X A data n

/-- Evaluating `relativeCellularHomology X A data` in degree `n` gives the degree-`n` homology
object of the relative cellular chain complex `C_*(X, A)`. -/
@[simp] theorem relativeCellularHomology_apply
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [hdesc : RelativeCellularDifferentialDescends X A data] (n : ℕ) :
    H[n](X, A, data) =
      (relativeCellularChainComplex X A data).homology n :=
  rfl

/-- Companion corollary. A chosen chain-complex isomorphism between `C_*(X, A)` and a reduced
cellular chain complex for `X / A` induces the corresponding degree-`n` homology isomorphism. -/
theorem relativeCellularHomologyReducedQuotientIso
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [RelativeCellularDifferentialDescends X A data]
    [CWComplex (Set.univ : Set (collapseSubsetType X A))]
    (quotientData : CellularDifferentialFamily (collapseSubsetType X A))
    (collapsedZeroCell : cellularCell (collapseSubsetType X A) 0)
    (e :
      relativeCellularChainComplex X A data ≅
        relativeCellularQuotientReducedChainComplex X A quotientData collapsedZeroCell)
    (n : ℕ) :
    Nonempty
      (H[n](X, A, data) ≅
        (relativeCellularQuotientReducedChainComplex X A quotientData collapsedZeroCell).homology
          n) := sorry

/-- The chain-complex comparison from `relativeCellularChainComplexReducedQuotientIso X A data`
induces the corresponding homology isomorphism in degree `n`. -/
theorem relativeCellularChainComplexReducedQuotientIso_homology
    (X : Type u) [TopologicalSpace X] [CWComplex (Set.univ : Set X)]
    (A : Topology.CWComplex.Subcomplex (Set.univ : Set X))
    (data : CellularDifferentialFamily X)
    [RelativeCellularDifferentialDescends X A data]
    (hA : CWComplex.Subcomplex.Nonempty A)
    [CWComplex (Set.univ : Set (collapseSubsetType X A))]
    (cellEquiv :
      ∀ n : ℕ, cellularCell (collapseSubsetType X A) n ≃ relativeCellularQuotientCellIndex X A n)
    (quotientData : CellularDifferentialFamily (collapseSubsetType X A))
    (collapsedZeroCell : cellularCell (collapseSubsetType X A) 0)
    (collapsedZeroCell_spec : cellEquiv 0 collapsedZeroCell = Sum.inl PUnit.unit)
    (n : ℕ) :
    Nonempty
      (H[n](X, A, data) ≅
        (relativeCellularQuotientReducedChainComplex X A quotientData collapsedZeroCell).homology
          n) := by
  rcases
      relativeCellularChainComplexReducedQuotientIso
        X A data hA cellEquiv quotientData collapsedZeroCell collapsedZeroCell_spec with
    ⟨e⟩
  exact
    relativeCellularHomologyReducedQuotientIso
      X A data quotientData collapsedZeroCell e n
