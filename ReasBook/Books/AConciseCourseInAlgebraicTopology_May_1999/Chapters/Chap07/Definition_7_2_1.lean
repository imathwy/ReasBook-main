import Mathlib.Topology.CompactOpen
import Mathlib.Topology.Compactness.CompactlyGeneratedSpace
import Mathlib.Topology.UnitInterval
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap05.Lemma_5_1_15
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap05.Proposition_5_1_16
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap05.Proposition_5_2_9
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap05.Definition_5_2_15
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap05.Remark_5_1_5
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap05.Proposition_5_2_17

open scoped unitInterval

universe u v s

variable {E : Type u} {B : Type v} [TopologicalSpace B]

-- Semantic recall: in the nearby path-lifting files, the textbook path space `B^I` is modeled by
-- the continuous-map space `C(I, B)`.

/-- Definition 7.2.1. For `p : E → B`, the mapping path space `N_p` is realized as the subtype
`{ z : E × C(I, B) // z.2 0 = p z.1 }` of pairs `(e, β)` with `β 0 = p e`. -/
abbrev MappingPathSpace (p : E → B) : Type (max u v) :=
  { z : E × C(I, B) // z.2 0 = p z.1 }

namespace MappingPathSpace

variable {p : E → B}

/-- The ordinary pullback-subspace topology underlying the mapping path construction. -/
@[reducible] def rawTopologicalSpace [TopologicalSpace E] :
    TopologicalSpace (MappingPathSpace p) :=
  TopologicalSpace.induced Subtype.val
    (inferInstance : TopologicalSpace (E × C(I, B)))

/-- `MappingPathSpace p` is the pullback in May's category `U`: its ordinary pullback-subspace
topology is followed by compactly generated replacement. -/
instance instTopologicalSpace [TopologicalSpace E] : TopologicalSpace (MappingPathSpace p) :=
  let _ : TopologicalSpace (MappingPathSpace p) := rawTopologicalSpace (p := p)
  TopologicalSpace.compactlyGenerated.{max u v} (MappingPathSpace p)

/-- The `U`-pullback topology on a mapping path space is compactly generated by construction. -/
instance instUCompactlyGeneratedSpace [TopologicalSpace E] :
    UCompactlyGeneratedSpace.{max u v} (MappingPathSpace p) := by
  simpa [instTopologicalSpace] using
    (@instUCompactlyGeneratedSpaceCompactlyGenerated.{max u v}
      (MappingPathSpace p) (rawTopologicalSpace (p := p)))

/-- Forgetting the compactly generated pullback topology to the ordinary ambient product is
continuous. -/
theorem continuous_subtypeVal [TopologicalSpace E] :
    Continuous (Subtype.val : MappingPathSpace p → E × C(I, B)) := by
  have hForget :
      @Continuous (MappingPathSpace p) (MappingPathSpace p) inferInstance
        (rawTopologicalSpace (p := p)) id := by
    have h :
        @Continuous (MappingPathSpace p) (MappingPathSpace p)
          (@TopologicalSpace.compactlyGenerated.{max u v, max u v} (MappingPathSpace p)
            (rawTopologicalSpace (p := p)))
          (rawTopologicalSpace (p := p)) id := by
      exact
        @continuous_id_compactlyGenerated.{max u v, max u v} (MappingPathSpace p)
          (rawTopologicalSpace (p := p))
    simpa [instTopologicalSpace] using h
  have hVal :
      @Continuous (MappingPathSpace p) (E × C(I, B))
        (rawTopologicalSpace (p := p)) inferInstance Subtype.val := by
    rw [continuous_iff_le_induced]
  exact
    @Continuous.comp (MappingPathSpace p) (MappingPathSpace p) (E × C(I, B))
      inferInstance (rawTopologicalSpace (p := p)) inferInstance id Subtype.val hVal hForget

/-- The point of `E` underlying an element of `MappingPathSpace p`. -/
def point (x : MappingPathSpace p) : E :=
  x.1.1

/-- The path in `B` underlying an element of `MappingPathSpace p`. -/
def path (x : MappingPathSpace p) : C(I, B) :=
  x.1.2

/-- Construct an element of `MappingPathSpace p` from a point and a path with matching initial
value. -/
def mk (e : E) (β : C(I, B)) (hβ : β 0 = p e) : MappingPathSpace p :=
  ⟨(e, β), hβ⟩

/-- A continuously varying compatible point-path pair defines a continuous map into the
compactly generated pullback `MappingPathSpace p`. -/
theorem continuous_mk
    [TopologicalSpace E]
    {S : Type s} [tS : TopologicalSpace S] [hS : UCompactlyGeneratedSpace.{max u v} S]
    {e : S → E} {β : S → C(I, B)}
    (he : Continuous e) (hβ : Continuous β)
    (hcompat : ∀ x, β x 0 = p (e x)) :
    Continuous fun x ↦ mk (e x) (β x) (hcompat x) := by
  let tRaw : TopologicalSpace (MappingPathSpace p) := rawTopologicalSpace (p := p)
  let tK : TopologicalSpace (MappingPathSpace p) :=
    @TopologicalSpace.compactlyGenerated.{max u v, max u v}
      (MappingPathSpace p) tRaw
  have hRaw :
      @Continuous S (MappingPathSpace p) tS tRaw
        (fun x ↦ mk (e x) (β x) (hcompat x)) := by
    simpa [tRaw, rawTopologicalSpace] using (he.prodMk hβ).subtype_mk hcompat
  have hKified :
      @Continuous S (Kified (MappingPathSpace p)) tS
        (@kifiedTopologicalSpace.{max u v, max u v} (MappingPathSpace p) tRaw)
        (fun x ↦ Kified.mk (mk (e x) (β x) (hcompat x))) :=
    @continuousToKifiedOfContinuous.{s, max u v}
      S tS hS (MappingPathSpace p) tRaw
      (fun x ↦ mk (e x) (β x) (hcompat x)) hRaw
  have hOf :
      @Continuous (Kified (MappingPathSpace p)) (MappingPathSpace p)
        (@kifiedTopologicalSpace.{max u v, max u v} (MappingPathSpace p) tRaw)
        tK Kified.of := by
    simpa [kifiedTopologicalSpace, tK] using
      (continuous_induced_dom :
        @Continuous (Kified (MappingPathSpace p)) (MappingPathSpace p)
          (TopologicalSpace.induced Kified.of
            (@TopologicalSpace.compactlyGenerated.{max u v, max u v}
              (MappingPathSpace p) tRaw))
          (@TopologicalSpace.compactlyGenerated.{max u v, max u v}
            (MappingPathSpace p) tRaw) Kified.of)
  have hComposite :=
    @Continuous.comp S (Kified (MappingPathSpace p)) (MappingPathSpace p)
      tS (@kifiedTopologicalSpace.{max u v, max u v} (MappingPathSpace p) tRaw) tK
      (fun x ↦ Kified.mk (mk (e x) (β x) (hcompat x))) Kified.of hOf hKified
  simpa [instTopologicalSpace, tK, tRaw] using hComposite

@[simp] theorem point_mk (e : E) (β : C(I, B)) (hβ : β 0 = p e) :
    (mk e β hβ).point = e :=
  rfl

@[simp] theorem path_mk (e : E) (β : C(I, B)) (hβ : β 0 = p e) :
    (mk e β hβ).path = β :=
  rfl

@[ext] theorem ext {x y : MappingPathSpace p} (hpoint : x.point = y.point)
    (hpath : x.path = y.path) : x = y := by
  apply Subtype.ext
  exact Prod.ext hpoint hpath

/-- The defining condition on `x : MappingPathSpace p` is that its path starts at `p x.point`. -/
theorem path_zero_eq (x : MappingPathSpace p) : x.path 0 = p x.point :=
  x.2

@[simp] theorem mk_point_path (x : MappingPathSpace p) : mk x.point x.path x.path_zero_eq = x := by
  cases x
  rfl

end MappingPathSpace

/-- The mapping-path pullback is again an object of May's category `U` when its source and base
are objects of `U`. -/
theorem mappingPathSpaceCompactlyGeneratedWeakHausdorffSpace
    {E : Type u} {B : Type v}
    [TopologicalSpace E] [TopologicalSpace B]
    [WeaklyHausdorffSpace.{u, u} E]
    [WeaklyHausdorffSpace.{v, v} B]
    (p : C(E, B)) :
    CompactlyGeneratedWeakHausdorffSpace.{max u v, max u v} (MappingPathSpace p) := by
  let hI : CompactlyGeneratedWeakHausdorffSpace.{0, 0} I := inferInstance
  let hIv : CompactlyGeneratedWeakHausdorffSpace.{0, v} I :=
    @CompactlyGenerated.compactlyGeneratedWeakHausdorffSpaceLift.{0, v} I inferInstance hI
  let hE : WeaklyHausdorffSpace.{u, u} E := inferInstance
  let hEm : WeaklyHausdorffSpace.{u, max u v} E := by
    simpa [max_assoc, max_left_comm, max_comm] using
      (@CompactlyGenerated.weaklyHausdorffSpaceLift.{u, v} E inferInstance hE)
  let hB : WeaklyHausdorffSpace.{v, v} B := inferInstance
  let hBm : WeaklyHausdorffSpace.{v, max u v} B := by
    simpa [max_assoc, max_left_comm, max_comm] using
      (@CompactlyGenerated.weaklyHausdorffSpaceLift.{v, u} B inferInstance hB)
  let hMap : WeaklyHausdorffSpace.{v, v} C(I, B) := by
    simpa using
      (@CompactlyGenerated.continuousMapWeaklyHausdorffSpace.{0, v}
        I B inferInstance inferInstance hB)
  let hMapM : WeaklyHausdorffSpace.{v, max u v} C(I, B) := by
    simpa [max_assoc, max_left_comm, max_comm] using
      (@CompactlyGenerated.weaklyHausdorffSpaceLift.{v, u}
        C(I, B) inferInstance hMap)
  let hAmbient : WeaklyHausdorffSpace.{max u v, max u v} (E × C(I, B)) :=
    @weaklyHausdorffSpaceProd_direct.{u, v} E C(I, B) inferInstance inferInstance
      hEm hMapM
  have hRaw :
      @WeaklyHausdorffSpace.{max u v, max u v} (MappingPathSpace p)
        (MappingPathSpace.rawTopologicalSpace (p := p)) := by
    let _ : WeaklyHausdorffSpace.{max u v, max u v} (E × C(I, B)) := hAmbient
    let _ : TopologicalSpace (MappingPathSpace p) :=
      MappingPathSpace.rawTopologicalSpace (p := p)
    exact Subtype.weaklyHausdorffSpace
  simpa [MappingPathSpace.instTopologicalSpace] using
    (@instCompactlyGeneratedWeakHausdorffSpaceCompactlyGenerated.{max u v}
      (MappingPathSpace p) (MappingPathSpace.rawTopologicalSpace (p := p)) hRaw)
