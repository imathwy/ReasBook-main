import Mathlib.Topology.Covering.Basic
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap20.Construction_20_6_1
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap20.Proposition_20_1_3

open Bundle CategoryTheory
open scoped Manifold Topology

noncomputable section

section

variable {E : Type} [NormedAddCommGroup E] [NormedSpace ℝ E] [FiniteDimensional ℝ E]
variable {H : Type} [TopologicalSpace H] {I : ModelWithCorners ℝ E H}

namespace OrientationCover

section Topology

variable {n : ℕ} {M : Type} [TopologicalSpace M]

/-- The canonical projection from the orientation cover to its base manifold. -/
abbrev projection : OrientationCover n M → M :=
  point

@[simp] theorem projection_mk (x : M) (α : LocalOrientation n x) :
    projection ⟨x, α⟩ = x :=
  rfl

/-- For a local top-homology trivialization `U` and sign `u : ℤˣ`, the corresponding local sheet
of the orientation cover consists of the points whose chosen orientation is `U.identify` twisted
by `u` over the domain of `U`. -/
def sheet (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ) : Set (OrientationCover n M) :=
  { y | ∃ x : U.domain, y = ⟨x.1, U.identify x ≪≫ unitModuleIso ℤ u⟩ }

theorem mk_mem_sheet (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ) (x : U.domain) :
    (⟨x.1, U.identify x ≪≫ unitModuleIso ℤ u⟩ : OrientationCover n M) ∈ sheet U u :=
  ⟨x, rfl⟩

/-- The local sheet map sends a point of the trivialization domain to the corresponding point of
the orientation-cover sheet. -/
def sheetMap (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ) :
    U.domain → sheet U u :=
  fun x ↦ ⟨⟨x.1, U.identify x ≪≫ unitModuleIso ℤ u⟩, mk_mem_sheet U u x⟩

@[simp] theorem sheetMap_apply_val
    (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ) (x : U.domain) :
    ((sheetMap U u x : sheet U u) : OrientationCover n M) =
      ⟨x.1, U.identify x ≪≫ unitModuleIso ℤ u⟩ :=
  rfl

@[simp] theorem projection_sheetMap
    (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ) (x : U.domain) :
    projection ((sheetMap U u x : sheet U u) : OrientationCover n M) = x.1 :=
  rfl

/-- The canonical topology on `OrientationCover n M` is generated by all local sheets coming from
local top-homology trivializations and the two units of `ℤ`. -/
abbrev topology : TopologicalSpace (OrientationCover n M) :=
  TopologicalSpace.generateFrom { s | ∃ U : LocalTopHomologyTrivialization ℤ n M,
    ∃ u : ℤˣ, s = sheet U u }

instance : TopologicalSpace (OrientationCover n M) :=
  topology

theorem isOpen_sheet (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ) :
    IsOpen (sheet U u) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨U, u, rfl⟩

/-- Helper for the orientation-cover argument: an automorphism of
`constantCoefficientModule ℤ` is determined
by the image of `1`. -/
theorem constantCoefficientIso_eq_of_homOne_eq
    (e₁ e₂ : constantCoefficientModule ℤ ≅ constantCoefficientModule ℤ)
    (h : e₁.hom (1 : constantCoefficientModule ℤ) = e₂.hom 1) :
    e₁ = e₂ := by
  ext y
  have hHom : e₁.hom y = e₂.hom y := by
    calc
      e₁.hom y = e₁.hom (y.down • (1 : constantCoefficientModule ℤ)) := by
        exact congrArg e₁.hom (constantCoefficientModule_eq_down_smul_one y)
      _ = y.down • e₁.hom (1 : constantCoefficientModule ℤ) := by
        rw [map_smul]
      _ = y.down • e₂.hom (1 : constantCoefficientModule ℤ) := by
        rw [h]
      _ = e₂.hom (y.down • (1 : constantCoefficientModule ℤ)) := by
        rw [map_smul]
      _ = e₂.hom y := by
        exact congrArg e₂.hom (constantCoefficientModule_eq_down_smul_one y).symm
  simpa using congrArg ULift.down hHom

/-- Helper for the orientation-cover argument: every local orientation over a point of `U.domain`
differs
from `U.identify` by a unique sign in `ℤˣ`. -/
theorem orientation_eq_identify_twist_unique
    (U : LocalTopHomologyTrivialization ℤ n M) (x : U.domain)
    (α : LocalOrientation n x.1) :
    ∃! u : ℤˣ, α = U.identify x ≪≫ unitModuleIso ℤ u := by
  let e : constantCoefficientModule ℤ ≅ constantCoefficientModule ℤ := (U.identify x).symm ≪≫ α
  let u : ℤ := (e.hom (1 : constantCoefficientModule ℤ)).down
  let v : ℤ := (e.inv.hom (1 : constantCoefficientModule ℤ)).down
  have hEval : v • e.hom (1 : constantCoefficientModule ℤ) =
      (1 : constantCoefficientModule ℤ) := by
    calc
      v • e.hom (1 : constantCoefficientModule ℤ) =
          e.hom (v • (1 : constantCoefficientModule ℤ)) := by
        rw [map_smul]
      _ = e.hom (e.inv.hom (1 : constantCoefficientModule ℤ)) := by
        exact congrArg e.hom (constantCoefficientModule_eq_down_smul_one (e.inv.hom 1)).symm
      _ = 1 := e.inv_hom_id_apply (1 : constantCoefficientModule ℤ)
  have huv : u * v = 1 := by
    simpa [u, v, mul_comm] using congrArg ULift.down hEval
  let uu : ℤˣ := Units.mkOfMulEqOne u v huv
  have huu : α = U.identify x ≪≫ unitModuleIso ℤ uu := by
    have hOne : (unitModuleIso ℤ uu).hom (1 : constantCoefficientModule ℤ) = e.hom 1 := by
      ext
      simp [unitModuleIso, uu, u]
    have he : unitModuleIso ℤ uu = e :=
      constantCoefficientIso_eq_of_homOne_eq (unitModuleIso ℤ uu) e hOne
    simpa [e] using congrArg (fun iso ↦ U.identify x ≪≫ iso) he.symm
  refine ⟨uu, huu, ?_⟩
  intro w hw
  have hunit :
      unitModuleIso ℤ uu = unitModuleIso ℤ w := by
    simpa using congrArg (fun iso ↦ (U.identify x).symm ≪≫ iso) (huu.symm.trans hw)
  have hwval : (uu : ℤ) = (w : ℤ) := by
    have hhom :
        (unitModuleIso ℤ uu).hom = (unitModuleIso ℤ w).hom := by
      exact congrArg Iso.hom hunit
    have hval :
        (unitModuleIso ℤ uu).hom (1 : constantCoefficientModule ℤ) =
          (unitModuleIso ℤ w).hom (1 : constantCoefficientModule ℤ) :=
      congrArg (fun f : constantCoefficientModule ℤ ⟶ constantCoefficientModule ℤ ↦
        f (1 : constantCoefficientModule ℤ)) hhom
    have hdown :
        ((unitModuleIso ℤ uu).hom (1 : constantCoefficientModule ℤ)).down =
          ((unitModuleIso ℤ w).hom (1 : constantCoefficientModule ℤ)).down :=
      congrArg (fun z : constantCoefficientModule ℤ ↦ z.down) hval
    have huu_eval :
        ((unitModuleIso ℤ uu).hom (1 : constantCoefficientModule ℤ)).down = (uu : ℤ) := by
      simpa using
        (LocalTopHomologyTrivialization.unitModuleIso_hom_down uu
          (1 : constantCoefficientModule ℤ))
    have hw_eval :
        ((unitModuleIso ℤ w).hom (1 : constantCoefficientModule ℤ)).down = (w : ℤ) := by
      simpa using
        (LocalTopHomologyTrivialization.unitModuleIso_hom_down w
          (1 : constantCoefficientModule ℤ))
    exact huu_eval.symm.trans (hdown.trans hw_eval)
  exact (Units.ext hwval).symm

/-- Helper for the orientation-cover argument: two local orientations over the same point differ by
a unique
sign in `ℤˣ`. -/
theorem orientation_eq_twist_unique
    {x : M} (α β : LocalOrientation n x) :
    ∃! u : ℤˣ, α = β ≪≫ unitModuleIso ℤ u := by
  let e : constantCoefficientModule ℤ ≅ constantCoefficientModule ℤ := β.symm ≪≫ α
  let u : ℤ := (e.hom (1 : constantCoefficientModule ℤ)).down
  let v : ℤ := (e.inv.hom (1 : constantCoefficientModule ℤ)).down
  have hEval : v • e.hom (1 : constantCoefficientModule ℤ) =
      (1 : constantCoefficientModule ℤ) := by
    calc
      v • e.hom (1 : constantCoefficientModule ℤ) =
          e.hom (v • (1 : constantCoefficientModule ℤ)) := by
        rw [map_smul]
      _ = e.hom (e.inv.hom (1 : constantCoefficientModule ℤ)) := by
        exact congrArg e.hom (constantCoefficientModule_eq_down_smul_one (e.inv.hom 1)).symm
      _ = 1 := e.inv_hom_id_apply (1 : constantCoefficientModule ℤ)
  have huv : u * v = 1 := by
    simpa [u, v, mul_comm] using congrArg ULift.down hEval
  let uu : ℤˣ := Units.mkOfMulEqOne u v huv
  have huu : α = β ≪≫ unitModuleIso ℤ uu := by
    have hOne : (unitModuleIso ℤ uu).hom (1 : constantCoefficientModule ℤ) = e.hom 1 := by
      ext
      simp [unitModuleIso, uu, u]
    have he : unitModuleIso ℤ uu = e :=
      constantCoefficientIso_eq_of_homOne_eq (unitModuleIso ℤ uu) e hOne
    simpa [e] using congrArg (fun iso ↦ β ≪≫ iso) he.symm
  refine ⟨uu, huu, ?_⟩
  intro w hw
  have hunit :
      unitModuleIso ℤ uu = unitModuleIso ℤ w := by
    simpa using congrArg (fun iso ↦ β.symm ≪≫ iso) (huu.symm.trans hw)
  have hwval : (uu : ℤ) = (w : ℤ) := by
    have hhom :
        (unitModuleIso ℤ uu).hom = (unitModuleIso ℤ w).hom := by
      exact congrArg Iso.hom hunit
    have hval :
        (unitModuleIso ℤ uu).hom (1 : constantCoefficientModule ℤ) =
          (unitModuleIso ℤ w).hom (1 : constantCoefficientModule ℤ) :=
      congrArg (fun f : constantCoefficientModule ℤ ⟶ constantCoefficientModule ℤ ↦
        f (1 : constantCoefficientModule ℤ)) hhom
    have hdown :
        ((unitModuleIso ℤ uu).hom (1 : constantCoefficientModule ℤ)).down =
          ((unitModuleIso ℤ w).hom (1 : constantCoefficientModule ℤ)).down :=
      congrArg (fun z : constantCoefficientModule ℤ ↦ z.down) hval
    have huu_eval :
        ((unitModuleIso ℤ uu).hom (1 : constantCoefficientModule ℤ)).down = (uu : ℤ) := by
      simpa using
        (LocalTopHomologyTrivialization.unitModuleIso_hom_down uu
          (1 : constantCoefficientModule ℤ))
    have hw_eval :
        ((unitModuleIso ℤ w).hom (1 : constantCoefficientModule ℤ)).down = (w : ℤ) := by
      simpa using
        (LocalTopHomologyTrivialization.unitModuleIso_hom_down w
          (1 : constantCoefficientModule ℤ))
    exact huu_eval.symm.trans (hdown.trans hw_eval)
  exact (Units.ext hwval).symm

/-- Helper for the orientation-cover argument: the sign-reversal involution on the orientation
cover twists
the chosen local orientation by `-1`. -/
def flip (y : OrientationCover n M) : OrientationCover n M :=
  ⟨projection y, orientation y ≪≫ unitModuleIso ℤ (-1 : ℤˣ)⟩

@[simp] theorem projection_flip (y : OrientationCover n M) :
    projection (flip y) = projection y :=
  rfl

@[simp] theorem orientation_flip (y : OrientationCover n M) :
    orientation (flip y) = orientation y ≪≫ unitModuleIso ℤ (-1 : ℤˣ) :=
  rfl

/-- Helper for the orientation-cover argument: applying `flip` sends the `u`-sheet of a
trivialization to the `(-1) * u`-sheet of the same trivialization. -/
theorem flip_mem_sheet
    (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ) {y : OrientationCover n M}
    (hy : y ∈ sheet U u) :
    flip y ∈ sheet U ((-1 : ℤˣ) * u) := by
  rcases hy with ⟨x, rfl⟩
  refine ⟨x, ?_⟩
  apply Sigma.ext
  · rfl
  · simpa [flip, Iso.trans_assoc, mul_comm] using congrArg
      (fun iso ↦ U.identify x ≪≫ iso)
      (LocalTopHomologyTrivialization.unitModuleIso_mul u (-1 : ℤˣ))

/-- Helper for the orientation-cover argument: `flip` is an involution on the orientation cover. -/
@[simp] theorem flip_flip (y : OrientationCover n M) :
    flip (flip y) = y := by
  cases y with
  | mk x α =>
      rw [flip, flip]
      simp [Iso.trans_assoc, LocalTopHomologyTrivialization.unitModuleIso_mul,
        LocalTopHomologyTrivialization.unitModuleIso_one]

/-- Helper for the orientation-cover argument: the preimage of a basic sheet under `flip` is the
basic sheet with the opposite sign label. -/
theorem preimage_sheet_flip
    (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ) :
    flip ⁻¹' sheet U u = sheet U ((-1 : ℤˣ) * u) := by
  ext y
  constructor
  · intro hy
    have hflip : flip (flip y) ∈ sheet U ((-1 : ℤˣ) * u) :=
      flip_mem_sheet U u hy
    simpa using hflip
  · intro hy
    have hflip : flip y ∈ sheet U (((-1 : ℤˣ) * ((-1 : ℤˣ) * u))) :=
      flip_mem_sheet U ((-1 : ℤˣ) * u) hy
    simpa [mul_assoc] using hflip

/-- Helper for the orientation-cover argument: sign reversal is continuous for the sheet-generated
topology on `OrientationCover n M`. -/
theorem continuous_flip :
    Continuous (flip : OrientationCover n M → OrientationCover n M) := by
  rw [continuous_generateFrom_iff]
  rintro _ ⟨U, u, rfl⟩
  rw [preimage_sheet_flip]
  exact isOpen_sheet U ((-1 : ℤˣ) * u)

/-- Helper for the orientation-cover argument: membership in `sheet U u` is exactly the statement
that the point lies over `U.domain` and its local orientation is the `u`-twist of `U.identify`.
-/
theorem mem_sheet_iff
    (U : LocalTopHomologyTrivialization ℤ n M) (u : ℤˣ)
    {y : OrientationCover n M} :
    y ∈ sheet U u ↔
      ∃ hy : projection y ∈ U.domain,
        orientation y = U.identify ⟨projection y, hy⟩ ≪≫ unitModuleIso ℤ u := by
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨x.2, rfl⟩
  · rintro ⟨hy, horient⟩
    refine ⟨⟨projection y, hy⟩, ?_⟩
    cases y
    simpa using horient

/-- Helper for the orientation-cover argument: over a fixed local trivialization domain, every
point lies in a unique sign sheet. -/
theorem mem_uniqueSheet
    (U : LocalTopHomologyTrivialization ℤ n M)
    {y : OrientationCover n M} (hy : projection y ∈ U.domain) :
    ∃! u : ℤˣ, y ∈ sheet U u := by
  rcases orientation_eq_identify_twist_unique U ⟨projection y, hy⟩ (orientation y) with
    ⟨u, hu, hu_unique⟩
  refine ⟨u, ?_, ?_⟩
  · exact (mem_sheet_iff U u).2 ⟨hy, hu⟩
  · intro v hv
    exact hu_unique _ ((mem_sheet_iff U v).1 hv).2

/-- Helper for the orientation-cover argument: the preimage of `U.domain` splits into the two sign
sheets of `U`. -/
theorem preimage_domain_eq_union_sheets
    (U : LocalTopHomologyTrivialization ℤ n M) :
    projection ⁻¹' U.domain = sheet U (1 : ℤˣ) ∪ sheet U (-1 : ℤˣ) := by
  ext y
  constructor
  · intro hy
    rcases mem_uniqueSheet U hy with ⟨u, hu, -⟩
    rcases Int.units_eq_one_or u with rfl | rfl
    · exact Or.inl hu
    · exact Or.inr hu
  · intro hy
    rcases hy with hy | hy
    · exact ((mem_sheet_iff U (1 : ℤˣ)).1 hy).1
    · exact ((mem_sheet_iff U (-1 : ℤˣ)).1 hy).1

/-- Helper for the orientation-cover argument: each local trivialization domain has open preimage
in the orientation cover. -/
theorem isOpen_preimage_domain
    (U : LocalTopHomologyTrivialization ℤ n M) :
    IsOpen ((projection : OrientationCover n M → M) ⁻¹' U.domain) := by
  rw [preimage_domain_eq_union_sheets U]
  exact (isOpen_sheet U (1 : ℤˣ)).union (isOpen_sheet U (-1 : ℤˣ))

/-- Helper for the orientation-cover argument: an explicit overlap transition sends the `u`-sheet
of `U` into the `(transition * u)`-sheet of `V`. -/
theorem sheetMap_mem_sheet_of_overlap_transition
    {U V : LocalTopHomologyTrivialization ℤ n M}
    {transition : LocallyConstant {x : M // x ∈ U.domain ∩ V.domain} ℤˣ}
    (htransition : ∀ ⦃x : M⦄ (hxU : x ∈ U.domain) (hxV : x ∈ V.domain),
      U.identify ⟨x, hxU⟩ =
        V.identify ⟨x, hxV⟩ ≪≫ unitModuleIso ℤ (transition ⟨x, ⟨hxU, hxV⟩⟩))
    (u : ℤˣ) (x : U.domain) (hxV : x.1 ∈ V.domain) :
    (((sheetMap U u x : sheet U u) : OrientationCover n M)) ∈
      sheet V (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u) := by
  refine (mem_sheet_iff V _).2 ⟨hxV, ?_⟩
  change U.identify x ≪≫ unitModuleIso ℤ u =
    V.identify ⟨x.1, hxV⟩ ≪≫ unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u)
  calc
    U.identify x ≪≫ unitModuleIso ℤ u =
        (V.identify ⟨x.1, hxV⟩ ≪≫
          unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩)) ≪≫ unitModuleIso ℤ u := by
      rw [htransition x.2 hxV]
    _ = V.identify ⟨x.1, hxV⟩ ≪≫
        unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u) := by
      simpa [Iso.trans_assoc] using congrArg
        (fun iso ↦ V.identify ⟨x.1, hxV⟩ ≪≫ iso)
        (LocalTopHomologyTrivialization.unitModuleIso_mul (transition ⟨x.1, ⟨x.2, hxV⟩⟩) u)

/-- Helper for the orientation-cover argument: on an overlap, the target sheet of `sheetMap U u x`
is forced by the transition unit from `U` to `V`. -/
theorem sheetMap_mem_sheet_iff_of_overlap_transition
    {U V : LocalTopHomologyTrivialization ℤ n M}
    {transition : LocallyConstant {x : M // x ∈ U.domain ∩ V.domain} ℤˣ}
    (htransition : ∀ ⦃x : M⦄ (hxU : x ∈ U.domain) (hxV : x ∈ V.domain),
      U.identify ⟨x, hxU⟩ =
        V.identify ⟨x, hxV⟩ ≪≫ unitModuleIso ℤ (transition ⟨x, ⟨hxU, hxV⟩⟩))
    (u v : ℤˣ) (x : U.domain) :
    (((sheetMap U u x : sheet U u) : OrientationCover n M)) ∈ sheet V v ↔
      ∃ hxV : x.1 ∈ V.domain, transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u = v := by
  constructor
  · intro hxSheet
    rcases (mem_sheet_iff V v).1 hxSheet with ⟨hxV, hxOrient⟩
    have htransitionOrient :
        orientation (((sheetMap U u x : sheet U u) : OrientationCover n M)) =
          V.identify ⟨x.1, hxV⟩ ≪≫
            unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u) :=
      ((mem_sheet_iff V _).1
        (sheetMap_mem_sheet_of_overlap_transition htransition u x hxV)).2
    have hcompare :
        V.identify ⟨x.1, hxV⟩ ≪≫ unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u) =
          V.identify ⟨x.1, hxV⟩ ≪≫ unitModuleIso ℤ v := by
      exact htransitionOrient.symm.trans hxOrient
    have hunit :
        unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u) = unitModuleIso ℤ v := by
      simpa using congrArg (fun iso ↦ (V.identify ⟨x.1, hxV⟩).symm ≪≫ iso) hcompare
    have hhom :
        (unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u)).hom
          (1 : constantCoefficientModule ℤ) =
          (unitModuleIso ℤ v).hom (1 : constantCoefficientModule ℤ) := by
      exact congrArg (fun f : constantCoefficientModule ℤ ⟶ constantCoefficientModule ℤ ↦
        f (1 : constantCoefficientModule ℤ)) (congrArg Iso.hom hunit)
    have hdown :
        (((unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u)).hom
            (1 : constantCoefficientModule ℤ)).down) =
          (((unitModuleIso ℤ v).hom (1 : constantCoefficientModule ℤ)).down) := by
      exact congrArg (fun z : constantCoefficientModule ℤ ↦ z.down) hhom
    have hleft :
        (((unitModuleIso ℤ (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u)).hom
            (1 : constantCoefficientModule ℤ)).down) =
          (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u : ℤ) := by
      simpa using
        (LocalTopHomologyTrivialization.unitModuleIso_hom_down
          (transition ⟨x.1, ⟨x.2, hxV⟩⟩ * u)
          (1 : constantCoefficientModule ℤ))
    have hright :
        (((unitModuleIso ℤ v).hom (1 : constantCoefficientModule ℤ)).down) = (v : ℤ) := by
      simpa using
        (LocalTopHomologyTrivialization.unitModuleIso_hom_down v
          (1 : constantCoefficientModule ℤ))
    exact ⟨hxV, Units.ext (hleft.symm.trans (hdown.trans hright))⟩
  · rintro ⟨hxV, rfl⟩
    exact sheetMap_mem_sheet_of_overlap_transition htransition u x hxV

end Topology

section Manifold

variable {n : ℕ}
variable {M : Type} [TopologicalSpace M] [ChartedSpace H M] [IsManifold I ⊤ M]
variable [Fact (Module.finrank ℝ E = n)]

/-- Helper for the orientation-cover argument: every manifold point lies in the domain of some
local top-homology trivialization. -/
theorem existsLocalTopHomologyTrivializationAt (x : M) :
    ∃ U : LocalTopHomologyTrivialization ℤ n M, x ∈ U.domain := by
  sorry

/-- Helper for the orientation-cover argument: any two local top-homology trivializations on the
manifold are compatible on their overlap. -/
theorem compatible_of_isManifold
    (U V : LocalTopHomologyTrivialization ℤ n M) :
    U.Compatible V := by
  sorry

/-- Helper for the orientation-cover argument: a local top-homology trivialization domain is evenly
covered by the orientation-cover projection. -/
theorem isEvenlyCovered_projection_of_mem_domain
    (U : LocalTopHomologyTrivialization ℤ n M) {x : M} (hx : x ∈ U.domain) :
    IsEvenlyCovered (projection : OrientationCover n M → M) x ℤˣ := by
  sorry

/-- Helper for the orientation-cover argument: over each fiber, a section picks one point and
`flip` picks the other. -/
theorem eq_section_or_flip_of_section
    (s : C(M, OrientationCover n M))
    (hs : projection ∘ s = fun x ↦ x)
    (y : OrientationCover n M) :
    y = s (projection y) ∨ y = flip (s (projection y)) := by
  cases y with
  | mk x α =>
      have hsx : projection (s x) = x := by
        simpa [Function.comp] using congrArg (fun f ↦ f x) hs
      cases hsSection : s x with
      | mk x' β =>
          have hx' : x' = x := by
            simpa [projection, hsSection] using hsx
          subst x'
          rcases orientation_eq_twist_unique α β with ⟨u, hu, _⟩
          rcases Int.units_eq_one_or u with rfl | rfl
          · left
            have hαβ : α = β := by
              simpa [LocalTopHomologyTrivialization.unitModuleIso_one] using hu
            simpa [hsSection, hαβ]
          · right
            simpa [flip, hsSection] using hu

/-- Helper for the orientation-cover argument: a section and its sign-reversed companion have
disjoint images. -/
theorem disjoint_range_section_flip
    (s : C(M, OrientationCover n M))
    (hs : projection ∘ s = fun x ↦ x) :
    Disjoint (Set.range s) (Set.range (flip ∘ s)) := by
  refine Set.disjoint_left.2 ?_
  intro y hy hflip
  rcases hy with ⟨x, rfl⟩
  rcases hflip with ⟨x', hx'⟩
  have hproj :
      projection (flip (s x')) = projection (s x) := by
    simpa [projection_flip] using congrArg projection hx'
  have hxx' : x' = x := by
    have hsx' : projection (s x') = x' := by
      simpa [Function.comp] using congrArg (fun f ↦ f x') hs
    have hsx : projection (s x) = x := by
      simpa [Function.comp] using congrArg (fun f ↦ f x) hs
    simpa [hsx', hsx] using hproj
  subst x'
  have hfix : s x = flip (s x) := by
    simpa [Function.comp] using hx'.symm
  cases hsSection : s x with
  | mk x0 β =>
      have hx0 : x0 = x := by
        have hsx : projection (s x) = x := by
          simpa [Function.comp] using congrArg (fun f ↦ f x) hs
        simpa [projection, hsSection] using hsx
      subst x0
      have hβNeg :
          β = β ≪≫ unitModuleIso ℤ (-1 : ℤˣ) := by
        have hPair : (⟨x, β⟩ : OrientationCover n M) = flip ⟨x, β⟩ := by
          simpa [hsSection] using hfix
        simpa [flip, Sigma.mk.inj_iff, heq_eq_eq] using hPair
      have hβOne :
          β = β ≪≫ unitModuleIso ℤ (1 : ℤˣ) := by
        simpa [LocalTopHomologyTrivialization.unitModuleIso_one]
      rcases orientation_eq_twist_unique β β with ⟨u, hu, hu_unique⟩
      have hOneEq : (1 : ℤˣ) = u := hu_unique _ hβOne
      have hNegEq : (-1 : ℤˣ) = u := hu_unique _ hβNeg
      have hne : (1 : ℤˣ) ≠ (-1 : ℤˣ) := by
        decide
      exact hne (hOneEq.trans hNegEq.symm)

/-- Helper for the orientation-cover argument: if the orientation cover of a connected manifold is
disconnected, then the projection admits a continuous section. -/
theorem existsContinuousSection_of_not_connected [ConnectedSpace M] [I.Boundaryless]
    (hdisc : ¬ ConnectedSpace (OrientationCover n M)) :
    ∃ s : C(M, OrientationCover n M), projection ∘ s = fun x ↦ x := by
  sorry

/-- Helper for Proposition 20.6.2 (1): the two-sheet local description implies that
`projection : OrientationCover n M → M` is a covering map. -/
theorem isCoveringMap_projection :
    IsCoveringMap (projection : OrientationCover n M → M) := by
  intro x
  rcases existsLocalTopHomologyTrivializationAt x with ⟨U, hxU⟩
  exact IsEvenlyCovered.to_isEvenlyCovered_preimage
    (isEvenlyCovered_projection_of_mem_domain U hxU)

/-- Helper for section arguments: an evenly covered fiber yields a trivialization once a point of
that fiber is fixed. -/
noncomputable def trivializationAtPoint {x : M}
    (hcov : IsEvenlyCovered (projection (n := n) : OrientationCover n M → M) x
      ((projection (n := n) : OrientationCover n M → M) ⁻¹' {x}))
    (y : (projection (n := n) : OrientationCover n M → M) ⁻¹' {x}) :
    Bundle.Trivialization (((projection (n := n) : OrientationCover n M → M) ⁻¹' {x}))
      (projection (n := n) : OrientationCover n M → M) :=
  @IsEvenlyCovered.toTrivialization _ _ _ _ (projection (n := n) : OrientationCover n M → M)
    (((projection (n := n) : OrientationCover n M → M) ⁻¹' {x})) inferInstance x ⟨y⟩ hcov

theorem mem_baseSet_trivializationAtPoint {x : M}
    (hcov : IsEvenlyCovered (projection (n := n) : OrientationCover n M → M) x
      ((projection (n := n) : OrientationCover n M → M) ⁻¹' {x}))
    (y : (projection (n := n) : OrientationCover n M → M) ⁻¹' {x}) :
    x ∈ (trivializationAtPoint hcov y).baseSet := by
  simpa [trivializationAtPoint] using
    (@IsEvenlyCovered.mem_toTrivialization_baseSet _ _ _ _
      (projection (n := n) : OrientationCover n M → M)
      (((projection (n := n) : OrientationCover n M → M) ⁻¹' {x})) inferInstance x ⟨y⟩ hcov)

/-- Helper for section arguments: continuity into a discrete target yields local constancy. -/
theorem isLocallyConstant_of_continuous_discrete
    {α : Type*} [TopologicalSpace α] {β : Type*} [TopologicalSpace β]
    (hβ : DiscreteTopology β) {f : α → β} (hf : Continuous f) :
    IsLocallyConstant f :=
  (@IsLocallyConstant.iff_continuous α β _ _ hβ f).2 hf

/-- Helper for the orientation-cover argument: the image of a continuous section is open in the
orientation cover. -/
theorem isOpen_range_of_section
    (s : C(M, OrientationCover n M))
    (hs : projection ∘ s = fun x ↦ x) :
    IsOpen (Set.range s) := by
  rw [isOpen_iff_mem_nhds]
  intro y hy
  rcases hy with ⟨x, rfl⟩
  have hsx : projection (s x) = x := by
    simpa [Function.comp] using congrArg (fun f ↦ f x) hs
  let yx : projection ⁻¹' {x} := ⟨s x, by simpa [hsx]⟩
  let hproj : IsCoveringMap (projection : OrientationCover n M → M) := isCoveringMap_projection
  let hcov := hproj x
  have hDiscrete : DiscreteTopology (projection ⁻¹' {x}) := hcov.1
  let t : Bundle.Trivialization (projection ⁻¹' {x})
      (projection : OrientationCover n M → M) :=
    trivializationAtPoint hcov yx
  let homeo := t.sourceHomeomorphBaseSetProd
  have hxBase : x ∈ t.baseSet := mem_baseSet_trivializationAtPoint hcov yx
  let fiberCoord : t.baseSet → projection ⁻¹' {x} := fun z ↦ (t (s z.1)).2
  let secInSource : t.baseSet → t.source := fun z ↦
    ⟨s z.1, t.mem_source.2 (by
      have hsz : projection (s z.1) = z.1 := by
        simpa [Function.comp] using congrArg (fun f ↦ f z.1) hs
      simpa [hsz] using z.2)⟩
  have hSecInSource : Continuous secInSource := by
    exact Continuous.subtype_mk (s.continuous.comp continuous_subtype_val) fun z ↦ (secInSource z).2
  have hFiberContinuous : Continuous fiberCoord := by
    have hcoord :
        fiberCoord = fun z ↦ (homeo (secInSource z)).2 := by
      funext z
      simp [fiberCoord, secInSource, homeo, Trivialization.sourceHomeomorphBaseSetProd_apply]
    rw [hcoord]
    exact (homeo.continuous.comp hSecInSource).snd
  have hFiberLocallyConstant : IsLocallyConstant fiberCoord :=
    isLocallyConstant_of_continuous_discrete hDiscrete hFiberContinuous
  rcases hFiberLocallyConstant.exists_open ⟨x, hxBase⟩ with ⟨Wsub, hWsubOpen, hxWsub, hWsubConst⟩
  let i0 : projection ⁻¹' {x} := fiberCoord ⟨x, hxBase⟩
  let Nsub : Set t.source :=
    homeo.symm '' (Wsub ×ˢ ({i0} : Set (projection ⁻¹' {x})))
  have hNsubOpen : IsOpen Nsub := by
    exact homeo.symm.isOpenMap _ <|
      hWsubOpen.prod
        (show IsOpen ({i0} : Set (projection ⁻¹' {x})) from
          @isOpen_discrete (projection ⁻¹' {x}) inferInstance hDiscrete _)
  let N : Set (OrientationCover n M) := Subtype.val '' Nsub
  have hNOpen : IsOpen N := t.open_source.isOpenMap_subtype_val _ hNsubOpen
  have hsxSource : s x ∈ t.source := by
    exact t.mem_source.2 (by simpa [hsx] using hxBase)
  have hsxNsub : ⟨s x, hsxSource⟩ ∈ Nsub := by
    refine ⟨(⟨x, hxBase⟩, i0), ⟨hxWsub, rfl⟩, ?_⟩
    apply homeo.injective
    calc
      homeo (homeo.symm (⟨x, hxBase⟩, i0)) =
            (⟨x, hxBase⟩, i0) := by
          simpa [homeo] using homeo.apply_symm_apply (⟨x, hxBase⟩, i0)
      _ = homeo ⟨s x, hsxSource⟩ := by
          apply Prod.ext
          · apply Subtype.ext
            simpa [homeo, Trivialization.sourceHomeomorphBaseSetProd_apply, hsx]
          · rfl
  have hsxN : s x ∈ N := ⟨⟨s x, hsxSource⟩, hsxNsub, rfl⟩
  have hNsubset : N ⊆ Set.range s := by
    intro y hyN
    rcases hyN with ⟨ysub, hyNsub, rfl⟩
    rcases hyNsub with ⟨p, hp, hpysub⟩
    have hpy : homeo ysub = p := by
      simpa [homeo, hpysub] using homeo.apply_symm_apply p
    have hspBase : projection (s p.1.1) = p.1.1 := by
      simpa [Function.comp] using congrArg (fun f ↦ f p.1.1) hs
    have hspSource : s p.1.1 ∈ t.source := by
      exact t.mem_source.2 (by simpa [hspBase] using p.1.2)
    have hCoord : fiberCoord p.1 = i0 := hWsubConst _ hp.1
    have hSectionPoint :
        homeo ⟨s p.1.1, hspSource⟩ = p := by
      apply Prod.ext
      · apply Subtype.ext
        simpa [homeo, Trivialization.sourceHomeomorphBaseSetProd_apply, hspBase]
      · have hCoord' : (t (s p.1.1)).2 = i0 := by
          simpa [homeo, Trivialization.sourceHomeomorphBaseSetProd_apply, fiberCoord] using hCoord
        exact hCoord'.trans hp.2.symm
    have hysubEq : ysub = ⟨s p.1.1, hspSource⟩ := by
      exact homeo.injective (hpy.trans hSectionPoint.symm)
    exact ⟨p.1.1, by simpa using (congrArg Subtype.val hysubEq).symm⟩
  exact mem_nhds_iff.2 ⟨N, hNsubset, hNOpen, hsxN⟩

/-- Helper for the orientation-cover argument: a global continuous section splits the orientation
cover into two disjoint open pieces. -/
theorem not_connected_of_existsContinuousSection [ConnectedSpace M] [I.Boundaryless]
    (hs : ∃ s : C(M, OrientationCover n M), projection ∘ s = fun x ↦ x) :
    ¬ ConnectedSpace (OrientationCover n M) := by
  rcases hs with ⟨s, hs⟩
  let sFlip : C(M, OrientationCover n M) :=
    ⟨flip ∘ s, continuous_flip.comp s.continuous⟩
  have hsFlip :
      projection ∘ sFlip = fun x ↦ x := by
    funext x
    have hsx : projection (s x) = x := by
      simpa [Function.comp] using congrArg (fun f ↦ f x) hs
    simp [sFlip, Function.comp, hsx]
  have hsOpen : IsOpen (Set.range s) :=
    isOpen_range_of_section s hs
  have hsFlipOpen : IsOpen (Set.range sFlip) :=
    isOpen_range_of_section sFlip hsFlip
  have hDisjoint :
      Disjoint (Set.range s) (Set.range sFlip) := by
    simpa [sFlip, Function.comp] using disjoint_range_section_flip s hs
  have hUnion :
      Set.range s ∪ Set.range sFlip = Set.univ := by
    ext y
    constructor
    · intro _
      simp
    · intro _
      rcases eq_section_or_flip_of_section s hs y with hy | hy
      · exact Or.inl ⟨projection y, hy.symm⟩
      · exact Or.inr ⟨projection y, by simpa [sFlip, Function.comp] using hy.symm⟩
  have hCompl : Set.range sFlip = (Set.range s)ᶜ := by
    ext y
    constructor
    · intro hyFlip hy
      exact hDisjoint.le_bot ⟨hy, hyFlip⟩
    · intro hy
      have : y ∈ Set.range s ∪ Set.range sFlip := by
        simpa [hUnion] using (show y ∈ (Set.univ : Set (OrientationCover n M)) from trivial)
      rcases this with hy' | hy'
      · exact (hy hy').elim
      · exact hy'
  have hsClosed : IsClosed (Set.range s) := by
    exact ⟨by simpa [hCompl] using hsFlipOpen⟩
  intro hconn
  have hsClopen : IsClopen (Set.range s) := ⟨hsClosed, hsOpen⟩
  let x0 : M := Classical.choice inferInstance
  have hsNonempty : (Set.range s).Nonempty := ⟨s x0, ⟨x0, rfl⟩⟩
  have hsFlipNonempty : (Set.range sFlip).Nonempty := ⟨flip (s x0), ⟨x0, rfl⟩⟩
  rcases (@isClopen_iff (OrientationCover n M) _ hconn.toPreconnectedSpace (Set.range s)).mp
      hsClopen with hsEmpty | hsUniv
  · exact hsNonempty.ne_empty hsEmpty
  · exact hsFlipNonempty.ne_empty (by simpa [hCompl, hsUniv] using hCompl)

/-- Helper for the orientation-cover argument: on a connected boundaryless manifold, connectedness
of the orientation cover is equivalent to the absence of a global continuous section of the
projection `OrientationCover n M → M`. -/
theorem connectedSpace_iff_noContinuousSection [ConnectedSpace M]
    [I.Boundaryless] :
    ConnectedSpace (OrientationCover n M) ↔
      ¬ ∃ s : C(M, OrientationCover n M), projection ∘ s = fun x ↦ x := sorry

