open scoped Topology

section

variable {X : Type u} [t : TopologicalSpace X]

/-- Helper for Proposition 5.1.16: a map from a compact Hausdorff space to `X` that is continuous
for the original topology `t` is automatically continuous for the k-ification topology
`TopologicalSpace.compactlyGenerated X`. -/
theorem continuousToCompactlyGeneratedOfContinuous {K : Type u} [TopologicalSpace K]
    [CompactSpace K] [T2Space K] {f : K → X} (hf : Continuous[‹TopologicalSpace K›, t] f) :
    Continuous[‹TopologicalSpace K›, TopologicalSpace.compactlyGenerated.{u, u} X] f := by
  let F : (Σ (j : (S : CompHaus.{u}) × C(S, X)), j.fst) → X := fun x ↦ x.1.2 x.2
  let i : (S : CompHaus.{u}) × C(S, X) := ⟨CompHaus.of K, ⟨f, hf⟩⟩
  have hgenerator :
      ∀ j : (S : CompHaus.{u}) × C(S, X),
        Continuous[ inferInstance, TopologicalSpace.compactlyGenerated.{u, u} X]
          (fun a : j.fst ↦ F ⟨j, a⟩) := by
    -- Rewrite the family of generators as one map out of the sigma type used in the definition.
    rw [TopologicalSpace.compactlyGenerated, ← @continuous_sigma_iff]
    exact continuous_coinduced_rng
  -- The chosen map `f` is one of the coinducing generators.
  simpa [F, i] using hgenerator i

/-- Helper for Proposition 5.1.16: the k-ification topology is compactly generated by
construction. -/
theorem uCompactlyGeneratedSpaceCompactlyGenerated :
    @UCompactlyGeneratedSpace.{u} X (TopologicalSpace.compactlyGenerated.{u, u} X) := by
  -- Any compact-Hausdorff source map into the original topology is also continuous into `kX`.
  refine @uCompactlyGeneratedSpace_of_isClosed X
    (TopologicalSpace.compactlyGenerated.{u, u} X) ?_
  intro A hA
  refine isClosed_compactlyGenerated_of_compHausClosed (X := X) (A := A) ?_
  intro S f
  have hfk : Continuous[ inferInstance, TopologicalSpace.compactlyGenerated.{u, u} X]
      (f : S → X) :=
    @continuousToCompactlyGeneratedOfContinuous X t S inferInstance inferInstance inferInstance
      (f : S → X) f.continuous
  let fk : @ContinuousMap S X inferInstance (TopologicalSpace.compactlyGenerated.{u, u} X) :=
    @ContinuousMap.mk S X inferInstance (TopologicalSpace.compactlyGenerated.{u, u} X)
      (f : S → X) hfk
  have hClosedPreimage : IsClosed (((fk : S → X) ⁻¹' A)) := hA S fk
  simpa [fk] using hClosedPreimage

/-- Proposition 5.1.16 uses the tautological compact-generation witness for the k-ification
topology. -/
instance instUCompactlyGeneratedSpaceCompactlyGenerated :
    @UCompactlyGeneratedSpace.{u} X (TopologicalSpace.compactlyGenerated.{u, u} X) :=
  uCompactlyGeneratedSpaceCompactlyGenerated (X := X)

end

section

variable {X : Type u} [t : TopologicalSpace X] [hwh : WeaklyHausdorffSpace.{u, u} X]

local notation "IsCompact[" t "]" => @IsCompact _ t

section compactlyGenerated

/-- Helper for Proposition 5.1.16: a subset compact for the original topology `t` stays compact
for the k-ification topology `TopologicalSpace.compactlyGenerated X`. -/
theorem isCompact_compactlyGenerated_of_original {K : Set X} (hK : IsCompact[t] K) :
    @IsCompact X (TopologicalSpace.compactlyGenerated.{u, u} X) K := by
  -- Local instance justification (transport): the reverse compactness direction must endow the
  -- subtype `K` with the original subspace topology coming from `t`, not with the ambient
  -- k-ification subspace topology.
  let _ : TopologicalSpace K := TopologicalSpace.induced Subtype.val t
  -- Original compactness gives the compact Hausdorff structure needed for the subtype inclusion.
  let _ : CompactSpace K := (isCompact_iff_compactSpace.mp hK)
  let _ : @WeaklyHausdorffSpace K (TopologicalSpace.induced Subtype.val t) :=
    @Subtype.weaklyHausdorffSpace X t hwh K
  let _ : T2Space K := CompactSpace.toT2Space_of_weaklyHausdorffSpace K
  have hsubtypeVal : Continuous[‹TopologicalSpace K›, t] (Subtype.val : K → X) := by
    exact continuous_subtype_val
  have hval :
      Continuous[‹TopologicalSpace K›, TopologicalSpace.compactlyGenerated.{u, u} X]
        (Subtype.val : K → X) :=
    continuousToCompactlyGeneratedOfContinuous (X := X) (t := t) hsubtypeVal
  -- The subset `K` is the range of the subtype inclusion in the k-ification topology.
  let hRangeCompact :
      @IsCompact X (TopologicalSpace.compactlyGenerated.{u, u} X)
        (Set.range (Subtype.val : K → X)) := by
    exact
      @isCompact_range K X (TopologicalSpace.induced Subtype.val t)
        (TopologicalSpace.compactlyGenerated.{u, u} X) _ (Subtype.val : K → X) hval
  simpa [Subtype.range_val] using hRangeCompact

/-- Proposition 5.1.16 (1): if `X` is weak Hausdorff, then the compactly generated replacement
topology `TopologicalSpace.compactlyGenerated X` on the same carrier is weak Hausdorff. -/
theorem weaklyHausdorffSpaceCompactlyGenerated :
    @WeaklyHausdorffSpace.{u, u} X (TopologicalSpace.compactlyGenerated.{u, u} X) := by
  refine @WeaklyHausdorffSpace.mk.{u, u} X (TopologicalSpace.compactlyGenerated.{u, u} X) ?_
  intro K _ _ _ g hg
  have hgOriginal : Continuous[‹TopologicalSpace K›, t] g := by
    simpa using
      (@Continuous.comp K X X ‹TopologicalSpace K›
        (TopologicalSpace.compactlyGenerated.{u, u} X) t g id
        (continuous_id_compactlyGenerated (X := X) (t := t)) hg)
  have hCompactOriginal : IsCompact[t] (Set.range g) := isCompact_range hgOriginal
  -- The original weak Hausdorff topology makes the compact-source range closed.
  have hClosedOriginal : @IsClosed X t (Set.range g) :=
    @IsCompact.isClosed_of_weaklyHausdorff X t hwh (Set.range g) hCompactOriginal
  -- Closed subsets of the original topology are compactly closed, hence closed in the k-topology.
  exact
    @isClosed_compactlyGenerated_of_isCompactlyClosed X t (Set.range g)
      (@IsClosed.isCompactlyClosed X t (Set.range g) hClosedOriginal)

/-- Proposition 5.1.16 (1): if `X` is weak Hausdorff, then the compactly generated replacement
topology `TopologicalSpace.compactlyGenerated X` on the same carrier is weak Hausdorff. -/
instance instWeaklyHausdorffSpaceCompactlyGenerated :
    @WeaklyHausdorffSpace.{u, u} X (TopologicalSpace.compactlyGenerated.{u, u} X) :=
  weaklyHausdorffSpaceCompactlyGenerated (X := X) (t := t)

/-- Proposition 5.1.16 (2): if `X` is weak Hausdorff, then the compactly generated replacement
topology `TopologicalSpace.compactlyGenerated X` is compactly generated in the textbook sense. -/
instance instCompactlyGeneratedWeakHausdorffSpaceCompactlyGenerated :
    @CompactlyGeneratedWeakHausdorffSpace.{u, u} X
      (TopologicalSpace.compactlyGenerated.{u, u} X) := by
  -- Combine the weak Hausdorff result with the tautological compact-generation witness.
  refine
    @CompactlyGeneratedWeakHausdorffSpace.mk.{u, u} X
      (TopologicalSpace.compactlyGenerated.{u, u} X)
      (instWeaklyHausdorffSpaceCompactlyGenerated (X := X) (t := t))
      (instUCompactlyGeneratedSpaceCompactlyGenerated (X := X))

/-- Proposition 5.1.16 (3): if `X` is weak Hausdorff, then the compact subsets for
`TopologicalSpace.compactlyGenerated X` are exactly the compact subsets for the original topology
`t` on the same carrier `X`. -/
theorem isCompact_compactlyGenerated_iff {K : Set X} :
    @IsCompact X (TopologicalSpace.compactlyGenerated.{u, u} X) K ↔ IsCompact[t] K := by
  constructor
  · intro hK
    -- Forgetting from the k-ification back to the original topology preserves compactness.
    let hImageCompact : IsCompact[t] ((id : X → X) '' K) := by
      exact
        @IsCompact.image X X (TopologicalSpace.compactlyGenerated.{u, u} X) t K id hK
          (continuous_id_compactlyGenerated (X := X) (t := t))
    simpa using hImageCompact
  · intro hK
    -- Compact subsets of the original topology stay compact after k-ification.
    exact isCompact_compactlyGenerated_of_original (X := X) (t := t) hK

end compactlyGenerated

end
