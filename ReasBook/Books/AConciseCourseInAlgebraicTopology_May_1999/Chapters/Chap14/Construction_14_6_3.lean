import Mathlib.Logic.Relation
import Mathlib.Topology.Category.TopCat.Basic
import Mathlib.Topology.Constructions
import Mathlib.Topology.UnitInterval

open scoped unitInterval

universe u

-- Semantic recall: `lean_leansearch` did not return a verified existing owner for the topological
-- telescope in the current environment, and local quotient-space precedents use
-- `Relation.EqvGen.setoid`. This file therefore formalizes the telescope for a sequential family
-- of continuous maps as an explicit quotient of `Σ i, X i × I` by the endpoint-gluing relation.

variable {X : ℕ → Type u} [∀ i, TopologicalSpace (X i)]

/-- The generating relation on `Σ i, X i × I` that glues the endpoint `(x, 1)` of the `i`-th
cylinder to the endpoint `(f i x, 0)` of the `(i + 1)`-st cylinder. -/
def topologicalTelescopeRel
    (f : ∀ i : ℕ, C(X i, X (i + 1))) :
    (Σ i : ℕ, X i × I) → (Σ i : ℕ, X i × I) → Prop :=
  fun p q ↦ ∃ i : ℕ, ∃ x : X i, p = ⟨i, (x, 1)⟩ ∧ q = ⟨i + 1, (f i x, 0)⟩

/-- The setoid on `Σ i, X i × I` generated by the endpoint identifications defining the
telescope. -/
def topologicalTelescopeSetoid
    (f : ∀ i : ℕ, C(X i, X (i + 1))) :
    Setoid (Σ i : ℕ, X i × I) :=
  Relation.EqvGen.setoid (topologicalTelescopeRel f)

/-- Construction 14.6.3. For a sequence of spaces and continuous maps
`f i : X i ⟶ X (i + 1)`, the telescope `tel X_i` is the quotient of `Σ i, X i × I` obtained by
identifying `(x, 1)` in the `i`-th cylinder with `(f i x, 0)` in the `(i + 1)`-st cylinder.
This realizes `tel X_i` as the union of the mapping cylinders `X_i × [i, i + 1]` with endpoints
glued by the maps `f i`. -/
def topologicalTelescope
    (f : ∀ i : ℕ, C(X i, X (i + 1))) : TopCat :=
  TopCat.of (Quotient (topologicalTelescopeSetoid f))

/-- The class of `(x, t)` in the `i`-th cylinder of the topological telescope. -/
def topologicalTelescopePoint
    (f : ∀ i : ℕ, C(X i, X (i + 1)))
    (i : ℕ) (x : X i) (t : I) : topologicalTelescope f :=
  Quotient.mk'' ⟨i, (x, t)⟩

/-- A generating endpoint identification becomes an equality in the telescope quotient. -/
theorem topologicalTelescope_mk_eq_mk
    (f : ∀ i : ℕ, C(X i, X (i + 1)))
    {p q : Σ i : ℕ, X i × I} (h : topologicalTelescopeRel f p q) :
    (Quotient.mk'' p : topologicalTelescope f) = Quotient.mk'' q :=
  Quotient.sound (Relation.EqvGen.rel _ _ h)

/-- The inclusion of the `i`-th cylinder `X i × I` into the topological telescope. -/
def topologicalTelescopeCylinderInclusion
    (f : ∀ i : ℕ, C(X i, X (i + 1)))
    (i : ℕ) : C(X i × I, topologicalTelescope f) :=
  ⟨fun p ↦ topologicalTelescopePoint f i p.1 p.2,
    by
      change Continuous
        (Quotient.mk'' ∘ (@Sigma.mk ℕ (fun j : ℕ ↦ X j × I) i : X i × I → Σ j : ℕ, X j × I))
      exact continuous_quotient_mk'.comp
        (continuous_sigmaMk : Continuous (@Sigma.mk ℕ (fun j : ℕ ↦ X j × I) i))⟩

@[simp] theorem topologicalTelescopeCylinderInclusion_apply
    (f : ∀ i : ℕ, C(X i, X (i + 1)))
    (i : ℕ) (x : X i) (t : I) :
    topologicalTelescopeCylinderInclusion f i (x, t) = topologicalTelescopePoint f i x t :=
  rfl

/-- The endpoint identifications in the telescope glue `(x, 1)` in the `i`-th cylinder to
`(f i x, 0)` in the `(i + 1)`-st cylinder. -/
theorem topologicalTelescopePoint_endpoint_eq
    (f : ∀ i : ℕ, C(X i, X (i + 1))) (i : ℕ) (x : X i) :
    topologicalTelescopePoint f i x 1 =
      topologicalTelescopePoint f (i + 1) (f i x) 0 := by
  exact topologicalTelescope_mk_eq_mk f ⟨i, x, rfl, rfl⟩
