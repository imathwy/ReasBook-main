import Mathlib.Logic.Relation
import Mathlib.Topology.Constructions.SumProd
import Mathlib.Topology.UnitInterval

open scoped unitInterval

-- Semantic recall: `SimpleGraph` is mathlib's nearby combinatorial graph API, but this item
-- defines a topological quotient space built from the endpoint identifications.

universe u v

variable {X₀ : Type u} {J : Type v}

/-- The generating endpoint-identification relation on `X₀ ⊕ (J × I)` for a graph realization.

The embedding `boundary : J ↪ Fin 2 → X₀` encodes the source discrete set of maps
`j : S⁰ → X₀`. -/
def graphRealizationRel (boundary : J ↪ Fin 2 → X₀) :
    (X₀ ⊕ (J × I)) → (X₀ ⊕ (J × I)) → Prop
  | Sum.inr (j, t), Sum.inl x => (t = 0 ∧ x = boundary j 0) ∨ (t = 1 ∧ x = boundary j 1)
  | Sum.inl x, Sum.inr (j, t) => (x = boundary j 0 ∧ t = 0) ∨ (x = boundary j 1 ∧ t = 1)
  | _, _ => False

/-- The setoid on `X₀ ⊕ (J × I)` generated by the endpoint identifications from `boundary`. -/
def graphRealizationSetoid (boundary : J ↪ Fin 2 → X₀) : Setoid (X₀ ⊕ (J × I)) :=
  Relation.EqvGen.setoid (graphRealizationRel boundary)

/-- Definition 4.1.2. The graph realized from a discrete vertex set `X₀` and a discrete family
`boundary : J ↪ Fin 2 → X₀` of maps is the quotient of `X₀ ⊕ (J × I)` that identifies
`(j, 0)` with `boundary j 0` and `(j, 1)` with `boundary j 1`.

Here `Fin 2` is the chosen Lean model for the discrete two-point space `S⁰`. -/
def graphRealization (boundary : J ↪ Fin 2 → X₀) :=
  Quotient (graphRealizationSetoid boundary)

/-- The source `X₀ ⊕ (J × I)` of the graph realization carries the discrete topologies on `X₀`
and `J` together with the usual topology on `I`. -/
abbrev graphRealizationSourceTopologicalSpace : TopologicalSpace (X₀ ⊕ (J × I)) :=
  let _ : TopologicalSpace X₀ := ⊥
  let _ : TopologicalSpace J := ⊥
  inferInstance

/-- The generating relation identifies the initial vertex of the edge `j` with its endpoint
`(j, 0)`. -/
theorem graphRealizationRel_vertex_boundary_zero (boundary : J ↪ Fin 2 → X₀) (j : J) :
    graphRealizationRel boundary (Sum.inl (boundary j 0)) (Sum.inr (j, 0)) :=
  Or.inl ⟨rfl, rfl⟩

/-- The generating relation identifies the terminal vertex of the edge `j` with its endpoint
`(j, 1)`. -/
theorem graphRealizationRel_vertex_boundary_one (boundary : J ↪ Fin 2 → X₀) (j : J) :
    graphRealizationRel boundary (Sum.inl (boundary j 1)) (Sum.inr (j, 1)) :=
  Or.inr ⟨rfl, rfl⟩

/-- The generated setoid identifies the initial vertex of the edge `j` with its endpoint
`(j, 0)`. -/
theorem graphRealizationSetoid_vertex_boundary_zero (boundary : J ↪ Fin 2 → X₀) (j : J) :
    graphRealizationSetoid boundary (Sum.inl (boundary j 0)) (Sum.inr (j, 0)) :=
  Relation.EqvGen.rel _ _ (graphRealizationRel_vertex_boundary_zero boundary j)

/-- The generated setoid identifies the terminal vertex of the edge `j` with its endpoint
`(j, 1)`. -/
theorem graphRealizationSetoid_vertex_boundary_one (boundary : J ↪ Fin 2 → X₀) (j : J) :
    graphRealizationSetoid boundary (Sum.inl (boundary j 1)) (Sum.inr (j, 1)) :=
  Relation.EqvGen.rel _ _ (graphRealizationRel_vertex_boundary_one boundary j)

/-- The carrier `graphRealization boundary` inherits the quotient topology induced from the
discrete topologies on `X₀` and `J` and the usual topology on `I`. -/
instance graphRealizationTopologicalSpace (boundary : J ↪ Fin 2 → X₀) :
    TopologicalSpace (graphRealization boundary) :=
  let _ : TopologicalSpace (X₀ ⊕ (J × I)) := graphRealizationSourceTopologicalSpace
  show TopologicalSpace (Quotient (graphRealizationSetoid boundary)) from inferInstance

/-- The quotient point of `graphRealization boundary` represented by `z : X₀ ⊕ (J × I)`. -/
def graphRealizationPoint (boundary : J ↪ Fin 2 → X₀) (z : X₀ ⊕ (J × I)) :
    graphRealization boundary :=
  Quotient.mk (graphRealizationSetoid boundary) z

@[simp] theorem graphRealizationPoint_inl (boundary : J ↪ Fin 2 → X₀) (x : X₀) :
    graphRealizationPoint boundary (Sum.inl x) =
      Quotient.mk (graphRealizationSetoid boundary) (Sum.inl x) := rfl

@[simp] theorem graphRealizationPoint_inr (boundary : J ↪ Fin 2 → X₀) (j : J) (t : I) :
    graphRealizationPoint boundary (Sum.inr (j, t)) =
      Quotient.mk (graphRealizationSetoid boundary) (Sum.inr (j, t)) := rfl

/-- The image of a vertex in the quotient realization `graphRealization boundary`. -/
def graphVertex (boundary : J ↪ Fin 2 → X₀) (x : X₀) : graphRealization boundary :=
  graphRealizationPoint boundary (Sum.inl x)

/-- The image of a point on the edge indexed by `j` in `graphRealization boundary`. -/
def graphEdgePoint (boundary : J ↪ Fin 2 → X₀) (j : J) (t : I) : graphRealization boundary :=
  graphRealizationPoint boundary (Sum.inr (j, t))

/-- The endpoint `0` of the edge `j` is identified with its initial vertex in the realization. -/
theorem graphVertex_boundary_zero_eq_graphEdgePoint_zero (boundary : J ↪ Fin 2 → X₀) (j : J) :
    graphVertex boundary (boundary j 0) = graphEdgePoint boundary j 0 := by
  change Quotient.mk (graphRealizationSetoid boundary) (Sum.inl (boundary j 0)) =
    Quotient.mk (graphRealizationSetoid boundary) (Sum.inr (j, 0))
  exact Quotient.sound (graphRealizationSetoid_vertex_boundary_zero boundary j)

/-- The endpoint `1` of the edge `j` is identified with its terminal vertex in the realization. -/
theorem graphVertex_boundary_one_eq_graphEdgePoint_one (boundary : J ↪ Fin 2 → X₀) (j : J) :
    graphVertex boundary (boundary j 1) = graphEdgePoint boundary j 1 := by
  change Quotient.mk (graphRealizationSetoid boundary) (Sum.inl (boundary j 1)) =
    Quotient.mk (graphRealizationSetoid boundary) (Sum.inr (j, 1))
  exact Quotient.sound (graphRealizationSetoid_vertex_boundary_one boundary j)
