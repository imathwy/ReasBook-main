module

public import Mathlib.GroupTheory.CoprodI
public import Mathlib.GroupTheory.IndexNormal

public section

-- Semantic recall via `lean_leansearch`: `Subgroup.index_eq_two_iff`,
-- `Subgroup.index_eq_two_iff_exists_notMem_and`, and `Subgroup.normal_of_index_eq_two`
-- are the canonical index-`2` APIs used to state this classification problem.

/-- The two distinguished generators `a` and `b` for the free group in Problem 4.6.1. -/
inductive ABGenerator
  | a
  | b
deriving DecidableEq

/-- The generator `a` in the free group on `ABGenerator`. -/
abbrev aWord : FreeGroup ABGenerator :=
  FreeGroup.of ABGenerator.a

/-- The generator `b` in the free group on `ABGenerator`. -/
abbrev bWord : FreeGroup ABGenerator :=
  FreeGroup.of ABGenerator.b

/-- The subgroup generated by `a²`, `b`, and `aba⁻¹`. -/
def aParitySubgroup : Subgroup (FreeGroup ABGenerator) :=
  Subgroup.closure ({aWord ^ 2, bWord, aWord * bWord * aWord⁻¹} : Set (FreeGroup ABGenerator))

/-- The subgroup generated by `a`, `b²`, and `bab⁻¹`. -/
def bParitySubgroup : Subgroup (FreeGroup ABGenerator) :=
  Subgroup.closure ({aWord, bWord ^ 2, bWord * aWord * bWord⁻¹} : Set (FreeGroup ABGenerator))

/-- The subgroup generated by `a²`, `ab`, and `b²`. -/
def abParitySubgroup : Subgroup (FreeGroup ABGenerator) :=
  Subgroup.closure ({aWord ^ 2, aWord * bWord, bWord ^ 2} : Set (FreeGroup ABGenerator))

/-- Problem 4.6.1 (1): a subgroup of the free group on generators `a` and `b` has index `2`
exactly when it is one of the three subgroups generated respectively by
`{a², b, aba⁻¹}`, `{a, b², bab⁻¹}`, or `{a², ab, b²}`. -/
theorem subgroup_index_eq_two_iff
    (H : Subgroup (FreeGroup ABGenerator)) :
    H.index = 2 ↔
      H = aParitySubgroup ∨ H = bParitySubgroup ∨ H = abParitySubgroup := sorry

/-- The subgroup generated by `{a², b, aba⁻¹}` has index `2`. -/
theorem aParitySubgroup_index_eq_two : aParitySubgroup.index = 2 := by
  exact (subgroup_index_eq_two_iff aParitySubgroup).2 <| Or.inl rfl

/-- The subgroup generated by `{a, b², bab⁻¹}` has index `2`. -/
theorem bParitySubgroup_index_eq_two : bParitySubgroup.index = 2 := by
  exact (subgroup_index_eq_two_iff bParitySubgroup).2 <| Or.inr <| Or.inl rfl

/-- The subgroup generated by `{a², ab, b²}` has index `2`. -/
theorem abParitySubgroup_index_eq_two : abParitySubgroup.index = 2 := by
  exact (subgroup_index_eq_two_iff abParitySubgroup).2 <| Or.inr <| Or.inr rfl

/-- The subgroup generated by `{a², b, aba⁻¹}` is normal. -/
instance aParitySubgroup_normal : aParitySubgroup.Normal :=
  Subgroup.normal_of_index_eq_two aParitySubgroup_index_eq_two

/-- The subgroup generated by `{a, b², bab⁻¹}` is normal. -/
instance bParitySubgroup_normal : bParitySubgroup.Normal :=
  Subgroup.normal_of_index_eq_two bParitySubgroup_index_eq_two

/-- The subgroup generated by `{a², ab, b²}` is normal. -/
instance abParitySubgroup_normal : abParitySubgroup.Normal :=
  Subgroup.normal_of_index_eq_two abParitySubgroup_index_eq_two

/-- Problem 4.6.1 (2): the free group on generators `a` and `b` has exactly three subgroups of
index `2`. -/
theorem natCard_subgroup_index_eq_two :
    Nat.card {H : Subgroup (FreeGroup ABGenerator) // H.index = 2} = 3 := sorry
