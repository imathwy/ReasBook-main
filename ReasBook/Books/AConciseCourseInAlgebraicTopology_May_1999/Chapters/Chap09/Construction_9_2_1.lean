import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.Definition_8_6_5
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap09.Definition_9_1_4

open CategoryTheory
open scoped unitInterval

noncomputable section

universe u

-- Semantic recall via `lean_leansearch`: the search only returned generic fiber-category and
-- homological `fiber` hits, not the Chapter 8 topological owner. Repo precedent fixes the API by
-- `fiberSequenceGeneratedBy`, `homotopyFiber`, and the inclusion-path model from Definition 9.1.4.

/-- The based space obtained from `Y` by choosing `y₀` as basepoint. -/
abbrev underTopOfPoint (Y : Type u) [TopologicalSpace Y] (y₀ : Y) : BasedSpace.{u} :=
  Under.mk
    (TopCat.terminalIsoPUnit.hom ≫
      TopCat.ofHom (ContinuousMap.const PUnit y₀))

/-- The chosen basepoint of `underTopOfPoint Y y₀` is `y₀`. -/
@[simp] theorem underTopBasepoint_underTopOfPoint (Y : Type u) [TopologicalSpace Y] (y₀ : Y) :
    underTopBasepoint (underTopOfPoint Y y₀) = y₀ :=
  rfl

local notation "BasedSpace" => Under (⊤_ TopCat)

variable {X : Type} [TopologicalSpace X]
variable {Y Z : Type} [TopologicalSpace Y] [TopologicalSpace Z]

/-- A continuous map `e : C(Y, Z)` induces the corresponding based map between the spaces pointed
at `y₀` and `e y₀`. -/
def underTopOfPointMap (e : C(Y, Z)) (y₀ : Y) :
    underTopOfPoint Y y₀ ⟶ underTopOfPoint Z (e y₀) :=
  Under.homMk (TopCat.ofHom e) (by
    ext u
    rfl)

/-- The underlying map of `underTopOfPointMap e y₀` is `e`. -/
@[simp] theorem underTopOfPointMap_hom (e : C(Y, Z)) (y₀ : Y) :
    (underTopOfPointMap e y₀).right.hom = e :=
  rfl

namespace UnderTopOfPoint

variable {y₀ : Y} {z₀ : Z}

/-- The underlying continuous map of a based map between spaces pointed by chosen points. -/
abbrev toContinuousMap (f : underTopOfPoint Y y₀ ⟶ underTopOfPoint Z z₀) : C(Y, Z) :=
  f.right.hom

@[simp] theorem toContinuousMap_eq (f : underTopOfPoint Y y₀ ⟶ underTopOfPoint Z z₀) :
    toContinuousMap f = f.right.hom :=
  rfl

end UnderTopOfPoint

/-- `underTopOfPointMap e y₀` carries the chosen basepoint `y₀` to `e y₀`. -/
@[simp] theorem underTopOfPointMap_basepoint (e : C(Y, Z)) (y₀ : Y) :
    (underTopOfPointMap e y₀).right.hom (underTopBasepoint (underTopOfPoint Y y₀)) =
      underTopBasepoint (underTopOfPoint Z (e y₀)) := by
  rfl

/-- The subspace `A ⊆ X` pointed by the chosen basepoint `x : A`. -/
abbrev inclusionBasedSubspace (A : Set X) (x : A) : BasedSpace :=
  underTopOfPoint A x

/-- The ambient space `X` pointed by the same chosen basepoint. -/
abbrev inclusionAmbientSpace {A : Set X} (x : A) : BasedSpace :=
  underTopOfPoint X x.1

/-- The based inclusion `A ↪ X` determined by the chosen basepoint `x : A`. -/
def inclusionBasedMap (A : Set X) (x : A) :
    inclusionBasedSubspace A x ⟶ inclusionAmbientSpace x :=
  underTopOfPointMap ⟨Subtype.val, continuous_subtype_val⟩ x

/-- The underlying map of `inclusionBasedMap A x` is the subtype inclusion `A ↪ X`. -/
@[simp] theorem inclusionBasedMap_hom (A : Set X) (x : A) :
    ((inclusionBasedMap A x).right.hom : C(A, X)) = ⟨Subtype.val, continuous_subtype_val⟩ :=
  rfl

/-- Construction 9.2.1. For the inclusion `i : A ↪ X` based at `x : A`, the homotopy fiber
`F_i` of `i`, identified in Definition 9.1.4 with `P(X; *, A)`, enters the fiber sequence
generated by `i`. This is the specialized Chapter 8 sequence
`⋯ ⟶ Ω A ⟶ Ω X ⟶ F_i ⟶ A ⟶ X`. -/
def inclusionFiberSequence (A : Set X) (x : A) : BasedSequence :=
  fiberSequenceGeneratedBy (inclusionBasedMap A x)

/-- `inclusionFiberSequence A x` is the fiber sequence generated by the based inclusion
`inclusionBasedMap A x : A ⟶ X`. -/
theorem inclusionFiberSequence_spec (A : Set X) (x : A) :
    inclusionFiberSequence A x = fiberSequenceGeneratedBy (inclusionBasedMap A x) :=
  rfl

/-- Stage `0` of `inclusionFiberSequence A x` is the ambient based space `X`. -/
@[simp] theorem inclusionFiberSequence_obj_zero (A : Set X) (x : A) :
    (inclusionFiberSequence A x).obj 0 = inclusionAmbientSpace x :=
  rfl

/-- Stage `1` of `inclusionFiberSequence A x` is the based subspace `A`. -/
@[simp] theorem inclusionFiberSequence_obj_one (A : Set X) (x : A) :
    (inclusionFiberSequence A x).obj 1 = inclusionBasedSubspace A x :=
  rfl

/-- Stage `2` of `inclusionFiberSequence A x` is the homotopy fiber of the based inclusion
`A ↪ X`. -/
@[simp] theorem inclusionFiberSequence_obj_two (A : Set X) (x : A) :
    (inclusionFiberSequence A x).obj 2 = homotopyFiber (inclusionBasedMap A x) :=
  rfl

/-- The path component of a point in the Chapter 8 homotopy fiber of `A ↪ X` starts at the chosen
basepoint of `X` and ends at the image of its endpoint in `X`. -/
theorem inclusionFiberToInclusionHomotopyFiber_condition (A : Set X) (x : A)
    (z : HomotopyFiber (inclusionBasedMap A x)) :
    z.path 0 = underTopBasepoint (inclusionAmbientSpace x) ∧
      z.path 1 = (inclusionBasedMap A x).right.hom z.point := by
  refine ⟨PathSpace.source_eq z.path, ?_⟩
  simpa using (HomotopyFiber.endpoint_eq z).symm

/-- A point of the Chapter 8 homotopy fiber of `A ↪ X` determines the modeled inclusion
homotopy fiber from Definition 9.1.4 by retaining its endpoint in `A` and its path in `X`. -/
def inclusionFiberToInclusionHomotopyFiber (A : Set X) (x : A) :
    HomotopyFiber (inclusionBasedMap A x) → inclusionHomotopyFiber A x
  | z =>
      ⟨(z.point, z.path.1), inclusionFiberToInclusionHomotopyFiber_condition A x z⟩

/-- The endpoint condition on a modeled inclusion-homotopy-fiber point gives the matching
endpoint equation needed to build a Chapter 8 homotopy-fiber point. -/
theorem inclusionHomotopyFiberToInclusionFiber_condition (A : Set X) (x : A)
    (z : inclusionHomotopyFiber A x) :
    (inclusionBasedMap A x).right.hom z.endpoint = (PathSpace.ofPath z.path).endpoint := by
  rw [PathSpace.endpoint_ofPath]
  change z.endpoint.1 = z.endpoint.1
  rfl

/-- A modeled inclusion-homotopy-fiber point determines the corresponding Chapter 8 homotopy
fiber point of the based inclusion `A ↪ X`. -/
def inclusionHomotopyFiberToInclusionFiber (A : Set X) (x : A) :
    inclusionHomotopyFiber A x → HomotopyFiber (inclusionBasedMap A x)
  | z =>
      HomotopyFiber.mk z.endpoint (PathSpace.ofPath z.path)
        (inclusionHomotopyFiberToInclusionFiber_condition A x z)

/-- The map from the Chapter 8 homotopy fiber of `A ↪ X` to the modeled inclusion homotopy
fiber has the expected inverse. -/
theorem inclusionFiberToInclusionHomotopyFiber_leftInverse (A : Set X) (x : A) :
    Function.LeftInverse (inclusionHomotopyFiberToInclusionFiber A x)
      (inclusionFiberToInclusionHomotopyFiber A x) := by
  intro z
  -- Unpack the Chapter 8 fiber point so the round-trip only repackages the same coordinates.
  rcases z with ⟨⟨y, γ⟩, hγ⟩
  rfl

/-- The map from the modeled inclusion homotopy fiber back to the Chapter 8 homotopy fiber of
`A ↪ X` has the expected inverse. -/
theorem inclusionFiberToInclusionHomotopyFiber_rightInverse (A : Set X) (x : A) :
    Function.RightInverse (inclusionHomotopyFiberToInclusionFiber A x)
      (inclusionFiberToInclusionHomotopyFiber A x) := by
  intro z
  -- Unpack the modeled inclusion fiber so the round-trip reduces to the stored endpoint and path.
  rcases z with ⟨⟨y, γ⟩, hγ₀, hγ₁⟩
  rfl

/-- The Chapter 8 homotopy fiber of the based inclusion `A ↪ X` is the modeled inclusion
homotopy fiber from Definition 9.1.4. -/
def inclusionFiberEquivInclusionHomotopyFiber (A : Set X) (x : A) :
    HomotopyFiber (inclusionBasedMap A x) ≃ inclusionHomotopyFiber A x where
  toFun := inclusionFiberToInclusionHomotopyFiber A x
  invFun := inclusionHomotopyFiberToInclusionFiber A x
  left_inv := inclusionFiberToInclusionHomotopyFiber_leftInverse A x
  right_inv := inclusionFiberToInclusionHomotopyFiber_rightInverse A x

/-- The fiber term `F_i` of `inclusionFiberSequence A x` is identified with the textbook path
space `P(X; *, A)`, formalized as `PathToSet A (underTopBasepoint (inclusionAmbientSpace x))`. -/
def inclusionFiberEquivPathToSet (A : Set X) (x : A) :
    HomotopyFiber (inclusionBasedMap A x) ≃
      PathToSet A (underTopBasepoint (inclusionAmbientSpace x)) :=
  (inclusionFiberEquivInclusionHomotopyFiber A x).trans
    (inclusionHomotopyFiberHomeomorphPathToSet A x).toEquiv

/-- Helper for Construction 9.2.1: the Chapter 8 homotopy-fiber basepoint maps to the constant
modeled inclusion-fiber point. -/
theorem inclusionFiberToInclusionHomotopyFiber_basepoint (A : Set X) (x : A) :
    inclusionFiberToInclusionHomotopyFiber A x
        (underTopBasepoint (homotopyFiber (inclusionBasedMap A x))) =
      inclusionHomotopyFiber.mk x (Path.refl x.1) := by
  -- Rewrite the Chapter 8 basepoint to its explicit point-and-path representative.
  rw [underTopBasepoint_homotopyFiber]
  -- Both sides are now the constant endpoint `x` together with the constant path at `x.1`.
  rfl

/-- Under `inclusionFiberEquivPathToSet A x`, the distinguished point of the fiber term `F_i`
corresponds to the constant path `PathToSet.refl x`. -/
theorem inclusionFiberEquivPathToSet_basepoint (A : Set X) (x : A) :
    inclusionFiberEquivPathToSet A x
        (underTopBasepoint (homotopyFiber (inclusionBasedMap A x))) =
      PathToSet.refl x := by
  have hbase :
      inclusionFiberToInclusionHomotopyFiber A x
          (HomotopyFiber.basepoint (inclusionBasedMap A x)) =
        inclusionHomotopyFiber.mk x (Path.refl x.1) := by
    -- Rewrite the based-space basepoint to the explicit Chapter 8 homotopy-fiber basepoint.
    simpa [underTopBasepoint_homotopyFiber] using
      inclusionFiberToInclusionHomotopyFiber_basepoint A x
  -- Unfold the composite equivalence and then normalize its modeled-fiber input.
  rw [inclusionFiberEquivPathToSet, Equiv.trans_apply]
  rw [underTopBasepoint_homotopyFiber]
  change
    inclusionHomotopyFiberHomeomorphPathToSet A x
      (inclusionFiberToInclusionHomotopyFiber A x
        (HomotopyFiber.basepoint (inclusionBasedMap A x))) =
      PathToSet.refl x
  rw [inclusionHomotopyFiberHomeomorphPathToSet_apply]
  rw [hbase]
  -- The Chapter 9 model sends the constant endpoint-plus-path data to `PathToSet.refl x`.
  rfl

/-- Stage `3` of `inclusionFiberSequence A x` is the loop space `Ω X`. -/
@[simp] theorem inclusionFiberSequence_obj_three (A : Set X) (x : A) :
    (inclusionFiberSequence A x).obj 3 = Ωᵇ (inclusionAmbientSpace x) :=
  rfl

/-- Stage `4` of `inclusionFiberSequence A x` is the loop space `Ω A`. -/
@[simp] theorem inclusionFiberSequence_obj_four (A : Set X) (x : A) :
    (inclusionFiberSequence A x).obj 4 = Ωᵇ (inclusionBasedSubspace A x) :=
  rfl

/-- The rightmost map of `inclusionFiberSequence A x` is the inclusion `A ↪ X`. -/
@[simp] theorem inclusionFiberSequence_map_zero (A : Set X) (x : A) :
    (inclusionFiberSequence A x).map 0 = inclusionBasedMap A x :=
  rfl

/-- The next map of `inclusionFiberSequence A x` is the projection `F_i ⟶ A`. -/
@[simp] theorem inclusionFiberSequence_map_one (A : Set X) (x : A) :
    (inclusionFiberSequence A x).map 1 = homotopyFiberProjection (inclusionBasedMap A x) :=
  rfl

/-- The map `Ω X ⟶ F_i` in `inclusionFiberSequence A x` is the canonical loop inclusion into the
homotopy fiber of `A ↪ X`. -/
@[simp] theorem inclusionFiberSequence_map_two (A : Set X) (x : A) :
    (inclusionFiberSequence A x).map 2 = homotopyFiberLoopInclusion (inclusionBasedMap A x) :=
  rfl

/-- The map `Ω A ⟶ Ω X` in `inclusionFiberSequence A x` is the signed loop map induced by the
inclusion `A ↪ X`. -/
@[simp] theorem inclusionFiberSequence_map_three (A : Set X) (x : A) :
    (inclusionFiberSequence A x).map 3 = signedLoopBasedMap (inclusionBasedMap A x) :=
  rfl
