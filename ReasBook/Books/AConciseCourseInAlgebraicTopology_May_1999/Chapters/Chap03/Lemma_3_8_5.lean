import Mathlib.Topology.Homeomorph.Lemmas
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap03.Construction_3_8_4

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Path.Homotopic.Quotient
open TopologicalSpace
open TopologicalSpace.OpenNhdsOf
open scoped UniversalCover

variable {B : Type u} [TopologicalSpace B]
variable {b : B}

/-- The endpoint projection restricted to a universal-cover basic set. -/
def universalCoverCandidateBasicSet_projectionToNeighborhood
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1) :
    {r // r ∈ U[q]} → U
  | ⟨r, hr⟩ => ⟨r.1, universalCoverCandidateBasicSet_endpoint_mem q U hr⟩

@[simp] theorem universalCoverCandidateBasicSet_projectionToNeighborhood_apply
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (r : {r // r ∈ U[q]}) :
    (universalCoverCandidateBasicSet_projectionToNeighborhood q U r : B) = r.1.1 := by
  cases r
  rfl

/-- Helper for Lemma 3.8.5: the ambient endpoint projection on the universal-cover candidate is
continuous for the topology generated by the standard basic sheets. -/
private theorem universalCoverCandidate_projection_continuous
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B] :
    Continuous (fun r : universalCoverCandidate b ↦ r.1) := by
  let hBasis := universalCoverCandidateBasicSets_isTopologicalBasis b
  rw [continuous_def]
  intro N hN
  rw [hBasis.isOpen_iff]
  intro r hr
  let Nnhd : OpenNhdsOf r.1 := ⟨⟨N, hN⟩, hr⟩
  rcases exists_suitable_universal_cover_neighborhood_subset r.1 Nnhd with
    ⟨V, hVN, hV⟩
  refine ⟨V[r], ?_, ?_, ?_⟩
  · -- Suitable basic sheets are basis elements by construction.
    exact ⟨r, V, hV, rfl⟩
  · -- The center point belongs to its own basic sheet via the constant path.
    exact universalCoverCandidateBasicSet_self_mem r V
  · -- Any point of the smaller sheet projects into the prescribed ambient neighborhood.
    intro s hs
    exact hVN (universalCoverCandidateBasicSet_endpoint_mem r V hs)

/-- Helper for Lemma 3.8.5: the restricted endpoint projection on a suitable basic sheet is
injective because the induced fundamental-group map of `U ↪ B` is trivial. -/
private theorem universalCoverCandidateBasicSet_projectionToNeighborhood_injective
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (hU : U.IsSuitableForUniversalCover) :
    Function.Injective (universalCoverCandidateBasicSet_projectionToNeighborhood q U) := by
  intro x y hxy
  rcases x with ⟨x, hx⟩
  rcases y with ⟨y, hy⟩
  rcases hx with ⟨ux, cx, rfl⟩
  rcases hy with ⟨uy, cy, rfl⟩
  have huy : ux = uy := by
    apply Subtype.ext
    exact congrArg (fun u : U ↦ (u : B)) hxy
  subst huy
  apply Subtype.ext
  -- Once the endpoints agree, trivial monodromy in `U` identifies the two lifted path classes.
  exact universalCoverCandidate_pathClass_eq_of_paths q U hU.2 ux cx cy

/-- Helper for Lemma 3.8.5: path connectedness of `U` gives a point of the basic sheet over every
endpoint in `U`. -/
private theorem universalCoverCandidateBasicSet_projectionToNeighborhood_surjectiveAux
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (hU : U.IsSuitableForUniversalCover) :
    Function.Surjective (universalCoverCandidateBasicSet_projectionToNeighborhood q U) := by
  intro u
  let c : Path ⟨q.1, U.mem⟩ u := (hU.1.joinedIn q.1 U.mem u.1 u.2).joined_subtype.somePath
  let r : universalCoverCandidate b := ⟨u.1, q.2.trans ((mk c).map U.subtypeVal)⟩
  have hr : r ∈ U[q] := universalCoverCandidateBasicSet_pathClass_mem q U u c
  refine ⟨⟨r, hr⟩, ?_⟩
  -- The constructed sheet point projects back to the chosen endpoint.
  apply Subtype.ext
  rfl

/-- Helper for Lemma 3.8.5: the ambient endpoint projection is an open map because every basis
sheet projects surjectively onto its indexing neighborhood. -/
private theorem universalCoverCandidate_projection_isOpenMap
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B] :
    IsOpenMap (fun r : universalCoverCandidate b ↦ r.1) := by
  let hBasis := universalCoverCandidateBasicSets_isTopologicalBasis b
  intro s hs
  rw [hBasis.isOpen_iff] at hs
  rw [isOpen_iff_mem_nhds]
  intro y hy
  rcases hy with ⟨r, hrs, rfl⟩
  rcases hs r hrs with ⟨t, ht, hrt, hts⟩
  rcases ht with ⟨q, U, hU, rfl⟩
  refine mem_nhds_iff.mpr ⟨U, ?_, U.isOpen, ?_⟩
  · intro z hz
    rcases
        universalCoverCandidateBasicSet_projectionToNeighborhood_surjectiveAux q U hU ⟨z, hz⟩ with
      ⟨x, hx⟩
    refine ⟨x.1, hts x.2, ?_⟩
    -- Surjectivity on the smaller basic sheet upgrades membership of `z` to membership in
    -- the image of the ambient open set.
    simpa [universalCoverCandidateBasicSet_projectionToNeighborhood_apply] using
      congrArg (fun u : U ↦ (u : B)) hx
  · -- The original image point lies in the indexing neighborhood of the chosen basis sheet.
    exact universalCoverCandidateBasicSet_endpoint_mem q U hrt

/-- Lemma 3.8.5: for a suitable basic set `U[f]`, the endpoint projection restricts to an open
embedding onto `U`; equivalently, the explicit restricted endpoint map is a homeomorphism onto
`U`. -/
-- Proof sketch: surjectivity follows from path connectedness of `U`, since every `u : U` is
-- joined to the endpoint of `q` by a path producing a point of the basic set above `u`.
-- Injectivity comes from `universalCoverCandidate_pathClass_eq_of_paths`, using that the
-- inclusion `U ↪ B` kills based loops. Openness and continuity are checked on the basis
-- `universalCoverCandidateBasicSets b`, so the restricted endpoint map is a homeomorphism onto
-- `U`.
theorem universalCoverCandidateBasicSet_projectionToNeighborhood_homeomorphic
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (hU : U.IsSuitableForUniversalCover) :
    IsHomeomorph (universalCoverCandidateBasicSet_projectionToNeighborhood q U) := by
  have hAmbientContinuous : Continuous (fun r : universalCoverCandidate b ↦ r.1) :=
    universalCoverCandidate_projection_continuous (b := b)
  have hSheetOpen : IsOpen (U[q]) := by
    -- Suitable basic sheets are open because they are members of the generating basis.
    exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨q, U, hU, rfl⟩
  have hContinuous :
      Continuous (universalCoverCandidateBasicSet_projectionToNeighborhood q U) := by
    -- The restricted map is the ambient endpoint projection, followed by codomain restriction to
    -- the open neighborhood `U`.
    simpa [universalCoverCandidateBasicSet_projectionToNeighborhood] using
      Continuous.subtype_mk
        (hAmbientContinuous.comp continuous_subtype_val)
        (fun r : {r // r ∈ U[q]} ↦ universalCoverCandidateBasicSet_endpoint_mem q U r.2)
  have hAmbientOpen : IsOpenMap (fun r : universalCoverCandidate b ↦ r.1) :=
    universalCoverCandidate_projection_isOpenMap (b := b)
  have hRestrictedOpen : IsOpenMap (fun r : {r // r ∈ U[q]} ↦ r.1.1) := by
    -- Restrict the ambient open map to the open sheet `U[q]`.
    simpa using hAmbientOpen.restrict hSheetOpen
  have hOpen :
      IsOpenMap (universalCoverCandidateBasicSet_projectionToNeighborhood q U) := by
    -- Codomain restriction packages the image inside `U` without changing openness.
    simpa [universalCoverCandidateBasicSet_projectionToNeighborhood] using
      IsOpenMap.subtype_mk hRestrictedOpen
        (fun r : {r // r ∈ U[q]} ↦ universalCoverCandidateBasicSet_endpoint_mem q U r.2)
  have hInjective :
      Function.Injective (universalCoverCandidateBasicSet_projectionToNeighborhood q U) :=
    universalCoverCandidateBasicSet_projectionToNeighborhood_injective q U hU
  have hSurjective :
      Function.Surjective (universalCoverCandidateBasicSet_projectionToNeighborhood q U) :=
    universalCoverCandidateBasicSet_projectionToNeighborhood_surjectiveAux q U hU
  -- Continuous, open, and bijective gives the required homeomorphism onto `U`.
  exact ⟨hContinuous, hOpen, ⟨hInjective, hSurjective⟩⟩

/-- The restricted endpoint projection on a suitable universal-cover basic set is surjective onto
its indexing neighborhood. -/
theorem universalCoverCandidateBasicSet_projectionToNeighborhood_surjective
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (hU : U.IsSuitableForUniversalCover) :
    Function.Surjective (universalCoverCandidateBasicSet_projectionToNeighborhood q U) :=
  (universalCoverCandidateBasicSet_projectionToNeighborhood_homeomorphic q U hU).surjective

/-- The restricted endpoint projection on a suitable universal-cover basic set is an open
embedding. -/
theorem universalCoverCandidateBasicSet_projectionToNeighborhood_isOpenEmbedding
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (hU : U.IsSuitableForUniversalCover) :
    Topology.IsOpenEmbedding (universalCoverCandidateBasicSet_projectionToNeighborhood q U) :=
  (universalCoverCandidateBasicSet_projectionToNeighborhood_homeomorphic q U hU).isOpenEmbedding

/-- On a suitable universal-cover basic set, the endpoint map is surjective onto the indexing open
neighborhood. -/
theorem universalCoverCandidateBasicSet_endpoint_surjOn
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (hU : U.IsSuitableForUniversalCover) :
    U[q].SurjOn (fun r : universalCoverCandidate b ↦ r.1) U := by
  intro y hy
  rcases
      universalCoverCandidateBasicSet_projectionToNeighborhood_surjective q U hU ⟨y, hy⟩ with
    ⟨r, hr⟩
  refine ⟨r.1, r.2, ?_⟩
  exact congrArg (fun u : U ↦ (u : B)) hr

/-- The endpoint projection on the universal-cover candidate is an open map, because suitable
basic sheets project homeomorphically onto their indexing neighborhoods. -/
theorem universalCoverCandidate_endpoint_isOpenMap
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B] (b : B) :
    IsOpenMap (fun q : universalCoverCandidate b ↦ q.1) := by
  let hBasis := universalCoverCandidateBasicSets_isTopologicalBasis b
  intro s hs
  rw [hBasis.isOpen_iff] at hs
  rw [isOpen_iff_mem_nhds]
  intro y hy
  rcases hy with ⟨r, hrs, rfl⟩
  rcases hs r hrs with ⟨t, ht, hrt, hts⟩
  rcases ht with ⟨q, U, hU, rfl⟩
  refine mem_nhds_iff.mpr ⟨U, ?_, U.isOpen, ?_⟩
  · intro z hz
    rcases universalCoverCandidateBasicSet_endpoint_surjOn q U hU hz with ⟨x, hxBasic, hpx⟩
    exact ⟨x, hts hxBasic, hpx⟩
  · exact universalCoverCandidateBasicSet_endpoint_mem q U hrt

/-- A suitable universal-cover basic set is path connected because it is homeomorphic to its
indexing neighborhood. -/
instance instPathConnectedSpace_universalCoverCandidateBasicSet
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (hU : U.IsSuitableForUniversalCover) :
    PathConnectedSpace {r // r ∈ U[q]} := by
  let _ : PathConnectedSpace U := (isPathConnected_iff_pathConnectedSpace).mp hU.1
  let e :=
    (universalCoverCandidateBasicSet_projectionToNeighborhood_homeomorphic q U hU).homeomorph
      (universalCoverCandidateBasicSet_projectionToNeighborhood q U)
  have hsurj : Function.Surjective e.symm := e.symm.surjective
  exact hsurj.pathConnectedSpace e.symm.continuous

/-- The basic neighborhood `U[q]` determined by a suitable universal-cover neighborhood is path
connected. -/
theorem universalCoverCandidateBasicSet_isPathConnected
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (hU : U.IsSuitableForUniversalCover) :
    IsPathConnected (U[q]) := by
  exact (isPathConnected_iff_pathConnectedSpace).2
    (instPathConnectedSpace_universalCoverCandidateBasicSet q U hU)
