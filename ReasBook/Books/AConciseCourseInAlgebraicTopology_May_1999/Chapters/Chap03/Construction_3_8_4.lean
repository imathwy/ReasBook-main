import Mathlib.Topology.Bases
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap01.Lemma_1_4_2
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap03.Construction_3_8_3
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap03.Definition_3_8_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Path.Homotopic.Quotient
open TopologicalSpace
open TopologicalSpace.OpenNhdsOf

variable {B : Type u} [TopologicalSpace B]

namespace TopologicalSpace.OpenNhdsOf

variable {x : B}

/-- A suitable neighborhood for the universal-cover construction is an open neighborhood that is
path connected and whose inclusion induces the trivial map on the based fundamental group. -/
def IsSuitableForUniversalCover (U : OpenNhdsOf x) : Prop :=
  IsPathConnected (U : Set B) ∧
    FundamentalGroup.map U.subtypeVal ⟨x, U.mem⟩ = 1

end TopologicalSpace.OpenNhdsOf

variable {b : B}

/-- Construction 3.8.4: for a point `q` of the universal-cover candidate over `b` and a suitable
path-connected open neighborhood `U` of its endpoint, the basic neighborhood `U[q]` is the set of
endpoint-fixed homotopy classes obtained by concatenating `q` with paths in `U` starting at the
endpoint of `q`. -/
def universalCoverCandidateBasicSet (q : universalCoverCandidate b)
    (U : OpenNhdsOf q.1) : Set (universalCoverCandidate b) :=
  { r | ∃ y : U, ∃ c : Path ⟨q.1, U.mem⟩ y,
      r = ⟨y.1, q.2.trans ((mk c).map U.subtypeVal)⟩ }

/- The source-facing notation for the universal-cover basic neighborhood determined by `q`. -/
namespace UniversalCover

scoped notation U "[" q "]" => universalCoverCandidateBasicSet q U

end UniversalCover

open scoped UniversalCover

/-- The family of basic sets used to topologize the universal-cover candidate. -/
def universalCoverCandidateBasicSets (b : B) : Set (Set (universalCoverCandidate b)) :=
  { s | ∃ q : universalCoverCandidate b,
      ∃ U : OpenNhdsOf q.1,
        U.IsSuitableForUniversalCover ∧
          s = U[q] }

/-- The universal-cover candidate is equipped with the topology generated by its standard basic
sets. -/
instance universalCoverCandidateTopologicalSpace (b : B) :
    TopologicalSpace (universalCoverCandidate b) :=
  TopologicalSpace.generateFrom (universalCoverCandidateBasicSets b)

/-- Helper for Construction 3.8.4: every point has a suitable neighborhood for the universal-cover
construction. -/
theorem exists_suitable_universal_cover_neighborhood
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B] (x : B) :
    ∃ U : OpenNhdsOf x, U.IsSuitableForUniversalCover := by
  rcases
      SemilocallySimplyConnectedSpace.exists_openNhdsOf_trivial_fundamentalGroup_map
        x with
    ⟨U, hUtriv⟩
  let Vset : Set B := pathComponentIn (U : Set B) x
  have hVmem : x ∈ Vset := mem_pathComponentIn_self U.mem
  have hVopen : IsOpen Vset := U.isOpen.pathComponentIn x
  have hVpath : IsPathConnected Vset := isPathConnected_pathComponentIn U.mem
  let V : OpenNhdsOf x := ⟨⟨Vset, hVopen⟩, hVmem⟩
  have hVsubsetU : (V : Set B) ⊆ U := pathComponentIn_subset
  let iVU : C(V, U) :=
    ⟨fun v ↦ ⟨v.1, hVsubsetU v.2⟩, continuous_subtype_val.subtype_mk fun v ↦ hVsubsetU v.2⟩
  have hSubtypeComp : U.subtypeVal.comp iVU = V.subtypeVal := by
    -- Both maps are the ambient inclusion of the smaller path component.
    ext v
    rfl
  have hVtriv :
      FundamentalGroup.map V.subtypeVal ⟨x, V.mem⟩ =
        (FundamentalGroup.map U.subtypeVal ⟨x, U.mem⟩).comp
          (FundamentalGroup.map iVU ⟨x, V.mem⟩) := by
    -- The smaller inclusion factors through the original semilocally simply connected neighborhood.
    simpa [hSubtypeComp] using fundamental_group_map_comp iVU
      U.subtypeVal ⟨x, V.mem⟩
  refine ⟨V, ?_⟩
  constructor
  · -- By construction `V` is the path component of `x` inside `U`.
    exact hVpath
  · -- Triviality of the induced map descends along the inclusion `V ↪ U`.
    calc
      FundamentalGroup.map V.subtypeVal ⟨x, V.mem⟩ =
          (FundamentalGroup.map U.subtypeVal ⟨x, U.mem⟩).comp
            (FundamentalGroup.map iVU ⟨x, V.mem⟩) := hVtriv
      _ = 1 := by
        rw [hUtriv]
        simp

/-- Helper for Construction 3.8.4: a suitable neighborhood can be shrunk inside any prescribed
open neighborhood of the same point. -/
theorem exists_suitable_universal_cover_neighborhood_subset
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B] (x : B)
    (N : OpenNhdsOf x) :
    ∃ U : OpenNhdsOf x, (∀ ⦃y : B⦄, y ∈ U → y ∈ N) ∧ U.IsSuitableForUniversalCover := by
  rcases exists_suitable_universal_cover_neighborhood x with ⟨U₀, hU₀⟩
  let Iset : Set B := (U₀ : Set B) ∩ (N : Set B)
  have hImem : x ∈ Iset := ⟨U₀.mem, N.mem⟩
  have hIopen : IsOpen Iset := U₀.isOpen.inter N.isOpen
  let Vset : Set B := pathComponentIn Iset x
  have hVmem : x ∈ Vset := mem_pathComponentIn_self hImem
  have hVopen : IsOpen Vset := hIopen.pathComponentIn x
  have hVpath : IsPathConnected Vset := isPathConnected_pathComponentIn hImem
  let V : OpenNhdsOf x := ⟨⟨Vset, hVopen⟩, hVmem⟩
  have hVsubsetI : (V : Set B) ⊆ Iset := pathComponentIn_subset
  have hVsubsetU₀ : (V : Set B) ⊆ U₀ := fun y hy ↦ (hVsubsetI hy).1
  let i : C(V, U₀) :=
    ⟨fun y ↦ ⟨y.1, hVsubsetU₀ y.2⟩,
      continuous_subtype_val.subtype_mk fun y ↦ hVsubsetU₀ y.2⟩
  have hcomp : U₀.subtypeVal.comp i = V.subtypeVal := by
    -- The inclusion `V ↪ B` factors through `U₀`.
    ext y
    rfl
  have hVtriv :
      FundamentalGroup.map V.subtypeVal ⟨x, V.mem⟩ =
        (FundamentalGroup.map U₀.subtypeVal ⟨x, U₀.mem⟩).comp
          (FundamentalGroup.map i ⟨x, V.mem⟩) := by
    -- The smaller path component still maps through the original suitable neighborhood.
    simpa [hcomp] using fundamental_group_map_comp i
      U₀.subtypeVal ⟨x, V.mem⟩
  refine ⟨V, fun y hy ↦ (hVsubsetI hy).2, ?_⟩
  constructor
  · -- This neighborhood is path connected by construction as a path component.
    exact hVpath
  · -- Trivial monodromy persists after shrinking inside `U₀`.
    calc
      FundamentalGroup.map V.subtypeVal ⟨x, V.mem⟩ =
          (FundamentalGroup.map U₀.subtypeVal ⟨x, U₀.mem⟩).comp
            (FundamentalGroup.map i ⟨x, V.mem⟩) := hVtriv
      _ = 1 := by
        rw [hU₀.2]
        simp

/-- Helper for Construction 3.8.4: any point of a basic neighborhood projects to the indexing
open set. -/
theorem universalCoverCandidateBasicSet_endpoint_mem
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    {r : universalCoverCandidate b} (hr : r ∈ U[q]) :
    r.1 ∈ U := by
  rcases hr with ⟨y, c, rfl⟩
  -- The endpoint is exactly the witness `y : U` used in the definition of `U[q]`.
  exact y.2

/-- Helper for Construction 3.8.4: every point belongs to the basic set indexed by itself. -/
theorem universalCoverCandidateBasicSet_self_mem
    (r : universalCoverCandidate b) (U : OpenNhdsOf r.1) :
    r ∈ U[r] := by
  let i : C(U, B) := U.subtypeVal
  refine ⟨⟨r.1, U.mem⟩, Path.refl _, ?_⟩
  cases r with
  | mk x γ =>
      -- Route correction: use the constant path directly, so the second component reduces by
      -- `trans_refl` instead of introducing any extra path-class comparison machinery.
      change (⟨x, γ⟩ : universalCoverCandidate b) =
        ⟨x, γ.trans ((mk (Path.refl ⟨x, U.mem⟩)).map i)⟩
      have hmap : ((mk (Path.refl ⟨x, U.mem⟩)).map i) = refl x := rfl
      rw [hmap]
      exact (congrArg
        (fun δ : Path.Homotopic.Quotient b x ↦ (⟨x, δ⟩ : universalCoverCandidate b))
        (trans_refl γ)).symm

/-- Helper for Construction 3.8.4: the path class obtained by extending `q` along a path in `U`
lies in the basic neighborhood `U[q]`. -/
theorem universalCoverCandidateBasicSet_pathClass_mem
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (u : U) (c : Path ⟨q.1, U.mem⟩ u) :
    (⟨u.1, q.2.trans ((mk c).map U.subtypeVal)⟩ : universalCoverCandidate b) ∈ U[q] := by
  exact ⟨u, c, rfl⟩

/-- Helper for Construction 3.8.4: in a suitable neighborhood, the endpoint-fixed homotopy class
obtained by extending `q` to a chosen endpoint does not depend on the chosen path. -/
theorem universalCoverCandidate_pathClass_eq_of_paths
    (q : universalCoverCandidate b) (U : OpenNhdsOf q.1)
    (htriv : FundamentalGroup.map U.subtypeVal ⟨q.1, U.mem⟩ = 1)
    (u : U) (c₁ c₂ : Path ⟨q.1, U.mem⟩ u) :
    (⟨u.1, q.2.trans ((mk c₁).map U.subtypeVal)⟩ : universalCoverCandidate b) =
      ⟨u.1, q.2.trans ((mk c₂).map U.subtypeVal)⟩ := by
  have hloop :
      ((mk c₁).map U.subtypeVal).trans (((mk c₂).map U.subtypeVal).symm) = refl q.1 := by
    have hloopMap :=
      congrArg
        (fun φ : FundamentalGroup U ⟨q.1, U.mem⟩ →* FundamentalGroup B q.1 ↦
          φ (FundamentalGroup.fromPath (mk (c₁.trans c₂.symm))))
        htriv
    have hloopMap' := hloopMap
    change (((mk c₁).trans (mk c₂).symm).map U.subtypeVal :
        Path.Homotopic.Quotient q.1 q.1) = refl q.1 at hloopMap'
    -- The suitable-neighborhood hypothesis kills the loop obtained by following `c₁`
    -- and returning along `c₂`.
    have hmapTrans :
        (((mk c₁).trans (mk c₂).symm).map U.subtypeVal) =
          ((mk c₁).map U.subtypeVal).trans (((mk c₂).map U.subtypeVal).symm) := by
      -- Mapping the concatenated loop agrees with concatenating the mapped path classes.
      calc
        (((mk c₁).trans (mk c₂).symm).map U.subtypeVal) =
            mk ((c₁.trans c₂.symm).map U.subtypeVal.continuous) := by
              rw [← mk_symm, ← mk_trans, ← mk_map]
        _ = mk ((c₁.map U.subtypeVal.continuous).trans (c₂.map U.subtypeVal.continuous).symm) := by
              congr
              rw [Path.map_symm]
              exact Path.map_trans c₁ c₂.symm U.subtypeVal.continuous
        _ = ((mk c₁).map U.subtypeVal).trans (((mk c₂).map U.subtypeVal).symm) := by
              rw [mk_trans, mk_symm, mk_map, mk_map]
    calc
      ((mk c₁).map U.subtypeVal).trans (((mk c₂).map U.subtypeVal).symm) =
          (((mk c₁).trans (mk c₂).symm).map U.subtypeVal) := hmapTrans.symm
      _ = Path.Homotopic.Quotient.refl q.1 := hloopMap'
  have hpaths :
      (mk c₁).map U.subtypeVal = (mk c₂).map U.subtypeVal := by
    -- Cancelling the common suffix turns the null-homotopic loop into equality of path classes.
    calc
      (mk c₁).map U.subtypeVal =
          (((mk c₁).map U.subtypeVal).trans (((mk c₂).map U.subtypeVal).symm)).trans
            ((mk c₂).map U.subtypeVal) := by
            rw [trans_assoc, symm_trans, trans_refl]
      _ = (Path.Homotopic.Quotient.refl q.1).trans ((mk c₂).map U.subtypeVal) := by rw [hloop]
      _ = (mk c₂).map U.subtypeVal := by rw [refl_trans]
  -- Extending `q` by either path to `u` now gives the same point in the sigma model.
  exact congrArg
    (fun δ : Path.Homotopic.Quotient q.1 u.1 ↦
      (⟨u.1, q.2.trans δ⟩ : universalCoverCandidate b))
    hpaths

/-- Helper for Construction 3.8.4: transporting a path in `W` to `U` and then including in `B`
agrees with including it from `W` directly. -/
private theorem universal_cover_candidate_subtype_pathClass_map
    {x : B} {U : OpenNhdsOf x} {u : U} {W : OpenNhdsOf u.1}
    (hWU : (W : Set B) ⊆ U) {z : W} (d : Path ⟨u.1, W.mem⟩ z) :
    let i : C(W, U) :=
      ⟨fun y ↦ ⟨y.1, hWU y.2⟩, continuous_subtype_val.subtype_mk fun y ↦ hWU y.2⟩
    let iU : C(U, B) := U.subtypeVal
    let iW : C(W, B) := W.subtypeVal
    let zU : U := ⟨z.1, hWU z.2⟩
    let dU : Path u zU := (d.map i.continuous).cast (by
      apply Subtype.ext
      rfl) rfl
    ((mk d).map iW) = ((mk dU).map iU) := by
  let i : C(W, U) :=
    ⟨fun y ↦ ⟨y.1, hWU y.2⟩, continuous_subtype_val.subtype_mk fun y ↦ hWU y.2⟩
  let iU : C(U, B) := U.subtypeVal
  let iW : C(W, B) := W.subtypeVal
  let zU : U := ⟨z.1, hWU z.2⟩
  let dU : Path u zU := (d.map i.continuous).cast (by
    apply Subtype.ext
    rfl) rfl
  have hdPath : d.map iW.continuous = dU.map iU.continuous := by
    ext t
    rfl
  simpa [dU] using congrArg mk hdPath

/-- Helper for Construction 3.8.4: mapping a concatenated path into `B` agrees with concatenating
the mapped path classes. -/
private theorem universal_cover_candidate_subtype_pathClass_trans
    {x : B} {U : OpenNhdsOf x} {u z : U}
    (c : Path ⟨x, U.mem⟩ u) (d : Path ⟨u.1, u.2⟩ z) :
    (((mk c).map U.subtypeVal).trans ((mk d).map U.subtypeVal)) =
      ((mk (c.trans d)).map U.subtypeVal) := by
  rw [← mk_map, ← mk_map, ← mk_trans, ← mk_map]
  simp [Path.map_trans]

/-- Helper for Construction 3.8.4: the sigma-point associated to path-class concatenation is
compatible with `Path.Homotopic.Quotient.trans_assoc`. -/
private theorem universal_cover_candidate_sigma_trans_assoc
    {x y z : B} (γ : Path.Homotopic.Quotient b x)
    (α : Path.Homotopic.Quotient x y) (β : Path.Homotopic.Quotient y z) :
    (⟨z, (γ.trans α).trans β⟩ : universalCoverCandidate b) =
      ⟨z, γ.trans (α.trans β)⟩ := by
  exact congrArg
    (fun δ : Path.Homotopic.Quotient b z ↦ (⟨z, δ⟩ : universalCoverCandidate b))
    (trans_assoc γ α β)

/-- Helper for Construction 3.8.4: concatenation in the right factor respects equality. -/
private theorem universal_cover_candidate_pathClass_trans_congr
    {x y z : B} (α : Path.Homotopic.Quotient x y)
    {β β' : Path.Homotopic.Quotient y z} (h : β = β') :
    α.trans β = α.trans β' := by
  exact congrArg (fun γ : Path.Homotopic.Quotient y z ↦ α.trans γ) h

/-- Helper for Construction 3.8.4: translating a path-class equality into the sigma-model point
equality only changes the second component. -/
private theorem universal_cover_candidate_sigma_trans_congr
    {x z : B} (γ : Path.Homotopic.Quotient b x)
    {α α' : Path.Homotopic.Quotient x z} (h : α = α') :
    (⟨z, γ.trans α⟩ : universalCoverCandidate b) =
      ⟨z, γ.trans α'⟩ := by
  exact congrArg
    (fun δ : Path.Homotopic.Quotient x z ↦ (⟨z, γ.trans δ⟩ : universalCoverCandidate b))
    h

/-- Helper for Construction 3.8.4: after transporting a path in `W` into `U`, concatenation with
the original `U`-path is compatible with the induced path class in `B`. -/
private theorem universal_cover_candidate_basic_set_inner_eq
    {x : B} {U : OpenNhdsOf x} {u : U} {W : OpenNhdsOf u.1}
    (hWU : (W : Set B) ⊆ U) {z : W}
    (c : Path ⟨x, U.mem⟩ u) (d : Path ⟨u.1, W.mem⟩ z) :
    let i : C(W, U) :=
      ⟨fun y ↦ ⟨y.1, hWU y.2⟩, continuous_subtype_val.subtype_mk fun y ↦ hWU y.2⟩
    let iU : C(U, B) := U.subtypeVal
    let iW : C(W, B) := W.subtypeVal
    let zU : U := ⟨z.1, hWU z.2⟩
    let dU : Path u zU := (d.map i.continuous).cast (by
      apply Subtype.ext
      rfl) rfl
    (((mk c).map iU).trans ((mk d).map iW)) = ((mk (c.trans dU)).map iU) := by
  dsimp
  -- First rewrite the `W`-path as the same path transported into `U`.
  rw [universal_cover_candidate_subtype_pathClass_map hWU d]
  -- Then collapse the two-step concatenation into one mapped path class.
  exact universal_cover_candidate_subtype_pathClass_trans c _

/-- Helper for Construction 3.8.4: the witness produced by concatenating the two paths defines the
same point of the universal-cover candidate as the original two-step construction. -/
private theorem universal_cover_candidate_basic_set_sigma_eq
    {q : universalCoverCandidate b} {U : OpenNhdsOf q.1} {u : U} {W : OpenNhdsOf u.1}
    (hWU : (W : Set B) ⊆ U) {z : W}
    (c : Path ⟨q.1, U.mem⟩ u) (d : Path ⟨u.1, W.mem⟩ z) :
    let i : C(W, U) :=
      ⟨fun y ↦ ⟨y.1, hWU y.2⟩, continuous_subtype_val.subtype_mk fun y ↦ hWU y.2⟩
    let iU : C(U, B) := U.subtypeVal
    let iW : C(W, B) := W.subtypeVal
    let zU : U := ⟨z.1, hWU z.2⟩
    let dU : Path u zU := (d.map i.continuous).cast (by
      apply Subtype.ext
      rfl) rfl
    (⟨z.1, (q.2.trans ((mk c).map iU)).trans ((mk d).map iW)⟩ : universalCoverCandidate b) =
      ⟨z.1, q.2.trans ((mk (c.trans dU)).map iU)⟩ := by
  dsimp
  -- Reassociate so the inner concatenation is the right factor of `q.2`.
  rw [universal_cover_candidate_sigma_trans_assoc]
  -- The inner path-class normalization now upgrades directly to equality in the sigma model.
  exact universal_cover_candidate_sigma_trans_congr q.2
    (universal_cover_candidate_basic_set_inner_eq hWU c d)

/-- Helper for Construction 3.8.4: a smaller basic sheet through a point of `U[q]` still lies in
`U[q]` whenever the smaller neighborhood is contained in `U`. -/
theorem universal_cover_candidate_basic_set_subset_of_mem
    {q r : universalCoverCandidate b} (U : OpenNhdsOf q.1) (hr : r ∈ U[q])
    {W : OpenNhdsOf r.1} (hWU : ∀ ⦃x : B⦄, x ∈ W → x ∈ U) :
    universalCoverCandidateBasicSet r W ⊆ universalCoverCandidateBasicSet q U := by
  rcases hr with ⟨u, c, rfl⟩
  intro t ht
  rcases ht with ⟨z, d, rfl⟩
  let i : C(W, U) :=
    ⟨fun y ↦ ⟨y.1, hWU y.2⟩, continuous_subtype_val.subtype_mk fun y ↦ hWU y.2⟩
  let iU : C(U, B) := U.subtypeVal
  let zU : U := ⟨z.1, hWU z.2⟩
  let dU : Path u zU := (d.map i.continuous).cast (by
    apply Subtype.ext
    rfl) rfl
  refine ⟨zU, c.trans dU, ?_⟩
  simpa [i, iU, zU, dU] using
    universal_cover_candidate_basic_set_sigma_eq hWU c d

/-- Helper for Construction 3.8.4: intersections of two suitable basic neighborhoods refine to a
smaller suitable basic neighborhood through the common point. -/
private theorem universal_cover_candidate_basic_set_intersection_refines
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B]
    {q r s : universalCoverCandidate b}
    (U : OpenNhdsOf q.1) (V : OpenNhdsOf s.1)
    (hrU : r ∈ U[q]) (hrV : r ∈ V[s]) :
    ∃ W : OpenNhdsOf r.1, (∀ ⦃x : B⦄, x ∈ W → x ∈ U ∧ x ∈ V) ∧
      W.IsSuitableForUniversalCover ∧
        universalCoverCandidateBasicSet r W ⊆ U[q] ∩ V[s] := by
  let I₀ : OpenNhdsOf r.1 :=
    ⟨⟨(U : Set B) ∩ (V : Set B), U.isOpen.inter V.isOpen⟩,
      ⟨universalCoverCandidateBasicSet_endpoint_mem q U hrU,
        universalCoverCandidateBasicSet_endpoint_mem s V hrV⟩⟩
  rcases exists_suitable_universal_cover_neighborhood_subset r.1 I₀ with
    ⟨W, hWsubset, hW⟩
  refine ⟨W, hWsubset, hW, ?_⟩
  intro t ht
  constructor
  · -- Since `W ⊆ U`, any point of the smaller `W`-sheet remains in `U[q]`.
    exact
      universal_cover_candidate_basic_set_subset_of_mem
        U hrU
        (fun x hx ↦ (hWsubset hx).1) ht
  · -- The same argument with `V` shows the refined sheet also stays in `V[s]`.
    exact
      universal_cover_candidate_basic_set_subset_of_mem
        V hrV
        (fun x hx ↦ (hWsubset hx).2) ht

/-- The standard basic sets on the universal-cover candidate form a topological basis, under the
local hypotheses from May's universal-cover construction. -/
-- Proof sketch: local path connectedness and semilocal simple connectedness give arbitrarily small
-- suitable neighborhoods. These supply both the cover of `universalCoverCandidate b` and the
-- refinement of intersections by a third basic set through any common point.
theorem universalCoverCandidateBasicSets_isTopologicalBasis
    [LocPathConnectedSpace B] [SemilocallySimplyConnectedSpace B] (b : B) :
    TopologicalSpace.IsTopologicalBasis (universalCoverCandidateBasicSets b) := by
  refine TopologicalSpace.IsTopologicalBasis.mk ?_ ?_ rfl
  · intro s₁ hs₁ s₂ hs₂ r hr
    rcases hs₁ with ⟨q, U, _, rfl⟩
    rcases hs₂ with ⟨s, V, _, rfl⟩
    rcases universal_cover_candidate_basic_set_intersection_refines
        U V hr.1 hr.2 with
      ⟨W, -, hW, hsubset⟩
    -- The refined suitable neighborhood `W` supplies the third basis element through `r`.
    refine ⟨W[r], ?_, ?_, hsubset⟩
    · exact ⟨r, W, hW, rfl⟩
    · exact universalCoverCandidateBasicSet_self_mem r W
  · ext r
    constructor
    · intro _
      simp
    · intro _
      rcases exists_suitable_universal_cover_neighborhood r.1 with ⟨U, hU⟩
      have hrbasic : r ∈ U[r] := by
        -- A constant path at the endpoint puts `r` into its own basic sheet.
        exact universalCoverCandidateBasicSet_self_mem r U
      refine Set.mem_sUnion.mpr ⟨U[r], ?_, hrbasic⟩
      exact ⟨r, U, hU, rfl⟩
