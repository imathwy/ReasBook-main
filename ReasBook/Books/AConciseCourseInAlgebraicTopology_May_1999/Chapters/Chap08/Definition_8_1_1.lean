import Mathlib.CategoryTheory.Category.Pointed
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap02.Lemma_2_4_4

-- Semantic recall: mathlib's `Pointed` is the canonical owner for pointed sets; this item uses
-- the Chapter 2 owner `BasedSpace` and the existing based-homotopy relation `basedHomotopyRel`.

open CategoryTheory

noncomputable section

/-- The underlying constant map to the basepoint of `Y` is a morphism of based spaces. -/
theorem constantBasedMap_w (X Y : BasedSpace) :
    X.hom ≫ TopCat.ofHom (ContinuousMap.const X.right (underTopBasepoint Y)) = Y.hom := by
  ext x
  have hx : TopCat.terminalIsoPUnit.hom x = PUnit.unit := by
    cases h : TopCat.terminalIsoPUnit.hom x
    rfl
  calc
    (X.hom ≫ TopCat.ofHom (ContinuousMap.const X.right (underTopBasepoint Y))) x
        = underTopBasepoint Y := rfl
    _ = Y.hom (TopCat.terminalIsoPUnit.inv PUnit.unit) := rfl
    _ = Y.hom (TopCat.terminalIsoPUnit.inv (TopCat.terminalIsoPUnit.hom x)) := by rw [hx]
    _ = Y.hom x := by simp

/-- The constant based map from `X` to `Y`, landing at the distinguished basepoint of `Y`. -/
noncomputable def constantBasedMap (X Y : BasedSpace) : X ⟶ Y :=
  Under.homMk (TopCat.ofHom (ContinuousMap.const X.right (underTopBasepoint Y)))
    (constantBasedMap_w X Y)

/-- The setoid on based maps `X ⟶ Y` whose classes are generated by based homotopies. -/
def basedHomotopySetoid (X Y : BasedSpace) : Setoid (X ⟶ Y) :=
  Relation.EqvGen.setoid (fun f g : X ⟶ Y ↦ basedHomotopyRel f g)

/-- Two based maps are related by `basedHomotopySetoid X Y` when they lie in the equivalence
closure of the based homotopy relation. -/
theorem basedHomotopySetoid_iff
    (X Y : BasedSpace) (f g : X ⟶ Y) :
    (basedHomotopySetoid X Y).r f g ↔
      Relation.EqvGen (fun f g : X ⟶ Y ↦ basedHomotopyRel f g) f g := Iff.rfl

/-- Definition 8.1.1: for based spaces `X` and `Y`, `[X,Y]` is the pointed set of based homotopy
classes of based maps `X ⟶ Y`, with distinguished point the class of the constant map. -/
noncomputable def basedHomotopyClasses (X Y : BasedSpace) : Pointed :=
  Pointed.of
    (Quotient.mk (basedHomotopySetoid X Y) (constantBasedMap X Y))

/-- Lean notation for the pointed set of based homotopy classes formalizing textbook `[X,Y]`. -/
scoped[HomotopyClasses] notation "Ho*[" X ", " Y "]" => basedHomotopyClasses X Y

open scoped HomotopyClasses

/-- The distinguished point of `Ho*[X, Y]` is the class of the constant based map. -/
@[simp] theorem basedHomotopyClasses_point_eq (X Y : BasedSpace) :
    (Ho*[X, Y]).point =
      Quotient.mk (basedHomotopySetoid X Y) (constantBasedMap X Y) := rfl
