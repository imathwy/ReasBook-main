import Mathlib.Algebra.Exact
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.BasedHomotopyClassesPostcompose
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.Criterion_8_5_4
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.Definition_8_6_5
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.Lemma_8_6_8
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.Lemma_8_6_9
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.Lemma_8_6_10
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap06.Definition_6_5_2
import Books.AConciseCourseInAlgebraicTopology_May_1999.PointedExact

open CategoryTheory
open scoped HomotopyClasses PathSpace unitInterval Topology.Homotopy

noncomputable section

local notation "BasedSpace" => Under (⊤_ TopCat)

-- Semantic recall: the source-facing owner here is the exact sequence obtained by applying
-- `Ho*[Z, -]` to `fiberSequenceGeneratedBy f`, while postcomposition and the loop-space algebra on
-- `Ho*[Z, Ωᵇ X]` live in the chapter-level support owner
-- `BasedHomotopyClassesPostcompose`.

/-- The map on `Ho*[Z, -]` induced by the `n`th arrow of the fiber sequence generated by `f`. -/
def fiberSequenceGeneratedByPostcompose (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 1)] ⟶ Ho*[Z, (fiberSequenceGeneratedBy f).obj n] :=
  basedHomotopyClassesPostcompose Z ((fiberSequenceGeneratedBy f).map n)

/-- In the loop-space region, the shifted map `fiberSequenceGeneratedByPostcompose Z f (n + 3)`
is a group homomorphism on based homotopy classes. -/
def fiberSequenceGeneratedByPostcomposeLoopHom (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y)
    (n : ℕ) :
    Ho*[Z, Ωᵇ ((fiberSequenceGeneratedBy f).obj (n + 1))] →*
      Ho*[Z, Ωᵇ ((fiberSequenceGeneratedBy f).obj n)] :=
  basedHomotopyClassesPostcomposeLoopHom Z
    (((fiberSequenceGeneratedBy f).map (n + 3)) :
      Ωᵇ ((fiberSequenceGeneratedBy f).obj (n + 1)) ⟶
        Ωᵇ ((fiberSequenceGeneratedBy f).obj n))

/-- In the double-loop region, the shifted map `fiberSequenceGeneratedByPostcompose Z f (n + 6)`
is a commutative-group homomorphism on based homotopy classes. -/
def fiberSequenceGeneratedByPostcomposeDoubleLoopHom (Z : BasedSpace) {X Y : BasedSpace}
    (f : X ⟶ Y) (n : ℕ) :
    Ho*[Z, Ωᵇ (Ωᵇ ((fiberSequenceGeneratedBy f).obj (n + 1)))] →*
      Ho*[Z, Ωᵇ (Ωᵇ ((fiberSequenceGeneratedBy f).obj n))] :=
  basedHomotopyClassesPostcomposeDoubleLoopHom Z
    (((fiberSequenceGeneratedBy f).map (n + 6)) :
      Ωᵇ (Ωᵇ ((fiberSequenceGeneratedBy f).obj (n + 1))) ⟶
        Ωᵇ (Ωᵇ ((fiberSequenceGeneratedBy f).obj n)))

/-- Helper for Theorem 8.6.6: postcomposition on based homotopy classes respects composition of
based maps. -/
private theorem basedHomotopyClassesPostcompose_comp (Z : BasedSpace) {A B C : BasedSpace}
    (u : A ⟶ B) (v : B ⟶ C) :
    basedHomotopyClassesPostcompose Z u ≫ basedHomotopyClassesPostcompose Z v =
      basedHomotopyClassesPostcompose Z (u ≫ v) := by
  -- Compare both induced maps on a representative and use associativity of composition.
  ext b
  refine Quotient.inductionOn b ?_
  intro k
  rfl

/-- Helper for Theorem 8.6.6: postcomposition with the identity map is the identity on based
homotopy classes. -/
private theorem basedHomotopyClassesPostcompose_id (Z : BasedSpace) (A : BasedSpace) :
    basedHomotopyClassesPostcompose Z (𝟙 A) = 𝟙 (Ho*[Z, A]) := by
  -- Representatives are unchanged by postcomposing with the identity.
  ext b
  refine Quotient.inductionOn b ?_
  intro k
  rfl

/-- Helper for Theorem 8.6.6: exactness is preserved after precomposing the left map with a
surjective map of pointed sets. -/
private theorem pointedExact_comp_left_of_surjective {A A' B C : Pointed} (e : A' ⟶ A)
    (f : A ⟶ B) (g : B ⟶ C) (hExact : PointedExact f g)
    (he : Function.Surjective e) :
    PointedExact (e ≫ f) g := by
  intro b
  constructor
  · intro hb
    rcases (hExact b).1 hb with ⟨a, ha⟩
    rcases he a with ⟨a', rfl⟩
    exact ⟨a', ha⟩
  · rintro ⟨a', ha'⟩
    exact (hExact b).2 ⟨e a', ha'⟩

/-- Helper for Theorem 8.6.6: exactness transports across a bijection on the middle pointed set
when the surrounding maps agree after composing with that bijection. -/
private theorem pointedExact_transport_bijective {A B B' C : Pointed} (e : B' ⟶ B)
    (α : A ⟶ B) (β : B ⟶ C) (α' : A ⟶ B') (β' : B' ⟶ C)
    (hα : α' ≫ e = α) (hβ : e ≫ β = β') (he : Function.Bijective e)
    (hExact : PointedExact α β) :
    PointedExact α' β' := by
  intro b'
  constructor
  · intro hb'
    have hβapply : β (e b') = β' b' :=
      congrArg (fun k : B' ⟶ C ↦ k b') hβ
    have hb : β (e b') = C.point := by
      simpa [hβapply] using hb'
    rcases (hExact (e b')).1 hb with ⟨a, ha⟩
    have hαapply : e (α' a) = α a :=
      congrArg (fun k : A ⟶ B ↦ k a) hα
    refine ⟨a, he.1 ?_⟩
    calc
      e (α' a) = α a := hαapply
      _ = e b' := ha
  · rintro ⟨a, ha⟩
    have hαapply : e (α' a) = α a :=
      congrArg (fun k : A ⟶ B ↦ k a) hα
    have hb : β (e b') = C.point := by
      apply (hExact (e b')).2
      exact ⟨a, hαapply.symm.trans (congrArg e ha)⟩
    have hβapply : β (e b') = β' b' :=
      congrArg (fun k : B' ⟶ C ↦ k b') hβ
    simpa [hβapply] using hb

/-- Helper for Theorem 8.6.6: exactness for `g ≫ e` descends to exactness for `g` when the
postcomposition map `e` is injective. -/
private theorem pointedExact_cancel_right_of_injective {A B C C' : Pointed}
    (f : A ⟶ B) (g : B ⟶ C) (e : C ⟶ C') (hExact : PointedExact f (g ≫ e))
    (he : Function.Injective e) :
    PointedExact f g := by
  intro b
  constructor
  · intro hb
    -- The original basepoint equation implies the postcomposed one, so exactness for `g ≫ e`
    -- supplies a witness.
    have hbe : (g ≫ e) b = C'.point := by
      calc
        e (g b) = e C.point := by
          rw [hb]
        _ = C'.point := e.map_point
    exact (hExact b).1 hbe
  · rintro ⟨a, ha⟩
    -- Injectivity recovers the original codomain basepoint from the postcomposed exactness
    -- statement.
    have hbe : (g ≫ e) b = C'.point := (hExact b).2 ⟨a, ha⟩
    apply he
    calc
      e (g b) = C'.point := by
        simpa using hbe
      _ = e C.point := by
        symm
        exact e.map_point

/-- Helper for Theorem 8.6.6: a strict two-sided inverse on based spaces induces a bijection on
`Ho*[Z, -]` by postcomposition. -/
private theorem basedHomotopyClassesPostcompose_bijective_of_inverse (Z : BasedSpace)
    {A B : BasedSpace} (e : A ⟶ B) (g : B ⟶ A)
    (heg : e ≫ g = 𝟙 A) (hge : g ≫ e = 𝟙 B) :
    Function.Bijective (basedHomotopyClassesPostcompose Z e) := by
  -- The induced postcompose maps inherit the same strict inverse identities.
  have hLeft :
      Function.LeftInverse (basedHomotopyClassesPostcompose Z g)
        (basedHomotopyClassesPostcompose Z e) := by
    intro a
    have hcomp :
        basedHomotopyClassesPostcompose Z e ≫ basedHomotopyClassesPostcompose Z g =
          𝟙 (Ho*[Z, A]) := by
      simpa [heg, basedHomotopyClassesPostcompose_id] using
        basedHomotopyClassesPostcompose_comp Z e g
    exact congrArg (fun k : Ho*[Z, A] ⟶ Ho*[Z, A] => k a) hcomp
  have hRight :
      Function.RightInverse (basedHomotopyClassesPostcompose Z g)
        (basedHomotopyClassesPostcompose Z e) := by
    intro b
    have hcomp :
        basedHomotopyClassesPostcompose Z g ≫ basedHomotopyClassesPostcompose Z e =
          𝟙 (Ho*[Z, B]) := by
      simpa [hge, basedHomotopyClassesPostcompose_id] using
        basedHomotopyClassesPostcompose_comp Z g e
    exact congrArg (fun k : Ho*[Z, B] ⟶ Ho*[Z, B] => k b) hcomp
  exact ⟨hLeft.injective, hRight.surjective⟩

/-- Helper for Theorem 8.6.6: the generated quotient relation on based maps collapses back to a
single based homotopy, since based homotopy is already an equivalence relation. -/
private theorem basedHomotopyRel_of_setoid {A B : BasedSpace} {u v : A ⟶ B}
    (h : (basedHomotopySetoid A B).r u v) :
    basedHomotopyRel u v := by
  rw [basedHomotopySetoid_iff] at h
  induction h with
  | rel _ _ huv =>
      exact huv
  | refl u =>
      exact ContinuousMap.HomotopicRel.refl u.right.hom
  | symm _ _ _ huv =>
      exact ContinuousMap.HomotopicRel.symm huv
  | trans _ _ _ _ _ huv hvw =>
      exact ContinuousMap.HomotopicRel.trans huv hvw

/-- Helper for Theorem 8.6.6: homotopic maps under the basepoint induce the same postcomposition
map on based homotopy classes. -/
private theorem postcomposeEq_ofHomotopicUnder (Z : BasedSpace) {A B : BasedSpace}
    {u v : A ⟶ B} (h : HomotopicUnder u v) :
    basedHomotopyClassesPostcompose Z u = basedHomotopyClassesPostcompose Z v := by
  ext b
  refine Quotient.inductionOn b ?_
  intro k
  -- Compare the two representatives by precomposing the homotopy-under with `k`.
  apply Quotient.sound
  change (basedHomotopySetoid Z B).r (k ≫ u) (k ≫ v)
  rw [basedHomotopySetoid_iff]
  obtain ⟨H⟩ := h
  refine Relation.EqvGen.rel _ _ ?_
  refine ⟨{ toHomotopy := H.toHomotopy.compContinuousMap k.right.hom, prop' := ?_ }⟩
  intro t z hz
  rcases Set.mem_singleton_iff.mp hz with rfl
  have hstage :
      H.toHomotopy.curry t (underTopBasepoint A) = underTopBasepoint B := by
    have hw :=
      ContinuousMap.congr_fun (UnderHomotopy.w H t)
        (TopCat.terminalIsoPUnit.inv PUnit.unit)
    simpa [underTopBasepoint] using hw
  calc
    (H.toHomotopy.compContinuousMap k.right.hom) (t, underTopBasepoint Z)
        = H.toHomotopy.curry t (k.right.hom (underTopBasepoint Z)) := rfl
    _ = H.toHomotopy.curry t (underTopBasepoint A) := by
      rw [fundamentalGroupFunctorMap_basepoint k]
    _ = underTopBasepoint B := hstage
    _ = (k ≫ u).right.hom (underTopBasepoint Z) := by
      simp [fundamentalGroupFunctorMap_basepoint]

/-- Helper for Theorem 8.6.6: a based homotopy equivalence induces a bijection on `Ho*[Z, -]` by
postcomposition. -/
private theorem basedHomotopyClassesPostcompose_bijective_of_homotopyEquivalence
    (Z : BasedSpace) {A B : BasedSpace} (e : A ⟶ B) [he : IsCofiberHomotopyEquivalence e] :
    Function.Bijective (basedHomotopyClassesPostcompose Z e) := by
  -- Turn the homotopy inverse data into strict inverse identities on `Ho*[Z, -]`.
  rw [isCofiberHomotopyEquivalence_iff] at he
  rcases he with ⟨g, hge, heg⟩
  have hLeft :
      Function.LeftInverse (basedHomotopyClassesPostcompose Z g)
        (basedHomotopyClassesPostcompose Z e) := by
    intro a
    have hcomp :
        basedHomotopyClassesPostcompose Z e ≫ basedHomotopyClassesPostcompose Z g =
          𝟙 (Ho*[Z, A]) := by
      -- Rewrite through the homotopy inverse relation `e ≫ g ~ 𝟙`.
      calc
        basedHomotopyClassesPostcompose Z e ≫ basedHomotopyClassesPostcompose Z g =
            basedHomotopyClassesPostcompose Z (e ≫ g) := by
              exact basedHomotopyClassesPostcompose_comp Z e g
        _ = basedHomotopyClassesPostcompose Z (𝟙 A) := by
              exact postcomposeEq_ofHomotopicUnder Z heg
        _ = 𝟙 (Ho*[Z, A]) := basedHomotopyClassesPostcompose_id Z A
    exact congrArg (fun k : Ho*[Z, A] ⟶ Ho*[Z, A] => k a) hcomp
  have hRight :
      Function.RightInverse (basedHomotopyClassesPostcompose Z g)
        (basedHomotopyClassesPostcompose Z e) := by
    intro b
    have hcomp :
        basedHomotopyClassesPostcompose Z g ≫ basedHomotopyClassesPostcompose Z e =
          𝟙 (Ho*[Z, B]) := by
      -- Rewrite through the homotopy inverse relation `g ≫ e ~ 𝟙`.
      calc
        basedHomotopyClassesPostcompose Z g ≫ basedHomotopyClassesPostcompose Z e =
            basedHomotopyClassesPostcompose Z (g ≫ e) := by
              exact basedHomotopyClassesPostcompose_comp Z g e
        _ = basedHomotopyClassesPostcompose Z (𝟙 B) := by
              exact postcomposeEq_ofHomotopicUnder Z hge
        _ = 𝟙 (Ho*[Z, B]) := basedHomotopyClassesPostcompose_id Z B
    exact congrArg (fun k : Ho*[Z, B] ⟶ Ho*[Z, B] => k b) hcomp
  exact ⟨hLeft.injective, hRight.surjective⟩

/-- Helper for Theorem 8.6.6: the loop-inclusion point lies in the actual fiber of
`homotopyFiberProjection f`. -/
private theorem loopToActualFiber_mem {X Y : BasedSpace} (f : X ⟶ Y)
    (χ : Ω Y.right (underTopBasepoint Y)) :
    homotopyFiberLoopInclusionFun f χ ∈ actualFiberSet (homotopyFiberProjection f) := by
  -- Route correction: package the comparison through the actual fiber of `π(f)` before using the
  -- homotopy-fiber equivalence, rather than attacking `Ho*[Z, -]` representatives directly.
  change (homotopyFiberProjection f).right.hom (homotopyFiberLoopInclusionFun f χ) =
    underTopBasepoint X
  rw [homotopyFiberLoopInclusionFun_apply, homotopyFiberProjection_hom_apply]
  rfl

/-- Helper for Theorem 8.6.6: the loop-to-actual-fiber comparison is continuous. -/
private theorem loopToActualFiberContinuous {X Y : BasedSpace} (f : X ⟶ Y) :
    Continuous fun χ : Ω Y.right (underTopBasepoint Y) =>
      (⟨homotopyFiberLoopInclusionFun f χ, loopToActualFiber_mem f χ⟩ :
        actualFiberSet (homotopyFiberProjection f)) := by
  -- Lift the continuous loop inclusion into the actual-fiber subtype.
  simpa [homotopyFiberLoopInclusionFun] using
    (homotopyFiberLoopInclusionContinuous f).subtype_mk (loopToActualFiber_mem f)

/-- Helper for Theorem 8.6.6: the loop-to-actual-fiber comparison preserves the chosen
basepoints. -/
private theorem loopToActualFiber_basepoint {X Y : BasedSpace} (f : X ⟶ Y) :
    (fun χ : Ω Y.right (underTopBasepoint Y) =>
      (⟨homotopyFiberLoopInclusionFun f χ, loopToActualFiber_mem f χ⟩ :
        actualFiberSet (homotopyFiberProjection f))) (underTopBasepoint (Ωᵇ Y)) =
      underTopBasepoint (actualFiber (homotopyFiberProjection f)) := by
  -- Both distinguished points are the constant loop at the basepoint of `Y`.
  rfl

/-- Helper for Theorem 8.6.6: `Ωᵇ Y` identifies with the actual fiber of `π(f)` by sending a
loop to the corresponding point of `F_f` over the basepoint of `X`. -/
private def loopToActualFiber {X Y : BasedSpace} (f : X ⟶ Y) :
    Ωᵇ Y ⟶ actualFiber (homotopyFiberProjection f) :=
  basedMapOfMapToBasedSpace
    { toFun := fun χ =>
        (⟨homotopyFiberLoopInclusionFun f χ, loopToActualFiber_mem f χ⟩ :
          actualFiberSet (homotopyFiberProjection f))
      continuous_toFun := loopToActualFiberContinuous f }
    (loopToActualFiber_basepoint f)

/-- Helper for Theorem 8.6.6: the path coordinate of a point in the actual fiber of `π(f)` is a
loop in `Y`, and this assignment is continuous. -/
private theorem actualFiberToLoopContinuous {X Y : BasedSpace} (f : X ⟶ Y) :
    Continuous fun x : actualFiberSet (homotopyFiberProjection f) =>
      Path.mk x.1.path.1 x.1.path.2 (by
        change (x.1.path).endpoint = underTopBasepoint Y
        calc
          (x.1.path).endpoint = f.right.hom x.1.point := by
            simpa using (HomotopyFiber.endpoint_eq x.1).symm
          _ = f.right.hom (underTopBasepoint X) := by
            simpa using congrArg (fun z : X.right => f.right.hom z) x.2
          _ = underTopBasepoint Y := by
            simpa using fundamentalGroupFunctorMap_basepoint f) := by
  -- Continuity into the loop space reduces to continuity of the underlying path family.
  rw [continuous_induced_rng]
  simpa using
    (continuous_subtype_val.comp ((homotopyFiberPathContinuous f).comp continuous_subtype_val))

/-- Helper for Theorem 8.6.6: the actual-fiber-to-loop map preserves the distinguished
basepoints. -/
private theorem actualFiberToLoop_basepoint {X Y : BasedSpace} (f : X ⟶ Y) :
    (fun x : actualFiberSet (homotopyFiberProjection f) =>
      Path.mk x.1.path.1 x.1.path.2 (by
        change (x.1.path).endpoint = underTopBasepoint Y
        calc
          (x.1.path).endpoint = f.right.hom x.1.point := by
            simpa using (HomotopyFiber.endpoint_eq x.1).symm
          _ = f.right.hom (underTopBasepoint X) := by
            simpa using congrArg (fun z : X.right => f.right.hom z) x.2
          _ = underTopBasepoint Y := by
            simpa using fundamentalGroupFunctorMap_basepoint f))
      (underTopBasepoint (actualFiber (homotopyFiberProjection f))) =
      underTopBasepoint (Ωᵇ Y) := by
  -- The actual-fiber basepoint stores the constant path at the target basepoint.
  rfl

/-- Helper for Theorem 8.6.6: recovering the loop from the actual fiber of `π(f)` gives a based
map back to `Ωᵇ Y`. -/
private def actualFiberToLoop {X Y : BasedSpace} (f : X ⟶ Y) :
    actualFiber (homotopyFiberProjection f) ⟶ Ωᵇ Y :=
  basedMapOfMapToBasedSpace
    { toFun := fun x =>
        Path.mk x.1.path.1 x.1.path.2 (by
          change (x.1.path).endpoint = underTopBasepoint Y
          calc
            (x.1.path).endpoint = f.right.hom x.1.point := by
              simpa using (HomotopyFiber.endpoint_eq x.1).symm
            _ = f.right.hom (underTopBasepoint X) := by
              simpa using congrArg (fun z : X.right => f.right.hom z) x.2
            _ = underTopBasepoint Y := by
              simpa using fundamentalGroupFunctorMap_basepoint f)
      continuous_toFun := actualFiberToLoopContinuous f }
    (actualFiberToLoop_basepoint f)

/-- Helper for Theorem 8.6.6: the actual-fiber comparison and path-coordinate recovery are strict
inverse based maps. -/
private theorem actualFiber_loop_inverse {X Y : BasedSpace} (f : X ⟶ Y) :
    loopToActualFiber f ≫ actualFiberToLoop f = 𝟙 (Ωᵇ Y) := by
  -- Evaluating the loop recovered from the actual fiber returns the original loop pointwise.
  ext χ
  apply Path.ext
  funext t
  rfl

/-- Helper for Theorem 8.6.6: the path-coordinate recovery followed by the actual-fiber
comparison is the identity on the actual fiber of `π(f)`. -/
private theorem loop_actualFiber_inverse {X Y : BasedSpace} (f : X ⟶ Y) :
    actualFiberToLoop f ≫ loopToActualFiber f = 𝟙 (actualFiber (homotopyFiberProjection f)) := by
  -- Equality in the actual fiber reduces to the point coordinate and the stored path.
  ext x
  apply Subtype.ext
  apply Subtype.ext
  exact Prod.ext (by simpa using x.2.symm) (by
    apply Subtype.ext
    ext t
    rfl)

/-- Helper for Theorem 8.6.6: the comparison `Ωᵇ Y ⟶ F_(π(f))` factors through the actual fiber
of `π(f)` and then through the actual-fiber inclusion of Lemma 8.6.9. -/
private theorem loopToActualFiber_comp_actualFiberToHomotopyFiber {X Y : BasedSpace}
    (f : X ⟶ Y) :
    loopToActualFiber f ≫ actualFiberToHomotopyFiber (homotopyFiberProjection f) =
      homotopyFiberProjectionComparison f := by
  -- Expanding the three constructions shows that they send a loop to the same iterated-fiber
  -- point with constant outer path.
  ext χ
  rfl

/-- Helper for Theorem 8.6.6: the deformation-retract construction of Lemma 8.6.9 only needs the
based covering homotopy property, so we can apply it to `π(f)` locally in this file. -/
private theorem exists_homotopyFiberContractionLift_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p] :
    ∃ g₁ : homotopyFiber p ⟶ E,
      ∃ G : (homotopyFiberPointProjection p).right.hom HRel[homotopyFiber p] g₁.right.hom,
        ContinuousMap.comp p.right.hom G.toContinuousMap =
          (homotopyFiberPathContraction_liftInput p).toContinuousMap := by
  -- The proof is the same lift used in Lemma 8.6.9, but under the weaker CHP hypothesis.
  exact
    HasBasedCoveringHomotopyProperty.exists_based_homotopyLift
      (p := p)
      (homotopyFiberPathContraction_liftInput p)
      (homotopyFiberPointProjection p)
      rfl

/-- Helper for Theorem 8.6.6: the chosen terminal stage of the lifted contraction under the based
covering homotopy property. -/
private def homotopyFiberLiftTerminal_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p] :
    homotopyFiber p ⟶ E :=
  Classical.choose (exists_homotopyFiberContractionLift_ofBasedCHP p)

/-- Helper for Theorem 8.6.6: the chosen lifted contraction from `homotopyFiberProjection p` to
its terminal stage under the based covering homotopy property. -/
private def homotopyFiberContractionLift_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p] :
    (homotopyFiberPointProjection p).right.hom HRel[homotopyFiber p]
      (homotopyFiberLiftTerminal_ofBasedCHP p).right.hom :=
  Classical.choose (Classical.choose_spec (exists_homotopyFiberContractionLift_ofBasedCHP p))

/-- Helper for Theorem 8.6.6: projecting the chosen HBCP-level lift along `p` recovers the
standard path contraction. -/
private theorem homotopyFiberContractionLift_comm_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p] :
    ContinuousMap.comp p.right.hom (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap =
      (homotopyFiberPathContraction_liftInput p).toContinuousMap :=
  Classical.choose_spec (Classical.choose_spec (exists_homotopyFiberContractionLift_ofBasedCHP p))

/-- Helper for Theorem 8.6.6: the terminal stage of the HBCP-level lifted contraction lands in
the actual fiber. -/
private theorem homotopyFiberLiftTerminal_mem_actualFiberSet_ofBasedCHP
    {E B : BasedSpace} (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p]
    (z : HomotopyFiber p) :
    p.right.hom ((homotopyFiberLiftTerminal_ofBasedCHP p).right.hom z) = underTopBasepoint B := by
  -- Evaluate the projected lifted homotopy at time `1`, where the base contraction is constant.
  have hcomm :=
    congrArg
      (fun k : C(I × (homotopyFiber p).right, B.right) ↦ k (1, z))
      (homotopyFiberContractionLift_comm_ofBasedCHP p)
  calc
    p.right.hom ((homotopyFiberLiftTerminal_ofBasedCHP p).right.hom z)
        = p.right.hom ((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (1, z)) := by
            simpa using
              congrArg p.right.hom ((homotopyFiberContractionLift_ofBasedCHP p).map_one_left z).symm
    _ = (homotopyFiberPathContraction_liftInput p).toContinuousMap (1, z) := by
          simpa using hcomm
    _ = underTopBasepoint B := by
          simpa [homotopyFiberPathContraction_liftInput, constantBasedMap]

/-- Helper for Theorem 8.6.6: the HBCP-level terminal stage of the lifted contraction, packaged
as a point of the actual fiber. -/
private def homotopyFiberToActualFiber_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p] :
    homotopyFiber p ⟶ actualFiber p :=
  Under.homMk
    (TopCat.ofHom
      { toFun := fun z =>
          ⟨(homotopyFiberLiftTerminal_ofBasedCHP p).right.hom z,
            homotopyFiberLiftTerminal_mem_actualFiberSet_ofBasedCHP p z⟩
        continuous_toFun := by
          exact ((homotopyFiberLiftTerminal_ofBasedCHP p).right.hom.continuous).subtype_mk
            (fun z : (homotopyFiber p).right ↦
              homotopyFiberLiftTerminal_mem_actualFiberSet_ofBasedCHP p z) })
    (by
      -- Both terminal-domain maps are determined by the actual-fiber basepoint.
      ext x
      have hx : TopCat.terminalIsoPUnit.hom x = PUnit.unit := by
        cases h : TopCat.terminalIsoPUnit.hom x
        rfl
      calc
        ((homotopyFiber p).hom ≫
              TopCat.ofHom
                { toFun := fun z =>
                    ⟨(homotopyFiberLiftTerminal_ofBasedCHP p).right.hom z,
                      homotopyFiberLiftTerminal_mem_actualFiberSet_ofBasedCHP p z⟩
                  continuous_toFun := by
                    exact ((homotopyFiberLiftTerminal_ofBasedCHP p).right.hom.continuous).subtype_mk
                      (fun z : (homotopyFiber p).right ↦
                        homotopyFiberLiftTerminal_mem_actualFiberSet_ofBasedCHP p z) }) x
            =
          (⟨(homotopyFiberLiftTerminal_ofBasedCHP p).right.hom
              (underTopBasepoint (homotopyFiber p)),
            homotopyFiberLiftTerminal_mem_actualFiberSet_ofBasedCHP p
              (underTopBasepoint (homotopyFiber p))⟩ : actualFiberSet p) := by
              rfl
        _ = actualFiberBasepoint p := by
              apply Subtype.ext
              exact basedMapUnderTopBasepoint (homotopyFiberLiftTerminal_ofBasedCHP p)
        _ = (actualFiber p).hom (TopCat.terminalIsoPUnit.inv PUnit.unit) := rfl
        _ = (actualFiber p).hom
              (TopCat.terminalIsoPUnit.inv (TopCat.terminalIsoPUnit.hom x)) := by
                rw [hx]
        _ = (actualFiber p).hom x := by
              simp)

/-- Helper for Theorem 8.6.6: the underlying map of the HBCP-level actual-fiber retraction is the
terminal stage of the lifted contraction. -/
@[simp] private theorem homotopyFiberToActualFiber_ofBasedCHP_hom_apply
    {E B : BasedSpace} (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p]
    (z : HomotopyFiber p) :
    (homotopyFiberToActualFiber_ofBasedCHP p).right.hom z =
      ⟨(homotopyFiberLiftTerminal_ofBasedCHP p).right.hom z,
        homotopyFiberLiftTerminal_mem_actualFiberSet_ofBasedCHP p z⟩ :=
  rfl

/-- Helper for Theorem 8.6.6: the HBCP-level lifted contraction stays in the actual fiber after
restricting along the actual-fiber inclusion. -/
private theorem actualFiberContractionStage_mem_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p] (q : actualFiberSet p × I) :
    p.right.hom ((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
        (q.2, actualFiberToHomotopyFiberFun p q.1)) = underTopBasepoint B := by
  -- Project the lifted contraction to `B` and evaluate it on a constant-path representative.
  have hcomm :=
    congrArg
      (fun k : C(I × (homotopyFiber p).right, B.right) ↦
        k (q.2, actualFiberToHomotopyFiberFun p q.1))
      (homotopyFiberContractionLift_comm_ofBasedCHP p)
  calc
    p.right.hom ((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
        (q.2, actualFiberToHomotopyFiberFun p q.1))
        = (homotopyFiberPathContraction_liftInput p).toContinuousMap
            (q.2, actualFiberToHomotopyFiberFun p q.1) := by
              simpa using hcomm
    _ = (actualFiberToHomotopyFiberFun p q.1).path (oneSub q.2) := by
          simpa using
            homotopyFiberPathContraction_liftInput_apply p q.2
              (actualFiberToHomotopyFiberFun p q.1)
    _ = underTopBasepoint B := by
          rfl

/-- Helper for Theorem 8.6.6: the HBCP-level actual-fiber retraction family. -/
private def actualFiberRetractionFamily_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p] :
    C((actualFiber p).right, C(I, (actualFiber p).right)) :=
  ContinuousMap.curry
    ⟨fun q : actualFiberSet p × I ↦
        ⟨(homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
            (q.2, actualFiberToHomotopyFiberFun p q.1),
          actualFiberContractionStage_mem_ofBasedCHP p q⟩,
      by
        -- Compose the lifted contraction with the actual-fiber inclusion and repackage the result.
        have hpair :
            Continuous fun q : actualFiberSet p × I ↦
              (q.2, actualFiberToHomotopyFiberFun p q.1) := by
          exact continuous_snd.prodMk
            ((actualFiberToHomotopyFiberFun_continuous p).comp continuous_fst)
        have hraw :
            Continuous fun q : actualFiberSet p × I ↦
              (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
                (q.2, actualFiberToHomotopyFiberFun p q.1) := by
          exact (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap.continuous.comp hpair
        exact hraw.subtype_mk (fun q ↦ actualFiberContractionStage_mem_ofBasedCHP p q)⟩

/-- Helper for Theorem 8.6.6: at time `0`, the HBCP-level actual-fiber retraction family is the
identity. -/
@[simp] private theorem actualFiberRetractionFamily_zero_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] (x : actualFiberSet p) :
    actualFiberRetractionFamily_ofBasedCHP p x 0 = x := by
  -- The lifted contraction starts at the homotopy-fiber projection.
  apply Subtype.ext
  change (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
      (0, actualFiberToHomotopyFiberFun p x) = x.1
  calc
    (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
        (0, actualFiberToHomotopyFiberFun p x)
        = (homotopyFiberPointProjection p).right.hom (actualFiberToHomotopyFiberFun p x) := by
            simpa using (homotopyFiberContractionLift_ofBasedCHP p).map_zero_left
              (actualFiberToHomotopyFiberFun p x)
    _ = x.1 := by
          rfl

/-- Helper for Theorem 8.6.6: at time `1`, the HBCP-level actual-fiber retraction family reaches
`actualFiberToHomotopyFiber p ≫ homotopyFiberToActualFiber_ofBasedCHP p`. -/
@[simp] private theorem actualFiberRetractionFamily_one_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] (x : actualFiberSet p) :
    actualFiberRetractionFamily_ofBasedCHP p x 1 =
      (actualFiberToHomotopyFiber p ≫ homotopyFiberToActualFiber_ofBasedCHP p).right.hom x := by
  -- The terminal stage of the lift is exactly the chosen actual-fiber retraction.
  apply Subtype.ext
  change (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
      (1, actualFiberToHomotopyFiberFun p x) =
        ((actualFiberToHomotopyFiber p ≫ homotopyFiberToActualFiber_ofBasedCHP p).right.hom x).1
  simpa [Category.assoc, actualFiberToHomotopyFiberFun, actualFiberToHomotopyFiber_hom_apply,
    homotopyFiberToActualFiber_ofBasedCHP_hom_apply] using
    (homotopyFiberContractionLift_ofBasedCHP p).map_one_left (actualFiberToHomotopyFiberFun p x)

/-- Helper for Theorem 8.6.6: the HBCP-level actual-fiber retraction family fixes the chosen
basepoint at every stage. -/
private theorem actualFiberRetractionFamily_basepoint_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] :
    actualFiberRetractionFamily_ofBasedCHP p (underTopBasepoint (actualFiber p)) =
      ContinuousMap.const I (underTopBasepoint (actualFiber p)) := by
  -- The lifted contraction is relative to the basepoint, and the actual-fiber basepoint maps to
  -- the homotopy-fiber basepoint.
  ext t
  apply Subtype.ext
  have hstage :
      (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
        (t, actualFiberToHomotopyFiberFun p (underTopBasepoint (actualFiber p))) =
          underTopBasepoint E := by
    have hrel :=
      (homotopyFiberContractionLift_ofBasedCHP p).eq_fst t
        (by simpa [basedBasepointSet] using actualFiberToHomotopyFiberFun_basepoint p)
    simpa [actualFiberToHomotopyFiberFun_basepoint p, homotopyFiberPointProjectionHom_apply,
      underTopBasepoint_homotopyFiber] using hrel
  simpa [actualFiberRetractionFamily_ofBasedCHP, hstage, underTopBasepoint_actualFiber]

/-- Helper for Theorem 8.6.6: the HBCP-level actual-fiber retraction family is constant on the
chosen basepoint. -/
private theorem actualFiberRetractionFamily_rel_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p]
    (x : (actualFiber p).right) (hx : x ∈ basedBasepointSet (actualFiber p)) :
    actualFiberRetractionFamily_ofBasedCHP p x = ContinuousMap.const I x := by
  -- The relative condition reduces to the unique point of the singleton basepoint subset.
  rcases Set.mem_singleton_iff.mp hx with rfl
  exact actualFiberRetractionFamily_basepoint_ofBasedCHP p

/-- Helper for Theorem 8.6.6: the HBCP-level actual-fiber retraction yields a homotopy under from
`actualFiberToHomotopyFiber p ≫ homotopyFiberToActualFiber_ofBasedCHP p` to the identity. -/
private theorem actualFiberRetractionHomotopicUnder_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] :
    HomotopicUnder
      ((actualFiberToHomotopyFiber p ≫ homotopyFiberToActualFiber_ofBasedCHP p :
          actualFiber p ⟶ actualFiber p))
      (𝟙 (actualFiber p)) := by
  -- Repackage the reversed actual-fiber relative homotopy as a homotopy in the under category.
  let H : (actualFiberToHomotopyFiber p ≫ homotopyFiberToActualFiber_ofBasedCHP p).right.hom
      HRel[actualFiber p] (ContinuousMap.id (actualFiber p).right) :=
    (basedHomotopyRelOfPathFamily
      (actualFiberRetractionFamily_ofBasedCHP p)
      (fun x ↦ by
        simpa using actualFiberRetractionFamily_zero_ofBasedCHP p x)
      (fun x ↦ by
        simpa using actualFiberRetractionFamily_one_ofBasedCHP p x)
      (actualFiberRetractionFamily_rel_ofBasedCHP p)).symm
  refine ⟨{ toHomotopy := H.toHomotopy, prop' := ?_ }⟩
  intro t
  ext x
  have hx : TopCat.terminalIsoPUnit.hom x = PUnit.unit := by
    cases h : TopCat.terminalIsoPUnit.hom x
    rfl
  have hstage :
      H (t, underTopBasepoint (actualFiber p)) = underTopBasepoint (actualFiber p) := by
    calc
      H (t, underTopBasepoint (actualFiber p))
          = (actualFiberToHomotopyFiber p ≫ homotopyFiberToActualFiber_ofBasedCHP p).right.hom
              (underTopBasepoint (actualFiber p)) := by
                exact H.eq_fst t (by simp [basedBasepointSet])
      _ = underTopBasepoint (actualFiber p) := by
            simpa using
              basedMapUnderTopBasepoint
                (actualFiberToHomotopyFiber p ≫ homotopyFiberToActualFiber_ofBasedCHP p)
  calc
    (H.toHomotopy.curry t).comp (actualFiber p).hom.hom x
        = H (t, (actualFiber p).hom x) := rfl
    _ = H (t, underTopBasepoint (actualFiber p)) := by
      rw [show (actualFiber p).hom x = underTopBasepoint (actualFiber p) by
        change (actualFiber p).hom x =
          (actualFiber p).hom (TopCat.terminalIsoPUnit.inv PUnit.unit)
        rw [← hx]
        simp]
    _ = underTopBasepoint (actualFiber p) := hstage
    _ = (actualFiber p).hom (TopCat.terminalIsoPUnit.inv PUnit.unit) := rfl
    _ = (actualFiber p).hom
          (TopCat.terminalIsoPUnit.inv (TopCat.terminalIsoPUnit.hom x)) := by
            rw [hx]
    _ = (actualFiber p).hom x := by
          simp

/-- Helper for Theorem 8.6.6: the HBCP-level lifted contraction deforms `HomotopyFiber p` to the
constant-path representatives of the actual fiber. -/
private theorem homotopyFiberDeformation_condition_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] (q : HomotopyFiber p × I) :
    p.right.hom ((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (q.2, q.1)) =
      (truncatedPath q.1.path q.2).endpoint := by
  -- Compare the lifted contraction with the contracted base path pointwise.
  have hcomm :=
    congrArg
      (fun k : C(I × (homotopyFiber p).right, B.right) ↦ k (q.2, q.1))
      (homotopyFiberContractionLift_comm_ofBasedCHP p)
  calc
    p.right.hom ((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (q.2, q.1))
        = (homotopyFiberPathContraction_liftInput p).toContinuousMap (q.2, q.1) := by
            simpa using hcomm
    _ = q.1.path (oneSub q.2) := by
          simpa using homotopyFiberPathContraction_liftInput_apply p q.2 q.1
    _ = (truncatedPath q.1.path q.2).endpoint := by
          rw [truncatedPath_endpoint]

/-- Helper for Theorem 8.6.6: the HBCP-level homotopy-fiber deformation family. -/
private def homotopyFiberDeformationFamily_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p] :
    C((homotopyFiber p).right, C(I, (homotopyFiber p).right)) :=
  ContinuousMap.curry
    ⟨fun q : HomotopyFiber p × I ↦
        HomotopyFiber.mk
          ((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (q.2, q.1))
          (truncatedPath q.1.path q.2)
          (homotopyFiberDeformation_condition_ofBasedCHP p q),
      by
        -- Package the lifted point coordinate and the truncated path coordinate together.
        have hpoint :
            Continuous fun q : HomotopyFiber p × I ↦
              (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (q.2, q.1) := by
          have hpair : Continuous fun q : HomotopyFiber p × I ↦ (q.2, q.1) := by
            exact continuous_snd.prodMk continuous_fst
          exact (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap.continuous.comp hpair
        have hpath :
            Continuous fun q : HomotopyFiber p × I ↦ truncatedPath q.1.path q.2 := by
          have hpair : Continuous fun q : HomotopyFiber p × I ↦ (q.1.path, q.2) := by
            exact ((homotopyFiberPath_continuous p).comp continuous_fst).prodMk continuous_snd
          exact truncatedPath_continuous.comp hpair
        exact ((hpoint.prodMk hpath).subtype_mk
          (fun q ↦ homotopyFiberDeformation_condition_ofBasedCHP p q))⟩

/-- Helper for Theorem 8.6.6: at time `0`, the HBCP-level homotopy-fiber deformation is the
identity. -/
@[simp] private theorem homotopyFiberDeformationFamily_zero_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] (z : HomotopyFiber p) :
    homotopyFiberDeformationFamily_ofBasedCHP p z 0 = z := by
  -- At time `0`, the point coordinate is the original point and the truncated path is unchanged.
  change
    HomotopyFiber.mk
      ((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (0, z))
      (truncatedPath z.path 0)
      (homotopyFiberDeformation_condition_ofBasedCHP p (z, 0)) = z
  have hpoint :
      (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (0, z) = z.point := by
    calc
      (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (0, z)
          = (homotopyFiberPointProjection p).right.hom z := by
              simpa using (homotopyFiberContractionLift_ofBasedCHP p).map_zero_left z
      _ = z.point := by
            rfl
  simpa [truncatedPath_zero, hpoint] using homotopyFiber_eta p z

/-- Helper for Theorem 8.6.6: at time `1`, the HBCP-level homotopy-fiber deformation reaches
`homotopyFiberToActualFiber_ofBasedCHP p ≫ actualFiberToHomotopyFiber p`. -/
@[simp] private theorem homotopyFiberDeformationFamily_one_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] (z : HomotopyFiber p) :
    homotopyFiberDeformationFamily_ofBasedCHP p z 1 =
      (homotopyFiberToActualFiber_ofBasedCHP p ≫ actualFiberToHomotopyFiber p).right.hom z := by
  -- At time `1`, the truncated path is constant and the point coordinate is the terminal lift.
  change
    HomotopyFiber.mk
      ((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (1, z))
      (truncatedPath z.path 1)
      (homotopyFiberDeformation_condition_ofBasedCHP p (z, 1)) =
        (homotopyFiberToActualFiber_ofBasedCHP p ≫ actualFiberToHomotopyFiber p).right.hom z
  have hpoint :
      (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap (1, z) =
        (homotopyFiberLiftTerminal_ofBasedCHP p).right.hom z := by
    simpa using (homotopyFiberContractionLift_ofBasedCHP p).map_one_left z
  simpa [truncatedPath_one, hpoint, Category.assoc, actualFiberToHomotopyFiber_hom_apply,
    homotopyFiberToActualFiber_ofBasedCHP_hom_apply]

/-- Helper for Theorem 8.6.6: the HBCP-level homotopy-fiber deformation fixes the chosen
basepoint at every stage. -/
private theorem homotopyFiberDeformationFamily_basepoint_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] :
    homotopyFiberDeformationFamily_ofBasedCHP p (underTopBasepoint (homotopyFiber p)) =
      ContinuousMap.const I (underTopBasepoint (homotopyFiber p)) := by
  -- The lifted point coordinate is relative to the homotopy-fiber basepoint.
  ext t
  have hstage :
      (homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
        (t, underTopBasepoint (homotopyFiber p)) = underTopBasepoint E := by
    simpa [basedBasepointSet, homotopyFiberPointProjectionHom_apply, underTopBasepoint_homotopyFiber] using
      (homotopyFiberContractionLift_ofBasedCHP p).eq_fst t (by simp [basedBasepointSet])
  apply Subtype.ext
  change
    (((homotopyFiberContractionLift_ofBasedCHP p).toContinuousMap
        (t, underTopBasepoint (homotopyFiber p))), truncatedPath
          (underTopBasepoint (homotopyFiber p)).path t) =
      (underTopBasepoint E, PathSpace.basepoint (underTopBasepoint B))
  rw [hstage, underTopBasepoint_homotopyFiber, HomotopyFiber.path_basepoint,
    truncatedPath_basepoint]

/-- Helper for Theorem 8.6.6: the HBCP-level homotopy-fiber deformation family is constant on the
chosen basepoint. -/
private theorem homotopyFiberDeformationFamily_rel_ofBasedCHP {E B : BasedSpace} (p : E ⟶ B)
    [HasBasedCoveringHomotopyProperty p]
    (z : (homotopyFiber p).right) (hz : z ∈ basedBasepointSet (homotopyFiber p)) :
    homotopyFiberDeformationFamily_ofBasedCHP p z = ContinuousMap.const I z := by
  -- The relative condition again reduces to the singleton basepoint.
  rcases Set.mem_singleton_iff.mp hz with rfl
  exact homotopyFiberDeformationFamily_basepoint_ofBasedCHP p

/-- Helper for Theorem 8.6.6: the HBCP-level homotopy-fiber deformation yields a homotopy under
from `homotopyFiberToActualFiber_ofBasedCHP p ≫ actualFiberToHomotopyFiber p` to the identity. -/
private theorem homotopyFiberRetractionHomotopicUnder_ofBasedCHP {E B : BasedSpace}
    (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] :
    HomotopicUnder
      ((homotopyFiberToActualFiber_ofBasedCHP p ≫ actualFiberToHomotopyFiber p :
          homotopyFiber p ⟶ homotopyFiber p))
      (𝟙 (homotopyFiber p)) := by
  -- Repackage the reversed homotopy-fiber deformation as a homotopy in the under category.
  let H : (homotopyFiberToActualFiber_ofBasedCHP p ≫ actualFiberToHomotopyFiber p).right.hom
      HRel[homotopyFiber p] (ContinuousMap.id (homotopyFiber p).right) :=
    (basedHomotopyRelOfPathFamily
      (homotopyFiberDeformationFamily_ofBasedCHP p)
      (fun z ↦ by
        simpa using homotopyFiberDeformationFamily_zero_ofBasedCHP p z)
      (fun z ↦ by
        simpa using homotopyFiberDeformationFamily_one_ofBasedCHP p z)
      (homotopyFiberDeformationFamily_rel_ofBasedCHP p)).symm
  refine ⟨{ toHomotopy := H.toHomotopy, prop' := ?_ }⟩
  intro t
  ext x
  have hx : TopCat.terminalIsoPUnit.hom x = PUnit.unit := by
    cases h : TopCat.terminalIsoPUnit.hom x
    rfl
  have hstage :
      H (t, underTopBasepoint (homotopyFiber p)) = underTopBasepoint (homotopyFiber p) := by
    calc
      H (t, underTopBasepoint (homotopyFiber p))
          = (homotopyFiberToActualFiber_ofBasedCHP p ≫ actualFiberToHomotopyFiber p).right.hom
              (underTopBasepoint (homotopyFiber p)) := by
                exact H.eq_fst t (by simp [basedBasepointSet])
      _ = underTopBasepoint (homotopyFiber p) := by
            simpa using
              basedMapUnderTopBasepoint
                (homotopyFiberToActualFiber_ofBasedCHP p ≫ actualFiberToHomotopyFiber p)
  calc
    (H.toHomotopy.curry t).comp (homotopyFiber p).hom.hom x
        = H (t, (homotopyFiber p).hom x) := rfl
    _ = H (t, underTopBasepoint (homotopyFiber p)) := by
      rw [show (homotopyFiber p).hom x = underTopBasepoint (homotopyFiber p) by
        change (homotopyFiber p).hom x =
          (homotopyFiber p).hom (TopCat.terminalIsoPUnit.inv PUnit.unit)
        rw [← hx]
        simp]
    _ = underTopBasepoint (homotopyFiber p) := hstage
    _ = (homotopyFiber p).hom (TopCat.terminalIsoPUnit.inv PUnit.unit) := rfl
    _ = (homotopyFiber p).hom
          (TopCat.terminalIsoPUnit.inv (TopCat.terminalIsoPUnit.hom x)) := by
            rw [hx]
    _ = (homotopyFiber p).hom x := by
          simp

/-- Helper for Theorem 8.6.6: the actual-fiber inclusion is still a based homotopy equivalence
under the weaker based covering homotopy property. -/
private theorem actualFiberToHomotopyFiber_isBasedHomotopyEquivalence_ofBasedCHP
    {E B : BasedSpace} (p : E ⟶ B) [HasBasedCoveringHomotopyProperty p] :
    IsCofiberHomotopyEquivalence (actualFiberToHomotopyFiber p) := by
  -- Assemble the HBCP-level homotopy inverse from the lifted contraction.
  rw [isCofiberHomotopyEquivalence_iff]
  refine ⟨homotopyFiberToActualFiber_ofBasedCHP p, ?_, ?_⟩
  · exact homotopyFiberRetractionHomotopicUnder_ofBasedCHP p
  · exact actualFiberRetractionHomotopicUnder_ofBasedCHP p

private theorem basedHomotopyClassesPostcompose_bijective_homotopyFiberProjectionComparison
    (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y) :
    Function.Bijective
      (basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f)) := by
  -- Route correction: `π(f)` only has the based covering homotopy property in this model, so we
  -- reuse the actual-fiber deformation retract with that weaker hypothesis instead of invoking the
  -- surjectivity-based owner from Lemma 8.6.9.
  have hLoopActual :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z (loopToActualFiber f)) := by
    exact basedHomotopyClassesPostcompose_bijective_of_inverse Z
      (loopToActualFiber f) (actualFiberToLoop f)
      (actualFiber_loop_inverse f) (loop_actualFiber_inverse f)
  have hActualIncl :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z
          (actualFiberToHomotopyFiber (homotopyFiberProjection f))) := by
    let _ :
        IsCofiberHomotopyEquivalence
          (actualFiberToHomotopyFiber (homotopyFiberProjection f)) :=
      actualFiberToHomotopyFiber_isBasedHomotopyEquivalence_ofBasedCHP
        (homotopyFiberProjection f)
    exact basedHomotopyClassesPostcompose_bijective_of_homotopyEquivalence Z
      (actualFiberToHomotopyFiber (homotopyFiberProjection f))
  have hComp :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z (loopToActualFiber f) ≫
          basedHomotopyClassesPostcompose Z
            (actualFiberToHomotopyFiber (homotopyFiberProjection f))) := by
    simpa [Function.comp] using Function.Bijective.comp hActualIncl hLoopActual
  have hFactor :
      basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f) =
        basedHomotopyClassesPostcompose Z (loopToActualFiber f) ≫
          basedHomotopyClassesPostcompose Z
            (actualFiberToHomotopyFiber (homotopyFiberProjection f)) := by
    calc
      basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f)
          = basedHomotopyClassesPostcompose Z
              (loopToActualFiber f ≫
                actualFiberToHomotopyFiber (homotopyFiberProjection f)) := by
                  rw [loopToActualFiber_comp_actualFiberToHomotopyFiber]
      _ = basedHomotopyClassesPostcompose Z (loopToActualFiber f) ≫
            basedHomotopyClassesPostcompose Z
              (actualFiberToHomotopyFiber (homotopyFiberProjection f)) := by
            symm
            exact basedHomotopyClassesPostcompose_comp Z
              (loopToActualFiber f)
              (actualFiberToHomotopyFiber (homotopyFiberProjection f))
  rw [hFactor]
  exact hComp

/-- Helper for Theorem 8.6.6: path reversal on `Ωᵇ X` is a strict involution. -/
private theorem loopBasedSpaceNeg_self_inverse (X : BasedSpace) :
    loopBasedSpaceNeg X ≫ loopBasedSpaceNeg X = 𝟙 (Ωᵇ X) := by
  -- Reversing the loop parameter twice gives back the original loop pointwise.
  ext χ
  -- Reduce the composite to `χ.symm.symm`.
  change loopBasedSpaceNegPath X (loopBasedSpaceNegPath X χ) =
    (χ : Ω X.right (underTopBasepoint X))
  simpa [loopBasedSpaceNegPath] using
    (Path.symm_symm (χ : Ω X.right (underTopBasepoint X)))

/-- Helper for Theorem 8.6.6: postcomposition with loop reversal induces a bijection on
`Ho*[Z, Ωᵇ X]`. -/
private theorem basedHomotopyClassesPostcompose_bijective_loopBasedSpaceNeg
    (Z : BasedSpace) (X : BasedSpace) :
    Function.Bijective (basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X)) := by
  -- The strict involution on `Ωᵇ X` becomes a strict involution on based homotopy classes.
  exact basedHomotopyClassesPostcompose_bijective_of_inverse Z
    (loopBasedSpaceNeg X) (loopBasedSpaceNeg X)
    (loopBasedSpaceNeg_self_inverse X) (loopBasedSpaceNeg_self_inverse X)

/-- Helper for Theorem 8.6.6: the coordinate swap on `Ω²Y` is a strict involution. -/
private theorem doubleLoopCoordinateSwap_self_inverse (Y : BasedSpace) :
    doubleLoopCoordinateSwap Y ≫ doubleLoopCoordinateSwap Y = 𝟙 (Ωᵇ (Ωᵇ Y)) := by
  -- Swapping the two loop parameters twice is the identity pointwise.
  ext χ
  apply Path.ext
  funext t
  apply Path.ext
  funext s
  -- The normalized target is exactly the coordinate-swap formula from Lemma 8.6.8.
  simpa using
    (doubleLoopCoordinateSwap_hom_apply (Y := Y) (χ := χ) (s := s) (t := t))

/-- Helper for Theorem 8.6.6: postcomposition with the double-loop coordinate swap induces a
bijection on `Ho*[Z, Ω²Y]`. -/
private theorem basedHomotopyClassesPostcompose_bijective_doubleLoopCoordinateSwap
    (Z : BasedSpace) (Y : BasedSpace) :
    Function.Bijective (basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap Y)) := by
  -- The strict involution on `Ω²Y` again gives a strict inverse on `Ho*[Z, -]`.
  exact basedHomotopyClassesPostcompose_bijective_of_inverse Z
    (doubleLoopCoordinateSwap Y) (doubleLoopCoordinateSwap Y)
    (doubleLoopCoordinateSwap_self_inverse Y) (doubleLoopCoordinateSwap_self_inverse Y)

/-- Helper for Theorem 8.6.6: the source-side signed coordinate swap from Lemma 8.6.8 induces a
bijection on `Ho*[Z, Ω²Y]`. -/
private theorem basedHomotopyClassesPostcompose_bijective_doubleLoopTailTwist
    (Z : BasedSpace) (Y : BasedSpace) :
    Function.Bijective
      (basedHomotopyClassesPostcompose Z
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y)) := by
  -- Factor the source twist into outer loop reversal and coordinate swap.
  have hNeg :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z (signedLoopBasedMap (𝟙 (Ωᵇ Y)))) := by
    simpa [signedLoopBasedMap] using
      basedHomotopyClassesPostcompose_bijective_loopBasedSpaceNeg Z (Ωᵇ Y)
  have hSwap :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap Y)) := by
    exact basedHomotopyClassesPostcompose_bijective_doubleLoopCoordinateSwap Z Y
  have hComp :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z (signedLoopBasedMap (𝟙 (Ωᵇ Y))) ≫
          basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap Y)) := by
    simpa [Function.comp] using Function.Bijective.comp hSwap hNeg
  -- Rewrite the composite through postcomposition functoriality.
  have hFactor :
      basedHomotopyClassesPostcompose Z
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
        basedHomotopyClassesPostcompose Z (signedLoopBasedMap (𝟙 (Ωᵇ Y))) ≫
          basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap Y) := by
    symm
    exact basedHomotopyClassesPostcompose_comp Z
      (signedLoopBasedMap (𝟙 (Ωᵇ Y))) (doubleLoopCoordinateSwap Y)
  rw [hFactor]
  exact hComp

/-- Helper for Theorem 8.6.6: looping the identity based map is strictly the identity on loop
spaces. -/
private theorem loopBasedMap_id (A : BasedSpace) :
    loopBasedMap (𝟙 A) = 𝟙 (Ωᵇ A) := by
  -- Both based maps evaluate each source loop pointwise without changing its parameter.
  ext χ
  apply Path.ext
  funext t
  change loopBasedMapPath (𝟙 A) χ t = χ.1 t
  simp [loopBasedMapPath_apply]

/-- Helper for Theorem 8.6.6: looping a composite agrees strictly with composing the looped
maps. -/
private theorem loopBasedMap_comp {A B C : BasedSpace} (u : A ⟶ B) (v : B ⟶ C) :
    loopBasedMap (u ≫ v) = loopBasedMap u ≫ loopBasedMap v := by
  -- Compare both composites pointwise on a source loop and evaluate both maps at the same time.
  ext χ
  apply Path.ext
  funext t
  change loopBasedMapPath (u ≫ v) χ t = loopBasedMapPath v (loopBasedMapPath u χ) t
  simp [loopBasedMapPath_apply]

/-- Helper for Theorem 8.6.6: loop reversal commutes with the functorial loop map. -/
private theorem loopBasedSpaceNeg_natural {A B : BasedSpace} (u : A ⟶ B) :
    loopBasedSpaceNeg A ≫ loopBasedMap u = loopBasedMap u ≫ loopBasedSpaceNeg B := by
  -- Both composites apply `u` to the same reversed parameter of the source loop.
  ext χ
  apply Path.ext
  funext t
  change loopBasedMapPath u (loopBasedSpaceNegPath A χ) t =
    loopBasedSpaceNegPath B (loopBasedMapPath u χ) t
  simp [loopBasedMapPath_apply, loopBasedSpaceNegPath_apply]

/-- Helper for Theorem 8.6.6: the signed loop map of the identity is just loop reversal. -/
private theorem signedLoopBasedMap_id_eq_loopBasedSpaceNeg (A : BasedSpace) :
    signedLoopBasedMap (𝟙 A) = loopBasedSpaceNeg A := by
  -- The functorial part is the identity, so only the sign convention remains.
  simpa [signedLoopBasedMap, loopBasedMap_id]

/-- Helper for Theorem 8.6.6: a signed loop map followed by an ordinary loop map is the signed
loop map of the composite. -/
private theorem signedLoopBasedMap_comp_loopBasedMap {A B C : BasedSpace}
    (u : A ⟶ B) (v : B ⟶ C) :
    signedLoopBasedMap u ≫ loopBasedMap v = signedLoopBasedMap (u ≫ v) := by
  -- Evaluate both composites pointwise and use the same reversed target parameter on each side.
  ext χ
  apply Path.ext
  funext t
  change (((loopBasedMap v).right.hom ((signedLoopBasedMap u).right.hom χ)).1 t) =
    (((signedLoopBasedMap (u ≫ v)).right.hom χ).1 t)
  rw [signedLoopBasedMap_hom_apply, signedLoopBasedMap_hom_apply]
  change loopBasedMapPath v (loopBasedSpaceNegPath B (loopBasedMapPath u χ)) t =
    loopBasedSpaceNegPath C (loopBasedMapPath (u ≫ v) χ) t
  simp [loopBasedMapPath_apply, loopBasedSpaceNegPath_apply]

/-- Helper for Theorem 8.6.6: an ordinary loop map followed by a signed loop map is the signed
loop map of the composite. -/
private theorem loopBasedMap_comp_signedLoopBasedMap {A B C : BasedSpace}
    (u : A ⟶ B) (v : B ⟶ C) :
    loopBasedMap u ≫ signedLoopBasedMap v = signedLoopBasedMap (u ≫ v) := by
  -- Evaluate both composites pointwise and note that both sides reverse only the final target
  -- parameter.
  ext χ
  apply Path.ext
  funext t
  change (((signedLoopBasedMap v).right.hom ((loopBasedMap u).right.hom χ)).1 t) =
    (((signedLoopBasedMap (u ≫ v)).right.hom χ).1 t)
  rw [signedLoopBasedMap_hom_apply, signedLoopBasedMap_hom_apply]
  change loopBasedSpaceNegPath C (loopBasedMapPath v (loopBasedMapPath u χ)) t =
    loopBasedSpaceNegPath C (loopBasedMapPath (u ≫ v) χ) t
  simp [loopBasedMapPath_apply, loopBasedSpaceNegPath_apply]

/-- Helper for Theorem 8.6.6: composing two signed loop maps cancels the two sign changes and
leaves the ordinary loop map of the composite. -/
private theorem signedLoopBasedMap_comp_signedLoopBasedMap {A B C : BasedSpace}
    (u : A ⟶ B) (v : B ⟶ C) :
    signedLoopBasedMap u ≫ signedLoopBasedMap v = loopBasedMap (u ≫ v) := by
  -- Normalize the first two factors to one signed loop map, then cancel the final loop reversal.
  calc
    signedLoopBasedMap u ≫ signedLoopBasedMap v =
        signedLoopBasedMap u ≫ loopBasedMap v ≫ loopBasedSpaceNeg C := by
          simp [signedLoopBasedMap, Category.assoc]
    _ = signedLoopBasedMap (u ≫ v) ≫ loopBasedSpaceNeg C := by
          simpa [Category.assoc] using
            congrArg
              (fun k : Ωᵇ A ⟶ Ωᵇ C ↦ k ≫ loopBasedSpaceNeg C)
              (signedLoopBasedMap_comp_loopBasedMap u v)
    _ = loopBasedMap (u ≫ v) := by
          simp [signedLoopBasedMap, Category.assoc, loopBasedSpaceNeg_self_inverse]

/-- Helper for Theorem 8.6.6: evaluating a signed loop map applies the underlying based map to
the reversed loop parameter. -/
private theorem signedLoopBasedMap_apply_apply {X Y : BasedSpace} (f : X ⟶ Y)
    (χ : Ω X.right (underTopBasepoint X)) (t : I) :
    (((signedLoopBasedMap f).right.hom χ).1 t) =
      f.right.hom (χ (unitInterval.symm t)) := by
  -- Unfold the sign convention into path reversal after the ordinary loop map.
  rw [signedLoopBasedMap_hom_apply]
  simp [loopBasedSpaceNegPath, loopBasedMapPath]

/-- Helper for Theorem 8.6.6: the source-side twist on `Ω²Y` has the opposite-order composite as
its strict inverse. -/
private theorem doubleLoopTailTwist_left_inverse (Y : BasedSpace) :
    (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
        (doubleLoopCoordinateSwap Y ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y))) =
      𝟙 (Ωᵇ (Ωᵇ Y)) := by
  -- Collapse the middle coordinate swaps first, then rewrite the remaining sign maps as loop
  -- reversal on `Ωᵇ Y`.
  calc
    (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
        (doubleLoopCoordinateSwap Y ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y))) =
      signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y ≫
        doubleLoopCoordinateSwap Y ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y)) := by
          simp [Category.assoc]
    _ = signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y)) := by
          simpa [Category.assoc] using
            congrArg
              (fun k : Ωᵇ (Ωᵇ Y) ⟶ Ωᵇ (Ωᵇ Y) ↦
                signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ k ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y)))
              (doubleLoopCoordinateSwap_self_inverse Y)
    _ = 𝟙 (Ωᵇ (Ωᵇ Y)) := by
          simpa [signedLoopBasedMap_id_eq_loopBasedSpaceNeg] using
            loopBasedSpaceNeg_self_inverse (Ωᵇ Y)

/-- Helper for Theorem 8.6.6: the source-side twist inverse also cancels on the other side. -/
private theorem doubleLoopTailTwist_right_inverse (Y : BasedSpace) :
    (doubleLoopCoordinateSwap Y ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y))) ≫
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
      𝟙 (Ωᵇ (Ωᵇ Y)) := by
  -- Collapse the middle sign maps first, then use that the remaining coordinate swaps square to
  -- the identity.
  calc
    (doubleLoopCoordinateSwap Y ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y))) ≫
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
      doubleLoopCoordinateSwap Y ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫
        signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y := by
          simp [Category.assoc]
    _ = doubleLoopCoordinateSwap Y ≫ doubleLoopCoordinateSwap Y := by
          simpa [Category.assoc, signedLoopBasedMap_id_eq_loopBasedSpaceNeg] using
            congrArg
              (fun k : Ωᵇ (Ωᵇ Y) ⟶ Ωᵇ (Ωᵇ Y) ↦
                doubleLoopCoordinateSwap Y ≫ k ≫ doubleLoopCoordinateSwap Y)
              (loopBasedSpaceNeg_self_inverse (Ωᵇ Y))
    _ = 𝟙 (Ωᵇ (Ωᵇ Y)) := doubleLoopCoordinateSwap_self_inverse Y

/-- Helper for Theorem 8.6.6: after the stage-3 comparison, the next comparison square is
normalized by `doubleLoopCoordinateSwap X`, not by `Ω(loopBasedSpaceNeg X)`. -/
private theorem stageFourLoopShiftCompatibility {X Y : BasedSpace} (f : X ⟶ Y) :
    signedLoopBasedMap (signedLoopBasedMap f) ≫
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
      doubleLoopCoordinateSwap X ≫ signedLoopBasedMap (loopBasedMap f) := by
  -- Compare both composites pointwise on a double loop and normalize them to the same formula
  -- `f.right.hom (χ t (unitInterval.symm s))`.
  ext χ
  apply Path.ext
  funext s
  apply Path.ext
  funext t
  change
    ((((doubleLoopCoordinateSwap Y).right.hom
        ((signedLoopBasedMap (𝟙 (Ωᵇ Y))).right.hom
          ((signedLoopBasedMap (signedLoopBasedMap f)).right.hom χ))).1 s).1 t) =
      ((((signedLoopBasedMap (loopBasedMap f)).right.hom
          ((doubleLoopCoordinateSwap X).right.hom χ)).1 s).1 t)
  rw [doubleLoopCoordinateSwap_hom_apply]
  change
    ((((signedLoopBasedMap (𝟙 (Ωᵇ Y))).right.hom
        ((signedLoopBasedMap (signedLoopBasedMap f)).right.hom χ)).1 t).1 s) =
      ((((signedLoopBasedMap (loopBasedMap f)).right.hom
          ((doubleLoopCoordinateSwap X).right.hom χ)).1 s).1 t)
  have hOuter :
      ((((signedLoopBasedMap (𝟙 (Ωᵇ Y))).right.hom
          ((signedLoopBasedMap (signedLoopBasedMap f)).right.hom χ)).1 t).1 s) =
        ((((signedLoopBasedMap (signedLoopBasedMap f)).right.hom χ).1
            (unitInterval.symm t)).1 s) := by
    -- Evaluate the outer signed identity map before simplifying the remaining signed source map.
    exact congrArg
      (fun γ : Ω Y.right (underTopBasepoint Y) ↦ γ s)
      (signedLoopBasedMap_apply_apply
        (f := 𝟙 (Ωᵇ Y))
        (χ := ((signedLoopBasedMap (signedLoopBasedMap f)).right.hom χ))
        (t := t))
  have hInner :
      ((((signedLoopBasedMap (signedLoopBasedMap f)).right.hom χ).1
          (unitInterval.symm t)).1 s) =
        (((signedLoopBasedMap f).right.hom
            (χ.1 (unitInterval.symm (unitInterval.symm t)))).1 s) := by
    -- Evaluate the twice-signed source map at the reversed outer parameter.
    exact congrArg
      (fun γ : Ω Y.right (underTopBasepoint Y) ↦ γ s)
      (signedLoopBasedMap_apply_apply
        (f := signedLoopBasedMap f)
        (χ := χ)
        (t := unitInterval.symm t))
  have hLeftNormalize :
      (((signedLoopBasedMap f).right.hom
          (χ.1 (unitInterval.symm (unitInterval.symm t)))).1 s) =
        f.right.hom
          ((χ.1 (unitInterval.symm (unitInterval.symm t))).1 (unitInterval.symm s)) := by
    -- The remaining signed map contributes the final reversal of the inner loop parameter.
    exact signedLoopBasedMap_apply_apply
      (f := f)
      (χ := χ.1 (unitInterval.symm (unitInterval.symm t)))
      (t := s)
  have hRightNormalize :
      ((((signedLoopBasedMap (loopBasedMap f)).right.hom
            ((doubleLoopCoordinateSwap X).right.hom χ)).1 s).1 t) =
        f.right.hom ((χ.1 t).1 (unitInterval.symm s)) := by
    -- Normalize the right composite by evaluating the outer signed map and then the coordinate
    -- swap inside the looped map.
    have hSwapEval :
        ((((doubleLoopCoordinateSwap X).right.hom χ).1 (unitInterval.symm s)).1 t) =
          ((χ.1 t).1 (unitInterval.symm s)) := by
      -- The coordinate swap exchanges the two loop parameters before `f` is applied.
      simpa using
        (doubleLoopCoordinateSwap_hom_apply
          (Y := X) (χ := χ) (s := unitInterval.symm s) (t := t))
    rw [signedLoopBasedMap_apply_apply
        (f := loopBasedMap f)
        (χ := ((doubleLoopCoordinateSwap X).right.hom χ))
        (t := s)]
    rw [loopBasedMap_hom_apply]
    change
      f.right.hom ((((doubleLoopCoordinateSwap X).right.hom χ).1 (unitInterval.symm s)).1 t) =
        f.right.hom ((χ.1 t).1 (unitInterval.symm s))
    exact congrArg f.right.hom hSwapEval
  calc
    ((((signedLoopBasedMap (𝟙 (Ωᵇ Y))).right.hom
        ((signedLoopBasedMap (signedLoopBasedMap f)).right.hom χ)).1 t).1 s) =
        ((((signedLoopBasedMap (signedLoopBasedMap f)).right.hom χ).1
            (unitInterval.symm t)).1 s) := hOuter
    _ =
        (((signedLoopBasedMap f).right.hom
            (χ.1 (unitInterval.symm (unitInterval.symm t)))).1 s) := hInner
    _ =
        f.right.hom
          ((χ.1 (unitInterval.symm (unitInterval.symm t))).1 (unitInterval.symm s)) := hLeftNormalize
    _ = f.right.hom ((χ.1 t).1 (unitInterval.symm s)) := by simp
    _ =
        ((((signedLoopBasedMap (loopBasedMap f)).right.hom
            ((doubleLoopCoordinateSwap X).right.hom χ)).1 s).1 t) := hRightNormalize.symm

/-- Helper for Theorem 8.6.6: postcomposition with a map and with its homotopy-fiber projection
is exact on based homotopy classes. This auxiliary copy appears before the initial-window proof so
the transport argument can reuse it without rearranging the later file layout. -/
private theorem pointedExact_postcompose_homotopyFiberProjectionAux (Z : BasedSpace)
    {A B : BasedSpace} (g : A ⟶ B) :
    PointedExact
      (basedHomotopyClassesPostcompose Z (homotopyFiberProjection g))
      (basedHomotopyClassesPostcompose Z g) := by
  intro b
  constructor
  · refine Quotient.inductionOn b ?_
    intro h hf
    -- Turn the kernel condition into a representative-level nullhomotopy in `B`.
    have hsetoid :
        (basedHomotopySetoid Z B).r (h ≫ g) (constantBasedMap Z B) := by
      exact Quotient.exact hf
    rcases
        ContinuousMap.HomotopicRel.symm (basedHomotopyRel_of_setoid hsetoid) with
      ⟨H⟩
    let pathLift : C(Z.right, P[underTopBasepoint B]) :=
      { toFun := fun z ↦
          ⟨H.toHomotopy.toPathSpaceMap z, by
            have hzero :
                H.toHomotopy.toPathSpaceMap z 0 = (constantBasedMap Z B).right.hom z := by
              simpa using
                ContinuousMap.congr_fun H.toHomotopy.pathSpaceEvalAtZero_comp_toPathSpaceMap z
            simpa [constantBasedMap] using hzero⟩
        continuous_toFun := by
          exact H.toHomotopy.toPathSpaceMap.continuous.subtype_mk (fun z ↦ by
            have hzero :
                H.toHomotopy.toPathSpaceMap z 0 = (constantBasedMap Z B).right.hom z := by
              simpa using
                ContinuousMap.congr_fun H.toHomotopy.pathSpaceEvalAtZero_comp_toPathSpaceMap z
            simpa [constantBasedMap] using hzero) }
    have hendpoint :
        ∀ z : Z.right, g.right.hom (h.right.hom z) = (pathLift z).endpoint := by
      intro z
      have hone :
          H.toHomotopy.toPathSpaceMap z 1 = (h ≫ g).right.hom z := by
        simpa using
          ContinuousMap.congr_fun (H.toHomotopy.pathSpaceEvalAt_comp_toPathSpaceMap 1) z
      change g.right.hom (h.right.hom z) = H.toHomotopy.toPathSpaceMap z 1
      simpa using hone.symm
    let liftContinuousMap : C(Z.right, HomotopyFiber g) :=
      { toFun := fun z ↦ HomotopyFiber.mk (h.right.hom z) (pathLift z) (hendpoint z)
        continuous_toFun := by
          exact (h.right.hom.continuous.prodMk pathLift.continuous).subtype_mk hendpoint }
    have hlift_basepoint :
        liftContinuousMap (underTopBasepoint Z) = underTopBasepoint (homotopyFiber g) := by
      apply Subtype.ext
      apply Prod.ext
      · -- The point coordinate stays at the basepoint because `h` is a based map.
        change h.right.hom (underTopBasepoint Z) = underTopBasepoint A
        simpa using fundamentalGroupFunctorMap_basepoint h
      · -- The path coordinate is constant because the nullhomotopy is relative to the basepoint.
        apply Subtype.ext
        apply ContinuousMap.ext
        intro t
        have hrel := H.prop' t (underTopBasepoint Z) (by simp)
        simpa [pathLift, underTopBasepoint_homotopyFiber] using hrel
    let lift : Z ⟶ homotopyFiber g :=
      basedMapOfMapToBasedSpace liftContinuousMap hlift_basepoint
    have hproj : lift ≫ homotopyFiberProjection g = h := by
      ext z
      rfl
    -- The lifted representative lands in the required preimage exactly.
    refine ⟨Quotient.mk _ lift, ?_⟩
    simpa [basedHomotopyClassesPostcompose, basedHomotopyClassesPostcomposeFun] using
      congrArg (Quotient.mk (basedHomotopySetoid Z A)) hproj
  · rintro ⟨a, rfl⟩
    refine Quotient.inductionOn a ?_
    intro l
    -- The stored path coordinate of a homotopy-fiber representative gives a nullhomotopy.
    apply Quotient.sound
    change (basedHomotopySetoid Z B).r (l ≫ homotopyFiberProjection g ≫ g) (constantBasedMap Z B)
    rw [basedHomotopySetoid_iff]
    let d : C(Z.right, C(I, B.right)) :=
      { toFun := fun z ↦ (l.right.hom z).path.1
        continuous_toFun := by
          have hpath :
              Continuous fun z : Z.right ↦ HomotopyFiber.path (l.right.hom z) := by
            simpa using (homotopyFiberPathContinuous g).comp l.right.hom.continuous
          exact continuous_subtype_val.comp hpath }
    refine Relation.EqvGen.rel _ _ ?_
    exact ContinuousMap.HomotopicRel.symm ⟨homotopyRelOfPathFamily d
      (fun z ↦ by
        simpa [d, constantBasedMap] using PathSpace.source_eq ((l.right.hom z).path))
      (fun z ↦ by
        simpa [d, PathSpace.endpoint] using (HomotopyFiber.endpoint_eq (l.right.hom z)))
      (fun z hz ↦ by
        rcases Set.mem_singleton_iff.mp hz with rfl
        apply ContinuousMap.ext
        intro t
        have hlbase : l.right.hom (underTopBasepoint Z) = underTopBasepoint (homotopyFiber g) := by
          simpa using fundamentalGroupFunctorMap_basepoint l
        change ((l.right.hom (underTopBasepoint Z)).path.1) t = underTopBasepoint B
        rw [hlbase, underTopBasepoint_homotopyFiber]
        rfl)⟩

/-- Helper for Theorem 8.6.6: the exactness statement at stages `1` and `2` follows by
transporting the stage-0 exactness of `π(f)` across the comparison `Ωᵇ Y ⟶ F_(π(f))`. -/
private theorem fiberSequenceGeneratedByExactInitialWindow {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) :
    PointedExact
      (fiberSequenceGeneratedByPostcompose Z f 2)
      (fiberSequenceGeneratedByPostcompose Z f 1) ∧
    PointedExact
      (fiberSequenceGeneratedByPostcompose Z f 3)
      (fiberSequenceGeneratedByPostcompose Z f 2) := by
  -- Route correction: first prove the stage-1 exactness for `f`, then prove the analogous
  -- stage-1 exactness for `π(f)` and transport it back across `homotopyFiberProjectionComparison`.
  have hComparisonSurj :
      Function.Surjective
        (basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f)) := by
    exact
      (basedHomotopyClassesPostcompose_bijective_homotopyFiberProjectionComparison Z f).surjective
  have hProjectionExact :
      PointedExact
        (basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f) ≫
          basedHomotopyClassesPostcompose Z
            (homotopyFiberProjection (homotopyFiberProjection f)))
        (basedHomotopyClassesPostcompose Z (homotopyFiberProjection f)) := by
    -- Precompose the exact sequence for `π(f)` with the surjective comparison map on `Ho*[Z, -]`.
    exact pointedExact_comp_left_of_surjective
      (basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f))
      (basedHomotopyClassesPostcompose Z
        (homotopyFiberProjection (homotopyFiberProjection f)))
      (basedHomotopyClassesPostcompose Z (homotopyFiberProjection f))
      (pointedExact_postcompose_homotopyFiberProjectionAux Z (homotopyFiberProjection f))
      hComparisonSurj
  have hStageOneMap :
      basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f) ≫
          basedHomotopyClassesPostcompose Z
            (homotopyFiberProjection (homotopyFiberProjection f)) =
        fiberSequenceGeneratedByPostcompose Z f 2 := by
    -- The right triangle of Lemma 8.6.10 identifies the composite with `ι(f)`.
    calc
      basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f) ≫
          basedHomotopyClassesPostcompose Z
            (homotopyFiberProjection (homotopyFiberProjection f)) =
        basedHomotopyClassesPostcompose Z
          (homotopyFiberProjectionComparison f ≫
            homotopyFiberProjection (homotopyFiberProjection f)) := by
              exact basedHomotopyClassesPostcompose_comp Z
                (homotopyFiberProjectionComparison f)
                (homotopyFiberProjection (homotopyFiberProjection f))
      _ = basedHomotopyClassesPostcompose Z (homotopyFiberLoopInclusion f) := by
            rw [homotopyFiberProjectionComparison_comp_homotopyFiberProjection]
      _ = fiberSequenceGeneratedByPostcompose Z f 2 := by
            rfl
  have hStageOne :
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f 2)
        (fiberSequenceGeneratedByPostcompose Z f 1) := by
    -- Rewrite the precomposed exactness statement into the displayed stage-1 pair.
    rwa [← hStageOneMap]
  have hProjectionComparisonSurj :
      Function.Surjective
        (basedHomotopyClassesPostcompose Z
          (homotopyFiberProjectionComparison (homotopyFiberProjection f))) := by
    exact
      (basedHomotopyClassesPostcompose_bijective_homotopyFiberProjectionComparison Z
        (homotopyFiberProjection f)).surjective
  have hProjectionStageOneRaw :
      PointedExact
        (basedHomotopyClassesPostcompose Z
          (homotopyFiberProjectionComparison (homotopyFiberProjection f)) ≫
            basedHomotopyClassesPostcompose Z
              (homotopyFiberProjection
                (homotopyFiberProjection (homotopyFiberProjection f))))
        (basedHomotopyClassesPostcompose Z
          (homotopyFiberProjection (homotopyFiberProjection f))) := by
    -- Apply the same stage-1 transport to the projection map `π(f)`.
    exact pointedExact_comp_left_of_surjective
      (basedHomotopyClassesPostcompose Z
        (homotopyFiberProjectionComparison (homotopyFiberProjection f)))
      (basedHomotopyClassesPostcompose Z
        (homotopyFiberProjection
          (homotopyFiberProjection (homotopyFiberProjection f))))
      (basedHomotopyClassesPostcompose Z
        (homotopyFiberProjection (homotopyFiberProjection f)))
      (pointedExact_postcompose_homotopyFiberProjectionAux Z
        (homotopyFiberProjection (homotopyFiberProjection f)))
      hProjectionComparisonSurj
  have hProjectionStageOneMap :
      basedHomotopyClassesPostcompose Z
          (homotopyFiberProjectionComparison (homotopyFiberProjection f)) ≫
            basedHomotopyClassesPostcompose Z
              (homotopyFiberProjection
                (homotopyFiberProjection (homotopyFiberProjection f))) =
        basedHomotopyClassesPostcompose Z
          (homotopyFiberLoopInclusion (homotopyFiberProjection f)) := by
    -- The same comparison square identifies the stage-1 composite for `π(f)`.
    calc
      basedHomotopyClassesPostcompose Z
          (homotopyFiberProjectionComparison (homotopyFiberProjection f)) ≫
            basedHomotopyClassesPostcompose Z
              (homotopyFiberProjection
                (homotopyFiberProjection (homotopyFiberProjection f))) =
        basedHomotopyClassesPostcompose Z
          (homotopyFiberProjectionComparison (homotopyFiberProjection f) ≫
            homotopyFiberProjection
              (homotopyFiberProjection (homotopyFiberProjection f))) := by
              exact basedHomotopyClassesPostcompose_comp Z
                (homotopyFiberProjectionComparison (homotopyFiberProjection f))
                (homotopyFiberProjection
                  (homotopyFiberProjection (homotopyFiberProjection f)))
      _ = basedHomotopyClassesPostcompose Z
            (homotopyFiberLoopInclusion (homotopyFiberProjection f)) := by
              rw [homotopyFiberProjectionComparison_comp_homotopyFiberProjection]
  have hProjectionStageOne :
      PointedExact
        (basedHomotopyClassesPostcompose Z
          (homotopyFiberLoopInclusion (homotopyFiberProjection f)))
        (basedHomotopyClassesPostcompose Z
          (homotopyFiberProjection (homotopyFiberProjection f))) := by
    -- Normalize the left map to the stage-1 loop inclusion for `π(f)`.
    rwa [← hProjectionStageOneMap]
  have hStageTwoAlpha :
      basedHomotopyClassesPostcompose Z (signedLoopBasedMap f) ≫
          basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f) =
        basedHomotopyClassesPostcompose Z
          (homotopyFiberLoopInclusion (homotopyFiberProjection f)) := by
    -- The left triangle of Lemma 8.6.10 commutes up to based homotopy.
    calc
      basedHomotopyClassesPostcompose Z (signedLoopBasedMap f) ≫
          basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f) =
        basedHomotopyClassesPostcompose Z
          (signedLoopBasedMap f ≫ homotopyFiberProjectionComparison f) := by
              exact basedHomotopyClassesPostcompose_comp Z
                (signedLoopBasedMap f) (homotopyFiberProjectionComparison f)
      _ = basedHomotopyClassesPostcompose Z
            (homotopyFiberLoopInclusion (homotopyFiberProjection f)) := by
            exact postcomposeEq_ofHomotopicUnder Z
              (homotopyFiberProjectionComparison_comp_signedLoopBasedMap_homotopic f)
  have hStageTwoBeta :
      basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f) ≫
          basedHomotopyClassesPostcompose Z
            (homotopyFiberProjection (homotopyFiberProjection f)) =
        fiberSequenceGeneratedByPostcompose Z f 2 := by
    -- Reuse the stage-1 normalization of the right triangle.
    exact hStageOneMap
  have hStageTwo :
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f 3)
        (fiberSequenceGeneratedByPostcompose Z f 2) := by
    -- Transport the exact stage-1 sequence for `π(f)` back across the comparison bijection.
    refine pointedExact_transport_bijective
      (basedHomotopyClassesPostcompose Z (homotopyFiberProjectionComparison f))
      (basedHomotopyClassesPostcompose Z
        (homotopyFiberLoopInclusion (homotopyFiberProjection f)))
      (basedHomotopyClassesPostcompose Z
        (homotopyFiberProjection (homotopyFiberProjection f)))
      (fiberSequenceGeneratedByPostcompose Z f 3)
      (fiberSequenceGeneratedByPostcompose Z f 2)
      hStageTwoAlpha hStageTwoBeta
      (basedHomotopyClassesPostcompose_bijective_homotopyFiberProjectionComparison Z f)
      hProjectionStageOne
  exact ⟨hStageOne, hStageTwo⟩

-- The main theorem below uses the standard stage-0 fiber-projection exactness lemma and then
-- should transport it through the Chapter 8 comparison maps.

/-- Helper for Theorem 8.6.6: postcomposition with a map and with its homotopy-fiber projection
is exact on based homotopy classes. -/
private theorem pointedExact_postcompose_homotopyFiberProjection (Z : BasedSpace)
    {A B : BasedSpace} (g : A ⟶ B) :
    PointedExact
      (basedHomotopyClassesPostcompose Z (homotopyFiberProjection g))
      (basedHomotopyClassesPostcompose Z g) := by
  -- Reuse the earlier auxiliary proof to keep the file order stable.
  simpa using pointedExact_postcompose_homotopyFiberProjectionAux Z g

/-- Helper for Theorem 8.6.6: the exactness statement starts with the homotopy-fiber projection
pair `F_f ⟶ X ⟶ Y`. -/
private theorem fiberSequenceGeneratedBy_basedHomotopyClasses_exact_zero
    {X Y : BasedSpace} (f : X ⟶ Y) (Z : BasedSpace) :
    PointedExact
      (fiberSequenceGeneratedByPostcompose Z f 1)
      (fiberSequenceGeneratedByPostcompose Z f 0) := by
  -- The first two arrows are literally `homotopyFiberProjection f` and `f`.
  simpa [fiberSequenceGeneratedByPostcompose] using
    pointedExact_postcompose_homotopyFiberProjection Z f

/-- Helper for Theorem 8.6.6: exactness for the pair `(n + 1, n)` in the fiber sequence of
`loopBasedMap f` transports to exactness for the pair `(n + 4, n + 3)` in the fiber sequence of
`f`. -/
private theorem fiberSequenceGeneratedByExactStageFour {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) :
    PointedExact
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1)
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 0) →
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f 4)
        (fiberSequenceGeneratedByPostcompose Z f 3) := by
  intro hExact
  have hSourceSurj :
      Function.Surjective
        (basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom) := by
    -- The loop-homotopy-fiber comparison is a strict homeomorphism, so it is surjective on
    -- based homotopy classes.
    exact
      (basedHomotopyClassesPostcompose_bijective_of_inverse Z
        (loopHomotopyFiberIso f).hom (loopHomotopyFiberIso f).inv
        (by simpa using (loopHomotopyFiberIso f).hom_inv_id)
        (by simpa using (loopHomotopyFiberIso f).inv_hom_id)).surjective
  have hSourceExact :
      PointedExact
        (basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1)
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 0) := by
    -- Precompose the source exact pair with the surjective loop-homotopy-fiber comparison.
    exact pointedExact_comp_left_of_surjective
      (basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom)
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1)
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 0)
      hExact hSourceSurj
  have hMiddleBij :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X)) := by
    -- Loop reversal is a strict involution on `Ωᵇ X`.
    exact basedHomotopyClassesPostcompose_bijective_loopBasedSpaceNeg Z X
  have hAlpha :
      fiberSequenceGeneratedByPostcompose Z f 4 ≫
          basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X) =
        basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1 := by
    -- Normalize the stage-4 map through Lemma 8.6.8 and cancel the terminal loop reversal.
    have hMap4 :
        (fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X =
          (loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f) := by
      calc
        (fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X =
            signedLoopBasedMap (homotopyFiberProjection f) ≫ loopBasedSpaceNeg X := by
              rfl
        _ = ((loopHomotopyFiberIso f).hom ≫
              homotopyFiberProjection (loopBasedMap f) ≫
                loopBasedSpaceNeg X) ≫ loopBasedSpaceNeg X := by
              rw [loopHomotopyFiberHomeomorph_projection f]
        _ = (loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f) := by
              simp [Category.assoc, loopBasedSpaceNeg_self_inverse]
    have hComp :
        basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom ≫
            fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1 =
          basedHomotopyClassesPostcompose Z
            ((loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f)) := by
      simpa [fiberSequenceGeneratedByPostcompose] using
        basedHomotopyClassesPostcompose_comp Z
          (loopHomotopyFiberIso f).hom
          (homotopyFiberProjection (loopBasedMap f))
    have hFirst :
        fiberSequenceGeneratedByPostcompose Z f 4 ≫
            basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X) =
          basedHomotopyClassesPostcompose Z
            ((loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f)) := by
      simpa [hMap4, fiberSequenceGeneratedByPostcompose] using
        (basedHomotopyClassesPostcompose_comp Z
          ((fiberSequenceGeneratedBy f).map 4)
          (loopBasedSpaceNeg X))
    exact hFirst.trans hComp.symm
  have hBeta :
      basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X) ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 0 =
        fiberSequenceGeneratedByPostcompose Z f 3 := by
    -- The right square is just naturality of loop reversal.
    have hMap3 :
        loopBasedSpaceNeg X ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map 0 =
          (fiberSequenceGeneratedBy f).map 3 := by
      simpa [fiberSequenceGeneratedBy_map, signedLoopBasedMap] using
        (loopBasedSpaceNeg_natural f)
    have hFirst :
        basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X) ≫
            fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 0 =
          basedHomotopyClassesPostcompose Z ((fiberSequenceGeneratedBy f).map 3) := by
      simpa [hMap3, fiberSequenceGeneratedByPostcompose] using
        (basedHomotopyClassesPostcompose_comp Z
          (loopBasedSpaceNeg X)
          ((fiberSequenceGeneratedBy (loopBasedMap f)).map 0))
    simpa [fiberSequenceGeneratedByPostcompose] using hFirst
  -- Transport exactness across the middle loop-reversal bijection.
  exact pointedExact_transport_bijective
    (basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X))
    (basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom ≫
      fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1)
    (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 0)
    (fiberSequenceGeneratedByPostcompose Z f 4)
    (fiberSequenceGeneratedByPostcompose Z f 3)
    hAlpha hBeta hMiddleBij hSourceExact

/-- Helper for Theorem 8.6.6: exactness at stage `(2, 1)` for `fiberSequenceGeneratedBy
(loopBasedMap f)` transports to stage `(5, 4)` for `fiberSequenceGeneratedBy f`. -/
private theorem fiberSequenceGeneratedByExactStageFive {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) :
    PointedExact
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2)
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1) →
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f 5)
        (fiberSequenceGeneratedByPostcompose Z f 4) := by
  intro hExact
  have hSourceSurj :
      Function.Surjective
        (basedHomotopyClassesPostcompose Z
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y)) := by
    -- The source-side double-loop twist is a strict automorphism on `Ω²Y`.
    exact
      (basedHomotopyClassesPostcompose_bijective_doubleLoopTailTwist Z Y).surjective
  have hSourceExact :
      PointedExact
        (basedHomotopyClassesPostcompose Z
            (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2)
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1) := by
    -- Precompose the source exact pair with the source-side twist.
    exact pointedExact_comp_left_of_surjective
      (basedHomotopyClassesPostcompose Z
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y))
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2)
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1)
      hExact hSourceSurj
  have hMiddleBij :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom) := by
    -- The loop-homotopy-fiber comparison is again a strict homeomorphism.
    exact
      basedHomotopyClassesPostcompose_bijective_of_inverse Z
        (loopHomotopyFiberIso f).hom (loopHomotopyFiberIso f).inv
        (by simpa using (loopHomotopyFiberIso f).hom_inv_id)
        (by simpa using (loopHomotopyFiberIso f).inv_hom_id)
  have hLoopNegInj :
      Function.Injective
        (basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X)) := by
    exact (basedHomotopyClassesPostcompose_bijective_loopBasedSpaceNeg Z X).injective
  have hAlpha :
      fiberSequenceGeneratedByPostcompose Z f 5 ≫
          basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom =
        basedHomotopyClassesPostcompose Z
            (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2 := by
    -- Lemma 8.6.8 identifies the looped fiber inclusion after the source-side twist.
    have hMap5 :
        (fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom =
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
            homotopyFiberLoopInclusion (loopBasedMap f) := by
      calc
        (fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom =
            signedLoopBasedMap (homotopyFiberLoopInclusion f) ≫ (loopHomotopyFiberIso f).hom := by
              rfl
        _ = (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
              homotopyFiberLoopInclusion (loopBasedMap f) := by
              simpa [Category.assoc] using loopHomotopyFiberHomeomorph_loopInclusion f
    have hComp :
        basedHomotopyClassesPostcompose Z
            (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2 =
          basedHomotopyClassesPostcompose Z
            ((signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
              homotopyFiberLoopInclusion (loopBasedMap f)) := by
      simpa [fiberSequenceGeneratedByPostcompose] using
        basedHomotopyClassesPostcompose_comp Z
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y)
          (homotopyFiberLoopInclusion (loopBasedMap f))
    have hFirst :
        fiberSequenceGeneratedByPostcompose Z f 5 ≫
            basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom =
          basedHomotopyClassesPostcompose Z
            ((signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
              homotopyFiberLoopInclusion (loopBasedMap f)) := by
      simpa [hMap5, fiberSequenceGeneratedByPostcompose] using
        (basedHomotopyClassesPostcompose_comp Z
          ((fiberSequenceGeneratedBy f).map 5)
          ((loopHomotopyFiberIso f).hom))
    exact hFirst.trans hComp.symm
  have hBeta :
      basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1 =
        fiberSequenceGeneratedByPostcompose Z f 4 ≫
          basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X) := by
    -- The projection square from Lemma 8.6.8 matches the middle terms after one extra loop
    -- reversal on `Ωᵇ X`.
    have hMap4 :
        (loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f) =
          (fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X := by
      calc
        (loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f) =
            ((loopHomotopyFiberIso f).hom ≫
              homotopyFiberProjection (loopBasedMap f) ≫
                loopBasedSpaceNeg X) ≫ loopBasedSpaceNeg X := by
              simp [Category.assoc, loopBasedSpaceNeg_self_inverse]
        _ = signedLoopBasedMap (homotopyFiberProjection f) ≫ loopBasedSpaceNeg X := by
              rw [loopHomotopyFiberHomeomorph_projection f]
        _ = (fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X := by
              rfl
    have hComp :
        fiberSequenceGeneratedByPostcompose Z f 4 ≫
            basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X) =
          basedHomotopyClassesPostcompose Z
            ((fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X) := by
      simp [fiberSequenceGeneratedByPostcompose, basedHomotopyClassesPostcompose_comp]
    have hFirst :
        basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom ≫
            fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1 =
          basedHomotopyClassesPostcompose Z ((fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X) := by
      simpa [hMap4, fiberSequenceGeneratedByPostcompose] using
        (basedHomotopyClassesPostcompose_comp Z
          (loopHomotopyFiberIso f).hom
          (homotopyFiberProjection (loopBasedMap f)))
    exact hFirst.trans hComp.symm
  have hTransported :
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f 5)
        (fiberSequenceGeneratedByPostcompose Z f 4 ≫
          basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X)) := by
    -- Transport exactness across the loop-homotopy-fiber comparison.
    exact pointedExact_transport_bijective
      (basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom)
      (basedHomotopyClassesPostcompose Z
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
        fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2)
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 1)
      (fiberSequenceGeneratedByPostcompose Z f 5)
      (fiberSequenceGeneratedByPostcompose Z f 4 ≫
        basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X))
      hAlpha hBeta hMiddleBij hSourceExact
  -- Finally cancel the trailing loop reversal on the codomain.
  exact pointedExact_cancel_right_of_injective
    (fiberSequenceGeneratedByPostcompose Z f 5)
    (fiberSequenceGeneratedByPostcompose Z f 4)
    (basedHomotopyClassesPostcompose Z (loopBasedSpaceNeg X))
    hTransported hLoopNegInj

/-- Helper for Theorem 8.6.6: exactness at stage `(3, 2)` for `fiberSequenceGeneratedBy
(loopBasedMap f)` transports to stage `(6, 5)` for `fiberSequenceGeneratedBy f`. -/
private theorem fiberSequenceGeneratedByExactStageSix {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) :
    PointedExact
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 3)
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2) →
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f 6)
        (fiberSequenceGeneratedByPostcompose Z f 5) := by
  intro hExact
  have hSourceSurj :
      Function.Surjective
        (basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap X)) := by
    -- The coordinate swap on `Ω²X` is a strict involution.
    exact
      (basedHomotopyClassesPostcompose_bijective_doubleLoopCoordinateSwap Z X).surjective
  have hSourceExact :
      PointedExact
        (basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap X) ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 3)
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2) := by
    -- Precompose the source exact pair with the source-side coordinate swap.
    exact pointedExact_comp_left_of_surjective
      (basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap X))
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 3)
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2)
      hExact hSourceSurj
  have hMiddleBij :
      Function.Bijective
        (basedHomotopyClassesPostcompose Z
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y)) := by
    -- The source-side twist on `Ω²Y` is a strict automorphism.
    exact basedHomotopyClassesPostcompose_bijective_doubleLoopTailTwist Z Y
  have hLoopIsoInj :
      Function.Injective
        (basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom) := by
    exact
      (basedHomotopyClassesPostcompose_bijective_of_inverse Z
        (loopHomotopyFiberIso f).hom (loopHomotopyFiberIso f).inv
        (by simpa using (loopHomotopyFiberIso f).hom_inv_id)
        (by simpa using (loopHomotopyFiberIso f).inv_hom_id)).injective
  have hAlpha :
      fiberSequenceGeneratedByPostcompose Z f 6 ≫
          basedHomotopyClassesPostcompose Z
            (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
        basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap X) ≫
          fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 3 := by
    -- The stage-4 compatibility lemma is the corrected normal form for the next tail square.
    have hMap6 :
        (fiberSequenceGeneratedBy f).map 6 ≫
            (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
          doubleLoopCoordinateSwap X ≫ signedLoopBasedMap (loopBasedMap f) := by
      calc
        (fiberSequenceGeneratedBy f).map 6 ≫
            (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
          signedLoopBasedMap (signedLoopBasedMap f) ≫
            (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) := by
              rfl
        _ = doubleLoopCoordinateSwap X ≫ signedLoopBasedMap (loopBasedMap f) := by
              exact stageFourLoopShiftCompatibility f
    have hComp :
        basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap X) ≫
            fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 3 =
          basedHomotopyClassesPostcompose Z
            (doubleLoopCoordinateSwap X ≫ signedLoopBasedMap (loopBasedMap f)) := by
      simpa [fiberSequenceGeneratedByPostcompose] using
        basedHomotopyClassesPostcompose_comp Z
          (doubleLoopCoordinateSwap X)
          (signedLoopBasedMap (loopBasedMap f))
    have hFirst :
        fiberSequenceGeneratedByPostcompose Z f 6 ≫
            basedHomotopyClassesPostcompose Z
              (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
          basedHomotopyClassesPostcompose Z
            (doubleLoopCoordinateSwap X ≫ signedLoopBasedMap (loopBasedMap f)) := by
      simpa [hMap6, fiberSequenceGeneratedByPostcompose] using
        (basedHomotopyClassesPostcompose_comp Z
          ((fiberSequenceGeneratedBy f).map 6)
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y))
    exact hFirst.trans hComp.symm
  have hBeta :
      basedHomotopyClassesPostcompose Z
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
            fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2 =
        fiberSequenceGeneratedByPostcompose Z f 5 ≫
          basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom := by
    -- Lemma 8.6.8 identifies the middle square after composing the codomain with
    -- `loopHomotopyFiberIso`.
    have hMap5 :
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
            homotopyFiberLoopInclusion (loopBasedMap f) =
          (fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom := by
      calc
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
            homotopyFiberLoopInclusion (loopBasedMap f) =
          signedLoopBasedMap (homotopyFiberLoopInclusion f) ≫ (loopHomotopyFiberIso f).hom := by
              simpa [Category.assoc] using (loopHomotopyFiberHomeomorph_loopInclusion f).symm
        _ = (fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom := by
              rfl
    have hComp :
        fiberSequenceGeneratedByPostcompose Z f 5 ≫
            basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom =
          basedHomotopyClassesPostcompose Z
            ((fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom) := by
      simp [fiberSequenceGeneratedByPostcompose, basedHomotopyClassesPostcompose_comp]
    have hFirst :
        basedHomotopyClassesPostcompose Z
            (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
              fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2 =
          basedHomotopyClassesPostcompose Z ((fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom) := by
      simpa [hMap5, fiberSequenceGeneratedByPostcompose] using
        (basedHomotopyClassesPostcompose_comp Z
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y)
          (homotopyFiberLoopInclusion (loopBasedMap f)))
    exact hFirst.trans hComp.symm
  have hTransported :
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f 6)
        (fiberSequenceGeneratedByPostcompose Z f 5 ≫
          basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom) := by
    -- Transport exactness across the corrected middle comparison on `Ω²Y`.
    exact pointedExact_transport_bijective
      (basedHomotopyClassesPostcompose Z
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y))
      (basedHomotopyClassesPostcompose Z (doubleLoopCoordinateSwap X) ≫
        fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 3)
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) 2)
      (fiberSequenceGeneratedByPostcompose Z f 6)
      (fiberSequenceGeneratedByPostcompose Z f 5 ≫
        basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom)
      hAlpha hBeta hMiddleBij hSourceExact
  -- Cancel the comparison on the codomain to recover the displayed stage-5 map.
  exact pointedExact_cancel_right_of_injective
    (fiberSequenceGeneratedByPostcompose Z f 6)
    (fiberSequenceGeneratedByPostcompose Z f 5)
    (basedHomotopyClassesPostcompose Z (loopHomotopyFiberIso f).hom)
    hTransported hLoopIsoInj

/-- Helper for Theorem 8.6.6: the tail transport step is controlled by a package of source,
middle, and codomain raw comparison maps together with strict inverse data and the two raw
transport squares. -/
private structure FiberSequenceGeneratedByTailComparisonData
    (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) where
  /-- The raw comparison on the source term of the exact pair. -/
  sourceMap :
    (fiberSequenceGeneratedBy f).obj (n + 5) ⟶
      (fiberSequenceGeneratedBy (loopBasedMap f)).obj (n + 2)
  /-- A chosen strict inverse for the source comparison. -/
  sourceInv :
    (fiberSequenceGeneratedBy (loopBasedMap f)).obj (n + 2) ⟶
      (fiberSequenceGeneratedBy f).obj (n + 5)
  /-- The source comparison followed by its inverse is the identity. -/
  sourceMap_inv : sourceMap ≫ sourceInv = 𝟙 _
  /-- The source inverse followed by the comparison is the identity. -/
  sourceInv_map : sourceInv ≫ sourceMap = 𝟙 _
  /-- The raw comparison on the middle term of the exact pair. -/
  middleMap :
    (fiberSequenceGeneratedBy f).obj (n + 4) ⟶
      (fiberSequenceGeneratedBy (loopBasedMap f)).obj (n + 1)
  /-- A chosen strict inverse for the middle comparison. -/
  middleInv :
    (fiberSequenceGeneratedBy (loopBasedMap f)).obj (n + 1) ⟶
      (fiberSequenceGeneratedBy f).obj (n + 4)
  /-- The middle comparison followed by its inverse is the identity. -/
  middleMap_inv : middleMap ≫ middleInv = 𝟙 _
  /-- The middle inverse followed by the comparison is the identity. -/
  middleInv_map : middleInv ≫ middleMap = 𝟙 _
  /-- The raw comparison on the codomain term of the exact pair. -/
  codomainMap :
    (fiberSequenceGeneratedBy f).obj (n + 3) ⟶
      (fiberSequenceGeneratedBy (loopBasedMap f)).obj n
  /-- A chosen strict inverse for the codomain comparison. -/
  codomainInv :
    (fiberSequenceGeneratedBy (loopBasedMap f)).obj n ⟶
      (fiberSequenceGeneratedBy f).obj (n + 3)
  /-- The codomain comparison followed by its inverse is the identity. -/
  codomainMap_inv : codomainMap ≫ codomainInv = 𝟙 _
  /-- The codomain inverse followed by the comparison is the identity. -/
  codomainInv_map : codomainInv ≫ codomainMap = 𝟙 _
  /-- The left raw square comparing the target map with the looped exact pair. -/
  alphaRaw :
    (fiberSequenceGeneratedBy f).map (n + 4) ≫ middleMap =
      sourceMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 1)
  /-- The right raw square comparing the target map with the looped exact pair. -/
  betaRaw :
    middleMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map n =
      (fiberSequenceGeneratedBy f).map (n + 3) ≫ codomainMap

/-- Helper for Theorem 8.6.6: the raw source comparison induces the pointed-set comparison used in
the exactness transport step. -/
private def FiberSequenceGeneratedByTailComparisonData.sourceCmp
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 5)] ⟶
      Ho*[Z, (fiberSequenceGeneratedBy (loopBasedMap f)).obj (n + 2)] :=
  basedHomotopyClassesPostcompose Z data.sourceMap

/-- Helper for Theorem 8.6.6: the raw middle comparison induces the pointed-set comparison used in
the exactness transport step. -/
private def FiberSequenceGeneratedByTailComparisonData.middleCmp
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 4)] ⟶
      Ho*[Z, (fiberSequenceGeneratedBy (loopBasedMap f)).obj (n + 1)] :=
  basedHomotopyClassesPostcompose Z data.middleMap

/-- Helper for Theorem 8.6.6: the raw codomain comparison induces the pointed-set comparison used
in the exactness transport step. -/
private def FiberSequenceGeneratedByTailComparisonData.codomainCmp
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 3)] ⟶
      Ho*[Z, (fiberSequenceGeneratedBy (loopBasedMap f)).obj n] :=
  basedHomotopyClassesPostcompose Z data.codomainMap

/-- Helper for Theorem 8.6.6: once the raw left square has been normalized, it transports to
`Ho*[Z, -]` by postcomposition functoriality. -/
private theorem FiberSequenceGeneratedByTailComparisonData.alpha
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    fiberSequenceGeneratedByPostcompose Z f (n + 4) ≫ data.middleCmp =
      data.sourceCmp ≫ fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) (n + 1) := by
  calc
    fiberSequenceGeneratedByPostcompose Z f (n + 4) ≫ data.middleCmp =
        basedHomotopyClassesPostcompose Z
          ((fiberSequenceGeneratedBy f).map (n + 4) ≫ data.middleMap) := by
            simp [FiberSequenceGeneratedByTailComparisonData.middleCmp,
              FiberSequenceGeneratedByTailComparisonData.sourceCmp,
              fiberSequenceGeneratedByPostcompose, basedHomotopyClassesPostcompose_comp]
    _ = basedHomotopyClassesPostcompose Z
          (data.sourceMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 1)) := by
            rw [data.alphaRaw]
    _ = data.sourceCmp ≫ fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) (n + 1) := by
            simp [FiberSequenceGeneratedByTailComparisonData.middleCmp,
              FiberSequenceGeneratedByTailComparisonData.sourceCmp,
              fiberSequenceGeneratedByPostcompose, basedHomotopyClassesPostcompose_comp]

/-- Helper for Theorem 8.6.6: once the raw right square has been normalized, it transports to
`Ho*[Z, -]` by postcomposition functoriality. -/
private theorem FiberSequenceGeneratedByTailComparisonData.beta
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    data.middleCmp ≫ fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) n =
      fiberSequenceGeneratedByPostcompose Z f (n + 3) ≫ data.codomainCmp := by
  calc
    data.middleCmp ≫ fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) n =
        basedHomotopyClassesPostcompose Z
          (data.middleMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map n) := by
            simp [FiberSequenceGeneratedByTailComparisonData.middleCmp,
              FiberSequenceGeneratedByTailComparisonData.codomainCmp,
              fiberSequenceGeneratedByPostcompose, basedHomotopyClassesPostcompose_comp]
    _ = basedHomotopyClassesPostcompose Z
          ((fiberSequenceGeneratedBy f).map (n + 3) ≫ data.codomainMap) := by
            rw [data.betaRaw]
    _ = fiberSequenceGeneratedByPostcompose Z f (n + 3) ≫ data.codomainCmp := by
            simp [FiberSequenceGeneratedByTailComparisonData.middleCmp,
              FiberSequenceGeneratedByTailComparisonData.codomainCmp,
              fiberSequenceGeneratedByPostcompose, basedHomotopyClassesPostcompose_comp]

/-- Helper for Theorem 8.6.6: a stored strict inverse makes the induced source comparison
surjective on based homotopy classes. -/
private theorem FiberSequenceGeneratedByTailComparisonData.sourceSurjective
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    Function.Surjective data.sourceCmp := by
  exact
    (basedHomotopyClassesPostcompose_bijective_of_inverse Z
      data.sourceMap data.sourceInv data.sourceMap_inv data.sourceInv_map).surjective

/-- Helper for Theorem 8.6.6: a stored strict inverse makes the induced middle comparison
bijective on based homotopy classes. -/
private theorem FiberSequenceGeneratedByTailComparisonData.middleBijective
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    Function.Bijective data.middleCmp := by
  exact
    basedHomotopyClassesPostcompose_bijective_of_inverse Z
      data.middleMap data.middleInv data.middleMap_inv data.middleInv_map

/-- Helper for Theorem 8.6.6: a stored strict inverse makes the induced codomain comparison
injective on based homotopy classes. -/
private theorem FiberSequenceGeneratedByTailComparisonData.codomainInjective
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    Function.Injective data.codomainCmp := by
  exact
    (basedHomotopyClassesPostcompose_bijective_of_inverse Z
      data.codomainMap data.codomainInv data.codomainMap_inv data.codomainInv_map).injective

/-- Helper for Theorem 8.6.6: the stage-4 transport data packages the loop-homotopy-fiber source
comparison, loop reversal on the middle term, and the identity codomain comparison. -/
private theorem fiberSequenceGeneratedByTailComparisonSeedZero {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) :
    Nonempty (FiberSequenceGeneratedByTailComparisonData Z f 0) := by
  have hMap4 :
      (fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X =
        (loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f) := by
    -- Normalize the stage-4 map through Lemma 8.6.8 and cancel the terminal loop reversal.
    calc
      (fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X =
          signedLoopBasedMap (homotopyFiberProjection f) ≫ loopBasedSpaceNeg X := by
            rfl
      _ = ((loopHomotopyFiberIso f).hom ≫
            homotopyFiberProjection (loopBasedMap f) ≫
              loopBasedSpaceNeg X) ≫ loopBasedSpaceNeg X := by
            rw [loopHomotopyFiberHomeomorph_projection f]
      _ = (loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f) := by
            simp [Category.assoc, loopBasedSpaceNeg_self_inverse]
  have hMap3 :
      loopBasedSpaceNeg X ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map 0 =
        (fiberSequenceGeneratedBy f).map 3 := by
    -- The right square is just naturality of loop reversal.
    simpa [fiberSequenceGeneratedBy_map, signedLoopBasedMap] using
      (loopBasedSpaceNeg_natural f)
  refine ⟨
    { sourceMap := (loopHomotopyFiberIso f).hom
      sourceInv := (loopHomotopyFiberIso f).inv
      sourceMap_inv := by simpa using (loopHomotopyFiberIso f).hom_inv_id
      sourceInv_map := by simpa using (loopHomotopyFiberIso f).inv_hom_id
      middleMap := loopBasedSpaceNeg X
      middleInv := loopBasedSpaceNeg X
      middleMap_inv := by simpa using loopBasedSpaceNeg_self_inverse X
      middleInv_map := by simpa using loopBasedSpaceNeg_self_inverse X
      codomainMap := 𝟙 (Ωᵇ Y)
      codomainInv := 𝟙 (Ωᵇ Y)
      codomainMap_inv := by simp
      codomainInv_map := by simp
      alphaRaw := hMap4
      betaRaw := by simpa using hMap3 }⟩

/-- Helper for Theorem 8.6.6: the stage-5 transport data packages the source-side double-loop
twist, the loop-homotopy-fiber middle comparison, and loop reversal on the codomain. -/
private theorem fiberSequenceGeneratedByTailComparisonSeedOne {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) :
    Nonempty (FiberSequenceGeneratedByTailComparisonData Z f 1) := by
  have hMap5 :
      (fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom =
        (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
          homotopyFiberLoopInclusion (loopBasedMap f) := by
    -- Lemma 8.6.8 identifies the looped fiber inclusion after the source-side twist.
    calc
      (fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom =
          signedLoopBasedMap (homotopyFiberLoopInclusion f) ≫ (loopHomotopyFiberIso f).hom := by
            rfl
      _ = (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
            homotopyFiberLoopInclusion (loopBasedMap f) := by
            simpa [Category.assoc] using loopHomotopyFiberHomeomorph_loopInclusion f
  have hMap4 :
      (loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f) =
        (fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X := by
    -- The projection square from Lemma 8.6.8 matches the middle terms after one extra loop
    -- reversal on `Ωᵇ X`.
    calc
      (loopHomotopyFiberIso f).hom ≫ homotopyFiberProjection (loopBasedMap f) =
          ((loopHomotopyFiberIso f).hom ≫
            homotopyFiberProjection (loopBasedMap f) ≫
              loopBasedSpaceNeg X) ≫ loopBasedSpaceNeg X := by
            simp [Category.assoc, loopBasedSpaceNeg_self_inverse]
      _ = signedLoopBasedMap (homotopyFiberProjection f) ≫ loopBasedSpaceNeg X := by
            rw [loopHomotopyFiberHomeomorph_projection f]
      _ = (fiberSequenceGeneratedBy f).map 4 ≫ loopBasedSpaceNeg X := by
            rfl
  refine ⟨
    { sourceMap := signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y
      sourceInv := doubleLoopCoordinateSwap Y ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y))
      sourceMap_inv := by simpa using doubleLoopTailTwist_left_inverse Y
      sourceInv_map := by simpa using doubleLoopTailTwist_right_inverse Y
      middleMap := (loopHomotopyFiberIso f).hom
      middleInv := (loopHomotopyFiberIso f).inv
      middleMap_inv := by simpa using (loopHomotopyFiberIso f).hom_inv_id
      middleInv_map := by simpa using (loopHomotopyFiberIso f).inv_hom_id
      codomainMap := loopBasedSpaceNeg X
      codomainInv := loopBasedSpaceNeg X
      codomainMap_inv := by simpa using loopBasedSpaceNeg_self_inverse X
      codomainInv_map := by simpa using loopBasedSpaceNeg_self_inverse X
      alphaRaw := hMap5
      betaRaw := hMap4 }⟩

/-- Helper for Theorem 8.6.6: the stage-6 transport data packages the source-side coordinate
swap, the middle double-loop tail twist, and the codomain loop-homotopy-fiber comparison. -/
private theorem fiberSequenceGeneratedByTailComparisonSeedTwo {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) :
    Nonempty (FiberSequenceGeneratedByTailComparisonData Z f 2) := by
  have hMap6 :
      (fiberSequenceGeneratedBy f).map 6 ≫
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
        doubleLoopCoordinateSwap X ≫ signedLoopBasedMap (loopBasedMap f) := by
    -- The stage-4 compatibility lemma is the corrected normal form for the next tail square.
    calc
      (fiberSequenceGeneratedBy f).map 6 ≫
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) =
        signedLoopBasedMap (signedLoopBasedMap f) ≫
          (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) := by
            rfl
      _ = doubleLoopCoordinateSwap X ≫ signedLoopBasedMap (loopBasedMap f) := by
            exact stageFourLoopShiftCompatibility f
  have hMap5 :
      (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
          homotopyFiberLoopInclusion (loopBasedMap f) =
        (fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom := by
    -- Lemma 8.6.8 identifies the middle square after composing the codomain with
    -- `loopHomotopyFiberIso`.
    calc
      (signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y) ≫
          homotopyFiberLoopInclusion (loopBasedMap f) =
        signedLoopBasedMap (homotopyFiberLoopInclusion f) ≫ (loopHomotopyFiberIso f).hom := by
            simpa [Category.assoc] using (loopHomotopyFiberHomeomorph_loopInclusion f).symm
      _ = (fiberSequenceGeneratedBy f).map 5 ≫ (loopHomotopyFiberIso f).hom := by
            rfl
  refine ⟨
    { sourceMap := doubleLoopCoordinateSwap X
      sourceInv := doubleLoopCoordinateSwap X
      sourceMap_inv := by simpa using doubleLoopCoordinateSwap_self_inverse X
      sourceInv_map := by simpa using doubleLoopCoordinateSwap_self_inverse X
      middleMap := signedLoopBasedMap (𝟙 (Ωᵇ Y)) ≫ doubleLoopCoordinateSwap Y
      middleInv := doubleLoopCoordinateSwap Y ≫ signedLoopBasedMap (𝟙 (Ωᵇ Y))
      middleMap_inv := by simpa using doubleLoopTailTwist_left_inverse Y
      middleInv_map := by simpa using doubleLoopTailTwist_right_inverse Y
      codomainMap := (loopHomotopyFiberIso f).hom
      codomainInv := (loopHomotopyFiberIso f).inv
      codomainMap_inv := by simpa using (loopHomotopyFiberIso f).hom_inv_id
      codomainInv_map := by simpa using (loopHomotopyFiberIso f).inv_hom_id
      alphaRaw := hMap6
      betaRaw := hMap5 }⟩

/-- Helper for Theorem 8.6.6: once the package stores raw maps, the `n + 3` branch is obtained
by looping every comparison map and collapsing the two sign conventions in each shifted square. -/
private theorem fiberSequenceGeneratedByTailComparisonStepThree {X Y : BasedSpace}
    {f : X ⟶ Y} {Z : BasedSpace} {n : ℕ}
    (data : FiberSequenceGeneratedByTailComparisonData Z f n) :
    Nonempty (FiberSequenceGeneratedByTailComparisonData Z f (n + 3)) := by
  refine ⟨
    { sourceMap := signedLoopBasedMap data.sourceMap
      sourceInv := signedLoopBasedMap data.sourceInv
      sourceMap_inv := ?_
      sourceInv_map := ?_
      middleMap := signedLoopBasedMap data.middleMap
      middleInv := signedLoopBasedMap data.middleInv
      middleMap_inv := ?_
      middleInv_map := ?_
      codomainMap := signedLoopBasedMap data.codomainMap
      codomainInv := signedLoopBasedMap data.codomainInv
      codomainMap_inv := ?_
      codomainInv_map := ?_
      alphaRaw := ?_
      betaRaw := ?_ }⟩
  · -- The shifted source comparison keeps the same strict inverse after one more loop.
    calc
      signedLoopBasedMap data.sourceMap ≫ signedLoopBasedMap data.sourceInv =
          loopBasedMap (data.sourceMap ≫ data.sourceInv) := by
            rw [signedLoopBasedMap_comp_signedLoopBasedMap]
      _ = loopBasedMap (𝟙 _) := by rw [data.sourceMap_inv]
      _ = 𝟙 _ := loopBasedMap_id _
  · -- The opposite composite on the shifted source comparison is normalized in the same way.
    calc
      signedLoopBasedMap data.sourceInv ≫ signedLoopBasedMap data.sourceMap =
          loopBasedMap (data.sourceInv ≫ data.sourceMap) := by
            rw [signedLoopBasedMap_comp_signedLoopBasedMap]
      _ = loopBasedMap (𝟙 _) := by rw [data.sourceInv_map]
      _ = 𝟙 _ := loopBasedMap_id _
  · -- The shifted middle comparison keeps the same strict inverse after one more loop.
    calc
      signedLoopBasedMap data.middleMap ≫ signedLoopBasedMap data.middleInv =
          loopBasedMap (data.middleMap ≫ data.middleInv) := by
            rw [signedLoopBasedMap_comp_signedLoopBasedMap]
      _ = loopBasedMap (𝟙 _) := by rw [data.middleMap_inv]
      _ = 𝟙 _ := loopBasedMap_id _
  · -- The opposite composite on the shifted middle comparison is normalized in the same way.
    calc
      signedLoopBasedMap data.middleInv ≫ signedLoopBasedMap data.middleMap =
          loopBasedMap (data.middleInv ≫ data.middleMap) := by
            rw [signedLoopBasedMap_comp_signedLoopBasedMap]
      _ = loopBasedMap (𝟙 _) := by rw [data.middleInv_map]
      _ = 𝟙 _ := loopBasedMap_id _
  · -- The shifted codomain comparison keeps the same strict inverse after one more loop.
    calc
      signedLoopBasedMap data.codomainMap ≫ signedLoopBasedMap data.codomainInv =
          loopBasedMap (data.codomainMap ≫ data.codomainInv) := by
            rw [signedLoopBasedMap_comp_signedLoopBasedMap]
      _ = loopBasedMap (𝟙 _) := by rw [data.codomainMap_inv]
      _ = 𝟙 _ := loopBasedMap_id _
  · -- The opposite composite on the shifted codomain comparison is normalized in the same way.
    calc
      signedLoopBasedMap data.codomainInv ≫ signedLoopBasedMap data.codomainMap =
          loopBasedMap (data.codomainInv ≫ data.codomainMap) := by
            rw [signedLoopBasedMap_comp_signedLoopBasedMap]
      _ = loopBasedMap (𝟙 _) := by rw [data.codomainInv_map]
      _ = 𝟙 _ := loopBasedMap_id _
  · -- Route correction: the shifted left square is now just the loop of the old raw square.
    have hShiftAlphaSource :
        (fiberSequenceGeneratedBy f).map ((n + 3) + 4) =
          signedLoopBasedMap ((fiberSequenceGeneratedBy f).map (n + 4)) := by
      simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
        (show (fiberSequenceGeneratedBy f).map ((n + 4) + 3) =
            signedLoopBasedMap ((fiberSequenceGeneratedBy f).map (n + 4)) by
          rfl)
    have hShiftAlphaTarget :
        (fiberSequenceGeneratedBy (loopBasedMap f)).map ((n + 3) + 1) =
          signedLoopBasedMap ((fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 1)) := by
      simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
        (show (fiberSequenceGeneratedBy (loopBasedMap f)).map ((n + 1) + 3) =
            signedLoopBasedMap ((fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 1)) by
          rfl)
    have hFirst :
        (fiberSequenceGeneratedBy f).map ((n + 3) + 4) ≫ signedLoopBasedMap data.middleMap =
          loopBasedMap ((fiberSequenceGeneratedBy f).map (n + 4) ≫ data.middleMap) := by
      calc
        (fiberSequenceGeneratedBy f).map ((n + 3) + 4) ≫ signedLoopBasedMap data.middleMap =
            signedLoopBasedMap ((fiberSequenceGeneratedBy f).map (n + 4)) ≫
              signedLoopBasedMap data.middleMap := by
                exact
                  congrArg (fun k => k ≫ signedLoopBasedMap data.middleMap) hShiftAlphaSource
        _ = loopBasedMap ((fiberSequenceGeneratedBy f).map (n + 4) ≫ data.middleMap) := by
              rw [signedLoopBasedMap_comp_signedLoopBasedMap]
    have hSecond :
        loopBasedMap ((fiberSequenceGeneratedBy f).map (n + 4) ≫ data.middleMap) =
          loopBasedMap (data.sourceMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 1)) := by
      rw [data.alphaRaw]
    have hThird :
        loopBasedMap (data.sourceMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 1)) =
          signedLoopBasedMap data.sourceMap ≫
            signedLoopBasedMap ((fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 1)) := by
      rw [← signedLoopBasedMap_comp_signedLoopBasedMap]
    have hFourth :
        signedLoopBasedMap data.sourceMap ≫
            signedLoopBasedMap ((fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 1)) =
          signedLoopBasedMap data.sourceMap ≫
            (fiberSequenceGeneratedBy (loopBasedMap f)).map ((n + 3) + 1) := by
      exact
        congrArg (fun k => signedLoopBasedMap data.sourceMap ≫ k)
          hShiftAlphaTarget.symm
    exact hFirst.trans (hSecond.trans (hThird.trans hFourth))
  · -- The shifted right square is the same looped normalization for the codomain side.
    have hShiftBetaSource :
        (fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 3) =
          signedLoopBasedMap ((fiberSequenceGeneratedBy (loopBasedMap f)).map n) := by
      rfl
    have hShiftBetaTarget :
        (fiberSequenceGeneratedBy f).map ((n + 3) + 3) =
          signedLoopBasedMap ((fiberSequenceGeneratedBy f).map (n + 3)) := by
      rfl
    have hFirst :
        signedLoopBasedMap data.middleMap ≫
            (fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 3) =
          loopBasedMap (data.middleMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map n) := by
      calc
        signedLoopBasedMap data.middleMap ≫
            (fiberSequenceGeneratedBy (loopBasedMap f)).map (n + 3) =
          signedLoopBasedMap data.middleMap ≫
            signedLoopBasedMap ((fiberSequenceGeneratedBy (loopBasedMap f)).map n) := by
              exact
                congrArg (fun k => signedLoopBasedMap data.middleMap ≫ k) hShiftBetaSource
        _ = loopBasedMap (data.middleMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map n) := by
              rw [signedLoopBasedMap_comp_signedLoopBasedMap]
    have hSecond :
        loopBasedMap (data.middleMap ≫ (fiberSequenceGeneratedBy (loopBasedMap f)).map n) =
          loopBasedMap ((fiberSequenceGeneratedBy f).map (n + 3) ≫ data.codomainMap) := by
      rw [data.betaRaw]
    have hThird :
        loopBasedMap ((fiberSequenceGeneratedBy f).map (n + 3) ≫ data.codomainMap) =
          signedLoopBasedMap ((fiberSequenceGeneratedBy f).map (n + 3)) ≫
            signedLoopBasedMap data.codomainMap := by
      rw [← signedLoopBasedMap_comp_signedLoopBasedMap]
    have hFourth :
        signedLoopBasedMap ((fiberSequenceGeneratedBy f).map (n + 3)) ≫
            signedLoopBasedMap data.codomainMap =
          (fiberSequenceGeneratedBy f).map ((n + 3) + 3) ≫
            signedLoopBasedMap data.codomainMap := by
      exact
        congrArg (fun k => k ≫ signedLoopBasedMap data.codomainMap)
          hShiftBetaTarget.symm
    exact hFirst.trans (hSecond.trans (hThird.trans hFourth))

/-- Helper for Theorem 8.6.6: the tail comparison family is a direct `0 | 1 | 2 | n + 3`
recursion once the comparison package stores raw maps and inverse data. -/
private theorem fiberSequenceGeneratedByTailComparisonFamily {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) : (n : ℕ) → Nonempty (FiberSequenceGeneratedByTailComparisonData Z f n)
  | 0 => fiberSequenceGeneratedByTailComparisonSeedZero f Z
  | 1 => fiberSequenceGeneratedByTailComparisonSeedOne f Z
  | 2 => fiberSequenceGeneratedByTailComparisonSeedTwo f Z
  | n + 3 =>
      by
        rcases fiberSequenceGeneratedByTailComparisonFamily f Z n with ⟨data⟩
        exact fiberSequenceGeneratedByTailComparisonStepThree data

private theorem fiberSequenceGeneratedByExactTailStep {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) (n : ℕ) :
    PointedExact
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) (n + 1))
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) n) →
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f (n + 4))
        (fiberSequenceGeneratedByPostcompose Z f (n + 3)) := by
  intro hExact
  -- Route correction: the tail step now consumes a typed comparison package, so the closing
  -- proof is the uniform `precompose + transport + cancel` pattern from the re-plan.
  let data : FiberSequenceGeneratedByTailComparisonData Z f n :=
    Classical.choice (fiberSequenceGeneratedByTailComparisonFamily f Z n)
  -- First precompose the left map with the packaged surjective source comparison.
  have hSourceExact :
      PointedExact
        (data.sourceCmp ≫ fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) (n + 1))
        (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) n) := by
    exact pointedExact_comp_left_of_surjective
      data.sourceCmp
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) (n + 1))
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) n)
      hExact data.sourceSurjective
  -- Next transport exactness across the packaged middle bijection.
  have hTransported :
      PointedExact
        (fiberSequenceGeneratedByPostcompose Z f (n + 4))
        (fiberSequenceGeneratedByPostcompose Z f (n + 3) ≫ data.codomainCmp) := by
    exact pointedExact_transport_bijective
      data.middleCmp
      (data.sourceCmp ≫ fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) (n + 1))
      (fiberSequenceGeneratedByPostcompose Z (loopBasedMap f) n)
      (fiberSequenceGeneratedByPostcompose Z f (n + 4))
      (fiberSequenceGeneratedByPostcompose Z f (n + 3) ≫ data.codomainCmp)
      data.alpha data.beta data.middleBijective hSourceExact
  -- Finally cancel the codomain comparison by injectivity.
  exact pointedExact_cancel_right_of_injective
    (fiberSequenceGeneratedByPostcompose Z f (n + 4))
    (fiberSequenceGeneratedByPostcompose Z f (n + 3))
    data.codomainCmp
    hTransported data.codomainInjective

/-- Theorem 8.6.6. For any based space `Z`, applying `Ho*[Z, -]` to the fiber sequence generated
by `f` gives an exact sequence of pointed sets. -/
theorem fiberSequenceGeneratedBy_basedHomotopyClasses_exact {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) (n : ℕ) :
    PointedExact
      (fiberSequenceGeneratedByPostcompose Z f (n + 1))
      (fiberSequenceGeneratedByPostcompose Z f n) := by
  cases n with
  | zero =>
      -- The initial stage is the direct homotopy-fiber exactness statement.
      simpa using fiberSequenceGeneratedBy_basedHomotopyClasses_exact_zero f Z
  | succ n =>
      cases n with
      | zero =>
          -- The next stage is the first transported exactness statement from the initial window.
          simpa using (fiberSequenceGeneratedByExactInitialWindow f Z).1
      | succ n =>
          cases n with
          | zero =>
              -- The third stage is the second transported exactness statement from the initial
              -- window.
              simpa using (fiberSequenceGeneratedByExactInitialWindow f Z).2
          | succ n =>
              -- The remaining tail is the recursive exactness statement for `loopBasedMap f`,
              -- transported back through the Chapter 8 comparison maps.
              simpa using fiberSequenceGeneratedByExactTailStep f Z n
                (fiberSequenceGeneratedBy_basedHomotopyClasses_exact (loopBasedMap f) Z n)

/-- The stage `n` term of the group-valued left tail of the sequence obtained by applying
`Ho*[Z, -]` to `fiberSequenceGeneratedBy f`, identified via the Chapter 8 loop-space shift with
the source term `Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 3)]`. -/
abbrev fiberSequenceGeneratedByBasedHomotopyClassesGroupTail (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :=
  Ho*[Z, Ωᵇ ((fiberSequenceGeneratedBy f).obj n)]

/-- The identified group-tail terms of `Ho*[Z, -]` on `fiberSequenceGeneratedBy f` carry their
canonical group structures. -/
noncomputable instance fiberSequenceGeneratedByBasedHomotopyClassesGroupTailGroup
    (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    Group (fiberSequenceGeneratedByBasedHomotopyClassesGroupTail Z f n) :=
  inferInstance

/-- The map between consecutive stages of the identified group-valued left tail of `Ho*[Z, -]`
on `fiberSequenceGeneratedBy f`. -/
abbrev fiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    fiberSequenceGeneratedByBasedHomotopyClassesGroupTail Z f (n + 1) →*
      fiberSequenceGeneratedByBasedHomotopyClassesGroupTail Z f n :=
  fiberSequenceGeneratedByPostcomposeLoopHom Z f n

/-- The stage `n` term of the original shifted left tail of `Ho*[Z, -]` on
`fiberSequenceGeneratedBy f`, namely the source term
`Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 3)]`. -/
abbrev fiberSequenceGeneratedByBasedHomotopyClassesShiftedTail (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :=
  Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 3)]

/-- The map between consecutive stages of the original shifted left tail of `Ho*[Z, -]` on
`fiberSequenceGeneratedBy f`. -/
abbrev fiberSequenceGeneratedByBasedHomotopyClassesShiftedTailMap (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    fiberSequenceGeneratedByBasedHomotopyClassesShiftedTail Z f (n + 1) ⟶
      fiberSequenceGeneratedByBasedHomotopyClassesShiftedTail Z f n :=
  fiberSequenceGeneratedByPostcompose Z f (n + 3)

/-- The stage `n` term of the commutative-group-valued farther-left tail of the sequence obtained
by applying `Ho*[Z, -]` to `fiberSequenceGeneratedBy f`, identified via the twofold Chapter 8
loop-space shift with the source term
`Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 6)]`. -/
abbrev fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTail (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :=
  Ho*[Z, Ωᵇ (Ωᵇ ((fiberSequenceGeneratedBy f).obj n))]

/-- The identified commutative-group tail terms of `Ho*[Z, -]` on `fiberSequenceGeneratedBy f`
carry their canonical commutative-group structures. -/
noncomputable instance fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailCommGroup
    (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    CommGroup (fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTail Z f n) :=
  inferInstance

/-- The map between consecutive stages of the identified commutative-group-valued farther-left
tail of `Ho*[Z, -]` on `fiberSequenceGeneratedBy f`. -/
abbrev fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTail Z f (n + 1) →*
      fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTail Z f n :=
  fiberSequenceGeneratedByPostcomposeDoubleLoopHom Z f n

/-- The stage `n` term of the original farther-left tail of `Ho*[Z, -]` on
`fiberSequenceGeneratedBy f`, namely the source term
`Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 6)]`. -/
abbrev fiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTail (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :=
  Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 6)]

/-- The map between consecutive stages of the original farther-left tail of `Ho*[Z, -]` on
`fiberSequenceGeneratedBy f`. -/
abbrev fiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTailMap (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    fiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTail Z f (n + 1) ⟶
      fiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTail Z f n :=
  fiberSequenceGeneratedByPostcompose Z f (n + 6)

/-- Group-tail form of Theorem 8.6.6. Under the Chapter 8 loop-space identifications
`Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 3)] ≃
  Ho*[Z, Ωᵇ ((fiberSequenceGeneratedBy f).obj n)]`,
the sufficiently far left tail of the sequence obtained by applying `Ho*[Z, -]` to
`fiberSequenceGeneratedBy f` remains exact on the original shifted terms, and the same
adjacent pair of maps is exact in the identified group-valued tail. -/
theorem fiberSequenceGeneratedBy_basedHomotopyClasses_groupTail_exact
    {X Y : BasedSpace} (f : X ⟶ Y) (Z : BasedSpace) (n : ℕ) :
    PointedExact
        (fiberSequenceGeneratedByBasedHomotopyClassesShiftedTailMap Z f (n + 1))
        (fiberSequenceGeneratedByBasedHomotopyClassesShiftedTailMap Z f n) ∧
      Function.MulExact
        (fiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap Z f (n + 1))
        (fiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap Z f n) := by
  constructor
  · -- Shift theorem (1) three steps to read exactness on the original left tail.
    simpa [fiberSequenceGeneratedByBasedHomotopyClassesShiftedTailMap] using
      fiberSequenceGeneratedBy_basedHomotopyClasses_exact f Z (n + 3)
  · -- On loop-space classes the distinguished point is definitional `1`, so the same shifted
    -- exactness statement becomes `Function.MulExact`.
    simpa [Function.MulExact, PointedExact,
      fiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap,
      fiberSequenceGeneratedByPostcomposeLoopHom] using
      fiberSequenceGeneratedBy_basedHomotopyClasses_exact f Z (n + 3)

/-- The group-exactness conclusion of Theorem 8.6.6 (2) on the identified loop-space tail. -/
theorem fiberSequenceGeneratedBy_basedHomotopyClasses_loop_exact {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) (n : ℕ) :
    Function.MulExact
      (fiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap Z f (n + 1))
      (fiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap Z f n) :=
  (fiberSequenceGeneratedBy_basedHomotopyClasses_groupTail_exact f Z n).2

/-- Double-loop-tail form of Theorem 8.6.6. Farther left, under the twofold Chapter 8
loop-space identifications
`Ho*[Z, (fiberSequenceGeneratedBy f).obj (n + 6)] ≃
  Ho*[Z, Ωᵇ (Ωᵇ ((fiberSequenceGeneratedBy f).obj n))]`,
the sequence obtained by applying `Ho*[Z, -]` to `fiberSequenceGeneratedBy f` remains exact on
the original farther-left tail, and the same adjacent pair of maps is exact in the identified
commutative-group-valued tail. -/
theorem fiberSequenceGeneratedBy_basedHomotopyClasses_commGroupTail_exact
    {X Y : BasedSpace} (f : X ⟶ Y) (Z : BasedSpace) (n : ℕ) :
    PointedExact
        (fiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTailMap Z f (n + 1))
        (fiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTailMap Z f n) ∧
      Function.MulExact
        (fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap Z f (n + 1))
        (fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap Z f n) := by
  constructor
  · -- Shift theorem (1) six steps to read exactness on the farther-left tail.
    simpa [fiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTailMap] using
      fiberSequenceGeneratedBy_basedHomotopyClasses_exact f Z (n + 6)
  · -- In the double-loop region the same shifted pointed exactness is exactness of
    -- commutative-group homomorphisms.
    simpa [Function.MulExact, PointedExact,
      fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap,
      fiberSequenceGeneratedByPostcomposeDoubleLoopHom] using
      fiberSequenceGeneratedBy_basedHomotopyClasses_exact f Z (n + 6)

/-- The commutative-group exactness conclusion of Theorem 8.6.6 (3) on the identified double-loop
tail. -/
theorem fiberSequenceGeneratedBy_basedHomotopyClasses_doubleLoop_exact
    {X Y : BasedSpace} (f : X ⟶ Y) (Z : BasedSpace) (n : ℕ) :
    Function.MulExact
      (fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap Z f (n + 1))
      (fiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap Z f n) :=
  (fiberSequenceGeneratedBy_basedHomotopyClasses_commGroupTail_exact f Z n).2
