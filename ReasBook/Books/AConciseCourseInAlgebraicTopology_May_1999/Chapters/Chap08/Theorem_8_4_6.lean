import Mathlib.Algebra.Exact
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.BasedHomotopyClassesPostcompose
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap08.Definition_8_4_5
import Books.AConciseCourseInAlgebraicTopology_May_1999.Chapters.Chap22.BasedHomotopyClasses
import Books.AConciseCourseInAlgebraicTopology_May_1999.PointedExact

open CategoryTheory
open scoped HomotopyClasses

noncomputable section

local notation "BasedSpace" => Under (⊤_ TopCat)

/-- The pointed map on `[X_(n + 1), Z]` induced by the `n`th arrow of the cofiber sequence
generated by `f`. -/
def cofiberSequenceGeneratedByPrecompose (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y)
    (n : ℕ) :
    Ho*[(cofiberSequenceGeneratedBy f).obj (n + 1), Z] ⟶
      Ho*[(cofiberSequenceGeneratedBy f).obj n, Z] :=
  BasedHomotopyClasses.precompose ((cofiberSequenceGeneratedBy f).map n)

/-- Theorem 8.4.6 (1). For any based space `Z`, applying `[−, Z]` to the cofiber sequence
generated by `f` yields an exact sequence of pointed sets: every adjacent pair of induced maps on
based homotopy classes is `PointedExact`. -/
theorem cofiberSequenceGeneratedBy_basedHomotopyClasses_exact {X Y : BasedSpace} (f : X ⟶ Y)
    (Z : BasedSpace) (n : ℕ) :
    PointedExact
      (cofiberSequenceGeneratedByPrecompose Z f (n + 1))
      (cofiberSequenceGeneratedByPrecompose Z f n) := sorry

/-- The map on `[−, ΩZ]` induced by the `n`th arrow of the cofiber sequence generated by `f`,
packaged as a homomorphism on the loop-space group model for the suspension region. -/
def cofiberSequenceGeneratedByPrecomposeLoopHom (Z : BasedSpace) {X Y : BasedSpace}
    (f : X ⟶ Y) (n : ℕ) :
    Ho*[(cofiberSequenceGeneratedBy f).obj (n + 1), Ωᵇ Z] →*
      Ho*[(cofiberSequenceGeneratedBy f).obj n, Ωᵇ Z] where
  toFun := (cofiberSequenceGeneratedByPrecompose (Ωᵇ Z) f n).toFun
  map_one' := sorry
  map_mul' := sorry

/-- The map on `[−, Ω²Z]` induced by the `n`th arrow of the cofiber sequence generated by `f`,
packaged as a homomorphism on the double-loop commutative-group model for the farther-left
double-suspension region. -/
def cofiberSequenceGeneratedByPrecomposeDoubleLoopHom (Z : BasedSpace) {X Y : BasedSpace}
    (f : X ⟶ Y) (n : ℕ) :
    Ho*[(cofiberSequenceGeneratedBy f).obj (n + 1), Ωᵇ (Ωᵇ Z)] →*
      Ho*[(cofiberSequenceGeneratedBy f).obj n, Ωᵇ (Ωᵇ Z)] where
  toFun := (cofiberSequenceGeneratedByPrecompose (Ωᵇ (Ωᵇ Z)) f n).toFun
  map_one' := sorry
  map_mul' := sorry

/-- The stage `n` term of the group-valued left tail of the sequence obtained by applying `[−, Z]`
to `cofiberSequenceGeneratedBy f`, identified via the Chapter 8 suspension-loop correspondence
with the source term `[(cofiberSequenceGeneratedBy f).obj (n + 3), Z]`. -/
abbrev cofiberSequenceGeneratedByBasedHomotopyClassesGroupTail (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :=
  Ho*[(cofiberSequenceGeneratedBy f).obj n, Ωᵇ Z]

/-- The identified group-tail terms of `cofiberSequenceGeneratedByPrecompose Z f` carry their
canonical group structures. -/
noncomputable instance cofiberSequenceGeneratedByBasedHomotopyClassesGroupTailGroup
    (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    Group (cofiberSequenceGeneratedByBasedHomotopyClassesGroupTail Z f n) :=
  inferInstance

/-- The map between consecutive stages of the identified group-valued left tail of
`cofiberSequenceGeneratedByPrecompose Z f`. -/
abbrev cofiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    cofiberSequenceGeneratedByBasedHomotopyClassesGroupTail Z f (n + 1) →*
      cofiberSequenceGeneratedByBasedHomotopyClassesGroupTail Z f n :=
  cofiberSequenceGeneratedByPrecomposeLoopHom Z f n

/-- The stage `n` term of the original shifted left tail of `[−, Z]` on
`cofiberSequenceGeneratedBy f`, namely the source term
`[(cofiberSequenceGeneratedBy f).obj (n + 3), Z]`. -/
abbrev cofiberSequenceGeneratedByBasedHomotopyClassesShiftedTail (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :=
  Ho*[(cofiberSequenceGeneratedBy f).obj (n + 3), Z]

/-- The map between consecutive stages of the original shifted left tail of `[−, Z]` on
`cofiberSequenceGeneratedBy f`. -/
abbrev cofiberSequenceGeneratedByBasedHomotopyClassesShiftedTailMap (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    cofiberSequenceGeneratedByBasedHomotopyClassesShiftedTail Z f (n + 1) ⟶
      cofiberSequenceGeneratedByBasedHomotopyClassesShiftedTail Z f n :=
  cofiberSequenceGeneratedByPrecompose Z f (n + 3)

/-- The stage `n` term of the commutative-group-valued farther-left tail of the sequence obtained
by applying `[−, Z]` to `cofiberSequenceGeneratedBy f`, identified via the twofold Chapter 8
suspension-loop correspondence with the source term
`[(cofiberSequenceGeneratedBy f).obj (n + 6), Z]`. -/
abbrev cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTail (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :=
  Ho*[(cofiberSequenceGeneratedBy f).obj n, Ωᵇ (Ωᵇ Z)]

/-- The identified commutative-group tail terms of `cofiberSequenceGeneratedByPrecompose Z f`
carry their canonical commutative-group structures. -/
noncomputable instance cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailCommGroup
    (Z : BasedSpace) {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    CommGroup (cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTail Z f n) :=
  inferInstance

/-- The map between consecutive stages of the identified commutative-group-valued farther-left
tail of `cofiberSequenceGeneratedByPrecompose Z f`. -/
abbrev cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTail Z f (n + 1) →*
      cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTail Z f n :=
  cofiberSequenceGeneratedByPrecomposeDoubleLoopHom Z f n

/-- The stage `n` term of the original farther-left tail of `[−, Z]` on
`cofiberSequenceGeneratedBy f`, namely the source term
`[(cofiberSequenceGeneratedBy f).obj (n + 6), Z]`. -/
abbrev cofiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTail (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :=
  Ho*[(cofiberSequenceGeneratedBy f).obj (n + 6), Z]

/-- The map between consecutive stages of the original farther-left tail of `[−, Z]` on
`cofiberSequenceGeneratedBy f`. -/
abbrev cofiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTailMap (Z : BasedSpace)
    {X Y : BasedSpace} (f : X ⟶ Y) (n : ℕ) :
    cofiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTail Z f (n + 1) ⟶
      cofiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTail Z f n :=
  cofiberSequenceGeneratedByPrecompose Z f (n + 6)

/-- Theorem 8.4.6 (2). Under the Chapter 8 suspension-loop identifications
`[(cofiberSequenceGeneratedBy f).obj (n + 3), Z] ≃ [(cofiberSequenceGeneratedBy f).obj n, ΩZ]`,
the sufficiently far left tail of the sequence obtained by applying `[−, Z]` to
`cofiberSequenceGeneratedBy f` remains exact on the original shifted terms, and the same adjacent
pair of maps is exact in the identified group-valued tail. -/
theorem cofiberSequenceGeneratedBy_basedHomotopyClasses_groupTail_exact {X Y : BasedSpace}
    (f : X ⟶ Y) (Z : BasedSpace) (n : ℕ) :
    PointedExact
        (cofiberSequenceGeneratedByBasedHomotopyClassesShiftedTailMap Z f (n + 1))
        (cofiberSequenceGeneratedByBasedHomotopyClassesShiftedTailMap Z f n) ∧
      Function.MulExact
        (cofiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap Z f (n + 1))
        (cofiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap Z f n) := sorry

/-- The group-exactness conclusion of Theorem 8.4.6 (2) on the identified loop-space tail. -/
theorem cofiberSequenceGeneratedBy_basedHomotopyClasses_loop_exact {X Y : BasedSpace}
    (f : X ⟶ Y) (Z : BasedSpace) (n : ℕ) :
    Function.MulExact
      (cofiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap Z f (n + 1))
      (cofiberSequenceGeneratedByBasedHomotopyClassesGroupTailMap Z f n) :=
  (cofiberSequenceGeneratedBy_basedHomotopyClasses_groupTail_exact f Z n).2

/-- Theorem 8.4.6 (3). Farther left, under the twofold Chapter 8 suspension-loop identifications
`[(cofiberSequenceGeneratedBy f).obj (n + 6), Z] ≃ [(cofiberSequenceGeneratedBy f).obj n, Ω²Z]`,
the sequence obtained by applying `[−, Z]` to `cofiberSequenceGeneratedBy f` remains exact on the
original farther-left tail, and the same adjacent pair of maps is exact in the identified
commutative-group-valued tail. -/
theorem cofiberSequenceGeneratedBy_basedHomotopyClasses_commGroupTail_exact
    {X Y : BasedSpace} (f : X ⟶ Y) (Z : BasedSpace) (n : ℕ) :
    PointedExact
        (cofiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTailMap Z f (n + 1))
        (cofiberSequenceGeneratedByBasedHomotopyClassesDoubleShiftedTailMap Z f n) ∧
      Function.MulExact
        (cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap Z f (n + 1))
        (cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap Z f n) := sorry

/-- The commutative-group exactness conclusion of Theorem 8.4.6 (3) on the identified double-loop
tail. -/
theorem cofiberSequenceGeneratedBy_basedHomotopyClasses_doubleLoop_exact
    {X Y : BasedSpace} (f : X ⟶ Y) (Z : BasedSpace) (n : ℕ) :
    Function.MulExact
      (cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap Z f (n + 1))
      (cofiberSequenceGeneratedByBasedHomotopyClassesCommGroupTailMap Z f n) :=
  (cofiberSequenceGeneratedBy_basedHomotopyClasses_commGroupTail_exact f Z n).2
