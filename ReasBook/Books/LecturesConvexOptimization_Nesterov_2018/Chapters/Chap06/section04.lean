/-! ### Corollary_6_4_1 (from Chap06) -/
open scoped WeightSequenceNotation

universe u

section

variable {E : Type u}

/- Corollary 6.4.1 lies in Chapter 6's accumulated-weight / oracle-error normalization domain.

Sampled owner-style declarations:
- `A[a](t)` from `Definition_6_53`, the chapter owner for the accumulated weights `A_t`;
- `linearOptimizationOracleErrorBound` from `Definition_6_54`, the chapter owner for the error
  term `B_{ν,t}`;
- `objective_gap_le_error_bound_div_accumulated_weight` from `Theorem_6_13`, the canonical
  normalization theorem upstream in the same chapter.

Best owner abstraction:
- source-facing: the iterate-specialized corollary at the textbook point `x_t` relative to
  `x_*`;
- core/canonical: `objective_gap_le_error_bound_div_accumulated_weight`;
- bridge/view: the specialization `xt = x t`, `xs = xStar`.

Primitive data:
- the iterate family `x`, reference point `xStar`, weights `a`, and error-term parameters;
- the positivity hypothesis `0 < A[a](t)`;
- the weighted inequality at the specific iterate `x t`.

Derived API:
- the normalized composite-objective gap bound at time `t`.

This item therefore keeps no parallel arithmetic wrapper. It remains theorem-shaped because the
textbook corollary is a genuine source-facing specialization of the chapter owner theorem, not an
exact-interface duplicate suitable for pure `recall`. -/
-- Proof sketch: specialize Theorem 6.13 to `xt = x t` and `xs = xStar`.
/-- Corollary 6.4.1: for any iterate index `t`, if `A_t > 0` and the weighted
composite-objective gap at `x_t` relative to `x_*` is bounded by `B_{ν,t}`, then equation
`(6.4.17)` holds:
`\bar f(x_t) - \bar f(x_*) ≤ B_{ν,t} / A_t`, where
`B_{ν,t} = linearOptimizationOracleErrorBound V₀ a G_ν D ν t`. The subsequent standard-weight
rates `(6.4.18)`--`(6.4.20)` are referenced but not restated here. -/
theorem composite_objective_gap_le_error_bound_div_accumulated_weight
    (fbar : E → ℝ) (x : ℕ → E) (xStar : E) (a : ℕ → ℝ) (V0 Gν D : ℝ)
    {ν : ℝ} {t : ℕ}
    (hAt : 0 < A[a](t))
    (hweighted :
      A[a](t) * (fbar (x t) - fbar xStar) ≤
        linearOptimizationOracleErrorBound V0 a Gν D ν t) :
    fbar (x t) - fbar xStar ≤
      linearOptimizationOracleErrorBound V0 a Gν D ν t / A[a](t) := by
  simpa using
    objective_gap_le_error_bound_div_accumulated_weight
      fbar (x t) xStar a V0 Gν D hAt hweighted

end

/-! ### Example_6_4_1 (from Chap06) -/
noncomputable section

open scoped ConstrainedArgmin WithTopConvexAnalysis

namespace CoordinateMaxCounterexample

local notation "E" => EuclideanSpace ℝ (Fin 2)

/-- The unit-disk feasible set `Q = closedBall 0 1` from Example 6.4.1. -/
def feasibleSet : Set E :=
  Metric.closedBall (0 : E) (1 : ℝ)

/-- The nonsmooth objective `f(x) = max{x₁, x₂}` from Example 6.4.1. -/
def objective : E → ℝ :=
  maxTypeObjective (fun i : Fin 2 ↦ fun x : E ↦ x i)

/-- The first admissible coordinate subgradient `(1, 0)`. -/
def firstSubgradient : E :=
  EuclideanSpace.single (0 : Fin 2) (1 : ℝ)

/-- The second admissible coordinate subgradient `(0, 1)`. -/
def secondSubgradient : E :=
  EuclideanSpace.single (1 : Fin 2) (1 : ℝ)

/-- The optimizer `x_* = (-1 / √2, -1 / √2)` for the unit-disk example. -/
def optimizer : E :=
  -((1 : ℝ) / Real.sqrt 2) • (firstSubgradient + secondSubgradient)

/-- The first extreme point selected by the linearized subproblem. -/
def firstOraclePoint : E :=
  -firstSubgradient

/-- The second extreme point selected by the linearized subproblem. -/
def secondOraclePoint : E :=
  -secondSubgradient

/-- The convex hull generated by the initial point `x₀` and the two possible oracle vertices. -/
def oracleHull (x0 : E) : Set E :=
  convexHull ℝ ({x0, firstOraclePoint, secondOraclePoint} : Set E)

-- Proof sketch: minimize `max{x₁, x₂}` over the unit disk by symmetry; the minimum occurs when
-- the two coordinates agree and the norm constraint is active, which gives
-- `x_* = (-1 / √2, -1 / √2)`.
/-- The point `x_* = (-1 / √2, -1 / √2)` minimizes the counterexample objective
`f(x) = max{x₁, x₂}` on the closed unit disk `Q = closedBall 0 1`. -/
theorem optimizer_isMinOn :
    IsMinOn objective feasibleSet optimizer := sorry

/-- If the first coordinate is active at `x`, then `(1, 0)` is an admissible subgradient of
`x ↦ max{x₁, x₂}` at `x`. -/
theorem firstSubgradient_isSubgradientAt_of_coord1_le_coord0
    {x : E} (hx : x (1 : Fin 2) ≤ x (0 : Fin 2)) :
    IsSubgradientAt (fun y ↦ (objective y : WithTop ℝ)) x firstSubgradient := sorry

/-- If the second coordinate is active at `x`, then `(0, 1)` is an admissible subgradient of
`x ↦ max{x₁, x₂}` at `x`. -/
theorem secondSubgradient_isSubgradientAt_of_coord0_le_coord1
    {x : E} (hx : x (0 : Fin 2) ≤ x (1 : Fin 2)) :
    IsSubgradientAt (fun y ↦ (objective y : WithTop ℝ)) x secondSubgradient := sorry

-- Proof sketch: minimizing `⟪(1, 0), x⟫ = x₁` on the unit disk forces `x = (-1, 0)`.
/-- The linearized unit-disk subproblem for the admissible subgradient `(1, 0)` is solved
exactly by `(-1, 0)`. -/
theorem eq_firstOraclePoint_of_mem_argmin_firstSubgradient
    {v : E}
    (hv : v ∈ argmin[feasibleSet] (fun y : E ↦ inner ℝ firstSubgradient y)) :
    v = firstOraclePoint := sorry

-- Proof sketch: minimizing `⟪(0, 1), x⟫ = x₂` on the unit disk forces `x = (0, -1)`.
/-- The linearized unit-disk subproblem for the admissible subgradient `(0, 1)` is solved
exactly by `(0, -1)`. -/
theorem eq_secondOraclePoint_of_mem_argmin_secondSubgradient
    {v : E}
    (hv : v ∈ argmin[feasibleSet] (fun y : E ↦ inner ℝ secondSubgradient y)) :
    v = secondOraclePoint := sorry

-- Proof sketch: write a point of `conv{x₀, y₁, y₂}` as a convex combination of
-- `x₀`, `(-1, 0)`, and `(0, -1)`. Using `x₀ ∈ Q` and `x₀ ≠ x_*`, the barycentric-coordinate
-- relations for `x_* = (-1 / √2, -1 / √2)` force a contradiction.
/-- If the initial point lies in the unit disk and is not the optimizer, then the triangle
`conv{x₀, y₁, y₂}` does not contain `x_*`. -/
theorem optimizer_not_mem_oracleHull
    {x0 : E} (hx0_mem : x0 ∈ feasibleSet) (hx0_ne : x0 ≠ optimizer) :
    optimizer ∉ oracleHull x0 := sorry

-- Proof sketch: first use the two exact oracle theorems
-- `eq_firstOraclePoint_of_mem_argmin_firstSubgradient` and
-- `eq_secondOraclePoint_of_mem_argmin_secondSubgradient` to identify each oracle point with one
-- of `y₁` or `y₂`. Then induct on `t`:
-- the base case is `x₀ ∈ conv{x₀,y₁,y₂}`, and the successor step follows from the
-- convex-combination update with `τ_t ∈ [0, 1]`.
/-- Example 6.4.1: for the unit disk `Q` and `f(x) = max{x₁, x₂}`, if a conditional-gradient
trajectory starts from `x₀`, and the oracle selects one of the admissible extreme
coordinate directions `(1, 0)` or `(0, 1)`, then every iterate stays in
`conv{x₀, (-1, 0), (0, -1)}`. -/
theorem conditionalGradient_iterates_mem_oracleHull
    {x0 : E}
    {τ : ℕ → ℝ} (hτ : ∀ t : ℕ, τ t ∈ Set.Icc (0 : ℝ) 1)
    {x : ℕ → E} (hx_zero : x 0 = x0)
    {g : ℕ → E}
    (hg :
      ∀ t : ℕ,
        IsSubgradientAt (fun y ↦ (objective y : WithTop ℝ)) (x t) (g t) ∧
          (g t = firstSubgradient ∨ g t = secondSubgradient))
    {v : ℕ → E} (hv : ∀ t : ℕ, v t ∈ argmin[feasibleSet] (fun y : E ↦ inner ℝ (g t) y))
    (hx_succ : ∀ t : ℕ, x (t + 1) = (1 - τ t) • x t + τ t • v t) :
    ∀ t : ℕ, x t ∈ oracleHull x0 := sorry

-- Proof sketch: apply
-- `conditionalGradient_iterates_mem_oracleHull` to place each iterate in `conv{x₀, y₁, y₂}`,
-- then use `optimizer_not_mem_oracleHull`.
/-- Every iterate of the counterexample conditional-gradient trajectory stays away from the
optimizer `x_*`. -/
theorem conditionalGradient_iterates_ne_optimizer
    {x0 : E} (hx0_mem : x0 ∈ feasibleSet) (hx0_ne : x0 ≠ optimizer)
    {τ : ℕ → ℝ} (hτ : ∀ t : ℕ, τ t ∈ Set.Icc (0 : ℝ) 1)
    {x : ℕ → E} (hx_zero : x 0 = x0)
    {g : ℕ → E}
    (hg :
      ∀ t : ℕ,
        IsSubgradientAt (fun y ↦ (objective y : WithTop ℝ)) (x t) (g t) ∧
          (g t = firstSubgradient ∨ g t = secondSubgradient))
    {v : ℕ → E} (hv : ∀ t : ℕ, v t ∈ argmin[feasibleSet] (fun y : E ↦ inner ℝ (g t) y))
    (hx_succ : ∀ t : ℕ, x (t + 1) = (1 - τ t) • x t + τ t • v t) :
    ∀ t : ℕ, x t ≠ optimizer := sorry

end CoordinateMaxCounterexample

