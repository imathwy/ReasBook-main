/-! ### Proposition_2_5_1 (from Items/Chap02) -/
universe u v

noncomputable section

section

variable {X : Type u} {F : Type v} [Group F]

local instance : DecidableEq X := Classical.decEq X

open Subgroup (normalClosure)

namespace FreeGroupBasis

-- Primary domain: one-relator groups, free bases, and normal closures.
--
-- Layer triage:
-- `source-facing`: a free group `F` with basis `basis : FreeGroupBasis X F`, a cyclically reduced
-- relator `r`, and a basis generator `x` occurring in `r`.
-- `core/canonical`: `FreeGroupBasis X F`, `FreeGroup.IsCyclicallyReduced`, and
-- `Subgroup.normalClosure`.
-- `bridge/view`: `basis.repr` reads elements of `F` in the canonical free-group model, and
-- `basisLetterOccurs` is the chapter's owner-side occurrence predicate for basis generators.
--
-- Domain sampling:
-- 1. `FreeGroupBasis X F` is the canonical owner abstraction for a chosen basis of a free group.
-- 2. `FreeGroup.IsCyclicallyReduced` is mathlib's owner predicate for cyclically reduced words in
--    the concrete free-group model.
-- 3. `Subgroup.normalClosure` is the owner construction for the normal closure of a relator.
-- 4. `basisLetterOccurs` from Proposition `1-7-4` is the established bridge predicate expressing
--    that a basis generator occurs in the reduced word of an element.
--
-- Primitive vs. derived:
-- the primitive source data are the basis `basis`, the relator `r`, and the chosen generator
-- `x`; cyclic reduction and generator occurrence are both read canonically through `basis.repr`,
-- so no parallel wrapper around reduced words is introduced.

/-- Proposition 2-5-1: if `r` is cyclically reduced with respect to the chosen basis
`basis : FreeGroupBasis X F` and the basis generator `x` occurs in `r`, then every nontrivial
element of the normal closure of `r` also contains `x`. -/
-- Proof sketch: transport the statement through `basis.repr : F ≃* FreeGroup X` to the canonical
-- free-group model on `X`. There, apply Magnus's Freiheitssatz to the cyclically reduced relator
-- `basis.repr r`: a nontrivial consequence of `r` cannot lie in the subgroup generated by the
-- remaining basis letters, so the letter `x` must still occur.
theorem basisLetterOccurs_of_mem_normalClosure_singleton_of_isCyclicallyReduced
    (basis : FreeGroupBasis X F) {r w : F} {x : X}
    (hr : FreeGroup.IsCyclicallyReduced (basis.repr r).toWord)
    (hx : basisLetterOccurs basis x r)
    (hw : w ∈ normalClosure {r}) (hw_ne : w ≠ 1) :
    basisLetterOccurs basis x w := sorry

end FreeGroupBasis

end

/-! ### Proposition_2_5_2 (from Items/Chap02) -/
noncomputable section

-- Primary domain: combinatorial group theory for presentations indexed by an ordered family of
-- generators and relators.
-- Layer triage:
-- `source-facing`: the ordered generator families `Yᵢ`, the indexed relators `rⱼ`, the
-- interval-support restriction on relators and consequences, the staggered relator-family
-- condition, and the proposition that an interval-supported consequence is already forced by the
-- interval-supported relators.
-- `core/canonical`: `FreeGroup`, `reducedWordSupport`, `IsLeast`, `IsGreatest`, `Set.Icc`, and
-- `Subgroup.normalClosure`.
-- `bridge/view`: support indices are read by projecting the canonical reduced-word support
-- `reducedWordSupport w : Finset (Σ i, Y i)` along `Sigma.fst`, and “is a consequence of” is
-- expressed as membership in the normal closure of the relevant relator set.
-- Domain sampling:
-- 1. `reducedWordSupport` from Proposition `1-5-6` is the chapter owner notion of the
--    generators occurring in the canonical reduced word of an element of `FreeGroup Generators`.
-- 2. `IsLeast`, `IsGreatest`, and `Set.Icc α ω` are the canonical order-theoretic owners for the
--    least and greatest support indices and the interval they determine.
-- 3. `Subgroup.normalClosure` is the owner construction for the set of consequences of a relator
--    family.
-- 4. Projecting `reducedWordSupport w` along `Sigma.fst` is the canonical bridge from occurring
--    generators in `Σ i, Y i` to their support indices in `ι`.
-- Primitive vs. derived:
-- the primitive source data are the indexed generator families, the indexed relators, and the
-- least/greatest support-index data in the staggered relator-family property; the support-index
-- set, the extreme-support predicate, the interval-support predicate, the interval-restricted
-- relator set, and the consequence statement are derived from that data.

namespace GroupPresentation

section

variable {ι : Type u} [LinearOrder ι]
variable {Y : ι → Type v}
variable {J : Type w}

open Subgroup

local notation "Generators" => Σ i, Y i

/-- The support indices of the indexed generators occurring in `w`. -/
def supportIndices (w : FreeGroup Generators) : Set ι :=
  Sigma.fst '' (reducedWordSupport w : Set Generators)

/-- A word in the free group on the indexed generators `Σ i, Y i` is supported on the interval
`[α, ω]` when every support index of an occurring generator lies between `α` and `ω`. -/
def SupportedOnInterval (α ω : ι) (w : FreeGroup Generators) : Prop :=
  supportIndices w ⊆ Set.Icc α ω

/-- The generators of `w` have extreme support indices `α` and `ω`. -/
def HasExtremeSupport (w : FreeGroup Generators) (α ω : ι) : Prop :=
  IsLeast (supportIndices w) α ∧
    IsGreatest (supportIndices w) ω

/-- Least and greatest support indices bound the full support inside their interval. -/
theorem supportedOnInterval_of_hasExtremeSupport
    {w : FreeGroup Generators} {α ω : ι} (h : HasExtremeSupport w α ω) :
    SupportedOnInterval α ω w := by
  intro i hi
  exact ⟨h.1.2 hi, h.2.2 hi⟩

variable [Preorder J]

/-- A relator family is staggered when each relator has least and greatest support indices, and
those extremal indices increase strictly with the relator order. -/
def IsStaggeredRelatorFamily (r : J → FreeGroup Generators) : Prop :=
  ∃ initial terminal : J → ι,
    (∀ j, HasExtremeSupport (r j) (initial j) (terminal j)) ∧
      StrictMono initial ∧
      StrictMono terminal

/-- The relators supported on the interval `[α, ω]`. -/
def relatorsSupportedOnInterval (r : J → FreeGroup Generators) (α ω : ι) :
    Set (FreeGroup Generators) :=
  Set.range r ∩ SupportedOnInterval α ω

-- Proof sketch: apply the staggered Freiheitssatz argument to a van Kampen diagram for `w`.
-- Since every letter of `w` lies in the interval `[α, ω]`, the extreme relators forced by the
-- staggered ordering also lie in that interval; peeling them off inductively shows that `w`
-- belongs to the normal closure of exactly the relators supported in `[α, ω]`.
/-- Proposition 2-5-2: in a staggered presentation, any consequence whose generators all lie in the
interval `α ≤ i ≤ ω` is already a consequence of the relators whose generators lie in that same
interval. -/
theorem consequence_of_interval_relators_of_staggered_presentation
    (r : J → FreeGroup Generators)
    (hstaggered : IsStaggeredRelatorFamily r)
    {α ω : ι} {w : FreeGroup Generators}
    (hw : w ∈ normalClosure (Set.range r))
    (hsupp : SupportedOnInterval α ω w) :
    w ∈ normalClosure (relatorsSupportedOnInterval r α ω) := by
  sorry

end

end GroupPresentation

/-! ### Proposition_2_5_3 (from Items/Chap02) -/
universe u

section

variable {F : Type u} [Group F]

-- Primary domain: one-relator overgroups of free groups.
-- Layer triage:
-- `source-facing`: a finite ordered family `w : Fin n → F` of nontrivial coefficients in the free
-- group `F`, a parallel family `a : Fin n → ℤ` of nonzero exponents, and the alternating
-- one-variable equation `w₁ t^{a₁} ··· wₙ t^{aₙ} = 1`.
-- `core/canonical`: the owner object for a one-variable equation over `F` is the free product
-- `F ∗ Multiplicative ℤ`, evaluated in an overgroup by
-- `lift φ (zpowersHom G g) : F ∗ Multiplicative ℤ →* G`.
-- `bridge/view`: the source data determine the coproduct equation below; the overgroup witness is
-- still an injective homomorphism `φ : F →* G` together with an element `g : G` at which that
-- source-facing equation evaluates to `1`.
-- Domain sampling:
-- 1. `IsFreeGroup F` is mathlib's owner abstraction for the hypothesis that `F` is free.
-- 2. `F ∗ Multiplicative ℤ` together with `inl`, `inr`, and `lift` is the chapter/mathlib owner
--    API for one-variable words and their evaluation.
-- 3. `zpowersHom G g` is the canonical map sending the free variable to `g`.
-- 4. Proposition `1-8-3` already treats `F ∗ Multiplicative ℤ` as the owner type of one-variable
--    equations, so the local bridge should align with that owner vocabulary rather than introducing
--    a parallel evaluation API.
-- 5. `List.ofFn` and `List.prod` encode the ordered product matching the textbook equation word
--    `w₁ t^{a₁} ··· wₙ t^{aₙ}` inside the coproduct owner.
-- Primitive vs. derived:
-- the primitive source data are the free group `F`, the ordered coefficient family `w`, and the
-- ordered exponent family `a`, assembled directly into the canonical coproduct word
-- `w₁ t^{a₁} ··· wₙ t^{aₙ}`. The overgroup `G`, the injective homomorphism `φ`, and the chosen
-- element `g : G` are witness data in the proposition, and their evaluation map is derived from
-- the owner coproduct API.

/-- The alternating one-variable equation `w₁ t^{a₁} ··· wₙ t^{aₙ}` over `F`, encoded in the
canonical owner `F ∗ Multiplicative ℤ`. -/
def alternatingEquation {n : ℕ} (w : Fin n → F) (a : Fin n → ℤ) : F ∗ Multiplicative ℤ :=
  (List.ofFn fun i ↦ inl (w i) * inr (Multiplicative.ofAdd (a i))).prod

/-- Proposition 2-5-3: if `F` is a free group, `w : Fin n → F` is a family of nontrivial elements,
and `a : Fin n → ℤ` is a family of nonzero integers, then `F` embeds in a group containing an
element `g` for which the alternating word `w₁ t^{a₁} ··· wₙ t^{aₙ}` evaluates to the identity. -/
-- Proof sketch: adjoin a stable letter subject to the single relation
-- `w₁ t^{a₁} ··· wₙ t^{aₙ} = 1`, and then apply the Freiheitssatz for one-relator groups to show
-- that the canonical map from the original free group `F` into the resulting quotient is
-- injective.
theorem exists_embedding_realizing_alternating_relator [IsFreeGroup F] {n : ℕ}
    (w : Fin n → F) (a : Fin n → ℤ) (hw : ∀ i, w i ≠ 1) (ha : ∀ i, a i ≠ 0) :
    ∃ (G : Type u) (_ : Group G) (φ : F →* G),
      Function.Injective φ ∧
        ∃ g : G,
          lift φ (zpowersHom G g) (alternatingEquation w a) = 1 := sorry

end

/-! ### Proposition_2_5_4 (from Items/Chap02) -/
universe u

set_option autoImplicit false

namespace GroupPresentation

section

variable {X : Type u} [Primcodable X]

/-!
Primary domain: algorithmic one-relator group theory.

Layer triage:
- `source-facing`: a presentation on generators `X` with one defining relator `r`.
- `core/canonical`: `HasSolvableWordProblem` on relator sets `R : Set (FreeGroup X)`.
- `bridge/view`: a single defining relator is expressed canonically by the singleton relator set
  `{r}`.

Domain sampling:
1. `GroupPresentation.HasSolvableWordProblem` from Definition `2-1-4` is the chapter owner
   predicate for decidability of the word problem.
2. `GroupPresentation.hasSolvableWordProblem_iff_computable_mk_eq_one` is the owner-side bridge to
   the quotient formulation.
3. `computable_represents_element_of_generatorImageSubgroup` from Proposition `2-5-5` is the
   project's general owner theorem for subgroup-membership in one-relator quotients generated by a
   recursive subset of the distinguished generators.
4. `PresentedGroup R` is mathlib's canonical owner for the quotient attached to generators and
   relators.

Primitive vs. derived:
the primitive public data are only `X` and `r`; solvability of the word problem is the derived
owner predicate on the singleton relator set, so no separate one-relator wrapper belongs in the
public API.
-/

-- Proof sketch: specialize Proposition `2-5-5` to the empty subset of generators. The subgroup
-- generated by the empty image in the one-relator quotient is trivial, so the resulting
-- subgroup-membership test is exactly the word problem for the singleton relator set `{r}`.
/-- Proposition 2-5-4: every presentation with a single defining relator has solvable word
problem. In the owner formulation, the singleton relator set `{r}` has decidable trivial-word
problem in its presented group. -/
theorem hasSolvableWordProblem_singleton (r : FreeGroup X) :
    HasSolvableWordProblem ({r} : Set (FreeGroup X)) := by
  rw [hasSolvableWordProblem_iff_computable_mk_eq_one]
  let hEmpty : ComputablePred (fun x : X ↦ x ∈ (∅ : Set X)) := by
    refine Computable.computablePred ?_
    simpa using (Computable.const false : Computable (fun _ : X ↦ false))
  refine ComputablePred.of_eq
    (computable_represents_element_of_generatorImageSubgroup r ∅ hEmpty) ?_
  intro L
  simp

end

end GroupPresentation

/-! ### Proposition_2_5_5 (from Items/Chap02) -/
universe u

namespace GroupPresentation

section

variable {X : Type u} [Primcodable X]

-- Layer triage:
-- `source-facing`: a one-relator group `G = (X; r)`, a recursive subset `X₀ ⊆ X`, the subgroup
-- `G₀` generated by the image of `X₀`, and the decision problem of whether a word in the free
-- group represents an element of `G₀`.
-- `core/canonical`: `PresentedGroup ({r} : Set (FreeGroup X))`, `PresentedGroup.mk`,
-- `PresentedGroup.of`, `Subgroup.closure`, and `ComputablePred`.
-- `bridge/view`: a signed word `L : List (X × Bool)` represents an element of `G₀` exactly when
-- its image under the canonical quotient map belongs to
-- `Subgroup.closure (PresentedGroup.of '' X₀)`.
-- Domain sampling:
-- 1. `PresentedGroup ({r} : Set (FreeGroup X))` is mathlib's canonical one-relator quotient.
-- 2. `PresentedGroup.mk ({r} : Set (FreeGroup X))` is the canonical quotient map from
--    `FreeGroup X`.
-- 3. `PresentedGroup.of` is the canonical map from defining generators into that quotient.
-- 4. `Subgroup.closure` is the owner construction for the subgroup generated by a subset.
-- 5. `ComputablePred` is the chapter's canonical computability interface for decidability on
--    coded words.
-- Primitive vs. derived:
-- the primitive mathematical data are the relator `r`, the recursive subset `X₀`, and the signed
-- word `L`; the subgroup generated by the image of `X₀` is a derived owner-side object, so the
-- statement uses `Subgroup.closure (PresentedGroup.of '' X₀)` directly rather than a parallel
-- local wrapper.

-- Proof sketch: apply the standard one-relator subgroup-membership algorithm to the subgroup
-- generated by the image of the recursive subset `X₀`; the recursive hypothesis gives an
-- effective test for whether a defining generator lies in `X₀`, so signed words can be decided
-- for membership in the corresponding subgroup of the quotient.
/-- Proposition 2-5-5: if `G = (X; r)` is a one-relator group, `X₀ ⊆ X` is recursive, and `G₀`
is the subgroup generated by the image of `X₀`, then one can decide whether a signed word on `X`
represents an element of `G₀`. -/
theorem computable_represents_element_of_generatorImageSubgroup
    (r : FreeGroup X) (X₀ : Set X) (hX₀ : ComputablePred fun x : X ↦ x ∈ X₀) :
    ComputablePred fun L : List (X × Bool) ↦
      PresentedGroup.mk ({r} : Set (FreeGroup X)) (FreeGroup.mk L) ∈
        Subgroup.closure (PresentedGroup.of '' X₀) := sorry

end

end GroupPresentation

/-! ### Proposition_2_5_6 (from Items/Chap02) -/
open scoped Pointwise
open Subgroup

universe u v

section

variable {X : Type u} {F : Type v} [Group F] [Primcodable X]
variable (basis : FreeGroupBasis X F) (X₁ X₂ : Set X) (r : F)

local notation "F₁" => closure (basis '' X₁)
local notation "F₂" => closure (basis '' X₂)
local notation "N" => normalClosure (Set.singleton r)

-- Layer triage:
-- `source-facing`: an ambient free group `F` equipped with a chosen basis
-- `basis : FreeGroupBasis X F`, recursive subsets `X₁`, `X₂` of that basis, the generated
-- subgroups `F₁`, `F₂`, the normal closure `N` of a relator `r : F`, and the decision problem for
-- the subset `F₁ N F₂` of `F`.
-- `core/canonical`: Proposition `2-5-5`'s owner theorem
-- `GroupPresentation.computable_represents_element_of_generatorImageSubgroup`, transported through
-- `basis.repr`, together with `Subgroup.closure`, `Subgroup.normalClosure`,
-- `Subgroup.mul_normal`, `MonoidHom.map_closure`, `FreeGroup.mk`, and `ComputablePred`.
-- `bridge/view`: a signed word `L : List (X × Bool)` encodes the ambient element
-- `basis.repr.symm (FreeGroup.mk L)`, and the source product `F₁ N` is expressed canonically as
-- the subgroup join `F₁ ⊔ N` via `Subgroup.mul_normal`; after quotienting by `N`, membership in
-- `F₁ N F₂` is read as membership in the product of the two canonical generated subgroups of the
-- one-relator quotient, then pulled back along `basis.repr`.
-- Domain sampling:
-- 1. `FreeGroupBasis X F` is the chapter and mathlib owner abstraction for a chosen basis of an
--    ambient free group.
-- 2. `basis.repr : F ≃* FreeGroup X` is the canonical transport between intrinsic basis-level
--    elements of `F` and coded words on `X`.
-- 3. Proposition `2-5-5`'s
--    `GroupPresentation.computable_represents_element_of_generatorImageSubgroup` is the chapter's
--    owner theorem for recursive generated-subgroup membership in a one-relator quotient.
-- 4. `Subgroup.closure` and `Subgroup.normalClosure` are the owner constructions for generated
--    subgroups and normal closures.
-- 5. `Subgroup.mul_normal` is the owner theorem identifying the source product `F₁ N` with the
--    subgroup join `F₁ ⊔ N` when `N` is normal.
-- 6. `ComputablePred` is the project's canonical interface for algorithmic decidability on coded
--    words.
-- Primitive vs. derived:
-- the primitive source data are the chosen basis `basis`, the recursive subsets `X₁`, `X₂`, and
-- the relator `r`; the subgroup owners `F₁`, `F₂`, `N`, and the joined factor `F₁ ⊔ N` are
-- derived from that data and are therefore kept only as owner-side local notation built from
-- `Subgroup.closure`, `Subgroup.normalClosure`, and subgroup join.

/-- Proposition 2-5-6: if `X₁` and `X₂` are recursive subsets of the chosen basis
`basis : FreeGroupBasis X F`, `F₁` and `F₂` are the subgroups they generate in the ambient free
group `F`, and `N` is the normal closure of `r`, then the subset `F₁ N F₂` of `F` has decidable
membership for signed words on the basis alphabet `X`. -/
-- Proof sketch: transport a signed word `L` to the ambient element
-- `basis.repr.symm (FreeGroup.mk L)`, identify `F₁` and `F₂` with the subgroups generated by
-- `basis '' X₁` and `basis '' X₂`, absorb the normal factor `N` into the canonical subgroup join
-- `F₁ ⊔ N` via `Subgroup.mul_normal`, pass to the one-relator quotient determined by
-- `basis.repr r`, and apply Proposition `2-5-5` to the generated subgroups coming from `X₁` and
-- `X₂`, transporting the resulting computable predicate back along the basis equivalence.
theorem computable_represents_element_of_generated_subgroup_mul_normalClosure_mul_generated_subgroup
    (hX₁ : ComputablePred fun x : X ↦ x ∈ X₁)
    (hX₂ : ComputablePred fun x : X ↦ x ∈ X₂) :
    ComputablePred fun L : List (X × Bool) ↦
      basis.repr.symm (FreeGroup.mk L) ∈
        (((F₁ ⊔ N : Subgroup F) : Set F) * F₂) := sorry

end

/-! ### Proposition_2_5_7 (from Items/Chap02) -/
universe u

section

variable {F : Type u} [Group F] [IsFreeGroup F]

open Subgroup

-- Layer triage:
-- `source-facing`: two elements `r₁ r₂ : F` in a free group with equal normal closures.
-- `core/canonical`: `Subgroup.normalClosure` for the normal subgroup generated by one element and
-- `IsConj` for conjugacy.
-- `bridge/view`: the source phrase “the same normal closure” is rendered canonically as equality
-- of the singleton normal closures `Subgroup.normalClosure {r₁}` and
-- `Subgroup.normalClosure {r₂}`.
-- Domain sampling:
-- 1. `Subgroup.normalClosure` is mathlib's owner construction for the normal closure of a subset.
-- 2. `IsConj` is mathlib's owner relation for conjugacy in a group.
-- 3. The surrounding chapter already states free-group results on abstract groups `[IsFreeGroup F]`
--    rather than only on the concrete model `FreeGroup X`, so the same owner level is used here.
-- 4. `conjugate_or_conjugate_inv_of_normalClosure_eq` is itself the chapter owner theorem for
--    this Magnus conclusion, so no extra wrapper or basis-level restatement belongs here.
-- Primitive vs. derived:
-- the primitive data are just the two elements and the equality of their singleton normal
-- closures; no extra presentation package or chosen basis belongs in the statement.

-- Proof sketch: this is Magnus's conjugacy theorem for one-relator normal closures in a free
-- group. One analyzes cyclic reductions of `r₁` and `r₂`; equality of their normal closures
-- forces the reduced relators to agree up to cyclic permutation and inversion, which is exactly
-- conjugacy to `r₂` or to `r₂⁻¹`.
/-- Proposition 2-5-7: if two elements of a free group have the same singleton normal closure,
then one is conjugate to the other or to its inverse. -/
theorem conjugate_or_conjugate_inv_of_normalClosure_eq
    (r₁ r₂ : F)
    (hclosure : normalClosure ({r₁}) = normalClosure ({r₂})) :
    IsConj r₁ r₂ ∨ IsConj r₁ r₂⁻¹ := sorry

end

/-! ### Proposition_2_5_8 (from Items/Chap02) -/
universe u

section

variable {F : Type u} [Group F] [IsFreeGroup F]

open Subgroup

-- Layer triage:
-- `source-facing`: elements `r₁ r₂ : F` of an arbitrary free group and a positive power relation
-- between their singleton normal closures.
-- `core/canonical`: `Subgroup.normalClosure` on singleton subsets of the ambient group.
-- `bridge/view`: the singleton normal closure is the source-facing relation, while the associated
-- one-relator quotient is only an auxiliary view; no separate quotient wrapper belongs in the
-- public statement.
-- Domain sampling:
-- 1. `Subgroup.normalClosure` is mathlib's owner construction for the normal subgroup generated by
--    a subset, so it is the correct owner abstraction for “is a consequence of `r₂`”.
-- 2. `Subgroup.normalClosure_subset_iff` is mathlib's canonical bridge from subset membership to
--    an inclusion of normal closures, so the singleton-inclusion reformulation is already
--    upstream and does not need a parallel local theorem here.
-- 3. `IsFreeGroup` is mathlib's owner abstraction for the intrinsic notion that the ambient group
--    is free, so the proposition stays on an abstract free group rather than choosing a basis.
-- 4. `conjugate_or_conjugate_inv_of_normalClosure_eq` from Proposition `2-5-7` is the chapter's
--    owner theorem for equality of singleton normal closures in an abstract free group, so the
--    current item should stay at the same owner level rather than introducing a quotient wrapper.
-- 5. `conjugate_or_conjugate_inv_of_mem_normalClosure_of_isPrimitiveElement` from Proposition
--    `2-5-14` is the adjacent chapter owner theorem for source-facing membership in a singleton
--    normal closure, confirming that normal-closure membership itself is already the right public
--    surface here.
-- Primitive vs. derived:
-- the primitive public data are only `r₁`, `r₂`, the positive integer `n`, and the hypothesis
-- that `r₁ ^ n` lies in the singleton normal closure generated by `r₂ ^ n`; passing to a
-- one-relator quotient is a derived proof view rather than primitive API data. The associated
-- singleton-normal-closure inclusion is likewise derived owner-level API, and its canonical
-- formulation already comes from `Subgroup.normalClosure_subset_iff`.

/-- Proposition 2-5-8: if `r₁` and `r₂` are elements of a free group and, for some positive
integer `n`, the power `r₁ ^ n` lies in the normal closure of `r₂ ^ n`, then `r₁` lies in the
normal closure of `r₂`. -/
-- Proof sketch: this is Magnus's root-extraction theorem for one-relator normal closures in a
-- free group. The hypothesis says that the `n`th power of `r₁` becomes trivial in the quotient by
-- the singleton normal closure generated by `r₂ ^ n`; Magnus's analysis of roots in free groups
-- then shows that the image of `r₁` is already trivial in the quotient by the singleton normal
-- closure generated by `r₂`, which is exactly the desired membership statement.
theorem mem_normalClosure_singleton_of_pow_mem_normalClosure_pow_singleton
    (r₁ r₂ : F) (n : ℕ+)
    (hpow : r₁ ^ (n : ℕ) ∈ normalClosure ({r₂ ^ (n : ℕ)})) :
    r₁ ∈ normalClosure ({r₂}) := sorry

end

/-! ### Proposition_2_5_9 (from Items/Chap02) -/
universe u

section

variable {X : Type u} (r : FreeGroup X)

local notation "G" => PresentedGroup (Set.singleton r : Set (FreeGroup X))

-- Layer triage:
-- `source-facing`: a one-relator group `G = (X; r)`, rendered canonically as the quotient
-- `PresentedGroup (Set.singleton r : Set (FreeGroup X))`, together with the hypothesis that this quotient is
-- itself
-- free.
-- `core/canonical`: `PresentedGroup` for one-relator presentations, `IsFreeGroup` for the
-- ambient freeness hypothesis on the quotient, and `IsPrimitiveElement` as the chapter owner for
-- the statement that `r` belongs to some basis of the ambient free group on `X`.
-- `bridge/view`: `IsPrimitiveElement r` records a same-universe basis witness for `r`; an
-- arbitrary chosen basis is canonically reindexed to its range via
-- `FreeGroupBasis.reindexRange`, so
-- the source wording is recovered without a duplicate existential wrapper theorem.
-- Domain sampling:
-- 1. `PresentedGroup R` is mathlib's canonical owner for a group defined by generators and
--    relators.
-- 2. `IsFreeGroup` is mathlib's owner predicate for freeness of a group.
-- 3. `FreeGroupBasis X F`, together with the owner bridge `FreeGroupBasis.reindexRange`, is the
--    canonical API for chosen free bases and the corresponding basis subset in the ambient group.
-- 4. `IsPrimitiveElement` from `CombinatorialGroupTheory_Magnus_2004.Basic` is the project owner for the
--    recurring “belongs to some basis”
--    conclusion, while basis witnesses are bridge data.
-- Primitive vs. derived:
