/-! ### Proposition_3_12_1 (from Items/Chap03) -/
universe u

section

variable {G : Type u} [Group G] [Group.FG G]

/-- Proposition 3-12-1: if `G` is generated by `n` elements and `H` has finite index in `G`, then
`H` is generated by at most `H.index * (n - 1) + 1` elements. -/
-- Layer triage:
-- `source-facing`: a finitely generated group `G`, a finite-index subgroup `H ≤ G`, and
-- Schreier's bound on the number of generators of `H`.
-- `core/canonical`: `Group.rank` is the owner for the minimum number of generators of a finitely
-- generated group, `Subgroup.index` is the owner for subgroup index, and `Subgroup.fg_of_index_ne_zero`
-- is the inherited finite-generation instance for finite-index subgroups.
-- `bridge/view`: the textbook phrases “generated by `n` elements” and “generated by at most `m`
-- elements” are expressed canonically as the inequalities `Group.rank G ≤ n` and
-- `Group.rank H ≤ m`, so the redundant intermediate variable `m` is replaced by its defining
-- value `H.index * (n - 1) + 1`.
-- Domain sampling:
-- 1. `Group.rank` and `Group.rank_spec` in `Mathlib/GroupTheory/Rank` are the canonical API for
--    finite generating-number statements.
-- 2. `Subgroup.fg_of_index_ne_zero` in `Mathlib/GroupTheory/Schreier` is the canonical owner
--    theorem that finite-index subgroups of finitely generated groups are finitely generated.
-- 3. `Subgroup.rank_le_index_mul_rank` is the upstream Schreier rank bound already phrased in the
--    owner language `Group.rank` and `Subgroup.index`.
-- Primitive vs. derived:
-- the primitive public data are only the subgroup `H` and the ambient generating-number bound
-- `Group.rank G ≤ n`; finite generation of `H` and the target generating-number bound are derived
-- canonically from those owner abstractions.
-- Proof sketch: apply Schreier's rewriting process to a generating set of size `n` for `G`,
-- discard the redundant transversal-edge generators, and count the remaining Schreier generators.
theorem finiteIndex_subgroup_rank_le_schreier_bound
    (H : Subgroup G) [H.FiniteIndex] {n : ℕ} (hG : Group.rank G ≤ n) :
    Group.rank H ≤ H.index * (n - 1) + 1 := sorry

end

/-! ### Remark_3_12_2 (from Items/Chap03) -/
universe u

open Relation (EqvGen)
open List (finRange)

namespace CosetTable

noncomputable section

/-!
Primary domain: the iterative relator-table step in coset-table enumeration.

Layer triage:
- `source-facing`: a coset-table state consisting of the current relator tables together with the
  equations already recorded between labels, plus the rule choosing the first appearing label that
  still lacks a row and the first relator table in which that happens.
- `core/canonical`: `List` is the owner for relator words, ordered row data, and first-occurrence
  scans,
  `Fin R.length` is the owner for the finitely many relator tables,
  `ℕ → ℕ → Prop` is the owner form for the primitive recorded-equation data, and
  `Relation.EqvGen` is the owner for the equivalence relation generated by the recorded label
  equations.
- `bridge/view`: the textbook phrases “first appearing label”, “first relator table”, and
  “recorded-equal label” are expressed by ordered list scans of the current tables together with
  the equivalence closure of the recorded-equation relation.

Domain sampling:
1. `List.extractp` is the canonical ordered-list owner for selecting the first entry satisfying a
   decidable predicate.
2. `List.dedup` removes duplicates from a list, so `reverse ∘ dedup ∘ reverse` gives the labels in
   first-appearance order.
3. `Fin R.length` is the canonical owner for the finitely many relator tables attached to the
   relators in `R`.
4. Binary relations `ℕ → ℕ → Prop` and `Relation.EqvGen` are the canonical owner declarations for
   recorded label equations and for labels joined by a finite chain of such equations.

Primitive vs. derived:
- primitive data: the current relator tables and the recorded-equation relation between labels;
- derived API: the predicates saying that a label appears, begins a relator-word-labelled row in a
  given table, still needs such a row, satisfies the positive terminal condition, or yields an
  admissible next step-row.
-/

variable {α : Type u} (R : List (List α))

/-- A row in the table for the relator word `r` consists of a starting label together with one
successive target label for each letter of `r`, recorded in the same order as the letters of
`r`. Since the relator word is already the owner list parameter, the row stores only the label
data. -/
structure RelatorRow (r : List α) where
  start : ℕ
  targetLabels : List ℕ
  targetLabels_length : targetLabels.length = r.length

namespace RelatorRow

variable {r : List α}

attribute [simp] RelatorRow.targetLabels_length

/-- The full sequence of labels in a relator row, starting with the initial label. -/
def labels (row : RelatorRow r) : List ℕ :=
  row.start :: row.targetLabels

@[simp] theorem labels_length (row : RelatorRow r) :
    row.labels.length = r.length + 1 := by
  simp [labels]

@[simp] theorem labels_ne_nil (row : RelatorRow r) : row.labels ≠ [] := by
  simp [labels]

/-- The terminal label of a relator row. Since every row starts with its initial label, the full
label list is canonically nonempty. -/
def lastLabel (row : RelatorRow r) : ℕ :=
  row.labels.getLast row.labels_ne_nil

end RelatorRow

/-- A state of the coset-table algorithm consists of the current relator tables together with the
equations that have already been recorded between labels. -/
structure State where
  tables : (i : Fin R.length) → List (RelatorRow (R.get i))
  equations : ℕ → ℕ → Prop

namespace State

variable {R}

/-- Two labels are identified for the purposes of the algorithm when they are connected by a
finite chain of recorded equations. -/
def RecordedEquivalent (s : State R) : ℕ → ℕ → Prop :=
  EqvGen s.equations

/-- A label appears in the current tables when it occurs somewhere in some row of some relator
table. -/
def Appears (s : State R) (k : ℕ) : Prop :=
  ∃ i : Fin R.length, ∃ row ∈ s.tables i, k ∈ row.labels

/-- A label begins a row in the table attached to the `i`th relator when it is the first entry of
one of that table's rows. -/
def BeginsRow (s : State R) (i : Fin R.length) (k : ℕ) : Prop :=
  ∃ row ∈ s.tables i, row.start = k

/-- A label still needs a new row in the table for the `i`th relator when no recorded-equivalent
label begins a row there. -/
def NeedsNewRowInTable (s : State R) (k : ℕ) (i : Fin R.length) : Prop :=
  ¬ ∃ k', s.RecordedEquivalent k k' ∧ s.BeginsRow i k'

/-- The labels occurring anywhere in the current relator tables, with repetitions. -/
def entries (s : State R) : List ℕ :=
  (finRange R.length).flatMap fun i ↦ (s.tables i).flatMap RelatorRow.labels

/-- The labels already appearing in the current tables, listed in first-appearance order. -/
def appearingLabels (s : State R) : List ℕ :=
  let labels := s.entries.reverse
  let uniqueLabels := labels.dedup
  uniqueLabels.reverse

/-- A label still needs a new row somewhere if one of the relator tables lacks an initial row for
that label up to recorded equivalence. -/
def NeedsNewRow (s : State R) (k : ℕ) : Prop :=
  ∃ i : Fin R.length, s.NeedsNewRowInTable k i

/-- The first appearing label that still lacks a row in some relator table. -/
def firstLabelNeedingRow? (s : State R) : Option ℕ :=
  let _ : DecidablePred s.NeedsNewRow := Classical.decPred _
  (s.appearingLabels.extractp s.NeedsNewRow).1

/-- For a fixed label, the first relator table in which that label still lacks a row. -/
def firstTableNeedingRow? (s : State R) (k : ℕ) : Option (Fin R.length) :=
  let _ : DecidablePred (s.NeedsNewRowInTable k) := Classical.decPred _
  ((finRange R.length).extractp (s.NeedsNewRowInTable k)).1

/-- The next pending task in the algorithm: choose the first appearing label still lacking a row,
then the first relator table in which that happens. -/
def nextTask? (s : State R) : Option (ℕ × Fin R.length) :=
  do
    let k ← s.firstLabelNeedingRow?
    let i ← s.firstTableNeedingRow? k
    pure (k, i)

/-- A noninitial entry of a newly completed row is admitted by the source-facing relator-table
construction when it is either already represented up to recorded-equivalence, or is genuinely new
to the current state. -/
def RecordedOrFresh (s : State R) (k : ℕ) : Prop :=
  (∃ k', s.RecordedEquivalent k k' ∧ s.Appears k') ∨ ¬ s.Appears k

/-- A relator-word-labelled row is a valid next-row completion for the `i`th relator table
starting at `k` when it starts at `k`, and each later label supplied along the actual relator word
`R.get i` is either already represented up to recorded equivalence or is genuinely new. -/
def IsNextRow (s : State R) (k : ℕ) (i : Fin R.length) (row : RelatorRow (R.get i)) : Prop :=
  row.start = k ∧
    ∀ x ∈ row.targetLabels, s.RecordedOrFresh x

/-- The equation contributed by closing a newly completed relator row identifies its terminal label
with its initial label. -/
def rowEquation {r : List α} (row : RelatorRow r) : ℕ → ℕ → Prop :=
  fun k k' ↦ k = row.lastLabel ∧ k' = row.start

/-- Append a completed relator row to the chosen table and record the equation produced by closing
that row. -/
def recordRow (s : State R) (i : Fin R.length) (row : RelatorRow (R.get i)) : State R :=
  { tables := fun j ↦
      if h : j = i then
        h.symm ▸ (s.tables i ++ [row])
      else
        s.tables j
    equations := fun k k' ↦ s.equations k k' ∨ rowEquation row k k' }

/-- Remark 3-12-2 in source-facing form: one algorithmic step chooses the first pending pair
`(k, i)`, completes the corresponding relator-word-labelled row using recorded-equal or fresh
labels, and records the resulting equation. -/
def Step (s t : State R) : Prop :=
  ∃ k i row,
    s.nextTask? = some (k, i) ∧
      s.IsNextRow k i row ∧
      t = s.recordRow i row

/-- The positive terminal condition from the last sentence of Remark 3-12-2: every appearing label
already begins a row in every relator table, possibly after replacing it by a recorded-equivalent
label. -/
def Terminated (s : State R) : Prop :=
  ∀ k, s.Appears k →
    ∀ i : Fin R.length, ∃ k', s.RecordedEquivalent k k' ∧ s.BeginsRow i k'

/-- The auxiliary “needs a new row” condition is the negation of the terminal row-initiality
condition for a fixed label and relator table. -/
theorem not_needsNewRowInTable_iff
    (s : State R) (k : ℕ) (i : Fin R.length) :
    ¬ s.NeedsNewRowInTable k i ↔
      ∃ k', s.RecordedEquivalent k k' ∧ s.BeginsRow i k' := by
  classical
  simp [NeedsNewRowInTable]

end State

end

end CosetTable

/-! ### Proposition_3_12_3 (from Items/Chap03) -/
universe u v

open scoped Pointwise
open scoped Monoid.Coprod
open Monoid.Coprod

set_option autoImplicit false

section

variable {G : Type u} {Ω : Type v} [Group G] [MulAction G Ω]

/-!
Primary domain: group actions, subgroup generation, and the ping-pong free-product alternative.

Layer triage:
- `source-facing`: two subgroups `G₁` and `G₂` of a group `G` acting on `Ω`, together with two
  disjoint nonempty subsets `Ω₁` and `Ω₂` satisfying the alternating ping-pong containment
  hypotheses from the textbook.
- `core/canonical`: `Subgroup G` is the owner abstraction for the subgroup factors and their join
  `G₁ ⊔ G₂`, the pointwise action `g • Ωᵢ` is the owner API for the set-containment hypotheses,
  `Monoid.Coprod` with notation `G₁ ∗ G₂` is mathlib's owner for the free product of the two
  subgroup types, and `DihedralGroup n` is mathlib's owner for the finite and infinite dihedral
  groups.
- `bridge/view`: the canonical map from the free product `G₁ ∗ G₂` to the generated subgroup is
  the coproduct lift of the two subgroup inclusions `G₁ ≤ G₁ ⊔ G₂` and `G₂ ≤ G₁ ⊔ G₂`.

Domain sampling:
1. `[MulAction G Ω]` is the intrinsic owner of the action used in the ping-pong hypotheses, so
   this proposition should live over `Subgroup G` rather than the special model
   `Subgroup (Equiv.Perm Ω)`.
2. `Subgroup` and the lattice operation `⊔` are the canonical owners for the subgroup generated by
   two given subgroups.
3. The pointwise action `g • Ωᵢ` on subsets is the canonical owner for the ping-pong
   set-containment hypotheses.
4. `Monoid.Coprod` with notation `G₁ ∗ G₂` is mathlib's owner for the free product of two groups.
5. `DihedralGroup n` is the canonical family containing both finite and infinite dihedral groups.
6. Proposition `3_12_5` in this chapter already uses the same intrinsic action-theoretic owner
   level for two-set ping-pong statements.

Primitive vs. derived:
- primitive public data: the two subgroup factors, the action on `Ω`, and the ping-pong subsets
  with their disjointness, nonemptiness, and alternating image-containment hypotheses;
- derived API: the resulting free-product equivalence `G₁ ∗ G₂ ≃* ↥(G₁ ⊔ G₂)` and the conclusion
  that the generated subgroup is either the free product of the two factors or falls into the
  exceptional order-`2` dihedral case.
-/

variable (G₁ G₂ : Subgroup G)

variable
    (Ω₁ Ω₂ : Set Ω)
    (hdisjoint : Disjoint Ω₁ Ω₂)
    (hΩ₁ : Ω₁.Nonempty)
    (hΩ₂ : Ω₂.Nonempty)
    (h₁ : ∀ g : G₁, g ≠ 1 → (g : G) • Ω₁ ⊆ Ω₂)
    (h₂ : ∀ g : G₂, g ≠ 1 → (g : G) • Ω₂ ⊆ Ω₁)

include hdisjoint hΩ₁ hΩ₂ h₁ h₂

/-- The canonical comparison map from the free product of `G₁` and `G₂` to the subgroup they
generate. -/
private def freeProductToSup : G₁ ∗ G₂ →* ↥(G₁ ⊔ G₂) :=
  lift (Subgroup.inclusion le_sup_left) (Subgroup.inclusion le_sup_right)

/-- If the two-subgroup ping-pong hypotheses hold and the exceptional order-`2`/order-`2` case is
excluded, then the canonical map from `G₁ ∗ G₂` to `G₁ ⊔ G₂` is bijective. -/
private theorem freeProductToSup_bijective_of_two_subgroup_pingPong
    (hnot_dihedral : ¬ (Nat.card G₁ = 2 ∧ Nat.card G₂ = 2)) :
    Function.Bijective (freeProductToSup G₁ G₂) := sorry

/-- The canonical free-product equivalence induced by the two-subgroup ping-pong hypotheses away
from the exceptional order-`2`/order-`2` branch. -/
noncomputable def freeProductSupEquivOfTwoSubgroupPingPong
    (hnot_dihedral : ¬ (Nat.card G₁ = 2 ∧ Nat.card G₂ = 2)) :
    G₁ ∗ G₂ ≃* ↥(G₁ ⊔ G₂) :=
  MulEquiv.ofBijective
    (freeProductToSup G₁ G₂)
    (freeProductToSup_bijective_of_two_subgroup_pingPong
      G₁ G₂ Ω₁ Ω₂ hdisjoint hΩ₁ hΩ₂ h₁ h₂ hnot_dihedral)

@[simp] theorem freeProductSupEquivOfTwoSubgroupPingPong_inl
    (hnot_dihedral : ¬ (Nat.card G₁ = 2 ∧ Nat.card G₂ = 2)) (g : G₁) :
    freeProductSupEquivOfTwoSubgroupPingPong
        G₁ G₂ Ω₁ Ω₂ hdisjoint hΩ₁ hΩ₂ h₁ h₂ hnot_dihedral
        (inl g) =
      Subgroup.inclusion le_sup_left g := by
  simp [freeProductSupEquivOfTwoSubgroupPingPong, freeProductToSup,
    MulEquiv.ofBijective_apply]

@[simp] theorem freeProductSupEquivOfTwoSubgroupPingPong_inr
    (hnot_dihedral : ¬ (Nat.card G₁ = 2 ∧ Nat.card G₂ = 2)) (g : G₂) :
    freeProductSupEquivOfTwoSubgroupPingPong
        G₁ G₂ Ω₁ Ω₂ hdisjoint hΩ₁ hΩ₂ h₁ h₂ hnot_dihedral
        (inr g) =
      Subgroup.inclusion le_sup_right g := by
  simp [freeProductSupEquivOfTwoSubgroupPingPong, freeProductToSup,
    MulEquiv.ofBijective_apply]

-- Proof sketch: this is the two-subgroup ping-pong argument. If one factor has more than two
-- elements, the containment hypotheses sharpen to strict disjointness of the relevant translates,
-- and a reduced alternating word moves `Ω₁` strictly inside itself, so the generated subgroup is
-- canonically identified with the free product `G₁ ∗ G₂`. The only remaining case is when both
-- factors have order `2`, where
-- every additional relation is of the form `(ab)^n = 1`; this identifies the generated subgroup
-- with a finite dihedral group, and the relation-free case gives the infinite dihedral group.
/-- Proposition 3-12-3: if two subgroup factors acting on `Ω` satisfy the alternating ping-pong
hypotheses on disjoint nonempty subsets `Ω₁` and `Ω₂`, then the subgroup they generate is either
their free product, or both factors have order `2` and the generated subgroup is dihedral. -/
theorem freeProduct_or_dihedral_of_two_subgroup_pingPong
    :
    Nonempty (G₁ ∗ G₂ ≃* ↥(G₁ ⊔ G₂)) ∨
      Nat.card G₁ = 2 ∧ Nat.card G₂ = 2 ∧
        ∃ n : ℕ, Nonempty (DihedralGroup n ≃* ↥(G₁ ⊔ G₂)) := by
  by_cases hnot_dihedral : ¬ (Nat.card G₁ = 2 ∧ Nat.card G₂ = 2)
  · exact .inl
      ⟨freeProductSupEquivOfTwoSubgroupPingPong
        G₁ G₂ Ω₁ Ω₂ hdisjoint hΩ₁ hΩ₂ h₁ h₂ hnot_dihedral⟩
  · sorry

end

/-! ### Proposition_3_12_4 (from Items/Chap03) -/
open scoped MatrixGroups

section

-- Layer triage:
-- `source-facing`: the two explicit integral matrices
-- `A = !![1, 2; 0, 1]` and `B = !![1, 0; 2, 1]`.
-- `core/canonical`: the subgroup owner `Subgroup (SL(2, ℤ))` together with the subset-style
-- basis predicate `IsFreeGroupBasis` on the corresponding generating subset of the closure.
-- `bridge/view`: the explicit matrices are packaged as elements of `SL(2, ℤ)` via their
-- determinant-one certificates, but the main statement remains about the concrete matrices named
-- in the source.
-- Domain sampling:
-- 1. `SL(2, ℤ)` from `Matrix.SpecialLinearGroup` is the clean matrix-group owner for these
--    determinant-one matrices.
-- 2. `Subgroup.closure` is the canonical owner for the subgroup generated by a set of group
--    elements.
-- 3. `IsFreeGroupBasis` is the chapter's canonical source-facing owner for “these displayed
--    elements form a free basis of the subgroup they generate,” while `FreeGroupBasis` is derived
--    from it only when an indexed basis is needed.
-- Primitive vs. derived:
-- the primitive data are the two explicit matrices `A` and `B`; the subgroup they generate is the
-- derived canonical object `Subgroup.closure ({A, B} : Set (SL(2, ℤ)))`, and the proposition
-- asserts that these two generators themselves form a free basis of that subgroup.

/-- The determinant of the upper-unitriangular matrix `!![1, 2; 0, 1]` is `1`. -/
-- Proof sketch: evaluate the determinant of this explicit `2 × 2` matrix using
-- `Matrix.det_fin_two`.
theorem sanovMatrixA_det :
    Matrix.det (!![1, 2; 0, 1] : Matrix (Fin 2) (Fin 2) ℤ) = 1 := sorry

/-- The matrix `A = !![1, 2; 0, 1]` as an element of `SL(2, ℤ)`. -/
def sanovMatrixA : SL(2, ℤ) :=
  ⟨!![1, 2; 0, 1], sanovMatrixA_det⟩

/-- The determinant of the lower-unitriangular matrix `!![1, 0; 2, 1]` is `1`. -/
-- Proof sketch: evaluate the determinant of this explicit `2 × 2` matrix using
-- `Matrix.det_fin_two`.
theorem sanovMatrixB_det :
    Matrix.det (!![1, 0; 2, 1] : Matrix (Fin 2) (Fin 2) ℤ) = 1 := sorry

/-- The matrix `B = !![1, 0; 2, 1]` as an element of `SL(2, ℤ)`. -/
def sanovMatrixB : SL(2, ℤ) :=
  ⟨!![1, 0; 2, 1], sanovMatrixB_det⟩

local notation "A" => sanovMatrixA
local notation "B" => sanovMatrixB
local notation "S" => ({A, B} : Set (SL(2, ℤ)))

/-- Proposition 3-12-4: the matrices `A = !![1, 2; 0, 1]` and `B = !![1, 0; 2, 1]` form a free
basis of the subgroup of `SL(2, ℤ)` that they generate. -/
-- Proof sketch: view these matrices as acting by linear fractional transformations and apply the
-- ping-pong argument with the unit disc and its exterior, equivalently the free-product
-- decomposition generated by `A` and the involution exchanging `0` and `∞`. This shows that every
-- nonempty reduced alternating word in `A` and `B` is nontrivial, so the subgroup they generate
-- is free on the displayed generating subset.
theorem sanov_matrices_form_free_basis :
    IsFreeGroupBasis {g : Subgroup.closure S | (g : SL(2, ℤ)) ∈ S} := sorry

end

/-! ### Proposition_3_12_5 (from Items/Chap03) -/
universe u v

open scoped Pointwise
open Monoid

set_option autoImplicit false

section

variable {G : Type u} {Ω : Type v} [Group G] [MulAction G Ω]

/-!
Primary domain: group actions and free products with amalgamation.

Layer triage:
- `source-facing`: two subgroup factors `G₁`, `G₂ ≤ G`, their common subgroup `G₁ ⊓ G₂`, two
  disjoint nonempty subsets `Ω₁`, `Ω₂ ⊆ Ω`, and the ping-pong hypotheses on their setwise images.
- `core/canonical`: `Subgroup` for the subgroup data, pointwise `SMul` on sets for the action
  hypotheses, `Subgroup.inclusion` for the two canonical maps from `G₁ ⊓ G₂`, `Subgroup.relIndex`
  for the relative-index clause, and `Monoid.PushoutI` together with `Monoid.PushoutI.lift` for
  the amalgamated free product and its canonical comparison map into `G`.
- `bridge/view`: the internal Bool-indexed pushout diagram built from those two canonical
  inclusions and the resulting comparison homomorphism from the canonical pushout into `G`;
  Proposition `3-12-5` itself should live on the resulting multiplicative equivalence.

Domain sampling:
1. `Subgroup` and `Subgroup.relIndex` are mathlib's owner abstractions for intersections,
   properness, and relative index.
2. `Subgroup.inclusion inf_le_left` and `Subgroup.inclusion inf_le_right` are the canonical maps
   from `G₁ ⊓ G₂` into `G₁` and `G₂`.
3. The pointwise action `g • Ω₁` on subsets is the canonical owner API for the source conditions
   `Ω₁ (G₁ - H) ⊆ Ω₂`, `Ω₂ (G₂ - H) ⊆ Ω₁`, and `Ωᵢ H ⊆ Ωᵢ`.
4. `Monoid.PushoutI` is the canonical owner abstraction for a free product with an amalgamated
   subgroup, and the source-facing two-factor specialization should therefore be a thin
   abbreviation `Subgroup.amalgamatedProduct G₁ G₂` with named left/right embeddings, not public
   `Bool` indexing.
5. `Monoid.PushoutI.lift`, `Monoid.PushoutI.lift_of`, and `Monoid.PushoutI.lift_base` are the
   canonical owner API for the comparison map from that amalgamated product into `G`.

Primitive vs. derived:
the primitive data are the two subgroups, their common intersection subgroup, the action on `Ω`,
and the setwise ping-pong hypotheses. The two canonical inclusions of `G₁ ⊓ G₂` into `G₁` and
`G₂`, the internal Bool-indexed pushout diagram, and the comparison map into `G` are derived
canonically from that subgroup data and should stay bridge code behind the public
`Subgroup.amalgamatedProduct` owner surface.
-/

namespace Subgroup

section

variable {G : Type u} [Group G]
variable (G₁ G₂ : Subgroup G)

local notation "H" => (G₁ ⊓ G₂ : Subgroup G)
local notation "φ" =>
  (fun b : Bool ↦
    @Bool.rec
      (fun b ↦ H →* Bool.rec G₁ G₂ b)
      (Subgroup.inclusion inf_le_left)
      (Subgroup.inclusion inf_le_right)
      b)

private local instance amalgamatedProductDiagramCodomainGroup (b : Bool) :
    Group (Bool.rec G₁ G₂ b) := by
  cases b <;> infer_instance

/-- The amalgamated free product of `G₁` and `G₂` over their intersection `G₁ ⊓ G₂`. -/
abbrev amalgamatedProduct : Type u :=
  Monoid.PushoutI φ

namespace amalgamatedProduct

/-- The canonical left embedding of `G₁` into `Subgroup.amalgamatedProduct G₁ G₂`. -/
abbrev left : G₁ →* Subgroup.amalgamatedProduct G₁ G₂ :=
  @Monoid.PushoutI.of Bool (fun b ↦ Bool.rec G₁ G₂ b) H _ _ φ false

/-- The canonical right embedding of `G₂` into `Subgroup.amalgamatedProduct G₁ G₂`. -/
abbrev right : G₂ →* Subgroup.amalgamatedProduct G₁ G₂ :=
  @Monoid.PushoutI.of Bool (fun b ↦ Bool.rec G₁ G₂ b) H _ _ φ true

end amalgamatedProduct

/-- The canonical comparison homomorphism from the amalgamated product of `G₁` and `G₂` over
their intersection into the ambient group `G`. -/
def amalgamatedProductComparison : Subgroup.amalgamatedProduct G₁ G₂ →* G :=
  Monoid.PushoutI.lift
    (fun b ↦ Bool.rec G₁.subtype G₂.subtype b)
    (Subgroup.subtype H)
    (fun b ↦ by cases b <;> rfl)

end

end Subgroup

variable (G₁ G₂ : Subgroup G)

local notation "H" => (G₁ ⊓ G₂ : Subgroup G)
local notation "φ" =>
  (fun b : Bool ↦
    @Bool.rec
      (fun b ↦ H →* Bool.rec G₁ G₂ b)
      (Subgroup.inclusion inf_le_left)
      (Subgroup.inclusion inf_le_right)
      b)

private local instance subgroupPairCodomainGroup (b : Bool) : Group (Bool.rec G₁ G₂ b) := by
  cases b <;> infer_instance

/-- The canonical comparison map from the pushout of the two canonical inclusions
`G₁ ⊓ G₂ ↪ G₁`, `G₁ ⊓ G₂ ↪ G₂` to the ambient group `G`. -/
@[simp] private theorem comparisonMap_left (g : G₁) :
    Subgroup.amalgamatedProductComparison G₁ G₂
      (Subgroup.amalgamatedProduct.left G₁ G₂ g) = g := by
  simp [Subgroup.amalgamatedProductComparison, Subgroup.amalgamatedProduct.left]

@[simp] private theorem comparisonMap_right (g : G₂) :
    Subgroup.amalgamatedProductComparison G₁ G₂
      (Subgroup.amalgamatedProduct.right G₁ G₂ g) = g := by
  simp [Subgroup.amalgamatedProductComparison, Subgroup.amalgamatedProduct.right]

variable
    (hgen : G₁ ⊔ G₂ = ⊤)
    (hproper₁ : (G₁ ⊓ G₂ : Subgroup G) < G₁)
    (hproper₂ : (G₁ ⊓ G₂ : Subgroup G) < G₂)
    (hnot_indexTwo :
      ¬ (((G₁ ⊓ G₂ : Subgroup G)).relIndex G₁ = 2 ∧
          ((G₁ ⊓ G₂ : Subgroup G)).relIndex G₂ = 2))
    (Ω₁ Ω₂ : Set Ω)
    (hΩ₁ : Ω₁.Nonempty)
    (hΩ₂ : Ω₂.Nonempty)
    (hdisj : Disjoint Ω₁ Ω₂)
    (h₁₂ : ∀ g : G₁, (g : G) ∉ (G₁ ⊓ G₂ : Subgroup G) → (g : G) • Ω₁ ⊆ Ω₂)
    (h₂₁ : ∀ g : G₂, (g : G) ∉ (G₁ ⊓ G₂ : Subgroup G) → (g : G) • Ω₂ ⊆ Ω₁)
    (hH₁ : ∀ h : (G₁ ⊓ G₂ : Subgroup G), (h : G) • Ω₁ ⊆ Ω₁)
    (hH₂ : ∀ h : (G₁ ⊓ G₂ : Subgroup G), (h : G) • Ω₂ ⊆ Ω₂)

-- Proof sketch: use the relative-index hypothesis to make one of the ping-pong transitions
-- strict, so that every nontrivial alternating reduced word moves one of the two distinguished
-- subsets away from itself. This gives injectivity of the canonical map
-- `comparisonMap G₁ G₂`; surjectivity follows from the generation hypothesis
-- `G₁ ⊔ G₂ = ⊤`.
include hgen hproper₁ hproper₂ hnot_indexTwo Ω₁ Ω₂ hΩ₁ hΩ₂ hdisj h₁₂ h₂₁ hH₁ hH₂ in
private theorem comparisonMap_bijective_of_twoSubsetPingPong :
    Function.Bijective (Subgroup.amalgamatedProductComparison G₁ G₂) := sorry

include hgen hproper₁ hproper₂ hnot_indexTwo Ω₁ Ω₂ hΩ₁ hΩ₂ hdisj h₁₂ h₂₁ hH₁ hH₂
/-- Proposition 3-12-5: if `G` is generated by subgroups `G₁` and `G₂`, their intersection is a
proper subgroup of each and is not of index `2` in both, and the action of `G` on `Ω` satisfies
the two-set ping-pong hypotheses on disjoint nonempty subsets `Ω₁` and `Ω₂`, then `G` is the
amalgamated free product of `G₁` and `G₂` over `G₁ ∩ G₂`. -/
noncomputable def amalgamatedFreeProductEquivOfTwoSubsetPingPong
    : Subgroup.amalgamatedProduct G₁ G₂ ≃* G :=
  MulEquiv.ofBijective
    (Subgroup.amalgamatedProductComparison G₁ G₂)
    (comparisonMap_bijective_of_twoSubsetPingPong
      G₁ G₂ hgen hproper₁ hproper₂ hnot_indexTwo Ω₁ Ω₂ hΩ₁ hΩ₂ hdisj h₁₂ h₂₁ hH₁ hH₂)

@[simp] theorem amalgamatedFreeProductEquivOfTwoSubsetPingPong_of_left
    (g : G₁) :
    amalgamatedFreeProductEquivOfTwoSubsetPingPong
        G₁ G₂ hgen hproper₁ hproper₂ hnot_indexTwo
        Ω₁ Ω₂ hΩ₁ hΩ₂ hdisj h₁₂ h₂₁ hH₁ hH₂
        (Subgroup.amalgamatedProduct.left G₁ G₂ g) = g := by
  simp [amalgamatedFreeProductEquivOfTwoSubsetPingPong, Subgroup.amalgamatedProductComparison]

@[simp] theorem amalgamatedFreeProductEquivOfTwoSubsetPingPong_of_right
    (g : G₂) :
    amalgamatedFreeProductEquivOfTwoSubsetPingPong
        G₁ G₂ hgen hproper₁ hproper₂ hnot_indexTwo
        Ω₁ Ω₂ hΩ₁ hΩ₂ hdisj h₁₂ h₂₁ hH₁ hH₂
        (Subgroup.amalgamatedProduct.right G₁ G₂ g) = g := by
  simp [amalgamatedFreeProductEquivOfTwoSubsetPingPong, Subgroup.amalgamatedProductComparison]

end

/-! ### Proposition_3_12_6 (from Items/Chap03) -/
universe u v

open scoped Pointwise
open HNNExtension

set_option autoImplicit false

section

variable {G : Type u} {Ω : Type v} [Group G] [MulAction G Ω]
variable (G₀ : Subgroup G) (Hplus Hminus : Subgroup G₀) (φ : Hplus ≃* Hminus)
variable (f : G)
variable (Ωneg Ωzero Ωpos : Set Ω)

/-!
Primary domain: group actions and HNN extensions.

Layer triage:
- `source-facing`: a group `G` acting on `Ω`, a base subgroup `G₀ ≤ G`, two associated subgroups
  `Hplus`, `Hminus ≤ G₀`, a stable letter `f : G`, and a ping-pong partition
  `Ω = Ωneg ⊔ Ωzero ⊔ Ωpos`.
- `core/canonical`: mathlib's owner `HNNExtension G₀ Hplus Hminus φ` together with
  `HNNExtension.lift`, `HNNExtension.of`, and `HNNExtension.t`.
- `bridge/view`: the canonical homomorphism sending the base subgroup by inclusion into `G` and
  the stable letter to `f`. A concrete permutation-group realization is only the specialization of
  this action-theoretic statement to `G := Subgroup (Equiv.Perm Ω)`.

Domain sampling:
1. `[MulAction G Ω]` is the intrinsic owner of the ping-pong action data, as already used by
   nearby Chapter 3 ping-pong files.
2. `Subgroup G` is the canonical owner for the base group `G₀` and its associated subgroups.
3. The pointwise action `g • S` on subsets is the canonical owner API for the ping-pong movement
   hypotheses; it should replace `Equiv.Perm`-level `Set.MapsTo` bookkeeping.
4. `HNNExtension G₀ Hplus Hminus φ` with `HNNExtension.lift`, `HNNExtension.of`, and
   `HNNExtension.t` is mathlib's owner abstraction for the source HNN construction.

Primitive vs. derived:
- primitive public data: the action of `G` on `Ω`, the subgroup data `G₀`, `Hplus`, `Hminus`, the
  stable letter `f`, the conjugation hypothesis implementing `φ`, and the ping-pong subsets with
  their disjointness, nonemptiness, and set-action hypotheses;
- derived API: the canonical homomorphism from the HNN extension to `G`, its bijectivity under the
  ping-pong assumptions, and the resulting multiplicative equivalence.
-/

-- Conjugation by `f` yields the multiplicative relation required by `HNNExtension.lift`.
-- Proof sketch: start from the hypothesis
-- `φ a = f * a * f⁻¹` inside `G`, then multiply on the right by `f` and simplify.
private theorem relation_of_conjugation
    (hconj : ∀ a : Hplus, (φ a : G) = f * (a : G) * f⁻¹) :
    ∀ a : Hplus, f * (a : G) = (φ a : G) * f := by
  intro a
  calc
    f * (a : G) = (f * (a : G) * f⁻¹) * f := by
      simp [mul_assoc]
    _ = (φ a : G) * f := by
      rw [hconj a]

variable (hconj : ∀ a : Hplus, (φ a : G) = f * (a : G) * f⁻¹)

-- The canonical comparison map from the HNN extension onto `G`.
private def comparisonMap : HNNExtension G₀ Hplus Hminus φ →* G :=
  lift G₀.subtype f (relation_of_conjugation G₀ Hplus Hminus φ f hconj)

-- The ping-pong hypotheses force the canonical HNN-extension map onto `G` to be bijective.
-- Proof sketch: surjectivity follows from the generation hypothesis `closure (G₀ ∪ {f}) = ⊤`,
-- since the image already contains the base subgroup and the stable letter. Injectivity is the
-- ping-pong argument from the textbook, using the partition `Ωneg ⊔ Ωzero ⊔ Ωpos` and the
-- movement assumptions on `f`, `f⁻¹`, and on elements of `G₀ \ Hplus` and `G₀ \ Hminus`.
private theorem comparisonMap_bijective
    (hgen : Subgroup.closure ((G₀ : Set G) ∪ {f}) = ⊤)
    (hcover : Set.univ = Ωneg ∪ Ωzero ∪ Ωpos)
    (hdisj_neg_zero : Disjoint Ωneg Ωzero)
    (hdisj_neg_pos : Disjoint Ωneg Ωpos)
    (hdisj_zero_pos : Disjoint Ωzero Ωpos)
    (hΩneg_nonempty : Ωneg.Nonempty)
    (hΩzero_nonempty : Ωzero.Nonempty)
    (hΩpos_nonempty : Ωpos.Nonempty)
    (hf_pos : f • (Ωzero ∪ Ωpos) ⊆ Ωpos)
    (hf_neg : f⁻¹ • (Ωzero ∪ Ωneg) ⊆ Ωneg)
    (hmove_pos : ∀ g : G₀, g ∉ Hplus → (g : G) • Ωpos ⊆ Ωzero)
    (hmove_neg : ∀ g : G₀, g ∉ Hminus → (g : G) • Ωneg ⊆ Ωzero) :
    Function.Bijective (comparisonMap G₀ Hplus Hminus φ f hconj) := sorry

/-- Proposition 3-12-6: under the ping-pong hypotheses on the partition
`Ω = Ωneg ⊔ Ωzero ⊔ Ωpos`, the group `G` is canonically the HNN extension of `G₀` with
associated subgroups `Hplus`, `Hminus`, and stable letter `f` implementing `φ` by conjugation. -/
noncomputable def group_hnn_extension_equiv
    (hgen : Subgroup.closure ((G₀ : Set G) ∪ {f}) = ⊤)
    (hcover : Set.univ = Ωneg ∪ Ωzero ∪ Ωpos)
    (hdisj_neg_zero : Disjoint Ωneg Ωzero)
    (hdisj_neg_pos : Disjoint Ωneg Ωpos)
    (hdisj_zero_pos : Disjoint Ωzero Ωpos)
    (hΩneg_nonempty : Ωneg.Nonempty)
    (hΩzero_nonempty : Ωzero.Nonempty)
    (hΩpos_nonempty : Ωpos.Nonempty)
    (hf_pos : f • (Ωzero ∪ Ωpos) ⊆ Ωpos)
    (hf_neg : f⁻¹ • (Ωzero ∪ Ωneg) ⊆ Ωneg)
    (hmove_pos : ∀ g : G₀, g ∉ Hplus → (g : G) • Ωpos ⊆ Ωzero)
    (hmove_neg : ∀ g : G₀, g ∉ Hminus → (g : G) • Ωneg ⊆ Ωzero) :
    HNNExtension G₀ Hplus Hminus φ ≃* G :=
  MulEquiv.ofBijective
    (comparisonMap G₀ Hplus Hminus φ f hconj)
    (comparisonMap_bijective
      G₀ Hplus Hminus φ f Ωneg Ωzero Ωpos hconj
      hgen hcover hdisj_neg_zero hdisj_neg_pos hdisj_zero_pos
      hΩneg_nonempty hΩzero_nonempty hΩpos_nonempty hf_pos hf_neg hmove_pos hmove_neg)

/-- The canonical HNN-extension equivalence restricts to the inclusion of the base subgroup. -/
-- Proof sketch: unfold `group_hnn_extension_equiv`; its forward map is the canonical comparison
-- map built from `HNNExtension.lift`, so the claim is `HNNExtension.lift_of`.
@[simp] theorem group_hnn_extension_equiv_of
    (hgen : Subgroup.closure ((G₀ : Set G) ∪ {f}) = ⊤)
    (hcover : Set.univ = Ωneg ∪ Ωzero ∪ Ωpos)
    (hdisj_neg_zero : Disjoint Ωneg Ωzero)
    (hdisj_neg_pos : Disjoint Ωneg Ωpos)
    (hdisj_zero_pos : Disjoint Ωzero Ωpos)
    (hΩneg_nonempty : Ωneg.Nonempty)
    (hΩzero_nonempty : Ωzero.Nonempty)
    (hΩpos_nonempty : Ωpos.Nonempty)
    (hf_pos : f • (Ωzero ∪ Ωpos) ⊆ Ωpos)
    (hf_neg : f⁻¹ • (Ωzero ∪ Ωneg) ⊆ Ωneg)
    (hmove_pos : ∀ g : G₀, g ∉ Hplus → (g : G) • Ωpos ⊆ Ωzero)
    (hmove_neg : ∀ g : G₀, g ∉ Hminus → (g : G) • Ωneg ⊆ Ωzero)
    (g : G₀) :
    group_hnn_extension_equiv
        G₀ Hplus Hminus φ f Ωneg Ωzero Ωpos hconj
        hgen hcover hdisj_neg_zero hdisj_neg_pos hdisj_zero_pos
        hΩneg_nonempty hΩzero_nonempty hΩpos_nonempty hf_pos hf_neg hmove_pos hmove_neg
        (of g) =
      G₀.subtype g := by
  simp [group_hnn_extension_equiv, comparisonMap]

/-- The canonical HNN-extension equivalence sends the stable letter to `f`. -/
-- Proof sketch: unfold `group_hnn_extension_equiv`; its forward map is the canonical comparison
-- map built from `HNNExtension.lift`, so the claim is `HNNExtension.lift_t`.
@[simp] theorem group_hnn_extension_equiv_t
    (hgen : Subgroup.closure ((G₀ : Set G) ∪ {f}) = ⊤)
    (hcover : Set.univ = Ωneg ∪ Ωzero ∪ Ωpos)
    (hdisj_neg_zero : Disjoint Ωneg Ωzero)
    (hdisj_neg_pos : Disjoint Ωneg Ωpos)
    (hdisj_zero_pos : Disjoint Ωzero Ωpos)
    (hΩneg_nonempty : Ωneg.Nonempty)
    (hΩzero_nonempty : Ωzero.Nonempty)
    (hΩpos_nonempty : Ωpos.Nonempty)
    (hf_pos : f • (Ωzero ∪ Ωpos) ⊆ Ωpos)
    (hf_neg : f⁻¹ • (Ωzero ∪ Ωneg) ⊆ Ωneg)
    (hmove_pos : ∀ g : G₀, g ∉ Hplus → (g : G) • Ωpos ⊆ Ωzero)
    (hmove_neg : ∀ g : G₀, g ∉ Hminus → (g : G) • Ωneg ⊆ Ωzero) :
    group_hnn_extension_equiv
        G₀ Hplus Hminus φ f Ωneg Ωzero Ωpos hconj
        hgen hcover hdisj_neg_zero hdisj_neg_pos hdisj_zero_pos
        hΩneg_nonempty hΩzero_nonempty hΩpos_nonempty hf_pos hf_neg hmove_pos hmove_neg
        t =
      f := by
  simp [group_hnn_extension_equiv, comparisonMap]

end
