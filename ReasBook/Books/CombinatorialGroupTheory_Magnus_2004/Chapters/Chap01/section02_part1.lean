theorem exists_common_zpowers_generator_of_commute (a b : F) (h : Commute a b) :
    ∃ c : F, a ∈ Subgroup.zpowers c ∧ b ∈ Subgroup.zpowers c :=
  exists_common_zpowers_generator_of_commute_zpow a b 1 1 one_ne_zero one_ne_zero
    (h.zpow_zpow 1 1)

