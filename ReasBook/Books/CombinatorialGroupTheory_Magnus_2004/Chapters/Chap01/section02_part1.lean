/-! ### Proposition_1_2_9 (from Items/Chap01) -/
universe u

open scoped Cardinal

section

variable {F : Type u} [Group F]

-- Primary domain: finite-rank free groups and finite generating sets.
-- `source-facing`: a finite generating subset of a free group with chosen finite basis.
-- `core/canonical`: `FreeGroupBasis ι F`, `Group.rank`, and `IsFreeGroupBasis`.
-- `bridge/view`: a finite generating set `U : Finset F` is recorded by
-- `Subgroup.closure (↑U : Set F) = ⊤`.
--
-- Domain sampling:
-- 1. `FreeGroupBasis.cardinal_eq` is the chapter owner theorem equating the cardinalities of two
--    free bases of the same group.
-- 2. `Subgroup.rank_closure_finset_le_card` is mathlib's owner inequality bounding the rank of a
--    finitely generated subgroup by the size of a chosen finite generating set.
-- 3. `Group.rank` is the canonical owner for finite generation rank, so finite-generator
--    inequalities should pass through it rather than through ad hoc local wrapper data.
-- 4. `IsFreeGroupBasis` is the chapter's source-facing owner for “this displayed subset itself is
--    a basis”.
--
-- Primitive vs. derived:
-- the primitive public data are a chosen finite basis `basis : FreeGroupBasis ι F` and a finite
-- subset `U : Finset F`. The rank bound and the criterion that `U` itself is a basis are derived
-- API and belong at the owner level; the specialized `Fin n` formulations below are source-facing
-- wrappers around those owner declarations.

/-- Owner criterion for finite generating sets in a finite-rank free group: a finite subset is a
free basis exactly when it has the same cardinality as the chosen basis and generates the ambient
group. -/
-- Layer triage:
-- `core/canonical`: this is the owner-level finite-rank criterion organized around
-- `FreeGroupBasis ι F`, `Fintype.card ι`, and `IsFreeGroupBasis`.
-- `bridge/view`: the source-facing `Fin n` statements below are immediate specializations.
theorem finset_isFreeGroupBasis_iff_card_and_closure_eq_top {ι : Type*}
    (basis : FreeGroupBasis ι F) [Fintype ι] (U : Finset F) :
    IsFreeGroupBasis (U : Set F) ↔
      U.card = Fintype.card ι ∧ Subgroup.closure (U : Set F) = ⊤ := sorry

/-- Owner inequality for finite generating sets in a finite-rank free group. -/
-- Layer triage:
-- `core/canonical`: `FreeGroupBasis ι F` and `Fintype.card ι`.
-- `bridge/view`: `rank_le_card_of_generating_finset` is the specialized `Fin n` source wrapper.
theorem fintype_card_le_card_of_generating_finset {ι : Type*}
    (basis : FreeGroupBasis ι F) [Fintype ι] (U : Finset F)
    (hgen : Subgroup.closure (U : Set F) = ⊤) :
    Fintype.card ι ≤ U.card := sorry

variable {n : ℕ}

/-- Proposition 1-2-9 (1): if a free group `F` has a basis indexed by `Fin n`, then any finite
generating set of `F` has at least `n` elements. -/
-- Layer triage:
-- `source-facing`: the minimal-number-of-generators statement for a free group of rank `n`.
-- `core/canonical`: `fintype_card_le_card_of_generating_finset`.
-- `bridge/view`: specialize the owner theorem to the basis indexed by `Fin n`.
theorem rank_le_card_of_generating_finset (basis : FreeGroupBasis (Fin n) F) (U : Finset F)
    (hgen : Subgroup.closure (U : Set F) = ⊤) :
    n ≤ U.card := by
  simpa using fintype_card_le_card_of_generating_finset basis U hgen

/-- Proposition 1-2-9 (2): if a free group `F` has rank `n`, then any generating set of exactly
`n` elements is a free basis of `F`. -/
-- Layer triage:
-- `source-facing`: the given generating set `U` itself is a basis of `F`.
-- `core/canonical`: `finset_isFreeGroupBasis_iff_card_and_closure_eq_top`.
-- `bridge/view`: specialize the owner theorem to the textbook rank-`n` formulation.
theorem isFreeGroupBasis_of_generating_finset_card_eq_rank
    (basis : FreeGroupBasis (Fin n) F) (U : Finset F)
    (hgen : Subgroup.closure (U : Set F) = ⊤) (hcard : U.card = n) :
    IsFreeGroupBasis (U : Set F) := by
  exact
    (finset_isFreeGroupBasis_iff_card_and_closure_eq_top basis U).2
      ⟨by simpa using hcard, hgen⟩

end

/-! ### Proposition_1_2_10 (from Items/Chap01) -/
universe u

open FreeGroup
open scoped Pointwise Symmetrization

section

variable {X : Type u} [DecidableEq X]

local notation "basis" => FreeGroupBasis.ofFreeGroup X
local notation "basisSet" => Set.range basis

/-- Proposition 1-2-10: for an `N`-reduced subset `U` of the free group on `X`, the basis
generators and inverse basis generators lying in `Gp(U) = Subgroup.closure U` are exactly the
elements of `U^{±1}` that are basis generators or inverse basis generators. -/
-- Layer triage:
-- `source-facing`: the equality `basisSet^{±1} ∩ Gp(U) = basisSet^{±1} ∩ U^{±1}`
-- for the canonical basis of `FreeGroup X`.
-- `core/canonical`: `FreeGroupBasis.ofFreeGroup X`, pointwise set inverse,
-- `FreeGroup.IsNReduced`, and `Subgroup.closure`.
-- `bridge/view`: Proposition `1-1-9` identifies the textbook generator-image subset with the
-- range of the owner basis `basis`.
-- Proof sketch: if a generator or inverse generator lies in `Subgroup.closure U`, write it as a
-- reduced product of letters from `U^{±1}`. The Nielsen length estimate forces that product to
-- have length `1`, so the element already lies in `U^{±1}`. The reverse inclusion is immediate
-- because every element of `U^{±1}` lies in the subgroup generated by `U`.
theorem free_group_generator_symmetrization_inter_closure_eq
    (U : Set (FreeGroup X)) (hU : FreeGroup.IsNReduced U) :
    (basisSet^{±1} ∩ (Subgroup.closure U : Set (FreeGroup X))) =
      (basisSet^{±1} ∩ U^{±1}) := sorry

/-- If an `N`-reduced subset `U` is also a basis of the ambient free group, then its
symmetrization agrees with the symmetrized canonical generator set. -/
-- Proof sketch: combine `free_group_generator_symmetrization_inter_closure_eq` with the owner
-- basis facts `(FreeGroupBasis.ofFreeGroup X).isFreeGroupBasis_range` and
-- `closure_preimage_isFreeGroupBasis_of_isNReduced U hU`. Since `hBasis` generates the ambient
-- group, the first theorem simplifies to
-- `basisSet^{±1} = basisSet^{±1} ∩ U^{±1}`, hence
-- `basisSet^{±1} ⊆ U^{±1}`. The reverse inclusion follows by comparing the two free
-- bases of `FreeGroup X`.
theorem free_group_generator_symmetrization_eq_of_isFreeGroupBasis
    (U : Set (FreeGroup X)) (hU : FreeGroup.IsNReduced U) (hBasis : IsFreeGroupBasis U) :
    basisSet^{±1} = U^{±1} := sorry

end

/-! ### Proposition_1_2_11 (from Items/Chap01) -/
universe u

open FreeGroup

section

variable {X : Type u}
variable (G : Subgroup (FreeGroup X)) (r : G → G → Prop)

/-- The subgroup of `G` generated by those elements of `G` that precede `g`. -/
def predecessorGeneratedSubgroup (g : G) : Subgroup G :=
  Subgroup.closure {h : G | r h g}

/-- The textbook subset `A = { g ∈ G | g ∉ G_g }` as a subset of the subgroup `G`. -/
def predecessorIndependentSet : Set G :=
  {g : G | g ∉ predecessorGeneratedSubgroup G r g}

/-- The same independent set, viewed as a subset of the ambient free group. -/
abbrev predecessorIndependentSubset : Set (FreeGroup X) :=
  Subtype.val '' predecessorIndependentSet G r

/-- Membership in `predecessorIndependentSet G r` means not lying in the subgroup generated by
earlier elements of `G`. -/
-- Proof sketch: unfold `predecessorIndependentSet` and read off the defining predicate.
@[simp] theorem mem_predecessorIndependentSet_iff (g : G) :
    g ∈ predecessorIndependentSet G r ↔ g ∉ predecessorGeneratedSubgroup G r g :=
  Iff.rfl

@[simp] theorem coe_mem_predecessorIndependentSubset (g : G) :
    (g : FreeGroup X) ∈ predecessorIndependentSubset G r ↔ g ∈ predecessorIndependentSet G r := by
  constructor
  · rintro ⟨h, hh, h_eq⟩
    exact Subtype.ext h_eq ▸ hh
  · intro hg
    exact ⟨g, hg, rfl⟩

/-- Proposition 1-2-11: if a subgroup `G` of a free group is strictly totally ordered by a
relation refining reduced-word length, then the elements not generated by their predecessors form
an `N`-reduced subset of the ambient free group. -/
-- Layer triage:
-- `source-facing`: the subgroup family `G_g = Gp ({h ∈ G | h ≺ g})` and the subset
-- `A = {g ∈ G | g ∉ G_g}`.
-- `core/canonical`: `FreeGroup.IsNReduced` on the ambient carrier.
-- `bridge/view`: `predecessorIndependentSubset G r` is the canonical codomain-change bridge from
-- the subgroup-side source set to the ambient owner predicate.
--
-- Domain sampling:
-- 1. `FreeGroup.IsNReduced` in Definition `1-2-3` is the owner predicate for Nielsen reduction.
-- 2. `IsStrictTotalOrder` in mathlib's order hierarchy is the ambient order owner for the
--    trichotomy and transitivity used in Nielsen's length comparison; the well-founded part of a
--    well order is not used in this proposition.
-- 3. `closure_preimage_isFreeGroupBasis_of_isNReduced` in Proposition `1-2-7` consumes that owner
--    predicate directly, so this proposition should expose the ambient subset in exactly that
--    shape.
-- 4. `predecessorIndependentSet G r` is source-facing data, while
--    `predecessorIndependentSubset G r` is only the bridge/view into the ambient free group.
-- Proof sketch: apply the Nielsen argument from the text to the image of
-- `predecessorIndependentSet G r` in `FreeGroup X`: if one of the products appearing in
-- `(N0)`–`(N2)` were shorter than expected, the larger basis element would lie in the subgroup
-- generated by earlier ones, contradicting its defining exclusion from `G_g`.
theorem predecessorIndependentSet_isNReduced
    [DecidableEq X] [IsStrictTotalOrder G r]
    (h_length : ∀ ⦃g h : G⦄, norm (g : FreeGroup X) < norm (h : FreeGroup X) → r g h) :
    FreeGroup.IsNReduced (predecessorIndependentSubset G r) := sorry

end

/-! ### Proposition_1_2_12 (from Items/Chap01) -/
universe u

section

variable {X : Type u} [DecidableEq X]

/-- Proposition 1-2-12: if a subgroup `G` of a free group is well ordered by a relation `r`
refining the free-group word length, then the elements of `G` not generated by their predecessors
form a free basis of `G`. -/
-- Layer triage:
-- `source-facing`: `predecessorGeneratedSubgroup G r` and `predecessorIndependentSet G r` from
-- Proposition 1-2-11.
-- `core/canonical`: `IsFreeGroupBasis` on the subgroup type `G`.
-- `bridge/view`: apply the owner theorem
-- `closure_preimage_isFreeGroupBasis_of_isNReduced` to the ambient subset
-- `predecessorIndependentSubset G r`, then identify the resulting closure-preimage
-- basis with `predecessorIndependentSet G r`.
theorem predecessorIndependentSet_isFreeGroupBasis
    (G : Subgroup (FreeGroup X)) (r : G → G → Prop) [IsWellOrder G r]
    (h_length : ∀ ⦃g h : G⦄,
      FreeGroup.norm (g : FreeGroup X) < FreeGroup.norm (h : FreeGroup X) → r g h) :
    IsFreeGroupBasis (predecessorIndependentSet G r) := by
  classical
  set U : Set (FreeGroup X) := predecessorIndependentSubset G r with hUdef
  have hU : FreeGroup.IsNReduced U := by
    simpa [hUdef] using predecessorIndependentSet_isNReduced G r h_length
  have hBasis :
      IsFreeGroupBasis {x : Subgroup.closure U | (x : FreeGroup X) ∈ U} :=
    closure_preimage_isFreeGroupBasis_of_isNReduced U hU
  have hU_subset : U ⊆ (G : Set (FreeGroup X)) := by
    intro g hg
    rcases (show g ∈ predecessorIndependentSubset G r from by
      simpa [hUdef] using hg) with ⟨h, hh, rfl⟩
    exact h.2
  have hG_le : G ≤ Subgroup.closure U := by
    intro g hg
    let g' : G := ⟨g, hg⟩
    let P : G → Prop := fun h ↦ (h : FreeGroup X) ∈ Subgroup.closure U
    change P g'
    have hwf : WellFounded r := IsWellFounded.wf
    refine hwf.induction g' ?_
    intro g ih
    by_cases hgA : g ∈ predecessorIndependentSet G r
    · exact Subgroup.subset_closure <| by
        simpa [hUdef] using
          (show (g : FreeGroup X) ∈ predecessorIndependentSubset G r from by simpa using hgA)
    · have hgPred : g ∈ predecessorGeneratedSubgroup G r g := by
        by_contra hgPred
        exact hgA ((mem_predecessorIndependentSet_iff G r g).2 hgPred)
      have hpred_le :
          predecessorGeneratedSubgroup G r g ≤
            Subgroup.comap (G.subtype : G →* FreeGroup X) (Subgroup.closure U) := by
        change Subgroup.closure {h : G | r h g} ≤
            Subgroup.comap (G.subtype : G →* FreeGroup X) (Subgroup.closure U)
        rw [Subgroup.closure_le]
        intro h hh
        exact ih h hh
      exact hpred_le hgPred
  have hclosure_eq : Subgroup.closure U = G := by
    refine le_antisymm ?_ hG_le
    rw [Subgroup.closure_le]
    exact hU_subset
  have hBasis' : @IsFreeGroupBasis G inferInstance {x : G | (x : FreeGroup X) ∈ U} := by
    exact Eq.mp (by rw [hclosure_eq]) hBasis
  have hpreimage_eq : {x : G | (x : FreeGroup X) ∈ U} = predecessorIndependentSet G r := by
    ext g
    rw [hUdef]
    exact coe_mem_predecessorIndependentSubset (G := G) (r := r) g
  change @IsFreeGroupBasis G inferInstance (predecessorIndependentSet G r)
  exact hpreimage_eq ▸ hBasis'

end

