noncomputable section Exercise911

variable {n : ℕ}

namespace RationalBasis

/-- The real lattice generated by the rational basis matrix of `B`, expressed through the
canonical Chapter 9 owner `matrix_generated_lattice`. -/
def generatedLattice (B : RationalBasis n) : Submodule ℤ (Fin n → ℝ) :=
  matrix_generated_lattice (B.basisMatrix.map (Rat.castHom ℝ))

/-- The real lattice vector corresponding to the integer coefficient vector `z`. -/
def vector (B : RationalBasis n) (z : Fin n → ℤ) : Fin n → ℝ :=
  (B.basisMatrix.map (Rat.castHom ℝ)) *ᵥ fun i ↦ (z i : ℝ)

/-- Membership in `B.generatedLattice` is exactly being an integer linear combination of the
columns of the basis matrix. -/
theorem mem_generatedLattice_iff
    (B : RationalBasis n)
    (x : Fin n → ℝ) :
    x ∈ B.generatedLattice ↔ ∃ z : Fin n → ℤ, x = B.vector z := by
  simpa [generatedLattice, vector] using
    (mem_matrix_generated_lattice_iff :
      x ∈ matrix_generated_lattice (B.basisMatrix.map (Rat.castHom ℝ)) ↔
        ∃ z : Fin n → ℤ, x = (B.basisMatrix.map (Rat.castHom ℝ)) *ᵥ fun i ↦ (z i : ℝ))

/-- Every integer coefficient vector produces a point of `B.generatedLattice`. -/
theorem vector_mem_generatedLattice
    (B : RationalBasis n)
    (z : Fin n → ℤ) :
    B.vector z ∈ B.generatedLattice :=
  (B.mem_generatedLattice_iff _).2 ⟨z, rfl⟩

end RationalBasis

/-- A shortest-vector certificate for `B` consists of an explicit integer coefficient vector whose
real realization is nonzero and has minimal Euclidean norm among all nonzero lattice vectors of
`B.generatedLattice`. -/
structure ShortestVectorCertificate (B : RationalBasis n) where
  coeffs : Fin n → ℤ
  vector_ne_zero : B.vector coeffs ≠ 0
  minimal_norm :
    ∀ z : Fin n → ℤ, B.vector z ≠ 0 →
      ‖B.vector coeffs‖ ≤ ‖B.vector z‖

namespace ShortestVectorCertificate

/-- The vector encoded by a shortest-vector certificate lies in the lattice generated by the input
rational basis. -/
theorem vector_mem_generatedLattice
    {B : RationalBasis n}
    (certificate : ShortestVectorCertificate B) :
    B.vector certificate.coeffs ∈ B.generatedLattice :=
  B.vector_mem_generatedLattice certificate.coeffs

end ShortestVectorCertificate

/-- A polynomial-time algorithm for the shortest-vector problem in dimension `n` is a canonical
polynomial-time query solver whose queries are rational bases and whose answers are shortest-vector
certificates. -/
abbrev ShortestVectorAlgorithm (n : ℕ) :=
  PolynomialTimeQuerySolver
    (RationalBasis n)
    ShortestVectorCertificate
    RationalBasis.encodingSize

/-- Exercise 9.11. For fixed `n`, the shortest nonzero vector in the lattice generated by a
rational basis of `ℚ^n` can be found in polynomial time. -/
theorem rational_lattice_shortest_vector_has_polynomial_time_algorithm
    (n : ℕ) :
    Nonempty (ShortestVectorAlgorithm n) := sorry

end Exercise911
