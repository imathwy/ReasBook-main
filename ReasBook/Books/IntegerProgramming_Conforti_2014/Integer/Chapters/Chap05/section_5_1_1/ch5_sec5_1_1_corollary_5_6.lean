import Integer.Chapters.Chap05.section_5_1_1.ch5_sec5_1_1_lemma_5_4

open scoped Matrix

-- Semantic recall note: this file reuses the canonical mixed split-closure owner on the
-- canonical Chapter 4.8 mixed polyhedron from Lemma 5.4.

section Corollary56

variable {m nI nC : ℕ}

/-- The points of `P` satisfying every split inequality `(5.6)` generated by a row multiplier
`u` with integral `u A_I`, vanishing `u A_C`, nonintegral `u b`, and linearly independent
support rows. -/
def independent_support_split_cut_system
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ) : Set (MixedRealPoint nI nC) :=
  {xy | xy ∈ real_mixed_polyhedron A_I A_C b ∧
    ∀ u : Fin m → ℝ,
      IsMixedGomoryFractionalCutMultiplier A_I A_C b u →
        RowMultiplierHasIndependentSupportRows (mixedConstraintMatrix A_I A_C) u →
          1 ≤ mixed_gomory_fractional_cut_value A_I A_C b u xy}

/-- Membership in `independent_support_split_cut_system A_I A_C b` means belonging to the mixed
polyhedron `P` and satisfying every split inequality `(5.6)` coming from a multiplier with
integral `u A_I`, vanishing `u A_C`, nonintegral `u b`, and linearly independent support rows. -/
theorem mem_independent_support_split_cut_system_iff
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ)
    (xy : MixedRealPoint nI nC) :
    xy ∈ independent_support_split_cut_system A_I A_C b ↔
      xy ∈ real_mixed_polyhedron A_I A_C b ∧
        ∀ u : Fin m → ℝ,
          IsMixedGomoryFractionalCutMultiplier A_I A_C b u →
            RowMultiplierHasIndependentSupportRows (mixedConstraintMatrix A_I A_C) u →
              1 ≤ mixed_gomory_fractional_cut_value A_I A_C b u xy :=
  Iff.rfl

/-- Corollary 5.6. The split closure `P^split` of `P = {(x, y) | A_I x + A_C y ≤ b}` is exactly
the set of points of `P` satisfying the split inequalities `(5.6)` for all row multipliers
`u ∈ ℝ^m` such that `u A_I` is integral, `u A_C = 0`, `u b ∉ ℤ`, and the rows of `A`
corresponding to the nonzero entries of `u` are linearly independent. -/
theorem mixed_split_closure_eq_independent_support_split_cut_system
    (A_I : Matrix (Fin m) (Fin nI) ℝ)
    (A_C : Matrix (Fin m) (Fin nC) ℝ)
    (b : Fin m → ℝ) :
    mixed_split_closure (real_mixed_polyhedron A_I A_C b) =
      independent_support_split_cut_system A_I A_C b := sorry

end Corollary56
