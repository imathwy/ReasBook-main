import Integer.Chapters.Chap03.section_3_5.ch3_sec3_5_definition_3_5_extra_1

-- This file keeps the set-level edge/extreme-ray predicates as compatibility helpers, while the
-- labeled source-facing API adds the missing pointed/polyhedral hypotheses from Section 3.11.

open scoped BigOperators

universe u

-- Semantic recall note: `lean_leansearch` only surfaced generic ray/cone owners (`SameRay`,
-- pointed-cone structures), so this repair keeps the local helper API and adds explicit
-- source-facing wrappers for pointed polyhedral cones and pointed nonempty polyhedra.
variable {E : Type u} [AddCommGroup E] [Module ℝ E]

/-- Helper: an edge of `P` is a one-dimensional convex extreme subset of `P`. -/
@[mk_iff]
class IsEdgeOf (P F : Set E) : Prop where
  /-- The carrier of an edge is convex. -/
  convex : Convex ℝ F
  /-- The subset `F` is extreme in `P`. -/
  isExtreme : IsExtreme ℝ P F
  /-- The direction of the affine span of `F` is one-dimensional. -/
  finrank_direction_eq_one : Module.finrank ℝ (affineSpan ℝ F).direction = 1

/-- An edge is, in particular, an extreme subset. -/
instance instIsExtremeOfIsEdgeOf {P F : Set E} [h : IsEdgeOf P F] : IsExtreme ℝ P F :=
  h.isExtreme

/-- Helper: the set-level predicate that the half-line generated by `r` is an edge of `C`. -/
def IsExtremeRayOfCone (C : Set E) (r : E) : Prop :=
  IsEdgeOf C (PointedCone.hull ℝ ({r} : Set E) : Set E)

/-- Unfolding lemma for the helper predicate `IsExtremeRayOfCone`. -/
theorem isExtremeRayOfCone_iff {C : Set E} {r : E} :
    IsExtremeRayOfCone C r ↔
      IsEdgeOf C (PointedCone.hull ℝ ({r} : Set E) : Set E) := by
  -- This is the definitional expansion of the set-level extreme-ray predicate.
  rfl

/-- Helper for Definition 3.11-extra-1: membership in the singleton pointed-cone hull is exactly
being a nonnegative scalar multiple of the generator. -/
lemma mem_singletonRayHull_iff {r x : E} :
    x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E) ↔
      ∃ μ : ℝ, 0 ≤ μ ∧ x = μ • r := sorry

/-- Helper for Definition 3.11-extra-1: the singleton pointed-cone hull generated by `0` is
exactly `{0}`. -/
lemma singletonRayHullZero :
    (PointedCone.hull ℝ ({(0 : E)} : Set E) : Set E) = ({0} : Set E) := sorry

/-- Helper for Definition 3.11-extra-1: an extreme-ray generator of a cone cannot be zero. -/
lemma extremeRay_ne_zero {C : Set E} {r : E} (hr : IsExtremeRayOfCone C r) :
    r ≠ 0 := sorry

/-- Helper for Definition 3.11-extra-1: nonzero same-ray generators define the same singleton
pointed-cone hull. -/
lemma singletonRayHull_eq_of_sameRay_of_nonzero {r r' : E}
    (hr_ne : r ≠ 0) (hr'_ne : r' ≠ 0) (hsame : SameRay ℝ r r') :
    (PointedCone.hull ℝ ({r} : Set E) : Set E) =
      (PointedCone.hull ℝ ({r'} : Set E) : Set E) := sorry

/-- Helper for Definition 3.11-extra-1: extreme-rayhood is preserved when the generator is replaced
by another nonzero vector on the same ray. -/
lemma isExtremeRayOfCone_of_sameRay {C : Set E} {r r' : E}
    (hr : IsExtremeRayOfCone C r)
    (hsame : SameRay ℝ r r')
    (hr'_ne : r' ≠ 0) :
    IsExtremeRayOfCone C r' := sorry

/-- A witness that `rbar` is a proper conic combination of two distinct rays contained in the
carrier set `C`. Distinctness of rays is expressed by `¬ SameRay ℝ r₁ r₂`. -/
def ProperConicCombinationOfDistinctConeRays
    (C : Set E) (rbar : E) : Prop :=
  ∃ r₁ r₂ : E,
    r₁ ∈ C ∧
    r₂ ∈ C ∧
    r₁ ≠ 0 ∧
    r₂ ≠ 0 ∧
    ¬ SameRay ℝ r₁ r₂ ∧
    ∃ μ₁ μ₂ : ℝ,
      0 < μ₁ ∧
      0 < μ₂ ∧
      rbar = μ₁ • r₁ + μ₂ • r₂

-- Downstream note: Theorem 3.35 (2) reuses the cone-level characterization below. The
-- source-facing owner for this item remains the Section 3.11 edge/extreme-ray API.
/-- Helper for Definition 3.11-extra-1: any point of the singleton pointed-cone hull generated by
`r` lies on the same ray as `r`. -/
lemma sameRayOfMemSingletonRayHull {r x : E}
    (hr : r ≠ 0)
    (hx : x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E)) :
    SameRay ℝ x r := sorry

/-- Helper for Definition 3.11-extra-1: every vector on the same nonzero ray as `r` belongs to the
singleton pointed-cone hull generated by `r`. -/
lemma memSingletonRayHull_of_sameRay {r x : E}
    (hr : r ≠ 0)
    (hx : SameRay ℝ x r) :
    x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E) := sorry

/-- Helper for Definition 3.11-extra-1: removing a positive scalar from a singleton-ray-hull
membership keeps the vector inside the same hull. -/
lemma memSingletonRayHull_of_pos_smul_memSingletonRayHull {r x : E} {a : ℝ}
    (ha : 0 < a)
    (hx : a • x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E)) :
    x ∈ (PointedCone.hull ℝ ({r} : Set E) : Set E) := sorry

/-- Helper for Definition 3.11-extra-1: the singleton pointed-cone hull generated by a nonzero
vector has one-dimensional affine-span direction. -/
lemma singletonRayHullFinrankDirectionEqOneOfNeZero {r : E}
    (hr : r ≠ 0) :
    Module.finrank ℝ
        (affineSpan ℝ (PointedCone.hull ℝ ({r} : Set E) : Set E)).direction = 1 := sorry

/-- Helper for Definition 3.11-extra-1: if `x + y = 0` and `x` does not already lie on the ray
generated by `rbar`, then `rbar` would admit a forbidden proper conic decomposition. -/
lemma memSingletonRayHull_of_sameRay_add_of_zeroSum
    {rbar x y : E}
    (hxy_zero : x + y = 0)
    (hrbar_add_y_ne : rbar + y ≠ 0)
    (hsame : SameRay ℝ x (rbar + y)) :
    x ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := sorry

/-- Helper for Definition 3.11-extra-1: if `x + y = 0` and `x` does not already lie on the ray
generated by `rbar`, then `rbar` would admit a forbidden proper conic decomposition. -/
lemma zeroSumOffSingletonRayHullContradiction
    {C : Set E} {rbar x y : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar)
    (hx : x ∈ C)
    (hy : y ∈ C)
    (hxt : x ∉ (PointedCone.hull ℝ ({rbar} : Set E) : Set E))
    (hxy_zero : x + y = 0) : False := sorry

/-- Helper for Definition 3.11-extra-1: if `x + y` is a positive multiple of `rbar` and `x` does
not already lie on the ray generated by `rbar`, then `rbar` would admit a forbidden proper conic
decomposition. -/
lemma positiveRaySumOffSingletonRayHullContradiction
    {C : Set E} {rbar x y : E} {t : ℝ}
    (hrbar_ne_zero : rbar ≠ 0)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar)
    (hx : x ∈ C)
    (hy : y ∈ C)
    (hxt : x ∉ (PointedCone.hull ℝ ({rbar} : Set E) : Set E))
    (ht_pos : 0 < t)
    (hsum_eq : x + y = t • rbar) : False := sorry

/-- Helper for Definition 3.11-extra-1: under the no-proper-conic-combination hypothesis, if a
sum of two cone vectors lies on the ray generated by `rbar`, then the left summand already lies on
that ray. -/
lemma leftMemSingletonRayHull_of_add_mem_of_noProperConicCombination
    {C : Set E} {rbar x y : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hrbar_ne_zero : rbar ≠ 0)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar)
    (hx : x ∈ C)
    (hy : y ∈ C)
    (hsum : x + y ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E)) :
    x ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := sorry

/-- Helper for Definition 3.11-extra-1: under the no-proper-conic-combination hypothesis, if a
sum of two cone vectors lies on the ray generated by `rbar`, then both summands lie on that ray. -/
lemma memSingletonRayHull_of_add_mem_of_noProperConicCombination
    {C : Set E} {rbar x y : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hrbar_ne_zero : rbar ≠ 0)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar)
    (hx : x ∈ C)
    (hy : y ∈ C)
    (hsum : x + y ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E)) :
    x ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) ∧
      y ∈ (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := sorry

/-- Helper for Definition 3.11-extra-1: the singleton pointed-cone hull generated by `rbar` is an
extreme subset of `C` once `rbar` admits no proper conic combination of distinct cone rays. -/
lemma isExtremeSingletonRayHull_of_noProperConicCombination
    {C : Set E} {rbar : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hrbar_ne_zero : rbar ≠ 0)
    (hno : ¬ ProperConicCombinationOfDistinctConeRays C rbar) :
    IsExtreme ℝ C (PointedCone.hull ℝ ({rbar} : Set E) : Set E) := sorry

/-- Helper for Definition 3.11-extra-1: an extreme singleton ray hull forbids proper conic
decompositions into distinct cone rays. -/
lemma notProperConicCombinationOfIsExtremeRayOfCone
    {C : Set E} {rbar : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar_ne_zero : rbar ≠ 0)
    (hExtreme : IsExtreme ℝ C (PointedCone.hull ℝ ({rbar} : Set E) : Set E)) :
    ¬ ProperConicCombinationOfDistinctConeRays C rbar := sorry

/-- Helper: for a cone `C`, a nonzero vector `rbar` generates an extreme ray exactly when `rbar`
is not a proper conic combination of two distinct rays contained in `C`. -/
theorem isExtremeRayOfCone_iff_not_proper_conic_combination_of_distinct_rays
    {C : Set E} {rbar : E}
    (hC_cone : ∃ K : PointedCone ℝ E, (K : Set E) = C)
    (hrbar : rbar ∈ C)
    (hrbar_ne_zero : rbar ≠ 0) :
    IsExtremeRayOfCone C rbar ↔
      ¬ ProperConicCombinationOfDistinctConeRays C rbar := sorry

/-- Helper: the set-level predicate obtained by applying `IsExtremeRayOfCone` to the recession
cone of `P`. -/
def IsExtremeRayOfPolyhedron (P : Set E) (r : E) : Prop :=
  IsExtremeRayOfCone (recessionCone P) r

/-- Unfolding lemma for the helper predicate `IsExtremeRayOfPolyhedron`. -/
theorem isExtremeRayOfPolyhedron_iff {P : Set E} {r : E} :
    IsExtremeRayOfPolyhedron P r ↔ IsExtremeRayOfCone (recessionCone P) r := by
  -- This is the definitional expansion through the recession-cone wrapper.
  rfl

section SourceFacing

variable {n : ℕ}

/-- Definition 3.11-extra-1. An extreme ray of a pointed polyhedral cone `C` is an edge of `C`.
In this project, `is_polyhedral_cone C` is already the local owner for "pointed polyhedral cone",
and the edge is represented by the half-line generated by `r`. -/
class IsExtremeRayOfPointedPolyhedralCone
    (C : Set (Fin n → ℝ)) (r : Fin n → ℝ) : Prop where
  /-- The ambient cone is polyhedral, which is the project-local owner for pointed polyhedral
  cones in this section. -/
  polyhedral : is_polyhedral_cone C
  /-- The generator `r` determines an extreme ray of the ambient cone. -/
  isExtremeRay : IsExtremeRayOfCone C r

/-- An extreme ray of a pointed polyhedral cone is, in particular, an extreme ray of the ambient
cone. -/
instance instIsExtremeRayOfConeOfIsExtremeRayOfPointedPolyhedralCone
    {C : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    [h : IsExtremeRayOfPointedPolyhedralCone C r] :
    IsExtremeRayOfCone C r :=
  h.isExtremeRay

/-- An extreme ray of a pointed polyhedral cone is, in particular, an edge of the ambient cone
along the generated half-line. -/
instance instIsEdgeOfOfIsExtremeRayOfPointedPolyhedralCone
    {C : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    [h : IsExtremeRayOfPointedPolyhedralCone C r] :
    IsEdgeOf C (PointedCone.hull ℝ ({r} : Set (Fin n → ℝ)) : Set (Fin n → ℝ)) :=
  h.isExtremeRay

/-- The source-facing pointed-polyhedral-cone owner expands to the ambient polyhedral-cone
hypothesis together with the set-level edge predicate on the generated half-line. -/
theorem isExtremeRayOfPointedPolyhedralCone_iff
    {C : Set (Fin n → ℝ)} {r : Fin n → ℝ} :
    IsExtremeRayOfPointedPolyhedralCone C r ↔
      is_polyhedral_cone C ∧ IsExtremeRayOfCone C r := by
  constructor
  · intro h
    exact ⟨h.polyhedral, h.isExtremeRay⟩
  · rintro ⟨hC_polyhedral, hr_extreme⟩
    exact ⟨hC_polyhedral, hr_extreme⟩

/-- Extreme-ray generators of a pointed polyhedral cone are invariant under replacing the
generator by another nonzero vector on the same ray. -/
theorem isExtremeRayOfPointedPolyhedralCone_of_sameRay
    {C : Set (Fin n → ℝ)} {r r' : Fin n → ℝ}
    (hr : IsExtremeRayOfPointedPolyhedralCone C r)
    (hsame : SameRay ℝ r r')
    (hr'_ne : r' ≠ 0) :
    IsExtremeRayOfPointedPolyhedralCone C r' := by
  -- Keep the ambient pointed-polyhedral hypothesis and transport only the edge witness.
  exact ⟨hr.polyhedral, isExtremeRayOfCone_of_sameRay hr.isExtremeRay hsame hr'_ne⟩

/-- Companion source-facing predicate: the extreme rays of a pointed polyhedron are the extreme rays
of its recession cone. The nonemptiness assumption is part of the Section 3.11 standing context. -/
def IsExtremeRayOfPointedPolyhedron
    (P : Set (Fin n → ℝ)) (r : Fin n → ℝ) : Prop :=
  P.Nonempty ∧ is_polyhedron P ∧ is_pointed P ∧
    IsExtremeRayOfCone (recessionCone P) r

/-- A pointed-polyhedron extreme ray carries the Section 3.11 nonemptiness hypothesis. -/
theorem IsExtremeRayOfPointedPolyhedron.nonempty
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (h : IsExtremeRayOfPointedPolyhedron P r) :
    P.Nonempty :=
  h.1

/-- A pointed-polyhedron extreme ray carries the ambient polyhedron hypothesis. -/
theorem IsExtremeRayOfPointedPolyhedron.polyhedral
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (h : IsExtremeRayOfPointedPolyhedron P r) :
    is_polyhedron P :=
  h.2.1

/-- A pointed-polyhedron extreme ray carries the ambient pointedness hypothesis. -/
theorem IsExtremeRayOfPointedPolyhedron.pointed
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (h : IsExtremeRayOfPointedPolyhedron P r) :
    is_pointed P :=
  h.2.2.1

/-- A pointed-polyhedron extreme ray is an extreme ray of the recession cone. -/
theorem IsExtremeRayOfPointedPolyhedron.isExtremeRay
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (h : IsExtremeRayOfPointedPolyhedron P r) :
    IsExtremeRayOfCone (recessionCone P) r :=
  h.2.2.2

/-- Unfolding lemma for the pointed-polyhedron predicate. -/
theorem isExtremeRayOfPointedPolyhedron_iff
    {P : Set (Fin n → ℝ)} {r : Fin n → ℝ} :
    IsExtremeRayOfPointedPolyhedron P r ↔
      P.Nonempty ∧ is_polyhedron P ∧ is_pointed P ∧
        IsExtremeRayOfCone (recessionCone P) r := by
  rfl

/-- Same-ray invariance for extreme rays of pointed polyhedra, provided the new generator is
nonzero. -/
theorem isExtremeRayOfPointedPolyhedron_of_sameRay
    {P : Set (Fin n → ℝ)} {r r' : Fin n → ℝ}
    (hr : IsExtremeRayOfPointedPolyhedron P r)
    (hsame : SameRay ℝ r r')
    (hr'_ne : r' ≠ 0) :
    IsExtremeRayOfPointedPolyhedron P r' := by
  -- Preserve the ambient pointed-polyhedron data and transport the recession-cone edge witness.
  exact ⟨hr.nonempty, hr.polyhedral, hr.pointed,
    isExtremeRayOfCone_of_sameRay hr.isExtremeRay hsame hr'_ne⟩

end SourceFacing
