/-- Corollary 3.42. If `P` is a pointed polyhedron, then every point `x ∈ P` can be written as the
sum of a convex combination of at most `dim(P) + 1` affinely independent vertices of `P` and a
conic combination of at most `dim(rec(P))` linearly independent extreme rays of `P`. The vertex
part is expressed canonically as membership in the convex hull of a finite affinely independent
subset of `P.extremePoints ℝ`, while the ray part is given directly as the finite-family witness
from Theorem 3.40. -/
theorem exists_vertex_convex_combination_add_extreme_ray_conic_combination
    {n : ℕ} {P : Set (Fin n → ℝ)}
    (hP_polyhedron : is_polyhedron P)
    (hP_pointed : is_pointed P)
    {x : Fin n → ℝ} (hx : x ∈ P) :
    ∃ vertexPart : Fin n → ℝ, ∃ vertices : Finset (Fin n → ℝ),
      (vertices : Set _) ⊆ P.extremePoints ℝ ∧
      AffineIndependent ℝ ((↑) : vertices → Fin n → ℝ) ∧
      vertexPart ∈ convexHull ℝ (vertices : Set _) ∧
      vertices.card ≤ Module.finrank ℝ (affineSpan ℝ P).direction + 1 ∧
      ∃ q : ℕ, ∃ r : Fin q → Fin n → ℝ,
        (∀ j, r j ∈ {r | IsExtremeRayOfPolyhedron P r}) ∧
        LinearIndependent ℝ r ∧
        q ≤ Module.finrank ℝ (Submodule.span ℝ (recessionCone P)) ∧
        ∃ coeff : Fin q → ℝ, (∀ j, 0 ≤ coeff j) ∧
          x = vertexPart + ∑ j, coeff j • r j := by
  -- Reduce the corollary to the coarse decomposition promised by the source-faithful homogenized
  -- route.
  rcases exists_vertex_part_add_extreme_ray_part_of_mem_polyhedron
      hP_polyhedron hP_pointed hx with
    ⟨vertexPart, rayPart, hvertexPart, hrayPart, hx_split⟩
  -- Once the split is available, the bounded independent families come from Corollary 3.41 and
  -- Theorem 3.40.
  exact exists_bounded_vertex_and_ray_decomposition_of_split
    ⟨vertexPart, rayPart, hvertexPart, hrayPart, hx_split⟩
