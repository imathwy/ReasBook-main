/-- Helper for Corollary 3.42: an extreme ray of a polyhedron is in particular a recession
direction. -/
lemma isExtremeRayOfPolyhedron_mem_recessionCone
    {n : ℕ} {P : Set (Fin n → ℝ)} {r : Fin n → ℝ}
    (hr : IsExtremeRayOfPolyhedron P r) :
    r ∈ recessionCone P := by
  -- Unpack the source-facing extreme-ray predicate to the canonical cone-edge witness.
  have hr_cone : IsExtremeRayOfCone (recessionCone P) r :=
    (isExtremeRayOfPolyhedron_iff).1 hr
  have hedge :
      IsEdgeOf (recessionCone P) (PointedCone.hull ℝ ({r} : Set (Fin n → ℝ))) :=
    (isExtremeRayOfCone_iff).1 hr_cone
  -- The ray generator belongs to its singleton cone hull, and the edge sits inside the ambient
  -- cone.
  have hr_hull : r ∈ PointedCone.hull ℝ ({r} : Set (Fin n → ℝ)) :=
    PointedCone.subset_hull (by simp)
  exact hedge.isExtreme.subset hr_hull

/-- Helper for Corollary 3.42: once a point splits into a convex-hull vertex part and a cone part
generated by extreme rays, Corollary 3.41 and Theorem 3.40 compress those two pieces to bounded
independent families. -/
lemma exists_bounded_vertex_and_ray_decomposition_of_split
    {n : ℕ} {P : Set (Fin n → ℝ)} {x : Fin n → ℝ}
    (hsplit :
      ∃ vertexPart rayPart : Fin n → ℝ,
        vertexPart ∈ convexHull ℝ (P.extremePoints ℝ) ∧
        rayPart ∈ PointedCone.hull ℝ {r | IsExtremeRayOfPolyhedron P r} ∧
        x = vertexPart + rayPart) :
    ∃ vertexPart : Fin n → ℝ, ∃ vertices : Finset (Fin n → ℝ),
      (vertices : Set _) ⊆ P.extremePoints ℝ ∧
      AffineIndependent ℝ ((↑) : vertices → Fin n → ℝ) ∧
      vertexPart ∈ convexHull ℝ (vertices : Set _) ∧
      vertices.card ≤ Module.finrank ℝ (affineSpan ℝ P).direction + 1 ∧
      ∃ q : ℕ, ∃ r : Fin q → Fin n → ℝ,
        (∀ j, r j ∈ {r | IsExtremeRayOfPolyhedron P r}) ∧
        LinearIndependent ℝ r ∧
        q ≤ Module.finrank ℝ (Submodule.span ℝ (recessionCone P)) ∧
        ∃ coeff : Fin q → ℝ, (∀ j, 0 ≤ coeff j) ∧
          x = vertexPart + ∑ j, coeff j • r j := by
  rcases hsplit with ⟨vertexPart, rayPart, hvertexPart, hrayPart, hx_split⟩
  -- Compress the convex-hull part to an affinely independent vertex family.
  rcases exists_affineIndependent_convexCombination_of_mem_convexHull hvertexPart with
    ⟨vertices, hvertices_subset, hvertices_affineIndependent, hvertexPart_mem, hvertices_card⟩
  have hvertex_extreme_subset :
      (P.extremePoints ℝ : Set (Fin n → ℝ)) ⊆ P :=
    extremePoints_subset
  have hvertex_dim_le :
      Module.finrank ℝ (affineSpan ℝ (P.extremePoints ℝ)).direction ≤
        Module.finrank ℝ (affineSpan ℝ P).direction := by
    exact Submodule.finrank_mono
      (AffineSubspace.direction_le (affineSpan_mono ℝ hvertex_extreme_subset))
  have hvertices_bound :
      vertices.card ≤ Module.finrank ℝ (affineSpan ℝ P).direction + 1 := by
    exact hvertices_card.trans <| by
      simpa [add_comm] using add_le_add_right hvertex_dim_le 1
  -- Compress the cone part to a linearly independent family of extreme rays.
  rcases exists_linearIndependent_conicCombination_of_mem_hull hrayPart with
    ⟨q, r, hr_mem, hr_linearIndependent, hq_span, coeff, hcoeff_nonneg, hray_repr⟩
  have hray_subset_recession :
      {r | IsExtremeRayOfPolyhedron P r} ⊆ recessionCone P := by
    intro r hr
    exact isExtremeRayOfPolyhedron_mem_recessionCone hr
  have hray_span_le :
      Module.finrank ℝ (Submodule.span ℝ {r | IsExtremeRayOfPolyhedron P r}) ≤
        Module.finrank ℝ (Submodule.span ℝ (recessionCone P)) := by
    exact Submodule.finrank_mono (Submodule.span_mono hray_subset_recession)
  refine ⟨vertexPart, vertices, hvertices_subset, hvertices_affineIndependent, hvertexPart_mem,
    hvertices_bound, q, r, hr_mem, hr_linearIndependent, hq_span.trans hray_span_le,
    coeff, hcoeff_nonneg, ?_⟩
  -- Substitute the compressed cone representation back into the original split.
  calc
    x = vertexPart + rayPart := hx_split
    _ = vertexPart + ∑ j, coeff j • r j := by rw [hray_repr]

