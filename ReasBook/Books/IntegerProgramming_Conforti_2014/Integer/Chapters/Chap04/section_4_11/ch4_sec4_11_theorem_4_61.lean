variable {n k : ℕ}

/-- Helper for Theorem 4.61: cone membership over a finite rational family can be rewritten using
nonnegative coefficients on the original index type. -/
lemma exists_nonnegative_coefficient_function_of_mem_hull
    {ι : Type*}
    [Fintype ι]
    (r : ι → Fin n → ℚ)
    {v : Fin n → ℚ}
    (hv : v ∈ (PointedCone.hull ℚ (Set.range r) : Set (Fin n → ℚ))) :
    ∃ coeff : ι → ℚ,
      (∀ i, 0 ≤ coeff i) ∧
        v = ∑ i, coeff i • r i := by
  classical
  letI : DecidableEq ι := Classical.decEq ι
  rcases (mem_hull_iff.mp hv) with ⟨s, r', hr_mem, coeff, hcoeff_nonneg, hv_eq⟩
  let idx : Fin s → ι := fun j ↦ Classical.choose (hr_mem j)
  have hidx : ∀ j : Fin s, r (idx j) = r' j := by
    intro j
    exact Classical.choose_spec (hr_mem j)
  let coeff' : ι → ℚ := fun i ↦ ∑ j : Fin s, if idx j = i then coeff j else 0
  refine ⟨coeff', ?_, ?_⟩
  · -- Aggregate the finite witness coefficients by their chosen original indices.
    intro i
    exact Finset.sum_nonneg fun j _ ↦ by
      by_cases hj : idx j = i
      · simp [coeff', hj, hcoeff_nonneg j]
      · simp [coeff', hj]
  · -- Collapse the compressed support witness back to the original family.
    ext t
    symm
    calc
      (∑ i : ι, coeff' i • r i) t
          = ∑ i : ι, coeff' i * r i t := by
              simp [Pi.smul_apply]
      _ = ∑ i : ι, (∑ j : Fin s, if idx j = i then coeff j else 0) * r i t := by
            simp [coeff']
      _ = ∑ i : ι, ∑ j : Fin s, (if idx j = i then coeff j else 0) * r i t := by
            simp_rw [Finset.sum_mul]
      _ = ∑ j : Fin s, ∑ i : ι, (if idx j = i then coeff j else 0) * r i t := by
            rw [Finset.sum_comm]
      _ = ∑ j : Fin s, coeff j * r' j t := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            simpa [hidx j] using
              (by
                simp :
                  (∑ i : ι, (if idx j = i then coeff j else 0) * r i t) =
                    coeff j * r (idx j) t)
      _ = (∑ j : Fin s, coeff j • r' j) t := by
            simp [Pi.smul_apply]
      _ = v t := by
            simpa using (congrFun hv_eq t).symm

/-- Helper for Theorem 4.61: an integral point of the real cone generated by a finite integral
family already lies in the corresponding rational cone. -/
lemma integral_point_mem_rational_hull_of_mem_real_hull
    {l : ℕ}
    {a : Fin l → Fin n → ℤ}
    {z : Fin n → ℤ}
    (hz :
      (fun j ↦ (z j : ℝ)) ∈
        (PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) : Set (Fin n → ℝ))) :
    (fun j ↦ (z j : ℚ)) ∈
      (PointedCone.hull ℚ (Set.range fun i ↦ fun j ↦ (a i j : ℚ)) : Set (Fin n → ℚ)) := by
  classical
  rcases (mem_hull_iff.mp hz) with ⟨s, r, hr_mem, coeffR, hcoeffR_nonneg, hz_eq⟩
  let idx : Fin s → Fin l := fun j ↦ Classical.choose (hr_mem j)
  have hidx : ∀ j : Fin s, r j = fun t ↦ (a (idx j) t : ℝ) := by
    intro j
    exact (Classical.choose_spec (hr_mem j)).symm
  let M : Matrix (Fin s) (Fin n) ℚ := fun j t ↦ a (idx j) t
  have hreal :
      ∃ xR : Fin s → ℝ,
        (xR ᵥ* (M.map (Rat.castHom ℝ)) = fun t ↦ (z t : ℝ)) ∧
          0 ≤ xR := by
    refine ⟨coeffR, ?_, hcoeffR_nonneg⟩
    -- Rewrite the real hull witness as the row-vector system used by the rationalization lemma.
    ext t
    calc
      (coeffR ᵥ* (M.map (Rat.castHom ℝ))) t
          = ∑ j : Fin s, coeffR j * r j t := by
              simp [M, Matrix.vecMul, dotProduct, hidx]
      _ = (∑ j : Fin s, coeffR j • r j) t := by
            simp [smul_eq_mul]
      _ = (fun t ↦ (z t : ℝ)) t := by
            simpa using congrArg (fun f : Fin n → ℝ ↦ f t) hz_eq.symm
  rcases
      exists_rat_nonnegative_solution_of_real_cast_feasible
        M (fun t ↦ (z t : ℚ)) hreal with
    ⟨coeffQ, hcoeffQ_row, hcoeffQ_nonneg⟩
  have hzQ_eq :
      (fun t ↦ (z t : ℚ)) =
        ∑ j : Fin s, coeffQ j • (fun t ↦ (a (idx j) t : ℚ)) := by
    -- The rationalized row equation is exactly the desired rational cone witness.
    ext t
    calc
      (fun u ↦ (z u : ℚ)) t = (coeffQ ᵥ* M) t := by
        simpa using (congrFun hcoeffQ_row t).symm
      _ = (∑ j : Fin s, coeffQ j • (fun u ↦ (a (idx j) u : ℚ))) t := by
            simp [M, Matrix.vecMul, dotProduct, smul_eq_mul]
  have hmem_idx :
      (fun t ↦ (z t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun j : Fin s ↦ fun t ↦ (a (idx j) t : ℚ)) :
          Set (Fin n → ℚ)) := by
    -- Package the rationalized coefficients back into rational hull membership.
    refine mem_hull_of_equivFin_nonnegative_family
      (fun j : Fin s ↦ fun t ↦ (a (idx j) t : ℚ))
      coeffQ
      (fun t ↦ (z t : ℚ))
      hcoeffQ_nonneg
      ?_
    simpa using hzQ_eq
  have hsubset :
      Set.range (fun j : Fin s ↦ fun t ↦ (a (idx j) t : ℚ)) ⊆
        Set.range (fun i : Fin l ↦ fun t ↦ (a i t : ℚ)) := by
    rintro y ⟨j, rfl⟩
    exact ⟨idx j, rfl⟩
  -- Enlarge from the selected support family back to the original generator family.
  exact (show
      (PointedCone.hull ℚ (Set.range fun j : Fin s ↦ fun t ↦ (a (idx j) t : ℚ)) :
        Set (Fin n → ℚ)) ⊆
        (PointedCone.hull ℚ (Set.range fun i : Fin l ↦ fun t ↦ (a i t : ℚ)) :
          Set (Fin n → ℚ)) from
      Submodule.span_mono hsubset) hmem_idx

/-- Helper for Theorem 4.61: the same real-to-rational cone rationalization works for any finite
index type after reindexing the family onto `Fin`. -/
lemma integral_point_mem_rational_hull_of_mem_real_hull_fintype
    {ι : Type*}
    [Fintype ι]
    (r : ι → Fin n → ℤ)
    {z : Fin n → ℤ}
    (hz :
      (fun t ↦ (z t : ℝ)) ∈
        (PointedCone.hull ℝ (Set.range fun i : ι ↦ fun t ↦ (r i t : ℝ)) :
          Set (Fin n → ℝ))) :
    (fun t ↦ (z t : ℚ)) ∈
      (PointedCone.hull ℚ (Set.range fun i : ι ↦ fun t ↦ (r i t : ℚ)) :
        Set (Fin n → ℚ)) := by
  classical
  let e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
  let rFin : Fin (Fintype.card ι) → Fin n → ℤ := fun j ↦ r (e.symm j)
  have hrange_real :
      Set.range (fun j : Fin (Fintype.card ι) ↦ fun t ↦ (rFin j t : ℝ)) =
        Set.range (fun i : ι ↦ fun t ↦ (r i t : ℝ)) := by
    -- Reindex the real family onto `Fin` so the earlier rationalization lemma applies verbatim.
    ext y
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨e.symm j, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨e i, by simp [rFin]⟩
  have hzFin :
      (fun t ↦ (z t : ℝ)) ∈
        (PointedCone.hull ℝ (Set.range fun j : Fin (Fintype.card ι) ↦
          fun t ↦ (rFin j t : ℝ)) : Set (Fin n → ℝ)) := by
    -- Transport the real hull witness across the reindexing equality.
    simpa [hrange_real] using hz
  have hzFinQ :
      (fun t ↦ (z t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun j : Fin (Fintype.card ι) ↦
          fun t ↦ (rFin j t : ℚ)) : Set (Fin n → ℚ)) :=
    integral_point_mem_rational_hull_of_mem_real_hull hzFin
  have hrange_rat :
      Set.range (fun j : Fin (Fintype.card ι) ↦ fun t ↦ (rFin j t : ℚ)) =
        Set.range (fun i : ι ↦ fun t ↦ (r i t : ℚ)) := by
    -- The same reindexing identifies the rational family ranges as well.
    ext y
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨e.symm j, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨e i, by simp [rFin]⟩
  simpa [hrange_rat] using hzFinQ

/-- Helper for Theorem 4.61: splitting a rational cone witness into floors and fractional parts
produces an integral remainder whose rational realization has coefficients in `[0,1)`. -/
lemma exists_half_open_box_remainder_of_integral_cone_point
    {q : ℕ}
    (a : Fin q → Fin n → ℤ)
    {z : Fin n → ℤ}
    (hz :
      (fun t ↦ (z t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun j : Fin q ↦ fun t ↦ (a j t : ℚ)) :
          Set (Fin n → ℚ))) :
    ∃ coeff : Fin q → ℚ, ∃ μ₀ : Fin q →₀ ℕ, ∃ ρ : Fin n → ℤ,
      (∀ j, 0 ≤ coeff j) ∧
        z = μ₀.sum (fun j c ↦ c • a j) + ρ ∧
          (fun t ↦ (ρ t : ℚ)) =
            ∑ j : Fin q, Int.fract (coeff j) • (fun t ↦ (a j t : ℚ)) ∧
              (∀ j, 0 ≤ Int.fract (coeff j)) ∧
                (∀ j, Int.fract (coeff j) < 1) := by
  obtain ⟨coeff, hcoeff_nonneg, hz_eq⟩ :=
    exists_nonnegative_coefficient_function_of_mem_hull
      (fun j : Fin q ↦ fun t ↦ (a j t : ℚ))
      hz
  let μNat : Fin q → ℕ := fun j ↦ Int.toNat (Int.floor (coeff j))
  let μ₀ : Fin q →₀ ℕ := Finsupp.equivFunOnFinite.symm μNat
  have hμ_cast : ∀ j : Fin q, ((μ₀ j : ℕ) : ℚ) = (Int.floor (coeff j) : ℚ) := by
    intro j
    have hfloor_nonneg : 0 ≤ Int.floor (coeff j) := Int.floor_nonneg.mpr (hcoeff_nonneg j)
    calc
      ((μ₀ j : ℕ) : ℚ) = (Int.toNat (Int.floor (coeff j)) : ℚ) := by
            simp [μ₀, μNat]
      _ = (Int.floor (coeff j) : ℚ) := by
            exact_mod_cast (Int.toNat_of_nonneg hfloor_nonneg)
  have hμ₀Q_eq :
      (fun t ↦ ((μ₀.sum (fun j c ↦ c • a j)) t : ℚ)) =
        ∑ j : Fin q, (Int.floor (coeff j) : ℚ) • (fun t ↦ (a j t : ℚ)) := by
    -- Rewrite the floor part as the same finite rational linear combination.
    ext t
    calc
      ((μ₀.sum (fun j c ↦ c • a j)) t : ℚ)
          = ∑ j : Fin q, ((μ₀ j : ℕ) : ℚ) * (a j t : ℚ) := by
              rw [Finsupp.sum_fintype _ _ (fun _ ↦ by simp), Finset.sum_apply]
              simp [nsmul_eq_mul]
      _ = ∑ j : Fin q, (Int.floor (coeff j) : ℚ) * (a j t : ℚ) := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            rw [hμ_cast j]
      _ = (∑ j : Fin q, (Int.floor (coeff j) : ℚ) • (fun s ↦ (a j s : ℚ))) t := by
            simp [Pi.smul_apply]
  let ρ : Fin n → ℤ := z - μ₀.sum (fun j c ↦ c • a j)
  refine ⟨coeff, μ₀, ρ, hcoeff_nonneg, ?_, ?_, ?_, ?_⟩
  · -- The remainder is exactly what remains after removing the floor part.
    ext t
    simp [ρ, sub_eq_add_neg, add_comm, add_left_comm, add_assoc]
  · -- The rational remainder is represented by the fractional parts of the coefficients.
    ext t
    calc
      (ρ t : ℚ) = (z t : ℚ) - ((μ₀.sum (fun j c ↦ c • a j)) t : ℚ) := by
        simp [ρ]
      _ = (∑ j : Fin q, coeff j * (a j t : ℚ)) -
            ∑ j : Fin q, (Int.floor (coeff j) : ℚ) * (a j t : ℚ) := by
              rw [congrFun hz_eq t, congrFun hμ₀Q_eq t]
              simp [Pi.smul_apply]
      _ = ∑ j : Fin q,
            (coeff j - (Int.floor (coeff j) : ℚ)) * (a j t : ℚ) := by
              rw [← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl ?_
              intro j hj
              ring
      _ = ∑ j : Fin q, Int.fract (coeff j) * (a j t : ℚ) := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            have hdecomp :
                coeff j - (Int.floor (coeff j) : ℚ) = Int.fract (coeff j) := by
              linarith [Int.floor_add_fract (coeff j)]
            simp [hdecomp]
      _ = (∑ j : Fin q, Int.fract (coeff j) • (fun s ↦ (a j s : ℚ))) t := by
            simp [Pi.smul_apply]
  · -- Fractional parts are nonnegative.
    intro j
    exact Int.fract_nonneg (coeff j)
  · -- Fractional parts are strictly smaller than `1`.
    intro j
    exact Int.fract_lt_one (coeff j)

/-- Helper for Theorem 4.61: a rational Hilbert-basis witness between integral vectors already
gives an equality over `ℤ`. -/
lemma eq_of_rat_finsupp_sum_eq
    {ι : Type*}
    (a : ι → Fin n → ℤ)
    {z : Fin n → ℤ}
    {μ : ι →₀ ℕ}
    (hz :
      (fun t ↦ (z t : ℚ)) =
        μ.sum (fun j c ↦ c • fun t ↦ (a j t : ℚ))) :
    z = μ.sum (fun j c ↦ c • a j) := by
  -- Compare the coordinatewise rational casts and cast the equality back to `ℤ`.
  ext t
  exact_mod_cast congrFun hz t

/-- Helper for Theorem 4.61: among all Hilbert-basis witnesses for a fixed integral remainder,
choose one with minimal support cardinality. -/
lemma exists_support_minimal_remainder_hilbert_witness
    (a : Fin k → Fin n → ℤ)
    (h_hilbert : IsHilbertBasisFamily a)
    (ρ : Fin n → ℤ)
    (hρ_rat :
      (fun t ↦ (ρ t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℚ)) :
          Set (Fin n → ℚ))) :
    ∃ ν : Fin k →₀ ℕ,
      ρ = ν.sum (fun j c ↦ c • a j) ∧
        ∀ ν' : Fin k →₀ ℕ,
          ρ = ν'.sum (fun j c ↦ c • a j) →
            ν.support.card ≤ ν'.support.card := by
  classical
  let P : ℕ → Prop := fun t ↦
    ∃ ν : Fin k →₀ ℕ, ρ = ν.sum (fun j c ↦ c • a j) ∧ ν.support.card = t
  have hP : ∃ t, P t := by
    obtain ⟨ν, hν_rat⟩ := h_hilbert ρ hρ_rat
    have hν_int : ρ = ν.sum (fun j c ↦ c • a j) :=
      eq_of_rat_finsupp_sum_eq a hν_rat
    -- Package one existing Hilbert witness so `Nat.find` can minimize its support size.
    exact ⟨ν.support.card, ν, hν_int, rfl⟩
  rcases Nat.find_spec hP with ⟨ν, hν_int, hν_card⟩
  refine ⟨ν, hν_int, ?_⟩
  intro ν' hν'_int
  have hmin : Nat.find hP ≤ ν'.support.card := by
    -- Any competing integral witness contributes another admissible support size.
    exact Nat.find_min' hP ⟨ν', hν'_int, rfl⟩
  simpa [hν_card] using hmin

/-- Helper for Theorem 4.61: the half-open-box remainder only uses those selected generators with
strictly positive fractional coefficient. -/
lemma active_selected_family_data
    {q : ℕ}
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (hρ_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : Fin q, Int.fract (coeffQ j) • (fun t ↦ (aSel j t : ℚ)))
    (hfract_nonneg : ∀ j, 0 ≤ Int.fract (coeffQ j))
    (hfract_lt_one : ∀ j, Int.fract (coeffQ j) < 1) :
    let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
    (fun t ↦ (ρ t : ℚ)) =
      ∑ j : α, Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ)) ∧
        (∀ j : α, 0 < Int.fract (coeffQ j.1)) ∧
          (∀ j : α, Int.fract (coeffQ j.1) < 1) := by
  classical
  dsimp
  refine ⟨?_, ?_, ?_⟩
  · -- Remove the zero fractional coefficients so the remainder is indexed only by the active set.
    ext t
    calc
      (fun s ↦ (ρ s : ℚ)) t =
          (∑ j : Fin q, Int.fract (coeffQ j) • (fun s ↦ (aSel j s : ℚ))) t := by
            simpa using congrFun hρ_eq t
      _ = ∑ j : Fin q, Int.fract (coeffQ j) * (aSel j t : ℚ) := by
            simp [Pi.smul_apply]
      _ =
          ∑ j in Finset.univ.filter (fun j : Fin q ↦ 0 < Int.fract (coeffQ j)),
            Int.fract (coeffQ j) * (aSel j t : ℚ) := by
              symm
              refine Finset.sum_subset (Finset.filter_subset _ _) ?_
              intro j _ hj
              have hnot_pos : ¬ 0 < Int.fract (coeffQ j) := by
                simpa using hj
              have hfract_zero : Int.fract (coeffQ j) = 0 := by
                exact le_antisymm (hfract_nonneg j) (le_of_not_gt hnot_pos)
              simp [hfract_zero]
      _ =
          ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
            Int.fract (coeffQ j.1) * (aSel j.1 t : ℚ) := by
              rw [← Finset.sum_subtype_eq_sum_filter]
      _ =
          (∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
            Int.fract (coeffQ j.1) • (fun s ↦ (aSel j.1 s : ℚ))) t := by
              simp [Pi.smul_apply]
  · -- By construction every active index has positive fractional coefficient.
    intro j
    exact j.2
  · -- The upper half-open-box bound is inherited coordinatewise by the active family.
    intro j
    exact hfract_lt_one j.1

/-- Helper for Theorem 4.61: restricting the selected linearly independent family to the active
fractional-coefficient subtype preserves linear independence, so the active family has at most
`n` indices. -/
lemma active_selected_family_linearIndependent_card_le
    {q : ℕ}
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (hSel_lin : LinearIndependent ℝ (fun j : Fin q ↦ fun t ↦ (aSel j t : ℝ)))
    (hq_le_n : q ≤ n) :
    let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
    LinearIndependent ℝ (fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ)) ∧
      Fintype.card α ≤ n := by
  classical
  dsimp
  refine ⟨?_, ?_⟩
  · -- Restrict the selected linearly independent family to the active subtype.
    refine hSel_lin.comp (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ j.1) ?_
    intro i j hij
    exact Subtype.ext hij
  · -- The active subtype cannot have more indices than the selected family or the ambient space.
    exact le_trans (Fintype.card_subtype_le (fun j : Fin q ↦ 0 < Int.fract (coeffQ j))) hq_le_n

/-- Helper for Theorem 4.61: the active selected family is also linearly independent over `ℚ`,
so the later coefficient comparison can stay in the rational setting of the remainder identity. -/
lemma active_selected_family_rational_linearIndependent
    {q : ℕ}
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (hSel_lin : LinearIndependent ℝ (fun j : Fin q ↦ fun t ↦ (aSel j t : ℝ)))
    (hq_le_n : q ≤ n) :
    let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
    LinearIndependent ℚ (fun j : α ↦ fun t ↦ (aSel j.1 t : ℚ)) := by
  classical
  dsimp
  have hα_lin_real :
      LinearIndependent ℝ
        (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ fun t ↦ (aSel j.1 t : ℝ)) :=
    (active_selected_family_linearIndependent_card_le aSel coeffQ hSel_lin hq_le_n).1
  let castQToR : (Fin n → ℚ) →ₗ[ℚ] (Fin n → ℝ) :=
    { toFun := fun v t ↦ (v t : ℝ)
      map_add' := by
        intro u v
        ext t
        exact Rat.cast_add (u t) (v t)
      map_smul' := by
        intro c v
        ext t
        exact Rat.cast_mul c (v t) }
  have hcastQToR_ker : castQToR.ker = ⊥ := by
    refine LinearMap.ker_eq_bot.mpr ?_
    intro u v huv
    ext t
    have hcoord : ((u t : ℚ) : ℝ) = (v t : ℝ) := congrFun huv t
    exact_mod_cast hcoord
  have hα_lin_cast :
      LinearIndependent ℚ
        (castQToR ∘ fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
          fun t ↦ (aSel j.1 t : ℚ)) := by
    -- Restrict scalars on the real active family before removing the coordinatewise cast.
    simpa [castQToR] using (LinearIndependent.restrict_scalars' (R := ℚ) hα_lin_real)
  -- Strip off the coordinatewise cast using injectivity of the rational-to-real linear map.
  exact ((castQToR).linearIndependent_iff hcastQToR_ker).mp hα_lin_cast

/-- Helper for Theorem 4.61: reindex the rationalization of a finitely supported integral witness
through an explicit enumeration of its support. -/
lemma rat_finsupp_sum_eq_sum_support_equiv
    (a : Fin k → Fin n → ℤ)
    (ρ : Fin n → ℤ)
    (ν : Fin k →₀ ℕ)
    (hρ_int : ρ = ν.sum (fun j c ↦ c • a j))
    {m : ℕ}
    (e : Fin m ≃ ν.support) :
    (fun t ↦ (ρ t : ℚ)) =
      ∑ s : Fin m, (ν (e s).1 : ℚ) • (fun t ↦ (a (e s).1 t : ℚ)) := by
  -- Rewrite the integral witness over `ν.support`, then reindex that finite sum along `e`.
  ext t
  calc
    (ρ t : ℚ) = ((ν.sum (fun j c ↦ c • a j)) t : ℚ) := by
      rw [hρ_int]
    _ = ∑ i in ν.support, (ν i : ℚ) * (a i t : ℚ) := by
          simp [Finsupp.sum, Pi.smul_apply, nsmul_eq_mul]
    _ = ∑ i : ν.support, (ν i.1 : ℚ) * (a i.1 t : ℚ) := by
          rw [Finset.sum_attach]
    _ = ∑ s : Fin m, (ν (e s).1 : ℚ) * (a (e s).1 t : ℚ) := by
          symm
          exact
            Fintype.sum_equiv e
              (fun s : Fin m ↦ (ν (e s).1 : ℚ) * (a (e s).1 t : ℚ))
              (fun i : ν.support ↦ (ν i.1 : ℚ) * (a i.1 t : ℚ))
              (fun s ↦ rfl)
    _ =
        (∑ s : Fin m, (ν (e s).1 : ℚ) • (fun u ↦ (a (e s).1 u : ℚ))) t := by
          simp [Pi.smul_apply]

/-- Helper for Theorem 4.61: once the support atoms admit active-family coordinates, linear
independence of the active selected family identifies the weighted column totals with the
fractional remainder coefficients. -/
lemma active_coordinate_totals_eq_remainder_coefficients
    {q m : ℕ}
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (νCoeff : Fin m → ℚ)
    (atom : Fin m → Fin n → ℚ)
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ)))
    (hρ_support_eq :
      (fun t ↦ (ρ t : ℚ)) = ∑ s : Fin m, νCoeff s • atom s)
    (hα_lin_rat :
      LinearIndependent ℚ
        (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ fun t ↦ (aSel j.1 t : ℚ)))
    (gamma : Fin m → {j : Fin q // 0 < Int.fract (coeffQ j)} → ℚ)
    (hgamma :
      ∀ s : Fin m,
        atom s =
          ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
            gamma s j • (fun t ↦ (aSel j.1 t : ℚ))) :
    ∀ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
      ∑ s : Fin m, νCoeff s * gamma s j = Int.fract (coeffQ j.1) := by
  -- Expand the support-indexed representation of `ρ` through the active-family coordinates.
  have hρ_support_expanded :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ i : {j : Fin q // 0 < Int.fract (coeffQ j)},
          (∑ s : Fin m, νCoeff s * gamma s i) • (fun t ↦ (aSel i.1 t : ℚ)) := by
    calc
      (fun t ↦ (ρ t : ℚ)) = ∑ s : Fin m, νCoeff s • atom s := hρ_support_eq
      _ =
          ∑ s : Fin m,
            νCoeff s •
              (∑ i : {j : Fin q // 0 < Int.fract (coeffQ j)},
                gamma s i • (fun t ↦ (aSel i.1 t : ℚ))) := by
              refine Fintype.sum_congr rfl ?_
              intro s
              rw [hgamma s]
      _ =
          ∑ s : Fin m,
            ∑ i : {j : Fin q // 0 < Int.fract (coeffQ j)},
              (νCoeff s * gamma s i) • (fun t ↦ (aSel i.1 t : ℚ)) := by
                refine Fintype.sum_congr rfl ?_
                intro s
                simp [Finset.smul_sum, mul_smul]
      _ =
          ∑ i : {j : Fin q // 0 < Int.fract (coeffQ j)},
            ∑ s : Fin m, (νCoeff s * gamma s i) • (fun t ↦ (aSel i.1 t : ℚ)) := by
                rw [Finset.sum_comm]
      _ =
          ∑ i : {j : Fin q // 0 < Int.fract (coeffQ j)},
            (∑ s : Fin m, νCoeff s * gamma s i) • (fun t ↦ (aSel i.1 t : ℚ)) := by
                refine Fintype.sum_congr rfl ?_
                intro i
                rw [← Finset.sum_smul]
  -- Compare the two active-family coefficient vectors using rational linear independence.
  have hcoeff_eq :
      ∀ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
        (∑ s : Fin m, νCoeff s * gamma s j) = Int.fract (coeffQ j.1) := by
    refine (Fintype.linearIndependent_iff.mp hα_lin_rat)
      (fun j ↦ ∑ s : Fin m, νCoeff s * gamma s j)
      (fun j ↦ Int.fract (coeffQ j.1))
      ?_
    calc
      ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          (∑ s : Fin m, νCoeff s * gamma s j) • (fun t ↦ (aSel j.1 t : ℚ))
          = (fun t ↦ (ρ t : ℚ)) := hρ_support_expanded.symm
      _ =
          ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
            Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ)) := hρ_active_eq
  exact hcoeff_eq

/-- Helper for Theorem 4.61: an integral point of the convex hull of a finite integral family
admits rational barycentric coordinates after homogenizing by a last coordinate equal to `1`. -/
lemma rational_barycentric_coordinates_of_integral_mem_convexHull
    {ι : Type*}
    [Fintype ι]
    (v : ι → Fin n → ℤ)
    {z : Fin n → ℤ}
    (hz :
      (fun t ↦ (z t : ℝ)) ∈
        convexHull ℝ (Set.range fun i : ι ↦ fun t ↦ (v i t : ℝ))) :
    ∃ gamma : ι → ℚ,
      (∀ i : ι, 0 ≤ gamma i) ∧
        (∑ i, gamma i = 1) ∧
          (fun t ↦ (z t : ℚ)) =
            ∑ i, gamma i • (fun t ↦ (v i t : ℚ)) := by
  classical
  obtain ⟨lam, hlam_nonneg, hlam_sum, hz_eq⟩ :=
    (mem_convexHull_range_iff_exists_barycentric_weights_fintype.mp hz)
  let e : ι ≃ Fin (Fintype.card ι) := Fintype.equivFin ι
  let liftV : Fin (Fintype.card ι) → Fin (n + 1) → ℤ :=
    fun j ↦ Fin.snoc (v (e.symm j)) 1
  let liftZ : Fin (n + 1) → ℤ := Fin.snoc z 1
  have hlam_sum_fin : ∑ j : Fin (Fintype.card ι), lam (e.symm j) = 1 := by
    calc
      ∑ j : Fin (Fintype.card ι), lam (e.symm j)
          = ∑ i : ι, lam i := by
              exact
                (Fintype.sum_equiv e.symm
                  (fun j : Fin (Fintype.card ι) ↦ lam (e.symm j))
                  (fun i : ι ↦ lam i)
                  (fun j ↦ rfl))
      _ = 1 := hlam_sum
  have hlift_real :
      (fun t ↦ (liftZ t : ℝ)) ∈
        (PointedCone.hull ℝ
          (Set.range fun j : Fin (Fintype.card ι) ↦ fun t ↦ (liftV j t : ℝ)) :
          Set (Fin (n + 1) → ℝ)) := by
    refine (mem_hull_iff).2 ?_
    refine
      ⟨Fintype.card ι, (fun j : Fin (Fintype.card ι) ↦ fun t ↦ (liftV j t : ℝ)), ?_,
        (fun j ↦ lam (e.symm j)), ?_, ?_⟩
    · intro j
      exact ⟨j, rfl⟩
    · -- Reindex the barycentric weights to `Fin` while preserving nonnegativity.
      intro j
      exact hlam_nonneg (e.symm j)
    · -- Homogenization converts the convex-hull witness into a cone-hull witness.
      ext t
      refine Fin.lastCases ?_ (fun i ↦ ?_) t
      · simpa [liftZ, liftV, Fin.snoc_last] using hlam_sum_fin.symm
      · intro i
        simpa [liftZ, liftV, Fin.snoc_castSucc] using congrFun hz_eq i
  have hlift_rat :
      (fun t ↦ (liftZ t : ℚ)) ∈
        (PointedCone.hull ℚ
          (Set.range fun j : Fin (Fintype.card ι) ↦ fun t ↦ (liftV j t : ℚ)) :
          Set (Fin (n + 1) → ℚ)) := by
    simpa [liftV, liftZ] using
      (integral_point_mem_rational_hull_of_mem_real_hull
        (n := n + 1) (a := liftV) (z := liftZ) hlift_real)
  obtain ⟨gammaFin, hgammaFin_nonneg, hlift_rat_eq⟩ :=
    exists_nonnegative_coefficient_function_of_mem_hull
      (fun j : Fin (Fintype.card ι) ↦ fun t ↦ (liftV j t : ℚ))
      hlift_rat
  let gamma : ι → ℚ := fun i ↦ gammaFin (e i)
  have hgamma_sum : ∑ i : ι, gamma i = 1 := by
    have hlast := congrFun hlift_rat_eq (Fin.last n)
    have hlast_sum : (1 : ℚ) = ∑ j : Fin (Fintype.card ι), gammaFin j := by
      simpa [liftZ, liftV, Fin.snoc_last, Pi.smul_apply] using hlast
    calc
      ∑ i : ι, gamma i
          = ∑ j : Fin (Fintype.card ι), gammaFin j := by
              exact
                (Fintype.sum_equiv e
                  (fun i : ι ↦ gammaFin (e i))
                  (fun j : Fin (Fintype.card ι) ↦ gammaFin j)
                  (fun i ↦ rfl))
      _ = 1 := hlast_sum.symm
  have hz_rat_eq_fin :
      (fun t ↦ (z t : ℚ)) =
        ∑ j : Fin (Fintype.card ι), gammaFin j • (fun t ↦ (v (e.symm j) t : ℚ)) := by
    -- Read back the first `n` coordinates of the homogenized rational combination.
    ext t
    simpa [liftZ, liftV, Fin.snoc_castSucc] using congrFun hlift_rat_eq t.castSucc
  refine ⟨gamma, ?_, hgamma_sum, ?_⟩
  · -- The rationalized barycentric weights stay nonnegative after reindexing back to `ι`.
    intro i
    exact hgammaFin_nonneg (e i)
  · -- Reindex the `Fin`-indexed rational barycentric combination back to the original family.
    calc
      (fun t ↦ (z t : ℚ))
          = ∑ j : Fin (Fintype.card ι), gammaFin j • (fun t ↦ (v (e.symm j) t : ℚ)) :=
              hz_rat_eq_fin
      _ = ∑ i : ι, gamma i • (fun t ↦ (v i t : ℚ)) := by
            symm
            exact
              Fintype.sum_equiv e
                (fun i : ι ↦ gamma i • (fun t ↦ (v i t : ℚ)))
                (fun j : Fin (Fintype.card ι) ↦
                  gammaFin j • (fun t ↦ (v (e.symm j) t : ℚ)))
                (fun i ↦ by simp [gamma])

/-- Helper for Theorem 4.61: if every support atom has positive multiplicity, then the weighted
active-coordinate identity forces each unweighted active column total to lie below `1`. -/
lemma active_simplex_column_totals_lt_one
    {m : ℕ}
    {ι : Type*}
    [Fintype ι]
    {ν : Fin k →₀ ℕ}
    {eν : Fin m ≃ ν.support}
    (gamma : Fin m → ι → ℚ)
    (rhs : ι → ℚ)
    (hgamma_nonneg : ∀ s : Fin m, ∀ i : ι, 0 ≤ gamma s i)
    (hweighted :
      ∀ i : ι,
        ∑ s : Fin m, (ν (eν s).1 : ℚ) * gamma s i = rhs i)
    (hrhs_lt_one : ∀ i : ι, rhs i < 1) :
    ∀ i : ι, ∑ s : Fin m, gamma s i < 1 := by
  intro i
  have hunweighted_le :
      ∑ s : Fin m, gamma s i ≤
        ∑ s : Fin m, (ν (eν s).1 : ℚ) * gamma s i := by
    refine Finset.sum_le_sum ?_
    intro s hs
    have hs_pos : 0 < ν (eν s).1 := by
      exact Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp (eν s).2)
    have hs_one_le : (1 : ℚ) ≤ (ν (eν s).1 : ℚ) := by
      exact_mod_cast (Nat.succ_le_of_lt hs_pos)
    have hmul_le :=
      mul_le_mul_of_nonneg_right hs_one_le (hgamma_nonneg s i)
    calc
      gamma s i = (1 : ℚ) * gamma s i := by ring
      _ ≤ (ν (eν s).1 : ℚ) * gamma s i := hmul_le
  have hweighted_lt :
      ∑ s : Fin m, (ν (eν s).1 : ℚ) * gamma s i < 1 := by
    simpa [hweighted i] using hrhs_lt_one i
  exact lt_of_le_of_lt hunweighted_le hweighted_lt

/-- Helper for Theorem 4.61: if each row of a rational matrix indexed by `Fin m × ι` sums to `1`
but every column sum is strictly smaller than `1`, then double counting contradicts
`Fintype.card ι ≤ m`. -/
lemma active_simplex_cardinality_contradiction
    {m : ℕ}
    {ι : Type*}
    [Fintype ι]
    (hι : Nonempty ι)
    (gamma : Fin m → ι → ℚ)
    (hrow_sum : ∀ s : Fin m, ∑ i : ι, gamma s i = 1)
    (hcol_lt_one : ∀ i : ι, ∑ s : Fin m, gamma s i < 1)
    (hcard : Fintype.card ι ≤ m) :
    False := by
  -- Sum the row identities and then compare with the strict column bounds.
  have hsum_rows :
      (m : ℚ) = ∑ s : Fin m, ∑ i : ι, gamma s i := by
    calc
      (m : ℚ) = ∑ s : Fin m, (1 : ℚ) := by simp
      _ = ∑ s : Fin m, ∑ i : ι, gamma s i := by
            refine Fintype.sum_congr rfl ?_
            intro s
            symm
            exact hrow_sum s
  have hm_lt :
      (m : ℚ) < m := by
    calc
      (m : ℚ) = ∑ s : Fin m, ∑ i : ι, gamma s i := hsum_rows
      _ = ∑ i : ι, ∑ s : Fin m, gamma s i := by rw [Finset.sum_comm]
      _ < ∑ i : ι, (1 : ℚ) := by
            exact
              Finset.sum_lt_sum_of_nonempty Finset.univ_nonempty
                (fun i _ ↦ hcol_lt_one i)
      _ = (Fintype.card ι : ℚ) := by simp
      _ ≤ m := by
            exact_mod_cast hcard
  exact (lt_irrefl (m : ℚ)) hm_lt

/-- Helper for Theorem 4.61: the active fractional remainder identity lifts from `ℚ` to a real
cone witness on the active selected family. -/
lemma active_remainder_mem_selected_real_hull
    {q : ℕ}
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ))) :
    (fun t ↦ (ρ t : ℝ)) ∈
      (PointedCone.hull ℝ
        (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
          fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ)) := by
  refine mem_hull_of_equivFin_nonnegative_family
    (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ fun t ↦ (aSel j.1 t : ℝ))
    (fun j ↦ (Int.fract (coeffQ j.1) : ℝ))
    (fun t ↦ (ρ t : ℝ))
    ?_
    ?_
  · -- The active coefficients stay nonnegative after casting to `ℝ`.
    intro j
    exact_mod_cast (le_of_lt j.2)
  · -- Cast the active rational identity coordinatewise to a real cone equality.
    ext t
    have hcoordQ :
        (ρ t : ℚ) =
          (∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
            Int.fract (coeffQ j.1) • (fun s ↦ (aSel j.1 s : ℚ))) t :=
      congrFun hρ_active_eq t
    have hcoordR :
        (ρ t : ℝ) =
          ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
            (Int.fract (coeffQ j.1) : ℝ) * (aSel j.1 t : ℝ) := by
      exact_mod_cast hcoordQ
    simpa [Pi.smul_apply] using hcoordR

/-- Helper for Theorem 4.61: if the selected family is obtained from the ambient Hilbert-basis
family, then its active cone is contained in the ambient real cone. -/
lemma active_selected_real_hull_subset_ambient_real_hull
    {q : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (hSel_eq : ∀ j : Fin q, aSel j = a (sel j)) :
    (PointedCone.hull ℝ
      (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
        fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ)) ⊆
      (PointedCone.hull ℝ
        (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) : Set (Fin n → ℝ)) := by
  -- Replace each active selected generator by its ambient owner.
  refine Submodule.span_mono ?_
  rintro y ⟨j, rfl⟩
  refine ⟨sel j.1, ?_⟩
  funext t
  simp [hSel_eq j.1]

/-- Helper for Theorem 4.61: every support atom of the minimal Hilbert witness already belongs to
the ambient real cone generated by the Hilbert-basis family. -/
lemma support_atom_mem_ambient_real_hull
    {ν : Fin k →₀ ℕ}
    {m : ℕ}
    (a : Fin k → Fin n → ℤ)
    (eν : Fin m ≃ ν.support)
    (s : Fin m) :
    (fun t ↦ (a (eν s).1 t : ℝ)) ∈
      (PointedCone.hull ℝ
        (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) : Set (Fin n → ℝ)) := by
  refine mem_hull_of_equivFin_nonnegative_family
    (fun i : Fin k ↦ fun t ↦ (a i t : ℝ))
    (fun i ↦ if i = (eν s).1 then (1 : ℝ) else 0)
    (fun t ↦ (a (eν s).1 t : ℝ))
    ?_
    ?_
  · -- The singleton coefficient vector is nonnegative.
    intro i
    by_cases hi : i = (eν s).1
    · simp [hi]
    · simp [hi]
  · -- The singleton combination recovers exactly the chosen support atom.
    ext t
    simp

/-- Helper for Theorem 4.61: deleting one copy of a support atom from the minimal witness still
leaves the remainder inside the ambient real cone. -/
lemma support_remainder_mem_ambient_real_hull
    {ν : Fin k →₀ ℕ}
    {m : ℕ}
    (a : Fin k → Fin n → ℤ)
    (ρ : Fin n → ℤ)
    (hρ_int : ρ = ν.sum (fun j c ↦ c • a j))
    (eν : Fin m ≃ ν.support) :
    ∀ s : Fin m,
      (fun t ↦ ((ρ - a (eν s).1) t : ℝ)) ∈
        (PointedCone.hull ℝ
          (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) : Set (Fin n → ℝ)) := by
  classical
  intro s
  let atom : Fin m → Fin n → ℝ := fun u t ↦ (a (eν u).1 t : ℝ)
  have hρ_support_real :
      (fun t ↦ (ρ t : ℝ)) =
        ∑ u : Fin m, (ν (eν u).1 : ℝ) • atom u := by
    -- Cast the support-indexed rational witness to `ℝ` so one coefficient can be lowered.
    ext t
    have hcoordQ :
        (ρ t : ℚ) =
          (∑ u : Fin m, (ν (eν u).1 : ℚ) • (fun v ↦ (a (eν u).1 v : ℚ))) t :=
      congrFun (rat_finsupp_sum_eq_sum_support_equiv a ρ ν hρ_int eν) t
    exact_mod_cast hcoordQ
  have hmem_support :
      (fun t ↦ ((ρ - a (eν s).1) t : ℝ)) ∈
        (PointedCone.hull ℝ (Set.range atom) : Set (Fin n → ℝ)) := by
    refine mem_hull_of_equivFin_nonnegative_family atom
      (fun u ↦ if u = s then ((ν (eν u).1 - 1 : ℕ) : ℝ) else (ν (eν u).1 : ℝ))
      (fun t ↦ ((ρ - a (eν s).1) t : ℝ))
      ?_
      ?_
    · -- Lowering one positive support coefficient preserves nonnegativity.
      intro u
      by_cases hu : u = s
      · simp [hu]
      · simp [hu]
    · -- Split off the selected support index and subtract exactly one copy of that atom.
      ext t
      have hs_pos : 0 < ν (eν s).1 := by
        exact Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp (eν s).2)
      have hs_cast :
          ((ν (eν s).1 : ℕ) : ℝ) =
            (((ν (eν s).1 - 1 : ℕ) : ℝ) + 1) := by
        exact_mod_cast (Nat.succ_pred_eq_of_pos hs_pos).symm
      have hcoordR :
          (ρ t : ℝ) =
            (∑ u : Fin m, (ν (eν u).1 : ℝ) • atom u) t :=
        congrFun hρ_support_real t
      calc
        ((ρ - a (eν s).1) t : ℝ)
            = (ρ t : ℝ) - atom s t := by
                simp [atom]
        _ = (∑ u : Fin m, (ν (eν u).1 : ℝ) * atom u t) - atom s t := by
              rw [hcoordR]
              simp [Pi.smul_apply]
        _ =
            (((ν (eν s).1 : ℝ) * atom s t) +
              ∑ u in Finset.univ.erase s, (ν (eν u).1 : ℝ) * atom u t) - atom s t := by
                rw [Finset.sum_eq_add (by simp)]
        _ =
            ((((ν (eν s).1 - 1 : ℕ) : ℝ) * atom s t) +
              ∑ u in Finset.univ.erase s, (ν (eν u).1 : ℝ) * atom u t) := by
                rw [hs_cast]
                ring
        _ =
            ∑ u : Fin m,
              (if u = s then ((ν (eν u).1 - 1 : ℕ) : ℝ) else (ν (eν u).1 : ℝ)) *
                atom u t := by
                  rw [Finset.sum_eq_add (by simp)]
                  simp
        _ =
            (∑ u : Fin m,
              (if u = s then ((ν (eν u).1 - 1 : ℕ) : ℝ) else (ν (eν u).1 : ℝ)) •
                atom u) t := by
                  simp [Pi.smul_apply]
  have hsubset :
      Set.range atom ⊆
        Set.range (fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) := by
    rintro y ⟨u, rfl⟩
    exact ⟨(eν u).1, rfl⟩
  -- Enlarge the support-indexed cone back to the ambient cone on the full Hilbert-basis family.
  exact
    (show
        (PointedCone.hull ℝ (Set.range atom) : Set (Fin n → ℝ)) ⊆
          (PointedCone.hull ℝ
            (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) : Set (Fin n → ℝ)) from
      Submodule.span_mono hsubset) hmem_support

/-- Helper for Theorem 4.61: the active selected cone is finitely generated, hence polyhedral, and
it inherits salience from the ambient pointed cone. -/
lemma active_selected_real_hull_polyhedral_salient
    {q : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (h_pointed :
      ((PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun j ↦ (a i j : ℝ)) :
        ConvexCone ℝ (Fin n → ℝ))).Salient)
    (hSel_eq : ∀ j : Fin q, aSel j = a (sel j)) :
    let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
    let F : PointedCone ℝ (Fin n → ℝ) :=
      PointedCone.hull ℝ (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ))
    is_polyhedral_cone (F : Set (Fin n → ℝ)) ∧
      ((F : ConvexCone ℝ (Fin n → ℝ))).Salient := by
  classical
  dsimp
  let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
  let F : PointedCone ℝ (Fin n → ℝ) :=
    PointedCone.hull ℝ (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ))
  have hF_fg : F.FG := by
    -- A cone hull over a finite active index set is finitely generated by construction.
    simpa [F] using
      Submodule.fg_span
        (Set.finite_range (fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ)))
  have hF_polyhedral : is_polyhedral_cone (F : Set (Fin n → ℝ)) := by
    -- Convert finite generation into the local polyhedral-cone interface used by the face API.
    exact
      (Theorem442Local.isFinitelyGeneratedCone_iff_isPolyhedralCone (C := F)).mp
        hF_fg
  have hF_subset :
      (F : Set (Fin n → ℝ)) ⊆
        (PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) :
          Set (Fin n → ℝ)) := by
    -- The active selected cone sits inside the ambient cone because each active generator comes
    -- from the ambient Hilbert-basis family.
    simpa [α, F] using
      active_selected_real_hull_subset_ambient_real_hull a sel aSel coeffQ hSel_eq
  have hF_salient : ((F : ConvexCone ℝ (Fin n → ℝ))).Salient := by
    -- Salience descends to sub-cones by monotonicity.
    exact
      (ConvexCone.Salient.anti
        (C₁ := (PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) :
          ConvexCone ℝ (Fin n → ℝ)))
        (C₂ := (F : ConvexCone ℝ (Fin n → ℝ)))
        hF_subset)
        h_pointed
  exact ⟨hF_polyhedral, hF_salient⟩

/-- Helper for Theorem 4.61: any ambient inequality row that is active on the remainder `ρ`
already vanishes on every active selected generator appearing in the positive fractional
decomposition of `ρ`. -/
lemma active_selected_generator_row_eq_zero_of_remainder_row_eq_zero
    {q mA : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (A : Matrix (Fin mA) (Fin n) ℝ)
    (hC_eq :
      (PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) :
        Set (Fin n → ℝ)) = polyhedron_le_set A 0)
    (hSel_eq : ∀ j : Fin q, aSel j = a (sel j))
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ)))
    {i : Fin mA}
    (hi : (A *ᵥ fun t ↦ (ρ t : ℝ)) i = 0) :
    ∀ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
      (A *ᵥ fun t ↦ (aSel j.1 t : ℝ)) i = 0 := by
  classical
  let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
  have hρ_active_eq_real :
      (fun t ↦ (ρ t : ℝ)) =
        ∑ j : α, (Int.fract (coeffQ j.1) : ℝ) • (fun t ↦ (aSel j.1 t : ℝ)) := by
    -- Cast the active rational remainder identity coordinatewise to `ℝ`.
    ext t
    have hcoordQ := congrFun hρ_active_eq t
    exact_mod_cast hcoordQ
  have hrow_sum :
      ∑ j : α,
        (Int.fract (coeffQ j.1) : ℝ) *
          (A *ᵥ fun t ↦ (aSel j.1 t : ℝ)) i = 0 := by
    -- Apply the active row to the positive active-generator expansion of `ρ`.
    calc
      ∑ j : α,
          (Int.fract (coeffQ j.1) : ℝ) *
            (A *ᵥ fun t ↦ (aSel j.1 t : ℝ)) i
          = (A *ᵥ
              (∑ j : α, (Int.fract (coeffQ j.1) : ℝ) •
                (fun t ↦ (aSel j.1 t : ℝ)))) i := by
                rw [Matrix.mulVec_sum]
                simp [Matrix.mulVec_smul, Pi.smul_apply]
      _ = (A *ᵥ fun t ↦ (ρ t : ℝ)) i := by rw [hρ_active_eq_real]
      _ = 0 := hi
  have hterm_nonpos :
      ∀ j : α,
        (Int.fract (coeffQ j.1) : ℝ) *
          (A *ᵥ fun t ↦ (aSel j.1 t : ℝ)) i ≤ 0 := by
    intro j
    have hgen_mem_C :
        (fun t ↦ (aSel j.1 t : ℝ)) ∈
          (PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) :
            Set (Fin n → ℝ)) := by
      -- Each active selected generator is one of the original ambient generators.
      rw [show (fun t ↦ (aSel j.1 t : ℝ)) = fun t ↦ (a (sel j.1) t : ℝ) by
            funext t
            simp [hSel_eq j.1]]
      exact Submodule.subset_span ⟨sel j.1, rfl⟩
    have hgen_mem_poly :
        (fun t ↦ (aSel j.1 t : ℝ)) ∈ polyhedron_le_set A 0 := by
      simpa [hC_eq] using hgen_mem_C
    have hrow_le :
        (A *ᵥ fun t ↦ (aSel j.1 t : ℝ)) i ≤ 0 := by
      simpa using hgen_mem_poly i
    have hfract_nonneg : 0 ≤ (Int.fract (coeffQ j.1) : ℝ) := by
      exact_mod_cast (le_of_lt j.2)
    exact mul_nonpos_of_nonneg_of_nonpos hfract_nonneg hrow_le
  have hneg_sum_zero :
      ∑ j : α,
        -((Int.fract (coeffQ j.1) : ℝ) *
          (A *ᵥ fun t ↦ (aSel j.1 t : ℝ)) i) = 0 := by
    -- Turn the nonpositive row evaluations into a nonnegative sum so `sum_eq_zero` applies.
    rw [Finset.sum_neg_distrib]
    linarith
  have hneg_term_zero :
      ∀ j : α,
        -((Int.fract (coeffQ j.1) : ℝ) *
          (A *ᵥ fun t ↦ (aSel j.1 t : ℝ)) i) = 0 := by
    -- Every nonnegative slack in that sum must vanish individually.
    have hzero_all :=
      (Finset.sum_eq_zero_iff_of_nonneg
        (fun j _ ↦ by
          have := hterm_nonpos j
          linarith)).mp hneg_sum_zero
    intro j
    exact hzero_all j (by simp)
  intro j
  have hprod_zero :
      (Int.fract (coeffQ j.1) : ℝ) *
        (A *ᵥ fun t ↦ (aSel j.1 t : ℝ)) i = 0 := by
    have hneg_zero := hneg_term_zero j
    linarith
  have hfract_pos : 0 < (Int.fract (coeffQ j.1) : ℝ) := by
    exact_mod_cast j.2
  -- Positive active coefficients force the corresponding row evaluation itself to vanish.
  exact (mul_eq_zero.mp hprod_zero).resolve_left hfract_pos.ne'

/-- Helper for Theorem 4.61: after presenting the ambient cone as `polyhedron_le_set A 0`, the
active selected cone lies in the active-constraint face cut out by the rows that are tight at the
remainder `ρ`. -/
lemma active_selected_real_hull_subset_active_constraint_face_at_remainder
    {q mA : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (A : Matrix (Fin mA) (Fin n) ℝ)
    (hC_eq :
      (PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) :
        Set (Fin n → ℝ)) = polyhedron_le_set A 0)
    (hSel_eq : ∀ j : Fin q, aSel j = a (sel j))
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ))) :
    let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
    let I : Set (Fin mA) := {i | (A *ᵥ fun t ↦ (ρ t : ℝ)) i = 0}
    let F : PointedCone ℝ (Fin n → ℝ) :=
      PointedCone.hull ℝ (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ))
    (F : Set (Fin n → ℝ)) ⊆ active_constraint_face A 0 I := by
  classical
  dsimp
  intro x hxF
  have hxC :
      x ∈
        (PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ)) :
          Set (Fin n → ℝ)) := by
    -- First enlarge the active selected cone back to the ambient cone.
    exact active_selected_real_hull_subset_ambient_real_hull a sel aSel coeffQ hSel_eq hxF
  have hxPoly : x ∈ polyhedron_le_set A 0 := by
    simpa [hC_eq] using hxC
  refine (mem_active_constraint_face_iff).2 ?_
  constructor
  · intro i hiI
    rcases (mem_hull_iff.mp hxF) with ⟨s, r, hr_mem, coeff, hcoeff_nonneg, rfl⟩
    -- Expand one active-cone witness of `x` and use rowwise vanishing of every active generator.
    have hr_zero :
        ∀ u : Fin s, (A *ᵥ r u) i = 0 := by
      intro u
      rcases hr_mem u with ⟨j, rfl⟩
      exact
        active_selected_generator_row_eq_zero_of_remainder_row_eq_zero
          a sel aSel coeffQ ρ A hC_eq hSel_eq hρ_active_eq hiI j
    calc
      (A *ᵥ ∑ u : Fin s, coeff u • r u) i
          = ∑ u : Fin s, coeff u * (A *ᵥ r u) i := by
              rw [Matrix.mulVec_sum]
              simp [Matrix.mulVec_smul, Pi.smul_apply]
      _ = 0 := by
            refine Finset.sum_eq_zero ?_
            intro u hu
            simp [hr_zero u]
  · intro i hiI
    -- Outside the active row set we only need ambient feasibility.
    exact hxPoly i

/-- Helper for Theorem 4.61: in one cone-hull witness of a point on an active-constraint face,
every generator with strictly positive coefficient lies on that same active face. -/
lemma ambient_support_generator_mem_active_constraint_face_of_active_point
    {mA s : ℕ}
    (A : Matrix (Fin mA) (Fin n) ℝ)
    {I : Set (Fin mA)}
    {r : Fin s → Fin n → ℝ}
    {x : Fin n → ℝ}
    {coeff : Fin s → ℝ}
    (hr_mem_poly : ∀ u : Fin s, r u ∈ polyhedron_le_set A 0)
    (hxFace : x ∈ active_constraint_face A 0 I)
    (hxEq :
      x = ∑ u : Fin s, coeff u • r u)
    (hcoeff_nonneg : ∀ u : Fin s, 0 ≤ coeff u) :
    ∀ u : Fin s, 0 < coeff u → r u ∈ active_constraint_face A 0 I := by
  intro u hu_pos
  refine (mem_active_constraint_face_iff).2 ?_
  constructor
  · intro i hiI
    have hx_row_zero : (A *ᵥ x) i = 0 := (mem_active_constraint_face_iff.mp hxFace).1 i hiI
    have hrow_sum :
        ∑ v : Fin s, coeff v * (A *ᵥ r v) i = 0 := by
      -- Evaluate the active row on the whole cone witness of `x`.
      calc
        ∑ v : Fin s, coeff v * (A *ᵥ r v) i
            = (A *ᵥ ∑ v : Fin s, coeff v • r v) i := by
                rw [Matrix.mulVec_sum]
                simp [Matrix.mulVec_smul, Pi.smul_apply]
        _ = (A *ᵥ x) i := by rw [hxEq]
        _ = 0 := hx_row_zero
    have hterm_nonpos :
        ∀ v : Fin s, coeff v * (A *ᵥ r v) i ≤ 0 := by
      intro v
      have hrow_le : (A *ᵥ r v) i ≤ 0 := by
        simpa using hr_mem_poly v i
      exact mul_nonpos_of_nonneg_of_nonpos (hcoeff_nonneg v) hrow_le
    have hneg_sum_zero :
        ∑ v : Fin s, -(coeff v * (A *ᵥ r v) i) = 0 := by
      rw [Finset.sum_neg_distrib]
      linarith
    have hneg_term_zero :
        ∀ v : Fin s, -(coeff v * (A *ᵥ r v) i) = 0 := by
      -- Nonpositive row contributions with total sum `0` must vanish one by one.
      have hzero_all :=
        (Finset.sum_eq_zero_iff_of_nonneg
          (fun v _hv ↦ by
            have := hterm_nonpos v
            linarith)).mp hneg_sum_zero
      intro v
      exact hzero_all v (by simp)
    have hprod_zero : coeff u * (A *ᵥ r u) i = 0 := by
      have hu_zero := hneg_term_zero u
      linarith
    -- Strict positivity of the chosen coefficient isolates the generator's row value.
    exact (mul_eq_zero.mp hprod_zero).resolve_left hu_pos.ne'
  · intro i hiI
    -- On inactive rows, the chosen generator is already feasible for the ambient cone system.
    exact hr_mem_poly u i

/-- Helper for Theorem 4.61: an extreme subcone contains both summands of any decomposition of a
point it already contains. -/
lemma active_selected_face_contains_decomposition_summands
    {F C : PointedCone ℝ (Fin n → ℝ)}
    {ρ y : Fin n → ℝ}
    (hF_extreme : IsExtreme ℝ (C : Set (Fin n → ℝ)) (F : Set (Fin n → ℝ)))
    (hρ_mem_F : ρ ∈ (F : Set (Fin n → ℝ)))
    (hy_mem_C : y ∈ (C : Set (Fin n → ℝ)))
    (hsub_mem_C : ρ - y ∈ (C : Set (Fin n → ℝ))) :
    y ∈ (F : Set (Fin n → ℝ)) ∧
      ρ - y ∈ (F : Set (Fin n → ℝ)) := by
  have hmid_mem_F : midpoint ℝ y (ρ - y) ∈ (F : Set (Fin n → ℝ)) := by
    -- Scale the face point `ρ` by `1 / 2` so it matches the midpoint of the two summands.
    have hhalf_mem_F : (1 / 2 : ℝ) • ρ ∈ (F : Set (Fin n → ℝ)) :=
      F.smul_mem (by norm_num) hρ_mem_F
    simpa [midpoint_eq_smul_add, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
      hhalf_mem_F
  have hmid_open :
      midpoint ℝ y (ρ - y) ∈ openSegment ℝ y (ρ - y) :=
    midpoint_mem_openSegment (𝕜 := ℝ) y (ρ - y)
  refine ⟨?_, ?_⟩
  · -- Extremality of `F` pushes the midpoint membership back to the left summand.
    exact hF_extreme.left_mem_of_mem_openSegment hy_mem_C hsub_mem_C hmid_mem_F hmid_open
  · -- The same midpoint argument also recovers the right summand.
    exact hF_extreme.right_mem_of_mem_openSegment hy_mem_C hsub_mem_C hmid_mem_F hmid_open

/-- Helper for Theorem 4.61: the active selected cone should be realized as the active-constraint
face of one polyhedral presentation of the ambient cone at the remainder `ρ`, hence it is exposed
in the ambient cone. -/
lemma active_selected_real_hull_isExposed_in_ambient
    {q : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (h_pointed :
      ((PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun j ↦ (a i j : ℝ)) :
        ConvexCone ℝ (Fin n → ℝ))).Salient)
    (hSel_lin : LinearIndependent ℝ (fun j : Fin q ↦ fun t ↦ (aSel j t : ℝ)))
    (hSel_eq : ∀ j : Fin q, aSel j = a (sel j))
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ))) :
    let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
    let F : PointedCone ℝ (Fin n → ℝ) :=
      PointedCone.hull ℝ (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ))
    let C : PointedCone ℝ (Fin n → ℝ) :=
      PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ))
    IsExposed ℝ (C : Set (Fin n → ℝ)) (F : Set (Fin n → ℝ)) := by
  classical
  dsimp
  have hF_polyhedral_salient :
      is_polyhedral_cone (F : Set (Fin n → ℝ)) ∧
        ((F : ConvexCone ℝ (Fin n → ℝ))).Salient := by
    -- Keep the stable finite-generation and salience data available for the later face
    -- identification step.
    simpa [α, F] using
      active_selected_real_hull_polyhedral_salient a sel aSel coeffQ h_pointed hSel_eq
  have hρ_mem_F :
      (fun t ↦ (ρ t : ℝ)) ∈ (F : Set (Fin n → ℝ)) := by
    -- The remainder itself already lies in the active selected cone.
    simpa [α, F] using active_remainder_mem_selected_real_hull aSel coeffQ ρ hρ_active_eq
  have hC_fg : C.FG := by
    -- The ambient cone is also finitely generated because the Hilbert-basis family is finite.
    simpa [C] using
      Submodule.fg_span
        (Set.finite_range (fun i : Fin k ↦ fun t ↦ (a i t : ℝ)))
  have hC_polyhedral : is_polyhedral_cone (C : Set (Fin n → ℝ)) := by
    -- Convert finite generation to the Chapter 4 polyhedral-cone presentation API.
    exact (Theorem442Local.isFinitelyGeneratedCone_iff_isPolyhedralCone (C := C)).mp hC_fg
  rcases (is_polyhedral_cone_iff.mp hC_polyhedral) with ⟨mA, A, hC_eq⟩
  let I : Set (Fin mA) := {i | (A *ᵥ fun t ↦ (ρ t : ℝ)) i = 0}
  have hF_subset_face :
      (F : Set (Fin n → ℝ)) ⊆ active_constraint_face A 0 I := by
    -- The forward inclusion is already encoded by the active-row vanishing lemma for `ρ`.
    simpa [I] using
      active_selected_real_hull_subset_active_constraint_face_at_remainder
        a sel aSel coeffQ ρ A hC_eq hSel_eq hρ_active_eq
  have hface_subset_F :
      active_constraint_face A 0 I ⊆ (F : Set (Fin n → ℝ)) := by
    intro x hxFace
    have hxPoly : x ∈ polyhedron_le_set A 0 :=
      mem_polyhedron_of_mem_active_constraint_face hxFace
    have hxC : x ∈ (C : Set (Fin n → ℝ)) := by
      simpa [hC_eq] using hxPoly
    rcases (mem_hull_iff.mp hxC) with ⟨s, r, hr_mem, coeff, hcoeff_nonneg, hxEq⟩
    have hr_mem_poly : ∀ u : Fin s, r u ∈ polyhedron_le_set A 0 := by
      intro u
      simpa [hC_eq] using hr_mem u
    have hsupport_face :
        ∀ u : Fin s, 0 < coeff u → r u ∈ active_constraint_face A 0 I := by
      -- Positive-support generators inherit the active rows of `x`.
      exact
        ambient_support_generator_mem_active_constraint_face_of_active_point
          A hr_mem_poly hxFace hxEq hcoeff_nonneg
    have hsupport_mem_F :
        ∀ u : Fin s, 0 < coeff u → r u ∈ (F : Set (Fin n → ℝ)) := by
      intro u hu
      rcases hr_mem u with ⟨j, rfl⟩
      -- Route correction: the reverse inclusion is reduced to the single-generator source step.
      -- TODO: show that any ambient generator lying in `active_constraint_face A 0 I` already
      -- belongs to `F`, using the selected active family around the remainder `ρ`.
      sorry
    have hterm_mem :
        ∀ u : Fin s, coeff u • r u ∈ (F : Set (Fin n → ℝ)) := by
      intro u
      by_cases hu : 0 < coeff u
      · exact F.smul_mem (hcoeff_nonneg u) (hsupport_mem_F u hu)
      · have hcoeff_zero : coeff u = 0 := le_antisymm (hcoeff_nonneg u) (le_of_not_gt hu)
        simpa [hcoeff_zero] using (F.zero_mem : (0 : Fin n → ℝ) ∈ (F : Set (Fin n → ℝ)))
    -- Once every positive-support term lands in `F`, the whole cone combination lands in `F`.
    have hsum_mem : (∑ u : Fin s, coeff u • r u) ∈ (F : Set (Fin n → ℝ)) := by
      exact Finset.sum_mem fun u _hu ↦ hterm_mem u
    simpa [hxEq] using hsum_mem
  have hF_eq : (F : Set (Fin n → ℝ)) = active_constraint_face A 0 I := by
    exact Set.Subset.antisymm hF_subset_face hface_subset_F
  let _ := hSel_lin
  let _ := hF_polyhedral_salient
  let _ := hρ_mem_F
  -- Route correction: only the single-generator reverse-inclusion bridge remains; once that
  -- source-facing step is proved, `active_constraint_face_isExposed` closes the exposed-face claim.
  simpa [hC_eq, hF_eq] using active_constraint_face_isExposed A (0 : Fin mA → ℝ) I

/-- Helper for Theorem 4.61: once the exposed-face localization step succeeds, each support atom
of the minimal remainder witness and its residual complement both lie in the active selected face. -/
lemma support_atom_and_remainder_mem_active_face_of_minimal_remainder
    {q m : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (h_hilbert : IsHilbertBasisFamily a)
    (h_pointed :
      ((PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun j ↦ (a i j : ℝ)) :
        ConvexCone ℝ (Fin n → ℝ))).Salient)
    (hSel_lin : LinearIndependent ℝ (fun j : Fin q ↦ fun t ↦ (aSel j t : ℝ)))
    (hSel_eq : ∀ j : Fin q, aSel j = a (sel j))
    {ν : Fin k →₀ ℕ}
    (hρ_int : ρ = ν.sum (fun j c ↦ c • a j))
    (hν_min :
      ∀ ν' : Fin k →₀ ℕ,
        ρ = ν'.sum (fun j c ↦ c • a j) →
          ν.support.card ≤ ν'.support.card)
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ)))
    {eν : Fin m ≃ ν.support} :
    ∀ s : Fin m,
      ((fun t ↦ (a (eν s).1 t : ℝ)) ∈
        (PointedCone.hull ℝ
          (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
            fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ))) ∧
        (((fun t ↦ (ρ t : ℝ)) - fun t ↦ (a (eν s).1 t : ℝ)) ∈
          (PointedCone.hull ℝ
            (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
              fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ))) := by
  intro s
  let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
  let F : PointedCone ℝ (Fin n → ℝ) :=
    PointedCone.hull ℝ (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ))
  let C : PointedCone ℝ (Fin n → ℝ) :=
    PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℝ))
  have hF_polyhedral_salient :
      is_polyhedral_cone (F : Set (Fin n → ℝ)) ∧
        ((F : ConvexCone ℝ (Fin n → ℝ))).Salient := by
    -- Record the stable cone data that the exposed-face argument will need later.
    simpa [α, F] using
      active_selected_real_hull_polyhedral_salient a sel aSel coeffQ h_pointed hSel_eq
  have hρ_mem_F :
      (fun t ↦ (ρ t : ℝ)) ∈ (F : Set (Fin n → ℝ)) := by
    -- The active remainder identity places `ρ` in the active selected cone.
    simpa [α, F] using active_remainder_mem_selected_real_hull aSel coeffQ ρ hρ_active_eq
  have hρ_mem_C :
      (fun t ↦ (ρ t : ℝ)) ∈ (C : Set (Fin n → ℝ)) := by
    -- The active cone is a subcone of the ambient Hilbert-basis cone.
    simpa [C] using
      active_selected_real_hull_subset_ambient_real_hull a sel aSel coeffQ hSel_eq hρ_mem_F
  have hatom_mem_C :
      (fun t ↦ (a (eν s).1 t : ℝ)) ∈ (C : Set (Fin n → ℝ)) := by
    -- Each support atom is itself an ambient generator.
    simpa [C] using support_atom_mem_ambient_real_hull a eν s
  have hρ_minus_atom_mem_C :
      ((fun t ↦ (ρ t : ℝ)) - fun t ↦ (a (eν s).1 t : ℝ)) ∈ (C : Set (Fin n → ℝ)) := by
    -- Deleting one support atom from the minimal witness keeps the residual point in the ambient
    -- cone, so the decomposition `ρ = atom + (ρ - atom)` is entirely inside `C`.
    simpa [C, Pi.sub_apply] using support_remainder_mem_ambient_real_hull a ρ hρ_int eν s
  have hF_extreme : IsExtreme ℝ (C : Set (Fin n → ℝ)) (F : Set (Fin n → ℝ)) := by
    -- Route correction: first obtain the exposed-face certificate for the active cone, then use
    -- the canonical `IsExposed.isExtreme` bridge instead of reproving extremality by hand.
    exact
      (active_selected_real_hull_isExposed_in_ambient
        a sel aSel coeffQ ρ h_pointed hSel_lin hSel_eq hρ_active_eq).isExtreme
  let _ := h_hilbert
  let _ := hSel_lin
  let _ := hρ_int
  let _ := hν_min
  let _ := hF_polyhedral_salient
  let _ := hρ_mem_C
  exact
    active_selected_face_contains_decomposition_summands
      (F := F) (C := C) hF_extreme hρ_mem_F hatom_mem_C hρ_minus_atom_mem_C

/-- Helper for Theorem 4.61: projecting the paired exposed-face localization recovers the
source-facing statement that each support atom lies in the active selected cone. -/
lemma support_atom_mem_active_face_of_minimal_remainder
    {q m : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (h_hilbert : IsHilbertBasisFamily a)
    (h_pointed :
      ((PointedCone.hull ℝ (Set.range fun i : Fin k ↦ fun j ↦ (a i j : ℝ)) :
        ConvexCone ℝ (Fin n → ℝ))).Salient)
    (hSel_lin : LinearIndependent ℝ (fun j : Fin q ↦ fun t ↦ (aSel j t : ℝ)))
    (hSel_eq : ∀ j : Fin q, aSel j = a (sel j))
    {ν : Fin k →₀ ℕ}
    (hρ_int : ρ = ν.sum (fun j c ↦ c • a j))
    (hν_min :
      ∀ ν' : Fin k →₀ ℕ,
        ρ = ν'.sum (fun j c ↦ c • a j) →
          ν.support.card ≤ ν'.support.card)
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ)))
    {eν : Fin m ≃ ν.support} :
    ∀ s : Fin m,
      (fun t ↦ (a (eν s).1 t : ℝ)) ∈
        (PointedCone.hull ℝ
          (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
            fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ)) := by
  intro s
  exact
    (support_atom_and_remainder_mem_active_face_of_minimal_remainder
      a sel aSel coeffQ ρ h_hilbert h_pointed hSel_lin hSel_eq hρ_int hν_min hρ_active_eq
      (eν := eν) s).1

/-- Helper for Theorem 4.61: if an integral point and its complement inside the active remainder
both lie in the active selected cone, then the point has active rational coordinates bounded by the
positive fractional remainder coefficients. -/
lemma active_face_integral_coordinates_lt_one
    {q : ℕ}
    (aSel : Fin q → Fin n → ℤ)
    (coeffQ : Fin q → ℚ)
    (ρ y : Fin n → ℤ)
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ)))
    (hα_lin_rat :
      LinearIndependent ℚ
        (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ fun t ↦ (aSel j.1 t : ℚ)))
    (hy_mem_F :
      (fun t ↦ (y t : ℝ)) ∈
        (PointedCone.hull ℝ
          (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
            fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ)))
    (hsub_mem_F :
      ((fun t ↦ (ρ t : ℝ)) - fun t ↦ (y t : ℝ)) ∈
        (PointedCone.hull ℝ
          (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
            fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ))) :
    ∃ gamma : {j : Fin q // 0 < Int.fract (coeffQ j)} → ℚ,
      (∀ j, 0 ≤ gamma j) ∧
        (∀ j, gamma j < 1) ∧
          (fun t ↦ (y t : ℚ)) =
            ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
              gamma j • (fun t ↦ (aSel j.1 t : ℚ)) := by
  classical
  let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
  let activeFamily : α → Fin n → ℚ := fun j ↦ fun t ↦ (aSel j.1 t : ℚ)
  have hy_mem_F_rat :
      (fun t ↦ (y t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range activeFamily) : Set (Fin n → ℚ)) := by
    -- Rationalize the active-face membership of `y` so the coordinate comparison stays over `ℚ`.
    simpa [α, activeFamily] using
      integral_point_mem_rational_hull_of_mem_real_hull_fintype
        (r := fun j : α ↦ aSel j.1)
        (z := y)
        hy_mem_F
  obtain ⟨gamma, hgamma_nonneg, hgamma_eq⟩ :=
    exists_nonnegative_coefficient_function_of_mem_hull activeFamily hy_mem_F_rat
  have hsub_mem_F_rat :
      (fun t ↦ ((ρ - y) t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range activeFamily) : Set (Fin n → ℚ)) := by
    -- Rationalize the complementary active-face membership on the integral residual vector
    -- `ρ - y`.
    simpa [α, activeFamily] using
      integral_point_mem_rational_hull_of_mem_real_hull_fintype
        (r := fun j : α ↦ aSel j.1)
        (z := ρ - y)
        hsub_mem_F
  obtain ⟨delta, hdelta_nonneg, hdelta_eq⟩ :=
    exists_nonnegative_coefficient_function_of_mem_hull activeFamily hsub_mem_F_rat
  have hcoeff_eq :
      ∀ j : α, gamma j + delta j = Int.fract (coeffQ j.1) := by
    -- Route correction: compare the two active-coordinate decompositions of `ρ` through the
    -- integral split `ρ = y + (ρ - y)` instead of trying to bound `gamma` directly.
    refine (Fintype.linearIndependent_iff.mp hα_lin_rat)
      (fun j ↦ gamma j + delta j)
      (fun j ↦ Int.fract (coeffQ j.1))
      ?_
    calc
      ∑ j : α, (gamma j + delta j) • activeFamily j
          = (∑ j : α, gamma j • activeFamily j) +
              ∑ j : α, delta j • activeFamily j := by
                ext t
                simp [activeFamily, Pi.smul_apply, add_mul, Finset.sum_add_distrib]
      _ = (fun t ↦ (y t : ℚ)) + fun t ↦ ((ρ - y) t : ℚ) := by
            rw [hgamma_eq, hdelta_eq]
      _ = fun t ↦ (ρ t : ℚ) := by
            ext t
            simp
      _ =
          ∑ j : α, Int.fract (coeffQ j.1) • activeFamily j := by
            simpa [α, activeFamily] using hρ_active_eq
  refine ⟨gamma, hgamma_nonneg, ?_, ?_⟩
  · -- Each coordinate of `gamma` is bounded above by the corresponding fractional remainder
    -- coefficient because the complementary coordinates `delta` are nonnegative.
    intro j
    have hfract_lt_one : Int.fract (coeffQ j.1) < 1 := Int.fract_lt_one (coeffQ j.1)
    have hgamma_le_fract : gamma j ≤ Int.fract (coeffQ j.1) := by
      linarith [hdelta_nonneg j, hcoeff_eq j]
    exact lt_of_le_of_lt hgamma_le_fract hfract_lt_one
  · -- Return the rational active-coordinate representation for `y`.
    exact hgamma_eq

/-- Helper for Theorem 4.61: after localizing a support atom and its residual complement to the
active face, the remaining source-faithful step is to show the atom lies on the height-one simplex
slice spanned by the active selected generators. -/
lemma support_atom_active_coordinates_lt_one
    {q m : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    {ν : Fin k →₀ ℕ}
    {eν : Fin m ≃ ν.support}
    (hα_lin_rat :
      LinearIndependent ℚ
        (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ fun t ↦ (a (sel j.1) t : ℚ)))
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (a (sel j.1) t : ℚ)))
    (hsupport_atom_active_real_hull :
      ∀ s : Fin m,
        (fun t ↦ (a (eν s).1 t : ℝ)) ∈
          (PointedCone.hull ℝ
            (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
              fun t ↦ (a (sel j.1) t : ℝ)) : Set (Fin n → ℝ)))
    (hsupport_remainder_active_real_hull :
      ∀ s : Fin m,
        ((fun t ↦ (ρ t : ℝ)) - fun t ↦ (a (eν s).1 t : ℝ)) ∈
          (PointedCone.hull ℝ
            (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
              fun t ↦ (a (sel j.1) t : ℝ)) : Set (Fin n → ℝ))) :
    ∀ s : Fin m,
      ∃ gamma : {j : Fin q // 0 < Int.fract (coeffQ j)} → ℚ,
        (∀ j, 0 ≤ gamma j) ∧
          (∀ j, gamma j < 1) ∧
            (fun t ↦ (a (eν s).1 t : ℚ)) =
              ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
                gamma j • (fun t ↦ (a (sel j.1) t : ℚ)) := by
  intro s
  -- Specialize the active-face coordinate extraction to the support atom indexed by `s`.
  simpa using
    active_face_integral_coordinates_lt_one
      (aSel := fun j : Fin q ↦ a (sel j))
      (coeffQ := coeffQ)
      (ρ := ρ)
      (y := a (eν s).1)
      hρ_active_eq
      hα_lin_rat
      (hsupport_atom_active_real_hull s)
      (hsupport_remainder_active_real_hull s)

/-- Helper for Theorem 4.61: once a support atom has a nonnegative active coordinate row of total
mass `1`, it lies in the active simplex slice, hence in the active convex hull. -/
lemma mem_active_convexHull_of_barycentric_coordinates
    {q : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (coeffQ : Fin q → ℚ)
    {y : Fin n → ℤ}
    (gamma : {j : Fin q // 0 < Int.fract (coeffQ j)} → ℚ)
    (hgamma_nonneg :
      ∀ j : {j : Fin q // 0 < Int.fract (coeffQ j)}, 0 ≤ gamma j)
    (hgamma_sum :
      ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)}, gamma j = 1)
    (hgamma_eq :
      (fun t ↦ (y t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          gamma j • (fun t ↦ (a (sel j.1) t : ℚ))) :
    (fun t ↦ (y t : ℝ)) ∈
      convexHull ℝ
        (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
          fun t ↦ (a (sel j.1) t : ℝ)) := by
  -- Package the rational barycentric row as a real convex-combination witness.
  refine
    mem_convexHull_of_exists_fintype
      (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ (gamma j : ℝ))
      (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
        fun t ↦ (a (sel j.1) t : ℝ))
      ?_
      ?_
      ?_
      ?_
  · intro j
    exact_mod_cast hgamma_nonneg j
  · exact_mod_cast hgamma_sum
  · intro j
    exact ⟨j, rfl⟩
  · ext t
    have hcoordQ := congrFun hgamma_eq t
    exact_mod_cast hcoordQ

/-- Helper for Theorem 4.61: the active coordinate row extracted from one support atom must have
total mass `1`, because otherwise replacing that atom inside the minimal remainder witness would
contradict support minimality. -/
lemma support_atom_active_coordinates_sum_one_of_minimality
    {q m : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (h_hilbert : IsHilbertBasisFamily a)
    {ν : Fin k →₀ ℕ}
    (hρ_int : ρ = ν.sum (fun j c ↦ c • a j))
    (hν_min :
      ∀ ν' : Fin k →₀ ℕ,
        ρ = ν'.sum (fun j c ↦ c • a j) →
          ν.support.card ≤ ν'.support.card)
    {eν : Fin m ≃ ν.support}
    {s : Fin m}
    (gamma : {j : Fin q // 0 < Int.fract (coeffQ j)} → ℚ)
    (hgamma_nonneg :
      ∀ j : {j : Fin q // 0 < Int.fract (coeffQ j)}, 0 ≤ gamma j)
    (hgamma_lt_one :
      ∀ j : {j : Fin q // 0 < Int.fract (coeffQ j)}, gamma j < 1)
    (hgamma_eq :
      (fun t ↦ (a (eν s).1 t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          gamma j • (fun t ↦ (a (sel j.1) t : ℚ))) :
    ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)}, gamma j = 1 := by
  let _ := h_hilbert
  let _ := hρ_int
  let _ := hν_min
  let _ := hgamma_nonneg
  let _ := hgamma_lt_one
  -- Route correction: keep the replacement-witness comparison as its own lemma instead of hiding
  -- it inside the convex-hull wrapper.
  -- TODO: convert `hgamma_eq` into a Hilbert-basis witness for the support atom `a (eν s).1`,
  -- replace one copy of that atom inside `ν`, and use `hν_min` to force the barycentric mass to
  -- be exactly `1`.
  sorry

/-- Helper for Theorem 4.61: after localizing a support atom and its residual complement to the
active face, the remaining source-faithful step is to show the atom lies on the height-one simplex
slice spanned by the active selected generators. -/
lemma support_atom_mem_active_convex_hull
    {q m : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (h_hilbert : IsHilbertBasisFamily a)
    {ν : Fin k →₀ ℕ}
    (hρ_int : ρ = ν.sum (fun j c ↦ c • a j))
    (hν_min :
      ∀ ν' : Fin k →₀ ℕ,
        ρ = ν'.sum (fun j c ↦ c • a j) →
          ν.support.card ≤ ν'.support.card)
    {eν : Fin m ≃ ν.support}
    (hα_lin_rat :
      LinearIndependent ℚ
        (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ fun t ↦ (a (sel j.1) t : ℚ)))
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (a (sel j.1) t : ℚ)))
    (hsupport_atom_active_real_hull :
      ∀ s : Fin m,
        (fun t ↦ (a (eν s).1 t : ℝ)) ∈
          (PointedCone.hull ℝ
            (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
              fun t ↦ (a (sel j.1) t : ℝ)) : Set (Fin n → ℝ)))
    (hsupport_remainder_active_real_hull :
      ∀ s : Fin m,
        ((fun t ↦ (ρ t : ℝ)) - fun t ↦ (a (eν s).1 t : ℝ)) ∈
          (PointedCone.hull ℝ
            (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
              fun t ↦ (a (sel j.1) t : ℝ)) : Set (Fin n → ℝ))) :
    ∀ s : Fin m,
      (fun t ↦ (a (eν s).1 t : ℝ)) ∈
        convexHull ℝ
          (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
            fun t ↦ (a (sel j.1) t : ℝ)) := by
  intro s
  obtain ⟨gamma, hgamma_nonneg, hgamma_lt_one, hgamma_eq⟩ :=
    support_atom_active_coordinates_lt_one
      a sel coeffQ ρ
      (eν := eν)
      hα_lin_rat hρ_active_eq
      hsupport_atom_active_real_hull
      hsupport_remainder_active_real_hull
      s
  have hgamma_sum :
      ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)}, gamma j = 1 := by
    -- The simplex-slice wrapper now only calls the dedicated support-minimality mass lemma.
    exact
      support_atom_active_coordinates_sum_one_of_minimality
        a sel coeffQ ρ h_hilbert hρ_int hν_min
        (eν := eν) (s := s) gamma hgamma_nonneg hgamma_lt_one hgamma_eq
  -- Once the active row has total mass `1`, it is a barycentric row on the active simplex slice.
  exact
    mem_active_convexHull_of_barycentric_coordinates
      (a := a)
      (sel := sel)
      (coeffQ := coeffQ)
      (y := a (eν s).1)
      (gamma := gamma)
      hgamma_nonneg
      hgamma_sum
      hgamma_eq

/-- Helper for Theorem 4.61: after localizing all support atoms to the active cone, support
minimality must force every active coordinate row to sum to `1`. -/
lemma active_rows_sum_one_of_support_minimality
    {q m : ℕ}
    (a : Fin k → Fin n → ℤ)
    (sel : Fin q → Fin k)
    (coeffQ : Fin q → ℚ)
    (ρ : Fin n → ℤ)
    (h_hilbert : IsHilbertBasisFamily a)
    {ν : Fin k →₀ ℕ}
    (hρ_int : ρ = ν.sum (fun j c ↦ c • a j))
    (hν_min :
      ∀ ν' : Fin k →₀ ℕ,
        ρ = ν'.sum (fun j c ↦ c • a j) →
          ν.support.card ≤ ν'.support.card)
    (hρ_active_eq :
      (fun t ↦ (ρ t : ℚ)) =
        ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          Int.fract (coeffQ j.1) • (fun t ↦ (a (sel j.1) t : ℚ)))
    {eν : Fin m ≃ ν.support}
    (gamma : Fin m → {j : Fin q // 0 < Int.fract (coeffQ j)} → ℚ)
    (hgamma_nonneg : ∀ s : Fin m, ∀ j : {j : Fin q // 0 < Int.fract (coeffQ j)}, 0 ≤ gamma s j)
    (hα_lin_rat :
      LinearIndependent ℚ
        (fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ fun t ↦ (a (sel j.1) t : ℚ)))
    (hsupport_atom_active_convex :
      ∀ s : Fin m,
        (fun t ↦ (a (eν s).1 t : ℝ)) ∈
          convexHull ℝ
            (Set.range fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦
              fun t ↦ (a (sel j.1) t : ℝ)))
    (hgamma_eq :
      ∀ s : Fin m,
        (fun t ↦ (a (eν s).1 t : ℚ)) =
          ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
            gamma s j • (fun t ↦ (a (sel j.1) t : ℚ)))
    (hweighted :
      ∀ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
        ∑ s : Fin m, (ν (eν s).1 : ℚ) * gamma s j = Int.fract (coeffQ j.1)) :
    ∀ s : Fin m, ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)}, gamma s j = 1 := by
  intro s
  obtain ⟨gammaBar, hgammaBar_nonneg, hgammaBar_sum, hgammaBar_eq⟩ :=
    rational_barycentric_coordinates_of_integral_mem_convexHull
      (v := fun j : {j : Fin q // 0 < Int.fract (coeffQ j)} ↦ a (sel j.1))
      (z := a (eν s).1)
      (hsupport_atom_active_convex s)
  have hgamma_eq_bar : gamma s = gammaBar := by
    -- Compare the existing active-coordinate row with the barycentric row by rational linear
    -- independence of the active selected family.
    refine (Fintype.linearIndependent_iffₛ.mp hα_lin_rat) (gamma s) gammaBar ?_
    calc
      ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
          gamma s j • (fun t ↦ (a (sel j.1) t : ℚ))
          = (fun t ↦ (a (eν s).1 t : ℚ)) := hgamma_eq s
      _ =
          ∑ j : {j : Fin q // 0 < Int.fract (coeffQ j)},
            gammaBar j • (fun t ↦ (a (sel j.1) t : ℚ)) := hgammaBar_eq
  have _ := hgammaBar_nonneg
  have _ := h_hilbert
  have _ := hρ_int
  have _ := hν_min
  have _ := hρ_active_eq
  have _ := hgamma_nonneg
  have _ := hweighted
  simpa [hgamma_eq_bar] using hgammaBar_sum

/-- Theorem 4.61. Let `a 0, ..., a (k - 1) ∈ ℤ^n` form a Hilbert basis and let
`cone(a 0, ..., a (k - 1))` be pointed. Then every integral vector in this cone can be written as
a conic combination with integral coefficients supported on at most `2n - 1` vectors among
`a 0, ..., a (k - 1)`. -/
theorem exists_bounded_integral_conic_combination_of_hilbert_basis
    (a : Fin k → Fin n → ℤ)
    (h_hilbert : IsHilbertBasisFamily a)
    (h_pointed :
      ((PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) :
        ConvexCone ℝ (Fin n → ℝ))).Salient)
    {x : Fin n → ℤ}
    (hx :
      (fun i ↦ (x i : ℝ)) ∈
        (PointedCone.hull ℝ (Set.range fun i ↦ fun j ↦ (a i j : ℝ)) :
          Set (Fin n → ℝ))) :
    ∃ μ : Fin k →₀ ℕ,
      μ.support.card ≤ 2 * n - 1 ∧
        x = μ.sum (fun j c ↦ c • a j) := by
  classical
  -- Route correction: rebuild the Sebo setup only up to the first genuine missing step. The
  -- selected Carathéodory family and the integral half-open-box remainder are now explicit.
  rcases exists_linearIndependent_conicCombination_of_mem_hull hx with
    ⟨q, r, hr_mem, hr_lin, hq_le, coeffR, hcoeffR_nonneg, hxR_eq⟩
  let idx : Fin q → Fin k := fun j ↦ Classical.choose (hr_mem j)
  let aSel : Fin q → Fin n → ℤ := fun j ↦ a (idx j)
  have hidx : ∀ j : Fin q, r j = fun t ↦ (aSel j t : ℝ) := by
    intro j
    exact (Classical.choose_spec (hr_mem j)).symm
  have hx_sel_real :
      (fun t ↦ (x t : ℝ)) ∈
        (PointedCone.hull ℝ (Set.range fun j : Fin q ↦ fun t ↦ (aSel j t : ℝ)) :
          Set (Fin n → ℝ)) := by
    -- Repackage Carathéodory's selected family as a real cone witness over `aSel`.
    refine (mem_hull_iff).2 ?_
    refine ⟨q, (fun j : Fin q ↦ fun t ↦ (aSel j t : ℝ)), ?_, coeffR, hcoeffR_nonneg, ?_⟩
    · intro j
      exact ⟨j, rfl⟩
    · simpa [aSel, hidx] using hxR_eq
  have hx_sel_rat :
      (fun t ↦ (x t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun j : Fin q ↦ fun t ↦ (aSel j t : ℚ)) :
          Set (Fin n → ℚ)) :=
    integral_point_mem_rational_hull_of_mem_real_hull hx_sel_real
  obtain ⟨coeffQ, μSel0, ρ, hcoeffQ_nonneg, hx_split, hρ_eq, hfract_nonneg, hfract_lt_one⟩ :=
    exists_half_open_box_remainder_of_integral_cone_point aSel hx_sel_rat
  have hρ_sel_rat :
      (fun t ↦ (ρ t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun j : Fin q ↦ fun t ↦ (aSel j t : ℚ)) :
          Set (Fin n → ℚ)) := by
    -- The fractional remainder still lies in the selected cone.
    refine mem_hull_of_equivFin_nonnegative_family
      (fun j : Fin q ↦ fun t ↦ (aSel j t : ℚ))
      (fun j ↦ Int.fract (coeffQ j))
      (fun t ↦ (ρ t : ℚ))
      (fun j ↦ hfract_nonneg j)
      ?_
    simpa using hρ_eq
  have hsel_subset :
      Set.range (fun j : Fin q ↦ fun t ↦ (aSel j t : ℚ)) ⊆
        Set.range (fun i : Fin k ↦ fun t ↦ (a i t : ℚ)) := by
    rintro y ⟨j, rfl⟩
    exact ⟨idx j, rfl⟩
  have hρ_rat :
      (fun t ↦ (ρ t : ℚ)) ∈
        (PointedCone.hull ℚ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℚ)) :
          Set (Fin n → ℚ)) := by
    -- Enlarge the selected remainder witness back to the original Hilbert basis family.
    exact (show
        (PointedCone.hull ℚ (Set.range fun j : Fin q ↦ fun t ↦ (aSel j t : ℚ)) :
          Set (Fin n → ℚ)) ⊆
          (PointedCone.hull ℚ (Set.range fun i : Fin k ↦ fun t ↦ (a i t : ℚ)) :
            Set (Fin n → ℚ)) from
        Submodule.span_mono hsel_subset) hρ_sel_rat
  obtain ⟨ν, hρ_int, hν_min⟩ :=
    exists_support_minimal_remainder_hilbert_witness a h_hilbert ρ hρ_rat
  have hidx_injective : Function.Injective idx := by
    intro i j hij
    apply hr_lin.injective
    calc
      r i = fun t ↦ (aSel i t : ℝ) := hidx i
      _ = fun t ↦ (aSel j t : ℝ) := by simp [aSel, hij]
      _ = r j := (hidx j).symm
  have hq_le_n : q ≤ n := by
    calc
      q ≤ Module.finrank ℝ (Submodule.span ℝ (Set.range r)) := hq_le
      _ ≤ Module.finrank ℝ (Fin n → ℝ) := Submodule.finrank_le _
      _ = n := by simp
  let μSel : Fin k →₀ ℕ := μSel0.mapDomain idx
  have hμSel_sum :
      μSel.sum (fun i c ↦ c • a i) =
        μSel0.sum (fun j c ↦ c • aSel j) := by
    -- Reindex the floor part from the selected family back to the original Hilbert basis family.
    simpa [μSel, aSel, Finsupp.linearCombination_apply] using
      (Finsupp.linearCombination_mapDomain (R := ℕ) (v' := a) idx μSel0)
  have hμSel_card :
      μSel.support.card = μSel0.support.card := by
    -- Injectivity of the selected index map preserves the exact support size of the floor part.
    have hsupport :
        (μSel0.mapDomain idx).support = μSel0.support.image idx :=
      Finsupp.mapDomain_support_of_injective hidx_injective μSel0
    calc
      μSel.support.card = (μSel0.support.image idx).card := by simpa [μSel] using congrArg Finset.card hsupport
      _ = μSel0.support.card := Finset.card_image_of_injective _ hidx_injective
  have hμSel0_card : μSel0.support.card ≤ q := by
    simpa using μSel0.support.card_le_univ
  by_cases hν_small : ν.support.card ≤ n - 1
  · let μ : Fin k →₀ ℕ := μSel + ν
    have hμ_sum :
        μ.sum (fun j c ↦ c • a j) =
          μSel.sum (fun j c ↦ c • a j) + ν.sum (fun j c ↦ c • a j) := by
      -- The recombined witness splits as the sum of the lifted floor part and the remainder part.
      simpa [μ, Finsupp.linearCombination_apply] using
        LinearMap.map_add (Finsupp.linearCombination ℕ a) μSel ν
    have hμ_bound :
        μ.support.card ≤ 2 * n - 1 := by
      have hsubset :
          μ.support ⊆ μSel.support ∪ ν.support := by
        simpa [μ] using (Finsupp.support_add : (μSel + ν).support ⊆ μSel.support ∪ ν.support)
      have hunion :
          μ.support.card ≤ (μSel.support ∪ ν.support).card :=
        Finset.card_le_card hsubset
      have hcard_union :
          (μSel.support ∪ ν.support).card ≤ μSel.support.card + ν.support.card :=
        Finset.card_union_le _ _
      have hμSel_le_n : μSel.support.card ≤ n := by
        calc
          μSel.support.card = μSel0.support.card := hμSel_card
          _ ≤ q := hμSel0_card
          _ ≤ n := hq_le_n
      have hμ_le : μ.support.card ≤ n + (n - 1) := by
        exact le_trans hunion (le_trans hcard_union (Nat.add_le_add hμSel_le_n hν_small))
      omega
    refine ⟨μ, hμ_bound, ?_⟩
    -- Recombine the lifted floor part with the minimal Hilbert witness for the remainder.
    calc
      x = μSel0.sum (fun j c ↦ c • aSel j) + ρ := hx_split
      _ = μSel.sum (fun j c ↦ c • a j) + ν.sum (fun j c ↦ c • a j) := by
            rw [← hμSel_sum, hρ_int]
      _ = μ.sum (fun j c ↦ c • a j) := hμ_sum.symm
  · have hν_long : n ≤ ν.support.card := by
      omega
    let α := {j : Fin q // 0 < Int.fract (coeffQ j)}
    have hactive_data :
        (fun t ↦ (ρ t : ℚ)) =
          ∑ j : α, Int.fract (coeffQ j.1) • (fun t ↦ (aSel j.1 t : ℚ)) ∧
            (∀ j : α, 0 < Int.fract (coeffQ j.1)) ∧
              (∀ j : α, Int.fract (coeffQ j.1) < 1) := by
      -- Normalize the remainder once so the hard branch works only with the active coefficients.
      simpa [α] using
        active_selected_family_data aSel coeffQ ρ hρ_eq hfract_nonneg hfract_lt_one
    rcases hactive_data with ⟨hρ_active_eq, hα_pos, hα_lt_one⟩
    have hSel_lin_real :
        LinearIndependent ℝ (fun j : Fin q ↦ fun t ↦ (aSel j t : ℝ)) := by
      -- Rewrite Carathéodory's selected family once in terms of the chosen integral generators.
      simpa [aSel, hidx] using hr_lin
    have hα_lin_real :
        LinearIndependent ℝ (fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ)) := by
      -- Restrict the selected linearly independent family to the active subtype.
      exact
        (active_selected_family_linearIndependent_card_le aSel coeffQ hSel_lin_real hq_le_n
          |>.1)
    have hα_lin_rat :
        LinearIndependent ℚ (fun j : α ↦ fun t ↦ (aSel j.1 t : ℚ)) := by
      -- The coefficient comparison for the remainder must run over `ℚ`, not `ℝ`.
      simpa [α] using
        active_selected_family_rational_linearIndependent aSel coeffQ hSel_lin_real hq_le_n
    have hα_card_le_n : Fintype.card α ≤ n := by
      -- The active family still fits inside the ambient dimension.
      exact
        (active_selected_family_linearIndependent_card_le aSel coeffQ hSel_lin_real hq_le_n
          |>.2)
    have hα_card_le_ν : Fintype.card α ≤ ν.support.card := by
      -- The long-support branch is exactly the regime where the ordered-prefix argument can start.
      exact le_trans hα_card_le_n hν_long
    have hα_nonempty : Nonempty α := by
      -- If no active coefficient remains, then the remainder is zero, so the minimal witness
      -- would already have support `0`, contradicting the current long-support branch.
      by_contra hα_empty
      letI : IsEmpty α := not_nonempty_iff.mp hα_empty
      have hρ_zeroQ : (fun t ↦ (ρ t : ℚ)) = 0 := by
        simpa using hρ_active_eq
      have hρ_zero : ρ = 0 := by
        ext t
        exact_mod_cast congrFun hρ_zeroQ t
      have hν_zero : ν.support.card = 0 := by
        have hν_zero_le :
            ν.support.card ≤ (0 : Fin k →₀ ℕ).support.card := by
          -- Compare `ν` with the zero witness, which also represents the zero remainder.
          exact hν_min 0 (by simpa [hρ_zero])
        simpa using hν_zero_le
      have hν_small' : ν.support.card ≤ n - 1 := by
        simpa [hν_zero]
      exact hν_small hν_small'
    let m := ν.support.card
    let eν : Fin m ≃ ν.support := (Fintype.equivFin ν.support).symm
    have hρ_support_eq :
        (fun t ↦ (ρ t : ℚ)) =
          ∑ s : Fin m, (ν (eν s).1 : ℚ) • (fun t ↦ (a (eν s).1 t : ℚ)) := by
      -- Normalize the minimal Hilbert witness to an explicit `Fin`-indexed support sum.
      simpa [m, eν] using rat_finsupp_sum_eq_sum_support_equiv a ρ ν hρ_int eν
    have hsupport_atom_and_remainder_active_real_hull :
        ∀ s : Fin m,
          ((fun t ↦ (a (eν s).1 t : ℝ)) ∈
            (PointedCone.hull ℝ
              (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ))) ∧
            (((fun t ↦ (ρ t : ℝ)) - fun t ↦ (a (eν s).1 t : ℝ)) ∈
              (PointedCone.hull ℝ
                (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ))) := by
      -- Route correction: localize both the support atom and its residual complement to the
      -- active face before attempting any simplex-slice argument.
      simpa [α, m, eν] using
        support_atom_and_remainder_mem_active_face_of_minimal_remainder
          a idx aSel coeffQ ρ h_hilbert h_pointed hSel_lin_real (fun j ↦ rfl)
          hρ_int hν_min hρ_active_eq
          (eν := eν)
    have hsupport_atom_active_real_hull :
        ∀ s : Fin m,
          (fun t ↦ (a (eν s).1 t : ℝ)) ∈
            (PointedCone.hull ℝ
              (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ)) := by
      intro s
      exact (hsupport_atom_and_remainder_active_real_hull s).1
    have hsupport_remainder_active_real_hull :
        ∀ s : Fin m,
          ((fun t ↦ (ρ t : ℝ)) - fun t ↦ (a (eν s).1 t : ℝ)) ∈
            (PointedCone.hull ℝ
              (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ)) : Set (Fin n → ℝ)) := by
      intro s
      exact (hsupport_atom_and_remainder_active_real_hull s).2
    have hgamma_exists :
        ∀ s : Fin m,
          ∃ gammaRow : α → ℚ,
            (∀ j : α, 0 ≤ gammaRow j) ∧
              (fun t ↦ (a (eν s).1 t : ℚ)) =
                ∑ j : α, gammaRow j • (fun t ↦ (aSel j.1 t : ℚ)) := by
      intro s
      have hsupport_atom_active_rat_hull :
          (fun t ↦ (a (eν s).1 t : ℚ)) ∈
            (PointedCone.hull ℚ
              (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℚ)) : Set (Fin n → ℚ)) := by
        -- Rationalize the active-cone localization so coefficient extraction stays over `ℚ`.
        simpa [α] using
          integral_point_mem_rational_hull_of_mem_real_hull_fintype
            (r := fun j : α ↦ aSel j.1)
            (z := a (eν s).1)
            (hsupport_atom_active_real_hull s)
      -- Extract one nonnegative active-coordinate row for the selected support atom.
      exact
        exists_nonnegative_coefficient_function_of_mem_hull
          (fun j : α ↦ fun t ↦ (aSel j.1 t : ℚ))
          hsupport_atom_active_rat_hull
    choose gamma hgamma_nonneg hgamma_eq using hgamma_exists
    have hweighted_columns :
        ∀ j : α,
          ∑ s : Fin m, (ν (eν s).1 : ℚ) * gamma s j = Int.fract (coeffQ j.1) := by
      -- Compare the two active-family expansions of `ρ`.
      exact
        active_coordinate_totals_eq_remainder_coefficients
          aSel coeffQ ρ
          (fun s ↦ (ν (eν s).1 : ℚ))
          (fun s ↦ fun t ↦ (a (eν s).1 t : ℚ))
          hρ_active_eq hρ_support_eq hα_lin_rat gamma
          (fun s ↦ hgamma_eq s)
    have hgamma_row_sum :
        ∀ s : Fin m, ∑ j : α, gamma s j = 1 := by
      -- Support minimality now acts on the full active-coordinate matrix rather than one row at a
      -- time, matching the global coefficient comparison for `ρ`.
      have hsupport_atom_active_convex :
          ∀ s : Fin m,
            (fun t ↦ (a (eν s).1 t : ℝ)) ∈
              convexHull ℝ (Set.range fun j : α ↦ fun t ↦ (aSel j.1 t : ℝ)) := by
        -- The remaining geometric bridge upgrades active-cone localization to simplex-slice
        -- localization.
        simpa [α, aSel, m, eν] using
          support_atom_mem_active_convex_hull
            a idx coeffQ ρ h_hilbert hρ_int hν_min
            (eν := eν)
            hα_lin_rat hρ_active_eq hsupport_atom_active_real_hull
            hsupport_remainder_active_real_hull
      simpa [α, aSel] using
        active_rows_sum_one_of_support_minimality
          a idx coeffQ ρ h_hilbert hρ_int hν_min hρ_active_eq
          (eν := eν) gamma hgamma_nonneg hα_lin_rat hsupport_atom_active_convex
          (fun s ↦ hgamma_eq s) hweighted_columns
    have hcolumn_lt_one :
        ∀ j : α, ∑ s : Fin m, gamma s j < 1 := by
      -- Positive multiplicities let the weighted column bounds dominate the unweighted ones.
      exact
        active_simplex_column_totals_lt_one
          (ν := ν) (eν := eν) gamma
          (fun j : α ↦ Int.fract (coeffQ j.1))
          hgamma_nonneg hweighted_columns hα_lt_one
    have hα_card_le_m : Fintype.card α ≤ m := by
      -- The long-support branch puts the active simplex inside a support of cardinality `m`.
      simpa [m] using hα_card_le_ν
    exact False.elim <|
      active_simplex_cardinality_contradiction
        hα_nonempty gamma hgamma_row_sum hcolumn_lt_one hα_card_le_m

end Theorem461
