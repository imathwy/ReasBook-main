variable {E : Type u} [AddCommGroup E] [Module ℝ E]

/-- Source-facing bridge: the textbook cone of a set is the underlying set of its convex cone hull
in the canonical mathlib API. -/
abbrev cone (C : Set E) : Set E :=
  (ConvexCone.hull ℝ C : Set E)

scoped notation "cone" => Set.cone

-- Proof sketch: unfold the bridge abbreviation and use coercion from `ConvexCone` to `Set`.
/-- The textbook cone notation is the underlying set of the convex cone hull. -/
theorem cone_def (C : Set E) :
    cone C = (ConvexCone.hull ℝ C : Set E) := by
  -- Unfold the abbreviation to expose the underlying convex cone hull.
  rfl

/-- Definition 6.9 (1): the core `core C` is the set of points `x ∈ C` such that the cone
generated by the translate `C - x` is the whole ambient real vector space. -/
def core (C : Set E) : Set E :=
  {x ∈ C | cone (C - ({x} : Set E)) = (univ : Set E)}

scoped notation "core" => Set.core

-- Proof sketch: unfold `Set.core` and simplify membership in the defining subset.
/-- Membership in the core means belonging to `C` and generating the whole space by the cone of
the translate `C - x`. -/
theorem mem_core_iff {C : Set E} {x : E} :
    x ∈ core C ↔ x ∈ C ∧ cone (C - ({x} : Set E)) = (univ : Set E) := by
  -- Unfold the defining subset and simplify membership in the bounded comprehension.
  simp [Set.core]

section

variable [TopologicalSpace E] [ContinuousAdd E] [ContinuousConstSMul ℝ E]

/-- Definition 6.9 (2): the strong relative interior `sri C` is the set of points `x ∈ C` such
that the cone generated by `C - x` equals the closed linear span of `C - x`. -/
def strongRelativeInterior (C : Set E) : Set E :=
  {x ∈ C |
    cone (C - ({x} : Set E)) =
      ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E)}

scoped notation "sri" => Set.strongRelativeInterior

-- Proof sketch: unfold `Set.strongRelativeInterior` and simplify the defining subset condition.
/-- Membership in the strong relative interior means belonging to `C` and having the cone of
`C - x` equal to the closed span of `C - x`. -/
theorem mem_strongRelativeInterior_iff {C : Set E} {x : E} :
    x ∈ sri C ↔
      x ∈ C ∧
        cone (C - ({x} : Set E)) =
          ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E) := by
  -- Unfold the defining subset and simplify membership in the bounded comprehension.
  simp [Set.strongRelativeInterior]

end

/-- Definition 6.9 (3): the relative interior `ri C` is the set of points `x ∈ C` such that the
cone generated by `C - x` equals the linear span of `C - x`. -/
def relativeInterior (C : Set E) : Set E :=
  {x ∈ C | cone (C - ({x} : Set E)) = (Submodule.span ℝ (C - ({x} : Set E)) : Set E)}

scoped notation "ri" => Set.relativeInterior

-- Proof sketch: unfold `Set.relativeInterior` and simplify membership in the defining subset.
/-- Membership in the relative interior means belonging to `C` and having the cone of `C - x`
equal to the linear span of `C - x`. -/
theorem mem_relativeInterior_iff {C : Set E} {x : E} :
    x ∈ ri C ↔ x ∈ C ∧ cone (C - ({x} : Set E)) = (Submodule.span ℝ (C - ({x} : Set E)) : Set E) :=
  by
  -- Unfold the defining subset and simplify membership in the bounded comprehension.
  simp [Set.relativeInterior]

section

variable [TopologicalSpace E] [ContinuousAdd E] [ContinuousConstSMul ℝ E]

/-- Definition 6.9 (4): the quasirelative interior `qri C` is the set of points `x ∈ C` such that
the closure of the cone generated by `C - x` equals the closed linear span of `C - x`. -/
def quasiRelativeInterior (C : Set E) : Set E :=
  {x ∈ C |
    closure (cone (C - ({x} : Set E))) =
      ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E)}

scoped notation "qri" => Set.quasiRelativeInterior

-- Proof sketch: unfold `Set.quasiRelativeInterior` and simplify the defining subset condition.
/-- Membership in the quasirelative interior means belonging to `C` and having the closed cone of
`C - x` equal to the closed span of `C - x`. -/
theorem mem_quasiRelativeInterior_iff {C : Set E} {x : E} :
    x ∈ qri C ↔
      x ∈ C ∧
        closure (cone (C - ({x} : Set E))) =
          ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E) := by
  -- Unfold the defining subset and simplify membership in the bounded comprehension.
  simp [Set.quasiRelativeInterior]

/-- Definition 6.9 (5): the notation `overline (ri C)` is represented in Lean by
`closedRelativeInterior C`, defined as the closure of `ri C`. -/
def closedRelativeInterior (C : Set E) : Set E :=
  closure (ri C)

-- Proof sketch: unfold `Set.closedRelativeInterior`.
omit [ContinuousAdd E] [ContinuousConstSMul ℝ E] in
/-- The closed relative interior is the closure of the relative interior. -/
theorem closedRelativeInterior_def (C : Set E) :
    closedRelativeInterior C = closure (ri C) := by
  -- Unfold the notation wrapper for the closure of the relative interior.
  rfl

/-- Definition 6.9 (6): the notation `overline (qri C)` is represented in Lean by
`closedQuasiRelativeInterior C`, defined as the closure of `qri C`. -/
def closedQuasiRelativeInterior (C : Set E) : Set E :=
  closure (qri C)

-- Proof sketch: unfold `Set.closedQuasiRelativeInterior`.
/-- The closed quasirelative interior is the closure of the quasirelative interior. -/
theorem closedQuasiRelativeInterior_def (C : Set E) :
    closedQuasiRelativeInterior C = closure (qri C) := by
  -- Unfold the notation wrapper for the closure of the quasirelative interior.
  rfl

end

end

