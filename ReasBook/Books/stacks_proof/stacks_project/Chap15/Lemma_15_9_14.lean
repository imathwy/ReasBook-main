variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]

/- Domain-style sampling:
- primary domain: étale lifting for smooth commutative algebras over a quotient;
- sampled owner declarations:
  `Algebra.Smooth`,
  `Algebra.Etale`,
  `Ideal.Quotient.mkₐ`,
  `exists_etale_finite_projective_lift_of_finite_projective_quotient`;
- best owner abstraction: the source-facing owner here is the smooth lifting existence theorem
  itself, with the comparison to the quotient expressed through the canonical quotient algebra map
  `Ideal.Quotient.mkₐ`; the quotient isomorphism is bridge data, not a separate owner;
- primitive data: the ideal `I`, the smoothness hypothesis on `A → B`, and the quotient map
  `φ : B →ₐ[A] A ⧸ I`;
- derived API: the lifted étale `A`-algebra `A'`, the quotient equivalence `eIso`, and the lifted
  algebra map `φ' : B →ₐ[A] A'` satisfying the canonical quotient-map compatibility equation.

Source/core/bridge triage:
- `source-facing`: the present existence theorem lifting `φ` étale-locally;
- `core/canonical`: the owner predicates `Algebra.Smooth` and `Algebra.Etale`, together with the
  quotient algebra map `Ideal.Quotient.mkₐ`;
- `bridge/view`: the quotient equivalence `eIso`.
-/

-- Proof sketch: use the conormal exact sequence for the surjection `B → A ⧸ I` and smoothness of
-- `A → B` to see that the conormal module is finite projective over `A ⧸ I`. Lift a complement of
-- this module after an étale base change by Lemma `15.9.11`, add the corresponding symmetric
-- algebra factor to make the conormal module free, cut down by generators of the kernel, and then
-- localize at the étale locus as in Lemma `15.9.4` to obtain the desired étale algebra `A'` and
-- lift `B → A'`.
/-- Helper for Lemma 15.9.14: every `A`-algebra map `φ : B → A ⧸ I` is surjective because the
target quotient is generated by the image of `A`. -/
lemma quotient_target_surjective
    (I : Ideal A) (φ : B →ₐ[A] A ⧸ I) :
    Function.Surjective φ := by
  -- Proof comment: every class in `A ⧸ I` is represented by some `a : A`, and `φ` agrees with
  -- the quotient map on `A`.
  intro x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  refine ⟨algebraMap A B a, ?_⟩
  simpa using φ.commutes a

/-- Helper for Lemma 15.9.14: the quotient-kernel equivalence induced by `φ` is compatible with
the original map `B → A ⧸ I`. -/
lemma quotientKerAlgEquivOfSurjective_comp_quotient_mk_eq
    (I : Ideal A) (φ : B →ₐ[A] A ⧸ I) :
    let J : Ideal B := RingHom.ker φ.toRingHom
    ((Ideal.quotientKerAlgEquivOfSurjective
          (quotient_target_surjective (A := A) (B := B) I φ)).toAlgHom.restrictScalars A).comp
        (Ideal.Quotient.mkₐ A J) =
      φ := by
  let J : Ideal B := RingHom.ker φ.toRingHom
  -- Proof comment: the quotient-kernel equivalence is defined to recover `φ` on representatives.
  ext b
  exact
    Ideal.quotientKerAlgEquivOfSurjective_mk
      (f := φ) (quotient_target_surjective (A := A) (B := B) I φ) b

/-- Helper for Lemma 15.9.14: after identifying `A ⧸ I` with `B ⧸ ker φ`, the quotient target
admits the Chapter 10 standard-smooth lift cover over `B`. -/
lemma quotient_target_has_standardSmooth_lift_cover
    (I : Ideal A) [Algebra.Smooth A B] (φ : B →ₐ[A] A ⧸ I) :
    let J : Ideal B := RingHom.ker φ.toRingHom
    let eφ : (B ⧸ J) ≃ₐ[A] A ⧸ I :=
      Ideal.quotientKerAlgEquivOfSurjective
        (quotient_target_surjective (A := A) (B := B) I φ)
    let _ : Algebra (B ⧸ J) (A ⧸ I) := eφ.toAlgHom.toRingHom.toAlgebra
    ∃ s : Set (A ⧸ I), Ideal.span s = ⊤ ∧
      ∀ g ∈ s,
        let _ : Algebra (B ⧸ J) (Localization.Away g) := inferInstance
        ∃ (S : Type (max u v)) (_ : CommRing S) (_ : Algebra B S)
          (_ : Algebra.IsStandardSmooth B S),
            Nonempty ((Localization.Away g) ≃ₐ[B ⧸ J]
              (S ⧸ Ideal.map (algebraMap B S) J)) := by
  let J : Ideal B := RingHom.ker φ.toRingHom
  let eφ : (B ⧸ J) ≃ₐ[A] A ⧸ I :=
    Ideal.quotientKerAlgEquivOfSurjective
      (quotient_target_surjective (A := A) (B := B) I φ)
  letI : Algebra (B ⧸ J) (A ⧸ I) := eφ.toAlgHom.toRingHom.toAlgebra
  let eφ' : (B ⧸ J) ≃ₐ[B ⧸ J] A ⧸ I :=
    AlgEquiv.ofBijective (Algebra.ofId (B ⧸ J) (A ⧸ I)) eφ.bijective
  have hSmoothQuot : Algebra.Smooth (B ⧸ J) (A ⧸ I) := by
    -- Proof comment: transport smoothness along the quotient-kernel equivalence to reduce to the
    -- identity map on `B ⧸ ker φ`.
    simpa [eφ'] using
      (Algebra.Smooth.of_equiv (R := B ⧸ J) (A := B ⧸ J) (B := A ⧸ I) eφ' :
        Algebra.Smooth (B ⧸ J) (A ⧸ I))
  -- Proof comment: this is exactly the Chapter 10 local standard-smooth lifting theorem applied
  -- to the quotient presentation `B ⧸ ker φ ≃ A ⧸ I`.
  simpa [J, eφ] using
    (Algebra.exists_standardSmooth_lift_cover_of_quotient_smooth
      (R := B) (I := J) (Sbar := A ⧸ I))

/-- Helper for Lemma 15.9.14: the extended ideal `I D` is contained in the kernel of every
`A`-algebra map `D → A ⧸ I`. -/
lemma ideal_map_le_factorization_ker
    {D : Type v} [CommRing D] [Algebra A D]
    (I : Ideal A) (ρ : D →ₐ[A] A ⧸ I) :
    Ideal.map (algebraMap A D) I ≤ RingHom.ker ρ.toRingHom := by
  -- Proof comment: every element of `I` already vanishes in the quotient ring `A ⧸ I`.
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  change ρ (algebraMap A D a) = 0
  rw [ρ.commutes]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr ha

/-- Helper for Lemma 15.9.14: every factorization `ρ : D → A ⧸ I` descends to the quotient
`D / I D`. -/
noncomputable abbrev descended_quotient_map
    {D : Type v} [CommRing D] [Algebra A D]
    (I : Ideal A) (ρ : D →ₐ[A] A ⧸ I) :
    (D ⧸ Ideal.map (algebraMap A D) I) →ₐ[A] A ⧸ I :=
  Ideal.Quotient.liftₐ (Ideal.map (algebraMap A D) I) ρ fun _ hd ↦
    RingHom.mem_ker.mp (ideal_map_le_factorization_ker (A := A) I ρ hd)

/-- Helper for Lemma 15.9.14: the descended quotient map agrees with `ρ` on representatives. -/
lemma descended_quotient_map_mk
    {D : Type v} [CommRing D] [Algebra A D]
    (I : Ideal A) (ρ : D →ₐ[A] A ⧸ I) (d : D) :
    descended_quotient_map (A := A) (D := D) I ρ
      (Ideal.Quotient.mk (Ideal.map (algebraMap A D) I) d) = ρ d := by
  -- Proof comment: evaluate the quotient lift on a chosen representative.
  simp [descended_quotient_map]

/-- Helper for Lemma 15.9.14: a unit class in the quotient by `ker ρ` maps to a unit in
`A ⧸ I` under the quotient-kernel equivalence attached to a surjective map `ρ`. -/
lemma isUnit_image_of_isUnit_quotientKer
    {D : Type v} [CommRing D] [Algebra A D]
    (I : Ideal A) (ρ : D →ₐ[A] A ⧸ I) (hρsurj : Function.Surjective ρ) (d : D)
    (hdunit : IsUnit (Ideal.Quotient.mk (RingHom.ker ρ.toRingHom) d)) :
    IsUnit (ρ d) := by
  let eρ : (D ⧸ RingHom.ker ρ.toRingHom) ≃ₐ[A] A ⧸ I :=
    Ideal.quotientKerAlgEquivOfSurjective hρsurj
  -- Proof comment: transport the unit along the quotient-kernel equivalence and then evaluate it
  -- on the class of `d`.
  have hmap : eρ (Ideal.Quotient.mk (RingHom.ker ρ.toRingHom) d) = ρ d := by
    exact Ideal.quotientKerAlgEquivOfSurjective_mk (f := ρ) hρsurj d
  simpa [eρ, hmap] using hdunit.map eρ.toMonoidHom

/-- Helper for Lemma 15.9.14: if the descended quotient class of `e0` maps to a unit in
`A ⧸ I`, then the original map `ρ : D → A ⧸ I` extends across the away-localization at `e0`. -/
lemma exists_localization_lift_of_descended_quotient_map
    {D : Type v} [CommRing D] [Algebra A D]
    (I : Ideal A) (ρ : D →ₐ[A] A ⧸ I)
    (e : D ⧸ Ideal.map (algebraMap A D) I) (e0 : D)
    (he0 : Ideal.Quotient.mk (Ideal.map (algebraMap A D) I) e0 = e)
    (heunit : IsUnit (descended_quotient_map (A := A) (D := D) I ρ e)) :
    ∃ ψ0 : Localization.Away e0 →ₐ[A] A ⧸ I,
      ∀ d : D, ψ0 (algebraMap D (Localization.Away e0) d) = ρ d := by
  letI : Algebra D (A ⧸ I) := ρ.toRingHom.toAlgebra
  letI : IsScalarTower A D (A ⧸ I) :=
    IsScalarTower.of_algebraMap_eq' <|
      RingHom.ext fun a ↦ by
        change algebraMap A (A ⧸ I) a = ρ (algebraMap A D a)
        simpa using (ρ.commutes a).symm
  have he0unit : IsUnit (ρ e0) := by
    -- Proof comment: rewrite the descended unit statement back to the chosen representative `e0`.
    rw [← he0] at heunit
    simpa [descended_quotient_map_mk] using heunit
  refine ⟨
    ({ toRingHom := IsLocalization.Away.lift e0 he0unit
       commutes' := by
         intro d
         change IsLocalization.Away.lift e0 he0unit
             (algebraMap D (Localization.Away e0) d) = ρ d
         simpa using IsLocalization.Away.lift_eq e0 he0unit d } :
      Localization.Away e0 →ₐ[D] A ⧸ I).restrictScalars A,
    ?_⟩
  intro d
  -- Proof comment: the restricted localization lift still agrees with `ρ` on elements of `D`.
  change IsLocalization.Away.lift e0 he0unit
      (algebraMap D (Localization.Away e0) d) = ρ d
  simpa using IsLocalization.Away.lift_eq e0 he0unit d

/-- Helper for Lemma 15.9.14: quotienting an étale `A`-algebra by `I` stays étale over `A ⧸ I`. -/
lemma quotient_etale_over_quotient_base
    {D : Type v} [CommRing D] [Algebra A D] [Etale A D]
    (I : Ideal A) :
    Algebra.Etale (A ⧸ I) (D ⧸ Ideal.map (algebraMap A D) I) := by
  -- Proof comment: compare the quotient with the tensor-product base change of `D`.
  let e : (D ⧸ Ideal.map (algebraMap A D) I) ≃ₐ[A ⧸ I] TensorProduct A (A ⧸ I) D :=
    Algebra.TensorProduct.quotIdealMapEquivQuotTensor D I
  letI : Algebra.Etale (A ⧸ I) (TensorProduct A (A ⧸ I) D) :=
    Algebra.Etale.baseChange A D (A ⧸ I)
  exact Algebra.Etale.of_equiv e.symm

/-- Helper for Lemma 15.9.14: extending `I D` further along a tower agrees with extending `I`
directly to the top ring. -/
lemma extended_ideal_map_eq_of_tower
    {D A' : Type v} [CommRing D] [CommRing A'] [Algebra A D] [Algebra D A'] [Algebra A A']
    [IsScalarTower A D A'] (I : Ideal A) :
    Ideal.map (algebraMap D A') (Ideal.map (algebraMap A D) I) =
      Ideal.map (algebraMap A A') I := by
  -- Proof comment: collapse the two successive ideal extensions along the scalar tower.
  rw [Ideal.map_map]
  simp [IsScalarTower.algebraMap_eq A D A']

/-- Helper for Lemma 15.9.14: if the principal open `D(g)` is covered by finitely many principal
opens `D(s i)`, then the corresponding images of the `s i` span the unit ideal after localizing
away from `g`. -/
lemma localization_away_span_top_of_basicOpen_cover
    {C : Type v} [CommRing C] (g : C) {ι : Type v} [Finite ι]
    (s : ι → C)
    (hcover :
      (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum C)) ⊆
        ⋃ i, (PrimeSpectrum.basicOpen (s i) : Set (PrimeSpectrum C))) :
    Ideal.span (Set.range fun i ↦ algebraMap C (Localization.Away g) (s i)) = ⊤ := by
  let Cg : Type v := Localization.Away g
  let _ : Fintype ι := Fintype.ofFinite ι
  -- Proof comment: every prime of `C_g` comes from a prime of `C` lying in `D(g)`, hence in one
  -- of the chosen `D(s i)`.
  apply PrimeSpectrum.iSup_basicOpen_eq_top_iff.mp
  apply TopologicalSpace.Opens.ext
  ext q
  simp only [TopologicalSpace.Opens.coe_iSup, TopologicalSpace.Opens.coe_top, Set.mem_iUnion,
    Set.mem_univ, iff_true]
  have hqg : PrimeSpectrum.comap (algebraMap C Cg) q ∈ (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum C)) := by
    rw [← PrimeSpectrum.localization_away_comap_range Cg g]
    exact ⟨q, rfl⟩
  rcases Set.mem_iUnion.mp (hcover hqg) with ⟨i, hi⟩
  refine ⟨i, ?_⟩
  change q ∈
    (TopologicalSpace.Opens.comap ⟨PrimeSpectrum.comap (algebraMap C Cg),
      PrimeSpectrum.continuous_comap (algebraMap C Cg)⟩
      (PrimeSpectrum.basicOpen (s i)) : Set (PrimeSpectrum Cg))
  simpa [PrimeSpectrum.comap_basicOpen] using hi

/-- Helper for Lemma 15.9.14: target-local étaleness descends from a spanning family after
aligning the source and target rings into a common `ULift` universe. -/
lemma ulift_ringEquiv_image_range
    {S : Type v} [CommRing S] {ι : Type*} (s : ι → S) :
    ((ULift.ringEquiv : ULift.{max u v} S ≃+* S) ''
      Set.range fun i ↦ (ULift.up (s i) : ULift.{max u v} S)) = Set.range s := by
  ext y
  constructor
  · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨ULift.up (s i), ⟨i, rfl⟩, rfl⟩

/-- Helper for Lemma 15.9.14: target-local étaleness descends from a spanning family after
aligning the source and target rings into a common `ULift` universe. -/
lemma etale_of_localizationSpanTarget_via_ulift
    {S : Type v} [CommRing S] (f : A →+* S)
    {ι : Type*} (s : ι → S)
    (hs : Ideal.span (Set.range s) = ⊤)
    (hlocal : ∀ i, ((algebraMap S (Localization.Away (s i))).comp f).Etale) :
    f.Etale := by
  -- TODO: transport the spanning family `s` and the local charts `hlocal` to a common
  -- `ULift.{max u v}` universe, apply
  -- `RingHom.locally_iff_of_localizationSpanTarget RingHom.Etale.respectsIso
  --   RingHom.Etale.ofLocalizationSpanTarget`
  -- there, and descend the result back through the two `ULift` ring equivalences.
  let _ := hs
  let _ := hlocal
  sorry

/-- Helper for Lemma 15.9.14: the mixed-universe pointwise-neighborhood form of Lemma `15.9.4`,
proved by replaying the compactness and localization argument directly for `A : Type u` and
`C : Type v`. -/
lemma exists_quotient_unit_and_etale_away_of_zeroLocus_mixed
    {C : Type v} [CommRing C] [Algebra A C] [FinitePresentation A C]
    (J : Ideal C)
    (hJ : ∀ q ∈ PrimeSpectrum.zeroLocus (J : Set C),
      ∃ f : C, q ∈ PrimeSpectrum.basicOpen f ∧ Etale A (Localization.Away f)) :
    ∃ g : C, IsUnit (Ideal.Quotient.mk J g) ∧ Etale A (Localization.Away g) := by
  have hVCompact : IsCompact (PrimeSpectrum.zeroLocus (J : Set C)) := by
    -- Proof comment: the closed fiber `V(J)` is a compact closed subset of `Spec(C)`.
    simpa using (PrimeSpectrum.isClosed_zeroLocus (J : Set C)).isCompact
  choose f hfmem hfetale using
    fun x : PrimeSpectrum.zeroLocus (J : Set C) ↦ hJ x.1 x.2
  obtain ⟨t, ht⟩ :=
    hVCompact.elim_finite_subcover
      (fun x : PrimeSpectrum.zeroLocus (J : Set C) ↦
        (PrimeSpectrum.basicOpen (f x) : Set (PrimeSpectrum C)))
      (fun x ↦ (PrimeSpectrum.basicOpen (f x)).2)
      (by
        intro x hx
        exact Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hfmem ⟨x, hx⟩⟩)
  let U : Set (PrimeSpectrum C) := ⋃ x : t, (PrimeSpectrum.basicOpen (f x.1) : Set (PrimeSpectrum C))
  have hUcompact : IsCompact U := by
    -- Proof comment: a finite union of principal opens remains compact.
    simpa [U] using isCompact_iUnion fun x : t ↦ PrimeSpectrum.isCompact_basicOpen (f x.1)
  have hUopen : IsOpen U := by
    -- Proof comment: the same finite union stays open.
    simpa [U] using isOpen_iUnion fun x : t ↦ (PrimeSpectrum.basicOpen (f x.1)).2
  obtain ⟨I, -, hUeq⟩ :=
    PrimeSpectrum.isCompact_isOpen_iff_ideal.mp ⟨hUcompact, hUopen⟩
  have hVU : PrimeSpectrum.zeroLocus (J : Set C) ⊆ U := by
    -- Proof comment: the chosen finite family still covers every point of `V(J)`.
    intro x hx
    rcases Set.mem_iUnion₂.mp (ht hx) with ⟨y, hyt, hy⟩
    exact Set.mem_iUnion.mpr ⟨⟨y, hyt⟩, hy⟩
  have hZI : PrimeSpectrum.zeroLocus (J : Set C) ⊆ (PrimeSpectrum.zeroLocus (I : Set C))ᶜ := by
    -- Proof comment: rewrite the finite union as the complement of another zero locus.
    simpa [hUeq] using hVU
  have hdisj :
      Disjoint
        (closure (PrimeSpectrum.comap (RingHom.id C) '' PrimeSpectrum.zeroLocus (I : Set C) :
          Set (PrimeSpectrum C)))
        (PrimeSpectrum.zeroLocus (J : Set C)) := by
    -- Proof comment: the closure of the image of `V(I)` under the identity map is just `V(I)`.
    rw [PrimeSpectrum.closure_image_comap_zeroLocus (RingHom.id C) I]
    exact Set.disjoint_left.2 fun x hxI hxJ ↦ (hZI hxJ) hxI
  obtain ⟨g, hgbar, hgI⟩ :=
    exists_eq_one_mod_ideal_and_image_mem_of_disjoint_closure_image_zeroLocus
      (RingHom.id C) J I hdisj
  have hDg : (PrimeSpectrum.basicOpen g : Set (PrimeSpectrum C)) ⊆ U := by
    -- Proof comment: since `g ∈ I`, the principal open `D(g)` lies inside the compact open `U`.
    rw [← hUeq, PrimeSpectrum.basicOpen_eq_zeroLocus_compl]
    simpa only [RingHom.id_apply] using
      Set.compl_subset_compl.mpr
        (PrimeSpectrum.zeroLocus_anti_mono (Set.singleton_subset_iff.mpr hgI))
  let Cg : Type v := Localization.Away g
  letI : CommRing Cg := inferInstance
  have hspan :
      Ideal.span (Set.range fun y : t ↦ algebraMap C Cg (f y.1)) = ⊤ := by
    -- Proof comment: isolate the finite-cover-to-span step as a reusable localization lemma.
    exact localization_away_span_top_of_basicOpen_cover (g := g) (s := fun y : t ↦ f y.1) hDg
  have hEtaleCg : (algebraMap A Cg).Etale := by
    -- Proof comment: apply the new `ULift` adapter to the spanning family on `C_g`, and reuse the
    -- same local chart comparison as in the same-universe proof of Lemma `15.9.4`.
    refine
      etale_of_localizationSpanTarget_via_ulift
        (A := A) (S := Cg) (algebraMap A Cg)
        (fun y : t ↦ algebraMap C Cg (f y.1)) hspan ?_
    intro y
    let T₁ := Localization.Away (algebraMap C (Localization.Away (f y.1)) g)
    let T₂ := Localization.Away (algebraMap C Cg (f y.1))
    let e : T₁ ≃ₐ[A] T₂ :=
      (IsLocalization.algEquiv (Submonoid.powers (g * f y.1)) T₁ T₂).restrictScalars A
    have hT₁ : Etale A T₁ := by
      -- Proof comment: localizing the original étale neighborhood away from `g` stays étale.
      letI : Etale A (Localization.Away (f y.1)) := hfetale y.1
      infer_instance
    have hT₂ : Etale A T₂ := by
      -- Proof comment: compare the two iterated localizations through the canonical algebra
      -- equivalence over `A`.
      letI : Etale A T₁ := hT₁
      exact Etale.of_equiv e
    have hEtaleT₂ : (algebraMap A T₂).Etale :=
      RingHom.etale_algebraMap.2 hT₂
    simpa [Cg, RingHom.algebraMap_toAlgebra, T₂] using hEtaleT₂
  exact ⟨g, hgbar ▸ isUnit_one, RingHom.etale_algebraMap.mp hEtaleCg⟩

/-- Helper for Lemma 15.9.14: the mixed-universe form of Lemma `15.9.4`; if the closed fiber
`V(J)` lies in the étale locus, then some quotient-unit localization `C_g` is étale over `A`. -/
lemma exists_etale_away_of_closedFiber_subset_etaleLocus
    {C : Type v} [CommRing C] [Algebra A C] [FinitePresentation A C]
    (J : Ideal C)
    (hJ : PrimeSpectrum.zeroLocus (J : Set C) ⊆ Algebra.etaleLocus A C) :
    ∃ g : C, IsUnit (Ideal.Quotient.mk J g) ∧ Etale A (Localization.Away g) := by
  -- Proof comment: convert the owner-level inclusion into the pointwise neighborhood hypothesis
  -- and then apply the mixed-universe replay of Lemma `15.9.4`.
  apply exists_quotient_unit_and_etale_away_of_zeroLocus_mixed (A := A) (C := C) J
  intro q hq
  simpa [PrimeSpectrum.mem_basicOpen] using
    (Algebra.isEtaleAt_iff_exists_etale_away A C q).mp
      (Algebra.mem_etaleLocus_iff.mp (hJ hq))

/-- Helper for Lemma 15.9.14: after localizing away from a lifted idempotent, the induced quotient
map sends the original idempotent class to `1`. -/
lemma localization_quotient_idempotent_maps_to_one
    {D : Type v} [CommRing D] [Algebra A D]
    (I : Ideal A)
    (e : D ⧸ Ideal.map (algebraMap A D) I) (he : IsIdempotentElem e)
    (e0 : D) (he0 : Ideal.Quotient.mk (Ideal.map (algebraMap A D) I) e0 = e) :
    let A' : Type v := Localization.Away e0
    let K : Ideal A' := Ideal.map (algebraMap A A') I
    let τ : (D ⧸ Ideal.map (algebraMap A D) I) →ₐ[A] (A' ⧸ K) :=
      Ideal.quotientMapₐ K (IsScalarTower.toAlgHom A D A') <| by
        rw [show K = Ideal.map (algebraMap D A') (Ideal.map (algebraMap A D) I) by
          simpa [K] using
            (extended_ideal_map_eq_of_tower (A := A) (D := D) (A' := A') I).symm]
        exact Ideal.le_comap_map
    τ e = 1 := by
  dsimp
  have he0_idem_mem : e0 ^ 2 - e0 ∈ Ideal.map (algebraMap A D) I := by
    -- Proof comment: the lift `e0` satisfies the same idempotent relation as `e` modulo `I D`.
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    calc
      Ideal.Quotient.mk (Ideal.map (algebraMap A D) I) (e0 ^ 2 - e0)
          = (Ideal.Quotient.mk (Ideal.map (algebraMap A D) I) e0) ^ 2
              - Ideal.Quotient.mk (Ideal.map (algebraMap A D) I) e0 := by
                simp [pow_two]
      _ = e ^ 2 - e := by simpa [he0]
      _ = 0 := by simpa [pow_two] using (sub_eq_zero.mpr he.eq)
  have hclass_idem :
      IsIdempotentElem
        (Ideal.Quotient.mk (Ideal.map (algebraMap A (Localization.Away e0)) I)
          (algebraMap D (Localization.Away e0) e0)) := by
    -- Proof comment: push the lifted idempotent relation through the localization and quotient.
    refine sub_eq_zero.mp ?_
    have hzero :
        Ideal.Quotient.mk (Ideal.map (algebraMap A (Localization.Away e0)) I)
          (algebraMap D (Localization.Away e0) (e0 ^ 2 - e0)) = 0 := by
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      rw [show Ideal.map (algebraMap A (Localization.Away e0)) I =
          Ideal.map (algebraMap D (Localization.Away e0)) (Ideal.map (algebraMap A D) I) by
            simpa using
              (extended_ideal_map_eq_of_tower
                (A := A) (D := D) (A' := Localization.Away e0) I).symm]
      exact Ideal.mem_map_of_mem (algebraMap D (Localization.Away e0)) he0_idem_mem
    simpa [pow_two, map_sub] using hzero
  have hclass_unit :
      IsUnit
        (Ideal.Quotient.mk (Ideal.map (algebraMap A (Localization.Away e0)) I)
          (algebraMap D (Localization.Away e0) e0)) := by
    -- Proof comment: the distinguished element is already invertible in its away-localization.
    exact (IsLocalization.Away.algebraMap_isUnit e0).map
      (Ideal.Quotient.mk (Ideal.map (algebraMap A (Localization.Away e0)) I))
  have hclass_one :
      Ideal.Quotient.mk (Ideal.map (algebraMap A (Localization.Away e0)) I)
        (algebraMap D (Localization.Away e0) e0) = 1 := by
    -- Proof comment: an idempotent unit must be `1`.
    exact eq_one_of_isUnit_of_isIdempotentElem hclass_idem hclass_unit
  -- Proof comment: evaluate the quotient map on the chosen representative `e0` of `e`.
  calc
    Ideal.quotientMapₐ (Ideal.map (algebraMap A (Localization.Away e0)) I)
        (IsScalarTower.toAlgHom A D (Localization.Away e0))
        (by
          rw [show Ideal.map (algebraMap A (Localization.Away e0)) I =
              Ideal.map (algebraMap D (Localization.Away e0)) (Ideal.map (algebraMap A D) I) by
                simpa using
                  (extended_ideal_map_eq_of_tower
                    (A := A) (D := D) (A' := Localization.Away e0) I).symm]
          exact Ideal.le_comap_map) e
        =
        Ideal.Quotient.mk (Ideal.map (algebraMap A (Localization.Away e0)) I)
          (algebraMap D (Localization.Away e0) e0) := by
            rw [← he0]
            simp
    _ = 1 := hclass_one

/-- Helper for Lemma 15.9.14: a surjective map from an étale `A`-algebra to `A ⧸ I` can be
refined to an étale `A`-algebra whose quotient by `I` is exactly `A ⧸ I`. -/
lemma exists_etale_refinement_of_surjective_etale_quotient_map
    {D : Type v} [CommRing D] [Algebra A D] [Etale A D]
    (I : Ideal A) (ρ : D →ₐ[A] A ⧸ I) (hρsurj : Function.Surjective ρ) :
    ∃ (A' : Type v) (_ : CommRing A') (_ : Algebra A A') (_ : Etale A A')
      (eIso : (A ⧸ I) ≃ₐ[A ⧸ I] (A' ⧸ Ideal.map (algebraMap A A') I))
      (χ : D →ₐ[A] A'),
      ((Ideal.Quotient.mkₐ A' (Ideal.map (algebraMap A A') I)).restrictScalars A).comp χ =
        (eIso.toAlgHom.restrictScalars A).comp ρ := by
  let J : Ideal D := Ideal.map (algebraMap A D) I
  let ρbarA : (D ⧸ J) →ₐ[A] A ⧸ I := descended_quotient_map (A := A) (D := D) I ρ
  have hρbar_surj : Function.Surjective ρbarA := by
    -- Proof comment: the descended quotient map still hits every class because `ρ` is surjective.
    intro x
    obtain ⟨d, rfl⟩ := hρsurj x
    refine ⟨Ideal.Quotient.mk J d, ?_⟩
    simpa [J, ρbarA] using descended_quotient_map_mk (A := A) (D := D) I ρ d
  let σ : (D ⧸ J) →ₐ[A ⧸ I] A ⧸ I :=
    AlgHom.extendScalarsOfSurjective (Ideal.Quotient.mkₐ_surjective A I) ρbarA
  letI : Algebra (D ⧸ J) (A ⧸ I) := σ.toRingHom.toAlgebra
  letI : IsScalarTower (A ⧸ I) (D ⧸ J) (A ⧸ I) :=
    IsScalarTower.of_algebraMap_eq fun x ↦ by
      change x = σ (algebraMap (A ⧸ I) (D ⧸ J) x)
      simpa using (σ.commutes x).symm
  have hEtaleQ : Algebra.Etale (A ⧸ I) (D ⧸ J) :=
    quotient_etale_over_quotient_base (A := A) (D := D) I
  have hEtaleσ : Algebra.Etale (D ⧸ J) (A ⧸ I) := by
    -- Proof comment: the common-base criterion upgrades the descended quotient map to an étale map.
    let _ : Algebra.Etale (A ⧸ I) (D ⧸ J) := hEtaleQ
    simpa using (Algebra.etale_of_etale_over_common_base : Algebra.Etale (D ⧸ J) (A ⧸ I))
  have hσsurj : Function.Surjective (algebraMap (D ⧸ J) (A ⧸ I)) := by
    -- Proof comment: `σ` is just the same surjective function as `ρbarA`, viewed over `A ⧸ I`.
    intro x
    obtain ⟨y, hy⟩ := hρbar_surj x
    exact ⟨y, by simpa [σ] using hy⟩
  obtain ⟨e, he, hloc⟩ :=
    exists_idempotent_localizationAway_of_surjective_of_flat_of_finitePresentation
      (R := D ⧸ J) (S := A ⧸ I) hσsurj
  obtain ⟨e0, he0⟩ := Ideal.Quotient.mk_surjective e
  let A' : Type v := Localization.Away e0
  letI : CommRing A' := inferInstance
  letI : Algebra D A' := inferInstance
  letI : Algebra A A' := inferInstance
  letI : IsScalarTower A D A' := inferInstance
  have hJmap : Ideal.map (algebraMap D A') J = Ideal.map (algebraMap A A') I := by
    -- Proof comment: rewrite the localization-side quotient ideal to the theorem's exact target.
    simpa [J] using extended_ideal_map_eq_of_tower (A := A) (D := D) (A' := A') I
  have hEtaleA' : Etale A A' := by
    -- Proof comment: localizing an étale `A`-algebra remains étale over `A`.
    let _ : Etale D A' := Algebra.Etale.of_isLocalizationAway e0
    infer_instance
  let K : Ideal A' := Ideal.map (algebraMap A A') I
  have hkerσ :
      RingHom.ker σ.toRingHom = Ideal.span ({1 - e} : Set (D ⧸ J)) := by
    -- Proof comment: the descended quotient map is the away-localization of `D ⧸ J` at `e`.
    exact
      descended_localization_kernel_eq_span_one_sub
        (R := D ⧸ J) (S := A ⧸ I) (e := e) he hloc
  let τ : (D ⧸ J) →ₐ[A] (A' ⧸ K) :=
    Ideal.quotientMapₐ K (IsScalarTower.toAlgHom A D A') <| by
      rw [show K = Ideal.map (algebraMap D A') J by simpa [K] using hJmap.symm]
      exact Ideal.le_comap_map
  have hτe : τ e = 1 := by
    -- Proof comment: after localizing away from the idempotent lift, its quotient class becomes `1`.
    have he0_idem_mem : e0 ^ 2 - e0 ∈ J := by
      apply Ideal.Quotient.eq_zero_iff_mem.mp
      calc
        Ideal.Quotient.mk J (e0 ^ 2 - e0)
            = (Ideal.Quotient.mk J e0) ^ 2 - Ideal.Quotient.mk J e0 := by
                simp [pow_two]
        _ = e ^ 2 - e := by simpa [he0]
        _ = 0 := by simpa [pow_two, he.eq]
    have hclass_idem :
        IsIdempotentElem (Ideal.Quotient.mk K (algebraMap D A' e0)) := by
      -- Proof comment: push the lifted idempotent relation through the localization and quotient.
      refine sub_eq_zero.mp ?_
      have hzero :
          Ideal.Quotient.mk K (algebraMap D A' (e0 ^ 2 - e0)) = 0 := by
        apply Ideal.Quotient.eq_zero_iff_mem.mpr
        rw [show K = Ideal.map (algebraMap D A') J by simpa [K] using hJmap.symm]
        exact Ideal.mem_map_of_mem (algebraMap D A') he0_idem_mem
      simpa [K, pow_two, map_sub] using hzero
    have hclass_unit :
        IsUnit (Ideal.Quotient.mk K (algebraMap D A' e0)) := by
      -- Proof comment: the distinguished element is already a unit in its away-localization.
      exact (IsLocalization.Away.algebraMap_isUnit e0).map (Ideal.Quotient.mk K)
    have hclass_one :
        Ideal.Quotient.mk K (algebraMap D A' e0) = 1 := by
      -- Proof comment: an idempotent unit must be equal to `1`.
      exact eq_one_of_isUnit_of_isIdempotentElem hclass_idem hclass_unit
    calc
      τ e = Ideal.Quotient.mk K (algebraMap D A' e0) := by
        rw [← he0]
        simp [τ, K]
      _ = 1 := hclass_one
  have hτsurj : Function.Surjective τ := by
    -- Proof comment: clear localization denominators and use `τ e = 1` to hit every quotient class.
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨n, d, hd⟩ := IsLocalization.Away.surj e0 z
    have hclass_one : Ideal.Quotient.mk K (algebraMap D A' e0) = 1 := by
      calc
        Ideal.Quotient.mk K (algebraMap D A' e0) = τ e := by
          rw [← he0]
          simp [τ, K]
        _ = 1 := hτe
    refine ⟨Ideal.Quotient.mk J d, ?_⟩
    calc
      τ (Ideal.Quotient.mk J d) = Ideal.Quotient.mk K (algebraMap D A' d) := by
        simp [τ, K]
      _ = Ideal.Quotient.mk K z * (Ideal.Quotient.mk K (algebraMap D A' e0)) ^ n := by
          symm
          simpa [K, map_mul, map_pow] using congrArg (Ideal.Quotient.mk K) hd
      _ = Ideal.Quotient.mk K z * 1 := by simp [hclass_one]
      _ = Ideal.Quotient.mk K z := by simp
  have hspan_le_kerτ :
      Ideal.span ({1 - e} : Set (D ⧸ J)) ≤ RingHom.ker τ.toRingHom := by
    -- Proof comment: the complementary generator dies because `τ e = 1`.
    refine (Ideal.span_singleton_le_iff_mem _).2 ?_
    rw [RingHom.mem_ker]
    calc
      τ (1 - e) = 1 - τ e := by simp
      _ = 0 := by simp [hτe]
  have hψe_unit :
      IsUnit (descended_quotient_map (A := A) (D := D) I ρ
        (Ideal.Quotient.mk J e0)) := by
    -- Proof comment: the localization structure on `A ⧸ I` already inverts the distinguished class.
    have hunit_e : IsUnit (ρbarA (Ideal.Quotient.mk J e0)) := by
      simpa [σ] using
        (he0 ▸ (IsLocalization.Away.algebraMap_isUnit e :
          IsUnit (algebraMap (D ⧸ J) (A ⧸ I) e)))
    simpa [ρbarA, descended_quotient_map_mk] using hunit_e
  obtain ⟨ψ0, hψ0⟩ :=
    exists_localization_lift_of_descended_quotient_map
      (A := A) (D := D) I ρ
      (Ideal.Quotient.mk J e0) e0 rfl hψe_unit
  let ψ : (A' ⧸ K) →ₐ[A] A ⧸ I :=
    Ideal.Quotient.liftₐ K ψ0 fun z hz ↦
      RingHom.mem_ker.mp (ideal_map_le_factorization_ker (A := A) I ψ0 hz)
  have hψτ :
      ψ.toRingHom.comp τ.toRingHom = ρbarA.toRingHom := by
    -- Proof comment: both sides agree on quotient generators because `ψ0` extends `ρ`.
    apply Ideal.Quotient.ringHom_ext
    ext d
    change ψ0 (algebraMap D A' d) = ρbarA (Ideal.Quotient.mk J d)
    rw [descended_quotient_map_mk]
    simpa using hψ0 d
  have hkerτ :
      RingHom.ker τ.toRingHom = Ideal.span ({1 - e} : Set (D ⧸ J)) := by
    -- Proof comment: compare kernels after composing `τ` with the descended localization map `ψ`.
    apply le_antisymm
    · intro x hx
      have hτx : τ x = 0 := RingHom.mem_ker.mp hx
      have hxσ : ρbarA x = 0 := by
        have hcompx := congrArg (fun f => f x) hψτ
        calc
          ρbarA x = ψ (τ x) := hcompx.symm
          _ = ψ 0 := by rw [hτx]
          _ = 0 := by simp
      have hxkerσ : x ∈ RingHom.ker ρbarA.toRingHom := RingHom.mem_ker.mpr hxσ
      have hxkerσ' : x ∈ RingHom.ker σ.toRingHom := by
        simpa [σ] using hxkerσ
      rw [hkerσ] at hxkerσ'
      exact hxkerσ'
    · simpa using hspan_le_kerτ
  let τbar : (D ⧸ J) →ₐ[A ⧸ I] A' ⧸ K :=
    AlgHom.extendScalarsOfSurjective (Ideal.Quotient.mkₐ_surjective A I) τ
  have hτbar_surj : Function.Surjective τbar := by
    -- Proof comment: extending scalars does not alter the underlying surjective function of `τ`.
    simpa [τbar] using hτsurj
  have hkerτbar :
      RingHom.ker τbar.toRingHom = Ideal.span ({1 - e} : Set (D ⧸ J)) := by
    -- Proof comment: the `A ⧸ I`-linear version of `τ` has the same kernel as `τ`.
    simpa [τbar] using hkerτ
  let qResidue : ((D ⧸ J) ⧸ Ideal.span ({1 - e} : Set (D ⧸ J))) ≃ₐ[A ⧸ I] A ⧸ I :=
    (Ideal.quotientEquivAlgOfEq (A ⧸ I) hkerσ.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hσsurj)
  let qTarget : ((D ⧸ J) ⧸ Ideal.span ({1 - e} : Set (D ⧸ J))) ≃ₐ[A ⧸ I] A' ⧸ K :=
    (Ideal.quotientEquivAlgOfEq (A ⧸ I) hkerτbar.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hτbar_surj)
  let eIso : (A ⧸ I) ≃ₐ[A ⧸ I] A' ⧸ K := qResidue.symm.trans qTarget
  have hqResidue_mk (x : D ⧸ J) :
      qResidue (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set (D ⧸ J))) x) = ρbarA x := by
    -- Proof comment: the residue-side quotient equivalence evaluates to the descended map `ρbarA`.
    calc
      qResidue (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set (D ⧸ J))) x)
          = (Ideal.quotientKerAlgEquivOfSurjective hσsurj)
              ((Ideal.quotientEquivAlgOfEq (A ⧸ I) hkerσ.symm)
                (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set (D ⧸ J))) x)) := by
                  rfl
      _ = (Ideal.quotientKerAlgEquivOfSurjective hσsurj)
            (Ideal.Quotient.mk (RingHom.ker σ.toRingHom) x) := by
              rw [Ideal.quotientEquivAlgOfEq_mk]
      _ = algebraMap (D ⧸ J) (A ⧸ I) x := by
            exact Ideal.quotientKerAlgEquivOfSurjective_mk hσsurj x
      _ = ρbarA x := by
            rfl
  have hqTarget_mk (x : D ⧸ J) :
      qTarget (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set (D ⧸ J))) x) = τ x := by
    -- Proof comment: the target-side quotient equivalence evaluates to the localization map `τ`.
    calc
      qTarget (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set (D ⧸ J))) x)
          = (Ideal.quotientKerAlgEquivOfSurjective hτbar_surj)
              ((Ideal.quotientEquivAlgOfEq (A ⧸ I) hkerτbar.symm)
                (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set (D ⧸ J))) x)) := by
                  rfl
      _ = (Ideal.quotientKerAlgEquivOfSurjective hτbar_surj)
            (Ideal.Quotient.mk (RingHom.ker τbar.toRingHom) x) := by
              rw [Ideal.quotientEquivAlgOfEq_mk]
      _ = τbar x := by
            exact Ideal.quotientKerAlgEquivOfSurjective_mk hτbar_surj x
      _ = τ x := by
            rfl
  have hqCompare_apply (x : D ⧸ J) : eIso (ρbarA x) = τ x := by
    -- Proof comment: evaluate both quotient comparisons on the same class of `x`.
    have hsymm :
        qResidue.symm (ρbarA x) =
          Ideal.Quotient.mk (Ideal.span ({1 - e} : Set (D ⧸ J))) x := by
      apply qResidue.injective
      simp [hqResidue_mk]
    calc
      eIso (ρbarA x) = qTarget (qResidue.symm (ρbarA x)) := by rfl
      _ = qTarget (Ideal.Quotient.mk (Ideal.span ({1 - e} : Set (D ⧸ J))) x) := by
          rw [hsymm]
      _ = τ x := hqTarget_mk x
  let χ : D →ₐ[A] A' := IsScalarTower.toAlgHom A D A'
  refine ⟨A', inferInstance, inferInstance, hEtaleA', eIso, χ, ?_⟩
  ext d
  -- Proof comment: evaluate the quotient comparison on the class of `d` and rewrite both maps.
  simpa [χ, K, J, τ, descended_quotient_map_mk] using
    (hqCompare_apply (Ideal.Quotient.mk J d)).symm

/-- Helper for Lemma 15.9.14: once a quotient factorization `B → C → A ⧸ I` is étale near the
closed fiber, the final localization/idempotent argument yields the desired étale lift of `φ`. -/
lemma final_etale_lift_from_zeroLocus_etale
    {C : Type v} [CommRing C] [Algebra A C] [FinitePresentation A C]
    (I : Ideal A) (φ : B →ₐ[A] A ⧸ I)
    (β : B →ₐ[A] C) (ψ : C →ₐ[A] A ⧸ I)
    (hψβ : ψ.comp β = φ)
    (hZeroLocus :
      PrimeSpectrum.zeroLocus (RingHom.ker ψ.toRingHom : Set C) ⊆ Algebra.etaleLocus A C) :
    ∃ (A' : Type v) (_ : CommRing A') (_ : Algebra A A') (_ : Etale A A')
      (eIso : (A ⧸ I) ≃ₐ[A ⧸ I] (A' ⧸ Ideal.map (algebraMap A A') I))
      (φ' : B →ₐ[A] A'),
      ((Ideal.Quotient.mkₐ A' (Ideal.map (algebraMap A A') I)).restrictScalars A).comp φ' =
        (eIso.toAlgHom.restrictScalars A).comp φ := by
  have hφsurj : Function.Surjective φ :=
    quotient_target_surjective (A := A) (B := B) I φ
  have hψsurj : Function.Surjective ψ := by
    -- Proof comment: `ψ` is surjective because it already hits the image of the surjective map `φ`.
    intro x
    obtain ⟨b, hb⟩ := hφsurj x
    refine ⟨β b, ?_⟩
    calc
      ψ (β b) = φ b := by simpa using congrArg (fun f : B →ₐ[A] A ⧸ I => f b) hψβ
      _ = x := hb
  let Jψ : Ideal C := RingHom.ker ψ.toRingHom
  obtain ⟨g, hgunit, hEtaleCg⟩ :=
    exists_etale_away_of_closedFiber_subset_etaleLocus
      (A := A) (C := C) Jψ hZeroLocus
  let Cg : Type v := Localization.Away g
  letI : CommRing Cg := inferInstance
  letI : Algebra A Cg := inferInstance
  letI : Algebra C Cg := inferInstance
  letI : IsScalarTower A C Cg := inferInstance
  letI : Etale A Cg := hEtaleCg
  have hψg_unit : IsUnit (ψ g) := by
    -- Proof comment: the quotient-kernel equivalence for the surjective map `ψ` carries the unit
    -- class of `g` in `C / ker ψ` to the unit `ψ g` in `A ⧸ I`.
    exact isUnit_image_of_isUnit_quotientKer (A := A) (D := C) I ψ hψsurj g hgunit
  have hdesc_unit :
      IsUnit (descended_quotient_map (A := A) (D := C) I ψ
        (Ideal.Quotient.mk (Ideal.map (algebraMap A C) I) g)) := by
    -- Proof comment: the descended quotient map evaluates on `g` as the original map `ψ`.
    simpa [descended_quotient_map_mk] using hψg_unit
  obtain ⟨ρg, hρg⟩ :=
    exists_localization_lift_of_descended_quotient_map
      (A := A) (D := C) I ψ
      (Ideal.Quotient.mk (Ideal.map (algebraMap A C) I) g) g rfl hdesc_unit
  have hρg_surj : Function.Surjective ρg := by
    -- Proof comment: every quotient class is already hit by `ψ`, and `ρg` agrees with `ψ` on
    -- elements coming from `C`.
    intro x
    obtain ⟨c, hc⟩ := hψsurj x
    refine ⟨algebraMap C Cg c, ?_⟩
    calc
      ρg (algebraMap C Cg c) = ψ c := by simpa using hρg c
      _ = x := hc
  obtain ⟨A', _, _, _, eIso, χ, hχ⟩ :=
    exists_etale_refinement_of_surjective_etale_quotient_map
      (A := A) (D := Cg) I ρg hρg_surj
  let γ : C →ₐ[A] Cg := IsScalarTower.toAlgHom A C Cg
  let φg : B →ₐ[A] Cg := γ.comp β
  have hρgφg : ρg.comp φg = φ := by
    ext b
    calc
      ρg (φg b) = ρg (γ (β b)) := by rfl
      _ = ψ (β b) := by simpa [γ] using hρg (β b)
      _ = φ b := by
          simpa using congrArg (fun f : B →ₐ[A] A ⧸ I => f b) hψβ
  let K : Ideal A' := Ideal.map (algebraMap A A') I
  let φ' : B →ₐ[A] A' := χ.comp φg
  refine ⟨A', inferInstance, inferInstance, inferInstance, eIso, φ', ?_⟩
  ext b
  -- Proof comment: compose the refinement identity for `χ` with the localized lift `φg`, then
  -- replace `ρg ∘ φg` by the original map `φ`.
  have hχb :
      ((Ideal.Quotient.mkₐ A' K).restrictScalars A) (χ (φg b)) =
        (eIso.toAlgHom.restrictScalars A) (ρg (φg b)) := by
    simpa [K, AlgHom.comp_apply] using
      congrArg (fun f : Cg →ₐ[A] A' ⧸ K => f (φg b)) hχ
  have hρb : ρg (φg b) = φ b := by
    simpa [φg, AlgHom.comp_apply] using
      congrArg (fun f : B →ₐ[A] A ⧸ I => f b) hρgφg
  simpa [φ', K, hρb] using hχb

/-- Lemma 15.9.14: if `B` is a smooth `A`-algebra equipped with an `A`-algebra map
`φ : B → A ⧸ I`, then there exists an étale `A`-algebra `A'` whose reduction modulo `I` is
canonically isomorphic to `A ⧸ I`, together with an `A`-algebra map `φ' : B → A'` lifting `φ`
through that quotient isomorphism. -/
@[stacks 07M7]
theorem exists_etale_lift_to_quotient_of_smooth
    (I : Ideal A) [Algebra.Smooth A B] (φ : B →ₐ[A] A ⧸ I) :
    ∃ (A' : Type (max u v)) (_ : CommRing A') (_ : Algebra A A') (_ : Etale A A')
      (eIso : (A ⧸ I) ≃ₐ[A ⧸ I] (A' ⧸ Ideal.map (algebraMap A A') I))
      (φ' : B →ₐ[A] A'),
      ((Ideal.Quotient.mkₐ A' (Ideal.map (algebraMap A A') I)).restrictScalars A).comp φ' =
        (eIso.toAlgHom.restrictScalars A).comp φ := by
  let J : Ideal B := RingHom.ker φ.toRingHom
  have hφsurj : Function.Surjective φ :=
    quotient_target_surjective (A := A) (B := B) I φ
  let eφ : (B ⧸ J) ≃ₐ[A] A ⧸ I :=
    Ideal.quotientKerAlgEquivOfSurjective hφsurj
  have hcover := by
    -- Proof comment: the source proof first replaces `A ⧸ I` by the quotient `B ⧸ ker φ` and then
    -- lifts local standard-smooth charts from Chapter 10.
    simpa [J] using
      quotient_target_has_standardSmooth_lift_cover
