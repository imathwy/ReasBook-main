/-- Helper for Proposition 15.79.3: an object concentrated in degree `n` is canonically the
single object on its degree-`n` homology. -/
noncomputable def singleFunctor_iso_of_isGE_of_isLE_local
    (X : DMod) (n : ℤ) [X.IsGE n] [X.IsLE n] :
    X ≅ (DerivedCategory.singleFunctor (ModuleCat R) n).obj ((H n).obj X) := by
  classical
  -- Proof comment: choose the standard single-degree model and rewrite its coefficient object
  -- back to the actual degree-`n` homology of `X`.
  let hX := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE X n
  let Y := Classical.choose hX
  let e : X ≅ (DerivedCategory.singleFunctor (ModuleCat R) n).obj Y :=
    Classical.choice (Classical.choose_spec hX)
  let eH : (H n).obj X ≅ Y :=
    (H n).mapIso e ≪≫ (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) n).app Y
  exact e ≪≫ (DerivedCategory.singleFunctor (ModuleCat R) n).mapIso eH.symm

/-- Helper for Proposition 15.79.3: after identifying a concentrated object with its single-degree
model, applying homology in that degree recovers the canonical single-functor comparison. -/
lemma singleFunctor_iso_of_isGE_of_isLE_local_homology
    (X : DMod) (n : ℤ) [X.IsGE n] [X.IsLE n] :
    (H n).map (singleFunctor_iso_of_isGE_of_isLE_local (R := R) X n).hom =
      ((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) n).app
        ((H n).obj X)).inv := by
  classical
  let hX := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE X n
  let Y := Classical.choose hX
  let e : X ≅ (DerivedCategory.singleFunctor (ModuleCat R) n).obj Y :=
    Classical.choice (Classical.choose_spec hX)
  let eH : (H n).obj X ≅ Y :=
    (H n).mapIso e ≪≫ (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) n).app Y
  let α := DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) n
  have hnat' :
      (H n).map ((DerivedCategory.singleFunctor (ModuleCat R) n).map eH.inv) ≫
          (α.app ((H n).obj X)).hom =
        (α.app Y).hom ≫ eH.inv := by
    -- Proof comment: naturality of the owner comparison converts the mapped single-functor arrow
    -- into the corresponding arrow on homology.
    refine (cancel_epi (α.app Y).inv).1 ?_
    simpa [Category.assoc] using
      (NatIso.naturality_1 α eH.inv).trans
        ((Iso.inv_hom_id_assoc (α.app Y) eH.inv).symm)
  have hcomp :
      (H n).map ((DerivedCategory.singleFunctor (ModuleCat R) n).map eH.inv) =
        (α.app Y).hom ≫ eH.inv ≫ (α.app ((H n).obj X)).inv := by
    have hcomp' :
        (α.app Y).hom ≫ eH.inv ≫ (α.app ((H n).obj X)).inv ≫
            (α.app ((H n).obj X)).hom =
          (α.app Y).hom ≫ eH.inv := by
      simpa [Category.assoc] using
        congrArg (fun t ↦ (α.app Y).hom ≫ eH.inv ≫ t)
          (Iso.inv_hom_id (α.app ((H n).obj X)))
    exact (cancel_mono (α.app ((H n).obj X)).hom).1 <| by
      simpa [Category.assoc] using hnat'.trans hcomp'.symm
  dsimp [singleFunctor_iso_of_isGE_of_isLE_local]
  have hmap :
      (H n).map e.hom ≫
          (H n).map ((DerivedCategory.singleFunctor (ModuleCat R) n).map eH.inv) =
        (H n).map e.hom ≫ (α.app Y).hom ≫ eH.inv ≫ (α.app ((H n).obj X)).inv := by
    rw [hcomp]
    simp
  have hfinal :
      (H n).map e.hom ≫ (α.app Y).hom ≫ eH.inv ≫ (α.app ((H n).obj X)).inv =
        ((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) n).app
          ((H n).obj X)).inv := by
    -- Proof comment: the chosen concentrated model carries the same degree-`n` homology as `X`,
    -- so the auxiliary coefficient isomorphism cancels.
    simpa [eH, Category.assoc] using
      (Iso.hom_inv_id_assoc eH
        ((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) n).app
          ((H n).obj X)).inv)
  have hmain :
      (H n).map (singleFunctor_iso_of_isGE_of_isLE_local (R := R) X n).hom =
        (H n).map e.hom ≫ (α.app Y).hom ≫ eH.inv ≫ (α.app ((H n).obj X)).inv := by
    have hmain₁ :
        (H n).map (singleFunctor_iso_of_isGE_of_isLE_local (R := R) X n).hom =
          (H n).map e.hom ≫
              (H n).map
                ((DerivedCategory.singleFunctor (ModuleCat R) n).map
                  ((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) n).inv.app
                    Y)) ≫
            (H n).map
              ((DerivedCategory.singleFunctor (ModuleCat R) n).map ((H n).map e.inv)) := by
      simpa [singleFunctor_iso_of_isGE_of_isLE_local, e, Y, Functor.map_comp]
    have hmain₂ :
        (H n).map e.hom ≫
              (H n).map
                ((DerivedCategory.singleFunctor (ModuleCat R) n).map
                  ((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) n).inv.app
                    Y)) ≫
            (H n).map
              ((DerivedCategory.singleFunctor (ModuleCat R) n).map ((H n).map e.inv)) =
          (H n).map e.hom ≫ (α.app Y).hom ≫ eH.inv ≫ (α.app ((H n).obj X)).inv := by
      simpa [eH, Functor.map_comp, Category.assoc] using hmap
    exact hmain₁.trans hmain₂
  exact hmain.trans hfinal

/-- Helper for Proposition 15.79.3: the degree-zero truncation sandwich has the same zeroth
homology as the original derived object. -/
noncomputable def truncGE_truncLT_zero_homologyIso_local
    (X : DMod) :
    (H (0 : ℤ)).obj ((DerivedCategory.TStructure.t.truncGE 0).obj
      ((DerivedCategory.TStructure.t.truncLT 1).obj X)) ≅
        (H (0 : ℤ)).obj X := by
  let eπ :
      (H (0 : ℤ)).obj ((DerivedCategory.TStructure.t.truncLT 1).obj X) ≅
        (H (0 : ℤ)).obj ((DerivedCategory.TStructure.t.truncGE 0).obj
          ((DerivedCategory.TStructure.t.truncLT 1).obj X)) := by
    -- Proof comment: the lower truncation projection preserves the critical degree-zero
    -- homology group.
    exact @asIso _ _ _ _
      ((H (0 : ℤ)).map
        ((DerivedCategory.TStructure.t.truncGEπ 0).app
          ((DerivedCategory.TStructure.t.truncLT 1).obj X)))
      (isIso_homologyMap_truncGEπ (A := ModuleCat R)
        ((DerivedCategory.TStructure.t.truncLT 1).obj X) 0)
  let eι :
      (H (0 : ℤ)).obj ((DerivedCategory.TStructure.t.truncLT 1).obj X) ≅
        (H (0 : ℤ)).obj X := by
    -- Proof comment: the upper truncation inclusion is also an isomorphism on degree zero.
    exact @asIso _ _ _ _
      ((H (0 : ℤ)).map ((DerivedCategory.TStructure.t.truncLTι 1).app X))
      (isIso_homologyMap_truncLTι (A := ModuleCat R) X 0 1 rfl)
  exact eπ.symm ≪≫ eι

