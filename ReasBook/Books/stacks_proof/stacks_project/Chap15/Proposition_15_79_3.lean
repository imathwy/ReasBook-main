/-- Helper for Proposition 15.79.3: on degree-zero single objects, zeroth homology detects
morphisms. -/
lemma single_zero_map_ext_local
    {A B : ModuleCat R}
    {q₁ q₂ :
      (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj A ⟶
        (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj B}
    (h : (H (0 : ℤ)).map q₁ = (H (0 : ℤ)).map q₂) :
    q₁ = q₂ := by
  let α := DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat R) (0 : ℤ)
  let u₁ : A ⟶ B := (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).preimage q₁
  let u₂ : A ⟶ B := (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).preimage q₂
  have h₁ := NatIso.naturality_1 α u₁
  have h₂ := NatIso.naturality_1 α u₂
  have h₁' :
      (α.app A).inv ≫ (H (0 : ℤ)).map q₁ ≫ (α.app B).hom = u₁ := by
    -- Proof comment: rewrite each single-degree morphism through the fully faithful preimage and
    -- then evaluate the owner homology comparison on that preimage.
    simpa [u₁, Functor.comp_map, Functor.map_comp,
      (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).map_preimage q₁,
      Category.assoc] using h₁
  have h₂' :
      (α.app A).inv ≫ (H (0 : ℤ)).map q₂ ≫ (α.app B).hom = u₂ := by
    simpa [u₂, Functor.comp_map, Functor.map_comp,
      (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).map_preimage q₂,
      Category.assoc] using h₂
  have hu : u₁ = u₂ := by
    exact h₁'.symm.trans <| (by rw [h]; exact h₂')
  simpa [u₁, u₂] using
    congrArg ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).map) hu

