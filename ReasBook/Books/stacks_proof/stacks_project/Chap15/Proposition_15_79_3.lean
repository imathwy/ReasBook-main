/-- Helper for Proposition 15.79.3: maps from a degree-zero single object are already detected on
the upper truncation `τ_{<1}` because the source itself lies in degrees `≤ 0`. -/
-- TODO: replace this pointwise bridge by the functor-level NatIso
-- `preadditiveCoyoneda.obj (op ringSingle) ≅ preadditiveCoyoneda.obj (op ringSingle) ⋙ τ_{<1}`.
noncomputable def single_zero_hom_equiv_truncLT_zero_local
    (A : ModuleCat R) (X : DMod) :
    (((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj A) ⟶ X) ≃+
      (((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj A) ⟶
        (DerivedCategory.TStructure.t.truncLT 1).obj X) :=
  sorry

/-- Helper for Proposition 15.79.3: degree-zero single objects are fully faithful in the derived
category, so morphisms between them are exactly module morphisms. -/
noncomputable def single_zero_fullyFaithful_add_equiv_local
    (A B : ModuleCat R) :
    (((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj A) ⟶
      ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj B)) ≃+
        (A ⟶ B) := by
  let F := DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)
  -- Proof comment: the Chapter 15 comparison now uses the owner theorem that `singleFunctor` is
  -- fully faithful, so we can move between derived morphisms and module maps without extra
  -- truncation work.
  exact
    { toFun := fun f ↦ F.preimage f
      invFun := fun f ↦ F.map f
      left_inv := by
        intro f
        simp [F]
      right_inv := by
        intro f
        simp [F]
      map_add' := by
        intro f g
        apply F.map_injective
        simp [F] }

/-- Helper for Proposition 15.79.3: once the target has been replaced by the concentrated
degree-zero truncation piece, maps out of `A[0]` identify with maps into `H^0(X)`. -/
noncomputable def single_zero_hom_equiv_homology_zero_truncation_local
    (A : ModuleCat R) (X : DMod) :
    (((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj A) ⟶
      (DerivedCategory.TStructure.t.truncGE 0).obj
        ((DerivedCategory.TStructure.t.truncLT 1).obj X)) ≃+
        (A ⟶ (H (0 : ℤ)).obj X) := by
  let eTarget := truncGE_truncLT_zero_termIso_local (R := R) X
  let ePost :
      (((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj A) ⟶
        (DerivedCategory.TStructure.t.truncGE 0).obj
          ((DerivedCategory.TStructure.t.truncLT 1).obj X)) ≃+
        (((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj A) ⟶
          (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj
            ((H (0 : ℤ)).obj X)) :=
    { toFun := fun f ↦ f ≫ eTarget.hom
      invFun := fun f ↦ f ≫ eTarget.inv
      left_inv := by
        intro f
        simp [eTarget, Category.assoc]
      right_inv := by
        intro f
        simp [eTarget, Category.assoc]
      map_add' := by
        intro f g
        simp [Category.assoc] }
  -- Proof comment: after replacing the target by the actual single-degree object
  -- `H^0(X)[0]`, full faithfulness of `singleFunctor` gives the desired additive equivalence.
  exact ePost.trans
    (single_zero_fullyFaithful_add_equiv_local (R := R) A ((H (0 : ℤ)).obj X))

/-- Helper for Proposition 15.79.3: after the target has been replaced by the concentrated
degree-zero truncation piece, maps out of `R[0]` are already identified with elements of
`H^0(X)`. -/
noncomputable def ring_single_hom_equiv_homology_zero_truncation_local
    (X : DMod) :
    ((ringSingle : DMod) ⟶ (DerivedCategory.TStructure.t.truncGE 0).obj
      ((DerivedCategory.TStructure.t.truncLT 1).obj X)) ≃+ (H (0 : ℤ)).obj X := by
  -- Proof comment: specialize the generic `A[0]` comparison to `A = R`, then evaluate at
  -- `1 : R` using the explicit additive equivalence for maps out of the free rank-one module.
  exact
    (single_zero_hom_equiv_homology_zero_truncation_local
      (R := R) (A := ModuleCat.of R R) X).trans
      (hom_from_ring_add_equiv_local (R := R) ((H (0 : ℤ)).obj X))

