/-- Helper for Proposition 15.79.3: evaluation at `1` identifies a morphism out of the free
rank-one module with the chosen element of the target module. -/
lemma hom_from_ring_add_equiv_left_inv_local {N : ModuleCat R} (x : N) :
    (ModuleCat.homEquiv (ModuleCat.ofHom ((LinearMap.id : R →ₗ[R] R).smulRight x))) (1 : R) = x := by
  -- Proof comment: the inverse sends `x` to the linear map `r ↦ r • x`, and evaluating at `1`
  -- recovers `x`.
  change (((LinearMap.id : R →ₗ[R] R).smulRight x) (1 : R)) = x
  simp [LinearMap.smulRight_apply]

/-- Helper for Proposition 15.79.3: a morphism out of the free rank-one module is recovered from
the image of `1`. -/
lemma hom_from_ring_add_equiv_right_inv_local {N : ModuleCat R}
    (f : (ModuleCat.of R R) ⟶ N) :
    ModuleCat.ofHom (((LinearMap.id : R →ₗ[R] R).smulRight ((ModuleCat.homEquiv f) (1 : R)))) = f := by
  -- Proof comment: extensionality reduces the claim to `f (r • 1) = r • f 1`.
  apply ModuleCat.hom_injective
  exact LinearMap.ext fun r ↦ by
    simp [LinearMap.smulRight_apply]
    simpa using ((ModuleCat.homEquiv f).map_smul r (1 : R)).symm

/-- Helper for Proposition 15.79.3: evaluation at `1` preserves addition on morphisms out of the
free rank-one module. -/
lemma hom_from_ring_add_equiv_map_add_local {N : ModuleCat R}
    (f g : (ModuleCat.of R R) ⟶ N) :
    (ModuleCat.homEquiv (f + g)) (1 : R) =
      (ModuleCat.homEquiv f) (1 : R) + (ModuleCat.homEquiv g) (1 : R) :=
  rfl

/-- Helper for Proposition 15.79.3: morphisms out of the free rank-one module `R` are additively
equivalent to elements of the target module. -/
noncomputable def hom_from_ring_add_equiv_local (N : ModuleCat R) :
    ((ModuleCat.of R R) ⟶ N) ≃+ N :=
  { toFun := fun f ↦ (ModuleCat.homEquiv f) (1 : R)
    invFun := fun x ↦ ModuleCat.ofHom ((LinearMap.id : R →ₗ[R] R).smulRight x)
    left_inv := hom_from_ring_add_equiv_right_inv_local (R := R)
    right_inv := hom_from_ring_add_equiv_left_inv_local (R := R)
    map_add' := hom_from_ring_add_equiv_map_add_local (R := R) }

