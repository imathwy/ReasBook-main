/-- Helper for Proposition 15.79.3: if `P ≤ Q` and `Q` is shift-stable, then every bounded shift
interval of `P` also lies in `Q`. -/
private theorem shiftInterval_le_of_le_local
    {P Q : ObjectProperty DMod}
    [Q.IsClosedUnderIsomorphisms] [Q.IsStableUnderShift ℤ]
    (hPQ : P ≤ Q) (a b : ℤ) :
    P[a, b] ≤ Q := by
  intro X hX
  -- Proof comment: unwrap the interval witness, move the base property across `hPQ`, and then
  -- shift back using the stability of `Q`.
  rw [prop_shiftInterval_iff] at hX
  rcases hX with ⟨n, _, Y, hY, ⟨e⟩⟩
  rw [prop_shift_iff] at hY
  have hQshift : Q (Y⟦n⟧) := hPQ _ hY
  have hQYshiftNeg : Q ((Y⟦n⟧)⟦(-n : ℤ)⟧) := Q.le_shift (-n : ℤ) _ hQshift
  have hQY : Q Y := Q.prop_of_iso (shiftShiftNeg Y n) hQYshiftNeg
  exact Q.prop_of_iso e.symm hQY

/-- Helper for Proposition 15.79.3: if `P ≤ Q` and `Q` is saturated triangulated, then every
additive extension stage built from `P` also lies in `Q`. -/
private theorem additiveExtensionStage_le_of_le_local
    {P Q : ObjectProperty DMod}
    [Q.IsStableUnderRetracts] [Q.IsTriangulated]
    (hPQ : P ≤ Q) (n : ℕ+) :
    additiveExtensionStage P n ≤ Q := by
  -- Proof comment: additive-extension stages are built from additive closure, extensions, and
  -- retracts, so they stay inside any saturated triangulated property that already contains `P`.
  rw [additiveExtensionStage, retractClosure_le_iff]
  exact P.additiveClosure.extensionProductIter_le_of_isTriangulatedClosed₂
    (by
      refine colimitsClosure_le ?_
      exact hPQ)
    n.natPred

