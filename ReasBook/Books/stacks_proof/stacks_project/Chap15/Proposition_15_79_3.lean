/-- Helper for Proposition 15.79.3: composing the three truncation comparisons gives the
source-faithful additive identification `Hom(R[0], X) ≃ H^0(X)`. -/
noncomputable def ring_single_hom_equiv_homology_zero_local
    (X : DMod) :
