/-- Helper for Proposition 15.79.3: every perfect object of `D(R)` is compact once `R[0]` is. -/
lemma perfect_implies_compact_local {K : DMod} (hK : K.IsPerfect) :
    IsCompactObject K := by
  let P : ObjectProperty DMod := IsCompactObject
  letI : P.IsTriangulated := inferInstance
  letI : P.IsStableUnderRetracts := inferInstance
  rcases hK with ⟨L, e, hL⟩
  letI : CochainComplex.IsBoundedFiniteProjective L := hL
  rcases hL.bounded with ⟨a, b, hGE, hLE⟩
  have hbase :
      (((finiteProjectiveModuleProperty R).map single₀ : ObjectProperty DMod) ≤ P) := by
    intro X hX
    -- Proof comment: unpack the image-property witness and reduce to the finite projective
    -- degree-zero compactness lemma.
    rcases hX with ⟨M, hM, ⟨eX⟩⟩
    let M' : FiniteProjectiveModuleCat R := ⟨M, hM⟩
    exact P.prop_of_iso eX <|
      finiteProjective_single_isCompactObject_local (R := R) M'
  have hinterval :
      ((((finiteProjectiveModuleProperty R).map single₀)[a, b] : ObjectProperty DMod) ≤ P) := by
    exact shiftInterval_le_of_le_local (R := R) hbase a b
  let n : ℕ+ := Nat.succPNat (Int.toNat (b - a))
  have hstage :
      additiveExtensionStage (((finiteProjectiveModuleProperty R).map single₀)[a, b]) n K := by
    -- Proof comment: the chosen bounded finite-projective representative puts `K` in the
    -- expected additive-extension stage of degree-zero finite projective terms.
    refine mem_additiveExtensionStage_of_exists_representative_mem
      (E := finiteProjectiveModuleProperty R) (K := K) (a := a) (b := b) ?_
    refine ⟨L, e.symm, hGE, hLE, ?_⟩
    intro i
    exact ⟨hL.finite i.1, hL.projective i.1⟩
  have hstageLe :
      additiveExtensionStage (((finiteProjectiveModuleProperty R).map single₀)[a, b]) n ≤ P := by
    exact additiveExtensionStage_le_of_le_local (R := R) hinterval n
  exact hstageLe _ hstage

/-- Helper for Proposition 15.79.3: if every cohomology object of a derived object vanishes, then
the derived object itself is zero. -/
private lemma isZero_of_homologyFunctor_obj_isZero_local
    (K : DMod) (hK : ∀ i : ℤ, IsZero ((H i).obj K)) :
    IsZero K := by
  have hLE : K.IsLE 0 := by
    rw [DerivedCategory.isLE_iff]
    intro i hi
    exact hK i
  have hGE : K.IsGE 1 := by
    rw [DerivedCategory.isGE_iff]
    intro i hi
    exact hK i
  letI : K.IsLE 0 := hLE
  letI : K.IsGE 1 := hGE
  -- Proof comment: simultaneous membership in `D^{≤ 0}` and `D^{≥ 1}` forces `K` into the empty
  -- overlap of the standard `t`-structure.
  exact DerivedCategory.TStructure.t.isZero K 0 1 (by omega)

/-- Helper for Proposition 15.79.3: right-orthogonality to all shifts of `R[0]` forces the zeroth
homology module to vanish. -/
private lemma homology_zero_isZero_of_ring_single_rightOrthogonal_local
    {X : DMod}
    (hX : ((singleton (ringSingle : DMod)).shiftClosure ℤ).rightOrthogonal X) :
    IsZero ((H (0 : ℤ)).obj X) := by
  have hsub :
      Subsingleton ((H (0 : ℤ)).obj X) := by
    refine ⟨fun x y ↦ ?_⟩
    have hring :
        ((singleton (ringSingle : DMod)).shiftClosure ℤ) (ringSingle : DMod) := by
      exact
        ⟨(ringSingle : DMod), 0, (shiftFunctorZero DMod ℤ).symm.app (ringSingle : DMod),
          by simp⟩
    have hx :
        (ring_single_hom_equiv_homology_zero_local (R := R) X).symm x = 0 := by
      exact hX _ hring
    have hy :
        (ring_single_hom_equiv_homology_zero_local (R := R) X).symm y = 0 := by
      exact hX _ hring
    have hx0 : x = 0 := by
      simpa using
        congrArg (ring_single_hom_equiv_homology_zero_local (R := R) X) hx
    have hy0 : y = 0 := by
      simpa using
        congrArg (ring_single_hom_equiv_homology_zero_local (R := R) X) hy
    calc
      x = 0 := hx0
      _ = y := hy0.symm
  exact ModuleCat.isZero_of_subsingleton ((H (0 : ℤ)).obj X)

/-- Helper for Proposition 15.79.3: right-orthogonality to all shifts of `R[0]` forces every
cohomology object to vanish. -/
private lemma homology_isZero_of_ring_single_rightOrthogonal_local
    {K : DMod}
    (hK : ((singleton (ringSingle : DMod)).shiftClosure ℤ).rightOrthogonal K)
    (i : ℤ) :
    IsZero ((H i).obj K) := by
  have hShift :
      ((singleton (ringSingle : DMod)).shiftClosure ℤ).rightOrthogonal (K⟦i⟧) :=
    ((singleton (ringSingle : DMod)).shiftClosure ℤ).rightOrthogonal.le_shift i K hK
  have hZeroShift :
      IsZero ((H (0 : ℤ)).obj (K⟦i⟧)) :=
    homology_zero_isZero_of_ring_single_rightOrthogonal_local (R := R) hShift
  let e :
      (H (0 : ℤ)).obj (K⟦i⟧) ≅ (H i).obj K :=
    ((H (0 : ℤ)).shiftIso i 0 i (by omega)).app K
  exact e.isZero_iff.1 hZeroShift

/-- Helper for Proposition 15.79.3: the degree-zero ring object `R[0]` is a weak generator of
`D(R)`. -/
private theorem ring_single_isWeakGenerator_local :
    IsWeakGenerator (ringSingle : DMod) := by
  rw [isWeakGenerator_iff_rightOrthogonal_shifts_eq_isZero]
  ext K
  constructor
  · intro hK
    -- Proof comment: the established comparison `Hom_D(R[0], X) ≃ H^0(X)` detects every
    -- cohomology object after shifting, so right-orthogonality to all shifts forces all
    -- cohomology to vanish.
    exact isZero_of_homologyFunctor_obj_isZero_local (R := R) K <|
      homology_isZero_of_ring_single_rightOrthogonal_local (R := R) hK
  · intro hK X f hX
    exact hK.eq_zero_of_tgt f

