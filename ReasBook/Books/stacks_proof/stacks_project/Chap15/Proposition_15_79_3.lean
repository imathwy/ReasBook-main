-- Proof sketch: for `K.IsPerfect → IsCompactObject K`, unpack perfectness into a bounded
-- finite-projective representative and then use the Chapter 13 interval-stage theorem together
-- with compactness of the degree-zero finite-projective pieces. For the converse, first prove
-- that `R[0]` is a compact weak generator by identifying `Hom_D(R[0], X)` with `H^0(X)`;
-- compact generation then shows every compact object is generated by `R[0]`, and perfect objects
-- form the saturated triangulated property generated by that perfect ring object.
/-- Helper for Proposition 15.79.3: maps from `R[0]` into an object supported strictly below
degree `0` vanish because `R` is projective. -/
lemma ring_single_hom_eq_zero_of_isLE_negOne_local
    {Y : DMod} (hY : Y.IsLE (-1))
    (φ : (ringSingle : DMod) ⟶ Y) :
    φ = 0 := by
  -- Proof comment: replace the target by a strictly upper-bounded complex representative and use
  -- the derived-category vanishing theorem for maps from a projective single complex.
  rcases hY with ⟨L, eL, hL⟩
  apply (cancel_mono eL.hom).1
  simpa using
    (DerivedCategory.from_singleFunctor_obj_eq_zero_of_projective
      (P := ModuleCat.of R R) (L := L) (i := 0) (φ := φ ≫ eL.hom) (n := -1)
      (hn := by omega))

/-- Helper for Proposition 15.79.3: shifting `R[0]` by `k` identifies it with the degree-`-k`
single object on the free rank-one module. -/
noncomputable def shifted_ring_single_iso_single_local
    (k : ℤ) :
    ((ringSingle : DMod)⟦k⟧) ≅
      (DerivedCategory.singleFunctor (ModuleCat R) (-k)).obj (ModuleCat.of R R) :=
  ((DerivedCategory.singleFunctors (ModuleCat R)).shiftIso k (-k) 0 (by omega)).app
    (ModuleCat.of R R)

