/-- Helper for Lemma 15.32.3: once the degree-`1` associated-graded piece is trivialized, the
cotangent module of the quasi-regular span ideal is finite free on the same family. -/
lemma cotangent_equiv_pi_of_quasiRegular_family_over_quotient
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (hqr : RingTheory.Sequence.IsQuasiRegular A (List.ofFn f)) :
    Nonempty
      ((Ideal.ofList (List.ofFn f)).Cotangent ≃ₗ[A ⧸ Ideal.ofList (List.ofFn f)]
