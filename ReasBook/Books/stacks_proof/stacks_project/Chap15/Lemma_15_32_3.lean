import Mathlib
import stacks_proof.stacks_project.Chap10.Lemma_10_78_2
import stacks_proof.stacks_project.Chap10.Lemma_10_78_6
import stacks_proof.stacks_project.Chap15.Definition_15_32_1
import stacks_proof.stacks_project.Chap15.Lemma_15_32_2

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

namespace Ideal

open RingTheory
open PrimeSpectrum

variable {R : Type u} [CommRing R] {I : Ideal R}

/-- Helper for Lemma 15.32.3: a finitely generated ideal has finite cotangent module over its
quotient ring. -/
lemma finite_cotangent_of_fg {A : Type u} [CommRing A] {J : Ideal A}
    (hJ : J.FG) :
    Module.Finite (A ⧸ J) J.Cotangent := by
  letI : Module.Finite A J := Module.Finite.of_fg hJ
  have hfiniteCotangent : Module.Finite A J.Cotangent := by
    -- The cotangent module `J / J²` is a quotient of the finitely generated ideal `J`.
    exact Module.Finite.of_surjective (Ideal.toCotangent J) (Ideal.toCotangent_surjective J)
  -- Finally, descend the scalar ring from `A` to the quotient `A ⧸ J`.
  letI : Module.Finite A J.Cotangent := hfiniteCotangent
  letI : IsScalarTower A (A ⧸ J) J.Cotangent :=
    Module.IsTorsionBySet.isScalarTower (Ideal.isTorsionBySet_cotangent J)
  exact Module.Finite.of_restrictScalars_finite A (A ⧸ J) J.Cotangent

/-- Helper for Lemma 15.32.3: the cotangent module of a quasi-regular ideal is finite over the
quotient ring. -/
lemma finite_cotangent_of_isQuasiRegularIdeal
    (hI : I.IsQuasiRegularIdeal) :
    Module.Finite (R ⧸ I) I.Cotangent := by
  -- Reuse the general finitely-generated-ideal statement after Lemma `15.32.2`.
  exact finite_cotangent_of_fg (J := I) (fg_of_isQuasiRegularIdeal (I := I) hI)

/-- Helper for Lemma 15.32.3: every prime of `Spec (R ⧸ I)` has a basic-open neighborhood on
which the localized ideal is generated by a finite quasi-regular family. -/
lemma exists_away_quasiRegular_family_at_prime
    (hI : I.IsQuasiRegularIdeal) (p : PrimeSpectrum (R ⧸ I)) :
    ∃ g : R, Ideal.Quotient.mk I g ∉ p.asIdeal ∧
      ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
        RingTheory.Sequence.IsQuasiRegular (Localization.Away g) (List.ofFn f) ∧
          Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) := by
  let q : Ideal R := Ideal.comap (Ideal.Quotient.mk I) p.asIdeal
  have hq : q.IsPrime := Ideal.comap_isPrime (Ideal.Quotient.mk I) p.asIdeal
  have hIq : I ≤ q := by
    intro x hx
    change Ideal.Quotient.mk I x ∈ p.asIdeal
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx]
    exact Ideal.zero_mem p.asIdeal
  -- Pull the source-local quasi-regular witness back along the quotient map `R → R ⧸ I`.
  rcases (isQuasiRegularIdeal_iff I).1 hI q hq hIq with ⟨g, hg, r, f, hqr, hspan⟩
  refine ⟨g, ?_, r, f, hqr, hspan⟩
  simpa [q] using hg

/-- Helper for Lemma 15.32.3: a localized quasi-regular witness already gives finiteness of the
localized cotangent module; only the free comparison is left for the source-local cover argument. -/
lemma finite_mapCotangent_of_span_range
    {g : R} {r : ℕ} {f : Fin r → Localization.Away g}
    (hspan : Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)) :
    Module.Finite
      ((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I)
      (Ideal.map (algebraMap R (Localization.Away g)) I).Cotangent := by
  -- The mapped ideal is finitely generated because it is literally a finite span.
  have hfg :
      (Ideal.map (algebraMap R (Localization.Away g)) I).FG := by
    simpa [hspan] using
      (Submodule.fg_span (Set.finite_range f) :
        (Ideal.span (Set.range f) : Ideal (Localization.Away g)).FG)
  -- Apply the generic finite-cotangent lemma at the localized ring.
  exact finite_cotangent_of_fg
    (J := Ideal.map (algebraMap R (Localization.Away g)) I) hfg

/-- Helper for Lemma 15.32.3: quotienting `R_g` by the extended ideal `I R_g` is the same as
localizing `R ⧸ I` away from the image of `g`. -/
lemma quotient_localizationAway_algEquiv
    {g : R} :
    Nonempty
      ((((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I)) ≃ₐ[R ⧸ I]
        Localization.Away (Ideal.Quotient.mk I g)) := by
  -- The quotient of the away-localization is itself a localization of `R ⧸ I` at the image of
  -- `g`, so the canonical localization uniqueness equivalence applies.
  let _ :
      IsLocalization (Submonoid.powers (Ideal.Quotient.mk I g))
        ((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I) := by
    let hloc :
        IsLocalization (Algebra.algebraMapSubmonoid (R ⧸ I) (Submonoid.powers g))
          ((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I) :=
      inferInstance
    have hpow :
        Algebra.algebraMapSubmonoid (R ⧸ I) (Submonoid.powers g) =
          Submonoid.powers (Ideal.Quotient.mk I g) := by
      simpa using (Algebra.algebraMapSubmonoid_powers (S := R ⧸ I) g)
    exact hpow ▸ hloc
  let _ :
      IsLocalization (Submonoid.powers (Ideal.Quotient.mk I g))
        (Localization.Away (Ideal.Quotient.mk I g)) := inferInstance
  exact ⟨IsLocalization.algEquiv (Submonoid.powers (Ideal.Quotient.mk I g)) _ _⟩

/-- Helper for Lemma 15.32.3: in degree `1`, the associated-graded stage of an ideal is the
ideal itself. -/
lemma idealAssociatedGradedStage_one_eq
    {A : Type u} [CommRing A] (J : Ideal A) :
    RingTheory.Sequence.idealAssociatedGradedStage J A 1 = J := by
  -- Proof comment: for the regular module `A`, the first stage of the `J`-adic filtration is
  -- `J • A`, which is just `J`.
  ext x
  change x ∈ ((J ^ 1) • (⊤ : Submodule A A)) ↔ x ∈ J
  simp

/-- Helper for Lemma 15.32.3: after identifying the degree-`1` stage with `J`, the degree-`2`
substage becomes the square `J²` inside `J`. -/
lemma idealAssociatedGradedStage_two_map_eq
    {A : Type u} [CommRing A] (J : Ideal A) :
    Submodule.map
      (LinearEquiv.ofEq
        (RingTheory.Sequence.idealAssociatedGradedStage J A 1)
        J
        (idealAssociatedGradedStage_one_eq (A := A) J)).toLinearMap
      ((RingTheory.Sequence.idealAssociatedGradedStage J A 2).submoduleOf
        (RingTheory.Sequence.idealAssociatedGradedStage J A 1)) =
      (J • (⊤ : Submodule A J)) := by
  -- Proof comment: membership in the degree-`2` stage is exactly membership in `J²`, and under
  -- the degree-`1` identification this is the denominator of `J / J²`.
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    rw [Submodule.mem_smul_top_iff]
    change
      (((y : RingTheory.Sequence.idealAssociatedGradedStage J A 1) : A) ∈
        RingTheory.Sequence.idealAssociatedGradedStage J A 2) at hy
    simpa [RingTheory.Sequence.idealAssociatedGradedStage, pow_two] using hy
  · intro hx
    rw [Submodule.mem_smul_top_iff] at hx
    refine ⟨
      ((LinearEquiv.ofEq
        (RingTheory.Sequence.idealAssociatedGradedStage J A 1)
        J
        (idealAssociatedGradedStage_one_eq (A := A) J)).symm x),
      ?_,
      ?_⟩
    · change
        ((((LinearEquiv.ofEq
          (RingTheory.Sequence.idealAssociatedGradedStage J A 1)
          J
          (idealAssociatedGradedStage_one_eq (A := A) J)).symm x :
            RingTheory.Sequence.idealAssociatedGradedStage J A 1) : A) ∈
          RingTheory.Sequence.idealAssociatedGradedStage J A 2)
      simpa [RingTheory.Sequence.idealAssociatedGradedStage, pow_two] using hx
    · ext
      rfl

/-- Helper for Lemma 15.32.3: the cotangent module `J / J²` is the degree-`1` piece of the
associated graded module, viewed over the base ring before the quotient-linear refinement. -/
noncomputable def cotangent_equiv_degree_one_piece_over_base
    {A : Type u} [CommRing A] (J : Ideal A) :
    J.Cotangent ≃ₗ[A] RingTheory.Sequence.idealAssociatedGradedPiece J A 1 := by
  -- Proof comment: rewrite the degree-`1` stage as `J`, identify the transported denominator with
  -- `J²`, and then compare the two quotient presentations directly.
  let eStage :
      RingTheory.Sequence.idealAssociatedGradedStage J A 1 ≃ₗ[A] J :=
    LinearEquiv.ofEq _ _ (idealAssociatedGradedStage_one_eq (A := A) J)
  let eQuot :
      (RingTheory.Sequence.idealAssociatedGradedStage J A 1 ⧸
        (RingTheory.Sequence.idealAssociatedGradedStage J A 2).submoduleOf
          (RingTheory.Sequence.idealAssociatedGradedStage J A 1)) ≃ₗ[A]
        J ⧸ (J • (⊤ : Submodule A J)) :=
    Submodule.Quotient.equiv _ _ eStage
      (idealAssociatedGradedStage_two_map_eq (A := A) J)
  exact eQuot.symm

/-- Helper for Lemma 15.32.3: quotient scalars on `J / J²` are computed by representatives in the
ambient ring. -/
lemma cotangent_quotient_smul_eq
    {A : Type u} [CommRing A] (J : Ideal A) (a : A) (x : J.Cotangent) :
    ((Ideal.Quotient.mk J) a : A ⧸ J) • x = a • x := by
  -- Proof comment: the quotient-ring action on `J / J²` is definitionally induced from the
  -- ambient `A`-module structure.
  rfl

/-- Helper for Lemma 15.32.3: quotient scalars on the degree-`n` associated-graded piece are
computed by representatives in the ambient ring. -/
lemma idealAssociatedGradedPiece_quotient_smul_eq
    {A : Type u} [CommRing A] (J : Ideal A) (n : ℕ) (a : A)
    (y : RingTheory.Sequence.idealAssociatedGradedPiece J A n) :
    ((Ideal.Quotient.mk J) a : A ⧸ J) • y = a • y := by
  -- Proof comment: the quotient action on the graded piece is induced from the quotient model
  -- `I^n / I^(n+1)`, so we can compute it directly on representatives.
  refine Quotient.inductionOn y ?_
  intro z
  rfl

/-- Helper for Lemma 15.32.3: the degree-`1` cotangent/graded comparison is already linear over
the quotient ring `A ⧸ J`. -/
noncomputable def cotangent_equiv_degree_one_piece_over_quotient
    {A : Type u} [CommRing A] (J : Ideal A) :
    J.Cotangent ≃ₗ[A ⧸ J] RingTheory.Sequence.idealAssociatedGradedPiece J A 1 := by
  let e := cotangent_equiv_degree_one_piece_over_base (A := A) J
  -- Proof comment: the underlying bijection is the base-ring equivalence; only quotient-linearity
  -- needs verification, and both module structures reduce to scalar multiplication by
  -- representatives in `A`.
  refine
    { toFun := e
      invFun := e.symm
      left_inv := e.left_inv
      right_inv := e.right_inv
      map_add' := e.map_add'
      map_smul' := ?_ }
  intro a x
  refine Quotient.inductionOn a ?_
  intro a
  have hleft :
      e (((Ideal.Quotient.mk J) a : A ⧸ J) • x) = e (a • x) := by
    rw [cotangent_quotient_smul_eq (J := J) (a := a) (x := x)]
  have hmiddle : e (a • x) = a • e x := e.map_smul a x
  have hright :
      ((Ideal.Quotient.mk J) a : A ⧸ J) • e x = a • e x :=
    idealAssociatedGradedPiece_quotient_smul_eq (J := J) (n := 1) (a := a) (y := e x)
  calc
    e (((Ideal.Quotient.mk J) a : A ⧸ J) • x) = e (a • x) := hleft
    _ = a • e x := hmiddle
    _ = ((Ideal.Quotient.mk J) a : A ⧸ J) • e x := hright.symm

/-- Helper for Lemma 15.32.3: the ideal generated by a finite list of values is the span of the
same indexed family. -/
lemma ofList_ofFn_eq_span_range
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  -- Proof comment: `List.ofFn` just repackages the `Fin`-indexed generators as a list.
  ext x
  simp [Ideal.ofList, List.mem_ofFn', Set.range]

/-- Helper for Lemma 15.32.3: for the regular module over a commutative ring, quotienting by an
ideal agrees with quotienting by the corresponding submodule `J • ⊤`, already over the quotient
ring. -/
noncomputable abbrev ideal_quotient_equiv_module_quotient_over_quotient
    {A : Type u} [CommRing A] (J : Ideal A) :
    (A ⧸ J) ≃ₗ[A ⧸ J] (A ⧸ ((J • (⊤ : Submodule A A)) : Submodule A A)) := by
  let eA : (A ⧸ J) ≃ₗ[A] (A ⧸ ((J • (⊤ : Submodule A A)) : Submodule A A)) :=
    -- Proof comment: rewrite the submodule `J • ⊤` back to the ideal `J`, then use the identity
    -- map on quotient representatives.
    (Submodule.quotEquivOfEq
      (((J • (⊤ : Submodule A A)) : Submodule A A))
      (J : Submodule A A)
      (by simpa using ideal_smul_top_eq_self (J := J))).symm
  refine
    { toFun := eA
      invFun := eA.symm
      left_inv := eA.left_inv
      right_inv := eA.right_inv
      map_add' := eA.map_add
      map_smul' := ?_ }
  intro c x
  -- Proof comment: over the quotient ring, both scalar actions are computed on representatives.
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- Helper for Lemma 15.32.3: each member of a finite family belongs to the ideal generated by the
associated list. -/
lemma generator_mem_ofList_ofFn
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (i : Fin r) :
    f i ∈ Ideal.ofList (List.ofFn f) := by
  -- Proof comment: after identifying the owner ideal with the span, this is one of the chosen
  -- generators.
  rw [ofList_ofFn_eq_span_range]
  exact Ideal.subset_span (Set.mem_range_self i)

/-- Helper for Lemma 15.32.3: the local generators define the canonical quotient-linear map from a
finite free module to the cotangent module of their ideal. -/
noncomputable def cotangent_family_map_over_quotient
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    (Fin r → A ⧸ Ideal.ofList (List.ofFn f)) →ₗ[A ⧸ Ideal.ofList (List.ofFn f)]
      (Ideal.ofList (List.ofFn f)).Cotangent :=
  Fintype.linearCombination (A ⧸ Ideal.ofList (List.ofFn f)) fun i ↦
    (Ideal.ofList (List.ofFn f)).toCotangent
      ⟨f i, generator_mem_ofList_ofFn f i⟩

/-- Helper for Lemma 15.32.3: on a standard basis vector, the quotient-linear cotangent family map
returns the cotangent class of the corresponding generator. -/
lemma cotangent_family_map_over_quotient_basisFun
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (i : Fin r) :
    cotangent_family_map_over_quotient f
        ((Pi.basisFun (A ⧸ Ideal.ofList (List.ofFn f)) (Fin r)) i) =
      (Ideal.ofList (List.ofFn f)).toCotangent
        ⟨f i, generator_mem_ofList_ofFn f i⟩ := by
  -- Proof comment: all coordinates vanish except the `i`th one, where the basis vector carries
  -- the coefficient `1`.
  simp [cotangent_family_map_over_quotient, Fintype.linearCombination_apply]

/-- Helper for Lemma 15.32.3: the quotient-linear cotangent family map is surjective because every
cotangent class has a representative in the span of the chosen generators. -/
lemma cotangent_family_map_over_quotient_surjective
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    Function.Surjective (cotangent_family_map_over_quotient f) := by
  let J : Ideal A := Ideal.ofList (List.ofFn f)
  intro z
  obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective J z
  have hy_span : (y : A) ∈ Ideal.span (Set.range f) := by
    simpa [J, ofList_ofFn_eq_span_range] using y.property
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy_span
  refine ⟨fun i ↦ Ideal.Quotient.mk J (c i), ?_⟩
  have hy_eq : ∑ i, c i • (⟨f i, generator_mem_ofList_ofFn f i⟩ : J) = y := by
    ext
    simpa [J] using hc
  -- Proof comment: rewrite the chosen representative as an explicit linear combination of the
  -- generators, then evaluate the finite linear-combination map on those coefficients.
  calc
    cotangent_family_map_over_quotient f (fun i ↦ Ideal.Quotient.mk J (c i)) =
        ∑ i, (Ideal.Quotient.mk J (c i) : A ⧸ J) •
          J.toCotangent (⟨f i, generator_mem_ofList_ofFn f i⟩ : J) := by
            simp [cotangent_family_map_over_quotient, J, Fintype.linearCombination_apply]
    _ = ∑ i, c i • J.toCotangent (⟨f i, generator_mem_ofList_ofFn f i⟩ : J) := by
          simpa [cotangent_quotient_smul_eq (J := J)]
    _ = J.toCotangent (∑ i, c i • (⟨f i, generator_mem_ofList_ofFn f i⟩ : J)) := by
          symm
          calc
            J.toCotangent (∑ i, c i • (⟨f i, generator_mem_ofList_ofFn f i⟩ : J)) =
                ∑ i, J.toCotangent (c i • (⟨f i, generator_mem_ofList_ofFn f i⟩ : J)) := by
                  simp
            _ = ∑ i, c i • J.toCotangent (⟨f i, generator_mem_ofList_ofFn f i⟩ : J) := by
                  refine Finset.sum_congr rfl ?_
                  intro i hi
                  -- Proof comment: each summand is the image of a scalar multiple in the ideal,
                  -- so linearity of `toCotangent` gives the required identity.
                  change
                    J.toCotangent (c i • (⟨f i, generator_mem_ofList_ofFn f i⟩ : J)) =
                      c i • J.toCotangent (⟨f i, generator_mem_ofList_ofFn f i⟩ : J)
                  exact J.toCotangent.map_smul (c i) (⟨f i, generator_mem_ofList_ofFn f i⟩ : J)
    _ = J.toCotangent y := by rw [hy_eq]

/-- Helper for Lemma 15.32.3: a quasi-regular family identifies the plain polynomial source with
the associated graded module of its span ideal. -/
noncomputable def quasi_regular_linearEquiv_over_quotient_source
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (hqr : RingTheory.Sequence.IsQuasiRegular A (List.ofFn f)) :
    MvPolynomial (Fin (List.ofFn f).length) (A ⧸ Ideal.ofList (List.ofFn f)) ≃
      RingTheory.Sequence.idealAssociatedGradedModule (Ideal.ofList (List.ofFn f)) A := by
  let J : Ideal A := Ideal.ofList (List.ofFn f)
  let eSource :
      TensorProduct (A ⧸ J) (A ⧸ ((J • (⊤ : Submodule A A)) : Submodule A A))
          (MvPolynomial (Fin (List.ofFn f).length) (A ⧸ J)) ≃ₗ[A ⧸ J]
        TensorProduct (A ⧸ J) (A ⧸ J) (MvPolynomial (Fin (List.ofFn f).length) (A ⧸ J)) :=
    TensorProduct.AlgebraTensorModule.congr
      (ideal_quotient_equiv_module_quotient_over_quotient (A := A) J).symm
      (LinearEquiv.refl (A ⧸ J) _)
  have hlinear :
      TensorProduct (A ⧸ J) (A ⧸ ((J • (⊤ : Submodule A A)) : Submodule A A))
          (MvPolynomial (Fin (List.ofFn f).length) (A ⧸ J)) ≃
        RingTheory.Sequence.idealAssociatedGradedModule J A := by
    -- Proof comment: after forgetting the ambient scalar action, `hqr.linearEquiv` already has
    -- the desired underlying source and target.
    simpa [J] using hqr.linearEquiv.toEquiv
  -- Proof comment: `hqr.linearEquiv` already gives the associated-graded equivalence, but its
  -- source is the owner tensor `(A / J·A) ⊗ P`.  We first rewrite `A / J·A` as the plain quotient
  -- ring `A / J`, then cancel the trivial left tensor factor with `TensorProduct.lid`.
  exact
    ((TensorProduct.lid
        (A ⧸ J) (MvPolynomial (Fin (List.ofFn f).length) (A ⧸ J))).symm.toEquiv).trans
      (eSource.symm.toEquiv.trans hlinear)

/-- Helper for Lemma 15.32.3: the coefficient vector of a linear polynomial in distinct variables
is uniquely determined by the polynomial itself. -/
lemma linear_polynomial_map_injective
    {A : Type u} [CommRing A] {r : ℕ} (J : Ideal A) :
    Function.Injective
      (fun c : Fin r → A ⧸ J ↦ ∑ i, c i • (MvPolynomial.X i : MvPolynomial (Fin r) (A ⧸ J))) := by
  intro c d hcd
  funext i
  -- Proof comment: read off the coefficient of the monomial `X_i` on both sides.
  have hcoeff := congrArg
    (fun p : MvPolynomial (Fin r) (A ⧸ J) ↦ MvPolynomial.coeff (Finsupp.single i 1) p) hcd
  simpa [MvPolynomial.coeff_sum] using hcoeff

/-- Helper for Lemma 15.32.3: a quotient- or localization-valued scalar transport along a ring
equivalence can be applied pointwise to a finite free module. -/
noncomputable def linearEquiv_compHom
    {A B : Type*} [CommRing A] [CommRing B]
    {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    [Module B M] [Module B N] (φ : A →+* B) (e : M ≃ₗ[B] N) :
    let _ : Module A M := Module.compHom M φ
    let _ : Module A N := Module.compHom N φ
    M ≃ₗ[A] N := by
  let _ : Module A M := Module.compHom M φ
  let _ : Module A N := Module.compHom N φ
  -- Proof comment: once both module structures are transported along `φ`, the original
  -- `B`-linear equivalence becomes `A`-linear by applying `φ` to the scalar before using
  -- `e.map_smul`.
  refine
    { toFun := e
      invFun := e.symm
      left_inv := e.left_inv
      right_inv := e.right_inv
      map_add' := e.map_add'
      map_smul' := ?_ }
  intro a x
  exact e.map_smul (φ a) x

/-- Helper for Lemma 15.32.3: equality of ideals induces an equivalence of cotangent modules that
is already linear over the quotient by the source ideal. -/
noncomputable def cotangent_equivOfEq_over_quotient
    {A : Type u} [CommRing A] (J K : Ideal A) (hJK : J = K) :
    let _ : Module (A ⧸ J) K.Cotangent :=
      Module.compHom K.Cotangent (Ideal.quotEquivOfEq hJK).toRingHom
    J.Cotangent ≃ₗ[A ⧸ J] K.Cotangent := by
  let _ : Module (A ⧸ J) K.Cotangent :=
    Module.compHom K.Cotangent (Ideal.quotEquivOfEq hJK).toRingHom
  let e := Ideal.Cotangent.equivOfEq J K hJK
  -- Proof comment: the underlying bijection is the ambient-ring-linear equality transport; for
  -- quotient scalars, both sides reduce to multiplication by representatives in `A`.
  refine
    { toFun := e
      invFun := e.symm
      left_inv := e.left_inv
      right_inv := e.right_inv
      map_add' := e.map_add'
      map_smul' := ?_ }
  intro a x
  refine Quotient.inductionOn a ?_
  intro a
  have hleft :
      e (((Ideal.Quotient.mk J) a : A ⧸ J) • x) = e (a • x) := by
    rw [cotangent_quotient_smul_eq (J := J) (a := a) (x := x)]
  have hmiddle : e (a • x) = a • e x := e.map_smul a x
  have hright :
      ((Ideal.Quotient.mk J) a : A ⧸ J) • e x = a • e x :=
    by
      change ((Ideal.quotEquivOfEq hJK) ((Ideal.Quotient.mk J) a) : A ⧸ K) • e x = a • e x
      rw [Ideal.quotEquivOfEq_mk]
      exact cotangent_quotient_smul_eq (J := K) (a := a) (x := e x)
  calc
    e (((Ideal.Quotient.mk J) a : A ⧸ J) • x) = e (a • x) := hleft
    _ = a • e x := hmiddle
    _ = ((Ideal.Quotient.mk J) a : A ⧸ J) • e x := hright.symm

/-- Helper for Lemma 15.32.3: transport the free module `(Fin r → B)` along the quotient/local
identification `B ≃ A`. -/
noncomputable def pi_quotient_localizationAway_transport
    {g : R} {r : ℕ}
    (eQuot :
      (((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I) ≃ₐ[R ⧸ I]
        Localization.Away (Ideal.Quotient.mk I g))) :
    let _ :
        Module (Localization.Away (Ideal.Quotient.mk I g))
          (Fin r → ((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I)) :=
      Module.compHom _ eQuot.symm.toRingHom
    (Fin r → ((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I)) ≃ₗ[
        Localization.Away (Ideal.Quotient.mk I g)]
      (Fin r → Localization.Away (Ideal.Quotient.mk I g)) := by
  let _ :
      Module (Localization.Away (Ideal.Quotient.mk I g))
        (((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I)) :=
    Module.compHom _ eQuot.symm.toRingHom
  let _ :
      Module (Localization.Away (Ideal.Quotient.mk I g))
        (Fin r → ((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I)) :=
    Module.compHom _ eQuot.symm.toRingHom
  let eScalar :
      ((Localization.Away g) ⧸ Ideal.map (algebraMap R (Localization.Away g)) I) ≃ₗ[
        Localization.Away (Ideal.Quotient.mk I g)]
      Localization.Away (Ideal.Quotient.mk I g) :=
    -- Proof comment: the pointwise transport is the inverse of the canonical `A`-linear
    -- equivalence `A ≃ B` built from `Module.compHom.toLinearEquiv`.
    (Module.compHom.toLinearEquiv eQuot.symm.toRingEquiv).symm
  exact LinearEquiv.piCongrRight fun _ ↦ eScalar

