    ⟨eDegreeOne⟩
  -- Proof comment: the degree-`1` associated-graded piece already identifies with `J / J²`.
  exact ⟨(cotangent_equiv_degree_one_piece_over_quotient (A := A) J).trans eDegreeOne⟩

