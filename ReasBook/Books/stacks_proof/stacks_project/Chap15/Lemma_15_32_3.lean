/-- Helper for Lemma 15.32.3: a source-local quasi-regular generating family should directly
trivialize the away-localized cotangent module over the corresponding basic open of `Spec (R ⧸ I)`.
-/
lemma away_localizedCotangent_equiv_pi_of_quasiRegular_witness
    {g : R} {r : ℕ} {f : Fin r → Localization.Away g}
    (hqr : RingTheory.Sequence.IsQuasiRegular (Localization.Away g) (List.ofFn f))
    (hspan : Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)) :
    Nonempty
      ((LocalizedModule.Away (Ideal.Quotient.mk I g) I.Cotangent) ≃ₗ[
          Localization.Away (Ideal.Quotient.mk I g)]
        (Fin r → Localization.Away (Ideal.Quotient.mk I g))) := by
  -- Route correction: the remaining blocker is the single transport from the source-local
  -- quasi-regular span witness to the actual away-localization of `I.Cotangent`.
  let eQuot := Classical.choice (quotient_localizationAway_algEquiv (I := I) (g := g))
  let J : Ideal (Localization.Away g) := Ideal.ofList (List.ofFn f)
  have hJspan : J = Ideal.map (algebraMap R (Localization.Away g)) I := by
    change Ideal.ofList (List.ofFn f) = Ideal.map (algebraMap R (Localization.Away g)) I
    rw [ofList_ofFn_eq_span_range, ← hspan]
  have hgraded :
      MvPolynomial (Fin (List.ofFn f).length) ((Localization.Away g) ⧸ J) ≃
        RingTheory.Sequence.idealAssociatedGradedModule J (Localization.Away g) :=
    quasi_regular_linearEquiv_over_quotient_source f hqr
  have hsurjFamily :
      Function.Surjective (cotangent_family_map_over_quotient f) :=
    cotangent_family_map_over_quotient_surjective f
  let eDegreeOne := Classical.choice
    (degree_one_piece_equiv_pi_of_quasiRegular_family_over_quotient
      (A := Localization.Away g) f hqr)
  let eCotangent := Classical.choice
    (cotangent_equiv_pi_of_quasiRegular_family_over_quotient
      (A := Localization.Away g) f hqr)
  let _ :
      Module (Localization.Away (Ideal.Quotient.mk I g))
        (Ideal.map (algebraMap R (Localization.Away g)) I).Cotangent :=
    Module.compHom
      (Ideal.map (algebraMap R (Localization.Away g)) I).Cotangent
      eQuot.symm.toRingHom
  let eLocalized := Classical.choice
    (localizedCotangent_compare_map_away (I := I) (g := g) eQuot)
  -- Proof comment: the source-faithful skeleton is now explicit. The quasi-regular input gives
  -- the free degree-`1` associated-graded model `eDegreeOne`, hence the cotangent trivialization
  -- `eCotangent`; independently, `eLocalized` is the localization/base-change bridge from
  -- `LocalizedModule.Away (Ideal.Quotient.mk I g) I.Cotangent` to the cotangent of the mapped
  -- ideal.  The remaining work is the scalar-compatible composition through `hJspan`.
  let _ := hgraded
  let _ := hsurjFamily
  let _ := eDegreeOne
  let _ := eCotangent
  let _ := eLocalized
  let _ := hJspan
  let _ := eQuot
  -- TODO for Lemma 15.32.3: use `cotangent_equivOfEq_over_quotient`, `linearEquiv_compHom`, and
  -- the pointwise ring-equivalence transport to turn `eLocalized` and `eCotangent` into a single
  -- `Localization.Away (Ideal.Quotient.mk I g)`-linear composition.
  sorry

/-- Helper for Lemma 15.32.3: the source basic-open quasi-regular cover should make the cotangent
module finite locally free over the quotient ring. -/
lemma finiteLocallyFree_cotangent_of_isQuasiRegularIdeal
    (hI : I.IsQuasiRegularIdeal) :
    Module.FiniteLocallyFree (R ⧸ I) I.Cotangent := by
  classical
  let s : Set (R ⧸ I) := {q | ∃ r : ℕ,
    Nonempty ((LocalizedModule.Away q I.Cotangent) ≃ₗ[Localization.Away q]
      (Fin r → Localization.Away q))}
  have hs_mem {q : R ⧸ I} (hq : q ∈ s) :
      (basicOpen q : TopologicalSpace.Opens (PrimeSpectrum (R ⧸ I))) ≤ ⨆ r ∈ s, basicOpen r := by
    exact le_iSup_of_le q <| le_iSup_of_le hq le_rfl
  have hs_cover : (⨆ q ∈ s, basicOpen q) = ⊤ := by
    apply SetLike.ext'
    change (↑(⨆ q ∈ s, basicOpen q) : Set (PrimeSpectrum (R ⧸ I))) = Set.univ
    rw [Set.eq_univ_iff_forall]
    intro p
    rcases exists_away_quasiRegular_family_at_prime (I := I) hI p with
      ⟨g, hg, r, f, hqr, hspan⟩
    have hq : Ideal.Quotient.mk I g ∈ s := by
      refine ⟨r, ?_⟩
      exact away_localizedCotangent_equiv_pi_of_quasiRegular_witness
        (I := I) (g := g) (f := f) hqr hspan
    have hpg : p ∈ (basicOpen (Ideal.Quotient.mk I g) : Set (PrimeSpectrum (R ⧸ I))) := by
      simpa [mem_basicOpen] using hg
    exact hs_mem hq hpg
  have hs_span : Ideal.span s = ⊤ :=
    iSup_basicOpen_eq_top_iff'.mp hs_cover
  refine ⟨s, hs_span, ?_⟩
  intro q hq
  rcases hq with ⟨r, ⟨e⟩⟩
  -- The local trivialization itself yields both the free and finite parts of the owner data.
  let b : Module.Basis (Fin r) (Localization.Away q) (LocalizedModule.Away q I.Cotangent) :=
    (Pi.basisFun (Localization.Away q) (Fin r)).map e.symm
  exact ⟨Module.Free.of_basis b, Module.Finite.of_basis b⟩

/-- Helper for Lemma 15.32.3: finite local freeness of the cotangent module implies the
projectivity half of finite projectivity. -/
lemma projective_cotangent_of_isQuasiRegularIdeal
    (hI : I.IsQuasiRegularIdeal) :
    Module.Projective (R ⧸ I) I.Cotangent := by
  -- Once the source basic-open cover is packaged as finite local freeness, projectivity is the
  -- owner-level closure `(6) ⇒ (1)` from Lemma `10.78.2`.
  letI : Module.FiniteLocallyFree (R ⧸ I) I.Cotangent :=
    finiteLocallyFree_cotangent_of_isQuasiRegularIdeal (I := I) hI
  have hfiniteProjective :
      Module.Finite (R ⧸ I) I.Cotangent ∧ Module.Projective (R ⧸ I) I.Cotangent :=
    ((module_finite_projective_tfae (R := R ⧸ I) (M := I.Cotangent)).out 6 1).mp
      (show Module.FiniteLocallyFree (R ⧸ I) I.Cotangent from inferInstance)
  -- Extract the projective half from the finite-projective package given by the TFAE.
  exact hfiniteProjective.2

/- Domain triage:
- primary domain: quasi-regular ideals and their conormal module `I / I²` in commutative algebra;
- sampled owner declarations of the same kind:
  `Ideal.IsQuasiRegularIdeal`,
  `Ideal.Cotangent`,
  `Module.FiniteProjective`,
  `fg_of_isQuasiRegularIdeal`;
- best owner abstraction in this file: the source-facing theorem should use the canonical owner
  predicate `Module.FiniteProjective` for the conormal module `I.Cotangent`;
- layer triage:
  `source-facing`: the finite-projective statement for `I.Cotangent`;
  `core/canonical`: `Ideal.Cotangent` and `Module.FiniteProjective`;
- primitive data: the ideal `I`, the source-facing hypothesis `hI : I.IsQuasiRegularIdeal`, and
  the canonical cotangent owner `I.Cotangent`;
- derived API: finite generation of `I` comes from `fg_of_isQuasiRegularIdeal`, while the theorem
  below packages the resulting finiteness and projectivity of `I.Cotangent` in the owner
  predicate `Module.FiniteProjective`. -/

-- Proof sketch: combine Lemma `15.32.2` with the canonical cotangent owner `I.Cotangent` to show
-- that `I / I²` is finite and projective over `R ⧸ I`, then package the result in
-- `Module.FiniteProjective`.
/-- Lemma 15.32.3: if `I` is a quasi-regular ideal of a commutative ring `R`, then the cotangent
module `I.Cotangent = I / I²` is a finite projective `(R ⧸ I)`-module. -/
@[stacks 08RK]
theorem cotangent_finite_projective_of_isQuasiRegularIdeal
    (hI : I.IsQuasiRegularIdeal) :
    Module.FiniteProjective (R ⧸ I) I.Cotangent := by
  -- The finite half follows directly from finite generation of `I` and the quotient-extension
  -- cotangent formalism.
  have hfinite : Module.Finite (R ⧸ I) I.Cotangent :=
    finite_cotangent_of_isQuasiRegularIdeal (I := I) hI
  -- The projective half now factors through a finite-locally-free cover on `Spec (R ⧸ I)`.
  have hprojective : Module.Projective (R ⧸ I) I.Cotangent :=
    projective_cotangent_of_isQuasiRegularIdeal (I := I) hI
  exact ⟨hfinite, hprojective⟩

