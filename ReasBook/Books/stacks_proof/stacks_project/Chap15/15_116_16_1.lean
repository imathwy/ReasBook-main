-- Proof sketch: write `P` as `z ^ p - z` plus the intermediate terms from Lemma `15.116.13`.
-- Because each intermediate coefficient of the quotient polynomial from Lemma `15.116.13` lies in
-- `(1 - ζ)` and `1 - ζ` is associated to `π ^ e₁`, those coefficients are divisible by
-- `π ^ e₁`. In the fraction field of the discrete valuation ring `B`, the hypothesis
-- `π ^ (-n) * P(z) ∈ B` bounds the valuation of `z`, so every intermediate term lies in
-- `π ^ (-n + e₁) B`.
/-- Helper for `15.116.16.1`: if a coefficient lies in the principal ideal generated by
`1 - ζ`, then association with `π ^ e₁` rewrites it as a multiple of `π ^ e₁`. -/
lemma coeff_eq_uniformizer_pow_mul
    {e₁ : ℕ} {π ζ a : B}
    (hw : Associated (1 - ζ) (π ^ e₁))
    (ha : a ∈ Ideal.span ({1 - ζ} : Set B)) :
    ∃ c : B, a = π ^ e₁ * c := by
  -- First move the membership from the `(1 - ζ)`-ideal to the associated `π ^ e₁`-ideal.
  have hspan :
      Ideal.span ({1 - ζ} : Set B) = Ideal.span ({π ^ e₁} : Set B) := by
    exact (Ideal.span_singleton_eq_span_singleton).mpr hw
  have ha' : a ∈ Ideal.span ({π ^ e₁} : Set B) := by
    simpa [hspan] using ha
  -- Then unpack membership in a principal ideal as an explicit factorization.
  rcases Ideal.mem_span_singleton'.mp ha' with ⟨c, hc⟩
  exact ⟨c, by simpa [mul_comm] using hc.symm⟩

/-- Helper for `15.116.16.1`: evaluating the source-form polynomial identity isolates exactly the
interior correction sum. -/
lemma eval_sub_frobeniusLinear_eq_correction_sum
    {p : ℕ} {z : K} {P : B[X]} {a : ℕ → B}
    (hshape : P = X ^ p - X + ∑ i ∈ Finset.Icc 1 (p - 1), C (a i) * X ^ i) :
    aeval z P - (z ^ p - z) =
      ∑ i ∈ Finset.Icc 1 (p - 1), algebraMap B K (a i) * z ^ i := by
  -- Evaluate the source polynomial shape term-by-term in the fraction field.
  have hEval : aeval z P =
      z ^ p - z + ∑ i ∈ Finset.Icc 1 (p - 1), algebraMap B K (a i) * z ^ i := by
    -- Apply the evaluation homomorphism to the source polynomial identity.
    have hEval' := congrArg (aeval z) hshape
    simpa only [Polynomial.aeval_def, map_add, map_sub, map_sum, map_mul, map_pow,
      Polynomial.eval₂_C, Polynomial.eval₂_X, mul_comm, mul_left_comm, mul_assoc] using hEval'
  rw [hEval]
  -- Now cancel the distinguished `z ^ p - z` contribution and keep only the correction sum.
  ring

/-- 15.116.16.1: if `P` is the quotient polynomial from Lemma `15.116.13` attached to `ζ` over the
discrete valuation ring `B`, its distinguished coefficient `1 - ζ` is associated to `π ^ e₁`, and
`π ^ (-n) P(z)` lies in the fraction field `K = FractionRing B` with value in `B`, then
`P(z) - (z ^ p - z)` lies in `π ^ (-n + e₁) B`. This is the displayed congruence
`P(z) ≡ z^p - z mod π^{-n + e₁} B` from the discrete-valuation/fraction-field setting. -/
@[stacks 09F6]
theorem oneSubZetaQuotientPolynomial_eval_congruent_sub_frobeniusLinear
    {p e₁ n : ℕ} {π ζ : B} {z : K} {P : B[X]}
    (hP : IsOneSubZetaQuotientPolynomial p ζ P)
    (hw : Associated (1 - ζ) (π ^ e₁))
    (hPz : ∃ b : B,
      (algebraMap B K π) ^ (-(n : ℤ)) * aeval z P = algebraMap B K b) :
    ∃ b : B,
      aeval z P - (z ^ p - z) =
        (algebraMap B K π) ^ (-(n : ℤ) + e₁) * algebraMap B K b := by
  rcases hP.exists_coefficients with ⟨a, ha_mem, hshape, -⟩
  have hcoeff :
      ∀ i, 0 < i → i < p → ∃ c : B, a i = π ^ e₁ * c := by
    intro i hi hp
    -- Each intermediate coefficient comes from `(1 - ζ)`, hence from `π ^ e₁`.
    exact coeff_eq_uniformizer_pow_mul hw (ha_mem i hi hp)
  have hrewrite :
      aeval z P - (z ^ p - z) =
        ∑ i ∈ Finset.Icc 1 (p - 1), algebraMap B K (a i) * z ^ i := by
    -- Rewrite the target difference as the finite correction sum from the source polynomial shape.
    exact eval_sub_frobeniusLinear_eq_correction_sum hshape
  -- Route correction: the main theorem now follows the source architecture up to the correction
  -- sum. The remaining missing step is the valuation bound on each `z ^ i`, which needs the source
  -- nondegenerate uniformizer context and fails in the degenerate branch `π = 0`.
  let _ := hcoeff
  let _ := hPz
  rw [hrewrite]
  -- TODO: prove each `z ^ i` with `1 ≤ i < p` is `π ^ (-(n : ℤ))` times an element of `B`, then
  -- combine that with `hcoeff` term-by-term to package the whole correction sum.
  sorry

end
