/-
Domain-style sampling for Example 15.9.7:
* primary domain: polynomial factorizations over quotient rings and their étale lifting in Chapter
  15;
* sampled owner declarations:
  `Algebra.exists_etale_factorization_lift_of_isUnit_leadingCoeff`,
  `Algebra.exists_etale_lift_factorization_of_monic_mod_ideal`,
  `Algebra.exists_quotientAlgEquiv_localizationAway_of_isUnit_quotient`;
* best owner abstraction: the chapter owner for the lifting problem is
  `Algebra.exists_etale_factorization_lift_of_isUnit_leadingCoeff`; this example should negate that
  specialized conclusion directly, rather than introduce a parallel local witness package;
* primitive data: the ideal `4ℤ` and the reduced polynomial `2X^2 + 2X + 1`;
* derived API: its square-equals-one relation, the resulting self-coprimeness, the failure of
  unit-leading-coefficient, and the failure of the specialized étale lifting conclusion;
* layer: the explicit ideal, polynomial, and counterexample are `source-facing`, while the Chapter
  15 lifting theorem is the relevant `core/canonical` owner.
-/

open Polynomial

universe u

/-- The ideal `4ℤ` used in the counterexample of Example 15.9.7. -/
def example1597Ideal : Ideal ℤ :=
  Ideal.span ({(4 : ℤ)} : Set ℤ)

/-- The polynomial `2X^2 + 2X + 1` over `ℤ / 4ℤ` used in Example 15.9.7. -/
noncomputable def example1597ReducedFactor : (ℤ ⧸ example1597Ideal)[X] :=
  2 * X ^ 2 + 2 * X + 1

/-- Helper for Example 15.9.7: the class of `2` remains nonzero in `ℤ / 4ℤ`. -/
lemma two_ne_zero_mod_example1597Ideal : ((2 : ℤ) : ℤ ⧸ example1597Ideal) ≠ 0 := by
  -- The quotient equality `2 = 0` would force `4 ∣ 2`, which is impossible in `ℤ`.
  intro h
  have h' : Ideal.Quotient.mk example1597Ideal 2 = 0 := by
    simpa using h
  rw [Ideal.Quotient.eq_zero_iff_mem] at h'
  rw [example1597Ideal, Ideal.mem_span_singleton] at h'
  norm_num at h'

/-- Helper for Example 15.9.7: the quotient `ℤ / 4ℤ` is nontrivial. -/
lemma example1597Ideal_quotient_nontrivial : Nontrivial (ℤ ⧸ example1597Ideal) := by
  -- The distinct classes of `0` and `2` witness nontriviality.
  refine ⟨⟨0, ((2 : ℤ) : ℤ ⧸ example1597Ideal), ?_⟩⟩
  simpa [eq_comm] using two_ne_zero_mod_example1597Ideal

/-- Helper for Example 15.9.7: mapping `4ℤ` along a `ℤ`-algebra is the principal ideal `(4)`. -/
lemma mapped_example1597Ideal_eq_span_four (A : Type u) [CommRing A] [Algebra ℤ A] :
    Ideal.map (algebraMap ℤ A) example1597Ideal = Ideal.span ({(4 : A)} : Set A) := by
  -- Mapping a principal ideal generated by `4` keeps the same generator in the target algebra.
  rw [example1597Ideal, Ideal.map_span, Set.image_singleton]
  simp

/-- Helper for Example 15.9.7: a nilpotent element in an étale `ℤ`-algebra cannot reduce to `2`
modulo the image of `4ℤ`. -/
lemma not_isNilpotent_of_eq_two_mod_mapped_example1597Ideal
    (A : Type u) [CommRing A] [Algebra ℤ A] [Algebra.Etale ℤ A]
    [Nontrivial (A ⧸ Ideal.map (algebraMap ℤ A) example1597Ideal)]
    {x : A}
    (hx : Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A) example1597Ideal) x =
      Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A) example1597Ideal) (((2 : ℤ) : A))) :
    ¬ IsNilpotent x := by
  let K : Ideal A := Ideal.map (algebraMap ℤ A) example1597Ideal
  -- First rewrite the quotient equality as a divisibility statement by `4` in `A`.
  have hmem : x - (((2 : ℤ) : A)) ∈ Ideal.span ({(4 : A)} : Set A) := by
    have hmemK : x - (((2 : ℤ) : A)) ∈ K := by
      exact (Ideal.Quotient.eq (I := K) (x := x) (y := (((2 : ℤ) : A)))).mp hx
    simpa [K, mapped_example1597Ideal_eq_span_four] using hmemK
  rw [Ideal.mem_span_singleton] at hmem
  rcases hmem with ⟨a, ha⟩
  intro hxnil
  -- This expresses `x` as `2 * (1 + 2a)`, isolating the torsion factor `2`.
  have hx_factor : x = (((2 : ℤ) : A)) * (1 + (((2 : ℤ) : A)) * a) := by
    calc
      x = (x - (((2 : ℤ) : A))) + ((2 : ℤ) : A) := by ring
      _ = (4 : A) * a + ((2 : ℤ) : A) := by rw [ha]
      _ = (((2 : ℤ) : A)) * (1 + (((2 : ℤ) : A)) * a) := by ring
  rcases hxnil with ⟨n, hn⟩
  let _ : Algebra.Smooth ℤ A := inferInstance
  let _ : Module.Flat ℤ A := by
    convert (Algebra.Smooth.flat ℤ A : @Module.Flat ℤ A Int.instCommSemiring
      CommRing.toNonUnitalCommRing.toNonUnitalNonAssocCommRing.toNonUnitalNonAssocSemiring.toAddCommMonoid
      Algebra.toModule) using 1
    · exact Subsingleton.elim _ _
  -- Flatness over `ℤ` lets us cancel the nonzerodivisor `2^n` from the nilpotence equation.
  have hsmul : ((2 ^ n : ℤ)) • ((1 + (((2 : ℤ) : A)) * a) ^ n) = 0 := by
    calc
      ((2 ^ n : ℤ)) • ((1 + (((2 : ℤ) : A)) * a) ^ n)
          = ((((2 : ℤ) : A)) ^ n) * ((1 + (((2 : ℤ) : A)) * a) ^ n) := by
              simp [zsmul_eq_mul]
      _ = x ^ n := by rw [hx_factor, mul_pow]
      _ = 0 := hn
  have hreg : IsSMulRegular A (2 ^ n : ℤ) := by
    exact Module.Flat.isSMulRegular_of_nonZeroDivisors (M := A) (r := (2 ^ n : ℤ))
      (by simp [nonZeroDivisors])
  have hfactor_nil : (1 + (((2 : ℤ) : A)) * a) ^ n = 0 := by
    apply hreg
    simpa using hsmul
  have hquot_nil : (Ideal.Quotient.mk K (1 + (((2 : ℤ) : A)) * a)) ^ n = 0 := by
    simpa using congrArg (Ideal.Quotient.mk K) hfactor_nil
  -- Modulo `4`, the factor `1 + 2a` squares to `1`, hence becomes a unit.
  have hfour_mem : ((4 : A) * (a + a * a)) ∈ K := by
    simpa [K, mapped_example1597Ideal_eq_span_four] using
      (show (4 : A) * (a + a * a) ∈ Ideal.span ({(4 : A)} : Set A) by
        rw [Ideal.mem_span_singleton]
        exact ⟨a + a * a, by ring⟩)
  have hfour_mul_zero : Ideal.Quotient.mk K ((4 : A) * (a + a * a)) = 0 := by
    exact (Ideal.Quotient.eq_zero_iff_mem).2 hfour_mem
  have hunit_sq : (Ideal.Quotient.mk K (1 + (((2 : ℤ) : A)) * a)) ^ 2 = 1 := by
    calc
      (Ideal.Quotient.mk K (1 + (((2 : ℤ) : A)) * a)) ^ 2
          = Ideal.Quotient.mk K ((1 + (((2 : ℤ) : A)) * a) ^ 2) := by simp
      _ = Ideal.Quotient.mk K (1 + (4 : A) * (a + a * a)) := by
          congr 1
          ring
      _ = 1 := by
          simpa using congrArg (fun z : A ⧸ K => 1 + z) hfour_mul_zero
  have hunit : IsUnit (Ideal.Quotient.mk K (1 + (((2 : ℤ) : A)) * a)) := by
    exact IsUnit.of_mul_eq_one _ (by simpa [pow_two] using hunit_sq)
  have hunit_pow : IsUnit ((Ideal.Quotient.mk K (1 + (((2 : ℤ) : A)) * a)) ^ n) := hunit.pow n
  exact hunit_pow.ne_zero hquot_nil

-- Proof sketch: expand the square of `2X^2 + 2X + 1` in `(ℤ / 4ℤ)[X]`. Every cross term carries a
-- factor `4`, so it vanishes in the quotient, and the remaining constant term is `1`.
/-- The polynomial of Example 15.9.7 squares to `1` modulo `4`. -/
theorem example1597_reduction_factorization :
    example1597ReducedFactor ^ 2 = 1 := by
  -- Expand the square and collect the nonconstant terms into a single factor of `4`.
  have hfour_zero : ((4 : ℤ) : ℤ ⧸ example1597Ideal) = 0 := by
    change Ideal.Quotient.mk example1597Ideal 4 = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    change (4 : ℤ) ∈ Ideal.span ({(4 : ℤ)} : Set ℤ)
    exact Ideal.subset_span (by simp)
  have hfour_poly : (4 : (ℤ ⧸ example1597Ideal)[X]) = 0 := by
    change Polynomial.C (((4 : ℤ) : ℤ ⧸ example1597Ideal)) = 0
    rw [hfour_zero]
    simp
  calc
    example1597ReducedFactor ^ 2
      = 1 + (4 : (ℤ ⧸ example1597Ideal)[X]) * (X + 2 * X ^ 2 + 2 * X ^ 3 + X ^ 4) := by
          simp [example1597ReducedFactor]
          ring
    _ = 1 + 0 := by rw [hfour_poly]; simp
    _ = 1 := by simp

-- Proof sketch: since `example1597ReducedFactor ^ 2 = 1`, the polynomial is a unit in
-- `(ℤ / 4ℤ)[X]`; any unit is coprime to itself.
/-- The reduced factor in Example 15.9.7 is coprime to itself. -/
theorem example1597_reducedFactor_isCoprime :
    IsCoprime example1597ReducedFactor example1597ReducedFactor := by
  -- The identity `g^2 = 1` is already a Bézout relation for `g` with itself.
  refine ⟨example1597ReducedFactor, 0, ?_⟩
  calc
    example1597ReducedFactor * example1597ReducedFactor + 0 * example1597ReducedFactor
      = example1597ReducedFactor ^ 2 := by simp [pow_two]
    _ = 1 := example1597_reduction_factorization

-- Proof sketch: the leading coefficient is the image of `2` in `ℤ / 4ℤ`. If it were a unit, then
-- `2` would be invertible modulo `4`, which is impossible because `2` is a zerodivisor in `ℤ / 4ℤ`.
/-- The leading coefficient in Example 15.9.7 is not a unit. -/
theorem example1597_reducedFactor_leadingCoeff_not_isUnit :
    ¬ IsUnit example1597ReducedFactor.leadingCoeff := by
  let _ : Nontrivial (ℤ ⧸ example1597Ideal) := example1597Ideal_quotient_nontrivial
  have hcoeff_two :
      example1597ReducedFactor.coeff 2 = ((2 : ℤ) : ℤ ⧸ example1597Ideal) := by
    -- Reading off coefficient `2` from the explicit polynomial gives the class of `2`.
    simp [example1597ReducedFactor, Polynomial.coeff_X, Polynomial.coeff_one]
  have hnatDegree : example1597ReducedFactor.natDegree = 2 := by
    -- All coefficients above degree `2` vanish, while the quadratic coefficient is nonzero.
    apply Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
    · rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      have h1 : ¬ 1 = N := by omega
      have h0 : ¬ N = 0 := by omega
      simp [example1597ReducedFactor, Polynomial.coeff_X, Polynomial.coeff_one, h1, h0, hN.ne']
    · rw [hcoeff_two]
      exact two_ne_zero_mod_example1597Ideal
  have hcoeff : example1597ReducedFactor.leadingCoeff = ((2 : ℤ) : ℤ ⧸ example1597Ideal) := by
    -- The leading coefficient is the coefficient at the computed top degree.
    rw [← Polynomial.coeff_natDegree, hnatDegree, hcoeff_two]
  intro hunit
  rw [hcoeff] at hunit
  rcases hunit with ⟨u, hu⟩
  have hsq : (((2 : ℤ) : ℤ ⧸ example1597Ideal)) * (((2 : ℤ) : ℤ ⧸ example1597Ideal)) = 0 := by
    calc
      (((2 : ℤ) : ℤ ⧸ example1597Ideal)) * (((2 : ℤ) : ℤ ⧸ example1597Ideal))
          = ((4 : ℤ) : ℤ ⧸ example1597Ideal) := by norm_num
      _ = 0 := by
          change Ideal.Quotient.mk example1597Ideal 4 = 0
          rw [Ideal.Quotient.eq_zero_iff_mem]
          change (4 : ℤ) ∈ Ideal.span ({(4 : ℤ)} : Set ℤ)
          exact Ideal.subset_span (by simp)
  have hmul : (↑u : ℤ ⧸ example1597Ideal) * (((2 : ℤ) : ℤ ⧸ example1597Ideal)) = 0 := by
    calc
      (↑u : ℤ ⧸ example1597Ideal) * (((2 : ℤ) : ℤ ⧸ example1597Ideal))
        = (((2 : ℤ) : ℤ ⧸ example1597Ideal)) * (((2 : ℤ) : ℤ ⧸ example1597Ideal)) := by rw [hu]
      _ = 0 := hsq
  have hzero : (((2 : ℤ) : ℤ ⧸ example1597Ideal)) = 0 := by
    have hinv := congrArg (fun z : ℤ ⧸ example1597Ideal => ↑u⁻¹ * z) hmul
    simpa [mul_assoc] using hinv
  exact two_ne_zero_mod_example1597Ideal hzero

-- Proof sketch: argue by contradiction. Such lift data would produce an étale `ℤ`-algebra `A'`
-- with `A' / 4A' ≃ ℤ / 4ℤ` and polynomials `g'`, `h'` lifting `2X^2 + 2X + 1` whose product is
-- `1`. The source example identifies the `2`-adic completion of any such `A'` with `ℤ₂`, where no
-- polynomial congruent to `2X^2 + 2X + 1` modulo `4` is invertible in `ℤ₂[X]`, contradiction.
/-- Example 15.9.7: for `A = ℤ`, `I = 4ℤ`, `f = 1`, and
`ḡ = h̄ = 2X^2 + 2X + 1 ∈ (ℤ / 4ℤ)[X]`, the conclusion of Lemma `15.9.6` fails: there is no
étale lift of this factorization with quotient unchanged modulo `4`. This shows the hypothesis
that the leading coefficient of `ḡ` is a unit cannot be dropped. -/
@[stacks 07M2]
theorem example1597_no_etale_factorization_lift :
    ¬ ∃ (A' : Type u) (_ : CommRing A') (_ : Algebra ℤ A') (_ : Algebra.Etale ℤ A')
        (quotientAlgEquiv :
          (ℤ ⧸ example1597Ideal) ≃ₐ[ℤ ⧸ example1597Ideal]
            (A' ⧸ Ideal.map (algebraMap ℤ A') example1597Ideal))
        (g' h' : A'[X]),
        (1 : ℤ[X]).map (algebraMap ℤ A') = g' * h' ∧
          example1597ReducedFactor.map quotientAlgEquiv.toRingHom =
            g'.map (Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A') example1597Ideal)) ∧
          example1597ReducedFactor.map quotientAlgEquiv.toRingHom =
            h'.map (Ideal.Quotient.mk (Ideal.map (algebraMap ℤ A') example1597Ideal)) := by
  -- Route correction: instead of using completions, compare coefficient `1` of the lifted unit
  -- polynomial and contradict nilpotence via flatness of the étale algebra over `ℤ`.
  intro h
  rcases h with ⟨A', _, _, _, quotientAlgEquiv, g', h', hmul, hgred, _⟩
  let K : Ideal A' := Ideal.map (algebraMap ℤ A') example1597Ideal
  let _ : Nontrivial (ℤ ⧸ example1597Ideal) := example1597Ideal_quotient_nontrivial
  let _ : Nontrivial (A' ⧸ K) := quotientAlgEquiv.toEquiv.symm.nontrivial
  have hg_unit : IsUnit g' := by
    exact IsUnit.of_mul_eq_one h' (by simpa using hmul.symm)
  have hnil_coeff : IsNilpotent (g'.coeff 1) := by
    exact (Polynomial.isUnit_iff_coeff_isUnit_isNilpotent.mp hg_unit).2 1 (by decide)
  have hcoeff : Ideal.Quotient.mk K (g'.coeff 1) = Ideal.Quotient.mk K (((2 : ℤ) : A')) := by
    -- Taking coefficient `1` records exactly the reduction congruence to `2` modulo `4`.
    have hcoeff_eq := congrArg (fun p : (A' ⧸ K)[X] => p.coeff 1) hgred
    simpa [K, example1597ReducedFactor, Polynomial.coeff_X, Polynomial.coeff_one] using
      hcoeff_eq.symm
  exact not_isNilpotent_of_eq_two_mod_mapped_example1597Ideal A' hcoeff hnil_coeff
