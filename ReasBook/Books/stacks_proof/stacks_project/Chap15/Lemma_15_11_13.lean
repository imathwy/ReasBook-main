import stacks_proof.stacks_project.Chap15.Definition_15_11_1
import Mathlib.Tactic.StacksAttribute

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

section

open Ring.DirectLimit
open scoped Polynomial

variable {J : Type v} [Preorder J] [Nonempty J] [IsDirectedOrder J]
variable (A : J → Type u) [∀ j, CommRing (A j)]
variable (I : ∀ j, Ideal (A j))
variable (f : ∀ j k, j ≤ k → A j →+* A k)

variable [DirectedSystem A (f · · ·)]

/- Domain-style sampling for filtered colimits of henselian pairs:
- primary domain: commutative algebra of henselian pairs under filtered colimits
- inspected same-domain owners/constructions:
  `Ring.DirectLimit`, `Ring.DirectLimit.of`, `HenselianRing`,
  `Ideal.le_ring_jacobson_of_henselianRing`
- best owner abstraction: the ambient colimit pair is expressed directly by the canonical owner
  `HenselianRing (Ring.DirectLimit A (f · · ·)) (⨆ j, Ideal.map (of A (f · · ·) j) (I j))`;
  there is no separate source-facing wrapper here

Source/core/bridge triage:
- `source-facing`: closure of henselian pairs under filtered colimits
- `core/canonical`: the owner class `HenselianRing`
- `bridge/view`: the direct-limit ring together with the supremum ideal coming from the compatible
  stage ideals

Primitive data is the directed system of rings and ideals together with the compatibility maps
`hI`. Since that compatibility is not inferable from the colimit ring and ideal, it belongs as an
explicit input of the public instance header. The henselian structure on the colimit pair is then
derived from that data, so the file should expose the canonical owner instance directly rather than
introducing any presentation wrapper.
-/

local notation "A∞" => Ring.DirectLimit A (f · · ·)
local notation "I∞" => ⨆ j, Ideal.map (of A (f · · ·) j) (I j)

omit [Nonempty J] [DirectedSystem A (f · · ·)] in
/-- Helper for Lemma 15.11.13: the images of the stage ideals form a directed family in the direct
limit ring. -/
lemma directLimit_ideal_family_directed
    (hI : ∀ ⦃j k⦄ (h : j ≤ k), Ideal.map (f j k h) (I j) ≤ I k) :
    Directed (· ≤ ·) fun j ↦ Ideal.map (of A (f · · ·) j) (I j) := by
  intro j k
  rcases exists_ge_ge j k with ⟨l, hjl, hkl⟩
  refine ⟨l, ?_, ?_⟩
  · -- Move the `j`-ideal to the common stage `l`, then use compatibility of the ideal system.
    have hmap :
        Ideal.map (of A (f · · ·) l) (Ideal.map (f j l hjl) (I j)) =
          Ideal.map (of A (f · · ·) j) (I j) := by
      rw [Ideal.map_map]
      congr
      ext x
      simp [RingHom.comp_apply, Ring.DirectLimit.of_f]
    exact hmap.symm.le.trans (Ideal.map_mono (f := of A (f · · ·) l) (hI hjl))
  · -- The same comparison works for the `k`-ideal.
    have hmap :
        Ideal.map (of A (f · · ·) l) (Ideal.map (f k l hkl) (I k)) =
          Ideal.map (of A (f · · ·) k) (I k) := by
      rw [Ideal.map_map]
      congr
      ext x
      simp [RingHom.comp_apply, Ring.DirectLimit.of_f]
    exact hmap.symm.le.trans (Ideal.map_mono (f := of A (f · · ·) l) (hI hkl))

omit [DirectedSystem A (f · · ·)] in
/-- Helper for Lemma 15.11.13: an element of the image ideal from stage `j` is represented by an
element of a later stage ideal. -/
lemma exists_ge_stage_ideal_rep_of_mem_mapped_ideal
    (hI : ∀ ⦃j k⦄ (h : j ≤ k), Ideal.map (f j k h) (I j) ≤ I k)
    {j : J} {z : A∞}
    (hz : z ∈ Ideal.map (of A (f · · ·) j) (I j)) :
    ∃ k, ∃ _hjk : j ≤ k, ∃ y : A k, y ∈ I k ∧ of A (f · · ·) k y = z := by
  -- The image ideal is generated by stage elements, so we prove the representation by ideal-span
  -- induction and keep moving all data to a common later stage.
  change z ∈ Ideal.span ((of A (f · · ·) j) '' (I j : Set (A j))) at hz
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
  · intro x hx
    rcases hx with ⟨y, hy, rfl⟩
    exact ⟨j, le_rfl, y, hy, rfl⟩
  · exact ⟨j, le_rfl, 0, Ideal.zero_mem _, map_zero _⟩
  · intro x y hx hy hxrep hyrep
    rcases hxrep with ⟨kx, hjx, x', hx', rfl⟩
    rcases hyrep with ⟨ky, hjy, y', hy', rfl⟩
    rcases exists_ge_ge kx ky with ⟨k, hxk, hyk⟩
    refine ⟨k, le_trans hjx hxk, f kx k hxk x' + f ky k hyk y', ?_, ?_⟩
    · -- After moving both generators to `k`, the ideal closure under addition keeps us inside
      -- the stage ideal.
      exact Ideal.add_mem _ ((hI hxk) (Ideal.mem_map_of_mem _ hx'))
        ((hI hyk) (Ideal.mem_map_of_mem _ hy'))
    · -- The direct-limit sum is represented at the common stage.
      simp [map_add, Ring.DirectLimit.of_f]
  · intro a x hx hxrep
    rcases hxrep with ⟨kx, hjx, x', hx', rfl⟩
    rcases Ring.DirectLimit.exists_of (G := A) (f := fun i j h ↦ f i j h) a with ⟨ka, a', rfl⟩
    rcases exists_ge_ge ka kx with ⟨k, hak, hxk⟩
    refine ⟨k, le_trans hjx hxk, f ka k hak a' * f kx k hxk x', ?_, ?_⟩
    · -- Multiplication by a direct-limit scalar is absorbed after passing to a common stage.
      exact Ideal.mul_mem_left _ _ ((hI hxk) (Ideal.mem_map_of_mem _ hx'))
    · simp [smul_eq_mul, map_mul, Ring.DirectLimit.of_f]

/-- Helper for Lemma 15.11.13: if a stage element lands in the colimit ideal, then it already
lands in some later stage ideal. -/
lemma exists_ge_mem_stage_ideal_of_mem_directLimit_ideal
    (hI : ∀ ⦃j k⦄ (h : j ≤ k), Ideal.map (f j k h) (I j) ≤ I k)
    {j : J} {x : A j}
    (hx : of A (f · · ·) j x ∈ I∞) :
    ∃ k, ∃ hjk : j ≤ k, f j k hjk x ∈ I k := by
  -- First isolate one stage of the directed union containing the given direct-limit element.
  have hdir := directLimit_ideal_family_directed (A := A) (I := I) (f := f) hI
  obtain ⟨k, hk⟩ :=
    (Submodule.mem_iSup_of_directed (fun i ↦ Ideal.map (of A (f · · ·) i) (I i)) hdir).mp hx
  -- Then represent that stage-ideal element by an honest later-stage ideal element.
  obtain ⟨l, hkl, y, hy, hyEq⟩ :=
    exists_ge_stage_ideal_rep_of_mem_mapped_ideal
      (A := A) (I := I) (f := f) hI hk
  rcases exists_ge_ge j l with ⟨m, hjm, hlm⟩
  have hzero :
      of A (f · · ·) m
          (f j m hjm x - f l m hlm y) = 0 := by
    rw [map_sub, Ring.DirectLimit.of_f, Ring.DirectLimit.of_f, hyEq, sub_self]
  obtain ⟨n, hmn, hnzero⟩ :=
    Ring.DirectLimit.of.zero_exact (G := A) (f' := fun i j h ↦ f i j h) hzero
  have hEq :
      f j n (le_trans hjm hmn) x = f l n (le_trans hlm hmn) y := by
    rw [map_sub] at hnzero
    have hEq' := sub_eq_zero.mp hnzero
    simpa [DirectedSystem.map_map' (f := f) hjm hmn x,
      DirectedSystem.map_map' (f := f) hlm hmn y] using hEq'
  refine ⟨n, le_trans hjm hmn, hEq ▸ ?_⟩
  exact (hI (le_trans hlm hmn)) (Ideal.mem_map_of_mem _ hy)

/-- Helper for Lemma 15.11.13: every element of `1 + I∞` is a unit in the direct limit ring. -/
lemma isUnit_one_add_of_mem_directLimit_ideal
    (hI : ∀ ⦃j k⦄ (h : j ≤ k), Ideal.map (f j k h) (I j) ≤ I k)
    [∀ j, HenselianRing (A j) (I j)]
    {x : A∞} (hx : x ∈ I∞) :
    IsUnit (1 + x) := by
  -- Represent `x` at one stage, descend the ideal-membership there, and use the henselian
  -- Jacobson criterion at that stage.
  rcases Ring.DirectLimit.exists_of (G := A) (f := fun i j h ↦ f i j h) x with ⟨j, xj, rfl⟩
  obtain ⟨k, hjk, hkx⟩ :=
    exists_ge_mem_stage_ideal_of_mem_directLimit_ideal
      (A := A) (I := I) (f := f) hI hx
  have hkUnit :
      IsUnit (1 + f j k hjk xj) := by
    have hJac :
        I k ≤ Ring.jacobson (A k) :=
      Ideal.le_ring_jacobson_of_henselianRing (A := A k) (I := I k)
    exact
      (ideal_le_ring_jacobson_iff_isUnit_one_add (R := A k) (I := I k)).mp hJac
        (f j k hjk xj) hkx
  simpa [Ring.DirectLimit.of_f] using IsUnit.map (of A (f · · ·) k) hkUnit

omit [DirectedSystem A (f · · ·)] in
/-- Helper for Lemma 15.11.13: a monic polynomial over the direct limit comes from a monic
polynomial over some stage. -/
lemma exists_monic_stage_polynomial_map_eq
    {F : A∞[X]} (hF : F.Monic) :
    ∃ j, ∃ P : (A j)[X], P.Monic ∧ Polynomial.map (of A (f · · ·) j) P = F := by
  -- First descend the polynomial as an element of the direct-limit polynomial ring.
  obtain ⟨j, P₀, hP₀⟩ :=
    Ring.DirectLimit.Polynomial.exists_of (G := A) (f' := fun i j h ↦ f i j h) F
  have hLift : F ∈ Polynomial.lifts (of A (f · · ·) j) := by
    exact ⟨P₀, hP₀⟩
  -- Then replace the arbitrary lift by a monic one using the standard polynomial-lifts API.
  obtain ⟨P, hPmap, -, hPmonic⟩ :=
    Polynomial.lifts_and_natDegree_eq_and_monic hLift hF
  exact ⟨j, P, hPmonic, hPmap⟩

/-- Helper for Lemma 15.11.13: if the image of a stage element is a unit modulo the colimit ideal,
then some later stage contains an explicit inverse modulo its stage ideal. -/
lemma exists_ge_stage_inverse_mod_ideal_of_directLimit_quotient_isUnit
    (hI : ∀ ⦃j k⦄ (h : j ≤ k), Ideal.map (f j k h) (I j) ≤ I k)
    {j : J} {x : A j}
    (hx : IsUnit ((Ideal.Quotient.mk I∞) (of A (f · · ·) j x))) :
    ∃ k, ∃ hjk : j ≤ k, ∃ u : A k,
      f j k hjk x * u - 1 ∈ I k ∧ u * f j k hjk x - 1 ∈ I k := by
  -- Choose an explicit inverse modulo `I∞`, then lift that inverse to a stage element.
  obtain ⟨u_bar, hxu_bar, hu_barx⟩ := isUnit_iff_exists.mp hx
  obtain ⟨u_inf, rfl⟩ := Ideal.Quotient.mk_surjective u_bar
  obtain ⟨l, y, rfl⟩ := Ring.DirectLimit.exists_of (G := A) (f := fun i j h ↦ f i j h) u_inf
  rcases exists_ge_ge j l with ⟨k, hjk, hlk⟩
  have hleft_mem :
      of A (f · · ·) k (f j k hjk x * f l k hlk y - 1) ∈ I∞ := by
    -- Rewrite the quotient relation `x * u = 1 mod I∞` as membership of the error term in `I∞`.
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    rw [map_sub, map_mul, map_one]
    simpa [Ring.DirectLimit.of_f, sub_eq_zero] using hxu_bar
  have hright_mem :
      of A (f · · ·) k (f l k hlk y * f j k hjk x - 1) ∈ I∞ := by
    -- The symmetric quotient relation gives the right inverse congruence.
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    rw [map_sub, map_mul, map_one]
    simpa [Ring.DirectLimit.of_f, sub_eq_zero] using hu_barx
  obtain ⟨k1, hkk1, hk1⟩ :=
    exists_ge_mem_stage_ideal_of_mem_directLimit_ideal
      (A := A) (I := I) (f := f) hI hleft_mem
  obtain ⟨k2, hkk2, hk2⟩ :=
    exists_ge_mem_stage_ideal_of_mem_directLimit_ideal
      (A := A) (I := I) (f := f) hI hright_mem
  rcases exists_ge_ge k1 k2 with ⟨m, hk1m, hk2m⟩
  refine ⟨m, le_trans hjk (le_trans hkk1 hk1m), f l m (le_trans hlk (le_trans hkk1 hk1m)) y, ?_, ?_⟩
  · -- Transport the left inverse congruence to the common stage `m`.
    have hmem :
        f k1 m hk1m
            (f k k1 hkk1 (f j k hjk x * f l k hlk y - 1)) ∈ I m := by
      exact (hI hk1m) (Ideal.mem_map_of_mem _ hk1)
    simpa [map_sub, map_mul, Ring.DirectLimit.of_f,
      DirectedSystem.map_map' (f := f) hkk1 hk1m (f j k hjk x),
      DirectedSystem.map_map' (f := f) hkk1 hk1m (f l k hlk y),
      DirectedSystem.map_map' (f := f) hjk (le_trans hkk1 hk1m) x,
      DirectedSystem.map_map' (f := f) hlk (le_trans hkk1 hk1m) y] using hmem
  · -- Transport the right inverse congruence to the same common stage.
    have hmem :
        f k2 m hk2m
            (f k k2 hkk2 (f l k hlk y * f j k hjk x - 1)) ∈ I m := by
      exact (hI hk2m) (Ideal.mem_map_of_mem _ hk2)
    simpa [map_sub, map_mul, Ring.DirectLimit.of_f,
      DirectedSystem.map_map' (f := f) hkk2 hk2m (f l k hlk y),
      DirectedSystem.map_map' (f := f) hkk2 hk2m (f j k hjk x),
      DirectedSystem.map_map' (f := f) hlk (le_trans hkk2 hk2m) y,
      DirectedSystem.map_map' (f := f) hjk (le_trans hkk2 hk2m) x,
      mul_comm] using hmem

/-- Helper for Lemma 15.11.13: a quotient unit in the colimit already appears as a quotient unit
at a later stage. -/
lemma exists_ge_quotient_isUnit_of_directLimit_quotient_isUnit
    (hI : ∀ ⦃j k⦄ (h : j ≤ k), Ideal.map (f j k h) (I j) ≤ I k)
    {j : J} {x : A j}
    (hx : IsUnit ((Ideal.Quotient.mk I∞) (of A (f · · ·) j x))) :
    ∃ k, ∃ hjk : j ≤ k, IsUnit ((Ideal.Quotient.mk (I k)) (f j k hjk x)) := by
  -- First descend an explicit two-sided inverse modulo a stage ideal.
  obtain ⟨k, hjk, u, hleft, hright⟩ :=
    exists_ge_stage_inverse_mod_ideal_of_directLimit_quotient_isUnit
      (A := A) (I := I) (f := f) hI hx
  refine ⟨k, hjk, isUnit_iff_exists.mpr ?_⟩
  refine ⟨(Ideal.Quotient.mk (I k)) u, ?_, ?_⟩
  · -- The left inverse congruence becomes an equality in the stage quotient.
    have hzero : (Ideal.Quotient.mk (I k)) (f j k hjk x * u - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hleft
    exact sub_eq_zero.mp (by simpa [map_sub, map_mul, RingHom.map_one] using hzero)
  · -- The right inverse congruence gives the opposite equality.
    have hzero : (Ideal.Quotient.mk (I k)) (u * f j k hjk x - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hright
    exact sub_eq_zero.mp (by simpa [map_sub, map_mul, RingHom.map_one] using hzero)

/-- Helper for Lemma 15.11.13: the monic polynomial, approximate root, evaluation hypothesis, and
derivative-unit hypothesis descend simultaneously to one stage. -/
lemma exists_stage_henselian_data
    (hI : ∀ ⦃j k⦄ (h : j ≤ k), Ideal.map (f j k h) (I j) ≤ I k)
    [∀ j, HenselianRing (A j) (I j)]
    {F : A∞[X]} (hF : F.Monic) {a0 : A∞}
    (ha0 : F.eval a0 ∈ I∞)
    (hderiv : IsUnit ((Ideal.Quotient.mk I∞) (F.derivative.eval a0))) :
    ∃ m, ∃ Q : (A m)[X], ∃ a : A m,
      Q.Monic ∧
        Polynomial.map (of A (f · · ·) m) Q = F ∧
          of A (f · · ·) m a = a0 ∧
            Q.eval a ∈ I m ∧
              IsUnit ((Ideal.Quotient.mk (I m)) (Q.derivative.eval a)) := by
  -- First descend the polynomial and the approximate root to a common stage.
  obtain ⟨jP, P, hPmonic, hPmap⟩ :=
    exists_monic_stage_polynomial_map_eq (A := A) (f := f) hF
  obtain ⟨ja, a_stage, ha_stage⟩ :=
    Ring.DirectLimit.exists_of (G := A) (f := fun i j h ↦ f i j h) a0
  rcases exists_ge_ge jP ja with ⟨k, hjPk, hjak⟩
  let Qk : (A k)[X] := Polynomial.map (f jP k hjPk) P
  let ak : A k := f ja k hjak a_stage
  have hQkMonic : Qk.Monic := by
    -- Monicity is preserved when moving the polynomial to a later stage.
    simpa [Qk] using hPmonic.map (f jP k hjPk)
  have hak : of A (f · · ·) k ak = a0 := by
    -- The approximate root is represented at the common stage `k`.
    simp [ak, ha_stage, Ring.DirectLimit.of_f]
  have hQkmap : Polynomial.map (of A (f · · ·) k) Qk = F := by
    -- Mapping the common-stage polynomial to the colimit recovers the original polynomial.
    dsimp [Qk]
    calc
      Polynomial.map (of A (f · · ·) k) (Polynomial.map (f jP k hjPk) P)
          = Polynomial.map ((of A (f · · ·) k).comp (f jP k hjPk)) P := by
              rw [Polynomial.map_map]
      _ = Polynomial.map (of A (f · · ·) jP) P := by
            congr
            ext x
            simp [RingHom.comp_apply, Ring.DirectLimit.of_f]
      _ = F := hPmap
  have hEvalk :
      of A (f · · ·) k (Qk.eval ak) = F.eval a0 := by
    -- Evaluate after mapping to compare the stage polynomial with `F`.
    calc
      of A (f · · ·) k (Qk.eval ak)
          = Polynomial.eval₂ (of A (f · · ·) k) (of A (f · · ·) k ak) Qk := by
              simpa using (Polynomial.eval₂_at_apply (p := Qk) (of A (f · · ·) k) ak).symm
      _ = Polynomial.eval (of A (f · · ·) k ak) (Polynomial.map (of A (f · · ·) k) Qk) := by
            rw [Polynomial.eval₂_eq_eval_map]
      _ = F.eval a0 := by simp [hQkmap, hak]
  have hDerivk :
      of A (f · · ·) k (Qk.derivative.eval ak) = F.derivative.eval a0 := by
    -- The derivative behaves compatibly with polynomial maps to the colimit.
    calc
      of A (f · · ·) k (Qk.derivative.eval ak)
          = Polynomial.eval₂ (of A (f · · ·) k) (of A (f · · ·) k ak) Qk.derivative := by
              simpa using
                (Polynomial.eval₂_at_apply (p := Qk.derivative) (of A (f · · ·) k) ak).symm
      _ = Polynomial.eval (of A (f · · ·) k ak)
            (Polynomial.map (of A (f · · ·) k) Qk.derivative) := by
              rw [Polynomial.eval₂_eq_eval_map]
      _ = Polynomial.eval (of A (f · · ·) k ak)
            (Polynomial.derivative (Polynomial.map (of A (f · · ·) k) Qk)) := by
              rw [← Polynomial.derivative_map]
      _ = F.derivative.eval a0 := by simp [hQkmap, hak]
  have hEvalk_mem : of A (f · · ·) k (Qk.eval ak) ∈ I∞ := by
    -- The colimit evaluation hypothesis now comes from the stage-`k` evaluation.
    rw [hEvalk]
    exact ha0
  obtain ⟨l, hkl, hEvall_raw⟩ :=
    exists_ge_mem_stage_ideal_of_mem_directLimit_ideal
      (A := A) (I := I) (f := f) hI hEvalk_mem
  let Ql : (A l)[X] := Polynomial.map (f k l hkl) Qk
  let al : A l := f k l hkl ak
  have hQlMonic : Ql.Monic := by
    -- Monicity persists after one more stage enlargement.
    simpa [Ql] using hQkMonic.map (f k l hkl)
  have hEvall :
      Ql.eval al = f k l hkl (Qk.eval ak) := by
    -- Evaluation commutes with moving from stage `k` to stage `l`.
    dsimp [Ql, al]
    rw [← Polynomial.eval₂_eq_eval_map]
    exact Polynomial.eval₂_at_apply (p := Qk) (f k l hkl) ak
  have hEvall_mem : Ql.eval al ∈ I l := by
    -- Rewrite the descended evaluation witness into the current stage notation.
    rw [hEvall]
    exact hEvall_raw
  have hDerivl :
      Ql.derivative.eval al = f k l hkl (Qk.derivative.eval ak) := by
    -- The derivative evaluation also commutes with this stage enlargement.
    dsimp [Ql, al]
    rw [Polynomial.derivative_map, ← Polynomial.eval₂_eq_eval_map]
    exact Polynomial.eval₂_at_apply (p := Qk.derivative) (f k l hkl) ak
  have hDerivl_colim :
      of A (f · · ·) l (Ql.derivative.eval al) = F.derivative.eval a0 := by
    -- The stage-`l` derivative evaluation still represents the original colimit element.
    rw [hDerivl, Ring.DirectLimit.of_f]
    exact hDerivk
  have hDerivl_unit :
      IsUnit ((Ideal.Quotient.mk I∞) (of A (f · · ·) l (Ql.derivative.eval al))) := by
    -- Transfer the derivative-unit hypothesis onto the stage-`l` representative.
    rw [hDerivl_colim]
    exact hderiv
  obtain ⟨m, hlm, hDerivm_unit_raw⟩ :=
    exists_ge_quotient_isUnit_of_directLimit_quotient_isUnit
      (A := A) (I := I) (f := f) hI hDerivl_unit
  let Qm : (A m)[X] := Polynomial.map (f l m hlm) Ql
  let am : A m := f l m hlm al
  have hQmMonic : Qm.Monic := by
    -- The final stage polynomial stays monic.
    simpa [Qm] using hQlMonic.map (f l m hlm)
  have hEvalm :
      Qm.eval am = f l m hlm (Ql.eval al) := by
    -- Evaluation commutes with the last stage enlargement.
    dsimp [Qm, am]
    rw [← Polynomial.eval₂_eq_eval_map]
    exact Polynomial.eval₂_at_apply (p := Ql) (f l m hlm) al
  have hEvalm_mem : Qm.eval am ∈ I m := by
    -- Transport the stage-`l` evaluation membership to the final stage `m`.
    rw [hEvalm]
    exact (hI hlm) (Ideal.mem_map_of_mem _ hEvall_mem)
  have hDerivm :
      Qm.derivative.eval am = f l m hlm (Ql.derivative.eval al) := by
    -- The derivative evaluation has the same compatibility at the final stage.
    dsimp [Qm, am]
    rw [Polynomial.derivative_map, ← Polynomial.eval₂_eq_eval_map]
    exact Polynomial.eval₂_at_apply (p := Ql.derivative) (f l m hlm) al
  have hDerivm_unit :
      IsUnit ((Ideal.Quotient.mk (I m)) (Qm.derivative.eval am)) := by
    -- Rewrite the descended quotient unit in terms of the final stage polynomial.
    rw [hDerivm]
    exact hDerivm_unit_raw
  have hQlmap : Polynomial.map (of A (f · · ·) l) Ql = F := by
    -- Moving `Ql` to the colimit recovers the original polynomial.
    dsimp [Ql]
    calc
      Polynomial.map (of A (f · · ·) l) (Polynomial.map (f k l hkl) Qk)
          = Polynomial.map ((of A (f · · ·) l).comp (f k l hkl)) Qk := by
              rw [Polynomial.map_map]
      _ = Polynomial.map (of A (f · · ·) k) Qk := by
            congr
            ext x
            simp [RingHom.comp_apply, Ring.DirectLimit.of_f]
      _ = F := hQkmap
  have hQmmap : Polynomial.map (of A (f · · ·) m) Qm = F := by
    -- The same compatibility holds for the final stage polynomial `Qm`.
    dsimp [Qm]
    calc
      Polynomial.map (of A (f · · ·) m) (Polynomial.map (f l m hlm) Ql)
          = Polynomial.map ((of A (f · · ·) m).comp (f l m hlm)) Ql := by
              rw [Polynomial.map_map]
      _ = Polynomial.map (of A (f · · ·) l) Ql := by
            congr
            ext x
            simp [RingHom.comp_apply, Ring.DirectLimit.of_f]
      _ = F := hQlmap
  have ham : of A (f · · ·) m am = a0 := by
    -- The lifted approximate root still maps to the original residue class.
    simp [am, al, ak, ha_stage, Ring.DirectLimit.of_f]
  exact ⟨m, Qm, am, hQmMonic, hQmmap, ham, hEvalm_mem, hDerivm_unit⟩

-- Proof sketch: first show that every element of `1 + I∞` comes from some stage and is therefore
-- a unit by the Jacobson-radical condition there, giving the chapter-level containment
-- `I∞ ≤ Ring.jacobson A∞`. Then descend a monic polynomial over `A∞` and a coprime factorization
-- of its reduction modulo `I∞` to a common stage, apply the henselian lifting property in that
-- stage, and map the lifted factorization to the direct limit.
/-- Lemma 15.11.13: filtered colimits of henselian pairs are henselian. More precisely, if the
stage ideals form a directed system of henselian pairs over a directed set, then the supremum of
their images in the ring direct limit is a henselian ideal of the direct limit ring. -/
@[stacks 0FWT]
instance directedSystem_directLimit_henselianRing
    (hI : ∀ ⦃j k⦄ (h : j ≤ k), Ideal.map (f j k h) (I j) ≤ I k)
    [∀ j, HenselianRing (A j) (I j)] :
    HenselianRing A∞ I∞ :=
  by
    refine ⟨?_, ?_⟩
    · -- The Jacobson-radical clause is reduced to the stagewise unit criterion on `1 + I∞`.
      simpa [Ideal.jacobson_bot] using
        (ideal_le_ring_jacobson_iff_isUnit_one_add (R := A∞) (I := I∞)).2
          (fun x hx ↦ isUnit_one_add_of_mem_directLimit_ideal
            (A := A) (I := I) (f := f) hI hx)
    · intro F hF a0 ha0 hderiv
      obtain ⟨m, Q, a_stage, hQMonic, hQmap, ha_stage, hEval, hUnit⟩ :=
        exists_stage_henselian_data
          (A := A) (I := I) (f := f) hI hF ha0 hderiv
      obtain ⟨b, hbroot, hbmem⟩ :=
        HenselianRing.is_henselian Q hQMonic a_stage hEval hUnit
      refine ⟨of A (f · · ·) m b, ?_, ?_⟩
      · -- The lifted stage root remains a root after mapping to the colimit.
        rw [Polynomial.IsRoot.def, ← hQmap, Polynomial.eval_map]
        simpa [Polynomial.IsRoot.def.mp hbroot] using
          (Polynomial.eval₂_at_apply (p := Q) (of A (f · · ·) m) b)
      · -- Map the stage congruence `b - am ∈ I m` into the colimit ideal.
        have hmem :
            of A (f · · ·) m (b - a_stage) ∈ I∞ := by
          exact Ideal.mem_iSup_of_mem m (Ideal.mem_map_of_mem _ hbmem)
        simpa [map_sub, ha_stage] using hmem

end
