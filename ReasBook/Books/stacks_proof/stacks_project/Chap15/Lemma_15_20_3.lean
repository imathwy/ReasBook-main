  let _ : Algebra.FinitePresentation R S := inferInstance
  let _ : Module.FinitePresentation S M := inferInstance
  -- Proof comment: the stage transition maps are already local; the remaining work is the direct
  -- limit comparison and closed-point ideal transport required by Lemma `15.18.3`.
  have hstageLocal :
      ∀ {s t : Finset R'} (hst : s ⊆ t),
        IsLocalHom (finite_adjoin_local_stage_transition (R := R) (R' := R') hst) := by
    intro s t hst
    exact finite_adjoin_local_stage_transition_isLocalHom
      (R := R) (R' := R') hst
  let A := fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s
  let φ := fun s t hst ↦
    finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') hst
  let ρ := fun s t hst ↦ (φ s t hst : A s →+* A t)
  let IStage := fun s : Finset R' ↦ maximalIdeal (A s)
