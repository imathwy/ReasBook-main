      ∀ ⦃s t : Finset R'⦄, (hst : s ⊆ t) →
        Ideal.map (ρ s t hst) (IStage s) ≤ IStage t := by
    intro s t hst
    -- Proof comment: this is the exact ideal-compatibility datum required by Lemma `15.18.3`.
    simpa [A, φ, ρ, IStage] using
      finite_adjoin_local_stage_transition_map_maximalIdeal_le
        (R := R) (R' := R') hst
  let A∞ := Ring.DirectLimit A ρ
  let I∞ : Ideal A∞ := ⨆ s, Ideal.map (Ring.DirectLimit.of A ρ s) (IStage s)
  have hI∞ :
      Ideal.map
          (finite_adjoin_local_stage_directLimitAlgEquivTarget
            (R := R) (R' := R')).toRingHom
