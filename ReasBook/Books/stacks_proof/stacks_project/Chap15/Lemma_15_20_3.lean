/-- Helper for Lemma 15.20.3: the colimit ideal generated by the maximal ideals of the finite
localized adjoin stages maps to the maximal ideal of `R'` under the direct-limit comparison. -/
private lemma finite_adjoin_local_stage_directLimit_maximalIdeal :
    let A := fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s
    let ρ := fun s t hst ↦
      (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') hst : A s →+* A t)
    let A∞ := Ring.DirectLimit A ρ
    let e :=
      finite_adjoin_local_stage_directLimitAlgEquivTarget (R := R) (R' := R')
    let I∞ : Ideal A∞ := ⨆ s, Ideal.map (Ring.DirectLimit.of A ρ s) (maximalIdeal (A s))
    Ideal.map e.toRingHom I∞ = maximalIdeal R' := by
  let A := fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s
  let ρ := fun s t hst ↦
    (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') hst : A s →+* A t)
  let A∞ := Ring.DirectLimit A ρ
  let e := finite_adjoin_local_stage_directLimitAlgEquivTarget (R := R) (R' := R')
  let I∞ : Ideal A∞ := ⨆ s, Ideal.map (Ring.DirectLimit.of A ρ s) (maximalIdeal (A s))
  have hle :
      Ideal.map e.toRingHom I∞ ≤ maximalIdeal R' := by
    refine Ideal.map_le_iff_le_comap.mpr ?_
    refine iSup_le fun s ↦ ?_
    rw [Ideal.map_le_iff_le_comap]
    change maximalIdeal (A s) ≤
      Ideal.comap ((e.toRingHom).comp (Ring.DirectLimit.of A ρ s)) (maximalIdeal R')
    have hcomp :
        (e.toRingHom).comp (Ring.DirectLimit.of A ρ s) =
          finite_adjoin_local_stage_to_target (R := R) (R' := R') s := by
      ext x
      simpa [e, finite_adjoin_local_stage_directLimitAlgEquivTarget, RingHom.comp_apply] using
        congrArg
          (fun f : A s →+* R' ↦ f x)
          (finite_adjoin_local_stage_directLimitToTarget_comp_of
            (R := R) (R' := R') s)
    simpa [hcomp] using
      (show maximalIdeal (A s) ≤
        Ideal.comap
          (finite_adjoin_local_stage_to_target (R := R) (R' := R') s)
          (maximalIdeal R') by
            simpa using
              (show maximalIdeal (A s) ≤ maximalIdeal (A s) from le_rfl :
                maximalIdeal (A s) ≤
                  Ideal.comap
                    (finite_adjoin_local_stage_to_target (R := R) (R' := R') s)
                    (maximalIdeal R')))
  have hpre :
      Ideal.comap e.toRingHom (maximalIdeal R') ≤ I∞ := by
    intro z hz
    rcases Ring.DirectLimit.exists_of (G := A) (f := ρ) z with ⟨s, zs, rfl⟩
    have hz' :
        finite_adjoin_local_stage_to_target (R := R) (R' := R') s zs ∈ maximalIdeal R' := by
      simpa [e, finite_adjoin_local_stage_directLimitAlgEquivTarget, RingHom.comp_apply] using hz
    have hzStage : zs ∈ maximalIdeal (A s) := by
      have hcomap :
          Ideal.comap
              (finite_adjoin_local_stage_to_target (R := R) (R' := R') s)
              (maximalIdeal R') =
            maximalIdeal (A s) := by
        simpa using
          (IsLocalHom.comap_maximalIdeal
            (f := finite_adjoin_local_stage_to_target (R := R) (R' := R') s))
      simpa [hcomap] using hz'
    exact le_iSup_of_le s ⟨zs, hzStage, rfl⟩
  have hge :
      maximalIdeal R' ≤ Ideal.map e.toRingHom I∞ := by
    calc
      maximalIdeal R' =
          Ideal.map e.toRingHom (Ideal.comap e.toRingHom (maximalIdeal R')) := by
            symm
            exact Ideal.map_comap_of_surjective e.surjective _
      _ ≤ Ideal.map e.toRingHom I∞ := Ideal.map_mono hpre
  exact le_antisymm hle hge

/-- Helper for Lemma 15.20.3: enlarging the finite adjoin stage maps the closed-point maximal
ideal of the smaller stage into the closed-point maximal ideal of the larger stage. -/
private lemma finite_adjoin_local_stage_transition_map_maximalIdeal_le
    {s t : Finset R'} (hst : s ⊆ t) :
    Ideal.map
        (finite_adjoin_local_stage_transition (R := R) (R' := R') hst)
        (maximalIdeal (finite_adjoin_local_stage (R := R) (R' := R') s)) ≤
      maximalIdeal (finite_adjoin_local_stage (R := R) (R' := R') t) := by
  -- Proof comment: the stage transition is a local ring homomorphism, so its comap of the target
  -- maximal ideal is exactly the source maximal ideal.
  rw [Ideal.map_le_iff_le_comap]
  have hcomap :
      Ideal.comap
          (finite_adjoin_local_stage_transition (R := R) (R' := R') hst)
          (maximalIdeal (finite_adjoin_local_stage (R := R) (R' := R') t)) =
        maximalIdeal (finite_adjoin_local_stage (R := R) (R' := R') s) := by
    simpa using
      (IsLocalHom.comap_maximalIdeal
        (f := finite_adjoin_local_stage_transition (R := R) (R' := R') hst))
  simpa [hcomap]

