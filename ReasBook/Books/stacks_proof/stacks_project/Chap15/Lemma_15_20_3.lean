        maximalIdeal R' := by
    -- Proof comment: the existing direct-limit comparison already identifies the colimit closed
    -- point with the target closed point.
    simpa [A, φ, ρ, IStage, A∞, I∞] using
      finite_adjoin_local_stage_directLimit_maximalIdeal (R := R) (R' := R')
  have hflat_inf :
      zeroLocus
          (Ideal.map (algebraMap A∞ (S ⊗[R] A∞)) I∞ : Set (S ⊗[R] A∞)) ⊆
        Module.flatOverBaseLocus A∞ (S ⊗[R] A∞) ((S ⊗[R] A∞) ⊗[S] M) := by
    -- TODO: transport the given `hflat` on `S ⊗[R] R'` to the direct-limit model using
    -- `finite_adjoin_local_stage_directLimitAlgEquivTarget`, then rewrite the colimit ideal with
    -- `hI∞`.
    sorry
  obtain ⟨s, hs⟩ :=
    exists_stage_zeroLocus_subset_flatOverBaseLocus_of_direct_limit_base_change
      (R := R) (S := S) (M := M) (A := A) (φ := φ) (I := IStage) hIStage hflat_inf
  -- Proof comment: after the direct-limit descent owner theorem chooses a stage, only the local
  -- notational wrappers around that stage remain to be removed.
  refine ⟨s, ?_⟩
