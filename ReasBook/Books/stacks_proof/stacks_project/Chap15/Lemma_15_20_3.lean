private lemma exists_finite_adjoin_local_stage_zeroLocus_subset_flatOverBaseLocus
    {I : Ideal R}
    (hflat :
      zeroLocus (Ideal.map (algebraMap R' S') (maximalIdeal R') : Set S') ⊆
        Module.flatOverBaseLocus R' S' M') :
    ∃ s : Finset R',
      zeroLocus
          (Ideal.map
            (algebraMap
              (finite_adjoin_local_stage (R := R) (R' := R') s)
              (S ⊗[R] finite_adjoin_local_stage (R := R) (R' := R') s))
            (maximalIdeal (finite_adjoin_local_stage (R := R) (R' := R') s)) :
            Set (S ⊗[R] finite_adjoin_local_stage (R := R) (R' := R') s)) ⊆
        Module.flatOverBaseLocus
          (finite_adjoin_local_stage (R := R) (R' := R') s)
          (S ⊗[R] finite_adjoin_local_stage (R := R) (R' := R') s)
          (((S ⊗[R] finite_adjoin_local_stage (R := R) (R' := R') s)) ⊗[S] M) := by
