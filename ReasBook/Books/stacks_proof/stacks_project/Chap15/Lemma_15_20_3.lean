import stacks_proof.stacks_project.Chap15.Lemma_15_17_2
import stacks_proof.stacks_project.Chap15.Lemma_15_18_1
import stacks_proof.stacks_project.Chap15.Lemma_15_18_3
import stacks_proof.stacks_project.Chap15.Lemma_15_20_2
import Mathlib.Tactic.StacksAttribute

-- Declarations for this item will be appended below by the statement pipeline.

open PrimeSpectrum IsLocalRing
open scoped TensorProduct

universe u v w x

section

variable {R : Type u} {S : Type v} {M : Type w} {R' : Type x}
variable [CommRing R] [CommRing S] [CommRing R'] [Algebra R S] [Algebra R R']
variable [IsLocalRing R] [IsLocalRing R'] [IsLocalHom (algebraMap R R')]
variable [IsNoetherianRing R] [Algebra.FiniteType R S]
variable [AddCommGroup M] [Module S M] [Module.Finite S M]

attribute [local instance] Algebra.TensorProduct.rightAlgebra
attribute [local instance] quotientModule_module_over_baseQuotient quotientModule_isScalarTower

local notation "S'" => S ⊗[R] R'
local notation "M'" => S' ⊗[S] M
local notation "Sbar[" J "]" => S ⧸ Ideal.map (algebraMap R S) J
local notation "Mbar[" J "]" => M ⧸ ((Ideal.map (algebraMap R S) J) • (⊤ : Submodule S M))

/-- Helper for Lemma 15.20.3: the finite `R`-subalgebra of `R'` generated by a chosen finite
subset. -/
private abbrev finite_adjoin_local_stage_subalgebra (s : Finset R') : Subalgebra R R' :=
  Algebra.adjoin R (↑s : Set R')

/-- Helper for Lemma 15.20.3: the prime of a finite adjoin stage lying under the closed point of
`R'`. -/
private abbrev finite_adjoin_local_stage_prime (s : Finset R') :
    Ideal (finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s) :=
  Ideal.comap
    (algebraMap (finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s) R')
    (maximalIdeal R')

/-- Helper for Lemma 15.20.3: the localized finite adjoin stage used in the source proof. -/
private abbrev finite_adjoin_local_stage (s : Finset R') : Type x :=
  Localization.AtPrime (finite_adjoin_local_stage_prime (R := R) (R' := R') s)

/-- Helper for Lemma 15.20.3: enlarging the finite set of generators enlarges the underlying
finite adjoin stage. -/
private lemma finite_adjoin_local_stage_subalgebra_mono
    {s t : Finset R'} (hst : s ⊆ t) :
    finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s ≤
      finite_adjoin_local_stage_subalgebra (R := R) (R' := R') t := by
  -- Proof comment: monotonicity of `Algebra.adjoin` is the algebraic stage-growth relation from
  -- the source proof.
  exact Algebra.adjoin_mono (show (↑s : Set R') ⊆ (↑t : Set R') from hst)

/-- Helper for Lemma 15.20.3: the canonical map from a finite localized adjoin stage to the final
local target `R'`. -/
private noncomputable abbrev finite_adjoin_local_stage_to_target
    (s : Finset R') :
    finite_adjoin_local_stage (R := R) (R' := R') s →+* R' :=
  Localization.localRingHom
    (finite_adjoin_local_stage_prime (R := R) (R' := R') s)
    (maximalIdeal R')
    (algebraMap (finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s) R')
    rfl

/-- Helper for Lemma 15.20.3: the inclusion of smaller finite adjoin stages into larger ones
preserves the prime lying under the target closed point. -/
private lemma finite_adjoin_local_stage_prime_comap
    {s t : Finset R'} (hst : s ⊆ t) :
    Ideal.comap
        ((Subalgebra.inclusion
          (finite_adjoin_local_stage_subalgebra_mono (R := R) (R' := R') hst)).toRingHom)
        (finite_adjoin_local_stage_prime (R := R) (R' := R') t) =
      finite_adjoin_local_stage_prime (R := R) (R' := R') s := by
  -- Proof comment: the stage inclusion is literally the identity on elements of `R'`, so the
  -- pulled-back closed-point prime is unchanged.
  ext x
  change
    algebraMap (finite_adjoin_local_stage_subalgebra (R := R) (R' := R') t) R'
        ((Subalgebra.inclusion
          (finite_adjoin_local_stage_subalgebra_mono (R := R) (R' := R') hst)) x) ∈
      maximalIdeal R' ↔
      algebraMap (finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s) R' x ∈
        maximalIdeal R'
  rfl

/-- Helper for Lemma 15.20.3: enlarging the finite generating set induces the localized stage
transition map used in the later direct-limit descent. -/
private noncomputable abbrev finite_adjoin_local_stage_transition
    {s t : Finset R'} (hst : s ⊆ t) :
    finite_adjoin_local_stage (R := R) (R' := R') s →+*
      finite_adjoin_local_stage (R := R) (R' := R') t :=
  Localization.localRingHom
    (finite_adjoin_local_stage_prime (R := R) (R' := R') s)
    (finite_adjoin_local_stage_prime (R := R) (R' := R') t)
    ((Subalgebra.inclusion
      (finite_adjoin_local_stage_subalgebra_mono (R := R) (R' := R') hst)).toRingHom)
    (finite_adjoin_local_stage_prime_comap (R := R) (R' := R') hst).symm

/-- Helper for Lemma 15.20.3: the localized transition maps are local ring homomorphisms. -/
private lemma finite_adjoin_local_stage_transition_isLocalHom
    {s t : Finset R'} (hst : s ⊆ t) :
    IsLocalHom (finite_adjoin_local_stage_transition (R := R) (R' := R') hst) := by
  -- Proof comment: every localization map at a prime is local.
  simpa [finite_adjoin_local_stage_transition] using
    (Localization.isLocalHom_localRingHom
      (finite_adjoin_local_stage_prime (R := R) (R' := R') s)
      (finite_adjoin_local_stage_prime (R := R) (R' := R') t)
      ((Subalgebra.inclusion
        (finite_adjoin_local_stage_subalgebra_mono (R := R) (R' := R') hst)).toRingHom)
      (finite_adjoin_local_stage_prime_comap (R := R) (R' := R') hst).symm)

/-- Helper for Lemma 15.20.3: the stage-to-target maps commute with the localized transition maps.
-/
private lemma finite_adjoin_local_stage_to_target_comp_transition
    {s t : Finset R'} (hst : s ⊆ t) :
    (finite_adjoin_local_stage_to_target (R := R) (R' := R') t).comp
        (finite_adjoin_local_stage_transition (R := R) (R' := R') hst) =
      finite_adjoin_local_stage_to_target (R := R) (R' := R') s := by
  -- Proof comment: both localized maps are induced from the same composite into `R'`.
  symm
  refine Localization.localRingHom_unique
    (finite_adjoin_local_stage_prime (R := R) (R' := R') s)
    (maximalIdeal R')
    (algebraMap (finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s) R')
    rfl fun x ↦ ?_
  simp only [finite_adjoin_local_stage_to_target, finite_adjoin_local_stage_transition,
    RingHom.comp_apply, Localization.localRingHom_to_map]
  rfl

/-- Helper for Lemma 15.20.3: each finite localized stage embeds into the final local target. -/
private lemma finite_adjoin_local_stage_to_target_injective
    (s : Finset R') :
    Function.Injective (finite_adjoin_local_stage_to_target (R := R) (R' := R') s) := by
  let B := finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s
  let p := finite_adjoin_local_stage_prime (R := R) (R' := R') s
  let _ : IsLocalization (maximalIdeal R').primeCompl R' :=
    self_isLocalization_primeCompl_maximalIdeal R'
  have hB : Function.Injective (algebraMap B R') := by
    -- Proof comment: the structure map from a subalgebra to its ambient ring is the subtype
    -- inclusion, hence injective.
    intro x y hxy
    exact Subtype.ext hxy
  have hp :
      p.primeCompl ≤ Submonoid.comap (algebraMap B R') (maximalIdeal R').primeCompl := by
    -- Proof comment: `p` is defined as the pullback of the closed point of `R'`.
    exact Localization.le_comap_primeCompl_iff.mpr (ge_of_eq rfl)
  let _ : Algebra (finite_adjoin_local_stage (R := R) (R' := R') s) R' :=
    (finite_adjoin_local_stage_to_target (R := R) (R' := R') s).toAlgebra
  -- Proof comment: localizing an injective map remains injective once the target ring is viewed
  -- as the localization at its maximal-ideal complement.
  simpa [B, p, finite_adjoin_local_stage, finite_adjoin_local_stage_to_target,
    RingHom.algebraMap_toAlgebra] using
    (IsLocalization.map_injective_of_injective'
      p.primeCompl
      R'
      R'
      hp
      (show (0 : R') ∉ Ideal.primeCompl (maximalIdeal R') by
        simp [Ideal.primeCompl])
      hB)

/-- Helper for Lemma 15.20.3: if `I` maps to zero in `R'`, then `R → R'` factors through the
quotient `R ⧸ I`. -/
noncomputable def quotient_algebraMap_of_map_eq_bot
    {I : Ideal R}
    (hmap : Ideal.map (algebraMap R R') I = ⊥) :
    R ⧸ I →+* R' :=
  Ideal.Quotient.lift I (algebraMap R R')
    ((Ideal.map_eq_bot_iff_le_ker (algebraMap R R')).mp hmap)

/-- Helper for Lemma 15.20.3: the quotient factorization recovers the original map after
precomposing with the quotient projection. -/
lemma quotient_algebraMap_of_map_eq_bot_comp_mk
    {I : Ideal R}
    (hmap : Ideal.map (algebraMap R R') I = ⊥) :
    (quotient_algebraMap_of_map_eq_bot (R := R) (R' := R') hmap).comp (Ideal.Quotient.mk I) =
      algebraMap R R' := by
  -- Proof comment: this is the defining compatibility of `Ideal.Quotient.lift`.
  ext r
  rfl

/-- Helper for Lemma 15.20.3: vanishing of `I` after passing to an intermediate stage forces
vanishing after composing with the map to the final local target. -/
lemma ideal_map_eq_bot_of_stage_factorization
    {A : Type*} [CommRing A] [Algebra R A] [Algebra A R'] [Algebra R R']
    [IsScalarTower R A R']
    {I : Ideal R}
    (hA : Ideal.map (algebraMap R A) I = ⊥) :
    Ideal.map (algebraMap R R') I = ⊥ := by
  -- Proof comment: push the stage equality forward along `A → R'` and rewrite the composite map
  -- through the scalar-tower algebra map.
  calc
    Ideal.map (algebraMap R R') I =
        Ideal.map (algebraMap A R') (Ideal.map (algebraMap R A) I) := by
          rw [Ideal.map_map]
          congr 1
          ext r
          simp [IsScalarTower.algebraMap_eq R A R']
    _ = Ideal.map (algebraMap A R') ⊥ := by rw [hA]
    _ = ⊥ := Ideal.map_bot

/-- Helper for Lemma 15.20.3: once `I` vanishes in `R'`, the induced map `R ⧸ I → R'` sends the
closed point of `Spec (R ⧸ I)` into the closed point of `Spec R'`. -/
lemma quotient_maximalIdeal_map_le_target_maximalIdeal
    {I : Ideal R}
    (hI : I ≤ maximalIdeal R)
    (hmap : Ideal.map (algebraMap R R') I = ⊥) :
    Ideal.map (quotient_algebraMap_of_map_eq_bot (R := R) (R' := R') hmap)
      (maximalIdeal (R ⧸ I)) ≤ maximalIdeal R' := by
  let _ : IsLocalRing (R ⧸ I) := IsLocalRing.quotient I <|
    ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top hI
  have hmax :
      Ideal.map (Ideal.Quotient.mk I) (maximalIdeal R) = maximalIdeal (R ⧸ I) := by
    exact IsLocalRing.map_maximalIdeal_of_surjective
      (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  -- Proof comment: after rewriting the quotient maximal ideal as the image of `maximalIdeal R`,
  -- functoriality reduces the claim to the standard local-hom containment for `R → R'`.
  rw [← hmax]
  calc
    Ideal.map (quotient_algebraMap_of_map_eq_bot (R := R) (R' := R') hmap)
        (Ideal.map (Ideal.Quotient.mk I) (maximalIdeal R)) =
      Ideal.map (algebraMap R R') (maximalIdeal R) := by
        rw [Ideal.map_map, quotient_algebraMap_of_map_eq_bot_comp_mk]
    _ ≤ maximalIdeal R' := by
        have hcomap :
            Ideal.comap (algebraMap R R') (maximalIdeal R') = maximalIdeal R := by
          simpa using (IsLocalHom.comap_maximalIdeal (f := algebraMap R R'))
        exact Ideal.map_le_iff_le_comap.mpr <| by
          simpa [hcomap] using (show maximalIdeal R ≤ maximalIdeal R by exact le_rfl)

/-- Helper for Lemma 15.20.3: after `I` vanishes in `R'`, the quotient-side base-changed module
is globally identified with the target module `M'`. -/
private noncomputable def quotient_baseChange_target_linearEquiv
    {I : Ideal R}
    (hmap : Ideal.map (algebraMap R R') I = ⊥) :
    ((((Sbar[I]) ⊗[R ⧸ I] R') ⊗[Sbar[I]] Mbar[I])) ≃ₗ[R'] M' := by
  let φ : R ⧸ I →ₐ[R] R' := quotient_factor_alg_hom (R := R) (R' := R') hmap
  let _ : Algebra (R ⧸ I) R' := φ.toRingHom.toAlgebra
  let eCancelQuot :
      ((((Sbar[I]) ⊗[R ⧸ I] R') ⊗[Sbar[I]] Mbar[I])) ≃ₗ[R']
        (R' ⊗[R ⧸ I] Mbar[I]) :=
    Algebra.IsPushout.cancelBaseChange
      (R ⧸ I) R' (Sbar[I]) ((Sbar[I]) ⊗[R ⧸ I] R') Mbar[I]
  let eFactor :
      (R' ⊗[R ⧸ I] Mbar[I]) ≃ₗ[R']
        (R' ⊗[R] Mbar[I]) :=
    factor_tensor_quotient_equiv_base_tensor_quotient
      (R := R) (M := M) (R' := R') (J := I)
  let eTensor :
      (R' ⊗[R] Mbar[I]) ≃ₗ[R'] (R' ⊗[R] M) :=
    base_tensor_quotient_equiv_tensor_of_map_eq_bot
      (R := R) (M := M) (R' := R') (J := I) hmap
  let eTarget :
      (R' ⊗[R] M) ≃ₗ[R'] M' :=
    (Algebra.IsPushout.cancelBaseChange R R' S S' M).symm
  -- Proof comment: normalize the quotient-side tensor presentation in the same order as the
  -- source proof: cancel the quotient pushout, remove the quotient base ring, kill the quotient
  -- submodule using `hmap`, and finally recover the target tensor model `M'`.
  exact eCancelQuot.trans (eFactor.trans (eTensor.trans eTarget))

/-- Helper for Lemma 15.20.3: localizing the finite `R`-subalgebra generated by a finite subset
of `R'` at the prime over `maximalIdeal R'` produces a local essentially-finite-type, hence
Noetherian, `R`-algebra stage. -/
lemma finite_adjoin_local_stage_structure
    (s : Finset R') :
    let B : Subalgebra R R' := Algebra.adjoin R (↑s : Set R')
    let p : Ideal B := Ideal.comap (algebraMap B R') (maximalIdeal R')
    let A := Localization.AtPrime p
    IsLocalRing A ∧ Algebra.EssFiniteType R A ∧ IsNoetherianRing A := by
  classical
  let B : Subalgebra R R' := Algebra.adjoin R (↑s : Set R')
  let p : Ideal B := Ideal.comap (algebraMap B R') (maximalIdeal R')
  let A := Localization.AtPrime p
  change IsLocalRing A ∧ Algebra.EssFiniteType R A ∧ IsNoetherianRing A
  refine ⟨inferInstance, ?_, ?_⟩
  · -- Proof comment: the adjoin stage is finite type over `R`, and localizing it at a prime
    -- gives the source-faithful essentially-finite-type local stage from the text.
    have hfg : B.FG := by
      simpa [B] using (Subalgebra.fg_adjoin_finset (R := R) s)
    let _ : Algebra.FiniteType R B := (Subalgebra.fg_iff_finiteType B).mp hfg
    let _ : Algebra.EssFiniteType B A := Algebra.EssFiniteType.of_isLocalization A p.primeCompl
    exact Algebra.EssFiniteType.comp R B A
  · -- Proof comment: once the stage is known to be essentially of finite type over the
    -- Noetherian base `R`, Noetherianity follows from the standard owner theorem.
    have hEss :
        Algebra.EssFiniteType R A := by
      have hfg : B.FG := by
        simpa [B] using (Subalgebra.fg_adjoin_finset (R := R) s)
      let _ : Algebra.FiniteType R B := (Subalgebra.fg_iff_finiteType B).mp hfg
      let _ : Algebra.EssFiniteType B A := Algebra.EssFiniteType.of_isLocalization A p.primeCompl
      exact Algebra.EssFiniteType.comp R B A
    let _ : Algebra.EssFiniteType R A := hEss
    exact Algebra.EssFiniteType.isNoetherianRing R A

/-- Helper for Lemma 15.20.3: the localized transition maps are compatible with the `R`-algebra
structures, so they can be used as the `AlgHom`-valued system required by Lemma `15.18.3`. -/
private noncomputable def finite_adjoin_local_stage_transitionAlgHom
    {s t : Finset R'} (hst : s ⊆ t) :
    finite_adjoin_local_stage (R := R) (R' := R') s →ₐ[R]
      finite_adjoin_local_stage (R := R) (R' := R') t :=
  { toRingHom := finite_adjoin_local_stage_transition (R := R) (R' := R') hst
    commutes' := by
      intro r
      -- Proof comment: the localized stage map is induced from the stage inclusion, so it fixes
      -- the image of every base element `r : R`.
      simp only [finite_adjoin_local_stage_transition, Localization.localRingHom_to_map]
      rfl }

/-- Helper for Lemma 15.20.3: the finite localized adjoin stages form a directed system under
inclusion of the chosen finite generating sets. -/
private instance finite_adjoin_local_stage_directedSystem :
    DirectedSystem
      (fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s)
      (fun s t hst ↦
        (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') hst : _ →+* _)) where
  map_self := by
    intro s
    -- Proof comment: the transition attached to `s ⊆ s` is the identity local map.
    let B := finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s
    let p := finite_adjoin_local_stage_prime (R := R) (R' := R') s
    have hid :
        finite_adjoin_local_stage_transition (R := R) (R' := R') (show s ⊆ s from le_rfl) =
          RingHom.id _ := by
      refine Localization.localRingHom_unique p p (algebraMap B B) rfl fun x ↦ ?_
      simp only [finite_adjoin_local_stage_transition, Localization.localRingHom_to_map]
      rfl
    ext x
    simpa [finite_adjoin_local_stage_transitionAlgHom] using
      congrArg (fun f : finite_adjoin_local_stage (R := R) (R' := R') s →+*
        finite_adjoin_local_stage (R := R) (R' := R') s ↦ f x) hid
  map_map := by
    intro s t u hst htu
    -- Proof comment: both composites are the unique local maps induced by the direct stage
    -- inclusion from the `s`-stage into the `u`-stage.
    let Bs := finite_adjoin_local_stage_subalgebra (R := R) (R' := R') s
    let Bu := finite_adjoin_local_stage_subalgebra (R := R) (R' := R') u
    let ps := finite_adjoin_local_stage_prime (R := R) (R' := R') s
    let pu := finite_adjoin_local_stage_prime (R := R) (R' := R') u
    have hcomp :
        (finite_adjoin_local_stage_transition (R := R) (R' := R') htu).comp
            (finite_adjoin_local_stage_transition (R := R) (R' := R') hst) =
          finite_adjoin_local_stage_transition (R := R) (R' := R')
            (Set.Subset.trans hst htu) := by
      symm
      refine Localization.localRingHom_unique ps pu
        ((Subalgebra.inclusion
          (finite_adjoin_local_stage_subalgebra_mono (R := R) (R' := R')
            (Set.Subset.trans hst htu))).toRingHom)
        (finite_adjoin_local_stage_prime_comap (R := R) (R' := R')
          (Set.Subset.trans hst htu)).symm fun x ↦ ?_
      simp only [finite_adjoin_local_stage_transition, RingHom.comp_apply,
        Localization.localRingHom_to_map]
      rfl
    ext x
    simpa [finite_adjoin_local_stage_transitionAlgHom] using
      congrArg (fun f : finite_adjoin_local_stage (R := R) (R' := R') s →+*
        finite_adjoin_local_stage (R := R) (R' := R') u ↦ f x) hcomp

/-- Helper for Lemma 15.20.3: the stage-to-target maps assemble to the canonical comparison map
from the direct limit of finite localized adjoin stages to the given target local ring `R'`. -/
private noncomputable def finite_adjoin_local_stage_directLimitToTarget :
    Ring.DirectLimit
        (fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s)
        (fun s t hst ↦
          (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') hst : _ →+* _)) →+*
      R' :=
  Ring.DirectLimit.lift
    (fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s)
    (fun s t hst ↦
      (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') hst : _ →+* _))
    R'
    (fun s ↦ finite_adjoin_local_stage_to_target (R := R) (R' := R') s)
    (fun s t hst x ↦ by
      -- Proof comment: this is exactly the stage-to-target compatibility proved above.
      simpa [RingHom.comp_apply] using
        congrArg
          (fun f :
            finite_adjoin_local_stage (R := R) (R' := R') s →+*
              R' ↦ f x)
          (finite_adjoin_local_stage_to_target_comp_transition
            (R := R) (R' := R') hst))

/-- Helper for Lemma 15.20.3: on each stage, the direct-limit comparison map is the original
localized map into `R'`. -/
private lemma finite_adjoin_local_stage_directLimitToTarget_comp_of
    (s : Finset R') :
    (finite_adjoin_local_stage_directLimitToTarget (R := R) (R' := R')).comp
        (Ring.DirectLimit.of
          (fun t : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') t)
          (fun t u htu ↦
            (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') htu : _ →+* _))
          s) =
      finite_adjoin_local_stage_to_target (R := R) (R' := R') s := by
  ext x
  -- Proof comment: this is the universal-property computation rule for `Ring.DirectLimit.lift`.
  simpa [finite_adjoin_local_stage_directLimitToTarget] using
    (Ring.DirectLimit.lift_of
      (G := fun t : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') t)
      (f := fun t u htu ↦
        (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') htu : _ →+* _))
      (P := R')
      (g := fun t ↦ finite_adjoin_local_stage_to_target (R := R) (R' := R') t)
      (Hg := fun t u htu x ↦ by
        simpa [RingHom.comp_apply] using
          congrArg
            (fun f :
              finite_adjoin_local_stage (R := R) (R' := R') t →+*
                R' ↦ f x)
            (finite_adjoin_local_stage_to_target_comp_transition
              (R := R) (R' := R') htu))
      s x)

/-- Helper for Lemma 15.20.3: the direct limit of the finite localized adjoin stages is
canonically identified with the target local ring `R'`. -/
private noncomputable def finite_adjoin_local_stage_directLimitAlgEquivTarget :
    Ring.DirectLimit
        (fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s)
        (fun s t hst ↦
          (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') hst : _ →+* _)) ≃ₐ[R]
      R' := by
  let ψ := finite_adjoin_local_stage_directLimitToTarget (R := R) (R' := R')
  have hψ_inj : Function.Injective ψ := by
    intro x y hxy
    rcases Ring.DirectLimit.exists_of
      (G := fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s)
      (f := fun s t hst ↦
        (finite_adjoin_local_stage_transitionAlgHom (R := R) (R' := R') hst : _ →+* _))
      x with ⟨s, xs, rfl⟩
    rcases Ring.DirectLimit.exists_of
      (G := fun s : Finset R' ↦ finite_adjoin_local_stage (R := R) (R' := R') s)
