-- Proof sketch: choose a bounded finite-projective representative of `K`, and study the inverse
-- image of `DerivedCategory.IsPerfectOver R` under tensoring with `M`. This inverse-image
-- property is saturated triangulated because `DerivedCategory.IsPerfectOver R` is. Since
-- `A[0] ⊗_A^L M ≅ M`, the property contains `A[0]`, hence it contains the degree-zero objects of
-- all finite projective `A`-modules by the standard finite-projective retract argument. Lemma
-- `13.35.7` then rebuilds `K` from those bounded degree-zero terms.
/-- Lemma 15.84.3: if `K, M ∈ D(A)`, then `K ⊗_A^{\mathbf L} M` is perfect relative to `R`
whenever `K` is perfect and `M` is perfect relative to `R`. -/
@[stacks 0DHU]
theorem isPerfectOver_derivedTensorProduct
    (K M : DModA)
    (hA : (ModuleCat.of R A).IsPerfect)
    (hK : K.IsPerfect)
    (hM : DerivedCategory.IsPerfectOver R M) :
    DerivedCategory.IsPerfectOver R (K ⊗[A]^L M) := by
  let _ := hA
  let P : ObjectProperty DModA := fun X ↦ DerivedCategory.IsPerfectOver R X
  let G : DModA ⥤ DModA := derivedTensorProduct M
  let Q : ObjectProperty DModA := P.inverseImage G
  letI : P.IsTriangulated := by
    simpa [P] using
      (inferInstance :
        ObjectProperty.IsTriangulated (fun X : DModA ↦ DerivedCategory.IsPerfectOver R X))
  letI : P.IsStableUnderRetracts := by
    simpa [P] using
      (inferInstance :
        ObjectProperty.IsStableUnderRetracts (fun X : DModA ↦ DerivedCategory.IsPerfectOver R X))
  letI : G.IsTriangulated := derivedTensorProduct_isTriangulated M
  letI : Q.IsTriangulated := inferInstance
  letI : Q.IsClosedUnderExtensions := inferInstance
  letI : Q.IsStableUnderRetracts := inferInstance
  have hQsingle : Q ((single₀).obj (ModuleCat.of A A)) := by
    -- Proof comment: the tensor unit identifies `A[0] ⊗_A^L M` with `M`.
    change P (((single₀).obj (ModuleCat.of A A)) ⊗[A]^L M)
    exact P.prop_of_iso (singleZeroDerivedTensorIso (R := A) M).symm hM
  rcases hK with ⟨L, e, hL⟩
  letI : CochainComplex.IsBoundedFiniteProjective L := hL
  rcases hL.bounded with ⟨a, b, hGE, hLE⟩
  have hbase :
      ((finiteProjectiveModuleProperty A).map single₀ : ObjectProperty DModA) ≤ Q := by
    intro X hX
    rcases hX with ⟨P', hP', ⟨eX⟩⟩
    let P'' : FiniteProjectiveModuleCat A := ⟨P', hP'⟩
    exact Q.prop_of_iso eX
      (finiteProjective_single_mem_of_contains_ringSingle (A := A) Q hQsingle P'')
  have hinterval :
      (((finiteProjectiveModuleProperty A).map single₀)[a, b] : ObjectProperty DModA) ≤ Q := by
    exact shiftInterval_le_of_le (A := A) hbase a b
  let n : ℕ+ := Nat.succPNat (Int.toNat (b - a))
  have hstage :
      additiveExtensionStage
        (((finiteProjectiveModuleProperty A).map single₀)[a, b]) n K := by
    refine mem_additiveExtensionStage_of_exists_representative_mem
      (E := finiteProjectiveModuleProperty A) (K := K) (a := a) (b := b) ?_
    refine ⟨L, e.symm, hGE, hLE, ?_⟩
    intro i
    exact ⟨hL.finite i.1, hL.projective i.1⟩
  have hstageLe :
      additiveExtensionStage
        (((finiteProjectiveModuleProperty A).map single₀)[a, b]) n ≤ Q := by
    exact additiveExtensionStage_le_of_le (A := A) hinterval n
  exact hstageLe _ hstage

end

end CategoryTheory
