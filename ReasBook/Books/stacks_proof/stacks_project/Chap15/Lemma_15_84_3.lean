/- Domain-style sampling for Lemma 15.84.3:
- primary domain: relative perfectness in derived categories of modules over a base algebra, and
  its behavior under the canonical derived tensor product over that algebra;
- sampled owner declarations:
  `DerivedCategory.IsPerfectOver`,
  `DerivedCategory.IsPerfect`,
  `additiveExtensionStage`,
  `singleZeroDerivedTensorIso`,
  `(ModuleCat.of R A).IsPerfect`;
- best owner abstraction: the theorem is `source-facing` on the chapter owner
  `DerivedCategory.IsPerfectOver R`, and the source proof should be executed by viewing the exact
  functor `- ⊗[A]^L M` as acting on a bounded finite-projective representative of the perfect
  object `K`;
- primitive vs. derived:
  primitive data are the perfect `R`-module `(ModuleCat.of R A)`, the absolute perfect object
  `K : D(A)`, and the relatively perfect object `M : D(A)`;
  the bounded finite-projective representative for `K` and the closure of
  `DerivedCategory.IsPerfectOver R` under shifts, triangles, and retracts are derived ingredients
  supplied by earlier owner API;
- source/core/bridge triage:
  `source-facing`: the tensor-stability theorem below for `DerivedCategory.IsPerfectOver R`;
  `core/canonical`: `DerivedCategory.IsPerfectOver`, `DerivedCategory.IsPerfect`, the tensor
    object `K ⊗[A]^L M`, and the degree-zero generator `A[0]`;
  `bridge/view`: the Chapter 13 additive-extension stage for a bounded representative and the
    tensor-unit comparison `A[0] ⊗_A^{\mathbf L} M ≅ M`.
-/

/-- Helper for Lemma 15.84.3: if `P ≤ Q` and `Q` is stable under shifts, then every bounded shift
interval generated by `P` also lies in `Q`. -/
private theorem shiftInterval_le_of_le
    {P Q : ObjectProperty DModA}
    [Q.IsClosedUnderIsomorphisms] [Q.IsStableUnderShift ℤ]
    (hPQ : P ≤ Q) (a b : ℤ) :
    P[a, b] ≤ Q := by
  intro X hX
  rw [prop_shiftInterval_iff] at hX
  rcases hX with ⟨n, _, Y, hY, ⟨e⟩⟩
  rw [prop_shift_iff] at hY
  have hQshift : Q (Y⟦n⟧) := hPQ _ hY
  have hQYshiftNeg : Q ((Y⟦n⟧)⟦(-n : ℤ)⟧) := Q.le_shift (-n : ℤ) _ hQshift
  have hQY : Q Y := Q.prop_of_iso (shiftShiftNeg Y n) hQYshiftNeg
  exact Q.prop_of_iso e.symm hQY

/-- Helper for Lemma 15.84.3: a retract-stable triangulated property contains every additive
extension stage generated by a smaller property. -/
private theorem additiveExtensionStage_le_of_le
    {P Q : ObjectProperty DModA}
    [Q.IsStableUnderRetracts] [Q.IsTriangulated]
    (hPQ : P ≤ Q) (n : ℕ+) :
    additiveExtensionStage P n ≤ Q := by
  rw [additiveExtensionStage, retractClosure_le_iff]
  exact P.additiveClosure.extensionProductIter_le_of_isTriangulatedClosed₂
    (by
      refine colimitsClosure_le ?_
      exact hPQ)
    n.natPred

/-- Helper for Lemma 15.84.3: the free rank-`n + 1` module splits as one copy of `A` plus a free
rank-`n` summand. -/
private noncomputable def finSuccArrowLinearEquiv (n : ℕ) :
    (Fin (n + 1) → A) ≃ₗ[A] (A × (Fin n → A)) where
  toEquiv := (Fin.consEquiv fun _ : Fin (n + 1) => A).symm
  map_add' f g := by
    rfl
  map_smul' a f := by
    rfl

/-- Helper for Lemma 15.84.3: any property containing `A[0]` and closed under zero objects and
binary biproducts contains the degree-zero objects of all finite free `A`-modules. -/
private theorem finite_free_single_mem_of_contains_ringSingle
    (Q : ObjectProperty DModA)
    [Q.IsClosedUnderIsomorphisms]
    [Q.IsTriangulated]
    [Q.IsClosedUnderExtensions]
    (hRing : Q ((single₀).obj (ModuleCat.of A A))) :
    ∀ n : ℕ, Q ((single₀).obj (ModuleCat.of A (Fin n → A)))
  | 0 => by
      have hzero :
          ModuleCat.of A (Fin 0 → A) ≅ ModuleCat.of A PUnit := by
        exact (LinearEquiv.ofSubsingleton _ _).toModuleIso
      have hsingleZeroObj : IsZero ((single₀).obj (ModuleCat.of A PUnit)) := by
        let hzeroModule : IsZero (ModuleCat.of A PUnit) :=
          ModuleCat.isZero_of_subsingleton (ModuleCat.of A PUnit)
        exact (single₀).map_isZero hzeroModule
      have hQpunit : Q ((single₀).obj (ModuleCat.of A PUnit)) := by
        exact ObjectProperty.prop_of_isZero (P := Q) hsingleZeroObj
      exact Q.prop_of_iso (((DerivedCategory.singleFunctor (ModuleCat A) (0 : ℤ)).mapIso hzero).symm) hQpunit
  | n + 1 => by
      letI :
          PreservesBinaryBiproducts
            (DerivedCategory.singleFunctor (ModuleCat A) (0 : ℤ)) :=
        CategoryTheory.Limits.preservesBinaryBiproducts_of_preservesBiproducts
          (DerivedCategory.singleFunctor (ModuleCat A) (0 : ℤ))
      let eModule :
          ModuleCat.of A (Fin (n + 1) → A) ≅
            (ModuleCat.of A A) ⊞ (ModuleCat.of A (Fin n → A)) :=
        (finSuccArrowLinearEquiv (A := A) n).toModuleIso ≪≫
          (ModuleCat.biprodIsoProd (ModuleCat.of A A) (ModuleCat.of A (Fin n → A))).symm
      let eSingle :
          (single₀).obj (ModuleCat.of A (Fin (n + 1) → A)) ≅
            (((single₀).obj (ModuleCat.of A A)) ⊞
              ((single₀).obj (ModuleCat.of A (Fin n → A)))) :=
        ((DerivedCategory.singleFunctor (ModuleCat A) (0 : ℤ)).mapIso eModule) ≪≫
          (DerivedCategory.singleFunctor (ModuleCat A) (0 : ℤ)).mapBiprod
            (ModuleCat.of A A) (ModuleCat.of A (Fin n → A))
      have hbiprod :
          Q (((single₀).obj (ModuleCat.of A A)) ⊞
            ((single₀).obj (ModuleCat.of A (Fin n → A)))) := by
        exact Q.prop_biprod hRing (finite_free_single_mem_of_contains_ringSingle Q hRing n)
      exact Q.prop_of_iso eSingle.symm hbiprod

/-- Helper for Lemma 15.84.3: any retract-stable property containing `A[0]` and the finite free
degree-zero objects also contains the degree-zero objects of all finite projective `A`-modules. -/
private theorem finiteProjective_single_mem_of_contains_ringSingle
    (Q : ObjectProperty DModA)
    [Q.IsClosedUnderIsomorphisms]
    [Q.IsTriangulated]
    [Q.IsClosedUnderExtensions]
    [Q.IsStableUnderRetracts]
    (hRing : Q ((single₀).obj (ModuleCat.of A A)))
    (P : FiniteProjectiveModuleCat A) :
    Q ((single₀).obj P.obj) := by
  let _ : Module.Finite A P.obj := P.property.1
  let _ : Module.Projective A P.obj := P.property.2
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' A P.obj
  let πCat : ModuleCat.of A (Fin n → A) ⟶ P.obj := ModuleCat.ofHom π
  letI : Epi πCat := (ModuleCat.epi_iff_surjective _).2 hπ
  letI : Projective P.obj := by infer_instance
  let σCat : P.obj ⟶ ModuleCat.of A (Fin n → A) :=
    Projective.factorThru (𝟙 P.obj) πCat
  have hsplit : σCat ≫ πCat = 𝟙 P.obj := by
    exact Projective.factorThru_comp (𝟙 P.obj) πCat
  let r : Retract P.obj (ModuleCat.of A (Fin n → A)) := ⟨σCat, πCat, hsplit⟩
  have hfree :
      Q ((single₀).obj (ModuleCat.of A (Fin n → A))) :=
    finite_free_single_mem_of_contains_ringSingle Q hRing n
  exact Q.prop_of_retract (r.map single₀) hfree

