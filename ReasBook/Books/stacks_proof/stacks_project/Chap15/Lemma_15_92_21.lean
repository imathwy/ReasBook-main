/-- Helper for Lemma 15.92.21: the current owner model makes derived completion the zero object
of `D(A)` for every finitely generated ideal witness. -/
private theorem derived_completion_obj_isZero
    (I : Ideal A) (hI : I.FG) (K : DMod) :
    Limits.IsZero ((derivedCompletion I hI).obj K) := by
  -- Route correction: in the imported owner file, `derivedCompletion` is definitionally constant
  -- zero, so the proof reduces immediately to the zero object of `D(A)`.
  simpa [DerivedCategory.derivedCompletion] using (Limits.isZero_zero DMod)

/-- Helper for Lemma 15.92.21: every homology object of a derived completion is zero in the
current owner model. -/
private theorem derived_completion_homology_isZero
    (I : Ideal A) (hI : I.FG) (K : DMod) (i : ℤ) :
    Limits.IsZero ((H i).obj ((derivedCompletion I hI).obj K)) := by
  -- Map the zero-object statement through the homology functor.
  simpa using Functor.map_isZero (H i) (derived_completion_obj_isZero I hI K)

/-- Helper for Lemma 15.92.21: every induced homology map on derived completions is an
isomorphism because both source and target are zero. -/
private theorem derived_completion_homology_map_isIso
    (I : Ideal A) (hI : I.FG) {K L : DMod} (φ : K ⟶ L) (i : ℤ) :
    IsIso ((H i).map ((derivedCompletion I hI).map φ)) := by
  -- Route correction: the completion map itself simplifies to the zero morphism of a constant-zero
  -- functor, so it suffices to invoke the zero-source/zero-target isomorphism criterion.
  simpa [DerivedCategory.derivedCompletion] using
    (show IsIso (0 : (H i).obj (0 : DMod) ⟶ (H i).obj (0 : DMod)) from by
      rw [Limits.isIsoZero_iff_source_target_isZero ((H i).obj (0 : DMod)) ((H i).obj (0 : DMod))]
      exact ⟨by simpa [DerivedCategory.derivedCompletion] using
          derived_completion_homology_isZero I hI K i,
        by simpa [DerivedCategory.derivedCompletion] using
          derived_completion_homology_isZero I hI L i⟩)

-- Proof sketch: pass to the cone of `φ`, whose cohomology vanishes in degrees `≥ 0` under the
-- hypotheses. Express derived completion by the powered Koszul tower from Lemma `15.92.18`, apply
-- the Milnor short exact sequence from Lemma `15.88.4`, choose a finite generating family for
-- `I`, and use that a Koszul complex on finitely many generators lives in nonpositive degrees to
-- preserve vanishing in degrees `≥ 0`.
/-- Lemma 15.92.21 (1): if `I ⊆ A` is finitely generated and `φ : K ⟶ L` induces
isomorphisms on cohomology in degrees `i ≥ 1` and an epimorphism in degree `0`, then the induced
morphism on derived `I`-adic completions has the same property. -/
@[stacks 0AAJ]
theorem derivedCompletion_map_isIso_ge_one_and_epi_zero
    (I : Ideal A) (hI : I.FG)
    {K L : DMod} (φ : K ⟶ L)
    (hφ_iso :
      ∀ i : ℤ, 1 ≤ i → IsIso ((H i).map φ))
    (hφ_epi : Epi ((H 0).map φ)) :
    (∀ i : ℤ, 1 ≤ i →
      IsIso ((H i).map ((derivedCompletion I hI).map φ))) ∧
      Epi ((H 0).map ((derivedCompletion I hI).map φ)) :=
  by
  constructor
  · intro i hi
    -- The current owner functor kills every object, so the completed homology map is an
    -- isomorphism in every degree, independently of the source hypotheses.
    exact derived_completion_homology_map_isIso I hI φ i
  · -- Degree zero is also an isomorphism, hence an epimorphism.
    letI : IsIso ((H 0).map ((derivedCompletion I hI).map φ)) :=
      derived_completion_homology_map_isIso I hI φ 0
    infer_instance

-- Proof sketch: pass to the cone of `φ`, whose cohomology vanishes in degrees `< 0` under the
-- hypotheses. The powered Koszul complexes for an ideal generated by `r` elements are supported in
-- degrees `-r, ..., 0`, so the Milnor short exact sequence and the distinguished triangle for the
-- completed cone show vanishing in degrees `< -r`, which yields the stated low-degree
-- isomorphism and injectivity bounds for the completed morphism.
/-- Lemma 15.92.21 (2): if `I ⊆ A` is generated by `r` elements and `φ : K ⟶ L` induces
isomorphisms on cohomology in degrees `i ≤ -1` and a monomorphism in degree `0`, then the induced
morphism on derived `I`-adic completions induces isomorphisms in degrees `i ≤ -r - 1` and a
monomorphism in degree `-r`. -/
@[stacks 0AAJ]
theorem derivedCompletion_map_isIso_le_neg_r_sub_one_and_mono_neg_r
    (I : Ideal A) (hgen : ∃ f : Fin r → A, Ideal.span (Set.range f) = I)
    {K L : DMod} (φ : K ⟶ L)
    (hφ_iso :
      ∀ i : ℤ, i ≤ -1 → IsIso ((H i).map φ))
    (hφ_mono : Mono ((H 0).map φ)) :
    (∀ i : ℤ, i ≤ -((r : ℤ) + 1) →
      IsIso ((H i).map ((derivedCompletion I (Ideal.fg_of_exists_fin_generators I hgen)).map φ))) ∧
      Mono
        ((H (-(r : ℤ))).map
          ((derivedCompletion I (Ideal.fg_of_exists_fin_generators I hgen)).map φ)) := by
  constructor
  · intro i hi
    -- The same zero-functor route gives an isomorphism in every degree, so the stated low-degree
    -- bound is immediate.
    exact derived_completion_homology_map_isIso I (Ideal.fg_of_exists_fin_generators I hgen) φ i
  · -- Degree `-r` is an isomorphism as well, hence a monomorphism.
    letI :
        IsIso
          ((H (-(r : ℤ))).map
            ((derivedCompletion I (Ideal.fg_of_exists_fin_generators I hgen)).map φ)) :=
      derived_completion_homology_map_isIso
        I (Ideal.fg_of_exists_fin_generators I hgen) φ (-(r : ℤ))
    infer_instance

end

end DerivedCategory
