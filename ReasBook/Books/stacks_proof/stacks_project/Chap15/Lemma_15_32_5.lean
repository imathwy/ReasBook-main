import Mathlib
import stacks_proof.stacks_project.Chap15.Lemma_15_30_5
import stacks_proof.stacks_project.Chap15.Lemma_15_30_9
import stacks_proof.stacks_project.Chap15.Definition_15_32_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u

namespace RingTheory.Sequence

variable {R S : Type u} [CommRing R] [CommRing S]

/-- Helper for Lemma 15.32.5: `H_1`-regularity is preserved after transporting a finite family
across a ring equivalence. -/
private theorem isH1RegularSequence_of_ringEquiv {r : ℕ} (e : R ≃+* S) {f : Fin r → R}
    (hreg : IsH1RegularSequence f) :
    IsH1RegularSequence (fun i ↦ e (f i)) := by
  letI : Algebra R S := e.toRingHom.toAlgebra
  have hflat : (algebraMap R S).Flat := by
    -- A ring equivalence is flat because its underlying ring homomorphism is bijective.
    simpa using (RingHom.Flat.of_bijective e.bijective : e.toRingHom.Flat)
  letI : Module.Flat R S := RingHom.flat_algebraMap_iff.mp hflat
  -- Transport the vanishing of the first Koszul homology through the flat base change.
  simpa [IsH1RegularSequence] using
    (IsH1RegularOn.of_flat_of_isBaseChange
      (R := R) (S := S) (M := R) (N := S)
      (f := Algebra.linearMap R S)
      (hf := IsBaseChange.linearMap (R := R) (S := S))
      (s := f) hreg)

end RingTheory.Sequence

namespace Ideal

variable {A : Type u} [CommRing A]

/-- Helper for Lemma 15.32.5: a maximal ideal `m` containing `I` determines the corresponding
prime of the quotient ring `A ⧸ I`. -/
private noncomputable abbrev quotient_prime_over_maximal
    (I m : Ideal A) [m.IsMaximal] (hIm : I ≤ m) : PrimeSpectrum (A ⧸ I) :=
  I.primeSpectrumQuotientOrderIsoZeroLocus.symm ⟨(⟨m, inferInstance⟩ : PrimeSpectrum A), hIm⟩

/-- Helper for Lemma 15.32.5: contracting the quotient prime corresponding to `m` recovers `m`
itself. -/
private lemma quotient_prime_over_maximal_comap
    (I m : Ideal A) [m.IsMaximal] (hIm : I ≤ m) :
    PrimeSpectrum.comap (Ideal.Quotient.mk I) (quotient_prime_over_maximal I m hIm) =
      (⟨m, inferInstance⟩ : PrimeSpectrum A) := by
  -- This is exactly the inverse property of the quotient-spectrum order isomorphism.
  exact congrArg Subtype.val
    (I.primeSpectrumQuotientOrderIsoZeroLocus.apply_symm_apply
      ⟨(⟨m, inferInstance⟩ : PrimeSpectrum A), hIm⟩)

/-- Helper for Lemma 15.32.5: the `H_1`-regular quotient ideal admits an away-local witness on a
basic neighborhood of the quotient prime lying under `m`. -/
private lemma quotient_h1_regular_away_witness_at_maximal
    (I J m : Ideal A) [m.IsMaximal] (hIJ : I ≤ J) (hJm : J ≤ m)
    (hreg : (J.map (Ideal.Quotient.mk I)).IsH1RegularIdeal) :
    ∃ (g : A ⧸ I),
      g ∉ (quotient_prime_over_maximal I m (le_trans hIJ hJm)).asIdeal ∧
      ∃ (n : ℕ) (f : Fin n → Localization.Away g),
        Ideal.map (algebraMap (A ⧸ I) (Localization.Away g)) (J.map (Ideal.Quotient.mk I)) =
          Ideal.span (Set.range f) ∧
        RingTheory.Sequence.IsH1RegularSequence f := by
  let mbar : PrimeSpectrum (A ⧸ I) :=
    quotient_prime_over_maximal I m (le_trans hIJ hJm)
  have hmbar_comap : Ideal.comap (Ideal.Quotient.mk I) mbar.asIdeal = m := by
    -- Convert the quotient-spectrum contraction formula to an equality of underlying ideals.
    simpa [mbar] using congrArg PrimeSpectrum.asIdeal
      (quotient_prime_over_maximal_comap I m (le_trans hIJ hJm))
  have hJmbar : J.map (Ideal.Quotient.mk I) ≤ mbar.asIdeal := by
    -- The quotient ideal lies under the quotient prime because `J ≤ m`.
    rw [Ideal.map_le_iff_le_comap]
    simpa [hmbar_comap] using hJm
  rw [Ideal.isH1RegularIdeal_iff] at hreg
  rcases hreg mbar.asIdeal mbar.isPrime hJmbar with ⟨g, hg, n, f, hf, hspan⟩
  -- Reorder the witness data into the form used by the localized target proof.
  exact ⟨g, hg, n, f, hspan, hf⟩

/-- Helper for Lemma 15.32.5: an element of the quotient ring avoiding the quotient prime under
`m` has a lift in `A` that still avoids `m`. -/
private lemma exists_lift_notMem_maximal_of_notMem_quotient_prime
    (I m : Ideal A) [m.IsMaximal] (hIm : I ≤ m) (g : A ⧸ I)
    (hg : g ∉ (quotient_prime_over_maximal I m hIm).asIdeal) :
    ∃ a : A, Ideal.Quotient.mk I a = g ∧ a ∉ m := by
  rcases Ideal.Quotient.mk_surjective g with ⟨a, rfl⟩
  refine ⟨a, rfl, ?_⟩
  intro ha
  have hmbar_comap :
      Ideal.comap (Ideal.Quotient.mk I) (quotient_prime_over_maximal I m hIm).asIdeal = m := by
    -- This is the ideal-level form of the quotient-spectrum contraction formula.
    simpa using congrArg PrimeSpectrum.asIdeal
      (quotient_prime_over_maximal_comap I m hIm)
  apply hg
  -- Membership in the quotient prime is equivalent to membership of the lift in its contraction.
  change a ∈ Ideal.comap (Ideal.Quotient.mk I) (quotient_prime_over_maximal I m hIm).asIdeal
  simpa [hmbar_comap] using ha

/-- Helper for Lemma 15.32.5: once the localized quotient ideal is generated by a finite
`H_1`-regular sequence, Lemma `15.30.9` gives the localized equality immediately. -/
lemma localized_inf_sq_eq_mul_at_maximal_of_le
    (I J m : Ideal A) [m.IsMaximal] (hIJ : I ≤ J)
    (hwitness :
      ∃ (n : ℕ)
        (f : Fin n → (Localization.AtPrime m ⧸ Ideal.map (algebraMap A (Localization.AtPrime m)) I)),
          ((Ideal.map (algebraMap A (Localization.AtPrime m)) J).map
            (Ideal.Quotient.mk (Ideal.map (algebraMap A (Localization.AtPrime m)) I))) =
              Ideal.span (Set.range f) ∧
            RingTheory.Sequence.IsH1RegularSequence f) :
    Ideal.map (algebraMap A (Localization.AtPrime m)) (I ⊓ J ^ 2) =
      Ideal.map (algebraMap A (Localization.AtPrime m)) (I * J) := by
  -- Rewrite the localized target so that Lemma `15.30.9` applies in the local ring.
  let α : A →+* Localization.AtPrime m := algebraMap A (Localization.AtPrime m)
  let Iloc : Ideal (Localization.AtPrime m) := Ideal.map α I
  let Jloc : Ideal (Localization.AtPrime m) := Ideal.map α J
  have hIJloc : Iloc ≤ Jloc := Ideal.map_mono hIJ
  have hlocal :
      Iloc ⊓ Jloc ^ 2 = Iloc * Jloc :=
    Ideal.inf_sq_eq_mul_of_quotient_generated_by_h1RegularSequence Iloc Jloc hIJloc hwitness
  -- Now translate the local equality back to the images of the original ideals.
  calc
    Ideal.map α (I ⊓ J ^ 2)
        = Ideal.map α I ⊓ Ideal.map α (J ^ 2) := by
            simpa using IsLocalization.map_inf m.primeCompl (Localization.AtPrime m) I (J ^ 2)
    _ = Iloc ⊓ Jloc ^ 2 := by
          simp [Iloc, Jloc, Ideal.map_pow]
    _ = Iloc * Jloc := hlocal
    _ = Ideal.map α (I * J) := by
          simp [Iloc, Jloc, Ideal.map_mul]

/-- Helper for Lemma 15.32.5: quotienting the away localization at a lift `a` of `g` is again the
localization of `A ⧸ I` away from `g`. -/
private lemma away_quotient_isLocalization_of_lift
    (I : Ideal A) {a : A} {g : A ⧸ I} (ha : Ideal.Quotient.mk I a = g) :
    IsLocalization.Away g
      ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I) := by
  -- Quotienting a localization is a localization of the quotient at the image submonoid.
  simpa [IsLocalization.Away, ha, ← Submonoid.map_powers] using
    (inferInstance :
      IsLocalization
        (Algebra.algebraMapSubmonoid (A ⧸ I) (Submonoid.powers a))
        ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I))

/-- Helper for Lemma 15.32.5: the quotient of `A[a⁻¹]` by the localized ideal `I[a⁻¹]` is
canonically the localization of `A / I` away from the class `g = a mod I`. -/
private noncomputable abbrev away_quotient_algEquiv_of_lift
    (I : Ideal A) {a : A} {g : A ⧸ I} (ha : Ideal.Quotient.mk I a = g) :
    ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I) ≃ₐ[A ⧸ I]
      Localization.Away g := by
  letI := away_quotient_isLocalization_of_lift (A := A) I ha
  -- Both rings are the same localization of `A ⧸ I`, so use the canonical equivalence.
  exact (IsLocalization.algEquiv (Submonoid.powers g)
    (Localization.Away g)
    ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I)).symm

/-- Helper for Lemma 15.32.5: the localized quotient witness over `(A / I)[g⁻¹]` transports to
the quotient of `A[a⁻¹]` by the localized ideal `I[a⁻¹]`. -/
private lemma away_quotient_h1_witness_of_quotient_witness
    (I J : Ideal A) {a : A} {g : A ⧸ I} (ha : Ideal.Quotient.mk I a = g)
    {n : ℕ} {f : Fin n → Localization.Away g}
    (hspan :
      Ideal.map (algebraMap (A ⧸ I) (Localization.Away g)) (J.map (Ideal.Quotient.mk I)) =
        Ideal.span (Set.range f))
    (hH1 : RingTheory.Sequence.IsH1RegularSequence f) :
    ∃ f' : Fin n → ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I),
      Ideal.map
          (algebraMap (A ⧸ I)
            ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I))
          (J.map (Ideal.Quotient.mk I)) =
        Ideal.span (Set.range f') ∧
      RingTheory.Sequence.IsH1RegularSequence f' := by
  let T := ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I)
  let eAlg :
      Localization.Away g ≃ₐ[A ⧸ I] T :=
    (away_quotient_algEquiv_of_lift (A := A) I ha).symm
  let e : Localization.Away g ≃+* T := eAlg.toRingEquiv
  let f' : Fin n → T := fun i ↦ e (f i)
  have hcomp :
      e.toRingHom.comp (algebraMap (A ⧸ I) (Localization.Away g)) =
        algebraMap (A ⧸ I) T := by
    -- Both maps are the quotient-localization structure map induced by the chosen lift `a`.
    ext x
    simpa [e, eAlg] using eAlg.commutes x
  have hrange : e.toRingHom '' Set.range f = Set.range f' := by
    -- Mapping the witness family through the equivalence is exactly the new range.
    ext y
    constructor
    · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨f i, ⟨i, rfl⟩, rfl⟩
  have hspan' :
      Ideal.map (algebraMap (A ⧸ I) T) (J.map (Ideal.Quotient.mk I)) =
        Ideal.span (Set.range f') := by
    -- Transport the ideal-generation equality by mapping the span through the ring equivalence.
    calc
      Ideal.map (algebraMap (A ⧸ I) T) (J.map (Ideal.Quotient.mk I))
          = Ideal.map
              (e.toRingHom.comp (algebraMap (A ⧸ I) (Localization.Away g)))
              (J.map (Ideal.Quotient.mk I)) := by
                rw [hcomp]
      _ = Ideal.map e.toRingHom
            (Ideal.map (algebraMap (A ⧸ I) (Localization.Away g))
              (J.map (Ideal.Quotient.mk I))) := by
            rw [← Ideal.map_map]
      _ = Ideal.map e.toRingHom (Ideal.span (Set.range f)) := by rw [hspan]
      _ = Ideal.span (e.toRingHom '' Set.range f) := by rw [Ideal.map_span]
      _ = Ideal.span (Set.range f') := by rw [hrange]
  have hH1' : RingTheory.Sequence.IsH1RegularSequence f' := by
    -- The generic ring-equivalence transport closes the `H₁`-regularity part of the witness.
    simpa [e, f'] using
      (RingTheory.Sequence.isH1RegularSequence_of_ringEquiv (e := e) (f := f) hH1)
  exact ⟨f', hspan', hH1'⟩

/-- Helper for Lemma 15.32.5: after transporting the `H₁`-regular witness to the quotient of
`A[a⁻¹]`, Lemma `15.30.9` proves the ideal equality already in `A[a⁻¹]`. -/
private lemma away_inf_sq_eq_mul_of_lifted_h1_regular_witness
    (I J : Ideal A) (hIJ : I ≤ J) {a : A} {g : A ⧸ I} (ha : Ideal.Quotient.mk I a = g)
    {n : ℕ} {f : Fin n → Localization.Away g}
    (hspan :
      Ideal.map (algebraMap (A ⧸ I) (Localization.Away g)) (J.map (Ideal.Quotient.mk I)) =
        Ideal.span (Set.range f))
    (hH1 : RingTheory.Sequence.IsH1RegularSequence f) :
    Ideal.map (algebraMap A (Localization.Away a)) (I ⊓ J ^ 2) =
      Ideal.map (algebraMap A (Localization.Away a)) (I * J) := by
  let α : A →+* Localization.Away a := algebraMap A (Localization.Away a)
  let Iloc : Ideal (Localization.Away a) := Ideal.map α I
  let Jloc : Ideal (Localization.Away a) := Ideal.map α J
  have hIJloc : Iloc ≤ Jloc := Ideal.map_mono hIJ
  obtain ⟨f', hspan', hH1'⟩ :=
    away_quotient_h1_witness_of_quotient_witness
      (A := A) I J ha hspan hH1
  have hquot_comp :
      (Ideal.Quotient.mk Iloc).comp α =
        (algebraMap (A ⧸ I)
          ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I)).comp
          (Ideal.Quotient.mk I) := by
    ext x
    rfl
  have hspan_quotient :
      Jloc.map (Ideal.Quotient.mk Iloc) = Ideal.span (Set.range f') := by
    calc
      Jloc.map (Ideal.Quotient.mk Iloc)
          = Ideal.map (Ideal.Quotient.mk Iloc) (Ideal.map α J) := rfl
      _ = Ideal.map ((Ideal.Quotient.mk Iloc).comp α) J := by
            rw [Ideal.map_map]
      _ = Ideal.map
            ((algebraMap (A ⧸ I)
              ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I)).comp
              (Ideal.Quotient.mk I)) J := by
            rw [hquot_comp]
      _ = Ideal.map
            (algebraMap (A ⧸ I)
              ((Localization.Away a) ⧸ Ideal.map (algebraMap A (Localization.Away a)) I))
            (J.map (Ideal.Quotient.mk I)) := by
            rw [Ideal.map_map]
      _ = Ideal.span (Set.range f') := hspan'
  have hlocal :
      Iloc ⊓ Jloc ^ 2 = Iloc * Jloc :=
    Ideal.inf_sq_eq_mul_of_quotient_generated_by_h1RegularSequence Iloc Jloc hIJloc
      ⟨n, f', hspan_quotient, hH1'⟩
  -- Rewrite the away-local target back to the images of the original ideals.
  calc
    Ideal.map α (I ⊓ J ^ 2)
        = Ideal.map α I ⊓ Ideal.map α (J ^ 2) := by
            simpa using
              IsLocalization.map_inf (Submonoid.powers a) (Localization.Away a) I (J ^ 2)
    _ = Iloc ⊓ Jloc ^ 2 := by
          simp [Iloc, Jloc, Ideal.map_pow]
    _ = Iloc * Jloc := hlocal
    _ = Ideal.map α (I * J) := by
          simp [Iloc, Jloc, Ideal.map_mul]

/-- Helper for Lemma 15.32.5: mapping an ideal first to `A[a⁻¹]` and then to `A_m` agrees with
mapping it directly to `A_m` when `a ∉ m`. -/
private lemma map_localized_ideal_via_away_to_atPrime
    (m : Ideal A) [m.IsMaximal] {a : A} (ham : a ∉ m) (K : Ideal A) :
    Ideal.map
        (Localization.awayLift (algebraMap A (Localization.AtPrime m)) a
          (IsLocalization.map_units (Localization.AtPrime m)
            ⟨a, show a ∈ m.primeCompl by simpa using ham⟩))
        (Ideal.map (algebraMap A (Localization.Away a)) K) =
      Ideal.map (algebraMap A (Localization.AtPrime m)) K := by
  have haCompl : a ∈ m.primeCompl := by
    simpa using ham
  let β : Localization.Away a →+* Localization.AtPrime m :=
    Localization.awayLift (algebraMap A (Localization.AtPrime m)) a
      (IsLocalization.map_units (Localization.AtPrime m) ⟨a, haCompl⟩)
  have hcomp : β.comp (algebraMap A (Localization.Away a)) = algebraMap A (Localization.AtPrime m) := by
    ext x
    -- The away lift is characterized by agreeing with the original map on `A`.
    simp [β, Localization.awayLift]
  -- The two-step ideal map is the direct map because the ring homomorphisms compose correctly.
  calc
    Ideal.map β (Ideal.map (algebraMap A (Localization.Away a)) K)
        = Ideal.map (β.comp (algebraMap A (Localization.Away a))) K := by
            rw [Ideal.map_map]
    _ = Ideal.map (algebraMap A (Localization.AtPrime m)) K := by rw [hcomp]

/-- Helper for Lemma 15.32.5: on a maximal localization containing `J`, the source local-global
route reduces the target equality to transporting one away-local `H_1`-regular witness from the
quotient ring to the localized quotient of `A`. -/
lemma localized_inf_sq_eq_mul_at_maximal_of_le_h1Regular
    (I J m : Ideal A) [m.IsMaximal] (hIJ : I ≤ J) (hJm : J ≤ m)
    (hreg : (J.map (Ideal.Quotient.mk I)).IsH1RegularIdeal) :
    Ideal.map (algebraMap A (Localization.AtPrime m)) (I ⊓ J ^ 2) =
      Ideal.map (algebraMap A (Localization.AtPrime m)) (I * J) := by
  classical
  -- Route correction: stop transporting a finite witness all the way into `A_m / I_m` as a
  -- standalone endpoint. The source proof first works over `A_a`, proves the equality there, and
  -- only then localizes once more to `A_m`.
  obtain ⟨g, hg, n, f, hspan, hH1⟩ :=
    quotient_h1_regular_away_witness_at_maximal I J m hIJ hJm hreg
  obtain ⟨a, ha, ham⟩ :=
    exists_lift_notMem_maximal_of_notMem_quotient_prime I m (le_trans hIJ hJm) g hg
  -- The verified prefix now matches the source skeleton:
  -- 1. `g` avoids the quotient prime under `m`,
  -- 2. `f` generates `(J / I)_g` and is `H₁`-regular there,
  -- 3. `a ∉ m` lifts `g`, so the source comparison ring is `Localization.Away a`.
  have haway :
      Ideal.map (algebraMap A (Localization.Away a)) (I ⊓ J ^ 2) =
        Ideal.map (algebraMap A (Localization.Away a)) (I * J) :=
    away_inf_sq_eq_mul_of_lifted_h1_regular_witness
      (A := A) I J hIJ ha hspan hH1
  have haCompl : a ∈ m.primeCompl := by
    simpa using ham
  let β : Localization.Away a →+* Localization.AtPrime m :=
    Localization.awayLift (algebraMap A (Localization.AtPrime m)) a
      (IsLocalization.map_units (Localization.AtPrime m) ⟨a, haCompl⟩)
  have hmap : Ideal.map β (Ideal.map (algebraMap A (Localization.Away a)) (I ⊓ J ^ 2)) =
      Ideal.map β (Ideal.map (algebraMap A (Localization.Away a)) (I * J)) := by
    -- The away-local equality can now be pushed directly into the maximal localization.
    exact congrArg (Ideal.map β) haway
  have hleft :
      Ideal.map β (Ideal.map (algebraMap A (Localization.Away a)) (I ⊓ J ^ 2)) =
        Ideal.map (algebraMap A (Localization.AtPrime m)) (I ⊓ J ^ 2) := by
    simpa [β] using
      map_localized_ideal_via_away_to_atPrime (A := A) (m := m) (a := a) ham (I ⊓ J ^ 2)
  have hright :
      Ideal.map β (Ideal.map (algebraMap A (Localization.Away a)) (I * J)) =
        Ideal.map (algebraMap A (Localization.AtPrime m)) (I * J) := by
    simpa [β] using
      map_localized_ideal_via_away_to_atPrime (A := A) (m := m) (a := a) ham (I * J)
  calc
    Ideal.map (algebraMap A (Localization.AtPrime m)) (I ⊓ J ^ 2)
        = Ideal.map β (Ideal.map (algebraMap A (Localization.Away a)) (I ⊓ J ^ 2)) := by
            exact hleft.symm
    _ = Ideal.map β (Ideal.map (algebraMap A (Localization.Away a)) (I * J)) := hmap
    _ = Ideal.map (algebraMap A (Localization.AtPrime m)) (I * J) := hright

/-- Helper for Lemma 15.32.5: away from `V(J)`, the localization of `J` is the unit ideal, so
both sides reduce to the image of `I`. -/
lemma localized_inf_sq_eq_mul_at_maximal_of_not_le
    (I J m : Ideal A) [m.IsMaximal] (hJm : ¬ J ≤ m) :
    Ideal.map (algebraMap A (Localization.AtPrime m)) (I ⊓ J ^ 2) =
      Ideal.map (algebraMap A (Localization.AtPrime m)) (I * J) := by
  -- Once `J` localizes to `⊤`, the target equality is a direct ideal calculation.
  let α : A →+* Localization.AtPrime m := algebraMap A (Localization.AtPrime m)
  have hJtop : Ideal.map α J = ⊤ :=
    IsLocalization.AtPrime.map_eq_top_of_not_le (S := Localization.AtPrime m) hJm
  calc
    Ideal.map α (I ⊓ J ^ 2)
        = Ideal.map α I ⊓ Ideal.map α (J ^ 2) := by
            simpa using IsLocalization.map_inf m.primeCompl (Localization.AtPrime m) I (J ^ 2)
    _ = Ideal.map α I ⊓ (Ideal.map α J) ^ 2 := by
          simp [Ideal.map_pow]
    _ = Ideal.map α I := by
          simp [hJtop, pow_two]
    _ = Ideal.map α I * Ideal.map α J := by
          simp [hJtop]
    _ = Ideal.map α (I * J) := by
          simp [Ideal.map_mul]

/- Domain triage:
- primary domain: commutative algebra of quotient ideals and local `H₁`-regularity;
- sampled owner declarations:
  `Ideal.IsH1RegularIdeal`,
  `Ideal.isH1RegularIdeal_iff`,
  `Ideal.inf_sq_eq_mul_of_quotient_generated_by_h1RegularSequence`;
- layer split:
  `source-facing`: the quotient ideal `J / I` is `H₁`-regular;
  `core/canonical`: the ideal owner predicate `Ideal.IsH1RegularIdeal`;
  `bridge/view`: the finite-sequence bridge from Lemma `15.30.9`, used after unpacking the owner
  predicate on the quotient ring.
- primitive vs derived split: the only primitive data are the ideals `I ≤ J` and the owner
  hypothesis on `J.map (Ideal.Quotient.mk I)`; any localized finite generating sequences belong to
  the derived bridge API, not to the public theorem surface.
-/

-- Proof sketch: localize the quotient ring `A ⧸ I` at each prime containing the quotient ideal
-- `J.map (Ideal.Quotient.mk I)`; the `H₁`-regularity hypothesis gives a basic neighborhood where
-- that localized ideal is generated by a finite `H₁`-regular sequence. Apply Lemma `15.30.9` in
-- the localization and descend the resulting equality to `A`.
/-- Lemma 15.32.5: if the quotient ideal `J / I` in `A ⧸ I` is an `H_1`-regular ideal, then
`I ∩ J^2 = IJ`. -/
@[stacks 07CX]
theorem inf_sq_eq_mul_of_quotient_isH1RegularIdeal (I J : Ideal A) (hIJ : I ≤ J)
    (hreg : (J.map (Ideal.Quotient.mk I)).IsH1RegularIdeal) :
    I ⊓ J ^ 2 = I * J := by
  -- Check the ideal equality after localizing at every maximal ideal.
  refine Ideal.eq_of_localization_maximal ?_
  intro m hm
  letI : m.IsMaximal := hm
  by_cases hJm : J ≤ m
  · -- On `V(J)`, use the localized finite `H₁`-regular generating family.
    exact localized_inf_sq_eq_mul_at_maximal_of_le_h1Regular I J m hIJ hJm hreg
  · -- Off `V(J)`, the localized ideal `J` is already the whole ring.
    exact localized_inf_sq_eq_mul_at_maximal_of_not_le I J m hJm

end Ideal
