variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]

/-
Domain-style sampling pass for Lemma 15.26.3.

Primary domain: affine blowup strict transforms and Fitting ideals of finite modules.

Sampled owner declarations:
* `Fit[R]_(k)(M)` from `Chap15/Definition_15_8_3.lean`;
* `fittingIdeal_baseChange` from `Chap15/Lemma_15_8_4.lean`;
* `affineBlowupChart_map_ideal_eq_span_singleton` from `Chap10/Lemma_10_70_2.lean`;
* `affineBlowupStrictTransform` from `Chap15/Definition_15_26_1.lean`.

Owner abstraction: this theorem is `source-facing`. Its ambient algebra is the Chapter 10 owner
`affineBlowupChart I a`, its module is the Chapter 15 owner `affineBlowupStrictTransform I a M`,
and the Fitting-ideal conclusion should be expressed through the canonical owner notation
`Fit[...]_(...)` rather than the raw `fittingIdeal` spelling.

Primitive data: the intrinsic ideal `I = Fit[R]_(k)(M)`, an element `a : I`, the blowup chart
`R[I / a]`, and the strict transform of `M` on that chart.
Derived API: the conclusion that the `k`th Fitting ideal of the strict transform is the unit ideal.

Source/core/bridge triage:
* `source-facing`: the strict-transform Fitting-ideal statement below;
* `core/canonical`: `Fit[R]_(k)(M)`, `affineBlowupChart`, `affineBlowupStrictTransform`;
* `bridge/view`: `fittingIdeal_baseChange` and
  `affineBlowupChart_map_ideal_eq_span_singleton`.
-/

-- Proof sketch: base change identifies the `k`th Fitting ideal of `M ⊗[R] R[Fit_k(M) / a]` with the
-- extension of `Fit_k(M)`, and Lemma `10.70.2` makes that extended ideal principal, generated by
-- `a`. Lemma `15.8.9` then shows that after quotienting by the strict-transform torsion, every
-- localization is generated by at most `k` elements, so Lemma `15.8.7` gives the unit Fitting
-- ideal.
/-- Helper for Lemma 15.26.3: after base change to the affine blowup chart, the `k`th Fitting
ideal becomes the principal ideal generated by the image of `a`. -/
lemma fittingIdeal_tensor_affineBlowupChart_eq_principalIdeal (k : ℕ)
    (a : Fit[R]_(k)(M)) :
    let A := R[Fit[R]_(k)(M) / a]
    let T := A ⊗[R] M
    Fit[A]_(k)(T) = principalIdeal (algebraMap R A a.1) := by
  dsimp
  -- Base change computes the chart Fitting ideal as the extension of `Fit_k(M)`.
  calc
    Fit[R[Fit[R]_(k)(M) / a]]_(k)(R[Fit[R]_(k)(M) / a] ⊗[R] M) =
        Ideal.map (algebraMap R R[Fit[R]_(k)(M) / a]) (Fit[R]_(k)(M)) := by
          simpa using
            (fittingIdeal_baseChange
              (R := R)
              (M := M)
              (R' := R[Fit[R]_(k)(M) / a])
              k)
    _ = Ideal.span {algebraMap R R[Fit[R]_(k)(M) / a] a.1} := by
      simpa using affineBlowupChart_map_ideal_eq_span_singleton (Fit[R]_(k)(M)) a
    _ = principalIdeal (algebraMap R R[Fit[R]_(k)(M) / a] a.1) := by
      simp [principalIdeal]

omit [Module.Finite R M] in
/-- Helper for Lemma 15.26.3: the one-step `a`-torsion on the chart module is contained in the
`a`-power torsion submodule defining the strict transform. -/
lemma torsionBy_le_affineBlowupChart_primaryComponent (k : ℕ)
    (a : Fit[R]_(k)(M)) :
    let A := R[Fit[R]_(k)(M) / a]
    let T := A ⊗[R] M
    let aA := algebraMap R A a.1
    let J : Ideal A := principalIdeal aA
    Submodule.torsionBy A T aA ≤ J.primaryComponent T := by
  dsimp
  intro x hx
  -- Rewrite the primary component of a principal ideal as ordinary `a`-power torsion.
  rw [Module.primaryComponent_principalIdeal_eq_fPowerTorsion (M := R[Fit[R]_(k)(M) / a] ⊗[R] M)
    (algebraMap R R[Fit[R]_(k)(M) / a] a.1)]
  rw [Submodule.mem_torsionBy_iff] at hx
  rw [Submodule.mem_torsion'_iff (Submonoid.powers (algebraMap R R[Fit[R]_(k)(M) / a] a.1))]
  refine ⟨⟨algebraMap R R[Fit[R]_(k)(M) / a] a.1, ⟨1, by simp⟩⟩, ?_⟩
  simpa using hx

/-- Helper for Lemma 15.26.3: localizing an `f`-torsion submodule at a prime gives the torsion
submodule of the localized module cut out by the image of `f`. -/
lemma localized_torsionBy_eq_torsionBy_at_prime
    {A : Type*} [CommRing A]
    {N : Type*} [AddCommGroup N] [Module A N]
    (f : A) (q : PrimeSpectrum A) :
    let Aq := Localization.AtPrime q.asIdeal
    let Nq := LocalizedModule.AtPrime q.asIdeal N
    (Submodule.torsionBy A N f).localized (p := q.asIdeal.primeCompl) =
      Submodule.torsionBy Aq Nq (algebraMap A Aq f) := by
  sorry

/-- Helper for Lemma 15.26.3: localizing the quotient by `f`-torsion agrees with quotienting the
localized module by the localized `f`-torsion. -/
noncomputable def localized_quotient_torsionBy_linearEquiv_global_quotient_at_prime
    {A : Type*} [CommRing A]
    {N : Type*} [AddCommGroup N] [Module A N]
    (f : A) (q : PrimeSpectrum A) :
    let Aq := Localization.AtPrime q.asIdeal
    let Nq := LocalizedModule.AtPrime q.asIdeal N
    LocalizedModule.AtPrime q.asIdeal (N ⧸ Submodule.torsionBy A N f) ≃ₗ[Aq]
      Nq ⧸ Submodule.torsionBy Aq Nq (algebraMap A Aq f) :=
  (localizedQuotientEquiv q.asIdeal.primeCompl (Submodule.torsionBy A N f)).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _
      (localized_torsionBy_eq_torsionBy_at_prime (A := A) (N := N) f q)

/-- Helper for Lemma 15.26.3: a surjective linear map sends a generating family to a generating
family of the same cardinality. -/
lemma span_range_eq_top_of_surjective_linearMap
    {A : Type*} [CommRing A]
    {N N' : Type*} [AddCommGroup N] [Module A N] [AddCommGroup N'] [Module A N']
    {k : ℕ} (φ : N →ₗ[A] N') (hφ : Function.Surjective φ)
    {v : Fin k → N} (hv : Submodule.span A (Set.range v) = ⊤) :
    Submodule.span A (Set.range fun i ↦ φ (v i)) = ⊤ := by
  -- Convert both span conditions to surjectivity of the canonical linear-combination map.
  rw [span_range_eq_top_iff_surjective_fintypeLinearCombination]
  have hvsurj : Function.Surjective (Fintype.linearCombination A v) :=
    (span_range_eq_top_iff_surjective_fintypeLinearCombination A v).1 hv
  have hcomp :
      Fintype.linearCombination A (fun i ↦ φ (v i)) =
        φ.comp (Fintype.linearCombination A v) := by
    ext x
    simp [Fintype.linearCombination_apply]
  rw [hcomp]
  exact hφ.comp hvsurj

/-- Helper for Lemma 15.26.3: every localization of the strict transform on the affine blowup
chart is generated by `k` elements. -/
lemma affineBlowupStrictTransform_local_generators_at_prime (k : ℕ)
    (a : Fit[R]_(k)(M))
    (q : PrimeSpectrum R[Fit[R]_(k)(M) / a]) :
    let A := R[Fit[R]_(k)(M) / a]
    let M' := affineBlowupStrictTransform (Fit[R]_(k)(M)) a M
    ∃ v : Fin k → LocalizedModule.AtPrime q.asIdeal M',
      Submodule.span (Localization.AtPrime q.asIdeal) (Set.range v) = ⊤ := by
  sorry

/-- Helper for Lemma 15.26.3: the `k`th Fitting ideal of the strict transform is not contained in
any prime of the affine blowup chart. -/
lemma fittingIdeal_affineBlowupStrictTransform_not_le_prime (k : ℕ)
    (a : Fit[R]_(k)(M))
    (q : PrimeSpectrum R[Fit[R]_(k)(M) / a]) :
    let A := R[Fit[R]_(k)(M) / a]
    let M' := affineBlowupStrictTransform (Fit[R]_(k)(M)) a M
    ¬ Fit[A]_(k)(M') ≤ q.asIdeal := by
  sorry

omit [Module.Finite R M] in
/-- Helper for Lemma 15.26.3: if the strict-transform Fitting ideal is proper on the affine
blowup chart, then it is contained in some chart prime ideal. -/
lemma exists_prime_over_proper_fittingIdeal_affineBlowupStrictTransform (k : ℕ)
    (a : Fit[R]_(k)(M)) :
    let A := R[Fit[R]_(k)(M) / a]
    let M' := affineBlowupStrictTransform (Fit[R]_(k)(M)) a M
    Fit[A]_(k)(M') ≠ ⊤ →
      ∃ q : PrimeSpectrum A, Fit[A]_(k)(M') ≤ q.asIdeal := by
  dsimp
  intro hproper
  -- Any proper ideal is contained in a maximal ideal, hence in the corresponding prime.
  obtain ⟨m, hmmax, hle⟩ :=
    Ideal.exists_le_maximal
      (Fit[R[Fit[R]_(k)(M) / a]]_(k)(affineBlowupStrictTransform (Fit[R]_(k)(M)) a M))
      hproper
  exact ⟨⟨m, hmmax.isPrime⟩, hle⟩

/-- Lemma 15.26.3: if `a` is an element of the `k`th Fitting ideal of a finite `R`-module `M`,
then the quotient of the base change `R[Fit_k(M) / a] ⊗[R] M` by its `a`-power torsion, i.e. the
strict transform along the affine blowup `R[Fit_k(M) / a]`, has `k`th Fitting ideal equal to the
unit ideal. -/
@[stacks 0CZM]
theorem fittingIdeal_affineBlowupStrictTransform_eq_top (k : ℕ)
    (a : Fit[R]_(k)(M)) :
    let A := R[Fit[R]_(k)(M) / a]
    let M' := affineBlowupStrictTransform (Fit[R]_(k)(M)) a M
    Fit[A]_(k)(M') = ⊤ := by
  dsimp
  -- Route note: the proof stays on the source-faithful chart-localization argument; the only
  -- validation blocker in this attempt comes from rebuilding the prerequisite base-change file.
  -- If the Fitting ideal were proper, it would lie in some maximal ideal, hence in a prime.
  by_contra hFit
  rcases
      exists_prime_over_proper_fittingIdeal_affineBlowupStrictTransform
        (R := R)
        (M := M)
        k
        a
        hFit with
    ⟨q, hle⟩
  exact
    (fittingIdeal_affineBlowupStrictTransform_not_le_prime
      (R := R)
      (M := M)
      k
      a
      q)
      hle

end
