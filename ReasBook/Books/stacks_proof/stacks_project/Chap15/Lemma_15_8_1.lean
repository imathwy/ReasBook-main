Source/core/bridge triage:
- `source-facing`: the textbook determinantal ideal of the `r × r` minors of a matrix;
- `core/canonical`: `Matrix.minorIdeal`;
- `bridge/view`: the later presentation/Fitting-ideal and linear-map specializations. -/

section

variable {R : Type u} [CommRing R]

namespace Matrix

/-- The ideal generated by the `r × r` minors of a matrix. This realizes the conventions
`I_0(A) = R` and `I_r(A) = 0` when `r` exceeds the number of available rows or columns. We use
the Lean notation `I_(r)(A)` for this ideal. -/
def minorIdeal {ι : Type v} {κ : Type w} (r : ℕ) (A : Matrix ι κ R) : Ideal R :=
  Ideal.span <| Set.range fun p : (Fin r ↪ ι) × (Fin r ↪ κ) ↦
    (A.submatrix p.1 p.2).det

notation:max "I_(" r:max ")(" A:arg ")" => minorIdeal r A

/-- Every `r × r` minor of `A` belongs to the ideal generated by all `r × r` minors of `A`. -/
-- Proof sketch: unfold `I_(r)(A)` and use the defining inclusion of each generator into
-- `Ideal.span`.
theorem det_submatrix_mem_minorIdeal {ι : Type v} {κ : Type w}
    (r : ℕ) (A : Matrix ι κ R) (e₁ : Fin r ↪ ι) (e₂ : Fin r ↪ κ) :
    (A.submatrix e₁ e₂).det ∈ I_(r)(A) := by
  -- Unfold the owner ideal and insert the chosen minor as one of the spanning generators.
  refine Ideal.subset_span ?_
  exact ⟨(e₁, e₂), rfl⟩

/-- Helper for Lemma 15.8.1: a determinant built from any row-selector already belongs to the
corresponding minor ideal; repeated rows force the non-injective cases to vanish. -/
lemma det_submatrix_mem_minorIdeal_of_rowMap {ι : Type v} {κ : Type w}
    (r : ℕ) (A : Matrix ι κ R) (f : Fin r → ι) (e₂ : Fin r ↪ κ) :
    (A.submatrix f e₂).det ∈ I_(r)(A) := by
  classical
  by_cases hf : Function.Injective f
  · -- In the injective case, the chosen rows define an actual `r × r` minor of `A`.
    let e₁ : Fin r ↪ ι := ⟨f, hf⟩
    simpa [e₁] using det_submatrix_mem_minorIdeal r A e₁ e₂
  · -- In the non-injective case, two equal rows force the determinant to vanish.
    rw [Function.Injective] at hf
    push Not at hf
    rcases hf with ⟨i, j, hij, hfj⟩
    have hrows : (A.submatrix f e₂) i = (A.submatrix f e₂) j := by
      funext k
      simpa [Matrix.submatrix_apply, hij]
    rw [Matrix.det_zero_of_row_eq hfj hrows]
    exact (I_(r)(A)).zero_mem

/-- Helper for Lemma 15.8.1: enlarging the minor size by one only decreases the corresponding
determinantal ideal. -/
lemma minorIdeal_succ_le {ι : Type v} {κ : Type w}
    (r : ℕ) (A : Matrix ι κ R) : I_((r + 1))(A) ≤ I_(r)(A) := by
  -- Each `(r + 1) × (r + 1)` generator expands into a sum of coefficients times `r × r` minors.
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
  change (A.submatrix e₁ e₂).det ∈ I_(r)(A)
  let M : Matrix (Fin (r + 1)) (Fin (r + 1)) R := A.submatrix e₁ e₂
  rw [show (A.submatrix e₁ e₂).det = M.det by rfl, Matrix.det_succ_row_zero]
  refine (I_(r)(A)).sum_mem fun j _ ↦ ?_
  have hminor :
      (M.submatrix Fin.succ j.succAbove).det ∈ I_(r)(A) := by
    -- The cofactor determinant is itself an `r × r` minor of `A`.
    have hrows : (fun x : Fin r ↦ e₁ x.succ) = fun x ↦ e₁ (Fin.succEmb r x) := by
      rfl
    simpa [M, Matrix.submatrix_submatrix, Function.comp_def, Function.Embedding.coe_trans,
      Function.Embedding.trans_apply, Fin.coe_succEmb, Fin.coe_succAboveEmb, hrows] using
      det_submatrix_mem_minorIdeal r A
        ((Fin.succEmb r).trans e₁)
        (j.succAboveEmb.trans e₂)
  -- Multiplying a known minor by ambient ring coefficients keeps it inside the ideal.
  simpa [mul_assoc] using
    Ideal.mul_mem_left (I_(r)(A)) (((-1 : R) ^ (j : ℕ)) * M 0 j) hminor

/-- Helper for Lemma 15.8.1: an embedding into `Fin (n + 1)` that avoids the last element factors
through `Fin.castSucc`. -/
lemma exists_castSucc_eq_of_forall_ne_last {α : Type*} {n : ℕ}
    (e : α ↪ Fin (n + 1)) (h : ∀ a, e a ≠ Fin.last n) :
    ∃ e' : α ↪ Fin n, Fin.castSucc ∘ e' = e := by
  refine ⟨⟨fun a ↦ Fin.castPred (e a) (h a), ?_⟩, ?_⟩
  · intro a b hab
    apply e.injective
    rw [← Fin.castSucc_castPred (e a) (h a), ← Fin.castSucc_castPred (e b) (h b)]
    exact congrArg Fin.castSucc hab
  · funext a
    exact Fin.castSucc_castPred (e a) (h a)

/-- Helper for Lemma 15.8.1: deleting one final row lowers the minor size by one while keeping the
resulting minors inside the ideal of the truncated matrix. -/
lemma minorIdeal_last_row_extension_le {n m : ℕ} (r : ℕ)
    (B : Matrix (Fin (n + 1)) (Fin m) R) :
    I_((r + 1))(B) ≤ I_(r)((B.submatrix Fin.castSucc id)) := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
  change (B.submatrix e₁ e₂).det ∈ I_(r)((B.submatrix Fin.castSucc id))
  by_cases hlast : ∃ i, e₁ i = Fin.last n
  · obtain ⟨i₀, hi₀⟩ := hlast
    let M : Matrix (Fin (r + 1)) (Fin (r + 1)) R := B.submatrix e₁ e₂
    rw [show (B.submatrix e₁ e₂).det = M.det by rfl, Matrix.det_succ_row M i₀]
    refine (I_(r)((B.submatrix Fin.castSucc id))).sum_mem fun j _ ↦ ?_
    have havoid : ∀ i : Fin r, e₁ (i₀.succAbove i) ≠ Fin.last n := by
      intro i hlast'
      apply i₀.succAbove_ne i
      exact e₁.injective (hlast'.trans hi₀.symm)
    obtain ⟨e₁', he₁'⟩ :=
      exists_castSucc_eq_of_forall_ne_last
        (i₀.succAboveEmb.trans e₁) havoid
    have hminor :
        (M.submatrix i₀.succAbove j.succAbove).det ∈ I_(r)((B.submatrix Fin.castSucc id)) := by
      -- After removing the row mapping to the last index, the cofactor lives in the truncated rows.
      have hrows : (fun x : Fin r ↦ (e₁' x).castSucc) = fun x ↦ e₁ (i₀.succAbove x) := by
        simpa [Function.comp_def, Function.Embedding.coe_trans] using he₁'
      simpa [M, Matrix.submatrix_submatrix, Function.comp_def, Function.Embedding.coe_trans,
        Function.Embedding.trans_apply, Fin.castSuccEmb_apply, Fin.coe_succAboveEmb, hrows] using
        det_submatrix_mem_minorIdeal r (B.submatrix Fin.castSucc id) e₁'
          (j.succAboveEmb.trans e₂)
    -- Each Laplace-expansion term is a scalar multiple of one of those truncated minors.
    simpa [mul_assoc] using
      Ideal.mul_mem_left (I_(r)((B.submatrix Fin.castSucc id)))
        (((-1 : R) ^ (i₀ + j : ℕ)) * M i₀ j) hminor
  · obtain ⟨e₁', he₁'⟩ :=
      exists_castSucc_eq_of_forall_ne_last e₁ (fun i h ↦ hlast ⟨i, h⟩)
    have hmem :
        (B.submatrix e₁ e₂).det ∈ I_((r + 1))((B.submatrix Fin.castSucc id)) := by
      -- If the last row is unused, this generator is already a minor of the truncated matrix.
      rw [← he₁']
      simpa [Matrix.submatrix_submatrix, Function.comp_def] using
        det_submatrix_mem_minorIdeal (r + 1) (B.submatrix Fin.castSucc id) e₁' e₂
    -- The descending-chain step then lowers the size from `r + 1` to `r`.
    exact minorIdeal_succ_le r (B.submatrix Fin.castSucc id) hmem

/-- Lemma 15.8.1: for a fixed matrix `A`, the ideals generated by its minors form a descending
chain as the minor size increases. -/
-- Proof sketch: expand an `(r + 1) × (r + 1)` determinant along a row or column. Each resulting
-- term is an entry times an `r × r` minor, so every generator of `I_(r + 1)(A)` lies in
-- `I_(r)(A)`.
theorem minorIdeal_antitone {ι : Type v} {κ : Type w}
    (A : Matrix ι κ R) : Antitone (fun r ↦ I_(r)(A)) := by
  -- It is enough to prove the successor-step inclusion once and then iterate it along `ℕ`.
  refine antitone_nat_of_succ_le fun r ↦ ?_
  exact minorIdeal_succ_le r A

/-- Passing from a matrix to its first rows can only increase the corresponding minor ideals after
adjusting the minor size by the number of deleted rows. -/
-- Proof sketch: any `(r + n') × (r + n')` minor of `B` must use at least `r` rows from the first
-- `n` rows. Expanding the determinant along the remaining rows expresses that minor in the ideal
-- generated by `I_(r)(B.submatrix (Fin.castAdd n') id)`.
theorem minorIdeal_initialRows_le {n n' m : ℕ} (r : ℕ)
    (B : Matrix (Fin (n + n')) (Fin m) R) :
    I_((r + n'))(B) ≤ I_(r)((B.submatrix (Fin.castAdd n') id)) := by
  induction n' with
  | zero =>
      -- With no deleted rows, the statement is just reflexivity after simplifying the indexing.
      simpa using (le_rfl : I_(r)(B) ≤ I_(r)(B))
  | succ n' ih =>
      -- Delete the final row once, then iterate the same argument on the remaining `n'` extra rows.
      have hstep :
          I_((r + n' + 1))(B) ≤ I_((r + n'))((B.submatrix Fin.castSucc id)) := by
        simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
          minorIdeal_last_row_extension_le (r + n') B
      have hrest :
          I_((r + n'))((B.submatrix Fin.castSucc id)) ≤
            I_(r)(((B.submatrix Fin.castSucc id).submatrix (Fin.castAdd n') id)) :=
        ih (B := B.submatrix Fin.castSucc id)
      have hstep' :
          I_((r + (n' + 1)))(B) ≤ I_((r + n'))((B.submatrix Fin.castSucc id)) := by
        simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hstep
      exact hstep'.trans <|
        by simpa [Matrix.submatrix_submatrix, Function.comp_def, Nat.add_assoc] using hrest

/-- Helper for Lemma 15.8.1: each chosen `r × r` minor of `C * A` is an `R`-linear combination of
`r × r` minors of `A`, so it already lies in `I_(r)(A)`. -/
lemma det_submatrix_mul_left_mem_minorIdeal {ι : Type v} {κ : Type w} [Fintype ι]
    (r : ℕ) (C : Matrix ι ι R) (A : Matrix ι κ R)
    (e₁ : Fin r ↪ ι) (e₂ : Fin r ↪ κ) :
    (((C * A).submatrix e₁ e₂).det) ∈ I_(r)(A) := by
  classical
  let M : Matrix (Fin r) ι R := Aᵀ.submatrix e₂ (Equiv.refl ι)
  let N : Matrix ι (Fin r) R := Cᵀ.submatrix (Equiv.refl ι) e₁
  have hdet :
      ((C * A).submatrix e₁ e₂).det = (M * N).det := by
    -- Transpose the chosen minor so the determinant expansion groups by row-selector maps on `A`.
    calc
      ((C * A).submatrix e₁ e₂).det = (((C * A).submatrix e₁ e₂)ᵀ).det := by
        rw [Matrix.det_transpose]
      _ = (((C * A)ᵀ).submatrix e₂ e₁).det := by
        rw [Matrix.transpose_submatrix]
      _ = ((Aᵀ * Cᵀ).submatrix e₂ e₁).det := by
        rw [Matrix.transpose_mul]
      _ = ((Aᵀ.submatrix e₂ (Equiv.refl ι)) * (Cᵀ.submatrix (Equiv.refl ι) e₁)).det := by
        rw [← Matrix.submatrix_mul_equiv Aᵀ Cᵀ e₂ (Equiv.refl ι) e₁]
      _ = (M * N).det := by
        rfl
  rw [hdet]
  rw [show (M * N).det =
      ∑ p : Fin r → ι, ∑ σ : Equiv.Perm (Fin r),
        ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) * N (p i) i by
      simp only [Matrix.det_apply', Matrix.mul_apply, Finset.prod_univ_sum, Finset.mul_sum,
        Fintype.piFinset_univ]
      rw [Finset.sum_comm]]
  refine (I_(r)(A)).sum_mem fun p _ ↦ ?_
  have hp_det :
      ∑ σ : Equiv.Perm (Fin r), ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) =
        (A.submatrix p e₂).det := by
    -- The transposed expansion identifies the inner sum with the determinant of the chosen rows of
    -- `A`.
    calc
      ∑ σ : Equiv.Perm (Fin r), ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) =
          (M.submatrix id p).det := by
        symm
        exact Matrix.det_apply' (M.submatrix id p)
      _ = (Aᵀ.submatrix e₂ p).det := by
        simp [M, Matrix.submatrix_submatrix, Function.comp_def]
      _ = ((A.submatrix p e₂)ᵀ).det := by
        rw [Matrix.transpose_submatrix]
      _ = (A.submatrix p e₂).det := by
        rw [Matrix.det_transpose]
  have hp_factor :
      (∑ σ : Equiv.Perm (Fin r), ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) * N (p i) i) =
        (∏ i, N (p i) i) * (A.submatrix p e₂).det := by
    -- Pull the coefficient depending on `C` out of the permutation sum, leaving the determinant of
    -- the selected rows of `A`.
    calc
      (∑ σ : Equiv.Perm (Fin r), ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) * N (p i) i) =
          ∑ σ : Equiv.Perm (Fin r),
            (∏ i, N (p i) i) * (↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i)) := by
            refine Finset.sum_congr rfl fun σ _ ↦ ?_
            simp [Finset.prod_mul_distrib, mul_assoc, mul_left_comm, mul_comm]
      _ = (∏ i, N (p i) i) * ∑ σ : Equiv.Perm (Fin r),
            ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) := by
            rw [Finset.mul_sum]
      _ = (∏ i, N (p i) i) * (A.submatrix p e₂).det := by
            rw [hp_det]
  rw [hp_factor]
  -- Multiplying a selected minor of `A` by an ambient scalar keeps it inside the ideal.
  exact Ideal.mul_mem_left (I_(r)(A)) _ (det_submatrix_mem_minorIdeal_of_rowMap r A p e₂)

-- Proof sketch: apply Cauchy-Binet to each `r × r` minor of `C * A`. It becomes an `R`-linear
-- combination of `r × r` minors of `A`, hence belongs to `I_(r)(A)`.
theorem minorIdeal_mul_left_le {ι : Type v} {κ : Type w} [Fintype ι]
    (r : ℕ) (C : Matrix ι ι R) (A : Matrix ι κ R) :
    I_(r)((C * A)) ≤ I_(r)(A) := by
  -- Each generator is handled by the previous determinant-expansion lemma, so `Ideal.span_le`
  -- closes the whole inclusion.
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
  exact det_submatrix_mul_left_mem_minorIdeal r C A e₁ e₂

/-- Helper for Lemma 15.8.1: if a chosen minor of a block-diagonal matrix selects a different
number of left rows and left columns, then every permutation term in the determinant expansion
hits a zero off-diagonal entry, so the determinant vanishes. -/
lemma fromBlocks_det_submatrix_eq_zero_of_count_mismatch
    {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x} {κ₂ : Type y}
    (r : ℕ) (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R)
    (e₁ : Fin r ↪ Sum ι₁ ι₂) (e₂ : Fin r ↪ Sum κ₁ κ₂)
    [Fintype {i : Fin r // ∃ a : ι₁, e₁ i = Sum.inl a}]
    [Fintype {i : Fin r // ∃ a : κ₁, e₂ i = Sum.inl a}]
    (hcount :
      Fintype.card {i : Fin r // ∃ a : ι₁, e₁ i = Sum.inl a} ≠
        Fintype.card {i : Fin r // ∃ a : κ₁, e₂ i = Sum.inl a}) :
    (((Matrix.fromBlocks A₁ 0 0 A₂).submatrix e₁ e₂).det) = 0 := by
  classical
  let leftRow : Fin r → Prop := fun i ↦ ∃ a : ι₁, e₁ i = Sum.inl a
  let leftCol : Fin r → Prop := fun i ↦ ∃ a : κ₁, e₂ i = Sum.inl a
  let M : Matrix (Fin r) (Fin r) R := (Matrix.fromBlocks A₁ 0 0 A₂).submatrix e₁ e₂
  rw [show (((Matrix.fromBlocks A₁ 0 0 A₂).submatrix e₁ e₂).det) = M.det by rfl]
  rw [Matrix.det_apply']
  refine Finset.sum_eq_zero fun σ _ ↦ ?_
  have hnot_all_match : ¬ ∀ i : Fin r, leftRow (σ i) ↔ leftCol i := by
    intro hσ
    let e : {i : Fin r // leftCol i} ≃ {i : Fin r // leftRow i} := {
      toFun := fun i ↦ ⟨σ i, (hσ i).2 i.2⟩
      invFun := fun i ↦ ⟨σ⁻¹ i, by
        have h := hσ (σ⁻¹ i)
        exact h.mp (by simpa using i.2)⟩
      left_inv := fun i ↦ by
        apply Subtype.ext
        simp
      right_inv := fun i ↦ by
        apply Subtype.ext
        simp }
    exact hcount (Fintype.card_congr e).symm
  push Not at hnot_all_match
  rcases hnot_all_match with ⟨i, hi⟩
  have hzero : M (σ i) i = 0 := by
    -- Route correction: instead of reindexing first, we kill the offending permutation term
    -- directly by exhibiting a zero off-diagonal entry.
    dsimp [leftRow, leftCol] at hi
    rcases hi with hi | hi
    · rcases hi with ⟨hrow, hcol⟩
      rcases hrow with ⟨a, hrow⟩
      cases hcol' : e₂ i with
      | inl b =>
          exfalso
          exact hcol ⟨b, hcol'⟩
      | inr b =>
          simp [M, hrow, hcol']
    · rcases hi with ⟨hrow, hcol⟩
      rcases hcol with ⟨b, hcol⟩
      cases hrow' : e₁ (σ i) with
      | inl a =>
          exfalso
          exact hrow ⟨a, hrow'⟩
      | inr a =>
          simp [M, hrow', hcol]
  have hprod : ∏ j : Fin r, M (σ j) j = 0 := by
    rw [← Finset.insert_erase (Finset.mem_univ i), Finset.prod_insert (Finset.notMem_erase i _)]
    simp [hzero]
  rw [hprod, mul_zero]

/-- Helper for Lemma 15.8.1: an element of a sum type that cannot come from the left summand must
come from the right summand. -/
lemma exists_eq_inr_of_not_exists_eq_inl {α : Type*} {β : Type*} (s : α ⊕ β)
    (h : ¬ ∃ a : α, s = Sum.inl a) : ∃ b : β, s = Sum.inr b := by
  cases s with
  | inl a =>
      exact False.elim (h ⟨a, rfl⟩)
  | inr b =>
      exact ⟨b, rfl⟩

/-- Helper for Lemma 15.8.1: the cardinalities of a subtype and its complement add up to the
cardinality of the ambient finite type. -/
lemma card_subtype_add_card_subtype_not (α : Type*) [Fintype α] (P : α → Prop)
    [DecidablePred P] :
    Fintype.card {a // P a} + Fintype.card {a // ¬ P a} = Fintype.card α := by
  -- Reindex the ambient type by the explicit split equivalence and simplify cardinals.
  let e : α ≃ {a // P a} ⊕ {a // ¬ P a} :=
    { toFun := fun a ↦ if h : P a then Sum.inl ⟨a, h⟩ else Sum.inr ⟨a, h⟩
      invFun := fun s ↦ match s with
        | Sum.inl a => a.1
        | Sum.inr a => a.1
      left_inv := by
        intro a
        by_cases h : P a
        · simp [h]
        · simp [h]
      right_inv := by
        intro s
        cases s with
        | inl a =>
            simp [a.2]
        | inr a =>
            simp [a.2] }
  simpa [e] using (Fintype.card_congr e).symm

/-- Helper for Lemma 15.8.1: combining a chosen `p × p` minor of `A₁` and a chosen `q × q` minor
of `A₂` produces a `(p + q) × (p + q)` minor of the block-diagonal matrix. -/
lemma det_submatrix_fromBlocks_mem_minorIdeal {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x}
    {κ₂ : Type y} {p q : ℕ} (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R)
    (e₁ : Fin p ↪ ι₁) (f₁ : Fin q ↪ ι₂) (e₂ : Fin p ↪ κ₁) (f₂ : Fin q ↪ κ₂) :
    (A₁.submatrix e₁ e₂).det * (A₂.submatrix f₁ f₂).det ∈
      I_((p + q))((Matrix.fromBlocks A₁ 0 0 A₂)) := by
  let rowSel : Fin (p + q) ↪ (ι₁ ⊕ ι₂) :=
    finSumFinEquiv.symm.toEmbedding.trans (Function.Embedding.sumMap e₁ f₁)
  let colSel : Fin (p + q) ↪ (κ₁ ⊕ κ₂) :=
    finSumFinEquiv.symm.toEmbedding.trans (Function.Embedding.sumMap e₂ f₂)
  have hblock :
      Matrix.reindex finSumFinEquiv.symm finSumFinEquiv.symm
          ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix rowSel colSel) =
        Matrix.fromBlocks (A₁.submatrix e₁ e₂) 0 0 (A₂.submatrix f₁ f₂) := by
    -- Reindex the selected `Fin (p + q)` rows and columns back to the explicit left/right split.
    ext i j
    cases i <;> cases j <;>
      simp [Matrix.reindex_apply, rowSel, colSel, Function.Embedding.trans_apply,
        finSumFinEquiv_apply_left, finSumFinEquiv_apply_right]
  have hmem :
      (((Matrix.fromBlocks A₁ 0 0 A₂).submatrix rowSel colSel).det) ∈
        I_((p + q))((Matrix.fromBlocks A₁ 0 0 A₂)) :=
    det_submatrix_mem_minorIdeal (p + q) (Matrix.fromBlocks A₁ 0 0 A₂) rowSel colSel
  have hdet :
      ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix rowSel colSel).det =
        (A₁.submatrix e₁ e₂).det * (A₂.submatrix f₁ f₂).det := by
    -- After the reindex, the chosen minor is literally block diagonal, so its determinant factors.
    calc
      ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix rowSel colSel).det =
          (Matrix.reindex finSumFinEquiv.symm finSumFinEquiv.symm
            ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix rowSel colSel)).det := by
            symm
            exact Matrix.det_reindex_self finSumFinEquiv.symm _
      _ = (Matrix.fromBlocks (A₁.submatrix e₁ e₂) 0 0 (A₂.submatrix f₁ f₂)).det := by
            rw [hblock]
      _ = (A₁.submatrix e₁ e₂).det * (A₂.submatrix f₁ f₂).det := by
            rw [Matrix.det_fromBlocks_zero₁₂]
  rw [← hdet]
  exact hmem

/-- Helper for Lemma 15.8.1: each antidiagonal product term is contained in the minor ideal of the
block-diagonal matrix. -/
lemma minorIdeal_block_product_term_le_fromBlocks {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x}
    {κ₂ : Type y} {p q : ℕ} (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R) :
    I_(p)(A₁) * I_(q)(A₂) ≤ I_((p + q))((Matrix.fromBlocks A₁ 0 0 A₂)) := by
  let S₁ : Set R := Set.range fun p : (Fin p ↪ ι₁) × (Fin p ↪ κ₁) ↦ (A₁.submatrix p.1 p.2).det
  let S₂ : Set R := Set.range fun p : (Fin q ↪ ι₂) × (Fin q ↪ κ₂) ↦ (A₂.submatrix p.1 p.2).det
  let K : Ideal R := I_((p + q))((Matrix.fromBlocks A₁ 0 0 A₂))
  change Ideal.span S₁ * Ideal.span S₂ ≤ K
  refine Ideal.mul_le.2 ?_
  intro x hx y hy
  exact
    Submodule.span_induction (p := fun y _ ↦ ∀ x ∈ Ideal.span S₁, x * y ∈ K)
      (fun y hy x hx =>
        -- Reduce the product ideal generator-by-generator until the block-minor lemma applies.
        Submodule.span_induction (p := fun x _ ↦ x * y ∈ K)
          (fun x hx => by
            rcases hx with ⟨⟨e₁, e₂⟩, rfl⟩
            rcases hy with ⟨⟨f₁, f₂⟩, rfl⟩
            simpa [K] using det_submatrix_fromBlocks_mem_minorIdeal A₁ A₂ e₁ f₁ e₂ f₂)
          (by simp [K])
          (fun x₁ x₂ hx₁ hx₂ h₁ h₂ => by simpa [add_mul] using add_mem h₁ h₂)
          (fun a x hx h => by simpa [smul_eq_mul, mul_assoc] using Ideal.mul_mem_left K a h)
          hx)
      (by simp [K])
      (fun y₁ y₂ hy₁ hy₂ h₁ h₂ x hx => by simpa [mul_add] using add_mem (h₁ x hx) (h₂ x hx))
      (fun a y hy h x hx => by
        simpa [smul_eq_mul, mul_left_comm, mul_assoc] using Ideal.mul_mem_left K a (h x hx))
      hy x hx

/-- Helper for Lemma 15.8.1: reindexing a selected block minor back from a common left/right split
turns its determinant into a signed product of the two diagonal block determinants. -/
lemma selected_minor_det_eq_signed_block_product
    {α : Type*} [Fintype α] [DecidableEq α]
    {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x} {κ₂ : Type y} {p q : ℕ}
    (rowSplit colSplit : α ≃ Fin p ⊕ Fin q) (M : Matrix α α R)
    (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R)
    (row₁Emb : Fin p ↪ ι₁) (row₂Emb : Fin q ↪ ι₂)
    (col₁Emb : Fin p ↪ κ₁) (col₂Emb : Fin q ↪ κ₂)
    (hblock :
      Matrix.reindex rowSplit colSplit M =
        Matrix.fromBlocks (A₁.submatrix row₁Emb col₁Emb) 0 0 (A₂.submatrix row₂Emb col₂Emb)) :
    M.det =
      (↑(Equiv.Perm.sign (colSplit.symm.trans rowSplit)) : R) *
        ((A₁.submatrix row₁Emb col₁Emb).det * (A₂.submatrix row₂Emb col₂Emb).det) := by
  have hback :
      (Matrix.reindex rowSplit colSplit M).reindex rowSplit.symm colSplit.symm = M := by
    -- Reindexing back along the inverse equivalences returns the original selected minor.
    ext i j
    simp [Matrix.reindex_apply]
  -- Rewrite the original determinant through the common split, then factor the block diagonal.
  calc
    M.det = ((Matrix.reindex rowSplit colSplit M).reindex rowSplit.symm colSplit.symm).det := by
      rw [hback]
    _ = (↑(Equiv.Perm.sign (colSplit.symm.trans rowSplit)) : R) *
          (Matrix.reindex rowSplit colSplit M).det := by
      simpa using
        (Matrix.det_reindex rowSplit.symm colSplit.symm (Matrix.reindex rowSplit colSplit M))
    _ =
        (↑(Equiv.Perm.sign (colSplit.symm.trans rowSplit)) : R) *
          (Matrix.fromBlocks (A₁.submatrix row₁Emb col₁Emb) 0 0
            (A₂.submatrix row₂Emb col₂Emb)).det := by
      rw [hblock]
    _ =
        (↑(Equiv.Perm.sign (colSplit.symm.trans rowSplit)) : R) *
          ((A₁.submatrix row₁Emb col₁Emb).det * (A₂.submatrix row₂Emb col₂Emb).det) := by
      rw [Matrix.det_fromBlocks_zero₁₂]

/-- Helper for Lemma 15.8.1: the product of the two diagonal block minors belongs to the
corresponding product minor ideal. -/
lemma block_minor_product_mem_mul_minorIdeal
    {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x} {κ₂ : Type y} {p q : ℕ}
    (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R)
    (row₁Emb : Fin p ↪ ι₁) (row₂Emb : Fin q ↪ ι₂)
    (col₁Emb : Fin p ↪ κ₁) (col₂Emb : Fin q ↪ κ₂) :
    ((A₁.submatrix row₁Emb col₁Emb).det * (A₂.submatrix row₂Emb col₂Emb).det) ∈
      I_(p)(A₁) * I_(q)(A₂) := by
  -- Each diagonal block determinant is itself a generator of the corresponding minor ideal.
  exact Ideal.mul_mem_mul
    (det_submatrix_mem_minorIdeal p A₁ row₁Emb col₁Emb)
    (det_submatrix_mem_minorIdeal q A₂ row₂Emb col₂Emb)

/-- Helper for Lemma 15.8.1: the product ideal indexed by `(p, q)` is one summand of the full
antidiagonal sum for `p + q`. -/
lemma minorIdeal_block_term_le_antidiagonal_sum
    {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x} {κ₂ : Type y}
    (p q : ℕ) (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R) :
    I_(p)(A₁) * I_(q)(A₂) ≤
      Finset.sum (Finset.antidiagonal (p + q)) fun t ↦ I_((t.1))(A₁) * I_((t.2))(A₂) := by
  -- Rewrite the finite ideal sum as a supremum and pick out the specific antidiagonal term.
  rw [Ideal.sum_eq_sup]
  exact Finset.le_sup (s := Finset.antidiagonal (p + q)) (f := fun t ↦ I_((t.1))(A₁) * I_((t.2))(A₂))
    (b := (p, q)) (by exact Finset.mem_antidiagonal.mpr (by simp))

/-- Helper for Lemma 15.8.1: every chosen minor of a block-diagonal matrix lands in the
corresponding antidiagonal sum of product minor ideals. -/
lemma fromBlocks_det_submatrix_mem_antidiagonal_sum
    {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x} {κ₂ : Type y}
    (r : ℕ) (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R)
    (e₁ : Fin r ↪ Sum ι₁ ι₂) (e₂ : Fin r ↪ Sum κ₁ κ₂) :
    (((Matrix.fromBlocks A₁ 0 0 A₂).submatrix e₁ e₂).det) ∈
      Finset.sum (Finset.antidiagonal r) fun p ↦ I_((p.1))(A₁) * I_((p.2))(A₂) := by
  classical
  let LeftRow : Type := {i : Fin r // ∃ a : ι₁, e₁ i = Sum.inl a}
  let LeftCol : Type := {i : Fin r // ∃ a : κ₁, e₂ i = Sum.inl a}
  by_cases hcount : Fintype.card LeftRow = Fintype.card LeftCol
  · let RightRow : Type := {i : Fin r // ¬ ∃ a : ι₁, e₁ i = Sum.inl a}
    let RightCol : Type := {i : Fin r // ¬ ∃ a : κ₁, e₂ i = Sum.inl a}
    let p : ℕ := Fintype.card LeftRow
    let q : ℕ := Fintype.card RightRow
    let rowLeftEquiv : LeftRow ≃ Fin p := Fintype.equivFin LeftRow
    let rowRightEquiv : RightRow ≃ Fin q := Fintype.equivFin RightRow
    have hLeftColCard : Fintype.card LeftCol = p := by
      simpa [p] using hcount.symm
    have hpq : p + q = r := by
      -- The chosen rows split into those landing in the left block and those landing in the right.
      unfold p q
      simpa [LeftRow, RightRow] using
        card_subtype_add_card_subtype_not (α := Fin r)
          (P := fun i ↦ ∃ a : ι₁, e₁ i = Sum.inl a)
    have hcolSum : Fintype.card LeftCol + Fintype.card RightCol = r := by
      -- The same cardinal decomposition holds for the chosen columns.
      simpa [LeftCol, RightCol] using
        card_subtype_add_card_subtype_not (α := Fin r)
          (P := fun i ↦ ∃ a : κ₁, e₂ i = Sum.inl a)
    -- Route correction: the remaining forward-inclusion blocker is exactly the balanced-count
    -- normalization to a common `Fin p ⊕ Fin q` split before determinant factorization.
    --
    -- TODO: build `colLeftEquiv : LeftCol ≃ Fin p` and `colRightEquiv : RightCol ≃ Fin q`,
    -- then construct `rowSplit colSplit : Fin r ≃ Fin p ⊕ Fin q`. Reindex the selected minor by
    -- those equivalences to a literal block diagonal matrix
    -- `Matrix.fromBlocks (A₁.submatrix row₁ col₁) 0 0 (A₂.submatrix row₂ col₂)`, rewrite its
    -- determinant via `Matrix.det_reindex_self` and `Matrix.det_fromBlocks_zero₁₂`, and insert
    -- the resulting product minor into the antidiagonal summand `(p, q)`.
    have hRightWitness :
        ∀ i : RightRow, ∃ b : ι₂, e₁ i.1 = Sum.inr b := by
      intro i
      exact exists_eq_inr_of_not_exists_eq_inl (e₁ i.1) i.2
    have hRightColCard : Fintype.card RightCol = q := by
      omega
    have hRightColWitness :
        ∀ i : RightCol, ∃ b : κ₂, e₂ i.1 = Sum.inr b := by
      intro i
      exact exists_eq_inr_of_not_exists_eq_inl (e₂ i.1) i.2
    let colLeftEquiv : LeftCol ≃ Fin p := by
      -- The balanced branch identifies the left-column count with the already fixed `p`.
      simpa [p, hLeftColCard] using (Fintype.equivFin LeftCol)
    let colRightEquiv : RightCol ≃ Fin q := by
      -- The complementary column count then matches the row-side `q`.
      simpa [q, hRightColCard] using (Fintype.equivFin RightCol)
    let rowSubtypeSplit : Fin r ≃ LeftRow ⊕ RightRow := by
      refine
        { toFun := fun i ↦
            if h : ∃ a : ι₁, e₁ i = Sum.inl a then Sum.inl ⟨i, h⟩ else Sum.inr ⟨i, h⟩
          invFun := fun s ↦ match s with
            | Sum.inl i => i.1
            | Sum.inr i => i.1
          left_inv := ?_
          right_inv := ?_ }
      · intro i
        by_cases h : ∃ a : ι₁, e₁ i = Sum.inl a
        · simp [h]
        · simp [h]
      · intro s
        cases s with
        | inl i =>
            simp [i.2]
        | inr i =>
            simp [i.2]
    let colSubtypeSplit : Fin r ≃ LeftCol ⊕ RightCol := by
      refine
        { toFun := fun i ↦
            if h : ∃ a : κ₁, e₂ i = Sum.inl a then Sum.inl ⟨i, h⟩ else Sum.inr ⟨i, h⟩
          invFun := fun s ↦ match s with
            | Sum.inl i => i.1
            | Sum.inr i => i.1
          left_inv := ?_
          right_inv := ?_ }
      · intro i
        by_cases h : ∃ a : κ₁, e₂ i = Sum.inl a
        · simp [h]
        · simp [h]
      · intro s
        cases s with
        | inl i =>
            simp [i.2]
        | inr i =>
            simp [i.2]
    let rowFinSplit : LeftRow ⊕ RightRow ≃ Fin p ⊕ Fin q := by
      refine
        { toFun := fun s ↦ match s with
            | Sum.inl i => Sum.inl (rowLeftEquiv i)
            | Sum.inr i => Sum.inr (rowRightEquiv i)
          invFun := fun s ↦ match s with
            | Sum.inl i => Sum.inl (rowLeftEquiv.symm i)
            | Sum.inr i => Sum.inr (rowRightEquiv.symm i)
          left_inv := ?_
          right_inv := ?_ }
      · intro s
        cases s <;> simp [rowLeftEquiv, rowRightEquiv]
      · intro s
        cases s <;> simp [rowLeftEquiv, rowRightEquiv]
    let colFinSplit : LeftCol ⊕ RightCol ≃ Fin p ⊕ Fin q := by
      refine
        { toFun := fun s ↦ match s with
            | Sum.inl i => Sum.inl (colLeftEquiv i)
            | Sum.inr i => Sum.inr (colRightEquiv i)
          invFun := fun s ↦ match s with
            | Sum.inl i => Sum.inl (colLeftEquiv.symm i)
            | Sum.inr i => Sum.inr (colRightEquiv.symm i)
          left_inv := ?_
          right_inv := ?_ }
      · intro s
        cases s <;> simp [colLeftEquiv, colRightEquiv]
      · intro s
        cases s <;> simp [colLeftEquiv, colRightEquiv]
    let rowSplit : Fin r ≃ Fin p ⊕ Fin q := rowSubtypeSplit.trans rowFinSplit
    let colSplit : Fin r ≃ Fin p ⊕ Fin q := colSubtypeSplit.trans colFinSplit
    have hrow₁_exists : ∀ i : Fin p, ∃ a : ι₁, e₁ (rowSplit.symm (Sum.inl i)) = Sum.inl a := by
      -- The left part of `rowSplit` records exactly the selected rows landing in the left block.
      intro i
      simpa [rowSplit, rowFinSplit, rowSubtypeSplit] using
        (rowLeftEquiv.symm i).2
    have hrow₂_exists : ∀ j : Fin q, ∃ b : ι₂, e₁ (rowSplit.symm (Sum.inr j)) = Sum.inr b := by
      -- The right part of `rowSplit` packages the complementary selected rows.
      intro j
      simpa [rowSplit, rowFinSplit, rowSubtypeSplit] using
        hRightWitness (rowRightEquiv.symm j)
    have hcol₁_exists : ∀ i : Fin p, ∃ a : κ₁, e₂ (colSplit.symm (Sum.inl i)) = Sum.inl a := by
      -- Balanced cardinalities let us package the left columns in the same `Fin p` codomain.
      intro i
      simpa [colSplit, colFinSplit, colSubtypeSplit] using
        (colLeftEquiv.symm i).2
    have hcol₂_exists : ∀ j : Fin q, ∃ b : κ₂, e₂ (colSplit.symm (Sum.inr j)) = Sum.inr b := by
      -- The remaining selected columns then land in the right block.
      intro j
      simpa [colSplit, colFinSplit, colSubtypeSplit] using
        hRightColWitness (colRightEquiv.symm j)
    have hSplitReady :
        p + q = r ∧
          (∀ i : Fin p, ∃ a : ι₁, e₁ (rowSplit.symm (Sum.inl i)) = Sum.inl a) ∧
          (∀ j : Fin q, ∃ b : ι₂, e₁ (rowSplit.symm (Sum.inr j)) = Sum.inr b) ∧
          (∀ i : Fin p, ∃ a : κ₁, e₂ (colSplit.symm (Sum.inl i)) = Sum.inl a) ∧
          (∀ j : Fin q, ∃ b : κ₂, e₂ (colSplit.symm (Sum.inr j)) = Sum.inr b) := by
      exact ⟨hpq, hrow₁_exists, hrow₂_exists, hcol₁_exists, hcol₂_exists⟩
    clear hSplitReady
    choose row₁ hrow₁ using hrow₁_exists
    choose row₂ hrow₂ using hrow₂_exists
    choose col₁ hcol₁ using hcol₁_exists
    choose col₂ hcol₂ using hcol₂_exists
    let row₁Emb : Fin p ↪ ι₁ := ⟨row₁, by
      intro i j hij
      exact Sum.inl.inj <| rowSplit.symm.injective <| e₁.injective <| by
        rw [hrow₁ i, hrow₁ j, hij]⟩
    let row₂Emb : Fin q ↪ ι₂ := ⟨row₂, by
      intro i j hij
      exact Sum.inr.inj <| rowSplit.symm.injective <| e₁.injective <| by
        rw [hrow₂ i, hrow₂ j, hij]⟩
    let col₁Emb : Fin p ↪ κ₁ := ⟨col₁, by
      intro i j hij
      exact Sum.inl.inj <| colSplit.symm.injective <| e₂.injective <| by
        rw [hcol₁ i, hcol₁ j, hij]⟩
    let col₂Emb : Fin q ↪ κ₂ := ⟨col₂, by
      intro i j hij
      exact Sum.inr.inj <| colSplit.symm.injective <| e₂.injective <| by
        rw [hcol₂ i, hcol₂ j, hij]⟩
    have hblock :
        Matrix.reindex rowSplit colSplit
            (((Matrix.fromBlocks A₁ 0 0 A₂).submatrix e₁ e₂)) =
          Matrix.fromBlocks (A₁.submatrix row₁Emb col₁Emb) 0 0 (A₂.submatrix row₂Emb col₂Emb) := by
      -- Once both sides use the common `Fin p ⊕ Fin q` coordinates, the selected minor is block
      -- diagonal by inspection of the four block cases.
      ext i j
      cases i <;> cases j <;>
        simp [Matrix.reindex_apply, Matrix.submatrix_apply, row₁Emb, row₂Emb, col₁Emb, col₂Emb,
          hrow₁, hrow₂, hcol₁, hcol₂]
    have hdet :
        (((Matrix.fromBlocks A₁ 0 0 A₂).submatrix e₁ e₂).det) =
          (↑(Equiv.Perm.sign (colSplit.symm.trans rowSplit)) : R) *
            ((A₁.submatrix row₁Emb col₁Emb).det * (A₂.submatrix row₂Emb col₂Emb).det) := by
      -- Route correction: transport the determinant through the common split before factoring the
      -- literal block diagonal matrix.
      exact selected_minor_det_eq_signed_block_product rowSplit colSplit
        ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix e₁ e₂) A₁ A₂
        row₁Emb row₂Emb col₁Emb col₂Emb hblock
    have hprod :
        ((A₁.submatrix row₁Emb col₁Emb).det * (A₂.submatrix row₂Emb col₂Emb).det) ∈
          I_(p)(A₁) * I_(q)(A₂) :=
      block_minor_product_mem_mul_minorIdeal A₁ A₂ row₁Emb row₂Emb col₁Emb col₂Emb
    have hsigned :
        (↑(Equiv.Perm.sign (colSplit.symm.trans rowSplit)) : R) *
            ((A₁.submatrix row₁Emb col₁Emb).det * (A₂.submatrix row₂Emb col₂Emb).det) ∈
          I_(p)(A₁) * I_(q)(A₂) := by
      -- Multiplying by the sign scalar keeps the element inside the same ideal.
      exact Ideal.mul_mem_left _ _ hprod
    have hsum :
        (↑(Equiv.Perm.sign (colSplit.symm.trans rowSplit)) : R) *
            ((A₁.submatrix row₁Emb col₁Emb).det * (A₂.submatrix row₂Emb col₂Emb).det) ∈
          Finset.sum (Finset.antidiagonal r) fun t ↦ I_((t.1))(A₁) * I_((t.2))(A₂) := by
      -- The balanced block product sits in the antidiagonal summand indexed by `(p, q)`.
      simpa [hpq] using
        (minorIdeal_block_term_le_antidiagonal_sum p q A₁ A₂) hsigned
    -- Rewriting by the determinant factorization finishes the balanced-count case.
    rw [hdet]
    exact hsum
  · -- In the mismatch case, the selected determinant is zero, hence belongs to every ideal.
    rw [fromBlocks_det_submatrix_eq_zero_of_count_mismatch r A₁ A₂ e₁ e₂ hcount]
    exact (Finset.sum (Finset.antidiagonal r) fun p ↦ I_((p.1))(A₁) * I_((p.2))(A₂)).zero_mem

/-- For a block diagonal matrix, the ideal of `r × r` minors is the sum of products of the minor
ideals of the diagonal blocks over all decompositions `r = r₁ + r₂`. -/
-- Proof sketch: a nonzero minor of a block diagonal matrix must choose `r₁` rows and columns in
-- the first block and `r₂` rows and columns in the second block. The determinant then factors as
-- the product of the corresponding block minors, and summing over `Finset.antidiagonal r` gives
-- the full ideal `I_(r)(fromBlocks A₁ 0 0 A₂)`.
theorem minorIdeal_fromBlocks {ι₁ : Type v} {ι₂ : Type w} {κ₁ : Type x} {κ₂ : Type y}
    (r : ℕ) (A₁ : Matrix ι₁ κ₁ R) (A₂ : Matrix ι₂ κ₂ R) :
    I_(r)((fromBlocks A₁ 0 0 A₂)) =
      Finset.sum (Finset.antidiagonal r) fun p ↦ I_((p.1))(A₁) * I_((p.2))(A₂) := by
  -- Route correction: the reverse inclusion is now reduced to the direct-sum generator lemma
  -- above, so the remaining blocker is only the forward inclusion from arbitrary selected rows and
  -- columns to the matching antidiagonal term.
  refine le_antisymm ?_ ?_
  · -- Each generator is handled by the dedicated block-minor lemma, so `Ideal.span_le` closes
    -- the forward inclusion once we analyze a single selected determinant.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
    exact fromBlocks_det_submatrix_mem_antidiagonal_sum r A₁ A₂ e₁ e₂
  · -- The reverse inclusion is termwise: each antidiagonal product term comes from a block minor.
    rw [Ideal.sum_eq_sup]
    refine Finset.sup_le_iff.2 ?_
    intro a ha
    rcases Finset.mem_antidiagonal.mp ha with hsum
    simpa [hsum] using
      minorIdeal_block_product_term_le_fromBlocks (p := a.1) (q := a.2) A₁ A₂

end Matrix

end
