local notation "Ω" => closedPoints (PrimeSpectrum R)
local notation "V(" x ")" => closedPointFiberVisibleQuotient M x

/-- Helper for Theorem 15.128.5: the rank-one map generated by a section `s0` sends `r` to
`r • s0`. -/
noncomputable def singleton_section_linearMap (s0 : M) : R →ₗ[R] M where
  toFun := fun r ↦ r • s0
  map_add' r r' := by
    simp [add_smul]
  map_smul' a r := by
    simp [mul_smul]

/-- Helper for Theorem 15.128.5: the singleton family map on `Fin 1` is the basis-construction
used in Lemma `15.128.2`. -/
noncomputable def singleton_family_linearMap (s0 : M) : (Fin 1 → R) →ₗ[R] M :=
  (Pi.basisFun R (Fin 1)).constr R (fun _ : Fin 1 => s0)

/-- Helper for Theorem 15.128.5: after identifying `Fin 1 → R` with `R`, the family map for the
singleton section is exactly the rank-one map generated by that section. -/
lemma singleton_family_linearMap_eq_singleton_section_linearMap_comp_funUnique
    (s0 : M) :
    singleton_family_linearMap (R := R) (M := M) s0 =
      (singleton_section_linearMap (R := R) (M := M) s0).comp
        (LinearEquiv.funUnique (Fin 1) R R).toLinearMap := by
  -- Both maps send the unique basis vector of `Fin 1 → R` to `s0`, so they agree on every input.
  ext v
  simp [singleton_family_linearMap, singleton_section_linearMap]

/-- Helper for Theorem 15.128.5: a closed subset of the closed-point space whose irreducible
components all have codimension at least `d + 1` must be empty once `topologicalKrullDim Ω ≤ d`.
-/
lemma eq_empty_of_irreducible_components_codim_succ_gt_topologicalKrullDim
    {d : ℕ} {F : Set Ω} (hFclosed : IsClosed F)
    (hcodim : irreducible_components_codim_at_least (d + 1) F)
    (hdim : topologicalKrullDim Ω ≤ d) :
    F = ∅ := by
  by_contra hFne
  obtain ⟨x, hxF⟩ : F.Nonempty := Set.nonempty_iff_ne_empty.mpr hFne
  obtain ⟨S, hS⟩ :=
    finite_maximal_components_not_subset (C := F) (D := (∅ : Set Ω)) hFclosed
  obtain ⟨Z, hZS, hxZ⟩ :=
    mem_some_listed_component_of_mem_owner_diff_base
      (C := F) (D := (∅ : Set Ω)) hFclosed hS hxF (by simp)
  have hZmax :
      Maximal (fun Y : IrreducibleCloseds Ω ↦ (Y : Set Ω) ⊆ F) Z :=
    (hS Z).1 hZS |>.1
  have hcodimZ : ((d + 1 : ℕ) : ℕ∞) ≤ coheight Z := hcodim Z hZmax
  have hcoheight : coheight Z ≤ topologicalKrullDim Ω := by
    -- Compare the component codimension with the ambient Krull dimension.
    simpa [topologicalKrullDim] using Order.coheight_le_krullDim Z
  have hsucc_not_le : ¬ (((d + 1 : ℕ) : ℕ∞) ≤ d) := by
    simp
  exact hsucc_not_le (le_trans hcodimZ (le_trans hcoheight hdim))

/-- Helper for Theorem 15.128.5: if the singleton dependence locus misses a closed point, then the
corresponding rank-one family already splits after inverting near that point. -/
lemma singleton_selectedSectionsSplitAfterInverting_of_not_mem_dependence_locus
    (x : Ω) {s0 : M}
    (hx :
      x ∉ section_dependence_locus
        (Fin.snoc (fun i : Fin 0 => nomatch i) s0)) :
    selectedSectionsSplitAfterInverting x (fun _ : Fin 1 => s0) := by
  -- Normalize the singleton bad-locus condition into visible linear independence.
  have hlin_snoc :
      LinearIndependent (κ(x))
        (Fin.snoc (closedPointFiberVisibleClass x ∘ (fun i : Fin 0 => nomatch i))
          (closedPointFiberVisibleClass x s0)) := by
    simpa using
      (not_mem_section_dependence_locus_snoc_iff
        (R := R) (M := M) x (fun i : Fin 0 => nomatch i) s0).1 hx
  have hlin :
      LinearIndependent (κ(x))
        (closedPointFiberVisibleClass x ∘ (fun _ : Fin 1 => s0)) := by
    -- The `Fin.snoc` presentation is definitionally the singleton family on `Fin 1`.
    simpa [Function.comp] using hlin_snoc
  -- Lemma `15.128.2` upgrades visible independence to splitting after inverting.
  exact
    (selectedSections_splitAfterInverting_iff_linearIndependent_visibleClasses
      (M := M) x (fun _ : Fin 1 => s0)).2 hlin

variable [Module.FinitePresentation R M]

/- Route correction: the source-faithful remaining step is not another fibrewise argument. After
constructing a singleton section whose dependence locus is empty, one must convert the resulting
local splittings into universal injectivity and then split the associated short exact sequence. -/
/-- Helper for Theorem 15.128.5: localizing the away-local singleton-family retraction at a prime
of `Spec(R_f)` preserves the split identity. -/
lemma localized_leftInverse_of_away_singleton_family_split
    (s0 : M) {f : R} (qAway : PrimeSpectrum (Localization.Away f))
    {ρ : LocalizedModule.Away f M →ₗ[Localization.Away f]
      LocalizedModule.Away f (Fin 1 → R)}
    (hρ : Function.LeftInverse ρ
      (LocalizedModule.map (Submonoid.powers f)
        (singleton_family_linearMap (R := R) (M := M) s0))) :
    Function.LeftInverse
      (LocalizedModule.map qAway.asIdeal.primeCompl ρ)
      (LocalizedModule.map qAway.asIdeal.primeCompl
        (LocalizedModule.map (Submonoid.powers f)
          (singleton_family_linearMap (R := R) (M := M) s0))) := by
  intro x
  induction x using LocalizedModule.induction_on with
  | _ y s =>
      -- Proof comment: on a localized generator, both maps just act on the numerator and keep the
      -- denominator, so the original split identity descends directly after localizing once more.
      rw [LocalizedModule.map_mk, LocalizedModule.map_mk, LocalizedModule.map_mk]
      simpa using congrArg (fun z ↦ LocalizedModule.mk z s) (hρ y)

/-- Helper for Theorem 15.128.5: localizing `Fin 1 ≃ R` at a maximal ideal identifies the
localized free rank-one source with `R_m`. -/
noncomputable def localized_funUnique_linearEquiv_at_maximal (m : MaximalSpectrum R) :
    LocalizedModule.AtPrime m.asIdeal (Fin 1 → R) ≃ₗ[Localization.AtPrime m.asIdeal]
      LocalizedModule.AtPrime m.asIdeal R :=
  LinearEquiv.extendScalarsOfIsLocalization m.asIdeal.primeCompl
    (Localization.AtPrime m.asIdeal) (LinearEquiv.funUnique (Fin 1) R R)

/-- Helper for Theorem 15.128.5: the localized `Fin 1 ≃ R` equivalence sends a denominator-`1`
generator to the corresponding localized scalar. -/
lemma localized_funUnique_linearEquiv_at_maximal_apply_mk
    (m : MaximalSpectrum R) (v : Fin 1 → R) :
    localized_funUnique_linearEquiv_at_maximal (R := R) m
        ((LocalizedModule.mkLinearMap m.asIdeal.primeCompl (Fin 1 → R)) v) =
      (LocalizedModule.mkLinearMap m.asIdeal.primeCompl R)
        ((LinearEquiv.funUnique (Fin 1) R R) v) := by
  -- Proof comment: `extendScalarsOfIsLocalization` evaluates on denominator-`1` generators by
  -- the original `R`-linear equivalence before localization.
  change (LinearEquiv.extendScalarsOfIsLocalization m.asIdeal.primeCompl
      (Localization.AtPrime m.asIdeal) (LinearEquiv.funUnique (Fin 1) R R))
      ((LocalizedModule.mkLinearMap m.asIdeal.primeCompl (Fin 1 → R)) v) = _
  rw [LinearEquiv.extendScalarsOfIsLocalization_apply]
  rfl

/-- Helper for Theorem 15.128.5: localizing the singleton family map at a maximal ideal and
evaluating it on a denominator-`1` generator agrees with first evaluating the underlying
singleton-section map and then localizing the result. -/
lemma localized_singleton_family_linearMap_apply_mk
    (m : MaximalSpectrum R) (s0 : M) (v : Fin 1 → R) :
    (LocalizedModule.map m.asIdeal.primeCompl
        (singleton_family_linearMap (R := R) (M := M) s0))
      ((LocalizedModule.mkLinearMap m.asIdeal.primeCompl (Fin 1 → R)) v) =
      (LocalizedModule.mkLinearMap m.asIdeal.primeCompl M)
        ((singleton_section_linearMap (R := R) (M := M) s0)
          ((LinearEquiv.funUnique (Fin 1) R R) v)) := by
  -- Proof comment: the unlocalized singleton family already factors through `Fin 1 ≃ R`, so the
  -- localized map agrees on numerator generators after applying the same factorization.
  rw [LocalizedModule.map_mk]
  have hbase :=
    LinearMap.congr_fun
      (singleton_family_linearMap_eq_singleton_section_linearMap_comp_funUnique
        (R := R) (M := M) s0)
      v
  simpa [LinearMap.comp_apply] using
    congrArg (fun z : M ↦ (LocalizedModule.mkLinearMap m.asIdeal.primeCompl M) z) hbase

/-- Helper for Theorem 15.128.5: after transporting the localized rank-one source through
`localized_funUnique_linearEquiv_at_maximal`, the localized singleton family map on a
denominator-`1` generator becomes the localized singleton section map. -/
lemma localized_singleton_family_linearMap_apply_mk_eq_map_apply_localized_funUnique
    (m : MaximalSpectrum R) (s0 : M) (v : Fin 1 → R) :
    (LocalizedModule.map m.asIdeal.primeCompl
        (singleton_family_linearMap (R := R) (M := M) s0))
      ((LocalizedModule.mkLinearMap m.asIdeal.primeCompl (Fin 1 → R)) v) =
      (LocalizedModule.map m.asIdeal.primeCompl
          (singleton_section_linearMap (R := R) (M := M) s0))
        (localized_funUnique_linearEquiv_at_maximal (R := R) m
          ((LocalizedModule.mkLinearMap m.asIdeal.primeCompl (Fin 1 → R)) v)) := by
  -- Proof comment: rewrite the transported source generator using
  -- `localized_funUnique_linearEquiv_at_maximal_apply_mk`, then reduce to the previous
  -- numerator-level comparison.
  rw [localized_funUnique_linearEquiv_at_maximal_apply_mk, LocalizedModule.map_mk]
  exact localized_singleton_family_linearMap_apply_mk (R := R) (M := M) m s0 v

