/-- Helper for Theorem 15.128.5: once the singleton rank-one map is universally injective, the
standard quotient short exact sequence splits and yields a global retraction. -/
lemma exists_retraction_of_universallyInjective_singleton_map
    (s0 : M)
    (hs :
      LinearMap.UniversallyInjective
        (singleton_section_linearMap (R := R) (M := M) s0)) :
    ∃ ρ : M →ₗ[R] R,
      ρ.comp (singleton_section_linearMap (R := R) (M := M) s0) = LinearMap.id := by
  let s : R →ₗ[R] M := singleton_section_linearMap (R := R) (M := M) s0
  have hs_injective : Function.Injective s := by
    have hquot :
        Function.Injective (LinearMap.quotientMapByIdeal s (⊥ : Ideal R)) :=
      (LinearMap.universallyInjective_iff_injective_mod_finite_ideal s).1 hs ⊥
        (by simpa using (Submodule.fg_bot : (⊥ : Ideal R).FG))
    intro x y hxy
    have hxyQ :
        (((⊥ : Ideal R) • (⊤ : Submodule R R)).mkQ x) =
          (((⊥ : Ideal R) • (⊤ : Submodule R R)).mkQ y) := by
      apply hquot
      simp [LinearMap.quotientMapByIdeal, hxy]
    have hmem : x - y ∈ ((⊥ : Ideal R) • (⊤ : Submodule R R) : Submodule R R) :=
      (Submodule.Quotient.eq (((⊥ : Ideal R) • (⊤ : Submodule R R) : Submodule R R))).mp hxyQ
    simpa [sub_eq_zero] using hmem
  have hfiniteRange : Module.Finite R s.range := by
    letI : Module.Finite R R := inferInstance
    exact Module.Finite.of_surjective s.rangeRestrict s.surjective_rangeRestrict
  have hfgRangeTop : (⊤ : Submodule R s.range).FG := Module.Finite.fg_top
  have hfgRange : s.range.FG := (Submodule.fg_top s.range).mp hfgRangeTop
  have hfinitePresentationQuot :
      Module.FinitePresentation R (M ⧸ s.range) := by
    exact Module.finitePresentation_of_surjective s.range.mkQ s.range.mkQ_surjective <| by
      simpa [Submodule.ker_mkQ] using hfgRange
  let S : ShortComplex (ModuleCat.{max u v} R) :=
    ShortComplex.mk (ModuleCat.ofHom s) (ModuleCat.ofHom s.range.mkQ) <| by
      ext x
      simp
  have hShortExact : S.ShortExact := by
    -- The quotient row is exact, `s` is injective, and the quotient map is surjective.
    exact ModuleCat.shortComplex_shortExact S
      (by simpa [S] using LinearMap.exact_map_mkQ_range s)
      hs_injective
      (Submodule.mkQ_surjective _)
  letI : Module.FinitePresentation R S.X₃ := by
    change Module.FinitePresentation R (M ⧸ s.range)
    exact hfinitePresentationQuot
  have hUniversallyExact : S.UniversallyExact := by
    -- Package the short exact quotient row together with the universal injectivity hypothesis.
    refine ⟨hShortExact, ?_⟩
    simpa [S, s] using hs
  obtain ⟨spl⟩ :=
    (CategoryTheory.ShortComplex.universallyExact_iff_split_of_finitePresentation_X₃
      (S := S)).1 hUniversallyExact
  refine ⟨spl.r.hom, ?_⟩
  -- The splitting retraction of the left map is exactly the desired linear retraction of `s`.
  simpa [S, s] using congrArg ModuleCat.Hom.hom spl.f_r

/-- Helper for Theorem 15.128.5: if a single section splits after inverting at every closed point,
then it yields a global split inclusion of `R` into `M`. -/
lemma exists_split_inclusion_of_section_of_selectedSectionsSplitAfterInverting
    (s0 : M)
    (hlocal : ∀ x : Ω, selectedSectionsSplitAfterInverting x (fun _ : Fin 1 => s0)) :
    ∃ (s : R →ₗ[R] M) (ρ : M →ₗ[R] R), ρ.comp s = LinearMap.id := by
  let s : R →ₗ[R] M := singleton_section_linearMap (R := R) (M := M) s0
  have hs :
      LinearMap.UniversallyInjective s :=
    universallyInjective_singleton_map_of_selectedSectionsSplitAfterInverting
      (R := R) (M := M) s0 hlocal
  obtain ⟨ρ, hρ⟩ :=
    exists_retraction_of_universallyInjective_singleton_map
      (R := R) (M := M) s0 hs
  exact ⟨s, ρ, hρ⟩

-- Proof sketch: this is the chapter's canonical reformulation of the source local-splitting
-- hypothesis via Lemma `15.128.2`, so the input is stated directly as `d < finrank V(x)`. Apply
-- Proposition `15.128.4` with `h = 0`, `k = d + 1`, no prescribed values, and empty bad locus to
-- obtain a section `s : M` whose dependence locus is contained in a closed subset all of whose
-- irreducible components have codimension at least `d + 1`. Since `topologicalKrullDim Ω ≤ d`,
-- that closed subset is empty, so `s` is fibrewise visible at every closed point. The resulting map
-- `R → M` is therefore split after localizing at every closed point, hence universally injective,
-- and the algebra lemmas cited in the text upgrade it to a split inclusion.
/-- Theorem 15.128.5: let `Ω` be the closed-point space of `Spec R`. If `Ω` is a Noetherian
topological space of dimension at most `d`, `M` is finitely presented, and equivalently to the source
local-splitting hypothesis every visible quotient `V(x)` has dimension `> d`, then there exists a
split `R`-linear inclusion `R → M`; equivalently, `M ≅ R ⊕ M'` for some `R`-module `M'`. -/
@[stacks 0GVC]
theorem exists_split_inclusion_of_visibleQuotient_finrank_gt_dimension
    {d : ℕ} [NoetherianSpace Ω] (hdim : topologicalKrullDim Ω ≤ d)
    (hV : ∀ x : Ω, d < Module.finrank (κ(x)) (V(x))) :
    ∃ (s : R →ₗ[R] M) (ρ : M →ₗ[R] R), ρ.comp s = LinearMap.id := by
  -- Apply Proposition `15.128.4` with empty initial data to build the singleton section.
  obtain ⟨s0, F', hF'closed, -, hdep, hcodim⟩ :=
    exists_section_with_prescribed_values_and_codim_controlled_dependence_locus
      (R := R) (M := M) (h := 0) (n := 0) (k := d + 1)
      (sections := fun i : Fin 0 => nomatch i) (F := (∅ : Set Ω)) isClosed_empty
      (by
        intro x hx
        exact False.elim hx)
      (pts := fun i : Fin 0 => nomatch i)
      (by
        intro i j hij
        exact Fin.elim0 i)
      (by
        intro i
        exact Fin.elim0 i)
      (v := fun i => nomatch i)
      (by
        intro x
        simpa using Nat.succ_le_of_lt (hV x))
  have hF'empty :
      F' = ∅ :=
    eq_empty_of_irreducible_components_codim_succ_gt_topologicalKrullDim
      (R := R) (M := M) hF'closed hcodim hdim
  have hlocal :
      ∀ x : Ω, selectedSectionsSplitAfterInverting x (fun _ : Fin 1 => s0) := by
    intro x
    have hxnot :
        x ∉ section_dependence_locus
          (Fin.snoc (fun i : Fin 0 => nomatch i) s0) := by
      intro hx
      have hxF' : x ∈ F' := by
        rcases hdep hx with hxempty | hxF'
        · exact False.elim hxempty
        · exact hxF'
      simpa [hF'empty] using hxF'
    -- The bad locus is empty, so the singleton visible class is independent at every closed point.
    exact
      singleton_selectedSectionsSplitAfterInverting_of_not_mem_dependence_locus
        (R := R) (M := M) x hxnot
  -- The remaining algebraic step upgrades the local singleton splittings to a global split
  -- summand.
  exact
    exists_split_inclusion_of_section_of_selectedSectionsSplitAfterInverting
      (R := R) (M := M) s0 hlocal

