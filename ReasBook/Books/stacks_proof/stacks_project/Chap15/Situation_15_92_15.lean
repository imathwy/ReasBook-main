- `bridge/view`: the finite-family powered presentation built from the tuple `f : Fin r → A`. -/

/-- The diagonal linear map on `A^r` multiplying the `i`th basis vector by `f i`. -/
def koszulPowerStepLinearMap (f : Fin r → A) :
    (Fin r → A) →ₗ[A] (Fin r → A) :=
  LinearMap.pi fun i ↦ (f i) • LinearMap.proj i

-- Proof sketch: evaluate both sides on the `i`th standard basis vector; the diagonal map
-- contributes one extra factor of `f i`, turning `f i ^ (n + 1)` into `f i ^ (n + 2)`.
/-- The diagonal step map is compatible with the linear forms defining the successive Koszul
complexes on `(f_i^(n+2))` and `(f_i^(n+1))`. -/
theorem koszulPowerStepLinearMap_compatibility (f : Fin r → A) (n : ℕ) :
    (koszulLinearForm (fun i ↦ f i ^ (n + 1))).comp (koszulPowerStepLinearMap f) =
      koszulLinearForm (fun i ↦ f i ^ (n + 2)) := by
  -- Evaluate both linear forms coordinatewise; the diagonal step map contributes one extra
  -- factor `f i`, which turns `f i ^ (n + 1)` into `f i ^ (n + 2)`.
  ext x
  simp [koszulLinearForm, koszulPowerStepLinearMap, Module.piEquiv_apply_apply, pow_succ,
    mul_assoc, mul_left_comm, mul_comm]

/-- The adjacent transition map `K_{n+2} ⟶ K_{n+1}` in the tower of Koszul complexes on the
powers of the generators. -/
abbrev koszulPowerStep (f : Fin r → A) (n : ℕ) :
    K^•[n + 1](f) ⟶ K^•[n](f) :=
  KoszulComplex.map (koszulPowerStepLinearMap f)
    (koszulPowerStepLinearMap_compatibility f n)

/-- Situation 15.92.15: the Koszul complexes on the powers
`(f₁^(n+1), …, fᵣ^(n+1))` form the sequential inverse system
`\cdots \to K_3 \to K_2 \to K_1`. -/
@[stacks 0BKC]
abbrev koszulPowerInverseSystem (f : Fin r → A) :
    ℕᵒᵖ ⥤ ChainComplex (ModuleCat A) ℕ :=
  let X : ℕ → ChainComplex (ModuleCat A) ℕ := fun n ↦ K^•[n](f)
  let step : (n : ℕ) → X (n + 1) ⟶ X n := fun n ↦ koszulPowerStep f n
  Functor.ofOpSequence step

/-- The inverse system `(K_n^\bullet)_n` in `D(A)` obtained from the powered Koszul complexes by
the canonical extension-and-localization functor. -/
abbrev derivedCompletionKoszulPowersDerivedInverseSystem
    (f : Fin r → A) : ℕᵒᵖ ⥤ DMod :=
  koszulPowerInverseSystem f ⋙
    (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat A)) ⋙
      DerivedCategory.Q

/-- The ideal `(f₁^(n+1), …, fᵣ^(n+1))`, indexed so that stage `0` is `(f₁, …, fᵣ)`. -/
abbrev koszulPowerIdeal (f : Fin r → A) (n : ℕ) : Ideal A :=
  Ideal.span (Set.range fun i ↦ f i ^ (n + 1))

/-- The quotient module `A / (f₁^(n+1), …, fᵣ^(n+1))`, indexed so that stage `0` is the
textbook quotient for `K_1`. -/
abbrev koszulPowerQuotientStage (f : Fin r → A) (n : ℕ) : ModuleCat A :=
  ModuleCat.of A (A ⧸ koszulPowerIdeal f n)

-- Proof sketch: each generator `f i ^ (n + 2)` of the higher-power ideal is `f i` times the
-- generator `f i ^ (n + 1)` of the lower-power ideal, so the higher-power ideal is contained in
-- the lower-power ideal.
/-- The ideals generated by successive powers form a decreasing sequence. -/
theorem koszulPowerIdeal_succ_le (f : Fin r → A) (n : ℕ) :
    koszulPowerIdeal f (n + 1) ≤ koszulPowerIdeal f n := by
  -- Each generator `f i ^ (n + 2)` is `f i * f i ^ (n + 1)`, hence it already lies in the
  -- lower-power span.
  refine Ideal.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  simpa [pow_succ, mul_comm, mul_left_comm, mul_assoc, Nat.add_assoc] using
    (Ideal.mul_mem_left (koszulPowerIdeal f n) (f i) (Ideal.subset_span ⟨i, rfl⟩) :
      f i * f i ^ (n + 1) ∈ koszulPowerIdeal f n)

/-- The quotient transition map
`A / (f₁^(n+2), …, fᵣ^(n+2)) ⟶ A / (f₁^(n+1), …, fᵣ^(n+1))`. -/
abbrev koszulPowerQuotientStep (f : Fin r → A) (n : ℕ) :
    koszulPowerQuotientStage f (n + 1) ⟶ koszulPowerQuotientStage f n :=
  ModuleCat.ofHom ((Ideal.Quotient.factorₐ A (koszulPowerIdeal_succ_le f n)).toLinearMap)

/-- The quotient modules `A / (f₁^(n+1), …, fᵣ^(n+1))` form the sequential inverse system
`\cdots \to A/(f_i^3) \to A/(f_i^2) \to A/(f_i)`. -/
abbrev koszulPowerQuotientInverseSystem (f : Fin r → A) : ℕᵒᵖ ⥤ ModuleCat A :=
  Functor.ofOpSequence (koszulPowerQuotientStep f)

private abbrev koszulPowerAugmentationMap (f : Fin r → A) (n : ℕ) :
    ModuleCat.of A A ⟶ (K^•[n](f)).X 0 :=
  show ModuleCat.of A A ⟶ ModuleCat.of A (⋀[A]^0 (Fin r → A)) from
    (ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).inv

/-- The chain-map augmentation from the degree-zero complex on `A` to the `n`th Koszul stage. -/
abbrev koszulPowerAugmentation (f : Fin r → A) (n : ℕ) :
    (ChainComplex.single₀ (ModuleCat A)).obj (ModuleCat.of A A) ⟶ K^•[n](f) :=
  (ChainComplex.fromSingle₀Equiv (K^•[n](f)) (ModuleCat.of A A)).symm
    (koszulPowerAugmentationMap f n)

-- Proof sketch: both chain maps are determined by their degree-zero components, and the
-- transition map on degree `0` is induced by the identity on `⋀^0`, so it preserves the canonical
-- unit class defining the augmentation.
/-- The augmentations `A ⟶ K_n` and the transition maps in the Koszul tower form a commutative
square. -/
theorem koszulPowerAugmentation_naturality (f : Fin r → A) (n : ℕ) :
    CommSq
      (koszulPowerAugmentation f (n + 1))
      (𝟙 ((ChainComplex.single₀ (ModuleCat A)).obj (ModuleCat.of A A)))
      (koszulPowerStep f n)
      (koszulPowerAugmentation f n) := by
  refine CommSq.mk ?_
  -- Compare the two chain maps componentwise: degree `0` is the identity under `⋀⁰ ≅ A`, and
  -- maps out of `single₀` are already determined by degree `0`.
  apply (ChainComplex.fromSingle₀Equiv (K^•[n](f)) (ModuleCat.of A A)).injective
  change ((koszulPowerAugmentation f (n + 1) ≫ koszulPowerStep f n).f 0) =
    ((𝟙 ((ChainComplex.single₀ (ModuleCat A)).obj (ModuleCat.of A A)) ≫
      koszulPowerAugmentation f n).f 0)
  have hmap0 :
      ModuleCat.exteriorPower.map (ModuleCat.ofHom (koszulPowerStepLinearMap f)) 0 =
        𝟙 ((ModuleCat.of A (Fin r → A)).exteriorPower 0) := by
    apply (cancel_mono (ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom).1
    simpa using
      (ModuleCat.exteriorPower.iso₀_hom_naturality
        (f := ModuleCat.ofHom (koszulPowerStepLinearMap f)))
  simpa [koszulPowerAugmentationMap, koszulPowerStep, hmap0]

private abbrev koszulPowerZeroQuotientMap (f : Fin r → A) (n : ℕ) :
    (K^•[n](f)).X 0 ⟶ koszulPowerQuotientStage f n :=
  show ModuleCat.of A (⋀[A]^0 (Fin r → A)) ⟶
      ModuleCat.of A (A ⧸ koszulPowerIdeal f n) from
    (ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom ≫
      ModuleCat.ofHom ((Ideal.Quotient.mkₐ A (koszulPowerIdeal f n)).toLinearMap)

/-- Helper for Situation 15.92.15: the range of the tuple linear form is exactly the ideal
generated by the corresponding powered tuple. -/
private theorem range_koszulLinearForm_eq_powerIdeal (f : Fin r → A) (n : ℕ) :
    LinearMap.range (koszulLinearForm (fun i ↦ f i ^ (n + 1))) = koszulPowerIdeal f n := by
  -- This is the standard range computation for the finite linear-combination map.
  simpa [koszulPowerIdeal] using
    ((Module.range_piEquiv (Fin r) A A (fun i ↦ f i ^ (n + 1))).trans Ideal.submodule_span_eq)

/-- Helper for Situation 15.92.15: after identifying `⋀¹ (A^r)` with `A^r` and `⋀⁰ (A^r)` with
`A`, the first Koszul differential is the tuple linear form. -/
private theorem koszulPowerFirstDifferential_generator_eval
    (f : Fin r → A) (n : ℕ) (m : Fin 1 → Fin r → A) :
    (koszulDifferentialLinearMap
        (koszulLinearForm (fun i ↦ f i ^ (n + 1))) 0
        (exteriorPower.ιMulti A 1 m) :
      ExteriorAlgebra A (Fin r → A)) =
      algebraMap A (ExteriorAlgebra A (Fin r → A))
        ((koszulLinearForm (fun i ↦ f i ^ (n + 1))) (m 0)) := by
  -- Unfold the restricted differential back to ambient contraction.
  change
    CliffordAlgebra.contractLeft
        (koszulLinearForm (fun i ↦ f i ^ (n + 1)))
        (exteriorPower.ιMulti A 1 m) =
      algebraMap A (ExteriorAlgebra A (Fin r → A))
        ((koszulLinearForm (fun i ↦ f i ^ (n + 1))) (m 0))
  -- On a degree-one generator, contraction is evaluation of the defining linear form.
  simpa [koszulDifferentialLinearMap] using
    (CliffordAlgebra.contractLeft_ι
      (φ := koszulLinearForm (fun i ↦ f i ^ (n + 1))) (m := m 0))

/-- Helper for Situation 15.92.15: after identifying `⋀¹ (A^r)` with `A^r` and `⋀⁰ (A^r)` with
`A`, the first Koszul differential is the tuple linear form. -/
private theorem koszulPowerFirstDifferentialLinearMap_eq_linearForm
    (f : Fin r → A) (n : ℕ) :
    (exteriorPower.zeroEquiv A (Fin r → A)).toLinearMap.comp
        (koszulDifferentialLinearMap
          (koszulLinearForm (fun i ↦ f i ^ (n + 1))) 0) =
      (koszulLinearForm (fun i ↦ f i ^ (n + 1))).comp
        (exteriorPower.oneEquiv A (Fin r → A)).toLinearMap := by
  -- Route correction: isolate the generator calculation in the ambient exterior algebra first,
  -- then transport it through `⋀¹(A^r) ≃ A^r` and `⋀⁰(A^r) ≃ A`.
  apply exteriorPower.linearMap_ext
  ext m
  simp only [LinearMap.compAlternatingMap_apply, LinearMap.coe_comp, Function.comp_apply]
  have hone :
      (exteriorPower.oneEquiv A (Fin r → A)) (exteriorPower.ιMulti A 1 m) = m 0 := by
    simpa using (exteriorPower.oneEquiv_ιMulti (R := A) (M := Fin r → A) (f := m))
  have hone' :
      (koszulLinearForm (fun i ↦ f i ^ (n + 1)))
          ((exteriorPower.oneEquiv A (Fin r → A)) (exteriorPower.ιMulti A 1 m)) =
        (koszulLinearForm (fun i ↦ f i ^ (n + 1))) (m 0) := by
    simpa [hone]
  have hone'' :
      (koszulLinearForm (fun i ↦ f i ^ (n + 1)))
          ((exteriorPower.oneEquiv A (Fin r → A)).toLinearMap
            (exteriorPower.ιMulti A 1 m)) =
        (koszulLinearForm (fun i ↦ f i ^ (n + 1))) (m 0) := by
    simpa using hone'
  -- After rewriting the degree-one transport, the degree-zero transport is the scalar inclusion.
  rw [hone'']
  apply_fun (exteriorPower.zeroEquiv A (Fin r → A)).symm using
    (exteriorPower.zeroEquiv A (Fin r → A)).symm.injective
  simp [exteriorPower.zeroEquiv_symm_apply]
  apply Subtype.ext
  simpa [ExteriorAlgebra.ιMulti, Algebra.algebraMap_eq_smul_one] using
    koszulPowerFirstDifferential_generator_eval f n m

/-- Helper for Situation 15.92.15: after transporting degree `0` to `A`, the image of the first
Koszul differential is the ideal generated by `(f_i^(n+1))`. -/
private theorem koszulPowerFirstDifferential_range_eq_powerIdeal
    (f : Fin r → A) (n : ℕ) :
    LinearMap.range
        (((K^•[n](f)).d 1 0) ≫
          (ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom).hom =
      koszulPowerIdeal f n := by
  -- Transport the first differential to `A`, where it becomes the tuple linear form, and then
  -- use surjectivity of `⋀¹(A^r) ≃ A^r` to identify the image.
  change
    LinearMap.range
        ((exteriorPower.zeroEquiv A (Fin r → A)).toLinearMap.comp
          (koszulDifferentialLinearMap
            (koszulLinearForm (fun i ↦ f i ^ (n + 1))) 0)) =
      koszulPowerIdeal f n
  rw [koszulPowerFirstDifferentialLinearMap_eq_linearForm]
  have hrange :
      LinearMap.range
          ((koszulLinearForm (fun i ↦ f i ^ (n + 1))).comp
            (exteriorPower.oneEquiv A (Fin r → A)).toLinearMap) =
        LinearMap.range (koszulLinearForm (fun i ↦ f i ^ (n + 1))) := by
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨(exteriorPower.oneEquiv A (Fin r → A)) y, rfl⟩
    · rintro ⟨y, rfl⟩
      exact ⟨(exteriorPower.oneEquiv A (Fin r → A)).symm y, by simp⟩
  rw [hrange]
  exact range_koszulLinearForm_eq_powerIdeal f n

/-- Helper for Situation 15.92.15: the degree-zero quotient maps commute with the adjacent
transition maps in the powered Koszul and quotient towers. -/
private theorem koszulPowerZeroQuotientMap_naturality (f : Fin r → A) (n : ℕ) :
    (koszulPowerStep f n).f 0 ≫ koszulPowerZeroQuotientMap f n =
      koszulPowerZeroQuotientMap f (n + 1) ≫ koszulPowerQuotientStep f n := by
  -- In degree `0`, the Koszul transition is the identity under `⋀⁰ ≃ A`, so both composites are
  -- the canonical quotient map followed by the quotient transition.
  change
    ModuleCat.exteriorPower.map (ModuleCat.ofHom (koszulPowerStepLinearMap f)) 0 ≫
        (ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom ≫
          ModuleCat.ofHom ((Ideal.Quotient.mkₐ A (koszulPowerIdeal f n)).toLinearMap) =
      ((ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom ≫
          ModuleCat.ofHom ((Ideal.Quotient.mkₐ A (koszulPowerIdeal f (n + 1))).toLinearMap)) ≫
        ModuleCat.ofHom ((Ideal.Quotient.factorₐ A (koszulPowerIdeal_succ_le f n)).toLinearMap)
  rw [← Category.assoc]
  rw [ModuleCat.exteriorPower.iso₀_hom_naturality
      (f := ModuleCat.ofHom (koszulPowerStepLinearMap f))]
  ext x
  rfl

-- Proof sketch: the first Koszul differential has image equal to the ideal generated by the
-- family `(f_i^(n+1))`, so the quotient map kills this image.
private theorem koszulPowerFirstDifferential_comp_zeroQuotientMap (f : Fin r → A) (n : ℕ) :
    (K^•[n](f)).d 1 0 ≫ koszulPowerZeroQuotientMap f n = 0 := by
  -- The transported image of the first differential is the powered ideal, so the quotient map
  -- annihilates every value of the differential.
  ext x
  have hxmem :
      ((((K^•[n](f)).d 1 0) ≫
          (ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom).hom) x ∈
        koszulPowerIdeal f n := by
    rw [← koszulPowerFirstDifferential_range_eq_powerIdeal f n]
    exact ⟨x, rfl⟩
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hxmem

private abbrev koszulPowerZeroOpcyclesToQuotient (f : Fin r → A) (n : ℕ) :
    (K^•[n](f)).opcycles 0 ⟶ koszulPowerQuotientStage f n :=
  (K^•[n](f)).descOpcycles
    (koszulPowerZeroQuotientMap f n) 1
    (by simp)
    (koszulPowerFirstDifferential_comp_zeroQuotientMap f n)

/-- Helper for Situation 15.92.15: the degree-zero quotient square descends along `pOpcycles` to
the induced square on zeroth opcycles. -/
private theorem koszulPowerZeroOpcyclesToQuotient_naturality (f : Fin r → A) (n : ℕ) :
    (K^•[n + 1](f)).opcyclesMap (koszulPowerStep f n) 0 ≫
        koszulPowerZeroOpcyclesToQuotient f n =
      koszulPowerZeroOpcyclesToQuotient f (n + 1) ≫
        koszulPowerQuotientStep f n := by
  -- Compare both morphisms after composing with the opcycles projection.
  apply (cancel_epi ((K^•[n + 1](f)).pOpcycles 0)).1
  -- The resulting degree-zero square is exactly the previously established quotient square.
  calc
    (K^•[n + 1](f)).pOpcycles 0 ≫
        (K^•[n + 1](f)).opcyclesMap (koszulPowerStep f n) 0 ≫
        koszulPowerZeroOpcyclesToQuotient f n =
      (koszulPowerStep f n).f 0 ≫ koszulPowerZeroQuotientMap f n := by
        simp only [koszulPowerZeroOpcyclesToQuotient,
          HomologicalComplex.p_opcyclesMap_assoc]
        rw [HomologicalComplex.p_descOpcycles]
    _ =
      koszulPowerZeroQuotientMap f (n + 1) ≫ koszulPowerQuotientStep f n :=
      koszulPowerZeroQuotientMap_naturality f n
    _ =
      (K^•[n + 1](f)).pOpcycles 0 ≫
        koszulPowerZeroOpcyclesToQuotient f (n + 1) ≫
        koszulPowerQuotientStep f n := by
        simpa [koszulPowerZeroOpcyclesToQuotient, Category.assoc] using
          (congrArg (fun t ↦ t ≫ koszulPowerQuotientStep f n)
            (HomologicalComplex.p_descOpcycles
              (K := K^•[n + 1](f))
              (k := koszulPowerZeroQuotientMap f (n + 1))
              (j := 1)
              (hj := by simp)
              (hk := koszulPowerFirstDifferential_comp_zeroQuotientMap f (n + 1)))).symm

/-- Helper for Situation 15.92.15: the degree `1 → 0 → A/(f_i^(n+1))` short complex is exact,
because the kernel of the quotient map is the image of the first Koszul differential. -/
private theorem koszulPowerFirstShortComplex_exact (f : Fin r → A) (n : ℕ) :
    (ShortComplex.mk
      ((K^•[n](f)).d 1 0)
      (koszulPowerZeroQuotientMap f n)
      (koszulPowerFirstDifferential_comp_zeroQuotientMap f n)).Exact := by
  -- Compare the kernel of the quotient map with the image of the first differential after
  -- transporting degree `0` along `⋀⁰(A^r) ≃ A`.
  rw [ShortComplex.moduleCat_exact_iff_range_eq_ker]
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    have hyzero :=
      congrArg (fun k ↦ k.hom y) (koszulPowerFirstDifferential_comp_zeroQuotientMap f n)
    simpa using hyzero
  · intro hx
    have hxmem :
        (ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom.hom x ∈
          koszulPowerIdeal f n := by
      exact Ideal.Quotient.eq_zero_iff_mem.mp <| by
        simpa [koszulPowerZeroQuotientMap] using hx
    rw [← koszulPowerFirstDifferential_range_eq_powerIdeal f n] at hxmem
    rcases hxmem with ⟨y, hy⟩
    refine ⟨y, ?_⟩
    have hinj :
        Function.Injective (ModuleCat.Hom.hom
          (ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom) :=
      (ModuleCat.mono_iff_injective _).1 inferInstance
    apply hinj
    simpa [LinearMap.comp_apply] using hy

/-- Helper for Situation 15.92.15: the opcycles comparison map identifies degree-zero opcycles
with the quotient by the powered ideal. -/
private theorem koszulPowerZeroOpcyclesToQuotient_isIso (f : Fin r → A) (n : ℕ) :
    IsIso (koszulPowerZeroOpcyclesToQuotient f n) := by
  -- Route correction: use the exact degree `1 → 0 → quotient` short complex rather than trying
  -- to unfold opcycles directly.
  have hEpi : Epi (koszulPowerZeroQuotientMap f n) := by
    rw [ModuleCat.epi_iff_surjective]
    intro x
    rcases Ideal.Quotient.mkₐ_surjective A (koszulPowerIdeal f n) x with ⟨y, rfl⟩
    refine ⟨(ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).inv y, ?_⟩
    change
      (Ideal.Quotient.mkₐ A (koszulPowerIdeal f n))
        ((ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).hom.hom
          ((ModuleCat.exteriorPower.iso₀ (ModuleCat.of A (Fin r → A))).inv y)) =
        (Ideal.Quotient.mkₐ A (koszulPowerIdeal f n)) y
    simp
  let _ : Epi (koszulPowerZeroQuotientMap f n) := hEpi
  rw [ChainComplex.isIso_descOpcycles_iff]
  exact ⟨koszulPowerFirstShortComplex_exact f n, by infer_instance⟩

/-- The canonical comparison map from the zeroth homology of the powered Koszul complex to the
quotient `A / (f₁^(n+1), …, fᵣ^(n+1))`. -/
abbrev koszulPowerZeroHomologyToQuotient (f : Fin r → A) (n : ℕ) :
    (K^•[n](f)).homology 0 ⟶ koszulPowerQuotientStage f n :=
  (ChainComplex.isoHomologyι₀ (K^•[n](f))).hom ≫
    koszulPowerZeroOpcyclesToQuotient f n

-- Proof sketch: `H_0` is canonically isomorphic to the cokernel of the first differential, and
-- the previous quotient map exhibits the same cokernel, so the comparison morphism is an
-- isomorphism.
/-- The canonical comparison map from zeroth homology to the quotient by the powered ideal is an
isomorphism. -/
theorem koszulPowerZeroHomologyToQuotient_isIso (f : Fin r → A) (n : ℕ) :
    IsIso (koszulPowerZeroHomologyToQuotient f n) := by
  -- The homology comparison is the composite of the standard `H₀ ≅ opcycles₀` isomorphism with
  -- the explicit opcycles-to-quotient isomorphism.
  let _ := koszulPowerZeroOpcyclesToQuotient_isIso f n
  infer_instance

-- Proof sketch: identify the induced map on `H_0` with the map on cokernels coming from the
-- commutative square of first differentials; under the quotient description of `H_0`, this is
-- exactly the canonical quotient transition map.
/-- The canonical zeroth-homology comparison maps are natural with respect to the transition maps
in the Koszul tower and in the quotient tower. -/
theorem koszulPowerZeroHomologyToQuotient_naturality (f : Fin r → A) (n : ℕ) :
    CommSq
      (HomologicalComplex.homologyMap (koszulPowerStep f n) 0)
      (koszulPowerZeroHomologyToQuotient f (n + 1))
      (koszulPowerZeroHomologyToQuotient f n)
      (koszulPowerQuotientStep f n) := by
  refine CommSq.mk ?_
  -- Route correction: first rewrite the homology map through `isoHomologyι₀`, then use the
  -- already-descended opcycles square.
  have hhom :
      HomologicalComplex.homologyMap (koszulPowerStep f n) 0 ≫
          HomologicalComplex.homologyι (K^•[n](f)) 0 =
        HomologicalComplex.homologyι (K^•[n + 1](f)) 0 ≫
          HomologicalComplex.opcyclesMap (koszulPowerStep f n) 0 := by
    have hnat :
        (ChainComplex.isoHomologyι₀ (K^•[n + 1](f))).inv ≫
            HomologicalComplex.homologyMap (koszulPowerStep f n) 0 =
          HomologicalComplex.opcyclesMap (koszulPowerStep f n) 0 ≫
            (ChainComplex.isoHomologyι₀ (K^•[n](f))).inv := by
      simpa using
        (ChainComplex.isoHomologyι₀_inv_naturality
          (K := K^•[n + 1](f)) (L := K^•[n](f)) (φ := koszulPowerStep f n))
    -- Cancel the homology/opcycles identifications on both sides.
    have :=
      congrArg
        (fun k ↦
          HomologicalComplex.homologyι (K^•[n + 1](f)) 0 ≫
            k ≫ HomologicalComplex.homologyι (K^•[n](f)) 0)
        hnat
    simpa [ChainComplex.isoHomologyι₀, Category.assoc] using this
  -- Expand only the comparison maps and substitute the homology-to-opcycles transport.
  dsimp [koszulPowerZeroHomologyToQuotient]
  calc
    HomologicalComplex.homologyMap (koszulPowerStep f n) 0 ≫
        HomologicalComplex.homologyι (K^•[n](f)) 0 ≫
        koszulPowerZeroOpcyclesToQuotient f n =
      HomologicalComplex.homologyι (K^•[n + 1](f)) 0 ≫
        HomologicalComplex.opcyclesMap (koszulPowerStep f n) 0 ≫
        koszulPowerZeroOpcyclesToQuotient f n := by
          simpa [Category.assoc] using
            congrArg (fun t ↦ t ≫ koszulPowerZeroOpcyclesToQuotient f n) hhom
    _ =
      HomologicalComplex.homologyι (K^•[n + 1](f)) 0 ≫
        (koszulPowerZeroOpcyclesToQuotient f (n + 1) ≫ koszulPowerQuotientStep f n) := by
          simpa [Category.assoc] using
            congrArg
              (fun t ↦ HomologicalComplex.homologyι (K^•[n + 1](f)) 0 ≫ t)
              (koszulPowerZeroOpcyclesToQuotient_naturality f n)
    _ =
      HomologicalComplex.homologyι (K^•[n + 1](f)) 0 ≫
        koszulPowerZeroOpcyclesToQuotient f (n + 1) ≫
        koszulPowerQuotientStep f n := by
          simp

end
