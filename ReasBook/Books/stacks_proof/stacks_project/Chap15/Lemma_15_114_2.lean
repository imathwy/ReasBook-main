local notation "K" => FractionRing A

/-- Helper for Lemma 15.114.2: a finite separable extension of `Khat` is generated by one
element. -/
lemma exists_completion_primitive_generator :
    ∃ θ : M, IntermediateField.adjoin Khat ({θ} : Set M) = ⊤ := by
  -- The primitive-element theorem applies directly to the finite separable extension `M / Khat`.
  simpa using Field.exists_primitive_element Khat M

/-- Helper for Lemma 15.114.2: once the primitive subfield is all of `M`, the canonical inclusion
into `⊤` upgrades to a `Khat`-algebra equivalence with `M`. -/
lemma primitive_generator_top_equiv {θ : M}
    (hθ : IntermediateField.adjoin Khat ({θ} : Set M) = ⊤) :
    Nonempty (↥(IntermediateField.adjoin Khat ({θ} : Set M)) ≃ₐ[Khat] M) := by
  let S : IntermediateField Khat M := IntermediateField.adjoin Khat ({θ} : Set M)
  -- First compare the simple subfield with the top intermediate field by the obvious inclusion.
  have hle : S ≤ (⊤ : IntermediateField Khat M) := by
    intro x hx
    exact IntermediateField.mem_top
  have hbij : Function.Bijective (IntermediateField.inclusion hle) := by
    refine ⟨?_, ?_⟩
    · -- Injectivity is inherited from the underlying subtype inclusion into `M`.
      intro x y hxy
      ext
      exact congrArg (fun z : ↥(⊤ : IntermediateField Khat M) => (z : M)) hxy
    · -- Surjectivity uses the hypothesis that the primitive field already equals `⊤`.
      intro x
      refine ⟨⟨x.1, ?_⟩, ?_⟩
      · have hxTop : x.1 ∈ (⊤ : IntermediateField Khat M) := x.2
        simp [S, hθ] at hxTop ⊢
      · ext
        rfl
  -- Compose the inclusion equivalence with the canonical identification `⊤ ≃ₐ[Khat] M`.
  refine ⟨(AlgEquiv.ofBijective (IntermediateField.inclusion hle) hbij).trans
    IntermediateField.topEquiv⟩

/-- Helper for Lemma 15.114.2: a primitive generator realizes `M` as the adjoin-root algebra of
its minimal polynomial over `Khat`. -/
lemma primitive_generator_adjoinRoot_model {θ : M}
    (hθ : IntermediateField.adjoin Khat ({θ} : Set M) = ⊤) :
    Nonempty (AdjoinRoot (minpoly Khat θ) ≃ₐ[Khat] M) := by
  -- First identify `M` with the simple intermediate field generated by `θ`.
  obtain ⟨eTop⟩ := primitive_generator_top_equiv (Khat := Khat) (M := M) hθ
  -- Then use the standard `AdjoinRoot` model for a simple algebraic extension.
  refine ⟨(IntermediateField.adjoinRootEquivAdjoin Khat
    (Algebra.IsSeparable.isIntegral Khat θ)).trans eTop⟩

/-- Helper for Lemma 15.114.2: a descended polynomial over `K` whose mapped root still generates
`M / Khat` is automatically separable. -/
lemma descended_polynomial_separable
    (Q : Polynomial K) (β : M)
    (hQ_monic : Q.Monic)
    (hQ_eval : Polynomial.aeval β (Q.map (algebraMap K Khat)) = 0)
    (hβ : IntermediateField.adjoin Khat ({β} : Set M) = ⊤)
    (hdeg : Q.natDegree = Module.finrank Khat M) :
    Q.Separable := by
  let _ : Algebra.IsAlgebraic Khat M := Algebra.IsAlgebraic.of_finite Khat M
  let _ : Algebra.IsIntegral Khat M := Algebra.IsAlgebraic.isIntegral
  -- The primitive-generator hypothesis turns the minimal polynomial degree of `β` into the full
  -- extension degree over `Khat`.
  have hβ_integral : IsIntegral Khat β := Algebra.IsIntegral.isIntegral β
  have hfinrank_adjoin :
      Module.finrank Khat ↥(IntermediateField.adjoin Khat ({β} : Set M)) =
        (minpoly Khat β).natDegree :=
    IntermediateField.adjoin.finrank hβ_integral
  have hminpoly_degree : (minpoly Khat β).natDegree = Module.finrank Khat M := by
    let e : ↥(IntermediateField.adjoin Khat ({β} : Set M)) ≃ₐ[Khat] M :=
      (IntermediateField.equivOfEq hβ).trans IntermediateField.topEquiv
    -- Compare the simple-extension degree with the ambient finite extension via the canonical
    -- algebra equivalence induced by `hβ`.
    calc
      (minpoly Khat β).natDegree =
          Module.finrank Khat ↥(IntermediateField.adjoin Khat ({β} : Set M)) := by
            symm
            exact hfinrank_adjoin
      _ = Module.finrank Khat M := by
            exact e.toLinearEquiv.finrank_eq
  have hminpoly_dvd : minpoly Khat β ∣ Q.map (algebraMap K Khat) :=
    minpoly.dvd Khat β hQ_eval
  have hmap_degree : (Q.map (algebraMap K Khat)).natDegree = (minpoly Khat β).natDegree := by
    -- The descended polynomial has the same degree as the minimal polynomial, so monic divisibility
    -- forces equality after base change.
    calc
      (Q.map (algebraMap K Khat)).natDegree = Q.natDegree := by
        exact hQ_monic.natDegree_map (algebraMap K Khat)
      _ = Module.finrank Khat M := hdeg
      _ = (minpoly Khat β).natDegree := by
        symm
        exact hminpoly_degree
  have hmap_le : (Q.map (algebraMap K Khat)).natDegree ≤ (minpoly Khat β).natDegree := by
    simp [hmap_degree]
  have hmap_eq_minpoly : Q.map (algebraMap K Khat) = minpoly Khat β := by
    exact Polynomial.eq_of_monic_of_dvd_of_natDegree_le
      (minpoly.monic hβ_integral)
      (hQ_monic.map (algebraMap K Khat))
      hminpoly_dvd
      hmap_le
  have hβ_sep : IsSeparable Khat β := by
    -- Separability of the ambient extension specializes to separability of the chosen generator.
    have hsepM : ∀ x : M, IsIntegral Khat x ∧ IsSeparable Khat x :=
      Algebra.isSeparable_iff.mp inferInstance
    exact (hsepM β).2
  have hmap_sep : (Q.map (algebraMap K Khat)).Separable := by
    simpa [IsSeparable, hmap_eq_minpoly] using hβ_sep
  -- Reflect separability back along the injective base-field map `K → Khat`.
  exact (Polynomial.separable_map (algebraMap K Khat)).mp hmap_sep

/-- Helper for Lemma 15.114.2: once a descended polynomial `Q` and root `β` are available, the
simple extension `K(β)` is already finite and separable over `K`. -/
lemma descended_simple_extension_finite_separable
    [Algebra K M] [IsScalarTower K Khat M]
    (Q : Polynomial K) (β : M)
    (hQ_monic : Q.Monic)
    (hQ_eval : Polynomial.aeval β (Q.map (algebraMap K Khat)) = 0)
    (hβ : IntermediateField.adjoin Khat ({β} : Set M) = ⊤)
    (hdeg : Q.natDegree = Module.finrank Khat M) :
    FiniteDimensional K ↥(IntermediateField.adjoin K ({β} : Set M)) ∧
      Algebra.IsSeparable K ↥(IntermediateField.adjoin K ({β} : Set M)) := by
  -- Transport the mapped root equation back to a polynomial over `K`.
  have hβ_eval_K : Polynomial.aeval β Q = 0 := by
    simpa [Polynomial.aeval_map_algebraMap (A := Khat) (B := M) β Q] using hQ_eval
  have hβ_integral_K : IsIntegral K β := ⟨Q, hQ_monic, hβ_eval_K⟩
  constructor
  · -- A simple algebraic extension is finite-dimensional.
    exact IntermediateField.adjoin.finiteDimensional hβ_integral_K
  · -- Separability of the descended polynomial transfers to the minimal polynomial of `β`.
    have hQ_sep : Q.Separable :=
      descended_polynomial_separable (Khat := Khat) (M := M) Q β hQ_monic hQ_eval hβ hdeg
    have hβ_sep_K : IsSeparable K β := by
      simpa [IsSeparable] using
        (Polynomial.Separable.of_dvd hQ_sep (minpoly.dvd K β hβ_eval_K))
    exact (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K M).2 hβ_sep_K

/-- Helper for Lemma 15.114.2: the remaining structural step is to descend the primitive
generator through the completion approximation argument and then prove that the canonical tensor
map from `Khat ⊗[K] K(β)` to `M` is bijective. -/
lemma tensor_simple_extension_to_completion_surjective
    [Algebra K M] [IsScalarTower K Khat M]
    (β : M)
    (hβ : IntermediateField.adjoin Khat ({β} : Set M) = ⊤) :
    Function.Surjective
      (Algebra.TensorProduct.lift
        (Algebra.ofId Khat M)
        (IntermediateField.adjoin K ({β} : Set M)).val
        (fun x y ↦ by
          change Commute ((algebraMap Khat M) x) ((IntermediateField.adjoin K ({β} : Set M)).val y)
          exact Algebra.commutes _ _)) := by
  let L : IntermediateField K M := IntermediateField.adjoin K ({β} : Set M)
  let φ : Khat ⊗[K] L →ₐ[Khat] M :=
    Algebra.TensorProduct.lift
      (Algebra.ofId Khat M)
      L.val
      (fun x y ↦ by
        change Commute ((algebraMap Khat M) x) (L.val y)
        exact Algebra.commutes _ _)
  let _ : Algebra.IsAlgebraic Khat M := Algebra.IsAlgebraic.of_finite Khat M
  have hβ_alg : IsAlgebraic Khat β := Algebra.IsAlgebraic.isAlgebraic β
  have hβ_simple : Khat⟮β⟯ = ⊤ := by
    simpa using hβ
  let βL : L := ⟨β, IntermediateField.mem_adjoin_simple_self K β⟩
  have hβ_mem_range : β ∈ φ.range := by
    -- The tensor generator `1 ⊗ β` maps to `β`.
    refine ⟨1 ⊗ₜ[K] βL, ?_⟩
    change φ (1 ⊗ₜ[K] βL) = β
    rw [Algebra.TensorProduct.lift_tmul]
    change (algebraMap Khat M 1) * ((βL : L) : M) = β
    simp [βL]
  have hscalar_adjoin_le_range : Algebra.adjoin Khat ({β} : Set M) ≤ φ.range := by
    -- The range is a `Khat`-subalgebra containing `β`, hence it contains the whole scalar adjoin.
    refine Algebra.adjoin_le ?_
    intro x hx
    simp only [Set.mem_singleton_iff] at hx
    simpa [hx] using hβ_mem_range
  have hscalar_adjoin_top : Algebra.adjoin Khat ({β} : Set M) = ⊤ := by
    -- Convert the simple intermediate-field generator statement into the matching subalgebra one.
    have htop_subalgebra : (Khat⟮β⟯ : IntermediateField Khat M).toSubalgebra = ⊤ := by
      simpa using congrArg IntermediateField.toSubalgebra hβ_simple
    rwa [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hβ_alg] at htop_subalgebra
  have hrange_top : φ.range = ⊤ := by
    -- Once the scalar adjoin is top, the range must already be the whole field.
    refine top_unique ?_
    rw [← hscalar_adjoin_top]
    exact hscalar_adjoin_le_range
  exact (AlgHom.range_eq_top φ).mp hrange_top

