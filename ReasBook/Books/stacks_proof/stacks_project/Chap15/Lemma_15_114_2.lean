/-- Helper for Lemma 15.114.2: once the source-faithful descended generator data are available,
the canonical tensor map yields the desired base-change equivalence. -/
lemma completion_baseChange_equiv_of_descended_generator :
    ∃ (L : Type u) (_ : Field L) (_ : Algebra K L) (_ : FiniteDimensional K L)
      (_ : Algebra.IsSeparable K L), Nonempty ((Khat ⊗[K] L) ≃ₐ[Khat] M) := by
  let _ : Algebra K M := ((algebraMap Khat M).comp (algebraMap K Khat)).toAlgebra
  let _ : IsScalarTower K Khat M := IsScalarTower.of_algebraMap_eq' rfl
  -- First isolate the descended root data promised by the source-faithful local argument.
  obtain ⟨Q, β, hQ_monic, hQ_eval, hβ, hdeg⟩ :=
    completion_descended_generator_data (A := A) (Khat := Khat) (M := M)
  have hfinite_sep :
      FiniteDimensional K ↥(IntermediateField.adjoin K ({β} : Set M)) ∧
        Algebra.IsSeparable K ↥(IntermediateField.adjoin K ({β} : Set M)) :=
    descended_simple_extension_finite_separable
      (Khat := Khat) (M := M) Q β hQ_monic hQ_eval hβ hdeg
  -- Route correction: the source-faithful descent data and the finite/separable simple-extension
  -- packaging are now isolated. The remaining work is the low-level endgame turning the canonical
  -- surjective tensor map into an equivalence via a stable finrank comparison.
