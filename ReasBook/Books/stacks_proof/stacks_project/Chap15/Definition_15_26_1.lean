import Mathlib.Algebra.Module.Torsion.PrimaryComponent
import stacks_proof.stacks_project.Chap10.Definition_10_70_1
import stacks_proof.stacks_project.Chap15.PrincipalIdeal
import Mathlib.Tactic.StacksAttribute

-- Declarations for this item will be appended below by the statement pipeline.

open scoped TensorProduct
open scoped AffineBlowupChart

noncomputable section

section

universe u v

variable {R : Type u} [CommRing R]

/-
Domain-style sampling pass for Definition 15.26.1.

Primary domain: commutative algebra of affine blowup charts and module torsion.

Sampled owner declarations:
* `affineBlowupChart` from `Chap10/Definition_10_70_1.lean`;
* `Ideal.primaryComponent` from mathlib's torsion-primary-component API;
* `Submodule.torsionBySet` as the lower-level torsion presentation used to build
  `Ideal.primaryComponent`.

Owner abstraction: the ambient chart is the Chapter 10 owner `affineBlowupChart I a`.
Primitive data for the strict transform are the base-changed module `R[I / a] ⊗[R] M` and the
principal ideal generated by the image of `a` in the chart. The submodule of elements annihilated
by some power of that distinguished element is canonically the primary component for this principal
ideal, so the quotient should use the owner `Ideal.primaryComponent` rather than a lower-level
torsion presentation.

Source/core/bridge triage:
* `source-facing`: `affineBlowupStrictTransform`;
* `core/canonical`: `R[I / a]` and `Ideal.primaryComponent`;
* `bridge/view`: `Submodule.torsionBySet`, whose iterated principal-ideal torsion pieces assemble
  into the same `a`-power torsion submodule.
-/

variable (I : Ideal R) (a : I)
variable (M : Type v) [AddCommGroup M] [Module R M]

/-- Definition 15.26.1: the strict transform of an `R`-module `M` along the affine blowup chart
`R[I/a]` is the quotient of `R[I/a] ⊗[R] M` by the submodule of elements annihilated by some power
of the image of `a`. -/
@[stacks 053H]
def affineBlowupStrictTransform : Type (max u v) :=
  let A := R[I / a]
  let T := A ⊗[R] M
  let J : Ideal A := principalIdeal (algebraMap R A a)
  T ⧸ J.primaryComponent T

instance instAddCommGroupAffineBlowupStrictTransform :
    AddCommGroup (affineBlowupStrictTransform I a M) := by
  let A := R[I / a]
  let T := A ⊗[R] M
  let J : Ideal A := principalIdeal (algebraMap R A a)
  change AddCommGroup (T ⧸ J.primaryComponent T)
  infer_instance

instance instModuleAffineBlowupChartAffineBlowupStrictTransform :
    Module R[I / a] (affineBlowupStrictTransform I a M) := by
  let A := R[I / a]
  let T := A ⊗[R] M
  let J : Ideal A := principalIdeal (algebraMap R A a)
  change Module A (T ⧸ J.primaryComponent T)
  infer_instance

instance instModuleAffineBlowupStrictTransform :
    Module R (affineBlowupStrictTransform I a M) := by
  let A := R[I / a]
  let T := A ⊗[R] M
  let J : Ideal A := principalIdeal (algebraMap R A a)
  change Module R (T ⧸ J.primaryComponent T)
  let _ : Module A (T ⧸ J.primaryComponent T) := inferInstance
  exact Module.compHom (T ⧸ J.primaryComponent T) (algebraMap R A)

end
