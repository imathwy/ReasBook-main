import Mathlib
import Mathlib.Tactic.Recall
import stacks_proof.stacks_project.Chap06.Definition_6_26_1

universe u

open AlgebraicGeometry
open TopologicalSpace

/- Domain-style sampling for Definition 17.8.1:
- primary domain: local generation of sheaves of modules on a ringed space by sections on a
  covering;
- inspected owner declarations:
  `SheafOfModules.GeneratingSections`,
  `SheafOfModules.LocalGeneratorsData`,
  `SheafOfModules.LocalGeneratorsData.IsFiniteType`,
  `SheafOfModules.IsFiniteType`;
- owner abstraction: the primitive mathlib owner data `SheafOfModules.LocalGeneratorsData`,
  specialized to the ambient category `RingedSpace.Modules X`;
- primitive data: a covering of the space together with generating sections on each restricted
  module sheaf;
- derived API: the source-facing existence predicate and its pointwise neighbourhood
  characterization.

Source/core/bridge triage:
- `source-facing`: the Stacks Project property that a sheaf is locally generated by sections;
- `core/canonical`: `Nonempty ℱ.LocalGeneratorsData`;
- `bridge/view`: the pointwise neighbourhood reformulation in
  `nonempty_localGeneratorsData_iff_pointwise`.

This item is therefore a canonical-recall item: the main entry should recall the owner
`SheafOfModules.LocalGeneratorsData`, while the source-facing existence condition is stated
directly as `Nonempty ℱ.LocalGeneratorsData` in companion declarations. -/

namespace SheafOfModules

variable {X : RingedSpace.{u}}

/-- Chap17 Definition 17 8 1: the canonical owner for local generation by sections on a ringed
space is `ℱ.LocalGeneratorsData`; existence of such data is exactly the source condition that `ℱ`
is locally generated by sections. -/
recall LocalGeneratorsData

/-- Any sheaf of modules of finite type is locally generated by sections. -/
instance (ℱ : RingedSpace.Modules X) [ℱ.IsFiniteType] :
    Nonempty ℱ.LocalGeneratorsData := by
  let ⟨σ, _⟩ := IsFiniteType.exists_localGeneratorsData ℱ
  exact ⟨σ⟩

/-- Helper for Chap17 Definition 17 8 1: a point-indexed family of open neighborhoods containing
each point gives a Grothendieck cover of the terminal object on the opens site. -/
private theorem pointwiseOpenCoverCoversTop
    (U : X → Opens X) (hU : ∀ x : X, x ∈ U x) :
    (Opens.grothendieckTopology X).CoversTop U := by
  -- Refine any point of an open `V` to the smaller neighborhood `V ∩ U x`.
  intro V x hx
  refine ⟨V ⊓ U x, CategoryTheory.homOfLE inf_le_left, ?_, ?_⟩
  · exact ⟨x, ⟨CategoryTheory.homOfLE inf_le_right⟩⟩
  · exact ⟨hx, hU x⟩

/-- Helper for Chap17 Definition 17 8 1: local generator data yields, around each point, a member
of the chosen cover carrying generating sections on the corresponding restriction. -/
private theorem existsGeneratingNeighborhoodOfLocalGeneratorsData
    (ℱ : RingedSpace.Modules X) (σ : ℱ.LocalGeneratorsData) (x : X) :
    ∃ (U : Opens X) (_ : x ∈ U), Nonempty ((ℱ.over U).GeneratingSections) := by
  -- Pick a cover member above `⊤` that contains `x`.
  obtain ⟨V, _iV, hmem, hxV⟩ := σ.coversTop ⊤ x (by trivial)
  obtain ⟨j, ⟨f⟩⟩ := hmem
  -- The selected cover member already comes with its generating family.
  exact ⟨σ.X j, f.le hxV, ⟨σ.generators j⟩⟩

/-- Helper for Chap17 Definition 17 8 1: pointwise generating neighborhoods can be packaged into
the canonical owner `LocalGeneratorsData`. -/
private theorem nonemptyLocalGeneratorsDataOfPointwise
    (ℱ : RingedSpace.Modules X)
    (h : ∀ x : X, ∃ (U : Opens X) (_ : x ∈ U), Nonempty ((ℱ.over U).GeneratingSections)) :
    Nonempty ℱ.LocalGeneratorsData := by
  classical
  -- Choose one generating neighborhood and one generating family for each point.
  choose U hU hσ using h
  let σ : ∀ x : X, (ℱ.over (U x)).GeneratingSections := fun x ↦ Classical.choice (hσ x)
  -- Package the chosen data into the canonical local-generators owner.
  exact ⟨{
    I := X
    X := U
    coversTop := pointwiseOpenCoverCoversTop U hU
    generators := σ
  }⟩

-- Proof sketch: one direction extracts from `LocalGeneratorsData` an open of the chosen covering
-- containing `x`, together with the specified generating sections on that restriction. For the
-- converse, choose for each `x` a neighbourhood where the restriction is globally generated, then
-- package these neighbourhoods and generating families into `LocalGeneratorsData`.
/-- Chap17 Definition 17 8 1: a sheaf of modules is locally generated by sections exactly when
every point has an open neighbourhood on which the restricted sheaf is generated by global
sections. -/
theorem nonempty_localGeneratorsData_iff_pointwise
    (ℱ : RingedSpace.Modules X) :
    Nonempty ℱ.LocalGeneratorsData ↔
      ∀ x : X, ∃ (U : Opens X) (_ : x ∈ U), Nonempty ((ℱ.over U).GeneratingSections) := by
  constructor
  · intro hℱ x
    -- Unpack the owner data and extract a cover member containing the chosen point.
    rcases hℱ with ⟨σ⟩
    exact existsGeneratingNeighborhoodOfLocalGeneratorsData ℱ σ x
  · intro h
    -- Repackage the pointwise neighborhoods into a single choice of local generators data.
    exact nonemptyLocalGeneratorsDataOfPointwise ℱ h

end SheafOfModules
