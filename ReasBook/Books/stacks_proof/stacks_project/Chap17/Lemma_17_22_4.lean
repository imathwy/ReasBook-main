-- Proof sketch: represent a germ of a local section of the internal-Hom sheaf by a morphism on
-- some neighbourhood of `x` and evaluate it on stalk germs using
-- `internalHomStalkComparison`. If `ℱ` is of finite type, a local morphism with zero stalk map
-- kills finitely many local generators after shrinking, hence vanishes near `x`.
/-- Lemma 17.22.4, injective clause: if `\mathcal F` is of finite type, then the canonical
comparison
`(\mathcal H\!\mathit{om}_{\mathcal O_X}(\mathcal F, \mathcal G))_x \to
\mathcal H\!\mathit{om}_{\mathcal O_{X, x}}(\mathcal F_x, \mathcal G_x)`
is injective. -/
@[stacks 01CP]
theorem internalHomStalkComparison_injective_of_isFiniteType
    (ℱ 𝒢 : ModX) (x : X) [ℱ.IsFiniteType] :
    Function.Injective (internalHomStalkComparison ℱ 𝒢 x) := by
  -- Reduce to a neighborhood where `ℱ` has finitely many generators. Once the represented-kernel
  -- shrinking lemma is available, every stalk-kernel element is forced to vanish on a smaller
  -- neighborhood and hence already vanishes in the stalk.
  rcases exists_finite_generating_neighborhood ℱ x with ⟨U, hxU, σ, hσ⟩
  let _ := hσ
  intro a b hab
  apply sub_eq_zero.mp
  have hkernel :
      (internalHomStalkComparison ℱ 𝒢 x).hom (a - b) = 0 := by
    change (internalHomStalkComparison ℱ 𝒢 x).hom a -
        (internalHomStalkComparison ℱ 𝒢 x).hom b = 0
    simpa [hab]
  obtain ⟨U₀, hxU₀, c, hc⟩ :=
    TopCat.Presheaf.germ_exist (ℱ ⟶[ModX] 𝒢).val.presheaf x (a - b)
  let W : Opens X := U ⊓ U₀
  have hxW : x ∈ W := ⟨hxU, hxU₀⟩
  have hWU : W ≤ U := inf_le_left
  have hWU₀ : W ≤ U₀ := inf_le_right
  let cW : (ℱ ⟶[ModX] 𝒢).val.obj (op W) :=
    (ℱ ⟶[ModX] 𝒢).val.map (homOfLE hWU₀).op c
  let σW : (ℱ.over W).GeneratingSections :=
    restrictedGeneratingSections σ (Over.mk (homOfLE hWU))
  let _ : σW.IsFiniteType := by
    refine SheafOfModules.GeneratingSections.IsFiniteType.mk ?_
    simpa [σW, restrictedGeneratingSections] using (hσ.finite : Finite σ.I)
  have hcW :
      TopCat.Presheaf.germ (ℱ ⟶[ModX] 𝒢).val.presheaf W x hxW cW = a - b := by
    calc
      TopCat.Presheaf.germ (ℱ ⟶[ModX] 𝒢).val.presheaf W x hxW cW =
          TopCat.Presheaf.germ (ℱ ⟶[ModX] 𝒢).val.presheaf U₀ x hxU₀ c := by
            dsimp [cW]
            exact TopCat.Presheaf.germ_res_apply
              (ℱ ⟶[ModX] 𝒢).val.presheaf (homOfLE hWU₀) x hxW c
      _ = a - b := hc
  have hkernelW :
      (internalHomStalkComparison ℱ 𝒢 x).hom
        (TopCat.Presheaf.germ (ℱ ⟶[ModX] 𝒢).val.presheaf W x hxW cW) = 0 := by
    simpa [hcW] using hkernel
  rcases internalHomStalkComparison_representative_zero_near_point
      (ℱ := ℱ) (𝒢 := 𝒢) (x := x) (U := W) hxW σW cW hkernelW with
    ⟨V, hxV, hVW, hcV⟩
  calc
    a - b =
        TopCat.Presheaf.germ (ℱ ⟶[ModX] 𝒢).val.presheaf W x hxW cW := hcW.symm
    _ =
        TopCat.Presheaf.germ (ℱ ⟶[ModX] 𝒢).val.presheaf V x hxV
          ((ℱ ⟶[ModX] 𝒢).val.map (homOfLE hVW).op cW) := by
            symm
            exact TopCat.Presheaf.germ_res_apply
              (ℱ ⟶[ModX] 𝒢).val.presheaf (homOfLE hVW) x hxV cW
    _ = 0 := by
          simpa [hcV]

