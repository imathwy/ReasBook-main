-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory Opposite TopologicalSpace
open CategoryTheory.Limits
open CategoryTheory.Limits.CompleteLattice
open AlgebraicGeometry

noncomputable section

universe u

open scoped ModuleRestriction

namespace SheafOfModules

/- Domain-style sampling for Lemma 17.9.4:
- primary domain: local surjectivity criteria for morphisms of finite-type `\mathcal O_X`-module
  sheaves on a ringed space;
- inspected owner declarations:
  `RingedSpace.Modules`,
  `SheafOfModules.IsFiniteType`,
  `AlgebraicGeometry.RingedSpace.moduleRestrictionMap`,
  `AlgebraicGeometry.RingedSpace.moduleStalkHom`,
  `AlgebraicGeometry.RingedSpace.moduleStalkMap`;
- best owner abstraction: the bundled module category `RingedSpace.Modules X`, with restriction to
  `U` expressed by the owner notation `φ |_ U` for `RingedSpace.moduleRestrictionMap U φ` and
  the stalk morphism expressed by `RingedSpace.moduleStalkHom x φ`;
- primitive data: the morphism `φ : 𝒢 ⟶ ℱ`, the point `x : X`, and stalkwise surjectivity at
  `x`, equivalently epimorphy of `RingedSpace.moduleStalkHom x φ`;
- derived API: the restricted morphism on `U`, the resulting epimorphism witness, and the
  source-facing surjectivity reformulation using `RingedSpace.moduleStalkMap`.

Source/core/bridge triage:
- `source-facing`: after shrinking around `x`, the restricted morphism `φ |_ U` is surjective;
- `core/canonical`: `Epi (φ |_ U)`;
- `bridge/view`: `Function.Surjective (RingedSpace.moduleStalkMap x φ)`, derived from the stalk
  owner morphism `RingedSpace.moduleStalkHom x φ`. -/

variable {X : RingedSpace.{u}}
variable {𝒢 ℱ : RingedSpace.Modules X}

/-- Helper for Lemma 17.9.4: a finite-type module sheaf has a neighborhood of any point on which
it is generated by finitely many global sections. -/
private theorem exists_finite_generating_neighborhood
    (x : X) [ℱ.IsFiniteType] :
    ∃ (U : Opens X) (_ : x ∈ U) (σ : (ℱ.over U).GeneratingSections), σ.IsFiniteType := by
  -- Choose local finite generating data and then select one covering open containing `x`.
  obtain ⟨τ, hτ⟩ := SheafOfModules.IsFiniteType.exists_localGeneratorsData ℱ
  obtain ⟨V, _iV, hmem, hxV⟩ := τ.coversTop ⊤ x (by trivial)
  obtain ⟨j, ⟨f⟩⟩ := hmem
  -- The selected cover member already carries the required finite generating family.
  exact ⟨τ.X j, f.le hxV, τ.generators j, hτ.isFiniteType j⟩

/-- Helper for Lemma 17.9.4: a section whose germ lies in the image of the stalk map lifts after
shrinking to a neighborhood of the chosen point. -/
private theorem exists_lift_of_section_near_point
    (φ : 𝒢 ⟶ ℱ) (x : X)
    (hφx : Function.Surjective (RingedSpace.moduleStalkMap x φ))
    {U : Opens X} (hxU : x ∈ U) (s : ℱ.val.obj (op U)) :
    ∃ (V : Opens X) (_ : x ∈ V) (_ : V ≤ U) (t : 𝒢.val.obj (op V)),
      (φ.val.app (op V)) t = ℱ.val.map (homOfLE ‹V ≤ U›).op s := by
  -- Lift the germ of `s` to a germ of `𝒢` using stalkwise surjectivity.
  obtain ⟨m, hm⟩ := hφx (TopCat.Presheaf.germ ℱ.val.presheaf U x hxU s)
  obtain ⟨V₀, hxV₀, t₀, ht₀⟩ := TopCat.Presheaf.germ_exist 𝒢.val.presheaf x m
  have hgerm :
      TopCat.Presheaf.germ ℱ.val.presheaf V₀ x hxV₀ ((φ.val.app (op V₀)) t₀) =
        TopCat.Presheaf.germ ℱ.val.presheaf U x hxU s := by
    rw [← RingedSpace.moduleStalkMap_germ x φ V₀ hxV₀ t₀, ht₀, hm]
  -- Equality of germs becomes equality of sections after shrinking once more.
  obtain ⟨V, hxV, iV₀, iU, hsec⟩ :=
    TopCat.Presheaf.germ_eq ℱ.val.presheaf x hxV₀ hxU ((φ.val.app (op V₀)) t₀) s hgerm
  let hV₀ : V ≤ V₀ := iV₀.le
  let hVU : V ≤ U := iU.le
  let t : 𝒢.val.obj (op V) := 𝒢.val.map iV₀.op t₀
  refine ⟨V, hxV, hVU, t, ?_⟩
  -- Naturality of `φ` identifies the restricted lift with the restricted target section.
  have hnat :
      (φ.val.app (op V)) t =
        ℱ.val.map iV₀.op ((φ.val.app (op V₀)) t₀) := by
    simpa [t, FunctorToTypes.map_comp_apply] using
      DFunLike.congr_fun (congrArg ModuleCat.Hom.hom (φ.val.naturality iV₀.op)) t₀
  have hsec' :
      ℱ.val.map iV₀.op ((φ.val.app (op V₀)) t₀) =
        ℱ.val.map iU.op s := by
    simpa using hsec
  rw [hnat, hsec']
  rfl

/-- Helper for Lemma 17.9.4: the section induced by a value on `W` is compatible with restriction
inside the slice over `W`. -/
private theorem over_sections_equiv_obj_inv_property
    {U : Opens X} (M : SheafOfModules (X.ringCatSheaf.over U)) (W : Over U)
    (m : M.val.obj (op W)) :
    ∀ ⦃V Y : (Over W)ᵒᵖ⦄ (f : V ⟶ Y),
      (M.over W).val.map f ((M.over W).val.map ((Over.mkIdTerminal.from V.unop).op) m) =
        (M.over W).val.map ((Over.mkIdTerminal.from Y.unop).op) m := by
  intro V Y f
  -- Compatibility comes from the uniqueness of morphisms to the terminal object of `Over W`.
  have h :
      (Over.mkIdTerminal.from V.unop).op ≫ f = (Over.mkIdTerminal.from Y.unop).op := by
    apply Quiver.Hom.unop_inj
    simp only [Quiver.Hom.unop_op]
    exact Over.mkIdTerminal.hom_ext
      (f.unop ≫ Over.mkIdTerminal.from V.unop)
      (Over.mkIdTerminal.from Y.unop)
  rw [← PresheafOfModules.map_comp_apply, h]

/-- Helper for Lemma 17.9.4: a section of `M.over W` is determined by its value on the terminal
object of `Over W`. -/
private theorem over_sections_equiv_obj_left_inv
    {U : Opens X} (M : SheafOfModules (X.ringCatSheaf.over U)) (W : Over U)
    (s : (M.over W).sections) :
    (M.over W).val.sectionsMk
        (fun V ↦ (M.over W).val.map ((Over.mkIdTerminal.from V.unop).op)
          (s.1 (op (Over.mk (𝟙 W)))))
        (over_sections_equiv_obj_inv_property M W (s.1 (op (Over.mk (𝟙 W))))) = s := by
  -- A section of the restricted sheaf is determined by its value on the terminal object.
  ext V
  simpa using PresheafOfModules.sections_property s ((Over.mkIdTerminal.from V.unop).op)

/-- Helper for Lemma 17.9.4: evaluating the section induced by `m` at the terminal object gives
back `m`. -/
private theorem over_sections_equiv_obj_right_inv
    {U : Opens X} (M : SheafOfModules (X.ringCatSheaf.over U)) (W : Over U)
    (m : M.val.obj (op W)) :
    ((M.over W).val.sectionsMk
        (fun V ↦ (M.over W).val.map ((Over.mkIdTerminal.from V.unop).op) m)
        (over_sections_equiv_obj_inv_property M W m)).1 (op (Over.mk (𝟙 W))) = m := by
  -- Evaluating at the terminal object recovers the original element.
  change (M.over W).val.map ((Over.mkIdTerminal.from (Over.mk (𝟙 W))).op) m = m
  have h :
      Over.mkIdTerminal.from (Over.mk (𝟙 W)) = 𝟙 (Over.mk (𝟙 W)) :=
    Over.mkIdTerminal.hom_ext _ _
  simpa using (M.over W).val.congr_map_apply (congrArg Quiver.Hom.op h) m

/-- Helper for Lemma 17.9.4: sections of the restriction of a sheaf of modules to `W : Over U`
are canonically identified with the value of the original sheaf on `W`. -/
private noncomputable def over_sections_equiv_obj
    {U : Opens X} (M : SheafOfModules (X.ringCatSheaf.over U)) (W : Over U) :
    (M.over W).sections ≃ M.val.obj (op W) :=
  { toFun := fun s ↦ s.1 (op (Over.mk (𝟙 W)))
    invFun := fun m ↦
      (M.over W).val.sectionsMk
        (fun V ↦ (M.over W).val.map ((Over.mkIdTerminal.from V.unop).op) m)
        (over_sections_equiv_obj_inv_property M W m)
    left_inv := over_sections_equiv_obj_left_inv M W
    right_inv := over_sections_equiv_obj_right_inv M W }

/-- Helper for Lemma 17.9.4: under the canonical section equivalence, the restriction of a
morphism to `W` acts by the original component map on `W`. -/
private theorem moduleOverRestrictionMap_app_terminal
    {U : Opens X} {M N : SheafOfModules (X.ringCatSheaf.over U)}
    (ψ : M ⟶ N) (W : Over U) :
    (RingedSpace.moduleOverRestrictionMap W ψ).val.app (op (Over.mk (𝟙 W))) = ψ.val.app (op W) := by
  ext m
  rfl

/-- Helper for Lemma 17.9.4: under the canonical section equivalence, the restriction of a
morphism to `W` acts by the original component map on `W`. -/
private theorem over_sections_equiv_obj_sectionsMap
    {U : Opens X} {M N : SheafOfModules (X.ringCatSheaf.over U)}
    (ψ : M ⟶ N) (W : Over U) (s : (M.over W).sections) :
    (over_sections_equiv_obj N W)
      (SheafOfModules.sectionsMap (RingedSpace.moduleOverRestrictionMap W ψ) s) =
        (ψ.val.app (op W)) ((over_sections_equiv_obj M W) s) := by
  -- Evaluating both sides on the terminal object of `Over W` gives the same sectionwise formula.
  change ((RingedSpace.moduleOverRestrictionMap W ψ).val.app (op (Over.mk (𝟙 W))))
      (s.1 (op (Over.mk (𝟙 W)))) =
    (ψ.val.app (op W)) (s.1 (op (Over.mk (𝟙 W))))
  exact congrArg (fun f : M.val.obj (op W) ⟶ N.val.obj (op W) ↦ f (s.1 (op (Over.mk (𝟙 W)))))
    (moduleOverRestrictionMap_app_terminal ψ W)

/-- Helper for Lemma 17.9.4: the inverse of the canonical section equivalence is natural in the
sheaf morphism. -/
private theorem sectionsMap_over_sections_equiv_obj_symm
    {U : Opens X} {M N : SheafOfModules (X.ringCatSheaf.over U)}
    (ψ : M ⟶ N) (W : Over U) (m : M.val.obj (op W)) :
    SheafOfModules.sectionsMap (RingedSpace.moduleOverRestrictionMap W ψ)
        ((over_sections_equiv_obj M W).symm m) =
      (over_sections_equiv_obj N W).symm ((ψ.val.app (op W)) m) := by
  apply (over_sections_equiv_obj N W).injective
  rw [over_sections_equiv_obj_sectionsMap]
  simp

/-- Helper for Lemma 17.9.4: two morphisms out of a module sheaf agree once they agree on a
chosen generating family of sections. -/
private theorem moduleHom_eq_of_generators_eq
    {U : Opens X} {M N : SheafOfModules (X.ringCatSheaf.over U)}
    (σ : M.GeneratingSections) {f g : M ⟶ N}
    (hfg : ∀ i : σ.I, SheafOfModules.sectionsMap f (σ.s i) =
      SheafOfModules.sectionsMap g (σ.s i)) :
    f = g := by
  -- Compare after precomposing with the canonical free cover attached to the generators.
  apply (cancel_epi σ.π).1
  -- On the free basis sections the two composites agree by hypothesis.
  apply (SheafOfModules.freeHomEquiv N).injective
  funext i
  simpa [SheafOfModules.freeHomEquiv_comp_apply, SheafOfModules.GeneratingSections.π] using hfg i

/-- Helper for Lemma 17.9.4: two morphisms from a free sheaf agree once they have the same values
on every free basis section. -/
private theorem moduleHom_eq_of_freeSection_eq
    {U : Opens X} {W : Over U} {I : Type u}
    {M : SheafOfModules ((X.ringCatSheaf.over U).over W)}
    {f g : (SheafOfModules.free.{u} I :
      SheafOfModules ((X.ringCatSheaf.over U).over W)) ⟶ M}
    (hfg : ∀ i : I,
      SheafOfModules.sectionsMap f
          (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U).over W) i) =
        SheafOfModules.sectionsMap g
          (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U).over W) i)) :
    f = g := by
  -- Proof comment: `freeHomEquiv` identifies a map out of the free sheaf with its values on the
  -- canonical basis, so basiswise equality implies equality of morphisms.
  apply (SheafOfModules.freeHomEquiv M).injective
  funext i
  exact hfg i

/-- Helper for Lemma 17.9.4: the tautological sections of a free sheaf recover the identity
morphism. -/
private theorem free_tautological_sections_symm
    {U : Opens X} (I : Type u) :
    ((SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)).freeHomEquiv).symm
        (SheafOfModules.freeSection (R := X.ringCatSheaf.over U)) =
      𝟙 (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)) := by
  -- Compare both morphisms on the free basis; there they are literally the same sections.
  apply (SheafOfModules.freeHomEquiv
    (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U))).injective
  funext i
  calc
    (SheafOfModules.freeHomEquiv
        (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)))
        (((SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)).freeHomEquiv).symm
          (SheafOfModules.freeSection (R := X.ringCatSheaf.over U))) i =
      SheafOfModules.freeSection (R := X.ringCatSheaf.over U) i := by
          simpa using
            (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection
              (R := X.ringCatSheaf.over U)
              (f := SheafOfModules.freeSection (R := X.ringCatSheaf.over U))
              i)
    _ =
      (SheafOfModules.freeHomEquiv
        (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)))
        (𝟙 (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U))) i := by
          simpa using
            (SheafOfModules.freeHomEquiv_apply
              (M := (SheafOfModules.free.{u} I :
                SheafOfModules (X.ringCatSheaf.over U)))
              (f := 𝟙 (SheafOfModules.free.{u} I :
                SheafOfModules (X.ringCatSheaf.over U)))
              (i := i)).symm

/-- Helper for Lemma 17.9.4: the tautological basis sections form a generating family on a free
sheaf. -/
private noncomputable def free_tautological_generators
    {U : Opens X} (I : Type u) :
    (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)).GeneratingSections where
  I := I
  s := SheafOfModules.freeSection (R := X.ringCatSheaf.over U)
  epi := by
    -- After identifying the universal morphism with the identity, epimorphicity is immediate.
    simpa [free_tautological_sections_symm (X := X) (U := U) I] using
      (inferInstance :
        Epi (𝟙 (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U))))

/-- Helper for Lemma 17.9.4: restricting the canonical generating epimorphism of a generating
family preserves epimorphicity. -/
private theorem restricted_generating_pi_epi
    {U : Opens X} {M : SheafOfModules (X.ringCatSheaf.over U)}
    (σ : M.GeneratingSections) (W : Over U) :
    Epi ((SheafOfModules.pushforward (𝟙 ((X.ringCatSheaf.over U).over W))).map σ.π) := by
  -- Proof comment: restriction to `W` is the left adjoint in
  -- `SheafOfModules.overPushforwardOverAdj`, so it preserves the epimorphic generating map `σ.π`.
  let F : SheafOfModules (X.ringCatSheaf.over U) ⥤
      SheafOfModules ((X.ringCatSheaf.over U).over W) :=
    SheafOfModules.pushforward (𝟙 ((X.ringCatSheaf.over U).over W))
  letI : Functor.PreservesEpimorphisms F :=
    Functor.preservesEpimorphisms_of_adjunction
      (SheafOfModules.overPushforwardOverAdj (R := X.ringCatSheaf.over U) W)
  change Epi (F.map σ.π)
  infer_instance

/-- Helper for Lemma 17.9.4: restriction to a slice `W : Over U` is the canonical pushforward
functor into the slice module category. -/
private noncomputable def overRestrictionFunctor
    {U : Opens X} (W : Over U) :
    SheafOfModules (X.ringCatSheaf.over U) ⥤
      SheafOfModules ((X.ringCatSheaf.over U).over W) :=
  SheafOfModules.pushforward (𝟙 ((X.ringCatSheaf.over U).over W))

/-- Helper for Lemma 17.9.4: restriction to a slice preserves the coproducts needed to form the
free sheaf on generators indexed by `I`. -/
private instance overRestrictionFunctorPreservesColimitsOfShape
    {U : Opens X} (W : Over U) (I : Type u) :
    PreservesColimitsOfShape (Discrete I) (overRestrictionFunctor (X := X) W) := by
  dsimp [overRestrictionFunctor]
  infer_instance

/-- Helper for Lemma 17.9.4: `mapFree` identifies restriction of the ambient free sheaf with the
canonical free sheaf on the slice over `W`. -/
private noncomputable def overRestrictionFreeIso
    {U : Opens X} (W : Over U) (I : Type u) :
    (overRestrictionFunctor (X := X) W).obj
        (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)) ≅
      (SheafOfModules.free.{u} I :
        SheafOfModules ((X.ringCatSheaf.over U).over W)) :=
  SheafOfModules.mapFree
    (overRestrictionFunctor (X := X) W)
    (Iso.refl (SheafOfModules.unit ((X.ringCatSheaf.over U).over W)))
    I

/-- Helper for Lemma 17.9.4: the `mapFree` comparison carries each ambient free basis morphism to
the corresponding basis morphism on the slice free sheaf. -/
private theorem overRestrictionFreeIso_hom_ιFree
    {U : Opens X} (W : Over U) (I : Type u) (i : I) :
    (overRestrictionFunctor (X := X) W).map
        (SheafOfModules.ιFree (R := X.ringCatSheaf.over U) i) ≫
        (overRestrictionFreeIso (X := X) W I).hom =
      SheafOfModules.ιFree (R := (X.ringCatSheaf.over U).over W) i := by
  -- Proof comment: this is the basis-vector computation built into `mapFree`.
  simpa [overRestrictionFunctor, overRestrictionFreeIso] using
    (SheafOfModules.map_ιFree_mapFree_hom
      (F := SheafOfModules.pushforward (𝟙 ((X.ringCatSheaf.over U).over W)))
      (η := Iso.refl (SheafOfModules.unit ((X.ringCatSheaf.over U).over W)))
      (I := I) (i := i))

/-- Helper for Lemma 17.9.4: the inverse `mapFree` transport sends the slice free basis section
to the restricted ambient free basis section. -/
private theorem restrictedFreeBasisTransport
    {U : Opens X} (I : Type u) (W : Over U) (i : I) :
    SheafOfModules.sectionsMap
        ((overRestrictionFreeIso (X := X) W I).inv)
        (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U).over W) i) =
      (over_sections_equiv_obj
          (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)) W).symm
        ((SheafOfModules.freeSection (R := X.ringCatSheaf.over U) i).1 (op W)) := by
  -- Route correction: avoid unfolding the section equivalence at the terminal object by hand.
  -- The stable route is to compare the basis inclusions through `mapFree.hom` and then read the
  -- resulting section equality through `over_sections_equiv_obj`.
  let e := overRestrictionFreeIso (X := X) W I
  have hiota :
      (overRestrictionFunctor (X := X) W).map
          (SheafOfModules.ιFree (R := X.ringCatSheaf.over U) i) =
        SheafOfModules.ιFree (R := (X.ringCatSheaf.over U).over W) i ≫ e.inv := by
    -- Compare the basis inclusions through `mapFree.hom` and cancel the isomorphism.
    apply (cancel_mono e.hom).1
    simpa [Category.assoc] using overRestrictionFreeIso_hom_ιFree (X := X) W I i
  calc
    SheafOfModules.sectionsMap e.inv
        (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U).over W) i) =
      SheafOfModules.unitHomEquiv
        (((SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)).over W))
        (SheafOfModules.ιFree (R := (X.ringCatSheaf.over U).over W) i ≫ e.inv) := by
          rfl
    _ =
      SheafOfModules.unitHomEquiv
        (((SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)).over W))
        ((overRestrictionFunctor (X := X) W).map
          (SheafOfModules.ιFree (R := X.ringCatSheaf.over U) i)) := by
          rw [← hiota]
  apply (over_sections_equiv_obj
      (SheafOfModules.free.{u} I : SheafOfModules (X.ringCatSheaf.over U)) W).injective
  -- Evaluating the restricted ambient basis morphism at the terminal object gives the ambient
  -- basis section restricted to `W`.
  rfl

/-- Helper for Lemma 17.9.4: restricting a generating family to `W` gives, after the canonical
slice identification, the free morphism attached to the restricted sections. -/
private theorem restricted_generating_pi_eq_free_hom
    {U : Opens X} {M : SheafOfModules (X.ringCatSheaf.over U)}
    (σ : M.GeneratingSections) (W : Over U) :
    (overRestrictionFreeIso (X := X) W σ.I).inv ≫
      (overRestrictionFunctor (X := X) W).map σ.π =
      (((M.over W).freeHomEquiv).symm
        (fun i ↦ (over_sections_equiv_obj M W).symm ((σ.s i).1 (op W)))) := by
  -- Route correction: compare the two morphisms directly on the free basis sections.
  apply moduleHom_eq_of_freeSection_eq (X := X) (U := U) (W := W)
  intro i
  calc
    SheafOfModules.sectionsMap
        ((overRestrictionFreeIso (X := X) W σ.I).inv ≫
          (overRestrictionFunctor (X := X) W).map σ.π)
        (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U).over W) i) =
      SheafOfModules.sectionsMap
        ((overRestrictionFunctor (X := X) W).map σ.π)
        (SheafOfModules.sectionsMap
          ((overRestrictionFreeIso (X := X) W σ.I).inv)
          (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U).over W) i)) := by
            rw [SheafOfModules.sectionsMap_comp]
    _ = SheafOfModules.sectionsMap
        ((overRestrictionFunctor (X := X) W).map σ.π)
        ((over_sections_equiv_obj
            (SheafOfModules.free.{u} σ.I : SheafOfModules (X.ringCatSheaf.over U)) W).symm
          ((SheafOfModules.freeSection (R := X.ringCatSheaf.over U) i).1 (op W))) := by
            rw [restrictedFreeBasisTransport]
    _ = (over_sections_equiv_obj M W).symm
          ((σ.s i).1 (op W)) := by
            change SheafOfModules.sectionsMap
                (RingedSpace.moduleOverRestrictionMap W σ.π)
                ((over_sections_equiv_obj
                  (SheafOfModules.free.{u} σ.I : SheafOfModules (X.ringCatSheaf.over U))
                  W).symm
                  ((SheafOfModules.freeSection (R := X.ringCatSheaf.over U) i).1 (op W))) =
              (over_sections_equiv_obj M W).symm ((σ.s i).1 (op W))
            rw [sectionsMap_over_sections_equiv_obj_symm
              (X := X) (ψ := σ.π) W
              ((SheafOfModules.freeSection (R := X.ringCatSheaf.over U) i).1 (op W))]
            have hσ :
                SheafOfModules.sectionsMap σ.π
                    (show ((SheafOfModules.free.{u} σ.I :
                        SheafOfModules (X.ringCatSheaf.over U)).sections) from
                      SheafOfModules.freeSection (R := X.ringCatSheaf.over U) i) =
                  σ.s i := by
              -- Proof comment: the defining free morphism for `σ.π` sends the `i`th basis section
              -- to the chosen generator `σ.s i`.
              simpa [SheafOfModules.GeneratingSections.π] using
                (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection
                  (R := X.ringCatSheaf.over U) (f := σ.s) i)
            have hσW :
                (SheafOfModules.sectionsMap σ.π
                    (show ((SheafOfModules.free.{u} σ.I :
                        SheafOfModules (X.ringCatSheaf.over U)).sections) from
                      SheafOfModules.freeSection (R := X.ringCatSheaf.over U) i)).1 (op W) =
                  (σ.s i).1 (op W) := by
              exact congrArg (fun s : M.sections ↦ s.1 (op W)) hσ
            simpa [SheafOfModules.sectionsMap] using hσW
    _ = SheafOfModules.sectionsMap
        (((M.over W).freeHomEquiv).symm
          (fun j ↦ (over_sections_equiv_obj M W).symm ((σ.s j).1 (op W))))
        (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U).over W) i) := by
            symm
            simpa using
              (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection
                (R := (X.ringCatSheaf.over U).over W)
                (f := fun j ↦ (over_sections_equiv_obj M W).symm ((σ.s j).1 (op W)))
                i)

/-- Helper for Lemma 17.9.4: finitely many individual local lifts of a generating family can be
realized on one common smaller neighborhood of the chosen point. -/
private theorem exists_common_open_with_lifted_generators
    (φ : 𝒢 ⟶ ℱ) (x : X)
    (hφx : Function.Surjective (RingedSpace.moduleStalkMap x φ))
    {U₀ : Opens X} (hxU₀ : x ∈ U₀)
    (σ : (ℱ.over U₀).GeneratingSections) [σ.IsFiniteType] :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U₀) (t : σ.I → 𝒢.val.obj (op V)),
      ∀ i,
        (φ.val.app (op V)) (t i) =
          ℱ.val.map (homOfLE hVU).op
            (show ℱ.val.obj (op U₀) from (σ.s i).1 (op (Over.mk (𝟙 U₀)))) := by
  classical
  letI : Fintype σ.I := Fintype.ofFinite σ.I
  let s₀ : σ.I → ℱ.val.obj (op U₀) := fun i ↦
    show ℱ.val.obj (op U₀) from (σ.s i).1 (op (Over.mk (𝟙 U₀)))
  choose V hxV hVU t ht using fun i : σ.I ↦
    exists_lift_of_section_near_point φ x hφx hxU₀ (s₀ i)
  let V' : Opens X := U₀ ⊓ Finset.univ.inf V
  have hxV' : x ∈ V' := by
    refine ⟨hxU₀, ?_⟩
    simp [hxV]
  have hV_le_data : ∀ i : σ.I, V' ≤ V i := by
    intro i
    exact le_trans inf_le_right (Finset.inf_le (by simp))
  have hV'U₀ : V' ≤ U₀ := inf_le_left
  let t' : σ.I → 𝒢.val.obj (op V') := fun i ↦
    𝒢.val.map (homOfLE (hV_le_data i)).op (t i)
  refine ⟨V', hxV', hV'U₀, t', ?_⟩
  intro i
  -- Naturality of `φ` and transitivity of restriction identify the common-shrink lift.
  have hnat :
      (φ.val.app (op V')) (t' i) =
        ℱ.val.map (homOfLE (hV_le_data i)).op
          ((φ.val.app (op (V i))) (t i)) := by
    simpa [t', FunctorToTypes.map_comp_apply] using
      DFunLike.congr_fun
        (congrArg ModuleCat.Hom.hom
          (φ.val.naturality (homOfLE (hV_le_data i)).op))
        (t i)
  have hcomp :
      homOfLE (hV_le_data i) ≫ homOfLE (hVU i) = homOfLE hV'U₀ := by
    apply Subsingleton.elim
  have hres :
      ℱ.val.map (homOfLE (hV_le_data i)).op
          ((φ.val.app (op (V i))) (t i)) =
        ℱ.val.map (homOfLE hV'U₀).op
          (show ℱ.val.obj (op U₀) from (σ.s i).1 (op (Over.mk (𝟙 U₀)))) := by
    rw [ht i]
    change ℱ.val.map (homOfLE (hV_le_data i)).op
        (ℱ.val.map (homOfLE (hVU i)).op (s₀ i)) =
      ℱ.val.map (homOfLE hV'U₀).op (s₀ i)
    have hcompOp :
        (homOfLE (hVU i)).op ≫ (homOfLE (hV_le_data i)).op = (homOfLE hV'U₀).op := by
      apply Subsingleton.elim
    have hmap :
        ℱ.val.map ((homOfLE (hVU i)).op ≫ (homOfLE (hV_le_data i)).op) (s₀ i) =
          ℱ.val.map (homOfLE hV'U₀).op (s₀ i) := by
      simpa using congrArg (fun f : op U₀ ⟶ op V' ↦ ℱ.val.map f (s₀ i)) hcompOp
    simpa [FunctorToTypes.map_comp_apply] using hmap
  rw [hnat, hres]

/-- Helper for Lemma 17.9.4: the component of the restricted morphism `φ |_ U` at the slice
object `Over.mk (homOfLE hVU)` is the original component map on `V`. -/
private theorem restricted_map_app_homOfLE
    {U V : Opens X} (hVU : V ≤ U) (φ : 𝒢 ⟶ ℱ) :
    ((φ |_ U).val.app (op (Over.mk (homOfLE hVU)))) = φ.val.app (op V) := by
  -- Proof comment: both maps are the identity-pushforward action of `φ` on the same open `V`.
  ext s
  rfl

/-- Helper for Lemma 17.9.4: a family of lifted sections on `W` determines the induced free
source morphism into `(𝒢.over U₀).over W`. -/
private noncomputable def liftedGeneratorMap
    {U₀ : Opens X} (σ : (ℱ.over U₀).GeneratingSections)
    (W : Over U₀) (t : σ.I → (𝒢.over U₀).val.obj (op W)) :
    (SheafOfModules.free.{u} σ.I :
      SheafOfModules ((X.ringCatSheaf.over U₀).over W)) ⟶
      (𝒢.over U₀).over W :=
  (((𝒢.over U₀).over W).freeHomEquiv).symm
    (fun i ↦ (over_sections_equiv_obj (𝒢.over U₀) W).symm (t i))

/-- Helper for Lemma 17.9.4: if all members of a generating family on `U₀` lift along `φ` after
restricting to `V ≤ U₀`, then the restricted morphism `φ |_ V` is an epimorphism. -/
private theorem epi_restriction_of_lifted_generators
    {U₀ V : Opens X} (hVU : V ≤ U₀) (φ : 𝒢 ⟶ ℱ)
    (σ : (ℱ.over U₀).GeneratingSections)
    (t : σ.I → 𝒢.val.obj (op V))
    (ht : ∀ i,
      (φ.val.app (op V)) (t i) =
        ℱ.val.map (homOfLE hVU).op
          (show ℱ.val.obj (op U₀) from (σ.s i).1 (op (Over.mk (𝟙 U₀))))) :
    Epi (φ |_ V) := by
  let W : Over U₀ := Over.mk (homOfLE hVU)
  let tW : σ.I → (𝒢.over U₀).val.obj (op W) := fun i ↦
    show (𝒢.over U₀).val.obj (op W) from t i
  let l := liftedGeneratorMap (X := X) (𝒢 := 𝒢) σ W tW
  have htW : ∀ i, ((φ |_ U₀).val.app (op W)) (tW i) = (σ.s i).1 (op W) := by
    intro i
    -- Proof comment: rewrite both sides in terms of the original restriction map on `V`.
    rw [restricted_map_app_homOfLE (X := X) (𝒢 := 𝒢) (ℱ := ℱ) hVU φ]
    have hsec :
        (σ.s i).1 (op W) =
          ℱ.val.map (homOfLE hVU).op
            (show ℱ.val.obj (op U₀) from (σ.s i).1 (op (Over.mk (𝟙 U₀)))) := by
      simpa [W] using
        (PresheafOfModules.sections_property (σ.s i) (Over.mkIdTerminal.from W).op).symm
    exact (ht i).trans hsec.symm
  have hfac :
      l ≫ RingedSpace.moduleOverRestrictionMap W (φ |_ U₀) =
        (overRestrictionFreeIso (X := X) W σ.I).inv ≫
          (overRestrictionFunctor (X := X) W).map σ.π := by
    -- Proof comment: rewrite the right-hand side as the free morphism determined by the
    -- restricted generators, then compare both sides on the free basis sections.
    rw [restricted_generating_pi_eq_free_hom (X := X) (M := ℱ.over U₀) σ W]
    apply moduleHom_eq_of_freeSection_eq (X := X) (U := U₀) (W := W)
    intro i
    calc
      SheafOfModules.sectionsMap
          (l ≫ RingedSpace.moduleOverRestrictionMap W (φ |_ U₀))
          (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U₀).over W) i) =
        SheafOfModules.sectionsMap
          (RingedSpace.moduleOverRestrictionMap W (φ |_ U₀))
          (SheafOfModules.sectionsMap l
            (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U₀).over W) i)) := by
              rw [SheafOfModules.sectionsMap_comp]
      _ = SheafOfModules.sectionsMap
          (RingedSpace.moduleOverRestrictionMap W (φ |_ U₀))
          ((over_sections_equiv_obj (𝒢.over U₀) W).symm (tW i)) := by
              -- Evaluating the free-source morphism on the `i`th basis section is definitional.
              rfl
      _ = (over_sections_equiv_obj (ℱ.over U₀) W).symm
            (((φ |_ U₀).val.app (op W)) (tW i)) := by
              -- Restriction to the slice acts under `over_sections_equiv_obj` by the component
              -- map on the terminal object `W`.
              exact sectionsMap_over_sections_equiv_obj_symm
                (ψ := φ |_ U₀) W (tW i)
      _ = (over_sections_equiv_obj (ℱ.over U₀) W).symm ((σ.s i).1 (op W)) := by
              rw [htW i]
      _ = SheafOfModules.sectionsMap
          ((((ℱ.over U₀).over W).freeHomEquiv).symm
            (fun j ↦ (over_sections_equiv_obj (ℱ.over U₀) W).symm ((σ.s j).1 (op W))))
          (SheafOfModules.freeSection (R := (X.ringCatSheaf.over U₀).over W) i) := by
              -- Evaluating the target free-source morphism on the same basis section is again
              -- definitional.
              symm
              rfl
  -- Proof comment: the restricted generating map is epi, so the factorization forces the
  -- restricted morphism `φ |_ V` to be epi as well.
  letI :
      Epi ((overRestrictionFreeIso (X := X) W σ.I).inv ≫
        (overRestrictionFunctor (X := X) W).map σ.π) := by
    have hEpiRestricted :
        Epi ((overRestrictionFunctor (X := X) W).map σ.π) :=
      restricted_generating_pi_epi (X := X) σ W
    letI : Epi ((overRestrictionFunctor (X := X) W).map σ.π) := hEpiRestricted
    infer_instance
  letI : Epi (RingedSpace.moduleOverRestrictionMap W (φ |_ U₀)) :=
    epi_of_epi_fac hfac
  have hrestrict :
      RingedSpace.moduleOverRestrictionMap W (φ |_ U₀) = φ |_ V := by
    -- Proof comment: with `W = Over.mk (homOfLE hVU)`, iterating restriction once more is
    -- definitionally the same as restricting directly to `V`.
    ext s
    rfl
  exact (by rwa [← hrestrict] : Epi (φ |_ V))

-- Proof sketch: choose finitely many local generators of `ℱ` near `x`; surjectivity of the
-- underlying additive stalk map gives local lifts of the germs of those generators, and after
-- shrinking once more these lifts make the restricted morphism `φ |_ U` an epimorphism of
-- `𝒪_U`-modules.
/-- Owner-level companion to Lemma 17.9.4: if `ℱ` is of finite type and the induced stalk
morphism `𝒢_x ⟶ ℱ_x` is an epimorphism in `ModuleCat (𝒪_{X,x})`, then after shrinking around `x`
the restricted morphism `φ |_ U : 𝒢|_U → ℱ|_U` is an epimorphism. -/
theorem exists_open_neighborhood_epi_restriction_of_stalk_epi
    (φ : 𝒢 ⟶ ℱ) (x : X) [ℱ.IsFiniteType]
    (hφx : Epi (RingedSpace.moduleStalkHom x φ)) :
    ∃ (U : Opens X) (_ : x ∈ U),
      Epi (φ |_ U) := by
  -- Proof comment: first convert the stalk epimorphism into the surjectivity statement used by
  -- the local lifting helper.
  have hφx_surj : Function.Surjective (RingedSpace.moduleStalkMap x φ) := by
    simpa [RingedSpace.moduleStalkHom] using
      (ModuleCat.epi_iff_surjective (RingedSpace.moduleStalkHom x φ)).1 hφx
  -- Proof comment: choose finitely many local generators of `ℱ` near `x`, then shrink once more
  -- so each generator lifts through `φ`.
  rcases exists_finite_generating_neighborhood (ℱ := ℱ) x with ⟨U₀, hxU₀, σ, hσ⟩
  let _ : σ.IsFiniteType := hσ
  rcases exists_common_open_with_lifted_generators
      (φ := φ) (x := x) hφx_surj hxU₀ σ with
    ⟨V, hxV, hVU, t, ht⟩
  exact ⟨V, hxV, epi_restriction_of_lifted_generators
    (X := X) (𝒢 := 𝒢) (ℱ := ℱ) hVU φ σ t ht⟩

/-- Lemma 17.9.4: if `ℱ` is of finite type and the induced map on stalks
`φ_x : 𝒢_x → ℱ_x` at `x` is surjective, then there exists an open neighbourhood `U` of `x` such
that the restricted morphism `φ |_ U : 𝒢|_U → ℱ|_U` is surjective, i.e. an epimorphism of
`𝒪|_U`-modules. -/
@[stacks 01B8]
theorem exists_open_neighborhood_epi_restriction_of_stalk_surjective
    (φ : 𝒢 ⟶ ℱ) (x : X) [ℱ.IsFiniteType]
    (hφx : Function.Surjective (RingedSpace.moduleStalkMap x φ)) :
    ∃ (U : Opens X) (_ : x ∈ U),
      Epi (φ |_ U) := by
  -- Translate the source-facing surjectivity hypothesis into the owner-level epi hypothesis.
  have hφx' : Epi (RingedSpace.moduleStalkHom x φ) := by
    simpa [RingedSpace.moduleStalkHom] using
      (ModuleCat.epi_iff_surjective (RingedSpace.moduleStalkHom x φ)).2 hφx
  exact exists_open_neighborhood_epi_restriction_of_stalk_epi φ x hφx'

end SheafOfModules
