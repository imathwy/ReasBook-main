import Mathlib
import StacksProject_2024.Chap17.Definition_17_9_1

open CategoryTheory Limits Opposite TopologicalSpace

noncomputable section

universe u

namespace SheafOfModules

/- Domain-style sampling for Lemma 17.9.7:
- primary domain: directed colimits of finite-type sheaves of modules on a quasi-compact
  topological space;
- inspected owner declarations:
  `SheafOfModules.IsFiniteType`,
  `SheafOfModules.LocalGeneratorsData`,
  `SheafOfModules.GeneratingSections.ofEpi`,
  `colimit.ι`;
- best owner abstraction:
  the ambient owner category `SheafOfModules 𝒪`, with the canonical colimit coprojections
  `colimit.ι ℱ i`;
- primitive data:
  the sheaf of rings `𝒪`, the directed diagram `ℱ`, and finite local generator data for
  `colimit ℱ`;
- derived API:
  the source-facing existence of a stage whose canonical map to the colimit is epi, and the
  stabilization statement under monic transition maps.

Source/core/bridge triage:
- `source-facing`: the two Stacks Project assertions about finite-type directed colimits;
- `core/canonical`: `SheafOfModules 𝒪`, `SheafOfModules.IsFiniteType`, and the canonical colimit
  maps `colimit.ι`;
- `bridge/view`: the ringed-space specialization obtained by taking
  `𝒪 = RingedSpace.ringCatSheaf X`.

The file should therefore live at the generic `SheafOfModules` owner layer, with ringed spaces
appearing only as a specialization of the ambient sheaf of rings. -/

variable {X : TopCat.{u}} [CompactSpace X]
variable {𝒪 : TopCat.Sheaf RingCat.{u} X}
variable {I : Type u} [Preorder I] [Nonempty I] [IsDirectedOrder I]
variable (ℱ : I ⥤ SheafOfModules 𝒪)

recall PresheafOfModules.toPresheaf_map_sheafificationAdjunction_unit_app

section

variable [(colimit ℱ).IsFiniteType]

-- Route correction: the source proof repeatedly replaces finitely many stage choices by one larger
-- stage, so we isolate that directed-order step before returning to the sheaf-theoretic blocker.
/-- Helper for Lemma 17.9.7: a finite family of indices in a directed preorder admits a common
upper bound. -/
lemma exists_upper_bound_of_finite_family {β : Type u} [Finite β] (u : β → I) :
    ∃ i : I, ∀ b : β, u b ≤ i := by
  classical
  -- View the finite family as a finite subset of the directed preorder.
  let s : Set I := Set.range u
  obtain ⟨i, hi⟩ : BddAbove s := (Set.toFinite s).bddAbove
  -- The chosen upper bound dominates every value of the family.
  refine ⟨i, ?_⟩
  intro b
  exact hi (Set.mem_range_self b)

-- Route correction: the remaining source-faithful proof works by proving epi/mono after passing
-- to underlying additive sheaves and then reflecting the result back through faithfulness.
/-- Helper for Lemma 17.9.7: if the underlying additive-sheaf morphism of a morphism of
`𝒪`-module sheaves is epi, then the original morphism is epi. -/
lemma epi_of_toSheaf_map_epi {𝒢 ℋ : SheafOfModules 𝒪} (φ : 𝒢 ⟶ ℋ)
    [Epi ((SheafOfModules.toSheaf 𝒪).map φ)] : Epi φ := by
  -- Faithfulness lets us reflect the right-cancellation property from additive sheaves.
  refine ⟨?_⟩
  intro Z g h hgh
  apply (SheafOfModules.toSheaf 𝒪).map_injective
  apply (cancel_epi ((SheafOfModules.toSheaf 𝒪).map φ)).1
  simpa using congrArg ((SheafOfModules.toSheaf 𝒪).map) hgh

-- Route correction: the same faithful-reflection argument applies to monomorphisms.
/-- Helper for Lemma 17.9.7: if the underlying additive-sheaf morphism of a morphism of
`𝒪`-module sheaves is mono, then the original morphism is mono. -/
lemma mono_of_toSheaf_map_mono {𝒢 ℋ : SheafOfModules 𝒪} (φ : 𝒢 ⟶ ℋ)
    [Mono ((SheafOfModules.toSheaf 𝒪).map φ)] : Mono φ := by
  -- Faithfulness lets us reflect the left-cancellation property from additive sheaves.
  refine ⟨?_⟩
  intro Z g h hgh
  apply (SheafOfModules.toSheaf 𝒪).map_injective
  apply (cancel_mono ((SheafOfModules.toSheaf 𝒪).map φ)).1
  simpa using congrArg ((SheafOfModules.toSheaf 𝒪).map) hgh

/-- Helper for Lemma 17.9.7: the finite-type colimit sheaf has a neighborhood of any point on
which the restricted module is generated by finitely many sections. -/
private theorem exists_finite_generating_neighborhood
    (x : X) :
    ∃ (U : Opens X) (_ : x ∈ U) (σ : ((colimit ℱ).over U).GeneratingSections), σ.IsFiniteType := by
  -- Choose local finite generating data and then select a covering open containing `x`.
  obtain ⟨τ, hτ⟩ := SheafOfModules.IsFiniteType.exists_localGeneratorsData (colimit ℱ)
  obtain ⟨V, _iV, hmem, hxV⟩ := τ.coversTop ⊤ x (by trivial)
  obtain ⟨j, ⟨f⟩⟩ := hmem
  -- The chosen cover member already carries the required finite generating family.
  exact ⟨τ.X j, f.le hxV, τ.generators j, hτ.isFiniteType j⟩

/-- Helper for Lemma 17.9.7: a pointwise open neighborhood assignment on a compact space admits a
finite subcover. -/
private theorem exists_finite_subcover_of_pointwise_open
    (U : X → Opens X) (hU : ∀ x : X, x ∈ U x) :
    ∃ t : Finset X, ∀ x : X, ∃ y ∈ t, x ∈ U y := by
  classical
  obtain ⟨t, ht⟩ :=
    (isCompact_univ : IsCompact (Set.univ : Set X)).elim_finite_subcover
      (fun x : X ↦ (U x : Set X))
      (fun x ↦ (U x).isOpen)
      (by
        intro x hx
        exact Set.mem_iUnion.mpr ⟨x, hU x⟩)
  refine ⟨t, ?_⟩
  intro x
  rcases Set.mem_iUnion₂.mp (ht (by trivial : x ∈ (Set.univ : Set X))) with ⟨y, hy, hxy⟩
  exact ⟨y, hy, hxy⟩

/-- Helper for Lemma 17.9.7: every element of a filtered colimit of modules is represented by a
section from some stage. -/
private lemma moduleCat_colimit_has_stage_representative {R : RingCat.{u}}
    (B : I ⥤ ModuleCat.{u} R)
    (z : ((CategoryTheory.forget (ModuleCat.{u} R)).obj (colimit B))) :
    ∃ j : I, ∃ x : B.obj j, ((colimit.ι B j).hom) x = z := by
  letI : IsFiltered I := by infer_instance
  letI : PreservesFilteredColimits (CategoryTheory.forget (ModuleCat.{u} R)) := by infer_instance
  let e :
      ((CategoryTheory.forget (ModuleCat.{u} R)).obj (colimit B)) ≅
        colimit (B ⋙ CategoryTheory.forget (ModuleCat.{u} R)) :=
    preservesColimitIso (CategoryTheory.forget (ModuleCat.{u} R)) B
  -- First represent `z` after forgetting to the filtered colimit of underlying types.
  let z' : colimit (B ⋙ CategoryTheory.forget (ModuleCat.{u} R)) := e.hom z
  obtain ⟨j, x, hx⟩ := Types.jointly_surjective' z'
  refine ⟨j, x, ?_⟩
  have hmor :
      (CategoryTheory.forget (ModuleCat.{u} R)).map (colimit.ι B j) ≫ e.hom =
        colimit.ι (B ⋙ CategoryTheory.forget (ModuleCat.{u} R)) j := by
    simpa using
      ι_preservesColimitIso_hom (G := CategoryTheory.forget (ModuleCat.{u} R)) (F := B) (j := j)
  have hstage :
      e.hom (((colimit.ι B j).hom) x) = z' := by
    calc
      e.hom (((colimit.ι B j).hom) x) =
          colimit.ι (B ⋙ CategoryTheory.forget (ModuleCat.{u} R)) j x := by
        simpa [CategoryTheory.types_comp_apply] using congrArg (fun f ↦ f x) hmor
      _ = z' := hx
  -- Applying the inverse comparison map recovers an honest stage representative of `z`.
  simpa [e, z'] using congrArg e.inv hstage

/-- Helper for Lemma 17.9.7: a section of the underlying presheaf colimit over an open set comes
from one stage on that same open set. -/
private lemma presheaf_colimit_section_has_stage_representative
    (U : Opens X) (z : (colimit (ℱ ⋙ SheafOfModules.forget 𝒪)).obj (op U)) :
    ∃ i : I, ∃ t : (ℱ.obj i).val.obj (op U),
      ((colimit.ι (ℱ ⋙ SheafOfModules.forget 𝒪) i).app (op U)) t = z := by
  let P : I ⥤ PresheafOfModules 𝒪.obj := ℱ ⋙ SheafOfModules.forget 𝒪
  let e :
      (PresheafOfModules.evaluation 𝒪.obj (op U)).obj (colimit P) ≅
        colimit (P ⋙ PresheafOfModules.evaluation 𝒪.obj (op U)) :=
    preservesColimitIso (PresheafOfModules.evaluation 𝒪.obj (op U)) P
  -- Evaluate the presheaf colimit at `U`, then represent that module element by a stage.
  let z' := e.hom.hom z
  obtain ⟨i, t, ht⟩ :=
    moduleCat_colimit_has_stage_representative
      (B := P ⋙ PresheafOfModules.evaluation 𝒪.obj (op U)) z'
  refine ⟨i, t, ?_⟩
  have hmor :
      (PresheafOfModules.evaluation 𝒪.obj (op U)).map (colimit.ι P i) ≫ e.hom =
        colimit.ι (P ⋙ PresheafOfModules.evaluation 𝒪.obj (op U)) i := by
    simpa using
      ι_preservesColimitIso_hom (G := PresheafOfModules.evaluation 𝒪.obj (op U)) (F := P) (j := i)
  have hstage :
      e.hom.hom (((colimit.ι P i).app (op U)) t) = z' := by
    calc
      e.hom.hom (((colimit.ι P i).app (op U)) t) =
          (colimit.ι (P ⋙ PresheafOfModules.evaluation 𝒪.obj (op U)) i).hom t := by
        simpa [ModuleCat.hom_comp, P] using
          LinearMap.congr_fun (congrArg ModuleCat.Hom.hom hmor) t
      _ = z' := ht
  -- Transport the representative back across the evaluation comparison isomorphism.
  letI : Mono e.hom := by infer_instance
  exact (ModuleCat.mono_iff_injective e.hom).1 inferInstance <| by
    simpa [z'] using hstage

/-- Helper for Lemma 17.9.7: the colimit of sheaves is canonically the sheafification of the
colimit of the underlying presheaves of modules. -/
private noncomputable def colimit_iso_sheafified_presheaf_colimit :
    (PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj
        (colimit (ℱ ⋙ SheafOfModules.forget 𝒪)) ≅
      colimit ℱ := by
  let P : I ⥤ PresheafOfModules 𝒪.obj := ℱ ⋙ SheafOfModules.forget 𝒪
  let α : P ⋙ PresheafOfModules.sheafification (𝟙 𝒪.obj) ≅ ℱ :=
    NatIso.ofComponents
      (fun i ↦
        (asIso (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit).app (ℱ.obj i))
      (by
        intro i j f
        -- Proof comment: the comparison on each stage is the counit isomorphism, so naturality
        -- is exactly the naturality of the adjunction counit along the diagram morphism.
        simpa using
          (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit.naturality (ℱ.map f))
  -- Proof comment: first move the colimit through sheafification, then collapse the resulting
  -- diagram using the stagewise counit isomorphisms.
  exact
    (preservesColimitIso (PresheafOfModules.sheafification (𝟙 𝒪.obj)) P) ≪≫
      HasColimit.isoOfNatIso α

/-- Helper for Lemma 17.9.7: after transporting through the comparison isomorphism above, the
coprojection from a stage of the presheaf colimit becomes the stage coprojection into the sheaf
colimit composed with the stagewise sheafification counit. -/
private theorem colimit_iso_sheafified_presheaf_colimit_hom_ι
    (i : I) :
    (PresheafOfModules.sheafification (𝟙 𝒪.obj)).map
        (colimit.ι (ℱ ⋙ SheafOfModules.forget 𝒪) i) ≫
        (colimit_iso_sheafified_presheaf_colimit (ℱ := ℱ)).hom =
        ((asIso (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit).app
          (ℱ.obj i)).hom ≫
            colimit.ι ℱ i := by
  -- Proof comment: expand the comparison isomorphism into the colimit-preservation isomorphism
  -- followed by the stagewise counit comparison, then evaluate both pieces on the `i`th
  -- coprojection.
  dsimp [colimit_iso_sheafified_presheaf_colimit]
  simpa [Category.assoc] using
    (ι_preservesColimitIso_hom
      (G := PresheafOfModules.sheafification (𝟙 𝒪.obj))
      (F := ℱ ⋙ SheafOfModules.forget 𝒪) (j := i)).trans
      (HasColimit.isoOfNatIso_ι_hom_assoc
        (α := NatIso.ofComponents
          (fun i ↦
            (asIso (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit).app (ℱ.obj i))
          (by
            intro i j f
            simpa using
              (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit.naturality
                (ℱ.map f)))
        (j := i))

/-- Helper for Lemma 17.9.7: a section of the sheafification of a presheaf of modules comes from
the presheaf after shrinking to a neighborhood of the chosen point. -/
private theorem sheafification_unit_section_lifts_near_point
    (P : PresheafOfModules 𝒪.obj) {U : Opens X} (x : X) (hxU : x ∈ U)
    (s : ((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.obj (op U)) :
    ∃ (V : Opens X) (_ : x ∈ V) (_ : V ≤ U) (z : P.obj (op V)),
      (((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app P).app (op V)) z =
        ((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.map
          (homOfLE ‹V ≤ U›).op s := by
  let η := ((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app P)
  have hη :
      (PresheafOfModules.toPresheaf 𝒪.obj).map η =
        CategoryTheory.toSheafify (Opens.grothendieckTopology X) P.presheaf := by
    -- Proof comment: rewrite the module-sheafification unit as the additive sheafification unit.
    simpa [η] using
      (PresheafOfModules.toPresheaf_map_sheafificationAdjunction_unit_app
        (𝟙 𝒪.obj) P)
  have hη_iso :
      IsIso ((TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map
        ((PresheafOfModules.toPresheaf 𝒪.obj).map η)) := by
    -- Proof comment: on stalks, the sheafification unit is an isomorphism, so it is locally
    -- surjective on sections.
    rw [hη]
    simpa using
      (TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso x AddCommGrpCat P.presheaf)
  have hη_surj :
      Function.Surjective ((TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map
        ((PresheafOfModules.toPresheaf 𝒪.obj).map η)) :=
    (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).1 hη_iso |>.2
  -- Proof comment: lift the germ of `s` through the stalk isomorphism and shrink to make the
  -- chosen representative agree with `s`.
  obtain ⟨m, hm⟩ :=
    hη_surj (TopCat.Presheaf.germ
      (((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.presheaf)
      U x hxU s)
  obtain ⟨V₀, hxV₀, z₀, hz₀⟩ := TopCat.Presheaf.germ_exist P.presheaf x m
  have hgerm :
      TopCat.Presheaf.germ
          (((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.presheaf)
          V₀ x hxV₀ ((η.app (op V₀)) z₀) =
        TopCat.Presheaf.germ
          (((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.presheaf)
          U x hxU s := by
    -- Proof comment: replace the abstract lifted stalk element by its local section
    -- representative.
    rw [← TopCat.Presheaf.stalkFunctor_map_germ_apply V₀ x hxV₀
      ((PresheafOfModules.toPresheaf 𝒪.obj).map η) z₀, hz₀, hm]
  obtain ⟨V, hxV, iV₀, iU, hsec⟩ :=
    TopCat.Presheaf.germ_eq
      (((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.presheaf)
      x hxV₀ hxU ((η.app (op V₀)) z₀) s hgerm
  let hVU : V ≤ U := iU.le
  let z : P.obj (op V) := P.map iV₀.op z₀
  refine ⟨V, hxV, hVU, z, ?_⟩
  have hnat :
      (η.app (op V)) z =
        ((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.map iV₀.op
          ((η.app (op V₀)) z₀) := by
    -- Proof comment: naturality of the unit identifies restriction of the lifted section.
    simpa [η, z, FunctorToTypes.map_comp_apply] using
      DFunLike.congr_fun (congrArg ModuleCat.Hom.hom (η.val.naturality iV₀.op)) z₀
  have hsec' :
      ((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.map iV₀.op
          ((η.app (op V₀)) z₀) =
        ((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj P).val.map iU.op s := by
    simpa using hsec
  rw [hnat, hsec']
  rfl

/-- Helper for Lemma 17.9.7: if a presheaf section maps to zero in the sheafification, then after
shrinking around a point its restriction is already zero in the presheaf. -/
private theorem sheafification_unit_zero_near_point
    (P : PresheafOfModules 𝒪.obj) {U : Opens X} (x : X) (hxU : x ∈ U)
    (z : P.obj (op U))
    (hz :
      (((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app P).app (op U)) z = 0) :
    ∃ (V : Opens X) (_ : x ∈ V) (_ : V ≤ U),
      P.map (homOfLE ‹V ≤ U›).op z = 0 := by
  let η := ((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app P)
  have hη :
      (PresheafOfModules.toPresheaf 𝒪.obj).map η =
        CategoryTheory.toSheafify (Opens.grothendieckTopology X) P.presheaf := by
    -- Proof comment: rewrite the module-sheafification unit as the additive sheafification unit.
    simpa [η] using
      (PresheafOfModules.toPresheaf_map_sheafificationAdjunction_unit_app
        (𝟙 𝒪.obj) P)
  have hη_iso :
      IsIso ((TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map
        ((PresheafOfModules.toPresheaf 𝒪.obj).map η)) := by
    -- Proof comment: on stalks the sheafification unit is an isomorphism, so its stalk map is
    -- injective.
    rw [hη]
    simpa using
      (TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso x AddCommGrpCat P.presheaf)
  have hη_inj :
      Function.Injective ((TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map
        ((PresheafOfModules.toPresheaf 𝒪.obj).map η)) :=
    (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).1 hη_iso |>.1
  have hgerm_zero :
      (TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map
          ((PresheafOfModules.toPresheaf 𝒪.obj).map η)
          (TopCat.Presheaf.germ P.presheaf U x hxU z) = 0 := by
    -- Proof comment: push the source germ forward and use the assumed vanishing upstairs.
    rw [TopCat.Presheaf.stalkFunctor_map_germ_apply U x hxU
      ((PresheafOfModules.toPresheaf 𝒪.obj).map η) z, hz]
    exact map_zero _
  have hgerm :
      TopCat.Presheaf.germ P.presheaf U x hxU z =
        TopCat.Presheaf.germ P.presheaf U x hxU (0 : P.obj (op U)) := by
    exact hη_inj (by simpa using hgerm_zero)
  obtain ⟨V, hxV, i₁, _i₂, hsec⟩ :=
    TopCat.Presheaf.germ_eq P.presheaf x hxU hxU z 0 hgerm
  let hVU : V ≤ U := i₁.le
  refine ⟨V, hxV, hVU, ?_⟩
  -- Proof comment: equality of germs gives equality of restrictions on a smaller neighborhood.
  simpa using hsec

/-- Helper for Lemma 17.9.7: a section of the sheaf colimit lifts near a point from one actual
stage of the diagram after shrinking the open neighborhood. -/
private theorem comparisonHom_unit_colimitIota_app
    (i : I) {V : Opens X} (t : (ℱ.obj i).val.obj (op V)) :
    (colimit_iso_sheafified_presheaf_colimit (ℱ := ℱ)).hom.val.app (op V)
      ((((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app
          (colimit (ℱ ⋙ SheafOfModules.forget 𝒪))).app (op V))
        (((colimit.ι (ℱ ⋙ SheafOfModules.forget 𝒪) i).app (op V)) t)) =
      ((colimit.ι ℱ i).val.app (op V)) t := by
  let P : I ⥤ PresheafOfModules 𝒪.obj := ℱ ⋙ SheafOfModules.forget 𝒪
  let ηP := ((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app (colimit P))
  let ηi := ((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app ((ℱ.obj i).val))
  have hnat :
      (ηP.app (op V)) (((colimit.ι P i).app (op V)) t) =
        (((PresheafOfModules.sheafification (𝟙 𝒪.obj)).map (colimit.ι P i)).val.app (op V))
          ((ηi.app (op V)) t) := by
    -- Proof comment: naturality of the sheafification unit moves the stage section into the
    -- sheafified stage before applying the colimit comparison.
    simpa [ηP, ηi, P, FunctorToTypes.map_comp_apply] using
      DFunLike.congr_fun (congrArg ModuleCat.Hom.hom (ηP.naturality (colimit.ι P i))) t
  have hcomp :
      (colimit_iso_sheafified_presheaf_colimit (ℱ := ℱ)).hom.val.app (op V)
          ((((PresheafOfModules.sheafification (𝟙 𝒪.obj)).map (colimit.ι P i)).val.app (op V))
            ((ηi.app (op V)) t)) =
        ((colimit.ι ℱ i).val.app (op V))
          ((((asIso (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit).app
              (ℱ.obj i)).hom.val.app (op V))
            ((ηi.app (op V)) t)) := by
    -- Proof comment: the colimit comparison identifies the transported stage coprojection with
    -- the genuine sheaf-colimit coprojection followed by the stage counit.
    simpa [ModuleCat.hom_comp] using
      LinearMap.congr_fun
        (congrArg ModuleCat.Hom.hom
          (congrArg (fun f ↦ f.val.app (op V))
            (colimit_iso_sheafified_presheaf_colimit_hom_ι (ℱ := ℱ) i)))
        ((ηi.app (op V)) t)
  have htriangle :
      (((asIso (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit).app
          (ℱ.obj i)).hom.val.app (op V))
        ((ηi.app (op V)) t) = t := by
    have hrt :
        ηi ≫ (((asIso (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit).app
            (ℱ.obj i)).hom).val =
          𝟙 ((ℱ.obj i).val) := by
      -- Proof comment: the sheafification counit collapses the stage unit by the adjunction
      -- right triangle because each stage is already a sheaf.
      simpa [ηi] using
        (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).right_triangle_components
          (ℱ.obj i)
    have hrtV :
        (ηi.app (op V)) ≫
            (((asIso (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit).app
                (ℱ.obj i)).hom).val.app (op V) =
          𝟙 ((ℱ.obj i).val.obj (op V)) := by
      simpa using congrArg (fun f ↦ f.app (op V)) hrt
    simpa [ModuleCat.hom_comp] using
      LinearMap.congr_fun (congrArg ModuleCat.Hom.hom hrtV) t
  calc
    (colimit_iso_sheafified_presheaf_colimit (ℱ := ℱ)).hom.val.app (op V)
        ((((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app
            (colimit (ℱ ⋙ SheafOfModules.forget 𝒪))).app (op V))
          (((colimit.ι (ℱ ⋙ SheafOfModules.forget 𝒪) i).app (op V)) t)) =
      (colimit_iso_sheafified_presheaf_colimit (ℱ := ℱ)).hom.val.app (op V)
        ((((PresheafOfModules.sheafification (𝟙 𝒪.obj)).map (colimit.ι P i)).val.app (op V))
          ((ηi.app (op V)) t)) := by
      simpa [ηP, P] using congrArg
        ((colimit_iso_sheafified_presheaf_colimit (ℱ := ℱ)).hom.val.app (op V)) hnat
    _ = ((colimit.ι ℱ i).val.app (op V))
          ((((asIso (PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).counit).app
              (ℱ.obj i)).hom.val.app (op V))
            ((ηi.app (op V)) t)) := hcomp
    _ = ((colimit.ι ℱ i).val.app (op V)) t := by rw [htriangle]

/-- Helper for Lemma 17.9.7: a section of the sheaf colimit lifts near a point from one actual
stage of the diagram after shrinking the open neighborhood. -/
private theorem existsStageLiftOfColimitSectionNearPoint
    {U : Opens X} (x : X) (hxU : x ∈ U) (s : (colimit ℱ).val.obj (op U)) :
    ∃ (V : Opens X) (_ : x ∈ V) (_ : V ≤ U) (i : I) (t : (ℱ.obj i).val.obj (op V)),
      ((colimit.ι ℱ i).val.app (op V)) t = (colimit ℱ).val.map (homOfLE ‹V ≤ U›).op s := by
  let P : I ⥤ PresheafOfModules 𝒪.obj := ℱ ⋙ SheafOfModules.forget 𝒪
  let e := colimit_iso_sheafified_presheaf_colimit (ℱ := ℱ)
  let η := ((PresheafOfModules.sheafificationAdjunction (𝟙 𝒪.obj)).unit.app (colimit P))
  let s' := e.inv.val.app (op U) s
  obtain ⟨V, hxV, hVU, z, hz⟩ :=
    sheafification_unit_section_lifts_near_point (𝒪 := 𝒪) (P := colimit P) x hxU s'
  obtain ⟨i, t, ht⟩ :=
    presheaf_colimit_section_has_stage_representative (𝒪 := 𝒪) (ℱ := ℱ) V z
  refine ⟨V, hxV, hVU, i, t, ?_⟩
  have hleft :
      ((colimit.ι ℱ i).val.app (op V)) t =
        e.hom.val.app (op V) ((η.app (op V)) z) := by
    -- Proof comment: the stage representative in the presheaf colimit becomes the desired stage
    -- section in the sheaf colimit after the comparison/unit/counit normalization.
    rw [ht]
    symm
    simpa [e, η, P] using comparisonHom_unit_colimitIota_app (ℱ := ℱ) i t
  have hright :
      e.hom.val.app (op V) ((η.app (op V)) z) =
        (colimit ℱ).val.map (homOfLE hVU).op s := by
    -- Proof comment: transport the shrunken lift back across the comparison isomorphism and then
    -- use naturality of the comparison morphism with the restriction map.
    calc
      e.hom.val.app (op V) ((η.app (op V)) z) =
          e.hom.val.app (op V)
            (((PresheafOfModules.sheafification (𝟙 𝒪.obj)).obj (colimit P)).val.map
              (homOfLE hVU).op s') := by
        rw [hz]
      _ =
          (colimit ℱ).val.map (homOfLE hVU).op
            (e.hom.val.app (op U) s') := by
        simpa [e, P, s', FunctorToTypes.map_comp_apply] using
          DFunLike.congr_fun
            (congrArg ModuleCat.Hom.hom (e.hom.val.naturality (homOfLE hVU).op)) s'
      _ = (colimit ℱ).val.map (homOfLE hVU).op s := by
        simp [s']
  exact hleft.trans hright

/-- Helper for Lemma 17.9.7: finitely many local generators of the colimit sheaf can be lifted
simultaneously on one common smaller neighborhood and one common stage. -/
private theorem existsCommonOpenWithStageLiftedGenerators
    {U₀ : Opens X} (x : X) (hxU₀ : x ∈ U₀)
    (σ : ((colimit ℱ).over U₀).GeneratingSections) [σ.IsFiniteType] :
    ∃ (V : Opens X) (_ : x ∈ V) (hVU : V ≤ U₀) (i : I) (t : σ.I → (ℱ.obj i).val.obj (op V)),
      ∀ a,
        ((colimit.ι ℱ i).val.app (op V)) (t a) =
          (colimit ℱ).val.map (homOfLE hVU).op
            (show (colimit ℱ).val.obj (op U₀) from (σ.s a).1 (op (Over.mk (𝟙 U₀)))) := by
  classical
  letI : Fintype σ.I := Fintype.ofFinite σ.I
  let s₀ : σ.I → (colimit ℱ).val.obj (op U₀) := fun a ↦
    show (colimit ℱ).val.obj (op U₀) from (σ.s a).1 (op (Over.mk (𝟙 U₀)))
  choose V hxV hVU i t ht using
    fun a : σ.I ↦ existsStageLiftOfColimitSectionNearPoint (ℱ := ℱ) x hxU₀ (s₀ a)
  let V' : Opens X := U₀ ⊓ Finset.univ.inf V
  have hxV' : x ∈ V' := by
    refine ⟨hxU₀, ?_⟩
    simp [hxV]
  have hV_le_data : ∀ a : σ.I, V' ≤ V a := by
    intro a
    exact le_trans inf_le_right (Finset.inf_le (by simp))
  have hV'U₀ : V' ≤ U₀ := inf_le_left
  obtain ⟨j, hij⟩ := exists_upper_bound_of_finite_family (I := I) i
  let t' : σ.I → (ℱ.obj j).val.obj (op V') := fun a ↦
    ((ℱ.map (homOfLE (hij a))).val.app (op V'))
      ((ℱ.obj (i a)).val.map (homOfLE (hV_le_data a)).op (t a))
  refine ⟨V', hxV', hV'U₀, j, t', ?_⟩
  intro a
  have htransport :
      ((colimit.ι ℱ j).val.app (op V')) (t' a) =
        ((colimit.ι ℱ (i a)).val.app (op V'))
          ((ℱ.obj (i a)).val.map (homOfLE (hV_le_data a)).op (t a)) := by
    -- Proof comment: the common upper-bound stage is related to the original stage by the
    -- filtered colimit compatibility `colimit.w`.
    dsimp [t']
    have hw : ℱ.map (homOfLE (hij a)) ≫ colimit.ι ℱ j = colimit.ι ℱ (i a) := by
      simpa using colimit.w (ℱ := ℱ) (homOfLE (hij a))
    simpa [ModuleCat.hom_comp] using
      LinearMap.congr_fun
        (congrArg ModuleCat.Hom.hom
          (congrArg (fun f ↦ f.val.app (op V')) hw))
        ((ℱ.obj (i a)).val.map (homOfLE (hV_le_data a)).op (t a))
  have hrestrict :
      ((colimit.ι ℱ (i a)).val.app (op V'))
          ((ℱ.obj (i a)).val.map (homOfLE (hV_le_data a)).op (t a)) =
        (colimit ℱ).val.map (homOfLE hV'U₀).op (s₀ a) := by
    -- Proof comment: shrinking from `V a` to the common intersection commutes with the colimit
    -- coprojection and with restriction of the original generator.
    have hnat :
        ((colimit.ι ℱ (i a)).val.app (op V'))
            ((ℱ.obj (i a)).val.map (homOfLE (hV_le_data a)).op (t a)) =
          (colimit ℱ).val.map (homOfLE (hV_le_data a)).op
            (((colimit.ι ℱ (i a)).val.app (op (V a))) (t a)) := by
      simpa [FunctorToTypes.map_comp_apply] using
        DFunLike.congr_fun
          (congrArg ModuleCat.Hom.hom
            ((colimit.ι ℱ (i a)).val.naturality (homOfLE (hV_le_data a)).op))
          (t a)
    have hres :
        (colimit ℱ).val.map (homOfLE (hV_le_data a)).op
            (((colimit.ι ℱ (i a)).val.app (op (V a))) (t a)) =
          (colimit ℱ).val.map (homOfLE hV'U₀).op (s₀ a) := by
      rw [ht a]
      change
        (colimit ℱ).val.map (homOfLE (hV_le_data a)).op
            ((colimit ℱ).val.map (homOfLE (hVU a)).op (s₀ a)) =
          (colimit ℱ).val.map (homOfLE hV'U₀).op (s₀ a)
      have hcompOp :
          (homOfLE (hVU a)).op ≫ (homOfLE (hV_le_data a)).op =
            (homOfLE hV'U₀).op := by
        apply Subsingleton.elim
      have hmap :
          (colimit ℱ).val.map
              ((homOfLE (hVU a)).op ≫ (homOfLE (hV_le_data a)).op) (s₀ a) =
            (colimit ℱ).val.map (homOfLE hV'U₀).op (s₀ a) := by
        simpa using
          congrArg
            (fun f : op U₀ ⟶ op V' ↦ (colimit ℱ).val.map f (s₀ a))
            hcompOp
      simpa [FunctorToTypes.map_comp_apply] using hmap
    rw [hnat, hres]
  exact htransport.trans hrestrict

