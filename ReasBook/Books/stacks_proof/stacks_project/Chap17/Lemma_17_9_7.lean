/-- Helper for Lemma 17.9.7: in a filtered diagram of modules with monic transition maps, each
stage coprojection into the colimit is monic. -/
private theorem moduleCat_colimit_iota_mono_of_monoTransitions
    {R : RingCat.{u}} (B : I ⥤ ModuleCat.{u} R)
    (hB : ∀ ⦃i i' : I⦄ (f : i ⟶ i'), Mono (B.map f)) (i : I) :
    Mono (colimit.ι B i) := by
  -- Proof comment: forget to the filtered colimit of underlying types and use the standard
  -- `Types.FilteredColimit.colimit_eq_iff` criterion to compare two stage elements.
  refine (ModuleCat.mono_iff_injective _).2 ?_
  intro x y hxy
  letI : IsFiltered I := by infer_instance
  letI : PreservesFilteredColimits (CategoryTheory.forget (ModuleCat.{u} R)) := by
    infer_instance
  let F : I ⥤ Type u := B ⋙ CategoryTheory.forget (ModuleCat.{u} R)
  let e : ((CategoryTheory.forget (ModuleCat.{u} R)).obj (colimit B)) ≅ colimit F :=
    preservesColimitIso (CategoryTheory.forget (ModuleCat.{u} R)) B
  have hmor :
      (CategoryTheory.forget (ModuleCat.{u} R)).map (colimit.ι B i) ≫ e.hom =
        colimit.ι F i := by
    simpa [F] using
      ι_preservesColimitIso_hom (G := CategoryTheory.forget (ModuleCat.{u} R)) (F := B) (j := i)
  have hxy' : colimit.ι F i x = colimit.ι F i y := by
    -- Applying the comparison isomorphism moves the equality into the canonical `Type` colimit.
    have hx' :
        e.hom (((colimit.ι B i).hom) x) = colimit.ι F i x := by
      simpa [CategoryTheory.types_comp_apply] using congrArg (fun f ↦ f x) hmor
    have hy' :
        e.hom (((colimit.ι B i).hom) y) = colimit.ι F i y := by
      simpa [CategoryTheory.types_comp_apply] using congrArg (fun f ↦ f y) hmor
    calc
      colimit.ι F i x = e.hom (((colimit.ι B i).hom) x) := hx'.symm
      _ = e.hom (((colimit.ι B i).hom) y) := by simpa using congrArg e.hom hxy
      _ = colimit.ι F i y := hy'
  obtain ⟨k, f, g, hfg⟩ := (Types.FilteredColimit.colimit_eq_iff (F := F)).1 hxy'
  have hfg' : F.map f x = F.map f y := by
    simpa [Subsingleton.elim f g] using hfg
  -- In the thin indexing category, both comparison maps to the common stage agree, so the mono
  -- transition map cancels the common image equality.
  exact (ModuleCat.mono_iff_injective _).1 (hB f) <| by
    simpa [F] using hfg'

/-- Helper for Lemma 17.9.7: if all transition morphisms are mono, then every presheaf-colimit
component on sections over an open set is injective. -/
private theorem presheafColimitIotaAppInjectiveOfTransitionMono
    (hmono : ∀ ⦃i i' : I⦄ (f : i ⟶ i'), Mono (ℱ.map f))
    (U : Opens X) (i : I) :
    Function.Injective
      (((colimit.ι (ℱ ⋙ SheafOfModules.forget 𝒪) i).app (op U))) := by
  let P : I ⥤ PresheafOfModules 𝒪.obj := ℱ ⋙ SheafOfModules.forget 𝒪
  let B : I ⥤ ModuleCat.{u} (𝒪.obj.obj (op U)) :=
    P ⋙ PresheafOfModules.evaluation 𝒪.obj (op U)
  let e :
      (PresheafOfModules.evaluation 𝒪.obj (op U)).obj (colimit P) ≅
        colimit B :=
    preservesColimitIso (PresheafOfModules.evaluation 𝒪.obj (op U)) P
  have hB : ∀ ⦃i i' : I⦄ (f : i ⟶ i'), Mono (B.map f) := by
    intro i i' f
    letI : Mono (ℱ.map f) := hmono f
    change Mono (((PresheafOfModules.evaluation 𝒪.obj (op U)).map
      ((SheafOfModules.forget 𝒪).map (ℱ.map f))))
    infer_instance
  letI : Mono (colimit.ι B i) :=
    moduleCat_colimit_iota_mono_of_monoTransitions (I := I) B hB i
  have hmor :
      (PresheafOfModules.evaluation 𝒪.obj (op U)).map (colimit.ι P i) ≫ e.hom =
        colimit.ι B i := by
    simpa [B, P] using
      ι_preservesColimitIso_hom (G := PresheafOfModules.evaluation 𝒪.obj (op U)) (F := P) (j := i)
  intro x y hxy
  have hx' :
      e.hom.hom (((colimit.ι P i).app (op U)) x) = (colimit.ι B i).hom x := by
    simpa [ModuleCat.hom_comp, B, P] using
      LinearMap.congr_fun (congrArg ModuleCat.Hom.hom hmor) x
  have hy' :
      e.hom.hom (((colimit.ι P i).app (op U)) y) = (colimit.ι B i).hom y := by
    simpa [ModuleCat.hom_comp, B, P] using
      LinearMap.congr_fun (congrArg ModuleCat.Hom.hom hmor) y
  have hmonoι :
      Function.Injective ((colimit.ι B i).hom) :=
    (ModuleCat.mono_iff_injective _).1 inferInstance
  exact hmonoι <| by
    calc
      (colimit.ι B i).hom x = e.hom.hom (((colimit.ι P i).app (op U)) x) := hx'.symm
      _ = e.hom.hom (((colimit.ι P i).app (op U)) y) := by simpa using congrArg e.hom.hom hxy
      _ = (colimit.ι B i).hom y := hy'

/-- Helper for Lemma 17.9.7: if all transition morphisms are mono, then every stage coprojection
into the sheaf colimit is mono. -/
private theorem colimitIotaMonoOfTransitionMono
    (hmono : ∀ ⦃i i' : I⦄ (f : i ⟶ i'), Mono (ℱ.map f))
    (i : I) :
    Mono (colimit.ι ℱ i) := by
  let φ := ((SheafOfModules.toSheaf 𝒪).map (colimit.ι ℱ i))
  have hmonoPresheaf : Mono φ.hom := by
    rw [NatTrans.mono_iff_mono_app]
    intro U
    exact (AddCommGrpCat.mono_iff_injective _).2
      (by
        simpa [φ] using
          presheafColimitIotaAppInjectiveOfTransitionMono (ℱ := ℱ) hmono U.unop i)
  letI : Mono φ := (Sheaf.Hom.mono_iff_presheaf_mono _ _ _).2 hmonoPresheaf
  -- Proof comment: once the underlying additive sheaf map is mono, faithfulness reflects mono
  -- back to the `𝒪`-module sheaf morphism.
  exact mono_of_toSheaf_map_mono (𝒪 := 𝒪) (colimit.ι ℱ i)

-- Proof sketch: cover the quasi-compact space by finitely many opens on which the finite type
-- colimit sheaf is generated by finitely many local sections, choose a stage from which each of
-- those generators comes, and then use directedness to dominate all chosen stages at once.
/-- Lemma 17.9.7 (1): for a directed system of `\mathcal O`-module sheaves on a quasi-compact
space, if the colimit sheaf is of finite type, then some stage maps epimorphically onto the
colimit. -/
@[stacks 01BB]
theorem exists_epi_colimit_iota_of_isFiniteType
    : ∃ i : I, Epi (colimit.ι ℱ i) := by
  -- Proof comment: the remaining source-faithful step is now isolated to sheafification.
  -- The unresolved part is exactly the local finite-generator lifting step from the source proof:
  -- around each point, shrink so a finite generating family of `colimit ℱ` lifts to one stage,
  -- deduce a locally epimorphic restriction, and then globalize via compactness and directedness.
  -- TODO for Lemma 17.9.7: realize `colimit ℱ` as the sheafification of the presheaf colimit,
  -- use `hcomparison` and `hcomparison_ι` to lift each generator locally through the
  -- sheafification unit to one stage, choose finitely many neighborhoods by
  -- `exists_finite_subcover_of_pointwise_open`, dominate the resulting stage indices with
  -- `exists_upper_bound_of_finite_family`, and conclude via a finite-cover local epi criterion on
  -- the underlying additive sheaf.
  sorry

-- Proof sketch: apply the epimorphism statement above, then use that a colimit coprojection from a
-- mono directed system is also monic, so the chosen map is both epi and mono and hence an
-- isomorphism.
/-- Lemma 17.9.7 (2): if moreover every transition morphism in the directed system is mono, then
the finite type colimit stabilizes at some stage, i.e. one canonical map `\mathcal F_i \to \colim
\mathcal F_i` is an isomorphism. -/
@[stacks 01BB]
theorem exists_isIso_colimit_iota_of_isFiniteType_of_mono
    (hmono : ∀ ⦃i i' : I⦄ (f : i ⟶ i'), Mono (ℱ.map f)) :
    ∃ i : I, IsIso (colimit.ι ℱ i) := by
  -- First choose a stage whose coprojection is epi by finite generation of the colimit.
  obtain ⟨i, hi⟩ := exists_epi_colimit_iota_of_isFiniteType (ℱ := ℱ)
  letI : Epi (colimit.ι ℱ i) := hi
  -- Proof comment: mono transition maps force every stage coprojection into the colimit to be
  -- mono after checking injectivity on each open-set section module of the underlying presheaf.
  letI : Mono (colimit.ι ℱ i) := colimitIotaMonoOfTransitionMono (ℱ := ℱ) hmono i
  -- In the abelian category of sheaves of modules, a map that is both mono and epi is an iso.
  exact ⟨i, isIso_of_mono_of_epi (colimit.ι ℱ i)⟩

end

end SheafOfModules
