/-- Helper for Lemma 17.25.4: a tensor inverse for `ℒ` induces an invertible stalk module at
every point. -/
private theorem stalkModuleInvertible_of_isInvertible
    (ℒ : ModX) [IsInvertibleX ℒ] (x : X) :
    Module.Invertible (X.presheaf.stalk x) (RingedSpace.stalkModuleCat ℒ x) := by
  -- Route correction: the intended proof is to choose a global tensor inverse for `ℒ`, map it to
  -- the stalk, and then normalize the two endpoints by the stalk tensor comparison and the
  -- unit-stalk equivalence.
  rcases
      (SheafOfModules.RingedSite.isInvertible_iff_exists_tensor_inverse
        (J := Opens.grothendieckTopology X) (𝒪 := X.sheaf) ℒ).1 inferInstance with
    ⟨𝒩, ⟨e⟩⟩
  -- Proof comment: the global tensor inverse descends to a stalkwise tensor-unit isomorphism,
  -- which is exactly the one-sided witness needed for module invertibility over the stalk ring.
  exact Module.Invertible.left
    (stalkTensorUnitIsoOfGlobalTensorInverse (X := X) ℒ 𝒩 x e).toLinearEquiv

/-- Helper for Lemma 17.25.4: over a local stalk ring, an invertible stalk module is free of rank
`1`. -/
private theorem stalkFreeSingleton_of_isInvertible_of_isLocalRing
    (ℒ : ModX) [IsInvertibleX ℒ] (x : X)
    (hlocalx : IsLocalRing (X.presheaf.stalk x)) :
    Nonempty
      (RingedSpace.stalkModuleCat ℒ x ≅
        (ModuleCat.free (X.presheaf.stalk x)).obj (ULift.{u} (Fin 1))) := by
  let _ : IsLocalRing (X.presheaf.stalk x) := hlocalx
  let _ : Module.Invertible (X.presheaf.stalk x) (RingedSpace.stalkModuleCat ℒ x) :=
    stalkModuleInvertible_of_isInvertible (X := X) ℒ x
  let _ : Module.Finite (X.presheaf.stalk x) (RingedSpace.stalkModuleCat ℒ x) := inferInstance
  let _ : Module.Projective (X.presheaf.stalk x) (RingedSpace.stalkModuleCat ℒ x) :=
    inferInstance
  let _ : Module.Free (X.presheaf.stalk x) (RingedSpace.stalkModuleCat ℒ x) :=
    finite_projective_module_free_of_isLocalRing (R := X.presheaf.stalk x)
  rcases
      (Module.Invertible.free_iff_linearEquiv
        (R := X.presheaf.stalk x) (M := RingedSpace.stalkModuleCat ℒ x)).mp inferInstance with
    ⟨e⟩
  -- Proof comment: the local-ring freeness theorem upgrades the invertible stalk module to a free
  -- module, and invertibility forces that free module to have rank `1`.
  exact
    ⟨(e.trans
        (LinearEquiv.funUnique (ULift.{u} (Fin 1))
          (X.presheaf.stalk x) (X.presheaf.stalk x)).symm).toModuleIso⟩

variable [MonoidalCategory (RingedSpace.Modules X)]

omit [MonoidalCategory (RingedSpace.Modules X)] in
theorem hasLocalUnitDichotomy_of_stalk_isLocalRing
    (hlocal : ∀ x : X, IsLocalRing (X.presheaf.stalk x)) :
    HasLocalUnitDichotomy (Opens.grothendieckTopology X) X.sheaf := by
  refine ⟨?_⟩
  intro U f
  let f' : X.presheaf.obj (op U) := f
  let Y : Bool → Opens X := fun
    | false => X.basicOpen f'
    | true => X.basicOpen (1 - f')
  let π : (b : Bool) → Y b ⟶ U := fun
    | false => homOfLE (X.basicOpen_le f')
    | true => homOfLE (X.basicOpen_le (1 - f'))
  let S : (Opens.grothendieckTopology X).Cover U := ⟨Sieve.ofArrows Y π, by
    intro x hxU
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (X.presheaf.germ U x hxU f') with h | h
    · refine ⟨Y false, π false, Sieve.ofArrows_mk Y π false, ?_⟩
      exact (X.mem_basicOpen f' x hxU).2 h
    · refine ⟨Y true, π true, Sieve.ofArrows_mk Y π true, ?_⟩
      exact (X.mem_basicOpen (1 - f') x hxU).2 (by simpa using h)⟩
  refine ⟨S, ?_⟩
  intro I
  change
    IsUnit ((X.presheaf.map I.f.op).hom f') ∨
      IsUnit (1 - (X.presheaf.map I.f.op).hom f')
  rcases (Sieve.mem_ofArrows_iff Y π I.f).1 I.hf with ⟨b, a, ha⟩
  cases b with
  | false =>
      left
      simpa [π, ha] using
        RingHom.isUnit_map ((X.presheaf.map a.op).hom) (X.isUnit_res_basicOpen f')
  | true =>
      right
      have hunit :
          IsUnit ((X.presheaf.map I.f.op).hom (1 - f')) := by
        simpa [π, ha] using
          RingHom.isUnit_map ((X.presheaf.map a.op).hom) (X.isUnit_res_basicOpen (1 - f'))
      simpa [map_sub] using hunit

-- Proof sketch: convert the Chapter 17 point-neighborhood rank-one trivializations to the Chapter
-- 18 opens-site rank-one owner, then apply the canonical ringed-site theorem.
/-- Lemma 17.25.4 (1): a finite locally free `\mathcal O_X`-module of rank `1` on a ringed space
is invertible. -/
@[stacks 0B8M]
theorem isInvertible_of_isFiniteLocallyFreeOfRank_one
    (ℒ : ModX) [SheafOfModules.IsFiniteLocallyFreeOfRank 1 ℒ] :
    IsInvertibleX ℒ := by
  let _ : SiteFiniteLocallyFreeOfRankX 1 ℒ := inferInstance
  infer_instance

-- Proof sketch: the stalk-local-ring hypothesis gives the opens-site local-unit dichotomy by the
-- bridge above. For an invertible sheaf, finite presentation comes from Lemma `17.25.2`, the
-- stalk tensor inverse gives an invertible stalk module, and the local-ring hypothesis upgrades
-- that stalk to a free rank-one module. Lemma `17.11.7` then produces the required local free
-- neighborhoods.
/-- Lemma 17.25.4 (2): if every stalk `\mathcal O_{X, x}` is a local ring, then every invertible
`\mathcal O_X`-module is locally free of rank `1`. -/
@[stacks 0B8M]
theorem isFiniteLocallyFreeOfRank_one_of_isInvertible_of_stalk_isLocalRing
    (hlocal : ∀ x : X, IsLocalRing (X.presheaf.stalk x))
    (ℒ : ModX) [IsInvertibleX ℒ] :
    SheafOfModules.IsFiniteLocallyFreeOfRank 1 ℒ := by
  let _ : ℒ.IsFinitePresentation :=
    SheafOfModules.RingedSite.isFinitePresentation_of_isInvertible
      (J := Opens.grothendieckTopology X) (𝒪 := X.sheaf) ℒ
  refine ⟨?_⟩
  intro x
  -- Proof comment: the stalk helper gives a free rank-one model for `ℒ_x`, so Lemma `17.11.7`
  -- upgrades that stalkwise model to an actual neighborhood trivialization.
  exact SheafOfModules.exists_open_neighborhood_free_over_of_stalk_free
    (ℱ := ℒ) x 1
    (stalkFreeSingleton_of_isInvertible_of_isLocalRing (X := X) ℒ x (hlocal x))

end AlgebraicGeometry.RingedSpace
