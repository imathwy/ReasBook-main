/-- Helper for Lemma 17.25.4: the sieve on `U` generated by a slice-site family
`fun i ↦ Over.mk (π i)` is exactly the ordinary sieve generated by the arrows `π i`. -/
private theorem overSieveOfObjectsEqOfArrows
    {U : Opens X} {ι : Type*} (V : ι → Opens X) (π : ∀ i, V i ⟶ U) :
    (Sieve.overEquiv (Over.mk (𝟙 U)))
        (Sieve.ofObjects (fun i ↦ Over.mk (π i)) (Over.mk (𝟙 U))) =
      Sieve.ofArrows (fun i ↦ V i) π := by
  -- Proof comment: a factorization in the slice over `U` is exactly the same factorization in the
  -- base site once we forget the over-structure.
  ext W g
  constructor
  · intro hg
    rw [Sieve.overEquiv_iff] at hg
    rw [Sieve.mem_ofObjects_iff] at hg
    rcases hg with ⟨i, ⟨a⟩⟩
    rw [Sieve.mem_ofArrows_iff]
    exact ⟨i, a.left, by simpa using a.w⟩
  · intro hg
    rw [Sieve.overEquiv_iff]
    rw [Sieve.mem_ofArrows_iff] at hg
    rcases hg with ⟨i, a, ha⟩
    rw [Sieve.mem_ofObjects_iff]
    exact ⟨i, ⟨Over.homMk a (by simpa using ha)⟩⟩

private theorem overOpenCoverCoversTop
    {U : Opens X} {ι : Type*} (V : ι → Opens X) (π : ∀ i, V i ⟶ U)
    (hV : ∀ x ∈ U, ∃ i, x ∈ V i) :
    ((Opens.grothendieckTopology X).over U).CoversTop (fun i ↦ Over.mk (π i)) := by
  -- Proof comment: rewrite the slice covering condition to the ordinary sieve generated by the
  -- underlying arrows, then use the pointwise cover hypothesis.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal
    (J := (Opens.grothendieckTopology X).over U)
    (Over.mk (𝟙 U)) Over.mkIdTerminal]
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows]
  intro x hxU
  rcases hV x hxU with ⟨i, hxi⟩
  exact ⟨V i, π i, Sieve.ofArrows_mk V π i, hxi⟩

/-- Helper for Lemma 17.25.4: a slice-site cover of `⊤` contains a member whose underlying open
contains any chosen point of `X`. -/
private theorem pointMemOfCoversTopOverTop
    {ι : Type*} (U : ι → Over (⊤ : Opens X))
    (hU : ((Opens.grothendieckTopology X).over (⊤ : Opens X)).CoversTop U)
    (x : X) :
    ∃ i, x ∈ (U i).left := by
  -- Proof comment: convert the slice-site cover of `⊤` to the ordinary sieve generated by the
  -- underlying open inclusions and use the resulting pointwise cover condition.
  have hsieve :
      (Sieve.overEquiv (Over.mk (𝟙 (⊤ : Opens X))))
          (Sieve.ofObjects U (Over.mk (𝟙 (⊤ : Opens X)))) =
        Sieve.ofArrows (fun i ↦ (U i).left) (fun i ↦ (U i).hom) := by
    ext W g
    constructor
    · intro hg
      rw [Sieve.overEquiv_iff] at hg
      rw [Sieve.mem_ofObjects_iff] at hg
      rcases hg with ⟨i, ⟨a⟩⟩
      rw [Sieve.mem_ofArrows_iff]
      exact ⟨i, a.left, by simpa using a.w⟩
    · intro hg
      rw [Sieve.overEquiv_iff]
      rw [Sieve.mem_ofArrows_iff] at hg
      rcases hg with ⟨i, a, ha⟩
      rw [Sieve.mem_ofObjects_iff]
      exact ⟨i, ⟨Over.homMk a (by simpa using ha)⟩⟩
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal
    (J := (Opens.grothendieckTopology X).over (⊤ : Opens X))
    (Over.mk (𝟙 (⊤ : Opens X))) Over.mkIdTerminal] at hU
  rw [GrothendieckTopology.mem_over_iff, hsieve] at hU
  rcases hU x (by trivial) with ⟨W, f, hf, hxW⟩
  rw [Sieve.mem_ofArrows_iff] at hf
  rcases hf with ⟨i, a, ha⟩
  exact ⟨i, a.le hxW⟩

private theorem restrictIsoFree
    (ℒ : ModX) (r : ℕ) {U V : Opens X} (hVU : V ≤ U)
    (e : ℒ.over U ≅
      (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
        SheafOfModules ((RingedSpace.ringCatSheaf X).over U))) :
    Nonempty
      (ℒ.over V ≅
        (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
          SheafOfModules ((RingedSpace.ringCatSheaf X).over V))) := by
  let i : Over U := Over.mk (homOfLE hVU)
  -- Proof comment: first restrict the given trivialization to the iterated slice over `i`.
  have hiter :
      Nonempty
        (((ℒ.over U).over i) ≅
          (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
            SheafOfModules (((RingedSpace.ringCatSheaf X).over U).over i))) := by
    let restrictedIso :=
      (SheafOfModules.pushforward
        (𝟙 (((RingedSpace.ringCatSheaf X).over U).over i))).mapIso e
    -- Proof comment: the iterated restriction functor is `over i`, so the transported iso is
    -- exactly a trivialization on `((ℒ.over U).over i)`.
    exact ⟨by simpa [i, SheafOfModules.over, ringedSiteLocalizedRestriction] using restrictedIso⟩
  -- Proof comment: then convert the iterated slice spelling back to the ordinary restriction.
  exact (iteratedRestrictionIsoFree_iff (X := X) ℒ r (U := U) (I := i)).1 hiter

/-- Helper for Lemma 17.25.4: the iterated slice module category over `U` and `I` is canonically
equivalent to the ordinary slice module category over `I.left`. -/
private noncomputable def iteratedRestrictionEquivalence
    {U : Opens X} (I : Over U) :
    SheafOfModules (((RingedSpace.ringCatSheaf X).over U).over I) ≌
      SheafOfModules ((RingedSpace.ringCatSheaf X).over I.left) :=
  pushforwardPushforwardEquivalence (Over.iteratedSliceEquiv I)
    (S := ((RingedSpace.ringCatSheaf X).over U).over I)
    (R := (RingedSpace.ringCatSheaf X).over I.left)
    (𝟙 _) (𝟙 _)
    (by ext : 2; exact X.sheaf.1.map_id _)
    (by ext : 2; exact X.sheaf.1.map_id _)

/-- Helper for Lemma 17.25.4: under the canonical iterated-slice equivalence, the free rank-`r`
module on the iterated slice corresponds to the free rank-`r` module on the underlying open. -/
private theorem iteratedRestrictionFreeIso
    (r : ℕ) {U : Opens X} (I : Over U) :
    (((SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
          SheafOfModules (((RingedSpace.ringCatSheaf X).over U).over I)))
        ≅
      (iteratedRestrictionEquivalence (X := X) I).functor.obj
        (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
          SheafOfModules ((RingedSpace.ringCatSheaf X).over I.left))) := by
  -- Proof comment: the equivalence is induced by identity maps on the restricted ring sheaves, so
  -- the free module with the same basis transports unchanged.
  simpa [iteratedRestrictionEquivalence]
    using ((iteratedRestrictionEquivalence (X := X) I).unitIso.app
      (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
        SheafOfModules ((RingedSpace.ringCatSheaf X).over I.left))).symm

/-- Helper for Lemma 17.25.4: a rank-`r` trivialization on an iterated restriction
`((ℒ.over U).over I)` is equivalent to a rank-`r` trivialization on the ordinary restriction
`ℒ.over I.left`. -/
private theorem iteratedRestrictionIsoFree_iff
    (ℒ : ModX) (r : ℕ) {U : Opens X} {I : Over U} :
    Nonempty
      (((ℒ.over U).over I) ≅
        (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
          SheafOfModules (((RingedSpace.ringCatSheaf X).over U).over I))) ↔
      Nonempty
        (ℒ.over I.left ≅
          (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
            SheafOfModules ((RingedSpace.ringCatSheaf X).over I.left))) := by
  let e := iteratedRestrictionEquivalence (X := X) I
  constructor
  · intro h
    rcases h with ⟨hiso⟩
    -- Proof comment: move the trivialization across the canonical equivalence from the iterated
    -- slice to the ordinary slice, then normalize both endpoints.
    refine ⟨?_⟩
    simpa [e, iteratedRestrictionEquivalence] using
      (e.inverse.mapIso (hiso ≪≫ iteratedRestrictionFreeIso (X := X) r I))
  · intro h
    rcases h with ⟨hiso⟩
    -- Proof comment: transport the ordinary-slice trivialization back to the iterated slice and
    -- compose with the free-side comparison in the opposite direction.
    refine ⟨?_⟩
    simpa [e, iteratedRestrictionEquivalence] using
      (e.functor.mapIso hiso ≪≫ iteratedRestrictionFreeIso (X := X) r I).symm

/-- Helper for Lemma 17.25.4: a rank-`r` trivialization on a slice object over `⊤` simplifies to
the corresponding ordinary trivialization on its underlying open. -/
private theorem topSliceIsoFreeToOpen
    (ℒ : ModX) (r : ℕ) {I : Over (⊤ : Opens X)}
    (e : Nonempty
      (((ℒ.over (⊤ : Opens X)).over I) ≅
        (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
          SheafOfModules (((RingedSpace.ringCatSheaf X).over (⊤ : Opens X)).over I)))) :
    Nonempty
      (ℒ.over I.left ≅
        (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
          SheafOfModules ((RingedSpace.ringCatSheaf X).over I.left))) := by
  exact (iteratedRestrictionIsoFree_iff (X := X) ℒ r (U := ⊤) (I := I)).1 e

private instance siteFiniteLocallyFreeOfRank_of_isFiniteLocallyFreeOfRank
    (r : ℕ) (ℒ : ModX) [SheafOfModules.IsFiniteLocallyFreeOfRank r ℒ] :
    SiteFiniteLocallyFreeOfRankX r ℒ where
  exists_iso_free_over U := by
    classical
    -- Proof comment: choose a rank-`r` trivialization around each point of `U`, refine it to the
    -- intersection with `U`, and package those refinements as a slice-site cover.
    let h : SheafOfModules.IsFiniteLocallyFreeOfRank r ℒ := inferInstance
    choose V hV eV using
      fun x : U ↦ h.exists_open_neighborhood_iso_free x.1
    let W : U → Over U := fun x ↦
      Over.mk (homOfLE (show U ⊓ V x ≤ U from inf_le_left))
    refine ⟨U, W, ?_, ?_⟩
    · refine overOpenCoverCoversTop (X := X) (U := U) (V := fun x : U ↦ U ⊓ V x)
        (π := fun x : U ↦ homOfLE (show U ⊓ V x ≤ U from inf_le_left)) ?_
      intro x hxU
      refine ⟨⟨x, hxU⟩, ?_⟩
      exact ⟨hxU, hV ⟨x, hxU⟩⟩
    · intro x
      rcases eV x with ⟨e⟩
      -- Proof comment: the chosen trivialization over `V x` restricts to the refinement
      -- `U ∩ V x`, which is exactly the slice object indexed by `x`.
      exact (iteratedRestrictionIsoFree_iff (X := X) ℒ r (U := U) (I := W x)).2
        (restrictIsoFree (X := X) ℒ r (U := V x) (V := U ⊓ V x) inf_le_right e)

private theorem isFiniteLocallyFreeOfRank_of_siteFiniteLocallyFreeOfRank
    (r : ℕ) (ℒ : ModX) [SiteFiniteLocallyFreeOfRankX r ℒ] :
    SheafOfModules.IsFiniteLocallyFreeOfRank r ℒ := by
  refine ⟨?_⟩
  intro x
  let h : SiteFiniteLocallyFreeOfRankX r ℒ := inferInstance
  rcases h.exists_iso_free_over (⊤ : Opens X) with ⟨I, U, hU, hfree⟩
  -- Proof comment: specialize the site-level cover at `⊤`, extract one member containing `x`,
  -- and then simplify the iterated restriction back to an ordinary neighborhood trivialization.
  rcases pointMemOfCoversTopOverTop (X := X) U hU x with ⟨i, hxi⟩
  -- Route correction: use a dedicated adapter for the `⊤`-slice simplification instead of asking
  -- `simpa` to normalize the iterated restriction directly in the main proof.
  refine ⟨(U i).left, hxi, ?_⟩
  exact topSliceIsoFreeToOpen (X := X) ℒ r (I := U i) (hfree i)

/-- Helper for Lemma 17.25.4: a local rank-`r` trivialization around `x` yields the corresponding
free rank-`r` stalk module at `x`. -/
private theorem stalkFreeIsoOfLocalTrivialization
    (ℒ : ModX) (r : ℕ) {U : Opens X} {x : X} (hx : x ∈ U)
    (e : ℒ.over U ≅
      (SheafOfModules.free.{u} (ULift.{u} (Fin r)) :
        SheafOfModules ((RingedSpace.ringCatSheaf X).over U))) :
    Nonempty
      (RingedSpace.stalkModuleCat ℒ x ≅
        (ModuleCat.free (X.presheaf.stalk x)).obj (ULift.{u} (Fin r))) := by
  let XU : RingedSpace := X.restrict U.isOpenEmbedding
  let j : XU ⟶ X := X.ofRestrict U.isOpenEmbedding
  let xU : XU := ⟨x, hx⟩
  let eOver :
      ((RingedSpace.Hom.pullback j).obj ℒ) ≅
        (SheafOfModules.free.{u} (ULift.{u} (Fin r)) : XU.Modules) := by
    -- Proof comment: rewrite the slice restriction `ℒ.over U` as the actual pullback to the
    -- restricted ringed space `X|_U`.
    simpa [SheafOfModules.over, RingedSpace.Hom.pullback] using e
  let eStalk :
      RingedSpace.stalkModuleCat ((RingedSpace.Hom.pullback j).obj ℒ) xU ≅
        RingedSpace.stalkModuleCat
          (SheafOfModules.free.{u} (ULift.{u} (Fin r)) : XU.Modules) xU :=
    (RingedSpace.stalkModuleFunctor (X := XU) xU).mapIso eOver
  -- Proof comment: transfer the neighborhood trivialization to the stalk and then transport
  -- back along the canonical pullback/stalk comparison for the open immersion `j`.
  exact ⟨(RingedSpace.Hom.pullbackStalkIso j ℒ xU).symm ≪≫ by simpa using eStalk⟩

