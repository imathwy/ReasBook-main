variable {D : Type u₁} [Category.{v₁} D] [HasShift D ℤ]
variable {A : Type u₂} [Category.{v₂} A] [Abelian A]
variable (H : D ⥤ A) [H.ShiftSequence ℤ]

omit [Abelian A] in
/-- Helper for Lemma 13.35.8: enlarging the allowed interval preserves exact interval vanishing. -/
lemma shiftVanishingIn_mono
    {l u l' u' : ℤ} (hl : l' ≤ l) (hu : u ≤ u') :
    H.shiftVanishingIn l u ≤ H.shiftVanishingIn l' u' := by
  intro X hX
  rw [H.mem_shiftVanishingIn_iff] at hX ⊢
  -- Any degree outside the larger interval is automatically outside the smaller one.
  intro i hi
  exact hX i (by
    intro hi'
    exact hi ⟨le_trans hl hi'.1, le_trans hi'.2 hu⟩)

omit [Abelian A] in
/-- Helper for Lemma 13.35.8: vanishing for a shifted object translates to the correspondingly
shifted interval on the original object. -/
lemma shiftVanishingIn_of_shift
    {X : D} {a b k : ℤ}
    (hX : H.shiftVanishingIn a b (X⟦k⟧)) :
    H.shiftVanishingIn (a + k) (b + k) X := by
  rw [H.mem_shiftVanishingIn_iff] at hX ⊢
  intro i hi
  have hik : i - k ∉ Set.Icc a b := by
    intro hik'
    apply hi
    have hk_left : a ≤ i - k := hik'.1
    have hk_right : i - k ≤ b := hik'.2
    constructor <;> omega
  -- Transport vanishing from `X⟦k⟧` back to `X` using the canonical shift-additivity isomorphism.
  simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
    (hX (i - k) hik).of_iso
      (((H.shiftIso k (i - k) i (by omega)).app X).symm)

/-- Helper for Lemma 13.35.8: exact interval vanishing is stable under retracts. -/
instance shiftVanishingIn_isStableUnderRetracts (a b : ℤ) :
    (H.shiftVanishingIn a b).IsStableUnderRetracts where
  of_retract r hY := by
    rw [H.mem_shiftVanishingIn_iff] at hY ⊢
    -- Retracts preserve zero objects after applying any shifted functor `H.shift i`.
    intro i hi
    letI : IsSplitMono ((H.shift i).map r.i) :=
      ⟨⟨(r.map (H.shift i)).splitMono⟩⟩
    exact (IsZero.iff_isSplitMono_eq_zero ((H.shift i).map r.i)).2
      ((hY i hi).eq_of_tgt _ _)

/-- Bridge/view companion to Lemma 13.35.8 at the interval-owner level: if `H^i(E) = 0` for every
`E ∈ \mathcal E` and every `i ∉ [a, b]`, then every shift of an object of `\mathcal E` by an
integer in `[c, d]` lies in the translated exact interval-vanishing property
`H.shiftVanishingIn (a + c) (b + d)`. -/
theorem shiftInterval_le_shiftVanishingIn
    (E : ObjectProperty D) (a b c d : ℤ)
    (hE : E ≤ H.shiftVanishingIn a b) :
    E[c, d] ≤ H.shiftVanishingIn (a + c) (b + d) := by
  intro X hX
  rw [prop_shiftInterval_iff] at hX
  rcases hX with ⟨k, hk, hX⟩
  rw [ObjectProperty.prop_isoClosure_iff] at hX
  rcases hX with ⟨Y, hY, ⟨e⟩⟩
  rw [ObjectProperty.prop_shift_iff] at hY
  -- First recover the exact interval for the chosen shifted generator `Y`.
  have hYk : H.shiftVanishingIn (a + k) (b + k) Y := by
    exact shiftVanishingIn_of_shift H (hE _ hY)
  -- Then enlarge from the specific shift `k` to the whole interval `[c, d]`.
  have hYcd : H.shiftVanishingIn (a + c) (b + d) Y := by
    have hk_left : c ≤ k := hk.1
    have hk_right : k ≤ d := hk.2
    exact
      shiftVanishingIn_mono
        (H := H) (l := a + k) (u := b + k) (l' := a + c) (u' := b + d)
        (by omega) (by omega) _ hYk
  -- Finally transport along the isomorphism hidden in `shiftInterval`.
  simpa using (H.shiftVanishingIn (a + c) (b + d)).prop_of_iso e.symm hYcd

end

section

variable {D : Type u₁} [Category.{v₁} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, Functor.Additive (shiftFunctor D n)] [Pretriangulated D]
variable {A : Type u₂} [Category.{v₂} A] [Abelian A]
variable (H : D ⥤ A) [H.IsHomological] [H.ShiftSequence ℤ]

/-- Helper for Lemma 13.35.8: exact interval vanishing contains a zero object. -/
instance shiftVanishingIn_containsZero (a b : ℤ) :
    (H.shiftVanishingIn a b).ContainsZero where
  exists_zero := by
    refine ⟨(0 : D), isZero_zero D, ?_⟩
    rw [H.mem_shiftVanishingIn_iff]
    -- The shifted image of a zero object is again zero.
    intro i hi
    simpa using (H.shift i).map_isZero (isZero_zero D)

/-- Helper for Lemma 13.35.8: exact interval vanishing satisfies the middle-object
two-out-of-three property for distinguished triangles. -/
instance shiftVanishingIn_isTriangulatedClosed₂ (a b : ℤ) :
    (H.shiftVanishingIn a b).IsTriangulatedClosed₂ := by
  refine ObjectProperty.IsTriangulatedClosed₂.mk' ?_
  intro T hT h₁ h₃
  rw [H.mem_shiftVanishingIn_iff] at h₁ h₃ ⊢
  -- Apply homological exactness after shifting the distinguished triangle degreewise.
  intro i hi
  let e₁ : H.obj ((shiftFunctor D i).obj T.obj₁) ≅ (H.shift i).obj T.obj₁ :=
    (H.isoShift i).app T.obj₁
  let e₂ : H.obj ((shiftFunctor D i).obj T.obj₂) ≅ (H.shift i).obj T.obj₂ :=
    (H.isoShift i).app T.obj₂
  let e₃ : H.obj ((shiftFunctor D i).obj T.obj₃) ≅ (H.shift i).obj T.obj₃ :=
    (H.isoShift i).app T.obj₃
  have h₁' : IsZero (H.obj ((shiftFunctor D i).obj T.obj₁)) := by
    exact (h₁ i hi).of_iso e₁
  have h₃' : IsZero (H.obj ((shiftFunctor D i).obj T.obj₃)) := by
    exact (h₃ i hi).of_iso e₃
  -- The shifted distinguished triangle gives the needed exact short complex in degree `i`.
  have h₂' : IsZero (H.obj ((shiftFunctor D i).obj T.obj₂)) := by
    exact
      (H.map_distinguished_exact _ (Triangle.shift_distinguished T hT i)).isZero_of_both_zeros
        (h₁'.eq_of_src _ _) (h₃'.eq_of_tgt _ _)
  simpa using h₂'.of_iso e₂.symm

/-- Helper for Lemma 13.35.8: exact interval vanishing is closed under binary coproducts. -/
instance shiftVanishingIn_isClosedUnderBinaryCoproducts (a b : ℤ) :
    (H.shiftVanishingIn a b).IsClosedUnderBinaryCoproducts where
  colimitsOfShape_le := by
    rintro X ⟨p⟩
    let X₁ := p.diag.obj (.mk .left)
    let X₂ := p.diag.obj (.mk .right)
    let B : BinaryCofan X₁ X₂ := BinaryCofan.mk (p.ι.app (.mk .left)) (p.ι.app (.mk .right))
    have hB : IsColimit B := by
      let hp := ((IsColimit.precomposeHomEquiv (diagramIsoPair p.diag).symm p.cocone).2 p.isColimit)
      simpa [B, BinaryCofan.inl, BinaryCofan.inr] using
        (IsColimit.ofIsoColimit hp (isoBinaryCofanMk _))
    have e : X ≅ X₁ ⨿ X₂ := by
      simpa [B] using hB.coconePointUniqueUpToIso (coprodIsCoprod X₁ X₂)
    -- Replace the generic coproduct presentation by the canonical biproduct triangle.
    refine (H.shiftVanishingIn a b).prop_of_iso (biprod.isoCoprod X₁ X₂ ≪≫ e.symm) ?_
    exact
      (H.shiftVanishingIn a b).ext_of_isTriangulatedClosed₂
        (binaryBiproductTriangle X₁ X₂)
        (binaryBiproductTriangle_distinguished X₁ X₂)
        (p.prop_diag_obj (.mk .left))
        (p.prop_diag_obj (.mk .right))

/-- Helper for Lemma 13.35.8: exact interval vanishing is closed under finite coproducts. -/
instance shiftVanishingIn_isClosedUnderFiniteCoproducts (a b : ℤ) :
    (H.shiftVanishingIn a b).IsClosedUnderFiniteCoproducts := by
  letI : (H.shiftVanishingIn a b).ContainsZero := shiftVanishingIn_containsZero (H := H) a b
  letI : (H.shiftVanishingIn a b).IsClosedUnderBinaryCoproducts :=
    shiftVanishingIn_isClosedUnderBinaryCoproducts (H := H) a b
  exact ObjectProperty.IsClosedUnderFiniteCoproducts.mk' (P := H.shiftVanishingIn a b)

/-- Helper for Chap13 Lemma 13 35 8: once a property lies inside a concrete exact
interval-vanishing owner, every additive extension stage generated from it stays inside the same
owner. -/
private theorem additiveExtensionStage_le_shiftVanishingIn
    {P : ObjectProperty D} {l u : ℤ}
    (hP : P ≤ H.shiftVanishingIn l u) (n : ℕ+) :
    additiveExtensionStage P n ≤ H.shiftVanishingIn l u := by
  -- Proof comment: specialize the canonical stage-closure argument to the concrete target
  -- `H.shiftVanishingIn l u` so the local closure instances are fixed before elaboration.
  rw [additiveExtensionStage, retractClosure_le_iff]
  exact P.additiveClosure.extensionProductIter_le_of_isTriangulatedClosed₂
    (by
      -- Proof comment: finite coproduct closure of `H.shiftVanishingIn l u` is exactly what
      -- `colimitsClosure_le` needs to promote the base inclusion to additive closure.
      refine colimitsClosure_le ?_
      exact hP)
    n.natPred

omit [HasZeroObject D] [∀ n : ℤ, Functor.Additive (shiftFunctor D n)] [Pretriangulated D]
  [H.IsHomological] in
/-- Helper for Chap13 Lemma 13 35 8: the stage-dependent interval
`[((n : ℤ) * a) + c, ((n : ℤ) * b) + d]` contains the basic translated interval `[a + c, b + d]`
when `a ≤ 0 ≤ b`. -/
private theorem shiftInterval_le_shiftVanishingIn_stageBounds
    (E : ObjectProperty D) (a b c d : ℤ)
    (ha : a ≤ 0) (hb : 0 ≤ b)
    (hE : E ≤ H.shiftVanishingIn a b)
    (n : ℕ+) :
    E[c, d] ≤ H.shiftVanishingIn ((n : ℤ) * a + c) ((n : ℤ) * b + d) := by
  -- Proof comment: first move `E[c,d]` into the exact translated interval `[a + c, b + d]`.
  have hbase : E[c, d] ≤ H.shiftVanishingIn (a + c) (b + d) :=
    shiftInterval_le_shiftVanishingIn H E a b c d hE
  have hnNat : 1 ≤ (n : ℕ) := Nat.succ_le_of_lt n.2
  have hn : (1 : ℤ) ≤ (n : ℤ) := by
    exact_mod_cast hnNat
  have hnSub : 0 ≤ (n : ℤ) - 1 := sub_nonneg.mpr hn
  have hleft : ((n : ℤ) * a) + c ≤ a + c := by
    have hmul : ((n : ℤ) - 1) * a ≤ 0 :=
      mul_nonpos_of_nonneg_of_nonpos hnSub ha
    have hdecomp : (n : ℤ) * a = a + ((n : ℤ) - 1) * a := by
      ring
    linarith
  have hright : b + d ≤ ((n : ℤ) * b) + d := by
    have hmul : 0 ≤ ((n : ℤ) - 1) * b :=
      mul_nonneg hnSub hb
    have hdecomp : (n : ℤ) * b = b + ((n : ℤ) - 1) * b := by
      ring
    linarith
  -- Proof comment: enlarge the allowed vanishing interval using monotonicity in the bounds.
  exact hbase.trans <|
    shiftVanishingIn_mono
      (H := H) (l := a + c) (u := b + d)
      (l' := ((n : ℤ) * a) + c) (u' := ((n : ℤ) * b) + d)
      hleft hright

/-- Bridge/view companion to Lemma 13.35.8: if `H^i(E) = 0` for every `E ∈ \mathcal E` and every
`i ∉ [a, b]`, then for any shift interval `[c, d]` the entire stage
`smd(add(\mathcal E[c,d])^{\star n})` is contained in the exact interval-vanishing object
property `H.shiftVanishingIn (n * a + c) (n * b + d)`. -/
theorem additiveExtensionStage_shiftInterval_le_of_bounds
    (E : ObjectProperty D) (a b c d : ℤ)
    (ha : a ≤ 0) (hb : 0 ≤ b)
    (hE : E ≤ H.shiftVanishingIn a b)
    (n : ℕ+) :
    additiveExtensionStage (E[c, d]) n ≤
      H.shiftVanishingIn ((n : ℤ) * a + c) ((n : ℤ) * b + d) := by
  -- Route correction: avoid a manual induction on the extension power. The canonical owner-level
  -- stage lemma already lifts a single inclusion `E[c,d] ≤ Q` through additive closure, extension
  -- products, and retract closure.
  have hstage :
      E[c, d] ≤ H.shiftVanishingIn ((n : ℤ) * a + c) ((n : ℤ) * b + d) :=
    shiftInterval_le_shiftVanishingIn_stageBounds H E a b c d ha hb hE n
  -- Proof comment: apply the generic stage-closure lemma to the target vanishing property.
  exact additiveExtensionStage_le_shiftVanishingIn (H := H) hstage n

/-- Lemma 13.35.8, source-facing symmetric-interval form: if `H^i(E) = 0` for every
`E ∈ \mathcal E` and every `i ∉ [a, b]`, then the
entire stage `smd(add(\mathcal E[-m, m])^{\star n})` is contained in the exact interval-vanishing
object property `H.shiftVanishingIn (n * a - m) (n * b + m)`. Here the textbook power
`\star n` is encoded by the Chapter 13 owner `additiveExtensionStage`, so `n` is taken as a
positive natural number. -/
@[stacks 0FX8]
theorem additiveExtensionStage_shiftInterval_le
    (E : ObjectProperty D) (a b : ℤ)
    (ha : a ≤ 0) (hb : 0 ≤ b)
    (hE : E ≤ H.shiftVanishingIn a b)
    (m : ℕ) (n : ℕ+) :
    additiveExtensionStage (E[-(m : ℤ), m]) n ≤
      H.shiftVanishingIn ((n : ℤ) * a - m) ((n : ℤ) * b + m) := by
  simpa [sub_eq_add_neg] using
    additiveExtensionStage_shiftInterval_le_of_bounds H E a b (-(m : ℤ)) m ha hb hE n

end

end Functor
