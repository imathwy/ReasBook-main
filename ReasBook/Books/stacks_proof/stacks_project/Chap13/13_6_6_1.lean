/-
Item 13.6.6.1 identifies the textbook multiplicative system `S` with the canonical owner
`P.isoClosure.trW`. Concretely, `S` consists of the arrows that fit into a distinguished triangle
whose third object is isomorphic to an object of the full subcategory encoded by `P`; the
specification theorem `P.isoClosure.trW_iff` is companion API for this owner.
-/
#check P.isoClosure.trW

/- Companion recall: `P.isoClosure.trW_iff` is the source-facing unpacking of the canonical owner
`P.isoClosure.trW`. -/
#check P.isoClosure.trW_iff

/-- 13.6.6.1: the canonical owner `P.isoClosure.trW` matches the source description of arrows
that appear in a distinguished triangle whose third object is isomorphic to an object cut out by
`P`. -/
@[stacks 05RH]
theorem isoClosure_trW_iff_exists_distinguished_triangle
    {X Y : D} (f : X ⟶ Y) :
    P.isoClosure.trW f ↔
      ∃ (Z : D) (g : Y ⟶ Z) (h : Z ⟶ X⟦(1 : ℤ)⟧),
        Pretriangulated.Triangle.mk f g h ∈ Pretriangulated.distinguishedTriangles ∧
          P.isoClosure Z := by
  -- Route correction: keep the proof on the canonical owner and unpack the source-facing
  -- distinguished triangle description directly from `P.isoClosure.trW_iff`.
  simpa using (P.isoClosure.trW_iff (f := f))

/- Bridge recall: passing from `P` to `P.isoClosure` does not change the associated Verdier
morphism property of arrows whose cone lies in the subcategory. -/
recall trW_isoClosure

end

