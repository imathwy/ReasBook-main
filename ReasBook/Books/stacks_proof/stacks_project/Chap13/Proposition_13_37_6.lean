section

variable {D : Type u} [Category.{v} D] [HasShift D ℤ] [Preadditive D]
  [HasCoproducts.{max u v} D]

-- Proof sketch: a compact weak generator already gives the compact-generation witness with the
-- singleton family `fun _ : Unit ↦ E`.
/-- A compact weak generator compactly generates the ambient triangulated category. -/
theorem isCompactlyGenerated_of_isWeakGenerator
    (E : D) (hE : IsCompactObject E) (hweak : IsWeakGenerator E) :
    IsCompactlyGenerated D := by
  rw [isCompactlyGenerated_iff_exists_compact_generatingFamily]
  refine ⟨ULift.{max u v, 0} PUnit, fun _ ↦ E, ?_, ?_⟩
  · intro _
    simpa using hE
  · rw [IsGeneratingFamily]
    have hweak' : ((singleton E).shiftClosure ℤ).rightOrthogonal = IsZero :=
      (isWeakGenerator_iff_rightOrthogonal_shifts_eq_isZero E).1 hweak
    have hofObj :
        ofObj (fun _ : ULift.{max u v, 0} PUnit ↦ E) = singleton E := by
      ext X
      rw [ofObj_iff, singleton_iff]
      constructor
      · rintro ⟨i, hi⟩
        simpa using hi
      · intro hX
        exact ⟨⟨PUnit.unit⟩, hX⟩
    simpa [hofObj] using hweak'

end

section

variable {D : Type u} [Category.{v} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [HasCoproducts.{max u v} D]
  [IsTriangulated D]

/-- Helper for Proposition 13.37.6: an object of the compact subcategory that is generated by
`E` inside `D_c(D)` is also generated by `E` in the ambient category. -/
theorem mem_generated_ambient_of_mem_generated_compactObjects
    {E : D} (hE : IsCompactObject E) {X : D_c(D)}
    (hX : ⟨(⟨E, hE⟩ : D_c(D))⟩ X) :
    ⟨E⟩ X.obj := by
  let ιc : D_c(D) ⥤ D := ObjectProperty.ι (IsCompactObject : ObjectProperty D)
  let P : ObjectProperty (D_c(D)) := (⟨E⟩).inverseImage ιc
  letI : P.IsTriangulated := inferInstance
  -- The ambient generated property restricts to a saturated triangulated property on `D_c(D)`.
  have hle : ⟨(⟨E, hE⟩ : D_c(D))⟩ ≤ P := by
    refine objectGeneratedProperty_le_of_mem (⟨E, hE⟩ : D_c(D)) P ?_
    simpa [P, ιc] using objectGeneratedProperty_contains E
  simpa [P, ιc] using hle X hX

/-- Helper for Proposition 13.37.6: a finite coproduct of copies of `E` already lies in the
ambient triangulated subcategory generated by `E`. -/
theorem finite_coproduct_of_generator_mem_generated
    (E : D) {J : Type (max u v)} [Finite J] :
    ⟨E⟩ (∐ fun _ : J ↦ E) := by
  let P : ObjectProperty D := ⟨E⟩
  -- The generated property is triangulated, hence closed under finite coproducts.
  let _ : P.IsClosedUnderBinaryCoproducts := inferInstance
  let _ : P.IsClosedUnderFiniteCoproducts := ObjectProperty.IsClosedUnderFiniteCoproducts.mk'
  simpa [P] using P.prop_coproduct (fun _ : J ↦ objectGeneratedProperty_contains E)

/-- Helper for Proposition 13.37.6: an object generated by a finite coproduct of copies of `E`
is already generated by `E` itself. -/
theorem generated_by_finite_coproduct_of_single_generator
    {E A : D} {J : Type (max u v)} [Finite J]
    (hA : ⟨∐ fun _ : J ↦ E⟩ A) :
    ⟨E⟩ A := by
  -- The finite coproduct belongs to `⟨E⟩`, so minimality of the generated property upgrades
  -- membership from `⟨∐ E⟩` to `⟨E⟩`.
  have hcoprod : ⟨E⟩ (∐ fun _ : J ↦ E) := finite_coproduct_of_generator_mem_generated E
  have hle : ⟨∐ fun _ : J ↦ E⟩ ≤ ⟨E⟩ :=
    objectGeneratedProperty_le_of_mem (∐ fun _ : J ↦ E) (⟨E⟩) hcoprod
  exact hle A hA

/-- Helper for Proposition 13.37.6: an ambient isomorphism between compact objects lifts to an
isomorphism in the compact full subcategory. -/
noncomputable def compact_subcategory_iso_of_iso
    {X Y : D} (hX : IsCompactObject X) (hY : IsCompactObject Y) (e : X ≅ Y) :
    (⟨X, hX⟩ : D_c(D)) ≅ (⟨Y, hY⟩ : D_c(D)) :=
  ObjectProperty.isoMk (P := (IsCompactObject : ObjectProperty D)) e

/-- Helper for Proposition 13.37.6: if a compact object is generated by `E` in the ambient
category, then it is generated by `E` inside the compact subcategory. -/
theorem mem_generated_compactObjects_of_mem_generated_ambient
    {E X : D} (hE : IsCompactObject E) (hX : IsCompactObject X)
    (h : ⟨E⟩ X) :
    ⟨(⟨E, hE⟩ : D_c(D))⟩ (⟨X, hX⟩ : D_c(D)) := by
  let Pgen : ObjectProperty (D_c(D)) := ⟨(⟨E, hE⟩ : D_c(D))⟩
  let ιc : D_c(D) ⥤ D := ObjectProperty.ι (IsCompactObject : ObjectProperty D)
  let Q : ObjectProperty D := Pgen.map ιc
  letI : Q.IsTriangulated := inferInstance
  letI : Q.IsStableUnderRetracts :=
    { of_retract := by
        intro X' Y' r hY
        let Pc : ObjectProperty D := IsCompactObject
        rcases hY with ⟨Yc, hYc, ⟨e⟩⟩
        have r₀ : Retract X' Yc.obj := r.trans (Retract.ofIso e.symm)
        have hXcompact' : IsCompactObject X' := Pc.prop_of_retract r₀ Yc.property
        let Xc : D_c(D) := ⟨X', hXcompact'⟩
        let i' : Xc ⟶ Yc := { hom := r₀.i }
        let r'₀ : Yc ⟶ Xc := { hom := r₀.r }
        have hr' : i' ≫ r'₀ = 𝟙 Xc := by
          ext
          simpa [i', r'₀] using r₀.retract
        have r' : Retract Xc Yc := by
          exact { i := i', r := r'₀, retract := hr' }
        exact ⟨Xc, Pgen.prop_of_retract r' hYc, ⟨Iso.refl _⟩⟩ }
  -- The ambient image of the compact generated property already contains the generator `E`.
  have hQE : Q E := by
    simpa [Q, Pgen, ιc] using
      Pgen.prop_map_obj ιc (objectGeneratedProperty_contains (⟨E, hE⟩ : D_c(D)))
  have hle : ⟨E⟩ ≤ Q := objectGeneratedProperty_le_of_mem E Q hQE
  have hQX : Q X := hle X h
  rcases hQX with ⟨Y, hY, ⟨e⟩⟩
  -- Lift the ambient isomorphism back to the compact full subcategory and transport the property
  -- along it.
  have e' : Y ≅ (⟨X, hX⟩ : D_c(D)) :=
    compact_subcategory_iso_of_iso Y.property hX e
  exact Pgen.prop_of_iso e' hY

/-- Helper for Proposition 13.37.6: if the inverse of an isomorphism to `K` factors through an
object `A`, then `K` is a retract of `A`. -/
def retract_of_inverse_factorization
    {K Khocolim A : D} (e : Khocolim ≅ K) (i : K ⟶ A) (factor : A ⟶ Khocolim)
    (hfactor : i ≫ factor = e.inv) :
    Retract K A := by
  -- Compose the chosen factorization with the isomorphism back to `K` to obtain the retraction.
  exact
    { i := i
      r := factor ≫ e.hom
      retract := by
        calc
          i ≫ (factor ≫ e.hom) = (i ≫ factor) ≫ e.hom := by
            simp [Category.assoc]
          _ = e.inv ≫ e.hom := by rw [hfactor]
          _ = 𝟙 _ := by simp }

/-- Helper for Proposition 13.37.6: every element of a sequential colimit in `AddCommGrpCat` is
already represented at one stage. -/
theorem exists_stage_representative_of_sequential_addCommGrp_colimit
    (G : ℕ ⥤ AddCommGrpCat.{v}) (z : (colimit G : AddCommGrpCat.{v})) :
    ∃ n : ℕ, ∃ x : G.obj n, colimit.ι G n x = z := by
  -- Concrete filtered colimits in `AddCommGrpCat` are jointly covered by the stage inclusions.
  letI : IsFiltered ℕ := inferInstance
  letI : PreservesFilteredColimits (forget AddCommGrpCat) :=
    AddCommGrpCat.FilteredColimits.forget_preservesFilteredColimits
  letI : PreservesFilteredColimitsOfSize.{0, 0} (forget AddCommGrpCat) :=
    preservesFilteredColimitsOfSize_shrink (forget AddCommGrpCat)
  letI : PreservesColimit G (forget AddCommGrpCat) := by
    infer_instance
  exact Concrete.colimit_exists_rep G z

/-- Helper for Proposition 13.37.6: a morphism from a compact object into a sequential homotopy
colimit factors through one finite stage. -/
theorem compact_map_factors_through_hocolim_stage
    {K : D} (hK : IsCompactObject K) {X : ℕ → D} (map : ∀ n, X n ⟶ X (n + 1))
    {Khocolim : D} (ι : ∀ n, X n ⟶ Khocolim)
    (c : Khocolim ⟶ ∐ fun n ↦ X n⟦(1 : ℤ)⟧)
    (htriangle :
      Triangle.mk (sequentialTelescopeMap (Functor.ofSequence map)) (Limits.Sigma.desc ι)
        (c ≫ (PreservesCoproduct.iso (shiftFunctor D (1 : ℤ)) X).inv) ∈ distTriang D)
    (f : K ⟶ Khocolim) :
    ∃ n : ℕ, ∃ ψ : K ⟶ X n, ψ ≫ ι n = f := by
  letI : IsCompactObject K := hK
  let G : ℕ ⥤ AddCommGrpCat.{v} :=
    Functor.ofSequence (fun n ↦ (preadditiveCoyoneda.obj (op K)).map (map n))
  let comparison : colimit G ⟶ (preadditiveCoyoneda.obj (op K)).obj Khocolim :=
    homologicalFunctor_hocolim_comparison (preadditiveCoyoneda.obj (op K)) map
      (Limits.Sigma.desc ι) (c ≫ (PreservesCoproduct.iso (shiftFunctor D (1 : ℤ)) X).inv)
      htriangle
  letI : IsIso comparison := by
    exact preadditiveCoyoneda_hocolim_comparison_is_iso K map
      (Limits.Sigma.desc ι) (c ≫ (PreservesCoproduct.iso (shiftFunctor D (1 : ℤ)) X).inv)
      htriangle
  -- Compactness identifies `Hom(K, Khocolim)` with the sequential colimit of the stagewise Hom
  -- groups, so `f` comes from one stage representative.
  have hsurj : Function.Surjective comparison.hom := by
    exact (ConcreteCategory.isIso_iff_bijective comparison).1 inferInstance |>.2
  obtain ⟨z, hz⟩ := hsurj f
  obtain ⟨n, ψ, hψ⟩ := exists_stage_representative_of_sequential_addCommGrp_colimit G z
  refine ⟨n, ψ, ?_⟩
  -- The remaining step is to identify the chosen stage representative with the corresponding leg
  -- of the hocolim comparison cocone.
  have hcomp : ψ ≫ ι n = f := by
    sorry
  exact hcomp

-- Proof sketch: for the forward implication, combine compact generation with the passage from
-- classical generation on `D_c` to weak generation in `D`. For the reverse implication, resolve a
-- compact object `X` by the singleton family `{E}`; compactness of `X` forces the comparison map
-- to factor through a finite stage, and that stage lies in the thick subcategory generated by
-- `E`, so `E` classically generates `D_c`.
/-- If a compact object is a weak generator of `D`, then it classically generates the compact
subcategory `D_c(D)`. -/
theorem isClassicalGenerator_on_compactObjects_of_isWeakGenerator
    (E : D) (hE : IsCompactObject E) (hweak : IsWeakGenerator E) :
    IsClassicalGenerator (⟨E, hE⟩ : D_c(D)) := by
  -- Route correction: keep the textbook singleton-resolution / compact-stage / retract argument,
  -- now using the earlier source-faithful resolution and finite-stage factorization lemmas.
  rw [IsClassicalGenerator]
  apply top_unique
  intro X _
  have hgenerate : IsGeneratingFamily (fun _ : Unit ↦ E) := by
    exact (isWeakGenerator_iff_isGeneratingFamily_unit E).1 hweak
  -- Resolve the compact object `X.obj` by the singleton family `{E}` as in Lemma 13.37.3.
  obtain ⟨Xseq, map, Y, triangleHom, triangleConnecting, Khocolim, e, hApprox, hKhocolim⟩ :=
    exists_generating_family_resolution (E := fun _ : Unit ↦ E) (fun _ ↦ hE) hgenerate X.obj
  -- Choose the source-style telescope presentation of the homotopy colimit so compactness can be
  -- applied to the comparison map `e.inv : X.obj ⟶ Khocolim`.
  obtain ⟨ι, c, hιcompat, htriangle⟩ :=
    IsHomotopyColimitOf.exists_presentation (S := Functor.ofSequence map) hKhocolim
  obtain ⟨n, ψ, hψ⟩ :=
    compact_map_factors_through_hocolim_stage
      (K := X.obj) X.property map ι c htriangle e.inv
  -- Factor the finite-stage map through an object generated by a finite coproduct of copies of
  -- `E`, then collapse that finite coproduct back to the ambient generated subcategory `⟨E⟩`.
  obtain ⟨A, J, hJ, ιJ, hA, g, k, hgk⟩ :=
    compact_factors_through_finite_generator_stage
      (E := fun _ : Unit ↦ E) hApprox X.property n ψ
  letI : Finite J := hJ
  have hA' : ⟨E⟩ A := by
    have hA_single : ⟨∐ fun _ : J ↦ E⟩ A := by
      simpa using hA
    exact generated_by_finite_coproduct_of_single_generator hA_single
  -- The factorization of `e.inv` through `A` gives the textbook retract onto a finite stage
  -- object generated by copies of `E`.
  have hretract : Retract X.obj A := by
    refine retract_of_inverse_factorization e g (k ≫ ι n) ?_
    calc
      g ≫ (k ≫ ι n) = (g ≫ k) ≫ ι n := by simp [Category.assoc]
      _ = ψ ≫ ι n := by rw [hgk]
      _ = e.inv := by rw [hψ]
  have hXambient : ⟨E⟩ X.obj := (⟨E⟩).prop_of_retract hretract hA'
  exact mem_generated_compactObjects_of_mem_generated_ambient hE X.property hXambient

/-- If a compact object classically generates the compact subcategory and the ambient category is
compactly generated, then it is a weak generator of the ambient category. -/
theorem isWeakGenerator_of_isClassicalGenerator_on_compactObjects_and_isCompactlyGenerated
    (E : D) (hE : IsCompactObject E)
    (hclass : IsClassicalGenerator (⟨E, hE⟩ : D_c(D))) (hD : IsCompactlyGenerated D) :
    IsWeakGenerator E := by
  rw [isWeakGenerator_iff_rightOrthogonal_shifts_eq_isZero]
  ext K
  constructor
  · intro hK
    rw [IsClassicalGenerator] at hclass
    rw [isCompactlyGenerated_iff_exists_compactSubcategory_generatingFamily] at hD
    rcases hD with ⟨I, F, hF⟩
    have horth : (⟨E⟩).rightOrthogonal K :=
      hom_shift_vanishes_iff_rightOrthogonal_objectGeneratedProperty.1 <| by
        intro n f
        have hshift :
            ((singleton E).shiftClosure ℤ).rightOrthogonal (K⟦n⟧) :=
          ((singleton E).shiftClosure ℤ).rightOrthogonal.le_shift n K hK
        exact hshift f (by
          simpa using (singleton E).le_shiftClosure E (by simp))
    have hfamily :
        ((ofObj fun i ↦ (F i).obj).shiftClosure ℤ).rightOrthogonal K := by
      intro X f hX
      rcases hX with ⟨Y, n, eX, hY⟩
      rw [ofObj_iff] at hY
      rcases hY with ⟨i, rfl⟩
      have hgenCompact :
          ⟨(⟨E, hE⟩ : D_c(D))⟩ (F i) := by
        -- Classical generation on `D_c(D)` puts every compact generator of `D` in the thick
        -- subcategory generated by `E`.
        rw [hclass]
        trivial
      have hgenAmbient : ⟨E⟩ (F i).obj :=
        mem_generated_ambient_of_mem_generated_compactObjects hE hgenCompact
      have hgenShift : ⟨E⟩ ((F i).obj⟦n⟧) := (⟨E⟩).le_shift n _ hgenAmbient
      have hgenX : ⟨E⟩ X := (⟨E⟩).prop_of_iso eX.symm hgenShift
      exact horth f hgenX
    -- Compact generation gives a compact generating family, so orthogonality to that family
    -- forces the object to be zero.
    rw [IsGeneratingFamily] at hF
    rw [← hF]
    exact hfamily
  · intro hK X f hX
    exact hK.eq_zero_of_tgt f

/-- Proposition 13.37.6: for a compact object `E` of a triangulated category with direct sums,
`E` is a weak generator of `D` if and only if `E`, viewed as an object of the compact subcategory
`D_c`, is a classical generator of `D_c` and `D` is compactly generated. -/
@[stacks 09SR]
theorem weak_generator_iff_classical_generator_on_compactObjects_and_compactly_generated
    (E : D) (hE : IsCompactObject E) :
    IsWeakGenerator E ↔
      (IsClassicalGenerator (⟨E, hE⟩ : D_c(D)) ∧ IsCompactlyGenerated D) := by
  constructor
  · intro hweak
    exact
      ⟨isClassicalGenerator_on_compactObjects_of_isWeakGenerator E hE hweak,
        isCompactlyGenerated_of_isWeakGenerator E hE hweak⟩
  · rintro ⟨hclass, hD⟩
    exact
      isWeakGenerator_of_isClassicalGenerator_on_compactObjects_and_isCompactlyGenerated
        E hE hclass hD

end

end CategoryTheory
