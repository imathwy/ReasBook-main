import Mathlib
import stacks_proof.stacks_project.Chap13.Definition_13_36_3

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated
open scoped CategoryTheory.ObjectProperty.GeneratedNotation

universe v u

namespace CategoryTheory

section

variable {D : Type u} [Category.{v} D] [Limits.HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, Functor.Additive (shiftFunctor D n)] [Pretriangulated D]
  [CategoryTheory.IsTriangulated D]

/- Domain-style sampling for Lemma 13.36.6:
- primary domain: strong and classical generators in triangulated categories, expressed through the
  chapter owners `⟨E⟩` and `⟨E⟩_n` on `ObjectProperty`;
- sampled owner declarations:
  `IsClassicalGenerator`,
  `IsStrongGenerator`,
  `objectGeneratedStage_one_eq`,
  `objectGeneratedStage_add`;
- best owner abstraction: the proof should run entirely through the generated-stage owner
  `⟨E⟩_n`, not through a parallel wrapper for “objects obtained from `E` in finitely many steps”;
- primitive data: a strong generator witness `⟨E'⟩_n = ⊤`, a classical-generator equality
  `⟨E⟩ = ⊤`, and the stage-membership witness `E' ∈ ⟨E⟩_m`;
- derived API: the stage-one comparison `⟨E'⟩_1 ≤ ⟨E⟩_m` and its iteration to higher stages.

Source/core/bridge triage:
- `source-facing`: `strong_generator_of_classical_generator`;
- `core/canonical`: `⟨E⟩`, `⟨E⟩_n`, `objectGeneratedStage_one_eq`, and `objectGeneratedStage_add`;
- `bridge/view`: the local proof-only shift/additive/retract-closure instances used to show that a
  stage containing `E'` already contains the first stage generated by `E'`.
-/

-- Proof sketch: choose a strong generator `E'` with `D = ⟨E'⟩ₙ` for some `n`. Since `E` is a
-- classical generator, Lemma `objectGeneratedProperty_le_iff` forces the triangulated subcategory
-- `⟨E⟩` generated by `E` to be all of `D`, so `E' ∈ ⟨E⟩ₘ` for some `m`. Then
-- `⟨E'⟩₁ ⊆ ⟨E⟩ₘ`, and Lemma `objectGeneratedStage_add` together with the stage description from
-- Lemma `13.36.1` yields `D = ⟨E'⟩ₙ ⊆ ⟨E⟩ₙₘ`, proving that `E` is a strong generator.
omit [CategoryTheory.IsTriangulated D] in
/-- Helper for Lemma 13.36.6: if `E` is a classical generator, then every object lies in some
finite stage generated by `E`. -/
theorem stage_membership_of_classical_generator {E E' : D} (hE : IsClassicalGenerator E) :
    ∃ m : ℕ+, (⟨E⟩_m) E' := by
  -- Rewrite classical generation as `⟨E⟩ = ⊤`.
  rw [IsClassicalGenerator] at hE
  have hmem : ⟨E⟩ E' := by
    rw [hE]
    trivial
  -- Unfold the supremum presentation of `⟨E⟩` and extract a finite stage containing `E'`.
  rw [objectGeneratedProperty, prop_iSup_iff] at hmem
  exact hmem

omit [CategoryTheory.IsTriangulated D] in
/-- Helper for Lemma 13.36.6: if `E'` belongs to the `m`-th stage generated by `E`, then the first
stage generated by `E'` is already contained in that same stage of `E`. -/
theorem objectGeneratedStage_one_le_of_mem {E E' : D} {m : ℕ+}
    (hEm : (⟨E⟩_m) E') :
    (⟨E'⟩_1) ≤ ⟨E⟩_m := by
  let Pm : ObjectProperty D := additiveExtensionStage ((ObjectProperty.singleton E).shiftClosure ℤ) m
  -- Rewrite the target owner into the additive-extension form used by the stage API.
  rw [objectGeneratedStage_eq_additiveExtensionStage E m]
  change (⟨E'⟩_1) ≤ Pm
  rw [objectGeneratedStage_one_eq, retractClosure_le_iff]
  -- It remains to show that the additive closure of the shifts of `E'` sits inside `Pm`.
  let _ : Pm.IsClosedUnderBinaryCoproducts := inferInstance
  let _ : Pm.IsClosedUnderFiniteCoproducts := ObjectProperty.IsClosedUnderFiniteCoproducts.mk'
  refine colimitsClosure_le ?_
  rw [shiftClosure_le_iff, singleton_le_iff]
  simpa [Pm] using
    (show additiveExtensionStage ((ObjectProperty.singleton E).shiftClosure ℤ) m E' from by
      rwa [← objectGeneratedStage_eq_additiveExtensionStage E m])

/-- Helper for Lemma 13.36.6: once the first stage of `E'` is bounded by the `m`-th stage of `E`,
the same bound propagates to every higher stage with multiplicative index growth. -/
theorem objectGeneratedStage_le_mul_stage {E E' : D} {m : ℕ+}
    (h1 : (⟨E'⟩_1) ≤ ⟨E⟩_m) :
    ∀ k : ℕ+, (⟨E'⟩_k) ≤ ⟨E⟩_(k * m) := by
  intro k
  refine PNat.recOn k ?_ ?_
  · simpa using h1
  · intro k ih
    -- Rewrite the successor stage using the canonical addition formula for generated stages.
    rw [objectGeneratedStage_add E' k 1]
    have hstep :
        ((⟨E'⟩_k).extensionProduct ⟨E'⟩_1).retractClosure ≤
          ((⟨E⟩_(k * m)).extensionProduct ⟨E⟩_m).retractClosure := by
      -- Monotonicity on both extension-product factors propagates the inductive bound.
      rw [retractClosure_le_iff]
      exact ((monotone_extensionProduct_left (⟨E'⟩_1) ih).trans <|
        monotone_extensionProduct_right (⟨E⟩_(k * m)) h1).trans (le_retractClosure _)
    -- Identify the right-hand extension product with the `(k + 1) * m` stage of `E`.
    exact hstep.trans <| by
      simpa [add_mul] using le_of_eq (objectGeneratedStage_add E (k * m) m).symm

/-- Lemma 13.36.6: in a triangulated category admitting a strong generator, every classical
generator is a strong generator. -/
@[stacks 0FXA]
theorem strong_generator_of_classical_generator (E : D)
    (hD : ∃ E' : D, IsStrongGenerator E')
    (hE : IsClassicalGenerator E) :
    IsStrongGenerator E := by
  rcases hD with ⟨E', n, hn⟩
  -- First place the known strong generator `E'` into a finite stage generated by `E`.
  rcases stage_membership_of_classical_generator (E' := E') hE with ⟨m, hEm⟩
  -- Then the whole first stage of `E'` is already controlled by that stage of `E`.
  have h1 : (⟨E'⟩_1) ≤ ⟨E⟩_m := objectGeneratedStage_one_le_of_mem hEm
  -- Iterate that stage-one bound through the strong-generation length `n`.
  have hpow : (⟨E'⟩_n) ≤ ⟨E⟩_(n * m) := objectGeneratedStage_le_mul_stage h1 n
  -- Replace `⟨E'⟩_n` by `⊤` and package the resulting finite-stage witness for `E`.
  refine ⟨n * m, top_unique ?_⟩
  simpa [hn] using hpow

end

end CategoryTheory
