import Mathlib
import stacks_proof.stacks_project.Chap10.Lemma_10_106_2
import stacks_proof.stacks_project.Chap10.Lemma_10_119_3
import stacks_proof.stacks_project.Chap10.Lemma_10_50_18

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Ideal IsLocalRing

section

variable {A : Type u} [CommRing A]

/-- Helper for Lemma 10.119.7: a discrete valuation ring is a regular local ring of Krull
dimension `1`. -/
lemma discrete_valuation_ring_to_regular_local_dim_one [IsDomain A] [IsDiscreteValuationRing A] :
    IsRegularLocalRing A ∧ ringKrullDim A = 1 := by
  constructor
  · -- A DVR is a local PID, hence regular local by the canonical mathlib instance.
    infer_instance
  · -- A DVR is not a field, so the PID dimension formula gives Krull dimension `1`.
    exact IsPrincipalIdealRing.ringKrullDim_eq_one A
      (IsDiscreteValuationRing.not_isField (R := A))

/-- Helper for Lemma 10.119.7: a one-dimensional regular local ring has nonzero principal maximal
ideal. -/
lemma regular_local_dim_one_to_principal_maximal_ideal
    (hreg : IsRegularLocalRing A) (hdim : ringKrullDim A = 1) :
    maximalIdeal A ≠ ⊥ ∧ (maximalIdeal A).IsPrincipal := by
  letI : IsRegularLocalRing A := hreg
  letI : IsDomain A := regularLocalRing_isDomain
  have hnotField : ¬ IsField A :=
    (ringKrullDim_eq_one_iff_of_isLocalRing_isDomain (R := A)).mp hdim |>.1
  constructor
  · -- Krull dimension `1` rules out the field case, so the maximal ideal is nonzero.
    exact isField_iff_maximalIdeal_eq.not.mp hnotField
  · -- In a one-dimensional regular local ring, the cotangent space has dimension `1`.
    have hcot :
        Module.finrank (ResidueField A) (CotangentSpace A) = 1 :=
      finrank_cotangentSpace_eq_one_of_regular_dim_one (R := A) hdim
    -- Principality is equivalent to the cotangent-space dimension being at most `1`.
    exact (IsLocalRing.finrank_cotangentSpace_le_one_iff (R := A)).mp (by simpa [hcot])

/-- Helper for Lemma 10.119.7: a one-dimensional Noetherian local normal domain has principal
nonzero maximal ideal. -/
lemma normal_local_dim_one_to_principal_maximal_ideal
    [IsLocalRing A] [IsNoetherianRing A] [IsDomain A] [IsIntegrallyClosed A]
    (hdim : ringKrullDim A = 1) :
    maximalIdeal A ≠ ⊥ ∧ (maximalIdeal A).IsPrincipal := by
  have hnotField : ¬ IsField A :=
    (ringKrullDim_eq_one_iff_of_isLocalRing_isDomain (R := A)).mp hdim |>.1
  letI : Ring.DimensionLEOne A := by
    -- Krull dimension `1` gives the dimension-`≤ 1` owner needed for Dedekind domains.
    refine ⟨?_⟩
    intro p hp0 hpPrime
    exact
      (Ring.krullDimLE_one_iff_of_noZeroDivisors.mp
        (Ring.krullDimLE_iff.mpr (by simpa [hdim]))) p hp0 hpPrime
  letI : IsDedekindDomain A :=
    (isDedekindDomain_iff A (FractionRing A)).mpr
      ⟨inferInstance, inferInstance, inferInstance, by
        -- Normality means every integral fraction already comes from `A`.
        intro x hx
        exact (isIntegrallyClosed_iff (FractionRing A)).mp
          (inferInstance : IsIntegrallyClosed A) hx⟩
  constructor
  · -- Again, dimension `1` excludes the field case.
    exact isField_iff_maximalIdeal_eq.not.mp hnotField
  · -- In a local Dedekind domain, the maximal ideal is principal.
    exact maximalIdeal_isPrincipal_of_isDedekindDomain A

-- Proof sketch: combine the existing DVR TFAE in mathlib with the chapter's bridge results:
-- DVRs are regular local rings of dimension `1`, a regular local ring of dimension `1` has
-- principal maximal ideal, valuation rings are integrally closed, and a one-dimensional
-- Noetherian local normal domain has principal maximal ideal by the finite birational extension
-- argument from the text.
/-- Lemma 10.119.7: for a commutative ring `A`, the following are equivalent: `A` is a discrete
valuation ring; `A` is a valuation ring that is Noetherian but not a field; `A` is a regular local
ring of dimension `1`; `A` is a Noetherian local domain whose maximal ideal is generated by a
single nonzero element; `A` is a Noetherian local normal domain of dimension `1`. -/
@[stacks 00PD]
theorem discreteValuationRing_tfae :
    List.TFAE
      [ (∃ (_ : IsDomain A), IsDiscreteValuationRing A),
        ∃ (_ : IsDomain A) (_ : IsNoetherianRing A), ValuationRing A ∧ ¬ IsField A,
        IsRegularLocalRing A ∧ ringKrullDim A = 1,
        ∃ (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : IsDomain A),
          maximalIdeal A ≠ ⊥ ∧ (maximalIdeal A).IsPrincipal,
        ∃ (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : IsDomain A)
          (_ : IsIntegrallyClosed A), ringKrullDim A = 1 ] := by
  tfae_have 1 ↔ 2 := by
    constructor
    · rintro ⟨hDomain, hDvr⟩
      letI : IsDomain A := hDomain
      letI : IsDiscreteValuationRing A := hDvr
      -- A DVR is Noetherian, a valuation ring, and not a field.
      exact ⟨inferInstance, inferInstance, inferInstance,
        IsDiscreteValuationRing.not_isField (R := A)⟩
    · rintro ⟨hDomain, hNoetherian, hValuation, hNotField⟩
      letI : IsDomain A := hDomain
      letI : IsNoetherianRing A := hNoetherian
      letI : ValuationRing A := hValuation
      -- A Noetherian valuation domain that is not a field is a DVR.
      have hOr :
          IsDiscreteValuationRing A ∨ IsField A :=
        (valuationRing_isNoetherianRing_iff_isDiscreteValuationRing_or_isField (A := A)).mp
          inferInstance
      rcases hOr with hDvr | hField
      · exact ⟨inferInstance, hDvr⟩
      · exact (hNotField hField).elim
  tfae_have 1 → 3 := by
    rintro ⟨hDomain, hDvr⟩
    letI : IsDomain A := hDomain
    letI : IsDiscreteValuationRing A := hDvr
    -- Follow the source route `DVR => regular local of dimension 1`.
    exact discrete_valuation_ring_to_regular_local_dim_one (A := A)
  tfae_have 3 → 4 := by
    rintro ⟨hreg, hdim⟩
    letI : IsRegularLocalRing A := hreg
    letI : IsDomain A := regularLocalRing_isDomain
    -- The regular-local bridge identifies the maximal ideal as principal and nonzero.
    exact ⟨inferInstance, inferInstance, inferInstance,
      regular_local_dim_one_to_principal_maximal_ideal (A := A) hreg hdim⟩
  tfae_have 4 → 1 := by
    rintro ⟨hLocal, hNoetherian, hDomain, hm, hprincipal⟩
    letI : IsLocalRing A := hLocal
    letI : IsNoetherianRing A := hNoetherian
    letI : IsDomain A := hDomain
    have hnotField : ¬ IsField A := isField_iff_maximalIdeal_eq.not.mpr hm
    -- The owner DVR TFAE turns principal maximal ideal into the DVR structure.
    exact ⟨inferInstance,
      ((IsDiscreteValuationRing.TFAE A hnotField).out 4 0).mp hprincipal⟩
  tfae_have 1 → 5 := by
    rintro ⟨hDomain, hDvr⟩
    letI : IsDomain A := hDomain
    letI : IsDiscreteValuationRing A := hDvr
    obtain ⟨hreg, hdim⟩ := discrete_valuation_ring_to_regular_local_dim_one (A := A)
    -- A DVR is local, Noetherian, and integrally closed, with dimension `1`.
    exact ⟨inferInstance, inferInstance, inferInstance, inferInstance, hdim⟩
  tfae_have 5 → 4 := by
    rintro ⟨hLocal, hNoetherian, hDomain, hClosed, hdim⟩
    letI : IsLocalRing A := hLocal
    letI : IsNoetherianRing A := hNoetherian
    letI : IsDomain A := hDomain
    letI : IsIntegrallyClosed A := hClosed
    -- Package the normal one-dimensional local domain as a local Dedekind domain.
    exact ⟨inferInstance, inferInstance, inferInstance,
      normal_local_dim_one_to_principal_maximal_ideal (A := A) hdim⟩
  tfae_finish

/-- Companion bridge for Lemma 10.119.7: the source-facing statement that `A` is a discrete
valuation ring is equivalent to the canonical regular-local owner together with the dimension-one
conclusion. -/
theorem discreteValuationRing_iff_regularLocalRing_dim_one :
    (∃ (_ : IsDomain A), IsDiscreteValuationRing A) ↔
      IsRegularLocalRing A ∧ ringKrullDim A = 1 := by
  simpa using
    (show List.TFAE
        [ (∃ (_ : IsDomain A), IsDiscreteValuationRing A),
          ∃ (_ : IsDomain A) (_ : IsNoetherianRing A), ValuationRing A ∧ ¬ IsField A,
          IsRegularLocalRing A ∧ ringKrullDim A = 1,
          ∃ (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : IsDomain A),
            maximalIdeal A ≠ ⊥ ∧ (maximalIdeal A).IsPrincipal,
          ∃ (_ : IsLocalRing A) (_ : IsNoetherianRing A) (_ : IsDomain A)
            (_ : IsIntegrallyClosed A), ringKrullDim A = 1 ] from
      discreteValuationRing_tfae).out 0 2

variable [IsDomain A] [IsDiscreteValuationRing A]

/-- Helper for Lemma 10.119.7: in a DVR, a generator of the maximal ideal is irreducible. -/
lemma irreducible_of_span_maximal_ideal (π : A)
    (hπ : maximalIdeal A = Ideal.span {π}) :
    Irreducible π := by
  -- Generators of the maximal ideal are exactly the uniformizers of a DVR.
  exact (IsDiscreteValuationRing.irreducible_iff_uniformizer π).2 hπ

-- Proof sketch: identify `π` as a uniformizer from `hπ`, use the DVR valuation to define the
-- exponent of a nonzero element, and then show the residual factor is a unit; uniqueness follows
-- from comparing valuations of two expressions `u * π^n`.
/-- If `π` generates the maximal ideal of a discrete valuation ring, then every nonzero element has
a unique expression as a unit times a power of `π`. This is the normal form promised by the
textbook after the equivalent characterizations. -/
theorem existsUnique_unit_mul_pow_of_span_maximalIdeal (π a : A)
    (hπ : maximalIdeal A = Ideal.span {π}) (ha : a ≠ 0) :
    ∃! p : Aˣ × ℕ, a = (p.1 : A) * π ^ p.2 := by
  have hirr : Irreducible π :=
    irreducible_of_span_maximal_ideal (A := A) π hπ
  obtain ⟨n, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha hirr
  refine ⟨(u, n), hu, ?_⟩
  rintro ⟨v, m⟩ hv
  -- Compare the two unit-times-power decompositions via the DVR uniqueness API.
  have hEq : (v : A) * π ^ m = (u : A) * π ^ n := by
    calc
      (v : A) * π ^ m = a := hv.symm
      _ = (u : A) * π ^ n := hu
  have hm : m = n :=
    IsDiscreteValuationRing.unit_mul_pow_congr_pow hirr hirr v u m n hEq
  have hvu : v = u :=
    IsDiscreteValuationRing.unit_mul_pow_congr_unit hirr v u m n hEq
  cases hm
  cases hvu
  rfl

end
