import Mathlib
import StacksProject_2024.Chap10.Lemma_10_150_6.AssociatedGradedAPI

-- Proof rescue support for Proposition 10.59.5: descend the Rees decomposition for `gr_I(R)`
-- through the quotient defining the associated graded ring.

noncomputable section

universe u

open scoped Ideal

namespace Ideal

variable {R : Type u} [CommRing R]

/-- Helper for Proposition 10.59.5: the Rees ideal whose quotient is `gr_I(R)`. -/
abbrev idealAssociatedGradedRingDefiningIdeal (I : Ideal R) : Ideal (reesAlgebra I) :=
  Ideal.map (algebraMap R (reesAlgebra I)) I

/-- Helper for Proposition 10.59.5: expose the quotient-Rees commutative ring structure so owner
packaging proofs do not repeatedly unfold the quotient type. -/
local instance idealAssociatedGradedRing_commRing (I : Ideal R) :
    CommRing (idealAssociatedGradedRing I) := by
  infer_instance

/-- Helper for Proposition 10.59.5: expose the additive structure on `gr_I(R)` for the direct-sum
decomposition proofs. -/
local instance idealAssociatedGradedRing_addCommMonoid (I : Ideal R) :
    AddCommMonoid (idealAssociatedGradedRing I) := by
  infer_instance

/-- Helper for Proposition 10.59.5: expose the multiplicative structure on `gr_I(R)` for graded
ring packaging. -/
local instance idealAssociatedGradedRing_monoid (I : Ideal R) :
    Monoid (idealAssociatedGradedRing I) := by
  infer_instance

/-- Helper for Proposition 10.59.5: expose the quotient-Rees module structure over the base ring.
-/
local instance idealAssociatedGradedRing_module (I : Ideal R) :
    Module R (idealAssociatedGradedRing I) := by
  infer_instance

/-- Helper for Proposition 10.59.5: expose the quotient-Rees algebra structure over the base ring.
-/
local instance idealAssociatedGradedRing_algebra (I : Ideal R) :
    Algebra R (idealAssociatedGradedRing I) := by
  infer_instance

/-- Helper for Proposition 10.59.5: the owner pieces of `gr_I(R)` form a graded multiplicative
family. -/
local instance idealAssociatedGradedRingGrade_gradedMonoid (I : Ideal R) :
    SetLike.GradedMonoid (idealAssociatedGradedRingGrade (R := R) I) where
  one_mem := by
    -- The unit is represented by the degree-zero Rees unit.
    refine ⟨1, SetLike.one_mem_graded (reesAlgebraGrade I), rfl⟩
  mul_mem := by
    -- Multiplication of homogeneous Rees representatives adds degrees.
    intro i j x y hx hy
    rcases hx with ⟨x', hx', rfl⟩
    rcases hy with ⟨y', hy', rfl⟩
    exact ⟨x' * y', SetLike.mul_mem_graded hx' hy', rfl⟩

/-- Helper for Proposition 10.59.5: the defining ideal of `gr_I(R)` is homogeneous for the Rees
grading because it is generated by degree-zero coefficients. -/
theorem idealAssociatedGradedRingDefiningIdeal_isHomogeneous
    (I : Ideal R) :
    (idealAssociatedGradedRingDefiningIdeal (R := R) I).IsHomogeneous (reesAlgebraGrade I) := by
  -- Rewrite the defining ideal as the span of the degree-zero generator images coming from `I`.
  simpa [idealAssociatedGradedRingDefiningIdeal, Ideal.map_span, Ideal.span_eq] using
    (Ideal.homogeneous_span
      (𝒜 := reesAlgebraGrade I)
      ((algebraMap R (reesAlgebra I)) '' (I : Set R))
      (by
        rintro x ⟨r, hr, rfl⟩
        exact ⟨0, SetLike.algebraMap_mem_graded (reesAlgebraGrade I) r⟩))

/-- Helper for Proposition 10.59.5: each homogeneous Rees piece maps linearly to the matching
owner piece of `gr_I(R)`. -/
def idealAssociatedGradedRingOwnerComponentMap
    (I : Ideal R) (d : ℕ) :
    reesAlgebraGrade I d →ₗ[R] idealAssociatedGradedRingGrade I d :=
  LinearMap.codRestrict
    (idealAssociatedGradedRingGrade I d)
    (((Ideal.Quotient.mkₐ R
        (idealAssociatedGradedRingDefiningIdeal (R := R) I)).toLinearMap).domRestrict
      (reesAlgebraGrade I d))
    (fun x ↦ ⟨x, x.2, rfl⟩)

/-- Helper for Proposition 10.59.5: on the direct sum of homogeneous Rees pieces, the component
quotient maps preserve the graded unit. -/
theorem idealAssociatedGradedRing_directSum_component_preserves_one
    (I : Ideal R) :
    (DirectSum.lof R ℕ (fun d ↦ idealAssociatedGradedRingGrade I d) 0)
      ((idealAssociatedGradedRingOwnerComponentMap (R := R) I 0)
        ⟨1, SetLike.one_mem_graded (reesAlgebraGrade I)⟩) = 1 := by
  -- The degree-zero unit maps to the degree-zero direct-sum unit.
  rw [DirectSum.lof_eq_of]
  rfl

/-- Helper for Proposition 10.59.5: on the direct sum of homogeneous Rees pieces, the component
quotient maps respect graded multiplication. -/
theorem idealAssociatedGradedRing_directSum_component_preserves_mul
    (I : Ideal R) {i j : ℕ}
    (x : reesAlgebraGrade I i) (y : reesAlgebraGrade I j) :
      (DirectSum.lof R ℕ
          (fun d ↦ idealAssociatedGradedRingGrade I d) (i + j))
      ((idealAssociatedGradedRingOwnerComponentMap (R := R) I (i + j))
        ⟨x.1 * y.1, SetLike.mul_mem_graded x.2 y.2⟩) =
      (DirectSum.lof R ℕ
          (fun d ↦ idealAssociatedGradedRingGrade I d) i)
        ((idealAssociatedGradedRingOwnerComponentMap (R := R) I i) x) *
        (DirectSum.lof R ℕ
            (fun d ↦ idealAssociatedGradedRingGrade I d) j)
          ((idealAssociatedGradedRingOwnerComponentMap (R := R) I j) y) := by
  -- Multiplication of direct-sum generators matches multiplication of the quotient classes.
  rw [DirectSum.lof_eq_of, DirectSum.lof_eq_of, DirectSum.lof_eq_of, DirectSum.of_mul_of]
  rfl

/-- Helper for Proposition 10.59.5: map the direct sum of homogeneous Rees pieces to the direct
sum of their quotient images degreewise. -/
def idealAssociatedGradedRing_directSumAlgHom
    (I : Ideal R) :
    DirectSum ℕ (fun d ↦ ↥(reesAlgebraGrade I d)) →ₐ[R]
      DirectSum ℕ (fun d ↦ ↥(idealAssociatedGradedRingGrade I d)) :=
  DirectSum.toAlgebra (R := R)
    (A := fun d ↦ reesAlgebraGrade I d)
    (B := DirectSum ℕ (fun d ↦ ↥(idealAssociatedGradedRingGrade I d)))
    (fun d ↦
      (DirectSum.lof R ℕ
        (fun e ↦ idealAssociatedGradedRingGrade I e) d).comp
        (idealAssociatedGradedRingOwnerComponentMap (R := R) I d))
    (idealAssociatedGradedRing_directSum_component_preserves_one (R := R) I)
    (fun {_i _j} x y ↦
      idealAssociatedGradedRing_directSum_component_preserves_mul (R := R) I x y)

/-- Helper for Proposition 10.59.5: before quotienting by the defining ideal, decompose a Rees
element into homogeneous pieces and then map each piece to the owner quotient. -/
def idealAssociatedGradedRing_predecomposeAlgHom
    (I : Ideal R) :
    reesAlgebra I →ₐ[R]
      DirectSum ℕ (fun d ↦ ↥(idealAssociatedGradedRingGrade I d)) :=
  (idealAssociatedGradedRing_directSumAlgHom (R := R) I).comp
    (DirectSum.decomposeAlgEquiv (reesAlgebraGrade I)).toAlgHom

/-- Helper for Proposition 10.59.5: the algebraic predecomposition is the same as the direct-sum
map obtained from `DirectSum.decompose` followed by the component quotient maps. -/
theorem idealAssociatedGradedRing_predecomposeAlgHom_apply
    (I : Ideal R) (q : reesAlgebra I) :
    idealAssociatedGradedRing_predecomposeAlgHom (R := R) I q =
      DirectSum.lmap
        (fun d ↦ idealAssociatedGradedRingOwnerComponentMap (R := R) I d)
        (DirectSum.decompose (reesAlgebraGrade I) q) := by
  -- `DirectSum.toAlgebra` extends the same family of degreewise component maps as `lmap`.
  have hlmap :
      (idealAssociatedGradedRing_directSumAlgHom (R := R) I).toLinearMap =
        DirectSum.lmap (fun d ↦ idealAssociatedGradedRingOwnerComponentMap (R := R) I d) := by
    apply DirectSum.linearMap_ext
    intro d
    apply LinearMap.ext
    intro x
    simpa [LinearMap.comp_apply, idealAssociatedGradedRing_directSumAlgHom, DirectSum.lof_eq_of,
      DirectSum.lmap_lof] using
      (DirectSum.toSemiring_of
        (f := fun e ↦
          ((DirectSum.lof R ℕ
            (fun f ↦ idealAssociatedGradedRingGrade I f) e).comp
            (idealAssociatedGradedRingOwnerComponentMap (R := R) I e)).toAddMonoidHom)
        (hone := idealAssociatedGradedRing_directSum_component_preserves_one (R := R) I)
        (hmul := fun {_i _j} x y ↦
          idealAssociatedGradedRing_directSum_component_preserves_mul (R := R) I x y)
        d x)
  simpa [idealAssociatedGradedRing_predecomposeAlgHom, LinearMap.comp_apply,
    DirectSum.decomposeAlgEquiv_apply, DirectSum.decomposeLinearEquiv_apply] using
    congrArg
      (fun φ :
        DirectSum ℕ (fun d ↦ ↥(reesAlgebraGrade I d)) →ₗ[R]
          DirectSum ℕ (fun d ↦ ↥(idealAssociatedGradedRingGrade I d)) =>
        φ (DirectSum.decompose (reesAlgebraGrade I) q))
      hlmap

/-- Helper for Proposition 10.59.5: on a homogeneous Rees element, the quotient predecomposition
is concentrated in the matching owner degree. -/
theorem idealAssociatedGradedRing_predecomposeAlgHom_eq_of_mem_grade
    (I : Ideal R) {d : ℕ} {q : reesAlgebra I}
    (hq : q ∈ reesAlgebraGrade I d) :
    idealAssociatedGradedRing_predecomposeAlgHom (R := R) I q =
      DirectSum.of
        (fun e ↦ idealAssociatedGradedRingGrade I e) d
        ((idealAssociatedGradedRingOwnerComponentMap (R := R) I d) ⟨q, hq⟩) := by
  -- A homogeneous Rees element already has a one-slot direct-sum decomposition, so the quotient
  -- predecomposition is obtained by applying the degreewise quotient map in that same slot.
  rw [idealAssociatedGradedRing_predecomposeAlgHom_apply]
  rw [DirectSum.decompose_of_mem _ hq, DirectSum.lmap_of]

/-- Helper for Proposition 10.59.5: the algebraic predecomposition kills the defining ideal, so it
can descend to the quotient ring `gr_I(R)`. -/
theorem idealAssociatedGradedRing_predecomposeAlgHom_eq_zero_of_mem_definingIdeal
    (I : Ideal R) {q : reesAlgebra I}
    (hq : q ∈ idealAssociatedGradedRingDefiningIdeal (R := R) I) :
    idealAssociatedGradedRing_predecomposeAlgHom (R := R) I q = 0 := by
  -- Use homogeneity of the defining ideal to show every homogeneous component already vanishes in
  -- the quotient owner piece.
  ext d
  rw [idealAssociatedGradedRing_predecomposeAlgHom_apply]
  have hcomp :
      (DirectSum.decompose (reesAlgebraGrade I) q d : reesAlgebra I) ∈
        idealAssociatedGradedRingDefiningIdeal (R := R) I := by
    exact
      (Ideal.IsHomogeneous.mem_iff
        (𝒜 := reesAlgebraGrade I)
        (idealAssociatedGradedRingDefiningIdeal_isHomogeneous (R := R) I)).1 hq d
  change
    Ideal.Quotient.mk
      (idealAssociatedGradedRingDefiningIdeal (R := R) I)
      ((DirectSum.decompose (reesAlgebraGrade I) q d : reesAlgebra I)) = 0
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hcomp

/-- Helper for Proposition 10.59.5: the quotient-Rees predecomposition descends to the owner ring
`gr_I(R)`. -/
def idealAssociatedGradedRing_decomposeAlgHom
    (I : Ideal R) :
    idealAssociatedGradedRing I →ₐ[R]
      DirectSum ℕ (fun d ↦ ↥(idealAssociatedGradedRingGrade I d)) :=
  Ideal.Quotient.liftₐ
    (idealAssociatedGradedRingDefiningIdeal (R := R) I)
    (idealAssociatedGradedRing_predecomposeAlgHom (R := R) I)
    (fun q hq ↦
      idealAssociatedGradedRing_predecomposeAlgHom_eq_zero_of_mem_definingIdeal
        (R := R) I hq)

/-- Helper for Proposition 10.59.5: the descended decomposition computes by the original
predecomposition after precomposing with the quotient map. -/
theorem idealAssociatedGradedRing_decomposeAlgHom_comp_mk
    (I : Ideal R) :
    (idealAssociatedGradedRing_decomposeAlgHom (R := R) I).comp
        (Ideal.Quotient.mkₐ R (idealAssociatedGradedRingDefiningIdeal (R := R) I)) =
      idealAssociatedGradedRing_predecomposeAlgHom (R := R) I := by
  -- This is the defining computation rule for `Ideal.Quotient.liftₐ`.
  simpa [idealAssociatedGradedRing_decomposeAlgHom] using
    (Ideal.Quotient.liftₐ_comp
      (R₁ := R)
      (I := idealAssociatedGradedRingDefiningIdeal (R := R) I)
      (idealAssociatedGradedRing_predecomposeAlgHom (R := R) I)
      (fun q hq ↦
        idealAssociatedGradedRing_predecomposeAlgHom_eq_zero_of_mem_definingIdeal
          (R := R) I hq))

/-- Helper for Proposition 10.59.5: on the direct sum of Rees homogeneous pieces, summing the
degreewise quotient maps is the same as first summing in the Rees algebra and then quotienting to
`gr_I(R)`. -/
theorem idealAssociatedGradedRing_directSumAlgHom_comp_coe
    (I : Ideal R) :
    (DirectSum.coeAlgHom (idealAssociatedGradedRingGrade I)).comp
        (idealAssociatedGradedRing_directSumAlgHom (R := R) I) =
      (Ideal.Quotient.mkₐ R (idealAssociatedGradedRingDefiningIdeal (R := R) I)).comp
        (DirectSum.coeAlgHom (reesAlgebraGrade I)) := by
  -- Both algebra maps out of the direct sum are determined by the homogeneous generators.
  ext d x
  simpa [LinearMap.comp_apply, AlgHom.comp_apply, idealAssociatedGradedRing_directSumAlgHom,
    idealAssociatedGradedRingOwnerComponentMap, DirectSum.lof_eq_of] using
    congrArg
      (DirectSum.coeAlgHom (idealAssociatedGradedRingGrade I))
      (DirectSum.toSemiring_of
        (f := fun e ↦
          ((DirectSum.lof R ℕ
            (fun f ↦ idealAssociatedGradedRingGrade I f) e).comp
            (idealAssociatedGradedRingOwnerComponentMap (R := R) I e)).toAddMonoidHom)
        (hone := idealAssociatedGradedRing_directSum_component_preserves_one (R := R) I)
        (hmul := fun {_i _j} x y ↦
          idealAssociatedGradedRing_directSum_component_preserves_mul (R := R) I x y)
        d x)

/-- Helper for Proposition 10.59.5: the descended decomposition is a right inverse to the
canonical direct-sum algebra map back to `gr_I(R)`. -/
theorem idealAssociatedGradedRing_decomposeAlgHom_right_inv
    (I : Ideal R) :
    (DirectSum.coeAlgHom (idealAssociatedGradedRingGrade I)).comp
        (idealAssociatedGradedRing_decomposeAlgHom (R := R) I) =
      AlgHom.id R (idealAssociatedGradedRing I) := by
  -- Check the identity after precomposing with the quotient map, then use quotient extensionality.
  refine Ideal.Quotient.algHom_ext (R₁ := R)
    (I := idealAssociatedGradedRingDefiningIdeal (R := R) I) ?_
  rw [AlgHom.comp_assoc, idealAssociatedGradedRing_decomposeAlgHom_comp_mk]
  rw [idealAssociatedGradedRing_predecomposeAlgHom]
  rw [← AlgHom.comp_assoc, idealAssociatedGradedRing_directSumAlgHom_comp_coe]
  ext q
  -- The standard graded decomposition of the Rees algebra reconstructs the original element.
  change
    Ideal.Quotient.mk (idealAssociatedGradedRingDefiningIdeal (R := R) I)
        (((DirectSum.decomposeAlgEquiv (reesAlgebraGrade I)).symm)
          ((DirectSum.decomposeAlgEquiv (reesAlgebraGrade I)) q)) =
      Ideal.Quotient.mk (idealAssociatedGradedRingDefiningIdeal (R := R) I) q
  exact congrArg
    (Ideal.Quotient.mk (idealAssociatedGradedRingDefiningIdeal (R := R) I))
    ((DirectSum.decomposeAlgEquiv (reesAlgebraGrade I)).symm_apply_apply q)

/-- Helper for Proposition 10.59.5: on a homogeneous owner class, the descended decomposition
lands in the expected direct-sum slot. -/
theorem idealAssociatedGradedRing_decomposeAlgHom_left_inv
    (I : Ideal R) (d : ℕ) (x : idealAssociatedGradedRingGrade I d) :
    idealAssociatedGradedRing_decomposeAlgHom (R := R) I (x : idealAssociatedGradedRing I) =
      DirectSum.of
        (fun e ↦ idealAssociatedGradedRingGrade I e) d x := by
  rcases x.2 with ⟨q, hq, hqx⟩
  have hx :
      (idealAssociatedGradedRingOwnerComponentMap (R := R) I d ⟨q, hq⟩ :
        idealAssociatedGradedRingGrade I d) = x := by
    exact Subtype.ext hqx
  have hcomp :
      idealAssociatedGradedRing_decomposeAlgHom (R := R) I
          (Ideal.Quotient.mk (idealAssociatedGradedRingDefiningIdeal (R := R) I) q) =
        idealAssociatedGradedRing_predecomposeAlgHom (R := R) I q := by
    -- Evaluate the quotient-descended decomposition back on the chosen homogeneous Rees lift.
    simpa [AlgHom.comp_apply] using
      AlgHom.congr_fun
        (idealAssociatedGradedRing_decomposeAlgHom_comp_mk (R := R) I) q
  calc
    idealAssociatedGradedRing_decomposeAlgHom (R := R) I (x : idealAssociatedGradedRing I) =
        idealAssociatedGradedRing_decomposeAlgHom (R := R) I
          (Ideal.Quotient.mk (idealAssociatedGradedRingDefiningIdeal (R := R) I) q) := by
            simpa using
              congrArg
                (idealAssociatedGradedRing_decomposeAlgHom (R := R) I)
                hqx.symm
    _ = DirectSum.of
          (fun e ↦ idealAssociatedGradedRingGrade I e) d
          ((idealAssociatedGradedRingOwnerComponentMap (R := R) I d) ⟨q, hq⟩) := by
        rw [hcomp]
        exact idealAssociatedGradedRing_predecomposeAlgHom_eq_of_mem_grade (R := R) I hq
    _ = DirectSum.of
          (fun e ↦ idealAssociatedGradedRingGrade I e) d x := by
        simpa [hx]

end Ideal
