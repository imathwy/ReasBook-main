variable (I : Ideal R)

/-- Helper for Proposition 10.59.5: taking the stage class of a finite sum in a fixed filtration
degree is the sum of the corresponding stage classes. -/
theorem idealAssociatedGradedStageClass_finset_sum_same_degree
    {α : Type*} (I : Ideal R) (n : ℕ) (s : Finset α)
    (a : α → RingTheory.Sequence.idealAssociatedGradedStage I R n) :
    idealAssociatedGradedStageClass (R := R) I n (s.sum fun i ↦ a i) =
      s.sum (fun i ↦ idealAssociatedGradedStageClass (R := R) I n (a i)) :=
by
  classical
  have hadd :
      ∀ x y : RingTheory.Sequence.idealAssociatedGradedStage I R n,
        idealAssociatedGradedStageClass (R := R) I n (x + y) =
          idealAssociatedGradedStageClass (R := R) I n x +
            idealAssociatedGradedStageClass (R := R) I n y := by
    intro x y
    -- Compare the two quotient-Rees representatives before passing to the quotient.
    change
      Ideal.Quotient.mk (Ideal.map (algebraMap R (reesAlgebra I)) I)
          (⟨Polynomial.monomial n ((x + y : RingTheory.Sequence.idealAssociatedGradedStage I R n) : R),
            ideal_associated_graded_stage_monomial_mem (R := R) I n (x + y)⟩ : reesAlgebra I) =
        Ideal.Quotient.mk (Ideal.map (algebraMap R (reesAlgebra I)) I)
          ((⟨Polynomial.monomial n (x : R),
              ideal_associated_graded_stage_monomial_mem (R := R) I n x⟩ : reesAlgebra I) +
            (⟨Polynomial.monomial n (y : R),
              ideal_associated_graded_stage_monomial_mem (R := R) I n y⟩ : reesAlgebra I))
    congr 1
    apply Subtype.ext
    simpa using map_add (Polynomial.monomial n) (x : R) (y : R)
  -- Induct on the finite sum and use additivity at each insertion step.
  refine Finset.induction_on s ?_ ?_
  · change
      Ideal.Quotient.mk (Ideal.map (algebraMap R (reesAlgebra I)) I)
          (⟨Polynomial.monomial n (0 : R),
            ideal_associated_graded_stage_monomial_mem (R := R) I n 0⟩ : reesAlgebra I) =
        Ideal.Quotient.mk (Ideal.map (algebraMap R (reesAlgebra I)) I) 0
    congr 1
    apply Subtype.ext
    simp
  · intro i s hi hs
    simp [Finset.sum_insert, hi, hs, hadd]

/-- Helper for Proposition 10.59.5: every positive-degree stage class of `gr_I(R)` lies in the
ideal generated by the degree-one owner piece. -/
lemma positive_degree_stageClass_mem_span_degree_one
    (I : Ideal R) {n : ℕ}
    (hn : 0 < n)
    (x : RingTheory.Sequence.idealAssociatedGradedStage I R n) :
    idealAssociatedGradedStageClass (R := R) I n x ∈
      Ideal.span (idealAssociatedGradedRingGrade I 1 : Set (idealAssociatedGradedRing I)) :=
by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  let J : Ideal (idealAssociatedGradedRing I) :=
    Ideal.span (idealAssociatedGradedRingGrade I 1 : Set (idealAssociatedGradedRing I))
  have hstage :
      ∀ {z : R},
        z ∈ I • (RingTheory.Sequence.idealAssociatedGradedStage I R m : Submodule R R) →
          z ∈ RingTheory.Sequence.idealAssociatedGradedStage I R (Nat.succ m) := by
    intro z hz
    change z ∈ (I ^ Nat.succ m • (⊤ : Submodule R R))
    change z ∈ I • ((I ^ m) • (⊤ : Submodule R R)) at hz
    simpa [RingTheory.Sequence.idealAssociatedGradedStage, pow_succ', mul_smul] using hz
  have hx' :
      (x : R) ∈ I • (RingTheory.Sequence.idealAssociatedGradedStage I R m : Submodule R R) := by
    change (x : R) ∈ I • ((I ^ m) • (⊤ : Submodule R R))
    simpa [RingTheory.Sequence.idealAssociatedGradedStage, pow_succ', mul_smul] using x.2
  have hspan :
      ∀ z (hz : z ∈ I • (RingTheory.Sequence.idealAssociatedGradedStage I R m : Submodule R R)),
        idealAssociatedGradedStageClass (R := R) I (Nat.succ m) ⟨z, hstage hz⟩ ∈ J := by
    intro z hz
    refine Submodule.smul_induction_on' hz ?_ ?_
    · intro r hr y hy
      let rr : RingTheory.Sequence.idealAssociatedGradedStage I R 1 :=
        ⟨r, by
          simpa [RingTheory.Sequence.idealAssociatedGradedStage, pow_one, Ideal.smul_eq_mul,
            Ideal.mul_top] using hr⟩
      let ym : RingTheory.Sequence.idealAssociatedGradedStage I R m := ⟨y, hy⟩
      have hrr_mem : idealAssociatedGradedStageClass (R := R) I 1 rr ∈ J := by
        exact Ideal.subset_span (idealAssociatedGradedStageClass_mem_grade (R := R) I 1 rr)
      have hmul_mem :
          idealAssociatedGradedStageClass (R := R) I m ym *
              idealAssociatedGradedStageClass (R := R) I 1 rr ∈ J := by
        exact J.mul_mem_left _ hrr_mem
      have hmul :
          idealAssociatedGradedStageClass (R := R) I (Nat.succ m)
              ⟨((rr : RingTheory.Sequence.idealAssociatedGradedStage I R 1) : R) •
                  ((ym : RingTheory.Sequence.idealAssociatedGradedStage I R m) : R),
                by
                  simpa [Nat.add_comm] using
                    idealAssociatedGradedPiece_smul_mem_stage (R := R) (N := R) I 1 m rr ym⟩ =
            idealAssociatedGradedStageClass (R := R) I m ym *
              idealAssociatedGradedStageClass (R := R) I 1 rr := by
        simpa [smul_eq_mul, mul_comm] using
          idealAssociatedGradedStageClass_mul_local (R := R) I ym rr
      rw [hmul]
      exact hmul_mem
    · intro y hy z hz hy_mem hz_mem
      have hy_stage :
          y ∈ RingTheory.Sequence.idealAssociatedGradedStage I R (Nat.succ m) := hstage hy
      have hz_stage :
          z ∈ RingTheory.Sequence.idealAssociatedGradedStage I R (Nat.succ m) := hstage hz
      have hsum :
          idealAssociatedGradedStageClass (R := R) I (Nat.succ m)
              ⟨y + z, hstage (Submodule.add_mem _ hy hz)⟩ =
            idealAssociatedGradedStageClass (R := R) I (Nat.succ m) ⟨y, hy_stage⟩ +
              idealAssociatedGradedStageClass (R := R) I (Nat.succ m) ⟨z, hz_stage⟩ := by
        -- The stage-class map is additive inside this fixed degree.
        have hadd :=
          congrArg
            (fun t : idealAssociatedGradedRingGrade I (Nat.succ m) =>
              (t : idealAssociatedGradedRing I))
            ((idealAssociatedGradedStageClassLinear (R := R) I (Nat.succ m)).map_add
              ⟨y, hy_stage⟩ ⟨z, hz_stage⟩)
        simpa [idealAssociatedGradedStageClassLinear_apply] using hadd
      rw [hsum]
      exact Ideal.add_mem _ hy_mem hz_mem
  simpa [J] using hspan (x : R) hx'

/-- Helper for Proposition 10.59.5: the irrelevant ideal of `gr_I(R)` is generated by its
degree-one owner piece. -/
lemma idealAssociatedGradedRing_irrelevant_span_degree_one
    (I : Ideal R) :
    Ideal.span (idealAssociatedGradedRingGrade I 1 : Set (idealAssociatedGradedRing I)) =
      (idealAssociatedGradedRingGrade I)₊.toIdeal :=
by
  refine le_antisymm ?_ ?_
  · -- Every degree-one class is, by definition, a positive homogeneous element.
    refine Ideal.span_le.2 ?_
    intro x hx
    exact mem_irrelevant_of_mem (idealAssociatedGradedRingGrade (R := R) I) (by decide) hx
  · -- Expand the irrelevant ideal as the span of all positive homogeneous pieces and reduce each
    -- such piece to a stage class in positive degree.
    rw [HomogeneousIdeal.irrelevant_eq_span]
    change
      Ideal.span
          (⋃ d : ℕ, ⋃ _ : 0 < d, idealAssociatedGradedRingGrade (R := R) I d) ≤
        Ideal.span (idealAssociatedGradedRingGrade I 1 : Set (idealAssociatedGradedRing I))
    refine Ideal.span_le.2 ?_
    intro x hx
    simp only [Set.mem_iUnion] at hx
    rcases hx with ⟨d, hd, hxd⟩
    rcases
      idealAssociatedGradedStageClassLinear_surjective (R := R) I d ⟨x, hxd⟩ with
      ⟨y, hy⟩
    have hxy :
        idealAssociatedGradedStageClass (R := R) I d y = x := by
      have hxy' :=
        congrArg
          (fun z : idealAssociatedGradedRingGrade I d ↦ (z : idealAssociatedGradedRing I))
          hy
      simpa [idealAssociatedGradedStageClassLinear_apply] using hxy'
    rw [← hxy]
    exact positive_degree_stageClass_mem_span_degree_one (R := R) I hd y

-- Helper for Proposition 10.59.5: keep the ambient associated graded module available as an
-- `idealAssociatedGradedRing I`-module while the source-faithful generation lemmas are being
-- stabilized.
/-- Helper for Proposition 10.59.5: the degree-`d` owner piece acts linearly on the degree-`n`
textbook associated graded piece after transporting owner classes through the canonical
owner-piece/textbook-piece equivalence. -/
noncomputable def idealAssociatedGradedPiece_owner_smulLinear
    (I : Ideal R) (d n : ℕ) :
    idealAssociatedGradedRingGrade I d →ₗ[R]
      RingTheory.Sequence.idealAssociatedGradedPiece I M n →ₗ[R]
        RingTheory.Sequence.idealAssociatedGradedPiece I M (d + n) :=
  (idealAssociatedGradedPiece_smulLinear (R := R) (N := M) I d n).comp
    (idealAssociatedGradedRingGrade_pieceLinearEquiv (R := R) I d).toLinearMap

/-- Helper for Proposition 10.59.5: the scalar image of `R` in `gr_I(R)` already lands in the
degree-zero owner piece. -/
noncomputable def idealAssociatedGradedRingGradeZeroAlgebra
    (I : Ideal R) :
    R →ₐ[R] idealAssociatedGradedRingGrade I 0 where
  toFun r :=
    ⟨algebraMap R (idealAssociatedGradedRing I) r, by
      -- The class of a constant polynomial is homogeneous of degree `0`.
      have hmem :
          idealAssociatedGradedStageClass (R := R) I 0
              ⟨r, idealAssociatedGradedStage_zero_mem (R := R) I r⟩ ∈
            idealAssociatedGradedRingGrade I 0 :=
        idealAssociatedGradedStageClass_mem_grade (R := R) I 0
          ⟨r, idealAssociatedGradedStage_zero_mem (R := R) I r⟩
      simpa [idealAssociatedGradedStageClass_zero_eq_algebraMap (R := R) I r] using hmem⟩
  map_one' := by
    apply Subtype.ext
    simp
  map_mul' r s := by
    apply Subtype.ext
    simp
  map_zero' := by
    apply Subtype.ext
    simp
  map_add' r s := by
    apply Subtype.ext
    simp
  commutes' r := by
    apply Subtype.ext
    simp

/-- Helper for Proposition 10.59.5: every degree-zero owner class is represented by the scalar
image of some element of `R`. -/
lemma idealAssociatedGradedRingGradeZeroAlgebra_surjective
    (I : Ideal R) :
    Function.Surjective (idealAssociatedGradedRingGradeZeroAlgebra (R := R) I) := by
  intro x
  rcases idealAssociatedGradedStageClassLinear_surjective (R := R) I 0 x with ⟨r, hr⟩
  refine ⟨(r : R), ?_⟩
  apply Subtype.ext
  -- Forget the subtype: the chosen stage representative already gives the required scalar class.
  have hr' :
      idealAssociatedGradedStageClass (R := R) I 0 r = (x : idealAssociatedGradedRing I) :=
    congrArg (fun z : idealAssociatedGradedRingGrade I 0 ↦ (z : idealAssociatedGradedRing I)) hr
  simpa [idealAssociatedGradedRingGradeZeroAlgebra,
    idealAssociatedGradedStageClass_zero_eq_algebraMap (R := R) I (r : R)] using hr'

/-- Helper for Proposition 10.59.5: the kernel of the scalar map to the degree-zero owner piece is
exactly `I`. -/
lemma idealAssociatedGradedRingGradeZeroAlgebra_ker_eq
    (I : Ideal R) :
    RingHom.ker (idealAssociatedGradedRingGradeZeroAlgebra (R := R) I).toRingHom = I := by
  ext r
  constructor
  · intro hr
    change idealAssociatedGradedRingGradeZeroAlgebra (R := R) I r = 0 at hr
    have hclass :
        idealAssociatedGradedStageClass (R := R) I 0
            ⟨r, idealAssociatedGradedStage_zero_mem (R := R) I r⟩ = 0 := by
      -- Forget the degree-zero subtype and read the equation in the ambient owner ring.
      have hr' :
          (idealAssociatedGradedRingGradeZeroAlgebra (R := R) I r :
            idealAssociatedGradedRing I) = 0 := by
        exact congrArg
          (fun z : idealAssociatedGradedRingGrade I 0 ↦ (z : idealAssociatedGradedRing I)) hr
      change algebraMap R (idealAssociatedGradedRing I) r = 0 at hr'
      rw [← idealAssociatedGradedStageClass_zero_eq_algebraMap (R := R) I r] at hr'
      exact hr'
    have hstage :
        r ∈ RingTheory.Sequence.idealAssociatedGradedStage I R 1 :=
      (associated_graded_stage_class_zero_iff (R := R) I 0
        ⟨r, idealAssociatedGradedStage_zero_mem (R := R) I r⟩).1 hclass
    simpa [RingTheory.Sequence.idealAssociatedGradedStage, pow_one, Ideal.smul_eq_mul,
      Ideal.mul_top] using hstage
  · intro hr
    apply Subtype.ext
    -- Membership in `I` means the degree-zero stage class is zero in the quotient piece.
    change algebraMap R (idealAssociatedGradedRing I) r = 0
    rw [← idealAssociatedGradedStageClass_zero_eq_algebraMap (R := R) I r]
    refine (associated_graded_stage_class_zero_iff (R := R) I 0
      ⟨r, idealAssociatedGradedStage_zero_mem (R := R) I r⟩).2 ?_
    simpa [RingTheory.Sequence.idealAssociatedGradedStage, pow_one, Ideal.smul_eq_mul,
      Ideal.mul_top] using hr

/-- Helper for Proposition 10.59.5: the degree-zero owner piece of `gr_I(R)` is canonically the
quotient ring `R / I`. -/
noncomputable def idealAssociatedGradedRingGradeZeroQuotientBridge
    (I : Ideal R) :
    (R ⧸ I) ≃ₐ[R] idealAssociatedGradedRingGrade I 0 :=
  (Ideal.quotientEquivAlgOfEq R
      (idealAssociatedGradedRingGradeZeroAlgebra_ker_eq (R := R) I).symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective
      (f := idealAssociatedGradedRingGradeZeroAlgebra (R := R) I)
      (idealAssociatedGradedRingGradeZeroAlgebra_surjective (R := R) I))


end Ideal

