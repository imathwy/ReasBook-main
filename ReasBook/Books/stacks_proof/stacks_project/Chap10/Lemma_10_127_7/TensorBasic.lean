import Mathlib

open CategoryTheory Limits
open Algebra.TensorProduct
open scoped TensorProduct

universe u v

noncomputable section

section

variable {A : Type u} [CommRing A]
variable {J : Type v} [SmallCategory J] [IsFiltered J]
variable (F : J ⥤ CommAlgCat.{u} A) [HasColimit F]

variable {B C : Type u} [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]

/-- Helper for Lemma 10.127.7: two algebra maps out of a tensor product agree once they agree on
the left and right tensor factors. -/
lemma tensor_base_change_algHom_ext
    {S R' D : Type u} [CommRing S] [CommRing R'] [CommRing D]
    [Algebra A S] [Algebra A R'] [Algebra A D]
    {φ ψ : S ⊗[A] R' →ₐ[A] D}
    (h_left : φ.comp includeLeft = ψ.comp includeLeft)
    (h_right : φ.comp includeRight = ψ.comp includeRight) :
    φ = ψ := by
  -- Proof comment: the tensor product is generated by the two canonical inclusions.
  exact Algebra.TensorProduct.ext h_left h_right

/-- Helper for Lemma 10.127.7: tensoring the identity on the left leaves the left tensor inclusion
unchanged. -/
@[simp] lemma tensor_map_id_comp_includeLeft
    {S R' R'' : Type u} [CommRing S] [CommRing R'] [CommRing R'']
    [Algebra A S] [Algebra A R'] [Algebra A R'']
    (f : R' →ₐ[A] R'') :
    (Algebra.TensorProduct.map (AlgHom.id A S) f).comp includeLeft = includeLeft := by
  -- Proof comment: the tensor map only changes the right tensor factor, so the left inclusion is
  -- fixed.
  rw [Algebra.TensorProduct.map_comp_includeLeft]
  simp

/-- Helper for Lemma 10.127.7: tensoring the identity on the left carries the right tensor
inclusion along the right-side algebra map. -/
@[simp] lemma tensor_map_id_comp_includeRight
    {S R' R'' : Type u} [CommRing S] [CommRing R'] [CommRing R'']
    [Algebra A S] [Algebra A R'] [Algebra A R'']
    (f : R' →ₐ[A] R'') :
    (Algebra.TensorProduct.map (AlgHom.id A S) f).comp includeRight = includeRight.comp f := by
  -- Proof comment: the tensor map only changes the right tensor factor, so the right inclusion is
  -- transported exactly by `f`.
  rw [Algebra.TensorProduct.map_comp_includeRight]

/-- Helper for Lemma 10.127.7: changing the right tensor factor and changing the left tensor
factor commute. -/
lemma tensor_map_exchange
    {S S' R' R'' : Type u}
    [CommRing S] [CommRing S'] [CommRing R'] [CommRing R'']
    [Algebra A S] [Algebra A S'] [Algebra A R'] [Algebra A R'']
    (f : S →ₐ[A] S')
    (g : R' →ₐ[A] R'') :
    (Algebra.TensorProduct.map (AlgHom.id A S') g).comp
        (Algebra.TensorProduct.map f (AlgHom.id A R')) =
      (Algebra.TensorProduct.map f (AlgHom.id A R'')).comp
        (Algebra.TensorProduct.map (AlgHom.id A S) g) := by
  -- Proof comment: both composites agree on the left and right tensor generators.
  apply tensor_base_change_algHom_ext (A := A)
  · ext s
    simp
  · ext r
    simp

/-- Helper for Lemma 10.127.7: if `v : C → B ⊗[A] R'` is a two-sided inverse on the left tensor
factor, then `productMap v includeRight` is a genuine two-sided inverse on the whole tensor
product. -/
lemma tensor_base_change_productMap_two_sided_inverse
    {R' : Type u} [CommRing R'] [Algebra A R']
    (u : B →ₐ[A] C)
    (v : C →ₐ[A] B ⊗[A] R')
    (hvu : v.comp u = includeLeft)
    (huv : (Algebra.TensorProduct.map u (AlgHom.id A R')).comp v = includeLeft) :
    let w : C ⊗[A] R' →ₐ[A] B ⊗[A] R' := Algebra.TensorProduct.productMap v includeRight
    w.comp (Algebra.TensorProduct.map u (AlgHom.id A R')) = AlgHom.id A _ ∧
      (Algebra.TensorProduct.map u (AlgHom.id A R')).comp w = AlgHom.id A _ := by
  let w : C ⊗[A] R' →ₐ[A] B ⊗[A] R' := Algebra.TensorProduct.productMap v includeRight
  constructor
  · -- Proof comment: check the left inverse relation on the tensor generators of `B ⊗[A] R'`.
    apply tensor_base_change_algHom_ext (A := A)
    · calc
        (w.comp (Algebra.TensorProduct.map u (AlgHom.id A R'))).comp includeLeft =
            w.comp ((Algebra.TensorProduct.map u (AlgHom.id A R')).comp includeLeft) := rfl
        _ = w.comp (includeLeft.comp u) := by
              rw [Algebra.TensorProduct.map_comp_includeLeft]
        _ = (w.comp includeLeft).comp u := rfl
        _ = includeLeft := by
              simp [w, hvu]
    · calc
        (w.comp (Algebra.TensorProduct.map u (AlgHom.id A R'))).comp includeRight =
            w.comp ((Algebra.TensorProduct.map u (AlgHom.id A R')).comp includeRight) := rfl
        _ = w.comp (includeRight.comp (AlgHom.id A R')) := by
              rw [Algebra.TensorProduct.map_comp_includeRight]
        _ = w.comp includeRight := by
              simp
        _ = includeRight := by
              simp [w]
  · -- Proof comment: check the right inverse relation on the tensor generators of `C ⊗[A] R'`.
    apply tensor_base_change_algHom_ext (A := A)
    · calc
        ((Algebra.TensorProduct.map u (AlgHom.id A R')).comp w).comp includeLeft =
            (Algebra.TensorProduct.map u (AlgHom.id A R')).comp (w.comp includeLeft) := rfl
        _ = (Algebra.TensorProduct.map u (AlgHom.id A R')).comp v := by
              simp [w]
        _ = includeLeft := huv
    · calc
        ((Algebra.TensorProduct.map u (AlgHom.id A R')).comp w).comp includeRight =
            (Algebra.TensorProduct.map u (AlgHom.id A R')).comp (w.comp includeRight) := rfl
        _ = (Algebra.TensorProduct.map u (AlgHom.id A R')).comp includeRight := by
              simp [w]
        _ = includeRight := by
              rw [Algebra.TensorProduct.map_comp_includeRight]
              simp

/-- Helper for Lemma 10.127.7: if finitely many algebra generators of `C` already have preimages
under the tensor-base-change map `B ⊗[A] R' → C ⊗[A] R'`, then that map is surjective. -/
lemma tensor_map_surjective_of_generator_preimages
    {R' : Type u} [CommRing R'] [Algebra A R']
    (u : B →ₐ[A] C)
    (s : Finset C)
    (hs :
      letI : Algebra B C := u.toRingHom.toAlgebra
      Algebra.adjoin B (s : Set C) = ⊤)
    (hpre :
      ∀ x ∈ s, ∃ b : B ⊗[A] R',
        (Algebra.TensorProduct.map u (AlgHom.id A R')) b = x ⊗ₜ[A] (1 : R')) :
    Function.Surjective (Algebra.TensorProduct.map u (AlgHom.id A R')) := by
  letI : Algebra B C := u.toRingHom.toAlgebra
  let S := B ⊗[A] R'
  let T := S ⊗[B] C
  letI : Algebra S T := Algebra.TensorProduct.leftAlgebra
  let α : S →ₐ[S] T := Algebra.ofId S T
  let e :=
    (Algebra.TensorProduct.comm (R := B) (A := S) (B := C)).toRingEquiv.trans
      (Algebra.TensorProduct.cancelBaseChange
        (R := A) (S := B) (T := C) (A := C) (B := R')).toRingEquiv
  let ψ := Algebra.TensorProduct.map u (AlgHom.id A R')
  have he : e.toRingHom.comp α.toRingHom = ψ.toRingHom := by
    -- Proof comment: the standard `comm` plus `cancelBaseChange` transport identifies the
    -- literal base change along `B → B ⊗[A] R'` with the tensor map in the statement.
    apply RingHom.ext
    intro z
    refine TensorProduct.induction_on z ?_ ?_ ?_
    · simp [α, ψ]
    · intro b a
      change
        (Algebra.TensorProduct.cancelBaseChange
          (R := A) (S := B) (T := C) (A := C) (B := R'))
          ((Algebra.TensorProduct.comm (R := B) (A := S) (B := C))
            ((((b ⊗ₜ[A] a) : S) ⊗ₜ[B] (1 : C)))) =
          u b ⊗ₜ[A] a
      simp [S, Algebra.smul_def]
      simpa using
        (show (algebraMap B C) b ⊗ₜ[A] a = u b ⊗ₜ[A] a from rfl)
    · intro z₁ z₂ hz₁ hz₂
      rw [RingHom.map_add, RingHom.map_add, hz₁, hz₂]
  have hincludeRight (x : C) :
      e (Algebra.TensorProduct.includeRight (R := B) (A := S) (B := C) x) =
        x ⊗ₜ[A] (1 : R') := by
    -- Proof comment: the transport sends the right tensor generator `1 ⊗ x` to the expected
    -- pure tensor `x ⊗ 1` in `C ⊗[A] R'`.
    change
      (Algebra.TensorProduct.cancelBaseChange
        (R := A) (S := B) (T := C) (A := C) (B := R'))
        ((Algebra.TensorProduct.comm (R := B) (A := S) (B := C))
          (((1 : S) ⊗ₜ[B] x))) =
        x ⊗ₜ[A] (1 : R')
    rw [Algebra.TensorProduct.comm_tmul]
    change
      (Algebra.TensorProduct.cancelBaseChange
        (R := A) (S := B) (T := C) (A := C) (B := R'))
        (x ⊗ₜ[B] (((1 : B) ⊗ₜ[A] (1 : R')) : S)) =
        x ⊗ₜ[A] (1 : R')
    simpa [S, Algebra.smul_def] using
      (Algebra.TensorProduct.cancelBaseChange_tmul
        (R := A) (S := B) (T := C) (A := C) (B := R')
        x (1 : B) (1 : R'))
  have hgen :
      Algebra.adjoin S (((1 : S) ⊗ₜ[B] ·) '' (s : Set C)) = ⊤ := by
    -- Proof comment: the same finite generating set still generates after base change.
    simpa [S] using
      Algebra.TensorProduct.adjoin_one_tmul_image_eq_top (A := S) (s := (s : Set C)) hs
  have hmem :
      ∀ x ∈ s,
        Algebra.TensorProduct.includeRight (R := B) (A := S) (B := C) x ∈ α.range := by
    -- Proof comment: each chosen generator is the transport of one prescribed preimage of
    -- `x ⊗ 1`, so it already lies in the literal base-change image.
    intro x hx
    rcases hpre x hx with ⟨b, hb⟩
    refine (AlgHom.mem_range α).2 ⟨b, ?_⟩
    apply e.injective
    calc
      e (α b) = ψ b := by
        simpa [α] using congrArg (fun g : S →+* (C ⊗[A] R') ↦ g b) he
      _ = x ⊗ₜ[A] (1 : R') := hb
      _ = e (Algebra.TensorProduct.includeRight (R := B) (A := S) (B := C) x) :=
        (hincludeRight x).symm
  have hrange : α.range = ⊤ := by
    -- Proof comment: the range is an `S`-subalgebra containing the literal base-change
    -- generators, hence it is all of `S ⊗[B] C`.
    apply top_unique
    rw [← hgen]
    exact Algebra.adjoin_le_iff.mpr fun y hy ↦ by
      rcases hy with ⟨x, hx, rfl⟩
      simpa [S] using hmem x hx
  have hαsurj : Function.Surjective α := (AlgHom.range_eq_top α).mp hrange
  intro z
  obtain ⟨t, rfl⟩ := e.surjective z
  obtain ⟨b, hb⟩ := hαsurj t
  refine ⟨b, ?_⟩
  calc
    ψ b = e (α b) := by
      symm
      simpa [α] using congrArg (fun g : S →+* (C ⊗[A] R') ↦ g b) he
    _ = e t := by rw [hb]

end
