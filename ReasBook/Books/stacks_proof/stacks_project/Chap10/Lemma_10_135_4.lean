noncomputable section

open Algebra Algebra.Extension RingTheory Sequence IsLocalRing

universe u v

section

variable {k : Type u} [Field k]
variable {S : Type v} [CommRing S] [Algebra k S]
variable {n c : ℕ}

/-- Some basic open neighbourhood of `q` is a global complete intersection over `k`. -/
abbrev isGlobalCompleteIntersectionNearPrime
    (K : Type u) [Field K] {S : Type v} [CommRing S] [Algebra K S] (q : PrimeSpectrum S) : Prop :=
  ∃ g : S, g ∉ q.asIdeal ∧ IsGlobalCompleteIntersection K (Localization.Away g)

/-- Some basic open neighbourhood of `q` is a local complete intersection over `k`. -/
abbrev isLocalCompleteIntersectionNearPrime
    (K : Type u) [Field K] {S : Type v} [CommRing S] [Algebra K S] (q : PrimeSpectrum S) : Prop :=
  ∃ g : S, g ∉ q.asIdeal ∧ IsLocalCompleteIntersection K (Localization.Away g)

namespace PolynomialPresentationAtPrime

/-- The prime of the chosen polynomial presentation lying over `q`. -/
abbrev prime
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    PrimeSpectrum (MvPolynomial (Fin n) k) :=
  PrimeSpectrum.comap π.toRingHom q

/-- The localization of the polynomial ring at the prime lying over `q`. -/
abbrev localRing
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) : Type u :=
  Localization.AtPrime (prime π q).asIdeal

/-- The localized kernel ideal `I_{q'}` of the chosen polynomial presentation. -/
abbrev localizedKernelIdeal
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    Ideal (localRing π q) :=
  Ideal.map
    (algebraMap (MvPolynomial (Fin n) k) (localRing π q))
    (RingHom.ker π.toRingHom)

/-- The quotient local ring `k[x₁, …, xₙ]_{q'} / I_{q'}` canonically modeling `S_q`. -/
abbrev localQuotientRing
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    Type _ :=
  localRing π q ⧸ localizedKernelIdeal π q

/-- The localized conormal module `(I_{q'} / I_{q'}²)` of the localized kernel ideal. -/
abbrev localizedConormalModule
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    Type _ :=
  (localizedKernelIdeal π q).Cotangent

/-- The localized kernel ideal of the chosen presentation is generated by `c` elements. -/
abbrev kernelGeneratedByCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) (c : ℕ) : Prop :=
  ∃ xs : Fin c → localRing π q,
    Ideal.span (Set.range xs) = localizedKernelIdeal π q

/-- The localized conormal module of the chosen presentation is generated by `c` elements. -/
abbrev conormalGeneratedByCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) (c : ℕ) : Prop :=
  ∃ xs : Fin c → localizedConormalModule π q,
    Submodule.span (localQuotientRing π q) (Set.range xs) = ⊤

/-- The localized conormal module of the chosen presentation is free of rank `c` over the
canonical quotient model `k[x₁, …, xₙ]_{q'} / I_{q'}` of `S_q`. -/
abbrev conormalFreeCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) (c : ℕ) : Prop :=
  Nonempty
    (Module.Basis (Fin c) (localQuotientRing π q) (localizedConormalModule π q))

/-- The localized kernel ideal of the chosen presentation is generated by a regular sequence of
length `c`. -/
abbrev kernelGeneratedByRegularSequenceCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) (c : ℕ) : Prop :=
  ∃ xs : Fin c → localRing π q,
    Sequence.IsRegular (localRing π q) (List.ofFn xs) ∧
      Ideal.span (Set.range xs) = localizedKernelIdeal π q

/-- Helper for Chap10 Lemma 10 135 4: a five-term TFAE follows from the directed implication
cycle used in the source proof. -/
private theorem tfae_five_of_source_cycle
    {A B C D E : Prop} (hAD : A → D) (hDC : D → C) (hCB : C → B)
    (hBE : B → E) (hEA : E → A) :
    List.TFAE [A, B, C, D, E] := by
  -- Proof comment: unfold `TFAE` into pairwise equivalence; every pair is connected by walking
  -- around the directed source cycle `A -> D -> C -> B -> E -> A`.
  rw [List.TFAE]
  intro x hx y hy
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hx hy
  tauto

/-- Helper for Chap10 Lemma 10 135 4: a regular generating family in particular generates the
localized kernel ideal. -/
private theorem kernelGeneratedByCondition_of_regularSequenceCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    kernelGeneratedByRegularSequenceCondition π q c → kernelGeneratedByCondition π q c := by
  -- Proof comment: discard the regularity proof and keep the same spanning family.
  rintro ⟨xs, _hxsreg, hxs⟩
  refine ⟨xs, ?_⟩
  exact hxs

/-- Helper for Chap10 Lemma 10 135 4: a basis of the localized conormal module gives a spanning
family of the same cardinality. -/
private theorem conormalGeneratedByCondition_of_conormalFreeCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    conormalFreeCondition π q c → conormalGeneratedByCondition π q c := by
  -- Proof comment: use the basis vectors as conormal generators.
  rintro ⟨b⟩
  have hbspan :
      Submodule.span (localQuotientRing π q) (Set.range b) = ⊤ := by
    simpa using b.span_eq
  refine ⟨b, ?_⟩
  exact hbspan

/-- Helper for Chap10 Lemma 10 135 4: the localized presentation kernel is contained in the
Jacobson radical of the localized polynomial ring. -/
private theorem localizedKernelIdeal_le_jacobson
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    localizedKernelIdeal π q ≤ Ring.jacobson (localRing π q) := by
  -- Proof comment: the original kernel maps into the prime over `q`, whose localization is the
  -- maximal ideal; in a local ring this is the Jacobson radical.
  have hker_le : RingHom.ker π.toRingHom ≤ (prime π q).asIdeal := by
    intro x hx
    rw [RingHom.mem_ker] at hx
    change π.toRingHom x ∈ q.asIdeal
    rw [hx]
    exact q.asIdeal.zero_mem
  calc
    localizedKernelIdeal π q ≤
        Ideal.map (algebraMap (MvPolynomial (Fin n) k) (localRing π q))
          (prime π q).asIdeal := by
      exact Ideal.map_mono hker_le
    _ = maximalIdeal (localRing π q) := by
      exact Localization.AtPrime.map_eq_maximalIdeal
    _ ≤ Ring.jacobson (localRing π q) := by
      rw [IsLocalRing.ringJacobson_eq_maximalIdeal]

/-- Helper for Chap10 Lemma 10 135 4: a finite list built from a `Fin`-indexed family
generates the same ideal as the range of that family. -/
private theorem ideal_ofList_ofFn_eq_span_range {R : Type*} [CommRing R] {c : ℕ}
    (xs : Fin c → R) :
    Ideal.ofList (List.ofFn xs) = Ideal.span (Set.range xs) := by
  -- Proof comment: both ideal presentations have the same underlying generating set.
  rw [Ideal.ofList]
  congr
  ext x
  constructor
  · intro hx
    rcases List.mem_ofFn.mp hx with ⟨i, rfl⟩
    exact ⟨i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact List.mem_ofFn.mpr ⟨i, rfl⟩

/-- Helper for Chap10 Lemma 10 135 4: in a Cohen-Macaulay local ring, `c` generators of an
ideal in the Jacobson radical form a regular sequence once the expected dimension formula holds. -/
private theorem isRegular_of_fin_generators_dimension_eq
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    [Module.CohenMacaulay R R] {c : ℕ} {I : Ideal R} {xs : Fin c → R}
    (hxs : Ideal.span (Set.range xs) = I) (hIjac : I ≤ Ring.jacobson R)
    (hdim : ringKrullDim (R ⧸ I) + c = ringKrullDim R) :
    Sequence.IsRegular R (List.ofFn xs) := by
  -- Proof comment: the Jacobson containment supplies the maximal-ideal side condition required
  -- by the Cohen-Macaulay regular-sequence criterion.
  have hImax : I ≤ maximalIdeal R := by
    simpa [IsLocalRing.ringJacobson_eq_maximalIdeal] using hIjac
  have hxs_mem : ∀ x ∈ List.ofFn xs, x ∈ maximalIdeal R := by
    intro x hx
    rcases List.mem_ofFn.mp hx with ⟨i, rfl⟩
    exact hImax (by
      rw [← hxs]
      exact Ideal.subset_span (Set.mem_range_self i))
  have hquot :
      ringKrullDim (R ⧸ Ideal.ofList (List.ofFn xs)) + (List.ofFn xs).length =
        ringKrullDim R := by
    have hxs_ofList : Ideal.ofList (List.ofFn xs) = I := by
      rw [ideal_ofList_ofFn_eq_span_range, hxs]
    rw [hxs_ofList, List.length_ofFn]
    exact hdim
  -- Proof comment: apply the local Cohen-Macaulay expected-codimension criterion.
  exact (isRegular_iff_ringKrullDim_quotient_add_length_eq hxs_mem).mpr hquot

/-- Helper for Chap10 Lemma 10 135 4: generators of an ideal generate its cotangent module. -/
private theorem conormalGeneratedByCondition_of_kernelGeneratedByCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    kernelGeneratedByCondition π q c → conormalGeneratedByCondition π q c := by
  -- Proof comment: send the given ideal generators through the quotient map `I → I / I^2`.
  rintro ⟨xs, hxs⟩
  let I : Ideal (localRing π q) := localizedKernelIdeal π q
  have hspan_le : Ideal.span (Set.range xs) ≤ I := by
    simpa [I, hxs]
  have hmem : ∀ i, xs i ∈ I := by
    intro i
    exact hspan_le (Ideal.subset_span (Set.mem_range_self i))
  let ys : Fin c → localizedConormalModule π q := fun i =>
    I.toCotangent ⟨xs i, hmem i⟩
  refine ⟨ys, ?_⟩
  apply Submodule.eq_top_iff'.2
  intro z
  obtain ⟨y, rfl⟩ := I.toCotangent_surjective z
  have hyspan : (y : localRing π q) ∈ Ideal.span (Set.range xs) := by
    simpa [I, hxs] using y.2
  -- Proof comment: span-induct in the ideal, transporting each operation through
  -- `Ideal.toCotangent` and the quotient scalar action.
  refine Submodule.span_induction
    (p := fun x hx => I.toCotangent ⟨x, hspan_le hx⟩ ∈
      Submodule.span (localQuotientRing π q) (Set.range ys))
    ?mem ?zero ?add ?smul hyspan
  · intro x hx
    rcases hx with ⟨i, rfl⟩
    exact Submodule.subset_span (Set.mem_range_self i)
  · dsimp
    convert Submodule.zero_mem (Submodule.span (localQuotientRing π q) (Set.range ys)) using 1
  · intro x y hx hy hxmem hymem
    dsimp
    convert Submodule.add_mem _ hxmem hymem using 1
  · intro a x hx hxmem
    dsimp
    have hx' := Submodule.smul_mem
      (Submodule.span (localQuotientRing π q) (Set.range ys))
      (Ideal.Quotient.mk I a) hxmem
    convert hx' using 1

/-- Helper for Chap10 Lemma 10 135 4: Nakayama lifts cotangent generators to ideal generators
when the ideal lies in the Jacobson radical. -/
private theorem ideal_generated_of_cotangent_span_top
    {R : Type u} [CommRing R] [IsNoetherianRing R] (I : Ideal R)
    (hIjac : I ≤ Ring.jacobson R) {c : ℕ} :
    (∃ xs : Fin c → I.Cotangent,
      Submodule.span (R ⧸ I) (Set.range xs) = ⊤) →
    ∃ ys : Fin c → R, Ideal.span (Set.range ys) = I := by
  -- Proof comment: choose lifts in `I`, convert quotient-span over `R/I` to quotient-span over
  -- `R`, apply Nakayama, and then map the resulting span in the subtype back to the ideal.
  rintro ⟨xs, hxs⟩
  classical
  letI : IsScalarTower R (R ⧸ I) I.Cotangent := Module.IsTorsionBySet.isScalarTower _
  choose ysI hysI using fun i => I.toCotangent_surjective (xs i)
  let s : Finset I := Finset.univ.image ysI
  have hspanQ :
      Submodule.span (R ⧸ I) (Set.range fun i => I.toCotangent (ysI i)) = ⊤ := by
    simpa [hysI] using hxs
  have hspanR : Submodule.span R (Set.range fun i => I.toCotangent (ysI i)) = ⊤ := by
    have hrestrict := congrArg (Submodule.restrictScalars R) hspanQ
    simpa [Submodule.restrictScalars_span (R := R) (A := R ⧸ I) (M := I.Cotangent)
        (Ideal.Quotient.mk_surjective) (Set.range fun i => I.toCotangent (ysI i))]
      using hrestrict
  have hquotSet :
      (I • (⊤ : Submodule R I)).mkQ '' (s : Set I) =
        Set.range (fun i => I.toCotangent (ysI i)) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      rcases Finset.mem_image.mp hy with ⟨i, _hi, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      refine ⟨ysI i, ?_, rfl⟩
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
  have hquot :
      Submodule.span R ((I • (⊤ : Submodule R I)).mkQ '' (s : Set I)) = ⊤ := by
    rw [hquotSet]
    simpa [Ideal.toCotangent] using hspanR
  have htop : Submodule.span R (s : Set I) = ⊤ :=
    span_eq_top_of_quotient_span_eq_top_of_le_ring_jacobson (I := I) s hquot hIjac
  refine ⟨fun i => (ysI i : R), ?_⟩
  have hmap := congrArg (Submodule.map I.subtype) htop
  have hsimage : I.subtype '' (s : Set I) = Set.range (fun i => (ysI i : R)) := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      rcases Finset.mem_image.mp hy with ⟨i, _hi, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      refine ⟨ysI i, ?_, rfl⟩
      exact Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
  rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype] at hmap
  rw [hsimage] at hmap
  exact hmap

/-- Helper for Chap10 Lemma 10 135 4: the presentation map carries the complement of the
contracted prime exactly onto the complement of `q`. -/
private theorem primeCompl_map_eq
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : PrimeSpectrum S) :
    Submonoid.map π.toRingHom (prime π q).asIdeal.primeCompl = q.asIdeal.primeCompl := by
  -- Proof comment: one inclusion is the definition of contraction; the other uses surjectivity
  -- to lift a denominator in `S` to the polynomial ring.
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact hx
  · intro hy
    rcases hπ y with ⟨x, rfl⟩
    exact ⟨x, hy, rfl⟩

/-- Helper for Chap10 Lemma 10 135 4: the kernel of the localized presentation map is the
localized kernel ideal used in the statement. -/
private theorem ker_localRingHom_eq
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : PrimeSpectrum S) :
    RingHom.ker (Localization.localRingHom (prime π q).asIdeal q.asIdeal π.toRingHom rfl) =
      localizedKernelIdeal π q := by
  -- Proof comment: `IsLocalization.ker_map` computes the kernel after localization once the
  -- denominator submonoids have been identified by `primeCompl_map_eq`.
  simpa [localRing, localizedKernelIdeal, Localization.localRingHom] using
    (IsLocalization.ker_map
      (S := Localization.AtPrime (prime π q).asIdeal)
      (Q := Localization.AtPrime q.asIdeal)
      (g := π.toRingHom)
      (primeCompl_map_eq π hπ q))

/-- Helper for Chap10 Lemma 10 135 4: the localized presentation map remains surjective. -/
private theorem localRingHom_surjective
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : PrimeSpectrum S) :
    Function.Surjective
      (Localization.localRingHom (prime π q).asIdeal q.asIdeal π.toRingHom rfl) := by
  -- Proof comment: localization preserves surjectivity because the denominator submonoids match.
  intro y
  rcases IsLocalization.exists_mk'_eq q.asIdeal.primeCompl y with ⟨a, s, rfl⟩
  rcases hπ a with ⟨x, rfl⟩
  rcases hπ s with ⟨t, ht⟩
  let t' : (prime π q).asIdeal.primeCompl := ⟨t, by
    intro htmem
    exact s.2 (by
      change π.toRingHom t ∈ q.asIdeal at htmem
      simpa [ht] using htmem)⟩
  refine ⟨IsLocalization.mk' (localRing π q) x t', ?_⟩
  rw [Localization.localRingHom_mk']
  have hs_eq :
      (⟨π.toRingHom t, by
        exact Localization.le_comap_primeCompl_iff.mpr
          (ge_of_eq (rfl : (prime π q).asIdeal = q.asIdeal.comap π.toRingHom)) t'.2⟩ :
        q.asIdeal.primeCompl) = s := by
    exact Subtype.ext ht
  rw [hs_eq]
  rfl

/-- Helper for Chap10 Lemma 10 135 4: generators of the localized kernel ideal are exactly
generators of the kernel of the localized presentation map. -/
private theorem localRingHom_kernelGeneratedByCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : PrimeSpectrum S) :
    kernelGeneratedByCondition π q c →
      ∃ xs : Fin c → localRing π q,
        Ideal.span (Set.range xs) =
          RingHom.ker
            (Localization.localRingHom (prime π q).asIdeal q.asIdeal π.toRingHom rfl) := by
  -- Proof comment: keep the same finite family and rewrite only the kernel spelling through the
  -- localized-presentation kernel computation.
  rintro ⟨xs, hxs⟩
  refine ⟨xs, ?_⟩
  rw [hxs, ← ker_localRingHom_eq π hπ q]

/-- Helper for Chap10 Lemma 10 135 4: the quotient local ring of the presentation is the local
ring `S_q`. -/
private noncomputable def localQuotientRingEquivAtPrime
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : PrimeSpectrum S) :
    localQuotientRing π q ≃+* Localization.AtPrime q.asIdeal :=
  (Ideal.quotientEquivAlgOfEq ℤ (ker_localRingHom_eq π hπ q).symm).toRingEquiv.trans
    (RingHom.quotientKerEquivOfSurjective (localRingHom_surjective π hπ q))

/-- Helper for Chap10 Lemma 10 135 4: the localized presentation map has kernel generated by
the same regular sequence that generates the localized kernel ideal. -/
private theorem localRingHom_kernelIsGeneratedByRegularSequence
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : PrimeSpectrum S) :
    kernelGeneratedByRegularSequenceCondition π q c →
      RingHom.KernelIsGeneratedByRegularSequence
        (Localization.localRingHom (prime π q).asIdeal q.asIdeal π.toRingHom rfl) := by
  -- Proof comment: normalize the `Fin`-indexed localized generators to the list format used by
  -- `RingHom.KernelIsGeneratedByRegularSequence`, then rewrite the kernel spelling once.
  rintro ⟨xs, hxsreg, hxs⟩
  refine ⟨List.ofFn xs, hxsreg, ?_⟩
  rw [ideal_ofList_ofFn_eq_span_range, hxs, ← ker_localRingHom_eq π hπ q]

/-- Helper for Chap10 Lemma 10 135 4: the localized polynomial source at the prime over `q` is a
regular local ring. -/
private theorem localRing_isRegularLocalRing
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    IsRegularLocalRing (localRing π q) := by
  -- Proof comment: polynomial rings over fields are regular rings, and regular rings have
  -- regular localizations at every prime.
  exact IsRegularRing.isRegularLocalRing_atPrime (prime π q)

/-- Helper for Chap10 Lemma 10 135 4: the localized polynomial source is essentially of finite
type over the base field. -/
private theorem localRing_essFiniteType
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    Algebra.EssFiniteType k (localRing π q) := by
  -- Proof comment: localization preserves essential finite type for the finite polynomial
  -- algebra over `k`.
  infer_instance

/-- Helper for Chap10 Lemma 10 135 4: a global complete-intersection neighbourhood gives the
expected free conormal module for the chosen localized presentation. -/
private theorem conormalFreeCondition_of_globalNear
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (_ : Function.Surjective π) (q : PrimeSpectrum S)
    (_ : (prime π q).asIdeal.height - q.asIdeal.height = c) :
    isGlobalCompleteIntersectionNearPrime k q → conormalFreeCondition π q c :=
  -- Route correction: do not compare the global chart conormal module directly with the chosen
  -- presentation. The stable route should factor through the owner predicate
  -- `Algebra.IsCompleteIntersectionOver k (Localization.AtPrime q.asIdeal)`, then transfer to the
  -- chosen localized regular-kernel presentation and apply the conormal-basis theorem for regular
  -- sequence ideals.
  -- TODO: provide the owner-level stalk complete-intersection bridge and the regular-sequence
  -- conormal-basis theorem in the dependency-closed prefix.
  sorry

/-- Helper for Chap10 Lemma 10 135 4: Nakayama identifies generators of the localized kernel
with generators of its conormal module. -/
private theorem kernelGeneratedByCondition_iff_conormalGeneratedByCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    kernelGeneratedByCondition π q c ↔ conormalGeneratedByCondition π q c := by
  -- Proof comment: one direction maps ideal generators to conormal generators; the other applies
  -- Nakayama after lifting conormal generators and using the Jacobson containment above.
  constructor
  · exact conormalGeneratedByCondition_of_kernelGeneratedByCondition π q
  · intro h
    exact ideal_generated_of_cotangent_span_top (localizedKernelIdeal π q)
      (localizedKernelIdeal_le_jacobson π q) h

/-- Helper for Chap10 Lemma 10 135 4: the height-defect hypothesis gives the quotient dimension
formula for the localized presentation kernel. -/
private theorem localQuotientRing_ringKrullDim_add_eq_of_height_sub
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π) (q : PrimeSpectrum S)
    (hc : (prime π q).asIdeal.height - q.asIdeal.height = c) :
    ringKrullDim (localQuotientRing π q) + c = ringKrullDim (localRing π q) := by
  -- Proof comment: replace the presentation quotient by `S_q`, then rewrite both local
  -- dimensions as heights and use the height-defect hypothesis.
  rw [ringKrullDim_eq_of_ringEquiv (localQuotientRingEquivAtPrime π hπ q)]
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height q.asIdeal
    (Localization.AtPrime q.asIdeal)]
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height (prime π q).asIdeal (localRing π q)]
  have hheight_le : q.asIdeal.height ≤ (prime π q).asIdeal.height := by
    -- Proof comment: surjectivity makes contraction on spectra strictly monotone, so height can
    -- only increase when passing to the polynomial presentation prime.
    simpa [Ideal.height_eq_primeHeight, Ideal.primeHeight, prime] using
      (Order.height_le_height_apply_of_strictMono
        (PrimeSpectrum.comap π.toRingHom)
        (RingHom.strictMono_comap_of_surjective hπ)
        q)
  calc
    (q.asIdeal.height : WithBot ℕ∞) + (c : WithBot ℕ∞) =
        (q.asIdeal.height : WithBot ℕ∞) +
          (((prime π q).asIdeal.height - q.asIdeal.height : ℕ∞) : WithBot ℕ∞) := by
      rw [show (((prime π q).asIdeal.height - q.asIdeal.height : ℕ∞) : WithBot ℕ∞) =
          (c : WithBot ℕ∞) by
        exact_mod_cast hc]
    _ = ((prime π q).asIdeal.height : WithBot ℕ∞) := by
      exact_mod_cast (add_tsub_cancel_of_le hheight_le)

/-- Helper for Chap10 Lemma 10 135 4: every field is a Cohen-Macaulay ring. -/
private theorem field_cohenMacaulayRing (K : Type*) [Field K] : CohenMacaulayRing K := by
  -- Proof comment: a field is a regular local ring; since the self-module has full support,
  -- the local Cohen-Macaulay statement upgrades to the global ring owner.
  letI : Module.CohenMacaulay K K := regularLocalRing_selfModule_cohenMacaulay
  have hsupport : Module.support K K = Set.univ := by
    have hker : RingHom.ker (RingHom.id K) = (⊥ : Ideal K) := by
      ext x
      simp
    simpa [hker, PrimeSpectrum.zeroLocus_bot] using
      (show Module.support K K = PrimeSpectrum.zeroLocus (RingHom.ker (algebraMap K K)) from
        Module.support_of_algebra)
  letI : Module.LocallyCohenMacaulay K K :=
    Module.locallyCohenMacaulay_of_cohenMacaulay K K hsupport
  exact CohenMacaulayRing.mk

/-- Helper for Chap10 Lemma 10 135 4: the localized polynomial ring at the prime over `q` is
Cohen-Macaulay as a self-module. -/
private theorem localRing_selfModule_cohenMacaulay
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    Module.CohenMacaulay (localRing π q) (localRing π q) := by
  -- Proof comment: make the polynomial ring Cohen-Macaulay over the field, then localize at the
  -- contracted prime of the chosen presentation.
  letI : CohenMacaulayRing (MvPolynomial (Fin n) k) :=
    cohenMacaulayRing_mvPolynomial (field_cohenMacaulayRing k) n
  exact localizedRing_cohenMacaulay (MvPolynomial (Fin n) k) (prime π q)

/-- Helper for Chap10 Lemma 10 135 4: in the expected codimension, generators of the localized
kernel form a regular sequence. -/
private theorem regularSequenceCondition_of_kernelGeneratedByCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π) (q : PrimeSpectrum S)
    (hc : (prime π q).asIdeal.height - q.asIdeal.height = c) :
    kernelGeneratedByCondition π q c → kernelGeneratedByRegularSequenceCondition π q c := by
  -- Proof comment: once the quotient-dimension bridge is available, the standard CM criterion
  -- upgrades any `c` generators of the localized kernel to a regular sequence.
  rintro ⟨xs, hxs⟩
  letI : Module.CohenMacaulay (localRing π q) (localRing π q) :=
    localRing_selfModule_cohenMacaulay π q
  refine ⟨xs, ?_, hxs⟩
  exact isRegular_of_fin_generators_dimension_eq hxs
    (localizedKernelIdeal_le_jacobson π q)
    (localQuotientRing_ringKrullDim_add_eq_of_height_sub π hπ q hc)

/-- Helper for Chap10 Lemma 10 135 4: under the expected height defect, `c` generators of the
localized kernel are equivalent to `c` regular generators. -/
private theorem kernelGeneratedByRegularSequenceCondition_iff_kernelGeneratedByCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π) (q : PrimeSpectrum S)
    (hc : (prime π q).asIdeal.height - q.asIdeal.height = c) :
    kernelGeneratedByRegularSequenceCondition π q c ↔ kernelGeneratedByCondition π q c := by
  -- Proof comment: one direction forgets regularity; the converse is exactly the
  -- Cohen-Macaulay expected-codimension upgrade for the localized polynomial ring.
  constructor
  · exact kernelGeneratedByCondition_of_regularSequenceCondition π q
  · exact regularSequenceCondition_of_kernelGeneratedByCondition π hπ q hc

/-- Helper for Chap10 Lemma 10 135 4: regular localized kernel generators give conormal
generators by passing to the cotangent quotient. -/
private theorem conormalGeneratedByCondition_of_regularSequenceCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S) :
    kernelGeneratedByRegularSequenceCondition π q c → conormalGeneratedByCondition π q c := by
  -- Proof comment: forget regularity to get ideal generators, then map those generators to
  -- `I / I^2`.
  exact
    conormalGeneratedByCondition_of_kernelGeneratedByCondition π q ∘
      kernelGeneratedByCondition_of_regularSequenceCondition π q

/-- Helper for Chap10 Lemma 10 135 4: conormal generators recover regular localized kernel
generators once the expected height defect is known. -/
private theorem regularSequenceCondition_of_conormalGeneratedByCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π) (q : PrimeSpectrum S)
    (hc : (prime π q).asIdeal.height - q.asIdeal.height = c) :
    conormalGeneratedByCondition π q c → kernelGeneratedByRegularSequenceCondition π q c := by
  -- Proof comment: Nakayama lifts conormal generators to ideal generators, and the
  -- expected-codimension criterion upgrades those generators to a regular sequence.
  intro hconormal
  exact regularSequenceCondition_of_kernelGeneratedByCondition π hπ q hc
    ((kernelGeneratedByCondition_iff_conormalGeneratedByCondition π q).2 hconormal)

/-- Helper for Chap10 Lemma 10 135 4: a regular generating sequence spreads to a global
complete-intersection neighbourhood of `q`. -/
private theorem globalNear_of_regularSequenceCondition
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π) (q : PrimeSpectrum S)
    (_ : (prime π q).asIdeal.height - q.asIdeal.height = c) :
    kernelGeneratedByRegularSequenceCondition π q c →
      isGlobalCompleteIntersectionNearPrime k q := by
  -- Proof comment: first package the regular localized kernel in the canonical
  -- `RingHom.KernelIsGeneratedByRegularSequence` owner for the local presentation map.
  intro hreg
  have _hkergen :
      ∃ xs : Fin c → localRing π q,
        Ideal.span (Set.range xs) =
          RingHom.ker
            (Localization.localRingHom (prime π q).asIdeal q.asIdeal π.toRingHom rfl) :=
    localRingHom_kernelGeneratedByCondition π hπ q
      (kernelGeneratedByCondition_of_regularSequenceCondition π q hreg)
  have hkerreg :
      RingHom.KernelIsGeneratedByRegularSequence
        (Localization.localRingHom (prime π q).asIdeal q.asIdeal π.toRingHom rfl) :=
    localRingHom_kernelIsGeneratedByRegularSequence π hπ q hreg
  -- TODO: first package `hkerreg` as
  -- `Algebra.IsCompleteIntersectionOver k (Localization.AtPrime q.asIdeal)` using the regular
  -- localized polynomial source above, then use the owner-level principal-open spreading theorem
  -- for complete intersections at a stalk.
  sorry

/-- Helper for Chap10 Lemma 10 135 4: in a Noetherian local ring, any two length-`c` generating
families of an ideal generated by a regular sequence of length `c` are both regular sequences. -/
private theorem isRegular_of_span_eq_span_regular_of_same_fin_length
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [Module.CohenMacaulay R R]
    {c : ℕ} {I : Ideal R}
    {ys xs : Fin c → R}
    (hysreg : Sequence.IsRegular R (List.ofFn ys))
    (hys : Ideal.span (Set.range ys) = I)
    (hxs : Ideal.span (Set.range xs) = I) :
    Sequence.IsRegular R (List.ofFn xs) := by
  -- Proof comment: derive the expected quotient-dimension formula from the known regular
  -- generators, then reapply the CM criterion to the second generating family.
  have hys_mem : ∀ x ∈ List.ofFn ys, x ∈ maximalIdeal R := by
    intro x hx
    exact IsRegular.ofList_le_maximalIdeal hysreg (Ideal.subset_span hx)
  have hys_ofList : Ideal.ofList (List.ofFn ys) = I := by
    rw [ideal_ofList_ofFn_eq_span_range, hys]
  have hdim_y :
      ringKrullDim (R ⧸ Ideal.ofList (List.ofFn ys)) + (List.ofFn ys).length =
        ringKrullDim R :=
    (isRegular_iff_ringKrullDim_quotient_add_length_eq hys_mem).mp hysreg
  have hdim_I : ringKrullDim (R ⧸ I) + c = ringKrullDim R := by
    rw [← hys_ofList]
    simpa [List.length_ofFn] using hdim_y
  have hImax : I ≤ maximalIdeal R := by
    intro x hx
    rw [← hys] at hx
    have hx' : x ∈ Ideal.ofList (List.ofFn ys) := by
      simpa [ideal_ofList_ofFn_eq_span_range] using hx
    exact IsRegular.ofList_le_maximalIdeal hysreg hx'
  have hIjac : I ≤ Ring.jacobson R := by
    simpa [IsLocalRing.ringJacobson_eq_maximalIdeal] using hImax
  exact isRegular_of_fin_generators_dimension_eq hxs hIjac hdim_I

-- Proof sketch: localize the chosen polynomial presentation `π` at the prime
-- `q' = PrimeSpectrum.comap π.toRingHom q`. The localized polynomial ring is regular local, hence
-- Cohen-Macaulay, and the height hypothesis identifies the codimension with `c`. Then use
-- Nakayama, the Cohen-Macaulay criterion for ideals generated by `c` elements, freeness of the
-- conormal module for complete intersections, and the comparison between local complete
-- intersections and global complete intersections on a basic open neighbourhood of `q`.
/-- Lemma 10.135.4 (1): let `k` be a field, let `S` be a finite type `k`-algebra, let
`π : k[x₁, …, xₙ] → S` be a surjective polynomial presentation, and let `q : PrimeSpectrum S`.
Write `q' = PrimeSpectrum.comap π.toRingHom q` and assume that
`q'.asIdeal.height - q.asIdeal.height = c`. Then the following are equivalent: some basic open
neighbourhood of `q` is a global complete intersection over `k`; the localized kernel ideal
`I_{q'}` is generated by `c` elements; the localized conormal module
`I_{q'} / I_{q'}²` is generated by `c` elements over the quotient local ring
`k[x₁, …, xₙ]_{q'} / I_{q'}`; the same conormal module is free of rank `c`; and the localized
kernel ideal `I_{q'}` is generated by a regular sequence in the local ring
`k[x₁, …, xₙ]_{q'}`. -/
@[stacks 00SC]
theorem tfae
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (_ : Function.Surjective π) (q : PrimeSpectrum S)
    (hc : (prime π q).asIdeal.height - q.asIdeal.height = c) :
    List.TFAE
      [ isGlobalCompleteIntersectionNearPrime k q
      , kernelGeneratedByCondition π q c
      , conormalGeneratedByCondition π q c
      , conormalFreeCondition π q c
      , kernelGeneratedByRegularSequenceCondition π q c
      ] := by
  -- Proof comment: assemble the source-facing equivalence from the localized presentation
  -- bridges by following the directed source cycle through conormal freeness, conormal
  -- generation, kernel generation, regular generators, and back to the global neighbourhood.
  exact
    tfae_five_of_source_cycle
      (conormalFreeCondition_of_globalNear π ‹Function.Surjective π› q hc)
      (conormalGeneratedByCondition_of_conormalFreeCondition π q)
      (kernelGeneratedByCondition_iff_conormalGeneratedByCondition π q).2
      (regularSequenceCondition_of_kernelGeneratedByCondition π ‹Function.Surjective π› q hc)
      (globalNear_of_regularSequenceCondition π ‹Function.Surjective π› q hc)

-- Proof sketch: by the equivalence in part (1), the localized kernel ideal is generated by a
-- regular sequence of length `c`. In a local ring, any `c` generators of the same ideal are a
-- minimal generating family, hence have the same images modulo the maximal-ideal multiple by
-- Nakayama, and the Cohen-Macaulay complete-intersection criterion upgrades them to a regular
-- sequence as well.
/-- Lemma 10.135.4 (2): in the situation of part (1), if the localized kernel ideal `I_{q'}` is
generated by a regular sequence of length `c`, then any other family of `c` generators of
`I_{q'}` is again a regular sequence in the local ring `k[x₁, …, xₙ]_{q'}`. This is the
library-facing form of the textbook statement that any `c` elements generating
`I_{q'} / q' I_{q'}` form a regular sequence. -/
@[stacks 00SC]
theorem generators_form_regularSequence
    (π : MvPolynomial (Fin n) k →ₐ[k] S) (q : PrimeSpectrum S)
    (hreg : kernelGeneratedByRegularSequenceCondition π q c)
    (xs : Fin c → localRing π q)
    (hxs : Ideal.span (Set.range xs) = localizedKernelIdeal π q) :
    Sequence.IsRegular (localRing π q) (List.ofFn xs) := by
  -- Proof comment: compare `xs` with the regular generating family supplied by the hypothesis.
  rcases hreg with ⟨ys, hysreg, hys⟩
  letI : Module.CohenMacaulay (localRing π q) (localRing π q) :=
    localRing_selfModule_cohenMacaulay π q
  exact isRegular_of_span_eq_span_regular_of_same_fin_length hysreg hys hxs

end PolynomialPresentationAtPrime

