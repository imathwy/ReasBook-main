/-- Helper for Chap10 Lemma 10 118 3: the remaining coefficient product bridge transports
freeness from the iterated coefficient localization to the direct coefficient localization. -/
lemma coeffAwayProductFreeOfIterated
    {n : ℕ}
    {N : Type*} [AddCommGroup N] [Module (MvPolynomial (Fin n) R) N]
    (f g : R)
    (hiter :
      let A := Localization.Away f
      let Nf := LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N
      letI : Module A Nf := away_polynomial_module_over_base_localization (R := R) (n := n) f
      Module.Free (Localization.Away (algebraMap R A g))
        (LocalizedModule.Away (algebraMap R A g) Nf)) :
    Module.Free (Localization.Away (f * g))
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) (f * g)) N) := by
  dsimp at hiter
  let P := MvPolynomial (Fin n) R
  let A := Localization.Away f
  let B := Localization.Away (MvPolynomial.C (σ := Fin n) f)
  let Nf := LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N
  let t : A := algebraMap R A g
  let algAB := (Localization.awayMapₐ (Algebra.ofId R P) f).toAlgebra
  letI : SMul A B := algAB.toSMul
  letI : Algebra A B := algAB
  letI : Module A Nf := away_polynomial_module_over_base_localization (R := R) (n := n) f
  letI : IsScalarTower A B Nf := by
    -- Proof comment: the specialized `R_f`-action is the restriction of the canonical
    -- polynomial away-map action.
    refine IsScalarTower.of_algebraMap_smul ?_
    intro r x
    rw [away_polynomial_source_smul_eq_awayMap (R := R) (n := n) (N := N) f r x]
    have hmap := DFunLike.congr_fun
      (away_mvPolynomial_C_awayMapₐ_toAlgebra_algebraMap (R := R) (n := n) f) r
    rw [hmap]
  have htarget :
      let c : B := algebraMap A B t
      let At := Localization.Away t
      let Bt := Localization.Away c
      let algAtBt := (Localization.awayMapₐ (Algebra.ofId A B) t).toAlgebra
      letI : SMul At Bt := algAtBt.toSMul
      letI : Algebra At Bt := algAtBt
      let Nt := LocalizedModule.Away c Nf
      let moduleAtNt : Module At Nt := Module.compHom Nt (algebraMap At Bt)
      letI : Module At Nt := moduleAtNt
      Module.Free At Nt := by
    -- Proof comment: localizing at the image of `g/1` over the polynomial-away ring is the same
    -- localized module as localizing the `R_f`-module at `g/1`, for purposes of freeness.
    exact moduleFreeOfAlgebraMapAwayLocalization (A := A) (B := B) (N := Nf) t hiter
  -- Proof comment: the existing product-localization helper now handles the direct
  -- `R_(f*g)` comparison from the target-iterated coefficient localization.
  have hgeneric :=
    productAwayModuleFreeOfTargetIterated (R := R) (S := P) (M₀ := N) f g htarget
  let u := f * g
  let Bfg := Localization.Away (MvPolynomial.C (σ := Fin n) u)
  let algABfg := (Localization.awayMapₐ (Algebra.ofId R P) u).toAlgebra
  letI : SMul (Localization.Away u) Bfg := algABfg.toSMul
  letI : Algebra (Localization.Away u) Bfg := algABfg
  let mcanon : Module (Localization.Away u)
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) u) N) :=
    Module.compHom (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) u) N)
      (algebraMap (Localization.Away u) Bfg)
  have hgeneric' : @Module.Free (Localization.Away u)
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) u) N) _ _ mcanon := by
    -- Proof comment: normalize the product denominator from `algebraMap R P` to `MvPolynomial.C`
    -- and expose the canonical away-map module structure.
    simpa [u, P, Bfg, algABfg, mcanon] using hgeneric
  -- Proof comment: the final step changes only the hidden `Module` instance, using the
  -- pointwise scalar-action bridge proved above.
  exact coeffAwayBaseModuleFreeOfCanonicalRestriction (R := R) (n := n) (N := N) u hgeneric'

/-- Helper for Chap10 Lemma 10 118 3: freeness of a coefficient-away localization survives
replacing the denominator `f` by the product `f * g`. -/
lemma coeffAway_free_of_mul_right
    {n : ℕ}
    {N : Type*} [AddCommGroup N] [Module (MvPolynomial (Fin n) R) N]
    (f g : R)
    [Module.Free (Localization.Away f)
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N)] :
    Module.Free (Localization.Away (f * g))
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) (f * g)) N) := by
  -- Route correction: the monolithic product-localization comparison is now isolated in
  -- `coeffAwayProductFreeOfIterated`; this wrapper only performs the formal iterated localization
  -- step and hands it to that bridge.
  have hiter :=
    coeffAwayIteratedFreeOfFree (R := R) (n := n) (N := N) f g
  exact coeffAwayProductFreeOfIterated (R := R) (n := n) (N := N) f g hiter

/-- Helper for Chap10 Lemma 10 118 3: the left-product variant of coefficient-away freeness
transport, avoiding dependent rewrites through `Module.Free` instance arguments. -/
lemma coeffAway_free_of_mul_left
    {n : ℕ}
    {N : Type*} [AddCommGroup N] [Module (MvPolynomial (Fin n) R) N]
    (f g : R)
    [Module.Free (Localization.Away f)
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N)] :
    Module.Free (Localization.Away (g * f))
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) (g * f)) N) := by
  -- Proof comment: the only difference from the right-product statement is the commuted
  -- product in both the base localization and the coefficient denominator.
  have hright :
      Module.Free (Localization.Away (f * g))
        (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) (f * g)) N) :=
    coeffAway_free_of_mul_right (R := R) (n := n) (N := N) f g
  rw [mul_comm]
  exact hright

end
