/-- Helper for Chap10 Lemma 10 118 3: direct localization away from `a * b` is also localization
at the supremum of the two principal denominator submonoids. -/
private instance mkLinearMapIsLocalizedModuleSupAwayMul
    {A : Type*} [CommRing A] {N : Type*} [AddCommGroup N] [Module A N]
    (a b : A) :
    IsLocalizedModule (Submonoid.powers a ⊔ Submonoid.powers b)
      (LocalizedModule.mkLinearMap (Submonoid.powers (a * b)) N) := by
  -- Proof comment: compare the product denominator with the saturated submonoid generated by
  -- the two separate denominators.
  refine
    IsLocalizedModule.of_exists_mul_mem (S := Submonoid.powers (a * b))
      (T := Submonoid.powers a ⊔ Submonoid.powers b) ?_ ?_
      (LocalizedModule.mkLinearMap (Submonoid.powers (a * b)) N)
  · intro x hx
    rcases (Submonoid.mem_powers_iff x (a * b)).mp hx with ⟨k, rfl⟩
    -- Proof comment: a power of `a * b` is the product of matching powers of `a` and `b`.
    simpa [mul_pow] using
      (Submonoid.mul_mem_sup
        (show a ^ k ∈ Submonoid.powers a from ⟨k, rfl⟩)
        (show b ^ k ∈ Submonoid.powers b from ⟨k, rfl⟩))
  · intro x
    rcases Submonoid.mem_sup.mp x.2 with ⟨y, hy, z, hz, hyz⟩
    have hx : (x : A) = y * z := by
      simpa using hyz.symm
    rcases (Submonoid.mem_powers_iff y a).mp hy with ⟨m, rfl⟩
    rcases (Submonoid.mem_powers_iff z b).mp hz with ⟨k, rfl⟩
    -- Proof comment: multiplying by complementary powers turns `a^m b^k` into a power of
    -- `a * b`, proving the reverse saturation inclusion.
    refine ⟨a ^ k * b ^ m, ?_⟩
    rw [hx]
    refine ⟨m + k, ?_⟩
    simp [pow_add, mul_pow, mul_assoc, mul_left_comm]

