/-- Helper for Chap10 Lemma 10 118 3: freeness over the polynomial away localization descends to
freeness over the base coefficient localization. -/
private lemma coeffAwayBaseModuleFreeOfPolynomialLocalization
    {n : ℕ}
    {N : Type*} [AddCommGroup N] [Module (MvPolynomial (Fin n) R) N]
    (f : R)
    [Module.Free (Localization.Away (MvPolynomial.C (σ := Fin n) f))
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N)] :
    Module.Free (Localization.Away f)
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N) := by
  let A := Localization.Away f
  let P := MvPolynomial (Fin n) R
  let B := Localization.Away (MvPolynomial.C (σ := Fin n) f)
  let L := LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N
  let algAB := (Localization.awayMapₐ (Algebra.ofId R P) f).toAlgebra
  letI : SMul A B := algAB.toSMul
  letI : Algebra A B := algAB
  let moduleCanon : Module A L := Module.compHom L (algebraMap A B)
  have hcanon : @Module.Free A L _ _ moduleCanon := by
    letI : Module A B := (Algebra.toModule : Module A B)
    letI : Module A L := moduleCanon
    letI : IsScalarTower A B L := by
      -- Proof comment: the canonical restricted action on the localized module is exactly
      -- multiplication through the polynomial away localization.
      refine IsScalarTower.of_algebraMap_smul ?_
      intro a x
      rfl
    letI : Module.Free A B :=
      coeffAwayLocalization_free_over_base (R := R) (n := n) f
    -- Proof comment: transitivity of freeness restricts a free `R[x]_(C f)`-module to a free
    -- `R_f`-module because `R[x]_(C f)` is free over `R_f`.
    exact Module.Free.trans (R := A) (S := B) (M := L)
  -- Proof comment: the final step changes from the canonical away-map action to the normalized
  -- base-localized polynomial action used throughout the file.
  exact coeffAwayBaseModuleFreeOfCanonicalRestriction (R := R) (n := n) (N := N) f hcanon

