/-- Helper for Chap10 Lemma 10 118 3: localizing an already-free coefficient-away polynomial
module once more keeps it free over the iterated coefficient localization. -/
lemma coeffAwayIteratedFreeOfFree
    {n : ℕ}
    {N : Type*} [AddCommGroup N] [Module (MvPolynomial (Fin n) R) N]
    (f g : R)
    [Module.Free (Localization.Away f)
      (LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N)] :
    let A := Localization.Away f
    let Nf := LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N
    letI : Module A Nf := away_polynomial_module_over_base_localization (R := R) (n := n) f
    Module.Free (Localization.Away (algebraMap R A g))
      (LocalizedModule.Away (algebraMap R A g) Nf) := by
  dsimp
  let A := Localization.Away f
  let Nf := LocalizedModule.Away (MvPolynomial.C (σ := Fin n) f) N
  let t : A := algebraMap R A g
  let At := Localization.Away t
  let moduleA : Module A Nf :=
    away_polynomial_module_over_base_localization (R := R) (n := n) f
  letI : SMul A Nf := moduleA.toSMul
  letI : HSMul A Nf Nf := ⟨fun a n ↦ SMul.smul a n⟩
  letI : MulAction A Nf := moduleA.toDistribMulAction.toMulAction
  letI : DistribMulAction A Nf := moduleA.toDistribMulAction
  letI : Module A Nf := moduleA
  let Nt := LocalizedModule.Away t Nf
  let loc : Nf →ₗ[A] Nt := LocalizedModule.mkLinearMap (Submonoid.powers t) Nf
  have hloc : IsLocalizedModule (Submonoid.powers t) loc := inferInstance
  have hfree : Module.Free A Nf := inferInstance
  -- Proof comment: the canonical localized-module map `N_f → (N_f)_{g/1}` is a localization
  -- of the free `R_f`-module, so mathlib's localization-of-free theorem gives freeness.
  exact @Module.free_of_isLocalizedModule A Nf _ _ moduleA At Nt _ _ _ _ _ _
    (Submonoid.powers t) loc inferInstance hloc hfree

