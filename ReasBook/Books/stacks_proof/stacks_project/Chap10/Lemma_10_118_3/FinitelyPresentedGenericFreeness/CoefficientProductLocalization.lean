/-- Helper for Chap10 Lemma 10 118 3: the polynomial away localization `R[x]_(C f)` is a free
module over the coefficient localization `R_f`. -/
private lemma coeffAwayLocalization_free_over_base
    {n : ℕ} (f : R) :
    let A := Localization.Away f
    let P := MvPolynomial (Fin n) R
    let B := Localization.Away (MvPolynomial.C (σ := Fin n) f)
    let algAB := (Localization.awayMapₐ (Algebra.ofId R P) f).toAlgebra
    letI : SMul A B := algAB.toSMul
    letI : Algebra A B := algAB
    @Module.Free A B _ _ (Algebra.toModule : Module A B) := by
  dsimp
  let A := Localization.Away f
  let P := MvPolynomial (Fin n) R
  let B := Localization.Away (MvPolynomial.C (σ := Fin n) f)
  let algAB := (Localization.awayMapₐ (Algebra.ofId R P) f).toAlgebra
  letI : SMul A B := algAB.toSMul
  letI : Algebra A B := algAB
  let eAlg := away_mvPolynomial_C_algEquiv (R := R) (n := n) f
  -- Proof comment: the normalization equivalence sends the canonical coefficient away-map to the
  -- coefficient embedding into the polynomial ring over `R_f`.
  have hcoeff (r : A) :
      eAlg (algebraMap A B r) = algebraMap A (MvPolynomial (Fin n) A) r := by
    have hmap := DFunLike.congr_fun
      (away_mvPolynomial_C_awayMapₐ_toAlgebra_algebraMap (R := R) (n := n) f) r
    have hsymm := DFunLike.congr_fun
      (away_mvPolynomial_C_algEquiv_symm_comp_C (R := R) (n := n) f) r
    rw [hmap, ← hsymm]
    change eAlg (eAlg.symm (MvPolynomial.C (σ := Fin n) r)) =
      algebraMap A (MvPolynomial (Fin n) A) r
    rw [eAlg.apply_symm_apply]
    simp [MvPolynomial.algebraMap_eq]
  let eA : B ≃ₐ[A] MvPolynomial (Fin n) A :=
    { eAlg.toRingEquiv with
      commutes' := hcoeff }
  -- Proof comment: `R_f[x]` is free over `R_f`, and the algebra equivalence transfers this basis
  -- back to the direct localization `R[x]_(C f)`.
  exact @Module.Free.of_equiv' A B _ _ (Algebra.toModule : Module A B)
    (MvPolynomial (Fin n) A) _ inferInstance
    (inferInstance : Module.Free A (MvPolynomial (Fin n) A)) eA.symm.toLinearEquiv

