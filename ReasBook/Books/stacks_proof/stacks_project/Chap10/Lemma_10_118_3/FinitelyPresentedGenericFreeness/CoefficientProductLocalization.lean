/-- Helper for Chap10 Lemma 10 118 3: freeness is invariant under replacing the module
structure by an equal one. -/
private lemma moduleFreeOfModuleEq
    {A : Type*} {N : Type*} [Semiring A] [AddCommMonoid N]
    (m₁ m₂ : Module A N) (h : m₁ = m₂)
    (hfree : @Module.Free A N _ _ m₁) :
    @Module.Free A N _ _ m₂ := by
  -- Proof comment: once the two module structures are identified, the original freeness
  -- instance has exactly the required type.
  cases h
  exact hfree

