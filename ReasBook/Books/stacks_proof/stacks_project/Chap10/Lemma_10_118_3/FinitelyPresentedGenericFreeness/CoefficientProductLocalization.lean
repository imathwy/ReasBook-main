  -- Proof comment: module structures are equal when their scalar actions agree pointwise.
  apply Module.ext'
  intro r x
  -- Proof comment: the existing scalar-action bridge says the base-localization action is the
  -- canonical action through `Localization.awayMap (MvPolynomial.C) u`.
  exact (away_polynomial_source_smul_eq_awayMap (R := R) (n := n) (N := N) u r x).symm

