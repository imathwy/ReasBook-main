/-- Helper for Chap10 Lemma 10 118 3: freeness after localizing at `t` over `A` transports to
the localization at the image of `t` over an `A`-algebra `B`. -/
private lemma moduleFreeOfAlgebraMapAwayLocalization
    {A B N : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup N] [Module B N] [Module A N] [IsScalarTower A B N]
    (t : A)
    (hfree : Module.Free (Localization.Away t) (LocalizedModule.Away t N)) :
    let c : B := algebraMap A B t
    let At := Localization.Away t
    let Bt := Localization.Away c
    let algAtBt := (Localization.awayMapₐ (Algebra.ofId A B) t).toAlgebra
    letI : SMul At Bt := algAtBt.toSMul
    letI : Algebra At Bt := algAtBt
    let Nt := LocalizedModule.Away c N
    let moduleAtNt : Module At Nt := Module.compHom Nt (algebraMap At Bt)
    letI : Module At Nt := moduleAtNt
    Module.Free At Nt := by
  dsimp at hfree ⊢
  let c : B := algebraMap A B t
  let At := Localization.Away t
  let Bt := Localization.Away c
  let NtA := LocalizedModule.Away t N
  let NtB := LocalizedModule.Away c N
  let algAtBt := (Localization.awayMapₐ (Algebra.ofId A B) t).toAlgebra
  letI : SMul At Bt := algAtBt.toSMul
  letI : Algebra At Bt := algAtBt
  letI : IsScalarTower A At Bt :=
    IsScalarTower.of_algebraMap_eq fun x ↦ by
      -- Proof comment: the iterated algebra map is pinned to the canonical away-map spelling.
      symm
      exact DFunLike.congr_fun (Localization.awayMapₐ (Algebra.ofId A B) t).comp_algebraMap x
  let moduleAtNtB : Module At NtB := Module.compHom NtB (algebraMap At Bt)
  letI : Module At NtB := moduleAtNtB
  letI : IsScalarTower At Bt NtB := by
    -- Proof comment: the `At`-action on the `B`-localized target is pulled back through `Bt`.
    refine IsScalarTower.of_algebraMap_smul ?_
    intro a n
    rfl
  letI : IsScalarTower A At NtB := by
    -- Proof comment: compose the pinned source-to-iterated ring map with the localized
    -- `Bt`-module action.
    refine IsScalarTower.of_algebraMap_smul ?_
    intro a n
    change algebraMap At Bt (algebraMap A At a) • n = a • n
    rw [← IsScalarTower.algebraMap_apply A At Bt a]
    exact IsScalarTower.algebraMap_smul Bt a n
  let locB : N →ₗ[B] NtB := LocalizedModule.mkLinearMap (Submonoid.powers c) N
  have hlocB :
      IsLocalizedModule (Submonoid.powers (algebraMap A B t)) locB := by
    -- Proof comment: the target denominator is exactly the algebra-map image of `t`.
    simpa [c] using
      (inferInstance :
        IsLocalizedModule (Submonoid.powers c)
          (LocalizedModule.mkLinearMap (Submonoid.powers c) N))
  let locAfromB : N →ₗ[A] NtB := locB.restrictScalars A
  have hlocAfromB : IsLocalizedModule (Submonoid.powers t) locAfromB := by
    -- Proof comment: the localized-module universal property descends along restriction of
    -- scalars from `B` to `A`.
    letI : IsLocalizedModule (Submonoid.powers (algebraMap A B t)) locB := hlocB
    exact isLocalizedModuleRestrictScalarsPowersAlgebraMap (A := A) (B := B)
      (N := N) (N' := NtB) t locB
  let locA : N →ₗ[A] NtA := LocalizedModule.mkLinearMap (Submonoid.powers t) N
  let eA : NtB ≃ₗ[A] NtA :=
    IsLocalizedModule.linearEquiv (Submonoid.powers t) locAfromB locA
  let eAt : NtB ≃ₗ[At] NtA := eA.extendScalarsOfIsLocalization (Submonoid.powers t) At
  -- Proof comment: transport the already-free base localization across the localized
  -- comparison equivalence.
  exact Module.Free.of_equiv' hfree eAt.symm

