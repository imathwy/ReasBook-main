/-- Helper for Chap10 Lemma 10 118 3: units of scalar endomorphisms descend when a localized
module is viewed by restriction of scalars along an algebra map. -/
private lemma isUnitRestrictScalarsAlgebraMapEnd
    {A B P : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup P] [Module B P] [Module A P] [IsScalarTower A B P]
    (a : A)
    (h : IsUnit (algebraMap B (Module.End B P) (algebraMap A B a))) :
    IsUnit (algebraMap A (Module.End A P) a) := by
  -- Proof comment: identify both endomorphisms pointwise after forgetting from `B` to `A`.
  rw [Module.End.isUnit_iff] at h ⊢
  convert h using 1
  ext x
  exact (algebraMap_smul B a x).symm

