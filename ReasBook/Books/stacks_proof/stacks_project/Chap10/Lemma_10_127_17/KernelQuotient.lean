import StacksProject_2024.Chap10.Lemma_10_127_17.RangeTail

open scoped TensorProduct

attribute [local instance] Algebra.TensorProduct.rightAlgebra

universe u v w

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]

/-- Helper for Lemma 10.127.17: the stage-`j` kernel is the pullback of the stage-`k` kernel
along the raw tail transition. -/
theorem range_tail_sigma_ker_eq_comap_raw_tail_map
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict) =
      Ideal.comap (raw_tail_map A₀ i₀ P₀ j k hjk)
        (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)) := by
  -- Proof comment: the two stage maps to `S` differ exactly by postcomposing with the raw tail
  -- transition, so their kernels are related by `RingHom.comap_ker`.
  calc
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict) =
        RingHom.ker (range_tail_sigma A₀ i₀ P₀ e j) := by
      rw [ker_rangeRestrict_eq]
    _ = RingHom.ker
          ((range_tail_sigma A₀ i₀ P₀ e k).comp (raw_tail_map A₀ i₀ P₀ j k hjk)) := by
      exact congrArg RingHom.ker (range_tail_sigma_compatible A₀ i₀ P₀ e hjk)
    _ = Ideal.comap (raw_tail_map A₀ i₀ P₀ j k hjk)
          (RingHom.ker (range_tail_sigma A₀ i₀ P₀ e k)) := by
      symm
      exact RingHom.comap_ker _ _
    _ = Ideal.comap (raw_tail_map A₀ i₀ P₀ j k hjk)
          (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)) := by
      rw [ker_rangeRestrict_eq]

/-- Helper for Lemma 10.127.17: the raw tensor-cancellation map restricts along `includeLeft` to
the raw tail transition map. -/
theorem raw_tail_rawTensorCancel_comp_includeLeft
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
      (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
    let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
    let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
    let rawCancel_jk :=
      (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
        j.2 k.2 hjk
        (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
    rawCancel_jk.comp
        (Algebra.TensorProduct.includeLeft :
          raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
            raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1).toRingHom =
      raw_tail_map A₀ i₀ P₀ j k hjk := by
  let _ : Algebra (A₀.RStage i₀) (A₀.RStage j.1) := (A₀.RMap i₀ j.1 j.2).toAlgebra
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let rawCancel_jk :=
    (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
      j.2 k.2 hjk
      (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
  -- Proof comment: evaluate the tensor-cancellation equivalence on `x ⊗ 1`, which is exactly the
  -- image of each pure tensor under `includeLeft`, and pure tensors generate the source stage.
  apply ringHom_eq_of_tmul
  intro p r
  simpa [rawCancel_jk, raw_tail_map, Algebra.TensorProduct.includeLeft_apply,
    Algebra.TensorProduct.map_tmul] using
    (rawTensorCancel_tmul_right
      (RStage := A₀.RStage) (map := fun a b h ↦ A₀.RMap a b h)
      (P₀ := P₀) (hij := j.2) (hik := k.2) (hjk := hjk)
      (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)
      (p ⊗ₜ[A₀.RStage i₀] r) (1 : A₀.RStage k.1))

/-- Helper for Lemma 10.127.17: the tensor-side map induced by the stage-`j` range restriction
has kernel generated by the stage-`j` kernel inside the source tensor product. -/
theorem range_tail_beta_kernel_eq_map_includeLeft
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
      (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
    let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
    let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
      (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
    let beta_jk :=
      tensorMapLeft_mixed
        (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
        (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
        (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
    RingHom.ker beta_jk =
      Ideal.map
        (Algebra.TensorProduct.includeLeft :
          raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
            raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
        (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)) := by
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
    (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
  let beta_jk :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
      (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
      (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
  let σj :
      raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
        (range_tail_sigma A₀ i₀ P₀ e j).range :=
    range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j
  have hrange_surj :
      Function.Surjective σj := by
    intro z
    exact (range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict_surjective z
  -- Proof comment: this is exactly the right-exactness owner theorem `rTensor_ker` for the
  -- surjective stage map `σj.rangeRestrict`, after unfolding `tensorMapLeft_mixed`.
  calc
    RingHom.ker beta_jk =
        Ideal.map
          (Algebra.TensorProduct.includeLeft :
            raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
              raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
          (RingHom.ker σj) := by
      simpa [beta_jk, σj, tensorMapLeft_mixed] using
        (Algebra.TensorProduct.rTensor_ker
          (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j)
          (B := (range_tail_sigma A₀ i₀ P₀ e j).range) (C := A₀.RStage k.1)
          (f := σj) hrange_surj)
    _ =
        Ideal.map
          (Algebra.TensorProduct.includeLeft :
            raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
              raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
          (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)) := by
      rfl

/-- Helper for Lemma 10.127.17: the raw tensor comparison already kills the tensorized stage-`j`
kernel, so it descends across the canonical tensor quotient. -/
theorem range_tail_rawTensorCancel_kills_tensorized_stage_kernel
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
      (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
    let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
    let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
    let rawCancel_jk :=
      (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
        j.2 k.2 hjk
        (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
    Ideal.map
        (Algebra.TensorProduct.includeLeft :
          raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
            raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
        (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)) ≤
      RingHom.ker (((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict).comp rawCancel_jk) := by
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let rawCancel_jk :=
    (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
      j.2 k.2 hjk
      (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
  -- Proof comment: membership in the tensorized earlier kernel rewrites to membership in the
  -- pulled-back later kernel via the raw transition, and `rawCancel_jk ∘ includeLeft` is exactly
  -- that raw transition.
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  change
    (Algebra.TensorProduct.includeLeft :
      raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
        raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1) x ∈
      RingHom.ker (((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict).comp rawCancel_jk)
  apply RingHom.mem_ker.mpr
  have hxk : raw_tail_map A₀ i₀ P₀ j k hjk x ∈
      RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict) := by
    have hxcomap :
        x ∈ Ideal.comap (raw_tail_map A₀ i₀ P₀ j k hjk)
          (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)) := by
      simpa [range_tail_sigma_ker_eq_comap_raw_tail_map A₀ i₀ P₀ e hjk] using hx
    exact hxcomap
  have hcancel_apply :
      rawCancel_jk (x ⊗ₜ[A₀.RStage j.1] (1 : A₀.RStage k.1)) =
        raw_tail_map A₀ i₀ P₀ j k hjk x := by
    simpa [Algebra.TensorProduct.includeLeft_apply] using
      congrArg (fun g : raw_tail_stage A₀ i₀ P₀ j →+* raw_tail_stage A₀ i₀ P₀ k ↦ g x)
        (raw_tail_rawTensorCancel_comp_includeLeft A₀ i₀ P₀ hjk)
  calc
    ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict.comp rawCancel_jk)
        (x ⊗ₜ[A₀.RStage j.1] (1 : A₀.RStage k.1)) =
      (range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict
        (raw_tail_map A₀ i₀ P₀ j k hjk x) := by
          simp [RingHom.comp_apply, hcancel_apply]
    _ = 0 := RingHom.mem_ker.mp hxk

/-- Helper for Lemma 10.127.17: the stage-`j` range restriction is surjective as an algebra
homomorphism onto the corresponding range stage. -/
theorem range_tail_sigma_rangeRestrictAlgHom_surjective
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    (j : Set.Ici i₀) :
    Function.Surjective (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j) := by
  intro z
  exact (range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict_surjective z

/-- Helper for Lemma 10.127.17: the kernel of the stage-`j` range restriction is finitely
generated. -/
theorem range_tail_sigma_kernel_fg
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra.FinitePresentation (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    (j : Set.Ici i₀) :
    (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)).FG := by
  let _ : Algebra (A₀.RStage i₀) (A₀.RStage j.1) := (A₀.RMap i₀ j.1 j.2).toAlgebra
  let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
    (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
  let _ : Algebra.FiniteType ℤ (A₀.RStage j.1) :=
    RingHom.finiteType_algebraMap.mp (A₀.source_finiteType j.1)
  let _ : IsNoetherianRing (A₀.RStage j.1) :=
    Algebra.FiniteType.isNoetherianRing ℤ (A₀.RStage j.1)
  have hcomm :
      (A₀.RStage j.1 ⊗[A₀.RStage i₀] P₀) ≃ₐ[A₀.RStage j.1]
        (P₀ ⊗[A₀.RStage i₀] A₀.RStage j.1) :=
    AlgEquiv.ofRingEquiv
      (f := (Algebra.TensorProduct.comm (A₀.RStage i₀) (A₀.RStage j.1) P₀).toRingEquiv)
      (fun x ↦ by
        change
          (Algebra.TensorProduct.comm (A₀.RStage i₀) (A₀.RStage j.1) P₀)
              (x ⊗ₜ[A₀.RStage i₀] (1 : P₀)) =
            (1 : P₀) ⊗ₜ[A₀.RStage i₀] x
        rw [Algebra.TensorProduct.comm_tmul])
  have hraw_fp : Algebra.FinitePresentation (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := by
    -- Proof comment: each raw tail stage is the base change of the fixed finitely presented model
    -- `P₀`, so finite presentation survives to stage `j`.
    have hbase :
        Algebra.FinitePresentation (A₀.RStage j.1)
          (A₀.RStage j.1 ⊗[A₀.RStage i₀] P₀) := by
      exact Algebra.FinitePresentation.baseChange
        (R := A₀.RStage i₀) (A := P₀) (B := A₀.RStage j.1)
    letI : Algebra.FinitePresentation (A₀.RStage j.1)
        (A₀.RStage j.1 ⊗[A₀.RStage i₀] P₀) := hbase
    simpa [raw_tail_stage] using (Algebra.FinitePresentation.equiv hcomm)
  let A := range_tail_target_approximation A₀ i₀ P₀ e
  have hrange_ft :
      Algebra.FiniteType (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) := by
    -- Proof comment: the range stage is exactly the target stage of the owner approximation, so
    -- it is already known to be finite type over the corresponding source stage.
    simpa [A, range_tail_target_approximation] using
      (A.target_finiteType j)
  have hrange_fp :
      Algebra.FinitePresentation (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) := by
    -- Proof comment: over the Noetherian source stage `Rⱼ`, finite type and finite presentation
    -- coincide.
    exact (Algebra.FinitePresentation.of_finiteType).mp hrange_ft
  -- Proof comment: once both source and target are finitely presented over `Rⱼ`, the kernel of
  -- the surjective range-restriction map is finitely generated.
  exact Algebra.FinitePresentation.ker_fG_of_surjective
    (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
    (range_tail_sigma_rangeRestrictAlgHom_surjective A₀ i₀ P₀ e j)

/-- Helper for Lemma 10.127.17: quotienting the raw stage by the kernel of its range restriction
identifies it with the actual range stage. -/
noncomputable def range_tail_sigma_quotientKerAlgEquiv
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    (j : Set.Ici i₀) :
    let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
      (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
    (raw_tail_stage A₀ i₀ P₀ j ⧸
        RingHom.ker (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)) ≃ₐ[A₀.RStage j.1]
      (range_tail_sigma A₀ i₀ P₀ e j).range :=
  let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
    (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
  Ideal.quotientKerAlgEquivOfSurjective
    (f := range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
    (range_tail_sigma_rangeRestrictAlgHom_surjective A₀ i₀ P₀ e j)

/-- Helper for Lemma 10.127.17: the quotient-to-range equivalence sends the class of a raw stage
element to its image in the corresponding range stage. -/
@[simp] theorem range_tail_sigma_quotientKerAlgEquiv_mk
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    (j : Set.Ici i₀) (x : raw_tail_stage A₀ i₀ P₀ j) :
    let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
      (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
    range_tail_sigma_quotientKerAlgEquiv A₀ i₀ P₀ e j
        (Ideal.Quotient.mk (RingHom.ker (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)) x) =
      range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j x := by
  let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
    (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
  -- Proof comment: this is the defining computation rule of the first isomorphism theorem over
  -- the stage algebra.
  simpa [range_tail_sigma_quotientKerAlgEquiv] using
    (Ideal.quotientKerAlgEquivOfSurjective_mk
      (f := range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
      (range_tail_sigma_rangeRestrictAlgHom_surjective A₀ i₀ P₀ e j) x)

/-- Helper for Lemma 10.127.17: the raw tensor comparison also kills the tensorized stage-`j`
kernel after replacing the later range restriction by the literal quotient map. -/
theorem range_tail_rawTensorCancel_kills_tensorized_stage_kernel_quotient
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
      (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
    let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
    let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
    let rawCancel_jk :=
      (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
        j.2 k.2 hjk
        (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
    Ideal.map
        (Algebra.TensorProduct.includeLeft :
          raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
            raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
        (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)) ≤
      RingHom.ker
        ((Ideal.Quotient.mk (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict))).comp
          rawCancel_jk) := by
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let rawCancel_jk :=
    (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
      j.2 k.2 hjk
      (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
  -- Proof comment: the same kernel element now lands in the literal quotient kernel because the
  -- quotient map vanishes exactly on the later range kernel.
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  change
    (Algebra.TensorProduct.includeLeft :
      raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
        raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1) x ∈
      RingHom.ker
        ((Ideal.Quotient.mk (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict))).comp
          rawCancel_jk)
  change
    ((Ideal.Quotient.mk (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict))).comp
        rawCancel_jk)
      ((Algebra.TensorProduct.includeLeft :
        raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
          raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1) x) = 0
  have hxk : raw_tail_map A₀ i₀ P₀ j k hjk x ∈
      RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict) := by
    have hxcomap :
        x ∈ Ideal.comap (raw_tail_map A₀ i₀ P₀ j k hjk)
          (RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)) := by
      simpa [range_tail_sigma_ker_eq_comap_raw_tail_map A₀ i₀ P₀ e hjk] using hx
    exact hxcomap
  have hcancel_apply :
      rawCancel_jk (x ⊗ₜ[A₀.RStage j.1] (1 : A₀.RStage k.1)) =
        raw_tail_map A₀ i₀ P₀ j k hjk x := by
    simpa [Algebra.TensorProduct.includeLeft_apply] using
      congrArg (fun g : raw_tail_stage A₀ i₀ P₀ j →+* raw_tail_stage A₀ i₀ P₀ k ↦ g x)
        (raw_tail_rawTensorCancel_comp_includeLeft A₀ i₀ P₀ hjk)
  rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, Algebra.TensorProduct.includeLeft_apply]
  rw [RingHom.mem_ker] at hxk ⊢
  exact (congrArg ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict) hcancel_apply).trans hxk

/-- Helper for Lemma 10.127.17: the raw tensor comparison descends across the tensorized stage-`j`
kernel to a map between the canonical quotient stages. -/
noncomputable def raw_tail_quotient_stageBaseChange
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
      (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
    let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
    let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
    let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
      RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
    let Kk : Ideal (raw_tail_stage A₀ i₀ P₀ k) :=
      RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) :=
      Ideal.Quotient.algebra (A₀.RStage j.1)
    (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) ⊗[A₀.RStage j.1] A₀.RStage k.1 →+*
      raw_tail_stage A₀ i₀ P₀ k ⧸ Kk := by
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
  let Kk : Ideal (raw_tail_stage A₀ i₀ P₀ k) :=
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) :=
    Ideal.Quotient.algebra (A₀.RStage j.1)
  let beta_q :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
      (C := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj)
      (Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj)
  let rawCancel_jk :=
    (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
      j.2 k.2 hjk
      (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
  have hbeta_q_surj : Function.Surjective beta_q := by
    intro z
    refine TensorProduct.induction_on z ?_ ?_ ?_
    · refine ⟨0, by simp [beta_q, tensorMapLeft_mixed]⟩
    · intro x y
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective (A₀.RStage j.1) Kj x
      refine ⟨a ⊗ₜ[A₀.RStage j.1] y, ?_⟩
      simp [beta_q, tensorMapLeft_mixed_tmul]
    · intro x y hx hy
      rcases hx with ⟨x', rfl⟩
      rcases hy with ⟨y', rfl⟩
      refine ⟨x' + y', ?_⟩
      exact RingHom.map_add beta_q x' y'
  exact beta_q.liftOfSurjective
    hbeta_q_surj
    ⟨(Ideal.Quotient.mk Kk).comp rawCancel_jk,
      by
        let qj : raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1] raw_tail_stage A₀ i₀ P₀ j ⧸ Kj :=
          Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj
        have hbeta_q_ker :
            RingHom.ker beta_q =
              Ideal.map
                (Algebra.TensorProduct.includeLeft :
                  raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
                    raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
                Kj := by
          calc
            RingHom.ker beta_q =
                Ideal.map
                  (Algebra.TensorProduct.includeLeft :
                    raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
                      raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
                  (RingHom.ker qj) := by
              simpa [beta_q, qj, tensorMapLeft_mixed] using
                (Algebra.TensorProduct.rTensor_ker
                  (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j)
                  (B := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) (C := A₀.RStage k.1)
                  (f := qj) (Ideal.Quotient.mkₐ_surjective (A₀.RStage j.1) Kj))
            _ =
                Ideal.map
                  (Algebra.TensorProduct.includeLeft :
                    raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
                      raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
                  Kj := by
              rw [← RingHom.ker_coe_toRingHom, Ideal.Quotient.mkₐ_ker]
        rw [hbeta_q_ker]
        exact range_tail_rawTensorCancel_kills_tensorized_stage_kernel_quotient
          A₀ i₀ P₀ e hjk⟩

/-- Helper for Lemma 10.127.17: the descended quotient owner agrees with the raw tensor
comparison after precomposing by the canonical tensorized quotient map on the source. -/
theorem raw_tail_quotient_stageBaseChange_comp_beta_q
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
      (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
    let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
    let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
    let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
      RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
    let Kk : Ideal (raw_tail_stage A₀ i₀ P₀ k) :=
      RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)
    let beta_q :=
      tensorMapLeft_mixed
        (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
        (C := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj)
        (Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj)
    let rawCancel_jk :=
      (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
        j.2 k.2 hjk
        (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
    (raw_tail_quotient_stageBaseChange A₀ i₀ P₀ e hjk).comp beta_q =
      (Ideal.Quotient.mk Kk).comp rawCancel_jk := by
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
  let Kk : Ideal (raw_tail_stage A₀ i₀ P₀ k) :=
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) :=
    Ideal.Quotient.algebra (A₀.RStage j.1)
  let _ : Algebra (A₀.RStage k.1) (raw_tail_stage A₀ i₀ P₀ k ⧸ Kk) :=
    Ideal.Quotient.algebra (A₀.RStage k.1)
  let beta_q :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
      (C := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj)
      (Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj)
  let rawCancel_jk :=
    (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
      j.2 k.2 hjk
      (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
  have hbeta_q_surj : Function.Surjective beta_q := by
    intro z
    refine TensorProduct.induction_on z ?_ ?_ ?_
    · refine ⟨0, by simp [beta_q, tensorMapLeft_mixed]⟩
    · intro x y
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective (A₀.RStage j.1) Kj x
      refine ⟨a ⊗ₜ[A₀.RStage j.1] y, ?_⟩
      simp [beta_q, tensorMapLeft_mixed_tmul]
    · intro x y hx hy
      rcases hx with ⟨x', rfl⟩
      rcases hy with ⟨y', rfl⟩
      refine ⟨x' + y', ?_⟩
      exact RingHom.map_add beta_q x' y'
  -- Proof comment: this is the defining factorization formula of `RingHom.liftOfSurjective`.
  exact RingHom.liftOfSurjective_comp beta_q
    hbeta_q_surj
    ⟨(Ideal.Quotient.mk Kk).comp rawCancel_jk,
      by
        let qj : raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1] raw_tail_stage A₀ i₀ P₀ j ⧸ Kj :=
          Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj
        have hbeta_q_ker :
            RingHom.ker beta_q =
              Ideal.map
                (Algebra.TensorProduct.includeLeft :
                  raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
                    raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
                Kj := by
          calc
            RingHom.ker beta_q =
                Ideal.map
                  (Algebra.TensorProduct.includeLeft :
                    raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
                      raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
                  (RingHom.ker qj) := by
              simpa [beta_q, qj, tensorMapLeft_mixed] using
                (Algebra.TensorProduct.rTensor_ker
                  (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j)
                  (B := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) (C := A₀.RStage k.1)
                  (f := qj) (Ideal.Quotient.mkₐ_surjective (A₀.RStage j.1) Kj))
            _ =
                Ideal.map
                  (Algebra.TensorProduct.includeLeft :
                    raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
                      raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
                  Kj := by
              rw [← RingHom.ker_coe_toRingHom, Ideal.Quotient.mkₐ_ker]
        rw [hbeta_q_ker]
        exact range_tail_rawTensorCancel_kills_tensorized_stage_kernel_quotient
          A₀ i₀ P₀ e hjk⟩

/-- Helper for Lemma 10.127.17: the descended quotient owner is surjective because both the raw
tensor cancellation and the later quotient map are surjective. -/
theorem raw_tail_quotient_stageBaseChange_surjective
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    Function.Surjective (raw_tail_quotient_stageBaseChange A₀ i₀ P₀ e hjk) := by
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
  let Kk : Ideal (raw_tail_stage A₀ i₀ P₀ k) :=
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e k).rangeRestrict)
  let beta_q :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
      (C := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj)
      (Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj)
  let rawCancel_jk :=
    (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
      j.2 k.2 hjk
      (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).toRingHom
  intro z
  obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective z
  have hraw_surj : Function.Surjective rawCancel_jk := by
    simpa [rawCancel_jk] using
      (rawTensorCancel A₀.RStage (fun a b h ↦ A₀.RMap a b h) P₀
        j.2 k.2 hjk
        (RingHom.ext <| DirectedSystem.map_map (f := fun a b h ↦ A₀.RMap a b h) j.2 hjk)).surjective
  obtain ⟨x, hx⟩ := hraw_surj w
  refine ⟨beta_q x, ?_⟩
  have hfactor :
      (raw_tail_quotient_stageBaseChange A₀ i₀ P₀ e hjk) (beta_q x) =
        (Ideal.Quotient.mk Kk) (rawCancel_jk x) := by
    simpa [RingHom.comp_apply] using congrArg (fun g :
      raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1 →+*
        raw_tail_stage A₀ i₀ P₀ k ⧸ Kk ↦ g x)
      (raw_tail_quotient_stageBaseChange_comp_beta_q A₀ i₀ P₀ e hjk)
  rw [hx] at hfactor
  exact hfactor

/-- Helper for Lemma 10.127.17: tensoring the stage-`j` quotient-to-range equivalence identifies
the quotient tensor source with the owner tensor source. -/
theorem range_tail_source_quotient_comparison_comp_beta_q
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra.FinitePresentation (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
      (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
    let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
    let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
      (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
    let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
      RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) :=
      Ideal.Quotient.algebra (A₀.RStage j.1)
    let beta_q :=
      tensorMapLeft_mixed
        (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
        (C := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj)
        (Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj)
    let beta_jk :=
      tensorMapLeft_mixed
        (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
        (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
        (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
    let sourceComp :
        (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) ⊗[A₀.RStage j.1] A₀.RStage k.1 →+*
          (range_tail_sigma A₀ i₀ P₀ e j).range ⊗[A₀.RStage j.1] A₀.RStage k.1 :=
      tensorMapLeft_mixed
        (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) (B := A₀.RStage k.1)
        (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
        ((range_tail_sigma_quotientKerAlgEquiv A₀ i₀ P₀ e j).toAlgHom)
    sourceComp.comp beta_q = beta_jk := by
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
    (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
  let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) :=
    Ideal.Quotient.algebra (A₀.RStage j.1)
  let beta_q :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
      (C := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj)
      (Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj)
  let beta_jk :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
      (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
      (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
  let sourceComp :
      (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) ⊗[A₀.RStage j.1] A₀.RStage k.1 →+*
        (range_tail_sigma A₀ i₀ P₀ e j).range ⊗[A₀.RStage j.1] A₀.RStage k.1 :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) (B := A₀.RStage k.1)
      (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
      ((range_tail_sigma_quotientKerAlgEquiv A₀ i₀ P₀ e j).toAlgHom)
  -- Proof comment: both quotient presentations agree on pure tensors because the stage-`j`
  -- quotient-to-range equivalence sends the class of `x` to the literal range element `σⱼ x`.
  apply ringHom_eq_of_tmul
  intro x y
  simp only [RingHom.comp_apply, tensorMapLeft_mixed_tmul, Ideal.Quotient.mkₐ_eq_mk]
  exact congrArg (fun z ↦ z ⊗ₜ[A₀.RStage j.1] y)
    (range_tail_sigma_quotientKerAlgEquiv_mk A₀ i₀ P₀ e j x)

/-- Helper for Lemma 10.127.17: the quotient tensor source and the owner tensor source are
canonically the same quotient of the raw tensor source, hence the comparison is bijective. -/
theorem range_tail_source_quotient_comparison
    (A₀ : DirectedFiniteTypeHomApproximation.{u, u, u} (RingHom.id R)) (i₀ : A₀.Λ)
    (P₀ : Type u) [CommRing P₀] [Algebra (A₀.RStage i₀) P₀]
    [Algebra.FinitePresentation (A₀.RStage i₀) P₀]
    [Algebra R S] (e : raw_tail_limitTensor A₀ i₀ P₀ ≃ₐ[R] S)
    {j k : Set.Ici i₀} (hjk : j ≤ k) :
    let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
      (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
    let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
    let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
    let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
      (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
    let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
      RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
    let sourceComp :
        (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) ⊗[A₀.RStage j.1] A₀.RStage k.1 →+*
          (range_tail_sigma A₀ i₀ P₀ e j).range ⊗[A₀.RStage j.1] A₀.RStage k.1 :=
      tensorMapLeft_mixed
        (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) (B := A₀.RStage k.1)
        (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
        ((range_tail_sigma_quotientKerAlgEquiv A₀ i₀ P₀ e j).toAlgHom)
    Function.Bijective sourceComp := by
  let _ : Algebra (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) :=
    (raw_tail_stageMap A₀ i₀ P₀ j).toAlgebra
  let _ : Module (A₀.RStage j.1) (raw_tail_stage A₀ i₀ P₀ j) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) (A₀.RStage k.1) := (A₀.RMap j.1 k.1 hjk).toAlgebra
  let _ : Module (A₀.RStage j.1) (A₀.RStage k.1) := Algebra.toModule
  let _ : Algebra (A₀.RStage j.1) ((range_tail_sigma A₀ i₀ P₀ e j).range) :=
    (((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict).comp (raw_tail_stageMap A₀ i₀ P₀ j)).toAlgebra
  let Kj : Ideal (raw_tail_stage A₀ i₀ P₀ j) :=
    RingHom.ker ((range_tail_sigma A₀ i₀ P₀ e j).rangeRestrict)
  let beta_q :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
      (C := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj)
      (Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj)
  let beta_jk :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j) (B := A₀.RStage k.1)
      (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
      (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
  let sourceComp :
      (raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) ⊗[A₀.RStage j.1] A₀.RStage k.1 →+*
        (range_tail_sigma A₀ i₀ P₀ e j).range ⊗[A₀.RStage j.1] A₀.RStage k.1 :=
    tensorMapLeft_mixed
      (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) (B := A₀.RStage k.1)
      (C := (range_tail_sigma A₀ i₀ P₀ e j).range)
      ((range_tail_sigma_quotientKerAlgEquiv A₀ i₀ P₀ e j).toAlgHom)
  have hcomp : sourceComp.comp beta_q = beta_jk := by
    exact range_tail_source_quotient_comparison_comp_beta_q A₀ i₀ P₀ e hjk
  have hbeta_q_surj : Function.Surjective beta_q := by
    intro z
    refine TensorProduct.induction_on z ?_ ?_ ?_
    · refine ⟨0, by simp [beta_q, tensorMapLeft_mixed]⟩
    · intro x y
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mkₐ_surjective (A₀.RStage j.1) Kj x
      refine ⟨a ⊗ₜ[A₀.RStage j.1] y, ?_⟩
      simp [beta_q, tensorMapLeft_mixed_tmul]
    · intro x y hx hy
      rcases hx with ⟨x', rfl⟩
      rcases hy with ⟨y', rfl⟩
      refine ⟨x' + y', ?_⟩
      exact RingHom.map_add beta_q x' y'
  have hbeta_jk_surj : Function.Surjective beta_jk := by
    exact tensorMapLeft_mixed_surjective
      (range_tail_sigma_rangeRestrictAlgHom A₀ i₀ P₀ e j)
      (range_tail_sigma_rangeRestrictAlgHom_surjective A₀ i₀ P₀ e j)
  have hbeta_q_ker :
      RingHom.ker beta_q =
        Ideal.map
          (Algebra.TensorProduct.includeLeft :
            raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
              raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
          Kj := by
    -- Proof comment: the quotient tensor source is the canonical tensor quotient by `Kⱼ`.
    let qj : raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1] raw_tail_stage A₀ i₀ P₀ j ⧸ Kj :=
      Ideal.Quotient.mkₐ (A₀.RStage j.1) Kj
    calc
      RingHom.ker beta_q =
          Ideal.map
            (Algebra.TensorProduct.includeLeft :
              raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
                raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
            (RingHom.ker qj) := by
        simpa [beta_q, qj, tensorMapLeft_mixed] using
          (Algebra.TensorProduct.rTensor_ker
            (R := A₀.RStage j.1) (A := raw_tail_stage A₀ i₀ P₀ j)
            (B := raw_tail_stage A₀ i₀ P₀ j ⧸ Kj) (C := A₀.RStage k.1)
            (f := qj) (Ideal.Quotient.mkₐ_surjective (A₀.RStage j.1) Kj))
      _ =
          Ideal.map
            (Algebra.TensorProduct.includeLeft :
              raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
                raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
            Kj := by
        rw [← RingHom.ker_coe_toRingHom, Ideal.Quotient.mkₐ_ker]
  have hbeta_jk_ker :
      RingHom.ker beta_jk =
        Ideal.map
          (Algebra.TensorProduct.includeLeft :
            raw_tail_stage A₀ i₀ P₀ j →ₐ[A₀.RStage j.1]
              raw_tail_stage A₀ i₀ P₀ j ⊗[A₀.RStage j.1] A₀.RStage k.1)
          Kj := by
    exact range_tail_beta_kernel_eq_map_includeLeft A₀ i₀ P₀ e hjk
  -- Proof comment: both source presentations are surjective quotients of the same raw tensor
  -- source with the same kernel, so the comparison between them is bijective.
  exact bijective_of_comp_eq_of_surjective_of_ker_eq
    hcomp hbeta_q_surj hbeta_jk_surj (hbeta_q_ker.trans hbeta_jk_ker.symm)
