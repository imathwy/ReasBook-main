universe u v

open IsLocalRing

section

variable {R : Type u} [CommRing R] [IsCompleteLocalRing R] [IsRegularLocalRing R]

/-- Helper for Chap10 Lemma 10 160 10: coefficientwise application of a ring equivalence gives a
ring equivalence on multivariable power series. -/
noncomputable theorem mvPowerSeriesRingEquivOfRingEquiv
    {A B : Type*} [CommSemiring A] [CommSemiring B] (σ : Type*) (e : A ≃+* B) :
    MvPowerSeries σ A ≃+* MvPowerSeries σ B := by
  let hleft :
      (MvPowerSeries.map e.symm.toRingHom).comp (MvPowerSeries.map e.toRingHom) =
        RingHom.id (MvPowerSeries σ A) := by
    -- Proof comment: composing coefficientwise with `e` and `e.symm` is the identity.
    rw [← MvPowerSeries.map_comp]
    ext a
    simp
  let hright :
      (MvPowerSeries.map e.toRingHom).comp (MvPowerSeries.map e.symm.toRingHom) =
        RingHom.id (MvPowerSeries σ B) := by
    -- Proof comment: the same coefficientwise cancellation works in the other direction.
    rw [← MvPowerSeries.map_comp]
    ext b
    simp
  refine RingEquiv.ofBijective (MvPowerSeries.map e.toRingHom) ?_
  constructor
  · intro p q hpq
    -- Proof comment: apply the inverse coefficient map to both sides and cancel the composite.
    have h := congrArg (MvPowerSeries.map e.symm.toRingHom) hpq
    simpa [RingHom.comp_apply, hleft] using h
  · intro q
    -- Proof comment: map a power series with coefficients in `B` back along `e.symm`.
    refine ⟨MvPowerSeries.map e.symm.toRingHom q, ?_⟩
    simpa [RingHom.comp_apply, hright]

/-- Helper for Chap10 Lemma 10 160 10: a field identifies with its residue field. -/
noncomputable theorem ringEquiv_residueField_of_field
    (k : Type*) [Field k] :
    k ≃+* ResidueField k := by
  refine RingEquiv.ofBijective (IsLocalRing.residue k) ?_
  constructor
  · intro x y hxy
    -- Proof comment: for a field the maximal ideal is zero, so the quotient map is injective.
    change Ideal.Quotient.mk (maximalIdeal k) x = Ideal.Quotient.mk (maximalIdeal k) y at hxy
    simpa [IsLocalRing.maximalIdeal_eq_bot] using hxy
  · -- Proof comment: every residue class has a representative by definition.
    exact IsLocalRing.residue_surjective

/-- Helper for Chap10 Lemma 10 160 10: a coefficient ring in equal characteristic is a field. -/
theorem coefficientRing_isField_of_equalCharacteristic
    {Λ : Subring R} [hΛ : IsCoefficientRing R Λ]
    (heqchar : ringChar R = ringChar (ResidueField R)) :
    IsField Λ := by
  have hzero : ((ringChar (ResidueField R) : ℕ) : Λ) = 0 := by
    -- Proof comment: equal characteristic makes the residue characteristic vanish already in `R`.
    ext
    change ((ringChar (ResidueField R) : ℕ) : R) = 0
    rw [← heqchar]
    exact (ringChar.spec R (ringChar R)).2 dvd_rfl
  have hmax : maximalIdeal Λ = ⊥ := by
    -- Proof comment: the coefficient-ring maximal ideal is generated by the vanishing residue
    -- characteristic element, hence is zero.
    rw [hΛ.maximalIdeal_eq_span_residueChar]
    exact Ideal.span_singleton_eq_bot.mpr hzero
  -- Proof comment: a local ring with zero maximal ideal is a field.
  exact IsLocalRing.isField_iff_maximalIdeal_eq.mpr hmax

/-- Helper for Chap10 Lemma 10 160 10: transporting coefficients along a field presentation over
`k` yields the corresponding presentation over `ResidueField R`. -/
noncomputable theorem ringEquiv_mvPowerSeries_residueField_of_fieldPresentation
    {k : Type*} [CommSemiring k] {σ : Type*}
    (eκ : k ≃+* ResidueField R) (e : MvPowerSeries σ k ≃+* R) :
    MvPowerSeries σ (ResidueField R) ≃+* R := by
  -- Proof comment: first rewrite the coefficients from `ResidueField R` back to `k`, then apply
  -- the chosen presentation.
  exact (mvPowerSeriesRingEquivOfRingEquiv σ eκ.symm).trans e

/-- Helper for Chap10 Lemma 10 160 10: polynomial evaluation sends the variables ideal onto the
ideal spanned by the chosen target elements. -/
theorem mvPolynomialIdealOfVars_eval₂Hom_map_eq_span
    {A S σ : Type*} [CommSemiring A] [CommSemiring S]
    (ι : A →+* S) (x : σ → S) :
    Ideal.map (MvPolynomial.eval₂Hom ι x) (MvPolynomial.idealOfVars σ A) =
      Ideal.span (Set.range x) := by
  -- Proof comment: the variables ideal is generated by the `X i`, and evaluation sends `X i` to
  -- the chosen elements `x i`.
  rw [MvPolynomial.idealOfVars, Ideal.map_span]
  congr
  ext y
  simp

/-- Helper for Chap10 Lemma 10 160 10: if the chosen elements generate the maximal ideal, then
polynomial evaluation maps the variables ideal onto `maximalIdeal R`. -/
theorem mvPolynomialIdealOfVars_eval₂Hom_map_eq_maximalIdeal
    {A σ : Type*} [CommSemiring A] (ι : A →+* R) (x : σ → R)
    (hxspan : Ideal.span (Set.range x) = maximalIdeal R) :
    Ideal.map (MvPolynomial.eval₂Hom ι x) (MvPolynomial.idealOfVars σ A) =
      maximalIdeal R := by
  -- Proof comment: reduce the maximal-ideal statement to the generic span calculation.
  rw [mvPolynomialIdealOfVars_eval₂Hom_map_eq_span, hxspan]

/-- Helper for Chap10 Lemma 10 160 10: polynomial evaluation is surjective modulo the maximal
ideal once the coefficient map is bijective on residue fields. -/
theorem mvPolynomialEval_mod_maximal_surjective
    {A σ : Type*} [CommRing A] [IsLocalRing A]
    (ι : A →+* R) [IsLocalHom ι]
    (hres : Function.Bijective (ResidueField.map ι)) (x : σ → R) :
    Function.Surjective
      ((Ideal.Quotient.mk (maximalIdeal R)).comp (MvPolynomial.eval₂Hom ι x)) := by
  intro y
  -- Proof comment: lift a residue class to the source residue field and realize it by a constant
  -- polynomial.
  rcases hres.2 y with ⟨z, hz⟩
  rcases IsLocalRing.residue_surjective z with ⟨a, rfl⟩
  refine ⟨MvPolynomial.C a, ?_⟩
  simpa [IsLocalRing.ResidueField.map_residue] using hz

/-- Helper for Chap10 Lemma 10 160 10: the same residue-level surjectivity holds modulo the image
of the variables ideal once that image is identified with `maximalIdeal R`. -/
theorem mvPolynomialEval_mod_imageIdeal_surjective
    {A σ : Type*} [CommRing A] [IsLocalRing A]
    (ι : A →+* R) [IsLocalHom ι]
    (hres : Function.Bijective (ResidueField.map ι)) (x : σ → R)
    (hmap :
      Ideal.map (MvPolynomial.eval₂Hom ι x) (MvPolynomial.idealOfVars σ A) =
        maximalIdeal R) :
    Function.Surjective
      ((Ideal.Quotient.mk
        (Ideal.map (MvPolynomial.eval₂Hom ι x) (MvPolynomial.idealOfVars σ A))).comp
          (MvPolynomial.eval₂Hom ι x)) := by
  -- Proof comment: rewrite the image ideal to the maximal ideal and invoke the residue-field
  -- calculation.
  rw [hmap]
  exact mvPolynomialEval_mod_maximal_surjective (R := R) ι hres x

/-- Helper for Chap10 Lemma 10 160 10: powers of an ideal map into the matching powers of its
image ideal. -/
theorem ideal_pow_le_comap_pow_of_map_eq
    {P S : Type*} [CommRing P] [CommRing S] {J : Ideal P} {I : Ideal S}
    (g : P →+* S) (hmap : Ideal.map g J = I) (n : ℕ) :
    J ^ n ≤ (I ^ n).comap g := by
  -- Proof comment: rewrite the target power as the image of the source power and use the
  -- map/comap adjunction.
  exact Ideal.map_le_iff_le_comap.mp (by rw [Ideal.map_pow, hmap])

/-- Helper for Chap10 Lemma 10 160 10: the quotient maps induced by a ring homomorphism on adic
completions are compatible in the inverse system. -/
theorem adicCompletionQuotientMaps_compatible
    {P S : Type*} [CommRing P] [CommRing S] {J : Ideal P} {I : Ideal S}
    (g : P →+* S) (hmap : Ideal.map g J = I) :
    let f : (n : ℕ) → AdicCompletion J P →+* S ⧸ I ^ n := fun n =>
      (Ideal.quotientMap (I ^ n) g (ideal_pow_le_comap_pow_of_map_eq g hmap n)).comp
        (AdicCompletion.evalₐ J n).toRingHom
    ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (f n) = f m := by
  dsimp only
  intro m n hle
  ext y
  -- Proof comment: reduce compatibility to representatives of the Cauchy sequence defining the
  -- completion point.
  apply AdicCompletion.induction_on J P y
  intro a
  change (Ideal.Quotient.mk (I ^ m)) (g (↑(a n) : P)) =
    (Ideal.Quotient.mk (I ^ m)) (g (↑(a m) : P))
  rw [Ideal.Quotient.eq]
  have hcong :
      (↑(a n) : P) ≡ (↑(a m) : P) [SMOD (J ^ m • ⊤ : Submodule P P)] :=
    (a.property hle).symm
  have hmemJ : ((↑(a n) : P) - (↑(a m) : P)) ∈ J ^ m := by
    simpa using (SModEq.sub_mem.mp hcong)
  have hmem : g ((↑(a n) : P) - (↑(a m) : P)) ∈ Ideal.map g (J ^ m) :=
    Ideal.mem_map_of_mem g hmemJ
  have hmap_pow : Ideal.map g (J ^ m) = I ^ m := by
    rw [Ideal.map_pow, hmap]
  simpa [map_sub, hmap_pow] using hmem

/-- Helper for Chap10 Lemma 10 160 10: the lifted map from an adic completion agrees with the
original ring map on polynomial elements. -/
theorem adicCompletionLiftRingHom_comp_algebraMap
    {P S : Type*} [CommRing P] [CommRing S] {J : Ideal P} {I : Ideal S}
    (g : P →+* S) (hmap : Ideal.map g J = I) [IsAdicComplete I S] :
    let f : (n : ℕ) → AdicCompletion J P →+* S ⧸ I ^ n := fun n =>
      (Ideal.quotientMap (I ^ n) g (ideal_pow_le_comap_pow_of_map_eq g hmap n)).comp
        (AdicCompletion.evalₐ J n).toRingHom
    (IsAdicComplete.liftRingHom I f (adicCompletionQuotientMaps_compatible g hmap)).comp
      (algebraMap P (AdicCompletion J P)) = g := by
  dsimp only
  let f : (n : ℕ) → AdicCompletion J P →+* S ⧸ I ^ n := fun n =>
    (Ideal.quotientMap (I ^ n) g (ideal_pow_le_comap_pow_of_map_eq g hmap n)).comp
      (AdicCompletion.evalₐ J n).toRingHom
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (f n) = f m :=
    adicCompletionQuotientMaps_compatible g hmap
  let G : AdicCompletion J P →+* S := IsAdicComplete.liftRingHom I f hf
  -- Proof comment: equality of maps into the Hausdorff target ring can be checked on all power
  -- quotient reductions.
  apply DFunLike.coe_injective
  apply IsHausdorff.funext' I
  intro n x
  calc
    Ideal.Quotient.mk (I ^ n) (G ((algebraMap P (AdicCompletion J P)) x)) =
        f n ((algebraMap P (AdicCompletion J P)) x) := by
      exact
        RingHom.congr_fun (IsAdicComplete.mk_comp_liftRingHom I f hf n)
          ((algebraMap P (AdicCompletion J P)) x)
    _ = Ideal.Quotient.mk (I ^ n) (g x) := by
      simp [f, Ideal.quotientMap_mk]

/-- Helper for Chap10 Lemma 10 160 10: surjectivity modulo the image ideal lifts to a surjective
map from the adic completion of the source. -/
theorem adicCompletionMapRingHom_surjective_of_quotient_surjective
    {P S : Type*} [CommRing P] [CommRing S] {J : Ideal P} {I : Ideal S}
    [IsAdicComplete I S] (g : P →+* S) (hmap : Ideal.map g J = I)
    (hJfg : J.FG) (hmod : Function.Surjective ((Ideal.Quotient.mk I).comp g)) :
    ∃ G : AdicCompletion J P →+* S,
      Function.Surjective G ∧ G.comp (algebraMap P (AdicCompletion J P)) = g := by
  let f : (n : ℕ) → AdicCompletion J P →+* S ⧸ I ^ n := fun n =>
    (Ideal.quotientMap (I ^ n) g (ideal_pow_le_comap_pow_of_map_eq g hmap n)).comp
      (AdicCompletion.evalₐ J n).toRingHom
  have hf : ∀ {m n : ℕ} (hle : m ≤ n), (Ideal.Quotient.factorPow I hle).comp (f n) = f m :=
    adicCompletionQuotientMaps_compatible g hmap
  let G : AdicCompletion J P →+* S := IsAdicComplete.liftRingHom I f hf
  have hGcomp : G.comp (algebraMap P (AdicCompletion J P)) = g := by
    simpa [G, f, hf] using adicCompletionLiftRingHom_comp_algebraMap (I := I) g hmap
  refine ⟨G, ?_, hGcomp⟩
  let K : Ideal (AdicCompletion J P) := Ideal.map (algebraMap P (AdicCompletion J P)) J
  have hpre : IsPrecomplete K (AdicCompletion J P) := by
    change IsPrecomplete (Ideal.map (algebraMap P (AdicCompletion J P)) J)
      (AdicCompletion J P)
    have hcomp : IsAdicComplete J (AdicCompletion J P) := AdicCompletion.isAdicComplete hJfg
    letI : IsAdicComplete J (AdicCompletion J P) := hcomp
    exact (IsPrecomplete.map_algebraMap_iff (I := J) (M := AdicCompletion J P)).2 inferInstance
  have hGmap : Ideal.map G K = I := by
    calc
      Ideal.map G K = Ideal.map (G.comp (algebraMap P (AdicCompletion J P))) J := by
        rw [Ideal.map_map]
      _ = Ideal.map g J := by
        rw [hGcomp]
      _ = I := hmap
  have hhaus : IsHausdorff (Ideal.map G K) S := by
    rw [hGmap]
    infer_instance
  -- Proof comment: separated/precomplete surjectivity reduces the completed map to the already
  -- known surjectivity modulo the image ideal.
  apply @surjective_of_mk_map_comp_surjective
    (AdicCompletion J P) inferInstance K S inferInstance G hpre hhaus
  intro y
  let e : S ⧸ Ideal.map G K ≃+* S ⧸ I := Ideal.quotEquivOfEq hGmap
  rcases hmod (e y) with ⟨x, hx⟩
  refine ⟨(algebraMap P (AdicCompletion J P)) x, ?_⟩
  apply e.injective
  change (Ideal.Quotient.mk I) (G ((algebraMap P (AdicCompletion J P)) x)) = e y
  have hxG : G ((algebraMap P (AdicCompletion J P)) x) = g x :=
    RingHom.congr_fun hGcomp x
  rw [hxG]
  exact hx

/-- Helper for Chap10 Lemma 10 160 10: a residue-field-bijective coefficient field together with
regular parameters gives a surjective finite-variable formal power series algebra map. -/
theorem surjectiveAlgHom_mvPowerSeries_fin_of_residueField_bijective
    (k : Type v) [Field k] [Algebra k R]
    (hres : Function.Bijective (ResidueField.map (algebraMap k R))) :
    ∃ φ : MvPowerSeries (Fin (ringKrullDim R)) k →ₐ[k] R, Function.Surjective φ := by
  let d := ringKrullDim R
  have hdim : ringKrullDim R = d := rfl
  obtain ⟨x, hxreg⟩ :=
    (isRegularLocalRing_iff_exists_regularSystemOfParameters (R := R) (d := d) hdim).1
      inferInstance
  let xR : Fin d → R := fun i ↦ (x i : R)
  have hxmem : ∀ i, xR i ∈ maximalIdeal R := fun i ↦ (x i).2
  have hxspan : Ideal.span (Set.range xR) = maximalIdeal R := by
    -- Proof comment: a regular system of parameters generates the maximal ideal.
    have hparam :
        IsLocalRing.parameterIdeal x = maximalIdeal R :=
      (isRegularSystemOfParameters_iff_of_ringKrullDim_eq (R := R) hdim x).1 hxreg
    simpa [IsLocalRing.parameterIdeal_eq_span, xR] using hparam
  let g : MvPolynomial (Fin d) k →+* R := MvPolynomial.eval₂Hom (algebraMap k R) xR
  let J : Ideal (MvPolynomial (Fin d) k) := MvPolynomial.idealOfVars (Fin d) k
  have hmapJ : Ideal.map g J = maximalIdeal R := by
    exact
      mvPolynomialIdealOfVars_eval₂Hom_map_eq_maximalIdeal
        (R := R) (algebraMap k R) xR hxspan
  have hmod :
      Function.Surjective ((Ideal.Quotient.mk (Ideal.map g J)).comp g) := by
    -- Proof comment: modulo the variables ideal, only the constant term remains, and residue-field
    -- bijectivity lifts that constant term to the source field.
    exact mvPolynomialEval_mod_imageIdeal_surjective (R := R) (algebraMap k R) hres xR hmapJ
  have hmodMax :
      Function.Surjective ((Ideal.Quotient.mk (maximalIdeal R)).comp g) := by
    -- Proof comment: transport the previous surjectivity across the equality
    -- `Ideal.map g J = maximalIdeal R`.
    intro y
    let e : R ⧸ Ideal.map g J ≃+* R ⧸ maximalIdeal R := Ideal.quotEquivOfEq hmapJ
    rcases hmod (e.symm y) with ⟨z, hz⟩
    refine ⟨z, ?_⟩
    change e (((Ideal.Quotient.mk (Ideal.map g J)).comp g) z) = y
    rw [hz]
    exact e.apply_symm_apply y
  have hJfg : J.FG := by
    exact MvPolynomial.idealOfVars_fg (Fin d) k
  rcases
      adicCompletionMapRingHom_surjective_of_quotient_surjective
        (I := maximalIdeal R) g hmapJ hJfg hmodMax with
    ⟨G, hGsurj, hGcomp⟩
  let φring : MvPowerSeries (Fin d) k →+* R :=
    G.comp (MvPowerSeries.toAdicCompletionAlgEquiv (Fin d) k).toRingHom
  let φ : MvPowerSeries (Fin d) k →ₐ[k] R :=
    { toRingHom := φring
      commutes' := fun a ↦ by
        -- Proof comment: the completed map agrees with polynomial evaluation on constants, so the
        -- resulting power-series map restricts to the original coefficient algebra map.
        change G ((MvPowerSeries.toAdicCompletionAlgEquiv (Fin d) k)
            (algebraMap k (MvPowerSeries (Fin d) k) a)) = algebraMap k R a
        rw [MvPowerSeries.algebraMap_apply, ← MvPolynomial.coe_C,
          MvPowerSeries.toAdicCompletion_coe]
        change g (MvPolynomial.C a) = algebraMap k R a
        simp [g] }
  exact ⟨φ, hGsurj.comp (MvPowerSeries.toAdicCompletionAlgEquiv (Fin d) k).surjective⟩

/-- Helper for Chap10 Lemma 10 160 10: a surjective `Fin d`-indexed power-series presentation of a
regular complete local ring is injective by the regular-local kernel TFAE and the dimension
computation for formal power series over a field. -/
theorem ker_eq_bot_of_surjective_mvPowerSeries_fin_presentation
    (k : Type v) [Field k] [Algebra k R]
    (φ : MvPowerSeries (Fin (ringKrullDim R)) k →ₐ[k] R)
    (hφ : Function.Surjective φ) :
    RingHom.ker φ.toRingHom = ⊥ := by
  letI : IsLocalHom φ.toRingHom := Function.Surjective.isLocalHom _ hφ
  have htfae :=
    ker_generatedBy_regularSequence_tfae_of_surjective_local_of_isRegularLocalRing
      (A := MvPowerSeries (Fin (ringKrullDim R)) k) (B := R) (C := R)
      φ.toRingHom (RingHom.id R) hφ (by intro y; exact ⟨y, rfl⟩)
  have hid :
      ∃ (d : ℕ) (_ : ringKrullDim R + d = ringKrullDim R) (y : Fin d → R),
        Ideal.span (Set.range y) = RingHom.ker (RingHom.id R) := by
    -- Proof comment: the identity map has zero kernel, witnessed by the empty family.
    refine ⟨0, by simp, Fin.elim0, ?_⟩
    simp
  rcases (htfae.out 1 3).mpr hid with ⟨d, hd, x, hx⟩
  have hdim :
      ringKrullDim R + d = ringKrullDim R := by
    -- Proof comment: the source and target have the same dimension because the source is the
    -- `d`-variable power series ring over a field with `d = ringKrullDim R`.
    simpa [ringKrullDim_mvPowerSeries_fin_field] using hd
  have hdzero : d = 0 := by
    omega
  subst hdzero
  -- Proof comment: after the dimension collapse, the witnessing generating family is empty, so
  -- the kernel is zero.
  simpa using hx

/- Domain-style sampling:
* primary domain: Cohen-structure presentations of complete regular local rings.
* source/core/bridge triage:
  - `source-facing`: the intrinsic equal-characteristic power-series presentation of `R`;
  - `core/canonical`: the finite-index owner `MvPowerSeries σ A` with `[Finite σ]`;
  - `bridge/view`: the chosen coefficient-field presentation via `Algebra k R` and the canonical
    residue-field map `ResidueField.map (algebraMap k R)`.
* sampled owner declarations:
  `IsRegularLocalRing`,
  `exists_mvPowerSeries_quotient_of_exists_coefficientRing_of_maximalIdeal_fg`,
  `isNoetherianRing_mvPowerSeries_of_finite`,
  `ResidueField.map`.
* best owner abstraction: the chapter already treats “formal power series in finitely many
  variables” through `MvPowerSeries σ _` with `[Finite σ]`, so the target statements should not
  keep the lower-level `Fin d` encoding as their main public surface.
* primitive data: the regular-complete-local owner on `R`, and in the bridge theorem a field
  `k` with a residue-field isomorphism.
* derived API: any `Fin d` presentation obtained from the finite-index owner via
  `Fintype.equivFin`.
-/

-- Proof sketch: in equal characteristic, the Cohen structure theorem provides a coefficient field
-- mapping isomorphically to `ResidueField R`. Applying the power-series presentation to a regular
-- system of parameters then identifies `R` with a finite-variable formal power series ring over
-- that field, hence over `ResidueField R`.
/-- Lemma 10.160.10 (1): if a complete regular local ring has the same characteristic as its
residue field, then it is isomorphic to a finite-variable formal power series ring over its
residue field. -/
@[stacks 0C0S]
theorem exists_ringEquiv_mvPowerSeries_residueField_of_equalCharacteristic
    (heqchar : ringChar R = ringChar (ResidueField R)) :
    ∃ (σ : Type) (_ : Finite σ), Nonempty (MvPowerSeries σ (ResidueField R) ≃+* R) := by
  rcases existsCoefficientSubringOfNoetherianCompleteLocalRing (A := R) with ⟨Λ₀, hΛ₀⟩
  letI : IsCoefficientRing R Λ₀ := hΛ₀
  letI : Field Λ₀ :=
    (coefficientRing_isField_of_equalCharacteristic (R := R) (Λ := Λ₀) heqchar).toField
  let eκ : Λ₀ ≃+* ResidueField R :=
    (ringEquiv_residueField_of_field Λ₀).trans
      (RingEquiv.ofBijective
        (ResidueField.map (Λ₀.subtype : Λ₀ →+* R)) hΛ₀.residueField_bijective)
  -- Proof comment: after choosing an equal-characteristic coefficient field, theorem (2) gives a
  -- finite-variable presentation over that field, and we transport coefficients to `ResidueField R`.
  rcases
      exists_algEquiv_mvPowerSeries_of_residueField_bijective
        (R := R) Λ₀ (by simpa using hΛ₀.residueField_bijective) with
    ⟨σ, hσ, ⟨e⟩⟩
  refine ⟨σ, hσ, ?_⟩
  exact ⟨ringEquiv_mvPowerSeries_residueField_of_fieldPresentation
    (R := R) eκ e.toRingEquiv⟩

-- Proof sketch: choose elements of `maximalIdeal R` whose classes form a basis of the cotangent
-- space over `k`, and send the variables of a finite-index power series ring `MvPowerSeries σ k`
-- to these elements. Since both rings are complete for the maximal-ideal topology, the induced
-- continuous `k`-algebra map is surjective; regularity forces injectivity by the dimension count.
/-- Lemma 10.160.10 (2): if `k → R` induces an isomorphism onto the residue field of a complete
regular local ring, then `R` is `k`-algebra isomorphic to a finite-variable formal power series
ring over `k`. -/
@[stacks 0C0S]
theorem exists_algEquiv_mvPowerSeries_of_residueField_bijective
    (k : Type v) [Field k] [Algebra k R]
    (hres : Function.Bijective (ResidueField.map (algebraMap k R))) :
    ∃ (σ : Type) (_ : Finite σ), Nonempty (MvPowerSeries σ k ≃ₐ[k] R) := by
  rcases
      surjectiveAlgHom_mvPowerSeries_fin_of_residueField_bijective
        (R := R) k hres with
    ⟨φ, hφsurj⟩
  have hker :
      RingHom.ker φ.toRingHom = ⊥ :=
    ker_eq_bot_of_surjective_mvPowerSeries_fin_presentation (R := R) k φ hφsurj
  have hφinj : Function.Injective φ := RingHom.injective_iff_ker_eq_bot.mpr hker
  -- Proof comment: surjectivity came from the completed evaluation map, and kernel-triviality
  -- upgrades it to the desired algebra equivalence.
  refine ⟨Fin (ringKrullDim R), inferInstance, ?_⟩
  exact ⟨AlgEquiv.ofBijective φ ⟨hφinj, hφsurj⟩⟩

end
