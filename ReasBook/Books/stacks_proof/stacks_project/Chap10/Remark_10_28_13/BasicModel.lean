import Mathlib
import stacks_proof.stacks_project.Chap10.Example_10_28_6

noncomputable section

open MvPolynomial

universe u v

section

variable {R : Type u} [CommRing R]

/- The primary owner abstraction here is `Ideal.IsOka`; Remark 10.28.13 uses the chapter
specialization `Ideal.isOka_spanRank_le` for the predicate `I.spanRank ≤ κ` with `κ` infinite. -/
recall Ideal.isOka_spanRank_le
recall Ideal.IsOka.isPrime_of_maximal_not

end

/-- The variables used in the explicit quotient-ring model from Remark 10.28.13. -/
inductive Remark102813Var (T : Type v)
  | x : ℕ → Remark102813Var T
  | z : T → ℕ → Remark102813Var T

section

variable (k : Type u) [Field k] (T : Type v)

/-- The polynomial variable corresponding to `x_(n + 1)` in the model of Remark 10.28.13. -/
noncomputable def remark102813X (n : ℕ) : MvPolynomial (Remark102813Var T) k :=
  X (Remark102813Var.x n)

/-- The polynomial variable `z_{t,n}` in the model of Remark 10.28.13. -/
noncomputable def remark102813Z (t : T) (n : ℕ) : MvPolynomial (Remark102813Var T) k :=
  X (Remark102813Var.z t n)

/-- The defining relations used in the explicit quotient-ring example of Remark 10.28.13. -/
noncomputable def remark102813Relations : Set (MvPolynomial (Remark102813Var T) k) :=
  Set.range (fun n : ℕ ↦ remark102813X k T n ^ 2) ∪
    Set.range (fun p : T × ℕ ↦ remark102813Z k T p.1 p.2 ^ 2) ∪
      Set.range
        (fun p : T × ℕ ↦
          remark102813X k T (p.2 + 1) *
              remark102813Z k T p.1 (p.2 + 1) -
            remark102813Z k T p.1 p.2)

/-- The ideal of defining relations for the quotient ring in Remark 10.28.13. -/
noncomputable def remark102813RelationsIdeal : Ideal (MvPolynomial (Remark102813Var T) k) :=
  Ideal.span (remark102813Relations k T)

/-- The explicit quotient ring used in Remark 10.28.13. -/
noncomputable def remark102813Ring : Type (max u v) :=
  MvPolynomial (Remark102813Var T) k ⧸ remark102813RelationsIdeal k T

instance : CommRing (remark102813Ring k T) :=
  inferInstanceAs
    (CommRing (MvPolynomial (Remark102813Var T) k ⧸ remark102813RelationsIdeal k T))

/-- The ideal `(x_n)` inside the quotient ring from Remark 10.28.13. -/
noncomputable def remark102813MaximalIdeal : Ideal (remark102813Ring k T) :=
  Ideal.span <|
    Set.range fun n : ℕ ↦
      Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n)

/-- The ideal `(z_{t,n})` inside the quotient ring from Remark 10.28.13. -/
noncomputable def remark102813BadIdeal : Ideal (remark102813Ring k T) :=
  Ideal.span <|
    Set.range fun p : T × ℕ ↦
      Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813Z k T p.1 p.2)

/-- Helper for Remark 10.28.13: the relation `x_n^2 = 0` holds in the quotient ring. -/
lemma remark102813_x_square_eq_zero (n : ℕ) :
    Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n) ^ 2 = 0 := by
  -- The square relation is one of the defining generators of the presentation ideal.
  exact Ideal.Quotient.eq_zero_iff_mem.2 <|
    Ideal.subset_span <|
      Or.inl <|
        Or.inl <|
          Set.mem_range_self n

/-- Helper for Remark 10.28.13: the relation `z_{t,n}^2 = 0` holds in the quotient ring. -/
lemma remark102813_z_square_eq_zero (t : T) (n : ℕ) :
    Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813Z k T t n) ^ 2 = 0 := by
  -- The square relation for `z_{t,n}` is also a defining generator.
  exact Ideal.Quotient.eq_zero_iff_mem.2 <|
    Ideal.subset_span <|
      Or.inl <|
        Or.inr <|
          Set.mem_range_self (t, n)

/-- Helper for Remark 10.28.13: in the quotient, `z_{t,n}` equals `x_{n+1} z_{t,n+1}`. -/
lemma remark102813_z_recurrence (t : T) (n : ℕ) :
    Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813Z k T t n) =
      Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T (n + 1)) *
        Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813Z k T t (n + 1)) := by
  -- The mixed defining relation becomes an equality after passing to the quotient.
  have hzero :
      Ideal.Quotient.mk (remark102813RelationsIdeal k T)
        (remark102813X k T (n + 1) * remark102813Z k T t (n + 1) - remark102813Z k T t n) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.2 <|
      Ideal.subset_span <|
        Or.inr <|
          Set.mem_range_self (t, n)
  exact (sub_eq_zero.mp hzero).symm

/-- Helper for Remark 10.28.13: each `z_{t,n}` lies in the ideal generated by the images of the
`x_n`. -/
lemma remark102813_z_mem_maximalIdeal (t : T) (n : ℕ) :
    Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813Z k T t n) ∈
      remark102813MaximalIdeal k T := by
  -- Rewrite `z_{t,n}` using the presentation relation and use ideal closure under multiplication.
  rw [remark102813_z_recurrence]
  exact Ideal.mul_mem_right _ _ <|
    Ideal.subset_span <|
      Set.mem_range_self (n + 1)

/-- Helper for Remark 10.28.13: the ideal `(z_{t,n})` is contained in `(x_n)`. -/
lemma remark102813_badIdeal_le_maximalIdeal :
    remark102813BadIdeal k T ≤ remark102813MaximalIdeal k T := by
  -- It is enough to check the containment on the chosen generators `z_{t,n}`.
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨t, n⟩, rfl⟩
  exact remark102813_z_mem_maximalIdeal (k := k) (T := T) t n

/-- Helper for Remark 10.28.13: every defining relation has zero constant coefficient. -/
lemma remark102813_relationsIdeal_le_constantCoeff_ker :
    remark102813RelationsIdeal k T ≤ RingHom.ker (MvPolynomial.constantCoeff : _ →+* k) := by
  -- Each presentation generator has zero constant term, so the whole ideal lies in the kernel.
  refine Ideal.span_le.2 ?_
  intro f hf
  change MvPolynomial.constantCoeff f = 0
  rcases hf with hf | hf
  · rcases hf with hf | hf
    · rcases hf with ⟨n, rfl⟩
      simp [remark102813X]
    · rcases hf with ⟨p, rfl⟩
      rcases p with ⟨t, n⟩
      simp [remark102813Z]
  · rcases hf with ⟨p, rfl⟩
    rcases p with ⟨t, n⟩
    simp [remark102813X, remark102813Z]

/-- Helper for Remark 10.28.13: the constant coefficient descends to the quotient ring. -/
noncomputable def remark102813ConstantCoeff :
    remark102813Ring k T →+* k :=
  Ideal.Quotient.lift (remark102813RelationsIdeal k T)
    (MvPolynomial.constantCoeff : MvPolynomial (Remark102813Var T) k →+* k)
    (remark102813_relationsIdeal_le_constantCoeff_ker (k := k) (T := T))

/-- Helper for Remark 10.28.13: a polynomial with zero constant term lies in the ideal generated by
all variables. -/
lemma remark102813_mem_span_vars_of_constantCoeff_zero
    {f : MvPolynomial (Remark102813Var T) k} (hf : MvPolynomial.constantCoeff f = 0) :
    f ∈ Ideal.span (Set.range fun i : Remark102813Var T ↦ (X i : MvPolynomial (Remark102813Var T) k)) := by
  classical
  -- The zero constant term removes the degree-zero monomial, so every remaining monomial uses a
  -- variable and hence lies in the span of the variables.
  rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  have hm_ne : m ≠ 0 := by
    intro hm_zero
    have hcoeff : f.coeff 0 ≠ 0 := by
      simpa [hm_zero] using MvPolynomial.mem_support_iff.mp hm
    rw [← MvPolynomial.constantCoeff_eq, hf] at hcoeff
    exact hcoeff rfl
  have hsupp : m.support.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty, ne_eq, Finsupp.support_eq_empty]
    exact hm_ne
  obtain ⟨i, hi⟩ := hsupp
  exact ⟨i, by simp, Finsupp.mem_support_iff.mp hi⟩

/-- Helper for Remark 10.28.13: every quotient class with zero constant term lies in `(x_n)`. -/
lemma remark102813_mem_maximalIdeal_of_constantCoeff_zero
    {x : remark102813Ring k T} (hx : remark102813ConstantCoeff (k := k) (T := T) x = 0) :
    x ∈ remark102813MaximalIdeal k T := by
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  -- Reduce to an upstairs representative whose constant coefficient still vanishes.
  have hf0 : MvPolynomial.constantCoeff f = 0 := by
    simpa [remark102813ConstantCoeff] using hx
  have hf :
      f ∈ Ideal.span (Set.range fun i : Remark102813Var T ↦
        (X i : MvPolynomial (Remark102813Var T) k)) :=
    remark102813_mem_span_vars_of_constantCoeff_zero (k := k) (T := T) hf0
  -- Push the span-of-variables argument through the quotient and treat `x`- and `z`-variables
  -- separately.
  refine Submodule.span_induction
      (p := fun g _ ↦
        Ideal.Quotient.mk (remark102813RelationsIdeal k T) g ∈ remark102813MaximalIdeal k T)
      ?_ ?_ ?_ ?_ hf
  · rintro _ ⟨i, rfl⟩
    cases i with
    | x n =>
        simpa [remark102813X] using
          (Ideal.subset_span (Set.mem_range_self n) :
            Ideal.Quotient.mk (remark102813RelationsIdeal k T)
                (remark102813X k T n) ∈ remark102813MaximalIdeal k T)
    | z t n =>
        simpa [remark102813Z] using
          remark102813_z_mem_maximalIdeal (k := k) (T := T) t n
  · -- The target ideal contains zero.
    exact (remark102813MaximalIdeal k T).zero_mem
  · -- The target ideal is closed under addition.
    intro a b _ _ ha hb
    exact (remark102813MaximalIdeal k T).add_mem ha hb
  · -- Multiplication by an upstairs polynomial becomes multiplication in the quotient.
    intro a b _ hb
    simpa [smul_eq_mul, map_mul] using
      (remark102813MaximalIdeal k T).mul_mem_left
        (Ideal.Quotient.mk (remark102813RelationsIdeal k T) a) hb

/-- Helper for Remark 10.28.13: the kernel of the descended constant-coefficient map is exactly
the ideal `(x_n)`. -/
lemma remark102813_constantCoeff_ker :
    RingHom.ker (remark102813ConstantCoeff (k := k) (T := T)) = remark102813MaximalIdeal k T := by
  -- Compare the kernel and `(x_n)` by proving the two inclusions separately.
  apply le_antisymm
  · intro x hx
    exact remark102813_mem_maximalIdeal_of_constantCoeff_zero (k := k) (T := T)
      (show remark102813ConstantCoeff (k := k) (T := T) x = 0 from hx)
  · -- Every `x_n` has zero constant coefficient, so the whole span lies in the kernel.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨n, rfl⟩
    change
      remark102813ConstantCoeff (k := k) (T := T)
          (Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n)) = 0
    change MvPolynomial.constantCoeff (remark102813X k T n) = 0
    simp [remark102813X]

/-- Helper for Remark 10.28.13: the ideal `(x_n)` is maximal. -/
lemma remark102813_maximalIdeal_isMaximal :
    (remark102813MaximalIdeal k T).IsMaximal := by
  -- The descended constant-coefficient map is onto the field `k`.
  rw [← remark102813_constantCoeff_ker (k := k) (T := T)]
  refine RingHom.ker_isMaximal_of_surjective
    (remark102813ConstantCoeff (k := k) (T := T)) ?_
  intro c
  refine ⟨Ideal.Quotient.mk (remark102813RelationsIdeal k T) (MvPolynomial.C c), ?_⟩
  change MvPolynomial.constantCoeff (MvPolynomial.C c) = c
  simp

/-- Helper for Remark 10.28.13: every prime ideal contains the ideal generated by the `x_n`. -/
lemma remark102813_prime_contains_maximalIdeal
    {P : Ideal (remark102813Ring k T)} (hP : P.IsPrime) :
    remark102813MaximalIdeal k T ≤ P := by
  -- Each `x_n` is square-zero in the quotient, so primality forces `x_n ∈ P`.
  refine Ideal.span_le.2 ?_
  rintro _ ⟨n, rfl⟩
  have hx_sq :
      Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n) ^ 2 ∈ P := by
    rw [remark102813_x_square_eq_zero (k := k) (T := T) n]
    exact P.zero_mem
  have hx_mul :
      Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n) *
        Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n) ∈ P := by
    simpa [pow_two] using hx_sq
  exact (hP.mem_or_mem hx_mul).elim id id

/-- The explicit ring of Remark 10.28.13 is local with maximal ideal generated by the images of
the variables `x_n`. -/
-- Proof sketch: show every quotient element with nonzero constant term is a unit, so the ideal
-- generated by the images of the `x_n` is the unique maximal ideal.
instance remark102813_ring_isLocal :
    IsLocalRing (remark102813Ring k T) := by
  -- The maximal ideal `(x_n)` is unique because every maximal ideal is prime and must contain it.
  refine IsLocalRing.of_unique_max_ideal ?_
  refine ⟨remark102813MaximalIdeal k T, remark102813_maximalIdeal_isMaximal (k := k) (T := T), ?_⟩
  intro M hM
  have hle :
      remark102813MaximalIdeal k T ≤ M :=
    remark102813_prime_contains_maximalIdeal (k := k) (T := T)
      (P := M) hM.isPrime
  exact (Ideal.IsMaximal.eq_of_le
    (remark102813_maximalIdeal_isMaximal (k := k) (T := T)) hM.ne_top hle).symm

/-- An ideal of the explicit ring in Remark 10.28.13 is prime exactly when it is `(x_n)`. -/
-- Proof sketch: the relations force any prime ideal to contain each `x_n²` and `z_{t,n}²`, hence
-- every `x_n` and `z_{t,n}`. The recursive relation then identifies the resulting prime ideal with
-- the ideal generated by the images of the `x_n`.
lemma remark102813_unique_prime
    (P : Ideal (remark102813Ring k T)) :
    P.IsPrime ↔ P = remark102813MaximalIdeal k T := by
  constructor
  · intro hP
    have hle :
        remark102813MaximalIdeal k T ≤ P :=
      remark102813_prime_contains_maximalIdeal (k := k) (T := T) (P := P) hP
    exact (Ideal.IsMaximal.eq_of_le
      (remark102813_maximalIdeal_isMaximal (k := k) (T := T)) hP.ne_top hle).symm
  · intro hP
    subst hP
    exact (remark102813_maximalIdeal_isMaximal (k := k) (T := T)).isPrime

/-- The unique prime ideal `(x_n)` in Remark 10.28.13 has span rank at most `ℵ₀`. -/
-- Proof sketch: the generators are exactly the countable family indexed by `ℕ`, so this ideal is
-- the span of a countable set.
lemma remark102813_maximalIdeal_spanRank_le_aleph0 :
    (remark102813MaximalIdeal k T).spanRank ≤ Cardinal.aleph0 := by
  -- The defining generators are indexed by `ℕ`, so the span rank is bounded by `#ℕ = ℵ₀`.
  calc
    (remark102813MaximalIdeal k T).spanRank ≤
        Cardinal.mk ↑(Set.range fun n : ℕ ↦
          Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n)) := by
      simpa [remark102813MaximalIdeal] using
        (Submodule.spanRank_span_le_card
          (R := remark102813Ring k T)
          (M := remark102813Ring k T)
          (s := Set.range fun n : ℕ ↦
            Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n)))
    _ ≤ Cardinal.aleph0 := by
      simpa using
        (Cardinal.mk_range_le_lift
          (f := fun n : ℕ ↦
            Ideal.Quotient.mk (remark102813RelationsIdeal k T) (remark102813X k T n)))

end
