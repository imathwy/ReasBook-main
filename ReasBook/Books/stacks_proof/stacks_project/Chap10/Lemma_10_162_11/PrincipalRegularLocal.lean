import Mathlib

universe u

open IsLocalRing

section

variable {A : Type u} [CommRing A] [IsNoetherianRing A] [IsLocalRing A]

/-- Helper for Chap10 Lemma 10 162 11: every nonzero element of a Noetherian local ring lies in
a largest power of its maximal ideal. -/
private theorem exists_mem_pow_and_not_mem_pow_succ_of_ne_zero
    (y : A) (hy : y ≠ 0) :
    ∃ n : ℕ, y ∈ maximalIdeal A ^ n ∧ y ∉ maximalIdeal A ^ (n + 1) := by
  classical
  let m : Ideal A := maximalIdeal A
  have hintersection : (⨅ n : ℕ, m ^ n) = (⊥ : Ideal A) :=
    Ideal.iInf_pow_eq_bot_of_isLocalRing m Ideal.IsPrime.ne_top'
  have hnot_all : ¬ ∀ n : ℕ, y ∈ m ^ n := by
    intro hy_all
    have hy_inf : y ∈ (⨅ n : ℕ, m ^ n) := by
      rw [Ideal.mem_iInf]
      exact hy_all
    have hy_bot : y ∈ (⊥ : Ideal A) := by
      simpa [hintersection] using hy_inf
    exact hy ((Ideal.mem_bot).1 hy_bot)
  have hexists : ∃ n : ℕ, y ∉ m ^ (n + 1) := by
    by_contra h
    apply hnot_all
    intro n
    cases n with
    | zero =>
        simpa using (show y ∈ (⊤ : Ideal A) from Ideal.mem_top)
    | succ k =>
        exact by
          by_contra hy_mem
          exact h ⟨k, hy_mem⟩
  refine ⟨Nat.find hexists, ?_, Nat.find_spec hexists⟩
  cases hfind : Nat.find hexists with
  | zero =>
      simpa [hfind]
  | succ k =>
      have hk : ¬ y ∉ m ^ (k + 1) := by
        apply Nat.find_min hexists
        simpa [hfind] using Nat.lt_succ_self k
      exact by
        by_contra hy_mem
        exact hk hy_mem

/-- Helper for Chap10 Lemma 10 162 11: a Noetherian local ring whose maximal ideal is generated
by a regular element is a domain. -/
lemma isDomain_of_span_maximalIdeal_of_isSMulRegular {x : A}
    (hmax : maximalIdeal A = Ideal.span ({x} : Set A)) (hreg : IsSMulRegular A x) :
    IsDomain A := by
  have hNoZero : NoZeroDivisors A := by
    refine ⟨?_⟩
    intro f g hfg
    by_cases hf0 : f = 0
    · exact Or.inl hf0
    by_cases hg0 : g = 0
    · exact Or.inr hg0
    rcases exists_mem_pow_and_not_mem_pow_succ_of_ne_zero f hf0 with
      ⟨a, hfa, hfa_succ⟩
    rcases exists_mem_pow_and_not_mem_pow_succ_of_ne_zero g hg0 with
      ⟨b, hgb, hgb_succ⟩
    have hfa_dvd : x ^ a ∣ f := by
      rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hfa
      exact hfa
    have hgb_dvd : x ^ b ∣ g := by
      rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hgb
      exact hgb
    rcases hfa_dvd with ⟨c, rfl⟩
    rcases hgb_dvd with ⟨d, rfl⟩
    have hc_not_mem : c ∉ maximalIdeal A := by
      intro hc
      apply hfa_succ
      rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      rw [hmax, Ideal.mem_span_singleton] at hc
      rcases hc with ⟨e, rfl⟩
      refine ⟨e, ?_⟩
      rw [pow_succ']
      ring
    have hd_not_mem : d ∉ maximalIdeal A := by
      intro hd
      apply hgb_succ
      rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      rw [hmax, Ideal.mem_span_singleton] at hd
      rcases hd with ⟨e, rfl⟩
      refine ⟨e, ?_⟩
      rw [pow_succ']
      ring
    have hc_unit : IsUnit c := (IsLocalRing.notMem_maximalIdeal).mp hc_not_mem
    have hd_unit : IsUnit d := (IsLocalRing.notMem_maximalIdeal).mp hd_not_mem
    have hcd_ne_zero : c * d ≠ 0 := (hc_unit.mul hd_unit).ne_zero
    have hpowreg : IsSMulRegular A (x ^ (a + b)) := IsSMulRegular.pow (a + b) hreg
    have hzero : x ^ (a + b) * (c * d) = 0 := by
      simpa [pow_add, mul_comm, mul_left_comm, mul_assoc] using hfg
    have hcd_zero : c * d = 0 := by
      apply hpowreg
      simpa [smul_eq_mul] using hzero
    exact False.elim (hcd_ne_zero hcd_zero)
  letI : NoZeroDivisors A := hNoZero
  exact NoZeroDivisors.to_isDomain A

/-- Helper for Chap10 Lemma 10 162 11: in a Noetherian local ring, if the maximal ideal is
generated by a single regular element, then the ring is a discrete valuation ring. -/
lemma discreteValuationRing_of_span_maximalIdeal_of_isSMulRegular {x : A}
    (hmax : maximalIdeal A = Ideal.span ({x} : Set A)) (hreg : IsSMulRegular A x) :
    ∃ (_ : IsDomain A), IsDiscreteValuationRing A := by
  letI : IsDomain A := isDomain_of_span_maximalIdeal_of_isSMulRegular hmax hreg
  have hspan_le_one : ((maximalIdeal A).spanFinrank : WithBot ℕ∞) ≤ 1 := by
    rw [hmax]
    simpa only [Nat.cast_le_one, ← Set.ncard_singleton x] using
      (Submodule.spanFinrank_span_le_ncard_of_finite (R := A) (M := A)
        (Set.finite_singleton x))
  have hxmem : x ∈ maximalIdeal A := by
    rw [hmax]
    simpa using (Submodule.mem_span_singleton_self x : x ∈ Ideal.span ({x} : Set A))
  have hquot_dim : ringKrullDim (A ⧸ Ideal.span ({x} : Set A)) = 0 := by
    let e : A ⧸ Ideal.span ({x} : Set A) ≃+* A ⧸ maximalIdeal A :=
      Ideal.quotEquivOfEq hmax.symm
    letI : Field (A ⧸ maximalIdeal A) := Ideal.Quotient.field (maximalIdeal A)
    calc
      ringKrullDim (A ⧸ Ideal.span ({x} : Set A)) = ringKrullDim (A ⧸ maximalIdeal A) :=
        ringKrullDim_eq_of_ringEquiv e
      _ = 0 := ringKrullDim_eq_zero_of_field (A ⧸ maximalIdeal A)
  have hdim : ringKrullDim A = 1 := by
    have hsucc :
        ringKrullDim (A ⧸ Ideal.span ({x} : Set A)) + 1 = ringKrullDim A :=
      ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim hreg hxmem
    simpa [hquot_dim] using hsucc.symm
  have hregular : IsRegularLocalRing A := by
    apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le (R := A)
    simpa [hdim] using hspan_le_one
  letI : IsRegularLocalRing A := hregular
  have hfinrank : Module.finrank (ResidueField A) (CotangentSpace A) = 1 := by
    have hcot :=
      (IsRegularLocalRing.iff_finrank_cotangentSpace (R := A)).1
        (inferInstance : IsRegularLocalRing A)
    simpa [hdim] using hcot
  exact ⟨inferInstance, (IsLocalRing.finrank_CotangentSpace_eq_one_iff (R := A)).1 hfinrank⟩

end
