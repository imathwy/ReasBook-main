import stacks_proof.stacks_project.Chap10.Lemma_10_99_17.QuotientKernel

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory
open scoped TensorProduct

universe u

section

variable {A : Type u} [CommRing A]
variable {M : Type u} [AddCommGroup M] [Module A M]
variable {r : ℕ} (f : Fin r → A)

local notation "I" => Ideal.span (Set.range f)
local notation "Ā" => A ⧸ I
local notation "M̄" => M ⧸ (I • (⊤ : Submodule A M))
set_option quotPrecheck false in
local notation "TorQ[" n "]" =>
  (((Tor (ModuleCat A) n).obj (ModuleCat.of A M)).obj (ModuleCat.of A Ā))

/-- Helper for Lemma 10.99.17: if a maximal ideal does not contain the ideal generated by the
family `f`, then one generator lies outside that maximal ideal. -/
lemma exists_generator_not_mem_of_not_span_le {m : Ideal A} (hm : ¬ I ≤ m) :
    ∃ i : Fin r, f i ∉ m := by
  -- If every generator were in `m`, then the ideal they generate would also be contained in `m`.
  by_contra h
  apply hm
  rw [Ideal.span_le]
  intro x hx
  rcases Set.mem_range.mp hx with ⟨i, rfl⟩
  by_contra hfi
  exact h ⟨i, hfi⟩

/-- Helper for Lemma 10.99.17: the image of scalar multiplication by `a` on an `A`-module is the
principal-ideal multiple of the top submodule. This is the concrete range identification needed
when the source proof rewrites the quotient by `range (lsmul a)` as the quotient by `aK`. -/
lemma range_lsmul_eq_pointwise_smul_top
    (a : A) {K : Type u} [AddCommGroup K] [Module A K] :
    LinearMap.range (LinearMap.lsmul A K a) = Ideal.span ({a} : Set A) • (⊤ : Submodule A K) := by
  -- Proof comment: every value in the range is visibly an `(a)`-multiple, and conversely every
  -- element of `(a) • ⊤` comes from multiplying a preimage by the displayed scalar.
  ext x
  constructor
  · intro hx
    rcases hx with ⟨y, rfl⟩
    exact Submodule.smul_mem_smul (Ideal.subset_span (by simp)) (by simp)
  · intro hx
    refine Submodule.smul_induction_on hx ?_ ?_
    · intro r hr y hy
      rcases (Ideal.mem_span_singleton').1 hr with ⟨b, rfl⟩
      refine ⟨b • y, ?_⟩
      simp [smul_smul, mul_comm]
    · intro y z hy hz
      rcases hy with ⟨y', rfl⟩
      rcases hz with ⟨z', rfl⟩
      refine ⟨y' + z', ?_⟩
      simp [smul_add]

/-- Helper for Lemma 10.99.17: if the image of an ideal in the away-localization at `a` is the
unit ideal, then the original ideal already contains a power of `a`. -/
lemma pow_mem_of_away_localized_ideal_eq_top (a : A) (J : Ideal A)
    (hJ : Ideal.map (algebraMap A (Localization.Away a)) J = ⊤) :
    ∃ n : ℕ, a ^ n ∈ J := by
  by_contra hpow
  have hdisjoint : Disjoint ((Submonoid.powers a : Submonoid A) : Set A) (J : Set A) := by
    rw [Set.disjoint_left]
    intro x hxpow hxJ
    change x ∈ Submonoid.powers a at hxpow
    rcases (Submonoid.mem_powers_iff x a).mp hxpow with ⟨n, rfl⟩
    exact hpow ⟨n, hxJ⟩
  have hmap_ne_top :
      Ideal.map (algebraMap A (Localization.Away a)) J ≠ ⊤ := by
    rw [IsLocalization.map_algebraMap_ne_top_iff_disjoint (M := Submonoid.powers a)
      (S := Localization.Away a)]
    exact hdisjoint
  exact hmap_ne_top hJ

/-- Helper for Lemma 10.99.17: if `J • M = M`, then after localizing away from `a` the image ideal
still acts surjectively on `M[1 / a]`. -/
lemma away_localized_ideal_smul_top_eq_top
    (a : A) (J : Ideal A) (hJ : J • (⊤ : Submodule A M) = ⊤) :
    (Ideal.map (algebraMap A (Localization.Away a)) J) •
      (⊤ : Submodule (Localization.Away a) (LocalizedModule.Away a M)) = ⊤ := by
  refine eq_top_iff.2 ?_
  intro x _
  induction x using LocalizedModule.induction_on with
  | h m s =>
      have hm : m ∈ J • (⊤ : Submodule A M) := by
        simpa [hJ]
      -- Rewrite the numerator through the hypothesis `J • M = M`, then localize termwise.
      refine Submodule.smul_induction_on hm ?_ ?_
      · intro r hr y hy
        have hr' :
            algebraMap A (Localization.Away a) r ∈
              Ideal.map (algebraMap A (Localization.Away a)) J :=
          Ideal.mem_map_of_mem _ hr
        have hy' :
            LocalizedModule.mk y s ∈
              (⊤ : Submodule (Localization.Away a) (LocalizedModule.Away a M)) := by
          simp
        simpa [LocalizedModule.smul'_mk] using
          (Submodule.smul_mem_smul hr' hy' :
            algebraMap A (Localization.Away a) r • LocalizedModule.mk y s ∈
              (Ideal.map (algebraMap A (Localization.Away a)) J) •
                (⊤ : Submodule (Localization.Away a) (LocalizedModule.Away a M)))
      · intro y z hy hz
        have hadd :
            LocalizedModule.mk y s + LocalizedModule.mk z s =
              LocalizedModule.mk (y + z) s := by
          calc
            LocalizedModule.mk y s + LocalizedModule.mk z s
                = LocalizedModule.mk ((s : A) • y + (s : A) • z) (s * s) := by
                    simpa [Submonoid.smul_def] using
                      (LocalizedModule.mk_add_mk (m1 := y) (m2 := z) (s1 := s) (s2 := s))
            _ = LocalizedModule.mk ((s : A) • (y + z)) (s * s) := by
                  simp [smul_add]
            _ = LocalizedModule.mk (y + z) s := by
                  simpa using LocalizedModule.mk_cancel_common_left s s (y + z)
        rw [← hadd]
        exact add_mem hy hz

/-- Helper for Lemma 10.99.17: if `J • M = M`, then after quotienting by the whole ideal `I` the
image ideal in `A / I` still acts surjectively on `M / IM`. -/
lemma quotient_span_ideal_smul_top_eq_top
    (J : Ideal A) (hJ : J • (⊤ : Submodule A M) = ⊤) :
    (Ideal.map (algebraMap A Ā) J) •
      (⊤ : Submodule Ā M̄) = ⊤ := by
  rw [← (Submodule.restrictScalars_injective A Ā M̄).eq_iff]
  -- Compare the quotient-ring action with the image of `J • M` under the quotient map.
  calc
    (((Ideal.map (algebraMap A Ā) J) • (⊤ : Submodule Ā M̄)).restrictScalars A)
        = (J • (⊤ : Submodule A M)).map
            (Submodule.mkQ (I • (⊤ : Submodule A M))) := by
              symm
              calc
                (J • (⊤ : Submodule A M)).map
                    (Submodule.mkQ (I • (⊤ : Submodule A M)))
                    = J • (⊤ : Submodule A M̄) := by
                        simp [Submodule.map_smul'', Submodule.range_mkQ]
                _ = (((Ideal.map (algebraMap A Ā) J) •
                      (⊤ : Submodule Ā M̄)).restrictScalars A) := by
                        symm
                        simpa [Ideal.Quotient.algebraMap_eq] using
                          (Ideal.smul_restrictScalars
                            (R := A) (S := Ā) (M := M̄) J
                            (⊤ : Submodule Ā M̄))
    _ = ⊤ := by
          simpa [hJ]

/-- Helper for Lemma 10.99.17: flatness of the quotient by the zero ideal transports back to
flatness of the original module. -/
lemma flat_of_flat_quotient_bot
    (hflat :
      Module.Flat (A ⧸ (⊥ : Ideal A))
        (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M)))) :
    Module.Flat A M := by
  -- First forget the quotient ring structure along the canonical equivalence `A / 0 ≃ A`.
  have hflat_ring_quot : Module.Flat A (A ⧸ (⊥ : Ideal A)) := by
    exact Module.Flat.of_linearEquiv (AlgEquiv.quotientBot A A).toLinearEquiv
  have hflat_quot_as_A :
      Module.Flat A (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M))) := by
    letI : Module.Flat A (A ⧸ (⊥ : Ideal A)) := hflat_ring_quot
    letI :
        Module.Flat (A ⧸ (⊥ : Ideal A))
          (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M))) := hflat
    exact Module.Flat.trans A (A ⧸ (⊥ : Ideal A))
      (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M)))
  have hsmul_bot : ((⊥ : Ideal A) • (⊤ : Submodule A M)) = ⊥ := by
    simp
  -- Then identify the quotient by `0` with the original module.
  letI : Module.Flat A (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M))) := hflat_quot_as_A
  exact Module.Flat.of_linearEquiv
    ((((⊥ : Ideal A) • (⊤ : Submodule A M)).quotEquivOfEqBot hsmul_bot).symm)

/-- Helper for Lemma 10.99.17: faithful flatness of the quotient by the zero ideal transports back
to faithful flatness of the original module. -/
lemma faithfullyFlat_of_faithfullyFlat_quotient_bot
    (hff :
      Module.FaithfullyFlat (A ⧸ (⊥ : Ideal A))
        (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M)))) :
    Module.FaithfullyFlat A M := by
  -- First forget the quotient ring structure along the canonical equivalence `A / 0 ≃ A`.
  have hff_ring_quot : Module.FaithfullyFlat A (A ⧸ (⊥ : Ideal A)) := by
    letI : Module.FaithfullyFlat A A := Module.FaithfullyFlat.self A
    simpa using
      (Module.FaithfullyFlat.of_linearEquiv (R := A) (M := A)
        (N := A ⧸ (⊥ : Ideal A)) (AlgEquiv.quotientBot A A).toLinearEquiv)
  have hff_quot_as_A :
      Module.FaithfullyFlat A (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M))) := by
    exact
      @Module.FaithfullyFlat.trans A _ (A ⧸ (⊥ : Ideal A)) _ _
        (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M))) _ _ _ _
        hff_ring_quot hff
  have hsmul_bot : ((⊥ : Ideal A) • (⊤ : Submodule A M)) = ⊥ := by
    simp
  -- Then identify the quotient by `0` with the original module.
  letI : Module.FaithfullyFlat A (M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M))) := hff_quot_as_A
  exact Module.FaithfullyFlat.of_linearEquiv (R := A)
    (M := M ⧸ (((⊥ : Ideal A)) • (⊤ : Submodule A M)))
    ((((⊥ : Ideal A) • (⊤ : Submodule A M)).quotEquivOfEqBot hsmul_bot).symm)

/-- Helper for Lemma 10.99.17: if localization away from `a` is zero and multiplication by `a`
is injective on `T`, then `T` is zero. -/
lemma isZero_of_localizedAway_isZero_of_smul_injective
    {T : Type u} [AddCommGroup T] [Module A T] (a : A)
    (hinj : Function.Injective fun t : T ↦ a • t)
    [Subsingleton (LocalizedModule.Away a T)] :
    IsZero (ModuleCat.of A T) := by
  rw [ModuleCat.isZero_of_iff_subsingleton]
  refine ⟨fun x y ↦ ?_⟩
  -- It is enough to show that every power of `a` acts injectively on `T`.
  have hpow_inj : ∀ n : ℕ, Function.Injective fun t : T ↦ a ^ n • t := by
    intro n
    induction n with
    | zero =>
        intro u v huv
        simpa using huv
    | succ n ih =>
        intro u v huv
        apply ih
        apply hinj
        simpa [pow_succ', mul_smul] using huv
  -- A zero element in the localization gives a power of `a` killing the original difference.
  have hsub :
      ∀ t : T, ∃ s ∈ (Submonoid.powers a : Submonoid A), s • t = 0 :=
    (LocalizedModule.subsingleton_iff (R := A) (M := T) (S := Submonoid.powers a)).mp inferInstance
  rcases hsub (x - y) with ⟨s, hs, hs0⟩
  rw [Submonoid.mem_powers_iff] at hs
  rcases hs with ⟨n, rfl⟩
  have hxy : x - y = 0 := hpow_inj n <| by simpa using hs0
  exact sub_eq_zero.mp hxy

/-- Helper for Lemma 10.99.17: vanishing of the public module-first owner `Tor₁^A(M, -)` on all
modules implies that `M` is flat. This isolates the final call to the flatness criterion from the
source proof's longer generator descent. -/
lemma flat_of_tor_one_module_vanishing
    (hTor :
      ∀ (N : Type u) [AddCommGroup N] [Module A N],
        IsZero ((((Tor (ModuleCat A) 1).obj (ModuleCat.of A M)).obj
          (ModuleCat.of A N)))) :
    Module.Flat A M := by
  let htfae := flat_tfae_tor_vanishing_criteria (R := A) (M := M)
  -- Proof comment: this is exactly item `(3)` in the standard flatness/Tor criterion.
  refine (htfae.out 0 2).2 ?_
  intro N
  exact hTor N

/-- Helper for Lemma 10.99.17: the quotient hypothesis `Tor_i^A(M, A / I) = 0` transports to the
flipped source owner in the full range `1, ..., r + 1`. This isolates the available half of the
owner swap before the higher-degree free-cover bootstrap. -/
lemma tor_flipped_source_quotient_vanishes_in_range
    (htor : ∀ i : Fin (r + 1), IsZero (TorQ[i.1 + 1])) :
    ∀ i : Fin (r + 1),
      IsZero
        (((((Tor' (ModuleCat A) (i.1 + 1)).flip).obj (ModuleCat.of A M)).obj
          (ModuleCat.of A Ā))) := by
  intro i
  let e :
      ((((Tor (ModuleCat A) (i.1 + 1)).obj (ModuleCat.of A M)).obj
        (ModuleCat.of A Ā))) ≅
        (((((Tor' (ModuleCat A) (i.1 + 1)).flip).obj (ModuleCat.of A M)).obj
          (ModuleCat.of A Ā))) :=
    (tor_module_flip_owner_iso (A := A) (M := M) (i.1 + 1)).app (ModuleCat.of A Ā)
  -- Proof comment: `tor_flip_iso` gives the direct symmetry available from the given public
  -- module-first quotient vanishing hypothesis.
  exact IsZero.of_iso (htor i) e.symm

end
