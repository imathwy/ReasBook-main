import Mathlib
import StacksProject_2024.Chap10.Lemma_10_90_5
import StacksProject_2024.Chap10.Proposition_10_90_6
import StacksProject_2024.Chap10.Lemma_10_91_2

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

namespace Module

open scoped TensorProduct

section

variable {R : Type u} [CommRing R] [IsNoetherianRing R]
variable {A : Type v}

/- Domain triage:
- `source-facing`: the Stacks lemma asserting that the product module `R^A` is flat and
  Mittag-Leffler over a Noetherian ring.
- `core/canonical`: the owner predicates `Module.Flat` and `Module.MittagLeffler`.
- `bridge/view`: flatness is derived from the chapter owner theorem
  `coherent_tfae_flat_products` together with the canonical instance
  `noetherianRing_isCoherentRing`; the supporting-submodule criterion from
  `flat_mittagLeffler_iff_exists_smallest_supporting_submodule` supplies the Mittag-Leffler
  clause.
Primitive data are only the ring `R`, the index type `A`, and the product module `A → R`; the
coherence and supporting-submodule criteria are derived API of the owner abstractions. -/

-- Proof sketch: use Lemma `10.90.5` and clause `(3)` of `coherent_tfae_flat_products` to obtain
-- flatness of `A → R` directly from the chapter owner predicate `IsCoherentRing R`. Then apply the
-- criterion of Lemma `10.91.2`. For a finite free module `F` and tensor `x : F ⊗[R] R^A`,
-- identify `F ⊗[R] R^A` with `F^A` via Proposition `10.89.3`. The smallest supporting submodule
-- is generated by the coordinates of the family corresponding to `x`; since `R` is Noetherian and
-- `F` is finite free, this submodule is finite, so Lemma `10.91.2` yields the
-- Mittag-Leffler property.

omit [IsNoetherianRing R] in
/-- Helper for Chap10 Lemma 10 91 3: reindexing the product by an equivalence commutes with
`TensorProduct.piScalarRightHom`. -/
private lemma piScalarRightHom_reindex {X : Type (max u v)} [AddCommGroup X] [Module R X]
    {B : Type (max u v)} (e : B ≃ A) (t : X ⊗[R] (A → R)) :
    (LinearEquiv.piCongrLeft R (fun _ : B ↦ X) e.symm)
        (TensorProduct.piScalarRightHom R R X A t) =
      TensorProduct.piScalarRightHom R R X B
        ((TensorProduct.congr (LinearEquiv.refl R X)
          (LinearEquiv.piCongrLeft R (fun _ : B ↦ R) e.symm)) t) := by
  -- It is enough to check the naturality square on pure tensors.
  refine TensorProduct.induction_on t ?_ ?_ ?_
  · ext b
    simp [LinearEquiv.piCongrLeft]
  · intro x f
    ext b
    simp [TensorProduct.piScalarRightHom_tmul, LinearEquiv.piCongrLeft]
  · intro t₁ t₂ ht₁ ht₂
    ext b
    simp [ht₁, ht₂]

omit [IsNoetherianRing R] in
/-- Helper for Chap10 Lemma 10 91 3: surjectivity of the scalar product comparison after
`ULift` reindexing descends to the original index type. -/
private lemma piScalarRightHom_surjective_of_ulift {X : Type (max u v)} [AddCommGroup X]
    [Module R X]
    (hBig : Function.Surjective
      (TensorProduct.piScalarRightHom R R X (ULift.{max u v, v} A))) :
    Function.Surjective (TensorProduct.piScalarRightHom R R X A) := by
  let B := ULift.{max u v, v} A
  let e : B ≃ A := Equiv.ulift
  let d : (X ⊗[R] (A → R)) ≃ₗ[R] (X ⊗[R] (B → R)) :=
    TensorProduct.congr (LinearEquiv.refl R X)
      (LinearEquiv.piCongrLeft R (fun _ : B ↦ R) e.symm)
  let c : (A → X) ≃ₗ[R] (B → X) :=
    LinearEquiv.piCongrLeft R (fun _ : B ↦ X) e.symm
  -- Lift the reindexed family and transport the preimage back along the domain equivalence.
  intro y
  obtain ⟨t, ht⟩ := hBig (c y)
  refine ⟨d.symm t, ?_⟩
  apply c.injective
  calc
    c (TensorProduct.piScalarRightHom R R X A (d.symm t))
        = TensorProduct.piScalarRightHom R R X B (d (d.symm t)) := by
            simpa [B, e, d, c] using
              piScalarRightHom_reindex (R := R) (A := A) (X := X) e (d.symm t)
    _ = TensorProduct.piScalarRightHom R R X B t := by rw [d.apply_symm_apply]
    _ = c y := ht

omit [IsNoetherianRing R] in
/-- Helper for Chap10 Lemma 10 91 3: bijectivity of the scalar product comparison after `ULift`
reindexing descends to the original index type. -/
private lemma piScalarRightHom_bijective_of_ulift {X : Type (max u v)} [AddCommGroup X]
    [Module R X]
    (hBig : Function.Bijective
      (TensorProduct.piScalarRightHom R R X (ULift.{max u v, v} A))) :
    Function.Bijective (TensorProduct.piScalarRightHom R R X A) := by
  let B := ULift.{max u v, v} A
  let e : B ≃ A := Equiv.ulift
  let d : (X ⊗[R] (A → R)) ≃ₗ[R] (X ⊗[R] (B → R)) :=
    TensorProduct.congr (LinearEquiv.refl R X)
      (LinearEquiv.piCongrLeft R (fun _ : B ↦ R) e.symm)
  let c : (A → X) ≃ₗ[R] (B → X) :=
    LinearEquiv.piCongrLeft R (fun _ : B ↦ X) e.symm
  constructor
  · -- Reindex both tensors, use injectivity in the larger universe, then descend through `d`.
    intro t₁ t₂ hEq
    apply d.injective
    apply hBig.1
    calc
      TensorProduct.piScalarRightHom R R X B (d t₁)
          = c (TensorProduct.piScalarRightHom R R X A t₁) := by
              simpa [B, e, d, c] using
                (piScalarRightHom_reindex (R := R) (A := A) (X := X) e t₁).symm
      _ = c (TensorProduct.piScalarRightHom R R X A t₂) := by rw [hEq]
      _ = TensorProduct.piScalarRightHom R R X B (d t₂) := by
            simpa [B, e, d, c] using
              piScalarRightHom_reindex (R := R) (A := A) (X := X) e t₂
  · -- Surjectivity descends by the preceding one-sided transport lemma.
    exact piScalarRightHom_surjective_of_ulift (R := R) (A := A) (X := X) hBig.2

omit [IsNoetherianRing R] in
/-- Helper for Chap10 Lemma 10 91 3: a finite module has surjective scalar product comparison
for the original index type `A`. -/
private lemma piScalarRightHom_surjective_of_finite {X : Type (max u v)} [AddCommGroup X]
    [Module R X] [Module.Finite R X] :
    Function.Surjective (TensorProduct.piScalarRightHom R R X A) := by
  -- Apply Proposition 10.89.2 at the `ULift`ed index universe, then descend by reindexing.
  apply piScalarRightHom_surjective_of_ulift (R := R) (A := A) (X := X)
  let B := ULift.{max u v, v} A
  have hiff :=
    (module_finite_tfae_tensorProduct_pi_surjective.{u, max u v, v, v} (R := R)
      (M := X)).out 0 3
  exact hiff.mp (inferInstance : Module.Finite R X) B

omit [IsNoetherianRing R] in
/-- Helper for Chap10 Lemma 10 91 3: a finite free module has bijective scalar product
comparison for the original index type `A`. -/
private lemma piScalarRightHom_bijective_of_free_finite (F : ModuleCat.{max u v} R)
    [Module.Free R F] [Module.Finite R F] :
    Function.Bijective (TensorProduct.piScalarRightHom R R F A) := by
  -- Finite free modules are finitely presented, so Proposition 10.89.3 applies after `ULift`.
  apply piScalarRightHom_bijective_of_ulift (R := R) (A := A) (X := F)
  let B := ULift.{max u v, v} A
  letI : Module.Projective R F := Module.Projective.of_free
  have hFP : Module.FinitePresentation R F := Module.finitePresentation_of_projective R F
  have hiff :=
    (module_finitePresentation_tfae_tensorProduct_pi_bijective.{u, max u v, v, v}
      (R := R) (M := F)).out 0 3
  exact hiff.mp hFP B

omit [IsNoetherianRing R] in
/-- Helper for Chap10 Lemma 10 91 3: each coordinate of
`TensorProduct.piScalarRightHom R R X A x` belongs to the span of all coordinates. -/
private lemma piScalarRightHom_apply_mem_span_range {X : Type (max u v)} [AddCommGroup X]
    [Module R X] (x : X ⊗[R] (A → R)) (a : A) :
    (TensorProduct.piScalarRightHom R R X A x) a ∈
      Submodule.span R (Set.range (TensorProduct.piScalarRightHom R R X A x)) := by
  -- The coordinate is one of the generators of the span.
  apply Submodule.subset_span
  exact Set.mem_range_self a

/-- Helper for Chap10 Lemma 10 91 3: the span of the coordinates of a tensor supports the
tensor. -/
private lemma mem_range_span_range_piScalarRightHom (F : ModuleCat.{max u v} R)
    [Module.Free R F] [Module.Finite R F] (x : F ⊗[R] (A → R)) :
    let y := TensorProduct.piScalarRightHom R R F A x
    x ∈ LinearMap.range (((Submodule.span R (Set.range y)).subtype).rTensor (A → R)) := by
  let y := TensorProduct.piScalarRightHom R R F A x
  let S : Submodule R F := Submodule.span R (Set.range y)
  -- Noetherianity makes the coordinate span finite, so the scalar comparison for `S` is onto.
  have hSfinite : Module.Finite R S := by
    exact Module.Finite.of_fg (IsNoetherian.noetherian S)
  letI : Module.Finite R S := hSfinite
  let yS : A → S := fun a ↦
    ⟨y a, piScalarRightHom_apply_mem_span_range (R := R) (A := A) (X := F) x a⟩
  obtain ⟨tS, htS⟩ := piScalarRightHom_surjective_of_finite (R := R) (A := A) (X := S) yS
  refine ⟨tS, ?_⟩
  -- Compare after applying the ambient scalar product map, where finite freeness gives
  -- injectivity.
  have hcompare :
      TensorProduct.piScalarRightHom R R F A (S.subtype.rTensor (A → R) tS) = y := by
    ext a
    calc
      TensorProduct.piScalarRightHom R R F A (S.subtype.rTensor (A → R) tS) a
          = S.subtype ((TensorProduct.piScalarRightHom R R S A tS) a) := by
              simpa using congr_fun
                (piScalarRightHom_rTensor_apply (R := R) (A := A) S.subtype tS) a
      _ = S.subtype (yS a) := by rw [htS]
      _ = y a := rfl
  exact (piScalarRightHom_bijective_of_free_finite (R := R) (A := A) F).1 hcompare

omit [IsNoetherianRing R] in
/-- Helper for Chap10 Lemma 10 91 3: every supporting submodule contains the coordinate span. -/
private lemma span_range_piScalarRightHom_le_of_mem_range (F : ModuleCat.{max u v} R)
    [Module.Free R F] [Module.Finite R F] (x : F ⊗[R] (A → R)) {N : Submodule R F}
    (hx : x ∈ LinearMap.range (N.subtype.rTensor (A → R))) :
    Submodule.span R (Set.range (TensorProduct.piScalarRightHom R R F A x)) ≤ N := by
  obtain ⟨z, hz⟩ := hx
  apply Submodule.span_le.mpr
  intro m hm
  rcases hm with ⟨a, rfl⟩
  -- The tensor-map compatibility identifies each coordinate with an element of `N`.
  have hcoord :
      (TensorProduct.piScalarRightHom R R F A x) a =
        N.subtype ((TensorProduct.piScalarRightHom R R N A z) a) := by
    calc
      (TensorProduct.piScalarRightHom R R F A x) a
          = TensorProduct.piScalarRightHom R R F A (N.subtype.rTensor (A → R) z) a := by
              rw [hz]
      _ = N.subtype ((TensorProduct.piScalarRightHom R R N A z) a) := by
            simpa using congr_fun
              (piScalarRightHom_rTensor_apply (R := R) (A := A) N.subtype z) a
  simp [hcoord]

/-- Helper for Chap10 Lemma 10 91 3: the coordinate span is the least supporting submodule for a
tensor with finite free source. -/
private lemma exists_isLeast_span_range_piScalarRightHom (F : ModuleCat.{max u v} R)
    [Module.Free R F] [Module.Finite R F] (x : F ⊗[R] (A → R)) :
    ∃ F' : Submodule R F,
      IsLeast { F'' : Submodule R F | x ∈ LinearMap.range (F''.subtype.rTensor (A → R)) } F' := by
  let y := TensorProduct.piScalarRightHom R R F A x
  let S : Submodule R F := Submodule.span R (Set.range y)
  refine ⟨S, ?_⟩
  constructor
  · -- The coordinate span supports `x`.
    exact mem_range_span_range_piScalarRightHom (R := R) (A := A) F x
  · -- Any other support contains all coordinates, hence contains their span.
    intro N hN
    exact span_range_piScalarRightHom_le_of_mem_range (R := R) (A := A) F x hN

/-- Chap10 Lemma 10 91 3: if `R` is Noetherian and `A` is a set, then the product module `A → R`
is flat and Mittag-Leffler over `R`. -/
@[stacks 05D0]
theorem noetherian_pi_flat_and_mittagLeffler :
    Module.Flat R (A → R) ∧ MittagLeffler R (A → R) := by
  -- Coherence of a Noetherian ring gives flatness of products, first at an `ULift`ed universe and
  -- then by transporting along the product reindexing equivalence.
  have hflat : Module.Flat R (A → R) := by
    let B := ULift.{max u v, v} A
    have hBig : Module.Flat R (B → R) := by
      have hflatBig : ∀ B : Type (max u v), Module.Flat R (B → R) :=
        ((coherent_tfae_flat_products.{u, v, u} (R := R)).out 0 2).mp
          (noetherianRing_isCoherentRing (R := R))
      exact hflatBig B
    exact Module.Flat.of_linearEquiv
      (LinearEquiv.piCongrLeft R (fun _ : B ↦ R) (Equiv.ulift.symm : A ≃ B))
  -- Lemma 10.91.2 reduces the Mittag-Leffler clause to existence of least supports; the helper
  -- above supplies those supports as spans of tensor coordinates.
  have hML : MittagLeffler R (A → R) := by
    letI : Module.Flat R (A → R) := hflat
    exact (flat_mittagLeffler_iff_exists_smallest_supporting_submodule (R := R)
      (M := A → R)).mpr
      (exists_isLeast_span_range_piScalarRightHom (R := R) (A := A))
  constructor
  · exact hflat
  · exact hML

end

end Module
