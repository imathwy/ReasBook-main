/-- Helper for Lemma 10.135.12: cancelling a finite natural summand from a `WithBot ℕ∞`
dimension inequality, in the only form needed below. -/
lemma nat_le_of_withBot_add_le_add_of_add_eq_nat
    (a : WithBot ℕ∞) (B m n : ℕ)
    (h1 : a + (n : WithBot ℕ∞) = (B : WithBot ℕ∞))
    (h2 : (B : WithBot ℕ∞) ≤ a + (m : WithBot ℕ∞)) :
    n ≤ m := by
  cases a with
  | bot =>
      simp at h1
  | coe e =>
      cases e with
      | top =>
          exfalso
          have htop : (⊤ : ℕ∞) = (B : ℕ∞) := by
            apply WithBot.coe_eq_coe.mp
            simpa [WithBot.coe_add] using h1
          exact ENat.coe_ne_top B htop.symm
      | coe k =>
          have hle : k + n ≤ k + m := by
            have h2' : ((k + n : ℕ) : WithBot ℕ∞) ≤ ((k + m : ℕ) : WithBot ℕ∞) := by
              simpa [← h1, WithBot.coe_add, ENat.coe_add, Nat.cast_add] using h2
            exact_mod_cast h2'
          exact Nat.le_of_add_le_add_left hle

