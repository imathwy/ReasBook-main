                Ideal.map (algebraMap (R ⧸ I) (S ⧸ J)) (maximalIdeal (R ⧸ I))) :=
        hdimB0
      _ = ringKrullDim (R ⧸ I) +
          ringKrullDim (ClosedFiber ⧸ Ideal.map (algebraMap S ClosedFiber) J) := by
        rw [hfiber_dim]
  let dCF : ℕ := (maximalIdeal ClosedFiber).spanFinrank
  have hCFdim_nat : ringKrullDim ClosedFiber = (dCF : WithBot ℕ∞) := by
    simpa [dCF] using (IsRegularLocalRing.spanFinrank_maximalIdeal (R := ClosedFiber)).symm
  have hmain_dim :
