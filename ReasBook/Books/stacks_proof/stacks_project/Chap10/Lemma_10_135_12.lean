/-- Helper for Lemma 10.135.12: if `S ⧸ K` is flat over `R` and
`J = K + IS`, then elements of `K` which lie in `𝔪_SJ` already lie in `𝔪_SK`.
This is the formal version of the independence part of the source proof's Nakayama step. -/
lemma mem_maximalIdeal_mul_of_mem_kernel_and_maximalIdeal_mul_sup_map_of_flat
    (I : Ideal R) (K J : Ideal S)
    (hI_le_max : I ≤ maximalIdeal R)
    (hJ_eq : J = K ⊔ Ideal.map (algebraMap R S) I)
    (hflat_SK : Module.Flat R (S ⧸ K)) {x : S}
    (hxK : x ∈ K) (hxJ : x ∈ maximalIdeal S * J) :
    x ∈ maximalIdeal S * K := by
  let IS : Ideal S := Ideal.map (algebraMap R S) I
  have hmapI_le_maxS : IS ≤ maximalIdeal S := by
    exact (Ideal.map_mono hI_le_max).trans (by
      simpa [IS] using IsLocalRing.map_maximalIdeal_le (algebraMap R S))
  have hmulJ_le : maximalIdeal S * J ≤ maximalIdeal S * K ⊔ IS := by
    rw [hJ_eq]
    calc
      maximalIdeal S * (K ⊔ IS) = maximalIdeal S * K ⊔ maximalIdeal S * IS := by
        rw [Ideal.mul_sup]
      _ ≤ maximalIdeal S * K ⊔ IS := by
        exact sup_le_sup_left (Ideal.mul_le_left : maximalIdeal S * IS ≤ IS) _
  have hx_sup : x ∈ maximalIdeal S * K ⊔ IS := hmulJ_le hxJ
  rcases Submodule.mem_sup.mp hx_sup with ⟨a, ha, b, hb, hab⟩
  have haK : a ∈ K := Ideal.mul_le_left ha
  have hbK : b ∈ K := by
    have hb_eq : b = x - a := by
      exact eq_sub_of_add_eq (by simpa [add_comm] using hab)
    rw [hb_eq]
    exact Ideal.sub_mem K hxK haK
  have hb_mK : b ∈ maximalIdeal S * K := by
    let qK : S →ₗ[R] S ⧸ K := (Ideal.Quotient.mkₐ R K).toLinearMap
    have hker_flat : qK.ker ⊓ I • (⊤ : Submodule R S) = I • qK.ker :=
      LinearMap.ker_inf_smul_top_eq_smul_of_flat (R := R) (I := I) qK
        (by simpa [qK] using Ideal.Quotient.mk_surjective (I := K))
    have hb_ker : b ∈ qK.ker := by
      rw [LinearMap.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hbK
    have hb_Ismul : b ∈ I • (⊤ : Submodule R S) := by
      simpa [IS, Ideal.smul_top_eq_map] using hb
