/-- Helper for Lemma 10.135.12: the ideal generated by a list is the span of the range of its
`Fin`-indexed getter. -/
lemma ideal_span_range_get_eq_ofList {A : Type*} [CommRing A] (xs : List A) :
    Ideal.span (Set.range fun i : Fin xs.length ↦ xs.get i) = Ideal.ofList xs := by
  rw [Ideal.ofList]
  congr 1
  ext a
  exact List.mem_iff_get.symm

