/-- Helper for Lemma 10.135.12: a spanning family remains spanning after applying a surjective
map, provided the target scalar action factors through the chosen quotient map. -/
lemma quotient_span_images_eq_top_of_span_eq_top
    {A k M Q : Type*} [CommRing A] [Semiring k] [AddCommMonoid M] [Module A M]
    [AddCommMonoid Q] [Module A Q] [Module k Q]
    (π : A →+* k) (q : M →ₗ[A] Q) {n : ℕ} (f : Fin n → M) (fq : Fin n → Q)
    (hfq : ∀ i, fq i = q (f i))
    (hq_surj : Function.Surjective q)
    (hq_smul : ∀ (a : A) (x : M), q (a • x) = π a • q x)
    (hf : Submodule.span A (Set.range f) = ⊤) :
    Submodule.span k (Set.range fq) = ⊤ := by
  apply top_unique
  intro z hz
  obtain ⟨x, rfl⟩ := hq_surj z
  have hxspan : x ∈ Submodule.span A (Set.range f) := by
    rw [hf]
    exact trivial
  refine Submodule.span_induction (s := Set.range f)
    (p := fun y _ ↦ q y ∈ Submodule.span k (Set.range fq))
    ?mem ?zero ?add ?smul hxspan
  · rintro y ⟨i, rfl⟩
    rw [← hfq i]
    exact Submodule.subset_span ⟨i, rfl⟩
  · simpa using (Submodule.zero_mem (Submodule.span k (Set.range fq)))
  · intro y z hyspan hzspan hy hz
    simpa [map_add] using Submodule.add_mem (Submodule.span k (Set.range fq)) hy hz
  · intro a y hyspan hy
    have hsmul : π a • q y ∈ Submodule.span k (Set.range fq) :=
      Submodule.smul_mem _ _ hy
    rwa [hq_smul]

