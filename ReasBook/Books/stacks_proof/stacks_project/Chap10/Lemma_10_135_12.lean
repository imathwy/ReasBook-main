/-- Helper for Lemma 10.135.12: in a regular local ring, an ideal generated by `c` elements with
the expected quotient dimension has minimal number of generators exactly `c`. -/
lemma ideal_spanFinrank_eq_of_dim_span_eq
    {A : Type*} [CommRing A] [IsRegularLocalRing A] (J : Ideal A) (hJ_ne_top : J ≠ ⊤)
    {c : ℕ} (hdim : ringKrullDim (A ⧸ J) + c = ringKrullDim A)
    (x : Fin c → A) (hx : Ideal.span (Set.range x) = J) :
    J.spanFinrank = c := by
  classical
  have hJ_le_jac : J ≤ Ring.jacobson A := by
    exact (IsLocalRing.le_maximalIdeal hJ_ne_top).trans (by
      simpa [Ideal.jacobson_bot] using
        (IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal A)))
  have hupper : J.spanFinrank ≤ c := by
    rw [← hx]
    refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range x)).trans ?_
    calc
      (Set.range x).ncard = (x '' (Set.univ : Set (Fin c))).ncard := by rw [Set.image_univ]
      _ ≤ (Set.univ : Set (Fin c)).ncard := Set.ncard_image_le Set.finite_univ
      _ = c := by simp
  have hlower : c ≤ J.spanFinrank := by
    have hkrull :=
      ringKrullDim_le_ringKrullDim_quotient_add_spanFinrank (R := A) (I := J) hJ_le_jac
    exact nat_le_of_withBot_add_le_add_of_add_eq_nat
      (ringKrullDim (A ⧸ J)) (maximalIdeal A).spanFinrank J.spanFinrank c
      (by simpa [IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)] using hdim)
      (by simpa [IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)] using hkrull)
  exact le_antisymm hupper hlower

