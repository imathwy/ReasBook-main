/-- Helper for Lemma 10.135.12: the range of a linear map is spanned by the images of any
spanning family. -/
lemma linearMap_range_eq_span_image_of_span_eq_top
    {k V W : Type*} [Semiring k] [AddCommMonoid V] [Module k V]
    [AddCommMonoid W] [Module k W] (f : V →ₗ[k] W) {n : ℕ} (v : Fin n → V)
    (hv : Submodule.span k (Set.range v) = ⊤) :
    LinearMap.range f = Submodule.span k (Set.range fun i ↦ f (v i)) := by
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    have hx : x ∈ Submodule.span k (Set.range v) := by
      rw [hv]
      exact trivial
    refine Submodule.span_induction (s := Set.range v)
      (p := fun z _ ↦ f z ∈ Submodule.span k (Set.range fun i ↦ f (v i)))
      ?mem ?zero ?add ?smul hx
    · rintro z ⟨i, rfl⟩
      exact Submodule.subset_span ⟨i, rfl⟩
    · simpa using (Submodule.zero_mem (Submodule.span k (Set.range fun i ↦ f (v i))))
    · intro x z hxspan hzspan hx hz
      simpa [map_add] using
        Submodule.add_mem (Submodule.span k (Set.range fun i ↦ f (v i))) hx hz
    · intro a x hxspan hx
      simpa [map_smul] using
        Submodule.smul_mem (Submodule.span k (Set.range fun i ↦ f (v i))) a hx
  · intro hy
    exact Submodule.span_le.2
      (by
        rintro y ⟨i, rfl⟩
        exact ⟨v i, rfl⟩) hy

