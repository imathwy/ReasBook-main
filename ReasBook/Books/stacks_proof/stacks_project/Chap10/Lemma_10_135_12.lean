attribute [local instance] Algebra.TensorProduct.rightAlgebra

universe u v

open IsLocalRing
open RingTheory

section

variable {R : Type u} {S : Type v}
variable [CommRing R] [CommRing S] [Algebra R S]
variable [IsLocalRing R]

local notation "𝔪S" => Ideal.map (algebraMap R S) (maximalIdeal R)
local notation "ClosedFiber" => Ideal.Fiber (maximalIdeal R) S

variable [IsLocalRing S] [IsLocalHom (algebraMap R S)]
variable [IsRegularLocalRing R] [Module.Flat R S] [IsNoetherianRing S]

/- Domain-style sampling pass.

Primary domain: flat local maps of local rings, their canonical closed fibers, and regular
sequence generation of ideals.

Sampled owner declarations:
* `RingHom.KernelIsGeneratedByRegularSequence`;
* `Ideal.IsGeneratedByRegularSequence`;
* `Ideal.Fiber`;
* `Ideal.ker_quotientMap_mk`.

Best owner abstraction: `RingHom.KernelIsGeneratedByRegularSequence` is the primitive owner for
regular-sequence generation, `Ideal.IsGeneratedByRegularSequence` is the ideal-level bridge via the
quotient map, and the closed fiber should live on `Ideal.Fiber (maximalIdeal R) S` rather than on
an ad hoc quotient-map wrapper.

Primitive vs. derived:
* primitive data: the ideals `I ⊂ R`, `J ⊂ S`, the flat local quotient map `R ⧸ I → S ⧸ J`, and
  the closed-fiber ideal `Ideal.map (algebraMap S ClosedFiber) J`;
* derived API: identifying the latter with the kernel of the induced quotient map on closed
  fibers.

Source/core/bridge triage:
* `source-facing`: Lemma `10.135.12` itself;
* `core/canonical`: `Ideal.Fiber`, `Ideal.IsGeneratedByRegularSequence`,
  `RingHom.KernelIsGeneratedByRegularSequence`;
* `bridge/view`: the quotient-map kernel description supplied by `Ideal.ker_quotientMap_mk`.
-/

-- Proof sketch: use the regular-sequence presentation of `J / 𝔪_R J` on the closed fibre and
-- Lemma `10.99.3` to lift it to part of a regular sequence generating `J`. Then compare the
-- resulting quotient presentation of `B = S / J` with the flat quotient `R / I → S / J`, use
-- faithful flatness to identify the remaining generators with a generating set of `I`, and apply
-- Lemma `10.135.6` to conclude that `I` is generated by a regular sequence.
omit [IsLocalRing S] in
/-- Helper for Lemma 10.135.12: an ideal generated by a regular sequence is proper. -/
lemma ideal_ne_top_of_isGeneratedByRegularSequence (K : Ideal S)
    (hK : K.IsGeneratedByRegularSequence) :
    K ≠ ⊤ := by
  rcases (Ideal.isGeneratedByRegularSequence_iff K).mp hK with ⟨fs, hfs, hfsK⟩
  -- Proof comment: a regular sequence cannot generate the unit ideal in a local ring.
  rw [← hfsK]
  intro htop
  exact hfs.top_ne_smul <| by
    simp [htop]

/-- Helper for Lemma 10.135.12: in a local ring, an ideal generated by a regular sequence lies in
the maximal ideal. -/
lemma ideal_le_maximalIdeal_of_isGeneratedByRegularSequence (K : Ideal S)
    (hK : K.IsGeneratedByRegularSequence) :
    K ≤ maximalIdeal S := by
  -- Proof comment: every proper ideal of a local ring lies in the maximal ideal.
  exact IsLocalRing.le_maximalIdeal
    (ideal_ne_top_of_isGeneratedByRegularSequence (S := S) K hK)

/-- Helper for Lemma 10.135.12: the closed fiber is canonically the quotient `S / 𝔪_R S`. -/
noncomputable def closedFiber_quotient_equiv :
    (S ⧸ 𝔪S) ≃ₐ[S] ClosedFiber :=
  (Algebra.TensorProduct.quotIdealMapEquivTensorQuot S (maximalIdeal R)).trans <|
    (Algebra.TensorProduct.congr (AlgEquiv.refl : S ≃ₐ[S] S)
      (.ofBijective _
        (Ideal.bijective_algebraMap_quotient_residueField (maximalIdeal R)))).trans <|
      Algebra.TensorProduct.commRight R S ((maximalIdeal R).ResidueField)

/-- Helper for Lemma 10.135.12: under the quotient description of the closed fiber, the class of
`s : S` is exactly the image of `s` in `ClosedFiber`. -/
@[simp] lemma closedFiber_quotient_equiv_mk (s : S) :
    closedFiber_quotient_equiv (R := R) (S := S) (Ideal.Quotient.mk 𝔪S s) =
      algebraMap S ClosedFiber s := by
  -- Proof comment: unfold the quotient-to-fiber comparison and evaluate it on the quotient class
  -- of `s`.
  simp [closedFiber_quotient_equiv, Algebra.TensorProduct.right_algebraMap_apply]

/-- Helper for Lemma 10.135.12: the canonical map `S → ClosedFiber` is surjective because the
closed fiber is the quotient `S / 𝔪_R S`. -/
lemma closedFiber_algebraMap_surjective :
    Function.Surjective (algebraMap S ClosedFiber) := by
  -- Proof comment: first represent a fiber element by a quotient class, then lift that quotient
  -- class to an element of `S`.
  intro x
  obtain ⟨y, rfl⟩ := (closedFiber_quotient_equiv (R := R) (S := S)).surjective x
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨s, (closedFiber_quotient_equiv_mk (R := R) (S := S) s).symm⟩

/-- Helper for Lemma 10.135.12: the kernel of the canonical map from `S` to the closed fiber is
the ideal `𝔪_R S`. -/
lemma closedFiber_algebraMap_ker :
    RingHom.ker (algebraMap S ClosedFiber) = 𝔪S := by
  -- Proof comment: compare the canonical map with the quotient presentation `S / 𝔪_R S`.
  ext s
  constructor
  · intro hs
    rw [RingHom.mem_ker] at hs
    have hquot : Ideal.Quotient.mk 𝔪S s = 0 := by
      apply (closedFiber_quotient_equiv (R := R) (S := S)).injective
      simpa [closedFiber_quotient_equiv_mk] using hs
    exact Ideal.Quotient.eq_zero_iff_mem.mp hquot
  · intro hs
    rw [RingHom.mem_ker]
    calc
      algebraMap S ClosedFiber s =
          closedFiber_quotient_equiv (R := R) (S := S) (Ideal.Quotient.mk 𝔪S s) := by
            rw [closedFiber_quotient_equiv_mk]
      _ = 0 := by
            rw [Ideal.Quotient.eq_zero_iff_mem.mpr hs]
            exact map_zero (closedFiber_quotient_equiv (R := R) (S := S))

omit [IsRegularLocalRing R] [Module.Flat R S] [IsNoetherianRing S] in
/-- Helper for Lemma 10.135.12: the closed fiber is local, via its quotient presentation. -/
lemma closedFiber_isLocalRing_of_localHom :
    IsLocalRing ClosedFiber := by
  letI : IsLocalRing (S ⧸ 𝔪S) := by
    have h𝔪S : 𝔪S < (⊤ : Ideal S) :=
      IsLocalRing.map_maximalIdeal_lt_top (algebraMap R S)
    have : Nontrivial (S ⧸ 𝔪S) :=
      Ideal.Quotient.nontrivial_iff.mpr h𝔪S.ne
    exact IsLocalRing.of_surjective' (Ideal.Quotient.mk 𝔪S) Ideal.Quotient.mk_surjective
  exact (closedFiber_quotient_equiv (R := R) (S := S)).toRingEquiv.isLocalRing

omit [IsLocalRing S] [IsLocalHom (algebraMap R S)] [IsRegularLocalRing R] [Module.Flat R S] in
/-- Helper for Lemma 10.135.12: the closed fiber is Noetherian once `S` is Noetherian. -/
lemma closedFiber_isNoetherianRing_of_noetherian :
    IsNoetherianRing ClosedFiber :=
  isNoetherianRing_of_ringEquiv (S ⧸ 𝔪S)
    (closedFiber_quotient_equiv (R := R) (S := S)).toRingEquiv

/-- Helper for Lemma 10.135.12: two ideals have the same image in the closed fiber exactly when
they become equal after adjoining `𝔪_R S`. -/
lemma sup_closedFiber_kernel_eq_of_map_closedFiber_eq {K J : Ideal S}
    (hKJ : Ideal.map (algebraMap S ClosedFiber) K =
      Ideal.map (algebraMap S ClosedFiber) J) :
    K ⊔ 𝔪S = J ⊔ 𝔪S := by
  -- Proof comment: pull the equal image ideals back along the surjective closed-fiber map.
  let φ : S →+* ClosedFiber := algebraMap S ClosedFiber
  calc
    K ⊔ 𝔪S = Ideal.comap φ (Ideal.map φ K) := by
      rw [Ideal.comap_map_of_surjective φ (closedFiber_algebraMap_surjective (R := R) (S := S))]
      rw [← RingHom.ker_eq_comap_bot, closedFiber_algebraMap_ker (R := R) (S := S)]
    _ = Ideal.comap φ (Ideal.map φ J) := by
      rw [hKJ]
    _ = J ⊔ 𝔪S := by
      rw [Ideal.comap_map_of_surjective φ (closedFiber_algebraMap_surjective (R := R) (S := S))]
      rw [← RingHom.ker_eq_comap_bot, closedFiber_algebraMap_ker (R := R) (S := S)]

/-- Helper for Lemma 10.135.12: a regular generating list of the closed-fiber image of `J` can be
lifted to a list in `S` whose image still generates that ideal. -/
lemma closed_fiber_regular_generators_lift (J : Ideal S)
    (hJbar : (Ideal.map (algebraMap S ClosedFiber) J).IsGeneratedByRegularSequence) :
    ∃ fs : List S,
      (∀ f ∈ fs, f ∈ J) ∧
      Sequence.IsRegular ClosedFiber (fs.map (algebraMap S ClosedFiber)) ∧
      Ideal.ofList (fs.map (algebraMap S ClosedFiber)) = Ideal.map (algebraMap S ClosedFiber) J := by
  classical
  rcases (Ideal.isGeneratedByRegularSequence_iff (Ideal.map (algebraMap S ClosedFiber) J)).mp hJbar with
    ⟨fsbar, hfsbar, hfsbarJ⟩
  let φ : S →+* ClosedFiber := algebraMap S ClosedFiber
  have hfsbar_mem : ∀ x ∈ fsbar, x ∈ Ideal.map φ J := by
    -- Proof comment: each listed closed-fiber generator lies in the ideal it generates, hence in
    -- the image of `J`.
    intro x hx
    rw [← hfsbarJ]
    exact Ideal.subset_span hx
  have hlift_exists : ∀ x, x ∈ Ideal.map φ J → ∃ s, s ∈ J ∧ φ s = x := by
    intro x hx
    exact (Ideal.mem_map_iff_of_surjective φ
      (closedFiber_algebraMap_surjective (R := R) (S := S))).1 hx
  let lift : ClosedFiber → S := fun x ↦
    if hx : x ∈ Ideal.map φ J then Classical.choose (hlift_exists x hx) else 0
  let fs : List S := fsbar.map lift
  have hlift_mem : ∀ x (hx : x ∈ Ideal.map φ J), lift x ∈ J := by
    -- Proof comment: the chosen representative is chosen from `J`.
    intro x hx
    dsimp [lift]
    simpa [hx] using (Classical.choose_spec (hlift_exists x hx)).1
  have hlift_map : ∀ x (hx : x ∈ Ideal.map φ J), φ (lift x) = x := by
    -- Proof comment: the chosen representative maps to the closed-fiber generator it lifts.
    intro x hx
    dsimp [lift]
    simpa [hx] using (Classical.choose_spec (hlift_exists x hx)).2
  have hfs_mem : ∀ f ∈ fs, f ∈ J := by
    -- Proof comment: membership in the mapped list reduces to membership of the corresponding
    -- closed-fiber generator in the image ideal.
    intro f hf
    rcases List.mem_map.mp hf with ⟨x, hx, rfl⟩
    exact hlift_mem x (hfsbar_mem x hx)
  have hfs_map : fs.map (algebraMap S ClosedFiber) = fsbar := by
    -- Proof comment: the chosen representatives map back to the original closed-fiber list
    -- entrywise.
    have hmap_eq :
        ∀ l : List ClosedFiber,
          (∀ x ∈ l, (algebraMap S ClosedFiber) (lift x) = x) →
            l.map (fun x ↦ (algebraMap S ClosedFiber) (lift x)) = l := by
      intro l hl
      induction l with
      | nil => simp
      | cons x xs ih =>
          have hx : (algebraMap S ClosedFiber) (lift x) = x := hl x (by simp)
          have hxs : ∀ y ∈ xs, (algebraMap S ClosedFiber) (lift y) = y := by
            intro y hy
            exact hl y (by simp [hy])
          simp [hx, ih hxs]
    simpa [fs, List.map_map, Function.comp, φ] using
      hmap_eq fsbar (fun x hx ↦ hlift_map x (hfsbar_mem x hx))
  refine ⟨fs, ?_, ?_, ?_⟩
  · -- Proof comment: every lifted generator remains inside the original ideal `J`.
    exact hfs_mem
  · -- Proof comment: replace the lifted image list by the original regular list in the closed fiber.
    simpa [hfs_map] using hfsbar
  · -- Proof comment: the lifted image list generates the same ideal because it is literally the
    -- original closed-fiber generating list.
    calc
      Ideal.ofList (fs.map (algebraMap S ClosedFiber)) = Ideal.ofList fsbar := by
        rw [hfs_map]
      _ = Ideal.map (algebraMap S ClosedFiber) J := hfsbarJ

/-- Helper for Lemma 10.135.12: a ring equivalence transports a regular sequence to the mapped
coefficient list. -/
lemma regular_sequence_iff_map_regular_sequence_of_ringEquiv
    {A : Type*} {B : Type*} [CommRing A] [CommRing B] (e : A ≃+* B) (rs : List A) :
    Sequence.IsRegular A rs ↔ Sequence.IsRegular B (rs.map e) := by
  -- Proof comment: regularity is stated on the regular module, so the ring equivalence only needs
  -- to preserve multiplication.
  refine e.toAddEquiv.isRegular_congr <| List.forall₂_map_right_iff.mpr ?_
  rw [List.forall₂_same]
  intro a ha x
  simpa [Algebra.smul_def] using e.map_mul a x

/-- Helper for Lemma 10.135.12: specializing Lemma `10.135.6` to the factorization
`A --id--> A --f--> B` recovers the expected-number-of-generators criterion for a single
surjective local quotient of a regular local ring. -/
lemma kernel_generatedByRegularSequence_iff_exists_dim_span_eq_ker_local
    {A : Type*} {B : Type*} [CommRing A] [CommRing B]
    [IsRegularLocalRing A] [IsLocalRing B]
    (f : A →+* B) [IsLocalHom f] (hsurj : Function.Surjective f) :
    f.KernelIsGeneratedByRegularSequence ↔
      ∃ (d : ℕ) (_ : ringKrullDim B + d = ringKrullDim A) (x : Fin d → A),
        Ideal.span (Set.range x) = RingHom.ker f := by
  let htfae :=
    ker_generatedBy_regularSequence_tfae_of_surjective_local_of_isRegularLocalRing
      (A := A) (B := A) (C := B) (φ := RingHom.id A) (ψ := f)
      (by
        intro a
        exact ⟨a, rfl⟩)
      hsurj
  -- Proof comment: with the identity as the left factor, the first two entries of the TFAE are
  -- exactly the single-kernel statements we need.
  simpa using (htfae.out 0 1 rfl rfl)

/-- Helper for Lemma 10.135.12: once `S` is Noetherian, Lemma `10.99.3` upgrades the lifted
closed-fiber regular sequence to a regular sequence in `S`, and the full quotient by that list is
flat over `R`. -/
lemma lifted_closedFiber_generators_give_flat_regular_quotient
    [IsNoetherianRing S] {fs : List S}
    (hfs_closed : Sequence.IsRegular ClosedFiber (fs.map (algebraMap S ClosedFiber))) :
    Sequence.IsRegular S fs ∧ Module.Flat R (S ⧸ Ideal.ofList fs) := by
  have hfs_quotient :
      Sequence.IsRegular (S ⧸ 𝔪S) (fs.map (Ideal.Quotient.mk 𝔪S)) := by
    -- Proof comment: rewrite the tensor closed fiber as the quotient `S / 𝔪_R S` and transport
    -- the regular sequence across that canonical equivalence.
    have hmap :
        (fs.map (Ideal.Quotient.mk 𝔪S)).map (closedFiber_quotient_equiv (R := R) (S := S)) =
          fs.map (algebraMap S ClosedFiber) := by
      ext s
      simp [closedFiber_quotient_equiv_mk]
    have htransport :=
      regular_sequence_iff_map_regular_sequence_of_ringEquiv
        (closedFiber_quotient_equiv (R := R) (S := S)).toRingEquiv
        (fs.map (Ideal.Quotient.mk 𝔪S))
    refine htransport.mpr ?_
    simpa [hmap] using hfs_closed
  obtain ⟨hfs_regular, hflat_prefix⟩ :=
    isRegular_and_flat_quotient_take_of_closedFiber_isRegular
      (R := R) (S := S) fs hfs_quotient
  refine ⟨hfs_regular, ?_⟩
  cases fs with
  | nil =>
      -- Proof comment: the empty-list quotient is the original flat ring `S`.
      rw [Ideal.ofList_nil]
      exact Module.Flat.of_linearEquiv (AlgEquiv.quotientBot R S).toLinearEquiv
  | cons f fs =>
      -- Proof comment: for a nonempty list, Lemma `10.99.3` already supplies flatness of the
      -- quotient by the full final prefix.
      have hfull :
          Module.Flat R (S ⧸ Ideal.ofList (List.take (fs.length + 1) (f :: fs))) := by
        simpa using hflat_prefix ⟨fs.length, by simp⟩
      have htake : List.take (fs.length + 1) (f :: fs) = f :: fs := by
        simp [List.take_length]
      rw [htake] at hfull
      exact hfull

omit [IsLocalRing R] [IsRegularLocalRing R] [Module.Flat R S] in
/-- Helper for Lemma 10.135.12: quotienting a local homomorphism by proper compatible ideals
again gives a local homomorphism. -/
lemma quotientMap_isLocalHom_of_le_of_ne_top
    {I : Ideal R} {J : Ideal S} (hIJ : I ≤ Ideal.comap (algebraMap R S) J)
    (hJ : J ≠ ⊤) :
    IsLocalHom (Ideal.quotientMap J (algebraMap R S) hIJ) := by
  letI : Nontrivial (S ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ
  letI : IsLocalRing (S ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  letI : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  refine ⟨?_⟩
  intro x hxunit
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hSunit : IsUnit (algebraMap R S r) := by
    apply (isUnit_map_iff (Ideal.Quotient.mk J) (algebraMap R S r)).mp
    simpa [Ideal.quotientMap_mk] using hxunit
  have hRunit : IsUnit r := (isUnit_map_iff (algebraMap R S) r).mp hSunit
  exact (Ideal.Quotient.mk I).isUnit_map hRunit

omit [CommRing R] [CommRing S] [Algebra R S] [IsLocalRing R] [IsLocalRing S]
    [IsLocalHom (algebraMap R S)] [IsRegularLocalRing R] [Module.Flat R S]
    [IsNoetherianRing S] in
/-- Helper for Lemma 10.135.12: the dimension formula for a flat local homomorphism, expressed
using the quotient presentation of the closed fiber. -/
lemma ringKrullDim_eq_ringKrullDim_add_ringKrullDim_quotient_maximalIdeal_map_of_flat_localHom
    {A : Type*} {B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [IsLocalRing A] [IsLocalRing B] [IsLocalHom (algebraMap A B)]
    [IsNoetherianRing A] [IsNoetherianRing B] [Module.Flat A B] :
    ringKrullDim B =
      ringKrullDim A + ringKrullDim (B ⧸ Ideal.map (algebraMap A B) (maximalIdeal A)) := by
  let mB : Ideal B := Ideal.map (algebraMap A B) (maximalIdeal A)
  let q : PrimeSpectrum B := ⟨maximalIdeal B, inferInstance⟩
  let h_unitsB : (maximalIdeal B).primeCompl ≤ IsUnit.submonoid B := by
    intro b hb
    simpa [Ideal.mem_primeCompl_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      Classical.not_not] using hb
  let pUnder : Ideal A := Ideal.under A (maximalIdeal B)
  letI : pUnder.IsPrime := by
    dsimp [pUnder]
    infer_instance
  have hpUnder : pUnder = maximalIdeal A := by
    simpa [pUnder, Ideal.under_def] using IsLocalRing.maximalIdeal_comap (algebraMap A B)
  have h_unitsP : pUnder.primeCompl ≤ IsUnit.submonoid A := by
    intro a ha
    have haM : a ∉ maximalIdeal A := by
      simpa [pUnder, hpUnder] using ha
    simpa [Ideal.mem_primeCompl_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
      Classical.not_not] using haM
  letI : IsLocalization pUnder.primeCompl A := IsLocalization.self h_unitsP
  letI : IsLocalization (maximalIdeal B).primeCompl B := IsLocalization.self h_unitsB
  let eP : Localization.AtPrime pUnder ≃ₐ[A] A :=
    IsLocalization.algEquiv pUnder.primeCompl (Localization.AtPrime pUnder) A
  let eB : Localization.AtPrime (maximalIdeal B) ≃ₐ[B] B :=
    IsLocalization.algEquiv (maximalIdeal B).primeCompl (Localization.AtPrime (maximalIdeal B)) B
  let Iunder : Ideal (Localization.AtPrime (maximalIdeal B)) :=
    Ideal.map (algebraMap A (Localization.AtPrime (maximalIdeal B))) pUnder
  have hIunder_map : Ideal.map eB.toRingHom Iunder = mB := by
    calc
      Ideal.map eB.toRingHom Iunder =
          Ideal.map
            (eB.toRingHom.comp (algebraMap A (Localization.AtPrime (maximalIdeal B))))
            pUnder := by
              simpa [Iunder] using
                (Ideal.map_map (I := pUnder)
                  (algebraMap A (Localization.AtPrime (maximalIdeal B))) eB.toRingHom)
      _ = Ideal.map (algebraMap A B) pUnder := by
          congr 1
          ext a
          simpa [IsScalarTower.algebraMap_eq A B (Localization.AtPrime (maximalIdeal B))] using
            (eB.commutes (algebraMap A B a))
      _ = Ideal.map (algebraMap A B) (maximalIdeal A) := by rw [hpUnder]
      _ = mB := rfl
  have hIunder_comap : Ideal.comap eB.toRingHom mB = Iunder := by
    rw [← hIunder_map, Ideal.comap_map_of_surjective eB.toRingHom eB.surjective,
      Ideal.comap_bot_of_injective (f := eB.toRingHom) eB.injective, sup_eq_left]
    exact bot_le
  let φ : Localization.AtPrime (maximalIdeal B) →+* B ⧸ mB :=
    (Ideal.Quotient.mk mB).comp eB.toRingHom
  have hφ_surj : Function.Surjective φ := Ideal.Quotient.mk_surjective.comp eB.surjective
  have hker_aux :
      RingHom.ker ((Ideal.Quotient.mk mB).comp eB.toRingHom) =
        Ideal.comap eB.toRingHom mB := by
    ext z
    simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
  have hkerφ : RingHom.ker φ = Iunder := by
    change RingHom.ker ((Ideal.Quotient.mk mB).comp eB.toRingHom) = Iunder
    rw [hker_aux, hIunder_comap]
  let eQ : (Localization.AtPrime (maximalIdeal B)) ⧸ Iunder ≃+* B ⧸ mB :=
    (Ideal.quotEquivOfEq hkerφ.symm).trans (RingHom.quotientKerEquivOfSurjective hφ_surj)
  have hdimLoc :
      ringKrullDim (Localization.AtPrime (maximalIdeal B)) =
        ringKrullDim (Localization.AtPrime pUnder) +
          ringKrullDim (Localization.AtPrime (maximalIdeal B) ⧸ Iunder) := by
    change
      ringKrullDim (Localization.AtPrime q.asIdeal) =
        ringKrullDim (Localization.AtPrime pUnder) +
          ringKrullDim
            ((Localization.AtPrime q.asIdeal) ⧸
              Ideal.map (algebraMap A (Localization.AtPrime q.asIdeal)) pUnder)
    simpa [q, pUnder, Iunder] using
      ringKrullDim_localizationAtPrime_eq_ringKrullDim_localizationAtPrime_under_add_ringKrullDim_quotient_of_hasGoingDown
        (R := A) (S := B) q
  calc
    ringKrullDim B = ringKrullDim (Localization.AtPrime (maximalIdeal B)) := by
      symm
      exact ringKrullDim_eq_of_ringEquiv eB.toRingEquiv
    _ = ringKrullDim (Localization.AtPrime pUnder) +
        ringKrullDim (Localization.AtPrime (maximalIdeal B) ⧸ Iunder) := hdimLoc
    _ = ringKrullDim A + ringKrullDim (B ⧸ mB) := by
      rw [ringKrullDim_eq_of_ringEquiv eP.toRingEquiv, ringKrullDim_eq_of_ringEquiv eQ]
    _ = ringKrullDim A + ringKrullDim (B ⧸ Ideal.map (algebraMap A B) (maximalIdeal A)) := rfl

