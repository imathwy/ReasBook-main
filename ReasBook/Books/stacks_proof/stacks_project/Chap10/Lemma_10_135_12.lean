        · intro j
          simp [wJ, wV, gV, gJ]⟩
    · rintro ⟨i, rfl⟩
      exact ⟨wJ i, ⟨i, rfl⟩, by
        refine Fin.addCases ?_ ?_ i
        · intro j
          simp [wJ, wV, fV, fJ]
        · intro j
          simp [wJ, wV, gV, gJ]⟩
  have hmap_span_wJ : Submodule.map qS (Submodule.span S (Set.range wJ)) = ⊤ := by
    rw [Submodule.map_span, hq_w_range, hspanw_S]
  have hspanwJ_top : Submodule.span S (Set.range wJ) = ⊤ := by
    have hmap_span_wJ' :
        Submodule.map (maximalIdeal S • (⊤ : Submodule S J)).mkQ
          (Submodule.span S (Set.range wJ)) = ⊤ := by
      change Submodule.map qS (Submodule.span S (Set.range wJ)) = ⊤
      exact hmap_span_wJ
    exact (IsLocalRing.map_mkQ_eq_top
      (R := S) (M := J) (N := Submodule.span S (Set.range wJ))).mp hmap_span_wJ'
  have hamb_span : Ideal.span (Set.range fun i ↦ ((wJ i : J) : S)) = J := by
    exact (Submodule.span_range_subtype_eq_top_iff
      (p := J) (s := fun i ↦ ((wJ i : J) : S)) (fun i ↦ (wJ i).2)).1
      hspanwJ_top
  have hw_range :
      Set.range (fun i ↦ ((wJ i : J) : S)) =
        Set.range (Fin.append
          (fun i : Fin fs.length ↦ fs.get i)
          (fun i : Fin (c - fs.length) ↦ algebraMap R S (g i))) := by
    ext s
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i, by
        refine Fin.addCases ?_ ?_ i
        · intro j
          simp [wJ, fJ]
        · intro j
          simp [wJ, gJ]⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, by
        refine Fin.addCases ?_ ?_ i
        · intro j
          simp [wJ, fJ]
        · intro j
          simp [wJ, gJ]⟩
  refine ⟨g, hg_mem, ?_⟩
  symm
  calc
    Ideal.ofList fs ⊔ Ideal.map (algebraMap R S) (Ideal.span (Set.range g)) =
        Ideal.span (Set.range fun i : Fin fs.length ↦ fs.get i) ⊔
          Ideal.span (Set.range fun i : Fin (c - fs.length) ↦ algebraMap R S (g i)) := by
          rw [ideal_span_range_get_eq_ofList]
          congr 1
          rw [Ideal.map_span]
          congr 1
          ext s
          constructor
          · rintro ⟨r, ⟨i, rfl⟩, rfl⟩
            exact ⟨i, rfl⟩
          · rintro ⟨i, rfl⟩
            exact ⟨g i, ⟨i, rfl⟩, rfl⟩
    _ = Ideal.span (Set.range (Fin.append
          (fun i : Fin fs.length ↦ fs.get i)
          (fun i : Fin (c - fs.length) ↦ algebraMap R S (g i)))) := by
          rw [range_fin_append, Ideal.span_union]
    _ = J := by
          rw [← hw_range]
          exact hamb_span

/-- Lemma 10.135.12: if `R → S` is a flat local homomorphism of local rings, `R` and the closed
fibre `S / 𝔪_RS` are regular local rings, `J ⊂ S` and its image in the closed fibre are generated
by regular sequences, and the induced quotient map `R ⧸ I → S ⧸ J` is flat, then `I` is generated
by a regular sequence. -/
@[stacks 02JP]
theorem kernelIsGeneratedByRegularSequence_of_flat_local_quotient_square_of_regular_closedFiber
    (I : Ideal R) (J : Ideal S) (hIJ : I ≤ Ideal.comap (algebraMap R S) J)
    (hclosedFiber : IsRegularLocalRing ClosedFiber)
    (hJ : J.IsGeneratedByRegularSequence)
    (hJbar : (Ideal.map (algebraMap S ClosedFiber) J).IsGeneratedByRegularSequence)
    (hflatAB : (Ideal.quotientMap J (algebraMap R S) hIJ).Flat) :
    I.IsGeneratedByRegularSequence := by
  classical
  have hJ_ne_top : J ≠ ⊤ :=
    ideal_ne_top_of_isGeneratedByRegularSequence (S := S) J hJ
  have hI_ne_top : I ≠ ⊤ := by
    -- Proof comment: the base ideal is proper because `I ⊆ J ∩ R` and `J` is proper.
    intro hI_top
    have h1I : (1 : R) ∈ I := by simpa [hI_top]
    have h1J : (1 : S) ∈ J := by
      simpa using hIJ h1I
    have hJ_top : J = ⊤ :=
      Ideal.eq_top_of_isUnit_mem J h1J isUnit_one
    exact hJ_ne_top hJ_top
  have hI_le_max : I ≤ maximalIdeal R :=
    IsLocalRing.le_maximalIdeal hI_ne_top
  obtain ⟨fs, hfs_mem_J, hfs_closed, hfsJbar⟩ :=
    closed_fiber_regular_generators_lift (R := R) (S := S) J hJbar
  let K : Ideal S := Ideal.ofList fs
  have hK_le_J : K ≤ J := by
    -- Proof comment: the lifted closed-fiber generators were chosen inside `J`, so the ideal they
    -- generate is contained in `J`.
    dsimp [K]
    rw [Ideal.ofList]
    exact Ideal.span_le.2 hfs_mem_J
  have hK_closed :
      Ideal.map (algebraMap S ClosedFiber) K = Ideal.map (algebraMap S ClosedFiber) J := by
    -- Proof comment: by construction, the lifted list maps back to the original closed-fiber
    -- regular generating list for `J`.
    simpa [K] using hfsJbar
  let qAB : R ⧸ I →+* S ⧸ J := Ideal.quotientMap J (algebraMap R S) hIJ
  have hqAB_local : IsLocalHom qAB := by
    -- Proof comment: the quotient square remains a local homomorphism because `J` is proper and
    -- the original map is local.
    exact quotientMap_isLocalHom_of_le_of_ne_top
      (R := R) (S := S) (I := I) (J := J) hIJ hJ_ne_top
  letI : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI_ne_top
  letI : IsLocalRing (R ⧸ I) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  letI : Nontrivial (S ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ_ne_top
  letI : IsLocalRing (S ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  letI : Algebra (R ⧸ I) (S ⧸ J) := qAB.toAlgebra
  letI : IsLocalHom (algebraMap (R ⧸ I) (S ⧸ J)) := by
    simpa [qAB] using hqAB_local
  letI : Module.Flat (R ⧸ I) (S ⧸ J) := by
    simpa [RingHom.Flat, qAB] using hflatAB
  have hqAB_faithfullyFlat : qAB.FaithfullyFlat := by
    rw [RingHom.FaithfullyFlat]
    change Module.FaithfullyFlat (R ⧸ I) (S ⧸ J)
    exact Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hqAB_injective : Function.Injective qAB :=
    RingHom.FaithfullyFlat.injective hqAB_faithfullyFlat
  have hI_eq_comap_J : I = Ideal.comap (algebraMap R S) J := by
    -- Proof comment: faithful flatness of `A → B` makes the quotient map injective, so the
    -- original containment `I ⊆ J ∩ R` is an equality.
    refine le_antisymm hIJ ?_
    intro r hr
    have hzero : qAB (Ideal.Quotient.mk I r) = 0 := by
      calc
        qAB (Ideal.Quotient.mk I r) =
            Ideal.Quotient.mk J (algebraMap R S r) := by
              simp [qAB, Ideal.quotientMap_mk]
        _ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hr
    have hmk_zero : Ideal.Quotient.mk I r = 0 := by
      exact hqAB_injective (by simpa using hzero)
    exact (Ideal.Quotient.eq_zero_iff_mem).1 hmk_zero
  have hmap_I_le_J : Ideal.map (algebraMap R S) I ≤ J := by
    -- Proof comment: after identifying `I` with the contraction of `J`, extension of `I` is
    -- contained in `J`.
    rw [hI_eq_comap_J]
    exact Ideal.map_comap_le
  have hK_sup_mS_eq_J_sup_mS : K ⊔ 𝔪S = J ⊔ 𝔪S :=
    sup_closedFiber_kernel_eq_of_map_closedFiber_eq (R := R) (S := S) hK_closed
  have hK_sup_map_I_le_J : K ⊔ Ideal.map (algebraMap R S) I ≤ J :=
    sup_le hK_le_J hmap_I_le_J
  obtain ⟨hfs_regular, hflat_SK⟩ :=
    lifted_closedFiber_generators_give_flat_regular_quotient (R := R) (S := S) hfs_closed
  have hK_reg : K.IsGeneratedByRegularSequence := by
    rw [Ideal.isGeneratedByRegularSequence_iff]
    exact ⟨fs, hfs_regular, rfl⟩
  let L : Ideal S := K ⊔ Ideal.map (algebraMap R S) I
  have hL_le_J : L ≤ J := by
    simpa [L] using hK_sup_map_I_le_J
  have hIL : I ≤ Ideal.comap (algebraMap R S) L := by
    intro r hr
    change algebraMap R S r ∈ K ⊔ Ideal.map (algebraMap R S) I
    exact (le_sup_right : Ideal.map (algebraMap R S) I ≤ K ⊔ Ideal.map (algebraMap R S) I)
      (Ideal.mem_map_of_mem (algebraMap R S) hr)
  have hL_ne_top : L ≠ ⊤ := by
    intro hL_top
    have hJ_top : J = ⊤ := by
      apply top_unique
      simpa [hL_top] using hL_le_J
    exact hJ_ne_top hJ_top
  have hmap_I_le_mS : Ideal.map (algebraMap R S) I ≤ 𝔪S :=
    Ideal.map_mono hI_le_max
  have hL_sup_mS_eq : L ⊔ 𝔪S = J ⊔ 𝔪S := by
    calc
      L ⊔ 𝔪S = K ⊔ 𝔪S := by
        change (K ⊔ Ideal.map (algebraMap R S) I) ⊔ 𝔪S = K ⊔ 𝔪S
        rw [sup_assoc, sup_eq_right.mpr hmap_I_le_mS]
      _ = J ⊔ 𝔪S := hK_sup_mS_eq_J_sup_mS
  let qAL : R ⧸ I →+* S ⧸ L := Ideal.quotientMap L (algebraMap R S) hIL
  have hqAL_local : IsLocalHom qAL := by
    exact quotientMap_isLocalHom_of_le_of_ne_top
      (R := R) (S := S) (I := I) (J := L) hIL hL_ne_top
  letI : Nontrivial (S ⧸ L) := Ideal.Quotient.nontrivial_iff.mpr hL_ne_top
  letI : IsLocalRing (S ⧸ L) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk L) Ideal.Quotient.mk_surjective
  letI : Algebra (R ⧸ I) (S ⧸ L) := qAL.toAlgebra
  letI : IsLocalHom (algebraMap (R ⧸ I) (S ⧸ L)) := by
    simpa [qAL] using hqAL_local
  have hmax_quot :
      maximalIdeal (R ⧸ I) = Ideal.map (Ideal.Quotient.mk I) (maximalIdeal R) := by
    symm
    exact IsLocalRing.map_maximalIdeal_of_surjective
      (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let qLB : S ⧸ L →+* S ⧸ J := Ideal.quotientMap J (RingHom.id S) hL_le_J
  let uAlg : (S ⧸ L) →ₐ[R ⧸ I] (S ⧸ J) :=
    { qLB with
      commutes' := by
        intro x
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
        change qLB (qAL (Ideal.Quotient.mk I r)) = qAB (Ideal.Quotient.mk I r)
        simp [qLB, qAL, qAB] }
  let u : (S ⧸ L) →ₗ[R ⧸ I] (S ⧸ J) := uAlg.toLinearMap
  have hu_mod :
      Function.Injective (u.quotientMapByIdeal (maximalIdeal (R ⧸ I))) := by
    intro x y hxy
    obtain ⟨x0, rfl⟩ := Submodule.mkQ_surjective
      ((maximalIdeal (R ⧸ I)) • (⊤ : Submodule (R ⧸ I) (S ⧸ L))) x
    obtain ⟨sx, rfl⟩ := Ideal.Quotient.mk_surjective x0
    obtain ⟨y0, rfl⟩ := Submodule.mkQ_surjective
      ((maximalIdeal (R ⧸ I)) • (⊤ : Submodule (R ⧸ I) (S ⧸ L))) y
    obtain ⟨sy, rfl⟩ := Ideal.Quotient.mk_surjective y0
    apply (Submodule.Quotient.eq _).2
    have hdiffJ :
        (Ideal.Quotient.mk J (sx - sy) : S ⧸ J) ∈
          (maximalIdeal (R ⧸ I)) • (⊤ : Submodule (R ⧸ I) (S ⧸ J)) := by
      have hdiff := (Submodule.Quotient.eq
        ((maximalIdeal (R ⧸ I)) • (⊤ : Submodule (R ⧸ I) (S ⧸ J)))).1 hxy
      simpa [u, uAlg, qLB, Ideal.quotientMap_mk, map_sub] using hdiff
    have hmemJ : sx - sy ∈ J ⊔ 𝔪S := by
      have hdiffJ' := hdiffJ
      rw [Ideal.smul_top_eq_map] at hdiffJ'
      change (Ideal.Quotient.mk J (sx - sy) : S ⧸ J) ∈
        Ideal.map (algebraMap (R ⧸ I) (S ⧸ J)) (maximalIdeal (R ⧸ I)) at hdiffJ'
      rw [hmax_quot] at hdiffJ'
      have hmapJ :
          Ideal.map (algebraMap (R ⧸ I) (S ⧸ J))
              (Ideal.map (Ideal.Quotient.mk I) (maximalIdeal R)) =
            Ideal.map (Ideal.Quotient.mk J) 𝔪S := by
        rw [Ideal.map_map, Ideal.map_map]
        change
          Ideal.map (qAB.comp (Ideal.Quotient.mk I)) (maximalIdeal R) =
            Ideal.map ((Ideal.Quotient.mk J).comp (algebraMap R S)) (maximalIdeal R)
        rw [Ideal.quotientMap_comp_mk]
      rw [hmapJ] at hdiffJ'
      rw [Ideal.mem_quotient_iff_mem_sup] at hdiffJ'
      simpa [sup_comm] using hdiffJ'
    have hmemL : sx - sy ∈ L ⊔ 𝔪S := by
      rwa [hL_sup_mS_eq]
    have hdiffL :
        (Ideal.Quotient.mk L (sx - sy) : S ⧸ L) ∈
          (maximalIdeal (R ⧸ I)) • (⊤ : Submodule (R ⧸ I) (S ⧸ L)) := by
      rw [Ideal.smul_top_eq_map]
      change (Ideal.Quotient.mk L (sx - sy) : S ⧸ L) ∈
        Ideal.map (algebraMap (R ⧸ I) (S ⧸ L)) (maximalIdeal (R ⧸ I))
      rw [hmax_quot]
      have hmapL :
          Ideal.map (algebraMap (R ⧸ I) (S ⧸ L))
              (Ideal.map (Ideal.Quotient.mk I) (maximalIdeal R)) =
            Ideal.map (Ideal.Quotient.mk L) 𝔪S := by
        rw [Ideal.map_map, Ideal.map_map]
        change
          Ideal.map (qAL.comp (Ideal.Quotient.mk I)) (maximalIdeal R) =
            Ideal.map ((Ideal.Quotient.mk L).comp (algebraMap R S)) (maximalIdeal R)
        rw [Ideal.quotientMap_comp_mk]
      rw [hmapL]
      rw [Ideal.mem_quotient_iff_mem_sup]
      simpa [sup_comm] using hmemL
    simpa [map_sub] using hdiffL
  have hu_injective : Function.Injective u := by
    exact injective_of_mod_maximalIdeal_injective
      (R := R ⧸ I) (S := S ⧸ L) (M := S ⧸ J) (N := S ⧸ L) u hu_mod
  have hqLB_injective : Function.Injective qLB := by
    intro x y hxy
    exact hu_injective (by simpa [u, uAlg] using hxy)
  have hJ_le_L : J ≤ L := by
    intro s hs
    have hzero : qLB (Ideal.Quotient.mk L s) = 0 := by
      simpa [qLB, Ideal.quotientMap_mk] using
        (Ideal.Quotient.eq_zero_iff_mem.mpr hs : Ideal.Quotient.mk J s = 0)
    have hmk_zero : Ideal.Quotient.mk L s = 0 := by
      exact hqLB_injective (by simpa using hzero)
    exact Ideal.Quotient.eq_zero_iff_mem.mp hmk_zero
  have hJ_eq_L : J = L := le_antisymm hJ_le_L hL_le_J
  letI : IsRegularLocalRing S :=
    isRegularLocalRing_of_flat_localHom_of_regular_closedFiber
      (R := R) (S := S) hclosedFiber
  letI : IsLocalHom (Ideal.Quotient.mk J) :=
    IsLocalHom.of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  obtain ⟨c, hdimJ, jgens, hjgens⟩ :=
    (kernel_generatedByRegularSequence_iff_exists_dim_span_eq_ker_local
      (A := S) (B := S ⧸ J) (f := Ideal.Quotient.mk J)
      (hsurj := Ideal.Quotient.mk_surjective)).mp hJ
  have hjgens_span : Ideal.span (Set.range jgens) = J := by
    simpa [Ideal.mk_ker] using hjgens
  letI : IsLocalRing ClosedFiber :=
    closedFiber_isLocalRing_of_localHom (R := R) (S := S)
  letI : IsNoetherianRing ClosedFiber :=
    closedFiber_isNoetherianRing_of_noetherian (R := R) (S := S)
  letI : Module.CohenMacaulay ClosedFiber ClosedFiber :=
    regularLocalRing_selfModule_cohenMacaulay
  have hJbar_le_max :
      Ideal.map (algebraMap S ClosedFiber) J ≤ maximalIdeal ClosedFiber :=
    ideal_le_maximalIdeal_of_isGeneratedByRegularSequence
      (S := ClosedFiber) (Ideal.map (algebraMap S ClosedFiber) J) hJbar
  have hfs_closed_mem :
      ∀ x ∈ fs.map (algebraMap S ClosedFiber), x ∈ maximalIdeal ClosedFiber := by
    intro x hx
    apply hJbar_le_max
    rw [← hfsJbar]
    exact Ideal.subset_span hx
  have hfs_closed_dim :
      ringKrullDim (ClosedFiber ⧸ Ideal.map (algebraMap S ClosedFiber) J) +
          fs.length =
        ringKrullDim ClosedFiber := by
    have hdim :
        ringKrullDim (ClosedFiber ⧸ Ideal.ofList (fs.map (algebraMap S ClosedFiber))) +
            (fs.map (algebraMap S ClosedFiber)).length =
          ringKrullDim ClosedFiber :=
      (isRegular_iff_ringKrullDim_quotient_add_length_eq
        (R := ClosedFiber) hfs_closed_mem).1 hfs_closed
    rw [hfsJbar] at hdim
    simpa using hdim
  have hVdim :
      Module.finrank (S ⧸ maximalIdeal S)
        (J ⧸ maximalIdeal S • (⊤ : Submodule S J)) = c :=
    ideal_modmax_finrank_eq_of_dim_span_eq
      (A := S) J hJ_ne_top hdimJ jgens hjgens_span
  let F : Submodule (S ⧸ maximalIdeal S)
      (J ⧸ maximalIdeal S • (⊤ : Submodule S J)) :=
    Submodule.span (S ⧸ maximalIdeal S)
      (Set.range fun i : Fin fs.length ↦
        Submodule.mkQ (maximalIdeal S • (⊤ : Submodule S J))
          (⟨fs.get i, hfs_mem_J _ (List.get_mem fs i)⟩ : J))
  have hFdim :
      Module.finrank (S ⧸ maximalIdeal S) F = fs.length := by
    change Module.finrank (S ⧸ maximalIdeal S)
      (Submodule.span (S ⧸ maximalIdeal S)
        (Set.range fun i : Fin fs.length ↦
          Submodule.mkQ (maximalIdeal S • (⊤ : Submodule S J))
            (⟨fs.get i, hfs_mem_J _ (List.get_mem fs i)⟩ : J))) = fs.length
    exact lifted_generators_modmax_finrank_eq_length
      (R := R) (S := S) I J fs hI_le_max hfs_mem_J
      (by simpa [K, L] using hJ_eq_L)
      hfs_regular
      (by simpa [K] using hflat_SK)
  obtain ⟨g, hg_mem, hJ_eq_g⟩ :=
    exists_I_generators_complement_modmax
      (R := R) (S := S) (I := I) (J := J) (fs := fs) (c := c)
      hfs_mem_J
      (by simpa [K, L] using hJ_eq_L)
      hVdim hFdim
  let G : Ideal R := Ideal.span (Set.range g)
  have hG_le_I : G ≤ I := by
    dsimp [G]
    exact Ideal.span_le.2 (by
      rintro r ⟨i, rfl⟩
      exact hg_mem i)
  have hG_ne_top : G ≠ ⊤ := by
    intro hG_top
    have htop_le : (⊤ : Ideal R) ≤ I := by
      simpa [hG_top] using hG_le_I
    exact hI_ne_top (le_antisymm le_top htop_le)
  have hGJ : G ≤ Ideal.comap (algebraMap R S) J :=
    hG_le_I.trans hIJ
  let qGB : R ⧸ G →+* S ⧸ J := Ideal.quotientMap J (algebraMap R S) hGJ
  have hqGB_local : IsLocalHom qGB := by
    exact quotientMap_isLocalHom_of_le_of_ne_top
      (R := R) (S := S) (I := G) (J := J) hGJ hJ_ne_top
  letI : Nontrivial (R ⧸ G) := Ideal.Quotient.nontrivial_iff.mpr hG_ne_top
  letI : IsLocalRing (R ⧸ G) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk G) Ideal.Quotient.mk_surjective
  letI : Algebra (R ⧸ G) (S ⧸ J) := qGB.toAlgebra
  letI : IsLocalHom (algebraMap (R ⧸ G) (S ⧸ J)) := by
    simpa [qGB] using hqGB_local
  have hflat_GB : Module.Flat (R ⧸ G) (S ⧸ J) := by
    simpa [qGB, G] using
      (quotientMap_flat_of_flat_quotient_sup_map
        (R := R) (S := S) (G := G) (K := K) (J := J)
        (by simpa [G] using hJ_eq_g) hflat_SK hGJ)
  letI : Module.Flat (R ⧸ G) (S ⧸ J) := hflat_GB
  have hqGB_faithfullyFlat : qGB.FaithfullyFlat := by
    rw [RingHom.FaithfullyFlat]
    change Module.FaithfullyFlat (R ⧸ G) (S ⧸ J)
    exact Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hqGB_injective : Function.Injective qGB :=
    RingHom.FaithfullyFlat.injective hqGB_faithfullyFlat
  have hI_le_G : I ≤ G := by
    intro r hr
    have hzero : qGB (Ideal.Quotient.mk G r) = 0 := by
      calc
        qGB (Ideal.Quotient.mk G r) =
            Ideal.Quotient.mk J (algebraMap R S r) := by
              simp [qGB, Ideal.quotientMap_mk]
        _ = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (hIJ hr)
    have hmk_zero : Ideal.Quotient.mk G r = 0 :=
      hqGB_injective (by simpa using hzero)
    exact Ideal.Quotient.eq_zero_iff_mem.mp hmk_zero
  have hG_eq_I : G = I := le_antisymm hG_le_I hI_le_G
  letI : IsLocalHom (Ideal.Quotient.mk I) :=
    IsLocalHom.of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  letI : Field (S ⧸ maximalIdeal S) := Ideal.Quotient.field (maximalIdeal S)
  have hlen_le_c : fs.length ≤ c := by
    have hle :
        Module.finrank (S ⧸ maximalIdeal S) F ≤
          Module.finrank (S ⧸ maximalIdeal S)
            (J ⧸ maximalIdeal S • (⊤ : Submodule S J)) :=
      Submodule.finrank_le F
    simpa [hFdim, hVdim] using hle
  have hdimS :
      ringKrullDim S = ringKrullDim R + ringKrullDim ClosedFiber := by
