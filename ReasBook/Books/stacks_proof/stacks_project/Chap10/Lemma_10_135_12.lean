  have hdimB0 :
      ringKrullDim (S ⧸ J) =
        ringKrullDim (R ⧸ I) +
          ringKrullDim
            ((S ⧸ J) ⧸
              Ideal.map (algebraMap (R ⧸ I) (S ⧸ J)) (maximalIdeal (R ⧸ I))) :=
    ringKrullDim_eq_ringKrullDim_add_ringKrullDim_quotient_maximalIdeal_map_of_flat_localHom
      (A := R ⧸ I) (B := S ⧸ J)
  have hfiber_dim :
      ringKrullDim
          ((S ⧸ J) ⧸
            Ideal.map (algebraMap (R ⧸ I) (S ⧸ J)) (maximalIdeal (R ⧸ I))) =
