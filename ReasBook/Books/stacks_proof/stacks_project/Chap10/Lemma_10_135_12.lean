/-- Helper for Lemma 10.135.12: the same minimal-generator count expressed as the dimension of
`J / 𝔪J`. -/
lemma ideal_modmax_finrank_eq_of_dim_span_eq
    {A : Type*} [CommRing A] [IsRegularLocalRing A] (J : Ideal A) (hJ_ne_top : J ≠ ⊤)
    {c : ℕ} (hdim : ringKrullDim (A ⧸ J) + c = ringKrullDim A)
    (x : Fin c → A) (hx : Ideal.span (Set.range x) = J) :
    Module.finrank (A ⧸ maximalIdeal A)
      (J ⧸ maximalIdeal A • (⊤ : Submodule A J)) = c := by
  have hspan :=
    ideal_spanFinrank_eq_of_dim_span_eq (A := A) J hJ_ne_top hdim x hx
  have hfg : J.FG := Ideal.fg_of_isNoetherianRing J
  exact
    ((IsLocalRing.spanFinrank_eq_finrank_quotient (R := A) (M := A) J hfg).symm).trans
      hspan

