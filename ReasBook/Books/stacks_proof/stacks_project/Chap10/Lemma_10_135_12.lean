/-- Helper for Lemma 10.135.12: if `S ⧸ K` is flat over `R` and
`J = K + GS`, then `S ⧸ J` is flat over `R ⧸ G`. -/
lemma quotientMap_flat_of_flat_quotient_sup_map
    (G : Ideal R) (K J : Ideal S)
    (hJ_eq : J = K ⊔ Ideal.map (algebraMap R S) G)
    (hflat : Module.Flat R (S ⧸ K))
    (hGJ : G ≤ Ideal.comap (algebraMap R S) J) :
    let qGJ : R ⧸ G →+* S ⧸ J := Ideal.quotientMap J (algebraMap R S) hGJ
    letI : Algebra (R ⧸ G) (S ⧸ J) := qGJ.toAlgebra
    Module.Flat (R ⧸ G) (S ⧸ J) := by
  intro qGJ
  letI : Algebra (R ⧸ G) (S ⧸ J) := qGJ.toAlgebra
  letI : Module.Flat R (S ⧸ K) := hflat
  have hK_le_J : K ≤ J := by
    rw [hJ_eq]
    exact le_sup_left
  have hmap_eq :
      Ideal.map (Ideal.Quotient.mk K) J =
        Ideal.map (algebraMap R (S ⧸ K)) G := by
    calc
      Ideal.map (Ideal.Quotient.mk K) J =
          Ideal.map (Ideal.Quotient.mk K) (K ⊔ Ideal.map (algebraMap R S) G) := by
            rw [hJ_eq]
      _ = Ideal.map (Ideal.Quotient.mk K) K ⊔
            Ideal.map (Ideal.Quotient.mk K) (Ideal.map (algebraMap R S) G) := by
            rw [Ideal.map_sup]
      _ = ⊥ ⊔ Ideal.map ((Ideal.Quotient.mk K).comp (algebraMap R S)) G := by
            rw [Ideal.map_quotient_self, Ideal.map_map]
      _ = Ideal.map (algebraMap R (S ⧸ K)) G := by
            rw [bot_sup_eq]
            apply congrArg (fun f : R →+* S ⧸ K => Ideal.map f G)
            ext r
            rfl
  let eRing : ((S ⧸ K) ⧸ Ideal.map (algebraMap R (S ⧸ K)) G) ≃+* S ⧸ J :=
    (Ideal.quotEquivOfEq hmap_eq.symm).trans (DoubleQuot.quotQuotEquivQuotOfLE hK_le_J)
  let eAlg : ((S ⧸ K) ⧸ Ideal.map (algebraMap R (S ⧸ K)) G) ≃ₐ[R ⧸ G] S ⧸ J :=
    AlgEquiv.ofRingEquiv (f := eRing) (by
      intro x
      obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
      dsimp [eRing]
      change (DoubleQuot.quotQuotEquivQuotOfLE hK_le_J)
          (DoubleQuot.quotQuotMk K J (algebraMap R S r)) =
        Ideal.Quotient.mk J (algebraMap R S r)
      rw [DoubleQuot.quotQuotEquivQuotOfLE_quotQuotMk])
  let eTensor :
      ((S ⧸ K) ⧸ Ideal.map (algebraMap R (S ⧸ K)) G) ≃ₐ[R ⧸ G]
        TensorProduct R (R ⧸ G) (S ⧸ K) :=
    Algebra.TensorProduct.quotIdealMapEquivQuotTensor (S ⧸ K) G
  have hflatTensor : Module.Flat (R ⧸ G) (TensorProduct R (R ⧸ G) (S ⧸ K)) :=
    Module.Flat.baseChange R (R ⧸ G) (S ⧸ K)
  let eLin : (S ⧸ J) ≃ₗ[R ⧸ G] TensorProduct R (R ⧸ G) (S ⧸ K) :=
    (eAlg.symm.trans eTensor).toLinearEquiv
  exact Module.Flat.of_linearEquiv eLin

/-- Helper for Lemma 10.135.12: the closed fiber of `R ⧸ I → S ⧸ J` is the quotient of the
original closed fiber by the image of `J`. -/
lemma quotient_closedFiber_ringKrullDim_eq
    (I : Ideal R) (J : Ideal S) (hIJ : I ≤ Ideal.comap (algebraMap R S) J)
    [IsLocalRing (R ⧸ I)] :
    let qAB : R ⧸ I →+* S ⧸ J := Ideal.quotientMap J (algebraMap R S) hIJ
    letI : Algebra (R ⧸ I) (S ⧸ J) := qAB.toAlgebra
    ringKrullDim
        ((S ⧸ J) ⧸
          Ideal.map (algebraMap (R ⧸ I) (S ⧸ J)) (maximalIdeal (R ⧸ I))) =
      ringKrullDim (ClosedFiber ⧸ Ideal.map (algebraMap S ClosedFiber) J) := by
  intro qAB
  letI : Algebra (R ⧸ I) (S ⧸ J) := qAB.toAlgebra
  let mS : Ideal S := Ideal.map (algebraMap R S) (maximalIdeal R)
  let mAmap : Ideal (S ⧸ J) :=
    Ideal.map (algebraMap (R ⧸ I) (S ⧸ J)) (maximalIdeal (R ⧸ I))
  have hmax_quot :
      maximalIdeal (R ⧸ I) = Ideal.map (Ideal.Quotient.mk I) (maximalIdeal R) := by
    symm
    exact IsLocalRing.map_maximalIdeal_of_surjective
      (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have hmAmap : mAmap = Ideal.map (Ideal.Quotient.mk J) mS := by
    dsimp [mAmap, mS]
    rw [hmax_quot, Ideal.map_map, Ideal.map_map]
    change
      Ideal.map (qAB.comp (Ideal.Quotient.mk I)) (maximalIdeal R) =
        Ideal.map ((Ideal.Quotient.mk J).comp (algebraMap R S)) (maximalIdeal R)
    rw [Ideal.quotientMap_comp_mk]
  let eLeft : ((S ⧸ J) ⧸ mAmap) ≃+* S ⧸ J ⊔ mS :=
    (Ideal.quotEquivOfEq hmAmap).trans (DoubleQuot.quotQuotEquivQuotSup J mS)
  let eSup : S ⧸ J ⊔ mS ≃+* S ⧸ mS ⊔ J :=
    Ideal.quotEquivOfEq (sup_comm J mS)
  let eRightSup : ((S ⧸ mS) ⧸ Ideal.map (Ideal.Quotient.mk mS) J) ≃+* S ⧸ mS ⊔ J :=
    DoubleQuot.quotQuotEquivQuotSup mS J
  let eCF : S ⧸ mS ≃+* ClosedFiber :=
    (closedFiber_quotient_equiv (R := R) (S := S)).toRingEquiv
  have hJbar_eq :
      Ideal.map (algebraMap S ClosedFiber) J =
        Ideal.map eCF.toRingHom (Ideal.map (Ideal.Quotient.mk mS) J) := by
    symm
    rw [Ideal.map_map]
    apply congrArg (fun f : S →+* ClosedFiber => Ideal.map f J)
    ext s
    exact closedFiber_quotient_equiv_mk (R := R) (S := S) s
  let eRight : ((S ⧸ mS) ⧸ Ideal.map (Ideal.Quotient.mk mS) J) ≃+*
      ClosedFiber ⧸ Ideal.map (algebraMap S ClosedFiber) J :=
    Ideal.quotientEquiv (Ideal.map (Ideal.Quotient.mk mS) J)
      (Ideal.map (algebraMap S ClosedFiber) J) eCF hJbar_eq
  let e : ((S ⧸ J) ⧸ mAmap) ≃+*
      ClosedFiber ⧸ Ideal.map (algebraMap S ClosedFiber) J :=
    ((eLeft.trans eSup).trans eRightSup.symm).trans eRight
  exact ringKrullDim_eq_of_ringEquiv e

