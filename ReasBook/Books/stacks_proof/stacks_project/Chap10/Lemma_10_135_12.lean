/-- Helper for Lemma 10.135.12: a map induced on quotients is injective when the source
submodule is exactly the comap of the target submodule. -/
lemma Submodule.mapQ_injective_of_comap_le
    {A M N : Type*} [Ring A] [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N]
    (p : Submodule A M) (q : Submodule A N) (f : M →ₗ[A] N)
    (hpq : p ≤ Submodule.comap f q) (hqp : Submodule.comap f q ≤ p) :
    Function.Injective (Submodule.mapQ (p := p) (q := q) (f := f) (h := hpq)) := by
  rw [← LinearMap.ker_eq_bot]
  ext z
  constructor
  · intro hz
    obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective p z
    rw [Submodule.mem_bot]
    change Submodule.Quotient.mk x = 0
    rw [Submodule.Quotient.mk_eq_zero]
    apply hqp
    change f x ∈ q
    rw [LinearMap.mem_ker] at hz
    simpa using hz
  · intro hz
    rw [Submodule.mem_bot] at hz
    rw [LinearMap.mem_ker, hz]
    exact map_zero (Submodule.mapQ (p := p) (q := q) (f := f) (h := hpq))

