/-- Helper for Lemma 10.135.12: the elementary dimension cancellation used at the end of the
source proof. -/
lemma withBot_dimension_cancel_sub_nat
    {a b c : WithBot ℕ∞} (D m n : ℕ)
    (hmain : (a + b) + (m : WithBot ℕ∞) = c + (D : WithBot ℕ∞))
    (hb : b + (n : WithBot ℕ∞) = (D : WithBot ℕ∞))
    (hnm : n ≤ m) :
    a + ((m - n : ℕ) : WithBot ℕ∞) = c := by
  cases b with
  | bot =>
      simp at hb
  | coe e =>
      cases e with
      | top =>
          exfalso
          have htop : (⊤ : ℕ∞) = (D : ℕ∞) := by
            apply WithBot.coe_eq_coe.mp
            simpa [WithBot.coe_add] using hb
          exact ENat.coe_ne_top D htop.symm
      | coe k =>
          have hcast : ((n + (m - n) : ℕ) : WithBot ℕ∞) = (m : WithBot ℕ∞) := by
            rw [Nat.add_sub_of_le hnm]
          have hkn :
              (((k : ℕ∞) : WithBot ℕ∞) + (n : WithBot ℕ∞)) =
                ((k + n : ℕ) : WithBot ℕ∞) := by
            change (((k : ℕ∞) : WithBot ℕ∞) + ((n : ℕ∞) : WithBot ℕ∞)) =
              (((k + n : ℕ) : ℕ∞) : WithBot ℕ∞)
            exact congrArg some (ENat.coe_add k n)
          have hD_eq : (D : WithBot ℕ∞) = ((k + n : ℕ) : WithBot ℕ∞) :=
            hb.symm.trans hkn
          have h1 :
              (a + ((m - n : ℕ) : WithBot ℕ∞)) + ((k + n : ℕ) : WithBot ℕ∞) =
                c + ((k + n : ℕ) : WithBot ℕ∞) := by
            calc
              (a + ((m - n : ℕ) : WithBot ℕ∞)) + ((k + n : ℕ) : WithBot ℕ∞) =
                  (a + ((k : ℕ∞) : WithBot ℕ∞)) +
                    ((n + (m - n) : ℕ) : WithBot ℕ∞) := by
                    rw [← hkn]
                    simp [Nat.cast_add, add_assoc, add_left_comm, add_comm]
              _ = (a + ((k : ℕ∞) : WithBot ℕ∞)) + (m : WithBot ℕ∞) := by
                    rw [hcast]
              _ = c + (D : WithBot ℕ∞) := hmain
              _ = c + ((k + n : ℕ) : WithBot ℕ∞) := by
                    rw [hD_eq]
          exact ENat.WithBot.add_natCast_cancel.mp h1

