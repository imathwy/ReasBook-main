universe u

open MvPolynomial RingTheory.Sequence

section

variable (k : Type u) [CommRing k] [Nontrivial k]

/-
Domain triage:
* primary domain: regular sequences in commutative polynomial rings;
* sampled owner API: `RingTheory.Sequence.IsRegular`,
  `RingTheory.Sequence.isRegular_cons_iff`,
  `RingTheory.Sequence.isRegular_in_ideal_iff`,
  `IsLocalRing.isRegular_of_perm`;
* core/canonical owner: `RingTheory.Sequence.IsRegular A rs`;
* primitive vs derived split: the primitive data are the ring `k[x, y, z]` and the two explicit
  lists `[x, y * (1 - x), z * (1 - x)]` and `[y * (1 - x), z * (1 - x), x]`; the example theorem
  is the derived source-facing comparison of their regularity behavior;
* layer classification for this file: `source-facing`.
-/

local notation "A" => MvPolynomial (Fin 3) k
local notation "x" => (X (0 : Fin 3) : A)
local notation "y" => (X (1 : Fin 3) : A)
local notation "z" => (X (2 : Fin 3) : A)

/-- Helper for Chap10 Example 10 68 2: multiplication by congruent scalars is regular on the
same quotient module. -/
private lemma isSMulRegular_quotient_congr_of_sub_mem {R : Type*} [CommRing R]
    (N : Submodule R R) {a b : R} (hab : a - b ∈ N)
    (hb : IsSMulRegular (R ⧸ N) b) :
    IsSMulRegular (R ⧸ N) a := by
  -- Reduce regularity on a quotient to the membership criterion for killed elements.
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem] at hb ⊢
  intro m hm
  apply hb
  have hdiff : (a - b) * m ∈ N := by
    simpa [mul_comm] using N.smul_mem m hab
  have ham : a * m ∈ N := by
    simpa [smul_eq_mul] using hm
  have hidentity : b * m = a * m - (a - b) * m := by
    ring
  -- Subtract the congruence error to convert `a * m ∈ N` into `b * m ∈ N`.
  simpa [smul_eq_mul, hidentity] using N.sub_mem ham hdiff

omit [Nontrivial k] in
/-- Helper for Chap10 Example 10 68 2: a fresh coordinate variable is regular modulo the ideal
generated by the other listed variables. -/
private lemma variable_isSMulRegular_quotient_variableSpan {s : Set (Fin 3)} {i : Fin 3}
    (hi : i ∉ s) :
    IsSMulRegular (A ⧸ (Ideal.span (MvPolynomial.X '' s : Set A) •
      (⊤ : Submodule A A))) (X i : A) := by
  -- Use the support characterization of membership in an ideal generated by variables.
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  rw [Ideal.smul_eq_mul, Ideal.mul_top] at hp ⊢
  rw [MvPolynomial.mem_ideal_span_X_image] at hp ⊢
  intro m hm
  have hmem : Finsupp.single i 1 + m ∈ (X i * p).support := by
    rw [MvPolynomial.support_X_mul]
    exact Finset.mem_map.mpr ⟨m, hm, rfl⟩
  rcases hp _ hmem with ⟨j, hjs, hj⟩
  refine ⟨j, hjs, ?_⟩
  have hji : j ≠ i := by
    intro h
    exact hi (h ▸ hjs)
  -- The fresh variable contributes the only new exponent, so divisibility comes from `p`.
  simpa [Finsupp.single_eq_of_ne hji] using hj

omit [Nontrivial k] in
/-- Helper for Chap10 Example 10 68 2: the second prefix ideal is the variable ideal `(x, y)`. -/
private lemma prefixIdeal_x_y_mul_oneSubX_eq_variableSpan :
    Ideal.ofList [x, y * (1 - x)] =
      Ideal.span (MvPolynomial.X '' ({0, 1} : Set (Fin 3)) : Set A) := by
  let I : Ideal A := Ideal.span (MvPolynomial.X '' ({0, 1} : Set (Fin 3)) : Set A)
  apply le_antisymm
  · -- The source generators are built from `x` and `y`.
    rw [Ideal.ofList_le_iff]
    intro r hr
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl
    · have hzero_mem : (0 : Fin 3) ∈ ({0, 1} : Set (Fin 3)) := by
        simp
      exact Ideal.subset_span ⟨0, hzero_mem, rfl⟩
    · have hone_mem : (1 : Fin 3) ∈ ({0, 1} : Set (Fin 3)) := by
        simp
      have hy : y ∈ I := Ideal.subset_span ⟨1, hone_mem, rfl⟩
      exact I.mul_mem_right (1 - x) hy
  · -- Conversely recover `y` from `y * (1 - x)` by adding the multiple `y * x`.
    rw [Ideal.span_le]
    rintro r ⟨i, hi, rfl⟩
    fin_cases i
    · have hx_list : x ∈ [x, y * (1 - x)] := by
        simp
      exact Ideal.subset_span hx_list
    · have hyx : y * x ∈ Ideal.ofList [x, y * (1 - x)] := by
        have hx_list : x ∈ [x, y * (1 - x)] := by
          simp
        exact (Ideal.ofList [x, y * (1 - x)]).mul_mem_left y
          (Ideal.subset_span hx_list)
      have hterm : y * (1 - x) ∈ Ideal.ofList [x, y * (1 - x)] := by
        have hterm_list : y * (1 - x) ∈ [x, y * (1 - x)] := by
          simp
        exact Ideal.subset_span hterm_list
      have hsum : y * (1 - x) + y * x ∈ Ideal.ofList [x, y * (1 - x)] :=
        (Ideal.ofList [x, y * (1 - x)]).add_mem hterm hyx
      have hidentity : y * (1 - x) + y * x = y := by
        ring
      simpa [hidentity] using hsum
    · simp at hi

/-- Helper for Chap10 Example 10 68 2: the ideal generated by the positive sequence is proper. -/
private lemma example10682_fullIdeal_ne_top :
    Ideal.ofList [x, y * (1 - x), z * (1 - x)] ≠ ⊤ := by
  let ev0 : A →+* k := (MvPolynomial.aeval fun _ : Fin 3 => (0 : k)).toRingHom
  -- Evaluation at the origin kills all three generators, so the ideal lies in a proper kernel.
  have hle : Ideal.ofList [x, y * (1 - x), z * (1 - x)] ≤ RingHom.ker ev0 := by
    rw [Ideal.ofList_le_iff]
    intro r hr
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl
    · simp [ev0]
    · simp [ev0]
    · simp [ev0]
  intro htop
  have hone : (1 : A) ∈ RingHom.ker ev0 := by
    apply hle
    rw [htop]
    exact Submodule.mem_top
  simpa [ev0] using hone

/-- Helper for Chap10 Example 10 68 2: the class of `y` is not in the span of `y * (1 - x)`. -/
private lemma y_not_mem_span_y_mul_oneSubX :
    y ∉ (⊤ : Submodule A A).map (LinearMap.lsmul A A (y * (1 - x))) := by
  rintro ⟨p, _hp, hpy⟩
  let evXOne : A →+* A :=
    (MvPolynomial.aeval fun i : Fin 3 => if i = 0 then (1 : A) else X i).toRingHom
  -- Evaluating at `x = 1` kills the right-hand side but leaves `y` unchanged.
  have hmap := congrArg evXOne hpy.symm
  have hzero : evXOne y = 0 := by
    simpa [evXOne, LinearMap.lsmul_apply, smul_eq_mul] using hmap
  have hy_ne_zero : (X (1 : Fin 3) : A) ≠ 0 := MvPolynomial.X_ne_zero _
  have hy_eq_zero : (X (1 : Fin 3) : A) = 0 := by
    simpa [evXOne] using hzero
  exact hy_ne_zero hy_eq_zero

/-- Helper for Chap10 Example 10 68 2: after quotienting by `y * (1 - x)`, multiplication by
`z * (1 - x)` has the nonzero class of `y` in its kernel. -/
private lemma z_mul_oneSubX_not_isSMulRegular_mod_y_mul_oneSubX :
    ¬ IsSMulRegular (QuotSMulTop (y * (1 - x)) A) (z * (1 - x)) := by
  intro hreg
  let qy : QuotSMulTop (y * (1 - x)) A := Submodule.Quotient.mk y
  -- The product `z * (1 - x) * y` is a multiple of the quotient generator.
  have hkill : (z * (1 - x)) • qy = 0 := by
    rw [← Submodule.Quotient.mk_smul]
    rw [Submodule.Quotient.mk_eq_zero]
    rw [Submodule.pointwise_smul_def]
    refine ⟨z, Submodule.mem_top, ?_⟩
    simp [smul_eq_mul]
    ring
  have hzero : qy = 0 := hreg.right_eq_zero_of_smul hkill
  dsimp [qy] at hzero
  rw [Ideal.Quotient.eq_zero_iff_mem] at hzero
  have hy_mem_map : y ∈ (⊤ : Submodule A A).map (LinearMap.lsmul A A (y * (1 - x))) := by
    simpa [Submodule.pointwise_smul_def, LinearMap.lsmul_eq_distribSMultoLinearMap] using hzero
  exact y_not_mem_span_y_mul_oneSubX k hy_mem_map

omit [Nontrivial k] in
/-- Helper for Chap10 Example 10 68 2: `x` is regular modulo the empty prefix. -/
private lemma x_isSMulRegular_mod_emptyPrefix :
    IsSMulRegular (A ⧸ (Ideal.ofList ([] : List A) • (⊤ : Submodule A A))) x := by
  have hzero_not_mem : (0 : Fin 3) ∉ (∅ : Set (Fin 3)) := by
    simp
  have hx := variable_isSMulRegular_quotient_variableSpan (k := k)
    (s := (∅ : Set (Fin 3))) (i := 0) hzero_not_mem
  -- Identify the empty prefix ideal with the variable ideal generated by the empty set.
  have hempty : Ideal.span (MvPolynomial.X '' (∅ : Set (Fin 3)) : Set A) =
      Ideal.ofList [] := by
    simp
  rw [← hempty]
  exact hx

omit [Nontrivial k] in
/-- Helper for Chap10 Example 10 68 2: `y * (1 - x)` is regular modulo the prefix `(x)`. -/
private lemma y_mul_oneSubX_isSMulRegular_mod_xPrefix :
    IsSMulRegular (A ⧸ (Ideal.ofList [x] • (⊤ : Submodule A A))) (y * (1 - x)) := by
  have hy_variable : IsSMulRegular (A ⧸ (Ideal.ofList [x] • (⊤ : Submodule A A))) y := by
    have hone_not_mem : (1 : Fin 3) ∉ ({0} : Set (Fin 3)) := by
      simp
    have hy := variable_isSMulRegular_quotient_variableSpan (k := k)
      (s := ({0} : Set (Fin 3))) (i := 1) hone_not_mem
    -- Rewrite the singleton prefix ideal as the ideal generated by the coordinate `x`.
    have hsingle : Ideal.span (MvPolynomial.X '' ({0} : Set (Fin 3)) : Set A) =
        Ideal.ofList [x] := by
      simp
    rw [← hsingle]
    exact hy
  have hy_sub : y * (1 - x) - y ∈ Ideal.ofList [x] • (⊤ : Submodule A A) := by
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
    have hx_list : x ∈ [x] := by
      simp
    have hx_mem : x ∈ Ideal.ofList [x] := Ideal.subset_span hx_list
    have hmul : -y * x ∈ Ideal.ofList [x] :=
      (Ideal.ofList [x]).mul_mem_left (-y) hx_mem
    have hidentity : y * (1 - x) - y = -y * x := by
      ring
    simpa [hidentity] using hmul
  -- The two scalars differ by a multiple of `x`, so they act identically on the quotient.
  exact isSMulRegular_quotient_congr_of_sub_mem
    (Ideal.ofList [x] • (⊤ : Submodule A A)) hy_sub hy_variable

omit [Nontrivial k] in
/-- Helper for Chap10 Example 10 68 2: `z * (1 - x)` is regular modulo the prefix
`(x, y * (1 - x))`. -/
private lemma z_mul_oneSubX_isSMulRegular_mod_xyPrefix :
    IsSMulRegular (A ⧸ (Ideal.ofList [x, y * (1 - x)] • (⊤ : Submodule A A)))
      (z * (1 - x)) := by
  have hz_variable : IsSMulRegular
      (A ⧸ (Ideal.ofList [x, y * (1 - x)] • (⊤ : Submodule A A))) z := by
    have htwo_not_mem : (2 : Fin 3) ∉ ({0, 1} : Set (Fin 3)) := by
      simp
    have hz := variable_isSMulRegular_quotient_variableSpan (k := k)
      (s := ({0, 1} : Set (Fin 3))) (i := 2) htwo_not_mem
    -- Normalize the source prefix to the coordinate-variable ideal `(x, y)`.
    rw [prefixIdeal_x_y_mul_oneSubX_eq_variableSpan (k := k)]
    exact hz
  have hz_sub :
      z * (1 - x) - z ∈ Ideal.ofList [x, y * (1 - x)] •
        (⊤ : Submodule A A) := by
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
    have hx_list : x ∈ [x, y * (1 - x)] := by
      simp
    have hx_mem : x ∈ Ideal.ofList [x, y * (1 - x)] := Ideal.subset_span hx_list
    have hmul : -z * x ∈ Ideal.ofList [x, y * (1 - x)] :=
      (Ideal.ofList [x, y * (1 - x)]).mul_mem_left (-z) hx_mem
    have hidentity : z * (1 - x) - z = -z * x := by
      ring
    simpa [hidentity] using hmul
  -- Again the scalar is congruent to the fresh coordinate variable modulo the prefix ideal.
  exact isSMulRegular_quotient_congr_of_sub_mem
    (Ideal.ofList [x, y * (1 - x)] • (⊤ : Submodule A A)) hz_sub hz_variable

omit [Nontrivial k] in
/-- Helper for Chap10 Example 10 68 2: the positive sequence is weakly regular. -/
private lemma example10682_isWeaklyRegular :
    IsWeaklyRegular A [x, y * (1 - x), z * (1 - x)] := by
  rw [isWeaklyRegular_iff_Fin]
  intro i
  -- The three finite-index cases are exactly the three prefix-regularity lemmas above.
  fin_cases i
  · simpa using x_isSMulRegular_mod_emptyPrefix k
  · simpa using y_mul_oneSubX_isSMulRegular_mod_xPrefix k
  · simpa using z_mul_oneSubX_isSMulRegular_mod_xyPrefix k

-- Proof sketch: use the inductive characterization of regular sequences in
-- `isRegular_cons_iff`. First `x` is a non-zero-divisor in the polynomial ring
-- over a nontrivial commutative ring, and then the images of `y * (1 - x)` and
-- `z * (1 - x)` remain non-zero-divisors after quotienting successively by the
-- preceding elements.
private theorem example10682_isRegular :
    IsRegular A [x, y * (1 - x), z * (1 - x)] := by
  constructor
  · -- Weak regularity has already been reduced to the three explicit prefix quotients.
    exact example10682_isWeaklyRegular k
  · -- The final quotient is nonzero because the generated ideal is proper.
    intro htop
    rw [Ideal.smul_eq_mul, Ideal.mul_top] at htop
    exact example10682_fullIdeal_ne_top k htop.symm

-- Proof sketch: after quotienting by `y * (1 - x)`, the class of `z * (1 - x)`
-- becomes a zero-divisor, so the reordered list fails the inductive criterion
-- for regularity.
private theorem example10682_reordered_not_regular :
    ¬ IsRegular A [y * (1 - x), z * (1 - x), x] := by
  intro h
  -- Peel off the first two terms and contradict the explicit zero-divisor witness above.
  rcases (isRegular_cons_iff (M := A) (y * (1 - x)) [z * (1 - x), x]).1 h with
    ⟨_, htail⟩
  rcases (isRegular_cons_iff (M := QuotSMulTop (y * (1 - x)) A) (z * (1 - x)) [x]).1
      htail with
    ⟨hzreg, _⟩
  exact z_mul_oneSubX_not_isSMulRegular_mod_y_mul_oneSubX k hzreg

/-- Chap10 Example 10 68 2 (Stacks, Tag `00LG`): in the polynomial ring `k[x, y, z]`,
the sequence `x, y(1 - x), z(1 - x)` is regular, but the reordered sequence
`y(1 - x), z(1 - x), x` is not. -/
@[stacks 00LG]
theorem example10682_regularSequence_and_reordered_not_regular :
    IsRegular A [x, y * (1 - x), z * (1 - x)] ∧
      ¬ IsRegular A [y * (1 - x), z * (1 - x), x] :=
  ⟨example10682_isRegular k, example10682_reordered_not_regular k⟩

end
