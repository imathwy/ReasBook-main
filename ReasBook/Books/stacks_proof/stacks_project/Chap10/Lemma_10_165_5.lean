/-- Helper for Chap10 Lemma 10 165 5: under normality after tensoring with every field, each
prime localization of `A ⊗[k] C` is a domain when `C` is an integrally closed domain. -/
lemma tensorProduct_atPrime_isDomain_of_allFieldTensorNormal
    (hfield : ∀ (K : Type w) [Field K] [Algebra k K], IsNormalRing (A ⊗[k] K))
    {C : Type w} [CommRing C] [Algebra k C] [IsDomain C] [IsIntegrallyClosed C]
    (P : PrimeSpectrum (A ⊗[k] C)) :
    IsDomain (Localization.AtPrime P.asIdeal) := by
  -- Prove the domain structure from the zero-product criterion, leaving only the finite
  -- obstruction descent as the source-facing missing ingredient.
  have hNoZeroDivisors : NoZeroDivisors (Localization.AtPrime P.asIdeal) := by
    refine ⟨fun {x} {y} hxy ↦ ?_⟩
    by_cases hx : x = 0
    · exact Or.inl hx
    by_cases hy : y = 0
    · exact Or.inr hy
    obtain ⟨K, hK, hAlgK, Q, xK, yK, hxyK, hxK, hyK⟩ :=
      exists_fieldTensorAtPrime_zeroProduct_obstruction (A := A) hfield P hxy hx hy
    letI : Field K := hK
    letI : Algebra k K := hAlgK
    letI : IsNormalRing (A ⊗[k] K) := hfield K
    have hDomainK : IsDomain (Localization.AtPrime Q.asIdeal) :=
      isDomain_localizationAtPrime Q
    have hNoZeroDivisorsK : NoZeroDivisors (Localization.AtPrime Q.asIdeal) :=
      @IsDomain.to_noZeroDivisors (Localization.AtPrime Q.asIdeal) _ hDomainK
    -- The descended nonzero zero-product contradicts the normal field tensor product.
    rcases (@mul_eq_zero (Localization.AtPrime Q.asIdeal) _ hNoZeroDivisorsK xK yK).mp hxyK with
      hxK0 | hyK0
    · exact False.elim (hxK hxK0)
    · exact False.elim (hyK hyK0)
  letI : NoZeroDivisors (Localization.AtPrime P.asIdeal) := hNoZeroDivisors
  -- A prime localization is nontrivial, so the zero-divisor criterion upgrades to `IsDomain`.
  exact NoZeroDivisors.to_isDomain (Localization.AtPrime P.asIdeal)

/-- Helper for Chap10 Lemma 10 165 5: once the fixed-prime domain descent is available, a
zero-product obstruction in that prime localization has a zero factor. -/
lemma zeroProduct_vanishes_in_tensorProduct_atPrime_of_allFieldTensorNormal
    (hfield : ∀ (K : Type w) [Field K] [Algebra k K], IsNormalRing (A ⊗[k] K))
    {C : Type w} [CommRing C] [Algebra k C] [IsDomain C] [IsIntegrallyClosed C]
    (P : PrimeSpectrum (A ⊗[k] C)) {x y : Localization.AtPrime P.asIdeal}
    (hxy : x * y = 0) :
    x = 0 ∨ y = 0 := by
  -- The unresolved finite descent frontier is isolated in the local domain helper; after that,
  -- the requested zero-product criterion is just the domain zero-divisor axiom.
  have hDomainP : IsDomain (Localization.AtPrime P.asIdeal) :=
    tensorProduct_atPrime_isDomain_of_allFieldTensorNormal (A := A) hfield P
  have hNoZeroDivisorsP : NoZeroDivisors (Localization.AtPrime P.asIdeal) :=
    @IsDomain.to_noZeroDivisors (Localization.AtPrime P.asIdeal) _ hDomainP
  exact (@mul_eq_zero (Localization.AtPrime P.asIdeal) _ hNoZeroDivisorsP x y).mp hxy

/-- Helper for Chap10 Lemma 10 165 5: under normality after tensoring with every field, each
prime localization of `A ⊗[k] C` is integrally closed when `C` is an integrally closed domain. -/
lemma tensorProduct_atPrime_isIntegrallyClosed_of_allFieldTensorNormal
    (hfield : ∀ (K : Type w) [Field K] [Algebra k K], IsNormalRing (A ⊗[k] K))
    {C : Type w} [CommRing C] [Algebra k C] [IsDomain C] [IsIntegrallyClosed C]
    (P : PrimeSpectrum (A ⊗[k] C)) :
    IsIntegrallyClosed (Localization.AtPrime P.asIdeal) := by
  -- The same canonical normality instance for `A ⊗[k] C` gives the integral-closed half of every
  -- prime localization only after the main theorem is known. Before that theorem, the remaining
  -- source step is finite monic-relation descent through the same residue-field tensor bridge.
  -- TODO: collect the polynomial coefficients and fraction representative at a finite stage,
  -- descend nonmembership in the localized tensor product to a residue-field prime, and contradict
  -- the integrally closed localization supplied by `hfield`.
  sorry

/-- Helper for Chap10 Lemma 10 165 5: at a local domain already known integrally closed,
integral elements of its fraction ring come from the local ring. -/
lemma integralElement_mem_fractionRing_of_isIntegrallyClosed
    {Rₚ : Type*} [CommRing Rₚ] [IsDomain Rₚ] [IsIntegrallyClosed Rₚ]
    (x : FractionRing Rₚ) (hx : IsIntegral Rₚ x) :
    ∃ y : Rₚ, algebraMap Rₚ (FractionRing Rₚ) y = x := by
  -- This records the final owner-API consumption of the fixed-prime integral-closure descent.
  exact IsIntegrallyClosed.isIntegral_iff.mp hx

/-- Helper for Chap10 Lemma 10 165 5: the two fixed-prime local statements assemble into the
normality pair required by the chapter definition of `IsNormalRing`. -/
lemma tensorProduct_localNormality_of_allFieldTensorNormal
    (hfield : ∀ (K : Type w) [Field K] [Algebra k K], IsNormalRing (A ⊗[k] K))
    {C : Type w} [CommRing C] [Algebra k C] [IsDomain C] [IsIntegrallyClosed C]
    (P : PrimeSpectrum (A ⊗[k] C)) :
    IsDomain (Localization.AtPrime P.asIdeal) ∧
      IsIntegrallyClosed (Localization.AtPrime P.asIdeal) := by
  -- Prove the two local normality components separately so later repair can focus on the first
  -- failing fixed-prime obstruction instead of one large conjunction.
  refine
    ⟨tensorProduct_atPrime_isDomain_of_allFieldTensorNormal (A := A) hfield P,
      tensorProduct_atPrime_isIntegrallyClosed_of_allFieldTensorNormal (A := A) hfield P⟩

/-- Helper for Chap10 Lemma 10 165 5: the remaining source step is prime-local normality of
`A ⊗[k] C` when `C` is an integrally closed domain. -/
lemma tensorProduct_localNormality_of_isGeometricallyNormal_integrallyClosedDomain
    {C : Type w} [CommRing C] [Algebra k C] [IsDomain C] [IsIntegrallyClosed C]
    (P : PrimeSpectrum (A ⊗[k] C)) :
    IsDomain (Localization.AtPrime P.asIdeal) ∧
      IsIntegrallyClosed (Localization.AtPrime P.asIdeal) := by
  -- Route correction: directly applying geometric normality to `FractionRing C` fails when
  -- `C : Type w`, because the owner definition only quantifies fields in `Type (max u v)`.
  -- The proved field bridges above handle small and essentially finite type residue fields; the
  -- remaining task is to collect the finite local obstruction at `P`, descend it to a noetherian
  -- finite-type envelope with small residue fields, and transport the local normality back.
  -- The monolithic frontier is reduced to the explicit all-field tensor-normality bridge plus the
  -- two fixed-prime local lemmas above.
  exact
    tensorProduct_localNormality_of_allFieldTensorNormal (A := A)
      (fun K _ _ ↦
        isNormalRing_tensorProduct_fieldRight_anyField_of_isGeometricallyNormal (A := A) K)
      P

/-- Helper for Chap10 Lemma 10 165 5: the source proof reduces tensor-normality to the case where
the second factor is an integrally closed domain. -/
lemma tensorProduct_normal_of_isGeometricallyNormal_integrallyClosedDomain
    {C : Type w} [CommRing C] [Algebra k C] [IsDomain C] [IsIntegrallyClosed C] :
    IsNormalRing (A ⊗[k] C) := by
  -- Assemble global normality from the prime-local normality frontier.
  exact
    ⟨fun P ↦
      tensorProduct_localNormality_of_isGeometricallyNormal_integrallyClosedDomain (A := A) P⟩

/-- Helper for Chap10 Lemma 10 165 5: normality of the tensor product can be checked after
localizing the normal base at the contraction of each prime. -/
lemma tensorProduct_atPrime_normal_pair
    (P : PrimeSpectrum (A ⊗[k] B)) :
    IsDomain (Localization.AtPrime P.asIdeal) ∧
      IsIntegrallyClosed (Localization.AtPrime P.asIdeal) := by
  -- The remaining source step is to compare this localization with a prime localization of
  -- `A ⊗[k] Localization.AtPrime q.asIdeal`, where `q` is the contraction of `P` to `B`.
  let T := A ⊗[k] B
  letI : Algebra B (A ⊗[k] B) := Algebra.TensorProduct.rightAlgebra
  let q : PrimeSpectrum B := PrimeSpectrum.comap (algebraMap B (A ⊗[k] B)) P
  have hqDomain : IsDomain (Localization.AtPrime q.asIdeal) := isDomain_localizationAtPrime q
  have hqIntegrallyClosed : IsIntegrallyClosed (Localization.AtPrime q.asIdeal) :=
    isIntegrallyClosed_localizationAtPrime q
  letI : IsDomain (Localization.AtPrime q.asIdeal) := hqDomain
  letI : IsIntegrallyClosed (Localization.AtPrime q.asIdeal) := hqIntegrallyClosed
  let U := A ⊗[k] Localization.AtPrime q.asIdeal
  have hLocalizedBaseNormal : IsNormalRing U :=
    tensorProduct_normal_of_isGeometricallyNormal_integrallyClosedDomain
      (A := A) (C := Localization.AtPrime q.asIdeal)
  let D := T ⊗[B] Localization.AtPrime q.asIdeal
  letI : CommRing D := inferInstance
  letI : Algebra T D := Algebra.TensorProduct.leftAlgebra
  letI : Algebra (Localization.AtPrime q.asIdeal) D := Algebra.TensorProduct.rightAlgebra
  letI : IsLocalization (Algebra.algebraMapSubmonoid T q.asIdeal.primeCompl) D := by
    infer_instance
  let e : D ≃ₐ[A] U :=
    Algebra.IsPushout.cancelBaseChangeAlg k A B T (Localization.AtPrime q.asIdeal)
  have hD : IsNormalRing D := by
    letI : IsNormalRing U := hLocalizedBaseNormal
    exact isNormalRing_of_equiv e.symm.toRingEquiv
  letI : IsNormalRing D := hD
  have hdisj :
      Disjoint
          ((Algebra.algebraMapSubmonoid T q.asIdeal.primeCompl : Submonoid T) : Set T)
          P.asIdeal := by
    refine Set.disjoint_left.mpr ?_
    intro x hxM hxP
    rcases hxM with ⟨b, hb, rfl⟩
    exact hb (by simpa [q, T, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap] using hxP)
  have hPrange : P ∈ Set.range (PrimeSpectrum.comap (algebraMap T D)) := by
    rwa [PrimeSpectrum.localization_comap_range D
      (Algebra.algebraMapSubmonoid T q.asIdeal.primeCompl)]
  rcases hPrange with ⟨PD, hPD_comap⟩
  have hPD_asIdeal :
      Ideal.comap (algebraMap T D) PD.asIdeal = P.asIdeal := by
    simpa [PrimeSpectrum.comap_asIdeal] using congrArg PrimeSpectrum.asIdeal hPD_comap
  letI : IsLocalization.AtPrime (Localization.AtPrime PD.asIdeal) P.asIdeal := by
    simpa [hPD_asIdeal] using
      (IsLocalization.isLocalization_isLocalization_atPrime_isLocalization
        (Algebra.algebraMapSubmonoid T q.asIdeal.primeCompl)
        (Localization.AtPrime PD.asIdeal) PD.asIdeal)
  let eLoc : Localization.AtPrime P.asIdeal ≃ₐ[T] Localization.AtPrime PD.asIdeal :=
    IsLocalization.algEquiv P.asIdeal.primeCompl (Localization.AtPrime P.asIdeal)
      (Localization.AtPrime PD.asIdeal)
  -- Transport the normal-domain local data back along the canonical localization equivalence.
  exact
    ⟨Function.Injective.isDomain eLoc.toRingHom eLoc.injective,
      (isIntegrallyClosed_localizationAtPrime PD).of_equiv eLoc.toRingEquiv.symm⟩

/-- Lemma 10.165.5: if `A` is geometrically normal over the field `k` and `B` is a normal
`k`-algebra, then `A ⊗[k] B` is a normal ring. -/
-- Proof sketch: localize at a prime of `A ⊗[k] B` and reduce to the case where both factors are
-- domains. Approximate `B` by finite type normal `k`-subalgebras, reduce by filtered colimits to
-- finite type, and then embed the tensor product into the intersections `Frac(A) ⊗[k] B` and
-- `A ⊗[k] Frac(B)`. The geometric normality of `A` makes the first overring normal after passing
-- through finitely generated subextensions of `Frac(A)`, so integral elements over `A ⊗[k] B`
-- already lie in the tensor product itself.
@[stacks 06DF, instance]
theorem isNormalRing_tensorProduct_of_isGeometricallyNormal :
    IsNormalRing (A ⊗[k] B) := by
  -- Assemble the normal-ring predicate from the prime-local comparison helper.
  exact ⟨fun P ↦ tensorProduct_atPrime_normal_pair (A := A) (B := B) P⟩

end
