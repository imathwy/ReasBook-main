import stacks_proof.stacks_project.Chap10.Lemma_10_37_17
import stacks_proof.stacks_project.Chap10.Lemma_10_165_1

-- Declarations for this item will be appended below by the statement pipeline.

open scoped TensorProduct
open Algebra

universe u v w x

/-
Domain triage:
- `source-facing`: normality of the tensor product with one geometrically normal factor.
- `core/canonical`: the owner abstraction is `Algebra.IsGeometricallyNormal`.
- `bridge/view`: the tensor-product normality statement is derived API yielding an
  `IsNormalRing` instance; there is no extra wrapper object.

Sampled declarations in this domain:
- `Algebra.IsGeometricallyNormal` from `Definition_10_165_2`,
- `isReduced_tensorProduct_of_geometricallyReduced` from `Lemma_10_43_5`,
- `IsGeometricallyNormal.of_isLocalization` from `Lemma_10_165_3`.

Primitive data are only the field `k`, the two `k`-algebras `A` and `B`, and the hypotheses
`[IsGeometricallyNormal k A]` and `[IsNormalRing B]`. Normality of `A ⊗[k] B` is derived API and
should not be duplicated by a parallel local instance wrapper.
-/
section

variable {k : Type u} {A : Type v} {B : Type w}
variable [Field k] [CommRing A] [CommRing B] [Algebra k A] [Algebra k B]
variable [IsGeometricallyNormal k A] [IsNormalRing B]

/-- Helper for Chap10 Lemma 10 165 5: geometric normality gives normality after base change to
the field universe used by the owner definition. -/
lemma isNormalRing_baseChange_field_of_isGeometricallyNormal
    (K : Type (max u v)) [Field K] [Algebra k K] :
    IsNormalRing (K ⊗[k] A) := by
  -- This is exactly the base-change field in `IsGeometricallyNormal`.
  exact IsGeometricallyNormal.isNormalRing_baseChange (k := k) (R := A) K

/-- Helper for Chap10 Lemma 10 165 5: the right tensor product with an owner-universe field
extension is normal after commuting the tensor factors. -/
lemma isNormalRing_tensorProduct_fieldRight_of_isGeometricallyNormal
    (K : Type (max u v)) [Field K] [Algebra k K] :
    IsNormalRing (A ⊗[k] K) := by
  -- First use geometric normality in the owner orientation `K ⊗[k] A`.
  have hLeft : IsNormalRing (K ⊗[k] A) :=
    isNormalRing_baseChange_field_of_isGeometricallyNormal (A := A) K
  -- Then commute the tensor factors and transport the normal-ring predicate.
  let e : K ⊗[k] A ≃ₐ[k] A ⊗[k] K := Algebra.TensorProduct.comm k K A
  letI : IsNormalRing (K ⊗[k] A) := hLeft
  exact isNormalRing_of_equiv e.toRingEquiv

/-- Helper for Chap10 Lemma 10 165 5: field tensor-normality transports from a small field model
back to the original field. -/
lemma isNormalRing_tensorProduct_fieldRight_small_of_isGeometricallyNormal
    (K : Type w) [Field K] [Algebra k K] [Small.{max u v} K] :
    IsNormalRing (A ⊗[k] K) := by
  -- First prove normality after shrinking `K` into the owner universe of geometric normality.
  have hShrink : IsNormalRing (A ⊗[k] Shrink.{max u v} K) :=
    isNormalRing_tensorProduct_fieldRight_of_isGeometricallyNormal
      (A := A) (Shrink.{max u v} K)
  -- Then transport the result back across the tensor product of the shrink equivalence.
  let eShrink : A ⊗[k] Shrink.{max u v} K ≃+* A ⊗[k] K :=
    (Algebra.TensorProduct.congr (AlgEquiv.refl : A ≃ₐ[k] A)
      (Shrink.algEquiv k K)).toRingEquiv
  letI : IsNormalRing (A ⊗[k] Shrink.{max u v} K) := hShrink
  exact isNormalRing_of_equiv eShrink

/-- Helper for Chap10 Lemma 10 165 5: an essentially finite type algebra over a small base has
small carrier in the same universe. -/
private theorem essFiniteType_small_of_smallBase {R : Type u} {S : Type w}
    [CommRing R] [CommRing S] [Algebra R S] [Small.{x} R]
    [Algebra.EssFiniteType R S] :
    Small.{x} S := by
  let S₀ := Algebra.EssFiniteType.subalgebra R S
  let M₀ := Algebra.EssFiniteType.submonoid R S
  have hsmallS₀ : Small.{x} S₀ := by
    letI : Algebra.FiniteType R S₀ := inferInstance
    -- A finite-type algebra is a quotient of a finite polynomial algebra over the small base.
    rcases (Algebra.FiniteType.iff_quotient_mvPolynomial'' (R := R) (S := S₀)).mp
        (inferInstance : Algebra.FiniteType R S₀) with
      ⟨n, π, hπ⟩
    exact small_of_surjective hπ
  letI : Small.{x} S₀ := hsmallS₀
  have hsmallLoc : Small.{x} (Localization M₀) := by
    -- The localization is generated by the standard fraction constructor from a small type.
    exact small_of_surjective Localization.mkHom_surjective
  letI : Small.{x} (Localization M₀) := hsmallLoc
  let eLoc : Localization M₀ ≃+* S :=
    (IsLocalization.algEquiv M₀ (Localization M₀) S).toRingEquiv
  -- Transport smallness across the canonical essential-finite-type localization equivalence.
  exact small_map eLoc.symm.toEquiv

/-- Helper for Chap10 Lemma 10 165 5: essentially finite type field extensions are small enough
to use the owner-universe field bridge. -/
lemma isNormalRing_tensorProduct_fieldRight_essFiniteType_of_isGeometricallyNormal
    (K : Type w) [Field K] [Algebra k K] [Algebra.EssFiniteType k K] :
    IsNormalRing (A ⊗[k] K) := by
  -- The base field is small in the owner universe, hence so is an essentially finite type field.
  have hsmallk : Small.{max u v} k := small_lift.{u, v, u} k
  letI : Small.{max u v} k := hsmallk
  have hsmallK : Small.{max u v} K :=
    essFiniteType_small_of_smallBase (R := k) (S := K)
  letI : Small.{max u v} K := hsmallK
  -- The small-field bridge now gives the desired tensor-normality statement.
  exact isNormalRing_tensorProduct_fieldRight_small_of_isGeometricallyNormal (A := A) K

/-- Helper for Chap10 Lemma 10 165 5: tensor-normality extends from essentially finite type
field extensions to arbitrary field extensions by filtered colimit descent. -/
lemma isNormalRing_tensorProduct_fieldRight_anyField_of_isGeometricallyNormal
    (K : Type w) [Field K] [Algebra k K] :
    IsNormalRing (A ⊗[k] K) := by
  -- Route correction: the owner definition only tests fields in `Type (max u v)`, and the
  -- essentially finite type bridge above only handles small fields. Instead of rebuilding the
  -- colimit argument here, use the earlier finite-purely-inseparable test theorem in a universe
  -- large enough for `K`; its finite tests are small, so the owner-universe bridge applies. The
  -- algebra `A` is first moved to that larger universe by `ULift`.
  let ALift := ULift.{max v w, v} A
  let eA : ALift ≃ₐ[k] A := ULift.algEquiv (R := k) (A := A)
  have hfinite :
      ∀ (L : Type (max u (max v w))) [Field L] [Algebra k L] [FiniteDimensional k L]
        [IsPurelyInseparable k L], IsNormalRing (L ⊗[k] ALift) := by
    intro L _ _ _ _
    -- A finite-dimensional field over the small base field is small in the owner universe.
    have hsmallk : Small.{max u v} k := small_lift.{u, v, u} k
    letI : Small.{max u v} k := hsmallk
    have hsmallL : Small.{max u v} L := Module.Finite.small (R := k) (M := L)
    letI : Small.{max u v} L := hsmallL
    -- Prove normality in the right-tensor orientation, then commute the two factors.
    have hRight : IsNormalRing (A ⊗[k] L) :=
      isNormalRing_tensorProduct_fieldRight_small_of_isGeometricallyNormal (A := A) L
    let e : A ⊗[k] L ≃ₐ[k] L ⊗[k] A := Algebra.TensorProduct.comm k A L
    letI : IsNormalRing (A ⊗[k] L) := hRight
    have hLeft : IsNormalRing (L ⊗[k] A) := isNormalRing_of_equiv e.toRingEquiv
    let eLiftA : L ⊗[k] A ≃+* L ⊗[k] ALift :=
      (Algebra.TensorProduct.congr (AlgEquiv.refl : L ≃ₐ[k] L) eA.symm).toRingEquiv
    letI : IsNormalRing (L ⊗[k] A) := hLeft
    exact isNormalRing_of_equiv eLiftA
  have hall :
      ∀ (L : Type (max u (max v w))) [Field L] [Algebra k L],
        IsNormalRing (L ⊗[k] ALift) :=
    (forall_isNormalRing_tensorProduct_iff_finitePurelyInseparable.{u, max v w}
      (k := k) (A := ALift)).2 hfinite
  let KLift := ULift.{max u (max v w), w} K
  let eK : KLift ≃ₐ[k] K := ULift.algEquiv (R := k) (A := K)
  have hLeftLift : IsNormalRing (KLift ⊗[k] ALift) := hall KLift
  have hRightLift : IsNormalRing (ALift ⊗[k] KLift) := by
    -- Commute the lifted field tensor back to the orientation used by this helper.
    let e : KLift ⊗[k] ALift ≃ₐ[k] ALift ⊗[k] KLift :=
      Algebra.TensorProduct.comm k KLift ALift
    letI : IsNormalRing (KLift ⊗[k] ALift) := hLeftLift
    exact isNormalRing_of_equiv e.toRingEquiv
  let eLift : ALift ⊗[k] KLift ≃+* A ⊗[k] K :=
    (Algebra.TensorProduct.congr eA eK).toRingEquiv
  letI : IsNormalRing (ALift ⊗[k] KLift) := hRightLift
  -- Finally descend from the lifted copies of both tensor factors.
  exact isNormalRing_of_equiv eLift

/-- Helper for Chap10 Lemma 10 165 5: the right factor acts on `A ⊗[k] D` through the canonical
right tensor-product algebra structure. -/
local instance tensorProductRightAlgebraForFiber
    {D : Type w} [CommRing D] [Algebra k D] : Algebra D (A ⊗[k] D) :=
  Algebra.TensorProduct.rightAlgebra

/-- Helper for Chap10 Lemma 10 165 5: the canonical right action on `A ⊗[k] D` is compatible
with the base field action. -/
local instance tensorProductRightScalarTowerForFiber
    {D : Type w} [CommRing D] [Algebra k D] :
    IsScalarTower k D (A ⊗[k] D) :=
  Algebra.TensorProduct.right_isScalarTower

/-- Helper for Chap10 Lemma 10 165 5: all-field tensor normality gives normality on every
right-base residue fiber `q.asIdeal.Fiber (A ⊗[k] D)`. -/
lemma tensorProduct_fiberAtRight_isNormalRing_of_allFieldTensorNormal
    (hfield : ∀ (K : Type w) [Field K] [Algebra k K], IsNormalRing (A ⊗[k] K))
    {D : Type w} [CommRing D] [Algebra k D] (q : PrimeSpectrum D) :
    IsNormalRing (q.asIdeal.Fiber (A ⊗[k] D)) := by
  -- Move to the residue field of the right-base prime; the fiber API identifies this with the
  -- corresponding tensor product over `k`.
  let K := q.asIdeal.ResidueField
  letI : Field K := inferInstance
  letI : Algebra k K := inferInstance
  have hTensorNormal : IsNormalRing (A ⊗[k] K) := hfield K
  letI : IsNormalRing (A ⊗[k] K) := hTensorNormal
  -- Commute the fiber tensor factors, then cancel the base-change presentation of `A ⊗[k] D`.
  let eComm : q.asIdeal.Fiber (A ⊗[k] D) ≃+* (A ⊗[k] D) ⊗[D] K :=
    (Algebra.TensorProduct.comm D K (A ⊗[k] D)).toRingEquiv
  let eCancel : (A ⊗[k] D) ⊗[D] K ≃+* A ⊗[k] K :=
    (Algebra.IsPushout.cancelBaseChangeAlg k A D (A ⊗[k] D) K).toRingEquiv
  -- Transport normality back from the field tensor product to the residue fiber.
  exact isNormalRing_of_equiv (eComm.trans eCancel).symm

/-- Helper for Chap10 Lemma 10 165 5: the tensor map induced by a right subalgebra contracts a
prime ideal to the prime used for the source localization. -/
private lemma tensorProductSubalgebraMap_contractedPrime_asIdeal
    {C : Type w} [CommRing C] [Algebra k C]
    (D : Subalgebra k C) (P : PrimeSpectrum (A ⊗[k] C)) :
    (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom P).asIdeal =
      Ideal.comap (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom P.asIdeal := by
  -- The contracted point in `PrimeSpectrum` stores exactly the comap ideal.
  simp [PrimeSpectrum.comap_asIdeal]

/-- Helper for Chap10 Lemma 10 165 5: a denominator outside the contracted tensor prime maps to a
denominator outside the target tensor prime. -/
private lemma tensorProductSubalgebraMap_mem_primeCompl
    {C : Type w} [CommRing C] [Algebra k C]
    (D : Subalgebra k C) (P : PrimeSpectrum (A ⊗[k] C))
    (s : (PrimeSpectrum.comap
      (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom P).asIdeal.primeCompl) :
    ((Algebra.TensorProduct.map (AlgHom.id k A) D.val) s.1) ∈ P.asIdeal.primeCompl := by
  -- Unfold membership in the contracted ideal and negate it.
  intro hs
  have hcontracted : s.1 ∈
      (PrimeSpectrum.comap
        (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom P).asIdeal := by
    simpa [tensorProductSubalgebraMap_contractedPrime_asIdeal (A := A) D P,
      Ideal.mem_comap] using hs
  exact s.2 hcontracted

/-- Helper for Chap10 Lemma 10 165 5: the canonical map from a finite right-subalgebra tensor
localization to the ambient tensor localization. -/
private noncomputable abbrev localizedTensor_atPrime_map_of_subalgebra
    {C : Type w} [CommRing C] [Algebra k C]
    (D : Subalgebra k C) (P : PrimeSpectrum (A ⊗[k] C)) :
    Localization.AtPrime
        (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom P).asIdeal →+*
      Localization.AtPrime P.asIdeal :=
  Localization.localRingHom
    (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom P).asIdeal
    P.asIdeal
    (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom
    (tensorProductSubalgebraMap_contractedPrime_asIdeal (A := A) D P)

/-- Helper for Chap10 Lemma 10 165 5: the finite-stage localization map sends a fraction to the
corresponding ambient fraction. -/
private lemma localizedTensor_atPrime_map_of_subalgebra_mk'
    {C : Type w} [CommRing C] [Algebra k C]
    (D : Subalgebra k C) (P : PrimeSpectrum (A ⊗[k] C))
    (r : A ⊗[k] D)
    (s : (PrimeSpectrum.comap
      (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom P).asIdeal.primeCompl) :
    localizedTensor_atPrime_map_of_subalgebra (A := A) D P
      (IsLocalization.mk'
        (Localization.AtPrime
          (PrimeSpectrum.comap (Algebra.TensorProduct.map (AlgHom.id k A) D.val).toRingHom P).asIdeal)
        r s) =
      IsLocalization.mk'
        (Localization.AtPrime P.asIdeal)
        ((Algebra.TensorProduct.map (AlgHom.id k A) D.val) r)
        ⟨(Algebra.TensorProduct.map (AlgHom.id k A) D.val) s.1,
          tensorProductSubalgebraMap_mem_primeCompl (A := A) D P s⟩ := by
  -- The owner computation for `Localization.localRingHom` gives the numerator and denominator
  -- images; only proof-irrelevance for the denominator subtype remains.
  rw [localizedTensor_atPrime_map_of_subalgebra, Localization.localRingHom_mk']
  congr 1

/-- Helper for Chap10 Lemma 10 165 5: a prime-localized fraction is nonzero exactly when no
allowed denominator kills its numerator. -/
private lemma atPrime_mk'_ne_zero_iff_no_denominator_mul_eq_zero
    {R : Type*} [CommSemiring R] (P : Ideal R) [P.IsPrime]
    (r : R) (s : P.primeCompl) :
    IsLocalization.mk' (Localization.AtPrime P) r s ≠ 0 ↔
      ∀ t : P.primeCompl, t.1 * r ≠ 0 := by
  -- Convert nonvanishing of a localized fraction into the standard `mk'` zero criterion.
  rw [ne_eq, IsLocalization.mk'_eq_zero_iff]
  simp only [not_exists]

/-- Helper for Chap10 Lemma 10 165 5: if the annihilator of a numerator lies in the prime, then
the numerator defines a nonzero element of the prime localization. -/
private lemma atPrime_mk'_ne_zero_of_annihilator_le
    {R : Type*} [CommRing R] {P : Ideal R} [P.IsPrime]
    {a : R} (s : P.primeCompl)
    (hann : Module.annihilator R (R ∙ a : Submodule R R) ≤ P) :
    IsLocalization.mk' (Localization.AtPrime P) a s ≠ 0 := by
  -- Use the nonzero criterion and send any would-be killing denominator into the annihilator.
  rw [atPrime_mk'_ne_zero_iff_no_denominator_mul_eq_zero]
  intro t ht
  exact t.2 (hann (by
    rw [Module.mem_annihilator]
    intro y
    ext
    rcases Submodule.mem_span_singleton.mp y.2 with ⟨r, hy⟩
    change t.1 * y.1 = 0
    rw [← hy]
    change t.1 * (r * a) = 0
    calc
      t.1 * (r * a) = r * (t.1 * a) := by ring
      _ = 0 := by rw [ht, mul_zero]))

/-- Helper for Chap10 Lemma 10 165 5: a denominator killing a product makes the corresponding
localized product vanish at any prime avoiding that denominator. -/
private lemma atPrime_mk'_mul_eq_zero_of_denominator_mul_eq_zero
    {R : Type*} [CommRing R] {P : Ideal R} [P.IsPrime]
    {a b z : R} (s t : P.primeCompl) (hz : z ∈ P.primeCompl)
    (hab : z * a * b = 0) :
    IsLocalization.mk' (Localization.AtPrime P) a s *
        IsLocalization.mk' (Localization.AtPrime P) b t = 0 := by
  -- Multiply the two fractions first, then apply the standard localized zero criterion.
  rw [← IsLocalization.mk'_mul]
  rw [IsLocalization.mk'_eq_zero_iff]
  refine ⟨⟨z, hz⟩, ?_⟩
  simpa [mul_assoc] using hab

/-- Helper for Chap10 Lemma 10 165 5: membership in a colon of two principal ideals is the
corresponding multiplication membership statement. -/
private lemma mem_colon_principal_iff_mul_mem
    {R : Type*} [CommRing R] (a b c : R) :
    a ∈ (Ideal.span ({b} : Set R)).colon (Ideal.span ({c} : Set R)) ↔
      a * c ∈ Ideal.span ({b} : Set R) := by
  -- Normalize the colon side-condition to the pointwise multiplication form used for prime
  -- separation in the integral-obstruction branch.
  rw [Ideal.mem_colon_span_singleton]

/-- Helper for Chap10 Lemma 10 165 5: an ideal contained in a prime is disjoint from the powers
of an element outside that prime. -/
private lemma disjoint_ideal_powers_of_le_prime_notMem
    {R : Type*} [CommRing R] {I P : Ideal R} [P.IsPrime] {z : R}
    (hIP : I ≤ P) (hz : z ∉ P) :
    Disjoint ((I : Set R)) (Submonoid.powers z : Set R) := by
  -- Any element in the intersection gives a power of `z` in the prime, hence `z` itself lies in
  -- the prime, contradicting the chosen denominator condition.
  refine Set.disjoint_left.mpr ?_
  intro x hxI hxpow
  obtain ⟨n, rfl⟩ := hxpow
  exact hz ((inferInstance : P.IsPrime).mem_of_pow_mem n (hIP hxI))

/-- Helper for Chap10 Lemma 10 165 5: prime separation for an ideal disjoint from the powers of
a chosen denominator. -/
private lemma exists_prime_over_sup_disjoint_powers
    {R : Type*} [CommRing R] (I J : Ideal R) (z : R)
    (hdisj : Disjoint (((I ⊔ J : Ideal R) : Set R)) (Submonoid.powers z : Set R)) :
    ∃ Q : PrimeSpectrum R, I ≤ Q.asIdeal ∧ J ≤ Q.asIdeal ∧ z ∉ Q.asIdeal := by
  -- Separate the ideal from the denominator submonoid by a prime ideal.
  obtain ⟨p, hp, hle, hdisjQ⟩ :=
    Ideal.exists_le_prime_disjoint (I := I ⊔ J) (Submonoid.powers z) hdisj
  refine ⟨⟨p, hp⟩, ?_, ?_, ?_⟩
  · exact le_sup_left.trans hle
  · exact le_sup_right.trans hle
  · intro hzQ
    exact Set.disjoint_left.mp hdisjQ hzQ (Submonoid.mem_powers z)

/-- Helper for Chap10 Lemma 10 165 5: a prime can be chosen to contain two numerator
annihilators while avoiding a fixed denominator power system. -/
private lemma exists_stagePrime_preserving_zeroProductByAnnihilators
    {R : Type*} [CommRing R] (a b z : R)
    (hdisj : Disjoint
      ((((Module.annihilator R (R ∙ a : Submodule R R)) ⊔
        (Module.annihilator R (R ∙ b : Submodule R R)) : Ideal R) : Set R))
      (Submonoid.powers z : Set R)) :
    ∃ Q : PrimeSpectrum R,
      Module.annihilator R (R ∙ a : Submodule R R) ≤ Q.asIdeal ∧
      Module.annihilator R (R ∙ b : Submodule R R) ≤ Q.asIdeal ∧
      z ∉ Q.asIdeal := by
  -- Apply the generic prime-separation lemma to the two annihilator ideals.
  exact
    exists_prime_over_sup_disjoint_powers
      (Module.annihilator R (R ∙ a : Submodule R R))
      (Module.annihilator R (R ∙ b : Submodule R R)) z hdisj

/-- Helper for Chap10 Lemma 10 165 5: under normality after tensoring with every field, each
nonzero zero-product in a fixed prime localization descends to a nonzero zero-product in a
prime localization of a field tensor product. -/
lemma exists_fieldTensorAtPrime_zeroProduct_obstruction
    (hfield : ∀ (K : Type w) [Field K] [Algebra k K], IsNormalRing (A ⊗[k] K))
    {C : Type w} [CommRing C] [Algebra k C] [IsDomain C] [IsIntegrallyClosed C]
    (P : PrimeSpectrum (A ⊗[k] C)) {x y : Localization.AtPrime P.asIdeal}
