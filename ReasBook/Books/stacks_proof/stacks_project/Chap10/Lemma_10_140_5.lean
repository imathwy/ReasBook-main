/-- Helper for Chap10 Lemma 10 140 5: the canonical algebra structure on the localized
presentation is compatible with the base-field algebra maps. -/
private theorem localizedPolynomialPresentation_isScalarTower
    {n : ℕ} (π : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : Ideal S) [q.IsPrime] :
    let P := Localization.AtPrime (Ideal.comap π.toRingHom q)
    let A := Localization.AtPrime q
    let φq : P →+* A := Localization.localRingHom
      (Ideal.comap π.toRingHom q) q π.toRingHom rfl
    letI : Algebra P A := φq.toAlgebra
    IsScalarTower k P A := by
  -- Proof comment: reduce the scalar-tower condition to the pointwise compatibility of the
  -- localized presentation with the two `k`-algebra structures.
  dsimp only
  let φq : Localization.AtPrime (Ideal.comap π.toRingHom q) →+* Localization.AtPrime q :=
    Localization.localRingHom (Ideal.comap π.toRingHom q) q π.toRingHom rfl
  letI : Algebra (Localization.AtPrime (Ideal.comap π.toRingHom q))
      (Localization.AtPrime q) := φq.toAlgebra
  exact IsScalarTower.of_algebraMap_eq fun r ↦ by
    exact (localizedPolynomialPresentation_toAlgHom_commutes (π := π) q r).symm

