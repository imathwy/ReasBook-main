/-- Helper for Chap10 Lemma 10 140 5: a regular local ring hypothesis on `S_q` gives the
cotangent-space dimension formula in the prime-owner spelling used by the main theorem. -/
private theorem regularLocalRing_finrank_cotangentSpace_eq_ringKrullDim_atPrime
    (q : Ideal S) [q.IsPrime] (hregular : IsRegularLocalRing (Localization.AtPrime q)) :
    Module.finrank q.ResidueField
        (IsLocalRing.CotangentSpace (Localization.AtPrime q)) =
      ringKrullDim (Localization.AtPrime q) := by
  -- Proof comment: install the regular-local hypothesis and reuse the generic regular-local
  -- cotangent-space characterization without unfolding the prime localization.
  letI : IsRegularLocalRing (Localization.AtPrime q) := hregular
  exact regularLocalRing_finrank_cotangentSpace_eq_ringKrullDim (Localization.AtPrime q)

