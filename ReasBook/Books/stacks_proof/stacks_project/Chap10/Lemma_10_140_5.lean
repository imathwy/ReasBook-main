/-- Helper for Chap10 Lemma 10 140 5: localizing a surjective polynomial presentation at `q`
keeps the induced map of local rings surjective. -/
private theorem localizedPolynomialPresentation_localRingHom_surjective
    {n : ℕ} (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : Ideal S) [q.IsPrime] :
    Function.Surjective
      (Localization.localRingHom
        (Ideal.comap π.toRingHom q) q π.toRingHom rfl) := by
  -- Proof comment: write a target element as a fraction in `S_q`, lift numerator and denominator
  -- through `π`, and rebuild the corresponding fraction in the source localization.
  intro y
  rcases IsLocalization.exists_mk'_eq q.primeCompl y with ⟨a, s, rfl⟩
  rcases hπ a with ⟨x, rfl⟩
  rcases hπ s with ⟨t, ht⟩
  let t' : (Ideal.comap π.toRingHom q).primeCompl := ⟨t, by
    intro htmem
    exact s.2 (by
      change π.toRingHom t ∈ q at htmem
      simpa [ht] using htmem)⟩
  refine
    ⟨IsLocalization.mk'
      (Localization.AtPrime (Ideal.comap π.toRingHom q)) x t', ?_⟩
  rw [Localization.localRingHom_mk']
  have hs_eq :
      (⟨π.toRingHom t, by
        exact Localization.le_comap_primeCompl_iff.mpr
          (ge_of_eq
            (rfl : Ideal.comap π.toRingHom q = q.comap π.toRingHom))
            t'.2⟩ :
        q.primeCompl) = s := by
    exact Subtype.ext ht
  rw [hs_eq]
  rfl

