/-- Helper for Chap10 Lemma 10 140 5: a surjective polynomial presentation maps the
prime-complement over `q` onto the prime-complement of `q`. -/
private theorem localizedPolynomialPresentation_primeCompl_map_eq
    {n : ℕ} (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : Ideal S) [q.IsPrime] :
    Submonoid.map π.toRingHom (Ideal.comap π.toRingHom q).primeCompl = q.primeCompl := by
  -- Proof comment: lift each denominator of `S` through the surjective polynomial presentation,
  -- while the forward direction is just contraction along `π`.
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact hx
  · intro hy
    rcases hπ y with ⟨x, rfl⟩
    exact ⟨x, hy, rfl⟩

