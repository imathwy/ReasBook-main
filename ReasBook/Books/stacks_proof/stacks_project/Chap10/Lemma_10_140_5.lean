/-- Helper for Chap10 Lemma 10 140 5: a regular local ring has cotangent-space dimension equal
to its Krull dimension. -/
private theorem regularLocalRing_finrank_cotangentSpace_eq_ringKrullDim
    (R : Type*) [CommRing R] [IsRegularLocalRing R] :
    Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) =
      ringKrullDim R := by
  -- Proof comment: unpack the canonical regular-local characterization by cotangent dimension.
  exact (IsRegularLocalRing.iff_finrank_cotangentSpace (R := R)).mp inferInstance

