/-- Helper for Chap10 Lemma 10 140 5: the kernel of the localized presentation is the
localization of the original presentation kernel. -/
private theorem localizedPolynomialPresentation_ker_localRingHom_eq
    {n : ℕ} (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : Ideal S) [q.IsPrime] :
    RingHom.ker
        (Localization.localRingHom
          (Ideal.comap π.toRingHom q) q π.toRingHom rfl) =
      Ideal.map
        (algebraMap (MvPolynomial (Fin n) k)
          (Localization.AtPrime (Ideal.comap π.toRingHom q)))
        (RingHom.ker π.toRingHom) := by
  -- Proof comment: after matching denominator submonoids, `IsLocalization.ker_map` gives the
  -- kernel of the localized morphism in the required owner spelling.
  simpa [Localization.localRingHom] using
    (IsLocalization.ker_map
      (S := Localization.AtPrime (Ideal.comap π.toRingHom q))
      (Q := Localization.AtPrime q)
      (g := π.toRingHom)
      (localizedPolynomialPresentation_primeCompl_map_eq (π := π) hπ q))

