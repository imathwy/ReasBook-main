/-- Helper for Chap10 Lemma 10 140 5: the identity map has kernel generated by the empty regular
sequence. -/
private theorem ringHom_id_kernelIsGeneratedByRegularSequence
    (A : Type*) [CommRing A] [Nontrivial A] :
    (RingHom.id A).KernelIsGeneratedByRegularSequence := by
  -- Proof comment: the identity kernel is `⊥`, generated by the empty regular sequence.
  refine ⟨[], ?_, ?_⟩
  · simpa using (RingTheory.Sequence.IsRegular.nil A A)
  · rw [Ideal.ofList_nil]
    exact ((RingHom.injective_iff_ker_eq_bot (RingHom.id A)).mp Function.injective_id).symm

/-- Helper for Chap10 Lemma 10 140 5: the quotient by the kernel of a surjection onto a regular
local ring is regular local. -/
private theorem surjectiveLocalHom_quotientKer_isRegularLocalRing
    {P A : Type*} [CommRing P] [CommRing A] [IsRegularLocalRing A]
    (φ : P →+* A) (hφ : Function.Surjective φ) :
    IsRegularLocalRing (P ⧸ RingHom.ker φ) := by
  -- Proof comment: the quotient-by-kernel ring equivalence transports regular-locality from the
  -- target back to the quotient owner.
  let e : P ⧸ RingHom.ker φ ≃+* A := RingHom.quotientKerEquivOfSurjective hφ
  exact IsRegularLocalRing.of_ringEquiv e.symm

/-- Helper for Chap10 Lemma 10 140 5: a finite list built from a `Fin`-indexed family generates
the same ideal as the range of the family. -/
private theorem ideal_ofList_ofFn_eq_span_range_forRegularKernel {R : Type*} [CommRing R] {c : ℕ}
    (xs : Fin c → R) :
    Ideal.ofList (List.ofFn xs) = Ideal.span (Set.range xs) := by
  -- Proof comment: compare the two generating sets elementwise through `List.mem_ofFn`.
  rw [Ideal.ofList]
  congr
  ext x
  constructor
  · intro hx
    rcases List.mem_ofFn.mp hx with ⟨i, rfl⟩
    exact ⟨i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact List.mem_ofFn.mpr ⟨i, rfl⟩

/-- Helper for Chap10 Lemma 10 140 5: a surjective local homomorphism between regular local
rings has kernel generated by a regular sequence. -/
private theorem surjectiveLocalHom_kernelIsGeneratedByRegularSequence_of_regularLocal
    {P A : Type*} [CommRing P] [CommRing A]
    [IsRegularLocalRing P] [IsRegularLocalRing A]
    (φ : P →+* A) [IsLocalHom φ] (hφ : Function.Surjective φ) :
    φ.KernelIsGeneratedByRegularSequence := by
  -- Proof comment: this is the acyclic form of the Lemma 10.135.6 TFAE specialized to
  -- `P --φ--> A --id--> A`; the identity kernel clause is already proved above.
  have hquot : IsRegularLocalRing (P ⧸ RingHom.ker φ) :=
    surjectiveLocalHom_quotientKer_isRegularLocalRing φ hφ
  let _ := hquot
  -- TODO: the direct parameter-prefix proof needs the earlier theorem
  -- `exists_regularSystemOfParameters_with_prefix_span_eq_of_quotient_isRegularLocalRing`, but
  -- importing its owner currently rebuilds broken prefix files. Extract that theorem to an
  -- acyclic support module or repair the prefix rebuild, then use the quotient-by-kernel route.
  sorry

/-- Helper for Chap10 Lemma 10 140 5: the residue-field separability hypothesis at `q`
supplies the injective conormal map for the local ring `S_q`. -/
private theorem residueCotangentToKaehler_injective_atPrime_of_isSeparableOver
    (q : Ideal S) [q.IsPrime] [IsSeparableOver k q.ResidueField] :
    Function.Injective
      (KaehlerDifferential.kerCotangentToTensor k (Localization.AtPrime q) q.ResidueField) := by
  -- Proof comment: `q.ResidueField` is the residue field of `Localization.AtPrime q`, so
  -- Lemma 10.140.4 applies directly to the localized local ring.
  exact residueCotangentToKaehler_injective_of_isSeparableOver k (Localization.AtPrime q)

