/-- Helper for Chap10 Lemma 10 140 5: the localized polynomial presentation commutes with the
base-field algebra maps. -/
private theorem localizedPolynomialPresentation_toAlgHom_commutes
    {n : ℕ} (π : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : Ideal S) [q.IsPrime] (r : k) :
    Localization.localRingHom
        (Ideal.comap π.toRingHom q) q π.toRingHom rfl
        (algebraMap k (Localization.AtPrime (Ideal.comap π.toRingHom q)) r) =
      algebraMap k (Localization.AtPrime q) r := by
  -- Proof comment: compare both scalar maps after passing through the polynomial algebra and the
  -- localization map.
  calc
    Localization.localRingHom
        (Ideal.comap π.toRingHom q) q π.toRingHom rfl
        (algebraMap k (Localization.AtPrime (Ideal.comap π.toRingHom q)) r) =
        Localization.localRingHom
          (Ideal.comap π.toRingHom q) q π.toRingHom rfl
          (algebraMap (MvPolynomial (Fin n) k)
            (Localization.AtPrime (Ideal.comap π.toRingHom q))
            (algebraMap k (MvPolynomial (Fin n) k) r)) := by
      rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin n) k)
        (Localization.AtPrime (Ideal.comap π.toRingHom q))]
    _ = algebraMap S (Localization.AtPrime q)
          (π.toRingHom (algebraMap k (MvPolynomial (Fin n) k) r)) := by
      rw [Localization.localRingHom_to_map]
    _ = algebraMap S (Localization.AtPrime q) (algebraMap k S r) := by
      exact congrArg (algebraMap S (Localization.AtPrime q)) (π.commutes r)
    _ = algebraMap k (Localization.AtPrime q) r := by
      rw [← IsScalarTower.algebraMap_apply k S (Localization.AtPrime q)]

