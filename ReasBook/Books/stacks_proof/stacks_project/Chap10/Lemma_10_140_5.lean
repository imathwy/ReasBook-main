/-- Helper for Chap10 Lemma 10 140 5: the localized polynomial presentation has kernel generated
by a regular sequence once the target local ring is regular. -/
private theorem localizedPolynomialPresentation_kernelIsGeneratedByRegularSequence
    {n : ℕ} (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : Ideal S) [q.IsPrime]
    (hregular : IsRegularLocalRing (Localization.AtPrime q)) :
    (Localization.localRingHom
      (Ideal.comap π.toRingHom q) q π.toRingHom rfl).KernelIsGeneratedByRegularSequence := by
  -- Route correction: avoid the complete-intersection TFAE route and use the regular-local
  -- surjection theorem from Lemma 10.135.6 for the localized presentation map.
  letI : IsRegularLocalRing (Localization.AtPrime q) := hregular
  let φq : Localization.AtPrime (Ideal.comap π.toRingHom q) →+* Localization.AtPrime q :=
    Localization.localRingHom (Ideal.comap π.toRingHom q) q π.toRingHom rfl
  have hsource :
      IsRegularLocalRing (Localization.AtPrime (Ideal.comap π.toRingHom q)) :=
    localizedPolynomialPresentation_source_isRegularLocalRing (π := π) q
  have hφqSurj : Function.Surjective φq :=
    localizedPolynomialPresentation_localRingHom_surjective (π := π) hπ q
  -- Proof comment: the localized source and target are regular local, and `φq` is surjective.
  letI : IsRegularLocalRing (Localization.AtPrime (Ideal.comap π.toRingHom q)) := hsource
  exact
    surjectiveLocalHom_kernelIsGeneratedByRegularSequence_of_regularLocal φq hφqSurj

/-- Helper for Chap10 Lemma 10 140 5: a regular prime localization with separable residue field
is formally smooth over the base field. -/
private theorem formallySmoothAtPrime_of_regularLocal_separableResidueField
    (q : Ideal S) [q.IsPrime] [IsSeparableOver k q.ResidueField]
    (hregular : IsRegularLocalRing (Localization.AtPrime q)) :
    Algebra.FormallySmooth k (Localization.AtPrime q) := by
  -- Route correction: the ring-Krull-dimension Kähler criterion from Lemma 10.140.3 is the
  -- wrong normal form for non-closed points, so the converse must be proved through formal
  -- smoothness of the local algebra.
  have hConormalInjective :
      Function.Injective
        (KaehlerDifferential.kerCotangentToTensor k (Localization.AtPrime q) q.ResidueField) :=
    residueCotangentToKaehler_injective_atPrime_of_isSeparableOver (k := k) (S := S) q
  letI : IsRegularLocalRing (Localization.AtPrime q) := hregular
  have hCotangentDimension :
      Module.finrank q.ResidueField
          (IsLocalRing.CotangentSpace (Localization.AtPrime q)) =
        ringKrullDim (Localization.AtPrime q) :=
    regularLocalRing_finrank_cotangentSpace_eq_ringKrullDim_atPrime q hregular
  let A := Localization.AtPrime q
  letI : Algebra.FinitePresentation k S :=
    (Algebra.FinitePresentation.of_finiteType (R := k) (A := S)).mp inferInstance
  obtain ⟨n, π, hπsurj, hπfg⟩ := Algebra.FinitePresentation.out (R := k) (A := S)
  let q' : Ideal (MvPolynomial (Fin n) k) := Ideal.comap π.toRingHom q
  let P := Localization.AtPrime q'
  let φq : P →+* A := Localization.localRingHom q' q π.toRingHom rfl
  letI : Algebra P A := φq.toAlgebra
  letI : IsScalarTower k P A :=
    localizedPolynomialPresentation_isScalarTower (π := π) q
  have hφqsurj : Function.Surjective φq := by
    -- Proof comment: surjectivity of the polynomial presentation survives localization at `q`.
    simpa [q', P, A, φq] using
      localizedPolynomialPresentation_localRingHom_surjective (π := π) hπsurj q
  have hφqfg : (RingHom.ker φq).FG := by
    -- Proof comment: finite presentation localizes to finite generation of the presentation
    -- kernel for `P → A`.
    simpa [q', P, A, φq] using
      localizedPolynomialPresentation_localRingHom_kernel_fg (k := k) (S := S) (π := π) hπsurj q
  have hφqRegularSequence : φq.KernelIsGeneratedByRegularSequence := by
    -- Proof comment: the new regular-kernel bridge records the structural invariant needed for
    -- the remaining conormal/Jacobian injectivity argument.
    simpa [q', P, A, φq] using
      localizedPolynomialPresentation_kernelIsGeneratedByRegularSequence
        (k := k) (S := S) (π := π) hπsurj q hregular
  have hPFormallySmooth : Algebra.FormallySmooth k P := by
    -- Proof comment: the source of the localized presentation is a localization of a polynomial
    -- ring, hence formally smooth over the field.
    infer_instance
  have hPOmegaFree : Module.Free P Ω[P⁄k] := by
    -- Proof comment: finite projective differentials over the local source are free.
    letI : Algebra.FormallySmooth k P := hPFormallySmooth
    have hFinite : Module.Finite P Ω[P⁄k] := KaehlerDifferential.finite k P
    letI : Module.Finite P Ω[P⁄k] := hFinite
    letI : Module.Projective P Ω[P⁄k] :=
      Algebra.FormallySmooth.projective_kaehlerDifferential (R := k) (A := P)
    letI : Module.Flat P Ω[P⁄k] := Module.Flat.of_projective
    exact Module.free_of_flat_of_isLocalRing
  have hPOmegaFinite : Module.Finite P Ω[P⁄k] := by
    -- Proof comment: the localized polynomial source has finitely generated differentials.
    infer_instance
  have hcotangentInj :
      Function.Injective
        (KaehlerDifferential.cotangentComplexBaseChange k A P (IsLocalRing.ResidueField A)) := by
    -- Proof comment: this is the remaining local Jacobian injectivity step for the presentation.
    -- TODO: combine the regular-sequence kernel of `φq`, regularity of source and target, and
    -- residue-field separability with the conormal exact sequence to prove this map injective.
    let _ := hConormalInjective
    let _ := hCotangentDimension
    let _ := hφqRegularSequence
    sorry
  have hAFormallySmooth : Algebra.FormallySmooth k A := by
    -- Proof comment: mathlib's local Jacobian criterion converts the residue-field cotangent
    -- injectivity into formal smoothness of `A`.
    letI : Algebra.FormallySmooth k P := hPFormallySmooth
    letI : Module.Free P Ω[P⁄k] := hPOmegaFree
    letI : Module.Finite P Ω[P⁄k] := hPOmegaFinite
    exact
      (Algebra.FormallySmooth.iff_injective_cotangentComplexBaseChange_residueField
        (R := k) (S := A) (P := P) hφqsurj hφqfg).2 hcotangentInj
  let _ := hπfg
  let _ := hφqsurj
  let _ := hφqfg
  exact hAFormallySmooth

/-
Domain-style sampling for Lemma 10.140.5:
- primary domain: smoothness at a prime of a finite type algebra over a field versus regularity of
  the corresponding local ring, under a separable residue-field hypothesis;
- sampled owner declarations:
  `Algebra.IsSmoothAt`,
  `Algebra.isRegularLocalRing_of_isSmoothAt`,
  `residueCotangentToKaehler_injective_of_isSeparableOver`,
  `IsRegularLocalRing.iff_finrank_cotangentSpace`;
- best owner abstraction: the canonical owner is the ideal-level predicate `IsSmoothAt k q` for a
  prime ideal `q : Ideal S`; the prime-spectrum presentation is only a bridge/view, since the
  mathematical payload is entirely carried by `q`, `q.ResidueField`, and `Localization.AtPrime q`;
- primitive data: a prime ideal `q : Ideal S` and the Stacks-project separability hypothesis
  `IsSeparableOver k q.ResidueField`;
- derived API: the regular-local condition on `Localization.AtPrime q` and the resulting
  equivalence with `IsSmoothAt k q`.

Source/core/bridge triage:
- `source-facing`: the Stacks equivalence between smoothness at `q` and regularity of `S_q` under
  separability of `κ(q) / k`;
- `core/canonical`: `IsSmoothAt k q` and `IsRegularLocalRing (Localization.AtPrime q)`;
- `bridge/view`: a `PrimeSpectrum S` wrapper, which is not retained as the main owner surface. -/

-- Proof sketch: one direction is Lemma `10.140.3`, which shows that smoothness at `q` implies the
-- regularity of `S_q`. For the converse, use Lemma `10.140.4` and the conormal exact sequence from
-- Lemma `10.131.9` to identify the dimension of the Kähler-differential fiber with the embedding
-- dimension of `S_q`; the Stacks-project separability hypothesis on `κ(q) / k` and Lemma
-- `10.116.3` then turn regularity into the equality criterion in Lemma `10.140.3`.
/-- Lemma 10.140.5: let `q` be a prime of the finite type `k`-algebra `S` and assume the residue
field `κ(q) = q.ResidueField` is separable over `k` in the Stacks Project sense. Then `S` is
smooth at `q` over `k`
if and only if the local ring `S_q`, formalized as `Localization.AtPrime q`, is a regular local
ring. -/
@[stacks 00TV]
theorem isSmoothAt_iff_isRegularLocalRing_of_separable_residueField
    (q : Ideal S) [q.IsPrime] [IsSeparableOver k q.ResidueField] :
    IsSmoothAt k q ↔ IsRegularLocalRing (Localization.AtPrime q) := by
  constructor
  · intro hsmooth
    -- Proof comment: the forward implication is the already established smooth-implies-regular
    -- direction from Lemma 10.140.3.
    exact isRegularLocalRing_of_isSmoothAt q hsmooth
  · intro hregular
    -- Proof comment: `IsSmoothAt` is formal smoothness of the prime localization, supplied by
    -- the local Jacobian/formal-smoothness helper.
    exact formallySmoothAtPrime_of_regularLocal_separableResidueField q hregular

end

