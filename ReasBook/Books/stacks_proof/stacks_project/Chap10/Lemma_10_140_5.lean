/-- Helper for Chap10 Lemma 10 140 5: the source of a localized polynomial presentation over a
field is regular local. -/
private theorem localizedPolynomialPresentation_source_isRegularLocalRing
    {n : ℕ} (π : MvPolynomial (Fin n) k →ₐ[k] S)
    (q : Ideal S) [q.IsPrime] :
    IsRegularLocalRing (Localization.AtPrime (Ideal.comap π.toRingHom q)) := by
  -- Proof comment: this is the narrow regularity fact needed for the presentation source.
  -- Proof comment: polynomial algebras are smooth over the base field, and Lemma 10.140.3 turns
  -- smoothness at the contracted prime into regularity of that prime localization.
  apply isRegularLocalRing_of_isSmoothAt (k := k) (S := MvPolynomial (Fin n) k)
  infer_instance

