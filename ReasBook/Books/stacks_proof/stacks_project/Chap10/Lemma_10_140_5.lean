/-- Helper for Chap10 Lemma 10 140 5: the kernel of the localized polynomial presentation is
finitely generated. -/
private theorem localizedPolynomialPresentation_localRingHom_kernel_fg
    [Algebra.FinitePresentation k S]
    {n : ℕ} (π : MvPolynomial (Fin n) k →ₐ[k] S) (hπ : Function.Surjective π)
    (q : Ideal S) [q.IsPrime] :
    (RingHom.ker
        (Localization.localRingHom
          (Ideal.comap π.toRingHom q) q π.toRingHom rfl)).FG := by
  -- Proof comment: finite presentation controls the original kernel, and the previous kernel
  -- formula turns finite generation into finite generation after localization.
  have hker_fg : (RingHom.ker π.toRingHom).FG := by
    simpa using Algebra.FinitePresentation.ker_fG_of_surjective (f := π) hπ
  rw [localizedPolynomialPresentation_ker_localRingHom_eq (π := π) hπ q]
  exact Ideal.FG.map hker_fg _

