/-- Helper for Chap10 Proposition 10 58 7: the integer grading carries the natural degree-shift
action by `ℕ`. -/
local instance instAddActionNatIntDegreeOneQuotients10587 : AddAction ℕ ℤ where
  vadd n d := (n : ℤ) + d
  zero_vadd := by
    intro d
    change ((0 : ℕ) : ℤ) + d = d
    simp
  add_vadd := by
    intro m n d
    change (((m + n : ℕ) : ℤ) + d) = (m : ℤ) + ((n : ℤ) + d)
    simp [Nat.cast_add, add_assoc]

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
variable (𝒜 : ℕ → Submodule R S) [GradedAlgebra 𝒜]
variable [IsNoetherianRing S]

/-- Helper for Proposition 10.58.7: after quotienting by the principal ideal generated by `a`,
the ideal generated by `insert a s` becomes the ideal generated by the image of `s`. -/
lemma degree_one_singleton_quotient_map_insert_span_set
    [DecidableEq S] {a : S} {s : Finset S} :
    Ideal.map
        ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))) :
          S →+* S ⧸ Ideal.span ({a} : Set S))
        (Ideal.span ((insert a s : Finset S) : Set S)) =
      Ideal.span
        ((((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))) :
          S →+* S ⧸ Ideal.span ({a} : Set S))) '' (s : Set S)) := by
  classical
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  change Ideal.map (q : S →+* S ⧸ I) (Ideal.span ((insert a s : Finset S) : Set S)) =
      Ideal.span (q '' (s : Set S))
  have hqa : q a = 0 := by
    -- The quotient map kills the chosen generator of the singleton ideal.
    exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span <| by simp)
  calc
    Ideal.map (q : S →+* S ⧸ I) (Ideal.span ((insert a s : Finset S) : Set S)) =
        Ideal.span ((q : S →+* S ⧸ I) '' (((insert a s : Finset S) : Set S))) := by
          rw [Ideal.map_span]
    _ = Ideal.span (insert 0 ((q : S →+* S ⧸ I) '' (s : Set S))) := by
          -- The image of `insert a s` is `insert 0 (image s)` because `a` dies in the quotient.
          congr 1
          ext y
          constructor
          · intro hy
            rcases hy with ⟨x, hx, rfl⟩
            rcases Finset.mem_insert.mp hx with rfl | hx'
            · simp [hqa]
            · exact Set.mem_insert_iff.mpr (Or.inr ⟨x, hx', rfl⟩)
          · intro hy
            rcases Set.mem_insert_iff.mp hy with rfl | hy
            · exact ⟨a, Finset.mem_insert_self a s, hqa⟩
            · rcases hy with ⟨x, hx, rfl⟩
              exact ⟨x, Finset.mem_insert_of_mem hx, rfl⟩
    _ = Ideal.span ((q : S →+* S ⧸ I) '' (s : Set S)) := by
          rw [Ideal.span_insert_zero]

/-- Helper for Proposition 10.58.7: the quotient by `(a)` transports the irrelevant-ideal
spanning equality for `insert a s` to the corresponding span identity for the image of `s`. -/
lemma degree_one_singleton_quotient_map_irrelevant_eq_span_image
    [DecidableEq S] {a : S} {s : Finset S}
    (hinsert_span : Ideal.span ((insert a s : Finset S) : Set S) = 𝒜₊.toIdeal) :
    Ideal.map
        ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))) :
          S →+* S ⧸ Ideal.span ({a} : Set S))
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal =
      Ideal.span
        ((((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))) :
          S →+* S ⧸ Ideal.span ({a} : Set S))) '' (s : Set S)) := by
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  change Ideal.map (q : S →+* S ⧸ I) (HomogeneousIdeal.irrelevant 𝒜).toIdeal =
      Ideal.span (q '' (s : Set S))
  -- Rewrite the irrelevant ideal through the given finite generating set before mapping it.
  rw [← hinsert_span]
  exact degree_one_singleton_quotient_map_insert_span_set (R := R) (a := a) (s := s)

/-- Helper for Proposition 10.58.7: after quotienting by `(a)`, the image finset of the tail
generators spans exactly the image of the irrelevant ideal. -/
lemma degree_one_singleton_quotient_finset_span_irrelevant
    [DecidableEq S] {a : S} [DecidableEq (S ⧸ Ideal.span ({a} : Set S))] {s : Finset S}
    (hinsert_span : Ideal.span ((insert a s : Finset S) : Set S) = 𝒜₊.toIdeal) :
    Ideal.span
        (((s.image
          ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))) :
            S →ₐ[R] S ⧸ Ideal.span ({a} : Set S))) :
          Finset (S ⧸ Ideal.span ({a} : Set S))) :
          Set (S ⧸ Ideal.span ({a} : Set S))) =
      Ideal.map
        ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))) :
          S →+* S ⧸ Ideal.span ({a} : Set S))
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
  classical
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  -- Convert the finset image to the corresponding set image before reusing the mapped-ideal
  -- identity already established above.
  calc
    Ideal.span ((s.image q : Finset (S ⧸ I)) : Set (S ⧸ I)) =
        Ideal.span (q '' (s : Set S)) := by
          congr 1
          ext x
          constructor
          · intro hx
            rcases Finset.mem_image.mp hx with ⟨y, hy, rfl⟩
            exact ⟨y, hy, rfl⟩
          · rintro ⟨y, hy, rfl⟩
            exact Finset.mem_image.mpr ⟨y, hy, rfl⟩
    _ = Ideal.map (q : S →+* S ⧸ I) (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
          symm
          simpa [I, q] using
            degree_one_singleton_quotient_map_irrelevant_eq_span_image
              (R := R) (𝒜 := 𝒜) (a := a) (s := s) hinsert_span

/-- Helper for Proposition 10.58.7: the image of the tail generators in `S / (a)` is still a
finite family of degree-one elements for the mapped degree-one piece. -/
lemma degree_one_singleton_quotient_image_mem_degree_one
    {a : S} [DecidableEq (S ⧸ Ideal.span ({a} : Set S))] {s : Finset S}
    (hs_deg : ∀ x ∈ s, x ∈ 𝒜 1) :
    ∀ x ∈
        s.image
          ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))) :
            S →ₐ[R] S ⧸ Ideal.span ({a} : Set S)),
      x ∈
        (𝒜 1).map
          ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap) := by
  classical
  intro x hx
  rcases Finset.mem_image.mp hx with ⟨y, hy, rfl⟩
  -- Each quotient-side generator is literally the image of a degree-one tail generator.
  exact ⟨y, hs_deg y hy, rfl⟩

/-- Helper for Proposition 10.58.7: quotienting the tail generators by `(a)` does not increase
their cardinality. -/
lemma degree_one_singleton_quotient_image_card_le
    {a : S} [DecidableEq (S ⧸ Ideal.span ({a} : Set S))] {s : Finset S} :
    (s.image
      ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))) :
        S →ₐ[R] S ⧸ Ideal.span ({a} : Set S))).card ≤ s.card := by
  classical
  -- The quotient-side generating family is obtained by applying `Finset.image`.
  exact Finset.card_image_le

/-- Helper for Proposition 10.58.7: a degree-zero element in the principal ideal generated by a
degree-one homogeneous element must vanish. -/
lemma degree_zero_eq_zero_of_mem_span_singleton_degree_one
    {a x : S} (ha_deg : a ∈ 𝒜 1) (hx0 : x ∈ 𝒜 0)
    (hxI : x ∈ Ideal.span ({a} : Set S)) :
    x = 0 := by
  have hspan_le : Ideal.span ({a} : Set S) ≤ 𝒜₊.toIdeal := by
    -- The principal ideal `(a)` lies in the irrelevant ideal because `a` is homogeneous of
    -- positive degree.
    refine Ideal.span_le.2 ?_
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact mem_irrelevant_of_mem 𝒜 (by decide) ha_deg
  have hx_irr : x ∈ 𝒜₊.toIdeal := hspan_le hxI
  have hproj0_zero : GradedRing.proj 𝒜 0 x = 0 := by
    -- Membership in the irrelevant ideal is equivalent to vanishing of the degree-zero part.
    simpa [HomogeneousIdeal.mem_irrelevant_iff] using hx_irr
  have hproj0_self : GradedRing.proj 𝒜 0 x = x := by
    -- A genuinely degree-zero homogeneous element is equal to its own degree-zero component.
    simpa [GradedRing.proj_apply] using (DirectSum.decompose_of_mem_same 𝒜 hx0)
  exact hproj0_self.symm.trans hproj0_zero

/-- Helper for Proposition 10.58.7: the quotient map restricts to an `R`-linear map from the
degree-zero piece to its image inside `S / (a)`. -/
def degree_one_singleton_quotient_zero_piece_map
    {a : S} :
    𝒜 0 →ₗ[R]
      (𝒜 0).map
        ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap) :=
  LinearMap.codRestrict
    ((𝒜 0).map ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap))
    (((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap).domRestrict (𝒜 0))
    (fun x ↦ ⟨x, x.2, rfl⟩)

/-- Helper for Proposition 10.58.7: on the degree-zero piece, the quotient map modulo `(a)` is
injective when `a` has degree `1`. -/
lemma degree_one_singleton_quotient_zero_piece_map_injective
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    Function.Injective
      (degree_one_singleton_quotient_zero_piece_map
        (R := R) (𝒜 := 𝒜) (a := a)) := by
  intro x y hxy
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  have hq :
      q (x : S) = q (y : S) := by
    -- Forget the codomain subtype so the equality lives in the quotient ring.
    exact congrArg Subtype.val hxy
  have hsubq : q ((x : S) - (y : S)) = 0 := by
    -- Rewrite the equality of quotient classes as vanishing of the quotient of the difference.
    have : q (x : S) - q (y : S) = 0 := sub_eq_zero.mpr hq
    simpa [map_sub] using this
  have hsub_mem : (x : S) - (y : S) ∈ I := by
    -- Quotient-zero means membership in the defining principal ideal.
    exact Ideal.Quotient.eq_zero_iff_mem.1 hsubq
  have hsub_deg0 : (x : S) - (y : S) ∈ 𝒜 0 := by
    -- The difference of two degree-zero elements stays in degree `0`.
    exact Submodule.sub_mem (𝒜 0) x.2 y.2
  have hsub_zero : (x : S) - (y : S) = 0 := by
    -- The graded-degree argument kills any degree-zero element lying in `(a)`.
    simpa [I] using
      degree_zero_eq_zero_of_mem_span_singleton_degree_one
        (R := R) (𝒜 := 𝒜) (a := a) (x := (x : S) - (y : S))
        ha_deg hsub_deg0 hsub_mem
  exact Subtype.ext (sub_eq_zero.mp hsub_zero)

/-- Helper for Proposition 10.58.7: the degree-zero piece identifies linearly with its image in
the quotient ring `S / (a)`. -/
noncomputable def degree_one_singleton_quotient_zero_piece_linearEquiv
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    𝒜 0 ≃ₗ[R]
      (𝒜 0).map
        ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap) :=
  LinearEquiv.ofBijective
    (degree_one_singleton_quotient_zero_piece_map (R := R) (𝒜 := 𝒜) (a := a))
    ⟨degree_one_singleton_quotient_zero_piece_map_injective
        (R := R) (𝒜 := 𝒜) (a := a) ha_deg,
      by
        intro z
        rcases z.2 with ⟨x, hx, hxq⟩
        -- Every element of the image comes from an actual degree-zero source element.
        refine ⟨⟨x, hx⟩, ?_⟩
        apply Subtype.ext
        simpa [degree_one_singleton_quotient_zero_piece_map] using hxq⟩

/-- Helper for Proposition 10.58.7: the degree-zero piece identifies as an `R`-algebra with its
image inside the quotient ring `S / (a)`. -/
noncomputable def degree_one_singleton_quotient_zero_piece_algEquiv
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    𝒜 0 ≃ₗ[R]
      (𝒜 0).map
        ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap) :=
  degree_one_singleton_quotient_zero_piece_linearEquiv
    (R := R) (𝒜 := 𝒜) (a := a) ha_deg

/-- Helper for Proposition 10.58.7: the principal ideal generated by a degree-one homogeneous
element is itself homogeneous. -/
lemma degree_one_singleton_span_isHomogeneous
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    (Ideal.span ({a} : Set S)).IsHomogeneous 𝒜 := by
  -- The span of one homogeneous generator is homogeneous by the standard graded-ideal API.
  refine Ideal.homogeneous_span (𝒜 := 𝒜) ({a} : Set S) ?_
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  exact ⟨1, ha_deg⟩

/-- Helper for Proposition 10.58.7: each homogeneous component of an element of `(a)` still lies
in `(a)`, so it vanishes after quotienting by `(a)`. -/
lemma degree_one_singleton_quotient_proj_eq_zero_of_mem_span
    {a x : S} (ha_deg : a ∈ 𝒜 1)
    (hxI : x ∈ Ideal.span ({a} : Set S)) (n : ℕ) :
    Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S)) (GradedRing.proj 𝒜 n x) = 0 := by
  let I : Ideal S := Ideal.span ({a} : Set S)
  have hI : I.IsHomogeneous 𝒜 := by
    -- Package the homogeneity of `(a)` once so each projected component stays inside the ideal.
    simpa [I] using degree_one_singleton_span_isHomogeneous (R := R) (𝒜 := 𝒜) ha_deg
  have hproj_mem : GradedRing.proj 𝒜 n x ∈ I := by
    -- Homogeneous ideals contain every homogeneous projection of each of their elements.
    exact (Submodule.IsHomogeneous.mem_iff 𝒜 hI).1 hxI n
  -- Quotient-zero is exactly membership in the defining ideal.
  exact Ideal.Quotient.eq_zero_iff_mem.2 hproj_mem

/-- Helper for Proposition 10.58.7: quotienting by the singleton degree-one generator preserves
the finite degree-one generating package needed for the outer induction. -/
lemma degree_one_singleton_quotient_successor_package
    [DecidableEq S] {a : S} [DecidableEq (S ⧸ Ideal.span ({a} : Set S))] {s : Finset S}
    (hs_deg : ∀ x ∈ s, x ∈ 𝒜 1)
    (hinsert_span : Ideal.span ((insert a s : Finset S) : Set S) = 𝒜₊.toIdeal) :
    let I : Ideal S := Ideal.span ({a} : Set S)
    let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
    let u : Finset (S ⧸ I) := s.image q
    u.card ≤ s.card ∧
      (∀ x ∈ u, x ∈ (𝒜 1).map q.toLinearMap) ∧
      Ideal.span (u : Set (S ⧸ I)) =
        Ideal.map (q : S →+* S ⧸ I) (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
  classical
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  let u : Finset (S ⧸ I) := s.image q
  refine ⟨?_, ?_, ?_⟩
  · -- The quotient image finset cannot be larger than the original tail finset.
    simpa [u, I, q] using
      (degree_one_singleton_quotient_image_card_le (R := R) (a := a) (s := s))
  · -- Every quotient generator is the image of a degree-one tail generator.
    intro x hx
    simpa [u, I, q] using
      (degree_one_singleton_quotient_image_mem_degree_one
        (R := R) (𝒜 := 𝒜) (a := a) (s := s) hs_deg x hx)
  · -- The image finset still spans exactly the mapped irrelevant ideal.
    simpa [u, I, q] using
      (degree_one_singleton_quotient_finset_span_irrelevant
        (R := R) (𝒜 := 𝒜) (a := a) (s := s) hinsert_span)

/-- Helper for Proposition 10.58.7: each graded piece of the quotient ring `S / (a)` receives the
corresponding homogeneous component of `S` via the quotient map. -/
def degree_one_singleton_quotient_component_map
    {a : S} (n : ℕ) :
    𝒜 n →ₗ[R]
      (𝒜 n).map
        ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap) :=
  LinearMap.codRestrict
    ((𝒜 n).map ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap))
    (((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap).domRestrict (𝒜 n))
    (fun x ↦ ⟨x, x.2, rfl⟩)

/-- Helper for Proposition 10.58.7: the quotient images of the graded pieces still form a graded
monoid. -/
instance degree_one_singleton_quotient_setLikeGradedMonoid
    {a : S} :
    SetLike.GradedMonoid
      (fun n ↦
        (𝒜 n).map
          ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap)) where
  one_mem := by
    refine ⟨1, SetLike.one_mem_graded 𝒜, ?_⟩
    simp
  mul_mem := by
    intro i j x y hx hy
    rcases hx with ⟨x', hx', rfl⟩
    rcases hy with ⟨y', hy', rfl⟩
    refine ⟨x' * y', SetLike.mul_mem_graded hx' hy', ?_⟩
    simp

/-- Helper for Proposition 10.58.7: before passing to the quotient, decompose an element of `S`
and apply the quotient map componentwise to the homogeneous summands. -/
noncomputable def degree_one_singleton_quotient_predecompose
    {a : S} :
    S →ₗ[R] DirectSum ℕ
      (fun n ↦
        (𝒜 n).map
          ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap)) :=
  (DirectSum.lmap fun n ↦
      degree_one_singleton_quotient_component_map
        (R := R) (𝒜 := 𝒜) (a := a) n).comp
    (DirectSum.decomposeLinearEquiv 𝒜).toLinearMap

/-- Helper for Proposition 10.58.7: on a homogeneous element, the quotient predecomposition is the
single direct-sum term in the matching degree. -/
lemma degree_one_singleton_quotient_predecompose_eq_lof_of_mem
    {a x : S} {n : ℕ} (hx : x ∈ 𝒜 n) :
    degree_one_singleton_quotient_predecompose
        (R := R) (𝒜 := 𝒜) (a := a) x =
      DirectSum.lof R ℕ
        (fun m ↦
          (𝒜 m).map
            ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap))
        n
        (degree_one_singleton_quotient_component_map
          (R := R) (𝒜 := 𝒜) (a := a) n ⟨x, hx⟩) := by
  ext m
  by_cases hmn : n = m
  · subst hmn
    -- In the matching degree, the decomposition is exactly the original homogeneous element.
    simp [degree_one_singleton_quotient_predecompose,
      degree_one_singleton_quotient_component_map, DirectSum.decomposeLinearEquiv_apply,
      DirectSum.decompose_of_mem_same, hx]
  · -- Off the matching degree, the decomposition coordinate vanishes.
    have hnm : n ≠ m := hmn
    have hmn' : m ≠ n := by
      intro hmn_eq
      exact hnm hmn_eq.symm
    have hdecomp : (((DirectSum.decompose 𝒜) x) m : S) = 0 := by
      simpa using (DirectSum.decompose_of_mem_ne 𝒜 hx hnm)
    simp [degree_one_singleton_quotient_predecompose,
      degree_one_singleton_quotient_component_map, DirectSum.decomposeLinearEquiv_apply,
      DirectSum.lof_eq_of, DirectSum.of_eq_of_ne, hdecomp, hmn']

/-- Helper for Proposition 10.58.7: the componentwise quotient predecomposition annihilates every
element of the principal ideal `(a)` once `a` has degree `1`. -/
lemma degree_one_singleton_quotient_predecompose_eq_zero_of_mem_span
    {a x : S} (ha_deg : a ∈ 𝒜 1)
    (hxI : x ∈ Ideal.span ({a} : Set S)) :
    degree_one_singleton_quotient_predecompose
      (R := R) (𝒜 := 𝒜) (a := a) x = 0 := by
  ext n
  -- Each homogeneous projection of an element of `(a)` still lies in `(a)`, so its quotient image
  -- vanishes coordinatewise.
  have hproj :
      Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S)) (GradedRing.proj 𝒜 n x) = 0 := by
    exact
      degree_one_singleton_quotient_proj_eq_zero_of_mem_span
        (R := R) (𝒜 := 𝒜) (a := a) (x := x) ha_deg hxI n
  simpa [degree_one_singleton_quotient_predecompose,
    degree_one_singleton_quotient_component_map, DirectSum.decomposeLinearEquiv_apply,
    GradedRing.proj_apply] using hproj

/-- Helper for Proposition 10.58.7: the componentwise quotient predecomposition kills the ideal
`(a)`, so it is eligible to descend through the quotient. -/
lemma degree_one_singleton_quotient_predecompose_span_singleton_le_ker
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    (Ideal.span ({a} : Set S)).restrictScalars R ≤
      LinearMap.ker
        (degree_one_singleton_quotient_predecompose
          (R := R) (𝒜 := 𝒜) (a := a)) := by
  intro x hx
  -- The `restrictScalars` view has the same underlying membership predicate, so the ideal-side
  -- vanishing lemma immediately gives the kernel condition needed for `liftQ`.
  exact
    degree_one_singleton_quotient_predecompose_eq_zero_of_mem_span
      (R := R) (𝒜 := 𝒜) (a := a) (x := x) ha_deg hx

/-- Helper for Proposition 10.58.7: the componentwise quotient predecomposition descends to an
`R`-linear map on the quotient ring `S / (a)`. -/
noncomputable def degree_one_singleton_quotient_decomposeLinear
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    S ⧸ Ideal.span ({a} : Set S) →ₗ[R]
      DirectSum ℕ
        (fun n ↦
          (𝒜 n).map
            ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap)) :=
  -- Descend the componentwise predecomposition through the quotient by `(a)` using `liftQ`.
  Submodule.liftQ ((Ideal.span ({a} : Set S)).restrictScalars R)
    (degree_one_singleton_quotient_predecompose
      (R := R) (𝒜 := 𝒜) (a := a))
    (degree_one_singleton_quotient_predecompose_span_singleton_le_ker
      (R := R) (𝒜 := 𝒜) (a := a) ha_deg)

/-- Helper for Proposition 10.58.7: recomposing the descended quotient decomposition recovers the
quotient-ring element. -/
lemma degree_one_singleton_quotient_decomposeLinear_left_inv
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    DirectSum.coeLinearMap
        (fun n ↦
          (𝒜 n).map
            ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap)) ∘ₗ
      degree_one_singleton_quotient_decomposeLinear
        (R := R) (𝒜 := 𝒜) (a := a) ha_deg =
      LinearMap.id := by
  classical
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  let 𝒜bar : ℕ → Submodule R (S ⧸ I) := fun n ↦ (𝒜 n).map q.toLinearMap
  let predecomposeBar :
      S →ₗ[R] DirectSum ℕ (fun n ↦ 𝒜bar n) :=
    degree_one_singleton_quotient_predecompose (R := R) (𝒜 := 𝒜) (a := a)
  have hsource :
      DirectSum.coeLinearMap 𝒜bar ∘ₗ predecomposeBar =
        q.toLinearMap := by
    -- Compare both maps on each homogeneous summand of the original grading on `S`.
    apply DirectSum.decompose_lhom_ext (ℳ := 𝒜)
    intro n
    apply LinearMap.ext
    intro x
    change
      DirectSum.coeLinearMap 𝒜bar
        (degree_one_singleton_quotient_predecompose
          (R := R) (𝒜 := 𝒜) (a := a) (x : S)) =
        q x
    rw [degree_one_singleton_quotient_predecompose_eq_lof_of_mem
      (R := R) (𝒜 := 𝒜) (a := a) x.2]
    -- On a homogeneous input, recomposition just forgets the codomain subtype.
    rw [DirectSum.coeLinearMap_lof]
    rfl
  -- Descend the equality from `S` to `S / (a)` by checking it after precomposing with the
  -- quotient map.
  apply Submodule.linearMap_qext (p := I.restrictScalars R)
  calc
    ((DirectSum.coeLinearMap
          (fun n ↦
            (𝒜 n).map
              ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap)) ∘ₗ
        degree_one_singleton_quotient_decomposeLinear
          (R := R) (𝒜 := 𝒜) (a := a) ha_deg) ∘ₗ
        (I.restrictScalars R).mkQ) =
      DirectSum.coeLinearMap 𝒜bar ∘ₗ predecomposeBar := by
        -- The descended decomposition agrees with the source predecomposition on representatives.
        ext x
        have hLift :
            degree_one_singleton_quotient_decomposeLinear
                (R := R) (𝒜 := 𝒜) (a := a) ha_deg ((I.restrictScalars R).mkQ x) =
              predecomposeBar x := by
          simpa [I, degree_one_singleton_quotient_decomposeLinear] using
            (Submodule.liftQ_apply (p := I.restrictScalars R) predecomposeBar x)
        simpa [LinearMap.comp_apply] using congrArg (DirectSum.coeLinearMap 𝒜bar) hLift
    _ = q.toLinearMap := hsource
    _ = LinearMap.id ∘ₗ (I.restrictScalars R).mkQ := by
        rfl

/-- Helper for Proposition 10.58.7: the descended quotient decomposition sends each homogeneous
generator back to the matching direct-sum generator. -/
lemma degree_one_singleton_quotient_decomposeLinear_right_inv
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    degree_one_singleton_quotient_decomposeLinear
        (R := R) (𝒜 := 𝒜) (a := a) ha_deg ∘ₗ
      DirectSum.coeLinearMap
        (fun n ↦
          (𝒜 n).map
            ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap)) =
      LinearMap.id := by
  classical
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  let 𝒜bar : ℕ → Submodule R (S ⧸ I) := fun n ↦ (𝒜 n).map q.toLinearMap
  -- A direct-sum map is determined by its values on the `lof` generators.
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro xbar
  rcases xbar.2 with ⟨x, hx, hxq⟩
  have hxbar :
      xbar = ⟨q x, ⟨x, hx, rfl⟩⟩ := by
    apply Subtype.ext
    exact hxq.symm
  have hpre :
      degree_one_singleton_quotient_decomposeLinear
          (R := R) (𝒜 := 𝒜) (a := a) ha_deg (q x) =
        DirectSum.lof R ℕ (fun i ↦ 𝒜bar i) n ⟨q x, ⟨x, hx, rfl⟩⟩ := by
    -- On a quotient-side homogeneous representative, the descended map is exactly the expected
    -- `lof` term.
    simpa [I, q, 𝒜bar, degree_one_singleton_quotient_decomposeLinear,
      degree_one_singleton_quotient_component_map] using
      (degree_one_singleton_quotient_predecompose_eq_lof_of_mem
        (R := R) (𝒜 := 𝒜) (a := a) hx)
  simpa [LinearMap.comp_apply, hxbar] using hpre

/-- Helper for Proposition 10.58.7: the quotient-side graded pieces of `S / (a)` inherit a direct
sum decomposition from the original grading on `S`. -/
@[reducible] noncomputable def degree_one_singleton_quotient_ring_decomposition
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    DirectSum.Decomposition
      (fun n ↦
        (𝒜 n).map
          ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap)) :=
  DirectSum.Decomposition.ofLinearMap
    (ℳ := fun n ↦
      (𝒜 n).map
        ((Ideal.Quotient.mkₐ R (Ideal.span ({a} : Set S))).toLinearMap))
    (degree_one_singleton_quotient_decomposeLinear
      (R := R) (𝒜 := 𝒜) (a := a) ha_deg)
    (degree_one_singleton_quotient_decomposeLinear_left_inv
      (R := R) (𝒜 := 𝒜) (a := a) ha_deg)
    (degree_one_singleton_quotient_decomposeLinear_right_inv
      (R := R) (𝒜 := 𝒜) (a := a) ha_deg)

/-- Helper for Chap10 Proposition 10 58 7: the irrelevant ideal of the quotient grading is the
image of the original irrelevant ideal under `S → S ⧸ (a)`. -/
lemma degree_one_singleton_quotient_irrelevant_eq_map
    {a : S} (ha_deg : a ∈ 𝒜 1) :
    let I : Ideal S := Ideal.span ({a} : Set S)
    let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
    let 𝒜bar : ℕ → Submodule R (S ⧸ I) := fun n ↦ (𝒜 n).map q.toLinearMap
    let _ : SetLike.GradedMonoid 𝒜bar :=
      degree_one_singleton_quotient_setLikeGradedMonoid (R := R) (𝒜 := 𝒜) (a := a)
    let hdec : DirectSum.Decomposition 𝒜bar :=
      degree_one_singleton_quotient_ring_decomposition (R := R) (𝒜 := 𝒜) (a := a) ha_deg
    let _ : GradedAlgebra 𝒜bar := { (inferInstance : SetLike.GradedMonoid 𝒜bar), hdec with }
    Ideal.map (q : S →+* S ⧸ I) (HomogeneousIdeal.irrelevant 𝒜).toIdeal =
      (HomogeneousIdeal.irrelevant 𝒜bar).toIdeal := by
  classical
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  let 𝒜bar : ℕ → Submodule R (S ⧸ I) := fun n ↦ (𝒜 n).map q.toLinearMap
  letI : SetLike.GradedMonoid 𝒜bar :=
    degree_one_singleton_quotient_setLikeGradedMonoid (R := R) (𝒜 := 𝒜) (a := a)
  let hdec : DirectSum.Decomposition 𝒜bar :=
    degree_one_singleton_quotient_ring_decomposition (R := R) (𝒜 := 𝒜) (a := a) ha_deg
  letI : GradedAlgebra 𝒜bar := { (inferInstance : SetLike.GradedMonoid 𝒜bar), hdec with }
  change Ideal.map (q : S →+* S ⧸ I) (HomogeneousIdeal.irrelevant 𝒜).toIdeal =
      (HomogeneousIdeal.irrelevant 𝒜bar).toIdeal
  -- Both irrelevant ideals are the spans of their positive homogeneous components; quotienting
  -- sends each source component to the matching quotient component.
  rw [HomogeneousIdeal.irrelevant_eq_span (𝒜 := 𝒜),
    HomogeneousIdeal.irrelevant_eq_span (𝒜 := 𝒜bar), Ideal.map_span]
  congr 1
  ext y
  constructor
  · intro hy
    rcases hy with ⟨x, hx, rfl⟩
    rcases Set.mem_iUnion.mp hx with ⟨n, hx⟩
    rcases Set.mem_iUnion.mp hx with ⟨hnpos, hxmem⟩
    exact Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨hnpos, ⟨x, hxmem, rfl⟩⟩⟩
  · intro hy
    rcases Set.mem_iUnion.mp hy with ⟨n, hy⟩
    rcases Set.mem_iUnion.mp hy with ⟨hnpos, hymem⟩
    rcases hymem with ⟨x, hxmem, rfl⟩
    exact ⟨x, Set.mem_iUnion.mpr ⟨n, Set.mem_iUnion.mpr ⟨hnpos, hxmem⟩⟩, rfl⟩

/-- Helper for Chap10 Proposition 10 58 7: quotienting by a degree-one generator preserves the
finite degree-one generating package in the exact form needed by the outer induction hypothesis.
-/
lemma degree_one_singleton_quotient_successor_package_for_irrelevant
    [DecidableEq S] {a : S} (ha_deg : a ∈ 𝒜 1)
    [DecidableEq (S ⧸ Ideal.span ({a} : Set S))] {s : Finset S}
    (hs_deg : ∀ x ∈ s, x ∈ 𝒜 1)
    (hinsert_span : Ideal.span ((insert a s : Finset S) : Set S) = 𝒜₊.toIdeal) :
    let I : Ideal S := Ideal.span ({a} : Set S)
    let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
    let 𝒜bar : ℕ → Submodule R (S ⧸ I) := fun n ↦ (𝒜 n).map q.toLinearMap
    let _ : SetLike.GradedMonoid 𝒜bar :=
      degree_one_singleton_quotient_setLikeGradedMonoid (R := R) (𝒜 := 𝒜) (a := a)
    let hdec : DirectSum.Decomposition 𝒜bar :=
      degree_one_singleton_quotient_ring_decomposition (R := R) (𝒜 := 𝒜) (a := a) ha_deg
    let _ : GradedAlgebra 𝒜bar := { (inferInstance : SetLike.GradedMonoid 𝒜bar), hdec with }
    let u : Finset (S ⧸ I) := s.image q
    u.card ≤ s.card ∧
      (∀ x ∈ u, x ∈ 𝒜bar 1) ∧
      Ideal.span (u : Set (S ⧸ I)) = (HomogeneousIdeal.irrelevant 𝒜bar).toIdeal := by
  classical
  let I : Ideal S := Ideal.span ({a} : Set S)
  let q : S →ₐ[R] S ⧸ I := Ideal.Quotient.mkₐ R I
  let 𝒜bar : ℕ → Submodule R (S ⧸ I) := fun n ↦ (𝒜 n).map q.toLinearMap
  letI : SetLike.GradedMonoid 𝒜bar :=
    degree_one_singleton_quotient_setLikeGradedMonoid (R := R) (𝒜 := 𝒜) (a := a)
  let hdec : DirectSum.Decomposition 𝒜bar :=
    degree_one_singleton_quotient_ring_decomposition (R := R) (𝒜 := 𝒜) (a := a) ha_deg
  letI : GradedAlgebra 𝒜bar := { (inferInstance : SetLike.GradedMonoid 𝒜bar), hdec with }
  let u : Finset (S ⧸ I) := s.image q
  obtain ⟨hcard, hdeg, hspan⟩ :=
    degree_one_singleton_quotient_successor_package
      (R := R) (𝒜 := 𝒜) (a := a) (s := s) hs_deg hinsert_span
  refine ⟨?_, ?_, ?_⟩
  · -- The quotient image finset still has no more generators than the tail finset.
    simpa [I, q, u] using hcard
  · intro x hx
    -- The degree-one membership part is unchanged; only the quotient grading spelling changes.
    simpa [I, q, 𝒜bar, u] using hdeg x (by simpa [I, q, u] using hx)
  · calc
      Ideal.span (u : Set (S ⧸ I)) =
          Ideal.map (q : S →+* S ⧸ I) (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
            simpa [I, q, u] using hspan
      _ = (HomogeneousIdeal.irrelevant 𝒜bar).toIdeal := by
            simpa [I, q, 𝒜bar] using
              degree_one_singleton_quotient_irrelevant_eq_map
                (R := R) (𝒜 := 𝒜) (a := a) ha_deg


end
