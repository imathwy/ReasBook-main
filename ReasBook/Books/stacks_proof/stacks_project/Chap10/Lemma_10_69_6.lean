/-- Helper for Chap10 Lemma 10 69 6: a representative not lying in the next filtration stage
gives a nonzero class in the corresponding internal associated-graded quotient. -/
private theorem quotientStageClass_ne_zero_of_not_mem_next
    {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage rs M n)
    (hxnext : x ∉ quasiRegularStage rs M (n + 1)) :
    (Submodule.Quotient.mk (⟨x, hx⟩ : quasiRegularStage rs M n) :
      quasiRegularAssociatedGradedInternalPiece rs M n) ≠ 0 := by
  -- A zero quotient class is exactly membership in the denominator `J(J^n M)`.
  intro hzero
  rw [Submodule.Quotient.mk_eq_zero] at hzero
  rw [Submodule.mem_smul_top_iff] at hzero
  -- Rewrite that denominator as the next power `J^(n+1)M`, contradicting the hypothesis.
  apply hxnext
  change x ∈ (quasiRegularIdeal rs ^ (n + 1)) • (⊤ : Submodule R M)
  rw [pow_succ']
  rw [mul_smul]
  exact hzero

