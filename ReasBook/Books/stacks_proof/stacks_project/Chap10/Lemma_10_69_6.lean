      quasiRegularAssociatedGradedPolynomialSmul (r :: rs)
        (MvPolynomial.monomial (Finsupp.single (0 : Fin (r :: rs).length) 1)
          (1 : R ⧸ Ideal.ofList (r :: rs))) y =
        (1 : R ⧸ Ideal.ofList (r :: rs)) •
          quasiRegularAssociatedGradedMonomialAction (r :: rs)
            (Finsupp.single (0 : Fin (r :: rs).length) 1) y := by
    -- Collapse the defining finite polynomial sum to the single head-variable monomial.
    change quasiRegularAssociatedGradedPolynomialSmul (r :: rs)
        (MvPolynomial.monomial (Finsupp.single (0 : Fin (r :: rs).length) 1)
          (1 : R ⧸ Ideal.ofList (r :: rs))) y =
      (1 : R ⧸ Ideal.ofList (r :: rs)) •
        quasiRegularAssociatedGradedMonomialAction (r :: rs)
          (Finsupp.single (0 : Fin (r :: rs).length) 1) y
