      (MvPolynomial.sum_monomial_eq
        (u := Finsupp.single (0 : Fin (r :: rs).length) 1)
        (r := (1 : R ⧸ Ideal.ofList (r :: rs)))
        (b := fun d a ↦ a • quasiRegularAssociatedGradedMonomialAction (r :: rs) d y))
  rw [hmonomial]
  simp only [one_smul]
  exact headVariableAction_lof_stageClass_eq_zero_of_smul_eq_zero (M := M) hx hrx

