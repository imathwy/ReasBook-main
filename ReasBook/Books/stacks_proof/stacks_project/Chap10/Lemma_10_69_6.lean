/-- Helper for Chap10 Lemma 10 69 6: pulling the head-variable action back through the
quasi-regular linear equivalence gives the explicit textbook source action. -/
private theorem linearEquiv_symm_headVariable_smul
    {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs))
    (y : idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M) :
    hqr.linearEquiv.symm ((MvPolynomial.X (0 : Fin (r :: rs).length) :
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) • y) =
      (quasiRegularSequenceAssociatedGradedTextbookSourceModule M (r :: rs)).smul
        (MvPolynomial.X (0 : Fin (r :: rs).length) :
          MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs)))
        (hqr.linearEquiv.symm y) := by
  -- This is just polynomial-linearity of the inverse equivalence, with the source module written
  -- in the explicit transported spelling used by the zero-kernel helper.
  exact hqr.linearEquiv.symm.map_smul
    (MvPolynomial.X (0 : Fin (r :: rs).length) :
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) y

/-- Chap10 Lemma 10 69 6: the head element of a quasi-regular sequence in the maximal ideal is a
nonzerodivisor on the module. -/
theorem headSMulRegular_of_isQuasiRegular_mem_maximalIdeal
    {S : Type*} [CommRing S] [IsNoetherianRing S] [IsLocalRing S]
    {N : Type*} [AddCommGroup N] [Module S N] [Module.Finite S N]
    {r : S} {rs : List S} (hqr : IsQuasiRegular N (r :: rs))
    (hmem : ∀ a ∈ r :: rs, a ∈ IsLocalRing.maximalIdeal S) :
    IsSMulRegular N r := by
  -- It is enough to prove that the kernel of multiplication by the head element is zero.
  have hzero_of_smul :
      ∀ {x : N}, r • x = 0 → x = 0 := by
    intro x hrx
    by_contra hx_ne
    have hJ_ne_top : Ideal.ofList (r :: rs) ≠ (⊤ : Ideal S) := by
      exact idealOfList_ne_top_of_mem_maximalIdeal hmem
    obtain ⟨n, hxstage_raw, hxnext_raw⟩ :=
      exists_pow_smul_order_of_ne_zero (R := S) (M := N) hJ_ne_top hx_ne
    have hxstage : x ∈ quasiRegularStage (r :: rs) N n := by
      simpa [quasiRegularStage, quasiRegularIdeal] using hxstage_raw
    have hxnext : x ∉ quasiRegularStage (r :: rs) N (n + 1) := by
      simpa [quasiRegularStage, quasiRegularIdeal] using hxnext_raw
    let y : idealAssociatedGradedModule (Ideal.ofList (r :: rs)) N :=
      (quasiRegularAssociatedGradedAddEquiv (r :: rs) N).symm
        (DirectSum.lof (S ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) N) n
          (Submodule.Quotient.mk
            (⟨x, hxstage⟩ : quasiRegularStage (r :: rs) N n)))
    have hy_ne : y ≠ 0 := by
      exact associatedGradedClass_ne_zero_of_not_mem_next (M := N) hxstage hxnext
    have hXy : (MvPolynomial.X (0 : Fin (r :: rs).length) :
        MvPolynomial (Fin (r :: rs).length) (S ⧸ Ideal.ofList (r :: rs))) • y = 0 := by
      exact
        headVariable_smul_associatedGradedClass_eq_zero_of_smul_eq_zero
          (M := N) hxstage hrx
    have hsource_action :
        (quasiRegularSequenceAssociatedGradedTextbookSourceModule N (r :: rs)).smul
          (MvPolynomial.X (0 : Fin (r :: rs).length) :
            MvPolynomial (Fin (r :: rs).length) (S ⧸ Ideal.ofList (r :: rs)))
          (hqr.linearEquiv.symm y) = 0 := by
      have hpull :=
        congrArg hqr.linearEquiv.symm hXy
      rw [map_zero] at hpull
      rwa [linearEquiv_symm_headVariable_smul (M := N) hqr y] at hpull
    have hsource_zero : hqr.linearEquiv.symm y = 0 := by
      exact textbookSourceTensor_X_smul_eq_zero (P := N) (r :: rs)
        (0 : Fin (r :: rs).length) hsource_action
    have hy_zero : y = 0 := by
      have happly := congrArg hqr.linearEquiv hsource_zero
      simpa [y] using happly
    exact hy_ne hy_zero
  intro x y hxy
  -- Apply the zero-kernel statement to the difference of two elements with equal head multiples.
  have hdiff : r • (x - y) = 0 := by
    rw [smul_sub]
    exact sub_eq_zero.mpr hxy
  exact sub_eq_zero.mp (hzero_of_smul hdiff)

/-- Helper for Chap10 Lemma 10 69 6: the quasi-regular-to-weakly-regular implication is proved by
induction on a length bound, so the recursive call can change to the quotient ring. -/
private theorem isWeaklyRegular_length_induction_aux (n : ℕ) :
    ∀ {S : Type*} [CommRing S] [IsNoetherianRing S] [IsLocalRing S]
      {N : Type*} [AddCommGroup N] [Module S N] [Module.Finite S N] {rs : List S},
      rs.length ≤ n → IsQuasiRegular N rs →
      (∀ a ∈ rs, a ∈ IsLocalRing.maximalIdeal S) → IsWeaklyRegular N rs := by
  induction n with
  | zero =>
      intro S _ _ _ N _ _ _ rs hlen hqr hmem
      cases rs with
      | nil =>
          -- The only list with length at most zero is the empty list.
          simpa using (IsWeaklyRegular.nil (R := S) (M := N))
      | cons r rs =>
          -- A nonempty list cannot satisfy the zero length bound.
          simp at hlen
  | succ n ih =>
      intro S _ _ _ N _ _ _ rs hlen hqr hmem
      cases rs with
      | nil =>
          -- The empty sequence remains the base weakly regular sequence at every length bound.
          simpa using (IsWeaklyRegular.nil (R := S) (M := N))
      | cons r rs =>
          by_cases hN : Subsingleton N
          · letI : Subsingleton N := hN
            -- If the current module is trivial, weak regularity is inherited through every tail.
            exact isWeaklyRegular_of_subsingleton (S := S) (N := N) (r :: rs)
          · letI : Nontrivial N := not_subsingleton_iff_nontrivial.mp hN
            let I : Ideal S := Ideal.ofList [r]
            have hrmem_list : r ∈ r :: rs := by
              simp
            have hrmem : r ∈ IsLocalRing.maximalIdeal S := by
              exact hmem r hrmem_list
            have hsingle_mem :
                ∀ a ∈ [r], a ∈ IsLocalRing.maximalIdeal S := by
              intro a ha
              have ha_eq : a = r := by
                simpa using ha
              simpa [ha_eq] using hrmem
            have hI_ne_top : I ≠ ⊤ := by
              exact idealOfList_ne_top_of_mem_maximalIdeal (rs := [r]) hsingle_mem
            letI : Nontrivial (S ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI_ne_top
            letI : IsLocalRing (S ⧸ I) :=
              IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
            letI : IsNoetherianRing (S ⧸ I) := Ideal.Quotient.isNoetherianRing I
            have htail_len : (rs.map (Ideal.Quotient.mk I)).length ≤ n := by
              -- Removing the head consumes exactly one unit of the length bound.
              simpa [I, List.length_map] using Nat.succ_le_succ_iff.mp hlen
            have htail_qr :
                IsQuasiRegular (N ⧸ (I • (⊤ : Submodule S N)))
                  (rs.map (Ideal.Quotient.mk I)) := by
              -- The predecessor theorem supplies quasi-regularity after quotienting by the head.
              simpa [I] using tailQuotient_one_ofListSingleton (N := N) hqr
            have htail_mem :
                ∀ a ∈ rs.map (Ideal.Quotient.mk I),
                  a ∈ IsLocalRing.maximalIdeal (S ⧸ I) := by
              intro a ha
              -- Maximal-ideal membership descends termwise to the quotient ring.
              rcases List.mem_map.mp ha with ⟨b, hb, rfl⟩
              have hbmem_list : b ∈ r :: rs := by
                simp [hb]
              have hbmem : b ∈ IsLocalRing.maximalIdeal S := by
                exact hmem b hbmem_list
              exact quotient_mk_mem_maximalIdeal_of_mem_maximalIdeal (I := I) hbmem
            have htail_ofList :
                IsWeaklyRegular (N ⧸ (I • (⊤ : Submodule S N)))
                  (rs.map (Ideal.Quotient.mk I)) := by
              -- The induction hypothesis is polymorphic in the ambient ring and module, so it
              -- applies in the quotient ring.
              exact ih (S := S ⧸ I) (N := N ⧸ (I • (⊤ : Submodule S N)))
                htail_len htail_qr htail_mem
            have htail : IsWeaklyRegular (QuotSMulTop r N) rs := by
              -- Finally transport the quotient-tail weak regularity to the owner quotient model.
              simpa [I] using
                weakRegular_tail_of_ofListSingleton_quot (R := S) (M := N) htail_ofList
            have hhead : IsSMulRegular N r := by
              -- The head nonzerodivisor step is isolated as the remaining associated-graded
              -- argument.
              exact headSMulRegular_of_isQuasiRegular_mem_maximalIdeal hqr hmem
            exact IsWeaklyRegular.cons hhead htail

/-- Canonical strengthening behind Lemma 10.69.6: over a local Noetherian ring, a quasi-regular
sequence whose entries all lie in the maximal ideal is weakly regular on every finite module. -/
theorem isWeaklyRegular {rs : List R} (hqr : IsQuasiRegular M rs)
    (hmem : ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal R) :
    IsWeaklyRegular M rs := by
  -- The main theorem now delegates to the length-bounded induction, whose recursive call can
  -- change ambient rings after quotienting by the head term.
  exact isWeaklyRegular_length_induction_aux rs.length le_rfl hqr hmem

/-- Consequence for Chap10 Lemma 10 69 6: over a local Noetherian ring, a quasi-regular sequence
contained in the maximal ideal is a regular sequence on every nonzero finite module. This is the
source-facing local upgrade obtained by composing `isWeaklyRegular` with the owner theorem
`IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal`. -/
@[stacks 061S]
theorem isRegular_of_mem_maximalIdeal [Nontrivial M] {rs : List R} (hqr : IsQuasiRegular M rs)
    (hmem : ∀ r ∈ rs, r ∈ IsLocalRing.maximalIdeal R) :
    IsRegular M rs :=
  IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal M hmem (hqr.isWeaklyRegular hmem)

end IsQuasiRegular

