/-- Helper for Chap10 Lemma 10 69 6: a weakly regular tail in the singleton `ofList` quotient
model transports to the owner `QuotSMulTop` model. -/
private theorem weakRegular_tail_of_ofListSingleton_quot
    {r : R} {rs : List R}
    (htail : IsWeaklyRegular (M ⧸ (Ideal.ofList [r] • (⊤ : Submodule R M)))
      (rs.map (Ideal.Quotient.mk (Ideal.ofList [r])))) :
    IsWeaklyRegular (QuotSMulTop r M) rs := by
  -- First forget the quotient-ring scalars using the standard algebra-map characterization.
  have htailR : IsWeaklyRegular (M ⧸ (Ideal.ofList [r] • (⊤ : Submodule R M))) rs := by
    simpa using
      ((isWeaklyRegular_map_algebraMap_iff
        (R := R) (S := R ⧸ Ideal.ofList [r])
        (M := M ⧸ (Ideal.ofList [r] • (⊤ : Submodule R M))) rs).mp htail)
  let e : (M ⧸ (Ideal.ofList [r] • (⊤ : Submodule R M))) ≃ₗ[R] QuotSMulTop r M :=
    Submodule.quotEquivOfEq _ _ (by
      simpa [QuotSMulTop, Ideal.ofList] using
        (Submodule.ideal_span_singleton_smul r (⊤ : Submodule R M)))
  -- Then move across the canonical quotient-module equivalence.
  exact (e.isWeaklyRegular_congr rs).mp htailR

