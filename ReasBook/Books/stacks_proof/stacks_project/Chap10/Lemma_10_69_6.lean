/-- Helper for Chap10 Lemma 10 69 6: the corresponding public associated-graded class is nonzero
after transporting from the internal direct-sum model. -/
private theorem associatedGradedClass_ne_zero_of_not_mem_next
    {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage rs M n)
    (hxnext : x ∉ quasiRegularStage rs M (n + 1)) :
    (quasiRegularAssociatedGradedAddEquiv rs M).symm
      (DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (quasiRegularAssociatedGradedInternalPiece rs M) n
        (Submodule.Quotient.mk (⟨x, hx⟩ : quasiRegularStage rs M n))) ≠ 0 := by
  -- Apply the additive equivalence back to the public equality and use the internal lemma.
  intro hzero
  have hinternal := congrArg (quasiRegularAssociatedGradedAddEquiv rs M) hzero
  have hlof : DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (quasiRegularAssociatedGradedInternalPiece rs M) n
        (Submodule.Quotient.mk (⟨x, hx⟩ : quasiRegularStage rs M n)) = 0 := by
    simpa using hinternal
  exact directSumLof_stageClass_ne_zero_of_not_mem_next (M := M) hx hxnext hlof

