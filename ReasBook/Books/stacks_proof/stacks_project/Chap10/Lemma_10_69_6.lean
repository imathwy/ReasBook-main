/-- Helper for Chap10 Lemma 10 69 6: after applying the explicit source-side multiplication map
by `X i`, the coefficient at `single i 1 + e` is the original coefficient at `e`. -/
private theorem sourceQuotientTensor_X_coeff
    {A : Type*} [CommRing A] {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A) (i : Fin rs.length)
    (z : TensorProduct (A ⧸ Ideal.ofList rs)
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
      (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)))
    (e : Fin rs.length →₀ ℕ) :
    (MvPolynomial.scalarRTensor (R := A ⧸ Ideal.ofList rs)
      (σ := Fin rs.length) (N := P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))
      (((LinearMap.mulLeft (A ⧸ Ideal.ofList rs)
        (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).rTensor
          (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))) z))
        (Finsupp.single i 1 + e) =
      (MvPolynomial.scalarRTensor (R := A ⧸ Ideal.ofList rs)
        (σ := Fin rs.length) (N := P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)) z) e := by
  -- The claim is checked on simple tensors, where it is exactly the coefficient formula for
  -- multiplying a multivariable polynomial by `X i`.
  induction z using TensorProduct.induction_on with
  | zero =>
      simp
  | tmul p q =>
      simp [LinearMap.rTensor_tmul, MvPolynomial.scalarRTensor_apply_tmul_apply,
        MvPolynomial.coeff_X_mul']
  | add x y hx hy =>
      simp [map_add, hx, hy]

