/-- Helper for Chap10 Lemma 10 69 6: in the internal associated-graded model, the head-variable
monomial action on a homogeneous class is represented by multiplying the representative by the
head monomial weight. -/
private theorem headVariableAction_lof_stageClass_raw
    {r : R} {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage (r :: rs) M n) :
    quasiRegularAssociatedGradedMonomialAction (r :: rs)
        (Finsupp.single (0 : Fin (r :: rs).length) 1)
        (DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n))) =
      DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
        (quasiRegularAssociatedGradedInternalPiece (r :: rs) M)
        (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1))
        (Submodule.Quotient.mk
          (⟨quasiRegularAssociatedGradedMonomialWeight (r :: rs)
              (Finsupp.single (0 : Fin (r :: rs).length) 1) • x,
            quasiRegularAssociatedGradedMonomialWeight_smul_mem_stage (r :: rs) n
              (Finsupp.single (0 : Fin (r :: rs).length) 1)
              (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n)⟩ :
            quasiRegularStage (r :: rs) M
              (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1)))) := by
  -- Reduce the polynomial action to the quotient-piece monomial computation on representatives.
  rw [quasiRegularAssociatedGradedMonomialAction_lof]
  rw [quasiRegularAssociatedGradedMonomialMapOnPiece_mk]

