/-- Helper for Chap10 Lemma 10 69 6: the homogeneous direct-sum generator attached to a
representative outside the next filtration stage is nonzero. -/
private theorem directSumLof_stageClass_ne_zero_of_not_mem_next
    {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage rs M n)
    (hxnext : x ∉ quasiRegularStage rs M (n + 1)) :
    DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (quasiRegularAssociatedGradedInternalPiece rs M) n
        (Submodule.Quotient.mk (⟨x, hx⟩ : quasiRegularStage rs M n)) ≠ 0 := by
  -- Project to the same homogeneous component, where `lof` is the identity.
  intro hzero
  have hcomp := congrArg (DirectSum.component (R ⧸ Ideal.ofList rs) ℕ
    (quasiRegularAssociatedGradedInternalPiece rs M) n) hzero
  rw [DirectSum.component.lof_self] at hcomp
  exact quotientStageClass_ne_zero_of_not_mem_next (M := M) hx hxnext hcomp

