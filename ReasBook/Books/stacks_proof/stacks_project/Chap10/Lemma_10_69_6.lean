/-- Helper for Chap10 Lemma 10 69 6: if the head element kills a stage representative, then the
head polynomial variable kills its public associated-graded class. -/
private theorem headVariable_smul_associatedGradedClass_eq_zero_of_smul_eq_zero
    {r : R} {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage (r :: rs) M n) (hrx : r • x = 0) :
    (MvPolynomial.X (0 : Fin (r :: rs).length) :
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) •
      ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M).symm
        (DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk
            (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n)))) = 0 := by
  -- Move the public class to the internal model, where the monomial action was computed on
  -- representatives by the previous helper.
  let y := DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk
            (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n))
  apply (quasiRegularAssociatedGradedAddEquiv (r :: rs) M).injective
  -- The public module structure was transported across `quasiRegularAssociatedGradedAddEquiv`,
  -- so applying the equivalence returns the internal monomial action.
  change
    (quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
      ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M).symm
        (quasiRegularAssociatedGradedPolynomialSmul (r :: rs)
          (MvPolynomial.X (0 : Fin (r :: rs).length))
          ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
            ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M).symm y)))) =
      (quasiRegularAssociatedGradedAddEquiv (r :: rs) M) 0
  rw [AddEquiv.apply_symm_apply]
  rw [AddEquiv.apply_symm_apply]
  rw [map_zero]
  rw [MvPolynomial.X]
