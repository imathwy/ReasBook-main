/-- Helper for Chap10 Lemma 10 69 6: the head element sends every `J^n M` representative into
the next filtration stage for `J = Ideal.ofList (r :: rs)`. -/
private theorem head_smul_mem_next_stage
    {r : R} {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage (r :: rs) M n) :
    r • x ∈ quasiRegularStage (r :: rs) M (n + 1) := by
  -- The head generator lies in the list-generated ideal, so multiplying raises the `J`-adic order.
  have hrJ : r ∈ quasiRegularIdeal (r :: rs) := by
    rw [quasiRegularIdeal, Ideal.ofList]
    exact Ideal.subset_span (by simp)
  change r • x ∈ (quasiRegularIdeal (r :: rs) ^ (n + 1)) • (⊤ : Submodule R M)
  rw [pow_succ']
  rw [mul_smul]
  exact Submodule.smul_mem_smul hrJ hx

