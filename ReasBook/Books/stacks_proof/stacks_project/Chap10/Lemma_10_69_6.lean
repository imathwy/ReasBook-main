/-- Helper for Chap10 Lemma 10 69 6: the imported tail-quotient theorem specializes to the
one-step quotient by the head element in the predecessor theorem's `Ideal.ofList [r]` normal form. -/
private theorem tailQuotient_one_ofListSingleton
    {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]
    {r : S} {rs : List S} (hqr : IsQuasiRegular N (r :: rs)) :
    IsQuasiRegular (N ⧸ (Ideal.ofList [r] • (⊤ : Submodule S N)))
      (rs.map (Ideal.Quotient.mk (Ideal.ofList [r]))) := by
  -- Normalize only `take 1`/`drop 1`; the quotient-to-`QuotSMulTop` transport is kept separate.
  simpa using
    (hqr.tail_quotient 1)

/-- Helper for Chap10 Lemma 10 69 6: an element of the maximal ideal remains in the maximal
ideal after any quotient map to a local quotient ring. -/
private theorem quotient_mk_mem_maximalIdeal_of_mem_maximalIdeal
    {S : Type*} [CommRing S] [IsLocalRing S] (I : Ideal S)
    [IsLocalRing (S ⧸ I)] {x : S} (hx : x ∈ IsLocalRing.maximalIdeal S) :
    Ideal.Quotient.mk I x ∈ IsLocalRing.maximalIdeal (S ⧸ I) := by
  -- Surjectivity of the quotient map identifies the image of the old maximal ideal with the new
  -- maximal ideal.
  have hmap :
      Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal S) =
        IsLocalRing.maximalIdeal (S ⧸ I) := by
    exact IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
  have hmem :
      Ideal.Quotient.mk I x ∈
        Ideal.map (Ideal.Quotient.mk I) (IsLocalRing.maximalIdeal S) := by
    refine (Ideal.mem_map_iff_of_surjective (f := Ideal.Quotient.mk I)
      (hf := Ideal.Quotient.mk_surjective) (I := IsLocalRing.maximalIdeal S)
      (y := Ideal.Quotient.mk I x)).2 ?_
    exact ⟨x, hx, rfl⟩
  simpa [hmap] using hmem

