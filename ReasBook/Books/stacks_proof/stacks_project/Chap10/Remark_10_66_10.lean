import Mathlib
import stacks_proof.stacks_project.Chap10.Definition_10_66_1

-- Declarations for this item will be appended below by the statement pipeline.

open MvPolynomial

attribute [local instance high] Semiring.toModule Algebra.toModule

universe u

noncomputable section

/-
Domain triage: this remark is in commutative algebra of weakly associated primes under scalar
restriction along a polynomial-ring map. The owner abstraction is the chapter declaration
`weaklyAssociatedPrimes R M`. The primitive data are the relation ideal defining the quotient ring
and the explicit source-facing ideal `q = Σ xᵢ S` in that quotient. The algebra structure from
`k[x₁, x₂, …]` is derived from the canonical `MvPolynomial.rename` map and the owner quotient
algebra instance, so it should stay local rather than as a parallel public wrapper.
-/

/-- The ideal `(xᵢ yᵢ \mid i \ge 0)` in
`k[x₁, x₂, x₃, \ldots, y₁, y₂, y₃, \ldots]`. -/
def pairwiseZeroProductRelationIdeal (k : Type u) [CommRing k] :
    Ideal (MvPolynomial (Sum ℕ ℕ) k) :=
  Ideal.span (Set.range fun n : ℕ ↦ X (Sum.inl n) * X (Sum.inr n))

/-- The quotient ring
`k[x₁, x₂, x₃, \ldots, y₁, y₂, y₃, \ldots] / (x₁ y₁, x₂ y₂, x₃ y₃, \ldots)`. -/
abbrev pairwiseZeroProductQuotient (k : Type u) [CommRing k] :=
  MvPolynomial (Sum ℕ ℕ) k ⧸ pairwiseZeroProductRelationIdeal k

/-- The ideal `q = Σ xᵢ S` in the quotient ring of Remark 10.66.10. -/
def pairwiseZeroProductXIdeal (k : Type u) [CommRing k] : Ideal (pairwiseZeroProductQuotient k) :=
  Ideal.span (Set.range fun n : ℕ ↦
    Ideal.Quotient.mk (pairwiseZeroProductRelationIdeal k) (X (Sum.inl n)))

/-- The ideal `(x₁, x₂, x₃, \ldots)` in `k[x₁, x₂, x₃, \ldots]`. -/
def infiniteVariableIdeal (k : Type u) [CommRing k] : Ideal (MvPolynomial ℕ k) :=
  Ideal.span (Set.range fun n : ℕ ↦ (X n : MvPolynomial ℕ k))

/-- Helper for Chap10 Remark 10 66 10: the ideal generated by the left variables `xᵢ` in
`k[xᵢ,yᵢ]`. -/
def leftVariableIdeal (k : Type u) [CommRing k] : Ideal (MvPolynomial (Sum ℕ ℕ) k) :=
  Ideal.span (X '' Set.range (Sum.inl : ℕ → Sum ℕ ℕ))

/-- Helper for Chap10 Remark 10 66 10: every relation `xᵢ yᵢ` lies in the left-variable ideal. -/
lemma pairwiseZeroProductRelationIdeal_le_leftVariableIdeal (k : Type u) [CommRing k] :
    pairwiseZeroProductRelationIdeal k ≤ leftVariableIdeal k := by
  -- It is enough to check the generators of the relation ideal.
  rw [pairwiseZeroProductRelationIdeal]
  refine Ideal.span_le.mpr ?_
  rintro p ⟨n, rfl⟩
  rw [leftVariableIdeal]
  -- Each generator `xᵢ yᵢ` is a multiple of the corresponding left variable `xᵢ`.
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨Sum.inl n, ⟨n, rfl⟩, rfl⟩)

/-- Helper for Chap10 Remark 10 66 10: the quotient ideal `q` is the image of the
left-variable ideal. -/
lemma pairwiseZeroProductXIdeal_eq_map_leftVariableIdeal (k : Type u) [CommRing k] :
    pairwiseZeroProductXIdeal k =
      Ideal.map (Ideal.Quotient.mk (pairwiseZeroProductRelationIdeal k)) (leftVariableIdeal k) := by
  -- Both sides are spans of the quotient classes of the left variables.
  rw [pairwiseZeroProductXIdeal, leftVariableIdeal, Ideal.map_span]
  congr 1
  ext z
  constructor
  · rintro ⟨n, rfl⟩
    exact ⟨X (Sum.inl n), ⟨Sum.inl n, ⟨n, rfl⟩, rfl⟩, rfl⟩
  · rintro ⟨p, ⟨i, ⟨n, rfl⟩, rfl⟩, rfl⟩
    exact ⟨n, rfl⟩

/-- Helper for Chap10 Remark 10 66 10: pulling `q` back to the polynomial ring recovers the
left-variable ideal. -/
lemma comap_quotientMk_pairwiseZeroProductXIdeal (k : Type u) [CommRing k] :
    Ideal.comap (Ideal.Quotient.mk (pairwiseZeroProductRelationIdeal k))
      (pairwiseZeroProductXIdeal k) = leftVariableIdeal k := by
  -- Use the quotient-map image/preimage formula, then absorb the relation ideal into `(xᵢ)`.
  rw [pairwiseZeroProductXIdeal_eq_map_leftVariableIdeal]
  rw [Ideal.comap_map_of_surjective _ Ideal.Quotient.mk_surjective]
  rw [← RingHom.ker_eq_comap_bot]
  rw [Ideal.mk_ker]
  rw [sup_eq_left]
  exact pairwiseZeroProductRelationIdeal_le_leftVariableIdeal k

/-- Helper for Chap10 Remark 10 66 10: the left-variable ideal contracts along `rename Sum.inl`
to the ideal generated by the variables of `k[xᵢ]`. -/
lemma comap_rename_leftVariableIdeal (k : Type u) [Field k] :
    Ideal.comap (rename (R := k) (Sum.inl : ℕ → Sum ℕ ℕ)).toRingHom (leftVariableIdeal k) =
      infiniteVariableIdeal k := by
  classical
  -- Compare both ideals by the standard support criterion for spans of variables.
  ext r
  rw [Ideal.mem_comap, leftVariableIdeal, infiniteVariableIdeal]
  rw [show Set.range (fun n : ℕ ↦ (X n : MvPolynomial ℕ k)) =
      X '' (Set.univ : Set ℕ) by
    ext z
    constructor
    · rintro ⟨n, rfl⟩
      exact ⟨n, trivial, rfl⟩
    · rintro ⟨n, -, rfl⟩
      exact ⟨n, rfl⟩]
  rw [MvPolynomial.mem_ideal_span_X_image, MvPolynomial.mem_ideal_span_X_image]
  constructor
  · intro h m hm
    -- A support monomial of `r` renames to a support monomial of `rename Sum.inl r`.
    have hm' :
        Finsupp.mapDomain (Sum.inl : ℕ → Sum ℕ ℕ) m ∈ ((rename Sum.inl) r).support := by
      rw [MvPolynomial.support_rename_of_injective
        (Sum.inl_injective : Function.Injective (Sum.inl : ℕ → Sum ℕ ℕ))]
      exact Finset.mem_image.mpr ⟨m, hm, rfl⟩
    rcases h _ hm' with ⟨i, hi, hne⟩
    rcases hi with ⟨j, rfl⟩
    exact ⟨j, trivial,
      by
        simpa [Finsupp.mapDomain_apply
          (Sum.inl_injective : Function.Injective (Sum.inl : ℕ → Sum ℕ ℕ)) m j] using hne⟩
  · intro h m hm
    -- Conversely, every support monomial after renaming comes from a support monomial of `r`.
    change m ∈ ((rename Sum.inl) r).support at hm
    rw [MvPolynomial.support_rename_of_injective
      (Sum.inl_injective : Function.Injective (Sum.inl : ℕ → Sum ℕ ℕ))] at hm
    rcases Finset.mem_image.mp hm with ⟨m0, hm0, rfl⟩
    rcases h m0 hm0 with ⟨i, hi, hne⟩
    refine ⟨Sum.inl i, ⟨i, rfl⟩, ?_⟩
    simpa [Finsupp.mapDomain_apply
      (Sum.inl_injective : Function.Injective (Sum.inl : ℕ → Sum ℕ ℕ)) m0 i] using hne

section

variable (k : Type u) [Field k]

local notation "R∞" => MvPolynomial ℕ k
local notation "S∞" => pairwiseZeroProductQuotient k

local instance : Algebra R∞ (MvPolynomial (Sum ℕ ℕ) k) :=
  RingHom.toAlgebra (rename Sum.inl).toRingHom

local instance : Algebra R∞ S∞ :=
  Ideal.Quotient.algebra R∞

/-- Helper for Chap10 Remark 10 66 10: the left-variable ideal is contained in the kernel of
the projection that kills the left variables and keeps the right variables. -/
lemma leftVariableIdeal_le_ker_killCompl_right :
    leftVariableIdeal k ≤ RingHom.ker (MvPolynomial.killCompl
      (R := k) (Sum.inr_injective : Function.Injective (Sum.inr : ℕ → Sum ℕ ℕ))).toRingHom := by
  -- Check the containment on the left-variable generators.
  rw [leftVariableIdeal]
  refine Ideal.span_le.mpr ?_
  rintro z ⟨i, ⟨n, rfl⟩, rfl⟩
  change (MvPolynomial.killCompl
      (R := k) (Sum.inr_injective : Function.Injective (Sum.inr : ℕ → Sum ℕ ℕ)))
        (X (Sum.inl n)) = 0
  -- The `killCompl Sum.inr` map kills precisely the variables outside the right-variable range.
  simp [MvPolynomial.killCompl]

/-- Helper for Chap10 Remark 10 66 10: an element killed by the right-variable projection lies in
the left-variable ideal. -/
lemma ker_killCompl_right_le_leftVariableIdeal :
    RingHom.ker (MvPolynomial.killCompl
      (R := k) (Sum.inr_injective : Function.Injective (Sum.inr : ℕ → Sum ℕ ℕ))).toRingHom ≤
        leftVariableIdeal k := by
  intro p hp
  -- Use the monomial support criterion for the ideal generated by the left variables.
  rw [leftVariableIdeal, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  by_contra hnone
  push Not at hnone
  have hsubset : (m.support : Set (Sum ℕ ℕ)) ⊆ Set.range (Sum.inr : ℕ → Sum ℕ ℕ) := by
    intro a ha
    cases a with
    | inl n =>
        have hzero := hnone (Sum.inl n) ⟨n, rfl⟩
        exact False.elim ((Finsupp.mem_support_iff.mp ha) hzero)
    | inr n => exact ⟨n, rfl⟩
  let r : ℕ →₀ ℕ :=
    Finsupp.comapDomain (Sum.inr : ℕ → Sum ℕ ℕ) m Sum.inr_injective.injOn
  have hmap : r.mapDomain (Sum.inr : ℕ → Sum ℕ ℕ) = m := by
    simpa [r] using Finsupp.mapDomain_comapDomain
      (f := (Sum.inr : ℕ → Sum ℕ ℕ))
      (Sum.inr_injective : Function.Injective (Sum.inr : ℕ → Sum ℕ ℕ)) m hsubset
  have hcoeff :
      ((MvPolynomial.killCompl
        (R := k) (Sum.inr_injective : Function.Injective (Sum.inr : ℕ → Sum ℕ ℕ))) p).coeff r =
        0 := by
    rw [RingHom.mem_ker] at hp
    simpa using congrArg (fun q : MvPolynomial ℕ k => q.coeff r) hp
  have hpcoeff : p.coeff m = 0 := by
    rw [MvPolynomial.coeff_killCompl] at hcoeff
    rwa [hmap] at hcoeff
  exact (MvPolynomial.mem_support_iff.mp hm) hpcoeff

/-- Helper for Chap10 Remark 10 66 10: the left-variable ideal is the kernel of
`killCompl Sum.inr`. -/
lemma leftVariableIdeal_eq_ker_killCompl_right :
    leftVariableIdeal k = RingHom.ker (MvPolynomial.killCompl
      (R := k) (Sum.inr_injective : Function.Injective (Sum.inr : ℕ → Sum ℕ ℕ))).toRingHom := by
  -- Combine the generator containment with the coefficient-support converse.
  exact le_antisymm (leftVariableIdeal_le_ker_killCompl_right k)
    (ker_killCompl_right_le_leftVariableIdeal k)

/-- Helper for Chap10 Remark 10 66 10: a right variable is not in the left-variable ideal. -/
lemma rightVariable_not_mem_leftVariableIdeal (n : ℕ) :
    (X (Sum.inr n) : MvPolynomial (Sum ℕ ℕ) k) ∉ leftVariableIdeal k := by
  -- A right-variable monomial has no left variable in its support.
  rw [leftVariableIdeal, MvPolynomial.mem_ideal_span_X_image]
  intro h
  have hs : Finsupp.single (Sum.inr n) 1 ∈
      (X (Sum.inr n) : MvPolynomial (Sum ℕ ℕ) k).support := by
    simp [X]
  rcases h _ hs with ⟨i, hi, hne⟩
  rcases hi with ⟨j, rfl⟩
  simpa using hne

/-- Helper for Chap10 Remark 10 66 10: the left-variable ideal in `k[xᵢ,yᵢ]` is prime. -/
lemma leftVariableIdeal_isPrime :
    (leftVariableIdeal k).IsPrime := by
  -- Rewrite the ideal as a kernel into a polynomial domain.
  rw [leftVariableIdeal_eq_ker_killCompl_right]
  exact RingHom.ker_isPrime _

/-- Helper for Chap10 Remark 10 66 10: `q` is a minimal prime of the quotient ring. -/
lemma pairwiseZeroProductXIdeal_mem_minimalPrimes_bot :
    pairwiseZeroProductXIdeal k ∈ (⊥ : Ideal S∞).minimalPrimes := by
  refine ⟨⟨?_, bot_le⟩, ?_⟩
  · -- Primality of `q` is the image of the prime left-variable ideal through the quotient map.
    rw [pairwiseZeroProductXIdeal_eq_map_leftVariableIdeal]
    letI : (leftVariableIdeal k).IsPrime := leftVariableIdeal_isPrime k
    exact Ideal.isPrime_map_quotientMk_of_isPrime
      (pairwiseZeroProductRelationIdeal_le_leftVariableIdeal k)
  · intro P hP hP_le_q
    -- Minimality: a smaller prime contains every `xᵢ`, because `xᵢ yᵢ = 0` and `yᵢ ∉ q`.
    rw [pairwiseZeroProductXIdeal]
    refine Ideal.span_le.mpr ?_
    rintro z ⟨n, rfl⟩
    have hrel_zero :
        Ideal.Quotient.mk (pairwiseZeroProductRelationIdeal k)
          (X (Sum.inl n) * X (Sum.inr n)) = (0 : S∞) := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨n, rfl⟩)
    have hmul_mem :
        Ideal.Quotient.mk (pairwiseZeroProductRelationIdeal k) (X (Sum.inl n)) *
          Ideal.Quotient.mk (pairwiseZeroProductRelationIdeal k) (X (Sum.inr n)) ∈ P := by
      rw [← map_mul, hrel_zero]
      exact P.zero_mem
    rcases hP.1.mem_or_mem hmul_mem with hx | hy
    · exact hx
    · have hy_q :
          Ideal.Quotient.mk (pairwiseZeroProductRelationIdeal k) (X (Sum.inr n)) ∈
            pairwiseZeroProductXIdeal k := hP_le_q hy
      have hy_left :
          (X (Sum.inr n) : MvPolynomial (Sum ℕ ℕ) k) ∈ leftVariableIdeal k := by
        rw [← comap_quotientMk_pairwiseZeroProductXIdeal k]
        exact hy_q
      exact False.elim (rightVariable_not_mem_leftVariableIdeal k n hy_left)

/-- Helper for Chap10 Remark 10 66 10: the ideal of `R∞` generated by all variables except
`X n`. -/
def omitVariableIdeal (n : ℕ) : Ideal R∞ :=
  Ideal.span (X '' {m : ℕ | m ≠ n})

/-- Helper for Chap10 Remark 10 66 10: the map from `PUnit` to the selected variable `n` is
injective. -/
lemma keepVariable_injective (n : ℕ) : Function.Injective (fun _ : PUnit.{1} => n) := by
  -- The source has only one element.
  intro a b h
  cases a
  cases b
  rfl

/-- Helper for Chap10 Remark 10 66 10: the omit-variable ideal is contained in the kernel of the
projection that keeps only `X n`. -/
lemma omitVariableIdeal_le_ker_killCompl (n : ℕ) :
    omitVariableIdeal k n ≤ RingHom.ker (MvPolynomial.killCompl
      (R := k) (f := (fun _ : PUnit.{1} => n)) (keepVariable_injective n)).toRingHom := by
  -- Check the kernel containment on generators `X i` with `i ≠ n`.
  rw [omitVariableIdeal]
  refine Ideal.span_le.mpr ?_
  rintro z ⟨i, hi, rfl⟩
  change
    (MvPolynomial.killCompl (R := k) (f := (fun _ : PUnit.{1} => n))
      (keepVariable_injective n)) (X i) =
      0
  have hi_range : i ∉ Set.range (fun _ : PUnit.{1} => n) := by
    rintro ⟨u, rfl⟩
    exact hi rfl
  simpa [MvPolynomial.killCompl, hi_range]

/-- Helper for Chap10 Remark 10 66 10: the kernel of the projection keeping only `X n` is
contained in the omit-variable ideal. -/
lemma ker_killCompl_le_omitVariableIdeal (n : ℕ) :
    RingHom.ker (MvPolynomial.killCompl
      (R := k) (f := (fun _ : PUnit.{1} => n)) (keepVariable_injective n)).toRingHom ≤
        omitVariableIdeal k n := by
  intro p hp
  -- The support criterion reduces the goal to finding a variable different from `n`.
  rw [omitVariableIdeal, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  by_contra hnone
  push Not at hnone
  have hsubset : (m.support : Set ℕ) ⊆ Set.range (fun _ : PUnit => n) := by
    intro a ha
    by_cases han : a = n
    · exact ⟨PUnit.unit, han.symm⟩
    · exact False.elim ((Finsupp.mem_support_iff.mp ha) (hnone a han))
  let r : PUnit.{1} →₀ ℕ :=
    Finsupp.comapDomain (fun _ : PUnit.{1} => n) m
      (keepVariable_injective n).injOn
  have hmap : r.mapDomain (fun _ : PUnit.{1} => n) = m := by
    simpa [r] using Finsupp.mapDomain_comapDomain
      (f := (fun _ : PUnit.{1} => n)) (keepVariable_injective n) m
      hsubset
  have hcoeff :
      ((MvPolynomial.killCompl (R := k) (f := (fun _ : PUnit.{1} => n))
        (keepVariable_injective n)) p).coeff
        r = 0 := by
    rw [RingHom.mem_ker] at hp
    simpa using congrArg (fun q : MvPolynomial PUnit.{1} k => q.coeff r) hp
  have hpcoeff : p.coeff m = 0 := by
    rw [MvPolynomial.coeff_killCompl] at hcoeff
    rwa [hmap] at hcoeff
  exact (MvPolynomial.mem_support_iff.mp hm) hpcoeff

/-- Helper for Chap10 Remark 10 66 10: the omit-variable ideal is the kernel of the projection
that keeps only `X n`. -/
lemma omitVariableIdeal_eq_ker_killCompl (n : ℕ) :
    omitVariableIdeal k n = RingHom.ker (MvPolynomial.killCompl
      (R := k) (f := (fun _ : PUnit.{1} => n)) (keepVariable_injective n)).toRingHom := by
  -- Combine the generator containment and the coefficient-support converse.
  exact le_antisymm (omitVariableIdeal_le_ker_killCompl k n)
    (ker_killCompl_le_omitVariableIdeal k n)

/-- Helper for Chap10 Remark 10 66 10: the omit-variable ideal is prime. -/
lemma omitVariableIdeal_isPrime (n : ℕ) :
    (omitVariableIdeal k n).IsPrime := by
  -- Rewrite the ideal as a kernel into the one-variable polynomial domain.
  rw [omitVariableIdeal_eq_ker_killCompl]
  exact RingHom.ker_isPrime _

/-- Helper for Chap10 Remark 10 66 10: the omitted variable `X n` is not in
`omitVariableIdeal k n`. -/
lemma variable_not_mem_omitVariableIdeal (n : ℕ) :
    (X n : R∞) ∉ omitVariableIdeal k n := by
  -- The monomial support criterion detects that `X n` uses no generator with index different
  -- from `n`.
  rw [omitVariableIdeal, MvPolynomial.mem_ideal_span_X_image]
  intro h
  have hs : Finsupp.single n 1 ∈ (X n : R∞).support := by
    simp [X]
  rcases h _ hs with ⟨i, hi, hne⟩
  exact hi (Finsupp.single_apply_ne_zero.mp hne).1

/-- Helper for Chap10 Remark 10 66 10: omitting one variable gives a prime strictly below the
infinite-variable ideal. -/
lemma omitVariableIdeal_lt_infiniteVariableIdeal (n : ℕ) :
    omitVariableIdeal k n < infiniteVariableIdeal k := by
  -- Inclusion is by generators; strictness is witnessed by the omitted variable `X n`.
  refine lt_of_le_of_ne ?_ ?_
  · rw [omitVariableIdeal, infiniteVariableIdeal]
    refine Ideal.span_mono ?_
    rintro z ⟨i, hi, rfl⟩
    exact ⟨i, rfl⟩
  · intro h_eq
    have hx_inf : (X n : R∞) ∈ infiniteVariableIdeal k := by
      rw [infiniteVariableIdeal]
      exact Ideal.subset_span ⟨n, rfl⟩
    have hx_omit : (X n : R∞) ∈ omitVariableIdeal k n := by
      simpa [h_eq] using hx_inf
    exact variable_not_mem_omitVariableIdeal k n hx_omit

/-- Helper for Chap10 Remark 10 66 10: the monomial `xᵢ yᵢ` as an exponent vector. -/
def pairwiseRelationMonomial (i : ℕ) : Sum ℕ ℕ →₀ ℕ :=
  Finsupp.single (Sum.inl i) 1 + Finsupp.single (Sum.inr i) 1

/-- Helper for Chap10 Remark 10 66 10: the right-variable support of a monomial. -/
def rightSupportOfMonomial (m : Sum ℕ ℕ →₀ ℕ) : Finset ℕ :=
  m.support.toRight

/-- Helper for Chap10 Remark 10 66 10: the ideal generated by a finite set of source variables. -/
def finiteVariableIdeal (T : Finset ℕ) : Ideal R∞ :=
  Ideal.span (X '' (T : Set ℕ))

/-- Helper for Chap10 Remark 10 66 10: the variables kept by the projection attached to a
monomial, keeping `yᵢ` exactly when the monomial uses `yᵢ` and otherwise keeping `xᵢ`. -/
def monomialKeepSet (m : Sum ℕ ℕ →₀ ℕ) : Set (Sum ℕ ℕ) :=
  {v | Sum.elim (fun i : ℕ => m (Sum.inr i) = 0) (fun i : ℕ => m (Sum.inr i) ≠ 0) v}

/-- Helper for Chap10 Remark 10 66 10: the `killCompl` projection determined by the right
support of a monomial. -/
def keepByRightSupport (m : Sum ℕ ℕ →₀ ℕ) :
    MvPolynomial (Sum ℕ ℕ) k →ₐ[k] MvPolynomial {v // v ∈ monomialKeepSet m} k :=
  MvPolynomial.killCompl (R := k)
    (f := (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ)) Subtype.val_injective

/-- Helper for Chap10 Remark 10 66 10: the projection attached to a monomial kills each
relation generator `xᵢ yᵢ`. -/
lemma keepByRightSupport_relation (m : Sum ℕ ℕ →₀ ℕ) (i : ℕ) :
    keepByRightSupport k m (X (Sum.inl i) * X (Sum.inr i)) = 0 := by
  -- The projection keeps exactly one of `xᵢ` and `yᵢ`, so their product maps to zero.
  by_cases hi : m (Sum.inr i) = 0
  · have hy_not :
        Sum.inr i ∉
          Set.range (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ) := by
      rintro ⟨v, hv⟩
      have hy : Sum.inr i ∈ monomialKeepSet m := hv ▸ v.property
      simpa [monomialKeepSet, hi] using hy
    rw [map_mul]
    suffices keepByRightSupport k m (X (Sum.inr i)) = 0 by rw [this, mul_zero]
    change (MvPolynomial.killCompl (R := k)
      (f := (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ))
      Subtype.val_injective) (X (Sum.inr i)) = 0
    rw [X]
    exact MvPolynomial.killCompl_monomial_eq_zero_of_notMem_range
      (f := (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ))
      Subtype.val_injective (1 : k) (by simp) hy_not
  · have hx_not :
        Sum.inl i ∉
          Set.range (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ) := by
      rintro ⟨v, hv⟩
      have hx : Sum.inl i ∈ monomialKeepSet m := hv ▸ v.property
      exact hi (by simpa [monomialKeepSet] using hx)
    rw [map_mul]
    suffices keepByRightSupport k m (X (Sum.inl i)) = 0 by rw [this, zero_mul]
    change (MvPolynomial.killCompl (R := k)
      (f := (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ))
      Subtype.val_injective) (X (Sum.inl i)) = 0
    rw [X]
    exact MvPolynomial.killCompl_monomial_eq_zero_of_notMem_range
      (f := (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ))
      Subtype.val_injective (1 : k) (by simp) hx_not

/-- Helper for Chap10 Remark 10 66 10: the relation ideal lies in the kernel of the projection
attached to any monomial. -/
lemma pairwiseZeroProductRelationIdeal_le_ker_keepByRightSupport
    (m : Sum ℕ ℕ →₀ ℕ) :
    pairwiseZeroProductRelationIdeal k ≤ RingHom.ker (keepByRightSupport k m).toRingHom := by
  -- Check the kernel condition on the spanning relation generators.
  rw [pairwiseZeroProductRelationIdeal]
  refine Ideal.span_le.mpr ?_
  rintro z ⟨i, rfl⟩
  change keepByRightSupport k m (X (Sum.inl i) * X (Sum.inr i)) = 0
  exact keepByRightSupport_relation k m i

/-- Helper for Chap10 Remark 10 66 10: membership in the monomial relation ideal is detected
on support monomials by divisibility by some `xᵢ yᵢ`. -/
lemma mem_pairwiseZeroProductRelationIdeal_iff (p : MvPolynomial (Sum ℕ ℕ) k) :
    p ∈ pairwiseZeroProductRelationIdeal k ↔
      ∀ m ∈ p.support, ∃ i : ℕ, pairwiseRelationMonomial i ≤ m := by
  -- Rewrite the displayed generators as monomials and use mathlib's monomial-ideal criterion.
  rw [pairwiseZeroProductRelationIdeal]
  rw [show Set.range (fun n : ℕ =>
        (X (Sum.inl n) * X (Sum.inr n) : MvPolynomial (Sum ℕ ℕ) k)) =
      (fun s : Sum ℕ ℕ →₀ ℕ => monomial s (1 : k)) ''
        Set.range pairwiseRelationMonomial by
    ext z
    constructor
    · rintro ⟨n, rfl⟩
      refine ⟨pairwiseRelationMonomial n, ⟨n, rfl⟩, ?_⟩
      calc
        monomial (pairwiseRelationMonomial n) (1 : k)
            = monomial (Finsupp.single (Sum.inl n) 1) (1 : k) *
                monomial (Finsupp.single (Sum.inr n) 1) (1 : k) := by
              rw [monomial_mul, one_mul, pairwiseRelationMonomial]
        _ = X (Sum.inl n) * X (Sum.inr n) := by
              rw [← C_mul_X_eq_monomial, ← C_mul_X_eq_monomial]
              simp
    · rintro ⟨m, ⟨n, rfl⟩, rfl⟩
      refine ⟨n, ?_⟩
      calc
        X (Sum.inl n) * X (Sum.inr n)
            = monomial (Finsupp.single (Sum.inl n) 1) (1 : k) *
                monomial (Finsupp.single (Sum.inr n) 1) (1 : k) := by
              rw [← C_mul_X_eq_monomial, ← C_mul_X_eq_monomial]
              simp
        _ = monomial (pairwiseRelationMonomial n) (1 : k) := by
              rw [monomial_mul, one_mul, pairwiseRelationMonomial]]
  rw [MvPolynomial.mem_ideal_span_monomial_image]
  constructor
  · intro h m hm
    rcases h m hm with ⟨s, ⟨i, rfl⟩, hs⟩
    exact ⟨i, hs⟩
  · intro h m hm
    rcases h m hm with ⟨i, hi⟩
    exact ⟨pairwiseRelationMonomial i, ⟨i, rfl⟩, hi⟩

/-- Helper for Chap10 Remark 10 66 10: a polynomial not in the relation ideal has a support
monomial using no pair `xᵢ,yᵢ` simultaneously. -/
lemma exists_pairwiseStandardMonomial_of_not_mem_relation
    {p : MvPolynomial (Sum ℕ ℕ) k}
    (hp : p ∉ pairwiseZeroProductRelationIdeal k) :
    ∃ m ∈ p.support, ∀ i : ℕ, m (Sum.inl i) = 0 ∨ m (Sum.inr i) = 0 := by
  -- Negate the support criterion to isolate one monomial not divisible by any `xᵢ yᵢ`.
  rw [mem_pairwiseZeroProductRelationIdeal_iff] at hp
  push Not at hp
  rcases hp with ⟨m, hm, hnot⟩
  refine ⟨m, hm, fun i => ?_⟩
  by_contra hboth
  push Not at hboth
  exact hnot i (by
    intro v
    cases v with
    | inl j =>
        by_cases hji : j = i
        · subst j
          simpa [pairwiseRelationMonomial] using
            (Nat.one_le_iff_ne_zero.mpr hboth.1)
        · simp [pairwiseRelationMonomial, hji]
    | inr j =>
        by_cases hji : j = i
        · subst j
          simpa [pairwiseRelationMonomial] using
            (Nat.one_le_iff_ne_zero.mpr hboth.2)
        · simp [pairwiseRelationMonomial, hji])

/-- Helper for Chap10 Remark 10 66 10: a standard support monomial survives its attached
projection, so the projected polynomial is nonzero. -/
lemma keepByRightSupport_ne_zero_of_standard_mem_support
    {m : Sum ℕ ℕ →₀ ℕ} {p : MvPolynomial (Sum ℕ ℕ) k}
    (hm : m ∈ p.support) (hstd : ∀ i : ℕ, m (Sum.inl i) = 0 ∨ m (Sum.inr i) = 0) :
    keepByRightSupport k m p ≠ 0 := by
  -- Read off the coefficient of the surviving image of `m`.
  let r : {v // v ∈ monomialKeepSet m} →₀ ℕ :=
    Finsupp.comapDomain
      (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ) m
      Subtype.val_injective.injOn
  have hsubset : (m.support : Set (Sum ℕ ℕ)) ⊆
      Set.range (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ) := by
    intro a ha
    refine ⟨⟨a, ?_⟩, rfl⟩
    cases a with
    | inl i =>
        have hxi : m (Sum.inl i) ≠ 0 := Finsupp.mem_support_iff.mp ha
        rcases hstd i with hzero | hyzero
        · exact False.elim (hxi hzero)
        · simpa [monomialKeepSet] using hyzero
    | inr i =>
        have hy : m (Sum.inr i) ≠ 0 := Finsupp.mem_support_iff.mp ha
        simpa [monomialKeepSet] using hy
  have hmap : r.mapDomain
      (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ) = m := by
    simpa [r] using Finsupp.mapDomain_comapDomain
      (f := (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ))
      Subtype.val_injective m hsubset
  have hcoeff : (keepByRightSupport k m p).coeff r = p.coeff m := by
    rw [keepByRightSupport, MvPolynomial.coeff_killCompl, hmap]
  intro hpzero
  have : p.coeff m = 0 := by
    simpa [hpzero] using hcoeff.symm
  exact (MvPolynomial.mem_support_iff.mp hm) this

/-- Helper for Chap10 Remark 10 66 10: a source polynomial outside the finite ideal attached to
a monomial has nonzero image under the same projection. -/
lemma keep_rename_ne_zero_of_not_mem_finiteVariableIdeal
    (m : Sum ℕ ℕ →₀ ℕ) {r : R∞}
    (hr : r ∉ finiteVariableIdeal k (rightSupportOfMonomial m)) :
    keepByRightSupport k m ((rename Sum.inl) r) ≠ 0 := by
  -- Choose a source monomial avoiding the finite right support and read off its surviving
  -- coefficient after renaming and projecting.
  rw [finiteVariableIdeal, MvPolynomial.mem_ideal_span_X_image] at hr
  push Not at hr
  rcases hr with ⟨a, ha, havoid⟩
  let b0 : Sum ℕ ℕ →₀ ℕ := a.mapDomain (Sum.inl : ℕ → Sum ℕ ℕ)
  let b : {v // v ∈ monomialKeepSet m} →₀ ℕ :=
    Finsupp.comapDomain
      (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ) b0
      Subtype.val_injective.injOn
  have hsubset : (b0.support : Set (Sum ℕ ℕ)) ⊆
      Set.range (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ) := by
    intro v hv
    refine ⟨⟨v, ?_⟩, rfl⟩
    cases v with
    | inl i =>
        by_cases hmy : m (Sum.inr i) = 0
        · simpa [monomialKeepSet] using hmy
        · have hiT : i ∈ rightSupportOfMonomial m := by
            simp [rightSupportOfMonomial, hmy]
          have hai : a i = 0 := havoid i hiT
          have hbzero : b0 (Sum.inl i) = 0 := by
            rw [show b0 (Sum.inl i) = a i by
              exact Finsupp.mapDomain_apply
                (Sum.inl_injective : Function.Injective (Sum.inl : ℕ → Sum ℕ ℕ)) a i]
            exact hai
          exact False.elim ((Finsupp.mem_support_iff.mp hv) hbzero)
    | inr i =>
        have hbzero : b0 (Sum.inr i) = 0 := by
          exact Finsupp.mapDomain_notin_range a (Sum.inr i) (by
            rintro ⟨j, hji⟩
            cases hji)
        exact False.elim ((Finsupp.mem_support_iff.mp hv) hbzero)
  have hmap : b.mapDomain
      (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ) = b0 := by
    simpa [b] using Finsupp.mapDomain_comapDomain
      (f := (Subtype.val : {v // v ∈ monomialKeepSet m} → Sum ℕ ℕ))
      Subtype.val_injective b0 hsubset
  have hcoeff : (keepByRightSupport k m ((rename Sum.inl) r)).coeff b = r.coeff a := by
    rw [keepByRightSupport, MvPolynomial.coeff_killCompl, hmap]
    exact MvPolynomial.coeff_rename_mapDomain
      (Sum.inl : ℕ → Sum ℕ ℕ)
      (Sum.inl_injective : Function.Injective (Sum.inl : ℕ → Sum ℕ ℕ)) r a
  intro hzero
  have : r.coeff a = 0 := by
    simpa [hzero] using hcoeff.symm
  exact (MvPolynomial.mem_support_iff.mp ha) this

/-- Helper for Chap10 Remark 10 66 10: multiplying a nonzero quotient representative by a
source polynomial can land in the relation ideal only if the source polynomial lies in a finite
variable ideal. -/
lemma exists_finiteVariableIdeal_of_relation_annihilator
    {p : MvPolynomial (Sum ℕ ℕ) k} (hp : p ∉ pairwiseZeroProductRelationIdeal k) :
    ∃ T : Finset ℕ, ∀ r : R∞,
      (rename Sum.inl r) * p ∈ pairwiseZeroProductRelationIdeal k → r ∈ finiteVariableIdeal k T := by
  -- Pick a standard monomial in `p`; the attached projection sends the relation ideal to zero
  -- but preserves both that monomial and every source polynomial outside its finite ideal.
  rcases exists_pairwiseStandardMonomial_of_not_mem_relation k hp with ⟨m, hm, hstd⟩
  refine ⟨rightSupportOfMonomial m, fun r hprod => ?_⟩
  by_contra hr
  have hkr := keep_rename_ne_zero_of_not_mem_finiteVariableIdeal k m hr
  have hkp := keepByRightSupport_ne_zero_of_standard_mem_support k hm hstd
  have hzero : keepByRightSupport k m ((rename Sum.inl r) * p) = 0 := by
    exact RingHom.mem_ker.mp
      (pairwiseZeroProductRelationIdeal_le_ker_keepByRightSupport k m hprod)
  have hmulzero :
      keepByRightSupport k m ((rename Sum.inl r) * p) =
        keepByRightSupport k m ((rename Sum.inl) r) * keepByRightSupport k m p := by
    simp
  exact (mul_ne_zero hkr hkp) (by simpa [hmulzero] using hzero)

/-- Helper for Chap10 Remark 10 66 10: a finite source-variable ideal is contained in an
omit-variable ideal after choosing a variable outside the finite set. -/
lemma finiteVariableIdeal_le_omitVariableIdeal {T : Finset ℕ} {n : ℕ} (hn : n ∉ T) :
    finiteVariableIdeal k T ≤ omitVariableIdeal k n := by
  -- Each finite generator has index different from the omitted variable.
  rw [finiteVariableIdeal, omitVariableIdeal]
  refine Ideal.span_mono ?_
  rintro z ⟨i, hi, rfl⟩
  exact ⟨i, fun hin => hn (hin ▸ hi), rfl⟩

/-- Helper for Chap10 Remark 10 66 10: every finite set of natural numbers omits some natural
number. -/
lemma exists_nat_not_mem_finset (T : Finset ℕ) : ∃ n : ℕ, n ∉ T := by
  -- Take a number strictly larger than the finite supremum.
  refine ⟨T.sup id + 1, ?_⟩
  intro hmem
  have hle : T.sup id + 1 ≤ T.sup id := Finset.le_sup (f := id) hmem
  omega

/-- Helper for Chap10 Remark 10 66 10: the annihilator of a nonzero quotient element is contained
in an ideal omitting at least one source variable. -/
lemma exists_torsionOf_le_omitVariableIdeal
    (s : S∞) (hs : s ≠ 0) :
    ∃ n : ℕ, Ideal.torsionOf R∞ S∞ s ≤ omitVariableIdeal k n := by
  -- Lift `s` to a polynomial representative and convert nonzeroness to nonmembership in the
  -- relation ideal.
  rcases Ideal.Quotient.mk_surjective s with ⟨p, rfl⟩
  have hp : p ∉ pairwiseZeroProductRelationIdeal k := by
    intro hp
    exact hs (Ideal.Quotient.eq_zero_iff_mem.mpr hp)
  -- The projection argument puts the annihilator inside a finite source-variable ideal.
  rcases exists_finiteVariableIdeal_of_relation_annihilator k hp with ⟨T, hT⟩
  rcases exists_nat_not_mem_finset T with ⟨n, hn⟩
  refine ⟨n, le_trans ?_ (finiteVariableIdeal_le_omitVariableIdeal k hn)⟩
  intro r hr
  rw [Ideal.mem_torsionOf_iff] at hr
  exact hT r (by
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    simpa [Algebra.smul_def] using hr)

/-- Helper for Chap10 Remark 10 66 10: every nonzero element has an annihilator contained in a
strictly smaller prime than `(x₁,x₂,\ldots)`. -/
lemma exists_prime_between_torsionOf_and_infiniteVariableIdeal
    (s : S∞) (hs : s ≠ 0) :
    ∃ J : Ideal R∞, J.IsPrime ∧ Ideal.torsionOf R∞ S∞ s ≤ J ∧ J < infiniteVariableIdeal k := by
  -- Use the omit-variable prime supplied by the finite-support annihilator containment.
  rcases exists_torsionOf_le_omitVariableIdeal k s hs with ⟨n, hn⟩
  exact ⟨omitVariableIdeal k n, omitVariableIdeal_isPrime k n, hn,
    omitVariableIdeal_lt_infiniteVariableIdeal k n⟩

/-- The source-facing ideal `q = Σ xᵢ S` is a prime ideal of the counterexample ring. -/
theorem pairwiseZeroProductXIdeal_isPrime :
    (pairwiseZeroProductXIdeal k).IsPrime := by
  -- Push primality through the quotient map from the prime left-variable ideal.
  rw [pairwiseZeroProductXIdeal_eq_map_leftVariableIdeal]
  letI : (leftVariableIdeal k).IsPrime := leftVariableIdeal_isPrime k
  exact Ideal.isPrime_map_quotientMk_of_isPrime
    (pairwiseZeroProductRelationIdeal_le_leftVariableIdeal k)

/-- The source-facing ideal `q = Σ xᵢ S` is weakly associated to `S` as an `S`-module. -/
theorem pairwiseZeroProductXIdeal_mem_weaklyAssociatedPrimes_self :
    pairwiseZeroProductXIdeal k ∈ weaklyAssociatedPrimes S∞ S∞ := by
  -- Witness weak association by `1`; its annihilator as an `S`-module element is `⊥`.
  rw [mem_weaklyAssociatedPrimes_iff]
  refine ⟨(1 : S∞), ?_⟩
  have htorsion : Ideal.torsionOf S∞ S∞ (1 : S∞) = ⊥ := by
    ext r
    rw [Ideal.mem_torsionOf_iff, Ideal.mem_bot]
    simp
  simpa [htorsion] using pairwiseZeroProductXIdeal_mem_minimalPrimes_bot k

/-- Contracting `q = Σ xᵢ S` along `k[x₁, x₂, x₃, \ldots] → S` gives `(x₁, x₂, x₃, \ldots)`. -/
theorem comap_pairwiseZeroProductXIdeal :
    Ideal.comap (algebraMap R∞ S∞) (pairwiseZeroProductXIdeal k) = infiniteVariableIdeal k := by
  -- The algebra map is `rename Sum.inl` followed by the quotient map, so compute the two comaps.
  rw [← comap_rename_leftVariableIdeal k]
  ext r
  rw [Ideal.mem_comap, Ideal.mem_comap]
  change
    Ideal.Quotient.mk (pairwiseZeroProductRelationIdeal k) ((rename Sum.inl) r) ∈
        pairwiseZeroProductXIdeal k ↔
      (rename Sum.inl).toRingHom r ∈ leftVariableIdeal k
  rw [← Ideal.mem_comap]
  rw [comap_quotientMk_pairwiseZeroProductXIdeal k]
  rfl

/-- The contracted ideal `(x₁, x₂, x₃, \ldots)` is not weakly associated to `S` as an
`k[x₁, x₂, x₃, \ldots]`-module. -/
theorem infiniteVariableIdeal_not_mem_weaklyAssociatedPrimes :
    infiniteVariableIdeal k ∉ weaklyAssociatedPrimes R∞ S∞ := by
  intro hp
  rw [mem_weaklyAssociatedPrimes_iff] at hp
  rcases hp with ⟨s, hsmin⟩
  -- The witness cannot be zero, since `Ann_R(0)=⊤` has no minimal prime equal to a proper prime.
  have hs_ne : s ≠ 0 := by
    intro hs_zero
    have htop : Ideal.torsionOf R∞ S∞ s = ⊤ := by
      simpa [hs_zero] using Ideal.torsionOf_zero R∞ S∞
    have hle : (⊤ : Ideal R∞) ≤ infiniteVariableIdeal k := by
      simpa [htop] using hsmin.1.2
    have htop_eq : infiniteVariableIdeal k = ⊤ := top_le_iff.mp hle
    exact (Ideal.minimalPrimes_isPrime hsmin).ne_top htop_eq
  -- A smaller prime over the annihilator contradicts minimality of the infinite-variable ideal.
  rcases exists_prime_between_torsionOf_and_infiniteVariableIdeal k s hs_ne with
    ⟨J, hJprime, htors_le, hJ_lt⟩
  have hp_le_J : infiniteVariableIdeal k ≤ J :=
    hsmin.2 ⟨hJprime, htors_le⟩ hJ_lt.le
  exact hJ_lt.not_ge hp_le_J

/-- Chap10 Remark 10 66 10: for the ring map
`k[x₁, x₂, x₃, \ldots] → k[x₁, x₂, x₃, \ldots, y₁, y₂, y₃, \ldots] / (x₁ y₁, x₂ y₂, x₃ y₃, \ldots)`
and `M = S`, the image of `WeakAss_S(M)` in `Spec(R)` need not lie in `WeakAss_R(M)`. This shows
the finite-map hypothesis in Lemma `10.66.13` is essential. -/
-- Proof sketch: let `q = Σ xᵢ S`. The remark explains that `q` is a minimal prime of `S`, hence a
-- weakly associated prime of `S` over itself, while its contraction `(x₁, x₂, x₃, \ldots)` is not
-- weakly associated to `S` as an `R`-module because annihilators of nonzero elements over `R` are
-- finitely generated.
@[stacks 05C5]
theorem weaklyAssociatedPrimes_comap_image_not_subset_for_pairwiseZeroProductQuotient
    :
    ¬ Ideal.comap (algebraMap R∞ S∞) '' weaklyAssociatedPrimes S∞ S∞ ⊆
      weaklyAssociatedPrimes R∞ S∞ := by
  intro hsubset
  have hq :
      Ideal.comap (algebraMap R∞ S∞) (pairwiseZeroProductXIdeal k) ∈
        Ideal.comap (algebraMap R∞ S∞) '' weaklyAssociatedPrimes S∞ S∞ := by
    exact ⟨pairwiseZeroProductXIdeal k, pairwiseZeroProductXIdeal_mem_weaklyAssociatedPrimes_self k,
      rfl⟩
  have hmem :
      Ideal.comap (algebraMap R∞ S∞) (pairwiseZeroProductXIdeal k) ∈ weaklyAssociatedPrimes R∞ S∞ :=
    hsubset hq
  rw [comap_pairwiseZeroProductXIdeal k] at hmem
  exact infiniteVariableIdeal_not_mem_weaklyAssociatedPrimes k hmem

end

