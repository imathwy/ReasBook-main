import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

/-
Domain triage: this file is in the commutative algebra of monomially generated subalgebras of
countable polynomial rings, together with their integral-closure and module-finiteness behavior.

Owner abstractions sampled for this item:
- `Algebra.adjoin`, the canonical owner for the quadratic-monomial subalgebra;
- `Algebra.subset_adjoin`, the canonical generator-membership API for that owner;
- `IsIntegralClosure`, the canonical owner predicate for normalization inside a larger ring;
- `IsIntegralClosure.finite`, the canonical finite-normalization theorem recalled in
  `Lemma_10_161_8`.

Source/core/bridge triage:
- `source-facing`: the final counterexample theorem for the explicit quadratic-monomial
  subalgebra of `ℂ[x_0, x_1, x_2, \ldots]`;
- `core/canonical`: the owner subalgebra `complexQuadraticMonomialSubalgebra` and the canonical
  predicates `IsIntegrallyClosed`, `IsIntegralClosure`, and `Module.Finite`;
- `bridge/view`: the generator-membership lemma below.

Primitive data are only the ambient polynomial ring and the quadratic-monomial-generated
subalgebra. Integrally closedness, being an integral closure, and failure of module finiteness are
derived API and should not be bundled into a replacement wrapper structure.
-/

open MvPolynomial

noncomputable section

section

local notation "A∞" => MvPolynomial ℕ ℂ

/-- The quadratic monomials `X i * X j` inside `ℂ[x_0, x_1, x_2, \ldots]`. -/
private def complexQuadraticMonomials : Set A∞ :=
  Set.range fun p : ℕ × ℕ ↦ ((X p.1 : A∞) * X p.2 : A∞)

/-- The `ℂ`-subalgebra of `ℂ[x_0, x_1, x_2, \ldots]` generated by all quadratic monomials
`X i * X j`. -/
def complexQuadraticMonomialSubalgebra : Subalgebra ℂ A∞ :=
  Algebra.adjoin ℂ complexQuadraticMonomials

local notation "R∞" => complexQuadraticMonomialSubalgebra

/-- Each quadratic monomial generator lies in the quadratic subalgebra. -/
-- Proof sketch: each displayed quadratic monomial belongs to the generating set used in the
-- definition of `Algebra.adjoin`.
theorem quadratic_monomial_mem_complexQuadraticMonomialSubalgebra (i j : ℕ) :
    ((X i : A∞) * X j : A∞) ∈ R∞ := by
  simpa [complexQuadraticMonomialSubalgebra, complexQuadraticMonomials] using
    (Algebra.subset_adjoin <|
      show ((X i : A∞) * X j : A∞) ∈ complexQuadraticMonomials from
        ⟨(i, j), rfl⟩)

/-- Helper for Chap10 Example 10 161 9: project the countable polynomial ring to the one-variable
polynomial ring by keeping only the variable indexed by `k`. -/
private def oneVariableProjection (k : ℕ) : A∞ →ₐ[ℂ] Polynomial ℂ :=
  MvPolynomial.aeval fun i ↦ if i = k then Polynomial.X else 0

/-- Helper for Chap10 Example 10 161 9: the subalgebra of one-variable polynomials generated by
the square `X ^ 2`. -/
private def evenPolynomialSubalgebra : Subalgebra ℂ (Polynomial ℂ) :=
  Algebra.adjoin ℂ ({Polynomial.X ^ 2} : Set (Polynomial ℂ))

/-- Helper for Chap10 Example 10 161 9: one-variable projections of elements of the quadratic
monomial subalgebra lie in the subalgebra generated by `X ^ 2`. -/
private lemma oneVariableProjection_mem_evenPolynomialSubalgebra (k : ℕ) (r : R∞) :
    oneVariableProjection k (r : A∞) ∈ evenPolynomialSubalgebra := by
  -- Check the adjoin generators: a quadratic monomial projects to either `X ^ 2` or zero.
  refine Algebra.adjoin_induction (s := complexQuadraticMonomials)
    (p := fun q _ ↦ oneVariableProjection k q ∈ evenPolynomialSubalgebra)
    ?hgen ?hconst ?hadd ?hmul r.property
  · intro q hq
    rcases hq with ⟨ij, rfl⟩
    rcases ij with ⟨i, j⟩
    by_cases hi : i = k
    · subst i
      by_cases hj : j = k
      · subst j
        have hsq : Polynomial.X ^ 2 ∈ evenPolynomialSubalgebra := by
          exact Algebra.subset_adjoin (R := ℂ)
            (show Polynomial.X ^ 2 ∈ ({Polynomial.X ^ 2} : Set (Polynomial ℂ)) from
              Set.mem_singleton _)
        simpa [oneVariableProjection, pow_two] using hsq
      · simp [oneVariableProjection, hj, evenPolynomialSubalgebra]
    · simp [oneVariableProjection, hi, evenPolynomialSubalgebra]
  · intro c
    -- Constants are in every `ℂ`-subalgebra, including the even-polynomial subalgebra.
    simpa [oneVariableProjection, evenPolynomialSubalgebra] using
      (Subalgebra.algebraMap_mem evenPolynomialSubalgebra c)
  · intro x y hx hy hxmem hymem
    -- The property is closed under addition in the target subalgebra.
    simpa [map_add] using evenPolynomialSubalgebra.add_mem hxmem hymem
  · intro x y hx hy hxmem hymem
    -- The property is closed under multiplication in the target subalgebra.
    simpa [map_mul] using evenPolynomialSubalgebra.mul_mem hxmem hymem

/-- Helper for Chap10 Example 10 161 9: if a polynomial does not involve the variable `k`, then
its one-variable projection at `k` is its constant coefficient. -/
private lemma oneVariableProjection_eq_C_constantCoeff_of_notMem_vars {k : ℕ} {p : A∞}
    (hk : k ∉ p.vars) :
    oneVariableProjection k p =
      Polynomial.C ((MvPolynomial.constantCoeff (σ := ℕ) (R := ℂ)) p) := by
  -- All variables appearing in `p` are sent to zero, so evaluation collapses to the constant term.
  have hzero : ∀ i ∈ p.vars, (if i = k then Polynomial.X else (0 : Polynomial ℂ)) = 0 := by
    intro i hi
    by_cases hik : i = k
    · subst i
      exact False.elim (hk hi)
    · simp [hik]
  simpa [oneVariableProjection] using
    (MvPolynomial.aeval_eq_constantCoeff_of_vars
      (g := fun i : ℕ ↦ if i = k then Polynomial.X else (0 : Polynomial ℂ)) (p := p) hzero)

/-- Helper for Chap10 Example 10 161 9: multiplying a polynomial that avoids `k` by an element of
the quadratic subalgebra still projects to an even one-variable polynomial. -/
private lemma oneVariableProjection_smul_mem_evenPolynomialSubalgebra {k : ℕ} (r : R∞) {p : A∞}
    (hk : k ∉ p.vars) :
    oneVariableProjection k (r • p) ∈ evenPolynomialSubalgebra := by
  -- The coefficient from `R∞` projects to an even polynomial, while `p` projects to a constant.
  have hr : oneVariableProjection k (r : A∞) ∈ evenPolynomialSubalgebra :=
    oneVariableProjection_mem_evenPolynomialSubalgebra k r
  have hp : oneVariableProjection k p ∈ evenPolynomialSubalgebra := by
    rw [oneVariableProjection_eq_C_constantCoeff_of_notMem_vars hk]
    exact Subalgebra.algebraMap_mem evenPolynomialSubalgebra
      (((MvPolynomial.constantCoeff (σ := ℕ) (R := ℂ)) p))
  simpa [Algebra.smul_def, map_mul] using evenPolynomialSubalgebra.mul_mem hr hp

/-- Helper for Chap10 Example 10 161 9: every polynomial in `ℂ[X ^ 2]` has the same value at
`1` and `-1`. -/
private lemma eval_one_eq_eval_neg_one_of_mem_evenPolynomialSubalgebra
    {p : Polynomial ℂ} (hp : p ∈ evenPolynomialSubalgebra) :
    Polynomial.eval (1 : ℂ) p = Polynomial.eval (-1 : ℂ) p := by
  -- Propagate the equality from the generator `X ^ 2` through the adjoin operations.
  refine Algebra.adjoin_induction (s := ({Polynomial.X ^ 2} : Set (Polynomial ℂ)))
    (p := fun q _ ↦ Polynomial.eval (1 : ℂ) q = Polynomial.eval (-1 : ℂ) q)
    ?hgen ?hconst ?hadd ?hmul hp
  · intro q hq
    rcases Set.mem_singleton_iff.mp hq with rfl
    norm_num
  · intro c
    simp
  · intro x y hx hy hxval hyval
    simp [hxval, hyval]
  · intro x y hx hy hxval hyval
    simp [hxval, hyval]

/-- Helper for Chap10 Example 10 161 9: the polynomial `X` is not generated by `X ^ 2`. -/
private lemma Polynomial.X_not_mem_evenPolynomialSubalgebra :
    Polynomial.X ∉ evenPolynomialSubalgebra := by
  -- Evaluating at `1` and `-1` separates `X` from all polynomials generated by `X ^ 2`.
  intro hX
  have heq := eval_one_eq_eval_neg_one_of_mem_evenPolynomialSubalgebra hX
  norm_num at heq

/-- Helper for Chap10 Example 10 161 9: each ambient variable is integral over the quadratic
monomial subalgebra because its square is one of the generators. -/
private lemma isIntegral_X_complexQuadraticMonomialSubalgebra (i : ℕ) :
    IsIntegral R∞ (X i : A∞) := by
  -- First show the square is the image of an element of `R∞`, then descend integrality through a
  -- positive power.
  have hsq : IsIntegral R∞ ((X i : A∞) ^ 2) := by
    simpa [pow_two] using
      (isIntegral_algebraMap (R := R∞) (A := A∞)
        (x := ⟨((X i : A∞) * X i : A∞),
          quadratic_monomial_mem_complexQuadraticMonomialSubalgebra i i⟩))
  exact IsIntegral.of_pow (n := 2) (by norm_num) hsq

/-- Helper for Chap10 Example 10 161 9: the whole countable polynomial ring is integral over the
quadratic monomial subalgebra. -/
private lemma algebraIsIntegral_complexQuadraticMonomialSubalgebra :
    Algebra.IsIntegral R∞ A∞ := by
  -- Induct on the polynomial construction from constants and variables.
  rw [Algebra.isIntegral_def]
  intro p
  induction p using MvPolynomial.induction_on with
  | C a =>
      -- Constants come from the base subalgebra.
      simpa using
        (isIntegral_algebraMap (R := R∞) (A := A∞)
          (x := ⟨(C a : A∞), Subalgebra.algebraMap_mem R∞ a⟩))
  | add p q hp hq =>
      -- Integral elements are closed under addition.
      exact hp.add hq
  | mul_X p n hp =>
      -- Multiplication by a variable preserves integrality because the variable is integral.
      exact hp.mul (isIntegral_X_complexQuadraticMonomialSubalgebra n)

/-- Helper for Chap10 Example 10 161 9: the sign involution sends every variable to its negative. -/
private def signFlip : A∞ →ₐ[ℂ] A∞ :=
  MvPolynomial.aeval fun i ↦ -(X i : A∞)

/-- Helper for Chap10 Example 10 161 9: the even Reynolds average as a linear map. -/
private def signAverageLinear : A∞ →ₗ[ℂ] A∞ :=
  ((2 : ℂ)⁻¹ : ℂ) • (LinearMap.id + signFlip.toLinearMap)

/-- Helper for Chap10 Example 10 161 9: the even Reynolds average for the sign involution. -/
private def signAverage (p : A∞) : A∞ :=
  signAverageLinear p

/-- Helper for Chap10 Example 10 161 9: the odd part as a linear map. -/
private def signOddLinear : A∞ →ₗ[ℂ] A∞ :=
  ((2 : ℂ)⁻¹ : ℂ) • (LinearMap.id - signFlip.toLinearMap)

/-- Helper for Chap10 Example 10 161 9: the odd part for the sign involution. -/
private def signOdd (p : A∞) : A∞ :=
  signOddLinear p

/-- Helper for Chap10 Example 10 161 9: the sign average is additive. -/
private lemma signAverage_add (p q : A∞) :
    signAverage (p + q) = signAverage p + signAverage q := by
  -- The average was defined as a linear map, so additivity is its computation rule.
  exact map_add signAverageLinear p q

/-- Helper for Chap10 Example 10 161 9: the odd part is additive. -/
private lemma signOdd_add (p q : A∞) :
    signOdd (p + q) = signOdd p + signOdd q := by
  -- The odd part was defined as a linear map, so additivity is its computation rule.
  exact map_add signOddLinear p q

/-- Helper for Chap10 Example 10 161 9: constants are fixed by the sign average. -/
private lemma signAverage_C (a : ℂ) :
    signAverage (C a : A∞) = C a := by
  -- Constants are fixed by the sign involution, so averaging leaves them unchanged.
  simp only [signAverage, signAverageLinear, LinearMap.smul_apply, LinearMap.add_apply,
    LinearMap.id_coe, id_eq, AlgHom.toLinearMap_apply, signFlip, aeval_C,
    MvPolynomial.algebraMap_eq]
  rw [← two_smul ℂ (C a : A∞), smul_smul]
  norm_num

/-- Helper for Chap10 Example 10 161 9: constants have zero odd part. -/
private lemma signOdd_C (a : ℂ) :
    signOdd (C a : A∞) = 0 := by
  -- The two constant terms cancel before the scalar factor is applied.
  simp only [signOdd, signOddLinear, LinearMap.smul_apply, LinearMap.sub_apply,
    LinearMap.id_coe, id_eq, AlgHom.toLinearMap_apply, signFlip, aeval_C,
    MvPolynomial.algebraMap_eq, sub_self, smul_zero]

/-- Helper for Chap10 Example 10 161 9: multiplying by a variable turns the even average into the
previous odd part times that variable. -/
private lemma signAverage_mul_X (p : A∞) (n : ℕ) :
    signAverage (p * X n) = signOdd p * (X n : A∞) := by
  -- The sign involution negates `X n`, so the average of `p * X n` is the old odd part times
  -- `X n`.
  simp only [signAverage, signAverageLinear, signOdd, signOddLinear, LinearMap.smul_apply,
    LinearMap.add_apply, LinearMap.sub_apply, LinearMap.id_coe, id_eq, AlgHom.toLinearMap_apply,
    signFlip, map_mul, aeval_X]
  rw [smul_mul_assoc]
  congr 1
  rw [sub_mul, mul_neg, sub_eq_add_neg]

/-- Helper for Chap10 Example 10 161 9: multiplying by a variable turns the odd part into the
previous even average times that variable. -/
private lemma signOdd_mul_X (p : A∞) (n : ℕ) :
    signOdd (p * X n) = signAverage p * (X n : A∞) := by
  -- This is the complementary identity to `signAverage_mul_X`.
  simp only [signAverage, signAverageLinear, signOdd, signOddLinear, LinearMap.smul_apply,
    LinearMap.add_apply, LinearMap.sub_apply, LinearMap.id_coe, id_eq, AlgHom.toLinearMap_apply,
    signFlip, map_mul, aeval_X]
  rw [smul_mul_assoc]
  congr 1
  rw [sub_eq_add_neg, mul_neg, neg_neg, add_mul]

/-- Helper for Chap10 Example 10 161 9: the Reynolds even part lies in the quadratic subalgebra,
and the odd part becomes quadratic after multiplying by any variable. -/
private lemma signAverage_mem_and_signOdd_mul_X_mem (p : A∞) :
    signAverage p ∈ R∞ ∧ ∀ i : ℕ, signOdd p * (X i : A∞) ∈ R∞ := by
  -- The simultaneous induction records exactly how multiplying by a variable swaps even and odd
  -- parts; the odd-times-variable clause is what makes the induction close on quadratic
  -- generators.
  induction p using MvPolynomial.induction_on with
  | C a =>
      constructor
      · rw [signAverage_C]
        exact Subalgebra.algebraMap_mem R∞ a
      · intro i
        rw [signOdd_C, zero_mul]
        exact R∞.zero_mem
  | add p q hp hq =>
      rcases hp with ⟨hpavg, hpodd⟩
      rcases hq with ⟨hqavg, hqodd⟩
      constructor
      · rw [signAverage_add]
        exact R∞.add_mem hpavg hqavg
      · intro i
        rw [signOdd_add, add_mul]
        exact R∞.add_mem (hpodd i) (hqodd i)
  | mul_X p n hp =>
      rcases hp with ⟨hpavg, hpodd⟩
      constructor
      · rw [signAverage_mul_X]
        exact hpodd n
      · intro i
        rw [signOdd_mul_X, mul_assoc]
        exact R∞.mul_mem hpavg
          (quadratic_monomial_mem_complexQuadraticMonomialSubalgebra n i)

/-- Helper for Chap10 Example 10 161 9: the sign involution fixes every element of the quadratic
monomial subalgebra. -/
private lemma signFlip_eq_self_of_mem_complexQuadraticMonomialSubalgebra {p : A∞} (hp : p ∈ R∞) :
    signFlip p = p := by
  -- It is enough to check the quadratic generators, since fixed points are closed under the
  -- algebra operations used in `Algebra.adjoin`.
  refine Algebra.adjoin_induction (s := complexQuadraticMonomials)
    (p := fun q _ ↦ signFlip q = q) ?hgen ?hconst ?hadd ?hmul hp
  · intro q hq
    rcases hq with ⟨ij, rfl⟩
    rcases ij with ⟨i, j⟩
    simp [signFlip]
  · intro c
    simp [signFlip]
  · intro x y hx hy hxfix hyfix
    simp [map_add, hxfix, hyfix]
  · intro x y hx hy hxfix hyfix
    simp [map_mul, hxfix, hyfix]

/-- Helper for Chap10 Example 10 161 9: the Reynolds average fixes elements of the quadratic
monomial subalgebra. -/
private lemma signAverage_eq_self_of_mem_complexQuadraticMonomialSubalgebra {p : A∞}
    (hp : p ∈ R∞) :
    signAverage p = p := by
  -- Once the sign action fixes `p`, averaging is just multiplication by `1 / 2` after doubling.
  simp only [signAverage, signAverageLinear, LinearMap.smul_apply, LinearMap.add_apply,
    LinearMap.id_coe, id_eq, AlgHom.toLinearMap_apply]
  rw [signFlip_eq_self_of_mem_complexQuadraticMonomialSubalgebra hp]
  rw [← two_smul ℂ p, smul_smul]
  norm_num

/-- Helper for Chap10 Example 10 161 9: the Reynolds average is linear over the quadratic
monomial subalgebra on the left. -/
private lemma signAverage_mul_left_of_mem_complexQuadraticMonomialSubalgebra {q p : A∞}
    (hq : q ∈ R∞) :
    signAverage (q * p) = q * signAverage p := by
  -- The left factor is fixed by the sign involution, so it factors out of the average.
  simp only [signAverage, signAverageLinear, LinearMap.smul_apply, LinearMap.add_apply,
    LinearMap.id_coe, id_eq, AlgHom.toLinearMap_apply, map_mul]
  rw [signFlip_eq_self_of_mem_complexQuadraticMonomialSubalgebra hq]
  rw [mul_smul_comm]
  congr 1
  rw [mul_add]

/-- Helper for Chap10 Example 10 161 9: membership in the quadratic subalgebra can be cancelled
across a nonzero left factor from the quadratic subalgebra. -/
private lemma mem_complexQuadraticMonomialSubalgebra_of_mul_mem_left {p q : A∞}
    (hq0 : q ≠ 0) (hq : q ∈ R∞) (hqp : q * p ∈ R∞) :
    p ∈ R∞ := by
  -- Apply the Reynolds projection to `q * p`; since `q` and `q * p` are fixed, cancellation in the
  -- ambient domain forces `p` to equal its average, which already lies in `R∞`.
  have hpavg : signAverage p ∈ R∞ := (signAverage_mem_and_signOdd_mul_X_mem p).1
  have hfixed :
      signAverage (q * p) = q * p :=
    signAverage_eq_self_of_mem_complexQuadraticMonomialSubalgebra hqp
  have hlinear :
      signAverage (q * p) = q * signAverage p :=
    signAverage_mul_left_of_mem_complexQuadraticMonomialSubalgebra hq
  have hp_eq_avg : p = signAverage p := by
    exact mul_left_cancel₀ hq0 (hfixed.symm.trans hlinear)
  rw [hp_eq_avg]
  exact hpavg

/-- Helper for Chap10 Example 10 161 9: the inclusion of `R∞` into the fraction field of the
ambient polynomial ring. -/
private def quadraticSubalgebraToAmbientFraction : R∞ →ₐ[ℂ] FractionRing A∞ :=
  (IsScalarTower.toAlgHom ℂ A∞ (FractionRing A∞)).comp R∞.val

/-- Helper for Chap10 Example 10 161 9: the map from `R∞` to the ambient fraction field is
injective. -/
private lemma quadraticSubalgebraToAmbientFraction_injective :
    Function.Injective quadraticSubalgebraToAmbientFraction := by
  -- Injectivity follows by forgetting to the ambient polynomial ring and using the fraction-field
  -- map's injectivity there.
  intro x y hxy
  apply Subtype.ext
  exact IsFractionRing.injective A∞ (FractionRing A∞) hxy

/-- Helper for Chap10 Example 10 161 9: the induced map from `Frac(R∞)` to `Frac(A∞)`. -/
private def ambientFractionAlgHom : FractionRing R∞ →ₐ[ℂ] FractionRing A∞ :=
  IsFractionRing.liftAlgHom quadraticSubalgebraToAmbientFraction_injective

/-- Helper for Chap10 Example 10 161 9: the induced fraction-field map sends a localization
fraction to the corresponding ambient fraction. -/
private lemma ambientFractionAlgHom_mk' (r : R∞) (s : nonZeroDivisors R∞) :
    ambientFractionAlgHom (IsLocalization.mk' (FractionRing R∞) r s) =
      algebraMap A∞ (FractionRing A∞) (r : A∞) /
        algebraMap A∞ (FractionRing A∞) (s : A∞) := by
  -- This is the `IsFractionRing.lift_mk'` computation specialized to the subalgebra inclusion.
  simpa [ambientFractionAlgHom, quadraticSubalgebraToAmbientFraction] using
    (IsFractionRing.lift_mk' (K := FractionRing R∞) (L := FractionRing A∞)
      quadraticSubalgebraToAmbientFraction_injective r s)

/-- Helper for Chap10 Example 10 161 9: the induced fraction-field map agrees with the ambient
inclusion on elements of the quadratic subalgebra. -/
private lemma ambientFractionAlgHom_algebraMap (r : R∞) :
    ambientFractionAlgHom (algebraMap R∞ (FractionRing R∞) r) =
      algebraMap A∞ (FractionRing A∞) (r : A∞) := by
  -- This is the defining computation rule for the fraction-field lift.
  simpa [ambientFractionAlgHom, quadraticSubalgebraToAmbientFraction] using
    (IsFractionRing.lift_algebraMap (K := FractionRing R∞) (L := FractionRing A∞)
      quadraticSubalgebraToAmbientFraction_injective r)

/-- Helper for Chap10 Example 10 161 9: if an element of `Frac(R∞)` maps to an ambient polynomial,
then that polynomial already lies in the quadratic subalgebra. -/
private lemma ambientFraction_eq_algebraMap_mem_complexQuadraticMonomialSubalgebra
    {x : FractionRing R∞} {p : A∞}
    (hx : ambientFractionAlgHom x = algebraMap A∞ (FractionRing A∞) p) :
    p ∈ R∞ := by
  -- Write the fraction over `R∞` as `r / s`, clear the nonzero denominator after mapping to
  -- `Frac(A∞)`, then use the Reynolds cancellation lemma in the ambient polynomial ring.
  obtain ⟨r, s, rfl⟩ := IsLocalization.exists_mk'_eq (nonZeroDivisors R∞) x
  rw [ambientFractionAlgHom_mk'] at hx
  have hs0 : (s : A∞) ≠ 0 := by
    intro hs
    exact nonZeroDivisors.coe_ne_zero s (Subtype.ext hs)
  have hs_fraction_ne :
      algebraMap A∞ (FractionRing A∞) (s : A∞) ≠ 0 :=
    fun hs_fraction ↦
      hs0 (IsFractionRing.injective A∞ (FractionRing A∞) (by simpa using hs_fraction))
  have hclear :
      algebraMap A∞ (FractionRing A∞) (r : A∞) =
        algebraMap A∞ (FractionRing A∞) p *
          algebraMap A∞ (FractionRing A∞) (s : A∞) := by
    have hmul := congrArg
      (fun z : FractionRing A∞ ↦ z * algebraMap A∞ (FractionRing A∞) (s : A∞)) hx
    simpa [div_eq_mul_inv, mul_assoc, hs_fraction_ne] using hmul
  have hprod : (s : A∞) * p = (r : A∞) := by
    apply IsFractionRing.injective A∞ (FractionRing A∞)
    simpa [map_mul, mul_comm, mul_left_comm, mul_assoc] using hclear.symm
  have hs_mem : (s : A∞) ∈ R∞ := (s : R∞).property
  have hprod_mem : (s : A∞) * p ∈ R∞ := by
    rw [hprod]
    exact (r : R∞).property
  exact mem_complexQuadraticMonomialSubalgebra_of_mul_mem_left hs0 hs_mem hprod_mem

/-- Chap10 Example 10 161 9: the quadratic subalgebra is integrally closed. -/
-- Proof sketch: identify `R∞` with the invariant ring for the order-two sign action on `A∞`.
-- Since `A∞` is a normal domain over a characteristic-zero field, the invariant subring is
-- integrally closed.
theorem isIntegrallyClosed_complexQuadraticMonomialSubalgebra :
    IsIntegrallyClosed R∞ := by
  -- Route correction: the earlier support-parity cancellation route was replaced by the Reynolds
  -- retraction above, which supplies the needed fraction-field intersection bridge.
  rw [isIntegrallyClosed_iff (K := FractionRing R∞)]
  intro x hx
  -- Map the integral element to the normal ambient polynomial fraction field.
  have hx_ambient : IsIntegral A∞ (ambientFractionAlgHom x) := by
    refine IsIntegral.map_of_comp_eq
      (R := R∞) (S := FractionRing R∞) (T := A∞) (U := FractionRing A∞)
      (R∞.val : R∞ →+* A∞) ambientFractionAlgHom.toRingHom ?_ hx
    ext r
    simp [ambientFractionAlgHom_algebraMap]
  obtain ⟨p, hp⟩ :=
    IsIntegrallyClosed.algebraMap_eq_of_integral (K := FractionRing A∞) hx_ambient
  -- The intersection helper upgrades the ambient representative to an element of `R∞`.
  have hp_mem : p ∈ R∞ :=
    ambientFraction_eq_algebraMap_mem_complexQuadraticMonomialSubalgebra hp.symm
  refine ⟨⟨p, hp_mem⟩, ?_⟩
  -- Injectivity of the field hom from `Frac(R∞)` pulls the equality back to `Frac(R∞)`.
  apply (RingHom.injective ambientFractionAlgHom.toRingHom)
  simpa [ambientFractionAlgHom_algebraMap] using hp

/-- The countable polynomial ring is the integral closure of the quadratic subalgebra in its
fraction field. -/
-- Proof sketch: each variable `X i` is integral over `R∞` because it satisfies a monic quadratic
-- polynomial with coefficients in `R∞`; conversely, the integral closure of `R∞` inside
-- `Frac(A∞)` is exactly `A∞`.
theorem isIntegralClosure_complexQuadraticMonomialSubalgebra :
    IsIntegralClosure A∞ R∞ (FractionRing A∞) := by
  -- With the ambient polynomial ring normal, the general integral-closure instance applies once
  -- `A∞` is known integral over `R∞`.
  letI : Algebra.IsIntegral R∞ A∞ := algebraIsIntegral_complexQuadraticMonomialSubalgebra
  exact inferInstance

/-- The countable polynomial ring is not finite as a module over the quadratic monomial
subalgebra. -/
-- Proof sketch: the sign action of `{±1}` identifies `R∞` with the invariant ring, but the
-- infinitely many variables prevent `A∞` from being a finite `R∞`-module.
theorem complexQuadraticMonomialSubalgebra_not_module_finite :
    ¬ Module.Finite R∞ A∞ := by
  -- A finite module spanning family involves only finitely many variables; choose a fresh one.
  intro hfinite
  letI : Module.Finite R∞ A∞ := hfinite
  rcases Module.Finite.exists_fin (R := R∞) (M := A∞) with ⟨n, s, hs⟩
  let usedVars : Finset ℕ := Finset.univ.biUnion fun i : Fin n ↦ (s i).vars
  rcases Infinite.exists_notMem_finset usedVars with ⟨k, hk⟩
  have hk_vars (i : Fin n) : k ∉ (s i).vars := by
    intro hki
    exact hk (Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ i, hki⟩)

  -- Express the fresh variable as an `R∞`-linear combination of the finite spanning family.
  have hx_mem : (X k : A∞) ∈ Submodule.span R∞ (Set.range s) := by
    rw [hs]
    exact Submodule.mem_top
  rcases (Submodule.mem_span_range_iff_exists_fun R∞).mp hx_mem with ⟨c, hc⟩

  -- Projecting to the fresh one-variable axis sends each generator to a constant and each
  -- coefficient from `R∞` to an even polynomial, so the whole sum is even.
  have hproj_sum :
      oneVariableProjection k (∑ i : Fin n, c i • s i) =
        ∑ i : Fin n, oneVariableProjection k (c i • s i) := by
    exact map_sum (oneVariableProjection k) (fun i : Fin n ↦ c i • s i) Finset.univ
  have hproj_eq' :
      oneVariableProjection k (∑ i : Fin n, c i • s i) =
        oneVariableProjection k (X k : A∞) := by
    exact congrArg (oneVariableProjection k) hc
  have hXproj : oneVariableProjection k (X k : A∞) = Polynomial.X := by
    simp [oneVariableProjection]
  have hproj_eq : (∑ i : Fin n, oneVariableProjection k (c i • s i)) = Polynomial.X := by
    exact hproj_sum.symm.trans (hproj_eq'.trans hXproj)
  have hsum_mem : (∑ i : Fin n, oneVariableProjection k (c i • s i)) ∈
      evenPolynomialSubalgebra := by
    exact evenPolynomialSubalgebra.sum_mem (t := (Finset.univ : Finset (Fin n)))
      (fun i _ ↦ oneVariableProjection_smul_mem_evenPolynomialSubalgebra (k := k) (c i)
        (hk_vars i))

  -- This would put `X` in `ℂ[X^2]`, contradicting evaluation at `1` and `-1`.
  exact Polynomial.X_not_mem_evenPolynomialSubalgebra (hproj_eq ▸ hsum_mem)

/-- Consequence for Chap10 Example 10 161 9: for `A = ℂ[x_0, x_1, x_2, \ldots]` and
`R = ℂ[x_i x_j]`, the extension `R ⊆ A` is not finite, although `A` is the integral closure of
`R` in the fraction field of `A`. This gives a non-Noetherian counterexample to Lemma 10.161.8. -/
-- Proof sketch: `A` is integral over `R∞` because each variable satisfies a monic quadratic
-- polynomial over `R∞`. The sign action of `{±1}` identifies `R∞` with the invariant ring, but
-- the infinitely many variables prevent `A` from being a finite `R∞`-module.
@[stacks 03B7]
theorem complexQuadraticMonomialSubalgebra_not_module_finite_and_has_integral_closure :
    ¬ Module.Finite R∞ A∞ ∧ IsIntegralClosure A∞ R∞ (FractionRing A∞) := by
  exact ⟨complexQuadraticMonomialSubalgebra_not_module_finite,
    isIntegralClosure_complexQuadraticMonomialSubalgebra⟩

end

