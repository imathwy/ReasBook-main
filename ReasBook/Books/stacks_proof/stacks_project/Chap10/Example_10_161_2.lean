/-- Helper for Chap10 Example 10 161 2: every polynomial in the ideal generated by all variables
has zero constant coefficient. -/
private lemma constantCoeff_eq_zero_of_mem_idealOfVars
    {σ : Type*} {R : Type u} [CommSemiring R] {p : MvPolynomial σ R}
    (hp : p ∈ MvPolynomial.idealOfVars σ R) :
    MvPolynomial.constantCoeff p = 0 := by
  -- Proof comment: membership in the variable ideal says every supporting monomial has a
  -- nonzero variable exponent, so the zero monomial cannot occur in the support.
  by_contra hconst
  have hzero_mem : (0 : σ →₀ ℕ) ∈ p.support := by
    simpa [MvPolynomial.mem_support_iff] using hconst
  have hvar :
      ∃ i ∈ (Set.univ : Set σ), ((0 : σ →₀ ℕ) i) ≠ 0 := by
    have hp' :
        p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set σ) :
          Set (MvPolynomial σ R)) := by
      simpa [MvPolynomial.idealOfVars] using hp
    exact
      (MvPolynomial.mem_ideal_span_X_image (x := p) (s := (Set.univ : Set σ))).mp
        hp' 0 hzero_mem
  rcases hvar with ⟨i, -, hi⟩
  exact hi rfl

-- Proof sketch: if `MvPolynomial σ R` were Noetherian, then the owner ideal
-- `MvPolynomial.idealOfVars σ R` would be finitely generated. Any finite generating family uses
-- only finitely many variables, so choosing a variable outside that finite support shows the
-- corresponding generator `X i` is not in the generated ideal, contradiction.
private theorem mvPolynomial_not_isNoetherianRing_of_infinite
    (σ : Type*) [Infinite σ] (R : Type u) [CommRing R] [Nontrivial R] :
    ¬ IsNoetherianRing (MvPolynomial σ R) := by
  classical
  intro hNoetherian
  let A := MvPolynomial σ R
  let I : Ideal A := MvPolynomial.idealOfVars σ R
  have hfg : I.FG := by
    -- Proof comment: a Noetherian polynomial ring would make every ideal finitely generated.
    letI : IsNoetherianRing A := hNoetherian
    exact I.fg_of_isNoetherianRing
  rcases Submodule.fg_def.mp hfg with ⟨S, hSfinite, hSspan⟩
  let T : Finset σ := hSfinite.toFinset.biUnion fun p : A => p.vars
  obtain ⟨i, hi⟩ := Infinite.exists_notMem_finset T
  let killFiniteVariables : A →+* A :=
    MvPolynomial.eval₂Hom MvPolynomial.C fun j : σ => if j ∈ T then 0 else MvPolynomial.X j
  have hSker : S ⊆ RingHom.ker killFiniteVariables := by
    intro p hpS
    have hpI : p ∈ I := by
      -- Proof comment: the chosen finite set `S` spans the variable ideal, so each generator lies
      -- in that ideal and has zero constant coefficient.
      have hpSpan : p ∈ Submodule.span A S := Submodule.subset_span hpS
      rw [hSspan] at hpSpan
      exact hpSpan
    have hpvars :
        ∀ j ∈ p.vars, (if j ∈ T then (0 : A) else MvPolynomial.X j) = 0 := by
      intro j hj
      have hjT : j ∈ T := by
        exact Finset.mem_biUnion.mpr ⟨p, hSfinite.mem_toFinset.mpr hpS, hj⟩
      simp [hjT]
    have hpconst : MvPolynomial.constantCoeff p = 0 :=
      constantCoeff_eq_zero_of_mem_idealOfVars (σ := σ) (R := R) (p := p) hpI
    -- Proof comment: killing all variables that occur in `p` reduces `p` to its zero constant
    -- coefficient, hence every finite generator maps to zero.
    change killFiniteVariables p = 0
    simp [killFiniteVariables, MvPolynomial.eval₂Hom_eq_constantCoeff_of_vars _ hpvars, hpconst]
  have hXspan : (MvPolynomial.X i : A) ∈ Submodule.span A S := by
    -- Proof comment: `X i` belongs to the full variable ideal, hence to the finite span `S`.
    have hXI : (MvPolynomial.X i : A) ∈ I := by
      exact Ideal.subset_span (Set.mem_range_self i)
    rw [hSspan]
    exact hXI
  have hXker : (MvPolynomial.X i : A) ∈ RingHom.ker killFiniteVariables :=
    (Submodule.span_le.mpr hSker) hXspan
  have hKillX : killFiniteVariables (MvPolynomial.X i : A) = MvPolynomial.X i := by
    -- Proof comment: the selected variable is outside the finite support of the generators, so
    -- the killing map fixes `X i`.
    dsimp [killFiniteVariables]
    rw [MvPolynomial.eval₂Hom_X']
    simp [hi]
  have hXzero : (MvPolynomial.X i : A) = 0 := by
    have hMapZero : killFiniteVariables (MvPolynomial.X i : A) = 0 := by
      simpa [RingHom.mem_ker] using hXker
    exact hKillX.symm.trans hMapZero
  exact MvPolynomial.X_ne_zero i hXzero

/-- Helper for Chap10 Example 10 161 2: `N-2` descends across a ring equivalence between
Noetherian domains. -/
private theorem isN2Ring_of_ringEquiv
    {A B : Type u} [CommRing A] [CommRing B] [IsDomain A] [IsDomain B]
    [IsNoetherianRing A] [IsNoetherianRing B] (e : A ≃+* B) [IsN2Ring A] :
    IsN2Ring B := by
  -- Proof comment: view the inverse equivalence as a finite extension of `B`, then apply the
  -- chapter descent theorem for finite extensions.
  letI : Algebra B A := e.symm.toRingHom.toAlgebra
  letI : Module.Finite B A := by
    exact Module.Finite.of_surjective (Algebra.linearMap B A) e.symm.surjective
  exact isN2Ring_of_finite_extension (R := B) (S := A) e.symm.injective

/-- Helper for Chap10 Example 10 161 2: a finite set of countable-variable polynomials is
already defined over one finite set of variables. -/
private lemma mvPolynomial_finset_lifts_to_finiteVariables
    {R : Type u} [CommSemiring R] (T : Finset (MvPolynomial ℕ+ R)) :
    ∃ s : Finset ℕ+, ∀ p ∈ T,
      ∃ q : MvPolynomial s R, MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) q = p := by
  classical
  -- Proof comment: take the union of the variable supports of the finitely many polynomials.
  let s : Finset ℕ+ := T.biUnion fun p ↦ p.vars
  refine ⟨s, ?_⟩
  intro p hp
  -- Proof comment: every variable of `p` now lies in the range of the subtype inclusion.
  refine MvPolynomial.exists_rename_eq_of_vars_subset_range p (fun i : s ↦ (i : ℕ+)) ?hinj ?hvars
  · intro i j hij
    exact Subtype.ext hij
  · intro x hx
    exact ⟨⟨x, Finset.mem_biUnion.mpr ⟨p, hp, hx⟩⟩, rfl⟩

/-- Helper for Chap10 Example 10 161 2: the finite-variable inclusion of polynomial rings is
injective. -/
private lemma finiteVariableRename_injective
    {R : Type u} [CommSemiring R] (s : Finset ℕ+) :
    Function.Injective
      ((MvPolynomial.rename (fun i : s ↦ (i : ℕ+))).toRingHom :
        MvPolynomial s R →+* MvPolynomial ℕ+ R) := by
  -- Proof comment: renaming along the subtype inclusion is injective because the subtype
  -- inclusion itself is injective.
  exact MvPolynomial.rename_injective (fun i : s ↦ (i : ℕ+)) Subtype.val_injective

/-- Helper for Chap10 Example 10 161 2: the fraction-field map induced by a finite-variable
polynomial inclusion. -/
private noncomputable def finiteVariableFractionRingMap
    {R : Type u} [CommRing R] [IsDomain R] (s : Finset ℕ+) :
    FractionRing (MvPolynomial s R) →+* FractionRing (MvPolynomial ℕ+ R) :=
  IsFractionRing.map
    (A := MvPolynomial s R)
    (B := MvPolynomial ℕ+ R)
    (K := FractionRing (MvPolynomial s R))
    (L := FractionRing (MvPolynomial ℕ+ R))
    (j := (MvPolynomial.rename (fun i : s ↦ (i : ℕ+))).toRingHom)
    (finiteVariableRename_injective (R := R) s)

/-- Helper for Chap10 Example 10 161 2: the finite-variable fraction-field inclusion is
injective. -/
private lemma finiteVariableFractionRingMap_injective
    {R : Type u} [CommRing R] [IsDomain R] (s : Finset ℕ+) :
    Function.Injective (finiteVariableFractionRingMap (R := R) s) := by
  -- Proof comment: a nonzero ring hom out of a field is injective; here both fraction rings are
  -- fields and the target is nontrivial.
  exact RingHom.injective (finiteVariableFractionRingMap (R := R) s)

/-- Helper for Chap10 Example 10 161 2: the finite-variable fraction-field map sends polynomial
numerators through the underlying variable inclusion. -/
private lemma finiteVariableFractionRingMap_algebraMap
    {R : Type u} [CommRing R] [IsDomain R] (s : Finset ℕ+)
    (p : MvPolynomial s R) :
    finiteVariableFractionRingMap (R := R) s
        (algebraMap (MvPolynomial s R) (FractionRing (MvPolynomial s R)) p) =
      algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R))
        (MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) p) := by
  -- Proof comment: unfold the localization map only at the source polynomial subring.
  delta finiteVariableFractionRingMap IsFractionRing.map
  simp only [IsLocalization.map_eq]
  rfl

/-- Helper for Chap10 Example 10 161 2: a finite set of elements of the countable-variable
fraction field is already defined over one finite set of variables. -/
private lemma fractionRing_finset_lifts_to_finiteVariables
    {R : Type u} [CommRing R] [IsDomain R]
    (T : Finset (FractionRing (MvPolynomial ℕ+ R))) :
    ∃ s : Finset ℕ+, ∀ z ∈ T,
      ∃ w : FractionRing (MvPolynomial s R),
        finiteVariableFractionRingMap (R := R) s w = z := by
  classical
  -- Proof comment: choose a numerator and a nonzero denominator for every fraction in the finite
  -- set, then put all those polynomials over one finite set of variables.
  choose num den hden hfrac using
    fun z : FractionRing (MvPolynomial ℕ+ R) =>
      IsFractionRing.div_surjective (MvPolynomial ℕ+ R) z
  let P : Finset (MvPolynomial ℕ+ R) := T.image num ∪ T.image den
  obtain ⟨s, hs⟩ := mvPolynomial_finset_lifts_to_finiteVariables (R := R) P
  refine ⟨s, ?_⟩
  intro z hz
  have hnum_mem : num z ∈ P := by
    exact Finset.mem_union.mpr (Or.inl (Finset.mem_image.mpr ⟨z, hz, rfl⟩))
  have hden_mem : den z ∈ P := by
    exact Finset.mem_union.mpr (Or.inr (Finset.mem_image.mpr ⟨z, hz, rfl⟩))
  obtain ⟨qnum, hqnum⟩ := hs (num z) hnum_mem
  obtain ⟨qden, hqden⟩ := hs (den z) hden_mem
  -- Proof comment: the induced fraction-field map carries the lifted fraction back to the
  -- original numerator-over-denominator presentation.
  refine ⟨algebraMap (MvPolynomial s R) (FractionRing (MvPolynomial s R)) qnum /
      algebraMap (MvPolynomial s R) (FractionRing (MvPolynomial s R)) qden, ?_⟩
  calc
    finiteVariableFractionRingMap (R := R) s
        (algebraMap (MvPolynomial s R) (FractionRing (MvPolynomial s R)) qnum /
          algebraMap (MvPolynomial s R) (FractionRing (MvPolynomial s R)) qden)
        = algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R))
            (MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) qnum) /
          algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R))
            (MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) qden) := by
          rw [map_div₀, finiteVariableFractionRingMap_algebraMap,
            finiteVariableFractionRingMap_algebraMap]
    _ = algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R)) (num z) /
          algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R)) (den z) := by
          rw [hqnum, hqden]
    _ = z := hfrac z

/-- Helper for Chap10 Example 10 161 2: the `N-2` property is invariant under a ring
equivalence, without any Noetherian hypothesis. -/
private theorem isN2Ring_of_ringEquiv_noetherianFree
    {A B : Type u} [CommRing A] [CommRing B] [IsDomain A] [IsDomain B]
    (e : A ≃+* B) [IsN2Ring A] :
    IsN2Ring B := by
  -- Proof comment: a ring equivalence is the localization at the trivial submonoid, so the
  -- already-proved localization permanence theorem transports the `N-2` structure.
  letI : Algebra A B := e.toRingHom.toAlgebra
  letI : IsLocalization (⊥ : Submonoid A) A := by
    refine IsLocalization.self ?_
    intro x hx
    rw [Submonoid.mem_bot] at hx
    rw [hx]
    exact isUnit_one
  let eAlg : A ≃ₐ[A] B := AlgEquiv.ofRingEquiv (f := e) (by intro x; rfl)
  letI : IsLocalization (⊥ : Submonoid A) B := by
    exact IsLocalization.isLocalization_of_algEquiv (⊥ : Submonoid A) eAlg
  exact isN2Ring_of_isLocalization (R := A) (Rₘ := B) (⊥ : Submonoid A)

/-- Helper for Chap10 Example 10 161 2: any finite subtype stage inherits `N-2` from the
corresponding `Fin n` stage. -/
private theorem finiteVariableSubtype_isN2Ring
    {R : Type u} [CommRing R] [IsDomain R]
    (hfinite : ∀ n : ℕ, IsN2Ring (MvPolynomial (Fin n) R)) (s : Finset ℕ+) :
    IsN2Ring (MvPolynomial s R) := by
  classical
  -- Proof comment: enumerate the finite subtype and transport the finite-stage hypothesis along
  -- the standard variable-renaming equivalence.
  letI : IsN2Ring (MvPolynomial (Fin (Fintype.card s)) R) := hfinite (Fintype.card s)
  exact isN2Ring_of_ringEquiv_noetherianFree
    ((MvPolynomial.renameEquiv R (Fintype.equivFin s).symm).toRingEquiv)

/-- Helper for Chap10 Example 10 161 2: split the countable polynomial ring into finite-stage
variables and complementary tail variables. -/
private noncomputable def countablePolynomialTailAlgEquiv
    (R : Type u) [CommSemiring R] (s : Finset ℕ+) :
    MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) (MvPolynomial s R) ≃ₐ[R] MvPolynomial ℕ+ R :=
  (MvPolynomial.sumAlgEquiv R (↥((↑s : Set ℕ+)ᶜ)) s).symm.trans
    (MvPolynomial.renameEquiv R <|
      (Equiv.sumComm (↥((↑s : Set ℕ+)ᶜ)) s).trans <| Equiv.Set.sumCompl (↑s : Set ℕ+))

/-- Helper for Chap10 Example 10 161 2: a module-finite coefficient extension remains
module-finite after adjoining any family of polynomial variables. -/
private lemma mvPolynomial_map_finite_of_moduleFinite
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B] [Module.Finite A B]
    (τ : Type*) :
    let f : MvPolynomial τ A →+* MvPolynomial τ B := MvPolynomial.map (algebraMap A B)
    let _ : Algebra (MvPolynomial τ A) (MvPolynomial τ B) := f.toAlgebra
    Module.Finite (MvPolynomial τ A) (MvPolynomial τ B) := by
  let f : MvPolynomial τ A →+* MvPolynomial τ B := MvPolynomial.map (algebraMap A B)
  letI : Algebra (MvPolynomial τ A) (MvPolynomial τ B) := f.toAlgebra
  change Module.Finite (MvPolynomial τ A) (MvPolynomial τ B)
  rw [Module.finite_def, Submodule.fg_iff_exists_fin_generating_family]
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := A) (M := B)
  refine ⟨n, fun i ↦ (MvPolynomial.C (g i) : MvPolynomial τ B), ?_⟩
  apply top_le_iff.mp
  intro p hp
  clear hp
  -- Proof comment: reduce membership in the generated module to coefficient monomials.
  induction p using MvPolynomial.induction_on' with
  | add p q hp hq =>
      exact Submodule.add_mem _ hp hq
  | monomial d a =>
      have ha : a ∈ Submodule.span A (Set.range g) := by
        simpa [hg] using (show a ∈ (⊤ : Submodule A B) from trivial)
      have hC :
          (MvPolynomial.C a : MvPolynomial τ B) ∈
            Submodule.span (MvPolynomial τ A)
              (Set.range fun i : Fin n ↦ (MvPolynomial.C (g i) : MvPolynomial τ B)) := by
        -- Proof comment: lift a finite `A`-linear coefficient expansion through the constant
        -- polynomial map.
        rcases (Submodule.mem_span_range_iff_exists_fun (R := A) (v := g) (x := a)).1 ha with
          ⟨c, hc⟩
        refine (Submodule.mem_span_range_iff_exists_fun
          (R := MvPolynomial τ A)
          (v := fun i : Fin n ↦ (MvPolynomial.C (g i) : MvPolynomial τ B))
          (x := (MvPolynomial.C a : MvPolynomial τ B))).2 ?_
        refine ⟨fun i ↦ (MvPolynomial.C (c i) : MvPolynomial τ A), ?_⟩
        change
          (∑ i, f (MvPolynomial.C (c i)) *
              (MvPolynomial.C (g i) : MvPolynomial τ B)) = MvPolynomial.C a
        simpa [f, Algebra.smul_def, hc] using
          congrArg (MvPolynomial.C : B → MvPolynomial τ B) hc
      have hmono :
          (MvPolynomial.monomial d (1 : A)) • (MvPolynomial.C a : MvPolynomial τ B) ∈
            Submodule.span (MvPolynomial τ A)
              (Set.range fun i : Fin n ↦ (MvPolynomial.C (g i) : MvPolynomial τ B)) :=
        Submodule.smul_mem _ (MvPolynomial.monomial d (1 : A)) hC
      have hmonomial_scalar :
          (MvPolynomial.monomial d (1 : A)) • (MvPolynomial.C a : MvPolynomial τ B) =
            MvPolynomial.monomial d a := by
        -- Proof comment: scalar multiplication by a source monomial is multiplication by its
        -- coefficient-mapped monomial, so it restores the target monomial.
        change
          f (MvPolynomial.monomial d (1 : A)) *
              (MvPolynomial.C a : MvPolynomial τ B) = MvPolynomial.monomial d a
        rw [MvPolynomial.map_monomial]
        simp only [map_one]
        rw [mul_comm, MvPolynomial.C_mul_monomial, mul_one]
      exact hmonomial_scalar ▸ hmono

/-- Helper for Chap10 Example 10 161 2: in a finite extension of the countable-variable
fraction field, the coordinates of `1` and all multiplication structure constants for a finite
basis are supported on one finite variable stage. -/
private lemma finiteExtension_supportedStructureConstants
    {R : Type u} [CommRing R] [IsDomain R]
    (L : Type u) [Field L] [Algebra (FractionRing (MvPolynomial ℕ+ R)) L]
    [FiniteDimensional (FractionRing (MvPolynomial ℕ+ R)) L] :
    ∃ (s : Finset ℕ+) (n : ℕ)
      (b : Module.Basis (Fin n) (FractionRing (MvPolynomial ℕ+ R)) L),
      (∀ k : Fin n, ∃ w : FractionRing (MvPolynomial s R),
        finiteVariableFractionRingMap (R := R) s w = b.repr (1 : L) k) ∧
      (∀ i j k : Fin n, ∃ w : FractionRing (MvPolynomial s R),
        finiteVariableFractionRingMap (R := R) s w = b.repr (b i * b j) k) := by
  classical
  let K := FractionRing (MvPolynomial ℕ+ R)
  let n := Module.finrank K L
  let b : Module.Basis (Fin n) K L := Module.finBasis K L
  let T : Finset K :=
    ((Finset.univ : Finset (Fin n)).image fun k ↦ b.repr (1 : L) k) ∪
      ((Finset.univ : Finset (Fin n × Fin n × Fin n)).image fun t ↦
        b.repr (b t.1 * b t.2.1) t.2.2)
  obtain ⟨s, hs⟩ := fractionRing_finset_lifts_to_finiteVariables (R := R) T
  refine ⟨s, n, b, ?_, ?_⟩
  · -- Proof comment: the coordinates of `1` were inserted into the finite coefficient set.
    intro k
    exact hs (b.repr (1 : L) k) (by simp [T])
  · -- Proof comment: the multiplication constants were inserted into the same finite set.
    intro i j k
    exact hs (b.repr (b i * b j) k) (by simp [T])

/-- Helper for Chap10 Example 10 161 2: choose supported coefficient functions for the
coordinates of `1` and of all multiplication constants in a finite extension. -/
private lemma finiteExtension_supportedStructureConstantFunctions
    {R : Type u} [CommRing R] [IsDomain R]
    (L : Type u) [Field L] [Algebra (FractionRing (MvPolynomial ℕ+ R)) L]
    [FiniteDimensional (FractionRing (MvPolynomial ℕ+ R)) L] :
    ∃ (s : Finset ℕ+) (n : ℕ)
      (b : Module.Basis (Fin n) (FractionRing (MvPolynomial ℕ+ R)) L)
      (oneCoeff : Fin n → FractionRing (MvPolynomial s R))
      (mulCoeff : Fin n → Fin n → Fin n → FractionRing (MvPolynomial s R)),
      (∀ k : Fin n,
        finiteVariableFractionRingMap (R := R) s (oneCoeff k) = b.repr (1 : L) k) ∧
      (∀ i j k : Fin n,
        finiteVariableFractionRingMap (R := R) s (mulCoeff i j k) =
          b.repr (b i * b j) k) := by
  classical
  -- Proof comment: the earlier finite-support lemma gives existence pointwise; choosing the
  -- witnesses produces coefficient functions that the finite-stage field construction can use.
  obtain ⟨s, n, b, hOne, hMul⟩ :=
    finiteExtension_supportedStructureConstants (R := R) L
  choose oneCoeff hOneCoeff using hOne
  choose mulCoeff hMulCoeff using hMul
  exact ⟨s, n, b, oneCoeff, mulCoeff, hOneCoeff, hMulCoeff⟩

/-- Helper for Chap10 Example 10 161 2: the supplied finite-variable hypotheses make the
normalization finite at every finite subtype stage. -/
private lemma finiteVariableSubtype_integralClosure_finite
    {R : Type u} [CommRing R] [IsDomain R]
    (hfinite : ∀ n : ℕ, IsN2Ring (MvPolynomial (Fin n) R)) (s : Finset ℕ+)
    (L : Type u) [Field L] [Algebra (MvPolynomial s R) L]
    [Algebra (FractionRing (MvPolynomial s R)) L]
    [IsScalarTower (MvPolynomial s R) (FractionRing (MvPolynomial s R)) L]
    [FiniteDimensional (FractionRing (MvPolynomial s R)) L] :
    Module.Finite (MvPolynomial s R) (integralClosure (MvPolynomial s R) L) := by
  -- Proof comment: once the finite subtype stage is known to be `N-2`, its owner field is exactly
  -- the desired finite-normalization statement for this finite fraction-field extension.
  letI : IsN2Ring (MvPolynomial s R) := finiteVariableSubtype_isN2Ring hfinite s
  exact IsN2Ring.integralClosure_finite_of_finiteDimensional
    (R := MvPolynomial s R) (L := L)

/-- Helper for Chap10 Example 10 161 2: supported structure constants over a smaller field make
the finite span of a basis into a finite-dimensional intermediate field. -/
private lemma existsIntermediateFieldOfSupportedStructureConstants
    {K F L : Type*} [Field K] [Field F] [Field L]
    [Algebra K F] [Algebra F L] [Algebra K L] [IsScalarTower K F L]
    {ι : Type*} [Finite ι] (b : Module.Basis ι F L)
    (oneCoeff : ι → K) (mulCoeff : ι → ι → ι → K)
    (hOne : ∀ k : ι, algebraMap K F (oneCoeff k) = b.repr (1 : L) k)
    (hMul : ∀ i j k : ι, algebraMap K F (mulCoeff i j k) = b.repr (b i * b j) k) :
    ∃ E : IntermediateField K L,
      (∀ i : ι, b i ∈ E) ∧ FiniteDimensional K E ∧
        (∀ x : L, x ∈ E ↔ x ∈ Submodule.span K (Set.range fun i : ι ↦ b i)) := by
  classical
  letI : Fintype ι := Fintype.ofFinite ι
  let P : Submodule K L := Submodule.span K (Set.range fun i : ι ↦ b i)
  have hOneSpan : (1 : L) ∈ P := by
    -- Proof comment: rewrite `1` in the `F`-basis and replace every coordinate by its
    -- specified lift from `K`.
    rw [← b.sum_repr (1 : L)]
    refine Submodule.sum_mem P ?_
    intro i hi
    have hcoord : (b.repr (1 : L)) i = algebraMap K F (oneCoeff i) := by
      rw [← hOne]
    rw [hcoord]
    rw [Algebra.smul_def]
    rw [← IsScalarTower.algebraMap_apply K F L]
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem P (oneCoeff i)
      (Submodule.subset_span (Set.mem_range_self i))
  have hBasisMulSpan : ∀ i j : ι, b i * b j ∈ P := by
    intro i j
    -- Proof comment: the same coordinate replacement puts each product of basis vectors back
    -- into the `K`-span of the basis.
    rw [← b.sum_repr (b i * b j)]
    refine Submodule.sum_mem P ?_
    intro k hk
    have hcoord : (b.repr (b i * b j)) k = algebraMap K F (mulCoeff i j k) := by
      rw [← hMul]
    rw [hcoord]
    rw [Algebra.smul_def]
    rw [← IsScalarTower.algebraMap_apply K F L]
    rw [← Algebra.smul_def]
    exact Submodule.smul_mem P (mulCoeff i j k)
      (Submodule.subset_span (Set.mem_range_self k))
  have hMulSpan : ∀ x y : L, x ∈ P → y ∈ P → x * y ∈ P := by
    intro x y hx hy
    -- Proof comment: bilinearity of multiplication extends the generator-product check to all
    -- elements of the span.
    refine Submodule.span_induction₂
      (p := fun x y _ _ ↦ x * y ∈ P)
      ?mem ?zero_left ?zero_right ?add_left ?add_right ?smul_left ?smul_right hx hy
    · intro x y hxmem hymem
      rcases hxmem with ⟨i, rfl⟩
      rcases hymem with ⟨j, rfl⟩
      exact hBasisMulSpan i j
    · intro y hy
      simpa using (Submodule.zero_mem P)
    · intro x hx
      simpa using (Submodule.zero_mem P)
    · intro x y z hx hy hz hxz hyz
      simpa [add_mul] using Submodule.add_mem P hxz hyz
    · intro x y z hx hy hz hxy hxz
      simpa [mul_add] using Submodule.add_mem P hxy hxz
    · intro r x y hx hy hxy
      simpa [Algebra.smul_def, mul_assoc, mul_comm, mul_left_comm] using
        Submodule.smul_mem P r hxy
    · intro r x y hx hy hxy
      simpa [Algebra.smul_def, mul_assoc, mul_comm, mul_left_comm] using
        Submodule.smul_mem P r hxy
  let S : Subalgebra K L := P.toSubalgebra hOneSpan hMulSpan
  have hPfg : P.FG := by
    -- Proof comment: the span is generated by the finite basis-indexed family.
    dsimp [P]
    exact Submodule.fg_span (Set.finite_range fun i : ι ↦ b i)
  letI : Module.Finite K P := Module.Finite.of_fg hPfg
  have hPfd : FiniteDimensional K P := inferInstance
  have hSfdSub : FiniteDimensional K S.toSubmodule := by
    dsimp [S]
    simpa using hPfd
  letI : FiniteDimensional K S := (Subalgebra.finiteDimensional_toSubmodule).mp hSfdSub
  letI : Field S := fieldOfFiniteDimensional K S
  let E : IntermediateField K L := S.toIntermediateField' (Field.toIsField S)
  refine ⟨E, ?_, ?_, ?_⟩
  · intro i
    change b i ∈ S
    dsimp [S]
    exact Submodule.subset_span (Set.mem_range_self i)
  · change FiniteDimensional K S
    infer_instance
  · intro x
    change x ∈ S ↔ x ∈ P
    constructor
    · intro hx
      exact hx
    · intro hx
      exact hx

/-- Helper for Chap10 Example 10 161 2: if a basis-defined linear map preserves products of
basis vectors, then it preserves all products. -/
private lemma basisLinearMap_map_mul_of_basis_mul
    {K L M : Type*} [Field K] [Ring L] [Ring M]
    [Algebra K L] [Algebra K M] {ι : Type*}
    (b : Module.Basis ι K L) (y : ι → M)
    (hMul : ∀ i j, ((b.constr K) y) (b i * b j) =
      ((b.constr K) y) (b i) * ((b.constr K) y) (b j)) :
    ∀ x z, ((b.constr K) y) (x * z) = ((b.constr K) y) x * ((b.constr K) y) z := by
  -- Proof comment: multiplicativity is equality of two bilinear maps, so checking on basis
  -- vectors in both variables is enough.
  rw [LinearMap.map_mul_iff]
  apply b.ext
  intro i
  apply b.ext
  intro j
  exact hMul i j

/-- Helper for Chap10 Example 10 161 2: a unital basis-defined linear map that preserves products
of basis vectors is an injective algebra hom. -/
private lemma basisAlgHomOfBasisMul
    {K L M : Type*} [Field K] [Field L] [Field M]
    [Algebra K L] [Algebra K M] {ι : Type*}
    (b : Module.Basis ι K L) (y : ι → M)
    (hOne : ((b.constr K) y) 1 = 1)
    (hMul : ∀ i j, ((b.constr K) y) (b i * b j) =
      ((b.constr K) y) (b i) * ((b.constr K) y) (b j)) :
    ∃ φ : L →ₐ[K] M, Function.Injective φ ∧ ∀ i, φ (b i) = y i := by
  -- Proof comment: after the multiplicativity helper, `AlgHom.ofLinearMap` packages the linear
  -- map as an algebra hom; injectivity follows because its source is a field.
  let f : L →ₗ[K] M := (b.constr K) y
  have hfMul : ∀ x z, f (x * z) = f x * f z :=
    basisLinearMap_map_mul_of_basis_mul b y hMul
  let φ : L →ₐ[K] M := AlgHom.ofLinearMap f hOne hfMul
  refine ⟨φ, ?_, ?_⟩
  · exact RingHom.injective φ.toRingHom
  · intro i
    exact Module.Basis.constr_basis b K y i

/-- Helper for Chap10 Example 10 161 2: a span-defined intermediate field inherits the
restricted basis. -/
private lemma supportedSpanBasis
    {K F L : Type*} [Field K] [Field F] [Field L]
    [Algebra K F] [Algebra F L] [Algebra K L] [IsScalarTower K F L]
    {ι : Type*} (b : Module.Basis ι F L)
    (E : IntermediateField K L)
    (hbE : ∀ i : ι, b i ∈ E)
    (hEcarrier : ∀ x : L, x ∈ E ↔ x ∈ Submodule.span K (Set.range fun i : ι ↦ b i)) :
    ∃ bE : Module.Basis ι K E, ∀ i : ι, ((bE i : E) : L) = b i := by
  let v : ι → E := fun i ↦ ⟨b i, hbE i⟩
  let incl : E →ₗ[K] L := (E.val : E →ₐ[K] L).toLinearMap
  have hbK : LinearIndependent K (fun i : ι ↦ b i) := by
    -- Proof comment: the original `F`-basis is still linearly independent after restricting
    -- scalars along the injective field map `K → F`.
    exact LinearIndependent.restrict_scalars
      (R := K) (K := F) (M := L)
      (by
        intro x y hxy
        exact (RingHom.injective (algebraMap K F)) (by simpa [Algebra.smul_def] using hxy))
      b.linearIndependent
  have hvLI : LinearIndependent K v := by
    -- Proof comment: linear independence can be checked after the injective inclusion into `L`.
    apply LinearIndependent.of_comp incl
    simpa [v, incl, Function.comp] using hbK
  have hmap_span :
      Submodule.map incl (Submodule.span K (Set.range v)) =
        Submodule.span K (Set.range fun i : ι ↦ b i) := by
    -- Proof comment: the image of the restricted generators is exactly the original basis
    -- family in `L`.
    rw [LinearMap.map_span]
    congr 1
    ext x
    constructor
    · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨v i, ⟨i, rfl⟩, rfl⟩
  have hspan : ⊤ ≤ Submodule.span K (Set.range v) := by
    intro x _
    have hxL : (x : L) ∈ Submodule.span K (Set.range fun i : ι ↦ b i) :=
      (hEcarrier (x : L)).1 x.2
    have hxMap : (x : L) ∈ Submodule.map incl (Submodule.span K (Set.range v)) := by
      simpa [hmap_span] using hxL
    rcases hxMap with ⟨y, hy, hxy⟩
    have hyx : y = x := Subtype.ext hxy
    simpa [hyx] using hy
  refine ⟨Module.Basis.mk hvLI hspan, ?_⟩
  intro i
  simp [Module.Basis.mk_apply, v]

/-- Helper for Chap10 Example 10 161 2: the supported span field base-changes back to the
original finite extension. -/
private lemma supportedSpanBaseChangeAlgEquiv
    {K F L : Type*} [Field K] [Field F] [Field L]
    [Algebra K F] [Algebra F L] [Algebra K L] [IsScalarTower K F L]
    (E : IntermediateField K L) {ι : Type*}
    (b : Module.Basis ι F L) (bE : Module.Basis ι K E)
    (hbE : ∀ i : ι, ((bE i : E) : L) = b i) :
    ∃ e : TensorProduct K F E ≃ₐ[F] L,
      ∀ i : ι, e (1 ⊗ₜ[K] bE i) = b i := by
  let φ : TensorProduct K F E →ₐ[F] L :=
    Algebra.TensorProduct.productLeftAlgHom (Algebra.ofId F L) (E.val : E →ₐ[K] L)
  let v : ι → TensorProduct K F E := fun i ↦ (Module.Basis.baseChange F bE) i
  have hφ_basis : ∀ i : ι, φ (v i) = b i := by
    intro i
    -- Proof comment: the canonical tensor multiplication map sends `1 ⊗ bE i` to the original
    -- basis vector `b i`.
    dsimp [v]
    rw [Module.Basis.baseChange_apply]
    simp [φ, Algebra.TensorProduct.productLeftAlgHom, Algebra.TensorProduct.lift_tmul, hbE i]
  have hφ_basis_fun : (fun i : ι ↦ φ (v i)) = fun i : ι ↦ b i := by
    funext i
    exact hφ_basis i
  have hbij : Function.Bijective φ := by
    have hv_span : Submodule.span F (Set.range v) = ⊤ :=
      (Module.Basis.baseChange F bE).span_eq
    have hli_image : LinearIndependent F (fun i : ι ↦ φ (v i)) := by
      rw [hφ_basis_fun]
      exact b.linearIndependent
    have hspan_image : Submodule.span F (Set.range fun i : ι ↦ φ (v i)) = ⊤ := by
      rw [hφ_basis_fun]
      exact b.span_eq
    -- Proof comment: a linear map that carries a basis to a basis is bijective.
    exact LinearMap.bijective_of_linearIndependent_of_span_eq_top
      hv_span hli_image hspan_image
  refine ⟨AlgEquiv.ofBijective φ hbij, ?_⟩
  intro i
  rw [AlgEquiv.ofBijective_apply]
  simp [φ, Algebra.TensorProduct.productLeftAlgHom, Algebra.TensorProduct.lift_tmul, hbE i]

/-- Helper for Chap10 Example 10 161 2: a finite injective coefficient extension gives a finite
injective tail-polynomial overring of the countable-variable polynomial ring. -/
private lemma tailPolynomialOverringFiniteAndInjective
    {R C : Type u} [CommRing R] [CommRing C] (s : Finset ℕ+)
    [Algebra (MvPolynomial s R) C] [Module.Finite (MvPolynomial s R) C]
    (hCinj : Function.Injective (algebraMap (MvPolynomial s R) C)) :
    let τ := ↥((↑s : Set ℕ+)ᶜ)
    let Ainf := MvPolynomial ℕ+ R
    let S := MvPolynomial τ C
    let f : Ainf →+* S :=
      (MvPolynomial.map (algebraMap (MvPolynomial s R) C)).comp
        (countablePolynomialTailAlgEquiv R s).symm.toRingEquiv.toRingHom
    let _ : Algebra Ainf S := f.toAlgebra
    Function.Injective (algebraMap Ainf S) ∧ Module.Finite Ainf S ∧
      Function.Injective (algebraMap C S) := by
  dsimp only
  let τ := ↥((↑s : Set ℕ+)ᶜ)
  let Ainf := MvPolynomial ℕ+ R
  let T := MvPolynomial τ (MvPolynomial s R)
  let S := MvPolynomial τ C
  let fT : T →+* S := MvPolynomial.map (algebraMap (MvPolynomial s R) C)
  letI : Algebra T S := fT.toAlgebra
  let e : T ≃+* Ainf := (countablePolynomialTailAlgEquiv R s).toRingEquiv
  let f : Ainf →+* S := fT.comp e.symm.toRingHom
  letI : Algebra Ainf S := f.toAlgebra
  have hfTinj : Function.Injective fT := by
    -- Proof comment: coefficient-map injectivity is preserved by `MvPolynomial.map`.
    exact MvPolynomial.map_injective (algebraMap (MvPolynomial s R) C) hCinj
  have hfinT : Module.Finite T S := by
    -- Proof comment: module-finiteness of coefficients remains finite after adjoining the tail
    -- variables.
    simpa [T, S, fT] using
      (mvPolynomial_map_finite_of_moduleFinite (A := MvPolynomial s R) (B := C) τ)
  have hAinj : Function.Injective (algebraMap Ainf S) := by
    intro x y hxy
    exact e.symm.injective (hfTinj hxy)
  have hfinA : Module.Finite Ainf S := by
    have hcompat :
        (algebraMap Ainf S).comp e.toRingHom =
          (RingEquiv.refl S).toRingHom.comp (algebraMap T S) := by
      exact RingHom.ext fun x ↦ by
        change f (e x) = fT x
        simp [f]
    -- Proof comment: transport the finite `T`-module structure across the tail decomposition
    -- equivalence `T ≃ Ainf`.
    exact Module.Finite.of_equiv_equiv e (RingEquiv.refl S) hcompat
  have hCinjS : Function.Injective (algebraMap C S) := by
    -- Proof comment: constants embed injectively into a multivariable polynomial ring.
    simpa [S] using (MvPolynomial.C_injective τ C)
  exact ⟨hAinj, hfinA, hCinjS⟩

/-- Helper for Chap10 Example 10 161 2: under the finite-tail decomposition, a finite-stage
polynomial becomes a constant polynomial in the complementary variables. -/
private lemma countablePolynomialTailAlgEquiv_symm_rename_finiteVariable
    {R : Type u} [CommSemiring R] (s : Finset ℕ+) (p : MvPolynomial s R) :
    (countablePolynomialTailAlgEquiv R s).symm
        (MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) p) =
      MvPolynomial.C p := by
  -- Proof comment: compare the two ring maps out of the finite-stage polynomial ring on
  -- coefficients and variables; the sum decomposition sends finite variables to constants.
  have hhom :
      (countablePolynomialTailAlgEquiv R s).symm.toRingEquiv.toRingHom.comp
          (MvPolynomial.rename (fun i : s ↦ (i : ℕ+))).toRingHom =
        (MvPolynomial.C :
          MvPolynomial s R →+* MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) (MvPolynomial s R)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      change
        (countablePolynomialTailAlgEquiv R s).symm
            ((MvPolynomial.rename (fun i : s ↦ (i : ℕ+))) (MvPolynomial.C r)) =
          (MvPolynomial.C (MvPolynomial.C r) :
            MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) (MvPolynomial s R))
      rw [MvPolynomial.rename_C]
      simp only [countablePolynomialTailAlgEquiv, AlgEquiv.symm_trans_apply,
        MvPolynomial.renameEquiv_symm, MvPolynomial.renameEquiv_apply, MvPolynomial.rename_C]
      rw [AlgEquiv.symm_symm, MvPolynomial.sumAlgEquiv_apply, MvPolynomial.sumToIter_C]
    · intro i
      change
        (countablePolynomialTailAlgEquiv R s).symm
            ((MvPolynomial.rename (fun i : s ↦ (i : ℕ+))) (MvPolynomial.X i)) =
          (MvPolynomial.C (MvPolynomial.X i) :
            MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) (MvPolynomial s R))
      rw [MvPolynomial.rename_X]
      simp only [countablePolynomialTailAlgEquiv, AlgEquiv.symm_trans_apply,
        MvPolynomial.renameEquiv_symm, MvPolynomial.renameEquiv_apply]
      rw [MvPolynomial.rename_X]
      rw [Equiv.symm_trans_apply, Equiv.Set.sumCompl_symm_apply]
      change
        (MvPolynomial.sumAlgEquiv R (↥((↑s : Set ℕ+)ᶜ)) s).symm.symm
            (MvPolynomial.X (Sum.inr i)) =
          (MvPolynomial.C (MvPolynomial.X i) :
            MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) (MvPolynomial s R))
      rw [AlgEquiv.symm_symm, MvPolynomial.sumAlgEquiv_apply, MvPolynomial.sumToIter_Xr]
  exact congrFun (congrArg DFunLike.coe hhom) p

/-- Helper for Chap10 Example 10 161 2: the named tail-polynomial overring attached to a
finite-stage coefficient extension. -/
private abbrev tailPolynomialOverring
    (_R : Type u) (C : Type u) [CommSemiring C] (s : Finset ℕ+) :=
  MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) C

/-- Helper for Chap10 Example 10 161 2: the countable-variable algebra structure on the named
tail-polynomial overring. -/
@[reducible]
private noncomputable def tailPolynomialOverringAlgebra
    (R : Type u) {C : Type u} [CommRing R] [CommRing C] (s : Finset ℕ+)
    [Algebra (MvPolynomial s R) C] :
    Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
  ((MvPolynomial.map (algebraMap (MvPolynomial s R) C)).comp
    (countablePolynomialTailAlgEquiv R s).symm.toRingEquiv.toRingHom).toAlgebra

/-- Helper for Chap10 Example 10 161 2: the countable-variable structure map sends the finite
stage to coefficient constants in the named tail overring. -/
private lemma tailPolynomialOverring_algebraMap_finiteVariable
    {R C : Type u} [CommRing R] [CommRing C] (s : Finset ℕ+)
    [Algebra (MvPolynomial s R) C] (p : MvPolynomial s R) :
    let _ : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
      tailPolynomialOverringAlgebra R s
    algebraMap (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s)
        (MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) p) =
      algebraMap C (tailPolynomialOverring R C s) (algebraMap (MvPolynomial s R) C p) := by
  -- Proof comment: unfold only the named algebra structure and use the finite-variable projection
  -- lemma to keep the tail carrier in a stable spelling.
  letI : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
    tailPolynomialOverringAlgebra R s
  change
    MvPolynomial.map (algebraMap (MvPolynomial s R) C)
        ((countablePolynomialTailAlgEquiv R s).symm
          (MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) p)) =
      MvPolynomial.C (algebraMap (MvPolynomial s R) C p)
  rw [countablePolynomialTailAlgEquiv_symm_rename_finiteVariable]
  rw [MvPolynomial.map_C]

/-- Helper for Chap10 Example 10 161 2: the named tail overring receives the countable-variable
polynomial ring injectively. -/
private lemma tailPolynomialOverring_algebraMap_injective
    {R C : Type u} [CommRing R] [CommRing C] (s : Finset ℕ+)
    [Algebra (MvPolynomial s R) C] [Module.Finite (MvPolynomial s R) C]
    (hCinj : Function.Injective (algebraMap (MvPolynomial s R) C)) :
    let _ : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
      tailPolynomialOverringAlgebra R s
    Function.Injective
      (algebraMap (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s)) := by
  -- Proof comment: project the injectivity component from the raw finite-tail package while
  -- keeping all later uses in the named overring spelling.
  letI : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
    tailPolynomialOverringAlgebra R s
  simpa [tailPolynomialOverring, tailPolynomialOverringAlgebra] using
    (tailPolynomialOverringFiniteAndInjective (R := R) (C := C) s hCinj).1

/-- Helper for Chap10 Example 10 161 2: the named tail overring is finite over the
countable-variable polynomial ring. -/
private lemma tailPolynomialOverring_finite
    {R C : Type u} [CommRing R] [CommRing C] (s : Finset ℕ+)
    [Algebra (MvPolynomial s R) C] [Module.Finite (MvPolynomial s R) C]
    (hCinj : Function.Injective (algebraMap (MvPolynomial s R) C)) :
    let _ : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
      tailPolynomialOverringAlgebra R s
    Module.Finite (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) := by
  -- Proof comment: the finite-tail package gives module-finiteness once the carrier and algebra
  -- map have been fixed by the named API above.
  letI : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
    tailPolynomialOverringAlgebra R s
  simpa [tailPolynomialOverring, tailPolynomialOverringAlgebra] using
    (tailPolynomialOverringFiniteAndInjective (R := R) (C := C) s hCinj).2.1

/-- Helper for Chap10 Example 10 161 2: coefficients embed injectively into the named tail
polynomial overring. -/
private lemma tailPolynomialOverring_C_injective
    (R : Type u) {C : Type u} [CommSemiring C] (s : Finset ℕ+) :
    Function.Injective (algebraMap C (tailPolynomialOverring R C s)) := by
  -- Proof comment: constants embed injectively into every multivariable polynomial ring.
  simpa [tailPolynomialOverring] using
    (MvPolynomial.C_injective (↥((↑s : Set ℕ+)ᶜ)) C)

/-- Helper for Chap10 Example 10 161 2: a multivariable polynomial ring over an integrally
closed domain is integrally closed, for an arbitrary variable type. -/
private lemma mvPolynomial_isIntegrallyClosed_of_isIntegrallyClosed
    {C : Type u} [CommRing C] [IsDomain C] [IsIntegrallyClosed C] (τ : Type*) :
    IsIntegrallyClosed (MvPolynomial τ C) := by
  classical
  let K := FractionRing C
  letI : Algebra (MvPolynomial τ C) (MvPolynomial τ K) := MvPolynomial.algebraMvPolynomial
  have hClosedIn : IsIntegrallyClosedIn (MvPolynomial τ C) (MvPolynomial τ K) := by
    refine isIntegrallyClosedIn_iff.mpr ⟨?_, ?_⟩
    · -- Proof comment: coefficientwise embedding into the fraction field is injective.
      exact MvPolynomial.map_injective (algebraMap C K) (IsFractionRing.injective C K)
    · intro p hp
      -- Proof comment: integrality of a multivariable polynomial is detected coefficientwise.
      have hcoeff : ∀ n, IsIntegral C (MvPolynomial.coeff n p) :=
        MvPolynomial.isIntegral_iff_isIntegral_coeff.mp hp
      choose c hc using fun n => IsIntegrallyClosed.algebraMap_eq_of_integral (hcoeff n)
      let q : MvPolynomial τ C := p.support.sum fun n ↦ MvPolynomial.monomial n (c n)
      refine ⟨q, ?_⟩
      -- Proof comment: rebuild the source polynomial from the lifted coefficients and compare
      -- after applying the coefficientwise fraction-field map.
      calc
        algebraMap (MvPolynomial τ C) (MvPolynomial τ K) q =
            p.support.sum fun n ↦ MvPolynomial.monomial n (algebraMap C K (c n)) := by
          simp [q, MvPolynomial.map_monomial]
        _ = p.support.sum fun n ↦ MvPolynomial.monomial n (MvPolynomial.coeff n p) := by
          simp [hc]
        _ = p := by
          rw [MvPolynomial.support_sum_monomial_coeff]
  letI : UniqueFactorizationMonoid (MvPolynomial τ K) := inferInstance
  letI : Nonempty (GCDMonoid (MvPolynomial τ K)) :=
    ⟨UniqueFactorizationMonoid.toGCDMonoid (MvPolynomial τ K)⟩
  letI : IsIntegrallyClosed (MvPolynomial τ K) := GCDMonoid.toIsIntegrallyClosed
  -- Proof comment: an integrally closed ambient polynomial ring plus the closed-in-field
  -- coefficient-lifting statement gives integrally closedness of the original polynomial ring.
  exact IsIntegrallyClosed.of_isIntegrallyClosed_of_isIntegrallyClosedIn
    (MvPolynomial τ C) (MvPolynomial τ K)

/-- Helper for Chap10 Example 10 161 2: the named tail-polynomial overring over an integrally
closed coefficient domain is integrally closed. -/
private lemma tailPolynomialOverring_integrallyClosed
    (R : Type u) {C : Type u} [CommRing C] [IsDomain C] [IsIntegrallyClosed C]
    (s : Finset ℕ+) :
    IsIntegrallyClosed (tailPolynomialOverring R C s) := by
  -- Proof comment: unfold only the named carrier and use the arbitrary-variable polynomial
  -- normality helper, keeping the tail-overring API stable for later transport steps.
  simpa [tailPolynomialOverring] using
    (mvPolynomial_isIntegrallyClosed_of_isIntegrallyClosed
      (C := C) (τ := ↥((↑s : Set ℕ+)ᶜ)))

/-- Helper for Chap10 Example 10 161 2: after passing coefficients to a fraction field, the
fraction field of the resulting polynomial ring is still a fraction field of the original
polynomial ring. -/
private lemma mvPolynomial_isFractionRing_of_isFractionRing_coefficients
    {C E : Type u} [CommRing C] [IsDomain C] [Field E] [Algebra C E] [IsFractionRing C E]
    (τ : Type*) :
    let f : MvPolynomial τ C →+* MvPolynomial τ E := MvPolynomial.map (algebraMap C E)
    let _ : Algebra (MvPolynomial τ C) (MvPolynomial τ E) := f.toAlgebra
    let _ : Algebra (MvPolynomial τ C) (FractionRing (MvPolynomial τ E)) :=
      RingHom.toAlgebra ((algebraMap (MvPolynomial τ E) (FractionRing (MvPolynomial τ E))).comp f)
    IsFractionRing (MvPolynomial τ C) (FractionRing (MvPolynomial τ E)) := by
  let A := MvPolynomial τ C
  let B := MvPolynomial τ E
  let f : A →+* B := MvPolynomial.map (algebraMap C E)
  letI : Algebra A B := f.toAlgebra
  letI : SMul A B := (show Algebra A B from inferInstance).toSMul
  letI : Algebra A (FractionRing B) :=
    RingHom.toAlgebra ((algebraMap B (FractionRing B)).comp f)
  letI : SMul A (FractionRing B) :=
    (show Algebra A (FractionRing B) from inferInstance).toSMul
  let c : C →* A := (MvPolynomial.C : C →+* A).toMonoidWithZeroHom.toMonoidHom
  have hloc : IsLocalization ((nonZeroDivisors C).map c) B := by
    -- Proof comment: polynomial coefficient localization is exactly mathlib's
    -- `MvPolynomial.isLocalization` instance.
    simpa [A, B, f, c] using
      (MvPolynomial.isLocalization (σ := τ) (M := nonZeroDivisors C) (S := E))
  letI : IsLocalization ((nonZeroDivisors C).map c) B := hloc
  have htower : IsScalarTower A B (FractionRing B) := by
    -- Proof comment: the chosen `A`-algebra structure on `FractionRing B` is the composite
    -- `A -> B -> FractionRing B`, so the scalar tower is definitional after fixing the spelling.
    refine IsScalarTower.of_algebraMap_eq (R := A) (S := B) (A := FractionRing B) ?_
    intro x
    rfl
  letI : IsScalarTower A B (FractionRing B) := htower
  have hlocFraction :
      IsLocalization ((nonZeroDivisors B).comap (algebraMap A B)) (FractionRing B) := by
    -- Proof comment: localizing first at coefficient denominators and then at all nonzero
    -- polynomials is the same as localizing `A` at the preimage of those nonzero polynomials.
    refine IsLocalization.localization_localization_isLocalization_of_has_all_units
      ((nonZeroDivisors C).map c) (nonZeroDivisors B) (FractionRing B) ?_
    intro x hx
    exact hx.mem_nonZeroDivisors
  have hsub_eq : (nonZeroDivisors B).comap (algebraMap A B) = nonZeroDivisors A := by
    -- Proof comment: the coefficient fraction-field map is injective, so a source polynomial is
    -- nonzero exactly when its coefficient-localized image is nonzero.
    ext p
    simp only [Submonoid.mem_comap]
    rw [mem_nonZeroDivisors_iff_ne_zero, mem_nonZeroDivisors_iff_ne_zero]
    constructor
    · intro hp hzero
      exact hp (by simp [hzero])
    · intro hp
      have hf_inj : Function.Injective (algebraMap A B) := by
        dsimp [A, B]
        exact MvPolynomial.map_injective (algebraMap C E) (IsFractionRing.injective C E)
      exact fun hmapzero => hp (hf_inj (by simpa using hmapzero))
  rwa [hsub_eq] at hlocFraction

/-- Helper for Chap10 Example 10 161 2: the coefficient-localization fraction-field bridge in
the named tail-polynomial overring spelling. -/
private lemma tailPolynomialOverring_fractionRing_of_coefficients
    {R C E : Type u} [CommRing R] [CommRing C] [IsDomain C] [Field E] [Algebra C E]
    [IsFractionRing C E] (s : Finset ℕ+) :
    let f : tailPolynomialOverring R C s →+* tailPolynomialOverring R E s :=
      MvPolynomial.map (algebraMap C E)
    let _ : Algebra (tailPolynomialOverring R C s) (tailPolynomialOverring R E s) := f.toAlgebra
    let _ : Algebra (tailPolynomialOverring R C s)
        (FractionRing (tailPolynomialOverring R E s)) :=
      RingHom.toAlgebra
        ((algebraMap (tailPolynomialOverring R E s)
          (FractionRing (tailPolynomialOverring R E s))).comp f)
    IsFractionRing (tailPolynomialOverring R C s)
      (FractionRing (tailPolynomialOverring R E s)) := by
  -- Proof comment: specialize the canonical coefficient-localization bridge to the tail carrier
  -- and hide the carrier unfolding behind this named adapter.
  simpa [tailPolynomialOverring] using
    (mvPolynomial_isFractionRing_of_isFractionRing_coefficients
      (C := C) (E := E) (τ := ↥((↑s : Set ℕ+)ᶜ)))

/-- Helper for Chap10 Example 10 161 2: the base ring embeds into its integral closure inside a
field extension of its fraction field. -/
private lemma integralClosure_algebraMap_injective_fractionField
    {A K L : Type u} [CommRing A] [IsDomain A] [Field K] [Algebra A K]
    [IsFractionRing A K] [Field L] [Algebra K L] [Algebra A L]
    [IsScalarTower A K L] :
    Function.Injective (algebraMap A (integralClosure A L)) := by
  intro x y hxy
  -- Proof comment: coerce the equality into the ambient field and then pull it back through
  -- `A → K → L`.
  apply IsFractionRing.injective A K
  apply RingHom.injective (algebraMap K L)
  calc
    algebraMap K L (algebraMap A K x) = algebraMap A L x := by
      rw [IsScalarTower.algebraMap_apply A K L]
    _ = (algebraMap A (integralClosure A L) x : L) := rfl
    _ = (algebraMap A (integralClosure A L) y : L) := by rw [hxy]
    _ = algebraMap A L y := rfl
    _ = algebraMap K L (algebraMap A K y) := by
      rw [IsScalarTower.algebraMap_apply A K L]

/-- Helper for Chap10 Example 10 161 2: a finite normal overring whose fraction field is `L`
gives the finite normalization over the original base. -/
private lemma moduleFinite_integralClosure_of_finite_normal_fractionRing
    {A S L : Type u} [CommRing A] [IsDomain A] [CommRing S] [IsDomain S] [Field L]
    [Algebra A S] [Module.Finite A S] [IsIntegrallyClosed S]
    [Algebra A L] [Algebra S L] [IsScalarTower A S L] [IsFractionRing S L] :
    Module.Finite A (integralClosure A L) := by
  -- Proof comment: finiteness makes the overring integral over the base, so a normal overring
  -- with fraction field `L` is another model of the integral closure of `A` in `L`.
  letI : Algebra.IsIntegral A S := Algebra.IsIntegral.of_finite A S
  letI : IsIntegralClosure S A L := IsIntegralClosure.of_isIntegrallyClosed S A L
  -- Proof comment: uniqueness of integral closures identifies `S` with the canonical
  -- `integralClosure A L`, and module-finiteness transports across that equivalence.
  exact Module.Finite.equiv
    (IsIntegralClosure.equiv A S L (integralClosure A L)).toLinearEquiv

/-- Helper for Chap10 Example 10 161 2: finite normalization may be proved over a convenient
fraction field and transported across an algebra-compatible ring equivalence. -/
private lemma moduleFinite_integralClosure_of_finite_normal_fractionRing_ringEquiv
    {A S K L : Type u} [CommRing A] [IsDomain A] [CommRing S] [IsDomain S]
    [Field K] [Field L] [Algebra A S] [Module.Finite A S] [IsIntegrallyClosed S]
    [Algebra A K] [Algebra S K] [IsScalarTower A S K] [IsFractionRing S K]
    [Algebra A L] (e : K ≃+* L)
    (he : ∀ a : A, e (algebraMap A K a) = algebraMap A L a) :
    Module.Finite A (integralClosure A L) := by
  -- Proof comment: first prove the finite-normalization statement over the fraction field `K`.
  let eA : K ≃ₐ[A] L := AlgEquiv.ofRingEquiv he
  letI : Module.Finite A (integralClosure A K) :=
    moduleFinite_integralClosure_of_finite_normal_fractionRing (A := A) (S := S) (L := K)
  -- Proof comment: the algebra-compatible equivalence carries the integral closure in `K` to
  -- the integral closure in `L`.
  exact Module.Finite.equiv eA.mapIntegralClosure.toLinearEquiv

/-- Helper for Chap10 Example 10 161 2: a pushout fraction field transported along a base
fraction-field equivalence and then along a tensor-product equivalence gives a ring equivalence
to the target field. -/
private noncomputable def pushoutRingEquivOfTensorBaseChange
    {Ks Ktail Kinf E KE L : Type u}
    [Field Ks] [Field Ktail] [Field Kinf] [Field E] [Field KE] [Field L]
    [Algebra Ks Ktail] [Algebra Ks Kinf] [Algebra Ks E]
    [Algebra Ks KE] [Algebra Ktail KE] [Algebra E KE]
    [IsScalarTower Ks Ktail KE] [IsScalarTower Ks E KE]
    [Algebra.IsPushout Ks Ktail E KE] [Algebra Kinf L]
    (eBase : Ktail ≃ₐ[Ks] Kinf) (eTensor : TensorProduct Ks Kinf E ≃ₐ[Kinf] L) :
    KE ≃+* L :=
  -- Construction comment: first identify the pushout with `Ktail ⊗ E`, then replace the left
  -- tensor factor by `Kinf`, and finally use the supplied tensor model of `L`.
  (Algebra.IsPushout.equiv Ks Ktail E KE).symm.toRingEquiv.trans
    ((Algebra.TensorProduct.congr eBase (AlgEquiv.refl : E ≃ₐ[Ks] E)).toRingEquiv.trans
      eTensor.toRingEquiv)

/-- Helper for Chap10 Example 10 161 2: the pushout transport helper sends the left pushout
structure map to the corresponding tensor element after applying the base equivalence. -/
private lemma pushoutRingEquivOfTensorBaseChange_algebraMap_left
    {Ks Ktail Kinf E KE L : Type u}
    [Field Ks] [Field Ktail] [Field Kinf] [Field E] [Field KE] [Field L]
    [Algebra Ks Ktail] [Algebra Ks Kinf] [Algebra Ks E]
    [Algebra Ks KE] [Algebra Ktail KE] [Algebra E KE]
    [IsScalarTower Ks Ktail KE] [IsScalarTower Ks E KE]
    [Algebra.IsPushout Ks Ktail E KE] [Algebra Kinf L]
    (eBase : Ktail ≃ₐ[Ks] Kinf) (eTensor : TensorProduct Ks Kinf E ≃ₐ[Kinf] L)
    (x : Ktail) :
    pushoutRingEquivOfTensorBaseChange eBase eTensor (algebraMap Ktail KE x) =
      eTensor (eBase x ⊗ₜ[Ks] (1 : E)) := by
  -- Proof comment: expose the defining composite so the canonical pushout computation can
  -- rewrite the left structure map before the tensor-factor equivalence is evaluated.
  simp only [pushoutRingEquivOfTensorBaseChange, RingEquiv.trans_apply]
  have hleft :
      (Algebra.IsPushout.equiv Ks Ktail E KE).symm.toRingEquiv
          (algebraMap Ktail KE x) = x ⊗ₜ[Ks] (1 : E) := by
    exact Algebra.IsPushout.equiv_symm_algebraMap_left
      (R := Ks) (S := Ktail) (R' := E) (S' := KE) x
  rw [hleft]
  simp

/-- Helper for Chap10 Example 10 161 2: the pushout transport helper sends the right pushout
structure map to the corresponding right tensor element. -/
private lemma pushoutRingEquivOfTensorBaseChange_algebraMap_right
    {Ks Ktail Kinf E KE L : Type u}
    [Field Ks] [Field Ktail] [Field Kinf] [Field E] [Field KE] [Field L]
    [Algebra Ks Ktail] [Algebra Ks Kinf] [Algebra Ks E]
    [Algebra Ks KE] [Algebra Ktail KE] [Algebra E KE]
    [IsScalarTower Ks Ktail KE] [IsScalarTower Ks E KE]
    [Algebra.IsPushout Ks Ktail E KE] [Algebra Kinf L]
    (eBase : Ktail ≃ₐ[Ks] Kinf) (eTensor : TensorProduct Ks Kinf E ≃ₐ[Kinf] L)
    (x : E) :
    pushoutRingEquivOfTensorBaseChange eBase eTensor (algebraMap E KE x) =
      eTensor ((1 : Kinf) ⊗ₜ[Ks] x) := by
  -- Proof comment: the right pushout computation produces `1 ⊗ x`; the base-change congruence
  -- then leaves the right tensor factor untouched.
  simp only [pushoutRingEquivOfTensorBaseChange, RingEquiv.trans_apply]
  have hright :
      (Algebra.IsPushout.equiv Ks Ktail E KE).symm.toRingEquiv
          (algebraMap E KE x) = (1 : Ktail) ⊗ₜ[Ks] x := by
    exact Algebra.IsPushout.equiv_symm_algebraMap_right
      (R := Ks) (S := Ktail) (R' := E) (S' := KE) x
  rw [hright]
  simp

/-- Helper for Chap10 Example 10 161 2: the fraction field of the finite-stage tail model is
canonically the fraction field of the countable-variable polynomial ring. -/
private noncomputable def baseTailFractionRingEquiv
    {R Ks : Type u} [CommRing R] [IsDomain R] (s : Finset ℕ+)
    [Field Ks] [Algebra (MvPolynomial s R) Ks] [IsFractionRing (MvPolynomial s R) Ks] :
    FractionRing (tailPolynomialOverring R Ks s) ≃+*
      FractionRing (MvPolynomial ℕ+ R) :=
  let As := MvPolynomial s R
  let f : tailPolynomialOverring R As s →+* tailPolynomialOverring R Ks s :=
    MvPolynomial.map (algebraMap As Ks)
  let _ : Algebra (tailPolynomialOverring R As s) (tailPolynomialOverring R Ks s) :=
    f.toAlgebra
  let _ : Algebra (tailPolynomialOverring R As s)
      (FractionRing (tailPolynomialOverring R Ks s)) :=
    RingHom.toAlgebra
      ((algebraMap (tailPolynomialOverring R Ks s)
        (FractionRing (tailPolynomialOverring R Ks s))).comp f)
  let _ : IsFractionRing (tailPolynomialOverring R As s)
      (FractionRing (tailPolynomialOverring R Ks s)) :=
    tailPolynomialOverring_fractionRing_of_coefficients (R := R) (C := As) (E := Ks) s
  IsFractionRing.ringEquivOfRingEquiv (countablePolynomialTailAlgEquiv R s).toRingEquiv

/-- Helper for Chap10 Example 10 161 2: the base tail fraction-field equivalence is compatible
with the common finite-tail polynomial source. -/
private lemma baseTailFractionRingEquiv_algebraMap_source
    {R Ks : Type u} [CommRing R] [IsDomain R] (s : Finset ℕ+)
    [Field Ks] [Algebra (MvPolynomial s R) Ks] [IsFractionRing (MvPolynomial s R) Ks]
    (p : tailPolynomialOverring R (MvPolynomial s R) s) :
    let As := MvPolynomial s R
    let f : tailPolynomialOverring R As s →+* tailPolynomialOverring R Ks s :=
      MvPolynomial.map (algebraMap As Ks)
    let _ : Algebra (tailPolynomialOverring R As s) (tailPolynomialOverring R Ks s) :=
      f.toAlgebra
    let _ : Algebra (tailPolynomialOverring R As s)
        (FractionRing (tailPolynomialOverring R Ks s)) :=
      RingHom.toAlgebra
        ((algebraMap (tailPolynomialOverring R Ks s)
          (FractionRing (tailPolynomialOverring R Ks s))).comp f)
    baseTailFractionRingEquiv (R := R) (Ks := Ks) s
        (algebraMap (tailPolynomialOverring R As s)
          (FractionRing (tailPolynomialOverring R Ks s)) p) =
      algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R))
        ((countablePolynomialTailAlgEquiv R s) p) := by
  -- Proof comment: both fields are localizations of the same finite-tail polynomial ring, and
  -- localization uniqueness computes on the source subring.
  let As := MvPolynomial s R
  let f : tailPolynomialOverring R As s →+* tailPolynomialOverring R Ks s :=
    MvPolynomial.map (algebraMap As Ks)
  letI : Algebra (tailPolynomialOverring R As s) (tailPolynomialOverring R Ks s) :=
    f.toAlgebra
  letI : Algebra (tailPolynomialOverring R As s)
      (FractionRing (tailPolynomialOverring R Ks s)) :=
    RingHom.toAlgebra
      ((algebraMap (tailPolynomialOverring R Ks s)
        (FractionRing (tailPolynomialOverring R Ks s))).comp f)
  letI : IsFractionRing (tailPolynomialOverring R As s)
      (FractionRing (tailPolynomialOverring R Ks s)) :=
    tailPolynomialOverring_fractionRing_of_coefficients (R := R) (C := As) (E := Ks) s
  dsimp [baseTailFractionRingEquiv]
  exact IsFractionRing.ringEquivOfRingEquiv_algebraMap
    (countablePolynomialTailAlgEquiv R s).toRingEquiv p

/-- Helper for Chap10 Example 10 161 2: the base tail fraction-field equivalence sends the
image of a countable-variable polynomial to its usual fraction-field image. -/
private lemma baseTailFractionRingEquiv_algebraMap_countable
    {R Ks : Type u} [CommRing R] [IsDomain R] (s : Finset ℕ+)
    [Field Ks] [Algebra (MvPolynomial s R) Ks] [IsFractionRing (MvPolynomial s R) Ks]
    (p : MvPolynomial ℕ+ R) :
    let S := tailPolynomialOverring R Ks s
    let _ : Algebra (MvPolynomial ℕ+ R) S := tailPolynomialOverringAlgebra R s
    let _ : Algebra (MvPolynomial ℕ+ R) (FractionRing S) :=
      RingHom.toAlgebra ((algebraMap S (FractionRing S)).comp (algebraMap (MvPolynomial ℕ+ R) S))
    baseTailFractionRingEquiv (R := R) (Ks := Ks) s
        (algebraMap (MvPolynomial ℕ+ R) (FractionRing S) p) =
      algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R)) p := by
  -- Proof comment: rewrite the countable-variable map through the inverse tail decomposition,
  -- then use the source computation for the localization equivalence.
  dsimp
  let As := MvPolynomial s R
  let T := tailPolynomialOverring R As s
  let S := tailPolynomialOverring R Ks s
  let f : T →+* S := MvPolynomial.map (algebraMap As Ks)
  letI : Algebra T S := f.toAlgebra
  letI : Algebra T (FractionRing S) :=
    RingHom.toAlgebra ((algebraMap S (FractionRing S)).comp f)
  letI : Algebra (MvPolynomial ℕ+ R) S := tailPolynomialOverringAlgebra R s
  letI : Algebra (MvPolynomial ℕ+ R) (FractionRing S) :=
    RingHom.toAlgebra ((algebraMap S (FractionRing S)).comp (algebraMap (MvPolynomial ℕ+ R) S))
  calc
    baseTailFractionRingEquiv (R := R) (Ks := Ks) s
        (algebraMap (MvPolynomial ℕ+ R) (FractionRing S) p)
        = baseTailFractionRingEquiv (R := R) (Ks := Ks) s
            (algebraMap T (FractionRing S) ((countablePolynomialTailAlgEquiv R s).symm p)) := by
          rfl
    _ = algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R))
          ((countablePolynomialTailAlgEquiv R s)
            ((countablePolynomialTailAlgEquiv R s).symm p)) := by
          exact baseTailFractionRingEquiv_algebraMap_source (R := R) (Ks := Ks) s
            ((countablePolynomialTailAlgEquiv R s).symm p)
    _ = algebraMap (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R)) p := by
          rw [AlgEquiv.apply_symm_apply]

/-- Helper for Chap10 Example 10 161 2: the base tail fraction-field equivalence is linear over
the finite-stage fraction field. -/
private lemma baseTailFractionRingEquiv_algebraMap_finiteFraction
    {R Ks : Type u} [CommRing R] [IsDomain R] (s : Finset ℕ+)
    [Field Ks] [Algebra (MvPolynomial s R) Ks] [IsFractionRing (MvPolynomial s R) Ks]
    (x : Ks) :
    let S := tailPolynomialOverring R Ks s
    let _ : Algebra Ks (FractionRing S) :=
      RingHom.toAlgebra ((algebraMap S (FractionRing S)).comp (algebraMap Ks S))
    let _ : Algebra Ks (FractionRing (MvPolynomial ℕ+ R)) :=
      RingHom.toAlgebra
        ((finiteVariableFractionRingMap (R := R) s).comp
          (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
    baseTailFractionRingEquiv (R := R) (Ks := Ks) s
        (algebraMap Ks (FractionRing S) x) =
      algebraMap Ks (FractionRing (MvPolynomial ℕ+ R)) x := by
  -- Proof comment: equality of the two maps out of `Ks` is checked on the finite polynomial
  -- ring `As`, where both sides reduce to the finite-variable inclusion into `Kinf`.
  dsimp
  let As := MvPolynomial s R
  let Kinf := FractionRing (MvPolynomial ℕ+ R)
  let T := tailPolynomialOverring R As s
  let S := tailPolynomialOverring R Ks s
  let f : T →+* S := MvPolynomial.map (algebraMap As Ks)
  letI : Algebra T S := f.toAlgebra
  letI : Algebra T (FractionRing S) :=
    RingHom.toAlgebra ((algebraMap S (FractionRing S)).comp f)
  letI : IsFractionRing T (FractionRing S) :=
    tailPolynomialOverring_fractionRing_of_coefficients (R := R) (C := As) (E := Ks) s
  letI : Algebra Ks (FractionRing S) :=
    RingHom.toAlgebra ((algebraMap S (FractionRing S)).comp (algebraMap Ks S))
  letI : Algebra Ks Kinf :=
    RingHom.toAlgebra
      ((finiteVariableFractionRingMap (R := R) s).comp
        (FractionRing.algEquiv As Ks).symm.toRingHom)
  have hmaps :
      (baseTailFractionRingEquiv (R := R) (Ks := Ks) s).toRingHom.comp
          (algebraMap Ks (FractionRing S)) =
        algebraMap Ks Kinf := by
    apply IsFractionRing.ringHom_ext (A := As)
    intro q
    have htail :
        (countablePolynomialTailAlgEquiv R s)
            (MvPolynomial.C q :
              MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) As) =
          MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) q := by
      -- Proof comment: apply the tail equivalence to the existing inverse-computation lemma.
      have h :=
        congrArg (countablePolynomialTailAlgEquiv R s)
          (countablePolynomialTailAlgEquiv_symm_rename_finiteVariable (R := R) s q)
      simpa using h.symm
    have hcoeffToTail :
        (algebraMap Ks (FractionRing S)) (algebraMap As Ks q) =
          algebraMap T (FractionRing S)
            (MvPolynomial.C q :
              MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) As) := by
      -- Proof comment: both sides are the image in the localization of the constant tail
      -- polynomial with coefficient `q`.
      change (algebraMap S (FractionRing S))
          (algebraMap Ks S (algebraMap As Ks q)) =
        (algebraMap S (FractionRing S))
          (f (MvPolynomial.C q :
            MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) As))
      change (algebraMap S (FractionRing S))
          (MvPolynomial.C (algebraMap As Ks q) :
            MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) Ks) =
        (algebraMap S (FractionRing S))
          (MvPolynomial.map (algebraMap As Ks)
            (MvPolynomial.C q :
              MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) As))
      rw [MvPolynomial.map_C]
    calc
      ((baseTailFractionRingEquiv (R := R) (Ks := Ks) s).toRingHom.comp
          (algebraMap Ks (FractionRing S))) (algebraMap As Ks q)
          = baseTailFractionRingEquiv (R := R) (Ks := Ks) s
              (algebraMap T (FractionRing S)
                (MvPolynomial.C q :
                  MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) As)) := by
            rw [RingHom.comp_apply, hcoeffToTail]
            rfl
      _ = algebraMap (MvPolynomial ℕ+ R) Kinf
            ((countablePolynomialTailAlgEquiv R s)
              (MvPolynomial.C q :
                MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) As)) := by
            exact baseTailFractionRingEquiv_algebraMap_source (R := R) (Ks := Ks) s
              (MvPolynomial.C q :
                MvPolynomial (↥((↑s : Set ℕ+)ᶜ)) As)
      _ = algebraMap (MvPolynomial ℕ+ R) Kinf
            (MvPolynomial.rename (fun i : s ↦ (i : ℕ+)) q) := by
            rw [htail]
      _ = finiteVariableFractionRingMap (R := R) s
            (algebraMap As (FractionRing As) q) := by
            rw [finiteVariableFractionRingMap_algebraMap]
      _ = algebraMap Ks Kinf (algebraMap As Ks q) := by
            have hsymm :
                (FractionRing.algEquiv As Ks).symm (algebraMap As Ks q) =
                  algebraMap As (FractionRing As) q := by
              simpa using ((FractionRing.algEquiv As Ks).symm.commutes q)
            have hsymm' :
                (FractionRing.algEquiv As Ks).symm.toRingEquiv.toRingHom
                    (algebraMap As Ks q) =
                  algebraMap As (FractionRing As) q := by
              exact hsymm
            change finiteVariableFractionRingMap (R := R) s
                (algebraMap As (FractionRing As) q) =
              ((finiteVariableFractionRingMap (R := R) s).comp
                (FractionRing.algEquiv As Ks).symm.toRingHom) (algebraMap As Ks q)
            rw [RingHom.comp_apply, hsymm']
  exact congrArg (fun g : Ks →+* Kinf => g x) hmaps

/-- Helper for Chap10 Example 10 161 2: the base tail fraction-field comparison as a
`Ks`-algebra equivalence. -/
private noncomputable def baseTailFractionRingAlgEquiv
    {R Ks : Type u} [CommRing R] [IsDomain R] (s : Finset ℕ+)
    [Field Ks] [Algebra (MvPolynomial s R) Ks] [IsFractionRing (MvPolynomial s R) Ks] :
    let S := tailPolynomialOverring R Ks s
    let _ : Algebra Ks (FractionRing S) :=
      RingHom.toAlgebra ((algebraMap S (FractionRing S)).comp (algebraMap Ks S))
    let _ : Algebra Ks (FractionRing (MvPolynomial ℕ+ R)) :=
      RingHom.toAlgebra
        ((finiteVariableFractionRingMap (R := R) s).comp
          (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
    FractionRing S ≃ₐ[Ks] FractionRing (MvPolynomial ℕ+ R) :=
  let S := tailPolynomialOverring R Ks s
  let _ : Algebra Ks (FractionRing S) :=
    RingHom.toAlgebra ((algebraMap S (FractionRing S)).comp (algebraMap Ks S))
  let _ : Algebra Ks (FractionRing (MvPolynomial ℕ+ R)) :=
    RingHom.toAlgebra
      ((finiteVariableFractionRingMap (R := R) s).comp
        (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
  AlgEquiv.ofRingEquiv (f := baseTailFractionRingEquiv (R := R) (Ks := Ks) s)
    (baseTailFractionRingEquiv_algebraMap_finiteFraction (R := R) (Ks := Ks) s)

/-- Helper for Chap10 Example 10 161 2: changing coefficients in a named tail overring carries
the countable-variable structure map to the corresponding structure map after coefficient change. -/
private lemma tailPolynomialOverring_map_algebraMap_countable
    {R C D : Type u} [CommRing R] [CommRing C] [CommRing D] (s : Finset ℕ+)
    [Algebra (MvPolynomial s R) C] [Algebra (MvPolynomial s R) D]
    [Algebra C D] [IsScalarTower (MvPolynomial s R) C D]
    (p : MvPolynomial ℕ+ R) :
    let _ : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
      tailPolynomialOverringAlgebra R s
    let _ : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R D s) :=
      tailPolynomialOverringAlgebra R s
    MvPolynomial.map (algebraMap C D)
        (algebraMap (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) p) =
      algebraMap (MvPolynomial ℕ+ R) (tailPolynomialOverring R D s) p := by
  -- Proof comment: after fixing the two named structure maps, the statement is just functoriality
  -- of `MvPolynomial.map` for the coefficient tower `MvPolynomial s R -> C -> D`.
  dsimp
  letI : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R C s) :=
    tailPolynomialOverringAlgebra R s
  letI : Algebra (MvPolynomial ℕ+ R) (tailPolynomialOverring R D s) :=
    tailPolynomialOverringAlgebra R s
  change
    MvPolynomial.map (algebraMap C D)
        (MvPolynomial.map (algebraMap (MvPolynomial s R) C)
          ((countablePolynomialTailAlgEquiv R s).symm p)) =
      MvPolynomial.map (algebraMap (MvPolynomial s R) D)
        ((countablePolynomialTailAlgEquiv R s).symm p)
  rw [MvPolynomial.map_map]
  have hcomp :
      (algebraMap C D).comp (algebraMap (MvPolynomial s R) C) =
        algebraMap (MvPolynomial s R) D := by
    apply RingHom.ext
    intro x
    exact (IsScalarTower.algebraMap_apply (MvPolynomial s R) C D x).symm
  rw [hcomp]

/-- Helper for Chap10 Example 10 161 2: coefficient extension between fields is injective on
named tail-polynomial overrings. -/
private lemma tailPolynomialOverring_fieldCoeffMap_injective
    {R F E : Type u} [CommRing R] [Field F] [Field E] [Algebra F E]
    (s : Finset ℕ+) :
    Function.Injective
      (MvPolynomial.map (algebraMap F E) :
        tailPolynomialOverring R F s →+* tailPolynomialOverring R E s) := by
  -- Proof comment: constants over a field embed in the target field, and polynomial maps preserve
  -- injectivity of the coefficient map.
  exact MvPolynomial.map_injective (algebraMap F E) (RingHom.injective (algebraMap F E))

/-- Helper for Chap10 Example 10 161 2: the fraction-field map induced by coefficient extension on
the named tail-polynomial overring. -/
private noncomputable def tailFractionRingMap
    {R F E : Type u} [CommRing R] [Field F] [Field E] [Algebra F E]
    (s : Finset ℕ+) :
    FractionRing (tailPolynomialOverring R F s) →+*
      FractionRing (tailPolynomialOverring R E s) :=
  IsFractionRing.map
    (A := tailPolynomialOverring R F s)
    (B := tailPolynomialOverring R E s)
    (K := FractionRing (tailPolynomialOverring R F s))
    (L := FractionRing (tailPolynomialOverring R E s))
    (j := MvPolynomial.map (algebraMap F E))
    (tailPolynomialOverring_fieldCoeffMap_injective (R := R) (F := F) (E := E) s)

/-- Helper for Chap10 Example 10 161 2: the named tail fraction-field map computes on source
tail-polynomial numerators. -/
private lemma tailFractionRingMap_algebraMap_source
    {R F E : Type u} [CommRing R] [Field F] [Field E] [Algebra F E]
    (s : Finset ℕ+) (p : tailPolynomialOverring R F s) :
    tailFractionRingMap (R := R) (F := F) (E := E) s
        (algebraMap (tailPolynomialOverring R F s)
          (FractionRing (tailPolynomialOverring R F s)) p) =
      algebraMap (tailPolynomialOverring R E s)
        (FractionRing (tailPolynomialOverring R E s))
        (MvPolynomial.map (algebraMap F E) p) := by
  -- Proof comment: unfold the localization map only at elements coming from the source overring.
  delta tailFractionRingMap IsFractionRing.map
  simp only [IsLocalization.map_eq]

/-- Helper for Chap10 Example 10 161 2: the named tail fraction-field map sends each
countable-variable polynomial image to the corresponding image after coefficient extension. -/
private lemma tailFractionRingMap_algebraMap_countable
    {R Ks E : Type u} [CommRing R] [IsDomain R] [Field Ks] [Field E]
    (s : Finset ℕ+) [Algebra (MvPolynomial s R) Ks] [Algebra (MvPolynomial s R) E]
    [Algebra Ks E] [IsScalarTower (MvPolynomial s R) Ks E]
    (p : MvPolynomial ℕ+ R) :
    let Sks := tailPolynomialOverring R Ks s
    let Se := tailPolynomialOverring R E s
    let _ : Algebra (MvPolynomial ℕ+ R) Sks := tailPolynomialOverringAlgebra R s
    let _ : Algebra (MvPolynomial ℕ+ R) Se := tailPolynomialOverringAlgebra R s
    let _ : Algebra (MvPolynomial ℕ+ R) (FractionRing Sks) :=
      RingHom.toAlgebra ((algebraMap Sks (FractionRing Sks)).comp
        (algebraMap (MvPolynomial ℕ+ R) Sks))
    let _ : Algebra (MvPolynomial ℕ+ R) (FractionRing Se) :=
      RingHom.toAlgebra ((algebraMap Se (FractionRing Se)).comp
        (algebraMap (MvPolynomial ℕ+ R) Se))
    tailFractionRingMap (R := R) (F := Ks) (E := E) s
        (algebraMap (MvPolynomial ℕ+ R) (FractionRing Sks) p) =
      algebraMap (MvPolynomial ℕ+ R) (FractionRing Se) p := by
  -- Proof comment: compute the localization map on the source tail numerator and then use the
  -- coefficient-functoriality lemma for the countable-variable structure map.
  dsimp
  let Sks := tailPolynomialOverring R Ks s
  let Se := tailPolynomialOverring R E s
  letI : Algebra (MvPolynomial ℕ+ R) Sks := tailPolynomialOverringAlgebra R s
  letI : Algebra (MvPolynomial ℕ+ R) Se := tailPolynomialOverringAlgebra R s
  letI : Algebra (MvPolynomial ℕ+ R) (FractionRing Sks) :=
    RingHom.toAlgebra ((algebraMap Sks (FractionRing Sks)).comp
      (algebraMap (MvPolynomial ℕ+ R) Sks))
  letI : Algebra (MvPolynomial ℕ+ R) (FractionRing Se) :=
    RingHom.toAlgebra ((algebraMap Se (FractionRing Se)).comp
      (algebraMap (MvPolynomial ℕ+ R) Se))
  calc
    tailFractionRingMap (R := R) (F := Ks) (E := E) s
        (algebraMap (MvPolynomial ℕ+ R) (FractionRing Sks) p)
        = algebraMap Se (FractionRing Se)
            (MvPolynomial.map (algebraMap Ks E)
              (algebraMap (MvPolynomial ℕ+ R) Sks p)) := by
          exact tailFractionRingMap_algebraMap_source
            (R := R) (F := Ks) (E := E) s
            (algebraMap (MvPolynomial ℕ+ R) Sks p)
    _ = algebraMap Se (FractionRing Se)
          (algebraMap (MvPolynomial ℕ+ R) Se p) := by
          rw [tailPolynomialOverring_map_algebraMap_countable
            (R := R) (C := Ks) (D := E) s p]
    _ = algebraMap (MvPolynomial ℕ+ R) (FractionRing Se) p := rfl

/-- Helper for Chap10 Example 10 161 2: the explicit tail fraction-field map is compatible with
the coefficient field scalar tower. -/
private lemma tailFractionRingMap_isScalarTower
    {R F E : Type u} [CommRing R] [Field F] [Field E] [Algebra F E]
    (s : Finset ℕ+) :
    let Sf := tailPolynomialOverring R F s
    let Se := tailPolynomialOverring R E s
    let Ktail := FractionRing Sf
    let KE := FractionRing Se
    let _ : Algebra F Ktail :=
      RingHom.toAlgebra ((algebraMap Sf Ktail).comp (algebraMap F Sf))
    let _ : SMul F Ktail := (show Algebra F Ktail from inferInstance).toSMul
    let _ : Algebra E KE :=
      RingHom.toAlgebra ((algebraMap Se KE).comp (algebraMap E Se))
    let _ : Algebra F KE :=
      RingHom.toAlgebra ((algebraMap E KE).comp (algebraMap F E))
    let _ : SMul F KE := (show Algebra F KE from inferInstance).toSMul
    let _ : Algebra Ktail KE := (tailFractionRingMap (R := R) (F := F) (E := E) s).toAlgebra
    let _ : SMul Ktail KE := (show Algebra Ktail KE from inferInstance).toSMul
    IsScalarTower F Ktail KE := by
  -- Proof comment: scalar compatibility is checked on coefficient constants in the tail overring,
  -- where the localization map reduces to `MvPolynomial.map_C`.
  dsimp
  let Sf := tailPolynomialOverring R F s
  let Se := tailPolynomialOverring R E s
  let Ktail := FractionRing Sf
  let KE := FractionRing Se
  letI : Algebra F Ktail :=
    RingHom.toAlgebra ((algebraMap Sf Ktail).comp (algebraMap F Sf))
  letI : SMul F Ktail := (show Algebra F Ktail from inferInstance).toSMul
  letI : Algebra E KE :=
    RingHom.toAlgebra ((algebraMap Se KE).comp (algebraMap E Se))
  letI : Algebra F KE :=
    RingHom.toAlgebra ((algebraMap E KE).comp (algebraMap F E))
  letI : SMul F KE := (show Algebra F KE from inferInstance).toSMul
  letI : Algebra Ktail KE := (tailFractionRingMap (R := R) (F := F) (E := E) s).toAlgebra
  letI : SMul Ktail KE := (show Algebra Ktail KE from inferInstance).toSMul
  refine IsScalarTower.of_algebraMap_eq (R := F) (S := Ktail) (A := KE) ?_
  intro x
  change
    algebraMap E KE (algebraMap F E x) =
      tailFractionRingMap (R := R) (F := F) (E := E) s
        (algebraMap Sf Ktail (algebraMap F Sf x))
  rw [tailFractionRingMap_algebraMap_source]
  change
    algebraMap E KE (algebraMap F E x) =
      algebraMap Se KE
        (MvPolynomial.map (algebraMap F E) (MvPolynomial.C x : Sf))
  rw [MvPolynomial.map_C]
  rfl

/-- Helper for Chap10 Example 10 161 2: the explicit tail fraction-field square is the canonical
pushout square for an algebraic coefficient-field extension. -/
private lemma tailFractionRingMap_isPushout
    {R F E : Type u} [CommRing R] [Field F] [Field E] [Algebra F E]
    [Algebra.IsAlgebraic F E] (s : Finset ℕ+) :
    let Sf := tailPolynomialOverring R F s
    let Se := tailPolynomialOverring R E s
    let Ktail := FractionRing Sf
    let KE := FractionRing Se
    let _ : Algebra F Ktail :=
      RingHom.toAlgebra ((algebraMap Sf Ktail).comp (algebraMap F Sf))
    let _ : SMul F Ktail := (show Algebra F Ktail from inferInstance).toSMul
    let _ : Algebra E KE :=
      RingHom.toAlgebra ((algebraMap Se KE).comp (algebraMap E Se))
    let _ : SMul F E := (show Algebra F E from inferInstance).toSMul
    let _ : SMul E KE := (show Algebra E KE from inferInstance).toSMul
    let _ : Algebra F KE :=
      RingHom.toAlgebra ((algebraMap E KE).comp (algebraMap F E))
    let _ : SMul F KE := (show Algebra F KE from inferInstance).toSMul
    let _ : Algebra Ktail KE := (tailFractionRingMap (R := R) (F := F) (E := E) s).toAlgebra
    let _ : SMul Ktail KE := (show Algebra Ktail KE from inferInstance).toSMul
    let _ : Module Ktail KE := Algebra.toModule
    let _ : IsScalarTower F Ktail KE := tailFractionRingMap_isScalarTower (R := R) (F := F) (E := E) s
    let _ : IsScalarTower F E KE := IsScalarTower.of_algebraMap_eq' rfl
    Algebra.IsPushout F Ktail E KE := by
  -- Proof comment: after fixing the explicit fraction-field map, use mathlib's fraction-field
  -- pushout instance for algebraic extensions of polynomial rings.
  dsimp
  let Sf := tailPolynomialOverring R F s
  let Se := tailPolynomialOverring R E s
  let Ktail := FractionRing Sf
  let KE := FractionRing Se
  letI : Algebra F Ktail :=
    RingHom.toAlgebra ((algebraMap Sf Ktail).comp (algebraMap F Sf))
  letI : SMul F Ktail := (show Algebra F Ktail from inferInstance).toSMul
  letI : Algebra E KE :=
    RingHom.toAlgebra ((algebraMap Se KE).comp (algebraMap E Se))
  letI : SMul E KE := (show Algebra E KE from inferInstance).toSMul
  letI : IsScalarTower E Se KE := IsScalarTower.of_algebraMap_eq' rfl
  letI : SMul F E := (show Algebra F E from inferInstance).toSMul
  letI : Algebra F KE :=
    RingHom.toAlgebra ((algebraMap E KE).comp (algebraMap F E))
  letI : SMul F KE := (show Algebra F KE from inferInstance).toSMul
  letI : Algebra Ktail KE := (tailFractionRingMap (R := R) (F := F) (E := E) s).toAlgebra
  letI : SMul Ktail KE := (show Algebra Ktail KE from inferInstance).toSMul
  letI : Module Ktail KE := Algebra.toModule
  letI : IsScalarTower F Ktail KE :=
    tailFractionRingMap_isScalarTower (R := R) (F := F) (E := E) s
  letI : IsScalarTower F E KE := IsScalarTower.of_algebraMap_eq' rfl
  let coeffMap : Sf →+* Se := MvPolynomial.map (algebraMap F E)
  letI : Algebra Sf Se := MvPolynomial.algebraMvPolynomial
  letI : SMul Sf Se := (show Algebra Sf Se from inferInstance).toSMul
  letI : IsScalarTower F Sf Se := by
    refine IsScalarTower.of_algebraMap_eq (R := F) (S := Sf) (A := Se) ?_
    intro x
    change
      MvPolynomial.C (algebraMap F E x) =
        MvPolynomial.map (algebraMap F E) (MvPolynomial.C x : Sf)
    rw [MvPolynomial.map_C]
  letI : IsScalarTower F Sf Ktail := IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra Sf KE := RingHom.toAlgebra ((algebraMap Se KE).comp coeffMap)
  letI : SMul Sf KE := (show Algebra Sf KE from inferInstance).toSMul
  letI : IsScalarTower Sf Se KE := IsScalarTower.of_algebraMap_eq' rfl
  letI : IsScalarTower F E Se := IsScalarTower.of_algebraMap_eq' rfl
  letI : IsScalarTower F Se KE := by
    refine IsScalarTower.of_algebraMap_eq (R := F) (S := Se) (A := KE) ?_
    intro x
    rfl
  letI : IsScalarTower Sf Ktail KE := by
    refine IsScalarTower.of_algebraMap_eq (R := Sf) (S := Ktail) (A := KE) ?_
    intro x
    change algebraMap Se KE (coeffMap x) =
      tailFractionRingMap (R := R) (F := F) (E := E) s (algebraMap Sf Ktail x)
    rw [tailFractionRingMap_algebraMap_source]
  letI : Algebra.IsPushout F Sf E Se := MvPolynomial.instIsPushout_1
  have hright : Algebra.IsPushout Sf Ktail Se KE := by
    -- Proof comment: cache algebraicity and faithfulness for the coefficient-polynomial map so
    -- the fraction-field pushout instance does not search through the whole tower.
    letI : Algebra.IsAlgebraic Sf Se := inferInstance
    letI : FaithfulSMul Sf Se := inferInstance
    exact Algebra.IsAlgebraic.instIsPushout Sf Se Ktail KE
  exact (Algebra.IsPushout.comp_iff (R := F) (S := Sf) (T := Ktail)
    (R' := E) (S' := Se) (T' := KE)).mpr hright

/-- Helper for Chap10 Example 10 161 2: the pushout equivalence from the explicit tail fraction
field to the target field is compatible with the countable-variable polynomial structure map. -/
private lemma tailFractionPushoutEquiv_algebraMap_countable
    {R Ks E L : Type u} [CommRing R] [IsDomain R] [Field Ks] [Field E] [Field L]
    (s : Finset ℕ+) [Algebra (MvPolynomial s R) Ks] [IsFractionRing (MvPolynomial s R) Ks]
    [Algebra (MvPolynomial s R) E] [Algebra Ks E]
    [IsScalarTower (MvPolynomial s R) Ks E] [Algebra.IsAlgebraic Ks E]
    [Algebra (FractionRing (MvPolynomial ℕ+ R)) L]
    [Algebra (MvPolynomial ℕ+ R) L]
    [IsScalarTower (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R)) L]
    (tensorEquiv :
      let Kinf := FractionRing (MvPolynomial ℕ+ R)
      let _ : Algebra Ks Kinf :=
        RingHom.toAlgebra
          ((finiteVariableFractionRingMap (R := R) s).comp
            (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
      TensorProduct Ks Kinf E ≃ₐ[Kinf] L)
    (p : MvPolynomial ℕ+ R) :
    let Ainf := MvPolynomial ℕ+ R
    let Kinf := FractionRing Ainf
    let Sks := tailPolynomialOverring R Ks s
    let Se := tailPolynomialOverring R E s
    let Ktail := FractionRing Sks
    let KE := FractionRing Se
    let _ : Algebra Ks Kinf :=
      RingHom.toAlgebra
        ((finiteVariableFractionRingMap (R := R) s).comp
          (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
    let _ : Algebra (MvPolynomial ℕ+ R) Se := tailPolynomialOverringAlgebra R s
    let _ : Algebra (MvPolynomial ℕ+ R) KE :=
      RingHom.toAlgebra ((algebraMap Se KE).comp (algebraMap (MvPolynomial ℕ+ R) Se))
    let _ : Algebra Ks Ktail :=
      RingHom.toAlgebra ((algebraMap Sks Ktail).comp (algebraMap Ks Sks))
    let _ : SMul Ks Ktail := (show Algebra Ks Ktail from inferInstance).toSMul
    let _ : Algebra E KE :=
      RingHom.toAlgebra ((algebraMap Se KE).comp (algebraMap E Se))
    let _ : SMul Ks E := (show Algebra Ks E from inferInstance).toSMul
    let _ : SMul E KE := (show Algebra E KE from inferInstance).toSMul
    let _ : Algebra Ks KE :=
      RingHom.toAlgebra ((algebraMap E KE).comp (algebraMap Ks E))
    let _ : SMul Ks KE := (show Algebra Ks KE from inferInstance).toSMul
    let _ : Algebra Ktail KE :=
      (tailFractionRingMap (R := R) (F := Ks) (E := E) s).toAlgebra
    let _ : SMul Ktail KE := (show Algebra Ktail KE from inferInstance).toSMul
    let _ : Module Ktail KE := Algebra.toModule
    let _ : IsScalarTower Ks Ktail KE := tailFractionRingMap_isScalarTower (R := R) (F := Ks) (E := E) s
    let _ : IsScalarTower Ks E KE := IsScalarTower.of_algebraMap_eq' rfl
    let _ : Algebra.IsPushout Ks Ktail E KE :=
      tailFractionRingMap_isPushout (R := R) (F := Ks) (E := E) s
    pushoutRingEquivOfTensorBaseChange (baseTailFractionRingAlgEquiv (R := R) (Ks := Ks) s)
        tensorEquiv (algebraMap Ainf KE p) =
      algebraMap Ainf L p := by
  -- Proof comment: first rewrite the `Ainf -> KE` map through the explicit left pushout leg, then
  -- use the base-tail fraction-field computation and finally the `Kinf`-linearity of `tensorEquiv`.
  dsimp
  let Ainf := MvPolynomial ℕ+ R
  let Kinf := FractionRing Ainf
  let Sks := tailPolynomialOverring R Ks s
  let Se := tailPolynomialOverring R E s
  let Ktail := FractionRing Sks
  let KE := FractionRing Se
  letI : Algebra Ks Kinf :=
    RingHom.toAlgebra
      ((finiteVariableFractionRingMap (R := R) s).comp
        (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
  letI : Algebra Ainf Sks := tailPolynomialOverringAlgebra R s
  letI : Algebra Ainf Se := tailPolynomialOverringAlgebra R s
  letI : Algebra Ainf Ktail :=
    RingHom.toAlgebra ((algebraMap Sks Ktail).comp (algebraMap Ainf Sks))
  letI : Algebra Ainf KE :=
    RingHom.toAlgebra ((algebraMap Se KE).comp (algebraMap Ainf Se))
  letI : Algebra Ks Ktail :=
    RingHom.toAlgebra ((algebraMap Sks Ktail).comp (algebraMap Ks Sks))
  letI : SMul Ks Ktail := (show Algebra Ks Ktail from inferInstance).toSMul
  letI : Algebra E KE :=
    RingHom.toAlgebra ((algebraMap Se KE).comp (algebraMap E Se))
  letI : SMul Ks E := (show Algebra Ks E from inferInstance).toSMul
  letI : SMul E KE := (show Algebra E KE from inferInstance).toSMul
  letI : Algebra Ks KE :=
    RingHom.toAlgebra ((algebraMap E KE).comp (algebraMap Ks E))
  letI : SMul Ks KE := (show Algebra Ks KE from inferInstance).toSMul
  letI : Algebra Ktail KE := (tailFractionRingMap (R := R) (F := Ks) (E := E) s).toAlgebra
  letI : SMul Ktail KE := (show Algebra Ktail KE from inferInstance).toSMul
  letI : Module Ktail KE := Algebra.toModule
  letI : IsScalarTower Ks Ktail KE :=
    tailFractionRingMap_isScalarTower (R := R) (F := Ks) (E := E) s
  letI : IsScalarTower Ks E KE := IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra.IsPushout Ks Ktail E KE :=
    tailFractionRingMap_isPushout (R := R) (F := Ks) (E := E) s
  calc
    pushoutRingEquivOfTensorBaseChange (baseTailFractionRingAlgEquiv (R := R) (Ks := Ks) s)
        tensorEquiv (algebraMap Ainf KE p)
        =
      pushoutRingEquivOfTensorBaseChange (baseTailFractionRingAlgEquiv (R := R) (Ks := Ks) s)
        tensorEquiv (algebraMap Ktail KE (algebraMap Ainf Ktail p)) := by
          rw [← tailFractionRingMap_algebraMap_countable (R := R) (Ks := Ks) (E := E) s p]
          rfl
    _ = tensorEquiv
          ((baseTailFractionRingAlgEquiv (R := R) (Ks := Ks) s)
              (algebraMap Ainf Ktail p) ⊗ₜ[Ks] (1 : E)) := by
          rw [pushoutRingEquivOfTensorBaseChange_algebraMap_left]
    _ = tensorEquiv ((algebraMap Ainf Kinf p) ⊗ₜ[Ks] (1 : E)) := by
          have hbase :
              (baseTailFractionRingAlgEquiv (R := R) (Ks := Ks) s)
                  (algebraMap Ainf Ktail p) =
                algebraMap Ainf Kinf p := by
            exact baseTailFractionRingEquiv_algebraMap_countable (R := R) (Ks := Ks) s p
          rw [hbase]
    _ = algebraMap Ainf L p := by
          calc
            tensorEquiv ((algebraMap Ainf Kinf p) ⊗ₜ[Ks] (1 : E)) =
                tensorEquiv
                  (algebraMap Kinf (TensorProduct Ks Kinf E) (algebraMap Ainf Kinf p)) := by
              rfl
            _ = algebraMap Kinf L (algebraMap Ainf Kinf p) := by
              exact tensorEquiv.commutes (algebraMap Ainf Kinf p)
            _ = algebraMap Ainf L p := by
              rw [IsScalarTower.algebraMap_apply Ainf Kinf L]

/-- Helper for Chap10 Example 10 161 2: a finite normal supported tail overring gives finite
normalization over the countable-variable polynomial ring. -/
private lemma moduleFinite_integralClosure_of_supportedTailOverring
    {R Ks E C0 L : Type u} [CommRing R] [IsDomain R] [Field Ks] [Field E]
    [CommRing C0] [IsDomain C0] [Field L] (s : Finset ℕ+)
    [Algebra (MvPolynomial s R) Ks] [IsFractionRing (MvPolynomial s R) Ks]
    [Algebra (MvPolynomial s R) E] [Algebra Ks E]
    [IsScalarTower (MvPolynomial s R) Ks E] [Algebra.IsAlgebraic Ks E]
    [Algebra (MvPolynomial s R) C0] [Module.Finite (MvPolynomial s R) C0]
    (hC0inj : Function.Injective (algebraMap (MvPolynomial s R) C0))
    [Algebra C0 E] [IsScalarTower (MvPolynomial s R) C0 E] [IsFractionRing C0 E]
    [IsIntegrallyClosed (tailPolynomialOverring R C0 s)]
    [Algebra (FractionRing (MvPolynomial ℕ+ R)) L] [Algebra (MvPolynomial ℕ+ R) L]
    [IsScalarTower (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R)) L]
    (tensorEquiv :
      let Kinf := FractionRing (MvPolynomial ℕ+ R)
      let _ : Algebra Ks Kinf :=
        RingHom.toAlgebra
          ((finiteVariableFractionRingMap (R := R) s).comp
            (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
      TensorProduct Ks Kinf E ≃ₐ[Kinf] L) :
    Module.Finite (MvPolynomial ℕ+ R) (integralClosure (MvPolynomial ℕ+ R) L) := by
  -- Proof comment: package the finite `C0[tail]` overring, compare its fraction field to `L`, and
  -- invoke the finite-normal-overring transport lemma.
  let Ainf := MvPolynomial ℕ+ R
  let S := tailPolynomialOverring R C0 s
  let SE := tailPolynomialOverring R E s
  let KE := FractionRing SE
  letI : Algebra Ainf S := tailPolynomialOverringAlgebra R s
  letI : SMul Ainf S := (show Algebra Ainf S from inferInstance).toSMul
  letI : Module Ainf S := Algebra.toModule
  letI : Module.Finite Ainf S :=
    tailPolynomialOverring_finite (R := R) (C := C0) s hC0inj
  let coeffMapC0E : S →+* SE := MvPolynomial.map (algebraMap C0 E)
  letI : Algebra S SE := coeffMapC0E.toAlgebra
  letI : Algebra S KE :=
    RingHom.toAlgebra ((algebraMap SE KE).comp coeffMapC0E)
  letI : SMul S KE := (show Algebra S KE from inferInstance).toSMul
  letI : IsFractionRing S KE :=
    tailPolynomialOverring_fractionRing_of_coefficients (R := R) (C := C0) (E := E) s
  letI : Algebra Ainf SE := tailPolynomialOverringAlgebra R s
  letI : Algebra Ainf KE :=
    RingHom.toAlgebra ((algebraMap SE KE).comp (algebraMap Ainf SE))
  letI : SMul Ainf KE := (show Algebra Ainf KE from inferInstance).toSMul
  letI : IsScalarTower Ainf S KE := by
    refine IsScalarTower.of_algebraMap_eq (R := Ainf) (S := S) (A := KE) ?_
    intro p
    change algebraMap SE KE (algebraMap Ainf SE p) =
      algebraMap S KE (algebraMap Ainf S p)
    change algebraMap SE KE (algebraMap Ainf SE p) =
      algebraMap SE KE (MvPolynomial.map (algebraMap C0 E) (algebraMap Ainf S p))
    rw [tailPolynomialOverring_map_algebraMap_countable (R := R) (C := C0) (D := E) s p]
  let Kinf := FractionRing Ainf
  letI : Algebra Ks Kinf :=
    RingHom.toAlgebra
      ((finiteVariableFractionRingMap (R := R) s).comp
        (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
  let Sks := tailPolynomialOverring R Ks s
  let Ktail := FractionRing Sks
  letI : Algebra Ainf Sks := tailPolynomialOverringAlgebra R s
  letI : Algebra Ainf Ktail :=
    RingHom.toAlgebra ((algebraMap Sks Ktail).comp (algebraMap Ainf Sks))
  letI : Algebra Ks Ktail :=
    RingHom.toAlgebra ((algebraMap Sks Ktail).comp (algebraMap Ks Sks))
  letI : SMul Ks Ktail := (show Algebra Ks Ktail from inferInstance).toSMul
  letI : Algebra E KE :=
    RingHom.toAlgebra ((algebraMap SE KE).comp (algebraMap E SE))
  letI : SMul Ks E := (show Algebra Ks E from inferInstance).toSMul
  letI : SMul E KE := (show Algebra E KE from inferInstance).toSMul
  letI : Algebra Ks KE :=
    RingHom.toAlgebra ((algebraMap E KE).comp (algebraMap Ks E))
  letI : SMul Ks KE := (show Algebra Ks KE from inferInstance).toSMul
  letI : Algebra Ktail KE := (tailFractionRingMap (R := R) (F := Ks) (E := E) s).toAlgebra
  letI : SMul Ktail KE := (show Algebra Ktail KE from inferInstance).toSMul
  letI : Module Ktail KE := Algebra.toModule
  letI : IsScalarTower Ks Ktail KE :=
    tailFractionRingMap_isScalarTower (R := R) (F := Ks) (E := E) s
  letI : IsScalarTower Ks E KE := IsScalarTower.of_algebraMap_eq' rfl
  letI : Algebra.IsPushout Ks Ktail E KE :=
    tailFractionRingMap_isPushout (R := R) (F := Ks) (E := E) s
  let e : KE ≃+* L :=
    pushoutRingEquivOfTensorBaseChange (baseTailFractionRingAlgEquiv (R := R) (Ks := Ks) s)
      tensorEquiv
  have he : ∀ p : Ainf, e (algebraMap Ainf KE p) = algebraMap Ainf L p := by
    intro p
    simpa [e] using
      tailFractionPushoutEquiv_algebraMap_countable (R := R) (Ks := Ks) (E := E)
        (L := L) s tensorEquiv p
  exact moduleFinite_integralClosure_of_finite_normal_fractionRing_ringEquiv
    (A := Ainf) (S := S) (K := KE) (L := L) e he

/-- Helper for Chap10 Example 10 161 2: a finite supported tensor model gives finite
normalization over the countable-variable polynomial ring. -/
private lemma moduleFinite_integralClosure_of_supportedTensorModel
    {R Ks E L : Type u} [CommRing R] [IsDomain R] [Field Ks] [Field E] [Field L]
    (hfinite : ∀ n : ℕ, IsN2Ring (MvPolynomial (Fin n) R)) (s : Finset ℕ+)
    [Algebra (MvPolynomial s R) Ks] [IsFractionRing (MvPolynomial s R) Ks]
    [Algebra (MvPolynomial s R) E] [Algebra Ks E]
    [IsScalarTower (MvPolynomial s R) Ks E] [FiniteDimensional Ks E]
    [Algebra (FractionRing (MvPolynomial s R)) E]
    [IsScalarTower (MvPolynomial s R) (FractionRing (MvPolynomial s R)) E]
    [FiniteDimensional (FractionRing (MvPolynomial s R)) E]
    [Algebra (FractionRing (MvPolynomial ℕ+ R)) L] [Algebra (MvPolynomial ℕ+ R) L]
    [IsScalarTower (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R)) L]
    (tensorEquiv :
      let Kinf := FractionRing (MvPolynomial ℕ+ R)
      let _ : Algebra Ks Kinf :=
        RingHom.toAlgebra
          ((finiteVariableFractionRingMap (R := R) s).comp
            (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
      TensorProduct Ks Kinf E ≃ₐ[Kinf] L) :
    Module.Finite (MvPolynomial ℕ+ R) (integralClosure (MvPolynomial ℕ+ R) L) := by
  -- Proof comment: normalize the finite-stage coefficient extension and hand the resulting normal
  -- finite tail overring to the closing helper.
  let As := MvPolynomial s R
  have hEIntegralClosureFinite :
      Module.Finite As (integralClosure As E) := by
    exact finiteVariableSubtype_integralClosure_finite (R := R) hfinite s E
  let C0 := integralClosure As E
  have hAsC0inj : Function.Injective (algebraMap As C0) := by
    exact integralClosure_algebraMap_injective_fractionField (A := As) (K := Ks) (L := E)
  have hC0normal : IsIntegrallyClosed C0 := by
    exact integralClosure.isIntegrallyClosedOfFiniteExtension (R := As) Ks
  have hTailNormal : IsIntegrallyClosed (tailPolynomialOverring R C0 s) := by
    exact tailPolynomialOverring_integrallyClosed R s
  letI : Module.Finite As C0 := hEIntegralClosureFinite
  letI : IsFractionRing C0 E :=
    integralClosure.isFractionRing_of_finite_extension (A := As) (K := Ks) (L := E)
  letI : IsIntegrallyClosed (tailPolynomialOverring R C0 s) := hTailNormal
  exact moduleFinite_integralClosure_of_supportedTailOverring
    (R := R) (Ks := Ks) (E := E) (C0 := C0) (L := L) s hAsC0inj tensorEquiv

/-- Helper for Chap10 Example 10 161 2: supported structure constants for a finite extension
descend the normalization problem to a finite-stage tail overring. -/
private lemma moduleFinite_integralClosure_of_supportedStructureConstantFunctions
    {R : Type u} [CommRing R] [IsDomain R]
    (hfinite : ∀ n : ℕ, IsN2Ring (MvPolynomial (Fin n) R))
    {L : Type u} [Field L] [Algebra (MvPolynomial ℕ+ R) L]
    [Algebra (FractionRing (MvPolynomial ℕ+ R)) L]
    [IsScalarTower (MvPolynomial ℕ+ R) (FractionRing (MvPolynomial ℕ+ R)) L]
    [FiniteDimensional (FractionRing (MvPolynomial ℕ+ R)) L]
    (s : Finset ℕ+) (n : ℕ)
    (b : Module.Basis (Fin n) (FractionRing (MvPolynomial ℕ+ R)) L)
    (oneCoeff : Fin n → FractionRing (MvPolynomial s R))
    (mulCoeff : Fin n → Fin n → Fin n → FractionRing (MvPolynomial s R))
    (hOneCoeff : ∀ k : Fin n, finiteVariableFractionRingMap (R := R) s (oneCoeff k) =
      b.repr (1 : L) k)
    (hMulCoeff : ∀ i j k : Fin n, finiteVariableFractionRingMap (R := R) s
      (mulCoeff i j k) = b.repr (b i * b j) k) :
    Module.Finite (MvPolynomial ℕ+ R) (integralClosure (MvPolynomial ℕ+ R) L) := by
  -- Proof comment: construct the finite intermediate field generated by the supported basis data,
  -- normalize at the finite stage, then invoke the tail-overring closing helper.
  let Ks := FractionRing (MvPolynomial s R)
  let Kinf := FractionRing (MvPolynomial ℕ+ R)
  letI : IsN2Ring (MvPolynomial s R) := finiteVariableSubtype_isN2Ring hfinite s
  letI : Algebra Ks Kinf :=
    RingHom.toAlgebra
      ((finiteVariableFractionRingMap (R := R) s).comp
        (FractionRing.algEquiv (MvPolynomial s R) Ks).symm.toRingHom)
  letI : SMul Ks Kinf := (show Algebra Ks Kinf from inferInstance).toSMul
  letI : Algebra Ks L :=
    RingHom.toAlgebra ((algebraMap Kinf L).comp (algebraMap Ks Kinf))
  letI : SMul Ks L := (show Algebra Ks L from inferInstance).toSMul
  letI : IsScalarTower Ks Kinf L := IsScalarTower.of_algebraMap_eq' rfl
  have hKsToKinf :
      algebraMap Ks Kinf = finiteVariableFractionRingMap (R := R) s := by
    -- Proof comment: in this specialized helper, `Ks` is the canonical fraction field itself;
    -- the extra `FractionRing.algEquiv` in the generic tail API is therefore the identity map.
    apply RingHom.ext
    intro x
    change finiteVariableFractionRingMap (R := R) s
        ((FractionRing.algEquiv (MvPolynomial s R) Ks).symm x) =
      finiteVariableFractionRingMap (R := R) s x
    have hself : (FractionRing.algEquiv (MvPolynomial s R) Ks).symm x = x := by
      dsimp [Ks]
      have hmaps :
          (FractionRing.algEquiv (MvPolynomial s R) (FractionRing (MvPolynomial s R))).symm.toRingHom =
            RingHom.id (FractionRing (MvPolynomial s R)) := by
        apply IsFractionRing.ringHom_ext (A := MvPolynomial s R)
        intro a
        exact
          (FractionRing.algEquiv (MvPolynomial s R) (FractionRing (MvPolynomial s R))).symm.commutes a
      exact congrArg
        (fun f : FractionRing (MvPolynomial s R) →+* FractionRing (MvPolynomial s R) => f x)
        hmaps
    rw [hself]
  obtain ⟨E, hbE, hEfinite, hEcarrier⟩ :
      ∃ E : IntermediateField Ks L,
        (∀ i : Fin n, b i ∈ E) ∧ FiniteDimensional Ks E ∧
          (∀ x : L, x ∈ E ↔ x ∈ Submodule.span Ks (Set.range fun i : Fin n ↦ b i)) := by
    -- Proof comment: supported coordinates make the `Ks`-span of the chosen `Kinf`-basis a field.
    refine existsIntermediateFieldOfSupportedStructureConstants
      (K := Ks) (F := Kinf) (L := L) b oneCoeff mulCoeff ?_ ?_
    · intro k
      rw [hKsToKinf]
      exact hOneCoeff k
    · intro i j k
      rw [hKsToKinf]
      exact hMulCoeff i j k
  let As := MvPolynomial s R
  letI : FiniteDimensional Ks E := hEfinite
  letI : Algebra As E :=
    (RingHom.comp (algebraMap Ks E) (algebraMap As Ks)).toAlgebra
  letI : SMul As E := (show Algebra As E from inferInstance).toSMul
  letI : IsScalarTower As Ks E := IsScalarTower.of_algebraMap_eq' rfl
  obtain ⟨bE, hbE_basis⟩ := supportedSpanBasis
    (K := Ks) (F := Kinf) (L := L) b E hbE hEcarrier
  obtain ⟨tensorEquiv, _⟩ := supportedSpanBaseChangeAlgEquiv
    (K := Ks) (F := Kinf) (L := L) E b bE hbE_basis
  exact moduleFinite_integralClosure_of_supportedTensorModel
    (R := R) (Ks := Ks) (E := E) (L := L) hfinite s tensorEquiv

-- Proof sketch: let `L / FractionRing (MvPolynomial ℕ+ R)` be a finite extension. Any finite set
-- of coefficients and structural constants arising from `L` and from generators of the relevant
-- integral closure involves only finitely many variables, so everything descends to some
-- finite-variable subring `MvPolynomial (Fin n) R`. Applying the supplied finite-variable `N-2`
-- hypothesis there and then extending scalars back to countably many variables gives the desired
-- finiteness.
/-- Chap10 Example 10 161 2: countably many variables inherit `N-2` from all
finite-variable polynomial stages. -/
private theorem countableVariableMvPolynomial_isN2Ring_of_finiteVariable
    {R : Type u} [CommRing R] [IsDomain R]
    (hfinite : ∀ n : ℕ, IsN2Ring (MvPolynomial (Fin n) R)) :
    IsN2Ring (MvPolynomial ℕ+ R) := by
  -- Route correction: the previous monolithic descent is too coarse; the verified finite-support
  -- polynomial lifting above is now extended to structure constants. The remaining step is to
  -- build the finite-stage field from those constants and compare the tail-variable normalization.
  classical
  refine IsN2Ring.mk ?_
  intro L _ _ _ _ _
  obtain ⟨s, n, b, oneCoeff, mulCoeff, hOneCoeff, hMulCoeff⟩ :=
    finiteExtension_supportedStructureConstantFunctions (R := R) L
  -- Proof comment: all remaining finite-stage and tail-overring assembly is handled in a separate
  -- declaration to keep this public proof at the source-proof skeleton level.
  exact moduleFinite_integralClosure_of_supportedStructureConstantFunctions
    (R := R) hfinite s n b oneCoeff mulCoeff hOneCoeff hMulCoeff

section

variable {R : Type u} [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsN2Ring R]

local notation "R∞" => MvPolynomial ℕ+ R

-- Proof sketch: induct on the number of variables using the canonical equivalence between
-- `MvPolynomial (Fin (n + 1)) R` and `Polynomial (MvPolynomial (Fin n) R)`, and apply the owner
-- theorem `isN2Ring_polynomial` at each step.
private theorem finiteVariableMvPolynomial_isN2Ring (n : ℕ) :
    IsN2Ring (MvPolynomial (Fin n) R) := by
  -- Proof comment: build finite-variable polynomial rings by repeatedly adjoining one variable.
  induction n with
  | zero =>
      -- Proof comment: the zero-variable polynomial ring is equivalent to the coefficient ring.
      exact isN2Ring_of_ringEquiv (MvPolynomial.isEmptyRingEquiv R (Fin 0)).symm
  | succ n hn =>
      -- Proof comment: the successor step is the one-variable polynomial permanence theorem,
      -- transported back along the standard successor-variable equivalence.
      letI : IsN2Ring (MvPolynomial (Fin n) R) := hn
      letI : IsN2Ring (Polynomial (MvPolynomial (Fin n) R)) :=
        isN2Ring_polynomial (MvPolynomial (Fin n) R)
      exact isN2Ring_of_ringEquiv (MvPolynomial.finSuccEquiv R n).symm.toRingEquiv

private theorem countableVariableMvPolynomial_isN2Ring_and_not_isNoetherian :
    IsN2Ring R∞ ∧ ¬ IsNoetherianRing R∞ := by
  exact ⟨countableVariableMvPolynomial_isN2Ring_of_finiteVariable
      finiteVariableMvPolynomial_isN2Ring,
    mvPolynomial_not_isNoetherianRing_of_infinite ℕ+ R⟩

end

section

variable (k : Type u) [Field k]

local notation "Rinf" => MvPolynomial ℕ+ k

-- Proof sketch: write any finite extension of `FractionRing Rinf` over a finitely generated
-- subfield `L₀ / k(x₁, …, xₙ)`, use the finite-variable case for the integral closure over
-- `k[x₁, …, xₙ]`, and then adjoin the remaining transcendental variables. For non-Noetherianity,
-- use the generic infinite-variable lemma based on the owner ideal `MvPolynomial.idealOfVars`.
/-- Field specialization for Chap10 Example 10 161 2: for a field `k`, the polynomial ring
`k[x₁, x₂, x₃, \ldots]`, modeled as `MvPolynomial ℕ+ k`, is `N-2` and is not
Noetherian. -/
@[stacks 0350]
theorem countableVariablePolynomialRing_isN2Ring_and_not_isNoetherian :
    IsN2Ring Rinf ∧ ¬ IsNoetherianRing Rinf := by
  exact countableVariableMvPolynomial_isN2Ring_and_not_isNoetherian

end

section

/-- Helper for Chap10 Example 10 161 2: a Noetherian integrally closed domain whose fraction
field has characteristic zero is `N-2`. -/
private theorem isN2Ring_of_isIntegrallyClosed_noetherian_fractionRing_charZero
    (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A]
    [CharZero (FractionRing A)] :
    IsN2Ring A := by
  -- Proof comment: characteristic zero makes finite fraction-field extensions separable, so
  -- mathlib's finite integral-closure theorem applies directly to the defining `N-2` field.
  refine IsN2Ring.mk ?_
  intro L _ _ _ _ _
  letI : PerfectField (FractionRing A) := PerfectField.ofCharZero
  letI : Algebra.IsSeparable (FractionRing A) L :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  letI : Algebra A (integralClosure A L) :=
    SubalgebraClass.toAlgebra (s := integralClosure A L)
  letI : SMul A (integralClosure A L) :=
    (show Algebra A (integralClosure A L) from inferInstance).toSMul
  have hScalarTower : IsScalarTower A (integralClosure A L) L := by
    refine IsScalarTower.of_algebraMap_eq ?_
    intro x
    rfl
  letI : IsScalarTower A (integralClosure A L) L := hScalarTower
  exact IsIntegralClosure.finite A (FractionRing A) L (integralClosure A L)

local notation "Zinf" => MvPolynomial ℕ+ ℤ

-- Proof sketch: repeat the argument of the field case, using the finite-variable Nagata property
-- for `ℤ[x₁, …, xₙ]` in place of the field case. For non-Noetherianity, reuse the generic
-- infinite-variable lemma coming from `MvPolynomial.idealOfVars`.
/-- The same countable-variable polynomial-ring example over `ℤ` is `N-2` and not Noetherian. -/
theorem countableVariableIntegerPolynomialRing_isN2Ring_and_not_isNoetherian :
    IsN2Ring Zinf ∧ ¬ IsNoetherianRing Zinf := by
  haveI : IsN2Ring ℤ := by
    -- Proof comment: `ℤ` is Noetherian, normal, and has characteristic-zero fraction field, so it
    -- satisfies the characteristic-zero `N-2` criterion above.
    exact isN2Ring_of_isIntegrallyClosed_noetherian_fractionRing_charZero ℤ
  exact countableVariableMvPolynomial_isN2Ring_and_not_isNoetherian

end
