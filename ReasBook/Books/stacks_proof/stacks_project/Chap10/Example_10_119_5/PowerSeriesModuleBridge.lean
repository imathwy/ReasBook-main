    (hquot : Module.Finite ↥A
      (QuotSMulTop (finitePthPowerCoefficientSubring_uniformizer k p) (PowerSeries k))) :
    ∃ (n : ℕ) (t : Fin n → PowerSeries k), ∀ f : PowerSeries k,
