coefficient DVR. -/
lemma finitePthPowerCoefficientSubring_algebra_isIntegral :
    Algebra.IsIntegral ↥A (PowerSeries k) := by
  -- Package the pointwise `p`th-power integrality criterion as algebra integrality.
  exact ⟨finitePthPowerCoefficientAdjoinSubring_isIntegral k p⟩

/-- Helper for Chap10 Example 10 119 5: the coefficient DVR uniformizer viewed as an element
of the coefficient subring. -/
abbrev finitePthPowerCoefficientSubring_uniformizer : ↥A :=
  ⟨PowerSeries.X, X_mem_finitePthPowerCoefficientSubring k p⟩

