/-- Helper for Chap10 Example 10 119 5: the ambient power-series module is separated for the
coefficient DVR uniformizer filtration. -/
lemma powerSeries_uniformizer_adicSeparated :
    ∀ f : PowerSeries k,
      (∀ n : ℕ,
        f ∈
          (finitePthPowerCoefficientSubring_uniformizer k p) ^ n •
            (⊤ : Submodule ↥A (PowerSeries k))) →
        f = 0 := by
  intro f hf
  -- A coefficient in degree `m` vanishes because membership at level `m + 1` makes the series
  -- divisible by `X^(m+1)`.
  ext m
  have hmem :=
    hf (m + 1)
  rcases hmem with ⟨g, _hg, hg⟩
  have hdiv : (PowerSeries.X : PowerSeries k) ^ (m + 1) ∣ f := by
    refine ⟨g, ?_⟩
    simpa [Algebra.smul_def, finitePthPowerCoefficientSubring_uniformizer,
      finitePthPowerCoefficientSubring_uniformizer_pow_coe] using hg.symm
  exact (PowerSeries.X_pow_dvd_iff (R := k) (n := m + 1) (φ := f)).1 hdiv m
    (Nat.lt_succ_self m)

