/-- Helper for Chap10 Example 10 119 5: the two natural maps
`A → Frac(A) → Frac(k[[X]])` and `A → k[[X]] → Frac(k[[X]])` agree. -/
lemma fractionRingPowerSeries_algebraMap_algebraMap (a : ↥A) :
    algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k))
        (algebraMap ↥A (FractionRing ↥A) a) =
      algebraMap ↥A (FractionRing (PowerSeries k)) a := by
  -- The fraction-ring algebra map is the localization map induced by the inclusion `A ↪ k[[X]]`.
  let hA : Function.Injective (algebraMap ↥A (PowerSeries k)) := fun _ _ h ↦ Subtype.ext h
  change IsFractionRing.map hA (algebraMap ↥A (FractionRing ↥A) a) =
    algebraMap (PowerSeries k) (FractionRing (PowerSeries k))
      (algebraMap ↥A (PowerSeries k) a)
  exact
    (IsLocalization.map_eq
      (M := nonZeroDivisors ↥A)
      (S := FractionRing ↥A)
      (P := PowerSeries k)
      (T := nonZeroDivisors (PowerSeries k))
      (Q := FractionRing (PowerSeries k))
      (g := algebraMap ↥A (PowerSeries k))
      (hy := nonZeroDivisors_le_comap_nonZeroDivisors_of_injective
        (algebraMap ↥A (PowerSeries k)) hA)
      a)

