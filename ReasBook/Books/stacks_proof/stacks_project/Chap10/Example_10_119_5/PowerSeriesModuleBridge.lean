/-- Helper for Chap10 Example 10 119 5: an `A`-span relation among embedded power series in
the ambient fraction field pulls back to the same `A`-span relation in `k[[X]]`. -/
lemma powerSeries_fractionRing_mem_span_pullback
    {ι : Type*} {s : ι → PowerSeries k} {f : PowerSeries k}
    (hf :
      algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) f ∈
        Submodule.span ↥A
          (Set.range fun i ↦
            algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) (s i))) :
    f ∈ Submodule.span ↥A (Set.range s) := by
  -- Apply the abstract pullback lemma to the fraction-ring embedding, restricted to `A`.
  exact mem_span_range_of_injectiveLinear_map_mem_span_range
    ((Algebra.linearMap (PowerSeries k) (FractionRing (PowerSeries k))).restrictScalars ↥A)
    (powerSeries_fractionRingEmbedding_injectiveLinear k p) hf

/-- Helper for Chap10 Example 10 119 5: finite generation of a quotient `M / rM` can be
represented by finitely many chosen lifts in `M`. -/
lemma quotient_existsFiniteLifts_of_moduleFinite
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (r : R) [Module.Finite R (QuotSMulTop r M)] :
    ∃ (n : ℕ) (t : Fin n → M), ∀ f : M, ∃ g ∈ Submodule.span R (Set.range t),
      f - g ∈ r • (⊤ : Submodule R M) := by
  let q : M →ₗ[R] QuotSMulTop r M := Submodule.mkQ (r • (⊤ : Submodule R M))
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := QuotSMulTop r M)
  choose t ht using fun i : Fin n ↦ Submodule.mkQ_surjective (r • (⊤ : Submodule R M)) (s i)
  refine ⟨n, t, ?_⟩
  intro f
  -- Express the quotient class of `f` in the finite quotient span.
  have hf_span : (Submodule.Quotient.mk f : QuotSMulTop r M) ∈
      Submodule.span R (Set.range s) := by
    rw [hs]
    exact Submodule.mem_top
  have hmap :
      (Submodule.span R (Set.range t)).map q = Submodule.span R (Set.range s) := by
    rw [Submodule.map_span]
    congr 1
    ext z
    constructor
    · rintro ⟨m, ⟨i, rfl⟩, hmz⟩
      refine ⟨i, ?_⟩
      rw [← hmz, ht i]
    · rintro ⟨i, rfl⟩
      refine ⟨t i, ⟨i, rfl⟩, ?_⟩
      rw [ht i]
  -- Pull the quotient span expression back to a representative in the lifted span.
  rw [← hmap] at hf_span
  rcases hf_span with ⟨g, hg, hgf⟩
  refine ⟨g, hg, ?_⟩
  exact (Submodule.Quotient.eq (r • (⊤ : Submodule R M))).mp hgf.symm

