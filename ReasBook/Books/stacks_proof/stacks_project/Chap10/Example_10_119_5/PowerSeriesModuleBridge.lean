/-- Helper for Chap10 Example 10 119 5: a nonzero conductor element embeds `k[[X]]` into the
finite image of `A`, hence makes `k[[X]]` finite as an `A`-module. -/
lemma moduleFinite_powerSeries_of_nonzero_conductor
    (hc : ∃ c : ↥A, c ≠ 0 ∧
      ∀ f : PowerSeries k, ∃ a : ↥A,
        algebraMap ↥A (PowerSeries k) a =
          algebraMap ↥A (PowerSeries k) c * f) :
    Module.Finite ↥A (PowerSeries k) := by
  obtain ⟨c, hc_ne, hcond⟩ := hc
  let Q : Submodule ↥A (PowerSeries k) :=
    LinearMap.range (Algebra.linearMap ↥A (PowerSeries k))
  haveI : Module.Finite ↥A Q := by
    -- The range of the inclusion is finite because it is a quotient of the rank-one module `A`.
    exact Module.Finite.of_surjective
      (Algebra.linearMap ↥A (PowerSeries k)).rangeRestrict
      (LinearMap.surjective_rangeRestrict (Algebra.linearMap ↥A (PowerSeries k)))
  have hc_image_ne : algebraMap ↥A (PowerSeries k) c ≠ 0 := by
    -- The subtype inclusion sends a nonzero coefficient-ring element to a nonzero power series.
    intro hc_zero
    exact hc_ne (Subtype.ext hc_zero)
  let μc : PowerSeries k →ₗ[↥A] Q :=
    { toFun := fun f ↦
        ⟨algebraMap ↥A (PowerSeries k) c * f, by
          obtain ⟨a, ha⟩ := hcond f
          exact ⟨a, by simpa [Q] using ha⟩⟩
      map_add' := by
        intro f g
        ext
        simp [mul_add]
      map_smul' := by
        intro a f
        ext
        simp [Algebra.smul_def, mul_comm, mul_left_comm] }
  have hμc_injective : Function.Injective μc := by
    -- Multiplication by the nonzero conductor is cancellative in the domain `k[[X]]`.
    intro f g hfg
    have hmul :
        algebraMap ↥A (PowerSeries k) c * f =
          algebraMap ↥A (PowerSeries k) c * g :=
      congrArg Subtype.val hfg
    have hmul_sub :
        algebraMap ↥A (PowerSeries k) c * (f - g) = 0 := by
      simpa [mul_sub, hmul]
    have hsub_zero : f - g = 0 := by
      rcases mul_eq_zero.mp hmul_sub with hc_zero | hfg_zero
      · exact False.elim (hc_image_ne hc_zero)
      · exact hfg_zero
    exact sub_eq_zero.mp hsub_zero
  -- Finite generation descends from the finite target of this injective linear map.
  exact Module.Finite.of_injective μc hμc_injective

/-- Helper for Chap10 Example 10 119 5: once `k[[X]]` is finite over `A`, the conductor is
generated by `1`. -/
lemma exists_nonzero_conductor_powerSeries_of_moduleFinite
    [Module.Finite ↥A (PowerSeries k)] :
    ∃ c : ↥A, c ≠ 0 ∧
      ∀ f : PowerSeries k, ∃ a : ↥A,
        algebraMap ↥A (PowerSeries k) a =
          algebraMap ↥A (PowerSeries k) c * f := by
  -- Module-finiteness makes the inclusion surjective; then `1` clears every element.
  refine ⟨1, one_ne_zero, ?_⟩
  intro f
  obtain ⟨a, ha⟩ :=
    finitePthPowerCoefficientSubring_algebraMap_surjective_of_moduleFinite k p f
  exact ⟨a, by simpa using ha⟩

