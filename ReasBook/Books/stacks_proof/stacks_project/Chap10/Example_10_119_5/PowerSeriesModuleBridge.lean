/-- Helper for Chap10 Example 10 119 5: the finite-coefficient-union map and the usual
fraction-field-to-Laurent-series map agree after forgetting to Laurent series. -/
lemma fractionRingToFiniteCoeffLaurentUnion_laurent_compatible
    (x : FractionRing ↥A) :
    ((fractionRingToFiniteCoeffLaurentUnion (k := k) (p := p) x :
        finiteCoeffLaurentUnion (k := k) (p := p)) : LaurentSeries k) =
      (FractionRing.algEquiv (PowerSeries k) (LaurentSeries k))
        (algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k)) x) := by
  -- Compare the two ring maps out of `Frac(A)` on the original coefficient DVR.
  let lhs : FractionRing ↥A →+* LaurentSeries k :=
    (finiteCoeffLaurentUnion (k := k) (p := p)).subtype.comp
      (fractionRingToFiniteCoeffLaurentUnion (k := k) (p := p))
  let e : FractionRing (PowerSeries k) ≃ₐ[PowerSeries k] LaurentSeries k :=
    FractionRing.algEquiv (PowerSeries k) (LaurentSeries k)
  let rhs : FractionRing ↥A →+* LaurentSeries k :=
    e.toRingHom.comp (algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k)))
  have hbase (a : ↥A) :
      lhs (algebraMap ↥A (FractionRing ↥A) a) =
        rhs (algebraMap ↥A (FractionRing ↥A) a) := by
    -- On elements of `A`, both maps are the ambient inclusion into Laurent series.
    calc
      lhs (algebraMap ↥A (FractionRing ↥A) a) =
          ((a : PowerSeries k) : LaurentSeries k) := by
            have hmap :=
              fractionRingToFiniteCoeffLaurentUnion_algebraMap (k := k) (p := p) a
            simpa [lhs, finitePthPowerCoefficientSubringToFiniteCoeffLaurentUnion] using
              congrArg
                (fun w : finiteCoeffLaurentUnion (k := k) (p := p) ↦
                  (w : LaurentSeries k)) hmap
      _ = rhs (algebraMap ↥A (FractionRing ↥A) a) := by
            have hfrac :
                algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k))
                    (algebraMap ↥A (FractionRing ↥A) a) =
                  algebraMap (PowerSeries k) (FractionRing (PowerSeries k))
                    (a : PowerSeries k) := by
              calc
                algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k))
                    (algebraMap ↥A (FractionRing ↥A) a) =
                  algebraMap ↥A (FractionRing (PowerSeries k)) a :=
                    fractionRingPowerSeries_algebraMap_algebraMap k p a
                _ = algebraMap (PowerSeries k) (FractionRing (PowerSeries k))
                    (a : PowerSeries k) :=
                    finitePthPowerCoefficientSubring_algebraMap_fractionRing_apply k p a
            simp [rhs, e, hfrac]
  have hmaps : lhs = rhs := by
    ext y
    obtain ⟨a, b, _hb, rfl⟩ := IsFractionRing.div_surjective ↥A y
    rw [map_div₀, map_div₀, hbase a, hbase b]
  simpa [lhs, rhs, e] using RingHom.congr_fun hmaps x

