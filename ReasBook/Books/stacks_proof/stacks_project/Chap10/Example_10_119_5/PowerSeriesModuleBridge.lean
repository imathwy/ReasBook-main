/-- Helper for Chap10 Example 10 119 5: if the coefficient field extension `k / k^p` is finite,
then every ambient power series belongs to the coefficient subring. -/
lemma finitePthPowerCoefficientSubring_mem_of_finiteDimensional
    (hfin : FiniteDimensional (k^[p]) k) (f : PowerSeries k) :
    f ∈ A := by
  -- In the finite branch, the top intermediate field is finite over `k^p` and contains every
  -- coefficient, so it certifies membership in `A`.
  letI : FiniteDimensional (k^[p]) k := hfin
  have htopInjective :
      Function.Injective ((⊤ : IntermediateField (k^[p]) k).val.toLinearMap) := by
    intro x y h
    exact Subtype.ext h
  haveI : FiniteDimensional (k^[p]) (⊤ : IntermediateField (k^[p]) k) :=
    @FiniteDimensional.of_injective (k^[p]) (⊤ : IntermediateField (k^[p]) k)
      _ _ _ k _ _
      ((⊤ : IntermediateField (k^[p]) k).val.toLinearMap)
      htopInjective hfin
  have hcoeff : ∀ n, PowerSeries.coeff n f ∈ (⊤ : IntermediateField (k^[p]) k) := by
    intro n
    trivial
  exact hasFinitePthPowerCoefficientField_of_coeff_mem k p f ⊤ hcoeff
