/-- Helper for Chap10 Example 10 119 5: finite-dimensionality over the finite-coefficient
Laurent union transports back to finite-dimensionality of the fraction field of `k[[X]]` over
`Frac(A)`. -/
lemma fractionRing_finiteDimensional_of_laurentSeries_finiteDimensional
    (hfd : FiniteDimensional (finiteCoeffLaurentUnion (k := k) (p := p)) (LaurentSeries k)) :
    FiniteDimensional (FractionRing ↥A) (FractionRing (PowerSeries k)) := by
  -- First restrict scalars along the surjective localized coefficient map, then inject the
  -- power-series fraction field into Laurent series through the usual equivalence.
  let U : Subfield (LaurentSeries k) := finiteCoeffLaurentUnion (k := k) (p := p)
  let σ : FractionRing ↥A →+* U :=
    fractionRingToFiniteCoeffLaurentUnion (k := k) (p := p)
  letI : Algebra (FractionRing ↥A) U := σ.toAlgebra
  letI : Algebra (FractionRing ↥A) (LaurentSeries k) := (U.subtype.comp σ).toAlgebra
  haveI : IsScalarTower (FractionRing ↥A) U (LaurentSeries k) :=
    IsScalarTower.of_algebraMap_eq (fun _ ↦ rfl)
  haveI : Module.Finite (FractionRing ↥A) U :=
    fractionRingToFiniteCoeffLaurentUnion_moduleFinite (k := k) (p := p)
  letI : FiniteDimensional U (LaurentSeries k) := hfd
  haveI : Module.Finite (FractionRing ↥A) (LaurentSeries k) :=
    Module.Finite.trans U (LaurentSeries k)
  let e : FractionRing (PowerSeries k) ≃ₐ[PowerSeries k] LaurentSeries k :=
    FractionRing.algEquiv (PowerSeries k) (LaurentSeries k)
  have hmap_add (x y : FractionRing (PowerSeries k)) : e (x + y) = e x + e y :=
    map_add e x y
  have hmap_smul (c : FractionRing ↥A) (x : FractionRing (PowerSeries k)) :
      e (c • x) = c • e x := by
    -- The scalar-compatibility lemma converts the target action to multiplication by the same
    -- Laurent coefficient-series element.
    simpa [U, σ, Algebra.smul_def, smul_eq_mul] using
      fractionRingAlgEquiv_laurentSeries_map_smul (k := k) (p := p) c x
  let L : FractionRing (PowerSeries k) →ₗ[FractionRing ↥A] LaurentSeries k :=
    { toFun := e
      map_add' := hmap_add
      map_smul' := hmap_smul }
  -- Finite-dimensionality descends along this injective semilinear realization.
  exact Module.Finite.of_injective L e.injective

