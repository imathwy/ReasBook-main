/-- Helper for Chap10 Example 10 119 5: the direct map from `A` to the ambient fraction field is
the subtype inclusion followed by the fraction-ring map. -/
lemma finitePthPowerCoefficientSubring_algebraMap_fractionRing_apply (a : ↥A) :
    algebraMap ↥A (FractionRing (PowerSeries k)) a =
      algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) (a : PowerSeries k) := by
  -- This records the localization computation in the direction needed by the conductor witness.
  have hvia :
      algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k))
          (algebraMap ↥A (FractionRing ↥A) a) =
        algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) (a : PowerSeries k) := by
    have hA : Function.Injective (algebraMap ↥A (PowerSeries k)) := by
      intro x y h
      exact Subtype.ext h
    change IsFractionRing.map hA (algebraMap ↥A (FractionRing ↥A) a) =
