/-- Helper for Chap10 Example 10 119 5: the Laurent fraction-field equivalence respects
scalars coming from `Frac(A)` after passing through the finite-coefficient union. -/
lemma fractionRingAlgEquiv_laurentSeries_map_smul
    (c : FractionRing ↥A) (x : FractionRing (PowerSeries k)) :
    (FractionRing.algEquiv (PowerSeries k) (LaurentSeries k)) (c • x) =
      ((fractionRingToFiniteCoeffLaurentUnion (k := k) (p := p) c :
          finiteCoeffLaurentUnion (k := k) (p := p)) : LaurentSeries k) *
        (FractionRing.algEquiv (PowerSeries k) (LaurentSeries k)) x := by
  -- Rewrite scalar multiplication as multiplication and then replace the scalar by its
  -- Laurent coefficient-union image.
  let e : FractionRing (PowerSeries k) ≃ₐ[PowerSeries k] LaurentSeries k :=
    FractionRing.algEquiv (PowerSeries k) (LaurentSeries k)
  have hscalar :=
    fractionRingToFiniteCoeffLaurentUnion_laurent_compatible (k := k) (p := p) c
  calc
    e (c • x) =
        e (algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k)) c * x) := by
          rw [Algebra.smul_def]
    _ = e (algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k)) c) * e x := by
          rw [map_mul]
    _ =
        ((fractionRingToFiniteCoeffLaurentUnion (k := k) (p := p) c :
            finiteCoeffLaurentUnion (k := k) (p := p)) : LaurentSeries k) * e x := by
          rw [← hscalar]

