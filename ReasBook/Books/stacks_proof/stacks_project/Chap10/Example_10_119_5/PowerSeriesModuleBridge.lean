/-- Helper for Chap10 Example 10 119 5: a countable linearly independent family rules out
finite dimensionality. -/
lemma not_finiteDimensional_of_nat_linearIndependent
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (h : ∃ v : ℕ → E, LinearIndependent F v) :
    ¬ FiniteDimensional F E := by
  -- A finite-dimensional vector space cannot contain a countably infinite independent family.
  intro hfinite
  obtain ⟨v, hv⟩ := h
  letI : FiniteDimensional F E := hfinite
  have hlt : Cardinal.mk ℕ < Cardinal.aleph0 :=
    hv.lt_aleph0_of_finiteDimensional
  exact (not_lt_of_ge (by simp : Cardinal.aleph0 ≤ Cardinal.mk ℕ)) hlt

/-- Helper for Chap10 Example 10 119 5: every constant power series belongs to the
coefficient subring `A`. -/
lemma constantPowerSeries_mem_finitePthPowerCoefficientSubring (c : k) :
    (PowerSeries.C c : PowerSeries k) ∈ A := by
  -- The singleton field generated by the constant coefficient is finite over `k^p`.
  let S : Set k := {c}
  letI : Finite S := Set.finite_singleton c
  let L : IntermediateField (k^[p]) k := IntermediateField.adjoin (k^[p]) S
  haveI : FiniteDimensional (k^[p]) L :=
    IntermediateField.finiteDimensional_adjoin (K := k^[p]) (L := k) (S := S) (by
      intro x _hx
      exact isIntegral_over_pthPowerSubfield k p x)
  refine hasFinitePthPowerCoefficientField_of_coeff_mem k p (PowerSeries.C c) L ?_
  intro n
  by_cases hn : n = 0
  · -- The only nonzero coefficient is the chosen constant, which is one of the generators.
    have hc : c ∈ L :=
      IntermediateField.subset_adjoin (F := k^[p]) (S := S) (by simp [S])
    simpa [PowerSeries.coeff_C, hn] using hc
  · -- All other coefficients are zero and hence lie in every intermediate field.
    simp [PowerSeries.coeff_C, hn]

/-- Helper for Chap10 Example 10 119 5: if `k[[X]]` were finite over `A`, the inclusion
`A → k[[X]]` would be surjective by Nakayama. -/
lemma finitePthPowerCoefficientSubring_algebraMap_surjective_of_moduleFinite
    [Module.Finite ↥A (PowerSeries k)] :
    Function.Surjective (algebraMap ↥A (PowerSeries k)) := by
  let Q : Submodule ↥A (PowerSeries k) :=
    LinearMap.range (Algebra.linearMap ↥A (PowerSeries k))
  let q : PowerSeries k →ₗ[↥A] (PowerSeries k ⧸ Q) := Q.mkQ
  letI : Module.Finite ↥A (PowerSeries k ⧸ Q) := inferInstance
  let ϖ : ↥A := ⟨PowerSeries.X, X_mem_finitePthPowerCoefficientSubring k p⟩
  have hϖmax : ϖ ∈ maximalIdeal ↥A := by
    -- The same uniformizer is irreducible in `A`, hence a nonunit in the local ring.
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    exact (finitePthPowerCoefficientSubring_X_irreducible k p).not_isUnit
  have htop_le :
      (⊤ : Submodule ↥A (PowerSeries k ⧸ Q)) ≤
        maximalIdeal ↥A • (⊤ : Submodule ↥A (PowerSeries k ⧸ Q)) := by
    intro z _hz
    obtain ⟨f, rfl⟩ := Submodule.mkQ_surjective Q z
    let tail : PowerSeries k := PowerSeries.mk fun n ↦ PowerSeries.coeff (n + 1) f
    let cA : ↥A :=
      ⟨PowerSeries.C (PowerSeries.constantCoeff f),
        constantPowerSeries_mem_finitePthPowerCoefficientSubring k p
          (PowerSeries.constantCoeff f)⟩
    have hconst_zero : q (PowerSeries.C (PowerSeries.constantCoeff f)) = 0 := by
      -- Constants from `A` vanish in the quotient by the image of `A`.
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact LinearMap.mem_range_self (Algebra.linearMap ↥A (PowerSeries k)) cA
    have hsplit :
        q f = ϖ • q tail := by
      -- Split off the constant term; the constant part dies in the quotient.
      calc
        q f = q (PowerSeries.X * tail + PowerSeries.C (PowerSeries.constantCoeff f)) := by
            simpa [tail] using congrArg q (PowerSeries.eq_X_mul_shift_add_const f)
        _ = q (PowerSeries.X * tail) + q (PowerSeries.C (PowerSeries.constantCoeff f)) := by
            rw [map_add]
        _ = q (PowerSeries.X * tail) := by
            simp [hconst_zero]
        _ = q (ϖ • tail) := by
            rfl
        _ = ϖ • q tail := by
            rw [map_smul]
    rw [hsplit]
    exact Submodule.smul_mem_smul hϖmax Submodule.mem_top
  have htop_bot :
      (⊤ : Submodule ↥A (PowerSeries k ⧸ Q)) = ⊥ := by
    -- Nakayama kills the finite quotient because it is equal to its maximal-ideal multiple.
    exact Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal ↥A)
      (⊤ : Submodule ↥A (PowerSeries k ⧸ Q)) Module.Finite.fg_top htop_le
      (IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal ↥A))
  intro f
  have hq_zero : q f = 0 := by
    -- Vanishing of the top quotient submodule says every quotient class is zero.
    have hmem : q f ∈ (⊥ : Submodule ↥A (PowerSeries k ⧸ Q)) := by
      rw [← htop_bot]
      exact Submodule.mem_top
    simpa using hmem
  have hf_mem : f ∈ Q := by
    simpa [q] using (Submodule.Quotient.mk_eq_zero Q).mp hq_zero
  rcases hf_mem with ⟨a, ha⟩
  exact ⟨a, ha⟩

/-- Helper for Chap10 Example 10 119 5: infinite degree over `k^p` rules out finite generation
of `k[[X]]` as an `A`-module. -/
lemma not_moduleFinite_powerSeries_over_finitePthPowerCoefficientSubring
    (hnfd : ¬ FiniteDimensional (k^[p]) k) :
    ¬ Module.Finite ↥A (PowerSeries k) := by
  -- A finite module would be surjective onto all power series, contradicting the existing
  -- nonmembership construction.
  intro hfinite
  letI : Module.Finite ↥A (PowerSeries k) := hfinite
  obtain ⟨f, hf⟩ := exists_not_mem_finitePthPowerCoefficientSubring k p hnfd
  obtain ⟨a, ha⟩ :=
    finitePthPowerCoefficientSubring_algebraMap_surjective_of_moduleFinite k p f
  exact hf (by
    rw [← ha]
    exact a.2)

