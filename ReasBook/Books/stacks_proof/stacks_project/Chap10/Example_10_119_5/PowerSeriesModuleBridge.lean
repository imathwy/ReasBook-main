/-- Helper for Chap10 Example 10 119 5: powers of the coefficient DVR uniformizer are the
corresponding powers of `X` in the ambient power-series ring. -/
lemma finitePthPowerCoefficientSubring_uniformizer_pow_coe (n : ℕ) :
    ((finitePthPowerCoefficientSubring_uniformizer k p) ^ n : PowerSeries k) =
      (PowerSeries.X : PowerSeries k) ^ n := by
  -- The subring coercion commutes with multiplication, so powers remain ambient `X`-powers.
  rfl

/-- Helper for Chap10 Example 10 119 5: the closed fiber of `k[[X]]` modulo the coefficient
DVR uniformizer is generated by the class of `1`. -/
lemma powerSeries_quotSMulTop_uniformizer_finite :
    Module.Finite ↥A
      (QuotSMulTop (finitePthPowerCoefficientSubring_uniformizer k p) (PowerSeries k)) := by
  let ϖ : ↥A := finitePthPowerCoefficientSubring_uniformizer k p
  let Q : Type u := QuotSMulTop ϖ (PowerSeries k)
  let q : PowerSeries k →ₗ[↥A] Q := Submodule.mkQ (ϖ • (⊤ : Submodule ↥A (PowerSeries k)))
  let gen : ↥A →ₗ[↥A] Q :=
    { toFun := fun a ↦ a • q 1
      map_add' := by
        intro a b
        rw [add_smul]
      map_smul' := by
        intro a b
        simpa [smul_smul] }
  -- Every quotient class is represented by the constant term, since the tail is divisible by `X`.
  have hsurj : Function.Surjective gen := by
    intro z
    obtain ⟨f, rfl⟩ := Submodule.mkQ_surjective (ϖ • (⊤ : Submodule ↥A (PowerSeries k))) z
    let cA : ↥A :=
      ⟨PowerSeries.C (PowerSeries.constantCoeff f),
        constantPowerSeries_mem_finitePthPowerCoefficientSubring k p
          (PowerSeries.constantCoeff f)⟩
    refine ⟨cA, ?_⟩
    let tail : PowerSeries k := PowerSeries.mk fun n ↦ PowerSeries.coeff (n + 1) f
    have htail :
        f - PowerSeries.C (PowerSeries.constantCoeff f) ∈
          ϖ • (⊤ : Submodule ↥A (PowerSeries k)) := by
      have htail_eq :
          f - PowerSeries.C (PowerSeries.constantCoeff f) = PowerSeries.X * tail := by
        simpa [tail] using PowerSeries.sub_const_eq_X_mul_shift f
      rw [htail_eq]
      simpa [ϖ, Algebra.smul_def] using
        (Submodule.smul_mem_pointwise_smul tail ϖ
          (⊤ : Submodule ↥A (PowerSeries k)) trivial)
    have hmk :
        (Submodule.Quotient.mk f :
          QuotSMulTop ϖ (PowerSeries k)) =
            Submodule.Quotient.mk (PowerSeries.C (PowerSeries.constantCoeff f)) := by
      rw [← sub_eq_zero, ← Submodule.Quotient.mk_sub, Submodule.Quotient.mk_eq_zero]
      exact htail
    change
      cA • (Submodule.Quotient.mk (1 : PowerSeries k) : QuotSMulTop ϖ (PowerSeries k)) =
        (Submodule.Quotient.mk f : QuotSMulTop ϖ (PowerSeries k))
    rw [← Submodule.Quotient.mk_smul, hmk]
    congr 1
    change (algebraMap ↥A (PowerSeries k) cA) * 1 =
      PowerSeries.C (PowerSeries.constantCoeff f)
    rw [mul_one]
    rfl
  exact Module.Finite.of_surjective gen hsurj

