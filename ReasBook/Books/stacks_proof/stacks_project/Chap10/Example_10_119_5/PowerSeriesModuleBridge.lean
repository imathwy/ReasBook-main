/-- Helper for Chap10 Example 10 119 5: span membership can be pulled back through an
injective linear map when the spanning family is mapped pointwise. -/
lemma mem_span_range_of_injectiveLinear_map_mem_span_range
    {R M N ι : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    [AddCommMonoid N] [Module R N]
    (L : M →ₗ[R] N) (hL : Function.Injective L) {s : ι → M} {x : M}
    (hx : L x ∈ Submodule.span R (Set.range fun i ↦ L (s i))) :
    x ∈ Submodule.span R (Set.range s) := by
  -- Identify the mapped span with the span of the mapped generators.
  have hmap :
      (Submodule.span R (Set.range s)).map L =
        Submodule.span R (Set.range fun i ↦ L (s i)) := by
    rw [Submodule.map_span]
    congr 1
    ext y
    constructor
    · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨s i, ⟨i, rfl⟩, rfl⟩
  -- A preimage in the original span is forced to be `x` by injectivity.
  rw [← hmap] at hx
  rcases hx with ⟨y, hy, hyx⟩
  have hxy : y = x := hL hyx
  simpa [hxy] using hy

