/-- Helper for Chap10 Example 10 119 5: the finite-coefficient Laurent union is a finite
module over the localized coefficient DVR. -/
lemma fractionRingToFiniteCoeffLaurentUnion_moduleFinite :
    let σ : FractionRing ↥A →+* finiteCoeffLaurentUnion (k := k) (p := p) :=
      fractionRingToFiniteCoeffLaurentUnion (k := k) (p := p)
    letI : Algebra (FractionRing ↥A) (finiteCoeffLaurentUnion (k := k) (p := p)) :=
