    (finitePthPowerCoefficientSubring_uniformizer k p)

/-- Helper for Chap10 Example 10 119 5: every ambient fraction has a denominator coming from
the coefficient DVR after using integrality of `k[[X]]` over `A`. -/
lemma fractionRingPowerSeries_existsBaseDenominator
    (z : FractionRing (PowerSeries k)) :
    ∃ a : ↥A, a ≠ 0 ∧ ∃ f : PowerSeries k,
      algebraMap ↥A (FractionRing (PowerSeries k)) a * z =
        algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) f := by
  -- Use algebraicity over `A` to clear the power-series denominator of a fraction.
  haveI : Algebra.IsIntegral ↥A (PowerSeries k) :=
    finitePthPowerCoefficientSubring_algebra_isIntegral k p
  haveI : Algebra.IsAlgebraic ↥A (PowerSeries k) :=
    Algebra.IsIntegral.isAlgebraic
  obtain ⟨num, den, hden, rfl⟩ := IsFractionRing.div_surjective (PowerSeries k) z
  have hden_ne : den ≠ 0 := nonZeroDivisors.ne_zero hden
  obtain ⟨c, d, hd_ne, hmul⟩ :=
    Algebra.IsAlgebraic.exists_smul_eq_mul (↥A) num (b := den) hden_ne
  refine ⟨d, hd_ne, c, ?_⟩
  let F := FractionRing (PowerSeries k)
  have hdenF : algebraMap (PowerSeries k) F den ≠ 0 := by
    intro h
    exact hden_ne (IsFractionRing.to_map_eq_zero_iff.mp h)
  have hmap :
      algebraMap ↥A F d * algebraMap (PowerSeries k) F num =
        algebraMap (PowerSeries k) F den * algebraMap (PowerSeries k) F c := by
    simpa [F, Algebra.smul_def] using congrArg (algebraMap (PowerSeries k) F) hmul
  -- Divide the cleared-denominator identity by the original nonzero denominator.
  calc
    algebraMap ↥A F d *
        (algebraMap (PowerSeries k) F num / algebraMap (PowerSeries k) F den) =
      (algebraMap ↥A F d * algebraMap (PowerSeries k) F num) *
        (algebraMap (PowerSeries k) F den)⁻¹ := by
        rw [div_eq_mul_inv, mul_assoc]
    _ = (algebraMap (PowerSeries k) F den * algebraMap (PowerSeries k) F c) *
        (algebraMap (PowerSeries k) F den)⁻¹ := by
        rw [hmap]
    _ = algebraMap (PowerSeries k) F c := by
        rw [mul_comm (algebraMap (PowerSeries k) F den) (algebraMap (PowerSeries k) F c),
          mul_assoc, mul_inv_cancel₀ hdenF, mul_one]

