/-- Helper for Chap10 Example 10 119 5: a finite-dimensional ambient fraction field has a
finite spanning family represented by embedded power series. -/
lemma fractionRingPowerSeries_existsFinitePowerSeriesSpanningFamily
    (hfd : FiniteDimensional (FractionRing ↥A) (FractionRing (PowerSeries k))) :
    ∃ (n : ℕ) (t : Fin n → PowerSeries k), ∀ z : FractionRing (PowerSeries k),
      z ∈ Submodule.span (FractionRing ↥A)
        (Set.range fun i ↦
          algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) (t i)) := by
  classical
  -- Start with any finite spanning family over `Frac(A)` and clear the denominator of each
  -- generator so that every generator is in the span of embedded power series.
  letI : Module (FractionRing ↥A) (FractionRing (PowerSeries k)) := Algebra.toModule
  letI : FiniteDimensional (FractionRing ↥A) (FractionRing (PowerSeries k)) := hfd
  obtain ⟨n, s, hs⟩ :=
    Module.Finite.exists_fin
      (R := FractionRing ↥A) (M := FractionRing (PowerSeries k))
  have hden :
      ∀ i : Fin n, ∃ a : ↥A, a ≠ 0 ∧ ∃ f : PowerSeries k,
        algebraMap ↥A (FractionRing (PowerSeries k)) a * s i =
          algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) f := by
    intro i
    exact fractionRingPowerSeries_existsBaseDenominator (k := k) (p := p) (s i)
  choose a ha using hden
  choose t ht using fun i ↦ (ha i).2
  refine ⟨n, t, ?_⟩
  intro z
  let T : Submodule (FractionRing ↥A) (FractionRing (PowerSeries k)) :=
    Submodule.span (FractionRing ↥A)
      (Set.range fun i ↦
        algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) (t i))
  have hs_le : Submodule.span (FractionRing ↥A) (Set.range s) ≤ T := by
    refine Submodule.span_le.mpr ?_
    rintro y ⟨i, rfl⟩
    let c : FractionRing ↥A := algebraMap ↥A (FractionRing ↥A) (a i)
    have hc_ne : c ≠ 0 := by
      intro hc
      exact (ha i).1 (IsFractionRing.to_map_eq_zero_iff.mp hc)
    have hc_map :
        algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k)) c =
          algebraMap ↥A (FractionRing (PowerSeries k)) (a i) := by
      dsimp [c]
      exact fractionRingPowerSeries_algebraMap_algebraMap k p (a i)
    have hscalar :
        c • s i =
          algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) (t i) := by
      -- The cleared denominator relation is exactly scalar multiplication by the corresponding
      -- element of `Frac(A)`.
      calc
        c • s i =
            algebraMap (FractionRing ↥A) (FractionRing (PowerSeries k)) c * s i := by
              rw [Algebra.smul_def]
        _ = algebraMap ↥A (FractionRing (PowerSeries k)) (a i) * s i := by
              rw [hc_map]
        _ = algebraMap (PowerSeries k) (FractionRing (PowerSeries k)) (t i) := ht i
    have hc_unit : IsUnit c := isUnit_iff_ne_zero.mpr hc_ne
    exact (T.smul_mem_iff_of_isUnit (x := s i) hc_unit).1 (by
      rw [hscalar]
      exact Submodule.subset_span ⟨i, rfl⟩)
  have hz : z ∈ Submodule.span (FractionRing ↥A) (Set.range s) := by
    rw [hs]
    exact Submodule.mem_top
  exact hs_le hz

