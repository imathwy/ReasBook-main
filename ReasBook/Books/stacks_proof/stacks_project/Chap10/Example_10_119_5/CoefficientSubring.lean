import Mathlib
import StacksProject_2024.Chap10.Lemma_10_97_7
import StacksProject_2024.Chap10.Lemma_10_112_4

-- Declarations for this item will be appended below by the statement pipeline.

/-
Domain-style sampling pass for Example 10.119.5.

Primary domain: coefficient-generated purely inseparable extensions for formal power series,
together with the induced coefficient subring, its adic completion, and its fraction field.

Sampled owner declarations:
* `(_root_.frobenius k p).fieldRange`;
* `IntermediateField.adjoin`;
* `Subring.closure`;
* `maximalIdealCompletionMap`;
* `AdicCompletion.ofAlgEquiv`.

Owner abstraction: the source-facing coefficient ring is a `Subring (PowerSeries k)`, with the
coefficient field carried by the canonical owner `IntermediateField.adjoin` over `k^[p]`.
Completion and fraction-field statements should therefore stay directly on `AdicCompletion` and
`FractionRing`, and the subtype carriers should remain a bridge/view layer only.

Source/core/bridge triage:
* `source-facing`: `HasFinitePthPowerCoefficientField`, `finitePthPowerCoefficientSubring`, and
  `finitePthPowerCoefficientAdjoinSubring`;
* `core/canonical`: `IntermediateField.adjoin`, `Subring`, `AdicCompletion`, and `FractionRing`;
* `bridge/view`: subtype carriers such as `↥(finitePthPowerCoefficientSubring k p)` and the
  completion/fraction-field comparison maps.

Primitive vs derived:
* primitive data are the coefficient-generated intermediate field and the resulting source-facing
  subrings;
* discrete-valuation, completion, and fraction-field properties are derived API on those owners.
-/

noncomputable section

universe u

open PowerSeries IsLocalRing
open AdicCompletion
open scoped Pointwise

variable (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [ExpChar k p]

/-- The subfield `k^p` of `p`th powers inside `k`. -/
abbrev pthPowerSubfield : Subfield k :=
  (_root_.frobenius k p).fieldRange

namespace PthPowerSubfield

/- Textbook notation for the subfield `k^p` of `k`. -/
scoped notation:max K "^[" p "]" => pthPowerSubfield K p

end PthPowerSubfield

open scoped PthPowerSubfield

/-- The field generated over `k^p` by the coefficients of a power series. -/
abbrev coefficientAdjoinOverPthPowers (f : PowerSeries k) :
    IntermediateField (k^[p]) k :=
  IntermediateField.adjoin (k^[p]) (Set.range fun n : ℕ ↦ coeff n f)

/-- A power series whose coefficients generate a finite extension of `k^p`. -/
def HasFinitePthPowerCoefficientField (f : PowerSeries k) : Prop :=
  FiniteDimensional (k^[p]) (coefficientAdjoinOverPthPowers k p f)

omit [Fact p.Prime] in
/-- Helper for Chap10 Example 10 119 5: every coefficient lies in its own generated
intermediate field. -/
lemma coeff_mem_coefficientAdjoinOverPthPowers (f : PowerSeries k) (n : ℕ) :
    coeff n f ∈ coefficientAdjoinOverPthPowers k p f := by
  -- The coefficient is one of the generators of the intermediate field.
  exact IntermediateField.subset_adjoin (F := k^[p])
    (S := Set.range fun n : ℕ ↦ coeff n f) (Set.mem_range_self n)

omit [Fact p.Prime] in
/-- Helper for Chap10 Example 10 119 5: a finite intermediate field containing all coefficients
certifies the finite-coefficient-field condition. -/
lemma hasFinitePthPowerCoefficientField_of_coeff_mem (f : PowerSeries k)
    (L : IntermediateField (k^[p]) k) [FiniteDimensional (k^[p]) L]
    (hL : ∀ n, coeff n f ∈ L) :
    HasFinitePthPowerCoefficientField k p f := by
  -- The generated coefficient field embeds linearly in the chosen finite field.
  unfold HasFinitePthPowerCoefficientField
  have hle : coefficientAdjoinOverPthPowers k p f ≤ L := by
    rw [coefficientAdjoinOverPthPowers, IntermediateField.adjoin_le_iff]
    rintro _ ⟨n, rfl⟩
    exact hL n
  exact FiniteDimensional.of_injective (IntermediateField.inclusion hle).toLinearMap
    (IntermediateField.inclusion_injective hle)

-- Proof sketch: the zero series has all coefficients equal to `0`, so the coefficient field is
-- just `k^p`, hence finite over itself.
omit [Fact p.Prime] in
/-- The zero power series has finite coefficient field over `k^p`. -/
lemma hasFinitePthPowerCoefficientField_zero :
    HasFinitePthPowerCoefficientField k p (0 : PowerSeries k) := by
  -- All coefficients are in the bottom intermediate field.
  exact hasFinitePthPowerCoefficientField_of_coeff_mem k p 0 ⊥ (by simp)

-- Proof sketch: the coefficients of `1` are `1, 0, 0, ...`, so adjoining them to `k^p` gives the
-- finite extension generated by the single element `1`.
omit [Fact p.Prime] in
/-- The constant series `1` has finite coefficient field over `k^p`. -/
lemma hasFinitePthPowerCoefficientField_one :
    HasFinitePthPowerCoefficientField k p (1 : PowerSeries k) := by
  -- The only possible coefficients are `0` and `1`, both in the base field.
  exact hasFinitePthPowerCoefficientField_of_coeff_mem k p 1 ⊥ (by
    intro n
    by_cases hn : n = 0
    · simp [coeff_one, hn]
    · simp [coeff_one, hn])

-- Proof sketch: the coefficients of `f + g` lie in the compositum of the two finite coefficient
-- fields attached to `f` and `g`, and a compositum of finite extensions is again finite.
omit [Fact p.Prime] in
/-- The finite-coefficient-field condition is closed under addition. -/
lemma hasFinitePthPowerCoefficientField_add {f g : PowerSeries k}
    (hf : HasFinitePthPowerCoefficientField k p f)
    (hg : HasFinitePthPowerCoefficientField k p g) :
    HasFinitePthPowerCoefficientField k p (f + g) := by
  -- Work in the finite compositum of the two coefficient fields.
  let Lf := coefficientAdjoinOverPthPowers k p f
  let Lg := coefficientAdjoinOverPthPowers k p g
  letI : FiniteDimensional (k^[p]) Lf := hf
  letI : FiniteDimensional (k^[p]) Lg := hg
  exact hasFinitePthPowerCoefficientField_of_coeff_mem k p (f + g) (Lf ⊔ Lg) (by
    intro n
    rw [map_add]
    exact add_mem
      (SetLike.le_def.mp (show Lf ≤ Lf ⊔ Lg from le_sup_left)
        (coeff_mem_coefficientAdjoinOverPthPowers k p f n))
      (SetLike.le_def.mp (show Lg ≤ Lf ⊔ Lg from le_sup_right)
        (coeff_mem_coefficientAdjoinOverPthPowers k p g n)))

-- Proof sketch: each coefficient of `f * g` is a finite `k`-linear combination of products of
-- coefficients of `f` and `g`, so all coefficients lie in the same finite compositum field.
omit [Fact p.Prime] in
/-- The finite-coefficient-field condition is closed under multiplication. -/
lemma hasFinitePthPowerCoefficientField_mul {f g : PowerSeries k}
    (hf : HasFinitePthPowerCoefficientField k p f)
    (hg : HasFinitePthPowerCoefficientField k p g) :
    HasFinitePthPowerCoefficientField k p (f * g) := by
  -- Each convolution summand is a product of coefficients in the finite compositum.
  let Lf := coefficientAdjoinOverPthPowers k p f
  let Lg := coefficientAdjoinOverPthPowers k p g
  letI : FiniteDimensional (k^[p]) Lf := hf
  letI : FiniteDimensional (k^[p]) Lg := hg
  exact hasFinitePthPowerCoefficientField_of_coeff_mem k p (f * g) (Lf ⊔ Lg) (by
    intro n
    rw [coeff_mul]
    exact (Lf ⊔ Lg).sum_mem fun ij _ ↦
      mul_mem
        (SetLike.le_def.mp (show Lf ≤ Lf ⊔ Lg from le_sup_left)
          (coeff_mem_coefficientAdjoinOverPthPowers k p f ij.1))
        (SetLike.le_def.mp (show Lg ≤ Lf ⊔ Lg from le_sup_right)
          (coeff_mem_coefficientAdjoinOverPthPowers k p g ij.2)))

-- Proof sketch: negating a power series does not enlarge the field generated by its coefficients.
omit [Fact p.Prime] in
/-- The finite-coefficient-field condition is closed under negation. -/
lemma hasFinitePthPowerCoefficientField_neg {f : PowerSeries k}
    (hf : HasFinitePthPowerCoefficientField k p f) :
    HasFinitePthPowerCoefficientField k p (-f) := by
  -- Negation keeps all coefficients in the same finite intermediate field.
  let Lf := coefficientAdjoinOverPthPowers k p f
  letI : FiniteDimensional (k^[p]) Lf := hf
  exact hasFinitePthPowerCoefficientField_of_coeff_mem k p (-f) Lf (by
    intro n
    rw [map_neg]
    exact neg_mem (coeff_mem_coefficientAdjoinOverPthPowers k p f n))

/-- The subring `A ⊆ k[[x]]` of power series whose coefficients generate a finite extension of
`k^p`. -/
def finitePthPowerCoefficientSubring : Subring (PowerSeries k) where
  carrier := {f | HasFinitePthPowerCoefficientField k p f}
  zero_mem' := hasFinitePthPowerCoefficientField_zero k p
  add_mem' := fun hf hg ↦ hasFinitePthPowerCoefficientField_add k p hf hg
  one_mem' := hasFinitePthPowerCoefficientField_one k p
  mul_mem' := fun hf hg ↦ hasFinitePthPowerCoefficientField_mul k p hf hg
  neg_mem' := fun hf ↦ hasFinitePthPowerCoefficientField_neg k p hf

/-- The subring `R = A[f]` generated by `A` and one extra power series `f`. -/
def finitePthPowerCoefficientAdjoinSubring (f : PowerSeries k) : Subring (PowerSeries k) :=
  Subring.closure (Set.insert f (finitePthPowerCoefficientSubring k p : Set (PowerSeries k)))

local notation "A" => finitePthPowerCoefficientSubring k p

omit [Fact p.Prime] in
/-- Helper for Chap10 Example 10 119 5: the power-series uniformizer `X` belongs to the
coefficient subring. -/
lemma X_mem_finitePthPowerCoefficientSubring :
    (PowerSeries.X : PowerSeries k) ∈ A := by
  -- The only coefficients of `X` are `0` and `1`, hence they lie in the base field `k^p`.
  exact hasFinitePthPowerCoefficientField_of_coeff_mem k p PowerSeries.X ⊥ (by
    intro n
    by_cases hn : n = 1
    · simp [PowerSeries.coeff_X, hn]
    · simp [PowerSeries.coeff_X, hn])

-- Proof sketch: in characteristic `p`, the coefficientwise Frobenius sends `f.expand p` to `f^p`,
-- so every coefficient of `f^p` is a `p`th power in `k`, hence belongs to `k^p`.
/-- Every `p`th power in `k[[x]]` already lies in the coefficient subring `A`. -/
theorem pow_mem_finitePthPowerCoefficientSubring (f : PowerSeries k) :
    f ^ p ∈ A := by
  -- In characteristic `p`, the `p`th power is obtained by applying Frobenius after expansion.
  have hp_ne : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  have hfrob : PowerSeries.map (frobenius k p) (PowerSeries.expand p hp_ne f) = f ^ p := by
    simpa [PowerSeries.map, PowerSeries.expand] using
      (MvPowerSeries.map_frobenius_expand (p := p) (hp := hp_ne) (f := f))
  refine hasFinitePthPowerCoefficientField_of_coeff_mem k p (f ^ p) ⊥ ?_
  intro n
  have hpth : coeff n (f ^ p) ∈ (k^[p] : Subfield k) := by
    rw [← hfrob, coeff_map]
    exact RingHom.mem_fieldRange_self (frobenius k p) _
  rw [IntermediateField.mem_bot]
  exact ⟨⟨coeff n (f ^ p), hpth⟩, rfl⟩

omit [Fact p.Prime] in
/-- Helper for Chap10 Example 10 119 5: removing the initial `X`-power of a coefficient-finite
series preserves coefficient-field finiteness. -/
lemma hasFinitePthPowerCoefficientField_divXPowOrder {f : PowerSeries k}
    (hf : HasFinitePthPowerCoefficientField k p f) :
    HasFinitePthPowerCoefficientField k p (PowerSeries.divXPowOrder f) := by
  -- The coefficients of `divXPowOrder f` are shifted coefficients of `f`.
  let L := coefficientAdjoinOverPthPowers k p f
  letI : FiniteDimensional (k^[p]) L := hf
  exact hasFinitePthPowerCoefficientField_of_coeff_mem k p (PowerSeries.divXPowOrder f) L (by
    intro n
    rw [PowerSeries.coeff_divXPowOrder]
    exact coeff_mem_coefficientAdjoinOverPthPowers k p f (n + f.order.toNat))

omit [Fact p.Prime] in
/-- Helper for Chap10 Example 10 119 5: `divXPowOrder` keeps elements inside the coefficient
subring. -/
lemma divXPowOrder_mem_finitePthPowerCoefficientSubring {f : PowerSeries k}
    (hf : f ∈ A) :
    PowerSeries.divXPowOrder f ∈ A :=
  hasFinitePthPowerCoefficientField_divXPowOrder k p hf

omit [Fact p.Prime] in
/-- The coefficient subring `A` is contained in each adjoined ring `A[f]`. -/
theorem finitePthPowerCoefficientSubring_le_adjoinSubring (f : PowerSeries k) :
    A ≤ finitePthPowerCoefficientAdjoinSubring k p f := by
  intro g hg
  exact Subring.subset_closure (Set.mem_insert_of_mem f hg)

omit [Fact p.Prime] in
/-- The source-facing subring `A[f]` is exactly the canonical `A`-subalgebra generated by `f`,
viewed as a subring of `k[[x]]`. -/
theorem finitePthPowerCoefficientAdjoinSubring_eq_adjoin_toSubring (f : PowerSeries k) :
    (Algebra.adjoin ↥A ({f} : Set (PowerSeries k))).toSubring =
      finitePthPowerCoefficientAdjoinSubring k p f := by
  -- Both sides are the same ring closure: the image of `A` together with the generator `f`.
  have hsets :
      Set.range (algebraMap ↥A (PowerSeries k)) ∪ ({f} : Set (PowerSeries k)) =
        Set.insert f (A : Set (PowerSeries k)) := by
    ext x
    constructor
    · rintro (hx | hx)
      · rcases hx with ⟨a, rfl⟩
        exact Set.mem_insert_of_mem f a.2
      · left
        simpa using hx
    · intro hx
      rcases Set.mem_insert_iff.mp hx with rfl | hxA
      · exact Or.inr (by simp)
      · left
        refine ⟨⟨x, hxA⟩, ?_⟩
        rfl
  rw [Algebra.adjoin_eq_ring_closure, finitePthPowerCoefficientAdjoinSubring, hsets]

/-- The canonical inclusion `A ⊆ A[f]` equips `A[f]` with its natural `A`-algebra structure. -/
instance finitePthPowerCoefficientAdjoinSubring_algebra (f : PowerSeries k) :
    Algebra ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f) :=
  RingHom.toAlgebra <|
    Subring.inclusion (finitePthPowerCoefficientSubring_le_adjoinSubring k p f)

-- Proof sketch: `f^p ∈ A`, so `f` satisfies the monic polynomial `X^p - f^p` over `A`.
/-- The adjoined generator `f` is integral over the coefficient subring `A`. -/
theorem finitePthPowerCoefficientAdjoinSubring_isIntegral (f : PowerSeries k) :
    IsIntegral ↥A f := by
  -- The monic equation is obtained by viewing `f ^ p ∈ A` as an integral algebra-map value.
  have hp_pos : 0 < p := (Fact.out : p.Prime).pos
  have hpow_mem : f ^ p ∈ A := pow_mem_finitePthPowerCoefficientSubring k p f
  have hpow_int : IsIntegral ↥A (f ^ p) := by
    let fp : ↥A := ⟨f ^ p, hpow_mem⟩
    have hmap : IsIntegral ↥A (algebraMap ↥A (PowerSeries k) fp) := isIntegral_algebraMap
    simpa [fp] using hmap
  exact IsIntegral.of_pow hp_pos hpow_int

-- Proof sketch: `A[f]` is the canonical simple `A`-algebra generated by the integral element `f`,
-- so it is module-finite over `A`.
/-- The extension `A ⊆ A[f]` is finite. -/
theorem finitePthPowerCoefficientAdjoinSubring_moduleFinite (f : PowerSeries k) :
    Module.Finite ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f) := by
  -- Transfer finite generation from the canonical simple adjoin to the source-facing subring.
  let S : Subalgebra ↥A (PowerSeries k) := Algebra.adjoin ↥A ({f} : Set (PowerSeries k))
  have hSfinite : Module.Finite ↥A S :=
    Algebra.finite_adjoin_simple_of_isIntegral
      (finitePthPowerCoefficientAdjoinSubring_isIntegral k p f)
  have hEq : S.toSubring = finitePthPowerCoefficientAdjoinSubring k p f := by
    dsimp [S]
    exact finitePthPowerCoefficientAdjoinSubring_eq_adjoin_toSubring k p f
  have memR_of_memS {x : PowerSeries k} (hx : x ∈ S) :
      x ∈ finitePthPowerCoefficientAdjoinSubring k p f := by
    have hx' : x ∈ S.toSubring := hx
    rw [hEq] at hx'
    exact hx'
  have memS_of_memR {x : PowerSeries k}
      (hx : x ∈ finitePthPowerCoefficientAdjoinSubring k p f) : x ∈ S := by
    have hx' : x ∈ S.toSubring := by
      rw [hEq]
      exact hx
    exact hx'
  let lin : S →ₗ[↥A] ↥(finitePthPowerCoefficientAdjoinSubring k p f) :=
    { toFun := fun x ↦ ⟨x.1, memR_of_memS x.2⟩
      map_add' := by
        intro x y
        ext
        rfl
      map_smul' := by
        intro a x
        ext
        simp only [Algebra.smul_def, RingHom.id_apply]
        have hscalarS :
            (↑((algebraMap ↥A S) a) : PowerSeries k) =
              (algebraMap ↥A (PowerSeries k)) a := rfl
        have hscalarR :
            (↑((algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f)) a) :
                PowerSeries k) = (algebraMap ↥A (PowerSeries k)) a := rfl
        simp [hscalarS, hscalarR] }
  have hsurj : Function.Surjective lin := by
    intro y
    refine ⟨⟨y.1, memS_of_memR y.2⟩, ?_⟩
    ext
    rfl
  letI : Module.Finite ↥A S := hSfinite
  exact Module.Finite.of_surjective lin hsurj

/-- The induced fraction-field algebra `Frac(A) → Frac(A[f])`. -/
noncomputable instance finitePthPowerCoefficientAdjoinSubring_fractionRingAlgebra
    (f : PowerSeries k) :
    Algebra (FractionRing ↥A)
      (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) :=
  RingHom.toAlgebra
    (IsFractionRing.map
      (show Function.Injective
          (algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f)) from by
        intro x y h
        cases x
        cases y
        cases h
        rfl))

-- Proof sketch: the fraction field of `A[f]` is generated over `Frac(A)` by the image of `f`,
-- and that generator has its `p`th power in `Frac(A)`.
/-- The induced fraction-field extension `Frac(A) ⊆ Frac(A[f])` is purely inseparable. -/
theorem finitePthPowerCoefficientAdjoinSubring_fractionRing_isPurelyInseparable
    (f : PowerSeries k) :
    IsPurelyInseparable (FractionRing ↥A)
      (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) := by
  -- The fraction field of `A` has the same characteristic as the ambient power-series field.
  haveI : CharP k p := by
    cases (inferInstance : ExpChar k p) with
    | zero =>
        exact False.elim (Nat.not_prime_one (Fact.out : Nat.Prime 1))
    | prime _ =>
        infer_instance
  haveI : CharP (PowerSeries k) p :=
    charP_of_injective_ringHom (PowerSeries.C_injective (R := k)) p
  have hAInjective : Function.Injective (algebraMap ↥A (PowerSeries k)) := by
    intro x y h
    exact Subtype.ext h
  haveI : CharP ↥A p :=
    RingHom.charP (algebraMap ↥A (PowerSeries k)) hAInjective p
  haveI : CharP (FractionRing ↥A) p :=
    IsFractionRing.charP_of_isFractionRing ↥A p
  haveI : ExpChar (FractionRing ↥A) p := ExpChar.prime (Fact.out : p.Prime)
  -- Use the standard characteristic-`p` power criterion for purely inseparable extensions.
  rw [isPurelyInseparable_iff_pow_mem (FractionRing ↥A) p]
  intro x
  obtain ⟨a, b, hb, rfl⟩ :=
    IsFractionRing.div_surjective (finitePthPowerCoefficientAdjoinSubring k p f) x
  refine ⟨1, ?_⟩
  simp only [pow_one]
  -- Numerator and denominator have `p`th powers in `A`; their quotient is the required preimage.
  let ap : ↥A :=
    ⟨(a : PowerSeries k) ^ p,
      pow_mem_finitePthPowerCoefficientSubring k p (a : PowerSeries k)⟩
  let bp : ↥A :=
    ⟨(b : PowerSeries k) ^ p,
      pow_mem_finitePthPowerCoefficientSubring k p (b : PowerSeries k)⟩
  let y : FractionRing ↥A :=
    algebraMap ↥A (FractionRing ↥A) ap / algebraMap ↥A (FractionRing ↥A) bp
  have hap : algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f) ap = a ^ p := by
    ext
    rfl
  have hbp : algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f) bp = b ^ p := by
    ext
    rfl
  have hy_map :
      algebraMap (FractionRing ↥A)
          (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) y =
        algebraMap ↥(finitePthPowerCoefficientAdjoinSubring k p f)
            (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) (a ^ p) /
          algebraMap ↥(finitePthPowerCoefficientAdjoinSubring k p f)
            (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) (b ^ p) := by
    have hARInjective :
        Function.Injective
          (algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f)) := by
      intro x y h
      apply Subtype.ext
      exact congrArg
        (fun z : ↥(finitePthPowerCoefficientAdjoinSubring k p f) => (z : PowerSeries k)) h
    have hnonzero :
        nonZeroDivisors ↥A ≤
          (nonZeroDivisors ↥(finitePthPowerCoefficientAdjoinSubring k p f)).comap
            (algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f)) :=
      nonZeroDivisors_le_comap_nonZeroDivisors_of_injective
        (algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f)) hARInjective
    have hmap_ap :
        algebraMap (FractionRing ↥A)
            (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f))
            (algebraMap ↥A (FractionRing ↥A) ap) =
          algebraMap ↥(finitePthPowerCoefficientAdjoinSubring k p f)
            (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f))
            (algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f) ap) := by
      simpa [finitePthPowerCoefficientAdjoinSubring_fractionRingAlgebra, IsFractionRing.map] using
        (IsLocalization.map_eq
          (Q := FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f))
          (g := algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f))
          (T := nonZeroDivisors ↥(finitePthPowerCoefficientAdjoinSubring k p f)) hnonzero ap)
    have hmap_bp :
        algebraMap (FractionRing ↥A)
            (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f))
            (algebraMap ↥A (FractionRing ↥A) bp) =
          algebraMap ↥(finitePthPowerCoefficientAdjoinSubring k p f)
            (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f))
            (algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f) bp) := by
      simpa [finitePthPowerCoefficientAdjoinSubring_fractionRingAlgebra, IsFractionRing.map] using
        (IsLocalization.map_eq
          (Q := FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f))
          (g := algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f))
          (T := nonZeroDivisors ↥(finitePthPowerCoefficientAdjoinSubring k p f)) hnonzero bp)
    simp [y, hmap_ap, hmap_bp, hap, hbp]
  refine ⟨y, ?_⟩
  -- The induced fraction-field map respects quotients, and powers distribute over division.
  calc
    algebraMap (FractionRing ↥A)
        (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) y =
      algebraMap ↥(finitePthPowerCoefficientAdjoinSubring k p f)
          (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) (a ^ p) /
        algebraMap ↥(finitePthPowerCoefficientAdjoinSubring k p f)
          (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) (b ^ p) := hy_map
    _ = (algebraMap ↥(finitePthPowerCoefficientAdjoinSubring k p f)
            (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) a /
          algebraMap ↥(finitePthPowerCoefficientAdjoinSubring k p f)
            (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) b) ^ p := by
        rw [map_pow, map_pow, div_pow]

-- Proof sketch: choose coefficients in `k` whose `k^p`-span has unbounded finite-dimensional
-- subextensions, then package them into a formal power series.
/-- Helper for Chap10 Example 10 119 5: an infinite-dimensional field extension contains a
countable linearly independent family. -/
lemma exists_nat_linearIndependent_of_not_finiteDimensional
    {F E : Type*} [Field F] [Field E] [Algebra F E]
    (hnfd : ¬ FiniteDimensional F E) :
    ∃ v : ℕ → E, LinearIndependent F v := by
  classical
  let ι := Module.Basis.ofVectorSpaceIndex F E
  haveI : Infinite ι := by
    -- If the vector-space basis index were finite, the extension would be finite-dimensional.
    by_contra hnot
    haveI : Finite ι := not_infinite_iff_finite.mp hnot
    exact hnfd (Module.Finite.of_basis (Module.Basis.ofVectorSpace F E))
  let e : ℕ ↪ ι := Infinite.natEmbedding ι
  -- Pull back the canonical basis along an embedding of `ℕ` into its infinite index type.
  refine ⟨fun n ↦ Module.Basis.ofVectorSpace F E (e n), ?_⟩
  simpa [Function.comp_def] using
    (Module.Basis.ofVectorSpace F E).linearIndependent.comp e e.injective

omit [Fact p.Prime] in
/-- If `k` has infinite degree over `k^p`, then some power series does not belong to `A`. -/
lemma exists_not_mem_finitePthPowerCoefficientSubring
    (hnfd : ¬ FiniteDimensional (k^[p]) k) :
    ∃ f : PowerSeries k, f ∉ A := by
  -- Use a countable linearly independent coefficient family as the power series coefficients.
  obtain ⟨c, hc⟩ :=
    exists_nat_linearIndependent_of_not_finiteDimensional (F := k^[p]) (E := k) hnfd
  let f : PowerSeries k := PowerSeries.mk c
  refine ⟨f, ?_⟩
  intro hf
  let L := coefficientAdjoinOverPthPowers k p f
  letI : FiniteDimensional (k^[p]) L := hf
  let w : ℕ → L := fun n ↦ ⟨c n, by
    simpa [f] using coeff_mem_coefficientAdjoinOverPthPowers k p f n⟩
  have hwli : LinearIndependent (k^[p]) w := by
    -- The subtype map from the generated field to `k` sends this family back to `c`.
    apply LinearIndependent.of_comp (L.val.toLinearMap)
    simpa [Function.comp_def, w, f, PowerSeries.coeff_mk] using hc
  have hfiniteIndex : Cardinal.mk ℕ < Cardinal.aleph0 := by
    exact hwli.lt_aleph0_of_finiteDimensional
  -- A finite-dimensional field cannot contain a countably infinite linearly independent family.
  exact (not_lt_of_ge (by simp : Cardinal.aleph0 ≤ Cardinal.mk ℕ)) hfiniteIndex

