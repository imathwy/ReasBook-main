universe u v w

namespace Algebra

section

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]

/- The next two finite-cover statements are the geometric heart of the source proof. They are
proved by choosing the intermediate field generated by the finite set, constructing a finite
type model whose fraction field is that intermediate field, and clearing finitely many
denominators by one away localization. -/
/-- Helper for Chap10 Lemma 10 158 11: forgetting the scalar ring on a fraction-field subalgebra
does not change its fraction-field structure. -/
private lemma isFractionRing_restrictScalars
    {B : Type v} {L : Type w} [CommSemiring B] [Field L]
    [Algebra k B] [Algebra B L] [Algebra k L] [IsScalarTower k B L]
    (C : Subalgebra B L) [IsFractionRing C L] :
    IsFractionRing (C.restrictScalars k) L := by
  -- Proof comment: the carrier and ambient fraction field stay unchanged after restricting scalars.
  convert (inferInstance : IsFractionRing C L)

/-- Helper for Chap10 Lemma 10 158 11: the concrete away-localization stage inside an ambient
field, viewed as a `k`-subalgebra. -/
private abbrev localizationStage
    {B : Type v} {L : Type w}
    [CommRing B] [Field L] [Algebra k B] [Algebra B L] [Algebra k L] [IsScalarTower k B L]
    (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B) : Subalgebra k L :=
  (Localization.subalgebra.ofField L (Submonoid.powers g) hS).restrictScalars k

/-- Helper for Chap10 Lemma 10 158 11: the localized stage inside an intermediate field, mapped
into the ambient field `K`. -/
private abbrev mappedLocalizationStage
    {L : IntermediateField k K} {B : Subalgebra k L} [IsFractionRing B L]
    (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B) : Subalgebra k K :=
  (localizationStage (k := k) (L := L) g hS).map L.val

/-- Helper for Chap10 Lemma 10 158 11: the localization stage in an intermediate field is
canonically equivalent to its image in the ambient field. -/
private abbrev mappedLocalizationStageEquiv
    {L : IntermediateField k K} {B : Subalgebra k L} [IsFractionRing B L]
    (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B) :
    localizationStage (k := k) (L := L) g hS ≃ₐ[k]
      mappedLocalizationStage (k := k) (K := K) (L := L) g hS :=
  Subalgebra.equivMapOfInjective _ L.val Subtype.val_injective

/-- Helper for Chap10 Lemma 10 158 11: smoothness transports from an away localization to the
corresponding localization subalgebra of the ambient fraction field. -/
private lemma smoothLocalizationSubalgebra_restrictScalars
    {B : Type v} {L : Type w}
    [CommRing B] [Field L] [Algebra k B] [Algebra B L] [Algebra k L] [IsScalarTower k B L]
    [IsFractionRing B L] (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B)
    (hsmooth : Smooth k (Localization.Away g)) :
    Smooth k (localizationStage (k := k) (L := L) g hS) := by
  let C : Subalgebra B L := Localization.subalgebra.ofField L (Submonoid.powers g) hS
  let e : Localization.Away g ≃ₐ[B] C :=
    IsLocalization.algEquiv (Submonoid.powers g) (Localization.Away g) C
  letI : Smooth k (Localization.Away g) := hsmooth
  -- Proof comment: identify the image subalgebra with the abstract away localization and
  -- transport smoothness across that `k`-algebra equivalence.
  simpa [localizationStage] using
    (Smooth.of_equiv (A := Localization.Away g) (B := C) (R := k) (e.restrictScalars k))

/-- Helper for Chap10 Lemma 10 158 11: global complete intersection transports from an away
localization to the corresponding localization subalgebra of the ambient fraction field. -/
private lemma globalCompleteIntersectionLocalizationSubalgebra_restrictScalars
    {B : Type v} {L : Type v}
    [CommRing B] [Field L] [Algebra k B] [Algebra B L] [Algebra k L] [IsScalarTower k B L]
    [IsFractionRing B L] (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B)
    (hglobal : IsGlobalCompleteIntersection k (Localization.Away g)) :
    IsGlobalCompleteIntersection k (localizationStage (k := k) (L := L) g hS) := by
  let C : Subalgebra B L := Localization.subalgebra.ofField L (Submonoid.powers g) hS
  let e : Localization.Away g ≃ₐ[B] C :=
    IsLocalization.algEquiv (Submonoid.powers g) (Localization.Away g) C
  -- Proof comment: the same localization equivalence transports the global complete-intersection
  -- presentation to the concrete subalgebra of the ambient field.
  simpa [localizationStage] using
    (IsGlobalCompleteIntersection.of_algEquiv hglobal (e.restrictScalars k))

/-- Helper for Chap10 Lemma 10 158 11: the essential-finite-type witness subalgebra of a field
extension has the ambient field as its fraction field. -/
private lemma essFiniteTypeSubalgebra_isFractionRing
    {L : Type v} [Field L] [Algebra k L] [Algebra.EssFiniteType k L] :
    IsFractionRing (Algebra.EssFiniteType.subalgebra k L) L := by
  let B : Subalgebra k L := Algebra.EssFiniteType.subalgebra k L
  let S : Submonoid B := Algebra.EssFiniteType.submonoid k L
  have hinj : Function.Injective (algebraMap B L) := by
    intro x y hxy
    exact Subtype.ext hxy
  have hfaith : FaithfulSMul B L :=
    (faithfulSMul_iff_algebraMap_injective B L).mpr hinj
  letI : FaithfulSMul B L := hfaith
  refine IsFractionRing.of_field B L ?_
  intro z
  obtain ⟨⟨x, s⟩, hz⟩ := IsLocalization.surj S z
  refine ⟨x, s, ?_⟩
  have hsunit : IsUnit (algebraMap B L s) := s.2
  have hsne : algebraMap B L s ≠ 0 := by
    intro hzero
    rw [hzero] at hsunit
    exact not_isUnit_zero hsunit
  -- Proof comment: the essential-finite-type localization writes each field element as one
  -- numerator over one witness denominator.
  exact (eq_div_iff_mul_eq hsne).2 hz

/-- Helper for Chap10 Lemma 10 158 11: the generic-point localization of a domain is its fraction
ring. -/
private lemma isFractionRing_localizationAtPrime_bot
    {R : Type v} [CommRing R] [IsDomain R] :
    IsFractionRing R (Localization.AtPrime (⊥ : Ideal R)) := by
  have hloc :
      IsLocalization (nonZeroDivisors R) (Localization.AtPrime (⊥ : Ideal R)) := by
    -- Proof comment: at the zero prime of a domain, the prime complement is exactly the
    -- non-zero-divisors.
    convert
      (inferInstance :
        IsLocalization (⊥ : Ideal R).primeCompl (Localization.AtPrime (⊥ : Ideal R)))
    ext r
    simp [Ideal.primeCompl]
  exact hloc

/-- Helper for Chap10 Lemma 10 158 11: the generic-point localization of the essential-finite-type
witness subalgebra is a complete intersection over `k`. -/
private lemma completeIntersectionOver_atPrimeBot_essFiniteTypeWitness
    {L : Type v} [Field L] [Algebra k L] [Algebra.EssFiniteType k L] :
    IsCompleteIntersectionOver.{u, v, w} k
      (Localization.AtPrime (⊥ : Ideal (Algebra.EssFiniteType.subalgebra k L))) := by
  let B : Subalgebra k L := Algebra.EssFiniteType.subalgebra k L
  letI : IsFractionRing B (Localization.AtPrime (⊥ : Ideal B)) :=
    isFractionRing_localizationAtPrime_bot (R := B)
  letI : Algebra.EssFiniteType k (Localization.AtPrime (⊥ : Ideal B)) := inferInstance
  -- Proof comment: the generic-point localization is a field, hence a regular local ring, so the
  -- generic stalk is automatically a complete intersection over `k`.
  simpa [B] using
    (inferInstance :
      IsCompleteIntersectionOver.{u, v, w} k (Localization.AtPrime (⊥ : Ideal B)))

/-- Helper for Chap10 Lemma 10 158 11: the generic point of the essential-finite-type witness
produces a nonzero element whose away localization is a global complete intersection. -/
private lemma exists_nonzero_globalCompleteIntersection_away_of_essFiniteTypeWitness
    {L : Type v} [Field L] [Algebra k L] [Algebra.EssFiniteType k L] :
    ∃ g : Algebra.EssFiniteType.subalgebra k L,
      g ≠ 0 ∧ IsGlobalCompleteIntersection k (Localization.Away g) := by
  let B₀ : Subalgebra k L := Algebra.EssFiniteType.subalgebra k L
  have hfracB₀ : IsFractionRing B₀ L :=
    essFiniteTypeSubalgebra_isFractionRing (k := k) (L := L)
  letI : IsFractionRing B₀ L := hfracB₀
  let q : PrimeSpectrum B₀ := ⟨⊥, Ideal.isPrime_bot⟩
  have hci :
      IsCompleteIntersectionOver.{u, v, w} k (Localization.AtPrime q.asIdeal) := by
    simpa [q, B₀] using
      completeIntersectionOver_atPrimeBot_essFiniteTypeWitness (k := k) (L := L)
  have hTFAE := completeIntersectionOver_atPrime_tfae (k := k) (S := B₀) q
  have hnear : isGlobalCompleteIntersectionNearPrime k q :=
    (hTFAE.out 0 2 rfl rfl).mp hci
  rcases hnear with ⟨g, hg, hglobal⟩
  have hg0 : g ≠ 0 := by
    -- Proof comment: at the zero prime, the complement condition is exactly nonvanishing.
    simpa [q] using hg
  exact ⟨g, hg0, hglobal⟩

/-- Helper for Chap10 Lemma 10 158 11: a finite subset of a fraction field is contained in a
single away-localization subalgebra. -/
private lemma exists_commonDenominator_localizationSubalgebra_containing_finset
    {L : Type v} [Field L] [Algebra k L]
    (B : Subalgebra k L) [IsFractionRing B L] (T : Finset L) :
    ∃ (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B),
      (T : Set L) ⊆ localizationStage (k := k) (L := L) g hS := by
  classical
  obtain ⟨m, hm⟩ :=
    exists_awayMap_range_finset
      (R := k) (Q := B) (S := L) (M := nonZeroDivisors B) T
  let g : B := m
  have hgND : g ∈ nonZeroDivisors B := m.2
  have hS : Submonoid.powers g ≤ nonZeroDivisors B := by
    intro s hs
    obtain ⟨n, rfl⟩ := hs
    exact Submonoid.pow_mem (nonZeroDivisors B) n hgND
  refine ⟨g, hS, ?_⟩
  intro x hx
  obtain ⟨y, hy⟩ := hm x hx
  -- Proof comment: unfold only once to the raw localization subalgebra membership criterion.
  change x ∈ (Localization.subalgebra.ofField L (Submonoid.powers g) hS : Subalgebra B L)
  rw [Localization.subalgebra.ofField, Subalgebra.copy_eq]
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq (Submonoid.powers g) y
  refine ⟨a, s, s.2, ?_⟩
  -- Proof comment: expand the away-lift of the chosen localization fraction into the canonical
  -- `a / s` form used by the concrete localization subalgebra.
  rw [hy]
  simp [Localization.awayLift, IsLocalization.lift_mk']

/-- Helper for Chap10 Lemma 10 158 11: an element of a finite set survives in the image of its
attached copy. -/
private lemma mem_attach_image
    {α : Type*} {β : Type*} [DecidableEq α] [DecidableEq β]
    (E : Finset α) (f : { x // x ∈ E } → β) {x : α} (hx : x ∈ E) :
    f ⟨x, hx⟩ ∈ E.attach.image f := by
  -- Proof comment: the attached copy of `x` is the canonical witness for the image membership.
  refine Finset.mem_image.2 ?_
  refine ⟨⟨x, hx⟩, ?_, rfl⟩
  simp

/-- Helper for Chap10 Lemma 10 158 11: a finite-set element belongs to every intermediate field
that contains the whole finite set. -/
private lemma mem_intermediateField_of_subset
    (E : Finset K) (L : IntermediateField k K) (hLE : (E : Set K) ⊆ L)
    {x : K} (hx : x ∈ E) :
    x ∈ L := by
  -- Proof comment: convert finite-set membership to set membership and apply the ambient subset.
  exact hLE (by simpa using hx)

/-- Helper for Chap10 Lemma 10 158 11: the canonical lift of the attached copy of a finite set
into an intermediate field containing that finite set. -/
private abbrev liftToIntermediateField
    (E : Finset K) (L : IntermediateField k K) (hLE : (E : Set K) ⊆ L) :
    { x // x ∈ E } → L :=
  fun x ↦ ⟨x.1, mem_intermediateField_of_subset (k := k) E L hLE x.2⟩

/-- Helper for Chap10 Lemma 10 158 11: the finite subset of an intermediate field obtained by
lifting all elements of `E`. -/
private abbrev liftedFiniteSet
    (E : Finset K) (L : IntermediateField k K) (hLE : (E : Set K) ⊆ L) :
    Finset L :=
  E.attach.image (liftToIntermediateField (k := k) E L hLE)

/-- Helper for Chap10 Lemma 10 158 11: global complete-intersection structure on an away
localization transports all the way to the mapped localization stage inside `K`. -/
private lemma globalCompleteIntersection_mappedLocalizationStage
    {L : IntermediateField k K} {B : Subalgebra k L} [IsFractionRing B L]
    (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B)
    (hglobal : IsGlobalCompleteIntersection k (Localization.Away g)) :
    IsGlobalCompleteIntersection k
      (mappedLocalizationStage (k := k) (K := K) (L := L) g hS) := by
  have hStage :
      IsGlobalCompleteIntersection k (localizationStage (k := k) (L := L) g hS) :=
    globalCompleteIntersectionLocalizationSubalgebra_restrictScalars
      (k := k) (B := B) (L := L) g hS hglobal
  -- Proof comment: transport once from the concrete stage in `L` to its image in `K`.
  exact IsGlobalCompleteIntersection.of_algEquiv hStage
    (mappedLocalizationStageEquiv (k := k) (K := K) (L := L) g hS)

/-- Helper for Chap10 Lemma 10 158 11: smoothness on an away localization transports all the way
to the mapped localization stage inside `K`. -/
private lemma smooth_mappedLocalizationStage
    {L : IntermediateField k K} {B : Subalgebra k L} [IsFractionRing B L]
    (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B)
    (hsmooth : Smooth k (Localization.Away g)) :
    Smooth k (mappedLocalizationStage (k := k) (K := K) (L := L) g hS) := by
  have hStage : Smooth k (localizationStage (k := k) (L := L) g hS) :=
    smoothLocalizationSubalgebra_restrictScalars
      (k := k) (B := B) (L := L) g hS hsmooth
  -- Proof comment: as in the complete-intersection branch, move the property through the
  -- canonical equivalence to the image stage in `K`.
  exact Smooth.of_equiv
    (mappedLocalizationStageEquiv (k := k) (K := K) (L := L) g hS)

/-- Helper for Chap10 Lemma 10 158 11: if the lifted finite subset lies in the localization stage
inside `L`, then the original finite subset lies in the mapped stage inside `K`. -/
private lemma subset_mappedLocalizationStage_of_lifted_subset
    (E : Finset K) (L : IntermediateField k K) (hLE : (E : Set K) ⊆ L)
    {B : Subalgebra k L} [IsFractionRing B L]
    (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B)
    (hT : (liftedFiniteSet (k := k) E L hLE : Set L) ⊆
      localizationStage (k := k) (L := L) g hS) :
    (E : Set K) ⊆ mappedLocalizationStage (k := k) (K := K) (L := L) g hS := by
  intro x hx
  have hxE : x ∈ E := by
    simpa using hx
  let xL : L := ⟨x, mem_intermediateField_of_subset (k := k) E L hLE hxE⟩
  have hxT : xL ∈ liftedFiniteSet (k := k) E L hLE := by
    -- Proof comment: the attached representative of `x` lands in the lifted finite set by design.
    simpa [liftedFiniteSet, liftToIntermediateField, xL] using
      (mem_attach_image
        (E := E) (f := liftToIntermediateField (k := k) E L hLE) (x := x) hxE)
  have hxStage : xL ∈ localizationStage (k := k) (L := L) g hS := hT hxT
  -- Proof comment: map the stage element from `L` into `K` using the intermediate-field inclusion.
  exact (Subalgebra.mem_map).2 ⟨xL, hxStage, rfl⟩

/-- Helper for Chap10 Lemma 10 158 11: the concrete localization stage still has the ambient field
as its fraction field. -/
private lemma isFractionRing_localizationStage
    {B : Type v} {L : Type w}
    [CommRing B] [Field L] [Algebra k B] [Algebra B L] [Algebra k L] [IsScalarTower k B L]
    [IsFractionRing B L] (g : B) (hS : Submonoid.powers g ≤ nonZeroDivisors B) :
    IsFractionRing (localizationStage (k := k) (L := L) g hS) L := by
  -- Proof comment: this is exactly the previously proved restriction-of-scalars fraction-field fact.
  simpa [localizationStage] using
    (isFractionRing_restrictScalars (k := k) (B := B) (L := L)
      (Localization.subalgebra.ofField L (Submonoid.powers g) hS))

/-- Helper for Chap10 Lemma 10 158 11: an essentially-finite-type field extension admits a
global complete-intersection subalgebra whose fraction field is the ambient field. -/
private lemma exists_globalCompleteIntersection_subalgebra_fractionRing_of_essFiniteType_field
    {L : Type v} [Field L] [Algebra k L] [Algebra.EssFiniteType k L] :
    ∃ B : Subalgebra k L, IsGlobalCompleteIntersection k B ∧ IsFractionRing B L := by
  let B₀ : Subalgebra k L := Algebra.EssFiniteType.subalgebra k L
  have hfracB₀ : IsFractionRing B₀ L :=
    essFiniteTypeSubalgebra_isFractionRing (k := k) (L := L)
  letI : IsFractionRing B₀ L := hfracB₀
  obtain ⟨g, hg0, hglobal⟩ :=
    exists_nonzero_globalCompleteIntersection_away_of_essFiniteTypeWitness
      (k := k) (L := L)
  have hS : Submonoid.powers g ≤ nonZeroDivisors B₀ := by
    intro s hs
    rw [mem_nonZeroDivisors_iff_ne_zero]
    obtain ⟨n, rfl⟩ := hs
    exact pow_ne_zero n hg0
  let A₀ : Subalgebra k L := localizationStage (k := k) (L := L) g hS
  have hA₀global : IsGlobalCompleteIntersection k A₀ :=
    globalCompleteIntersectionLocalizationSubalgebra_restrictScalars
      (k := k) (B := B₀) (L := L) g hS hglobal
  have hA₀frac : IsFractionRing A₀ L :=
    isFractionRing_localizationStage (k := k) (B := B₀) (L := L) g hS
  -- Proof comment: the generic complete-intersection chart is realized inside the ambient field
  -- as the concrete localization subalgebra.
  exact ⟨A₀, hA₀global, hA₀frac⟩

/-- Helper for Chap10 Lemma 10 158 11: every finite subset of a field extension is contained in a
global complete-intersection subalgebra. -/
lemma exists_globalCompleteIntersection_subalgebra_containing_finset
    (E : Finset K) :
    ∃ A : Subalgebra k K, IsGlobalCompleteIntersection k A ∧ (E : Set K) ⊆ A := by
  classical
  let L : IntermediateField k K := IntermediateField.adjoin k (E : Set K)
  have hLE : (E : Set K) ⊆ L := IntermediateField.subset_adjoin k (E : Set K)
  let T : Finset L := liftedFiniteSet (k := k) E L hLE
  letI : Algebra.EssFiniteType k L := finite_adjoin_stage_essFiniteType (k := k) (K := K) E
  obtain ⟨B, hBglobal, hBfrac⟩ :=
    exists_globalCompleteIntersection_subalgebra_fractionRing_of_essFiniteType_field
      (k := k) (L := L)
  letI : IsFractionRing B L := hBfrac
  obtain ⟨g, hS, hT⟩ :=
    exists_commonDenominator_localizationSubalgebra_containing_finset
      (k := k) B T
  let A : Subalgebra k K := mappedLocalizationStage (k := k) (K := K) (L := L) g hS
  -- Route correction: use the explicit localized GCI fact instead of asking instance search to
  -- recover it through the away-localization transport.
  have hAwayGCI : IsGlobalCompleteIntersection k (Localization.Away g) :=
    IsGlobalCompleteIntersection.of_isLocalizationAway g hBglobal
  have hAglobal : IsGlobalCompleteIntersection k A :=
    -- Proof comment: use the shared transport helper so the branch stays in one spelling world.
    globalCompleteIntersection_mappedLocalizationStage
      (k := k) (K := K) (L := L) g hS hAwayGCI
  refine ⟨A, hAglobal, ?_⟩
  -- Proof comment: containment is now the shared lifted-finset argument.
  exact subset_mappedLocalizationStage_of_lifted_subset
    (k := k) (K := K) E L hLE g hS hT

/-- Helper for Chap10 Lemma 10 158 11: under Stacks-project separability, every finite subset is
contained in a smooth subalgebra. -/
lemma exists_smooth_subalgebra_containing_finset_of_isSeparableOver
    [IsSeparableOver k K] (E : Finset K) :
    ∃ A : Subalgebra k K, Smooth k A ∧ (E : Set K) ⊆ A := by
  classical
  let L : IntermediateField k K := IntermediateField.adjoin k (E : Set K)
  have hLE : (E : Set K) ⊆ L := IntermediateField.subset_adjoin k (E : Set K)
  let T : Finset L := liftedFiniteSet (k := k) E L hLE
  letI : Algebra.EssFiniteType k L := finite_adjoin_stage_essFiniteType (k := k) (K := K) E
  letI : IsSeparableOver k L := IsSeparableOver.of_intermediateField inferInstance L
  -- Route correction: reuse the earlier smooth-model theorem instead of rebuilding the full
  -- formal-smoothness chain inside this item file.
  obtain ⟨B, hBsmooth, hBfrac⟩ :=
    (Algebra.isSeparableOver_iff_exists_smooth_domain_with_fractionRing
      (k := k) (K := L)).1 inferInstance
  letI : Smooth k B := hBsmooth
  letI : IsFractionRing B L := hBfrac
  obtain ⟨g, hS, hT⟩ :=
    exists_commonDenominator_localizationSubalgebra_containing_finset
      (k := k) B T
  let A : Subalgebra k K := mappedLocalizationStage (k := k) (K := K) (L := L) g hS
  have hAwaySmooth : Smooth k (Localization.Away g) := by
    -- Proof comment: smoothness of `B` passes to the away localization by the standard
    -- localization theorem, avoiding brittle instance reconstruction.
    simpa using Algebra.smooth_localization_away_target (R := k) (S := B) g
  have hAsmooth : Smooth k A :=
    -- Proof comment: use the shared smooth transport helper instead of rebuilding the equivalence.
    smooth_mappedLocalizationStage
      (k := k) (K := K) (L := L) g hS hAwaySmooth
  refine ⟨A, hAsmooth, ?_⟩
  -- Proof comment: the finite-set containment is identical to the global-CI branch.
  exact subset_mappedLocalizationStage_of_lifted_subset
    (k := k) (K := K) E L hLE g hS hT

end

end Algebra
