import Mathlib
import StacksProject_2024.Chap10.Lemma_10_115_2

-- Declarations for this item will be appended below by the statement pipeline.

open MvPolynomial
open scoped TensorProduct

universe u

section

variable {A : Type u} [CommRing A]
variable {k : Type u} [Field k]
variable {n : ℕ}

/-- The coordinate ideal generated by the variables `X i` with `r ≤ i.1`, corresponding to the
textbook ideal `(y_{r + 1}, \ldots, y_n)` in `k[y_1, \ldots, y_n]`. -/
noncomputable def tailVariablesIdeal (A : Type u) [CommRing A] (n r : ℕ) :
    Ideal (MvPolynomial (Fin n) A) :=
  Ideal.span {f | ∃ i : Fin n, r ≤ i.1 ∧ f = (X i : MvPolynomial (Fin n) A)}

-- Proof sketch: unfold `tailVariablesIdeal`; the statement is exactly its defining equation.
/-- Unfolding `tailVariablesIdeal` identifies it with the span of the tail coordinate variables. -/
theorem tailVariablesIdeal_def (A : Type u) [CommRing A] (n r : ℕ) :
    tailVariablesIdeal A n r =
      Ideal.span {f | ∃ i : Fin n, r ≤ i.1 ∧ f = (X i : MvPolynomial (Fin n) A)} :=
  rfl

/-- Helper for Lemma 10.115.6: if the tail starts at or beyond the number of variables, then the
tail-variable ideal is zero. -/
theorem tailVariablesIdeal_eq_bot_of_le (h : n ≤ r) :
    tailVariablesIdeal A n r = ⊥ := by
  -- Unfold the ideal and show that no generator can exist once `r` is past the last index.
  rw [tailVariablesIdeal_def, Ideal.span_eq_bot]
  intro f hf
  rcases hf with ⟨i, hi, rfl⟩
  exact False.elim <| (Nat.not_le_of_lt i.2) (le_trans h hi)

/-- Helper for Lemma 10.115.6: over a domain, the residue field at the zero prime is canonically
the fraction field. -/
noncomputable def botResidueFieldAlgEquiv (S : Type u) [CommRing S] [IsDomain S] :
    FractionRing S ≃ₐ[S] ((⊥ : Ideal S).ResidueField) := by
  let e : S ≃ₐ[S] S ⧸ (⊥ : Ideal S) := (AlgEquiv.quotientBot S S).symm
  letI : IsFractionRing S ((⊥ : Ideal S).ResidueField) := by
    refine IsFractionRing.of_ringEquiv_left e.toRingEquiv ?_
    intro x
    change algebraMap S ((⊥ : Ideal S).ResidueField) x =
      algebraMap (S ⧸ (⊥ : Ideal S)) ((⊥ : Ideal S).ResidueField) (Ideal.Quotient.mk _ x)
    symm
    rfl
  exact FractionRing.algEquiv S ((⊥ : Ideal S).ResidueField)

/-- Helper for Lemma 10.115.6: the residue field of the zero prime in
`k[x_1, \ldots, x_n]` has transcendence degree `n` over `k`. -/
theorem trdeg_residueField_bot_mvPolynomial :
    Cardinal.toNat
        (Algebra.trdeg k ((⊥ : Ideal (MvPolynomial (Fin n) k)).ResidueField)) = n := by
  let S := MvPolynomial (Fin n) k
  let e : FractionRing S ≃ₐ[k] ((⊥ : Ideal S).ResidueField) :=
    AlgEquiv.restrictScalars k (botResidueFieldAlgEquiv (S := S))
  have h_alg : Algebra.IsAlgebraic S (FractionRing S) := by
    -- The fraction field is algebraic over the base domain, so its relative transcendence degree
    -- over `S` vanishes.
    exact
      (IsFractionRing.comap_isAlgebraic_iff (A := S) (K := FractionRing S)
        (C := FractionRing S)).mpr
        (inferInstance : Algebra.IsAlgebraic (FractionRing S) (FractionRing S))
  have htrdeg_frac : Algebra.trdeg k (FractionRing S) = Algebra.trdeg k S := by
    -- Split the extension `k ⟶ S ⟶ FractionRing S` and kill the top term by algebraicity.
    have hadd := trdeg_add_eq (R := k) (S := S) (A := FractionRing S)
    have hz : Algebra.trdeg S (FractionRing S) = 0 := trdeg_eq_zero (R := S) (A := FractionRing S)
    simpa [hz] using hadd.symm
  -- Transport the computation from the fraction field back to the zero-prime residue field.
  calc
    Cardinal.toNat (Algebra.trdeg k ((⊥ : Ideal S).ResidueField))
        = Cardinal.toNat (Algebra.trdeg k (FractionRing S)) := by
            simpa using congrArg Cardinal.toNat (AlgEquiv.trdeg_eq (R := k) e).symm
    _ = Cardinal.toNat (Algebra.trdeg k S) := by
      rw [htrdeg_frac]
    _ = Cardinal.toNat (Algebra.trdeg k (MvPolynomial (Fin n) k)) := by
      rfl
    _ = n := by
      rw [MvPolynomial.trdeg_of_isDomain, Cardinal.toNat_lift, Cardinal.mk_fin,
        Cardinal.toNat_natCast]

/-- Helper for Lemma 10.115.6: for the zero prime, the identity endomorphism already contracts to
the required tail ideal. -/
theorem exists_finite_selfAlgHom_comap_eq_tailVariablesIdeal_of_bot :
    ∃ φ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k,
      φ.Finite ∧
        Ideal.comap φ (⊥ : Ideal (MvPolynomial (Fin n) k)) =
          tailVariablesIdeal k n
            (Cardinal.toNat
              (Algebra.trdeg k ((⊥ : Ideal (MvPolynomial (Fin n) k)).ResidueField))) := by
  refine ⟨AlgHom.id k _, ?_, ?_⟩
  · simpa using (AlgHom.Finite.id (R := k) (A := MvPolynomial (Fin n) k))
  · -- The generic point has full transcendence degree, so the target tail ideal is zero.
    rw [Ideal.comap_idₐ, trdeg_residueField_bot_mvPolynomial]
    exact (tailVariablesIdeal_eq_bot_of_le (A := k) (n := n) (r := n) le_rfl).symm

/-- Helper for Lemma 10.115.6: a nonzero element of a prime ideal cannot be a constant
polynomial. -/
private lemma not_exists_eq_C_of_mem_prime
    {I : Ideal (MvPolynomial (Fin (n + 1)) k)} [I.IsPrime]
    {f : MvPolynomial (Fin (n + 1)) k} (hf_mem : f ∈ I) (hf_ne_zero : f ≠ 0) :
    ¬ ∃ a : k, f = C a := by
  intro hconst
  rcases hconst with ⟨a, rfl⟩
  have ha_ne_zero : a ≠ 0 := by
    -- A zero constant would contradict the chosen nonzero element.
    intro ha
    apply hf_ne_zero
    simp [ha]
  have hunit : IsUnit (C a : MvPolynomial (Fin (n + 1)) k) := by
    exact (MvPolynomial.isUnit_iff_eq_C_of_isReduced).2
      ⟨a, isUnit_iff_ne_zero.mpr ha_ne_zero, rfl⟩
  exact (Ideal.IsPrime.ne_top (I := I) inferInstance) (Ideal.eq_top_of_isUnit_mem I hf_mem hunit)

/-- Helper for Lemma 10.115.6: geometric weights dominate any prescribed tail spread after
normalizing the last weight to `1`. -/
private lemma exists_tail_dominating_weights (spread : Fin (n + 1) → ℕ) :
    ∃ w : Fin (n + 1) → ℕ,
      w (Fin.last n) = 1 ∧
        ∀ i : Fin (n + 1),
          w i >
            Finset.sum (Finset.univ.filter fun j : Fin (n + 1) ↦ i < j)
              (fun j ↦ spread j * w j) := by
  let B : ℕ := Finset.univ.sum spread + 1
  refine ⟨fun i ↦ B ^ (n - i.1), ?_, ?_⟩
  · -- The last coordinate contributes exponent `0`, so its weight is exactly `1`.
    simp [B]
  · intro i
    cases i using Fin.lastCases with
    | last =>
        -- There are no indices larger than the last one, so the domination inequality is trivial.
        have hfilter :
            Finset.univ.filter fun j : Fin (n + 1) ↦ Fin.last n < j = ∅ := by
          ext j
          simp [Fin.not_lt.2 j.le_last]
        simp [B, hfilter]
    | cast i =>
        let d : ℕ := n - (i.1 + 1)
        have hB_pos : 0 < B := Nat.succ_pos _
        have hB_one : 1 ≤ B := Nat.succ_le_of_lt hB_pos
        have hpow_pos : 0 < B ^ d := Nat.pow_pos hB_pos
        have hsum_bound :
            Finset.sum (Finset.univ.filter fun j : Fin (n + 1) ↦ Fin.castSucc i < j)
                (fun j ↦ spread j * B ^ (n - j.1)) ≤
              Finset.sum (Finset.univ.filter fun j : Fin (n + 1) ↦ Fin.castSucc i < j)
                (fun j ↦ spread j * B ^ d) := by
          -- Replace each tail power by the common upper bound `B ^ d`.
          refine Finset.sum_le_sum fun j hj ↦ ?_
          have hij : i.1 < j.1 := by
            simpa using (Finset.mem_filter.mp hj).2
          have hsub : n - j.1 ≤ d := by
            omega
          exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_right hB_one hsub)
        have hfilter_le :
            Finset.sum (Finset.univ.filter fun j : Fin (n + 1) ↦ Fin.castSucc i < j) spread ≤
              Finset.univ.sum spread := by
          -- Dropping the filter only enlarges the nonnegative sum.
          refine Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) ?_
          intro j _ _
          exact Nat.zero_le _
        have hlt_base :
            (Finset.univ.sum spread) * B ^ d < B * B ^ d := by
          refine Nat.mul_lt_mul_of_pos_right ?_ hpow_pos
          simp [B]
        have hpow_succ : B ^ (n - i.1) = B * B ^ d := by
          have hexp : n - i.1 = d + 1 := by
            omega
          rw [hexp, Nat.pow_succ]
          ring
        -- The tail sum is bounded by the total spread times the next smaller power of `B`.
        calc
          Finset.sum (Finset.univ.filter fun j : Fin (n + 1) ↦ Fin.castSucc i < j)
              (fun j ↦ spread j * B ^ (n - j.1))
              ≤
              Finset.sum (Finset.univ.filter fun j : Fin (n + 1) ↦ Fin.castSucc i < j)
                (fun j ↦ spread j * B ^ d) := hsum_bound
          _ = Finset.sum (Finset.univ.filter fun j : Fin (n + 1) ↦ Fin.castSucc i < j) spread *
                B ^ d := by
                rw [← Finset.sum_mul]
          _ ≤ (Finset.univ.sum spread) * B ^ d := Nat.mul_le_mul_right _ hfilter_le
          _ < B * B ^ d := hlt_base
          _ = B ^ (n - i.1) := hpow_succ.symm

/-- Helper for Lemma 10.115.6: a nonzero polynomial admits dominating weights for the triangular
shear used in the source proof. -/
theorem exists_dominating_weights_of_ne_zero
    (f : MvPolynomial (Fin (n + 1)) k) (hf : f ≠ 0) :
    ∃ e : Fin n → ℕ, noetherNormalizationDominatingWeights f e := by
  let spread : Fin (n + 1) → ℕ := fun i ↦
    (f.support.product f.support).sup fun m ↦ m.1 i - m.2 i
  obtain ⟨w, hw_last, hw_dom⟩ := exists_tail_dominating_weights (n := n) spread
  let e : Fin n → ℕ := fun i ↦ w i.castSucc
  have hsnoc : Fin.snoc e 1 = w := by
    ext i
    cases i using Fin.lastCases with
    | cast i =>
        simp [Fin.snoc, e]
    | last =>
        simpa [Fin.snoc, e] using hw_last.symm
  refine ⟨e, ?_⟩
  -- Route correction: before using Lemma `10.115.2`, freeze an explicit dominating weight vector.
  refine ⟨MvPolynomial.support_nonempty.mpr hf, ?_⟩
  intro i
  simpa [noetherNormalizationDominatingWeights, spread, e, hsnoc] using hw_dom i

/-- Helper for Lemma 10.115.6: once a polynomial ideal contains the last variable `X`, every
element splits into a constant part from the contracted coefficient ideal plus an `X`-multiple. -/
theorem prime_containing_X_eq_map_comap_C_sup_span_X
    (Q : Ideal (Polynomial A)) (hX : Polynomial.X ∈ Q) :
    Q = Ideal.map Polynomial.C (Ideal.comap Polynomial.C Q) ⊔
      Ideal.span ({Polynomial.X} : Set (Polynomial A)) := by
  refine le_antisymm ?_ ?_
  · intro f hf
    have hX_multiple :
        Polynomial.divX f * Polynomial.X ∈ Ideal.span ({Polynomial.X} : Set (Polynomial A)) := by
      -- The `X`-multiple lands in the principal ideal generated by `X`.
      refine Ideal.mul_mem_left _ _ ?_
      exact Ideal.subset_span (by simp)
    have hconstant_mem_Q : Polynomial.C (f.coeff 0) ∈ Q := by
      -- Subtract the `X`-multiple from `f` using the standard `divX` decomposition.
      have hmul_mem_Q : Polynomial.divX f * Polynomial.X ∈ Q :=
        Ideal.mul_mem_left _ _ hX
      have hsub_mem_Q : f - Polynomial.divX f * Polynomial.X ∈ Q :=
        Q.sub_mem hf hmul_mem_Q
      have hconstant_eq : Polynomial.C (f.coeff 0) = f - Polynomial.divX f * Polynomial.X := by
        rw [eq_sub_iff_add_eq, add_comm]
        simpa [add_comm] using Polynomial.divX_mul_X_add f
      simpa [hconstant_eq]
        using hsub_mem_Q
    have hconstant_mem_comap : f.coeff 0 ∈ Ideal.comap Polynomial.C Q := hconstant_mem_Q
    have hconstant_mem_map :
        Polynomial.C (f.coeff 0) ∈ Ideal.map Polynomial.C (Ideal.comap Polynomial.C Q) :=
      Ideal.mem_map_of_mem Polynomial.C hconstant_mem_comap
    -- Reassemble `f` from its constant term and `X`-multiple inside the stated supremum.
    rw [← Polynomial.divX_mul_X_add f]
    have hX_multiple_sup :
        Polynomial.divX f * Polynomial.X ∈
          Ideal.map Polynomial.C (Ideal.comap Polynomial.C Q) ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial A)) :=
      (show Ideal.span ({Polynomial.X} : Set (Polynomial A)) ≤
          Ideal.map Polynomial.C (Ideal.comap Polynomial.C Q) ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial A)) from le_sup_right) hX_multiple
    have hconstant_sup :
        Polynomial.C (f.coeff 0) ∈
          Ideal.map Polynomial.C (Ideal.comap Polynomial.C Q) ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial A)) :=
      (show Ideal.map Polynomial.C (Ideal.comap Polynomial.C Q) ≤
          Ideal.map Polynomial.C (Ideal.comap Polynomial.C Q) ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial A)) from le_sup_left) hconstant_mem_map
    exact Ideal.add_mem _ hX_multiple_sup hconstant_sup
  · -- Each summand is visibly contained in `Q`.
    refine sup_le ?_ ?_
    · exact Ideal.map_le_of_le_comap le_rfl
    · rw [Ideal.span_le]
      rintro f (rfl : f = Polynomial.X)
      exact hX

/-- Helper for Lemma 10.115.6: substituting a monic polynomial of positive degree for the last
variable produces a finite endomorphism of `A[X]`. -/
theorem finite_last_variable_substitution_of_monic [Nontrivial A] {p : Polynomial A} (hp : p.Monic)
    (hdeg : 0 < p.natDegree) :
    (Polynomial.aeval p : Polynomial A →ₐ[A] Polynomial A).Finite := by
  let f : Polynomial A →ₐ[A] Polynomial A := Polynomial.aeval p
  letI : Algebra (Polynomial A) (Polynomial A) := f.toRingHom.toAlgebra
  have hroot :
      IsIntegral (Polynomial A) (Polynomial.X : Polynomial A) := by
    -- The target generator `X` satisfies the monic relation `p(Z) - X` over the source ring.
    refine ⟨p.map Polynomial.C - Polynomial.C Polynomial.X, ?_, ?_⟩
    · -- Subtracting a constant term preserves monicity.
      refine (hp.map Polynomial.C).sub_of_left ?_
      refine lt_of_le_of_lt Polynomial.degree_C_le ?_
      have hmapdeg : 0 < (p.map Polynomial.C).natDegree := by
        rw [hp.natDegree_map Polynomial.C]
        exact hdeg
      rw [Polynomial.degree_eq_natDegree (Polynomial.Monic.ne_zero (hp.map Polynomial.C))]
      exact_mod_cast hmapdeg
    · -- Evaluating the relation at the target generator gives `p(X) - f(X) = 0`.
      change Polynomial.eval₂ (algebraMap (Polynomial A) (Polynomial A)) Polynomial.X
          (p.map Polynomial.C - Polynomial.C Polynomial.X) = 0
      have hcoeff :
          ((algebraMap (Polynomial A) (Polynomial A)).comp Polynomial.C : A →+* Polynomial A) =
            Polynomial.C := by
        apply RingHom.ext
        intro a
        exact f.commutes a
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_map]
      rw [hcoeff, Polynomial.eval₂_C_X]
      rw [Polynomial.eval₂_C]
      have hX : algebraMap (Polynomial A) (Polynomial A) Polynomial.X = p := by
        change f Polynomial.X = p
        simp [f]
      simpa [hX]
  have hadjoin :
      Algebra.adjoin (Polynomial A) ({Polynomial.X} : Set (Polynomial A)) = ⊤ := by
    -- Every target polynomial already lies in the source-algebra generated by the single element `X`.
    apply Algebra.eq_top_iff.2
    intro q
    refine Polynomial.induction_on' q ?_ ?_
    · intro q₁ q₂ hq₁ hq₂
      exact Subalgebra.add_mem _ hq₁ hq₂
    · intro n a
      have hC :
          Polynomial.C a ∈ Algebra.adjoin (Polynomial A) ({Polynomial.X} : Set (Polynomial A)) := by
        have hCa :
            algebraMap (Polynomial A) (Polynomial A) (Polynomial.C a) = Polynomial.C a := by
          change f (Polynomial.C a) = Polynomial.C a
          exact f.commutes a
        have hbase :
            algebraMap (Polynomial A) (Polynomial A) (Polynomial.C a) ∈
              Algebra.adjoin (Polynomial A) ({Polynomial.X} : Set (Polynomial A)) :=
          (Algebra.adjoin (Polynomial A) ({Polynomial.X} : Set (Polynomial A))).algebraMap_mem
            (Polynomial.C a)
        exact hCa ▸ hbase
      have hX :
          Polynomial.X ∈ Algebra.adjoin (Polynomial A) ({Polynomial.X} : Set (Polynomial A)) :=
        Algebra.subset_adjoin (by simp)
      simpa [Polynomial.C_mul_X_pow_eq_monomial] using
        Subalgebra.mul_mem _ hC (Subalgebra.pow_mem _ hX n)
  have hfinite_top : Module.Finite (Polynomial A) (Polynomial A) := by
    -- Transport finiteness from the adjoin subtype along the canonical top-subalgebra equivalence.
    letI :
        Module.Finite (Polynomial A)
          (Algebra.adjoin (Polynomial A) ({Polynomial.X} : Set (Polynomial A))) :=
      Algebra.finite_adjoin_simple_of_isIntegral hroot
    letI :
        Module.Finite (Polynomial A) (⊤ : Subalgebra (Polynomial A) (Polynomial A)) :=
      Module.Finite.equiv
        (Subalgebra.equivOfEq _ _ hadjoin).toLinearEquiv
    exact Module.Finite.equiv
      (Subalgebra.topEquiv : (⊤ : Subalgebra (Polynomial A) (Polynomial A)) ≃ₐ[Polynomial A]
        Polynomial A).toLinearEquiv
  simpa [AlgHom.Finite, RingHom.Finite] using hfinite_top

/-- Helper for Lemma 10.115.6: a nonzero element of a prime ideal can be sheared so that, after
viewing the ring as a polynomial ring in the last variable, it becomes a monic polynomial whose
substitution map is finite. -/
theorem exists_monic_last_variable_substitution_data
    {m : ℕ} (q : Ideal (MvPolynomial (Fin (m + 1)) k)) [q.IsPrime]
    {g : MvPolynomial (Fin (m + 1)) k} (hgq : g ∈ q) (hg0 : g ≠ 0) :
    ∃ e : Fin m → ℕ, ∃ p : Polynomial (MvPolynomial (Fin m) k),
      let σ : MvPolynomial (Fin (m + 1)) k ≃ₐ[k] MvPolynomial (Fin (m + 1)) k :=
        noetherNormalizationShear e
      let q' : Ideal (MvPolynomial (Fin (m + 1)) k) := Ideal.comap σ.symm.toAlgHom q
      let qA : Ideal (Polynomial (MvPolynomial (Fin m) k)) :=
        Ideal.comap
          ((noetherNormalizationLastVariableEquiv :
            MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom)
          q'
      p ∈ qA ∧ p.Monic ∧ 0 < p.natDegree ∧
        (Polynomial.aeval p :
          Polynomial (MvPolynomial (Fin m) k) →ₐ[MvPolynomial (Fin m) k]
            Polynomial (MvPolynomial (Fin m) k)).Finite := by
  have hconst : ¬ ∃ a : k, g = C a :=
    not_exists_eq_C_of_mem_prime (I := q) hgq hg0
  obtain ⟨e, he_dom⟩ := exists_dominating_weights_of_ne_zero (n := m) g hg0
  let p0 : Polynomial (MvPolynomial (Fin m) k) := noetherNormalizationLastVariablePolynomial e g
  obtain ⟨hp0_deg, a, hp0_lc, m0, hm0_support, hm0_coeff⟩ :=
    exists_positive_natDegree_and_constant_leadingCoeff_of_noetherNormalizationLastVariablePolynomial
      g hconst e he_dom
  have ha_ne_zero : a ≠ 0 := by
    -- The top coefficient comes from a support monomial, so it is nonzero.
    intro ha
    exact (mem_support_iff.mp hm0_support) (hm0_coeff.trans ha)
  let p : Polynomial (MvPolynomial (Fin m) k) := Polynomial.C (MvPolynomial.C a⁻¹) * p0
  have hp0_mem :
      p0 ∈ Ideal.comap
        ((noetherNormalizationLastVariableEquiv :
          MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom)
        (Ideal.comap (noetherNormalizationShear e).symm.toAlgHom q) := by
    -- Unfolding the sheared last-variable polynomial brings the goal back to `g ∈ q`.
    simpa [p0, noetherNormalizationLastVariablePolynomial]
      using hgq
  have hp_mem :
      p ∈ Ideal.comap
        ((noetherNormalizationLastVariableEquiv :
          MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom)
        (Ideal.comap (noetherNormalizationShear e).symm.toAlgHom q) := by
    -- Scaling by a coefficient polynomial preserves membership in the contracted ideal.
    exact Ideal.mul_mem_left _ _ hp0_mem
  have hp0_ne_zero : p0 ≠ 0 := by
    -- A polynomial of positive degree cannot vanish.
    intro hp0_zero
    simpa [p0, hp0_zero] using hp0_deg
  have hCinv_ne_zero : (MvPolynomial.C a⁻¹ : MvPolynomial (Fin m) k) ≠ 0 := by
    -- The inverse scalar stays nonzero after embedding into the coefficient ring.
    simpa using (inv_ne_zero ha_ne_zero : a⁻¹ ≠ 0)
  have hp_monic : p.Monic := by
    -- The chosen scalar normalizes the constant leading coefficient to `1`.
    rw [Polynomial.Monic.def]
    change (Polynomial.C (MvPolynomial.C a⁻¹) * p0).leadingCoeff = 1
    rw [Polynomial.leadingCoeff, Polynomial.natDegree_C_mul hCinv_ne_zero, Polynomial.coeff_C_mul]
    change MvPolynomial.C a⁻¹ * p0.leadingCoeff = 1
    rw [hp0_lc]
    rw [← MvPolynomial.C_mul, inv_mul_cancel₀ ha_ne_zero, MvPolynomial.C_1]
  have hp_deg : 0 < p.natDegree := by
    -- Multiplying by a nonzero constant polynomial does not change the degree.
    change 0 < (Polynomial.C (MvPolynomial.C a⁻¹) * p0).natDegree
    rw [Polynomial.natDegree_C_mul hCinv_ne_zero]
    exact hp0_deg
  have hp_finite :
      (Polynomial.aeval p :
        Polynomial (MvPolynomial (Fin m) k) →ₐ[MvPolynomial (Fin m) k]
          Polynomial (MvPolynomial (Fin m) k)).Finite := by
    -- Once the last-variable polynomial is monic of positive degree, the substitution map is
    -- finite.
    exact finite_last_variable_substitution_of_monic hp_monic hp_deg
  refine ⟨e, p, ?_⟩
  -- Expose the packaged data in the exact shape needed by the succ-case.
  dsimp
  exact ⟨hp_mem, hp_monic, hp_deg, hp_finite⟩

/-- Helper for Lemma 10.115.6: extending a finite coefficient self-map to the polynomial ring by
fixing `X` remains finite. -/
theorem finite_polynomial_mapAlgHom_of_finite [Algebra k A] (ψ : A →ₐ[k] A) (hψ : ψ.Finite) :
    (Polynomial.mapAlgHom ψ).Finite := by
  let e := polyEquivTensor k A
  have htensor :
      (Algebra.TensorProduct.map ψ (AlgHom.id k (Polynomial k))).Finite := by
    -- Tensoring the finite coefficient map with the identity on `k[X]` preserves finiteness.
    simpa using
      (RingHom.Finite.tensorProductMap (R := k) (S := A) (S' := A) (T := Polynomial k)
        (T' := Polynomial k) (f := ψ) hψ (g := AlgHom.id k (Polynomial k))
        (AlgHom.Finite.id (R := k) (A := Polynomial k)))
  have hmap :
      Polynomial.mapAlgHom ψ =
        e.symm.toAlgHom.comp
          ((Algebra.TensorProduct.map ψ (AlgHom.id k (Polynomial k))).comp e.toAlgHom) := by
    -- After identifying `A[X]` with `A ⊗[k] k[X]`, `mapAlgHom ψ` becomes `ψ ⊗ id`.
    apply Polynomial.algHom_ext'
    · apply AlgHom.ext
      intro a
      simpa [e, Algebra.smul_def]
    · simp [e]
  rw [hmap]
  exact
    (show e.symm.toAlgHom.Finite by simpa [e] using RingEquiv.finite e.symm.toRingEquiv).comp
      (htensor.comp
        (show e.toAlgHom.Finite by simpa [e] using RingEquiv.finite e.toRingEquiv))

/-- Helper for Lemma 10.115.6: extending a coefficient-ring self-map by fixing `X` contracts the
ideal `Ideal.map Polynomial.C p ⊔ (X)` to the same shape with the contracted coefficient ideal. -/
theorem comap_mapAlgHom_sup_span_X [Algebra k A] (ψ : A →ₐ[k] A) (p : Ideal A) :
    Ideal.comap (Polynomial.mapAlgHom ψ)
      (Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))) =
        Ideal.map Polynomial.C (Ideal.comap ψ p) ⊔
          Ideal.span ({Polynomial.X} : Set (Polynomial A)) := by
  refine le_antisymm ?_ ?_
  · intro f hf
    change Polynomial.map ψ.toRingHom f ∈
      Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A)) at hf
    rcases Submodule.mem_sup.mp hf with ⟨a, ha, b, hb, hab⟩
    have ha_coeff_zero : a.coeff 0 ∈ p := by
      exact ((Ideal.mem_map_C_iff (I := p) (f := a)).mp ha) 0
    have hb_coeff_zero : b.coeff 0 = 0 := by
      -- The `(X)`-summand contributes no constant term.
      rw [Ideal.mem_span_singleton] at hb
      rcases hb with ⟨g, rfl⟩
      simp
    have hmap_coeff_zero : ψ (f.coeff 0) ∈ p := by
      -- Comparing constant coefficients extracts the contracted coefficient ideal.
      have hab0 := congrArg (fun g : Polynomial A ↦ g.coeff 0) hab
      have hcoeff :
          (Polynomial.map ψ.toRingHom f).coeff 0 = a.coeff 0 := by
        simpa [hb_coeff_zero] using hab0.symm
      have hcoeff_mem : (Polynomial.map ψ.toRingHom f).coeff 0 ∈ p := by
        exact hcoeff.symm ▸ ha_coeff_zero
      simpa [Polynomial.coeff_map] using hcoeff_mem
    have hconstant_mem :
        Polynomial.C (f.coeff 0) ∈ Ideal.map Polynomial.C (Ideal.comap ψ p) := by
      exact Ideal.mem_map_of_mem Polynomial.C (by simpa [Ideal.mem_comap] using hmap_coeff_zero)
    have hX_multiple :
        Polynomial.divX f * Polynomial.X ∈ Ideal.span ({Polynomial.X} : Set (Polynomial A)) := by
      -- The remainder after removing the constant term is visibly an `X`-multiple.
      rw [Ideal.mem_span_singleton]
      exact ⟨Polynomial.divX f, by simp [mul_comm]⟩
    -- Reassemble `f` from its constant term and `X`-multiple.
    rw [← Polynomial.divX_mul_X_add f]
    exact Ideal.add_mem _
      ((show Ideal.span ({Polynomial.X} : Set (Polynomial A)) ≤
          Ideal.map Polynomial.C (Ideal.comap ψ p) ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial A)) from le_sup_right) hX_multiple)
      ((show Ideal.map Polynomial.C (Ideal.comap ψ p) ≤
          Ideal.map Polynomial.C (Ideal.comap ψ p) ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial A)) from le_sup_left) hconstant_mem)
  · refine sup_le ?_ ?_
    · intro f hf
      change Polynomial.map ψ.toRingHom f ∈
        Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))
      have hcoeff :
          ∀ n : ℕ, (Polynomial.map ψ.toRingHom f).coeff n ∈ p := by
        intro n
        have hfcoeff : f.coeff n ∈ Ideal.comap ψ p :=
          ((Ideal.mem_map_C_iff (I := Ideal.comap ψ p) (f := f)).mp hf) n
        simpa [Ideal.mem_comap, Polynomial.coeff_map] using hfcoeff
      exact
        (show Ideal.map Polynomial.C p ≤
            Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))
          from le_sup_left)
          ((Ideal.mem_map_C_iff (I := p) (f := Polynomial.map ψ.toRingHom f)).mpr hcoeff)
    · rw [Ideal.span_le]
      rintro f (rfl : f = Polynomial.X)
      change Polynomial.map ψ.toRingHom Polynomial.X ∈
        Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))
      exact
        (show Ideal.span ({Polynomial.X} : Set (Polynomial A)) ≤
            Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))
          from le_sup_right) (Ideal.subset_span (by simp))

/-- Helper for Lemma 10.115.6: transporting the tail-variable ideal through the last-variable
equivalence produces the coefficient-side tail ideal together with the last-variable ideal `(X)`. -/
theorem comap_noetherNormalizationLastVariableEquiv_tailVariablesIdeal_succ
    (m r : ℕ) (hr : r ≤ m) :
    Ideal.comap
      (noetherNormalizationLastVariableEquiv :
        MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).toAlgHom
      (Ideal.map Polynomial.C (tailVariablesIdeal k m r) ⊔
        Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k)))) =
      tailVariablesIdeal k (m + 1) r := by
  let e :
      MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k) :=
    noetherNormalizationLastVariableEquiv
  have hmap :
      Ideal.map e.toAlgHom (tailVariablesIdeal k (m + 1) r) =
        Ideal.map Polynomial.C (tailVariablesIdeal k m r) ⊔
          Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k))) := by
    -- The source tail generators become the coefficient-side tail generators together with `X`.
    rw [tailVariablesIdeal_def, tailVariablesIdeal_def, Ideal.map_span]
    have himage :
        e.toAlgHom ''
          {f | ∃ i : Fin (m + 1), r ≤ i.1 ∧ f = (X i : MvPolynomial (Fin (m + 1)) k)} =
          Polynomial.C ''
              {f | ∃ i : Fin m, r ≤ i.1 ∧ f = (X i : MvPolynomial (Fin m) k)} ∪
            ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k))) := by
      ext y
      constructor
      · rintro ⟨x, ⟨i, hi, rfl⟩, rfl⟩
        cases i using Fin.lastCases with
        | cast j =>
            left
            refine ⟨(X j : MvPolynomial (Fin m) k), ?_, ?_⟩
            · exact ⟨j, hi, rfl⟩
            · simp [e]
        | last =>
            right
            simp [e]
      · intro hy
        rcases hy with hy | hy
        · rcases hy with ⟨x, ⟨i, hi, rfl⟩, rfl⟩
          refine ⟨(X (Fin.castSucc i) : MvPolynomial (Fin (m + 1)) k), ?_, ?_⟩
          · exact ⟨Fin.castSucc i, hi, rfl⟩
          · simp [e]
        · have hyX : y = Polynomial.X := by simpa using hy
          refine ⟨(X (Fin.last m) : MvPolynomial (Fin (m + 1)) k), ?_, ?_⟩
          · exact ⟨Fin.last m, by simpa using hr, rfl⟩
          · simpa [e] using hyX.symm
    rw [himage, Ideal.span_union, Ideal.map_span]
  have hcomap_bot :
      Ideal.comap e.toAlgHom (⊥ : Ideal (Polynomial (MvPolynomial (Fin m) k))) = ⊥ := by
    -- The last-variable equivalence is injective, so its kernel vanishes.
    ext f
    change e f = 0 ↔ f = 0
    constructor
    · intro hf
      exact e.injective (by simpa using hf)
    · intro hf
      simpa [hf]
  calc
    Ideal.comap e.toAlgHom
        (Ideal.map Polynomial.C (tailVariablesIdeal k m r) ⊔
          Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k))))
        = Ideal.comap e.toAlgHom (Ideal.map e.toAlgHom (tailVariablesIdeal k (m + 1) r)) := by
            rw [hmap]
    _ = tailVariablesIdeal k (m + 1) r ⊔ Ideal.comap e.toAlgHom ⊥ := by
          exact Ideal.comap_map_of_surjective _ e.surjective _
    _ = tailVariablesIdeal k (m + 1) r := by
          rw [hcomap_bot, sup_bot_eq]

/-- Helper for Lemma 10.115.6: a finite contraction does not change the transcendence degree of
the residue field over the base field. -/
theorem trdeg_residueField_eq_of_finite_comap
    {A B : Type u} [CommRing A] [CommRing B] [Algebra k A] [Algebra k B]
    (φ : A →ₐ[k] B) (q : Ideal B) [q.IsPrime] (hφ : φ.Finite) :
    Algebra.trdeg k (Ideal.comap φ q).ResidueField = Algebra.trdeg k q.ResidueField := by
  letI : Algebra A B := φ.toRingHom.toAlgebra
  letI : IsScalarTower k A B := by
    -- The induced `A`-algebra structure is the one coming from `φ`, so the original `k`-structure
    -- forms a tower.
    refine IsScalarTower.of_algebraMap_eq fun x ↦ ?_
    simp [RingHom.algebraMap_toAlgebra, φ.commutes]
  let p : Ideal A := Ideal.comap φ q
  letI : q.LiesOver p := by
    -- The contracted prime is exactly the coefficient-side prime lying under `q`.
    refine ⟨?_⟩
    ext x
    simp [p, Ideal.under_def, RingHom.algebraMap_toAlgebra]
  have hquasiFinite : (algebraMap A B).QuasiFinite := by
    -- Finite maps are quasi-finite, so the residue-field extension is finite.
    simpa [RingHom.algebraMap_toAlgebra] using
      (RingHom.QuasiFinite.of_finite (f := φ.toRingHom) hφ)
  letI : Algebra.QuasiFinite A B :=
    (RingHom.quasiFinite_algebraMap (R := A) (S := B)).mp hquasiFinite
  have htrdeg_add := trdeg_add_eq (R := k) (S := p.ResidueField) (A := q.ResidueField)
  have htrdeg_zero : Algebra.trdeg p.ResidueField q.ResidueField = 0 := by
    -- A finite field extension is algebraic, so its relative transcendence degree vanishes.
    letI : Module.Finite p.ResidueField q.ResidueField := inferInstance
    letI : Algebra.IsAlgebraic p.ResidueField q.ResidueField :=
      Algebra.IsAlgebraic.of_finite (R := p.ResidueField) (A := q.ResidueField)
    exact trdeg_eq_zero (R := p.ResidueField) (A := q.ResidueField)
  -- Apply the tower formula `k ⟶ κ(p) ⟶ κ(q)` and remove the algebraic top term.
  simpa [p, htrdeg_zero] using htrdeg_add

/-- Helper for Lemma 10.115.6: the coefficient-quotient polynomial equivalence respects the
base-field algebra structure. -/
theorem polynomialQuotientEquivQuotientPolynomial_symm_commutes [Algebra k A] (p : Ideal A)
    (r : k) :
    (Ideal.polynomialQuotientEquivQuotientPolynomial p).symm
        (algebraMap k (Polynomial A ⧸ Ideal.map Polynomial.C p) r) =
      algebraMap k (Polynomial (A ⧸ p)) r := by
  -- The quotient equivalence acts coefficientwise, so it carries base scalars to base scalars.
  change
    (Ideal.polynomialQuotientEquivQuotientPolynomial p).symm
        (Ideal.Quotient.mk (Ideal.map Polynomial.C p) (Polynomial.C (algebraMap k A r))) =
      Polynomial.C ((algebraMap k (A ⧸ p)) r)
  rw [Ideal.polynomialQuotientEquivQuotientPolynomial_symm_mk]
  simp

/-- Helper for Lemma 10.115.6: the coefficient quotient identifies
`(A[X] / pA[X])` with `(A / p)[X]` as a `k`-algebra. -/
noncomputable def coefficientQuotientPolynomialAlgEquiv [Algebra k A] (p : Ideal A) :
    (Polynomial A ⧸ Ideal.map Polynomial.C p) ≃ₐ[k] Polynomial (A ⧸ p) :=
  AlgEquiv.ofRingEquiv
    (f := (Ideal.polynomialQuotientEquivQuotientPolynomial p).symm)
    (polynomialQuotientEquivQuotientPolynomial_symm_commutes (k := k) (A := A) p)

/-- Helper for Lemma 10.115.6: under the coefficient quotient, the class of `X` remains `X`. -/
theorem map_span_X_under_coefficientQuotientPolynomialAlgEquiv [Algebra k A] (p : Ideal A) :
    Ideal.map (coefficientQuotientPolynomialAlgEquiv (k := k) (A := A) p).toRingHom
        ((Ideal.span ({Polynomial.X} : Set (Polynomial A))).map
          (Ideal.Quotient.mkₐ k (Ideal.map Polynomial.C p))) =
      Ideal.span ({Polynomial.X} : Set (Polynomial (A ⧸ p))) := by
  -- Rewrite the iterated ideal map through composition and evaluate the generator `X`.
  rw [show
      Ideal.map (Ideal.Quotient.mkₐ k (Ideal.map Polynomial.C p))
          (Ideal.span ({Polynomial.X} : Set (Polynomial A))) =
        Ideal.map (Ideal.Quotient.mk (Ideal.map Polynomial.C p))
          (Ideal.span ({Polynomial.X} : Set (Polynomial A))) by
      rfl]
  rw [Ideal.map_map, Ideal.map_span, Set.image_singleton]
  have hX_image :
      coefficientQuotientPolynomialAlgEquiv (k := k) (A := A) p
          (Ideal.Quotient.mk (Ideal.map Polynomial.C p) Polynomial.X) = Polynomial.X := by
    simpa [coefficientQuotientPolynomialAlgEquiv] using
      (Ideal.polynomialQuotientEquivQuotientPolynomial_symm_mk p Polynomial.X)
  simpa [hX_image]

/-- Helper for Lemma 10.115.6: the ideals `(X)` and `(X - 0)` coincide. -/
theorem span_X_eq_span_X_sub_C_zero (R : Type u) [CommRing R] :
    Ideal.span ({Polynomial.X} : Set (Polynomial R)) =
      Ideal.span ({Polynomial.X - Polynomial.C 0} : Set (Polynomial R)) := by
  -- The generator `X - C 0` simplifies to `X`.
  simp

/-- Helper for Lemma 10.115.6: quotienting `(A / p)[X]` by `(X)` evaluates at `0`. -/
noncomputable def quotient_span_X_algEquiv [Algebra k A] (p : Ideal A) :
    (Polynomial (A ⧸ p) ⧸ Ideal.span ({Polynomial.X} : Set (Polynomial (A ⧸ p)))) ≃ₐ[k]
      A ⧸ p :=
  (Ideal.quotientEquivAlgOfEq k (span_X_eq_span_X_sub_C_zero (R := A ⧸ p))).trans
    (AlgEquiv.restrictScalars k (Polynomial.quotientSpanXSubCAlgEquiv (R := A ⧸ p) 0))

/-- Helper for Lemma 10.115.6: the source quotient step
`A[X] / (p, X) ≃ A / p` carried out directly through quotient rings. -/
noncomputable def quotient_map_C_sup_span_X_algEquiv_quotient [Algebra k A] (p : Ideal A) :
    ((Polynomial A) ⧸
        (Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A)))) ≃ₐ[k]
      A ⧸ p :=
  let eQuot :
      ((Polynomial A) ⧸
          (Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A)))) ≃ₐ[k]
        ((Polynomial A ⧸ Ideal.map Polynomial.C p) ⧸
          (Ideal.span ({Polynomial.X} : Set (Polynomial A))).map
            (Ideal.Quotient.mkₐ k (Ideal.map Polynomial.C p))) :=
    (DoubleQuot.quotQuotEquivQuotSupₐ k (Ideal.map Polynomial.C p)
      (Ideal.span ({Polynomial.X} : Set (Polynomial A)))).symm
  let eX :
      ((Polynomial A ⧸ Ideal.map Polynomial.C p) ⧸
          (Ideal.span ({Polynomial.X} : Set (Polynomial A))).map
            (Ideal.Quotient.mkₐ k (Ideal.map Polynomial.C p))) ≃ₐ[k]
        (Polynomial (A ⧸ p) ⧸ Ideal.span ({Polynomial.X} : Set (Polynomial (A ⧸ p)))) :=
    Ideal.quotientEquivAlg _ _ (coefficientQuotientPolynomialAlgEquiv (k := k) (A := A) p)
      (map_span_X_under_coefficientQuotientPolynomialAlgEquiv (k := k) (A := A) p).symm
  eQuot.trans (eX.trans (quotient_span_X_algEquiv (k := k) (A := A) p))

/-- Helper for Lemma 10.115.6: quotienting by `I` turns the zero ideal of `A / I` into `I`. -/
theorem quotient_mk_comap_bot (I : Ideal A) :
    I = Ideal.comap (Ideal.Quotient.mk I : A →+* A ⧸ I) (⊥ : Ideal (A ⧸ I)) := by
  -- Vanishing in the quotient is exactly membership in the quotient ideal.
  ext x
  simp [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem]

/-- Helper for Lemma 10.115.6: the quotient map induces a bijection on residue fields. -/
theorem residueField_mapₐ_quotient_bot_bijective [Algebra k A] (I : Ideal A) [I.IsPrime] :
    Function.Bijective
      (Ideal.ResidueField.mapₐ I (⊥ : Ideal (A ⧸ I)) (Ideal.Quotient.mkₐ k I)
        (quotient_mk_comap_bot (A := A) I)) := by
  -- The quotient map is surjective, so it is surjective on stalks and hence on residue fields.
  simpa using
    (RingHom.SurjectiveOnStalks.residueFieldMap_bijective
      (f := (Ideal.Quotient.mk I : A →+* A ⧸ I))
      (RingHom.surjectiveOnStalks_of_surjective Ideal.Quotient.mk_surjective)
      I (⊥ : Ideal (A ⧸ I)) (quotient_mk_comap_bot (A := A) I))

/-- Helper for Lemma 10.115.6: passing to the quotient identifies `κ(I)` with the residue field
of the zero prime in `R / I`. -/
noncomputable def residueField_quotient_bot_algEquiv [Algebra k A] (I : Ideal A) [I.IsPrime] :
    I.ResidueField ≃ₐ[k] ((⊥ : Ideal (A ⧸ I)).ResidueField) :=
  AlgEquiv.ofBijective
    (Ideal.ResidueField.mapₐ I (⊥ : Ideal (A ⧸ I)) (Ideal.Quotient.mkₐ k I)
      (quotient_mk_comap_bot (A := A) I))
    (residueField_mapₐ_quotient_bot_bijective (k := k) (A := A) I)

/-- Helper for Lemma 10.115.6: for a prime ideal, the residue field and the quotient domain have
the same transcendence degree over the base field. -/
theorem trdeg_residueField_eq_trdeg_quotient [Algebra k A] (I : Ideal A) [I.IsPrime] :
    Algebra.trdeg k I.ResidueField = Algebra.trdeg k (A ⧸ I) := by
  let S := A ⧸ I
  let eResidue : I.ResidueField ≃ₐ[k] ((⊥ : Ideal S).ResidueField) :=
    residueField_quotient_bot_algEquiv (k := k) (A := A) I
  let eFrac : FractionRing S ≃ₐ[k] ((⊥ : Ideal S).ResidueField) :=
    AlgEquiv.restrictScalars k (botResidueFieldAlgEquiv (S := S))
  have htrdeg_frac : Algebra.trdeg k (FractionRing S) = Algebra.trdeg k S := by
    -- Compare the quotient domain with its fraction field, then kill the algebraic top term.
    have hadd := trdeg_add_eq (R := k) (S := S) (A := FractionRing S)
    have hz : Algebra.trdeg S (FractionRing S) = 0 := by
      have :
          Algebra.IsAlgebraic S (FractionRing S) :=
        (IsFractionRing.comap_isAlgebraic_iff (A := S) (K := FractionRing S)
          (C := FractionRing S)).mpr
          (inferInstance : Algebra.IsAlgebraic (FractionRing S) (FractionRing S))
      exact trdeg_eq_zero (R := S) (A := FractionRing S)
    simpa [hz] using hadd.symm
  -- Transport `κ(I)` to the zero-prime residue field of `A ⧸ I`, then to the fraction field.
  calc
    Algebra.trdeg k I.ResidueField = Algebra.trdeg k ((⊥ : Ideal S).ResidueField) := by
      simpa using AlgEquiv.trdeg_eq (R := k) eResidue
    _ = Algebra.trdeg k (FractionRing S) := by
      symm
      simpa using AlgEquiv.trdeg_eq (R := k) eFrac
    _ = Algebra.trdeg k S := htrdeg_frac
    _ = Algebra.trdeg k (A ⧸ I) := by
      rfl

/-- Helper for Lemma 10.115.6: the residue field of a prime of `k[x_1, \ldots, x_n]` has
transcendence degree at most `n`. -/
theorem residueField_trdeg_nat_le_numVars_mvPolynomial
    (p : Ideal (MvPolynomial (Fin n) k)) [p.IsPrime] :
    Cardinal.toNat (Algebra.trdeg k p.ResidueField) ≤ n := by
  have hsurj :
      Algebra.trdeg k (MvPolynomial (Fin n) k ⧸ p) ≤
        Algebra.trdeg k (MvPolynomial (Fin n) k) :=
    trdeg_le_of_surjective (Ideal.Quotient.mkₐ k p) Ideal.Quotient.mk_surjective
  have hpoly_lt : Algebra.trdeg k (MvPolynomial (Fin n) k) < Cardinal.aleph0 := by
    simpa [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin]
      using (Cardinal.natCast_lt_aleph0 : (n : Cardinal) < Cardinal.aleph0)
  -- First move from `κ(p)` to the quotient domain, then compare that quotient with the ambient
  -- polynomial ring using the quotient surjection.
  calc
    Cardinal.toNat (Algebra.trdeg k p.ResidueField)
        = Cardinal.toNat (Algebra.trdeg k (MvPolynomial (Fin n) k ⧸ p)) := by
            rw [trdeg_residueField_eq_trdeg_quotient (k := k)
              (A := MvPolynomial (Fin n) k) p]
    _ ≤ Cardinal.toNat (Algebra.trdeg k (MvPolynomial (Fin n) k)) := by
          exact Cardinal.toNat_le_toNat hsurj hpoly_lt
    _ = n := by
          rw [MvPolynomial.trdeg_of_isDomain, Cardinal.toNat_lift, Cardinal.mk_fin,
            Cardinal.toNat_natCast]

/-- Helper for Lemma 10.115.6: after rewriting the contracted `A[X]`-prime as `(p, X)`, its
residue field is canonically the same as the residue field of `p`. -/
noncomputable def residueField_map_C_sup_span_X_algEquiv [Algebra k A] (p : Ideal A) [p.IsPrime]
    [(Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))).IsPrime] :
    (Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))).ResidueField ≃ₐ[k]
      p.ResidueField :=
  let J : Ideal (Polynomial A) :=
    Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))
  letI : J.IsPrime := by
    simpa [J] using
      (inferInstance :
        (Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))).IsPrime)
  let eQuot : (Polynomial A ⧸ J) ≃ₐ[k] A ⧸ p := by
    -- This is the explicit source quotient computation `A[X] / (p, X) ≃ A / p`.
    simpa [J] using quotient_map_C_sup_span_X_algEquiv_quotient (k := k) (A := A) p
  let eJ₀ : J.ResidueField ≃ₐ[k] ((⊥ : Ideal (Polynomial A ⧸ J)).ResidueField) :=
    residueField_quotient_bot_algEquiv (k := k) (A := Polynomial A) J
  let ep₀ : p.ResidueField ≃ₐ[k] ((⊥ : Ideal (A ⧸ p)).ResidueField) :=
    residueField_quotient_bot_algEquiv (k := k) (A := A) p
  let eFrac : FractionRing (Polynomial A ⧸ J) ≃ₐ[k] FractionRing (A ⧸ p) :=
    IsFractionRing.algEquivOfAlgEquiv eQuot
  -- Transport both residue fields to fraction fields of the quotient domains, compare there,
  -- and then return to the residue fields.
  eJ₀.trans
    ((AlgEquiv.restrictScalars k (botResidueFieldAlgEquiv (S := Polynomial A ⧸ J))).symm.trans
      (eFrac.trans
        ((AlgEquiv.restrictScalars k (botResidueFieldAlgEquiv (S := A ⧸ p))).trans ep₀.symm)))

/-- Helper for Lemma 10.115.6: the quotient-stage residue-field identification preserves the
transcendence-degree index used in the induction. -/
theorem trdeg_nat_residueField_map_C_sup_span_X_eq [Algebra k A] (p : Ideal A) [p.IsPrime]
    [(Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))).IsPrime] :
    Cardinal.toNat
        (Algebra.trdeg k
          (Ideal.map Polynomial.C p ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial A))).ResidueField) =
      Cardinal.toNat (Algebra.trdeg k p.ResidueField) := by
  -- Transport `trdeg` across the residue-field equivalence and then apply `Cardinal.toNat`.
  simpa using congrArg Cardinal.toNat
    (AlgEquiv.trdeg_eq (R := k)
      (residueField_map_C_sup_span_X_algEquiv (k := k) (A := A) p))

/-- Helper for Lemma 10.115.6: a prime of `A[X]` containing `X` has the same residue-field
transcendence-degree index as its coefficient contraction. -/
theorem trdeg_nat_comap_C_of_prime_containing_X [Algebra k A]
    (Q : Ideal (Polynomial A)) [Q.IsPrime] (hX : Polynomial.X ∈ Q) :
    Cardinal.toNat (Algebra.trdeg k (Ideal.comap Polynomial.C Q).ResidueField) =
      Cardinal.toNat (Algebra.trdeg k Q.ResidueField) := by
  let p : Ideal A := Ideal.comap Polynomial.C Q
  let J : Ideal (Polynomial A) :=
    Ideal.map Polynomial.C p ⊔ Ideal.span ({Polynomial.X} : Set (Polynomial A))
  have hQeq :
      Q = J := by
    -- Rewrite a prime containing `X` as the sum of its coefficient contraction and `(X)`.
    simpa [p, J] using prime_containing_X_eq_map_comap_C_sup_span_X Q hX
  letI : J.IsPrime := by
    -- Transport primality across the explicit ideal equality `Q = J`.
    exact hQeq.symm ▸ (inferInstance : Q.IsPrime)
  have hJ :
      Cardinal.toNat (Algebra.trdeg k p.ResidueField) =
        Cardinal.toNat (Algebra.trdeg k J.ResidueField) := by
    -- After the `(p, X)` rewrite, the quotient-stage residue-field calculation applies directly.
    simpa [p, J] using
      (trdeg_nat_residueField_map_C_sup_span_X_eq (k := k) (A := A) p).symm
  have hSubtype :
      (⟨J, inferInstance⟩ : {I : Ideal (Polynomial A) // I.IsPrime}) =
        ⟨Q, inferInstance⟩ := by
    ext x
    change x ∈ J ↔ x ∈ Q
    simpa [hQeq]
  have hJQ :
      Cardinal.toNat (Algebra.trdeg k J.ResidueField) =
        Cardinal.toNat (Algebra.trdeg k Q.ResidueField) := by
    -- Package the prime ideals with their primality proofs so the equality transports cleanly.
    simpa using congrArg
      (fun s : {I : Ideal (Polynomial A) // I.IsPrime} =>
        letI : s.1.IsPrime := s.2
        Cardinal.toNat (Algebra.trdeg k s.1.ResidueField))
      hSubtype
  exact hJ.trans hJQ

/-- Helper for Lemma 10.115.6: after the monic last-variable contraction, the coefficient prime has
the same transcendence-degree index as the original prime. -/
theorem trdeg_nat_coefficient_prime_eq_target_index
    {m : ℕ} (q : Ideal (MvPolynomial (Fin (m + 1)) k)) [q.IsPrime]
    (e : Fin m → ℕ) (p : Polynomial (MvPolynomial (Fin m) k))
    (hp_mem :
      p ∈ Ideal.comap
        ((noetherNormalizationLastVariableEquiv :
          MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom)
        (Ideal.comap (noetherNormalizationShear e).symm.toAlgHom q))
    (hp_finite :
      (Polynomial.aeval p :
        Polynomial (MvPolynomial (Fin m) k) →ₐ[MvPolynomial (Fin m) k]
          Polynomial (MvPolynomial (Fin m) k)).Finite) :
    let σ : MvPolynomial (Fin (m + 1)) k ≃ₐ[k] MvPolynomial (Fin (m + 1)) k :=
      noetherNormalizationShear e
    let q' : Ideal (MvPolynomial (Fin (m + 1)) k) := Ideal.comap σ.symm.toAlgHom q
    let qA : Ideal (Polynomial (MvPolynomial (Fin m) k)) :=
      Ideal.comap
        ((noetherNormalizationLastVariableEquiv :
          MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom)
        q'
    let Q : Ideal (Polynomial (MvPolynomial (Fin m) k)) := Ideal.comap (Polynomial.aeval p) qA
    let pCoeff : Ideal (MvPolynomial (Fin m) k) := Ideal.comap Polynomial.C Q
    Cardinal.toNat (Algebra.trdeg k pCoeff.ResidueField) =
      Cardinal.toNat (Algebra.trdeg k q.ResidueField) := by
  let σ : MvPolynomial (Fin (m + 1)) k ≃ₐ[k] MvPolynomial (Fin (m + 1)) k :=
    noetherNormalizationShear e
  let q' : Ideal (MvPolynomial (Fin (m + 1)) k) := Ideal.comap σ.symm.toAlgHom q
  let qA : Ideal (Polynomial (MvPolynomial (Fin m) k)) :=
    Ideal.comap
      ((noetherNormalizationLastVariableEquiv :
        MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom)
      q'
  let Q : Ideal (Polynomial (MvPolynomial (Fin m) k)) := Ideal.comap (Polynomial.aeval p) qA
  let pCoeff : Ideal (MvPolynomial (Fin m) k) := Ideal.comap Polynomial.C Q
  have hX : Polynomial.X ∈ Q := by
    -- The defining polynomial `p` lies in `qA`, so its preimage prime `Q` contains `X`.
    simpa [Q, qA, q', σ] using hp_mem
  have hQ_finite :
      Algebra.trdeg k Q.ResidueField = Algebra.trdeg k qA.ResidueField := by
    -- The monic last-variable substitution is finite, so residue-field transcendence degree is
    -- unchanged under this contraction.
    have hp_finite' :
        ((Polynomial.aeval p).restrictScalars k :
          Polynomial (MvPolynomial (Fin m) k) →ₐ[k]
            Polynomial (MvPolynomial (Fin m) k)).Finite := by
      simpa using hp_finite
    exact
      trdeg_residueField_eq_of_finite_comap (k := k)
        (φ := ((Polynomial.aeval p).restrictScalars k :
          Polynomial (MvPolynomial (Fin m) k) →ₐ[k]
            Polynomial (MvPolynomial (Fin m) k))) qA hp_finite'
  have hqA_finite :
      Algebra.trdeg k qA.ResidueField = Algebra.trdeg k q'.ResidueField := by
    -- The last-variable equivalence is finite because an algebra equivalence is finite.
    have hfinite :
        ((noetherNormalizationLastVariableEquiv :
          MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom).Finite := by
      simpa using
        RingEquiv.finite
          ((noetherNormalizationLastVariableEquiv :
            MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toRingEquiv)
    exact
      trdeg_residueField_eq_of_finite_comap (k := k)
        (φ := (noetherNormalizationLastVariableEquiv :
          MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom)
        q' hfinite
  have hq'_finite :
      Algebra.trdeg k q'.ResidueField = Algebra.trdeg k q.ResidueField := by
    -- Likewise, the triangular shear is an algebra equivalence, so it preserves the index.
    have hfinite : σ.symm.toAlgHom.Finite := by
      simpa [σ] using RingEquiv.finite σ.symm.toRingEquiv
    exact trdeg_residueField_eq_of_finite_comap (k := k) (φ := σ.symm.toAlgHom) q hfinite
  -- Route correction: keep the source-faithful chain `pCoeff -> Q -> qA -> q' -> q` flat.
  calc
    Cardinal.toNat (Algebra.trdeg k pCoeff.ResidueField)
        = Cardinal.toNat (Algebra.trdeg k Q.ResidueField) := by
            simpa [pCoeff] using
              trdeg_nat_comap_C_of_prime_containing_X (k := k)
                (A := MvPolynomial (Fin m) k) Q hX
    _ = Cardinal.toNat (Algebra.trdeg k qA.ResidueField) := by
          rw [hQ_finite]
    _ = Cardinal.toNat (Algebra.trdeg k q'.ResidueField) := by
          rw [hqA_finite]
    _ = Cardinal.toNat (Algebra.trdeg k q.ResidueField) := by
          rw [hq'_finite]

/-- Helper for Lemma 10.115.6: after applying the inductive finite self-map on the coefficient
prime and then substituting the monic last-variable polynomial, the contracted coefficient-side
prime has the expected shape `(tailVariablesIdeal, X)`. -/
theorem coefficient_side_contraction_eq_tail_sup_span_X
    {m : ℕ} (r : ℕ)
    (p : Polynomial (MvPolynomial (Fin m) k))
    (qA : Ideal (Polynomial (MvPolynomial (Fin m) k))) [qA.IsPrime]
    (Q : Ideal (Polynomial (MvPolynomial (Fin m) k)))
    (hQ : Q = Ideal.comap (Polynomial.aeval p) qA)
    (pCoeff : Ideal (MvPolynomial (Fin m) k))
    (hpCoeff : pCoeff = Ideal.comap Polynomial.C Q)
    (ψ : MvPolynomial (Fin m) k →ₐ[k] MvPolynomial (Fin m) k)
    (hψ_comap : Ideal.comap ψ pCoeff = tailVariablesIdeal k m r)
    (hp_mem : p ∈ qA) :
    let ρ :
        Polynomial (MvPolynomial (Fin m) k) →ₐ[k] Polynomial (MvPolynomial (Fin m) k) :=
      ((Polynomial.aeval p).restrictScalars k).comp (Polynomial.mapAlgHom ψ)
    Ideal.comap ρ qA =
      Ideal.map Polynomial.C (tailVariablesIdeal k m r) ⊔
        Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k))) := by
  let ρ :
      Polynomial (MvPolynomial (Fin m) k) →ₐ[k] Polynomial (MvPolynomial (Fin m) k) :=
    ((Polynomial.aeval p).restrictScalars k).comp (Polynomial.mapAlgHom ψ)
  have hX : Polynomial.X ∈ Q := by
    -- The preimage prime under `aeval p` contains `X` because `p ∈ qA`.
    rw [hQ]
    simpa using hp_mem
  calc
    Ideal.comap ρ qA = Ideal.comap (Polynomial.mapAlgHom ψ) Q := by
        rw [hQ]
        rfl
    _ = Ideal.comap (Polynomial.mapAlgHom ψ)
          (Ideal.map Polynomial.C pCoeff ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k)))) := by
          rw [prime_containing_X_eq_map_comap_C_sup_span_X Q hX, hpCoeff]
    _ = Ideal.map Polynomial.C (Ideal.comap ψ pCoeff) ⊔
          Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k))) := by
          simpa [hpCoeff] using
            comap_mapAlgHom_sup_span_X (k := k) (A := MvPolynomial (Fin m) k) ψ pCoeff
    _ = Ideal.map Polynomial.C (tailVariablesIdeal k m r) ⊔
          Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k))) := by
          rw [hψ_comap]

/-- Helper for Lemma 10.115.6: transporting the coefficient-side ideal
`Ideal.map Polynomial.C (tailVariablesIdeal ...) ⊔ (X)` back across the last-variable equivalence
and the shear gives the desired tail-variable ideal. -/
theorem transport_tail_sup_span_X_back
    {m : ℕ} (r : ℕ) (hr : r ≤ m)
    (σ : MvPolynomial (Fin (m + 1)) k ≃ₐ[k] MvPolynomial (Fin (m + 1)) k)
    (q : Ideal (MvPolynomial (Fin (m + 1)) k))
    (q' : Ideal (MvPolynomial (Fin (m + 1)) k))
    (hq' : q' = Ideal.comap σ.symm.toAlgHom q)
    (qA : Ideal (Polynomial (MvPolynomial (Fin m) k)))
    (hqA :
      qA = Ideal.comap
        ((noetherNormalizationLastVariableEquiv :
          MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom)
        q')
    (ρ : Polynomial (MvPolynomial (Fin m) k) →ₐ[k] Polynomial (MvPolynomial (Fin m) k))
    (hρ_comap :
      Ideal.comap ρ qA =
        Ideal.map Polynomial.C (tailVariablesIdeal k m r) ⊔
          Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k)))) :
    let φ : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin (m + 1)) k :=
      σ.symm.toAlgHom.comp
        ((noetherNormalizationLastVariableEquiv :
          MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom.comp
          (ρ.comp
            (noetherNormalizationLastVariableEquiv :
              MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).toAlgHom))
    Ideal.comap φ q = tailVariablesIdeal k (m + 1) r := by
  let φ : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin (m + 1)) k :=
    σ.symm.toAlgHom.comp
      ((noetherNormalizationLastVariableEquiv :
        MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom.comp
        (ρ.comp
          (noetherNormalizationLastVariableEquiv :
            MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).toAlgHom))
  calc
    Ideal.comap φ q =
        Ideal.comap
          (((noetherNormalizationLastVariableEquiv :
            MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).symm.toAlgHom).comp
            (ρ.comp
              (noetherNormalizationLastVariableEquiv :
                MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).toAlgHom))
          q' := by
        rw [hq']
        rfl
    _ =
        Ideal.comap
          (ρ.comp
            (noetherNormalizationLastVariableEquiv :
              MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).toAlgHom)
          qA := by
        rw [hqA]
        rfl
    _ =
        Ideal.comap
          ((noetherNormalizationLastVariableEquiv :
            MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).toAlgHom)
          (Ideal.comap ρ qA) := by
        rfl
    _ = Ideal.comap
          ((noetherNormalizationLastVariableEquiv :
            MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k)).toAlgHom)
          (Ideal.map Polynomial.C (tailVariablesIdeal k m r) ⊔
            Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin m) k)))) := by
          rw [hρ_comap]
    _ = tailVariablesIdeal k (m + 1) r := by
          exact
            comap_noetherNormalizationLastVariableEquiv_tailVariablesIdeal_succ (k := k) m r hr

/-- Helper for Lemma 10.115.6: the successor-variable nonzero-prime case is handled by the
source-proof chain `pCoeff → Q → qA → q' → q`, with the inductive finite self-map applied only to
the coefficient prime. -/
theorem exists_finite_selfAlgHom_comap_eq_tailVariablesIdeal_succ_of_nonbot
    {m : ℕ}
    (ih :
      ∀ (pI : Ideal (MvPolynomial (Fin m) k)) [pI.IsPrime],
        ∃ φ : MvPolynomial (Fin m) k →ₐ[k] MvPolynomial (Fin m) k,
          φ.Finite ∧
            Ideal.comap φ pI =
              tailVariablesIdeal k m (Cardinal.toNat (Algebra.trdeg k pI.ResidueField)))
    (q : Ideal (MvPolynomial (Fin (m + 1)) k)) [q.IsPrime] (hq : q ≠ ⊥) :
    ∃ φ : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin (m + 1)) k,
      φ.Finite ∧
        Ideal.comap φ q =
          tailVariablesIdeal k (m + 1) (Cardinal.toNat (Algebra.trdeg k q.ResidueField)) := by
  let r : ℕ := Cardinal.toNat (Algebra.trdeg k q.ResidueField)
  obtain ⟨g, hgq, hg0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hq
  obtain ⟨e, p, hp_mem, hp_monic, hp_deg, hp_finite⟩ :=
    exists_monic_last_variable_substitution_data (k := k) q hgq hg0
  let σ : MvPolynomial (Fin (m + 1)) k ≃ₐ[k] MvPolynomial (Fin (m + 1)) k :=
    noetherNormalizationShear e
  let τ :
      MvPolynomial (Fin (m + 1)) k ≃ₐ[k] Polynomial (MvPolynomial (Fin m) k) :=
    noetherNormalizationLastVariableEquiv
  let q' : Ideal (MvPolynomial (Fin (m + 1)) k) := Ideal.comap σ.symm.toAlgHom q
  let qA : Ideal (Polynomial (MvPolynomial (Fin m) k)) := Ideal.comap τ.symm.toAlgHom q'
  let Q : Ideal (Polynomial (MvPolynomial (Fin m) k)) := Ideal.comap (Polynomial.aeval p) qA
  let pCoeff : Ideal (MvPolynomial (Fin m) k) := Ideal.comap Polynomial.C Q
  have hindex :
      Cardinal.toNat (Algebra.trdeg k pCoeff.ResidueField) = r := by
    -- The source proof keeps the transcendence-degree index unchanged along
    -- `pCoeff → Q → qA → q' → q`.
    simpa [r, σ, q', qA, Q, pCoeff] using
      trdeg_nat_coefficient_prime_eq_target_index (k := k) q e p hp_mem hp_finite
  have hr : r ≤ m := by
    -- The coefficient prime lives in `m` variables, so its index is bounded by `m`.
    have hpCoeff_le := residueField_trdeg_nat_le_numVars_mvPolynomial (k := k) pCoeff
    rw [hindex] at hpCoeff_le
    exact hpCoeff_le
  obtain ⟨ψ, hψ_finite, hψ_comap⟩ := ih pCoeff
  have hψ_comap' : Ideal.comap ψ pCoeff = tailVariablesIdeal k m r := by
    -- Rewrite the induction hypothesis using the already matched index `r`.
    rw [hindex] at hψ_comap
    exact hψ_comap
  have hmap_finite :
      (Polynomial.mapAlgHom ψ).Finite := by
    -- Extending the inductive self-map by fixing the last variable preserves finiteness.
    exact finite_polynomial_mapAlgHom_of_finite (k := k) ψ hψ_finite
  let ρ :
      Polynomial (MvPolynomial (Fin m) k) →ₐ[k] Polynomial (MvPolynomial (Fin m) k) :=
    ((Polynomial.aeval p).restrictScalars k).comp (Polynomial.mapAlgHom ψ)
  have hp_finite' :
      ((Polynomial.aeval p).restrictScalars k :
        Polynomial (MvPolynomial (Fin m) k) →ₐ[k] Polynomial (MvPolynomial (Fin m) k)).Finite := by
    simpa using hp_finite
  have hρ_finite : ρ.Finite := by
    -- The coefficient extension is finite, and then the monic last-variable substitution is
    -- finite as well.
    exact hp_finite'.comp hmap_finite
  have hp_mem_qA : p ∈ qA := by
    -- Reinterpret the monic last-variable polynomial as an element of the coefficient-side prime.
    simpa [qA] using hp_mem
  have hρ_comap :
      Ideal.comap ρ qA =
        Ideal.map Polynomial.C (tailVariablesIdeal k m r) ⊔
          Ideal.span ({Polynomial.X} :
            Set (Polynomial (MvPolynomial (Fin m) k))) := by
    -- Route correction: invoke the dedicated coefficient-side contraction helper instead of
    -- replaying the full `(pCoeff, X)` contraction inline.
    simpa [ρ, qA, Q, pCoeff] using
      coefficient_side_contraction_eq_tail_sup_span_X
        (k := k) (m := m) r p qA Q rfl pCoeff rfl ψ hψ_comap' hp_mem_qA
  let φ : MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin (m + 1)) k :=
    σ.symm.toAlgHom.comp (τ.symm.toAlgHom.comp (ρ.comp τ.toAlgHom))
  have hφ_finite : φ.Finite := by
    -- Finiteness propagates across the two algebra equivalences and the middle finite map.
    exact
      (show σ.symm.toAlgHom.Finite by simpa [σ] using RingEquiv.finite σ.symm.toRingEquiv).comp
        ((show τ.symm.toAlgHom.Finite by simpa [τ] using RingEquiv.finite τ.symm.toRingEquiv).comp
          (hρ_finite.comp
            (show τ.toAlgHom.Finite by simpa [τ] using RingEquiv.finite τ.toRingEquiv)))
  have hφ_comap : Ideal.comap φ q = tailVariablesIdeal k (m + 1) r := by
    -- Transport the coefficient-side computation back to the original polynomial ring using the
    -- dedicated source-order transport helper.
    simpa [φ, q', qA] using
      transport_tail_sup_span_X_back
        (k := k) (m := m) r hr σ q q' rfl qA rfl ρ hρ_comap
  refine ⟨φ, hφ_finite, ?_⟩
  simpa [r] using hφ_comap

-- Proof sketch: argue by induction on the number of variables. If the residue-field
-- transcendence degree already equals `n`, then the prime is zero. Otherwise choose a nonconstant
-- polynomial in `q`, use Lemma `10.115.2` to shear it so that it becomes monic in the last
-- variable, obtain a finite map by sending the last source variable to that monic polynomial, and
-- then apply the induction hypothesis to the contracted prime in the first `n - 1` variables.
/-- Lemma 10.115.6: if `q` is a prime ideal of `k[x_1, \ldots, x_n]` and
`r = Cardinal.toNat (Algebra.trdeg k q.ResidueField)`, then there exists a finite `k`-algebra map
from another `n`-variable polynomial ring to `k[x_1, \ldots, x_n]` whose contraction of `q` is
the coordinate ideal `(y_{r + 1}, \ldots, y_n)`. -/
@[stacks 051P]
theorem exists_finite_selfAlgHom_comap_eq_tailVariablesIdeal
    (q : Ideal (MvPolynomial (Fin n) k)) [q.IsPrime] :
    ∃ φ : MvPolynomial (Fin n) k →ₐ[k] MvPolynomial (Fin n) k,
      φ.Finite ∧
        Ideal.comap φ q =
          tailVariablesIdeal k n (Cardinal.toNat (Algebra.trdeg k q.ResidueField)) := by
  induction' n with m ih
  · by_cases hq : q = ⊥
    · -- The zero-prime branch is the generic-point case handled by the identity map.
      subst hq
      simpa using exists_finite_selfAlgHom_comap_eq_tailVariablesIdeal_of_bot (k := k) (n := 0)
    · -- In zero variables, `MvPolynomial (Fin 0) k` is just the field `k`, so no nonzero prime
      -- can occur.
      obtain ⟨f, hfq, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hq
      obtain ⟨a, rfl⟩ : ∃ a : k, f = C a := ⟨f.coeff 0, MvPolynomial.eq_C_of_isEmpty f⟩
      have ha : a ≠ 0 := by
        -- The chosen nonzero element cannot be the zero constant.
        intro ha0
        apply hf0
        simpa [ha0]
      have htop : q = ⊤ :=
        Ideal.eq_top_of_isUnit_mem q hfq (IsUnit.map MvPolynomial.C (IsUnit.mk0 a ha))
      have hq_top : q ≠ ⊤ := Ideal.IsPrime.ne_top (I := q) inferInstance
      exact False.elim <| hq_top htop
  · by_cases hq : q = ⊥
    · -- The generic-point branch stays identical in every positive number of variables.
      subst hq
      simpa using exists_finite_selfAlgHom_comap_eq_tailVariablesIdeal_of_bot (k := k) (n := m + 1)
    · exact exists_finite_selfAlgHom_comap_eq_tailVariablesIdeal_succ_of_nonbot
        (k := k) ih q hq

end
