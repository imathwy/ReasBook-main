/-- Helper for Chap10 Lemma 10 69 5: every source tensor is a finite sum of monomial simple
tensors with quotient-module coefficients. -/
private theorem tensor_monomial_expansion
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A)
    (z : TensorProduct (A ⧸ Ideal.ofList rs)
      (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P)))
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))) :
    ∃ coeffs : (Fin rs.length →₀ ℕ) →₀ (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))),
      z =
        coeffs.sum fun e q ↦
          (q ⊗ₜ[A ⧸ Ideal.ofList rs]
            MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs)) := by
  let comm :=
    TensorProduct.comm (A ⧸ Ideal.ofList rs)
      (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P)))
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
  let scalar :
      TensorProduct (A ⧸ Ideal.ofList rs)
        (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
        (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) ≃ₗ[A ⧸ Ideal.ofList rs]
          (Fin rs.length →₀ ℕ) →₀
            (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) :=
    MvPolynomial.scalarRTensor
  let coeffs :
      (Fin rs.length →₀ ℕ) →₀ (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) :=
    scalar (comm z)
  refine ⟨coeffs, ?_⟩
  -- Move to the commuted tensor product, where `scalarRTensor` gives the coefficient expansion.
  apply comm.injective
  calc
    comm z = scalar.symm coeffs := by
      simp [coeffs]
    _ = scalar.symm (coeffs.sum fun e q ↦ Finsupp.single e q) := by
      simp
    _ = coeffs.sum fun e q ↦ scalar.symm (Finsupp.single e q) := by
      simp [Finsupp.sum]
    _ = coeffs.sum fun e q ↦
          (MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs)) ⊗ₜ[A ⧸ Ideal.ofList rs] q := by
      refine Finsupp.sum_congr ?_
      intro e q
      rw [MvPolynomial.scalarRTensor_symm_apply_single]
    _ = comm
          (coeffs.sum fun e q ↦
            (q ⊗ₜ[A ⧸ Ideal.ofList rs]
              MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs))) := by
      simp only [Finsupp.sum, map_sum]
      refine Finset.sum_congr rfl ?_
      intro e he
      rw [TensorProduct.comm_tmul]

/-- Helper for Chap10 Lemma 10 69 5: if a linear map kills a submodule in one tensor factor,
then the tensor product of that submodule maps into the kernel of the induced tensor map. -/
private theorem tensorProductMapIdSubtype_range_le_ker
    {A : Type*} [CommSemiring A]
    {P : Type*} [AddCommMonoid P] [Module A P]
    {Q : Type*} [AddCommMonoid Q] [Module A Q]
    {Q' : Type*} [AddCommMonoid Q'] [Module A Q']
    (N : Submodule A Q) (f : Q →ₗ[A] Q') (hN : N ≤ LinearMap.ker f) :
    LinearMap.range (TensorProduct.map (LinearMap.id : P →ₗ[A] P) N.subtype) ≤
      LinearMap.ker (TensorProduct.map (LinearMap.id : P →ₗ[A] P) f) := by
  -- Reduce the kernel statement to simple tensors; on a simple tensor the second factor is
  -- killed by the hypothesis `N ≤ ker f`.
  rintro z ⟨w, rfl⟩
  refine TensorProduct.induction_on w ?_ ?_ ?_
  · simp
  · intro p n
    have hn : f n = 0 := hN n.property
    simp [TensorProduct.map_tmul, hn]
  · intro x y hx hy
    rw [map_add]
    exact Submodule.add_mem _ hx hy

/-- Helper for Chap10 Lemma 10 69 5: a principal ideal generated by an element killed by an
algebra hom is contained, after restricting scalars, in the linear kernel of that hom. -/
private theorem principalIdealRestrictScalars_le_ker_of_map_eq_zero
    {A : Type*} [CommSemiring A]
    {B : Type*} [CommSemiring B] [Algebra A B]
    {C : Type*} [CommSemiring C] [Algebra A C]
    (F : B →ₐ[A] C) (x : B) (hx : F x = 0) :
    ((Ideal.span ({x} : Set B) : Ideal B).restrictScalars A) ≤
      LinearMap.ker F.toLinearMap := by
  -- Induct through the ideal generated by `x`; multiplication is handled by multiplicativity of
  -- the algebra hom after the generator has been killed.
  intro y hy
  change y ∈ Ideal.span ({x} : Set B) at hy
  change F y = 0
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hy
  · intro y hyx
    rw [Set.mem_singleton_iff.mp hyx]
    exact hx
  · simp
  · intro y z _ _ hy hz
    rw [map_add, hy, hz, add_zero]
  · intro a y _ hy
    rw [Algebra.smul_def, map_mul, hy, mul_zero]

/-- Helper for Chap10 Lemma 10 69 5: the monomial weight attached to an exponent vector lies in
the matching power of `Ideal.ofList rs`. -/
private theorem ofList_monomial_weight_mem_pow
    {A : Type*} [CommRing A] (rs : List A) (e : Fin rs.length →₀ ℕ) :
    (∏ i : Fin rs.length, rs.get i ^ e i) ∈ (Ideal.ofList rs) ^ e.degree := by
  -- Each generator factor lies in its corresponding ideal power, and products add degrees.
  have hprod :
      (∏ i : Fin rs.length, rs.get i ^ e i) ∈
        ∏ i : Fin rs.length, (Ideal.ofList rs) ^ e i := by
    refine Ideal.prod_mem_prod ?_
    intro i hi
    exact Ideal.pow_mem_pow
      (Ideal.subset_span (by simpa using List.getElem_mem rs i))
      (e i)
  simpa [Finsupp.degree_eq_sum, Finset.prod_pow_eq_pow_sum] using hprod

/-- Helper for Chap10 Lemma 10 69 5: a homogeneous weighted monomial term of total degree `n`
lies in the `n`th filtration stage. -/
private theorem ofList_monomial_weight_smul_mem_of_degree
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A) (n : ℕ) (m : P) (e : Fin rs.length →₀ ℕ) (hdeg : e.degree = n) :
    (∏ i : Fin rs.length, rs.get i ^ e i) • m ∈
      idealAssociatedGradedStage (Ideal.ofList rs) P n := by
  -- The monomial-weight lemma gives membership in `J^n`; acting on `⊤` gives the stage.
  simpa [idealAssociatedGradedStage, hdeg] using
    (Submodule.smul_mem_smul
      (ofList_monomial_weight_mem_pow rs e)
      (by simp : m ∈ (⊤ : Submodule A P)))

/-- Helper for Chap10 Lemma 10 69 5: the associated-graded comparison map sends a monomial
simple tensor to the corresponding homogeneous class. -/
private theorem quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_lof
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    {rs : List A} (m : P) (e : Fin rs.length →₀ ℕ) :
    let J : Ideal A := Ideal.ofList rs
    quasiRegularSequenceAssociatedGradedMap P rs
      (((Submodule.Quotient.mk m : P ⧸ (J • (⊤ : Submodule A P))) ⊗ₜ[A ⧸ J]
        MvPolynomial.monomial e (1 : A ⧸ J))) =
      DirectSum.lof (A ⧸ J) ℕ (idealAssociatedGradedPiece J P) e.degree
        (Submodule.Quotient.mk
          (⟨(∏ i : Fin rs.length, rs.get i ^ e i) • m,
            ofList_monomial_weight_smul_mem_of_degree rs e.degree m e rfl⟩ :
            idealAssociatedGradedStage J P e.degree)) := by
  -- Use the owner computations from `10.69.0.1` and normalize the resulting internal class.
  dsimp [quasiRegularSequenceAssociatedGradedMap]
  let z := quasiRegularAssociatedGradedInternalMonomialClass rs m e
  have hcomm :=
    quasiRegularSequenceAssociatedGradedSourceComm_tmul P rs m e
  have haux :=
    quasiRegularSequenceAssociatedGradedMapAux_tmul_monomial P rs m e
  have hlof := quasiRegularAssociatedGradedAddEquiv_symm_lof P rs e.degree z
  have hpiece :=
    quasiRegularAssociatedGradedInternalPieceEquiv_monomialClass P rs m e
  rw [hcomm, haux, hlof, hpiece]
  rfl

/-- Helper for Chap10 Lemma 10 69 5: conjugating a map by source and target equivalences preserves
injectivity. -/
private theorem injectiveIffOfEquivConjugate
    {α β γ δ : Type*} (eSrc : α ≃ γ) (eTgt : β ≃ δ)
    (f : α → β) (g : γ → δ)
    (hcomm : eTgt ∘ f = g ∘ eSrc) :
    Function.Injective f ↔ Function.Injective g := by
  -- Rewrite the conjugation equality pointwise so the two injectivity arguments can follow the
  -- same transport pattern.
  have hcomm_apply : ∀ x, eTgt (f x) = g (eSrc x) := by
    intro x
    exact congrFun hcomm x
  constructor
  · intro hf x y hxy
    -- Pull `x` and `y` back along `eSrc`, compare them with injectivity of `f`, and push the
    -- equality back to the quotient-side source.
    apply eSrc.symm.injective
    apply hf
    apply eTgt.injective
    calc
      eTgt (f (eSrc.symm x)) = g x := by
        simpa using hcomm_apply (eSrc.symm x)
      _ = g y := hxy
      _ = eTgt (f (eSrc.symm y)) := by
        simpa using (hcomm_apply (eSrc.symm y)).symm
  · intro hg x y hxy
    -- Apply the conjugation equality to the two source points and transfer injectivity across
    -- `eTgt`.
    apply eSrc.injective
    apply hg
    calc
      g (eSrc x) = eTgt (f x) := by
        simpa using (hcomm_apply x).symm
      _ = eTgt (f y) := by
        simpa [hxy]
      _ = g (eSrc y) := by
        simpa using hcomm_apply y

/-- Helper for Chap10 Lemma 10 69 5: list-generated ideals commute with transport along a ring
equivalence. -/
private theorem ofList_map_ringEquiv
    {A B : Type*} [CommRing A] [CommRing B] (eR : A ≃+* B) (rs : List A) :
    Ideal.ofList (rs.map eR) = (Ideal.ofList rs).map (eR : A →+* B) := by
  -- Normalize the quotient-side generated ideal to the image of the source generated ideal.
  simpa using (Ideal.map_ofList (eR : A →+* B) rs).symm

/-- Helper for Chap10 Lemma 10 69 5: a compatible semilinear equivalence sends `I • ⊤` to the
image ideal acting on the target top submodule. -/
private theorem idealSmulTop_map_semilinearEquiv
    {A B : Type*} [CommRing A] [CommRing B] (eR : A ≃+* B)
    {P Q : Type*} [AddCommGroup P] [Module A P] [AddCommGroup Q] [Module B Q]
    (eM : P ≃ₛₗ[(eR : A →+* B)] Q) (I : Ideal A) :
    ((I • (⊤ : Submodule A P)).map eM.toLinearMap) =
      (I.map (eR : A →+* B)) • (⊤ : Submodule B Q) := by
  -- Prove both inclusions by induction on ideal-smul generators; the reverse inclusion pulls
  -- target coefficients and vectors back along the two equivalences.
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    refine Submodule.smul_induction_on hx ?_ ?_
    · intro a ha p hp
      rw [map_smulₛₗ]
      exact Submodule.smul_mem_smul (Ideal.mem_map_of_mem (eR : A →+* B) ha) (by simp)
    · intro x y hx hy
      rw [map_add]
      exact Submodule.add_mem _ hx hy
  · intro hy
    refine Submodule.smul_induction_on hy ?_ ?_
    · intro b hb q hq
      rcases (Ideal.mem_map_of_equiv eR b).mp hb with ⟨a, ha, rfl⟩
      rw [← eM.apply_symm_apply q]
      rw [← map_smulₛₗ]
      exact Submodule.mem_map_of_mem (Submodule.smul_mem_smul ha (by simp))
    · intro x y hx hy
      exact Submodule.add_mem _ hx hy

/-- Helper for Chap10 Lemma 10 69 5: a compatible semilinear equivalence sends the filtration
stage `(Ideal.ofList rs)^n • ⊤` to the corresponding mapped-list stage. -/
private theorem ofListPowSmulTop_map_semilinearEquiv
    {A B : Type*} [CommRing A] [CommRing B] (eR : A ≃+* B)
    {P Q : Type*} [AddCommGroup P] [Module A P] [AddCommGroup Q] [Module B Q]
    (eM : P ≃ₛₗ[(eR : A →+* B)] Q) (rs : List A) (n : ℕ) :
    ((((Ideal.ofList rs) ^ n) • (⊤ : Submodule A P)).map eM.toLinearMap) =
      ((Ideal.ofList (rs.map eR)) ^ n) • (⊤ : Submodule B Q) := by
  -- Push the ideal action through the semilinear map, then rewrite both the image of `⊤` and the
  -- image of the list-generated ideal power.
  calc
    ((((Ideal.ofList rs) ^ n) • (⊤ : Submodule A P)).map eM.toLinearMap)
        = (((Ideal.ofList rs) ^ n).map (eR : A →+* B)) •
            (⊤ : Submodule B Q) := by
            exact idealSmulTop_map_semilinearEquiv eR eM ((Ideal.ofList rs) ^ n)
    _ = ((Ideal.ofList (rs.map eR)) ^ n) • (⊤ : Submodule B Q) := by
          rw [Ideal.map_pow]
          rw [← ofList_map_ringEquiv eR rs]

/-- Helper for Chap10 Lemma 10 69 5: the principal ideal generated by the head element is
contained in the ideal generated by the whole list. -/
private theorem fullTailQuotientRingEquivHeadLe
    {A : Type*} [CommRing A] {r : A} {rs : List A} :
    Ideal.span ({r} : Set A) ≤ Ideal.ofList (r :: rs) := by
  -- The head generator is already one of the generators of the full list ideal.
  simpa [Ideal.ofList_cons] using
    (le_sup_left : Ideal.span ({r} : Set A) ≤ Ideal.span ({r} : Set A) ⊔ Ideal.ofList rs)

/-- Helper for Chap10 Lemma 10 69 5: the one-element list ideal generated by the head term is
contained in the ideal generated by the full cons list. -/
private theorem headOfList_le_consOfList
    {A : Type*} [CommRing A] {r : A} {rs : List A} :
    Ideal.ofList [r] ≤ Ideal.ofList (r :: rs) := by
  -- Convert the head-list ideal to the principal-ideal spelling already used by the quotient
  -- normalization helpers.
  simpa [Ideal.ofList_singleton] using
    (fullTailQuotientRingEquivHeadLe : Ideal.span ({r} : Set A) ≤ Ideal.ofList (r :: rs))

/-- Helper for Chap10 Lemma 10 69 5: after quotienting by the head element, the mapped tail ideal
agrees with the image of the full list ideal. -/
private theorem fullTailQuotientRingEquivMapEq
    {A : Type*} [CommRing A] {r : A} {rs : List A} :
    Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set A)))) =
      (Ideal.ofList (r :: rs)).map (Ideal.Quotient.mk (Ideal.span ({r} : Set A))) := by
  -- Quotienting by `r` kills the head generator and leaves the mapped tail generators.
  rw [Ideal.map_ofList, List.map_cons, Ideal.ofList_cons]
  simp

/-- Helper for Chap10 Lemma 10 69 5: quotienting first by the head element and then by the mapped
tail ideal is canonically equivalent to quotienting once by the full list ideal. -/
private noncomputable def fullTailQuotientRingEquiv
    {A : Type*} [CommRing A] {r : A} {rs : List A} :
    ((A ⧸ Ideal.span ({r} : Set A)) ⧸
      Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set A))))) ≃+*
      A ⧸ Ideal.ofList (r :: rs) :=
  (Ideal.quotEquivOfEq fullTailQuotientRingEquivMapEq).trans
    (DoubleQuot.quotQuotEquivQuotOfLE fullTailQuotientRingEquivHeadLe)

/-- Helper for Chap10 Lemma 10 69 5: the iterated quotient equivalence sends the double quotient
class of `x` to the class of `x` modulo the full list ideal. -/
@[simp] private theorem fullTailQuotientRingEquiv_apply_mk_mk
    {A : Type*} [CommRing A] {r : A} {rs : List A} (x : A) :
    fullTailQuotientRingEquiv
      (Ideal.Quotient.mk
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set A)))))
        (Ideal.Quotient.mk (Ideal.span ({r} : Set A)) x)) =
      Ideal.Quotient.mk (Ideal.ofList (r :: rs)) x := by
  -- Unfold the composite quotient normalization and compute both constituent quotient maps on the
  -- class of the representative `x`.
  change
    (DoubleQuot.quotQuotEquivQuotOfLE
      fullTailQuotientRingEquivHeadLe)
      ((Ideal.quotEquivOfEq
          fullTailQuotientRingEquivMapEq)
        (Ideal.Quotient.mk
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set A)))))
          (Ideal.Quotient.mk (Ideal.span ({r} : Set A)) x))) =
      Ideal.Quotient.mk (Ideal.ofList (r :: rs)) x
  rw [Ideal.quotEquivOfEq_mk]
  simpa [DoubleQuot.quotQuotMk] using
    (DoubleQuot.quotQuotEquivQuotOfLE_quotQuotMk x fullTailQuotientRingEquivHeadLe)

/-- Helper for Chap10 Lemma 10 69 5: the ideal generated by a prefix is contained in the ideal
generated by the corresponding appended list. -/
private theorem prefixAppendQuotientRingEquivPrefixLe
    {A : Type*} [CommRing A] {ys zs : List A} :
    Ideal.ofList ys ≤ Ideal.ofList (ys ++ zs) := by
  -- Normalize the appended list ideal and take the left summand.
  rw [Ideal.ofList_append]
  exact le_sup_left

/-- Helper for Chap10 Lemma 10 69 5: the prefix generators vanish after quotienting by the prefix,
so the image of `Ideal.ofList (ys ++ zs)` is generated by the mapped tail. -/
private theorem prefixAppendQuotientRingEquivMapEq
    {A : Type*} [CommRing A] {ys zs : List A} :
    Ideal.ofList (zs.map (Ideal.Quotient.mk (Ideal.ofList ys))) =
      (Ideal.ofList (ys ++ zs)).map (Ideal.Quotient.mk (Ideal.ofList ys)) := by
  -- Split the mapped appended list into prefix and tail generators; the prefix part is zero in
  -- the quotient ring.
  rw [Ideal.map_ofList, List.map_append, Ideal.ofList_append]
  have hys :
      Ideal.ofList (ys.map (Ideal.Quotient.mk (Ideal.ofList ys))) =
        (⊥ : Ideal (A ⧸ Ideal.ofList ys)) := by
    rw [eq_bot_iff]
    intro x hx
    change x ∈ Submodule.span (A ⧸ Ideal.ofList ys)
      ({x | x ∈ ys.map (Ideal.Quotient.mk (Ideal.ofList ys))}) at hx
    change x ∈ (⊥ : Ideal (A ⧸ Ideal.ofList ys))
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
    · intro x hx
      rcases List.mem_map.mp hx with ⟨y, hy, rfl⟩
      simpa [Submodule.mem_bot] using
        (show Ideal.Quotient.mk (Ideal.ofList ys) y = 0 by
          rw [Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.subset_span hy)
    · simp
    · intro x y _ _ hx0 hy0
      have hxzero : x = 0 := by simpa using hx0
      have hyzero : y = 0 := by simpa using hy0
      simp [hxzero, hyzero]
    · intro a x _ hx0
      have hxzero : x = 0 := by simpa using hx0
      simp [hxzero]
  rw [hys]
  simp

/-- Helper for Chap10 Lemma 10 69 5: quotienting first by a prefix and then by the mapped tail
ideal is canonically equivalent to quotienting once by the appended list ideal. -/
private noncomputable def prefixTailQuotientRingEquiv
    {A : Type*} [CommRing A] {ys zs : List A} :
    ((A ⧸ Ideal.ofList ys) ⧸
      Ideal.ofList (zs.map (Ideal.Quotient.mk (Ideal.ofList ys)))) ≃+*
      A ⧸ Ideal.ofList (ys ++ zs) :=
  (Ideal.quotEquivOfEq prefixAppendQuotientRingEquivMapEq).trans
    (DoubleQuot.quotQuotEquivQuotOfLE prefixAppendQuotientRingEquivPrefixLe)

/-- Helper for Chap10 Lemma 10 69 5: the append-form quotient-ring equivalence sends the double
quotient class of `x` to the class of `x` modulo the appended list ideal. -/
@[simp] private theorem prefixTailQuotientRingEquiv_apply_mk_mk
    {A : Type*} [CommRing A] {ys zs : List A} (x : A) :
    prefixTailQuotientRingEquiv
      (Ideal.Quotient.mk
        (Ideal.ofList (zs.map (Ideal.Quotient.mk (Ideal.ofList ys))))
        (Ideal.Quotient.mk (Ideal.ofList ys) x)) =
      Ideal.Quotient.mk (Ideal.ofList (ys ++ zs)) x := by
  -- Unfold the quotient comparison once and compute each constituent quotient map on the
  -- representative `x`.
  change
    (DoubleQuot.quotQuotEquivQuotOfLE
      prefixAppendQuotientRingEquivPrefixLe)
      ((Ideal.quotEquivOfEq
          prefixAppendQuotientRingEquivMapEq)
        (Ideal.Quotient.mk
          (Ideal.ofList (zs.map (Ideal.Quotient.mk (Ideal.ofList ys))))
          (Ideal.Quotient.mk (Ideal.ofList ys) x))) =
      Ideal.Quotient.mk (Ideal.ofList (ys ++ zs)) x
  rw [Ideal.quotEquivOfEq_mk]
  simpa [DoubleQuot.quotQuotMk] using
    (DoubleQuot.quotQuotEquivQuotOfLE_quotQuotMk x prefixAppendQuotientRingEquivPrefixLe)

/-- Helper for Chap10 Lemma 10 69 5: the full list submodule contains the head principal
submodule. -/
private theorem headQuotientSourceModuleLe
    {r : R} {rs : List R} :
    (Ideal.span ({r} : Set R) • (⊤ : Submodule R M)) ≤
      (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)) := by
  -- The submodule generated by the head ideal sits inside the submodule generated by the full
  -- list ideal because the ideal inclusion is already isolated above.
  simpa using
    (Submodule.smul_mono
      fullTailQuotientRingEquivHeadLe
      (show (⊤ : Submodule R M) ≤ ⊤ from le_rfl))

/-- Helper for Chap10 Lemma 10 69 5: after quotienting the module by the head element, the image
of the full list submodule is the canonical submodule generated by the mapped tail ideal. -/
private theorem headQuotientSourceModuleMapEq
    {r : R} {rs : List R} :
    let K : Ideal R := Ideal.span ({r} : Set R)
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
    ((Ideal.ofList (r :: rs) • (⊤ : Submodule R M)).map (Submodule.mkQ KM)) =
      ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R) := by
  let K : Ideal R := Ideal.span ({r} : Set R)
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
  -- First rewrite the image of the full-list submodule through the quotient map, then convert the
  -- remaining ideal action to the quotient-ring scalar action.
  calc
    ((Ideal.ofList (r :: rs) • (⊤ : Submodule R M)).map (Submodule.mkQ KM))
        = (Ideal.ofList (r :: rs) • (⊤ : Submodule R (M ⧸ KM))) := by
            simp [KM, Submodule.map_smul'', Submodule.range_mkQ]
    _ = (((Ideal.ofList (r :: rs)).map (Ideal.Quotient.mk K)) •
          (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R := by
            symm
            simpa using
              (Ideal.smul_restrictScalars
                (Ideal.ofList (r :: rs))
                (⊤ : Submodule (R ⧸ K) (M ⧸ KM)))
    _ = ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R) := by
          rw [← fullTailQuotientRingEquivMapEq]

/-- Helper for Chap10 Lemma 10 69 5: the degree-zero source quotient can be normalized as an
iterated quotient by the head element and then the mapped tail ideal. -/
private noncomputable def headQuotientSourceModuleEquiv
    {r : R} {rs : List R} :
    let K : Ideal R := Ideal.span ({r} : Set R)
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
    ((M ⧸ KM) ⧸ ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)) ≃ₗ[R]
      M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)) :=
  let K : Ideal R := Ideal.span ({r} : Set R)
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let IM : Submodule R M := Ideal.ofList (r :: rs) • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
  let eDenom :
      ((M ⧸ KM) ⧸ IM.map (Submodule.mkQ KM)) ≃ₗ[R]
        ((M ⧸ KM) ⧸ ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)) :=
    Submodule.quotEquivOfEq
      (IM.map (Submodule.mkQ KM))
      ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)
      headQuotientSourceModuleMapEq
  -- Replace the denominator by the quotient-side tail ideal and then apply the module version of
  -- the third isomorphism theorem.
  eDenom.symm.trans
    (Submodule.quotientQuotientEquivQuotient KM IM
      headQuotientSourceModuleLe)

/-- Helper for Chap10 Lemma 10 69 5: the degree-zero source quotient equivalence sends the doubly
quotiented class of an element to its class modulo the full list ideal. -/
@[simp] private theorem headQuotientSourceModuleEquiv_apply_mk_mk
    {r : R} {rs : List R} (x : M) :
    let K : Ideal R := Ideal.span ({r} : Set R)
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
    let eQuot :
        ((M ⧸ KM) ⧸ ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)) ≃ₗ[R]
          M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)) :=
      headQuotientSourceModuleEquiv
    eQuot (Submodule.Quotient.mk (Submodule.Quotient.mk x)) = Submodule.Quotient.mk x := by
  let K : Ideal R := Ideal.span ({r} : Set R)
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let IM : Submodule R M := Ideal.ofList (r :: rs) • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
  -- Unfold the composite normalization and compute both constituent quotient equivalences on the
  -- double quotient class of `x`.
  change
    (Submodule.quotientQuotientEquivQuotient KM IM
        headQuotientSourceModuleLe)
      ((Submodule.quotEquivOfEq
          (IM.map (Submodule.mkQ KM))
          ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)
          headQuotientSourceModuleMapEq).symm
        (Submodule.Quotient.mk (Submodule.Quotient.mk x))) =
      Submodule.Quotient.mk x
  -- The denominator-change equivalence fixes quotient constructors, so the remaining computation
  -- is exactly the standard third-isomorphism formula on `x`.
  have hDenom :
      ((Submodule.quotEquivOfEq
          (IM.map (Submodule.mkQ KM))
          ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)
          headQuotientSourceModuleMapEq).symm
        (Submodule.Quotient.mk (Submodule.Quotient.mk x))) =
      Submodule.Quotient.mk (Submodule.Quotient.mk x) := by
    rfl
  rw [hDenom]
  exact
    (Submodule.quotientQuotientEquivQuotientAux_mk_mk KM IM
      headQuotientSourceModuleLe x)

/-- Helper for Chap10 Lemma 10 69 5: the submodule generated by a prefix is contained in the
submodule generated by the corresponding appended list. -/
private theorem prefixAppendSourceModuleLe
    {ys zs : List R} :
    (Ideal.ofList ys • (⊤ : Submodule R M)) ≤
      (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)) := by
  -- The submodule inclusion follows from the corresponding list-ideal inclusion.
  exact
    Submodule.smul_mono
      prefixAppendQuotientRingEquivPrefixLe
      (show (⊤ : Submodule R M) ≤ ⊤ from le_rfl)

/-- Helper for Chap10 Lemma 10 69 5: after quotienting the module by the prefix, the image of the
full appended-list submodule is the canonical submodule generated by the mapped tail ideal. -/
private theorem prefixAppendSourceModuleMapEq
    {ys zs : List R} :
    let K : Ideal R := Ideal.ofList ys
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let Jbar : Ideal (R ⧸ K) := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
    ((Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)).map (Submodule.mkQ KM)) =
      ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R) := by
  let K : Ideal R := Ideal.ofList ys
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
  -- First push the full submodule through the quotient map, then rewrite the ideal action through
  -- the quotient-ring scalar action and the append/tail ideal identity.
  calc
    ((Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)).map (Submodule.mkQ KM))
        = (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R (M ⧸ KM))) := by
            simp [KM, Submodule.map_smul'', Submodule.range_mkQ]
    _ = (((Ideal.ofList (ys ++ zs)).map (Ideal.Quotient.mk K)) •
          (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R := by
            symm
            simpa using
              (Ideal.smul_restrictScalars
                (Ideal.ofList (ys ++ zs))
                (⊤ : Submodule (R ⧸ K) (M ⧸ KM)))
    _ = ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R) := by
          rw [← prefixAppendQuotientRingEquivMapEq]

/-- Helper for Chap10 Lemma 10 69 5: the iterated coefficient quotient by a prefix and then by
the mapped tail is canonically equivalent to the single quotient by `Ideal.ofList (ys ++ zs)`. -/
private noncomputable def prefixTailCoefficientQuotientEquiv
    {ys zs : List R} :
    let K : Ideal R := Ideal.ofList ys
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let Jbar : Ideal (R ⧸ K) := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
    ((M ⧸ KM) ⧸ ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)) ≃ₗ[R]
      M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)) :=
  let K : Ideal R := Ideal.ofList ys
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let IM : Submodule R M := Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
  let eDenom :
      ((M ⧸ KM) ⧸ IM.map (Submodule.mkQ KM)) ≃ₗ[R]
        ((M ⧸ KM) ⧸ ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)) :=
    Submodule.quotEquivOfEq
      (IM.map (Submodule.mkQ KM))
      ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)
      prefixAppendSourceModuleMapEq
  -- Replace the denominator by the quotient-side tail ideal and then apply the module version of
  -- the third isomorphism theorem.
  eDenom.symm.trans
    (Submodule.quotientQuotientEquivQuotient KM IM
      prefixAppendSourceModuleLe)

/-- Helper for Chap10 Lemma 10 69 5: the append-form coefficient quotient equivalence sends the
double quotient class of an element to its class modulo the full appended-list submodule. -/
@[simp] private theorem prefixTailCoefficientQuotientEquiv_apply_mk_mk
    {ys zs : List R} (x : M) :
    let K : Ideal R := Ideal.ofList ys
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let Jbar : Ideal (R ⧸ K) := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
    let eQuot :
        ((M ⧸ KM) ⧸ ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)) ≃ₗ[R]
          M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)) :=
      prefixTailCoefficientQuotientEquiv
    eQuot (Submodule.Quotient.mk (Submodule.Quotient.mk x)) = Submodule.Quotient.mk x := by
  let K : Ideal R := Ideal.ofList ys
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let IM : Submodule R M := Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
  -- Unfold the composite quotient normalization and compute both quotient equivalences on the
  -- double quotient class of `x`.
  change
    (Submodule.quotientQuotientEquivQuotient KM IM
        prefixAppendSourceModuleLe)
      ((Submodule.quotEquivOfEq
          (IM.map (Submodule.mkQ KM))
          ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)
          prefixAppendSourceModuleMapEq).symm
        (Submodule.Quotient.mk (Submodule.Quotient.mk x))) =
      Submodule.Quotient.mk x
  have hDenom :
      ((Submodule.quotEquivOfEq
          (IM.map (Submodule.mkQ KM))
          ((Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R)
          prefixAppendSourceModuleMapEq).symm
        (Submodule.Quotient.mk (Submodule.Quotient.mk x))) =
      Submodule.Quotient.mk (Submodule.Quotient.mk x) := by
    rfl
  rw [hDenom]
  exact
    (Submodule.quotientQuotientEquivQuotientAux_mk_mk KM IM
      prefixAppendSourceModuleLe x)

/-- Helper for Chap10 Lemma 10 69 5: the restricted-scalar presentation of the double quotient
coefficient module is fixed on double quotient representatives by the append-form equivalence. -/
@[simp] private theorem prefixTailCoefficientQuotientEquiv_restrict_apply_mk_mk
    {ys zs : List R} (x : M) :
    let K : Ideal R := Ideal.ofList ys
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let A : Type u := R ⧸ K
    let Jbar : Ideal A := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
    let eRestrict :=
      (Submodule.Quotient.restrictScalarsEquiv R
        (Jbar • (⊤ : Submodule A (M ⧸ KM)))).symm
    let eQuot :
        ((M ⧸ KM) ⧸ ((Jbar • (⊤ : Submodule A (M ⧸ KM))).restrictScalars R)) ≃ₗ[R]
          M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)) :=
      prefixTailCoefficientQuotientEquiv
    eQuot
      (eRestrict (Submodule.Quotient.mk (Submodule.Quotient.mk x))) =
      Submodule.Quotient.mk x := by
  let K : Ideal R := Ideal.ofList ys
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let A : Type u := R ⧸ K
  let Jbar : Ideal A := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
  let eRestrict :=
    (Submodule.Quotient.restrictScalarsEquiv R
      (Jbar • (⊤ : Submodule A (M ⧸ KM)))).symm
  -- First remove the restricted-scalar equivalence on a constructor, then use the existing
  -- append-form coefficient quotient computation.
  dsimp only
  rw [Submodule.Quotient.restrictScalarsEquiv_symm_mk]
  exact prefixTailCoefficientQuotientEquiv_apply_mk_mk x

/-- Helper for Chap10 Lemma 10 69 5: scalar multiplication in the double coefficient quotient
sends double representatives to the representative of the scalar product. -/
@[simp] private theorem prefixTailSourceQuotient_smul_mk_mk
    {ys zs : List R} (a : R) (x : M) :
    let K : Ideal R := Ideal.ofList ys
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let A : Type u := R ⧸ K
    let Jbar : Ideal A := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
    let sourceModule : Module ((R ⧸ K) ⧸ Jbar)
        ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) :=
      Module.instQuotientIdealSubmoduleHSMulTop (M ⧸ KM) Jbar
    let sourceSmul :
        HSMul ((R ⧸ K) ⧸ Jbar)
          ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM))))
          ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) :=
      @instHSMul _ _ sourceModule.toSMul
    @HSMul.hSMul _ _ _ sourceSmul
      (Ideal.Quotient.mk Jbar (Ideal.Quotient.mk K a))
      (Submodule.Quotient.mk (Submodule.Quotient.mk x)) =
      Submodule.Quotient.mk (Submodule.Quotient.mk (a • x)) := by
  let K : Ideal R := Ideal.ofList ys
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let A : Type u := R ⧸ K
  let Jbar : Ideal A := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
  let sourceModule : Module ((R ⧸ K) ⧸ Jbar)
      ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) :=
    Module.instQuotientIdealSubmoduleHSMulTop (M ⧸ KM) Jbar
  let sourceSmul :
      HSMul ((R ⧸ K) ⧸ Jbar)
        ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM))))
        ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) :=
    @instHSMul _ _ sourceModule.toSMul
  -- Compute the outer quotient action, then compute the quotient-ring action on the inner
  -- coefficient representative.
  dsimp only
  rw [Module.Quotient.mk_smul_mk]
  rw [Module.Quotient.mk_smul_mk]

/-- Helper for Chap10 Lemma 10 69 5: the append-form coefficient quotient equivalence is
compatible with scalar transport through the append-form quotient-ring equivalence. -/
private theorem prefixTailCoefficientQuotientEquiv_map_smul
    {ys zs : List R} :
    let K : Ideal R := Ideal.ofList ys
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let A : Type u := R ⧸ K
    let Jbar : Ideal A := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
    let sourceModule : Module ((R ⧸ K) ⧸ Jbar)
        ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) :=
      Module.instQuotientIdealSubmoduleHSMulTop (M ⧸ KM) Jbar
    let sourceSmul :
        HSMul ((R ⧸ K) ⧸ Jbar)
          ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM))))
          ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) :=
      @instHSMul _ _ sourceModule.toSMul
    let targetModule : Module (R ⧸ Ideal.ofList (ys ++ zs))
        (M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M))) :=
      Module.instQuotientIdealSubmoduleHSMulTop M (Ideal.ofList (ys ++ zs))
    let targetSmul :
        HSMul (R ⧸ Ideal.ofList (ys ++ zs))
          (M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)))
          (M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M))) :=
      @instHSMul _ _ targetModule.toSMul
    let eRestrict :=
      (Submodule.Quotient.restrictScalarsEquiv R
        (Jbar • (⊤ : Submodule A (M ⧸ KM)))).symm
    ∀ (a : ((R ⧸ K) ⧸ Jbar))
      (x : ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM))))),
      prefixTailCoefficientQuotientEquiv
          (eRestrict (@HSMul.hSMul _ _ _ sourceSmul a x)) =
        @HSMul.hSMul _ _ _ targetSmul
          (prefixTailQuotientRingEquiv a)
          (prefixTailCoefficientQuotientEquiv
            (eRestrict x)) := by
  let K : Ideal R := Ideal.ofList ys
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let A : Type u := R ⧸ K
  let Jbar : Ideal A := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
  let sourceModule : Module ((R ⧸ K) ⧸ Jbar)
      ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) :=
    Module.instQuotientIdealSubmoduleHSMulTop (M ⧸ KM) Jbar
  let sourceSmul :
      HSMul ((R ⧸ K) ⧸ Jbar)
        ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM))))
        ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) :=
    @instHSMul _ _ sourceModule.toSMul
  let targetModule : Module (R ⧸ Ideal.ofList (ys ++ zs))
      (M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M))) :=
    Module.instQuotientIdealSubmoduleHSMulTop M (Ideal.ofList (ys ++ zs))
  let targetSmul :
      HSMul (R ⧸ Ideal.ofList (ys ++ zs))
        (M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M)))
        (M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M))) :=
    @instHSMul _ _ targetModule.toSMul
  let eRestrict :=
    (Submodule.Quotient.restrictScalarsEquiv R
      (Jbar • (⊤ : Submodule A (M ⧸ KM)))).symm
  -- Check scalar compatibility on quotient representatives; the named quotient-equivalence
  -- computation lemmas then reduce both sides to the same single quotient class.
  dsimp only
  intro a x
  refine Quotient.inductionOn' a ?_
  intro a₀
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a₀
  refine Quotient.inductionOn' x ?_
  intro x₀
  refine Quotient.inductionOn' x₀ ?_
  intro x
  -- On representatives both sides are the class of `a • x` in the single appended quotient.
  simp only [Submodule.Quotient.mk''_eq_mk, Ideal.Quotient.mk_eq_mk]
  rw [prefixTailSourceQuotient_smul_mk_mk a x]
  rw [prefixTailCoefficientQuotientEquiv_restrict_apply_mk_mk (a • x)]
  rw [prefixTailCoefficientQuotientEquiv_restrict_apply_mk_mk x]
  rw [prefixTailQuotientRingEquiv_apply_mk_mk a]
  rw [Module.Quotient.mk_smul_mk]

/-- Helper for Chap10 Lemma 10 69 5: the iterated coefficient quotient by a prefix and mapped
tail is semilinearly equivalent to the single quotient by the appended list. -/
private noncomputable def prefixTailCoefficientQuotientSemilinearEquiv
    {ys zs : List R} :
    let K : Ideal R := Ideal.ofList ys
    let KM : Submodule R M := K • (⊤ : Submodule R M)
    let A : Type u := R ⧸ K
    let Jbar : Ideal A := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
    ((M ⧸ KM) ⧸ (Jbar • (⊤ : Submodule A (M ⧸ KM)))) ≃ₛₗ[
      ((show ((R ⧸ K) ⧸ Jbar) ≃+* (R ⧸ Ideal.ofList (ys ++ zs)) from
          prefixTailQuotientRingEquiv) :
        ((R ⧸ K) ⧸ Jbar) →+* (R ⧸ Ideal.ofList (ys ++ zs)))]
      (M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M))) :=
  let K : Ideal R := Ideal.ofList ys
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let A : Type u := R ⧸ K
  let Jbar : Ideal A := Ideal.ofList (zs.map (Ideal.Quotient.mk K))
  let P : Submodule A (M ⧸ KM) := Jbar • (⊤ : Submodule A (M ⧸ KM))
  let eRestrict : ((M ⧸ KM) ⧸ P) ≃ₗ[R] ((M ⧸ KM) ⧸ P.restrictScalars R) :=
    (Submodule.Quotient.restrictScalarsEquiv R P).symm
  let eLinear : ((M ⧸ KM) ⧸ P) ≃ₗ[R]
      (M ⧸ (Ideal.ofList (ys ++ zs) • (⊤ : Submodule R M))) :=
    eRestrict.trans prefixTailCoefficientQuotientEquiv
  { toFun := eLinear
    invFun := eLinear.symm
    left_inv := eLinear.left_inv
    right_inv := eLinear.right_inv
    map_add' := eLinear.map_add
    map_smul' := prefixTailCoefficientQuotientEquiv_map_smul }

/-- Helper for Chap10 Lemma 10 69 5: quotienting the full source polynomial ring by the head
variable leaves the tail polynomial ring. -/
private noncomputable def headVariablePolynomialQuotientEquiv
    {A : Type*} [CommRing A] (n : ℕ) :
    (MvPolynomial (Fin (n + 1)) A ⧸
      Ideal.span ({MvPolynomial.X (0 : Fin (n + 1))} : Set (MvPolynomial (Fin (n + 1)) A))) ≃ₐ[A]
      MvPolynomial (Fin n) A :=
  let ePoly : MvPolynomial (Fin (n + 1)) A ≃ₐ[A] Polynomial (MvPolynomial (Fin n) A) :=
    MvPolynomial.finSuccEquiv A n
  let eQuot :
      (MvPolynomial (Fin (n + 1)) A ⧸
        Ideal.span ({MvPolynomial.X (0 : Fin (n + 1))} : Set (MvPolynomial (Fin (n + 1)) A))) ≃ₐ[A]
        (Polynomial (MvPolynomial (Fin n) A) ⧸
          Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin n) A)))) :=
    Ideal.quotientEquivAlg
      (Ideal.span ({MvPolynomial.X (0 : Fin (n + 1))} : Set (MvPolynomial (Fin (n + 1)) A)))
      (Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin n) A))))
      ePoly
      (by
        -- Mapping the principal ideal generated by the head variable through `finSuccEquiv`
        -- produces the principal ideal generated by the polynomial variable `X`.
        have hX0 :
            (MvPolynomial.finSuccEquiv A n) (MvPolynomial.X (0 : Fin (n + 1))) = Polynomial.X := by
          simpa using
            (MvPolynomial.finSuccEquiv_X_zero :
              (MvPolynomial.finSuccEquiv A n) (MvPolynomial.X (0 : Fin (n + 1))) = Polynomial.X)
        rw [Ideal.map_span]
        simpa [Set.image_singleton, ePoly] using
          congrArg
            (fun x : Polynomial (MvPolynomial (Fin n) A) ↦
              Ideal.span ({x} : Set (Polynomial (MvPolynomial (Fin n) A))))
            hX0.symm)
  let eX :
      (Polynomial (MvPolynomial (Fin n) A) ⧸
        Ideal.span ({Polynomial.X} : Set (Polynomial (MvPolynomial (Fin n) A)))) ≃ₐ[A]
        (Polynomial (MvPolynomial (Fin n) A) ⧸
          Ideal.span ({Polynomial.X - Polynomial.C 0} :
            Set (Polynomial (MvPolynomial (Fin n) A)))) :=
    Ideal.quotientEquivAlgOfEq A (by simp)
  -- After `finSuccEquiv`, the quotient is the usual polynomial quotient by `X`, which evaluates
  -- at zero to recover the coefficient ring.
  eQuot.trans <|
    eX.trans ((Polynomial.quotientSpanXSubCAlgEquiv (0 : MvPolynomial (Fin n) A)).restrictScalars A)

/-- Helper for Chap10 Lemma 10 69 5: the head-variable polynomial quotient sends the head
variable `X 0` to zero. -/
@[simp] private theorem headVariablePolynomialQuotientEquiv_mk_X_zero
    {A : Type*} [CommRing A] (n : ℕ) :
    headVariablePolynomialQuotientEquiv n
      (Ideal.Quotient.mk
        (Ideal.span
          ({MvPolynomial.X (0 : Fin (n + 1))} :
            Set (MvPolynomial (Fin (n + 1)) A)))
        (MvPolynomial.X (0 : Fin (n + 1)))) =
      0 := by
  -- Unfold the quotient equivalence once: `finSuccEquiv` carries `X 0` to `Polynomial.X`, and
  -- evaluation at zero kills that polynomial variable.
  dsimp [headVariablePolynomialQuotientEquiv]
  simpa [MvPolynomial.finSuccEquiv_X_zero]

/-- Helper for Chap10 Lemma 10 69 5: the polynomial map that sends the head variable to zero and
successor variables to the corresponding tail variables. -/
private noncomputable def headVariablePolynomialEvalZeroAlgHom
    {A : Type*} [CommRing A] (n : ℕ) :
    MvPolynomial (Fin (n + 1)) A →ₐ[A] MvPolynomial (Fin n) A :=
  MvPolynomial.aeval
    (fun i : Fin (n + 1) ↦ Fin.cases 0 (fun j : Fin n ↦ MvPolynomial.X j) i)

/-- Helper for Chap10 Lemma 10 69 5: the head-variable evaluation map kills `X 0`. -/
@[simp] private theorem headVariablePolynomialEvalZeroAlgHom_X_zero
    {A : Type*} [CommRing A] (n : ℕ) :
    (@headVariablePolynomialEvalZeroAlgHom A _ n)
      (MvPolynomial.X (0 : Fin (n + 1))) = 0 := by
  -- The named evaluation map is defined by `MvPolynomial.aeval`, so the first-variable
  -- computation is definitional for the evaluator.
  simp [headVariablePolynomialEvalZeroAlgHom]

/-- Helper for Chap10 Lemma 10 69 5: the tail polynomial ring embeds into the full polynomial
ring by sending each variable to its successor. -/
private noncomputable def headVariablePolynomialIncludeAlgHom
    {A : Type*} [CommRing A] (n : ℕ) :
    MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin (n + 1)) A :=
  MvPolynomial.rename fun j : Fin n ↦ j.succ

/-- Helper for Chap10 Lemma 10 69 5: evaluating at `X 0 = 0` after inserting only successor
variables recovers the original tail polynomial. -/
@[simp] private theorem headVariablePolynomialEvalZeroAlgHom_include
    {A : Type*} [CommRing A] (n : ℕ)
    (p : MvPolynomial (Fin n) A) :
    headVariablePolynomialEvalZeroAlgHom n
        (headVariablePolynomialIncludeAlgHom n p) =
      p := by
  -- After rewriting through `aeval_rename`, the variable map becomes the identity on the tail
  -- variables, so the resulting `aeval` is just `bind₁ X = id`.
  rw [headVariablePolynomialEvalZeroAlgHom, headVariablePolynomialIncludeAlgHom,
    MvPolynomial.aeval_rename]
  change MvPolynomial.aeval (fun j : Fin n ↦ MvPolynomial.X j) p = p
  rw [MvPolynomial.aeval_eq_bind₁]
  simpa using
    congrArg
      (fun F : MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin n) A ↦ F p)
      (MvPolynomial.bind₁_X_left (σ := Fin n) (R := A))

/-- Helper for Chap10 Lemma 10 69 5: the principal ideal generated by the head variable lies in
the kernel of the polynomial evaluation-at-zero map. -/
private theorem headVariablePolynomialPrincipal_le_ker
    {A : Type*} [CommRing A] (n : ℕ) :
    let X0Ideal : Ideal (MvPolynomial (Fin (n + 1)) A) :=
      Ideal.span
        ({MvPolynomial.X (0 : Fin (n + 1))} :
          Set (MvPolynomial (Fin (n + 1)) A))
    X0Ideal.restrictScalars A ≤
      LinearMap.ker ((@headVariablePolynomialEvalZeroAlgHom A _ n).toLinearMap) := by
  let X0Ideal : Ideal (MvPolynomial (Fin (n + 1)) A) :=
    Ideal.span
      ({MvPolynomial.X (0 : Fin (n + 1))} :
        Set (MvPolynomial (Fin (n + 1)) A))
  -- Apply the generic principal-ideal kernel lemma to the named evaluation map and its head
  -- variable computation.
  exact
    principalIdealRestrictScalars_le_ker_of_map_eq_zero
      (@headVariablePolynomialEvalZeroAlgHom A _ n)
      (MvPolynomial.X (0 : Fin (n + 1)))
      (@headVariablePolynomialEvalZeroAlgHom_X_zero A _ n)

/-- Helper for Chap10 Lemma 10 69 5: tensoring with coefficients preserves the fact that the
head-variable-generated source submodule is killed by evaluation at zero. -/
private theorem headVariableTensorRange_le_ker
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P] (n : ℕ) :
    let X0Ideal : Ideal (MvPolynomial (Fin (n + 1)) A) :=
      Ideal.span
        ({MvPolynomial.X (0 : Fin (n + 1))} :
          Set (MvPolynomial (Fin (n + 1)) A))
    LinearMap.range
        (TensorProduct.map (LinearMap.id : P →ₗ[A] P)
          (X0Ideal.restrictScalars A).subtype) ≤
      LinearMap.ker
        (TensorProduct.map (LinearMap.id : P →ₗ[A] P)
          ((@headVariablePolynomialEvalZeroAlgHom A _ n).toLinearMap)) := by
  let X0Ideal : Ideal (MvPolynomial (Fin (n + 1)) A) :=
    Ideal.span
      ({MvPolynomial.X (0 : Fin (n + 1))} :
        Set (MvPolynomial (Fin (n + 1)) A))
  -- Reduce the tensor-kernel statement to the polynomial-factor kernel inclusion just proved.
  exact
    tensorProductMapIdSubtype_range_le_ker
      (X0Ideal.restrictScalars A)
      ((@headVariablePolynomialEvalZeroAlgHom A _ n).toLinearMap)
      (@headVariablePolynomialPrincipal_le_ker A _ n)

/-- Helper for Chap10 Lemma 10 69 5: after applying the explicit source-side multiplication map
by `X i`, the coefficient at `single i 1 + e` is the original coefficient at `e`. -/
private theorem sourceQuotientTensor_X_coeff
    {A : Type*} [CommRing A] {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A) (i : Fin rs.length)
    (z : TensorProduct (A ⧸ Ideal.ofList rs)
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
      (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)))
    (e : Fin rs.length →₀ ℕ) :
    let scalar :
        TensorProduct (A ⧸ Ideal.ofList rs)
          (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
          (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)) ≃ₗ[A ⧸ Ideal.ofList rs]
            (Fin rs.length →₀ ℕ) →₀ (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)) :=
      MvPolynomial.scalarRTensor
    scalar
        (((LinearMap.mulLeft (A ⧸ Ideal.ofList rs)
          (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).rTensor
            (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))) z)
        (Finsupp.single i 1 + e) =
      scalar z e := by
  -- Check the formula on simple tensors, where it is the standard coefficient formula for
  -- multiplying a multivariable polynomial by `X i`.
  induction z using TensorProduct.induction_on with
  | zero =>
      simp
  | tmul p q =>
      simp [LinearMap.rTensor_tmul, MvPolynomial.scalarRTensor_apply_tmul_apply,
        MvPolynomial.coeff_X_mul']
  | add x y hx hy =>
      simp [map_add, hx, hy]

/-- Helper for Chap10 Lemma 10 69 5: multiplication by a polynomial variable is injective on
the quotient source tensor in its canonical left-polynomial orientation. -/
private theorem sourceQuotientTensor_X_linearMap_eq_zero
    {A : Type*} [CommRing A] {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A) (i : Fin rs.length)
    {z : TensorProduct (A ⧸ Ideal.ofList rs)
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
      (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))}
    (hz : ((LinearMap.mulLeft (A ⧸ Ideal.ofList rs)
        (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).rTensor
          (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))) z = 0) :
    z = 0 := by
  let scalar :
      TensorProduct (A ⧸ Ideal.ofList rs)
        (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
        (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)) ≃ₗ[A ⧸ Ideal.ofList rs]
          (Fin rs.length →₀ ℕ) →₀ (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)) :=
    MvPolynomial.scalarRTensor
  -- The coefficient at `single i 1 + e` after multiplication recovers the original `e`
  -- coefficient, so all source coefficients vanish.
  apply scalar.injective
  ext e
  have hcoeff :=
    congrArg (fun w ↦ (scalar w) (Finsupp.single i 1 + e)) hz
  have hcoeff' :
      (scalar (((LinearMap.mulLeft (A ⧸ Ideal.ofList rs)
        (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).rTensor
          (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))) z))
          (Finsupp.single i 1 + e) = (scalar 0) (Finsupp.single i 1 + e) := by
    simpa using hcoeff
  rw [sourceQuotientTensor_X_coeff rs i z e] at hcoeff'
  simpa using hcoeff'

/-- Helper for Chap10 Lemma 10 69 5: commuting the textbook source tensor carries scalar
multiplication by `X i` to the explicit left-multiplication tensor map. -/
private theorem sourceComm_X_smul_eq_linearMap
    {A : Type*} [CommRing A] {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A) (i : Fin rs.length)
    (z : (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)) ⊗[A ⧸ Ideal.ofList rs]
      MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs)) :
    let comm := quasiRegularSequenceAssociatedGradedSourceComm P rs
    comm ((quasiRegularSequenceAssociatedGradedTextbookSourceModule P rs).smul
      (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs)) z) =
      ((LinearMap.mulLeft (A ⧸ Ideal.ofList rs)
        (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).rTensor
          (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))) (comm z) := by
  let comm := quasiRegularSequenceAssociatedGradedSourceComm P rs
  -- Unfold the transported module structure to the canonical commute-act-commute normal form.
  change (TensorProduct.comm (A ⧸ Ideal.ofList rs)
      (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs)))
    ((TensorProduct.comm (A ⧸ Ideal.ofList rs)
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
      (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)))
      (((LinearMap.mulLeft (A ⧸ Ideal.ofList rs)
        (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).rTensor
          (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)))
          ((TensorProduct.comm (A ⧸ Ideal.ofList rs)
            (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))
            (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))) z))) =
    ((LinearMap.mulLeft (A ⧸ Ideal.ofList rs)
      (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).rTensor
        (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)))
        ((TensorProduct.comm (A ⧸ Ideal.ofList rs)
          (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))
          (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))) z)
  simp

/-- Helper for Chap10 Lemma 10 69 5: the same source-tensor zero-kernel statement in the
textbook quotient-source orientation used by `IsQuasiRegular.linearEquiv`. -/
private theorem textbookSourceTensor_X_smul_eq_zero
    {A : Type*} [CommRing A] {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A) (i : Fin rs.length)
    {z : (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P)) ⊗[A ⧸ Ideal.ofList rs]
      MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs)}
    (hz : (quasiRegularSequenceAssociatedGradedTextbookSourceModule P rs).smul
      (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs)) z = 0) :
    z = 0 := by
  let comm := quasiRegularSequenceAssociatedGradedSourceComm P rs
  -- Commute the tensor factors once, then use the canonical left-polynomial orientation.
  apply (TensorProduct.comm (A ⧸ Ideal.ofList rs)
    (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))
    (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).injective
  have hcomm_zero : comm ((quasiRegularSequenceAssociatedGradedTextbookSourceModule P rs).smul
      (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs)) z) = 0 := by
    exact congrArg comm hz
  have hlinear_zero :
      ((LinearMap.mulLeft (A ⧸ Ideal.ofList rs)
        (MvPolynomial.X i : MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))).rTensor
          (P ⧸ ((Ideal.ofList rs) • ⊤ : Submodule A P))) (comm z) = 0 := by
    rwa [sourceComm_X_smul_eq_linearMap rs i z] at hcomm_zero
  exact sourceQuotientTensor_X_linearMap_eq_zero rs i hlinear_zero

/-- Helper for Chap10 Lemma 10 69 5: the head-variable polynomial quotient sends each successor
variable `X j.succ` to the corresponding tail variable `X j`. -/
@[simp] private theorem headVariablePolynomialQuotientEquiv_mk_X_succ
    {A : Type*} [CommRing A] (n : ℕ) (j : Fin n) :
    headVariablePolynomialQuotientEquiv n
      (Ideal.Quotient.mk
        (Ideal.span
          ({MvPolynomial.X (0 : Fin (n + 1))} :
            Set (MvPolynomial (Fin (n + 1)) A)))
        (MvPolynomial.X j.succ)) =
      MvPolynomial.X j := by
  -- After `finSuccEquiv`, successor variables become constant polynomials in the tail variables,
  -- and evaluation at zero leaves that constant unchanged.
  dsimp [headVariablePolynomialQuotientEquiv]
  simpa [MvPolynomial.finSuccEquiv_X_succ]

/-- Helper for Chap10 Lemma 10 69 5: the head-variable polynomial quotient fixes coefficient
constants. -/
@[simp] private theorem headVariablePolynomialQuotientEquiv_mk_C
    {A : Type*} [CommRing A] (n : ℕ) (a : A) :
    headVariablePolynomialQuotientEquiv n
      (Ideal.Quotient.mk
        (Ideal.span
          ({MvPolynomial.X (0 : Fin (n + 1))} :
            Set (MvPolynomial (Fin (n + 1)) A)))
        (MvPolynomial.C a)) =
      MvPolynomial.C a := by
  -- Constants are carried to constants by `finSuccEquiv`, and evaluation at zero preserves them.
  dsimp [headVariablePolynomialQuotientEquiv]
  simpa [MvPolynomial.finSuccEquiv_apply]

/-- Helper for Chap10 Lemma 10 69 5: the head-variable polynomial quotient equivalence agrees
with evaluation at `X 0 = 0` on representatives. -/
@[simp] private theorem headVariablePolynomialQuotientEquiv_apply_mk
    {A : Type*} [CommRing A] (n : ℕ)
    (p : MvPolynomial (Fin (n + 1)) A) :
    headVariablePolynomialQuotientEquiv n
      (Ideal.Quotient.mk
        (Ideal.span
          ({MvPolynomial.X (0 : Fin (n + 1))} :
            Set (MvPolynomial (Fin (n + 1)) A)))
        p) =
      headVariablePolynomialEvalZeroAlgHom n p := by
  -- Unfold the quotient equivalence once: after `finSuccEquiv`, quotienting by `X 0` is
  -- polynomial evaluation at `0`, which is exactly the named `aeval` map below.
  dsimp [headVariablePolynomialQuotientEquiv]
  simpa [headVariablePolynomialEvalZeroAlgHom, MvPolynomial.aeval_eq_bind₁] using
    (MvPolynomial.eval_polynomial_eval_finSuccEquiv
      (R := A)
      (n := n)
      (x := fun j : Fin n ↦ MvPolynomial.X j)
      p
      0)

/-- Helper for Chap10 Lemma 10 69 5: an `R`-linear equivalence transports the degree-zero quotient
submodule `Ideal.ofList rs • ⊤` to the corresponding quotient submodule in the target module. -/
private theorem ofListSmulTopMapEqLinear
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) {rs : List R} :
    ((Ideal.ofList rs) • (⊤ : Submodule R P)).map e.toLinearMap =
      Ideal.ofList rs • (⊤ : Submodule R Q) := by
  -- Rewrite the source ideal-smul through `e`, then normalize the image of `⊤`.
  calc
    ((Ideal.ofList rs) • (⊤ : Submodule R P)).map e.toLinearMap
        = Ideal.ofList rs • (⊤ : Submodule R P).map e.toLinearMap := by
            rw [Submodule.map_smul'']
    _ = Ideal.ofList rs • (⊤ : Submodule R Q) := by
          rw [Submodule.map_top, LinearMap.range_eq_top.2 e.surjective]

/-- Helper for Chap10 Lemma 10 69 5: after restricting scalars along a quotient map, the original
`R`-action agrees with the quotient-ring scalar action. -/
private theorem idealScalarActionEqQuotientScalarAction
    (I : Ideal R) {N : Type*} [AddCommGroup N] [Module (R ⧸ I) N] [Module R N]
    [IsScalarTower R (R ⧸ I) N]
    (r : R) (x : N) :
    r • x = ((Ideal.Quotient.mk I) r : R ⧸ I) • x := by
  -- Rewrite the restricted scalar action through the quotient-ring unit.
  calc
    r • x = r • ((1 : R ⧸ I) • x) := by simp
    _ = (r • (1 : R ⧸ I)) • x := by rw [smul_assoc]
    _ = ((Ideal.Quotient.mk I) r : R ⧸ I) • x := by
      change ((((Ideal.Quotient.mk I) r : R ⧸ I) * 1) : R ⧸ I) • x =
        ((Ideal.Quotient.mk I) r : R ⧸ I) • x
      simp

/-- Helper for Chap10 Lemma 10 69 5: an `R`-linear equivalence between modules already defined
over `R / I` is automatically `(R / I)`-linear. -/
private theorem linearEquivMapSmulOverQuotient
    (I : Ideal R)
    {P : Type*} [AddCommGroup P] [Module (R ⧸ I) P] [Module R P]
    [IsScalarTower R (R ⧸ I) P]
    {Q : Type*} [AddCommGroup Q] [Module (R ⧸ I) Q] [Module R Q]
    [IsScalarTower R (R ⧸ I) Q]
    (e : P ≃ₗ[R] Q) (c : R ⧸ I) (x : P) :
    e (c • x) = c • e x := by
  -- Reduce quotient scalars to representatives in `R` and use `R`-linearity of `e`.
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective c
  rw [← idealScalarActionEqQuotientScalarAction I r x]
  rw [e.map_smul]
  rw [idealScalarActionEqQuotientScalarAction I r (e x)]

/-- Helper for Chap10 Lemma 10 69 5: promote an `R`-linear equivalence between quotient-defined
modules to an `(R / I)`-linear equivalence. -/
private def linearEquivOverQuotient
    (I : Ideal R)
    {P : Type*} [AddCommGroup P] [Module (R ⧸ I) P] [Module R P]
    [IsScalarTower R (R ⧸ I) P]
    {Q : Type*} [AddCommGroup Q] [Module (R ⧸ I) Q] [Module R Q]
    [IsScalarTower R (R ⧸ I) Q]
    (e : P ≃ₗ[R] Q) : P ≃ₗ[R ⧸ I] Q :=
  { toFun := e
    invFun := e.symm
    left_inv := e.left_inv
    right_inv := e.right_inv
    map_add' := e.map_add
    map_smul' := linearEquivMapSmulOverQuotient I e }

/-- Helper for Chap10 Lemma 10 69 5: an `R`-linear equivalence descends to the quotient by
`Ideal.ofList rs • ⊤`. -/
private noncomputable def ofListSmulTopQuotientLinearEquiv
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) :
    (P ⧸ (Ideal.ofList rs • (⊤ : Submodule R P))) ≃ₗ[R ⧸ Ideal.ofList rs]
      (Q ⧸ (Ideal.ofList rs • (⊤ : Submodule R Q))) :=
  linearEquivOverQuotient (Ideal.ofList rs) <|
    Submodule.Quotient.equiv
      (Ideal.ofList rs • (⊤ : Submodule R P))
      (Ideal.ofList rs • (⊤ : Submodule R Q))
      e
      (ofListSmulTopMapEqLinear e)

/-- Helper for Chap10 Lemma 10 69 5: the descended quotient equivalence still sends the class of a
representative to the class of its image under the ambient equivalence. -/
@[simp] private theorem ofListSmulTopQuotientLinearEquiv_apply_mk
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (x : P) :
    ofListSmulTopQuotientLinearEquiv e rs (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (e x) := by
  -- Unfold the quotient transport once; on representatives it is induced by `e`.
  simp [ofListSmulTopQuotientLinearEquiv, linearEquivOverQuotient]

/-- Helper for Chap10 Lemma 10 69 5: an `R`-linear equivalence transports each filtration stage
`(Ideal.ofList rs)^n • ⊤` to the corresponding stage in the target module. -/
private theorem ofListPowSmulTopMapEqLinear
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (n : ℕ) :
    ((((Ideal.ofList rs) ^ n) • (⊤ : Submodule R P)).map e.toLinearMap) =
      ((Ideal.ofList rs) ^ n) • (⊤ : Submodule R Q) := by
  -- Each higher stage is again an ideal-smul-top submodule, so the degree-zero argument applies.
  calc
    ((((Ideal.ofList rs) ^ n) • (⊤ : Submodule R P)).map e.toLinearMap)
        = ((Ideal.ofList rs) ^ n) • (⊤ : Submodule R P).map e.toLinearMap := by
            rw [Submodule.map_smul'']
    _ = ((Ideal.ofList rs) ^ n) • (⊤ : Submodule R Q) := by
          rw [Submodule.map_top, LinearMap.range_eq_top.2 e.surjective]

/-- Helper for Chap10 Lemma 10 69 5: restricting an ambient linear equivalence to the `n`th
filtration stage yields a linear equivalence of stages. -/
private noncomputable def idealAssociatedGradedStageLinearEquiv
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (n : ℕ) :
    idealAssociatedGradedStage (Ideal.ofList rs) P n ≃ₗ[R]
      idealAssociatedGradedStage (Ideal.ofList rs) Q n := by
  let Pn : Submodule R P := idealAssociatedGradedStage (Ideal.ofList rs) P n
  let Qn : Submodule R Q := idealAssociatedGradedStage (Ideal.ofList rs) Q n
  have hPn : Pn.map (e : P →ₗ[R] Q) = Qn := by
    -- Rewrite the stage as `J^n • ⊤` and transport it through `e`.
    simpa [Pn, Qn, idealAssociatedGradedStage] using
      ofListPowSmulTopMapEqLinear e rs n
  -- Restrict `e` to the source stage and rewrite the codomain by the transported-stage equality.
  exact (e.submoduleMap Pn).trans (LinearEquiv.ofEq _ _ hPn)

/-- Helper for Chap10 Lemma 10 69 5: on stage representatives, the restricted stage equivalence is
the ambient linear equivalence. -/
@[simp] private theorem idealAssociatedGradedStageLinearEquiv_apply
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) P n) :
    ((idealAssociatedGradedStageLinearEquiv e rs n x :
        idealAssociatedGradedStage (Ideal.ofList rs) Q n) : Q) = e x := by
  -- The restricted equivalence is built from `e.submoduleMap`, so it acts on representatives by `e`.
  simp [idealAssociatedGradedStageLinearEquiv]

/-- Helper for Chap10 Lemma 10 69 5: on stage representatives, the inverse restricted stage
equivalence is induced by the inverse ambient equivalence. -/
@[simp] private theorem idealAssociatedGradedStageLinearEquiv_symm_apply
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) Q n) :
    (((idealAssociatedGradedStageLinearEquiv e rs n).symm x :
        idealAssociatedGradedStage (Ideal.ofList rs) P n) : P) = e.symm x := by
  -- Rewrite the inverse through the corresponding restricted transport for `e.symm`.
  simp [idealAssociatedGradedStageLinearEquiv]

/-- Helper for Chap10 Lemma 10 69 5: each graded piece `J^n P / J^(n + 1) P` transports linearly
along an ambient `R`-linear equivalence. -/
private noncomputable def idealAssociatedGradedPieceLinearEquiv
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (n : ℕ) :
    idealAssociatedGradedPiece (Ideal.ofList rs) P n ≃ₗ[R]
      idealAssociatedGradedPiece (Ideal.ofList rs) Q n := by
  let J : Ideal R := Ideal.ofList rs
  let Pn : Submodule R P := idealAssociatedGradedStage J P n
  let Qn : Submodule R Q := idealAssociatedGradedStage J Q n
  let Pn1 : Submodule R Pn := (idealAssociatedGradedStage J P (n + 1)).submoduleOf Pn
  let Qn1 : Submodule R Qn := (idealAssociatedGradedStage J Q (n + 1)).submoduleOf Qn
  let eStage : Pn ≃ₗ[R] Qn := idealAssociatedGradedStageLinearEquiv e rs n
  have hmap : Pn1.map eStage.toLinearMap = Qn1 := by
    -- Transport the successor stage through the restricted equivalence by checking both inclusions
    -- on explicit stage representatives.
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      change ((eStage x : Qn) : Q) ∈ idealAssociatedGradedStage J Q (n + 1)
      exact
        ((idealAssociatedGradedStageLinearEquiv e rs (n + 1)
          ⟨(x : P), hx⟩ :
            idealAssociatedGradedStage J Q (n + 1))).property
    · intro hy
      refine ⟨eStage.symm y, ?_, by simp [eStage]⟩
      change ((eStage.symm y : Pn) : P) ∈ idealAssociatedGradedStage J P (n + 1)
      simpa [eStage] using
        ((idealAssociatedGradedStageLinearEquiv e rs (n + 1)).symm
          ⟨(y : Q), hy⟩).property
  -- Descend the stage equivalence to the quotient by the successor stage.
  exact Submodule.Quotient.equiv Pn1 Qn1 eStage hmap

/-- Helper for Chap10 Lemma 10 69 5: the graded-piece transport still acts on quotient
representatives by the induced stage transport. -/
@[simp] private theorem idealAssociatedGradedPieceLinearEquiv_apply_mk
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) P n) :
    idealAssociatedGradedPieceLinearEquiv e rs n (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk (idealAssociatedGradedStageLinearEquiv e rs n x) := by
  -- The quotient transport is induced by `Submodule.Quotient.equiv`, so it still evaluates by the
  -- underlying stage transport on representatives.
  simp [idealAssociatedGradedPieceLinearEquiv]

/-- Helper for Chap10 Lemma 10 69 5: the full associated graded module transports degreewise along
an ambient `R`-linear equivalence. -/
private noncomputable def idealAssociatedGradedModuleLinearEquiv
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) :
    idealAssociatedGradedModule (Ideal.ofList rs) P ≃ₗ[R]
    idealAssociatedGradedModule (Ideal.ofList rs) Q :=
  DirectSum.congrLinearEquiv fun n ↦ idealAssociatedGradedPieceLinearEquiv e rs n

/-- Helper for Chap10 Lemma 10 69 5: the tensor source of the associated-graded comparison map
transports along an ambient linear equivalence. -/
private noncomputable def quasiRegularSequenceAssociatedGradedSourceEquiv
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) :
    TensorProduct (R ⧸ Ideal.ofList rs)
        (P ⧸ (Ideal.ofList rs • (⊤ : Submodule R P)))
        (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) ≃ₗ[R ⧸ Ideal.ofList rs]
      TensorProduct (R ⧸ Ideal.ofList rs)
        (Q ⧸ (Ideal.ofList rs • (⊤ : Submodule R Q)))
        (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) :=
  (TensorProduct.congr
    (ofListSmulTopQuotientLinearEquiv e rs)
    (LinearEquiv.refl (R ⧸ Ideal.ofList rs)
      (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))))

/-- Helper for Chap10 Lemma 10 69 5: the associated-graded target transports degreewise along an
ambient linear equivalence. -/
private noncomputable def quasiRegularSequenceAssociatedGradedTargetEquiv
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) :
    idealAssociatedGradedModule (Ideal.ofList rs) P ≃ₗ[R]
      idealAssociatedGradedModule (Ideal.ofList rs) Q :=
  idealAssociatedGradedModuleLinearEquiv e rs

/-- Helper for Chap10 Lemma 10 69 5: the source transport sends monomial simple tensors through
the descended quotient equivalence on the coefficient factor. -/
@[simp] private theorem quasiRegularSequenceAssociatedGradedSourceEquiv_tmul
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (m : P) (d : Fin rs.length →₀ ℕ) :
    quasiRegularSequenceAssociatedGradedSourceEquiv e rs
        (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs]
          MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs)) =
      Submodule.Quotient.mk (e m) ⊗ₜ[R ⧸ Ideal.ofList rs]
        MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs) := by
  -- Evaluate `TensorProduct.congr` on a simple tensor and then compute the quotient factor.
  simpa [quasiRegularSequenceAssociatedGradedSourceEquiv] using
    (TensorProduct.congr_tmul
      (ofListSmulTopQuotientLinearEquiv e rs)
      (LinearEquiv.refl (R ⧸ Ideal.ofList rs)
        (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)))
      (Submodule.Quotient.mk m)
      (MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs)))

/-- Helper for Chap10 Lemma 10 69 5: the target transport agrees with the linear graded-module
transport. -/
@[simp] private theorem quasiRegularSequenceAssociatedGradedTargetEquiv_apply
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R)
    (z : idealAssociatedGradedModule (Ideal.ofList rs) P) :
    quasiRegularSequenceAssociatedGradedTargetEquiv e rs z =
      idealAssociatedGradedModuleLinearEquiv e rs z := by
  -- The target equivalence is just `toEquiv` of the degreewise linear equivalence.
  rfl

/-- Helper for Chap10 Lemma 10 69 5: the full associated graded transport preserves homogeneous
generators degreewise. -/
@[simp] private theorem idealAssociatedGradedModuleLinearEquiv_lof
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList rs) P n) :
    idealAssociatedGradedModuleLinearEquiv e rs
        (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList rs) P) n z) =
      DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList rs) Q) n
        (idealAssociatedGradedPieceLinearEquiv e rs n z) := by
  -- `DirectSum.congrLinearEquiv` is induced by `DirectSum.lmap`, whose effect on `lof` is explicit.
  simpa [idealAssociatedGradedModuleLinearEquiv, DirectSum.coe_congrLinearEquiv] using
    (DirectSum.lmap_lof
      (fun n ↦ (idealAssociatedGradedPieceLinearEquiv e rs n).toLinearMap)
      n z)

/-- Helper for Chap10 Lemma 10 69 5: the associated-graded transport preserves additive
direct-sum generators degreewise. -/
@[simp] private theorem idealAssociatedGradedModuleLinearEquiv_of
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList rs) P n) :
    idealAssociatedGradedModuleLinearEquiv e rs
        (DirectSum.of (idealAssociatedGradedPiece (Ideal.ofList rs) P) n z) =
      DirectSum.of (idealAssociatedGradedPiece (Ideal.ofList rs) Q) n
        (idealAssociatedGradedPieceLinearEquiv e rs n z) := by
  -- Convert once through `lof`; subsequent proofs can use scalar-ring-free direct-sum notation.
  simpa [DirectSum.lof_eq_of] using
    idealAssociatedGradedModuleLinearEquiv_lof e rs n z

/-- Helper for Chap10 Lemma 10 69 5: on monomial simple tensors, the canonical associated-graded
comparison map commutes with the quotient-source and graded-target transports induced by an ambient
linear equivalence. -/
private theorem quasiRegularSequenceAssociatedGradedMapLinearNaturality_tmul
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) (m : P) (d : Fin rs.length →₀ ℕ) :
    quasiRegularSequenceAssociatedGradedTargetEquiv e rs
        (quasiRegularSequenceAssociatedGradedMap P rs
          (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs]
            MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs))) =
      quasiRegularSequenceAssociatedGradedMap Q rs
        (quasiRegularSequenceAssociatedGradedSourceEquiv e rs
          (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs]
            MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs))) := by
  -- Rewrite both sides on the monomial generator and compare the resulting transported stage
  -- representatives.
  rw [quasiRegularSequenceAssociatedGradedSourceEquiv_tmul]
  rw [quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_lof m d]
  rw [quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_lof (e m) d]
  rw [DirectSum.lof_eq_of, quasiRegularSequenceAssociatedGradedTargetEquiv_apply,
    idealAssociatedGradedModuleLinearEquiv_of, idealAssociatedGradedPieceLinearEquiv_apply_mk]
  rw [DirectSum.lof_eq_of]
  -- The transported stage representative is exactly the ambient image of the original monomial
  -- representative.
  congr 1
  congr 1
  ext
  simp [idealAssociatedGradedStageLinearEquiv_apply, e.map_smul]

/-- Helper for Chap10 Lemma 10 69 5: after transporting the quotient source and each graded piece
along an ambient linear equivalence, the canonical associated-graded comparison map is conjugated
by those transports. -/
private theorem quasiRegularSequenceAssociatedGradedMapLinearNaturality
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) (rs : List R) :
    quasiRegularSequenceAssociatedGradedTargetEquiv e rs ∘
        quasiRegularSequenceAssociatedGradedMap P rs =
      quasiRegularSequenceAssociatedGradedMap Q rs ∘
        quasiRegularSequenceAssociatedGradedSourceEquiv e rs := by
  -- Expand an arbitrary tensor into a finite sum of monomial simple tensors, apply the monomial
  -- conjugation formula termwise, and reassemble by linearity.
  funext z
  obtain ⟨coeffs, hcoeffs⟩ := tensor_monomial_expansion rs z
  rw [hcoeffs, Finsupp.sum]
  simp only [Function.comp_apply, map_sum]
  refine Finset.sum_congr rfl ?_
  intro d hd
  refine Quotient.inductionOn' (coeffs d) ?_
  intro m
  simpa using quasiRegularSequenceAssociatedGradedMapLinearNaturality_tmul e rs m d

/-- Helper for Chap10 Lemma 10 69 5: quasi-regularity is invariant under an ambient `R`-linear
equivalence of modules. -/
private theorem congrLinearEquiv
    {P : Type*} [AddCommGroup P] [Module R P]
    {Q : Type*} [AddCommGroup Q] [Module R Q]
    (e : P ≃ₗ[R] Q) {rs : List R} :
    IsQuasiRegular P rs ↔ IsQuasiRegular Q rs := by
  -- Rewrite quasi-regularity as injectivity of the canonical associated-graded comparison map.
  rw [isQuasiRegular_iff_injective, isQuasiRegular_iff_injective]
  -- Once the conjugation square is isolated, injectivity transports across the source and target
  -- equivalences.
  exact
    injectiveIffOfEquivConjugate
      (quasiRegularSequenceAssociatedGradedSourceEquiv e rs).toEquiv
      (quasiRegularSequenceAssociatedGradedTargetEquiv e rs).toEquiv
      (quasiRegularSequenceAssociatedGradedMap P rs)
      (quasiRegularSequenceAssociatedGradedMap Q rs)
      (quasiRegularSequenceAssociatedGradedMapLinearNaturality e rs)

/-- Helper for Chap10 Lemma 10 69 5: a ring equivalence and compatible semilinear module
equivalence transport quasi-regularity in the forward direction. -/
private theorem mapSemilinearEquiv
    {A B : Type u} [CommRing A] [CommRing B] (eR : A ≃+* B)
    {P Q : Type v} [AddCommGroup P] [Module A P] [AddCommGroup Q] [Module B Q]
    (eM : P ≃ₛₗ[(eR : A →+* B)] Q) {rs : List A} :
    IsQuasiRegular P rs → IsQuasiRegular Q (rs.map eR) := by
  intro hqr
  -- View `Q` as an `A`-module through the ring equivalence and package `eM` as an `A`-linear
  -- equivalence.
  letI : Algebra A B := RingHom.toAlgebra (eR : A →+* B)
  letI : Module A Q := Module.compHom Q (eR : A →+* B)
  haveI : IsScalarTower A B Q := IsScalarTower.of_compHom A B Q
  have hflatAlg : (algebraMap A B).Flat := by
    simpa using
      (RingHom.Flat.of_bijective eR.bijective : (eR : A →+* B).Flat)
  haveI : Module.Flat A B := RingHom.flat_algebraMap_iff.mp hflatAlg
  haveI : TensorProduct.CompatibleSMul A B B Q :=
    @TensorProduct.CompatibleSMul.of_algebraMap_surjective
      A _ B Q _ _ _ _ B _ _ _ _ _ _ eR.surjective
  let eA : P ≃ₗ[A] Q :=
    { toFun := eM
      invFun := eM.symm
      left_inv := eM.left_inv
      right_inv := eM.right_inv
      map_add' := eM.map_add
      map_smul' := by
        intro a x
        exact eM.map_smulₛₗ a x }
  let f : P →ₗ[A] Q := eA.toLinearMap
  have hf : IsBaseChange B f := by
    refine IsBaseChange.of_equiv ?_ ?_
    · exact (eA.baseChange A B P Q).trans (TensorProduct.lidOfCompatibleSMul A B Q)
    · intro x
      simp [f, eA, TensorProduct.lidOfCompatibleSMul_tmul]
  -- The earlier flat-base-change theorem now applies to the ring-equivalence base change.
  simpa [f] using
    (of_flat_of_isBaseChange hf hqr)

/-- Helper for Chap10 Lemma 10 69 5: quasi-regularity is invariant under a ring equivalence and a
compatible semilinear equivalence of modules. -/
private theorem congrSemilinearEquiv
    {A B : Type u} [CommRing A] [CommRing B] (eR : A ≃+* B)
    {P Q : Type v} [AddCommGroup P] [Module A P] [AddCommGroup Q] [Module B Q]
    (eM : P ≃ₛₗ[(eR : A →+* B)] Q) {rs : List A} :
    IsQuasiRegular P rs ↔ IsQuasiRegular Q (rs.map eR) := by
  constructor
  · -- The forward implication is the owner-level base-change transport isolated above.
    exact mapSemilinearEquiv eR eM
  · intro hqr
    -- Apply the same transport to the inverse equivalences and normalize the double map on lists.
    have hback :
        IsQuasiRegular P ((rs.map eR).map eR.symm) :=
      mapSemilinearEquiv eR.symm eM.symm hqr
    simpa [List.map_map, Function.comp_def] using hback

/-- Helper for Chap10 Lemma 10 69 5: on the full associated graded module of a quasi-regular
cons sequence, multiplication by the head polynomial variable has zero kernel. -/
private theorem fullAssociatedGraded_headVariable_smul_eq_zero
    {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs))
    {y : idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M}
    (hy : (MvPolynomial.X (0 : Fin (r :: rs).length) :
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) • y = 0) :
    y = 0 := by
  let e := hqr.linearEquiv.symm
  let X0 : MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs)) :=
    MvPolynomial.X (0 : Fin (r :: rs).length)
  have hpreimage : e y = 0 := by
    -- Pull the vanishing `X 0`-equation back through the quasi-regular comparison equivalence
    -- and apply the source-side injectivity statement.
    exact @textbookSourceTensor_X_smul_eq_zero R _ M _ _
      (r :: rs)
      (0 : Fin (r :: rs).length)
      (e y)
      (by
        simpa [X0] using congrArg e hy)
  -- Since the inverse equivalence is injective, the original graded element is zero.
  apply e.injective
  simpa using hpreimage

/-- Helper for Chap10 Lemma 10 69 5: `QuotSMulTop r M` is annihilated by `(r)`, so it carries the
expected scalar action of `R ⧸ (r)`. -/
private theorem quotSMulTopIsTorsionBySetSpanSingleton
    {r : R} :
    Module.IsTorsionBySet R (QuotSMulTop r M) (Ideal.span ({r} : Set R)) :=
  (Module.isTorsionBySet_span_singleton_iff r).mpr
    (Module.isTorsionBy_quotient_element_smul M r)

/-- Helper for Chap10 Lemma 10 69 5: the owner quotient `QuotSMulTop r M` is naturally an
`R ⧸ (r)`-module. -/
private instance quotSMulTopSpanSingletonModule
    {r : R} :
    Module (R ⧸ Ideal.span ({r} : Set R)) (QuotSMulTop r M) :=
  (quotSMulTopIsTorsionBySetSpanSingleton).module

/-- Helper for Chap10 Lemma 10 69 5: the quotient-ring action on `QuotSMulTop r M` is compatible
with the original `R`-action. -/
private instance quotSMulTopSpanSingletonIsScalarTower
    {r : R} :
    IsScalarTower R (R ⧸ Ideal.span ({r} : Set R)) (QuotSMulTop r M) :=
  Module.IsTorsionBySet.isScalarTower
    (quotSMulTopIsTorsionBySetSpanSingleton)

/-- Helper for Chap10 Lemma 10 69 5: the principal-head quotient spelling is the owner
`QuotSMulTop r M` model over `R ⧸ (r)`. -/
private noncomputable def headPrincipalQuotientEquivQuotSMulTop
    {r : R} :
    (M ⧸ ((Ideal.span ({r} : Set R)) • (⊤ : Submodule R M))) ≃ₗ[R ⧸ Ideal.span ({r} : Set R)]
      QuotSMulTop r M :=
  linearEquivOverQuotient (Ideal.span ({r} : Set R)) <|
    Submodule.quotEquivOfEq
      ((Ideal.span ({r} : Set R)) • (⊤ : Submodule R M))
      ((r • (⊤ : Submodule R M) : Submodule R M))
      (Submodule.ideal_span_singleton_smul r (⊤ : Submodule R M))

/-- Helper for Chap10 Lemma 10 69 5: the head-principal quotient equivalence sends the class of
`x` to the owner quotient class of the same representative. -/
@[simp] private theorem headPrincipalQuotientEquivQuotSMulTop_apply_mk
    {r : R} (x : M) :
    headPrincipalQuotientEquivQuotSMulTop
      (Submodule.Quotient.mk x) =
      (Submodule.Quotient.mk x : QuotSMulTop r M) := by
  -- The promoted quotient equivalence is induced by the identity on representatives.
  simp [headPrincipalQuotientEquivQuotSMulTop, linearEquivOverQuotient,
    Submodule.quotEquivOfEq_mk]

/-- Helper for Chap10 Lemma 10 69 5: quasi-regularity on the principal-head quotient is
equivalent to quasi-regularity on the owner `QuotSMulTop r M` model. -/
private theorem headPrincipalQuotient_isQuasiRegular_iff
    {r : R} {rs : List R} :
    IsQuasiRegular
      (M ⧸ ((Ideal.span ({r} : Set R)) • (⊤ : Submodule R M)))
      (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))) ↔
    IsQuasiRegular
      (QuotSMulTop r M)
      (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))) := by
  -- Transport quasi-regularity across the quotient-ring-linear equivalence of the two head
  -- quotient presentations.
  exact congrLinearEquiv headPrincipalQuotientEquivQuotSMulTop

/-- Helper for Chap10 Lemma 10 69 5: after quotienting `M` by the head element, each full stage
`Ī ^ n (QuotSMulTop r M)` is exactly the image of the original full stage `I ^ n M`, where
`I = Ideal.ofList (r :: rs)`. -/
private theorem headFullPowSmulTop_mem_iff
    {r : R} {rs : List R} (n : ℕ)
    {y : QuotSMulTop r M} :
    y ∈ idealAssociatedGradedStage
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n ↔
      y ∈ (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n).map
        (Submodule.mkQ ((r • (⊤ : Submodule R M) : Submodule R M))) := by
  let K : Ideal R := Ideal.span ({r} : Set R)
  let rsbar : List (R ⧸ K) := rs.map (Ideal.Quotient.mk K)
  let hTors : Module.IsTorsionBySet R (QuotSMulTop r M) K :=
    (Module.isTorsionBySet_span_singleton_iff r).mpr
      (Module.isTorsionBy_quotient_element_smul M r)
  let _ : Module (R ⧸ K) (QuotSMulTop r M) := hTors.module
  let _ : IsScalarTower R (R ⧸ K) (QuotSMulTop r M) :=
    Module.IsTorsionBySet.isScalarTower hTors
  have hmapPow :
      Ideal.map (Ideal.Quotient.mk K) ((Ideal.ofList (r :: rs)) ^ n) =
        (Ideal.ofList rsbar) ^ n := by
    -- Quotienting by the head element kills only the head generator of `Ideal.ofList (r :: rs)`,
    -- so its image is exactly the mapped tail ideal and the same remains true after taking powers.
    simpa [K, rsbar, Ideal.map_pow] using
      congrArg (fun I : Ideal (R ⧸ K) ↦ I ^ n)
        (fullTailQuotientRingEquivMapEq).symm
  have hstage :
      (idealAssociatedGradedStage (Ideal.ofList rsbar) (QuotSMulTop r M) n).restrictScalars R =
        (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n).map
          (Submodule.mkQ ((r • (⊤ : Submodule R M) : Submodule R M))) := by
    -- Rewrite the quotient-side stage through the image ideal and then identify that image with
    -- the image of the original full stage under the quotient map.
    calc
      (idealAssociatedGradedStage (Ideal.ofList rsbar) (QuotSMulTop r M) n).restrictScalars R
          = ((Ideal.map (Ideal.Quotient.mk K) ((Ideal.ofList (r :: rs)) ^ n)) •
              (⊤ : Submodule (R ⧸ K) (QuotSMulTop r M))).restrictScalars R := by
              rw [idealAssociatedGradedStage, ← hmapPow]
      _ = ((Ideal.map (algebraMap R (R ⧸ K)) ((Ideal.ofList (r :: rs)) ^ n)) •
            (⊤ : Submodule (R ⧸ K) (QuotSMulTop r M))).restrictScalars R := by
            rw [← Ideal.Quotient.algebraMap_eq]
      _ = ((Ideal.ofList (r :: rs)) ^ n) • (⊤ : Submodule R (QuotSMulTop r M)) := by
            simpa using
              (Ideal.smul_restrictScalars
                ((Ideal.ofList (r :: rs)) ^ n)
                (⊤ : Submodule (R ⧸ K) (QuotSMulTop r M)))
      _ = (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n).map
            (Submodule.mkQ ((r • (⊤ : Submodule R M) : Submodule R M))) := by
            symm
            simp [idealAssociatedGradedStage, Submodule.map_smul'', Submodule.range_mkQ]
  -- Membership in the quotient-side full stage is unchanged after restricting scalars back to `R`.
  change y ∈
      (idealAssociatedGradedStage (Ideal.ofList rsbar) (QuotSMulTop r M) n).restrictScalars R ↔
    y ∈ (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n).map
      (Submodule.mkQ ((r • (⊤ : Submodule R M) : Submodule R M)))
  rw [hstage]

/-- Helper for Chap10 Lemma 10 69 5: an element of the original full stage `I ^ n M` maps to the
corresponding quotient-side stage after quotienting by the head element. -/
private theorem headFullAssociatedGradedStageToQuotient_mem
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) :
    Submodule.Quotient.mk ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) ∈
      idealAssociatedGradedStage
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n := by
  -- Rewrite the quotient-side full stage as the image of the original full stage.
  exact
    (headFullPowSmulTop_mem_iff n).2
      (Submodule.mem_map_of_mem x.2)

/-- Helper for Chap10 Lemma 10 69 5: every quotient-side full stage element is represented by an
element of the original full stage `I ^ n M`, where `I = Ideal.ofList (r :: rs)`. -/
private theorem headFullAssociatedGradedStageToQuotient_exists
    {r : R} {rs : List R} (n : ℕ)
    {y : QuotSMulTop r M}
    (hy :
      y ∈ idealAssociatedGradedStage
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n) :
    ∃ x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n,
      (Submodule.Quotient.mk (x : M) : QuotSMulTop r M) = y := by
  -- Use the full-stage image description to lift the quotient representative back to `I ^ n M`.
  have hy' := (headFullPowSmulTop_mem_iff n).1 hy
  rcases Submodule.mem_map.1 hy' with ⟨x, hx, rfl⟩
  exact ⟨⟨x, hx⟩, rfl⟩

/-- Helper for Chap10 Lemma 10 69 5: on full-stage representatives, the descended quotient-piece
map preserves addition. -/
private theorem headFullStageToQuotientPiece_map_add
    {r : R} {rs : List R} (n : ℕ)
    (x y : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) :
    (Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk
            (((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) +
              ((y : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M)),
          headFullAssociatedGradedStageToQuotient_mem n (x + y)⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) :
        idealAssociatedGradedPiece
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
          (QuotSMulTop r M) n) =
      Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk
            ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
          headFullAssociatedGradedStageToQuotient_mem n x⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) +
        Submodule.Quotient.mk
          (⟨Submodule.Quotient.mk
              ((y : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
            headFullAssociatedGradedStageToQuotient_mem n y⟩ :
            idealAssociatedGradedStage
              (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
              (QuotSMulTop r M) n) := by
  -- The descended quotient-piece map is induced by the quotient map on representatives.
  rfl

/-- Helper for Chap10 Lemma 10 69 5: on full-stage representatives, the descended quotient-piece
map respects the quotient-ring scalar action. -/
private theorem headFullStageToQuotientPiece_map_smul
    {r : R} {rs : List R} (n : ℕ)
    (a : R) (x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) :
    (Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk
            ((a • (x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n)) : M),
          headFullAssociatedGradedStageToQuotient_mem n (a • x)⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) :
        idealAssociatedGradedPiece
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
          (QuotSMulTop r M) n) =
      (Ideal.Quotient.mk (Ideal.span ({r} : Set R)) a) •
        Submodule.Quotient.mk
          (⟨Submodule.Quotient.mk
              ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
            headFullAssociatedGradedStageToQuotient_mem n x⟩ :
            idealAssociatedGradedStage
              (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
              (QuotSMulTop r M) n) := by
  -- Scalar multiplication is still computed on representatives after quotienting by `r`.
  rfl

/-- Helper for Chap10 Lemma 10 69 5: the quotient map on representatives descends each full stage
`I ^ n M` to the corresponding quotient-side graded piece. -/
private noncomputable def headFullStageToQuotientPiece
    {r : R} {rs : List R} (n : ℕ) :
    idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n →ₛₗ[Ideal.Quotient.mk (Ideal.span ({r} : Set R))]
      (idealAssociatedGradedPiece
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n) :=
  { toFun := fun x ↦
      Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
          headFullAssociatedGradedStageToQuotient_mem n x⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n)
    map_add' := headFullStageToQuotientPiece_map_add n
    map_smul' := headFullStageToQuotientPiece_map_smul n }

/-- Helper for Chap10 Lemma 10 69 5: zero in the quotient-side degree-`n` piece means exactly
that the chosen full-stage representative lands in the successor quotient-side stage. -/
private theorem headFullStageToQuotientPiece_eq_zero_iff
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) :
    headFullStageToQuotientPiece n x = 0 ↔
      (Submodule.Quotient.mk
          ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) : QuotSMulTop r M) ∈
        idealAssociatedGradedStage
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
          (QuotSMulTop r M) (n + 1) := by
  -- Zero in the graded-piece quotient is membership in the successor-stage denominator.
  change
    Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk
            ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
          headFullAssociatedGradedStageToQuotient_mem n x⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) = 0 ↔
      (Submodule.Quotient.mk
          ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) : QuotSMulTop r M) ∈
        idealAssociatedGradedStage
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
          (QuotSMulTop r M) (n + 1)
  rw [Submodule.Quotient.mk_eq_zero]
  rfl

/-- Helper for Chap10 Lemma 10 69 5: zero in the quotient-side degree-`n` full-stage image is
equivalent to adjusting the representative by an `r`-multiple into the successor full stage. -/
private theorem headFullStageToQuotientPiece_eq_zero_iff_exists_sub_smul_mem
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) :
    headFullStageToQuotientPiece n x = 0 ↔
      ∃ m : M,
        ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) - r • m ∈
          idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1) := by
  rw [headFullStageToQuotientPiece_eq_zero_iff, headFullPowSmulTop_mem_iff]
  constructor
  · intro hx0
    -- Unpack quotient-stage membership into an explicit predecessor in `I ^ (n + 1) M`.
    rcases Submodule.mem_map.1 hx0 with ⟨y, hy, hyq⟩
    have hdiff :
        y - ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) ∈
          (r • (⊤ : Submodule R M) : Submodule R M) :=
      (Submodule.Quotient.eq ((r • (⊤ : Submodule R M) : Submodule R M))).1 hyq
    rcases (show ∃ m : M, m ∈ (⊤ : Submodule R M) ∧
        r • m = y - ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) by
      simpa [Submodule.mem_smul_pointwise_iff_exists] using hdiff) with ⟨m, -, hm⟩
    refine ⟨-m, ?_⟩
    have hy_eq :
        y =
          ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) - r • (-m) := by
      calc
        y = r • m + ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) := by
          exact (sub_eq_iff_eq_add).mp hm.symm
        _ = ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) - r • (-m) := by
          simp [add_comm]
    simpa [hy_eq] using hy
  · rintro ⟨m, hm⟩
    -- Conversely, a predecessor modulo `rM` gives the required quotient-stage representative.
    apply Submodule.mem_map.2
    refine ⟨((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) - r • m, hm, ?_⟩
    apply (Submodule.Quotient.eq ((r • (⊤ : Submodule R M) : Submodule R M))).2
    exact (show ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) - r • m -
        ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) ∈
          (r • (⊤ : Submodule R M) : Submodule R M) by
      simpa [Submodule.mem_smul_pointwise_iff_exists, sub_eq_add_neg, add_assoc,
        add_left_comm, add_comm] using
        (show ∃ z : M, z ∈ (⊤ : Submodule R M) ∧
            r • z =
              (((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) - r • m) -
                ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M) from
          ⟨-m, by simp, by simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]⟩))

/-- Helper for Chap10 Lemma 10 69 5: every quotient-side full graded-piece representative is hit
by the explicit full-stage quotient map. -/
private theorem headFullStageToQuotientPiece_surjective
    {r : R} {rs : List R} (n : ℕ) :
    Function.Surjective
      (headFullStageToQuotientPiece n :
        idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n →
          idealAssociatedGradedPiece
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) := by
  intro y
  refine Quotient.inductionOn y ?_
  intro y
  -- Lift a quotient-side stage representative back to `I ^ n M`, then compare quotient classes.
  rcases
      headFullAssociatedGradedStageToQuotient_exists n y.property with
    ⟨x, hx⟩
  refine ⟨x, ?_⟩
  change
    Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk
            ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
          headFullAssociatedGradedStageToQuotient_mem n x⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) =
      Submodule.Quotient.mk y
  congr 1
  apply Subtype.ext
  simpa using hx

/-- Helper for Chap10 Lemma 10 69 5: after quotienting `M` by the head element, each tail stage
`J̄ ^ n (QuotSMulTop r M)` is exactly the image of the original tail stage `J ^ n M`. -/
private theorem headTailPowSmulTop_mem_iff
    {r : R} {rs : List R} (n : ℕ)
    {y : QuotSMulTop r M} :
    y ∈ idealAssociatedGradedStage
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n ↔
      y ∈ (idealAssociatedGradedStage (Ideal.ofList rs) M n).map
        (Submodule.mkQ ((r • (⊤ : Submodule R M) : Submodule R M))) := by
  let K : Ideal R := Ideal.span ({r} : Set R)
  let rsbar : List (R ⧸ K) := rs.map (Ideal.Quotient.mk K)
  let hTors : Module.IsTorsionBySet R (QuotSMulTop r M) K :=
    (Module.isTorsionBySet_span_singleton_iff r).mpr
      (Module.isTorsionBy_quotient_element_smul M r)
  let _ : Module (R ⧸ K) (QuotSMulTop r M) := hTors.module
  let _ : IsScalarTower R (R ⧸ K) (QuotSMulTop r M) :=
    Module.IsTorsionBySet.isScalarTower hTors
  have hmapPow :
      Ideal.map (Ideal.Quotient.mk K) ((Ideal.ofList rs) ^ n) =
        (Ideal.ofList rsbar) ^ n := by
    -- The tail ideal on the quotient ring is the image of the original tail ideal, so the same is
    -- true for its powers.
    simpa [K, rsbar, Ideal.map_pow] using
      congrArg (fun I : Ideal (R ⧸ K) ↦ I ^ n)
        (Ideal.map_ofList (Ideal.Quotient.mk K) rs)
  have hstage :
      (idealAssociatedGradedStage (Ideal.ofList rsbar) (QuotSMulTop r M) n).restrictScalars R =
        (idealAssociatedGradedStage (Ideal.ofList rs) M n).map
          (Submodule.mkQ ((r • (⊤ : Submodule R M) : Submodule R M))) := by
    -- Rewrite the quotient-side stage as an image ideal action and then identify it with the
    -- image of the original tail stage under the head quotient map.
    calc
      (idealAssociatedGradedStage (Ideal.ofList rsbar) (QuotSMulTop r M) n).restrictScalars R
          = ((Ideal.map (Ideal.Quotient.mk K) ((Ideal.ofList rs) ^ n)) •
              (⊤ : Submodule (R ⧸ K) (QuotSMulTop r M))).restrictScalars R := by
              rw [idealAssociatedGradedStage, ← hmapPow]
      _ = ((Ideal.map (algebraMap R (R ⧸ K)) ((Ideal.ofList rs) ^ n)) •
            (⊤ : Submodule (R ⧸ K) (QuotSMulTop r M))).restrictScalars R := by
            rw [← Ideal.Quotient.algebraMap_eq]
      _ = ((Ideal.ofList rs) ^ n) • (⊤ : Submodule R (QuotSMulTop r M)) := by
            simpa using
              (Ideal.smul_restrictScalars
                ((Ideal.ofList rs) ^ n)
                (⊤ : Submodule (R ⧸ K) (QuotSMulTop r M)))
      _ = (idealAssociatedGradedStage (Ideal.ofList rs) M n).map
            (Submodule.mkQ ((r • (⊤ : Submodule R M) : Submodule R M))) := by
            symm
            simp [idealAssociatedGradedStage, Submodule.map_smul'', Submodule.range_mkQ]
  -- Membership in the quotient-side stage is unchanged after restricting scalars back to `R`.
  change y ∈
      (idealAssociatedGradedStage (Ideal.ofList rsbar) (QuotSMulTop r M) n).restrictScalars R ↔
    y ∈ (idealAssociatedGradedStage (Ideal.ofList rs) M n).map
      (Submodule.mkQ ((r • (⊤ : Submodule R M) : Submodule R M)))
  rw [hstage]

/-- Helper for Chap10 Lemma 10 69 5: an element of the original tail stage `J ^ n M` maps to the
corresponding tail stage after quotienting by the head element. -/
private theorem headTailAssociatedGradedStageToQuotient_mem
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    Submodule.Quotient.mk ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
      idealAssociatedGradedStage
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n := by
  -- Rewrite the quotient-side stage as the image of `J ^ n M` under the head quotient map.
  exact
    (headTailPowSmulTop_mem_iff n).2
      (Submodule.mem_map_of_mem x.2)

/-- Helper for Chap10 Lemma 10 69 5: every tail filtration stage sits inside the corresponding
full filtration stage for the cons sequence. -/
private theorem tailAssociatedGradedStage_le_fullStage
    {r : R} {rs : List R} (n : ℕ) :
    idealAssociatedGradedStage (Ideal.ofList rs) M n ≤
      idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n := by
  have htail_le_full : Ideal.ofList rs ≤ Ideal.ofList (r :: rs) := by
    simpa [Ideal.ofList_cons] using
      (le_sup_right : Ideal.ofList rs ≤ Ideal.span ({r} : Set R) ⊔ Ideal.ofList rs)
  induction n with
  | zero =>
      -- Degree `0` is the whole module for both filtrations.
      simpa [idealAssociatedGradedStage]
  | succ n ihn =>
      -- Rewrite the successor stage as one more ideal action on the previous stage and use the
      -- inclusion `Ideal.ofList rs ≤ Ideal.ofList (r :: rs)` together with the inductive stage
      -- inclusion.
      simpa [idealAssociatedGradedStage, pow_succ', mul_smul] using
        (Submodule.smul_mono htail_le_full ihn)

/-- Helper for Chap10 Lemma 10 69 5: every quotient-side tail stage element is represented by an
element of the original tail stage `J ^ n M`. -/
private theorem headTailAssociatedGradedStageToQuotient_exists
    {r : R} {rs : List R} (n : ℕ)
    {y : QuotSMulTop r M}
    (hy :
      y ∈ idealAssociatedGradedStage
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n) :
    ∃ x : idealAssociatedGradedStage (Ideal.ofList rs) M n,
      (Submodule.Quotient.mk (x : M) : QuotSMulTop r M) = y := by
  -- Use the image description of the quotient-side stage to lift the representative.
  have hy' := (headTailPowSmulTop_mem_iff n).1 hy
  rcases Submodule.mem_map.1 hy' with ⟨x, hx, rfl⟩
  exact ⟨⟨x, hx⟩, rfl⟩

/-- Helper for Chap10 Lemma 10 69 5: the quotient map on representatives descends each tail
stage `J ^ n M` to the corresponding quotient-side graded piece. -/
private noncomputable def headTailStageToQuotientPiece
    {r : R} {rs : List R} (n : ℕ) :
    idealAssociatedGradedStage (Ideal.ofList rs) M n →ₛₗ[Ideal.Quotient.mk (Ideal.span ({r} : Set R))]
      (idealAssociatedGradedPiece
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n) :=
  { toFun := fun x ↦
      Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M),
          headTailAssociatedGradedStageToQuotient_mem n x⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n)
    map_add' := by
      intro x y
      rfl
    map_smul' := by
      intro a x
      rfl }

/-- Helper for Chap10 Lemma 10 69 5: when a tail-stage representative is viewed in the full
stage, the full and tail quotient-piece maps compute to the same quotient-side class. -/
private theorem headFullStageToQuotientPiece_of_tailStage
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    headFullStageToQuotientPiece n
        ⟨(x : M), (@tailAssociatedGradedStage_le_fullStage R _ M _ _ r rs n) x.2⟩ =
      (@headTailStageToQuotientPiece R _ M _ _ r rs n) x := by
  -- Both quotient-piece maps are induced by the same quotient representative; only the source
  -- membership proof differs.
  rfl

/-- Helper for Chap10 Lemma 10 69 5: the full quotient-piece map on the standard tail monomial
representative agrees with the tail quotient-piece map on that same representative. -/
private theorem headFullStageToQuotientPiece_of_tailMonomial
    {r : R} {rs : List R} (m : M) (d : Fin rs.length →₀ ℕ) :
    headFullStageToQuotientPiece d.degree
        ⟨(∏ i : Fin rs.length, rs.get i ^ d i) • m,
          (@tailAssociatedGradedStage_le_fullStage R _ M _ _ r rs d.degree)
            (ofList_monomial_weight_smul_mem_of_degree rs d.degree m d rfl)⟩ =
      (@headTailStageToQuotientPiece R _ M _ _ r rs d.degree)
        ⟨(∏ i : Fin rs.length, rs.get i ^ d i) • m,
          ofList_monomial_weight_smul_mem_of_degree rs d.degree m d rfl⟩ := by
  -- Specialize the stage-comparison bridge to the monomial representatives used by the
  -- associated-graded generator formulas.
  simpa using
    headFullStageToQuotientPiece_of_tailStage d.degree
      ⟨(∏ i : Fin rs.length, rs.get i ^ d i) • m,
        ofList_monomial_weight_smul_mem_of_degree rs d.degree m d rfl⟩

/-- Helper for Chap10 Lemma 10 69 5: zero in the quotient-side degree-`n` piece means exactly
that the chosen representative lands in the successor quotient-side stage. -/
private theorem headTailStageToQuotientPiece_eq_zero_iff
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    (@headTailStageToQuotientPiece R _ M _ _ r rs n) x = 0 ↔
      (Submodule.Quotient.mk
          ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) : QuotSMulTop r M) ∈
        idealAssociatedGradedStage
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
          (QuotSMulTop r M) (n + 1) := by
  -- Zero in the graded-piece quotient is membership in the successor-stage denominator.
  change
    Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk
            ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M),
          headTailAssociatedGradedStageToQuotient_mem n x⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) = 0 ↔
      (Submodule.Quotient.mk
          ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) : QuotSMulTop r M) ∈
        idealAssociatedGradedStage
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
          (QuotSMulTop r M) (n + 1)
  rw [Submodule.Quotient.mk_eq_zero]
  rfl

/-- Helper for Chap10 Lemma 10 69 5: zero in the quotient-side degree-`n` piece is equivalent to
adjusting the representative by an `r`-multiple into the successor tail stage. -/
private theorem headTailStageToQuotientPiece_eq_zero_iff_exists_sub_smul_mem
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    (@headTailStageToQuotientPiece R _ M _ _ r rs n) x = 0 ↔
      ∃ m : M,
        ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) - r • m ∈
          idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1) := by
  rw [headTailStageToQuotientPiece_eq_zero_iff, headTailPowSmulTop_mem_iff]
  constructor
  · intro hx0
    -- Unpack quotient-stage membership into an explicit predecessor in `J^(n + 1) M`.
    rcases Submodule.mem_map.1 hx0 with ⟨y, hy, hyq⟩
    have hdiff :
        y - ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
          (r • (⊤ : Submodule R M) : Submodule R M) :=
      (Submodule.Quotient.eq ((r • (⊤ : Submodule R M) : Submodule R M))).1 hyq
    rcases (show ∃ m : M, m ∈ (⊤ : Submodule R M) ∧
        r • m = y - ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) by
      simpa [Submodule.mem_smul_pointwise_iff_exists] using hdiff) with ⟨m, -, hm⟩
    refine ⟨-m, ?_⟩
    have hy_eq :
        y =
          ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) - r • (-m) := by
      calc
        y = r • m + ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) := by
          exact (sub_eq_iff_eq_add).mp hm.symm
        _ = ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) - r • (-m) := by
          simp [add_comm]
    simpa [hy_eq] using hy
  · rintro ⟨m, hm⟩
    -- Conversely, a predecessor modulo `rM` gives the required quotient-stage representative.
    apply Submodule.mem_map.2
    refine ⟨((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) - r • m, hm, ?_⟩
    apply (Submodule.Quotient.eq ((r • (⊤ : Submodule R M) : Submodule R M))).2
    exact (show ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) - r • m -
        ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
          (r • (⊤ : Submodule R M) : Submodule R M) by
      simpa [Submodule.mem_smul_pointwise_iff_exists, sub_eq_add_neg, add_assoc,
        add_left_comm, add_comm] using
        (show ∃ z : M, z ∈ (⊤ : Submodule R M) ∧
            r • z =
              (((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) - r • m) -
                ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) from
          ⟨-m, by simp, by simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]⟩))

/-- Helper for Chap10 Lemma 10 69 5: every quotient-side graded-piece representative is hit by
the explicit stage-to-piece quotient map. -/
private theorem headTailStageToQuotientPiece_surjective
    {r : R} {rs : List R} (n : ℕ) :
    Function.Surjective
      (headTailStageToQuotientPiece n :
        idealAssociatedGradedStage (Ideal.ofList rs) M n →
          idealAssociatedGradedPiece
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) := by
  intro y
  refine Quotient.inductionOn y ?_
  intro y
  -- Lift a quotient-side stage representative back to `J ^ n M`, then compare the quotient
  -- classes of the two equal representatives.
  rcases
      headTailAssociatedGradedStageToQuotient_exists n y.property with
    ⟨x, hx⟩
  refine ⟨x, ?_⟩
  change
    Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk
            ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M),
          headTailAssociatedGradedStageToQuotient_mem n x⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n) =
      Submodule.Quotient.mk y
  congr 1
  apply Subtype.ext
  simpa using hx

/-- Helper for Chap10 Lemma 10 69 5: multiplying a representative in the full `(r :: rs)`-adic
stage by the head element raises the stage index by one. -/
private theorem headSmul_mem_nextStage
    {r : R} {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) :
    r • x ∈ idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1) := by
  -- The head term already lies in `Ideal.ofList (r :: rs)`, so multiplying by it increases the
  -- `(r :: rs)`-adic order by one.
  have hrI : r ∈ Ideal.ofList (r :: rs) := by
    rw [Ideal.ofList]
    exact Ideal.subset_span (by simp)
  change r • x ∈ (Ideal.ofList (r :: rs) ^ (n + 1)) • (⊤ : Submodule R M)
  rw [pow_succ']
  rw [mul_smul]
  exact Submodule.smul_mem_smul hrI hx

/-- Helper for Chap10 Lemma 10 69 5: in the internal associated-graded model, the head-variable
monomial action on a homogeneous class is represented by multiplying the representative by the
head monomial weight. -/
private theorem headVariableAction_lof_stageClass_raw
    {r : R} {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage (r :: rs) M n) :
    quasiRegularAssociatedGradedMonomialAction (r :: rs)
        (Finsupp.single (0 : Fin (r :: rs).length) 1)
        (DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n))) =
      DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
        (quasiRegularAssociatedGradedInternalPiece (r :: rs) M)
        (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1))
        (Submodule.Quotient.mk
          (⟨quasiRegularAssociatedGradedMonomialWeight (r :: rs)
              (Finsupp.single (0 : Fin (r :: rs).length) 1) • x,
            quasiRegularAssociatedGradedMonomialWeight_smul_mem_stage (r :: rs) n
              (Finsupp.single (0 : Fin (r :: rs).length) 1)
              (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n)⟩ :
            quasiRegularStage (r :: rs) M
              (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1)))) := by
  -- Compute the monomial action on a single homogeneous generator using the owner quotient-piece
  -- action formula.
  rw [quasiRegularAssociatedGradedMonomialAction_lof]
  rw [quasiRegularAssociatedGradedMonomialMapOnPiece_mk]

/-- Helper for Chap10 Lemma 10 69 5: if multiplying a degree-`n` representative by the head
element lands in the next-next full stage, then the head-variable monomial action kills its
internal associated-graded class. -/
private theorem headVariableAction_lof_stageClass_eq_zero_of_mem_next
    {r : R} {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage (r :: rs) M n)
    (hrx : r • x ∈ quasiRegularStage (r :: rs) M (n + 2)) :
    quasiRegularAssociatedGradedMonomialAction (r :: rs)
        (Finsupp.single (0 : Fin (r :: rs).length) 1)
        (DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n))) = 0 := by
  -- After computing the monomial action on representatives, the resulting class is zero because
  -- `r • x` already lies in the denominator stage.
  rw [headVariableAction_lof_stageClass_raw hx]
  have hmk :
      (Submodule.Quotient.mk
          (⟨quasiRegularAssociatedGradedMonomialWeight (r :: rs)
              (Finsupp.single (0 : Fin (r :: rs).length) 1) • x,
            quasiRegularAssociatedGradedMonomialWeight_smul_mem_stage (r :: rs) n
              (Finsupp.single (0 : Fin (r :: rs).length) 1)
              (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n)⟩ :
            quasiRegularStage (r :: rs) M
              (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1))) :
        quasiRegularAssociatedGradedInternalPiece (r :: rs) M
          (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1))) = 0 := by
    rw [Submodule.Quotient.mk_eq_zero]
    rw [Submodule.mem_smul_top_iff]
    change quasiRegularAssociatedGradedMonomialWeight (r :: rs)
        (Finsupp.single (0 : Fin (r :: rs).length) 1) • x ∈
      quasiRegularIdeal (r :: rs) •
        idealAssociatedGradedStage (quasiRegularIdeal (r :: rs)) M
          (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1))
    have hweight :
        quasiRegularAssociatedGradedMonomialWeight (r :: rs)
            (Finsupp.single (0 : Fin (r :: rs).length) 1) • x =
          r • x := by
      simpa [quasiRegularAssociatedGradedMonomialWeight, Fin.prod_univ_succ]
    rw [hweight]
    simpa [quasiRegularStage, quasiRegularIdeal, quasiRegularTotalDegree,
      idealAssociatedGradedStage, pow_succ', mul_smul] using hrx
  rw [hmk]
  exact map_zero _

/-- Helper for Chap10 Lemma 10 69 5: if multiplying a full-stage representative by the head
element lands in the next-next full stage, then the head polynomial variable kills its public
associated-graded class. -/
private theorem headVariable_smul_associatedGradedClass_eq_zero_of_mem_next
    {r : R} {rs : List R} {n : ℕ} {x : M}
    (hx : x ∈ quasiRegularStage (r :: rs) M n)
    (hrx : r • x ∈ quasiRegularStage (r :: rs) M (n + 2)) :
    (MvPolynomial.X (0 : Fin (r :: rs).length) :
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) •
      ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M).symm
        (DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk
            (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n)))) = 0 := by
  let y := DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk
            (⟨x, hx⟩ : quasiRegularStage (r :: rs) M n))
  -- Move the public class to the internal model, where the head-variable action is explicit on
  -- a single homogeneous generator.
  apply (quasiRegularAssociatedGradedAddEquiv (r :: rs) M).injective
  change
    (quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
      ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M).symm
        (quasiRegularAssociatedGradedPolynomialSmul (r :: rs)
          (MvPolynomial.X (0 : Fin (r :: rs).length))
          ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
            ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M).symm y)))) =
      (quasiRegularAssociatedGradedAddEquiv (r :: rs) M) 0
  rw [AddEquiv.apply_symm_apply]
  rw [AddEquiv.apply_symm_apply]
  rw [map_zero]
  rw [MvPolynomial.X]
  have hmonomial :
      quasiRegularAssociatedGradedPolynomialSmul (r :: rs)
        (MvPolynomial.monomial (Finsupp.single (0 : Fin (r :: rs).length) 1)
          (1 : R ⧸ Ideal.ofList (r :: rs))) y =
        (1 : R ⧸ Ideal.ofList (r :: rs)) •
          quasiRegularAssociatedGradedMonomialAction (r :: rs)
            (Finsupp.single (0 : Fin (r :: rs).length) 1) y := by
    -- Collapse the polynomial action to its single nonzero monomial term.
    change quasiRegularAssociatedGradedPolynomialSmul (r :: rs)
        (MvPolynomial.monomial (Finsupp.single (0 : Fin (r :: rs).length) 1)
          (1 : R ⧸ Ideal.ofList (r :: rs))) y =
      (1 : R ⧸ Ideal.ofList (r :: rs)) •
        quasiRegularAssociatedGradedMonomialAction (r :: rs)
          (Finsupp.single (0 : Fin (r :: rs).length) 1) y
    simpa [quasiRegularAssociatedGradedPolynomialSmul] using
      (MvPolynomial.sum_monomial_eq
        (Finsupp.single (0 : Fin (r :: rs).length) 1)
        (1 : R ⧸ Ideal.ofList (r :: rs))
        (fun d a ↦ a • quasiRegularAssociatedGradedMonomialAction (r :: rs) d y))
  rw [hmonomial]
  simp only [one_smul]
  exact headVariableAction_lof_stageClass_eq_zero_of_mem_next hx hrx

/-- Helper for Chap10 Lemma 10 69 5: the head element can be stripped from membership in the
full `(r :: rs)`-adic filtration of a quasi-regular sequence. -/
private theorem headSmul_mem_fullStageSucc_iff
    {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs))
    (n : ℕ) (m : M) :
    r • m ∈ idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1) ↔
      m ∈ idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n := by
  let I : Ideal R := Ideal.ofList (r :: rs)
  constructor
  · intro hrm
    induction n with
    | zero =>
        -- Degree zero is tautological because the zeroth stage is all of `M`.
        simpa [idealAssociatedGradedStage]
    | succ n ihn =>
        have hstage_le :
            idealAssociatedGradedStage I M (n + 2) ≤
              idealAssociatedGradedStage I M (n + 1) := by
          simpa [I, idealAssociatedGradedStage] using
            (Submodule.smul_mono
              (Ideal.pow_le_pow_right (Nat.le_succ (n + 1)))
              (show (⊤ : Submodule R M) ≤ ⊤ from le_rfl))
        have hm_prev :
            m ∈ idealAssociatedGradedStage I M n := by
          -- First lower the stage once so the degree-`n` class of `m` is defined.
          exact ihn (hstage_le hrm)
        have hy_zero :
            (quasiRegularAssociatedGradedAddEquiv (r :: rs) M).symm
              (DirectSum.lof (R ⧸ I) ℕ
                (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
                (Submodule.Quotient.mk (⟨m, hm_prev⟩ : quasiRegularStage (r :: rs) M n))) = 0 := by
          -- Apply the head-variable zero-kernel statement directly to the public degree-`n` class.
          exact fullAssociatedGraded_headVariable_smul_eq_zero hqr
            (headVariable_smul_associatedGradedClass_eq_zero_of_mem_next hm_prev hrm)
        have hy_internal :
            DirectSum.lof (R ⧸ I) ℕ
                (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
                (Submodule.Quotient.mk (⟨m, hm_prev⟩ : quasiRegularStage (r :: rs) M n)) = 0 := by
          simpa using congrArg (quasiRegularAssociatedGradedAddEquiv (r :: rs) M) hy_zero
        have hcomponent :=
          congrArg
            (@DirectSum.component
              (R ⧸ I)
              _
              ℕ
              (fun k ↦ quasiRegularAssociatedGradedInternalPiece (r :: rs) M k)
              _ _ n)
            hy_internal
        have hmk :
            (Submodule.Quotient.mk
              (⟨m, hm_prev⟩ : quasiRegularStage (r :: rs) M n) :
                quasiRegularAssociatedGradedInternalPiece (r :: rs) M n) = 0 := by
          simpa using hcomponent
        rw [Submodule.Quotient.mk_eq_zero] at hmk
        rw [Submodule.mem_smul_top_iff] at hmk
        change m ∈
          quasiRegularIdeal (r :: rs) •
            idealAssociatedGradedStage (quasiRegularIdeal (r :: rs)) M n at hmk
        simpa [I, quasiRegularStage, quasiRegularIdeal, idealAssociatedGradedStage,
          pow_succ', mul_smul] using hmk
  · intro hm
    -- The reverse implication is the basic ideal-multiplication step.
    simpa [I] using headSmul_mem_nextStage hm

/-- Helper for Chap10 Lemma 10 69 5: in positive degrees, zero in the quotient-side full-stage
image can be witnessed by a predecessor-stage representative for the head multiple. -/
private theorem headFullStageToQuotientPiece_eq_zero_iff_exists_sub_smul_mem_prevStage
    {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs)) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) :
    headFullStageToQuotientPiece (n + 1) x = 0 ↔
      ∃ m : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n,
        ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) : M) - r • (m : M) ∈
          idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 2) := by
  rw [headFullStageToQuotientPiece_eq_zero_iff_exists_sub_smul_mem]
  constructor
  · rintro ⟨m, hm⟩
    have hstage_le :
        idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 2) ≤
          idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1) := by
      simpa [idealAssociatedGradedStage] using
        (Submodule.smul_mono
          (Ideal.pow_le_pow_right (Nat.le_succ (n + 1)))
          (show (⊤ : Submodule R M) ≤ ⊤ from le_rfl))
    have hrm :
        r • m ∈ idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1) := by
      -- Rewrite `r • m` as the difference between the stage representative `x` and the correction
      -- term that already lies in the successor stage.
      have hm' :
          ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) : M) - r • m ∈
            idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1) := hstage_le hm
      have hsub :=
        Submodule.sub_mem
          (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1))
          x.2 hm'
      simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hsub
    have hm_prev :
        m ∈ idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n := by
      exact (headSmul_mem_fullStageSucc_iff hqr n m).1 hrm
    refine ⟨⟨m, hm_prev⟩, ?_⟩
    exact hm
  · rintro ⟨m, hm⟩
    exact ⟨(m : M), hm⟩

-- Helper for Chap10 Lemma 10 69 5: the successor-stage denominator placeholder below is used by
-- the descended quotient-piece construction once the temporary `R`-linear stage map is restored.
-- TODO: restore the semilinear-to-linear bridge for `headFullStageToQuotientPiece` and then show
-- successor-stage representatives map to zero in the quotient-side piece.
/-- Helper for Chap10 Lemma 10 69 5: the stage-level quotient map in a temporary `R`-linear
spelling used by the later quotient-piece placeholders. -/
private noncomputable def headFullStageToQuotientPieceLinear
    {r : R} {rs : List R} (n : ℕ) :
    idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n →ₗ[R]
      idealAssociatedGradedPiece
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) n :=
  -- This is the semilinear stage map re-packaged as an `R`-linear map through the quotient-ring
  -- scalar tower on the target.
  { toFun := headFullStageToQuotientPiece n
    map_add' := by
      intro x y
      exact map_add _ x y
    map_smul' := by
      intro a x
      exact (headFullStageToQuotientPiece n).map_smulₛₗ a x }

private theorem headFullPieceToQuotientPiece_denominator_le_ker
    {r : R} {rs : List R} (n : ℕ) :
    ((idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 2)).submoduleOf
      (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1))) ≤
        LinearMap.ker
          (headFullStageToQuotientPieceLinear (n + 1)) := by
  intro x hx
  -- A denominator representative already lies in the successor stage, so its quotient-side class
  -- is zero with the trivial correction term `m = 0`.
  rw [LinearMap.mem_ker]
  change
    headFullStageToQuotientPiece (n + 1) x = 0
  rw [headFullStageToQuotientPiece_eq_zero_iff_exists_sub_smul_mem]
  refine ⟨0, ?_⟩
  simpa using hx

/-- Helper for Chap10 Lemma 10 69 5: the full-stage quotient map descends to the degree-`n + 1`
source piece. -/
private noncomputable def headFullPieceToQuotientPiece
    {r : R} {rs : List R} (n : ℕ) :
    idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) →ₗ[R]
      idealAssociatedGradedPiece
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) (n + 1) :=
  -- Descend the linearized stage map through the standard associated-graded quotient.
  Submodule.liftQ
    ((idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 2)).submoduleOf
      (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)))
    (headFullStageToQuotientPieceLinear (n + 1))
    (headFullPieceToQuotientPiece_denominator_le_ker n)

/-- Helper for Chap10 Lemma 10 69 5: on quotient representatives, the descended source-piece map
is still computed by the full-stage quotient map. -/
@[simp] private theorem headFullPieceToQuotientPiece_apply_mk
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) :
    headFullPieceToQuotientPiece n
        (Submodule.Quotient.mk x) =
      headFullStageToQuotientPiece (n + 1) x := by
  -- The descended map was defined by `Submodule.liftQ`, so it computes directly on quotient
  -- classes of stage representatives.
  simp [headFullPieceToQuotientPiece, headFullStageToQuotientPieceLinear]

/-- Helper for Chap10 Lemma 10 69 5: the descended source-piece map is surjective because the
full-stage quotient map already lifts every target representative. -/
private theorem headFullPieceToQuotientPiece_surjective
    {r : R} {rs : List R} (n : ℕ) :
    Function.Surjective (@headFullPieceToQuotientPiece R _ M _ _ r rs n) := by
  intro y
  -- First lift the target class to a full-stage representative, then pass to its source-piece
  -- quotient class.
  rcases
      headFullStageToQuotientPiece_surjective
        (n + 1) y with
    ⟨x, hx⟩
  refine ⟨Submodule.Quotient.mk x, ?_⟩
  simpa [hx] using headFullPieceToQuotientPiece_apply_mk n x

/-- Helper for Chap10 Lemma 10 69 5: the head element of `Ideal.ofList (r :: rs)` lies in degree
`1` of the full-stage filtration. -/
private theorem head_mem_fullStageOne
    {r : R} {rs : List R} :
    r ∈ idealAssociatedGradedStage (Ideal.ofList (r :: rs)) R 1 := by
  -- Degree `1` is the ideal itself acting on `R`, and the head generator appears with witness
  -- `1 : R` in the top submodule.
  rw [idealAssociatedGradedStage, pow_one]
  change r ∈ Ideal.ofList (r :: rs) • (⊤ : Submodule R R)
  have hrI : r ∈ Ideal.ofList (r :: rs) := by
    rw [Ideal.ofList]
    exact Ideal.subset_span (by simp)
  simpa using
    (Submodule.smul_mem_smul hrI (show (1 : R) ∈ (⊤ : Submodule R R) by simp))

/-- Helper for Chap10 Lemma 10 69 5: the head element gives a canonical degree-`1` full-stage
representative for `Ideal.ofList (r :: rs)`. -/
private def headFullDegreeOneStage
    {r : R} {rs : List R} :
    idealAssociatedGradedStage (Ideal.ofList (r :: rs)) R 1 :=
  ⟨r, head_mem_fullStageOne⟩

/-- Helper for Chap10 Lemma 10 69 5: the head element determines the canonical degree-`1` source
piece class whose action models quotienting by the head variable. -/
private def headFullDegreeOnePiece
    {r : R} {rs : List R} :
    idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) R 1 :=
  Submodule.Quotient.mk (headFullDegreeOneStage)

/-- Helper for Chap10 Lemma 10 69 5: the inverse internal/textbook piece equivalence preserves
quotient representatives verbatim. -/
@[simp] private theorem quasiRegularAssociatedGradedInternalPieceEquiv_symm_apply_mk
    (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    (quasiRegularAssociatedGradedInternalPieceEquiv rs M n).symm
        (Submodule.Quotient.mk x) =
      (Submodule.Quotient.mk x : quasiRegularAssociatedGradedInternalPiece rs M n) := by
  -- The piece equivalence is `Submodule.quotEquivOfEq`, so its inverse still acts by the
  -- identity on quotient representatives.
  rw [quasiRegularAssociatedGradedInternalPieceEquiv]
  rfl

/-- Helper for Chap10 Lemma 10 69 5: the forward internal/textbook piece equivalence also fixes
quotient representatives. -/
@[simp] private theorem quasiRegularAssociatedGradedInternalPieceEquiv_apply_mk
    (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    quasiRegularAssociatedGradedInternalPieceEquiv rs M n
        (Submodule.Quotient.mk x) =
      (Submodule.Quotient.mk x : idealAssociatedGradedPiece (Ideal.ofList rs) M n) := by
  -- The forward piece equivalence is the same quotient-identification map, so it also computes
  -- directly on quotient representatives.
  rw [quasiRegularAssociatedGradedInternalPieceEquiv]
  rfl

/-- Helper for Chap10 Lemma 10 69 5: the direct-sum identification from the textbook associated
graded module to the internal one acts degreewise on homogeneous generators. -/
@[simp] private theorem quasiRegularAssociatedGradedAddEquiv_apply_lof
    (rs : List R) (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList rs) M n) :
    quasiRegularAssociatedGradedAddEquiv rs M
        (DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
          (idealAssociatedGradedPiece (Ideal.ofList rs) M) n z) =
      DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
        (quasiRegularAssociatedGradedInternalPiece rs M) n
        ((quasiRegularAssociatedGradedInternalPieceEquiv rs M n).symm z) := by
  -- The direct-sum equivalence is built by mapping each homogeneous summand with the inverse
  -- piece equivalence.
  change DirectSum.map
      (fun k ↦ ((quasiRegularAssociatedGradedInternalPieceEquiv rs M k).symm.toAddMonoidHom))
      (DirectSum.of (idealAssociatedGradedPiece (Ideal.ofList rs) M) n z) =
    DirectSum.of (quasiRegularAssociatedGradedInternalPiece rs M) n
      ((quasiRegularAssociatedGradedInternalPieceEquiv rs M n).symm z)
  simpa using DirectSum.map_of
    (f := fun k ↦ ((quasiRegularAssociatedGradedInternalPieceEquiv rs M k).symm.toAddMonoidHom))
    n z

/-- Helper for Chap10 Lemma 10 69 5: the degree-one head monomial has scalar weight `r`. -/
private theorem headMonomialWeight_single_zero
    {r : R} {rs : List R} :
    quasiRegularAssociatedGradedMonomialWeight (r :: rs)
      (Finsupp.single (0 : Fin (r :: rs).length) 1) = r := by
  -- Split the finite product into the head factor and the tail factors, which all have exponent
  -- zero for the head monomial.
  unfold quasiRegularAssociatedGradedMonomialWeight
  calc
    (∏ i : Fin (r :: rs).length,
        (r :: rs).get i ^ (Finsupp.single (0 : Fin (r :: rs).length) 1) i)
        = (r :: rs).get 0 ^ (Finsupp.single (0 : Fin (r :: rs).length) 1) 0 *
          ∏ i : Fin rs.length,
            (r :: rs).get i.succ ^ (Finsupp.single (0 : Fin (r :: rs).length) 1) i.succ := by
            exact Fin.prod_univ_succ
              (fun i : Fin (r :: rs).length ↦
                (r :: rs).get i ^ (Finsupp.single (0 : Fin (r :: rs).length) 1) i)
    _ = r := by
      simp [Fin.succ_ne_zero]

/-- Helper for Chap10 Lemma 10 69 5: the degree-one head monomial has total degree `1`. -/
private theorem headMonomialTotalDegree_single_zero
    {r : R} {rs : List R} :
    quasiRegularTotalDegree
      (Finsupp.single (0 : Fin (r :: rs).length) 1) = 1 := by
  -- The singleton exponent vector has exactly one nonzero exponent of value `1`.
  simp [quasiRegularTotalDegree]

/-- Helper for Chap10 Lemma 10 69 5: on full-stage representatives, the head action sends the
degree-`n` class of `x` to the degree-`n + 1` class of `r • x`. -/
private noncomputable def headFullStageHeadAction
    {r : R} {rs : List R} (n : ℕ) :
    idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n →ₗ[R]
      idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) :=
  { toFun := fun x ↦
      Submodule.Quotient.mk
        (⟨r • (x : M), headSmul_mem_nextStage x.2⟩ :
          idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1))
    map_add' := by
      intro x y
      -- The quotient-piece action is induced by the ambient linear map `x ↦ r • x`.
      rw [← Submodule.Quotient.mk_add]
      congr 1
      apply Subtype.ext
      simp [smul_add]
    map_smul' := by
      intro a x
      -- Scalar multiplication still acts on representatives before passing to the quotient piece.
      change
        Submodule.Quotient.mk
            (⟨r • ((a • x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
              headSmul_mem_nextStage (a • x).2⟩ :
              idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) =
          a •
            Submodule.Quotient.mk
              (⟨r • ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
                headSmul_mem_nextStage x.2⟩ :
                idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1))
      congr 1
      apply Subtype.ext
      simp [smul_smul, mul_comm] }

/-- Helper for Chap10 Lemma 10 69 5: successor-stage representatives map to zero under the
descended head action on graded pieces. -/
private theorem headFullStageHeadAction_denominator_le_ker
    {r : R} {rs : List R} (n : ℕ) :
    ((idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)).submoduleOf
      (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n)) ≤
        LinearMap.ker (headFullStageHeadAction n) := by
  intro x hx
  -- A representative already in the successor stage becomes zero in the quotient piece.
  rw [LinearMap.mem_ker]
  change
    (Submodule.Quotient.mk
        (⟨r • ((x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) : M),
          headSmul_mem_nextStage x.2⟩ :
          idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) :
      idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1)) = 0
  rw [Submodule.Quotient.mk_eq_zero]
  simpa using headSmul_mem_nextStage hx

private noncomputable def headFullPieceHeadAction
    {r : R} {rs : List R} (n : ℕ) :
    idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M n →ₗ[R]
      idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) :=
  -- Route correction: define the head action directly on quotient pieces instead of transporting
  -- through the cast-heavy internal monomial API.
  Submodule.liftQ
    ((idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)).submoduleOf
      (idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n))
    (headFullStageHeadAction n)
    (headFullStageHeadAction_denominator_le_ker n)

/-- Helper for Chap10 Lemma 10 69 5: on quotient representatives, the degreewise head action is
represented by multiplication by `r` in the ambient module. -/
@[simp] private theorem headFullPieceHeadAction_apply_mk
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M n) :
    headFullPieceHeadAction n
        (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk
        (⟨r • (x : M), headSmul_mem_nextStage x.2⟩ :
          idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) := by
  -- The descended quotient-piece action still computes directly on representatives.
  simp [headFullPieceHeadAction, headFullStageHeadAction]

/-- Helper for Chap10 Lemma 10 69 5: the public head-variable action on a homogeneous
associated-graded generator is the degreewise map `headFullPieceHeadAction`. -/
private theorem headVariableTargetSmul_lof
    {r : R} {rs : List R} (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M n) :
    (MvPolynomial.X (0 : Fin (r :: rs).length) :
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) •
      DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) n z =
        DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
          (headFullPieceHeadAction n z) := by
  refine Quotient.inductionOn' z ?_
  intro x
  -- Move the public generator to the internal associated-graded model, where the head monomial
  -- action is explicit on quotient representatives.
  apply (quasiRegularAssociatedGradedAddEquiv (r :: rs) M).injective
  change
    (quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
        ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M).symm
          (quasiRegularAssociatedGradedPolynomialSmul (r :: rs)
            (MvPolynomial.X (0 : Fin (r :: rs).length))
            ((quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
              (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) n
                (Submodule.Quotient.mk x))))) =
      (quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
        (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
          (headFullPieceHeadAction n (Submodule.Quotient.mk x)))
  rw [AddEquiv.apply_symm_apply]
  have hlof :
      (quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
          (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) n
            (Submodule.Quotient.mk x)) =
        DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk x) := by
    simpa only [quasiRegularAssociatedGradedInternalPieceEquiv_symm_apply_mk] using
      quasiRegularAssociatedGradedAddEquiv_apply_lof
        (r :: rs) n
        (Submodule.Quotient.mk x)
  rw [hlof]
  have hX :
      quasiRegularAssociatedGradedPolynomialSmul (r :: rs)
          (MvPolynomial.X (0 : Fin (r :: rs).length))
          (DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
            (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
            (Submodule.Quotient.mk x)) =
        quasiRegularAssociatedGradedMonomialAction (r :: rs)
          (Finsupp.single (0 : Fin (r :: rs).length) 1)
          (DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
            (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
            (Submodule.Quotient.mk x)) := by
    simpa [MvPolynomial.X] using
      (quasiRegularAssociatedGradedPolynomialSmul_monomial
        (r :: rs)
        (1 : R ⧸ Ideal.ofList (r :: rs))
        (Finsupp.single (0 : Fin (r :: rs).length) 1)
        (DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) n
          (Submodule.Quotient.mk x)))
  rw [hX]
  rw [headVariableAction_lof_stageClass_raw x.2]
  -- On the target side, the degreewise head action is already normalized on representatives.
  have hlofSucc :
      (quasiRegularAssociatedGradedAddEquiv (r :: rs) M)
          (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
            (headFullPieceHeadAction n (Submodule.Quotient.mk x))) =
        DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
          (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) (n + 1)
          (Submodule.Quotient.mk
            (⟨r • (x : M), headSmul_mem_nextStage x.2⟩ :
              idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1))) := by
    simpa only [headFullPieceHeadAction_apply_mk,
      quasiRegularAssociatedGradedInternalPieceEquiv_symm_apply_mk] using
      quasiRegularAssociatedGradedAddEquiv_apply_lof
        (r :: rs) (n + 1)
        (headFullPieceHeadAction n (Submodule.Quotient.mk x))
  rw [hlofSucc]
  -- Normalize the degree cast `n + |X 0| = n + 1` and the representative `weight(X 0) • x = r • x`.
  let y :
      quasiRegularStage (r :: rs) M
        (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1)) :=
    ⟨quasiRegularAssociatedGradedMonomialWeight (r :: rs)
        (Finsupp.single (0 : Fin (r :: rs).length) 1) • (x : M),
      quasiRegularAssociatedGradedMonomialWeight_smul_mem_stage (r :: rs) n
        (Finsupp.single (0 : Fin (r :: rs).length) 1) ⟨(x : M), x.2⟩⟩
  have hdeg :
      n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1) = n + 1 := by
    rw [headMonomialTotalDegree_single_zero]
  have hcastStage :
      cast (congrArg (fun k ↦ ↥(quasiRegularStage (r :: rs) M k)) hdeg) y =
        (⟨r • (x : M), headSmul_mem_nextStage x.2⟩ :
          quasiRegularStage (r :: rs) M (n + 1)) := by
    have hcastVal :
        (((cast (congrArg (fun k ↦ ↥(quasiRegularStage (r :: rs) M k)) hdeg) y :
            quasiRegularStage (r :: rs) M (n + 1)) : M)) =
          r • (x : M) := by
      calc
        (((cast (congrArg (fun k ↦ ↥(quasiRegularStage (r :: rs) M k)) hdeg) y :
            quasiRegularStage (r :: rs) M (n + 1)) : M)) =
          quasiRegularAssociatedGradedMonomialWeight (r :: rs)
            (Finsupp.single (0 : Fin (r :: rs).length) 1) • (x : M) := by
              simpa [y] using
                (quasiRegularStage_cast_coe (r :: rs) hdeg y)
        _ = r • (x : M) := by
              rw [headMonomialWeight_single_zero]
    apply Subtype.ext
    exact hcastVal
  have hcastPiece :
      cast (congrArg (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) hdeg)
          (Submodule.Quotient.mk y :
            quasiRegularAssociatedGradedInternalPiece (r :: rs) M
              (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1))) =
        (Submodule.Quotient.mk
          (⟨r • (x : M), headSmul_mem_nextStage x.2⟩ :
            quasiRegularStage (r :: rs) M (n + 1)) :
          quasiRegularAssociatedGradedInternalPiece (r :: rs) M (n + 1)) := by
    rw [← quasiRegularAssociatedGradedInternalPiece_cast_mk (r :: rs) hdeg y]
    rw [hcastStage]
  calc
    DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
        (quasiRegularAssociatedGradedInternalPiece (r :: rs) M)
        (n + quasiRegularTotalDegree (Finsupp.single (0 : Fin (r :: rs).length) 1))
        (Submodule.Quotient.mk y) =
      DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
        (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) (n + 1)
        (cast (congrArg (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) hdeg)
          (Submodule.Quotient.mk y)) := by
            symm
            exact quasiRegularAssociatedGraded_lof_cast
              (r :: rs) hdeg (Submodule.Quotient.mk y)
    _ =
      DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
        (quasiRegularAssociatedGradedInternalPiece (r :: rs) M) (n + 1)
        (Submodule.Quotient.mk
          (⟨r • (x : M), headSmul_mem_nextStage x.2⟩ :
            quasiRegularStage (r :: rs) M (n + 1))) := by
              rw [hcastPiece]

/-- Helper for Chap10 Lemma 10 69 5: the kernel of the descended degree-`n + 1` source-piece map
is exactly the range of the degreewise head-variable action from degree `n`. -/
private theorem headFullPieceToQuotientPiece_ker_eq_headVariableRange
    {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs)) (n : ℕ) :
    LinearMap.ker (@headFullPieceToQuotientPiece R _ M _ _ r rs n) =
      LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n) := by
  apply le_antisymm
  · intro z hz
    rw [LinearMap.mem_ker] at hz
    revert hz
    refine Quotient.inductionOn' z ?_
    intro x hz
    have hz' : headFullStageToQuotientPiece (n + 1) x = 0 := by
      simpa using hz
    rcases
        (headFullStageToQuotientPiece_eq_zero_iff_exists_sub_smul_mem_prevStage hqr n x).1 hz' with
      ⟨m, hm⟩
    refine LinearMap.mem_range.2 ?_
    refine ⟨Submodule.Quotient.mk m, ?_⟩
    symm
    rw [headFullPieceHeadAction_apply_mk]
    have hmk :
        (Submodule.Quotient.mk x :
          idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1)) =
        Submodule.Quotient.mk
          (⟨r • (m : M), headSmul_mem_nextStage m.2⟩ :
            idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) := by
      rw [Submodule.Quotient.eq]
      exact hm
    simpa using hmk
  · rintro z ⟨w, rfl⟩
    refine Quotient.inductionOn' w ?_
    intro x
    change (headFullPieceToQuotientPiece n)
      ((headFullPieceHeadAction n) (Submodule.Quotient.mk x)) = 0
    rw [headFullPieceHeadAction_apply_mk, headFullPieceToQuotientPiece_apply_mk]
    rw [headFullStageToQuotientPiece_eq_zero_iff_exists_sub_smul_mem_prevStage hqr]
    refine ⟨x, ?_⟩
    simpa using
      (show
        ((⟨r • (x : M), headSmul_mem_nextStage x.2⟩ :
            idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) : M) -
            r • (x : M) ∈
          idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 2) from by
        simpa)

/-- Helper for Chap10 Lemma 10 69 5: in each positive degree, quotienting the source piece by the
degreewise head-variable range identifies it with the quotient-side piece. -/
private noncomputable def headVariableTargetPositivePieceQuotientEquiv
    {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs)) (n : ℕ) :
    (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) ⧸
        LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) ≃ₗ[R]
      idealAssociatedGradedPiece
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) (n + 1) :=
  -- First replace the quotient denominator by the kernel of the descended piece map, then use
  -- the first isomorphism theorem and the surjectivity of that descended map.
  let eKer :
      (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) ⧸
          LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) ≃ₗ[R]
        (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) ⧸
          LinearMap.ker (@headFullPieceToQuotientPiece R _ M _ _ r rs n)) :=
    Submodule.quotEquivOfEq
      (LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n))
      (LinearMap.ker (@headFullPieceToQuotientPiece R _ M _ _ r rs n))
      (headFullPieceToQuotientPiece_ker_eq_headVariableRange hqr n).symm
  let eRange :
      LinearMap.range (@headFullPieceToQuotientPiece R _ M _ _ r rs n) ≃ₗ[R]
        idealAssociatedGradedPiece
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
          (QuotSMulTop r M) (n + 1) :=
    LinearEquiv.ofTop _ (LinearMap.range_eq_top.2 (headFullPieceToQuotientPiece_surjective n))
  eKer.trans <|
    (LinearMap.quotKerEquivRange (@headFullPieceToQuotientPiece R _ M _ _ r rs n)).trans eRange

/-- Helper for Chap10 Lemma 10 69 5: the positive-degree quotient normalization still computes on
quotient representatives by the descended stage-to-piece map. -/
@[simp] private theorem headVariableTargetPositivePieceQuotientEquiv_apply_mk
    {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs)) (n : ℕ)
    (z : idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M (n + 1)) :
    headVariableTargetPositivePieceQuotientEquiv (R := R) (M := M) hqr n
        (Submodule.Quotient.mk
          (((Submodule.Quotient.mk z) :
            idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1)))) =
      headFullPieceToQuotientPiece (R := R) (M := M) (r := r) (rs := rs) n
        (((Submodule.Quotient.mk z) :
          idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1))) := by
  -- The positive-degree quotient normalization is induced by the descended piece map, so it still
  -- computes on quotient representatives by that map.
  simp [headVariableTargetPositivePieceQuotientEquiv]

/-- Helper for Chap10 Lemma 10 69 5: the positive-degree part of the full associated graded module
remembers each degree `n + 1` only modulo the head-action range coming from degree `n`. -/
-- TODO: once the positive-degree quotient pieces are restored, package them into a direct-sum map.
private noncomputable def headVariableTargetPositivePart
    {r : R} {rs : List R} :
    let I : Ideal R := Ideal.ofList (r :: rs)
    idealAssociatedGradedModule I M →ₗ[R]
      DirectSum ℕ (fun n ↦
        idealAssociatedGradedPiece I M (n + 1) ⧸
          LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) :=
  let I : Ideal R := Ideal.ofList (r :: rs)
  -- The positive-degree quotient package is assembled by sending degree `0` to zero and each
  -- degree `n + 1` to its quotient class in the `n`th positive summand.
  DirectSum.toModule R ℕ
    (DirectSum ℕ (fun n ↦
      idealAssociatedGradedPiece I M (n + 1) ⧸
        LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n))) fun
    | 0 => 0
    | n + 1 =>
        ((DirectSum.lof R ℕ
            (fun k ↦
              idealAssociatedGradedPiece I M (k + 1) ⧸
                LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k))
            n).comp
          (Submodule.mkQ
            (LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n))))

/-- Helper for Chap10 Lemma 10 69 5: the global quotient-normalization map records degree `0`
literally and each positive degree modulo the corresponding head-action range. -/
-- TODO: combine the degree-`0` component and `headVariableTargetPositivePart` into the split map.
private noncomputable def headVariableTargetSplitMap
    {r : R} {rs : List R} :
    let I : Ideal R := Ideal.ofList (r :: rs)
    idealAssociatedGradedModule I M →ₗ[R]
      idealAssociatedGradedPiece I M 0 ×
        DirectSum ℕ (fun n ↦
          idealAssociatedGradedPiece I M (n + 1) ⧸
            LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) :=
  let I : Ideal R := Ideal.ofList (r :: rs)
  -- The split normalization keeps degree `0` literally and records every positive degree only
  -- modulo the corresponding head-action range.
  (DirectSum.component R ℕ (idealAssociatedGradedPiece I M) 0).prod
    (@headVariableTargetPositivePart R _ M _ _ r rs)

-- Helper for Chap10 Lemma 10 69 5: the split-map kernel placeholder below uses the temporary
-- `R`-linear spelling of the global `X 0` action.
-- TODO: package the global `X 0` action as an `R`-linear endomorphism after the quotient-ring
-- scalar-action bridge is repaired.
/-- Helper for Chap10 Lemma 10 69 5: the global `X 0` action on the full associated graded module
in a temporary `R`-linear spelling used by the target split-map placeholder. -/
private noncomputable def headVariableTargetX0smul
    {r : R} {rs : List R} :
    let I : Ideal R := Ideal.ofList (r :: rs)
    idealAssociatedGradedModule I M →ₗ[R] idealAssociatedGradedModule I M :=
  let I : Ideal R := Ideal.ofList (r :: rs)
  -- This temporary `R`-linear endomorphism is the degreewise head-action packaged over the full
  -- direct sum.
  DirectSum.toModule R ℕ (idealAssociatedGradedModule I M) fun n ↦
    ((DirectSum.lof R ℕ (idealAssociatedGradedPiece I M) (n + 1)).comp
      (@headFullPieceHeadAction R _ M _ _ r rs n))

-- TODO: prove this by evaluating `headVariableTargetSplitMap` on `DirectSum.lof` generators and
-- using `headVariableTargetSmul_lof`.
private theorem headVariableTargetSplitMap_range_le_ker
    {r : R} {rs : List R} :
    let I : Ideal R := Ideal.ofList (r :: rs)
    LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs) ≤
      LinearMap.ker (@headVariableTargetSplitMap R _ M _ _ r rs) := by
  -- It is enough to prove that the composite `splitMap ∘ X0smul` is the zero map on each
  -- homogeneous generator.
  rw [LinearMap.range_le_ker_iff]
  apply DirectSum.linearMap_ext
  intro n
  apply LinearMap.ext
  intro z
  ext
  · -- The first component extracts degree `0`, while `X0smul` raises degree by one.
    simp [LinearMap.comp_apply, headVariableTargetSplitMap, headVariableTargetX0smul,
      DirectSum.toModule_lof, DirectSum.component.of]
  · -- In the positive-degree package, the image lands in the quotient by the head-action range.
    have hmk :
        (Submodule.Quotient.mk (headFullPieceHeadAction n z) :
          idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) ⧸
            LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) = 0 := by
      rw [Submodule.Quotient.mk_eq_zero]
      exact ⟨z, rfl⟩
    simpa [LinearMap.comp_apply, headVariableTargetSplitMap, headVariableTargetPositivePart,
      headVariableTargetX0smul, DirectSum.toModule_lof, hmk]

/-- Helper for Chap10 Lemma 10 69 5: the `n`th component of the positive-degree quotient package
is the quotient class of the degree `n + 1` homogeneous component. -/
@[simp] private theorem headVariableTargetPositivePart_component
    {r : R} {rs : List R} (n : ℕ)
    (x : idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M) :
    DirectSum.component R ℕ
        (fun k ↦
          idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (k + 1) ⧸
            LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k))
        n
        (headVariableTargetPositivePart (r := r) (rs := rs) x) =
      ((Submodule.Quotient.mk
        (DirectSum.component R ℕ
          (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1) x)) :
          idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) ⧸
            LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) := by
  have hmap :
      ((DirectSum.component R ℕ
          (fun k ↦
            idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (k + 1) ⧸
              LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k))
          n).comp
        (headVariableTargetPositivePart (r := r) (rs := rs))) =
      ((Submodule.mkQ (LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n))).comp
        (DirectSum.component R ℕ
          (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1))) := by
    -- Compare the two linear maps on homogeneous generators of the direct sum.
    apply DirectSum.linearMap_ext R
    intro i
    apply LinearMap.ext
    intro z
    cases i with
    | zero =>
        simp [headVariableTargetPositivePart, DirectSum.toModule_lof, DirectSum.component.of]
    | succ k =>
        by_cases h : k = n
        · subst h
          simp [headVariableTargetPositivePart, DirectSum.toModule_lof]
        · simp [headVariableTargetPositivePart, DirectSum.toModule_lof, DirectSum.component.of, h]
  -- Evaluate the linear-map identity on the chosen graded element.
  simpa [LinearMap.comp_apply] using LinearMap.congr_fun hmap x

/-- Helper for Chap10 Lemma 10 69 5: the temporary global `X 0` action sends a degree-`n`
generator to the corresponding degree-`n + 1` generator given by `headFullPieceHeadAction`. -/
@[simp] private theorem headVariableTargetX0smul_lof
    {r : R} {rs : List R} (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M n) :
    headVariableTargetX0smul
        (r := r) (rs := rs)
        (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) n z) =
      DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
        (headFullPieceHeadAction n z) := by
  -- Unfold the direct-sum package of the global head-variable action on one generator.
  simp [headVariableTargetX0smul, DirectSum.toModule_lof]

/-- Helper for Chap10 Lemma 10 69 5: the temporary target endomorphism `headVariableTargetX0smul`
is the genuine action of the head polynomial variable on the full associated graded module. -/
private theorem headVariableTargetX0smul_eq_smul
    {r : R} {rs : List R}
    (x : idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M) :
    headVariableTargetX0smul (R := R) (M := M) (r := r) (rs := rs) x =
      (MvPolynomial.X (0 : Fin (r :: rs).length) :
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) • x := by
  -- Compare the two `R`-linear endomorphisms on homogeneous generators and then reassemble by
  -- direct-sum induction.
  refine DirectSum.induction_on x ?_ ?_ ?_
  · simp [headVariableTargetX0smul]
  · intro n z
    -- Both endomorphisms send a homogeneous generator to the same degree-shifted generator.
    simpa [DirectSum.lof_eq_of] using
      (headVariableTargetX0smul_lof (r := r) (rs := rs) n z).trans
        (headVariableTargetSmul_lof (r := r) (rs := rs) n z).symm
  · intro x y hx hy
    simp [map_add, hx, hy]

/-- Helper for Chap10 Lemma 10 69 5: the explicit split normalization kills exactly the global
`X 0`-image on the full associated graded module. -/
private theorem headVariableTargetSplitMap_ker_eq_range
    {r : R} {rs : List R} :
    LinearMap.ker (@headVariableTargetSplitMap R _ M _ _ r rs) =
      LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs) := by
  refine le_antisymm ?_ ?_
  · intro x hx
    rw [LinearMap.mem_ker] at hx
    classical
    have hx0 :
        DirectSum.component R ℕ
            (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 x = 0 := by
      -- The first projection of the split map is exactly the degree-`0` component.
      exact congrArg Prod.fst hx
    have hpositive :
        ∀ n,
          ∃ w : idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M n,
            headFullPieceHeadAction n w =
              DirectSum.component R ℕ
                (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1) x := by
      intro n
      have hsnd :
          (@headVariableTargetPositivePart R _ M _ _ r rs) x = 0 := by
        exact congrArg Prod.snd hx
      have hcomponent :
          DirectSum.component R ℕ
              (fun k ↦
                idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (k + 1) ⧸
                  LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k))
              n
              ((@headVariableTargetPositivePart R _ M _ _ r rs) x) = 0 := by
        exact congrArg
          (fun z ↦
            DirectSum.component R ℕ
              (fun k ↦
                idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (k + 1) ⧸
                  LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k))
              n z)
          hsnd
      have hmk :
          ((Submodule.Quotient.mk
            (DirectSum.component R ℕ
              (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1) x)) :
              idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) ⧸
                LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) = 0 := by
        simpa using hcomponent
      rw [Submodule.Quotient.mk_eq_zero, LinearMap.mem_range] at hmk
      exact hmk
    let y : idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M :=
      x.support.sum fun n ↦
        match n with
        | 0 => 0
        | k + 1 =>
            DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) k
              (Classical.choose (hpositive k))
    refine LinearMap.mem_range.2 ⟨y, ?_⟩
    -- Compare both sides degreewise after reassembling the predecessor witnesses.
    apply DirectSum.ext_component R
    intro m
    cases m with
    | zero =>
        calc
          DirectSum.component R ℕ
              (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0
              ((@headVariableTargetX0smul R _ M _ _ r rs) y) =
            x.support.sum fun n ↦
              DirectSum.component R ℕ
                (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0
                ((@headVariableTargetX0smul R _ M _ _ r rs)
                  (match n with
                  | 0 => 0
                  | k + 1 =>
                      DirectSum.lof R ℕ
                        (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) k
                        (Classical.choose (hpositive k)))) := by
                simp [y]
          _ = 0 := by
                refine Finset.sum_eq_zero ?_
                intro n hn
                cases n with
                | zero =>
                    simp
                | succ k =>
                    simp [headVariableTargetX0smul_lof, DirectSum.component.of]
          _ = DirectSum.component R ℕ
                (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 x := by
                simpa using hx0.symm
    | succ n =>
        by_cases hmem : n + 1 ∈ x.support
        · calc
            DirectSum.component R ℕ
                (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
                ((@headVariableTargetX0smul R _ M _ _ r rs) y) =
              x.support.sum fun m ↦
                DirectSum.component R ℕ
                  (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
                  ((@headVariableTargetX0smul R _ M _ _ r rs)
                    (match m with
                    | 0 => 0
                    | k + 1 =>
                        DirectSum.lof R ℕ
                          (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) k
                          (Classical.choose (hpositive k)))) := by
                  simp [y]
            _ =
              DirectSum.component R ℕ
                (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
                ((@headVariableTargetX0smul R _ M _ _ r rs)
                  (DirectSum.lof R ℕ
                    (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) n
                    (Classical.choose (hpositive n)))) := by
                  refine Finset.sum_eq_single_of_mem (n + 1) hmem ?_
                  intro m hm hne
                  cases m with
                  | zero =>
                      simp
                  | succ k =>
                      have hne' : k ≠ n := by
                        intro hEq
                        exact hne (congrArg Nat.succ hEq)
                      simp [headVariableTargetX0smul_lof, DirectSum.component.of, hne']
            _ =
              DirectSum.component R ℕ
                (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1) x := by
                  rw [headVariableTargetX0smul_lof]
                  rw [Classical.choose_spec (hpositive n)]
                  simp
        · have hxsucc :
            DirectSum.component R ℕ
                (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1) x = 0 := by
            by_contra hxne
            exact hmem ((x.mem_support_toFun (n + 1)).2 hxne)
          calc
            DirectSum.component R ℕ
                (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
                ((@headVariableTargetX0smul R _ M _ _ r rs) y) =
              x.support.sum fun m ↦
                DirectSum.component R ℕ
                  (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1)
                  ((@headVariableTargetX0smul R _ M _ _ r rs)
                    (match m with
                    | 0 => 0
                    | k + 1 =>
                        DirectSum.lof R ℕ
                          (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) k
                          (Classical.choose (hpositive k)))) := by
                  simp [y]
            _ = 0 := by
                  refine Finset.sum_eq_zero ?_
                  intro m hm
                  cases m with
                  | zero =>
                      simp
                  | succ k =>
                      have hne : k + 1 ≠ n + 1 := by
                        intro hEq
                        exact hmem (hEq ▸ hm)
                      have hne' : k ≠ n := by
                        intro hEq
                        exact hne (congrArg Nat.succ hEq)
                      simp [headVariableTargetX0smul_lof, DirectSum.component.of, hne']
            _ = DirectSum.component R ℕ
                  (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1) x := by
                  simpa using hxsucc.symm
  · simpa using
      (@headVariableTargetSplitMap_range_le_ker R _ M _ _ r rs)

/-- Helper for Chap10 Lemma 10 69 5: the split map fixes a degree-`0` homogeneous generator and
has no positive-degree contribution there. -/
@[simp] private theorem headVariableTargetSplitMap_lof_zero
    {r : R} {rs : List R}
    (z : idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M 0) :
    headVariableTargetSplitMap
        (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 z) =
      (z, 0) := by
  -- Evaluate the split map on the single degree-`0` generator; the first projection records that
  -- class literally, and the positive-degree quotient package vanishes on degree `0`.
  apply Prod.ext
  · simpa [headVariableTargetSplitMap] using
      (DirectSum.component.lof_self (R := R) (ι := ℕ)
        (M := idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 z)
  · simpa [headVariableTargetPositivePart, DirectSum.lof_eq_of] using
      (DirectSum.toModule_lof
        (R := R)
        (ι := ℕ)
        (N := DirectSum ℕ (fun n ↦
          idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1) ⧸
            LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)))
        (M := idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M)
        (φ := fun
          | 0 => 0
          | n + 1 =>
              ((DirectSum.lof R ℕ
                  (fun k ↦
                    idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (k + 1) ⧸
                      LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k))
                  n).comp
                (Submodule.mkQ
                  (LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)))))
        0 z)

/-- Helper for Chap10 Lemma 10 69 5: the split map sends a degree-`n + 1` homogeneous generator
to its quotient class in the `n`th positive summand and has zero degree-`0` component. -/
@[simp] private theorem headVariableTargetSplitMap_lof_succ
    {r : R} {rs : List R} (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1)) :
    headVariableTargetSplitMap
        (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1) z) =
      (0, DirectSum.lof R ℕ
        (fun k ↦
          idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (k + 1) ⧸
            LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k))
        n
        (Submodule.Quotient.mk z)) := by
  -- Evaluate the split map on a single positive-degree generator; the first projection vanishes,
  -- and the positive-degree package remembers only the quotient class in the matching summand.
  apply Prod.ext
  · have hne : n + 1 ≠ 0 := Nat.succ_ne_zero n
    simpa [headVariableTargetSplitMap, DirectSum.component.of, hne] using
      (DirectSum.component.of (R := R) (ι := ℕ)
        (M := idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 (n + 1) z)
  · simpa [headVariableTargetPositivePart, DirectSum.lof_eq_of] using
      (DirectSum.toModule_lof
        (R := R)
        (ι := ℕ)
        (N := DirectSum ℕ (fun k ↦
          idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (k + 1) ⧸
            LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k)))
        (M := idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M)
        (φ := fun
          | 0 => 0
          | k + 1 =>
              ((DirectSum.lof R ℕ
                  (fun j ↦
                    idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (j + 1) ⧸
                      LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs j))
                  k).comp
                (Submodule.mkQ
                  (LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs k)))))
        (n + 1) z)

/-- Helper for Chap10 Lemma 10 69 5: the split map hits every degree-`0` class and every positive
quotient class, so it is surjective onto the explicit target normal form. -/
private theorem headVariableTargetSplitMap_surjective
    {r : R} {rs : List R} :
    Function.Surjective (@headVariableTargetSplitMap R _ M _ _ r rs) := by
  let splitMap := @headVariableTargetSplitMap R _ M _ _ r rs
  intro y
  rcases y with ⟨z0, zs⟩
  have hpos :
      ∃ x : idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M,
        splitMap x = (0, zs) := by
    induction zs using DirectSum.induction_on with
    | zero =>
        refine ⟨0, ?_⟩
        rfl
    | @of n q =>
        refine Quotient.inductionOn' q ?_
        intro x
        refine ⟨DirectSum.lof R ℕ
            (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) (n + 1) x, ?_⟩
        simpa [DirectSum.lof_eq_of] using
          (headVariableTargetSplitMap_lof_succ n x)
    | add y z hy hz =>
        rcases hy with ⟨xy, hxy⟩
        rcases hz with ⟨xz, hxz⟩
        refine ⟨xy + xz, ?_⟩
        calc
          splitMap (xy + xz) =
              splitMap xy + splitMap xz := by
                simp
          _ = (0, y) + (0, z) := by rw [hxy, hxz]
          _ = (0, y + z) := by simp
  rcases hpos with ⟨xpos, hxpos⟩
  refine ⟨DirectSum.lof R ℕ
      (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 z0 + xpos, ?_⟩
  calc
    splitMap
        (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 z0 + xpos) =
      splitMap
        (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 z0) +
        splitMap xpos := by
          simp
    _ = (z0, 0) + (0, zs) := by rw [headVariableTargetSplitMap_lof_zero, hxpos]
    _ = (z0, zs) := by simp

/-- Helper for Chap10 Lemma 10 69 5: quotienting the full target associated graded module by the
global `X 0`-image is canonically equivalent to the explicit split normal form with degree `0`
and the positive-degree quotient pieces. -/
private noncomputable def headVariableTargetSplitQuotientEquiv
    {r : R} {rs : List R} :
    let I : Ideal R := Ideal.ofList (r :: rs)
    (idealAssociatedGradedModule I M ⧸
        LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs)) ≃ₗ[R]
      idealAssociatedGradedPiece I M 0 ×
        DirectSum ℕ (fun n ↦
          idealAssociatedGradedPiece I M (n + 1) ⧸
            LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) :=
  let I : Ideal R := Ideal.ofList (r :: rs)
  let eDenom :
      (idealAssociatedGradedModule I M ⧸
          LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs)) ≃ₗ[R]
        (idealAssociatedGradedModule I M ⧸
          LinearMap.ker (@headVariableTargetSplitMap R _ M _ _ r rs)) :=
    Submodule.quotEquivOfEq
      (LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs))
      (LinearMap.ker (@headVariableTargetSplitMap R _ M _ _ r rs))
      (@headVariableTargetSplitMap_ker_eq_range R _ M _ _ r rs).symm
  let eRange :
      LinearMap.range (@headVariableTargetSplitMap R _ M _ _ r rs) ≃ₗ[R]
        idealAssociatedGradedPiece I M 0 ×
          DirectSum ℕ (fun n ↦
            idealAssociatedGradedPiece I M (n + 1) ⧸
              LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) :=
    LinearEquiv.ofTop _ (LinearMap.range_eq_top.2
      (@headVariableTargetSplitMap_surjective R _ M _ _ r rs))
  -- First replace the quotient denominator by the split-map kernel, then apply the first
  -- isomorphism theorem and identify the full range with the whole split codomain.
  eDenom.trans <|
    (LinearMap.quotKerEquivRange (@headVariableTargetSplitMap R _ M _ _ r rs)).trans eRange

/-- Helper for Chap10 Lemma 10 69 5: multiplication by the head polynomial variable on the
textbook source of `(r :: rs)` is an `R`-linear endomorphism. -/
private noncomputable def headVariableSourceX0smul
    {r : R} {rs : List R} :
    ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) →ₗ[R]
      ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :=
  let I : Ideal R := Ideal.ofList (r :: rs)
  let A : Type u := R ⧸ I
  let Q : Type v := M ⧸ (I • (⊤ : Submodule R M))
  let P : Type u := MvPolynomial (Fin (r :: rs).length) A
  let comm : (Q ⊗[A] P) ≃ₗ[A] (P ⊗[A] Q) := TensorProduct.comm A Q P
  let commLin : (Q ⊗[A] P) →ₗ[A] (P ⊗[A] Q) := comm.toLinearMap
  let commSymm : (P ⊗[A] Q) →ₗ[A] (Q ⊗[A] P) := comm.symm.toLinearMap
  let x0 : P := MvPolynomial.X (0 : Fin (r :: rs).length)
  -- Conjugate the canonical left-polynomial multiplication map back to the textbook source
  -- orientation.
  ((commSymm.comp (((LinearMap.mulLeft A x0).rTensor Q).comp commLin))).restrictScalars R

/-- Helper for Chap10 Lemma 10 69 5: evaluating the head variable to zero on the textbook source
of `(r :: rs)` keeps the coefficient quotient fixed and only removes the first polynomial
variable. -/
private noncomputable def headVariableSourceEval
    {r : R} {rs : List R} :
    ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) →ₗ[R]
      ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList (r :: rs))) :=
  let I : Ideal R := Ideal.ofList (r :: rs)
  let A : Type u := R ⧸ I
  let Q : Type v := M ⧸ (I • (⊤ : Submodule R M))
  let Psucc : Type u := MvPolynomial (Fin (r :: rs).length) A
  let Ptail : Type u := MvPolynomial (Fin rs.length) A
  let commSrc : (Q ⊗[A] Psucc) ≃ₗ[A] (Psucc ⊗[A] Q) := TensorProduct.comm A Q Psucc
  let commTgt : (Q ⊗[A] Ptail) ≃ₗ[A] (Ptail ⊗[A] Q) := TensorProduct.comm A Q Ptail
  let commSrcLin : (Q ⊗[A] Psucc) →ₗ[A] (Psucc ⊗[A] Q) := commSrc.toLinearMap
  let commTgtSymm : (Ptail ⊗[A] Q) →ₗ[A] (Q ⊗[A] Ptail) := commTgt.symm.toLinearMap
  let evalZero : Psucc →ₗ[A] Ptail := (headVariablePolynomialEvalZeroAlgHom rs.length).toLinearMap
  -- Evaluate the first polynomial variable at zero in the canonical left-polynomial tensor
  -- orientation and then commute back to the textbook source orientation.
  ((commTgtSymm.comp ((TensorProduct.map evalZero (LinearMap.id : Q →ₗ[A] Q)).comp
      commSrcLin))).restrictScalars R

/-- Helper for Chap10 Lemma 10 69 5: the source evaluation map has the explicit section obtained
by inserting only successor variables. -/
private noncomputable def headVariableSourceLift
    {r : R} {rs : List R} :
    ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList (r :: rs))) →ₗ[R]
      ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :=
  let I : Ideal R := Ideal.ofList (r :: rs)
  let A : Type u := R ⧸ I
  let Q : Type v := M ⧸ (I • (⊤ : Submodule R M))
  let Ptail : Type u := MvPolynomial (Fin rs.length) A
  let includeTail : Ptail →ₗ[A] MvPolynomial (Fin (r :: rs).length) A :=
    (headVariablePolynomialIncludeAlgHom rs.length).toLinearMap
  -- Insert only successor variables in the polynomial factor while keeping the coefficient
  -- quotient fixed.
  (TensorProduct.map (LinearMap.id : Q →ₗ[A] Q) includeTail).restrictScalars R

/-- Helper for Chap10 Lemma 10 69 5: evaluating the explicit source lift returns the original tail
source tensor. -/
private theorem headVariableSourceEval_headVariableSourceLift_apply
    {r : R} {rs : List R}
    (z : (M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableSourceEval (headVariableSourceLift z) =
      z := by
  let I : Ideal R := Ideal.ofList (r :: rs)
  let A : Type u := R ⧸ I
  let Q : Type v := M ⧸ (I • (⊤ : Submodule R M))
  -- Check the right-inverse identity on simple tensors; additivity reassembles the full tensor.
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · simp [headVariableSourceEval, headVariableSourceLift, LinearMap.comp_apply]
  · intro p q
    simp [headVariableSourceEval, headVariableSourceLift, LinearMap.comp_apply,
      headVariablePolynomialEvalZeroAlgHom_include]
  · intro x y hx hy
    simp [map_add, hx, hy]

/-- Helper for Chap10 Lemma 10 69 5: the source evaluation map is surjective because the
successor-variable insertion gives an explicit right inverse. -/
private theorem headVariableSourceEval_surjective
    {r : R} {rs : List R} :
    Function.Surjective (@headVariableSourceEval R _ M _ _ r rs) := by
  intro z
  refine ⟨headVariableSourceLift z, ?_⟩
  exact headVariableSourceEval_headVariableSourceLift_apply z

/-- Helper for Chap10 Lemma 10 69 5: after multiplying by the head variable in the textbook
source, the source evaluation map sends the result to zero. -/
-- TODO: Restore the source `X 0` kernel computation and then rebuild the quotient normalization
-- lemmas below from that calculation.
private theorem headVariableSourceEval_headVariableSourceX0smul_apply
    {r : R} {rs : List R}
    (z : (M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableSourceEval (headVariableSourceX0smul z) =
      0 := by
  -- Check the vanishing on simple tensors by evaluating `X 0` to zero, then reassemble by tensor
  -- induction.
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · simp
  · intro m p
    simp [headVariableSourceEval, headVariableSourceX0smul, LinearMap.comp_apply, map_mul]
  · intro x y hx hy
    simp [map_add, hx, hy]

/-- Helper for Chap10 Lemma 10 69 5: the textbook-source `X 0` image is contained in the kernel
of the source evaluation map. -/
private theorem headVariableSourceX0smul_range_le_ker
    {r : R} {rs : List R} :
    let f :
        ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
          MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) →ₗ[R]
          ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
            MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList (r :: rs))) :=
      headVariableSourceEval
    let g :
        ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
          MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) →ₗ[R]
          ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
            MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :=
      headVariableSourceX0smul
    LinearMap.range g ≤ LinearMap.ker f := by
  -- Package the vanishing composite as the standard `range ≤ ker` statement.
  dsimp
  intro z hz
  rcases hz with ⟨w, rfl⟩
  rw [LinearMap.mem_ker]
  simpa using
    headVariableSourceEval_headVariableSourceX0smul_apply w

/-- Helper for Chap10 Lemma 10 69 5: the explicit source lift inserts only successor variables on
simple tensors. -/
@[simp] private theorem headVariableSourceLift_tmul
    {r : R} {rs : List R}
    (m : M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)))
    (p : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableSourceLift (R := R) (r := r) (rs := rs)
        (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p) =
      m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)]
        headVariablePolynomialIncludeAlgHom rs.length p := by
  -- Unfold the tensor-factor map once; on a simple tensor it just applies the inclusion map to
  -- the polynomial factor.
  simp [headVariableSourceLift]

/-- Helper for Chap10 Lemma 10 69 5: the source evaluation map evaluates the polynomial factor at
`X 0 = 0` on simple tensors. -/
@[simp] private theorem headVariableSourceEval_tmul
    {r : R} {rs : List R}
    (m : M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)))
    (p : MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableSourceEval (R := R) (r := r) (rs := rs)
        (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p) =
      m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)]
        headVariablePolynomialEvalZeroAlgHom rs.length p := by
  -- Commute to the left-polynomial orientation, evaluate there, and commute back.
  simp [headVariableSourceEval, LinearMap.comp_apply]

/-- Helper for Chap10 Lemma 10 69 5: the source `X 0` action multiplies the polynomial factor by
the head variable on simple tensors. -/
@[simp] private theorem headVariableSourceX0smul_tmul
    {r : R} {rs : List R}
    (m : M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)))
    (p : MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableSourceX0smul (R := R) (r := r) (rs := rs)
        (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p) =
      m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)]
        ((MvPolynomial.X (0 : Fin (r :: rs).length)) * p) := by
  -- Commute to the left-polynomial orientation, multiply there by `X 0`, and commute back.
  simp [headVariableSourceX0smul, LinearMap.comp_apply, mul_comm]

/-- Helper for Chap10 Lemma 10 69 5: the temporary source endomorphism `headVariableSourceX0smul`
is the genuine action of the head polynomial variable on the textbook source tensor. -/
private theorem headVariableSourceX0smul_eq_smul
    {r : R} {rs : List R}
    (z : (M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableSourceX0smul (R := R) (M := M) (r := r) (rs := rs) z =
      (MvPolynomial.X (0 : Fin (r :: rs).length) :
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) • z := by
  -- Compare the two source-side endomorphisms on simple tensors and then reassemble by tensor
  -- induction.
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · simp [headVariableSourceX0smul]
  · intro m p
    rw [headVariableSourceX0smul_tmul]
    simp [Algebra.smul_def]
  · intro x y hx hy
    simp [map_add, hx, hy]

/-- Helper for Chap10 Lemma 10 69 5: every polynomial splits as its `X 0 = 0` tail part plus a
multiple of the head variable. -/
private theorem headVariablePolynomialSplit
    {A : Type*} [CommRing A] (n : ℕ)
    (p : MvPolynomial (Fin (n + 1)) A) :
    ∃ q : MvPolynomial (Fin (n + 1)) A,
      p =
        headVariablePolynomialIncludeAlgHom n
          (headVariablePolynomialEvalZeroAlgHom n p) +
        MvPolynomial.X (0 : Fin (n + 1)) * q := by
  let X0 : MvPolynomial (Fin (n + 1)) A := MvPolynomial.X (0 : Fin (n + 1))
  let X0Ideal : Ideal (MvPolynomial (Fin (n + 1)) A) := Ideal.span ({X0} : Set _)
  let pTail :=
    headVariablePolynomialIncludeAlgHom n (headVariablePolynomialEvalZeroAlgHom n p)
  have hmk :
      Ideal.Quotient.mk X0Ideal (p - pTail) = 0 := by
    -- Compare the quotient class with the explicit evaluation-at-zero model on representatives.
    apply (headVariablePolynomialQuotientEquiv n).injective
    simp [X0Ideal, X0, pTail, map_sub]
  have hmem : p - pTail ∈ X0Ideal := by
    rw [Ideal.Quotient.eq_zero_iff_mem] at hmk
    exact hmk
  obtain ⟨q, hq⟩ := Ideal.mem_span_singleton'.mp (by simpa [X0Ideal, X0] using hmem)
  refine ⟨q, ?_⟩
  -- Rewrite the difference term as a head-variable multiple and then reassemble `p`.
  calc
    p = (p - pTail) + pTail := by simpa [pTail] using (sub_add_cancel p pTail).symm
    _ = q * X0 + pTail := by rw [hq]
    _ = pTail + X0 * q := by simp [X0, pTail, add_comm, mul_comm]

/-- Helper for Chap10 Lemma 10 69 5: every textbook-source element is its evaluated tail part plus
an `X 0`-multiple. -/
private theorem headVariableSourceSplit
    {r : R} {rs : List R}
    (z : (M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    ∃ w,
      z =
        headVariableSourceLift (headVariableSourceEval z) +
        headVariableSourceX0smul w := by
  -- Decompose the polynomial factor on simple tensors, then reassemble the tensor by linearity.
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · refine ⟨0, by simp⟩
  · intro m p
    rcases headVariablePolynomialSplit rs.length p with ⟨q, hq⟩
    refine ⟨m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] q, ?_⟩
    -- Rewrite the simple tensor through the polynomial splitting and then identify each summand
    -- with the named source lift and head-variable action.
    calc
      m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p =
          m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)]
            (headVariablePolynomialIncludeAlgHom rs.length
              (headVariablePolynomialEvalZeroAlgHom rs.length p)) +
            m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] (MvPolynomial.X 0 * q) := by
              rw [hq, TensorProduct.tmul_add]
      _ =
          headVariableSourceLift
              (headVariableSourceEval
                (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p)) +
            headVariableSourceX0smul
              (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] q) := by
              simp [headVariableSourceLift_tmul, headVariableSourceEval_tmul,
                headVariableSourceX0smul_tmul, hq]
  · intro x y hx hy
    rcases hx with ⟨wx, hx⟩
    rcases hy with ⟨wy, hy⟩
    refine ⟨wx + wy, ?_⟩
    -- The additive decomposition is preserved by the linear source lift and head-variable action.
    rw [hx, hy, map_add, map_add, headVariableSourceEval_headVariableSourceLift_apply,
      headVariableSourceEval_headVariableSourceX0smul_apply,
      headVariableSourceEval_headVariableSourceLift_apply,
      headVariableSourceEval_headVariableSourceX0smul_apply]
    abel

/-- Helper for Chap10 Lemma 10 69 5: the source evaluation kernel is exactly the public source
`X 0`-range. -/
private theorem headVariableSourceEval_ker_eq_headVariableSourceX0smul_range
    {r : R} {rs : List R} :
    LinearMap.ker (@headVariableSourceEval R _ M _ _ r rs) =
      LinearMap.range (@headVariableSourceX0smul R _ M _ _ r rs) := by
  -- One inclusion is the existing vanishing-composite statement; the reverse inclusion comes from
  -- splitting a kernel element into its evaluated part plus an `X 0`-multiple.
  refine le_antisymm ?_ ?_
  · intro z hz
    rw [LinearMap.mem_ker] at hz
    rcases headVariableSourceSplit z with ⟨w, hw⟩
    refine LinearMap.mem_range.2 ⟨w, ?_⟩
    rw [hw, hz]
    simp
  · simpa using
      (@headVariableSourceX0smul_range_le_ker R _ M _ _ r rs)

/-- Helper for Chap10 Lemma 10 69 5: quotienting the upstairs textbook source by the public
`X 0`-image is canonically equivalent to the tail tensor obtained by evaluating `X 0 = 0`. -/
private noncomputable def headVariableSourceEvalQuotientEquiv
    {r : R} {rs : List R} :
    (((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) ⧸
        LinearMap.range (@headVariableSourceX0smul R _ M _ _ r rs)) ≃ₗ[R]
      ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList (r :: rs))) :=
  let eDenom :
      (((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
          MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) ⧸
          LinearMap.range (@headVariableSourceX0smul R _ M _ _ r rs)) ≃ₗ[R]
        (((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
            MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) ⧸
          LinearMap.ker (@headVariableSourceEval R _ M _ _ r rs)) :=
    Submodule.quotEquivOfEq
      (LinearMap.range (@headVariableSourceX0smul R _ M _ _ r rs))
      (LinearMap.ker (@headVariableSourceEval R _ M _ _ r rs))
      (@headVariableSourceEval_ker_eq_headVariableSourceX0smul_range R _ M _ _ r rs).symm
  let eRange :
      LinearMap.range (@headVariableSourceEval R _ M _ _ r rs) ≃ₗ[R]
        ((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
          MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList (r :: rs))) :=
    LinearEquiv.ofTop _ (LinearMap.range_eq_top.2
      (@headVariableSourceEval_surjective R _ M _ _ r rs))
  -- Replace the quotient denominator by the evaluation kernel, then apply the first
  -- isomorphism theorem and identify the range with the whole target using surjectivity.
  eDenom.trans <|
    (LinearMap.quotKerEquivRange (@headVariableSourceEval R _ M _ _ r rs)).trans eRange

/-- Helper for Chap10 Lemma 10 69 5: the source quotient equivalence computes on quotient classes
by applying the source evaluation map. -/
@[simp] private theorem headVariableSourceEvalQuotientEquiv_apply_mk
    {r : R} {rs : List R}
    (z : (M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableSourceEvalQuotientEquiv (Submodule.Quotient.mk z) =
      headVariableSourceEval z := by
  -- The quotient normalization is induced by evaluation at `X 0 = 0`, so it still computes on
  -- quotient representatives by the ambient evaluation map.
  simp [headVariableSourceEvalQuotientEquiv]

/-- Helper for Chap10 Lemma 10 69 5: the source quotient equivalence computes on simple tensors
by evaluating the polynomial factor at `X 0 = 0`. -/
@[simp] private theorem headVariableSourceEvalQuotientEquiv_apply_mk_tmul
    {r : R} {rs : List R}
    (m : M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)))
    (p : MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableSourceEvalQuotientEquiv
        (Submodule.Quotient.mk (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p)) =
      m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)]
        headVariablePolynomialEvalZeroAlgHom rs.length p := by
  -- Specialize the quotient-representative computation to a simple tensor and then simplify the
  -- ambient evaluation map on the polynomial factor.
  simpa using
    (headVariableSourceEvalQuotientEquiv_apply_mk
      (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p))

/-- Helper for Chap10 Lemma 10 69 5: the degree-zero associated-graded piece is the quotient of
the ambient module by the first positive filtration stage. -/
private noncomputable def idealAssociatedGradedPieceZeroLinearEquiv
    (J : Ideal R) :
    idealAssociatedGradedPiece J M 0 ≃ₗ[R] M ⧸ idealAssociatedGradedStage J M 1 :=
  let P0 : Submodule R M := idealAssociatedGradedStage J M 0
  let P1 : Submodule R P0 := (idealAssociatedGradedStage J M 1).submoduleOf P0
  have hP0 : P0 = ⊤ := by
    simp [P0, idealAssociatedGradedStage]
  let eStage : P0 ≃ₗ[R] M :=
    (LinearEquiv.ofEq P0 (⊤ : Submodule R M) hP0).trans Submodule.topEquiv
  have hmap : P1.map eStage.toLinearMap = idealAssociatedGradedStage J M 1 := by
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      -- The stage-`0` identification does not change the underlying representative.
      simpa [eStage] using hy
    · intro hx
      refine ⟨⟨x, ?_⟩, hx, ?_⟩
      · simpa [P0, idealAssociatedGradedStage]
      · simp [eStage]
  -- Descend the degree-`0` stage identification to the quotient by the successor stage.
  Submodule.Quotient.equiv P1 (idealAssociatedGradedStage J M 1) eStage hmap

/-- Helper for Chap10 Lemma 10 69 5: the degree-zero split component on the upstairs associated
graded quotient is exactly the downstairs degree-zero associated-graded piece after quotienting by
the head term. -/
private noncomputable def headVariableTargetZeroPieceEquiv
    {r : R} {rs : List R} :
    let K : Ideal R := Ideal.span ({r} : Set R)
    let rsbar : List (R ⧸ K) := rs.map (Ideal.Quotient.mk K)
    idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M 0 ≃ₗ[R]
      idealAssociatedGradedPiece (Ideal.ofList rsbar) (QuotSMulTop r M) 0 :=
  let K : Ideal R := Ideal.span ({r} : Set R)
  let KM : Submodule R M := K • (⊤ : Submodule R M)
  let rsbar : List (R ⧸ K) := rs.map (Ideal.Quotient.mk K)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList rsbar
  let P : Submodule (R ⧸ K) (M ⧸ KM) := Jbar • (⊤ : Submodule (R ⧸ K) (M ⧸ KM))
  let Q : Submodule (R ⧸ K) (QuotSMulTop r M) :=
    idealAssociatedGradedStage (Ideal.ofList rsbar) (QuotSMulTop r M) 1
  let eAmbient : (M ⧸ KM) ≃ₗ[R ⧸ K] QuotSMulTop r M :=
    headPrincipalQuotientEquivQuotSMulTop (R := R) (M := M) (r := r)
  have hmapPQ : P.map eAmbient.toLinearMap = Q := by
    -- The ambient quotient equivalence preserves the quotient-ring ideal action, so the stage-`1`
    -- denominator is exactly transported from the principal-head quotient model.
    calc
      P.map eAmbient.toLinearMap = Jbar • (⊤ : Submodule (R ⧸ K) (QuotSMulTop r M)) := by
        rw [Submodule.map_smul'']
        rw [Submodule.map_top, LinearMap.range_eq_top.2 eAmbient.surjective]
      _ = Q := by
        simp [Q, Jbar, idealAssociatedGradedStage]
  let eFullZero :
      idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M 0 ≃ₗ[R]
        M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)) := by
    let ePowOne :
        (M ⧸ ((Ideal.ofList (r :: rs)) ^ 1 • (⊤ : Submodule R M))) ≃ₗ[R]
          M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)) :=
      Submodule.quotEquivOfEq
        (((Ideal.ofList (r :: rs)) ^ 1) • (⊤ : Submodule R M))
        (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))
        (by simp [pow_one])
    simpa [idealAssociatedGradedStage] using
      (idealAssociatedGradedPieceZeroLinearEquiv
        (R := R) (M := M) (Ideal.ofList (r :: rs))).trans ePowOne
  let eHeadQuotient :
      (M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ≃ₗ[R]
        ((M ⧸ KM) ⧸ P.restrictScalars R) :=
    (headQuotientSourceModuleEquiv (R := R) (M := M) (r := r) (rs := rs)).symm
  let eRestrict :
      ((M ⧸ KM) ⧸ P.restrictScalars R) ≃ₗ[R]
        ((M ⧸ KM) ⧸ P) :=
    Submodule.Quotient.restrictScalarsEquiv R P
  let eStageOne :
      ((M ⧸ KM) ⧸ P) ≃ₗ[R]
        (QuotSMulTop r M ⧸ Q) :=
    (Submodule.Quotient.equiv P Q eAmbient hmapPQ).restrictScalars R
  let eDownstairsZero :
      (QuotSMulTop r M ⧸ Q) ≃ₗ[R]
        idealAssociatedGradedPiece (Ideal.ofList rsbar) (QuotSMulTop r M) 0 :=
    ((idealAssociatedGradedPieceZeroLinearEquiv
        (R := R ⧸ K) (M := QuotSMulTop r M) (Ideal.ofList rsbar)).symm).restrictScalars R
  -- Route correction: compare degree `0` through the quotient-by-stage-`1` models, then move the
  -- principal-head quotient ambient module to `QuotSMulTop r M` before rebuilding the degree-zero
  -- associated-graded piece downstairs.
  eFullZero.trans (eHeadQuotient.trans (eRestrict.trans (eStageOne.trans eDownstairsZero)))

/-- Helper for Chap10 Lemma 10 69 5: the inverse of the source quotient normalization is
represented by the explicit successor-variable lift on simple tensors. -/
@[simp] private theorem headVariableSourceEvalQuotientEquiv_symm_tmul
    {r : R} {rs : List R}
    (m : M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M)))
    (p : MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList (r :: rs))) :
    (headVariableSourceEvalQuotientEquiv).symm
        (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p) =
      Submodule.Quotient.mk
        (headVariableSourceLift
          (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p)) := by
  -- Apply the quotient normalization to both sides; both images reduce to the same tail tensor.
  apply (headVariableSourceEvalQuotientEquiv (R := R) (r := r) (rs := rs)).injective
  rw [headVariableSourceEvalQuotientEquiv_apply_mk, headVariableSourceEval_headVariableSourceLift_apply]
  simpa using
    (headVariableSourceEvalQuotientEquiv (R := R) (r := r) (rs := rs)).apply_symm_apply
      (m ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)] p)

/-- Helper for Chap10 Lemma 10 69 5: the quasi-regular associated-graded equivalence intertwines
the source-side and target-side `X 0` actions. -/
private theorem linearEquiv_map_headVariableSourceX0smul
    {r : R} {rs : List R}
    (hqr : IsQuasiRegular M (r :: rs))
    (z : (M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    (hqr.linearEquiv.restrictScalars R)
        (headVariableSourceX0smul (R := R) (M := M) (r := r) (rs := rs) z) =
      headVariableTargetX0smul (R := R) (M := M) (r := r) (rs := rs)
        ((hqr.linearEquiv.restrictScalars R) z) := by
  let X0 : MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs)) :=
    MvPolynomial.X (0 : Fin (r :: rs).length)
  -- Rewrite both temporary endomorphisms as honest `X 0` multiplication and use polynomial
  -- linearity of `hqr.linearEquiv`.
  calc
    (hqr.linearEquiv.restrictScalars R)
        (headVariableSourceX0smul (R := R) (M := M) (r := r) (rs := rs) z) =
      (hqr.linearEquiv.restrictScalars R) (X0 • z) := by
        rw [headVariableSourceX0smul_eq_smul]
    _ = X0 • (hqr.linearEquiv.restrictScalars R) z := by
        simpa [X0] using hqr.linearEquiv.map_smul X0 z
    _ = headVariableTargetX0smul (R := R) (M := M) (r := r) (rs := rs)
          ((hqr.linearEquiv.restrictScalars R) z) := by
        rw [headVariableTargetX0smul_eq_smul]

/-- Helper for Chap10 Lemma 10 69 5: quotienting `hqr.linearEquiv` by the public source and
target `X 0`-ranges gives an `R`-linear equivalence of the quotients. -/
private noncomputable def headVariableLinearEquivQuotientEquiv
    {r : R} {rs : List R}
    (hqr : IsQuasiRegular M (r :: rs)) :
    ((((M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) ⧸
        LinearMap.range (@headVariableSourceX0smul R _ M _ _ r rs))) ≃ₗ[R]
      ((idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M) ⧸
        LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs)) := by
  have hmap :
      (LinearMap.range (@headVariableSourceX0smul R _ M _ _ r rs)).map
          (hqr.linearEquiv.restrictScalars R).toLinearMap =
        LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs) := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩
      rcases hx with ⟨z, rfl⟩
      refine LinearMap.mem_range.2 ⟨(hqr.linearEquiv.restrictScalars R) z, ?_⟩
      simpa using (linearEquiv_map_headVariableSourceX0smul (R := R) (M := M) hqr z).symm
    · rintro ⟨z, rfl⟩
      refine Submodule.mem_map.2 ?_
      refine ⟨headVariableSourceX0smul (R := R) (M := M) (r := r) (rs := rs)
          ((hqr.linearEquiv.restrictScalars R).symm z), ?_, ?_⟩
      · exact LinearMap.mem_range.2 ⟨((hqr.linearEquiv.restrictScalars R).symm z), rfl⟩
      · change (hqr.linearEquiv.restrictScalars R)
            (headVariableSourceX0smul (R := R) (M := M) (r := r) (rs := rs)
              ((hqr.linearEquiv.restrictScalars R).symm z)) =
          headVariableTargetX0smul (R := R) (M := M) (r := r) (rs := rs) z
        simpa using
          linearEquiv_map_headVariableSourceX0smul (R := R) (M := M) hqr
            ((hqr.linearEquiv.restrictScalars R).symm z)
  -- Descend the quasi-regular equivalence through the matching source and target `X 0`-ranges.
  exact
    Submodule.Quotient.equiv
      (LinearMap.range (@headVariableSourceX0smul R _ M _ _ r rs))
      (LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs))
      (hqr.linearEquiv.restrictScalars R)
      hmap

/-- Helper for Chap10 Lemma 10 69 5: the quotient of `hqr.linearEquiv` still computes on
quotient representatives by applying the ambient equivalence to that representative. -/
@[simp] private theorem headVariableLinearEquivQuotientEquiv_apply_mk
    {r : R} {rs : List R}
    (hqr : IsQuasiRegular M (r :: rs))
    (z : (M ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList (r :: rs)]
      MvPolynomial (Fin (r :: rs).length) (R ⧸ Ideal.ofList (r :: rs))) :
    headVariableLinearEquivQuotientEquiv (R := R) (M := M) hqr (Submodule.Quotient.mk z) =
      Submodule.Quotient.mk ((hqr.linearEquiv.restrictScalars R) z) := by
  -- The descended quotient equivalence is induced by the ambient linear equivalence, so it still
  -- acts on representatives by the same map.
  simp [headVariableLinearEquivQuotientEquiv]

/-- Helper for Chap10 Lemma 10 69 5: the `Option ℕ` index used by
`DirectSum.lequivProdDirectSum` is reindexed to `ℕ` by sending `none` to `0` and `some n` to
`n + 1`. -/
private def optionNatToNat : Option ℕ → ℕ
  | none => 0
  | some n => n + 1

/-- Helper for Chap10 Lemma 10 69 5: the inverse reindexing sends `0` back to `none` and
`n + 1` back to `some n`. -/
private def natToOptionNat : ℕ → Option ℕ
  | 0 => none
  | n + 1 => some n

/-- Helper for Chap10 Lemma 10 69 5: the `Option ℕ` to `ℕ` reindexing is left-inverse to the
explicit inverse map. -/
private theorem optionNatToNat_left_inv :
    Function.LeftInverse natToOptionNat optionNatToNat := by
  -- The two cases are exactly the `none` and `some` branches.
  intro x
  cases x <;> rfl

/-- Helper for Chap10 Lemma 10 69 5: the `ℕ` to `Option ℕ` reindexing is right-inverse to the
explicit forward map. -/
private theorem optionNatToNat_right_inv :
    Function.RightInverse natToOptionNat optionNatToNat := by
  -- The two cases are exactly `0` and `n + 1`.
  intro n
  cases n <;> rfl

/-- Helper for Chap10 Lemma 10 69 5: the `0/succ` splitting index `Option ℕ` is equivalent to
`ℕ`. -/
private def optionNatEquivNat : Option ℕ ≃ ℕ :=
  { toFun := optionNatToNat
    invFun := natToOptionNat
    left_inv := optionNatToNat_left_inv
    right_inv := optionNatToNat_right_inv }

/-- Helper for Chap10 Lemma 10 69 5: the inverse of the explicit `Option ℕ ≃ ℕ` reindexing is
the concrete `natToOptionNat` map. -/
@[simp] private theorem optionNatEquivNat_symm_apply (n : ℕ) :
    optionNatEquivNat.symm n = natToOptionNat n := rfl

/-- Helper for Chap10 Lemma 10 69 5: reindexing the `Option ℕ` split direct sum back to `ℕ`
matches the explicit `0/succ` splitting used in the target normal form. -/
private noncomputable def directSumZeroSuccLinearEquivAux
    (α : ℕ → Type w) [∀ n, AddCommGroup (α n)] [∀ n, Module R (α n)] :
    (α 0 × DirectSum ℕ (fun n ↦ α (n + 1))) ≃ₗ[R] DirectSum ℕ α :=
  let β : Option ℕ → Type w
    | none => α 0
    | some n => α (n + 1)
  letI : ∀ i, AddCommGroup (β i) := by
    intro i
    cases i <;> infer_instance
  letI : ∀ i, Module R (β i) := by
    intro i
    cases i <;> infer_instance
  let eSplit :
      DirectSum (Option ℕ) β ≃ₗ[R] (β none × DirectSum ℕ (fun n ↦ β (some n))) :=
    DirectSum.lequivProdDirectSum R
  let eReindex :
      DirectSum (Option ℕ) β ≃ₗ[R] DirectSum ℕ α :=
    let eCongr :
        DirectSum (Option ℕ) β ≃ₗ[R] DirectSum ℕ (fun n ↦ β (optionNatEquivNat.symm n)) :=
      DirectSum.lequivCongrLeft R optionNatEquivNat
    let hβ : (fun n ↦ β (optionNatEquivNat.symm n)) = α := by
      funext n
      cases n with
      | zero => rfl
      | succ k => rfl
    hβ ▸ eCongr
  eSplit.symm.trans eReindex

/-- Helper for Chap10 Lemma 10 69 5: splitting a graded direct sum over `ℕ` into its degree-`0`
part and its positive-degree tail is a linear equivalence. -/
private noncomputable def directSumZeroSuccLinearEquiv
    (α : ℕ → Type w) [∀ n, AddCommGroup (α n)] [∀ n, Module R (α n)] :
    (α 0 × DirectSum ℕ (fun n ↦ α (n + 1))) ≃ₗ[R] DirectSum ℕ α :=
  directSumZeroSuccLinearEquivAux α

/-- Helper for Chap10 Lemma 10 69 5: splitting a graded direct sum and then reassembling sends a
degree-`0` term back to the degree-`0` direct-sum generator. -/
@[simp] private theorem directSumZeroSuccLinearEquiv_apply_zero
    (α : ℕ → Type*) [∀ n, AddCommGroup (α n)] [∀ n, Module R (α n)]
    (z : α 0) :
    (directSumZeroSuccLinearEquiv (R := R) α).toLinearMap (z, 0) =
      DirectSum.lof R ℕ α 0 z := by
  -- Unfold the split-then-reindex equivalence and compute on the degree-`0` generator.
  let β : Option ℕ → Type _ := fun
    | none => α 0
    | some n => α (n + 1)
  letI : ∀ i, AddCommGroup (β i) := by
    intro i
    cases i <;> infer_instance
  letI : ∀ i, Module R (β i) := by
    intro i
    cases i <;> infer_instance
  have hsplit :
      (DirectSum.lequivProdDirectSum R).symm
          (((z, 0) : β none × DirectSum ℕ fun n ↦ β (some n))) =
        DirectSum.lof R (Option ℕ) β none z := by
    ext i
    cases i <;> simp [DirectSum.lequivProdDirectSum, β]
  rw [directSumZeroSuccLinearEquiv, directSumZeroSuccLinearEquivAux, hsplit]
  simpa [β, optionNatEquivNat, optionNatToNat, natToOptionNat] using
    (DirectSum.lequivCongrLeft_lof
      (R := R)
      (e := optionNatEquivNat)
      (i := none)
      (k := 0)
      rfl
      z
      z
      rfl)

/-- Helper for Chap10 Lemma 10 69 5: splitting a graded direct sum and then reassembling sends a
positive-degree term back to the corresponding successor direct-sum generator. -/
@[simp] private theorem directSumZeroSuccLinearEquiv_apply_succ
    (α : ℕ → Type*) [∀ n, AddCommGroup (α n)] [∀ n, Module R (α n)]
    (n : ℕ) (z : α (n + 1)) :
    (directSumZeroSuccLinearEquiv (R := R) α).toLinearMap
        (0, DirectSum.lof R ℕ (fun k ↦ α (k + 1)) n z) =
      DirectSum.lof R ℕ α (n + 1) z := by
  -- Unfold the split-then-reindex equivalence and compute on a positive-degree generator.
  let β : Option ℕ → Type _ := fun
    | none => α 0
    | some k => α (k + 1)
  letI : ∀ i, AddCommGroup (β i) := by
    intro i
    cases i <;> infer_instance
  letI : ∀ i, Module R (β i) := by
    intro i
    cases i <;> infer_instance
  have hsplit :
      (DirectSum.lequivProdDirectSum R).symm
          (((0, DirectSum.lof R ℕ (fun k ↦ β (some k)) n z) :
              β none × DirectSum ℕ fun k ↦ β (some k))) =
        DirectSum.lof R (Option ℕ) β (some n) z := by
    ext i
    cases i with
    | none =>
        simp [DirectSum.lequivProdDirectSum, β, DirectSum.lof_eq_of]
    | some k =>
        by_cases h : k = n
        · subst h
          simp [DirectSum.lequivProdDirectSum, β, DirectSum.lof_eq_of]
        · simp [DirectSum.lequivProdDirectSum, β, DirectSum.lof_eq_of, h]
  rw [directSumZeroSuccLinearEquiv, directSumZeroSuccLinearEquivAux, hsplit]
  simpa [β, optionNatEquivNat, optionNatToNat, natToOptionNat] using
    (DirectSum.lequivCongrLeft_lof
      (R := R)
      (e := optionNatEquivNat)
      (i := some n)
      (k := n + 1)
      rfl
      z
      z
      rfl)

/-- Helper for Chap10 Lemma 10 69 5: the quotiented upstairs associated graded module is already
the downstairs associated graded module after the explicit degree-`0` and positive-degree
normalizations. -/
private noncomputable def headVariableTargetDownstairsEquiv
    {r : R} {rs : List R}
    (hqr : IsQuasiRegular M (r :: rs)) :
    ((idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M) ⧸
        LinearMap.range (@headVariableTargetX0smul R _ M _ _ r rs)) ≃ₗ[R]
      idealAssociatedGradedModule
        (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
        (QuotSMulTop r M) := by
  let I : Ideal R := Ideal.ofList (r :: rs)
  let rsbar : List (R ⧸ Ideal.span ({r} : Set R)) :=
    rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))
  let ePositive :
      DirectSum ℕ (fun n ↦
        idealAssociatedGradedPiece I M (n + 1) ⧸
          LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n)) ≃ₗ[R]
        DirectSum ℕ (fun n ↦
          idealAssociatedGradedPiece (Ideal.ofList rsbar) (QuotSMulTop r M) (n + 1)) :=
    DirectSum.congrLinearEquiv fun n ↦
      headVariableTargetPositivePieceQuotientEquiv (R := R) (M := M) hqr n
  let eSplit :
      (idealAssociatedGradedPiece I M 0 ×
          DirectSum ℕ (fun n ↦
            idealAssociatedGradedPiece I M (n + 1) ⧸
              LinearMap.range (@headFullPieceHeadAction R _ M _ _ r rs n))) ≃ₗ[R]
        (idealAssociatedGradedPiece (Ideal.ofList rsbar) (QuotSMulTop r M) 0 ×
          DirectSum ℕ (fun n ↦
            idealAssociatedGradedPiece (Ideal.ofList rsbar) (QuotSMulTop r M) (n + 1))) :=
    LinearEquiv.prodCongr
      (headVariableTargetZeroPieceEquiv (R := R) (M := M) (r := r) (rs := rs))
      ePositive
  -- Repackage the target quotient into its degree-`0` part and positive tail, then reassemble
  -- the full downstairs associated graded direct sum.
  exact
    (headVariableTargetSplitQuotientEquiv (R := R) (M := M) (r := r) (rs := rs)).trans <|
      eSplit.trans <|
        directSumZeroSuccLinearEquiv (R := R)
          (fun n ↦
            idealAssociatedGradedPiece (Ideal.ofList rsbar) (QuotSMulTop r M) n)

/-- Helper for Chap10 Lemma 10 69 5: the split-quotient normal form still computes on quotient
representatives by the explicit split map. -/
@[simp] private theorem headVariableTargetSplitQuotientEquiv_apply_mk
    {r : R} {rs : List R}
    (z : idealAssociatedGradedModule (Ideal.ofList (r :: rs)) M) :
    headVariableTargetSplitQuotientEquiv (R := R) (M := M) (r := r) (rs := rs)
        (Submodule.Quotient.mk z) =
      headVariableTargetSplitMap (R := R) (M := M) (r := r) (rs := rs) z := by
  -- The quotient normalization is induced by the split map, so it still computes on quotient
  -- representatives by that map.
  simp [headVariableTargetSplitQuotientEquiv]

/-- Helper for Chap10 Lemma 10 69 5: the target downstairs equivalence sends a degree-`0`
generator to the downstairs degree-`0` generator obtained from the zero-piece identification. -/
@[simp] private theorem headVariableTargetDownstairsEquiv_apply_lof_zero
    {r : R} {rs : List R}
    (hqr : IsQuasiRegular M (r :: rs))
    (z : idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M 0) :
    headVariableTargetDownstairsEquiv (R := R) (M := M) hqr
        (Submodule.Quotient.mk
          (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 z)) =
      DirectSum.lof R ℕ
        (fun n ↦
          idealAssociatedGradedPiece
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n)
        0
        (headVariableTargetZeroPieceEquiv (R := R) (M := M) (r := r) (rs := rs) z) := by
  -- Normalize first to the split `0/succ` model, then reassemble the direct sum on the degree-0
  -- generator.
  calc
    headVariableTargetDownstairsEquiv (R := R) (M := M) hqr
        (Submodule.Quotient.mk
          (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M) 0 z)) =
      (directSumZeroSuccLinearEquiv (R := R)
        (fun n ↦
          idealAssociatedGradedPiece
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) n))
        (headVariableTargetZeroPieceEquiv (R := R) (M := M) (r := r) (rs := rs) z, 0) := by
          rw [headVariableTargetDownstairsEquiv]
          rw [headVariableTargetSplitQuotientEquiv_apply_mk]
          simpa [headVariableTargetSplitMap_lof_zero, DirectSum.lof_eq_of]
    _ = DirectSum.lof R ℕ
          (fun n ↦
            idealAssociatedGradedPiece
              (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
              (QuotSMulTop r M) n)
          0
          (headVariableTargetZeroPieceEquiv (R := R) (M := M) (r := r) (rs := rs) z) := by
          exact
            directSumZeroSuccLinearEquiv_apply_zero
              (R := R)
              (fun n ↦
                idealAssociatedGradedPiece
                  (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
                  (QuotSMulTop r M) n)
              (headVariableTargetZeroPieceEquiv (R := R) (M := M) (r := r) (rs := rs) z)

/-- Helper for Chap10 Lemma 10 69 5: the target downstairs equivalence sends a positive-degree
generator to the corresponding downstairs positive-degree generator after quotienting by the head
action in that degree. -/
@[simp] private theorem headVariableTargetDownstairsEquiv_apply_lof_succ
    {r : R} {rs : List R}
    (hqr : IsQuasiRegular M (r :: rs)) (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M (n + 1)) :
    headVariableTargetDownstairsEquiv (R := R) (M := M) hqr
        (Submodule.Quotient.mk
          (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M)
            (n + 1) z)) =
      DirectSum.lof R ℕ
        (fun k ↦
          idealAssociatedGradedPiece
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) k)
        (n + 1)
        (headVariableTargetPositivePieceQuotientEquiv (R := R) (M := M) hqr n
          (Submodule.Quotient.mk z)) := by
  -- Normalize first to the split `0/succ` model, then reassemble the direct sum on the chosen
  -- positive-degree generator.
  calc
    headVariableTargetDownstairsEquiv (R := R) (M := M) hqr
        (Submodule.Quotient.mk
          (DirectSum.lof R ℕ (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M)
            (n + 1) z)) =
      (directSumZeroSuccLinearEquiv (R := R)
        (fun k ↦
          idealAssociatedGradedPiece
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) k))
        (0, DirectSum.lof R ℕ
          (fun k ↦
            idealAssociatedGradedPiece
              (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
              (QuotSMulTop r M) (k + 1))
          n
          (headVariableTargetPositivePieceQuotientEquiv (R := R) (M := M) hqr n
            (Submodule.Quotient.mk z))) := by
          rw [headVariableTargetDownstairsEquiv]
          rw [headVariableTargetSplitQuotientEquiv_apply_mk]
          simp [headVariableTargetSplitMap_lof_succ, DirectSum.lof_eq_of, LinearEquiv.map_zero]
    _ = DirectSum.lof R ℕ
          (fun k ↦
            idealAssociatedGradedPiece
              (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
              (QuotSMulTop r M) k)
          (n + 1)
          (headVariableTargetPositivePieceQuotientEquiv (R := R) (M := M) hqr n
            (Submodule.Quotient.mk z)) := by
          exact
            directSumZeroSuccLinearEquiv_apply_succ
              (R := R)
              (fun k ↦
                idealAssociatedGradedPiece
                  (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
                  (QuotSMulTop r M) k)
              n
              (headVariableTargetPositivePieceQuotientEquiv (R := R) (M := M) hqr n
                (Submodule.Quotient.mk z))

private instance iInfPowOfListQuotientModule
    (rs : List R) :
    Module
      (R ⧸ (iInf fun n : ℕ ↦ ((Ideal.ofList rs) ^ n : Ideal R)))
      (M ⧸ (iInf fun n : ℕ ↦
        ((((Ideal.ofList rs) ^ n) • (⊤ : Submodule R M)) : Submodule R M))) := by
  let J : Ideal R := Ideal.ofList rs
  let K : Ideal R := iInf fun n : ℕ ↦ (J ^ n : Ideal R)
  have hK :
      Module.IsTorsionBySet R
        (M ⧸ (iInf fun n : ℕ ↦ (((J ^ n) • (⊤ : Submodule R M)) : Submodule R M)))
        (K : Set R) := by
    rw [Module.isTorsionBySet_quotient_iff]
    intro x r hr
    change r ∈ iInf fun n : ℕ ↦ (J ^ n : Ideal R) at hr
    rw [Submodule.mem_iInf]
    intro n
    exact Submodule.smul_mem_smul ((iInf_le (fun n : ℕ ↦ (J ^ n : Ideal R)) n) hr) (by simp)
  change Module (R ⧸ K)
      (M ⧸ (iInf fun n : ℕ ↦ (((J ^ n) • (⊤ : Submodule R M)) : Submodule R M)))
  exact Module.IsTorsionBySet.module hK

private instance iInfPowOfListQuotientIsScalarTower
    (rs : List R) :
    IsScalarTower
      R
      (R ⧸ (iInf fun n : ℕ ↦ ((Ideal.ofList rs) ^ n : Ideal R)))
      (M ⧸ (iInf fun n : ℕ ↦
        ((((Ideal.ofList rs) ^ n) • (⊤ : Submodule R M)) : Submodule R M))) := by
  let J : Ideal R := Ideal.ofList rs
  let K : Ideal R := iInf fun n : ℕ ↦ (J ^ n : Ideal R)
  have hK :
      Module.IsTorsionBySet R
        (M ⧸ (iInf fun n : ℕ ↦ (((J ^ n) • (⊤ : Submodule R M)) : Submodule R M)))
        (K : Set R) := by
    rw [Module.isTorsionBySet_quotient_iff]
    intro x r hr
    change r ∈ iInf fun n : ℕ ↦ (J ^ n : Ideal R) at hr
    rw [Submodule.mem_iInf]
    intro n
    exact Submodule.smul_mem_smul ((iInf_le (fun n : ℕ ↦ (J ^ n : Ideal R)) n) hr) (by simp)
  change IsScalarTower R (R ⧸ K)
      (M ⧸ (iInf fun n : ℕ ↦ (((J ^ n) • (⊤ : Submodule R M)) : Submodule R M)))
  exact Module.IsTorsionBySet.isScalarTower hK

/-- Helper for Chap10 Lemma 10 69 5: the quotient by `⊥` carries the expected `S ⧸ ⊥`-module
structure. -/
private instance quotientBotModule
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N] :
    Module (S ⧸ (⊥ : Ideal S)) (N ⧸ (⊥ : Submodule S N)) := by
  let hTors : Module.IsTorsionBySet S (N ⧸ (⊥ : Submodule S N)) (⊥ : Ideal S) := by
    rw [Module.isTorsionBySet_quotient_iff]
    intro x r hr
    have hr0 : r = 0 := by
      simpa using hr
    simp [hr0]
  exact hTors.module

/-- Helper for Chap10 Lemma 10 69 5: quotienting by `⊥` identifies `N` with `N ⧸ ⊥` after
transporting scalars through `S ≃ S ⧸ ⊥`. -/
private noncomputable def quotientBotSemilinearEquiv
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N] :
    N ≃ₛₗ[((RingEquiv.quotientBot S).symm : S →+* (S ⧸ (⊥ : Ideal S)))]
      (N ⧸ (⊥ : Submodule S N)) :=
  let e : (N ⧸ (⊥ : Submodule S N)) ≃ₗ[S] N :=
    Submodule.quotEquivOfEqBot (R := S) (M := N) (p := (⊥ : Submodule S N)) rfl
  { toFun := e.symm
    invFun := e
    left_inv := e.symm.left_inv
    right_inv := e.symm.right_inv
    map_add' := e.symm.map_add
    map_smul' := by
      -- The quotient-by-zero scalar action is the usual quotient-ring action on representatives.
      intro a x
      dsimp [e]
      simpa using (Module.Quotient.mk_smul_mk (M := N) (I := (⊥ : Ideal S)) a x).symm }

/-- Helper for Chap10 Lemma 10 69 5: `MvPolynomial.map` packages a ring equivalence into the
corresponding semilinear equivalence on multivariate polynomials. -/
private noncomputable def mvPolynomialSemilinearEquiv
    {A B : Type*} [CommRing A] [CommRing B]
    (σ : Type*) (e : A ≃+* B) :
    MvPolynomial σ A ≃ₛₗ[(e : A →+* B)] MvPolynomial σ B :=
  { toFun := MvPolynomial.map e.toRingHom
    invFun := MvPolynomial.map e.symm.toRingHom
    left_inv := by
      intro p
      rw [MvPolynomial.map_map]
      simpa using (MvPolynomial.map_id p)
    right_inv := by
      intro p
      rw [MvPolynomial.map_map]
      simpa using (MvPolynomial.map_id p)
    map_add' := by
      intro p q
      simp
    map_smul' := by
      intro a p
      simp [MvPolynomial.smul_eq_C_mul, mul_comm] }

/-- Helper for Chap10 Lemma 10 69 5: quotienting by the empty prefix leaves the quasi-regularity
statement unchanged after identifying both the ring and the module quotients by `⊥`. -/
private theorem tailQuotient_nil
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N]
    {zs : List S} (hqr : IsQuasiRegular N zs) :
    IsQuasiRegular
      (N ⧸ (Ideal.ofList ([] : List S) • (⊤ : Submodule S N)))
      (zs.map (Ideal.Quotient.mk (Ideal.ofList ([] : List S)))) := by
  -- Transport quasi-regularity through the quotient-by-zero ring and module identifications.
  have hbot :
      (Ideal.ofList ([] : List S) • (⊤ : Submodule S N)) = ⊥ := by
    exact
      Eq.trans
        (congrArg (fun I : Ideal S ↦ I • (⊤ : Submodule S N)) Ideal.ofList_nil)
        (bot_smul (⊤ : Submodule S N))
  simpa [Ideal.ofList_nil, hbot] using
    ((congrSemilinearEquiv
      ((RingEquiv.quotientBot S).symm)
      (quotientBotSemilinearEquiv (S := S) (N := N))
      (rs := zs)).mp hqr :
        IsQuasiRegular (N ⧸ (⊥ : Submodule S N)) (zs.map ((RingEquiv.quotientBot S).symm)))

/-- Helper for Chap10 Lemma 10 69 5: the append-form quotient ring for the singleton prefix `[r]`
is canonically the quotient by `Ideal.ofList (r :: rs)`. -/
private noncomputable def headSingletonTailQuotientRingEquiv
    {S : Type u} [CommRing S] {r : S} {rs : List S} :
    ((S ⧸ Ideal.ofList [r]) ⧸
        Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.ofList [r])))) ≃+*
      S ⧸ Ideal.ofList (r :: rs) := by
  simpa using
    (prefixTailQuotientRingEquiv (A := S) (ys := [r]) (zs := rs))

/-- Helper for Chap10 Lemma 10 69 5: the same singleton-prefix quotient ring equivalence written
with `Ideal.span ({r})` instead of `Ideal.ofList [r]`. -/
private noncomputable def headSingletonTailQuotientRingEquivSpanSingleton
    {S : Type u} [CommRing S] {r : S} {rs : List S} :
    ((S ⧸ Ideal.span ({r} : Set S)) ⧸
        Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set S))))) ≃+*
      S ⧸ Ideal.ofList (r :: rs) := by
  simpa [Ideal.ofList_singleton] using
    (headSingletonTailQuotientRingEquiv (S := S) (r := r) (rs := rs))

/-- Helper for Chap10 Lemma 10 69 5: the append-form coefficient semilinear equivalence still
sends a doubly quotiented representative to the corresponding class modulo the full list ideal. -/
@[simp] private theorem prefixTailCoefficientQuotientSemilinearEquiv_apply_mk_mk
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N]
    {ys zs : List S} (x : N) :
    prefixTailCoefficientQuotientSemilinearEquiv
        (R := S) (M := N) (ys := ys) (zs := zs)
        (Submodule.Quotient.mk (Submodule.Quotient.mk x)) =
      Submodule.Quotient.mk x := by
  -- Forget the semilinear packaging and reuse the underlying restricted-scalar quotient
  -- computation on the same double representative.
  simp [prefixTailCoefficientQuotientSemilinearEquiv,
    prefixTailCoefficientQuotientEquiv_restrict_apply_mk_mk]

/-- Helper for Chap10 Lemma 10 69 5: the principal-quotient tail source is transported to the
full-quotient tail tensor by the append-form coefficient quotient and coefficient-ring map. -/
private noncomputable def headSingletonTailSourceEquiv
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N]
    {r : S} {rs : List S} :
    ((((N ⧸ (Ideal.ofList [r] • (⊤ : Submodule S N))) ⧸
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.ofList [r]))) •
            (⊤ : Submodule (S ⧸ Ideal.ofList [r])
              (N ⧸ (Ideal.ofList [r] • (⊤ : Submodule S N)))))) ⊗[
          ((S ⧸ Ideal.ofList [r]) ⧸
            Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.ofList [r]))))]
        MvPolynomial (Fin rs.length)
          (((S ⧸ Ideal.ofList [r]) ⧸
            Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.ofList [r]))))))) ≃ₛₗ[
          (headSingletonTailQuotientRingEquiv (S := S) (r := r) (rs := rs) :
            ((S ⧸ Ideal.ofList [r]) ⧸
              Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.ofList [r])))) →+*
              S ⧸ Ideal.ofList (r :: rs))]
      (((N ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule S N))) ⊗[
          S ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial (Fin rs.length) (S ⧸ Ideal.ofList (r :: rs)))) :=
  -- Transport both tensor factors along the canonical append-form quotient equivalences.
  TensorProduct.congr
    (prefixTailCoefficientQuotientSemilinearEquiv
      (R := S) (M := N) (ys := [r]) (zs := rs))
    (mvPolynomialSemilinearEquiv
      (Fin rs.length)
      (headSingletonTailQuotientRingEquiv (S := S) (r := r) (rs := rs)))

/-- Helper for Chap10 Lemma 10 69 5: rewriting the principal ideal as `Ideal.span ({r})` only
changes notation in the source bridge from the first quotient to the full tail tensor. -/
private noncomputable def headSingletonTailSourceEquivSpanSingleton
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N]
    {r : S} {rs : List S} :
    ((((N ⧸ ((Ideal.span ({r} : Set S)) • (⊤ : Submodule S N))) ⧸
          (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set S)))) •
            (⊤ : Submodule (S ⧸ Ideal.span ({r} : Set S))
              (N ⧸ ((Ideal.span ({r} : Set S)) • (⊤ : Submodule S N)))))) ⊗[
          ((S ⧸ Ideal.span ({r} : Set S)) ⧸
            Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set S)))))]
        MvPolynomial (Fin rs.length)
          (((S ⧸ Ideal.span ({r} : Set S)) ⧸
            Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set S)))))))) ≃ₛₗ[
          (headSingletonTailQuotientRingEquivSpanSingleton (S := S) (r := r) (rs := rs) :
            ((S ⧸ Ideal.span ({r} : Set S)) ⧸
              Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set S))))) →+*
              S ⧸ Ideal.ofList (r :: rs))]
      (((N ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule S N))) ⊗[
          S ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial (Fin rs.length) (S ⧸ Ideal.ofList (r :: rs)))) := by
  -- This is the same bridge as `headSingletonTailSourceEquiv`; only the singleton ideal spelling
  -- changes.
  simpa [Ideal.ofList_singleton] using
    (headSingletonTailSourceEquiv (S := S) (N := N) (r := r) (rs := rs))

/-- Helper for Chap10 Lemma 10 69 5: on monomial simple tensors, the source bridge is the
identity on the representative and the monomial exponent data. -/
@[simp] private theorem headSingletonTailSourceEquiv_tmul_monomial
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N]
    {r : S} {rs : List S} (x : N) (d : Fin rs.length →₀ ℕ) :
    headSingletonTailSourceEquiv (S := S) (N := N) (r := r) (rs := rs)
        (Submodule.Quotient.mk (Submodule.Quotient.mk x) ⊗ₜ[
            ((S ⧸ Ideal.ofList [r]) ⧸
              Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.ofList [r]))))]
          MvPolynomial.monomial d
            (1 :
              ((S ⧸ Ideal.ofList [r]) ⧸
                Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.ofList [r])))))) =
      (Submodule.Quotient.mk x :
        N ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule S N))) ⊗ₜ[
          S ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial.monomial d (1 : S ⧸ Ideal.ofList (r :: rs)) := by
  -- Evaluate the semilinear tensor transport on the chosen simple tensor and simplify both the
  -- coefficient quotient and the coefficient-ring map on generators.
  simpa [headSingletonTailSourceEquiv, mvPolynomialSemilinearEquiv, MvPolynomial.map_monomial] using
    (TensorProduct.congr_tmul
      (prefixTailCoefficientQuotientSemilinearEquiv
        (R := S) (M := N) (ys := [r]) (zs := rs))
      (mvPolynomialSemilinearEquiv
        (Fin rs.length)
        (prefixTailQuotientRingEquiv (A := S) (ys := [r]) (zs := rs)))
      (Submodule.Quotient.mk (Submodule.Quotient.mk x))
      (MvPolynomial.monomial d
        (1 :
          ((S ⧸ Ideal.ofList [r]) ⧸
            Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.ofList [r])))))))

/-- Helper for Chap10 Lemma 10 69 5: after rewriting the principal ideal as `Ideal.span ({r})`,
the source bridge still sends the monomial simple tensor to the same full tail monomial tensor. -/
@[simp] private theorem headSingletonTailSourceEquivSpanSingleton_tmul_monomial
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N]
    {r : S} {rs : List S} (x : N) (d : Fin rs.length →₀ ℕ) :
    headSingletonTailSourceEquivSpanSingleton (S := S) (N := N) (r := r) (rs := rs)
        (Submodule.Quotient.mk (Submodule.Quotient.mk x) ⊗ₜ[
            ((S ⧸ Ideal.span ({r} : Set S)) ⧸
              Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set S)))))]
          MvPolynomial.monomial d
            (1 :
              ((S ⧸ Ideal.span ({r} : Set S)) ⧸
                Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set S))))))) =
      (Submodule.Quotient.mk x :
        N ⧸ (Ideal.ofList (r :: rs) • (⊤ : Submodule S N))) ⊗ₜ[
          S ⧸ Ideal.ofList (r :: rs)]
        MvPolynomial.monomial d (1 : S ⧸ Ideal.ofList (r :: rs)) := by
  -- This is the same simple-tensor computation as `headSingletonTailSourceEquiv_tmul_monomial`;
  -- only the singleton ideal spelling changes.
  simpa [Ideal.ofList_singleton] using
    (headSingletonTailSourceEquiv_tmul_monomial (S := S) (N := N) (r := r) (rs := rs) x d)

/-- Helper for Chap10 Lemma 10 69 5: inserting only successor variables sends a tail monomial to
the corresponding full-list monomial. -/
@[simp] private theorem headVariablePolynomialIncludeAlgHom_monomial
    {A : Type*} [CommRing A] {n : ℕ} (d : Fin n →₀ ℕ) (a : A) :
    headVariablePolynomialIncludeAlgHom n (MvPolynomial.monomial d a) =
      MvPolynomial.monomial (d.mapDomain Fin.succ) a := by
  -- The successor-variable insertion is exactly `MvPolynomial.rename` along `Fin.succ`.
  simp [headVariablePolynomialIncludeAlgHom, MvPolynomial.rename_monomial]

/-- Helper for Chap10 Lemma 10 69 5: applying `hqr.linearEquiv` to the lifted tail monomial
tensor produces the corresponding full associated-graded monomial class. -/
@[simp] private theorem headVariableLinearEquiv_liftedTailMonomial
    {r : R} {rs : List R} (hqr : IsQuasiRegular M (r :: rs))
    (x : M) (d : Fin rs.length →₀ ℕ) :
    (hqr.linearEquiv.restrictScalars R)
        (headVariableSourceLift (R := R) (r := r) (rs := rs)
          ((Submodule.Quotient.mk x) ⊗ₜ[R ⧸ Ideal.ofList (r :: rs)]
            MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList (r :: rs)))) =
      DirectSum.lof (R ⧸ Ideal.ofList (r :: rs)) ℕ
        (idealAssociatedGradedPiece (Ideal.ofList (r :: rs)) M)
        d.degree
        (Submodule.Quotient.mk
          (⟨(∏ i : Fin rs.length, rs.get i ^ d i) • x,
            (@tailAssociatedGradedStage_le_fullStage R _ M _ _ r rs d.degree)
              (ofList_monomial_weight_smul_mem_of_degree rs d.degree x d rfl)⟩ :
            idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M d.degree)) := by
  -- Rewrite the lift as the successor-variable monomial, then apply the standard monomial
  -- formula for the full quasi-regular comparison map.
  have hdeg : (d.mapDomain Fin.succ).degree = d.degree := by
    simpa using
      (Finsupp.degree_mapDomain_eq_of_subsingletonAddUnits Fin.succ d)
  rw [headVariableSourceLift_tmul, RingTheory.Sequence.IsQuasiRegular.linearEquiv,
    headVariablePolynomialIncludeAlgHom_monomial]
  rw [hdeg]
  simpa [DirectSum.lof_eq_of, List.getElem_cons_succ] using
    (quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_lof
      (rs := r :: rs) x (d.mapDomain Fin.succ))

/-- Helper for Chap10 Lemma 10 69 5: the degree-zero target equivalence sends the class of a
stage-zero representative to the downstairs class of the same quotient representative. -/
@[simp] private theorem headVariableTargetZeroPieceEquiv_apply_stageZeroClass
    {r : R} {rs : List R} (x : M) :
    headVariableTargetZeroPieceEquiv (R := R) (M := M) (r := r) (rs := rs)
        (Submodule.Quotient.mk
          (⟨x, by simp [idealAssociatedGradedStage]⟩ :
            idealAssociatedGradedStage (Ideal.ofList (r :: rs)) M 0)) =
      Submodule.Quotient.mk
        (⟨(Submodule.Quotient.mk x : QuotSMulTop r M), by
            simp [idealAssociatedGradedStage]⟩ :
          idealAssociatedGradedStage
            (Ideal.ofList (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set R)))))
            (QuotSMulTop r M) 0) := by
  -- Unfold the degree-zero equivalence to the quotient-by-stage-`1` model, then compute on the
  -- chosen representative throughout the quotient and ambient-module equivalences.
  simp [headVariableTargetZeroPieceEquiv, headPrincipalQuotientEquivQuotSMulTop_apply_mk,
    headQuotientSourceModuleEquiv_apply_mk_mk, idealAssociatedGradedStage, pow_one]

/-- Helper for Chap10 Lemma 10 69 5: quotienting a quasi-regular cons sequence by the head term
leaves the mapped tail quasi-regular on the first quotient. -/
private theorem headSingletonTail_isQuasiRegular
    {S : Type u} [CommRing S]
    {N : Type v} [AddCommGroup N] [Module S N]
    {r : S} {rs : List S} (hqr : IsQuasiRegular N (r :: rs)) :
    IsQuasiRegular
      (N ⧸ (Ideal.ofList [r] • (⊤ : Submodule S N)))
      (rs.map (Ideal.Quotient.mk (Ideal.ofList [r]))) := by
  -- Route correction: the earlier stalled proof searched for a larger downstairs transport theorem
  -- on `QuotSMulTop`. The stable frontier is now the direct source bridge above, so only the final
  -- conjugation between the principal-quotient associated-graded map and the quotient of
  -- `hqr.linearEquiv` remains.
  let K : Ideal S := Ideal.span ({r} : Set S)
  let rsbar : List (S ⧸ K) := rs.map (Ideal.Quotient.mk K)
  let ePrincipal :=
    headPrincipalQuotientEquivQuotSMulTop (R := S) (M := N) (r := r)
  let eSrc :=
    headSingletonTailSourceEquivSpanSingleton (S := S) (N := N) (r := r) (rs := rs)
  let eMidSrc :=
    (headVariableSourceEvalQuotientEquiv (R := S) (M := N) (r := r) (rs := rs)).symm
  let eMidTgt :=
    headVariableLinearEquivQuotientEquiv (R := S) (M := N) hqr
  let eDown :=
    headVariableTargetDownstairsEquiv (R := S) (M := N) hqr
  let eTgt :=
    quasiRegularSequenceAssociatedGradedTargetEquiv ePrincipal rsbar
  let f :=
    quasiRegularSequenceAssociatedGradedMap
      (N ⧸ (K • (⊤ : Submodule S N))) rsbar
  let g := eDown ∘ eMidTgt ∘ eMidSrc
  have hconj : eTgt ∘ f = g ∘ eSrc := by
    funext z
    obtain ⟨coeffs, hcoeffs⟩ := tensor_monomial_expansion rsbar z
    rw [hcoeffs, Finsupp.sum]
    simp only [Function.comp_apply, map_sum]
    refine Finset.sum_congr rfl ?_
    intro d hd
    refine Quotient.inductionOn' (coeffs d) ?_
    intro m
    refine Quotient.inductionOn' m ?_
    intro x
    -- On a monomial simple tensor, the source and target transports both reduce to explicit
    -- degreewise monomial classes.
    calc
      eTgt
          (f
            (Submodule.Quotient.mk (Submodule.Quotient.mk x) ⊗ₜ[
                ((S ⧸ K) ⧸ Ideal.ofList rsbar)]
              MvPolynomial.monomial d
                (1 : ((S ⧸ K) ⧸ Ideal.ofList rsbar)))) =
        quasiRegularSequenceAssociatedGradedMap (QuotSMulTop r N) rsbar
          (Submodule.Quotient.mk ((Submodule.Quotient.mk x : QuotSMulTop r N)) ⊗ₜ[
              ((S ⧸ K) ⧸ Ideal.ofList rsbar)]
            MvPolynomial.monomial d
              (1 : ((S ⧸ K) ⧸ Ideal.ofList rsbar))) := by
            -- First transport the principal quotient to `QuotSMulTop`, then use naturality of
            -- the associated-graded comparison map for ambient linear equivalences.
            simpa [eTgt, f, ePrincipal] using
              (quasiRegularSequenceAssociatedGradedMapLinearNaturality_tmul
                (R := S ⧸ K)
                (P := N ⧸ (K • (⊤ : Submodule S N)))
                (Q := QuotSMulTop r N)
                ePrincipal rsbar (Submodule.Quotient.mk x) d)
      _ =
        DirectSum.lof (((S ⧸ K) ⧸ Ideal.ofList rsbar)) ℕ
          (idealAssociatedGradedPiece (Ideal.ofList rsbar) (QuotSMulTop r N))
          d.degree
          (Submodule.Quotient.mk
            (⟨(∏ i : Fin rs.length, rsbar.get i ^ d i) • (Submodule.Quotient.mk x : QuotSMulTop r N),
              ofList_monomial_weight_smul_mem_of_degree rsbar d.degree
                (Submodule.Quotient.mk x : QuotSMulTop r N) d rfl⟩ :
              idealAssociatedGradedStage (Ideal.ofList rsbar) (QuotSMulTop r N) d.degree)) := by
            rw [quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_lof]
      _ =
        g
          (eSrc
            (Submodule.Quotient.mk (Submodule.Quotient.mk x) ⊗ₜ[
                ((S ⧸ K) ⧸ Ideal.ofList rsbar)]
              MvPolynomial.monomial d
                (1 : ((S ⧸ K) ⧸ Ideal.ofList rsbar)))) := by
            -- The right-hand side follows the fixed source bridge, the quotient by the `X 0`
            -- action, and the zero/succ target normal forms.
            dsimp [g, eSrc, eMidSrc, eMidTgt, eDown]
            rw [headSingletonTailSourceEquivSpanSingleton_tmul_monomial,
              headVariableSourceEvalQuotientEquiv_symm_tmul,
              headVariableLinearEquivQuotientEquiv_apply_mk,
              headVariableLinearEquiv_liftedTailMonomial]
            obtain hdeg0 | hdegpos := Nat.eq_zero_or_pos d.degree
            · rw [hdeg0, headVariableTargetDownstairsEquiv_apply_lof_zero,
                headVariableTargetZeroPieceEquiv_apply_stageZeroClass]
              simp [K, rsbar, idealAssociatedGradedStage, Module.Quotient.mk_smul_mk]
            · obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hdegpos)
              cases hn
              rw [headVariableTargetDownstairsEquiv_apply_lof_succ,
                headVariableTargetPositivePieceQuotientEquiv_apply_mk,
                headFullPieceToQuotientPiece_apply_mk,
                headFullStageToQuotientPiece_of_tailMonomial]
              simp [K, rsbar, headTailStageToQuotientPiece, idealAssociatedGradedStage,
                Module.Quotient.mk_smul_mk]
  -- Rewrite quasi-regularity as injectivity and transfer injectivity across the established
  -- conjugation square.
  have hiff :
      Function.Injective f ↔ Function.Injective g :=
    injectiveIffOfEquivConjugate eSrc.toEquiv eTgt.toEquiv f g hconj
  have hg : Function.Injective g :=
    eDown.injective.comp (eMidTgt.injective.comp eMidSrc.injective)
  have hspan : IsQuasiRegular (N ⧸ (K • (⊤ : Submodule S N))) rsbar := by
    rw [isQuasiRegular_iff_injective]
    exact hiff.mpr hg
  simpa [K, rsbar, Ideal.ofList_singleton] using hspan

/-- Helper for Chap10 Lemma 10 69 5: if `ys ++ zs` is quasi-regular, then after quotienting by the
prefix ideal `Ideal.ofList ys`, the mapped tail `zs` is still quasi-regular. The induction is
organized by `ys.length` so the ambient quotient ring is only a parameter of the recursive call. -/
private theorem tailQuotient_append_length
    (n : ℕ) :
    ∀ {S : Type u} [CommRing S]
      {N : Type v} [AddCommGroup N] [Module S N]
      {ys zs : List S},
      ys.length = n →
      IsQuasiRegular N (ys ++ zs) →
      IsQuasiRegular
        (N ⧸ (Ideal.ofList ys • (⊤ : Submodule S N)))
        (zs.map (Ideal.Quotient.mk (Ideal.ofList ys))) := by
  induction n with
  | zero =>
      intro S _ N _ _ ys zs hlen hfull
      cases ys with
      | nil =>
          -- With no prefix, this is exactly the quotient-by-zero transport isolated above.
          simpa using tailQuotient_nil (S := S) (N := N) (zs := zs) hfull
      | cons y ys =>
          cases hlen
  | succ n ih =>
      intro S _ N _ _ ys zs hlen hfull
      cases ys with
      | nil =>
          cases hlen
      | cons y ys =>
          have hlen_tail : ys.length = n := by
            simpa using Nat.succ.inj hlen
          have hhead :
              IsQuasiRegular
                (N ⧸ (Ideal.ofList [y] • (⊤ : Submodule S N)))
                (ys.map (Ideal.Quotient.mk (Ideal.ofList [y])) ++
                  zs.map (Ideal.Quotient.mk (Ideal.ofList [y]))) := by
            -- First remove the head term; the remaining concatenated tail still has the same shape.
            simpa [List.map_append] using
              headSingletonTail_isQuasiRegular (S := S) (N := N) (r := y) (rs := ys ++ zs) hfull
          have htail_on_iterated :
              IsQuasiRegular
                (((N ⧸ (Ideal.ofList [y] • (⊤ : Submodule S N))) ⧸
                    (Ideal.ofList (ys.map (Ideal.Quotient.mk (Ideal.ofList [y]))) •
                      (⊤ : Submodule (S ⧸ Ideal.ofList [y])
                        (N ⧸ (Ideal.ofList [y] • (⊤ : Submodule S N)))))))
                ((zs.map (Ideal.Quotient.mk (Ideal.ofList [y]))).map
                  (Ideal.Quotient.mk
                    (Ideal.ofList (ys.map (Ideal.Quotient.mk (Ideal.ofList [y])))))) := by
            -- Recurse on the shorter mapped prefix inside the first quotient ring.
            exact
              ih
                (S := S ⧸ Ideal.ofList [y])
                (N := N ⧸ (Ideal.ofList [y] • (⊤ : Submodule S N)))
                (ys := ys.map (Ideal.Quotient.mk (Ideal.ofList [y])))
                (zs := zs.map (Ideal.Quotient.mk (Ideal.ofList [y])))
                (by simpa using hlen_tail)
                hhead
          have htransport :
              IsQuasiRegular
                (((N ⧸ (Ideal.ofList [y] • (⊤ : Submodule S N))) ⧸
                    (Ideal.ofList (ys.map (Ideal.Quotient.mk (Ideal.ofList [y]))) •
                      (⊤ : Submodule (S ⧸ Ideal.ofList [y])
                        (N ⧸ (Ideal.ofList [y] • (⊤ : Submodule S N)))))))
                ((zs.map (Ideal.Quotient.mk (Ideal.ofList [y]))).map
                  (Ideal.Quotient.mk
                    (Ideal.ofList (ys.map (Ideal.Quotient.mk (Ideal.ofList [y])))))) ↔
              IsQuasiRegular
                (N ⧸ (Ideal.ofList ([y] ++ ys) • (⊤ : Submodule S N)))
                (zs.map (Ideal.Quotient.mk (Ideal.ofList ([y] ++ ys)))) := by
            -- Flatten the iterated quotient back to the single quotient by the full prefix.
            simpa [List.map_map, Function.comp_def] using
              (congrSemilinearEquiv
                (A := (S ⧸ Ideal.ofList [y]) ⧸
                  Ideal.ofList (ys.map (Ideal.Quotient.mk (Ideal.ofList [y]))))
                (B := S ⧸ Ideal.ofList ([y] ++ ys))
                (prefixTailQuotientRingEquiv (A := S) (ys := [y]) (zs := ys))
                (prefixTailCoefficientQuotientSemilinearEquiv
                  (R := S) (M := N) (ys := [y]) (zs := ys))
                (rs := (zs.map (Ideal.Quotient.mk (Ideal.ofList [y]))).map
                  (Ideal.Quotient.mk
                    (Ideal.ofList (ys.map (Ideal.Quotient.mk (Ideal.ofList [y])))))))
          -- The recursive tail statement now transports directly to the single quotient by the
          -- full prefix.
          simpa using htransport.mp htail_on_iterated

/-- Chap10 Lemma 10 69 5: if `f₁, \ldots, f_c ∈ R` is an `M`-quasi-regular sequence, then for
any `i` the sequence `f̄_{i + 1}, \ldots, f̄_c` in `R / (f₁, \ldots, f_i)` is
`M / (f₁, \ldots, f_i) M`-quasi-regular. -/
@[stacks 061R]
theorem tail_quotient {rs : List R} (hqr : IsQuasiRegular M rs) (i : ℕ) :
    IsQuasiRegular
      (M ⧸ (Ideal.ofList (rs.take i) • (⊤ : Submodule R M)))
      ((rs.drop i).map (Ideal.Quotient.mk (Ideal.ofList (rs.take i)))) := by
  -- Route correction: reduce the theorem to the one-step head quotient statement, then recurse on
  -- the prefix length and flatten iterated quotients with the append-form semilinear equivalence.
  have hsplit : IsQuasiRegular M (rs.take i ++ rs.drop i) := by
    simpa [List.take_append_drop] using hqr
  -- Apply the generic prefix-length induction to the chosen prefix `rs.take i`.
  exact
    tailQuotient_append_length
      (S := R)
      (N := M)
      (ys := rs.take i)
      (zs := rs.drop i)
      (rs.take i).length
      rfl
      hsplit

end IsQuasiRegular

end RingTheory.Sequence
