import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open CategoryTheory
open CategoryTheory.ShortComplex.ShortExact

universe u₁ u₂

section GrothendieckGroups

variable (R : Type u₁) [Ring R]

/-- The subgroup generated by short-exact-sequence relations for modules satisfying `P`. -/
def modulePropertyK0Relations (P : ObjectProperty (ModuleCat R)) :
    AddSubgroup (FreeAbelianGroup P.FullSubcategory) :=
  AddSubgroup.closure <| Set.range fun S :
      { S : ShortComplex P.FullSubcategory // (S.map P.ι).ShortExact } ↦
    FreeAbelianGroup.of S.1.X₂ - FreeAbelianGroup.of S.1.X₁ - FreeAbelianGroup.of S.1.X₃

/-- The Grothendieck group attached to an object property in `ModuleCat R`. -/
abbrev ModulePropertyK0 (P : ObjectProperty (ModuleCat R)) :=
  FreeAbelianGroup P.FullSubcategory ⧸ modulePropertyK0Relations R P

namespace ModulePropertyK0

/-- The class of a module satisfying `P` in its Grothendieck group. -/
abbrev of (P : ObjectProperty (ModuleCat R)) (M : P.FullSubcategory) :
    ModulePropertyK0 R P :=
  QuotientAddGroup.mk' (modulePropertyK0Relations R P) (FreeAbelianGroup.of M)

/-- An additive invariant on modules satisfying `P` descends to the Grothendieck group as soon as
it vanishes on the defining short-exact-sequence relations. -/
def lift {P : ObjectProperty (ModuleCat R)} {A : Type u₂} [AddCommGroup A]
    (f : P.FullSubcategory → A)
    (hf : modulePropertyK0Relations R P ≤ (FreeAbelianGroup.lift f).ker) :
    ModulePropertyK0 R P →+ A :=
  QuotientAddGroup.lift (modulePropertyK0Relations R P) (FreeAbelianGroup.lift f) hf

/-- The descended additive invariant evaluates on a generator class by the original function. -/
@[simp] theorem lift_of {P : ObjectProperty (ModuleCat R)} {A : Type u₂} [AddCommGroup A]
    (f : P.FullSubcategory → A)
    (hf : modulePropertyK0Relations R P ≤ (FreeAbelianGroup.lift f).ker)
    (M : P.FullSubcategory) :
    ModulePropertyK0.lift R f hf (ModulePropertyK0.of R P M) = f M := by
  simp [ModulePropertyK0.lift, ModulePropertyK0.of]

private theorem relations_le_ker_map {P Q : ObjectProperty (ModuleCat R)} (hPQ : P ≤ Q) :
    modulePropertyK0Relations R P ≤
      (FreeAbelianGroup.lift fun M : P.FullSubcategory ↦
        ModulePropertyK0.of R Q ((ObjectProperty.ιOfLE hPQ).obj M)).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  change
    FreeAbelianGroup.lift
        (fun M : P.FullSubcategory ↦ ModulePropertyK0.of R Q ((ObjectProperty.ιOfLE hPQ).obj M))
        (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  change
    QuotientAddGroup.mk' (modulePropertyK0Relations R Q)
      (FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₂) -
        FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₁) -
        FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₃)) =
      QuotientAddGroup.mk' (modulePropertyK0Relations R Q) 0
  rw [QuotientAddGroup.mk'_eq_mk']
  refine ⟨-(
      FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₂) -
        FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₁) -
        FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₃)), ?_, by simp⟩
  exact AddSubgroup.neg_mem _ <|
    AddSubgroup.subset_closure <| Set.mem_range.2 ⟨⟨S.map (ObjectProperty.ιOfLE hPQ), by
      simpa using hS⟩, rfl⟩

/-- An inclusion `P ≤ Q` of object properties induces the canonical map `K₀(P) → K₀(Q)`. -/
def map {P Q : ObjectProperty (ModuleCat R)} (hPQ : P ≤ Q) :
    ModulePropertyK0 R P →+ ModulePropertyK0 R Q :=
  ModulePropertyK0.lift R
    (fun M : P.FullSubcategory ↦ ModulePropertyK0.of R Q ((ObjectProperty.ιOfLE hPQ).obj M))
    (relations_le_ker_map R hPQ)

/-- The canonical map induced by `P ≤ Q` sends the class of an object of `P` to its class in `Q`.
-/
@[simp] theorem map_of {P Q : ObjectProperty (ModuleCat R)} (hPQ : P ≤ Q)
    (M : P.FullSubcategory) :
    ModulePropertyK0.map R hPQ (ModulePropertyK0.of R P M) =
      ModulePropertyK0.of R Q ((ObjectProperty.ιOfLE hPQ).obj M) := by
  rfl

end ModulePropertyK0

namespace ModulePropertyK0

/-- Helper for Lemma 10.55.6: a short exact sequence gives the defining Grothendieck-group
relation. -/
theorem of_shortExact {P : ObjectProperty (ModuleCat R)}
    (S : ShortComplex P.FullSubcategory) (hS : (S.map P.ι).ShortExact) :
    ModulePropertyK0.of R P S.X₂ =
      ModulePropertyK0.of R P S.X₁ + ModulePropertyK0.of R P S.X₃ := by
  change
    QuotientAddGroup.mk' (modulePropertyK0Relations R P) (FreeAbelianGroup.of S.X₂) =
      QuotientAddGroup.mk' (modulePropertyK0Relations R P)
        (FreeAbelianGroup.of S.X₁ + FreeAbelianGroup.of S.X₃)
  rw [QuotientAddGroup.mk'_eq_mk']
  refine ⟨-(FreeAbelianGroup.of S.X₂ - (FreeAbelianGroup.of S.X₁ + FreeAbelianGroup.of S.X₃)),
    ?_, by abel_nf⟩
  refine AddSubgroup.neg_mem _ ?_
  simpa [modulePropertyK0Relations, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
    (AddSubgroup.subset_closure <|
      Set.mem_range.2 ⟨⟨S, hS⟩, rfl⟩ :
        FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃ ∈
          modulePropertyK0Relations R P)

/-- Helper for Lemma 10.55.6: the zero object has trivial Grothendieck class. -/
theorem of_zero {P : ObjectProperty (ModuleCat R)}
    (h0 : P (ModuleCat.of R PUnit)) :
    ModulePropertyK0.of R P ⟨ModuleCat.of R PUnit, h0⟩ = 0 := by
  let Z : P.FullSubcategory := ⟨ModuleCat.of R PUnit, h0⟩
  let S : ShortComplex P.FullSubcategory :=
    { X₁ := Z
      X₂ := Z
      X₃ := Z
      f := 0
      g := 0
      zero := by
        apply ObjectProperty.hom_ext
        simp }
  have hS : (S.map P.ι).ShortExact := by
    -- The split exact sequence `0 → 0 → 0 → 0` yields `[0] = [0] + [0]`.
    refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
    · intro z
      constructor
      · intro hz
        refine ⟨0, ?_⟩
        cases z
        rfl
      · rintro ⟨z, hz⟩
        cases z
        rfl
    · intro z₁ z₂ hz
      cases z₁
      cases z₂
      rfl
    · intro z
      refine ⟨0, ?_⟩
      cases z
      rfl
  have hzero :
      ModulePropertyK0.of R P Z =
        ModulePropertyK0.of R P Z + ModulePropertyK0.of R P Z := by
    simpa [S, Z] using ModulePropertyK0.of_shortExact (R := R) (P := P) S hS
  have hcancel' :
      -ModulePropertyK0.of R P Z + ModulePropertyK0.of R P Z =
        -ModulePropertyK0.of R P Z +
          (ModulePropertyK0.of R P Z + ModulePropertyK0.of R P Z) := by
    exact congrArg (fun t : ModulePropertyK0 R P => -ModulePropertyK0.of R P Z + t) hzero
  have hcancel : (0 : ModulePropertyK0 R P) = ModulePropertyK0.of R P Z := by
    simpa [add_assoc] using hcancel'
  simpa [Z] using hcancel.symm

/-- Helper for Lemma 10.55.6: isomorphic objects have the same Grothendieck class. -/
theorem of_iso {P : ObjectProperty (ModuleCat R)}
    (h0 : P (ModuleCat.of R PUnit)) {M N : P.FullSubcategory} (e : M ≅ N) :
    ModulePropertyK0.of R P M = ModulePropertyK0.of R P N := by
  let Z : P.FullSubcategory := ⟨ModuleCat.of R PUnit, h0⟩
  let S : ShortComplex P.FullSubcategory :=
    { X₁ := M
      X₂ := N
      X₃ := Z
      f := e.hom
      g := 0
      zero := by
        apply ObjectProperty.hom_ext
        simp }
  have hS : (S.map P.ι).ShortExact := by
    -- Package the exact sequence `0 → M --e--> N → 0`.
    refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
    · intro n
      constructor
      · intro _
        refine ⟨e.inv.hom n, ?_⟩
        change (e.inv.hom ≫ e.hom.hom) n = n
        rw [ObjectProperty.isoInv_hom_id_hom (P := P) e]
        rfl
      · rintro ⟨m, hm⟩
        rfl
    · intro m₁ m₂ hm
      have hm' : e.inv.hom (e.hom.hom m₁) = e.inv.hom (e.hom.hom m₂) := by
        simpa using congrArg e.inv.hom hm
      change (e.hom.hom ≫ e.inv.hom) m₁ = (e.hom.hom ≫ e.inv.hom) m₂ at hm'
      rw [ObjectProperty.isoHom_inv_id_hom (P := P) e] at hm'
      simpa using hm'
    · intro z
      refine ⟨0, ?_⟩
      cases z
      rfl
  simpa [S, Z, ModulePropertyK0.of_zero (R := R) (P := P) h0] using
    (ModulePropertyK0.of_shortExact (R := R) (P := P) S hS).symm

/-- Helper for Lemma 10.55.6: any subsingleton object has trivial Grothendieck class. -/
theorem of_subsingleton {P : ObjectProperty (ModuleCat R)}
    (_h0 : P (ModuleCat.of R PUnit)) (M : P.FullSubcategory) [Subsingleton M.obj] :
    ModulePropertyK0.of R P M = 0 := by
  let S : ShortComplex P.FullSubcategory :=
    { X₁ := M
      X₂ := M
      X₃ := M
      f := 0
      g := 0
      zero := by
        apply ObjectProperty.hom_ext
        simp }
  have hS : (S.map P.ι).ShortExact := by
    letI : Subsingleton ↑((S.map P.ι).X₁) := by
      simpa [S] using (inferInstance : Subsingleton M.obj)
    letI : Subsingleton ↑((S.map P.ι).X₂) := by
      simpa [S] using (inferInstance : Subsingleton M.obj)
    letI : Subsingleton ↑((S.map P.ι).X₃) := by
      simpa [S] using (inferInstance : Subsingleton M.obj)
    refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
    · intro x
      constructor
      · intro hx
        refine ⟨0, ?_⟩
        simpa using (Subsingleton.elim (0 : M.obj) x)
      · rintro ⟨_, _⟩
        -- The cokernel map is zero, so the exactness side condition is immediate.
        rfl
    · intro x y hxy
      simpa using (Subsingleton.elim x y)
    · intro x
      refine ⟨0, ?_⟩
      simpa using (Subsingleton.elim (0 : M.obj) x)
  have hM :
      ModulePropertyK0.of R P M =
        ModulePropertyK0.of R P M + ModulePropertyK0.of R P M := by
    simpa [S] using ModulePropertyK0.of_shortExact (R := R) (P := P) S hS
  have hcancel :
      (0 : ModulePropertyK0 R P) = ModulePropertyK0.of R P M := by
    simpa [add_assoc] using
      congrArg (fun t : ModulePropertyK0 R P => -ModulePropertyK0.of R P M + t) hM
  simpa using hcancel.symm

end ModulePropertyK0

/-- The object property of finitely generated projective `R`-modules in `ModuleCat R`. -/
abbrev finiteProjectiveModuleProperty : ObjectProperty (ModuleCat R) :=
  fun M ↦ Module.Finite R M ∧ Module.Projective R M

/-- A finitely generated projective module is, in particular, finitely generated. -/
theorem finiteProjectiveModuleProperty_le_isFG :
    finiteProjectiveModuleProperty R ≤ ModuleCat.isFG R := fun _ hM ↦ hM.1

/-- The full subcategory of finitely generated projective `R`-modules. -/
abbrev FiniteProjectiveModuleCat :=
  (finiteProjectiveModuleProperty R).FullSubcategory

instance (M : FiniteProjectiveModuleCat R) : Module.Finite R M.obj :=
  M.2.1

instance (M : FiniteProjectiveModuleCat R) : Module.Projective R M.obj :=
  M.2.2

/-- The Grothendieck group `K₀(R)` of finitely generated projective `R`-modules. -/
abbrev projectiveGrothendieckGroup :=
  ModulePropertyK0 R (finiteProjectiveModuleProperty R)

/-- The class of a finitely generated projective `R`-module in `K₀(R)`. -/
abbrev projectiveGrothendieckGroupOf (M : FiniteProjectiveModuleCat R) :
    projectiveGrothendieckGroup R :=
  ModulePropertyK0.of R (finiteProjectiveModuleProperty R) M

/-- The Grothendieck group `K'_0(R)` of finitely generated `R`-modules. -/
abbrev finiteGrothendieckGroup :=
  ModulePropertyK0 R (ModuleCat.isFG R)

/-- The class of a finitely generated `R`-module in `K'_0(R)`. -/
abbrev finiteGrothendieckGroupOf (M : FGModuleCat R) :
    finiteGrothendieckGroup R :=
  ModulePropertyK0.of R (ModuleCat.isFG R) M

end GrothendieckGroups

section ProductFactors

variable (R₁ : Type u₁) (R₂ : Type u₂) [CommRing R₁] [CommRing R₂]

/-- The left idempotent of the product ring `R₁ × R₂`. -/
private abbrev leftIdempotent : R₁ × R₂ := (1, 0)

/-- The right idempotent of the product ring `R₁ × R₂`. -/
private abbrev rightIdempotent : R₁ × R₂ := (0, 1)

/-- The `R₁`-factor of an `(R₁ × R₂)`-module, encoded as the submodule killed by `(0, 1)`. -/
private def leftFactorSubmodule (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    Submodule (R₁ × R₂) M where
  carrier := { m | (rightIdempotent R₁ R₂) • m = 0 }
  zero_mem' := by
    simp [rightIdempotent]
  add_mem' := by
    intro m n hm hn
    change (rightIdempotent R₁ R₂) • (m + n) = 0
    rw [smul_add, hm, hn]
    simp
  smul_mem' := by
    intro a m hm
    change (rightIdempotent R₁ R₂) • (a • m) = 0
    rw [smul_smul, mul_comm, ← smul_smul, hm, smul_zero]

/-- The `R₂`-factor of an `(R₁ × R₂)`-module, encoded as the submodule killed by `(1, 0)`. -/
private def rightFactorSubmodule (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    Submodule (R₁ × R₂) M where
  carrier := { m | (leftIdempotent R₁ R₂) • m = 0 }
  zero_mem' := by
    simp [leftIdempotent]
  add_mem' := by
    intro m n hm hn
    change (leftIdempotent R₁ R₂) • (m + n) = 0
    rw [smul_add, hm, hn]
    simp
  smul_mem' := by
    intro a m hm
    change (leftIdempotent R₁ R₂) • (a • m) = 0
    rw [smul_smul, mul_comm, ← smul_smul, hm, smul_zero]

private instance leftFactorSubmodule_module
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    Module R₁ (leftFactorSubmodule R₁ R₂ M) where
  smul r m := ⟨((r, (0 : R₂)) : R₁ × R₂) • m.1, by
    change (rightIdempotent R₁ R₂) • (((r, (0 : R₂)) : R₁ × R₂) • m.1) = 0
    rw [smul_smul]
    have hmul :
        (rightIdempotent R₁ R₂) * (((r, (0 : R₂)) : R₁ × R₂)) = 0 := by
      ext <;> simp [rightIdempotent]
    rw [hmul, zero_smul]
  ⟩
  one_smul m := by
    apply Subtype.ext
    calc
      (((1 : R₁), (0 : R₂)) : R₁ × R₂) • m.1
          = ((((1 : R₁), (0 : R₂)) : R₁ × R₂) + rightIdempotent R₁ R₂) • m.1 := by
              rw [add_smul, Subtype.mem m, add_zero]
      _ = m.1 := by
        have hsum :
            ((((1 : R₁), (0 : R₂)) : R₁ × R₂) + rightIdempotent R₁ R₂) = 1 := by
          ext <;> simp [rightIdempotent]
        rw [hsum]
        exact one_smul (R₁ × R₂) (m.1 : M)
  mul_smul a b m := by
    apply Subtype.ext
    change (((a * b : R₁), (0 : R₂)) : R₁ × R₂) • m.1 =
        (((a : R₁), (0 : R₂)) : R₁ × R₂) •
          ((((b : R₁), (0 : R₂)) : R₁ × R₂) • m.1)
    simp [smul_smul]
  smul_zero a := by
    apply Subtype.ext
    change (((a : R₁), (0 : R₂)) : R₁ × R₂) • (0 : M) = 0
    simp
  smul_add a m n := by
    apply Subtype.ext
    change (((a : R₁), (0 : R₂)) : R₁ × R₂) • (m.1 + n.1) =
      (((a : R₁), (0 : R₂)) : R₁ × R₂) • m.1 +
        (((a : R₁), (0 : R₂)) : R₁ × R₂) • n.1
    rw [smul_add]
  zero_smul m := by
    apply Subtype.ext
    change (((0 : R₁), (0 : R₂)) : R₁ × R₂) • m.1 = 0
    exact (show (0 : R₁ × R₂) • (m.1 : M) = 0 from zero_smul (R₁ × R₂) (m.1 : M))
  add_smul a b m := by
    apply Subtype.ext
    change (((a + b : R₁), (0 : R₂)) : R₁ × R₂) • m.1 =
        ((((a : R₁), (0 : R₂)) : R₁ × R₂) • m.1) +
          ((((b : R₁), (0 : R₂)) : R₁ × R₂) • m.1)
    have hadd :
        (((a + b : R₁), (0 : R₂)) : R₁ × R₂) =
          (((a : R₁), (0 : R₂)) : R₁ × R₂) + (((b : R₁), (0 : R₂)) : R₁ × R₂) := by
      ext <;> simp
    rw [hadd, add_smul]

private instance rightFactorSubmodule_module
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    Module R₂ (rightFactorSubmodule R₁ R₂ M) where
  smul r m := ⟨(((0 : R₁), r) : R₁ × R₂) • m.1, by
    change (leftIdempotent R₁ R₂) • ((((0 : R₁), r) : R₁ × R₂) • m.1) = 0
    rw [smul_smul]
    have hmul :
        (leftIdempotent R₁ R₂) * ((((0 : R₁), r) : R₁ × R₂)) = 0 := by
      ext <;> simp [leftIdempotent]
    rw [hmul, zero_smul]
  ⟩
  one_smul m := by
    apply Subtype.ext
    calc
      (((0 : R₁), (1 : R₂)) : R₁ × R₂) • m.1
          = ((((0 : R₁), (1 : R₂)) : R₁ × R₂) + leftIdempotent R₁ R₂) • m.1 := by
              rw [add_smul, Subtype.mem m, add_zero]
      _ = m.1 := by
        have hsum :
            ((((0 : R₁), (1 : R₂)) : R₁ × R₂) + leftIdempotent R₁ R₂) = 1 := by
          ext <;> simp [leftIdempotent]
        rw [hsum]
        exact one_smul (R₁ × R₂) (m.1 : M)
  mul_smul a b m := by
    apply Subtype.ext
    change (((0 : R₁), (a * b : R₂)) : R₁ × R₂) • m.1 =
        (((0 : R₁), (a : R₂)) : R₁ × R₂) •
          ((((0 : R₁), (b : R₂)) : R₁ × R₂) • m.1)
    simp [smul_smul]
  smul_zero a := by
    apply Subtype.ext
    change (((0 : R₁), (a : R₂)) : R₁ × R₂) • (0 : M) = 0
    simp
  smul_add a m n := by
    apply Subtype.ext
    change (((0 : R₁), (a : R₂)) : R₁ × R₂) • (m.1 + n.1) =
      (((0 : R₁), (a : R₂)) : R₁ × R₂) • m.1 +
        (((0 : R₁), (a : R₂)) : R₁ × R₂) • n.1
    rw [smul_add]
  zero_smul m := by
    apply Subtype.ext
    change (((0 : R₁), (0 : R₂)) : R₁ × R₂) • m.1 = 0
    exact (show (0 : R₁ × R₂) • (m.1 : M) = 0 from zero_smul (R₁ × R₂) (m.1 : M))
  add_smul a b m := by
    apply Subtype.ext
    change (((0 : R₁), (a + b : R₂)) : R₁ × R₂) • m.1 =
        ((((0 : R₁), (a : R₂)) : R₁ × R₂) • m.1) +
          ((((0 : R₁), (b : R₂)) : R₁ × R₂) • m.1)
    have hadd :
        (((0 : R₁), (a + b : R₂)) : R₁ × R₂) =
          (((0 : R₁), (a : R₂)) : R₁ × R₂) + (((0 : R₁), (b : R₂)) : R₁ × R₂) := by
      ext <;> simp
    rw [hadd, add_smul]

private abbrev leftFactorModuleCat (M : ModuleCat (R₁ × R₂)) : ModuleCat R₁ :=
  ModuleCat.of R₁ (leftFactorSubmodule R₁ R₂ M)

private abbrev rightFactorModuleCat (M : ModuleCat (R₁ × R₂)) : ModuleCat R₂ :=
  ModuleCat.of R₂ (rightFactorSubmodule R₁ R₂ M)

private def leftFactorElement (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] (m : M) :
    leftFactorSubmodule R₁ R₂ M :=
  ⟨(leftIdempotent R₁ R₂) • m, by
    change (rightIdempotent R₁ R₂) • ((leftIdempotent R₁ R₂) • m) = 0
    rw [smul_smul]
    have hmul : (rightIdempotent R₁ R₂) * leftIdempotent R₁ R₂ = 0 := by
      ext <;> simp [leftIdempotent, rightIdempotent]
    rw [hmul, zero_smul]⟩

private def rightFactorElement (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] (m : M) :
    rightFactorSubmodule R₁ R₂ M :=
  ⟨(rightIdempotent R₁ R₂) • m, by
    change (leftIdempotent R₁ R₂) • ((rightIdempotent R₁ R₂) • m) = 0
    rw [smul_smul]
    have hmul : (leftIdempotent R₁ R₂) * rightIdempotent R₁ R₂ = 0 := by
      ext <;> simp [leftIdempotent, rightIdempotent]
    rw [hmul, zero_smul]⟩

private def leftFactorFiniteMap
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] {n : ℕ}
    (f : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M) :
    (Fin n → R₁) →ₗ[R₁] leftFactorSubmodule R₁ R₂ M where
  toFun x := ⟨f fun i ↦ (x i, 0), by
    change (rightIdempotent R₁ R₂) • f (fun i ↦ (x i, 0)) = 0
    rw [← f.map_smul]
    have hzero : (rightIdempotent R₁ R₂) • (fun i ↦ (x i, (0 : R₂))) = 0 := by
      ext i <;> simp [rightIdempotent]
    rw [hzero, map_zero]⟩
  map_add' x y := by
    apply Subtype.ext
    change f (fun i ↦ ((x + y) i, (0 : R₂))) =
      f (fun i ↦ (x i, (0 : R₂))) + f (fun i ↦ (y i, (0 : R₂)))
    rw [show (fun i ↦ ((x + y) i, (0 : R₂))) =
        (fun i ↦ (x i, (0 : R₂))) + fun i ↦ (y i, (0 : R₂)) by
          ext i <;> simp]
    exact map_add f _ _
  map_smul' a x := by
    apply Subtype.ext
    change f (fun i ↦ ((a • x) i, (0 : R₂))) =
      (((a : R₁), (0 : R₂)) : R₁ × R₂) • f (fun i ↦ (x i, (0 : R₂)))
    rw [show (fun i ↦ ((a • x) i, (0 : R₂))) =
        (((a : R₁), (0 : R₂)) : R₁ × R₂) • fun i ↦ (x i, (0 : R₂)) by
          ext i <;> simp]
    exact map_smul f _ _

private def rightFactorFiniteMap
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] {n : ℕ}
    (f : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M) :
    (Fin n → R₂) →ₗ[R₂] rightFactorSubmodule R₁ R₂ M where
  toFun x := ⟨f fun i ↦ (0, x i), by
    change (leftIdempotent R₁ R₂) • f (fun i ↦ ((0 : R₁), x i)) = 0
    rw [← f.map_smul]
    have hzero : (leftIdempotent R₁ R₂) • (fun i ↦ ((0 : R₁), x i)) = 0 := by
      ext i <;> simp [leftIdempotent]
    rw [hzero, map_zero]⟩
  map_add' x y := by
    apply Subtype.ext
    change f (fun i ↦ ((0 : R₁), (x + y) i)) =
      f (fun i ↦ ((0 : R₁), x i)) + f (fun i ↦ ((0 : R₁), y i))
    rw [show (fun i ↦ ((0 : R₁), (x + y) i)) =
        (fun i ↦ ((0 : R₁), x i)) + fun i ↦ ((0 : R₁), y i) by
          ext i <;> simp]
    exact map_add f _ _
  map_smul' a x := by
    apply Subtype.ext
    change f (fun i ↦ ((0 : R₁), (a • x) i)) =
      (((0 : R₁), (a : R₂)) : R₁ × R₂) • f (fun i ↦ ((0 : R₁), x i))
    rw [show (fun i ↦ ((0 : R₁), (a • x) i)) =
        (((0 : R₁), (a : R₂)) : R₁ × R₂) • fun i ↦ ((0 : R₁), x i) by
          ext i <;> simp]
    exact map_smul f _ _

private theorem leftFactorFiniteMap_surjective
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] {n : ℕ}
    (f : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M) (hf : Function.Surjective f) :
    Function.Surjective (leftFactorFiniteMap R₁ R₂ f) := by
  intro m
  obtain ⟨x, hx⟩ := hf m.1
  refine ⟨fun i ↦ (x i).1, ?_⟩
  apply Subtype.ext
  change f (fun i ↦ ((x i).1, (0 : R₂))) = m.1
  rw [show (fun i ↦ ((x i).1, (0 : R₂))) = (leftIdempotent R₁ R₂) • x by
    ext i <;> simp [leftIdempotent]]
  rw [map_smul, hx]
  calc
    (leftIdempotent R₁ R₂) • m.1
        = (leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂) • m.1 := by
            rw [add_smul, Subtype.mem m, add_zero]
    _ = m.1 := by
      have hsum : leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂ = 1 := by
        ext <;> simp [leftIdempotent, rightIdempotent]
      rw [hsum, one_smul]

private theorem rightFactorFiniteMap_surjective
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] {n : ℕ}
    (f : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M) (hf : Function.Surjective f) :
    Function.Surjective (rightFactorFiniteMap R₁ R₂ f) := by
  intro m
  obtain ⟨x, hx⟩ := hf m.1
  refine ⟨fun i ↦ (x i).2, ?_⟩
  apply Subtype.ext
  change f (fun i ↦ ((0 : R₁), (x i).2)) = m.1
  rw [show (fun i ↦ ((0 : R₁), (x i).2)) = (rightIdempotent R₁ R₂) • x by
    ext i <;> simp [rightIdempotent]]
  rw [map_smul, hx]
  calc
    (rightIdempotent R₁ R₂) • m.1
        = (leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂) • m.1 := by
            rw [add_smul, Subtype.mem m, zero_add]
    _ = m.1 := by
      have hsum : leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂ = 1 := by
        ext <;> simp [leftIdempotent, rightIdempotent]
      rw [hsum, one_smul]

private def leftFactorLinearCombination
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    (M →₀ R₁) →ₗ[R₁] leftFactorSubmodule R₁ R₂ M :=
  Finsupp.linearCombination R₁ (leftFactorElement R₁ R₂ M)

private def rightFactorLinearCombination
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    (M →₀ R₂) →ₗ[R₂] rightFactorSubmodule R₁ R₂ M :=
  Finsupp.linearCombination R₂ (rightFactorElement R₁ R₂ M)

private def leftFactorProjectiveSection
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (s : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂)) :
    leftFactorSubmodule R₁ R₂ M →ₗ[R₁] M →₀ R₁ where
  toFun m := (s m.1).mapRange Prod.fst (by simp)
  map_add' m n := by
    ext x
    simp
  map_smul' a m := by
    ext x
    change Prod.fst (s ((((a : R₁), (0 : R₂)) : R₁ × R₂) • m.1) x) =
      a * Prod.fst (s m.1 x)
    rw [s.map_smul]
    simp

private def rightFactorProjectiveSection
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (s : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂)) :
    rightFactorSubmodule R₁ R₂ M →ₗ[R₂] M →₀ R₂ where
  toFun m := (s m.1).mapRange Prod.snd (by simp)
  map_add' m n := by
    ext x
    simp
  map_smul' a m := by
    ext x
    change Prod.snd (s ((((0 : R₁), (a : R₂)) : R₁ × R₂) • m.1) x) =
      a * Prod.snd (s m.1 x)
    rw [s.map_smul]
    simp

private theorem leftIdempotent_smul_leftFactor
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (m : leftFactorSubmodule R₁ R₂ M) :
    (leftIdempotent R₁ R₂) • m.1 = m.1 := by
  calc
    (leftIdempotent R₁ R₂) • m.1
        = (leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂) • m.1 := by
            rw [add_smul, Subtype.mem m, add_zero]
    _ = m.1 := by
      have hsum : leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂ = 1 := by
        ext <;> simp [leftIdempotent, rightIdempotent]
      rw [hsum, one_smul]

private theorem rightIdempotent_smul_rightFactor
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (m : rightFactorSubmodule R₁ R₂ M) :
    (rightIdempotent R₁ R₂) • m.1 = m.1 := by
  calc
    (rightIdempotent R₁ R₂) • m.1
        = (leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂) • m.1 := by
            rw [add_smul, Subtype.mem m, zero_add]
    _ = m.1 := by
      have hsum : leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂ = 1 := by
        ext <;> simp [leftIdempotent, rightIdempotent]
      rw [hsum, one_smul]

private theorem leftFactor_sum
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] (x : M →₀ (R₁ × R₂)) :
    (((x.sum fun a b ↦ b.1 • leftFactorElement R₁ R₂ M a) : leftFactorSubmodule R₁ R₂ M) : M) =
      (leftIdempotent R₁ R₂) • x.sum fun i a ↦ a • i := by
  classical
  induction x using Finsupp.induction_linear with
  | zero =>
      simp [leftIdempotent]
  | add x y hx hy =>
      simp [Finsupp.sum_add_index, hx, hy, add_smul]
  | single a b =>
      suffices
          (((((b.1 : R₁), (0 : R₂)) : R₁ × R₂) • ((leftIdempotent R₁ R₂) • a) : M)) =
            (leftIdempotent R₁ R₂) • (b • a) by
        simpa only [Prod.fst_zero, zero_smul, Finsupp.sum_single_index] using this
      rw [smul_smul, smul_smul]
      congr 1
      ext <;> simp [leftIdempotent]

private theorem rightFactor_sum
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] (x : M →₀ (R₁ × R₂)) :
    (((x.sum fun a b ↦ b.2 • rightFactorElement R₁ R₂ M a) : rightFactorSubmodule R₁ R₂ M) : M) =
      (rightIdempotent R₁ R₂) • x.sum fun i a ↦ a • i := by
  classical
  induction x using Finsupp.induction_linear with
  | zero =>
      simp [rightIdempotent]
  | add x y hx hy =>
      simp [Finsupp.sum_add_index, hx, hy, add_smul]
  | single a b =>
      suffices
          (((((0 : R₁), (b.2 : R₂)) : R₁ × R₂) • ((rightIdempotent R₁ R₂) • a) : M)) =
            (rightIdempotent R₁ R₂) • (b • a) by
        simpa only [Prod.snd_zero, zero_smul, Finsupp.sum_single_index] using this
      rw [smul_smul, smul_smul]
      congr 1
      ext <;> simp [rightIdempotent]

private theorem leftFactorLinearCombination_section
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (s : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂))
    (hs : Function.LeftInverse (Finsupp.linearCombination (R₁ × R₂) id) s) :
    (leftFactorLinearCombination R₁ R₂ M).comp (leftFactorProjectiveSection R₁ R₂ s) =
      LinearMap.id := by
  ext m
  have hm : (leftIdempotent R₁ R₂) • Finsupp.linearCombination (R₁ × R₂) id (s m.1) = m.1 := by
    simpa [leftIdempotent_smul_leftFactor R₁ R₂ m] using
      congrArg (fun z : M ↦ (leftIdempotent R₁ R₂) • z) (hs m.1)
  calc
    (((leftFactorLinearCombination R₁ R₂ M) ((leftFactorProjectiveSection R₁ R₂ s) m)) : M)
        = (leftIdempotent R₁ R₂) • Finsupp.linearCombination (R₁ × R₂) id (s m.1) := by
            simpa [leftFactorLinearCombination, leftFactorProjectiveSection,
              Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index] using
              leftFactor_sum R₁ R₂ (s m.1)
    _ = m.1 := hm

private theorem rightFactorLinearCombination_section
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (s : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂))
    (hs : Function.LeftInverse (Finsupp.linearCombination (R₁ × R₂) id) s) :
    (rightFactorLinearCombination R₁ R₂ M).comp (rightFactorProjectiveSection R₁ R₂ s) =
      LinearMap.id := by
  ext m
  have hm : (rightIdempotent R₁ R₂) • Finsupp.linearCombination (R₁ × R₂) id (s m.1) = m.1 := by
    simpa [rightIdempotent_smul_rightFactor R₁ R₂ m] using
      congrArg (fun z : M ↦ (rightIdempotent R₁ R₂) • z) (hs m.1)
  calc
    (((rightFactorLinearCombination R₁ R₂ M) ((rightFactorProjectiveSection R₁ R₂ s) m)) : M)
        = (rightIdempotent R₁ R₂) • Finsupp.linearCombination (R₁ × R₂) id (s m.1) := by
            simpa [rightFactorLinearCombination, rightFactorProjectiveSection,
              Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index] using
              rightFactor_sum R₁ R₂ (s m.1)
    _ = m.1 := hm

private instance leftFactorModule_finite
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] [Module.Finite (R₁ × R₂) M] :
    Module.Finite R₁ (leftFactorSubmodule R₁ R₂ M) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' (R₁ × R₂) M
  exact Module.Finite.of_surjective (leftFactorFiniteMap R₁ R₂ f)
    (leftFactorFiniteMap_surjective R₁ R₂ f hf)

private instance rightFactorModule_finite
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] [Module.Finite (R₁ × R₂) M] :
    Module.Finite R₂ (rightFactorSubmodule R₁ R₂ M) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' (R₁ × R₂) M
  exact Module.Finite.of_surjective (rightFactorFiniteMap R₁ R₂ f)
    (rightFactorFiniteMap_surjective R₁ R₂ f hf)

private instance leftFactorModule_projective
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] [Module.Projective (R₁ × R₂) M] :
    Module.Projective R₁ (leftFactorSubmodule R₁ R₂ M) := by
  obtain ⟨s, hs⟩ := ‹Module.Projective (R₁ × R₂) M›
  exact Module.Projective.of_split
    (leftFactorProjectiveSection R₁ R₂ s)
    (leftFactorLinearCombination R₁ R₂ M)
    (leftFactorLinearCombination_section R₁ R₂ s hs)

private instance rightFactorModule_projective
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] [Module.Projective (R₁ × R₂) M] :
    Module.Projective R₂ (rightFactorSubmodule R₁ R₂ M) := by
  obtain ⟨s, hs⟩ := ‹Module.Projective (R₁ × R₂) M›
  exact Module.Projective.of_split
    (rightFactorProjectiveSection R₁ R₂ s)
    (rightFactorLinearCombination R₁ R₂ M)
    (rightFactorLinearCombination_section R₁ R₂ s hs)

/-- A finite projective `(R₁ × R₂)`-module determines a finite projective `R₁`-module by taking
the factor cut out by the idempotent `(1, 0)`. -/
abbrev leftFactorFiniteProjective
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) : FiniteProjectiveModuleCat R₁ :=
  letI : Module.Finite (R₁ × R₂) M.obj := M.property.1
  letI : Module.Projective (R₁ × R₂) M.obj := M.property.2
  ⟨leftFactorModuleCat R₁ R₂ M.obj, ⟨inferInstance, inferInstance⟩⟩

/-- A finite projective `(R₁ × R₂)`-module determines a finite projective `R₂`-module by taking
the factor cut out by the idempotent `(0, 1)`. -/
abbrev rightFactorFiniteProjective
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) : FiniteProjectiveModuleCat R₂ :=
  letI : Module.Finite (R₁ × R₂) M.obj := M.property.1
  letI : Module.Projective (R₁ × R₂) M.obj := M.property.2
  ⟨rightFactorModuleCat R₁ R₂ M.obj, ⟨inferInstance, inferInstance⟩⟩

/-- A finite `(R₁ × R₂)`-module determines a finite `R₁`-module by taking the factor cut out by
the idempotent `(1, 0)`. -/
abbrev leftFactorFinite
    (M : FGModuleCat (R₁ × R₂)) : FGModuleCat R₁ :=
  letI : Module.Finite (R₁ × R₂) M.obj := M.property
  ⟨leftFactorModuleCat R₁ R₂ M.obj, by
    rw [ModuleCat.isFG_iff]
    infer_instance⟩

/-- A finite `(R₁ × R₂)`-module determines a finite `R₂`-module by taking the factor cut out by
the idempotent `(0, 1)`. -/
abbrev rightFactorFinite
    (M : FGModuleCat (R₁ × R₂)) : FGModuleCat R₂ :=
  letI : Module.Finite (R₁ × R₂) M.obj := M.property
  ⟨rightFactorModuleCat R₁ R₂ M.obj, by
    rw [ModuleCat.isFG_iff]
    infer_instance⟩

/-- Helper for Lemma 10.55.6: the zero module is finitely generated and projective. -/
private theorem finiteProjectiveModuleProperty_zero (R : Type _) [CommRing R] :
    finiteProjectiveModuleProperty R (ModuleCat.of R PUnit) := by
  exact ⟨inferInstance, inferInstance⟩

/-- Helper for Lemma 10.55.6: the zero module is finitely generated. -/
private theorem isFG_zero (R : Type _) [CommRing R] :
    ModuleCat.isFG R (ModuleCat.of R PUnit) := by
  rw [ModuleCat.isFG_iff]
  infer_instance

/-- Helper for Lemma 10.55.6: an `R₁`-linear map is `(R₁ × R₂)`-linear after restricting scalars
along the first projection. -/
private def leftCompHomLinearMap
    {M N : Type _} [AddCommGroup M] [AddCommGroup N] [Module R₁ M] [Module R₁ N]
    (f : M →ₗ[R₁] N) :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
    letI : Module (R₁ × R₂) N := Module.compHom N (RingHom.fst R₁ R₂)
    M →ₗ[R₁ × R₂] N := by
  letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
  letI : Module (R₁ × R₂) N := Module.compHom N (RingHom.fst R₁ R₂)
  exact
    { toFun := f
      map_add' := f.map_add
      map_smul' := by
        intro a m
        change f ((RingHom.fst R₁ R₂) a • m) = (RingHom.fst R₁ R₂) a • f m
        rw [f.map_smul] }

/-- Helper for Lemma 10.55.6: an `R₂`-linear map is `(R₁ × R₂)`-linear after restricting scalars
along the second projection. -/
private def rightCompHomLinearMap
    {M N : Type _} [AddCommGroup M] [AddCommGroup N] [Module R₂ M] [Module R₂ N]
    (f : M →ₗ[R₂] N) :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
    letI : Module (R₁ × R₂) N := Module.compHom N (RingHom.snd R₁ R₂)
    M →ₗ[R₁ × R₂] N := by
  letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
  letI : Module (R₁ × R₂) N := Module.compHom N (RingHom.snd R₁ R₂)
  exact
    { toFun := f
      map_add' := f.map_add
      map_smul' := by
        intro a m
        change f ((RingHom.snd R₁ R₂) a • m) = (RingHom.snd R₁ R₂) a • f m
        rw [f.map_smul] }

/-- Helper for Lemma 10.55.6: a finite `R₁`-module is finite after restricting scalars along the
first projection `R₁ × R₂ → R₁`. -/
private theorem leftEmbeddedModule_finite
    {M : Type _} [AddCommGroup M] [Module R₁ M] [Module.Finite R₁ M] :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
    Module.Finite (R₁ × R₂) M := by
  letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R₁ M
  let f' : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M :=
    { toFun := fun x ↦ f fun i ↦ (x i).1
      map_add' := by
        intro x y
        change f ((fun i ↦ (x i).1) + fun i ↦ (y i).1) =
          f (fun i ↦ (x i).1) + f (fun i ↦ (y i).1)
        rw [map_add]
      map_smul' := by
        intro a x
        change f ((RingHom.fst R₁ R₂ a) • fun i ↦ (x i).1) =
          (RingHom.fst R₁ R₂ a) • f (fun i ↦ (x i).1)
        rw [map_smul] }
  exact Module.Finite.of_surjective f' <| by
    intro m
    obtain ⟨x, rfl⟩ := hf m
    refine ⟨fun i ↦ (x i, 0), ?_⟩
    simp [f']

/-- Helper for Lemma 10.55.6: a finite `R₂`-module is finite after restricting scalars along the
second projection `R₁ × R₂ → R₂`. -/
private theorem rightEmbeddedModule_finite
    {M : Type _} [AddCommGroup M] [Module R₂ M] [Module.Finite R₂ M] :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
    Module.Finite (R₁ × R₂) M := by
  letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R₂ M
  let f' : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M :=
    { toFun := fun x ↦ f fun i ↦ (x i).2
      map_add' := by
        intro x y
        change f ((fun i ↦ (x i).2) + fun i ↦ (y i).2) =
          f (fun i ↦ (x i).2) + f (fun i ↦ (y i).2)
        rw [map_add]
      map_smul' := by
        intro a x
        change f ((RingHom.snd R₁ R₂ a) • fun i ↦ (x i).2) =
          (RingHom.snd R₁ R₂ a) • f (fun i ↦ (x i).2)
        rw [map_smul] }
  exact Module.Finite.of_surjective f' <| by
    intro m
    obtain ⟨x, rfl⟩ := hf m
    refine ⟨fun i ↦ (0, x i), ?_⟩
    simp [f']

/-- Helper for Lemma 10.55.6: an `R₁`-projective module stays projective after restricting
scalars along the first projection. -/
private theorem leftEmbeddedModule_projective
    {M : Type _} [AddCommGroup M] [Module R₁ M] [Module.Projective R₁ M] :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
    Module.Projective (R₁ × R₂) M := by
  letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
  obtain ⟨s, hs⟩ := ‹Module.Projective R₁ M›
  let s' : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂) :=
    { toFun := fun m ↦ (s m).mapRange (fun r ↦ (r, 0)) (by simp)
      map_add' := by
        intro m n
        ext x <;> simp [s.map_add]
      map_smul' := by
        intro a m
        rcases a with ⟨a1, a2⟩
        ext x
        · change (s (a1 • m)) x = a1 * (s m) x
          rw [s.map_smul]
          rfl
        · simp }
  rw [Module.projective_def]
  refine ⟨s', ?_⟩
  intro m
  calc
    Finsupp.linearCombination (R₁ × R₂) id (s' m) =
        (s m).sum fun i a ↦ (((a : R₁), (0 : R₂)) : R₁ × R₂) • i := by
          simp [s', Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index]
    _ = (s m).sum fun i a ↦ a • i := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          rfl
    _ = m := hs m

/-- Helper for Lemma 10.55.6: an `R₂`-projective module stays projective after restricting
scalars along the second projection. -/
private theorem rightEmbeddedModule_projective
    {M : Type _} [AddCommGroup M] [Module R₂ M] [Module.Projective R₂ M] :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
    Module.Projective (R₁ × R₂) M := by
  letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
  obtain ⟨s, hs⟩ := ‹Module.Projective R₂ M›
  let s' : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂) :=
    { toFun := fun m ↦ (s m).mapRange (fun r ↦ (0, r)) (by simp)
      map_add' := by
        intro m n
        ext x <;> simp [s.map_add]
      map_smul' := by
        intro a m
        rcases a with ⟨a1, a2⟩
        ext x
        · simp
        · change (s (a2 • m)) x = a2 * (s m) x
          rw [s.map_smul]
          rfl }
  rw [Module.projective_def]
  refine ⟨s', ?_⟩
  intro m
  calc
    Finsupp.linearCombination (R₁ × R₂) id (s' m) =
        (s m).sum fun i a ↦ (((0 : R₁), (a : R₂)) : R₁ × R₂) • i := by
          simp [s', Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index]
    _ = (s m).sum fun i a ↦ a • i := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          rfl
    _ = m := hs m

/-- Helper for Lemma 10.55.6: view a finite projective `R₁`-module as an `(R₁ × R₂)`-module via
the first projection. -/
private abbrev leftEmbeddedFiniteProjective
    (M : FiniteProjectiveModuleCat R₁) : FiniteProjectiveModuleCat (R₁ × R₂) :=
  letI : Module (R₁ × R₂) M.obj := Module.compHom M.obj (RingHom.fst R₁ R₂)
  letI : Module.Finite (R₁ × R₂) M.obj := leftEmbeddedModule_finite (R₁ := R₁) (R₂ := R₂)
  letI : Module.Projective (R₁ × R₂) M.obj := leftEmbeddedModule_projective (R₁ := R₁) (R₂ := R₂)
  ⟨ModuleCat.of (R₁ × R₂) M.obj, ⟨inferInstance, inferInstance⟩⟩

/-- Helper for Lemma 10.55.6: view a finite projective `R₂`-module as an `(R₁ × R₂)`-module via
the second projection. -/
private abbrev rightEmbeddedFiniteProjective
    (M : FiniteProjectiveModuleCat R₂) : FiniteProjectiveModuleCat (R₁ × R₂) :=
  letI : Module (R₁ × R₂) M.obj := Module.compHom M.obj (RingHom.snd R₁ R₂)
  letI : Module.Finite (R₁ × R₂) M.obj := rightEmbeddedModule_finite (R₁ := R₁) (R₂ := R₂)
  letI : Module.Projective (R₁ × R₂) M.obj := rightEmbeddedModule_projective (R₁ := R₁) (R₂ := R₂)
  ⟨ModuleCat.of (R₁ × R₂) M.obj, ⟨inferInstance, inferInstance⟩⟩

/-- Helper for Lemma 10.55.6: view a finite `R₁`-module as an `(R₁ × R₂)`-module via the first
projection. -/
private abbrev leftEmbeddedFinite
    (M : FGModuleCat R₁) : FGModuleCat (R₁ × R₂) :=
  letI : Module (R₁ × R₂) M.obj := Module.compHom M.obj (RingHom.fst R₁ R₂)
  letI : Module.Finite (R₁ × R₂) M.obj := leftEmbeddedModule_finite (R₁ := R₁) (R₂ := R₂)
  ⟨ModuleCat.of (R₁ × R₂) M.obj, by
    rw [ModuleCat.isFG_iff]
    infer_instance⟩

/-- Helper for Lemma 10.55.6: view a finite `R₂`-module as an `(R₁ × R₂)`-module via the second
projection. -/
private abbrev rightEmbeddedFinite
    (M : FGModuleCat R₂) : FGModuleCat (R₁ × R₂) :=
  letI : Module (R₁ × R₂) M.obj := Module.compHom M.obj (RingHom.snd R₁ R₂)
  letI : Module.Finite (R₁ × R₂) M.obj := rightEmbeddedModule_finite (R₁ := R₁) (R₂ := R₂)
  ⟨ModuleCat.of (R₁ × R₂) M.obj, by
    rw [ModuleCat.isFG_iff]
    infer_instance⟩

/-- Helper for Lemma 10.55.6: restrict a morphism of `(R₁ × R₂)`-modules to the left idempotent
factor. -/
private def leftFactorMap
    {M N : Type _} [AddCommGroup M] [AddCommGroup N]
    [Module (R₁ × R₂) M] [Module (R₁ × R₂) N]
    (f : M →ₗ[R₁ × R₂] N) :
    leftFactorSubmodule R₁ R₂ M →ₗ[R₁] leftFactorSubmodule R₁ R₂ N where
  toFun m := ⟨f m.1, by
    change (rightIdempotent R₁ R₂) • f m.1 = 0
    rw [← f.map_smul, Subtype.mem m, map_zero]⟩
  map_add' m n := by
    apply Subtype.ext
    simp
  map_smul' a m := by
    apply Subtype.ext
    change f ((((a : R₁), (0 : R₂)) : R₁ × R₂) • m.1) =
      (((a : R₁), (0 : R₂)) : R₁ × R₂) • f m.1
    rw [f.map_smul]

/-- Helper for Lemma 10.55.6: restrict a morphism of `(R₁ × R₂)`-modules to the right idempotent
factor. -/
private def rightFactorMap
    {M N : Type _} [AddCommGroup M] [AddCommGroup N]
    [Module (R₁ × R₂) M] [Module (R₁ × R₂) N]
    (f : M →ₗ[R₁ × R₂] N) :
    rightFactorSubmodule R₁ R₂ M →ₗ[R₂] rightFactorSubmodule R₁ R₂ N where
  toFun m := ⟨f m.1, by
    change (leftIdempotent R₁ R₂) • f m.1 = 0
    rw [← f.map_smul, Subtype.mem m, map_zero]⟩
  map_add' m n := by
    apply Subtype.ext
    simp
  map_smul' a m := by
    apply Subtype.ext
    change f ((((0 : R₁), (a : R₂)) : R₁ × R₂) • m.1) =
      (((0 : R₁), (a : R₂)) : R₁ × R₂) • f m.1
    rw [f.map_smul]

/-- Helper for Lemma 10.55.6: the left factor inherits its ambient `(R₁ × R₂)`-module structure
through the first projection. -/
private instance leftFactorSubmodule_productModule
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] :
    Module (R₁ × R₂) (leftFactorSubmodule R₁ R₂ M) :=
  Module.compHom (leftFactorSubmodule R₁ R₂ M) (RingHom.fst R₁ R₂)

/-- Helper for Lemma 10.55.6: the right factor inherits its ambient `(R₁ × R₂)`-module structure
through the second projection. -/
private instance rightFactorSubmodule_productModule
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] :
    Module (R₁ × R₂) (rightFactorSubmodule R₁ R₂ M) :=
  Module.compHom (rightFactorSubmodule R₁ R₂ M) (RingHom.snd R₁ R₂)

/-- Helper for Lemma 10.55.6: the left idempotent factor preserves short exact sequences of
`(R₁ × R₂)`-modules. -/
private theorem leftFactor_shortExact
    (S : ShortComplex (ModuleCat (R₁ × R₂))) (hS : S.ShortExact) :
    let T : ShortComplex (ModuleCat R₁) :=
      { X₁ := leftFactorModuleCat R₁ R₂ S.X₁
        X₂ := leftFactorModuleCat R₁ R₂ S.X₂
        X₃ := leftFactorModuleCat R₁ R₂ S.X₃
        f := ModuleCat.ofHom (leftFactorMap R₁ R₂ S.f.hom)
        g := ModuleCat.ofHom (leftFactorMap R₁ R₂ S.g.hom)
        zero := by
          ext x
          simp [leftFactorMap] }
    T.ShortExact := by
  let T : ShortComplex (ModuleCat R₁) :=
    { X₁ := leftFactorModuleCat R₁ R₂ S.X₁
      X₂ := leftFactorModuleCat R₁ R₂ S.X₂
      X₃ := leftFactorModuleCat R₁ R₂ S.X₃
      f := ModuleCat.ofHom (leftFactorMap R₁ R₂ S.f.hom)
      g := ModuleCat.ofHom (leftFactorMap R₁ R₂ S.g.hom)
      zero := by
        ext x
        simp [leftFactorMap] }
  refine ModuleCat.shortComplex_shortExact T ?_ ?_ ?_
  · intro x
    constructor
    · intro hx
      have hExact :=
        (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mp hS.exact
      have hx' : S.g x.1 = 0 := by
        simpa [T, leftFactorMap] using congrArg Subtype.val hx
      obtain ⟨y, hy⟩ := (hExact x.1).1 hx'
      have hy_left : (rightIdempotent R₁ R₂) • y = 0 := by
        apply hS.moduleCat_injective_f
        calc
          S.f (((rightIdempotent R₁ R₂) • y))
              = (rightIdempotent R₁ R₂) • S.f y := by rw [S.f.hom.map_smul]
          _ = (rightIdempotent R₁ R₂) • x.1 := by rw [hy]
          _ = 0 := x.2
          _ = S.f 0 := by simp
      refine ⟨⟨y, hy_left⟩, ?_⟩
      apply Subtype.ext
      exact hy
    · rintro ⟨y, rfl⟩
      apply Subtype.ext
      change S.g (S.f y.1) = 0
      simpa using S.zero_apply y.1
  · intro x y hxy
    exact Subtype.ext <| hS.moduleCat_injective_f <| Subtype.ext_iff.mp hxy
  · intro x
    obtain ⟨y, hy⟩ := hS.moduleCat_surjective_g x.1
    refine ⟨leftFactorElement (R₁ := R₁) (R₂ := R₂) (M := S.X₂) y, ?_⟩
    apply Subtype.ext
    calc
      S.g ((leftIdempotent R₁ R₂) • y)
          = (leftIdempotent R₁ R₂) • S.g y := by rw [S.g.hom.map_smul]
      _ = (leftIdempotent R₁ R₂) • x.1 := by rw [hy]
      _ = x.1 := leftIdempotent_smul_leftFactor R₁ R₂ x

/-- Helper for Lemma 10.55.6: the right idempotent factor preserves short exact sequences of
`(R₁ × R₂)`-modules. -/
private theorem rightFactor_shortExact
    (S : ShortComplex (ModuleCat (R₁ × R₂))) (hS : S.ShortExact) :
    let T : ShortComplex (ModuleCat R₂) :=
      { X₁ := rightFactorModuleCat R₁ R₂ S.X₁
        X₂ := rightFactorModuleCat R₁ R₂ S.X₂
        X₃ := rightFactorModuleCat R₁ R₂ S.X₃
        f := ModuleCat.ofHom (rightFactorMap R₁ R₂ S.f.hom)
        g := ModuleCat.ofHom (rightFactorMap R₁ R₂ S.g.hom)
        zero := by
          ext x
          simp [rightFactorMap] }
    T.ShortExact := by
  let T : ShortComplex (ModuleCat R₂) :=
    { X₁ := rightFactorModuleCat R₁ R₂ S.X₁
      X₂ := rightFactorModuleCat R₁ R₂ S.X₂
      X₃ := rightFactorModuleCat R₁ R₂ S.X₃
      f := ModuleCat.ofHom (rightFactorMap R₁ R₂ S.f.hom)
      g := ModuleCat.ofHom (rightFactorMap R₁ R₂ S.g.hom)
      zero := by
        ext x
        simp [rightFactorMap] }
  refine ModuleCat.shortComplex_shortExact T ?_ ?_ ?_
  · intro x
    constructor
    · intro hx
      have hExact :=
        (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mp hS.exact
      have hx' : S.g x.1 = 0 := by
        simpa [T, rightFactorMap] using congrArg Subtype.val hx
      obtain ⟨y, hy⟩ := (hExact x.1).1 hx'
      have hy_right : (leftIdempotent R₁ R₂) • y = 0 := by
        apply hS.moduleCat_injective_f
        calc
          S.f (((leftIdempotent R₁ R₂) • y))
              = (leftIdempotent R₁ R₂) • S.f y := by rw [S.f.hom.map_smul]
          _ = (leftIdempotent R₁ R₂) • x.1 := by rw [hy]
          _ = 0 := x.2
          _ = S.f 0 := by simp
      refine ⟨⟨y, hy_right⟩, ?_⟩
      apply Subtype.ext
      exact hy
    · rintro ⟨y, rfl⟩
      apply Subtype.ext
      change S.g (S.f y.1) = 0
      simpa using S.zero_apply y.1
  · intro x y hxy
    exact Subtype.ext <| hS.moduleCat_injective_f <| Subtype.ext_iff.mp hxy
  · intro x
    obtain ⟨y, hy⟩ := hS.moduleCat_surjective_g x.1
    refine ⟨rightFactorElement (R₁ := R₁) (R₂ := R₂) (M := S.X₂) y, ?_⟩
    apply Subtype.ext
    calc
      S.g ((rightIdempotent R₁ R₂) • y)
          = (rightIdempotent R₁ R₂) • S.g y := by rw [S.g.hom.map_smul]
      _ = (rightIdempotent R₁ R₂) • x.1 := by rw [hy]
      _ = x.1 := rightIdempotent_smul_rightFactor R₁ R₂ x

/-- Helper for Lemma 10.55.6: the inclusion of the left idempotent factor into the ambient module
is `(R₁ × R₂)`-linear after restricting scalars along the first projection. -/
private def leftFactorInclusion
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] :
    leftFactorSubmodule R₁ R₂ M →ₗ[R₁ × R₂] M where
  toFun := fun m ↦ m.1
  map_add' := by intro m n; rfl
  map_smul' a m := by
    change (((RingHom.fst R₁ R₂) a : R₁), (0 : R₂)) • m.1 = a • m.1
    have hz : (((0 : R₁), (RingHom.snd R₁ R₂ a : R₂)) : R₁ × R₂) • m.1 = 0 := by
      calc
        (((0 : R₁), (RingHom.snd R₁ R₂ a : R₂)) : R₁ × R₂) • m.1
            = (rightIdempotent R₁ R₂ * a) • m.1 := by
                congr 1
                ext <;> simp [rightIdempotent]
        _ = (a * rightIdempotent R₁ R₂) • m.1 := by
              simpa using
                congrArg (fun r : R₁ × R₂ ↦ r • m.1) (mul_comm (rightIdempotent R₁ R₂) a)
        _ = a • ((rightIdempotent R₁ R₂) • m.1) := by rw [smul_smul]
        _ = 0 := by rw [Subtype.mem m, smul_zero]
    have hsplit :
        (((RingHom.fst R₁ R₂) a : R₁), (0 : R₂)) +
          (((0 : R₁), (RingHom.snd R₁ R₂ a : R₂)) : R₁ × R₂) = a := by
      ext <;> simp
    calc
      ((((RingHom.fst R₁ R₂) a : R₁), (0 : R₂)) : R₁ × R₂) • m.1
          = ((((RingHom.fst R₁ R₂) a : R₁), (0 : R₂)) : R₁ × R₂) • m.1 +
              ((((0 : R₁), (RingHom.snd R₁ R₂ a : R₂)) : R₁ × R₂) • m.1) := by
                rw [hz, add_zero]
      _ = a • m.1 := by rw [← add_smul, hsplit]

/-- Helper for Lemma 10.55.6: the projection onto the right idempotent factor is `(R₁ × R₂)`-linear
after restricting scalars along the second projection. -/
private def rightFactorProjection
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] :
    M →ₗ[R₁ × R₂] rightFactorSubmodule R₁ R₂ M where
  toFun := rightFactorElement R₁ R₂ M
  map_add' := by
    intro m n
    apply Subtype.ext
    simp [rightFactorElement, smul_add]
  map_smul' a m := by
    apply Subtype.ext
    change (rightIdempotent R₁ R₂) • (a • m) =
      (((0 : R₁), (RingHom.snd R₁ R₂ a : R₂)) : R₁ × R₂) •
        ((rightIdempotent R₁ R₂) • m)
    rw [smul_smul, smul_smul]
    congr 1
    ext <;> simp [rightIdempotent]

/-- Helper for Lemma 10.55.6: every `(R₁ × R₂)`-module splits into its two idempotent factors. -/
private theorem factor_split_shortExact
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] :
    let S : ShortComplex (ModuleCat (R₁ × R₂)) :=
      { X₁ := ModuleCat.of (R₁ × R₂) (leftFactorSubmodule R₁ R₂ M)
        X₂ := ModuleCat.of (R₁ × R₂) M
        X₃ := ModuleCat.of (R₁ × R₂) (rightFactorSubmodule R₁ R₂ M)
        f := ModuleCat.ofHom (leftFactorInclusion R₁ R₂)
        g := ModuleCat.ofHom (rightFactorProjection R₁ R₂)
        zero := by
          ext x
          exact x.property }
    S.ShortExact := by
  let S : ShortComplex (ModuleCat (R₁ × R₂)) :=
    { X₁ := ModuleCat.of (R₁ × R₂) (leftFactorSubmodule R₁ R₂ M)
      X₂ := ModuleCat.of (R₁ × R₂) M
      X₃ := ModuleCat.of (R₁ × R₂) (rightFactorSubmodule R₁ R₂ M)
      f := ModuleCat.ofHom (leftFactorInclusion R₁ R₂)
      g := ModuleCat.ofHom (rightFactorProjection R₁ R₂)
      zero := by
        ext x
        exact x.property }
  refine ModuleCat.shortComplex_shortExact S ?_ ?_ ?_
  · intro m
    constructor
    · intro hm
      have hm' : (rightIdempotent R₁ R₂) • m = 0 := by
        simpa [S, rightFactorProjection, rightFactorElement] using congrArg Subtype.val hm
      refine ⟨⟨m, hm'⟩, rfl⟩
    · rintro ⟨m, rfl⟩
      apply Subtype.ext
      exact Subtype.mem m
  · intro m n hmn
    exact Subtype.ext hmn
  · intro m
    refine ⟨m, ?_⟩
    apply Subtype.ext
    exact rightIdempotent_smul_rightFactor R₁ R₂ m

/-- Helper for Lemma 10.55.6: for a module restricted along the first projection, the left
idempotent factor recovers the original module. -/
private def leftFactorOfLeftEmbeddedLinearEquiv
    (M : Type _) [AddCommGroup M] [Module R₁ M] :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
    leftFactorSubmodule R₁ R₂ M ≃ₗ[R₁] M :=
  by
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
    exact
      { toFun := fun m ↦ m.1
        invFun := fun m ↦ ⟨m, by
          change ((RingHom.fst R₁ R₂) (rightIdempotent R₁ R₂)) • m = 0
          simp [rightIdempotent]⟩
        left_inv := by intro m; ext; rfl
        right_inv := by intro m; rfl
        map_add' := by intro m n; rfl
        map_smul' := by intro a m; rfl }

/-- Helper for Lemma 10.55.6: for a module restricted along the second projection, the right
idempotent factor recovers the original module. -/
private def rightFactorOfRightEmbeddedLinearEquiv
    (M : Type _) [AddCommGroup M] [Module R₂ M] :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
    rightFactorSubmodule R₁ R₂ M ≃ₗ[R₂] M :=
  by
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
    exact
      { toFun := fun m ↦ m.1
        invFun := fun m ↦ ⟨m, by
          change ((RingHom.snd R₁ R₂) (leftIdempotent R₁ R₂)) • m = 0
          simp [leftIdempotent]⟩
        left_inv := by intro m; ext; rfl
        right_inv := by intro m; rfl
        map_add' := by intro m n; rfl
        map_smul' := by intro a m; rfl }

/-- Helper for Lemma 10.55.6: for a module restricted along the first projection, the right
idempotent factor is trivial. -/
private theorem rightFactorOfLeftEmbedded_subsingleton
    (M : Type _) [AddCommGroup M] [Module R₁ M] :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
    Subsingleton (rightFactorSubmodule R₁ R₂ M) := by
  letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.fst R₁ R₂)
  refine ⟨fun x y ↦ ?_⟩
  apply Subtype.ext
  have hx : x.1 = 0 := by
    have hx' : (leftIdempotent R₁ R₂) • x.1 = 0 := x.property
    have hx'' : (1 : R₁) • x.1 = 0 := by
      simpa [leftIdempotent] using hx'
    simpa only [one_smul] using hx''
  have hy : y.1 = 0 := by
    have hy' : (leftIdempotent R₁ R₂) • y.1 = 0 := y.property
    have hy'' : (1 : R₁) • y.1 = 0 := by
      simpa [leftIdempotent] using hy'
    simpa only [one_smul] using hy''
  simp [hx, hy]

/-- Helper for Lemma 10.55.6: for a module restricted along the second projection, the left
idempotent factor is trivial. -/
private theorem leftFactorOfRightEmbedded_subsingleton
    (M : Type _) [AddCommGroup M] [Module R₂ M] :
    letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
    Subsingleton (leftFactorSubmodule R₁ R₂ M) := by
  letI : Module (R₁ × R₂) M := Module.compHom M (RingHom.snd R₁ R₂)
  refine ⟨fun x y ↦ ?_⟩
  apply Subtype.ext
  have hx : x.1 = 0 := by
    have hx' : (rightIdempotent R₁ R₂) • x.1 = 0 := x.property
    have hx'' : (1 : R₂) • x.1 = 0 := by
      simpa [rightIdempotent] using hx'
    simpa only [one_smul] using hx''
  have hy : y.1 = 0 := by
    have hy' : (rightIdempotent R₁ R₂) • y.1 = 0 := y.property
    have hy'' : (1 : R₂) • y.1 = 0 := by
      simpa [rightIdempotent] using hy'
    simpa only [one_smul] using hy''
  simp [hx, hy]

private abbrev projectiveGrothendieckGroupFactorPair
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) :
    projectiveGrothendieckGroup R₁ × projectiveGrothendieckGroup R₂ :=
  ( projectiveGrothendieckGroupOf R₁ (leftFactorFiniteProjective R₁ R₂ M)
  , projectiveGrothendieckGroupOf R₂ (rightFactorFiniteProjective R₁ R₂ M) )

/-- Helper for Lemma 10.55.6: the left and right factor functors preserve the defining
Grothendieck relations for finite projective modules. -/
private theorem projectiveGrothendieckGroup_relations_le_ker_prodMap :
    modulePropertyK0Relations (R₁ × R₂) (finiteProjectiveModuleProperty (R₁ × R₂)) ≤
      (FreeAbelianGroup.lift (projectiveGrothendieckGroupFactorPair R₁ R₂)).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  change
    FreeAbelianGroup.lift (projectiveGrothendieckGroupFactorPair R₁ R₂)
      (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  have hleft :
      projectiveGrothendieckGroupOf R₁ (leftFactorFiniteProjective R₁ R₂ S.X₂) =
        projectiveGrothendieckGroupOf R₁ (leftFactorFiniteProjective R₁ R₂ S.X₁) +
          projectiveGrothendieckGroupOf R₁ (leftFactorFiniteProjective R₁ R₂ S.X₃) := by
    let T : ShortComplex (finiteProjectiveModuleProperty R₁).FullSubcategory :=
      { X₁ := leftFactorFiniteProjective R₁ R₂ S.X₁
        X₂ := leftFactorFiniteProjective R₁ R₂ S.X₂
        X₃ := leftFactorFiniteProjective R₁ R₂ S.X₃
        f := ObjectProperty.homMk (ModuleCat.ofHom (leftFactorMap R₁ R₂ S.f.hom.hom))
        g := ObjectProperty.homMk (ModuleCat.ofHom (leftFactorMap R₁ R₂ S.g.hom.hom))
        zero := by
          apply ObjectProperty.hom_ext
          ext x
          change S.g.hom.hom (S.f.hom.hom x.1) = 0
          simpa using
            (S.map (finiteProjectiveModuleProperty (R₁ × R₂)).ι).moduleCat_zero_apply x.1 }
    have hT : (T.map (finiteProjectiveModuleProperty R₁).ι).ShortExact := by
      simpa [T] using leftFactor_shortExact R₁ R₂
        ((S.map (finiteProjectiveModuleProperty (R₁ × R₂)).ι)) hS
    simpa [T] using ModulePropertyK0.of_shortExact (R := R₁)
      (P := finiteProjectiveModuleProperty R₁) T hT
  have hright :
      projectiveGrothendieckGroupOf R₂ (rightFactorFiniteProjective R₁ R₂ S.X₂) =
        projectiveGrothendieckGroupOf R₂ (rightFactorFiniteProjective R₁ R₂ S.X₁) +
          projectiveGrothendieckGroupOf R₂ (rightFactorFiniteProjective R₁ R₂ S.X₃) := by
    let T : ShortComplex (finiteProjectiveModuleProperty R₂).FullSubcategory :=
      { X₁ := rightFactorFiniteProjective R₁ R₂ S.X₁
        X₂ := rightFactorFiniteProjective R₁ R₂ S.X₂
        X₃ := rightFactorFiniteProjective R₁ R₂ S.X₃
        f := ObjectProperty.homMk (ModuleCat.ofHom (rightFactorMap R₁ R₂ S.f.hom.hom))
        g := ObjectProperty.homMk (ModuleCat.ofHom (rightFactorMap R₁ R₂ S.g.hom.hom))
        zero := by
          apply ObjectProperty.hom_ext
          ext x
          change S.g.hom.hom (S.f.hom.hom x.1) = 0
          simpa using
            (S.map (finiteProjectiveModuleProperty (R₁ × R₂)).ι).moduleCat_zero_apply x.1 }
    have hT : (T.map (finiteProjectiveModuleProperty R₂).ι).ShortExact := by
      simpa [T] using rightFactor_shortExact R₁ R₂
        ((S.map (finiteProjectiveModuleProperty (R₁ × R₂)).ι)) hS
    simpa [T] using ModulePropertyK0.of_shortExact (R := R₂)
      (P := finiteProjectiveModuleProperty R₂) T hT
  ext
  · have hleft' :
        projectiveGrothendieckGroupOf R₁ (leftFactorFiniteProjective R₁ R₂ S.X₂) -
            projectiveGrothendieckGroupOf R₁ (leftFactorFiniteProjective R₁ R₂ S.X₁) -
              projectiveGrothendieckGroupOf R₁ (leftFactorFiniteProjective R₁ R₂ S.X₃) =
          0 := by
      rw [hleft]
      abel_nf
    simpa [projectiveGrothendieckGroupFactorPair, projectiveGrothendieckGroupOf, ModulePropertyK0.of]
      using hleft'
  · have hright' :
        projectiveGrothendieckGroupOf R₂ (rightFactorFiniteProjective R₁ R₂ S.X₂) -
            projectiveGrothendieckGroupOf R₂ (rightFactorFiniteProjective R₁ R₂ S.X₁) -
              projectiveGrothendieckGroupOf R₂ (rightFactorFiniteProjective R₁ R₂ S.X₃) =
          0 := by
      rw [hright]
      abel_nf
    simpa [projectiveGrothendieckGroupFactorPair, projectiveGrothendieckGroupOf, ModulePropertyK0.of]
      using hright'

/-- Helper for Lemma 10.55.6: the canonical map from `K₀(R₁ × R₂)` to the product of the factor
Grothendieck groups. -/
private def projectiveGrothendieckGroupProdMap :
    projectiveGrothendieckGroup (R₁ × R₂) →+
      (projectiveGrothendieckGroup R₁ × projectiveGrothendieckGroup R₂) :=
  ModulePropertyK0.lift (R₁ × R₂)
    (projectiveGrothendieckGroupFactorPair R₁ R₂)
    (projectiveGrothendieckGroup_relations_le_ker_prodMap R₁ R₂)

/-- Helper for Lemma 10.55.6: the Grothendieck relations for left-embedded finite projective
modules are preserved. -/
private theorem projectiveGrothendieckGroup_relations_le_ker_leftEmbedding :
    modulePropertyK0Relations R₁ (finiteProjectiveModuleProperty R₁) ≤
      (FreeAbelianGroup.lift fun M : FiniteProjectiveModuleCat R₁ ↦
        projectiveGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFiniteProjective R₁ R₂ M)).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  letI : Module (R₁ × R₂) S.X₁.obj := Module.compHom S.X₁.obj (RingHom.fst R₁ R₂)
  letI : Module (R₁ × R₂) S.X₂.obj := Module.compHom S.X₂.obj (RingHom.fst R₁ R₂)
  letI : Module (R₁ × R₂) S.X₃.obj := Module.compHom S.X₃.obj (RingHom.fst R₁ R₂)
  let T : ShortComplex (finiteProjectiveModuleProperty (R₁ × R₂)).FullSubcategory :=
    { X₁ := leftEmbeddedFiniteProjective R₁ R₂ S.X₁
      X₂ := leftEmbeddedFiniteProjective R₁ R₂ S.X₂
      X₃ := leftEmbeddedFiniteProjective R₁ R₂ S.X₃
      f := ObjectProperty.homMk (ModuleCat.ofHom (leftCompHomLinearMap R₁ R₂ S.f.hom.hom))
      g := ObjectProperty.homMk (ModuleCat.ofHom (leftCompHomLinearMap R₁ R₂ S.g.hom.hom))
      zero := by
        apply ObjectProperty.hom_ext
        ext x
        simpa [leftCompHomLinearMap] using
          (S.map (finiteProjectiveModuleProperty R₁).ι).moduleCat_zero_apply x }
  have hT : (T.map (finiteProjectiveModuleProperty (R₁ × R₂)).ι).ShortExact := by
    refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
    · simpa [T, leftCompHomLinearMap] using
        (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact
          (S.map (finiteProjectiveModuleProperty R₁).ι)).mp hS.exact
    · simpa [T, leftCompHomLinearMap] using hS.moduleCat_injective_f
    · simpa [T, leftCompHomLinearMap] using hS.moduleCat_surjective_g
  change
    FreeAbelianGroup.lift
        (fun M : FiniteProjectiveModuleCat R₁ ↦
          projectiveGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFiniteProjective R₁ R₂ M))
      (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  have hTrel :
      projectiveGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFiniteProjective R₁ R₂ S.X₂) =
        projectiveGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFiniteProjective R₁ R₂ S.X₁) +
          projectiveGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFiniteProjective R₁ R₂ S.X₃) := by
    simpa [T] using
      (ModulePropertyK0.of_shortExact (R := (R₁ × R₂))
        (P := finiteProjectiveModuleProperty (R₁ × R₂)) T hT)
  rw [hTrel]
  abel_nf

/-- Helper for Lemma 10.55.6: the Grothendieck relations for right-embedded finite projective
modules are preserved. -/
private theorem projectiveGrothendieckGroup_relations_le_ker_rightEmbedding :
    modulePropertyK0Relations R₂ (finiteProjectiveModuleProperty R₂) ≤
      (FreeAbelianGroup.lift fun M : FiniteProjectiveModuleCat R₂ ↦
        projectiveGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFiniteProjective R₁ R₂ M)).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  letI : Module (R₁ × R₂) S.X₁.obj := Module.compHom S.X₁.obj (RingHom.snd R₁ R₂)
  letI : Module (R₁ × R₂) S.X₂.obj := Module.compHom S.X₂.obj (RingHom.snd R₁ R₂)
  letI : Module (R₁ × R₂) S.X₃.obj := Module.compHom S.X₃.obj (RingHom.snd R₁ R₂)
  let T : ShortComplex (finiteProjectiveModuleProperty (R₁ × R₂)).FullSubcategory :=
    { X₁ := rightEmbeddedFiniteProjective R₁ R₂ S.X₁
      X₂ := rightEmbeddedFiniteProjective R₁ R₂ S.X₂
      X₃ := rightEmbeddedFiniteProjective R₁ R₂ S.X₃
      f := ObjectProperty.homMk (ModuleCat.ofHom (rightCompHomLinearMap R₁ R₂ S.f.hom.hom))
      g := ObjectProperty.homMk (ModuleCat.ofHom (rightCompHomLinearMap R₁ R₂ S.g.hom.hom))
      zero := by
        apply ObjectProperty.hom_ext
        ext x
        simpa [rightCompHomLinearMap] using
          (S.map (finiteProjectiveModuleProperty R₂).ι).moduleCat_zero_apply x }
  have hT : (T.map (finiteProjectiveModuleProperty (R₁ × R₂)).ι).ShortExact := by
    refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
    · simpa [T, rightCompHomLinearMap] using
        (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact
          (S.map (finiteProjectiveModuleProperty R₂).ι)).mp hS.exact
    · simpa [T, rightCompHomLinearMap] using hS.moduleCat_injective_f
    · simpa [T, rightCompHomLinearMap] using hS.moduleCat_surjective_g
  change
    FreeAbelianGroup.lift
        (fun M : FiniteProjectiveModuleCat R₂ ↦
          projectiveGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFiniteProjective R₁ R₂ M))
      (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  have hTrel :
      projectiveGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFiniteProjective R₁ R₂ S.X₂) =
        projectiveGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFiniteProjective R₁ R₂ S.X₁) +
          projectiveGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFiniteProjective R₁ R₂ S.X₃) := by
    simpa [T] using
      (ModulePropertyK0.of_shortExact (R := (R₁ × R₂))
        (P := finiteProjectiveModuleProperty (R₁ × R₂)) T hT)
  rw [hTrel]
  abel_nf

/-- Helper for Lemma 10.55.6: embed `K₀(R₁)` into `K₀(R₁ × R₂)` along the first projection. -/
private def leftProjectiveEmbeddingMap :
    projectiveGrothendieckGroup R₁ →+ projectiveGrothendieckGroup (R₁ × R₂) :=
  ModulePropertyK0.lift R₁
    (fun M : FiniteProjectiveModuleCat R₁ ↦
      projectiveGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFiniteProjective R₁ R₂ M))
    (projectiveGrothendieckGroup_relations_le_ker_leftEmbedding R₁ R₂)

/-- Helper for Lemma 10.55.6: embed `K₀(R₂)` into `K₀(R₁ × R₂)` along the second projection. -/
private def rightProjectiveEmbeddingMap :
    projectiveGrothendieckGroup R₂ →+ projectiveGrothendieckGroup (R₁ × R₂) :=
  ModulePropertyK0.lift R₂
    (fun M : FiniteProjectiveModuleCat R₂ ↦
      projectiveGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFiniteProjective R₁ R₂ M))
    (projectiveGrothendieckGroup_relations_le_ker_rightEmbedding R₁ R₂)

/-- Helper for Lemma 10.55.6: the additive left-coordinate inclusion into a product. -/
private def leftPairHom {A B : Type _} [AddCommGroup A] [AddCommGroup B] : A →+ A × B where
  toFun := fun a ↦ (a, 0)
  map_zero' := by simp
  map_add' := by intro a b; simp

/-- Helper for Lemma 10.55.6: the additive right-coordinate inclusion into a product. -/
private def rightPairHom {A B : Type _} [AddCommGroup A] [AddCommGroup B] : B →+ A × B where
  toFun := fun b ↦ (0, b)
  map_zero' := by simp
  map_add' := by intro a b; simp

/-- Helper for Lemma 10.55.6: summing the two coordinate inclusions reconstructs the original
pair. -/
private theorem leftPairHom_add_rightPairHom {A B : Type _} [AddCommGroup A] [AddCommGroup B]
    (x : A × B) :
    leftPairHom x.1 + rightPairHom x.2 = x := by
  -- The source proof reconstructs a product object from its left and right factors; here the same
  -- decomposition is recorded on the additive target product.
  rcases x with ⟨a, b⟩
  simp [leftPairHom, rightPairHom]

/-- Helper for Lemma 10.55.6: factoring a left-embedded finite projective module recovers the
original `K₀(R₁)` class and kills the `R₂` component. -/
private theorem projectiveGrothendieckGroupProdMap_leftEmbedding_apply_of
    (M : FiniteProjectiveModuleCat R₁) :
    projectiveGrothendieckGroupProdMap R₁ R₂
        (leftProjectiveEmbeddingMap R₁ R₂ (projectiveGrothendieckGroupOf R₁ M)) =
      (projectiveGrothendieckGroupOf R₁ M, 0) := by
  letI : Module (R₁ × R₂) M.obj := Module.compHom M.obj (RingHom.fst R₁ R₂)
  simp only [leftProjectiveEmbeddingMap, projectiveGrothendieckGroupProdMap,
    projectiveGrothendieckGroupOf, ModulePropertyK0.lift_of]
  refine Prod.ext ?_ ?_
  · simpa [projectiveGrothendieckGroupFactorPair] using
      (ModulePropertyK0.of_iso (R := R₁) (P := finiteProjectiveModuleProperty R₁)
        (finiteProjectiveModuleProperty_zero R₁)
        (ObjectProperty.isoMk
          (P := finiteProjectiveModuleProperty R₁)
          (LinearEquiv.toModuleIso (leftFactorOfLeftEmbeddedLinearEquiv R₁ R₂ M.obj))))
  · letI : Subsingleton (rightFactorSubmodule R₁ R₂ M.obj) :=
      rightFactorOfLeftEmbedded_subsingleton R₁ R₂ M.obj
    simpa [projectiveGrothendieckGroupFactorPair] using
      (ModulePropertyK0.of_subsingleton (R := R₂) (P := finiteProjectiveModuleProperty R₂)
        (finiteProjectiveModuleProperty_zero R₂)
        (rightFactorFiniteProjective R₁ R₂ (leftEmbeddedFiniteProjective R₁ R₂ M)))

/-- Helper for Lemma 10.55.6: factoring a right-embedded finite projective module recovers the
original `K₀(R₂)` class and kills the `R₁` component. -/
private theorem projectiveGrothendieckGroupProdMap_rightEmbedding_apply_of
    (M : FiniteProjectiveModuleCat R₂) :
    projectiveGrothendieckGroupProdMap R₁ R₂
        (rightProjectiveEmbeddingMap R₁ R₂ (projectiveGrothendieckGroupOf R₂ M)) =
      (0, projectiveGrothendieckGroupOf R₂ M) := by
  letI : Module (R₁ × R₂) M.obj := Module.compHom M.obj (RingHom.snd R₁ R₂)
  simp only [rightProjectiveEmbeddingMap, projectiveGrothendieckGroupProdMap,
    projectiveGrothendieckGroupOf, ModulePropertyK0.lift_of]
  refine Prod.ext ?_ ?_
  · letI : Subsingleton (leftFactorSubmodule R₁ R₂ M.obj) :=
      leftFactorOfRightEmbedded_subsingleton R₁ R₂ M.obj
    simpa [projectiveGrothendieckGroupFactorPair] using
      (ModulePropertyK0.of_subsingleton (R := R₁) (P := finiteProjectiveModuleProperty R₁)
        (finiteProjectiveModuleProperty_zero R₁)
        (leftFactorFiniteProjective R₁ R₂ (rightEmbeddedFiniteProjective R₁ R₂ M)))
  · simpa [projectiveGrothendieckGroupFactorPair] using
      (ModulePropertyK0.of_iso (R := R₂) (P := finiteProjectiveModuleProperty R₂)
        (finiteProjectiveModuleProperty_zero R₂)
        (ObjectProperty.isoMk
          (P := finiteProjectiveModuleProperty R₂)
          (LinearEquiv.toModuleIso (rightFactorOfRightEmbeddedLinearEquiv R₁ R₂ M.obj))))

/-- Helper for Lemma 10.55.6: an explicit inverse candidate to the projective factor map. -/
private def projectiveGrothendieckGroupProdInv :
    (projectiveGrothendieckGroup R₁ × projectiveGrothendieckGroup R₂) →+
      projectiveGrothendieckGroup (R₁ × R₂) where
  toFun := fun x ↦ leftProjectiveEmbeddingMap R₁ R₂ x.1 + rightProjectiveEmbeddingMap R₁ R₂ x.2
  map_zero' := by simp
  map_add' := by
    intro x y
    rw [Prod.fst_add, Prod.snd_add, map_add, map_add]
    abel

/-- Helper for Lemma 10.55.6: on generators, the explicit inverse candidate reconstructs the
class of the ambient finite projective module from its two idempotent factors. -/
private theorem projectiveGrothendieckGroupProdInv_apply_factorPair_of
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) :
    projectiveGrothendieckGroupProdInv R₁ R₂ (projectiveGrothendieckGroupFactorPair R₁ R₂ M) =
      projectiveGrothendieckGroupOf (R₁ × R₂) M := by
  letI : Module (R₁ × R₂) (leftFactorSubmodule R₁ R₂ M.obj) :=
    Module.compHom (leftFactorSubmodule R₁ R₂ M.obj) (RingHom.fst R₁ R₂)
  letI : Module (R₁ × R₂) (rightFactorSubmodule R₁ R₂ M.obj) :=
    Module.compHom (rightFactorSubmodule R₁ R₂ M.obj) (RingHom.snd R₁ R₂)
  let S : ShortComplex (finiteProjectiveModuleProperty (R₁ × R₂)).FullSubcategory :=
    { X₁ := leftEmbeddedFiniteProjective R₁ R₂ (leftFactorFiniteProjective R₁ R₂ M)
      X₂ := M
      X₃ := rightEmbeddedFiniteProjective R₁ R₂ (rightFactorFiniteProjective R₁ R₂ M)
      f := ObjectProperty.homMk (ModuleCat.ofHom (leftFactorInclusion R₁ R₂))
      g := ObjectProperty.homMk (ModuleCat.ofHom (rightFactorProjection R₁ R₂))
      zero := by
        apply ObjectProperty.hom_ext
        ext x
        simp [leftFactorInclusion, rightFactorProjection, rightFactorElement] }
  have hS : (S.map (finiteProjectiveModuleProperty (R₁ × R₂)).ι).ShortExact := by
    simpa [S] using factor_split_shortExact (R₁ := R₁) (R₂ := R₂) (M := M.obj)
  have hsplit :
      projectiveGrothendieckGroupOf (R₁ × R₂) M =
        projectiveGrothendieckGroupOf (R₁ × R₂)
            (leftEmbeddedFiniteProjective R₁ R₂ (leftFactorFiniteProjective R₁ R₂ M)) +
          projectiveGrothendieckGroupOf (R₁ × R₂)
            (rightEmbeddedFiniteProjective R₁ R₂ (rightFactorFiniteProjective R₁ R₂ M)) := by
    simpa [S] using
      (ModulePropertyK0.of_shortExact (R := (R₁ × R₂))
        (P := finiteProjectiveModuleProperty (R₁ × R₂)) S hS)
  simpa [projectiveGrothendieckGroupProdInv, projectiveGrothendieckGroupFactorPair,
    leftProjectiveEmbeddingMap, rightProjectiveEmbeddingMap, projectiveGrothendieckGroupOf]
    using hsplit.symm

/-- Helper for Lemma 10.55.6: the projective factor map composed with the explicit inverse is the
identity on the product. -/
private theorem projectiveGrothendieckGroupProdMap_comp_inv :
    (projectiveGrothendieckGroupProdMap R₁ R₂).comp (projectiveGrothendieckGroupProdInv R₁ R₂) =
      AddMonoidHom.id (projectiveGrothendieckGroup R₁ × projectiveGrothendieckGroup R₂) := by
  have hleft :
      (projectiveGrothendieckGroupProdMap R₁ R₂).comp (leftProjectiveEmbeddingMap R₁ R₂) =
        leftPairHom := by
    apply QuotientAddGroup.addMonoidHom_ext
    apply FreeAbelianGroup.lift_ext
    intro M
    exact projectiveGrothendieckGroupProdMap_leftEmbedding_apply_of (R₁ := R₁) (R₂ := R₂) M
  have hright :
      (projectiveGrothendieckGroupProdMap R₁ R₂).comp (rightProjectiveEmbeddingMap R₁ R₂) =
        rightPairHom := by
    apply QuotientAddGroup.addMonoidHom_ext
    apply FreeAbelianGroup.lift_ext
    intro M
    exact projectiveGrothendieckGroupProdMap_rightEmbedding_apply_of (R₁ := R₁) (R₂ := R₂) M
  apply DFunLike.ext
  intro x
  rcases x with ⟨x₁, x₂⟩
  have hleft_apply :
      projectiveGrothendieckGroupProdMap R₁ R₂
          (leftProjectiveEmbeddingMap R₁ R₂ x₁) = (x₁, 0) := by
    simpa [AddMonoidHom.comp_apply, leftPairHom] using DFunLike.congr_fun hleft x₁
  have hright_apply :
      projectiveGrothendieckGroupProdMap R₁ R₂
          (rightProjectiveEmbeddingMap R₁ R₂ x₂) = (0, x₂) := by
    simpa [AddMonoidHom.comp_apply, rightPairHom] using DFunLike.congr_fun hright x₂
  -- The coordinate embeddings sum to the original pair, so the product map has the expected
  -- right inverse.
  ext <;> simp [AddMonoidHom.comp_apply, projectiveGrothendieckGroupProdInv, map_add,
    hleft_apply, hright_apply]

/-- Helper for Lemma 10.55.6: the explicit inverse composed with the projective factor map is the
identity on `K₀(R₁ × R₂)`. -/
private theorem projectiveGrothendieckGroupProdInv_comp_map :
    (projectiveGrothendieckGroupProdInv R₁ R₂).comp (projectiveGrothendieckGroupProdMap R₁ R₂) =
      AddMonoidHom.id (projectiveGrothendieckGroup (R₁ × R₂)) := by
  apply QuotientAddGroup.addMonoidHom_ext
  apply FreeAbelianGroup.lift_ext
  intro M
  simpa [AddMonoidHom.comp_apply] using
    projectiveGrothendieckGroupProdInv_apply_factorPair_of (R₁ := R₁) (R₂ := R₂) M

/-- Helper for Lemma 10.55.6: the projective factor map is bijective. -/
private theorem projectiveGrothendieckGroupProdMap_bijective :
    Function.Bijective (projectiveGrothendieckGroupProdMap R₁ R₂) := by
  have hrightInv : Function.RightInverse (projectiveGrothendieckGroupProdInv R₁ R₂)
      (projectiveGrothendieckGroupProdMap R₁ R₂) := by
    intro x
    exact DFunLike.congr_fun (projectiveGrothendieckGroupProdMap_comp_inv (R₁ := R₁) (R₂ := R₂)) x
  have hleftInv : Function.LeftInverse (projectiveGrothendieckGroupProdInv R₁ R₂)
      (projectiveGrothendieckGroupProdMap R₁ R₂) := by
    intro x
    exact DFunLike.congr_fun (projectiveGrothendieckGroupProdInv_comp_map (R₁ := R₁) (R₂ := R₂)) x
  exact ⟨hleftInv.injective, hrightInv.surjective⟩

private abbrev finiteGrothendieckGroupFactorPair (M : FGModuleCat (R₁ × R₂)) :
    finiteGrothendieckGroup R₁ × finiteGrothendieckGroup R₂ :=
  ( finiteGrothendieckGroupOf R₁ (leftFactorFinite R₁ R₂ M)
  , finiteGrothendieckGroupOf R₂ (rightFactorFinite R₁ R₂ M) )

/-- Helper for Lemma 10.55.6: the left and right factor functors preserve the defining
Grothendieck relations for finite modules. -/
private theorem finiteGrothendieckGroup_relations_le_ker_prodMap :
    modulePropertyK0Relations (R₁ × R₂) (ModuleCat.isFG (R₁ × R₂)) ≤
      (FreeAbelianGroup.lift (finiteGrothendieckGroupFactorPair R₁ R₂)).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  change
    FreeAbelianGroup.lift (finiteGrothendieckGroupFactorPair R₁ R₂)
      (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  have hleft :
      finiteGrothendieckGroupOf R₁ (leftFactorFinite R₁ R₂ S.X₂) =
        finiteGrothendieckGroupOf R₁ (leftFactorFinite R₁ R₂ S.X₁) +
          finiteGrothendieckGroupOf R₁ (leftFactorFinite R₁ R₂ S.X₃) := by
    let T : ShortComplex (ModuleCat.isFG R₁).FullSubcategory :=
      { X₁ := leftFactorFinite R₁ R₂ S.X₁
        X₂ := leftFactorFinite R₁ R₂ S.X₂
        X₃ := leftFactorFinite R₁ R₂ S.X₃
        f := ObjectProperty.homMk (ModuleCat.ofHom (leftFactorMap R₁ R₂ S.f.hom.hom))
        g := ObjectProperty.homMk (ModuleCat.ofHom (leftFactorMap R₁ R₂ S.g.hom.hom))
        zero := by
          apply ObjectProperty.hom_ext
          ext x
          change S.g.hom.hom (S.f.hom.hom x.1) = 0
          simpa using (S.map (ModuleCat.isFG (R₁ × R₂)).ι).moduleCat_zero_apply x.1 }
    have hT : (T.map (ModuleCat.isFG R₁).ι).ShortExact := by
      simpa [T] using leftFactor_shortExact R₁ R₂
        ((S.map (ModuleCat.isFG (R₁ × R₂)).ι)) hS
    simpa [T] using ModulePropertyK0.of_shortExact (R := R₁) (P := ModuleCat.isFG R₁) T hT
  have hright :
      finiteGrothendieckGroupOf R₂ (rightFactorFinite R₁ R₂ S.X₂) =
        finiteGrothendieckGroupOf R₂ (rightFactorFinite R₁ R₂ S.X₁) +
          finiteGrothendieckGroupOf R₂ (rightFactorFinite R₁ R₂ S.X₃) := by
    let T : ShortComplex (ModuleCat.isFG R₂).FullSubcategory :=
      { X₁ := rightFactorFinite R₁ R₂ S.X₁
        X₂ := rightFactorFinite R₁ R₂ S.X₂
        X₃ := rightFactorFinite R₁ R₂ S.X₃
        f := ObjectProperty.homMk (ModuleCat.ofHom (rightFactorMap R₁ R₂ S.f.hom.hom))
        g := ObjectProperty.homMk (ModuleCat.ofHom (rightFactorMap R₁ R₂ S.g.hom.hom))
        zero := by
          apply ObjectProperty.hom_ext
          ext x
          change S.g.hom.hom (S.f.hom.hom x.1) = 0
          simpa using (S.map (ModuleCat.isFG (R₁ × R₂)).ι).moduleCat_zero_apply x.1 }
    have hT : (T.map (ModuleCat.isFG R₂).ι).ShortExact := by
      simpa [T] using rightFactor_shortExact R₁ R₂
        ((S.map (ModuleCat.isFG (R₁ × R₂)).ι)) hS
    simpa [T] using ModulePropertyK0.of_shortExact (R := R₂) (P := ModuleCat.isFG R₂) T hT
  ext
  · have hleft' :
        finiteGrothendieckGroupOf R₁ (leftFactorFinite R₁ R₂ S.X₂) -
            finiteGrothendieckGroupOf R₁ (leftFactorFinite R₁ R₂ S.X₁) -
              finiteGrothendieckGroupOf R₁ (leftFactorFinite R₁ R₂ S.X₃) =
          0 := by
      rw [hleft]
      abel_nf
    simpa [finiteGrothendieckGroupFactorPair, finiteGrothendieckGroupOf, ModulePropertyK0.of]
      using hleft'
  · have hright' :
        finiteGrothendieckGroupOf R₂ (rightFactorFinite R₁ R₂ S.X₂) -
            finiteGrothendieckGroupOf R₂ (rightFactorFinite R₁ R₂ S.X₁) -
              finiteGrothendieckGroupOf R₂ (rightFactorFinite R₁ R₂ S.X₃) =
          0 := by
      rw [hright]
      abel_nf
    simpa [finiteGrothendieckGroupFactorPair, finiteGrothendieckGroupOf, ModulePropertyK0.of]
      using hright'

/-- Helper for Lemma 10.55.6: the canonical map from `K'_0(R₁ × R₂)` to the product of the
factor Grothendieck groups. -/
private def finiteGrothendieckGroupProdMap :
    finiteGrothendieckGroup (R₁ × R₂) →+
      (finiteGrothendieckGroup R₁ × finiteGrothendieckGroup R₂) :=
  ModulePropertyK0.lift (R₁ × R₂)
    (finiteGrothendieckGroupFactorPair R₁ R₂)
    (finiteGrothendieckGroup_relations_le_ker_prodMap R₁ R₂)

/-- Helper for Lemma 10.55.6: the Grothendieck relations for left-embedded finite modules are
preserved. -/
private theorem finiteGrothendieckGroup_relations_le_ker_leftEmbedding :
    modulePropertyK0Relations R₁ (ModuleCat.isFG R₁) ≤
      (FreeAbelianGroup.lift fun M : FGModuleCat R₁ ↦
        finiteGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFinite R₁ R₂ M)).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  letI : Module (R₁ × R₂) S.X₁.obj := Module.compHom S.X₁.obj (RingHom.fst R₁ R₂)
  letI : Module (R₁ × R₂) S.X₂.obj := Module.compHom S.X₂.obj (RingHom.fst R₁ R₂)
  letI : Module (R₁ × R₂) S.X₃.obj := Module.compHom S.X₃.obj (RingHom.fst R₁ R₂)
  let T : ShortComplex (ModuleCat.isFG (R₁ × R₂)).FullSubcategory :=
    { X₁ := leftEmbeddedFinite R₁ R₂ S.X₁
      X₂ := leftEmbeddedFinite R₁ R₂ S.X₂
      X₃ := leftEmbeddedFinite R₁ R₂ S.X₃
      f := ObjectProperty.homMk (ModuleCat.ofHom (leftCompHomLinearMap R₁ R₂ S.f.hom.hom))
      g := ObjectProperty.homMk (ModuleCat.ofHom (leftCompHomLinearMap R₁ R₂ S.g.hom.hom))
      zero := by
        apply ObjectProperty.hom_ext
        ext x
        simpa [leftCompHomLinearMap] using
          (S.map (ModuleCat.isFG R₁).ι).moduleCat_zero_apply x }
  have hT : (T.map (ModuleCat.isFG (R₁ × R₂)).ι).ShortExact := by
    refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
    · simpa [T, leftCompHomLinearMap] using
        (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact
          (S.map (ModuleCat.isFG R₁).ι)).mp hS.exact
    · simpa [T, leftCompHomLinearMap] using hS.moduleCat_injective_f
    · simpa [T, leftCompHomLinearMap] using hS.moduleCat_surjective_g
  change
    FreeAbelianGroup.lift
        (fun M : FGModuleCat R₁ ↦ finiteGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFinite R₁ R₂ M))
      (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  have hTrel :
      finiteGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFinite R₁ R₂ S.X₂) =
        finiteGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFinite R₁ R₂ S.X₁) +
          finiteGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFinite R₁ R₂ S.X₃) := by
    simpa [T] using
      (ModulePropertyK0.of_shortExact (R := (R₁ × R₂)) (P := ModuleCat.isFG (R₁ × R₂)) T hT)
  rw [hTrel]
  abel_nf

/-- Helper for Lemma 10.55.6: the Grothendieck relations for right-embedded finite modules are
preserved. -/
private theorem finiteGrothendieckGroup_relations_le_ker_rightEmbedding :
    modulePropertyK0Relations R₂ (ModuleCat.isFG R₂) ≤
      (FreeAbelianGroup.lift fun M : FGModuleCat R₂ ↦
        finiteGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFinite R₁ R₂ M)).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  letI : Module (R₁ × R₂) S.X₁.obj := Module.compHom S.X₁.obj (RingHom.snd R₁ R₂)
  letI : Module (R₁ × R₂) S.X₂.obj := Module.compHom S.X₂.obj (RingHom.snd R₁ R₂)
  letI : Module (R₁ × R₂) S.X₃.obj := Module.compHom S.X₃.obj (RingHom.snd R₁ R₂)
  let T : ShortComplex (ModuleCat.isFG (R₁ × R₂)).FullSubcategory :=
    { X₁ := rightEmbeddedFinite R₁ R₂ S.X₁
      X₂ := rightEmbeddedFinite R₁ R₂ S.X₂
      X₃ := rightEmbeddedFinite R₁ R₂ S.X₃
      f := ObjectProperty.homMk (ModuleCat.ofHom (rightCompHomLinearMap R₁ R₂ S.f.hom.hom))
      g := ObjectProperty.homMk (ModuleCat.ofHom (rightCompHomLinearMap R₁ R₂ S.g.hom.hom))
      zero := by
        apply ObjectProperty.hom_ext
        ext x
        simpa [rightCompHomLinearMap] using
          (S.map (ModuleCat.isFG R₂).ι).moduleCat_zero_apply x }
  have hT : (T.map (ModuleCat.isFG (R₁ × R₂)).ι).ShortExact := by
    refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
    · simpa [T, rightCompHomLinearMap] using
        (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact
          (S.map (ModuleCat.isFG R₂).ι)).mp hS.exact
    · simpa [T, rightCompHomLinearMap] using hS.moduleCat_injective_f
    · simpa [T, rightCompHomLinearMap] using hS.moduleCat_surjective_g
  change
    FreeAbelianGroup.lift
        (fun M : FGModuleCat R₂ ↦ finiteGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFinite R₁ R₂ M))
      (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  have hTrel :
      finiteGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFinite R₁ R₂ S.X₂) =
        finiteGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFinite R₁ R₂ S.X₁) +
          finiteGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFinite R₁ R₂ S.X₃) := by
    simpa [T] using
      (ModulePropertyK0.of_shortExact (R := (R₁ × R₂)) (P := ModuleCat.isFG (R₁ × R₂)) T hT)
  rw [hTrel]
  abel_nf

/-- Helper for Lemma 10.55.6: embed `K'_0(R₁)` into `K'_0(R₁ × R₂)` along the first projection. -/
private def leftFiniteEmbeddingMap :
    finiteGrothendieckGroup R₁ →+ finiteGrothendieckGroup (R₁ × R₂) :=
  ModulePropertyK0.lift R₁
    (fun M : FGModuleCat R₁ ↦ finiteGrothendieckGroupOf (R₁ × R₂) (leftEmbeddedFinite R₁ R₂ M))
    (finiteGrothendieckGroup_relations_le_ker_leftEmbedding R₁ R₂)

/-- Helper for Lemma 10.55.6: embed `K'_0(R₂)` into `K'_0(R₁ × R₂)` along the second projection. -/
private def rightFiniteEmbeddingMap :
    finiteGrothendieckGroup R₂ →+ finiteGrothendieckGroup (R₁ × R₂) :=
  ModulePropertyK0.lift R₂
    (fun M : FGModuleCat R₂ ↦ finiteGrothendieckGroupOf (R₁ × R₂) (rightEmbeddedFinite R₁ R₂ M))
    (finiteGrothendieckGroup_relations_le_ker_rightEmbedding R₁ R₂)

/-- Helper for Lemma 10.55.6: factoring a left-embedded finite module recovers the original
`K'_0(R₁)` class and kills the `R₂` component. -/
private theorem finiteGrothendieckGroupProdMap_leftEmbedding_apply_of
    (M : FGModuleCat R₁) :
    finiteGrothendieckGroupProdMap R₁ R₂
        (leftFiniteEmbeddingMap R₁ R₂ (finiteGrothendieckGroupOf R₁ M)) =
      (finiteGrothendieckGroupOf R₁ M, 0) := by
  letI : Module (R₁ × R₂) M.obj := Module.compHom M.obj (RingHom.fst R₁ R₂)
  simp only [leftFiniteEmbeddingMap, finiteGrothendieckGroupProdMap,
    finiteGrothendieckGroupOf, ModulePropertyK0.lift_of]
  refine Prod.ext ?_ ?_
  · simpa [finiteGrothendieckGroupFactorPair] using
      (ModulePropertyK0.of_iso (R := R₁) (P := ModuleCat.isFG R₁)
        (isFG_zero R₁)
        (ObjectProperty.isoMk
          (P := ModuleCat.isFG R₁)
          (LinearEquiv.toModuleIso (leftFactorOfLeftEmbeddedLinearEquiv R₁ R₂ M.obj))))
  · letI : Subsingleton (rightFactorSubmodule R₁ R₂ M.obj) :=
      rightFactorOfLeftEmbedded_subsingleton R₁ R₂ M.obj
    simpa [finiteGrothendieckGroupFactorPair] using
      (ModulePropertyK0.of_subsingleton (R := R₂) (P := ModuleCat.isFG R₂)
        (isFG_zero R₂)
        (rightFactorFinite R₁ R₂ (leftEmbeddedFinite R₁ R₂ M)))

/-- Helper for Lemma 10.55.6: factoring a right-embedded finite module recovers the original
`K'_0(R₂)` class and kills the `R₁` component. -/
private theorem finiteGrothendieckGroupProdMap_rightEmbedding_apply_of
    (M : FGModuleCat R₂) :
    finiteGrothendieckGroupProdMap R₁ R₂
        (rightFiniteEmbeddingMap R₁ R₂ (finiteGrothendieckGroupOf R₂ M)) =
      (0, finiteGrothendieckGroupOf R₂ M) := by
  letI : Module (R₁ × R₂) M.obj := Module.compHom M.obj (RingHom.snd R₁ R₂)
  simp only [rightFiniteEmbeddingMap, finiteGrothendieckGroupProdMap,
    finiteGrothendieckGroupOf, ModulePropertyK0.lift_of]
  refine Prod.ext ?_ ?_
  · letI : Subsingleton (leftFactorSubmodule R₁ R₂ M.obj) :=
      leftFactorOfRightEmbedded_subsingleton R₁ R₂ M.obj
    simpa [finiteGrothendieckGroupFactorPair] using
      (ModulePropertyK0.of_subsingleton (R := R₁) (P := ModuleCat.isFG R₁)
        (isFG_zero R₁)
        (leftFactorFinite R₁ R₂ (rightEmbeddedFinite R₁ R₂ M)))
  · simpa [finiteGrothendieckGroupFactorPair] using
      (ModulePropertyK0.of_iso (R := R₂) (P := ModuleCat.isFG R₂)
        (isFG_zero R₂)
        (ObjectProperty.isoMk
          (P := ModuleCat.isFG R₂)
          (LinearEquiv.toModuleIso (rightFactorOfRightEmbeddedLinearEquiv R₁ R₂ M.obj))))

/-- Helper for Lemma 10.55.6: an explicit inverse candidate to the finite-module factor map. -/
private def finiteGrothendieckGroupProdInv :
    (finiteGrothendieckGroup R₁ × finiteGrothendieckGroup R₂) →+
      finiteGrothendieckGroup (R₁ × R₂) where
  toFun := fun x ↦ leftFiniteEmbeddingMap R₁ R₂ x.1 + rightFiniteEmbeddingMap R₁ R₂ x.2
  map_zero' := by simp
  map_add' := by
    intro x y
    rw [Prod.fst_add, Prod.snd_add, map_add, map_add]
    abel

/-- Helper for Lemma 10.55.6: on generators, the explicit inverse candidate reconstructs the
class of the ambient finite module from its two idempotent factors. -/
private theorem finiteGrothendieckGroupProdInv_apply_factorPair_of
    (M : FGModuleCat (R₁ × R₂)) :
    finiteGrothendieckGroupProdInv R₁ R₂ (finiteGrothendieckGroupFactorPair R₁ R₂ M) =
      finiteGrothendieckGroupOf (R₁ × R₂) M := by
  letI : Module (R₁ × R₂) (leftFactorSubmodule R₁ R₂ M.obj) :=
    Module.compHom (leftFactorSubmodule R₁ R₂ M.obj) (RingHom.fst R₁ R₂)
  letI : Module (R₁ × R₂) (rightFactorSubmodule R₁ R₂ M.obj) :=
    Module.compHom (rightFactorSubmodule R₁ R₂ M.obj) (RingHom.snd R₁ R₂)
  let S : ShortComplex (ModuleCat.isFG (R₁ × R₂)).FullSubcategory :=
    { X₁ := leftEmbeddedFinite R₁ R₂ (leftFactorFinite R₁ R₂ M)
      X₂ := M
      X₃ := rightEmbeddedFinite R₁ R₂ (rightFactorFinite R₁ R₂ M)
      f := ObjectProperty.homMk (ModuleCat.ofHom (leftFactorInclusion R₁ R₂))
      g := ObjectProperty.homMk (ModuleCat.ofHom (rightFactorProjection R₁ R₂))
      zero := by
        apply ObjectProperty.hom_ext
        ext x
        simp [leftFactorInclusion, rightFactorProjection, rightFactorElement] }
  have hS : (S.map (ModuleCat.isFG (R₁ × R₂)).ι).ShortExact := by
    simpa [S] using factor_split_shortExact (R₁ := R₁) (R₂ := R₂) (M := M.obj)
  have hsplit :
      finiteGrothendieckGroupOf (R₁ × R₂) M =
        finiteGrothendieckGroupOf (R₁ × R₂)
            (leftEmbeddedFinite R₁ R₂ (leftFactorFinite R₁ R₂ M)) +
          finiteGrothendieckGroupOf (R₁ × R₂)
            (rightEmbeddedFinite R₁ R₂ (rightFactorFinite R₁ R₂ M)) := by
    simpa [S] using
      (ModulePropertyK0.of_shortExact (R := (R₁ × R₂)) (P := ModuleCat.isFG (R₁ × R₂)) S hS)
  simpa [finiteGrothendieckGroupProdInv, finiteGrothendieckGroupFactorPair,
    leftFiniteEmbeddingMap, rightFiniteEmbeddingMap, finiteGrothendieckGroupOf]
    using hsplit.symm

/-- Helper for Lemma 10.55.6: the finite-module factor map composed with the explicit inverse is
the identity on the product. -/
private theorem finiteGrothendieckGroupProdMap_comp_inv :
    (finiteGrothendieckGroupProdMap R₁ R₂).comp (finiteGrothendieckGroupProdInv R₁ R₂) =
      AddMonoidHom.id (finiteGrothendieckGroup R₁ × finiteGrothendieckGroup R₂) := by
  have hleft :
      (finiteGrothendieckGroupProdMap R₁ R₂).comp (leftFiniteEmbeddingMap R₁ R₂) =
        leftPairHom := by
    apply QuotientAddGroup.addMonoidHom_ext
    apply FreeAbelianGroup.lift_ext
    intro M
    exact finiteGrothendieckGroupProdMap_leftEmbedding_apply_of (R₁ := R₁) (R₂ := R₂) M
  have hright :
      (finiteGrothendieckGroupProdMap R₁ R₂).comp (rightFiniteEmbeddingMap R₁ R₂) =
        rightPairHom := by
    apply QuotientAddGroup.addMonoidHom_ext
    apply FreeAbelianGroup.lift_ext
    intro M
    exact finiteGrothendieckGroupProdMap_rightEmbedding_apply_of (R₁ := R₁) (R₂ := R₂) M
  apply DFunLike.ext
  intro x
  rcases x with ⟨x₁, x₂⟩
  have hleft_apply :
      finiteGrothendieckGroupProdMap R₁ R₂
          (leftFiniteEmbeddingMap R₁ R₂ x₁) = (x₁, 0) := by
    simpa [AddMonoidHom.comp_apply, leftPairHom] using DFunLike.congr_fun hleft x₁
  have hright_apply :
      finiteGrothendieckGroupProdMap R₁ R₂
          (rightFiniteEmbeddingMap R₁ R₂ x₂) = (0, x₂) := by
    simpa [AddMonoidHom.comp_apply, rightPairHom] using DFunLike.congr_fun hright x₂
  -- The finite-module case uses the same product reconstruction on the additive target.
  ext <;> simp [AddMonoidHom.comp_apply, finiteGrothendieckGroupProdInv, map_add,
    hleft_apply, hright_apply]

/-- Helper for Lemma 10.55.6: the explicit inverse composed with the finite-module factor map is
the identity on `K'_0(R₁ × R₂)`. -/
private theorem finiteGrothendieckGroupProdInv_comp_map :
    (finiteGrothendieckGroupProdInv R₁ R₂).comp (finiteGrothendieckGroupProdMap R₁ R₂) =
      AddMonoidHom.id (finiteGrothendieckGroup (R₁ × R₂)) := by
  apply QuotientAddGroup.addMonoidHom_ext
  apply FreeAbelianGroup.lift_ext
  intro M
  simpa [AddMonoidHom.comp_apply] using
    finiteGrothendieckGroupProdInv_apply_factorPair_of (R₁ := R₁) (R₂ := R₂) M

/-- Helper for Lemma 10.55.6: the finite-module factor map is bijective. -/
private theorem finiteGrothendieckGroupProdMap_bijective :
    Function.Bijective (finiteGrothendieckGroupProdMap R₁ R₂) := by
  have hrightInv : Function.RightInverse (finiteGrothendieckGroupProdInv R₁ R₂)
      (finiteGrothendieckGroupProdMap R₁ R₂) := by
    intro x
    exact DFunLike.congr_fun (finiteGrothendieckGroupProdMap_comp_inv (R₁ := R₁) (R₂ := R₂)) x
  have hleftInv : Function.LeftInverse (finiteGrothendieckGroupProdInv R₁ R₂)
      (finiteGrothendieckGroupProdMap R₁ R₂) := by
    intro x
    exact DFunLike.congr_fun (finiteGrothendieckGroupProdInv_comp_map (R₁ := R₁) (R₂ := R₂)) x
  exact ⟨hleftInv.injective, hrightInv.surjective⟩

-- Proof sketch: pass from a finitely generated projective `(R₁ × R₂)`-module to the two
-- idempotent factors cut out by `(1, 0)` and `(0, 1)`, descend that assignment to `K₀`, and use
-- the canonical reconstruction of product-ring modules from their two factors to prove bijectivity.
/-- Lemma 10.55.6 (1): the Grothendieck group `K₀(R₁ × R₂)` of finitely generated projective
modules is canonically the product of `K₀(R₁)` and `K₀(R₂)`. -/
@[stacks 00JH]
noncomputable def projectiveGrothendieckGroup_prod :
    projectiveGrothendieckGroup (R₁ × R₂) ≃+
      (projectiveGrothendieckGroup R₁ × projectiveGrothendieckGroup R₂) :=
  AddEquiv.ofBijective (projectiveGrothendieckGroupProdMap R₁ R₂)
    (projectiveGrothendieckGroupProdMap_bijective R₁ R₂)

-- Proof sketch: unfold `projectiveGrothendieckGroup_prod`; it was defined to be the additive
-- equivalence produced by `AddEquiv.ofBijective` from `projectiveGrothendieckGroupProdMap`.
/-- The product equivalence on `K₀` is definitionally the additive equivalence attached to the
canonical Grothendieck-group homomorphism from the two idempotent factors. -/
theorem projectiveGrothendieckGroup_prod_def :
    projectiveGrothendieckGroup_prod R₁ R₂ =
      AddEquiv.ofBijective (projectiveGrothendieckGroupProdMap R₁ R₂)
        (projectiveGrothendieckGroupProdMap_bijective R₁ R₂) := rfl

/-- The additive equivalence `projectiveGrothendieckGroup_prod` is induced by the canonical
Grothendieck-group homomorphism built from the two idempotent factors. -/
-- Proof sketch: `projectiveGrothendieckGroup_prod` is defined by `AddEquiv.ofBijective` from
-- `projectiveGrothendieckGroupProdMap`, so its underlying additive homomorphism is exactly that
-- map.
@[simp] theorem projectiveGrothendieckGroup_prod_toAddMonoidHom :
    (projectiveGrothendieckGroup_prod R₁ R₂).toAddMonoidHom =
      projectiveGrothendieckGroupProdMap R₁ R₂ := rfl

/-- Applying `projectiveGrothendieckGroup_prod` is the same as applying the canonical additive
homomorphism induced by the two idempotent factors. -/
-- Proof sketch: `projectiveGrothendieckGroup_prod` is defined by `AddEquiv.ofBijective`, whose
-- underlying function is the additive homomorphism `projectiveGrothendieckGroupProdMap`.
@[simp] theorem projectiveGrothendieckGroup_prod_apply
    (x : projectiveGrothendieckGroup (R₁ × R₂)) :
    projectiveGrothendieckGroup_prod R₁ R₂ x =
      projectiveGrothendieckGroupProdMap R₁ R₂ x := rfl

/-- On the class of a finite projective `(R₁ × R₂)`-module, `projectiveGrothendieckGroup_prod`
records the two idempotent factors cut out by `(1, 0)` and `(0, 1)`. -/
-- Proof sketch: evaluate the general `projectiveGrothendieckGroup_prod_apply` formula on a
-- generator class and then use `ModulePropertyK0.lift_of` for the defining quotient map.
@[simp] theorem projectiveGrothendieckGroup_prod_apply_of
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) :
    projectiveGrothendieckGroup_prod R₁ R₂
        (projectiveGrothendieckGroupOf (R₁ × R₂) M) =
      projectiveGrothendieckGroupFactorPair R₁ R₂ M := by
  rw [projectiveGrothendieckGroup_prod_apply]
  simpa using ModulePropertyK0.lift_of (R := (R₁ × R₂))
    (projectiveGrothendieckGroupFactorPair R₁ R₂)
    (projectiveGrothendieckGroup_relations_le_ker_prodMap R₁ R₂) M

-- Proof sketch: take the two idempotent factors of a finite `(R₁ × R₂)`-module,
-- descend the resulting pair of classes to `K'_0`, and prove this quotient map is bijective by
-- reconstructing finite modules over the product ring from pairs over the factors.
/-- Lemma 10.55.6 (2): the Grothendieck group `K'_0(R₁ × R₂)` of finite modules is
canonically the product of `K'_0(R₁)` and `K'_0(R₂)`. -/
@[stacks 00JH]
noncomputable def finiteGrothendieckGroup_prod :
    finiteGrothendieckGroup (R₁ × R₂) ≃+
      (finiteGrothendieckGroup R₁ × finiteGrothendieckGroup R₂) :=
  AddEquiv.ofBijective (finiteGrothendieckGroupProdMap R₁ R₂)
    (finiteGrothendieckGroupProdMap_bijective R₁ R₂)

-- Proof sketch: unfold `finiteGrothendieckGroup_prod`; it was defined to be the additive
-- equivalence produced by `AddEquiv.ofBijective` from `finiteGrothendieckGroupProdMap`.
/-- The product equivalence on `K'_0` is definitionally the additive equivalence attached to the
canonical Grothendieck-group homomorphism from the two idempotent factors. -/
theorem finiteGrothendieckGroup_prod_def :
    finiteGrothendieckGroup_prod R₁ R₂ =
      AddEquiv.ofBijective (finiteGrothendieckGroupProdMap R₁ R₂)
        (finiteGrothendieckGroupProdMap_bijective R₁ R₂) := rfl

/-- The additive equivalence `finiteGrothendieckGroup_prod` is induced by the canonical
Grothendieck-group homomorphism built from the two idempotent factors. -/
-- Proof sketch: `finiteGrothendieckGroup_prod` is defined by `AddEquiv.ofBijective` from
-- `finiteGrothendieckGroupProdMap`, so its underlying additive homomorphism is exactly that map.
@[simp] theorem finiteGrothendieckGroup_prod_toAddMonoidHom :
    (finiteGrothendieckGroup_prod R₁ R₂).toAddMonoidHom =
      finiteGrothendieckGroupProdMap R₁ R₂ := rfl

/-- Applying `finiteGrothendieckGroup_prod` is the same as applying the canonical additive
homomorphism induced by the two idempotent factors. -/
-- Proof sketch: `finiteGrothendieckGroup_prod` is defined by `AddEquiv.ofBijective`, whose
-- underlying function is the additive homomorphism `finiteGrothendieckGroupProdMap`.
@[simp] theorem finiteGrothendieckGroup_prod_apply
    (x : finiteGrothendieckGroup (R₁ × R₂)) :
    finiteGrothendieckGroup_prod R₁ R₂ x =
      finiteGrothendieckGroupProdMap R₁ R₂ x := rfl

/-- On the class of a finite `(R₁ × R₂)`-module, `finiteGrothendieckGroup_prod` records the two
idempotent factors cut out by `(1, 0)` and `(0, 1)`. -/
-- Proof sketch: evaluate the general `finiteGrothendieckGroup_prod_apply` formula on a generator
-- class and then use `ModulePropertyK0.lift_of` for the defining quotient map.
@[simp] theorem finiteGrothendieckGroup_prod_apply_of
    (M : FGModuleCat (R₁ × R₂)) :
    finiteGrothendieckGroup_prod R₁ R₂
        (finiteGrothendieckGroupOf (R₁ × R₂) M) =
      finiteGrothendieckGroupFactorPair R₁ R₂ M := by
  rw [finiteGrothendieckGroup_prod_apply]
  simpa using ModulePropertyK0.lift_of (R := (R₁ × R₂))
    (finiteGrothendieckGroupFactorPair R₁ R₂)
    (finiteGrothendieckGroup_relations_le_ker_prodMap R₁ R₂) M

end ProductFactors
