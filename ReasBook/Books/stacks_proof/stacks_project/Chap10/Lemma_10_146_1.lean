/-- Helper for Chap10 Lemma 10 146 1: the quotient section sends the standard-etale coordinate
to the chosen base lift. -/
private lemma standardEtalePresentationQuotientSection_x
    {A : Type (max u v)} [CommRing A] [Algebra R A]
    (P : StandardEtalePresentation R A) (r : R) (hg : IsUnit (P.g.eval r)) :
    standardEtalePresentationQuotientSection (P := P) r hg P.x =
      Ideal.Quotient.mk (Ideal.span ({P.f.eval r} : Set R)) r := by
  -- Reduce the computation to the universal property of the standard-etale pair.
  simp [standardEtalePresentationQuotientSection]

