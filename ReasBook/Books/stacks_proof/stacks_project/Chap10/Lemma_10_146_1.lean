/-- Helper for Chap10 Lemma 10 146 1: the shifted standard-etale coordinate lies in the
principal ideal generated by the shifted constant term after mapping to the target. -/
private lemma standardEtalePresentation_shiftedCoordinate_mem_map_span_eval_of_residueShift
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A) {r : R}
    (hshift : residue S (algebraMap A S (P.x - algebraMap R A r)) = 0) :
    algebraMap A S (P.x - algebraMap R A r) ∈
      Ideal.map (algebraMap R S) (Ideal.span ({P.f.eval r} : Set R)) := by
  -- Combine the Taylor relation with invertibility of the shifted factor to solve for the
  -- coordinate as a multiple of the mapped constant term.
  let y : S := algebraMap A S (P.x - algebraMap R A r)
  let q : S :=
    Polynomial.aeval y (((P.f.comp (Polynomial.X + Polynomial.C r)).divX).map (algebraMap R S))
  have hq : IsUnit q := by
    exact standardEtalePresentation_shiftedLinearFactor_isUnit (P := P) hshift
  have hrel : y * q + algebraMap R S (P.f.eval r) = 0 := by
    exact standardEtalePresentation_shiftedCoordinate_mul_divX_add_eval (P := P) r
  exact mem_map_span_singleton_of_mul_unit_add_algebraMap_eq_zero (R := R) (S := S)
    (P.f.eval r) hq hrel

/-- Helper for Chap10 Lemma 10 146 1: if the shifted coordinate has zero residue, then the
standard-etale localization denominator remains a unit after evaluating at the base lift. -/
private lemma standardEtalePresentation_eval_g_isUnit_of_residueShift
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A) {r : R}
    (hshift : residue S (algebraMap A S (P.x - algebraMap R A r)) = 0) :
    IsUnit (P.g.eval r) := by
  -- It is enough to prove that the residue of `g(r)` in the base field is nonzero.
  apply (residue_ne_zero_iff_isUnit (R := R) (x := P.g.eval r)).mp
  intro hzero
  have hcoord :
      residue S (algebraMap A S P.x) = residue S (algebraMap R S r) := by
    rw [map_sub] at hshift
    have hscalar : algebraMap A S (algebraMap R A r) = algebraMap R S r := by
      exact (IsScalarTower.algebraMap_apply R A S r).symm
    rw [hscalar] at hshift
    exact sub_eq_zero.mp hshift
  have htarget :
      residue S (algebraMap R S (P.g.eval r)) =
        residue S (algebraMap A S (Polynomial.aeval P.x P.g)) := by
    -- Compare polynomial evaluation in the target residue field using the shifted-coordinate
    -- residue equality.
    calc
      residue S (algebraMap R S (P.g.eval r))
          = Polynomial.aeval (residue S (algebraMap R S r))
              (P.g.map (algebraMap R (ResidueField S))) := by
            rw [← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval (A := S) r P.g]
            simpa [Polynomial.aeval_map_algebraMap] using
              (Polynomial.aeval_algHom_apply
                (IsScalarTower.toAlgHom R S (ResidueField S)) (algebraMap R S r) P.g).symm
      _ = Polynomial.aeval (residue S (algebraMap A S P.x))
              (P.g.map (algebraMap R (ResidueField S))) := by
            rw [hcoord]
      _ = residue S (algebraMap A S (Polynomial.aeval P.x P.g)) := by
            have h₁ :
                algebraMap A S (Polynomial.aeval P.x P.g) =
                  Polynomial.aeval (algebraMap A S P.x) (P.g.map (algebraMap R S)) := by
              simpa using
                (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom R A S) P.x P.g).symm
            rw [h₁]
            simpa [Polynomial.aeval_map_algebraMap] using
              (Polynomial.aeval_algHom_apply
                (IsScalarTower.toAlgHom R S (ResidueField S)) (algebraMap A S P.x) P.g)
  have htarget_zero : residue S (algebraMap A S (Polynomial.aeval P.x P.g)) = 0 := by
    rw [← htarget]
    rw [← ResidueField.map_residue]
    rw [hzero, map_zero]
  have hunit : IsUnit (algebraMap A S (Polynomial.aeval P.x P.g)) :=
    P.hasMap.2.map (IsScalarTower.toAlgHom R A S)
  exact (residue_ne_zero_iff_isUnit (R := S)
    (x := algebraMap A S (Polynomial.aeval P.x P.g))).mpr hunit htarget_zero

