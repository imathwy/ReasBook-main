/-- Helper for Chap10 Lemma 10 146 1: if a unit multiple differs from a base element, then the
element lies in the mapped principal ideal. -/
private lemma mem_map_span_singleton_of_mul_unit_add_algebraMap_eq_zero
    (t : R) {y q : S} (hq : IsUnit q) (hrel : y * q + algebraMap R S t = 0) :
    y ∈ Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R)) := by
  -- Divide by the unit and use closure of the mapped ideal under multiplication.
  obtain ⟨u, rfl⟩ := hq
  have hyt : y * (u : S) = -algebraMap R S t := by
    exact eq_neg_of_add_eq_zero_left (by simpa [add_comm] using hrel)
  have hy : y = (-algebraMap R S t) * ↑u⁻¹ := by
    calc
      y = (y * (u : S)) * ↑u⁻¹ := by rw [mul_assoc, Units.mul_inv, mul_one]
      _ = (-algebraMap R S t) * ↑u⁻¹ := by rw [hyt]
  rw [hy]
  exact Ideal.mul_mem_right _ _
    (neg_mem (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self t)))

