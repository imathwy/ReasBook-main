/-- Helper for Chap10 Lemma 10 146 1: a first-order quotient isomorphism for a principal ideal,
together with formal étaleness, gives the desired quotient isomorphisms for all positive powers. -/
lemma powQuotientMap_bijective_of_formallyEtale_firstQuotient
    (t : R)
    (hf : RingHom.FormallyEtale (algebraMap R S))
    (hfirst : Function.Bijective
      ((Ideal.quotientMap
          (Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R)))
          (algebraMap R S) Ideal.le_comap_map) :
        R ⧸ Ideal.span ({t} : Set R) →+*
          S ⧸ Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R)))) :
    ∀ n : ℕ+,
      Function.Bijective
        ((Ideal.quotientMap
            (Ideal.map (algebraMap R S) (Ideal.span ({t ^ (n : ℕ)} : Set R)))
            (algebraMap R S) Ideal.le_comap_map) :
          R ⧸ Ideal.span ({t ^ (n : ℕ)} : Set R) →+*
            S ⧸ Ideal.map (algebraMap R S) (Ideal.span ({t ^ (n : ℕ)} : Set R))) := by
  intro n
  let I : Ideal R := Ideal.span ({t} : Set R)
  let J : Ideal S := Ideal.map (algebraMap R S) I
  -- The first quotient isomorphism supplies the comap equality and quotient surjectivity.
  have hcomap : Ideal.comap (algebraMap R S) J = I := by
    exact comap_eq_of_quotientMap_injective Ideal.le_comap_map hfirst.1
  have hsurj : Function.Surjective ((Ideal.Quotient.mk J).comp (algebraMap R S)) := by
    exact quotient_mk_comp_surjective_of_quotientMap_surjective Ideal.le_comap_map hfirst.2
  have hpow :=
    formallyEtale_quotientMap_pow_bijective_local
      (f := (algebraMap R S)) (J := J) hf hsurj (n : ℕ)
  -- Transport the general `J`-adic comparison to the principal-ideal spelling of the target.
  have hIpow : I ^ (n : ℕ) = Ideal.span ({t ^ (n : ℕ)} : Set R) := by
    simpa [I] using Ideal.span_singleton_pow (s := t) (n := (n : ℕ))
  have hsource : (Ideal.comap (algebraMap R S) J) ^ (n : ℕ) =
      Ideal.span ({t ^ (n : ℕ)} : Set R) := by
    rw [hcomap, hIpow]
  have htarget : J ^ (n : ℕ) =
      Ideal.map (algebraMap R S) (Ideal.span ({t ^ (n : ℕ)} : Set R)) := by
    simpa [J] using map_span_singleton_pow (algebraMap R S) t (n : ℕ)
  exact
    quotientMap_bijective_of_ideal_eq hsource htarget
      (J.le_comap_pow (algebraMap R S) (n : ℕ)) Ideal.le_comap_map hpow

/-- Helper for Chap10 Lemma 10 146 1: a surjective residue-field map lets one shift a
standard-etale coordinate so that its image has zero residue in the target local ring. -/
private lemma standardEtalePresentation_residueShift
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A)
    (hres : Function.Surjective (ResidueField.map (algebraMap R S))) :
    ∃ r : R, residue S (algebraMap A S (P.x - algebraMap R A r)) = 0 := by
  -- Choose a base residue class mapping to the residue of the standard-etale coordinate in `S`.
  obtain ⟨x, hx⟩ := hres (residue S (algebraMap A S P.x))
  obtain ⟨r, rfl⟩ := residue_surjective x
  refine ⟨r, ?_⟩
  -- After rewriting the chosen residue lift, the shifted coordinate has residue `ξ - ξ`.
  rw [map_sub, map_sub]
  have hscalar : algebraMap A S (algebraMap R A r) = algebraMap R S r := by
    exact (IsScalarTower.algebraMap_apply R A S r).symm
  rw [hscalar]
  rw [ResidueField.map_residue] at hx
  exact sub_eq_zero.mpr hx.symm

/-- Helper for Chap10 Lemma 10 146 1: after a standard-etale coordinate is shifted to have
zero target residue, the corresponding constant term lies in the base maximal ideal. -/
private lemma standardEtalePresentation_eval_mem_maximalIdeal_of_residueShift
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A)
    (hres : Function.Injective (ResidueField.map (algebraMap R S))) {r : R}
    (hshift : residue S (algebraMap A S (P.x - algebraMap R A r)) = 0) :
    P.f.eval r ∈ maximalIdeal R := by
  -- The shifted-coordinate hypothesis says that the target residues of `P.x` and `r` agree.
  have hcoord :
      residue S (algebraMap A S P.x) = residue S (algebraMap R S r) := by
    rw [map_sub] at hshift
    have hscalar : algebraMap A S (algebraMap R A r) = algebraMap R S r := by
      exact (IsScalarTower.algebraMap_apply R A S r).symm
    rw [hscalar] at hshift
    exact sub_eq_zero.mp hshift
  -- Map the source residue of `f(r)` to `S`; the defining relation `f(P.x)=0` kills it.
  have htarget :
      ResidueField.map (algebraMap R S) (residue R (P.f.eval r)) = 0 := by
    rw [ResidueField.map_residue]
    calc
      residue S (algebraMap R S (P.f.eval r))
          = Polynomial.aeval (residue S (algebraMap R S r))
              (P.f.map (algebraMap R (ResidueField S))) := by
            rw [← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval (A := S) r P.f]
            simpa [Polynomial.aeval_map_algebraMap] using
              (Polynomial.aeval_algHom_apply
                (IsScalarTower.toAlgHom R S (ResidueField S)) (algebraMap R S r) P.f).symm
      _ = Polynomial.aeval (residue S (algebraMap A S P.x))
              (P.f.map (algebraMap R (ResidueField S))) := by
            rw [hcoord]
      _ = residue S (algebraMap A S (Polynomial.aeval P.x P.f)) := by
            have h₁ :
                algebraMap A S (Polynomial.aeval P.x P.f) =
                  Polynomial.aeval (algebraMap A S P.x) (P.f.map (algebraMap R S)) := by
              simpa using
                (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom R A S) P.x P.f).symm
            rw [h₁]
            simpa [Polynomial.aeval_map_algebraMap] using
              (Polynomial.aeval_algHom_apply
                (IsScalarTower.toAlgHom R S (ResidueField S)) (algebraMap A S P.x) P.f)
      _ = 0 := by
            rw [P.hasMap.1, map_zero, map_zero]
  -- Injectivity of the residue-field map reflects vanishing back to the base residue field.
  have hsource : residue R (P.f.eval r) = 0 := by
    exact hres (by simpa using htarget)
  exact (residue_eq_zero_iff (R := R) (x := P.f.eval r)).mp hsource

