      residue S (algebraMap R S (P.f.derivative.eval r)) := by
    calc
      residue S (Polynomial.aeval y (q.map (algebraMap R S)))
          = Polynomial.aeval (residue S y) (q.map (algebraMap R (ResidueField S))) := by
            calc
              residue S (Polynomial.aeval y (q.map (algebraMap R S)))
                  = Polynomial.aeval (residue S y) (q.map (algebraMap R S)) := by
                    exact (Polynomial.aeval_algHom_apply
                      (IsScalarTower.toAlgHom S S (ResidueField S)) y
                      (q.map (algebraMap R S))).symm
              _ = Polynomial.aeval (residue S y) (q.map (algebraMap R (ResidueField S))) := by
                    simp [Polynomial.aeval_def, Polynomial.eval₂_map,
                      IsScalarTower.algebraMap_eq R S (ResidueField S)]
      _ = Polynomial.aeval (0 : ResidueField S) (q.map (algebraMap R (ResidueField S))) := by
            rw [hshift]
      _ = residue S (algebraMap R S (P.f.derivative.eval r)) := by
            rw [← Polynomial.coeff_zero_eq_aeval_zero']
            simp [hq_coeff, IsScalarTower.algebraMap_apply R S (ResidueField S)]
  apply (residue_ne_zero_iff_isUnit (R := S)
    (x := Polynomial.aeval y (q.map (algebraMap R S)))).mp
  rw [hres_q]
  exact hderiv_ne

