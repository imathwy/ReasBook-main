/-- Helper for Chap10 Lemma 10 146 1: the standard-etale quotient section sending the coordinate
to the chosen base lift modulo the shifted constant term. -/
private noncomputable def standardEtalePresentationQuotientSection
    {A : Type (max u v)} [CommRing A] [Algebra R A]
    (P : StandardEtalePresentation R A) (r : R) (hg : IsUnit (P.g.eval r)) :
    A →ₐ[R] R ⧸ Ideal.span ({P.f.eval r} : Set R) :=
  (P.P.lift (Ideal.Quotient.mk (Ideal.span ({P.f.eval r} : Set R)) r)
    (standardEtalePresentation_hasMap_quotient_mk_eval (P := P) r hg)).comp
      P.equivRing.toAlgHom

