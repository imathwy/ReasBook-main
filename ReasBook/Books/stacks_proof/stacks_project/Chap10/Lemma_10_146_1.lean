/-- Helper for Chap10 Lemma 10 146 1: the shifted standard-etale coordinate satisfies the
Taylor relation with constant term `P.f.eval r`. -/
private lemma standardEtalePresentation_shiftedCoordinate_mul_divX_add_eval
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A) (r : R) :
    let y : S := algebraMap A S (P.x - algebraMap R A r)
    y * Polynomial.aeval y (((P.f.comp (Polynomial.X + Polynomial.C r)).divX).map (algebraMap R S)) +
        algebraMap R S (P.f.eval r) = 0 := by
  -- Rewrite the shifted expression back to evaluation at the standard coordinate.
  intro y
  have hidentity := shiftedDivX_eval_identity (R := R) (T := S) P.f r y
  have hy : y + algebraMap R S r = algebraMap A S P.x := by
    simp [y, sub_eq_add_neg, add_assoc, IsScalarTower.algebraMap_apply R A S]
  calc
    y * Polynomial.aeval y (((P.f.comp (Polynomial.X + Polynomial.C r)).divX).map (algebraMap R S)) +
        algebraMap R S (P.f.eval r)
        = Polynomial.aeval (y + algebraMap R S r) (P.f.map (algebraMap R S)) := hidentity
    _ = Polynomial.aeval (algebraMap A S P.x) (P.f.map (algebraMap R S)) := by rw [hy]
    _ = algebraMap A S (Polynomial.aeval P.x P.f) := by
      simpa [Polynomial.aeval_map_algebraMap] using
        (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom R A S) P.x P.f)
    _ = 0 := by rw [P.hasMap.1, map_zero]

