/-- Helper for Chap10 Lemma 10 146 1: the shifted `divX` factor records the Taylor expansion
of a polynomial at a chosen base element. -/
private lemma shiftedDivX_eval_identity {T : Type*} [CommRing T] [Algebra R T]
    (p : Polynomial R) (r : R) (y : T) :
    y * Polynomial.aeval y (((p.comp (Polynomial.X + Polynomial.C r)).divX).map (algebraMap R T)) +
        algebraMap R T (p.eval r) =
      Polynomial.aeval (y + algebraMap R T r) (p.map (algebraMap R T)) := by
  -- Apply the standard `X * divX + constant coefficient` identity after mapping to `T`.
  have h := congrArg (fun q : Polynomial R => Polynomial.aeval y (q.map (algebraMap R T)))
    (Polynomial.X_mul_divX_add (p.comp (Polynomial.X + Polynomial.C r)))
  simpa [Polynomial.aeval_add, Polynomial.aeval_mul, Polynomial.aeval_X, Polynomial.aeval_C,
    Polynomial.aeval_comp, Polynomial.aeval_map_algebraMap, Polynomial.coeff_zero_eq_aeval_zero,
    Polynomial.coe_aeval_eq_eval] using h

