/-- Helper for Chap10 Lemma 10 146 1: a section of a chart quotient that inverts the localization
denominators splits the induced quotient map after localizing. -/
private theorem quotientMap_bijective_of_isLocalization_quotientSection_split
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (M : Submonoid A) [IsLocalization M S]
    (I : Ideal R) (σ : A →ₐ[R] R ⧸ I)
    (hunit : ∀ m : M, IsUnit (σ m))
    (hcompat :
      (Ideal.Quotient.mkₐ R (Ideal.map (algebraMap R S) I)).comp
          (IsScalarTower.toAlgHom R A S) =
        (Ideal.quotientMapₐ (Ideal.map (algebraMap R S) I)
          (Algebra.ofId R S) Ideal.le_comap_map).comp σ) :
    Function.Bijective
      ((Ideal.quotientMap (Ideal.map (algebraMap R S) I)
          (algebraMap R S) Ideal.le_comap_map) :
        R ⧸ I →+* S ⧸ Ideal.map (algebraMap R S) I) := by
  -- Extend the quotient section across the localization and then descend it through the target
  -- quotient; the two quotient maps are inverse by localization and quotient extensionality.
  let J : Ideal S := Ideal.map (algebraMap R S) I
  let q : R ⧸ I →ₐ[R] S ⧸ J :=
    Ideal.quotientMapₐ J (Algebra.ofId R S) Ideal.le_comap_map
  let τ : S →ₐ[R] R ⧸ I := IsLocalization.liftAlgHom (M := M) hunit
  have hτ_comp : τ.comp (IsScalarTower.toAlgHom R A S) = σ := by
    ext a
    exact IsLocalization.lift_eq (M := M) (S := S) (g := σ.toRingHom) hunit a
  have hJle : J ≤ RingHom.ker τ.toRingHom := by
    change Ideal.map (algebraMap R S) I ≤ RingHom.ker τ.toRingHom
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    change τ (algebraMap R S r) = 0
    have hτr : τ (algebraMap R S r) = algebraMap R (R ⧸ I) r := τ.commutes r
    rw [hτr]
    simpa [Ideal.Quotient.algebraMap_eq] using
      (Ideal.Quotient.eq_zero_iff_mem (I := I) (a := r)).mpr hr
  let τbar : S ⧸ J →ₐ[R] R ⧸ I :=
    Ideal.Quotient.liftₐ J τ fun s hs ↦ RingHom.mem_ker.mp (hJle hs)
  have hτbar_mk : τbar.comp (Ideal.Quotient.mkₐ R J) = τ := by
    exact Ideal.Quotient.liftₐ_comp J τ fun s hs ↦ RingHom.mem_ker.mp (hJle hs)
  have hleft : τbar.comp q = AlgHom.id R (R ⧸ I) := by
    apply Ideal.Quotient.algHom_ext
    calc
      (τbar.comp q).comp (Ideal.Quotient.mkₐ R I)
          = τbar.comp ((Ideal.Quotient.mkₐ R J).comp (Algebra.ofId R S)) := by
            rw [AlgHom.comp_assoc, Ideal.quotient_map_comp_mkₐ]
      _ = (τbar.comp (Ideal.Quotient.mkₐ R J)).comp (Algebra.ofId R S) := by
            rw [AlgHom.comp_assoc]
      _ = τ.comp (Algebra.ofId R S) := by rw [hτbar_mk]
      _ = Ideal.Quotient.mkₐ R I := by
            exact AlgHom.ext fun r ↦ τ.commutes r
      _ = (AlgHom.id R (R ⧸ I)).comp (Ideal.Quotient.mkₐ R I) := by
            rfl
  have hright : q.comp τbar = AlgHom.id R (S ⧸ J) := by
    apply Ideal.Quotient.algHom_ext
    have hloc : (q.comp τ).comp (IsScalarTower.toAlgHom R A S) =
        (Ideal.Quotient.mkₐ R J).comp (IsScalarTower.toAlgHom R A S) := by
      calc
        (q.comp τ).comp (IsScalarTower.toAlgHom R A S)
            = q.comp (τ.comp (IsScalarTower.toAlgHom R A S)) := by
              rw [AlgHom.comp_assoc]
        _ = q.comp σ := by rw [hτ_comp]
        _ = (Ideal.Quotient.mkₐ R J).comp (IsScalarTower.toAlgHom R A S) := hcompat.symm
    have hqτ : q.comp τ = Ideal.Quotient.mkₐ R J := by
      exact IsLocalization.algHom_ext M hloc
    calc
      (q.comp τbar).comp (Ideal.Quotient.mkₐ R J)
          = q.comp (τbar.comp (Ideal.Quotient.mkₐ R J)) := by
            rw [AlgHom.comp_assoc]
      _ = q.comp τ := by rw [hτbar_mk]
      _ = Ideal.Quotient.mkₐ R J := by rw [hqτ]
      _ = (AlgHom.id R (S ⧸ J)).comp (Ideal.Quotient.mkₐ R J) := by
            rfl
  constructor
  · intro x y hxy
    change q x = q y at hxy
    have hxy' := congrArg τbar hxy
    have hx : τbar (q x) = x := AlgHom.congr_fun hleft x
    have hy : τbar (q y) = y := AlgHom.congr_fun hleft y
    rw [hx, hy] at hxy'
    exact hxy'
  · intro y
    exact ⟨τbar y, by simpa [q] using AlgHom.congr_fun hright y⟩

omit [IsLocalRing R] [IsLocalHom (algebraMap R S)] in
/-- Helper for Chap10 Lemma 10 146 1: an étale algebra is étale at the prime obtained by
pulling back the maximal ideal of the local target. -/
private lemma isEtaleAt_comap_maximalIdeal_of_etale
    {T : Type (max u v)} [CommRing T] [Algebra R T] [Algebra T S]
    [IsScalarTower R T S] [Algebra.Etale R T] :
    Algebra.IsEtaleAt R (Ideal.comap (algebraMap T S) (maximalIdeal S)) := by
  -- Global étaleness makes the étale locus all of `Spec T`, so the pulled-back closed point lies
  -- in it.
  let Q : Ideal T := Ideal.comap (algebraMap T S) (maximalIdeal S)
  haveI : Q.IsPrime := by
    infer_instance
  have hEtaleLocus : Algebra.etaleLocus R T = Set.univ := by
    exact (Algebra.etaleLocus_eq_univ_iff_etale (R := R) (A := T)).mpr inferInstance
  have hmem : (⟨Q, inferInstance⟩ : PrimeSpectrum T) ∈ Algebra.etaleLocus R T := by
    rw [hEtaleLocus]
    exact Set.mem_univ _
  simpa [Q, Algebra.mem_etaleLocus_iff] using hmem

omit [IsLocalRing R] [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)] in
/-- Helper for Chap10 Lemma 10 146 1: if the target already inverts `f`, then it is also the
localization at the supremum of the old denominator submonoid and the powers of `f`. -/
private lemma isLocalization_powers_sup_of_map_unit
    {T : Type*} [CommRing T] [Algebra T S] (M : Submonoid T) [IsLocalization M S]
    {f : T} (hf : IsUnit (algebraMap T S f)) :
    IsLocalization (Submonoid.powers f ⊔ M) S := by
  -- The old localization inverts `M`, and the unit hypothesis inverts every power of `f`.
  apply IsLocalization.of_le M (Submonoid.powers f ⊔ M) le_sup_right
  intro x hx
  rcases Submonoid.mem_sup.mp hx with ⟨y, hy, z, hz, rfl⟩
  have hyunit : IsUnit (algebraMap T S y) := by
    rcases (Submonoid.mem_powers_iff y f).mp hy with ⟨n, rfl⟩
    simpa using hf.pow n
  simpa [map_mul] using hyunit.mul (IsLocalization.map_units S ⟨z, hz⟩)

omit [IsLocalRing R] [IsLocalRing S] [Algebra R S] [IsLocalHom (algebraMap R S)] in
/-- Helper for Chap10 Lemma 10 146 1: a larger localization of the base is a localization of a
smaller localization at the mapped larger submonoid. -/
private lemma exists_isLocalization_map_of_submonoid_le
    {T A B : Type*} [CommRing T] [CommRing A] [CommRing B]
    [Algebra T A] [Algebra T B] (M N : Submonoid T) (hMN : M ≤ N)
    [IsLocalization M A] [IsLocalization N B] :
    ∃ (_ : Algebra A B), ∃ (_ : IsScalarTower T A B),
      IsLocalization (N.map (algebraMap T A)) B := by
  -- Use the canonical algebra structure from localization functoriality, then consume the
  -- localization-of-localization theorem in that instance context.
  letI : Algebra A B := IsLocalization.localizationAlgebraOfSubmonoidLe A B M N hMN
  letI : IsScalarTower T A B :=
    IsLocalization.localization_isScalarTower_of_submonoid_le A B M N hMN
  exact ⟨inferInstance, inferInstance,
    IsLocalization.isLocalization_of_submonoid_le A B M N hMN⟩

omit [IsLocalRing R] [IsLocalHom (algebraMap R S)] in
/-- Helper for Chap10 Lemma 10 146 1: a local target which is a localization of an étale algebra
admits a standard-étale chart whose further localization is the target. -/
private lemma exists_standardEtaleLocalizationChart_at_localTarget
    (het : ∃ (T : Type (max u v)) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra T S)
      (_ : IsScalarTower R T S) (_ : Etale R T) (M : Submonoid T), IsLocalization M S) :
    ∃ (A : Type (max u v)) (_ : CommRing A) (_ : Algebra R A) (_ : Algebra A S)
        (_ : IsScalarTower R A S), Algebra.IsStandardEtale R A ∧
          ∃ M : Submonoid A, IsLocalization M S := by
  -- Unpack the raw étale-localization witness and work at the closed point of the local target.
  obtain ⟨T, hTcomm, hRT, hTS, hRTS, hEt, M, hLoc⟩ := het
  letI : CommRing T := hTcomm
  letI : Algebra R T := hRT
  letI : Algebra T S := hTS
  letI : IsScalarTower R T S := hRTS
  letI : Etale R T := hEt
  letI : IsLocalization M S := hLoc
  let Q : Ideal T := Ideal.comap (algebraMap T S) (maximalIdeal S)
  haveI : Q.IsPrime := by
    infer_instance
  have hEtaleAt : Algebra.IsEtaleAt R Q := by
    exact isEtaleAt_comap_maximalIdeal_of_etale (R := R) (S := S) (T := T)
  haveI : Algebra.IsEtaleAt R Q := hEtaleAt
  obtain ⟨f, hfQ, hStd⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := R) Q
  -- Since `f` misses the pulled-back maximal ideal, its image is a unit in the local target.
  have hfS_notMem : algebraMap T S f ∉ maximalIdeal S := by
    intro hfS
    have hfQ_mem : f ∈ Q := by
      simpa [Q, Ideal.mem_comap] using hfS
    exact hfQ hfQ_mem
  have hfS_unit : IsUnit (algebraMap T S f) := by
    exact notMem_maximalIdeal.mp hfS_notMem
  let N : Submonoid T := Submonoid.powers f ⊔ M
  have hLocN : IsLocalization N S := by
    exact isLocalization_powers_sup_of_map_unit (S := S) M hfS_unit
  -- Localize the standard-étale basic open further by the enlarged denominator submonoid.
  let A : Type (max u v) := Localization.Away f
  haveI : IsLocalization N S := hLocN
  obtain ⟨hAS, hTAS, hLocAS⟩ :=
    exists_isLocalization_map_of_submonoid_le
      (T := T) (A := A) (B := S) (Submonoid.powers f) N le_sup_left
  letI : Algebra A S := hAS
  letI : IsScalarTower T A S := hTAS
  have hRTA : IsScalarTower R T A := by
    infer_instance
  letI : IsScalarTower R T A := hRTA
  have hRAS : IsScalarTower R A S := by
    refine IsScalarTower.of_algebraMap_eq fun r ↦ ?_
    calc
      algebraMap R S r = algebraMap T S (algebraMap R T r) :=
        IsScalarTower.algebraMap_apply R T S r
      _ = algebraMap A S (algebraMap T A (algebraMap R T r)) := by
        exact IsScalarTower.algebraMap_apply T A S (algebraMap R T r)
      _ = algebraMap A S (algebraMap R A r) := by
        rw [← IsScalarTower.algebraMap_apply R T A r]
  exact ⟨A, inferInstance, inferInstance, hAS, hRAS, hStd,
    N.map (algebraMap T A), hLocAS⟩

/-- Helper for Chap10 Lemma 10 146 1: the local étale localization and residue-field isomorphism
produce a principal first-order quotient isomorphism. -/
private theorem exists_bijective_quotientMap_span_singleton_of_etaleLocalization_residueField
    (het : ∃ (T : Type (max u v)) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra T S)
      (_ : IsScalarTower R T S) (_ : Etale R T) (M : Submonoid T), IsLocalization M S)
    (hres : Function.Bijective (ResidueField.map (algebraMap R S))) :
    ∃ t ∈ maximalIdeal R,
      Function.Bijective
        ((Ideal.quotientMap
            (Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R)))
            (algebraMap R S) Ideal.le_comap_map) :
          R ⧸ Ideal.span ({t} : Set R) →+*
            S ⧸ Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R))) := by
  -- Route correction: extract the chart by shrinking the original étale algebra at the closed
  -- point and then composing localizations, rather than proving a separate chart quotient theorem.
  obtain ⟨A, hAcomm, hRA, hAS, hTower, hStd, M, hLoc⟩ :
      ∃ (A : Type (max u v)) (_ : CommRing A) (_ : Algebra R A) (_ : Algebra A S)
        (_ : IsScalarTower R A S), Algebra.IsStandardEtale R A ∧
          ∃ M : Submonoid A, IsLocalization M S := by
    exact exists_standardEtaleLocalizationChart_at_localTarget het
  letI : CommRing A := hAcomm
  letI : Algebra R A := hRA
  letI : Algebra A S := hAS
  letI : IsScalarTower R A S := hTower
  letI : Algebra.IsStandardEtale R A := hStd
  letI : IsLocalization M S := hLoc
  -- Choose a standard-etale presentation and shift the coordinate to have zero target residue.
  let P : StandardEtalePresentation R A :=
    Algebra.IsStandardEtale.nonempty_standardEtalePresentation.some
  obtain ⟨r, hshift⟩ := standardEtalePresentation_residueShift (S := S) P hres.2
  let t : R := P.f.eval r
  have ht : t ∈ maximalIdeal R := by
    exact standardEtalePresentation_eval_mem_maximalIdeal_of_residueShift
      (S := S) P hres.1 hshift
  have hg : IsUnit (P.g.eval r) := by
    exact standardEtalePresentation_eval_g_isUnit_of_residueShift (S := S) P hshift
  have hmem : algebraMap A S (P.x - algebraMap R A r) ∈
      Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R)) := by
    exact standardEtalePresentation_shiftedCoordinate_mem_map_span_eval_of_residueShift
      (S := S) P hshift
  -- The quotient section agrees with the chart map after passing to the target quotient.
  have hcompat :
      (Ideal.Quotient.mkₐ R
        (Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R)))).comp
          (IsScalarTower.toAlgHom R A S) =
        (Ideal.quotientMapₐ
          (Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R)))
          (Algebra.ofId R S) Ideal.le_comap_map).comp
            (standardEtalePresentationQuotientSection (P := P) r hg) := by
    simpa [t] using
      standardEtalePresentation_quotientSection_comp_quotientMap
        (S := S) P r hg hmem
  have hunit : ∀ m : M,
      IsUnit (standardEtalePresentationQuotientSection (P := P) r hg m) := by
    -- Denominators are units in `S`, hence units after the quotient section by residue reflection.
    intro m
    exact standardEtalePresentation_quotientSection_maps_units_of_target_unit
      (S := S) P (by simpa [t] using ht) hg hshift hres.2 m
      (IsLocalization.map_units S m)
  have hfirst :
      Function.Bijective
        ((Ideal.quotientMap
            (Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R)))
            (algebraMap R S) Ideal.le_comap_map) :
          R ⧸ Ideal.span ({t} : Set R) →+*
            S ⧸ Ideal.map (algebraMap R S) (Ideal.span ({t} : Set R))) := by
    exact quotientMap_bijective_of_isLocalization_quotientSection_split
      (S := S) M (Ideal.span ({t} : Set R))
      (standardEtalePresentationQuotientSection (P := P) r hg) hunit hcompat
  exact ⟨t, ht, hfirst⟩

/- Domain-style sampling:
- primary domain: local étale commutative algebra, residue-field comparison, and quotient maps
  modulo powers of a principal ideal;
- sampled owner declarations of the same kind:
  `Algebra.Etale`,
  `ResidueField.map`,
  `Ideal.quotientMap`,
  `Ideal.span_singleton_pow`;
- best owner abstraction: the local existence theorem here is `source-facing`, but the induced map
  on quotients is already owned canonically by `Ideal.quotientMap`, so the theorem should use that
  owner directly rather than introduce a separate local wrapper; `Ideal.span_singleton_pow` is only
  the simplification bridge identifying powers of a principal ideal with the ideal generated by the
  corresponding power;
- primitive data: the local map `R → S`, the filtered-colimit-of-étale witness, the residue-field
  bijection, and the chosen element `t ∈ maximalIdeal R`;
- derived API: the reduction map `R / (t^n) → S / (t^n)` for each positive `n`, expressed directly
  by the canonical owner `Ideal.quotientMap`.

Source/core/bridge triage:
- `source-facing`: the existential statement producing `t`;
- `core/canonical`: `Algebra.Etale`, `ResidueField.map`, and `Ideal.quotientMap`;
- `bridge/view`: the quotient map modulo `Ideal.span ({t ^ n} : Set R)`.
-/

-- Proof sketch: choose an étale `R`-algebra `T` whose localization is `S`, shrink to a standard
-- étale presentation, and use the residue-field bijection to move the closed point to `x = 0`.
-- Taking `t` to be the constant term of the defining polynomial makes `T / tT` a quotient of
-- `R / tR`; surjectivity for all powers follows from the mod-`t` case, while injectivity comes
-- from faithful flatness of the induced local quotient maps.

/-- Chap10 Lemma 10 146 1: if `R → S` is a local homomorphism of local rings, `S` is a
localization of an étale `R`-algebra, and the induced map on residue fields is bijective, then there exists
`t ∈ maximalIdeal R` such that for every positive integer `n` the natural map
`R / (t^n) → S / (t^n)` is bijective. -/
@[stacks 0GSD]
theorem exists_maximalIdealElement_forall_bijective_powQuotientMap
    (het : ∃ (T : Type (max u v)) (_ : CommRing T) (_ : Algebra R T) (_ : Algebra T S)
      (_ : IsScalarTower R T S) (_ : Etale R T) (M : Submonoid T), IsLocalization M S)
    (hres : Function.Bijective (ResidueField.map (algebraMap R S))) :
    ∃ t ∈ maximalIdeal R, ∀ n : ℕ+,
      Function.Bijective
        ((Ideal.quotientMap
            (Ideal.map (algebraMap R S) (Ideal.span ({t ^ (n : ℕ)} : Set R)))
            (algebraMap R S) Ideal.le_comap_map) :
          R ⧸ Ideal.span ({t ^ (n : ℕ)} : Set R) →+*
            S ⧸ Ideal.map (algebraMap R S) (Ideal.span ({t ^ (n : ℕ)} : Set R))) := by
  -- First isolate the formal-étale input from the localization-of-étale hypothesis.
  have hfe : RingHom.FormallyEtale (algebraMap R S) :=
    formallyEtale_of_exists_etaleLocalization het
  -- The source-level standard-étale argument supplies the principal first quotient.
  obtain ⟨t, ht, hfirst⟩ :=
    exists_bijective_quotientMap_span_singleton_of_etaleLocalization_residueField het hres
  refine ⟨t, ht, ?_⟩
  -- Formal étaleness upgrades the first quotient isomorphism to all positive powers.
  exact powQuotientMap_bijective_of_formallyEtale_firstQuotient t hfe hfirst

end

