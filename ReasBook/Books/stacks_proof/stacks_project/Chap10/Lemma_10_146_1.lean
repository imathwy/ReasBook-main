/-- Helper for Chap10 Lemma 10 146 1: the shifted linear `divX` factor is a unit after the
coordinate has zero residue. -/
private lemma standardEtalePresentation_shiftedLinearFactor_isUnit
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A) {r : R}
    (hshift : residue S (algebraMap A S (P.x - algebraMap R A r)) = 0) :
    IsUnit (Polynomial.aeval (algebraMap A S (P.x - algebraMap R A r))
      (((P.f.comp (Polynomial.X + Polynomial.C r)).divX).map (algebraMap R S))) := by
  -- The residue of the factor is the residue of `f'` at `r`, identified with the unit
  -- derivative at the standard coordinate.
  let y : S := algebraMap A S (P.x - algebraMap R A r)
  let q : Polynomial R := (P.f.comp (Polynomial.X + Polynomial.C r)).divX
  have hcoord : residue S (algebraMap A S P.x) = residue S (algebraMap R S r) := by
    rw [map_sub] at hshift
    have hscalar : algebraMap A S (algebraMap R A r) = algebraMap R S r := by
      exact (IsScalarTower.algebraMap_apply R A S r).symm
    rw [hscalar] at hshift
    exact sub_eq_zero.mp hshift
  have hderiv_res :
      residue S (algebraMap R S (P.f.derivative.eval r)) =
        residue S (algebraMap A S (Polynomial.aeval P.x P.f.derivative)) := by
    calc
      residue S (algebraMap R S (P.f.derivative.eval r))
          = Polynomial.aeval (residue S (algebraMap R S r))
              (P.f.derivative.map (algebraMap R (ResidueField S))) := by
            rw [← Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval (A := S) r P.f.derivative]
            simpa [Polynomial.aeval_map_algebraMap] using
              (Polynomial.aeval_algHom_apply
                (IsScalarTower.toAlgHom R S (ResidueField S)) (algebraMap R S r)
                P.f.derivative).symm
      _ = Polynomial.aeval (residue S (algebraMap A S P.x))
              (P.f.derivative.map (algebraMap R (ResidueField S))) := by
            rw [hcoord]
      _ = residue S (algebraMap A S (Polynomial.aeval P.x P.f.derivative)) := by
            have h₁ :
                algebraMap A S (Polynomial.aeval P.x P.f.derivative) =
                  Polynomial.aeval (algebraMap A S P.x)
                    (P.f.derivative.map (algebraMap R S)) := by
              simpa using
                (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom R A S) P.x
                  P.f.derivative).symm
            rw [h₁]
            simpa [Polynomial.aeval_map_algebraMap] using
              (Polynomial.aeval_algHom_apply
                (IsScalarTower.toAlgHom R S (ResidueField S)) (algebraMap A S P.x)
                P.f.derivative)
  have hderiv_ne : residue S (algebraMap R S (P.f.derivative.eval r)) ≠ 0 := by
    have hunit : IsUnit (algebraMap A S (Polynomial.aeval P.x P.f.derivative)) :=
      (P.hasMap.isUnit_derivative_f).map (IsScalarTower.toAlgHom R A S)
    have htarget_ne : residue S (algebraMap A S (Polynomial.aeval P.x P.f.derivative)) ≠ 0 :=
      (residue_ne_zero_iff_isUnit (R := S)
        (x := algebraMap A S (Polynomial.aeval P.x P.f.derivative))).mpr hunit
    rwa [hderiv_res]
  have hq_coeff : q.coeff 0 = P.f.derivative.eval r := by
    change ((P.f.comp (Polynomial.X + Polynomial.C r)).divX).coeff 0 = P.f.derivative.eval r
    rw [Polynomial.coeff_divX]
    simpa [Polynomial.taylor_apply] using (Polynomial.taylor_coeff_one (r := r) (f := P.f))
