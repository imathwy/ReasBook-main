/-- Helper for Chap10 Lemma 10 146 1: evaluation at `r` gives a valid map from the standard
etale pair to the quotient by the shifted constant term. -/
private lemma standardEtalePresentation_hasMap_quotient_mk_eval
    {A : Type (max u v)} [CommRing A] [Algebra R A]
    (P : StandardEtalePresentation R A) (r : R) (hg : IsUnit (P.g.eval r)) :
    P.P.HasMap (Ideal.Quotient.mk (Ideal.span ({P.f.eval r} : Set R)) r) := by
  constructor
  · -- The defining polynomial vanishes because its value is the generator of the quotient ideal.
    change (Polynomial.aeval ((algebraMap R (R ⧸ Ideal.span ({P.f.eval r} : Set R))) r)) P.f = 0
    rw [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval, Ideal.Quotient.algebraMap_eq]
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self (P.f.eval r)
  · -- The denominator remains a unit after applying the quotient map.
    change IsUnit ((Polynomial.aeval
      ((algebraMap R (R ⧸ Ideal.span ({P.f.eval r} : Set R))) r)) P.g)
    rw [Polynomial.aeval_algebraMap_apply_eq_algebraMap_eval]
    exact hg.map (Ideal.Quotient.mkₐ R (Ideal.span ({P.f.eval r} : Set R)))

