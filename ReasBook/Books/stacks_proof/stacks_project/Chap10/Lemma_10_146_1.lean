/-- Helper for Chap10 Lemma 10 146 1: after mapping to the target quotient, the standard-etale
quotient section agrees with the original chart map. -/
private lemma standardEtalePresentation_quotientSection_comp_quotientMap
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A) (r : R)
    (hg : IsUnit (P.g.eval r))
    (hmem : algebraMap A S (P.x - algebraMap R A r) ∈
      Ideal.map (algebraMap R S) (Ideal.span ({P.f.eval r} : Set R))) :
    (Ideal.Quotient.mkₐ R
      (Ideal.map (algebraMap R S) (Ideal.span ({P.f.eval r} : Set R)))).comp
        (IsScalarTower.toAlgHom R A S) =
      (Ideal.quotientMapₐ
        (Ideal.map (algebraMap R S) (Ideal.span ({P.f.eval r} : Set R)))
        (Algebra.ofId R S) Ideal.le_comap_map).comp
          (standardEtalePresentationQuotientSection (P := P) r hg) := by
  -- The presentation is generated by `x`, so it suffices to compare the two maps there.
  apply P.hom_ext
  have hxzero :
      Ideal.Quotient.mk (Ideal.map (algebraMap R S) (Ideal.span ({P.f.eval r} : Set R)))
        (algebraMap A S (P.x - algebraMap R A r)) = 0 := by
    rwa [Ideal.Quotient.eq_zero_iff_mem]
  have hxeq :
      Ideal.Quotient.mk (Ideal.map (algebraMap R S) (Ideal.span ({P.f.eval r} : Set R)))
        (algebraMap A S P.x) =
      Ideal.Quotient.mk (Ideal.map (algebraMap R S) (Ideal.span ({P.f.eval r} : Set R)))
        (algebraMap R S r) := by
    -- The shifted coordinate is zero in the quotient, so `x` and `r` have the same class.
    rw [← sub_eq_zero]
    rw [← map_sub]
    rw [← hxzero]
    congr 1
    simp [IsScalarTower.algebraMap_apply R A S]
  simpa [standardEtalePresentationQuotientSection_x, Ideal.quotient_map_mkₐ,
    AlgHom.comp_apply] using hxeq

/-- Helper for Chap10 Lemma 10 146 1: a principal ideal generated by an element of the maximal
ideal maps to zero in the target residue field. -/
private lemma spanSingleton_le_ker_targetResidue (t : R) (ht : t ∈ maximalIdeal R) :
    Ideal.span ({t} : Set R) ≤
      RingHom.ker (Algebra.ofId R (ResidueField S)).toRingHom := by
  -- The generator maps into the target maximal ideal, hence has zero target residue.
  rw [Ideal.span_le]
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst x
  change algebraMap R (ResidueField S) t = 0
  rw [IsScalarTower.algebraMap_apply R S (ResidueField S)]
  exact (residue_eq_zero_iff (R := S) (x := algebraMap R S t)).mpr
    (map_nonunit (algebraMap R S) t ht)

/-- Helper for Chap10 Lemma 10 146 1: quotienting by a principal ideal inside the maximal ideal
gives a nontrivial quotient. -/
private lemma spanSingleton_quotient_nontrivial (t : R) (ht : t ∈ maximalIdeal R) :
    Nontrivial (R ⧸ Ideal.span ({t} : Set R)) := by
  -- If the principal ideal were the whole ring, the maximal ideal would contain `1`.
  refine Ideal.Quotient.nontrivial_iff.mpr ?_
  intro htop
  have hle : Ideal.span ({t} : Set R) ≤ maximalIdeal R := by
    rw [Ideal.span_le]
    intro x hx
    rwa [Set.mem_singleton_iff.mp hx]
  have hmax_top : maximalIdeal R = ⊤ := by
    apply le_antisymm le_top
    intro x _
    exact hle (by simpa [htop])
  exact (maximalIdeal.isMaximal R).ne_top hmax_top

/-- Helper for Chap10 Lemma 10 146 1: quotienting by a principal ideal inside the maximal ideal
preserves locality. -/
private lemma spanSingleton_quotient_isLocalRing (t : R) (ht : t ∈ maximalIdeal R) :
    IsLocalRing (R ⧸ Ideal.span ({t} : Set R)) := by
  -- The quotient map is surjective, so locality descends once the quotient is nontrivial.
  haveI : Nontrivial (R ⧸ Ideal.span ({t} : Set R)) :=
    spanSingleton_quotient_nontrivial t ht
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span ({t} : Set R)))
    Ideal.Quotient.mk_surjective

/-- Helper for Chap10 Lemma 10 146 1: the quotient by a chosen principal ideal maps canonically
to the target residue field. -/
private noncomputable def spanSingletonQuotientToTargetResidue (t : R)
    (ht : t ∈ maximalIdeal R) :
    R ⧸ Ideal.span ({t} : Set R) →ₐ[R] ResidueField S :=
  Ideal.Quotient.liftₐ (Ideal.span ({t} : Set R))
    (Algebra.ofId R (ResidueField S))
    (spanSingleton_le_ker_targetResidue (S := S) t ht)

/-- Helper for Chap10 Lemma 10 146 1: the quotient-to-target-residue map sends a quotient class
to the target residue of the corresponding base element. -/
private lemma spanSingletonQuotientToTargetResidue_mk (t r : R)
    (ht : t ∈ maximalIdeal R) :
    spanSingletonQuotientToTargetResidue (S := S) t ht
      (Ideal.Quotient.mk (Ideal.span ({t} : Set R)) r) =
        residue S (algebraMap R S r) := by
  -- This is the defining computation rule for the quotient lift.
  simp [spanSingletonQuotientToTargetResidue,
    IsScalarTower.algebraMap_apply R S (ResidueField S)]

/-- Helper for Chap10 Lemma 10 146 1: surjectivity on residue fields makes the
quotient-to-target-residue map surjective. -/
private lemma spanSingletonQuotientToTargetResidue_surjective (t : R)
    (ht : t ∈ maximalIdeal R)
    (hres : Function.Surjective (ResidueField.map (algebraMap R S))) :
    Function.Surjective (spanSingletonQuotientToTargetResidue (S := S) t ht) := by
  -- Lift a target residue class first to the source residue field and then to an element of `R`.
  intro y
  obtain ⟨x, hx⟩ := hres y
  obtain ⟨r, rfl⟩ := residue_surjective x
  refine ⟨Ideal.Quotient.mk (Ideal.span ({t} : Set R)) r, ?_⟩
  simpa [spanSingletonQuotientToTargetResidue_mk] using hx

/-- Helper for Chap10 Lemma 10 146 1: the quotient-to-target-residue map is local. -/
private lemma spanSingletonQuotientToTargetResidue_isLocalHom (t : R)
    (ht : t ∈ maximalIdeal R)
    (hres : Function.Surjective (ResidueField.map (algebraMap R S))) :
    IsLocalHom (spanSingletonQuotientToTargetResidue (S := S) t ht).toRingHom := by
  -- A surjective homomorphism out of a local quotient is local.
  haveI : Nontrivial (R ⧸ Ideal.span ({t} : Set R)) :=
    spanSingleton_quotient_nontrivial t ht
  haveI : IsLocalRing (R ⧸ Ideal.span ({t} : Set R)) :=
    spanSingleton_quotient_isLocalRing t ht
  exact IsLocalHom.of_surjective
    (spanSingletonQuotientToTargetResidue (S := S) t ht).toRingHom
    (spanSingletonQuotientToTargetResidue_surjective (S := S) t ht hres)

/-- Helper for Chap10 Lemma 10 146 1: the standard-etale quotient section has the same target
residue as the original chart map. -/
private lemma standardEtalePresentation_quotientSection_comp_targetResidue
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A) {r : R}
    (ht : P.f.eval r ∈ maximalIdeal R) (hg : IsUnit (P.g.eval r))
    (hshift : residue S (algebraMap A S (P.x - algebraMap R A r)) = 0) :
    (spanSingletonQuotientToTargetResidue (S := S) (P.f.eval r) ht).comp
        (standardEtalePresentationQuotientSection (P := P) r hg) =
      (IsScalarTower.toAlgHom R S (ResidueField S)).comp
        (IsScalarTower.toAlgHom R A S) := by
  -- The presentation is generated by `x`; the shifted-coordinate residue equation compares
  -- the two possible images of that generator.
  apply P.hom_ext
  have hcoord :
      residue S (algebraMap A S P.x) = residue S (algebraMap R S r) := by
    rw [map_sub] at hshift
    have hscalar : algebraMap A S (algebraMap R A r) = algebraMap R S r := by
      exact (IsScalarTower.algebraMap_apply R A S r).symm
    rw [hscalar] at hshift
    exact sub_eq_zero.mp hshift
  simpa [AlgHom.comp_apply, standardEtalePresentationQuotientSection_x,
    spanSingletonQuotientToTargetResidue_mk] using hcoord.symm

/-- Helper for Chap10 Lemma 10 146 1: a chart element which is a unit after mapping to the
target is already a unit after applying the standard-etale quotient section. -/
private lemma standardEtalePresentation_quotientSection_maps_units_of_target_unit
    {A : Type (max u v)} [CommRing A] [Algebra R A] [Algebra A S]
    [IsScalarTower R A S] (P : StandardEtalePresentation R A) {r : R}
    (ht : P.f.eval r ∈ maximalIdeal R) (hg : IsUnit (P.g.eval r))
    (hshift : residue S (algebraMap A S (P.x - algebraMap R A r)) = 0)
    (hres : Function.Surjective (ResidueField.map (algebraMap R S)))
    (a : A) (ha : IsUnit (algebraMap A S a)) :
    IsUnit (standardEtalePresentationQuotientSection (P := P) r hg a) := by
  -- Reflect units through the local quotient-to-residue map after comparing target residues.
  haveI : Nontrivial (R ⧸ Ideal.span ({P.f.eval r} : Set R)) :=
    spanSingleton_quotient_nontrivial (P.f.eval r) ht
  haveI : IsLocalRing (R ⧸ Ideal.span ({P.f.eval r} : Set R)) :=
    spanSingleton_quotient_isLocalRing (P.f.eval r) ht
  haveI : IsLocalHom
      (spanSingletonQuotientToTargetResidue (S := S) (P.f.eval r) ht).toRingHom :=
    spanSingletonQuotientToTargetResidue_isLocalHom (S := S) (P.f.eval r) ht hres
  have hcomp :=
    standardEtalePresentation_quotientSection_comp_targetResidue
      (S := S) P ht hg hshift
  have htargetUnit :
      IsUnit ((spanSingletonQuotientToTargetResidue (S := S) (P.f.eval r) ht)
        (standardEtalePresentationQuotientSection (P := P) r hg a)) := by
    have hunit_res :
        IsUnit ((IsScalarTower.toAlgHom R S (ResidueField S))
          (algebraMap A S a)) :=
      ha.map (IsScalarTower.toAlgHom R S (ResidueField S)).toRingHom
    have happ :
        (spanSingletonQuotientToTargetResidue (S := S) (P.f.eval r) ht)
          (standardEtalePresentationQuotientSection (P := P) r hg a) =
        (IsScalarTower.toAlgHom R S (ResidueField S)) (algebraMap A S a) := by
      simpa [AlgHom.comp_apply] using
        congrArg (fun F : A →ₐ[R] ResidueField S => F a) hcomp
    rwa [happ]
  exact isUnit_of_map_unit
    (spanSingletonQuotientToTargetResidue (S := S) (P.f.eval r) ht).toRingHom
    (standardEtalePresentationQuotientSection (P := P) r hg a) htargetUnit

