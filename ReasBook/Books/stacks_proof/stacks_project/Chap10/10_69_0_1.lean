/-- Helper for Chap10 10 69 0 1: the list-generated ideal is generated by the indexed entries
of the list. -/
theorem idealOfList_eq_span_get (rs : List R) :
    Ideal.ofList rs = Ideal.span (Set.range fun i : Fin rs.length => rs.get i) := by
  -- Compare the two generating sets using the standard list membership/get equivalence.
  change Ideal.span ({r : R | r ∈ rs}) =
    Ideal.span (Set.range fun i : Fin rs.length => rs.get i)
  congr 1
  ext r
  constructor
  · intro hr
    rcases (List.mem_iff_get.mp hr) with ⟨i, hi⟩
    exact ⟨i, hi⟩
  · rintro ⟨i, rfl⟩
    exact List.get_mem rs i

/-- Helper for Chap10 10 69 0 1: a power of the list-generated ideal is contained in the span of
monomial weights of matching total degree. -/
theorem quasiRegularIdeal_pow_le_span_monomialWeights (rs : List R) (n : ℕ) :
    (quasiRegularIdeal rs) ^ n ≤
      Ideal.span (Set.range fun e : {e : Fin rs.length →₀ ℕ // quasiRegularTotalDegree e = n} =>
        quasiRegularAssociatedGradedMonomialWeight rs e.1) := by
  -- Use the homogeneous-polynomial description of powers of a finitely generated ideal.
  rw [quasiRegularIdeal, idealOfList_eq_span_get]
  intro y hy
  rcases (Ideal.mem_span_pow_iff_exists_isHomogeneous
      (x := fun i : Fin rs.length => rs.get i) (n := n) (y := y)).1 hy with ⟨p, hp, hpy⟩
  rw [← hpy]
  rw [MvPolynomial.as_sum p]
  simp only [map_sum, MvPolynomial.eval_monomial]
  refine Ideal.sum_mem _ fun d hd => ?_
  have hddeg : quasiRegularTotalDegree d = n := by
    by_contra hdn
    have hcoeff : MvPolynomial.coeff d p = 0 := hp.coeff_eq_zero hdn
    exact (Finsupp.mem_support_iff.mp hd) hcoeff
  have hgen : quasiRegularAssociatedGradedMonomialWeight rs d ∈
      Ideal.span (Set.range fun e : {e : Fin rs.length →₀ ℕ // quasiRegularTotalDegree e = n} =>
        quasiRegularAssociatedGradedMonomialWeight rs e.1) :=
    Ideal.subset_span ⟨⟨d, hddeg⟩, rfl⟩
  have hprod : d.prod (fun i e => rs.get i ^ e) =
      quasiRegularAssociatedGradedMonomialWeight rs d := by
    rw [Finsupp.prod_fintype]
    · rfl
    · intro i
      simp
  rw [hprod]
  exact Ideal.mul_mem_left _ (MvPolynomial.coeff d p) hgen

/-- Helper for Chap10 10 69 0 1: a monomial weight with prescribed total degree sends module
elements to that filtration stage. -/
theorem quasiRegularAssociatedGradedMonomialWeight_smul_mem_of_totalDegree
    {M : Type v} [AddCommGroup M] [Module R M]
    (rs : List R) {n : ℕ} (e : Fin rs.length →₀ ℕ)
    (hdeg : quasiRegularTotalDegree e = n) (m : M) :
    quasiRegularAssociatedGradedMonomialWeight rs e • m ∈ quasiRegularStage rs M n := by
  -- Transport the existing degree-`|e|` membership along the supplied equality of degrees.
  rw [← hdeg]
  exact quasiRegularAssociatedGradedMonomialWeight_smul_mem rs e m

/-- Helper for Chap10 10 69 0 1: the monomial-weight span is contained in the matching
filtration stage. -/
theorem quasiRegularMonomialWeight_smul_span_le_stage
    {M : Type v} [AddCommGroup M] [Module R M] (rs : List R) (n : ℕ) :
    Submodule.span R (Set.range fun em :
        {e : Fin rs.length →₀ ℕ // quasiRegularTotalDegree e = n} × M =>
          quasiRegularAssociatedGradedMonomialWeight rs em.1.1 • em.2) ≤
      quasiRegularStage rs M n := by
  -- Each generator has total degree `n`, and stages are submodules.
  refine Submodule.span_le.mpr ?_
  rintro y ⟨em, rfl⟩
  exact quasiRegularAssociatedGradedMonomialWeight_smul_mem_of_totalDegree
    (M := M) rs em.1.1 em.1.2 em.2

/-- Helper for Chap10 10 69 0 1: stage elements are spanned by monomial weights of matching total
degree acting on module elements. -/
theorem quasiRegularStage_le_monomialWeight_smul_span
    {M : Type v} [AddCommGroup M] [Module R M] (rs : List R) (n : ℕ) :
    quasiRegularStage rs M n ≤
      Submodule.span R (Set.range fun em :
        {e : Fin rs.length →₀ ℕ // quasiRegularTotalDegree e = n} × M =>
          quasiRegularAssociatedGradedMonomialWeight rs em.1.1 • em.2) := by
  -- Transfer the ideal-power spanning statement through scalar multiplication by the whole module.
  intro x hx
  have hxpow : x ∈ ((quasiRegularIdeal rs) ^ n) • (⊤ : Submodule R M) := by
    simpa [quasiRegularStage, idealAssociatedGradedStage] using hx
  have hxspanIdeal : x ∈
      (Ideal.span (Set.range fun e : {e : Fin rs.length →₀ ℕ // quasiRegularTotalDegree e = n} =>
        quasiRegularAssociatedGradedMonomialWeight rs e.1)) • (⊤ : Submodule R M) :=
    Submodule.smul_mono (quasiRegularIdeal_pow_le_span_monomialWeights rs n) le_rfl hxpow
  rw [Submodule.span_smul_eq] at hxspanIdeal
  refine Submodule.set_smul_inductionOn
    (motive := fun y _ => y ∈ Submodule.span R (Set.range fun em :
        {e : Fin rs.length →₀ ℕ // quasiRegularTotalDegree e = n} × M =>
          quasiRegularAssociatedGradedMonomialWeight rs em.1.1 • em.2))
    x hxspanIdeal ?_ ?_ ?_ ?_
  · intro r m hr hm
    rcases hr with ⟨e, rfl⟩
    exact Submodule.subset_span ⟨(e, m), rfl⟩
  · intro r m hm ih
    exact Submodule.smul_mem _ r ih
  · intro m₁ m₂ hm₁ hm₂ ih₁ ih₂
    exact Submodule.add_mem _ ih₁ ih₂
  · exact Submodule.zero_mem _

/-- Helper for Chap10 10 69 0 1: every homogeneous generator of the internal associated graded
has a preimage under the auxiliary base-change map. -/
theorem quasiRegularSequenceAssociatedGradedMapAux_lof_of_stage
    (N : Type v) [AddCommGroup N] [Module R N] (rs : List R)
    (n : ℕ) (x : quasiRegularStage rs N n) :
    ∃ t : TensorProduct (R ⧸ Ideal.ofList rs)
      (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
      (N ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R N)),
      quasiRegularSequenceAssociatedGradedMapAux N rs t =
        DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
          (quasiRegularAssociatedGradedInternalPiece rs N) n
          (Submodule.Quotient.mk x) := by
  let s : Set N := Set.range fun em :
      {e : Fin rs.length →₀ ℕ // quasiRegularTotalDegree e = n} × N =>
        quasiRegularAssociatedGradedMonomialWeight rs em.1.1 • em.2
  have hspan : (x : N) ∈ Submodule.span R s := by
    exact quasiRegularStage_le_monomialWeight_smul_span (M := N) rs n x.2
  have hspan_le_stage : Submodule.span R s ≤ quasiRegularStage rs N n := by
    simpa [s] using quasiRegularMonomialWeight_smul_span_le_stage (M := N) rs n
  -- Induct over the monomial-weight span, building explicit tensor preimages term by term.
  refine Submodule.closure_induction
    (s := s)
    (p := fun y hy => ∀ hstage : y ∈ quasiRegularStage rs N n,
      ∃ t : TensorProduct (R ⧸ Ideal.ofList rs)
        (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))
        (N ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R N)),
        quasiRegularSequenceAssociatedGradedMapAux N rs t =
          DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
            (quasiRegularAssociatedGradedInternalPiece rs N) n
            (Submodule.Quotient.mk
              (⟨y, hstage⟩ : quasiRegularStage rs N n)))
    ?_ ?_ ?_ hspan x.2
  · intro hstage
    refine ⟨0, ?_⟩
    rw [map_zero]
    rw [← (DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
      (quasiRegularAssociatedGradedInternalPiece rs N) n).map_zero]
    rfl
  · intro y z hy hz ihy ihz hstage
    have hystage : y ∈ quasiRegularStage rs N n := hspan_le_stage hy
    have hzstage : z ∈ quasiRegularStage rs N n := hspan_le_stage hz
    rcases ihy hystage with ⟨ty, hty⟩
    rcases ihz hzstage with ⟨tz, htz⟩
    refine ⟨ty + tz, ?_⟩
    rw [map_add, hty, htz]
    rw [← (DirectSum.lof (R ⧸ Ideal.ofList rs) ℕ
      (quasiRegularAssociatedGradedInternalPiece rs N) n).map_add]
    rfl
  · intro r y hy hstage
    rcases hy with ⟨em, rfl⟩
    rcases em with ⟨⟨e, hdeg⟩, m⟩
    cases hdeg
    refine ⟨(MvPolynomial.monomial e (1 : R ⧸ Ideal.ofList rs)) ⊗ₜ[R ⧸ Ideal.ofList rs]
        Submodule.Quotient.mk (r • m), ?_⟩
    simpa [quasiRegularAssociatedGradedInternalMonomialClass, smul_smul, mul_comm] using
      quasiRegularSequenceAssociatedGradedMapAux_tmul_monomial (N := N) rs (r • m) e

/-- Helper for Chap10 10 69 0 1: the auxiliary base-change map is onto the internal associated
graded model. -/
theorem quasiRegularSequenceAssociatedGradedMapAux_surjective
    (N : Type v) [AddCommGroup N] [Module R N] (rs : List R) :
    Function.Surjective (quasiRegularSequenceAssociatedGradedMapAux N rs) := by
  -- Direct sums are generated by homogeneous entries; each entry is handled by the stage lemma.
  intro y
  induction y using DirectSum.induction_on with
  | zero =>
      exact ⟨0, by simp⟩
  | of n z =>
      refine Quotient.inductionOn z ?_
      intro x
      exact quasiRegularSequenceAssociatedGradedMapAux_lof_of_stage N rs n x
  | add y z hy hz =>
      rcases hy with ⟨ty, hty⟩
      rcases hz with ⟨tz, htz⟩
      exact ⟨ty + tz, by rw [map_add, hty, htz]⟩

/-- Helper for Chap10 10 69 0 1: the tensor-commutation map from the textbook source to the
base-change source is surjective. -/
theorem quasiRegularSequenceAssociatedGradedSourceComm_surjective
    (N : Type v) [AddCommGroup N] [Module R N] (rs : List R) :
    Function.Surjective (quasiRegularSequenceAssociatedGradedSourceComm N rs) := by
  -- Unfold the commutation map and use the surjectivity of the underlying tensor linear
  -- equivalence.
  simpa [quasiRegularSequenceAssociatedGradedSourceComm] using
    ((((TensorProduct.comm (R ⧸ Ideal.ofList rs)
      (N ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R N))
      (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))).toAddEquiv).linearEquiv
        (MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs))).surjective)

/-- Helper for Chap10 10 69 0 1: for an `R`-module `M` and a sequence `rs = [f₁, ..., f_c]`, the canonical
map of graded `((R / J)[X₁, ..., X_c])`-modules from
`M / J M ⊗_{R / J} (R / J)[X₁, ..., X_c]` to `⊕_{n ≥ 0} J^n M / J^(n + 1) M`
is the polynomial-linear extension of the degree-zero inclusion. -/
noncomputable def quasiRegularSequenceAssociatedGradedMap
    (N : Type v) [AddCommGroup N] [Module R N] (rs : List R) :
    ((N ⧸ ((Ideal.ofList rs) • ⊤ : Submodule R N)) ⊗[R ⧸ Ideal.ofList rs]
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) →ₗ[
        MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)]
      idealAssociatedGradedModule (Ideal.ofList rs) N :=
  ((quasiRegularAssociatedGradedAddEquiv rs N).linearEquiv _).symm.toLinearMap.comp <|
    (quasiRegularSequenceAssociatedGradedMapAux N rs).comp <|
      (quasiRegularSequenceAssociatedGradedSourceComm N rs)

/-- Chap10 10 69 0 1: the associated-graded comparison map is surjective. -/
theorem quasiRegularSequenceAssociatedGradedMap_surjective
    (N : Type v) [AddCommGroup N] [Module R N] (rs : List R) :
    Function.Surjective (quasiRegularSequenceAssociatedGradedMap N rs) := by
  -- The defining map is a composition of the source commutation map, the surjective auxiliary
  -- base-change map, and the inverse of the direct-sum equivalence.
  simpa [quasiRegularSequenceAssociatedGradedMap] using
    Function.Surjective.comp
      (((quasiRegularAssociatedGradedAddEquiv rs N).linearEquiv
        (R ⧸ Ideal.ofList rs)).symm.surjective)
      (Function.Surjective.comp
        (quasiRegularSequenceAssociatedGradedMapAux_surjective N rs)
        (quasiRegularSequenceAssociatedGradedSourceComm_surjective N rs))

