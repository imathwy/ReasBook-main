import Mathlib.Tactic.StacksAttribute
import stacks_proof.stacks_project.Chap10.Lemma_10_13_4.RelationSets

open scoped TensorProduct
open PiTensorProduct exteriorPower

section

variable (A B : Type) [CommRing A] [CommRing B] [Algebra A B]
variable (n : ℕ) (M : Type) [AddCommGroup M] [Module A M] [Module B M]
  [IsScalarTower A B M]

local instance lemma10134ExteriorPowerModule : Module A (⋀[B]^n M) :=
  Module.compHom (⋀[B]^n M) (algebraMap A B)

local instance lemma10134ExteriorPowerIsScalarTower : IsScalarTower A B (⋀[B]^n M) :=
  IsScalarTower.of_compHom A B (⋀[B]^n M)

local instance lemma10134TensorPowerOverBaseModule : Module A (⨂[B]^n M) := by
  infer_instance

local instance lemma10134TensorPowerOverBaseIsScalarTower : IsScalarTower A B (⨂[B]^n M) := by
  infer_instance

local notation "RepeatedRelationSetOverA" =>
  repeatedRelationSetOverA (A := A) (n := n) (M := M)

local notation "RepeatedRelationSetOverB" =>
  repeatedRelationSetOverB (B := B) (n := n) (M := M)

local notation "BalancingRelationSetOverA" =>
  balancingRelationSetOverA (A := A) (B := B) (n := n) (M := M)

/-!
### Chap10 Lemma 10 13 4

Source tag `0H1C` (`lemma-present-wedge`) in `source/stacks-project/algebra.tex` states that this
kernel over `A` is generated by repeated-entry tensors and balancing relations. That statement is
false in general, so the source-facing entry in this file records the corrected pullback comparison
and the statement-repair report records the source defect.
-/

/-- Chap10 Lemma 10 13 4 (corrected): because Stacks tag `0H1C` (`lemma-present-wedge`) is false
as written, the source-facing statement kept here is the mathematically correct comparison. For
`n > 1`, the kernel of the canonical `A`-linear map from the `n`th tensor power of `M` over `A`
to the `n`th exterior power of `M` over `B` is the pullback, along the tensor-power
scalar-restriction comparison, of the repeated-entry span in the tensor power over `B`. -/
-- Semantic recall: `exteriorPower.presentation_relation` and the standard exterior-power
-- presentation identify the over-`B` kernel with the repeated-entry span.
theorem ker_tensorPowerToExteriorPower_eq_comap_span_repeated_relations_over_B
    (hn : 1 < n) :
    (lift ((ιMulti B n).toMultilinearMap.restrictScalars A) :
      (⨂[A]^n M) →ₗ[A] ⋀[B]^n M).ker =
      Submodule.comap (tensorPowerRestrictScalarsToBase A B n M)
        ((Submodule.span B RepeatedRelationSetOverB).restrictScalars A) := sorry

end
