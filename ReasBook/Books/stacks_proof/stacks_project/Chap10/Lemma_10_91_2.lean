import Mathlib
import StacksProject_2024.Chap10.Lemma_10_89_6

-- Declarations for this item will be appended below by the statement pipeline.

open scoped TensorProduct

universe u v w x y

namespace Module

section

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Flat R M]

/-- Helper for Chap10 Lemma 10 91 2: the least-support condition forces the product tensor
comparison map `TensorProduct.piRightHom` to have zero kernel. -/
private lemma piRightHom_eq_zero_of_least_supports
    (hSupport :
      ∀ (F : ModuleCat.{max u w} R) [Module.Free R F] [Module.Finite R F] (x : F ⊗[R] M),
        ∃ F' : Submodule R F,
          IsLeast { F'' : Submodule R F | x ∈ LinearMap.range (F''.subtype.rTensor M) } F')
    {A : Type x} (Q : A → Type y) [∀ a, AddCommGroup (Q a)] [∀ a, Module R (Q a)]
    {t : M ⊗[R] (∀ a, Q a)}
    (ht : TensorProduct.piRightHom R R M Q t = 0) :
    t = 0 := by
  classical
  -- Write the tensor through a universe-lifted finite free module generated by its finitely many
  -- product-valued components.
  obtain ⟨k, m, q, ht_sum⟩ := TensorProduct.exists_sum_tmul_eq t
  let F : ModuleCat.{max u w} R := ModuleCat.of R (ULift.{w, u} (Fin k → R))
  let uBase : (Fin k → R) →ₗ[R] (∀ a, Q a) := (Pi.basisFun R (Fin k)).constr R q
  let u : F →ₗ[R] (∀ a, Q a) := uBase.comp ULift.moduleEquiv.toLinearMap
  let z : F ⊗[R] M := ∑ i, (ULift.up (Pi.single i (1 : R)) : F) ⊗ₜ[R] m i
  have ht_comm : (TensorProduct.comm R M (∀ a, Q a)) t = u.rTensor M z := by
    rw [ht_sum]
    simp [F, u, uBase, z, TensorProduct.comm_tmul, LinearMap.rTensor_tmul]
  obtain ⟨S, hS⟩ := hSupport F z
  -- Each coordinate projection kills `z`; flatness converts this to membership in the tensor of
  -- the coordinate kernel, so minimality puts the least support inside every coordinate kernel.
  have hle_ker : ∀ a : A, S ≤ LinearMap.ker ((LinearMap.proj a).comp u) := by
    intro a
    let p : F →ₗ[R] Q a := (LinearMap.proj a).comp u
    have hpz : (p.rTensor M) z = 0 := by
      have hcomponent :
          (TensorProduct.comm R M (Q a)) ((TensorProduct.piRightHom R R M Q t) a) = 0 := by
        rw [ht]
        simp
      have hcalc : (p.rTensor M) z =
          (TensorProduct.comm R M (Q a)) ((TensorProduct.piRightHom R R M Q t) a) := by
        rw [ht_sum]
        simp [p, F, u, uBase, z, TensorProduct.comm_tmul, LinearMap.rTensor_tmul]
      rw [hcalc]
      exact hcomponent
    have hzker : z ∈ LinearMap.ker (p.rTensor M) := by
      simpa [LinearMap.mem_ker] using hpz
    have hExact : Function.Exact ((LinearMap.ker p).subtype.rTensor M) (p.rTensor M) :=
      Module.Flat.rTensor_exact M (LinearMap.exact_subtype_ker_map p)
    have hzrange : z ∈ LinearMap.range ((LinearMap.ker p).subtype.rTensor M) := by
      simpa [Function.Exact.linearMap_ker_eq hExact] using hzker
    simpa [p] using hS.2 hzrange
  -- Since the least support is contained in the kernel of the product map, the finite-free
  -- representative maps to zero, and commutativity of tensor factors gives `t = 0`.
  have hu_subtype : u.comp S.subtype = 0 := by
    ext s a
    have hs : (s : F) ∈ LinearMap.ker ((LinearMap.proj a).comp u) := hle_ker a s.2
    simpa [LinearMap.mem_ker] using hs
  have huz : u.rTensor M z = 0 := by
    rcases hS.1 with ⟨zS, hzS⟩
    rw [← hzS]
    rw [← LinearMap.rTensor_comp_apply]
    rw [hu_subtype]
    simp
  apply (TensorProduct.comm R M (∀ a, Q a)).injective
  rw [ht_comm, huz]
  simp

-- Proof sketch: for the forward implication, apply Lemma `10.89.6` to obtain the smallest
-- supporting submodule for each tensor in a finite free source. For the converse, use Lazard's
-- theorem to write `M` as a directed colimit of finite free modules, apply Remark `10.88.8` to
-- reduce to the dual inverse system, and identify the eventual images in the duals with the
-- smallest supporting submodules supplied by the hypothesis.
/-- Chap10 Lemma 10 91 2: for a flat `R`-module `M`, the module `M` is Mittag-Leffler if and
only if, for every finite free `R`-module `F` and every tensor `x : F ⊗[R] M`, there exists a
smallest submodule `F' ≤ F` such that `x` lies in the image of `F' ⊗[R] M → F ⊗[R] M`. -/
@[stacks 059S]
theorem flat_mittagLeffler_iff_exists_smallest_supporting_submodule :
    MittagLeffler R M ↔
      ∀ (F : ModuleCat.{max u w} R) [Module.Free R F] [Module.Finite R F] (x : F ⊗[R] M),
        ∃ F' : Submodule R F,
          IsLeast { F'' : Submodule R F | x ∈ LinearMap.range (F''.subtype.rTensor M) } F' := by
  constructor
  · -- Lemma 10.89.6 gives the smallest support and its finiteness; this criterion only keeps the
    -- least-support component.
    intro hML F _ _ x
    letI : MittagLeffler R M := hML
    obtain ⟨F', hleast, _hfinite⟩ :=
      exists_smallest_finite_submodule_of_mem_tensorProduct (R := R) (M := M) x
    exact ⟨F', hleast⟩
  · -- Proposition 10.89.5 reduces Mittag-Leffler to injectivity of product tensor maps; the helper
    -- proves zero-kernel injectivity from the least-support hypothesis.
    intro hSupport
    refine
      (mittagLeffler_iff_tensorProduct_piRight_injective.{u, v, max u v w, max u v w}
        (R := R) (M := M)).2 ?_
    intro (A : Type (max u v w)) (Q : A → Type (max u v w)) _ _ t₁ t₂ ht
    exact sub_eq_zero.mp <|
      piRightHom_eq_zero_of_least_supports (R := R) (M := M) hSupport Q (by
        rw [map_sub, ht, sub_self])

namespace MittagLeffler

/-- For a flat Mittag-Leffler module, every tensor over a finite free source has a smallest
supporting submodule. -/
theorem exists_smallest_supporting_submodule [MittagLeffler R M]
    (F : ModuleCat.{max u w} R) [Module.Free R F] [Module.Finite R F] (x : F ⊗[R] M) :
    ∃ F' : Submodule R F,
      IsLeast { F'' : Submodule R F | x ∈ LinearMap.range (F''.subtype.rTensor M) } F' :=
  flat_mittagLeffler_iff_exists_smallest_supporting_submodule.mp
    (inferInstance : MittagLeffler R M) F x

end MittagLeffler

end

end Module
