import Mathlib
import StacksProject_2024.Chap10.Lemma_10_37_17

-- Support lemmas for the finite-adjoin tensor reduction in Lemma 10.165.1.

open scoped TensorProduct

open CategoryTheory Limits

universe u v

section

variable {k : Type u} {A : Type v} [Field k] [CommRing A] [Algebra k A]

/-- Helper for Chap10 Lemma 10 165 1: a field generated by a finite set is essentially finite
type over the base field. -/
lemma finiteAdjoin_stage_essFiniteType
    {K : Type (max u v)} [Field K] [Algebra k K] (s : Finset K) :
    Algebra.EssFiniteType k (IntermediateField.adjoin k (s : Set K)) := by
  -- The project-facing essential-finiteness predicate is exactly finite generation of the top
  -- intermediate field, and finite adjoining supplies that finite-generation witness.
  exact (IntermediateField.essFiniteType_iff).2
    (IntermediateField.fg_adjoin_finset (F := k) (E := K) s)

/-- Helper for Chap10 Lemma 10 165 1: a finite-set inclusion induces the corresponding inclusion
of finite-adjoin intermediate fields. -/
lemma finiteAdjoin_le_of_finset_subset
    {K : Type (max u v)} [Field K] [Algebra k K]
    {s t : Finset K} (hst : (s : Set K) ⊆ (t : Set K)) :
    IntermediateField.adjoin k (s : Set K) ≤ IntermediateField.adjoin k (t : Set K) := by
  -- The adjoin order criterion reduces the field inclusion to membership of each generator in
  -- the larger adjoin stage.
  rw [IntermediateField.adjoin_le_iff]
  exact fun z hz ↦ IntermediateField.subset_adjoin k (t : Set K) (hst hz)

/-- Helper for Chap10 Lemma 10 165 1: transporting a left finite-adjoin tensor through a larger
finite stage has the same image in the ambient tensor product. -/
lemma finiteAdjoin_leftTensor_map_comp_inclusion
    {K : Type (max u v)} [Field K] [Algebra k K]
    {E F : IntermediateField k K} (hEF : E ≤ F) (z : E ⊗[k] A) :
    Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom k F K)
        (AlgHom.id k A)
        (Algebra.TensorProduct.map
          (IntermediateField.inclusion hEF)
          (AlgHom.id k A)
          z) =
      Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom k E K)
        (AlgHom.id k A)
        z := by
  -- Reduce the transport identity to pure tensors, where both sides send `x ⊗ a` to the same
  -- ambient tensor.
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · simp
  · intro x a
    simp [IntermediateField.coe_inclusion]
  · intro x y hx hy
    simp [map_add, hx, hy]

/-- Helper for Chap10 Lemma 10 165 1: the map from a finite-adjoin left tensor stage into the
ambient tensor product is injective. -/
lemma finiteAdjoin_leftTensor_map_injective
    {K : Type (max u v)} [Field K] [Algebra k K] (E : IntermediateField k K) :
    Function.Injective
      (Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom k E K)
        (AlgHom.id k A)) := by
  -- Over the field `k`, tensoring two injective linear maps between flat modules is injective.
  simpa using
    TensorProduct.map_injective_of_flat_flat
      (IsScalarTower.toAlgHom k E K).toLinearMap
      (LinearMap.id : A →ₗ[k] A)
      (RingHom.injective (IsScalarTower.toAlgHom k E K).toRingHom)
      (fun _ _ h ↦ h)

/-- Helper for Chap10 Lemma 10 165 1: two finite-stage tensor representatives with the same
ambient image become equal after transport to one finite union stage. -/
lemma finiteAdjoin_leftTensor_commonStage_eq_of_ambient_eq
    {K : Type (max u v)} [Field K] [Algebra k K]
    {sx sy : Finset K}
    {zsx : IntermediateField.adjoin k (sx : Set K) ⊗[k] A}
    {zsy : IntermediateField.adjoin k (sy : Set K) ⊗[k] A}
    (h :
      Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (sx : Set K)) K)
          (AlgHom.id k A)
          zsx =
        Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (sy : Set K)) K)
          (AlgHom.id k A)
          zsy) :
    ∃ (s : Finset K)
      (hsx : IntermediateField.adjoin k (sx : Set K) ≤
        IntermediateField.adjoin k (s : Set K))
      (hsy : IntermediateField.adjoin k (sy : Set K) ≤
        IntermediateField.adjoin k (s : Set K)),
      Algebra.TensorProduct.map
          (IntermediateField.inclusion hsx)
          (AlgHom.id k A)
          zsx =
        Algebra.TensorProduct.map
          (IntermediateField.inclusion hsy)
          (AlgHom.id k A)
          zsy := by
  classical
  let Ex := IntermediateField.adjoin k (sx : Set K)
  let Ey := IntermediateField.adjoin k (sy : Set K)
  let s : Finset K := sx ∪ sy
  let E := IntermediateField.adjoin k (s : Set K)
  have hsx_subset : (sx : Set K) ⊆ (s : Set K) := by
    intro z hz
    simp [s, hz]
  have hsy_subset : (sy : Set K) ⊆ (s : Set K) := by
    intro z hz
    simp [s, hz]
  have hEx : Ex ≤ E := by
    rw [IntermediateField.adjoin_le_iff]
    exact fun z hz ↦ IntermediateField.subset_adjoin k (s : Set K) (hsx_subset hz)
  have hEy : Ey ≤ E := by
    rw [IntermediateField.adjoin_le_iff]
    exact fun z hz ↦ IntermediateField.subset_adjoin k (s : Set K) (hsy_subset hz)
  refine ⟨s, hEx, hEy, ?_⟩
  -- Push both union-stage representatives to the ambient tensor product; injectivity at the
  -- union stage lets the ambient equality descend back to the common finite stage.
  exact (finiteAdjoin_leftTensor_map_injective (A := A) E) <| by
    calc
      Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k E K)
          (AlgHom.id k A)
          (Algebra.TensorProduct.map
            (IntermediateField.inclusion hEx)
            (AlgHom.id k A)
            zsx) =
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k Ex K)
            (AlgHom.id k A)
            zsx := by
          exact finiteAdjoin_leftTensor_map_comp_inclusion (A := A) hEx zsx
      _ =
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k Ey K)
            (AlgHom.id k A)
            zsy := h
      _ =
        Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k E K)
          (AlgHom.id k A)
          (Algebra.TensorProduct.map
            (IntermediateField.inclusion hEy)
            (AlgHom.id k A)
            zsy) := by
          exact (finiteAdjoin_leftTensor_map_comp_inclusion (A := A) hEy zsy).symm

/-- Helper for Chap10 Lemma 10 165 1: equality of two finite-stage representatives in the
ambient tensor product descends to tensor representatives over one finite union stage. -/
lemma finiteAdjoin_leftTensor_commonFinset_eq_of_ambient_eq
    {K : Type (max u v)} [Field K] [Algebra k K]
    {sx sy : Finset K}
    {zsx : IntermediateField.adjoin k (sx : Set K) ⊗[k] A}
    {zsy : IntermediateField.adjoin k (sy : Set K) ⊗[k] A}
    (h :
      Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (sx : Set K)) K)
          (AlgHom.id k A)
          zsx =
        Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (sy : Set K)) K)
          (AlgHom.id k A)
          zsy) :
    ∃ (s : Finset K)
      (hsx : (sx : Set K) ⊆ (s : Set K))
      (hsy : (sy : Set K) ⊆ (s : Set K)),
      Algebra.TensorProduct.map
          (IntermediateField.inclusion (finiteAdjoin_le_of_finset_subset (k := k) (K := K) hsx))
          (AlgHom.id k A)
          zsx =
        Algebra.TensorProduct.map
          (IntermediateField.inclusion (finiteAdjoin_le_of_finset_subset (k := k) (K := K) hsy))
          (AlgHom.id k A)
          zsy := by
  classical
  let Ex := IntermediateField.adjoin k (sx : Set K)
  let Ey := IntermediateField.adjoin k (sy : Set K)
  let s : Finset K := sx ∪ sy
  let E := IntermediateField.adjoin k (s : Set K)
  have hsx_subset : (sx : Set K) ⊆ (s : Set K) := by
    intro z hz
    simp [s, hz]
  have hsy_subset : (sy : Set K) ⊆ (s : Set K) := by
    intro z hz
    simp [s, hz]
  refine ⟨s, hsx_subset, hsy_subset, ?_⟩
  let hEx : Ex ≤ E := finiteAdjoin_le_of_finset_subset (k := k) (K := K) hsx_subset
  let hEy : Ey ≤ E := finiteAdjoin_le_of_finset_subset (k := k) (K := K) hsy_subset
  -- Push both representatives into the finite union stage and use injectivity of that stage's
  -- ambient tensor map to descend the given equality.
  exact (finiteAdjoin_leftTensor_map_injective (A := A) E) <| by
    calc
      Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k E K)
          (AlgHom.id k A)
          (Algebra.TensorProduct.map
            (IntermediateField.inclusion hEx)
            (AlgHom.id k A)
            zsx) =
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k Ex K)
            (AlgHom.id k A)
            zsx := by
          exact finiteAdjoin_leftTensor_map_comp_inclusion (A := A) hEx zsx
      _ =
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k Ey K)
            (AlgHom.id k A)
            zsy := h
      _ =
        Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k E K)
          (AlgHom.id k A)
          (Algebra.TensorProduct.map
            (IntermediateField.inclusion hEy)
            (AlgHom.id k A)
            zsy) := by
          exact (finiteAdjoin_leftTensor_map_comp_inclusion (A := A) hEy zsy).symm

/-- Helper for Chap10 Lemma 10 165 1: every element of `K ⊗[k] A` is represented over a finite
adjoin stage of `K / k` on the left tensor factor. -/
lemma exists_finiteAdjoin_leftTensor
    {K : Type (max u v)} [Field K] [Algebra k K] (z : K ⊗[k] A) :
    ∃ s : Finset K,
      ∃ zs : IntermediateField.adjoin k (s : Set K) ⊗[k] A,
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (s : Set K)) K)
            (AlgHom.id k A)
            zs = z := by
  classical
  -- Tensor induction records the finite set of left coordinates appearing in a tensor
  -- expression, enlarging two witnesses to their union in the additive step.
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · let s : Finset K := ∅
    let zs : IntermediateField.adjoin k (s : Set K) ⊗[k] A := 0
    exact ⟨s, zs, by simp [s, zs]⟩
  · intro x a
    let s : Finset K := {x}
    let E := IntermediateField.adjoin k (s : Set K)
    have hxE : x ∈ E := IntermediateField.subset_adjoin k (s : Set K) (by simp [s])
    let xE : E := ⟨x, hxE⟩
    let zs : E ⊗[k] A := xE ⊗ₜ[k] a
    exact ⟨s, zs, by simp [s, E, xE, zs]⟩
  · intro x y hx hy
    rcases hx with ⟨sx, zsx, hsx⟩
    rcases hy with ⟨sy, zsy, hsy⟩
    let Ex := IntermediateField.adjoin k (sx : Set K)
    let Ey := IntermediateField.adjoin k (sy : Set K)
    let s : Finset K := sx ∪ sy
    let E := IntermediateField.adjoin k (s : Set K)
    have hsx_subset : (sx : Set K) ⊆ (s : Set K) := by
      intro z hz
      simp [s, hz]
    have hsy_subset : (sy : Set K) ⊆ (s : Set K) := by
      intro z hz
      simp [s, hz]
    have hEx : Ex ≤ E := by
      rw [IntermediateField.adjoin_le_iff]
      exact fun z hz ↦ IntermediateField.subset_adjoin k (s : Set K) (hsx_subset hz)
    have hEy : Ey ≤ E := by
      rw [IntermediateField.adjoin_le_iff]
      exact fun z hz ↦ IntermediateField.subset_adjoin k (s : Set K) (hsy_subset hz)
    let zsx' : E ⊗[k] A :=
      Algebra.TensorProduct.map
        (IntermediateField.inclusion hEx)
        (AlgHom.id k A)
        zsx
    let zsy' : E ⊗[k] A :=
      Algebra.TensorProduct.map
        (IntermediateField.inclusion hEy)
        (AlgHom.id k A)
        zsy
    refine ⟨s, zsx' + zsy', ?_⟩
    -- After moving both representatives into the union stage, the transport lemma rewrites their
    -- ambient images back to the original two summands.
    calc
      Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k E K)
          (AlgHom.id k A)
          (zsx' + zsy') =
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k E K)
            (AlgHom.id k A)
            zsx' +
          Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k E K)
            (AlgHom.id k A)
            zsy' := by
          simp [zsx', zsy']
      _ =
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k Ex K)
            (AlgHom.id k A)
            zsx +
          Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k Ey K)
            (AlgHom.id k A)
            zsy := by
          rw [finiteAdjoin_leftTensor_map_comp_inclusion (A := A) hEx zsx,
            finiteAdjoin_leftTensor_map_comp_inclusion (A := A) hEy zsy]
      _ = x + y := by
        rw [hsx, hsy]

/-- Helper for Chap10 Lemma 10 165 1: a morphism of finite subsets gives inclusion of the
underlying sets of generators. -/
lemma finiteAdjoin_finset_subset_of_hom
    {K : Type (max u v)} [Field K] [Algebra k K]
    {s t : Finset K} (h : s ⟶ t) :
    (s : Set K) ⊆ (t : Set K) := by
  -- In the preorder category on finite subsets, morphisms are exactly inclusions.
  intro z hz
  exact (CategoryTheory.leOfHom h) hz

/-- Helper for Chap10 Lemma 10 165 1: the transition map between finite-adjoin tensor stages. -/
noncomputable def finiteAdjoinTensorMap
    {K : Type (max u v)} [Field K] [Algebra k K]
    {s t : Finset K} (h : s ⟶ t) :
    CommRingCat.of (IntermediateField.adjoin k (s : Set K) ⊗[k] A) ⟶
      CommRingCat.of (IntermediateField.adjoin k (t : Set K) ⊗[k] A) :=
  CommRingCat.ofHom <|
    (Algebra.TensorProduct.map
      (IntermediateField.inclusion
        (finiteAdjoin_le_of_finset_subset (k := k) (K := K)
          (finiteAdjoin_finset_subset_of_hom (k := k) (K := K) h)))
      (AlgHom.id k A)).toRingHom

/-- Helper for Chap10 Lemma 10 165 1: finite-adjoin tensor transition maps preserve identities. -/
lemma finiteAdjoinTensorMap_id
    {K : Type (max u v)} [Field K] [Algebra k K] (s : Finset K) :
    finiteAdjoinTensorMap (k := k) (A := A) (K := K) (𝟙 s) = 𝟙 _ := by
  -- Tensor-product extensionality reduces the identity law to the two canonical inclusions.
  apply CommRingCat.hom_ext
  ext x
  · simp [finiteAdjoinTensorMap]
  · simp [finiteAdjoinTensorMap, Algebra.TensorProduct.includeRight]

/-- Helper for Chap10 Lemma 10 165 1: finite-adjoin tensor transition maps compose as expected. -/
lemma finiteAdjoinTensorMap_comp
    {K : Type (max u v)} [Field K] [Algebra k K]
    {s t r : Finset K} (hst : s ⟶ t) (htr : t ⟶ r) :
    finiteAdjoinTensorMap (k := k) (A := A) (K := K) (hst ≫ htr) =
      finiteAdjoinTensorMap (k := k) (A := A) (K := K) hst ≫
        finiteAdjoinTensorMap (k := k) (A := A) (K := K) htr := by
  -- The composition law is checked on the left and right tensor generators.
  apply CommRingCat.hom_ext
  ext x
  · simp [finiteAdjoinTensorMap]
  · simp [finiteAdjoinTensorMap, Algebra.TensorProduct.includeRight]

/-- Helper for Chap10 Lemma 10 165 1: the directed diagram of tensor products over finite-adjoin
intermediate fields. -/
noncomputable def finiteAdjoinTensorDiagram
    (K : Type (max u v)) [Field K] [Algebra k K] :
    Finset K ⥤ CommRingCat.{max u v} where
  obj s := CommRingCat.of (IntermediateField.adjoin k (s : Set K) ⊗[k] A)
  map h := finiteAdjoinTensorMap (k := k) (A := A) (K := K) h
  map_id := finiteAdjoinTensorMap_id (k := k) (A := A) (K := K)
  map_comp := finiteAdjoinTensorMap_comp (k := k) (A := A) (K := K)

/-- Helper for Chap10 Lemma 10 165 1: ambient tensor maps are compatible with finite-adjoin
tensor transitions. -/
lemma finiteAdjoinTensorCocone_naturality
    {K : Type (max u v)} [Field K] [Algebra k K] :
    ∀ ⦃s t : Finset K⦄ (h : s ⟶ t),
    (finiteAdjoinTensorDiagram (k := k) (A := A) K).map h ≫
        CommRingCat.ofHom
          ((Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (t : Set K)) K)
            (AlgHom.id k A)).toRingHom) =
      CommRingCat.ofHom
        ((Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (s : Set K)) K)
          (AlgHom.id k A)).toRingHom) ≫
        ((Functor.const (Finset K)).obj (CommRingCat.of (K ⊗[k] A))).map h := by
  intro s t h
  -- This is the previously proved ambient-compatibility lemma, repackaged as cocone naturality.
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro z
  exact finiteAdjoin_leftTensor_map_comp_inclusion (A := A)
    (finiteAdjoin_le_of_finset_subset (k := k) (K := K)
      (finiteAdjoin_finset_subset_of_hom (k := k) (K := K) h)) z

/-- Helper for Chap10 Lemma 10 165 1: the cocone from finite-adjoin tensor stages to the ambient
tensor product `K ⊗[k] A`. -/
noncomputable def finiteAdjoinTensorCocone
    (K : Type (max u v)) [Field K] [Algebra k K] :
    Cocone (finiteAdjoinTensorDiagram (k := k) (A := A) K) where
  pt := CommRingCat.of (K ⊗[k] A)
  ι :=
    { app := fun s =>
        CommRingCat.ofHom
          ((Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (s : Set K)) K)
            (AlgHom.id k A)).toRingHom)
      naturality := finiteAdjoinTensorCocone_naturality (k := k) (A := A) (K := K) }

/-- Helper for Chap10 Lemma 10 165 1: the canonical map from the filtered colimit of
finite-adjoin tensor stages to the ambient tensor product. -/
noncomputable def finiteAdjoinTensorColimitToTensor
    (K : Type (max u v)) [Field K] [Algebra k K] :
    (CommRingCat.FilteredColimits.colimitCocone
        (finiteAdjoinTensorDiagram (k := k) (A := A) K)).pt →+*
      (finiteAdjoinTensorCocone (k := k) (A := A) K).pt :=
  ((CommRingCat.FilteredColimits.colimitCoconeIsColimit
      (finiteAdjoinTensorDiagram (k := k) (A := A) K)).desc
    (finiteAdjoinTensorCocone (k := k) (A := A) K)).hom

/-- Helper for Chap10 Lemma 10 165 1: the colimit-to-tensor map agrees with the ambient map on
each finite-adjoin tensor stage. -/
lemma finiteAdjoinTensorColimitToTensor_ι
    (K : Type (max u v)) [Field K] [Algebra k K]
    (s : Finset K) (z : IntermediateField.adjoin k (s : Set K) ⊗[k] A) :
    finiteAdjoinTensorColimitToTensor (k := k) (A := A) K
      ((CommRingCat.FilteredColimits.colimitCocone
        (finiteAdjoinTensorDiagram (k := k) (A := A) K)).ι.app s z) =
      Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (s : Set K)) K)
        (AlgHom.id k A) z := by
  -- This is the defining computation rule for the colimit descent map.
  simpa [finiteAdjoinTensorColimitToTensor, finiteAdjoinTensorCocone] using
    ConcreteCategory.congr_hom
      ((CommRingCat.FilteredColimits.colimitCoconeIsColimit
        (finiteAdjoinTensorDiagram (k := k) (A := A) K)).fac
          (finiteAdjoinTensorCocone (k := k) (A := A) K) s) z

/-- Helper for Chap10 Lemma 10 165 1: the colimit-to-tensor map is surjective. -/
lemma finiteAdjoinTensorColimitToTensor_surjective
    (K : Type (max u v)) [Field K] [Algebra k K] :
    Function.Surjective (finiteAdjoinTensorColimitToTensor (k := k) (A := A) K) := by
  -- Every tensor in the ambient product has a representative over some finite-adjoin stage.
  intro z
  change K ⊗[k] A at z
  obtain ⟨s, zs, hzs⟩ := exists_finiteAdjoin_leftTensor (k := k) (A := A) (K := K) z
  refine ⟨(CommRingCat.FilteredColimits.colimitCocone
    (finiteAdjoinTensorDiagram (k := k) (A := A) K)).ι.app s zs, ?_⟩
  rw [finiteAdjoinTensorColimitToTensor_ι]
  exact hzs

/-- Helper for Chap10 Lemma 10 165 1: equality after mapping from the finite-adjoin tensor
colimit to the ambient tensor product already holds in the colimit. -/
lemma finiteAdjoinTensorColimitToTensor_injective
    (K : Type (max u v)) [Field K] [Algebra k K] :
    Function.Injective (finiteAdjoinTensorColimitToTensor (k := k) (A := A) K) := by
  intro x y hxy
  let D := finiteAdjoinTensorDiagram (k := k) (A := A) K
  let c := CommRingCat.FilteredColimits.colimitCocone D
  let t : Cocone (D ⋙ forget CommRingCat.{max u v}) :=
    Types.TypeMax.colimitCocone (D ⋙ forget CommRingCat.{max u v})
  let ht : IsColimit t :=
    Types.TypeMax.colimitCoconeIsColimit (D ⋙ forget CommRingCat.{max u v})
  obtain ⟨s, xs, ys, hxs, hys⟩ :=
    Types.FilteredColimit.jointly_surjective_of_isColimit₂ ht x y
  have hxs' : c.ι.app s xs = x := by
    simpa [c, t, D] using hxs
  have hys' : c.ι.app s ys = y := by
    simpa [c, t, D] using hys
  have hamb :
      Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (s : Set K)) K)
          (AlgHom.id k A) xs =
        Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (s : Set K)) K)
          (AlgHom.id k A) ys := by
    -- The assumed equality of colimit images becomes equality in the ambient tensor stage.
    rw [← finiteAdjoinTensorColimitToTensor_ι (k := k) (A := A) K s xs,
      ← finiteAdjoinTensorColimitToTensor_ι (k := k) (A := A) K s ys]
    rw [hxs', hys']
    exact hxy
  obtain ⟨r, hsx, hsy, hrxy⟩ :=
    finiteAdjoin_leftTensor_commonFinset_eq_of_ambient_eq (A := A) (sx := s) (sy := s) hamb
  let fs : s ⟶ r := homOfLE (by
    intro z hz
    exact hsx hz)
  let gs : s ⟶ r := homOfLE (by
    intro z hz
    exact hsy hz)
  have hD : D.map fs xs = D.map gs ys := by
    simpa [D, finiteAdjoinTensorDiagram, finiteAdjoinTensorMap, fs, gs] using hrxy
  have h1 : c.ι.app s xs = c.ι.app r (D.map fs xs) := by
    exact (ConcreteCategory.congr_hom (c.w fs) xs).symm
  have h2 : c.ι.app r (D.map fs xs) = c.ι.app r (D.map gs ys) := by
    exact congrArg (fun z => c.ι.app r z) hD
  have h3 : c.ι.app r (D.map gs ys) = c.ι.app s ys := by
    exact ConcreteCategory.congr_hom (c.w gs) ys
  -- Returning to the chosen colimit representatives proves the original elements equal.
  exact hxs'.symm.trans (h1.trans (h2.trans (h3.trans hys')))

/-- Helper for Chap10 Lemma 10 165 1: normality of all finite-adjoin tensor stages implies
normality after tensoring with the full field extension. -/
lemma isNormalRing_tensorProduct_of_finiteAdjoin_stage_tests
    {K : Type (max u v)} [Field K] [Algebra k K]
    (hstage :
      ∀ s : Finset K, IsNormalRing (IntermediateField.adjoin k (s : Set K) ⊗[k] A)) :
    IsNormalRing (K ⊗[k] A) := by
  letI : IsFiltered (Finset K) := CategoryTheory.isFiltered_of_directed_le_nonempty (Finset K)
  let D := finiteAdjoinTensorDiagram (k := k) (A := A) K
  have hnormalStages : ∀ s : Finset K, IsNormalRing (D.obj s) := fun s => hstage s
  letI : ∀ s : Finset K, IsNormalRing (D.obj s) := hnormalStages
  let C := (CommRingCat.FilteredColimits.colimitCocone D).pt
  letI : IsNormalRing C := by
    simpa [C] using (isNormalRing_canonical_filtered_colimit D)
  let e : C ≃+* (finiteAdjoinTensorCocone (k := k) (A := A) K).pt :=
    RingEquiv.ofBijective (finiteAdjoinTensorColimitToTensor (k := k) (A := A) K)
      ⟨finiteAdjoinTensorColimitToTensor_injective (k := k) (A := A) K,
        finiteAdjoinTensorColimitToTensor_surjective (k := k) (A := A) K⟩
  -- Transport normality across the bijective colimit comparison with the ambient tensor product.
  simpa [finiteAdjoinTensorCocone] using (isNormalRing_of_equiv e)

end
