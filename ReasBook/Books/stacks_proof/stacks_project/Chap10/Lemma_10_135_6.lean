/-- Helper for Lemma 10.135.6: if the left kernel is zero, the expected generator presentation of
the composite kernel transports across the resulting ring equivalence to the right kernel. -/
private theorem rightKernelDimGeneratorsOfCompositeKernelDimGeneratorsOfKerEqBot
    (φ : A →+* B) (ψ : B →+* C) (hφ : Function.Surjective φ)
    (hφker : RingHom.ker φ = ⊥) :
    (∃ (d : ℕ) (_ : ringKrullDim C + d = ringKrullDim A) (x : Fin d → A),
        Ideal.span (Set.range x) = RingHom.ker (ψ.comp φ)) →
      ∃ (d : ℕ) (_ : ringKrullDim C + d = ringKrullDim B) (y : Fin d → B),
        Ideal.span (Set.range y) = RingHom.ker ψ := by
  rintro ⟨d, hdim, x, hx⟩
  have hφinj : Function.Injective φ :=
    (RingHom.injective_iff_ker_eq_bot φ).2 hφker
  let e : A ≃+* B := RingEquiv.ofBijective φ ⟨hφinj, hφ⟩
  refine ⟨d, ?_, fun i ↦ φ (x i), ?_⟩
  · -- Proof comment: zero kernel makes `φ` a ring equivalence, so the dimension count transfers.
    calc
      ringKrullDim C + d = ringKrullDim A := hdim
      _ = ringKrullDim B := ringKrullDim_eq_of_ringEquiv e
  · -- Proof comment: mapping the source span along the equivalence gives the right kernel.
    calc
      Ideal.span (Set.range fun i : Fin d ↦ φ (x i)) =
          Ideal.map φ (Ideal.span (Set.range x)) := by
            rw [Ideal.map_span]
            congr 1
            ext b
            constructor
            · rintro ⟨i, rfl⟩
              exact ⟨x i, ⟨i, rfl⟩, rfl⟩
            · rintro ⟨a, ⟨i, rfl⟩, rfl⟩
              exact ⟨i, rfl⟩
      _ = Ideal.map φ (RingHom.ker (ψ.comp φ)) := by rw [hx]
      _ = RingHom.ker ψ := ideal_map_composite_kernel_eq_right_kernel_of_surjective φ ψ hφ

