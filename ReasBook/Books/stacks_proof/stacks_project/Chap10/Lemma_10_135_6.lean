/-- Helper for Lemma 10.135.6: if a finite family generates an ideal, then the corresponding
subtype-valued family spans that ideal as a module. -/
private theorem span_subtype_eq_top_of_ideal_span_eq
    (I : Ideal A) {d : ℕ} (w : Fin d → A) (hw : Ideal.span (Set.range w) = I) :
    Submodule.span A (Set.range fun i : Fin d ↦ (⟨w i, by
      rw [← hw]
      exact Ideal.subset_span ⟨i, rfl⟩⟩ : I)) = ⊤ := by
  -- Proof comment: this is the ambient-ideal/span statement rewritten inside the ideal subtype.
  exact
    (Submodule.span_range_subtype_eq_top_iff
      (p := I) (s := w) (hs := fun i ↦ by
        rw [← hw]
        exact Ideal.subset_span ⟨i, rfl⟩)).2 <| by
          simpa using hw

/-- Helper for Lemma 10.135.6: an element of `I` has nonzero class in `I / 𝔪 I` precisely when it
does not lie in `𝔪 I`. -/
private theorem quotient_class_ne_zero_of_not_mem_maximalIdeal_mul
    (I : Ideal A) {x : A} (hxI : x ∈ I) (hx_not_mem : x ∉ maximalIdeal A * I) :
    let N : Submodule A I := maximalIdeal A • (⊤ : Submodule A I)
    (Submodule.mkQ N ⟨x, hxI⟩ : I ⧸ N) ≠ 0 := by
  let N : Submodule A I := maximalIdeal A • (⊤ : Submodule A I)
  -- Proof comment: `Submodule.mem_smul_top_iff` converts the quotient-zero condition back to the
  -- ideal product `𝔪 I`.
  dsimp
  intro hx_zero
  apply hx_not_mem
  exact
    (Submodule.mem_smul_top_iff (I := maximalIdeal A) (N := I) ⟨x, hxI⟩).1 <|
      (Submodule.Quotient.mk_eq_zero N).1 hx_zero

/-- Helper for Lemma 10.135.6: if `x ∈ I` survives in `I / 𝔪 I`, then `x` can be inserted as the
head of a finite generating family of `I`. -/
private theorem exists_fin_cons_span_eq_of_mem_not_mem_maximalIdeal_mul
    (I : Ideal A) (_hI : I ≤ maximalIdeal A) {n : ℕ} {x : A} (hxI : x ∈ I)
    (hx_not_mem : x ∉ maximalIdeal A * I) (w : Fin (n + 1) → A)
    (hw : Ideal.span (Set.range w) = I) :
    ∃ z : Fin n → A, Ideal.span (Set.range (Fin.cons x z)) = I := by
  classical
  let N : Submodule A I := maximalIdeal A • (⊤ : Submodule A I)
  have hwI_mem : ∀ i : Fin (n + 1), w i ∈ I := by
    intro i
    rw [← hw]
    exact Ideal.subset_span ⟨i, rfl⟩
  let wI : Fin (n + 1) → I := fun i ↦ ⟨w i, hwI_mem i⟩
  let q : I →ₗ[A] I ⧸ N := Submodule.mkQ N
  have hspanI : Submodule.span A (Set.range wI) = ⊤ := by
    -- Proof comment: rewrite the ideal generators as a spanning family of the ideal subtype.
    exact span_subtype_eq_top_of_ideal_span_eq I w hw
  have hspanQ : Submodule.span A (Set.range (q ∘ wI)) = ⊤ := by
    -- Proof comment: the quotient images of the given generators still span `I / 𝔪 I`.
    calc
      Submodule.span A (Set.range (q ∘ wI)) = Submodule.map q (Submodule.span A (Set.range wI)) := by
        rw [Submodule.map_span, Set.range_comp]
      _ = Submodule.map q ⊤ := by rw [hspanI]
      _ = LinearMap.range q := by rw [Submodule.map_top]
      _ = ⊤ := LinearMap.range_eq_top.2 (Submodule.mkQ_surjective N)
  let xI : I := ⟨x, hxI⟩
  let qx : I ⧸ N := q xI
  have hqx_ne : qx ≠ 0 := by
    -- Proof comment: the source hypothesis says exactly that `x` survives modulo `𝔪 I`.
    simpa [N, xI, qx, q] using
      quotient_class_ne_zero_of_not_mem_maximalIdeal_mul I hxI hx_not_mem
  have hqx_mem : qx ∈ Submodule.span A (Set.range (q ∘ wI)) := by
    rw [hspanQ]
    simp
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).1 hqx_mem
  have hc_exists : ∃ j : Fin (n + 1), c j ∉ maximalIdeal A := by
    by_contra hnone
    push Not at hnone
    have hterm_zero : ∀ i : Fin (n + 1), c i • q (wI i) = 0 := by
      intro i
      have htop_mem : wI i ∈ (⊤ : Submodule A I) := by
        simp
      rw [← map_smul]
      have hmemN : c i • wI i ∈ N := Submodule.smul_mem_smul (hnone i) htop_mem
      simpa [q] using (Submodule.Quotient.mk_eq_zero N).2 hmemN
    have hqx_zero : qx = 0 := by
      rw [← hc]
      simp [hterm_zero]
    exact hqx_ne hqx_zero
  obtain ⟨j, hcj⟩ := hc_exists
  have hu : IsUnit (c j) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hcj
    exact not_not.mp hcj
  let zI : Fin n → I := fun i ↦ wI (j.succAbove i)
  let v : Fin (n + 1) → I := j.insertNth xI zI
  have hqx_mem_new : qx ∈ Submodule.span A (Set.range (q ∘ v)) := by
    -- Proof comment: in the pivoted family, the head slot is exactly the chosen class of `x`.
    exact Submodule.subset_span ⟨j, by simp [q, qx, v, xI, zI]⟩
  have hrest_mem_new :
      (∑ i : Fin n, c (j.succAbove i) • q (wI (j.succAbove i))) ∈
        Submodule.span A (Set.range (q ∘ v)) := by
    -- Proof comment: every tail term of the old family already appears in the pivoted family.
    refine Submodule.sum_mem _ ?_
    intro i hi
    have hi_mem : q (wI (j.succAbove i)) ∈ Submodule.span A (Set.range (q ∘ v)) := by
      exact Submodule.subset_span ⟨j.succAbove i, by simp [v, zI]⟩
    exact Submodule.smul_mem _ _ hi_mem
  have hsplit :
      ∑ i : Fin (n + 1), c i • q (wI i) =
        c j • q (wI j) + ∑ i : Fin n, c (j.succAbove i) • q (wI (j.succAbove i)) := by
    -- Proof comment: split the linear combination into the chosen pivot term and its tail.
    simpa using (Fin.sum_univ_succAbove (fun i : Fin (n + 1) ↦ c i • q (wI i)) j)
  have hcoeff_mem_new : c j • q (wI j) ∈ Submodule.span A (Set.range (q ∘ v)) := by
    -- Proof comment: isolate the pivot coefficient from the expression for the nonzero class of
    -- `x` and note that the remaining tail sum is already in the new span.
    have hsum_eq :
        c j • q (wI j) + ∑ i : Fin n, c (j.succAbove i) • q (wI (j.succAbove i)) = qx := by
      calc
        c j • q (wI j) + ∑ i : Fin n, c (j.succAbove i) • q (wI (j.succAbove i)) =
            ∑ i : Fin (n + 1), c i • q (wI i) := by
              symm
              exact hsplit
        _ = qx := hc
    have hcoeff_eq :
        c j • q (wI j) = qx - ∑ i : Fin n, c (j.succAbove i) • q (wI (j.succAbove i)) := by
      exact eq_sub_iff_add_eq.2 hsum_eq
    rw [hcoeff_eq]
    exact Submodule.sub_mem _ hqx_mem_new hrest_mem_new
  have hqj_mem_new : q (wI j) ∈ Submodule.span A (Set.range (q ∘ v)) := by
    -- Proof comment: the pivot coefficient is a unit, so we can solve for the old generator.
    rcases hu with ⟨u, hu_eq⟩
    have hcoeff_mem_unit :
        ((↑u : A) • q (wI j)) ∈ Submodule.span A (Set.range (q ∘ v)) := by
      simpa [hu_eq] using hcoeff_mem_new
    have hunit_mem :
        ((↑u⁻¹ : A) • ((↑u : A) • q (wI j))) ∈ Submodule.span A (Set.range (q ∘ v)) := by
      exact Submodule.smul_mem _ _ hcoeff_mem_unit
    simpa [smul_smul] using hunit_mem
  have hspanQv : Submodule.span A (Set.range (q ∘ v)) = ⊤ := by
    -- Proof comment: the pivoted family still spans the quotient because it contains all old
    -- generators modulo one unit elimination.
    apply top_unique
    rw [← hspanQ]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    by_cases hi : i = j
    · subst hi
      exact hqj_mem_new
    · rcases Fin.exists_succAbove_eq hi with ⟨k, rfl⟩
      exact Submodule.subset_span ⟨j.succAbove k, by simp [v, zI]⟩
  have hv_cons : v ∘ j.cycleRange.symm = Fin.cons xI zI := by
    -- Proof comment: reindexing the pivoted family along the cycle permutation moves the chosen
