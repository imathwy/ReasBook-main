contained in that kernel. -/
private theorem span_singleton_le_ker_of_mem_ker (φ : A →+* B) {a : A}
    (ha : a ∈ RingHom.ker φ) :
    Ideal.span ({a} : Set A) ≤ RingHom.ker φ := by
