/-- Helper for Chap10 Lemma 10 135 6: canceling the one-dimensional head quotient from the
expected Krull-dimension formula gives the recursive tail formula. -/
private theorem dimensionFormulaAfterHeadQuotient {S : Type*} [CommRing S] {n : ℕ}
    (hdim : ringKrullDim C + (n + 1) = ringKrullDim A)
    (hdrop : ringKrullDim S + 1 = ringKrullDim A) :
    ringKrullDim C + n = ringKrullDim S := by
  -- Proof comment: rewrite both hypotheses with a common final `+ 1`, then cancel that finite
  -- summand in `WithBot ℕ∞`.
  have hsucc : ringKrullDim C + n + 1 = ringKrullDim S + 1 := by
    calc
      ringKrullDim C + n + 1 = ringKrullDim C + (n + 1) := by
        simp [add_assoc]
      _ = ringKrullDim A := hdim
      _ = ringKrullDim S + 1 := hdrop.symm
  exact (ENat.WithBot.add_natCast_cancel (a := ringKrullDim C + n) (b := ringKrullDim S)
    (c := 1)).1 hsucc

