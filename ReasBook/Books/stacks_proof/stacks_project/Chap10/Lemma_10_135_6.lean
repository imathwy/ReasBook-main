/-- Helper for Chap10 Lemma 10 135 6: a nonzero kernel prefix supplies a head element in the
kernel whose class is nonzero modulo `𝔪 K`. -/
private theorem exists_kernelPrefix_head_notMem_maximalIdeal_mul
    (φ : A →+* B) {K : Ideal A} (hK : K ≤ maximalIdeal A)
    (hφKerNe : RingHom.ker φ ≠ ⊥)
    {c : ℕ} {p : Fin c → maximalIdeal A}
    (hpart : IsPartOfRegularSystemOfParameters (maximalIdeal A).spanFinrank p)
    (hp : parameterIdeal p = RingHom.ker φ) :
    ∃ a : A, a ∈ RingHom.ker φ ∧ a ∉ maximalIdeal A * K := by
  -- Proof comment: the zero-length prefix would generate the zero ideal, contradicting the
  -- positive-kernel hypothesis. Thus the first prefix element is available.
  cases c with
  | zero =>
      exfalso
      apply hφKerNe
      calc
        RingHom.ker φ = parameterIdeal p := hp.symm
        _ = ⊥ := by
          simp [parameterIdeal_eq_span]
  | succ n =>
      refine ⟨((p 0 : maximalIdeal A) : A), ?_, ?_⟩
      · -- Proof comment: the head belongs to the prefix parameter ideal, hence to `ker φ`.
        rw [← hp, parameterIdeal_eq_span]
        exact Ideal.subset_span ⟨0, rfl⟩
      · -- Proof comment: if the head lay in `𝔪 K`, the containment `K ≤ 𝔪` would force it into
        -- `𝔪²`, contradicting the prefix head-minimality lemma.
        intro hmem
        have hnot_sq :
            ((p 0 : maximalIdeal A) : A) ∉ maximalIdeal A ^ 2 :=
          partOfRegularSystemOfParameters_head_not_mem_sq (A := A) hpart
        have hmul_le_sq : maximalIdeal A * K ≤ maximalIdeal A ^ 2 := by
          calc
            maximalIdeal A * K ≤ maximalIdeal A * maximalIdeal A := by
              exact mul_le_mul' le_rfl hK
            _ = maximalIdeal A ^ 2 := by
              rw [pow_two]
        exact hnot_sq (hmul_le_sq hmem)

