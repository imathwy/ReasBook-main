  have hfield : IsField A :=
    isField_of_isRegularLocalRing_of_ringKrullDim_eq_zero (R := A) hdim
  have hmax_bot : maximalIdeal A = ⊥ :=
    (IsLocalRing.isField_iff_maximalIdeal_eq (R := A)).1 hfield
  have hker_le_max : RingHom.ker φ ≤ maximalIdeal A :=
    IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top φ)
  exact le_bot_iff.mp (by simpa [hmax_bot] using hker_le_max)

