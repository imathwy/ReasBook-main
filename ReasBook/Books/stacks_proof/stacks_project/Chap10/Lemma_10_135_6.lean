/-- Helper for Lemma 10.135.6: after quotienting by a head element killed by `φ`, the images of
the tail generators span the kernel of the descended composite. -/
private theorem descendedCompositeKernelTailGeneratorsAfterHeadQuotient
    (φ : A →+* B) (ψ : B →+* C) {n : ℕ} {a : A} {z : Fin n → A}
    (ha : a ∈ RingHom.ker φ)
    (hspan : Ideal.span (Set.range (Fin.cons a z)) = RingHom.ker (ψ.comp φ)) :
    let I : Ideal A := Ideal.span ({a} : Set A)
    let φbar : A ⧸ I →+* B := Ideal.Quotient.lift I φ
      (span_singleton_le_ker_of_mem_ker φ ha)
    Ideal.span (Set.range fun i : Fin n ↦ Ideal.Quotient.mk I (z i)) =
      RingHom.ker (ψ.comp φbar) := by
  let I : Ideal A := Ideal.span ({a} : Set A)
  let q : A →+* A ⧸ I := Ideal.Quotient.mk I
  let φbar : A ⧸ I →+* B := Ideal.Quotient.lift I φ
    (span_singleton_le_ker_of_mem_ker φ ha)
  have hq_a : q a = 0 := by
    -- Proof comment: the quotient map kills the chosen principal generator.
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (by simp)
  -- Proof comment: map the head-plus-tail span to the quotient, where the head vanishes, and then
  -- identify the image of the composite kernel with the descended composite kernel.
  calc
    Ideal.span (Set.range fun i : Fin n ↦ Ideal.Quotient.mk I (z i)) =
        Ideal.map q (Ideal.span (Set.range (Fin.cons a z))) := by
          rw [ideal_map_span_fin_cons_eq_span_tail_of_head_mem_ker q a z hq_a]
    _ = Ideal.map q (RingHom.ker (ψ.comp φ)) := by rw [hspan]
    _ = RingHom.ker (ψ.comp φbar) := by
          simpa [I, q, φbar] using
            map_composite_kernel_eq_descended_kernel_after_head_quotient φ ψ ha

/-- Helper for Lemma 10.135.6: the first element of a regular system of parameters has nonzero
cotangent class, equivalently it does not lie in the square of the maximal ideal. -/
private theorem regularSystemOfParameters_head_not_mem_sq {n : ℕ}
    {x : Fin (n + 1) → maximalIdeal A} (hx : IsRegularSystemOfParameters x) :
    ((x 0 : maximalIdeal A) : A) ∉ maximalIdeal A ^ 2 := by
  -- Proof comment: if the head vanished in the cotangent space, the remaining `n` classes would
  -- span a cotangent space of finrank `n + 1`, contradicting the cardinality bound.
  intro hx_sq
  have hspan_ambient :
      Ideal.span (Set.range fun i : Fin (n + 1) ↦ ((x i : maximalIdeal A) : A)) =
        maximalIdeal A := by
    simpa [parameterIdeal_eq_span] using hx.2
  have hspan_full :
      Submodule.span A (Set.range x) = ⊤ := by
    -- Proof comment: the parameter ideal equality says that the same family spans the maximal
    -- ideal as a submodule of itself.
    simpa using
      span_subtype_eq_top_of_ideal_span_eq (I := maximalIdeal A)
        (w := fun i : Fin (n + 1) ↦ ((x i : maximalIdeal A) : A)) hspan_ambient
  have hspan_image_full :
      Submodule.span (ResidueField A) ((maximalIdeal A).toCotangent '' Set.range x) = ⊤ := by
    exact (CotangentSpace.span_image_eq_top_iff (R := A) (s := Set.range x)).2 hspan_full
  let tail : Fin n → CotangentSpace A :=
    fun i ↦ (maximalIdeal A).toCotangent (x i.succ)
  have htail_top : Submodule.span (ResidueField A) (Set.range tail) = ⊤ := by
    apply top_unique
    rw [← hspan_image_full]
    refine Submodule.span_le.2 ?_
    rintro y ⟨m, ⟨i, rfl⟩, rfl⟩
    refine Fin.cases ?_ ?_ i
    · -- Proof comment: the head class is zero by the square-membership assumption.
      have hhead_zero : (maximalIdeal A).toCotangent (x 0) = 0 :=
        ((maximalIdeal A).toCotangent_eq_zero (x 0)).2 hx_sq
      simpa [hhead_zero] using
        (Submodule.zero_mem (Submodule.span (ResidueField A) (Set.range tail)))
    · intro j
      exact Submodule.subset_span ⟨j, rfl⟩
  have hfinrank_le : Module.finrank (ResidueField A) (CotangentSpace A) ≤ n :=
    by simpa using finrank_le_of_span_eq_top (v := tail) htail_top
  have hfinrank_eq :
      Module.finrank (ResidueField A) (CotangentSpace A) = n + 1 := by
    have hspanfin :
        (maximalIdeal A).spanFinrank = n + 1 := by
      have hdim : ringKrullDim A = n + 1 :=
        (isRegularSystemOfParameters_iff x).1 hx |>.1
      have hcast :
          (((maximalIdeal A).spanFinrank : ℕ∞) : WithBot ℕ∞) =
            ((n + 1 : ℕ∞) : WithBot ℕ∞) := by
        calc
          (((maximalIdeal A).spanFinrank : ℕ∞) : WithBot ℕ∞) = ringKrullDim A := by
            simpa using
              (isRegularLocalRing_iff (R := A)).1 (inferInstance : IsRegularLocalRing A)
          _ = ((n + 1 : ℕ∞) : WithBot ℕ∞) := hdim
      exact_mod_cast hcast
    simpa [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace (R := A)] using
      hspanfin
  omega

/-- Helper for Chap10 Lemma 10 135 6: the head of a nonempty prefix of a regular system of
parameters is still outside the square of the maximal ideal. -/
private theorem partOfRegularSystemOfParameters_head_not_mem_sq {d n : ℕ}
    {x : Fin (n + 1) → maximalIdeal A} (hx : IsPartOfRegularSystemOfParameters d x) :
    ((x 0 : maximalIdeal A) : A) ∉ maximalIdeal A ^ 2 := by
  -- Proof comment: complete the prefix to a full regular system and apply the head lemma to the
  -- completed family; `Fin.append` leaves the zeroth prefix entry unchanged.
  rcases hx with ⟨y, hy⟩
  let k : ℕ := d - (n + 1)
  have hlen : n + k + 1 = (n + 1) + k := by omega
  let full : Fin (n + k + 1) → maximalIdeal A := fun i ↦ Fin.append x y (Fin.cast hlen i)
  have hfull_reg : IsRegularSystemOfParameters full := by
    rw [isRegularSystemOfParameters_iff] at hy ⊢
    constructor
    · simpa [k, hlen] using hy.1
    · have hrange :
          Set.range (fun i : Fin (n + k + 1) ↦ ((full i : maximalIdeal A) : A)) =
            Set.range
              (fun i : Fin ((n + 1) + k) ↦ ((Fin.append x y i : maximalIdeal A) : A)) := by
        ext a
        constructor
        · rintro ⟨i, rfl⟩
          exact ⟨Fin.cast hlen i, rfl⟩
        · rintro ⟨i, rfl⟩
          refine ⟨Fin.cast hlen.symm i, ?_⟩
          simp [full]
      rw [parameterIdeal_eq_span, hrange]
      simpa [parameterIdeal_eq_span] using hy.2
  have hfull :
      ((full 0 : maximalIdeal A) : A) ∉ maximalIdeal A ^ 2 := by
    simpa using
      (regularSystemOfParameters_head_not_mem_sq
        (x := full) hfull_reg)
  simpa [full, k, hlen] using hfull

