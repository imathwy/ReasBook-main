/-- Helper for Lemma 10.135.6: a surjective left factor maps the composite kernel onto the
right-hand kernel. -/
private theorem ideal_map_composite_kernel_eq_right_kernel_of_surjective
    (φ : A →+* B) (ψ : B →+* C) (hφ : Function.Surjective φ) :
    Ideal.map φ (RingHom.ker (ψ.comp φ)) = RingHom.ker ψ := by
  -- Proof comment: every element of the right kernel has a lift, and membership in the composite
  -- kernel is exactly the lifted zero condition.
  ext b
  constructor
  · intro hb
    rcases (Ideal.mem_map_iff_of_surjective
      (f := φ) (hf := hφ) (I := RingHom.ker (ψ.comp φ)) (y := b)).1 hb with
      ⟨a, ha, rfl⟩
    rw [RingHom.mem_ker] at ha ⊢
    simpa [RingHom.comp_apply] using ha
  · intro hb
    rcases hφ b with ⟨a, rfl⟩
    refine (Ideal.mem_map_iff_of_surjective
      (f := φ) (hf := hφ) (I := RingHom.ker (ψ.comp φ)) (y := φ a)).2 ?_
    refine ⟨a, ?_, rfl⟩
    rw [RingHom.mem_ker] at hb ⊢
    simpa [RingHom.comp_apply] using hb

