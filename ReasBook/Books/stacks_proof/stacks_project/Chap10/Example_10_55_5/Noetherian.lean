import StacksProject_2024.Chap10.Example_10_55_5.PolynomialEvaluation

noncomputable section

universe u

section

variable (k : Type u) [Field k]

local notation "E" => (Polynomial.X ^ 2 - Polynomial.X : Polynomial k)
local notation "Z" => ((Polynomial.X ^ 2 - Polynomial.X : Polynomial k) * Polynomial.X)

/-- Helper for Chap10 Example 10 55 5: the equal-endpoint subring, with the same carrier, viewed
as a `k`-subalgebra of `k[X]`. -/
noncomputable def equal_endpoint_poly_subalgebra : Subalgebra k (Polynomial k) :=
  { equal_endpoint_poly_subring k with
    algebraMap_mem' := fun a => by
      -- Constant polynomials take the same value at both endpoints, so the `k`-algebra map lands in
      -- the equal-endpoint carrier.
      change Polynomial.C a ∈ equal_endpoint_poly_subring k
      rw [mem_equal_endpoint_poly_subring_iff]
      simp }

/-- Helper for Chap10 Example 10 55 5: the subalgebra owner and the original subring owner have
identical underlying rings. -/
noncomputable def equal_endpoint_poly_subalgebra_ringEquiv :
    equal_endpoint_poly_subalgebra k ≃+* equal_endpoint_poly_subring k where
  toFun x := ⟨x.1, x.2⟩
  invFun x := ⟨x.1, x.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl
  map_add' _ _ := rfl

/-- Helper for Chap10 Example 10 55 5: the conductor polynomial factors as `X * (X - 1)`. -/
theorem equal_endpoint_conductor_factorization :
    E = Polynomial.X * (Polynomial.X - Polynomial.C (1 : k)) := by
  -- Expand `X^2` and factor the common `X`.
  calc
    (Polynomial.X ^ 2 - Polynomial.X : Polynomial k) =
        Polynomial.X * Polynomial.X - Polynomial.X * Polynomial.C (1 : k) := by
      simp [pow_two]
    _ = Polynomial.X * (Polynomial.X - Polynomial.C (1 : k)) := by
      ring

/-- Helper for Chap10 Example 10 55 5: every monomial multiple
`(X^2 - X) * X^n` lies in the algebra generated by `X^2 - X` and `(X^2 - X)X`. -/
theorem equal_endpoint_conductor_mul_X_pow_mem_adjoin (n : ℕ) :
    E * Polynomial.X ^ n ∈ Algebra.adjoin k ({E, Z} : Set (Polynomial k)) := by
  let A : Subalgebra k (Polynomial k) := Algebra.adjoin k ({E, Z} : Set (Polynomial k))
  change E * Polynomial.X ^ n ∈ A
  -- The recurrence `E X^(n+2) = E X^(n+1) + E * (E X^n)` follows from `X^2 = X + E`.
  induction n using Nat.twoStepInduction with
  | zero =>
      simpa using (Algebra.subset_adjoin (R := k) (Set.mem_insert E {Z}) : E ∈ A)
  | one =>
      change E * Polynomial.X ^ 1 ∈ A
      simpa [pow_one] using
        (Algebra.subset_adjoin (R := k) (Set.mem_insert_of_mem E (Set.mem_singleton Z)) :
          Z ∈ A)
  | more n hn hn1 =>
      have hE : E ∈ A :=
        (Algebra.subset_adjoin (R := k) (Set.mem_insert E {Z}) : E ∈ A)
      have hmul : E * (E * Polynomial.X ^ n) ∈ A := A.mul_mem hE hn
      have hsum : E * Polynomial.X ^ (n + 1) + E * (E * Polynomial.X ^ n) ∈ A :=
        A.add_mem hn1 hmul
      convert hsum using 1
      ring_nf

/-- Helper for Chap10 Example 10 55 5: every conductor multiple lies in the algebra generated by
`X^2 - X` and `(X^2 - X)X`. -/
theorem equal_endpoint_conductor_mul_mem_adjoin (q : Polynomial k) :
    E * q ∈ Algebra.adjoin k ({E, Z} : Set (Polynomial k)) := by
  let A : Subalgebra k (Polynomial k) := Algebra.adjoin k ({E, Z} : Set (Polynomial k))
  change E * q ∈ A
  -- Reduce from arbitrary polynomials to monomials; scalar multiples are absorbed by the
  -- `k`-subalgebra structure.
  induction q using Polynomial.induction_on' with
  | add p q hp hq =>
      simpa [mul_add] using A.add_mem hp hq
  | monomial n a =>
      have hpow : E * Polynomial.X ^ n ∈ A := by
        simpa using equal_endpoint_conductor_mul_X_pow_mem_adjoin (k := k) n
      have hscaled : Polynomial.C a * (E * Polynomial.X ^ n) ∈ A := by
        simpa [Algebra.smul_def] using A.smul_mem hpow a
      convert hscaled using 1
      rw [← Polynomial.C_mul_X_pow_eq_monomial]
      ring

/-- Helper for Chap10 Example 10 55 5: an equal-endpoint polynomial is a constant plus a conductor
multiple. -/
theorem equal_endpoint_sub_constant_conductor_multiple
    (f : Polynomial k) (hf : f.eval 0 = f.eval 1) :
    ∃ q : Polynomial k, f = Polynomial.C (f.eval 0) + E * q := by
  let g : Polynomial k := f - Polynomial.C (f.eval 0)
  have hg0 : g.eval 0 = 0 := by
    simp [g]
  have hg1 : g.eval 1 = 0 := by
    simp [g, hf]
  -- Vanishing at both endpoints gives divisibility by the coprime factors `X` and `X - 1`.
  have hX : Polynomial.X ∣ g := by
    apply Polynomial.X_dvd_iff.mpr
    simpa [Polynomial.coeff_zero_eq_eval_zero] using hg0
  have hX1 : Polynomial.X - Polynomial.C (1 : k) ∣ g := by
    simpa [hg1] using
      (Polynomial.X_sub_C_dvd_sub_C_eval (p := g) (a := (1 : k)))
  have hcoprime : IsCoprime (Polynomial.X : Polynomial k) (Polynomial.X - Polynomial.C (1 : k)) := by
    simpa using
      (Polynomial.isCoprime_X_sub_C_of_isUnit_sub
        (a := (0 : k)) (b := (1 : k))
        (show IsUnit ((0 : k) - 1) by
          exact isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr zero_ne_one)))
  rcases hcoprime.mul_dvd hX hX1 with ⟨q, hq⟩
  refine ⟨q, ?_⟩
  have hg : g = E * q := by
    calc
      g = (Polynomial.X * (Polynomial.X - Polynomial.C (1 : k))) * q := by
        simpa [mul_assoc] using hq
      _ = E * q := by
        rw [← equal_endpoint_conductor_factorization (k := k)]
  calc
    f = Polynomial.C (f.eval 0) + g := by simp [g]
    _ = Polynomial.C (f.eval 0) + E * q := by rw [hg]

/-- Helper for Chap10 Example 10 55 5: as a `k`-algebra, the equal-endpoint ring is generated by
`X^2 - X` and `(X^2 - X)X`. -/
theorem equal_endpoint_poly_subalgebra_eq_adjoin :
    equal_endpoint_poly_subalgebra k =
      Algebra.adjoin k ({E, Z} : Set (Polynomial k)) := by
  let A : Subalgebra k (Polynomial k) := Algebra.adjoin k ({E, Z} : Set (Polynomial k))
  apply le_antisymm
  · intro f hf
    change f ∈ A
    -- Write an equal-endpoint polynomial as its endpoint constant plus a conductor multiple.
    have hf' : f.eval 0 = f.eval 1 := by
      simpa [Polynomial.coeff_zero_eq_eval_zero, equal_endpoint_poly_subalgebra,
        mem_equal_endpoint_poly_subring_iff] using hf
    rcases equal_endpoint_sub_constant_conductor_multiple (k := k) f hf' with ⟨q, hq⟩
    rw [hq]
    exact A.add_mem (Subalgebra.algebraMap_mem A (f.eval 0))
      (by simpa using equal_endpoint_conductor_mul_mem_adjoin (k := k) q)
  · refine Algebra.adjoin_le ?_
    intro f hf
    -- The two proposed generators themselves have equal endpoint values.
    rcases hf with hE | hZ
    · subst hE
      change E ∈ equal_endpoint_poly_subring k
      rw [mem_equal_endpoint_poly_subring_iff]
      simp
    · subst hZ
      change Z ∈ equal_endpoint_poly_subring k
      rw [mem_equal_endpoint_poly_subring_iff]
      simp

/-- Helper for Chap10 Example 10 55 5: the equal-endpoint ring is a finitely generated
`k`-algebra. -/
theorem equal_endpoint_poly_subalgebra_fg :
    (equal_endpoint_poly_subalgebra k).FG := by
  -- The explicit two-element generating set gives finite generation.
  refine Subalgebra.fg_def.mpr ⟨{E, Z}, by simp, ?_⟩
  exact (equal_endpoint_poly_subalgebra_eq_adjoin (k := k)).symm

/-- Helper for Chap10 Example 10 55 5: the equal-endpoint ring is Noetherian. -/
theorem equal_endpoint_poly_subring_isNoetherian :
    IsNoetherianRing (equal_endpoint_poly_subring k) := by
  -- Hilbert basis for finitely generated algebras over the field `k` proves the subalgebra owner;
  -- the ring equivalence transfers the result to the original subring owner used by the target.
  let _ : IsNoetherianRing (equal_endpoint_poly_subalgebra k) :=
    isNoetherianRing_of_fg (equal_endpoint_poly_subalgebra_fg (k := k))
  exact isNoetherianRing_of_ringEquiv (equal_endpoint_poly_subalgebra k)
    (equal_endpoint_poly_subalgebra_ringEquiv (k := k))

end
