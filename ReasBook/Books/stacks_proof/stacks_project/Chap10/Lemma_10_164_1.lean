import Mathlib.RingTheory.Finiteness.Descent
import Mathlib.Tactic.StacksAttribute

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

section

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]

/- Layering for this item:
* source-facing: Noetherianity descends along a faithfully flat ring map;
* core/canonical owners: `RingHom.FaithfullyFlat` and `IsNoetherianRing`;
* bridge/view: `RingHom.faithfullyFlat_algebraMap_iff` and
  `Ideal.FG.of_FG_map_of_faithfullyFlat`.
-/

-- Proof sketch: for any ideal `I` of `R`, faithful flatness gives
-- `(I.map f).comap f = I`, so if `I.map f` is finitely generated then `I` is finitely generated by
-- `Ideal.FG.of_FG_map_of_faithfullyFlat`. Since `S` is Noetherian, every ideal of `S` is finitely
-- generated, hence every ideal of `R` is finitely generated, which is exactly `IsNoetherianRing R`.
/-- Lemma 10.164.1: if `f : R →+* S` is faithfully flat and `S` is Noetherian, then `R` is
Noetherian. -/
@[stacks 033E]
theorem isNoetherianRing_of_faithfullyFlat (f : R →+* S) (hf : f.FaithfullyFlat)
    [IsNoetherianRing S] : IsNoetherianRing R := by
  letI := f.toAlgebra
  haveI : Module.FaithfullyFlat R S :=
    (RingHom.faithfullyFlat_algebraMap_iff).mp <|
      by simpa [RingHom.algebraMap_toAlgebra] using hf
  refine (isNoetherianRing_iff_ideal_fg R).2 fun I ↦ ?_
  simpa [RingHom.algebraMap_toAlgebra] using
    (Ideal.FG.of_FG_map_of_faithfullyFlat ((I.map f).fg_of_isNoetherianRing))

end
