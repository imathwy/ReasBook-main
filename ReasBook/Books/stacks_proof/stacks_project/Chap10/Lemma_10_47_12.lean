variable {k K : Type u} [Field k] [Field K] [Algebra k K]

/-- Helper for Lemma 10.47.12: irreducibility of the prime spectrum of a product of a field
forces the index type to be subsingleton. -/
private theorem subsingleton_of_irreducibleSpace_primeSpectrum_pi_field
    {ι Ω : Type u} [Field Ω] :
    IrreducibleSpace (PrimeSpectrum (ι → Ω)) → Subsingleton ι := by
  classical
  intro hirr
  by_contra hnot
  rw [not_subsingleton_iff_nontrivial] at hnot
  letI : Nontrivial ι := hnot
  obtain ⟨i, j, hij⟩ := exists_pair_ne ι
  rw [PrimeSpectrum.irreducibleSpace_iff_isPrime_nilradical] at hirr
  let a : ι → Ω := Pi.single i 1
  let b : ι → Ω := Pi.single j 1
  have hab_zero : a * b = 0 := by
    ext x
    by_cases hxi : x = i
    · subst hxi
      simp [a, b, hij]
    · by_cases hxj : x = j
      · subst hxj
        simp [a, b, hij]
      · simp [a, b, hxi, hxj]
  have ha_not_nilpotent : ¬ IsNilpotent a := by
    intro ha_nilpotent
    obtain ⟨n, hn⟩ := ha_nilpotent
    have hvalue := congrFun hn i
    simp [a] at hvalue
  have hb_not_nilpotent : ¬ IsNilpotent b := by
    intro hb_nilpotent
    obtain ⟨n, hn⟩ := hb_nilpotent
    have hvalue := congrFun hn j
    simp [b] at hvalue
  have hab_mem : a * b ∈ nilradical (ι → Ω) := by
    exact mem_nilradical.mpr (hab_zero ▸ IsNilpotent.zero)
  rcases hirr.mem_or_mem hab_mem with ha_mem | hb_mem
  · exact ha_not_nilpotent (mem_nilradical.mp ha_mem)
  · exact hb_not_nilpotent (mem_nilradical.mp hb_mem)

/-- Helper for Lemma 10.47.12: a separable element of a geometrically irreducible field extension
already lies in the base field. -/
private theorem mem_bot_of_isSeparable_of_geometricallyIrreducible
    {α : K}
    (hgeom : GeometricallyIrreducible (Spec.map (ofHom (algebraMap k K))))
    (hα : IsSeparable k α) :
    α ∈ (⊥ : IntermediateField k K) := by
  classical
  let L : IntermediateField k K := k⟮α⟯
  letI : FiniteDimensional k L := IntermediateField.adjoin.finiteDimensional hα.isIntegral
  letI : Algebra.IsAlgebraic k L := Algebra.IsAlgebraic.of_finite k L
  have hsepL : Algebra.IsSeparable k L := by
    -- Proof comment: the simple subextension generated by a separable element is separable.
    simpa [L] using
      (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable
        (F := k) (E := K) (x := α)).2 hα
  letI : Algebra.IsSeparable k L := hsepL
  have hgeomL : GeometricallyIrreducible (Spec.map (ofHom (algebraMap k L))) := by
    -- Proof comment: geometric irreducibility descends to the simple subextension.
    simpa [L] using
      Algebra.geometricallyIrreducible_subalgebra (S := L.toSubalgebra) hgeom
  have hirrTensor : IrreducibleSpace (PrimeSpectrum (L ⊗[k] AlgebraicClosure k)) := by
    -- Proof comment: test geometric irreducibility after base change to an algebraic closure.
    exact
      (geometricallyIrreducible_iff_irreducibleSpace_primeSpectrum_algebraicClosure
        (k := k) (R := L)).1 hgeomL
  let e :
      L ⊗[k] AlgebraicClosure k ≃ₐ[AlgebraicClosure k]
        ((L →ₐ[k] AlgebraicClosure k) → AlgebraicClosure k) :=
    tensorProductToPiAlgEquiv (F := k) (K := L) (L := AlgebraicClosure k)
  have hirrPi :
      IrreducibleSpace
        (PrimeSpectrum ((L →ₐ[k] AlgebraicClosure k) → AlgebraicClosure k)) := by
    -- Proof comment: identify the tensor product with the product over all embeddings.
    exact (PrimeSpectrum.homeomorphOfRingEquiv e.toRingEquiv).irreducibleSpace_iff.1 hirrTensor
  have hsub :
      Subsingleton (L →ₐ[k] AlgebraicClosure k) :=
    subsingleton_of_irreducibleSpace_primeSpectrum_pi_field hirrPi
  letI : Subsingleton (L →ₐ[k] AlgebraicClosure k) := hsub
  let σ : L →ₐ[k] AlgebraicClosure k :=
    IsAlgClosed.lift (R := k) (S := L) (M := AlgebraicClosure k)
  have hcard_one : Nat.card (L →ₐ[k] AlgebraicClosure k) = 1 := by
    -- Proof comment: the irreducible product has exactly one factor, hence one embedding.
    rw [Nat.card_eq_one_iff_unique]
    exact ⟨hsub, ⟨σ⟩⟩
  have hcount :
      Nat.card (L →ₐ[k] AlgebraicClosure k) ≤ Module.finrank k L ∧
        (Nat.card (L →ₐ[k] AlgebraicClosure k) = Module.finrank k L ↔
          Algebra.IsSeparable k L) :=
    algHom_natCard_to_algebraicClosure_le_finrank_and_eq_iff_isSeparable
      (F := k) (K := L)
  have hfinrank_one : Module.finrank k L = 1 := by
    -- Proof comment: separability turns the unique-embedding count into degree one.
    have hEq :
        Nat.card (L →ₐ[k] AlgebraicClosure k) = Module.finrank k L :=
      (hcount.2).2 hsepL
    rw [hcard_one] at hEq
    exact hEq.symm
  -- Proof comment: degree-one simple extensions are exactly the trivial ones.
  exact
    (IntermediateField.finrank_adjoin_simple_eq_one_iff
      (F := k) (E := K) (α := α)).1 (by simpa [L] using hfinrank_one)

/-- Helper for Lemma 10.47.12: triviality of the separable closure forces the algebraic part of
the extension to be purely inseparable over the base field. -/
private theorem isPurelyInseparable_algebraicClosure_of_separableClosure_eq_bot
    (hsep : separableClosure k K = ⊥) :
    IsPurelyInseparable k (algebraicClosure k K) := by
  let A : IntermediateField k K := algebraicClosure k K
  have hA_sep_bot : separableClosure k A = ⊥ := by
    apply bot_unique
    intro x hx
    -- Proof comment: any separable element of the algebraic part is separable in `K`, so the
    -- hypothesis collapses it back to the base field.
    have hxK_sep : IsSeparable k ((x : A) : K) := by
      exact IsSeparable.map A.val A.val.injective (mem_separableClosure_iff.1 hx)
    have hxK_bot : ((x : A) : K) ∈ (⊥ : IntermediateField k K) := by
      simpa [hsep] using
        (mem_separableClosure_iff.2 hxK_sep : ((x : A) : K) ∈ separableClosure k K)
    rcases IntermediateField.mem_bot.mp hxK_bot with ⟨y, hy⟩
    exact IntermediateField.mem_bot.mpr ⟨y, Subtype.ext (by simpa using hy)⟩
  letI : Algebra.IsAlgebraic k A := algebraicClosure.isAlgebraic k K
  exact (separableClosure.eq_bot_iff (F := k) (E := A)).1 hA_sep_bot

/-- Helper for Lemma 10.47.12: purely inseparable field extensions are geometrically irreducible
because every field-valued base change is homeomorphic to the base-changed base field. -/
private theorem isGeometricallyIrreducibleOver_of_isPurelyInseparable
    {F E : Type u} [Field F] [Field E] [Algebra F E]
    (hpi : IsPurelyInseparable F E) :
    GeometricallyIrreducible (Spec.map (ofHom (algebraMap F E))) := by
  letI : IsPurelyInseparable F E := hpi
  rw [geometricallyIrreducible_iff_irreducibleSpace_primeSpectrum_baseChange]
  intro L _ _
  let eBase : F ⊗[F] L ≃ₐ[F] L := Algebra.TensorProduct.lid F L
  have hirrBase : IrreducibleSpace (PrimeSpectrum (F ⊗[F] L)) := by
    -- Proof comment: the base tensor product is canonically the field `L`.
    exact (PrimeSpectrum.homeomorphOfRingEquiv eBase.toRingEquiv).irreducibleSpace_iff.2 inferInstance
  let hHomeo :
      IsHomeomorph
        (PrimeSpectrum.comap
          ((Algebra.TensorProduct.map
            (Algebra.ofId F E) (AlgHom.id F L)).toRingHom)) :=
    PrimeSpectrum.isHomeomorph_comap_tensorProductMap_of_isPurelyInseparable
      (K := F) (R := F) (S := L) (L := E)
  -- Proof comment: pure inseparability makes the comparison on prime spectra a homeomorphism.
  exact (hHomeo.homeomorph _).irreducibleSpace_iff.2 hirrBase

-- Proof sketch: for the forward implication, if `α` is separable over `k`, then the simple
-- extension `k⟮α⟯ / k` is a finite separable subextension of `K`; geometric irreducibility forces
-- this subextension to be trivial, so `α` lies in `k`. For the converse, the hypothesis says the
-- algebraic closure of `k` inside `K` is purely inseparable over `k`; combine Lemma `10.47.8`
-- with the geometric irreducibility of purely inseparable extensions and then apply transitivity
-- from Lemma `10.47.9`.
/-- Lemma 10.47.12: a field extension `K / k` is geometrically irreducible exactly when its
relative separable closure in `K` is trivial. -/
@[stacks 0G33]
theorem isGeometricallyIrreducibleOver_iff_separableClosure_eq_bot :
    GeometricallyIrreducible (Spec.map (ofHom (algebraMap k K))) ↔
      separableClosure k K = ⊥ := by
  constructor
  · intro hgeom
    -- Proof comment: test the hypothesis on each separable element and collapse every simple
    -- separable subextension to degree one.
    apply bot_unique
    intro α hα
    exact mem_bot_of_isSeparable_of_geometricallyIrreducible hgeom hα
  · intro hsep
    let A : IntermediateField k K := algebraicClosure k K
    have hA_pure : IsPurelyInseparable k A :=
      isPurelyInseparable_algebraicClosure_of_separableClosure_eq_bot
        (k := k) (K := K) hsep
    have hA_geom : GeometricallyIrreducible (Spec.map (ofHom (algebraMap k A))) :=
      isGeometricallyIrreducibleOver_of_isPurelyInseparable
        (F := k) (E := A) hA_pure
    have hAK_closed : algebraicClosure A K = ⊥ := by
      apply bot_unique
      intro x hx
      -- Proof comment: anything algebraic over the algebraic part is already algebraic over `k`,
      -- hence already lies in the algebraic part itself.
      letI : Algebra.IsAlgebraic k A := algebraicClosure.isAlgebraic k K
      letI : Algebra.IsIntegral k A := Algebra.IsAlgebraic.isIntegral
      have hx_int_A : IsIntegral A x := (mem_algebraicClosure_iff'.1 hx)
      have hx_int_k : IsIntegral k x := isIntegral_trans x hx_int_A
      have hxA : x ∈ A := by
        simpa [A] using (mem_algebraicClosure_iff'.2 hx_int_k : x ∈ algebraicClosure k K)
      exact IntermediateField.mem_bot.mpr ⟨⟨x, hxA⟩, rfl⟩
    have hAK_geom : GeometricallyIrreducible (Spec.map (ofHom (algebraMap A K))) :=
      isGeometricallyIrreducibleOver_of_algebraicClosure_eq_bot
        (k := A) (K := K) hAK_closed
    letI : GeometricallyIrreducible (Spec.map (ofHom (algebraMap k A))) := hA_geom
    letI : GeometricallyIrreducible (Spec.map (ofHom (algebraMap A K))) := hAK_geom
    -- Proof comment: combine geometric irreducibility of the algebraic part and of the remaining
    -- extension using the tower criterion.
    exact geometrically_irreducible_over_base_of_tower k A K

/-- Lemma 10.47.12, source form: a field extension `K / k` is geometrically irreducible exactly
when every separable element of `K` already lies in the base field `k`. -/
@[stacks 0G33]
theorem isGeometricallyIrreducibleOver_iff_forall_separable_mem_bot :
    GeometricallyIrreducible (Spec.map (ofHom (algebraMap k K))) ↔
      ∀ α : K, IsSeparable k α → α ∈ (⊥ : IntermediateField k K) := by
  refine isGeometricallyIrreducibleOver_iff_separableClosure_eq_bot.trans ?_
  constructor
  · intro h α hα
    simpa [h] using (mem_separableClosure_iff.2 hα : α ∈ separableClosure k K)
  · intro h
    exact bot_unique fun α hα ↦ h α (mem_separableClosure_iff.1 hα)

end

end Algebra
