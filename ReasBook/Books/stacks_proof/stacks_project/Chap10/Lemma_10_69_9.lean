universe u v

open RingTheory
open Ideal
open scoped TensorProduct

namespace RingTheory.Sequence

attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- Helper for Lemma 10.69.9: locally recover the quasi-regularity predicate from the stable
backup associated-graded model. -/
def IsQuasiRegular (M : Type v) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  Function.Bijective (quasiRegularSequenceAssociatedGradedMap M rs)

/-- Helper for Lemma 10.69.9: the quotient module by `⋂ n, J^n M` carries the canonical action of
the quotient ring by `⋂ n, J^n`. -/
private instance (J : Ideal R) :
    Module (R ⧸ (⨅ n : ℕ, (J ^ n : Ideal R)))
      (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M))) := by
  let K : Ideal R := ⨅ n : ℕ, J ^ n
  have hK :
      Module.IsTorsionBySet R
        (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M)))
        (K : Set R) := by
    rw [Module.isTorsionBySet_quotient_iff]
    intro x r hr
    change r ∈ (⨅ n : ℕ, (J ^ n : Ideal R)) at hr
    rw [Submodule.mem_iInf]
    intro n
    exact Submodule.smul_mem_smul ((iInf_le (fun n : ℕ ↦ J ^ n) n) hr) (by simp)
  change Module (R ⧸ K) (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M)))
  exact Module.IsTorsionBySet.module hK

/-- Helper for Lemma 10.69.9: the quotient module by `⋂ n, J^n M` also forms a scalar tower over
`R → R / ⋂ n, J^n`. -/
private instance (J : Ideal R) :
    IsScalarTower R (R ⧸ (⨅ n : ℕ, (J ^ n : Ideal R)))
      (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M))) := by
  let K : Ideal R := ⨅ n : ℕ, J ^ n
  have hK :
      Module.IsTorsionBySet R
        (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M)))
        (K : Set R) := by
    rw [Module.isTorsionBySet_quotient_iff]
    intro x r hr
    change r ∈ (⨅ n : ℕ, (J ^ n : Ideal R)) at hr
    rw [Submodule.mem_iInf]
    intro n
    exact Submodule.smul_mem_smul ((iInf_le (fun n : ℕ ↦ J ^ n) n) hr) (by simp)
  change IsScalarTower R (R ⧸ K) (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M)))
  exact Module.IsTorsionBySet.isScalarTower hK

/-- Helper for Lemma 10.69.9: injectivity is preserved across a commuting square whose horizontal
maps are equivalences. -/
private theorem injective_iff_of_equiv_conjugate
    {α : Type*} {β : Type*} {γ : Type*} {δ : Type*}
    (eSrc : α ≃ β) (eTgt : γ ≃ δ)
    (f : α → γ) (g : β → δ)
    (hcomm : eTgt ∘ f = g ∘ eSrc) :
    Function.Injective f ↔ Function.Injective g := by
  -- Transfer injectivity across the conjugation square by moving equalities through the two
  -- equivalences.
  constructor
  · intro hf x y hxy
    apply eSrc.symm.injective
    apply hf
    apply eTgt.injective
    calc
      eTgt (f (eSrc.symm x)) = g x := by
        simpa [Function.comp] using congrFun hcomm (eSrc.symm x)
      _ = g y := hxy
      _ = eTgt (f (eSrc.symm y)) := by
        simpa [Function.comp] using (congrFun hcomm (eSrc.symm y)).symm
  · intro hg x y hxy
    apply eSrc.injective
    apply hg
    calc
      g (eSrc x) = eTgt (f x) := by
        simpa [Function.comp] using (congrFun hcomm x).symm
      _ = eTgt (f y) := by
        rw [hxy]
      _ = g (eSrc y) := by
        simpa [Function.comp] using congrFun hcomm y

/-- Helper for Lemma 10.69.9: the associated-graded comparison map is always surjective, so
quasi-regularity is equivalent to injectivity. -/
private theorem isQuasiRegular_iff_injective (rs : List R) :
    IsQuasiRegular M rs ↔ Function.Injective (quasiRegularSequenceAssociatedGradedMap M rs) := by
  -- The defining map is always surjective in the backup associated-graded model, so bijectivity
  -- reduces to injectivity.
  constructor
  · exact Function.Bijective.injective
  · intro h
    exact ⟨h, quasiRegularSequenceAssociatedGradedMap_surjective M rs⟩

/-- Helper for Lemma 10.69.9: the ideal generated by the images of `rs` in `R / ⋂ J^n` is the map
of `Ideal.ofList rs`. -/
private theorem iInf_pow_map_ofList
    (rs : List R) :
    Ideal.map
        (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R)))
        (Ideal.ofList rs) =
      Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R)))) := by
  -- The quotient-side list ideal is exactly the image ideal under the canonical quotient map.
  simpa using
    (Ideal.map_ofList
      (f := Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R))) rs)

/-- Helper for Lemma 10.69.9: `⋂ n, J^n` is contained in `J`. -/
private theorem iInf_pow_le_ofList (rs : List R) :
    (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R)) ≤ Ideal.ofList rs := by
  -- The intersection is contained in its first nontrivial stage `J = J^1`.
  simpa using (iInf_le (fun n : ℕ ↦ ((Ideal.ofList rs) ^ n : Ideal R)) 1)

/-- Helper for Lemma 10.69.9: the quotient-side ideal generated by the images of `rs` is the map
of `Ideal.ofList rs`. -/
private theorem iInf_pow_ofList_map_eq (rs : List R) :
    Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R)))) =
      (Ideal.ofList rs).map
        (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R))) := by
  -- This is exactly the earlier list-ideal map identity, rewritten in the quotient-first order.
  simpa using (iInf_pow_map_ofList (R := R) rs).symm

/-- Helper for Lemma 10.69.9: quotienting first by `⋂ n, J^n` and then by the image of `J`
is canonically the same ring as quotienting directly by `J`. -/
private noncomputable def iInf_pow_ofList_quotient_ringEquiv
    (rs : List R) :
    ((R ⧸ (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R))) ⧸
      Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R))))) ≃+*
      R ⧸ Ideal.ofList rs :=
  -- Combine the image-ideal identification with the usual quotient-of-quotient equivalence.
  (Ideal.quotEquivOfEq (iInf_pow_ofList_map_eq (R := R) rs)).trans
    (DoubleQuot.quotQuotEquivQuotOfLE (iInf_pow_le_ofList (R := R) rs))

/-- Helper for Lemma 10.69.9: each quotient-side stage `J̄^n M̄` is exactly the image of
`J^n M` under the quotient map `M → M / ⋂ J^n M`. -/
private theorem iInf_pow_ofList_pow_smul_top_mem_iff
    (rs : List R) (n : ℕ)
    {y : M ⧸ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M))} :
    y ∈
        idealAssociatedGradedStage
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))))
          (M ⧸ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M))) n ↔
      y ∈
        (idealAssociatedGradedStage (Ideal.ofList rs) M n).map
          (Submodule.mkQ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M))) := by
  let K : Ideal R := ⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)
  let KM : Submodule R M := ⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)
  have hmapPow :
      Ideal.map (Ideal.Quotient.mk K) ((Ideal.ofList rs) ^ n) =
        (Ideal.ofList (rs.map (Ideal.Quotient.mk K))) ^ n := by
    -- The image of `J^n` in `R / ⋂ J^m` is exactly `J̄^n`.
    simpa [Ideal.map_pow] using
      congrArg (fun I : Ideal (R ⧸ K) ↦ I ^ n) (iInf_pow_map_ofList (R := R) rs)
  have hstage :
      (idealAssociatedGradedStage
          (Ideal.ofList (rs.map (Ideal.Quotient.mk K)))
          (M ⧸ KM) n).restrictScalars R =
        (idealAssociatedGradedStage (Ideal.ofList rs) M n).map (Submodule.mkQ KM) := by
    -- Rewrite the quotient-side stage as the image ideal action, then identify it with the image
    -- of `J^n M` under the quotient map.
    calc
      (idealAssociatedGradedStage
          (Ideal.ofList (rs.map (Ideal.Quotient.mk K)))
          (M ⧸ KM) n).restrictScalars R
          = ((Ideal.map (Ideal.Quotient.mk K) ((Ideal.ofList rs) ^ n)) •
              (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R := by
              rw [idealAssociatedGradedStage, ← hmapPow]
      _ = ((Ideal.map (algebraMap R (R ⧸ K)) ((Ideal.ofList rs) ^ n)) •
              (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R := by
            rw [← Ideal.Quotient.algebraMap_eq]
      _ = ((Ideal.ofList rs) ^ n) • (⊤ : Submodule R (M ⧸ KM)) := by
            simpa using
              (Ideal.smul_restrictScalars
                (R := R) (S := R ⧸ K) (M := M ⧸ KM)
                ((Ideal.ofList rs) ^ n) (⊤ : Submodule (R ⧸ K) (M ⧸ KM)))
      _ = (idealAssociatedGradedStage (Ideal.ofList rs) M n).map (Submodule.mkQ KM) := by
            symm
            simp [idealAssociatedGradedStage, KM, Submodule.map_smul'', Submodule.range_mkQ]
  -- Membership is unchanged after restricting scalars from `R / ⋂ J^n` back to `R`.
  change y ∈
      (idealAssociatedGradedStage
        (Ideal.ofList (rs.map (Ideal.Quotient.mk K)))
        (M ⧸ KM) n).restrictScalars R ↔
    y ∈
      (idealAssociatedGradedStage (Ideal.ofList rs) M n).map
        (Submodule.mkQ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)))
  rw [hstage]

/-- Helper for Lemma 10.69.9: an element of `J ^ n M` maps to the `n`-th stage after quotienting
by `⋂ m, J ^ m M`. -/
private theorem iInf_pow_idealAssociatedGradedStageToQuotient_mem
    (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    Submodule.Quotient.mk
        ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
      idealAssociatedGradedStage
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) n := by
  -- Rewrite the quotient-side stage as the image of `J ^ n M` under the quotient map.
  rw [iInf_pow_ofList_pow_smul_top_mem_iff (R := R) (M := M) (rs := rs) n]
  exact Submodule.mem_map_of_mem x.2

/-- Helper for Lemma 10.69.9: every quotient-side stage element is represented by some element of
the original stage `J ^ n M`. -/
private theorem iInf_pow_idealAssociatedGradedStageToQuotient_exists
    (rs : List R) (n : ℕ)
    (y : idealAssociatedGradedStage
      (Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
      (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) n) :
    ∃ x : idealAssociatedGradedStage (Ideal.ofList rs) M n,
      Submodule.Quotient.mk (x : M) = (y : M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) := by
  rcases y with ⟨y, hy⟩
  -- Use the explicit image description of the quotient-side stage to lift the representative.
  rw [iInf_pow_ofList_pow_smul_top_mem_iff (R := R) (M := M) (rs := rs) n] at hy
  rcases Submodule.mem_map.1 hy with ⟨x, hx, rfl⟩
  exact ⟨⟨x, hx⟩, rfl⟩

/-- Helper for Lemma 10.69.9: if a class from `J^n M` lands in the next quotient-side stage, then
its representative already lies in `J^(n + 1) M`. -/
private theorem iInf_pow_stage_mem_succ_of_quotient_mem_succ
    (rs : List R) (n : ℕ)
    {x : idealAssociatedGradedStage (Ideal.ofList rs) M n}
    (hx :
      Submodule.Quotient.mk
          ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
        idealAssociatedGradedStage
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
          (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) (n + 1)) :
    ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
      idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1) := by
  let KM : Submodule R M := ⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)
  let y :
      idealAssociatedGradedStage
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (M ⧸ KM) (n + 1) :=
    ⟨Submodule.Quotient.mk (x : M), hx⟩
  rcases iInf_pow_idealAssociatedGradedStageToQuotient_exists
      (R := R) (M := M) (rs := rs) (n := n + 1) y with
    ⟨z, hz⟩
  have hz' :
      (Submodule.Quotient.mk (p := KM) (x : M) : M ⧸ KM) =
        Submodule.Quotient.mk (p := KM) (z : M) := by
    -- Reorient the lifted representative equality so it matches `Submodule.Quotient.eq`.
    simpa [y] using hz.symm
  have hdiff : (x : M) - z ∈ KM := by
    -- Equal quotient classes differ by an element of the `⋂ J^m M` kernel.
    exact (Submodule.Quotient.eq KM).1 hz'
  have hdiff' :
      (x : M) - z ∈ idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1) := by
    -- The kernel is contained in every stage, in particular in stage `n + 1`.
    exact (iInf_le (fun m : ℕ ↦ (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)) (n + 1)) hdiff
  -- Add the correction term back to the lifted stage representative.
  simpa [sub_eq_add_neg, add_assoc] using
    (idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1)).add_mem hdiff' z.2

/-- Helper for Lemma 10.69.9: the source and quotient-side degree-`n` graded pieces are identified
by sending the class of `x ∈ J ^ n M` to the class of its image in `M / ⋂ m, J ^ m M`. -/
private noncomputable def iInf_pow_idealAssociatedGradedPiece_equiv
    (rs : List R) (n : ℕ) :
    idealAssociatedGradedPiece (Ideal.ofList rs) M n ≃+
      idealAssociatedGradedPiece
        (R := R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) n := by
  let K : Ideal R := ⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)
  let KM : Submodule R M := ⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
  let stageMap :
      idealAssociatedGradedStage (Ideal.ofList rs) M n →ₛₗ[Ideal.Quotient.mk K]
        idealAssociatedGradedStage Jbar (M ⧸ KM) n :=
    { toFun := fun x ↦
        ⟨Submodule.Quotient.mk ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M),
          iInf_pow_idealAssociatedGradedStageToQuotient_mem (R := R) (M := M) (rs := rs) n x⟩
      map_add' := by
        intro x y
        rfl
      map_smul' := by
        intro r x
        rfl }
  have hstageMap :
      ((idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1)).submoduleOf
        (idealAssociatedGradedStage (Ideal.ofList rs) M n)) ≤
        Submodule.comap stageMap
          ((idealAssociatedGradedStage Jbar (M ⧸ KM) (n + 1)).submoduleOf
            (idealAssociatedGradedStage Jbar (M ⧸ KM) n)) := by
    intro x hx
    -- The quotient map carries `J ^ (n + 1) M` into the next quotient-side stage.
    rw [Submodule.mem_comap]
    change
      stageMap x ∈
        ((idealAssociatedGradedStage Jbar (M ⧸ KM) (n + 1)).submoduleOf
          (idealAssociatedGradedStage Jbar (M ⧸ KM) n))
    simpa [stageMap] using
      iInf_pow_idealAssociatedGradedStageToQuotient_mem
        (R := R) (M := M) (rs := rs) (n := n + 1)
        ⟨((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M), hx⟩
  let pieceMap :
      idealAssociatedGradedPiece (Ideal.ofList rs) M n →ₛₗ[Ideal.Quotient.mk K]
        idealAssociatedGradedPiece Jbar (M ⧸ KM) n :=
    Submodule.mapQ
      ((idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1)).submoduleOf
        (idealAssociatedGradedStage (Ideal.ofList rs) M n))
      ((idealAssociatedGradedStage Jbar (M ⧸ KM) (n + 1)).submoduleOf
        (idealAssociatedGradedStage Jbar (M ⧸ KM) n))
      stageMap
      hstageMap
  refine AddEquiv.ofBijective pieceMap.toAddMonoidHom ⟨?_, ?_⟩
  · -- Identify the kernel of the descended quotient map with the source denominator.
    have hcomap :
        Submodule.comap stageMap
            ((idealAssociatedGradedStage Jbar (M ⧸ KM) (n + 1)).submoduleOf
              (idealAssociatedGradedStage Jbar (M ⧸ KM) n)) =
          ((idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1)).submoduleOf
            (idealAssociatedGradedStage (Ideal.ofList rs) M n)) := by
      apply le_antisymm
      · intro x hx
        -- The quotient-side next-stage condition forces the source representative into
        -- `J ^ (n + 1) M`.
        exact
          iInf_pow_stage_mem_succ_of_quotient_mem_succ
            (R := R) (M := M) (rs := rs) (n := n) (x := x) (by
              simpa [Submodule.mem_comap, stageMap] using hx)
      · exact hstageMap
    have hker : LinearMap.ker pieceMap = ⊥ := by
      rw [Submodule.ker_mapQ, hcomap, Submodule.mkQ_map_self]
    simpa using LinearMap.ker_eq_bot.mp hker
  · intro y
    refine Quotient.inductionOn y ?_
    intro y
    -- Lift a quotient-side stage representative back to `J ^ n M`, then descend to the quotient.
    rcases
        iInf_pow_idealAssociatedGradedStageToQuotient_exists
          (R := R) (M := M) (rs := rs) (n := n) y with
      ⟨x, hx⟩
    refine ⟨Submodule.Quotient.mk x, ?_⟩
    have hxy : stageMap x = y := by
      apply Subtype.ext
      simpa [stageMap] using hx
    change Submodule.Quotient.mk (stageMap x) = Submodule.Quotient.mk y
    rw [hxy]

/-- Helper for Lemma 10.69.9: on a representative in `J ^ n M`, the degreewise quotient
equivalence is still induced by the quotient map `M → M / ⋂ m, J ^ m M`. -/
@[simp] private theorem iInf_pow_idealAssociatedGradedPiece_equiv_apply_mk
    (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    iInf_pow_idealAssociatedGradedPiece_equiv (R := R) (M := M) rs n
        (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M),
          iInf_pow_idealAssociatedGradedStageToQuotient_mem (R := R) (M := M) (rs := rs) n x⟩ :
          idealAssociatedGradedStage
            (R := R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
            (Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
            (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) n) := by
  -- The degreewise equivalence is defined from the descended quotient map, so on a quotient
  -- representative it is exactly the expected `Submodule.mapQ` image.
  rfl

/-- Helper for Chap10 Lemma 10 69 9: named quotient-side associated-graded pieces prevent
repeated unfolding of the quotient family during direct-sum transport. -/
private abbrev iInf_pow_quotientIdealAssociatedGradedPiece
    (rs : List R) (n : ℕ) :=
  idealAssociatedGradedPiece
    (R := R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
    (Ideal.ofList
      (rs.map (Ideal.Quotient.mk
        (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
    (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))
    n

/-- Helper for Chap10 Lemma 10 69 9: quotient-side associated-graded pieces inherit their additive
group structure from the quotient-stage model. -/
private instance iInf_pow_idealAssociatedGradedPiece_addCommMonoid
    (rs : List R) (n : ℕ) :
    AddCommMonoid (iInf_pow_quotientIdealAssociatedGradedPiece (R := R) (M := M) rs n) :=
  inferInstance

/-- Helper for Chap10 Lemma 10 69 9: the named quotient-side graded pieces expose their additive
monoid superclass without unfolding the quotient family. -/
private instance iInf_pow_idealAssociatedGradedPiece_addMonoid
    (rs : List R) (n : ℕ) :
    AddMonoid (iInf_pow_quotientIdealAssociatedGradedPiece (R := R) (M := M) rs n) :=
  (iInf_pow_idealAssociatedGradedPiece_addCommMonoid (R := R) (M := M) rs n).toAddMonoid

/-- Helper for Chap10 Lemma 10 69 9: the named quotient-side graded pieces expose their zero and
addition superclass without unfolding the quotient family. -/
private instance iInf_pow_idealAssociatedGradedPiece_addZeroClass
    (rs : List R) (n : ℕ) :
    AddZeroClass (iInf_pow_quotientIdealAssociatedGradedPiece (R := R) (M := M) rs n) :=
  (iInf_pow_idealAssociatedGradedPiece_addMonoid (R := R) (M := M) rs n).toAddZeroClass

/-- Helper for Chap10 Lemma 10 69 9: the degreewise quotient equivalence viewed with the named
quotient-side graded-piece family. -/
private noncomputable def iInf_pow_idealAssociatedGradedPiece_namedAddEquiv
    (rs : List R) (n : ℕ) :
    idealAssociatedGradedPiece (Ideal.ofList rs) M n ≃+
      iInf_pow_quotientIdealAssociatedGradedPiece (R := R) (M := M) rs n :=
  -- The named-family spelling caches the target family for later direct-sum computations.
  iInf_pow_idealAssociatedGradedPiece_equiv (R := R) (M := M) rs n

/-- Helper for Chap10 Lemma 10 69 9: the full associated graded module is additively transported
degreewise by the piecewise quotient equivalences. -/
private noncomputable def iInf_pow_idealAssociatedGradedModule_addEquiv
    (rs : List R) :
    idealAssociatedGradedModule (Ideal.ofList rs) M ≃+
      DirectSum ℕ (iInf_pow_quotientIdealAssociatedGradedPiece (R := R) (M := M) rs) :=
  -- Package the degreewise quotient equivalences as a direct-sum additive equivalence.
  DirectSum.congrAddEquiv
    (fun n ↦ iInf_pow_idealAssociatedGradedPiece_namedAddEquiv (R := R) (M := M) rs n)

/-- Helper for Lemma 10.69.9: the full associated graded module is transported degreewise by the
piecewise quotient equivalences. -/
private noncomputable def iInf_pow_idealAssociatedGradedModule_equiv
    (rs : List R) :
    idealAssociatedGradedModule (Ideal.ofList rs) M ≃
      idealAssociatedGradedModule
        (R := R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) :=
  -- The set-level equivalence used by the injectivity argument is the underlying equivalence of
  -- the additive direct-sum transport.
  (iInf_pow_idealAssociatedGradedModule_addEquiv (R := R) (M := M) rs).toEquiv

/-- Helper for Lemma 10.69.9: after quotienting `M` by `⋂ n, J ^ n M`, the submodule generated by
the images of `rs` is exactly the image of `J M`. -/
private theorem iInf_pow_ofList_smul_top_map_eq
    (rs : List R) :
    (Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
        (⊤ :
          Submodule
            (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
            (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))).restrictScalars R =
      (Ideal.ofList rs • (⊤ : Submodule R M)).map
        (Submodule.mkQ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) := by
  -- Degree one of the stage comparison identifies the quotient-side `J̄ M̄` with the image of
  -- `J M`.
  ext y
  simpa [idealAssociatedGradedStage, pow_one] using
    (iInf_pow_ofList_pow_smul_top_mem_iff (R := R) (M := M) (rs := rs) 1
      (y := y))

/-- Helper for Lemma 10.69.9: the `J`-adic intersection on `M` lies inside the first stage
`J M`. -/
private theorem iInf_pow_smul_top_le_ofList_smul_top
    (rs : List R) :
    (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)) ≤
      Ideal.ofList rs • (⊤ : Submodule R M) := by
  -- The intersection is contained in stage `1`, and stage `1` is exactly `J M`.
  simpa [pow_one] using
    (iInf_le (fun m : ℕ ↦ (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)) 1)

/-- Helper for Lemma 10.69.9: the first tensor factor `M / J M` agrees with the iterated quotient
`(M / ⋂ n, J^n M) / J̄(M / ⋂ n, J^n M)` as an `R`-module. -/
private noncomputable def iInf_pow_ofList_quotient_module_equiv
    (rs : List R) :
    (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ≃ₗ[R]
      ((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
          (⊤ :
            Submodule
              (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) :=
  let KM : Submodule R M := ⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)
  let K : Ideal R := ⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
  let eNested :
      (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ≃ₗ[R]
        ((M ⧸ KM) ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)).map (Submodule.mkQ KM)) :=
    (Submodule.quotientQuotientEquivQuotient
      KM
      (Ideal.ofList rs • (⊤ : Submodule R M))
      (iInf_pow_smul_top_le_ofList_smul_top (R := R) (M := M) rs)).symm
  let eDenom :
      ((M ⧸ KM) ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)).map (Submodule.mkQ KM)) ≃ₗ[R]
        ((M ⧸ KM) ⧸
          (Jbar •
            (⊤ :
              Submodule
                (R ⧸ K)
                (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))).restrictScalars R) :=
    Submodule.quotEquivOfEq
      ((Ideal.ofList rs • (⊤ : Submodule R M)).map (Submodule.mkQ KM))
      ((Jbar •
          (⊤ :
            Submodule
              (R ⧸ K)
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))).restrictScalars R)
      ((iInf_pow_ofList_smul_top_map_eq (R := R) (M := M) (rs := rs)).symm)
  let eRestr :
      ((M ⧸ KM) ⧸
        (Jbar •
          (⊤ :
            Submodule
              (R ⧸ K)
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))).restrictScalars R) ≃ₗ[R]
        ((M ⧸ KM) ⧸
          (Jbar •
            (⊤ :
              Submodule
                (R ⧸ K)
                (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) :=
    Submodule.Quotient.restrictScalarsEquiv R
      (Jbar •
        (⊤ :
          Submodule
            (R ⧸ K)
            (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))
  eNested.trans (eDenom.trans eRestr)

/-- Helper for Lemma 10.69.9: the quotient-module identification sends the class of `m` to the
iterated quotient class represented by `m`. -/
@[simp] private theorem iInf_pow_ofList_quotient_module_equiv_apply_mk
    (rs : List R) (m : M) :
    iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs
        (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk (Submodule.Quotient.mk m) := by
  -- Each factor in the third-isomorphism package preserves the obvious representative.
  simpa [iInf_pow_ofList_quotient_module_equiv, Submodule.quotientQuotientEquivQuotient,
    Submodule.mapQ_apply]

/-- Helper for Lemma 10.69.9: the iterated quotient module carries the natural action of the
iterated quotient ring. -/
private noncomputable instance iInf_pow_iterated_quotient_module
    (rs : List R) :
    Module
      (((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
        Ideal.ofList
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))))
      ((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
          (⊤ :
            Submodule
              (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) :=
  inferInstance

/-- Helper for Lemma 10.69.9: the quotient-side list has the same length as the original list. -/
private theorem iInf_pow_quotient_list_length
    (rs : List R) :
    rs.length =
      (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))).length := by
  -- The quotient map only changes coefficients, not the number of generators.
  simp

/-- Helper for Lemma 10.69.9: the quotient-ring identification sends the class of `r mod J` to the
iterated quotient class represented by `r`. -/
@[simp] private theorem iInf_pow_ofList_quotient_ringEquiv_symm_apply_mk
    (rs : List R) (r : R) :
    (iInf_pow_ofList_quotient_ringEquiv (R := R) rs).symm
        (Ideal.Quotient.mk (Ideal.ofList rs) r) =
      Ideal.Quotient.mk
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)) r) := by
  -- Unpack the quotient-of-quotient equivalence on representatives and then rewrite the
  -- denominator using the explicit image-ideal equality.
  change
    (Ideal.quotEquivOfEq (iInf_pow_ofList_map_eq (R := R) rs).symm)
        (((DoubleQuot.quotQuotEquivQuotOfLE
            (iInf_pow_le_ofList (R := R) rs)).symm)
          (Ideal.Quotient.mk (Ideal.ofList rs) r)) =
      Ideal.Quotient.mk
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)) r)
  rw [DoubleQuot.quotQuotEquivQuotOfLE_symm_mk]
  rfl

/-- Helper for Chap10 Lemma 10 69 9: coefficient transport by a ring equivalence is left-inverse
to transport by the inverse equivalence on `MvPolynomial`. -/
private theorem mvPolynomialMapEquiv_left_inv
    {A B : Type*} [CommRing A] [CommRing B] (σ : Type*) (e : A ≃+* B)
    (p : MvPolynomial σ A) :
    MvPolynomial.map (e.symm : B →+* A) (MvPolynomial.map (e : A →+* B) p) = p := by
  -- Compose the two coefficient maps and reduce to the identity map on polynomials.
  rw [MvPolynomial.map_map]
  have hcomp : (e.symm : B →+* A).comp (e : A →+* B) = RingHom.id A := by
    ext a
    simp
  rw [hcomp]
  exact MvPolynomial.map_id p

/-- Helper for Chap10 Lemma 10 69 9: coefficient transport by a ring equivalence is right-inverse
to transport by the inverse equivalence on `MvPolynomial`. -/
private theorem mvPolynomialMapEquiv_right_inv
    {A B : Type*} [CommRing A] [CommRing B] (σ : Type*) (e : A ≃+* B)
    (p : MvPolynomial σ B) :
    MvPolynomial.map (e : A →+* B) (MvPolynomial.map (e.symm : B →+* A) p) = p := by
  -- Compose the coefficient maps in the other order and again reduce to the identity map.
  rw [MvPolynomial.map_map]
  have hcomp : (e : A →+* B).comp (e.symm : B →+* A) = RingHom.id B := by
    ext b
    simp
  rw [hcomp]
  exact MvPolynomial.map_id p

/-- Helper for Chap10 Lemma 10 69 9: coefficient transport on `MvPolynomial` is semilinear over
the same ring equivalence. -/
private theorem mvPolynomialMapEquiv_map_smul
    {A B : Type*} [CommRing A] [CommRing B] (σ : Type*) (e : A ≃+* B)
    (a : A) (p : MvPolynomial σ A) :
    MvPolynomial.map (e : A →+* B) (a • p) =
      e a • MvPolynomial.map (e : A →+* B) p := by
  -- Express scalar multiplication by coefficients as multiplication by constants.
  simp [MvPolynomial.smul_eq_C_mul]

/-- Helper for Chap10 Lemma 10 69 9: a ring equivalence induces a semilinear equivalence on
`MvPolynomial` by changing coefficients. -/
private noncomputable def mvPolynomialMapSemilinearEquiv
    {A B : Type*} [CommRing A] [CommRing B] (σ : Type*) (e : A ≃+* B) :
    MvPolynomial σ A ≃ₛₗ[(e : A →+* B)] MvPolynomial σ B where
  toFun := MvPolynomial.map (e : A →+* B)
  invFun := MvPolynomial.map (e.symm : B →+* A)
  left_inv := mvPolynomialMapEquiv_left_inv σ e
  right_inv := mvPolynomialMapEquiv_right_inv σ e
  map_add' := (MvPolynomial.map (e : A →+* B)).map_add
  map_smul' := mvPolynomialMapEquiv_map_smul σ e

/-- Helper for Chap10 Lemma 10 69 9: coefficient transport followed by a variable equivalence is
a semilinear equivalence of polynomial rings. -/
private noncomputable def mvPolynomialMapRenameSemilinearEquiv
    {A B : Type*} [CommRing A] [CommRing B] {σ τ : Type*}
    (e : A ≃+* B) (f : σ ≃ τ) :
    MvPolynomial σ A ≃ₛₗ[(e : A →+* B)] MvPolynomial τ B :=
  (mvPolynomialMapSemilinearEquiv σ e).trans (MvPolynomial.renameEquiv B f).toLinearEquiv

/-- Helper for Chap10 Lemma 10 69 9: the polynomial semilinear equivalence sends a unit
monomial to the renamed unit monomial. -/
@[simp] private theorem mvPolynomialMapRenameSemilinearEquiv_monomial_one
    {A B : Type*} [CommRing A] [CommRing B] {σ τ : Type*}
    (e : A ≃+* B) (f : σ ≃ τ) (d : σ →₀ ℕ) :
    mvPolynomialMapRenameSemilinearEquiv e f (MvPolynomial.monomial d (1 : A)) =
      MvPolynomial.monomial (Finsupp.mapDomain f d) (1 : B) := by
  -- The coefficient equivalence maps `1` to `1`; the second step only renames variables.
  simp [mvPolynomialMapRenameSemilinearEquiv, mvPolynomialMapSemilinearEquiv,
    MvPolynomial.rename_monomial]

/-- Helper for Chap10 Lemma 10 69 9: the first source factor quotient equivalence is semilinear
over the quotient-of-quotient ring equivalence. -/
private theorem iInf_pow_ofList_quotient_module_equiv_map_smul
    (rs : List R)
    (a : R ⧸ Ideal.ofList rs)
    (x : M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) :
    iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs (a • x) =
      @SMul.smul
        (((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
          Ideal.ofList
            (rs.map (Ideal.Quotient.mk
              (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))))
        (((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk
              (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
            (⊤ :
              Submodule
                (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
                (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))))
        (iInf_pow_iterated_quotient_module (R := R) (M := M) rs).toDistribMulAction.toSMul
        ((iInf_pow_ofList_quotient_ringEquiv (R := R) rs).symm a)
        (iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs x) := by
  -- Check semilinearity on quotient representatives for both the scalar and the vector.
  refine Quotient.inductionOn' a ?_
  intro r
  refine Quotient.inductionOn' x ?_
  intro m
  rfl

/-- Helper for Chap10 Lemma 10 69 9: the first tensor factor is transported semilinearly to the
iterated quotient source. -/
private noncomputable def iInf_pow_ofList_quotient_module_semilinearEquiv
    (rs : List R) :
    (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ≃ₛₗ[
      ((iInf_pow_ofList_quotient_ringEquiv (R := R) rs).symm :
        R ⧸ Ideal.ofList rs →+*
          ((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
            Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))))]
      ((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
          (⊤ :
            Submodule
              (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) where
  toFun := iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs
  invFun := (iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs).symm
  left_inv := (iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs).left_inv
  right_inv := (iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs).right_inv
  map_add' := (iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs).map_add
  map_smul' := iInf_pow_ofList_quotient_module_equiv_map_smul (R := R) (M := M) rs

/-- Helper for Chap10 Lemma 10 69 9: the tensor-product source of the quasi-regular comparison
map is additively transported from `M / J M` to the quotient-side source by the nested quotient
equivalence and the quotient-ring polynomial transport. -/
private noncomputable def iInf_pow_quasiRegularSource_addEquiv
    (rs : List R) :
    ((M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList rs]
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) ≃+
      (((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk
              (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
            (⊤ :
              Submodule
                (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
                (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) ⊗[
          ((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
            Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))]
        MvPolynomial (Fin (rs.map (Ideal.Quotient.mk
          (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))).length)
          (((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
            Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))))) :=
  -- Package the two factor equivalences as one semilinear tensor congruence and forget only to
  -- an additive equivalence, so finite sums can be transported later.
  (TensorProduct.congr
    (iInf_pow_ofList_quotient_module_semilinearEquiv (R := R) (M := M) rs)
    (mvPolynomialMapRenameSemilinearEquiv
      (iInf_pow_ofList_quotient_ringEquiv (R := R) rs).symm
      (finCongr (iInf_pow_quotient_list_length (R := R) rs)))).toAddEquiv

/-- Helper for Lemma 10.69.9: the tensor-product source of the quasi-regular comparison map is
transported from `M / J M` to the quotient-side source by the nested quotient equivalence and the
quotient-ring polynomial transport. -/
private noncomputable def iInf_pow_quasiRegularSource_equiv
    (rs : List R) :
    ((M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList rs]
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) ≃
      (((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk
              (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
            (⊤ :
              Submodule
                (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
                (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) ⊗[
          ((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
            Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))]
        MvPolynomial (Fin (rs.map (Ideal.Quotient.mk
          (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))).length)
          (((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
            Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))))) :=
  -- The injectivity argument uses only the underlying equivalence of the additive source
  -- transport.
  (iInf_pow_quasiRegularSource_addEquiv (R := R) (M := M) rs).toEquiv

/-- Helper for Chap10 Lemma 10 69 9: the source equivalence sends monomial simple tensors to the
corresponding nested quotient representative with the exponent vector renamed by the length cast. -/
@[simp] private theorem iInf_pow_quasiRegularSource_equiv_tmul_monomial
    (rs : List R) (m : M) (d : Fin rs.length →₀ ℕ) :
    iInf_pow_quasiRegularSource_equiv (R := R) (M := M) rs
        (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs]
          MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs)) =
      Submodule.Quotient.mk (Submodule.Quotient.mk m) ⊗ₜ[
        ((R ⧸ (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R))) ⧸
          Ideal.ofList
            (rs.map (Ideal.Quotient.mk
              (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))))]
        MvPolynomial.monomial
          (Finsupp.mapDomain (finCongr (iInf_pow_quotient_list_length (R := R) rs)) d)
          (1 :
            ((R ⧸ (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R))) ⧸
              Ideal.ofList
                (rs.map (Ideal.Quotient.mk
                  (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))))) := by
  -- Evaluate the tensor congruence on a simple tensor, then use the representative formulas for
  -- the module quotient and polynomial coefficient/variable transport.
  simp [iInf_pow_quasiRegularSource_equiv, iInf_pow_quasiRegularSource_addEquiv,
    iInf_pow_ofList_quotient_module_semilinearEquiv,
    mvPolynomialMapRenameSemilinearEquiv, mvPolynomialMapSemilinearEquiv,
    MvPolynomial.rename_monomial]

/-- Helper for Chap10 Lemma 10 69 9: the additive source transport has the same monomial
simple-tensor formula as its underlying equivalence. -/
private theorem iInf_pow_quasiRegularSource_addEquiv_tmul_monomial
    (rs : List R) (m : M) (d : Fin rs.length →₀ ℕ) :
    iInf_pow_quasiRegularSource_addEquiv (R := R) (M := M) rs
        (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs]
          MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs)) =
      Submodule.Quotient.mk (Submodule.Quotient.mk m) ⊗ₜ[
        ((R ⧸ (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R))) ⧸
          Ideal.ofList
            (rs.map (Ideal.Quotient.mk
              (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))))]
        MvPolynomial.monomial
          (Finsupp.mapDomain (finCongr (iInf_pow_quotient_list_length (R := R) rs)) d)
          (1 :
            ((R ⧸ (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R))) ⧸
              Ideal.ofList
                (rs.map (Ideal.Quotient.mk
                  (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))))) := by
  -- Transfer the already proved computation from the set-level equivalence to the additive
  -- wrapper.
  simpa [iInf_pow_quasiRegularSource_equiv] using
    iInf_pow_quasiRegularSource_equiv_tmul_monomial (R := R) (M := M) rs m d

/-- Helper for Chap10 Lemma 10 69 9: every source tensor is a finite sum of monomial simple
tensors with quotient-module coefficients. -/
private theorem tensor_monomial_expansion
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A)
    (z : (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) ⊗[A ⧸ Ideal.ofList rs]
      MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs)) :
    ∃ coeffs : (Fin rs.length →₀ ℕ) →₀ (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))),
      z =
        coeffs.sum fun e q ↦
          (q ⊗ₜ[A ⧸ Ideal.ofList rs]
            MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs)) := by
  let comm :=
    TensorProduct.comm (A ⧸ Ideal.ofList rs)
      (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P)))
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
  let scalar :=
    MvPolynomial.scalarRTensor
      (R := A ⧸ Ideal.ofList rs)
      (σ := Fin rs.length)
      (N := P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P)))
  let coeffs :
      (Fin rs.length →₀ ℕ) →₀ (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) :=
    scalar (comm z)
  refine ⟨coeffs, ?_⟩
  -- Move to the commuted tensor product, where `scalarRTensor` gives the coefficient expansion.
  apply comm.injective
  calc
    comm z = scalar.symm coeffs := by
      simp [coeffs]
    _ = scalar.symm (coeffs.sum fun e q ↦ Finsupp.single e q) := by
      simp
    _ = coeffs.sum fun e q ↦ scalar.symm (Finsupp.single e q) := by
      simp [Finsupp.sum]
    _ = coeffs.sum fun e q ↦
          (MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs)) ⊗ₜ[A ⧸ Ideal.ofList rs] q := by
      refine Finsupp.sum_congr ?_
      intro e q
      rw [MvPolynomial.scalarRTensor_symm_apply_single]
    _ = comm
          (coeffs.sum fun e q ↦
            (q ⊗ₜ[A ⧸ Ideal.ofList rs]
              MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs))) := by
      simp only [Finsupp.sum, map_sum]
      refine Finset.sum_congr rfl ?_
      intro e he
      rw [TensorProduct.comm_tmul]

/-- Helper for Chap10 Lemma 10 69 9: the product of powers attached to an exponent vector lies in
the matching power of `Ideal.ofList rs`. -/
private theorem ofList_monomial_weight_mem_pow
    {A : Type*} [CommRing A] (rs : List A) (e : Fin rs.length →₀ ℕ) :
    (∏ i : Fin rs.length, rs.get i ^ e i) ∈ (Ideal.ofList rs) ^ e.degree := by
  -- Each generator factor lies in its corresponding ideal power, and products add degrees.
  have hprod :
      (∏ i : Fin rs.length, rs.get i ^ e i) ∈
        ∏ i : Fin rs.length, (Ideal.ofList rs) ^ e i := by
    refine Ideal.prod_mem_prod ?_
    intro i hi
    exact Ideal.pow_mem_pow
      (Ideal.subset_span (by simpa using List.getElem_mem rs i))
      (e i)
  simpa [Finsupp.degree_eq_sum, Finset.prod_pow_eq_pow_sum] using hprod

/-- Helper for Chap10 Lemma 10 69 9: a weighted monomial term of total degree `n` lies in the
`n`-th associated-graded stage. -/
private theorem ofList_monomial_weight_smul_mem_of_degree
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A) (n : ℕ) (m : P) (e : Fin rs.length →₀ ℕ) (hdeg : e.degree = n) :
    (∏ i : Fin rs.length, rs.get i ^ e i) • m ∈
      idealAssociatedGradedStage (Ideal.ofList rs) P n := by
  -- Combine monomial-weight membership with the trivial top-submodule membership of `m`.
  have htop : m ∈ (⊤ : Submodule A P) := Submodule.mem_top
  simpa [idealAssociatedGradedStage, hdeg] using
    (Submodule.smul_mem_smul (ofList_monomial_weight_mem_pow rs e) htop)

/-- Helper for Chap10 Lemma 10 69 9: the associated-graded comparison map sends a monomial simple
tensor to its homogeneous class. -/
private theorem quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_lof
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    {rs : List A} (m : P) (e : Fin rs.length →₀ ℕ) :
    let J : Ideal A := Ideal.ofList rs
    quasiRegularSequenceAssociatedGradedMap P rs
      (((Submodule.Quotient.mk m : P ⧸ (J • (⊤ : Submodule A P))) ⊗ₜ[A ⧸ J]
        MvPolynomial.monomial e (1 : A ⧸ J))) =
      DirectSum.lof (A ⧸ J) ℕ (idealAssociatedGradedPiece J P) e.degree
        (Submodule.Quotient.mk
          (⟨(∏ i : Fin rs.length, rs.get i ^ e i) • m,
            ofList_monomial_weight_smul_mem_of_degree rs e.degree m e rfl⟩ :
            idealAssociatedGradedStage J P e.degree)) := by
  -- Use the owner computations from `10.69.0.1` and normalize the resulting internal class.
  dsimp [quasiRegularSequenceAssociatedGradedMap]
  let z := quasiRegularAssociatedGradedInternalMonomialClass rs m e
  have hcomm :=
    quasiRegularSequenceAssociatedGradedSourceComm_tmul P rs m e
  have haux :=
    quasiRegularSequenceAssociatedGradedMapAux_tmul_monomial P rs m e
  have hlof := quasiRegularAssociatedGradedAddEquiv_symm_lof P rs e.degree z
  have hpiece :=
    quasiRegularAssociatedGradedInternalPieceEquiv_monomialClass P rs m e
  rw [hcomm, haux, hlof, hpiece]
  rfl

/-- Helper for Chap10 Lemma 10 69 9: the monomial computation can be stated at any explicitly
equal degree, avoiding later transport of a finished `DirectSum.of` index. -/
private theorem quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_of_degree
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    {rs : List A} (m : P) (e : Fin rs.length →₀ ℕ) (n : ℕ) (hdeg : e.degree = n) :
    let J : Ideal A := Ideal.ofList rs
    quasiRegularSequenceAssociatedGradedMap P rs
      (((Submodule.Quotient.mk m : P ⧸ (J • (⊤ : Submodule A P))) ⊗ₜ[A ⧸ J]
        MvPolynomial.monomial e (1 : A ⧸ J))) =
      DirectSum.of (idealAssociatedGradedPiece J P) n
        (Submodule.Quotient.mk
          (⟨(∏ i : Fin rs.length, rs.get i ^ e i) • m,
            ofList_monomial_weight_smul_mem_of_degree rs n m e hdeg⟩ :
            idealAssociatedGradedStage J P n)) := by
  -- Rewrite the existing monomial formula before the homogeneous generator is built at the
  -- explicitly requested degree.
  subst n
  simpa [DirectSum.lof_eq_of] using
    quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_lof (P := P) (rs := rs) m e

/-- Helper for Chap10 Lemma 10 69 9: the renamed quotient-side monomial weight acts on the quotient
class as the quotient of the original monomial weight acting on the representative. -/
private theorem iInf_pow_quotient_monomialWeight_smul_mk
    (rs : List R) (m : M) (d : Fin rs.length →₀ ℕ) :
    let K : Ideal R := ⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)
    let KM : Submodule R M := ⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)
    let qrs : List (R ⧸ K) := rs.map (Ideal.Quotient.mk K)
    let qd : Fin qrs.length →₀ ℕ :=
      Finsupp.mapDomain (finCongr (iInf_pow_quotient_list_length (R := R) rs)) d
    (∏ i : Fin qrs.length, qrs.get i ^ qd i) •
        (Submodule.Quotient.mk (p := KM) m : M ⧸ KM) =
      Submodule.Quotient.mk (p := KM) ((∏ i : Fin rs.length, rs.get i ^ d i) • m) := by
  -- First identify the quotient-side product with the image of the original product; the quotient
  -- module action on representatives then evaluates definitionally.
  dsimp
  have hprod :
      (∏ i : Fin
          (rs.map (Ideal.Quotient.mk (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))).length,
          (rs.map (Ideal.Quotient.mk (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))).get i ^
            (Finsupp.mapDomain (finCongr (iInf_pow_quotient_list_length (R := R) rs)) d) i) =
        (Ideal.Quotient.mk (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))
          (∏ i : Fin rs.length, rs.get i ^ d i) := by
    rw [map_prod]
    refine (Fintype.prod_equiv (finCongr (iInf_pow_quotient_list_length (R := R) rs)) _ _ ?_).symm
    intro i
    simp [Finsupp.mapDomain_equiv_apply]
  simpa only [List.get_eq_getElem] using
    congrArg
      (fun a : R ⧸ (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)) ↦
        a •
          (Submodule.Quotient.mk
            (p := ⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)) m :
            M ⧸ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M))))
      hprod

/-- Helper for Chap10 Lemma 10 69 9: at a common explicit degree, the quotient-side monomial class
is the image of the source monomial class under the degreewise quotient equivalence. -/
private theorem iInf_pow_quotient_monomial_piece_eq
    (rs : List R) (m : M) (d : Fin rs.length →₀ ℕ) (n : ℕ)
    (hd : d.degree = n)
    (hdq :
      (Finsupp.mapDomain (finCongr (iInf_pow_quotient_list_length (R := R) rs)) d).degree = n) :
    let K : Ideal R := ⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)
    let KM : Submodule R M := ⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)
    let qrs : List (R ⧸ K) := rs.map (Ideal.Quotient.mk K)
    let qd : Fin qrs.length →₀ ℕ :=
      Finsupp.mapDomain (finCongr (iInf_pow_quotient_list_length (R := R) rs)) d
    (Submodule.Quotient.mk
      (⟨(∏ i : Fin qrs.length, qrs.get i ^ qd i) •
          (Submodule.Quotient.mk (p := KM) m : M ⧸ KM),
        ofList_monomial_weight_smul_mem_of_degree qrs n
          (Submodule.Quotient.mk (p := KM) m) qd hdq⟩ :
        idealAssociatedGradedStage
          (R := R ⧸ K)
          (Ideal.ofList qrs)
          (M ⧸ KM) n)) =
      iInf_pow_idealAssociatedGradedPiece_equiv (R := R) (M := M) rs n
        (Submodule.Quotient.mk
          (⟨(∏ i : Fin rs.length, rs.get i ^ d i) • m,
            ofList_monomial_weight_smul_mem_of_degree rs n m d hd⟩ :
            idealAssociatedGradedStage (Ideal.ofList rs) M n)) := by
  -- Evaluate the degreewise quotient equivalence on the source representative, then compare the
  -- quotient-side stage representatives using the scalar-weight computation.
  dsimp
  rw [iInf_pow_idealAssociatedGradedPiece_equiv_apply_mk]
  congr 1
  ext
  exact iInf_pow_quotient_monomialWeight_smul_mk (R := R) (M := M) rs m d

/-- Helper for Chap10 Lemma 10 69 9: the additive associated-graded quotient transport preserves
homogeneous generators in the named quotient-side family. -/
private theorem iInf_pow_idealAssociatedGradedModule_addEquiv_of
    (rs : List R) (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList rs) M n) :
    iInf_pow_idealAssociatedGradedModule_addEquiv (R := R) (M := M) rs
        (DirectSum.of (idealAssociatedGradedPiece (Ideal.ofList rs) M) n z) =
      DirectSum.of
        (iInf_pow_quotientIdealAssociatedGradedPiece (R := R) (M := M) rs)
        n
        (iInf_pow_idealAssociatedGradedPiece_equiv (R := R) (M := M) rs n z) := by
  -- Work in the named target family so the direct-sum single-support computation sees a stable
  -- additive-family instance.
  dsimp [iInf_pow_idealAssociatedGradedModule_addEquiv]
  exact DirectSum.map_of
    (fun i ↦
      (iInf_pow_idealAssociatedGradedPiece_namedAddEquiv
        (R := R) (M := M) rs i).toAddMonoidHom)
    n z

/-- Helper for Chap10 Lemma 10 69 9: the associated-graded quotient transport preserves
homogeneous direct-sum generators degreewise. -/
@[simp] private theorem iInf_pow_idealAssociatedGradedModule_equiv_of
    (rs : List R) (n : ℕ)
    (z : idealAssociatedGradedPiece (Ideal.ofList rs) M n) :
    iInf_pow_idealAssociatedGradedModule_equiv (R := R) (M := M) rs
        (DirectSum.of (idealAssociatedGradedPiece (Ideal.ofList rs) M) n z) =
      DirectSum.of
        (idealAssociatedGradedPiece
          (R := R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk
              (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
          (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))
        n
        (iInf_pow_idealAssociatedGradedPiece_equiv (R := R) (M := M) rs n z) := by
  -- Reduce the set-level transport to the named additive direct-sum transport and use its
  -- single homogeneous-generator computation.
  rw [iInf_pow_idealAssociatedGradedModule_equiv, iInf_pow_idealAssociatedGradedModule_addEquiv]
  simpa [iInf_pow_quotientIdealAssociatedGradedPiece] using
    iInf_pow_idealAssociatedGradedModule_addEquiv_of (R := R) (M := M) rs n z

/-- Helper for Chap10 Lemma 10 69 9: the quotient-by-intersection source and target transports
commute with the associated-graded map on monomial simple tensors. -/
private theorem quasiRegularSequenceAssociatedGradedMap_iInf_pow_naturality_tmul
    (rs : List R) (m : M) (d : Fin rs.length →₀ ℕ) :
    iInf_pow_idealAssociatedGradedModule_addEquiv (R := R) (M := M) rs
        (quasiRegularSequenceAssociatedGradedMap M rs
          (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs]
            MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs))) =
      quasiRegularSequenceAssociatedGradedMap
        (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))
        (rs.map (Ideal.Quotient.mk
          (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))
        (iInf_pow_quasiRegularSource_addEquiv (R := R) (M := M) rs
          (Submodule.Quotient.mk m ⊗ₜ[R ⧸ Ideal.ofList rs]
            MvPolynomial.monomial d (1 : R ⧸ Ideal.ofList rs))) := by
  -- Route correction: instead of transporting a completed quotient-side `DirectSum.of` across a
  -- degree equality, choose the common degree first and compare the graded-piece classes there.
  let qd : Fin
      (rs.map (Ideal.Quotient.mk (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))).length →₀ ℕ :=
    Finsupp.mapDomain (finCongr (iInf_pow_quotient_list_length (R := R) rs)) d
  have hqd_degree : qd.degree = d.degree := by
    -- Renaming the finitely supported exponent vector by the list-length equivalence preserves
    -- total degree.
    simpa [qd] using
      Finsupp.degree_mapDomain_eq_of_subsingletonAddUnits
        (f := finCongr (iInf_pow_quotient_list_length (R := R) rs)) d
  rw [quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_of_degree
    (P := M) (rs := rs) m d d.degree rfl]
  rw [iInf_pow_idealAssociatedGradedModule_addEquiv_of]
  rw [iInf_pow_quasiRegularSource_addEquiv_tmul_monomial]
  rw [quasiRegularSequenceAssociatedGradedMap_tmul_monomial_eq_of_degree
    (P := M ⧸ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)))
    (rs := rs.map (Ideal.Quotient.mk (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R))))
    (Submodule.Quotient.mk (p := ⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)) m)
    qd d.degree hqd_degree]
  -- Both sides are now degree-`d.degree` direct-sum generators; the remaining equality is the
  -- quotient-side monomial class comparison in that graded piece.
  congr 1
  simpa [qd, iInf_pow_quotientIdealAssociatedGradedPiece] using
    (iInf_pow_quotient_monomial_piece_eq (R := R) (M := M) rs m d d.degree rfl hqd_degree).symm

/-- Helper for Lemma 10.69.9: after identifying the source and target graded pieces through the
quotients by `⋂ n, J ^ n`, the canonical associated-graded map is conjugated by those
equivalences. -/
private theorem quasiRegularSequenceAssociatedGradedMap_iInf_pow_naturality
    (rs : List R) :
    iInf_pow_idealAssociatedGradedModule_equiv (R := R) (M := M) rs ∘
        quasiRegularSequenceAssociatedGradedMap M rs =
      quasiRegularSequenceAssociatedGradedMap
          (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) ∘
        iInf_pow_quasiRegularSource_equiv (R := R) (M := M) rs := by
  -- Expand an arbitrary source tensor as a finite sum of monomial simple tensors; the additive
  -- transport wrappers let both sides commute with this sum.
  funext z
  obtain ⟨coeffs, hcoeffs⟩ := tensor_monomial_expansion (P := M) rs z
  rw [hcoeffs, Finsupp.sum]
  simp only [Function.comp_apply]
  let sourceTransport := (iInf_pow_quasiRegularSource_addEquiv (R := R) (M := M) rs).toAddMonoidHom
  let targetTransport :=
    (iInf_pow_idealAssociatedGradedModule_addEquiv (R := R) (M := M) rs).toAddMonoidHom
  let sourceMap := (quasiRegularSequenceAssociatedGradedMap M rs).toAddMonoidHom
  let targetMap :=
    (quasiRegularSequenceAssociatedGradedMap
      (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))
      (rs.map (Ideal.Quotient.mk
        (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))).toAddMonoidHom
  change targetTransport
      (sourceMap
        (∑ a ∈ coeffs.support,
          coeffs a ⊗ₜ[R ⧸ Ideal.ofList rs]
            MvPolynomial.monomial a (1 : R ⧸ Ideal.ofList rs))) =
    targetMap
      (sourceTransport
        (∑ a ∈ coeffs.support,
          coeffs a ⊗ₜ[R ⧸ Ideal.ofList rs]
            MvPolynomial.monomial a (1 : R ⧸ Ideal.ofList rs)))
  rw [map_sum sourceMap, map_sum targetTransport, map_sum sourceTransport, map_sum targetMap]
  refine Finset.sum_congr rfl ?_
  intro d hd
  -- It remains to compare the two maps on a monomial tensor; quotient induction replaces the
  -- coefficient by a representative in `M`.
  refine Quotient.inductionOn' (coeffs d) ?_
  intro m
  simpa [sourceTransport, targetTransport, sourceMap, targetMap] using
    quasiRegularSequenceAssociatedGradedMap_iInf_pow_naturality_tmul
      (R := R) (M := M) rs m d

/- 
Domain triage:
* primary domain: quasi-regular sequences and quotients by the `J`-adic intersection in
  commutative algebra;
* sampled owner API:
  `RingTheory.Sequence.IsQuasiRegular`,
  `RingTheory.Sequence.IsQuasiRegular.tail_quotient`,
  `Ideal.iInf_pow_eq_bot_of_isLocalRing`,
  `Ideal.iInf_pow_smul_eq_bot_of_isLocalRing`;
* core/canonical owner abstractions: `IsQuasiRegular` for the source-facing sequence predicate and
  the raw infimum expressions `⨅ n, J ^ n` and `⨅ n, J ^ n • ⊤` for the `J`-adic intersection;
* primitive vs derived split: the ideal `⨅ n, J ^ n` and submodule `⨅ n, J ^ n • ⊤` are primitive
  canonical data, while the quotient module structure and the quotient invariance statement are
  derived API.
-/

-- Proof sketch: compare the homogeneous-coefficient definition of quasi-regularity before and
-- after passing to the quotients by `⋂ n, J ^ n` and `⋂ n, J ^ n M`. The graded pieces are
-- unchanged because for every `n` there is a canonical isomorphism
-- `J ^ n • ⊤ / J ^ (n + 1) • ⊤ ≃ₗ[R] (J̄ ^ n • ⊤) / (J̄ ^ (n + 1) • ⊤)`, so the coefficient
-- criterion is equivalent on the two sides.
/-- Chap10 Lemma 10 69 9: a finite sequence in a commutative ring is `M`-quasi-regular if and only if
its image in the quotient ring by `⋂ n, J ^ n`, where `J = Ideal.ofList rs`, is
quasi-regular on the corresponding quotient module. -/
@[stacks 065N]
theorem isQuasiRegular_iff_quotient_iInf_pow {rs : List R} :
    IsQuasiRegular M rs ↔
      IsQuasiRegular
        (M ⧸ (⨅ n : ℕ, (ofList rs) ^ n • (⊤ : Submodule R M)))
        (rs.map (Ideal.Quotient.mk (⨅ n : ℕ, ((ofList rs) ^ n : Ideal R)))) := by
  -- Route correction: the stage-image bridge from the source proof is isolated above via
  -- `iInf_pow_idealAssociatedGradedStageToQuotient_mem` and
  -- `iInf_pow_idealAssociatedGradedStageToQuotient_exists`, and the source first-factor quotient
  -- has now been packaged into `iInf_pow_ofList_quotient_moduleEquiv`.
  rw [isQuasiRegular_iff_injective, isQuasiRegular_iff_injective]
  let eSrc := iInf_pow_quasiRegularSource_equiv (R := R) (M := M) rs
  let eTgt := iInf_pow_idealAssociatedGradedModule_equiv (R := R) (M := M) rs
  -- Once the associated-graded maps are identified by the source and target equivalences,
  -- injectivity transfers across the commuting square.
  exact
    injective_iff_of_equiv_conjugate eSrc eTgt
      (quasiRegularSequenceAssociatedGradedMap M rs)
      (quasiRegularSequenceAssociatedGradedMap
        (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))
        (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
      (quasiRegularSequenceAssociatedGradedMap_iInf_pow_naturality
        (R := R) (M := M) rs)

end RingTheory.Sequence
