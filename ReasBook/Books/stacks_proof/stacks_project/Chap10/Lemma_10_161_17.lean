/-- Helper for Chap10 Lemma 10 161 17: the normalization of a Noetherian `N-2` domain in its
fraction field is again `N-2`. -/
theorem isN2Ring_integralClosure_fractionRing
    (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsN2Ring R] :
    IsN2Ring (integralClosure R (FractionRing R)) := by
  let S := integralClosure R (FractionRing R)
  letI : Algebra.FiniteType R S := Module.Finite.finiteType S
  have hQuasiFinite : Algebra.FiniteType.QuasiFinite R S := by
    -- The normalization is finite as an `R`-module, hence the structure map is quasi-finite.
    have hFinite : (algebraMap R S).Finite := by
      rw [RingHom.finite_algebraMap]
      infer_instance
    have hAlgQuasiFinite : Algebra.QuasiFinite R S := by
      rw [← RingHom.quasiFinite_algebraMap]
      exact RingHom.QuasiFinite.of_finite hFinite
    exact Algebra.FiniteType.QuasiFinite.of_quasiFinite hAlgQuasiFinite
  have hInjective : Function.Injective (algebraMap R S) := by
    -- Coerce an equality in the integral closure to the fraction field, where `R` embeds.
    intro x y hxy
    apply IsFractionRing.injective R (FractionRing R)
    simpa [S] using congrArg (fun z : S => (z : FractionRing R)) hxy
  -- Apply permanence of `N-2` under injective quasi-finite extensions.
  simpa [S] using
    isN2Ring_of_quasiFinite_extension (R := R) (S := S) hQuasiFinite hInjective

/-- Helper for Chap10 Lemma 10 161 17: membership in `(X)^n` is equivalent to vanishing of the
first `n` coefficients. -/
lemma powerSeries_mem_span_X_pow_iff_coeff_eq_zero
    (A : Type u) [CommRing A] (n : ℕ) (f : PowerSeries A) :
    f ∈ (Ideal.span ({(PowerSeries.X : PowerSeries A)} : Set (PowerSeries A))) ^ n ↔
      ∀ m, m < n → PowerSeries.coeff m f = 0 := by
  -- Rewrite `(X)^n` as the principal ideal generated by `X^n`, then use the standard divisibility
  -- criterion for power series coefficients.
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton, PowerSeries.X_pow_dvd_iff]

/-- Helper for Chap10 Lemma 10 161 17: the kernel of the constant-coefficient map is the principal
ideal generated by `X`. -/
lemma powerSeries_constantCoeff_ker_eq_span_X
    (A : Type u) [CommRing A] :
    RingHom.ker (PowerSeries.constantCoeff (R := A)) =
      Ideal.span ({(PowerSeries.X : PowerSeries A)} : Set (PowerSeries A)) := by
  -- A formal power series has constant coefficient zero exactly when it is divisible by `X`.
  ext f
  rw [RingHom.mem_ker, Ideal.mem_span_singleton, PowerSeries.X_dvd_iff]

/-- Helper for Chap10 Lemma 10 161 17: quotienting a power series ring by `(X)` recovers the
coefficient ring. -/
theorem powerSeries_quotient_span_X_ringEquiv
    (A : Type u) [CommRing A] :
    Nonempty (((PowerSeries A) ⧸
      Ideal.span ({(PowerSeries.X : PowerSeries A)} : Set (PowerSeries A))) ≃+* A) := by
  -- First rewrite the quotient by `(X)` as the quotient by `ker constantCoeff`, then apply the
  -- canonical quotient-by-kernel equivalence.
  refine ⟨(Ideal.quotEquivOfEq (powerSeries_constantCoeff_ker_eq_span_X A).symm).trans ?_⟩
  exact RingHom.quotientKerEquivOfSurjective (PowerSeries.constantCoeff_surj (R := A))

/-- Helper for Chap10 Lemma 10 161 17: congruence modulo `(X)^n` is equality of coefficients below
degree `n`. -/
lemma powerSeries_smodEq_span_X_pow_iff_coeff_eq
    (A : Type u) [CommRing A] (n : ℕ) (f g : PowerSeries A) :
    f ≡ g
      [SMOD ((Ideal.span ({(PowerSeries.X : PowerSeries A)} : Set (PowerSeries A))) ^ n •
        (⊤ : Submodule (PowerSeries A) (PowerSeries A)))] ↔
      ∀ m, m < n → PowerSeries.coeff m f = PowerSeries.coeff m g := by
  -- Rewrite modular equivalence as membership of the difference in `(X)^n`, then read that
  -- condition coefficientwise.
  rw [SModEq.sub_mem, smul_eq_mul, Ideal.mul_top,
    powerSeries_mem_span_X_pow_iff_coeff_eq_zero (A := A) (n := n) (f := f - g)]
  constructor
  · intro h m hm
    simpa [sub_eq_zero] using h m hm
  · intro h m hm
    simpa [h m hm] using h m hm

/-- Helper for Chap10 Lemma 10 161 17: the power series ring is complete for the `(X)`-adic
topology. -/
theorem powerSeries_isAdicComplete_span_X
    (A : Type u) [CommRing A] :
    IsAdicComplete (Ideal.span ({(PowerSeries.X : PowerSeries A)} : Set (PowerSeries A)))
      (PowerSeries A) := by
  refine
    { haus' := ?_, prec' := ?_ }
  · -- Vanishing modulo every power of `(X)` forces every coefficient to vanish.
    intro f h
    ext n
    have hmem :
        f ∈ (Ideal.span ({(PowerSeries.X : PowerSeries A)} : Set (PowerSeries A))) ^ (n + 1) := by
      simpa [SModEq.zero, smul_eq_mul, Ideal.mul_top] using h (n + 1)
    exact
      (powerSeries_mem_span_X_pow_iff_coeff_eq_zero
        (A := A) (n := n + 1) (f := f)).1 hmem n (Nat.lt_succ_self n)
  · intro x h
    refine ⟨PowerSeries.mk (fun n ↦ PowerSeries.coeff n (x (n + 1))), ?_⟩
    intro n
    -- The Cauchy condition says each coefficient stabilizes by stage `i + 1`.
    rw [powerSeries_smodEq_span_X_pow_iff_coeff_eq (A := A) (n := n)]
    intro i hi
    have hstable :
        PowerSeries.coeff i (x (i + 1)) = PowerSeries.coeff i (x n) := by
      have hmod :
          x (i + 1) ≡ x n
            [SMOD ((Ideal.span ({(PowerSeries.X : PowerSeries A)} : Set (PowerSeries A))) ^
              (i + 1) • (⊤ : Submodule (PowerSeries A) (PowerSeries A)))] :=
        h (Nat.succ_le_of_lt hi)
      exact
        (powerSeries_smodEq_span_X_pow_iff_coeff_eq
          (A := A) (n := i + 1) (f := x (i + 1)) (g := x n)).1
          hmod i (Nat.lt_succ_self i)
    simpa [PowerSeries.coeff_mk] using hstable.symm

/-- Helper for Chap10 Lemma 10 161 17: a finite coefficient extension induces a finite
power-series coefficient extension. -/
theorem moduleFinite_powerSeries_of_moduleFinite
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] [Module.Finite R S] :
    Module.Finite R⟦X⟧ S⟦X⟧ := by
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := R) (M := S)
  refine Module.Finite.of_fg_top ?_
  refine (Submodule.fg_iff_exists_fin_generating_family).2 ⟨n, fun i ↦ PowerSeries.C (g i), ?_⟩
  apply top_unique
  intro f _
  classical
  have hspan : ∀ m, PowerSeries.coeff m f ∈ Submodule.span R (Set.range g) := by
    intro m
    simpa [hg] using (show PowerSeries.coeff m f ∈ (⊤ : Submodule R S) from trivial)
  let a : ℕ → Fin n → R := fun m ↦
    ((Submodule.mem_span_range_iff_exists_fun (R := R)).1 (hspan m)).choose
  let c : Fin n → R⟦X⟧ := fun i ↦ PowerSeries.mk fun m ↦ a m i
  refine (Submodule.mem_span_range_iff_exists_fun (R := R⟦X⟧)).2 ⟨c, ?_⟩
  -- Compare coefficients after expanding each coefficient of `f` in the finite spanning family.
  ext m
  have hcoeff :
      ∑ i, a m i • g i = PowerSeries.coeff m f :=
    ((Submodule.mem_span_range_iff_exists_fun (R := R)).1 (hspan m)).choose_spec
  calc
    PowerSeries.coeff m (∑ i, c i • PowerSeries.C (g i)) =
        ∑ i, PowerSeries.coeff m ((algebraMap R⟦X⟧ S⟦X⟧) (c i)) * g i := by
          simp [Algebra.smul_def]
    _ = ∑ i, (algebraMap R S) (a m i) * g i := by
      refine Finset.sum_congr rfl ?_
      intro i _
      change
        PowerSeries.coeff m (PowerSeries.map (algebraMap R S) (PowerSeries.mk fun n ↦ a n i)) *
            g i =
          (algebraMap R S) (a m i) * g i
      rw [PowerSeries.coeff_map, PowerSeries.coeff_mk]
    _ = ∑ i, a m i • g i := by
      simp [Algebra.smul_def]
    _ = PowerSeries.coeff m f := hcoeff

/-- Helper for Chap10 Lemma 10 161 17: `N-2` is preserved by ring equivalence between Noetherian
domains. -/
theorem isN2Ring_of_ringEquiv
    {A B : Type u} [CommRing A] [CommRing B] [IsDomain A] [IsDomain B]
    [IsNoetherianRing A] [IsNoetherianRing B] (e : A ≃+* B) [IsN2Ring A] :
    IsN2Ring B := by
  letI : Algebra B A := e.symm.toRingHom.toAlgebra
  letI : Module.Finite B A := by
    exact Module.Finite.of_surjective (Algebra.linearMap B A) e.symm.surjective
  -- Descend `N-2` along the finite extension induced by the equivalence.
  exact isN2Ring_of_finite_extension (R := B) (S := A) e.symm.injective

/-- Helper for Chap10 Lemma 10 161 17: a normal Noetherian `N-2` domain has an `N-2` one-variable
power series ring. -/
theorem isN2Ring_powerSeries_of_integrallyClosed
    (A : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A] [IsIntegrallyClosed A]
    [IsN2Ring A] :
    IsN2Ring A⟦X⟧ := by
  -- Route correction: the previous local route was blocked because the Tate criterion and
  -- power-series normality were not both in scope. Importing the earlier owner files makes the
  -- source proof a direct Tate application at the parameter `X`.
  let I : Ideal A⟦X⟧ :=
    Ideal.span ({(PowerSeries.X : PowerSeries A)} : Set A⟦X⟧)
  rcases powerSeries_quotient_span_X_ringEquiv A with ⟨e⟩
  letI : IsDomain (A⟦X⟧ ⧸ I) := e.toMulEquiv.isDomain A
  letI : IsN2Ring (A⟦X⟧ ⧸ I) := isN2Ring_of_ringEquiv e.symm
  letI : IsAdicComplete I A⟦X⟧ := powerSeries_isAdicComplete_span_X A
  -- The quotient by `(X)` is `A`, the `(X)`-adic completeness is explicit, and
  -- `Lemma_10_37_9` supplies normality of `A⟦X⟧`.
  exact isN2Ring_of_normal_of_adicComplete_of_principal_quotient_isN2Ring
    (R := A⟦X⟧) (PowerSeries.X : A⟦X⟧)

/-- Chap10 Lemma 10 161 17: if `R` is a Noetherian domain and `R` is `N-2`, then the formal
power series ring `R⟦X⟧` is `N-2`. -/
@[stacks 032Q]
theorem isN2Ring_powerSeries
    (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsN2Ring R] :
    IsN2Ring R⟦X⟧ := by
  let S := integralClosure R (FractionRing R)
  letI : Module.Finite R S := by
    infer_instance
  letI : IsNoetherianRing S := IsNoetherianRing.of_finite R S
  letI : IsIntegrallyClosed S :=
    integralClosure.isIntegrallyClosedOfFiniteExtension
      (R := R) (K := FractionRing R) (L := FractionRing R)
  letI : IsN2Ring S := isN2Ring_integralClosure_fractionRing R
  letI : Module.Finite R⟦X⟧ S⟦X⟧ :=
    moduleFinite_powerSeries_of_moduleFinite (R := R) (S := S)
  have hRS : Function.Injective (algebraMap R S) := by
    intro x y hxy
    apply IsFractionRing.injective R (FractionRing R)
    simpa [S] using congrArg (fun z : S => (z : FractionRing R)) hxy
  have hPowerSeriesInjective : Function.Injective (algebraMap R⟦X⟧ S⟦X⟧) := by
    simpa using PowerSeries.map_injective (algebraMap R S) hRS
  letI : IsN2Ring S⟦X⟧ := isN2Ring_powerSeries_of_integrallyClosed S
  -- Apply Tate to the normalized coefficient ring, then descend along the finite map
  -- `R⟦X⟧ → S⟦X⟧`.
  exact isN2Ring_of_finite_extension (R := R⟦X⟧) (S := S⟦X⟧) hPowerSeriesInjective

end
