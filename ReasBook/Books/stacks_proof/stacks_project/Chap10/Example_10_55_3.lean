/-- Helper for Chap10 Example 10 55 3: generic rank is additive on short exact sequences of
finitely generated modules. -/
private theorem finiteGrothendieckGroup_pidRank_respects_shortExact
    (S : ShortComplex (FGModuleCat R))
    (hS : (S.map (ModuleCat.isFG R).ι).ShortExact) :
    finiteGrothendieckGroup_pidRank R S.X₂ =
      finiteGrothendieckGroup_pidRank R S.X₁ + finiteGrothendieckGroup_pidRank R S.X₃ := by
  -- After tensoring with the fraction field, the row is a short exact sequence of finite
  -- dimensional vector spaces, so ordinary finrank additivity applies.
  let T : ShortComplex (ModuleCat (FractionRing R)) :=
    finiteGrothendieckGroup_fractionRingTensorShortComplex R S
  have hT : T.ShortExact := by
    simpa [T] using finiteGrothendieckGroup_fractionRingTensor_shortExact R S hS
  let _ : Module.Finite (FractionRing R) T.X₁ := by
    let U : ShortComplex (ModuleCat R) := S.map (ModuleCat.isFG R).ι
    let _ : Module.Finite R U.X₁ := by
      simpa [U] using (inferInstance : Module.Finite R S.X₁.obj)
    simpa [T, U, finiteGrothendieckGroup_fractionRingTensorShortComplex] using
      (inferInstance : Module.Finite (FractionRing R) ((FractionRing R) ⊗[R] U.X₁))
  let _ : Module.Finite (FractionRing R) T.X₃ := by
    let U : ShortComplex (ModuleCat R) := S.map (ModuleCat.isFG R).ι
    let _ : Module.Finite R U.X₃ := by
      simpa [U] using (inferInstance : Module.Finite R S.X₃.obj)
    simpa [T, U, finiteGrothendieckGroup_fractionRingTensorShortComplex] using
      (inferInstance : Module.Finite (FractionRing R) ((FractionRing R) ⊗[R] U.X₃))
  let _ : Module.Free (FractionRing R) T.X₁ :=
    Module.Free.of_divisionRing (FractionRing R) T.X₁
  let _ : Module.Free (FractionRing R) T.X₃ :=
    Module.Free.of_divisionRing (FractionRing R) T.X₃
  have hfinrank :
      Module.finrank (FractionRing R) T.X₂ =
        Module.finrank (FractionRing R) T.X₁ + Module.finrank (FractionRing R) T.X₃ := by
    simpa [T] using
      (ModuleCat.free_shortExact_finrank_add (S := T) hT rfl rfl)
  let _ : Module.Free (FractionRing R) ((FractionRing R) ⊗[R] S.X₁.obj) :=
    Module.Free.of_divisionRing (FractionRing R) ((FractionRing R) ⊗[R] S.X₁.obj)
  let _ : Module.Free (FractionRing R) ((FractionRing R) ⊗[R] S.X₂.obj) :=
    Module.Free.of_divisionRing (FractionRing R) ((FractionRing R) ⊗[R] S.X₂.obj)
  let _ : Module.Free (FractionRing R) ((FractionRing R) ⊗[R] S.X₃.obj) :=
    Module.Free.of_divisionRing (FractionRing R) ((FractionRing R) ⊗[R] S.X₃.obj)
  -- Cast the natural-number finrank identity to the integer-valued rank functional.
  simpa [finiteGrothendieckGroup_pidRank, T,
    finiteGrothendieckGroup_fractionRingTensorShortComplex, Nat.cast_add] using
    congrArg (fun n : ℕ ↦ (n : ℤ)) hfinrank

