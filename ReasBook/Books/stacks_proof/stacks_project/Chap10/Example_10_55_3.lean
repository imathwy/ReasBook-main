/-- Helper for Chap10 Example 10 55 3: the rank-one free class maps to `1` under generic rank. -/
private theorem finiteGrothendieckGroup_pidRankMap_freeClass_eq_one :
    finiteGrothendieckGroup_pidRankMap R
        (finiteGrothendieckGroupOf R (FGModuleCat.of R R)) = 1 := by
  -- Evaluate the descended rank map on the free rank-one generator.
  simpa [finiteGrothendieckGroup_pidRank, Module.finrank_tensorProduct, Module.finrank_self] using
    finiteGrothendieckGroup_pidRankMap_apply_of R (FGModuleCat.of R R)

/-- Chap10 Example 10 55 3: for a principal ideal domain `R`, the generic-rank map on
`K'_0(R)` is bijective. -/
-- Proof sketch: surjectivity is realized by the class of a free rank-one module. Injectivity
-- follows from the structure theorem for finitely generated modules over a principal ideal domain,
-- which shows that the Grothendieck class is determined by generic rank.
@[stacks 0FJ8]
theorem finiteGrothendieckGroup_pidRankMap_bijective :
    Function.Bijective (finiteGrothendieckGroup_pidRankMap R) := by
  let η : finiteGrothendieckGroup.{u, u} R :=
    finiteGrothendieckGroupOf R (FGModuleCat.of R R)
  let σ : ℤ →+ finiteGrothendieckGroup.{u, u} R := zmultiplesHom _ η
  have hright :
      (finiteGrothendieckGroup_pidRankMap R).comp σ = AddMonoidHom.id ℤ := by
    apply AddMonoidHom.ext_int
    -- The inverse candidate sends `1` to the rank-one free class, whose generic rank is `1`.
    calc
      ((finiteGrothendieckGroup_pidRankMap R).comp σ) 1 =
          finiteGrothendieckGroup_pidRankMap R η := by
        simp [AddMonoidHom.comp_apply, σ]
      _ = 1 := by
        simpa [η] using finiteGrothendieckGroup_pidRankMap_freeClass_eq_one R
  have hleft :
      σ.comp (finiteGrothendieckGroup_pidRankMap R) =
        AddMonoidHom.id (finiteGrothendieckGroup.{u, u} R) := by
    apply QuotientAddGroup.addMonoidHom_ext
    apply FreeAbelianGroup.lift_ext
    intro M
    -- Each generator class is the generic rank times the rank-one free class.
    calc
      (σ.comp (finiteGrothendieckGroup_pidRankMap R))
          (finiteGrothendieckGroupOf R M) =
          σ (finiteGrothendieckGroup_pidRank R M) := by
        rw [AddMonoidHom.comp_apply, finiteGrothendieckGroup_pidRankMap_apply_of]
        rfl
      _ = finiteGrothendieckGroup_pidRank R M • η := by
        simp [σ]
      _ = finiteGrothendieckGroupOf R M := by
        symm
        simpa [η] using finiteGrothendieckGroupOf_eq_pidRank_zsmul_freeClass R M
  constructor
  · intro x y hxy
    have hx : σ (finiteGrothendieckGroup_pidRankMap R x) = x := by
      simpa [AddMonoidHom.comp_apply] using DFunLike.congr_fun hleft x
    have hy : σ (finiteGrothendieckGroup_pidRankMap R y) = y := by
      simpa [AddMonoidHom.comp_apply] using DFunLike.congr_fun hleft y
    rw [← hx, ← hy, hxy]
  · intro z
    refine ⟨σ z, ?_⟩
    simpa [AddMonoidHom.comp_apply] using DFunLike.congr_fun hright z

/-- For a principal ideal domain `R`, the rank functional on finitely generated projective
`R`-modules is obtained by composing the canonical comparison map `K₀(R) → K'_0(R)` with the
generic-rank homomorphism `K'_0(R) → ℤ`. -/
def projectiveGrothendieckGroup_pidRankMap : projectiveGrothendieckGroup R →+ ℤ :=
  (finiteGrothendieckGroup_pidRankMap R).comp
    (ModulePropertyK0.map R (finiteProjectiveModuleProperty_le_isFG R))

/-- The PID rank map sends the class of a finite projective module to its rank. -/
theorem projectiveGrothendieckGroup_pidRankMap_apply_of
    (M : FiniteProjectiveModuleCat R) :
    projectiveGrothendieckGroup_pidRankMap R
        (projectiveGrothendieckGroupOf R M) =
      (Module.finrank R M.obj : ℤ) := by
  rw [projectiveGrothendieckGroup_pidRankMap, AddMonoidHom.comp_apply, ModulePropertyK0.map_of,
    finiteGrothendieckGroup_pidRankMap_apply_of]
  exact finiteProjectiveModuleCat_genericRank_eq_rank R M

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- Helper for Chap10 Example 10 55 3: a finite free module is an object of the finite
projective subcategory. -/
private theorem finiteProjectiveModulePropertyOfFiniteFree
    {M : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M] :
    finiteProjectiveModuleProperty R (ModuleCat.of R M) := by
  -- Finiteness is assumed, and freeness supplies projectivity.
  exact ⟨inferInstance, inferInstance⟩

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- Helper for Chap10 Example 10 55 3: the zero module is finite projective. -/
private theorem finiteProjectiveModulePropertyZero :
    finiteProjectiveModuleProperty R (ModuleCat.of R PUnit) := by
  -- The zero module is both finite and projective.
  exact ⟨inferInstance, inferInstance⟩

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- Helper for Chap10 Example 10 55 3: the product of finite projective modules is finite
projective. -/
private theorem finiteProjectiveModulePropertyProd
    (M N : ModuleCat R)
    (hM : finiteProjectiveModuleProperty R M)
    (hN : finiteProjectiveModuleProperty R N) :
    finiteProjectiveModuleProperty R (ModuleCat.of R (M × N)) := by
  -- Products preserve both finite generation and projectivity in this module category.
  let _ : Module.Finite R M := hM.1
  let _ : Module.Projective R M := hM.2
  let _ : Module.Finite R N := hN.1
  let _ : Module.Projective R N := hN.2
  exact ⟨inferInstance, inferInstance⟩

/-- Helper for Chap10 Example 10 55 3: same-universe finite projective modules. -/
private abbrev finiteProjectiveModuleCatSameUniverse :=
  FiniteProjectiveModuleCat.{u, u} R

/-- Helper for Chap10 Example 10 55 3: the same-universe projective Grothendieck group. -/
private abbrev projectiveGrothendieckGroupSameUniverse :=
  projectiveGrothendieckGroup.{u, u} R

/-- Helper for Chap10 Example 10 55 3: the rank-one free module as a finite projective object. -/
private abbrev rankOneFiniteProjectiveModule :
    finiteProjectiveModuleCatSameUniverse (R := R) :=
  ⟨ModuleCat.of R R, finiteProjectiveModulePropertyOfFiniteFree (R := R) (M := R)⟩

/-- Helper for Chap10 Example 10 55 3: the standard free module of rank `n` as a finite
projective object. -/
private abbrev standardFreeFiniteProjectiveModule (n : ℕ) :
    finiteProjectiveModuleCatSameUniverse (R := R) :=
  ⟨ModuleCat.of R (Fin n → R),
    finiteProjectiveModulePropertyOfFiniteFree (R := R) (M := Fin n → R)⟩

/-- Helper for Chap10 Example 10 55 3: the product of two finite projective objects. -/
private abbrev prodFiniteProjectiveModule
    (M N : finiteProjectiveModuleCatSameUniverse (R := R)) :
    finiteProjectiveModuleCatSameUniverse (R := R) :=
  ⟨ModuleCat.of R (M.obj × N.obj),
    finiteProjectiveModulePropertyProd (R := R) M.obj N.obj M.property N.property⟩

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- Helper for Chap10 Example 10 55 3: the zero-rank standard free projective module has zero
Grothendieck class. -/
private theorem standardFreeProjectiveZeroClass_eq_zero :
    projectiveGrothendieckGroupOf R
      (standardFreeFiniteProjectiveModule (R := R) 0) = 0 := by
  -- A rank-zero free module is subsingleton, so its class agrees with the zero object.
  let _ : Subsingleton (Fin 0 → R) := inferInstance
  simpa using
    (ModulePropertyK0.of_subsingleton (R := R) (P := finiteProjectiveModuleProperty R)
      (finiteProjectiveModulePropertyZero (R := R))
      (standardFreeFiniteProjectiveModule (R := R) 0))

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- Helper for Chap10 Example 10 55 3: `R × R^n` is isomorphic to the standard free module of
rank `n + 1` inside the finite projective subcategory. -/
private def standardFreeProjectiveSuccIsoProd (n : ℕ) :
    prodFiniteProjectiveModule (R := R)
      (rankOneFiniteProjectiveModule (R := R))
      (standardFreeFiniteProjectiveModule (R := R) n) ≅
        standardFreeFiniteProjectiveModule (R := R) n.succ :=
  ObjectProperty.isoMk (P := finiteProjectiveModuleProperty R)
    (LinearEquiv.toModuleIso (Fin.consLinearEquiv R (fun _ : Fin n.succ ↦ R)))

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- Helper for Chap10 Example 10 55 3: products give sums in the projective Grothendieck group.
-/
private theorem projectiveGrothendieckGroupOf_prod
    (M N : finiteProjectiveModuleCatSameUniverse (R := R)) :
    projectiveGrothendieckGroupOf R (prodFiniteProjectiveModule (R := R) M N) =
      projectiveGrothendieckGroupOf R M + projectiveGrothendieckGroupOf R N := by
  -- Use the split short exact sequence `0 → M → M × N → N → 0`.
  let P := finiteProjectiveModuleProperty R
  let f : M ⟶ prodFiniteProjectiveModule (R := R) M N :=
    ObjectProperty.homMk (ModuleCat.ofHom (LinearMap.inl R M.obj N.obj))
  let g : prodFiniteProjectiveModule (R := R) M N ⟶ N :=
    ObjectProperty.homMk (ModuleCat.ofHom (LinearMap.snd R M.obj N.obj))
  have hzero : f ≫ g = 0 := by
    apply ObjectProperty.hom_ext
    ext x
    rfl
  let S : ShortComplex P.FullSubcategory := ShortComplex.mk f g hzero
  have hS : (S.map P.ι).ShortExact := by
    refine ModuleCat.shortComplex_shortExact (S.map P.ι) ?_ ?_ ?_
    · intro x
      constructor
      · intro hx
        refine ⟨x.1, ?_⟩
        apply Prod.ext
        · rfl
        · simpa [S, g] using hx.symm
      · rintro ⟨m, rfl⟩
        rfl
    · intro m m' hmm'
      exact congrArg Prod.fst hmm'
    · intro n
      refine ⟨(0, n), ?_⟩
      rfl
  -- Apply the defining short exact sequence relation in `K₀`.
  simpa [S, f, g, prodFiniteProjectiveModule] using
    ModulePropertyK0.of_shortExact (R := R) (P := P) S hS

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- Helper for Chap10 Example 10 55 3: the standard free finite projective module of rank `n`
represents `n` times the rank-one free class. -/
private theorem projectiveGrothendieckGroup_standardFreeClass_eq_nsmul (n : ℕ) :
    projectiveGrothendieckGroupOf R
      (standardFreeFiniteProjectiveModule (R := R) n) =
        n • projectiveGrothendieckGroupOf R (rankOneFiniteProjectiveModule (R := R)) := by
  -- Split off one copy of `R` at each successor rank.
  let η : projectiveGrothendieckGroupSameUniverse (R := R) :=
    projectiveGrothendieckGroupOf R (rankOneFiniteProjectiveModule (R := R))
  induction n with
  | zero =>
      simpa [η] using standardFreeProjectiveZeroClass_eq_zero (R := R)
  | succ n ih =>
      have hcons :
          projectiveGrothendieckGroupOf R
              (prodFiniteProjectiveModule (R := R)
                (rankOneFiniteProjectiveModule (R := R))
                (standardFreeFiniteProjectiveModule (R := R) n)) =
            projectiveGrothendieckGroupOf R
              (standardFreeFiniteProjectiveModule (R := R) n.succ) := by
        -- Transport the product decomposition across the canonical standard-free isomorphism.
        exact ModulePropertyK0.of_iso (R := R) (P := finiteProjectiveModuleProperty R)
          (finiteProjectiveModulePropertyZero (R := R))
          (standardFreeProjectiveSuccIsoProd (R := R) n)
      calc
        projectiveGrothendieckGroupOf R
            (standardFreeFiniteProjectiveModule (R := R) n.succ) =
            projectiveGrothendieckGroupOf R
              (prodFiniteProjectiveModule (R := R)
                (rankOneFiniteProjectiveModule (R := R))
                (standardFreeFiniteProjectiveModule (R := R) n)) := by
          simpa using hcons.symm
        _ = projectiveGrothendieckGroupOf R (rankOneFiniteProjectiveModule (R := R)) +
              projectiveGrothendieckGroupOf R
                (standardFreeFiniteProjectiveModule (R := R) n) := by
          exact projectiveGrothendieckGroupOf_prod (R := R)
            (rankOneFiniteProjectiveModule (R := R))
            (standardFreeFiniteProjectiveModule (R := R) n)
        _ = η + n • η := by
          simpa [η] using congrArg
            (fun x : projectiveGrothendieckGroupSameUniverse (R := R) ↦ η + x) ih
        _ = n.succ • η := by
          rw [succ_nsmul, add_comm]

/-- Helper for Chap10 Example 10 55 3: finite projective modules over the PID are free. -/
private theorem finiteProjectiveModule_free_of_pid
    {M : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Projective R M] :
    Module.Free R M := by
  -- A finite projective module is a direct summand of a finite free module, hence torsion-free;
  -- finite torsion-free modules over a PID are free.
  let _ : Module.IsTorsionFree R M := by
    obtain ⟨n, _, g, _, hg, _⟩ := Module.Finite.exists_comp_eq_id_of_projective R M
    exact hg.moduleIsTorsionFree g fun r m ↦ by simp
  exact Module.free_of_finite_type_torsion_free'

/-- Helper for Chap10 Example 10 55 3: every finite projective module over the PID has
Grothendieck class equal to its rank times the rank-one free class. -/
private theorem projectiveGrothendieckGroupOf_eq_rank_zsmul_freeClass
    (M : finiteProjectiveModuleCatSameUniverse (R := R)) :
    projectiveGrothendieckGroupOf R M =
      (Module.finrank R M.obj : ℤ) •
        projectiveGrothendieckGroupOf R (rankOneFiniteProjectiveModule (R := R)) := by
  -- Freeness over the PID identifies `M` with the standard free module of the same rank.
  let _ : Module.Free R M.obj := finiteProjectiveModule_free_of_pid (R := R) (M := M.obj)
  let e : M.obj ≃ₗ[R] (Fin (Module.finrank R M.obj) → R) :=
    LinearEquiv.ofFinrankEq (R := R) M.obj (Fin (Module.finrank R M.obj) → R) (by simp)
  have hclass :
      projectiveGrothendieckGroupOf R M =
        projectiveGrothendieckGroupOf R
          (standardFreeFiniteProjectiveModule (R := R) (Module.finrank R M.obj)) := by
    -- Isomorphic finite projective modules have the same Grothendieck class.
    exact ModulePropertyK0.of_iso (R := R) (P := finiteProjectiveModuleProperty R)
      (finiteProjectiveModulePropertyZero (R := R))
      (ObjectProperty.isoMk (P := finiteProjectiveModuleProperty R)
        (LinearEquiv.toModuleIso e))
  let η : projectiveGrothendieckGroupSameUniverse (R := R) :=
    projectiveGrothendieckGroupOf R (rankOneFiniteProjectiveModule (R := R))
  calc
    projectiveGrothendieckGroupOf R M =
        projectiveGrothendieckGroupOf R
          (standardFreeFiniteProjectiveModule (R := R) (Module.finrank R M.obj)) := hclass
    _ = Module.finrank R M.obj • η := by
      exact projectiveGrothendieckGroup_standardFreeClass_eq_nsmul
        (R := R) (Module.finrank R M.obj)
    _ = (Module.finrank R M.obj : ℤ) • η := by
      rw [natCast_zsmul]

/-- Consequence of Chap10 Example 10 55 3: for a principal ideal domain `R`, the rank map on
`K₀(R)` is bijective. -/
-- Proof sketch: finite projective modules over a principal ideal domain are free, so the
-- Grothendieck class of a finite projective module is determined by its rank, and every integer is
-- realized by the difference of free-module classes.
theorem projectiveGrothendieckGroup_pidRankMap_bijective :
    Function.Bijective (projectiveGrothendieckGroup_pidRankMap R) := by
  let η : projectiveGrothendieckGroupSameUniverse (R := R) :=
    projectiveGrothendieckGroupOf R (rankOneFiniteProjectiveModule (R := R))
  let σ : ℤ →+ projectiveGrothendieckGroupSameUniverse (R := R) := zmultiplesHom _ η
  have hright :
      (projectiveGrothendieckGroup_pidRankMap R).comp σ = AddMonoidHom.id ℤ := by
    apply AddMonoidHom.ext_int
    -- The inverse candidate sends `1` to the free rank-one projective class.
    calc
      ((projectiveGrothendieckGroup_pidRankMap R).comp σ) 1 =
          projectiveGrothendieckGroup_pidRankMap R η := by
        simp [AddMonoidHom.comp_apply, σ]
      _ = 1 := by
        simpa [η, rankOneFiniteProjectiveModule, Module.finrank_self] using
          projectiveGrothendieckGroup_pidRankMap_apply_of R
            (rankOneFiniteProjectiveModule (R := R))
  have hleft :
      σ.comp (projectiveGrothendieckGroup_pidRankMap R) =
        AddMonoidHom.id (projectiveGrothendieckGroupSameUniverse (R := R)) := by
    apply QuotientAddGroup.addMonoidHom_ext
    apply FreeAbelianGroup.lift_ext
    intro M
    -- On generators, the map is inverted by the rank normal form for finite projectives.
    calc
      (σ.comp (projectiveGrothendieckGroup_pidRankMap R))
          (projectiveGrothendieckGroupOf R M) =
          σ (Module.finrank R M.obj : ℤ) := by
        rw [AddMonoidHom.comp_apply, projectiveGrothendieckGroup_pidRankMap_apply_of]
      _ = (Module.finrank R M.obj : ℤ) • η := by
        simp [σ]
      _ = projectiveGrothendieckGroupOf R M := by
        symm
        simpa [η] using projectiveGrothendieckGroupOf_eq_rank_zsmul_freeClass R M
  constructor
  · intro x y hxy
    have hx : σ (projectiveGrothendieckGroup_pidRankMap R x) = x := by
      simpa [AddMonoidHom.comp_apply] using DFunLike.congr_fun hleft x
    have hy : σ (projectiveGrothendieckGroup_pidRankMap R y) = y := by
      simpa [AddMonoidHom.comp_apply] using DFunLike.congr_fun hleft y
    rw [← hx, ← hy, hxy]
  · intro z
    refine ⟨σ z, ?_⟩
    simpa [AddMonoidHom.comp_apply] using DFunLike.congr_fun hright z

/-- For a principal ideal domain `R`, the rank map identifies the Grothendieck group `K₀(R)` of
finitely generated projective `R`-modules with `ℤ`. -/
noncomputable def projectiveGrothendieckGroup_pidEquiv : projectiveGrothendieckGroup R ≃+ ℤ :=
  AddEquiv.ofBijective (projectiveGrothendieckGroup_pidRankMap R)
    (projectiveGrothendieckGroup_pidRankMap_bijective R)

/-- The additive equivalence `K₀(R) ≃+ ℤ` acts by the PID rank map. -/
theorem projectiveGrothendieckGroup_pidEquiv_apply
    (x : projectiveGrothendieckGroup R) :
    projectiveGrothendieckGroup_pidEquiv R x =
      projectiveGrothendieckGroup_pidRankMap R x := rfl

/-- For a principal ideal domain `R`, the structure theorem for finitely generated modules
identifies `K'_0(R)` with `ℤ`; in this Noetherian setting `K'_0(R)` is modeled canonically here by
finite `R`-modules. -/
noncomputable def finiteGrothendieckGroup_pidEquiv : finiteGrothendieckGroup R ≃+ ℤ :=
  AddEquiv.ofBijective (finiteGrothendieckGroup_pidRankMap R)
    (finiteGrothendieckGroup_pidRankMap_bijective R)

/-- The additive equivalence `K'_0(R) ≃+ ℤ` acts by the PID generic-rank map. -/
theorem finiteGrothendieckGroup_pidEquiv_apply
    (x : finiteGrothendieckGroup R) :
    finiteGrothendieckGroup_pidEquiv R x =
      finiteGrothendieckGroup_pidRankMap R x := rfl

omit [IsPrincipalIdealRing R] in
/-- On a principal ideal domain, the canonical comparison map `K₀(R) → K'_0(R)` commutes with the
rank and generic-rank homomorphisms to `ℤ`. -/
theorem projectiveGrothendieckGroup_comparison_commutes_with_pidRank :
    (finiteGrothendieckGroup_pidRankMap R).comp
        (ModulePropertyK0.map R (finiteProjectiveModuleProperty_le_isFG R)) =
      projectiveGrothendieckGroup_pidRankMap R := by
  rfl

omit [IsPrincipalIdealRing R] in
/-- On an element of `K₀(R)`, the generic rank after comparison to `K'_0(R)` agrees with the
rank in `K₀(R)`. -/
@[simp] theorem projectiveGrothendieckGroup_comparison_commutes_with_pidRank_apply
    (x : projectiveGrothendieckGroup R) :
    finiteGrothendieckGroup_pidRankMap R
        (ModulePropertyK0.map R (finiteProjectiveModuleProperty_le_isFG R) x) =
      projectiveGrothendieckGroup_pidRankMap R x := by
  simpa using DFunLike.congr_fun
    (projectiveGrothendieckGroup_comparison_commutes_with_pidRank R) x

/-- Under the PID identifications `K₀(R) ≃+ ℤ` and `K'_0(R) ≃+ ℤ`, the canonical comparison map
`K₀(R) → K'_0(R)` acts as the identity on `ℤ`. -/
@[simp] theorem pid_projectiveGrothendieckGroup_to_finiteGrothendieckGroup_apply
    (x : projectiveGrothendieckGroup R) :
    finiteGrothendieckGroup_pidEquiv R
        (ModulePropertyK0.map R (finiteProjectiveModuleProperty_le_isFG R) x) =
      projectiveGrothendieckGroup_pidEquiv R x := by
  change finiteGrothendieckGroup_pidRankMap R
      (ModulePropertyK0.map R (finiteProjectiveModuleProperty_le_isFG R) x) =
    projectiveGrothendieckGroup_pidRankMap R x
  exact projectiveGrothendieckGroup_comparison_commutes_with_pidRank_apply R x

/-- For a principal ideal domain `R`, the canonical comparison map `K₀(R) → K'_0(R)` is the
identification obtained by passing through `ℤ`. In particular, `K₀(R) ≃+ K'_0(R) ≃+ ℤ`. -/
theorem pid_projectiveGrothendieckGroup_to_finiteGrothendieckGroup_eq :
    ModulePropertyK0.map R (finiteProjectiveModuleProperty_le_isFG R) =
      (finiteGrothendieckGroup_pidEquiv R).symm.toAddMonoidHom.comp
        (projectiveGrothendieckGroup_pidEquiv R).toAddMonoidHom := by
  apply AddMonoidHom.ext
  intro x
  apply (finiteGrothendieckGroup_pidEquiv R).injective
  simp [pid_projectiveGrothendieckGroup_to_finiteGrothendieckGroup_apply]

end
