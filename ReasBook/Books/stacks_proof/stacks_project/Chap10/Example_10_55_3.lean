/-- Helper for Chap10 Example 10 55 3: products give sums in the finite-module Grothendieck
group. -/
private theorem finiteGrothendieckGroupOf_prod
    (M N : FGModuleCat.{u, u} R) :
    finiteGrothendieckGroupOf R (FGModuleCat.of R (M.obj × N.obj)) =
      finiteGrothendieckGroupOf R M + finiteGrothendieckGroupOf R N := by
  -- Use the split short exact sequence `0 → M → M × N → N → 0`.
  let f : M ⟶ FGModuleCat.of R (M.obj × N.obj) :=
    FGModuleCat.ofHom (LinearMap.inl R M.obj N.obj)
  let g : FGModuleCat.of R (M.obj × N.obj) ⟶ N :=
    FGModuleCat.ofHom (LinearMap.snd R M.obj N.obj)
  have hzero : f ≫ g = 0 := by
    apply FGModuleCat.hom_ext
    rfl
  let S : ShortComplex (FGModuleCat.{u, u} R) := ShortComplex.mk f g hzero
  have hS : (S.map (ModuleCat.isFG R).ι).ShortExact := by
    refine ModuleCat.shortComplex_shortExact (S.map (ModuleCat.isFG R).ι) ?_ ?_ ?_
    · intro x
      constructor
      · intro hx
        refine ⟨x.1, ?_⟩
        apply Prod.ext
        · rfl
        · simpa [S, g] using hx.symm
      · rintro ⟨m, rfl⟩
        rfl
    · intro m m' hmm'
      exact congrArg Prod.fst hmm'
    · intro n
      refine ⟨(0, n), ?_⟩
      rfl
  -- The Grothendieck defining relation for the split sequence is exactly product additivity.
  simpa [S, f, g, finiteGrothendieckGroupOf] using
    ModulePropertyK0.of_shortExact (R := R) (P := ModuleCat.isFG R) S hS

