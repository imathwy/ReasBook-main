/-- Helper for Chap10 Example 10 55 3: tensoring a short exact sequence of finitely generated
modules with the fraction ring remains short exact. -/
private theorem finiteGrothendieckGroup_fractionRingTensor_shortExact
    (S : ShortComplex (FGModuleCat R))
    (hS : (S.map (ModuleCat.isFG R).ι).ShortExact) :
    (finiteGrothendieckGroup_fractionRingTensorShortComplex R S).ShortExact := by
  -- Flatness of the fraction ring preserves exactness and injectivity; right exactness gives
  -- surjectivity of the final tensor map.
  let U : ShortComplex (ModuleCat R) := S.map (ModuleCat.isFG R).ι
  refine ModuleCat.shortComplex_shortExact
    (finiteGrothendieckGroup_fractionRingTensorShortComplex R S) ?_ ?_ ?_
  · have hExactBase : Function.Exact U.f.hom U.g.hom := by
      exact (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact U).1 hS.exact
    simpa [finiteGrothendieckGroup_fractionRingTensorShortComplex, U] using
      (Module.Flat.lTensor_exact (FractionRing R) hExactBase)
  · have hf : Function.Injective U.f.hom := by
      simpa [U] using hS.moduleCat_injective_f
    simpa [finiteGrothendieckGroup_fractionRingTensorShortComplex, U] using
      (Module.Flat.lTensor_preserves_injective_linearMap
        (M := FractionRing R) U.f.hom hf)
  · have hg : Function.Surjective U.g.hom := by
      simpa [U] using hS.moduleCat_surjective_g
    simpa [finiteGrothendieckGroup_fractionRingTensorShortComplex, U] using
      (LinearMap.lTensor_surjective (FractionRing R) hg)

