/-- Helper for Chap10 Example 10 55 3: the zero module belongs to the finitely generated
subcategory. -/
private theorem finiteGrothendieckGroup_isFG_zero :
    ModuleCat.isFG R (ModuleCat.of R PUnit) := by
  -- The zero module is generated by the empty finite set.
  rw [ModuleCat.isFG_iff]
  infer_instance

