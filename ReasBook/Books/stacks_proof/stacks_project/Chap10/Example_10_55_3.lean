/-- Helper for Chap10 Example 10 55 3: a finite free module has generic rank equal to its ordinary
finite free rank. -/
private theorem finiteGrothendieckGroup_pidRank_free_eq_finrank
    {M : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M] :
    finiteGrothendieckGroup_pidRank R (FGModuleCat.of R M) =
      (Module.finrank R M : ℤ) := by
  -- Base change of a finite free module to the fraction field preserves its finite rank.
  norm_num [finiteGrothendieckGroup_pidRank, Module.finrank_tensorProduct]

