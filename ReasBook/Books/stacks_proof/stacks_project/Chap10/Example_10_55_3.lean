/-- Helper for Chap10 Example 10 55 3: the standard free finite module of rank `n` represents
`n` times the rank-one free class. -/
private theorem finiteGrothendieckGroup_standardFreeClass_eq_nsmul (n : ℕ) :
    finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin n → R)) =
      n • finiteGrothendieckGroupOf R (FGModuleCat.of R R) := by
  -- Inductively split `R^(n+1)` as `R × R^n`.
  let η : finiteGrothendieckGroup.{u, u} R :=
    finiteGrothendieckGroupOf R (FGModuleCat.of R R)
  induction n with
  | zero =>
      haveI : Subsingleton (Fin 0 → R) := inferInstance
      simpa [η, finiteGrothendieckGroupOf] using
        (ModulePropertyK0.of_subsingleton (R := R) (P := ModuleCat.isFG R)
          (finiteGrothendieckGroup_isFG_zero R) (FGModuleCat.of R (Fin 0 → R)))
  | succ n ih =>
      let e : FGModuleCat.of R (R × (Fin n → R)) ≅
          FGModuleCat.of R (Fin n.succ → R) :=
        (Fin.consLinearEquiv R (fun _ : Fin n.succ ↦ R)).toFGModuleCatIso
      have hcons :
          finiteGrothendieckGroupOf R (FGModuleCat.of R (R × (Fin n → R))) =
            finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin n.succ → R)) := by
        exact ModulePropertyK0.of_iso (R := R) (P := ModuleCat.isFG R)
          (finiteGrothendieckGroup_isFG_zero R) e
      calc
        finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin n.succ → R)) =
            finiteGrothendieckGroupOf R (FGModuleCat.of R (R × (Fin n → R))) := by
          simpa using hcons.symm
        _ = finiteGrothendieckGroupOf R (FGModuleCat.of R R) +
              finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin n → R)) := by
          simpa using finiteGrothendieckGroupOf_prod (R := R)
            (FGModuleCat.of R R) (FGModuleCat.of R (Fin n → R))
        _ = η + n • η := by
          simpa [η] using congrArg (fun x : finiteGrothendieckGroup.{u, u} R ↦ η + x) ih
        _ = n.succ • η := by
          rw [succ_nsmul, add_comm]

