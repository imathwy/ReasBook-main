/-- Helper for Chap10 Example 10 55 3: any finite free module has Grothendieck class equal to its
rank times the rank-one free class. -/
private theorem finiteGrothendieckGroupOf_free_eq_finrank_zsmul_freeClass
    {M : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M] [Module.Free R M] :
    finiteGrothendieckGroupOf R (FGModuleCat.of R M) =
      (Module.finrank R M : ℤ) • finiteGrothendieckGroupOf R (FGModuleCat.of R R) := by
  -- Identify the finite free module with the standard free module of the same finite rank.
  let e : M ≃ₗ[R] (Fin (Module.finrank R M) → R) :=
    LinearEquiv.ofFinrankEq M (Fin (Module.finrank R M) → R) (by simp)
  have hclass :
      finiteGrothendieckGroupOf R (FGModuleCat.of R M) =
        finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin (Module.finrank R M) → R)) := by
    exact ModulePropertyK0.of_iso (R := R) (P := ModuleCat.isFG R)
      (finiteGrothendieckGroup_isFG_zero R) e.toFGModuleCatIso
  calc
    finiteGrothendieckGroupOf R (FGModuleCat.of R M) =
        finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin (Module.finrank R M) → R)) := hclass
    _ = (Module.finrank R M) • finiteGrothendieckGroupOf R (FGModuleCat.of R R) := by
      exact finiteGrothendieckGroup_standardFreeClass_eq_nsmul (R := R) (Module.finrank R M)
    _ = (Module.finrank R M : ℤ) • finiteGrothendieckGroupOf R (FGModuleCat.of R R) := by
      rw [natCast_zsmul]

/-- Helper for Chap10 Example 10 55 3: every finitely generated module over the PID has class
given by its generic rank times the rank-one free class. -/
private theorem finiteGrothendieckGroupOf_eq_pidRank_zsmul_freeClass
    (M : FGModuleCat.{u, u} R) :
    finiteGrothendieckGroupOf R M =
      finiteGrothendieckGroup_pidRank R M •
        finiteGrothendieckGroupOf R (FGModuleCat.of R R) := by
  -- Present `M` as a quotient of a finite free module and use the free kernel over a PID.
  classical
  let _ : Module.Finite R M.obj := M.property
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' R M.obj
  let K : Submodule R (Fin n → R) := LinearMap.ker π
  have hKFinite : Module.Finite R K := by
    infer_instance
  let _ : Module.Finite R K := hKFinite
  have hKTorsionFree : Module.IsTorsionFree R K := by
    infer_instance
  let _ : Module.IsTorsionFree R K := hKTorsionFree
  have hKFree : Module.Free R K :=
    Module.free_of_finite_type_torsion_free'
  let _ : Module.Free R K := hKFree
  let X₁ : FGModuleCat.{u, u} R := FGModuleCat.of R K
  let X₂ : FGModuleCat.{u, u} R := FGModuleCat.of R (Fin n → R)
  let f : X₁ ⟶ X₂ := FGModuleCat.ofHom K.subtype
  let g : X₂ ⟶ M := FGModuleCat.ofHom π
  have hzero : f ≫ g = 0 := by
    apply FGModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact LinearMap.mem_ker.mp x.2
  let S : ShortComplex (FGModuleCat.{u, u} R) := ShortComplex.mk f g hzero
  have hS : (S.map (ModuleCat.isFG R).ι).ShortExact := by
    refine ModuleCat.shortComplex_shortExact (S.map (ModuleCat.isFG R).ι) ?_ ?_ ?_
    · exact LinearMap.exact_subtype_ker_map π
    · exact Subtype.val_injective
    · exact hπ
  have hrelation :
      finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin n → R)) =
        finiteGrothendieckGroupOf R (FGModuleCat.of R K) + finiteGrothendieckGroupOf R M := by
    -- The presentation row contributes the defining relation `[R^n] = [K] + [M]`.
    simpa [S, X₁, X₂, f, g, finiteGrothendieckGroupOf] using
      ModulePropertyK0.of_shortExact (R := R) (P := ModuleCat.isFG R) S hS
  have hclass :
      finiteGrothendieckGroupOf R M =
        finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin n → R)) -
          finiteGrothendieckGroupOf R (FGModuleCat.of R K) := by
    rw [hrelation]
    abel
  have hrankSeq :
      finiteGrothendieckGroup_pidRank R (FGModuleCat.of R (Fin n → R)) =
        finiteGrothendieckGroup_pidRank R (FGModuleCat.of R K) +
          finiteGrothendieckGroup_pidRank R M := by
    simpa [S, X₁, X₂] using finiteGrothendieckGroup_pidRank_respects_shortExact R S hS
  have hRankFree :
      finiteGrothendieckGroup_pidRank R (FGModuleCat.of R (Fin n → R)) = (n : ℤ) := by
    simpa using
      (finiteGrothendieckGroup_pidRank_free_eq_finrank (R := R) (M := (Fin n → R)))
  have hRankKernel :
      finiteGrothendieckGroup_pidRank R (FGModuleCat.of R K) =
        (Module.finrank R K : ℤ) := by
    exact finiteGrothendieckGroup_pidRank_free_eq_finrank (R := R) (M := K)
  have hRankCoeff :
      finiteGrothendieckGroup_pidRank R M = (n : ℤ) - (Module.finrank R K : ℤ) := by
    have hseq :
        (n : ℤ) =
          (Module.finrank R K : ℤ) + finiteGrothendieckGroup_pidRank R M := by
      simpa [hRankFree, hRankKernel] using hrankSeq
    linarith
  let η : finiteGrothendieckGroup.{u, u} R :=
    finiteGrothendieckGroupOf R (FGModuleCat.of R R)
  have hFreeClass :
      finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin n → R)) = (n : ℤ) • η := by
    simpa [η, natCast_zsmul] using
      finiteGrothendieckGroup_standardFreeClass_eq_nsmul (R := R) n
  have hKernelClass :
      finiteGrothendieckGroupOf R (FGModuleCat.of R K) =
        (Module.finrank R K : ℤ) • η := by
    simpa [η] using
      (finiteGrothendieckGroupOf_free_eq_finrank_zsmul_freeClass (R := R) (M := K))
  calc
    finiteGrothendieckGroupOf R M =
        finiteGrothendieckGroupOf R (FGModuleCat.of R (Fin n → R)) -
          finiteGrothendieckGroupOf R (FGModuleCat.of R K) := hclass
    _ = (n : ℤ) • η - (Module.finrank R K : ℤ) • η := by
      rw [hFreeClass, hKernelClass]
    _ = ((n : ℤ) - (Module.finrank R K : ℤ)) • η := by
      simpa [sub_eq_add_neg] using
        (sub_zsmul η (n : ℤ) (Module.finrank R K : ℤ)).symm
    _ = finiteGrothendieckGroup_pidRank R M • η := by
      rw [← hRankCoeff]

