/-- Helper for Chap10 Example 10 55 3: the tensorized maps in a short complex still compose to
zero after base change to the fraction ring. -/
private theorem finiteGrothendieckGroup_fractionRingTensor_comp_zero
    (S : ShortComplex (FGModuleCat R)) :
    let U : ShortComplex (ModuleCat R) := S.map (ModuleCat.isFG R).ι
    let fT : ModuleCat.of (FractionRing R) ((FractionRing R) ⊗[R] U.X₁) ⟶
        ModuleCat.of (FractionRing R) ((FractionRing R) ⊗[R] U.X₂) :=
      ModuleCat.ofHom (LinearMap.lTensor (FractionRing R) U.f.hom)
    let gT : ModuleCat.of (FractionRing R) ((FractionRing R) ⊗[R] U.X₂) ⟶
        ModuleCat.of (FractionRing R) ((FractionRing R) ⊗[R] U.X₃) :=
      ModuleCat.ofHom (LinearMap.lTensor (FractionRing R) U.g.hom)
    fT ≫ gT = 0 := by
  -- Push the original equation `g ∘ f = 0` through the functoriality of `lTensor`.
  dsimp
  apply ModuleCat.hom_ext
  apply DFunLike.ext
  intro x
  let U : ShortComplex (ModuleCat R) := S.map (ModuleCat.isFG R).ι
  change (LinearMap.lTensor (FractionRing R) U.g.hom)
      ((LinearMap.lTensor (FractionRing R) U.f.hom) x) = 0
  rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp]
  let hzero : U.g.hom.comp U.f.hom = 0 := by
    ext y
    simpa [LinearMap.comp_apply] using U.moduleCat_zero_apply y
  rw [hzero]
  simp

/-- Helper for Chap10 Example 10 55 3: the fraction-ring base change of a short complex of
finitely generated modules. -/
private noncomputable def finiteGrothendieckGroup_fractionRingTensorShortComplex
    (S : ShortComplex (FGModuleCat R)) :
    ShortComplex (ModuleCat (FractionRing R)) :=
  let U : ShortComplex (ModuleCat R) := S.map (ModuleCat.isFG R).ι
  let fT : ModuleCat.of (FractionRing R) ((FractionRing R) ⊗[R] U.X₁) ⟶
      ModuleCat.of (FractionRing R) ((FractionRing R) ⊗[R] U.X₂) :=
    ModuleCat.ofHom (LinearMap.lTensor (FractionRing R) U.f.hom)
  let gT : ModuleCat.of (FractionRing R) ((FractionRing R) ⊗[R] U.X₂) ⟶
      ModuleCat.of (FractionRing R) ((FractionRing R) ⊗[R] U.X₃) :=
    ModuleCat.ofHom (LinearMap.lTensor (FractionRing R) U.g.hom)
  ShortComplex.mk fT gT (finiteGrothendieckGroup_fractionRingTensor_comp_zero R S)

