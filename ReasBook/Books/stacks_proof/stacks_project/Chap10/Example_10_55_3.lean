/-- Helper for Chap10 Example 10 55 3: the defining Grothendieck relations for finite
`R`-modules lie in the kernel of generic rank over the fraction field. -/
-- Proof sketch: the structure theorem for finitely generated modules over a principal ideal domain
-- reduces a Grothendieck relation to free and torsion summands; the generic rank vanishes on the
-- torsion part and is additive on short exact sequences, so every relation maps to zero.
private theorem finiteGrothendieckGroup_relations_le_ker_pidRank :
    modulePropertyK0Relations R (ModuleCat.isFG R) ≤
      (FreeAbelianGroup.lift (finiteGrothendieckGroup_pidRank R)).ker := by
  -- It is enough to check the subgroup generators, which are exactly the short exact sequence
  -- relations defining the Grothendieck group.
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  change
    FreeAbelianGroup.lift (finiteGrothendieckGroup_pidRank R)
      (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  have hrank :
      finiteGrothendieckGroup_pidRank R S.X₂ =
        finiteGrothendieckGroup_pidRank R S.X₁ + finiteGrothendieckGroup_pidRank R S.X₃ :=
    finiteGrothendieckGroup_pidRank_respects_shortExact R S hS
  -- The generator maps to the difference between the two sides of rank additivity.
  rw [hrank]
  abel

/-- The generic-rank functional for Chap10 Example 10 55 3 descends to the canonical
homomorphism `K'_0(R) → ℤ` for a principal ideal domain `R`. -/
def finiteGrothendieckGroup_pidRankMap : finiteGrothendieckGroup.{u, u} R →+ ℤ :=
  ModulePropertyK0.lift R (finiteGrothendieckGroup_pidRank R)
    (finiteGrothendieckGroup_relations_le_ker_pidRank R)

