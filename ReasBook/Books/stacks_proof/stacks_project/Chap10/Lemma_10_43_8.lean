import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open scoped TensorProduct
open Algebra
open Algebra.TensorProduct

universe u v

section

variable {k : Type u} {K : Type v} [Field k] [Field K] [Algebra k K]
variable [Algebra.IsSeparable k K]

/-
Layer note:
- `source-facing`: the existence of a localization presentation for the multiplication map
  `K ⊗[k] K → K`;
- `core/canonical`: separability is owned upstream by `Algebra.FormallyEtale` /
  `Algebra.FormallyUnramified`, organized around the tensor-product multiplication map `lmul'`;
- `bridge/view`: this lemma keeps the Stacks source conclusion that the diagonal map is a
  localization, with the submonoid as derived witness data rather than primitive structure.
-/
/-
Lemma 10.43.8 (Tag 0C2X): for a separable algebraic extension `K / k`, the tensor-product
multiplication map `K ⊗[k] K →ₐ[k] K` is a localization map at some multiplicative subset of
`K ⊗[k] K`.
-/
-- Proof sketch: the owner abstraction is the formally étale / formally unramified structure
-- attached to a separable field extension. In the finite separable case, choose a primitive
-- element, identify `K ⊗[k] K` with `K[X] / (P)` for the minimal polynomial `P`, factor
-- `P = (X - α) Q`, and localize away from the image of `Q`. For a general separable algebraic
-- extension, write `K` as the directed union of its finite separable subextensions and take the
-- union of the corresponding multiplicative subsets.
/-- Helper for Lemma 10.43.8: adjoining finitely many elements of a separable extension still
gives a separable intermediate extension. -/
@[stacks 0C2X]
lemma finite_adjoin_stage_isSeparable (t : Finset K) :
    Algebra.IsSeparable k (IntermediateField.adjoin k (t : Set K)) := by
  -- Every generator in the finite stage is already separable over `k`.
  rw [IntermediateField.isSeparable_adjoin_iff_isSeparable]
  intro x hx
  exact Algebra.IsSeparable.isSeparable k x

/-- Helper for Lemma 10.43.8: a finite adjoin stage is essentially of finite type over the base
field. -/
lemma finite_adjoin_stage_essFiniteType (t : Finset K) :
    Algebra.EssFiniteType k (IntermediateField.adjoin k (t : Set K)) := by
  -- The adjoin stage is generated by the finite set used to define it.
  rw [IntermediateField.essFiniteType_iff]
  exact ⟨t, rfl⟩

/-- Helper for Lemma 10.43.8: multiplication commutes with transporting tensors from an
intermediate field stage into the ambient extension. -/
lemma lmul_comp_adjoin_tensor_map (L : IntermediateField k K) :
    (TensorProduct.lmul' k : K ⊗[k] K →ₐ[k] K).comp
        (Algebra.TensorProduct.map (IsScalarTower.toAlgHom k L K) (IsScalarTower.toAlgHom k L K)) =
      (IsScalarTower.toAlgHom k L K).comp
        (TensorProduct.lmul' k : L ⊗[k] L →ₐ[k] L) := by
  -- Both composites send `x ⊗ y` to the product of the images of `x` and `y`.
  apply AlgHom.ext
  intro z
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · simp
  · intro x y
    simp [TensorProduct.lmul'_apply_tmul]
  · intro x y hx hy
    simp [map_add, AlgHom.comp_apply, hx, hy]

/-- Helper for Lemma 10.43.8: transporting a stage tensor through a larger finite adjoin stage
does not change its image in the ambient tensor product. -/
lemma adjoin_tensor_map_comp_inclusion
    {E F : IntermediateField k K} (hEF : E ≤ F) (z : E ⊗[k] E) :
    Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom k F K)
        (IsScalarTower.toAlgHom k F K)
        (Algebra.TensorProduct.map
          (IntermediateField.inclusion hEF)
          (IntermediateField.inclusion hEF)
          z) =
      Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom k E K)
        (IsScalarTower.toAlgHom k E K)
        z := by
  -- Route correction: prove the transport identity pointwise, so later rewrites are direct.
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · simp
  · intro x y
    simp [IntermediateField.coe_inclusion]
  · intro x y hx hy
    simp [map_add, hx, hy]

/-- Helper for Lemma 10.43.8: every tensor in `K ⊗[k] K` is already defined over a finite adjoin
stage of `K / k`. -/
lemma exists_finite_adjoin_stage_tensor (z : K ⊗[k] K) :
    ∃ t : Finset K,
      ∃ zt :
        IntermediateField.adjoin k (t : Set K) ⊗[k] IntermediateField.adjoin k (t : Set K),
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (t : Set K)) K)
            (IsScalarTower.toAlgHom k (IntermediateField.adjoin k (t : Set K)) K) zt = z := by
  -- Route correction: carry the tensor induction out stage-by-stage, making the additive
  -- transport through the union stage explicit.
  classical
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · let t : Finset K := ∅
    let zt :
        IntermediateField.adjoin k (t : Set K) ⊗[k] IntermediateField.adjoin k (t : Set K) := 0
    refine ⟨t, zt, ?_⟩
    -- The zero tensor is already defined over the empty finite stage.
    simp [t, zt]
  · intro x y
    let t : Finset K := ({x, y} : Finset K)
    let L := IntermediateField.adjoin k (t : Set K)
    have hxt : x ∈ (t : Set K) := by
      simp [t]
    have hyt : y ∈ (t : Set K) := by
      simp [t]
    have hxL : x ∈ L := by
      exact IntermediateField.subset_adjoin k (t : Set K) hxt
    have hyL : y ∈ L := by
      exact IntermediateField.subset_adjoin k (t : Set K) hyt
    let xL : L := ⟨x, hxL⟩
    let yL : L := ⟨y, hyL⟩
    let zt : L ⊗[k] L := xL ⊗ₜ[k] yL
    refine ⟨t, zt, ?_⟩
    -- A pure tensor is defined over the stage generated by its two coordinates.
    simp [t, L, xL, yL, zt]
  · intro x y hx hy
    rcases hx with ⟨tx, ztx, htx⟩
    rcases hy with ⟨ty, zty, hty⟩
    let Lx := IntermediateField.adjoin k (tx : Set K)
    let Ly := IntermediateField.adjoin k (ty : Set K)
    let t : Finset K := tx ∪ ty
    let L := IntermediateField.adjoin k (t : Set K)
    have htx_subset : (tx : Set K) ⊆ (t : Set K) := by
      intro z hz
      simp [t, hz]
    have hty_subset : (ty : Set K) ⊆ (t : Set K) := by
      intro z hz
      simp [t, hz]
    have hLx : Lx ≤ L := by
      rw [IntermediateField.adjoin_le_iff]
      exact fun z hz ↦ IntermediateField.subset_adjoin k (t : Set K) (htx_subset hz)
    have hLy : Ly ≤ L := by
      rw [IntermediateField.adjoin_le_iff]
      exact fun z hz ↦ IntermediateField.subset_adjoin k (t : Set K) (hty_subset hz)
    let ztx' : L ⊗[k] L :=
      Algebra.TensorProduct.map
        (IntermediateField.inclusion hLx)
        (IntermediateField.inclusion hLx)
        ztx
    let zty' : L ⊗[k] L :=
      Algebra.TensorProduct.map
        (IntermediateField.inclusion hLy)
        (IntermediateField.inclusion hLy)
        zty
    refine ⟨t, ztx' + zty', ?_⟩
    -- Transport both finite-stage tensors into the union stage and then rewrite back to the
    -- ambient sum using the pointwise transport lemma.
    calc
      Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k L K)
          (IsScalarTower.toAlgHom k L K)
          (ztx' + zty') =
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k L K)
            (IsScalarTower.toAlgHom k L K)
            ztx' +
          Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k L K)
            (IsScalarTower.toAlgHom k L K)
            zty' := by
          simp [ztx', zty']
      _ =
        Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k Lx K)
            (IsScalarTower.toAlgHom k Lx K)
            ztx +
          Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k Ly K)
            (IsScalarTower.toAlgHom k Ly K)
            zty := by
          rw [adjoin_tensor_map_comp_inclusion (k := k) (K := K) hLx ztx,
            adjoin_tensor_map_comp_inclusion (k := k) (K := K) hLy zty]
      _ = x + y := by
          simpa [Lx, Ly] using congrArg₂ HAdd.hAdd htx hty

/-- Helper for Lemma 10.43.8: ambient multiplication on a transported stage tensor is the image
of the stage multiplication. -/
lemma lmul_adjoin_tensor_map_apply
    (L : IntermediateField k K) (z : L ⊗[k] L) :
    TensorProduct.lmul' k
        (Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k L K)
          (IsScalarTower.toAlgHom k L K)
          z) =
      IsScalarTower.toAlgHom k L K (TensorProduct.lmul' k z) := by
  -- Evaluate the algebra-hom transport identity on the chosen tensor.
  simpa using DFunLike.congr_fun (lmul_comp_adjoin_tensor_map (k := k) (K := K) L) z

/-- Helper for Lemma 10.43.8: for an essentially finite type formally unramified algebra, the
canonical tensor denominator annihilates the kernel of multiplication. -/
lemma tensor_elem_annihilates_of_lmul_eq_zero
    {L : Type*} [Field L] [Algebra k L]
    [Algebra.FormallyUnramified k L] [Algebra.EssFiniteType k L]
    (z : L ⊗[k] L) (hz : TensorProduct.lmul' k z = 0) :
    z * Algebra.FormallyUnramified.elem k L = 0 := by
  -- First rewrite the kernel of `lmul'` as the span of the standard tensor differences.
  have hzspan :
      z ∈ Submodule.span L (Set.range fun s : L => (1 : L) ⊗ₜ[k] s - s ⊗ₜ[k] (1 : L)) := by
    rw [KaehlerDifferential.submodule_span_range_eq_ideal]
    simpa [KaehlerDifferential.ideal, RingHom.mem_ker] using hz
  -- Then use span induction, with the generator case supplied by the canonical denominator API.
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hzspan
  · rintro _ ⟨s, rfl⟩
    exact Algebra.FormallyUnramified.one_tmul_sub_tmul_one_mul_elem (R := k) s
  · simp
  · intro x y hx hy hx' hy'
    simpa [add_mul, hx', hy'] using congrArg₂ HAdd.hAdd hx' hy'
  · intro a x hx hx'
    simpa [smul_eq_mul, mul_assoc, hx'] using congrArg (fun z ↦ a * z) hx'

/-- Helper for Lemma 10.43.8: the transported denominator from a finite adjoin stage maps to `1`
under the ambient multiplication map. -/
lemma finite_adjoin_stage_denominator_maps_to_one (t : Finset K) :
    let L := IntermediateField.adjoin k (t : Set K)
    let _ : Algebra.IsSeparable k L := finite_adjoin_stage_isSeparable (k := k) (K := K) t
    let _ : Algebra.EssFiniteType k L := finite_adjoin_stage_essFiniteType (k := k) (K := K) t
    let _ : Algebra.FormallyUnramified k L := Algebra.FormallyUnramified.of_isSeparable k L
    TensorProduct.lmul' k
      (Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom k L K)
        (IsScalarTower.toAlgHom k L K)
        (Algebra.FormallyUnramified.elem k L)) = 1 := by
  -- Evaluate the multiplication transport on the canonical denominator, then use the finite-stage
  -- formally unramified identity.
  let L := IntermediateField.adjoin k (t : Set K)
  letI : Algebra.IsSeparable k L := finite_adjoin_stage_isSeparable (k := k) (K := K) t
  letI : Algebra.EssFiniteType k L := finite_adjoin_stage_essFiniteType (k := k) (K := K) t
  letI : Algebra.FormallyUnramified k L := Algebra.FormallyUnramified.of_isSeparable k L
  calc
    TensorProduct.lmul' k
        (Algebra.TensorProduct.map
          (IsScalarTower.toAlgHom k L K)
          (IsScalarTower.toAlgHom k L K)
          (Algebra.FormallyUnramified.elem k L)) =
      IsScalarTower.toAlgHom k L K
        (TensorProduct.lmul' k (Algebra.FormallyUnramified.elem k L)) := by
          simpa using
            lmul_adjoin_tensor_map_apply (k := k) (K := K) L
              (Algebra.FormallyUnramified.elem k L)
    _ = 1 := by
          simp [Algebra.FormallyUnramified.lmul_elem]

/-- Lemma 10.43.8 (Tag 0C2X): for a separable algebraic extension `K / k`, the tensor-product
multiplication map `K ⊗[k] K →ₐ[k] K` is a localization map at some multiplicative subset of
`K ⊗[k] K`. -/
@[stacks 0C2X]
theorem exists_submonoid_tensorProduct_self_isLocalization :
    ∃ S : Submonoid (K ⊗[k] K),
      S.IsLocalizationMap (lmul' k) := by
  -- Route correction: use the ambient submonoid of tensors mapping to `1`, and then show that
  -- finite-stage denominators give the cancellation witnesses demanded by localization.
  let carrier : Set (K ⊗[k] K) := { z | TensorProduct.lmul' k z = 1 }
  have h_one : (1 : K ⊗[k] K) ∈ carrier := by
    simp [carrier]
  have h_mul :
      ∀ {a b : K ⊗[k] K}, a ∈ carrier → b ∈ carrier → a * b ∈ carrier := by
    intro a b ha hb
    rw [show a * b ∈ carrier ↔ TensorProduct.lmul' k (a * b) = 1 by rfl]
    rw [map_mul, ha, hb, one_mul]
  let S : Submonoid (K ⊗[k] K) := {
    carrier := carrier
    one_mem' := h_one
    mul_mem' := fun ha hb ↦ h_mul ha hb
  }
  refine ⟨S, ?_⟩
  refine
    { map_units := ?_
      surj := ?_
      exists_of_eq := ?_ }
  · intro s
    -- Membership in `S` says exactly that the image is `1`, hence a unit.
    change IsUnit (TensorProduct.lmul' k (s : K ⊗[k] K))
    rw [s.2]
    exact isUnit_one
  · intro z
    -- Surjectivity is witnessed by the pure tensor `1 ⊗ z` and the unit denominator `1`.
    let s1 : S := ⟨1, h_one⟩
    let x : K ⊗[k] K := 1 ⊗ₜ[k] z
    refine ⟨⟨x, s1⟩, ?_⟩
    simp [x, s1]
  · intro x y hxy
    -- Reduce `x - y` to a finite stage, annihilate it there, and transport the relation back.
    have hsub : TensorProduct.lmul' k (x - y) = 0 := by
      simpa [map_sub, hxy] using sub_self (TensorProduct.lmul' k y)
    obtain ⟨t, zt, hzt⟩ :=
      exists_finite_adjoin_stage_tensor (k := k) (K := K) (x - y)
    let L := IntermediateField.adjoin k (t : Set K)
    have hstage_map :
        IsScalarTower.toAlgHom k L K (TensorProduct.lmul' k zt) = 0 := by
      have hsub_mapped :
          TensorProduct.lmul' k
            (Algebra.TensorProduct.map
              (IsScalarTower.toAlgHom k L K)
              (IsScalarTower.toAlgHom k L K)
              zt) = 0 := by
        rw [hzt]
        exact hsub
      calc
        IsScalarTower.toAlgHom k L K (TensorProduct.lmul' k zt) =
            TensorProduct.lmul' k
              (Algebra.TensorProduct.map
                (IsScalarTower.toAlgHom k L K)
                (IsScalarTower.toAlgHom k L K)
                zt) := by
              symm
              exact lmul_adjoin_tensor_map_apply (k := k) (K := K) L zt
        _ = 0 := by
              exact hsub_mapped
    have hstage_zero : TensorProduct.lmul' k zt = 0 := by
      exact (IsScalarTower.toAlgHom k L K).injective hstage_map
    letI : Algebra.IsSeparable k L := finite_adjoin_stage_isSeparable (k := k) (K := K) t
    letI : Algebra.EssFiniteType k L := finite_adjoin_stage_essFiniteType (k := k) (K := K) t
    letI : Algebra.FormallyUnramified k L := Algebra.FormallyUnramified.of_isSeparable k L
    have hann_stage :
        zt * Algebra.FormallyUnramified.elem k L = 0 := by
      exact tensor_elem_annihilates_of_lmul_eq_zero (k := k) zt hstage_zero
    let c : K ⊗[k] K :=
      Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom k L K)
        (IsScalarTower.toAlgHom k L K)
        (Algebra.FormallyUnramified.elem k L)
    have hc_mem : c ∈ S := by
      change TensorProduct.lmul' k c = 1
      simpa [c, L] using finite_adjoin_stage_denominator_maps_to_one (k := k) (K := K) t
    have hann_ambient : (x - y) * c = 0 := by
      have hmap :=
        congrArg
          (Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k L K)
            (IsScalarTower.toAlgHom k L K))
          hann_stage
      have hmap' : Algebra.TensorProduct.map
            (IsScalarTower.toAlgHom k L K)
            (IsScalarTower.toAlgHom k L K)
            zt * c = 0 := by
        simpa [c, map_mul] using hmap
      rw [← hzt]
      exact hmap'
    have hcancel_right : x * c = y * c := by
      exact sub_eq_zero.mp (by simpa [sub_mul] using hann_ambient)
    have hcancel : (c : K ⊗[k] K) * x = c * y := by
      simpa [mul_comm] using hcancel_right
    let cS : S := ⟨c, hc_mem⟩
    exact ⟨cS, hcancel⟩

end
