import Mathlib
import StacksProject_2024.Chap10.Definition_10_160_5
import StacksProject_2024.Chap10.Lemma_10_96_3
import StacksProject_2024.Chap10.Lemma_10_159_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Ideal IsLocalRing

section

variable (p : ℕ) [Fact p.Prime]
variable (k : Type u) [Field k] [CharP k p]

/- Domain-style sampling:
* primary domain: mixed-characteristic local commutative algebra of Cohen rings and residue
  fields;
* source-facing layer: existence of a Cohen ring whose quotient by `(p)` is identified with `k`;
* sampled owner declarations:
  - `IsCohenRing`,
  - `IsCohenRing.maximalIdeal_eq_span_residueChar`,
  - `IsCohenRing.quotientSpanResidueCharRingEquiv`,
  - `IsLocalRing.ResidueField`;
* owner abstraction: `IsCohenRing Λ` is the canonical owner; the quotient by `(p)` is the
  source-facing bridge, while the maximal-ideal equality and residue-field identification are
  derived from the owner;
* primitive data: a Cohen ring `Λ` together with a quotient-ring equivalence
  `(Λ ⧸ Ideal.span {(p : Λ)}) ≃+* k`;
* derived API: the residue-field equivalence `ResidueField Λ ≃+* k` and the equality
  `maximalIdeal Λ = Ideal.span {(p : Λ)}`.
-/

-- Proof sketch: start from the canonical Cohen ring `ℤ_[p]` for `𝔽_p`, then apply the residue
-- field extension construction from Lemma `10.159.1` to obtain a flat local `ℤ_[p]`-algebra with
-- residue field `k`. Completing that algebra preserves the quotient by powers of `p`, yields a
-- complete Noetherian local ring with maximal ideal generated by `p`, and the one-dimensional
-- regular-local criterion identifies the completion as a discrete valuation ring, hence a Cohen
-- ring. The public conclusion is stated on the quotient `Λ ⧸ (p)`, leaving the maximal-ideal
-- generator equality as derived API from the Cohen-ring owner.

/-- Helper for Chap10 Lemma 10 160 6: the `p`-adic integers form the base Cohen ring with
maximal ideal generated by `p`. -/
lemma padicIntIsCohenRing : IsCohenRing ℤ_[p] := by
  -- The Cohen-ring owner follows from the existing DVR/completeness instances for `ℤ_[p]` and
  -- the standard computation of its maximal ideal.
  exact
    IsCohenRing.of_maximalIdeal_eq_span_natPrime (R := ℤ_[p]) Fact.out
      PadicInt.maximalIdeal_eq_span_p

/-- Helper for Chap10 Lemma 10 160 6: a characteristic-`p` residue field identifies the ideal
generated by `p` with the intrinsic residue-characteristic ideal. -/
lemma spanNatPrime_eq_span_residueChar
    {Λ : Type u} [CommRing Λ] [IsCohenRing Λ] {p : ℕ} [Fact p.Prime]
    [CharP (ResidueField Λ) p] :
    Ideal.span {(p : Λ)} =
      Ideal.span {((ringChar (ResidueField Λ)) : Λ)} := by
  -- Rewrite the source-facing prime `p` to the intrinsic residue characteristic used by the
  -- canonical Cohen-ring quotient equivalence.
  have hp : ringChar (ResidueField Λ) = p := ringChar.eq (ResidueField Λ) p
  rw [hp]

/-- Helper for Chap10 Lemma 10 160 6: if the residue field of a Cohen ring has characteristic
`p`, then the quotient by `(p)` is the residue field. -/
noncomputable def quotientSpanNatPrimeRingEquivResidueField
    {Λ : Type u} [CommRing Λ] [IsCohenRing Λ] {p : ℕ} [Fact p.Prime]
    [CharP (ResidueField Λ) p] :
    (Λ ⧸ Ideal.span {(p : Λ)}) ≃+* ResidueField Λ :=
  (Ideal.quotEquivOfEq (spanNatPrime_eq_span_residueChar (Λ := Λ) (p := p))).trans
    (IsCohenRing.quotientSpanResidueCharRingEquiv (R := Λ))

/-- Helper for Chap10 Lemma 10 160 6: a residue-field equivalence to `k` converts the canonical
Cohen-ring quotient equivalence into the public quotient equivalence by `(p)`. -/
lemma quotientSpanNatPrimeNonemptyOfResidueFieldRingEquiv
    {Λ : Type u} [CommRing Λ] [IsCohenRing Λ]
    (e : ResidueField Λ ≃+* k) :
    Nonempty ((Λ ⧸ Ideal.span {(p : Λ)}) ≃+* k) := by
  -- Pull characteristic `p` back along the residue-field equivalence, so the quotient adapter
  -- may rewrite `(p)` to the intrinsic residue-characteristic generator.
  letI : CharP (ResidueField Λ) p :=
    charP_of_injective_ringHom e.symm.toRingHom.injective p
  -- Compose the canonical quotient-to-residue-field equivalence with the prescribed
  -- residue-field equivalence.
  exact ⟨(quotientSpanNatPrimeRingEquivResidueField (Λ := Λ) (p := p)).trans e⟩

/-- Helper for Chap10 Lemma 10 160 6: the maximal ideal of the flat local algebra is generated
by the image of `p`. -/
lemma baseChange_maximalIdeal_eq_span_natPrime
    (A : Type u) [CommRing A] [IsLocalRing A] [Algebra ℤ_[p] A]
    (hmax : Ideal.map (algebraMap ℤ_[p] A) (maximalIdeal ℤ_[p]) = maximalIdeal A) :
    maximalIdeal A = Ideal.span {(p : A)} := by
  -- Pull the known generator of the base maximal ideal across the local algebra map.
  calc
    maximalIdeal A = Ideal.map (algebraMap ℤ_[p] A) (maximalIdeal ℤ_[p]) := hmax.symm
    _ = Ideal.map (algebraMap ℤ_[p] A) (Ideal.span {(p : ℤ_[p])}) := by
      rw [PadicInt.maximalIdeal_eq_span_p]
    _ = Ideal.span {(p : A)} := by
      simp [Ideal.map_span]

/-- Helper for Chap10 Lemma 10 160 6: the maximal ideal of the flat local algebra is finitely
generated. -/
lemma baseChange_maximalIdeal_fg
    (A : Type u) [CommRing A] [IsLocalRing A] [Algebra ℤ_[p] A]
    (hmax : Ideal.map (algebraMap ℤ_[p] A) (maximalIdeal ℤ_[p]) = maximalIdeal A) :
    (maximalIdeal A).FG := by
  -- Use the principal generator transported from `ℤ_[p]` to close finite generation.
  rw [baseChange_maximalIdeal_eq_span_natPrime (p := p) (A := A) hmax]
  exact Submodule.fg_span (Set.finite_singleton (p : A))

/-- Helper for Chap10 Lemma 10 160 6: in a flat local `ℤ_[p]`-algebra whose maximal ideal is
the base-change of `(p)`, consecutive principal powers of `p` are strictly decreasing. -/
lemma baseChange_natPrime_pow_not_mem_span_succ
    (A : Type u) [CommRing A] [IsLocalRing A] [Algebra ℤ_[p] A]
    (hFlat : (algebraMap ℤ_[p] A).Flat)
    (hmax : Ideal.map (algebraMap ℤ_[p] A) (maximalIdeal ℤ_[p]) = maximalIdeal A) :
    ∀ n : ℕ, ((p : A) ^ n) ∉ Ideal.span {((p : A) ^ (n + 1))} := by
  intro n hmem
  rw [Ideal.mem_span_singleton] at hmem
  rcases hmem with ⟨a, ha⟩
  -- Flatness over the domain `ℤ_[p]` makes multiplication by `p ^ n` injective on `A`.
  let f : ℤ_[p] →+* A := algebraMap ℤ_[p] A
  letI : Algebra ℤ_[p] A := f.toAlgebra
  letI : Module.Flat ℤ_[p] A := by
    simpa [f, RingHom.Flat] using hFlat
  have hp_nzd : (p : ℤ_[p]) ∈ nonZeroDivisors ℤ_[p] := by
    exact mem_nonZeroDivisors_iff_ne_zero.mpr (by
      change (p : ℤ_[p]) ≠ 0
      exact_mod_cast (Fact.out : Nat.Prime p).ne_zero)
  have hpreg : IsSMulRegular A (p : ℤ_[p]) := by
    exact Module.Flat.isSMulRegular_of_nonZeroDivisors (M := A) hp_nzd
  have hpowreg : IsSMulRegular A ((p : ℤ_[p]) ^ n) := IsSMulRegular.pow n hpreg
  -- The assumed divisibility says `p ^ n * (1 - p * a) = 0`, so regularity gives a unit
  -- inverse for `p`.
  have hzero : ((p : ℤ_[p]) ^ n) • (1 - (p : A) * a) = 0 := by
    rw [Algebra.smul_def]
    calc
      algebraMap ℤ_[p] A ((p : ℤ_[p]) ^ n) * (1 - (p : A) * a)
          = (p : A) ^ n * (1 - (p : A) * a) := by simp
      _ = (p : A) ^ n - (p : A) ^ (n + 1) * a := by ring
      _ = 0 := by
        rw [ha]
        ring
  have hone : (1 - (p : A) * a : A) = 0 := hpowreg.right_eq_zero_of_smul hzero
  have hpa : (p : A) * a = 1 := (sub_eq_zero.mp hone).symm
  have hunit : IsUnit (p : A) := IsUnit.of_mul_eq_one a hpa
  -- But `p` lies in the maximal ideal by the base-change hypothesis, hence cannot be a unit.
  have hp_mem : (p : A) ∈ maximalIdeal A := by
    rw [← hmax]
    have hp_base : (p : ℤ_[p]) ∈ maximalIdeal ℤ_[p] := by
      rw [PadicInt.maximalIdeal_eq_span_p]
      exact Ideal.subset_span (by simp)
    simpa [f] using Ideal.mem_map_of_mem f hp_base
  exact (IsLocalRing.mem_maximalIdeal (p : A)).mp hp_mem hunit

/-- Helper for Chap10 Lemma 10 160 6: the extended maximal ideal in the completion is generated
by `p`. -/
lemma maximalIdealCompletion_map_maximalIdeal_eq_span_natPrime
    (A : Type u) [CommRing A] [IsLocalRing A] [Algebra ℤ_[p] A]
    (hmax : Ideal.map (algebraMap ℤ_[p] A) (maximalIdeal ℤ_[p]) = maximalIdeal A) :
    Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A)) (maximalIdeal A) =
      Ideal.span {(p : AdicCompletion (maximalIdeal A) A)} := by
  -- Transport the base maximal-ideal generator through `A` and then through the completion map.
  calc
    Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A)) (maximalIdeal A)
        = Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A))
            (Ideal.map (algebraMap ℤ_[p] A) (maximalIdeal ℤ_[p])) := by
      rw [hmax]
    _ = Ideal.map ((algebraMap A (AdicCompletion (maximalIdeal A) A)).comp
            (algebraMap ℤ_[p] A)) (maximalIdeal ℤ_[p]) := by
      rw [Ideal.map_map]
    _ = Ideal.map ((algebraMap A (AdicCompletion (maximalIdeal A) A)).comp
            (algebraMap ℤ_[p] A)) (Ideal.span {(p : ℤ_[p])}) := by
      rw [PadicInt.maximalIdeal_eq_span_p]
    _ = Ideal.span {((algebraMap A (AdicCompletion (maximalIdeal A) A)).comp
            (algebraMap ℤ_[p] A)) (p : ℤ_[p])} := by
      simp [Ideal.map_span]
    _ = Ideal.span {(p : AdicCompletion (maximalIdeal A) A)} := by
      congr
      simp

/-- Helper for Chap10 Lemma 10 160 6: the first completion evaluation has the extended maximal
ideal as kernel. -/
lemma maximalIdealCompletion_map_maximalIdeal_eq_ker_eval
    (A : Type u) [CommRing A] [IsLocalRing A] (hfg : (maximalIdeal A).FG) :
    Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A)) (maximalIdeal A) =
      RingHom.ker (AdicCompletion.evalₐ (maximalIdeal A) 1).toRingHom := by
  -- This is the `n = 1` case of the kernel theorem for completion evaluations.
  simpa [pow_one] using
    (completionIdeal_pow_eq_ker_evalₐ (I := maximalIdeal A) hfg 1)

/-- Helper for Chap10 Lemma 10 160 6: the first evaluation target is a field. -/
lemma maximalIdeal_pow_one_quotient_isField
    (A : Type u) [CommRing A] [IsLocalRing A] :
    IsField (A ⧸ (maximalIdeal A) ^ 1) := by
  -- The first power of the maximal ideal is the maximal ideal itself.
  letI : ((maximalIdeal A) ^ 1).IsMaximal := by
    simpa [pow_one] using (maximalIdeal.isMaximal A)
  exact (Ideal.Quotient.maximal_ideal_iff_isField_quotient ((maximalIdeal A) ^ 1)).mp
    inferInstance

/-- Helper for Chap10 Lemma 10 160 6: the extended maximal ideal in the completion is maximal. -/
lemma maximalIdealCompletion_mappedIdeal_isMaximal
    (A : Type u) [CommRing A] [IsLocalRing A] (hfg : (maximalIdeal A).FG) :
    (Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A)) (maximalIdeal A)).IsMaximal := by
  -- Identify the ideal with the kernel of a surjection to the first residue quotient of `A`.
  rw [maximalIdealCompletion_map_maximalIdeal_eq_ker_eval (A := A) hfg]
  let C := AdicCompletion (maximalIdeal A) A
  let f : C →+* A ⧸ (maximalIdeal A) ^ 1 :=
    (AdicCompletion.evalₐ (maximalIdeal A) 1).toRingHom
  have hsurj : Function.Surjective f := by
    exact AdicCompletion.surjective_evalₐ (maximalIdeal A) 1
  let e : C ⧸ RingHom.ker f ≃+* A ⧸ (maximalIdeal A) ^ 1 :=
    RingHom.quotientKerEquivOfSurjective hsurj
  have htarget : IsField (A ⧸ (maximalIdeal A) ^ 1) :=
    maximalIdeal_pow_one_quotient_isField (A := A)
  have hsource : IsField (C ⧸ RingHom.ker f) :=
    e.toMulEquiv.isField htarget
  exact Ideal.Quotient.maximal_of_isField (RingHom.ker f) hsource

/-- Helper for Chap10 Lemma 10 160 6: the completion is complete for the extended maximal
ideal. -/
lemma maximalIdealCompletion_mappedIdeal_isAdicComplete
    (A : Type u) [CommRing A] [IsLocalRing A] (hfg : (maximalIdeal A).FG) :
    IsAdicComplete
      (Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A)) (maximalIdeal A))
      (AdicCompletion (maximalIdeal A) A) := by
  -- Transport the built-in completion completeness from the source ideal to its image.
  exact
    (IsAdicComplete.map_algebraMap_iff
      (R := A) (S := AdicCompletion (maximalIdeal A) A) (I := maximalIdeal A)
      (M := AdicCompletion (maximalIdeal A) A)).2
      (AdicCompletion.isAdicComplete (M := A) hfg)

/-- Helper for Chap10 Lemma 10 160 6: the maximal-ideal completion of a local ring is local. -/
lemma maximalIdealCompletion_isLocalRing
    (A : Type u) [CommRing A] [IsLocalRing A] (hfg : (maximalIdeal A).FG) :
    IsLocalRing (AdicCompletion (maximalIdeal A) A) := by
  let K : Ideal (AdicCompletion (maximalIdeal A) A) :=
    Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A)) (maximalIdeal A)
  have hKmax : K.IsMaximal := by
    -- The image ideal is maximal by the first-isomorphism comparison with the residue quotient.
    dsimp [K]
    exact maximalIdealCompletion_mappedIdeal_isMaximal (A := A) hfg
  have hKcomplete : IsAdicComplete K (AdicCompletion (maximalIdeal A) A) := by
    -- The completion is adically complete for this same image ideal.
    dsimp [K]
    exact maximalIdealCompletion_mappedIdeal_isAdicComplete (A := A) hfg
  -- A ring complete for a maximal ideal is local.
  exact @isLocalRing_of_isAdicComplete_maximal
    (AdicCompletion (maximalIdeal A) A) _ K hKmax hKcomplete

/-- Helper for Chap10 Lemma 10 160 6: in the local maximal-ideal completion, the extended
maximal ideal is the actual maximal ideal. -/
lemma maximalIdealCompletion_mappedIdeal_eq_maximalIdeal
    (A : Type u) [CommRing A] [IsLocalRing A]
    [IsLocalRing (AdicCompletion (maximalIdeal A) A)] (hfg : (maximalIdeal A).FG) :
    Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A)) (maximalIdeal A) =
      maximalIdeal (AdicCompletion (maximalIdeal A) A) := by
  -- The image ideal is maximal, so uniqueness of the maximal ideal in a local ring identifies it.
  exact IsLocalRing.eq_maximalIdeal
    (maximalIdealCompletion_mappedIdeal_isMaximal (A := A) hfg)

/-- Helper for Chap10 Lemma 10 160 6: the maximal-ideal completion is a complete local ring. -/
lemma maximalIdealCompletion_isCompleteLocalRing
    (A : Type u) [CommRing A] [IsLocalRing A] (hfg : (maximalIdeal A).FG) :
    IsCompleteLocalRing (AdicCompletion (maximalIdeal A) A) := by
  -- First install locality, then rewrite the already-proved adic completeness from the extended
  -- ideal to the intrinsic maximal ideal of the completion.
  letI : IsLocalRing (AdicCompletion (maximalIdeal A) A) :=
    maximalIdealCompletion_isLocalRing (A := A) hfg
  have hcomplete :
      IsAdicComplete (maximalIdeal (AdicCompletion (maximalIdeal A) A))
        (AdicCompletion (maximalIdeal A) A) := by
    rw [← maximalIdealCompletion_mappedIdeal_eq_maximalIdeal (A := A) hfg]
    exact maximalIdealCompletion_mappedIdeal_isAdicComplete (A := A) hfg
  -- Package the two pieces directly, avoiding another typeclass search for the completeness fact.
  exact { toIsAdicComplete := hcomplete }

/-- Helper for Chap10 Lemma 10 160 6: the first completion quotient identifies the residue field
of the completion with the original residue field. -/
noncomputable def maximalIdealCompletion_residueFieldRingEquiv
    (A : Type u) [CommRing A] [IsLocalRing A]
    [IsLocalRing (AdicCompletion (maximalIdeal A) A)] (hfg : (maximalIdeal A).FG) :
    ResidueField (AdicCompletion (maximalIdeal A) A) ≃+* ResidueField A :=
  let C := AdicCompletion (maximalIdeal A) A
  let f : C →+* A ⧸ (maximalIdeal A) ^ 1 :=
    (AdicCompletion.evalₐ (maximalIdeal A) 1).toRingHom
  let hmax_eq_ker : maximalIdeal C = RingHom.ker f := by
    -- Move the first-evaluation kernel through the named extended-ideal/maximal-ideal bridge.
    calc
      maximalIdeal C =
          Ideal.map (algebraMap A C) (maximalIdeal A) := by
        exact (maximalIdealCompletion_mappedIdeal_eq_maximalIdeal (A := A) hfg).symm
      _ = RingHom.ker f := by
        exact maximalIdealCompletion_map_maximalIdeal_eq_ker_eval (A := A) hfg
  let hsurj : Function.Surjective f :=
    AdicCompletion.surjective_evalₐ (maximalIdeal A) 1
  -- Quotient by the kernel of the first evaluation and then remove the harmless first power.
  ((Ideal.quotEquivOfEq hmax_eq_ker).trans
    (RingHom.quotientKerEquivOfSurjective hsurj)).trans
    (Ideal.quotEquivOfEq (by simp [pow_one]))

/-- Helper for Chap10 Lemma 10 160 6: strict consecutive `p`-powers remain strict after
maximal-ideal adic completion. -/
lemma maximalIdealCompletion_natPrime_pow_not_mem_span_succ
    (A : Type u) [CommRing A] [IsLocalRing A] [Algebra ℤ_[p] A]
    (hFlat : (algebraMap ℤ_[p] A).Flat)
    (hmax : Ideal.map (algebraMap ℤ_[p] A) (maximalIdeal ℤ_[p]) = maximalIdeal A) :
    ∀ n : ℕ,
      ((p : AdicCompletion (maximalIdeal A) A) ^ n) ∉
        Ideal.span {((p : AdicCompletion (maximalIdeal A) A) ^ (n + 1))} := by
  intro n hmem
  let C := AdicCompletion (maximalIdeal A) A
  have hmaxA : maximalIdeal A = Ideal.span {(p : A)} :=
    baseChange_maximalIdeal_eq_span_natPrime (p := p) (A := A) hmax
  have hstrictA : ∀ n : ℕ, ((p : A) ^ n) ∉ Ideal.span {((p : A) ^ (n + 1))} :=
    baseChange_natPrime_pow_not_mem_span_succ (p := p) (A := A) hFlat hmax
  have hp_mem : (p : A) ∈ maximalIdeal A := by
    rw [hmaxA]
    exact Ideal.subset_span (by simp)
  -- The generator `p ^ (n + 1)` vanishes under evaluation modulo `maximalIdeal A ^ (n + 1)`.
  have hgen_ker : ((p : C) ^ (n + 1)) ∈
      RingHom.ker (AdicCompletion.evalₐ (maximalIdeal A) (n + 1)).toRingHom := by
    rw [RingHom.mem_ker]
    have heval :
        (AdicCompletion.evalₐ (maximalIdeal A) (n + 1)).toRingHom ((p : C) ^ (n + 1)) =
          (Ideal.Quotient.mk ((maximalIdeal A) ^ (n + 1))) ((p : A) ^ (n + 1)) := by
      simp [C, map_pow]
    rw [heval]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_mem_pow hp_mem (n + 1))
  have hspan_le : Ideal.span {((p : C) ^ (n + 1))} ≤
      RingHom.ker (AdicCompletion.evalₐ (maximalIdeal A) (n + 1)).toRingHom := by
    rw [Ideal.span_le]
    intro x hx
    simpa using hx ▸ hgen_ker
  have hker : ((p : C) ^ n) ∈
      RingHom.ker (AdicCompletion.evalₐ (maximalIdeal A) (n + 1)).toRingHom := hspan_le hmem
  -- Evaluating the hypothetical membership detects that `p ^ n` already lies in
  -- `maximalIdeal A ^ (n + 1)`, contradicting strictness in `A`.
  have hquot : (Ideal.Quotient.mk ((maximalIdeal A) ^ (n + 1))) ((p : A) ^ n) = 0 := by
    rw [RingHom.mem_ker] at hker
    have heval :
        (AdicCompletion.evalₐ (maximalIdeal A) (n + 1)).toRingHom ((p : C) ^ n) =
          (Ideal.Quotient.mk ((maximalIdeal A) ^ (n + 1))) ((p : A) ^ n) := by
      simp [C, map_pow]
    rwa [heval] at hker
  have hA_power : ((p : A) ^ n) ∈ (maximalIdeal A) ^ (n + 1) :=
    Ideal.Quotient.eq_zero_iff_mem.mp hquot
  have hA_span : ((p : A) ^ n) ∈ Ideal.span {((p : A) ^ (n + 1))} := by
    rwa [hmaxA, Ideal.span_singleton_pow] at hA_power
  exact hstrictA n hA_span

/-- Helper for Chap10 Lemma 10 160 6: in a Hausdorff local ring whose maximal ideal is
generated by `π`, every nonzero element has a first principal-power stratum. -/
lemma localPrincipal_exists_pow_stratum
    {R : Type u} [CommRing R] [IsLocalRing R] [IsHausdorff (maximalIdeal R) R]
    {π x : R} (hmax : maximalIdeal R = Ideal.span {π}) (hx : x ≠ 0) :
    ∃ n : ℕ, x ∈ Ideal.span {(π ^ n)} ∧ x ∉ Ideal.span {(π ^ (n + 1))} := by
  classical
  -- Hausdorffness rules out membership in all positive powers, so some next layer misses `x`.
  have hexists : ∃ n : ℕ, x ∉ Ideal.span {(π ^ (n + 1))} := by
    by_contra hnone
    push Not at hnone
    have hxzero : x = 0 := by
      apply IsHausdorff.haus (I := maximalIdeal R) (M := R) inferInstance x
      intro n
      rw [SModEq.zero]
      cases n with
      | zero =>
          simp
      | succ m =>
          have hmem : x ∈ Ideal.span {(π ^ (m + 1))} := hnone m
          have hmem' : x ∈ (maximalIdeal R) ^ (m + 1) := by
            rwa [hmax, Ideal.span_singleton_pow]
          simpa using hmem'
    exact hx hxzero
  refine ⟨Nat.find hexists, ?_, Nat.find_spec hexists⟩
  -- Minimality of the first failed next layer puts `x` in the preceding layer.
  cases hfind : Nat.find hexists with
  | zero =>
      simp
  | succ m =>
      have hmin : ¬ x ∉ Ideal.span {(π ^ (m + 1))} :=
        Nat.find_min hexists (by
          rw [hfind]
          exact Nat.lt_succ_self m)
      exact not_not.mp hmin

/-- Helper for Chap10 Lemma 10 160 6: a nonzero element in a Hausdorff local ring with principal
maximal ideal is a unit times a power of the generator. -/
lemma localPrincipal_unit_mul_pow_of_ne_zero
    {R : Type u} [CommRing R] [IsLocalRing R] [IsHausdorff (maximalIdeal R) R]
    {π x : R} (hmax : maximalIdeal R = Ideal.span {π}) (hx : x ≠ 0) :
    ∃ n : ℕ, ∃ u : Rˣ, x = u * π ^ n := by
  rcases localPrincipal_exists_pow_stratum (R := R) hmax hx with ⟨n, hmem, hnot⟩
  rw [Ideal.mem_span_singleton] at hmem
  rcases hmem with ⟨a, ha⟩
  -- If the coefficient were still in the maximal ideal, `x` would lie one layer deeper.
  have ha_not_max : a ∉ maximalIdeal R := by
    intro ha_max
    have ha_span : a ∈ Ideal.span {π} := by
      rwa [← hmax]
    rw [Ideal.mem_span_singleton] at ha_span
    rcases ha_span with ⟨b, hb⟩
    apply hnot
    rw [Ideal.mem_span_singleton]
    refine ⟨b, ?_⟩
    calc
      x = π ^ n * a := ha
      _ = π ^ n * (π * b) := by rw [hb]
      _ = π ^ (n + 1) * b := by
        rw [pow_succ]
        ring
  -- Locality turns a coefficient outside the maximal ideal into a unit.
  have ha_unit : IsUnit a := (IsLocalRing.notMem_maximalIdeal).mp ha_not_max
  rcases ha_unit with ⟨u, rfl⟩
  exact ⟨n, u, by simpa [mul_comm] using ha⟩

/-- Helper for Chap10 Lemma 10 160 6: strict consecutive powers make the principal
maximal-ideal generator irreducible. -/
lemma localPrincipal_irreducible_of_strictPowers
    {R : Type u} [CommRing R] [IsLocalRing R] {π : R}
    (hmax : maximalIdeal R = Ideal.span {π})
    (hstrict : ∀ n : ℕ, π ^ n ∉ Ideal.span {(π ^ (n + 1))}) :
    Irreducible π := by
  refine ⟨?_, ?_⟩
  · -- A unit generator would put `1 = π^0` in the first positive power.
    intro hunit
    have hone_mem : (1 : R) ∈ Ideal.span {π} := by
      rw [Ideal.mem_span_singleton]
      rcases hunit.exists_right_inv with ⟨b, hb⟩
      exact ⟨b, hb.symm⟩
    simpa using hstrict 0 (by simpa using hone_mem)
  · intro a b hab
    by_cases ha : IsUnit a
    · exact Or.inl ha
    · right
      by_contra hb
      -- Two nonunit factors of `π` both lie in the maximal ideal, forcing `π ∈ (π^2)`.
      have ha_mem : a ∈ maximalIdeal R := (IsLocalRing.mem_maximalIdeal a).mpr ha
      have hb_mem : b ∈ maximalIdeal R := (IsLocalRing.mem_maximalIdeal b).mpr hb
      have ha_span : a ∈ Ideal.span {π} := by rwa [← hmax]
      have hb_span : b ∈ Ideal.span {π} := by rwa [← hmax]
      rw [Ideal.mem_span_singleton] at ha_span hb_span
      rcases ha_span with ⟨c, hc⟩
      rcases hb_span with ⟨d, hd⟩
      have hmem : π ^ 1 ∈ Ideal.span {(π ^ (1 + 1))} := by
        rw [Ideal.mem_span_singleton]
        refine ⟨c * d, ?_⟩
        calc
          π ^ 1 = π := by ring
          _ = a * b := hab
          _ = (π * c) * (π * d) := by rw [hc, hd]
          _ = π ^ (1 + 1) * (c * d) := by ring
      exact hstrict 1 hmem

/-- Helper for Chap10 Lemma 10 160 6: strict principal powers in a Hausdorff local ring force
the ring to be a domain. -/
lemma localPrincipal_isDomain_of_strictPowers
    {R : Type u} [CommRing R] [IsLocalRing R] [IsHausdorff (maximalIdeal R) R] {π : R}
    (hmax : maximalIdeal R = Ideal.span {π})
    (hstrict : ∀ n : ℕ, π ^ n ∉ Ideal.span {(π ^ (n + 1))}) :
    IsDomain R := by
  -- The zeroth strictness condition excludes the zero ring.
  have hnontrivial : Nontrivial R := by
    refine ⟨⟨0, 1, ?_⟩⟩
    intro hzero_one
    have hone_mem : (1 : R) ∈ Ideal.span {π} := by
      rw [← hzero_one]
      exact zero_mem _
    simpa using hstrict 0 (by simpa using hone_mem)
  have hno : NoZeroDivisors R := by
    rw [noZeroDivisors_iff_right_eq_zero_of_mul]
    intro a ha b hab
    by_contra hb
    rcases localPrincipal_unit_mul_pow_of_ne_zero (R := R) hmax ha with ⟨m, u, haeq⟩
    rcases localPrincipal_unit_mul_pow_of_ne_zero (R := R) hmax hb with ⟨n, v, hbeq⟩
    -- A zero product of two unit-power normal forms would make a strict power vanish.
    have hpow_zero : π ^ (m + n) = 0 := by
      have hprod : (u * v : Rˣ) * π ^ (m + n) = 0 := by
        calc
          (u * v : Rˣ) * π ^ (m + n) = (u * π ^ m) * (v * π ^ n) := by
            rw [Units.val_mul, pow_add]
            ring
          _ = a * b := by rw [← haeq, ← hbeq]
          _ = 0 := hab
      exact
        (IsUnit.mul_right_eq_zero
          (show IsUnit ((u * v : Rˣ) : R) from (u * v).isUnit)).mp hprod
    have hmem : π ^ (m + n) ∈ Ideal.span {(π ^ (m + n + 1))} := by
      rw [hpow_zero]
      exact zero_mem _
    exact hstrict (m + n) hmem
  exact @NoZeroDivisors.to_isDomain R _ hnontrivial hno

/-- Helper for Chap10 Lemma 10 160 6: a complete local ring whose maximal ideal is generated by
`p` and whose consecutive `p`-powers are strict is a Cohen ring. -/
lemma isCohenRing_of_completeLocal_principal_strictPowers
    {R : Type u} [CommRing R] [IsLocalRing R] [IsCompleteLocalRing R]
    {p : ℕ} [Fact p.Prime]
    (hmax : maximalIdeal R = Ideal.span {(p : R)})
    (hstrict : ∀ n : ℕ, ((p : R) ^ n) ∉ Ideal.span {((p : R) ^ (n + 1))}) :
    IsCohenRing R := by
  -- The strict-power normal form gives the domain and unit-times-power factorization needed by
  -- mathlib's DVR constructor.
  letI : IsDomain R := localPrincipal_isDomain_of_strictPowers (R := R) hmax hstrict
  have hirr : Irreducible (p : R) :=
    localPrincipal_irreducible_of_strictPowers (R := R) hmax hstrict
  have hfactor : IsDiscreteValuationRing.HasUnitMulPowIrreducibleFactorization R := by
    refine ⟨(p : R), hirr, ?_⟩
    intro x hx
    rcases localPrincipal_unit_mul_pow_of_ne_zero (R := R) hmax hx with ⟨n, u, hx_eq⟩
    refine ⟨n, ?_⟩
    rw [hx_eq]
    exact associated_unit_mul_right ((p : R) ^ n) u u.isUnit
  letI : IsDiscreteValuationRing R :=
    IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization hfactor
  -- Finally package the DVR, completeness, and prescribed principal maximal ideal.
  exact IsCohenRing.of_maximalIdeal_eq_span_natPrime Fact.out hmax

omit [CharP k p] in
/-- Chap10 Lemma 10 160 6: completing a flat local `ℤ_[p]`-algebra whose residue field is `k`
produces a Cohen ring with residue field `k`. -/
lemma flatPadicLocalAlgebraCompletionCohenData
    [Algebra (ResidueField ℤ_[p]) k]
    (A : Type u) [CommRing A] [IsLocalRing A] [Algebra ℤ_[p] A]
    [IsLocalHom (algebraMap ℤ_[p] A)] (hFlat : (algebraMap ℤ_[p] A).Flat)
    (e : ResidueField A ≃ₐ[ResidueField ℤ_[p]] k)
    (hmax : Ideal.map (algebraMap ℤ_[p] A) (maximalIdeal ℤ_[p]) = maximalIdeal A) :
    ∃ (Λ : Type u) (_ : CommRing Λ) (_ : IsCohenRing Λ),
      Nonempty (ResidueField Λ ≃+* k) := by
  -- The planned construction is the maximal-ideal completion of `A`; the flatness and
  -- maximal-ideal compatibility should transport `PadicInt.maximalIdeal_eq_span_p` to prove that
  -- this completion is a DVR. The proved prefix below now supplies finite generation, principal
  -- image of the maximal ideal, and locality of the completion; the remaining blocker is the
  -- regular-generator/DVR upgrade plus the residue-field comparison.
  have hfg : (maximalIdeal A).FG := baseChange_maximalIdeal_fg (p := p) (A := A) hmax
  have hprincipalCompletion :
      Ideal.map (algebraMap A (AdicCompletion (maximalIdeal A) A)) (maximalIdeal A) =
        Ideal.span {(p : AdicCompletion (maximalIdeal A) A)} :=
    maximalIdealCompletion_map_maximalIdeal_eq_span_natPrime (p := p) (A := A) hmax
  have hlocalCompletion : IsLocalRing (AdicCompletion (maximalIdeal A) A) :=
    maximalIdealCompletion_isLocalRing (A := A) hfg
  letI : IsLocalRing (AdicCompletion (maximalIdeal A) A) := hlocalCompletion
  have hmaxCompletion :
      maximalIdeal (AdicCompletion (maximalIdeal A) A) =
        Ideal.span {(p : AdicCompletion (maximalIdeal A) A)} := by
    rw [← maximalIdealCompletion_mappedIdeal_eq_maximalIdeal (A := A) hfg]
    exact hprincipalCompletion
  have hcompleteCompletion :
      IsCompleteLocalRing (AdicCompletion (maximalIdeal A) A) :=
    maximalIdealCompletion_isCompleteLocalRing (A := A) hfg
  have hresidueCompletion :
      ResidueField (AdicCompletion (maximalIdeal A) A) ≃+* k :=
    (maximalIdealCompletion_residueFieldRingEquiv (A := A) hfg).trans e.toRingEquiv
  have hstrictCompletion :
      ∀ n : ℕ,
        ((p : AdicCompletion (maximalIdeal A) A) ^ n) ∉
          Ideal.span {((p : AdicCompletion (maximalIdeal A) A) ^ (n + 1))} :=
    maximalIdealCompletion_natPrime_pow_not_mem_span_succ (p := p) (A := A) hFlat hmax
  -- The strict principal-power criterion upgrades the completion to a Cohen ring; the residue
  -- comparison already identifies its residue field with `k`.
  let C := AdicCompletion (maximalIdeal A) A
  letI : IsCompleteLocalRing C := hcompleteCompletion
  have hCohen : IsCohenRing C :=
    isCohenRing_of_completeLocal_principal_strictPowers (R := C) hmaxCompletion hstrictCompletion
  exact ⟨C, inferInstance, hCohen, ⟨hresidueCompletion⟩⟩

/-- Helper for Chap10 Lemma 10 160 6: source-facing existence of a Cohen ring with prescribed
residue field of characteristic `p`. -/
lemma existsCohenRingWithResidueFieldRingEquiv
    (p : ℕ) [Fact p.Prime] (k : Type u) [Field k] [CharP k p] :
    ∃ (Λ : Type u) (_ : CommRing Λ) (_ : IsCohenRing Λ),
      Nonempty (ResidueField Λ ≃+* k) := by
  -- Route correction: the helper must explicitly keep the characteristic-`p` hypothesis; without
  -- it, Lean generalizes a false statement claiming Cohen rings exist for all residue fields.
  -- First realize `k` as a residue-field extension of the base Cohen ring `ℤ_[p]`.
  letI : Algebra (ZMod p) k := ZMod.algebra k p
  letI : Algebra (ResidueField ℤ_[p]) k :=
    ((algebraMap (ZMod p) k).comp PadicInt.residueField.toRingHom).toAlgebra
  -- Lemma 10.159.1 supplies the flat local `ℤ_[p]`-algebra with residue field `k`; the remaining
  -- bridge is the completion-to-Cohen-ring upgrade isolated in
  -- `flatPadicLocalAlgebraCompletionCohenData`.
  rcases exists_flat_localAlgebra_with_residueField_equiv (R := ℤ_[p]) k with
    ⟨A, hComm, hLocal, hAlg, hLocalHom, hFlat, e, hmax⟩
  letI : CommRing A := hComm
  letI : IsLocalRing A := hLocal
  letI : Algebra ℤ_[p] A := hAlg
  letI : IsLocalHom (algebraMap ℤ_[p] A) := hLocalHom
  exact flatPadicLocalAlgebraCompletionCohenData p k A hFlat e hmax

/-- Helper for Chap10 Lemma 10 160 6: for a prime number `p` and a field `k` of characteristic
`p`, there exists a Cohen ring `Λ` such that `Λ ⧸ Ideal.span {(p : Λ)}` is isomorphic to `k`. -/
@[stacks 0328]
theorem exists_cohenRing_with_quotient_by_prime_ringEquiv :
    ∃ (Λ : Type u) (_ : CommRing Λ) (_ : IsCohenRing Λ),
      Nonempty ((Λ ⧸ Ideal.span {(p : Λ)}) ≃+* k) := by
  -- Reduce the public quotient formulation to the residue-field formulation, then compose the
  -- quotient/residue-field adapter with the chosen residue-field equivalence.
  rcases existsCohenRingWithResidueFieldRingEquiv p k with
    ⟨Λ, hΛ, hCohen, ⟨e⟩⟩
  letI : CommRing Λ := hΛ
  letI : IsCohenRing Λ := hCohen
  exact ⟨Λ, hΛ, hCohen, quotientSpanNatPrimeNonemptyOfResidueFieldRingEquiv p k e⟩

