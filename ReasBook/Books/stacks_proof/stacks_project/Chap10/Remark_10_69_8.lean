/-- Helper for Chap10 Remark 10 69 8: finite truncation cancellation by `x`. -/
theorem quasiRegularCounterexampleFiniteRelationIdeal_cancel_x
    (N : ℕ) (p : quasiRegularCounterexamplePolynomialRing k)
    (hp : p * quasiRegularCounterexamplePolynomialX k ∈
      quasiRegularCounterexampleFiniteRelationIdeal k N) :
    p ∈ quasiRegularCounterexampleFiniteRelationIdeal k N := by
  -- Route correction: avoid the earlier oversized normal-form equivalence; it is enough to
  -- normalize modulo the finite ideal, cancel in the hypersurface, and include back.
  -- Normalize the annihilation relation into the hypersurface quotient, cancel `x` there, and
  -- transport the normalized representative back to the finite presentation.
  have hnorm_mul :
      quasiRegularCounterexampleTruncationNormalize k N p *
          quasiRegularCounterexamplePolynomialX k ∈
        quasiRegularCounterexampleTruncatedHypersurfaceIdeal k N := by
    have hmap :=
      quasiRegularCounterexample_normalize_mem_hypersurface_of_mem_finiteRelationIdeal
        (k := k) (N := N) (p := p * quasiRegularCounterexamplePolynomialX k) hp
    simpa [quasiRegularCounterexamplePolynomialX, map_mul] using hmap
  have hnorm_hyp :
      quasiRegularCounterexampleTruncationNormalize k N p ∈
        quasiRegularCounterexampleTruncatedHypersurfaceIdeal k N :=
    quasiRegularCounterexampleTruncatedHypersurfaceIdeal_cancel_x k N
      (quasiRegularCounterexampleTruncationNormalize k N p) hnorm_mul
  have hnorm_finite :
      quasiRegularCounterexampleTruncationNormalize k N p ∈
        quasiRegularCounterexampleFiniteRelationIdeal k N :=
    quasiRegularCounterexampleTruncatedHypersurfaceIdeal_le_finiteRelationIdeal k N hnorm_hyp
  have hdiff :
      p - quasiRegularCounterexampleTruncationNormalize k N p ∈
        quasiRegularCounterexampleFiniteRelationIdeal k N :=
    quasiRegularCounterexampleFiniteRelationIdeal_sub_normalize_mem k N p
  have hsum :
      (p - quasiRegularCounterexampleTruncationNormalize k N p) +
          quasiRegularCounterexampleTruncationNormalize k N p ∈
        quasiRegularCounterexampleFiniteRelationIdeal k N :=
    Ideal.add_mem _ hdiff hnorm_finite
  -- The two transported pieces add back to the original representative.
  simpa [sub_eq_add_neg, add_assoc, add_comm, add_left_comm] using hsum

omit [Field k] in
/-- Helper for Chap10 Remark 10 69 8: full defining-ideal cancellation follows from finite
truncation cancellation and finite support of relation certificates. -/
theorem quasiRegularCounterexample_mem_ideal_of_mul_x_mem_ideal
    (p : quasiRegularCounterexamplePolynomialRing k)
    (hp : p * quasiRegularCounterexamplePolynomialX k ∈ quasiRegularCounterexampleIdeal k) :
    p ∈ quasiRegularCounterexampleIdeal k := by
  -- Move the full ideal-membership certificate into a finite truncation, cancel there, and include
  -- the finite truncation back into the full defining ideal.
  obtain ⟨N, hpN⟩ := quasiRegularCounterexampleIdeal_mem_finiteRelationIdeal k hp
  exact quasiRegularCounterexampleFiniteRelationIdeal_le_ideal k N
    (quasiRegularCounterexampleFiniteRelationIdeal_cancel_x k N p hpN)

/-- Helper for Chap10 Remark 10 69 8: extracting the `e`-coefficient from a tensor monomial
and collapsing the right tensor unit returns the left tensor coefficient. -/
theorem tensorCoeffRid_tmul_monomial
    {R : Type*} {Q : Type*} {σ : Type*}
    [CommSemiring R] [AddCommMonoid Q] [Module R Q]
    (e : σ →₀ ℕ) (q : Q) :
    (TensorProduct.rid R Q)
        ((TensorProduct.map LinearMap.id (MvPolynomial.lcoeff R e))
          (q ⊗ₜ[R] MvPolynomial.monomial e (1 : R))) = q := by
  -- The coefficient map sends the selected monomial to `1`, and the tensor right-unit map
  -- collapses `q ⊗ 1` back to `q`.
  classical
  simp [TensorProduct.map_tmul, MvPolynomial.lcoeff_apply]

/-- Helper for Chap10 Remark 10 69 8: evaluation on the counterexample variables that keeps
`y` and `w` as the two variables of `k[Y,W]` and kills `x` and all `z_n`. -/
def quasiRegularCounterexampleYWPolynomialVarMap (K : Type u) [CommRing K] :
    QuasiRegularCounterexampleVar → MvPolynomial (Fin 2) K
  | x => 0
  | y => X (0 : Fin 2)
  | w => X (1 : Fin 2)
  | z _ => 0

/-- Helper for Chap10 Remark 10 69 8: the polynomial evaluation to `k[Y,W]` used to detect the
`y`-adic separated quotient of `A/(x)`. -/
def quasiRegularCounterexamplePolynomialToYW (K : Type u) [CommRing K] :
    quasiRegularCounterexamplePolynomialRing K →+* MvPolynomial (Fin 2) K :=
  MvPolynomial.eval₂Hom C (quasiRegularCounterexampleYWPolynomialVarMap K)

/-- Helper for Chap10 Remark 10 69 8: the initial counterexample relation vanishes under the
projection to `k[Y,W]`. -/
theorem quasiRegularCounterexamplePolynomialToYW_initial_relation (K : Type u) [CommRing K] :
    quasiRegularCounterexamplePolynomialToYW K
      (quasiRegularCounterexampleInitialRelation K) = 0 := by
  -- The projection kills both `x` and `z_0`, so the two terms in the initial relation vanish.
  simp [quasiRegularCounterexamplePolynomialToYW, quasiRegularCounterexampleYWPolynomialVarMap,
    quasiRegularCounterexampleInitialRelation]

/-- Helper for Chap10 Remark 10 69 8: every recurrence relation vanishes under the projection to
`k[Y,W]`. -/
theorem quasiRegularCounterexamplePolynomialToYW_recurrence_relation (K : Type u) [CommRing K]
    (n : ℕ) :
    quasiRegularCounterexamplePolynomialToYW K
      (quasiRegularCounterexampleRecurrenceRelation K n) = 0 := by
  -- Each recurrence contains only `z`-variables besides the factor `y`, and all `z`-variables are
  -- killed by the projection.
  simp [quasiRegularCounterexamplePolynomialToYW, quasiRegularCounterexampleYWPolynomialVarMap,
    quasiRegularCounterexampleRecurrenceRelation]

/-- Helper for Chap10 Remark 10 69 8: the defining ideal of the counterexample ring is contained
in the kernel of the projection to `k[Y,W]`. -/
theorem quasiRegularCounterexampleIdeal_le_ker_polynomialToYW (K : Type u) [CommRing K] :
    quasiRegularCounterexampleIdeal K ≤
      RingHom.ker (quasiRegularCounterexamplePolynomialToYW K) := by
  -- It is enough to check the displayed generators of the defining ideal.
  rw [quasiRegularCounterexampleIdeal]
  refine Ideal.span_le.mpr ?_
  rintro p (hp | hp)
  · rw [hp]
    exact quasiRegularCounterexamplePolynomialToYW_initial_relation K
  · rcases hp with ⟨n, rfl⟩
    exact quasiRegularCounterexamplePolynomialToYW_recurrence_relation K n

/-- Helper for Chap10 Remark 10 69 8: the induced map from the counterexample ring to `k[Y,W]`.
-/
def quasiRegularCounterexampleYWMap (K : Type u) [CommRing K] :
    quasiRegularCounterexampleRing K →+* MvPolynomial (Fin 2) K :=
  Ideal.Quotient.lift (quasiRegularCounterexampleIdeal K)
    (quasiRegularCounterexamplePolynomialToYW K)
    (quasiRegularCounterexampleIdeal_le_ker_polynomialToYW K)

/-- Helper for Chap10 Remark 10 69 8: the induced `k[Y,W]` map sends `x` to zero. -/
@[simp] theorem quasiRegularCounterexampleYWMap_x (K : Type u) [CommRing K] :
    quasiRegularCounterexampleYWMap K (quasiRegularCounterexampleX K) = 0 := by
  -- Compute on the quotient representative `X x`.
  simp [quasiRegularCounterexampleYWMap, quasiRegularCounterexamplePolynomialToYW,
    quasiRegularCounterexampleYWPolynomialVarMap, quasiRegularCounterexampleX]

/-- Helper for Chap10 Remark 10 69 8: the induced `k[Y,W]` map sends `y` to `Y`. -/
@[simp] theorem quasiRegularCounterexampleYWMap_y (K : Type u) [CommRing K] :
    quasiRegularCounterexampleYWMap K (quasiRegularCounterexampleY K) =
      X (0 : Fin 2) := by
  -- Compute on the quotient representative `X y`.
  simp [quasiRegularCounterexampleYWMap, quasiRegularCounterexamplePolynomialToYW,
    quasiRegularCounterexampleYWPolynomialVarMap, quasiRegularCounterexampleY]

/-- Helper for Chap10 Remark 10 69 8: the induced `k[Y,W]` map sends `w` to `W`. -/
@[simp] theorem quasiRegularCounterexampleYWMap_w (K : Type u) [CommRing K] :
    quasiRegularCounterexampleYWMap K (quasiRegularCounterexampleW K) =
      X (1 : Fin 2) := by
  -- Compute on the quotient representative `X w`.
  simp [quasiRegularCounterexampleYWMap, quasiRegularCounterexamplePolynomialToYW,
    quasiRegularCounterexampleYWPolynomialVarMap, quasiRegularCounterexampleW]

/-- Helper for Chap10 Remark 10 69 8: the induced `k[Y,W]` map kills every `z_n`. -/
@[simp] theorem quasiRegularCounterexampleYWMap_z (K : Type u) [CommRing K] (n : ℕ) :
    quasiRegularCounterexampleYWMap K (quasiRegularCounterexampleZ K n) = 0 := by
  -- Compute on the quotient representative `X (z n)`.
  simp [quasiRegularCounterexampleYWMap, quasiRegularCounterexamplePolynomialToYW,
    quasiRegularCounterexampleYWPolynomialVarMap, quasiRegularCounterexampleZ]

/-- Helper for Chap10 Remark 10 69 8: the principal ideal `(x)` is killed by the map to
`k[Y,W]`. -/
theorem quasiRegularCounterexampleXIdeal_le_ker_YWMap (K : Type u) [CommRing K] :
    quasiRegularCounterexampleXIdeal K ≤ RingHom.ker (quasiRegularCounterexampleYWMap K) := by
  -- The ideal is generated by `x`, and the computation lemma above kills that generator.
  rw [quasiRegularCounterexampleXIdeal]
  refine Ideal.span_le.mpr ?_
  intro a ha
  rw [Set.mem_singleton_iff.mp ha]
  exact quasiRegularCounterexampleYWMap_x K

/-- Helper for Chap10 Remark 10 69 8: the projection from `A/(x)` to `k[Y,W]` sending
`y ↦ Y`, `w ↦ W`, and all `z_n ↦ 0`. -/
def quasiRegularCounterexampleYModXProjection (K : Type u) [CommRing K] :
    quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K →+*
      MvPolynomial (Fin 2) K :=
  Ideal.Quotient.lift (quasiRegularCounterexampleXIdeal K)
    (quasiRegularCounterexampleYWMap K)
    (quasiRegularCounterexampleXIdeal_le_ker_YWMap K)

/-- Helper for Chap10 Remark 10 69 8: the projection from `A/(x)` sends the image of `y` to `Y`.
-/
@[simp] theorem quasiRegularCounterexampleYModXProjection_y (K : Type u) [CommRing K] :
    quasiRegularCounterexampleYModXProjection K (quasiRegularCounterexampleYModX K) =
      X (0 : Fin 2) := by
  -- Compute through the quotient map `A → A/(x)` and the already established image of `y`.
  simp [quasiRegularCounterexampleYModXProjection, quasiRegularCounterexampleYModX]

/-- Helper for Chap10 Remark 10 69 8: in `k[Y,W]`, divisibility of `Y^n p` by `Y^(n+1)` forces
divisibility of `p` by `Y`. -/
theorem mvPolynomial_finTwo_X0_powerSaturation (K : Type u) [CommRing K]
    (n : ℕ) (p : MvPolynomial (Fin 2) K)
    (hp : X (0 : Fin 2) ^ n * p ∈
      (Ideal.span ({X (0 : Fin 2)} : Set (MvPolynomial (Fin 2) K))) ^ (n + 1)) :
    p ∈ Ideal.span ({X (0 : Fin 2)} : Set (MvPolynomial (Fin 2) K)) := by
  -- Convert principal-power membership to a divisibility equation and cancel the monomial `Y^n`
  -- coefficientwise, so no domain hypothesis on the coefficient ring is needed.
  rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hp
  rw [Ideal.mem_span_singleton]
  rcases hp with ⟨q, hq⟩
  refine ⟨q, ?_⟩
  ext d
  have hcoeff := congrArg
    (MvPolynomial.coeff (Finsupp.single (0 : Fin 2) n + d)) hq
  simpa [X_pow_eq_monomial, pow_succ, mul_assoc, MvPolynomial.coeff_monomial_mul]
    using hcoeff

/-- Helper for Chap10 Remark 10 69 8: a `y`-power containment in `A/(x)` projects to
membership in the principal ideal `(Y)` of `k[Y,W]`. -/
theorem quasiRegularCounterexampleYModXProjection_mem_span_Y_of_mem_power
    (K : Type u) [CommRing K] (n : ℕ)
    (b : quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K)
    (hb : (quasiRegularCounterexampleYModX K) ^ n * b ∈
      (Ideal.span ({quasiRegularCounterexampleYModX K} :
        Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K))) ^ (n + 1)) :
    quasiRegularCounterexampleYModXProjection K b ∈
      (Ideal.span ({(X (0 : Fin 2) : MvPolynomial (Fin 2) K)} :
        Set (MvPolynomial (Fin 2) K)) : Ideal (MvPolynomial (Fin 2) K)).carrier := by
  -- Map the ideal-power containment to `k[Y,W]`, where it becomes exactly the cancellation
  -- hypothesis for `Y^n * projection(b)`.
  have hmap := Ideal.mem_map_of_mem (quasiRegularCounterexampleYModXProjection K) hb
  have hmap' :
      X (0 : Fin 2) ^ n * quasiRegularCounterexampleYModXProjection K b ∈
        ((Ideal.span ({(X (0 : Fin 2) : MvPolynomial (Fin 2) K)} :
          Set (MvPolynomial (Fin 2) K)) : Ideal (MvPolynomial (Fin 2) K))) ^ (n + 1) := by
    simpa [Ideal.map_pow, Ideal.map_span, Set.image_singleton, map_mul, map_pow] using hmap
  exact mvPolynomial_finTwo_X0_powerSaturation K n
    (quasiRegularCounterexampleYModXProjection K b) hmap'

/-- Helper for Chap10 Remark 10 69 8: every associated-graded source tensor is a finite sum of
monomial simple tensors with quotient-module coefficients. -/
theorem quasiRegularSourceTensor_monomialExpansion
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    (rs : List A)
    (z : (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) ⊗[A ⧸ Ideal.ofList rs]
      MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs)) :
    ∃ coeffs : (Fin rs.length →₀ ℕ) →₀ (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))),
      z =
        coeffs.sum fun e q ↦
          (q ⊗ₜ[A ⧸ Ideal.ofList rs]
            MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs)) := by
  -- Commute the tensor factors and use the standard scalar tensor equivalence for multivariate
  -- polynomials to read off finitely many monomial coefficients.
  let comm :=
    TensorProduct.comm (A ⧸ Ideal.ofList rs)
      (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P)))
      (MvPolynomial (Fin rs.length) (A ⧸ Ideal.ofList rs))
  let scalar :=
    MvPolynomial.scalarRTensor
      (R := A ⧸ Ideal.ofList rs)
      (σ := Fin rs.length)
      (N := P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P)))
  let coeffs :
      (Fin rs.length →₀ ℕ) →₀ (P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) :=
    scalar (comm z)
  refine ⟨coeffs, ?_⟩
  apply comm.injective
  calc
    comm z = scalar.symm coeffs := by
      simp [coeffs]
    _ = scalar.symm (coeffs.sum fun e q ↦ Finsupp.single e q) := by
      simp
    _ = coeffs.sum fun e q ↦ scalar.symm (Finsupp.single e q) := by
      simp [Finsupp.sum]
    _ = coeffs.sum fun e q ↦
          (MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs)) ⊗ₜ[A ⧸ Ideal.ofList rs] q := by
      refine Finsupp.sum_congr ?_
      intro e q
      rw [MvPolynomial.scalarRTensor_symm_apply_single]
    _ = comm
          (coeffs.sum fun e q ↦
            (q ⊗ₜ[A ⧸ Ideal.ofList rs]
              MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs))) := by
      simp only [Finsupp.sum, map_sum]
      refine Finset.sum_congr rfl ?_
      intro e he
      rw [TensorProduct.comm_tmul]

/-- Helper for Chap10 Remark 10 69 8: a monomial source sum is zero when all lifted
coefficients vanish in the quotient module. -/
theorem quasiRegularSourceTensor_sum_eq_zero_of_coeff_mem_ideal
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    {rs : List A} {a : (Fin rs.length →₀ ℕ) →₀ P}
    (ha : ∀ e ∈ a.support, a e ∈ (Ideal.ofList rs) • (⊤ : Submodule A P)) :
    a.sum (fun e m ↦
      ((Submodule.Quotient.mk m :
          P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) ⊗ₜ[A ⧸ Ideal.ofList rs]
        MvPolynomial.monomial e (1 : A ⧸ Ideal.ofList rs))) = 0 := by
  -- Each displayed coefficient is zero in `P / J P`, so every simple tensor in the finite sum
  -- vanishes.
  rw [Finsupp.sum]
  apply Finset.sum_eq_zero
  intro e he
  have hm :
      (Submodule.Quotient.mk (a e) :
        P ⧸ ((Ideal.ofList rs) • (⊤ : Submodule A P))) = 0 :=
    (Submodule.Quotient.mk_eq_zero _).mpr (ha e he)
  simp [hm]

/-- Helper for Chap10 Remark 10 69 8: an exponent vector on `Fin 1` is determined by its total
degree. -/
theorem finOneFinsupp_eq_single_degree (e : Fin 1 →₀ ℕ) :
    e = Finsupp.single 0 e.degree := by
  -- There is only one coordinate, so extensionality reduces the statement to the definition of
  -- total degree.
  apply Finsupp.ext
  intro i
  have hi : i = 0 := Subsingleton.elim i 0
  subst hi
  simp only [Finsupp.single_eq_same]
  change e 0 = ∑ i ∈ e.support, e i
  symm
  refine Finset.sum_eq_single (s := e.support) (f := fun i : Fin 1 ↦ e i) 0 ?_ ?_
  · intro b hb hbne
    have hb0 : b = 0 := Subsingleton.elim b 0
    exact (hbne hb0).elim
  · intro hnot
    exact Finsupp.notMem_support_iff.mp hnot

/-- Helper for Chap10 Remark 10 69 8: two exponent vectors on `Fin 1` with the same total degree
are equal. -/
theorem finOneFinsupp_eq_of_degree_eq {e d : Fin 1 →₀ ℕ} (h : d.degree = e.degree) :
    d = e := by
  -- Normalize both exponents to the unique one-coordinate exponent of their degree.
  rw [finOneFinsupp_eq_single_degree d, finOneFinsupp_eq_single_degree e, h]

/-- Helper for Chap10 Remark 10 69 8: the monomial weight for the singleton list `[r]` is
`r ^ e.degree`. -/
theorem singletonList_monomialWeight {R : Type*} [CommRing R]
    (r : R) (e : Fin [r].length →₀ ℕ) :
    (∏ i : Fin [r].length, [r].get i ^ e i) = r ^ e.degree := by
  -- Replace the exponent by its single coordinate and simplify the one-term product.
  rw [finOneFinsupp_eq_single_degree e]
  simp

/-- Helper for Chap10 Remark 10 69 8: the degree-`e.degree` component of the singleton
associated-graded image records exactly the `e`-coefficient. -/
theorem singleton_component_quasiRegularMap_sum
    {R : Type*} [CommRing R] (r : R)
    (a : (Fin [r].length →₀ ℕ) →₀ R) (e : Fin [r].length →₀ ℕ) :
    let J : Ideal R := Ideal.ofList [r]
    let source :=
      a.sum fun d m ↦
        ((Submodule.Quotient.mk m : R ⧸ (J • (⊤ : Submodule R R))) ⊗ₜ[R ⧸ J]
          MvPolynomial.monomial d (1 : R ⧸ J))
    DirectSum.component (R ⧸ J) ℕ (idealAssociatedGradedPiece J R) e.degree
        (quasiRegularSequenceAssociatedGradedMap R [r] source) =
      Submodule.Quotient.mk
        (⟨r ^ e.degree * a e, by
          have hpow : r ^ e.degree ∈ J ^ e.degree := by
            rw [show J = Ideal.span ({r} : Set R) by simp [J]]
            exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) e.degree
          simpa [idealAssociatedGradedStage, regularModuleIdeal_smul_top_eq, smul_eq_mul] using
            (Submodule.smul_mem_smul hpow (by simp : a e ∈ (⊤ : Submodule R R)))⟩ :
          idealAssociatedGradedStage J R e.degree) := by
  classical
  intro J source
  -- Expand the finite coefficient sum and project the direct-sum image to the requested degree.
  dsimp [source]
  rw [Finsupp.sum]
  calc
    DirectSum.component (R ⧸ J) ℕ (idealAssociatedGradedPiece J R) e.degree
        (quasiRegularSequenceAssociatedGradedMap R [r]
          (∑ x ∈ a.support,
            (Submodule.Quotient.mk (a x) : R ⧸ (J • ⊤)) ⊗ₜ[R ⧸ J]
              MvPolynomial.monomial x (1 : R ⧸ J))) =
      ∑ x ∈ a.support,
        DirectSum.component (R ⧸ J) ℕ (idealAssociatedGradedPiece J R) e.degree
          (quasiRegularSequenceAssociatedGradedMap R [r]
            ((Submodule.Quotient.mk (a x) : R ⧸ (J • ⊤)) ⊗ₜ[R ⧸ J]
              MvPolynomial.monomial x (1 : R ⧸ J))) := by
        simp [map_sum]
    _ = Submodule.Quotient.mk
        (⟨r ^ e.degree * a e, by
          have hpow : r ^ e.degree ∈ J ^ e.degree := by
            rw [show J = Ideal.span ({r} : Set R) by simp [J]]
            exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) e.degree
          simpa [idealAssociatedGradedStage, regularModuleIdeal_smul_top_eq, smul_eq_mul] using
            (Submodule.smul_mem_smul hpow (by simp : a e ∈ (⊤ : Submodule R R)))⟩ :
          idealAssociatedGradedStage J R e.degree) := by
        calc
          (∑ x ∈ a.support,
              DirectSum.component (R ⧸ J) ℕ (idealAssociatedGradedPiece J R) e.degree
                ((quasiRegularSequenceAssociatedGradedMap R [r])
                  ((Submodule.Quotient.mk (a x) : R ⧸ (J • ⊤)) ⊗ₜ[R ⧸ J]
                    MvPolynomial.monomial x (1 : R ⧸ J)))) =
            DirectSum.component (R ⧸ J) ℕ (idealAssociatedGradedPiece J R) e.degree
              ((quasiRegularSequenceAssociatedGradedMap R [r])
                ((Submodule.Quotient.mk (a e) : R ⧸ (J • ⊤)) ⊗ₜ[R ⧸ J]
                  MvPolynomial.monomial e (1 : R ⧸ J))) := by
              refine Finset.sum_eq_single e ?_ ?_
              · intro x hx hxe
                have hxdeg : x.degree ≠ e.degree := by
                  intro hdeg
                  exact hxe (finOneFinsupp_eq_of_degree_eq hdeg)
                have hterm := quasiRegularSourceMonomialImage (P := R) (rs := [r]) (m := a x) x
                rw [hterm]
                simp [J, DirectSum.component.of, hxdeg]
              · intro he_not
                have hae : a e = 0 := Finsupp.notMem_support_iff.mp he_not
                have hterm := quasiRegularSourceMonomialImage (P := R) (rs := [r]) (m := a e) e
                rw [hterm]
                rw [DirectSum.component.lof_self]
                apply associatedGradedPieceMkEqZeroOfMemNextStage
                simp [hae, idealAssociatedGradedStage]
          _ = Submodule.Quotient.mk
              (⟨r ^ e.degree * a e, by
                have hpow : r ^ e.degree ∈ J ^ e.degree := by
                  rw [show J = Ideal.span ({r} : Set R) by simp [J]]
                  exact Ideal.pow_mem_pow (Ideal.subset_span (by simp)) e.degree
                simpa [idealAssociatedGradedStage, regularModuleIdeal_smul_top_eq, smul_eq_mul]
                  using (Submodule.smul_mem_smul hpow
                    (by simp : a e ∈ (⊤ : Submodule R R)))⟩ :
                idealAssociatedGradedStage J R e.degree) := by
              have hterm := quasiRegularSourceMonomialImage (P := R) (rs := [r]) (m := a e) e
              rw [hterm]
              have hdegree : e.degree = e 0 := by
                rw [finOneFinsupp_eq_single_degree e]
                simp
              simp [J, hdegree]

/-- Helper for Chap10 Remark 10 69 8: a principal power-saturation criterion implies
quasi-regularity of the singleton sequence. -/
theorem isQuasiRegularSequence_singleton_of_powerSaturation {R : Type*} [CommRing R] (r : R)
    (hsat : ∀ n a,
      r ^ n * a ∈ (Ideal.span ({r} : Set R)) ^ (n + 1) →
        a ∈ Ideal.span ({r} : Set R)) :
    IsQuasiRegularSequence [r] := by
  classical
  -- Reduce to injectivity and prove that every kernel element has all coefficients zero in
  -- `R / (r)`.
  rw [IsQuasiRegularSequence, isQuasiRegular_iff_injective]
  let J : Ideal R := Ideal.ofList [r]
  let Q : Type _ := R ⧸ (J • (⊤ : Submodule R R))
  let map := quasiRegularSequenceAssociatedGradedMap R [r]
  have hJ : J = Ideal.span ({r} : Set R) := by
    simp [J]
  have hkernel : ∀ z, map z = 0 → z = 0 := by
    intro z hz
    obtain ⟨coeffs, hcoeffs⟩ := quasiRegularSourceTensor_monomialExpansion (P := R) [r] z
    let lift : (Fin [r].length →₀ ℕ) → R := fun e ↦
      (Submodule.Quotient.mk_surjective (J • (⊤ : Submodule R R)) (coeffs e)).choose
    have hlift : ∀ e, (Submodule.Quotient.mk (lift e) : Q) = coeffs e := by
      intro e
      exact (Submodule.Quotient.mk_surjective (J • (⊤ : Submodule R R)) (coeffs e)).choose_spec
    let lifted : (Fin [r].length →₀ ℕ) →₀ R :=
      Finsupp.onFinset coeffs.support
        (fun e ↦ if e ∈ coeffs.support then lift e else 0)
        (by
          intro e hne
          by_cases he : e ∈ coeffs.support
          · exact he
          · simp [he] at hne)
    have hlifted_apply : ∀ e, (Submodule.Quotient.mk (lifted e) : Q) = coeffs e := by
      intro e
      by_cases he : e ∈ coeffs.support
      · have hne : coeffs e ≠ 0 := Finsupp.mem_support_iff.mp he
        have hif : (if coeffs e = 0 then 0 else lift e) = lift e := by
          simp [hne]
        simpa [lifted, hif] using hlift e
      · have hzero : coeffs e = 0 := Finsupp.notMem_support_iff.mp he
        simp [lifted, hzero]
    have hlifted_support : lifted.support = coeffs.support := by
      refine Finset.ext fun e ↦ ?_
      constructor
      · intro he
        simpa [lifted] using
          (Finsupp.support_onFinset_subset
            (s := coeffs.support)
            (f := fun e ↦ if e ∈ coeffs.support then lift e else 0)
            (hf := by
              intro e hne
              by_cases he' : e ∈ coeffs.support
              · exact he'
              · simp [he'] at hne)
            he)
      · intro he
        have hcoeff_ne : coeffs e ≠ 0 := Finsupp.mem_support_iff.mp he
        have hlifted_ne : lifted e ≠ 0 := by
          intro hzero
          have hquot_zero : (Submodule.Quotient.mk (lifted e) : Q) = 0 := by
            simpa [hzero]
          exact hcoeff_ne ((hlifted_apply e).symm.trans hquot_zero)
        exact Finsupp.mem_support_iff.mpr hlifted_ne
    let source :=
      lifted.sum fun e m ↦
        ((Submodule.Quotient.mk m : Q) ⊗ₜ[R ⧸ J]
          MvPolynomial.monomial e (1 : R ⧸ J))
    have hsource_coeffs :
        source =
          coeffs.sum fun e q ↦
            (q ⊗ₜ[R ⧸ J] MvPolynomial.monomial e (1 : R ⧸ J)) := by
      -- Replace the selected representatives by their quotient classes without changing the
      -- finite source sum.
      dsimp [source]
      rw [Finsupp.sum, Finsupp.sum, hlifted_support]
      refine Finset.sum_congr rfl ?_
      intro e he
      simpa [Q] using
        congrArg
          (fun q : R ⧸ (J • (⊤ : Submodule R R)) ↦
            q ⊗ₜ[R ⧸ J] MvPolynomial.monomial e (1 : R ⧸ J))
          (hlifted_apply e)
    have hsource_eq : source = z := by
      calc
        source = coeffs.sum fun e q ↦
            (q ⊗ₜ[R ⧸ J] MvPolynomial.monomial e (1 : R ⧸ J)) := hsource_coeffs
        _ = z := hcoeffs.symm
    have hsource_ker : map source = 0 := by
      simpa [map, hsource_eq] using hz
    have hcoeff_mem : ∀ e ∈ lifted.support, lifted e ∈ J • (⊤ : Submodule R R) := by
      intro e he
      -- The degree component of the associated-graded zero relation says
      -- `r^degree * coeff` lies in the next stage.
      have hcomponent_zero := congrArg
        (DirectSum.component (R ⧸ J) ℕ (idealAssociatedGradedPiece J R) e.degree)
        hsource_ker
      have hcomponent_eq := singleton_component_quasiRegularMap_sum r lifted e
      have hcomponent_zero' :
          DirectSum.component (R ⧸ J) ℕ (idealAssociatedGradedPiece J R) e.degree
              (map source) = 0 := by
        simpa using hcomponent_zero
      have hpiece_zero := hcomponent_eq.symm.trans hcomponent_zero'
      have hnext : r ^ e.degree * lifted e ∈ (Ideal.span ({r} : Set R)) ^ (e.degree + 1) := by
        rw [Submodule.Quotient.mk_eq_zero] at hpiece_zero
        simpa [idealAssociatedGradedPiece, idealAssociatedGradedStage,
          regularModuleIdeal_smul_top_eq, hJ] using hpiece_zero
      have hmemIdeal : lifted e ∈ Ideal.span ({r} : Set R) :=
        hsat e.degree (lifted e) hnext
      simpa [hJ, regularModuleIdeal_smul_top_eq] using hmemIdeal
    have hsource_zero : source = 0 := by
      exact quasiRegularSourceTensor_sum_eq_zero_of_coeff_mem_ideal (rs := [r]) (a := lifted)
        hcoeff_mem
    simpa [hsource_eq] using hsource_zero
  intro z₁ z₂ hz
  have hsub : map (z₁ - z₂) = 0 := by
    simpa [map_sub] using show map z₁ - map z₂ = 0 from sub_eq_zero.mpr hz
  exact sub_eq_zero.mp (hkernel (z₁ - z₂) hsub)

/-- Helper for Chap10 Remark 10 69 8: a polynomial in `k[Y,W]` divisible by `Y` has no pure
`W^n` coefficient. -/
theorem mvPolynomial_finTwo_coeff_W_of_mem_span_Y (K : Type u) [CommRing K] (n : ℕ)
    {p : MvPolynomial (Fin 2) K}
    (hp : p ∈ Ideal.span ({X (0 : Fin 2)} : Set (MvPolynomial (Fin 2) K))) :
    MvPolynomial.coeff (Finsupp.single (1 : Fin 2) n) p = 0 := by
  -- Write membership as `p = Y * q`; then the coefficient with zero `Y`-exponent vanishes.
  rw [Ideal.mem_span_singleton] at hp
  rcases hp with ⟨q, rfl⟩
  simp [MvPolynomial.coeff_X_mul']

/-- Helper for Chap10 Remark 10 69 8: the `W^n` coefficient after projection to `k[Y,W]` is the
coefficient of the pure `w^n` monomial upstairs. -/
theorem quasiRegularCounterexamplePolynomialToYW_coeff_pure_w (K : Type u) [CommRing K]
    (p : quasiRegularCounterexamplePolynomialRing K) (n : ℕ) :
    MvPolynomial.coeff (Finsupp.single (1 : Fin 2) n)
      (quasiRegularCounterexamplePolynomialToYW K p) =
    MvPolynomial.coeff (Finsupp.single w n) p := by
  -- Induct through constants, addition, and multiplication by one variable; only the `w`-case
  -- shifts the pure `W` coefficient.
  induction p using MvPolynomial.induction_on generalizing n with
  | C a =>
      cases n with
      | zero => simp [quasiRegularCounterexamplePolynomialToYW]
      | succ n =>
          have hleft :
              ¬ ((0 : Fin 2 →₀ ℕ) =
                Finsupp.single (1 : Fin 2) n + Finsupp.single (1 : Fin 2) 1) := by
            intro h
            have hcoord := congrArg (fun e : Fin 2 →₀ ℕ ↦ e (1 : Fin 2)) h
            simp at hcoord
          have hright :
              ¬ ((0 : QuasiRegularCounterexampleVar →₀ ℕ) =
                Finsupp.single w n + Finsupp.single w 1) := by
            intro h
            have hcoord := congrArg (fun e : QuasiRegularCounterexampleVar →₀ ℕ ↦ e w) h
            simp at hcoord
          simp [quasiRegularCounterexamplePolynomialToYW, hleft, hright]
  | add p q hp hq =>
      simp [map_add, hp n, hq n]
  | mul_X p v hp =>
      cases v with
      | x =>
          simp [quasiRegularCounterexamplePolynomialToYW, quasiRegularCounterexampleYWPolynomialVarMap,
            MvPolynomial.coeff_mul_X']
      | y =>
          simp [quasiRegularCounterexamplePolynomialToYW, quasiRegularCounterexampleYWPolynomialVarMap,
            MvPolynomial.coeff_mul_X']
      | w =>
          cases n with
          | zero =>
              simp [quasiRegularCounterexamplePolynomialToYW,
                quasiRegularCounterexampleYWPolynomialVarMap, MvPolynomial.coeff_mul_X']
          | succ n =>
              simpa [quasiRegularCounterexamplePolynomialToYW,
                quasiRegularCounterexampleYWPolynomialVarMap, MvPolynomial.coeff_mul_X'] using hp n
      | z m =>
          simp [quasiRegularCounterexamplePolynomialToYW, quasiRegularCounterexampleYWPolynomialVarMap,
            MvPolynomial.coeff_mul_X']

/-- Helper for Chap10 Remark 10 69 8: any monomial involving a variable other than `w` maps into
the principal ideal generated by `y` after quotienting by `(x)`. -/
theorem quasiRegularCounterexample_monomial_mem_span_yModX_of_nonW (K : Type u) [CommRing K]
    (s : QuasiRegularCounterexampleVar →₀ ℕ) (c : K) {v : QuasiRegularCounterexampleVar}
    (hv : v ≠ w) (hspos : s v ≠ 0) :
    Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal K)
        (Ideal.Quotient.mk (quasiRegularCounterexampleIdeal K)
          (MvPolynomial.monomial s c : quasiRegularCounterexamplePolynomialRing K)) ∈
      Ideal.span ({quasiRegularCounterexampleYModX K} :
        Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K)) := by
  classical
  -- Factor the chosen non-`w` variable out of the monomial; `x` vanishes, `y` is the generator,
  -- and each `z_n` is already in `(y)` modulo `(x)`.
  let t := s - Finsupp.single v 1
  have hs_eq : s = Finsupp.single v 1 + t := by
    ext u
    by_cases huv : u = v
    · subst huv
      simp [t]
      omega
    · simp [t, Finsupp.single_eq_of_ne huv]
  have hmon :
      (MvPolynomial.monomial s c : quasiRegularCounterexamplePolynomialRing K) =
        X v * MvPolynomial.monomial t c := by
    rw [hs_eq, MvPolynomial.monomial_single_add]
    simp
  rw [hmon]
  cases v with
  | x =>
      have hxzero :
          Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal K) (quasiRegularCounterexampleX K) =
            0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
      simp [hxzero]
  | y =>
      have hy :
          quasiRegularCounterexampleYModX K ∈
            Ideal.span ({quasiRegularCounterexampleYModX K} :
              Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K)) :=
        Ideal.subset_span (by simp)
      simpa [quasiRegularCounterexampleY, quasiRegularCounterexampleYModX] using
        Ideal.mul_mem_right
          (Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal K)
            (Ideal.Quotient.mk (quasiRegularCounterexampleIdeal K)
              (MvPolynomial.monomial t c : quasiRegularCounterexamplePolynomialRing K)))
          (Ideal.span ({quasiRegularCounterexampleYModX K} :
            Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K))) hy
  | w =>
      exact (hv rfl).elim
  | z n =>
      have hzmem :
          Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal K)
              (quasiRegularCounterexampleZ K n) ∈
            Ideal.span ({quasiRegularCounterexampleYModX K} :
              Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K)) := by
        simpa [pow_one] using quasiRegularCounterexample_z_modX_mem_y_power K n 1
      simpa [quasiRegularCounterexampleZ] using
        Ideal.mul_mem_right
          (Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal K)
            (Ideal.Quotient.mk (quasiRegularCounterexampleIdeal K)
              (MvPolynomial.monomial t c : quasiRegularCounterexamplePolynomialRing K)))
          (Ideal.span ({quasiRegularCounterexampleYModX K} :
            Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K))) hzmem

/-- Helper for Chap10 Remark 10 69 8: if the `k[Y,W]` projection of an element of `A/(x)` lies
in `(Y)`, then the element lies in `(y)`. -/
theorem quasiRegularCounterexample_mem_span_yModX_of_projection_mem_span_Y (K : Type u)
    [CommRing K]
    (b : quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K)
    (hb : quasiRegularCounterexampleYModXProjection K b ∈
      Ideal.span ({X (0 : Fin 2)} : Set (MvPolynomial (Fin 2) K))) :
    b ∈ Ideal.span ({quasiRegularCounterexampleYModX K} :
      Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K)) := by
  -- Work on polynomial representatives. Pure `w` monomials have zero coefficient by the
  -- projection hypothesis; every remaining monomial contains `x`, `y`, or some `z_n`.
  revert hb
  refine Quotient.inductionOn' b ?_
  intro a hb
  revert hb
  refine Quotient.inductionOn' a ?_
  intro p hb
  have hp : quasiRegularCounterexamplePolynomialToYW K p ∈
      Ideal.span ({X (0 : Fin 2)} : Set (MvPolynomial (Fin 2) K)) := by
    simpa [quasiRegularCounterexampleYModXProjection, quasiRegularCounterexampleYWMap] using hb
  rw [MvPolynomial.as_sum p]
  change
    Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal K)
      (Ideal.Quotient.mk (quasiRegularCounterexampleIdeal K)
        (∑ s ∈ p.support,
          (MvPolynomial.monomial s (MvPolynomial.coeff s p) :
            quasiRegularCounterexamplePolynomialRing K))) ∈
      Ideal.span ({quasiRegularCounterexampleYModX K} :
        Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K))
  simp only [map_sum]
  refine Ideal.sum_mem _ ?_
  intro s hs
  by_cases hpure : ∀ v : QuasiRegularCounterexampleVar, v ≠ w → s v = 0
  · have hs_eq : s = Finsupp.single w (s w) := by
      ext v
      by_cases hvw : v = w
      · subst hvw
        simp
      · simp [Finsupp.single_eq_of_ne hvw, hpure v hvw]
    have hcoeff_zero : MvPolynomial.coeff s p = 0 := by
        have hW := mvPolynomial_finTwo_coeff_W_of_mem_span_Y K (s w) hp
        have hcoeff := quasiRegularCounterexamplePolynomialToYW_coeff_pure_w K p (s w)
        rw [hcoeff] at hW
        rw [hs_eq]
        exact hW
    simp [hcoeff_zero]
  · push Not at hpure
    rcases hpure with ⟨v, hvw, hvpos⟩
    exact quasiRegularCounterexample_monomial_mem_span_yModX_of_nonW K s
      (MvPolynomial.coeff s p) hvw hvpos

/-- Helper for Chap10 Remark 10 69 8: the image of `y` in `A/(x)` satisfies the principal
power-saturation criterion. -/
theorem quasiRegularCounterexample_yModX_powerSaturation (K : Type u) [CommRing K] [Field K] :
    ∀ n b,
      (quasiRegularCounterexampleYModX K) ^ n * b ∈
        (Ideal.span ({quasiRegularCounterexampleYModX K} :
          Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K))) ^
          (n + 1) →
      b ∈ Ideal.span ({quasiRegularCounterexampleYModX K} :
        Set (quasiRegularCounterexampleRing K ⧸ quasiRegularCounterexampleXIdeal K)) := by
  -- Project the power containment to `k[Y,W]`, cancel the corresponding power of `Y`, and then
  -- pull divisibility by `Y` back to divisibility by `y`.
  intro n b hb
  exact quasiRegularCounterexample_mem_span_yModX_of_projection_mem_span_Y K b
    (quasiRegularCounterexampleYModXProjection_mem_span_Y_of_mem_power K n b hb)

-- Proof sketch: reduce a hypothetical annihilator of `x` to a finite truncation of the
-- `z`-variables, identify that truncation with the hypersurface
-- `k[x,y,w,t]/(w*x - y^(N+2)*t)`, and cancel `x` there via the proved divisibility lemma above.
omit [Field k] in
/-- In the counterexample ring, the distinguished element `x` is a nonzerodivisor. -/
theorem quasiRegularCounterexample_x_mem_nonZeroDivisors :
    quasiRegularCounterexampleX k ∈ nonZeroDivisors (quasiRegularCounterexampleRing k) :=
  by
    -- Reduce nonzerodivisor membership in the quotient to cancellation of representatives modulo
    -- the defining ideal.
    rw [mem_nonZeroDivisors_iff_right]
    intro a
    refine Quotient.inductionOn a ?_
    intro p hp
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    apply quasiRegularCounterexample_mem_ideal_of_mul_x_mem_ideal
    -- The annihilation equation in the quotient is precisely membership of `p * X x` in the
    -- defining ideal.
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    simpa [quasiRegularCounterexampleX] using hp

-- Proof sketch: pass to the quotient by `(x)`, where the remaining relations identify
-- `z_n = y z_{n+1}` and let one verify the homogeneous coefficient criterion for the singleton
-- sequence consisting of the image of `y`.
/-- Helper for Remark 10.69.8: in the quotient of the counterexample ring by `(x)`, the
image of `y` is a quasi-regular singleton sequence. -/
theorem quasiRegularCounterexample_y_mod_x_isQuasiRegular :
    IsQuasiRegularSequence [quasiRegularCounterexampleYModX k] :=
  by
    -- The preceding saturation lemma is exactly the singleton criterion for the associated-graded
    -- comparison map.
    exact isQuasiRegularSequence_singleton_of_powerSaturation
      (quasiRegularCounterexampleYModX k)
      (quasiRegularCounterexample_yModX_powerSaturation k)

-- Proof sketch: compute the conormal module `(x, y)/(x, y)^2` and use the relation
-- `w * x = 0` there, while the class of `w` remains nonzero in the residue ring `A/(x, y)`.
-- This obstructs freeness of rank two and hence the quasi-regularity criterion for the pair
-- `(x, y)`.
/-- In the counterexample ring, the pair given by the images of `x` and `y` is not quasi-regular.
-/
theorem quasiRegularCounterexample_pair_not_isQuasiRegular :
    ¬ IsQuasiRegularSequence
      [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] :=
  by
    intro hpair
    let J : Ideal (quasiRegularCounterexampleRing k) :=
      Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]
    -- Quasi-regularity gives injectivity of the associated-graded source map.
    have hinj :
        Function.Injective
          (quasiRegularSequenceAssociatedGradedMap (quasiRegularCounterexampleRing k)
            [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) :=
      (isQuasiRegular_iff_injective
        (M := quasiRegularCounterexampleRing k)
        [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]).mp hpair
    -- The source witness maps to zero, so injectivity forces the source witness itself to vanish.
    have hsource_zero :
        ((Submodule.Quotient.mk (p :=
            (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
              (quasiRegularCounterexampleRing k))))
            (quasiRegularCounterexampleW k)) ⊗ₜ[
              quasiRegularCounterexampleRing k ⧸
                J]
          MvPolynomial.monomial quasiRegularCounterexamplePairXExponent
            (1 : quasiRegularCounterexampleRing k ⧸ J)) = 0 := by
      let f :=
        quasiRegularSequenceAssociatedGradedMap (quasiRegularCounterexampleRing k)
          [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]
      have hmap_zero :
          f
            ((Submodule.Quotient.mk (p :=
                (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                  (quasiRegularCounterexampleRing k))))
                (quasiRegularCounterexampleW k)) ⊗ₜ[
                  quasiRegularCounterexampleRing k ⧸ J]
              MvPolynomial.monomial quasiRegularCounterexamplePairXExponent
                (1 : quasiRegularCounterexampleRing k ⧸ J)) =
            f 0 := by
        have hmaps :
            f
              ((Submodule.Quotient.mk (p :=
                  (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                    (quasiRegularCounterexampleRing k))))
                  (quasiRegularCounterexampleW k)) ⊗ₜ[
                    quasiRegularCounterexampleRing k ⧸ J]
                MvPolynomial.monomial quasiRegularCounterexamplePairXExponent
                  (1 : quasiRegularCounterexampleRing k ⧸ J)) = 0 := by
          simpa [f, J] using quasiRegularCounterexamplePairSourceWitness_mapsToZero k
        exact hmaps.trans (LinearMap.map_zero f).symm
      exact hinj hmap_zero
    -- Extract the `x`-monomial coefficient, reducing source vanishing to vanishing of the
    -- quotient-module class of `w`.
    have hcoeff_zero :
        Submodule.Quotient.mk (p :=
            (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
              (quasiRegularCounterexampleRing k))))
            (quasiRegularCounterexampleW k) = 0 := by
      have happly := congrArg
        (fun t ↦
          (TensorProduct.rid (quasiRegularCounterexampleRing k ⧸ J)
              (quasiRegularCounterexampleRing k ⧸
                (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                  (quasiRegularCounterexampleRing k)))))
            ((TensorProduct.map LinearMap.id
              (MvPolynomial.lcoeff (quasiRegularCounterexampleRing k ⧸ J)
                quasiRegularCounterexamplePairXExponent)) t))
        hsource_zero
      have hleft :
          (TensorProduct.rid (quasiRegularCounterexampleRing k ⧸ J)
              (quasiRegularCounterexampleRing k ⧸
                (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                  (quasiRegularCounterexampleRing k)))))
            ((TensorProduct.map LinearMap.id
              (MvPolynomial.lcoeff (quasiRegularCounterexampleRing k ⧸ J)
                quasiRegularCounterexamplePairXExponent))
              ((Submodule.Quotient.mk (p :=
                  (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                    (quasiRegularCounterexampleRing k))))
                  (quasiRegularCounterexampleW k)) ⊗ₜ[
                    quasiRegularCounterexampleRing k ⧸ J]
                MvPolynomial.monomial quasiRegularCounterexamplePairXExponent
                  (1 : quasiRegularCounterexampleRing k ⧸ J))) =
            Submodule.Quotient.mk (p :=
              (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                (quasiRegularCounterexampleRing k))))
              (quasiRegularCounterexampleW k) := by
        exact tensorCoeffRid_tmul_monomial quasiRegularCounterexamplePairXExponent
          (Submodule.Quotient.mk (p :=
            (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
              (quasiRegularCounterexampleRing k))))
            (quasiRegularCounterexampleW k))
      have hright :
          (TensorProduct.rid (quasiRegularCounterexampleRing k ⧸ J)
              (quasiRegularCounterexampleRing k ⧸
                (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                  (quasiRegularCounterexampleRing k)))))
            ((TensorProduct.map LinearMap.id
              (MvPolynomial.lcoeff (quasiRegularCounterexampleRing k ⧸ J)
                quasiRegularCounterexamplePairXExponent))
              (0 :
                (quasiRegularCounterexampleRing k ⧸
                    (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                      (quasiRegularCounterexampleRing k)))) ⊗[
                      quasiRegularCounterexampleRing k ⧸ J]
                  MvPolynomial (Fin 2) (quasiRegularCounterexampleRing k ⧸ J))) = 0 := by
        rw [LinearMap.map_zero]
        exact LinearMap.map_zero
          (TensorProduct.rid (quasiRegularCounterexampleRing k ⧸ J)
            (quasiRegularCounterexampleRing k ⧸
              (J • (⊤ : Submodule (quasiRegularCounterexampleRing k)
                (quasiRegularCounterexampleRing k))))).toLinearMap
      exact hleft.symm.trans (happly.trans hright)
    -- The module quotient is by `J • ⊤ = J`; hence the vanishing class says `w ∈ J`, contradicting
    -- the residue-detector nonmembership lemma.
    have hw_mem :
        quasiRegularCounterexampleW k ∈ J := by
      rw [Submodule.Quotient.mk_eq_zero] at hcoeff_zero
      simpa [J, regularModuleIdeal_smul_top_eq] using hcoeff_zero
    exact quasiRegularCounterexampleW_not_mem_pairIdeal k (by simpa [J] using hw_mem)

-- Proof sketch: combine the previous three statements. The counterexample ring supplies a
-- nonzerodivisor `x`, a quasi-regular singleton sequence given by the image of `y` modulo `(x)`,
-- and nevertheless a non-quasi-regular pair `(x, y)` in the original ring, so the direct
-- quasi-regular analogue of Lemma `10.68.7` fails.
/-- Chap10 Remark 10 69 8: in the counterexample ring, having `x` as a nonzerodivisor and having
the image of `y` in `A/(x)` quasi-regular does not force the pair `(x, y)` to be
quasi-regular. -/
@[stacks 065M]
theorem quasiRegularCounterexample_shows_quasiRegular_append_criterion_fails :
    ¬ (quasiRegularCounterexampleX k ∈ nonZeroDivisors (quasiRegularCounterexampleRing k) →
        IsQuasiRegularSequence [quasiRegularCounterexampleYModX k] →
        IsQuasiRegularSequence [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) := by
  intro happend
  -- Combine the three counterexample ingredients.
  have hpair :
      IsQuasiRegularSequence
        [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] :=
    happend
      (quasiRegularCounterexample_x_mem_nonZeroDivisors k)
      (quasiRegularCounterexample_y_mod_x_isQuasiRegular k)
  exact quasiRegularCounterexample_pair_not_isQuasiRegular k hpair

end

