/-- Helper for Chap10 Remark 10 69 8: cancellation by `x` in the single hypersurface truncation.
-/
theorem quasiRegularCounterexampleTruncatedHypersurfaceIdeal_cancel_x
    (N : ℕ) (p : quasiRegularCounterexamplePolynomialRing k)
    (hp : p * quasiRegularCounterexamplePolynomialX k ∈
      quasiRegularCounterexampleTruncatedHypersurfaceIdeal k N) :
    p ∈ quasiRegularCounterexampleTruncatedHypersurfaceIdeal k N := by
  letI : CommSemiring k := (inferInstance : CommRing k).toCommSemiring
  -- Separate `x` as the univariate polynomial variable; the hypersurface generator becomes
  -- `C c - C a * X`, with nonzero constant coefficient `c = y^(N+2) z_N`.
  let e := quasiRegularCounterexampleXPolynomialEquiv k
  let yv := quasiRegularCounterexampleVarWithoutX_y
  let wv := quasiRegularCounterexampleVarWithoutX_w
  let zv := quasiRegularCounterexampleVarWithoutX_z N
  let c : MvPolynomial quasiRegularCounterexampleVarWithoutX k := X yv ^ (N + 2) * X zv
  let a : MvPolynomial quasiRegularCounterexampleVarWithoutX k := X wv
  let G : quasiRegularCounterexamplePolynomialRing k :=
    X y ^ (N + 2) * X (z N) - X w * X x
  have hG : e G = Polynomial.C c - Polynomial.C a * Polynomial.X := by
    simp [e, quasiRegularCounterexampleXPolynomialEquiv, G, c, a, yv, wv, zv, map_sub,
      map_mul, map_pow]
  have hpmap :
      e (p * quasiRegularCounterexamplePolynomialX k) ∈
        Ideal.span ({e G} :
          Set (Polynomial (MvPolynomial quasiRegularCounterexampleVarWithoutX k))) := by
    have hmap := Ideal.mem_map_of_mem e.toRingHom hp
    simpa [quasiRegularCounterexampleTruncatedHypersurfaceIdeal, G, Ideal.map_span] using hmap
  rw [Ideal.mem_span_singleton'] at hpmap
  rcases hpmap with ⟨h, hh⟩
  have hrel :
      e p * Polynomial.X = (Polynomial.C a * Polynomial.X - Polynomial.C c) * (-h) := by
    calc
      e p * Polynomial.X = e (p * quasiRegularCounterexamplePolynomialX k) := by
        simp [e, quasiRegularCounterexampleXPolynomialEquiv, quasiRegularCounterexamplePolynomialX,
          map_mul]
      _ = h * e G := hh.symm
      _ = (Polynomial.C a * Polynomial.X - Polynomial.C c) * (-h) := by
        rw [hG]
        ring
  have hXdvd_neg : Polynomial.X ∣ -h := by
    -- Compare constant coefficients. The constant coefficient equation says a unit-coefficient
    -- monomial kills the constant coefficient of `-h`.
    let cExp : quasiRegularCounterexampleVarWithoutX →₀ ℕ :=
      Finsupp.single yv (N + 2) + Finsupp.single zv 1
    let oneC : k :=
      @OfNat.ofNat k 1
        (@One.toOfNat1 k CommRing.toCommSemiring.toMonoidWithZero.toMulOneClass.toOne)
    let cCoeff : k := oneC * oneC
    have hunit_oneC :
        @IsUnit k CommRing.toCommSemiring.toMonoidWithZero.toMonoid oneC := by
      let u : @Units k CommRing.toCommSemiring.toMonoidWithZero.toMonoid := 1
      exact ⟨u, rfl⟩
    have hunit_cCoeff :
        @IsUnit k CommRing.toCommSemiring.toMonoidWithZero.toMonoid cCoeff := by
      dsimp [cCoeff]
      let u : @Units k CommRing.toCommSemiring.toMonoidWithZero.toMonoid := 1
      exact ⟨u * u, rfl⟩
    have hc_monomial : c = MvPolynomial.monomial cExp cCoeff := by
      dsimp [c, cExp, cCoeff, oneC]
      rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X, MvPolynomial.monomial_mul]
    have hcoeff := congrArg
      (fun P : Polynomial (MvPolynomial quasiRegularCounterexampleVarWithoutX k) ↦ P.coeff 0)
      hrel
    have hmul_zero : c * (-h).coeff 0 = 0 := by
      apply neg_eq_zero.mp
      simpa [sub_mul, Polynomial.coeff_C_mul, Polynomial.coeff_mul_X_zero] using hcoeff.symm
    have hcoeff_zero : (-h).coeff 0 = 0 := by
      rw [hc_monomial] at hmul_zero
      exact @mvPolynomial_monomial_unit_mul_eq_zero quasiRegularCounterexampleVarWithoutX k
        CommRing.toCommSemiring cExp cCoeff hunit_cCoeff ((-h).coeff 0) hmul_zero
    exact Polynomial.X_dvd_iff.mpr hcoeff_zero
  rcases hXdvd_neg with ⟨t, ht⟩
  have hcancel : e p = (Polynomial.C a * Polynomial.X - Polynomial.C c) * t := by
    have hrel2 :
        e p * Polynomial.X =
          ((Polynomial.C a * Polynomial.X - Polynomial.C c) * t) * Polynomial.X := by
      calc
        e p * Polynomial.X = (Polynomial.C a * Polynomial.X - Polynomial.C c) * (-h) := hrel
        _ = (Polynomial.C a * Polynomial.X - Polynomial.C c) * (Polynomial.X * t) := by
          rw [ht]
        _ = ((Polynomial.C a * Polynomial.X - Polynomial.C c) * t) * Polynomial.X := by
          ring
    have hzero :
        (e p - (Polynomial.C a * Polynomial.X - Polynomial.C c) * t) *
            Polynomial.X = 0 := by
      rw [sub_mul, hrel2, sub_self]
    exact sub_eq_zero.mp
      (Polynomial.mul_X_pow_eq_zero (n := 1) (by simpa [pow_one] using hzero))
  rw [quasiRegularCounterexampleTruncatedHypersurfaceIdeal]
  rw [Ideal.mem_span_singleton']
  refine ⟨e.symm (-t), ?_⟩
  apply e.injective
  calc
    e (e.symm (-t) * (X y ^ (N + 2) * X (z N) - X w * X x)) =
        (-t) * e G := by
      simp [e, G]
    _ = e p := by
      rw [hG, hcancel]
      ring

