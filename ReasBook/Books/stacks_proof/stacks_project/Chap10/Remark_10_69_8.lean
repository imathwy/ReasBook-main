/-- Helper for Chap10 Remark 10 69 8: the degree-one pair witness maps to zero in the associated
graded module because `w x` already lies in `(x, y)^2`. -/
theorem quasiRegularCounterexamplePairSourceWitness_mapsToZero :
    quasiRegularSequenceAssociatedGradedMap (quasiRegularCounterexampleRing k)
      [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]
      ((Submodule.Quotient.mk (p :=
          (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] •
            (⊤ : Submodule (quasiRegularCounterexampleRing k)
              (quasiRegularCounterexampleRing k))))
          (quasiRegularCounterexampleW k)) ⊗ₜ[
            quasiRegularCounterexampleRing k ⧸
              Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]]
        MvPolynomial.monomial quasiRegularCounterexamplePairXExponent
          (1 : quasiRegularCounterexampleRing k ⧸
            Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])) = 0 := by
  -- Compute the comparison map on the pure monomial witness; the remaining goal is the
  -- homogeneous class of `x * w` in degree one.
  rw [quasiRegularSourceMonomialImage]
  simp only [List.length_cons, List.length_nil, Nat.reduceAdd, smul_eq_mul,
    List.get_eq_getElem, Fin.prod_univ_two, Fin.isValue, Fin.coe_ofNat_eq_mod, Nat.zero_mod,
    List.getElem_cons_zero, Finsupp.single_eq_same, pow_one, Nat.mod_succ,
    List.getElem_cons_succ, ne_eq, one_ne_zero, not_false_eq_true, Finsupp.single_eq_of_ne,
    pow_zero, mul_one]
  -- Since `x * w` is already in the next filtration stage, its degree-one quotient class is zero;
  -- applying `DirectSum.lof` to this zero class finishes the computation.
  have hpiece_zero :=
    associatedGradedPieceMkEqZeroOfMemNextStage
      (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
      (Finsupp.degree quasiRegularCounterexamplePairXExponent)
      (⟨quasiRegularCounterexampleX k * quasiRegularCounterexampleW k,
        quasiRegularCounterexample_x_mul_w_mem_pairDegreeOneStage k⟩ :
        idealAssociatedGradedStage
          (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
          (quasiRegularCounterexampleRing k)
          (Finsupp.degree quasiRegularCounterexamplePairXExponent))
      (quasiRegularCounterexample_x_mul_w_mem_pairDegreeTwoStage k)
  simpa [hpiece_zero]

/-- Helper for Remark 10.69.8: in a polynomial equation
`g * X = (C a * X - C c) * h` with `c ≠ 0` over a domain, the right factor is already divisible by
`X`. -/
theorem counterexample_truncated_hypersurface_X_dvd_of_relation
    {S : Type*} [CommRing S] [IsDomain S] {a c : S} {g h : Polynomial S}
    (hc : c ≠ 0)
    (hrel : g * Polynomial.X = (Polynomial.C a * Polynomial.X - Polynomial.C c) * h) :
    Polynomial.X ∣ h := by
  -- Compare constant coefficients. The left-hand side has constant coefficient zero, while the
  -- right-hand side contributes `-(c * h.coeff 0)`.
  have hcoeff := congrArg (fun p : Polynomial S ↦ p.coeff 0) hrel
  have hmul_zero : c * h.coeff 0 = 0 := by
    apply neg_eq_zero.mp
    simpa [sub_mul, Polynomial.coeff_C_mul, Polynomial.coeff_mul_X_zero] using hcoeff.symm
  have hcoeff_zero : h.coeff 0 = 0 := by
    rcases mul_eq_zero.mp hmul_zero with hzero | hzero
    · exact (hc hzero).elim
    · exact hzero
  exact Polynomial.X_dvd_iff.mpr hcoeff_zero

/-- Helper for Chap10 Remark 10 69 8: the ideal generated by the initial relation and only the
first `N` recurrence relations. -/
def quasiRegularCounterexampleFiniteRelationIdeal (N : ℕ) :
    Ideal (quasiRegularCounterexamplePolynomialRing k) :=
  Ideal.span
    ({quasiRegularCounterexampleInitialRelation k} ∪
      {f | ∃ n : ℕ, n < N ∧ f = quasiRegularCounterexampleRecurrenceRelation k n})

omit [Field k] in
/-- Helper for Chap10 Remark 10 69 8: every finite truncation of the defining relations is
contained in the full defining ideal. -/
theorem quasiRegularCounterexampleFiniteRelationIdeal_le_ideal (N : ℕ) :
    quasiRegularCounterexampleFiniteRelationIdeal k N ≤
      quasiRegularCounterexampleIdeal k := by
  -- Each finite generator is one of the generators of the full infinite presentation.
  rw [quasiRegularCounterexampleFiniteRelationIdeal, quasiRegularCounterexampleIdeal,
    Ideal.span_le]
  intro f hf
  rcases hf with hinit | hrec
  · rw [Set.mem_singleton_iff.mp hinit]
    exact Ideal.subset_span (Or.inl rfl)
  · rcases hrec with ⟨n, _hn, rfl⟩
    exact Ideal.subset_span (Or.inr ⟨n, rfl⟩)

end

/-- Helper for Chap10 Remark 10 69 8: the hypersurface ideal obtained after eliminating the first
`N` recurrence variables. -/
def quasiRegularCounterexampleTruncatedHypersurfaceIdeal (N : ℕ) :
    Ideal (quasiRegularCounterexamplePolynomialRing k) :=
  Ideal.span
    ({X y ^ (N + 2) * X (z N) - X w * X x} :
      Set (quasiRegularCounterexamplePolynomialRing k))

/-- Helper for Chap10 Remark 10 69 8: normalize the first `N` recurrence variables by sending
`z_i` for `i < N` to `y^(N-i) z_N`. -/
def quasiRegularCounterexampleTruncationNormalize (N : ℕ) :
    quasiRegularCounterexamplePolynomialRing k →+* quasiRegularCounterexamplePolynomialRing k :=
  MvPolynomial.eval₂Hom C
    (fun v ↦
      match v with
      | x => X x
      | y => X y
      | w => X w
      | z n => if n < N then X y ^ (N - n) * X (z N) else X (z n))

/-- Helper for Chap10 Remark 10 69 8: the truncation normalizer fixes `x`. -/
@[simp] theorem quasiRegularCounterexampleTruncationNormalize_X_x (N : ℕ) :
    quasiRegularCounterexampleTruncationNormalize k N
        (X x : quasiRegularCounterexamplePolynomialRing k) =
      X x := by
  -- This is the variable computation for the normalizer.
  simp [quasiRegularCounterexampleTruncationNormalize]

/-- Helper for Chap10 Remark 10 69 8: the truncation normalizer fixes `y`. -/
@[simp] theorem quasiRegularCounterexampleTruncationNormalize_X_y (N : ℕ) :
    quasiRegularCounterexampleTruncationNormalize k N
        (X y : quasiRegularCounterexamplePolynomialRing k) =
      X y := by
  -- This is the variable computation for the normalizer.
  simp [quasiRegularCounterexampleTruncationNormalize]

/-- Helper for Chap10 Remark 10 69 8: the truncation normalizer fixes `w`. -/
@[simp] theorem quasiRegularCounterexampleTruncationNormalize_X_w (N : ℕ) :
    quasiRegularCounterexampleTruncationNormalize k N
        (X w : quasiRegularCounterexamplePolynomialRing k) =
      X w := by
  -- This is the variable computation for the normalizer.
  simp [quasiRegularCounterexampleTruncationNormalize]

/-- Helper for Chap10 Remark 10 69 8: below the cutoff, `z_i` is rewritten as `y^(N-i) z_N`. -/
@[simp] theorem quasiRegularCounterexampleTruncationNormalize_X_z_of_lt
    {N n : ℕ} (hn : n < N) :
    quasiRegularCounterexampleTruncationNormalize k N
        (X (z n) : quasiRegularCounterexamplePolynomialRing k) =
      X y ^ (N - n) * X (z N) := by
  -- The `if` branch in the normalizer is selected by the cutoff inequality.
  simp [quasiRegularCounterexampleTruncationNormalize, hn]

/-- Helper for Chap10 Remark 10 69 8: at and above the cutoff, `z_i` is unchanged. -/
@[simp] theorem quasiRegularCounterexampleTruncationNormalize_X_z_of_not_lt
    {N n : ℕ} (hn : ¬ n < N) :
    quasiRegularCounterexampleTruncationNormalize k N
        (X (z n) : quasiRegularCounterexamplePolynomialRing k) =
      X (z n) := by
  -- The `if` branch in the normalizer is selected by the cutoff inequality.
  simp [quasiRegularCounterexampleTruncationNormalize, hn]

/-- Helper for Chap10 Remark 10 69 8: every recurrence relation below the cutoff normalizes to
zero. -/
theorem quasiRegularCounterexampleTruncationNormalize_recurrence_of_lt
    {N n : ℕ} (hn : n < N) :
    quasiRegularCounterexampleTruncationNormalize k N
        (quasiRegularCounterexampleRecurrenceRelation k n) = 0 := by
  -- Split according to whether the next `z`-variable is still below the cutoff; both branches are
  -- the same monomial after the elementary exponent arithmetic.
  by_cases hsucc : n + 1 < N
  · have hpow : N - n = (N - (n + 1)) + 1 := by omega
    simp [quasiRegularCounterexampleRecurrenceRelation,
      quasiRegularCounterexampleTruncationNormalize_X_z_of_lt (k := k) hn,
      quasiRegularCounterexampleTruncationNormalize_X_z_of_lt (k := k) hsucc, hpow, pow_succ]
    ring
  · have hcut : n + 1 = N := by omega
    subst hcut
    simp [quasiRegularCounterexampleRecurrenceRelation,
      quasiRegularCounterexampleTruncationNormalize_X_z_of_lt (k := k) hn,
      quasiRegularCounterexampleTruncationNormalize_X_z_of_not_lt (k := k)
        (by omega : ¬ n + 1 < n + 1)]

/-- Helper for Chap10 Remark 10 69 8: the initial relation normalizes to the truncated
hypersurface generator. -/
theorem quasiRegularCounterexampleTruncationNormalize_initial (N : ℕ) :
    quasiRegularCounterexampleTruncationNormalize k N
        (quasiRegularCounterexampleInitialRelation k) =
      X y ^ (N + 2) * X (z N) - X w * X x := by
  -- For positive `N`, `z_0` is rewritten as `y^N z_N`; for `N = 0`, the formula is unchanged.
  by_cases h0 : 0 < N
  · simp [quasiRegularCounterexampleInitialRelation,
      quasiRegularCounterexampleTruncationNormalize_X_z_of_lt (k := k) h0, pow_add, mul_assoc]
    ring
  · have hN : N = 0 := by omega
    subst hN
    simp [quasiRegularCounterexampleInitialRelation,
      quasiRegularCounterexampleTruncationNormalize_X_z_of_not_lt (k := k)
        (by omega : ¬ 0 < 0)]

/-- Helper for Chap10 Remark 10 69 8: normalizing a finite truncation lands in the single
hypersurface ideal. -/
theorem quasiRegularCounterexampleFiniteRelationIdeal_normalize_le_hypersurface (N : ℕ) :
    Ideal.map (quasiRegularCounterexampleTruncationNormalize k N)
        (quasiRegularCounterexampleFiniteRelationIdeal k N) ≤
      quasiRegularCounterexampleTruncatedHypersurfaceIdeal k N := by
  -- Check the finite presentation generators: the initial relation maps to the hypersurface
  -- generator and every included recurrence maps to zero.
  rw [quasiRegularCounterexampleFiniteRelationIdeal,
    quasiRegularCounterexampleTruncatedHypersurfaceIdeal, Ideal.map_span, Ideal.span_le]
  rintro q ⟨g, hg, rfl⟩
  rcases hg with hinit | hrec
  · rw [Set.mem_singleton_iff.mp hinit,
      quasiRegularCounterexampleTruncationNormalize_initial]
    exact Ideal.subset_span rfl
  · rcases hrec with ⟨n, hn, rfl⟩
    rw [quasiRegularCounterexampleTruncationNormalize_recurrence_of_lt (k := k) hn]
    exact Ideal.zero_mem _

/-- Helper for Chap10 Remark 10 69 8: any element in a finite truncation normalizes into the
truncated hypersurface ideal. -/
theorem quasiRegularCounterexample_normalize_mem_hypersurface_of_mem_finiteRelationIdeal
    {N : ℕ} {p : quasiRegularCounterexamplePolynomialRing k}
    (hp : p ∈ quasiRegularCounterexampleFiniteRelationIdeal k N) :
    quasiRegularCounterexampleTruncationNormalize k N p ∈
      quasiRegularCounterexampleTruncatedHypersurfaceIdeal k N := by
  -- Push membership forward along the normalizer and then use the generator computation above.
  exact quasiRegularCounterexampleFiniteRelationIdeal_normalize_le_hypersurface k N
    (Ideal.mem_map_of_mem (quasiRegularCounterexampleTruncationNormalize k N) hp)

/-- Helper for Chap10 Remark 10 69 8: below a finite cutoff, `z_n` is congruent to
`y^(N-n) z_N` modulo the finite recurrence ideal. -/
theorem quasiRegularCounterexampleFiniteRelationIdeal_z_sub_pow_z_mem
    {N n : ℕ} (hn : n ≤ N) :
    (X (z n) : quasiRegularCounterexamplePolynomialRing k) -
        X y ^ (N - n) * X (z N) ∈
      quasiRegularCounterexampleFiniteRelationIdeal k N := by
  -- Descend along the finite recurrence chain; each step replaces `z_i` by `y z_{i+1}`.
  have hmain :
      ∀ d n N,
        N - n = d →
        n ≤ N →
        (X (z n) : quasiRegularCounterexamplePolynomialRing k) -
            X y ^ (N - n) * X (z N) ∈
          quasiRegularCounterexampleFiniteRelationIdeal k N := by
    intro d
    induction d with
    | zero =>
        intro n N hdiff hn
        have hN : n = N := by omega
        subst hN
        simp
    | succ d ih =>
        intro n N hdiff hn
        have hnlt : n < N := by omega
        have hsucc_le : n + 1 ≤ N := by omega
        have hdiff_succ : N - (n + 1) = d := by omega
        have hpow : N - n = (N - (n + 1)) + 1 := by omega
        have hrec :
            quasiRegularCounterexampleRecurrenceRelation k n ∈
              quasiRegularCounterexampleFiniteRelationIdeal k N := by
          exact Ideal.subset_span (Or.inr ⟨n, hnlt, rfl⟩)
        have htail :
            (X (z (n + 1)) : quasiRegularCounterexamplePolynomialRing k) -
                X y ^ (N - (n + 1)) * X (z N) ∈
              quasiRegularCounterexampleFiniteRelationIdeal k N :=
          ih (n + 1) N hdiff_succ hsucc_le
        have hsum :
            quasiRegularCounterexampleRecurrenceRelation k n +
                X y *
                  ((X (z (n + 1)) : quasiRegularCounterexamplePolynomialRing k) -
                    X y ^ (N - (n + 1)) * X (z N)) ∈
            quasiRegularCounterexampleFiniteRelationIdeal k N :=
          Ideal.add_mem _ hrec (Ideal.mul_mem_left _ _ htail)
        -- The algebraic sum is exactly the desired telescoping difference.
        have hsum_eq :
            quasiRegularCounterexampleRecurrenceRelation k n +
                X y *
                  ((X (z (n + 1)) : quasiRegularCounterexamplePolynomialRing k) -
                    X y ^ (N - (n + 1)) * X (z N)) =
              (X (z n) : quasiRegularCounterexamplePolynomialRing k) -
                X y ^ (N - n) * X (z N) := by
          simp [quasiRegularCounterexampleRecurrenceRelation, hpow, pow_succ]
          ring
        rwa [hsum_eq] at hsum
  exact hmain (N - n) n N rfl hn

/-- Helper for Chap10 Remark 10 69 8: truncation normalization is the identity modulo the finite
relation ideal. -/
theorem quasiRegularCounterexampleFiniteRelationIdeal_sub_normalize_mem
    (N : ℕ) (p : quasiRegularCounterexamplePolynomialRing k) :
    p - quasiRegularCounterexampleTruncationNormalize k N p ∈
      quasiRegularCounterexampleFiniteRelationIdeal k N := by
  -- It suffices to compare the quotient maps on variables; only the `z_i` below the cutoff use
  -- the telescoping congruence.
  let I := quasiRegularCounterexampleFiniteRelationIdeal k N
  let q : quasiRegularCounterexamplePolynomialRing k →+* _ := Ideal.Quotient.mk I
  have hhom :
      q = q.comp (quasiRegularCounterexampleTruncationNormalize k N) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [q, quasiRegularCounterexampleTruncationNormalize]
    · intro v
      cases v with
      | x =>
          simp [q]
      | y =>
          simp [q]
      | w =>
          simp [q]
      | z n =>
          by_cases hn : n < N
          · have hmem :
                (X (z n) : quasiRegularCounterexamplePolynomialRing k) -
                    X y ^ (N - n) * X (z N) ∈ I :=
              quasiRegularCounterexampleFiniteRelationIdeal_z_sub_pow_z_mem (k := k)
                (N := N) (n := n) (Nat.le_of_lt hn)
            have hquot :=
              (Ideal.Quotient.mk_eq_mk_iff_sub_mem
                (I := I)
                (X (z n) : quasiRegularCounterexamplePolynomialRing k)
                (X y ^ (N - n) * X (z N))).mpr hmem
            simpa [q, quasiRegularCounterexampleTruncationNormalize_X_z_of_lt
              (k := k) hn] using hquot
          · have hmem :
                (X (z n) : quasiRegularCounterexamplePolynomialRing k) -
                    X (z n) ∈ I := by simp
            simpa [q, quasiRegularCounterexampleTruncationNormalize_X_z_of_not_lt
              (k := k) hn] using
              (Ideal.Quotient.mk_eq_mk_iff_sub_mem
                (I := I)
                (X (z n) : quasiRegularCounterexamplePolynomialRing k)
                (X (z n) : quasiRegularCounterexamplePolynomialRing k)).mpr hmem
  have hpquot :
      q p = q (quasiRegularCounterexampleTruncationNormalize k N p) := by
    calc
      q p = (q.comp (quasiRegularCounterexampleTruncationNormalize k N)) p := by
        rw [← hhom]
      _ = q (quasiRegularCounterexampleTruncationNormalize k N p) := rfl
  exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem
    (I := I) p (quasiRegularCounterexampleTruncationNormalize k N p)).mp hpquot

/-- Helper for Chap10 Remark 10 69 8: the eliminated hypersurface relation is generated by the
finite initial relation and the finite recurrence chain. -/
theorem quasiRegularCounterexampleTruncatedHypersurfaceIdeal_le_finiteRelationIdeal
    (N : ℕ) :
    quasiRegularCounterexampleTruncatedHypersurfaceIdeal k N ≤
      quasiRegularCounterexampleFiniteRelationIdeal k N := by
  -- Subtract `y^2` times the telescoping congruence from the initial relation to recover the
  -- single hypersurface generator.
  rw [quasiRegularCounterexampleTruncatedHypersurfaceIdeal]
  refine Ideal.span_le.mpr ?_
  intro f hf
  rw [Set.mem_singleton_iff] at hf
  subst f
  have hinit :
      quasiRegularCounterexampleInitialRelation k ∈
        quasiRegularCounterexampleFiniteRelationIdeal k N := by
    exact Ideal.subset_span (Or.inl rfl)
  have htel :
      (X (z 0) : quasiRegularCounterexamplePolynomialRing k) -
          X y ^ N * X (z N) ∈
        quasiRegularCounterexampleFiniteRelationIdeal k N := by
    simpa using
      quasiRegularCounterexampleFiniteRelationIdeal_z_sub_pow_z_mem (k := k)
        (N := N) (n := 0) (Nat.zero_le N)
  have hscaled :
      X y ^ 2 *
          ((X (z 0) : quasiRegularCounterexamplePolynomialRing k) -
            X y ^ N * X (z N)) ∈
        quasiRegularCounterexampleFiniteRelationIdeal k N :=
    Ideal.mul_mem_left _ _ htel
  have hsub :
      quasiRegularCounterexampleInitialRelation k -
          X y ^ 2 *
            ((X (z 0) : quasiRegularCounterexamplePolynomialRing k) -
              X y ^ N * X (z N)) ∈
        quasiRegularCounterexampleFiniteRelationIdeal k N :=
    Ideal.sub_mem _ hinit hscaled
  -- The difference just computed is the displayed hypersurface generator.
  have hsub_eq :
      quasiRegularCounterexampleInitialRelation k -
          X y ^ 2 *
            ((X (z 0) : quasiRegularCounterexamplePolynomialRing k) -
              X y ^ N * X (z N)) =
        X y ^ (N + 2) * X (z N) - X w * X x := by
    simp [quasiRegularCounterexampleInitialRelation, pow_add]
    ring
  rwa [hsub_eq] at hsub

/-- Helper for Chap10 Remark 10 69 8: every full ideal membership uses only finitely many
recurrence relations. -/
theorem quasiRegularCounterexampleIdeal_mem_finiteRelationIdeal
    {p : quasiRegularCounterexamplePolynomialRing k}
    (hp : p ∈ quasiRegularCounterexampleIdeal k) :
    ∃ N, p ∈ quasiRegularCounterexampleFiniteRelationIdeal k N := by
  classical
  -- Extract a finite set of relation generators from the span certificate.
  rw [quasiRegularCounterexampleIdeal] at hp
  obtain ⟨T, hTsub, hpT⟩ := Submodule.mem_span_finite_of_mem_span hp
  let idx : T → ℕ := fun a ↦
    if h : ∃ n, a.1 = quasiRegularCounterexampleRecurrenceRelation k n then
      Nat.succ (Classical.choose h)
    else
      0
  let N : ℕ := T.attach.sup idx
  refine ⟨N, ?_⟩
  have hsubset :
      (↑T : Set (quasiRegularCounterexamplePolynomialRing k)) ⊆
        ({quasiRegularCounterexampleInitialRelation k} ∪
          {f | ∃ n : ℕ, n < N ∧ f = quasiRegularCounterexampleRecurrenceRelation k n}) := by
    intro f hfT
    have hfrel : f ∈ quasiRegularCounterexampleRelations k := hTsub hfT
    rcases hfrel with hinit | hrange
    · exact Or.inl hinit
    · right
      have hexists : ∃ n, f = quasiRegularCounterexampleRecurrenceRelation k n := by
        rcases hrange with ⟨n, hn⟩
        exact ⟨n, hn.symm⟩
      refine ⟨Classical.choose hexists, ?_, Classical.choose_spec hexists⟩
      have hmem_attach : (⟨f, hfT⟩ : T) ∈ T.attach := by simp
      have hle : idx (⟨f, hfT⟩ : T) ≤ N := by
        exact Finset.le_sup hmem_attach
      have hidx :
          idx (⟨f, hfT⟩ : T) = Nat.succ (Classical.choose hexists) := by
        simp [idx, hexists]
      omega
  exact (Ideal.span_mono hsubset) hpT

/-- Helper for Chap10 Remark 10 69 8: the ambient polynomial variable `x`, fixed outside the
field-only section so later field proofs use the same polynomial-ring instance. -/
abbrev quasiRegularCounterexamplePolynomialX :
    quasiRegularCounterexamplePolynomialRing k :=
  X x

/-- Helper for Chap10 Remark 10 69 8: the variable `y` is not the distinguished variable `x`. -/
theorem quasiRegularCounterexampleVar_y_ne_x : y ≠ x := by
  -- The constructors of the counterexample variable type are distinct.
  decide

/-- Helper for Chap10 Remark 10 69 8: the variable `w` is not the distinguished variable `x`. -/
theorem quasiRegularCounterexampleVar_w_ne_x : w ≠ x := by
  -- The constructors of the counterexample variable type are distinct.
  decide

/-- Helper for Chap10 Remark 10 69 8: no `z_n` variable is the distinguished variable `x`. -/
theorem quasiRegularCounterexampleVar_z_ne_x (N : ℕ) : z N ≠ x := by
  -- The constructors of the counterexample variable type are distinct.
  intro h
  cases h

/-- Helper for Chap10 Remark 10 69 8: the variables other than `x`, used as coefficients when
separating the polynomial variable `x`. -/
abbrev quasiRegularCounterexampleVarWithoutX :=
  {v : QuasiRegularCounterexampleVar // v ≠ x}

/-- Helper for Chap10 Remark 10 69 8: the coefficient-side copy of `y`. -/
abbrev quasiRegularCounterexampleVarWithoutX_y :
    quasiRegularCounterexampleVarWithoutX :=
  ⟨y, quasiRegularCounterexampleVar_y_ne_x⟩

/-- Helper for Chap10 Remark 10 69 8: the coefficient-side copy of `w`. -/
abbrev quasiRegularCounterexampleVarWithoutX_w :
    quasiRegularCounterexampleVarWithoutX :=
  ⟨w, quasiRegularCounterexampleVar_w_ne_x⟩

/-- Helper for Chap10 Remark 10 69 8: the coefficient-side copy of `z_N`. -/
abbrev quasiRegularCounterexampleVarWithoutX_z (N : ℕ) :
    quasiRegularCounterexampleVarWithoutX :=
  ⟨z N, quasiRegularCounterexampleVar_z_ne_x N⟩

/-- Helper for Chap10 Remark 10 69 8: view the ambient polynomial ring as a polynomial ring in
`x` over the variables different from `x`. -/
noncomputable def quasiRegularCounterexampleXPolynomialEquiv :
    quasiRegularCounterexamplePolynomialRing k ≃ₐ[k]
      Polynomial (MvPolynomial quasiRegularCounterexampleVarWithoutX k) :=
  (MvPolynomial.renameEquiv k (Equiv.optionSubtypeNe x).symm).trans
    (MvPolynomial.optionEquivLeft k quasiRegularCounterexampleVarWithoutX)

/-- Helper for Chap10 Remark 10 69 8: multiplying by a monomial with unit coefficient in an
`MvPolynomial` ring is injective. -/
theorem mvPolynomial_monomial_unit_mul_eq_zero
    {σ : Type*} {R : Type*} [CommSemiring R] (s : σ →₀ ℕ) {r : R} (hr : IsUnit r)
    {p : MvPolynomial σ R} (hp : MvPolynomial.monomial s r * p = 0) :
    p = 0 := by
  -- Read the coefficient at `s + m`; multiplication by the monomial just shifts coefficients.
  ext m
  have hcoeff := congrArg (MvPolynomial.coeff (s + m)) hp
  have hmul : r * p.coeff m = 0 := by
    simpa [MvPolynomial.coeff_monomial_mul] using hcoeff
  -- A unit coefficient can be cancelled in the coefficient ring.
  rcases hr with ⟨u, rfl⟩
  calc
    p.coeff m = (1 : R) * p.coeff m := by rw [one_mul]
    _ = (↑u⁻¹ * ↑u) * p.coeff m := by rw [Units.inv_mul]
    _ = ↑u⁻¹ * (↑u * p.coeff m) := by rw [mul_assoc]
    _ = 0 := by rw [hmul, mul_zero]

