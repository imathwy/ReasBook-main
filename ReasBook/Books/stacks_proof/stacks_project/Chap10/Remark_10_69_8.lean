import Mathlib
import StacksProject_2024.Chap10.Definition_10_69_1

-- Declarations for this item will be appended below by the statement pipeline.

open MvPolynomial
open RingTheory.Sequence
open scoped nonZeroDivisors TensorProduct

universe u

/-
Domain triage:
* primary domain: quasi-regular sequences in commutative algebra, expressed through an explicit
  quotient-ring counterexample;
* sampled owner API:
  `RingTheory.Sequence.IsQuasiRegular`,
  `RingTheory.Sequence.IsQuasiRegularSequence`,
  `nonZeroDivisors`,
  `Ideal.Quotient.mk`;
* core/canonical owner abstractions: the quotient-ring construction `R ⧸ I` for the counterexample
  ring and the sequence predicate `IsQuasiRegularSequence`;
* primitive vs derived split: the ambient polynomial ring, the defining relations, and the ideal
  they generate are primitive data, while the classes of `x` and `y` and the quotient-by-`(x)`
  viewpoint are derived source-facing API.
-/

/-- Variables for the quasi-regular counterexample ring. -/
inductive QuasiRegularCounterexampleVar
  | x | y | w | z (n : ℕ)
  deriving DecidableEq

open QuasiRegularCounterexampleVar

noncomputable section

variable (k : Type u) [CommRing k]

/-- The ambient polynomial ring for the quasi-regular counterexample. -/
abbrev quasiRegularCounterexamplePolynomialRing :=
  MvPolynomial QuasiRegularCounterexampleVar k

/-- The exceptional relation `y^2 z_0 - wx`. -/
def quasiRegularCounterexampleInitialRelation : quasiRegularCounterexamplePolynomialRing k :=
  X y ^ 2 * X (z 0) - X w * X x

/-- The recursive relation `z_n - y z_{n+1}`. -/
def quasiRegularCounterexampleRecurrenceRelation (n : ℕ) :
    quasiRegularCounterexamplePolynomialRing k :=
  X (z n) - X y * X (z (n + 1))

/-- The family of defining relations for the counterexample ring. -/
def quasiRegularCounterexampleRelations : Set (quasiRegularCounterexamplePolynomialRing k) :=
  {quasiRegularCounterexampleInitialRelation k} ∪
    Set.range (quasiRegularCounterexampleRecurrenceRelation k)

/-- The defining ideal generated by `y^2 z_0 - wx` and the relations `z_n - y z_{n+1}`. -/
def quasiRegularCounterexampleIdeal : Ideal (quasiRegularCounterexamplePolynomialRing k) :=
  Ideal.span (quasiRegularCounterexampleRelations k)

/-- The quotient ring used for the quasi-regular counterexample. -/
abbrev quasiRegularCounterexampleRing :=
  quasiRegularCounterexamplePolynomialRing k ⧸ quasiRegularCounterexampleIdeal k

/-- Helper for Chap10 Remark 10 69 8: use the canonical self-module structure on the
counterexample ring when forming associated graded modules over the regular module. -/
local instance quasiRegularCounterexampleRingSelfModule :
    Module (quasiRegularCounterexampleRing k) (quasiRegularCounterexampleRing k) :=
  Semiring.toModule

/-- The image of the variable `x` in the counterexample ring. -/
abbrev quasiRegularCounterexampleX : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X x : quasiRegularCounterexamplePolynomialRing k)

/-- The image of the variable `y` in the counterexample ring. -/
abbrev quasiRegularCounterexampleY : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X y : quasiRegularCounterexamplePolynomialRing k)

/-- The image of the variable `w` in the counterexample ring. -/
abbrev quasiRegularCounterexampleW : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X w : quasiRegularCounterexamplePolynomialRing k)

/-- The image of the variable `z_n` in the counterexample ring. -/
abbrev quasiRegularCounterexampleZ (n : ℕ) : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X (z n) : quasiRegularCounterexamplePolynomialRing k)

/-- The principal ideal `(x)` in the counterexample ring. -/
def quasiRegularCounterexampleXIdeal : Ideal (quasiRegularCounterexampleRing k) :=
  Ideal.span ({quasiRegularCounterexampleX k} : Set (quasiRegularCounterexampleRing k))

/-- The image of `y` in the quotient of the counterexample ring by `(x)`. -/
abbrev quasiRegularCounterexampleYModX :
    quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k) (quasiRegularCounterexampleY k)

/-- Helper for Chap10 Remark 10 69 8: use the canonical self-module structure on `A / (x)` when
forming tensor products over that quotient ring. -/
local instance quasiRegularCounterexampleXQuotientSelfModule :
    Module (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k)
      (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k) :=
  Semiring.toModule

/-- Helper for Chap10 Remark 10 69 8: scalar multiplication of a monomial with coefficient `1`
only changes the coefficient. -/
theorem smul_monomial_one {σ : Type*} {S : Type*} [CommSemiring S]
    (a : S) (e : σ →₀ ℕ) :
    a • MvPolynomial.monomial e (1 : S) = MvPolynomial.monomial e a := by
  -- Coefficients determine multivariate polynomials, and each coefficient is an immediate
  -- monomial calculation after the scalar action is pushed to coefficients.
  classical
  ext d
  rw [MvPolynomial.coeff_smul]
  rw [MvPolynomial.coeff_monomial, MvPolynomial.coeff_monomial]
  by_cases h : e = d
  · simp [h]
  · simp [h]

/-- Helper for Chap10 Remark 10 69 8: for the regular module over a commutative ring, `I • ⊤`
is the submodule underlying the ideal `I`. -/
theorem regularModuleIdeal_smul_top_eq {A : Type*} [CommRing A] (I : Ideal A) :
    (I • (⊤ : Submodule A A)) = (I : Submodule A A) := by
  -- Use the canonical mathlib comparison between ideal multiplication on the regular module and
  -- the mapped ideal submodule.
  simpa using (Ideal.smul_top_eq_map (R := A) (S := A) I)

/-- Helper for Remark 10.69.8: for the regular module, quotienting by `(x)` is already the
ordinary quotient ring `A / (x)`. -/
noncomputable def quasiRegularCounterexampleXModuleQuotientEquiv :
    (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k) ≃ₗ[
      quasiRegularCounterexampleRing k]
      quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k :=
  LinearEquiv.refl _ _

/-- Helper for Remark 10.69.8: the identity quotient equivalence on `A / (x)` fixes represented
classes. -/
@[simp] theorem quasiRegularCounterexampleXModuleQuotientEquiv_mk
    (a : quasiRegularCounterexampleRing k) :
    quasiRegularCounterexampleXModuleQuotientEquiv k
        (Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k) a) =
      Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k) a :=
  rfl

/-- Helper for Remark 10.69.8: for the regular module, quotienting by `(x, y)` is already the
ordinary residue ring `A / (x, y)`. -/
noncomputable def quasiRegularCounterexamplePairModuleQuotientEquiv :
    (quasiRegularCounterexampleRing k ⧸
      Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) ≃ₗ[
        quasiRegularCounterexampleRing k]
      quasiRegularCounterexampleRing k ⧸
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] :=
  LinearEquiv.refl _ _

/-- Helper for Remark 10.69.8: the identity quotient equivalence on `A / (x, y)` fixes represented
classes. -/
@[simp] theorem quasiRegularCounterexamplePairModuleQuotientEquiv_mk
    (a : quasiRegularCounterexampleRing k) :
    quasiRegularCounterexamplePairModuleQuotientEquiv k
        (Ideal.Quotient.mk
          (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) a) =
      Ideal.Quotient.mk
        (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) a :=
  rfl

/-- Helper for Chap10 Remark 10 69 8: use the canonical self-module structure on `A / (x, y)` when
forming tensor products over that residue ring. -/
local instance quasiRegularCounterexamplePairResidueSelfModule :
    Module
      (quasiRegularCounterexampleRing k ⧸
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
      (quasiRegularCounterexampleRing k ⧸
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) :=
  Semiring.toModule

/-- Helper for Remark 10.69.8: the singleton textbook source is the plain one-variable polynomial
ring over `A / (x)`. -/
noncomputable def quasiRegularCounterexampleXSourceEquiv :
    ((quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k)
        ⊗[quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k]
          MvPolynomial (Fin 1)
            (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k)) ≃ₗ[
              quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k]
      MvPolynomial (Fin 1)
        (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k) :=
  TensorProduct.lid
    (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k)
    (MvPolynomial (Fin 1)
      (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k))

/-- Helper for Remark 10.69.8: under the singleton source equivalence, a simple tensor with a
monomial polynomial becomes the corresponding ordinary monomial. -/
@[simp] theorem quasiRegularCounterexampleXSourceEquiv_tmul_monomial
    (a : quasiRegularCounterexampleRing k) (e : Fin 1 →₀ ℕ) :
    quasiRegularCounterexampleXSourceEquiv k
      ((Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k) a) ⊗ₜ[
          quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k]
        MvPolynomial.monomial e
          (1 : quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k)) =
      MvPolynomial.monomial e
        (Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k) a) := by
  -- The left tensor factor is the scalar coefficient, so `TensorProduct.lid` collapses the simple
  -- tensor to scalar multiplication on the polynomial ring.
  simp [quasiRegularCounterexampleXSourceEquiv, smul_monomial_one]

/-- Helper for Remark 10.69.8: the pair textbook source is the plain two-variable polynomial ring
over `A / (x, y)`. -/
noncomputable def quasiRegularCounterexamplePairSourceEquiv :
    ((quasiRegularCounterexampleRing k ⧸
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
        ⊗[quasiRegularCounterexampleRing k ⧸
            Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]]
          MvPolynomial (Fin 2)
            (quasiRegularCounterexampleRing k ⧸
              Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])) ≃ₗ[
                quasiRegularCounterexampleRing k ⧸
                  Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]]
      MvPolynomial (Fin 2)
        (quasiRegularCounterexampleRing k ⧸
          Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) :=
  TensorProduct.lid
    (quasiRegularCounterexampleRing k ⧸
      Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
    (MvPolynomial (Fin 2)
      (quasiRegularCounterexampleRing k ⧸
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]))

/-- Helper for Remark 10.69.8: under the pair source equivalence, a simple tensor with a monomial
polynomial becomes the corresponding ordinary monomial. -/
@[simp] theorem quasiRegularCounterexamplePairSourceEquiv_tmul_monomial
    (a : quasiRegularCounterexampleRing k) (e : Fin 2 →₀ ℕ) :
    quasiRegularCounterexamplePairSourceEquiv k
      ((Ideal.Quotient.mk
          (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) a) ⊗ₜ[
            quasiRegularCounterexampleRing k ⧸
              Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]]
        MvPolynomial.monomial e
          (1 : quasiRegularCounterexampleRing k ⧸
            Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])) =
      MvPolynomial.monomial e
        (Ideal.Quotient.mk
          (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) a) := by
  -- The left tensor factor is the scalar coefficient, so `TensorProduct.lid` collapses the simple
  -- tensor to scalar multiplication on the polynomial ring.
  simp [quasiRegularCounterexamplePairSourceEquiv, smul_monomial_one]

/-- Helper for Remark 10.69.8: the degree-one source exponent selecting the `x`-coordinate in the
pair `[x, y]`. -/
abbrev quasiRegularCounterexamplePairXExponent : Fin 2 →₀ ℕ :=
  Finsupp.single 0 1

/-- Helper for Remark 10.69.8: the source witness used to obstruct quasi-regularity of the pair
`(x, y)`. -/
def quasiRegularCounterexamplePairSourceWitness :
    (quasiRegularCounterexampleRing k ⧸
      Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) ⊗[
          quasiRegularCounterexampleRing k ⧸
            Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]]
      MvPolynomial (Fin 2)
        (quasiRegularCounterexampleRing k ⧸
          Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) :=
  -- Keep the witness at the textbook source level: coefficient `w̄` times the `x`-variable.
  (Ideal.Quotient.mk
      (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
      (quasiRegularCounterexampleW k)) ⊗ₜ[
      quasiRegularCounterexampleRing k ⧸
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]]
    (MvPolynomial.monomial (quasiRegularCounterexamplePairXExponent)
      (1 : quasiRegularCounterexampleRing k ⧸
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]))


/-- Helper for Chap10 Remark 10 69 8: the associated-graded comparison map sends a pure tensor
monomial to the corresponding homogeneous class. -/
theorem quasiRegularSourceMonomialImage
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    {rs : List A} (m : P) (e : Fin rs.length →₀ ℕ) :
    let J : Ideal A := Ideal.ofList rs
    quasiRegularSequenceAssociatedGradedMap P rs
      (((Submodule.Quotient.mk m : P ⧸ (J • (⊤ : Submodule A P))) ⊗ₜ[A ⧸ J]
        MvPolynomial.monomial e (1 : A ⧸ J))) =
      DirectSum.lof (A ⧸ J) ℕ (idealAssociatedGradedPiece J P) e.degree
        (Submodule.Quotient.mk
          (⟨(∏ i : Fin rs.length, rs.get i ^ e i) • m,
            by
              -- The monomial weight has total degree `e.degree`, so it lands in the matching stage.
              simpa [idealAssociatedGradedStage, quasiRegularAssociatedGradedMonomialWeight] using
                (quasiRegularAssociatedGradedMonomialWeight_smul_mem_of_totalDegree
                  (M := P) (rs := rs) (n := e.degree) e rfl m)⟩ :
            idealAssociatedGradedStage J P e.degree)) := by
  -- Route correction: reuse the public `10.69.0.1` source-commutation, auxiliary monomial-image,
  -- and direct-sum identification lemmas instead of rebuilding the transport chain locally.
  dsimp [quasiRegularSequenceAssociatedGradedMap]
  let z := quasiRegularAssociatedGradedInternalMonomialClass rs m e
  have hcomm :=
    quasiRegularSequenceAssociatedGradedSourceComm_tmul P rs m e
  have haux :=
    quasiRegularSequenceAssociatedGradedMapAux_tmul_monomial P rs m e
  have hlof :
      (quasiRegularAssociatedGradedAddEquiv rs P).symm
          (DirectSum.lof (A ⧸ Ideal.ofList rs) ℕ
            (quasiRegularAssociatedGradedInternalPiece rs P) e.degree z) =
        DirectSum.lof (A ⧸ Ideal.ofList rs) ℕ
          (idealAssociatedGradedPiece (Ideal.ofList rs) P) e.degree
          (quasiRegularAssociatedGradedInternalPieceEquiv rs P e.degree z) := by
    simpa using quasiRegularAssociatedGradedAddEquiv_lof P rs e.degree z
  have hpiece :=
    quasiRegularAssociatedGradedInternalPieceEquiv_monomialClass P rs m e
  rw [hcomm, haux, hlof, hpiece]
  rfl

/-- Helper for Chap10 Remark 10 69 8: a class in the degree-`n` associated graded piece vanishes
once its representative already lies in the next filtration stage. -/
  theorem associatedGradedPieceMkEqZeroOfMemNextStage
    {A : Type*} [CommRing A]
    {P : Type*} [AddCommGroup P] [Module A P]
    (I : Ideal A) (n : ℕ) (x : idealAssociatedGradedStage I P n)
    (hx : (x : P) ∈ idealAssociatedGradedStage I P (n + 1)) :
    (Submodule.Quotient.mk x : idealAssociatedGradedPiece I P n) = 0 := by
  -- Membership in the next stage is exactly the denominator condition for the quotient piece.
  rw [Submodule.Quotient.mk_eq_zero]
  simpa [idealAssociatedGradedPiece] using hx

/-- Helper for Remark 10.69.8: the initial defining relation belongs to the counterexample ideal.
-/
theorem quasiRegularCounterexampleInitialRelation_mem_ideal :
    quasiRegularCounterexampleInitialRelation k ∈ quasiRegularCounterexampleIdeal k := by
  -- The initial relation is one of the specified generators of the defining ideal.
  exact Ideal.subset_span (Or.inl rfl)

/-- Helper for Remark 10.69.8: each recurrence relation belongs to the counterexample ideal. -/
theorem quasiRegularCounterexampleRecurrenceRelation_mem_ideal (n : ℕ) :
    quasiRegularCounterexampleRecurrenceRelation k n ∈ quasiRegularCounterexampleIdeal k := by
  -- Every recurrence relation appears in the generating family by construction.
  exact Ideal.subset_span (Or.inr ⟨n, rfl⟩)

/-- Helper for Remark 10.69.8: in the quotient ring, the initial relation becomes
`y^2 z_0 = w x`. -/
theorem quasiRegularCounterexample_initial_relation :
    quasiRegularCounterexampleY k ^ 2 * quasiRegularCounterexampleZ k 0 =
      quasiRegularCounterexampleW k * quasiRegularCounterexampleX k := by
  -- The initial generator vanishes after passing to the quotient by the defining ideal.
  have hzero :
      Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
        (quasiRegularCounterexampleInitialRelation k) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (quasiRegularCounterexampleInitialRelation_mem_ideal k)
  exact sub_eq_zero.mp <| by
    simpa [quasiRegularCounterexampleInitialRelation, quasiRegularCounterexampleY,
      quasiRegularCounterexampleZ, quasiRegularCounterexampleW, quasiRegularCounterexampleX] using
      hzero

/-- Helper for Remark 10.69.8: in the quotient ring, the recurrence relation becomes
`z_n = y z_{n+1}`. -/
theorem quasiRegularCounterexample_recurrence_relation (n : ℕ) :
    quasiRegularCounterexampleZ k n =
      quasiRegularCounterexampleY k * quasiRegularCounterexampleZ k (n + 1) := by
  -- Each recurrence generator also vanishes in the quotient ring.
  have hzero :
      Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
        (quasiRegularCounterexampleRecurrenceRelation k n) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (quasiRegularCounterexampleRecurrenceRelation_mem_ideal k n)
  exact sub_eq_zero.mp <| by
    simpa [quasiRegularCounterexampleRecurrenceRelation, quasiRegularCounterexampleZ,
      quasiRegularCounterexampleY] using hzero

/-- Helper for Remark 10.69.8: every `z_n` already lies in the ideal generated by `y`. -/
theorem quasiRegularCounterexample_z_mem_span_y (n : ℕ) :
    quasiRegularCounterexampleZ k n ∈
      Ideal.span ({quasiRegularCounterexampleY k} : Set (quasiRegularCounterexampleRing k)) := by
  -- Rewrite `z_n` using the recurrence and then use closure of the principal ideal under
  -- multiplication.
  rw [quasiRegularCounterexample_recurrence_relation k n]
  exact Ideal.mul_mem_right
    (quasiRegularCounterexampleZ k (n + 1))
      (Ideal.span ({quasiRegularCounterexampleY k} :
        Set (quasiRegularCounterexampleRing k)))
    (Ideal.subset_span (by simp))

/-- Helper for Chap10 Remark 10 69 8: in the quotient by `(x)`, every `z_n` lies in every power
of the ideal generated by the image of `y`. -/
theorem quasiRegularCounterexample_z_modX_mem_y_power (n m : ℕ) :
    Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k) (quasiRegularCounterexampleZ k n) ∈
      (Ideal.span ({quasiRegularCounterexampleYModX k} :
        Set (quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k))) ^ m := by
  -- Induct on the desired power. The recurrence writes each `z_n` as `y * z_{n+1}`, giving one
  -- extra factor of the principal ideal at every step.
  induction m generalizing n with
  | zero =>
      simp
  | succ m ih =>
      have hrec :
          Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k)
              (quasiRegularCounterexampleZ k n) =
            quasiRegularCounterexampleYModX k *
              Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k)
                (quasiRegularCounterexampleZ k (n + 1)) := by
        simpa [quasiRegularCounterexampleYModX] using
          congrArg (Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k))
            (quasiRegularCounterexample_recurrence_relation k n)
      rw [hrec]
      have hy :
          quasiRegularCounterexampleYModX k ∈
            Ideal.span ({quasiRegularCounterexampleYModX k} :
              Set (quasiRegularCounterexampleRing k ⧸
                quasiRegularCounterexampleXIdeal k)) :=
        Ideal.subset_span (by simp)
      simpa [pow_succ'] using
        (Ideal.mul_mem_mul hy (ih (n + 1)) :
          quasiRegularCounterexampleYModX k *
              Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k)
                (quasiRegularCounterexampleZ k (n + 1)) ∈
            Ideal.span ({quasiRegularCounterexampleYModX k} :
              Set (quasiRegularCounterexampleRing k ⧸
                quasiRegularCounterexampleXIdeal k)) *
              (Ideal.span ({quasiRegularCounterexampleYModX k} :
                Set (quasiRegularCounterexampleRing k ⧸
                  quasiRegularCounterexampleXIdeal k))) ^ m)

/-- Helper for Remark 10.69.8: evaluation sending `w` to the polynomial variable and all other
counterexample generators to `0`. -/
def quasiRegularCounterexampleVarToPolynomial :
    QuasiRegularCounterexampleVar → Polynomial k
  | x => 0
  | y => 0
  | w => Polynomial.X
  | z _ => 0

/-- Helper for Remark 10.69.8: the polynomial evaluation used to detect the class of `w` modulo
`(x, y)`. -/
def quasiRegularCounterexamplePolynomialToW :
    quasiRegularCounterexamplePolynomialRing k →+* Polynomial k :=
  MvPolynomial.eval₂Hom Polynomial.C (quasiRegularCounterexampleVarToPolynomial k)

/-- Helper for Remark 10.69.8: the initial relation maps to zero under the `w`-detector
evaluation. -/
theorem quasiRegularCounterexamplePolynomialToW_initial_relation :
    quasiRegularCounterexamplePolynomialToW k
      (quasiRegularCounterexampleInitialRelation k) = 0 := by
  -- Every variable except `w` is killed by the evaluation, so both terms vanish.
  simp [quasiRegularCounterexamplePolynomialToW, quasiRegularCounterexampleVarToPolynomial,
    quasiRegularCounterexampleInitialRelation]

/-- Helper for Remark 10.69.8: every recurrence relation maps to zero under the `w`-detector
evaluation. -/
theorem quasiRegularCounterexamplePolynomialToW_recurrence_relation (n : ℕ) :
    quasiRegularCounterexamplePolynomialToW k
      (quasiRegularCounterexampleRecurrenceRelation k n) = 0 := by
  -- The recurrence only involves variables sent to zero by the evaluation.
  simp [quasiRegularCounterexamplePolynomialToW, quasiRegularCounterexampleVarToPolynomial,
    quasiRegularCounterexampleRecurrenceRelation]

/-- Helper for Remark 10.69.8: the defining ideal lies in the kernel of the `w`-detector
evaluation. -/
theorem quasiRegularCounterexampleIdeal_le_ker_polynomialToW :
    quasiRegularCounterexampleIdeal k ≤
      RingHom.ker (quasiRegularCounterexamplePolynomialToW k) := by
  -- Check the generators one by one and then use the universal property of the span.
  rw [quasiRegularCounterexampleIdeal, Ideal.span_le]
  intro f hf
  rcases hf with rfl | ⟨n, rfl⟩
  · simpa [RingHom.mem_ker] using
      quasiRegularCounterexamplePolynomialToW_initial_relation k
  · simpa [RingHom.mem_ker] using
      quasiRegularCounterexamplePolynomialToW_recurrence_relation k n

/-- Helper for Remark 10.69.8: the induced quotient map detecting the `w`-class in the residue
ring modulo `(x, y)`. -/
def quasiRegularCounterexampleResidueWMap :
    quasiRegularCounterexampleRing k →+* Polynomial k :=
  Ideal.Quotient.lift
    (quasiRegularCounterexampleIdeal k)
    (quasiRegularCounterexamplePolynomialToW k)
    (quasiRegularCounterexampleIdeal_le_ker_polynomialToW k)

/-- Helper for Remark 10.69.8: the residue `w`-detector kills the class of `x`. -/
theorem quasiRegularCounterexampleResidueWMap_x :
    quasiRegularCounterexampleResidueWMap k (quasiRegularCounterexampleX k) = 0 := by
  -- The defining evaluation sends `x` to zero already in the polynomial ring.
  simp [quasiRegularCounterexampleResidueWMap, quasiRegularCounterexamplePolynomialToW,
    quasiRegularCounterexampleVarToPolynomial, quasiRegularCounterexampleX]

/-- Helper for Remark 10.69.8: the residue `w`-detector kills the class of `y`. -/
theorem quasiRegularCounterexampleResidueWMap_y :
    quasiRegularCounterexampleResidueWMap k (quasiRegularCounterexampleY k) = 0 := by
  -- The defining evaluation sends `y` to zero already in the polynomial ring.
  simp [quasiRegularCounterexampleResidueWMap, quasiRegularCounterexamplePolynomialToW,
    quasiRegularCounterexampleVarToPolynomial, quasiRegularCounterexampleY]

/-- Helper for Remark 10.69.8: the residue `w`-detector sends the class of `w` to the polynomial
variable `X`. -/
theorem quasiRegularCounterexampleResidueWMap_w :
    quasiRegularCounterexampleResidueWMap k (quasiRegularCounterexampleW k) = Polynomial.X := by
  -- By construction, `w` is the unique variable seen by this evaluation.
  simp [quasiRegularCounterexampleResidueWMap, quasiRegularCounterexamplePolynomialToW,
    quasiRegularCounterexampleVarToPolynomial, quasiRegularCounterexampleW]

/-- Helper for Remark 10.69.8: the residue `w`-detector kills every `z_n`. -/
theorem quasiRegularCounterexampleResidueWMap_z (n : ℕ) :
    quasiRegularCounterexampleResidueWMap k (quasiRegularCounterexampleZ k n) = 0 := by
  -- All `z_n` are sent to zero by the defining evaluation.
  simp [quasiRegularCounterexampleResidueWMap, quasiRegularCounterexamplePolynomialToW,
    quasiRegularCounterexampleVarToPolynomial, quasiRegularCounterexampleZ]

section

variable [Field k]

/-- Helper for Remark 10.69.8: the class of `w` does not belong to the ideal generated by `x`
and `y`. -/
theorem quasiRegularCounterexampleW_not_mem_pairIdeal :
    quasiRegularCounterexampleW k ∉
      Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] := by
  -- The generators `x` and `y` are killed by the residue detector, so the whole pair ideal lies
  -- in its kernel.
  intro hw
  have hpair_le_ker :
      Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] ≤
        RingHom.ker (quasiRegularCounterexampleResidueWMap k) := by
    rw [Ideal.ofList_cons, Ideal.ofList_singleton]
    refine sup_le ?_ ?_
    · refine Ideal.span_le.mpr ?_
      intro r hr
      simp only [Set.mem_singleton_iff] at hr
      simp [RingHom.mem_ker, hr, quasiRegularCounterexampleResidueWMap_x]
    · refine Ideal.span_le.mpr ?_
      intro r hr
      simp only [Set.mem_singleton_iff] at hr
      simp [RingHom.mem_ker, hr, quasiRegularCounterexampleResidueWMap_y]
  have hwker :
      quasiRegularCounterexampleW k ∈ RingHom.ker (quasiRegularCounterexampleResidueWMap k) :=
    hpair_le_ker hw
  have hXzero : (Polynomial.X : Polynomial k) = 0 := by
    simpa [RingHom.mem_ker, quasiRegularCounterexampleResidueWMap_w] using hwker
  exact Polynomial.X_ne_zero hXzero

/-- Helper for Remark 10.69.8: the class of `w` stays nonzero after quotienting by `(x, y)`. -/
theorem quasiRegularCounterexampleW_mod_pair_ne_zero :
    Ideal.Quotient.mk
      (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
      (quasiRegularCounterexampleW k) ≠ 0 := by
  -- The residue class vanishes exactly when `w` already belongs to the pair ideal.
  intro hw
  exact quasiRegularCounterexampleW_not_mem_pairIdeal k
    (Ideal.Quotient.eq_zero_iff_mem.mp hw)

/-- Helper for Remark 10.69.8: the degree-one source witness for the pair obstruction is nonzero.
-/
theorem quasiRegularCounterexamplePairSourceWitness_ne_zero :
    quasiRegularCounterexamplePairSourceWitness k ≠ 0 := by
  -- After collapsing the source tensor, the witness becomes the ordinary monomial
  -- `X₀ * w̄`, and the `X₀`-coefficient detects its nonvanishing.
  intro hzero
  have hcollapsed_zero :
      quasiRegularCounterexamplePairSourceEquiv k (quasiRegularCounterexamplePairSourceWitness k) =
        0 := by
    -- Collapse the equality through the source equivalence before evaluating the monomial
    -- coefficient.
    exact (congrArg (quasiRegularCounterexamplePairSourceEquiv k) hzero).trans
      (quasiRegularCounterexamplePairSourceEquiv k).map_zero
  have hcollapsed_monomial :
      quasiRegularCounterexamplePairSourceEquiv k (quasiRegularCounterexamplePairSourceWitness k) =
        MvPolynomial.monomial (quasiRegularCounterexamplePairXExponent)
          (Ideal.Quotient.mk
            (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
            (quasiRegularCounterexampleW k)) := by
    -- Use the explicit tensor-source computation rather than simplifying the whole tensor term.
    exact quasiRegularCounterexamplePairSourceEquiv_tmul_monomial k
      (quasiRegularCounterexampleW k) quasiRegularCounterexamplePairXExponent
  have hmonomial :
      MvPolynomial.monomial (quasiRegularCounterexamplePairXExponent)
          (Ideal.Quotient.mk
            (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
            (quasiRegularCounterexampleW k)) = 0 := by
    -- The named tensor-source computation avoids asking typeclass search for nontriviality of the
    -- whole polynomial ring.
    exact hcollapsed_monomial.symm.trans hcollapsed_zero
  have hwzero :
      Ideal.Quotient.mk
          (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
          (quasiRegularCounterexampleW k) = 0 := by
    have hcoeff := congrArg
      (MvPolynomial.coeff (quasiRegularCounterexamplePairXExponent)) hmonomial
    simpa [quasiRegularCounterexamplePairXExponent] using hcoeff
  exact quasiRegularCounterexampleW_mod_pair_ne_zero k hwzero

omit [Field k] in
/-- Helper for Remark 10.69.8: the relation `w x = y^2 z_0` places `w x` in the square of the
ideal `(x, y)`. -/
theorem quasiRegularCounterexample_w_mul_x_mem_pairSquare :
    quasiRegularCounterexampleW k * quasiRegularCounterexampleX k ∈
      (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) ^ 2 := by
  -- Rewrite `w * x` using the defining relation, then place one factor `y` in each copy of the
  -- pair ideal.
  rw [← quasiRegularCounterexample_initial_relation k]
  have hy :
      quasiRegularCounterexampleY k ∈
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] := by
    exact Ideal.subset_span (by simp)
  have hyz :
      quasiRegularCounterexampleY k * quasiRegularCounterexampleZ k 0 ∈
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] := by
    simpa [mul_comm] using
      Ideal.mul_mem_right (quasiRegularCounterexampleZ k 0)
        (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) hy
  -- Route correction: keep the source proof's conormal obstruction by proving the concrete square
  -- containment `y^2 z_0 ∈ (x, y)^2` directly, instead of trying to bypass the pair ideal.
  simpa [pow_two, mul_assoc] using
    (Ideal.mul_mem_mul hy hyz :
      quasiRegularCounterexampleY k *
          (quasiRegularCounterexampleY k * quasiRegularCounterexampleZ k 0) ∈
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] *
          Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])

omit [Field k] in
/-- Helper for Chap10 Remark 10 69 8: the element `x * w` lies in the degree-one stage for the
pair ideal `(x, y)`. -/
theorem quasiRegularCounterexample_x_mul_w_mem_pairDegreeOneStage :
    quasiRegularCounterexampleX k * quasiRegularCounterexampleW k ∈
      idealAssociatedGradedStage
        (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
        (quasiRegularCounterexampleRing k)
        (Finsupp.degree quasiRegularCounterexamplePairXExponent) := by
  -- The `x`-factor puts the product in `(x, y)`, and the regular-module stage is just that ideal.
  have hx_gen :
      quasiRegularCounterexampleX k ∈
        ({r | r ∈ [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]} :
          Set (quasiRegularCounterexampleRing k)) := by
    simp
  have hx :
      quasiRegularCounterexampleX k ∈
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] :=
    Ideal.subset_span hx_gen
  have hxw :
      quasiRegularCounterexampleX k * quasiRegularCounterexampleW k ∈
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] := by
    simpa [pow_one] using
      Ideal.mul_mem_right (quasiRegularCounterexampleW k)
        (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) hx
  simpa [idealAssociatedGradedStage, quasiRegularCounterexamplePairXExponent,
    regularModuleIdeal_smul_top_eq, pow_one] using hxw

omit [Field k] in
/-- Helper for Chap10 Remark 10 69 8: the element `x * w` lies in the next stage `(x, y)^2`
for the degree-one pair witness. -/
theorem quasiRegularCounterexample_x_mul_w_mem_pairDegreeTwoStage :
    quasiRegularCounterexampleX k * quasiRegularCounterexampleW k ∈
      idealAssociatedGradedStage
        (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
        (quasiRegularCounterexampleRing k)
        (Finsupp.degree quasiRegularCounterexamplePairXExponent + 1) := by
  -- The defining relation gives `w * x ∈ (x, y)^2`; commute the factors and rewrite the regular
  -- module stage to the ideal itself.
  have hxw :
      quasiRegularCounterexampleX k * quasiRegularCounterexampleW k ∈
        (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) ^ 2 := by
    simpa [mul_comm] using quasiRegularCounterexample_w_mul_x_mem_pairSquare k
  simpa [idealAssociatedGradedStage, quasiRegularCounterexamplePairXExponent,
    regularModuleIdeal_smul_top_eq] using hxw

