import Mathlib
import StacksProject_2024.Chap10.Definition_10_70_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open MvPolynomial

section

variable (R : Type u) [CommRing R]
variable (n : ℕ)

local notation "P" => MvPolynomial (Fin n) R
local notation "S" => MvPolynomial (Fin n) P

local notation "Icoord" => idealOfVars (Fin n) R

/-- The relation `t_i T_j - t_j T_i` in `P[T_1, ..., T_n]`. -/
noncomputable def polynomialBlowupPresentationRelation (i j : Fin n) : S :=
  MvPolynomial.C (X i : P) * X j - MvPolynomial.C (X j : P) * X i

/-- The ideal generated by the relations `t_i T_j - t_j T_i`. -/
noncomputable def polynomialBlowupRelationIdeal : Ideal S :=
  Ideal.span (Set.range fun ij : Fin n × Fin n ↦
    polynomialBlowupPresentationRelation R n ij.1 ij.2)

local notation "J" => polynomialBlowupRelationIdeal R n

local notation "Q" => S ⧸ J

/-- The canonical `P`-algebra map sending `T_i` to the degree-one Rees generator `t_i^(1)`. -/
private noncomputable def presentationToRees : S →ₐ[P] reesAlgebra Icoord :=
  aeval fun i ↦ reesAlgebraDegreeOne Icoord
    ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩

/-- Each defining relation of the presentation maps to zero in the Rees algebra. -/
-- Proof sketch: evaluating sends both terms to the same degree-two monomial in `reesAlgebra Icoord`,
-- namely the monomial with coefficient `X i * X j`.
private theorem relation_toRees_eq_zero (i j : Fin n) :
    presentationToRees R n (polynomialBlowupPresentationRelation R n i j) = 0 := by
  -- Compare inside the ambient polynomial ring; both products give the same degree-one
  -- Rees monomial, with coefficients differing only by commutativity.
  apply Subtype.ext
  simp [presentationToRees, polynomialBlowupPresentationRelation, reesAlgebraDegreeOne,
    mul_comm]

/-- Helper for Chap10 Example 10 70 4: each displayed binomial relation belongs to the ideal
generated by all such relations. -/
private theorem presentationRelation_mem_relationIdeal (i j : Fin n) :
    polynomialBlowupPresentationRelation R n i j ∈ J := by
  -- The relation ideal is defined as the span of these indexed generators.
  rw [polynomialBlowupRelationIdeal]
  exact Ideal.subset_span ⟨(i, j), rfl⟩

/-- Helper for Chap10 Example 10 70 4: the relation ideal is contained in the kernel of the
canonical map to the Rees algebra. -/
private theorem polynomialBlowupRelationIdeal_le_presentationToRees_ker :
    J ≤ RingHom.ker (presentationToRees R n).toRingHom := by
  -- It is enough to show that every span generator maps to zero.
  rw [polynomialBlowupRelationIdeal]
  refine Ideal.span_le.mpr ?_
  rintro _ ⟨ij, rfl⟩
  exact relation_toRees_eq_zero R n ij.1 ij.2

/-- Every element of the relation ideal maps to zero under the canonical map to the Rees algebra. -/
-- Proof sketch: the relation ideal is spanned by the generators `t_i T_j - t_j T_i`, and the
-- previous theorem kills each generator, so the whole span maps to zero.
private theorem relations_toRees_eq_zero (f : S) (hf : f ∈ J) :
    presentationToRees R n f = 0 := by
  -- The previous helper packages the span argument as an ideal inclusion into the kernel.
  exact RingHom.mem_ker.mp
    (polynomialBlowupRelationIdeal_le_presentationToRees_ker R n hf)

/-- Helper for Chap10 Example 10 70 4: if two exponent vectors have the same total degree but
are not equal, one coordinate increases and one coordinate decreases. -/
private theorem existsTransferIndices_of_ne_degree_eq {β β' : Fin n →₀ ℕ}
    (hne : β ≠ β') (hdeg : β.degree = β'.degree) :
    ∃ i j : Fin n, β i < β' i ∧ β' j < β j := by
  classical
  -- First find a coordinate where the two finitely supported functions differ.
  have h_exists_ne : ∃ k : Fin n, β k ≠ β' k := by
    by_contra h
    apply hne
    ext k
    exact of_not_not (by intro hk; exact h ⟨k, hk⟩)
  -- If no coordinate of `β` is smaller, then the equal total degrees are contradicted.
  have hlt_left : ∃ i : Fin n, β i < β' i := by
    by_contra h
    have hle : ∀ i : Fin n, β' i ≤ β i := by
      intro i
      exact Nat.le_of_not_gt (by intro hlt; exact h ⟨i, hlt⟩)
    rcases h_exists_ne with ⟨k, hk⟩
    have hlt : β' k < β k := lt_of_le_of_ne (hle k) (Ne.symm hk)
    have hsum_lt : (∑ i : Fin n, β' i) < ∑ i : Fin n, β i :=
      Finset.sum_lt_sum (fun i _ ↦ hle i) ⟨k, Finset.mem_univ k, hlt⟩
    have hsum : (∑ i : Fin n, β i) = ∑ i : Fin n, β' i := by
      simpa [Finsupp.degree_eq_sum] using hdeg
    omega
  -- The symmetric argument gives a coordinate where `β` is larger.
  have hlt_right : ∃ j : Fin n, β' j < β j := by
    by_contra h
    have hle : ∀ i : Fin n, β i ≤ β' i := by
      intro i
      exact Nat.le_of_not_gt (by intro hlt; exact h ⟨i, hlt⟩)
    rcases h_exists_ne with ⟨k, hk⟩
    have hlt : β k < β' k := lt_of_le_of_ne (hle k) hk
    have hsum_lt : (∑ i : Fin n, β i) < ∑ i : Fin n, β' i :=
      Finset.sum_lt_sum (fun i _ ↦ hle i) ⟨k, Finset.mem_univ k, hlt⟩
    have hsum : (∑ i : Fin n, β i) = ∑ i : Fin n, β' i := by
      simpa [Finsupp.degree_eq_sum] using hdeg
    omega
  rcases hlt_left with ⟨i, hi⟩
  rcases hlt_right with ⟨j, hj⟩
  exact ⟨i, j, hi, hj⟩

/-- Helper for Chap10 Example 10 70 4: one unit of `T_j` can be exchanged for one unit of
`T_i`, provided the coefficient monomial has an `X_i` available. -/
private theorem presentationMonomialSwap_mem_relationIdeal
    (alpha beta : Fin n →₀ ℕ) (r : R) (i j : Fin n)
    (hi : alpha i ≠ 0) (hj : beta j ≠ 0) :
    MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P) -
      MvPolynomial.monomial (beta - Finsupp.single j 1 + Finsupp.single i 1)
        (MvPolynomial.monomial (alpha - Finsupp.single i 1 + Finsupp.single j 1) r : P) ∈ J := by
  -- Multiply the generator `X_i T_j - X_j T_i` by the monomial that removes one
  -- `T_j` and one `X_i`.
  let m : S := MvPolynomial.monomial (beta - Finsupp.single j 1)
    (MvPolynomial.monomial (alpha - Finsupp.single i 1) r : P)
  have hm : m * polynomialBlowupPresentationRelation R n i j ∈ J :=
    Ideal.mul_mem_left J m (presentationRelation_mem_relationIdeal R n i j)
  -- Compute the two products of the multiplier with the two terms of the generator.
  have hleft : m * (MvPolynomial.C (X i : P) * X j) =
      MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P) := by
    rw [MvPolynomial.C_mul_X_eq_monomial]
    rw [MvPolynomial.monomial_mul]
    rw [MvPolynomial.X, MvPolynomial.monomial_mul, mul_one]
    rw [Finsupp.sub_add_single_one_cancel hj, Finsupp.sub_add_single_one_cancel hi]
  have hright : m * (MvPolynomial.C (X j : P) * X i) =
      MvPolynomial.monomial (beta - Finsupp.single j 1 + Finsupp.single i 1)
        (MvPolynomial.monomial (alpha - Finsupp.single i 1 + Finsupp.single j 1) r : P) := by
    rw [MvPolynomial.C_mul_X_eq_monomial]
    rw [MvPolynomial.monomial_mul]
    rw [MvPolynomial.X, MvPolynomial.monomial_mul, mul_one]
  have hcalc : m * polynomialBlowupPresentationRelation R n i j =
      MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P) -
        MvPolynomial.monomial (beta - Finsupp.single j 1 + Finsupp.single i 1)
          (MvPolynomial.monomial (alpha - Finsupp.single i 1 + Finsupp.single j 1) r : P) := by
    dsimp [m, polynomialBlowupPresentationRelation]
    rw [mul_sub, hleft, hright]
  simpa [hcalc] using hm

/-- Helper for Chap10 Example 10 70 4: the elementary swap gives equality of the corresponding
presentation monomials in the quotient by the relation ideal. -/
private theorem presentationMonomialSwap_quotient_eq
    (alpha beta : Fin n →₀ ℕ) (r : R) (i j : Fin n)
    (hi : alpha i ≠ 0) (hj : beta j ≠ 0) :
    Ideal.Quotient.mk J
        (MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P)) =
      Ideal.Quotient.mk J
        (MvPolynomial.monomial (beta - Finsupp.single j 1 + Finsupp.single i 1)
          (MvPolynomial.monomial (alpha - Finsupp.single i 1 + Finsupp.single j 1) r : P)) := by
  -- Quotient equality is exactly membership of the difference in the defining ideal.
  rw [Ideal.Quotient.eq]
  exact presentationMonomialSwap_mem_relationIdeal R n alpha beta r i j hi hj

/-- Helper for Chap10 Example 10 70 4: the deficit distance from one `T`-exponent vector to
another is the total amount still missing from the target vector. -/
private def presentationTransferDistance (beta beta' : Fin n →₀ ℕ) : ℕ :=
  Finset.univ.sum (fun k : Fin n ↦ beta' k - beta k)

/-- Helper for Chap10 Example 10 70 4: an elementary transfer strictly decreases the deficit
distance to the target exponent vector. -/
private theorem presentationTransferDistance_swap_lt {beta beta' : Fin n →₀ ℕ} {i j : Fin n}
    (hi : beta i < beta' i) (hj : beta' j < beta j) :
    presentationTransferDistance n (beta - Finsupp.single j 1 + Finsupp.single i 1) beta' <
      presentationTransferDistance n beta beta' := by
  -- The receiving coordinate `i` lowers the deficit by one, while the donating coordinate `j`
  -- remains nondeficient; all other coordinates are unchanged.
  have hij : i ≠ j := by
    intro h
    subst j
    omega
  unfold presentationTransferDistance
  refine Finset.sum_lt_sum (s := (Finset.univ : Finset (Fin n))) ?_
    ⟨i, Finset.mem_univ i, ?_⟩
  · intro k _hk
    by_cases hki : k = i
    · subst k
      simp [hij.symm]
      omega
    · by_cases hkj : k = j
      · subst k
        simp [hki]
        omega
      · simp [hki, hkj]
  · simp [hij.symm]
    omega

/-- Helper for Chap10 Example 10 70 4: an elementary transfer preserves the total `T`-degree. -/
private theorem presentationTransferDegree_swap_eq {beta beta' : Fin n →₀ ℕ} {i j : Fin n}
    (_hi : beta i < beta' i) (hj : beta' j < beta j) :
    (beta - Finsupp.single j 1 + Finsupp.single i 1).degree = beta.degree := by
  -- Removing one unit from `j` and adding one unit to `i` preserves the additive degree.
  have hBeta_j : beta j ≠ 0 := by
    omega
  have hsub : (beta - Finsupp.single j 1).degree + 1 = beta.degree := by
    have h := congrArg Finsupp.degree (Finsupp.sub_add_single_one_cancel hBeta_j)
    simpa using h
  have hstep :
      (beta - Finsupp.single j 1 + Finsupp.single i 1).degree =
        (beta - Finsupp.single j 1).degree + 1 := by
    rw [map_add, Finsupp.degree_single]
  omega

/-- Helper for Chap10 Example 10 70 4: the matching elementary transfers in the coefficient and
presentation exponents preserve their combined exponent. -/
private theorem presentationTransferCombined_swap_eq {alpha beta : Fin n →₀ ℕ} {i j : Fin n}
    (hi : alpha i ≠ 0) (hj : beta j ≠ 0) :
    (alpha - Finsupp.single i 1 + Finsupp.single j 1) +
        (beta - Finsupp.single j 1 + Finsupp.single i 1) =
      alpha + beta := by
  -- Check the equality coordinatewise; only `i` and `j` can change.
  ext k
  by_cases hki : k = i
  · subst k
    by_cases hij : i = j
    · subst j
      simp
      omega
    · simp [hij]
      omega
  · by_cases hkj : k = j
    · subst k
      simp [hki]
      omega
    · simp [hki, hkj]

/-- Helper for Chap10 Example 10 70 4: if two presentation monomials have the same key but
different `T`-exponents, one elementary transfer moves the first exponent closer to the second. -/
private theorem existsPresentationTransferStep {alpha alpha' beta beta' : Fin n →₀ ℕ}
    (hdeg : beta.degree = beta'.degree) (hkey : alpha + beta = alpha' + beta')
    (hne : beta ≠ beta') :
    ∃ i j : Fin n,
      alpha i ≠ 0 ∧ beta j ≠ 0 ∧
      (beta - Finsupp.single j 1 + Finsupp.single i 1).degree = beta'.degree ∧
      (alpha - Finsupp.single i 1 + Finsupp.single j 1) +
          (beta - Finsupp.single j 1 + Finsupp.single i 1) = alpha' + beta' ∧
      presentationTransferDistance n (beta - Finsupp.single j 1 + Finsupp.single i 1) beta' <
        presentationTransferDistance n beta beta' := by
  -- Choose a coordinate where `beta` is too small and one where it is too large.
  rcases existsTransferIndices_of_ne_degree_eq (n := n) hne hdeg with ⟨i, j, hi, hj⟩
  have hkey_i : alpha i + beta i = alpha' i + beta' i := by
    simpa using congrArg (fun v : Fin n →₀ ℕ ↦ v i) hkey
  have hAlpha_i : alpha i ≠ 0 := by
    omega
  have hBeta_j : beta j ≠ 0 := by
    omega
  refine ⟨i, j, hAlpha_i, hBeta_j, ?_, ?_, ?_⟩
  · exact (presentationTransferDegree_swap_eq (n := n) hi hj).trans hdeg
  · exact (presentationTransferCombined_swap_eq (n := n) hAlpha_i hBeta_j).trans hkey
  · exact presentationTransferDistance_swap_lt (n := n) hi hj

/-- Helper for Chap10 Example 10 70 4: presentation monomials with the same combined exponent
and the same `T`-degree have the same class in the quotient by the relation ideal. -/
private theorem presentationMonomial_quotient_eq_of_same_key
    (alpha alpha' beta beta' : Fin n →₀ ℕ) (r : R)
    (hdeg : beta.degree = beta'.degree) (hkey : alpha + beta = alpha' + beta') :
    Ideal.Quotient.mk J
        (MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P)) =
      Ideal.Quotient.mk J
        (MvPolynomial.monomial beta' (MvPolynomial.monomial alpha' r : P)) := by
  classical
  -- Induct on the deficit distance from the current `T`-exponent to the target exponent.
  refine
    ((InvImage.wf
      (fun beta : Fin n →₀ ℕ ↦ presentationTransferDistance n beta beta')
      wellFounded_lt).induction
      (C := fun beta ↦ ∀ alpha : Fin n →₀ ℕ,
        beta.degree = beta'.degree →
        alpha + beta = alpha' + beta' →
        Ideal.Quotient.mk J
            (MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P)) =
          Ideal.Quotient.mk J
            (MvPolynomial.monomial beta' (MvPolynomial.monomial alpha' r : P)))
      beta ?_) alpha hdeg hkey
  intro beta ih alpha hdeg hkey
  by_cases hbeta : beta = beta'
  · subst beta
    have halpha : alpha = alpha' := add_right_cancel hkey
    subst alpha
    rfl
  · rcases existsPresentationTransferStep (n := n) (alpha := alpha) (alpha' := alpha')
      (beta := beta) (beta' := beta') hdeg hkey hbeta with
      ⟨i, j, hAlpha_i, hBeta_j, hdeg_step, hkey_step, hdist_step⟩
    -- One quotient swap performs the elementary transfer; the induction hypothesis finishes.
    calc
      Ideal.Quotient.mk J
          (MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P))
          =
        Ideal.Quotient.mk J
          (MvPolynomial.monomial (beta - Finsupp.single j 1 + Finsupp.single i 1)
            (MvPolynomial.monomial
              (alpha - Finsupp.single i 1 + Finsupp.single j 1) r : P)) := by
          exact presentationMonomialSwap_quotient_eq R n alpha beta r i j hAlpha_i hBeta_j
      _ =
        Ideal.Quotient.mk J
          (MvPolynomial.monomial beta' (MvPolynomial.monomial alpha' r : P)) := by
          exact ih (beta - Finsupp.single j 1 + Finsupp.single i 1) hdist_step
            (alpha - Finsupp.single i 1 + Finsupp.single j 1) hdeg_step hkey_step

/-- Helper for Chap10 Example 10 70 4: a finite product of polynomial monomials is the monomial
whose degree and coefficient are the corresponding finite products. -/
private theorem polynomial_prod_monomial_finset {ι : Type*} (s : Finset ι) (m : ι → ℕ)
    (c : ι → P) :
    (∏ i ∈ s, Polynomial.monomial (m i) (c i)) =
      Polynomial.monomial (∑ i ∈ s, m i) (∏ i ∈ s, c i) := by
  classical
  -- Induct over the indexing finite set and multiply monomials at the inserted index.
  induction s using Finset.induction_on with
  | empty =>
      simp
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, Finset.prod_insert ha, ih,
        Polynomial.monomial_mul_monomial]

/-- Helper for Chap10 Example 10 70 4: the ambient product of degree-one coordinate monomials
has degree `beta.degree` and coefficient monomial `X^beta`. -/
private theorem polynomial_prod_degreeOne_X_pow (beta : Fin n →₀ ℕ) :
    (∏ i : Fin n, (Polynomial.monomial 1 (X i : P)) ^ beta i) =
      Polynomial.monomial beta.degree (MvPolynomial.monomial beta (1 : R)) := by
  -- First rewrite each factor as a polynomial monomial, then multiply all monomials at once.
  rw [show (∏ i : Fin n, (Polynomial.monomial 1 (X i : P)) ^ beta i) =
      ∏ i : Fin n, Polynomial.monomial (beta i) ((X i : P) ^ beta i) by
        simp [Polynomial.monomial_pow]]
  rw [show (∏ i : Fin n, Polynomial.monomial (beta i) ((X i : P) ^ beta i)) =
      ∏ i ∈ (Finset.univ : Finset (Fin n)),
        Polynomial.monomial (beta i) ((X i : P) ^ beta i) by
        simp]
  rw [polynomial_prod_monomial_finset]
  rw [show (∑ i ∈ (Finset.univ : Finset (Fin n)), beta i) = beta.degree by
    simpa [Finsupp.degree_eq_sum]]
  rw [show (∏ i ∈ (Finset.univ : Finset (Fin n)), (X i : P) ^ beta i) =
      MvPolynomial.monomial beta (1 : R) by
    rw [← MvPolynomial.prod_X_pow_eq_monomial (s := beta) (R := R)]
    exact (Finset.prod_subset (Finset.subset_univ beta.support) (by
      intro x _hx hxnot
      have hzero : beta x = 0 := by
        exact Finsupp.notMem_support_iff.mp hxnot
      simp [hzero])).symm]

/-- Helper for Chap10 Example 10 70 4: the product of the selected degree-one Rees generators
has the expected underlying polynomial. -/
private theorem presentationDegreeOneProduct_eq (beta : Fin n →₀ ℕ) :
    ((beta.prod fun i k ↦
        (reesAlgebraDegreeOne Icoord ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩) ^ k :
        reesAlgebra Icoord) : Polynomial P) =
      beta.prod (fun i k ↦ Polynomial.monomial k ((X i : P) ^ k)) := by
  -- Push the product through the subtype map, then compute powers of polynomial monomials.
  have hrhs : beta.prod (fun i k ↦ Polynomial.monomial k ((X i : P) ^ k)) =
      ∏ x : Fin n, Polynomial.monomial (beta x) ((X x : P) ^ beta x) := by
    rw [Finsupp.prod_of_support_subset beta (Finset.subset_univ beta.support)]
    intro i _hi
    simp
  rw [hrhs]
  rw [Finsupp.prod_of_support_subset beta (Finset.subset_univ beta.support)]
  · have hmap := map_prod ((reesAlgebra Icoord).toSubsemiring.subtype)
      (fun x : Fin n ↦
        (reesAlgebraDegreeOne Icoord ⟨X x, Ideal.subset_span (Set.mem_range_self x)⟩) ^
          beta x)
      (Finset.univ)
    simpa [reesAlgebraDegreeOne, Polynomial.monomial_pow] using hmap
  · intro i _hi
    simp

/-- Helper for Chap10 Example 10 70 4: evaluating a presentation monomial gives the Rees
monomial with degree the `T`-degree and exponent the combined coordinate exponent. -/
private theorem presentationToRees_monomial_monomial
    (alpha beta : Fin n →₀ ℕ) (r : R) :
    ((presentationToRees R n
        (MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P)) :
        reesAlgebra Icoord) : Polynomial P) =
      Polynomial.monomial beta.degree (MvPolynomial.monomial (alpha + beta) r) := by
  -- The `aeval` computation multiplies the coefficient monomial by the chosen degree-one
  -- Rees generators, collecting the outer exponents into the polynomial degree.
  rw [presentationToRees, MvPolynomial.aeval_monomial]
  change Polynomial.C (MvPolynomial.monomial alpha r : P) *
      ((beta.prod fun i k ↦
        (reesAlgebraDegreeOne Icoord ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩) ^ k :
        reesAlgebra Icoord) : Polynomial P) =
      Polynomial.monomial beta.degree (MvPolynomial.monomial (alpha + beta) r)
  rw [presentationDegreeOneProduct_eq]
  rw [show beta.prod (fun i k ↦ Polynomial.monomial k ((X i : P) ^ k)) =
      ∏ i : Fin n, (Polynomial.monomial 1 (X i : P)) ^ beta i by
    simpa [Polynomial.monomial_pow] using
      (Finsupp.prod_pow beta (fun i : Fin n ↦ Polynomial.monomial 1 (X i : P)))]
  rw [polynomial_prod_degreeOne_X_pow]
  rw [Polynomial.C_mul_monomial, MvPolynomial.monomial_mul]
  simp

/-- Helper for Chap10 Example 10 70 4: the coefficient of a single evaluated presentation
monomial is nonzero only at its combined exponent and `T`-degree. -/
private theorem presentationToRees_coeff_coeff
    (alpha beta gamma : Fin n →₀ ℕ) (d : ℕ) (r : R) :
    ((((presentationToRees R n
        (MvPolynomial.monomial beta (MvPolynomial.monomial alpha r : P)) :
        reesAlgebra Icoord) : Polynomial P).coeff d).coeff gamma) =
      if beta.degree = d ∧ alpha + beta = gamma then r else 0 := by
  -- Read the coefficient from the single-term normal form.
  rw [presentationToRees_monomial_monomial]
  by_cases hd : beta.degree = d
  · by_cases hg : alpha + beta = gamma
    · simp [MvPolynomial.coeff_monomial, hd, hg]
    · simp [MvPolynomial.coeff_monomial, hd, hg]
  · simp [Polynomial.coeff_monomial, hd]

/-- Helper for Chap10 Example 10 70 4: in a kernel element, the scalar coefficient sum over
each realized combined-exponent and `T`-degree fiber is zero. -/
private theorem presentationFiberCoeffSum_eq_zero (f : S)
    (hf : f ∈ RingHom.ker (presentationToRees R n).toRingHom)
    (gamma : Fin n →₀ ℕ) (d : ℕ) :
    (∑ beta ∈ f.support.filter (fun beta ↦ beta.degree = d),
      ∑ alpha ∈ (f.coeff beta).support.filter (fun alpha ↦ alpha + beta = gamma),
        (f.coeff beta).coeff alpha) = 0 := by
  classical
  -- Expand `f` into actual outer and inner support terms before taking the image coefficient.
  have h_expand : presentationToRees R n f =
      ∑ beta ∈ f.support, ∑ alpha ∈ (f.coeff beta).support,
        presentationToRees R n
          (MvPolynomial.monomial beta
            (MvPolynomial.monomial alpha ((f.coeff beta).coeff alpha) : P)) := by
    conv_lhs => rw [MvPolynomial.as_sum f]
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro beta _hbeta
    conv_lhs => rw [MvPolynomial.as_sum (f.coeff beta)]
    rw [map_sum (MvPolynomial.monomial beta)]
    rw [map_sum]
  have hcoeff :
      ((((presentationToRees R n f : reesAlgebra Icoord) : Polynomial P).coeff d).coeff gamma)
        = 0 := by
    have hf0 : presentationToRees R n f = 0 := RingHom.mem_ker.mp hf
    simpa using congrArg
      (fun y : reesAlgebra Icoord ↦ (((y : Polynomial P).coeff d).coeff gamma)) hf0
  -- The single-term coefficient formula leaves exactly the requested fiber sum.
  have hcoeff' :
      (∑ beta ∈ f.support,
        ∑ alpha ∈ (f.coeff beta).support,
          if beta.degree = d ∧ alpha + beta = gamma then (f.coeff beta).coeff alpha else 0) =
        0 := by
    simpa [h_expand, Polynomial.finset_sum_coeff, MvPolynomial.coeff_sum,
      presentationToRees_coeff_coeff] using hcoeff
  have hfiltered :
      (∑ beta ∈ f.support,
        if beta.degree = d then
          ∑ alpha ∈ (f.coeff beta).support,
            if alpha + beta = gamma then (f.coeff beta).coeff alpha else 0
        else 0) = 0 := by
    -- Separate the combined condition into an outer degree filter and an inner key filter.
    have hsplit :
        (∑ beta ∈ f.support,
          if beta.degree = d then
            ∑ alpha ∈ (f.coeff beta).support,
              if alpha + beta = gamma then (f.coeff beta).coeff alpha else 0
          else 0) =
        (∑ beta ∈ f.support,
          ∑ alpha ∈ (f.coeff beta).support,
            if beta.degree = d ∧ alpha + beta = gamma then (f.coeff beta).coeff alpha else 0) := by
      apply Finset.sum_congr rfl
      intro beta _hbeta
      by_cases hdeg : beta.degree = d
      · simp [hdeg]
      · simp [hdeg]
    exact hsplit.trans hcoeff'
  simpa [Finset.sum_filter] using hfiltered

/-- Helper for Chap10 Example 10 70 4: a degree-one monomial whose coefficient lies in the
coordinate ideal is a Rees algebra element. -/
private theorem coordinateDegreeOneMonomial_mem (r : P) (hr : r ∈ Icoord) :
    Polynomial.monomial 1 r ∈ reesAlgebra Icoord := by
  -- The Rees membership condition in degree one is exactly membership in the ideal.
  exact (reesAlgebra.monomial_mem).2 (by simpa [pow_one] using hr)

/-- Helper for Chap10 Example 10 70 4: every degree-one Rees monomial with coefficient in the
coordinate ideal is hit by the polynomial presentation map. -/
private theorem coordinateDegreeOneMonomial_mem_range (r : P) (hr : r ∈ Icoord) :
    ∃ f : S, presentationToRees R n f =
      ⟨Polynomial.monomial 1 r, coordinateDegreeOneMonomial_mem R n r hr⟩ := by
  rw [idealOfVars] at hr
  -- Induct over the ideal span of the coordinate variables; the presentation variables hit the
  -- span generators, and the range is closed under addition and scalar multiplication.
  refine Submodule.span_induction
    (p := fun r hr ↦ ∃ f : S, presentationToRees R n f =
      ⟨Polynomial.monomial 1 r, coordinateDegreeOneMonomial_mem R n r hr⟩)
    ?_ ?_ ?_ ?_ hr
  · intro x hx
    rcases hx with ⟨i, rfl⟩
    use X i
    apply Subtype.ext
    simp [presentationToRees, reesAlgebraDegreeOne]
  · use 0
    apply Subtype.ext
    simp
  · intro x y hx hy hxrange hyrange
    rcases hxrange with ⟨fx, hfx⟩
    rcases hyrange with ⟨fy, hfy⟩
    use fx + fy
    apply Subtype.ext
    have hfxval := congrArg Subtype.val hfx
    have hfyval := congrArg Subtype.val hfy
    simp [hfxval, hfyval]
  · intro a x hx hxrange
    rcases hxrange with ⟨fx, hfx⟩
    use MvPolynomial.C a * fx
    apply Subtype.ext
    have hfxval := congrArg Subtype.val hfx
    simp [hfxval, smul_eq_mul]

/-- Helper for Chap10 Example 10 70 4: the algebra generated by degree-one coordinate-ideal
monomials is contained in the Rees algebra. -/
private theorem mem_reesAlgebra_of_mem_coordinateAdjoin {p : Polynomial P}
    (hp : p ∈ Algebra.adjoin P
      (Submodule.map (Polynomial.monomial 1 : P →ₗ[P] Polynomial P) Icoord :
        Set (Polynomial P))) :
    p ∈ reesAlgebra Icoord := by
  -- Use mathlib's generation theorem for the Rees algebra.
  rw [← adjoin_monomial_eq_reesAlgebra]
  exact hp

/-- Helper for Chap10 Example 10 70 4: the unquotiented presentation map surjects onto the Rees
algebra. -/
private theorem presentationToRees_surjective : Function.Surjective (presentationToRees R n) := by
  intro y
  have hy_adjoin : (y : Polynomial P) ∈ Algebra.adjoin P
      (Submodule.map (Polynomial.monomial 1 : P →ₗ[P] Polynomial P) Icoord :
        Set (Polynomial P)) := by
    rw [adjoin_monomial_eq_reesAlgebra]
    exact y.2
  have hpre : ∃ f : S, presentationToRees R n f =
      ⟨(y : Polynomial P), mem_reesAlgebra_of_mem_coordinateAdjoin R n hy_adjoin⟩ := by
    -- Induct over the algebra generated by the degree-one monomials. Constants come from
    -- polynomial constants, and the generator case was proved by the span argument above.
    refine Algebra.adjoin_induction
      (s := (Submodule.map (Polynomial.monomial 1 : P →ₗ[P] Polynomial P) Icoord :
        Set (Polynomial P)))
      (p := fun p hp ↦ ∃ f : S, presentationToRees R n f =
        ⟨p, mem_reesAlgebra_of_mem_coordinateAdjoin R n hp⟩)
      ?_ ?_ ?_ ?_ hy_adjoin
    · intro p hp
      rcases hp with ⟨r, hr, rfl⟩
      rcases coordinateDegreeOneMonomial_mem_range R n r hr with ⟨f, hf⟩
      use f
    · intro r
      use MvPolynomial.C r
      apply Subtype.ext
      simp [presentationToRees]
    · intro x y hx hy hxrange hyrange
      rcases hxrange with ⟨fx, hfx⟩
      rcases hyrange with ⟨fy, hfy⟩
      use fx + fy
      apply Subtype.ext
      have hfxval := congrArg Subtype.val hfx
      have hfyval := congrArg Subtype.val hfy
      simp [hfxval, hfyval]
    · intro x y hx hy hxrange hyrange
      rcases hxrange with ⟨fx, hfx⟩
      rcases hyrange with ⟨fy, hfy⟩
      use fx * fy
      apply Subtype.ext
      have hfxval := congrArg Subtype.val hfx
      have hfyval := congrArg Subtype.val hfy
      simp [hfxval, hfyval]
  rcases hpre with ⟨f, hf⟩
  use f

/-- The quotient map from the presentation ring to the blowup algebra. -/
private noncomputable def presentationMap : Q →ₐ[P] reesAlgebra Icoord :=
  Ideal.Quotient.liftₐ J (presentationToRees R n) (relations_toRees_eq_zero R n)

/-- Helper for Chap10 Example 10 70 4: the quotient presentation map is surjective. -/
private theorem presentationMap_surjective : Function.Surjective (presentationMap R n) := by
  intro y
  rcases presentationToRees_surjective R n y with ⟨f, hf⟩
  -- A preimage for the unquotiented map descends to a preimage in the quotient.
  use Ideal.Quotient.mk J f
  simp [presentationMap, hf]

/-- Helper for Chap10 Example 10 70 4: a presentation monomial gives an additive map from
the scalar coefficient to the quotient presentation ring. -/
private noncomputable def presentationMonomialQuotientHom (alpha beta : Fin n →₀ ℕ) : R →+ Q :=
  (Ideal.Quotient.mk J).toAddMonoidHom.comp
    ((MvPolynomial.monomial beta).toAddMonoidHom.comp
      (MvPolynomial.monomial alpha).toAddMonoidHom)

/-- Helper for Chap10 Example 10 70 4: equal presentation keys give the same additive
quotient-monomial map. -/
private theorem presentationMonomialQuotientHom_eq_of_same_key
    (alpha alpha' beta beta' : Fin n →₀ ℕ)
    (hdeg : beta.degree = beta'.degree) (hkey : alpha + beta = alpha' + beta') :
    presentationMonomialQuotientHom R n alpha beta =
      presentationMonomialQuotientHom R n alpha' beta' := by
  -- Extensionality reduces equality of additive maps to the existing quotient straightening.
  ext r
  exact presentationMonomial_quotient_eq_of_same_key R n alpha alpha' beta beta' r hdeg hkey

/-- Helper for Chap10 Example 10 70 4: a finite sum of additive-hom images vanishes when
each key fiber has zero coefficient sum and a single additive map on that fiber. -/
private theorem Finset.sum_addMonoidHom_apply_eq_zero_of_fiber_sum_eq_zero
    {ι κ A G : Type*} [DecidableEq κ] [AddCommMonoid A] [AddCommMonoid G]
    (s : Finset ι) (key : ι → κ) (coeff : ι → A) (phi : ι → A →+ G)
    (hphi : ∀ k ∈ s.image key, ∃ psi : A →+ G,
      ∀ i ∈ s.filter (fun i ↦ key i = k), phi i = psi)
    (hcoeff : ∀ k : κ, (∑ i ∈ s.filter (fun i ↦ key i = k), coeff i) = 0) :
    (∑ i ∈ s, phi i (coeff i)) = 0 := by
  classical
  -- First regroup the original sum by the finite set of realized keys.
  rw [← Finset.sum_fiberwise_of_maps_to
    (s := s) (t := s.image key) (g := key)
    (f := fun i ↦ phi i (coeff i)) (fun i hi ↦ Finset.mem_image_of_mem key hi)]
  -- On each fiber, replace all summands by one additive map and use the scalar sum.
  refine Finset.sum_eq_zero ?_
  intro k hk
  rcases hphi k hk with ⟨psi, hpsi⟩
  calc
    (∑ i ∈ s.filter (fun i ↦ key i = k), phi i (coeff i))
        = ∑ i ∈ s.filter (fun i ↦ key i = k), psi (coeff i) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          rw [hpsi i hi]
    _ = psi (∑ i ∈ s.filter (fun i ↦ key i = k), coeff i) := by
          exact (map_sum psi (fun i ↦ coeff i) (s.filter (fun i ↦ key i = k))).symm
    _ = 0 := by
          rw [hcoeff k, map_zero]

/-- Helper for Chap10 Example 10 70 4: kernel elements have zero coefficient sum on each
sigma-support fiber keyed by total presentation degree and combined exponent. -/
private theorem presentationSupportPairCoeffSum_eq_zero (f : S)
    (hf : f ∈ RingHom.ker (presentationToRees R n).toRingHom)
    (d : ℕ) (gamma : Fin n →₀ ℕ) :
    (∑ x ∈ (f.support.sigma fun beta ↦ (f.coeff beta).support).filter
      (fun x ↦ x.1.degree = d ∧ x.2 + x.1 = gamma), (f.coeff x.1).coeff x.2) = 0 := by
  classical
  -- Rewrite the already-proved nested fiber statement in the sigma-indexed form used below.
  rw [Finset.sum_filter, Finset.sum_sigma]
  calc
    (∑ x ∈ f.support,
        ∑ x_1 ∈ (f.coeff x).support,
          if x.degree = d ∧ x_1 + x = gamma then (f.coeff x).coeff x_1 else 0)
        =
      ∑ x ∈ f.support,
        if x.degree = d then
          ∑ x_1 ∈ (f.coeff x).support,
            if x_1 + x = gamma then (f.coeff x).coeff x_1 else 0
        else 0 := by
          refine Finset.sum_congr rfl ?_
          intro beta _hbeta
          by_cases hdeg : beta.degree = d
          · simp [hdeg]
          · simp [hdeg]
    _ = 0 := by
          simpa [Finset.sum_filter] using presentationFiberCoeffSum_eq_zero R n f hf gamma d

/-- Helper for Chap10 Example 10 70 4: the quotient class of a presentation polynomial is the
sum of its quotient monomials over outer and inner supports. -/
private theorem presentationQuotientSupportPairExpansion (f : S) :
    Ideal.Quotient.mk J f =
      ∑ x ∈ f.support.sigma (fun beta ↦ (f.coeff beta).support),
        presentationMonomialQuotientHom R n x.2 x.1 ((f.coeff x.1).coeff x.2) := by
  classical
  -- Expand first in the outer presentation variables, then in the coefficient polynomial.
  conv_lhs => rw [MvPolynomial.as_sum f]
  rw [map_sum]
  rw [Finset.sum_sigma]
  refine Finset.sum_congr rfl ?_
  intro beta _hbeta
  conv_lhs => rw [MvPolynomial.as_sum (f.coeff beta)]
  rw [map_sum (MvPolynomial.monomial beta)]
  rw [map_sum]
  simp [presentationMonomialQuotientHom]

/-- Chap10 Example 10 70 4: the kernel of the evaluation map is the relation ideal. -/
private theorem presentationToRees_ker_eq_relationIdeal :
    RingHom.ker (presentationToRees R n).toRingHom = J := by
  apply le_antisymm
  · intro f hf
    -- Show that the quotient class of `f` is zero, then read this as membership in `J`.
    refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
    rw [presentationQuotientSupportPairExpansion R n f]
    -- The support-pair expansion is grouped by the key `(T-degree, combined exponent)`.
    refine Finset.sum_addMonoidHom_apply_eq_zero_of_fiber_sum_eq_zero
      (s := f.support.sigma (fun beta ↦ (f.coeff beta).support))
      (key := fun x ↦ (x.1.degree, x.2 + x.1))
      (coeff := fun x ↦ (f.coeff x.1).coeff x.2)
      (phi := fun x ↦ presentationMonomialQuotientHom R n x.2 x.1) ?_ ?_
    · intro k hk
      rcases Finset.mem_image.mp hk with ⟨x, hx_mem, hx_key⟩
      refine ⟨presentationMonomialQuotientHom R n x.2 x.1, ?_⟩
      intro y hy
      have hy_key : (y.1.degree, y.2 + y.1) = k := (Finset.mem_filter.mp hy).2
      have hkey_yx : (y.1.degree, y.2 + y.1) = (x.1.degree, x.2 + x.1) :=
        hy_key.trans hx_key.symm
      exact presentationMonomialQuotientHom_eq_of_same_key R n y.2 x.2 y.1 x.1
        (congrArg Prod.fst hkey_yx) (congrArg Prod.snd hkey_yx)
    · intro k
      rcases k with ⟨d, gamma⟩
      simpa [Prod.ext_iff] using presentationSupportPairCoeffSum_eq_zero R n f hf d gamma
  · -- The reverse inclusion is the span argument already used to define the quotient map.
    exact polynomialBlowupRelationIdeal_le_presentationToRees_ker R n

/-- Helper for Chap10 Example 10 70 4: the quotient presentation map is injective once the
kernel is known to be exactly the relation ideal. -/
private theorem presentationMap_injective : Function.Injective (presentationMap R n) := by
  intro x y hxy
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [Ideal.Quotient.eq]
  -- Equality after applying the quotient map says that the difference is killed by
  -- `presentationToRees`.
  have hmap : presentationToRees R n (a - b) = 0 := by
    simpa [presentationMap, map_sub, hxy] using
      congrArg (fun z ↦ z - presentationMap R n (Ideal.Quotient.mk J b)) hxy
  have hmemker : a - b ∈ RingHom.ker (presentationToRees R n).toRingHom := by
    exact RingHom.mem_ker.mpr hmap
  rw [presentationToRees_ker_eq_relationIdeal R n] at hmemker
  exact hmemker

/-- The canonical presentation map from the quotient ring to the Rees algebra is bijective. -/
-- Proof sketch: surjectivity follows from `adjoin_monomial_eq_reesAlgebra`, since the target is
-- generated by the degree-one classes `t_i^(1)`. Injectivity is exactly the monomial-relations
-- argument for the graded pieces `Icoord ^ e` described in the example.
private theorem presentationMap_bijective : Function.Bijective (presentationMap R n) :=
  ⟨presentationMap_injective R n, presentationMap_surjective R n⟩

/-- For Chap10 Example 10 70 4, when `P = R[t_1, ..., t_n]` and `I = (t_1, ..., t_n)`, the canonical
`P`-algebra map
`P[T_1, ..., T_n] / (t_i T_j - t_j T_i) \to \mathrm{Bl}_I(P) = reesAlgebra I`
sending `T_i` to the degree-one Rees generator `t_i^(1)` is an isomorphism. -/
@[stacks 0G8Q]
noncomputable def polynomialBlowupPresentation :
    (S ⧸ polynomialBlowupRelationIdeal R n) ≃ₐ[P] reesAlgebra Icoord :=
  AlgEquiv.ofBijective (presentationMap R n) (presentationMap_bijective R n)

/-- The presentation isomorphism sends the class of `T_i` to the generator `t_i^(1)`. -/
-- Proof sketch: `polynomialBlowupPresentation` is induced from `MvPolynomial.aeval`, so on the
-- quotient class of the variable `T_i` it agrees with the chosen image used to define the map.
theorem polynomialBlowupPresentation_apply_variable (i : Fin n) :
    polynomialBlowupPresentation R n
        (Ideal.Quotient.mk (polynomialBlowupRelationIdeal R n) (X i : S)) =
      reesAlgebraDegreeOne Icoord ⟨X i, Ideal.subset_span (Set.mem_range_self i)⟩ := by
  -- The equivalence is the quotient lift of `presentationToRees`, so variables compute by
  -- the defining `aeval` map.
  simp [polynomialBlowupPresentation, presentationMap, presentationToRees]

end
