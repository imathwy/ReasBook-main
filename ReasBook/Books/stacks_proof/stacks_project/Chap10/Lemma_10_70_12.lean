import stacks_proof.stacks_project.Chap10.Definition_10_70_1
import stacks_proof.stacks_project.Chap10.Lemma_10_70_2
import Mathlib.Tactic.StacksAttribute

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

open IsLocalRing Localization
open HomogeneousLocalization
open scoped Pointwise

/-
Domain-style sampling pass for Lemma 10.70.12.

Primary domain: affine blowup charts inside valuation subrings of a fraction field.

Sampled owner declarations:
* `affineBlowupChart` and `affineBlowupChartToLocalizationAway` from
  `Definition_10_70_1.lean`;
* `affineBlowupChart_isLocalizationAway` from `Lemma_10_70_2.lean`;
* `LocalSubring.range` / `ValuationSubring.toLocalSubring` from
  `Definition_10_50_1.lean`.

Owner abstraction: the source-facing object is the chart `affineBlowupChart I a`; its canonical
map into the fraction field is the owner declaration `algebraMap (affineBlowupChart I a) K`,
obtained from the existing localization and domain owners. The induced subring of `K` is derived
owner data, so this file uses `RingHom.range` directly instead of keeping a parallel wrapper map.

Layering:
* source-facing: `IsAffineBlowupApproximation` and the directed union theorem;
* core/canonical: `ValuationSubring K`, `LocalSubring.range`, `algebraMap`, and `RingHom.range`;
* bridge/view: `affineBlowupChartToLocalizationAway`.
-/

/-- Helper for Lemma 10.70.12: the first entry of a finite generating tuple, viewed as an element
of the ideal it spans. -/
def tupleSpanFirst {R : Type u} [CommRing R] {r : ℕ} (f : Fin (r + 1) → R) :
    Ideal.span (Set.range f) :=
  ⟨f 0, Ideal.subset_span ⟨0, rfl⟩⟩

section

variable {R : Type u} {K : Type v} [CommRing R] [IsDomain R]
variable [Field K] [Algebra R K] [IsFractionRing R K]

noncomputable instance instAlgebraAffineBlowupChartFractionField
    (I : Ideal R) (a : { a : I // (a : R) ≠ 0 }) :
    Algebra (affineBlowupChart I a) K :=
  RingHom.toAlgebra <|
    (Localization.mapToFractionRing K (Submonoid.powers (a : R))
      (Localization.Away (a : R)) (powers_le_nonZeroDivisors_of_noZeroDivisors a.2)).toRingHom.comp
      (affineBlowupChartToLocalizationAway I a)

omit [IsDomain R] in
/-- Helper for Lemma 10.70.12: the distinguished generator belongs to its own powers submonoid. -/
private theorem self_mem_powers (r : R) : r ∈ Submonoid.powers r :=
  by
    refine ⟨1, ?_⟩
    simp

/-- Helper for Lemma 10.70.12: the element `r` packaged as an element of `Submonoid.powers r`. -/
private def selfPower (r : R) : Submonoid.powers r :=
  ⟨r, self_mem_powers r⟩

omit [IsDomain R] in
/-- Helper for Lemma 10.70.12: every power `r ^ n` belongs to the powers submonoid generated by
`r`. -/
private theorem self_mem_powers_pow (r : R) (n : ℕ) : r ^ n ∈ Submonoid.powers r :=
  ⟨n, rfl⟩

/-- Helper for Lemma 10.70.12: the element `r ^ n` packaged as an element of
`Submonoid.powers r`. -/
private def selfPowerPow (r : R) (n : ℕ) : Submonoid.powers r :=
  ⟨r ^ n, self_mem_powers_pow r n⟩

omit [IsDomain R] in
/-- Helper for Lemma 10.70.12: the monomial with coefficient in `I ^ n` belongs to the degree-`n`
piece of the Rees algebra. -/
private theorem monomial_mem_reesAlgebraGrade
    (I : Ideal R) (n : ℕ) (r : ↥(I ^ n)) :
    (⟨Polynomial.monomial n r.1, (reesAlgebra.monomial_mem).2 r.2⟩ : reesAlgebra I) ∈
      reesAlgebraGrade I n := by
  change (⟨Polynomial.monomial n r.1, (reesAlgebra.monomial_mem).2 r.2⟩ : reesAlgebra I) ∈
      LinearMap.range _
  exact ⟨r, rfl⟩

omit [IsDomain R] in
/-- Helper for Lemma 10.70.12: the normalized monomial numerator used in the chart fraction has
the required grading degree. -/
private theorem monomial_mem_reesAlgebraGrade_for_chart
    (I : Ideal R) (n : ℕ) (r : ↥(I ^ n)) :
    (⟨Polynomial.monomial n r.1, (reesAlgebra.monomial_mem).2 r.2⟩ : reesAlgebra I) ∈
      reesAlgebraGrade I (n • 1) := by
  simpa [nsmul_eq_mul] using monomial_mem_reesAlgebraGrade I n r

omit [IsDomain R] in
/-- Helper for Lemma 10.70.12: the comparison map sends the basic chart fraction `x / a` to the
ordinary localization fraction `x / a`. -/
private theorem affineBlowupChartToLocalizationAway_basicFraction
    (I : Ideal R) (a x : I) :
    affineBlowupChartToLocalizationAway I a (affineBlowupChartBasicFraction I a x) =
      Localization.mk x.1 (selfPower a.1) := by
  let g : reesAlgebra I →+* Localization.Away a.1 :=
    (Polynomial.eval₂RingHom (algebraMap R (Localization.Away a.1)) 1).comp
      (reesAlgebra I).toSubring.subtype
  have hg : IsUnit (g (reesAlgebraDegreeOne I a)) := by
    simpa [g, reesAlgebraDegreeOne, selfPower] using
      (IsLocalization.Away.algebraMap_isUnit a.1 :
        IsUnit (algebraMap R (Localization.Away a.1) a.1))
  have hfrac (r : R) :
      algebraMap R (Localization.Away a.1) r * Localization.mk 1 (selfPower a.1) =
        Localization.mk r (selfPower a.1) := by
    -- Rewrite the right-hand fraction into the standard `mk'` form, then use the localization
    -- formula for multiplying by `1 / a`.
    rw [← Algebra.smul_def, Localization.mk_eq_mk'_apply, IsLocalization.smul_mk'_one]
    exact (Localization.mk_eq_mk'_apply r (selfPower a.1)).symm
  -- Evaluate the homogeneous-localization fraction by the universal property of `R_a`.
  rw [affineBlowupChartToLocalizationAway, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
  simp [affineBlowupChartBasicFraction]
  have h :=
      Localization.awayLift_mk g (reesAlgebraDegreeOne I a) (reesAlgebraDegreeOne I x)
        (Localization.mk 1 (selfPower a.1))
        (by
          -- The image of `a^(1)` is the ordinary element `a`, whose chosen inverse is `1 / a`.
          rw [show g (reesAlgebraDegreeOne I a) = algebraMap R (Localization.Away a.1) a.1 by
            simp [g, reesAlgebraDegreeOne]]
          rw [hfrac]
          exact Localization.mk_self (selfPower a.1))
        1
  simpa [g, reesAlgebraDegreeOne, pow_one, hfrac] using h

omit [IsDomain R] in
/-- Helper for Lemma 10.70.12: after normalizing a chart element to a monomial numerator of degree
`n`, the comparison map to `R_a` is the ordinary fraction `r / a^n`. -/
private theorem affineBlowupChartToLocalizationAway_fraction_of_monomial
    (I : Ideal R) (a : I) (n : ℕ) (r : ↥(I ^ n)) :
    affineBlowupChartToLocalizationAway I a
      (HomogeneousLocalization.Away.mk (reesAlgebraGrade I) (reesAlgebraDegreeOne_mem I a) n
        (⟨Polynomial.monomial n r.1, (reesAlgebra.monomial_mem).2 r.2⟩ : reesAlgebra I)
        (monomial_mem_reesAlgebraGrade_for_chart I n r)) =
      Localization.mk r.1 (selfPowerPow a.1 n) := by
  let s : reesAlgebra I := ⟨Polynomial.monomial n r.1, (reesAlgebra.monomial_mem).2 r.2⟩
  let g : reesAlgebra I →+* Localization.Away a.1 :=
    (Polynomial.eval₂RingHom (algebraMap R (Localization.Away a.1)) 1).comp
      (reesAlgebra I).toSubring.subtype
  have hg : IsUnit (g (reesAlgebraDegreeOne I a)) := by
    simpa [g, reesAlgebraDegreeOne, selfPower] using
      (IsLocalization.Away.algebraMap_isUnit a.1 :
        IsUnit (algebraMap R (Localization.Away a.1) a.1))
  have hfrac₁ (x : R) :
      algebraMap R (Localization.Away a.1) x * Localization.mk 1 (selfPower a.1) =
        Localization.mk x (selfPower a.1) := by
    -- Rewrite the denominator as a standard localization fraction and multiply it out.
    rw [← Algebra.smul_def, Localization.mk_eq_mk'_apply, IsLocalization.smul_mk'_one]
    exact (Localization.mk_eq_mk'_apply x (selfPower a.1)).symm
  have hfrac (x : R) (m : ℕ) :
      algebraMap R (Localization.Away a.1) x * Localization.mk 1 (selfPowerPow a.1 m) =
        Localization.mk x (selfPowerPow a.1 m) := by
    -- The same calculation works for every power `a ^ m`.
    rw [← Algebra.smul_def, Localization.mk_eq_mk'_apply, IsLocalization.smul_mk'_one]
    exact (Localization.mk_eq_mk'_apply x (selfPowerPow a.1 m)).symm
  have h :=
      Localization.awayLift_mk g (reesAlgebraDegreeOne I a) s
        (Localization.mk 1 (selfPower a.1))
        (by
          -- The chosen inverse of `a` is the ordinary fraction `1 / a`.
          rw [show g (reesAlgebraDegreeOne I a) = algebraMap R (Localization.Away a.1) a.1 by
            simp [g, reesAlgebraDegreeOne]]
          rw [hfrac₁]
          exact Localization.mk_self (selfPower a.1))
        n
  rw [affineBlowupChartToLocalizationAway, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
  have hpow :
      (Localization.mk 1 (selfPower a.1) : Localization.Away a.1) ^ n =
        Localization.mk 1 (selfPowerPow a.1 n) := by
    -- The `n`th power of `1 / a` is the ordinary fraction `1 / a^n`.
    rw [Localization.mk_pow, one_pow]
    apply congrArg (fun d => Localization.mk 1 d)
    ext
    simp [selfPower, selfPowerPow]
  rw [hpow] at h
  simpa [g, s, reesAlgebraDegreeOne, hfrac] using h

/-- The basic fraction `x / a` with `x ∈ I` lies in the canonical image of the affine blowup chart
`R[I/a]` in the ambient fraction field. -/
private theorem algebraMap_affineBlowupChartBasicFraction
    (I : Ideal R) (a : { a : I // (a : R) ≠ 0 }) (x : I) :
    algebraMap (affineBlowupChart I a) K (affineBlowupChartBasicFraction I a x) =
      algebraMap R K (x : R) / algebraMap R K (a : R) := by
  -- Rewrite the chart fraction through the canonical localization-away comparison map.
  change
    Localization.mapToFractionRing K (Submonoid.powers (a : R))
        (Localization.Away (a : R))
        (powers_le_nonZeroDivisors_of_noZeroDivisors a.2)
        (affineBlowupChartToLocalizationAway I a (affineBlowupChartBasicFraction I a x)) =
      algebraMap R K (x : R) / algebraMap R K (a : R)
  rw [affineBlowupChartToLocalizationAway_basicFraction]
  rw [Localization.mapToFractionRing_apply, Localization.mk_eq_mk'_apply, IsLocalization.lift_mk']
  rw [div_eq_mul_inv]
  congr 1
  simpa using congrArg Inv.inv <|
    IsUnit.coe_liftRight
      ((algebraMap R K : R →* K).restrict (Submonoid.powers (a : R)))
      (Localization.map_isUnit_of_le K (Submonoid.powers (a : R))
        (powers_le_nonZeroDivisors_of_noZeroDivisors a.2))
      (selfPower (a : R))

/-- Helper for Lemma 10.70.12: the image in the fraction field of a chart element represented by a
degree-`n` monomial numerator is the ordinary fraction `r / a^n`. -/
private theorem algebraMap_affineBlowupChart_monomialFraction
    (I : Ideal R) (a : { a : I // (a : R) ≠ 0 }) (n : ℕ) (r : ↥(I ^ n)) :
    algebraMap (affineBlowupChart I a) K
      (HomogeneousLocalization.Away.mk (reesAlgebraGrade I) (reesAlgebraDegreeOne_mem I a) n
        (⟨Polynomial.monomial n r.1, (reesAlgebra.monomial_mem).2 r.2⟩ : reesAlgebra I)
        (monomial_mem_reesAlgebraGrade_for_chart I n r)) =
      algebraMap R K r.1 / (algebraMap R K a.1) ^ n := by
  change
    Localization.mapToFractionRing K (Submonoid.powers (a : R))
        (Localization.Away (a : R))
        (powers_le_nonZeroDivisors_of_noZeroDivisors a.2)
        (affineBlowupChartToLocalizationAway I a
          (HomogeneousLocalization.Away.mk (reesAlgebraGrade I) (reesAlgebraDegreeOne_mem I a) n
            (⟨Polynomial.monomial n r.1, (reesAlgebra.monomial_mem).2 r.2⟩ : reesAlgebra I)
            (monomial_mem_reesAlgebraGrade_for_chart I n r))) =
      algebraMap R K r.1 / (algebraMap R K a.1) ^ n
  rw [affineBlowupChartToLocalizationAway_fraction_of_monomial]
  rw [Localization.mapToFractionRing_apply, Localization.mk_eq_mk'_apply, IsLocalization.lift_mk']
  rw [div_eq_mul_inv]
  have hden :
      ↑((IsUnit.liftRight
            ((algebraMap R K : R →* K).restrict (Submonoid.powers (a : R)))
            (Localization.map_isUnit_of_le K (Submonoid.powers (a : R))
              (powers_le_nonZeroDivisors_of_noZeroDivisors a.2))
            (selfPowerPow (a : R) n))) =
        algebraMap R K ((a : R) ^ n) := by
    simpa [selfPowerPow] using
      (IsUnit.coe_liftRight
        ((algebraMap R K : R →* K).restrict (Submonoid.powers (a : R)))
        (Localization.map_isUnit_of_le K (Submonoid.powers (a : R))
          (powers_le_nonZeroDivisors_of_noZeroDivisors a.2))
        (selfPowerPow (a : R) n))
  congr 1
  simpa [map_pow] using congrArg Inv.inv hden

/-- The basic fraction `x / a` with `x ∈ I` lies in the canonical image of the affine blowup chart
`R[I/a]` in the ambient fraction field. -/
theorem mem_affineBlowupChartSubring_basicFraction
    (I : Ideal R) (a : { a : I // (a : R) ≠ 0 }) (x : I) :
    algebraMap R K (x : R) / algebraMap R K (a : R) ∈
      (algebraMap (affineBlowupChart I a) K).range := by
  -- Package the explicit image formula as membership in the image subring.
  refine ⟨affineBlowupChartBasicFraction I a x, ?_⟩
  simpa using (algebraMap_affineBlowupChartBasicFraction (R := R) (K := K) I a x)

end

section

variable {R : Type u} {K : Type v} [CommRing R] [IsDomain R] [IsLocalRing R]
variable [Field K] [Algebra R K] [IsFractionRing R K]

/-- Helper for Lemma 10.70.12: the canonical algebra structure on the affine blowup chart induced
by the fraction-field embedding is available in the local-domain section as well. -/
noncomputable instance instAlgebraAffineBlowupChartFractionFieldLocal
    (I : Ideal R) (a : { a : I // (a : R) ≠ 0 }) :
    Algebra (affineBlowupChart I a) K :=
  instAlgebraAffineBlowupChartFractionField (R := R) (K := K) I a

/-- Helper for Lemma 10.70.12: the canonical map from an affine blowup chart to the ambient
fraction field. -/
private noncomputable abbrev affineBlowupChartFractionFieldMap
    (I : Ideal R) (a : { a : I // (a : R) ≠ 0 }) :
    affineBlowupChart I a →+* K :=
  @algebraMap (affineBlowupChart I a) K _ _
    (instAlgebraAffineBlowupChartFractionFieldLocal (R := R) (K := K) I a)

omit [IsDomain R] [IsLocalRing R] in
/-- Helper for Lemma 10.70.12: multiplying numerator and denominator by the same nonzero element
does not change the represented fraction in the fraction field. -/
private theorem generator_fraction_eq_scaled
    (x a b : R) (ha : a ≠ 0) (hb : b ≠ 0) :
    algebraMap R K x / algebraMap R K a =
      algebraMap R K (b * x) / algebraMap R K (b * a) := by
  have haK : algebraMap R K a ≠ 0 := by
    exact (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).2 ha
  have hbaK : algebraMap R K (b * a) ≠ 0 := by
    have hbK : algebraMap R K b ≠ 0 := by
      exact (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).2 hb
    simpa [map_mul] using mul_ne_zero hbK haK
  apply (div_eq_div_iff haK hbaK).2
  simp [map_mul, mul_left_comm, mul_comm]

omit [IsLocalRing R] in
/-- Helper for Lemma 10.70.12: if a subring of the fraction field contains the image of `R` and
the displayed basic generator fractions of a tuple-generated chart, then it contains the whole
chart image. -/
private theorem fraction_mem_of_mem_ideal_pow
    {r : ℕ} (f : Fin (r + 1) → R) (hf0 : f 0 ≠ 0) (B : Subring K)
    (hR : (algebraMap R K).range ≤ B)
    (hgen : ∀ i : Fin r, algebraMap R K (f i.succ) / algebraMap R K (f 0) ∈ B) :
    ∀ n : ℕ, ∀ {x : R}, x ∈ (Ideal.span (Set.range f)) ^ n →
      algebraMap R K x / (algebraMap R K (f 0)) ^ n ∈ B := by
  intro n
  induction n with
  | zero =>
      intro x hx
      -- Degree-zero fractions are just elements of the image of `R`.
      simpa using hR ⟨x, rfl⟩
  | succ n ih =>
      intro x hx
      have hx'' : x ∈ (Ideal.span (Set.range f)) ^ n * Ideal.span (Set.range f) := by
        simpa [pow_succ] using hx
      have hx' :
          x ∈ Ideal.span (((↑((Ideal.span (Set.range f)) ^ n) : Set R) * Set.range f) : Set R) := by
        rw [← Ideal.span_mul_span, Ideal.span_eq]
        exact hx''
      have hpow0 : f 0 ^ n ≠ 0 := pow_ne_zero n hf0
      refine Submodule.span_induction
          (p := fun y _ ↦ algebraMap R K y / (algebraMap R K (f 0)) ^ (n + 1) ∈ B)
          ?_ ?_ ?_ ?_ hx'
      · intro y hy
        rcases hy with ⟨u, hu, v, hv, rfl⟩
        rcases hv with ⟨i, rfl⟩
        have hu_mem :
            algebraMap R K u / (algebraMap R K (f 0)) ^ n ∈ B := ih hu
        refine Fin.cases ?_ ?_ i
        · -- Multiplying by the distinguished denominator `f 0` just increases the common power.
          have hscaled :
              algebraMap R K (u * f 0) / (algebraMap R K (f 0)) ^ (n + 1) =
                algebraMap R K u / (algebraMap R K (f 0)) ^ n := by
            simpa [pow_succ, map_mul, map_pow, mul_comm, mul_left_comm, mul_assoc] using
              (generator_fraction_eq_scaled (R := R) (K := K)
                u (f 0 ^ n) (f 0) hpow0 hf0).symm
          exact hscaled ▸ hu_mem
        · intro j
          -- For the other generators, the denominator-`f 0` fraction is one of the hypotheses.
          simpa [pow_succ, map_mul, map_pow, div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm]
            using B.mul_mem hu_mem (hgen j)
      · simpa using B.zero_mem
      · intro y z hy hz hy_mem hz_mem
        -- Equal denominators let us add fractions termwise.
        simpa [map_add, add_div] using B.add_mem hy_mem hz_mem
      · intro c y hy hy_mem
        have hc : algebraMap R K c ∈ B := hR ⟨c, rfl⟩
        -- Scalar multiplication on the numerator side becomes multiplication by an image of `R`.
        simpa [smul_eq_mul, map_mul, mul_div_assoc] using B.mul_mem hc hy_mem

omit [IsLocalRing R] in
private theorem affineBlowupChart_range_le_of_tuple_generators
    {r : ℕ} (f : Fin (r + 1) → R) (hf0 : f 0 ≠ 0) (B : Subring K)
    (hR : (algebraMap R K).range ≤ B)
    (hgen : ∀ i : Fin r, algebraMap R K (f i.succ) / algebraMap R K (f 0) ∈ B) :
    let I : Ideal R := Ideal.span (Set.range f)
    let a : { a : I // (a : R) ≠ 0 } := ⟨tupleSpanFirst f, hf0⟩
    (affineBlowupChartFractionFieldMap (R := R) (K := K) I a).range ≤ B := by
  dsimp
  intro y hy
  rcases hy with ⟨z, rfl⟩
  let I : Ideal R := Ideal.span (Set.range f)
  let a : { a : I // (a : R) ≠ 0 } := ⟨tupleSpanFirst f, hf0⟩
  -- Normalize the chart element to a monomial numerator in degree `n`.
  obtain ⟨n, s, hs, rfl⟩ :=
    HomogeneousLocalization.Away.mk_surjective (reesAlgebraGrade I)
      (reesAlgebraDegreeOne_mem I a) z
  have hs' : s ∈ reesAlgebraGrade I n := by
    simpa [nsmul_eq_mul] using hs
  change s ∈ LinearMap.range _ at hs'
  rcases hs' with ⟨r0, rfl⟩
  have hrange :
      algebraMap R K r0.1 / (algebraMap R K (f 0)) ^ n ∈ B := by
    simpa [I] using
      (fraction_mem_of_mem_ideal_pow (R := R) (K := K) f hf0 B hR hgen n r0.2)
  -- The normalized chart element maps to the expected ordinary fraction in the fraction field.
  have hvalue :
      affineBlowupChartFractionFieldMap (R := R) (K := K) I a
          (HomogeneousLocalization.Away.mk (reesAlgebraGrade I) (reesAlgebraDegreeOne_mem I a) n
            (⟨Polynomial.monomial n r0.1, (reesAlgebra.monomial_mem).2 r0.2⟩ : reesAlgebra I)
            (monomial_mem_reesAlgebraGrade_for_chart I n r0)) =
        algebraMap R K r0.1 / (algebraMap R K (f 0)) ^ n := by
    simpa [I, a, tupleSpanFirst, affineBlowupChartFractionFieldMap] using
      (algebraMap_affineBlowupChart_monomialFraction (R := R) (K := K) I a n r0)
  exact hvalue ▸ hrange

omit [IsLocalRing R] in
/-- Helper for Lemma 10.70.12: a generating tuple for an ideal `I` with first entry `a`
immediately yields range containment for the original chart `R[I/a]`. -/
private theorem affineBlowupChart_range_le_of_generating_tuple
    {r : ℕ} {I : Ideal R} {a : { a : I // (a : R) ≠ 0 }}
    (f : Fin (r + 1) → R) (hf0 : f 0 = a.1) (hspan : Ideal.span (Set.range f) = I)
    (B : Subring K) (hR : (algebraMap R K).range ≤ B)
    (hgen : ∀ i : Fin r, algebraMap R K (f i.succ) / algebraMap R K (f 0) ∈ B) :
    (affineBlowupChartFractionFieldMap (R := R) (K := K) I a).range ≤ B := by
  classical
  -- Route correction: rewrite once from the original chart to the tuple-generated presentation,
  -- then reuse the established tuple-range lemma instead of transporting by repeated `convert`.
  subst hspan
  have hf0' : f 0 ≠ 0 := by
    simpa [hf0] using a.2
  have haeq : (⟨tupleSpanFirst f, hf0'⟩ : { x : Ideal.span (Set.range f) // (x : R) ≠ 0 }) = a := by
    -- The chosen denominator is exactly the first tuple entry after identifying the spanning ideal.
    apply Subtype.ext
    apply Subtype.ext
    simpa [tupleSpanFirst] using hf0
  -- Apply the tuple-generated chart lemma and then rewrite back to the original denominator `a`.
  cases haeq
  exact affineBlowupChart_range_le_of_tuple_generators (R := R) (K := K) f hf0' B hR hgen

omit [IsDomain R] [IsLocalRing R] in
/-- Helper for Lemma 10.70.12: a finitely generated ideal together with a chosen element admits a
finite tuple of generators whose first entry is that chosen element. -/
private theorem exists_tuple_generating_ideal_with_first
    (I : Ideal R) (hI : I.FG) (a : I) :
    ∃ r : ℕ, ∃ f : Fin (r + 1) → R, f 0 = a.1 ∧ Ideal.span (Set.range f) = I := by
  classical
  let s : Finset R := (Submodule.FG.finite_generators hI).toFinset
  have hs_generators : (s : Set R) = I.generators := by
    exact (Submodule.FG.finite_generators hI).coe_toFinset
  let tail : Fin s.card → R := fun i ↦ (((Finset.equivFin s).symm i : s) : R)
  let f : Fin (s.card + 1) → R := Fin.cons a.1 tail
  refine ⟨s.card, f, rfl, ?_⟩
  apply le_antisymm
  · rw [Ideal.span_le]
    intro x hx
    rcases hx with ⟨i, rfl⟩
    refine Fin.cases ?_ ?_ i
    · exact a.2
    · intro j
      have hj : tail j ∈ I.generators := by
        have : tail j ∈ (s : Set R) := by
          exact ((Finset.equivFin s).symm j).2
        rwa [hs_generators] at this
      exact Submodule.FG.generators_mem (p := I) hj
  · rw [← I.span_generators]
    refine Submodule.span_le.mpr ?_
    intro x hx
    have hx' : x ∈ (s : Set R) := by
      rwa [← hs_generators] at hx
    refine Ideal.subset_span ?_
    refine ⟨(Finset.equivFin s ⟨x, hx'⟩).succ, ?_⟩
    simp [f, tail]

omit [IsDomain R] [IsLocalRing R] in
/-- Helper for Lemma 10.70.12: the product ideal `I * J` admits a finite tuple of generators
whose first entry is the distinguished product `a * b`. -/
private theorem exists_tuple_generating_mul_ideal_with_first_mul
    {I J : Ideal R} (hI : I.FG) (hJ : J.FG) (a : I) (b : J) :
    ∃ r : ℕ, ∃ f : Fin (r + 1) → R, f 0 = a.1 * b.1 ∧ Ideal.span (Set.range f) = I * J := by
  -- The source route uses the actual product ideal `I * J`, so first package its finite generation.
  have hIJ : (I * J).FG := hI.mul hJ
  let ab : I * J := ⟨a.1 * b.1, Ideal.mul_mem_mul a.2 b.2⟩
  -- Then reuse the general finite-generator tuple construction with the chosen first entry.
  exact exists_tuple_generating_ideal_with_first (R := R) (I * J) hIJ ab

