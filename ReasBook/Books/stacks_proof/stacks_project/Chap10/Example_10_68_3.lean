/-- Helper for Chap10 Example 10 68 3: cache multiplication as scalar action on the quotient
ring. -/
noncomputable local instance : SMul (example10683Ring k) (example10683Ring k) where
  smul := (· * ·)

private abbrev example10683LocalRing :=
  Localization (example10683LocalizedIdeal k).primeCompl

/-- Helper for Chap10 Example 10 68 3: cache multiplication as the distributive self-action on
the localized ring. -/
noncomputable local instance : DistribMulAction (example10683LocalRing k) (example10683LocalRing k) where
  smul := (· * ·)
  one_smul := one_mul
  mul_smul := mul_assoc
  smul_zero := mul_zero
