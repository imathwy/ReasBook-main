/-- Helper for Chap10 Example 10 68 3: a fresh variable is regular modulo an ideal generated by
other variables. -/
private lemma variable_isSMulRegular_quotient_variableSpan
    {σ : Type*} {R : Type u} [CommRing R] {s : Set σ} {i : σ}
    (hi : i ∉ s) :
    IsSMulRegular ((MvPolynomial σ R) ⧸
      (Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R)) •
        (⊤ : Submodule (MvPolynomial σ R) (MvPolynomial σ R))))
      (X i : MvPolynomial σ R) := by
  -- Proof comment: if `X_i p` is supported only on the variables from `s`, then every monomial
  -- of `p` already has a variable from `s`, since `i` itself is not in `s`.
  classical
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
  intro p hp
  rw [Ideal.smul_eq_mul, Ideal.mul_top] at hp ⊢
  rw [MvPolynomial.mem_ideal_span_X_image] at hp ⊢
  intro m hm
  have hmem : Finsupp.single i 1 + m ∈ (X i * p).support := by
    rw [MvPolynomial.support_X_mul]
    exact Finset.mem_map.mpr ⟨m, hm, rfl⟩
  rcases hp _ hmem with ⟨j, hjs, hj⟩
  refine ⟨j, hjs, ?_⟩
  have hji : j ≠ i := by
    intro h
    exact hi (h ▸ hjs)
  simpa [Finsupp.single_eq_of_ne hji] using hj

/-- Helper for Chap10 Example 10 68 3: canceling a fresh variable preserves membership in a
variable-span ideal. -/
private lemma mem_variableSpan_of_mul_X_mem_variableSpan
    {σ : Type*} {R : Type u} [CommRing R] {s : Set σ} {i : σ}
    (hi : i ∉ s) {p : MvPolynomial σ R}
    (hp : X i * p ∈ Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R))) :
    p ∈ Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R)) := by
  -- Proof comment: use the quotient regularity criterion and then translate the quotient
  -- submodule membership back to ideal membership in the polynomial ring.
  have hreg := variable_isSMulRegular_quotient_variableSpan (R := R) hi
  rw [isSMulRegular_quotient_iff_mem_of_smul_mem] at hreg
  have hp' :
      (X i : MvPolynomial σ R) • p ∈
        Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R)) •
          (⊤ : Submodule (MvPolynomial σ R) (MvPolynomial σ R)) := by
    simpa [Ideal.smul_eq_mul, Ideal.mul_top, smul_eq_mul] using hp
  have h := hreg p hp'
  simpa [Ideal.smul_eq_mul, Ideal.mul_top] using h

/-- Helper for Chap10 Example 10 68 3: the preimage of a principal ideal generated by a quotient
class is the sum of the original kernel and the principal ideal upstairs. -/
private lemma preimage_span_quotient_mk_singleton
    {A : Type u} [CommRing A] (I : Ideal A) (a p : A) :
    Ideal.Quotient.mk I p ∈ Ideal.span ({Ideal.Quotient.mk I a} : Set (A ⧸ I)) ↔
      p ∈ I ⊔ Ideal.span ({a} : Set A) := by
  -- Proof comment: rewrite the principal ideal as the image of the principal ideal upstairs, then
  -- use the comap-map formula for a surjective quotient map.
  have hmap : (Ideal.span ({a} : Set A)).map (Ideal.Quotient.mk I) =
      Ideal.span ({Ideal.Quotient.mk I a} : Set (A ⧸ I)) := by
    rw [Ideal.map_span]
    congr 1
    ext z
    constructor
    · rintro ⟨b, hb, rfl⟩
      rw [Set.mem_singleton_iff] at hb ⊢
      rw [hb]
    · intro hz
      rw [Set.mem_singleton_iff] at hz
      refine ⟨a, by simp, ?_⟩
      rw [hz]
  rw [← hmap]
  change p ∈ (Ideal.map (Ideal.Quotient.mk I) (Ideal.span {a})).comap
      (Ideal.Quotient.mk I) ↔ p ∈ I ⊔ Ideal.span {a}
  rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective]
  rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
  rw [sup_comm]

/-- Helper for Chap10 Example 10 68 3: after adding `x`, the defining ideal is generated by
`x` and all the `w_i`. -/
private lemma example10683Ideal_sup_span_x_eq_noY_variableSpan :
    example10683Ideal k ⊔ Ideal.span ({X x} : Set (example10683PolynomialRing k)) =
      Ideal.span
        (MvPolynomial.X '' (Set.insert x (Set.range w) : Set Example10683Var) :
          Set (example10683PolynomialRing k)) := by
  -- Proof comment: modulo `x`, the recurrence relations reduce to `w_i`; conversely all defining
  -- relations are built from `x` and the `w_i`.
  let J : Ideal (example10683PolynomialRing k) :=
    Ideal.span
      (MvPolynomial.X '' (Set.insert x (Set.range w) : Set Example10683Var) :
        Set (example10683PolynomialRing k))
  apply le_antisymm
  · refine sup_le ?_ ?_
    · rw [example10683Ideal, example10683Relations]
      refine Ideal.span_le.mpr ?_
      rintro p (⟨i, rfl⟩ | ⟨i, rfl⟩)
      · have hw_mem : X (w i) ∈ J :=
          Ideal.subset_span ⟨w i, Set.mem_insert_of_mem _ ⟨i, rfl⟩, rfl⟩
        exact J.mul_mem_left (X y) hw_mem
      · have hw_mem : X (w i) ∈ J :=
          Ideal.subset_span ⟨w i, Set.mem_insert_of_mem _ ⟨i, rfl⟩, rfl⟩
        have hxw_mem : X x * X (w (i + 1)) ∈ J := by
          have hnext : X (w (i + 1)) ∈ J :=
            Ideal.subset_span ⟨w (i + 1), Set.mem_insert_of_mem _ ⟨i + 1, rfl⟩, rfl⟩
          exact J.mul_mem_left (X x) hnext
        exact J.sub_mem hw_mem hxw_mem
    · refine Ideal.span_le.mpr ?_
      intro p hp
      rw [Set.mem_singleton_iff] at hp
      rw [hp]
      exact Ideal.subset_span ⟨x, Set.mem_insert _ _, rfl⟩
  · refine Ideal.span_le.mpr ?_
    rintro p ⟨v, hv, rfl⟩
    rcases Set.mem_insert_iff.mp hv with rfl | hv
    · exact Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton (X x)))
    · rcases hv with ⟨i, rfl⟩
      let L : Ideal (example10683PolynomialRing k) :=
        example10683Ideal k ⊔ Ideal.span ({X x} : Set (example10683PolynomialRing k))
      have hrel : example10683WRecurrenceRelation k i ∈ L :=
        Ideal.mem_sup_left (example10683WRecurrenceRelation_mem_ideal k i)
      have hxw : X x * X (w (i + 1)) ∈ L := by
        have hx_mem : X x ∈ Ideal.span ({X x} : Set (example10683PolynomialRing k)) :=
          Ideal.subset_span (Set.mem_singleton (X x))
        exact Ideal.mem_sup_right
          ((Ideal.span ({X x} : Set (example10683PolynomialRing k))).mul_mem_right
            (X (w (i + 1))) hx_mem)
      have hsum : example10683WRecurrenceRelation k i + X x * X (w (i + 1)) ∈ L :=
        L.add_mem hrel hxw
      have hidentity :
          example10683WRecurrenceRelation k i + X x * X (w (i + 1)) = X (w i) := by
        simp [example10683WRecurrenceRelation]
      simpa [hidentity] using hsum

/-- Helper for Chap10 Example 10 68 3: membership in the image of `(x)` is detected upstairs by
the variable-span ideal generated by `x` and the `w_i`. -/
private lemma example10683_mk_mem_span_x_iff {p : example10683PolynomialRing k} :
    Ideal.Quotient.mk (example10683Ideal k) p ∈
        Ideal.span ({example10683x k} : Set (example10683Ring k)) ↔
      p ∈ Ideal.span
        (MvPolynomial.X '' (Set.insert x (Set.range w) : Set Example10683Var) :
          Set (example10683PolynomialRing k)) := by
  -- Proof comment: combine the general preimage formula for a principal quotient ideal with the
  -- explicit normalization of the ideal after adjoining `x`.
  rw [example10683x]
  rw [preimage_span_quotient_mk_singleton]
  rw [example10683Ideal_sup_span_x_eq_noY_variableSpan]

/-- Helper for Chap10 Example 10 68 3: `y` is regular on the quotient by `x`, still regarded as
a module over the original quotient ring. -/
private lemma example10683_y_isSMulRegular_mod_x_base :
    IsSMulRegular
      (example10683Ring k ⧸ Ideal.span ({example10683x k} : Set (example10683Ring k)))
      (example10683y k) := by
  -- Proof comment: lift a killed class to a polynomial representative, cancel the fresh variable
  -- `y` modulo the span of `x` and the `w_i`, then descend the result back to the quotient.
  refine (isSMulRegular_quotient_iff_mem_of_smul_mem
    (N := (Ideal.span ({example10683x k} : Set (example10683Ring k)) :
      Submodule (example10683Ring k) (example10683Ring k)))
    (r := example10683y k)).mpr ?_
  intro r hr
  revert hr
  refine Quotient.inductionOn' r ?_
  intro p hp
  have hy_not_mem : y ∉ Set.insert x (Set.range w : Set Example10683Var) := by
    intro hy
    rcases Set.mem_insert_iff.mp hy with hyx | hyw
    · cases hyx
    · rcases hyw with ⟨i, hi⟩
      cases hi
  have hp_mul :
      X y * p ∈ Ideal.span
        (MvPolynomial.X '' (Set.insert x (Set.range w) : Set Example10683Var) :
          Set (example10683PolynomialRing k)) := by
    rw [← example10683_mk_mem_span_x_iff (k := k)]
    simpa [example10683y, mul_comm] using hp
  have hp_mem :
      p ∈ Ideal.span
        (MvPolynomial.X '' (Set.insert x (Set.range w) : Set Example10683Var) :
          Set (example10683PolynomialRing k)) :=
    mem_variableSpan_of_mul_X_mem_variableSpan (R := k) hy_not_mem hp_mul
  exact (example10683_mk_mem_span_x_iff (k := k) (p := p)).mpr hp_mem

/-- Helper for Chap10 Example 10 68 3: the defining ideal is contained in the kernel of the
constant-coefficient residue map. -/
private lemma example10683Ideal_le_ker_constantCoeff :
    example10683Ideal k ≤
      RingHom.ker (MvPolynomial.constantCoeff :
        example10683PolynomialRing k →+* k) := by
  -- Proof comment: the defining ideal is contained in the ideal of all variables, and every
  -- polynomial in that ideal has zero constant coefficient.
  intro p hp
  rw [RingHom.mem_ker]
  exact constantCoeff_eq_zero_of_mem_idealOfVars
    (σ := Example10683Var) (R := k) (p := p) (example10683Ideal_le_idealOfVars k hp)

/-- Helper for Chap10 Example 10 68 3: the residue map sending all variables to zero. -/
private def example10683ResidueMap : example10683Ring k →+* k :=
  Ideal.Quotient.lift (example10683Ideal k)
    (MvPolynomial.constantCoeff : example10683PolynomialRing k →+* k)
    (example10683Ideal_le_ker_constantCoeff k)

/-- Helper for Chap10 Example 10 68 3: `x` lies in the kernel of the residue map. -/
private lemma example10683x_mem_ker_residueMap :
    example10683x k ∈ RingHom.ker (example10683ResidueMap k) := by
  -- Proof comment: the residue map is constant coefficient, so every variable maps to zero.
  rw [RingHom.mem_ker]
  simp [example10683ResidueMap, example10683x, MvPolynomial.constantCoeff_X]

/-- Helper for Chap10 Example 10 68 3: the principal ideal `(x)` is contained in the residue-map
kernel. -/
private lemma example10683_span_x_le_ker_residueMap :
    Ideal.span ({example10683x k} : Set (example10683Ring k)) ≤
      RingHom.ker (example10683ResidueMap k) := by
  -- Proof comment: an ideal map to a kernel is controlled by its generators.
  rw [Ideal.span_le]
  intro r hr
  rw [Set.mem_singleton_iff] at hr
  rw [hr]
  exact example10683x_mem_ker_residueMap k

/-- Helper for Chap10 Example 10 68 3: the residue map after quotienting by `x`. -/
private def example10683ResidueMapModX :
    (example10683Ring k ⧸ Ideal.span ({example10683x k} : Set (example10683Ring k))) →+* k :=
  Ideal.Quotient.lift (Ideal.span ({example10683x k} : Set (example10683Ring k)))
    (example10683ResidueMap k) (example10683_span_x_le_ker_residueMap k)

/-- Helper for Chap10 Example 10 68 3: `y` maps to zero under the residue map modulo `x`. -/
private lemma example10683ResidueMapModX_y :
    example10683ResidueMapModX k
        (Ideal.Quotient.mk (Ideal.span ({example10683x k} : Set (example10683Ring k)))
          (example10683y k)) = 0 := by
  -- Proof comment: the residue map kills the polynomial variable `y`.
  simp [example10683ResidueMapModX, example10683ResidueMap, example10683y,
    MvPolynomial.constantCoeff_X]

/-- Helper for Chap10 Example 10 68 3: the ordinary quotient of the example ring by `(x)`. -/
private abbrev example10683QuotientByX :=
  example10683Ring k ⧸ Ideal.span ({example10683x k} : Set (example10683Ring k))

/-- Helper for Chap10 Example 10 68 3: the image of `y` in the ordinary quotient by `(x)`. -/
private def example10683yModX : example10683QuotientByX k :=
  Ideal.Quotient.mk (Ideal.span ({example10683x k} : Set (example10683Ring k)))
    (example10683y k)

/-- Helper for Chap10 Example 10 68 3: cache the canonical self-module structure on the quotient
by `(x)` without reconstructing it through typeclass search. -/
noncomputable local instance : Module (example10683QuotientByX k) (example10683QuotientByX k) :=
  example10683SelfModule (example10683QuotientByX k)

/-- Helper for Chap10 Example 10 68 3: cache multiplication as scalar action on the quotient by
`(x)`. -/
noncomputable local instance : SMul (example10683QuotientByX k) (example10683QuotientByX k) where
  smul := (· * ·)

/-- Helper for Chap10 Example 10 68 3: `y` acts injectively on the quotient by `(x)` when
viewed as a scalar from that quotient. -/
private lemma example10683_yModX_isSMulRegular :
    IsSMulRegular (example10683QuotientByX k) (example10683yModX k) := by
  -- Proof comment: transfer the already proved original-ring scalar regularity across the
  -- quotient map; both scalar actions are multiplication by the same quotient class.
  dsimp [example10683yModX, example10683QuotientByX]
  rw [isSMulRegular_map
    (M := example10683Ring k ⧸ Ideal.span ({example10683x k} : Set (example10683Ring k)))
    (f := Ideal.Quotient.mk (Ideal.span ({example10683x k} : Set (example10683Ring k))))
    (a := example10683y k)]
  · exact example10683_y_isSMulRegular_mod_x_base k
  · intro q
    rcases Quotient.exists_rep q with ⟨q, rfl⟩
    rfl

/-- Helper for Chap10 Example 10 68 3: the image of `y` is a regular singleton sequence on the
ordinary quotient by `(x)`. -/
private lemma example10683_yModX_span_ne_top :
    Ideal.span ({example10683yModX k} : Set (example10683QuotientByX k)) ≠ ⊤ := by
  -- Proof comment: the residue map modulo `(x)` kills `y`, so a quotient by `y` still maps
  -- onto the nonzero field `k`.
  intro htop
  have hle :
      Ideal.span ({example10683yModX k} : Set (example10683QuotientByX k)) ≤
        RingHom.ker (example10683ResidueMapModX k) := by
    rw [Ideal.span_le]
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    rw [hz]
    change example10683ResidueMapModX k (example10683yModX k) = 0
    simpa [example10683yModX] using example10683ResidueMapModX_y k
  have hone :
      (1 : example10683QuotientByX k) ∈
        Ideal.span ({example10683yModX k} : Set (example10683QuotientByX k)) := by
    rw [htop]
    exact Submodule.mem_top
  have hone_zero : (1 : k) = 0 := by
    simpa [RingHom.mem_ker] using hle hone
  exact one_ne_zero hone_zero

/-- Helper for Chap10 Example 10 68 3: the image of `y` is a regular singleton sequence on the
ordinary quotient by `(x)`. -/
private lemma example10683_yModX_regularSequence :
    Sequence.IsRegular (example10683QuotientByX k) [example10683yModX k] := by
  -- Proof comment: the weak regularity is already isolated in `example10683_yModX_isSMulRegular`;
  -- the remaining field is nontriviality after quotienting by `y`.
  refine ⟨(isWeaklyRegular_singleton_iff
    (example10683QuotientByX k) (example10683yModX k)).2
    (example10683_yModX_isSMulRegular k), ?_⟩
  intro htop
  have hone_smul :
      (1 : example10683QuotientByX k) ∈
        Ideal.ofList [example10683yModX k] •
          (⊤ : Submodule (example10683QuotientByX k) (example10683QuotientByX k)) := by
    rw [← htop]
    exact Submodule.mem_top
  have hone_span :
      (1 : example10683QuotientByX k) ∈
        Ideal.span ({example10683yModX k} : Set (example10683QuotientByX k)) := by
    -- Proof comment: an element of `Ideal.ofList [y] • ⊤` is a finite sum of multiples by
    -- elements of `(y)`, hence lies in the ordinary principal ideal `(y)`.
    refine Submodule.smul_induction_on hone_smul ?_ ?_
    · intro a ha b _
      have ha_span :
          a ∈ Ideal.span ({example10683yModX k} : Set (example10683QuotientByX k)) := by
        simpa [Ideal.ofList_singleton] using ha
      change a * b ∈ Ideal.span ({example10683yModX k} : Set (example10683QuotientByX k))
      exact (Ideal.span ({example10683yModX k} : Set (example10683QuotientByX k))).mul_mem_right
        b ha_span
    · intro a b ha hb
      exact (Ideal.span ({example10683yModX k} : Set (example10683QuotientByX k))).add_mem
        ha hb
  exact (example10683_yModX_span_ne_top k)
    ((Ideal.eq_top_iff_one _).mpr hone_span)

/-- Helper for Chap10 Example 10 68 3: regularity on `QuotSMulTop r A` is the same as
regularity on the principal ring quotient by `(r)`, with the tail scalars mapped to the quotient. -/
private theorem isRegular_quotSMulTop_iff_quotient_span_singleton
    {A : Type u} [CommRing A] {r : A} {rs : List A} :
    Sequence.IsRegular (QuotSMulTop r A) rs ↔
      Sequence.IsRegular (A ⧸ Ideal.span ({r} : Set A))
        (rs.map (Ideal.Quotient.mk (Ideal.span ({r} : Set A)))) := by
  have hspan : Ideal.span ({r} : Set A) = r • (⊤ : Ideal A) := by
    -- Proof comment: identify the ordinary principal ideal with the submodule used by
    -- `QuotSMulTop`.
    simp [smul_eq_mul, ← Submodule.ideal_span_singleton_smul]
  let e : QuotSMulTop r A ≃+ A ⧸ Ideal.span ({r} : Set A) :=
    (Ideal.quotientEquivAlgOfEq A hspan).symm.toRingEquiv.toAddEquiv
  -- Proof comment: scalar compatibility is checked on quotient representatives, where both
  -- actions are multiplication by the same residue class.
  refine e.isRegular_congr <| List.forall₂_map_right_iff.mpr ?_
  rw [List.forall₂_same]
  intro a _ x
  change e (a • x) = Ideal.Quotient.mk (Ideal.span ({r} : Set A)) a • e x
  rcases Quotient.exists_rep x with ⟨y, rfl⟩
  rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
  simp [e, smul_eq_mul]

/-- Helper for Chap10 Example 10 68 3: the finite-stage relation set using only
`y*w_i` for `i <= N` and `w_i - x*w_(i+1)` for `i < N`. -/
private def example10683FiniteRelations (N : ℕ) : Set (example10683PolynomialRing k) :=
  {q | (∃ i, i ≤ N ∧ q = example10683YMulWRelation k i) ∨
    ∃ i, i < N ∧ q = example10683WRecurrenceRelation k i}

/-- Helper for Chap10 Example 10 68 3: the finite-stage ideal generated by relations up to
level `N`. -/
private def example10683FiniteIdeal (N : ℕ) : Ideal (example10683PolynomialRing k) :=
  Ideal.span (example10683FiniteRelations k N)

/-- Helper for Chap10 Example 10 68 3: each finite `y*w_i` generator lies in the matching
finite-stage ideal. -/
private lemma example10683YMulWRelation_mem_finiteIdeal {N i : ℕ} (hi : i ≤ N) :
    example10683YMulWRelation k i ∈ example10683FiniteIdeal k N := by
  -- Proof comment: the finite-stage ideal is the span of exactly these bounded generators.
  exact Ideal.subset_span (Or.inl ⟨i, hi, rfl⟩)

/-- Helper for Chap10 Example 10 68 3: each finite recurrence generator lies in the matching
finite-stage ideal. -/
private lemma example10683WRecurrenceRelation_mem_finiteIdeal {N i : ℕ} (hi : i < N) :
    example10683WRecurrenceRelation k i ∈ example10683FiniteIdeal k N := by
  -- Proof comment: recurrences at levels strictly below `N` are included in the finite stage.
  exact Ideal.subset_span (Or.inr ⟨i, hi, rfl⟩)

/-- Helper for Chap10 Example 10 68 3: finite-stage ideals form an increasing chain. -/
private lemma example10683FiniteIdeal_mono {N M : ℕ} (hNM : N ≤ M) :
    example10683FiniteIdeal k N ≤ example10683FiniteIdeal k M := by
  -- Proof comment: every bounded generator for stage `N` is also a bounded generator for any
  -- later stage `M`.
  rw [example10683FiniteIdeal]
  refine Ideal.span_mono ?_
  rintro q (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
  · exact Or.inl ⟨i, hi.trans hNM, rfl⟩
  · exact Or.inr ⟨i, hi.trans_le hNM, rfl⟩

/-- Helper for Chap10 Example 10 68 3: each finite-stage ideal is contained in the global
defining ideal. -/
private lemma example10683FiniteIdeal_le_ideal (N : ℕ) :
    example10683FiniteIdeal k N ≤ example10683Ideal k := by
  -- Proof comment: bounded generators are a subset of the original infinite relation family.
  rw [example10683FiniteIdeal, example10683Ideal, example10683Relations]
  refine Ideal.span_le.mpr ?_
  rintro q (⟨i, -, rfl⟩ | ⟨i, -, rfl⟩)
  · exact Ideal.subset_span (Or.inl ⟨i, rfl⟩)
  · exact Ideal.subset_span (Or.inr ⟨i, rfl⟩)

/-- Helper for Chap10 Example 10 68 3: the global defining ideal is the directed supremum of
the finite-stage ideals. -/
private lemma example10683Ideal_eq_iSup_finiteIdeal :
    example10683Ideal k = ⨆ N : ℕ, example10683FiniteIdeal k N := by
  -- Proof comment: each infinite generator appears at a sufficiently large finite stage, and
  -- every finite-stage generator is one of the original defining relations.
  apply le_antisymm
  · rw [example10683Ideal, example10683Relations]
    refine Ideal.span_le.mpr ?_
    rintro q (⟨i, rfl⟩ | ⟨i, rfl⟩)
    · exact Ideal.mem_iSup_of_mem i
        (example10683YMulWRelation_mem_finiteIdeal k (N := i) (i := i) le_rfl)
    · exact Ideal.mem_iSup_of_mem (i + 1)
        (example10683WRecurrenceRelation_mem_finiteIdeal k (N := i + 1) (i := i)
          (Nat.lt_succ_self i))
  · exact iSup_le fun N ↦ example10683FiniteIdeal_le_ideal k N

/-- Helper for Chap10 Example 10 68 3: the finite-stage ideals are directed. -/
private lemma example10683FiniteIdeal_directed :
    Directed (· ≤ ·) (fun N : ℕ ↦ example10683FiniteIdeal k N) := by
  -- Proof comment: two stages are both contained in their maximum.
  intro N M
  refine ⟨max N M, ?_, ?_⟩
  · exact example10683FiniteIdeal_mono k (le_max_left N M)
  · exact example10683FiniteIdeal_mono k (le_max_right N M)

/-- Helper for Chap10 Example 10 68 3: the finite collapse sends `w_i` with `i <= N` to
`x^(N-i) w_N` and fixes all later `w` variables. -/
private def example10683FiniteCollapseVar (N : ℕ) :
    Example10683Var → example10683PolynomialRing k :=
  fun
    | x => X x
    | y => X y
    | w i => if i ≤ N then X x ^ (N - i) * X (w N) else X (w i)

/-- Helper for Chap10 Example 10 68 3: the finite collapse endomorphism induced by the
finite-stage variable substitution. -/
private def example10683FiniteCollapse (N : ℕ) :
    example10683PolynomialRing k →+* example10683PolynomialRing k :=
  MvPolynomial.eval₂Hom (MvPolynomial.C : k →+* example10683PolynomialRing k)
    (example10683FiniteCollapseVar k N)

/-- Helper for Chap10 Example 10 68 3: a polynomial is congruent modulo `I` to its image under
an evaluation map whenever all variables are congruent to their images. -/
private lemma sub_eval₂Hom_mem_of_X_sub_mem {σ : Type*} {R : Type u} [CommRing R]
    {φ : σ → MvPolynomial σ R} {I : Ideal (MvPolynomial σ R)}
    (hφ : ∀ i, X i - φ i ∈ I) (p : MvPolynomial σ R) :
    p - MvPolynomial.eval₂Hom (MvPolynomial.C : R →+* MvPolynomial σ R) φ p ∈ I := by
  -- Proof comment: pass to the quotient by `I`; the two polynomial maps agree on constants and
  -- variables, so they agree on every polynomial.
  have hhom :
      (Ideal.Quotient.mk I).comp
          (MvPolynomial.eval₂Hom (MvPolynomial.C : R →+* MvPolynomial σ R) φ) =
        Ideal.Quotient.mk I := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp
    · intro i
      have hzero : Ideal.Quotient.mk I (X i - φ i) = 0 :=
        eq_zero_iff_mem.mpr (hφ i)
      have hsub :
          Ideal.Quotient.mk I (X i) - Ideal.Quotient.mk I (φ i) = 0 := by
        simpa using hzero
      simpa [RingHom.comp_apply] using (sub_eq_zero.mp hsub).symm
  have hpoint :
      Ideal.Quotient.mk I
          (MvPolynomial.eval₂Hom (MvPolynomial.C : R →+* MvPolynomial σ R) φ p) =
        Ideal.Quotient.mk I p := by
    simpa [RingHom.comp_apply] using
      congrArg (fun f : MvPolynomial σ R →+* MvPolynomial σ R ⧸ I ↦ f p) hhom
  have hzero : Ideal.Quotient.mk I
      (p - MvPolynomial.eval₂Hom (MvPolynomial.C : R →+* MvPolynomial σ R) φ p) = 0 := by
    rw [map_sub, hpoint, sub_self]
  exact eq_zero_iff_mem.mp hzero

/-- Helper for Chap10 Example 10 68 3: within a finite stage, each `w_i` is congruent to
`x^m w_(i+m)`. -/
private lemma example10683_w_sub_power_w_mem_finiteIdeal (i m : ℕ) :
    X (w i) - X x ^ m * X (w (i + m)) ∈ example10683FiniteIdeal k (i + m) := by
  -- Proof comment: telescope the recurrence relations from level `i` to level `i + m`.
  induction m generalizing i with
  | zero =>
      simp
  | succ m ih =>
      have hrel :
          example10683WRecurrenceRelation k i ∈ example10683FiniteIdeal k (i + (m + 1)) :=
        example10683WRecurrenceRelation_mem_finiteIdeal k (N := i + (m + 1)) (i := i)
          (by omega)
      have hind :
          X (w (i + 1)) - X x ^ m * X (w ((i + 1) + m)) ∈
            example10683FiniteIdeal k (i + (m + 1)) := by
        simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ih (i + 1)
      have hxhind :
          X x * (X (w (i + 1)) - X x ^ m * X (w ((i + 1) + m))) ∈
            example10683FiniteIdeal k (i + (m + 1)) :=
        (example10683FiniteIdeal k (i + (m + 1))).mul_mem_left (X x) hind
      have hsum :
          example10683WRecurrenceRelation k i +
              X x * (X (w (i + 1)) - X x ^ m * X (w ((i + 1) + m))) ∈
            example10683FiniteIdeal k (i + (m + 1)) :=
        (example10683FiniteIdeal k (i + (m + 1))).add_mem hrel hxhind
      have hidentity :
          example10683WRecurrenceRelation k i +
              X x * (X (w (i + 1)) - X x ^ m * X (w ((i + 1) + m))) =
            X (w i) - X x ^ (m + 1) * X (w (i + (m + 1))) := by
        have hidx : (i + 1) + m = i + (m + 1) := by omega
        rw [example10683WRecurrenceRelation, hidx]
        ring
      simpa [hidentity] using hsum

/-- Helper for Chap10 Example 10 68 3: every polynomial is congruent to its finite collapse
modulo the corresponding finite-stage ideal. -/
private lemma example10683_sub_finiteCollapse_mem_finiteIdeal
    (N : ℕ) (p : example10683PolynomialRing k) :
    p - example10683FiniteCollapse k N p ∈ example10683FiniteIdeal k N := by
  -- Proof comment: it suffices to check the congruence on variables; the `w_i` cases are exactly
  -- the telescoped recurrence congruences.
  refine sub_eval₂Hom_mem_of_X_sub_mem
    (I := example10683FiniteIdeal k N)
    (φ := example10683FiniteCollapseVar k N)
    ?_ p
  intro v
  cases v with
  | x =>
      simp [example10683FiniteCollapseVar]
  | y =>
      simp [example10683FiniteCollapseVar]
  | w i =>
      by_cases hi : i ≤ N
      · have htel :
            X (w i) - X x ^ (N - i) * X (w (i + (N - i))) ∈
              example10683FiniteIdeal k (i + (N - i)) :=
          example10683_w_sub_power_w_mem_finiteIdeal k i (N - i)
        simpa [example10683FiniteCollapseVar, hi, Nat.add_sub_of_le hi] using htel
      · simp [example10683FiniteCollapseVar, hi]

/-- Helper for Chap10 Example 10 68 3: the principal ideal generated by `y*w_N` is the
corresponding singleton monomial ideal. -/
private lemma example10683SpanYW_eq_monomialSpan (N : ℕ) :
    Ideal.span ({(X y * X (w N) : example10683PolynomialRing k)} :
        Set (example10683PolynomialRing k)) =
      Ideal.span ((fun s : Example10683Var →₀ ℕ => MvPolynomial.monomial s (1 : k)) ''
        ({Finsupp.single y 1 + Finsupp.single (w N) 1} : Set (Example10683Var →₀ ℕ))) := by
  -- Proof comment: rewrite the product of the two variables as the single monomial whose
  -- exponent vector has one `y` and one `w_N`.
  congr 1
  ext z
  simp only [Set.mem_singleton_iff, Set.mem_image]
  constructor
  · intro hz
    subst hz
    refine ⟨Finsupp.single y 1 + Finsupp.single (w N) 1, rfl, ?_⟩
    rw [X, X, MvPolynomial.monomial_mul]
    simp
  · rintro ⟨s, hs, rfl⟩
    rw [hs]
    rw [X, X, MvPolynomial.monomial_mul]
    simp

/-- Helper for Chap10 Example 10 68 3: the principal monomial ideal `(y*w_N)` is saturated by
multiplication by the fresh variable `x`. -/
private lemma example10683_mem_span_yw_of_X_mul_mem_span_yw
    (N : ℕ) {q : example10683PolynomialRing k}
    (hq : X x * q ∈
      Ideal.span ({(X y * X (w N) : example10683PolynomialRing k)} :
        Set (example10683PolynomialRing k))) :
    q ∈ Ideal.span ({(X y * X (w N) : example10683PolynomialRing k)} :
      Set (example10683PolynomialRing k)) := by
  -- Proof comment: support of `X x * q` is obtained by adding one `x` exponent; since the
  -- generator `y*w_N` has no `x` exponent, divisibility by it was already present in `q`.
  rw [example10683SpanYW_eq_monomialSpan] at hq ⊢
  rw [MvPolynomial.mem_ideal_span_monomial_image] at hq ⊢
  intro m hm
  have hmem : Finsupp.single x 1 + m ∈ (X x * q).support := by
    rw [MvPolynomial.support_X_mul]
    exact Finset.mem_map.mpr ⟨m, hm, rfl⟩
  rcases hq _ hmem with ⟨s, hs, hsle⟩
  rw [Set.mem_singleton_iff] at hs
  rw [hs] at hsle
  refine ⟨Finsupp.single y 1 + Finsupp.single (w N) 1, Set.mem_singleton _, ?_⟩
  intro v
  by_cases hvx : v = x
  · subst hvx
    simp
  · have hcoord := hsle v
    simpa [Finsupp.add_apply, Finsupp.single_eq_of_ne hvx] using hcoord

/-- Helper for Chap10 Example 10 68 3: the finite collapse sends any finite-stage ideal element
into the principal ideal `(y*w_N)`. -/
private lemma example10683_finiteCollapse_mem_yw_of_mem_finiteIdeal
    {N : ℕ} {p : example10683PolynomialRing k}
    (hp : p ∈ example10683FiniteIdeal k N) :
    example10683FiniteCollapse k N p ∈
      Ideal.span ({(X y * X (w N) : example10683PolynomialRing k)} :
        Set (example10683PolynomialRing k)) := by
  -- Proof comment: check the two finite generator families.  The recurrence generators collapse
  -- to zero, and each `y*w_i` collapses to an `x`-multiple of `y*w_N`.
  let L : Ideal (example10683PolynomialRing k) :=
    Ideal.span ({(X y * X (w N) : example10683PolynomialRing k)} :
      Set (example10683PolynomialRing k))
  have hle :
      example10683FiniteIdeal k N ≤ L.comap (example10683FiniteCollapse k N) := by
    rw [example10683FiniteIdeal]
    refine Ideal.span_le.mpr ?_
    rintro q (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
    · change example10683FiniteCollapse k N (example10683YMulWRelation k i) ∈ L
      have hyw : X y * X (w N) ∈ L :=
        Ideal.subset_span (Set.mem_singleton (X y * X (w N)))
      have hmul : X x ^ (N - i) * (X y * X (w N)) ∈ L :=
        L.mul_mem_left (X x ^ (N - i)) hyw
      simpa [L, example10683FiniteCollapse, example10683FiniteCollapseVar,
        example10683YMulWRelation, hi, mul_assoc, mul_comm, mul_left_comm] using hmul
    · change example10683FiniteCollapse k N (example10683WRecurrenceRelation k i) ∈ L
      have hi_le : i ≤ N := le_of_lt hi
      have hsucc_le : i + 1 ≤ N := Nat.succ_le_iff.mpr hi
      have hexp : N - i = (N - (i + 1)) + 1 := by omega
      have hcollapse :
          example10683FiniteCollapse k N (example10683WRecurrenceRelation k i) = 0 := by
        suffices
            (X x : example10683PolynomialRing k) ^ (N - i) * X (w N) -
                X x * ((X x : example10683PolynomialRing k) ^ (N - (i + 1)) *
                  X (w N)) = 0 by
          simpa only [example10683FiniteCollapse, example10683FiniteCollapseVar,
            example10683WRecurrenceRelation, map_sub, map_mul, MvPolynomial.eval₂Hom_X',
            if_pos hi_le, if_pos hsucc_le] using this
        have hpow :
            (X x : example10683PolynomialRing k) ^ (N - i) =
              X x * (X x : example10683PolynomialRing k) ^ (N - (i + 1)) := by
          simpa [hexp, pow_succ, mul_comm]
        rw [hpow]
        ring
      rw [hcollapse]
      exact L.zero_mem
  exact hle hp

/-- Helper for Chap10 Example 10 68 3: the principal ideal `(y*w_N)` is contained in the
finite-stage ideal at level `N`. -/
private lemma example10683_span_yw_le_finiteIdeal (N : ℕ) :
    Ideal.span ({(X y * X (w N) : example10683PolynomialRing k)} :
        Set (example10683PolynomialRing k)) ≤
      example10683FiniteIdeal k N := by
  -- Proof comment: `y*w_N` is one of the finite-stage generators.
  rw [Ideal.span_le]
  intro q hq
  rw [Set.mem_singleton_iff] at hq
  rw [hq]
  exact example10683YMulWRelation_mem_finiteIdeal k (N := N) (i := N) le_rfl

/-- Helper for Chap10 Example 10 68 3: finite-stage membership is equivalent to membership of
the finite collapse in the principal ideal `(y*w_N)`. -/
private lemma example10683_mem_finiteIdeal_iff_finiteCollapse_mem_yw
    {N : ℕ} {p : example10683PolynomialRing k} :
    p ∈ example10683FiniteIdeal k N ↔
      example10683FiniteCollapse k N p ∈
        Ideal.span ({(X y * X (w N) : example10683PolynomialRing k)} :
          Set (example10683PolynomialRing k)) := by
  -- Proof comment: one direction maps finite generators through the collapse; the other adds the
  -- congruence `p - collapse(p)` to the lifted principal-ideal membership.
  constructor
  · exact example10683_finiteCollapse_mem_yw_of_mem_finiteIdeal k
  · intro hp
    have hdiff :
        p - example10683FiniteCollapse k N p ∈ example10683FiniteIdeal k N :=
      example10683_sub_finiteCollapse_mem_finiteIdeal k N p
    have hcollapse : example10683FiniteCollapse k N p ∈ example10683FiniteIdeal k N :=
      example10683_span_yw_le_finiteIdeal k N hp
    have hsum :
        (p - example10683FiniteCollapse k N p) + example10683FiniteCollapse k N p ∈
          example10683FiniteIdeal k N :=
      (example10683FiniteIdeal k N).add_mem hdiff hcollapse
    simpa [sub_add_cancel] using hsum

/-- Helper for Chap10 Example 10 68 3: every finite-stage ideal is saturated by multiplication
by `X x`. -/
private lemma example10683_mem_finiteIdeal_of_X_mul_mem_finiteIdeal
    {N : ℕ} {p : example10683PolynomialRing k}
    (hp : X x * p ∈ example10683FiniteIdeal k N) :
    p ∈ example10683FiniteIdeal k N := by
  -- Proof comment: collapse finite-stage membership to the principal monomial ideal, cancel the
  -- fresh variable there, and transport back through the finite-stage criterion.
  rw [example10683_mem_finiteIdeal_iff_finiteCollapse_mem_yw] at hp ⊢
  have hcollapse_mul :
      example10683FiniteCollapse k N (X x * p) =
        X x * example10683FiniteCollapse k N p := by
    rw [map_mul]
    have hx : example10683FiniteCollapse k N (X x) = X x := by
      simp [example10683FiniteCollapse, example10683FiniteCollapseVar]
    rw [hx]
  have hx_mem :
      X x * example10683FiniteCollapse k N p ∈
        Ideal.span ({(X y * X (w N) : example10683PolynomialRing k)} :
          Set (example10683PolynomialRing k)) := by
    rwa [hcollapse_mul] at hp
  exact example10683_mem_span_yw_of_X_mul_mem_span_yw k N hx_mem

/-- Helper for Chap10 Example 10 68 3: the defining ideal is saturated by multiplication by the
distinguished variable `x`. -/
private lemma example10683_mem_ideal_of_X_mul_mem_ideal {p : example10683PolynomialRing k}
    (hp : X x * p ∈ example10683Ideal k) :
    p ∈ example10683Ideal k := by
  -- Route correction: rather than reconstruct a global infinite normal form, extract the finite
  -- stage containing `X x * p`, use finite-stage triangular collapse to cancel `X x`, and include
  -- the result back into the directed supremum.
  rw [example10683Ideal_eq_iSup_finiteIdeal] at hp ⊢
  rcases (Submodule.mem_iSup_of_directed _
      (example10683FiniteIdeal_directed k)).mp hp with ⟨N, hN⟩
  exact Ideal.mem_iSup_of_mem N
    (example10683_mem_finiteIdeal_of_X_mul_mem_finiteIdeal k hN)

/-- Helper for Chap10 Example 10 68 3: multiplication by `x` is injective on the example ring. -/
private lemma example10683_x_isSMulRegular :
    IsSMulRegular (example10683Ring k) (example10683x k) := by
  -- Proof comment: prove regularity first for the ambient polynomial scalar `X x` on the quotient,
  -- using the saturation helper, then transport along the quotient map to the quotient-ring scalar.
  have hpoly :
      IsSMulRegular (example10683Ring k) (X x : example10683PolynomialRing k) := by
    rw [isSMulRegular_quotient_iff_mem_of_smul_mem
      (N := example10683Ideal k) (r := (X x : example10683PolynomialRing k))]
    intro p hp
    exact example10683_mem_ideal_of_X_mul_mem_ideal k (by simpa [smul_eq_mul] using hp)
  change IsSMulRegular (example10683Ring k)
    (Ideal.Quotient.mk (example10683Ideal k) (X x))
  rw [isSMulRegular_map
    (M := example10683Ring k)
    (f := Ideal.Quotient.mk (example10683Ideal k))
    (a := (X x : example10683PolynomialRing k))]
  · exact hpoly
  · intro r
    rcases Quotient.exists_rep r with ⟨r, rfl⟩
    rfl

/-- Helper for Chap10 Example 10 68 3: after quotienting by `x`, the image of `y` is regular. -/
private lemma example10683_y_regular_on_quotientByX :
    Sequence.IsRegular (QuotSMulTop (example10683x k) (example10683Ring k))
      [example10683y k] := by
  -- Proof comment: transport regularity from the ordinary quotient by `(x)` to the owner
  -- `QuotSMulTop` quotient through the generic principal-quotient comparison.
  simpa [example10683yModX] using
    (isRegular_quotSMulTop_iff_quotient_span_singleton
      (A := example10683Ring k) (r := example10683x k) (rs := [example10683y k])).2
      (example10683_yModX_regularSequence k)

-- Proof sketch: the quotient relations imply that `x` is a nonzerodivisor and that the image of
-- `y` in the quotient by `x` acts injectively on the surviving `w_i`-tower, while `y` itself
-- kills `w_0`, so `y` is a zerodivisor in the ambient ring.
private theorem example10683_regularSequence :
    Sequence.IsRegular (example10683Ring k) [example10683x k, example10683y k] := by
  -- Proof comment: assemble the regular sequence from the two isolated quotient-level
  -- regularity facts.
  simpa using
    (Sequence.IsRegular.cons (M := example10683Ring k)
      (r := example10683x k) (rs := [example10683y k])
      (example10683_x_isSMulRegular k) (example10683_y_regular_on_quotientByX k))

/-- Helper for Chap10 Example 10 68 3: the evaluation sending `x` and every `w_i` to `1` and
`y` to `0`. -/
private def example10683EvalAtOne : example10683PolynomialRing k →+* k :=
  MvPolynomial.eval₂Hom (RingHom.id k) fun
    | x => 1
    | y => 0
    | w _ => 1

/-- Helper for Chap10 Example 10 68 3: the defining relations vanish under the evaluation
`x ↦ 1`, `y ↦ 0`, `w_i ↦ 1`. -/
private lemma example10683Ideal_le_ker_evalAtOne :
    example10683Ideal k ≤ RingHom.ker (example10683EvalAtOne k) := by
  -- Proof comment: both relation families evaluate to zero, so their span is contained in the
  -- kernel of the evaluation map.
  rw [example10683Ideal, example10683Relations]
  refine Ideal.span_le.mpr ?_
  rintro p (⟨i, rfl⟩ | ⟨i, rfl⟩)
  · change example10683EvalAtOne k (example10683YMulWRelation k i) = 0
    simp [example10683EvalAtOne, example10683YMulWRelation]
  · change example10683EvalAtOne k (example10683WRecurrenceRelation k i) = 0
    simp [example10683EvalAtOne, example10683WRecurrenceRelation]

/-- Helper for Chap10 Example 10 68 3: the element `w_0` is nonzero in the quotient ring. -/
private lemma example10683w_zero_ne_zero :
    example10683w k 0 ≠ 0 := by
  -- Proof comment: descend the evaluation through the quotient; the image of `w_0` is `1`.
  let φ : example10683Ring k →+* k :=
    Ideal.Quotient.lift (example10683Ideal k) (example10683EvalAtOne k)
      (example10683Ideal_le_ker_evalAtOne k)
  intro hw
  have hmap : φ (example10683w k 0) = 0 := by
    rw [hw]
    exact map_zero φ
  have hone : (1 : k) = 0 := by
    simpa [φ, example10683w, example10683EvalAtOne] using hmap
  exact one_ne_zero hone

private theorem example10683_y_zeroDivisor :
    example10683y k ∉ nonZeroDivisors (example10683Ring k) := by
  -- Proof comment: `y` kills the nonzero element `w_0`, so it cannot be a nonzerodivisor.
  intro hy
  have hkill : example10683w k 0 = 0 :=
    (mem_nonZeroDivisors_iff_left.mp hy) (example10683w k 0)
      (example10683_y_mul_w_eq_zero k 0)
  exact example10683w_zero_ne_zero k hkill

/-- Helper for Chap10 Example 10 68 3: a nonzero right factor killed by `a` witnesses that
`a` is not a nonzerodivisor. -/
private lemma not_mem_nonZeroDivisors_of_mul_eq_zero
    {A : Type*} [CommMonoidWithZero A] {a b : A} (hzero : a * b = 0) (hb : b ≠ 0) :
    a ∉ nonZeroDivisors A := by
  -- Proof comment: unpack left-regularity in the nonzerodivisor submonoid and apply it to the
  -- displayed nonzero element.
  intro ha
  exact hb ((mem_nonZeroDivisors_iff_left.mp ha) b hzero)

/-- Helper for Chap10 Example 10 68 3: the square-zero Laurent evaluation used to detect the
constant coefficient of a polynomial annihilating `w_0`. -/
private def example10683DualEval : example10683PolynomialRing k →+*
    TrivSqZeroExt (LaurentPolynomial k) (LaurentPolynomial k) :=
  MvPolynomial.eval₂Hom
    ((TrivSqZeroExt.inlHom (LaurentPolynomial k) (LaurentPolynomial k)).comp
      (LaurentPolynomial.C : k →+* LaurentPolynomial k))
    fun
      | x => TrivSqZeroExt.inl (LaurentPolynomial.T (R := k) (1 : ℤ))
      | y => 0
      | w i => TrivSqZeroExt.inr (LaurentPolynomial.T (R := k) (-(i : ℤ)))

/-- Helper for Chap10 Example 10 68 3: after projecting the square-zero evaluation to the first
component, only the `x` variable survives as the polynomial variable. -/
private def example10683XOnlyPolynomialEval : example10683PolynomialRing k →+* Polynomial k :=
  MvPolynomial.eval₂Hom (Polynomial.C : k →+* Polynomial k) fun
    | x => Polynomial.X
    | y => 0
    | w _ => 0

/-- Helper for Chap10 Example 10 68 3: the zeroth Laurent coefficient of an embedded ordinary
polynomial is its constant coefficient. -/
private lemma polynomial_toLaurent_coeff_zero (q : Polynomial k) :
    (Polynomial.toLaurent q : LaurentPolynomial k) 0 = Polynomial.constantCoeff q := by
  -- Proof comment: unfold the Laurent embedding as support transport along `ℕ → ℤ`; the zeroth
  -- coefficient is transported from the zeroth polynomial coefficient.
  rw [Polynomial.toLaurent_apply]
  change (Finsupp.mapDomain (fun n : ℕ => (n : ℤ)) q.toFinsupp) ((0 : ℕ) : ℤ) =
    q.coeff 0
  rw [Finsupp.mapDomain_apply]
  · rfl
  · exact Int.ofNat_injective

/-- Helper for Chap10 Example 10 68 3: evaluating all variables except `x` at zero and then
taking the polynomial constant coefficient recovers the original constant coefficient. -/
private lemma example10683XOnlyPolynomialEval_constantCoeff
    (p : example10683PolynomialRing k) :
    Polynomial.constantCoeff (example10683XOnlyPolynomialEval k p) =
      MvPolynomial.constantCoeff p := by
  -- Proof comment: compare the two ring homomorphisms by their values on constants and on each
  -- polynomial variable.
  have hhom :
      Polynomial.constantCoeff.comp (example10683XOnlyPolynomialEval k) =
        (MvPolynomial.constantCoeff : example10683PolynomialRing k →+* k) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [example10683XOnlyPolynomialEval]
    · intro i
      cases i <;> simp [example10683XOnlyPolynomialEval, MvPolynomial.constantCoeff_X]
  exact congrArg (fun f : example10683PolynomialRing k →+* k => f p) hhom

/-- Helper for Chap10 Example 10 68 3: the first component of the square-zero Laurent evaluation
detects the original constant coefficient at Laurent degree zero. -/
private lemma example10683DualEval_fst_coeff_zero (p : example10683PolynomialRing k) :
    (TrivSqZeroExt.fst (example10683DualEval k p)) 0 =
      MvPolynomial.constantCoeff p := by
  -- Proof comment: identify the first component with the Laurent embedding of the `x`-only
  -- polynomial evaluation, then read off degree zero.
  have hfst :
      ((TrivSqZeroExt.fstHom (LaurentPolynomial k) (LaurentPolynomial k)
          (LaurentPolynomial k)).toRingHom.comp (example10683DualEval k)) =
        Polynomial.toLaurent.comp (example10683XOnlyPolynomialEval k) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [example10683DualEval, example10683XOnlyPolynomialEval]
    · intro i
      cases i <;>
        simp [example10683DualEval, example10683XOnlyPolynomialEval, Polynomial.toLaurent_X]
  calc
    (TrivSqZeroExt.fst (example10683DualEval k p)) 0
        = (Polynomial.toLaurent (example10683XOnlyPolynomialEval k p) :
            LaurentPolynomial k) 0 := by
          have hfun :
              TrivSqZeroExt.fst (example10683DualEval k p) =
                Polynomial.toLaurent (example10683XOnlyPolynomialEval k p) := by
            simpa [RingHom.comp_apply] using
              congrArg (fun f : example10683PolynomialRing k →+* LaurentPolynomial k => f p)
                hfst
          exact congrArg (fun q : LaurentPolynomial k => q 0) hfun
    _ = Polynomial.constantCoeff (example10683XOnlyPolynomialEval k p) :=
        polynomial_toLaurent_coeff_zero k (example10683XOnlyPolynomialEval k p)
    _ = MvPolynomial.constantCoeff p :=
        example10683XOnlyPolynomialEval_constantCoeff k p

/-- Helper for Chap10 Example 10 68 3: the defining ideal vanishes under the square-zero Laurent
evaluation. -/
private lemma example10683Ideal_le_ker_dualEval :
    example10683Ideal k ≤ RingHom.ker (example10683DualEval k) := by
  -- Proof comment: check the two relation families.  The recurrence relation is the Laurent
  -- identity `T * T^(-(i+1)) = T^(-i)` in the square-zero component.
  rw [example10683Ideal, example10683Relations]
  refine Ideal.span_le.mpr ?_
  rintro q (⟨i, rfl⟩ | ⟨i, rfl⟩)
  · change example10683DualEval k (example10683YMulWRelation k i) = 0
    simp [example10683DualEval, example10683YMulWRelation]
  · change example10683DualEval k (example10683WRecurrenceRelation k i) = 0
    ext n
    · simp only [example10683DualEval, example10683WRecurrenceRelation, map_sub, map_mul,
        MvPolynomial.eval₂Hom_X', TrivSqZeroExt.fst_sub, TrivSqZeroExt.fst_mul,
        TrivSqZeroExt.fst_inr, TrivSqZeroExt.fst_inl, TrivSqZeroExt.fst_zero, mul_zero,
        sub_zero]
    · simp only [example10683DualEval, example10683WRecurrenceRelation, map_sub, map_mul,
        MvPolynomial.eval₂Hom_X', TrivSqZeroExt.snd_sub, TrivSqZeroExt.snd_mul,
        TrivSqZeroExt.fst_inr, TrivSqZeroExt.fst_inl, TrivSqZeroExt.snd_inr,
        TrivSqZeroExt.snd_inl, TrivSqZeroExt.snd_zero, MulOpposite.op_zero, zero_smul,
        add_zero]
      have hT :
          LaurentPolynomial.T (R := k) (-(i : ℤ)) -
              LaurentPolynomial.T (R := k) (1 : ℤ) •
                LaurentPolynomial.T (R := k) (-(i + 1 : ℤ)) = 0 := by
        rw [sub_eq_zero, smul_eq_mul]
        rw [← LaurentPolynomial.T_add]
        congr 1
        omega
      exact congrArg (fun f : LaurentPolynomial k => f n) hT

/-- Helper for Chap10 Example 10 68 3: multiplying by `w_0` turns the square-zero component of
the dual evaluation into the first component of the original evaluation. -/
private lemma example10683DualEval_snd_mul_w_zero (p : example10683PolynomialRing k) :
    TrivSqZeroExt.snd (example10683DualEval k (p * X (w 0))) =
      TrivSqZeroExt.fst (example10683DualEval k p) := by
  -- Proof comment: `w_0` maps to the square-zero element with Laurent coefficient `T^0 = 1`, so
  -- the product's square-zero component is exactly the first component of `p`.
  rw [map_mul]
  simp only [example10683DualEval, MvPolynomial.eval₂Hom_X', TrivSqZeroExt.snd_mul,
    TrivSqZeroExt.fst_inr, TrivSqZeroExt.snd_inr]
  rw [MulOpposite.op_zero, zero_smul, add_zero]
  simp only [Nat.cast_zero, neg_zero, LaurentPolynomial.T_zero]
  rw [smul_eq_mul, mul_one]

/-- Helper for Chap10 Example 10 68 3: if a polynomial multiple of `w_0` lies in the defining
ideal, then the polynomial has zero constant coefficient. -/
private lemma example10683_constantCoeff_eq_zero_of_mul_w_zero_mem_ideal
    {p : example10683PolynomialRing k}
    (hp : p * X (w 0) ∈ example10683Ideal k) :
    MvPolynomial.constantCoeff p = 0 := by
  -- Route correction: the localized nonzerodivisor adapter below is closed, so this coefficient
  -- detection is the remaining input needed to prove that the localized `w_0` witness is nonzero.
  -- A possible smaller route is a Laurent-dual-number evaluation sending `x ↦ T`, `y ↦ 0`, and
  -- `w_i ↦ T^{-i}ε`, whose `ε`-coefficient after multiplying by `w_0` detects `constantCoeff p`.
  -- Proof comment: map the ideal membership into the square-zero Laurent model, project to the
  -- square-zero component after multiplying by `w_0`, and read the Laurent degree-zero coefficient.
  have hdual_zero : example10683DualEval k (p * X (w 0)) = 0 := by
    simpa using example10683Ideal_le_ker_dualEval k hp
  have hsnd_zero : TrivSqZeroExt.snd (example10683DualEval k (p * X (w 0))) = 0 := by
    rw [hdual_zero]
    exact TrivSqZeroExt.snd_zero
  have hfst_zero : TrivSqZeroExt.fst (example10683DualEval k p) = 0 := by
    rw [← example10683DualEval_snd_mul_w_zero k p]
    exact hsnd_zero
  have hcoeff_zero : (TrivSqZeroExt.fst (example10683DualEval k p)) 0 = 0 := by
    rw [hfst_zero]
    rfl
  rwa [example10683DualEval_fst_coeff_zero k p] at hcoeff_zero

/-- Chap10 Example 10 68 3: in the ring
`k[x, y, w_0, w_1, w_2, \ldots] / (y w_i, w_i - x w_{i+1} \mid i \ge 0)`, the sequence `x, y` is
regular, but `y` is a zerodivisor. -/
@[stacks 00LH]
theorem example10683_regularSequence_and_y_zeroDivisor :
    Sequence.IsRegular (example10683Ring k) [example10683x k, example10683y k] ∧
      example10683y k ∉ nonZeroDivisors (example10683Ring k) :=
  ⟨example10683_regularSequence k, example10683_y_zeroDivisor k⟩

/-- Helper for Chap10 Example 10 68 3: any element annihilating `w_0` lies in the displayed
maximal ideal. -/
private lemma example10683_mem_maximalIdeal_of_mul_w0_eq_zero
    {r : example10683Ring k} (hr : r * example10683w k 0 = 0) :
    r ∈ example10683MaximalIdeal k := by
  -- Proof comment: lift to a polynomial representative, use the coefficient-detection helper to
  -- show the representative has zero constant coefficient, then map the variable ideal down to the
  -- displayed maximal ideal.
  revert hr
  refine Quotient.inductionOn' r ?_
  intro p hp
  have hp_ideal : p * X (w 0) ∈ example10683Ideal k := by
    simpa [example10683w] using (eq_zero_iff_mem.mp hp)
  have hconst : MvPolynomial.constantCoeff p = 0 :=
    example10683_constantCoeff_eq_zero_of_mul_w_zero_mem_ideal k hp_ideal
  have hp_vars : p ∈ MvPolynomial.idealOfVars Example10683Var k :=
    mem_idealOfVars_of_constantCoeff_eq_zero
      (σ := Example10683Var) (R := k) (p := p) hconst
  have hp_map :
      Ideal.Quotient.mk (example10683Ideal k) p ∈
        (MvPolynomial.idealOfVars Example10683Var k).map
          (Ideal.Quotient.mk (example10683Ideal k)) :=
    Ideal.mem_map_of_mem (Ideal.Quotient.mk (example10683Ideal k)) hp_vars
  simpa [map_idealOfVars_eq_maximalIdeal] using hp_map

-- Proof sketch: first identify `(x, y, w_i)` as a maximal ideal. Then apply the owner theorem
-- `IsWeaklyRegular.isRegular_of_isLocalization_of_mem` to the weakly regular part of the ambient
-- regular sequence, using that both `x` and `y` lie in the chosen maximal ideal. The same
-- zero-divisor witness for `y` survives after passing to the local ring.
/-- Helper for Chap10 Example 10 68 3: the localized relation `y * w_0 = 0`. -/
private lemma example10683_localized_y_mul_w_zero :
    yₘ *
        algebraMap (example10683Ring k) (example10683LocalRing k) (example10683w k 0) = 0 := by
  -- Proof comment: name the localization map so map rewrites use the ring-hom fields directly.
  let φ : example10683Ring k →+* example10683LocalRing k :=
    algebraMap (example10683Ring k) (example10683LocalRing k)
  have hmap : φ (example10683y k * example10683w k 0) = φ 0 :=
    congrArg φ (example10683_y_mul_w_eq_zero k 0)
  rw [φ.map_mul, φ.map_zero] at hmap
  exact hmap

/-- Helper for Chap10 Example 10 68 3: the element `w_0` remains nonzero after localizing at the
displayed maximal ideal. -/
private lemma example10683_localized_w_zero_ne_zero :
    algebraMap (example10683Ring k) (example10683LocalRing k) (example10683w k 0) ≠ 0 := by
  -- Proof comment: a zero localization would give a denominator outside the maximal ideal
  -- annihilating `w_0`, contradicting the annihilator containment in the maximal ideal.
  intro hw₀ₘ
  obtain ⟨s, hs⟩ :=
    (IsLocalization.map_eq_zero_iff (example10683LocalizedIdeal k).primeCompl
      (example10683LocalRing k) (example10683w k 0)).mp hw₀ₘ
  have hs_mem : (s : example10683Ring k) ∈ example10683MaximalIdeal k :=
    example10683_mem_maximalIdeal_of_mul_w0_eq_zero k (by simpa [mul_comm] using hs)
  exact (Ideal.mem_primeCompl_iff.mp s.property) (by
    simpa [example10683LocalizedIdeal] using hs_mem)

private theorem example10683_localized_y_zeroDivisor :
    yₘ ∉ nonZeroDivisors (example10683LocalRing k) := by
  -- Proof comment: localize the relation `y * w_0 = 0`, then use the annihilator-containment
  -- helper to rule out any denominator outside the maximal ideal killing the localized `w_0`.
  exact not_mem_nonZeroDivisors_of_mul_eq_zero
    (example10683_localized_y_mul_w_zero k) (example10683_localized_w_zero_ne_zero k)

/-- Localizing the example ring at the maximal ideal `(x, y, w_i)` again yields a ring where
`x, y` is a regular sequence and `y` is a zerodivisor. -/
theorem example10683_localized_regularSequence_and_y_zeroDivisor :
    Sequence.IsRegular (Localization.AtPrime (example10683MaximalPoint k).asIdeal) [xₘ, yₘ] ∧
      yₘ ∉ nonZeroDivisors (Localization.AtPrime (example10683MaximalPoint k).asIdeal) :=
  by
    refine ⟨?_, example10683_localized_y_zeroDivisor k⟩
    simpa only [List.map] using
      (example10683_regularSequence k).toIsWeaklyRegular.isRegular_of_isLocalization_of_mem
        (example10683LocalRing k) (example10683LocalizedIdeal k) (fun r hr ↦ by
          have hr' : r = example10683x k ∨ r = example10683y k := by
            simpa using hr
          rcases hr' with rfl | rfl
          · exact example10683x_mem_maximalIdeal k
          · exact example10683y_mem_maximalIdeal k)

end
