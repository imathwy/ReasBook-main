attribute [local instance high] Semiring.toModule Algebra.toModule

noncomputable section

variable (k : Type u) [Field k]

/-- Helper for Chap10 Example 10 68 3: the canonical self-module structure of a semiring, written
explicitly so quotient-ring typeclass search does not have to reconstruct the parent actions. -/
@[reducible] private def example10683SelfModule (A : Type u) [Semiring A] : Module A A where
  smul := (· * ·)
  one_smul := one_mul
  mul_smul := mul_assoc
  smul_zero := mul_zero
  smul_add := mul_add
  add_smul := add_mul
  zero_smul := zero_mul

/-- Variables for the quotient presentation in Example 10.68.3. -/
inductive Example10683Var
  | x
  | y
  | w : ℕ → Example10683Var
  deriving DecidableEq

open Example10683Var

/-- The ambient polynomial ring `k[x, y, w_0, w_1, \ldots]` of Example 10.68.3. -/
abbrev example10683PolynomialRing :=
  MvPolynomial Example10683Var k

/-- The defining relation `y w_i`. -/
def example10683YMulWRelation (i : ℕ) : example10683PolynomialRing k :=
  X y * X (w i)

/-- The defining relation `w_i - x w_{i+1}`. -/
def example10683WRecurrenceRelation (i : ℕ) : example10683PolynomialRing k :=
  X (w i) - X x * X (w (i + 1))

/-- The full family of defining relations for Example 10.68.3. -/
def example10683Relations : Set (example10683PolynomialRing k) :=
  Set.range (example10683YMulWRelation k) ∪ Set.range (example10683WRecurrenceRelation k)

/-- The defining ideal
`(y w_i, w_i - x w_{i+1} \mid i \ge 0)` of Example 10.68.3. -/
def example10683Ideal : Ideal (example10683PolynomialRing k) :=
  Ideal.span (example10683Relations k)

/-- Each relation `y w_i` lies in the defining ideal. -/
private theorem example10683YMulWRelation_mem_ideal (i : ℕ) :
    example10683YMulWRelation k i ∈ example10683Ideal k :=
  Ideal.subset_span <| Or.inl ⟨i, rfl⟩

/-- Each relation `w_i - x w_{i+1}` lies in the defining ideal. -/
private theorem example10683WRecurrenceRelation_mem_ideal (i : ℕ) :
    example10683WRecurrenceRelation k i ∈ example10683Ideal k :=
  Ideal.subset_span <| Or.inr ⟨i, rfl⟩

/-- The quotient ring
`k[x, y, w_0, w_1, ...] / (y w_i, w_i - x w_{i+1} \mid i \ge 0)` from the example. -/
abbrev example10683Ring :=
  example10683PolynomialRing k ⧸ example10683Ideal k

/-- The distinguished element `x` in the example ring. -/
def example10683x : example10683Ring k :=
  Ideal.Quotient.mk (example10683Ideal k) (X x)

/-- The distinguished element `y` in the example ring. -/
def example10683y : example10683Ring k :=
  Ideal.Quotient.mk (example10683Ideal k) (X y)

/-- The distinguished elements `w_i` in the example ring. -/
def example10683w (i : ℕ) : example10683Ring k :=
  Ideal.Quotient.mk (example10683Ideal k) (X (w i))

/-- In the quotient ring of Example 10.68.3, the defining relation `y w_i = 0` holds. -/
theorem example10683_y_mul_w_eq_zero (i : ℕ) :
    example10683y k * example10683w k i = 0 := by
  simpa [example10683y, example10683w, example10683YMulWRelation] using
    eq_zero_iff_mem.mpr (example10683YMulWRelation_mem_ideal k i)

/-- In the quotient ring of Example 10.68.3, the defining relation `w_i = x w_{i+1}` holds. -/
theorem example10683_w_eq_x_mul_w_succ (i : ℕ) :
    example10683w k i = example10683x k * example10683w k (i + 1) := by
  simpa [example10683x, example10683w, example10683WRecurrenceRelation, sub_eq_zero] using
    eq_zero_iff_mem.mpr (example10683WRecurrenceRelation_mem_ideal k i)

/-- The maximal ideal `(x, y, w_i)` of the example ring. -/
noncomputable def example10683MaximalIdeal : Ideal (example10683Ring k) :=
  Ideal.span (Set.insert (example10683x k) (Set.insert (example10683y k) (Set.range (example10683w k))))

/-- The generator `x` lies in the maximal ideal `(x, y, w_i)`. -/
private theorem example10683x_mem_maximalIdeal :
    example10683x k ∈ example10683MaximalIdeal k :=
  Ideal.subset_span <| Set.mem_insert _ _

/-- The generator `y` lies in the maximal ideal `(x, y, w_i)`. -/
private theorem example10683y_mem_maximalIdeal :
    example10683y k ∈ example10683MaximalIdeal k :=
  Ideal.subset_span <| Set.mem_insert_of_mem _ <| Set.mem_insert _ _

/-- Helper for Chap10 Example 10 68 3: every polynomial in the ideal generated by all variables
has zero constant coefficient. -/
private lemma constantCoeff_eq_zero_of_mem_idealOfVars
    {σ : Type*} {R : Type u} [CommSemiring R] {p : MvPolynomial σ R}
    (hp : p ∈ MvPolynomial.idealOfVars σ R) :
    MvPolynomial.constantCoeff p = 0 := by
  -- Proof comment: the variable ideal is characterized by every supporting monomial having a
  -- nonzero exponent in some variable, which excludes the zero monomial.
  by_contra hconst
  have hzero_mem : (0 : σ →₀ ℕ) ∈ p.support := by
    simpa [MvPolynomial.mem_support_iff] using hconst
  have hvar :
      ∃ i ∈ (Set.univ : Set σ), ((0 : σ →₀ ℕ) i) ≠ 0 := by
    have hp' :
        p ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set σ) :
          Set (MvPolynomial σ R)) := by
      simpa [MvPolynomial.idealOfVars] using hp
    exact
      (MvPolynomial.mem_ideal_span_X_image (x := p) (s := (Set.univ : Set σ))).mp
        hp' 0 hzero_mem
  rcases hvar with ⟨i, -, hi⟩
  exact hi rfl

/-- Helper for Chap10 Example 10 68 3: a polynomial with zero constant coefficient lies in the
ideal generated by all variables. -/
private lemma mem_idealOfVars_of_constantCoeff_eq_zero
    {σ : Type*} {R : Type u} [CommSemiring R] {p : MvPolynomial σ R}
    (hp : MvPolynomial.constantCoeff p = 0) :
    p ∈ MvPolynomial.idealOfVars σ R := by
  -- Proof comment: every nonzero supporting monomial has a variable with positive exponent; the
  -- zero monomial is excluded exactly by the vanishing constant coefficient.
  rw [MvPolynomial.idealOfVars]
  rw [← Set.image_univ (f := (MvPolynomial.X : σ → MvPolynomial σ R))]
  rw [MvPolynomial.mem_ideal_span_X_image (x := p) (s := (Set.univ : Set σ))]
  intro m hm
  by_contra hnone
  have hm_zero : m = 0 := by
    ext i
    have hi : ¬ m i ≠ 0 := by
      intro hmi
      exact hnone ⟨i, Set.mem_univ i, hmi⟩
    exact not_not.mp hi
  have hcoeff_zero : p.coeff m = 0 := by
    rw [hm_zero]
    simpa [MvPolynomial.constantCoeff_eq] using hp
  exact MvPolynomial.mem_support_iff.mp hm hcoeff_zero

/-- Helper for Chap10 Example 10 68 3: the kernel of the constant-coefficient map is the ideal
generated by all variables. -/
private lemma ker_constantCoeff_eq_idealOfVars
    {σ : Type*} {R : Type u} [CommSemiring R] :
    RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial σ R →+* R) =
      MvPolynomial.idealOfVars σ R := by
  -- Proof comment: translate kernel membership to vanishing of the constant coefficient, then use
  -- the two directions of the variable-ideal characterization.
  ext p
  constructor
  · intro hp
    exact mem_idealOfVars_of_constantCoeff_eq_zero (σ := σ) (R := R) (p := p)
      (by simpa [RingHom.mem_ker] using hp)
  · intro hp
    rw [RingHom.mem_ker]
    exact constantCoeff_eq_zero_of_mem_idealOfVars (σ := σ) (R := R) (p := p) hp

/-- Helper for Chap10 Example 10 68 3: the defining ideal is contained in the ideal generated by
all variables. -/
private lemma example10683Ideal_le_idealOfVars :
    example10683Ideal k ≤ MvPolynomial.idealOfVars Example10683Var k := by
  -- Proof comment: each defining relation has zero constant coefficient, hence belongs to the
  -- variable ideal, and the span is the least ideal containing those relations.
  rw [example10683Ideal, example10683Relations]
  refine Ideal.span_le.mpr ?_
  rintro p (⟨i, rfl⟩ | ⟨i, rfl⟩)
  · exact mem_idealOfVars_of_constantCoeff_eq_zero
      (σ := Example10683Var) (R := k) (p := example10683YMulWRelation k i) (by simp
        [example10683YMulWRelation, MvPolynomial.constantCoeff_X])
  · exact mem_idealOfVars_of_constantCoeff_eq_zero
      (σ := Example10683Var) (R := k) (p := example10683WRecurrenceRelation k i) (by simp
        [example10683WRecurrenceRelation, MvPolynomial.constantCoeff_X])

/-- Helper for Chap10 Example 10 68 3: the image of the variable ideal in the quotient is the
stated ideal generated by `x`, `y`, and the `w_i`. -/
private lemma map_idealOfVars_eq_maximalIdeal :
    (MvPolynomial.idealOfVars Example10683Var k).map
      (Ideal.Quotient.mk (example10683Ideal k)) = example10683MaximalIdeal k := by
  -- Proof comment: mapping the span of all polynomial variables gives the span of their quotient
  -- classes, which are exactly the displayed generators.
  rw [MvPolynomial.idealOfVars, Ideal.map_span, example10683MaximalIdeal]
  congr 1
  ext z
  constructor
  · rintro ⟨v, ⟨a, rfl⟩, rfl⟩
    cases a with
    | x =>
        exact Set.mem_insert _ _
    | y =>
        exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
    | w i =>
        exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ ⟨i, rfl⟩)
  · intro hz
    rcases hz with hz | hz | hz
    · refine ⟨X x, ⟨x, rfl⟩, ?_⟩
      simpa [example10683x] using hz.symm
    · refine ⟨X y, ⟨y, rfl⟩, ?_⟩
      simpa [example10683y] using hz.symm
    · rcases hz with ⟨i, hi⟩
      refine ⟨X (w i), ⟨w i, rfl⟩, ?_⟩
      simpa [example10683w] using hi

-- Proof sketch: modding out by the ideal generated by all variable classes kills every generator,
-- leaving only the coefficient field `k`, so the quotient by this ideal is a field.
/-- The distinguished ideal `(x, y, w_i)` in Example 10.68.3 is maximal. -/
theorem example10683MaximalIdeal_isMaximal :
    (example10683MaximalIdeal k).IsMaximal := by
  -- Proof comment: first prove maximality upstairs for the variable ideal as the kernel of the
  -- surjective constant-coefficient map, then push it through the quotient map.
  have hvarsMax :
      (MvPolynomial.idealOfVars Example10683Var k).IsMaximal := by
    rw [← ker_constantCoeff_eq_idealOfVars (σ := Example10683Var) (R := k)]
    exact RingHom.ker_isMaximal_of_surjective
      (MvPolynomial.constantCoeff : MvPolynomial Example10683Var k →+* k) (fun a ↦ by
        refine ⟨MvPolynomial.C a, ?_⟩
        simp [MvPolynomial.constantCoeff_C])
  have hmapMax :
      ((MvPolynomial.idealOfVars Example10683Var k).map
        (Ideal.Quotient.mk (example10683Ideal k))).IsMaximal := by
    exact Ideal.IsMaximal.map_of_surjective_of_ker_le
      (Ideal.Quotient.mk_surjective) (by
        rw [Ideal.mk_ker]
        exact example10683Ideal_le_idealOfVars k)
  rwa [map_idealOfVars_eq_maximalIdeal] at hmapMax

/-- The distinguished maximal ideal of Example 10.68.3, viewed as a point of the maximal
spectrum. -/
def example10683MaximalPoint : MaximalSpectrum (example10683Ring k) :=
  ⟨example10683MaximalIdeal k, example10683MaximalIdeal_isMaximal k⟩

private abbrev example10683LocalizedIdeal : Ideal (example10683Ring k) :=
  (example10683MaximalPoint k).asIdeal

local instance : (example10683LocalizedIdeal k).IsPrime :=
  Ideal.IsMaximal.isPrime (example10683MaximalIdeal_isMaximal k)

