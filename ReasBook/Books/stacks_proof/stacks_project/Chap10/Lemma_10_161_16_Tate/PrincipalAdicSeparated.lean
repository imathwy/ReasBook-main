import StacksProject_2024.Chap10.Lemma_10_161_16_Tate.ResidueFieldBridge
universe u

open Ideal
open IntermediateField Polynomial

attribute [local instance] FractionRing.liftAlgebra FractionRing.isScalarTower_liftAlgebra

section

variable {R : Type u} [CommRing R] [IsDomain R] [IsNoetherianRing R] [IsIntegrallyClosed R]

/-- Helper for Lemma 10.161.16 (Tate): if a base scalar maps into the principal ideal generated
by `x ^ n` inside the normalization, then it already lies in the principal ideal generated by
`x ^ n` in `R`. -/
lemma base_mem_span_singleton_pow_of_algebraMap_mem_map_span_singleton_pow
    {M : Type u} [Field M] [Algebra R M] [Algebra (FractionRing R) M]
    [IsScalarTower R (FractionRing R) M]
    (x r : R) (n : ℕ) (hx : x ≠ 0)
    (hmem : algebraMap R (integralClosure R M) r ∈
      Ideal.map (algebraMap R (integralClosure R M)) (Ideal.span ({x ^ n} : Set R))) :
    r ∈ Ideal.span ({x ^ n} : Set R) := by
  let S := integralClosure R M
  have hxpow : x ^ n ≠ 0 := pow_ne_zero n hx
  have hmem' : algebraMap R S r ∈ Ideal.span ({algebraMap R S (x ^ n)} : Set S) := by
    -- Proof comment: first rewrite the mapped principal ideal inside the normalization into the
    -- literal singleton span generated by `x ^ n`.
    simpa [S, Ideal.map_span, Set.image_singleton] using hmem
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem'
  have hcM : (c : M) * algebraMap R M (x ^ n) = algebraMap R M r := by
    -- Proof comment: forget the normalization carrier and read the principal divisibility
    -- relation in the ambient field.
    simpa [S] using congrArg (fun z : S => (z : M)) hc
  have hxpowM : algebraMap R M (x ^ n) ≠ 0 := by
    intro hxpowM
    exact hxpow
      ((algebraMap_injective_to_fractionField_extension (R := R) (K := M))
        (by simpa using hxpowM))
  let d : FractionRing R :=
    algebraMap R (FractionRing R) r / algebraMap R (FractionRing R) (x ^ n)
  have hdM : algebraMap (FractionRing R) M d = c := by
    -- Proof comment: divide the ambient equality by the nonzero image of `x ^ n` to isolate the
    -- fraction-field element whose image is `c`.
    change
      algebraMap (FractionRing R) M
          (algebraMap R (FractionRing R) r / algebraMap R (FractionRing R) (x ^ n)) =
        c
    rw [map_div₀]
    have hdiv :
        algebraMap R M r / algebraMap R M (x ^ n) = c := by
      exact (div_eq_iff hxpowM).2 (by simpa [mul_comm] using hcM.symm)
    simpa [IsScalarTower.algebraMap_apply R (FractionRing R) M] using hdiv
  have hd_integral_image : IsIntegral R (algebraMap (FractionRing R) M d) := by
    rw [hdM]
    exact c.2
  have hd_integral : IsIntegral R d := by
    exact
      (isIntegral_algebraMap_iff (algebraMap (FractionRing R) M).injective).mp
        hd_integral_image
  obtain ⟨a, ha⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral (K := FractionRing R) hd_integral
  have hxpowFrac : algebraMap R (FractionRing R) (x ^ n) ≠ 0 := by
    intro hxpowFrac
    exact hxpow ((IsFractionRing.injective R (FractionRing R)) (by simpa using hxpowFrac))
  have hr_eq_frac :
      algebraMap R (FractionRing R) r =
        algebraMap R (FractionRing R) a * algebraMap R (FractionRing R) (x ^ n) := by
    -- Proof comment: transport the integrally closed fraction-field equality back to a
    -- multiplicative divisibility statement in `Frac(R)`.
    have hdiv :
        algebraMap R (FractionRing R) a =
          algebraMap R (FractionRing R) r / algebraMap R (FractionRing R) (x ^ n) := by
      simpa [d] using ha
    exact (eq_div_iff hxpowFrac).mp hdiv |>.symm
  have hr_eq : r = a * x ^ n := by
    apply IsFractionRing.injective R (FractionRing R)
    simpa [map_mul] using hr_eq_frac
  -- Proof comment: the recovered divisor `a` witnesses that `r` already lies in `(x ^ n)`.
  exact Ideal.mem_span_singleton'.2 ⟨a, hr_eq.symm⟩

/-- Helper for Lemma 10.161.16 (Tate): the common `p ^ e`-power condition on the normalization
forces `x`-adic separatedness. -/
lemma isHausdorff_span_singleton_of_common_qpow
    {M : Type u} [Field M] [Algebra R M] [Algebra (FractionRing R) M]
    [IsScalarTower R (FractionRing R) M]
    (x : R) (hx : x ≠ 0) (n : ℕ) (hn : 0 < n)
    [IsDomain (R ⧸ Ideal.span ({x} : Set R))]
    (hpow : ∀ z : integralClosure R M, z ^ n ∈ Set.range (algebraMap R (integralClosure R M))) :
    IsHausdorff (Ideal.span ({x} : Set R)) (integralClosure R M) := by
  let I : Ideal R := Ideal.span ({x} : Set R)
  let S := integralClosure R M
  letI : I.IsPrime := by
    simpa [I] using
      (Ideal.Quotient.isDomain_iff_prime (I := Ideal.span ({x} : Set R))).1 inferInstance
  refine ⟨fun z hz ↦ ?_⟩
  rcases hpow z with ⟨r, hr⟩
  have hr_mem_all : ∀ m : ℕ, r ∈ I ^ m := by
    intro m
    have hz_m : z ∈ I ^ m • (⊤ : Submodule R S) := by
      -- Proof comment: unpack the Hausdorff premise into literal membership in the `m`-th stage
      -- of the `x`-adic filtration.
      simpa [SModEq.zero] using hz m
    have hz_m' : z ∈ Ideal.map (algebraMap R S) (I ^ m) := by
      simpa [Ideal.smul_top_eq_map] using hz_m
    have hzpow_m : z ^ n ∈ Ideal.map (algebraMap R S) (I ^ m) := by
      exact (Ideal.map (algebraMap R S) (I ^ m)).pow_mem_of_mem hz_m' _ hn
    have hr_map :
        algebraMap R S r ∈
          Ideal.map (algebraMap R S) (Ideal.span ({x ^ m} : Set R)) := by
      -- Proof comment: identify `I ^ m` with `(x ^ m)` before contracting the powered scalar
      -- back to `R`.
      have hzpow_m' : algebraMap R S r ∈ Ideal.map (algebraMap R S) (I ^ m) := by
        exact hr.symm ▸ hzpow_m
      rw [show I ^ m = Ideal.span ({x ^ m} : Set R) by simpa [I] using Ideal.span_singleton_pow x m]
        at hzpow_m'
      exact hzpow_m'
    simpa [I, Ideal.span_singleton_pow] using
      base_mem_span_singleton_pow_of_algebraMap_mem_map_span_singleton_pow
        (R := R) (M := M) x r m hx hr_map
  have hI_ne_top : I ≠ ⊤ := Ideal.IsPrime.ne_top (show I.IsPrime from inferInstance)
  have hr_eq_zero : r = 0 := by
    have hr_iInf : r ∈ ⨅ m : ℕ, I ^ m := by
      exact mem_iInf.2 hr_mem_all
    simpa [Ideal.iInf_pow_eq_bot_of_isDomain (R := R) (I := I) hI_ne_top] using hr_iInf
  have hzpow_zero : z ^ n = 0 := by
    simpa [hr_eq_zero] using hr.symm
  -- Proof comment: once the fixed power vanishes, the domain property of the normalization forces
  -- the element itself to vanish.
  simpa using eq_zero_of_pow_eq_zero hzpow_zero

end
