section MainStatements

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

open Opposite

/-- Helper for Lemma 18.43.3: the sieve on `U` generated by a slice-site family is the sieve
generated by the corresponding underlying arrows in the ambient site. -/
private theorem overSieveOfObjectsEqOfArrows
    {U : C} {ι : Type (max u v)} (X : ι → Over U) :
    (Sieve.overEquiv (Over.mk (𝟙 U)))
        (Sieve.ofObjects X (Over.mk (𝟙 U))) =
      Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) := by
  -- A factorization in the slice category forgets to the same factorization in the ambient site.
  ext W g
  constructor
  · intro hg
    rw [Sieve.overEquiv_iff] at hg
    rw [Sieve.mem_ofObjects_iff] at hg
    rcases hg with ⟨i, ⟨a⟩⟩
    rw [Sieve.mem_ofArrows_iff]
    exact ⟨i, a.left, by simpa using a.w.symm⟩
  · intro hg
    -- Conversely, any ambient factorization lifts uniquely to the slice category.
    rw [Sieve.overEquiv_iff]
    rw [Sieve.mem_ofArrows_iff] at hg
    rcases hg with ⟨i, a, ha⟩
    rw [Sieve.mem_ofObjects_iff]
    exact ⟨i, ⟨Over.homMk a (by simpa using ha.symm)⟩⟩

/-- Helper for Lemma 18.43.3: a slice-site `CoversTop` hypothesis yields the corresponding
covering sieve on the base object. -/
private theorem coveringSieve_of_coversTopOver
    {U : C} {ι : Type (max u v)} (X : ι → Over U)
    (hcover : (J.over U).CoversTop X) :
    Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈ J U := by
  -- Rewrite the slice cover of the terminal object into the corresponding base-site sieve.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal (J := J.over U) (X := Over.mk (𝟙 U))
    (hX := Over.mkIdTerminal)] at hcover
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows (X := X)] at hcover
  exact hcover

/-- Helper for Lemma 18.43.3: a covering sieve on the family of arrows underlying `X` converts
back into the corresponding slice-site `CoversTop` statement. -/
private theorem coversTopOver_of_coveringSieve
    {U : C} {ι : Type (max u v)} (X : ι → Over U)
    (hcover : Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈ J U) :
    (J.over U).CoversTop X := by
  -- Rewrite the ambient covering sieve back into the slice-site cover of the terminal object.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal (J := J.over U) (X := Over.mk (𝟙 U))
    (hX := Over.mkIdTerminal)]
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows (X := X)]
  exact hcover

/-- Helper for Lemma 18.43.3: composing a slice-site cover of `U` with slice-site covers of each
member yields a sigma-indexed slice-site cover of `U`. -/
private theorem coversTopSigmaComp
    {U : C} {ι : Type (max u v)} {X : ι → Over U}
    (hX : (J.over U).CoversTop X)
    {κ : ι → Type (max u v)} {Y : ∀ i : ι, κ i → Over (X i).left}
    (hY : ∀ i : ι, (J.over (X i).left).CoversTop (Y i)) :
    (J.over U).CoversTop
      (fun a : Sigma κ ↦ Over.mk ((Y a.1 a.2).hom ≫ (X a.1).hom)) := by
  -- Convert both slice covers to ambient covering sieves and compose them using `bindOfArrows`.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal
    (J := J.over U) (X := Over.mk (𝟙 U)) (hX := Over.mkIdTerminal)]
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows]
  have hX' :
      Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈ J U := by
    have hXTerminal :
        Sieve.ofObjects X (Over.mk (𝟙 U)) ∈ (J.over U) (Over.mk (𝟙 U)) :=
      (GrothendieckTopology.coversTop_iff_of_isTerminal
        (J := J.over U) (X := Over.mk (𝟙 U)) (hX := Over.mkIdTerminal) X).1 hX
    rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows] at hXTerminal
    exact hXTerminal
  have hY' :
      ∀ i : ι,
        Sieve.ofArrows (fun a : κ i ↦ (Y i a).left) (fun a ↦ (Y i a).hom) ∈ J (X i).left := by
    intro i
    have hYTerminal :
        Sieve.ofObjects (Y i) (Over.mk (𝟙 (X i).left)) ∈
          (J.over (X i).left) (Over.mk (𝟙 (X i).left)) :=
      (GrothendieckTopology.coversTop_iff_of_isTerminal
        (J := J.over (X i).left) (X := Over.mk (𝟙 (X i).left))
        (hX := Over.mkIdTerminal) (Y i)).1 (hY i)
    rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows] at hYTerminal
    exact hYTerminal
  simpa [Presieve.bindOfArrows_ofArrows] using
    J.bindOfArrows
      (h := hX')
      (R := fun i ↦ Presieve.ofArrows (fun a : κ i ↦ (Y i a).left) (fun a ↦ (Y i a).hom))
      (fun i ↦ by simpa using hY' i)

/-- Helper for Lemma 18.43.3: slice-site covering data over every object can be repackaged as one
ambient covering family. -/
theorem exists_coversTop_of_over_cover_data
    (P : C → Prop)
    (hP : ∀ U : C,
      ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
        ∀ i : I, P (X i).left) :
    ∃ (I : Type (max u v)) (Y : I → C), J.CoversTop Y ∧
      ∀ i : I, P (Y i) := by
  classical
  choose I X hX hprop using hP
  refine ⟨Sigma I, fun a ↦ (X a.1 a.2).left, ?_, ?_⟩
  · intro U
    -- The slice cover chosen over `U` gives a covering sieve on `U`, and every generator lands
    -- in the sigma-indexed ambient family.
    have hcover :
        Sieve.ofArrows (fun i ↦ (X U i).left) (fun i ↦ (X U i).hom) ∈ J U := by
      exact coveringSieve_of_coversTopOver (J := J) (X := X U) (hX U)
    refine J.superset_covering ?_ hcover
    intro V f hf
    rw [Sieve.mem_ofArrows_iff] at hf
    rw [Sieve.mem_ofObjects_iff]
    rcases hf with ⟨i, g, hg⟩
    exact ⟨⟨U, i⟩, ⟨g⟩⟩
  · intro a
    exact hprop a.1 a.2

/-- Helper for Lemma 18.43.3: restricting a chosen constant chart along a slice object can be
described directly on the smaller slice site without passing through an iterated slice model. -/
private noncomputable def restrictConstantChartAlongOver
    {D : Type w} [Category D]
    {FD : D → D → Type*} {CD : D → Type*}
    [∀ X Y, FunLike (FD X Y) (CD X) (CD Y)] [ConcreteCategory D FD]
    [HasWeakSheafify J D]
    [∀ T : C, HasWeakSheafify (J.over T) D]
    [J.WEqualsLocallyBijective D]
    [∀ T : C, (J.over T).WEqualsLocallyBijective D]
    {H : Sheaf J D} {U : C} {A : D}
    (e : H.over U ≅ (constantSheaf (J.over U) D).obj A)
    {V : Over U} :
    H.over V.left ≅ (constantSheaf (J.over V.left) D).obj A := by
  -- Route correction: transport the chart by comparing direct restriction to the slice pullback,
  -- then bridge both constant models using the ambient `constantSheafOverObjIso`.
  let f : V.left ⟶ U := V.hom
  let hH :
      ((J.overMapPullback D f).obj (H.over U)) ≅ H.over V.left :=
    (Functor.sheafPushforwardContinuousComp' (Over.mapForget f) D
      (J.over V.left) (J.over U) J).app H
  let hConstU :
      ((J.overMapPullback D f).obj ((constantSheaf (J.over U) D).obj A)) ≅
        ((constantSheaf J D).obj A).over V.left := by
    -- First rewrite the constant source chart back to the ambient constant sheaf over `U`.
    let h₁ :
        ((J.overMapPullback D f).obj ((constantSheaf (J.over U) D).obj A)) ≅
          ((J.overMapPullback D f).obj (((constantSheaf J D).obj A).over U)) :=
      (J.overMapPullback D f).mapIso
        (constantSheafOverObjIso (J := J) (D := D) U A).symm
    -- Then identify the iterated restriction with the direct restriction to `V.left`.
    let h₂ :
        ((J.overMapPullback D f).obj (((constantSheaf J D).obj A).over U)) ≅
          ((constantSheaf J D).obj A).over V.left :=
      (Functor.sheafPushforwardContinuousComp' (Over.mapForget f) D
        (J.over V.left) (J.over U) J).app ((constantSheaf J D).obj A)
    exact h₁ ≪≫ h₂
  -- Compose the restriction comparison with the ambient constant-sheaf comparison at `V.left`.
  exact hH.symm ≪≫ (J.overMapPullback D f).mapIso e ≪≫ hConstU ≪≫
    constantSheafOverObjIso (J := J) (D := D) V.left A

/-- Helper for Lemma 18.43.3: every object of the slice category `Over U` carries its canonical
arrow to the terminal object `Over.mk (𝟙 U)`. -/
private def overTerminalHom {U : C} (X : Over U) : X ⟶ Over.mk (𝟙 U) :=
  Over.homMk X.hom (by simp)

/-- Helper for Lemma 18.43.3: a section of a constant set-valued sheaf on the slice site
`J.over U` becomes a literal constant after passing to a slice-site cover. -/
private theorem exists_coversTop_lift_constantTypeSection
    [HasWeakSheafify J (Type w)]
    [∀ T : C, HasWeakSheafify (J.over T) (Type w)]
    [J.WEqualsLocallyBijective (Type w)]
    [∀ T : C, (J.over T).WEqualsLocallyBijective (Type w)]
    {U : C} {B : Type w}
    (s : ((((constantSheaf J (Type w)).obj B).over U).obj.obj (op (Over.mk (𝟙 U))))) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I, ∃ b : B,
        (constant_presheaf_over_comparison (J := J) (D := Type w) U B).app (op (X i)) b =
          ((((constantSheaf J (Type w)).obj B).over U).obj.map
            (overTerminalHom (X i)).op) s := by
  let α := constant_presheaf_over_comparison (J := J) (D := Type w) U B
  letI : Presheaf.IsLocallySurjective (J.over U) α :=
    (constant_presheaf_over_comparison_is_W
      (J := J) (D := Type w) (FD := fun X Y ↦ X ⟶ Y) (CD := fun X ↦ X) U B).isLocallySurjective
  let R : Sieve (Over.mk (𝟙 U)) := Presheaf.imageSieve α s
  have hR : R ∈ (J.over U) (Over.mk (𝟙 U)) := by
    simpa [R] using Presheaf.imageSieve_mem (J := J.over U) α s
  let I : Type (max u v) := { X : Over U // R.arrows (overTerminalHom X) }
  refine ⟨I, fun i ↦ i.1, ?_, ?_⟩
  · -- The image sieve of the section itself gives the required slice-site covering family.
    have hObjects : Sieve.ofObjects (fun i : I ↦ i.1) (Over.mk (𝟙 U)) = R := by
      ext W g
      constructor
      · intro hg
        rw [Sieve.mem_ofObjects_iff] at hg
        rcases hg with ⟨i, ⟨a⟩⟩
        have hg' : a ≫ overTerminalHom i.1 = g := by
          ext
          simpa [overTerminalHom] using (g.w.trans a.w.symm).symm
        rw [← hg']
        exact R.downward_closed i.2 a
      · intro hg
        rw [Sieve.mem_ofObjects_iff]
        refine ⟨⟨W, ?_⟩, ⟨𝟙 W⟩⟩
        have hg' : g = overTerminalHom W := by
          ext
          simpa [overTerminalHom] using g.w
        simpa [hg'] using hg
    rw [GrothendieckTopology.coversTop_iff_of_isTerminal (J := J.over U) (X := Over.mk (𝟙 U))
      (hX := Over.mkIdTerminal)]
    rw [hObjects]
    exact hR
  · intro i
    have hi : (Presheaf.imageSieve α s).arrows (overTerminalHom i.1) := by
      simpa [R] using i.2
    refine ⟨Presheaf.localPreimage (U := Opposite.op (Over.mk (𝟙 U)))
      α s (overTerminalHom i.1) hi, ?_⟩
    -- The local preimage computes the restriction of the chosen section by construction.
    simpa [α] using
      Presheaf.app_localPreimage (U := Opposite.op (Over.mk (𝟙 U)))
        α s (overTerminalHom i.1) hi

/-- Helper for Chap18 Lemma 18 43 3: local constancy can be unpacked into a slice-site cover with
explicit chosen constant charts. -/
private theorem existsLocallyConstantCoverWithCharts
    {D : Type w} [Category D]
    [HasWeakSheafify J D]
    [∀ T : C, HasWeakSheafify (J.over T) D]
    {G : Sheaf J D} [IsLocallyConstant G] (U : C) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ E : D,
          ∃ e : G.over (X i).left ≅ (constantSheaf (J.over (X i).left) D).obj E, True := by
  -- Proof comment: start from the local-constancy cover and then choose explicit representatives
  -- for the constant charts supplied only through `IsConstant`.
  obtain ⟨I, X, hX, hconst⟩ := IsLocallyConstant.exists_constant_cover (F := G) U
  refine ⟨I, X, hX, ?_⟩
  intro i
  letI : IsConstant (J.over (X i).left) (G.over (X i).left) := hconst i
  -- Proof comment: `mem_essImage_of_isConstant` turns the abstract constant witness into a
  -- concrete constant value together with a chosen isomorphism.
  obtain ⟨E, ⟨e⟩⟩ :=
    Sheaf.mem_essImage_of_isConstant (J := J.over (X i).left) (G.over (X i).left)
  exact ⟨E, e, trivial⟩

/-- Helper for Chap18 Lemma 18 43 3: a sheaf of sets has exactly one section on a
sheaf-theoretically empty object. -/
private theorem uniqueSectionsOfIsSheafTheoreticallyEmpty
    {F : Sheaf J (Type w)} (U : C) (hU : J.IsSheafTheoreticallyEmpty U) :
    Nonempty (Unique (F.obj (Opposite.op U))) := by
  -- Proof comment: a sheaf-theoretically empty object carries the bottom covering sieve, so the
  -- sheaf is terminal there and its section type is therefore unique.
  rw [GrothendieckTopology.isSheafTheoreticallyEmpty_iff_bot_mem] at hU
  exact ⟨CategoryTheory.Limits.Types.isTerminalEquivUnique _ (F.isTerminalOfBotCover U hU)⟩

/-- Helper for Chap18 Lemma 18 43 3: a cover of the terminal slice object contains a member whose
source is not sheaf theoretically empty whenever the base object is not. -/
private theorem overCoverHasNonemptyMember
    {U : C} {I : Type (max u v)} (X : I → Over U)
    (hX : (J.over U).CoversTop X)
    (hU : ¬ J.IsSheafTheoreticallyEmpty U) :
    ∃ i : I, ¬ J.IsSheafTheoreticallyEmpty (X i).left := by
  classical
  -- Proof comment: if every member were sheaf theoretically empty, binding the cover with bottom
  -- sieves would force the bottom sieve on `U` to be covering as well.
  by_contra hEmpty
  push_neg at hEmpty
  have hX' :
      Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈ J U := by
    exact coveringSieve_of_coversTopOver (J := J) (X := X) hX
  have hBindBot :
      Presieve.bindOfArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom)
        (fun i ↦ (⊥ : Presieve (X i).left)) =
        (⊥ : Presieve U) := by
    funext W f
    apply propext
    constructor
    · intro hf
      cases hf with
      | mk i g hg =>
          exact hg
    · intro hf
      exact False.elim hf
  have hBot : (⊥ : Sieve U) ∈ J U := by
    have hBind :
        Sieve.generate
            (Presieve.bindOfArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom)
              (fun i ↦ (⊥ : Presieve (X i).left))) ∈ J U := by
      exact J.bindOfArrows hX' fun i ↦ by
        simpa [GrothendieckTopology.isSheafTheoreticallyEmpty_iff_bot_mem] using hEmpty i
    simpa [hBindBot] using hBind
  exact hU <| by
    rwa [GrothendieckTopology.isSheafTheoreticallyEmpty_iff_bot_mem] at hBot

section Types

variable [HasWeakSheafify J (Type w)]
variable [∀ U : C, HasWeakSheafify (J.over U) (Type w)]
variable [J.WEqualsLocallyBijective (Type w)]
variable [∀ U : C, (J.over U).WEqualsLocallyBijective (Type w)]

/-- Helper for Lemma 18.43.3: the finite locally constant source cover can be chosen with actual
constant charts instead of `Nonempty` witnesses. -/
private theorem existsFiniteConstantTypeCoverWithCharts
    {F : Sheaf J (Type w)} [IsFiniteLocallyConstant F] (U : C) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ E : Type w, Finite E ∧
          ∃ e : F.over (X i).left ≅ (constantSheaf (J.over (X i).left) (Type w)).obj E, True := by
  classical
  -- Proof comment: unpack the existing finite constant cover and choose representatives for the
  -- local constant charts carried only as `Nonempty` witnesses.
  obtain ⟨I, X, hX, hconst⟩ := IsFiniteLocallyConstant.exists_finite_constant_cover (F := F) U
  refine ⟨I, X, hX, ?_⟩
  intro i
  obtain ⟨E, hE, hiso⟩ := hconst i
  rcases hiso with ⟨e⟩
  exact ⟨E, hE, e, trivial⟩

/-- Helper for Lemma 18.43.3: once the source restriction is already identified with a finite
constant sheaf on `J.over U`, the remaining chartwise problem is to refine the target until the
given morphism is induced by a literal map of sets. -/
private theorem existsConstantTypeSourceLocal
    {F G : Sheaf J (Type w)} (φ : F ⟶ G) {U : C} {A : Type w}
    [Finite A] [IsLocallyConstant G]
    [J.WEqualsLocallyBijective (Type w)]
    [∀ T : C, (J.over T).WEqualsLocallyBijective (Type w)]
    (eF : F.over U ≅ (constantSheaf (J.over U) (Type w)).obj A) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ (B : Type w) (f : A ⟶ B)
          (eG : G.over (X i).left ≅ (constantSheaf (J.over (X i).left) (Type w)).obj B),
            CommSq ((J.overPullback (Type w) (X i).left).map φ)
              (restrictConstantChartAlongOver
                (J := J) (D := Type w) eF (V := X i)).hom
              eG.hom
              ((constantSheaf (J.over (X i).left) (Type w)).map f) := by
  -- Route correction: the public theorem below now isolates the source finite-cover bookkeeping,
  -- so this helper is exactly the remaining constant-source localization problem.
  -- TODO(Lemma 18.43.3): choose a target constant chart over each source chart, lift the finitely
  -- many terminal sections indexed by `A`, and combine those covers into one common refinement.
  sorry

/-- Helper for Lemma 18.43.3: over an arbitrary object, a morphism from a finite locally constant
sheaf of sets to a locally constant sheaf becomes a morphism between explicit constant models after
refining in the slice site. -/
theorem exists_over_cover_restriction_isConstantSheafMap_type_local
    {F G : Sheaf J (Type w)} (φ : F ⟶ G) [IsFiniteLocallyConstant F]
    [IsLocallyConstant G] (U : C) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ (A B : Type w) (f : A ⟶ B)
          (eF : F.over (X i).left ≅ (constantSheaf (J.over (X i).left) (Type w)).obj A)
          (eG : G.over (X i).left ≅ (constantSheaf (J.over (X i).left) (Type w)).obj B),
            CommSq ((J.overPullback (Type w) (X i).left).map φ) eF.hom eG.hom
              ((constantSheaf (J.over (X i).left) (Type w)).map f) := by
  -- Route correction: the transport step is now isolated in `restrictConstantChartAlongOver`, so
  -- the remaining work is the constant-source lemma that localizes finitely many image sections of
  -- `G` until they become literal constants on a common refinement.
  classical
  obtain ⟨I, X, hX, hcharts⟩ :=
    existsFiniteConstantTypeCoverWithCharts (J := J) (F := F) U
  choose A hA eF htrivial using hcharts
  have hlocal :
      ∀ i : I,
        ∃ (K : Type (max u v)) (Y : K → Over (X i).left), (J.over (X i).left).CoversTop Y ∧
          ∀ j : K,
            ∃ (B : Type w) (f : A i ⟶ B)
              (eG : G.over (Y j).left ≅
                (constantSheaf (J.over (Y j).left) (Type w)).obj B),
                CommSq ((J.overPullback (Type w) (Y j).left).map φ)
                  (restrictConstantChartAlongOver
                    (J := J) (D := Type w) (eF i) (V := Y j)).hom
                  eG.hom
                  ((constantSheaf (J.over (Y j).left) (Type w)).map f) := by
    intro i
    letI : Finite (A i) := hA i
    -- Proof comment: each explicit finite source chart is refined independently by the
    -- constant-source local theorem.
    simpa using
      existsConstantTypeSourceLocal (J := J) (F := F) (G := G) φ
        (U := (X i).left) (A := A i) (eF := eF i)
  choose K Y hY hcomm using hlocal
  refine ⟨Sigma K, fun a ↦ Over.mk ((Y a.1 a.2).hom ≫ (X a.1).hom), ?_, ?_⟩
  · -- Proof comment: compose the outer finite source cover with the chartwise refinements.
    exact coversTopSigmaComp (J := J) (X := X) hX (Y := Y) hY
  · intro a
    rcases hcomm a.1 a.2 with ⟨B, f, eG, hsq⟩
    refine ⟨A a.1, B, f, ?_, eG, ?_⟩
    · -- Proof comment: the final source chart is the restriction of the chosen outer chart.
      exact restrictConstantChartAlongOver (J := J) (D := Type w) (eF a.1) (V := Y a.1 a.2)
    · simpa using hsq

-- Proof sketch: package the slice-local statement into one ambient top cover.
/-- Lemma 18.43.3 (1): for a morphism of locally constant sheaves of sets whose source is finite
locally constant, there is a covering of the terminal object on which the restriction fits into a
commutative square with a map of constant sheaves associated with a map of sets. -/
@[stacks 093S]
theorem exists_coversTop_restriction_isConstantSheafMap_type
    {F G : Sheaf J (Type w)} (φ : F ⟶ G) [IsFiniteLocallyConstant F]
    [IsLocallyConstant G] :
    ∃ (I : Type (max u v)) (U : I → C), J.CoversTop U ∧
      ∀ i : I,
        ∃ (A B : Type w) (f : A ⟶ B)
          (eF : F.over (U i) ≅ (constantSheaf (J.over (U i)) (Type w)).obj A)
          (eG : G.over (U i) ≅ (constantSheaf (J.over (U i)) (Type w)).obj B),
            CommSq ((J.overPullback (Type w) (U i)).map φ) eF.hom eG.hom
              ((constantSheaf (J.over (U i)) (Type w)).map f) := by
  exact exists_coversTop_of_over_cover_data (J := J)
    (P := fun U ↦
      ∃ (A B : Type w) (f : A ⟶ B)
        (eF : F.over U ≅ (constantSheaf (J.over U) (Type w)).obj A)
        (eG : G.over U ≅ (constantSheaf (J.over U) (Type w)).obj B),
          CommSq ((J.overPullback (Type w) U).map φ) eF.hom eG.hom
            ((constantSheaf (J.over U) (Type w)).map f))
    (fun U ↦ exists_over_cover_restriction_isConstantSheafMap_type_local (J := J) φ U)

end Types

section AddCommGroups

variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [∀ U : C, HasWeakSheafify (J.over U) AddCommGrpCat.{w}]
