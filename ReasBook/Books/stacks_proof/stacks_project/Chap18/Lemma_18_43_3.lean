/-- Helper for Lemma 18.43.3: the finite locally constant source cover of abelian-group sheaves can
be chosen with explicit constant charts. -/
private theorem existsFiniteConstantAddCommGrpCoverWithCharts
    {F : Sheaf J AddCommGrpCat.{w}} [IsFiniteLocallyConstantAddCommGrp F] (U : C) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ A : AddCommGrpCat.{w}, Finite A ∧
          ∃ e : F.over (X i).left ≅
            (constantSheaf (J.over (X i).left) AddCommGrpCat.{w}).obj A, True := by
  classical
  -- Proof comment: the finite-cover API already supplies the right objects and finiteness data,
  -- so only the chart witnesses need to be chosen explicitly.
  obtain ⟨I, X, hX, hconst⟩ :=
    IsFiniteLocallyConstantAddCommGrp.exists_finite_constant_cover (F := F) U
  refine ⟨I, X, hX, ?_⟩
  intro i
  obtain ⟨A, hA, hiso⟩ := hconst i
  rcases hiso with ⟨e⟩
  exact ⟨A, hA, e, trivial⟩

/-- Helper for Lemma 18.43.3: once the source restriction is already an explicit finite constant
abelian-group sheaf on `J.over U`, the remaining task is to refine until the morphism is induced
by a literal homomorphism of abelian groups. -/
private theorem existsConstantAddCommGrpSourceLocal
    {F G : Sheaf J AddCommGrpCat.{w}} (φ : F ⟶ G) {U : C} {A : AddCommGrpCat.{w}}
    [Finite A] [IsLocallyConstant G]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ T : C, (J.over T).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (eF : F.over U ≅ (constantSheaf (J.over U) AddCommGrpCat.{w}).obj A) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ (B : AddCommGrpCat.{w}) (f : A ⟶ B)
          (eG : G.over (X i).left ≅
            (constantSheaf (J.over (X i).left) AddCommGrpCat.{w}).obj B),
            CommSq ((J.overPullback AddCommGrpCat.{w} (X i).left).map φ)
              (restrictConstantChartAlongOver
                (J := J) (D := AddCommGrpCat.{w}) eF (V := X i)).hom
              eG.hom
              ((constantSheaf (J.over (X i).left) AddCommGrpCat.{w}).map f) := by
  -- Route correction: the finite-cover assembly below is settled, so only the chartwise additive
  -- upgrade from the recovered underlying set map remains here.
  -- TODO(Lemma 18.43.3): run the type-valued refinement on the underlying sets and then prove the
  -- recovered pointwise map preserves `0` and `+` by comparing terminal sections.
  sorry

/-- Helper for Lemma 18.43.3: over an arbitrary object, a morphism from a finite locally constant
sheaf of abelian groups to a locally constant sheaf becomes a morphism between explicit constant
abelian-group models after refining in the slice site. -/
theorem exists_over_cover_restriction_isConstantSheafMap_addCommGrp_local
    {F G : Sheaf J AddCommGrpCat.{w}} (φ : F ⟶ G)
    [IsFiniteLocallyConstantAddCommGrp F] [IsLocallyConstant G] (U : C) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ (A B : AddCommGrpCat.{w}) (f : A ⟶ B)
          (eF : F.over (X i).left ≅ (constantSheaf (J.over (X i).left) AddCommGrpCat.{w}).obj A)
          (eG : G.over (X i).left ≅ (constantSheaf (J.over (X i).left) AddCommGrpCat.{w}).obj B),
            CommSq ((J.overPullback AddCommGrpCat.{w} (X i).left).map φ) eF.hom eG.hom
              ((constantSheaf (J.over (X i).left) AddCommGrpCat.{w}).map f) := by
  -- Route correction: after the same constant-source reduction as in the type-valued case, the
  -- extra missing step is to show the locally recovered pointwise map preserves addition.
  classical
  obtain ⟨I, X, hX, hcharts⟩ :=
    existsFiniteConstantAddCommGrpCoverWithCharts (J := J) (F := F) U
  choose A hA eF htrivial using hcharts
  have hlocal :
      ∀ i : I,
        ∃ (K : Type (max u v)) (Y : K → Over (X i).left), (J.over (X i).left).CoversTop Y ∧
          ∀ j : K,
            ∃ (B : AddCommGrpCat.{w}) (f : A i ⟶ B)
              (eG : G.over (Y j).left ≅
                (constantSheaf (J.over (Y j).left) AddCommGrpCat.{w}).obj B),
                CommSq ((J.overPullback AddCommGrpCat.{w} (Y j).left).map φ)
                  (restrictConstantChartAlongOver
                    (J := J) (D := AddCommGrpCat.{w}) (eF i) (V := Y j)).hom
                  eG.hom
                  ((constantSheaf (J.over (Y j).left) AddCommGrpCat.{w}).map f) := by
    intro i
    letI : Finite (A i) := hA i
    -- Proof comment: the additive case has the same cover assembly; only the chartwise local
    -- refinement remains delegated to `existsConstantAddCommGrpSourceLocal`.
    simpa using
      existsConstantAddCommGrpSourceLocal (J := J) (F := F) (G := G) φ
        (U := (X i).left) (A := A i) (eF := eF i)
  choose K Y hY hcomm using hlocal
  refine ⟨Sigma K, fun a ↦ Over.mk ((Y a.1 a.2).hom ≫ (X a.1).hom), ?_, ?_⟩
  · -- Proof comment: compose the explicit finite source cover with the additive refinements.
    exact coversTopSigmaComp (J := J) (X := X) hX (Y := Y) hY
  · intro a
    rcases hcomm a.1 a.2 with ⟨B, f, eG, hsq⟩
    refine ⟨A a.1, B, f, ?_, eG, ?_⟩
    · exact
        restrictConstantChartAlongOver (J := J) (D := AddCommGrpCat.{w}) (eF a.1)
          (V := Y a.1 a.2)
    · simpa using hsq

-- Proof sketch: package the slice-local statement into one ambient top cover.
/-- Lemma 18.43.3 (2): for a morphism of locally constant sheaves of abelian groups whose source
is finite locally constant, there is a covering of the terminal object on which the restriction is
part of a commutative square with a map of constant abelian sheaves associated with a homomorphism
of abelian groups. -/
@[stacks 093S]
theorem exists_coversTop_restriction_isConstantSheafMap_addCommGrp
    {F G : Sheaf J AddCommGrpCat.{w}} (φ : F ⟶ G)
    [IsFiniteLocallyConstantAddCommGrp F] [IsLocallyConstant G] :
    ∃ (I : Type (max u v)) (U : I → C), J.CoversTop U ∧
      ∀ i : I,
        ∃ (A B : AddCommGrpCat.{w}) (f : A ⟶ B)
          (eF : F.over (U i) ≅ (constantSheaf (J.over (U i)) AddCommGrpCat.{w}).obj A)
          (eG : G.over (U i) ≅ (constantSheaf (J.over (U i)) AddCommGrpCat.{w}).obj B),
            CommSq ((J.overPullback AddCommGrpCat.{w} (U i)).map φ) eF.hom eG.hom
              ((constantSheaf (J.over (U i)) AddCommGrpCat.{w}).map f) := by
  exact exists_coversTop_of_over_cover_data (J := J)
    (P := fun U ↦
      ∃ (A B : AddCommGrpCat.{w}) (f : A ⟶ B)
        (eF : F.over U ≅ (constantSheaf (J.over U) AddCommGrpCat.{w}).obj A)
        (eG : G.over U ≅ (constantSheaf (J.over U) AddCommGrpCat.{w}).obj B),
          CommSq ((J.overPullback AddCommGrpCat.{w} U).map φ) eF.hom eG.hom
            ((constantSheaf (J.over U) AddCommGrpCat.{w}).map f))
    (fun U ↦ exists_over_cover_restriction_isConstantSheafMap_addCommGrp_local (J := J) φ U)

end AddCommGroups

section Modules

variable {Λ : Type w} [Ring Λ]
variable [HasWeakSheafify J (ModuleCat.{w} Λ)]
variable [∀ U : C, HasWeakSheafify (J.over U) (ModuleCat.{w} Λ)]
variable [J.WEqualsLocallyBijective (ModuleCat.{w} Λ)]
variable [∀ U : C, (J.over U).WEqualsLocallyBijective (ModuleCat.{w} Λ)]

/-- Helper for Lemma 18.43.3: the finite-type locally constant source cover of module-valued
sheaves can be chosen with explicit constant charts. -/
private theorem existsFiniteConstantModuleCoverWithCharts
    {F : Sheaf J (ModuleCat.{w} Λ)} [IsFiniteTypeLocallyConstantModule F] (U : C) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ M : ModuleCat.{w} Λ, Module.Finite Λ M ∧
          ∃ e : F.over (X i).left ≅
            (constantSheaf (J.over (X i).left) (ModuleCat.{w} Λ)).obj M, True := by
  classical
  -- Proof comment: unpack the finite-type local triviality data and choose concrete chart
  -- isomorphisms so the remaining module proof can focus on descent rather than `Nonempty`.
  obtain ⟨I, X, hX, hconst⟩ :=
    IsFiniteTypeLocallyConstantModule.exists_finite_constant_cover (F := F) U
  refine ⟨I, X, hX, ?_⟩
  intro i
  obtain ⟨M, hM, hiso⟩ := hconst i
  rcases hiso with ⟨e⟩
  exact ⟨M, hM, e, trivial⟩

/-- Helper for Chap18 Lemma 18 43 3: a finite `\Lambda`-module is the quotient of a finite free
`\Lambda`-module. -/
private theorem finiteModuleExistsFiniteFreeSurjection
    (M : ModuleCat.{w} Λ) [Module.Finite Λ M] :
    ∃ n : ℕ, ∃ p : ModuleCat.of Λ (Fin n → Λ) ⟶ M, Function.Surjective p.hom := by
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := Λ) (M := M)
  let e : (Fin n → Λ) ≃ₗ[Λ] (Fin n →₀ Λ) :=
    (Finsupp.linearEquivFunOnFinite Λ Λ (Fin n)).symm
  let pLinear : (Fin n → Λ) →ₗ[Λ] M :=
    Finsupp.linearCombination Λ s ∘ₗ e.toLinearMap
  have hpRange : LinearMap.range pLinear = ⊤ := by
    -- Proof comment: the chosen finite generating family spans `M`, and the finite-support model
    -- for `Fin n → Λ` transports that spanning statement to `pLinear`.
    rw [LinearMap.range_comp_of_range_eq_top _ e.range]
    rw [Finsupp.range_linearCombination]
    exact hs
  have hpSurj : Function.Surjective pLinear := by
    intro m
    have hm : m ∈ LinearMap.range pLinear := by
      rw [hpRange]
      trivial
    rcases hm with ⟨x, rfl⟩
    exact ⟨x, rfl⟩
  exact ⟨n, ModuleCat.ofHom pLinear, hpSurj⟩

/-- Helper for Chap18 Lemma 18 43 3: a linear map defined on a finite free cover descends through
the quotient whenever it kills the kernel of the cover. -/
private theorem moduleHomOfFiniteFreeSurjectionAndKerLe
    {n : ℕ} {M N : ModuleCat.{w} Λ}
    (p : ModuleCat.of Λ (Fin n → Λ) ⟶ M)
    (g : ModuleCat.of Λ (Fin n → Λ) ⟶ N)
    (hp : Function.Surjective p.hom)
    (hker : LinearMap.ker p.hom ≤ LinearMap.ker g.hom) :
    ∃ f : M ⟶ N, f.hom.comp p.hom = g.hom := by
  let gQ : (Fin n → Λ) ⧸ LinearMap.ker p.hom →ₗ[Λ] N :=
    (LinearMap.ker p.hom).liftQ g.hom hker
  let fLinear : M →ₗ[Λ] N :=
    gQ.comp (LinearMap.quotKerEquivOfSurjective p.hom hp).symm.toLinearMap
  refine ⟨ModuleCat.ofHom fLinear, ?_⟩
  -- Proof comment: after identifying `M` with the quotient by `ker p`, the descended map is just
  -- the quotient lift of `g`.
  ext x
  change gQ ((LinearMap.quotKerEquivOfSurjective p.hom hp).symm (p.hom x)) = g.hom x
  rw [LinearMap.quotKerEquivOfSurjective_symm_apply]
  simp [gQ]

/-- Helper for Lemma 18.43.3: once the source restriction is already an explicit finite-type
constant `\Lambda`-module sheaf on `J.over U`, the remaining problem is the chartwise descent from
locally chosen generator images to a genuine linear map. -/
private theorem existsConstantModuleSourceLocal
    {F G : Sheaf J (ModuleCat.{w} Λ)} (φ : F ⟶ G) {U : C} {M : ModuleCat.{w} Λ}
    [Module.Finite Λ M] [IsLocallyConstant G]
    [J.WEqualsLocallyBijective (ModuleCat.{w} Λ)]
    [∀ T : C, (J.over T).WEqualsLocallyBijective (ModuleCat.{w} Λ)]
    (eF : F.over U ≅ (constantSheaf (J.over U) (ModuleCat.{w} Λ)).obj M) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ (N : ModuleCat.{w} Λ) (f : M ⟶ N)
          (eG : G.over (X i).left ≅
            (constantSheaf (J.over (X i).left) (ModuleCat.{w} Λ)).obj N),
            CommSq ((J.overPullback (ModuleCat.{w} Λ) (X i).left).map φ)
              (restrictConstantChartAlongOver
                (J := J) (D := ModuleCat.{w} Λ) eF (V := X i)).hom
              eG.hom
              ((constantSheaf (J.over (X i).left) (ModuleCat.{w} Λ)).map f) := by
  -- Route correction: the public theorem below now handles the finite-type source cover, leaving
  -- only the chartwise finite-free descent problem in this helper.
  -- TODO(Lemma 18.43.3): choose a finite free surjection onto `M`, refine the target on the
  -- finitely many basis images, and descend the recovered free-module map through the relations.
  sorry

/-- Helper for Lemma 18.43.3: over an arbitrary object, a morphism from a finite-type locally
constant sheaf of `\Lambda`-modules to a locally constant sheaf becomes a morphism between
explicit constant module models after refining in the slice site. -/
theorem exists_over_cover_restriction_isConstantSheafMap_module_local
    {F G : Sheaf J (ModuleCat.{w} Λ)} (φ : F ⟶ G)
    [IsFiniteTypeLocallyConstantModule F] [IsLocallyConstant G] (U : C) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I,
        ∃ (M N : ModuleCat.{w} Λ) (f : M ⟶ N)
          (eF : F.over (X i).left ≅
            (constantSheaf (J.over (X i).left) (ModuleCat.{w} Λ)).obj M)
          (eG : G.over (X i).left ≅
            (constantSheaf (J.over (X i).left) (ModuleCat.{w} Λ)).obj N),
            CommSq ((J.overPullback (ModuleCat.{w} Λ) (X i).left).map φ) eF.hom eG.hom
              ((constantSheaf (J.over (X i).left) (ModuleCat.{w} Λ)).map f) := by
  -- Route correction: the remaining blocker is the finite-free constant-source descent, namely
  -- descending the locally recovered map from a finite free cover of the source module through its
  -- kernel relations on a common refinement.
  classical
  obtain ⟨I, X, hX, hcharts⟩ :=
    existsFiniteConstantModuleCoverWithCharts (J := J) (F := F) (Λ := Λ) U
  choose M hM eF htrivial using hcharts
  have hlocal :
      ∀ i : I,
        ∃ (K : Type (max u v)) (Y : K → Over (X i).left), (J.over (X i).left).CoversTop Y ∧
          ∀ j : K,
            ∃ (N : ModuleCat.{w} Λ) (f : M i ⟶ N)
              (eG : G.over (Y j).left ≅
                (constantSheaf (J.over (Y j).left) (ModuleCat.{w} Λ)).obj N),
                CommSq ((J.overPullback (ModuleCat.{w} Λ) (Y j).left).map φ)
                  (restrictConstantChartAlongOver
                    (J := J) (D := ModuleCat.{w} Λ) (eF i) (V := Y j)).hom
                  eG.hom
                  ((constantSheaf (J.over (Y j).left) (ModuleCat.{w} Λ)).map f) := by
    intro i
    letI : Module.Finite Λ (M i) := hM i
    -- Proof comment: the module case uses the same sigma-cover assembly once the chartwise local
    -- constant-source descent has been produced.
    simpa using
      existsConstantModuleSourceLocal (J := J) (Λ := Λ) (F := F) (G := G) φ
        (U := (X i).left) (M := M i) (eF := eF i)
  choose K Y hY hcomm using hlocal
  refine ⟨Sigma K, fun a ↦ Over.mk ((Y a.1 a.2).hom ≫ (X a.1).hom), ?_, ?_⟩
  · -- Proof comment: compose the finite-type source cover with the local module refinements.
    exact coversTopSigmaComp (J := J) (X := X) hX (Y := Y) hY
  · intro a
    rcases hcomm a.1 a.2 with ⟨N, f, eG, hsq⟩
    refine ⟨M a.1, N, f, ?_, eG, ?_⟩
    · exact
        restrictConstantChartAlongOver (J := J) (D := ModuleCat.{w} Λ) (eF a.1)
          (V := Y a.1 a.2)
    · simpa using hsq

-- Proof sketch: package the slice-local statement into one ambient top cover.
/-- Lemma 18.43.3 (3): for a morphism of locally constant sheaves of `\Lambda`-modules whose
source is locally constant of finite type, there is a covering of the terminal object on which the
restriction fits into a commutative square with a map of constant sheaves of `\Lambda`-modules
associated with a `\Lambda`-linear map. -/
@[stacks 093S]
theorem exists_coversTop_restriction_isConstantSheafMap_module
    {F G : Sheaf J (ModuleCat.{w} Λ)} (φ : F ⟶ G)
    [IsFiniteTypeLocallyConstantModule F] [IsLocallyConstant G] :
    ∃ (I : Type (max u v)) (U : I → C), J.CoversTop U ∧
      ∀ i : I,
        ∃ (M N : ModuleCat.{w} Λ) (f : M ⟶ N)
          (eF : F.over (U i) ≅ (constantSheaf (J.over (U i)) (ModuleCat.{w} Λ)).obj M)
          (eG : G.over (U i) ≅ (constantSheaf (J.over (U i)) (ModuleCat.{w} Λ)).obj N),
            CommSq ((J.overPullback (ModuleCat.{w} Λ) (U i)).map φ) eF.hom eG.hom
              ((constantSheaf (J.over (U i)) (ModuleCat.{w} Λ)).map f) := by
  exact exists_coversTop_of_over_cover_data (J := J)
    (P := fun U ↦
      ∃ (M N : ModuleCat.{w} Λ) (f : M ⟶ N)
        (eF : F.over U ≅ (constantSheaf (J.over U) (ModuleCat.{w} Λ)).obj M)
        (eG : G.over U ≅ (constantSheaf (J.over U) (ModuleCat.{w} Λ)).obj N),
          CommSq ((J.overPullback (ModuleCat.{w} Λ) U).map φ) eF.hom eG.hom
            ((constantSheaf (J.over U) (ModuleCat.{w} Λ)).map f))
    (fun U ↦ exists_over_cover_restriction_isConstantSheafMap_module_local (J := J) φ U)

