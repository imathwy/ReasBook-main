  (forget₂ RingCat AddCommGrpCat)]
variable [MonoidalCategory (ringedSiteModuleCategory J 𝒪)]
variable [∀ U : C, MonoidalCategory (ringedSiteModuleCategory (J.over U) (𝒪.over U))]

/-- The tensor product of two module sheaves, viewed in `ringedSiteModuleCategory J 𝒪`. -/
private abbrev tensorModule (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪) :
    ringedSiteModuleCategory J 𝒪 :=
  ℱ ⊗ 𝒢

/-- Helper for Lemma 18.26.3: the sieve generated by a family of slice objects is the sieve
generated by the corresponding underlying arrows in the ambient site. -/
private theorem over_sieve_of_objects_eq_of_arrows
    {U : C} {ι : Type*} (X : ι → Over U) :
    (Sieve.overEquiv (Over.mk (𝟙 U)))
        (Sieve.ofObjects X (Over.mk (𝟙 U))) =
      Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) := by
  constructor
  · ext W g
    intro hg
    -- Proof comment: a factorization in the slice category forgets to the same factorization in
    -- the ambient site.
    rw [Sieve.overEquiv_iff] at hg
    rw [Sieve.mem_ofObjects_iff] at hg
    rcases hg with ⟨i, ⟨a⟩⟩
    rw [Sieve.mem_ofArrows_iff]
    exact ⟨i, a.left, by simpa using a.w.symm⟩
  · ext W g
    intro hg
    -- Proof comment: conversely, any underlying factorization lifts uniquely to the slice.
    rw [Sieve.overEquiv_iff]
    rw [Sieve.mem_ofArrows_iff] at hg
    rcases hg with ⟨i, a, ha⟩
    rw [Sieve.mem_ofObjects_iff]
    exact ⟨i, ⟨Over.homMk a (by simpa using ha.symm)⟩⟩

/-- Helper for Lemma 18.26.3: composing a covering of `U` in the slice site with coverings of each
member gives a sigma-indexed covering of `U`. -/
private theorem coversTopOfSigmaCharts
    (P : C → Prop)
    (hP : ∀ U : C,
      ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
        ∀ i : I, P (X i).left) :
    ∃ (I : Type (max u v)) (Y : I → C), J.CoversTop Y ∧
      ∀ i : I, P (Y i) := by
  classical
  choose I X hX hprop using hP
  refine ⟨Sigma I, fun a ↦ (X a.1 a.2).left, ?_, ?_⟩
  · intro U
    -- Proof comment: the slice cover chosen over `U` generates a covering sieve on `U`, and each
    -- generator already appears in the sigma-indexed ambient family.
    have hcover :
        Sieve.ofArrows (fun i ↦ (X U i).left) (fun i ↦ (X U i).hom) ∈ J U := by
      have hterminal :
          Sieve.ofObjects (X U) (Over.mk (𝟙 U)) ∈ (J.over U) (Over.mk (𝟙 U)) :=
        (GrothendieckTopology.coversTop_iff_of_isTerminal
          (J := J.over U) (X := Over.mk (𝟙 U)) (hX := Over.mkIdTerminal)).1 (hX U)
      rw [GrothendieckTopology.mem_over_iff, over_sieve_of_objects_eq_of_arrows] at hterminal
      exact hterminal
    refine J.superset_covering ?_ hcover
    intro V f hf
    rw [Sieve.mem_ofArrows_iff] at hf
    rw [Sieve.mem_ofObjects_iff]
    rcases hf with ⟨i, g, hg⟩
    exact ⟨⟨U, i⟩, ⟨g⟩⟩
  · intro a
    exact hprop a.1 a.2

/-- Helper for Lemma 18.26.3: composing a covering of `U` in the slice site with coverings of each
member gives a sigma-indexed covering of `U`. -/
private theorem coversTopSigmaComp
    {U : C} {I : Type (max u v)} {X : I → Over U}
    (hX : (J.over U).CoversTop X)
    {K : I → Type (max u v)} {Y : ∀ i : I, K i → Over (X i).left}
    (hY : ∀ i : I, (J.over (X i).left).CoversTop (Y i)) :
    (J.over U).CoversTop
      (fun a : Sigma K ↦ Over.mk ((Y a.1 a.2).hom ≫ (X a.1).hom)) := by
  -- Proof comment: the tensor proof needs one common refinement of two slice covers. The missing
  -- step is the standard transitivity argument for `CoversTop` on the slice site.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal
    (J := J.over U) (X := Over.mk (𝟙 U)) (hX := Over.mkIdTerminal)]
  rw [GrothendieckTopology.mem_over_iff, over_sieve_of_objects_eq_of_arrows]
  have hX' :
      Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈ J U := by
    have hXTerminal :
        Sieve.ofObjects X (Over.mk (𝟙 U)) ∈ (J.over U) (Over.mk (𝟙 U)) :=
      (GrothendieckTopology.coversTop_iff_of_isTerminal
        (J := J.over U) (X := Over.mk (𝟙 U)) (hX := Over.mkIdTerminal)).1 hX
    rw [GrothendieckTopology.mem_over_iff, over_sieve_of_objects_eq_of_arrows] at hXTerminal
    exact hXTerminal
  have hY' :
      ∀ i : I,
        Sieve.ofArrows (fun k ↦ (Y i k).left) (fun k ↦ (Y i k).hom) ∈ J (X i).left := by
    intro i
    have hYTerminal :
        Sieve.ofObjects (Y i) (Over.mk (𝟙 (X i).left)) ∈
          (J.over (X i).left) (Over.mk (𝟙 (X i).left)) :=
      (GrothendieckTopology.coversTop_iff_of_isTerminal
        (J := J.over (X i).left) (X := Over.mk (𝟙 (X i).left))
        (hX := Over.mkIdTerminal)).1 (hY i)
    rw [GrothendieckTopology.mem_over_iff, over_sieve_of_objects_eq_of_arrows] at hYTerminal
    exact hYTerminal
  simpa [Presieve.bindOfArrows_ofArrows] using
    J.bindOfArrows
      (h := hX')
      (R := fun i ↦
        Presieve.ofArrows (fun k ↦ (Y i k).left) (fun k ↦ (Y i k).hom))
      (fun i ↦ by simpa using hY' i)

/-- Helper for Lemma 18.26.3: restricting the tensor product to a slice site identifies it with
the tensor product of the restrictions. -/
private noncomputable def tensorOverIso
    (U : C)
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪) :
    ((tensorModule ℱ 𝒢).over U) ≅
      (MonoidalCategoryStruct.tensorObj (ℱ.over U) (𝒢.over U) :
        ringedSiteModuleCategory (J.over U) (𝒪.over U)) :=
  -- Proof comment: the localized restriction functor is monoidal, so its standard tensor
  -- comparison directly identifies restriction of `ℱ ⊗ 𝒢` with the tensor of the restrictions.
  simpa [ringedSiteLocalizedRestriction, SheafOfModules.over] using
    (Functor.Monoidal.μIso (ringedSiteLocalizedRestriction J 𝒪 U) ℱ 𝒢)

/-- Helper for Lemma 18.26.3: after restricting to `U`, restricting once more along a slice
object `V` identifies the tensor restriction with the further restriction of the first-slice
tensor product. -/
private noncomputable def tensorOverOverIso
    {U : C} (V : Over U)
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪) :
    (((tensorModule ℱ 𝒢).over U).over V) ≅
      ((MonoidalCategoryStruct.tensorObj (ℱ.over U) (𝒢.over U) :
          ringedSiteModuleCategory (J.over U) (𝒪.over U)).over V) := by
  -- Route correction: the stronger doubly localized tensor comparison would require a monoidal
  -- instance on the iterated slice site, which this file header does not provide. The available
  -- comparison is the restriction of the already established single-slice tensor isomorphism.
  simpa [SheafOfModules.over] using
    (SheafOfModules.pushforward
      (𝟙 ((ringSheaf (J.over U) (𝒪.over U)).over V))).mapIso
        (tensorOverIso (J := J) (𝒪 := 𝒪) U ℱ 𝒢)

/-- Helper for Lemma 18.26.3: restricting a coherent sheaf to a slice keeps coherence as a
ringed-site property. -/
private theorem isCoherent_over_of_isCoherent
    {ℱ : ringedSiteModuleCategory J 𝒪} (h : IsCoherent ℱ) (U : C) :
    IsCoherent (ℱ.over U) := by
  -- Proof comment: finite type and the finite-kernel condition are both stated objectwise, so they
  -- transport directly to the slice site.
  refine ⟨?_, ?_⟩
  · refine ⟨fun V ↦ ?_⟩
    simpa [SheafOfModules.over] using h.toIsFiniteType.1 V.left
  · intro V r φ
    simpa [SheafOfModules.over] using h.isFiniteType_kernel V.left r φ

/-- Helper for Lemma 18.26.3: local freeness of both factors yields a cover on which the tensor
restriction is free. -/
private theorem exists_cover_isFree_over_tensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [IsLocallyFree ℱ] [IsLocallyFree 𝒢] :
    ∃ (I : Type (max u v)) (X : I → C), J.CoversTop X ∧
      ∀ i : I, SheafOfModules.IsFree ((tensorModule ℱ 𝒢).over (X i)) := by
  -- Proof comment: work objectwise in the local criterion, refine the free covers for the two
  -- factors to a common slice cover, and then transport the chartwise tensor-free instance back
  -- across `tensorOverIso`.
  classical
  refine coversTopOfSigmaCharts (J := J)
    (P := fun U ↦ SheafOfModules.IsFree ((tensorModule ℱ 𝒢).over U)) ?_
  intro U
  obtain ⟨I, X, hX, hfreeX⟩ := IsLocallyFree.isFree_over (ℱ := ℱ) U
  choose K Y hY hfreeY using
    fun i : I ↦ IsLocallyFree.isFree_over (ℱ := 𝒢) (X i).left
  refine ⟨Sigma K, fun a ↦ Over.mk ((Y a.1 a.2).hom ≫ (X a.1).hom),
    coversTopSigmaComp (J := J) (U := U) hX hY, fun a ↦ ?_⟩
  let Z : C := (Y a.1 a.2).left
  let _ : (((ℱ.over U).over (X a.1))).IsFree := hfreeX a.1
  have hℱZ : (ℱ.over Z).IsFree := by
    -- Proof comment: restrict the free model for `ℱ` on the `X a.1`-chart further to the
    -- refinement chart `Y a.1 a.2`.
    simpa [Z, SheafOfModules.over] using
      (inferInstance : ((((ℱ.over U).over (X a.1)).over (Y a.1 a.2))).IsFree)
  have h𝒢Z : (𝒢.over Z).IsFree := by
    -- Proof comment: the second-stage chart for `𝒢` is definitionally the restriction
    -- `𝒢|_{(Y a.1 a.2).left}`.
    simpa [Z, SheafOfModules.over] using hfreeY a.1 a.2
  let _ : (ℱ.over Z).IsFree := hℱZ
  let _ : (𝒢.over Z).IsFree := h𝒢Z
  have hTensor :
      (MonoidalCategoryStruct.tensorObj (ℱ.over Z) (𝒢.over Z) :
        ringedSiteModuleCategory (J.over Z) (𝒪.over Z)).IsFree := by
    infer_instance
  rcases SheafOfModules.IsFree.exists_iso_free
      (ℱ := (MonoidalCategoryStruct.tensorObj (ℱ.over Z) (𝒢.over Z) :
        ringedSiteModuleCategory (J.over Z) (𝒪.over Z))) with
    ⟨L, ⟨eL⟩⟩
  -- Proof comment: after normalizing the restriction of the ambient tensor, the explicit free
  -- model for the tensor of the restricted factors gives the required local freeness witness.
  exact ⟨L, ⟨tensorOverIso (J := J) (𝒪 := 𝒪) Z ℱ 𝒢 ≪≫ eL⟩⟩

/-- Helper for Lemma 18.26.3: finite local freeness of both factors yields a cover on which the
tensor restriction is finite free. -/
private theorem exists_cover_isFiniteFree_over_tensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [IsFiniteLocallyFree ℱ] [IsFiniteLocallyFree 𝒢] :
    ∃ (I : Type (max u v)) (X : I → C), J.CoversTop X ∧
      ∀ i : I, SheafOfModules.IsFiniteFree ((tensorModule ℱ 𝒢).over (X i)) := by
  -- Proof comment: repeat the locally free refinement argument, now keeping the finite basis data
  -- on each chart and transporting the resulting finite-free tensor model back through
  -- `tensorOverIso`.
  classical
  refine coversTopOfSigmaCharts (J := J)
    (P := fun U ↦ SheafOfModules.IsFiniteFree ((tensorModule ℱ 𝒢).over U)) ?_
  intro U
  obtain ⟨I, X, hX, hfreeX⟩ := IsFiniteLocallyFree.isFiniteFree_over (ℱ := ℱ) U
  choose K Y hY hfreeY using
    fun i : I ↦ IsFiniteLocallyFree.isFiniteFree_over (ℱ := 𝒢) (X i).left
  refine ⟨Sigma K, fun a ↦ Over.mk ((Y a.1 a.2).hom ≫ (X a.1).hom),
    coversTopSigmaComp (J := J) (U := U) hX hY, fun a ↦ ?_⟩
  let Z : C := (Y a.1 a.2).left
  let _ : (((ℱ.over U).over (X a.1))).IsFiniteFree := hfreeX a.1
  have hℱZ : (ℱ.over Z).IsFiniteFree := by
    -- Proof comment: finite freeness is preserved under the further restriction to the refined
    -- chart.
    simpa [Z, SheafOfModules.over] using
      (inferInstance : ((((ℱ.over U).over (X a.1)).over (Y a.1 a.2))).IsFiniteFree)
  have h𝒢Z : (𝒢.over Z).IsFiniteFree := by
    -- Proof comment: the chart coming from the right factor already carries the required
    -- finite-free witness after normalization.
    simpa [Z, SheafOfModules.over] using hfreeY a.1 a.2
  let _ : (ℱ.over Z).IsFiniteFree := hℱZ
  let _ : (𝒢.over Z).IsFiniteFree := h𝒢Z
  have hTensor :
      (MonoidalCategoryStruct.tensorObj (ℱ.over Z) (𝒢.over Z) :
        ringedSiteModuleCategory (J.over Z) (𝒪.over Z)).IsFiniteFree := by
    infer_instance
  rcases SheafOfModules.IsFiniteFree.exists_iso_free
      (ℱ := (MonoidalCategoryStruct.tensorObj (ℱ.over Z) (𝒢.over Z) :
        ringedSiteModuleCategory (J.over Z) (𝒪.over Z))) with
    ⟨L, hL, ⟨eL⟩⟩
  -- Proof comment: the tensor of the two finite-free chart models stays finite free, and the
  -- localized tensor comparison rewrites the ambient chart to that tensor.
  exact ⟨L, hL, ⟨tensorOverIso (J := J) (𝒪 := 𝒪) Z ℱ 𝒢 ≪≫ eL⟩⟩

/-- Helper for Lemma 18.26.3: local generators of both factors yield a cover on which the tensor
restriction is globally generated. -/
private theorem exists_cover_isGloballyGenerated_over_tensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [IsLocallyGeneratedBySections ℱ] [IsLocallyGeneratedBySections 𝒢] :
    ∃ (I : Type (max u v)) (X : I → C), J.CoversTop X ∧
      ∀ i : I, Nonempty ((tensorModule ℱ 𝒢).over (X i)).GeneratingSections := by
  -- Proof comment: refine the local generator covers for the two factors to a common chart, build
  -- the tensor generating family there, and transport it back through `tensorOverIso`.
  classical
  refine coversTopOfSigmaCharts (J := J)
    (P := fun U ↦ Nonempty ((tensorModule ℱ 𝒢).over U).GeneratingSections) ?_
  intro U
  obtain ⟨σX⟩ : Nonempty (ℱ.over U).LocalGeneratorsData := inferInstance
  choose K Y hY hgenY using
    fun i : σX.I ↦ by
      obtain ⟨σY⟩ : Nonempty (((𝒢.over U).over (σX.X i)).LocalGeneratorsData) := by
        simpa [SheafOfModules.over] using
          (show Nonempty (𝒢.over (σX.X i).left).LocalGeneratorsData from inferInstance)
      exact ⟨σY.I, σY.X, σY.coversTop, σY.generators⟩
  refine ⟨Sigma K, fun a ↦ Over.mk ((Y a.1 a.2).hom ≫ (σX.X a.1).hom),
    coversTopSigmaComp (J := J) (U := U) σX.coversTop hY, fun a ↦ ?_⟩
  let Z : C := (Y a.1 a.2).left
  let _ : Nonempty (((ℱ.over U).over (σX.X a.1)).GeneratingSections) := σX.generators a.1
  have hℱZ : Nonempty (ℱ.over Z).GeneratingSections := by
    -- Proof comment: the generating family for `ℱ` on the first-stage chart restricts to a
    -- generating family on the refinement chart.
    simpa [Z, SheafOfModules.over] using
      (inferInstance :
        Nonempty ((((ℱ.over U).over (σX.X a.1)).over (Y a.1 a.2))).GeneratingSections)
  have h𝒢Z : Nonempty (𝒢.over Z).GeneratingSections := by
    -- Proof comment: the right-factor chart is already a globally generated restriction after the
    -- standard iterated-restriction normalization.
    simpa [Z, SheafOfModules.over] using hgenY a.1 a.2
  rcases SheafOfModules.nonempty_generatingSections_tensor
      (ℱ := ℱ.over Z) (𝒢 := 𝒢.over Z) hℱZ h𝒢Z with ⟨σ⟩
  -- Proof comment: transport the chartwise tensor generating family back to the ambient tensor
  -- restriction using the canonical localized tensor isomorphism.
  exact ⟨(SheafOfModules.GeneratingSections.equivOfIso
    (tensorOverIso (J := J) (𝒪 := 𝒪) Z ℱ 𝒢)).symm σ⟩

/-- Helper for Lemma 18.26.3: on a fixed localized site, the tensor product of two finite-type
module sheaves is finite type. -/
private theorem isFiniteType_tensorModule
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [ℱ.IsFiniteType] [𝒢.IsFiniteType] :
    SheafOfModules.IsFiniteType (tensorModule ℱ 𝒢) := by
  refine ⟨fun U ↦ ?_⟩
  let _ :
      (MonoidalCategoryStruct.tensorObj (ℱ.over U) (𝒢.over U) :
        ringedSiteModuleCategory (J.over U) (𝒪.over U)).IsFiniteType := by
    infer_instance
  -- Proof comment: on each slice site, tensor finite type is already available; transport that
  -- fixed-site owner back across the localized tensor comparison.
  let P : CategoryTheory.ObjectProperty
      (ringedSiteModuleCategory (J.over U) (𝒪.over U)) :=
    SheafOfModules.IsFiniteType
  exact P.prop_of_iso (tensorOverIso (J := J) (𝒪 := 𝒪) U ℱ 𝒢) inferInstance

/-- Helper for Lemma 18.26.3: on a fixed localized site, the tensor product of two
quasi-coherent module sheaves is quasi-coherent. -/
private theorem isQuasicoherent_tensorModule
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [ℱ.IsQuasicoherent] [𝒢.IsQuasicoherent] :
    SheafOfModules.IsQuasicoherent (tensorModule ℱ 𝒢) := by
  refine ⟨fun U ↦ ?_⟩
  let _ :
      (MonoidalCategoryStruct.tensorObj (ℱ.over U) (𝒢.over U) :
        ringedSiteModuleCategory (J.over U) (𝒪.over U)).IsQuasicoherent := by
    infer_instance
  -- Proof comment: quasi-coherence on the slice is stable under the fixed-site tensor owner, and
  -- `tensorOverIso` rewrites the ambient restriction to that tensor.
  let P : CategoryTheory.ObjectProperty
      (ringedSiteModuleCategory (J.over U) (𝒪.over U)) :=
    SheafOfModules.IsQuasicoherent
  exact P.prop_of_iso (tensorOverIso (J := J) (𝒪 := 𝒪) U ℱ 𝒢) inferInstance

/-- Helper for Lemma 18.26.3: on a fixed localized site, the tensor product of two finitely
presented module sheaves is finitely presented. -/
private theorem isFinitePresentation_tensorModule
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [ℱ.IsFinitePresentation] [𝒢.IsFinitePresentation] :
    SheafOfModules.IsFinitePresentation (tensorModule ℱ 𝒢) := by
  refine ⟨fun U ↦ ?_⟩
  let _ :
      (MonoidalCategoryStruct.tensorObj (ℱ.over U) (𝒢.over U) :
        ringedSiteModuleCategory (J.over U) (𝒪.over U)).IsFinitePresentation := by
    infer_instance
  -- Proof comment: finite presentation on the slice tensor is already available, so the local
  -- comparison `tensorOverIso` closes the ambient restriction immediately.
  let P : CategoryTheory.ObjectProperty
      (ringedSiteModuleCategory (J.over U) (𝒪.over U)) :=
    SheafOfModules.IsFinitePresentation
  exact P.prop_of_iso (tensorOverIso (J := J) (𝒪 := 𝒪) U ℱ 𝒢) inferInstance

/-- Helper for Lemma 18.26.3: a coherent module on a ringed site is finitely presented. -/
private theorem isFinitePresentation_of_isCoherent
    (ℱ : ringedSiteModuleCategory J 𝒪) [IsCoherent ℱ] :
    ℱ.IsFinitePresentation := by
  refine ⟨fun U ↦ ?_⟩
  let _ : IsCoherent (ℱ.over U) :=
    isCoherent_over_of_isCoherent (J := J) (𝒪 := 𝒪) inferInstance U
  -- Proof comment: coherence of each localized restriction upgrades directly to finite
  -- presentation on that slice site.
  infer_instance

-- Proof sketch: choose a covering on which both sheaves become free, tensor the local free models,
-- and use the local criterion for local freeness to descend back to the original ringed site.
/-- Lemma 18.26.3 (1): if `\mathcal F` and `\mathcal G` are locally free
`\mathcal O`-modules on a ringed site, then `\mathcal F \otimes_{\mathcal O} \mathcal G`
is locally free. -/
@[stacks 03L6]
theorem isLocallyFree_ringedSiteModuleTensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [IsLocallyFree ℱ] [IsLocallyFree 𝒢] :
    IsLocallyFree (tensorModule ℱ 𝒢) := by
  -- Proof comment: on each slice site, apply the already established chartwise tensor-free cover
  -- and transport each chart back along `tensorOverOverIso`.
  refine ⟨fun U ↦ ?_⟩
  obtain ⟨I, X, hX, hfree⟩ :=
    exists_cover_isFree_over_tensor (J := J.over U) (𝒪 := 𝒪.over U) (ℱ := ℱ.over U)
      (𝒢 := 𝒢.over U)
  refine ⟨I, X, hX, fun i ↦ ?_⟩
  let P : CategoryTheory.ObjectProperty
      (ringedSiteModuleCategory ((J.over U).over (X i)) ((𝒪.over U).over (X i))) :=
    SheafOfModules.IsFree
  exact P.prop_of_iso
    (tensorOverOverIso (J := J) (𝒪 := 𝒪) (U := U) (X i) ℱ 𝒢).symm (hfree i)

-- Proof sketch: after refining to a common covering where both sheaves are finite free, the local
-- tensor product is again finite free; then apply the locality criterion for finite local freeness.
/-- Lemma 18.26.3 (2): if `\mathcal F` and `\mathcal G` are finite locally free
`\mathcal O`-modules on a ringed site, then `\mathcal F \otimes_{\mathcal O} \mathcal G`
is finite locally free. -/
@[stacks 03L6]
theorem isFiniteLocallyFree_ringedSiteModuleTensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [IsFiniteLocallyFree ℱ] [IsFiniteLocallyFree 𝒢] :
    IsFiniteLocallyFree (tensorModule ℱ 𝒢) := by
  -- Proof comment: work slicewise, use the chartwise finite-free tensor cover there, and transport
  -- each chart back to the ambient iterated restriction.
  refine ⟨fun U ↦ ?_⟩
  obtain ⟨I, X, hX, hfree⟩ :=
    exists_cover_isFiniteFree_over_tensor (J := J.over U) (𝒪 := 𝒪.over U)
      (ℱ := ℱ.over U) (𝒢 := 𝒢.over U)
  refine ⟨I, X, hX, fun i ↦ ?_⟩
  let P : CategoryTheory.ObjectProperty
      (ringedSiteModuleCategory ((J.over U).over (X i)) ((𝒪.over U).over (X i))) :=
    SheafOfModules.IsFiniteFree
  exact P.prop_of_iso
    (tensorOverOverIso (J := J) (𝒪 := 𝒪) (U := U) (X i) ℱ 𝒢).symm (hfree i)

-- Proof sketch: local generating sections for `\mathcal F` and `\mathcal G` produce local
-- generating sections for the tensor product by taking pairwise tensors on a common refinement.
/-- Lemma 18.26.3 (3): if `\mathcal F` and `\mathcal G` are locally generated by sections, then
`\mathcal F \otimes_{\mathcal O} \mathcal G` is locally generated by sections. -/
@[stacks 03L6]
theorem isLocallyGeneratedBySections_ringedSiteModuleTensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [IsLocallyGeneratedBySections ℱ] [IsLocallyGeneratedBySections 𝒢] :
    IsLocallyGeneratedBySections (tensorModule ℱ 𝒢) := by
  -- Proof comment: choose local generator data on each slice for both factors, refine those
  -- charts, and package the transported tensor generators into local-generator data.
  refine ⟨fun U ↦ ?_⟩
  classical
  obtain ⟨σX⟩ : Nonempty (ℱ.over U).LocalGeneratorsData := inferInstance
  choose K Y hY hgenY using
    fun i : σX.I ↦ by
      obtain ⟨σY⟩ : Nonempty (((𝒢.over U).over (σX.X i)).LocalGeneratorsData) := by
        simpa [SheafOfModules.over] using
          (show Nonempty (𝒢.over (σX.X i).left).LocalGeneratorsData from inferInstance)
      exact ⟨σY.I, σY.X, σY.coversTop, σY.generators⟩
  refine ⟨{
    I := Sigma K
    X := fun a ↦ Over.mk ((Y a.1 a.2).hom ≫ (σX.X a.1).hom)
    coversTop := coversTopSigmaComp (J := J) (U := U) σX.coversTop hY
    generators := fun a ↦ ?_
  }⟩
  let Z : C := (Y a.1 a.2).left
  let _ : Nonempty (((ℱ.over U).over (σX.X a.1)).GeneratingSections) := σX.generators a.1
  have hℱZ : Nonempty (ℱ.over Z).GeneratingSections := by
    -- Proof comment: the generators on the first-stage chart restrict to generators on the
    -- refinement chart.
    simpa [Z, SheafOfModules.over] using
      (inferInstance :
        Nonempty ((((ℱ.over U).over (σX.X a.1)).over (Y a.1 a.2))).GeneratingSections)
  have h𝒢Z : Nonempty (𝒢.over Z).GeneratingSections := by
    -- Proof comment: the second-stage chart for `𝒢` is already globally generated by the chosen
    -- local data.
    simpa [Z, SheafOfModules.over] using hgenY a.1 a.2
  rcases SheafOfModules.nonempty_generatingSections_tensor
      (ℱ := ℱ.over Z) (𝒢 := 𝒢.over Z) hℱZ h𝒢Z with ⟨σ⟩
  -- Proof comment: rewrite the ambient iterated restriction to the tensor of the two restricted
  -- factors and transport the generating family across that comparison.
  exact (SheafOfModules.GeneratingSections.equivOfIso
    (tensorOverOverIso (J := J) (𝒪 := 𝒪) (U := U)
      (Over.mk ((Y a.1 a.2).hom ≫ (σX.X a.1).hom)) ℱ 𝒢)).symm σ

-- Proof sketch: finite type means local finite generation, and the tensor product of two finite
-- generating families yields a finite generating family after refining the covering.
/-- Lemma 18.26.3 (4): if `\mathcal F` and `\mathcal G` are of finite type, then
`\mathcal F \otimes_{\mathcal O} \mathcal G` is of finite type. -/
@[stacks 03L6]
theorem isFiniteType_ringedSiteModuleTensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [ℱ.IsFiniteType] [𝒢.IsFiniteType] :
    (tensorModule ℱ 𝒢).IsFiniteType := by
  -- Proof comment: this target elaborates to the fixed-site owner, so the direct tensor-closure
  -- helper is the correct normal form.
  exact isFiniteType_tensorModule ℱ 𝒢

-- Proof sketch: choose local presentations for both factors, tensor those presentations on a
-- common covering, and use the local characterization of quasi-coherent sheaves.
/-- Lemma 18.26.3 (5): if `\mathcal F` and `\mathcal G` are quasi-coherent, then
`\mathcal F \otimes_{\mathcal O} \mathcal G` is quasi-coherent. -/
@[stacks 03L6]
theorem isQuasicoherent_ringedSiteModuleTensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [ℱ.IsQuasicoherent] [𝒢.IsQuasicoherent] :
    (tensorModule ℱ 𝒢).IsQuasicoherent := by
  -- Proof comment: the theorem statement already lives on the fixed-site owner, so the proof
  -- should use the corresponding tensor-closure helper directly.
  exact isQuasicoherent_tensorModule ℱ 𝒢

-- Proof sketch: finite local presentations tensor to finite local presentations on a common
-- refinement, so finite presentation is preserved by the tensor product.
/-- Lemma 18.26.3 (6): if `\mathcal F` and `\mathcal G` are of finite presentation, then
`\mathcal F \otimes_{\mathcal O} \mathcal G` is of finite presentation. -/
@[stacks 03L6]
theorem isFinitePresentation_ringedSiteModuleTensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [ℱ.IsFinitePresentation] [𝒢.IsFinitePresentation] :
    (tensorModule ℱ 𝒢).IsFinitePresentation := by
  -- Proof comment: finite presentation also targets the fixed-site owner, so no ambient cover
  -- rewrite is needed here.
  exact isFinitePresentation_tensorModule ℱ 𝒢

-- Proof sketch: tensor a finite presentation of `\mathcal F` with the coherent sheaf
-- `\mathcal G`, use finite presentation to control relations, and use coherence of
-- `\mathcal G` to keep the relevant kernels of finite type.
/-- Lemma 18.26.3 (7): if `\mathcal F` is of finite presentation and `\mathcal G` is coherent,
then `\mathcal F \otimes_{\mathcal O} \mathcal G` is coherent. -/
@[stacks 03L6]
theorem isCoherent_ringedSiteModuleTensor_of_isFinitePresentation_left
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [ℱ.IsFinitePresentation] [IsCoherent 𝒢] :
    IsCoherent (tensorModule ℱ 𝒢) := by
  -- Proof comment: coherence on the ringed site is checked slicewise, so on each slice we use the
  -- fixed-site coherent tensor instance and transport it back with `tensorOverIso`.
  refine ⟨?_, ?_⟩
  · let _ : ℱ.IsFiniteType := inferInstance
    let _ : 𝒢.IsFiniteType := inferInstance
    exact isFiniteType_tensorModule ℱ 𝒢
  · intro U r φ
    let _ : (ℱ.over U).IsFinitePresentation := inferInstance
    let _ : IsCoherent (𝒢.over U) :=
      isCoherent_over_of_isCoherent (J := J) (𝒪 := 𝒪) inferInstance U
    let _ :
        IsCoherent
          (MonoidalCategoryStruct.tensorObj (ℱ.over U) (𝒢.over U) :
            ringedSiteModuleCategory (J.over U) (𝒪.over U)) := by
      infer_instance
    let P : CategoryTheory.ObjectProperty
        (ringedSiteModuleCategory (J.over U) (𝒪.over U)) :=
      IsCoherent
    have hcohU : IsCoherent ((tensorModule ℱ 𝒢).over U) :=
      P.prop_of_iso (tensorOverIso (J := J) (𝒪 := 𝒪) U ℱ 𝒢) inferInstance
    -- Proof comment: the kernel clause for coherence is exactly the fixed-site clause applied at
    -- the terminal object of the slice site.
    simpa [SheafOfModules.over] using hcohU.isFiniteType_kernel (Over.mk (𝟙 U)) r φ

-- Proof sketch: combine the preceding finite-presentation-plus-coherent argument with the fact
-- that a coherent sheaf is of finite type, applying it symmetrically to both tensor factors.
/-- Lemma 18.26.3 (8): if `\mathcal F` and `\mathcal G` are coherent, then
`\mathcal F \otimes_{\mathcal O} \mathcal G` is coherent. -/
@[stacks 03L6]
theorem isCoherent_ringedSiteModuleTensor
    (ℱ 𝒢 : ringedSiteModuleCategory J 𝒪)
    [IsCoherent ℱ] [IsCoherent 𝒢] :
    IsCoherent (tensorModule ℱ 𝒢) := by
  -- Proof comment: coherence implies finite presentation on the left, so the previous theorem
  -- applies directly.
  let _ : ℱ.IsFinitePresentation := isFinitePresentation_of_isCoherent ℱ
  exact isCoherent_ringedSiteModuleTensor_of_isFinitePresentation_left ℱ 𝒢

end SheafOfModules.RingedSite
