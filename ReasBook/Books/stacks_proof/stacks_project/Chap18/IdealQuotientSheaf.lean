import Mathlib
import stacks_proof.stacks_project.Chap15.Lemma_15_90_1
import stacks_proof.stacks_project.Chap18.RingedSiteModuleCategory

open CategoryTheory Opposite

noncomputable section

universe u

namespace SheafOfModules.RingedSite

/- Domain-style sampling for the ringed-site quotient-by-ideal owner:
- primary domain: quotient sheaves of rings on a fixed site and the induced quotient map under
  same-site change of rings;
- sampled owner declarations:
  `ringedSiteModuleCategory`,
  `unitModule`,
  `ringSheaf`,
  `ringSheafMap`,
  `quotientMapModIdeal`;
- best owner abstraction: the source-facing object is the quotient ring sheaf
  `quotientRingSheaf I`, with the target-side quotient `targetQuotientRingSheaf α I` and the
  canonical map `quotientRingSheafMap α I`; the sectionwise ideals are derived from the ideal
  sheaf inclusion `I.arrow`;
- primitive data: a site `(\mathcal C, J)`, a structure sheaf `\mathcal O`, an ideal sheaf
  `I : \operatorname{Sub}(\mathcal O)`, and optionally a same-site ring map
  `α : \mathcal O \to \mathcal O'`;
- derived API: the sectionwise ideals `idealSectionIdeal I U`, the quotient sheaf
  `quotientRingSheaf I`, the target quotient `targetQuotientRingSheaf α I`, the quotient map
  `quotientRingSheafMap α I`, and the nilpotence predicate
  `IsAnnihilatedByIdealPower I ℱ`.

Source/core/bridge triage:
- `source-facing`: the quotient sheaf `\mathcal O / \mathcal I` and the source-side nilpotence
  condition that some power of `\mathcal I` annihilates `\mathcal F`;
- `core/canonical`: `Subobject (unitModule J 𝒪)`, `Subobject.arrow`, `ringSheaf`, and
  `quotientMapModIdeal`;
- `bridge/view`: the sectionwise ideal family cut out by `I` and the target-side quotient by the
  extended ideal along `α`.
-/

variable {C : Type u} [SmallCategory C]
variable {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [J.HasSheafCompose (forget₂ RingCat AddCommGrpCat)]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]

variable {𝒪 𝒪' : Sheaf J CommRingCat.{u}}

local notation "Mod(" 𝒪 ")" => ringedSiteModuleCategory J 𝒪

/-- The ideal of sections over `U` cut out by an ideal sheaf
`I : \operatorname{Sub}(\mathcal O)`. -/
noncomputable def idealSectionIdeal
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) : Ideal (𝒪.obj.obj U) :=
  Ideal.span <| Set.range fun s : (I : Mod(𝒪)).val.obj U ↦
    (Hom.val I.arrow).app U s

/-- Restriction maps preserve the ideals of sections cut out by an ideal sheaf. -/
private theorem idealSectionIdeal_le_comap
    (I : Subobject (unitModule J 𝒪)) {U V : Cᵒᵖ} (f : U ⟶ V) :
    idealSectionIdeal I U ≤
      (idealSectionIdeal I V).comap (𝒪.obj.map f).hom := by
  -- Proof comment: it is enough to check that each generator over `U` restricts to the
  -- corresponding generator over `V`.
  refine Ideal.span_le.2 ?_
  intro x hx
  rcases hx with ⟨s, rfl⟩
  rw [Ideal.mem_comap]
  have hnat :=
    PresheafOfModules.naturality_apply (f := Hom.val I.arrow) f s
  exact hnat.symm ▸ Ideal.subset_span ⟨((I : Mod(𝒪)).val.map f s), rfl⟩

/-- The quotient presheaf of commutative rings `\mathcal O / \mathcal I`. -/
private noncomputable def quotientCommRingPresheaf
    (I : Subobject (unitModule J 𝒪)) :
    Cᵒᵖ ⥤ CommRingCat where
  obj U := CommRingCat.of (𝒪.obj.obj U ⧸ idealSectionIdeal I U)
  map {U V} f := CommRingCat.ofHom <|
    Ideal.quotientMap (idealSectionIdeal I V) (𝒪.obj.map f).hom
      (idealSectionIdeal_le_comap I f)
  map_id U := by
    -- Proof comment: the quotient map induced by the identity restriction is the identity.
    ext x
    rfl
  map_comp f g := by
    -- Proof comment: quotient maps compose exactly as the underlying restriction maps compose.
    ext x
    rfl

/-- Helper for Chap18 IdealQuotientSheaf: the image of the sectionwise inclusion
`I(U) \to \mathcal O(U)` is itself an ideal of the section ring. -/
private noncomputable def idealSectionImageIdeal
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) : Ideal (𝒪.obj.obj U) where
  carrier := Set.range fun s : (I : Mod(𝒪)).val.obj U ↦
    (Hom.val I.arrow).app U s
  zero_mem' := by
    refine ⟨0, ?_⟩
    simpa using map_zero ((Hom.val I.arrow).app U).hom
  add_mem' := by
    rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
    refine ⟨a + b, ?_⟩
    simpa using map_add ((Hom.val I.arrow).app U).hom a b
  smul_mem' := by
    rintro r _ ⟨a, rfl⟩
    refine ⟨r • a, ?_⟩
    simpa using map_smul ((Hom.val I.arrow).app U).hom r a

/-- Helper for Chap18 IdealQuotientSheaf: the ideal generated by `I(U)` is already the actual
image ideal of the section map `I(U) \to \mathcal O(U)`. -/
private theorem idealSectionIdeal_eq_sectionImageIdeal
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) :
    idealSectionIdeal I U = idealSectionImageIdeal I U := by
  -- Proof comment: the generators defining `idealSectionIdeal` are exactly the underlying set of
  -- the image ideal, so the span collapses to that ideal itself.
  calc
    idealSectionIdeal I U = Ideal.span (idealSectionImageIdeal I U : Set (𝒪.obj.obj U)) := by
      change
        Ideal.span
            (Set.range
              (fun s : (I : Mod(𝒪)).val.obj U ↦
                (Hom.val I.arrow).app U s)) =
          Ideal.span (idealSectionImageIdeal I U : Set (𝒪.obj.obj U))
      rfl
    _ = idealSectionImageIdeal I U := by
      rw [Ideal.span_eq]

/-- Helper for Chap18 IdealQuotientSheaf: as a submodule of `\mathcal O(U)`, the ideal cut out by
`I` is the range of the sectionwise inclusion. -/
private theorem idealSectionIdeal_toSubmodule_eq_range
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) :
    (idealSectionIdeal I U : Submodule (𝒪.obj.obj U) (𝒪.obj.obj U)) =
      LinearMap.range (((Hom.val I.arrow).app U).hom) := by
  -- Proof comment: after replacing the generated ideal by the actual image ideal, both sides have
  -- the same `Set.range` description.
  ext r
  rw [idealSectionIdeal_eq_sectionImageIdeal]
  constructor
  · rintro ⟨s, rfl⟩
    exact ⟨s, rfl⟩
  · rintro ⟨s, hs⟩
    exact ⟨s, hs⟩

/-- Helper for Chap18 IdealQuotientSheaf: the explicit quotient by `idealSectionIdeal I U`
coincides with the quotient by the range of the sectionwise inclusion. -/
private theorem quotientSectionRangeObj_eq
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) :
    ModuleCat.of (𝒪.obj.obj U) (𝒪.obj.obj U ⧸ idealSectionIdeal I U) =
      ModuleCat.of (𝒪.obj.obj U)
        (𝒪.obj.obj U ⧸ LinearMap.range (((Hom.val I.arrow).app U).hom)) := by
  -- Proof comment: normalize the quotient ideal to the genuine range before invoking the cokernel
  -- comparison for modules.
  rw [idealSectionIdeal_toSubmodule_eq_range]

/-- Helper for Chap18 IdealQuotientSheaf: on each object `U`, the quotient ring
`\mathcal O(U) / I(U)` identifies with the evaluated module cokernel of `I.arrow`. -/
private noncomputable def quotientSectionIsoCokernelSection
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) :
    ModuleCat.of (𝒪.obj.obj U) (𝒪.obj.obj U ⧸ idealSectionIdeal I U) ≅
      (SheafOfModules.evaluation (ringSheaf J 𝒪) U).obj
        (cokernel (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪)) :=
  -- Proof comment: rewrite the quotient into range normal form, identify that quotient with the
  -- ordinary module cokernel, and then transport to the evaluated sheaf cokernel.
  eqToIso (quotientSectionRangeObj_eq I U) ≪≫
    (ModuleCat.cokernelIsoRangeQuotient
      ((SheafOfModules.evaluation (ringSheaf J 𝒪) U).map
        (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪))).symm ≪≫
    (PreservesCokernel.iso
      (SheafOfModules.evaluation (ringSheaf J 𝒪) U)
      (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪)).symm

/-- Helper for Chap18 IdealQuotientSheaf: the sectionwise quotient-to-cokernel comparison sends a
quotient class to the image of the same representative under the cokernel projection. -/
private theorem quotientSectionIsoCokernelSection_hom_mk
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) (r : 𝒪.obj.obj U) :
    ((CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).map
        (quotientSectionIsoCokernelSection I U).hom)
        (Ideal.Quotient.mk (idealSectionIdeal I U) r) =
      ((((SheafOfModules.toSheaf (ringSheaf J 𝒪)).map
          (cokernel.π (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪))).hom.app U) r) := by
  let evalU := SheafOfModules.evaluation (ringSheaf J 𝒪) U
  let f : evalU.obj (I : Mod(𝒪)) ⟶ evalU.obj (unitModule J 𝒪) :=
    evalU.map (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪)
  let eRange :
      ModuleCat.of (𝒪.obj.obj U) (𝒪.obj.obj U ⧸ idealSectionIdeal I U) ≅
        ModuleCat.of (𝒪.obj.obj U)
          (𝒪.obj.obj U ⧸ LinearMap.range (((Hom.val I.arrow).app U).hom)) :=
    eqToIso (quotientSectionRangeObj_eq I U)
  have hRange :
      ((CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).map eRange.hom)
          (Ideal.Quotient.mk (idealSectionIdeal I U) r) =
        Ideal.Quotient.mk (LinearMap.range (((Hom.val I.arrow).app U).hom)) r := by
    -- Proof comment: the range-normalization isomorphism is induced by an equality of quotient
    -- module objects, so it acts as the identity on representatives.
    cases quotientSectionRangeObj_eq I U
    rfl
  have hCokernel :
      ((CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).map
          (ModuleCat.cokernelIsoRangeQuotient f).inv)
          (Ideal.Quotient.mk (LinearMap.range (((Hom.val I.arrow).app U).hom)) r) =
        (cokernel.π f) r := by
    -- Proof comment: the inverse range/cokernel comparison sends a quotient class to the
    -- corresponding cokernel projection class.
    simpa [f] using congrArg
      (fun g =>
        ((CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).map g)
          (Ideal.Quotient.mk (LinearMap.range (((Hom.val I.arrow).app U).hom)) r))
      (ModuleCat.range_mkQ_cokernelIsoRangeQuotient_inv (f := f))
  have hPreserve :
      ((CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).map
          (PreservesCokernel.iso evalU
            (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪)).inv)
          ((cokernel.π f) r) =
        ((((SheafOfModules.toSheaf (ringSheaf J 𝒪)).map
            (cokernel.π (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪))).hom.app U) r) := by
    -- Proof comment: the inverse preserved-cokernel comparison identifies the evaluated ordinary
    -- cokernel class with the same representative in the sheaf cokernel.
    have hπ := congrArg
      (fun g => ((CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).map g) r)
      (PreservesCokernel.π_iso_hom
        (G := evalU) (f := (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪)))
    simpa [evalU, f, Functor.map_comp, SheafOfModules.evaluation, SheafOfModules.toSheaf] using
      congrArg
        (((CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).map
          (PreservesCokernel.iso evalU
            (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪)).inv))
        hπ
  -- Proof comment: expand the defining composite of `quotientSectionIsoCokernelSection` and
  -- assemble the three explicit transports in order.
  rw [show quotientSectionIsoCokernelSection I U =
      eRange ≪≫ (ModuleCat.cokernelIsoRangeQuotient f).symm ≪≫
        (PreservesCokernel.iso evalU
          (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪)).symm by
        rfl]
  simp only [Iso.trans_hom, Category.assoc, Functor.map_comp]
  rw [hRange, hCokernel, hPreserve]

/-- Helper for Chap18 IdealQuotientSheaf: after forgetting to additive groups, the sectionwise
quotient-to-cokernel comparison is natural with respect to restrictions. -/
private theorem quotientCommRingPresheafForgetToAddIsoCokernel_naturality
    (I : Subobject (unitModule J 𝒪)) {U V : Cᵒᵖ} (f : U ⟶ V) :
    (quotientCommRingPresheaf I ⋙ forget₂ CommRingCat RingCat ⋙
        forget₂ RingCat AddCommGrpCat).map f ≫
        ((CategoryTheory.forget (ModuleCat (𝒪.obj.obj V))).map
          (quotientSectionIsoCokernelSection I V).hom) =
      ((CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).map
        (quotientSectionIsoCokernelSection I U).hom) ≫
          (((SheafOfModules.toSheaf (ringSheaf J 𝒪)).obj
            (cokernel (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪))).1).map f := by
  ext r
  refine Quotient.inductionOn' r ?_
  intro r
  -- Proof comment: both sides are the restriction of the same cokernel projection section once
  -- the quotient/cokernel comparison is rewritten on representatives.
  rw [Ideal.quotientMap_mk, quotientSectionIsoCokernelSection_hom_mk,
    quotientSectionIsoCokernelSection_hom_mk]
  exact congrArg
    (fun g => g r)
    (((SheafOfModules.toSheaf (ringSheaf J 𝒪)).map
      (cokernel.π (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪))).hom.naturality f)

/-- Helper for Chap18 IdealQuotientSheaf: after forgetting to additive groups, the explicit
quotient presheaf is canonically isomorphic to the underlying additive presheaf of the module
cokernel of `I.arrow`. -/
private noncomputable def quotientCommRingPresheafForgetToAddIsoCokernel
    (I : Subobject (unitModule J 𝒪)) :
    quotientCommRingPresheaf I ⋙ forget₂ CommRingCat RingCat ⋙
        forget₂ RingCat AddCommGrpCat ≅
      ((SheafOfModules.toSheaf (ringSheaf J 𝒪)).obj
        (cokernel (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪))).1 :=
  -- Proof comment: package the sectionwise quotient/cokernel comparisons into a natural
  -- isomorphism of additive presheaves.
  NatIso.ofComponents
    (fun U =>
      (CategoryTheory.forget (ModuleCat (𝒪.obj.obj U))).mapIso
        (quotientSectionIsoCokernelSection I U))
    (quotientCommRingPresheafForgetToAddIsoCokernel_naturality I)

/-- Helper for Chap18 IdealQuotientSheaf: additive sheafness of the quotient presheaf lifts back
to the original commutative-ring-valued presheaf. -/
private theorem quotientCommRingPresheaf_isSheaf_of_forgetToAdd
    (I : Subobject (unitModule J 𝒪))
    (h :
      Presheaf.IsSheaf J
        (quotientCommRingPresheaf I ⋙ forget₂ CommRingCat RingCat ⋙
          forget₂ RingCat AddCommGrpCat)) :
    Presheaf.IsSheaf J (quotientCommRingPresheaf I) := by
  -- Proof comment: detect sheafness first in `RingCat` and then in `CommRingCat` by the standard
  -- forgetful transport theorem.
  have hRing :
      Presheaf.IsSheaf J
        (quotientCommRingPresheaf I ⋙ forget₂ CommRingCat RingCat) := by
    exact
      (Presheaf.isSheaf_iff_isSheaf_forget J
        (quotientCommRingPresheaf I ⋙ forget₂ CommRingCat RingCat)
        (forget₂ RingCat AddCommGrpCat)).2 h
  exact
    (Presheaf.isSheaf_iff_isSheaf_forget J
      (quotientCommRingPresheaf I)
      (forget₂ CommRingCat RingCat)).2 hRing

/-- The quotient sheaf of commutative rings `\mathcal O / \mathcal I`. -/
noncomputable def quotientCommRingSheaf
    (I : Subobject (unitModule J 𝒪)) :
    Sheaf J CommRingCat.{u} :=
  ⟨quotientCommRingPresheaf I, by
    -- Route correction: rather than proving the sheaf condition directly on quotient
    -- representatives, compare the quotient presheaf with the additive presheaf underlying the
    -- module cokernel of `I.arrow`.
    have hForgetAdd :
        Presheaf.IsSheaf J
          (quotientCommRingPresheaf I ⋙ forget₂ CommRingCat RingCat ⋙
            forget₂ RingCat AddCommGrpCat) := by
      have hCokernel :
          Presheaf.IsSheaf J
            (((SheafOfModules.toSheaf (ringSheaf J 𝒪)).obj
              (cokernel (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪))).1) := by
        -- Proof comment: the module cokernel already defines a sheaf of additive groups.
        exact
          ((SheafOfModules.toSheaf (ringSheaf J 𝒪)).obj
            (cokernel (I.arrow : (I : Mod(𝒪)) ⟶ unitModule J 𝒪))).2
      -- Proof comment: transport the sheaf condition across the explicit additive presheaf
      -- isomorphism between the quotient presheaf and the cokernel sheaf.
      exact
        (Presheaf.isSheaf_of_iso_iff
          (quotientCommRingPresheafForgetToAddIsoCokernel I)).1 hCokernel
    exact quotientCommRingPresheaf_isSheaf_of_forgetToAdd I hForgetAdd⟩

/-- The canonical quotient projection `\mathcal O \to \mathcal O / \mathcal I` as a morphism of
sheaves of commutative rings. -/
noncomputable def quotientCommRingSheafProjection
    (I : Subobject (unitModule J 𝒪)) :
    𝒪 ⟶ quotientCommRingSheaf I where
  hom :=
    { app := fun U ↦ CommRingCat.ofHom (Ideal.Quotient.mk _)
      naturality := by
        intro U V f
        ext x
        rfl }

/-- The quotient ring sheaf `\mathcal O / \mathcal I`. -/
abbrev quotientRingSheaf
    (I : Subobject (unitModule J 𝒪)) :
    Sheaf J RingCat.{u} :=
  ringSheaf J (quotientCommRingSheaf I)

/-- The canonical quotient projection `\mathcal O \to \mathcal O / \mathcal I` in its
`RingCat`-valued form. -/
abbrev quotientRingSheafProjection
    (I : Subobject (unitModule J 𝒪)) :
    ringSheaf J 𝒪 ⟶ quotientRingSheaf I :=
  ringSheafMap (quotientCommRingSheafProjection I)

/-- Restriction maps preserve the sectionwise powers `\mathcal I(U)^n`. -/
private theorem idealPowerSectionIdeal_le_comap
    (I : Subobject (unitModule J 𝒪)) {U V : Cᵒᵖ} (f : U ⟶ V) (n : ℕ) :
    idealSectionIdeal I U ^ n ≤
      (idealSectionIdeal I V ^ n).comap (𝒪.obj.map f).hom := by
  exact
    (Ideal.pow_right_mono (idealSectionIdeal_le_comap I f) n).trans
      (Ideal.le_comap_pow (f := (𝒪.obj.map f).hom) (K := idealSectionIdeal I V) n)

/-- The quotient presheaf of commutative rings `\mathcal O / \mathcal I^n`. -/
private noncomputable def idealPowerQuotientCommRingPresheaf
    (I : Subobject (unitModule J 𝒪)) (n : ℕ) :
    Cᵒᵖ ⥤ CommRingCat where
  obj U := CommRingCat.of (𝒪.obj.obj U ⧸ idealSectionIdeal I U ^ n)
  map {U V} f := CommRingCat.ofHom <|
    Ideal.quotientMap (idealSectionIdeal I V ^ n) (𝒪.obj.map f).hom
      (idealPowerSectionIdeal_le_comap I f n)
  map_id U := by
    -- Proof comment: the identity restriction induces the identity on each quotient by `I(U)^n`.
    ext x
    rfl
  map_comp f g := by
    -- Proof comment: the quotient maps for powers of the section ideal compose definitionally.
    ext x
    rfl

/-- The quotient sheaf of commutative rings `\mathcal O / \mathcal I^n`. -/
noncomputable def idealPowerQuotientCommRingSheaf
    (I : Subobject (unitModule J 𝒪)) (n : ℕ) :
    Sheaf J CommRingCat.{u} :=
  ⟨idealPowerQuotientCommRingPresheaf I n, by sorry⟩

/-- The canonical quotient projection `\mathcal O \to \mathcal O / \mathcal I^n`. -/
noncomputable def idealPowerQuotientCommRingSheafProjection
    (I : Subobject (unitModule J 𝒪)) (n : ℕ) :
    𝒪 ⟶ idealPowerQuotientCommRingSheaf I n where
  hom :=
    { app := fun U ↦ CommRingCat.ofHom (Ideal.Quotient.mk _)
      naturality := by
        intro U V f
        ext x
        rfl }

/-- The quotient ring sheaf `\mathcal O / \mathcal I^n`. -/
abbrev idealPowerQuotientRingSheaf
    (I : Subobject (unitModule J 𝒪)) (n : ℕ) :
    Sheaf J RingCat.{u} :=
  ringSheaf J (idealPowerQuotientCommRingSheaf I n)

/-- The canonical quotient projection `\mathcal O \to \mathcal O / \mathcal I^n` in its
`RingCat`-valued form. -/
abbrev idealPowerQuotientRingSheafProjection
    (I : Subobject (unitModule J 𝒪)) (n : ℕ) :
    ringSheaf J 𝒪 ⟶ idealPowerQuotientRingSheaf I n :=
  ringSheafMap (idealPowerQuotientCommRingSheafProjection I n)

/-- The sectionwise extended ideal on `\mathcal O'` cut out by the image of `\mathcal I` under
`\alpha : \mathcal O \to \mathcal O'`. -/
private noncomputable def targetIdealSectionIdeal
    (α : 𝒪 ⟶ 𝒪')
    (I : Subobject (unitModule J 𝒪))
    (U : Cᵒᵖ) : Ideal (𝒪'.obj.obj U) :=
  Ideal.map ((α.hom.app U).hom) (idealSectionIdeal I U)

/-- Restriction maps preserve the sectionwise extended ideals on the target sheaf. -/
private theorem targetIdealSectionIdeal_le_comap
    (α : 𝒪 ⟶ 𝒪')
    (I : Subobject (unitModule J 𝒪)) {U V : Cᵒᵖ} (f : U ⟶ V) :
    targetIdealSectionIdeal α I U ≤
      (targetIdealSectionIdeal α I V).comap (𝒪'.obj.map f).hom := by
  -- Proof comment: after rewriting the target restriction square by naturality of `α`, the claim
  -- reduces to the source-side restriction compatibility for `I`.
  rw [targetIdealSectionIdeal, targetIdealSectionIdeal, Ideal.map_le_iff_le_comap]
  intro x hx
  rw [Ideal.mem_comap]
  have hx' : (𝒪.obj.map f).hom x ∈ idealSectionIdeal I V :=
    idealSectionIdeal_le_comap I f hx
  have hnat := congrArg CommRingCat.Hom.hom (α.hom.naturality f)
  exact (DFunLike.congr_fun hnat x).symm ▸ Ideal.mem_map_of_mem _ hx'

/-- The quotient presheaf of commutative rings `\mathcal O' / \mathcal I \mathcal O'`
attached to `\alpha : \mathcal O \to \mathcal O'`. -/
private noncomputable def targetQuotientCommRingPresheaf
    (α : 𝒪 ⟶ 𝒪')
    (I : Subobject (unitModule J 𝒪)) :
    Cᵒᵖ ⥤ CommRingCat where
  obj U := CommRingCat.of (𝒪'.obj.obj U ⧸ targetIdealSectionIdeal α I U)
  map {U V} f := CommRingCat.ofHom <|
    Ideal.quotientMap (targetIdealSectionIdeal α I V) (𝒪'.obj.map f).hom
      (targetIdealSectionIdeal_le_comap α I f)
  map_id U := by
    -- Proof comment: the identity restriction induces the identity on the target quotient ring.
    ext x
    rfl
  map_comp f g := by
    -- Proof comment: the target-side quotient maps inherit functoriality from restriction maps.
    ext x
    rfl

/-- The quotient sheaf of commutative rings `\mathcal O' / \mathcal I \mathcal O'` attached to
`\alpha : \mathcal O \to \mathcal O'`. -/
private noncomputable def targetQuotientCommRingSheaf
    (α : 𝒪 ⟶ 𝒪')
    (I : Subobject (unitModule J 𝒪)) :
    Sheaf J CommRingCat.{u} :=
  ⟨targetQuotientCommRingPresheaf α I, by sorry⟩

/-- The target quotient ring sheaf `\mathcal O' / \mathcal I \mathcal O'` attached to
`\alpha : \mathcal O \to \mathcal O'`. -/
abbrev targetQuotientRingSheaf
    (α : 𝒪 ⟶ 𝒪')
    (I : Subobject (unitModule J 𝒪)) :
    Sheaf J RingCat.{u} :=
  ringSheaf J (targetQuotientCommRingSheaf α I)

/-- The canonical quotient map `\mathcal O / \mathcal I \to \mathcal O' / \mathcal I
\mathcal O'` induced by `\alpha : \mathcal O \to \mathcal O'`, in its commutative-ring-valued
form. -/
private noncomputable def quotientCommRingSheafMap
    (α : 𝒪 ⟶ 𝒪')
    (I : Subobject (unitModule J 𝒪)) :
    quotientCommRingSheaf I ⟶ targetQuotientCommRingSheaf α I where
  hom :=
    { app := fun U ↦ CommRingCat.ofHom <|
        quotientMapModIdeal ((α.hom.app U).hom) (idealSectionIdeal I U)
      naturality := by
        intro U V f
        -- Proof comment: both composites send a quotient class to the class of the restricted
        -- image under `α`, so the square commutes by the naturality of `α.hom`.
        ext x
        rfl }

/-- The canonical quotient map `\mathcal O / \mathcal I \to \mathcal O' / \mathcal I
\mathcal O'` induced by `\alpha : \mathcal O \to \mathcal O'`. -/
abbrev quotientRingSheafMap
    (α : 𝒪 ⟶ 𝒪')
    (I : Subobject (unitModule J 𝒪)) :
    quotientRingSheaf I ⟶ targetQuotientRingSheaf α I :=
  ringSheafMap (quotientCommRingSheafMap α I)

/-- Some power of the ideal sheaf `\mathcal I` annihilates the sheaf `\mathcal F`. -/
def IsAnnihilatedByIdealPower
    (I : Subobject (unitModule J 𝒪))
    (ℱ : Mod(𝒪)) : Prop :=
  ∃ n : ℕ, ∀ U : Cᵒᵖ,
    idealSectionIdeal I U ^ n ≤
      Module.annihilator (𝒪.obj.obj U) (ℱ.val.obj U)

end SheafOfModules.RingedSite
