import Mathlib
import Mathlib.Tactic.Recall
import StacksProject_2024.Chap18.Definition_18_5_1

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory Opposite

noncomputable section

universe v u

namespace CategoryTheory

section

variable {C : Type u} [Category.{v} C]
variable (J : GrothendieckTopology C)
variable [HasWeakSheafify J (Type (max u v))] [HasWeakSheafify J AddCommGrpCat.{max u v}]
variable [J.PreservesSheafification AddCommGrpCat.free]
variable (𝒢 : Cᵒᵖ ⥤ Type (max u v))

open scoped FreeAbelianSheaf

/- Domain-style sampling for Lemma 18.5.3:
- primary domain: sheafification on a site and the free abelian sheaf generated by a
  set-valued presheaf;
- sampled owner API:
  `Sheaf.composeAndSheafify`,
  `presheafToSheafCompComposeAndSheafifyIso`,
  `sheafifyComposeIso`,
  `(ℤ_ 𝒢)^#[J]`;
- best owner abstraction: the sheaf-level owner `Sheaf.composeAndSheafify J AddCommGrpCat.free`,
  with the chapter source-facing notation `(ℤ_ 𝒢)^#[J]` for the sheafified free abelian
  presheaf;
- primitive data: the site `(C, J)`, the presheaf `𝒢`, and the free abelian group functor
  `AddCommGrpCat.free`;
- derived API: the canonical comparison
  `(Sheaf.composeAndSheafify J AddCommGrpCat.free).obj ((presheafToSheaf J (Type (max u v))).obj 𝒢)
    ≅ (ℤ_ 𝒢)^#[J]`.

Source/core/bridge triage:
- `source-facing`: the free abelian sheaf `(ℤ_ 𝒢)^#[J]`;
- `core/canonical`: `Sheaf.composeAndSheafify J AddCommGrpCat.free`;
- `bridge/view`: `(presheafToSheafCompComposeAndSheafifyIso J AddCommGrpCat.free).app 𝒢`,
  whose underlying-presheaf specialization is `sheafifyComposeIso`. -/

/- Lemma 18.5.3: the free abelian sheaf on `𝒢` is canonically identified with the free abelian
sheaf obtained by applying `Sheaf.composeAndSheafify J AddCommGrpCat.free` to the sheafification
of `𝒢`. This keeps the statement at the chapter's source-facing sheaf surface rather than only at
the underlying-presheaf specialization. -/
recall CategoryTheory.Sheaf.composeAndSheafify
recall CategoryTheory.presheafToSheafCompComposeAndSheafifyIso

#check (Sheaf.composeAndSheafify J AddCommGrpCat.free :
  Sheaf J (Type (max u v)) ⥤ Sheaf J AddCommGrpCat.{max u v})

#check ((presheafToSheafCompComposeAndSheafifyIso J AddCommGrpCat.free).app 𝒢 :
  (Sheaf.composeAndSheafify J AddCommGrpCat.free).obj ((presheafToSheaf J (Type (max u v))).obj 𝒢) ≅
    (ℤ_ 𝒢)^#[J])

end

end CategoryTheory
