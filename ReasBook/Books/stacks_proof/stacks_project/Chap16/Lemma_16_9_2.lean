/-- A global resolution of `R → A → Λ ⊃ q` is a finitely presented `R`-algebra factorization
`A → B → Λ` whose target singular ideal contains `𝔥_A` and is not contained in `q`. -/
def ResolvableAtPrime (R : Type u) (A : Type v) (Λ : Type w)
    [CommRing R] [CommRing A] [CommRing Λ]
    [Algebra R A] [Algebra R Λ] [Algebra A Λ] [IsScalarTower R A Λ]
    (q : Ideal Λ) : Prop :=
  ∃ (B : Type (max u v w)) (_ : CommRing B) (_ : Algebra R B) (_ : FinitePresentation R B)
    (f : A →ₐ[R] B) (g : B →ₐ[R] Λ),
    g.comp f = IsScalarTower.toAlgHom R A Λ ∧
      h(A⁄R, Λ) ≤ g.singularIdealIn R ∧
      ¬ g.singularIdealIn R ≤ q

-- Proof sketch: this is just the definition of `ResolvableAtPrime`, unpacking the existence of
-- a finitely presented factorization `A → B → Λ` and the two singular-ideal conditions.
/-- Unfolding `ResolvableAtPrime q` gives a finitely presented factorization `A → B → Λ` whose
target singular ideal contains `𝔥_A` and is not contained in `q`. -/
theorem resolvableAtPrime_iff (q : Ideal Λ) :
    ResolvableAtPrime R A Λ q ↔
      ∃ (B : Type (max u v w)) (_ : CommRing B) (_ : Algebra R B) (_ : FinitePresentation R B)
        (f : A →ₐ[R] B) (g : B →ₐ[R] Λ),
        g.comp f = IsScalarTower.toAlgHom R A Λ ∧
          h(A⁄R, Λ) ≤ g.singularIdealIn R ∧
          ¬ g.singularIdealIn R ≤ q :=
  Iff.rfl

/-- The ideal generated by the `e`-th powers of the first `n` elements of the family `π`. -/
def piPowPrefixIdeal (e n : ℕ) (hn : n ≤ r) : Ideal R :=
  Ideal.span (Set.range fun i : Fin n ↦ π (Fin.castLE hn i) ^ e)

-- Proof sketch: this is the defining formula of `piPowPrefixIdeal`.
/-- Unfolding the prefix ideal generated by the `e`-th powers of the family `π`. -/
theorem piPowPrefixIdeal_def (e n : ℕ) (hn : n ≤ r) :
    piPowPrefixIdeal π e n hn =
      Ideal.span (Set.range fun i : Fin n ↦ π (Fin.castLE hn i) ^ e) :=
  rfl

/-- The ideal generated by the eighth powers of all `r` elements of the family `π`. -/
abbrev piPowEightReductionIdeal : Ideal R :=
  piPowPrefixIdeal π 8 r le_rfl

-- Proof sketch: this is the special case `e = 8` and `n = r` of `piPowPrefixIdeal`.
/-- Unfolding the final eighth-power reduction ideal attached to the family `π`. -/
theorem piPowEightReductionIdeal_def :
    piPowEightReductionIdeal π = piPowPrefixIdeal π 8 r le_rfl :=
  rfl

local notation "I8" => piPowEightReductionIdeal π
local notation "R8" => R ⧸ I8
local notation "A8" => A ⧸ Ideal.map (algebraMap R A) I8
local notation "L8" => Λ ⧸ Ideal.map (algebraMap R Λ) I8

-- Proof sketch: each generator `π i ^ 8` maps into `q` because `π i` does, and ideals generated
-- by elements mapping into `q` map into `q`.
/-- If every `π i` maps into `q`, then the ideal generated by the `π i^8` maps into `q`. -/
theorem map_piPowEightReductionIdeal_le
    (q : Ideal Λ) (hπq : ∀ i : Fin r, algebraMap R Λ (π i) ∈ q) :
    Ideal.map (algebraMap R Λ) I8 ≤ q := by
  rw [piPowEightReductionIdeal_def, piPowPrefixIdeal_def]
  refine Ideal.map_le_iff_le_comap.2 ?_
  refine Ideal.span_le.2 ?_
  rintro _ ⟨i, rfl⟩
  simpa [Ideal.mem_comap, map_pow] using q.pow_mem_of_mem (hπq i) 8 (by decide)

/-- The quotient `A / I8 A` inherits its canonical algebra structure over `R / I8`. -/
instance : Algebra R8 A8 :=
  Ideal.Quotient.algebraQuotientOfLEComap Ideal.le_comap_map

/-- The quotient `Λ / I8 Λ` inherits its canonical algebra structure over `A / I8 A`. -/
instance : Algebra A8 L8 :=
  Ideal.Quotient.algebraQuotientOfLEComap <| by
    simpa [Ideal.map_map, IsScalarTower.algebraMap_eq R A Λ] using
      (Ideal.le_comap_map :
        Ideal.map (algebraMap R A) I8 ≤
          Ideal.comap (algebraMap A Λ)
            (Ideal.map (algebraMap A Λ) (Ideal.map (algebraMap R A) I8)))

/-- The quotient algebra structures on `R / I8`, `A / I8 A`, and `Λ / I8 Λ` form a scalar tower.
-/
instance : IsScalarTower R8 A8 L8 := by
  refine IsScalarTower.of_algebraMap_eq fun x ↦ ?_
  refine Quotient.inductionOn' x fun x ↦ ?_
  change
    Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I8) (algebraMap R Λ x) =
      Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I8) ((algebraMap A Λ) (algebraMap R A x))
  rw [IsScalarTower.algebraMap_eq R A Λ]
  rfl

/-- The image of `q` in the quotient ring `Λ / I8 Λ`. -/
abbrev piPowEightReductionPrime (q : Ideal Λ) : Ideal L8 :=
  Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I8)) q

-- Proof sketch: this is the defining formula of `piPowEightReductionPrime`.
/-- Unfolding the image of `q` in the quotient `Λ / I8 Λ`. -/
theorem piPowEightReductionPrime_def (q : Ideal Λ) :
    piPowEightReductionPrime π q =
      Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I8)) q :=
  rfl

-- Proof sketch: the ideal generated by the `π i^8` maps into `q`, so the image of the prime ideal
-- `q` in the quotient `Λ / I8 Λ` is again prime.
/-- If every `π i` maps into the prime `q`, then the induced ideal `q / I8 Λ` is prime in
`Λ / I8 Λ`. -/
theorem piPowEightReductionPrime_isPrime
    (q : Ideal Λ) [q.IsPrime] (hπq : ∀ i : Fin r, algebraMap R Λ (π i) ∈ q) :
    (piPowEightReductionPrime π q).IsPrime :=
  Ideal.isPrime_map_quotientMk_of_isPrime (map_piPowEightReductionIdeal_le π q hπq)

/-- Helper for Chap16 Lemma 16 9 2: a finitely presented factorization resolves itself at `q` as
soon as its target singular ideal is not contained in `q`. -/
private theorem resolvableAtPrime_self_of_singularIdeal_not_le
    {T : Type (max u v w)} [CommRing T] [Algebra R T] [Algebra T Λ] [IsScalarTower R T Λ]
    [FinitePresentation R T] {q : Ideal Λ} (hnotle : ¬ h(T⁄R, Λ) ≤ q) :
    ResolvableAtPrime.{u, max u v w, w} R T Λ q := by
  -- Proof comment: unfold the owner definition and reuse the identity factorization of `T`.
  rw [resolvableAtPrime_iff]
  refine
    ⟨T, inferInstance, inferInstance, inferInstance, AlgHom.id R T,
      IsScalarTower.toAlgHom R T Λ, ?_, ?_, hnotle⟩
  · -- Proof comment: the identity source map leaves the factorization unchanged.
    ext t
    rfl
  · -- Proof comment: with source algebra `T`, the target singular ideal is already `h(T/R, Λ)`.
    exact le_rfl

/-- Helper for Chap16 Lemma 16 9 2: an auxiliary resolvable factorization resolves the original
source once its singular ideal contains `h(A/R, Λ)`. -/
private theorem resolvableAtPrime_of_auxiliarySingularContainment
    {T : Type (max u v w)} [CommRing T]
    [Algebra R T] [Algebra A T] [Algebra T Λ]
    [IsScalarTower R A T] [IsScalarTower R T Λ] [IsScalarTower A T Λ]
    {q : Ideal Λ}
    (hSing : h(A⁄R, Λ) ≤ h(T⁄R, Λ))
    (hres : ResolvableAtPrime.{u, max u v w, w} R T Λ q) :
    ResolvableAtPrime.{u, v, w} R A Λ q := by
  -- Proof comment: precompose the resolved auxiliary factorization with `A → T`.
  rw [resolvableAtPrime_iff] at hres ⊢
  rcases hres with ⟨B, _, _, _, f, g, hcomp, hcontain, hnotle⟩
  refine ⟨B, inferInstance, inferInstance, inferInstance, ?_, g, ?_, ?_, hnotle⟩
  · -- Proof comment: the new source map is the auxiliary map composed with `A → T`.
    exact f.comp (IsScalarTower.toAlgHom R A T)
  · -- Proof comment: associativity reduces the composite to the original structure map `A → Λ`.
    calc
      g.comp (f.comp (IsScalarTower.toAlgHom R A T)) =
          (g.comp f).comp (IsScalarTower.toAlgHom R A T) := by
            rfl
      _ = (IsScalarTower.toAlgHom R T Λ).comp (IsScalarTower.toAlgHom R A T) := by
            rw [hcomp]
      _ = IsScalarTower.toAlgHom R A Λ := by
            ext a
            change algebraMap T Λ (algebraMap A T a) = algebraMap A Λ a
            rw [IsScalarTower.algebraMap_eq A T Λ]
            rfl
  · -- Proof comment: the auxiliary singular ideal already contains the original one.
    exact le_trans hSing hcontain

/-- Helper for Chap16 Lemma 16 9 2: the total eighth-power reduction splits into the prefix
reduction and the last generator. -/
private theorem piPowEightReductionIdeal_castSucc_sup_last
    {r : ℕ} (π : Fin (r + 1) → R) :
    piPowEightReductionIdeal π =
      piPowEightReductionIdeal (fun i : Fin r ↦ π (Fin.castSucc i)) ⊔
        Ideal.span ({π (Fin.last r) ^ 8} : Set R) := by
  -- Proof comment: split the range indexing `Fin (r + 1)` into the prefix indices and the last
  -- index, then rewrite the span of the union as a supremum.
  rw [piPowEightReductionIdeal_def, piPowPrefixIdeal_def, piPowEightReductionIdeal_def,
    piPowPrefixIdeal_def]
  let π0 : Fin r → R := fun i ↦ π (Fin.castSucc i)
  have hsplit :
      Set.range (fun i : Fin (r + 1) ↦ π i ^ 8) =
        Set.range (fun i : Fin r ↦ π0 i ^ 8) ∪ {π (Fin.last r) ^ 8} := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      rcases Fin.eq_castSucc_or_eq_last i with ⟨j, rfl⟩ | ⟨rfl⟩
      · exact Or.inl ⟨j, rfl⟩
      · exact Or.inr rfl
    · rintro (hx | hx)
      · rcases hx with ⟨i, rfl⟩
        exact ⟨Fin.castSucc i, rfl⟩
      · exact ⟨Fin.last r, hx.symm⟩
  have hleft :
      Set.range (fun i : Fin (r + 1) ↦ π (Fin.castLE le_rfl i) ^ 8) =
        Set.range (fun i : Fin (r + 1) ↦ π i ^ 8) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i, by simp⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, by simp⟩
  have hright :
      Set.range (fun i : Fin r ↦ π (Fin.castLE le_rfl i).castSucc ^ 8) =
        Set.range (fun i : Fin r ↦ π0 i ^ 8) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨i, by simp [π0]⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i, by simp [π0]⟩
  rw [hleft, hsplit, hright, Ideal.span_union]

/-- Helper for Chap16 Lemma 16 9 2: truncating the family along `Fin.castSucc` does not change
the prefix ideal built from the first `n` entries. -/
private theorem piPowPrefixIdeal_castSucc_eq
    {r : ℕ} (π : Fin (r + 1) → R) (e n : ℕ) (hn : n ≤ r) :
    piPowPrefixIdeal (fun i : Fin r ↦ π (Fin.castSucc i)) e n hn =
      piPowPrefixIdeal π e n (Nat.le_trans hn (Nat.le_succ r)) := by
  -- Proof comment: both sides are spans of the same first `n` generators, only indexed through
  -- two definitionally equivalent `Fin.castLE` paths.
  rw [piPowPrefixIdeal_def, piPowPrefixIdeal_def]
  congr 1
  funext i
  simp

-- Proof sketch: argue by induction on `r`. For `r = 1`, apply Lemma `16.7.3` to lift a
-- resolution modulo `π₁^8` to a resolution upstairs, using the successive quotient torsion-ideal
-- equalities and the strict standardness of `π₁`. For the induction step, first apply the
-- induction hypothesis to the quotient by `π₁^8`; Lemma `16.2.7` preserves strict standardness
-- after passing to that quotient, so the remaining family still satisfies the same hypotheses.
/-- Lemma 16.9.2: let `R → A → Λ ⊃ q` be in the situation of the local-tricks setup, so `R` is
Noetherian and `A` is finitely presented over `R`. Let `π : Fin r → R` encode the family
`π₁, …, π_r`, assume each `π i` maps into `q`, assume the successive quotient
torsion-ideal equalities from the text, expressed canonically via `Ideal.torsionOf`, hold after
modding out by the previously chosen eighth powers, and assume each `π i` maps to a strictly
standard element of `A` over `R`. If the quotient situation modulo `(π₁^8, …, π_r^8)` is
resolvable, then the original situation is resolvable. -/
@[stacks 07F8]
theorem resolvableAtPrime_of_resolvableAtPrime_mod_piPowEight_family
    [IsNoetherianRing R] [FinitePresentation R A]
    (q : Ideal Λ) [q.IsPrime] {r : ℕ} (π : Fin r → R)
    (hπq : ∀ i : Fin r, algebraMap R Λ (π i) ∈ q)
    (hAnnR : ∀ i : Fin r,
      let I := piPowPrefixIdeal π 8 i.1 (Nat.le_of_lt i.isLt)
      Ideal.torsionOf (R ⧸ I) (R ⧸ I) (Ideal.Quotient.mk I (π i)) =
        Ideal.torsionOf (R ⧸ I) (R ⧸ I) (Ideal.Quotient.mk I (π i ^ 2)))
    (hAnnΛ : ∀ i : Fin r,
      let I := piPowPrefixIdeal π 8 i.1 (Nat.le_of_lt i.isLt)
      let J := Ideal.map (algebraMap R Λ) I
      Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (algebraMap R Λ (π i))) =
        Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (algebraMap R Λ (π i ^ 2))))
    (hStrict : ∀ i : Fin r, IsStrictlyStandard R (algebraMap R A (π i)))
    (hresolve :
      let r8 := R ⧸ piPowEightReductionIdeal π
      let a8 := A ⧸ Ideal.map (algebraMap R A) (piPowEightReductionIdeal π)
      let l8 := Λ ⧸ Ideal.map (algebraMap R Λ) (piPowEightReductionIdeal π)
      let q8 : Ideal l8 := piPowEightReductionPrime π q
      ResolvableAtPrime r8 a8 l8 q8) :
    ResolvableAtPrime R A Λ q := by
  induction r with
  | zero =>
      -- Proof comment: for the empty family the eighth-power reduction ideal is `⊥`, so the
      -- quotient resolvability hypothesis becomes the original one after the canonical
      -- `⊥`-quotient identifications.
      let eR : R ≃ₐ[R] R ⧸ (⊥ : Ideal R) := (AlgEquiv.quotientBot R R).symm
      let eA : A ≃ₐ[R] A ⧸ (Ideal.map (algebraMap R A) (⊥ : Ideal R)) := by
        simpa using (AlgEquiv.quotientBot R A).symm
      let eΛ : Λ ≃ₐ[R] Λ ⧸ (Ideal.map (algebraMap R Λ) (⊥ : Ideal R)) := by
        simpa using (AlgEquiv.quotientBot R Λ).symm
      -- Proof comment: rewrite the empty-family reduction data to the zero ideal, then transport
      -- the quotient-side witness back across the canonical quotient equivalences.
      have hresolve0 :
          ResolvableAtPrime (R ⧸ (⊥ : Ideal R))
            (A ⧸ Ideal.map (algebraMap R A) (⊥ : Ideal R))
            (Λ ⧸ Ideal.map (algebraMap R Λ) (⊥ : Ideal R))
            (Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) (⊥ : Ideal R))) q) := by
        simpa [piPowEightReductionIdeal, piPowPrefixIdeal, piPowEightReductionPrime] using hresolve
      rw [resolvableAtPrime_iff] at hresolve0 ⊢
      rcases hresolve0 with ⟨B, hB, hAlgB, hfpB, f, g, hcomp, hcontain, hnotle⟩
      letI : CommRing B := hB
      letI : Algebra (R ⧸ (⊥ : Ideal R)) B := hAlgB
      letI : FinitePresentation (R ⧸ (⊥ : Ideal R)) B := hfpB
      let f' : A →ₐ[R] B := f.comp eA
      let g' : B →ₐ[R] Λ := eΛ.comp g
      refine ⟨B, inferInstance, ?_, ?_, f', g', ?_, ?_, ?_⟩
      · -- Proof comment: pull the quotient-side algebra structure back along `R ≃ R/⊥`.
        exact (hAlgB.restrictScalars (R := R)).ofAlgHom eR
      · -- Proof comment: finite presentation is preserved under the zero-quotient base change.
        letI : Algebra R B := (hAlgB.restrictScalars (R := R)).ofAlgHom eR
        exact FinitePresentation.of_restrictScalars_finitePresentation eR.toAlgHom
      · -- Proof comment: the transported factorization still composes to the original structure
        -- map after cancelling the zero-quotient equivalences.
        ext a
        change eΛ (g (f (eA a))) = algebraMap A Λ a
        have hcompa := congrArg (fun τ : A ⧸ Ideal.map (algebraMap R A) (⊥ : Ideal R) →ₐ[R ⧸ (⊥ : Ideal R)]
            Λ ⧸ Ideal.map (algebraMap R Λ) (⊥ : Ideal R) =>
            τ (eA a)) hcomp
        simpa [f', g', eA, eΛ, eR] using hcompa
      · -- Proof comment: the singular-ideal containment is exactly the quotient-side one after
        -- identifying all zero-ideal quotients with the original rings.
        simpa [g', eΛ] using hcontain
      · -- Proof comment: likewise, noncontainment of the target singular ideal is preserved under
        -- the same zero-quotient identification.
        simpa [g', eΛ] using hnotle
  | succ r ih =>
      -- Route correction: peel off the last family member so the induction hypothesis can be
      -- applied to the `Fin.castSucc` prefix without repeated transport noise.
      let π0 : Fin r → R := fun i ↦ π (Fin.castSucc i)
      have hπq0 : ∀ i : Fin r, algebraMap R Λ (π0 i) ∈ q := by
        -- Proof comment: the prefix family inherits the prime-membership hypothesis entrywise.
        intro i
        simpa [π0] using hπq (Fin.castSucc i)
      have hAnnR0 : ∀ i : Fin r,
          let I := piPowPrefixIdeal π0 8 i.1 (Nat.le_of_lt i.isLt)
          Ideal.torsionOf (R ⧸ I) (R ⧸ I) (Ideal.Quotient.mk I (π0 i)) =
            Ideal.torsionOf (R ⧸ I) (R ⧸ I) (Ideal.Quotient.mk I (π0 i ^ 2)) := by
        -- Proof comment: rewrite the prefix ideal back to the original family and reuse `hAnnR`.
        intro i
        simpa [π0, piPowPrefixIdeal_castSucc_eq (π := π) 8 i.1 (Nat.le_of_lt i.isLt)] using
          hAnnR (Fin.castSucc i)
      have hAnnΛ0 : ∀ i : Fin r,
          let I := piPowPrefixIdeal π0 8 i.1 (Nat.le_of_lt i.isLt)
          let J := Ideal.map (algebraMap R Λ) I
          Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (algebraMap R Λ (π0 i))) =
            Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (algebraMap R Λ (π0 i ^ 2))) := by
        -- Proof comment: the target-side torsion equality restricts along the same prefix-ideal
        -- identification as on the base ring.
        intro i
        simpa [π0, piPowPrefixIdeal_castSucc_eq (π := π) 8 i.1 (Nat.le_of_lt i.isLt)] using
          hAnnΛ (Fin.castSucc i)
      have hStrict0 : ∀ i : Fin r, IsStrictlyStandard R (algebraMap R A (π0 i)) := by
        -- Proof comment: strict standardness is also inherited entrywise by the prefix family.
        intro i
        simpa [π0] using hStrict (Fin.castSucc i)
      have hsplit := piPowEightReductionIdeal_castSucc_sup_last (π := π)
      -- TODO: transport `hresolve` across the split `hsplit` to the one-parameter quotient surface
      -- over the prefix quotient, then apply the single-parameter lift from Lemma `16.7.3` on that
      -- surface and close with `ih q π0 hπq0 hAnnR0 hAnnΛ0 hStrict0`.
      sorry

end

end Algebra
