import stacks_proof.stacks_project.Chap16.Definition_16_2_3
import Mathlib.Tactic.StacksAttribute

-- Declarations for this item will be appended below by the statement pipeline.

open scoped TensorProduct

universe u v w

section

variable {R : Type u} {A : Type v} {R' : Type w}
variable [CommRing R] [CommRing A] [CommRing R']
variable [Algebra R A] [Algebra R R']

/-
Domain-style sampling for `Lemma 16.2.7`:
- primary domain: base change for finite-presentation Jacobian witnesses of elementary and strict
  standardness;
- sampled owner API:
  `Algebra.Presentation.baseChange`,
  `Algebra.Presentation.IsElementaryStandardElement`,
  `Algebra.Presentation.IsStrictlyStandardElement`,
  `Algebra.IsStandardSmooth.baseChange`;
- best owner abstraction: the primitive base-change statements live at the presentation level,
  while `Algebra.IsElementaryStandard` and `Algebra.IsStrictlyStandard` are the derived
  existential owner predicates;
- primitive data: a finite presentation `P` and a presentation-level witness
  `P.IsElementaryStandardElement a` or `P.IsStrictlyStandardElement a`;
- derived API: the algebra-level base-change theorems obtained by existentially choosing `P`.

Source/core/bridge triage:
- `source-facing`: the Stacks statements that elementary or strictly standard elements remain so
  after base change;
- `core/canonical`: `Algebra.Presentation.baseChange` together with the owner predicates
  `P.IsElementaryStandardElement a` and `P.IsStrictlyStandardElement a`;
- `bridge/view`: the tensor element `1 ⊗ₜ[R] a` in the base-changed algebra `R' ⊗[R] A`.
-/

namespace Algebra.Presentation

variable {n m : ℕ}
variable {c : ℕ}

/-- Helper for Lemma 16.2.7: the kernel ideal of a finite presentation is transported by applying
the coefficient base-change map to the defining relations. -/
lemma ker_baseChange
    (P : Algebra.Presentation R A (Fin n) (Fin m)) :
    (P.baseChange R').ker = Ideal.map (MvPolynomial.map (algebraMap R R')) P.ker := by
  -- Both kernel ideals are spans of the corresponding relation families, so it suffices to rewrite
  -- the base-changed relations coefficientwise.
  rw [← (P.baseChange R').span_range_relation_eq_ker, ← P.span_range_relation_eq_ker,
    Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨P.relation i, ⟨i, rfl⟩, by simp [Algebra.Presentation.baseChange_relation]⟩
  · rintro ⟨y, ⟨i, rfl⟩, hy⟩
    exact ⟨i, by simpa [Algebra.Presentation.baseChange_relation] using hy⟩

/-- Helper for Lemma 16.2.7: the ideal generated by the first `c` relations is transported by
coefficientwise base change. -/
lemma leadingRelationIdeal_baseChange
    (P : Algebra.Presentation R A (Fin n) (Fin m))
    (hcₘ : c ≤ m) :
    (P.baseChange R').leadingRelationIdeal hcₘ =
      Ideal.map (MvPolynomial.map (algebraMap R R')) (P.leadingRelationIdeal hcₘ) := by
  -- The first `c` relations are unchanged on the index side, so mapping coefficients commutes with
  -- the finite span defining the leading relation ideal.
  rw [leadingRelationIdeal, leadingRelationIdeal, Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨P.relation (Fin.castLE hcₘ i), ⟨i, rfl⟩, by
      simp [Algebra.Presentation.baseChange_relation]⟩
  · rintro ⟨y, ⟨i, rfl⟩, hy⟩
    exact ⟨i, by simpa [Algebra.Presentation.baseChange_relation] using hy⟩

/-- Helper for Lemma 16.2.7: evaluating a coefficientwise-mapped polynomial in the base-changed
presentation gives the pure tensor of its original evaluation. -/
lemma algebraMap_baseChange_map
    (P : Algebra.Presentation R A (Fin n) (Fin m))
    (p : P.Ring) :
    algebraMap (P.baseChange R').Ring (R' ⊗[R] A) (MvPolynomial.map (algebraMap R R') p) =
      (1 : R') ⊗ₜ[R] algebraMap P.Ring A p := by
  -- The base-changed generators are exactly `x ↦ 1 ⊗ P.val x`, so `aeval_one_tmul` gives the
  -- required comparison.
  rw [Algebra.Generators.algebraMap_apply, MvPolynomial.aeval_map_algebraMap]
  simpa [Algebra.Presentation.baseChange_toGenerators, Algebra.Generators.baseChange_val,
    ← Algebra.Generators.algebraMap_apply] using
    (MvPolynomial.aeval_one_tmul R P.val p)

/-- Helper for Lemma 16.2.7: the leading Jacobian determinant is obtained by mapping coefficients
through the base-change ring homomorphism. -/
lemma leadingJacobianDet_baseChange
    (P : Algebra.Presentation R A (Fin n) (Fin m))
    (hcₙ : c ≤ n) (hcₘ : c ≤ m) :
    (P.baseChange R').leadingJacobianDet hcₙ hcₘ =
      MvPolynomial.map (algebraMap R R') (P.leadingJacobianDet hcₙ hcₘ) := by
  -- Rewrite the base-changed Jacobian matrix entrywise using `pderiv_map`, then take
  -- determinants.
  unfold leadingJacobianDet
  have hsub :
      ((P.baseChange R').jacobianMatrix hcₘ).submatrix (fun i ↦ i) (Fin.castLE hcₙ) =
        RingHom.mapMatrix (MvPolynomial.map (algebraMap R R'))
          ((P.jacobianMatrix hcₘ).submatrix (fun i ↦ i) (Fin.castLE hcₙ)) := by
    ext i j
    simp [jacobianMatrix, Algebra.Presentation.baseChange_relation, MvPolynomial.pderiv_map]
  rw [hsub, ← RingHom.map_det]

/-- Helper for Lemma 16.2.7: each Jacobian column minor is transported by coefficientwise base
change. -/
lemma jacobianColumnMinor_baseChange
    (P : Algebra.Presentation R A (Fin n) (Fin m))
    (hcₘ : c ≤ m) (I : Set.powersetCard (Fin n) c) :
    (P.baseChange R').jacobianColumnMinor hcₘ I =
      MvPolynomial.map (algebraMap R R') (P.jacobianColumnMinor hcₘ I) := by
  -- The same entrywise Jacobian rewrite as for the determinant applies to every chosen minor.
  unfold jacobianColumnMinor
  have hsub :
      ((P.baseChange R').jacobianMatrix hcₘ).submatrix (fun i ↦ i) (I.1.orderEmbOfFin I.2) =
        RingHom.mapMatrix (MvPolynomial.map (algebraMap R R'))
          ((P.jacobianMatrix hcₘ).submatrix (fun i ↦ i) (I.1.orderEmbOfFin I.2)) := by
    ext i j
    simp [jacobianMatrix, Algebra.Presentation.baseChange_relation, MvPolynomial.pderiv_map]
  rw [hsub, ← RingHom.map_det]

/-- Helper for Lemma 16.2.7: the intrinsic tail relation condition survives coefficientwise base
change. -/
lemma tailRelationCondition_baseChange
    (P : Algebra.Presentation R A (Fin n) (Fin m))
    {a : A} (hcₘ : c ≤ m)
    (h : P.tailRelationCondition a hcₘ) :
    (P.baseChange R').tailRelationCondition ((1 : R') ⊗ₜ[R] a) hcₘ := by
  rcases h with ⟨a₀, ha₀, htail⟩
  refine ⟨MvPolynomial.map (algebraMap R R') a₀, ?_, ?_⟩
  · -- Evaluate the mapped lift in the base-changed algebra.
    simpa [ha₀] using P.algebraMap_baseChange_map a₀
  · intro j
    -- Map the original tail relation congruence into the base-changed presentation ring.
    have hmap :
        MvPolynomial.map (algebraMap R R')
            (a₀ * P.relation (tailRelationIndex hcₘ j)) ∈
          Ideal.map (MvPolynomial.map (algebraMap R R'))
            (P.leadingRelationIdeal hcₘ + P.ker ^ 2) := by
      exact Ideal.mem_map_of_mem _ (htail j)
    have hideal :
        Ideal.map (MvPolynomial.map (algebraMap R R')) (P.leadingRelationIdeal hcₘ + P.ker ^ 2) =
          (P.baseChange R').leadingRelationIdeal hcₘ + (P.baseChange R').ker ^ 2 := by
      rw [Ideal.add_eq_sup, Ideal.map_sup, Ideal.map_pow, leadingRelationIdeal_baseChange,
        ker_baseChange, Ideal.add_eq_sup]
    have hleft :
        MvPolynomial.map (algebraMap R R')
            (a₀ * P.relation (tailRelationIndex hcₘ j)) =
          MvPolynomial.map (algebraMap R R') a₀ *
            (P.baseChange R').relation (tailRelationIndex hcₘ j) := by
      simp [Algebra.Presentation.baseChange_relation, map_mul]
    rw [hideal] at hmap
    rwa [hleft] at hmap

-- Proof sketch: unfold the presentation-level witness from Definition `16.2.3`, apply the
-- canonical base-changed presentation `P.baseChange R'`, and transport the same size `c`, the
-- Jacobian determinant or minor expression, and the tail ideal-membership condition along the ring
-- map `MvPolynomial.map (algebraMap R R')`.
/-- Presentation-level base change of the elementary standard condition. -/
theorem IsElementaryStandardElement.baseChange
    {P : Algebra.Presentation R A (Fin n) (Fin m)} {a : A}
    (ha : P.IsElementaryStandardElement a) :
    (P.baseChange R').IsElementaryStandardElement ((1 : R') ⊗ₜ[R] a) :=
  by
  rcases ha with ⟨c, hcₙ, hcₘ, a', haeq, htail⟩
  refine ⟨c, hcₙ, hcₘ, (1 : R') ⊗ₜ[R] a', ?_, ?_⟩
  · -- Tensor the original determinant identity and rewrite the determinant after base change.
    calc
      (1 : R') ⊗ₜ[R] a
          = (1 : R') ⊗ₜ[R]
              (a' * algebraMap P.Ring A (P.leadingJacobianDet hcₙ hcₘ)) := by
                simpa [haeq]
      _ = ((1 : R') ⊗ₜ[R] a') *
            ((1 : R') ⊗ₜ[R] algebraMap P.Ring A (P.leadingJacobianDet hcₙ hcₘ)) := by
              simp [Algebra.TensorProduct.tmul_mul_tmul]
      _ = ((1 : R') ⊗ₜ[R] a') *
            algebraMap (P.baseChange R').Ring (R' ⊗[R] A)
              ((P.baseChange R').leadingJacobianDet hcₙ hcₘ) := by
              rw [← P.algebraMap_baseChange_map (P.leadingJacobianDet hcₙ hcₘ),
                ← P.leadingJacobianDet_baseChange hcₙ hcₘ]
  · -- Reuse the same lift in the tail condition after mapping coefficients.
    exact P.tailRelationCondition_baseChange hcₘ htail

-- Proof sketch: base change the witnessing presentation `P` and transport the Jacobian-minor
-- expansion termwise through the canonical tensor-product algebra map.
/-- Presentation-level base change of the strictly standard condition. -/
theorem IsStrictlyStandardElement.baseChange
    {P : Algebra.Presentation R A (Fin n) (Fin m)} {a : A}
    (ha : P.IsStrictlyStandardElement a) :
    (P.baseChange R').IsStrictlyStandardElement ((1 : R') ⊗ₜ[R] a) := by
  rcases ha with ⟨c, hcₘ, aI, haeq, htail⟩
  refine ⟨c, hcₘ, fun I ↦ (1 : R') ⊗ₜ[R] aI I, ?_, ?_⟩
  · -- Tensor the original minor expansion and rewrite each minor under base change.
    calc
      (1 : R') ⊗ₜ[R] a
          = (1 : R') ⊗ₜ[R]
              ∑ I : Set.powersetCard (Fin n) c,
                aI I * algebraMap P.Ring A (P.jacobianColumnMinor hcₘ I) := by
                  simpa [haeq]
      _ = ∑ I : Set.powersetCard (Fin n) c,
            (1 : R') ⊗ₜ[R]
              (aI I * algebraMap P.Ring A (P.jacobianColumnMinor hcₘ I)) := by
                rw [TensorProduct.tmul_sum]
      _ = ∑ I : Set.powersetCard (Fin n) c,
            ((1 : R') ⊗ₜ[R] aI I) *
              ((1 : R') ⊗ₜ[R]
                algebraMap P.Ring A (P.jacobianColumnMinor hcₘ I)) := by
                refine Finset.sum_congr rfl ?_
                intro I hI
                simp [Algebra.TensorProduct.tmul_mul_tmul]
      _ = ∑ I : Set.powersetCard (Fin n) c,
                ((1 : R') ⊗ₜ[R] aI I) *
              algebraMap (P.baseChange R').Ring (R' ⊗[R] A)
                ((P.baseChange R').jacobianColumnMinor hcₘ I) := by
                refine Finset.sum_congr rfl ?_
                intro I hI
                rw [← P.algebraMap_baseChange_map (P.jacobianColumnMinor hcₘ I),
                  ← P.jacobianColumnMinor_baseChange hcₘ I]
  · -- The tail condition is shared with the elementary case.
    exact P.tailRelationCondition_baseChange hcₘ htail

end Algebra.Presentation

namespace Algebra

-- Proof sketch: choose a witnessing finite presentation from `IsElementaryStandard R a`, apply the
-- presentation-level base-change theorem, and package the resulting witness back into the
-- canonical existential owner predicate.
/-- Lemma 16.2.7: an elementary standard element remains elementary standard after base change. -/
@[stacks 07CC]
theorem IsElementaryStandard.baseChange
    {a : A} (ha : IsElementaryStandard R a) :
    IsElementaryStandard R' ((1 : R') ⊗ₜ[R] a) := by
  rcases ha with ⟨n, m, P, hP⟩
  exact ⟨n, m, P.baseChange R', hP.baseChange⟩

-- Proof sketch: the algebra-level strict statement is the derived existential package of the
-- presentation-level base-change theorem for strict standardness.
/-- Lemma 16.2.7: a strictly standard element remains strictly standard after base change. -/
@[stacks 07CC]
theorem IsStrictlyStandard.baseChange
    {a : A} (ha : IsStrictlyStandard R a) :
    IsStrictlyStandard R' ((1 : R') ⊗ₜ[R] a) := by
  rcases ha with ⟨n, m, P, hP⟩
  exact ⟨n, m, P.baseChange R', hP.baseChange⟩

end Algebra

end
