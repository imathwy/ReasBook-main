/- Domain-style sampling for Lemma 16.2.8:
- primary domain: commutative algebra of smooth `R`-algebras and the singular ideal criterion for
  factoring an `R`-algebra map through a smooth algebra;
- sampled owner declarations:
  `Algebra.singularIdeal`,
  `Algebra.singularIdeal_eq_radical_span_elementaryStandard`,
  `Ideal.map`,
  `Smooth`,
  `FinitePresentation`;
- best owner abstraction: this item is a source-facing existence theorem whose public surface
  should stay the direct smooth factorization of `φ : A →ₐ[R] Λ`, expressed using the chapter
  owner `H[A⁄R]` and the canonical smoothness owner `Smooth R B`;
- primitive data: the finitely presented `R`-algebra `A`, the target `R`-algebra `Λ`, the map
  `φ`, and the unit-ideal hypothesis on the image of `H[A⁄R]`;
- derived API: the smooth intermediate algebra `B` and factorization maps `A →ₐ[R] B →ₐ[R] Λ`.

Source/core/bridge triage:
- source-facing: the existence of a smooth factorization under the singular-ideal hypothesis;
- core/canonical: `H[A⁄R]`, `Ideal.map`, `Smooth`, and `FinitePresentation`;
- bridge/view: the explicit factorization maps `f` and `g`.

There is no upstream exact-interface owner theorem to recall here, so the refinement keeps the
source-facing theorem itself while reusing the chapter owner theorem
`singularIdeal_eq_radical_span_elementaryStandard` for the singular-ideal description in the proof
route.
-/

-- Proof sketch: apply `singularIdeal_eq_radical_span_elementaryStandard` to rewrite `H[A⁄R]` as
-- the radical of the ideal generated by elementary standard elements. The unit-ideal hypothesis on
-- `Ideal.map φ (H[A⁄R])` then yields finitely many elementary standard elements of `A` whose
-- images under `φ` generate `⊤` in `Λ`. Each such element gives a standard smooth localization of
-- `A`, and the corresponding localized maps to `Λ` glue through a finite product of smooth
-- `R`-algebras, yielding the required smooth factorization of `φ`.
/-- Helper for Lemma 16.2.8: the hypothesis `Ideal.map φ (H[A⁄R]) = ⊤` yields a finite linear
relation in `Λ` supported on images of elementary standard elements of `A`. -/
lemma exists_finite_elementaryStandard_image_relation
    (φ : A →ₐ[R] Λ) (hHtop : Ideal.map φ (H[A⁄R]) = ⊤) :
    ∃ t : Finset Λ, (↑t : Set Λ) ⊆ φ '' { a | IsElementaryStandard R a } ∧
      ∃ μ : Λ → Λ, μ.support ⊆ (↑t : Set Λ) ∧ Finset.sum t (fun a ↦ μ a * a) = 1 := by
  classical
  let S : Set A := { a | IsElementaryStandard R a }
  have hmap_top : Ideal.map φ (Ideal.span S) = ⊤ := by
    -- Rewrite the singular ideal through Elkik's elementary-standard description.
    have hradical_top :
        Ideal.map φ ((Ideal.span S).radical) = ⊤ := by
      simpa [S, singularIdeal_eq_radical_span_elementaryStandard] using hHtop
    -- Mapping radicals only enlarges the ideal by a radical, so the mapped span already has
    -- radical `⊤`.
    have hle :
        Ideal.map φ ((Ideal.span S).radical) ≤ (Ideal.map φ (Ideal.span S)).radical :=
      Ideal.map_radical_le (f := φ) (I := Ideal.span S)
    have hradical_eq_top : (Ideal.map φ (Ideal.span S)).radical = ⊤ := by
      apply top_unique
      calc
        ⊤ = Ideal.map φ ((Ideal.span S).radical) := hradical_top.symm
        _ ≤ (Ideal.map φ (Ideal.span S)).radical := hle
    exact Ideal.radical_eq_top.mp hradical_eq_top
  rw [Ideal.map_span] at hmap_top
  -- Extract a finite subset of the image whose span already equals the unit ideal.
  obtain ⟨t, htt, htspan⟩ := (Ideal.span_eq_top_iff_finite (φ '' S)).mp hmap_top
  have hone : (1 : Λ) ∈ Ideal.span (↑t : Set Λ) := by
    rw [htspan]
    exact Submodule.mem_top
  -- Convert `1 ∈ span(t)` into an explicit finite linear combination.
  obtain ⟨μ, hμsupport, hμsum⟩ :=
    (Submodule.mem_span_finset (R := Λ) (s := t) (x := (1 : Λ))).mp hone
  exact ⟨t, htt, μ, hμsupport, by simpa [smul_eq_mul] using hμsum⟩

/-- Helper for Lemma 16.2.8: the finite image relation can be pulled back to finitely many
elementary standard elements of `A` with coefficients in `Λ`. -/
lemma exists_finite_elementaryStandard_unit_relation
    (φ : A →ₐ[R] Λ) (hHtop : Ideal.map φ (H[A⁄R]) = ⊤) :
    ∃ n : ℕ, ∃ f : Fin n → A, ∃ coeffs : Fin n → Λ,
      (∀ i, IsElementaryStandard R (f i)) ∧
      Finset.univ.sum (fun i ↦ coeffs i * φ (f i)) = 1 := by
  classical
  obtain ⟨t, htt, μ, hμsupport, hμsum⟩ :=
    exists_finite_elementaryStandard_image_relation (R := R) (A := A) (Λ := Λ) φ hHtop
  have hpreimage : ∀ b : t, ∃ a : A, IsElementaryStandard R a ∧ φ a = b := by
    intro b
    rcases htt b.property with ⟨a, ha, hφa⟩
    exact ⟨a, ha, hφa⟩
  choose pre hpre_std hpre_eq using hpreimage
  let e : t ≃ Fin t.card := Finset.equivFin t
  refine ⟨t.card, fun i ↦ pre (e.symm i), fun i ↦ μ (e.symm i), ?_, ?_⟩
  · -- The chosen lifts remain elementary standard by construction.
    intro i
    exact hpre_std (e.symm i)
  · -- Reindex the finite relation along the equivalence `t ≃ Fin t.card`.
    calc
      Finset.univ.sum (fun i ↦ μ (e.symm i) * φ (pre (e.symm i))) =
          ∑ a : t, μ a * (a : Λ) := by
            simpa [hpre_eq] using (e.symm.sum_comp fun a : t ↦ μ a * (a : Λ))
      _ = Finset.sum t (fun a ↦ μ a * a) := by
            simpa using (t.sum_attach fun a : Λ ↦ μ a * a)
      _ = 1 := hμsum

/-- Helper for Lemma 16.2.8: evaluating the defining linear relation of the one-relation quotient
at the chosen coefficients sends that relation to `0` in `Λ`. -/
lemma linear_relation_eval_zero
    (φ : A →ₐ[R] Λ) {n : ℕ} (f : Fin n → A) (coeffs : Fin n → Λ)
    (hcoeffs : Finset.univ.sum (fun i ↦ coeffs i * φ (f i)) = 1) :
    let _ : Algebra A Λ := φ.toAlgebra
    MvPolynomial.aeval coeffs
        ((Finset.univ.sum fun i : Fin n ↦ MvPolynomial.C (f i) * MvPolynomial.X i) - 1 :
          MvPolynomial (Fin n) A) = 0 := by
  let _ : Algebra A Λ := φ.toAlgebra
  -- Evaluation turns the displayed polynomial into the chosen linear combination minus `1`.
  calc
    MvPolynomial.aeval coeffs
        ((Finset.univ.sum fun i : Fin n ↦ MvPolynomial.C (f i) * MvPolynomial.X i) - 1 :
          MvPolynomial (Fin n) A) =
        Finset.univ.sum (fun i ↦ coeffs i * (algebraMap A Λ) (f i)) - 1 := by
          simp [mul_comm]
    _ = Finset.univ.sum (fun i ↦ coeffs i * φ (f i)) - 1 := by rfl
    _ = 0 := by rw [hcoeffs, sub_self]

/-- Helper for Lemma 16.2.8: the one-relation polynomial used in the explicit quotient
construction. -/
noncomputable abbrev linear_relation_polynomial {n : ℕ} (f : Fin n → A) :
    MvPolynomial (Fin n) A :=
  (Finset.univ.sum fun i : Fin n ↦ MvPolynomial.C (f i) * MvPolynomial.X i) - 1

/-- Helper for Lemma 16.2.8: the single defining relation, packaged as a `Fin 1`-indexed family
so the quotient carries the naive one-relation presentation from the source proof. -/
noncomputable abbrev linear_relation_family {n : ℕ} (f : Fin n → A) :
    Fin 1 → MvPolynomial (Fin n) A :=
  fun _ ↦ linear_relation_polynomial (A := A) f

/-- Helper for Lemma 16.2.8: the explicit quotient
`A[x_1, \ldots, x_n] / (\sum_i f_i x_i - 1)`. -/
noncomputable abbrev linear_relation_quotient {n : ℕ} (f : Fin n → A) : Type v :=
  MvPolynomial (Fin n) A ⧸
    Ideal.span (Set.range (linear_relation_family (A := A) f))

/-- Helper for Lemma 16.2.8: the class of the variable `X i` in the one-relation quotient. -/
noncomputable abbrev linear_relation_variable {n : ℕ} (f : Fin n → A) (i : Fin n) :
    linear_relation_quotient (A := A) f :=
  Ideal.Quotient.mk
    (Ideal.span (Set.range (linear_relation_family (A := A) f)))
    (MvPolynomial.X i)

/-- Helper for Lemma 16.2.8: the naive one-relation presentation of the explicit quotient. -/
noncomputable abbrev linear_relation_presentation {n : ℕ} (f : Fin n → A) :
    Algebra.Presentation A (linear_relation_quotient (A := A) f) (Fin n) (Fin 1) :=
  Algebra.Presentation.naive (v := linear_relation_family (A := A) f)

/-- Helper for Lemma 16.2.8: the singleton variable set selecting the pivot coordinate `i`. -/
noncomputable abbrev linear_relation_singleton_index {n : ℕ} (i : Fin n) :
    Set.powersetCard (Fin n) 1 :=
  ⟨({i} : Finset (Fin n)), by simp⟩

/-- Helper for Lemma 16.2.8: in the one-relation quotient, the defining linear combination of the
images of the `f i` and the coordinate classes equals `1`. -/
lemma linear_relation_sum_eq_one_in_quotient {n : ℕ} (f : Fin n → A) :
    Finset.univ.sum
        (fun i ↦ algebraMap A (linear_relation_quotient (A := A) f) (f i) *
          linear_relation_variable (A := A) f i) = 1 := by
  let u : MvPolynomial (Fin n) A := linear_relation_polynomial (A := A) f
  let B : Type v := linear_relation_quotient (A := A) f
  -- The quotient kills the displayed relation, so its image rewrites to the desired equality.
  have hu_image_zero :
      (Ideal.Quotient.mk (Ideal.span (Set.range (linear_relation_family (A := A) f))) u : B) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr <|
      Ideal.subset_span <| by
        refine ⟨0, ?_⟩
        simp [u, linear_relation_family, linear_relation_polynomial]
  have hsub :
      Finset.univ.sum (fun i ↦ algebraMap A B (f i) * linear_relation_variable (A := A) f i) -
        1 = (0 : B) := by
    have hu_zero :
        (Ideal.Quotient.mk (Ideal.span (Set.range (linear_relation_family (A := A) f)))
            ((Finset.univ.sum fun i : Fin n ↦ MvPolynomial.C (f i) * MvPolynomial.X i) - 1) : B) =
          0 := by
      simpa [u, linear_relation_polynomial] using hu_image_zero
    simpa [B, linear_relation_variable] using hu_zero
  exact sub_eq_zero.mp hsub

/-- Helper for Lemma 16.2.8: every prime of the one-relation quotient lies in some basic open
`D(f_i)`. Equivalently, the images of the `f i` generate the unit ideal in the quotient. -/
lemma linear_relation_basicOpen_cover {n : ℕ} (f : Fin n → A)
    (q : PrimeSpectrum (linear_relation_quotient (A := A) f)) :
    ∃ i : Fin n, algebraMap A (linear_relation_quotient (A := A) f) (f i) ∉ q.asIdeal := by
  by_contra hcover
  push Not at hcover
  -- The quotient relation expresses `1` as a sum whose coefficients all lie in `q.asIdeal`.
  have hsum_mem :
      Finset.univ.sum
          (fun i ↦ algebraMap A (linear_relation_quotient (A := A) f) (f i) *
            linear_relation_variable (A := A) f i) ∈ q.asIdeal := by
    refine Ideal.sum_mem q.asIdeal ?_
    intro i hi
    exact Ideal.mul_mem_right _ _ (hcover i)
  have hone_mem : (1 : linear_relation_quotient (A := A) f) ∈ q.asIdeal := by
    simpa [linear_relation_sum_eq_one_in_quotient (A := A) f] using hsum_mem
  have htop : q.asIdeal = ⊤ := q.asIdeal.eq_top_of_isUnit_mem hone_mem isUnit_one
  exact (Ideal.IsPrime.ne_top (inferInstance : q.asIdeal.IsPrime)) htop

/-- Helper for Lemma 16.2.8: the unique `1 × 1` Jacobian minor for the singleton column `{i}` is
the coefficient `f i` viewed in the one-relation quotient. -/
lemma linear_relation_singleton_minor_eq_coeff {n : ℕ} (f : Fin n → A) (i : Fin n) :
    algebraMap (linear_relation_presentation (A := A) f).Ring
      (linear_relation_quotient (A := A) f)
      ((linear_relation_presentation (A := A) f).jacobianColumnMinor
        (c := 1) le_rfl (linear_relation_singleton_index i)) =
        algebraMap A (linear_relation_quotient (A := A) f) (f i) := by
  let B := linear_relation_quotient (A := A) f
  -- The singleton column minor is the derivative of the single relation with respect to `X_i`.
  unfold linear_relation_presentation
  unfold Algebra.Presentation.jacobianColumnMinor Algebra.Presentation.jacobianMatrix
  rw [Matrix.det_fin_one]
  simp [Algebra.Presentation.naive_relation_apply, linear_relation_family, linear_relation_polynomial]
  have hzero :
      ({i} : Finset (Fin n)).orderEmbOfFin
          (by simp : ({i} : Finset (Fin n)).card = 1) 0 = i := by
    simp
  rw [hzero]
  -- Rewrite the derivative as a Kronecker delta, so the sum collapses to the `i`th coefficient.
  have hsum :
      ∑ x, algebraMap A B (f x) * (if i = x then 1 else 0) =
        algebraMap A B (f i) := by
    calc
      ∑ x, algebraMap A B (f x) * (if i = x then 1 else 0)
          = ∑ x ∈ Finset.univ, if i = x then algebraMap A B (f x) else 0 := by
              simp [eq_comm]
      _ = algebraMap A B (f i) := by
            simpa using
              (Finset.sum_ite_eq (Finset.univ : Finset (Fin n)) i
                (fun x ↦ algebraMap A B (f x)))
  simpa [B] using hsum

/-- Helper for Lemma 16.2.8: in the literal one-relation presentation, the image of `f i` is a
strictly standard element over the base ring `A`. -/
lemma linear_relation_image_isStrictlyStandard {n : ℕ} (f : Fin n → A) (i : Fin n) :
    IsStrictlyStandard A (algebraMap A (linear_relation_quotient (A := A) f) (f i)) := by
  let P : Algebra.Presentation A (linear_relation_quotient (A := A) f) (Fin n) (Fin 1) :=
    linear_relation_presentation (A := A) f
  let Ii : Set.powersetCard (Fin n) 1 := linear_relation_singleton_index i
  refine ⟨n, 1, P, 1, le_rfl, fun I ↦ if Ii = I then 1 else 0, ?_, ?_⟩
  · -- The strict-standard sum keeps only the singleton pivot minor.
    symm
    calc
      ∑ I, (if Ii = I then 1 else 0) *
          algebraMap P.Ring (linear_relation_quotient (A := A) f)
            (P.jacobianColumnMinor (c := 1) le_rfl I)
          = ∑ I ∈ Finset.univ,
              if Ii = I then
                algebraMap P.Ring (linear_relation_quotient (A := A) f)
                  (P.jacobianColumnMinor (c := 1) le_rfl I)
              else 0 := by
                simp
      _ = algebraMap P.Ring (linear_relation_quotient (A := A) f)
            (P.jacobianColumnMinor (c := 1) le_rfl Ii) := by
              simpa using
                (Finset.sum_ite_eq (Finset.univ : Finset (Set.powersetCard (Fin n) 1)) Ii
                  (fun I ↦
                    algebraMap P.Ring (linear_relation_quotient (A := A) f)
                      (P.jacobianColumnMinor (c := 1) le_rfl I)))
      _ = algebraMap A (linear_relation_quotient (A := A) f) (f i) := by
            simpa [P, Ii] using linear_relation_singleton_minor_eq_coeff (A := A) f i
  · -- The tail condition is vacuous because there is only one relation.
    rw [P.tailRelationCondition_iff_sigma
      (algebraMap A (linear_relation_quotient (A := A) f) (f i)) le_rfl]
    intro j
    exact Fin.elim0 j

/-- Helper for Lemma 16.2.8: on the basic open where one coefficient `f i` is inverted, the
localized one-relation quotient is smooth over `R`. -/
lemma localized_linear_relation_chart_smooth {n : ℕ} (f : Fin n → A) (i : Fin n)
    (hf_i : IsElementaryStandard R (f i)) :
    Smooth R (Localization.Away (algebraMap A (linear_relation_quotient (A := A) f) (f i))) := by
  let B₀ := linear_relation_quotient (A := A) f
  let Afi := Localization.Away (f i)
  let Bi := Localization.Away (algebraMap A B₀ (f i))
  -- Route correction: instead of a transport-heavy localized chart equivalence, use the literal
  -- one-relation presentation to make `f i` strictly standard in `B₀`, then localize and compose.
  have hstrict : IsStrictlyStandard A (algebraMap A B₀ (f i)) := by
    simpa [B₀] using linear_relation_image_isStrictlyStandard (A := A) f i
  -- The strict-standard criterion gives smoothness of the target localization over `A`.
  have hBiA : Smooth A Bi := by
    simpa [Bi, B₀] using
      (isStrictlyStandard_implies_stablyFreeKaehlerAway
        (R := A) (A := B₀) (algebraMap A B₀ (f i)) hstrict).1
  -- The same localization also inverts `f i` from the base ring `A`.
  let x : B₀ := algebraMap A B₀ (f i)
  have hunit_B₀ : IsUnit (algebraMap B₀ Bi x) := by
    simpa [Bi, x] using (IsLocalization.Away.algebraMap_isUnit x)
  have hunit : IsUnit (algebraMap A Bi (f i)) := by
    change IsUnit (algebraMap B₀ Bi (algebraMap A B₀ (f i)))
    simpa [x] using hunit_B₀
  letI : Algebra Afi Bi :=
    (Localization.awayLift (algebraMap A Bi) (f i) hunit).toAlgebra
  have hcomp_A :
      (Localization.awayLift (algebraMap A Bi) (f i) hunit).comp (algebraMap A Afi) =
        algebraMap A Bi := by
    ext a
    change
      (IsLocalization.Away.lift (x := f i) (S := Afi) (g := algebraMap A Bi) hunit)
        ((algebraMap A Afi) a) = (algebraMap A Bi) a
    exact IsLocalization.Away.lift_eq (x := f i) (S := Afi) (g := algebraMap A Bi) hunit a
  letI : IsScalarTower A Afi Bi := IsScalarTower.of_algebraMap_eq' hcomp_A.symm
  have hcomp_R :
      (Localization.awayLift (algebraMap A Bi) (f i) hunit).comp (algebraMap R Afi) =
        algebraMap R Bi := by
    ext r
    change
      (IsLocalization.Away.lift (x := f i) (S := Afi) (g := algebraMap A Bi) hunit)
        ((algebraMap A Afi) ((algebraMap R A) r)) =
          (algebraMap A Bi) ((algebraMap R A) r)
    exact IsLocalization.Away.lift_eq
      (x := f i) (S := Afi) (g := algebraMap A Bi) hunit ((algebraMap R A) r)
  letI : IsScalarTower R Afi Bi := IsScalarTower.of_algebraMap_eq' hcomp_R.symm
  have hBiAfi_hom :
      RingHom.Smooth (Localization.awayLift (algebraMap A Bi) (f i) hunit) :=
    smooth_away_lift_of_isUnit (R := A) (S := Bi) (f := f i) hunit
  letI : IsStandardSmooth R Afi :=
    isElementaryStandard_implies_standardSmoothAway (R := R) (A := A) (f i) hf_i
  have hAfi_hom : RingHom.Smooth (algebraMap R Afi) :=
    (RingHom.smooth_algebraMap).2 inferInstance
  -- Compose the smooth localization of `A[(f i)⁻¹]` over `R` with the smooth lift to `Bi`.
  exact
    (RingHom.smooth_algebraMap).1 <| by
      simpa [hcomp_R] using RingHom.Smooth.comp hAfi_hom hBiAfi_hom

/-- Helper for Lemma 16.2.8: if every coefficient `f i` is elementary standard over `R`, then the
explicit one-relation quotient is smooth over `R`. -/
lemma smooth_of_constructed_linear_cover {n : ℕ} (f : Fin n → A)
    (hf : ∀ i, IsElementaryStandard R (f i)) :
    Smooth R (linear_relation_quotient (A := A) f) := by
  -- Smoothness is local on principal opens, and `linear_relation_basicOpen_cover` gives the
  -- source-facing basic-open cover coming from the defining unit relation in the quotient.
  rw [smooth_iff_forall_smoothAtPrime (R := R) (S := linear_relation_quotient (A := A) f)]
  intro q
  rcases linear_relation_basicOpen_cover (A := A) f q with ⟨i, hiq⟩
  exact ⟨_, hiq, localized_linear_relation_chart_smooth (R := R) (A := A) f i (hf i)⟩

/-- Lemma 16.2.8: if `A` is finitely presented over `R` and the image of the singular ideal
`H_{A/R}` under an `R`-algebra map `φ : A → Λ` is the unit ideal, then `φ` factors through a
smooth `R`-algebra. -/
@[stacks 07EU]
theorem exists_smooth_factorization_of_singularIdeal_map_eq_top
    (φ : A →ₐ[R] Λ) (hHtop : Ideal.map φ (H[A⁄R]) = ⊤) :
    ∃ (B : Type (max u v)) (_ : CommRing B) (_ : Algebra R B) (_ : Smooth R B)
      (f : A →ₐ[R] B) (g : B →ₐ[R] Λ), g.comp f = φ := by
  -- The algebraic part of the source proof is now in place: we can choose finitely many
  -- elementary standard elements whose images satisfy a unit relation in `Λ`.
  obtain ⟨n, f, coeffs, hf, hcoeffs⟩ :=
    exists_finite_elementaryStandard_unit_relation (R := R) (A := A) (Λ := Λ) φ hHtop
  let _ : Algebra A Λ := φ.toAlgebra
  let u : MvPolynomial (Fin n) A := linear_relation_polynomial (A := A) f
  let B₀ := linear_relation_quotient (A := A) f
  let g₀ : MvPolynomial (Fin n) A →ₐ[R] Λ := (MvPolynomial.aeval coeffs).restrictScalars R
  -- The evaluation map descends because it annihilates the defining relation.
  have hu_zero : g₀ u = 0 := by
    simpa [g₀, u, linear_relation_polynomial] using
      linear_relation_eval_zero (R := R) (A := A) (Λ := Λ) φ f coeffs hcoeffs
  let g₀quot : B₀ →ₐ[R] Λ :=
    Ideal.Quotient.liftₐ (Ideal.span (Set.range (linear_relation_family (A := A) f)))
      g₀ <| by
        intro p hp
        have hIker :
            Ideal.span (Set.range (linear_relation_family (A := A) f)) ≤ RingHom.ker g₀.toRingHom := by
          refine Ideal.span_le.2 ?_
          rintro _ ⟨j, rfl⟩
          show g₀ (linear_relation_family (A := A) f j) = 0
          simpa [linear_relation_family, u, linear_relation_polynomial] using hu_zero
        simpa [RingHom.mem_ker] using hIker hp
  have hcover :
      ∀ q : PrimeSpectrum B₀, ∃ i : Fin n, algebraMap A B₀ (f i) ∉ q.asIdeal := by
    intro q
    simpa [B₀] using linear_relation_basicOpen_cover (A := A) f q
  -- Route correction: the global closure is now reduced to the chart-level local smoothness from
  -- `localized_linear_relation_chart_smooth`; `smooth_of_constructed_linear_cover` packages the
  -- primewise cover argument from the source proof.
  have hB₀Smooth : Smooth R B₀ := by
    simpa [B₀] using smooth_of_constructed_linear_cover (R := R) (A := A) f hf
  let B := ULift.{u} B₀
  let f₀ : A →ₐ[R] B₀ :=
    { toRingHom := algebraMap A B₀
      commutes' := by
        intro r
        rfl }
  let fAB : A →ₐ[R] B :=
    ((ULift.algEquiv : B ≃ₐ[R] B₀).symm.toAlgHom).comp f₀
  let g : B →ₐ[R] Λ :=
    g₀quot.comp (ULift.algEquiv : B ≃ₐ[R] B₀).toAlgHom
  have hBSmooth : Smooth R B := by
    letI : Smooth R B₀ := hB₀Smooth
    exact Smooth.of_equiv ((ULift.algEquiv : B ≃ₐ[R] B₀).symm)
  refine ⟨B, inferInstance, inferInstance, hBSmooth, fAB, g, ?_⟩
  -- Constants evaluate exactly as the original map `φ`.
  ext a
  change g₀quot (f₀ a) = φ a
  change
    (Ideal.Quotient.liftₐ (Ideal.span (Set.range (linear_relation_family (A := A) f))) g₀
      (by
        intro p hp
        have hIker :
            Ideal.span (Set.range (linear_relation_family (A := A) f)) ≤ RingHom.ker g₀.toRingHom := by
          refine Ideal.span_le.2 ?_
          rintro _ ⟨j, rfl⟩
          show g₀ (linear_relation_family (A := A) f j) = 0
          simpa [linear_relation_family, u, linear_relation_polynomial] using hu_zero
        simpa [RingHom.mem_ker] using hIker hp))
      (Ideal.Quotient.mk (Ideal.span (Set.range (linear_relation_family (A := A) f))) (MvPolynomial.C a)) =
      φ a
  simp [g₀]
  rfl

end

end Algebra
