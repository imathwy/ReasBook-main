/-- Helper for Lemma 16.11.4: a geometrically regular `k`-algebra has regular prime
localizations. -/
private theorem algebraMap_isRegularRingMap_of_geometricallyRegular
    [IsGeometricallyRegular k Λ] :
    (algebraMap k Λ).IsRegularRingMap :=
  inferInstance

/-- Helper for Lemma 16.11.4: a regular ring map from a field has regular target ring. -/
private theorem isRegularRing_of_regularRingMap_from_field
    {F : Type*} [Field F] {S : Type*} [CommRing S] [Algebra F S]
    (h : (algebraMap F S).IsRegularRingMap) :
    IsRegularRing S := by
  let p0 : PrimeSpectrum F := ⟨⊥, Ideal.isPrime_bot⟩
  let eκ := Algebra.residueField_algEquiv_self_of_field_prime (k := F) p0
  let _ : Algebra p0.asIdeal.ResidueField F := eκ.toRingHom.toAlgebra
  let _ : Algebra p0.asIdeal.ResidueField S :=
    ((algebraMap F S).comp (algebraMap p0.asIdeal.ResidueField F)).toAlgebra
  let _ : IsScalarTower p0.asIdeal.ResidueField F S := IsScalarTower.of_algebraMap_eq' rfl
  let e : p0.asIdeal.Fiber S ≃ₐ[p0.asIdeal.ResidueField] S :=
    Algebra.field_fiber_algEquiv (k := F) (A := S) p0
  have hfiber : IsRegularRing (p0.asIdeal.Fiber S) := by
    -- Evaluate the regular-map hypothesis at the unique prime of the field.
    simpa using h.isRegularRing_fiber p0
  let _ : IsRegularRing (p0.asIdeal.Fiber S) := hfiber
  -- Transport regularity back along the faithful flat equivalence of the field fiber with `S`.
  exact isRegularRing_of_faithfullyFlat e.symm.toRingHom
    (RingHom.FaithfullyFlat.of_bijective e.symm.bijective)

/-- Helper for Lemma 16.11.4: a geometrically regular `k`-algebra has regular prime
localizations. -/
private theorem localizationAtPrime_isRegularLocalRing_of_geometricallyRegular
    (q : PrimeSpectrum Λ) [IsGeometricallyRegular k Λ] :
    IsRegularLocalRing (Localization.AtPrime q.asIdeal) := by
  -- The ambient `k`-algebra is a regular ring map out of a field, so the target ring is regular.
  let hregMap : (algebraMap k Λ).IsRegularRingMap :=
    algebraMap_isRegularRingMap_of_geometricallyRegular (k := k) (Λ := Λ)
  let _ : IsRegularRing Λ :=
    isRegularRing_of_regularRingMap_from_field hregMap
  -- Localizing a regular ring at a prime produces a regular local ring.
  simpa using (IsRegularRing.isRegularLocalRing_atPrime q)

/-- Helper for Lemma 16.11.4: after localizing at a minimal prime of `𝔥_A`, some power of the
maximal ideal lands in the localized singular ideal. -/
private theorem localizedPrimePowerLeSingularIdeal
    [IsNoetherianRing Λ] (q : PrimeSpectrum Λ)
    (hq : q.asIdeal ∈ (h(A⁄k, Λ)).minimalPrimes) :
    ∃ N : ℕ, 0 < N ∧
      (maximalIdeal (Localization.AtPrime q.asIdeal)) ^ N ≤
        Ideal.map (algebraMap Λ (Localization.AtPrime q.asIdeal)) (h(A⁄k, Λ)) := by
  let L := Localization.AtPrime q.asIdeal
  have hrad :
      (Ideal.map (algebraMap Λ L) (h(A⁄k, Λ))).radical = maximalIdeal L := by
    -- Localizing at a minimal prime identifies the radical of the localized ideal with the
    -- maximal ideal of the local ring.
    simpa [L] using
      (IsLocalization.AtPrime.radical_map_of_mem_minimalPrimes L q.asIdeal (h(A⁄k, Λ)) hq)
  have hle :
      maximalIdeal L ≤ (Ideal.map (algebraMap Λ L) (h(A⁄k, Λ))).radical := by
    simpa [hrad] using (show maximalIdeal L ≤ maximalIdeal L from le_rfl)
  obtain ⟨n, hn⟩ :=
    Ideal.exists_pow_le_of_le_radical_of_fg hle
      (Ideal.fg_of_isNoetherianRing (maximalIdeal L))
  refine ⟨n + 1, Nat.succ_pos _, ?_⟩
  -- Replace the possibly zero exponent returned by the Noetherian argument with `n + 1`.
  exact
    le_trans
      (Ideal.pow_le_pow_right (I := maximalIdeal L) (show n ≤ n + 1 by omega))
      hn

/-- Helper for Lemma 16.11.4: a source-style annihilator equality for an element of a quotient
ring can be rewritten as the canonical `Ideal.torsionOf` equality used by Lemma `16.9.2`. -/
private theorem torsionOf_eq_of_annihilator_eq
    {S : Type*} [CommRing S] (x : S)
    (hAnn :
      (Submodule.span S ({x} : Set S)).annihilator =
        (Submodule.span S ({x ^ 2} : Set S)).annihilator) :
    Ideal.torsionOf S S x = Ideal.torsionOf S S (x ^ 2) := by
  -- Both sides are exactly the annihilators of the singleton spans generated by `x` and `x^2`.
  simpa [Ideal.torsionOf] using hAnn

/-- Helper for Lemma 16.11.4: if an auxiliary factorization `A → T → Λ` has already been
resolved over `k`, then the original map `A → Λ` is resolved as soon as `h(A⁄k, Λ)` is contained
in the auxiliary singular ideal `h(T⁄k, Λ)`. -/
private theorem resolvableAtPrime_of_auxiliarySingularContainment
    {T : Type*} [CommRing T]
    [Algebra k T] [Algebra A T] [Algebra T Λ]
    [IsScalarTower k A T] [IsScalarTower k T Λ] [IsScalarTower A T Λ]
    (q : Ideal Λ)
    (hSing : h(A⁄k, Λ) ≤ h(T⁄k, Λ))
    (hres : ResolvableAtPrime k T Λ q) :
    ResolvableAtPrime k A Λ q := by
  rw [resolvableAtPrime_iff] at hres ⊢
  rcases hres with ⟨B, _, _, _, f, g, hcomp, hcontain, hnotle⟩
  refine ⟨B, inferInstance, inferInstance, inferInstance, ?_, g, ?_, ?_, hnotle⟩
  · -- Precompose the resolved auxiliary factorization with the fixed map `A → T`.
    exact f.comp (IsScalarTower.toAlgHom k A T)
  · -- The new composition is the original structure map `A → Λ`.
    calc
      g.comp (f.comp (IsScalarTower.toAlgHom k A T)) =
          (g.comp f).comp (IsScalarTower.toAlgHom k A T) := by
            rfl
      _ = (IsScalarTower.toAlgHom k T Λ).comp (IsScalarTower.toAlgHom k A T) := by
            rw [hcomp]
      _ = IsScalarTower.toAlgHom k A Λ := by
            ext x
            rfl
  · -- Singular-ideal containment propagates the auxiliary resolution back to the original map.
    exact le_trans hSing hcontain

