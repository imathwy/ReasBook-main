-- Proof sketch: the proof constructs a local resolution at `𝔮` by the Artinian approximation and
-- power-adjoining arguments of Lemmas `16.11.2` and `16.11.3`, then applies Lemma `16.9.4`. The
-- geometric regularity of `Λ` over the field `k` provides the approximation step, and minimality
-- of `𝔮` over `𝔥_A` supplies the singular-ideal control needed to conclude.
/-- Lemma 16.11.4: let `k → A → Λ ⊃ 𝔮` be as in Situation `16.9.1`, with `k` a field of
characteristic `p > 0`, `A` finitely presented over `k`, `Λ` a Noetherian geometrically regular
`k`-algebra, and `𝔮` minimal over `𝔥_A`. Then `k → A → Λ ⊃ 𝔮` can be resolved. -/
@[stacks 07FJ]
theorem resolvableAtPrime_at_minimalPrime_of_geometricallyRegular
    {p : ℕ} [Fact p.Prime] [CharP k p] [FinitePresentation k A]
    [IsGeometricallyRegular k Λ] [IsNoetherianRing Λ] (q : PrimeSpectrum Λ)
    (hq : q.asIdeal ∈ (h(A⁄k, Λ)).minimalPrimes) :
    ResolvableAtPrime k A Λ q.asIdeal := by
  -- Route correction: the tempting shortcut through Lemma `16.10.3` does not apply directly,
  -- because this theorem has no `[Algebra.FiniteType k Λ]` hypothesis and the needed residue-field
  -- separability bridge is not available in the current dependency closure.
  have hregLocal : IsRegularLocalRing (Localization.AtPrime q.asIdeal) :=
    localizationAtPrime_isRegularLocalRing_of_geometricallyRegular (k := k) (Λ := Λ) q
  let _ : IsRegularLocalRing (Localization.AtPrime q.asIdeal) := hregLocal
  obtain ⟨N, hNpos, hN⟩ :=
    localizedPrimePowerLeSingularIdeal (k := k) (A := A) (Λ := Λ) q hq
  let L := Localization.AtPrime q.asIdeal
  let d : ℕ := ringKrullDim L
  have hqSing : h(A⁄k, Λ) ≤ q.asIdeal := hq.1.2
  have hqpow :
      Ideal.map (algebraMap Λ L) (q.asIdeal ^ N) ≤
        Ideal.map (algebraMap Λ L) (h(A⁄k, Λ)) := by
    calc
      Ideal.map (algebraMap Λ L) (q.asIdeal ^ N) =
          Ideal.map (algebraMap Λ L) q.asIdeal ^ N := by
            rw [Ideal.map_pow]
      _ = (maximalIdeal L) ^ N := by
            rw [IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal L]
      _ ≤ Ideal.map (algebraMap Λ L) (h(A⁄k, Λ)) := hN
  obtain ⟨π, hπ, hparams, hpowSing, hAnnΛ⟩ :=
    exists_parameters_generating_localized_prime_pow_mem_ideal_and_annihilator_stable
      (q := q) (I := h(A⁄k, Λ)) (n := N) (e := 8) (d := d)
      hqSing hqpow rfl
  -- TODO: the proved frontier is now the regular-locality of `Λ_𝔮` together with the explicit
  -- source step `𝔮^N Λ_𝔮 ⊆ 𝔥_A Λ_𝔮`, upgraded by Lemma `16.10.2` to a concrete parameter family
  -- `π : Fin d → Λ` whose localized images form a regular system of parameters, whose `N`-th
  -- powers land in `𝔥_A`, and whose successive quotient torsion ideals already satisfy the
  -- `16.9.2`-style annihilator equalities on the target side. The final transfer from an
  -- auxiliary resolved factorization back to `A` is now packaged by
  -- `resolvableAtPrime_of_auxiliarySingularContainment`; the remaining blocker is the genuine
  -- Chapter 16 auxiliary-model construction, namely the `B/C` retract model together with the
  -- Artinian approximation/refinement that converts this parameter data into the quotient
  -- resolution input expected by `16.9.2` and then `16.9.4`.
  let _ := d
  let _ := π
  let _ := hπ
  let _ := hparams
  let _ := hpowSing
  let _ := hAnnΛ
  let _ := hNpos
  let _ := hN
  sorry

end

