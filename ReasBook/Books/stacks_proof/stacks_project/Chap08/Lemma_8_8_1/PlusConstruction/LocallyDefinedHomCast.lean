import stacks_proof.stacks_project.Chap08.Lemma_8_8_1.PlusConstruction.LocallyDefinedHom

universe u v uX vX

namespace CategoryTheory

open Bicategory
open FibredCategoryMor
open Functor
open Opposite
open scoped CategoryTheory.Bicategory

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}

attribute [local instance] Types.instFunLike Types.instConcreteCategory

namespace FibredCategoryMor
namespace LocallyDefinedHomRepresentativeOver

noncomputable section

/-- Transport the matching family of a fixed-base locally-defined representative along an
equality of displayed base arrows, without changing the representative cover.  This isolates the
`Eq.rec` bookkeeping that appears in the source stage 2 identity and associativity laws. -/
noncomputable def castBaseFamily
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f f' : X.p.obj x ⟶ X.p.obj y} (h : f = f')
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    Meq (locallyDefinedHomSaturatedPresheaf X f') α.cover := by
  cases h
  exact α.family

@[simp]
theorem castBaseFamily_rfl
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f : X.p.obj x ⟶ X.p.obj y}
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    castBaseFamily (J := J) (rfl : f = f) α = α.family :=
  rfl

/-- Applying a transported matching family is heterogeneously equal to applying the original
family.  This keeps later source-local calculations from unfolding the full `Eq.rec` generated by
transporting the displayed base arrow. -/
theorem castBaseFamily_apply_heq
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f f' : X.p.obj x ⟶ X.p.obj y} (h : f = f')
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f)
    (I : α.cover.Arrow) :
    HEq ((castBaseFamily (J := J) h α) I) (α.family I) := by
  cases h
  rfl

/-- The cover of `castBase h α` maps back to the original cover of `α`. -/
noncomputable def castBaseCoverHom
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f f' : X.p.obj x ⟶ X.p.obj y} (h : f = f')
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    (castBase (J := J) h α).cover ⟶ α.cover := by
  cases h
  exact 𝟙 α.cover

/-- The original cover of `α` maps to the cover of `castBase h α`. -/
noncomputable def coverHomCastBase
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f f' : X.p.obj x ⟶ X.p.obj y} (h : f = f')
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    α.cover ⟶ (castBase (J := J) h α).cover := by
  cases h
  exact 𝟙 α.cover

@[simp]
theorem castBaseCoverHom_rfl
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f : X.p.obj x ⟶ X.p.obj y}
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    castBaseCoverHom (J := J) (rfl : f = f) α = 𝟙 α.cover :=
  rfl

@[simp]
theorem coverHomCastBase_rfl
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f : X.p.obj x ⟶ X.p.obj y}
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    coverHomCastBase (J := J) (rfl : f = f) α = 𝟙 α.cover :=
  rfl

/-- Refining the transported representative back to the original cover gives the transported
matching family. -/
theorem castBase_family_refine_coverHomCastBase
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f f' : X.p.obj x ⟶ X.p.obj y} (h : f = f')
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    (castBase (J := J) h α).family.refine (coverHomCastBase (J := J) h α) =
      castBaseFamily (J := J) h α := by
  cases h
  rfl

/-- Refining the transported matching family to the transported cover recovers the family of the
transported representative. -/
theorem castBaseFamily_refine_castBaseCoverHom
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f f' : X.p.obj x ⟶ X.p.obj y} (h : f = f')
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    (castBaseFamily (J := J) h α).refine (castBaseCoverHom (J := J) h α) =
      (castBase (J := J) h α).family := by
  cases h
  rfl

/-- The plus-section represented by `castBase h α` is the plus-section represented by the
transported family on the original cover. -/
theorem castBase_toPlusSection_eq_mk_castBaseFamily
    {X : FibredCategoryOver.{u, v, uX, vX} C} {x y : X.S}
    {f f' : X.p.obj x ⟶ X.p.obj y} (h : f = f')
    (α : LocallyDefinedHomRepresentativeOver (J := J) X f) :
    (castBase (J := J) h α).toPlusSection =
      GrothendieckTopology.Plus.mk (castBaseFamily (J := J) h α) := by
  cases h
  rfl

end
end LocallyDefinedHomRepresentativeOver
end FibredCategoryMor

end CategoryTheory
