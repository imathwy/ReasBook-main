/-- Helper for Lemma 8.10.5: keep a local spelling for the canonical inherited topology used by
the surrounding proof helpers. -/
abbrev inheritedTopologyLocal
    {C : Type uC} [Category.{vC} C]
    (J : GrothendieckTopology C) (X : FibredCategoryOver C) :
    GrothendieckTopology X.S :=
  (stronglyCartesianLiftPrecoverage J.toPrecoverage X.p).toGrothendieck

end FibredCategoryOver

open FibredCategoryOver
open FibredCategoryMor
open Functor IsStronglyCartesian
open Opposite
open StackInGroupoidsOver.Hom

local notation "inheritedTopology" => FibredCategoryOver.inheritedTopologyLocal

/-- Helper for Lemma 8.10.5: locally recover the presieve generated by a fixed-target
semi-representable family without importing the conflicting Chapter 7 owner file. -/
abbrev semiRepresentableFamilyOverToPresieve
    {C : Type uC} [Category.{vC} C] {X : C}
    (S : CategoryTheory.SemiRepresentableFamily.Over X) :
    Presieve X :=
  Presieve.ofArrows (fun i ↦ (S.obj i).left) (fun i ↦ (S.obj i).hom)

/-- Helper for Lemma 8.10.5: locally recover the sieve generated by a fixed-target
semi-representable family. -/
abbrev semiRepresentableFamilyOverToSieve
    {C : Type uC} [Category.{vC} C] {X : C}
    (S : CategoryTheory.SemiRepresentableFamily.Over X) :
    Sieve X :=
  Sieve.generate (semiRepresentableFamilyOverToPresieve S)

/-- Helper for Lemma 8.10.5: local covering predicate for fixed-target semi-representable
families, used only to package the canonical family of a cover object. -/
abbrev semiRepresentableFamilyOverIsCovering
    {C : Type uC} [Category.{vC} C]
    (K : Precoverage C) {X : C} (S : CategoryTheory.SemiRepresentableFamily.Over X) :
    Prop :=
  semiRepresentableFamilyOverToPresieve S ∈ K X

section

variable {C : Type uC} [Category.{vC} C]
variable {J : GrothendieckTopology C}
variable {Xₛ Yₛ : StackInGroupoidsOver.{uC, vC, uX, vX} J}

/-- Helper for Lemma 8.10.5: for the inherited topology on `Yₛ`, stackness of `G F` is exactly
the coverwise equivalence of the canonical descent functors. This locks the proof into the source
route before any basis extraction or gluing helpers are used. -/
theorem inheritedTopology_stackOnSite_iff_coverwise_descent
    (F : Xₛ ⟶ Yₛ)
    [IsFibredInGroupoids (G F)] :
    IsStackOnSite (inheritedTopology J Yₛ) (G F) ↔
      ∀ (y : Yₛ.S) (T : (inheritedTopology J Yₛ).Cover y),
        ((canonicalFiberPseudofunctor (G F)).toDescentData (fun I : T.Arrow ↦ I.f)).IsEquivalence := by
  -- Reuse the standard coverwise descent criterion on the inherited site unchanged.
  simpa using
    (isStackOnSite_iff_coverwise_canonicalDescentFunctor_isEquivalence
      (inheritedTopology J Yₛ) (G F))

/-- Helper for Lemma 8.10.5: the canonical arrow family attached to an inherited cover generates
exactly the underlying sieve of that cover. -/
theorem inherited_cover_arrow_family_sieve_eq
    {y : Yₛ.S} (T : (inheritedTopology J Yₛ).Cover y) :
    Sieve.ofArrows (fun I : T.Arrow ↦ I.Y) (fun I ↦ I.f) = (T : Sieve y) := by
  -- Normalize the cover object to its canonical represented-arrow presentation.
  simpa using (GrothendieckTopology.Cover.ofArrows_eq T)

/-- Helper for Lemma 8.10.5: the canonical represented-arrow family attached to an inherited cover
is itself covering for the inherited topology. -/
theorem inherited_cover_arrow_family_covering
    {y : Yₛ.S} (T : (inheritedTopology J Yₛ).Cover y) :
    Sieve.ofArrows (fun I : T.Arrow ↦ I.Y) (fun I ↦ I.f) ∈ inheritedTopology J Yₛ y := by
  -- Replace the canonical arrow family by the cover sieve it presents.
  rw [inherited_cover_arrow_family_sieve_eq (J := J) T]
  exact T.condition

/-- Helper for Lemma 8.10.5: the canonical arrow family of a cover object is already covering for
the inherited precoverage. This is the exact source-side family that should be projected
downstairs, so later proofs do not need the old arbitrary-sieve detour. -/
theorem inherited_cover_arrow_family_mem_toPrecoverage
    {y : Yₛ.S} (T : (inheritedTopology J Yₛ).Cover y) :
    Presieve.ofArrows (fun I : T.Arrow ↦ I.Y) (fun I ↦ I.f) ∈
      (inheritedTopology J Yₛ).toPrecoverage y := by
  -- Repackage the cover object as its canonical represented family and read back the
  -- `toPrecoverage` witness through `mem_toPrecoverage_iff`.
  rw [GrothendieckTopology.mem_toPrecoverage_iff]
  change Sieve.ofArrows (fun I : T.Arrow ↦ I.Y) (fun I ↦ I.f) ∈ inheritedTopology J Yₛ y
  rw [inherited_cover_arrow_family_sieve_eq (J := J) (Yₛ := Yₛ) T]
  exact T.condition

/-- Helper for Lemma 8.10.5: the canonical arrow family of an inherited cover object can be
repackaged as a source-facing `SemiRepresentableFamily.Over` cover on the inherited site. This
separates the family-level bookkeeping from the still-open projection step downstairs. -/
theorem inherited_cover_arrow_family_isCovering
    {y : Yₛ.S} (T : (inheritedTopology J Yₛ).Cover y) :
    semiRepresentableFamilyOverIsCovering
      (inheritedTopology J Yₛ).toPrecoverage
      (CategoryTheory.SemiRepresentableFamily.Over.ofArrows (fun I : T.Arrow ↦ I.Y)
        (fun I ↦ I.f)) := by
  -- The represented family is definitionally the canonical arrow presieve attached to `T`.
  simpa [semiRepresentableFamilyOverIsCovering, semiRepresentableFamilyOverToPresieve] using
    inherited_cover_arrow_family_mem_toPrecoverage (J := J) (Yₛ := Yₛ) T

/-- Helper for Lemma 8.10.5: an inherited represented covering family maps to a covering family
downstairs in `J`. This is the direct projection bridge used by the source proof. -/
theorem base_cover_of_generating_inherited_cover_family
    {ι : Type*} {y : Yₛ.S} (Y : ι → Yₛ.S) (g : ∀ i, Y i ⟶ y)
    (hgen :
      Presieve.ofArrows Y g ∈ stronglyCartesianLiftPrecoverage J.toPrecoverage Yₛ.p y) :
    Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈ J (Yₛ.p.obj y) := by
  -- Read off the downstairs covering family directly from the generator data.
  rcases hgen with ⟨κ, Y', g', hgen_eq, _hgstrong, hbasePrecover⟩
  have hEq :
      Presieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) =
        Presieve.ofArrows (fun i ↦ Yₛ.p.obj (Y' i)) (fun i ↦ Yₛ.p.map (g' i)) := by
    simpa using congrArg (Presieve.map Yₛ.p) hgen_eq
  rw [GrothendieckTopology.mem_toPrecoverage_iff] at hbasePrecover
  simpa [Sieve.ofArrows, hEq] using hbasePrecover

/-- Helper for Lemma 8.10.5: a generating presieve for the inherited precoverage already pushes
forward to a `J`-covering sieve downstairs. This isolates the generator step before the final
Grothendieck-topology saturation argument. -/
theorem base_cover_of_inherited_precoverage
    {y : Yₛ.S} {R : Presieve y}
    (hR : R ∈ stronglyCartesianLiftPrecoverage J.toPrecoverage Yₛ.p y) :
    Sieve.functorPushforward Yₛ.p (Sieve.generate R) ∈ J (Yₛ.p.obj y) := by
  rcases hR with ⟨κ, Y, g, rfl, hgstrong, hbasePrecover⟩
  rw [GrothendieckTopology.mem_toPrecoverage_iff] at hbasePrecover
  -- Rewrite the pushforward of the generating presieve to the represented base family itself.
  rw [← Sieve.generate_map_eq_functorPushforward]
  simpa [Presieve.map_ofArrows, Sieve.ofArrows] using hbasePrecover

/-- Helper for Lemma 8.10.5: pulling back a projected sieve along a projected arrow is contained
in the projection of the upstairs pullback for a fibred category in groupoids. -/
theorem pullback_baseImage_le_baseImage_pullback
    (X : FibredCategoryOver C) [IsFibredInGroupoids X.p]
    {y z : X.S} (R : Sieve y) (f : z ⟶ y) :
    ((R.functorPushforward X.p).pullback (X.p.map f)) ≤
      ((R.pullback f).functorPushforward X.p) := by
  intro W q hq
  -- Lift a projected factorization through a cartesian pullback, then factor it through `f`.
  rcases hq with ⟨a, r, l, hr, hfac⟩
  let aFiber : X.p.Fiber (X.p.obj a) := ⟨a, rfl⟩
  let t : X.S := (l ^*[canonicalPullbackChoice X.p] aFiber).1
  let χ : t ⟶ a := (canonicalPullbackChoice X.p).map l aFiber
  have hχStrong : X.p.IsStronglyCartesian l χ := by
    simpa [χ] using (canonicalPullbackChoice X.p).isStronglyCartesian l aFiber
  letI : X.p.IsStronglyCartesian l χ := hχStrong
  have hχLift : X.p.IsHomLift l χ := inferInstance
  letI : X.p.IsHomLift l χ := hχLift
  let e : X.p.obj t = W := IsHomLift.domain_eq X.p l χ
  let baseToZ : X.p.obj t ⟶ X.p.obj z := eqToHom e ≫ q
  have hχmap : X.p.map χ = eqToHom e ≫ l := by
    simpa [e, χ] using (IsHomLift.fac' X.p l χ)
  have hbase :
      X.p.map (χ ≫ r) = baseToZ ≫ X.p.map f := by
    calc
      X.p.map (χ ≫ r) = X.p.map χ ≫ X.p.map r := by
        simp [Functor.map_comp]
      _ = (eqToHom e ≫ l) ≫ X.p.map r := by
        rw [hχmap]
      _ = eqToHom e ≫ (q ≫ X.p.map f) := by
        simp [Category.assoc, hfac.symm]
      _ = baseToZ ≫ X.p.map f := by
        simp [baseToZ, Category.assoc]
  let m : t ⟶ z :=
    Functor.IsStronglyCartesian.map X.p (X.p.map f) f hbase (χ ≫ r)
  have hm_fac : m ≫ f = χ ≫ r := by
    dsimp [m]
    exact Functor.IsStronglyCartesian.fac X.p (X.p.map f) f hbase (χ ≫ r)
  have hmLift : X.p.IsHomLift baseToZ m := by
    dsimp [m]
    infer_instance
  letI : X.p.IsHomLift baseToZ m := hmLift
  have hmR : (R.pullback f) m := by
    rw [Sieve.pullback_apply, hm_fac]
    exact R.downward_closed hr χ
  refine ⟨t, m, eqToHom e.symm, hmR, ?_⟩
  have hmapm : baseToZ = X.p.map m :=
    IsHomLift.eq_of_isHomLift X.p baseToZ m
  simpa [baseToZ, Category.assoc] using congrArg (fun k ↦ eqToHom e.symm ≫ k) hmapm

/-- Helper for Lemma 8.10.5: every inherited covering sieve projects to a covering sieve on the
base topology. -/
theorem base_cover_of_inherited_cover_sieve
    (X : FibredCategoryOver C) [IsFibredInGroupoids X.p]
    {y : X.S} {R : Sieve y}
    (hR : R ∈ (stronglyCartesianLiftPrecoverage J.toPrecoverage X.p).toGrothendieck y) :
    R.functorPushforward X.p ∈ J (X.p.obj y) := by
  -- Induct over the Grothendieck topology generated by the inherited precoverage.
  rw [Precoverage.mem_toGrothendieck_iff] at hR
  induction hR with
  | of y R hR =>
      rcases hR with ⟨κ, Y, g, rfl, _hgstrong, hbasePrecover⟩
      rw [GrothendieckTopology.mem_toPrecoverage_iff] at hbasePrecover
      rw [← Sieve.generate_map_eq_functorPushforward]
      simpa [Presieve.map_ofArrows, Sieve.ofArrows] using hbasePrecover
  | top y =>
      simp
  | pullback y R hR z f ih =>
      refine J.superset_covering
        (pullback_baseImage_le_baseImage_pullback X R f) ?_
      exact J.pullback_stable (X.p.map f) ih
  | transitive y S R hS hR ihS ihR =>
      refine J.transitive ihS (R.functorPushforward X.p) ?_
      intro Z q hq
      rcases hq with ⟨a, f, l, hf, hfac⟩
      have hlocal :
          ((R.pullback f).functorPushforward X.p).pullback l ∈ J Z :=
        J.pullback_stable l (ihR hf)
      refine J.superset_covering ?_ hlocal
      intro W k hk
      have hle :
          ((R.pullback f).functorPushforward X.p).pullback l ≤
            ((R.functorPushforward X.p).pullback (X.p.map f)).pullback l :=
        Sieve.pullback_monotone l (Sieve.functorPushforward_pullback_le (F := X.p) f R)
      have hk' := hle k hk
      simpa [Sieve.pullback_apply, hfac, Category.assoc] using hk'

/-- Helper for Lemma 8.10.5: an inherited represented covering family maps to a covering family
downstairs in `J`. This is the direct projection bridge used by the source proof. -/
theorem base_cover_of_inherited_cover_sieve_of_hasPullbacks
    [Limits.HasPullbacks C]
    {y : Yₛ.S} {S : Sieve y}
    (hcover : S ∈ inheritedTopology J Yₛ y) :
    Sieve.functorPushforward Yₛ.p S ∈ J (Yₛ.p.obj y) := by
  -- When the base category has pullbacks, the inherited precoverage admits the canonical
  -- Grothendieck-topology characterization by a generating inherited precover below `S`.
  rw [FibredCategoryOver.inheritedTopologyLocal] at hcover
  rw [Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition
    (J := stronglyCartesianLiftPrecoverage J.toPrecoverage Yₛ.p) (S := S)] at hcover
  rcases hcover with ⟨R, hR, hRS⟩
  have hgen : Sieve.generate R ≤ S := (Sieve.giGenerate.gc R S).2 hRS
  have hbaseR :
      Sieve.functorPushforward Yₛ.p (Sieve.generate R) ∈ J (Yₛ.p.obj y) :=
    base_cover_of_inherited_precoverage (J := J) (Yₛ := Yₛ) hR
  -- Enlarge the projected generating sieve to the projected ambient sieve.
  exact J.superset_covering (Sieve.functorPushforward_monotone Yₛ.p y hgen) hbaseR

/-- Helper for Lemma 8.10.5: the canonical arrow family of an inherited cover maps to a
`J`-covering family downstairs. -/
theorem inherited_cover_arrow_family_base_covering
    {y : Yₛ.S} (T : (inheritedTopology J Yₛ).Cover y) :
    Sieve.ofArrows (fun I : T.Arrow ↦ Yₛ.p.obj I.Y) (fun I ↦ Yₛ.p.map I.f) ∈ J (Yₛ.p.obj y) := by
  have hcover :
      Sieve.ofArrows (fun I : T.Arrow ↦ I.Y) (fun I ↦ I.f) ∈
        (stronglyCartesianLiftPrecoverage J.toPrecoverage Yₛ.p).toGrothendieck y := by
    simpa [FibredCategoryOver.inheritedTopologyLocal] using
      inherited_cover_arrow_family_covering (J := J) (Yₛ := Yₛ) T
  have hbase :
      (Sieve.ofArrows (fun I : T.Arrow ↦ I.Y) (fun I ↦ I.f)).functorPushforward Yₛ.p ∈
        J (Yₛ.p.obj y) :=
    base_cover_of_inherited_cover_sieve (J := J) Yₛ hcover
  -- Normalize the projected generated family to the literal downstairs arrow family.
  rw [← Sieve.generate_map_eq_functorPushforward] at hbase
  simpa [Presieve.map_ofArrows, Sieve.ofArrows] using hbase

/-- Helper for Lemma 8.10.5: a strongly cartesian family over a base covering sieve generates an
inherited covering sieve upstairs. -/
theorem stronglyCartesianFamily_mem_inheritedTopology_of_baseCover
    {ι : Type*} {y : Yₛ.S} (Y : ι → Yₛ.S) (g : ∀ i, Y i ⟶ y)
    (_hgstrong : ∀ i, Yₛ.p.IsStronglyCartesian (Yₛ.p.map (g i)) (g i))
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈
        J (Yₛ.p.obj y)) :
    Sieve.ofArrows Y g ∈ inheritedTopology J Yₛ y := by
  obtain ⟨κ, Y', g', hR⟩ := Presieve.exists_eq_ofArrows (Presieve.ofArrows Y g)
  have hgstrong' : ∀ i, Yₛ.p.IsStronglyCartesian (Yₛ.p.map (g' i)) (g' i) := by
    intro i
    infer_instance
  have hbasePrecover :
      Presieve.ofArrows (fun i ↦ Yₛ.p.obj (Y' i)) (fun i ↦ Yₛ.p.map (g' i)) ∈
        J.toPrecoverage (Yₛ.p.obj y) := by
    -- The small represented family obtained from `Presieve.exists_eq_ofArrows` contains the
    -- original projected family, so its generated base sieve is still a `J`-cover.
    rw [GrothendieckTopology.mem_toPrecoverage_iff]
    refine J.superset_covering ?_ hbaseCover
    intro U f hf
    rw [Sieve.mem_ofArrows_iff] at hf ⊢
    rcases hf with ⟨i, a, rfl⟩
    have hi : Presieve.ofArrows Y' g' (g i) := by
      rw [← hR]
      exact Presieve.ofArrows.mk i
    obtain ⟨j, hY, hg⟩ := Presieve.ofArrows_surj g' (g i) hi
    refine ⟨j, a ≫ Yₛ.p.map (eqToHom hY.symm), ?_⟩
    calc
      a ≫ Yₛ.p.map (g i) =
          a ≫ Yₛ.p.map (eqToHom hY.symm ≫ g' j) := by rw [hg]
      _ = (a ≫ Yₛ.p.map (eqToHom hY.symm)) ≫ Yₛ.p.map (g' j) := by
          simp [Functor.map_comp, Category.assoc]
  have hcover :
      Presieve.ofArrows Y g ∈ stronglyCartesianLiftPrecoverage J.toPrecoverage Yₛ.p y := by
    -- Use the small representative required by the inherited precoverage definition.
    exact ⟨κ, Y', g', hR, hgstrong', hbasePrecover⟩
  rw [FibredCategoryOver.inheritedTopologyLocal]
  simpa [Sieve.ofArrows] using
    (Precoverage.generate_mem_toGrothendieck
      (J := stronglyCartesianLiftPrecoverage J.toPrecoverage Yₛ.p)
      (R := Presieve.ofArrows Y g) hcover)

/-- Helper for Lemma 8.10.5: in a target stack in groupoids, any displayed family whose
projection is a `J`-cover is itself an inherited-topology cover. -/
theorem inherited_basis_family_mem_inheritedTopology_of_baseCover
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈
        J (Yₛ.p.obj y)) :
    Sieve.ofArrows Y g ∈ inheritedTopology J Yₛ y := by
  -- Every target-total arrow is strongly cartesian in a fibred groupoid, so the existing
  -- strongly-cartesian-family bridge applies directly to the projected base cover.
  have hgstrong : ∀ i, Yₛ.p.IsStronglyCartesian (Yₛ.p.map (g i)) (g i) := by
    intro i
    infer_instance
  exact
    stronglyCartesianFamily_mem_inheritedTopology_of_baseCover
      (J := J) (Yₛ := Yₛ) Y g hgstrong hbaseCover

/-- Helper for Lemma 8.10.5: a base cover pulls back to an inherited cover on the target total
category. -/
theorem baseCover_liftedPullbackCover_mem_inheritedTopology
    {y : Yₛ.S} (S : J.Cover (Yₛ.p.obj y)) :
    ((S : Sieve (Yₛ.p.obj y)).functorPullback Yₛ.p) ∈ inheritedTopology J Yₛ y := by
  let I : Type (max uX vX) :=
    { t : Σ z : Yₛ.S, z ⟶ y //
      (S : Sieve (Yₛ.p.obj y)) (Yₛ.p.map t.2) ∧
        Yₛ.p.IsStronglyCartesian (Yₛ.p.map t.2) t.2 }
  let Y : I → Yₛ.S := fun i ↦ i.1.1
  let g : ∀ i, Y i ⟶ y := fun i ↦ i.1.2
  have hgstrong : ∀ i, Yₛ.p.IsStronglyCartesian (Yₛ.p.map (g i)) (g i) := by
    intro i
    exact i.2.2
  have hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈
        J (Yₛ.p.obj y) := by
    refine J.superset_covering
      (S := (S : Sieve (Yₛ.p.obj y)))
      ?_ ?_
    · intro U f hf
      let yFiber : Yₛ.p.Fiber (Yₛ.p.obj y) := ⟨y, rfl⟩
      let z : Yₛ.S := (f ^*[canonicalPullbackChoice Yₛ.p] yFiber).1
      let k : z ⟶ y := (canonicalPullbackChoice Yₛ.p).map f yFiber
      have hkStrongBase : Yₛ.p.IsStronglyCartesian f k := by
        simpa [k] using (canonicalPullbackChoice Yₛ.p).isStronglyCartesian f yFiber
      have hkLift : Yₛ.p.IsHomLift f k := by
        letI : Yₛ.p.IsStronglyCartesian f k := hkStrongBase
        infer_instance
      have hmap :
          Yₛ.p.map k = eqToHom ((f ^*[canonicalPullbackChoice Yₛ.p] yFiber).2) ≫ f := by
        letI : Yₛ.p.IsHomLift f k := hkLift
        -- Record the base map of the chosen lift in the canonical `eqToHom ≫ f` form.
        simpa [z, k] using (IsHomLift.fac' Yₛ.p f k)
      have hSk : (S : Sieve (Yₛ.p.obj y)) (Yₛ.p.map k) := by
        rw [hmap]
        exact (S : Sieve (Yₛ.p.obj y)).downward_closed hf
          (eqToHom ((f ^*[canonicalPullbackChoice Yₛ.p] yFiber).2))
      have hkStrong : Yₛ.p.IsStronglyCartesian (Yₛ.p.map k) k := by
        infer_instance
      let i : I := ⟨⟨z, k⟩, hSk, hkStrong⟩
      rw [Sieve.mem_ofArrows_iff]
      refine ⟨i, eqToHom ((f ^*[canonicalPullbackChoice Yₛ.p] yFiber).2).symm, ?_⟩
      simpa [Category.assoc] using
        (congrArg
          (eqToHom ((f ^*[canonicalPullbackChoice Yₛ.p] yFiber).2).symm ≫ ·)
          hmap).symm
    · exact S.condition
  have hfamily :
      Sieve.ofArrows Y g ∈ inheritedTopology J Yₛ y :=
    stronglyCartesianFamily_mem_inheritedTopology_of_baseCover
      (J := J) (Yₛ := Yₛ) Y g hgstrong hbaseCover
  refine (inheritedTopology J Yₛ).superset_covering ?_ hfamily
  rw [Sieve.generate_le_iff]
  intro Z k hk
  rcases hk with ⟨i⟩
  -- The represented family of selected strongly cartesian arrows lies in the functor pullback.
  change (S : Sieve (Yₛ.p.obj y)) (Yₛ.p.map (g i))
  exact i.2.1

/-- Helper for Lemma 8.10.5: the projection from the inherited total site back to the base site is
cocontinuous. -/
instance projection_isCocontinuous_inheritedTopology :
    Yₛ.p.IsCocontinuous (inheritedTopology J Yₛ) J where
  cover_lift {U} {S} hS :=
    baseCover_liftedPullbackCover_mem_inheritedTopology (J := J) (Yₛ := Yₛ) (y := U) ⟨S, hS⟩

/-- Helper for Lemma 8.10.5: the projection from a fibred category in groupoids preserves
pullbacks along every arrow. -/
theorem projection_preservesPullback_of_arrow
    (X : FibredCategoryOver C) [IsFibredInGroupoids X.p]
    {y z t : X.S} (i : z ⟶ y) (f : t ⟶ y)
    [Limits.HasPullback f i] :
    Limits.PreservesLimit (Limits.cospan f i) X.p := by
  have hiStrong : X.p.IsStronglyCartesian (X.p.map i) i := by
    infer_instance
  -- The image of the upstairs pullback square is a base pullback because the right leg is
  -- strongly cartesian.
  exact
    Limits.preservesLimit_of_preserves_limit_cone
      (IsPullback.of_hasPullback f i).isLimit <| by
        apply (Limits.isLimitMapConePullbackConeEquiv X.p Limits.pullback.condition).symm.toFun
        exact
          (mapped_square_isPullback_of_isPullback_of_isStronglyCartesian
            (p := X.p) (hφ := hiStrong) (h := IsPullback.of_hasPullback f i)).isLimit

/-- Helper for Lemma 8.10.5: inherited covering families project to covering families in the
base precoverage. -/
theorem projection_toLeComap_inheritedTopology :
    (inheritedTopology J Yₛ).toPrecoverage ≤ J.toPrecoverage.comap Yₛ.p := by
  intro y R hR
  rw [GrothendieckTopology.mem_toPrecoverage_iff] at hR
  rw [Precoverage.mem_comap_iff, GrothendieckTopology.mem_toPrecoverage_iff]
  have hbase :
      (Sieve.generate R).functorPushforward Yₛ.p ∈ J (Yₛ.p.obj y) :=
    base_cover_of_inherited_cover_sieve (J := J) Yₛ (by
      simpa [FibredCategoryOver.inheritedTopologyLocal] using hR)
  rw [← Sieve.generate_map_eq_functorPushforward] at hbase
  simpa using hbase

/-- Helper for Lemma 8.10.5: the pullback-preservation component of continuity for the target
projection is independent of the chosen inherited cover arrow. -/
theorem projection_preservesPullback_inheritedTopology
    {V : Yₛ.S} {R : Presieve V}
    (_hR : R ∈ (inheritedTopology J Yₛ).toPrecoverage V)
    {Y : Yₛ.S} {i : Y ⟶ V} (_hi : R i)
    {T : Yₛ.S} (f : T ⟶ V) [Limits.HasPullback f i] :
    Limits.PreservesLimit (Limits.cospan f i) Yₛ.p :=
  by
    simpa [StackInGroupoidsOver.p, StackInGroupoidsOver.toFibredCategoryOver,
      FibredInGroupoidsOver.p] using
      (projection_preservesPullback_of_arrow Yₛ.toFibredCategoryOver i f)

/-- Helper for Lemma 8.10.5: the target projection is continuous for the inherited topology. -/
instance projection_isContinuousSiteFunctor_inheritedTopology :
    Functor.IsContinuousSiteFunctor Yₛ.p
      (inheritedTopology J Yₛ).toPrecoverage J.toPrecoverage where
  toLeComap := projection_toLeComap_inheritedTopology (J := J) (Yₛ := Yₛ)
  preservesPullback :=
    projection_preservesPullback_inheritedTopology (J := J) (Yₛ := Yₛ)

/-- Helper for Lemma 8.10.5: once the downstairs arrow family is known to be `J`-covering, the
stack property of `Xₛ` gives the canonical descent equivalence for that same family `g`. -/
theorem inherited_basis_source_descent_isEquivalence
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈ J (Yₛ.p.obj y)) :
    ((canonicalFiberPseudofunctor Xₛ.p).toDescentData (fun i ↦ Yₛ.p.map (g i))).IsEquivalence := by
  let Φ :=
    ((canonicalFiberPseudofunctor Xₛ.p).toDescentData (fun i ↦ Yₛ.p.map (g i)))
  have hstackFor :
      (canonicalFiberPseudofunctor Xₛ.p).IsStackFor
        (Presieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i))) := by
    -- Keep the source proof on the same family `g`: invoke stackness directly on the displayed
    -- sieve `Sieve.ofArrows ...` rather than replacing it by a new cover object.
    simpa [Φ, Sieve.ofArrows] using
      (canonicalFiberPseudofunctor Xₛ.p).isStackFor'
        (Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)))
        hbaseCover
  exact (canonicalFiberPseudofunctor Xₛ.p).isStackFor_ofArrows_iff (fun i ↦ Yₛ.p.map (g i)) |>.1
    hstackFor

/-- Helper for Lemma 8.10.5: package the previous source-side stackness result as an explicit
equivalence so later gluing steps can speak about the inverse object without rebuilding it. -/
noncomputable def inherited_basis_source_descent_equivalence
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈ J (Yₛ.p.obj y)) :
    Xₛ.p.Fiber (Yₛ.p.obj y) ≌
      (canonicalFiberPseudofunctor Xₛ.p).DescentData (fun i ↦ Yₛ.p.map (g i)) := by
  let Φ := ((canonicalFiberPseudofunctor Xₛ.p).toDescentData (fun i ↦ Yₛ.p.map (g i)))
  letI : Φ.IsEquivalence :=
    inherited_basis_source_descent_isEquivalence (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ)
      (Y := Y) (g := g) hbaseCover
  exact Φ.asEquivalence

/-- Helper for Lemma 8.10.5: the already established source-side descent equivalence supplies the
global object of `Xₛ` obtained by gluing a fixed-family source descent datum over the downstairs
cover. -/
noncomputable def inherited_basis_source_glued_object
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈ J (Yₛ.p.obj y)) :
    ((canonicalFiberPseudofunctor Xₛ.p).DescentData (fun i ↦ Yₛ.p.map (g i))) →
      Xₛ.p.Fiber (Yₛ.p.obj y) :=
  fun D ↦ (inherited_basis_source_descent_equivalence
    (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) (Y := Y) (g := g) hbaseCover).inverse.obj D

/-- Helper for Lemma 8.10.5: gluing a source descent datum with the packaged equivalence comes
with the expected counit isomorphism back to the original datum. -/
noncomputable def inherited_basis_source_glued_object_counit_iso
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈ J (Yₛ.p.obj y))
    (D : ((canonicalFiberPseudofunctor Xₛ.p).DescentData (fun i ↦ Yₛ.p.map (g i)))) :
    ((inherited_basis_source_descent_equivalence
        (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) (Y := Y) (g := g) hbaseCover).functor.obj
      (inherited_basis_source_glued_object
        (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) (Y := Y) (g := g) hbaseCover D)) ≅ D :=
  -- This is exactly the counit of the explicit source gluing equivalence.
  (inherited_basis_source_descent_equivalence
    (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) (Y := Y) (g := g) hbaseCover).counitIso.app D

/-- Helper for Lemma 8.10.5: the source stack supplies descent for the exact downstairs family
obtained by projecting the canonical arrows of an inherited cover. -/
theorem inherited_cover_source_toDescentData_isEquivalence
    {y : Yₛ.S} (T : (inheritedTopology J Yₛ).Cover y) :
    ((canonicalFiberPseudofunctor Xₛ.p).toDescentData
      (fun I : T.Arrow ↦ Yₛ.p.map I.f)).IsEquivalence := by
  -- Project the inherited cover to a `J`-cover and feed that same family into the source-stack
  -- descent criterion, avoiding any replacement of the indexing family.
  exact
    inherited_basis_source_descent_isEquivalence
      (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ)
      (Y := fun I : T.Arrow ↦ I.Y) (g := fun I : T.Arrow ↦ I.f)
      (inherited_cover_arrow_family_base_covering (J := J) (Yₛ := Yₛ) T)

/-- Helper for Lemma 8.10.5: an inherited covering sieve gives stack descent for the composite
projection along the projected covering sieve. -/
theorem inherited_cover_sieve_composite_stackFor
    {S : Type uX} [Category.{vX} S]
    (q : S ⥤ Yₛ.S)
    [IsStackOnSite J (q ⋙ Yₛ.p)]
    {y : Yₛ.S} (R : Sieve y)
    (hR : R ∈ inheritedTopology J Yₛ y) :
    (canonicalFiberPseudofunctor (q ⋙ Yₛ.p)).IsStackFor
      (R.functorPushforward Yₛ.p).arrows := by
  have hbase :
      R.functorPushforward Yₛ.p ∈ J (Yₛ.p.obj y) :=
    base_cover_of_inherited_cover_sieve (J := J) Yₛ (by
      simpa [FibredCategoryOver.inheritedTopologyLocal] using hR)
  -- Use stackness of the composite projection on the projected covering sieve.
  exact
    (canonicalFiberPseudofunctor (q ⋙ Yₛ.p)).isStackFor'
      (R.functorPushforward Yₛ.p) hbase

/-- Helper for Lemma 8.10.5: after projecting a fixed target-family cover, the composite
projection `G F ⋙ Yₛ.p` has effective descent over the corresponding projected inherited sieve. -/
theorem inherited_basis_composite_stackFor_of_baseCover
    (F : Xₛ ⟶ Yₛ)
    [IsStackOnSite J ((G F) ⋙ Yₛ.p)]
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈
        J (Yₛ.p.obj y)) :
    (canonicalFiberPseudofunctor ((G F) ⋙ Yₛ.p)).IsStackFor
      ((Sieve.ofArrows Y g).functorPushforward Yₛ.p).arrows := by
  have hInheritedCover :
      Sieve.ofArrows Y g ∈ inheritedTopology J Yₛ y :=
    inherited_basis_family_mem_inheritedTopology_of_baseCover
      (J := J) (Yₛ := Yₛ) hbaseCover
  exact
    inherited_cover_sieve_composite_stackFor
      (J := J) (Yₛ := Yₛ) (q := G F) (R := Sieve.ofArrows Y g) hInheritedCover

/-- Helper for Lemma 8.10.5: the composite projection has effective descent for the projected
base family whenever that projected family is a `J`-cover. -/
theorem inherited_basis_composite_toDescentData_isEquivalence_of_baseCover
    (F : Xₛ ⟶ Yₛ)
    [IsStackOnSite J ((G F) ⋙ Yₛ.p)]
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈
        J (Yₛ.p.obj y)) :
    ((canonicalFiberPseudofunctor ((G F) ⋙ Yₛ.p)).toDescentData
      (fun i ↦ Yₛ.p.map (g i))).IsEquivalence := by
  -- Work directly with the projected family, so the later target reconstruction can consume
  -- a fully faithful composite descent functor without reopening the inherited-cover sieve.
  let Φ :=
    ((canonicalFiberPseudofunctor ((G F) ⋙ Yₛ.p)).toDescentData
      (fun i ↦ Yₛ.p.map (g i)))
  have hstackFor :
      (canonicalFiberPseudofunctor ((G F) ⋙ Yₛ.p)).IsStackFor
        (Presieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i))) := by
    simpa [Φ, Sieve.ofArrows] using
      (canonicalFiberPseudofunctor ((G F) ⋙ Yₛ.p)).isStackFor'
        (Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)))
        hbaseCover
  exact
    (canonicalFiberPseudofunctor ((G F) ⋙ Yₛ.p)).isStackFor_ofArrows_iff
      (fun i ↦ Yₛ.p.map (g i)) |>.1 hstackFor

/-- Helper for Lemma 8.10.5: the projected composite descent functor is full over a `J`-cover. -/
theorem inherited_basis_composite_toDescentData_full_of_baseCover
    (F : Xₛ ⟶ Yₛ)
    [IsStackOnSite J ((G F) ⋙ Yₛ.p)]
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (hbaseCover :
      Sieve.ofArrows (fun i ↦ Yₛ.p.obj (Y i)) (fun i ↦ Yₛ.p.map (g i)) ∈
        J (Yₛ.p.obj y)) :
    Functor.Full
      ((canonicalFiberPseudofunctor ((G F) ⋙ Yₛ.p)).toDescentData
        (fun i ↦ Yₛ.p.map (g i))) := by
  -- Convert the effective composite descent result into the full instance needed for morphism
  -- lifting in the remaining target-side argument.
  let Φ :=
    ((canonicalFiberPseudofunctor ((G F) ⋙ Yₛ.p)).toDescentData
      (fun i ↦ Yₛ.p.map (g i)))
  have hΦ : Φ.IsEquivalence :=
    inherited_basis_composite_toDescentData_isEquivalence_of_baseCover
      (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) F hbaseCover
  letI : Φ.IsEquivalence := hΦ
  infer_instance

end

