import StacksProject_2024.Chap08.Lemma_8_6_11.SliceLocalClasses

universe u v

namespace CategoryTheory

section

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}
variable {X T : FibredInGroupoidsOver C}
variable [IsStackInGroupoids J T.p]

namespace FibredInGroupoidsMor

open FibredInGroupoidsOver (ofFunctor)

/-- Helper for Chap08 Lemma 8 6 11: slice iso-class separatedness supplies fullness of the
fixed-cover canonical descent functor on the source. -/
theorem canonicalDescentFunctor_full_of_sliceIsoClassSheaves
    (F : FibredInGroupoidsMor X T)
    (hFaithful : (toBasedFunctor F).Faithful)
    (hSheaf :
      ∀ {V : C} (G : ofFunctor (Over.forget V) ⟶ T),
        Presheaf.IsSheaf (J.over V) ((F.sliceTwoFibreProduct G).p.fiberIsoClassPresheaf))
    {U : C} (S : J.Cover U) :
    ((canonicalFiberPseudofunctor X.p).toDescentData (fun I : S.Arrow ↦ I.f)).Full := by
  -- Descend the image of a descent morphism through the target stack, then use the slice
  -- iso-class sheaf to see that the resulting target morphism is in the image of `F`.
  classical
  let ΦX := (canonicalFiberPseudofunctor X.p).toDescentData (fun I : S.Arrow ↦ I.f)
  let ΦT := (canonicalFiberPseudofunctor T.p).toDescentData (fun I : S.Arrow ↦ I.f)
  let H := FibredInGroupoidsMor.toFibredCategoryMor F
  have hTarget : ΦT.IsEquivalence := canonicalDescentFunctor_isEquivalence_of_stack T S
  letI : ΦT.Full := hTarget.full
  refine ⟨?_⟩
  intro x y θ
  let Ψ := cover_descent_data_functor_of_stack_morphism H S
  let η := cover_descent_data_functor_of_stack_morphism_toDescentData_iso (J := J) H S
  let θT : ΦT.obj ((fiberFunctor F U).obj x) ⟶ ΦT.obj ((fiberFunctor F U).obj y) :=
    (η.inv.app x) ≫ Ψ.map θ ≫ (η.hom.app y)
  let β : (fiberFunctor F U).obj x ⟶ (fiberFunctor F U).obj y := ΦT.preimage θT
  have hEq :
      (@Quotient.mk'' _
        (isIsomorphicSetoid
          (((F.sliceTwoFibreProduct
            (fiberObjectSliceMorphism T ((fiberFunctor F U).obj y))).p).Fiber
            (Over.mk (𝟙 U))))
        (sliceLocalObject F ((fiberFunctor F U).obj y) (Over.mk (𝟙 U)) x
          ((fiberObjectSliceMorphism_terminalEvaluationIso T ((fiberFunctor F U).obj y)).hom ≫
            inv β))) =
      (@Quotient.mk'' _
        (isIsomorphicSetoid
          (((F.sliceTwoFibreProduct
            (fiberObjectSliceMorphism T ((fiberFunctor F U).obj y))).p).Fiber
            (Over.mk (𝟙 U))))
          (sliceLocalObject F ((fiberFunctor F U).obj y) (Over.mk (𝟙 U)) y
            (fiberObjectSliceMorphism_terminalEvaluationIso T ((fiberFunctor F U).obj y)).hom)) := by
    let G := fiberObjectSliceMorphism T ((fiberFunctor F U).obj y)
    let P := ((F.sliceTwoFibreProduct G).p).fiberIsoClassPresheaf
    let ST := GrothendieckTopology.localized_cover_descent_terminal_cover (J := J) S
    let π : (I : S.Arrow) → Over.mk I.f ⟶ Over.mk (𝟙 U) := fun I ↦ Over.homMk I.f
    let s₁ : P.obj (Opposite.op (Over.mk (𝟙 U))) :=
      Quotient.mk''
        (sliceLocalObject F ((fiberFunctor F U).obj y) (Over.mk (𝟙 U)) x
          ((fiberObjectSliceMorphism_terminalEvaluationIso T ((fiberFunctor F U).obj y)).hom ≫
            inv β))
    let s₂ : P.obj (Opposite.op (Over.mk (𝟙 U))) :=
      Quotient.mk''
        (sliceLocalObject F ((fiberFunctor F U).obj y) (Over.mk (𝟙 U)) y
          (fiberObjectSliceMorphism_terminalEvaluationIso T ((fiberFunctor F U).obj y)).hom)
    have hsheafOfArrows :
        Presieve.IsSheafFor P
          (Presieve.ofArrows (fun I : S.Arrow ↦ Over.mk I.f) π) := by
      -- The terminal cover is generated by the original cover arrows, so the sheaf condition can
      -- be read on those generators rather than on arbitrary arrows of the generated sieve.
      rw [Presieve.isSheafFor_iff_generate]
      simpa [P, ST, π, GrothendieckTopology.localized_cover_descent_terminal_cover] using
        (Presheaf.IsSheaf.isSheafFor
          (hSheaf G)
          ((GrothendieckTopology.localized_cover_descent_terminal_cover (J := J) S).1)
          ((GrothendieckTopology.localized_cover_descent_terminal_cover (J := J) S).condition))
    have hbij :
        Function.Bijective (Presieve.Arrows.toCompatible P π) :=
      (Presieve.isSheafFor_ofArrows_iff_bijective_toCompabible
        (P := P) (π := π)).mp hsheafOfArrows
    apply hbij.1
    apply Subtype.ext
    funext I
    -- On each generating cover arrow, the target descent morphism identifies the two restricted
    -- slice classes.
    change P.map (π I).op s₁ = P.map (π I).op s₂
    let ex := FibredCategoryMor.pullbackComparison H I.f x
    let ey := FibredCategoryMor.pullbackComparison H I.f y
    let eCover := fiberObjectSliceMorphism_coverEvaluationIso T S ((fiberFunctor F U).obj y) I
    have hβiso : IsIso β :=
      IsFibredInGroupoids.hom_isIso (p := T.p) U β
    let βinv : (fiberFunctor F U).obj y ⟶ (fiberFunctor F U).obj x :=
      @inv _ _ _ _ β hβiso
    let τA := eCover.hom ≫ (ΦT.map βinv).hom I ≫ ex.hom
    let τB := eCover.hom ≫ ey.hom
    have hbx :
        X.p.IsHomLift (π I).left ((canonicalPullbackChoice X.p).map I.f x) := by
      simpa [π] using
        ((canonicalPullbackChoice X.p).isStronglyCartesian I.f x).toIsHomLift
    have hby :
        X.p.IsHomLift (π I).left ((canonicalPullbackChoice X.p).map I.f y) := by
      simpa [π] using
        ((canonicalPullbackChoice X.p).isStronglyCartesian I.f y).toIsHomLift
    have hleft := sliceLocalClass_restrict_eq_of_sourceTargetSquare
      (F := F) (y := ((fiberFunctor F U).obj y)) (a := π I)
      (xV := x)
      (τV := ((fiberObjectSliceMorphism_terminalEvaluationIso T
        ((fiberFunctor F U).obj y)).hom ≫ βinv))
      (xW := ((ΦX.obj x).obj I))
      (τW := τA)
      (b := (canonicalPullbackChoice X.p).map I.f x)
      (hb := hbx)
      (hτ := by
        have hcover :=
          fiberObjectSliceMorphism_coverEvaluationIso_hom_postcompose
            (Y := T) (S := S) ((fiberFunctor F U).obj y) I (π I)
        have hβpull :=
          canonical_pullbackFunctor_map_fac (p := T.p) (f := I.f) (φ := βinv)
        have hexpost := FibredCategoryMor.pullbackComparison_hom_postcompose H I.f x
        have hcoverβ :
            (toBasedFunctor (fiberObjectSliceMorphism T ((fiberFunctor F U).obj y))).map (π I) ≫
                ((fiberObjectSliceMorphism_terminalEvaluationIso T
                  ((fiberFunctor F U).obj y)).hom ≫ βinv).1 =
                eCover.hom.1 ≫
                  ((canonicalPullbackChoice T.p).map I.f ((fiberFunctor F U).obj y) ≫
                    βinv.1) := by
          calc
            (toBasedFunctor (fiberObjectSliceMorphism T ((fiberFunctor F U).obj y))).map (π I) ≫
                ((fiberObjectSliceMorphism_terminalEvaluationIso T
                  ((fiberFunctor F U).obj y)).hom ≫ βinv).1 =
              ((toBasedFunctor (fiberObjectSliceMorphism T ((fiberFunctor F U).obj y))).map (π I) ≫
                (fiberObjectSliceMorphism_terminalEvaluationIso T
                  ((fiberFunctor F U).obj y)).hom.1) ≫ βinv.1 := by
                exact (Category.assoc _ _ _).symm
            _ =
              (eCover.hom.1 ≫
                (canonicalPullbackChoice T.p).map I.f ((fiberFunctor F U).obj y)) ≫ βinv.1 := by
                exact congrArg (fun k ↦ k ≫ βinv.1) hcover
            _ =
              eCover.hom.1 ≫
                ((canonicalPullbackChoice T.p).map I.f ((fiberFunctor F U).obj y) ≫
                  βinv.1) := by
                exact Category.assoc _ _ _
        have hβstep :
            eCover.hom.1 ≫
                ((canonicalPullbackChoice T.p).map I.f ((fiberFunctor F U).obj y) ≫
                  βinv.1) =
              eCover.hom.1 ≫
                (((ΦT.map βinv).hom I).1 ≫
                  (canonicalPullbackChoice T.p).map I.f ((fiberFunctor F U).obj x)) := by
          simpa only [Category.assoc] using
            congrArg (fun k ↦ eCover.hom.1 ≫ k) hβpull.symm
        have hexstep :
            eCover.hom.1 ≫
                (((ΦT.map βinv).hom I).1 ≫
                  (canonicalPullbackChoice T.p).map I.f ((fiberFunctor F U).obj x)) =
              (eCover.hom.1 ≫ ((ΦT.map βinv).hom I).1 ≫ ex.hom.1) ≫
                (toBasedFunctor F).map ((canonicalPullbackChoice X.p).map I.f x) := by
          simpa only [Category.assoc, H, ex] using
            congrArg
              (fun k ↦ eCover.hom.1 ≫ (((ΦT.map βinv).hom I).1 ≫ k))
              hexpost.symm
        have hcalc :=
          hcoverβ.trans (hβstep.trans hexstep)
        have hτA_val :
            τA.1 = eCover.hom.1 ≫ ((ΦT.map βinv).hom I).1 ≫ ex.hom.1 := rfl
        simpa only [hτA_val] using hcalc)
    have hright := sliceLocalClass_restrict_eq_of_sourceTargetSquare
      (F := F) (y := ((fiberFunctor F U).obj y)) (a := π I)
      (xV := y)
      (τV := (fiberObjectSliceMorphism_terminalEvaluationIso T
        ((fiberFunctor F U).obj y)).hom)
      (xW := ((ΦX.obj y).obj I))
      (τW := τB)
      (b := (canonicalPullbackChoice X.p).map I.f y)
      (hb := hby)
      (hτ := by
        have hcover :=
          fiberObjectSliceMorphism_coverEvaluationIso_hom_postcompose
            (Y := T) (S := S) ((fiberFunctor F U).obj y) I (π I)
        have heypost := FibredCategoryMor.pullbackComparison_hom_postcompose H I.f y
        have htarget :
            eCover.hom.1 ≫
                (canonicalPullbackChoice T.p).map I.f ((fiberFunctor F U).obj y) =
              (eCover.hom.1 ≫ ey.hom.1) ≫
                (toBasedFunctor F).map ((canonicalPullbackChoice X.p).map I.f y) := by
          simpa only [Category.assoc, H, ey] using
            congrArg (fun k ↦ eCover.hom.1 ≫ k) heypost.symm
        have hcalc := hcover.trans htarget
        have hτB_val : τB.1 = eCover.hom.1 ≫ ey.hom.1 := rfl
        simpa only [hτB_val] using hcalc)
    have hlocal :
        @Quotient.mk'' _
          (isIsomorphicSetoid
            (((F.sliceTwoFibreProduct G).p).Fiber (Over.mk I.f)))
            (sliceLocalObject F ((fiberFunctor F U).obj y) (Over.mk I.f)
              ((ΦX.obj x).obj I) τA) =
          @Quotient.mk'' _
            (isIsomorphicSetoid
              (((F.sliceTwoFibreProduct G).p).Fiber (Over.mk I.f)))
            (sliceLocalObject F ((fiberFunctor F U).obj y) (Over.mk I.f)
              ((ΦX.obj y).obj I) τB) := by
      rw [Quotient.eq'']
      let E := sliceTwoFibreProductStructuredArrowEquivFiber
        (G := FibredInGroupoidsMor.toBasedFunctor G)
        (F := FibredInGroupoidsMor.toBasedFunctor F)
        (f := Over.mk I.f)
      have hpre : ΦT.map β = θT := by
        exact Functor.map_preimage ΦT θT
      have hcomponent : (ΦT.map β).hom I = θT.hom I := by
        exact congrArg (fun η ↦ η.hom I) hpre
      have hθT :
          θT.hom I =
            ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) ≫ ey.inv := by
        change ((η.inv.app x ≫ Ψ.map θ ≫ η.hom.app y).hom I) =
          ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) ≫ ey.inv
        rw [Pseudofunctor.DescentData.comp_hom, Pseudofunctor.DescentData.comp_hom]
        rw [cover_descent_data_functor_of_stack_morphism_toDescentData_iso_inv_hom,
          cover_descent_data_functor_of_stack_morphism_toDescentData_iso_hom_hom]
        rfl
      have hβcancel :
          (ΦT.map βinv).hom I ≫ (ΦT.map β).hom I =
            𝟙 ((ΦT.obj ((fiberFunctor F U).obj y)).obj I) := by
        have hmap :
            ΦT.map (βinv ≫ β) = 𝟙 (ΦT.obj ((fiberFunctor F U).obj y)) := by
          calc
            ΦT.map (βinv ≫ β) = ΦT.map (𝟙 ((fiberFunctor F U).obj y)) := by
              exact congrArg (fun f ↦ ΦT.map f) (IsIso.inv_hom_id β)
            _ = 𝟙 (ΦT.obj ((fiberFunctor F U).obj y)) := by
              exact ΦT.map_id ((fiberFunctor F U).obj y)
        simpa only [Functor.map_comp, Pseudofunctor.DescentData.comp_hom,
          Pseudofunctor.DescentData.id_hom] using
          congrArg (fun η ↦ η.hom I) hmap
      have hθT_post :
          θT.hom I ≫ ey.hom =
            ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) := by
        rw [hθT]
        exact (Iso.eq_comp_inv ey).1 (Category.assoc _ _ _).symm
      have hβinvθT :
          (ΦT.map βinv).hom I ≫ θT.hom I =
            𝟙 ((ΦT.obj ((fiberFunctor F U).obj y)).obj I) := by
        rw [← hcomponent]
        exact hβcancel
      have hβinvθ :
          (ΦT.map βinv).hom I ≫ ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) =
            ey.hom := by
        have hleftθ :
            (ΦT.map βinv).hom I ≫ ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) =
              (ΦT.map βinv).hom I ≫ (θT.hom I ≫ ey.hom) := by
          simpa only [Category.assoc] using
            congrArg (fun k ↦ (ΦT.map βinv).hom I ≫ k) hθT_post.symm
        have hassocθ :
            (ΦT.map βinv).hom I ≫ (θT.hom I ≫ ey.hom) =
              ((ΦT.map βinv).hom I ≫ θT.hom I) ≫ ey.hom :=
          (Category.assoc _ _ _).symm
        have hcancelθ :
            ((ΦT.map βinv).hom I ≫ θT.hom I) ≫ ey.hom = ey.hom := by
          have htmp := congrArg (fun k ↦ k ≫ ey.hom) hβinvθT
          exact htmp.trans (Category.id_comp _)
        exact hleftθ.trans (hassocθ.trans hcancelθ)
      have hθiso : IsIso (θ.hom I) :=
        IsFibredInGroupoids.hom_isIso (p := X.p) I.Y (θ.hom I)
      let eθ : ((ΦX.obj x).obj I) ≅ ((ΦX.obj y).obj I) :=
        @asIso _ _ _ _ (θ.hom I) hθiso
      refine ⟨E.functor.mapIso (StructuredArrow.isoMk eθ ?_)⟩
      change τA ≫ (fiberFunctor F I.Y).map (θ.hom I) = τB
      simpa only [τA, τB, eθ, Category.assoc] using
        congrArg (fun k ↦ eCover.hom ≫ k) hβinvθ
    simpa [P, s₁, s₂] using hleft.trans (hlocal.trans hright.symm)
  obtain ⟨α, hα⟩ := exists_source_hom_of_sliceLocalClass_eq F β hEq
  refine ⟨α, ?_⟩
  apply Pseudofunctor.DescentData.hom_ext
  intro I
  letI : (fiberFunctor F I.Y).Faithful :=
    (faithful_iff_fiberwise (F := F)).1 hFaithful I.Y
  apply (fiberFunctor F I.Y).map_injective
  let ex := FibredCategoryMor.pullbackComparison H I.f x
  let ey := FibredCategoryMor.pullbackComparison H I.f y
  have hpre : ΦT.map β = θT := by
    exact Functor.map_preimage ΦT θT
  have hcomponent : (ΦT.map β).hom I = θT.hom I := by
    exact congrArg (fun η ↦ η.hom I) hpre
  have hθT :
      θT.hom I =
        ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) ≫ ey.inv := by
    change ((η.inv.app x ≫ Ψ.map θ ≫ η.hom.app y).hom I) =
      ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) ≫ ey.inv
    rw [Pseudofunctor.DescentData.comp_hom, Pseudofunctor.DescentData.comp_hom]
    rw [cover_descent_data_functor_of_stack_morphism_toDescentData_iso_inv_hom,
      cover_descent_data_functor_of_stack_morphism_toDescentData_iso_hom_hom]
    rfl
  have hβcomp : (ΦT.map ((fiberFunctor F U).map α)).hom I = θT.hom I := by
    rw [hα]
    exact hcomponent
  have hnat :
      (ΦT.map ((fiberFunctor F U).map α)).hom I ≫ ey.hom =
        ex.hom ≫ (fiberFunctor F I.Y).map ((ΦX.map α).hom I) := by
    simpa only [ΦX, ΦT, H, ex, ey] using
      FibredCategoryMor.pullbackComparison_naturality_over_vertical H I.f α
  apply (Iso.cancel_iso_hom_left ex _ _).1
  have hleft :
      ex.hom ≫ (fiberFunctor F I.Y).map ((ΦX.map α).hom I) =
        θT.hom I ≫ ey.hom := by
    exact hnat.symm.trans (by rw [hβcomp])
  have hright :
      θT.hom I ≫ ey.hom =
        ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) := by
    rw [hθT]
    have hcancel :
        (ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) ≫ ey.inv) ≫ ey.hom =
          ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I) := by
      simpa only [Category.assoc] using
        (congrArg (fun k ↦ (ex.hom ≫ (fiberFunctor F I.Y).map (θ.hom I)) ≫ k)
          ey.inv_hom_id).trans (Category.comp_id _)
    exact hcancel
  exact hleft.trans hright

end FibredInGroupoidsMor

end

end CategoryTheory
