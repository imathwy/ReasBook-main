import Mathlib
import stacks_proof.stacks_project.Chap04.Lemma_4_42_5
import stacks_proof.stacks_project.Chap07.Lemma_7_26_4.TerminalCovers
import stacks_proof.stacks_project.Chap08.Definition_8_5_1
import stacks_proof.stacks_project.Chap08.Definition_8_6_1
import stacks_proof.stacks_project.Chap08.Lemma_8_2_3.PullbackComparisonNaturality
import stacks_proof.stacks_project.Chap08.Lemma_8_4_6.FixedCoverEquivalenceBridge
import stacks_proof.stacks_project.Chap08.Lemma_8_6_3

universe u v

namespace CategoryTheory

section

variable {C : Type u} [Category.{v} C]
variable {J : GrothendieckTopology C}
variable {X T : FibredInGroupoidsOver C}
variable [IsStackInGroupoids J T.p]

namespace FibredInGroupoidsMor

open FibredInGroupoidsOver (ofFunctor)

/-- Helper for Chap08 Lemma 8 6 11: a cover arrow gives the corresponding generator arrow in
the terminal cover of the localized site. -/
noncomputable def terminalCoverArrowOfCoverArrow
    {U : C} (S : J.Cover U) (I : S.Arrow) :
    (GrothendieckTopology.localized_cover_descent_terminal_cover (J := J) S).Arrow := by
  -- The generator is the slice arrow `I.f : I.Y ⟶ U`, viewed as an arrow to `id_U`.
  let h : Over.mk I.f ⟶ Over.mk (𝟙 U) :=
    Over.homMk (U := Over.mk I.f) (V := Over.mk (𝟙 U)) I.f (by simp)
  refine ⟨Over.mk I.f, h, ?_⟩
  -- Membership is immediate because the terminal-cover sieve is generated by the cover arrows.
  change
    (Sieve.ofArrows (fun I : S.Arrow ↦ Over.mk I.f)
      (fun I ↦ show Over.mk I.f ⟶ Over.mk (𝟙 U) from
        Over.homMk (U := Over.mk I.f) (V := Over.mk (𝟙 U)) I.f (by simp))).arrows h
  rw [Sieve.mem_ofArrows_iff]
  refine ⟨I, 𝟙 _, ?_⟩
  ext
  simp [h]

/-- Helper for Chap08 Lemma 8 6 11: the generator arrow in the localized terminal cover forgets
back to the original cover arrow. -/
theorem terminalCoverArrowOfCoverArrow_base
    {U : C} (S : J.Cover U) (I : S.Arrow) :
    GrothendieckTopology.localized_cover_descent_terminal_cover_arrow_base (J := J) S
      (terminalCoverArrowOfCoverArrow (J := J) S I) = I := by
  -- Unfold the generator and the owner `arrow_base`; both cover-arrow records have identical
  -- object and map components, and proof irrelevance closes the sieve-membership field.
  ext <;>
    simp [terminalCoverArrowOfCoverArrow,
      GrothendieckTopology.localized_cover_descent_terminal_cover_arrow_base]

/-- Helper for Chap08 Lemma 8 6 11: an arbitrary arrow of the localized terminal cover has
underlying slice object `Over.mk` of its recovered base-cover arrow. -/
theorem terminalCoverArrow_y_eq_base
    {U : C} (S : J.Cover U)
    (K : (GrothendieckTopology.localized_cover_descent_terminal_cover (J := J) S).Arrow) :
    K.Y =
      Over.mk
        (GrothendieckTopology.localized_cover_descent_terminal_cover_arrow_base (J := J) S K).f := by
  -- The recovered base arrow is the left component of `K.f`; the slice object equality follows
  -- from the defining commutative triangle of `K.f`.
  refine Comma.ext ?_ ?_ ?_
  · rfl
  · rfl
  · simpa [GrothendieckTopology.localized_cover_descent_terminal_cover_arrow_base]
      using (Over.w K.f).symm
end FibredInGroupoidsMor

end

end CategoryTheory
