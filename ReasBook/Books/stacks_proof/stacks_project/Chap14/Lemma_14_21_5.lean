/- Domain-style sampling for Lemma 14.21.5:
- primary domain: simplicial-set skeletons and the canonical counit `((SSet.skAdj n).counit.app U)`;
- sampled owner declarations:
  `SSet.skeleton`,
  `SSet.Subcomplex.range`,
  `SSet.Subcomplex.toRange`,
  `SSet.skeleton_obj_eq_top`;
- best owner abstraction: the canonical owner is the subcomplex `U.skeleton (n + 1)`;
- primitive data: only the simplicial set `U` and its owner subcomplex `U.skeleton (n + 1)`;
- derived API: the range identification for the counit and the induced isomorphism from
  `(SSet.sk n).obj U` to that owner object.

Source/core/bridge triage:
- `source-facing`: the textbook identification of `i_{n!} sk_n U` with the simplicial subset of
  `U` generated by simplices in degrees at most `n`;
- `core/canonical`: `SSet.skeleton`;
- `bridge/view`: the equality between the counit range and `U.skeleton (n + 1)`, together with the
  resulting isomorphism of simplicial sets.

The counit mono fact below is proof support for `SSet.Subcomplex.toRange`; it is not part of the
public owner API. -/
/-- Helper for Lemma 14.21.5: in every degree `i ≤ n`, the counit from the simplicial
`n`-skeleton to `U` is an isomorphism. -/
private theorem truncatedSkeleton_counit_app_isIso_of_le
    (n : ℕ) (U : SSet.{u}) {i : ℕ} (hi : i ≤ n) :
    IsIso (((SSet.skAdj n).counit.app U).app (op ⦋i⦌)) := by
  let ε : (SSet.sk n).obj U ⟶ U := (SSet.skAdj n).counit.app U
  let i' : SimplexCategory.Truncated n := ⟨SimplexCategory.mk i, hi⟩
  -- Proof comment: truncating the counit and using the right triangle identifies it with the
  -- inverse of the unit isomorphism from `Lemma 14.21.3`.
  haveI : IsIso ((SSet.skAdj n).unit.app ((SSet.truncation n).obj U)) := by
    infer_instance
  haveI : IsIso ((SSet.truncation n).map ε) := by
    exact isIso_of_hom_comp_eq_id ((SSet.skAdj n).unit.app ((SSet.truncation n).obj U))
      ((SSet.skAdj n).right_triangle_components U)
  simpa [ε] using
    ((NatTrans.isIso_iff_isIso_app ((SSet.truncation n).map ε)).1 inferInstance (op i'))

/-- Helper for Lemma 14.21.5: every nondegenerate simplex of the simplicial `n`-skeleton of `U`
already lives in degree at most `n`. -/
private theorem truncatedSkeleton_nondegenerate_degree_le
    (n : ℕ) (U : SSet.{u}) {m : ℕ} (x : ((SSet.sk n).obj U).nonDegenerate m) :
    m ≤ n := by
  -- Proof comment: `Lemma 14.21.4` equips the truncated extension with the canonical dimension
  -- bound `≤ n`, so any nondegenerate simplex has degree at most `n`.
  simpa using
    (((SSet.Truncated.sk n).obj ((SSet.truncation n).obj U)).dim_le_of_nonDegenerate x n)

/-- Helper for Lemma 14.21.5: the counit sends nondegenerate simplices of the simplicial
`n`-skeleton of `U` to nondegenerate simplices of `U`. -/
private theorem truncatedSkeleton_counit_maps_nondegenerate
    (n : ℕ) (U : SSet.{u}) :
    ∀ ⦃m : ℕ⦄ (x : ((SSet.sk n).obj U).nonDegenerate m),
      (((SSet.skAdj n).counit.app U).app (op ⦋m⦌) x) ∈ U.nonDegenerate m := by
  intro m x
  let ε : (SSet.sk n).obj U ⟶ U := (SSet.skAdj n).counit.app U
  have hm : m ≤ n := truncatedSkeleton_nondegenerate_degree_le n U x
  haveI : IsIso (ε.app (op ⦋m⦌)) := truncatedSkeleton_counit_app_isIso_of_le n U hm
  have hεm_injective : Function.Injective (ε.app (op ⦋m⦌)) := by
    exact (mono_iff_injective _).1 inferInstance
  -- Proof comment: if the image were degenerate, pull the lower-degree witness back along the
  -- degreewise inverse and use injectivity of `ε_m` to make the source simplex degenerate too.
  have himage_nondeg : (ε.app (op ⦋m⦌) x) ∉ U.degenerate m := by
    intro hxdeg
    have hxnondeg : x.1 ∉ ((SSet.sk n).obj U).degenerate m := by
      simpa [SSet.mem_nonDegenerate_iff_notMem_degenerate] using x.2
    rw [SSet.mem_degenerate_iff] at hxdeg
    rcases hxdeg with ⟨j, hj, f, hf, y, hy⟩
    have hjn : j ≤ n := le_trans (Nat.le_of_lt hj) hm
    haveI : IsIso (ε.app (op ⦋j⦌)) := truncatedSkeleton_counit_app_isIso_of_le n U hjn
    let z : ((SSet.sk n).obj U) _⦋j⦌ := inv (ε.app (op ⦋j⦌)) y
    have hz : ε.app (op ⦋j⦌) z = y := by
      simpa [z] using CategoryTheory.inv_hom_id_apply (asIso (ε.app (op ⦋j⦌))) y
    have hxdeg' : x.1 ∈ ((SSet.sk n).obj U).degenerate m := by
      rw [SSet.mem_degenerate_iff]
      refine ⟨j, hj, f, hf, z, ?_⟩
      apply hεm_injective
      calc
        ε.app (op ⦋m⦌) (((SSet.sk n).obj U).map f.op z) =
            U.map f.op (ε.app (op ⦋j⦌) z) := by
              simpa using congrFun (ε.naturality f.op) z
        _ = U.map f.op y := by
              exact congrArg (U.map f.op) hz
        _ = ε.app (op ⦋m⦌) x := hy
    exact hxnondeg hxdeg'
  exact
    (SSet.mem_nonDegenerate_iff_notMem_degenerate
      (X := U) (x := ε.app (op ⦋m⦌) x)).2 himage_nondeg

-- Proof sketch: by Lemma 14.21.4, every nondegenerate simplex of `(SSet.sk n).obj U` has degree at
-- most `n`, and the counit is an isomorphism in those degrees by truncation-coreflection. Hence it
-- preserves nondegenerate simplices and is injective on them, so Lemma 14.18.3 gives degreewise
-- injectivity, which is equivalent to being a monomorphism in `SSet`.
private theorem counit_mono (n : ℕ) (U : SSet.{u}) :
    Mono ((SSet.skAdj n).counit.app U) := by
  let ε : (SSet.sk n).obj U ⟶ U := (SSet.skAdj n).counit.app U
  have hPreserves :
      ∀ ⦃m : ℕ⦄ (x : ((SSet.sk n).obj U).nonDegenerate m),
        (((SSet.sk n).obj U).nonDegenerateSplitting.φ ε m) x ∈ U.nonDegenerate m := by
    intro m x
    -- Proof comment: the splitting map on nondegenerate simplices is the underlying component of
    -- the counit, so the source-faithful preservation statement is exactly the helper above.
    simpa [SSet.nonDegenerateSplitting, ε] using
      truncatedSkeleton_counit_maps_nondegenerate n U x
  have hInjective :
      ∀ m : ℕ, Function.Injective ((SSet.toNonDegenerateSplitHom ε hPreserves).f m) := by
    intro m x y hxy
    have hm : m ≤ n := truncatedSkeleton_nondegenerate_degree_le n U x
    haveI : IsIso (ε.app (op ⦋m⦌)) := truncatedSkeleton_counit_app_isIso_of_le n U hm
    have hεm_injective : Function.Injective (ε.app (op ⦋m⦌)) := by
      exact (mono_iff_injective _).1 inferInstance
    apply Subtype.ext
    exact hεm_injective (congrArg Subtype.val hxy)
  have hdegreewise :
      ∀ m : ℕ, Function.Injective (ε.app (op ⦋m⦌)) :=
    SSet.degreewise_injective_of_nondegenerate_injective (f := ε) hPreserves hInjective
  -- Proof comment: monomorphy in `SSet` is checked degreewise in `Type`.
  refine (NatTrans.mono_iff_mono_app ε).2 ?_
  intro Δ
  cases Δ with
  | op Δ =>
      cases Δ with
      | mk m =>
          rw [mono_iff_injective]
          exact hdegreewise m

-- Proof sketch: Lemma 14.18.4 identifies the textbook sub simplicial set `U'` with
-- `U.skeleton (n + 1)`. The counit is an isomorphism in degrees `≤ n`, and Lemma 14.21.4 shows
-- that every simplex in higher degree in its source is degenerate. Using the injectivity result
-- above, the image contains exactly the simplices generated by degrees `≤ n`, i.e. the
-- `(n + 1)`-skeleton.
/-- The image of the counit from the simplicial `n`-skeleton of `U` is exactly the
`(n + 1)`-skeleton subcomplex of `U`. -/
theorem truncatedSkeletonCounit_range_eq_skeleton (n : ℕ) (U : SSet.{u}) :
    SSet.Subcomplex.range ((SSet.skAdj n).counit.app U) = U.skeleton (n + 1) := by
  let ε : (SSet.sk n).obj U ⟶ U := (SSet.skAdj n).counit.app U
  ext Δ x
  cases Δ with
  | op Δ =>
      cases Δ with
      | mk m =>
          -- Proof comment: compare both subcomplexes degreewise using the explicit generator
          -- description of the skeleton from `Lemma 14.18.4`.
          simp only [SSet.Subcomplex.range, CategoryTheory.Subfunctor.range_obj, Set.mem_range]
          rw [skeleton_succ_obj_eq_generated_by_simplices_le U n m]
          constructor
          · rintro ⟨y, rfl⟩
            obtain ⟨i, f, _, z, rfl⟩ := ((SSet.sk n).obj U).exists_nonDegenerate y
            have hi : i ≤ n := truncatedSkeleton_nondegenerate_degree_le n U z
            refine ⟨i, hi, f, ?_⟩
            refine ⟨ε.app (op ⦋i⦌) z, ?_⟩
            simpa using (congrFun (ε.naturality f.op) z).symm
          · rintro ⟨i, hi, f, y, rfl⟩
            haveI : IsIso (ε.app (op ⦋i⦌)) := truncatedSkeleton_counit_app_isIso_of_le n U hi
            let z : ((SSet.sk n).obj U) _⦋i⦌ := inv (ε.app (op ⦋i⦌)) y
            have hz : ε.app (op ⦋i⦌) z = y := by
              simpa [z] using CategoryTheory.inv_hom_id_apply (asIso (ε.app (op ⦋i⦌))) y
            refine ⟨((SSet.sk n).obj U).map f.op z, ?_⟩
            calc
              ε.app (op ⦋m⦌) (((SSet.sk n).obj U).map f.op z) =
                  U.map f.op (ε.app (op ⦋i⦌) z) := by
                    simpa using congrFun (ε.naturality f.op) z
              _ = U.map f.op y := by
                    exact congrArg (U.map f.op) hz

/-- Lemma 14.21.5: the canonical morphism `i_{n!} sk_n U ⟶ U`, namely the counit
`((SSet.skAdj n).counit.app U)`, identifies `i_{n!} sk_n U` with the simplicial subset of `U`
generated by simplices in degrees at most `n`, i.e. with `(U.skeleton (n + 1) : SSet)`. -/
@[stacks 018P]
def truncatedSkeletonIsoSkeleton (n : ℕ) (U : SSet.{u}) :
    (SSet.sk n).obj U ≅ (U.skeleton (n + 1) : SSet) :=
  let ε : (SSet.sk n).obj U ⟶ U := (SSet.skAdj n).counit.app U
  let _ : Mono ε := counit_mono n U
  asIso (SSet.Subcomplex.toRange ε) ≪≫
    SSet.Subcomplex.eqToIso (truncatedSkeletonCounit_range_eq_skeleton n U)
