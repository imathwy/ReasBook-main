import Mathlib
import LinearRepresentations_Serre_1977.Chap07.Proposition_7_7_2_1
import LinearRepresentations_Serre_1977.Chap12.Proposition_12_12_1_1

open scoped Representation SubgroupInduction

noncomputable section

universe u v w

namespace Representation

section

variable {K : Type v} [Field K] [CharZero K]
variable {G : Type u} [Group G] [Finite G]

/-- CharacterRingOverFieldScalarExtension: LinearRepresentations_Serre_1977's `ℚ ⊗ R_K(G)`, realized canonically as the
`ℚ`-submodule of `K`-valued functions on `G` generated by `R_K(G)`. This is the shared owner
layer for the chapter's rationalized character-ring constructions. -/
def characterRingOverFieldScalarExtension (K : Type v) [Field K] [CharZero K]
    (G : Type u) [Group G] [Finite G] : Submodule ℚ (G → K) :=
  Submodule.span ℚ
    (((characterRingOverField K G).toSubmodule : Submodule ℤ (G → K)) : Set (G → K))

scoped[Representation] notation:max "ℚ" "⊗R" "[" K "](" G ")" =>
  characterRingOverFieldScalarExtension K G

/-- Every element of `R_K(G)` belongs to its rational scalar extension `ℚ ⊗ R_K(G)`. -/
theorem mem_characterRingOverFieldScalarExtension_of_mem_characterRingOverField
    {χ : G → K} (hχ : χ ∈ R[K](G)) :
    χ ∈ ℚ⊗R[K](G) := by
  exact Submodule.subset_span
    (show χ ∈ (((R[K](G)).toSubmodule : Submodule ℤ (G → K)) : Set (G → K)) by
      simpa using hχ)

omit [CharZero K] [Finite G] in
/-- Helper for CharacterRingOverFieldScalarExtension: every virtual `K`-character is an integral
linear combination of honest finite-dimensional `K`-characters. -/
theorem characterRing_mem_span_honest_characters
    (χ : G → K) (hχ : χ ∈ R[K](G)) :
    χ ∈ Submodule.span ℤ
      { ψ : G → K |
          ∃ (V : Type (max u v)) (_ : AddCommGroup V) (_ : Module K V)
            (_ : FiniteDimensional K V) (ρ : Representation K G V), ψ = ρ.character } := by
  let S : Set (G → K) :=
    { ψ : G → K |
        ∃ (V : Type (max u v)) (_ : AddCommGroup V) (_ : Module K V)
          (_ : FiniteDimensional K V) (ρ : Representation K G V), ψ = ρ.character }
  have hmul_span :
      ∀ {f g : G → K},
        f ∈ Submodule.span ℤ S →
        g ∈ Submodule.span ℤ S →
        f * g ∈ Submodule.span ℤ S := by
    intro f g hf hg
    have hfg : ∀ g : G → K, g ∈ Submodule.span ℤ S → f * g ∈ Submodule.span ℤ S := by
      induction hf using Submodule.span_induction with
      | mem ψ hψ =>
          rcases hψ with ⟨V, _instAddCommGroupV, _instModuleV, _instFiniteDimensionalV, ρ, rfl⟩
          intro g hg
          induction hg using Submodule.span_induction with
          | mem ξ hξ =>
              rcases hξ with ⟨W, _instAddCommGroupW, _instModuleW, _instFiniteDimensionalW, σ, rfl⟩
              let τ : Representation K G (TensorProduct K V W) := Representation.tprod ρ σ
              -- Tensor products realize pointwise products of honest characters.
              refine Submodule.subset_span ?_
              refine ⟨TensorProduct K V W, inferInstance, inferInstance, inferInstance, τ, ?_⟩
              ext x
              simpa [τ, Representation.character] using
                (LinearMap.trace_tensorProduct' (ρ x) (σ x)).symm
          | zero =>
              simp
          | add ξ ζ _ _ hξ hζ =>
              simpa [mul_add] using Submodule.add_mem (Submodule.span ℤ S) hξ hζ
          | smul n ξ _ hξ =>
              simpa [zsmul_eq_mul, mul_assoc, mul_left_comm, mul_comm] using
                Submodule.smul_mem (Submodule.span ℤ S) n hξ
      | zero =>
          intro g hg
          simp
      | add f₁ f₂ _ _ hf₁ hf₂ =>
          intro g hg
          simpa [add_mul] using
            Submodule.add_mem (Submodule.span ℤ S) (hf₁ g hg) (hf₂ g hg)
      | smul n f _ hf =>
          intro g hg
          simpa [zsmul_eq_mul, mul_left_comm, mul_assoc] using
            Submodule.smul_mem (Submodule.span ℤ S) n (hf g hg)
    exact hfg g hg
  -- The span of honest characters is a subalgebra containing the irreducible generators.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hχ
  · intro ψ hψ
    rcases hψ with ⟨ρ, hρfd, _hρirr, rfl⟩
    exact Submodule.subset_span ⟨ρ, inferInstance, inferInstance, hρfd, ρ.ρ, rfl⟩
  · intro n
    have htriv :
        (Representation.trivial K G (ULift.{u} K)).character ∈ S := by
      refine ⟨ULift.{u} K, inferInstance, inferInstance, inferInstance,
        Representation.trivial K G (ULift.{u} K), ?_⟩
      rfl
    have hscalar :
        algebraMap ℤ (G → K) n = n • (Representation.trivial K G (ULift.{u} K)).character := by
      ext g
      simp [Representation.character, Representation.trivial]
    rw [hscalar]
    exact Submodule.smul_mem (Submodule.span ℤ S) n (Submodule.subset_span htriv)
  · intro f g _ _ hf hg
    exact Submodule.add_mem (Submodule.span ℤ S) hf hg
  · intro f g _ _ hf hg
    exact hmul_span hf hg

/-- Every scalar-valued constant function belongs to LinearRepresentations_Serre_1977's rational scalar extension
`ℚ ⊗ R_K(G)`. -/
theorem algebraMap_mem_characterRingOverFieldScalarExtension (r : ℚ) :
    algebraMap ℚ (G → K) r ∈ ℚ⊗R[K](G) := by
  have htriv : (Representation.trivial K G K).character = (1 : G → K) := by
    ext g
    simp [Representation.character, Representation.trivial]
  have htriv_mem : (Representation.trivial K G K).character ∈ ℚ⊗R[K](G) := by
    exact mem_characterRingOverFieldScalarExtension_of_mem_characterRingOverField
      (Representation.trivialCharacterOverField_mem_characterRingOverField (K := K) G)
  have hone : (1 : G → K) ∈ ℚ⊗R[K](G) := by
    -- The unit character is the trivial character, so it already lies in the scalar extension.
    simpa [htriv] using htriv_mem
  -- Rewrite the constant function as a scalar multiple of the unit character.
  simpa [Pi.smul_apply, Algebra.smul_def] using
    (ℚ⊗R[K](G)).smul_mem r hone

/-- LinearRepresentations_Serre_1977's rational scalar extension `ℚ ⊗ R_K(G)` is closed under pointwise multiplication. -/
theorem mul_mem_characterRingOverFieldScalarExtension {f g : G → K}
    (hf : f ∈ ℚ⊗R[K](G))
    (hg : g ∈ ℚ⊗R[K](G)) :
    f * g ∈ ℚ⊗R[K](G) := by
  -- Induct separately over the two defining span witnesses.
  revert g hg
  induction hf using Submodule.span_induction with
  | mem ψ hψ =>
      intro g hg
      induction hg using Submodule.span_induction with
      | mem ξ hξ =>
          have hψ' : ψ ∈ R[K](G) := by
            simpa using hψ
          have hξ' : ξ ∈ R[K](G) := by
            simpa using hξ
          exact mem_characterRingOverFieldScalarExtension_of_mem_characterRingOverField
            ((R[K](G)).mul_mem hψ' hξ')
      | zero =>
          simp
      | add g₁ g₂ _ _ ih₁ ih₂ =>
          simpa [Pi.mul_apply, mul_add] using
            (ℚ⊗R[K](G)).add_mem ih₁ ih₂
      | smul a g _ ih =>
          simpa [Pi.mul_apply, Pi.smul_apply, Algebra.smul_def, mul_assoc, mul_left_comm,
            mul_comm] using
              (ℚ⊗R[K](G)).smul_mem a ih
  | zero =>
      intro g hg
      simp
  | add f₁ f₂ _ _ ih₁ ih₂ =>
      intro g hg
      simpa [Pi.mul_apply, add_mul] using
        (ℚ⊗R[K](G)).add_mem (ih₁ hg) (ih₂ hg)
  | smul a f _ ih =>
      intro g hg
      simpa [Pi.mul_apply, Pi.smul_apply, Algebra.smul_def, mul_assoc, mul_left_comm, mul_comm]
        using (ℚ⊗R[K](G)).smul_mem a (ih hg)

/-- The pointwise `ℚ`-subalgebra of `K`-valued functions on `G` whose carrier is
`Representation.characterRingOverFieldScalarExtension K G`. This is the canonical bridge/view of
the Chapter `12` owner `ℚ ⊗ R_K(G)` at the algebra level. -/
def characterRingOverFieldScalarExtensionSubalgebra
    (K : Type v) [Field K] [CharZero K] (G : Type u) [Group G] [Finite G] :
    Subalgebra ℚ (G → K) :=
  (characterRingOverFieldScalarExtension K G).toSubalgebra
    (by
      have h1 : algebraMap ℚ (G → K) (1 : ℚ) ∈ ℚ⊗R[K](G) :=
        algebraMap_mem_characterRingOverFieldScalarExtension 1
      simpa using h1)
    (fun _ _ ↦ mul_mem_characterRingOverFieldScalarExtension)

/-- Membership in the subalgebra view
`characterRingOverFieldScalarExtensionSubalgebra K G` is exactly membership in LinearRepresentations_Serre_1977's rational
scalar extension `ℚ ⊗ R_K(G)`. -/
theorem mem_characterRingOverFieldScalarExtensionSubalgebra_iff {f : G → K} :
    f ∈ characterRingOverFieldScalarExtensionSubalgebra K G ↔
      f ∈ ℚ⊗R[K](G) := by
  rfl

end

end Representation

namespace Subgroup

section

open Representation

variable {K : Type v} [Field K] [CharZero K]
variable {G : Type u} [Group G] [Finite G]

local instance instFintypeCharacterRingOverFieldScalarExtensionDomain : Fintype G :=
  Fintype.ofFinite G
local instance instFintypeCharacterRingOverFieldScalarExtensionSubgroup
    (H : Subgroup G) : Fintype H :=
  Fintype.ofFinite H

-- Proof sketch: write `χ ∈ R_K(H)` as an integral linear combination of irreducible
-- `K`-characters; the induction of each irreducible character is the character of the induced
-- representation of `G`, so the result lies in `R_K(G)`.
/-- Inducing a virtual `K`-character on a subgroup gives an element of `R_K(G)`. -/
theorem inducedClassFunction_mem_characterRingOverField
    (H : Subgroup G) (χ : R[K](H)) :
    Ind[H]((χ : H → K)) ∈ R[K](G) := by
  let S : Set (H → K) :=
    { ψ : H → K |
        ∃ (V : Type (max u v)) (_ : AddCommGroup V) (_ : Module K V)
          (_ : FiniteDimensional K V) (ρ : Representation K H V), ψ = ρ.character }
  have hχ_span : (χ : H → K) ∈ Submodule.span ℤ S := by
    -- First rewrite the subgroup virtual character as a `ℤ`-linear combination of honest ones.
    simpa [S] using
      Representation.characterRing_mem_span_honest_characters
        (K := K) (G := H) (χ := (χ : H → K)) χ.property
  let p : ∀ x : H → K, x ∈ Submodule.span ℤ S → Prop :=
    fun x _ ↦ Ind[H](x) ∈ R[K](G)
  -- Route correction: induction is additive, so span induction on honest characters is the stable
  -- way to transport subgroup induction into `R_K(G)`.
  have hp : p (χ : H → K) hχ_span := by
    refine Submodule.span_induction (s := S) (p := p) ?_ ?_ ?_ ?_ hχ_span
    · intro ψ hψ
      rcases hψ with ⟨V, _instAddCommGroupV, _instModuleV, _instFiniteDimensionalV, ρ, rfl⟩
      letI : NeZero (Nat.card H : K) := ⟨Nat.cast_ne_zero.mpr (Nat.card_pos.ne')⟩
      -- Honest subgroup characters induce to honest `G`-characters.
      change Ind[H](ρ.character) ∈ R[K](G)
      rw [Subgroup.inducedClassFunction_eq_character_ind (H := H) (K := K) ρ]
      let τ : Rep K G := Rep.ind H.subtype (Rep.of ρ)
      letI : FiniteDimensional K τ := by
        change FiniteDimensional K
          ((TensorProduct K (G →₀ K) V) ⧸
            Representation.Coinvariants.ker (k := K) (G := H)
              (V := TensorProduct K (G →₀ K) V)
              (Representation.tprod ((Representation.leftRegular K G).comp H.subtype) ρ))
        infer_instance
      simpa [τ] using
        (Representation.rep_character_mem_characterRingOverField
          (K := K) (G := G) τ)
    · change Ind[H]((0 : H → K)) ∈ R[K](G)
      have hzero : Ind[H]((0 : H → K)) = (0 : G → K) := by
        ext g
        simp [Subgroup.inducedClassFunction]
      rw [hzero]
      exact (R[K](G)).zero_mem
    · intro f g hf hg hf_mem hg_mem
      change Ind[H](f + g) ∈ R[K](G)
      simpa [Subgroup.inducedClassFunction_map_add] using (R[K](G)).add_mem hf_mem hg_mem
    · intro n f hf hf_mem
      change Ind[H](n • f) ∈ R[K](G)
      rw [Subgroup.inducedClassFunction_map_smul (S := ℤ) (H := H) n f]
      exact (R[K](G)).toSubmodule.smul_mem n hf_mem
  exact hp

/-- The canonical `ℤ`-linear induction map `R_K(H) → R_K(G)`. It is the codomain restriction of
the class-function induction owner `H.classFunctionInduction`. -/
def characterRingOverFieldInduction (H : Subgroup G) (K : Type v) [Field K] [CharZero K] :
    R[K](H) →ₗ[ℤ] R[K](G) :=
  LinearMap.codRestrict
    (R[K](G)).toSubmodule
    ((((classFunctionSubmodule K G).subtype.comp H.classFunctionInduction).restrictScalars ℤ).comp
      (R[K](H)).toSubmodule.subtype)
    (inducedClassFunction_mem_characterRingOverField H)

/-- Evaluating the subgroup induction map gives the induced `K`-valued class function. -/
@[simp] theorem characterRingOverFieldInduction_apply
    (H : Subgroup G) (χ : R[K](H)) :
    ((characterRingOverFieldInduction H K χ : R[K](G)) : G → K) = Ind[H]((χ : H → K)) :=
  rfl

end

end Subgroup

namespace Representation

section

variable {K : Type v} [Field K] [CharZero K]
variable {G : Type u} [Group G] [Finite G]

local instance instFintypeCharacterRingOverFieldAlgebraScalarExtensionDomain : Fintype G :=
  Fintype.ofFinite G
local instance instFintypeCharacterRingOverFieldAlgebraScalarExtensionSubgroup
    (H : Subgroup G) : Fintype H :=
  Fintype.ofFinite H

/-- The canonical owner submodule of `R_K(G)` generated by the subgroup-induction maps
`R_K(H) → R_K(G)` for `H ∈ X`. -/
def inducedCharacterSubmoduleOverField (K : Type v) [Field K] [CharZero K]
    (X : Finset (Subgroup G)) : Submodule ℤ R[K](G) :=
  ⨆ H : X, LinearMap.range (H.1.characterRingOverFieldInduction K)

end

section ScalarExtensionOverAlgebra

variable {A : Type v} [CommRing A]
variable {K : Type w} [Field K] [CharZero K] [Algebra A K]
variable {G : Type u} [Group G] [Finite G]

/-- LinearRepresentations_Serre_1977's `A ⊗ R_K(G)`, realized canonically as the `A`-submodule of `K`-valued functions on
`G` generated by `R_K(G)`. This is the chapter owner layer for scalar extension of `R_K(G)` along
`A → K`. -/
def characterRingOverFieldAlgebraScalarExtension
    (A : Type v) [CommRing A] (K : Type w) [Field K] [CharZero K] [Algebra A K]
    (G : Type u) [Group G] [Finite G] : Submodule A (G → K) :=
  Submodule.span A
    (((R[K](G)).toSubmodule : Submodule ℤ (G → K)) : Set (G → K))

scoped[Representation] notation:max A " ⊗R[" K "](" G ")" =>
  characterRingOverFieldAlgebraScalarExtension A K G

-- Proof sketch: `χ` is one of the generators of the `A`-span defining
-- `characterRingOverFieldAlgebraScalarExtension A K G`.
/-- Every virtual `K`-character belongs to its scalar extension from `ℤ` to `A`. -/
theorem mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
    {χ : G → K} (hχ : χ ∈ R[K](G)) :
    χ ∈ A ⊗R[K](G) := by
  exact Submodule.subset_span
    (show χ ∈ (((R[K](G)).toSubmodule : Submodule ℤ (G → K)) : Set (G → K)) by
      simpa using hχ)

/-- Every scalar-valued constant function belongs to LinearRepresentations_Serre_1977's scalar extension `A ⊗ R_K(G)`. -/
theorem algebraMap_mem_characterRingOverFieldAlgebraScalarExtension (a : A) :
    algebraMap A (G → K) a ∈ A ⊗R[K](G) := by
  have htriv : (Representation.trivial K G K).character = (1 : G → K) := by
    ext g
    simp [Representation.character, Representation.trivial]
  have htriv_mem : (Representation.trivial K G K).character ∈ A ⊗R[K](G) := by
    exact mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
      (A := A)
      (Representation.trivialCharacterOverField_mem_characterRingOverField (K := K) G)
  have hone : (1 : G → K) ∈ A ⊗R[K](G) := by
    -- The unit character is the trivial character, so it already lies in the scalar extension.
    simpa [htriv] using htriv_mem
  -- Rewrite the constant function as a scalar multiple of the unit character.
  simpa [Pi.smul_apply, Algebra.smul_def] using
    (A ⊗R[K](G)).smul_mem a hone

/-- LinearRepresentations_Serre_1977's scalar extension `A ⊗ R_K(G)` is closed under pointwise multiplication. -/
theorem mul_mem_characterRingOverFieldAlgebraScalarExtension {f g : G → K}
    (hf : f ∈ A ⊗R[K](G))
    (hg : g ∈ A ⊗R[K](G)) :
    f * g ∈ A ⊗R[K](G) := by
  -- Induct separately over the two defining span witnesses.
  revert g hg
  induction hf using Submodule.span_induction with
  | mem ψ hψ =>
      intro g hg
      induction hg using Submodule.span_induction with
      | mem ξ hξ =>
          have hψ' : ψ ∈ R[K](G) := by
            simpa using hψ
          have hξ' : ξ ∈ R[K](G) := by
            simpa using hξ
          exact mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
            ((R[K](G)).mul_mem hψ' hξ')
      | zero =>
          simp
      | add g₁ g₂ _ _ ih₁ ih₂ =>
          simpa [Pi.mul_apply, mul_add] using
            (A ⊗R[K](G)).add_mem ih₁ ih₂
      | smul a g _ ih =>
          simpa [Pi.mul_apply, Pi.smul_apply, Algebra.smul_def, mul_assoc, mul_left_comm,
            mul_comm] using
              (A ⊗R[K](G)).smul_mem a ih
  | zero =>
      intro g hg
      simp
  | add f₁ f₂ _ _ ih₁ ih₂ =>
      intro g hg
      simpa [Pi.mul_apply, add_mul] using
        (A ⊗R[K](G)).add_mem (ih₁ hg) (ih₂ hg)
  | smul a f _ ih =>
      intro g hg
      simpa [Pi.mul_apply, Pi.smul_apply, Algebra.smul_def, mul_assoc, mul_left_comm, mul_comm]
        using (A ⊗R[K](G)).smul_mem a (ih hg)

/-- The pointwise `A`-subalgebra of `K`-valued functions on `G` whose carrier is
`Representation.characterRingOverFieldAlgebraScalarExtension A K G`. This is the canonical
bridge/view of the Chapter `12` owner `A ⊗ R_K(G)` at the algebra level. -/
def characterRingOverFieldAlgebraScalarExtensionSubalgebra
    (A : Type v) [CommRing A] (K : Type w) [Field K] [CharZero K] [Algebra A K]
    (G : Type u) [Group G] [Finite G] : Subalgebra A (G → K) :=
  (characterRingOverFieldAlgebraScalarExtension A K G).toSubalgebra
    (by
      have h1 : algebraMap A (G → K) (1 : A) ∈ A ⊗R[K](G) :=
        algebraMap_mem_characterRingOverFieldAlgebraScalarExtension 1
      simpa using h1)
    (fun _ _ ↦ mul_mem_characterRingOverFieldAlgebraScalarExtension)

/-- Membership in the subalgebra view
`characterRingOverFieldAlgebraScalarExtensionSubalgebra A K G` is exactly membership in LinearRepresentations_Serre_1977's
scalar extension `A ⊗ R_K(G)`. -/
theorem mem_characterRingOverFieldAlgebraScalarExtensionSubalgebra_iff {f : G → K} :
    f ∈ characterRingOverFieldAlgebraScalarExtensionSubalgebra A K G ↔
      f ∈ A ⊗R[K](G) := by
  rfl

end ScalarExtensionOverAlgebra

end Representation

namespace Subgroup

section

open Representation

variable {K : Type v} [Field K] [CharZero K]
variable {G : Type u} [Group G] [Finite G]

local instance instFintypeCharacterRingOverFieldAlgebraScalarExtensionInductionDomain :
    Fintype G :=
  Fintype.ofFinite G
local instance instFintypeCharacterRingOverFieldAlgebraScalarExtensionInductionSubgroup
    (H : Subgroup G) : Fintype H :=
  Fintype.ofFinite H

variable {A : Type w} [CommRing A]
variable [Algebra A K]

-- Proof sketch: `A ⊗ R_K(H)` is the `A`-span of the image of `R_K(H)` in the ambient function
-- space `H → K`; induction is `A`-linear after restricting scalars from `K` to `A`, and it sends
-- each generator coming from `R_K(H)` into `R_K(G) ⊆ A ⊗ R_K(G)`.
/-- The canonical linear induction operator sends `A ⊗ R_K(H)` into `A ⊗ R_K(G)`. -/
theorem inducedClassFunction_mem_characterRingOverFieldAlgebraScalarExtension
    (H : Subgroup G) (χ : A ⊗R[K](H)) :
    Ind[H]((χ : H → K)) ∈ A ⊗R[K](G) := by
  let S := (((R[K](H)).toSubmodule : Submodule ℤ (H → K)) : Set (H → K))
  let p : ∀ x : H → K, x ∈ Submodule.span A S → Prop :=
    fun x _ ↦ Ind[H](x) ∈ A ⊗R[K](G)
  -- Induct over the defining `A`-span on `H`, reducing to the field-level induction theorem.
  have hp : p (χ : H → K) χ.2 := by
    refine Submodule.span_induction (s := S) (p := p) ?_ ?_ ?_ ?_ χ.2
    · intro ψ hψ
      have hψ' : ψ ∈ R[K](H) := by
        simpa [S] using hψ
      change Ind[H](ψ) ∈ A ⊗R[K](G)
      exact
        mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
          (A := A)
          (Subgroup.inducedClassFunction_mem_characterRingOverField H ⟨ψ, hψ'⟩)
    · change Ind[H]((0 : H → K)) ∈ A ⊗R[K](G)
      have hzero : Ind[H]((0 : H → K)) = (0 : G → K) := by
        ext g
        simp [Subgroup.inducedClassFunction]
      rw [hzero]
      exact zero_mem (A ⊗R[K](G))
    · intro f g hf hg hf_mem hg_mem
      change Ind[H](f + g) ∈ A ⊗R[K](G)
      simpa [Subgroup.inducedClassFunction_map_add] using (A ⊗R[K](G)).add_mem hf_mem hg_mem
    · intro a f hf hf_mem
      change Ind[H](a • f) ∈ A ⊗R[K](G)
      rw [Subgroup.inducedClassFunction_map_smul]
      exact (A ⊗R[K](G)).smul_mem a hf_mem
  exact hp

/-- The canonical `A`-linear induction map `A ⊗ R_K(H) → A ⊗ R_K(G)`. -/
def characterRingOverFieldAlgebraScalarExtensionInduction
    (H : Subgroup G) :
    (A ⊗R[K](H)) →ₗ[A] A ⊗R[K](G) :=
  LinearMap.codRestrict
    (A ⊗R[K](G))
    ((((classFunctionSubmodule K G).subtype.comp H.classFunctionInduction).restrictScalars A).comp
      (A ⊗R[K](H)).subtype)
    (inducedClassFunction_mem_characterRingOverFieldAlgebraScalarExtension H)

/-- Evaluating the subgroup induction map gives the induced `K`-valued class function. -/
@[simp] theorem characterRingOverFieldAlgebraScalarExtensionInduction_apply
    (H : Subgroup G) (χ : A ⊗R[K](H)) :
    ↑(characterRingOverFieldAlgebraScalarExtensionInduction H χ) = Ind[H]((χ : H → K)) := by
  rfl

end

end Subgroup
