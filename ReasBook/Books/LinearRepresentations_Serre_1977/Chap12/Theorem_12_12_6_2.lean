variable {L : Type w} [Field L] [NumberField L]
variable [IsCyclotomicExtension {Monoid.exponent G} ℚ L]
variable (K : IntermediateField ℚ L)

local notation "ΓK" => Γ[K](G)

/-- LinearRepresentations_Serre_1977's fixed-`p` subgroup `V_{K,p} ≤ R_K(G)`, generated by induction from the
`Γ_K`-`p`-elementary subgroups of `G`. -/
private abbrev gammaPElementaryInducedCharacterSpan_local (p : ℕ) : Submodule ℤ R[K](G) :=
  let _ : DecidablePred (fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H) :=
    Classical.decPred _
  inducedCharacterSubmoduleOverField K
    (Finset.univ.filter fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H)

/-- Helper for Theorem 12-12.6-2: restricting a virtual `K`-character of `G` to a subgroup again
lands in the corresponding subgroup character ring. -/
private theorem restrict_mem_characterRingOverField_local
    (H : Subgroup G) (χ : R[K](G)) :
    (fun h : H ↦ (χ : G → K) h) ∈ R[K](H) := by
  -- Restrict the adjoin presentation of `χ` term-by-term along the subgroup inclusion.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ χ.property
  · intro ψ hψ
    rcases hψ with ⟨ρ, hρfd, -, rfl⟩
    letI : FiniteDimensional K ρ := hρfd
    change (Rep.res H.subtype ρ).ρ.character ∈ R[K](H)
    letI : FiniteDimensional K (Rep.res H.subtype ρ) := inferInstance
    exact Representation.rep_character_mem_characterRingOverField (Rep.res H.subtype ρ)
  · intro n
    exact (R[K](H)).algebraMap_mem n
  · intro f g _ _ hf hg
    simpa using (R[K](H)).add_mem hf hg
  · intro f g _ _ hf hg
    simpa using (R[K](H)).mul_mem hf hg

/-- Helper for Theorem 12-12.6-2: multiplying an induced `K`-valued class function by an ambient
virtual `K`-character amounts to inducing the pointwise product with the restricted character. -/
private theorem induced_mul_eq_induced_mul_restriction_local
    (H : Subgroup G) (ψ : H → K) (χ : R[K](G)) :
    Ind[H](ψ) * (χ : G → K) = Ind[H](fun h : H ↦ ψ h * χ h) := by
  classical
  ext x
  have hk : ((Ind[H](ψ) * (χ : G → K)) x : K) = (Ind[H](fun h : H ↦ ψ h * χ h) x : K) := by
    simp only [Pi.mul_apply, Subgroup.inducedClassFunction]
    rw [mul_assoc, Finset.sum_mul]
    have htermsK :
        ∀ s ∈ (Finset.univ : Finset G),
          ((if hs : s⁻¹ * x * s ∈ H then ψ ⟨s⁻¹ * x * s, hs⟩ else 0 : K) * (χ : G → K) x) =
            (if hs : s⁻¹ * x * s ∈ H then
              ψ ⟨s⁻¹ * x * s, hs⟩ * (χ : G → K) (s⁻¹ * x * s) else 0 : K) := by
      intro s hs_univ
      by_cases hs : s⁻¹ * x * s ∈ H
      · -- Replace the ambient character value by its conjugacy-invariant translate.
        have hs' : s⁻¹ * (x * s) ∈ H := by
          simpa [mul_assoc] using hs
        have hχ :
            (χ : G → K) (s⁻¹ * x * s) = (χ : G → K) x := by
          exact (Representation.isClassFunction_of_mem_characterRingOverField
            (K := K) (χ : G → K) χ.property).eq_of_isConj <| isConj_iff.2 ⟨s, by group⟩
        have hχ' : (χ : G → K) (s⁻¹ * (x * s)) = (χ : G → K) x := by
          simpa [mul_assoc] using hχ
        simp [hs', hχ', mul_comm, mul_assoc]
      · simp [hs]
    exact congrArg (fun z : K ↦ ((Nat.card H : K)⁻¹) * z) (Finset.sum_congr rfl htermsK)
  exact congrArg (fun z : K ↦ (z : L)) hk

/-- Helper for Theorem 12-12.6-2: the fixed-`p` span `V_{K,p}` is stable under multiplication by
an arbitrary ambient virtual `K`-character. -/
private theorem mul_mem_gammaPElementaryInducedCharacterSpan
    (p : ℕ) {χ ψ : R[K](G)}
    (hψ : ψ ∈ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) :
    χ * ψ ∈ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p := by
  classical
  let _ : DecidablePred (fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H) :=
    Classical.decPred _
  change χ * ψ ∈ inducedCharacterSubmoduleOverField K
    (Finset.univ.filter fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H)
  change ψ ∈ inducedCharacterSubmoduleOverField K
    (Finset.univ.filter fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H) at hψ
  -- As in Chapter `10`, it is enough to check stability on each subgroup-induction generator.
  refine Submodule.iSup_induction
      (p := fun H :
        {H : Subgroup G // H ∈
          Finset.filter (fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H) Finset.univ} ↦
          LinearMap.range (H.1.characterRingOverFieldInduction K))
      (motive := fun ξ : R[K](G) ↦
        χ * ξ ∈ inducedCharacterSubmoduleOverField K
          (Finset.univ.filter fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H))
      hψ ?_ ?_ ?_
  · intro H ξ hξ
    rcases H with ⟨H, hHmem⟩
    rcases hξ with ⟨η, rfl⟩
    have hprod : (fun h : H ↦ ((η : H → K) h) * ((χ : G → K) h)) ∈ R[K](H) := by
      -- Restrict the ambient character to `H`, then multiply inside the subgroup character ring.
      exact (R[K](H)).mul_mem η.property
        (restrict_mem_characterRingOverField_local (K := K) H χ)
    let ζ : R[K](H) :=
      ⟨fun h : H ↦ ((η : H → K) h) * ((χ : G → K) h), hprod⟩
    have hζ :
        χ * H.characterRingOverFieldInduction K η =
          H.characterRingOverFieldInduction K ζ := by
      -- Compare the two virtual characters pointwise using the induction-product identity.
      apply Subtype.ext
      ext g
      have hind := congrFun (induced_mul_eq_induced_mul_restriction_local
        (K := K) H (η : H → K) χ) g
      simpa [ζ, Subgroup.characterRingOverFieldInduction_apply, mul_comm] using
        congrArg (fun z : K ↦ (z : L)) hind
    refine hζ ▸ ?_
    exact
      (show LinearMap.range (H.characterRingOverFieldInduction K) ≤
          inducedCharacterSubmoduleOverField K
            (Finset.univ.filter fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H) from
        le_iSup
          (fun J :
            {J : Subgroup G // J ∈
              Finset.filter (fun J : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p J) Finset.univ} ↦
            LinearMap.range (J.1.characterRingOverFieldInduction K))
          ⟨H, hHmem⟩) ⟨ζ, rfl⟩
  · simp
  · intro ξ η hξ hη
    -- The target span is a submodule, so it is closed under addition.
    simpa [mul_add] using Submodule.add_mem _ hξ hη

/-- Helper for Theorem 12-12.6-2: taking a power by an exponent unit preserves `p`-regularity
because it preserves the order of the underlying element. -/
private theorem isPRegular_pow_galoisPowerExponentUnit_iff_local
    (p : ℕ) (t : (ZMod (Monoid.exponent G))ˣ) {x : G} :
    IsPRegular p (x ^ galoisPowerExponentUnit t) ↔ IsPRegular p x := by
  -- The exponent attached to a unit is coprime to `orderOf x`, so `orderOf (x ^ t) = orderOf x`.
  have hcop :
      Nat.Coprime (orderOf x) (galoisPowerExponentUnit t) :=
    (Nat.Coprime.of_dvd_right (Monoid.order_dvd_exponent x)
      (ZMod.val_coe_unit_coprime t)).symm
  simpa [IsPRegular, hcop.orderOf_pow]

/-- Helper for Theorem 12-12.6-2: the `L`-valued `p`-regular indicator is a class function on
`G`. -/
private theorem pregular_indicator_isClassFunction
    (p : ℕ) :
    _root_.IsClassFunction (fun s : G ↦ if IsPRegular p s then (1 : L) else 0) := by
  -- Conjugation preserves `p`-regularity, so the indicator is constant on conjugacy classes.
  refine ⟨?_⟩
  intro s t hst
  change (if IsPRegular p s then (1 : L) else 0) = if IsPRegular p t then (1 : L) else 0
  rcases isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hst) with ⟨u, hu⟩
  have hforward : IsPRegular p s → IsPRegular p t := by
    intro hs
    rw [← hu]
    exact isPRegular_conj p s u hs
  have hback : IsPRegular p t → IsPRegular p s := by
    intro ht
    have hs_eq : u⁻¹ * t * u = s := by
      rw [← hu]
      group
    rw [← hs_eq]
    simpa using isPRegular_conj p t u⁻¹ ht
  by_cases hs : IsPRegular p s
  · have ht : IsPRegular p t := hforward hs
    rw [if_pos hs, if_pos ht]
  · have ht : ¬ IsPRegular p t := by
      intro ht
      exact hs (hback ht)
    rw [if_neg hs, if_neg ht]

/-- Helper for Theorem 12-12.6-2: the `L`-valued `p`-regular indicator is compatible with LinearRepresentations_Serre_1977's
`Γ_K`-power action. -/
private theorem pregular_indicator_galois_compatible
    (p : Nat.Primes) :
    ∀ s : G, ∀ t : ΓK,
      t • (if IsPRegular (p : ℕ) s then (1 : L) else 0) =
        (if IsPRegular (p : ℕ) (s ^ t) then (1 : L) else 0) := by
  -- Route correction: prove compatibility by reducing both sides to the same `p`-regularity test
  -- via preservation of element order under exponent units.
  intro s t
  have hs :
      IsPRegular (p : ℕ) (s ^ t) ↔ IsPRegular (p : ℕ) s := by
    rw [pow_subgroup_eq_pow_nat]
    exact isPRegular_pow_galoisPowerExponentUnit_iff_local
      (G := G) (p := (p : ℕ)) (t := (t : (ZMod (Monoid.exponent G))ˣ))
  by_cases hreg : IsPRegular (p : ℕ) s
  · have hreg' : IsPRegular (p : ℕ) (s ^ t) := hs.2 hreg
    rw [if_pos hreg, if_pos hreg']
    simpa using (smul_one t : t • (1 : L) = 1)
  · have hreg' : ¬ IsPRegular (p : ℕ) (s ^ t) := by
      intro hs'
      exact hreg (hs.1 hs')
    rw [if_neg hreg, if_neg hreg']
    simpa using (smul_zero t : t • (0 : L) = 0)

/-- Helper for Theorem 12-12.6-2: the `L`-valued `p`-regular indicator belongs to the `K`-span of
ordinary `L`-valued characters. -/
private theorem pregular_indicator_mem_K_span_of_characters
    (p : Nat.Primes) :
    let δ : classFunctionSubmodule L G :=
      ⟨fun s : G ↦ if IsPRegular (p : ℕ) s then (1 : L) else 0,
        (mem_classFunctionSubmodule_iff L _).2
          (pregular_indicator_isClassFunction (G := G) (L := L) (p := (p : ℕ)))⟩
    (δ : G → L) ∈ Submodule.span K ((R[L](G) : Set (G → L))) := by
  let δ : classFunctionSubmodule L G :=
    ⟨fun s : G ↦ if IsPRegular (p : ℕ) s then (1 : L) else 0,
      (mem_classFunctionSubmodule_iff L _).2
        (pregular_indicator_isClassFunction (G := G) (L := L) (p := (p : ℕ)))⟩
  -- Descend the pointwise compatibility criterion through Theorem `12-12.4-1`.
  exact
    (Representation.classFunction_mem_characterRingOverFieldScalarExtension_map_iff_galoisCompatible
      (G := G) (L := L) (K := K) δ).2
      (pregular_indicator_galois_compatible (G := G) (L := L) (K := K) p)

/-- Helper for Theorem 12-12.6-2: every element of LinearRepresentations_Serre_1977's realized scalar extension
`A ⊗ R_K(G)` is constant on `Γ_K`-power classes. -/
private theorem isConstantOnGaloisPowerClasses_of_mem_characterRingOverFieldAlgebraScalarExtension_local
    {A : Type v} [CommRing A] [Algebra A K] {f : G → K}
    (hf : f ∈ characterRingOverFieldAlgebraScalarExtension A K G) :
    IsConstantOnGaloisPowerClasses ΓK f := by
  have hfClass : _root_.IsClassFunction f := by
    induction hf using Submodule.span_induction with
    | mem ψ hψ =>
        exact isClassFunction_of_mem_characterRingOverField ψ (by simpa using hψ)
    | zero =>
        simpa using (inferInstance : _root_.IsClassFunction (fun _ : G ↦ (0 : K)))
    | add f g _ _ hf hg =>
        letI : _root_.IsClassFunction f := hf
        letI : _root_.IsClassFunction g := hg
        simpa using (inferInstance : _root_.IsClassFunction (f + g))
    | smul a f _ hf =>
        letI : _root_.IsClassFunction f := hf
        simpa using (inferInstance : _root_.IsClassFunction (a • f))
  refine (isConstantOnGaloisPowerClasses_iff_forall_pow_eq hfClass).2 ?_
  let φ : classFunctionSubmodule K G :=
    ⟨f, (mem_classFunctionSubmodule_iff K f).2 hfClass⟩
  have hscalar :
      f ∈ characterRingOverFieldAlgebraScalarExtension K K G := by
    have hle :
        characterRingOverFieldAlgebraScalarExtension A K G ≤
          (characterRingOverFieldAlgebraScalarExtension K K G).restrictScalars A := by
      refine Submodule.span_le.2 ?_
      intro ψ hψ
      exact mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
        (A := K) (K := K) (G := G) (by simpa using hψ)
    exact hle hf
  simpa using
    (classFunction_mem_characterRingOverFieldScalarExtension_iff_gammaSubgroup_invariant
      (G := G) (L := L) K φ).1 hscalar

/-- Helper for Theorem 12-12.6-2: view `V_{K,p}` as `K`-valued functions on `G`. -/
private abbrev gammaPElementaryInducedCharacterToFunction_local
    (p : ℕ) :
    gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p →ₗ[ℤ] G → K :=
  ((R[K](G)).toSubmodule.subtype).comp
    (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype

/-- Helper for Theorem 12-12.6-2: realize the scalar extension `A ⊗ V_{K,p}` as `K`-valued
functions on `G`. -/
private abbrev tensorGammaPElementaryInducedCharacterToFunction_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ) :
    TensorProduct ℤ A (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) →ₗ[A] G → K :=
  (gammaPElementaryInducedCharacterToFunction_local (K := K) (G := G) p).liftBaseChange A

/-- Helper for Theorem 12-12.6-2: LinearRepresentations_Serre_1977's realized scalar extension of `V_{K,p}` inside the
ambient `K`-valued class functions on `G`. -/
private def gammaPElementaryInducedCharacterScalarExtension_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ) :
    Submodule A (G → K) :=
  LinearMap.range
    (tensorGammaPElementaryInducedCharacterToFunction_local
      (K := K) (G := G) (A := A) p)

/-- Helper for Theorem 12-12.6-2: every element of `V_{K,p}` becomes a realized element of its
scalar extension via the pure tensor `1 ⊗ χ`. -/
private theorem mem_gammaPElementaryInducedCharacterScalarExtension_of_mem_gammaPImage_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ) {χ : R[K](G)}
    (hχ : χ ∈ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) :
    (χ : G → K) ∈
      gammaPElementaryInducedCharacterScalarExtension_local
        (K := K) (G := G) (A := A) p := by
  let ψ :
      TensorProduct ℤ A (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) :=
    (1 : A) ⊗ₜ[ℤ] (⟨χ, hχ⟩ : gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p)
  have hψ :
      tensorGammaPElementaryInducedCharacterToFunction_local
          (K := K) (G := G) (A := A) p ψ =
        χ := by
    -- The pure tensor `1 ⊗ χ` evaluates back to the original `K`-valued function `χ`.
    ext g
    simp [ψ, tensorGammaPElementaryInducedCharacterToFunction_local,
      gammaPElementaryInducedCharacterToFunction_local]
  exact ⟨ψ, by simp [hψ]⟩

/-- Helper for Theorem 12-12.6-2: the realized scalar extension of `V_{K,p}` sits inside the
ambient scalar extension `A ⊗ R_K(G)`. -/
private theorem
    gammaP_scalarExtension_le_characterRingScalarExtension_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ) :
    gammaPElementaryInducedCharacterScalarExtension_local
        (K := K) (G := G) (A := A) p ≤
      characterRingOverFieldAlgebraScalarExtension A K G := by
  rintro _ ⟨χ, rfl⟩
  -- Compare the realized tensor generator with the ambient scalar extension term-by-term.
  induction χ using TensorProduct.induction_on with
  | zero =>
      exact zero_mem _
  | tmul a χ =>
      simpa [tensorGammaPElementaryInducedCharacterToFunction_local,
        gammaPElementaryInducedCharacterToFunction_local] using
        (characterRingOverFieldAlgebraScalarExtension A K G).smul_mem a
          (mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
            (A := A) (K := K) (G := G)
            (hχ := (((χ : gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) :
              R[K](G))).property))
  | add χ ψ hχ hψ =>
      simpa [map_add] using
        (characterRingOverFieldAlgebraScalarExtension A K G).add_mem hχ hψ

/-- Helper for Theorem 12-12.6-2: an integral coefficient ring inside `K` is faithfully flat over
`ℤ`, so tensoring with it reflects the vanishing of quotient classes. -/
private theorem integral_closure_faithfullyFlat_over_int_for_gammaP_local
    {A : Type v} [CommRing A] [Algebra A K] [IsIntegralClosure A ℤ ↥K] :
    Module.FaithfullyFlat ℤ A := by
  letI : Algebra A ↥K := by
    change Algebra A K
    infer_instance
  let f : A →+* ↥K := algebraMap A ↥K
  have hAK : Function.Injective f := by
    let hIC : IsIntegralClosure A ℤ ↥K := inferInstance
    simpa [f] using
      hIC.algebraMap_injective
  letI : IsDomain A := Function.Injective.isDomain f hAK
  -- The algebra map `ℤ → A` is injective because composing with `A → K` gives the usual
  -- injective integer embedding into the characteristic-zero field `K`.
  have hZA : Function.Injective (algebraMap ℤ A) := by
    intro m n hmn
    have hmn' := congrArg f hmn
    rw [← IsScalarTower.algebraMap_apply ℤ A K m, ← IsScalarTower.algebraMap_apply ℤ A K n] at hmn'
    exact Int.cast_injective hmn'
  letI : Module.IsTorsionFree ℤ A :=
    (Module.isTorsionFree_iff_algebraMap_injective).2 hZA
  haveI : Algebra.IsIntegral ℤ A :=
    IsIntegralClosure.isIntegral_algebra (A := A) (R := ℤ) (B := ↥K)
  -- Integral extensions are surjective on prime spectra, so torsion-free flatness upgrades to
  -- faithful flatness.
  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap ℤ A)) := by
    exact Algebra.IsIntegral.comap_surjective ℤ A
  exact Module.FaithfullyFlat.of_comap_surjective hsurj

/-- Helper for Theorem 12-12.6-2: once the pure tensor `1 ⊗ x` vanishes in the quotient
`A ⊗ (R_K(G) / V_{K,p})`, faithful flatness forces the original quotient class to vanish. -/
private theorem quotient_eq_zero_of_one_tmul_eq_zero_local
    {A : Type v} [CommRing A] [Algebra A K] [IsIntegralClosure A ℤ ↥K]
    (p : ℕ)
    (x : R[K](G) ⧸ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p)
    (hx : (1 : A) ⊗ₜ[ℤ] x = 0) :
    x = 0 := by
  letI : Module.FaithfullyFlat ℤ A :=
    integral_closure_faithfullyFlat_over_int_for_gammaP_local K (A := A)
  -- Faithful flatness reflects zero from the scalar-extended quotient back to the original one.
  exact
    (Module.FaithfullyFlat.one_tmul_eq_zero_iff
      (R := ℤ)
      (M := R[K](G) ⧸ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p)
      (A := A) x).mp hx

/-- Helper for Theorem 12-12.6-2: identify `R_K(G)` with its underlying `ℤ`-submodule of
`K`-valued functions on `G`. -/
private abbrev characterRing_toSubmodule_local :
    R[K](G) →ₗ[ℤ] (R[K](G)).toSubmodule :=
  show R[K](G) →ₗ[ℤ] (R[K](G)).toSubmodule from
    (show R[K](G) ≃ₗ[ℤ] (R[K](G)).toSubmodule from
      LinearEquiv.refl ℤ R[K](G)).toLinearMap

/-- Helper for Theorem 12-12.6-2: the ambient inclusion of the character ring into the function
space `G → K`. -/
private abbrev characterRing_toFunction_local :
    R[K](G) →ₗ[ℤ] G → K :=
  ((R[K](G)).toSubmodule.subtype).comp
    (characterRing_toSubmodule_local (K := K) (G := G))

/-- Helper for Theorem 12-12.6-2: viewing `V_{K,p}` inside `G → K` factors through the ambient
character-ring inclusion. -/
private theorem
    gammaPElementaryInducedCharacterToFunction_eq_characterRing_toFunction_comp_subtype_local
    (p : ℕ) :
    gammaPElementaryInducedCharacterToFunction_local (K := K) (G := G) p =
      (characterRing_toFunction_local (K := K) (G := G)).comp
        (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype := by
  -- Both maps simply forget the `V_{K,p}` witness and evaluate the same underlying function.
  ext χ g
  rfl

/-- Helper for Theorem 12-12.6-2: tensoring the ambient inclusion `R_K(G) ↪ G → K` with an
integral coefficient ring keeps it injective. -/
private theorem lTensor_characterRing_toFunction_injective_local
    {A : Type v} [CommRing A] [Algebra A K] [IsIntegralClosure A ℤ ↥K] :
    Function.Injective
      (LinearMap.lTensor A (characterRing_toFunction_local (K := K) (G := G))) := by
  letI : Module.Flat ℤ A :=
    (integral_closure_faithfullyFlat_over_int_for_gammaP_local K (A := A)).toFlat
  have hchar :
      Function.Injective (characterRing_toFunction_local (K := K) (G := G)) := by
    intro χ ψ hχψ
    exact Subtype.ext hχψ
  -- Flat base change preserves injectivity of the ambient character-ring inclusion.
  exact
    Module.Flat.lTensor_preserves_injective_linearMap (M := A)
      (characterRing_toFunction_local (K := K) (G := G)) hchar

/-- Helper for Theorem 12-12.6-2: the ambient owner `A ⊗ R_K(G)` realized as `K`-valued
functions through the canonical tensor-to-span map. -/
private abbrev tensorCharacterRingToFunction_local
    {A : Type v} [CommRing A] [Algebra A K] :
    TensorProduct ℤ A (R[K](G)) →ₗ[A] G → K :=
  (characterRingOverFieldAlgebraScalarExtension A K G).subtype.comp
    (((R[K](G)).toSubmodule).tensorToSpan A)

/-- Helper for Theorem 12-12.6-2: evaluating a pure tensor in `A ⊗ R_K(G)` gives the expected
scalar multiple of the underlying virtual character. -/
@[simp] private theorem tensorCharacterRingToFunction_apply_tmul_local
    {A : Type v} [CommRing A] [Algebra A K]
    (a : A) (χ : R[K](G)) :
    tensorCharacterRingToFunction_local (K := K) (G := G) (A := A) (a ⊗ₜ[ℤ] χ) =
      a • (χ : G → K) := by
  rfl

/-- Helper for Theorem 12-12.6-2: realizing a basis expansion in `A ⊗ R_K(G)` evaluates
coefficientwise on the corresponding virtual characters. -/
private theorem tensorCharacterRingToFunction_finsupp_sum_local
    {A : Type v} [CommRing A] [Algebra A K]
    {ι : Type*} (b : Module.Basis ι ℤ (R[K](G))) (c : ι →₀ A) :
    tensorCharacterRingToFunction_local (K := K) (G := G) (A := A)
      (c.sum fun i a ↦ a ⊗ₜ[ℤ] b i) =
        c.sum fun i a ↦ a • (((b i : R[K](G)) : G → K)) := by
  classical
  -- Evaluate the ambient realization map termwise on the chosen finitely supported expansion.
  simp [Finsupp.sum, map_sum, tensorCharacterRingToFunction_apply_tmul_local]

/-- Helper for Theorem 12-12.6-2: the scalar-extension owner `A ⊗R[K](G)` is a genuine submodule
of `G → K`, so equality of underlying functions already gives equality in that owner. -/
private theorem characterRingOverFieldAlgebraScalarExtension_subtype_injective_local
    {A : Type v} [CommRing A] [Algebra A K] :
    Function.Injective
      ((Representation.characterRingOverFieldAlgebraScalarExtension A K G).subtype :
        Representation.characterRingOverFieldAlgebraScalarExtension A K G →ₗ[A] G → K) := by
  intro ξ η hξη
  exact Subtype.ext hξη

/-- Helper for Theorem 12-12.6-2: transporting the ambient tensor owner `A ⊗ R_K(G)` along
`Shrink.mulEquiv` matches the local realization map with the canonical Chapter `12.7.1`
realization on `Shrink.{w} G`. -/
private theorem tensorCharacterRingToFunction_intermediateField_shrink_transport_local
    {A : Type v} [CommRing A] [Algebra A K] [IsIntegralClosure A ℤ ↥K]
    (ξ : TensorProduct ℤ A (R[K](G))) :
    Representation.tensorCharacterRingToFunction (A := A) (K := K) (G := Shrink.{w} G)
        (TensorProduct.congr (LinearEquiv.refl ℤ A)
          (characterRingOverField_shrink_transport_linearEquiv_local (K := K) (G := G)) ξ) =
      fun g : Shrink.{w} G ↦
        tensorCharacterRingToFunction_local (K := K) (G := G) (A := A) ξ (Shrink.mulEquiv g) := by
  letI : Algebra A ↥K := by
    change Algebra A K
    infer_instance
  letI : IsIntegralClosure A ℤ ↥K := inferInstance
  -- Compare the two realizations by tensor induction and reduce pure tensors to the explicit
  -- `*_apply_tmul` formulas.
  induction ξ using TensorProduct.induction_on with
  | zero =>
      ext g
      rw [LinearEquiv.map_zero, LinearMap.map_zero, LinearMap.map_zero]
      rfl
  | tmul a χ =>
      -- On a pure tensor, both sides are the same scalar multiple of the transported character.
      ext g
      rw [TensorProduct.congr_tmul]
      have htmul :
          Representation.tensorCharacterRingToFunction (A := A) (K := K) (G := Shrink.{w} G)
              (a ⊗ₜ[ℤ]
                characterRingOverField_shrink_transport_linearEquiv_local
                  (K := K) (G := G) χ) =
            a •
              ((characterRingOverField_shrink_transport_linearEquiv_local
                (K := K) (G := G) χ : R[K](Shrink.{w} G)) : Shrink.{w} G → K) := by
        simpa using
          (@Representation.tensorCharacterRingToFunction_apply_tmul
            (G := Shrink.{w} G) inferInstance inferInstance
            (A := A) inferInstance (K := ↥K) inferInstance inferInstance inferInstance
            (inferInstance : IsIntegralClosure A ℤ ↥K)
            a
            (characterRingOverField_shrink_transport_linearEquiv_local
              (K := K) (G := G) χ))
      simpa [tensorCharacterRingToFunction_local, Pi.smul_apply,
        characterRingOverField_shrink_transport_linearEquiv_local_apply] using congrFun htmul g
  | add ξ η hξ hη =>
      -- Additivity finishes the transport statement after the pure-tensor case.
      ext g
      rw [LinearEquiv.map_add, LinearMap.map_add, hξ, hη, map_add]
      simp

/-- Helper for Theorem 12-12.6-2: the normalized character pairing is additive on finite
`A`-linear combinations in its left argument after transporting coefficients along `A → K`. -/
private theorem groupFunctionPairing_sum_algebra_smul_left_local
    {A : Type v} [CommRing A] [Algebra A K]
    {ι : Type*} (s : Finset ι) (a : ι → A) (χ : ι → G → K) (ψ : G → K) :
    ⟪∑ j ∈ s, a j • χ j, ψ⟫ = ∑ j ∈ s, algebraMap A K (a j) * ⟪χ j, ψ⟫ := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp [Representation.groupFunctionPairingOverField]
  | insert i s hi ih =>
      -- Replace the `A`-scalar action by the corresponding `K`-scalar action, then expand the
      -- pairing across the inserted summand.
      have hsmul : (a i • χ i : G → K) = algebraMap A K (a i) • χ i := by
        ext g
        simp [Algebra.smul_def, smul_eq_mul]
      rw [Finset.sum_insert hi, groupFunctionPairing_add_left, hsmul,
        groupFunctionPairing_smul_left, ih, Finset.sum_insert hi]

/-- Helper for Theorem 12-12.6-2: precomposing an irreducible representation with a group
equivalence preserves irreducibility over any field. -/
private theorem isIrreducible_comp_of_mulEquiv_field_local
    {G₁ : Type*} [Group G₁] {G₂ : Type*} [Group G₂]
    {V : Type*} [AddCommGroup V] [Module K V]
    (e : G₁ ≃* G₂) (σ : Representation K G₂ V) [σ.IsIrreducible] :
    Representation.IsIrreducible (σ.comp e.toMonoidHom) := by
  classical
  letI : Nontrivial (Subrepresentation (σ.comp e.toMonoidHom)) := by
    refine ⟨⟨⊥, ⊤, ?_⟩⟩
    intro h
    have h' : (⊥ : Subrepresentation σ) = ⊤ := by
      apply Subrepresentation.toSubmodule_injective
      simpa using congrArg Subrepresentation.toSubmodule h
    exact IsSimpleOrder.bot_ne_top h'
  -- Pull invariant subspaces back along the group equivalence and use irreducibility of `σ`.
  refine IsSimpleOrder.of_forall_eq_top ?_
  intro W hW
  let W' : Subrepresentation σ :=
    { toSubmodule := W.toSubmodule
      apply_mem_toSubmodule := by
        intro g x hx
        simpa using W.apply_mem_toSubmodule (e.symm g) hx }
  have hW'_ne_bot : W' ≠ ⊥ := by
    intro hW'
    apply hW
    apply Subrepresentation.toSubmodule_injective
    simpa [W'] using congrArg Subrepresentation.toSubmodule hW'
  have hW'_top : W' = ⊤ := (IsSimpleOrder.eq_bot_or_eq_top W').resolve_left hW'_ne_bot
  apply Subrepresentation.toSubmodule_injective
  simpa [W'] using congrArg Subrepresentation.toSubmodule hW'_top

/-- Helper for Theorem 12-12.6-2: realizing the ambient tensor owner `A ⊗ R_K(G)` in
`K`-valued functions is injective. -/
private theorem tensorCharacterRingToFunction_injective_local
    {A : Type v} [CommRing A] [Algebra A K] [IsIntegralClosure A ℤ ↥K] :
    Function.Injective (tensorCharacterRingToFunction_local (K := K) (G := G) (A := A)) := by
  letI : Algebra A ↥K := by
    change Algebra A K
    infer_instance
  letI : IsIntegralClosure A ℤ ↥K := inferInstance
  let eTensor :=
    TensorProduct.congr (LinearEquiv.refl ℤ A)
      (characterRingOverField_shrink_transport_linearEquiv_local (K := K) (G := G))
  intro ξ η hξη
  have htransport :
      Representation.tensorCharacterRingToFunction (A := A) (K := K) (G := Shrink.{w} G)
          (eTensor ξ) =
        Representation.tensorCharacterRingToFunction (A := A) (K := K) (G := Shrink.{w} G)
          (eTensor η) := by
    -- Route correction: move the equality to the same-universe owner on `Shrink.{w} G` before
    -- invoking the canonical Chapter `12.7.1` injectivity theorem.
    ext g
    simpa [eTensor,
      tensorCharacterRingToFunction_intermediateField_shrink_transport_local]
      using congrArg (fun f : G → K ↦ f (Shrink.mulEquiv g)) hξη
  have hcanonical : eTensor ξ = eTensor η := by
    exact
      (@Representation.tensorCharacterRingToFunction_injective_gammaP
        (Shrink.{w} G) inferInstance inferInstance
        A inferInstance ↥K inferInstance inferInstance inferInstance
        (inferInstance : IsIntegralClosure A ℤ ↥K)) htransport
  exact eTensor.injective hcanonical

/-- Helper for Theorem 12-12.6-2: tensoring the realization map for `V_{K,p}` factors through the
tensor of the ambient character-ring inclusion. -/
private theorem
    lTensor_gammaPElementaryInducedCharacterToFunction_eq_lTensor_characterRing_toFunction_comp_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ) :
    LinearMap.lTensor A (gammaPElementaryInducedCharacterToFunction_local (K := K) (G := G) p) =
      (LinearMap.lTensor A (characterRing_toFunction_local (K := K) (G := G))).comp
        (LinearMap.lTensor A
          (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype) := by
  -- This is the tensor-level form of the obvious factorization through the ambient character ring.
  rw [gammaPElementaryInducedCharacterToFunction_eq_characterRing_toFunction_comp_subtype_local
    (K := K) (G := G) p]
  ext a ξ
  simp

/-- Helper for Theorem 12-12.6-2: realizing a tensor in `A ⊗ V_{K,p}` agrees pointwise with first
viewing it inside the ambient tensor owner `A ⊗ R_K(G)` and then realizing there. -/
private theorem
    tensorGammaPElementaryInducedCharacterToFunction_eq_tensorCharacterRingToFunction_lTensor_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ)
    (ξ : TensorProduct ℤ A (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p)) :
    tensorGammaPElementaryInducedCharacterToFunction_local
        (K := K) (G := G) (A := A) p ξ =
      tensorCharacterRingToFunction_local (K := K) (G := G) (A := A)
        (show TensorProduct ℤ A (R[K](G)) from
          LinearMap.lTensor A
            (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype ξ) := by
  induction ξ using TensorProduct.induction_on with
  | zero =>
      rfl
  | tmul a χ =>
      ext g
      simp [tensorCharacterRingToFunction_apply_tmul_local]
  | add ξ η hξ hη =>
      simp [hξ, hη, map_add]

/-- Helper for Theorem 12-12.6-2: tensoring the quotient map
`R_K(G) → R_K(G) / V_{K,p}` identifies its kernel with the tensor image of `V_{K,p}`. -/
private theorem ker_lTensor_mkQ_eq_range_lTensor_gammaP_subtype_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ) :
    LinearMap.ker
        (LinearMap.lTensor A
          (Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p))) =
      LinearMap.range
        (LinearMap.lTensor A
          (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype) := by
  -- This is the standard right-exactness statement for tensoring a submodule quotient.
  simpa using
    (lTensor_mkQ A (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p))

/-- Helper for Theorem 12-12.6-2: an integral virtual character realized inside LinearRepresentations_Serre_1977's scalar
extension `A ⊗ V_{K,p}` already comes from `V_{K,p}` itself. -/
private theorem quotient_class_eq_zero_of_mem_gammaP_scalarExtension_local
    {A : Type v} [CommRing A] [Algebra A K] [IsIntegralClosure A ℤ ↥K]
    (p : ℕ) {χ : R[K](G)}
    (hχ :
      (χ : G → K) ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := A) p) :
    Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) χ = 0 := by
  rcases hχ with ⟨ξ, hξ⟩
  have htensor :
      ((1 : A) ⊗ₜ[ℤ] χ : TensorProduct ℤ A (R[K](G))) =
        LinearMap.lTensor A
          (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype ξ := by
    -- Route correction: compare the concrete tensor witness inside `A ⊗ R_K(G)` and only then
    -- pass to the quotient, instead of trying to descend directly from function-space membership.
    apply tensorCharacterRingToFunction_injective_local (K := K) (G := G) (A := A)
    calc
      tensorCharacterRingToFunction_local (K := K) (G := G) (A := A)
          ((1 : A) ⊗ₜ[ℤ] χ : TensorProduct ℤ A (R[K](G))) = χ := by
        simp [tensorCharacterRingToFunction_apply_tmul_local]
      _ =
          tensorGammaPElementaryInducedCharacterToFunction_local
            (K := K) (G := G) (A := A) p ξ := by
        simpa [hξ]
      _ =
          tensorCharacterRingToFunction_local (K := K) (G := G) (A := A)
            (LinearMap.lTensor A
              (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype ξ) := by
        simpa using
          (tensorGammaPElementaryInducedCharacterToFunction_eq_tensorCharacterRingToFunction_lTensor_local
            (K := K) (G := G) (A := A) p ξ)
  have hquot_tmul :
      (1 : A) ⊗ₜ[ℤ]
          (Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) χ) = 0 := by
    -- Quotienting annihilates the tensor image of `V_{K,p}`, so the previous tensor identity
    -- becomes a vanishing pure tensor in `A ⊗ (R_K(G) / V_{K,p})`.
    have hquot :=
      congrArg
        (LinearMap.lTensor A
          (Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p))) htensor
    calc
      (1 : A) ⊗ₜ[ℤ]
          (Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) χ) =
            LinearMap.lTensor A
              (Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p))
              (LinearMap.lTensor A
                (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype ξ) := by
        simpa [LinearMap.lTensor_tmul] using hquot
      _ = 0 := by
        have hmkQ_subtype :
            (Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p)).comp
                (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype = 0 := by
          ext x
          exact
            (Submodule.Quotient.mk_eq_zero
              (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p)).2 x.2
        have hcomp :
            (LinearMap.lTensor A
              (Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p))).comp
                (LinearMap.lTensor A
                  (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p).subtype) = 0 := by
          rw [← LinearMap.lTensor_comp, hmkQ_subtype, LinearMap.lTensor_zero]
        simpa using congrArg (fun f ↦ f ξ) hcomp
  -- Faithful flatness reflects vanishing of the quotient class from the vanishing of `1 ⊗ -`.
  exact
    quotient_eq_zero_of_one_tmul_eq_zero_local
      (K := K) (G := G) (A := A) p
      (Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) χ) hquot_tmul

/-- Helper for Theorem 12-12.6-2: once a constant function lies in the realized scalar extension
`A ⊗ V_{K,p}`, the corresponding scalar multiple of the trivial character already lies in
`V_{K,p}`. -/
private theorem constantCharacter_mem_gammaPImage_of_mem_scalarExtension_local
    {A : Type v} [CommRing A] [Algebra A K] [IsIntegralClosure A ℤ ↥K]
    (p : ℕ) (l : ℕ)
    (hl :
      (fun _ : G ↦ (l : K)) ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := A) p) :
    l • (1 : R[K](G)) ∈ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p := by
  let χ : R[K](G) := l • (1 : R[K](G))
  have hχ_apply : (χ : G → K) = fun _ : G ↦ (l : K) := by
    -- Rewrite the constant function as the scalar multiple `l • 1` of the trivial character.
    ext g
    simp [χ]
  have hq :
      Submodule.mkQ (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p) χ = 0 :=
    quotient_class_eq_zero_of_mem_gammaP_scalarExtension_local
      (K := K) (G := G) (A := A) p <| by
        simpa [hχ_apply] using hl
  exact
    (Submodule.Quotient.mk_eq_zero
      (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p)).1 hq

/-- Helper for Theorem 12-12.6-2: the coefficient ring used in LinearRepresentations_Serre_1977's Section `12.7`, namely the
carrier of the integral closure of `ℤ` inside the intermediate field `K`. -/
private abbrev integralClosureCarrier_local : Type w := ↥(integralClosure ℤ K)

/-- Helper for Theorem 12-12.6-2: the theorem-local carrier of the integral closure inherits the
standard integral-closure structure over `ℤ` inside `K`. -/
private instance integralClosureCarrier_local_isIntegralClosure :
    IsIntegralClosure (integralClosureCarrier_local (K := K)) ℤ ↥K := by
  change IsIntegralClosure (↥(integralClosure ℤ ↥K)) ℤ ↥K
  infer_instance

/-- Helper for Theorem 12-12.6-2: inducing from the associated `Γ_K`-`p`-elementary subgroup
already lands in the theorem-local scalar-extension owner `A ⊗ V_{K,p}`. -/
private theorem induced_associatedGammaPElementary_character_mem_gammaP_scalarExtension_local
    (p : Nat.Primes) (x : G) (hx : IsPRegular (p : ℕ) x)
    (P : Sylow (p : ℕ) N[ΓK](x)) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    ∀ ψ : (integralClosureCarrier_local (K := K)) ⊗R[K](H),
      (((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
          (A := integralClosureCarrier_local (K := K)) (K := K) (H := H) ψ :
            (integralClosureCarrier_local (K := K)) ⊗R[K](G)) : G → K)) ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ) := by
  classical
  dsimp
  intro ψ
  let A := integralClosureCarrier_local (K := K)
  let H := associatedGammaPElementarySubgroup ΓK x P
  letI : Fact (Nat.Prime (p : ℕ)) := ⟨p.2⟩
  have hHgamma :
      Subgroup.IsGammaPElementary ΓK (p : ℕ) H :=
    ⟨_, _, associatedGammaPElementarySubgroup_decomposition ΓK (p := (p : ℕ)) x hx P⟩
  have hHmem :
      H ∈
        Finset.univ.filter
          (fun J : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK (p : ℕ) J) := by
    -- The associated subgroup is one of the fixed-`p` induction generators by Lemma `12-12.7-5`.
    exact Finset.mem_filter.mpr ⟨by simp, hHgamma⟩
  let S : Set (H → K) := (((R[K](H)).toSubmodule : Submodule ℤ (H → K)) : Set (H → K))
  let liftPred : ∀ f : H → K, f ∈ Submodule.span A S → Prop := fun f _ =>
    Ind[H](f) ∈
      gammaPElementaryInducedCharacterScalarExtension_local
        (K := K) (G := G) (A := A) (p : ℕ)
  have hψ :
      liftPred ψ.1 ψ.2 := by
    -- Route correction: work directly in the realized owner `A ⊗ R_K(H)` and induct over the
    -- defining `A`-span, so the pure generators are exactly the subgroup-induction generators of
    -- `V_{K,p}`.
    refine Submodule.span_induction (s := S) (p := liftPred) ?_ ?_ ?_ ?_ ψ.2
    · intro ξ hξ
      have hξ' : ξ ∈ R[K](H) := by
        simpa [S] using hξ
      have hξmem :
          H.characterRingOverFieldInduction K ⟨ξ, hξ'⟩ ∈
            gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ) := by
        -- The subgroup-induction generators attached to `H` already lie in `V_{K,p}`.
        exact
          (show LinearMap.range (H.characterRingOverFieldInduction K) ≤
              gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ) from
            le_iSup
              (fun J :
                {J : Subgroup G // J ∈
                  Finset.filter
                    (fun J : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK (p : ℕ) J)
                    Finset.univ} ↦
                LinearMap.range (J.1.characterRingOverFieldInduction K))
              ⟨H, hHmem⟩) ⟨⟨ξ, hξ'⟩, rfl⟩
      -- On a generator from `R_K(H)`, scalar-extension induction is the ordinary subgroup
      -- induction map viewed inside the realized scalar extension.
      simpa [liftPred, S, Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction_apply,
        Subgroup.characterRingOverFieldInduction_apply] using
        mem_gammaPElementaryInducedCharacterScalarExtension_of_mem_gammaPImage_local
          (K := K) (G := G) (A := A) (p := (p : ℕ)) hξmem
    · have hzero :
          Ind[H]((0 : H → K)) = (0 : G → K) := by
        ext g
        simp [Subgroup.inducedClassFunction]
      simpa [liftPred, hzero] using
        (zero_mem
          (gammaPElementaryInducedCharacterScalarExtension_local
            (K := K) (G := G) (A := A) (p : ℕ)))
    · intro f g _ _ hf hg
      simpa [liftPred, Subgroup.inducedClassFunction_map_add] using
        Submodule.add_mem
          (gammaPElementaryInducedCharacterScalarExtension_local
            (K := K) (G := G) (A := A) (p : ℕ))
          hf hg
    · intro a f _ hf
      letI : DistribMulAction A K := inferInstance
      letI : SMulCommClass A K K := inferInstance
      simpa [liftPred, Subgroup.inducedClassFunction_map_smul (S := A) (H := H) a f] using
        Submodule.smul_mem
          (gammaPElementaryInducedCharacterScalarExtension_local
            (K := K) (G := G) (A := A) (p : ℕ))
          a hf
  simpa [liftPred, Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction_apply] using hψ

/-- Helper for Theorem 12-12.6-2: the arithmetic coefficient ring `A = integralClosure ℤ K`
has finite quotient by the principal ideal generated by a prime `p`. -/
private theorem finite_quotient_by_prime_span_integralClosure_local
    (p : Nat.Primes) :
    Finite
      ((integralClosureCarrier_local (K := K)) ⧸
        Ideal.span
          ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
            Set (integralClosureCarrier_local (K := K)))) := by
  -- Identify the coefficient ring with the ring of integers of the number field `K`, then use
  -- the finite-quotients instance for finitely generated domains over `ℤ`.
  change Finite ((𝓞 K) ⧸ Ideal.span ({((p : ℕ) : 𝓞 K)} : Set (𝓞 K)))
  letI : Ring.HasFiniteQuotients (𝓞 K) := by
    infer_instance
  exact
    Ring.HasFiniteQuotients.finiteQuotient (R := 𝓞 K) <| by
      intro hbot
      exact Nat.cast_ne_zero.mpr p.2.ne_zero (Ideal.span_singleton_eq_bot.mp hbot)

/-- Helper for Theorem 12-12.6-2: only finitely many prime ideals of `integralClosure ℤ K`
contain the principal ideal generated by `p`. -/
private theorem zeroLocus_span_prime_integralClosure_finite_local
    (p : Nat.Primes) :
    let A := integralClosureCarrier_local (K := K)
    Set.Finite (PrimeSpectrum.zeroLocus (R := A) (Ideal.span ({((p : ℕ) : A)} : Set A))) := by
  classical
  dsimp
  let I : Ideal (integralClosureCarrier_local (K := K)) :=
    Ideal.span
      ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
        Set (integralClosureCarrier_local (K := K)))
  letI : Finite ((integralClosureCarrier_local (K := K)) ⧸ I) :=
    finite_quotient_by_prime_span_integralClosure_local (K := K) p
  let e := Ideal.primeSpectrumQuotientOrderIsoZeroLocus
    (R := integralClosureCarrier_local (K := K)) I
  letI : Finite (Ideal ((integralClosureCarrier_local (K := K)) ⧸ I)) := by
    infer_instance
  letI : Finite (PrimeSpectrum ((integralClosureCarrier_local (K := K)) ⧸ I)) :=
    Finite.of_injective PrimeSpectrum.asIdeal (fun P Q h => PrimeSpectrum.ext h)
  letI :
      Finite
        (PrimeSpectrum.zeroLocus
          (R := integralClosureCarrier_local (K := K)) I) :=
    Finite.of_equiv
      (PrimeSpectrum ((integralClosureCarrier_local (K := K)) ⧸ I)) e.toEquiv
  -- Transport finiteness from `Spec (A / pA)` to the zero locus of `(p)`.
  simpa [I] using
    (Set.toFinite
      (PrimeSpectrum.zeroLocus (R := integralClosureCarrier_local (K := K)) I))

/-- Helper for Theorem 12-12.6-2: for a prime ideal `Q` over `pA`, the residue ring
`(integralClosure ℤ K) ⧸ Q` is finite of characteristic `p`. -/
private theorem quotient_finite_and_charP_of_span_prime_integralClosure_local
    (p : Nat.Primes)
    (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
    (hQ :
      Ideal.span
          ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
            Set (integralClosureCarrier_local (K := K))) ≤
        Q.asIdeal) :
    Finite ((integralClosureCarrier_local (K := K)) ⧸ Q.asIdeal) ∧
      CharP ((integralClosureCarrier_local (K := K)) ⧸ Q.asIdeal) (p : ℕ) := by
  let I : Ideal (integralClosureCarrier_local (K := K)) :=
    Ideal.span
      ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
        Set (integralClosureCarrier_local (K := K)))
  letI : Finite ((integralClosureCarrier_local (K := K)) ⧸ I) :=
    finite_quotient_by_prime_span_integralClosure_local (K := K) p
  have hfinite : Finite ((integralClosureCarrier_local (K := K)) ⧸ Q.asIdeal) :=
    Finite.of_surjective (Ideal.Quotient.factor hQ) (Ideal.Quotient.factor_surjective hQ)
  haveI : Finite ((integralClosureCarrier_local (K := K)) ⧸ Q.asIdeal) := hfinite
  have hQ_ne_top : Q.asIdeal ≠ ⊤ := Q.isPrime.ne_top
  letI :
      Nontrivial ((integralClosureCarrier_local (K := K)) ⧸ Q.asIdeal) :=
    Ideal.Quotient.nontrivial_iff.mpr hQ_ne_top
  have hp_zero :
      ((p : ℕ) : (integralClosureCarrier_local (K := K)) ⧸ Q.asIdeal) = 0 := by
    rw [← map_natCast (Ideal.Quotient.mk Q.asIdeal), Ideal.Quotient.eq_zero_iff_mem]
    exact hQ (Ideal.subset_span (by simp))
  refine ⟨hfinite, ?_⟩
  exact (CharP.charP_iff_prime_eq_zero p.2).2 hp_zero

/-- Helper for Theorem 12-12.6-2: in the Lemma `19` class-sum, once all off-class separator
summands vanish at a `p`-regular element `s`, the whole finite sum reduces to the separator
attached to the LinearRepresentations_Serre_1977 `Γ_K`-class of `s`. -/
private theorem sum_pRegularGaloisPowerClass_separators_apply_local
    (p : Nat.Primes)
    {β : Type*} [AddCommMonoid β]
    (F : PRegularGaloisPowerClass ΓK (p : ℕ) → G → β)
    {s : G} (hs : IsPRegular (p : ℕ) s)
    (hvanish :
      ∀ c : PRegularGaloisPowerClass ΓK (p : ℕ),
        c ≠ pRegularGaloisPowerClassMk ΓK (p : ℕ) ⟨s, hs⟩ → F c s = 0) :
    (∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), F c s) =
      F (pRegularGaloisPowerClassMk ΓK (p : ℕ) ⟨s, hs⟩) s := by
  classical
  let sClass : PRegularGaloisPowerClass ΓK (p : ℕ) :=
    pRegularGaloisPowerClassMk ΓK (p : ℕ) ⟨s, hs⟩
  letI : Fintype (PRegularGaloisPowerClass ΓK (p : ℕ)) := Fintype.ofFinite _
  -- This is the finite-support combinatorics of LinearRepresentations_Serre_1977's class-sum argument:
  -- every summand except the one indexed by the class of `s` vanishes at `s`.
  simpa [sClass] using
    (Finset.sum_eq_single
      (s := Finset.univ)
      (a := sClass)
      (f := fun c : PRegularGaloisPowerClass ΓK (p : ℕ) ↦ F c s)
      (by
        intro c _ hc
        exact hvanish c hc)
      (by
        intro hsClass
        exact False.elim (hsClass (Finset.mem_univ sClass))) :
      ∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), F c s = F sClass s)

/-- Helper for Theorem 12-12.6-2: LinearRepresentations_Serre_1977's Lemma `18` can be packaged directly on each
`p`-regular `Γ_K`-power class, so the main file no longer needs separate representative-level
transport after choosing the class-supported separator. -/
private theorem exists_separator_family_on_pRegularGaloisPowerClass_local
    (p : Nat.Primes) :
    ∀ c : PRegularGaloisPowerClass ΓK (p : ℕ),
      ∃ χc : G → K, ∃ fc : G → integralClosureCarrier_local (K := K),
        χc ∈
          gammaPElementaryInducedCharacterScalarExtension_local
            (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ) ∧
        ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ fc) = χc ∧
        (∀ (s : G) (hs : IsPRegular (p : ℕ) s),
          pRegularGaloisPowerClassMk ΓK (p : ℕ) ⟨s, hs⟩ ≠ c → χc s = 0) ∧
        (∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
            (hQ :
              Ideal.span
                  ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                    Set (integralClosureCarrier_local (K := K))) ≤
                Q.asIdeal)
            (s : G) (hs : IsPRegular (p : ℕ) s),
          pRegularGaloisPowerClassMk ΓK (p : ℕ) ⟨s, hs⟩ = c →
            fc s ∉ Q.asIdeal) := by
  admit

/-- Helper for Theorem 12-12.6-2: once Lemma `18` supplies one separator on each `p`-regular
`Γ_K`-class, summing those separators gives LinearRepresentations_Serre_1977's Lemma `19` witness in the local owner
`A ⊗ V_{K,p}`. -/
private theorem
    exists_everywhere_nonzero_mod_primeIdeals_gammaP_scalar_witness_of_separator_family_local
    (p : Nat.Primes)
    (hfamily :
      ∀ c : PRegularGaloisPowerClass ΓK (p : ℕ),
        ∃ χc : G → K, ∃ fc : G → integralClosureCarrier_local (K := K),
          χc ∈
            gammaPElementaryInducedCharacterScalarExtension_local
              (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ) ∧
          ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ fc) = χc ∧
          (∀ (s : G) (hs : IsPRegular (p : ℕ) s),
            pRegularGaloisPowerClassMk ΓK (p : ℕ) ⟨s, hs⟩ ≠ c → χc s = 0) ∧
          (∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
              (hQ :
                Ideal.span
                    ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                      Set (integralClosureCarrier_local (K := K))) ≤
                  Q.asIdeal)
              (s : G) (hs : IsPRegular (p : ℕ) s),
            pRegularGaloisPowerClassMk ΓK (p : ℕ) ⟨s, hs⟩ = c →
              fc s ∉ Q.asIdeal)) :
    ∃ φ : G → K, ∃ f : G → integralClosureCarrier_local (K := K),
      φ ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ) ∧
      ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ f) = φ ∧
      ∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
        (hQ :
          Ideal.span
              ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                Set (integralClosureCarrier_local (K := K))) ≤
            Q.asIdeal)
        (s : G) (hs : IsPRegular (p : ℕ) s),
        f s ∉ Q.asIdeal := by
  classical
  let ιAfun : integralClosureCarrier_local (K := K) → K :=
    fun a ↦ algebraMap (integralClosureCarrier_local (K := K)) K a
  have hιA_add :
      ∀ a b : integralClosureCarrier_local (K := K),
        ιAfun (a + b) = ιAfun a + ιAfun b := by
    intro a b
    exact (algebraMap (integralClosureCarrier_local (K := K)) K).map_add a b
  letI : Fintype (PRegularGaloisPowerClass ΓK (p : ℕ)) := Fintype.ofFinite _
  choose χ f hχ hmap hvanish hnonzero using hfamily
  refine ⟨∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), χ c,
    fun s : G ↦ ∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), f c s, ?_, ?_, ?_⟩
  · -- Each class separator already lies in `A ⊗ V_{K,p}`, so their finite sum does as well.
    exact Submodule.sum_mem _ fun c _ ↦ hχ c
  · -- The summed `A`-valued lift still maps to the summed `K`-valued separator family.
    ext s
    have hsumK :
        ιAfun (∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), f c s) =
          ∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), χ c s := by
      classical
      induction (Finset.univ : Finset (PRegularGaloisPowerClass ΓK (p : ℕ))) using
          Finset.induction_on with
      | empty =>
          rfl
      | insert c t hc ih =>
          rw [Finset.sum_insert hc, Finset.sum_insert hc, hιA_add, ih]
          have hcmap : ιAfun (f c s) = χ c s := by
            change (((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ f c) s) = χ c s
            exact congrFun (hmap c) s
          rw [hcmap]
    have hsumK' :
        (ιAfun ∘
            fun s : G ↦ ∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), f c s) s =
          (∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), χ c) s := by
      calc
        (ιAfun ∘ fun s : G ↦ ∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), f c s) s =
            ιAfun (∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), f c s) := by
              rfl
        _ = ∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), χ c s := hsumK
        _ = (∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), χ c) s := by
              exact
                (Finset.sum_apply
                  (a := s)
                  (s := (Finset.univ : Finset (PRegularGaloisPowerClass ΓK (p : ℕ))))
                  (g := χ)).symm
    exact congrArg (fun z : K ↦ (z : L)) hsumK'
  · intro Q hQ s hs
    change (∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), f c s) ∉ Q.asIdeal
    let sClass : PRegularGaloisPowerClass ΓK (p : ℕ) :=
      pRegularGaloisPowerClassMk ΓK (p : ℕ) ⟨s, hs⟩
    have hsum_eq :
        (∑ c : PRegularGaloisPowerClass ΓK (p : ℕ), f c s) = f sClass s := by
      -- Route correction: reduce the finite class-sum first, so only the separator indexed by
      -- the class of `s` survives at `s`.
      refine sum_pRegularGaloisPowerClass_separators_apply_local
        (K := K) (G := G) (p := p)
        (β := integralClosureCarrier_local (K := K)) f hs ?_
      intro c hc
      have hzeroK : χ c s = 0 := hvanish c s hs hc.symm
      have hfc : ιAfun (f c s) = χ c s := by
        change (((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ f c) s) = χ c s
        exact congrFun (hmap c) s
      have hzeroMap : ιAfun (f c s) = 0 := by
        rw [hfc, hzeroK]
      apply Subtype.ext
      simpa [ιAfun] using hzeroMap
    -- After the reduction, the surviving summand is nonzero modulo every prime over `pA`.
    rw [hsum_eq]
    exact hnonzero sClass Q hQ s hs rfl

/-- Helper for Theorem 12-12.6-2: summing the quotient-indexed separator family from Lemma `18`
produces LinearRepresentations_Serre_1977's Lemma `19` witness directly in the theorem-local owner `A ⊗ V_{K,p}`. -/
private theorem exists_everywhere_nonzero_mod_primeIdeals_gammaP_scalar_witness_local
    (p : Nat.Primes) :
    ∃ φ : G → K, ∃ f : G → integralClosureCarrier_local (K := K),
      φ ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ) ∧
      ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ f) = φ ∧
      ∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
        (hQ :
          Ideal.span
              ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                Set (integralClosureCarrier_local (K := K))) ≤
            Q.asIdeal)
        (s : G) (hs : IsPRegular (p : ℕ) s),
        f s ∉ Q.asIdeal := by
  admit

/-- Helper for Theorem 12-12.6-2: multiplying an ambient scalar-extended virtual character by an
element of the realized owner `A ⊗ V_{K,p}` keeps the product inside the same owner. -/
private theorem mul_mem_gammaP_scalarExtension_of_mem_characterRingScalarExtension_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ) {u v : G → K}
    (hu : u ∈ characterRingOverFieldAlgebraScalarExtension A K G)
    (hv :
      v ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := A) p) :
    u * v ∈
      gammaPElementaryInducedCharacterScalarExtension_local
        (K := K) (G := G) (A := A) p := by
  admit

/-- Helper for Theorem 12-12.6-2: the nonvanishing witness from LinearRepresentations_Serre_1977's Lemma `19` admits a
single common exponent that becomes `1` in every residue field above `pA`. -/
private theorem exists_common_exponent_one_mod_primeIdeals_from_everywhere_nonzero_local
    (p : Nat.Primes)
    {f : G → integralClosureCarrier_local (K := K)}
    (hnonzero :
      ∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
        (hQ :
          Ideal.span
              ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                Set (integralClosureCarrier_local (K := K))) ≤
            Q.asIdeal)
        (s : G) (hs : IsPRegular (p : ℕ) s),
        f s ∉ Q.asIdeal) :
    ∃ M : ℕ, 0 < M ∧
      ∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
        (hQ :
          Ideal.span
              ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                Set (integralClosureCarrier_local (K := K))) ≤
            Q.asIdeal)
        (s : G) (hs : IsPRegular (p : ℕ) s),
        (Ideal.Quotient.mk Q.asIdeal (f s)) ^ M = 1 := by
  admit

/-- Helper for Theorem 12-12.6-2: if an element of the arithmetic coefficient ring lies in every
prime ideal above `pA`, then it already lies in the radical of `pA`. This is the exact
zero-locus-to-radical bridge used after LinearRepresentations_Serre_1977's Lemma `19`. -/
private theorem sub_one_mem_radical_span_prime_of_forall_primeIdealOverPrime_local
    (p : Nat.Primes)
    {a : integralClosureCarrier_local (K := K)}
    (ha :
      ∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
        (hQ :
          Ideal.span
              ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                Set (integralClosureCarrier_local (K := K))) ≤
            Q.asIdeal),
        a ∈ Q.asIdeal) :
    a ∈
      (Ideal.span
          ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
            Set (integralClosureCarrier_local (K := K)))).radical := by
  let A := integralClosureCarrier_local (K := K)
  let I : Ideal A := Ideal.span ({((p : ℕ) : A)} : Set A)
  have hvanishing : a ∈ PrimeSpectrum.vanishingIdeal (PrimeSpectrum.zeroLocus (I : Set A)) := by
    -- Turn the pointwise prime-ideal hypothesis into membership in the vanishing ideal of the
    -- zero locus of `pA`.
    rw [PrimeSpectrum.mem_vanishingIdeal]
    intro Q hQ
    exact ha Q ((PrimeSpectrum.mem_zeroLocus (x := Q) (s := (I : Set A))).1 hQ)
  -- The vanishing ideal of the zero locus of `pA` is exactly the radical of `pA`.
  rw [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical (I := I)] at hvanishing
  simpa [I] using hvanishing

/-- Helper for Theorem 12-12.6-2: a uniform `p`-power kills the radical congruence from the
previous lemma and upgrades it to an actual congruence modulo `pA`. This is the source-faithful
Lemma `14` nilpotence step, isolated from the later `Γ_K` bookkeeping. -/
private theorem exists_p_power_one_mod_span_prime_of_sub_one_mem_radical_local
    (p : Nat.Primes) :
    ∃ q0 : ℕ, 0 < q0 ∧
      ∀ a : integralClosureCarrier_local (K := K),
        a - 1 ∈
            (Ideal.span
              ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                Set (integralClosureCarrier_local (K := K)))).radical →
          a ^ q0 - 1 ∈
            Ideal.span
              ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
                Set (integralClosureCarrier_local (K := K))) := by
  let A := integralClosureCarrier_local (K := K)
  let I : Ideal A := Ideal.span ({((p : ℕ) : A)} : Set A)
  letI : Finite (A ⧸ I) := finite_quotient_by_prime_span_integralClosure_local (K := K) p
  obtain ⟨N, hN⟩ := pow_radical_span_nat_le_span_nat (A := A) (p := (p : ℕ))
  let q0 : ℕ := (p : ℕ) ^ N
  refine ⟨q0, by simpa [q0] using pow_pos p.2.pos N, ?_⟩
  intro a ha
  let term : ℕ → A := fun m ↦
    (a - 1) ^ (m + 1) * 1 ^ (q0 - (m + 1)) * (((q0).choose (m + 1) : ℕ) : A)
  let S : A := Finset.sum (Finset.range q0) term
  have hle : N ≤ q0 := by
    dsimp [q0]
    cases N with
    | zero =>
        simp
    | succ n =>
        exact Nat.le_of_lt (Nat.lt_pow_self (n := n.succ) p.2.one_lt)
  have hpow_mem_q0 : (a - 1) ^ q0 ∈ I := by
    -- Any sufficiently high power of an element in `radical (pA)` lands in `pA`.
    have hmemPow : (a - 1) ^ q0 ∈ I.radical ^ q0 := Ideal.pow_mem_pow ha q0
    exact hN ((Ideal.pow_le_pow_right hle) hmemPow)
  have hpow_expand : a ^ q0 = S + 1 := by
    -- Expand `(1 + (a - 1)) ^ q0` and isolate the constant term `1`.
    calc
      a ^ q0 = ((a - 1) + 1) ^ q0 := by
        ring_nf
      _ = Finset.sum (Finset.range (q0 + 1)) (fun m ↦
            (a - 1) ^ m * 1 ^ (q0 - m) * (((q0).choose m : ℕ) : A)) := by
              rw [add_pow]
      _ = S + 1 := by
            rw [Finset.sum_range_succ']
            simp [S, term]
  rw [hpow_expand]
  have hsum_mem : S ∈ I := by
    -- The last summand is controlled by the nilpotence exponent, and every middle binomial
    -- coefficient is divisible by `p`.
    dsimp [S]
    refine Ideal.sum_mem I ?_
    intro m hm
    by_cases hlast : m + 1 = q0
    · simpa [term, hlast] using I.mul_mem_right (1 : A) hpow_mem_q0
    · have hchoose_dvd : (p : ℕ) ∣ q0.choose (m + 1) := by
        apply Nat.Prime.dvd_choose_pow p.2
        · omega
        · simpa [q0] using hlast
      rcases hchoose_dvd with ⟨c, hc⟩
      have hcoeff_mem : (((q0.choose (m + 1) : ℕ) : A)) ∈ I := by
        rw [Ideal.mem_span_singleton]
        refine ⟨(c : A), ?_⟩
        simp [hc, mul_comm]
      exact I.mul_mem_left _ hcoeff_mem
  simpa [I] using hsum_mem

/-- Helper for Theorem 12-12.6-2: any positive pointwise power of a witness in LinearRepresentations_Serre_1977's realized
scalar extension `A ⊗ V_{K,p}` stays in the same owner. This isolates the only multiplicative
closure needed in the post-Lemma `19` source route. -/
private theorem pow_mem_gammaP_scalarExtension_of_pos_local
    {A : Type v} [CommRing A] [Algebra A K]
    (p : ℕ) {u : G → K}
    (hu :
      u ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := A) p)
    {n : ℕ} (hn : 0 < n) :
    u ^ n ∈
      gammaPElementaryInducedCharacterScalarExtension_local
        (K := K) (G := G) (A := A) p := by
  admit

/-- Helper for Theorem 12-12.6-2: package the Lemma `19` witness as a powered element of
`A ⊗ V_{K,p}` that is already congruent to `1` modulo `pA` on the `p`-regular locus. This is the
verified prefix of the source route before the final lift from `pA` to `p^n A`. -/
private theorem
    exists_powered_gammaP_scalar_witness_one_mod_span_prime_on_pRegular_local
    (p : Nat.Primes) :
    ∃ ψ : G → K, ∃ gψ : G → integralClosureCarrier_local (K := K),
      ψ ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ) ∧
      ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ gψ) = ψ ∧
      ∀ s : G, IsPRegular (p : ℕ) s →
        gψ s - 1 ∈
          Ideal.span
            ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
              Set (integralClosureCarrier_local (K := K))) := by
  admit

/-- Helper for Theorem 12-12.6-2: source Lemma `16` globalizes a `1 mod pA` congruence from the
`p`-regular frontier to every prime ideal above `pA`. The proof should compare an arbitrary
element with its `p'`-component through the Chapter `12.7.4` congruence theorem, then reduce the
result modulo `Q`. -/
private theorem sub_eq_zero_mod_primeIdealOverPrime_of_pRegular_component_local
    (p : Nat.Primes)
    {u : G → K}
    {gu : G → integralClosureCarrier_local (K := K)}
    (hu :
      u ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ))
    (hgu_map :
      ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ gu) = u) :
    ∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
      (hQ :
        Ideal.span
            ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
              Set (integralClosureCarrier_local (K := K))) ≤
          Q.asIdeal)
      (s : G),
        gu s - gu (pRegularComponent (p : ℕ) s) ∈ Q.asIdeal := by
  admit

/-- Helper for Theorem 12-12.6-2: source Lemma `16` globalizes a `1 mod pA` congruence from the
`p`-regular frontier to every prime ideal above `pA`. The proof compares an arbitrary element
with its `p'`-component modulo `Q`, then inserts the already proved frontier congruence on that
`p`-regular component. -/
private theorem sub_one_mem_primeIdealOverPrime_of_pRegular_frontier_local
    (p : Nat.Primes)
    {u : G → K}
    {gu : G → integralClosureCarrier_local (K := K)}
    (hu :
      u ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ))
    (hgu_map :
      ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ gu) = u)
    (hfrontier :
      ∀ s : G, IsPRegular (p : ℕ) s →
        gu s - 1 ∈
          Ideal.span
            ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
              Set (integralClosureCarrier_local (K := K)))) :
    ∀ (Q : PrimeSpectrum (integralClosureCarrier_local (K := K)))
      (hQ :
        Ideal.span
            ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
              Set (integralClosureCarrier_local (K := K))) ≤
          Q.asIdeal)
      (s : G),
        gu s - 1 ∈ Q.asIdeal := by
  admit

/-- Helper for Theorem 12-12.6-2: after the Lemma `16` globalization step, one more uniform
power packages a witness in `A ⊗ V_{K,p}` that is globally congruent to `1 mod pA`. This is the
exact endpoint needed before the already isolated `pA -> p^n A` arithmetic tail. -/
private theorem exists_global_one_mod_span_prime_gammaP_scalar_power_local
    (p : Nat.Primes) :
    ∃ ψ₁ : G → K, ∃ gψ₁ : G → integralClosureCarrier_local (K := K),
      ψ₁ ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ) ∧
      ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ gψ₁) = ψ₁ ∧
      ∀ s : G,
        gψ₁ s - 1 ∈
          Ideal.span
            ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
              Set (integralClosureCarrier_local (K := K))) := by
  admit

/-- Helper for Theorem 12-12.6-2: if `a ≡ 1 mod p^m`, then taking one more `p`-th power upgrades
the congruence to `a^p ≡ 1 mod p^(m+1)`. This isolates the pure binomial arithmetic from the
transport on `Γ_K`-classes. -/
private theorem pow_prime_step_one_mod_span_prime_power_local
    (p : Nat.Primes) {m : ℕ} (hm : 0 < m)
    {a : integralClosureCarrier_local (K := K)}
    (ha :
      a - 1 ∈
        Ideal.span
          ({(((p : ℕ) ^ m : integralClosureCarrier_local (K := K)))} :
            Set (integralClosureCarrier_local (K := K)))) :
    a ^ (p : ℕ) - 1 ∈
      Ideal.span
        ({(((p : ℕ) ^ (m + 1) : integralClosureCarrier_local (K := K)))} :
          Set (integralClosureCarrier_local (K := K))) := by
  admit

/-- Helper for Theorem 12-12.6-2: starting from a global congruence `a ≡ 1 mod pA`, repeated
`p`-powering upgrades it to `a^(p^n) ≡ 1 mod p^(n+1)A`. This is the pure arithmetic part of the
source tail after the global `1 mod pA` witness has been produced. -/
private theorem pow_prime_pow_succ_one_mod_span_prime_local
    (p : Nat.Primes) :
    ∀ n : ℕ, ∀ {a : integralClosureCarrier_local (K := K)},
      a - 1 ∈
        Ideal.span
          ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
            Set (integralClosureCarrier_local (K := K))) →
      a ^ ((p : ℕ) ^ n) - 1 ∈
        Ideal.span
          ({(((p : ℕ) ^ (n + 1) : integralClosureCarrier_local (K := K)))} :
            Set (integralClosureCarrier_local (K := K))) := by
  admit

/-- Helper for Theorem 12-12.6-2: once the source route has produced one global `1 mod pA`
witness, the complementary group-order power upgrades it to a global `1 mod p^n A` congruence,
where `p^n` is the `p`-part of `|G|`. -/
private theorem pow_groupOrderPPart_one_mod_span_prime_local
    (p : Nat.Primes)
    {a : integralClosureCarrier_local (K := K)}
    (ha :
      a - 1 ∈
        Ideal.span
          ({((p : ℕ) : integralClosureCarrier_local (K := K))} :
            Set (integralClosureCarrier_local (K := K)))) :
    let n : ℕ := (Nat.card G).factorization (p : ℕ)
    a ^ ((p : ℕ) ^ n) - 1 ∈
      Ideal.span
        ({((((p : ℕ) ^ n : ℕ) : integralClosureCarrier_local (K := K)))} :
          Set (integralClosureCarrier_local (K := K))) := by
  admit

/-- Helper for Theorem 12-12.6-2: multiplying a coefficient congruent to `1 mod p^n A` by the
prime-to-`p` factor `l = |G| / p^n` places `l (a - 1)` in the principal ideal `|G|A`. This is
the coefficient-side input needed before invoking LinearRepresentations_Serre_1977's cyclic-descent Lemma `15`. -/
private theorem ordCompl_mul_sub_one_mem_groupOrderIdeal_local
    (p : Nat.Primes)
    {a : integralClosureCarrier_local (K := K)}
    (ha :
      let n : ℕ := (Nat.card G).factorization (p : ℕ)
      a - 1 ∈
        Ideal.span
          ({((((p : ℕ) ^ n : ℕ) : integralClosureCarrier_local (K := K)))} :
            Set (integralClosureCarrier_local (K := K)))) :
    let n : ℕ := (Nat.card G).factorization (p : ℕ)
    let l : ℕ := Nat.card G / (p : ℕ) ^ n
    ((l : integralClosureCarrier_local (K := K)) * (a - 1)) ∈
      Ideal.span
        ({((Nat.card G : ℕ) : integralClosureCarrier_local (K := K))} :
          Set (integralClosureCarrier_local (K := K))) := by
  let A := integralClosureCarrier_local (K := K)
  let n : ℕ := (Nat.card G).factorization (p : ℕ)
  let l : ℕ := Nat.card G / (p : ℕ) ^ n
  rw [Ideal.mem_span_singleton] at ha ⊢
  rcases ha with ⟨b, hb⟩
  refine ⟨b, ?_⟩
  have hcard : (p : ℕ) ^ n * l = Nat.card G := by
    -- This is exactly LinearRepresentations_Serre_1977's factorization `|G| = p^n l`.
    simpa [n, l] using Nat.ordProj_mul_ordCompl_eq_self (Nat.card G) (p : ℕ)
  calc
    ((l : A) * (a - 1)) = (l : A) * ((((p : ℕ) ^ n : ℕ) : A) * b) := by rw [hb]
    _ = ((((p : ℕ) ^ n * l : ℕ) : A) * b) := by
          simp [Nat.cast_mul, mul_assoc, mul_left_comm, mul_comm]
    _ = ((Nat.card G : ℕ) : A) * b := by rw [hcard]

/-- Helper for Theorem 12-12.6-2: once an `A`-valued lift realizes an element of
`A ⊗ V_{K,p}`, the lift itself is already constant on LinearRepresentations_Serre_1977's `Γ_K`-power classes. This is the
transport-stable form needed before building the final cyclic-descent defect function. -/
private theorem lift_isConstantOnGaloisPowerClasses_of_mem_gammaP_scalarExtension_local
    (p : ℕ)
    {u : G → K}
    {gu : G → integralClosureCarrier_local (K := K)}
    (hu :
      u ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) p)
    (hgu_map :
      ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ gu) = u) :
    IsConstantOnGaloisPowerClasses ΓK gu := by
  admit

/-- Helper for Theorem 12-12.6-2: the final defect function
`δ(s) = c * (gu s - 1)` is constant on `Γ_K`-power classes as soon as `gu` realizes an owner
element of `A ⊗ V_{K,p}`. The global `1 mod pA` congruence is used later for ideal membership,
not for this constancy step. -/
private theorem delta_isConstantOnGaloisPowerClasses_of_global_one_mod_witness_local
    (p : ℕ)
    {u : G → K}
    {gu : G → integralClosureCarrier_local (K := K)}
    (hu :
      u ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) p)
    (hgu_map :
      ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ gu) = u)
    (c : integralClosureCarrier_local (K := K)) :
    IsConstantOnGaloisPowerClasses ΓK (fun s : G ↦ c * (gu s - 1)) := by
  have hgu_const :
      IsConstantOnGaloisPowerClasses ΓK gu :=
    lift_isConstantOnGaloisPowerClasses_of_mem_gammaP_scalarExtension_local
      (K := K) (G := G) (p := p) hu hgu_map
  refine ⟨?_⟩
  intro s t hst
  -- Once the lift is constant on `Γ_K`-classes, the defect function is constant by a direct
  -- coefficientwise rewrite.
  have hgu_eq : gu s = gu t := hgu_const.eq_of_mk_eq hst
  simp [hgu_eq]

/-- Helper for Theorem 12-12.6-2: the subgroup action indexed by the identity element of `Γ_K`
acts trivially on powers. -/
private theorem pow_subgroup_one_eq_self_local
    (x : G) :
    x ^ (1 : ΓK) = x := by
  -- The identity unit corresponds to the exponent `1`, so the induced power is the original
  -- element.
  rw [pow_subgroup_eq_pow_nat]
  change x ^ ((1 : ZMod (Monoid.exponent G)).val) = x
  have hpow : x ^ (1 % Monoid.exponent G) = x ^ 1 := by
    simpa using (Eq.symm (@Monoid.pow_eq_mod_exponent G _ 1 x))
  simpa [ZMod.val_one_eq_one_mod] using hpow

/-- Helper for Theorem 12-12.6-2: a cyclic subgroup of `G` is already `Γ_K`-`p`-elementary for
every prime `p`. The `p`-Sylow subgroup supplies the `p`-part and Schur-Zassenhaus supplies the
prime-to-`p` complement; commutativity of the cyclic subgroup makes the `Γ_K`-action trivial. -/
private theorem cyclicSubgroup_isGammaPElementary_local
    (p : Nat.Primes)
    (H : { H : Subgroup G // IsCyclic H }) :
    Subgroup.IsGammaPElementary ΓK (p : ℕ) H.1 := by
  admit

/-- Helper for Theorem 12-12.6-2: induction from a cyclic subgroup already lands in the fixed-`p`
owner `V_{K,p}` because cyclic subgroups are `Γ_K`-`p`-elementary. -/
private theorem cyclic_characterRingInduction_mem_gammaPImage_local
    (p : Nat.Primes)
    (H : { H : Subgroup G // IsCyclic H })
    (ψ : R[K](H.1)) :
    H.1.characterRingOverFieldInduction K ψ ∈
      gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ) := by
  admit

/-- Helper for Theorem 12-12.6-2: on one direct-sum summand, the cyclic-subgroup induction owner
map is the corresponding subgroup scalar-extension induction map. -/
private theorem cyclicSubgroupInduction_single_local
    {A : Type w} [CommRing A] [Algebra A K]
    [DecidableEq { H : Subgroup G // IsCyclic H }]
    (H : { H : Subgroup G // IsCyclic H })
    (χ : A ⊗R[K](H.1)) :
    cyclicSubgroupInduction (K := K) (G := G) (A := A) (DFinsupp.single H χ) =
      H.1.characterRingOverFieldAlgebraScalarExtensionInduction χ := by
  classical
  -- This is the direct `DFinsupp.single` evaluation rule for the total cyclic induction map.
  rw [cyclicSubgroupInduction, DFinsupp.lsum]
  exact DFinsupp.sumAddHom_single
    (fun J ↦ (J.1.characterRingOverFieldAlgebraScalarExtensionInduction).toAddMonoidHom) H χ

/-- Helper for Theorem 12-12.6-2: induction from any `Γ_K`-`p`-elementary subgroup already lies
in the realized scalar extension `A ⊗ V_{K,p}`. This is the generic owner bridge used for cyclic
subgroups in the final Lemma `15` endgame. -/
private theorem induced_gammaPElementary_character_mem_gammaP_scalarExtension_local
    {A : Type w} [CommRing A] [Algebra A K]
    (p : Nat.Primes)
    {H : Subgroup G}
    (hHgamma : Subgroup.IsGammaPElementary ΓK (p : ℕ) H) :
    ∀ ψ : A ⊗R[K](H),
      (((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
          (A := A) (K := K) (H := H) ψ :
            A ⊗R[K](G)) : G → K)) ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := A) (p : ℕ) := by
  admit

/-- Helper for Theorem 12-12.6-2: every value in the range of the cyclic-descent owner map already
lies in the realized scalar extension `A ⊗ V_{K,p}`. This is the exact owner bridge needed after
applying LinearRepresentations_Serre_1977's Lemma `15`. -/
private theorem cyclicSubgroupInduction_range_le_gammaP_scalarExtension_local
    {A : Type w} [CommRing A] [Algebra A K]
    (p : Nat.Primes) :
    LinearMap.range
        (((A ⊗R[K](G)).subtype.comp
          (cyclicSubgroupInduction (K := K) (G := G) (A := A)))) ≤
      gammaPElementaryInducedCharacterScalarExtension_local
        (K := K) (G := G) (A := A) (p : ℕ) := by
  admit

/-- Helper for Theorem 12-12.6-2: LinearRepresentations_Serre_1977's Lemma `15` lands in the theorem-local owner once its
cyclic-descent output is repackaged through the previous range bridge. -/
private theorem groupOrderIdeal_classFunction_mem_gammaP_scalarExtension_local
    (p : Nat.Primes)
    (f : G → integralClosureCarrier_local (K := K))
    (hf : IsConstantOnGaloisPowerClasses ΓK f)
    (hfg :
      ∀ s : G,
        f s ∈
          Ideal.span
            ({((Nat.card G : ℕ) : integralClosureCarrier_local (K := K))} :
              Set (integralClosureCarrier_local (K := K)))) :
    ((algebraMap (integralClosureCarrier_local (K := K)) K) ∘ f) ∈
      gammaPElementaryInducedCharacterScalarExtension_local
        (K := K) (G := G) (A := integralClosureCarrier_local (K := K)) (p : ℕ) := by
  admit

/-- Helper for Theorem 12-12.6-2: the remaining source-faithful frontier is to build the constant
prime-to-`p` function in LinearRepresentations_Serre_1977's realized scalar extension `A ⊗ V_{K,p}`. -/
private theorem exists_primeToPPart_constant_mem_gammaP_scalarExtension_local
    (p : Nat.Primes) :
    ∃ N : ℕ, Nat.Coprime p N ∧
      (fun _ : G ↦ (N : K)) ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := ↥(integralClosure ℤ K)) (p : ℕ) := by
  admit

/-- Helper for Theorem 12-12.6-2: Brauer's fixed-`p` witness should first be proved on the unit
character before ideal stability extends it to all of `R_K(G)`. -/
private theorem exists_coprime_scalar_smul_one_mem_gammaPElementaryInducedCharacterSpan
    (p : Nat.Primes) :
    ∃ N : ℕ, Nat.Coprime p N ∧
      N • (1 : R[K](G)) ∈ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ) := by
  admit

/-- Helper for Theorem 12-12.6-2: once `R_K(G)` is known to be finitely generated over `ℤ`,
torsion-freeness upgrades it to a free module. -/
private theorem characterRingOverField_free_of_finite_local
    [Module.Finite ℤ (R[K](G))] :
    Module.Free ℤ (R[K](G)) := by
  letI : Module.IsTorsionFree ℤ (R[K](G)) := by
    exact Submodule.instIsTorsionFree (p := (R[K](G)).toSubmodule)
  -- Over the PID `ℤ`, finite type plus torsion-free yields a basis.
  obtain ⟨d, b⟩ := Module.basisOfFiniteTypeTorsionFree' (R := ℤ) (M := R[K](G))
  exact Module.Free.of_basis b

/-- Helper for Theorem 12-12.6-2: choose a finite complete irreducible family after scalar
extension to the algebraic closure. -/
private theorem exists_finite_complete_irreducible_family_rep_algebraicClosure_local :
    ∃ (ι : Type (max u w)) (_ : Fintype ι)
      (π : ι → Rep.{max u w} (AlgebraicClosure K) G),
      (∀ i, FiniteDimensional (AlgebraicClosure K) (π i)) ∧
      (∀ τ : Rep.{max u w} (AlgebraicClosure K) G,
        FiniteDimensional (AlgebraicClosure K) τ →
        τ.ρ.IsIrreducible →
        ∃ i, Nonempty (τ.ρ.Equiv (π i).ρ)) := by
  classical
  have hcard_ne : (Nat.card G : AlgebraicClosure K) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  letI : NeZero (Nat.card G : AlgebraicClosure K) := ⟨hcard_ne⟩
  obtain ⟨ι, _, σ, hσ_indep, hσ_top, hσ_irr⟩ :=
    exists_isInternal_irreducible_subrepresentations
      (ρ := leftRegular (AlgebraicClosure K) G)
  let π : ι → Rep.{max u w} (AlgebraicClosure K) G := fun i ↦ Rep.of (σ i).toRepresentation
  let hinternal : DirectSum.IsInternal (fun i ↦ (σ i).toSubmodule) :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hσ_indep hσ_top
  have hπfd : ∀ i, FiniteDimensional (AlgebraicClosure K) (π i) := by
    intro i
    -- Each irreducible summand of the regular representation is finite-dimensional.
    letI : (π i).ρ.IsIrreducible := by
      simpa [π] using hσ_irr i
    exact Representation.IsIrreducible.finiteDimensional_of_finite (ρ := (π i).ρ)
  refine ⟨ι, inferInstance, π, hπfd, ?_⟩
  intro τ hτfd hτirr
  letI : FiniteDimensional (AlgebraicClosure K) τ := hτfd
  letI : τ.ρ.IsIrreducible := hτirr
  have hτ_nontrivial : ¬ Subsingleton τ := by
    -- An irreducible representation cannot have trivial underlying module.
    intro hsub
    have hbot_top :
        (⊥ : Subrepresentation τ.ρ).toSubmodule =
          (⊤ : Subrepresentation τ.ρ).toSubmodule := by
      ext x
      constructor
      · intro _
        trivial
      · intro _
        simpa using (Subsingleton.elim x 0)
    exact IsSimpleOrder.bot_ne_top <| Subrepresentation.toSubmodule_injective hbot_top
  letI : Nontrivial τ := not_subsingleton_iff_nontrivial.mp hτ_nontrivial
  let τρ : Representation (AlgebraicClosure K) G τ := τ.ρ
  have hmult :
      Nat.card { i // Nonempty ((σ i).toRepresentation.Equiv τ.ρ) } =
        Module.finrank (AlgebraicClosure K) τ := by
    calc
      Nat.card { i // Nonempty ((σ i).toRepresentation.Equiv τ.ρ) } =
          Module.finrank (AlgebraicClosure K)
            ((leftRegular (AlgebraicClosure K) G).IntertwiningMap τρ) := by
              simpa [τρ] using
                card_isomorphic_irreducible_summands_eq_finrank_intertwiningMap
                  (leftRegular (AlgebraicClosure K) G) σ hinternal hσ_irr τρ hτirr
      _ = Module.finrank (AlgebraicClosure K) τ := by
            simpa [τρ] using (leftRegularMapEquiv τρ).finrank_eq
  have hmult' :
      Fintype.card { i // Nonempty ((σ i).toRepresentation.Equiv τ.ρ) } =
        Module.finrank (AlgebraicClosure K) τ := by
    simpa [Nat.card_eq_fintype_card] using hmult
  have hnonempty : Nonempty { i // Nonempty ((σ i).toRepresentation.Equiv τ.ρ) } := by
    rw [← Fintype.card_pos_iff, hmult']
    exact Module.finrank_pos
  rcases hnonempty with ⟨⟨i, hi⟩⟩
  rcases hi with ⟨e⟩
  refine ⟨i, ?_⟩
  simpa [π] using (show Nonempty (τ.ρ.Equiv (σ i).toRepresentation) from ⟨e.symm⟩)

/-- Helper for Theorem 12-12.6-2: a finite complete family over the algebraic closure spans the
character of every finite-dimensional representation. -/
private theorem rep_character_mem_function_span_complete_rep_family_local
    {ι : Type (max u v)} [Finite ι]
    (π : ι → Rep.{max u v} (AlgebraicClosure K) G)
    (hπ_complete :
      ∀ τ : Rep.{max u v} (AlgebraicClosure K) G,
        FiniteDimensional (AlgebraicClosure K) τ →
        τ.ρ.IsIrreducible →
        ∃ i, Nonempty (τ.ρ.Equiv (π i).ρ))
    {V : Type (max u v)} [AddCommGroup V] [Module (AlgebraicClosure K) V]
    (ρ : Representation (AlgebraicClosure K) G V) [FiniteDimensional (AlgebraicClosure K) V] :
    ρ.character ∈ Submodule.span ℤ (Set.range fun i ↦ (π i).ρ.character) := by
  classical
  have hcard_ne : (Nat.card G : AlgebraicClosure K) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  letI : NeZero (Nat.card G : AlgebraicClosure K) := ⟨hcard_ne⟩
  obtain ⟨κ, _, σ, hσ_indep, hσ_top, hσ_irr⟩ :=
    (exists_isInternal_irreducible_subrepresentations (ρ := ρ) :
      ∃ (κ : Type (max u v)) (_ : Fintype κ) (σ : κ → Subrepresentation ρ),
        iSupIndep (fun i ↦ (σ i).toSubmodule) ∧
          (⨆ i, (σ i).toSubmodule) = ⊤ ∧
          ∀ i, (σ i).toRepresentation.IsIrreducible)
  let hinternal : DirectSum.IsInternal (fun i : κ ↦ (σ i).toSubmodule) :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hσ_indep hσ_top
  have hchar :
      ρ.character = ∑ i : κ, ((σ i).toRepresentation).character := by
    -- Decompose the trace along the internal direct sum of irreducible summands.
    ext g
    simpa [Representation.character] using
      (LinearMap.trace_eq_sum_trace_restrict
        (R := AlgebraicClosure K) (M := V) (N := fun i ↦ (σ i).toSubmodule) hinternal
        (f := ρ g) (hf := fun i ↦ (σ i).apply_mem_toSubmodule g))
  rw [hchar]
  -- Completeness identifies each irreducible summand with one member of the finite family.
  refine Submodule.sum_mem _ ?_
  intro i _
  let τ : Rep.{max u v} (AlgebraicClosure K) G := Rep.of (σ i).toRepresentation
  have hτfd : FiniteDimensional (AlgebraicClosure K) τ := by
    letI : τ.ρ.IsIrreducible := by
      simpa [τ] using hσ_irr i
    exact Representation.IsIrreducible.finiteDimensional_of_finite (ρ := τ.ρ)
  obtain ⟨j, hj⟩ := hπ_complete τ hτfd (by simpa [τ] using hσ_irr i)
  rcases hj with ⟨e⟩
  have hchar_eq : ((σ i).toRepresentation).character = (π j).ρ.character := by
    simpa [τ] using Representation.char_iso e
  rw [hchar_eq]
  exact
    (Finsupp.mem_span_range_iff_exists_finsupp
      (R := ℤ) (v := fun i : ι ↦ (π i).ρ.character)).2 <| by
        refine ⟨Finsupp.single j 1, ?_⟩
        ext g
        simp

/-- Helper for Theorem 12-12.6-2: the algebraic-closure character ring is finitely generated as a
`ℤ`-module. -/
private theorem characterRingOverAlgebraicClosure_toSubmodule_fg_local :
    (R[AlgebraicClosure K](G)).toSubmodule.FG := by
  classical
  obtain ⟨ι, _, π, _hπfd, hπ_complete⟩ :=
    exists_finite_complete_irreducible_family_rep_algebraicClosure_local (K := K) (G := G)
  let S : Set (G → AlgebraicClosure K) := Set.range fun i ↦ (π i).ρ.character
  have hmul_span :
      ∀ {f g : G → AlgebraicClosure K},
        f ∈ Submodule.span ℤ S →
        g ∈ Submodule.span ℤ S →
        f * g ∈ Submodule.span ℤ S := by
    intro f g hf hg
    have hleft : ∀ g : G → AlgebraicClosure K,
        g ∈ Submodule.span ℤ S → f * g ∈ Submodule.span ℤ S := by
      induction hf using Submodule.span_induction with
      | mem ψ hψ =>
          rcases hψ with ⟨i, rfl⟩
          intro g hg
          induction hg using Submodule.span_induction with
          | mem ξ hξ =>
              rcases hξ with ⟨j, rfl⟩
              let τ : Representation (AlgebraicClosure K) G
                  ((π i) ⊗[AlgebraicClosure K] (π j)) :=
                Representation.tprod (π i).ρ (π j).ρ
              have hτ :
                  τ.character ∈ Submodule.span ℤ S :=
                rep_character_mem_function_span_complete_rep_family_local
                  (K := K) (G := G) π hπ_complete τ
              have hprod :
                  (π i).ρ.character * (π j).ρ.character = τ.character := by
                simpa [τ] using
                  tprod_character_eq_mul (G := G) (π i).ρ (π j).ρ
              exact hprod.symm ▸ hτ
          | zero =>
              simpa using
                (Submodule.zero_mem (Submodule.span ℤ S) :
                  (0 : G → AlgebraicClosure K) ∈ Submodule.span ℤ S)
          | add ξ ζ _ _ hξ hζ =>
              simpa [mul_add] using
                Submodule.add_mem (Submodule.span ℤ S) hξ hζ
          | smul n ξ _ hξ =>
              simpa [zsmul_eq_mul, mul_assoc, mul_left_comm, mul_comm] using
                Submodule.smul_mem (Submodule.span ℤ S) n hξ
      | zero =>
          intro g hg
          simpa using
            (Submodule.zero_mem (Submodule.span ℤ S) :
              (0 : G → AlgebraicClosure K) ∈ Submodule.span ℤ S)
      | add f₁ f₂ _ _ hf₁ hf₂ =>
          intro g hg
          simpa [add_mul] using
            Submodule.add_mem (Submodule.span ℤ S) (hf₁ g hg) (hf₂ g hg)
      | smul n f' _ hf' =>
          intro g hg
          simpa [zsmul_eq_mul, mul_left_comm, mul_assoc] using
            Submodule.smul_mem (Submodule.span ℤ S) n (hf' g hg)
    exact hleft g hg
  have hle : (R[AlgebraicClosure K](G)).toSubmodule ≤ Submodule.span ℤ S := by
    intro χ hχ
    -- Close the character ring by showing the complete-family span is multiplicatively stable.
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hχ
    · intro ψ hψ
      rcases hψ with ⟨ρ, hρfd, _hρirr, rfl⟩
      letI : FiniteDimensional (AlgebraicClosure K) ρ := hρfd
      exact
        rep_character_mem_function_span_complete_rep_family_local
          (K := K) (G := G) π hπ_complete ρ.ρ
    · intro n
      let τ : Representation (AlgebraicClosure K) G (ULift.{u} (AlgebraicClosure K)) :=
        Representation.trivial (AlgebraicClosure K) G (ULift.{u} (AlgebraicClosure K))
      have hτ :
          τ.character ∈ Submodule.span ℤ S :=
        rep_character_mem_function_span_complete_rep_family_local
          (K := K) (G := G) π hπ_complete τ
      have hscalar :
          algebraMap ℤ (G → AlgebraicClosure K) n = n • τ.character := by
        ext g
        simp [τ, Representation.character, Representation.trivial]
      exact hscalar ▸ Submodule.smul_mem (Submodule.span ℤ S) n hτ
    · intro f g _ _ hf hg
      exact Submodule.add_mem (Submodule.span ℤ S) hf hg
    · intro f g _ _ hf hg
      exact hmul_span hf hg
  exact
    Submodule.FG.of_le
      (Submodule.fg_span (Set.toFinite S))
      hle

/-- Helper for Theorem 12-12.6-2: the algebraic-closure realization `\overline{R}_K(G)` is a
finitely generated `ℤ`-module. -/
private theorem overlineCharacterRingOverField_toSubmodule_fg_local :
    (overlineCharacterRingOverField K G).toSubmodule.FG := by
  -- The overline owner is a submodule of the finitely generated algebraic-closure character ring.
  exact
    Submodule.FG.of_le
      (characterRingOverAlgebraicClosure_toSubmodule_fg_local (G := G) (K := K))
      (fun χ hχ ↦ (mem_overlineCharacterRingOverField_iff (K := K) (G := G) χ).1 hχ |>.1)

/-- Helper for Theorem 12-12.6-2: the coefficientwise embedding from `K` to `\overline K`, viewed
as a `ℤ`-linear map on class functions. -/
private abbrev coefficientEmbeddingLinearMap_local :
    (G → K) →ₗ[ℤ] G → AlgebraicClosure K :=
  ((IsScalarTower.toAlgHom ℤ K (AlgebraicClosure K)).compLeft G).toLinearMap

/-- Helper for Theorem 12-12.6-2: the coefficientwise embedding into the algebraic closure is
injective on class functions. -/
private theorem coefficientEmbeddingLinearMap_injective_local :
    Function.Injective (coefficientEmbeddingLinearMap_local (K := K) (G := G)) := by
  -- Equality in the algebraic closure descends coefficientwise because `K → \overline K` is
  -- injective.
  intro f g hfg
  ext x
  have hx' :
      coefficientEmbeddingLinearMap_local (K := K) (G := G) f x =
        coefficientEmbeddingLinearMap_local (K := K) (G := G) g x := congrFun hfg x
  change algebraMap K (AlgebraicClosure K) (f x) =
    algebraMap K (AlgebraicClosure K) (g x) at hx'
  simpa using congrArg
    (fun y : K ↦ ((y : K) : L))
    (FaithfulSMul.algebraMap_injective K (AlgebraicClosure K) hx')

/-- Helper for Theorem 12-12.6-2: mapping the source-facing owner `\overline{R}_K(G)` along the
coefficient embedding recovers its algebraic-closure realization. -/
private theorem overlineCharacterRing_toSubmodule_map_coefficientEmbedding_local :
    (R̄[K](G)).toSubmodule.map (coefficientEmbeddingLinearMap_local (K := K) (G := G)) =
      (overlineCharacterRingOverField K G).toSubmodule := by
  -- Both sides are defined by the same coefficientwise image.
  ext χ
  constructor
  · rintro ⟨χK, hχK, rfl⟩
    exact ⟨χK, hχK, rfl⟩
  · rintro ⟨χK, hχK, rfl⟩
    exact ⟨χK, hχK, rfl⟩

/-- Helper for Theorem 12-12.6-2: finite generation descends from the algebraic-closure image
back to the source-facing owner `\overline{R}_K(G)`. -/
private theorem overlineCharacterRing_toSubmodule_fg_local :
    (R̄[K](G)).toSubmodule.FG := by
  -- Pull finite generation back along the injective coefficient embedding.
  exact
    Submodule.fg_of_fg_map_injective
      (coefficientEmbeddingLinearMap_local (K := K) (G := G))
      (coefficientEmbeddingLinearMap_injective_local (K := K) (G := G)) <| by
      simpa [overlineCharacterRing_toSubmodule_map_coefficientEmbedding_local (K := K) (G := G)]
        using overlineCharacterRingOverField_toSubmodule_fg_local (K := K) (G := G)

/-- Helper for Theorem 12-12.6-2: the ambient character ring `R_K(G)` is a finite free
`ℤ`-module. -/
private theorem characterRingOverField_free_and_finite_local :
    Module.Free ℤ (R[K](G)) ∧ Module.Finite ℤ (R[K](G)) := by
  -- Route correction: instead of searching for a basis directly over `K`, first descend finite
  -- generation from the algebraic-closure overline owner back to `R_K(G)`.
  have hRbar_fg : (R̄[K](G)).toSubmodule.FG :=
    overlineCharacterRing_toSubmodule_fg_local (G := G) (K := K)
  have hRK_fg : (R[K](G)).toSubmodule.FG := by
    -- `R_K(G)` is a submodule of the finitely generated overline owner.
    exact Submodule.FG.of_le hRbar_fg (characterRingOverField_le_overlineCharacterRing K G)
  letI : Module.Finite ℤ (R[K](G)) := Module.Finite.of_fg hRK_fg
  refine ⟨?_, inferInstance⟩
  -- Torsion-freeness over the PID `ℤ` upgrades finite generation to freeness.
  exact characterRingOverField_free_of_finite_local (G := G) (L := L) (K := K)

/-- Helper for Theorem 12-12.6-2: the remaining structural input for fixed `p` is a prime-to-`p`
annihilator of the quotient `R_K(G) / V_{K,p}`. -/
private theorem gammaPElementaryInducedCharacterSpan_quotient_annihilated
    (p : Nat.Primes) :
      ∃ N : ℕ, Nat.Coprime p N ∧
      ∀ χ : R[K](G),
        N • χ ∈ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ) := by
  rcases exists_coprime_scalar_smul_one_mem_gammaPElementaryInducedCharacterSpan
      (G := G) (L := L) (K := K) p with ⟨N, hNcoprime, hNone⟩
  refine ⟨N, hNcoprime, ?_⟩
  intro χ
  -- Once the unit witness is inside `V_{K,p}`, ideal stability transports it to every character.
  have hmul :
      χ * (N • (1 : R[K](G))) ∈
        gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ) :=
    mul_mem_gammaPElementaryInducedCharacterSpan
      (G := G) (L := L) (K := K) (p := (p : ℕ)) (χ := χ) hNone
  simpa [nsmul_eq_mul, mul_comm, mul_left_comm, mul_assoc] using hmul

/-- Helper for Theorem 12-12.6-2: a prime-to-`p` annihilator of `R_K(G) / V_{K,p}` forces the
fixed-`p` subgroup `V_{K,p}` to have finite index, and that index is itself prime to `p`. -/
private theorem gammaPElementaryInducedCharacterSpan_finiteIndex_and_index_coprime_aux
    (p : Nat.Primes)
    (hann :
      ∃ N : ℕ, Nat.Coprime p N ∧
        ∀ χ : R[K](G),
          N • χ ∈ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ)) :
    let Vkp := gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ)
    Vkp.toAddSubgroup.FiniteIndex ∧ Nat.Coprime p Vkp.toAddSubgroup.index := by
  classical
  let Vkp := gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ)
  rcases hann with ⟨N, hNcoprime, hNann⟩
  letI : Module.Free ℤ (R[K](G)) :=
    (characterRingOverField_free_and_finite_local (G := G) (L := L) (K := K)).1
  letI : Module.Finite ℤ (R[K](G)) :=
    (characterRingOverField_free_and_finite_local (G := G) (L := L) (K := K)).2
  have hN_ne_zero : N ≠ 0 := by
    intro hN0
    have hp_one : (p : ℕ) = 1 := by
      simpa [hN0] using hNcoprime
    exact p.2.ne_one hp_one
  let L : AddSubgroup (R[K](G)) := (nsmulAddMonoidHom (α := R[K](G)) N).range
  have hL_le : L ≤ Vkp.toAddSubgroup := by
    intro χ hχ
    rcases hχ with ⟨x, rfl⟩
    exact hNann x
  have hL_index : L.index = N ^ Module.finrank ℤ (R[K](G)) := by
    -- The ambient character ring is a free finite `ℤ`-module, so the `N`-multiple subgroup has
    -- the standard index `N ^ rank`.
    simpa [L] using AddSubgroup.index_range_nsmul (M := R[K](G)) N
  have hL_finite : L.FiniteIndex := by
    rw [AddSubgroup.finiteIndex_iff, hL_index]
    exact pow_ne_zero _ hN_ne_zero
  have hfinite : Vkp.toAddSubgroup.FiniteIndex :=
    AddSubgroup.finiteIndex_of_le hL_le
  constructor
  · exact hfinite
  · have hdiv : Vkp.toAddSubgroup.index ∣ N ^ Module.finrank ℤ (R[K](G)) := by
      letI : L.FiniteIndex := hL_finite
      exact (AddSubgroup.index_dvd_of_le hL_le).trans (dvd_of_eq hL_index)
    exact Nat.Coprime.of_dvd_right hdiv (hNcoprime.pow_right _)

/-- Helper for Theorem 12-12.6-2: the fixed-`p` subgroup `V_{K,p}` has finite index in `R_K(G)`
and its index is prime to `p`. -/
theorem gammaPElementaryInducedCharacterSpan_finiteIndex_and_index_coprime
    (p : Nat.Primes) :
    let Vkp := gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ)
    Vkp.toAddSubgroup.FiniteIndex ∧ Nat.Coprime p Vkp.toAddSubgroup.index := by
  -- Reduce the public fixed-`p` theorem to the purely additive index argument once the quotient
  -- annihilator has been assembled.
  exact gammaPElementaryInducedCharacterSpan_finiteIndex_and_index_coprime_aux
    (G := G) (L := L) (K := K) p
    (gammaPElementaryInducedCharacterSpan_quotient_annihilated
      (G := G) (L := L) (K := K) p)

/-- Helper for Theorem 12-12.6-3: the quotient `R_K(G) / V_{K,p}` is annihilated by a scalar
prime to `p`. This is the public fixed-`p` annihilator exported from the source-faithful proof of
Theorem `12-12.6-2`. -/
theorem exists_coprime_scalar_smul_mem_gammaPElementaryInducedCharacterSpan
    (p : Nat.Primes) :
    ∃ N : ℕ, Nat.Coprime p N ∧
      ∀ χ : R[K](G),
        N • χ ∈ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ) := by
  -- Export the already-assembled quotient annihilator unchanged, so later items can reuse the
  -- source theorem without reopening private Section `12.6.2` internals.
  exact gammaPElementaryInducedCharacterSpan_quotient_annihilated
    (G := G) (L := L) (K := K) p

/-- Helper for Theorem 12-12.6-3: the group-order multiple of the trivial character already lies
in the fixed-`p` subgroup `V_{K,p}` because every cyclic induction summand is `Γ_K`-`p`-elementary.
-/
theorem groupOrder_smul_one_mem_gammaPElementaryInducedCharacterSpan
    (p : Nat.Primes) :
    Nat.card G • (1 : R[K](G)) ∈
      gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ) := by
  let A := integralClosureCarrier_local (K := K)
  let f : G → A := fun _ ↦ ((Nat.card G : ℕ) : A)
  have hf_const : IsConstantOnGaloisPowerClasses ΓK f := by
    refine ⟨?_⟩
    intro s t hst
    rfl
  have hf_values :
      ∀ s : G,
        f s ∈ Ideal.span ({((Nat.card G : ℕ) : A)} : Set A) := by
    intro s
    -- Every constant value is the generator of the principal ideal `|G|A`.
    exact Ideal.subset_span (by simp [f])
  have hf_mem :
      ((algebraMap A K) ∘ f) ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := A) (p : ℕ) :=
    groupOrderIdeal_classFunction_mem_gammaP_scalarExtension_local
      (G := G) (L := L) (K := K) p f hf_const hf_values
  have hconst :
      (fun _ : G ↦ ((Nat.card G : ℕ) : K)) ∈
        gammaPElementaryInducedCharacterScalarExtension_local
          (K := K) (G := G) (A := A) (p : ℕ) := by
    -- Evaluate the algebra map on the constant `|G|`-valued lift.
    simpa [f, A]
      using hf_mem
  -- Descend the scalar-extension witness for the constant function `|G|` to the owner
  -- `V_{K,p} ≤ R_K(G)`.
  simpa [A] using
    constantCharacter_mem_gammaPImage_of_mem_scalarExtension_local
      (G := G) (K := K) (A := A) (p := (p : ℕ)) (l := Nat.card G) hconst

/-- Helper for Theorem 12-12.6-2: every fixed-`p` induction generator already lies in the range
of the total `Γ_K`-elementary direct-sum induction map. -/
lemma gammaPElementaryInducedCharacterSpan_le_gammaElementarySubgroupInduction_range
    (p : ℕ) :
    gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) p ≤
      LinearMap.range (gammaElementarySubgroupInductionOverField K ΓK) := by
  classical
  let _ : DecidablePred (fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H) :=
    Classical.decPred _
  change inducedCharacterSubmoduleOverField K
      (Finset.univ.filter fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H) ≤
    LinearMap.range (gammaElementarySubgroupInductionOverField K ΓK)
  refine iSup_le ?_
  intro H χ hχ
  rcases hχ with ⟨ψ, rfl⟩
  have hHp : Subgroup.IsGammaPElementary ΓK p H.1 := by
    exact (Finset.mem_filter.mp H.2).2
  -- Insert the subgroup summand using a single `DFinsupp.single` witness at the corresponding
  -- `Γ_K`-elementary index.
  refine ⟨DFinsupp.single ⟨H.1, hHp.isGammaElementary⟩ ψ, ?_⟩
  simpa using
    gammaElementarySubgroupInductionOverField_single
      (K := K) ΓK ⟨H.1, hHp.isGammaElementary⟩ ψ

/-- Helper for Theorem 12-12.6-2: the supremum of the fixed-`p` subgroups `V_{K,p}` is the whole
character ring `R_K(G)`. -/
theorem iSup_gammaPElementaryInducedCharacterSpan_eq_top :
    (⨆ p : Nat.Primes, gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ)) = ⊤ := by
  let W : Submodule ℤ R[K](G) :=
    ⨆ p : Nat.Primes, gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ)
  have hW_index : W.toAddSubgroup.index = 1 := by
    refine (Nat.eq_one_iff_not_exists_prime_dvd).2 ?_
    intro p hp hpdvd
    let q : Nat.Primes := ⟨p, hp⟩
    have hVq_le : gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (q : ℕ) ≤ W :=
      le_iSup
        (fun r : Nat.Primes ↦ gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (r : ℕ)) q
    have hW_dvd :
        W.toAddSubgroup.index ∣
          (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (q : ℕ)).toAddSubgroup.index :=
      AddSubgroup.index_dvd_of_le hVq_le
    have hq_coprime :
        Nat.Coprime p
          (gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (q : ℕ)).toAddSubgroup.index := by
      simpa using (gammaPElementaryInducedCharacterSpan_finiteIndex_and_index_coprime
        (G := G) (L := L) (K := K) q).2
    have hW_coprime : Nat.Coprime p W.toAddSubgroup.index :=
      Nat.Coprime.of_dvd_right hW_dvd hq_coprime
    exact (hp.coprime_iff_not_dvd.1 hW_coprime) hpdvd
  -- An index coprime to every prime is `1`, so the supremum is all of `R_K(G)`.
  simpa [W] using
    (Submodule.toAddSubgroup_eq_top.1 (AddSubgroup.index_eq_one.1 hW_index))

-- Proof sketch: this is Brauer induction over the intermediate field `K`: every element of
-- `R_K(G)` is an integral linear combination of virtual characters induced from `Γ_K`-elementary
-- subgroups for the arithmetic subgroup `Γ_K = Γ[K](G)`, so the image of the direct-sum
-- induction map is all of `R_K(G)`.
/-- Theorem 12-12.6-2: the induction map
`Ind : ⨁_{H ∈ X_K} R_K(H) → R_K(G)` is surjective, where `X_K` is the set of
`Γ_K`-elementary subgroups of `G`, with `Γ_K = Γ[K](G) ⊆ (ℤ / mℤ)ˣ` attached to the
intermediate field `K` inside a cyclotomic realization of the exponent of `G`. -/
theorem gammaElementarySubgroupInductionOverField_surjective
    : Function.Surjective (gammaElementarySubgroupInductionOverField K ΓK) := by
  let W : Submodule ℤ R[K](G) :=
    ⨆ p : Nat.Primes, gammaPElementaryInducedCharacterSpan_local (K := K) (G := G) (p : ℕ)
  have hW_top : W = ⊤ := by
    -- First identify the supremum of the fixed-`p` spans with the whole character ring.
    simpa [W] using iSup_gammaPElementaryInducedCharacterSpan_eq_top (G := G) (L := L) (K := K)
  have hW_le : W ≤ LinearMap.range (gammaElementarySubgroupInductionOverField K ΓK) := by
    -- Each fixed-`p` piece already lies in the range of the total induction map.
    refine iSup_le ?_
    intro p
    exact gammaPElementaryInducedCharacterSpan_le_gammaElementarySubgroupInduction_range
      (G := G) (L := L) (K := K) (p := (p : ℕ))
  have hrange_top : LinearMap.range (gammaElementarySubgroupInductionOverField K ΓK) = ⊤ := by
    -- The total induction range contains a supremum equal to `⊤`, hence it is itself `⊤`.
    apply top_unique
    calc
      ⊤ = W := hW_top.symm
      _ ≤ LinearMap.range (gammaElementarySubgroupInductionOverField K ΓK) := hW_le
  simpa using LinearMap.range_eq_top.1 hrange_top

end

end

