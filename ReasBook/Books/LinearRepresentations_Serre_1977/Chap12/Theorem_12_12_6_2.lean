variable {K : Type v} [Field K] [CharZero K]
variable {G : Type u} [Group G] [Finite G]

local instance : Fintype G := Fintype.ofFinite G

/-- Helper for Theorem 12-12.6-2: a theorem-local `Fintype` witness for subgroup carriers. -/
private def instFintypeTheorem121262Subgroup (H : Subgroup G) : Fintype H :=
  Fintype.ofFinite H
attribute [local instance] instFintypeTheorem121262Subgroup

local instance
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) :
    DecidableEq { H : Subgroup G // Subgroup.IsGammaElementary ΓK H } :=
  Classical.decEq _

local instance
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    (H : { H : Subgroup G // Subgroup.IsGammaElementary ΓK H }) (χ : R[K](H.1)) :
    Decidable (χ ≠ 0) := by
  classical
  infer_instance

/-- Bridge/view: for an arbitrary subgroup `ΓK ⊆ (ℤ / mℤ)ˣ`, the direct-sum induction map from
the `ΓK`-elementary subgroups of `G` into `R_K(G)`. -/
def gammaElementarySubgroupInductionOverField
    (K : Type v) [Field K] [CharZero K] (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) :
    (Π₀ H : { H : Subgroup G // Subgroup.IsGammaElementary ΓK H }, R[K](H.1)) →ₗ[ℤ] R[K](G) :=
  open Classical in
    DFinsupp.lsum ℤ fun H ↦ H.1.characterRingOverFieldInduction K

/-- On a single `Γ_K`-elementary summand, the total induction map is the corresponding subgroup
induction map. -/
theorem gammaElementarySubgroupInductionOverField_single
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ)
    (H : { H : Subgroup G // Subgroup.IsGammaElementary ΓK H }) (χ : R[K](H.1)) :
    gammaElementarySubgroupInductionOverField K ΓK (DFinsupp.single H χ) =
      H.1.characterRingOverFieldInduction K χ := by
  classical
  simp [gammaElementarySubgroupInductionOverField]

/-- Evaluating the `Γ_K`-elementary induction map is the finite sum of the subgroup induction maps
over the support of the direct-sum input. -/
theorem gammaElementarySubgroupInductionOverField_apply
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ)
    (χ : Π₀ H : { H : Subgroup G // Subgroup.IsGammaElementary ΓK H }, R[K](H.1)) :
    gammaElementarySubgroupInductionOverField K ΓK χ =
      χ.sum fun H ↦ (H.1.characterRingOverFieldInduction K).toAddMonoidHom := by
  classical
  change
    DFinsupp.sumAddHom
        (fun H ↦ (H.1.characterRingOverFieldInduction K).toAddMonoidHom) χ =
      χ.sum fun H ↦ (H.1.characterRingOverFieldInduction K).toAddMonoidHom
  exact DFinsupp.sumAddHom_apply
    (fun H ↦ (H.1.characterRingOverFieldInduction K).toAddMonoidHom)
    χ

/-- Helper for Theorem 12-12.6-2: the cyclic-subgroup induction owner map on scalar-extended
character rings. -/
private def cyclicSubgroupInduction
    {A : Type v} [CommRing A] [Algebra A K] :
    (Π₀ H : { H : Subgroup G // IsCyclic H }, A ⊗R[K](H.1)) →ₗ[A] A ⊗R[K](G) :=
  open Classical in
    DFinsupp.lsum A fun H ↦ H.1.characterRingOverFieldAlgebraScalarExtensionInduction

