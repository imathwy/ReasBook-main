import Mathlib
import LinearRepresentations_Serre_1977.Chap01.Theorem_1_1_4_2
import LinearRepresentations_Serre_1977.Chap12.Definition_12_12_6_1
import LinearRepresentations_Serre_1977.Chap12.Theorem_12_12_4_1
import LinearRepresentations_Serre_1977.RepresentationTheory.RealizableOver

open Representation
open scoped Pointwise Representation

noncomputable section

universe u

section Group

variable {G : Type u} [Group G] [NeZero (Monoid.exponent G)]

local notation "C(" x ")" => Subgroup.zpowers x

omit [NeZero (Monoid.exponent G)] in
private theorem pow_subgroup_one_eq_self
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ} (x : G) : x ^ (1 : ΓK) = x := by
  rw [pow_subgroup_eq_pow_nat]
  change x ^ ((1 : ZMod (Monoid.exponent G)).val) = x
  have hpow : x ^ (1 % Monoid.exponent G) = x ^ 1 := by
    simpa using (Eq.symm (@Monoid.pow_eq_mod_exponent G _ 1 x))
  simpa [ZMod.val_one_eq_one_mod] using hpow

omit [NeZero (Monoid.exponent G)] in
private theorem pow_subgroup_mul
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ} (x : G) (t u : ΓK) :
    (x ^ t) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) = x ^ (t * u) := by
  rw [pow_subgroup_eq_pow_nat, ← pow_mul, pow_subgroup_eq_pow_nat]
  rw [Monoid.pow_eq_mod_exponent]
  simp [galoisPowerExponentUnit, ZMod.val_mul]

omit [NeZero (Monoid.exponent G)] in
private theorem pow_subgroup_mul_inv
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ} (x : G) (t : ΓK) :
    (x ^ t) ^ galoisPowerExponentUnit ((t⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ) = x := by
  calc
    (x ^ t) ^ galoisPowerExponentUnit ((t⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ)
        = x ^ (t * t⁻¹) := pow_subgroup_mul x t t⁻¹
    _ = x ^ (1 : ΓK) := by simp
    _ = x := pow_subgroup_one_eq_self x

/-- The subgroup `N(x)` of elements of `G` whose conjugation action sends `x` to a `Γ_K`-power of
itself. -/
def gammaNormalizer (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (x : G) : Subgroup G where
  carrier := { y : G | ∃ t : ΓK, y * x * y⁻¹ = x ^ t }
  one_mem' := by
    refine ⟨1, ?_⟩
    have hpow : x ^ (1 : ΓK) = x := pow_subgroup_one_eq_self x
    simpa using hpow.symm
  mul_mem' := by
    intro y z hy hz
    rcases hy with ⟨t, ht⟩
    rcases hz with ⟨u, hu⟩
    refine ⟨t * u, ?_⟩
    calc
      (y * z) * x * (y * z)⁻¹ = y * (z * x * z⁻¹) * y⁻¹ := by group
      _ = y * (x ^ u) * y⁻¹ := by rw [hu]
      _ = (y * x * y⁻¹) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) := by
        have hconj :
            (y * x * y⁻¹) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) =
              y * x ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) * y⁻¹ :=
          conj_pow
        simpa [pow_subgroup_eq_pow_nat] using hconj.symm
      _ = (x ^ t) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) := by rw [ht]
      _ = x ^ (t * u) := pow_subgroup_mul x t u
  inv_mem' := by
    intro y hy
    rcases hy with ⟨t, ht⟩
    refine ⟨t⁻¹, ?_⟩
    have hxt : y * (x ^ t⁻¹) * y⁻¹ = x := by
      calc
        y * (x ^ t⁻¹) * y⁻¹ =
            (y * x * y⁻¹) ^ galoisPowerExponentUnit ((t⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
              have hconj :
                  (y * x * y⁻¹) ^
                      galoisPowerExponentUnit ((t⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ) =
                    y * x ^
                        galoisPowerExponentUnit ((t⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ) * y⁻¹ :=
                conj_pow
              simpa [pow_subgroup_eq_pow_nat] using hconj.symm
        _ = (x ^ t) ^ galoisPowerExponentUnit ((t⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
          rw [ht]
        _ = x := pow_subgroup_mul_inv x t
    have hyinv : x ^ t⁻¹ = y⁻¹ * x * y := by
      simpa [mul_assoc] using congrArg (fun z : G ↦ y⁻¹ * z * y) hxt
    simpa using hyinv.symm

notation "N[" ΓK "](" x ")" => gammaNormalizer ΓK x

/-- The subgroup `H = C ⋅ P` associated with the cyclic subgroup `C = ⟨x⟩` and a Sylow
`p`-subgroup `P` of `N(x)`. -/
def associatedGammaPElementarySubgroup (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (x : G)
    {p : ℕ} (P : Sylow p N[ΓK](x)) : Subgroup G :=
  C(x) ⊔
    Subgroup.map N[ΓK](x).subtype (P : Subgroup N[ΓK](x))

-- Proof sketch: `associatedGammaPElementarySubgroup ΓK x P` is defined as the join of
-- `Subgroup.zpowers x` with the image of `P`, so the cyclic subgroup is one of its two defining
-- factors.
omit [NeZero (Monoid.exponent G)] in
/-- The cyclic subgroup generated by `x` is contained in the associated subgroup `H = C ⋅ P`. -/
theorem zpowers_le_associatedGammaPElementarySubgroup
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) (x : G)
    (P : Sylow p N[ΓK](x)) :
    C(x) ≤ associatedGammaPElementarySubgroup ΓK x P :=
  le_sup_left

section

variable [Finite G]

local instance : NeZero (Monoid.exponent G) := Monoid.neZero_exponent_of_finite

/-- Helper for Lemma 12-12.7-5: an element of `N(x)` conjugates every element of `⟨x⟩` by the
same `Γ_K`-power that it uses on the generator `x`. -/
theorem gammaNormalizer_conjugates_zpowers_by_power
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (x y : G)
    (hy : y ∈ N[ΓK](x)) :
    ∃ t : ΓK, ∀ c : C(x), y * (c : G) * y⁻¹ = (c : G) ^ t := by
  rcases hy with ⟨t, ht⟩
  refine ⟨t, ?_⟩
  intro c
  rcases Subgroup.mem_zpowers_iff.mp c.2 with ⟨n, hn⟩
  rw [hn.symm]
  calc
    y * (x ^ n) * y⁻¹ = (y * x * y⁻¹) ^ n := by
      simpa using (conj_zpow (a := y) (b := x) (i := n)).symm
    _ = (x ^ t) ^ n := by rw [ht]
    _ = x ^ (n * galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) := by
      rw [pow_subgroup_eq_pow_nat]
      rw [← zpow_natCast]
      simpa using
        (zpow_mul' x n (galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ) : ℤ)).symm
    _ = (x ^ n) ^ galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ) := by
      rw [← zpow_natCast]
      simpa using
        (zpow_mul x n (galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ) : ℤ))
    _ = (x ^ n) ^ t := by
      rw [pow_subgroup_eq_pow_nat]

-- Proof sketch: `C = ⟨x⟩` is cyclic and has order prime to `p` because `x` is `p'`; the Sylow
-- subgroup contributes the `p`-group factor; and the defining property of `N(x)` gives the
-- required `Γ_K`-power conjugation action of the `p`-group factor on `C`.
/-- Helper for Lemma 12-12.7-5: the associated subgroup carries the canonical `Γ_K`-`p`-elementary
decomposition whose cyclic factor is `⟨x⟩` and whose `p`-group factor is the image of the chosen
Sylow subgroup of `N(x)`. -/
theorem associatedGammaPElementarySubgroup_decomposition
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) [Fact p.Prime] (x : G)
    (hx : IsPRegular p x) (P : Sylow p N[ΓK](x)) :
    Subgroup.IsGammaPElementaryDecomposition ΓK p
      ((C(x)).subgroupOf (associatedGammaPElementarySubgroup ΓK x P))
      ((Subgroup.map N[ΓK](x).subtype (P : Subgroup N[ΓK](x))).subgroupOf
        (associatedGammaPElementarySubgroup ΓK x P)) := by
  let H := associatedGammaPElementarySubgroup ΓK x P
  let C₀ : Subgroup H := (C(x)).subgroupOf H
  let Pimg : Subgroup G := Subgroup.map N[ΓK](x).subtype (P : Subgroup N[ΓK](x))
  let P₀ : Subgroup H := Pimg.subgroupOf H
  have hz : C(x) ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
  have hPimg_le : Pimg ≤ H := le_sup_right
  have hPimg_pgroup : IsPGroup p Pimg :=
    P.isPGroup'.of_surjective
      (N[ΓK](x).subtype.subgroupMap (P : Subgroup N[ΓK](x)))
      (N[ΓK](x).subtype.subgroupMap_surjective (P : Subgroup N[ΓK](x)))
  have hP₀_pgroup : IsPGroup p P₀ :=
    hPimg_pgroup.of_equiv (Subgroup.subgroupOfEquivOfLe hPimg_le).symm
  have hPimg_normalizes : Pimg ≤ Subgroup.normalizer ↑(C(x)) := by
    intro y hy
    rw [Subgroup.mem_normalizer_iff]
    rcases Subgroup.mem_map.mp hy with ⟨z, hzP, rfl⟩
    rcases gammaNormalizer_conjugates_zpowers_by_power ΓK x z.1 z.2 with ⟨t, ht⟩
    intro c
    constructor
    · intro hc
      have hpow : N[ΓK](x).subtype z * c * (N[ΓK](x).subtype z)⁻¹ = c ^ t := by
        simpa using ht ⟨c, hc⟩
      rw [hpow, pow_subgroup_eq_pow_nat]
      exact Subgroup.pow_mem (C(x)) hc _
    · intro hc
      have hz_inv : z.1⁻¹ ∈ N[ΓK](x) := (N[ΓK](x)).inv_mem z.2
      rcases gammaNormalizer_conjugates_zpowers_by_power ΓK x z.1⁻¹ hz_inv with ⟨t, htInv⟩
      have hconjInv :
          (N[ΓK](x).subtype z)⁻¹ * (N[ΓK](x).subtype z * c * (N[ΓK](x).subtype z)⁻¹) *
              ((N[ΓK](x).subtype z)⁻¹)⁻¹ =
            (N[ΓK](x).subtype z * c * (N[ΓK](x).subtype z)⁻¹) ^ t := by
        simpa using htInv ⟨N[ΓK](x).subtype z * c * (N[ΓK](x).subtype z)⁻¹, hc⟩
      have hpow : c = (N[ΓK](x).subtype z * c * (N[ΓK](x).subtype z)⁻¹) ^ t := by
        calc
          c =
              (N[ΓK](x).subtype z)⁻¹ * (N[ΓK](x).subtype z * c * (N[ΓK](x).subtype z)⁻¹) *
                ((N[ΓK](x).subtype z)⁻¹)⁻¹ := by
              group
          _ = (N[ΓK](x).subtype z * c * (N[ΓK](x).subtype z)⁻¹) ^ t := hconjInv
      rw [hpow, pow_subgroup_eq_pow_nat]
      exact Subgroup.pow_mem (C(x)) hc _
  have hH_mul : (↑H : Set G) = (↑Pimg : Set G) * (↑(C(x)) : Set G) := by
    simpa [H, associatedGammaPElementarySubgroup, sup_comm] using
      (Subgroup.coe_mul_of_left_le_normalizer_right Pimg (C(x)) hPimg_normalizes)
  have hP₀C₀_mul_univ : ((↑P₀ : Set H) * (↑C₀ : Set H)) = Set.univ := by
    rw [Set.eq_univ_iff_forall]
    intro h
    change h ∈ (↑P₀ : Set H) * (↑C₀ : Set H)
    have hhG : ((h : H) : G) ∈ H := h.2
    have hhMul : ((h : H) : G) ∈ (↑Pimg : Set G) * (↑(C(x)) : Set G) := by
      have hhH : ((h : H) : G) ∈ (↑H : Set G) := hhG
      rwa [hH_mul] at hhH
    rcases Set.mem_mul.mp hhMul with ⟨u, hu, v, hv, huv⟩
    let uH : H := ⟨u, hPimg_le hu⟩
    let vH : H := ⟨v, hz hv⟩
    have huH : uH ∈ P₀ := Subgroup.mem_subgroupOf.mpr hu
    have hvH : vH ∈ C₀ := Subgroup.mem_subgroupOf.mpr hv
    refine Set.mem_mul.mpr ⟨uH, huH, vH, hvH, ?_⟩
    apply Subtype.ext
    exact huv
  have hC₀P₀_disjoint : Disjoint C₀ P₀ := by
    rw [disjoint_iff]
    ext z
    constructor
    · intro hzInf
      rw [Subgroup.mem_bot]
      rw [Subgroup.mem_inf] at hzInf
      have hzC : ((z : H) : G) ∈ C(x) := Subgroup.mem_subgroupOf.mp hzInf.1
      have hzPimg : ((z : H) : G) ∈ Pimg := Subgroup.mem_subgroupOf.mp hzInf.2
      have hzDiv : orderOf ((z : H) : G) ∣ orderOf x := by
        simpa [Subgroup.orderOf_mk, Nat.card_zpowers] using
          (orderOf_dvd_natCard (⟨((z : H) : G), hzC⟩ : C(x)))
      rcases (IsPGroup.iff_orderOf.mp hPimg_pgroup) (⟨((z : H) : G), hzPimg⟩ : Pimg) with
        ⟨n, hn⟩
      have hzOrder : orderOf ((z : H) : G) = p ^ n := by
        simpa [Subgroup.orderOf_mk] using hn
      have hzDiv' : p ^ n ∣ orderOf x := by
        exact hzOrder ▸ hzDiv
      have hzOne : orderOf ((z : H) : G) = 1 := by
        exact hzOrder.trans (Nat.Coprime.eq_one_of_dvd (hx.pow_left n) hzDiv')
      apply Subtype.ext
      exact orderOf_eq_one_iff.mp hzOne
    · intro hzBot
      rw [Subgroup.mem_inf]
      have hzOne : z = 1 := Subgroup.mem_bot.mp hzBot
      constructor <;> simpa [hzOne]
  have hP₀C₀ : P₀.IsComplement' C₀ :=
    Subgroup.isComplement'_of_disjoint_and_mul_eq_univ hC₀P₀_disjoint.symm hP₀C₀_mul_univ
  have hC₀_cyclic : IsCyclic C₀ := by
    letI : IsCyclic ↥(C(x)) := Subgroup.isCyclic_zpowers x
    exact
      isCyclic_of_surjective
        (Subgroup.subgroupOfEquivOfLe hz).symm.toMonoidHom
        (Subgroup.subgroupOfEquivOfLe hz).symm.surjective
  have hC₀_card : Nat.card C₀ = orderOf x := by
    simpa [C₀] using
      (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hz).toEquiv).trans (Nat.card_zpowers x)
  refine ⟨Fact.out, inferInstance, hC₀_cyclic, ?_, hP₀_pgroup, hP₀C₀.symm, ?_⟩
  · exact hC₀_card ▸ hx
  · intro y
    have hyPimg : (((y : P₀) : H) : G) ∈ Pimg := Subgroup.mem_subgroupOf.mp y.2
    rcases Subgroup.mem_map.mp hyPimg with ⟨z, hzP, hy_eq⟩
    rcases gammaNormalizer_conjugates_zpowers_by_power ΓK x z.1 z.2 with ⟨t, ht⟩
    refine ⟨t, ?_⟩
    intro c
    have hcC : (((c : C₀) : H) : G) ∈ C(x) := Subgroup.mem_subgroupOf.mp c.2
    have hy_cast : (((y : P₀) : H) : G) = z.1 := by
      simpa using hy_eq.symm
    calc
      (((y : P₀) : H) : G) * (((c : C₀) : H) : G) * (((y : P₀) : H) : G)⁻¹
          = z.1 * (((c : C₀) : H) : G) * z.1⁻¹ := by simp [hy_cast]
      _ = (((c : C₀) : H) : G) ^ t := ht ⟨(((c : C₀) : H) : G), hcC⟩

end

end Group
