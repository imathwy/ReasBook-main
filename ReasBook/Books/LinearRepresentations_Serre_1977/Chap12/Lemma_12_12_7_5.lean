        (gammaSubgroup_generator_value_mem_K_aroots_local
          (K := K) (x := x) β (1 : ΓK))
        (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
