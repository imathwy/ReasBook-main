set_option maxHeartbeats 800000 in
-- The chosen-constituent bridge expands several scalar-extension and tensor terms, so this local
-- heartbeat bump keeps the proof stable without changing the surrounding file.
/-- Helper for Lemma 12-12.7-5: the algebraically closed linear constituent chosen inside the
scalar extension of an irreducible `K`-representation of `C = ⟨x⟩` should identify LinearRepresentations_Serre_1977's
generator-field model with the original `K`-representation. -/
theorem generatorField_model_equiv_of_chosen_constituent
    {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (ρ : Representation K C V) [ρ.IsIrreducible]
    (σΩ : Subrepresentation (Representation.scalarExtension (k := AlgebraicClosure K) ρ))
    (_hσΩ_irr : σΩ.toRepresentation.IsIrreducible)
    (β : C →* (AlgebraicClosure K)ˣ)
    (hβchar : σΩ.toRepresentation.character = fun g ↦ ↑(β g)) :
    Nonempty ((generatorField_linearCharacter_representation (K := K) (x := x) β).Equiv ρ) := by
  let τ := generatorField_linearCharacter_representation (K := K) (x := x) β
  let χΩ : Representation (AlgebraicClosure K) C (AlgebraicClosure K) :=
    { toFun := fun c ↦ (β c : (AlgebraicClosure K)ˣ) • LinearMap.id
      map_one' := by
        ext
        simp
      map_mul' := by
        intro c d
        ext
        simp [smul_smul] }
  have hχΩ_char : χΩ.character = fun g ↦ ↑(β g) := by
    ext g
    rw [Representation.character]
    change
      LinearMap.trace (AlgebraicClosure K) (AlgebraicClosure K)
          (((β g : (AlgebraicClosure K)ˣ) : AlgebraicClosure K) • LinearMap.id) =
        ((β g : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)
    rw [LinearMap.map_smul]
    simp [LinearMap.trace_id]
  have hχΩ_nontrivial : Nontrivial (Subrepresentation χΩ) := by
    refine ⟨⟨⊥, ⊤, ?_⟩⟩
    intro hbot_top
    have hbot_top_submodule :
        (⊥ : Submodule (AlgebraicClosure K) (AlgebraicClosure K)) = ⊤ := by
      exact congrArg Subrepresentation.toSubmodule hbot_top
    exact bot_ne_top hbot_top_submodule
  letI := hχΩ_nontrivial
  have hχΩ_irr : χΩ.IsIrreducible := by
    refine IsSimpleOrder.of_forall_eq_top ?_
    intro σ hσ
    apply Subrepresentation.toSubmodule_injective
    have hσ' : σ.toSubmodule ≠ ⊥ := by
      intro hbot
      apply hσ
      exact Subrepresentation.toSubmodule_injective hbot
    rcases (Submodule.ne_bot_iff σ.toSubmodule).mp hσ' with ⟨y, hy, hy0⟩
    have hyinv : y⁻¹ * y ∈ σ.toSubmodule := by
      simpa [smul_eq_mul] using Submodule.smul_mem σ.toSubmodule y⁻¹ hy
    have h1 : (1 : AlgebraicClosure K) ∈ σ.toSubmodule := by
      have hmul : y⁻¹ * y = (1 : AlgebraicClosure K) := by
        field_simp [hy0]
      simpa [hmul] using hyinv
    refine Submodule.eq_top_iff'.2 ?_
    intro z
    simpa using Submodule.smul_mem σ.toSubmodule z h1
  letI : χΩ.IsIrreducible := hχΩ_irr
  have hcardC_ne_alg : (Nat.card C : AlgebraicClosure K) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Finite.card_pos.ne'
  letI : Invertible (Nat.card C : AlgebraicClosure K) :=
    invertibleOfNonzero hcardC_ne_alg
  obtain ⟨eχσ⟩ : Nonempty (χΩ.Equiv σΩ.toRepresentation) := by
    exact
      (Representation.character_eq_iff_nonempty_equiv χΩ σΩ.toRepresentation).mp
        (hχΩ_char.trans hβchar.symm)
  let inclΩ :
      σΩ.toRepresentation.IntertwiningMap
        (Representation.scalarExtension (k := AlgebraicClosure K) ρ) :=
    ⟨σΩ.toSubmodule.subtype, by
      intro c
      ext z
      rfl⟩
  set_option synthInstance.maxHeartbeats 200000 in
  set_option maxHeartbeats 800000 in
  -- The scalar-extension evaluation map out of `K(β(x))` expands to a large tensor term, so the
  -- local heartbeat bump keeps this one explicit intertwiner construction stable.
  have hτΩ_nonzero :
      ∃ f :
          (Representation.scalarExtension (k := AlgebraicClosure K) τ).IntertwiningMap χΩ,
        f ≠ 0 := by
    let incl :
        generatorFieldCarrier (K := K) (x := x) β →ₗ[K] AlgebraicClosure K :=
      ((generatorFieldOfLinearCharacter (K := K) (x := x) β).val).toLinearMap
    let ev :
        TensorProduct K (AlgebraicClosure K)
            (generatorFieldCarrier (K := K) (x := x) β) →ₗ[AlgebraicClosure K]
          AlgebraicClosure K :=
      LinearMap.liftBaseChange (AlgebraicClosure K) incl
    refine ⟨⟨ev, ?_⟩, ?_⟩
    · intro c
      rw [LinearMap.ext_iff]
      intro t
      induction t using TensorProduct.induction_on with
      | zero =>
          simp
      | tmul a z =>
          change ev ((LinearMap.baseChange (AlgebraicClosure K) (τ c)) (a ⊗ₜ[K] z)) =
              (χΩ c) (ev (a ⊗ₜ[K] z))
          rw [LinearMap.baseChange_tmul, LinearMap.liftBaseChange_tmul,
            LinearMap.liftBaseChange_tmul]
          have hτcz :
              incl ((τ c) z) =
                (((β c : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) *
                  (z : AlgebraicClosure K) := by
            rfl
          rw [hτcz]
          change
            a * ((((β c : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) *
                (z : AlgebraicClosure K)) =
              (((β c : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) *
                (a * (z : AlgebraicClosure K))
          ring
      | add t₁ t₂ ih₁ ih₂ =>
          rw [LinearMap.map_add, LinearMap.map_add, ih₁, ih₂]
    · intro hzero
      have hval := congrArg
        (fun f :
          (Representation.scalarExtension (k := AlgebraicClosure K) τ).IntertwiningMap χΩ ↦
            f (1 ⊗ₜ[K] (1 : generatorFieldCarrier (K := K) (x := x) β)))
        hzero
      have htmul :
          ev (1 ⊗ₜ[K] (1 : generatorFieldCarrier (K := K) (x := x) β)) =
            (1 : AlgebraicClosure K) := by
        simp [ev, incl, LinearMap.liftBaseChange_tmul]
      have : (1 : AlgebraicClosure K) = 0 := by
        simp [htmul] at hval
      exact one_ne_zero this
  rcases hτΩ_nonzero with ⟨fτΩ, hfτΩ⟩
  let FΩ :
      (Representation.scalarExtension (k := AlgebraicClosure K) τ).IntertwiningMap
        (Representation.scalarExtension (k := AlgebraicClosure K) ρ) :=
    inclΩ.comp (eχσ.toIntertwiningMap.comp fτΩ)
  have hFΩ_ne : FΩ ≠ 0 := by
    intro hzero
    apply hfτΩ
    apply Representation.IntertwiningMap.ext
    rw [LinearMap.ext_iff]
    intro z
    have hcomp := congrArg
      (fun f :
        (Representation.scalarExtension (k := AlgebraicClosure K) τ).IntertwiningMap
          (Representation.scalarExtension (k := AlgebraicClosure K) ρ) ↦ f z)
      hzero
    have hcomp' : inclΩ (eχσ (fτΩ z)) = inclΩ 0 := by
      simpa [FΩ] using hcomp
    have hsub0 : eχσ (fτΩ z) = 0 := by
      apply Submodule.subtype_injective σΩ.toSubmodule
      exact hcomp'
    have hsub : eχσ (fτΩ z) = eχσ 0 := by
      simpa using hsub0
    exact eχσ.toLinearEquiv.injective hsub
  have hpair_alg_ne :
      ⟪(Representation.scalarExtension (k := AlgebraicClosure K) τ).character,
          (Representation.scalarExtension (k := AlgebraicClosure K) ρ).character⟫ ≠
        (0 : AlgebraicClosure K) := by
    have hpos :
        0 <
          Module.finrank (AlgebraicClosure K)
            ((Representation.scalarExtension (k := AlgebraicClosure K) τ).IntertwiningMap
              (Representation.scalarExtension (k := AlgebraicClosure K) ρ)) := by
      exact Module.finrank_pos_iff_exists_ne_zero.mpr ⟨FΩ, hFΩ_ne⟩
    rw [Representation.groupFunctionPairingOverField_character_eq_finrank_intertwiningMap
      (K := AlgebraicClosure K)
      (G := C)
      (Representation.scalarExtension (k := AlgebraicClosure K) τ)
      (Representation.scalarExtension (k := AlgebraicClosure K) ρ)]
    exact Nat.cast_ne_zero.mpr hpos.ne'
  have hcardC_ne : (Nat.card C : K) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Finite.card_pos.ne'
  letI : Invertible (Nat.card C : K) := invertibleOfNonzero hcardC_ne
  have hpair_map_ne :
      algebraMap K (AlgebraicClosure K) ⟪τ.character, ρ.character⟫ ≠
        (0 : AlgebraicClosure K) := by
    have hpair_map :
        ⟪(fun g : C ↦ algebraMap K (AlgebraicClosure K) (τ.character g)),
            fun g : C ↦ algebraMap K (AlgebraicClosure K) (ρ.character g)⟫ =
          algebraMap K (AlgebraicClosure K) ⟪τ.character, ρ.character⟫ := by
      simp [Representation.groupFunctionPairingOverField, map_mul]
    rw [← hpair_map]
    simpa [scalarExtension_character_eq_map_to_algClosure (K := K) (τ := τ),
      scalarExtension_character_eq_map_to_algClosure (K := K) (τ := ρ)] using hpair_alg_ne
  have hpair_ne : ⟪τ.character, ρ.character⟫ ≠ (0 : K) := by
    intro hzero
    exact hpair_map_ne (by simp [hzero])
  have hpos :
      0 < Module.finrank K (τ.IntertwiningMap ρ) := by
    have hfinrank_ne_zero : Module.finrank K (τ.IntertwiningMap ρ) ≠ 0 := by
      intro hfinrank_zero
      apply hpair_ne
      rw [Representation.groupFunctionPairingOverField_character_eq_finrank_intertwiningMap
        (K := K) (G := C) τ ρ]
      simp [hfinrank_zero]
    exact Nat.pos_of_ne_zero hfinrank_ne_zero
  obtain ⟨f, hf⟩ : ∃ f : τ.IntertwiningMap ρ, f ≠ 0 := by
    exact Module.finrank_pos_iff_exists_ne_zero.mp hpos
  exact generatorField_model_equiv_of_nonzero_intertwiner (K := K) (x := x) β ρ f hf

/-- Helper for Lemma 12-12.7-5: inside `H = C ⋅ P`, the cyclic factor `C = ⟨x⟩` is normal because
the `P`-factor acts on it by `Γ_K`-power automorphisms. -/
private theorem associatedGammaPElementary_zpowers_normal_local
    (P : Sylow p N(x)) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    ((Subgroup.zpowers x).subgroupOf H).Normal := by
  -- Route correction: the final extension step is semidirect-product packaging on `H = C ⋅ P`,
  -- so we isolate normality of the cyclic factor before constructing LinearRepresentations_Serre_1977's restricted `σ_t`.
  dsimp
  let Pimg : Subgroup G := Subgroup.map N(x).subtype (P : Subgroup N(x))
  have hPimg_normalizes : Pimg ≤ Subgroup.normalizer (Subgroup.zpowers x) := by
    intro y hy
    rw [Subgroup.mem_normalizer_iff]
    rcases Subgroup.mem_map.mp hy with ⟨z, hzP, rfl⟩
    rcases gammaNormalizer_conjugates_zpowers_by_power ΓK x z.1 z.2 with ⟨t, ht⟩
    intro c
    constructor
    · intro hc
      have hpow : N(x).subtype z * c * (N(x).subtype z)⁻¹ = c ^ t := by
        simpa using ht ⟨c, hc⟩
      rw [hpow, pow_subgroup_eq_pow_nat]
      exact Subgroup.pow_mem (Subgroup.zpowers x) hc _
    · intro hc
      have hz_inv : z.1⁻¹ ∈ N(x) := (N(x)).inv_mem z.2
      rcases gammaNormalizer_conjugates_zpowers_by_power ΓK x z.1⁻¹ hz_inv with ⟨t, htInv⟩
      have hconjInv :
          (N(x).subtype z)⁻¹ * (N(x).subtype z * c * (N(x).subtype z)⁻¹) *
              ((N(x).subtype z)⁻¹)⁻¹ =
            (N(x).subtype z * c * (N(x).subtype z)⁻¹) ^ t := by
        simpa using htInv ⟨N(x).subtype z * c * (N(x).subtype z)⁻¹, hc⟩
      have hpow : c = (N(x).subtype z * c * (N(x).subtype z)⁻¹) ^ t := by
        calc
          c =
              (N(x).subtype z)⁻¹ * (N(x).subtype z * c * (N(x).subtype z)⁻¹) *
                ((N(x).subtype z)⁻¹)⁻¹ := by
              group
          _ = (N(x).subtype z * c * (N(x).subtype z)⁻¹) ^ t := hconjInv
      rw [hpow, pow_subgroup_eq_pow_nat]
      exact Subgroup.pow_mem (Subgroup.zpowers x) hc _
  have hH_normalizes :
      associatedGammaPElementarySubgroup ΓK x P ≤ Subgroup.normalizer (Subgroup.zpowers x) := by
    simpa [associatedGammaPElementarySubgroup, Pimg] using
      sup_le Subgroup.le_normalizer hPimg_normalizes
  -- Once both generators of `H = C ⋅ P` normalize `C`, normality is immediate.
  simpa [associatedGammaPElementarySubgroup] using
    (Subgroup.normal_subgroupOf_of_le_normalizer hH_normalizes)

/-- Helper for Lemma 12-12.7-5: the cyclic factor `C = ⟨x⟩` is contained in the associated
subgroup `H = C ⋅ P`. -/
private theorem associatedGammaPElementary_zpowers_le_local
    (P : Sylow p N(x)) :
    Subgroup.zpowers x ≤ associatedGammaPElementarySubgroup ΓK x P := by
  -- This keeps the ambient inclusion available as a named fact when packaging the final
  -- semidirect-product action on `H = C ⋅ P`.
  exact zpowers_le_associatedGammaPElementarySubgroup ΓK p x P

/-- Helper for Lemma 12-12.7-5: every element of the `P`-factor in LinearRepresentations_Serre_1977's decomposition of
`H = C ⋅ P` comes with a concrete `Γ_K`-power witness for its conjugation action on the generator
`x`. -/
private theorem associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    ∀ y : P₀, ∃ t : ΓK, (((y : P₀) : H) : G) * x * (((y : P₀) : H) : G)⁻¹ = x ^ t := by
  intro H P₀ y
  let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
  let hdecomp := associatedGammaPElementarySubgroup_decomposition ΓK p x hx P
  rcases hdecomp.conjugation_eq_pow y with ⟨t, ht⟩
  let c0 : C₀ :=
    ⟨⟨x,
        associatedGammaPElementary_zpowers_le_local
          (K := K) (p := p) (x := x) P (Subgroup.mem_zpowers x)⟩,
      Subgroup.mem_subgroupOf.mpr (Subgroup.mem_zpowers x)⟩
  refine ⟨t, ?_⟩
  -- Specialize the decomposition witness to the distinguished generator of `C = ⟨x⟩`.
  simpa [c0, C₀] using ht c0

/-- Helper for Lemma 12-12.7-5: every element of `H = C ⋅ P` admits a unique factorization as an
element of the cyclic factor followed by an element of the `P`-factor. -/
private theorem associatedGammaPElementarySubgroup_factorization_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    ∀ h : H, ∃! cp : C₀ × P₀, cp.1.1 * cp.2.1 = h := by
  intro H C₀ P₀ h
  -- The decomposition theorem already identifies the two subgroup factors as complements in `H`.
  simpa [H, C₀, P₀] using
    (associatedGammaPElementarySubgroup_decomposition ΓK p x hx P).isComplement.existsUnique h

/-- Helper for Lemma 12-12.7-5: if `y, z` lie in the `P`-factor of `H = C ⋅ P`, then the product
`yz` conjugates `x` by the product of the chosen `Γ_K`-power witnesses for `y` and `z`. -/
private theorem associatedGammaPElementarySubgroup_pfactor_mul_conjugates_generator_by_product_power_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    ∀ y z : P₀,
      let ty := Classical.choose
        (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
          (K := K) (p := p) (x := x) (P := P) hx y)
      let tz := Classical.choose
        (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
          (K := K) (p := p) (x := x) (P := P) hx z)
      (((y * z : P₀) : H) : G) * x * (((y * z : P₀) : H) : G)⁻¹ = x ^ (ty * tz) := by
  intro H P₀ y z
  let ty : ΓK := Classical.choose
    (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
      (K := K) (p := p) (x := x) (P := P) hx y)
  let tz : ΓK := Classical.choose
    (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
      (K := K) (p := p) (x := x) (P := P) hx z)
  have hy :
      (((y : P₀) : H) : G) * x * (((y : P₀) : H) : G)⁻¹ = x ^ ty := by
    exact Classical.choose_spec
      (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
        (K := K) (p := p) (x := x) (P := P) hx y)
  have hz :
      (((z : P₀) : H) : G) * x * (((z : P₀) : H) : G)⁻¹ = x ^ tz := by
    exact Classical.choose_spec
      (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
        (K := K) (p := p) (x := x) (P := P) hx z)
  -- Rewrite the conjugation by `yz` as successive conjugation by `z` and then by `y`.
  calc
    (((y * z : P₀) : H) : G) * x * (((y * z : P₀) : H) : G)⁻¹ =
      ((((y : P₀) : H) : G) * (((z : P₀) : H) : G)) * x *
        ((((y : P₀) : H) : G) * (((z : P₀) : H) : G))⁻¹ := by
          rfl
    _ =
      (((y : P₀) : H) : G) * ((((z : P₀) : H) : G) * x * (((z : P₀) : H) : G)⁻¹) *
        (((y : P₀) : H) : G)⁻¹ := by
          group
    _ =
      (((y : P₀) : H) : G) * (x ^ tz) * (((y : P₀) : H) : G)⁻¹ := by
          rw [hz]
    _ =
      ((((y : P₀) : H) : G) * x * (((y : P₀) : H) : G)⁻¹) ^
        galoisPowerExponentUnit (tz : (ZMod (Monoid.exponent G))ˣ) := by
          rw [pow_subgroup_eq_pow_nat]
          have hconj :
              ((((y : P₀) : H) : G) * x * (((y : P₀) : H) : G)⁻¹) ^
                  galoisPowerExponentUnit (tz : (ZMod (Monoid.exponent G))ˣ) =
                (((y : P₀) : H) : G) * x ^
                    galoisPowerExponentUnit (tz : (ZMod (Monoid.exponent G))ˣ) *
                  (((y : P₀) : H) : G)⁻¹ := conj_pow
          simpa [mul_assoc] using hconj.symm
    _ = (x ^ ty) ^ galoisPowerExponentUnit (tz : (ZMod (Monoid.exponent G))ˣ) := by
          rw [hy]
    _ = x ^ (ty * tz) := by
          simpa [ty, tz] using
            gammaSubgroup_pow_mul_local (K := K) (x := x) ty tz

/-- Helper for Lemma 12-12.7-5: on the `P`-factor of `H = C ⋅ P`, the restricted
`K`-automorphism attached to the chosen witness for `yz` is the product of those attached to the
chosen witnesses for `y` and `z`. -/
private theorem associatedGammaPElementarySubgroup_pfactor_mul_restricted_sigma_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    (β : C →* (AlgebraicClosure K)ˣ) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    ∀ y z : P₀,
      let ty : ΓK := Classical.choose
        (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
          (K := K) (p := p) (x := x) (P := P) hx y)
      let tz : ΓK := Classical.choose
        (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
          (K := K) (p := p) (x := x) (P := P) hx z)
      let tyz : ΓK := Classical.choose
        (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
          (K := K) (p := p) (x := x) (P := P) hx (y * z))
      generatorField_restricted_sigma_algEquiv_of_root_local
          (K := K) (x := x) β tyz
          (gammaSubgroup_generator_value_mem_K_aroots_local
            (K := K) (x := x) β tyz) =
        generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β ty
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β ty) *
          generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β tz
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β tz) := by
  intro H P₀ y z
  let ty : ΓK := Classical.choose
    (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
      (K := K) (p := p) (x := x) (P := P) hx y)
  let tz : ΓK := Classical.choose
    (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
      (K := K) (p := p) (x := x) (P := P) hx z)
  let tyz : ΓK := Classical.choose
    (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
      (K := K) (p := p) (x := x) (P := P) hx (y * z))
  have hy :
      (((y : P₀) : H) : G) * x * (((y : P₀) : H) : G)⁻¹ = x ^ ty := by
    exact Classical.choose_spec
      (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
        (K := K) (p := p) (x := x) (P := P) hx y)
  have hz :
      (((z : P₀) : H) : G) * x * (((z : P₀) : H) : G)⁻¹ = x ^ tz := by
    exact Classical.choose_spec
      (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
        (K := K) (p := p) (x := x) (P := P) hx z)
  have hyz :
      ((((y * z : P₀) : H) : G) * x * (((y * z : P₀) : H) : G)⁻¹) = x ^ tyz := by
    exact Classical.choose_spec
      (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
        (K := K) (p := p) (x := x) (P := P) hx (y * z))
  have hyz_mul :
      ((((y * z : P₀) : H) : G) * x * (((y * z : P₀) : H) : G)⁻¹) = x ^ (ty * tz) := by
    exact
      associatedGammaPElementarySubgroup_pfactor_mul_conjugates_generator_by_product_power_local
        (K := K) (p := p) (x := x) (P := P) hx y z
  have hpow_yz : (x ^ tyz : G) = x ^ (ty * tz) := by
    exact hyz.symm.trans hyz_mul
  have hcomp :
      generatorField_restricted_sigma_algEquiv_of_root_local
          (K := K) (x := x) β (ty * tz)
          (gammaSubgroup_generator_value_mem_K_aroots_local
            (K := K) (x := x) β (ty * tz)) =
        generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β ty
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β ty) *
          generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β tz
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β tz) := by
    -- The simple field `K(β(x))` is generated by `β(x)`, so it suffices to compare both sides on
    -- that distinguished generator.
    apply generatorField_algEquiv_eq_of_apply_generator_eq (G := G) (K := K) (x := x) β
    let gen : generatorFieldCarrier (K := K) (x := x) β :=
      ⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)),
        linear_character_value_mem_generatorField (K := K) (x := x) β
          (zpowers_generator (x := x))⟩
    have hygen :
        generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β ty
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β ty) gen =
          gen ^ galoisPowerExponentUnit ((ty : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
      calc
        generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β ty
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β ty) gen =
          (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β ty
                (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
                AlgebraicClosure K)),
            linearCharacter_twist_value_mem_generatorField_public
              (G := G) (K := K) (x := x) β ty (zpowers_generator (x := x))⟩ :
              generatorFieldCarrier (K := K) (x := x) β) := by
                rw [generatorField_restricted_sigma_algEquiv_of_root_apply_generator_local]
        _ = gen ^ galoisPowerExponentUnit ((ty : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
              simpa [gen] using
                twisted_generator_value_eq_generator_power_local
                  (G := G) (K := K) (x := x) β ty
    have hzgen :
        generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β tz
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β tz) gen =
          gen ^ galoisPowerExponentUnit ((tz : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
      calc
        generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β tz
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β tz) gen =
          (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β tz
                (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
                AlgebraicClosure K)),
            linearCharacter_twist_value_mem_generatorField_public
              (G := G) (K := K) (x := x) β tz (zpowers_generator (x := x))⟩ :
              generatorFieldCarrier (K := K) (x := x) β) := by
                rw [generatorField_restricted_sigma_algEquiv_of_root_apply_generator_local]
        _ = gen ^ galoisPowerExponentUnit ((tz : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
              simpa [gen] using
                twisted_generator_value_eq_generator_power_local
                  (G := G) (K := K) (x := x) β tz
    have hgen_pow_orderOf_x : gen ^ orderOf x = 1 := by
      apply Subtype.ext
      change (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ^ orderOf x = 1
      have hβpow_units :
          (β (zpowers_generator (x := x))) ^ orderOf x = 1 := by
        calc
          (β (zpowers_generator (x := x))) ^ orderOf x =
            β ((zpowers_generator (x := x)) ^ orderOf x) := by
              symm
              simpa using
                map_pow β (zpowers_generator (x := x)) (orderOf x)
          _ = β 1 := by
              congr 1
              apply Subtype.ext
              simpa using pow_orderOf_eq_one x
          _ = 1 := by simp
      exact congrArg (fun z : (AlgebraicClosure K)ˣ ↦ (z : AlgebraicClosure K)) hβpow_units
    have hgen_order_dvd_exp : orderOf gen ∣ Monoid.exponent G := by
      exact
        (orderOf_dvd_of_pow_eq_one hgen_pow_orderOf_x).trans
          (Monoid.order_dvd_exponent x)
    have hval_mul :
        galoisPowerExponentUnit (((ty * tz : ΓK) : (ZMod (Monoid.exponent G))ˣ)) =
          (galoisPowerExponentUnit ((ty : ΓK) : (ZMod (Monoid.exponent G))ˣ) *
            galoisPowerExponentUnit ((tz : ΓK) : (ZMod (Monoid.exponent G))ˣ)) %
              Monoid.exponent G := by
      simpa [galoisPowerExponentUnit] using
        (ZMod.val_mul
          (((ty : ΓK) : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G))
          (((tz : ΓK) : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)))
    calc
      generatorField_restricted_sigma_algEquiv_of_root_local
          (K := K) (x := x) β (ty * tz)
          (gammaSubgroup_generator_value_mem_K_aroots_local
            (K := K) (x := x) β (ty * tz)) gen =
        (gen :
          generatorFieldCarrier (K := K) (x := x) β) ^
          galoisPowerExponentUnit (((ty * tz : ΓK) : (ZMod (Monoid.exponent G))ˣ)) := by
            rw [generatorField_restricted_sigma_algEquiv_of_root_apply_generator_local]
            exact twisted_generator_value_eq_generator_power_local
              (G := G) (K := K) (x := x) β (ty * tz)
      _ =
        (gen :
          generatorFieldCarrier (K := K) (x := x) β) ^
          (galoisPowerExponentUnit ((ty : ΓK) : (ZMod (Monoid.exponent G))ˣ) *
            galoisPowerExponentUnit ((tz : ΓK) : (ZMod (Monoid.exponent G))ˣ)) := by
              rw [hval_mul]
              calc
                (gen :
                  generatorFieldCarrier (K := K) (x := x) β) ^
                    ((galoisPowerExponentUnit ((ty : ΓK) :
                        (ZMod (Monoid.exponent G))ˣ) *
                      galoisPowerExponentUnit ((tz : ΓK) :
                        (ZMod (Monoid.exponent G))ˣ)) %
                        Monoid.exponent G) =
                  (gen :
                    generatorFieldCarrier (K := K) (x := x) β) ^
                    (((galoisPowerExponentUnit ((ty : ΓK) :
                        (ZMod (Monoid.exponent G))ˣ) *
                      galoisPowerExponentUnit ((tz : ΓK) :
                        (ZMod (Monoid.exponent G))ˣ)) %
                        Monoid.exponent G) %
                        orderOf gen) := by
                          symm
                          exact pow_mod_orderOf gen _
                _ =
                  (gen :
                    generatorFieldCarrier (K := K) (x := x) β) ^
                    ((galoisPowerExponentUnit ((ty : ΓK) :
                        (ZMod (Monoid.exponent G))ˣ) *
                      galoisPowerExponentUnit ((tz : ΓK) :
                        (ZMod (Monoid.exponent G))ˣ)) %
                        orderOf gen) := by
                          rw [Nat.mod_mod_of_dvd _ hgen_order_dvd_exp]
                _ =
                  (gen :
                    generatorFieldCarrier (K := K) (x := x) β) ^
                    (galoisPowerExponentUnit ((ty : ΓK) :
                        (ZMod (Monoid.exponent G))ˣ) *
                      galoisPowerExponentUnit ((tz : ΓK) :
                        (ZMod (Monoid.exponent G))ˣ)) := by
                          exact pow_mod_orderOf gen _
      _ = ((gen :
            generatorFieldCarrier (K := K) (x := x) β) ^
            galoisPowerExponentUnit ((ty : ΓK) : (ZMod (Monoid.exponent G))ˣ)) ^
          galoisPowerExponentUnit ((tz : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
              rw [pow_mul]
      _ =
        (generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β ty
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β ty) gen) ^
          galoisPowerExponentUnit ((tz : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
              rw [hygen]
      _ =
        generatorField_restricted_sigma_algEquiv_of_root_local
          (K := K) (x := x) β ty
          (gammaSubgroup_generator_value_mem_K_aroots_local
            (K := K) (x := x) β ty)
          (generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β tz
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β tz) gen) := by
                rw [hzgen]
                symm
                simpa using
                  map_pow
                    (generatorField_restricted_sigma_algEquiv_of_root_local
                      (K := K) (x := x) β ty
                      (gammaSubgroup_generator_value_mem_K_aroots_local
                        (K := K) (x := x) β ty))
                    gen
                    (galoisPowerExponentUnit ((tz : ΓK) : (ZMod (Monoid.exponent G))ˣ))
      _ =
        (generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β ty
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β ty) *
          generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β tz
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β tz)) gen := by
                rfl
  calc
    generatorField_restricted_sigma_algEquiv_of_root_local
        (K := K) (x := x) β tyz
        (gammaSubgroup_generator_value_mem_K_aroots_local
          (K := K) (x := x) β tyz) =
      generatorField_restricted_sigma_algEquiv_of_root_local
        (K := K) (x := x) β (ty * tz)
        (gammaSubgroup_generator_value_mem_K_aroots_local
          (K := K) (x := x) β (ty * tz)) := by
            exact
              generatorField_restricted_sigma_algEquiv_of_root_eq_of_generator_power_eq_local
                (K := K) (x := x) β hpow_yz
                (gammaSubgroup_generator_value_mem_K_aroots_local
                  (K := K) (x := x) β tyz)
                (gammaSubgroup_generator_value_mem_K_aroots_local
                  (K := K) (x := x) β (ty * tz))
    _ =
      generatorField_restricted_sigma_algEquiv_of_root_local
          (K := K) (x := x) β ty
          (gammaSubgroup_generator_value_mem_K_aroots_local
            (K := K) (x := x) β ty) *
        generatorField_restricted_sigma_algEquiv_of_root_local
          (K := K) (x := x) β tz
          (gammaSubgroup_generator_value_mem_K_aroots_local
            (K := K) (x := x) β tz) := hcomp

/-- Helper for Lemma 12-12.7-5: on one vector of the fixed carrier `K(β(x))`, transporting the
twisted generator-field model back along the twist-field equality should agree with the
fixed-carrier twisted action. -/
private theorem generatorField_twist_transport_apply_eq_fixed_carrier_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c : C)
    (z : generatorFieldCarrier (K := K) (x := x) β) :
    ↑(((transportRepresentation (K := K)
            (generatorField_twist_linearEquiv (G := G) (K := K) (x := x) β t)
            (generatorField_linearCharacter_representation (K := K) (x := x)
              (linearCharacter_twist (G := G) (K := K) (x := x) β t))) c) z) =
    ↑(((generatorField_twisted_linearCharacter_representation
            (G := G) (K := K) (x := x) β t) c) z) := by
  -- Route correction: the pointwise transport theorem is now exported from the split support file,
  -- so the local wrapper is just the source-faithful fixed-carrier specialization.
  simpa using
    generatorField_twist_transport_apply_eq_fixed_carrier
      (G := G) (K := K) (x := x) β t c z

/-- Helper for Lemma 12-12.7-5: the cast-only transport from the twisted generator-field carrier
back to the fixed carrier already agrees pointwise with LinearRepresentations_Serre_1977's fixed-carrier twisted action. -/
private theorem generatorField_twist_transport_eq_fixed_carrier_representation_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    transportRepresentation (K := K)
        (generatorField_twist_linearEquiv (G := G) (K := K) (x := x) β t)
        (generatorField_linearCharacter_representation (K := K) (x := x)
          (linearCharacter_twist (G := G) (K := K) (x := x) β t)) =
      generatorField_twisted_linearCharacter_representation
        (G := G) (K := K) (x := x) β t := by
  -- Extensionality reduces the representation equality to the pointwise transport identity above.
  ext c z
  exact congrArg Subtype.val <|
    generatorField_twist_transport_apply_eq_fixed_carrier_local
      (G := G) (K := K) (x := x) β t c z

/-- Helper for Lemma 12-12.7-5: LinearRepresentations_Serre_1977's restricted `Γ_K`-automorphism of `K(β(x))` intertwines
the ordinary cyclic action with the fixed-carrier twisted action. -/
private theorem generatorField_restricted_sigma_intertwines_linearCharacter_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c : C) :
    let σt :=
      generatorField_restricted_sigma_algEquiv_of_root_local
        (K := K) (x := x) β t
        (gammaSubgroup_generator_value_mem_K_aroots_local
          (K := K) (x := x) β t)
    ((σt.toLinearMap :
        Module.End K (generatorFieldCarrier (K := K) (x := x) β)) *
        (generatorField_linearCharacter_representation (K := K) (x := x) β c)) =
      ((generatorField_twisted_linearCharacter_representation
          (G := G) (K := K) (x := x) β t c) *
        (σt.toLinearMap :
          Module.End K (generatorFieldCarrier (K := K) (x := x) β))) := by
  intro σt
  let a :
      generatorFieldCarrier (K := K) (x := x) β :=
    ⟨(((β c : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
      linear_character_value_mem_generatorField (K := K) (x := x) β c⟩
  let aTw :
      generatorFieldCarrier (K := K) (x := x) β :=
    ⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
          (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
      linearCharacter_twist_value_mem_generatorField_public
        (G := G) (K := K) (x := x) β t c⟩
  have hσa : σt a = aTw := by
    rcases Subgroup.mem_zpowers_iff.mp c.2 with ⟨n, hn⟩
    have hc : c = (zpowers_generator (x := x)) ^ n := by
      apply Subtype.ext
      simpa using hn.symm
    -- Rewrite `c` as a power of the distinguished generator and use the universal-property
    -- computation already proved for all generator powers.
    apply Subtype.ext
    calc
      (((σt a : generatorFieldCarrier (K := K) (x := x) β) :
          AlgebraicClosure K)) =
        (((σt
            (⟨((β ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
                AlgebraicClosure K),
              linear_character_value_mem_generatorField (K := K) (x := x) β
                ((zpowers_generator (x := x)) ^ n)⟩ :
                generatorFieldCarrier (K := K) (x := x) β) :
              generatorFieldCarrier (K := K) (x := x) β) :
            AlgebraicClosure K)) := by
              simpa [a, hc]
      _ =
        (((linearCharacter_twist (G := G) (K := K) (x := x) β t
            ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)) := by
              simpa [generatorField_restricted_sigma_algEquiv_of_root_local,
                generatorField_restricted_sigma_algHom_of_root_local] using
                generatorField_algHom_of_generator_root_apply_generator_powers_local
                  (K := K) (x := x) β
                  (linearCharacter_twist (G := G) (K := K) (x := x) β t)
                  (gammaSubgroup_generator_value_mem_K_aroots_local
                    (K := K) (x := x) β t)
                  rfl n
      _ =
        (((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
            (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) := by
              simpa [aTw, hc]
  -- Pointwise, the intertwining identity is simply multiplicativity of the restricted field
  -- automorphism together with the scalar identity just proved.
  ext z
  change
    (((σt :
        generatorFieldCarrier (K := K) (x := x) β ≃ₐ[K]
          generatorFieldCarrier (K := K) (x := x) β)
        ((a : generatorFieldCarrier (K := K) (x := x) β) * z) :
          generatorFieldCarrier (K := K) (x := x) β) : AlgebraicClosure K) =
      (((aTw : generatorFieldCarrier (K := K) (x := x) β) * σt z :
          generatorFieldCarrier (K := K) (x := x) β) : AlgebraicClosure K)
  rw [map_mul, hσa]

/-- Helper for Lemma 12-12.7-5: once the restricted `Γ_K`-power automorphisms on the fixed field
`K(β(x))` are available, the source packaging over `H = C ⋅ P` is routine. -/
private theorem associatedGammaPElementarySubgroup_pfactor_action_from_restricted_sigma_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    (β : C →* (AlgebraicClosure K)ˣ) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    ∃ τP : Representation K P₀ (generatorFieldCarrier (K := K) (x := x) β),
      ∀ y : P₀,
        let ty : ΓK := Classical.choose
          (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
            (K := K) (p := p) (x := x) (P := P) hx y)
        τP y =
          (generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β ty
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β ty)).toLinearMap := by
  intro H P₀
  classical
  let witnessPower : P₀ → ΓK := fun y =>
    Classical.choose
      (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
        (K := K) (p := p) (x := x) (P := P) hx y)
  let τAlg :
      P₀ →* (generatorFieldCarrier (K := K) (x := x) β ≃ₐ[K]
        generatorFieldCarrier (K := K) (x := x) β) := by
    refine
      { toFun := fun y =>
          generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β (witnessPower y)
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β (witnessPower y))
        map_one' := ?_
        map_mul' := ?_ }
    · -- The identity element of the `P`-factor fixes `x`, so its restricted automorphism is the identity.
      let t1 : ΓK := witnessPower (1 : P₀)
      have ht1 :
          (((1 : P₀) : H) : G) * x * (((1 : P₀) : H) : G)⁻¹ = x ^ t1 := by
        exact Classical.choose_spec
          (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
            (K := K) (p := p) (x := x) (P := P) hx (1 : P₀))
      have hpow1 : (x ^ t1 : G) = x := by
        have hx_eq_pow : x = x ^ t1 := by
          simpa [t1] using ht1
        exact hx_eq_pow.symm
      calc
        generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β (witnessPower (1 : P₀))
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β (witnessPower (1 : P₀))) =
          generatorField_restricted_sigma_algEquiv_of_root_local
            (K := K) (x := x) β (1 : ΓK)
            (gammaSubgroup_generator_value_mem_K_aroots_local
              (K := K) (x := x) β (1 : ΓK)) := by
              simpa [witnessPower, t1] using
                generatorField_restricted_sigma_algEquiv_of_root_eq_of_generator_power_eq_local
                  (K := K) (x := x) β
                  (hpow1.trans
                    (gammaSubgroup_pow_one_eq_self_local (K := K) (x := x)).symm)
                  (gammaSubgroup_generator_value_mem_K_aroots_local
                    (K := K) (x := x) β t1)
                  (gammaSubgroup_generator_value_mem_K_aroots_local
                    (K := K) (x := x) β (1 : ΓK))
        _ = 1 := by
              exact
                generatorField_restricted_sigma_algEquiv_of_root_one_eq_id_local
                  (K := K) (x := x) β
    · intro y z
      -- Multiplicativity is exactly the restricted-σ composition law already proved on the `P`-factor.
      dsimp [witnessPower]
      exact
        associatedGammaPElementarySubgroup_pfactor_mul_restricted_sigma_local
          (K := K) (p := p) (x := x) (P := P) hx β y z
  have hτP_one :
      ((τAlg 1).toLinearMap : Module.End K (generatorFieldCarrier (K := K) (x := x) β)) = 1 := by
    exact congrArg AlgEquiv.toLinearMap (MonoidHom.map_one τAlg)
  have hτP_mul :
      ∀ y z : P₀,
        ((τAlg (y * z)).toLinearMap :
            Module.End K (generatorFieldCarrier (K := K) (x := x) β)) =
          ((τAlg y).toLinearMap : Module.End K (generatorFieldCarrier (K := K) (x := x) β)) *
            ((τAlg z).toLinearMap :
              Module.End K (generatorFieldCarrier (K := K) (x := x) β)) := by
    intro y z
    exact congrArg AlgEquiv.toLinearMap (MonoidHom.map_mul τAlg y z)
  let τP : Representation K P₀ (generatorFieldCarrier (K := K) (x := x) β) :=
    { toFun := fun y => (τAlg y).toLinearMap
      map_one' := hτP_one
      map_mul' := hτP_mul }
  refine ⟨τP, ?_⟩
  intro y
  -- By construction, the `P`-action is the chosen restricted `σ_t` on the fixed generator field.
  rfl

/-- Helper for Lemma 12-12.7-5: once the restricted `Γ_K`-power automorphisms on the fixed field
`K(β(x))` are available, the source packaging over `H = C ⋅ P` is routine. -/
private theorem associatedGammaPElementarySubgroup_restricted_sigma_eq_of_witness_alignment_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    (β : C →* (AlgebraicClosure K)ˣ) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    ∀ y : P₀,
      let u : ΓK := Classical.choose
        ((associatedGammaPElementarySubgroup_decomposition ΓK p x hx P).conjugation_eq_pow y)
      let ty : ΓK := Classical.choose
        (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
          (K := K) (p := p) (x := x) (P := P) hx y)
      generatorField_restricted_sigma_algEquiv_of_root_local
          (K := K) (x := x) β u
          (gammaSubgroup_generator_value_mem_K_aroots_local
            (K := K) (x := x) β u) =
        generatorField_restricted_sigma_algEquiv_of_root_local
          (K := K) (x := x) β ty
          (gammaSubgroup_generator_value_mem_K_aroots_local
            (K := K) (x := x) β ty) := by
  intro H P₀ y
  let u : ΓK := Classical.choose
    ((associatedGammaPElementarySubgroup_decomposition ΓK p x hx P).conjugation_eq_pow y)
  let ty : ΓK := Classical.choose
    (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
      (K := K) (p := p) (x := x) (P := P) hx y)
  let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
  let c0 : C₀ :=
    ⟨⟨x,
        associatedGammaPElementary_zpowers_le_local
          (K := K) (p := p) (x := x) P (Subgroup.mem_zpowers x)⟩,
      Subgroup.mem_subgroupOf.mpr (Subgroup.mem_zpowers x)⟩
  have hu :
      (((y : P₀) : H) : G) * x * (((y : P₀) : H) : G)⁻¹ = x ^ u := by
    -- The decomposition witness acts on the distinguished generator exactly by its chosen
    -- `Γ_K`-power.
    simpa [u, C₀, c0] using
      (Classical.choose_spec
        ((associatedGammaPElementarySubgroup_decomposition ΓK p x hx P).conjugation_eq_pow y)) c0
  have hty :
      (((y : P₀) : H) : G) * x * (((y : P₀) : H) : G)⁻¹ = x ^ ty := by
    -- The concrete `P`-factor witness is normalized to the same conjugation formula on `x`.
    exact Classical.choose_spec
      (associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
        (K := K) (p := p) (x := x) (P := P) hx y)
  have hpow : (x ^ u : G) = x ^ ty := by
    -- Both witnesses describe the same conjugation action of `y` on the generator `x`.
    exact hu.symm.trans hty
  -- The simple field `K(β(x))` is generated by `β(x)`, so matching the induced power of `x`
  -- forces the two restricted automorphisms to agree.
  simpa [u, ty] using
    generatorField_restricted_sigma_algEquiv_of_root_eq_of_generator_power_eq_local
      (K := K) (x := x) β hpow
      (gammaSubgroup_generator_value_mem_K_aroots_local
        (K := K) (x := x) β u)
      (gammaSubgroup_generator_value_mem_K_aroots_local
        (K := K) (x := x) β ty)

/-- Helper for Lemma 12-12.7-5: once the restricted `Γ_K`-power automorphisms on the fixed field
`K(β(x))` are available, the source packaging over `H = C ⋅ P` is routine. -/
private theorem associatedGammaPElementarySubgroup_conjugated_cyclic_factor_action_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    (β : C →* (AlgebraicClosure K)ˣ) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    let cycRep : Representation K C₀ (generatorFieldCarrier (K := K) (x := x) β) :=
      (generatorField_linearCharacter_representation (K := K) (x := x) β).comp
        ((Subgroup.subgroupOfEquivOfLe hC).toMonoidHom)
    ∀ y : P₀, ∀ c : C₀,
      let u : ΓK := Classical.choose
        ((associatedGammaPElementarySubgroup_decomposition ΓK p x hx P).conjugation_eq_pow y)
      let c' : C₀ := ⟨(y : H) * c * (y : H)⁻¹,
        (associatedGammaPElementary_zpowers_normal_local
          (K := K) (p := p) (x := x) (P := P)).conj_mem c c.2 (y : H)⟩
      cycRep c' =
        generatorField_twisted_linearCharacter_representation
          (G := G) (K := K) (x := x) β u ((Subgroup.subgroupOfEquivOfLe hC) c) := by
  intro H hC C₀ P₀ cycRep y c
  let u : ΓK := Classical.choose
    ((associatedGammaPElementarySubgroup_decomposition ΓK p x hx P).conjugation_eq_pow y)
  let c' : C₀ := ⟨(y : H) * c * (y : H)⁻¹,
    (associatedGammaPElementary_zpowers_normal_local
      (K := K) (p := p) (x := x) (P := P)).conj_mem c c.2 (y : H)⟩
  let cC : C := (Subgroup.subgroupOfEquivOfLe hC) c
  let c'C : C := (Subgroup.subgroupOfEquivOfLe hC) c'
  have hc'C : c'C = cC ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) := by
    -- The conjugated cyclic factor is the explicit `Γ_K`-power dictated by LinearRepresentations_Serre_1977's decomposition.
    apply Subtype.ext
    change (((c' : C₀) : H) : G) =
      (((cC : C) : G) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ))
    have hc_eq : (((cC : C) : G)) = (((c : C₀) : H) : G) := rfl
    rw [hc_eq]
    change (((c' : C₀) : H) : G) =
      (((c : C₀) : H) : G) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ)
    simpa [u, c', pow_subgroup_eq_pow_nat] using
      (Classical.choose_spec
        ((associatedGammaPElementarySubgroup_decomposition ΓK p x hx P).conjugation_eq_pow y)) c
  -- After this normalization, both actions are multiplication by the same scalar on `K(β(x))`.
  ext z
  change
    ((((⟨(((β c'C : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        linear_character_value_mem_generatorField (K := K) (x := x) β c'C⟩ :
          generatorFieldCarrier (K := K) (x := x) β) * z :
            generatorFieldCarrier (K := K) (x := x) β) : AlgebraicClosure K)) =
      ((((⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β u cC :
            (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          linearCharacter_twist_value_mem_generatorField_public
            (G := G) (K := K) (x := x) β u cC⟩ :
            generatorFieldCarrier (K := K) (x := x) β) * z :
              generatorFieldCarrier (K := K) (x := x) β) : AlgebraicClosure K))
  simp [u, hc'C, linearCharacter_twist_apply_local, map_zpow]

/-- Helper for Lemma 12-12.7-5: once the restricted `Γ_K`-power automorphisms on the fixed field
`K(β(x))` are available, the source packaging over `H = C ⋅ P` is routine. -/
private theorem associatedGammaPElementarySubgroup_factorization_one_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx (1 : H)) =
      ((1 : C₀), (1 : P₀)) := by
  intro H C₀ P₀
  -- The identity element of `H` factors uniquely as `(1, 1)`.
  symm
  exact
    (Classical.choose_spec
      (associatedGammaPElementarySubgroup_factorization_local
        (K := K) (p := p) (x := x) (P := P) hx (1 : H))).2
      ((1 : C₀), (1 : P₀)) (by exact one_mul (1 : H))

/-- Helper for Lemma 12-12.7-5: an element of the cyclic factor `C ≤ H` has the canonical
factorization `(c, 1)` inside `H = C ⋅ P`. -/
private theorem associatedGammaPElementarySubgroup_factorization_of_cyclic_element_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    ∀ c : C,
      Classical.choose
          (associatedGammaPElementarySubgroup_factorization_local
            (K := K) (p := p) (x := x) (P := P) hx (Subgroup.inclusion hC c)) =
        (⟨Subgroup.inclusion hC c, Subgroup.mem_subgroupOf.mpr c.2⟩, (1 : P₀)) := by
  intro H hC C₀ P₀ c
  -- Cyclic elements already lie in the first factor, so the `P`-component is trivial.
  symm
  exact
    (Classical.choose_spec
      (associatedGammaPElementarySubgroup_factorization_local
        (K := K) (p := p) (x := x) (P := P) hx (Subgroup.inclusion hC c))).2
      (⟨Subgroup.inclusion hC c, Subgroup.mem_subgroupOf.mpr c.2⟩, (1 : P₀))
      (by exact mul_one (Subgroup.inclusion hC c))

/-- Helper for Lemma 12-12.7-5: multiplying two chosen factorizations
`h₁ = c₁ y₁` and `h₂ = c₂ y₂` produces the chosen factorization of `h₁ h₂` after moving the
second cyclic factor across `y₁` by conjugation. -/
private theorem associatedGammaPElementarySubgroup_factorization_mul_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    ∀ h₁ h₂ : H,
      let c₁ : C₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx h₁)).1
      let y₁ : P₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx h₁)).2
      let c₂ : C₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx h₂)).1
      let y₂ : P₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx h₂)).2
      let c₂' : C₀ := ⟨(y₁ : H) * c₂ * (y₁ : H)⁻¹,
        (associatedGammaPElementary_zpowers_normal_local
          (K := K) (p := p) (x := x) (P := P)).conj_mem c₂ c₂.2 (y₁ : H)⟩
      Classical.choose
          (associatedGammaPElementarySubgroup_factorization_local
            (K := K) (p := p) (x := x) (P := P) hx (h₁ * h₂)) =
        (c₁ * c₂', y₁ * y₂) := by
  intro H C₀ P₀ h₁ h₂
  let c₁ : C₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx h₁)).1
  let y₁ : P₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx h₁)).2
  let c₂ : C₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx h₂)).1
  let y₂ : P₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx h₂)).2
  let c₂' : C₀ := ⟨(y₁ : H) * c₂ * (y₁ : H)⁻¹,
    (associatedGammaPElementary_zpowers_normal_local
      (K := K) (p := p) (x := x) (P := P)).conj_mem c₂ c₂.2 (y₁ : H)⟩
  have hh₁ :
      ((c₁ : C₀) : H) * ((y₁ : P₀) : H) = h₁ :=
    (Classical.choose_spec
      (associatedGammaPElementarySubgroup_factorization_local
        (K := K) (p := p) (x := x) (P := P) hx h₁)).1
  have hh₂ :
      ((c₂ : C₀) : H) * ((y₂ : P₀) : H) = h₂ :=
    (Classical.choose_spec
      (associatedGammaPElementarySubgroup_factorization_local
        (K := K) (p := p) (x := x) (P := P) hx h₂)).1
  -- Uniqueness of the `C₀ × P₀` factorization reduces the product formula to one direct
  -- multiplication check inside `H`.
  exact
    ((Classical.choose_spec
      (associatedGammaPElementarySubgroup_factorization_local
        (K := K) (p := p) (x := x) (P := P) hx (h₁ * h₂))).2
      (c₁ * c₂', y₁ * y₂) <| by
        calc
          (((c₁ * c₂' : C₀) : H) * ((y₁ * y₂ : P₀) : H)) =
              ((c₁ : C₀) : H) * ((y₁ : P₀) : H) * (((c₂ : C₀) : H) * ((y₂ : P₀) : H)) := by
                simp [c₂']
                group
          _ = h₁ * h₂ := by rw [hh₁, hh₂]).symm

/-- Helper for Lemma 12-12.7-5: once the restricted `Γ_K`-power automorphisms on the fixed field
`K(β(x))` are available, the source packaging over `H = C ⋅ P` is routine. -/
private theorem associatedGammaPElementarySubgroup_factorized_generatorField_action_comm_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    (β : C →* (AlgebraicClosure K)ˣ) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    let cycRep : Representation K C₀ (generatorFieldCarrier (K := K) (x := x) β) :=
      (generatorField_linearCharacter_representation (K := K) (x := x) β).comp
        ((Subgroup.subgroupOfEquivOfLe hC).toMonoidHom)
    let τP : Representation K P₀ (generatorFieldCarrier (K := K) (x := x) β) :=
      Classical.choose
        (associatedGammaPElementarySubgroup_pfactor_action_from_restricted_sigma_local
          (K := K) (p := p) (x := x) (P := P) hx β)
    ∀ y : P₀, ∀ c : C₀,
      let c' : C₀ := ⟨(y : H) * c * (y : H)⁻¹,
        (associatedGammaPElementary_zpowers_normal_local
          (K := K) (p := p) (x := x) (P := P)).conj_mem c c.2 (y : H)⟩
      τP y * cycRep c = cycRep c' * τP y := by
  intro H hC C₀ P₀ cycRep τP y c c'
  have hτP := Classical.choose_spec
    (associatedGammaPElementarySubgroup_pfactor_action_from_restricted_sigma_local
      (K := K) (p := p) (x := x) (P := P) hx β)
  let u : ΓK := Classical.choose
    ((associatedGammaPElementarySubgroup_decomposition ΓK p x hx P).conjugation_eq_pow y)
  let cC : C := (Subgroup.subgroupOfEquivOfLe hC) c
  let σu :=
    generatorField_restricted_sigma_algEquiv_of_root_local
      (K := K) (x := x) β u
      (gammaSubgroup_generator_value_mem_K_aroots_local
        (K := K) (x := x) β u)
  -- Replace the chosen `P`-witness by LinearRepresentations_Serre_1977's decomposition witness and then invoke the
  -- intertwining identity on the fixed carrier.
  calc
    τP y * cycRep c =
      (σu.toLinearMap :
        Module.End K (generatorFieldCarrier (K := K) (x := x) β)) * cycRep c := by
          rw [hτP y]
          rw [← associatedGammaPElementarySubgroup_restricted_sigma_eq_of_witness_alignment_local
            (K := K) (p := p) (x := x) (P := P) hx β y]
    _ =
      (generatorField_twisted_linearCharacter_representation
          (G := G) (K := K) (x := x) β u cC) *
        (σu.toLinearMap :
          Module.End K (generatorFieldCarrier (K := K) (x := x) β)) := by
            change
              (σu.toLinearMap :
                  Module.End K (generatorFieldCarrier (K := K) (x := x) β)) *
                  (generatorField_linearCharacter_representation
                    (K := K) (x := x) β cC) =
                (generatorField_twisted_linearCharacter_representation
                    (G := G) (K := K) (x := x) β u cC) *
                  (σu.toLinearMap :
                    Module.End K (generatorFieldCarrier (K := K) (x := x) β))
            exact
              generatorField_restricted_sigma_intertwines_linearCharacter_local
                (G := G) (K := K) (x := x) β u cC
    _ = cycRep c' *
        (σu.toLinearMap :
          Module.End K (generatorFieldCarrier (K := K) (x := x) β)) := by
            rw [← associatedGammaPElementarySubgroup_conjugated_cyclic_factor_action_local
              (K := K) (p := p) (x := x) (P := P) hx β y c]
    _ = cycRep c' * τP y := by
          rw [hτP y]
          rw [← associatedGammaPElementarySubgroup_restricted_sigma_eq_of_witness_alignment_local
            (K := K) (p := p) (x := x) (P := P) hx β y]

