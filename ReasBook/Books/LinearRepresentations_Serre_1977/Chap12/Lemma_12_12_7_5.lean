private theorem associatedGammaPElementarySubgroup_factorized_action_map_mul_apply_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    (β : C →* (AlgebraicClosure K)ˣ) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
    let P₀ : Subgroup H :=
      (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
    let cycRep : Representation K C₀ (generatorFieldCarrier (K := K) (x := x) β) :=
      (generatorField_linearCharacter_representation (K := K) (x := x) β).comp
        ((Subgroup.subgroupOfEquivOfLe hC).toMonoidHom)
    let τP : Representation K P₀ (generatorFieldCarrier (K := K) (x := x) β) :=
      Classical.choose
        (associatedGammaPElementarySubgroup_pfactor_action_from_restricted_sigma_local
          (K := K) (p := p) (x := x) (P := P) hx β)
    ∀ h₁ h₂ : H, ∀ z : generatorFieldCarrier (K := K) (x := x) β,
      let c₁ : C₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx h₁)).1
      let y₁ : P₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx h₁)).2
      let c₂ : C₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx h₂)).1
      let y₂ : P₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx h₂)).2
      let c₂' : C₀ := ⟨(y₁ : H) * c₂ * (y₁ : H)⁻¹,
        (associatedGammaPElementary_zpowers_normal_local
          (K := K) (p := p) (x := x) (P := P)).conj_mem c₂ c₂.2 (y₁ : H)⟩
      let c12 : C₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx (h₁ * h₂))).1
      let y12 : P₀ := (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx (h₁ * h₂))).2
    (cycRep c12 * τP y12) z =
        (cycRep c₁ * τP y₁) ((cycRep c₂ * τP y₂) z) := by
  intro H hC C₀ P₀ cycRep τP h₁ h₂ z
  let c₁ : C₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx h₁)).1
  let y₁ : P₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx h₁)).2
  let c₂ : C₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx h₂)).1
  let y₂ : P₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx h₂)).2
  let c₂' : C₀ := ⟨(y₁ : H) * c₂ * (y₁ : H)⁻¹,
    (associatedGammaPElementary_zpowers_normal_local
      (K := K) (p := p) (x := x) (P := P)).conj_mem c₂ c₂.2 (y₁ : H)⟩
  let c12 : C₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx (h₁ * h₂))).1
  let y12 : P₀ := (Classical.choose
    (associatedGammaPElementarySubgroup_factorization_local
      (K := K) (p := p) (x := x) (P := P) hx (h₁ * h₂))).2
  have hfac :
      Classical.choose
          (associatedGammaPElementarySubgroup_factorization_local
            (K := K) (p := p) (x := x) (P := P) hx (h₁ * h₂)) =
        (c₁ * c₂', y₁ * y₂) :=
    associatedGammaPElementarySubgroup_factorization_mul_local
      (K := K) (p := p) (x := x) (P := P) hx h₁ h₂
  have hc12 : c12 = c₁ * c₂' := by
    exact congrArg Prod.fst hfac
  have hy12 : y12 = y₁ * y₂ := by
    exact congrArg Prod.snd hfac
  have hcomm :
      τP y₁ * cycRep c₂ = cycRep c₂' * τP y₁ := by
    have hcomm' :=
      associatedGammaPElementarySubgroup_factorized_generatorField_action_comm_local
        (K := K) (p := p) (x := x) (P := P) hx β y₁ c₂
    simpa only [c₂'] using hcomm'
  let A : Module.End K (generatorFieldCarrier (K := K) (x := x) β) := cycRep c₁
  let B : Module.End K (generatorFieldCarrier (K := K) (x := x) β) := cycRep c₂'
  let Cmap : Module.End K (generatorFieldCarrier (K := K) (x := x) β) := τP y₁
  let D : Module.End K (generatorFieldCarrier (K := K) (x := x) β) := cycRep c₂
  let E : Module.End K (generatorFieldCarrier (K := K) (x := x) β) := τP y₂
  have hcommEnd : Cmap * D = B * Cmap := by
    change τP y₁ * cycRep c₂ = cycRep c₂' * τP y₁
    exact hcomm
  have hmid :
      B * (Cmap * E) = (Cmap * D) * E := by
    calc
      B * (Cmap * E) = (B * Cmap) * E := by
        exact (mul_assoc B Cmap E).symm
      _ = (Cmap * D) * E := by
        rw [← hcommEnd]
  calc
    (cycRep c12 * τP y12) z =
      ((cycRep (c₁ * c₂') * τP (y₁ * y₂)) :
        Module.End K (generatorFieldCarrier (K := K) (x := x) β)) z := by
          rw [hc12, hy12]
    _ = (((cycRep c₁ * cycRep c₂') * (τP y₁ * τP y₂)) :
        Module.End K (generatorFieldCarrier (K := K) (x := x) β)) z := by
          rw [cycRep.map_mul, τP.map_mul]
    _ = ((A * (B * (Cmap * E))) :
        Module.End K (generatorFieldCarrier (K := K) (x := x) β)) z := by
          change (((A * B) * (Cmap * E)) : Module.End K
            (generatorFieldCarrier (K := K) (x := x) β)) z =
            ((A * (B * (Cmap * E))) : Module.End K
              (generatorFieldCarrier (K := K) (x := x) β)) z
          rfl
    _ = ((A * ((Cmap * D) * E)) :
        Module.End K (generatorFieldCarrier (K := K) (x := x) β)) z := by
          rw [hmid]
    _ = ((A * (Cmap * (D * E))) :
        Module.End K (generatorFieldCarrier (K := K) (x := x) β)) z := by
          change ((A * ((Cmap * D) * E)) : Module.End K
            (generatorFieldCarrier (K := K) (x := x) β)) z =
            ((A * (Cmap * (D * E))) : Module.End K
              (generatorFieldCarrier (K := K) (x := x) β)) z
          rfl
    _ = (A * Cmap) ((D * E) z) := by
          change ((A * (Cmap * (D * E))) :
            Module.End K (generatorFieldCarrier (K := K) (x := x) β)) z =
            ((A * Cmap) : Module.End K
              (generatorFieldCarrier (K := K) (x := x) β)) ((D * E) z)
          rfl
    _ = (cycRep c₁ * τP y₁) ((cycRep c₂ * τP y₂) z) := by
          change ((A * Cmap) : Module.End K
            (generatorFieldCarrier (K := K) (x := x) β)) ((D * E) z) =
            (cycRep c₁ * τP y₁) ((cycRep c₂ * τP y₂) z)
          rfl

