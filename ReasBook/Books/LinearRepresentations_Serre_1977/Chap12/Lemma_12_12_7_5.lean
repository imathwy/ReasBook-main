noncomputable section

universe u v w

section Group

variable {G : Type u} [Group G] [Finite G]

local instance : NeZero (Monoid.exponent G) := Monoid.neZero_exponent_of_finite

-- Proof sketch: the previous theorem provides the required `Γ_K`-`p`-elementary decomposition of
-- `H = C ⋅ P`, so `H` is `Γ_K`-`p`-elementary by definition.
/-- Lemma 12-12.7-5 (1): if `x` is a `p'`-element of `G`, `P` is a Sylow `p`-subgroup of `N(x)`,
and `H = C ⋅ P` with `C = ⟨x⟩`, then `H` is `Γ_K`-`p`-elementary. -/
theorem associatedGammaPElementarySubgroup_isGammaPElementary
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) [Fact p.Prime] (x : G)
    (hx : IsPRegular p x) (P : Sylow p N[ΓK](x)) :
    Subgroup.IsGammaPElementary ΓK p (associatedGammaPElementarySubgroup ΓK x P) := by
  exact ⟨_, _, associatedGammaPElementarySubgroup_decomposition ΓK p x hx P⟩

end Group

section Representation

variable {G : Type u} [Group G] [Finite G]
variable {L : Type v} [Field L] [NumberField L]
variable [IsCyclotomicExtension {Monoid.exponent G} ℚ L]
variable (K : IntermediateField ℚ L) (p : ℕ) (x : G)

/-- Helper for Lemma 12-12.7-5: a private `Fintype` witness for the finite group `G`. -/
@[reducible] private def instFintypeAssociatedGammaPElementaryGroup : Fintype G :=
  Fintype.ofFinite G

attribute [local instance] instFintypeAssociatedGammaPElementaryGroup

local notation "ΓK" => Γ[K](G)
local notation "N(" x ")" => N[ΓK](x)
local notation "C" => Subgroup.zpowers x

/-- Helper for Lemma 12-12.7-5: LinearRepresentations_Serre_1977's generator field `K(β(x))` is finite-dimensional over
`K`, because it is generated by one algebraic character value. -/
@[reducible] private def instFiniteDimensionalLemma121275GeneratorFieldCarrier
    (β : C →* (AlgebraicClosure K)ˣ) :
    FiniteDimensional K (generatorFieldCarrier (K := K) (x := x) β) :=
  IntermediateField.adjoin.finiteDimensional
    ((generatorField_generator_isAlgebraic (K := K) (x := x) β).isIntegral)

attribute [local instance] instFiniteDimensionalLemma121275GeneratorFieldCarrier

/-- Helper for Lemma 12-12.7-5: a concrete `Fintype` witness for the `K`-embeddings of LinearRepresentations_Serre_1977's
generator field into the algebraic closure. -/
@[reducible] private def instFintypeLemma121275GeneratorFieldEmbeddings
    (β : C →* (AlgebraicClosure K)ˣ) :
    Fintype (generatorFieldCarrier (K := K) (x := x) β →ₐ[K] AlgebraicClosure K) :=
  minpoly.AlgHom.fintype K (generatorFieldCarrier (K := K) (x := x) β) (AlgebraicClosure K)

attribute [local instance] instFintypeLemma121275GeneratorFieldEmbeddings

/-- Helper for Lemma 12-12.7-5: on the cyclic group `C = ⟨x⟩`, two `K`-characters agree once
their values agree on every power of the distinguished generator after mapping to the algebraic
closure. -/
private theorem character_eq_of_generator_power_values_eq_local
    {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    {W : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    (ρ : Representation K C V) (σ : Representation K C W)
    (hpow :
      ∀ n : ℤ,
        algebraMap K (AlgebraicClosure K)
            (ρ.character ((zpowers_generator (x := x)) ^ n)) =
          algebraMap K (AlgebraicClosure K)
            (σ.character ((zpowers_generator (x := x)) ^ n))) :
    ρ.character = σ.character := by
  -- Every element of `C` is a power of the distinguished generator, so it suffices to compare the
  -- transported character values on those powers.
  ext c
  rcases Subgroup.mem_zpowers_iff.mp c.2 with ⟨n, hn⟩
  have hc : c = (zpowers_generator (x := x)) ^ n := by
    apply Subtype.ext
    simpa using hn.symm
  have hmap :
      algebraMap K (AlgebraicClosure K) (ρ.character c) =
        algebraMap K (AlgebraicClosure K) (σ.character c) := by
    rw [hc]
    exact hpow n
  have hk : ρ.character c = σ.character c :=
    (algebraMap K (AlgebraicClosure K)).injective hmap
  exact congrArg (fun z : K ↦ (z : L)) hk

/-- Helper for Lemma 12-12.7-5: LinearRepresentations_Serre_1977's generator-field model is irreducible because any nonzero
subrepresentation already contains `1`, hence all of `K(β(x))`. -/
private theorem generatorField_linearCharacter_isIrreducible_local
    (β : C →* (AlgebraicClosure K)ˣ) :
    (generatorField_linearCharacter_representation (K := K) (x := x) β).IsIrreducible := by
  -- Route correction: this packages the simplicity argument once, so the final equivalence proof
  -- can invoke the cyclic character comparison directly.
  let τ := generatorField_linearCharacter_representation (K := K) (x := x) β
  have hτ_nontrivial : Nontrivial (Subrepresentation τ) := by
    refine ⟨⟨⊥, ⊤, ?_⟩⟩
    intro hbot_top
    have hbot_top_submodule :
        (⊥ : Submodule K (generatorFieldCarrier (K := K) (x := x) β)) = ⊤ := by
      exact congrArg Subrepresentation.toSubmodule hbot_top
    exact bot_ne_top hbot_top_submodule
  refine IsSimpleOrder.of_forall_eq_top ?_
  intro σ hσ
  exact generatorField_subrepresentation_eq_top_of_nonzero_local (K := K) (x := x) β σ hσ

/-- Helper for Lemma 12-12.7-5: once the universal map out of `K(β(x))` sends the distinguished
generator `β(x)` to the generator value of another linear character `γ`, it evaluates every power
`β(x^n)` at the corresponding value `γ(x^n)`. -/
private theorem generatorField_algHom_of_generator_root_apply_generator_powers_local
    (β γ : C →* (AlgebraicClosure K)ˣ)
    {a : AlgebraicClosure K}
    (ha : a ∈
      (minpoly K
        (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K))).aroots (AlgebraicClosure K))
    (hgen :
      a =
        (((γ (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)))
    (n : ℤ) :
    generatorField_algHom_of_generator_root (K := K) (x := x) β ha
        (⟨((β ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            ((zpowers_generator (x := x)) ^ n)⟩ :
            generatorFieldCarrier (K := K) (x := x) β) =
      (((γ ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) := by
  -- First rewrite both source and target values as powers of the distinguished generator value.
  have hpow_domain :
      (⟨((β ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K),
        linear_character_value_mem_generatorField (K := K) (x := x) β
          ((zpowers_generator (x := x)) ^ n)⟩ :
          generatorFieldCarrier (K := K) (x := x) β) =
        (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) ^ n := by
    apply Subtype.ext
    change (((β ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K)) =
      ((((⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)),
        linear_character_value_mem_generatorField (K := K) (x := x) β
          (zpowers_generator (x := x))⟩ :
          generatorFieldCarrier (K := K) (x := x) β) ^ n :
            generatorFieldCarrier (K := K) (x := x) β) : AlgebraicClosure K))
    rw [map_zpow]
    have hcoe_pow :
        ((((⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) ^ n :
              generatorFieldCarrier (K := K) (x := x) β) : AlgebraicClosure K)) =
          ((((⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
              AlgebraicClosure K)),
            linear_character_value_mem_generatorField (K := K) (x := x) β
              (zpowers_generator (x := x))⟩ :
              generatorFieldCarrier (K := K) (x := x) β) : AlgebraicClosure K)) ^ n) := rfl
    rw [hcoe_pow]
    simpa
  calc
    generatorField_algHom_of_generator_root (K := K) (x := x) β ha
        (⟨((β ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            ((zpowers_generator (x := x)) ^ n)⟩ :
            generatorFieldCarrier (K := K) (x := x) β) =
      generatorField_algHom_of_generator_root (K := K) (x := x) β ha
        ((⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) ^ n) := by
          rw [hpow_domain]
    _ =
      (generatorField_algHom_of_generator_root (K := K) (x := x) β ha
        (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β)) ^ n := by
          simpa using
            map_zpow
              (generatorField_algHom_of_generator_root (K := K) (x := x) β ha)
              (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
                  AlgebraicClosure K)),
                linear_character_value_mem_generatorField (K := K) (x := x) β
                  (zpowers_generator (x := x))⟩ :
                  generatorFieldCarrier (K := K) (x := x) β)
              n
    _ = a ^ n := by
          rw [generatorField_algHom_of_generator_root_apply_generator (K := K) (x := x) β ha]
    _ =
      ((((γ (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ^ n) := by
          rw [hgen]
    _ =
      (((γ ((zpowers_generator (x := x)) ^ n) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) := by
          simp [map_zpow]

/-- Helper for Lemma 12-12.7-5: the distinguished generator value `β(x)` is a primitive root of
unity of order equal to its multiplicative order. -/
private theorem generator_value_isPrimitiveRoot_local
    (β : C →* (AlgebraicClosure K)ˣ) :
    IsPrimitiveRoot
      (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
      (orderOf (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K))) := by
  -- This records the cyclotomic nature of `β(x)` once and for all before the remaining
  -- `Γ_K`-conjugacy bridge over the base field `K` is addressed.
  simpa using
    (IsPrimitiveRoot.orderOf
      (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K)))

/-- Helper for Lemma 12-12.7-5: the `Γ_K`-power exponent is coprime to the order of the
distinguished generator value `β(x)`. -/
private theorem generator_value_order_coprime_galoisExponent_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    Nat.Coprime
      (orderOf (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K)))
      (galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) := by
  let αu : (AlgebraicClosure K)ˣ := β (zpowers_generator (x := x))
  let n : ℕ := galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)
  have hcop_x :
      Nat.Coprime (orderOf x) n :=
    (Nat.Coprime.of_dvd_right (Monoid.order_dvd_exponent x)
      (ZMod.val_coe_unit_coprime (t : (ZMod (Monoid.exponent G))ˣ))).symm
  have hαpow : αu ^ orderOf x = 1 := by
    rw [← map_pow]
    have hxpow : (zpowers_generator (x := x)) ^ orderOf x = 1 := by
      apply Subtype.ext
      simpa using pow_orderOf_eq_one x
    simpa using congrArg β hxpow
  have hα_dvd : orderOf αu ∣ orderOf x := orderOf_dvd_of_pow_eq_one hαpow
  simpa [αu, n, orderOf_units] using hcop_x.of_dvd_left hα_dvd

/-- Helper for Lemma 12-12.7-5: the cyclotomic integer minimal polynomial of `β(x)` vanishes on
every `Γ_K`-power of that distinguished value. -/
private theorem generator_value_pow_isRoot_int_minpoly_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    Polynomial.IsRoot
      (Polynomial.map (Int.castRingHom (AlgebraicClosure K))
        (minpoly ℤ
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))))
      ((((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ^
        galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) := by
  let α : AlgebraicClosure K :=
    (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  let n : ℕ := galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)
  have hprim :
      IsPrimitiveRoot α (orderOf α) :=
    generator_value_isPrimitiveRoot_local (K := K) (x := x) β
  have hcop :
      Nat.Coprime (orderOf α) n :=
    generator_value_order_coprime_galoisExponent_local (K := K) (x := x) β t
  simpa [α, n] using hprim.pow_isRoot_minpoly hcop.symm

/-- Helper for Lemma 12-12.7-5: the twisted value of the distinguished generator already
satisfies the cyclotomic integer minimal polynomial of `β(x)`. -/
private theorem twisted_generator_value_isRoot_int_minpoly_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    Polynomial.IsRoot
      (Polynomial.map (Int.castRingHom (AlgebraicClosure K))
        (minpoly ℤ
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))))
  (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) := by
  -- First rewrite LinearRepresentations_Serre_1977's twisted generator value as the corresponding `Γ_K`-power of `β(x)`.
  rw [linearCharacter_twist_apply_local]
  exact generator_value_pow_isRoot_int_minpoly_local (K := K) (x := x) β t

/-- Helper for Lemma 12-12.7-5: on scalar values, LinearRepresentations_Serre_1977's twisted generator is literally the
corresponding `Γ_K`-power of `β(x)`. -/
private theorem twisted_generator_value_eq_generator_power_scalar_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    (((linearCharacter_twist (G := G) (K := K) (x := x) β t
        (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K)) =
      ((((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ^
        galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) := by
  -- This is the scalar version of LinearRepresentations_Serre_1977's twist-on-the-generator formula.
  simpa [linearCharacter_twist_apply_local]

/-- Helper for Lemma 12-12.7-5: the `Γ_K`-power of the distinguished generator value is already
an integer cyclotomic conjugate of `β(x)`. -/
private theorem generator_value_pow_isConjRoot_int_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    IsConjRoot ℤ
      (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K))
      ((((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ^
        galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) := by
  let αu : (AlgebraicClosure K)ˣ := β (zpowers_generator (x := x))
  let α : AlgebraicClosure K := (αu : AlgebraicClosure K)
  let n : ℕ := galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)
  have hprim :
      IsPrimitiveRoot α (orderOf α) :=
    generator_value_isPrimitiveRoot_local (K := K) (x := x) β
  have hcop :
      Nat.Coprime n (orderOf α) :=
    (generator_value_order_coprime_galoisExponent_local (K := K) (x := x) β t).symm
  -- The cyclotomic primitive-root API already identifies the integer minimal polynomial of `α`
  -- with that of its `Γ_K`-power.
  simpa [IsConjRoot, αu, α, n] using hprim.minpoly_eq_pow_coprime hcop

/-- Helper for Lemma 12-12.7-5: LinearRepresentations_Serre_1977's twisted generator value is already an integer cyclotomic
conjugate of the original generator value `β(x)`. -/
private theorem twisted_generator_value_isConjRoot_int_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    IsConjRoot ℤ
      (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K))
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) := by
  -- Route correction: this isolates the source-faithful cyclotomic step before the remaining
  -- upgrade from `ℤ`-conjugacy to `K`-conjugacy.
  rw [linearCharacter_twist_apply_local]
  exact generator_value_pow_isConjRoot_int_local (K := K) (x := x) β t

/-- Helper for Lemma 12-12.7-5: the same cyclotomic argument already upgrades the twisted
generator value to a rational conjugate of `β(x)`. -/
private theorem twisted_generator_value_isConjRoot_rat_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    IsConjRoot ℚ
      (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K))
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) := by
  let α : AlgebraicClosure K :=
    (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  let αt : AlgebraicClosure K :=
    (((linearCharacter_twist (G := G) (K := K) (x := x) β t
        (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  have hInt :
      IsConjRoot ℤ α αt := by
    -- First keep the source cyclotomic conjugacy over `ℤ`.
    simpa [α, αt] using
      twisted_generator_value_isConjRoot_int_local (K := K) (x := x) β t
  have hα_pow : α ^ orderOf x = 1 := by
    -- The generator value is a root of unity because `x` has finite order in `G`.
    dsimp [α]
    have hxpow : (zpowers_generator (x := x)) ^ orderOf x = 1 := by
      apply Subtype.ext
      simpa using pow_orderOf_eq_one x
    have hunit_pow :
        (β (zpowers_generator (x := x))) ^ orderOf x = 1 := by
      rw [← map_pow]
      simpa using congrArg β hxpow
    exact congrArg (fun z : (AlgebraicClosure K)ˣ ↦ ((z : AlgebraicClosure K))) hunit_pow
  have hα_int : IsIntegral ℤ α := by
    -- A root of unity is integral over `ℤ`; prove this from the monic polynomial `X^(orderOf x)-1`.
    refine IsIntegral.of_pow (orderOf_pos x) ?_
    rw [hα_pow]
    have hOne : IsIntegral ℤ (((algebraMap ℤ (AlgebraicClosure K)) 1)) := isIntegral_algebraMap
    simpa using hOne
  have hαt_int : IsIntegral ℤ αt :=
    hInt.isIntegral hα_int
  letI : IsIntegrallyClosed ℤ := GCDMonoid.toIsIntegrallyClosed
  have hα_rat :
      minpoly ℚ α = (minpoly ℤ α).map (Int.castRingHom ℚ) := by
    -- For integral elements, the rational minimal polynomial is the fraction-field image
    -- of the integral minimal polynomial.
    simpa using
      (minpoly.isIntegrallyClosed_eq_field_fractions' (K := ℚ) hα_int)
  have hαt_rat :
      minpoly ℚ αt = (minpoly ℤ αt).map (Int.castRingHom ℚ) := by
    -- Apply the same fraction-field comparison to the twisted generator value.
    simpa using
      (minpoly.isIntegrallyClosed_eq_field_fractions' (K := ℚ) hαt_int)
  -- Mapping the already-equal integer minimal polynomials to `ℚ` gives the rational conjugacy.
  rw [IsConjRoot, hα_rat, hαt_rat, hInt]

/-- Helper for Lemma 12-12.7-5: equivalently, the twisted generator value is already a root of the
`ℚ`-minimal polynomial of `β(x)`. -/
private theorem twisted_generator_value_mem_rat_aroots_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    (((linearCharacter_twist (G := G) (K := K) (x := x) β t
        (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K)) ∈
      (minpoly ℚ
        (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K))).aroots (AlgebraicClosure K) := by
  let α : AlgebraicClosure K :=
    (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  let αt : AlgebraicClosure K :=
    (((linearCharacter_twist (G := G) (K := K) (x := x) β t
        (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  have hα_pow : α ^ orderOf x = 1 := by
    -- As above, `β(x)` is a root of unity because `x` has finite order.
    dsimp [α]
    have hxpow : (zpowers_generator (x := x)) ^ orderOf x = 1 := by
      apply Subtype.ext
      simpa using pow_orderOf_eq_one x
    have hunit_pow :
        (β (zpowers_generator (x := x))) ^ orderOf x = 1 := by
      rw [← map_pow]
      simpa using congrArg β hxpow
    exact congrArg (fun z : (AlgebraicClosure K)ˣ ↦ ((z : AlgebraicClosure K))) hunit_pow
  have hα_intZ : IsIntegral ℤ α := by
    -- Use the same monic root-of-unity polynomial to record integrality over `ℤ`.
    refine IsIntegral.of_pow (orderOf_pos x) ?_
    rw [hα_pow]
    have hOne : IsIntegral ℤ (((algebraMap ℤ (AlgebraicClosure K)) 1)) := isIntegral_algebraMap
    simpa using hOne
  have hα_intQ : IsIntegral ℚ α := hα_intZ.tower_top
  -- Rephrase the restored rational conjugacy as membership in the rational root packet.
  exact
    (isConjRoot_iff_mem_minpoly_aroots hα_intQ).mp
      (by
        simpa [α, αt] using
          twisted_generator_value_isConjRoot_rat_local (K := K) (x := x) β t)

/-- Helper for Lemma 12-12.7-5: LinearRepresentations_Serre_1977's actual arithmetic bridge is that the `Γ_K`-power twist of
the distinguished generator value is already a root of the `K`-minimal polynomial of `β(x)`. -/
private theorem gammaSubgroup_exists_algEquiv_apply_generator_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    ∃ σ : AlgebraicClosure K ≃ₐ[K] AlgebraicClosure K,
      σ
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)) =
        (((linearCharacter_twist (G := G) (K := K) (x := x) β t
            (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)) := by
  let α : AlgebraicClosure K :=
    (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  let n : ℕ := galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)
  letI : Algebra K (AlgebraicClosure K) := AlgebraicClosure.instAlgebra K
  let j : L →+* AlgebraicClosure K := (IsAlgClosed.lift (R := K) : L →ₐ[K] AlgebraicClosure K).toRingHom
  let ι : L →ₐ[K] AlgebraicClosure K := IsAlgClosed.lift (R := K)
  letI : Algebra L (AlgebraicClosure K) := ι.toAlgebra
  letI : HasEnoughRootsOfUnity L (Monoid.exponent G) := by
    refine ⟨?_, rootsOfUnity.isCyclic _ _⟩
    simpa using
      (IsCyclotomicExtension.exists_isPrimitiveRoot
        (S := {Monoid.exponent G}) (A := ℚ) (B := L)
        (n := Monoid.exponent G) (by simp)
        (show Monoid.exponent G ≠ 0 by exact NeZero.ne _))
  have hprimL : (primitiveRoots (Monoid.exponent G) L).Nonempty := by
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L (Monoid.exponent G)
    exact ⟨ζ, by
      simpa [mem_primitiveRoots (show 0 < Monoid.exponent G by exact NeZero.pos _)] using hζ⟩
  let e : rootsOfUnity (Monoid.exponent G) L ≃*
      rootsOfUnity (Monoid.exponent G) (AlgebraicClosure K) :=
    rootsOfUnityEquivOfPrimitiveRoots (f := j) j.injective hprimL
  have hαexp : α ^ Monoid.exponent G = 1 := by
    -- The generator value has exponent dividing `exp(G)`, so it defines an honest
    -- `exp(G)`-th root of unity inside `AlgebraicClosure K`.
    dsimp [α]
    have hxpow : (zpowers_generator (x := x)) ^ Monoid.exponent G = 1 := by
      apply Subtype.ext
      simpa using Monoid.pow_exponent_eq_one x
    have hunit_pow :
        (β (zpowers_generator (x := x))) ^ Monoid.exponent G = 1 := by
      rw [← map_pow]
      simpa using congrArg β hxpow
    exact congrArg (fun z : (AlgebraicClosure K)ˣ ↦ ((z : AlgebraicClosure K))) hunit_pow
  let αRoots : rootsOfUnity (Monoid.exponent G) (AlgebraicClosure K) :=
    rootsOfUnity.mkOfPowEq α hαexp
  let aLRoots : rootsOfUnity (Monoid.exponent G) L := e.symm αRoots
  let aL : L := ((aLRoots : Lˣ) : L)
  have hjaL : j aL = α := by
    -- Choose the `L`-root whose image under the fixed embedding `L → AlgebraicClosure K` is the
    -- distinguished generator value `β(x)`.
    have hunit :
        j (((e.symm αRoots : rootsOfUnity (Monoid.exponent G) L) : Lˣ) : L) =
          (((αRoots : rootsOfUnity (Monoid.exponent G) (AlgebraicClosure K)) :
              (AlgebraicClosure K)ˣ) : AlgebraicClosure K) := by
      simpa using
        rootsOfUnityEquivOfPrimitiveRoots_symm_apply (f := j) j.injective hprimL αRoots
    simpa [aL, αRoots, rootsOfUnity.coe_mkOfPowEq] using
      hunit
  have hιaL : ι aL = α := by
    simpa [j] using hjaL
  let σ0 : Gal(L / ℚ) :=
    (IsCyclotomicExtension.Rat.galEquivZMod (Monoid.exponent G) L).symm
      (t : (ZMod (Monoid.exponent G))ˣ)
  have htfix : σ0 ∈ K.fixingSubgroup := by
    exact Subgroup.mem_map_equiv.mp t.2
  let σK : L ≃ₐ[K] L :=
    { σ0 with
      commutes' := by
        intro a
        exact (IntermediateField.mem_fixingSubgroup_iff K _).1 htfix _ a.2 }
  letI : Normal K (AlgebraicClosure K) := by
    infer_instance
  let σ : Gal(AlgebraicClosure K / K) := σK.liftNormal (AlgebraicClosure K)
  refine ⟨σ, ?_⟩
  have haLpow_units : ((aLRoots : Lˣ) : L) ^ Monoid.exponent G = 1 := by
    have hpow_units : (aLRoots : Lˣ) ^ Monoid.exponent G = 1 :=
      (mem_rootsOfUnity _ (aLRoots : Lˣ)).mp aLRoots.prop
    exact congrArg (fun z : Lˣ ↦ (z : L)) hpow_units
  have hσ0aL : σ0 aL = aL ^ n := by
    -- On the cyclotomic field `L`, the chosen `Γ[K](G)` witness acts by the expected power map on
    -- every `exp(G)`-th root of unity.
    have :=
      IsCyclotomicExtension.Rat.galEquivZMod_apply_of_pow_eq
        (n := Monoid.exponent G) (K := L) σ0 (by simpa [aL] using haLpow_units)
    have hσ0_eq :
        IsCyclotomicExtension.Rat.galEquivZMod (Monoid.exponent G) L σ0 =
          (t : (ZMod (Monoid.exponent G))ˣ) := by
      exact
        MulEquiv.apply_symm_apply
          (IsCyclotomicExtension.Rat.galEquivZMod (Monoid.exponent G) L)
          (t : (ZMod (Monoid.exponent G))ˣ)
    calc
      σ0 aL =
          aL ^ (IsCyclotomicExtension.Rat.galEquivZMod (Monoid.exponent G) L σ0).val.val := this
      _ = aL ^ n := by
            rw [hσ0_eq]
  have hσaL : σK aL = aL ^ n := by
    simpa [σK] using hσ0aL
  -- Lift the `K`-automorphism of `L` to `AlgebraicClosure K` and evaluate it on the chosen
  -- generator root.
  calc
    σ α = σ (ι aL) := by rw [hιaL]
    _ = ι (σK aL) := by
          exact σK.liftNormal_commutes (E := AlgebraicClosure K) aL
    _ = ι (aL ^ n) := by rw [hσaL]
    _ = (ι aL) ^ n := by simp [map_pow]
    _ = α ^ n := by rw [hιaL]
    _ =
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) := by
            -- The remaining rewrite is exactly LinearRepresentations_Serre_1977's scalar generator-twist identity.
            simpa [α, n] using
              (twisted_generator_value_eq_generator_power_scalar_local
                (G := G) (K := K) (x := x) β t).symm

/-- Helper for Lemma 12-12.7-5: LinearRepresentations_Serre_1977's actual arithmetic bridge is that the `Γ_K`-power twist of
the distinguished generator value is already a root of the `K`-minimal polynomial of `β(x)`. -/
private theorem gammaSubgroup_generator_value_mem_K_aroots_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    (((linearCharacter_twist (G := G) (K := K) (x := x) β t
        (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
        AlgebraicClosure K)) ∈
      (minpoly K
        (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K))).aroots (AlgebraicClosure K) := by
  let α : AlgebraicClosure K :=
    (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  let αt : AlgebraicClosure K :=
    (((linearCharacter_twist (G := G) (K := K) (x := x) β t
        (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  -- Use the extracted `K`-automorphism witness to convert LinearRepresentations_Serre_1977's power twist into
  -- `K`-conjugacy of the distinguished generator values.
  obtain ⟨σ, hσ⟩ :=
    gammaSubgroup_exists_algEquiv_apply_generator_local
      (K := K) (x := x) β t
  have hconj : IsConjRoot K α αt := by
    -- Rewrite the explicit image of `β(x)` under the witnessed `K`-automorphism to the twisted
    -- generator value before invoking the standard conjugacy lemma.
    simpa [α, αt] using
      (hσ ▸ isConjRoot_of_algEquiv (R := K)
        (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) σ)
  -- Once the twisted value is a `K`-conjugate of `β(x)`, it is a root of the same `K`-minimal
  -- polynomial.
  exact
    (isConjRoot_iff_mem_minpoly_aroots
      ((generatorField_generator_isAlgebraic (K := K) (x := x) β).isIntegral)).mp <| by
        simpa [α, αt] using hconj

/-- Helper for Lemma 12-12.7-5: the trivial `Γ_K`-power acts on `x` by the identity. -/
private theorem gammaSubgroup_pow_one_eq_self_local :
    (x ^ (1 : ΓK) : G) = x := by
  -- This is the distinguished base case for the later witness-independence and `P`-action
  -- normalizations.
  rw [pow_subgroup_eq_pow_nat]
  change x ^ ((1 : ZMod (Monoid.exponent G)).val) = x
  have hpow : x ^ (1 % Monoid.exponent G) = x ^ 1 := by
    simpa using (Eq.symm (@Monoid.pow_eq_mod_exponent G _ 1 x))
  simpa [ZMod.val_one_eq_one_mod] using hpow

/-- Helper for Lemma 12-12.7-5: composing two `Γ_K`-power actions on `x` multiplies the
corresponding exponent units. -/
private theorem gammaSubgroup_pow_mul_local
    (t u : ΓK) :
    (x ^ t : G) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) = x ^ (t * u) := by
  -- This is the concrete power-composition formula used when multiplying LinearRepresentations_Serre_1977's chosen
  -- `Γ_K`-witnesses in the `P`-factor.
  rw [pow_subgroup_eq_pow_nat, ← pow_mul, pow_subgroup_eq_pow_nat]
  rw [Monoid.pow_eq_mod_exponent]
  congr
  exact
    (ZMod.val_mul
      (((t : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)))
      (((u : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)))).symm

/-- Helper for Lemma 12-12.7-5: the universal map sending `β(x)` to the twisted generator value
already lands back in `K(β(x))`, because that field is generated over `K` by one element. -/
private theorem generatorField_algHom_of_root_maps_to_generatorField_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK)
    (ha :
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ∈
        (minpoly K
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))).aroots (AlgebraicClosure K)) :
    ∀ z : generatorFieldCarrier (K := K) (x := x) β,
      generatorField_algHom_of_generator_root (K := K) (x := x) β ha z ∈
        generatorFieldOfLinearCharacter (K := K) (x := x) β := by
  let φ := generatorField_algHom_of_generator_root (K := K) (x := x) β ha
  let α : AlgebraicClosure K :=
    (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K))
  intro z
  change φ z ∈ IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))
  -- The domain is the simple adjoin `K⟮α⟯`, so it suffices to check the image of `α`.
  refine IntermediateField.adjoin_induction (F := K)
    (s := ({α} : Set (AlgebraicClosure K)))
    (p := fun y hy ↦ φ ⟨y, hy⟩ ∈ IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K)))
    ?_ ?_ ?_ ?_ ?_ z.2
  · intro y hy
    simp only [Set.mem_singleton_iff] at hy
    subst hy
    -- On the distinguished generator, the universal map gives LinearRepresentations_Serre_1977's twisted value.
    have hφ :
        φ (⟨α,
            linear_character_value_mem_generatorField (K := K) (x := x) β
              (zpowers_generator (x := x))⟩ :
              generatorFieldCarrier (K := K) (x := x) β) =
          (((linearCharacter_twist (G := G) (K := K) (x := x) β t
              (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
              AlgebraicClosure K)) := by
      simpa [φ, α] using
        generatorField_algHom_of_generator_root_apply_generator (K := K) (x := x) β ha
    rw [show φ ⟨α, IntermediateField.subset_adjoin K ({α} : Set (AlgebraicClosure K)) (by simp)⟩ =
        φ (⟨α,
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) by rfl]
    rw [hφ]
    simpa [α] using
      (linearCharacter_twist_value_mem_generatorField_public
        (G := G) (K := K) (x := x) β t (zpowers_generator (x := x)))
  · intro r
    -- The target field contains the image of the base field `K`.
    have hcomm :
        φ ⟨algebraMap K (AlgebraicClosure K) r,
            (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).algebraMap_mem r⟩ =
          algebraMap K (AlgebraicClosure K) r := by
      have hsub :
          (⟨algebraMap K (AlgebraicClosure K) r,
              (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).algebraMap_mem r⟩ :
              generatorFieldCarrier (K := K) (x := x) β) =
            algebraMap K (generatorFieldCarrier (K := K) (x := x) β) r := by
        apply Subtype.ext
        rfl
      calc
        φ ⟨algebraMap K (AlgebraicClosure K) r,
            (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).algebraMap_mem r⟩ =
          φ (algebraMap K (generatorFieldCarrier (K := K) (x := x) β) r) := by rw [hsub]
        _ = algebraMap K (AlgebraicClosure K) r := by
          simpa [φ] using φ.commutes r
    rw [hcomm]
    exact (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).algebraMap_mem r
  · intro y₁ y₂ hy₁ hy₂ hy₁_mem hy₂_mem
    -- Closure under addition keeps the image inside the same simple field.
    rw [show φ ⟨y₁ + y₂, (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).add_mem hy₁ hy₂⟩ =
        φ ⟨y₁, hy₁⟩ + φ ⟨y₂, hy₂⟩ by
          simpa [φ] using φ.map_add ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩]
    exact (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).add_mem hy₁_mem hy₂_mem
  · intro y hy hy_mem
    -- Closure under inversion does the same for field inverses.
    have hmap_inv :
        φ ⟨y⁻¹, (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).inv_mem hy⟩ =
          (φ ⟨y, hy⟩)⁻¹ := by
      have hsubInv :
          (⟨y⁻¹, (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).inv_mem hy⟩ :
              generatorFieldCarrier (K := K) (x := x) β) =
            (⟨y, hy⟩ : generatorFieldCarrier (K := K) (x := x) β)⁻¹ := by
        apply Subtype.ext
        rfl
      calc
        φ ⟨y⁻¹, (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).inv_mem hy⟩ =
          φ ((⟨y, hy⟩ : generatorFieldCarrier (K := K) (x := x) β)⁻¹) := by rw [hsubInv]
        _ = (φ ⟨y, hy⟩)⁻¹ := by
          simpa [φ] using map_inv₀ φ ⟨y, hy⟩
    rw [hmap_inv]
    exact (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).inv_mem hy_mem
  · intro y₁ y₂ hy₁ hy₂ hy₁_mem hy₂_mem
    -- Closure under multiplication completes the adjoin induction.
    rw [show φ ⟨y₁ * y₂, (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).mul_mem hy₁ hy₂⟩ =
        φ ⟨y₁, hy₁⟩ * φ ⟨y₂, hy₂⟩ by
          simpa [φ] using φ.map_mul ⟨y₁, hy₁⟩ ⟨y₂, hy₂⟩]
    exact (IntermediateField.adjoin K ({α} : Set (AlgebraicClosure K))).mul_mem hy₁_mem hy₂_mem

/-- Helper for Lemma 12-12.7-5: codomain-restrict the universal map attached to the twisted
generator root so it becomes an endomorphism of `K(β(x))`. -/
private noncomputable def generatorField_restricted_sigma_algHom_of_root_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK)
    (ha :
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ∈
        (minpoly K
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))).aroots (AlgebraicClosure K)) :
    generatorFieldCarrier (K := K) (x := x) β →ₐ[K]
      generatorFieldCarrier (K := K) (x := x) β :=
  (generatorField_algHom_of_generator_root (K := K) (x := x) β ha).codRestrict
    (generatorFieldOfLinearCharacter (K := K) (x := x) β).toSubalgebra
    (generatorField_algHom_of_root_maps_to_generatorField_local
      (K := K) (x := x) β t ha)

/-- Helper for Lemma 12-12.7-5: the cod-restricted universal map is bijective because it is an
injective endomorphism of a finite-dimensional `K`-vector space. -/
private theorem generatorField_restricted_sigma_algHom_of_root_bijective_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK)
    (ha :
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ∈
        (minpoly K
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))).aroots (AlgebraicClosure K)) :
    Function.Bijective
      (generatorField_restricted_sigma_algHom_of_root_local
        (K := K) (x := x) β t ha) := by
  let φ := generatorField_restricted_sigma_algHom_of_root_local
    (K := K) (x := x) β t ha
  have hinj : Function.Injective φ := RingHom.injective φ.toRingHom
  have hsurjLinear : Function.Surjective φ.toLinearMap := by
    -- Equal finite dimensions convert injectivity of the field endomorphism into surjectivity.
    exact
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
        (f := φ.toLinearMap) (by simp)).1 (by simpa using hinj)
  have hsurj : Function.Surjective φ := by
    simpa using hsurjLinear
  exact ⟨hinj, hsurj⟩

/-- Helper for Lemma 12-12.7-5: once the cod-restricted universal map is known to be bijective,
it upgrades to LinearRepresentations_Serre_1977's restricted `K`-algebra automorphism of `K(β(x))`. -/
private noncomputable def generatorField_restricted_sigma_algEquiv_of_root_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK)
    (ha :
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ∈
        (minpoly K
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))).aroots (AlgebraicClosure K)) :
    generatorFieldCarrier (K := K) (x := x) β ≃ₐ[K]
      generatorFieldCarrier (K := K) (x := x) β :=
  AlgEquiv.ofBijective
    (generatorField_restricted_sigma_algHom_of_root_local
      (K := K) (x := x) β t ha)
    (generatorField_restricted_sigma_algHom_of_root_bijective_local
      (K := K) (x := x) β t ha)

/-- Helper for Lemma 12-12.7-5: the restricted automorphism built from a root witness sends the
distinguished generator `β(x)` to the twisted generator value. -/
private theorem generatorField_restricted_sigma_algEquiv_of_root_apply_generator_local
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK)
    (ha :
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ∈
        (minpoly K
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))).aroots (AlgebraicClosure K)) :
    generatorField_restricted_sigma_algEquiv_of_root_local
        (K := K) (x := x) β t ha
        (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) =
        (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t
            (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linearCharacter_twist_value_mem_generatorField_public
            (G := G) (K := K) (x := x) β t (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) := by
  -- The restricted automorphism is definitionally the cod-restricted universal map, so the
  -- generator formula is exactly the universal-property computation.
  apply Subtype.ext
  simpa [generatorField_restricted_sigma_algEquiv_of_root_local,
    generatorField_restricted_sigma_algHom_of_root_local] using
    generatorField_algHom_of_generator_root_apply_generator (K := K) (x := x) β ha

/-- Helper for Lemma 12-12.7-5: if two `Γ_K`-witnesses send `x` to the same power, then the
corresponding restricted simple-field automorphisms agree. -/
private theorem generatorField_restricted_sigma_algEquiv_of_root_eq_of_generator_power_eq_local
    (β : C →* (AlgebraicClosure K)ˣ) {t u : ΓK}
    (htu : (x ^ t : G) = x ^ u)
    (ht :
      (((linearCharacter_twist (G := G) (K := K) (x := x) β t
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ∈
        (minpoly K
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))).aroots (AlgebraicClosure K))
    (hu :
      (((linearCharacter_twist (G := G) (K := K) (x := x) β u
          (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
          AlgebraicClosure K)) ∈
        (minpoly K
          (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))).aroots (AlgebraicClosure K)) :
    generatorField_restricted_sigma_algEquiv_of_root_local
        (K := K) (x := x) β t ht =
      generatorField_restricted_sigma_algEquiv_of_root_local
        (K := K) (x := x) β u hu := by
  -- The simple field `K(β(x))` is generated by `β(x)`, so equality on that generator already
  -- proves equality of the two restricted automorphisms.
  apply generatorField_algEquiv_eq_of_apply_generator_eq (G := G) (K := K) (x := x) β
  calc
    generatorField_restricted_sigma_algEquiv_of_root_local
        (K := K) (x := x) β t ht
        (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
