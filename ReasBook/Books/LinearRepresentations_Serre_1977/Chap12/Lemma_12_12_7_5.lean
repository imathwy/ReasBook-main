/-- Helper for Lemma 12-12.7-5: once the restricted `Γ_K`-power automorphisms on the fixed field
`K(β(x))` are available, the source packaging over `H = C ⋅ P` is routine. -/
private theorem associatedGammaPElementarySubgroup_generatorField_extension_from_restricted_sigma_local
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    (β : C →* (AlgebraicClosure K)ˣ) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    ∃ σβ : Representation K H (generatorFieldCarrier (K := K) (x := x) β),
      σβ.comp (Subgroup.inclusion hC) =
        generatorField_linearCharacter_representation (K := K) (x := x) β := by
  classical
  intro H hC
  let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
  let P₀ : Subgroup H :=
    (Subgroup.map N(x).subtype (P : Subgroup N(x))).subgroupOf H
  let cycRep : Representation K C₀ (generatorFieldCarrier (K := K) (x := x) β) :=
    (generatorField_linearCharacter_representation (K := K) (x := x) β).comp
      ((Subgroup.subgroupOfEquivOfLe hC).toMonoidHom)
  let τP : Representation K P₀ (generatorFieldCarrier (K := K) (x := x) β) :=
    Classical.choose
      (associatedGammaPElementarySubgroup_pfactor_action_from_restricted_sigma_local
        (K := K) (p := p) (x := x) (P := P) hx β)
  let σβ : Representation K H (generatorFieldCarrier (K := K) (x := x) β) :=
    { toFun := fun h =>
        let c : C₀ := (Classical.choose
          (associatedGammaPElementarySubgroup_factorization_local
            (K := K) (p := p) (x := x) (P := P) hx h)).1
        let y : P₀ := (Classical.choose
          (associatedGammaPElementarySubgroup_factorization_local
            (K := K) (p := p) (x := x) (P := P) hx h)).2
        cycRep c * τP y
      map_one' := by
        let c1 : C₀ := (Classical.choose
          (associatedGammaPElementarySubgroup_factorization_local
            (K := K) (p := p) (x := x) (P := P) hx (1 : H))).1
        let y1 : P₀ := (Classical.choose
          (associatedGammaPElementarySubgroup_factorization_local
            (K := K) (p := p) (x := x) (P := P) hx (1 : H))).2
        have hone :
            Classical.choose
                (associatedGammaPElementarySubgroup_factorization_local
                  (K := K) (p := p) (x := x) (P := P) hx (1 : H)) =
              ((1 : C₀), (1 : P₀)) :=
          associatedGammaPElementarySubgroup_factorization_one_local
            (K := K) (p := p) (x := x) (P := P) hx
        have hc1 : c1 = 1 := by
          exact congrArg Prod.fst hone
        have hy1 : y1 = 1 := by
          exact congrArg Prod.snd hone
        change cycRep c1 * τP y1 = 1
        rw [hc1, hy1, cycRep.map_one, τP.map_one]
        rfl
      map_mul' := by
        intro h₁ h₂
        ext z
        exact congrArg Subtype.val <|
          associatedGammaPElementarySubgroup_factorized_action_map_mul_apply_local
            (K := K) (p := p) (x := x) (P := P) hx β h₁ h₂ z }
  refine ⟨σβ, ?_⟩
  ext c z
  let c0 : C₀ := ⟨Subgroup.inclusion hC c, Subgroup.mem_subgroupOf.mpr c.2⟩
  have hfac :
      Classical.choose
          (associatedGammaPElementarySubgroup_factorization_local
            (K := K) (p := p) (x := x) (P := P) hx (Subgroup.inclusion hC c)) =
        (c0, (1 : P₀)) :=
    associatedGammaPElementarySubgroup_factorization_of_cyclic_element_local
      (K := K) (p := p) (x := x) (P := P) hx c
  have hc0 :
      (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx (Subgroup.inclusion hC c))).1 = c0 := by
    exact congrArg Prod.fst hfac
  have hy0 :
      (Classical.choose
        (associatedGammaPElementarySubgroup_factorization_local
          (K := K) (p := p) (x := x) (P := P) hx (Subgroup.inclusion hC c))).2 = (1 : P₀) := by
    exact congrArg Prod.snd hfac
  have hcomp_apply :
      ↑((σβ (Subgroup.inclusion hC c)) z) =
        ↑(((generatorField_linearCharacter_representation (K := K) (x := x) β) c) z) := by
    rw [show σβ (Subgroup.inclusion hC c) =
        cycRep
          ((Classical.choose
            (associatedGammaPElementarySubgroup_factorization_local
              (K := K) (p := p) (x := x) (P := P) hx (Subgroup.inclusion hC c))).1) *
          τP
            ((Classical.choose
              (associatedGammaPElementarySubgroup_factorization_local
                (K := K) (p := p) (x := x) (P := P) hx (Subgroup.inclusion hC c))).2) by
        rfl]
    rw [hc0, hy0, τP.map_one]
    rfl
  simpa using hcomp_apply

/-- Helper for Lemma 12-12.7-5: once the linear character `β` is fixed, LinearRepresentations_Serre_1977's `Γ_K`-power action
on the generator field should extend the cyclic action of `C = ⟨x⟩` to
`H = associatedGammaPElementarySubgroup Γ[K](G) x P`. -/
theorem associatedGammaPElementarySubgroup_generatorField_extension
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    (β : C →* (AlgebraicClosure K)ˣ) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    ∃ σβ : Representation K H (generatorFieldCarrier (K := K) (x := x) β),
      σβ.comp (Subgroup.inclusion hC) =
        generatorField_linearCharacter_representation (K := K) (x := x) β := by
  -- Route correction: LinearRepresentations_Serre_1977 extends from `C` to `H = C ⋅ P` by letting the `p`-group act through
  -- the restricted cyclotomic automorphisms of the generator field.
  have hdecomp :=
    associatedGammaPElementarySubgroup_decomposition ΓK p x hx P
  -- TODO for Lemma 12-12.7-5: use the fixed-carrier twist adapter
  -- `generatorField_twisted_linearCharacter_representation` to define the `P`-action from the
  -- conjugation witnesses supplied by `associatedGammaPElementarySubgroup_decomposition`, then
  -- prove independence of the chosen `Γ_K`-witness and package the resulting semidirect-product
  -- action as a representation of `H`. The witness-independence step is now isolated in
  -- `generatorField_twisted_linearCharacter_representation_eq_of_generator_power_eq_local`, so
  -- the remaining work is the fixed-carrier automorphism implementing LinearRepresentations_Serre_1977's restricted
  -- `Γ_K`-action on one chosen witness for each `y ∈ P`. The new transport lemma below records
  -- that the twisted generator values already lie in the fixed field `K(β(x))` before that final
  -- automorphism is constructed.
  let _ := hdecomp
  exact associatedGammaPElementarySubgroup_generatorField_extension_from_restricted_sigma_local
    (K := K) (p := p) (x := x) (P := P) hx β

/-- Helper for Lemma 12-12.7-5: the remaining source-faithful blocker is the irreducible cyclic
case of LinearRepresentations_Serre_1977's extension construction over `H = C ⋅ P`. -/
theorem associatedGammaPElementarySubgroup_irreducible_rep_extendsOverField
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (ρ : Representation K C V) [ρ.IsIrreducible] :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    ∃ σ : Representation K H V,
      σ.comp (Subgroup.inclusion hC) = ρ := by
  classical
  let H := associatedGammaPElementarySubgroup ΓK x P
  let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
  let τβ := generatorField_linearCharacter_representation (K := K) (x := x)
  suffices
      ∃ β : C →* (AlgebraicClosure K)ˣ,
        Nonempty ((τβ β).Equiv ρ) ∧
          ∃ σβ : Representation K H (generatorFieldCarrier (K := K) (x := x) β),
            σβ.comp (Subgroup.inclusion hC) = τβ β by
    rcases this with ⟨β, ⟨e⟩, σβ, hσβ⟩
    simpa [H, hC, τβ] using
      irreducible_extension_of_generatorField_extension (K := K) (p := p) (x := x)
        P ρ β e σβ hσβ
  obtain ⟨σΩ, hσΩ_irr, β, hβchar⟩ := choose_algClosed_linear_constituent (K := K) (x := x) ρ
  -- The source proof now splits into the two remaining bridges: identify the irreducible
  -- `K`-model with the generator-field construction, then extend that generator-field model over
  -- `H = C ⋅ P` using the `Γ_K`-power action of `P`.
  refine ⟨β, ?_, ?_⟩
  · exact generatorField_model_equiv_of_chosen_constituent
      (K := K) (x := x) ρ σΩ hσΩ_irr β hβchar
  · simpa [H, hC, τβ] using
      associatedGammaPElementarySubgroup_generatorField_extension
        (K := K) (p := p) (x := x) (P := P) hx β

set_option maxHeartbeats 400000 in
-- The direct-sum transport proof elaborates a large nested representation term; the local
-- heartbeat bump keeps that bookkeeping stable without affecting the surrounding file.
/-- Helper for Lemma 12-12.7-5: once the irreducible `C = ⟨x⟩` case is available, the general
finite-dimensional extension is obtained by decomposing into irreducible subrepresentations and
transporting the direct sum of the corresponding `H`-extensions. -/
private theorem associatedGammaPElementarySubgroup_rep_extendsOverField_aux
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    {V : Type w} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (ρ : Representation K C V) :
    ∃ σ : Representation K (associatedGammaPElementarySubgroup ΓK x P) V,
      σ.comp
          (Subgroup.inclusion (zpowers_le_associatedGammaPElementarySubgroup ΓK p x P)) =
        ρ := by
  classical
  let H := associatedGammaPElementarySubgroup ΓK x P
  let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
  letI : NeZero (Nat.card C : K) := ⟨Nat.cast_ne_zero.mpr Finite.card_pos.ne'⟩
  obtain ⟨ι, _, σ, e, hσirr⟩ :
      ∃ (ι : Type (max u v w)) (_ : Fintype ι) (σ : ι → Subrepresentation ρ)
        (e : (Representation.directSum fun i ↦ (σ i).toRepresentation).Equiv ρ),
          ∀ i, (σ i).toRepresentation.IsIrreducible :=
    exists_equiv_directSum_irreducible_subrepresentations (ρ := ρ)
  let τ : ∀ i, Representation K H ((σ i).toSubmodule) := fun i ↦ by
    letI : ((σ i).toRepresentation).IsIrreducible := hσirr i
    letI : FiniteDimensional K ((σ i).toSubmodule) := inferInstance
    exact
      Classical.choose
        (associatedGammaPElementarySubgroup_irreducible_rep_extendsOverField
          (K := K) (p := p) (x := x) (P := P) hx ((σ i).toRepresentation))
  have hτ :
      ∀ i, (τ i).comp (Subgroup.inclusion hC) = (σ i).toRepresentation := by
    intro i
    letI : ((σ i).toRepresentation).IsIrreducible := hσirr i
    letI : FiniteDimensional K ((σ i).toSubmodule) := inferInstance
    exact
      Classical.choose_spec
        (associatedGammaPElementarySubgroup_irreducible_rep_extendsOverField
          (K := K) (p := p) (x := x) (P := P) hx ((σ i).toRepresentation))
  refine ⟨transportRepresentation (K := K) e.toLinearEquiv (Representation.directSum τ), ?_⟩
  ext c x
  change
    e.toLinearEquiv
        (((Representation.directSum τ).comp (Subgroup.inclusion hC)) c (e.toLinearEquiv.symm x)) =
      ρ c x
  have hcomp_eval :
      ((Representation.directSum τ).comp (Subgroup.inclusion hC)) c (e.toLinearEquiv.symm x) =
        (Representation.directSum fun i ↦ (σ i).toRepresentation) c (e.toLinearEquiv.symm x) := by
    ext i
    have hi := congrArg
      (fun π : Representation K C ((σ i).toSubmodule) ↦ π c ((e.toLinearEquiv.symm x) i)) (hτ i)
    simpa [Representation.directSum] using hi
  rw [hcomp_eval]
  have hintertwine :
      e.toLinearEquiv
          ((Representation.directSum fun i ↦ (σ i).toRepresentation) c (e.toLinearEquiv.symm x))
        = ρ c (e.toLinearEquiv (e.toLinearEquiv.symm x)) :=
    LinearMap.congr_fun (e.toIntertwiningMap.2 c) (e.toLinearEquiv.symm x)
  exact hintertwine.trans (congrArg (ρ c) (e.toLinearEquiv.apply_symm_apply x))

-- Proof sketch: the action of the Sylow `p`-subgroup on `C = ⟨x⟩` factors through the `Γ_K`-power
-- action, so a finite-dimensional `K`-representation of the cyclic subgroup `C` extends across
-- `H = C ⋅ P` by letting `P` act through the induced semilinear action on the same
-- `K`-vector space.
/-- Lemma 12-12.7-5 (2): with `Γ_K` attached to the intermediate field `K ⊆ L`, every
finite-dimensional `K`-representation of the cyclic subgroup `C = ⟨x⟩` extends to the associated
subgroup `H = C ⋅ P`. -/
theorem associatedGammaPElementarySubgroup_rep_extendsOverField
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x)
    {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (ρ : Representation K C V) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    ∃ σ : Representation K H V,
      σ.comp (Subgroup.inclusion hC) = ρ := by
  simpa using associatedGammaPElementarySubgroup_rep_extendsOverField_aux
    (K := K) (p := p) (x := x) (P := P) hx ρ

/-- Lemma 12-12.7-5 (3): with `Γ_K` attached to the intermediate field `K ⊆ L`, the restriction
map `Res : R_K(H) → R_K(C)` from the associated subgroup `H = C ⋅ P` to its cyclic factor is
surjective. This is the derived virtual-character companion to part `(2)`. -/
theorem associatedGammaPElementarySubgroupRestrictionOverField_surjective
    (P : Sylow p N(x)) [Fact p.Prime] (hx : IsPRegular p x) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    Function.Surjective (hC ↾R[K]) := by
  classical
  dsimp
  intro χ
  let H := associatedGammaPElementarySubgroup ΓK x P
  let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
  have hlift :
      ∃ η : R[K](H), (((hC ↾R[K]) η : R[K](C)) : C → K) = (χ : C → K) := by
    let liftPred : (ψ : C → K) → ψ ∈ R[K](C) → Prop := fun ψ _ =>
      ∃ η : R[K](H), (((hC ↾R[K]) η : R[K](C)) : C → K) = ψ
    refine Algebra.adjoin_induction (p := liftPred) ?_ ?_ ?_ ?_ χ.2
    · intro ψ hψ
      rcases hψ with ⟨ρ, hρfd, hρirr, rfl⟩
      letI : FiniteDimensional K ρ := hρfd
      letI : ρ.ρ.IsIrreducible := hρirr
      obtain ⟨σ, hσ⟩ :=
        associatedGammaPElementarySubgroup_rep_extendsOverField (K := K) (p := p) (x := x)
          (P := P) hx ρ.ρ
      refine ⟨⟨Representation.character σ,
          Representation.rep_character_mem_characterRingOverField (K := K) (G := H)
            (Rep.of σ)⟩, ?_⟩
      ext c
      have hmap : σ (Subgroup.inclusion hC c) = ρ.ρ c := by
        simpa using congrArg (fun τ : Representation K C ρ ↦ τ c) hσ
      simpa [Representation.character, Subgroup.characterRingOverFieldRestrictionOfLe_apply] using
        congrArg (LinearMap.trace K ρ) hmap
    · intro n
      refine ⟨algebraMap ℤ R[K](H) n, ?_⟩
      ext c
      simp
    · intro ψ φ _ _ hψ hφ
      rcases hψ with ⟨ηψ, hηψ⟩
      rcases hφ with ⟨ηφ, hηφ⟩
      refine ⟨ηψ + ηφ, ?_⟩
      funext c
      change
        (((ηψ : R[K](H)) : H → K) (Subgroup.inclusion hC c) +
            (((ηφ : R[K](H)) : H → K) (Subgroup.inclusion hC c))) =
          ψ c + φ c
      have hηψc : (((ηψ : R[K](H)) : H → K) (Subgroup.inclusion hC c)) = ψ c := by
        simpa using congrFun hηψ c
      have hηφc : (((ηφ : R[K](H)) : H → K) (Subgroup.inclusion hC c)) = φ c := by
        simpa using congrFun hηφ c
      rw [hηψc, hηφc]
    · intro ψ φ _ _ hψ hφ
      rcases hψ with ⟨ηψ, hηψ⟩
      rcases hφ with ⟨ηφ, hηφ⟩
      refine ⟨ηψ * ηφ, ?_⟩
      funext c
      change
        (((ηψ : R[K](H)) : H → K) (Subgroup.inclusion hC c) *
            (((ηφ : R[K](H)) : H → K) (Subgroup.inclusion hC c))) =
          ψ c * φ c
      have hηψc : (((ηψ : R[K](H)) : H → K) (Subgroup.inclusion hC c)) = ψ c := by
        simpa using congrFun hηψ c
      have hηφc : (((ηφ : R[K](H)) : H → K) (Subgroup.inclusion hC c)) = φ c := by
        simpa using congrFun hηφ c
      rw [hηψc, hηφc]
  rcases hlift with ⟨η, hη⟩
  refine ⟨η, ?_⟩
  apply Subtype.ext
  exact hη

end Representation
