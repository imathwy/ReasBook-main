import Mathlib
import LinearRepresentations_Serre_1977.Chap07.Proposition_7_7_2_1
import LinearRepresentations_Serre_1977.Chap12.Proposition_12_12_1_1
import LinearRepresentations_Serre_1977.Chap12.Theorem_12_12_6_2

noncomputable section

universe u v

namespace Representation

open scoped Quaternion Representation

section

variable {G : Type u} [Group G] [Finite G]

/- The subgroup permutation characters are written `ℓ_H^G` on the source-facing theorem surface. -/

/-- The `ℤ`-submodule of `R_ℚ(G)` generated by the permutation characters
`ℓ_H^G = Ind_H^G(1_H)` as `H` ranges over the subgroups of `G`. -/
def subgroupPermutationCharacterSpanOverQ (G : Type u) [Group G] [Finite G] :
    Submodule ℤ (R[ℚ](G)) :=
  Submodule.span ℤ
    (Set.range fun H : Subgroup G ↦ (ℓ_{H}^G : R[ℚ](G)))

-- Proof sketch: for each subgroup `H ≤ G`, the permutation character `ℓ_H^G = Ind_H^G(1_H)` is
-- one of the generators in the defining set of `subgroupPermutationCharacterSpanOverQ G`, so it
-- belongs to the span by `Submodule.subset_span`.
/-- Every subgroup permutation character `ℓ_H^G = Ind_H^G(1_H)` belongs to the subgroup
permutation-character span of `G`. -/
theorem subgroupPermutationCharacter_mem_subgroupPermutationCharacterSpanOverQ
    (H : Subgroup G) :
    ℓ_{H}^G ∈ subgroupPermutationCharacterSpanOverQ G := by
  exact Submodule.subset_span ⟨H, rfl⟩

end

/-- Helper for Remark 13-13.1-9: once one concrete rational character outside the subgroup
permutation lattice is known, the remark follows by repackaging that witness existentially. -/
theorem exists_rational_character_not_mem_subgroupPermutationCharacterSpanOverQ_of_witness
    {G : Type u} [Group G] [Finite G] {χ : R[ℚ](G)}
    (hχ : χ ∉ subgroupPermutationCharacterSpanOverQ G) :
    ∃ (G' : Type u) (_ : Group G') (_ : Finite G')
      (χ' : R[ℚ](G')),
      χ' ∉ subgroupPermutationCharacterSpanOverQ G' := by
  -- Repackage the concrete witness in the source remark's existential form.
  exact ⟨G, inferInstance, inferInstance, χ, hχ⟩

section QuaternionCyclicObstruction

local notation "Q8" => QuaternionGroup 2
local notation "C3" => Multiplicative (ZMod 3)
local notation "G0" => Q8 × C3

local instance anonInst_Remark_13_13_1_9_1 : Finite G0 := inferInstance
local instance anonInst_Remark_13_13_1_9_2 : Finite (ULift.{u} G0) := inferInstance
local instance anonInstP_Remark_13_13_1_9_1 (H : Subgroup G0) : Fintype H := Fintype.ofFinite H
local instance anonInstP_Remark_13_13_1_9_2 (H : Subgroup (ULift.{u} G0)) : Fintype H := Fintype.ofFinite H
local instance anonInstP_Remark_13_13_1_9_3 (H : Subgroup G0) : DecidablePred fun x : G0 => x ∈ H := Classical.decPred _
local instance anonInst_Remark_13_13_1_9_3 : DecidableEq (Subgroup G0) := Classical.decEq _

/-- Helper for Remark 13-13.1-9: the central involution in `Q8 × C3`. -/
private def quaternion_cyclic_central_order_two : G0 :=
  (QuaternionGroup.a (2 : ZMod 4), 1)

/-- Helper for Remark 13-13.1-9: a chosen generator of the cyclic factor `C3`. -/
private def quaternion_cyclic_central_order_three : G0 :=
  (1, Multiplicative.ofAdd (1 : ZMod 3))

/-- Helper for Remark 13-13.1-9: the central element of order `6` obtained by multiplying the
order-`2` and order-`3` central elements. -/
private def quaternion_cyclic_central_order_six : G0 :=
  quaternion_cyclic_central_order_two * quaternion_cyclic_central_order_three

/-- Helper for Remark 13-13.1-9: the `Q8` involution `a 2 = -1` is central. -/
private theorem quaternion_cyclic_central_order_two_mem_center :
    quaternion_cyclic_central_order_two ∈ Subgroup.center G0 := by
  -- The `Q8` element `a 2` commutes with every quaternion-group element, and the `C3` coordinate
  -- is just `1`.
  have hzq : (QuaternionGroup.a (2 : ZMod 4) : Q8) ∈ Subgroup.center Q8 := by
    rw [Subgroup.mem_center_iff]
    intro q
    cases q with
    | a i =>
        simp [QuaternionGroup.a_mul_a, add_comm]
    | xa i =>
        rw [QuaternionGroup.xa_mul_a, QuaternionGroup.a_mul_xa]
        fin_cases i <;> decide
  rw [Subgroup.mem_center_iff]
  intro g
  have hq := (Subgroup.mem_center_iff.mp hzq) g.1
  ext <;> simp [quaternion_cyclic_central_order_two, hq]

/-- Helper for Remark 13-13.1-9: the chosen generator of `C3` is central in the direct product. -/
private theorem quaternion_cyclic_central_order_three_mem_center :
    quaternion_cyclic_central_order_three ∈ Subgroup.center G0 := by
  -- The first factor is `1`, and the second factor lies in the abelian group `C3`.
  rw [Subgroup.mem_center_iff]
  intro g
  ext <;> simp [quaternion_cyclic_central_order_three, mul_comm]

/-- Helper for Remark 13-13.1-9: the product of the two distinguished central elements is still
central. -/
private theorem quaternion_cyclic_central_order_six_mem_center :
    quaternion_cyclic_central_order_six ∈ Subgroup.center G0 := by
  -- The center is a subgroup, so it is closed under multiplication.
  simpa [quaternion_cyclic_central_order_six] using
    Subgroup.mul_mem (Subgroup.center G0)
      quaternion_cyclic_central_order_two_mem_center
      quaternion_cyclic_central_order_three_mem_center

/-- Helper for Remark 13-13.1-9: every nonidentity element of `Q8` produces the central involution
`a 2 = -1` after squaring, except for `a 2` itself which already is that involution. -/
private theorem quaternionGroupTwo_sq_eq_a_two_or_eq_a_two
    (q : Q8) (hq : q ≠ 1) :
    q = QuaternionGroup.a (2 : ZMod 4) ∨ q ^ 2 = QuaternionGroup.a (2 : ZMod 4) := by
  -- Split over the eight normal forms in `Q8`.
  cases q with
  | a i =>
      fin_cases i
      · exfalso
        exact hq QuaternionGroup.a_zero
      · right
        decide
      · left
        decide
      · right
        decide
  | xa i =>
      right
      fin_cases i <;> decide

/-- Helper for Remark 13-13.1-9: if an element of `Q8 × C3` has nontrivial `Q8`-projection, then a
power of it is the distinguished central involution. -/
private theorem pow_eq_central_order_two_of_fst_ne_one
    (g : G0) (hg : g.1 ≠ 1) :
    g ^ 3 = quaternion_cyclic_central_order_two ∨
      g ^ 6 = quaternion_cyclic_central_order_two := by
  -- An explicit case split on the two factors shows that either the cube or the sixth power lands
  -- on the central involution.
  rcases g with ⟨q, c⟩
  cases q with
  | a i =>
      fin_cases i
      · exfalso
        exact hg QuaternionGroup.a_zero
      · fin_cases c <;> right <;> decide
      · fin_cases c <;> left <;> decide
      · fin_cases c <;> right <;> decide
  | xa i =>
      fin_cases i <;> fin_cases c <;> right <;> decide

/-- Helper for Remark 13-13.1-9: if an element of `Q8 × C3` has trivial `Q8`-projection but
nontrivial `C3`-projection, then one of its first two powers is the chosen generator of `C3`. -/
private theorem pow_eq_central_order_three_of_fst_eq_one_snd_ne_one
    (g : G0) (hgfst : g.1 = 1) (hgsnd : g.2 ≠ 1) :
    g = quaternion_cyclic_central_order_three ∨
      g ^ 2 = quaternion_cyclic_central_order_three := by
  -- Once the first coordinate is fixed to `1`, only the three `C3` values remain.
  rcases g with ⟨q, c⟩
  subst hgfst
  fin_cases c
  · exfalso
    exact hgsnd rfl
  · left
    decide
  · right
    decide

/-- Helper for Remark 13-13.1-9: if a subgroup of `Q8 × C3` omits both distinguished central
elements, then it must be trivial. -/
private theorem subgroup_eq_bot_of_not_mem_central_order_two_and_three
    (H : Subgroup G0)
    (hz : quaternion_cyclic_central_order_two ∉ H)
    (hc : quaternion_cyclic_central_order_three ∉ H) :
    H = ⊥ := by
  -- Any nontrivial subgroup element forces one of the two distinguished central elements to lie in
  -- the subgroup, contradicting the hypotheses.
  ext g
  constructor
  · intro hg
    by_cases h1 : g = 1
    · simp [h1]
    · by_cases hgfst : g.1 = 1
      · have hgsnd : g.2 ≠ 1 := by
          intro hsnd
          apply h1
          ext <;> simp [hgfst, hsnd]
        rcases pow_eq_central_order_three_of_fst_eq_one_snd_ne_one g hgfst hgsnd with hg3 | hg3
        · exact False.elim (hc (hg3 ▸ hg))
        · exact False.elim (hc (hg3 ▸ H.pow_mem hg 2))
      · rcases pow_eq_central_order_two_of_fst_ne_one g hgfst with hg2 | hg2
        · exact False.elim (hz (hg2 ▸ H.pow_mem hg 3))
        · exact False.elim (hz (hg2 ▸ H.pow_mem hg 6))
  · intro hg
    have hg' : g = 1 := by
      simpa [Subgroup.mem_bot] using hg
    exact hg' ▸ H.one_mem

/-- Helper for Remark 13-13.1-9: testing a rational class function on the four distinguished
central elements extracts the coefficient of the trivial subgroup permutation character. -/
private def trivial_subgroup_test (f : G0 → ℚ) : ℚ :=
  (f 1 - f quaternion_cyclic_central_order_three - f quaternion_cyclic_central_order_two +
      f quaternion_cyclic_central_order_six) /
    24

/-- Helper for Remark 13-13.1-9: the subgroup test is additive on rational characters. -/
private theorem trivial_subgroup_test_map_add
    (χ ψ : R[ℚ](G0)) :
    trivial_subgroup_test (((χ + ψ : R[ℚ](G0)) : G0 → ℚ)) =
      trivial_subgroup_test (χ : G0 → ℚ) + trivial_subgroup_test (ψ : G0 → ℚ) := by
  -- Expand the four evaluation terms and collect the rational coefficients.
  simp [trivial_subgroup_test]
  ring

/-- Helper for Remark 13-13.1-9: the subgroup test commutes with integer scalar multiplication. -/
private theorem trivial_subgroup_test_map_zsmul
    (n : ℤ) (χ : R[ℚ](G0)) :
    trivial_subgroup_test (((n • χ : R[ℚ](G0)) : G0 → ℚ)) =
      n • trivial_subgroup_test (χ : G0 → ℚ) := by
  -- The test is a fixed rational linear combination of four evaluations.
  simp [trivial_subgroup_test]
  ring

/-- Helper for Remark 13-13.1-9: the test functional is `ℤ`-linear on the rational character
ring. -/
private def trivial_subgroup_test_linear : R[ℚ](G0) →ₗ[ℤ] ℚ :=
  { toFun := fun χ ↦ trivial_subgroup_test (χ : G0 → ℚ)
    map_add' := trivial_subgroup_test_map_add
    map_smul' := trivial_subgroup_test_map_zsmul }

/-- Helper for Remark 13-13.1-9: on a central element, the subgroup permutation character
`ℓ_H^G` is either the index of `H` or `0`, according as the element lies in `H`. -/
private theorem subgroupPermutationCharacter_value_of_mem_center
    (H : Subgroup G0) (g : G0) (hg : g ∈ Subgroup.center G0) :
    (((ℓ_{H}^G0 : R[ℚ](G0)) : G0 → ℚ) g) = if g ∈ H then H.index else 0 := by
  classical
  have hψ : _root_.IsClassFunction (1 : H → ℚ) := by
    -- The trivial subgroup character is constant.
    refine ⟨?_⟩
    intro a b hab
    simp
  obtain ⟨S, hS, h1S⟩ := H.exists_isComplement_left (1 : G0)
  let R : Finset G0 := (Set.toFinite S).toFinset
  have hR : Subgroup.IsComplement (R : Set G0) (H : Set G0) := by
    simpa [R] using hS
  have hcardR : R.card = H.index := by
    simpa [R] using hR.card_left
  haveI : NeZero (Nat.card H : ℚ) :=
    ⟨Nat.cast_ne_zero.mpr (Nat.card_ne_zero.mpr ⟨⟨1, H.one_mem⟩, inferInstance⟩)⟩
  rw [Subgroup.characterRingOverFieldInduction_apply]
  change Subgroup.inducedClassFunction H (1 : H → ℚ) g = _
  rw [Subgroup.induced_class_function_eq_sum_over_left_transversal
    (H := H) (ψ := (1 : H → ℚ)) hψ (R := R) (hR := hR) (x := g)]
  have hconj (r : G0) : r⁻¹ * g * r = g := by
    -- Centrality collapses every conjugate `r⁻¹ g r` back to `g`.
    have hcomm := (Subgroup.mem_center_iff.mp hg) r
    have hleft := congrArg (fun x : G0 ↦ r⁻¹ * x) hcomm
    simpa [mul_assoc] using hleft.symm
  have hterm (r : G0) :
      (if hr : r⁻¹ * g * r ∈ H then (1 : H → ℚ) ⟨r⁻¹ * g * r, hr⟩ else 0) =
        if g ∈ H then 1 else 0 := by
    -- Each summand is the same constant because every conjugate equals `g`.
    by_cases hgH : g ∈ H
    · have hr : r⁻¹ * g * r ∈ H := by
        simpa [hconj r] using hgH
      simp [hr, hgH]
    · have hr : ¬ r⁻¹ * g * r ∈ H := by
        simpa [hconj r] using hgH
      simp [hr, hgH]
  rw [show
      (∑ r ∈ R, if hr : r⁻¹ * g * r ∈ H then (1 : H → ℚ) ⟨r⁻¹ * g * r, hr⟩ else 0) =
        ∑ r ∈ R, (if g ∈ H then 1 else 0) by
      refine Finset.sum_congr rfl ?_
      intro r hr
      exact hterm r]
  by_cases hgH : g ∈ H
  · simp [hgH, hcardR]
  · simp [hgH]

/-- Helper for Remark 13-13.1-9: the test functional is integral on every subgroup permutation
character. -/
private theorem trivial_subgroup_test_on_subgroupPermutationCharacter
    (H : Subgroup G0) :
    trivial_subgroup_test (((ℓ_{H}^G0 : R[ℚ](G0)) : G0 → ℚ)) =
      if H = ⊥ then 1 else 0 := by
  classical
  -- Evaluate the subgroup permutation character on the four distinguished central elements.
  have hone :
      (((ℓ_{H}^G0 : R[ℚ](G0)) : G0 → ℚ) 1) = H.index := by
    simpa using
      subgroupPermutationCharacter_value_of_mem_center (H := H) (g := 1) (by simp)
  have hz :
      (((ℓ_{H}^G0 : R[ℚ](G0)) : G0 → ℚ) quaternion_cyclic_central_order_two) =
        if quaternion_cyclic_central_order_two ∈ H then H.index else 0 := by
    exact
      subgroupPermutationCharacter_value_of_mem_center
        (H := H) (g := quaternion_cyclic_central_order_two)
        quaternion_cyclic_central_order_two_mem_center
  have hc :
      (((ℓ_{H}^G0 : R[ℚ](G0)) : G0 → ℚ) quaternion_cyclic_central_order_three) =
        if quaternion_cyclic_central_order_three ∈ H then H.index else 0 := by
    exact
      subgroupPermutationCharacter_value_of_mem_center
        (H := H) (g := quaternion_cyclic_central_order_three)
        quaternion_cyclic_central_order_three_mem_center
  have hzc :
      (((ℓ_{H}^G0 : R[ℚ](G0)) : G0 → ℚ) quaternion_cyclic_central_order_six) =
        if quaternion_cyclic_central_order_six ∈ H then H.index else 0 := by
    exact
      subgroupPermutationCharacter_value_of_mem_center
        (H := H) (g := quaternion_cyclic_central_order_six)
        quaternion_cyclic_central_order_six_mem_center
  rw [trivial_subgroup_test, hone, hz, hc, hzc]
  by_cases hH : H = ⊥
  · -- For the trivial subgroup, only the identity contributes, and the resulting index is `24`.
    subst hH
    have hz2ne : quaternion_cyclic_central_order_two ≠ 1 := by
      decide
    have hz3ne : quaternion_cyclic_central_order_three ≠ 1 := by
      decide
    have hz6ne : quaternion_cyclic_central_order_six ≠ 1 := by
      decide
    norm_num [Subgroup.index_bot, Fintype.card_prod, Fintype.card_multiplicative,
      QuaternionGroup.card, hz2ne, hz3ne, hz6ne]
  · -- For a nontrivial subgroup, the two central detectors force cancellation in the four-term
    -- test.
    by_cases hzH : quaternion_cyclic_central_order_two ∈ H
    · by_cases hcH : quaternion_cyclic_central_order_three ∈ H
      · have hzcH : quaternion_cyclic_central_order_six ∈ H := by
          simpa [quaternion_cyclic_central_order_six] using H.mul_mem hzH hcH
        simp [hH, hzH, hcH, hzcH]
      · have hzcH : quaternion_cyclic_central_order_six ∉ H := by
          intro hzcH
          have : quaternion_cyclic_central_order_three ∈ H := by
            have hz2inv : quaternion_cyclic_central_order_two⁻¹ ∈ H := H.inv_mem hzH
            simpa [quaternion_cyclic_central_order_six, mul_assoc] using H.mul_mem hz2inv hzcH
          exact hcH this
        simp [hH, hzH, hcH, hzcH]
    · have hcH : quaternion_cyclic_central_order_three ∈ H := by
        by_contra hcH
        exact hH (subgroup_eq_bot_of_not_mem_central_order_two_and_three H hzH hcH)
      have hzcH : quaternion_cyclic_central_order_six ∉ H := by
        intro hzcH
        have : quaternion_cyclic_central_order_two ∈ H := by
          simpa [quaternion_cyclic_central_order_six, mul_assoc] using
            H.mul_mem hzcH (H.inv_mem hcH)
        exact hzH this
      simp [hH, hzH, hcH, hzcH]

/-- Helper for Remark 13-13.1-9: the four distinguished central values force the subgroup test to
take the obstruction value `1/2`. -/
private theorem trivial_subgroup_test_eq_half_of_central_values
    {χ : R[ℚ](G0)}
    (hone : ((χ : G0 → ℚ) 1) = 4)
    (hz : ((χ : G0 → ℚ) quaternion_cyclic_central_order_two) = -4)
    (hc : ((χ : G0 → ℚ) quaternion_cyclic_central_order_three) = -2)
    (hzc : ((χ : G0 → ℚ) quaternion_cyclic_central_order_six) = 2) :
    trivial_subgroup_test_linear χ = (1 / 2 : ℚ) := by
  -- The source-side four-point test is a fixed affine combination of these four character values.
  rw [show trivial_subgroup_test_linear χ = trivial_subgroup_test (χ : G0 → ℚ) by rfl]
  rw [trivial_subgroup_test, hone, hz, hc, hzc]
  norm_num

/-- Helper for Remark 13-13.1-9: any rational character on `Q8 × C3` taking Serre's four central
values already lies outside the subgroup-permutation lattice. -/
private theorem quaternion_cyclic_obstruction_of_central_values
    {χ : R[ℚ](G0)}
    (hone : ((χ : G0 → ℚ) 1) = 4)
    (hz : ((χ : G0 → ℚ) quaternion_cyclic_central_order_two) = -4)
    (hc : ((χ : G0 → ℚ) quaternion_cyclic_central_order_three) = -2)
    (hzc : ((χ : G0 → ℚ) quaternion_cyclic_central_order_six) = 2) :
    χ ∉ subgroupPermutationCharacterSpanOverQ G0 := by
  -- Apply the `ℤ`-linear test to the subgroup-permutation span and compare against the explicit
  -- four central values of `χ`.
  intro hχ
  change χ ∈
      Submodule.span ℤ (Set.range fun H : Subgroup G0 ↦ (ℓ_{H}^G0 : R[ℚ](G0))) at hχ
  have hinteger :
      ∃ n : ℤ, trivial_subgroup_test_linear χ = n := by
    -- The test takes the values `0` and `1` on the subgroup-permutation generators, hence lands
    -- in the integers on their entire `ℤ`-span.
    let p :
        (x : R[ℚ](G0)) →
          x ∈ Submodule.span ℤ (Set.range fun H : Subgroup G0 ↦ (ℓ_{H}^G0 : R[ℚ](G0))) →
            Prop :=
      fun x _ ↦ ∃ n : ℤ, trivial_subgroup_test_linear x = n
    exact
      Submodule.span_induction
        (p := p)
        (mem := by
          intro x hx
          rcases hx with ⟨H, rfl⟩
          refine ⟨if H = ⊥ then 1 else 0, ?_⟩
          change
            trivial_subgroup_test (((ℓ_{H}^G0 : R[ℚ](G0)) : G0 → ℚ)) =
              ((if H = ⊥ then 1 else 0 : ℤ) : ℚ)
          simpa using trivial_subgroup_test_on_subgroupPermutationCharacter H)
        (zero := by
          refine ⟨0, ?_⟩
          change trivial_subgroup_test (0 : G0 → ℚ) = (0 : ℚ)
          simp [trivial_subgroup_test])
        (add := by
          intro x y hx hy hx_int hy_int
          rcases hx_int with ⟨m, hm⟩
          rcases hy_int with ⟨n, hn⟩
          refine ⟨m + n, ?_⟩
          calc
            trivial_subgroup_test_linear (x + y)
                = trivial_subgroup_test_linear x + trivial_subgroup_test_linear y := by
                    simp
            _ = (m : ℚ) + (n : ℚ) := by
                  simp [hm, hn]
            _ = ((m + n : ℤ) : ℚ) := by
                  simp)
        (smul := by
          intro a x hx hx_int
          rcases hx_int with ⟨n, hn⟩
          refine ⟨a * n, ?_⟩
          calc
            trivial_subgroup_test_linear (a • x) = a • trivial_subgroup_test_linear x := by
              change
                trivial_subgroup_test (((a • x : R[ℚ](G0)) : G0 → ℚ)) =
                  a • trivial_subgroup_test (x : G0 → ℚ)
              simpa [trivial_subgroup_test_linear] using trivial_subgroup_test_map_zsmul a x
            _ = (a : ℚ) * (n : ℚ) := by
              simp [hn]
            _ = ((a * n : ℤ) : ℚ) := by
              simp)
        hχ
  -- The explicit central values compute the test on `χ`.
  have hhalf : trivial_subgroup_test_linear χ = (1 / 2 : ℚ) :=
    trivial_subgroup_test_eq_half_of_central_values hone hz hc hzc
  rcases hinteger with ⟨n, hn⟩
  have : (1 / 2 : ℚ) = n := by
    rw [← hhalf, hn]
  have h0 : (0 : ℚ) < n := by
    linarith
  have h1 : (n : ℚ) < 1 := by
    linarith
  have h0' : (0 : ℤ) < n := by
    exact_mod_cast h0
  have h1' : n < 1 := by
    exact_mod_cast h1
  linarith

end QuaternionCyclicObstruction

section QuaternionCyclicWitness

local notation "Q8" => QuaternionGroup 2
local notation "C3" => Multiplicative (ZMod 3)
local notation "G0" => Q8 × C3

/-- Helper for Remark 13-13.1-9: the standard Hamilton basis on the rational quaternion algebra
`ℍ[ℚ]`. -/
private def rational_quaternion_basis :
    QuaternionAlgebra.Basis ℍ[ℚ] (-1 : ℚ) 0 (-1 : ℚ) :=
  QuaternionAlgebra.Basis.self ℚ

/-- Helper for Remark 13-13.1-9: the Hamilton basis element `i` squares to `-1`. -/
private theorem rational_quaternion_i_sq :
    (rational_quaternion_basis.i : ℍ[ℚ]) * rational_quaternion_basis.i = (-1 : ℍ[ℚ]) := by
  -- This is the defining Hamilton relation in the chosen basis.
  simpa [rational_quaternion_basis] using rational_quaternion_basis.i_mul_i

/-- Helper for Remark 13-13.1-9: the Hamilton basis element `j` squares to `-1`. -/
private theorem rational_quaternion_j_sq :
    (rational_quaternion_basis.j : ℍ[ℚ]) * rational_quaternion_basis.j = (-1 : ℍ[ℚ]) := by
  -- This is the second Hamilton relation in the chosen basis.
  simpa [rational_quaternion_basis] using rational_quaternion_basis.j_mul_j

/-- Helper for Remark 13-13.1-9: the Hamilton basis satisfies `ij = k`. -/
private theorem rational_quaternion_i_mul_j :
    (rational_quaternion_basis.i : ℍ[ℚ]) * rational_quaternion_basis.j =
      rational_quaternion_basis.k := by
  -- The basis is normalized so that the source-side product is literal.
  simpa [rational_quaternion_basis] using rational_quaternion_basis.i_mul_j

/-- Helper for Remark 13-13.1-9: the Hamilton basis satisfies `ji = -k`. -/
private theorem rational_quaternion_j_mul_i :
    (rational_quaternion_basis.j : ℍ[ℚ]) * rational_quaternion_basis.i =
      -rational_quaternion_basis.k := by
  -- This is the anticommutation relation needed for the explicit `Q8` table.
  simpa [rational_quaternion_basis] using rational_quaternion_basis.j_mul_i

/-- Helper for Remark 13-13.1-9: the Hamilton basis element `i` is a unit. -/
private def quaternion_i_unit : Units ℍ[ℚ] where
  val := rational_quaternion_basis.i
  inv := -rational_quaternion_basis.i
  val_inv := by
    -- Use `i² = -1` to identify the inverse with `-i`.
    rw [mul_neg, rational_quaternion_i_sq]
    norm_num
  inv_val := by
    -- The same Hamilton relation gives the inverse on the other side.
    rw [neg_mul, rational_quaternion_i_sq]
    norm_num

/-- Helper for Remark 13-13.1-9: the Hamilton basis element `j` is a unit. -/
private def quaternion_j_unit : Units ℍ[ℚ] where
  val := rational_quaternion_basis.j
  inv := -rational_quaternion_basis.j
  val_inv := by
    -- Use `j² = -1` to identify the inverse with `-j`.
    rw [mul_neg, rational_quaternion_j_sq]
    norm_num
  inv_val := by
    -- The same Hamilton relation gives the inverse on the other side.
    rw [neg_mul, rational_quaternion_j_sq]
    norm_num

/-- Helper for Remark 13-13.1-9: the Hamilton unit `k = ij`. -/
private def quaternion_k_unit : Units ℍ[ℚ] :=
  quaternion_i_unit * quaternion_j_unit

/-- Helper for Remark 13-13.1-9: the explicit eight-value quaternion-unit table realizing the
usual labels `±1, ±i, ±j, ±k`. -/
private def quaternion_group_two_unit_table : Q8 → Units ℍ[ℚ]
  | QuaternionGroup.a i =>
      match i.val with
      | 0 => 1
      | 1 => quaternion_i_unit
      | 2 => -1
      | _ => -quaternion_i_unit
  | QuaternionGroup.xa i =>
      match i.val with
      | 0 => quaternion_j_unit
      | 1 => -quaternion_k_unit
      | 2 => -quaternion_j_unit
      | _ => quaternion_k_unit

/-- Helper for Remark 13-13.1-9: the central involution `a 2 = -1` maps to `-1 ∈ ℍ[ℚ]ˣ`. -/
private theorem quaternion_group_two_unit_table_a_two :
    quaternion_group_two_unit_table (QuaternionGroup.a (2 : ZMod 4)) = (-1 : Units ℍ[ℚ]) := by
  -- Reduce the `ZMod 4` index to its concrete value in the explicit table.
  have hval : (2 : ZMod 4).val = 2 := rfl
  simp [quaternion_group_two_unit_table, hval]

/-- The canonical embedding `Q8 → ℍ[ℚ]ˣ` sending the standard generators to Hamilton units. -/
def quaternionGroupTwoToQuaternionUnits_r1319 : Q8 →* Units ℍ[ℚ] where
  toFun := quaternion_group_two_unit_table
  map_one' := by
    -- The source identity is `a 0`, and the table sends it to the unit `1`.
    change quaternion_group_two_unit_table (QuaternionGroup.a (0 : ZMod 4)) = 1
    simp [quaternion_group_two_unit_table]
  map_mul' := by
    -- Route correction: finish the explicit `Q8` model by a finite multiplication check.
    rintro (i | i) (j | j)
    · fin_cases i <;> fin_cases j <;> apply Units.ext <;> ext <;> native_decide
    · fin_cases i <;> fin_cases j <;> apply Units.ext <;> ext <;> native_decide
    · fin_cases i <;> fin_cases j <;> apply Units.ext <;> ext <;> native_decide
    · fin_cases i <;> fin_cases j <;> apply Units.ext <;> ext <;> native_decide

/-- Helper for Remark 13-13.1-9: the packaged `Q8` embedding still sends `a 2` to `-1`. -/
private theorem quaternionGroupTwoToQuaternionUnits_a_two :
    quaternionGroupTwoToQuaternionUnits_r1319 (QuaternionGroup.a (2 : ZMod 4)) =
      (-1 : Units ℍ[ℚ]) := by
  -- This is the corresponding evaluation of the multiplicative package.
  exact quaternion_group_two_unit_table_a_two

/-- A chosen primitive cube root of unity in `ℍ[ℚ]`. -/
def quaternionCubeRootOfUnity_r1319 : ℍ[ℚ] :=
  (⟨-(1 : ℚ) / 2, 1 / 2, 1 / 2, 1 / 2⟩ : ℍ[ℚ])

/-- Helper for Remark 13-13.1-9: the square of the chosen cube root of unity. -/
private def quaternion_cube_root_squared : ℍ[ℚ] :=
  (⟨-(1 : ℚ) / 2, -(1 : ℚ) / 2, -(1 : ℚ) / 2, -(1 : ℚ) / 2⟩ : ℍ[ℚ])

/-- Helper for Remark 13-13.1-9: the chosen quaternion cube root is nonzero. -/
private theorem quaternion_cube_root_of_unity_ne_zero :
    quaternionCubeRootOfUnity_r1319 ≠ 0 := by
  -- The real coordinate is `-1/2`, so the quaternion cannot vanish.
  intro h
  have hre := congrArg QuaternionAlgebra.re h
  norm_num [quaternionCubeRootOfUnity_r1319] at hre

/-- Helper for Remark 13-13.1-9: the square of the chosen quaternion cube root is nonzero. -/
private theorem quaternion_cube_root_squared_ne_zero :
    quaternion_cube_root_squared ≠ 0 := by
  -- Again, the real coordinate is `-1/2`.
  intro h
  have hre := congrArg QuaternionAlgebra.re h
  norm_num [quaternion_cube_root_squared] at hre

/-- Helper for Remark 13-13.1-9: the unit attached to the chosen cube root of unity. -/
private def quaternion_cube_root_unit : Units ℍ[ℚ] :=
  Units.mk0 quaternionCubeRootOfUnity_r1319 quaternion_cube_root_of_unity_ne_zero

/-- Helper for Remark 13-13.1-9: the unit attached to the square of the chosen cube root. -/
private def quaternion_cube_root_squared_unit : Units ℍ[ℚ] :=
  Units.mk0 quaternion_cube_root_squared quaternion_cube_root_squared_ne_zero

/-- Helper for Remark 13-13.1-9: the explicit three-value unit table on the cyclic factor. -/
private def cyclic_order_three_unit_table : C3 → Units ℍ[ℚ] := fun c =>
  match c.toAdd.val with
  | 0 => 1
  | 1 => quaternion_cube_root_unit
  | _ => quaternion_cube_root_squared_unit

/-- Helper for Remark 13-13.1-9: the chosen generator of `C3` maps to the quaternion cube root
unit. -/
private theorem cyclic_order_three_unit_table_generator :
    cyclic_order_three_unit_table (Multiplicative.ofAdd (1 : ZMod 3)) =
      quaternion_cube_root_unit := by
  -- Reduce the `ZMod 3` index to its concrete value in the explicit table.
  have hval : (1 : ZMod 3).val = 1 := rfl
  simp [cyclic_order_three_unit_table, hval]

/-- The canonical embedding `C3 → ℍ[ℚ]ˣ` sending the generator to
`quaternionCubeRootOfUnity_r1319`. -/
def cyclicOrderThreeToQuaternionUnits_r1319 : C3 →* Units ℍ[ℚ] where
  toFun := cyclic_order_three_unit_table
  map_one' := by
    -- The group identity corresponds to the `0` residue.
    simp [cyclic_order_three_unit_table]
  map_mul' := by
    -- The cyclic factor has only three elements, so a finite check is enough here.
    intro g h
    fin_cases g <;> fin_cases h <;> apply Units.ext <;> ext <;> native_decide

/-- Helper for Remark 13-13.1-9: the chosen generator of `C3` maps to the quaternion cube root
unit. -/
private theorem cyclicOrderThreeToQuaternionUnits_generator :
    cyclicOrderThreeToQuaternionUnits_r1319 (Multiplicative.ofAdd (1 : ZMod 3)) =
      quaternion_cube_root_unit := by
  -- This is the corresponding evaluation of the multiplicative package.
  exact cyclic_order_three_unit_table_generator

/-- The quaternionic representation of `Q8 × C3` on `ℍ[ℚ]` where the cyclic factor acts on the
left and the quaternion factor acts on the right through inverses. -/
def quaternionCyclicWitnessRepresentation_r1319 :
    Representation ℚ G0 ℍ[ℚ] where
  toFun := fun g ↦
    LinearMap.mulLeftRight ℚ
      ((cyclicOrderThreeToQuaternionUnits_r1319 g.2 : ℍ[ℚ]),
        (quaternionGroupTwoToQuaternionUnits_r1319 g.1⁻¹ : ℍ[ℚ]))
  map_one' := by
    -- The identity acts by multiplying on both sides with `1`.
    apply LinearMap.ext
    intro x
    change
      ((cyclicOrderThreeToQuaternionUnits_r1319 1 : Units ℍ[ℚ]) : ℍ[ℚ]) * x *
          ((quaternionGroupTwoToQuaternionUnits_r1319 ((1 : Q8)⁻¹) : Units ℍ[ℚ]) : ℍ[ℚ]) =
        x
    simp
  map_mul' := by
    -- Left multiplication composes in the forward order, while the right factor uses inverses and
    -- therefore lands in the correct reversed order automatically.
    intro g h
    apply LinearMap.ext
    intro x
    change
      ((cyclicOrderThreeToQuaternionUnits_r1319 ((g * h).2) : Units ℍ[ℚ]) : ℍ[ℚ]) * x *
          ((quaternionGroupTwoToQuaternionUnits_r1319 ((g * h).1⁻¹) : Units ℍ[ℚ]) : ℍ[ℚ]) =
        ((cyclicOrderThreeToQuaternionUnits_r1319 g.2 : Units ℍ[ℚ]) : ℍ[ℚ]) *
            (((cyclicOrderThreeToQuaternionUnits_r1319 h.2 : Units ℍ[ℚ]) : ℍ[ℚ]) * x *
              ((quaternionGroupTwoToQuaternionUnits_r1319 (h.1⁻¹) : Units ℍ[ℚ]) : ℍ[ℚ])) *
          ((quaternionGroupTwoToQuaternionUnits_r1319 (g.1⁻¹) : Units ℍ[ℚ]) : ℍ[ℚ])
    simp [mul_assoc]

/-- Helper for Remark 13-13.1-9: the witness representation sends the identity to left
multiplication by `1`. -/
private theorem quaternionCyclicWitnessRepresentation_apply_one :
    quaternionCyclicWitnessRepresentation_r1319 (1 : G0) =
      LinearMap.mulLeft ℚ (1 : ℍ[ℚ]) := by
  -- Both factors act trivially at the identity element.
  apply LinearMap.ext
  intro x
  change
    ((cyclicOrderThreeToQuaternionUnits_r1319 1 : Units ℍ[ℚ]) : ℍ[ℚ]) * x *
        ((quaternionGroupTwoToQuaternionUnits_r1319 ((1 : Q8)⁻¹) : Units ℍ[ℚ]) : ℍ[ℚ]) =
      (1 : ℍ[ℚ]) * x
  simp

/-- Helper for Remark 13-13.1-9: the distinguished central involution acts as left multiplication
by `-1`. -/
private theorem quaternionCyclicWitnessRepresentation_apply_central_order_two :
    quaternionCyclicWitnessRepresentation_r1319 quaternion_cyclic_central_order_two =
      LinearMap.mulLeft ℚ (-1 : ℍ[ℚ]) := by
  -- The cyclic factor is trivial here, while the quaternion factor contributes the scalar `-1`.
  apply LinearMap.ext
  intro x
  change
    ((cyclicOrderThreeToQuaternionUnits_r1319 1 : Units ℍ[ℚ]) : ℍ[ℚ]) * x *
        ((quaternionGroupTwoToQuaternionUnits_r1319
            ((QuaternionGroup.a (2 : ZMod 4) : Q8)⁻¹) : Units ℍ[ℚ]) : ℍ[ℚ]) =
      (-1 : ℍ[ℚ]) * x
  have hinv : ((QuaternionGroup.a (2 : ZMod 4) : Q8)⁻¹) = QuaternionGroup.a (2 : ZMod 4) := by
    decide
  rw [hinv, quaternionGroupTwoToQuaternionUnits_a_two]
  simp

/-- Helper for Remark 13-13.1-9: the distinguished central element of order `3` acts as left
multiplication by the chosen quaternion cube root of unity. -/
private theorem quaternionCyclicWitnessRepresentation_apply_central_order_three :
    quaternionCyclicWitnessRepresentation_r1319 quaternion_cyclic_central_order_three =
      LinearMap.mulLeft ℚ quaternionCubeRootOfUnity_r1319 := by
  -- The quaternion factor is trivial here, and the cyclic generator supplies the left factor.
  apply LinearMap.ext
  intro x
  change
    ((cyclicOrderThreeToQuaternionUnits_r1319
        (Multiplicative.ofAdd (1 : ZMod 3)) : Units ℍ[ℚ]) : ℍ[ℚ]) * x *
        ((quaternionGroupTwoToQuaternionUnits_r1319 ((1 : Q8)⁻¹) : Units ℍ[ℚ]) : ℍ[ℚ]) =
      quaternionCubeRootOfUnity_r1319 * x
  rw [cyclicOrderThreeToQuaternionUnits_generator]
  simp [quaternion_cube_root_unit, quaternionCubeRootOfUnity_r1319]

/-- Helper for Remark 13-13.1-9: the distinguished central element of order `6` acts as left
multiplication by the negative of the chosen quaternion cube root of unity. -/
private theorem quaternionCyclicWitnessRepresentation_apply_central_order_six :
    quaternionCyclicWitnessRepresentation_r1319 quaternion_cyclic_central_order_six =
      LinearMap.mulLeft ℚ (-quaternionCubeRootOfUnity_r1319) := by
  -- This element combines the cyclic generator with the quaternionic scalar `-1`.
  apply LinearMap.ext
  intro x
  change
    ((cyclicOrderThreeToQuaternionUnits_r1319
        (Multiplicative.ofAdd (1 : ZMod 3)) : Units ℍ[ℚ]) : ℍ[ℚ]) * x *
        ((quaternionGroupTwoToQuaternionUnits_r1319
            ((QuaternionGroup.a (2 : ZMod 4) : Q8)⁻¹) : Units ℍ[ℚ]) : ℍ[ℚ]) =
      (-quaternionCubeRootOfUnity_r1319) * x
  have hinv : ((QuaternionGroup.a (2 : ZMod 4) : Q8)⁻¹) = QuaternionGroup.a (2 : ZMod 4) := by
    decide
  rw [hinv, cyclicOrderThreeToQuaternionUnits_generator, quaternionGroupTwoToQuaternionUnits_a_two]
  simp [quaternion_cube_root_unit, quaternionCubeRootOfUnity_r1319]

/-- Helper for Remark 13-13.1-9: in the basis `1, i, j, k`, left multiplication by `q : ℍ[ℚ]`
has trace `4 * q.re`. -/
private theorem rational_quaternion_left_mul_trace_eq_four_mul_re
    (q : QuaternionAlgebra ℚ (-1) 0 (-1)) :
    LinearMap.trace ℚ (QuaternionAlgebra ℚ (-1) 0 (-1))
      (LinearMap.mulLeft ℚ q) = 4 * q.re := by
  -- Compute the matrix trace explicitly in the coordinate basis `1, i, j, k`.
  let B : Module.Basis (Fin 4) ℚ (QuaternionAlgebra ℚ (-1) 0 (-1)) :=
    QuaternionAlgebra.basisOneIJK (-1 : ℚ) 0 (-1 : ℚ)
  have hB0 : (B 0 : QuaternionAlgebra ℚ (-1) 0 (-1)) = 1 := by
    apply B.equivFun.injective
    ext i
    fin_cases i <;> simp [B, QuaternionAlgebra.coe_basisOneIJK_repr]
  have hB1 :
      (B 1 : QuaternionAlgebra ℚ (-1) 0 (-1)) = (QuaternionAlgebra.Basis.self ℚ).i := by
    apply B.equivFun.injective
    ext i
    fin_cases i <;> simp [B, QuaternionAlgebra.coe_basisOneIJK_repr]
  have hB2 :
      (B 2 : QuaternionAlgebra ℚ (-1) 0 (-1)) = (QuaternionAlgebra.Basis.self ℚ).j := by
    apply B.equivFun.injective
    ext i
    fin_cases i <;> simp [B, QuaternionAlgebra.coe_basisOneIJK_repr]
  have hB3 :
      (B 3 : QuaternionAlgebra ℚ (-1) 0 (-1)) = (QuaternionAlgebra.Basis.self ℚ).k := by
    apply B.equivFun.injective
    ext i
    fin_cases i <;> simp [B, QuaternionAlgebra.coe_basisOneIJK_repr]
  rw [LinearMap.trace_eq_matrix_trace ℚ B]
  rw [Matrix.trace, Fin.sum_univ_four, Matrix.diag]
  have h00 : (Algebra.leftMulMatrix B q) 0 0 = q.re := by
    simp [Algebra.leftMulMatrix_eq_repr_mul, hB0, B]
  have h11 : (Algebra.leftMulMatrix B q) 1 1 = q.re := by
    simp [Algebra.leftMulMatrix_eq_repr_mul, hB1, B]
  have h22 : (Algebra.leftMulMatrix B q) 2 2 = q.re := by
    simp [Algebra.leftMulMatrix_eq_repr_mul, hB2, B]
  have h33 : (Algebra.leftMulMatrix B q) 3 3 = q.re := by
    simp [Algebra.leftMulMatrix_eq_repr_mul, hB3, B]
  calc
    (Algebra.leftMulMatrix B q) 0 0 + (Algebra.leftMulMatrix B q) 1 1 +
        (Algebra.leftMulMatrix B q) 2 2 + (Algebra.leftMulMatrix B q) 3 3 =
      q.re + q.re + q.re + q.re := by
        rw [h00, h11, h22, h33]
    _ = 4 * q.re := by
      ring

/-- Helper for Remark 13-13.1-9: left multiplication by the chosen quaternion cube root of unity
has trace `-2`. -/
private theorem trace_mulLeft_quaternion_cube_root_of_unity_eq_neg_two :
    LinearMap.trace ℚ ℍ[ℚ]
      (LinearMap.mulLeft ℚ quaternionCubeRootOfUnity_r1319) = -2 := by
  -- The trace formula reduces the computation to the real part `-1/2`.
  change
    LinearMap.trace ℚ (QuaternionAlgebra ℚ (-1) 0 (-1))
      (LinearMap.mulLeft ℚ quaternionCubeRootOfUnity_r1319) = -2
  have h := rational_quaternion_left_mul_trace_eq_four_mul_re quaternionCubeRootOfUnity_r1319
  norm_num [quaternionCubeRootOfUnity_r1319] at h ⊢
  exact h

/-- Helper for Remark 13-13.1-9: the quaternionic witness produces the four central character
values `4, -4, -2, 2` required by Serre's obstruction test. -/
private theorem quaternion_cyclic_witness_character_central_values :
    ∃ χ : R[ℚ](G0),
      ((χ : G0 → ℚ) 1) = 4 ∧
        ((χ : G0 → ℚ) quaternion_cyclic_central_order_two) = -4 ∧
          ((χ : G0 → ℚ) quaternion_cyclic_central_order_three) = -2 ∧
            ((χ : G0 → ℚ) quaternion_cyclic_central_order_six) = 2 := by
  -- Package the witness representation as an element of `R_ℚ(G0)` and evaluate its character on
  -- the four distinguished central elements.
  let χ : R[ℚ](G0) :=
    ⟨quaternionCyclicWitnessRepresentation_r1319.character,
      Representation.rep_character_mem_characterRingOverField
        (K := ℚ) (G := G0) (Rep.of quaternionCyclicWitnessRepresentation_r1319)⟩
  refine ⟨χ, ?_, ?_, ?_, ?_⟩
  · -- At the identity, the operator is left multiplication by `1`.
    change
      LinearMap.trace ℚ ℍ[ℚ]
        (quaternionCyclicWitnessRepresentation_r1319 (1 : G0)) = 4
    rw [quaternionCyclicWitnessRepresentation_apply_one]
    change
      LinearMap.trace ℚ (QuaternionAlgebra ℚ (-1) 0 (-1))
        (LinearMap.mulLeft ℚ (1 : ℍ[ℚ])) = 4
    have h := rational_quaternion_left_mul_trace_eq_four_mul_re (1 : ℍ[ℚ])
    norm_num at h ⊢
    exact h
  · -- At the central involution, the operator is left multiplication by `-1`.
    change
      LinearMap.trace ℚ ℍ[ℚ]
        (quaternionCyclicWitnessRepresentation_r1319 quaternion_cyclic_central_order_two) = -4
    rw [quaternionCyclicWitnessRepresentation_apply_central_order_two]
    change
      LinearMap.trace ℚ (QuaternionAlgebra ℚ (-1) 0 (-1))
        (LinearMap.mulLeft ℚ (-1 : ℍ[ℚ])) = -4
    have h := rational_quaternion_left_mul_trace_eq_four_mul_re (-1 : ℍ[ℚ])
    norm_num at h ⊢
    exact h
  · -- At the order-`3` element, the operator is left multiplication by the chosen cube root.
    change
      LinearMap.trace ℚ ℍ[ℚ]
        (quaternionCyclicWitnessRepresentation_r1319 quaternion_cyclic_central_order_three) = -2
    rw [quaternionCyclicWitnessRepresentation_apply_central_order_three]
    exact trace_mulLeft_quaternion_cube_root_of_unity_eq_neg_two
  · -- At the order-`6` element, the operator is the negative of that left multiplication.
    change
      LinearMap.trace ℚ ℍ[ℚ]
        (quaternionCyclicWitnessRepresentation_r1319 quaternion_cyclic_central_order_six) = 2
    rw [quaternionCyclicWitnessRepresentation_apply_central_order_six]
    change
      LinearMap.trace ℚ (QuaternionAlgebra ℚ (-1) 0 (-1))
        (LinearMap.mulLeft ℚ (-quaternionCubeRootOfUnity_r1319)) = 2
    have h := rational_quaternion_left_mul_trace_eq_four_mul_re (-quaternionCubeRootOfUnity_r1319)
    norm_num [quaternionCubeRootOfUnity_r1319] at h ⊢
    exact h

/-- Helper for Remark 13-13.1-9: the explicit quaternionic witness on `Q8 × C3` already lies
outside the subgroup-permutation lattice. -/
theorem quaternion_cyclic_counterexample_character :
    ∃ χ : R[ℚ](QuaternionGroup 2 × Multiplicative (ZMod 3)),
      χ ∉ subgroupPermutationCharacterSpanOverQ
        (QuaternionGroup 2 × Multiplicative (ZMod 3)) := by
  -- Route correction: the obstruction theorem is already proved on the base group `Q8 × C3`, so
  -- we close the helper directly there instead of adding a separate `ULift` transport layer.
  rcases quaternion_cyclic_witness_character_central_values with ⟨χ, hone, hz, hc, hzc⟩
  refine ⟨χ, ?_⟩
  exact quaternion_cyclic_obstruction_of_central_values hone hz hc hzc

end QuaternionCyclicWitness

local notation "Q8" => QuaternionGroup 2
local notation "C3" => Multiplicative (ZMod 3)
local notation "G0" => Q8 × C3

local instance anonInst_Remark_13_13_1_9_4 : Finite G0 := inferInstance
local instance anonInst_Remark_13_13_1_9_5 : Finite (ULift.{u} G0) := inferInstance
local instance anonInstP_Remark_13_13_1_9_4 (H : Subgroup G0) : Fintype H := Fintype.ofFinite H
local instance anonInstP_Remark_13_13_1_9_5 (H : Subgroup (ULift.{u} G0)) : Fintype H := Fintype.ofFinite H

/-- Helper for Remark 13-13.1-9: the lifted carrier action preserves addition. -/
private theorem uliftRepresentationLinear_map_add
    {G : Type u} [Monoid G] {V : Type v} [AddCommGroup V] [Module ℚ V]
    (ρ : Representation ℚ G V) (g : G) :
    ∀ x y : ULift.{u} V,
      (⟨ρ g (x + y).down⟩ : ULift.{u} V) = ⟨ρ g x.down⟩ + ⟨ρ g y.down⟩ := by
  intro x y
  ext
  simp

/-- Helper for Remark 13-13.1-9: the lifted carrier action preserves scalar multiplication. -/
private theorem uliftRepresentationLinear_map_smul
    {G : Type u} [Monoid G] {V : Type v} [AddCommGroup V] [Module ℚ V]
    (ρ : Representation ℚ G V) (g : G) :
    ∀ (a : ℚ) (x : ULift.{u} V),
      (⟨ρ g (a • x).down⟩ : ULift.{u} V) = a • ⟨ρ g x.down⟩ := by
  intro a x
  ext
  simp

/-- Helper for Remark 13-13.1-9: the `ULift` carrier action associated to a rational
representation. -/
private def uliftRepresentationLinear
    {G : Type u} [Monoid G] {V : Type v} [AddCommGroup V] [Module ℚ V]
    (ρ : Representation ℚ G V) (g : G) : ULift.{u} V →ₗ[ℚ] ULift.{u} V :=
  { toFun := fun x ↦ ⟨ρ g x.down⟩
    map_add' := uliftRepresentationLinear_map_add ρ g
    map_smul' := uliftRepresentationLinear_map_smul ρ g }

/-- Helper for Remark 13-13.1-9: the lifted carrier action sends the identity element to the
identity linear map. -/
private theorem uliftRepresentationLinear_map_one
    {G : Type u} [Monoid G] {V : Type v} [AddCommGroup V] [Module ℚ V]
    (ρ : Representation ℚ G V) :
    uliftRepresentationLinear ρ 1 = 1 := by
  -- Evaluate both linear maps on an arbitrary lifted vector.
  ext x
  simp [uliftRepresentationLinear]

/-- Helper for Remark 13-13.1-9: the lifted carrier action respects multiplication in the source
group. -/
private theorem uliftRepresentationLinear_map_mul
    {G : Type u} [Monoid G] {V : Type v} [AddCommGroup V] [Module ℚ V]
    (ρ : Representation ℚ G V) (g h : G) :
    uliftRepresentationLinear ρ (g * h) =
      uliftRepresentationLinear ρ g * uliftRepresentationLinear ρ h := by
  -- Evaluate both sides on an arbitrary lifted vector and use the representation law for `ρ`.
  ext x
  simp [uliftRepresentationLinear, map_mul]

/-- Helper for Remark 13-13.1-9: lift the carrier of a rational representation to universe `u`
without changing the represented group. -/
private def uliftRepresentation
    {G : Type u} [Monoid G] {V : Type v} [AddCommGroup V] [Module ℚ V]
    (ρ : Representation ℚ G V) : Representation ℚ G (ULift.{u} V) :=
  { toFun := uliftRepresentationLinear ρ
    map_one' := uliftRepresentationLinear_map_one ρ
    map_mul' := uliftRepresentationLinear_map_mul ρ }

/-- Helper for Remark 13-13.1-9: lifting the carrier universe of a rational representation does
not change its character values. -/
private theorem character_uliftRepresentation_eq
    {G : Type u} [Group G] {V : Type v} [AddCommGroup V] [Module ℚ V]
    (ρ : Representation ℚ G V) (g : G) :
    (uliftRepresentation ρ).character g = ρ.character g := by
  -- `ULift.moduleEquiv` conjugates the lifted action back to the original one.
  change
    LinearMap.trace ℚ (ULift.{u} V)
        ((ULift.moduleEquiv.symm : V ≃ₗ[ℚ] ULift.{u} V).conj (ρ g)) =
      LinearMap.trace ℚ V (ρ g)
  exact LinearMap.trace_conj' (ρ g) (ULift.moduleEquiv.symm : V ≃ₗ[ℚ] ULift.{u} V)

/-- Helper for Remark 13-13.1-9: precomposing a rational virtual character on `G0` with
`MulEquiv.ulift` keeps it inside the rational character ring of `ULift G0`. -/
private theorem mem_characterRingOverField_of_precomp_ulift
    {χ : G0 → ℚ} (hχ : χ ∈ R[ℚ](G0)) :
    (fun x : ULift.{u} G0 ↦ χ ((MulEquiv.ulift : ULift.{u} G0 ≃* G0) x)) ∈
      R[ℚ](ULift.{u} G0) := by
  -- Transport each honest character generator by the canonical `ULift` equivalence and then use
  -- the `ℤ`-algebra structure of the character ring.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hχ
  · intro ψ hψ
    rcases hψ with ⟨ρ, hρfd, -, rfl⟩
    let ρu : Rep ℚ (ULift.{u} G0) :=
      Rep.of (uliftRepresentation (ρ.ρ.comp (MulEquiv.ulift : ULift.{u} G0 ≃* G0).toMonoidHom))
    letI : FiniteDimensional ℚ ρ := hρfd
    letI : FiniteDimensional ℚ ρu := inferInstance
    -- The lifted precomposed representation has exactly the desired transported character.
    have hρu_fun :
        ρu.ρ.character =
          fun x : ULift.{u} G0 ↦
            ρ.ρ.character ((MulEquiv.ulift : ULift.{u} G0 ≃* G0) x) := by
      funext x
      simpa [ρu] using
        character_uliftRepresentation_eq
          (ρ := ρ.ρ.comp (MulEquiv.ulift : ULift.{u} G0 ≃* G0).toMonoidHom) x
    simpa [hρu_fun] using
      (rep_character_mem_characterRingOverField ρu)
  · intro n
    exact (R[ℚ](ULift.{u} G0)).algebraMap_mem n
  · intro x y _ _ hx hy
    simpa using (R[ℚ](ULift.{u} G0)).add_mem hx hy
  · intro x y _ _ hx hy
    simpa using (R[ℚ](ULift.{u} G0)).mul_mem hx hy

/-- Helper for Remark 13-13.1-9: pulling back a subgroup permutation character from `ULift G0`
along `MulEquiv.ulift.symm` yields the subgroup permutation character of the mapped subgroup in
`G0`, as an equality of ordinary class functions. -/
private theorem subgroupPermutationCharacter_precomp_ulift_eq_mapped
    (K : Subgroup (ULift.{u} G0)) :
    ((ℓ_{K.map (MulEquiv.ulift : ULift.{u} G0 ≃* G0).toMonoidHom}^G0 : R[ℚ](G0)) : G0 → ℚ) =
      fun g : G0 ↦
          ((ℓ_{K}^(ULift.{u} G0) : R[ℚ](ULift.{u} G0)) : ULift.{u} G0 → ℚ)
          ((MulEquiv.ulift.symm : G0 ≃* ULift.{u} G0) g) := by
  classical
  letI : Fintype G0 := Fintype.ofFinite _
  letI : Fintype (ULift.{u} G0) := Fintype.ofFinite _
  let e : ULift.{u} G0 ≃* G0 := MulEquiv.ulift
  -- Compare the two permutation characters pointwise after expanding them as induced trivial
  -- class functions.
  funext g
  have hcard :
      Nat.card (K.map e.toMonoidHom) = Nat.card K := by
    exact (Nat.card_congr (Subgroup.equivMapOfInjective K e.toMonoidHom e.injective).toEquiv).symm
  rw [Subgroup.characterRingOverFieldInduction_apply, Subgroup.characterRingOverFieldInduction_apply]
  simp only [Subgroup.inducedClassFunction]
  rw [hcard]
  congr 1
  -- Reindex the `ULift` sum along the canonical equivalence `e.symm`.
  let _ : DecidablePred fun x : ULift.{u} G0 ↦ x ∈ K := Classical.decPred _
  have hsum :
      (∑ s,
          if hs : (MulEquiv.ulift.symm s)⁻¹ * MulEquiv.ulift.symm g * MulEquiv.ulift.symm s ∈ K then
            ((1 : R[ℚ](K)) : K → ℚ)
              ⟨(MulEquiv.ulift.symm s)⁻¹ * MulEquiv.ulift.symm g * MulEquiv.ulift.symm s, hs⟩
          else 0) =
        (∑ x,
          if hx : x⁻¹ * MulEquiv.ulift.symm g * x ∈ K then
            ((1 : R[ℚ](K)) : K → ℚ) ⟨x⁻¹ * MulEquiv.ulift.symm g * x, hx⟩
          else 0) := by
    simpa using
      (Equiv.sum_comp (MulEquiv.ulift.symm : G0 ≃* ULift.{u} G0).toEquiv
        (fun x : ULift.{u} G0 ↦
          if hx : x⁻¹ * MulEquiv.ulift.symm g * x ∈ K then
            ((1 : R[ℚ](K)) : K → ℚ) ⟨x⁻¹ * MulEquiv.ulift.symm g * x, hx⟩
          else 0))
  show
    (∑ s, if hsg : s⁻¹ * g * s ∈ K.map (MulEquiv.ulift : ULift.{u} G0 ≃* G0).toMonoidHom then
      ((1 : R[ℚ](K.map (MulEquiv.ulift : ULift.{u} G0 ≃* G0).toMonoidHom)) :
          K.map (MulEquiv.ulift : ULift.{u} G0 ≃* G0).toMonoidHom → ℚ) ⟨s⁻¹ * g * s, hsg⟩
    else 0) =
      (∑ s, if hsg : s⁻¹ * MulEquiv.ulift.symm g * s ∈ K then
        ((1 : R[ℚ](K)) : K → ℚ) ⟨s⁻¹ * MulEquiv.ulift.symm g * s, hsg⟩
      else 0)
  calc
    (∑ s,
        if hsg : s⁻¹ * g * s ∈ K.map e.toMonoidHom then
          ((1 : R[ℚ](K.map e.toMonoidHom)) : K.map e.toMonoidHom → ℚ) ⟨s⁻¹ * g * s, hsg⟩
        else 0)
      =
        (∑ s,
          if hs : (e.symm s)⁻¹ * e.symm g * e.symm s ∈ K then
            ((1 : R[ℚ](K)) : K → ℚ) ⟨(e.symm s)⁻¹ * e.symm g * e.symm s, hs⟩
          else 0) := by
            refine Finset.sum_congr rfl ?_
            intro s hs
            -- Route correction: the missing step is the exact equivalence between subgroup-membership tests
            -- before and after applying `MulEquiv.ulift`.
            have hmem :
                s⁻¹ * g * s ∈ K.map e.toMonoidHom ↔
                  (e.symm s)⁻¹ * e.symm g * e.symm s ∈ K := by
              constructor
              · intro hs_mem
                rcases Subgroup.mem_map.mp hs_mem with ⟨x, hx, hxeq⟩
                have hxeq' : x = (e.symm s)⁻¹ * e.symm g * e.symm s := by
                  simpa [e, MulEquiv.map_inv, mul_assoc] using congrArg e.symm hxeq
                simpa [hxeq'] using hx
              · intro hs_mem
                refine Subgroup.mem_map.mpr ⟨(e.symm s)⁻¹ * e.symm g * e.symm s, hs_mem, ?_⟩
                simp [e, MulEquiv.map_inv, mul_assoc]
            by_cases hs_mem : s⁻¹ * g * s ∈ K.map e.toMonoidHom
            · have hs_mem' : (e.symm s)⁻¹ * e.symm g * e.symm s ∈ K := hmem.mp hs_mem
              have hex :
                  ∃ a a_1,
                    ({ down := (a, Multiplicative.ofAdd a_1) } : ULift.{u} G0) ∈ K ∧
                      e { down := (a, Multiplicative.ofAdd a_1) } = s⁻¹ * g * s := by
                simpa [e, Subgroup.mem_map] using hs_mem
              have hmap_mem : s⁻¹ * g * s ∈ K.map e.toMonoidHom := by
                simpa [e, Subgroup.mem_map] using hex
              have htrivial :
                  ((1 : R[ℚ](K.map e.toMonoidHom)) : K.map e.toMonoidHom → ℚ)
                    ⟨s⁻¹ * g * s, hmap_mem⟩ = 1 := by
                rfl
              simpa [hex, hs_mem'] using htrivial
            · have hs_mem' : ¬ (e.symm s)⁻¹ * e.symm g * e.symm s ∈ K := by
                intro hs_mem'
                exact hs_mem (hmem.mpr hs_mem')
              have hnot :
                  ¬ ∃ a a_1,
                    ({ down := (a, Multiplicative.ofAdd a_1) } : ULift.{u} G0) ∈ K ∧
                      e { down := (a, Multiplicative.ofAdd a_1) } = s⁻¹ * g * s := by
                simpa [e, Subgroup.mem_map] using hs_mem
              simp [hnot, hs_mem']
    _ = (∑ x,
          if hx : x⁻¹ * MulEquiv.ulift.symm g * x ∈ K then
            ((1 : R[ℚ](K)) : K → ℚ) ⟨x⁻¹ * MulEquiv.ulift.symm g * x, hx⟩
          else 0) := hsum

/-- Helper for Remark 13-13.1-9: every element of the subgroup-permutation span on `ULift G0`
pulls back along `MulEquiv.ulift.symm` to a bundled rational character in the corresponding base
subgroup-permutation span. -/
private theorem subgroupPermutationCharacterSpanOverQ_precomp_ulift_mem
    {η : R[ℚ](ULift.{u} G0)}
    (hη : η ∈ subgroupPermutationCharacterSpanOverQ (ULift.{u} G0)) :
    ∃ η0 : R[ℚ](G0),
      ((η0 : G0 → ℚ) =
          fun g : G0 ↦
            (η : ULift.{u} G0 → ℚ) ((MulEquiv.ulift.symm : G0 ≃* ULift.{u} G0) g)) ∧
        η0 ∈ subgroupPermutationCharacterSpanOverQ G0 := by
  -- Pullback along `MulEquiv.ulift.symm` respects the additive and integral structure, so the
  -- span argument only needs the explicit image of each subgroup-permutation generator.
  change η ∈
      Submodule.span ℤ
        (Set.range fun H : Subgroup (ULift.{u} G0) ↦
          (ℓ_{H}^(ULift.{u} G0) : R[ℚ](ULift.{u} G0))) at hη
  let p :
      (x : R[ℚ](ULift.{u} G0)) →
        x ∈
            Submodule.span ℤ
              (Set.range fun H : Subgroup (ULift.{u} G0) ↦
                (ℓ_{H}^(ULift.{u} G0) : R[ℚ](ULift.{u} G0))) →
          Prop :=
    fun x _ ↦
      ∃ x0 : R[ℚ](G0),
        ((x0 : G0 → ℚ) =
            fun g : G0 ↦
              (x : ULift.{u} G0 → ℚ) ((MulEquiv.ulift.symm : G0 ≃* ULift.{u} G0) g)) ∧
          x0 ∈ Submodule.span ℤ (Set.range fun H : Subgroup G0 ↦ (ℓ_{H}^G0 : R[ℚ](G0)))
  exact
    Submodule.span_induction
      (p := p)
      (mem := by
        intro x hx
        rcases hx with ⟨K, rfl⟩
        -- The generator case is exactly the transport identity proved above.
        refine ⟨(ℓ_{K.map (MulEquiv.ulift : ULift.{u} G0 ≃* G0).toMonoidHom}^G0 : R[ℚ](G0)), ?_, ?_⟩
        · simpa [Subgroup.characterRingOverFieldInduction_apply] using
            subgroupPermutationCharacter_precomp_ulift_eq_mapped K
        · exact
          subgroupPermutationCharacter_mem_subgroupPermutationCharacterSpanOverQ
            (G := G0) (H := K.map (MulEquiv.ulift : ULift.{u} G0 ≃* G0).toMonoidHom))
      (zero := by
        -- The span is a submodule, so it contains `0`.
        refine ⟨0, ?_, (subgroupPermutationCharacterSpanOverQ G0).zero_mem⟩
        funext g
        simp)
      (add := by
        intro x y hx hy hx_mem hy_mem
        -- Closure under addition follows from submodule structure.
        rcases hx_mem with ⟨x0, hx0, hx0_mem⟩
        rcases hy_mem with ⟨y0, hy0, hy0_mem⟩
        refine ⟨x0 + y0, ?_, (subgroupPermutationCharacterSpanOverQ G0).add_mem hx0_mem hy0_mem⟩
        funext g
        simp [hx0, hy0])
      (smul := by
        intro a x hx hx_mem
        -- Closure under integer scalar multiplication follows from submodule structure.
        rcases hx_mem with ⟨x0, hx0, hx0_mem⟩
        refine ⟨a • x0, ?_, (subgroupPermutationCharacterSpanOverQ G0).smul_mem a hx0_mem⟩
        funext g
        simp [hx0])
      hη

/-- Helper for Remark 13-13.1-9: a witness outside the subgroup-permutation lattice on
`Q8 × C3` transports to the universe-lifted group by precomposition with `MulEquiv.ulift`. -/
private theorem subgroupPermutationCharacterSpanOverQ_ulift_transport
    {χ : R[ℚ](QuaternionGroup 2 × Multiplicative (ZMod 3))}
    (hχ : χ ∉ subgroupPermutationCharacterSpanOverQ
      (QuaternionGroup 2 × Multiplicative (ZMod 3))) :
    ∃ χu : R[ℚ](ULift.{u} G0),
      χu ∉ subgroupPermutationCharacterSpanOverQ (ULift.{u} G0) := by
  -- Build the transported witness by precomposing `χ` with `MulEquiv.ulift`.
  let χu : R[ℚ](ULift.{u} G0) :=
    ⟨fun x ↦ (χ : G0 → ℚ) ((MulEquiv.ulift : ULift.{u} G0 ≃* G0) x),
      mem_characterRingOverField_of_precomp_ulift χ.2⟩
  refine ⟨χu, ?_⟩
  intro hχu
  -- Reflect the hypothetical span membership back to `G0` through the pullback map.
  rcases subgroupPermutationCharacterSpanOverQ_precomp_ulift_mem hχu with ⟨χ0, hχ0_fun, hχ0⟩
  have hpullback : χ0 = χ := by
    -- Pulling the transported witness back along the inverse equivalence recovers `χ`.
    ext g
    have := congrFun hχ0_fun g
    simpa [χu] using this
  exact hχ (hpullback ▸ hχ0)

-- Proof sketch: Example `13.4` supplies a finite group `G` and a rational virtual character whose
-- coefficient vector in the basis of irreducible rational characters does not lie in the
-- `ℤ`-span of the permutation characters `ℓ_H^G = Ind_H^G(1_H)`, even when all subgroups
-- `H ≤ G` are allowed.
/-- Remark 13-13.1-9 (1): in general, the rational representation ring `R_ℚ(G)` is not generated
over `ℤ` by the subgroup permutation characters `ℓ_H^G = Ind_H^G(1_H)`, even when `H` runs over
all subgroups of `G`. Equivalently, there exists a finite group with a rational virtual character
outside this `ℤ`-span. -/
theorem exists_rational_character_not_mem_subgroupPermutationCharacterSpanOverQ :
    ∃ (G : Type u) (_ : Group G) (_ : Finite G)
      (χ : R[ℚ](G)),
      χ ∉ subgroupPermutationCharacterSpanOverQ G := by
  -- Route correction: Theorem `13-13.1-6` only proves the `ℚ`-span statement. The present remark
  -- needs a stronger integral obstruction, so we isolate the concrete source witness first.
  rcases quaternion_cyclic_counterexample_character with ⟨χ, hχ⟩
  rcases subgroupPermutationCharacterSpanOverQ_ulift_transport (χ := χ) hχ with ⟨χu, hχu⟩
  exact
    exists_rational_character_not_mem_subgroupPermutationCharacterSpanOverQ_of_witness
      (G := ULift.{u} (QuaternionGroup 2 × Multiplicative (ZMod 3)))
      (χ := χu) hχu

end Representation
