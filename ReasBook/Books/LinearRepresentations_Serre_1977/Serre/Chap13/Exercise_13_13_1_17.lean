variable (φ : Multiplicative (ZMod p) →* MulAut (Multiplicative (ZMod (p ^ 2))))

local notation "GPrime" =>
  Multiplicative (ZMod (p ^ 2)) ⋊[φ] Multiplicative (ZMod p)

-- Proof sketch: a Sylow `p`-subgroup of `GL₃(𝔽_p)` is the upper-unitriangular Heisenberg group of
-- exponent `p`, whereas a nonabelian semidirect product `Z / p² Z ⋊ Z / p Z` contains an element
-- of order `p²`; compare element orders to rule out a group isomorphism.
/-- Exercise 13-13.1-17 (1): for an odd prime `p`, a Sylow `p`-subgroup of `GL₃(𝔽_p)` is not
isomorphic to a nonabelian semidirect product of `Z / p Z` with `Z / p² Z`. -/
theorem sylowGL3_not_isomorphic_to_nonabelian_zmod_semidirectProduct
    (hp2 : p ≠ 2)
    (P : Sylow p (GL (Fin 3) (ZMod p)))
    (hφ : ¬ IsMulCommutative GPrime) :
    ¬ Nonempty (P ≃* GPrime) := by
  intro hIso
  rcases hIso with ⟨e⟩
  let y : GPrime :=
    SemidirectProduct.inl (φ := φ) (Multiplicative.ofAdd (1 : ZMod (p ^ 2)))
  let x : P := e.symm y
  -- The Sylow subgroup is transported to the explicit Heisenberg model, so every element has
  -- `p`-th power equal to `1`.
  have hx : x ^ p = 1 := sylowGL3_pow_p_eq_one (p := p) hp2 P x
  -- Applying the supposed isomorphism would force the semidirect-product witness to have trivial
  -- `p`-th power, contradicting the explicit computation in the normal `Z / p²Z` factor.
  have hy : y ^ p = 1 := by
    simpa [x, y] using congrArg e hx
  exact semidirect_inl_one_pow_p_ne_one (p := p) (φ := φ) hy

end


/-- Helper for Exercise 13-13.1-17: once Serre's packet comparison map on the canonical
upper-unitriangular model is injective, finite-dimensionality upgrades it to the desired
Artin-Wedderburn equivalence. -/
private theorem upperUnitriangularSubgroup_rational_packet_data
    (hp2 : p ≠ 2) :
    ∃ Φ :
      ℚ[upperUnitriangularSubgroup (ZMod p) 3] →ₐ[ℚ]
        RationalPacketTarget (p := p),
      Function.Injective Φ := by
  refine ⟨upperUnitriangularSubgroup_rationalPacketAlgHom (p := p), ?_⟩
  intro x y hxy
  let z : ℚ[upperUnitriangularSubgroup (ZMod p) 3] := x - y
  have hz_packet : upperUnitriangularSubgroup_rationalPacketAlgHom (p := p) z = 0 := by
    simp [z, map_sub, hxy]
  have htriv :
      (rationalTrivialGroupAlgebraAlgHom :
        ℚ[upperUnitriangularSubgroup (ZMod p) 3] →ₐ[ℚ] ℚ) z = 0 := by
    have hz0 := congrArg Prod.fst hz_packet
    simpa [upperUnitriangularSubgroup_rationalPacketAlgHom] using hz0
  have hlin : upperUnitriangularSubgroup_linearPacketAlgHom (p := p) z = 0 := by
    have hz0 := congrArg (fun w : RationalPacketTarget (p := p) => w.2.1) hz_packet
    simpa [upperUnitriangularSubgroup_rationalPacketAlgHom] using hz0
  have hmat : upperUnitriangularSubgroup_schrodingerMatrixAlgHom (p := p) z = 0 := by
    have hz0 := congrArg (fun w : RationalPacketTarget (p := p) => w.2.2) hz_packet
    simpa [upperUnitriangularSubgroup_rationalPacketAlgHom] using hz0
  have htriv_sum :
      (∑ g : upperUnitriangularSubgroup (ZMod p) 3, z g) = 0 := by
    rw [rationalTrivialGroupAlgebraAlgHom, MonoidAlgebra.lift_apply] at htriv
    simpa [Finsupp.sum_fintype, Algebra.smul_def] using htriv
  let f : ZMod p × ZMod p × ZMod p → ℚ := fun q =>
    z (upperUnitriangularSubgroupOfCoords (p := p) q.1 q.2.1 q.2.2)
  have htotal : (∑ q : ZMod p × ZMod p × ZMod p, f q) = 0 := by
    have hcoord := upperUnitriangularSubgroup_sum_coord (p := p)
      (fun g : upperUnitriangularSubgroup (ZMod p) 3 => z g)
    have hcoord' :
        (∑ g : upperUnitriangularSubgroup (ZMod p) 3, z g) =
          ∑ q : ZMod p × ZMod p × ZMod p, f q := by
      simpa [f, upperUnitriangularSubgroupCoordEquiv] using hcoord
    rwa [← hcoord']
  let Fplane : ZMod p × ZMod p → ℚ := fun q => ∑ c : ZMod p, f (q.2, q.1, c)
  have htotalPlane : (∑ q : ZMod p × ZMod p, Fplane q) = 0 := by
    have hrewrite :
        (∑ q : ZMod p × ZMod p, Fplane q) =
          ∑ q : ZMod p × ZMod p × ZMod p, f q := by
      calc
        (∑ q : ZMod p × ZMod p, Fplane q)
            = ∑ b : ZMod p, ∑ a : ZMod p, ∑ c : ZMod p, f (a, b, c) := by
                rw [Fintype.sum_prod_type]
        _ = ∑ a : ZMod p, ∑ b : ZMod p, ∑ c : ZMod p, f (a, b, c) := by
                rw [Finset.sum_comm]
        _ = ∑ q : ZMod p × ZMod p × ZMod p, f q := by
                rw [zmodP_sum_triple (p := p) f]
    rwa [hrewrite]
  have hfinitePlane : ∀ s : ZMod p,
      ∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) (q.2 + s * q.1) = 0 := by
    intro s
    have hlin_s :
        upperUnitriangularSubgroup_linearPacketAlgHom (p := p) z
            (⟨s.val, Nat.lt_trans (ZMod.val_lt s) (Nat.lt_succ_self p)⟩ : Fin (p + 1)) = 0 := by
      simpa using congrFun hlin
        (⟨s.val, Nat.lt_trans (ZMod.val_lt s) (Nat.lt_succ_self p)⟩ : Fin (p + 1))
    rw [upperUnitriangularSubgroup_linearPacketAlgHom_finite_coord] at hlin_s
    have hrewrite :
        (∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (q.2 + s * q.1)) =
          ∑ q : ZMod p × ZMod p × ZMod p,
            (f q : CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) (q.1 + s * q.2.1) := by
      calc
        (∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (q.2 + s * q.1))
            = ∑ b : ZMod p, ∑ a : ZMod p,
                ((∑ c : ZMod p, f (a, b, c) : ℚ) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (a + s * b) := by
                rw [Fintype.sum_prod_type]
        _ = ∑ b : ZMod p, ∑ a : ZMod p, ∑ c : ZMod p,
                (f (a, b, c) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (a + s * b) := by
                simp [Finset.sum_mul]
        _ = ∑ a : ZMod p, ∑ b : ZMod p, ∑ c : ZMod p,
                (f (a, b, c) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (a + s * b) := by
                rw [Finset.sum_comm]
        _ = ∑ q : ZMod p × ZMod p × ZMod p,
              (f q : CyclotomicField p ℚ) *
                zmodP_cyclotomic_character_val (p := p) (q.1 + s * q.2.1) := by
                rw [zmodP_sum_triple (p := p) (fun q : ZMod p × ZMod p × ZMod p =>
                  (f q : CyclotomicField p ℚ) *
                    zmodP_cyclotomic_character_val (p := p) (q.1 + s * q.2.1))]
    rw [hrewrite]
    simpa [f] using hlin_s
  have hinftyPlane :
      ∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) q.1 = 0 := by
    have hlin_inf :
        upperUnitriangularSubgroup_linearPacketAlgHom (p := p) z
            (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1)) = 0 := by
      simpa using congrFun hlin (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1))
    rw [upperUnitriangularSubgroup_linearPacketAlgHom_infty_coord] at hlin_inf
    have hrewrite :
        (∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) q.1) =
          ∑ q : ZMod p × ZMod p × ZMod p,
            (f q : CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) q.2.1 := by
      calc
        (∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) q.1)
            = ∑ b : ZMod p, ∑ a : ZMod p,
                ((∑ c : ZMod p, f (a, b, c) : ℚ) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) b := by
                rw [Fintype.sum_prod_type]
        _ = ∑ b : ZMod p, ∑ a : ZMod p, ∑ c : ZMod p,
                (f (a, b, c) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) b := by
                simp [Finset.sum_mul]
        _ = ∑ a : ZMod p, ∑ b : ZMod p, ∑ c : ZMod p,
                (f (a, b, c) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) b := by
                rw [Finset.sum_comm]
        _ = ∑ q : ZMod p × ZMod p × ZMod p,
              (f q : CyclotomicField p ℚ) *
                zmodP_cyclotomic_character_val (p := p) q.2.1 := by
                rw [zmodP_sum_triple (p := p) (fun q : ZMod p × ZMod p × ZMod p =>
                  (f q : CyclotomicField p ℚ) *
                    zmodP_cyclotomic_character_val (p := p) q.2.1)]
    rw [hrewrite]
    simpa [f] using hlin_inf
  have hFplane_zero : Fplane = 0 :=
    zmodP_projective_plane_cyclotomic_sums_zero (p := p) Fplane htotalPlane
      hfinitePlane hinftyPlane
  have hvertical : ∀ a b : ZMod p, ∑ c : ZMod p, f (a, b, c) = 0 := by
    intro a b
    have hval := congrFun hFplane_zero (b, a)
    simpa [Fplane] using hval
  have hpoint : ∀ a b c : ZMod p, f (a, b, c) = 0 := by
    intro a
    let Fa : ZMod p × ZMod p → ℚ := fun q => f (a, q.1, q.2)
    have hFaVert : ∀ b : ZMod p, ∑ c : ZMod p, Fa (b, c) = 0 := by
      intro b
      simpa [Fa] using hvertical a b
    have hFaFourier : ∀ r : ZMod p,
        ∑ q : ZMod p × ZMod p, (Fa q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (-q.2 + q.1 * r) = 0 := by
      intro r
      have hentry :
          upperUnitriangularSubgroup_schrodingerMatrixAlgHom (p := p) z
              (zmodPIndex (p := p) r) (zmodPIndex (p := p) (r - a)) = 0 := by
        have hzero := congrFun (congrFun hmat (zmodPIndex (p := p) r))
          (zmodPIndex (p := p) (r - a))
        simpa using hzero
      rw [upperUnitriangularSubgroup_schrodingerMatrixAlgHom_coord_entry] at hentry
      simpa [Fa, f] using hentry
    have hFaZero : Fa = 0 :=
      zmodP_plane_vertical_schrodinger_sums_zero (p := p) Fa hFaVert hFaFourier
    intro b c
    have hval := congrFun hFaZero (b, c)
    simpa [Fa] using hval
  have hz_zero : z = 0 := by
    ext g
    have hcoeff := hpoint
      (upperUnitriangularSubgroupCoordA (p := p) g)
      (upperUnitriangularSubgroupCoordB (p := p) g)
      (upperUnitriangularSubgroupCoordC (p := p) g)
    simpa [f, upperUnitriangularSubgroupOfCoords_coords] using hcoeff
  exact sub_eq_zero.mp (by simpa [z] using hz_zero)

/-- Helper for Exercise 13-13.1-17: the source-faithful rational Artin-Wedderburn owner on the
canonical upper-unitriangular Heisenberg model. -/
private theorem upperUnitriangularSubgroup_rational_groupAlgebra_decomposition
    (hp2 : p ≠ 2) :
    Nonempty
      (ℚ[upperUnitriangularSubgroup (ZMod p) 3] ≃ₐ[ℚ]
        RationalPacketTarget (p := p)) := by
  rcases upperUnitriangularSubgroup_rational_packet_data (p := p) hp2 with ⟨Φ, hΦ⟩
  have hdim :
      Module.finrank ℚ ℚ[upperUnitriangularSubgroup (ZMod p) 3] =
        Module.finrank ℚ (RationalPacketTarget (p := p)) := by
    rw [upperUnitriangularSubgroup_groupAlgebra_finrank_p_cubed (p := p),
      rational_target_finrank_p_cubed (p := p)]
  -- Once the packet map is injective, the common `p^3` dimension forces bijectivity.
  exact algEquiv_of_injective_algHom_of_finrank_eq Φ hdim hΦ

/-- Exercise 13-13.1-17 (2): source part (b) for the Sylow `p`-subgroup `G ≤ GL₃(𝔽_p)`. Its
rational group algebra is the product of `ℚ`, `p + 1` copies of `ℚ(p) = CyclotomicField p ℚ`,
and the matrix algebra `M_p(ℚ(p))`, assuming `p` is odd. -/
theorem sylowGL3_rational_groupAlgebra_decomposition
    (hp2 : p ≠ 2)
    (P : Sylow p (GL (Fin 3) (ZMod p))) :
    Nonempty
      (ℚ[P] ≃ₐ[ℚ]
        RationalPacketTarget (p := p)) := by
  rcases sylowGL3_mulEquiv_upperUnitriangularSubgroup (p := p) P with ⟨eP⟩
  rcases groupAlgebra_equiv_of_mulEquiv (k := ℚ) eP with ⟨eAlg⟩
  rcases upperUnitriangularSubgroup_rational_groupAlgebra_decomposition
      (p := p) hp2 with ⟨eU⟩
  -- Compose the arbitrary-Sylow transport with the canonical Heisenberg-model decomposition.
  exact ⟨eAlg.trans eU⟩

