  have hvertical : ∀ r k : ZMod p, ∑ s : ZMod p, f (r, s, k) = 0 := by
    intro r k
    have hval := congrFun hFplane_zero (k, r)
    simpa [Fplane] using hval
  have hpoint : ∀ r s k : ZMod p, f (r, s, k) = 0 := by
    intro r
    let Fr : ZMod p × ZMod p → ℚ := fun q => f (r, q.2, q.1)
    have hFrTotal : (∑ q : ZMod p × ZMod p, Fr q) = 0 := by
      calc
        (∑ q : ZMod p × ZMod p, Fr q)
            = ∑ k : ZMod p, ∑ s : ZMod p, f (r, s, k) := by
                rw [Fintype.sum_prod_type]
        _ = 0 := by
                simp [hvertical r]
    have hFrFinite : ∀ t : ZMod p,
        ∑ q : ZMod p × ZMod p, (Fr q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (q.2 + t * q.1) = 0 := by
      intro t
      have hentry :
          standardSemidirectRationalMatrixAlgHom (p := p) z
              (zmodPIndex (p := p) (t + r)) (zmodPIndex (p := p) t) = 0 := by
        have hzero := congrFun (congrFun hmat (zmodPIndex (p := p) (t + r)))
          (zmodPIndex (p := p) t)
        simpa using hzero
      rw [standardSemidirectRationalMatrixAlgHom_coord_entry] at hentry
      have hscalar_ne :
          (if h : (zmodPIndex (p := p) t).1 + r.val < p then 1
            else standardSemidirectRationalZeta (p := p)) ≠ 0 := by
        split_ifs
        · exact one_ne_zero
        · change ((zmodP_cyclotomic_character (p := p)
              (Multiplicative.ofAdd (1 : ZMod p)) : (CyclotomicField p ℚ)ˣ) :
              CyclotomicField p ℚ) ≠ 0
          exact Units.ne_zero _
      have hmatrix_sum :
          ∑ q : ZMod p × ZMod p,
            (z (standardSemidirectOfCoords (p := p) r q.1 q.2) :
                CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) (q.1 + q.2 * t) = 0 :=
        (mul_eq_zero.mp hentry).resolve_left hscalar_ne
      have hrewrite :
          (∑ q : ZMod p × ZMod p, (Fr q : CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) (q.2 + t * q.1)) =
            ∑ q : ZMod p × ZMod p,
              (f (r, q.1, q.2) : CyclotomicField p ℚ) *
                zmodP_cyclotomic_character_val (p := p) (q.1 + q.2 * t) := by
        calc
          (∑ q : ZMod p × ZMod p, (Fr q : CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) (q.2 + t * q.1))
              = ∑ k : ZMod p, ∑ s : ZMod p,
                  (f (r, s, k) : CyclotomicField p ℚ) *
                    zmodP_cyclotomic_character_val (p := p) (s + t * k) := by
                  rw [Fintype.sum_prod_type]
          _ = ∑ s : ZMod p, ∑ k : ZMod p,
                  (f (r, s, k) : CyclotomicField p ℚ) *
                    zmodP_cyclotomic_character_val (p := p) (s + k * t) := by
                  rw [Finset.sum_comm]
                  apply Finset.sum_congr rfl
                  intro s _
                  apply Finset.sum_congr rfl
                  intro k _
                  have hmul : t * k = k * t := by rw [mul_comm]
                  rw [hmul]
          _ = ∑ q : ZMod p × ZMod p,
                (f (r, q.1, q.2) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (q.1 + q.2 * t) := by
                  rw [Fintype.sum_prod_type]
      rw [hrewrite]
      simpa [f] using hmatrix_sum
    have hFrInfty :
        ∑ q : ZMod p × ZMod p, (Fr q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) q.1 = 0 := by
      calc
        (∑ q : ZMod p × ZMod p, (Fr q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) q.1)
            = ∑ k : ZMod p,
                ((∑ s : ZMod p, f (r, s, k) : ℚ) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) k := by
                rw [Fintype.sum_prod_type]
                apply Finset.sum_congr rfl
