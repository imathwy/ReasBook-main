/-- Helper for Exercise 13-13.1-17: a product of two filtration-preserving maps congruent to `1`
modulo degree one is again congruent to `1` modulo degree one. -/
private theorem standardNonabelianSemidirectDetector_mul_sub_one_raises_one
    {A B : standardNonabelianSemidirectDetectorEnd (p := p)}
    (hA0 : A ∈ standardNonabelianSemidirectDetectorRaises (p := p) 0)
    (_hB0 : B ∈ standardNonabelianSemidirectDetectorRaises (p := p) 0)
    (hA1 : A - 1 ∈ standardNonabelianSemidirectDetectorRaises (p := p) 1)
    (hB1 : B - 1 ∈ standardNonabelianSemidirectDetectorRaises (p := p) 1) :
    A * B - 1 ∈ standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
  have hprod : A * (B - 1) ∈ standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
    simpa using standardNonabelianSemidirectDetectorRaises_mul_mem (p := p) hA0 hB1
  have hsum : A * (B - 1) + (A - 1) ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 1 := add_mem hprod hA1
  have hrewrite : A * B - 1 = A * (B - 1) + (A - 1) := by
    rw [mul_sub, mul_one]
    abel_nf
  simpa [hrewrite]

/-- Helper for Exercise 13-13.1-17: every detector group element preserves the filtration. -/
private theorem standardNonabelianSemidirectDetectorMonoidHom_raises_zero
    (g : StandardGPrime) :
    standardNonabelianSemidirectDetectorMonoidHom (p := p) g ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 0 := by
  rcases g with ⟨n, a⟩
  change ((((standardNonabelianSemidirectDetectorNormalHom (p := p) n :
        (standardNonabelianSemidirectDetectorEnd (p := p))ˣ) :
      standardNonabelianSemidirectDetectorEnd (p := p)) *
      ((standardNonabelianSemidirectDetectorActingHom (p := p) a :
        (standardNonabelianSemidirectDetectorEnd (p := p))ˣ) :
      standardNonabelianSemidirectDetectorEnd (p := p)) ∈
    (standardNonabelianSemidirectDetectorRaises (p := p) 0)))
  simpa using standardNonabelianSemidirectDetectorRaises_mul_mem (p := p)
    (standardNonabelianSemidirectDetectorNormalHom_raises_zero (p := p) n)
    (standardNonabelianSemidirectDetectorActingHom_raises_zero (p := p) a)

/-- Helper for Exercise 13-13.1-17: every detector group element is congruent to `1` modulo
degree-one maps. -/
private theorem standardNonabelianSemidirectDetectorMonoidHom_sub_one_raises_one
    (g : StandardGPrime) :
    standardNonabelianSemidirectDetectorMonoidHom (p := p) g - 1 ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
  rcases g with ⟨n, a⟩
  change ((((standardNonabelianSemidirectDetectorNormalHom (p := p) n :
        (standardNonabelianSemidirectDetectorEnd (p := p))ˣ) :
      standardNonabelianSemidirectDetectorEnd (p := p)) *
      ((standardNonabelianSemidirectDetectorActingHom (p := p) a :
        (standardNonabelianSemidirectDetectorEnd (p := p))ˣ) :
      standardNonabelianSemidirectDetectorEnd (p := p)) - 1 ∈
    (standardNonabelianSemidirectDetectorRaises (p := p) 1)))
  exact standardNonabelianSemidirectDetector_mul_sub_one_raises_one (p := p)
    (standardNonabelianSemidirectDetectorNormalHom_raises_zero (p := p) n)
    (standardNonabelianSemidirectDetectorActingHom_raises_zero (p := p) a)
    (standardNonabelianSemidirectDetectorNormalHom_sub_one_raises_one (p := p) n)
    (standardNonabelianSemidirectDetectorActingHom_sub_one_raises_one (p := p) a)

/-- Helper for Exercise 13-13.1-17: the detector image of an augmentation generator raises degree
by one. -/
private theorem standardNonabelianSemidirectDetectorAlgHom_sub_one_raises_one
    (g : StandardGPrime) :
    standardNonabelianSemidirectDetectorAlgHom (p := p)
        ((MonoidAlgebra.of (ZMod p) StandardGPrime g : (ZMod p)[StandardGPrime]) - 1) ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
  rw [map_sub]
  have hbasis :
      standardNonabelianSemidirectDetectorAlgHom (p := p)
          (MonoidAlgebra.of (ZMod p) StandardGPrime g : (ZMod p)[StandardGPrime]) =
        standardNonabelianSemidirectDetectorMonoidHom (p := p) g := by
    rw [standardNonabelianSemidirectDetectorAlgHom, MonoidAlgebra.lift_apply]
    simp
  rw [hbasis, map_one]
  exact standardNonabelianSemidirectDetectorMonoidHom_sub_one_raises_one (p := p) g

/-- Helper for Exercise 13-13.1-17: the detector sends the augmentation kernel into the
degree-one filtered endomorphisms. -/
private theorem standardNonabelianSemidirectDetectorAlgHom_mem_raises_one_of_mem_augmentation
    (x : (ZMod p)[StandardGPrime])
    (hx : x ∈ RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) :
    standardNonabelianSemidirectDetectorAlgHom (p := p) x ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
  have hxspan : x ∈ Submodule.span (ZMod p)
      (Set.range fun g : StandardGPrime =>
        (MonoidAlgebra.of (ZMod p) StandardGPrime g : (ZMod p)[StandardGPrime]) - 1) := by
    simpa [standard_nonabelian_semidirect_augmentation] using
      monoidAlgebra_mem_submoduleSpan_sub_one_of_mem_augmentationKernel
        (p := p) (G := StandardGPrime) hx
  refine Submodule.span_induction
      (p := fun z _ => standardNonabelianSemidirectDetectorAlgHom (p := p) z ∈
        standardNonabelianSemidirectDetectorRaises (p := p) 1)
      ?_ ?_ ?_ ?_ hxspan
  · rintro _ ⟨g, rfl⟩
    exact standardNonabelianSemidirectDetectorAlgHom_sub_one_raises_one (p := p) g
  · simp
  · intro y z _ _ hy hz
    simpa [map_add] using add_mem hy hz
  · intro c y _ hy
    simpa using (standardNonabelianSemidirectDetectorRaises (p := p) 1).smul_mem c hy

/-- Helper for Exercise 13-13.1-17: the detector image of every modular group-algebra
 element preserves the basis-degree filtration. -/
private theorem standardNonabelianSemidirectDetectorAlgHom_mem_raises_zero
    (x : (ZMod p)[StandardGPrime]) :
    standardNonabelianSemidirectDetectorAlgHom (p := p) x ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 0 := by
  induction x using MonoidAlgebra.induction_on with
  | hM g =>
      have hbasis :
          standardNonabelianSemidirectDetectorAlgHom (p := p)
              (MonoidAlgebra.of (ZMod p) StandardGPrime g : (ZMod p)[StandardGPrime]) =
            standardNonabelianSemidirectDetectorMonoidHom (p := p) g := by
        rw [standardNonabelianSemidirectDetectorAlgHom, MonoidAlgebra.lift_apply]
        simp
      rw [hbasis]
      exact standardNonabelianSemidirectDetectorMonoidHom_raises_zero (p := p) g
  | hadd x y hx hy =>
      simpa [map_add] using add_mem hx hy
  | hsmul c x hx =>
      simpa [map_smul] using
        (standardNonabelianSemidirectDetectorRaises (p := p) 0).smul_mem c hx

/-- Helper for Exercise 13-13.1-17: the detector sends the `n`-th augmentation power into the
 degree-`n` filtered endomorphisms. -/
private theorem standardNonabelianSemidirectDetectorAlgHom_mem_raises_of_mem_augmentation_pow
    (n : ℕ) {x : (ZMod p)[StandardGPrime]}
    (hx : x ∈ (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^ n) :
    standardNonabelianSemidirectDetectorAlgHom (p := p) x ∈
      standardNonabelianSemidirectDetectorRaises (p := p) n := by
  let A := (ZMod p)[StandardGPrime]
  let I : Ideal A :=
    RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom
  change x ∈ I ^ n at hx
  induction n generalizing x with
  | zero =>
      exact standardNonabelianSemidirectDetectorAlgHom_mem_raises_zero (p := p) x
  | succ n ih =>
      have hxmul : x ∈ (I ^ n : Submodule A A) * (I : Submodule A A) := by
        simpa [Submodule.pow_succ] using hx
      refine Submodule.mul_induction_on hxmul ?_ ?_
      · intro a ha b hb
        have ha' : a ∈ I ^ n := by
          simpa using ha
        have hb' : b ∈ RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom := by
          simpa [I, A] using hb
        have hA := ih (x := a) ha'
        have hB :=
          standardNonabelianSemidirectDetectorAlgHom_mem_raises_one_of_mem_augmentation
            (p := p) b hb'
        rw [map_mul]
        simpa [Nat.succ_eq_add_one] using
          standardNonabelianSemidirectDetectorRaises_mul_mem (p := p) hA hB
      · intro y z hy hz
        simpa [map_add] using add_mem hy hz

/-- Helper for Exercise 13-13.1-17: degree `p + 1` filtered detector endomorphisms are zero on
 the truncated module. -/
private theorem standardNonabelianSemidirectDetectorRaises_succ_eq_zero
    {T : standardNonabelianSemidirectDetectorEnd (p := p)}
    (hT : T ∈ standardNonabelianSemidirectDetectorRaises (p := p) (p + 1)) :
    T = 0 := by
  apply (standardNonabelianSemidirectDetectorBasis (p := p)).ext
  intro i
  apply (standardNonabelianSemidirectDetectorBasis (p := p)).repr.injective
  ext j
  have hj : j.1 < i.1 + (p + 1) := by
    have hjlt : j.1 < p + 1 := j.2
    omega
  exact hT i j hj

/-- Helper for Exercise 13-13.1-17: the detector kills the `(p + 1)`-st augmentation power. -/
private theorem standardNonabelianSemidirectDetectorAlgHom_eq_zero_of_mem_augmentation_pow_succ
    {x : (ZMod p)[StandardGPrime]}
    (hx : x ∈
      (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^ (p + 1)) :
    standardNonabelianSemidirectDetectorAlgHom (p := p) x = 0 :=
  standardNonabelianSemidirectDetectorRaises_succ_eq_zero (p := p)
    (standardNonabelianSemidirectDetectorAlgHom_mem_raises_of_mem_augmentation_pow
      (p := p) (p + 1) hx)

/-- Helper for Exercise 13-13.1-17: the `p`-fold shift is nonzero on the truncated detector. -/
private theorem standardNonabelianSemidirectDetectorShift_pow_p_ne_zero :
    standardNonabelianSemidirectDetectorShift (p := p) ^ p ≠ 0 := by
  intro hzero
  have happly := congrArg
    (fun T : standardNonabelianSemidirectDetectorEnd (p := p) =>
      T ((standardNonabelianSemidirectDetectorBasis (p := p)) (0 : Fin (p + 1))))
    hzero
  change (standardNonabelianSemidirectDetectorShift (p := p) ^ p)
      ((standardNonabelianSemidirectDetectorBasis (p := p)) (0 : Fin (p + 1))) = 0 at happly
  rw [standardNonabelianSemidirectDetectorShift_pow_basis (p := p)] at happly
  have htarget : (0 : Fin (p + 1)).1 + p < p + 1 := by
    simp
  rw [dif_pos htarget] at happly
  have hcoord : (1 : ZMod p) = 0 := by
    simpa [standardNonabelianSemidirectDetectorBasis] using
      congrFun happly (⟨p, by omega⟩ : Fin (p + 1))
  exact one_ne_zero hcoord

/-- Helper for Exercise 13-13.1-17: the fixed coefficient functional already detects the
`(p + 1)`-st power of Serre's distinguished augmentation generator, so it cannot be the missing
vanishing functional on `I^(p + 1)`. -/
private theorem standard_nonabelian_semidirect_pth_power_coefficient_yRaw_pow_succ :
    let yRaw : (ZMod p)[StandardGPrime] :=
      (MonoidAlgebra.of (ZMod p) StandardGPrime
          (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1
    standard_nonabelian_semidirect_pth_power_coefficient (p := p) (yRaw ^ (p + 1)) = -1 := by
  dsimp
  let a : StandardGPrime := standard_nonabelian_semidirect_inl_one (p := p)
  have hpow_ne : a ^ p ≠ 1 :=
    standard_nonabelian_semidirect_inl_one_pow_p_ne_one (p := p)
  have ha_ne_one : a ≠ 1 := by
    -- If `a = 1`, then its `p`-th power would also be `1`, contradicting the closed source-side
    -- order computation.
    intro ha
    apply hpow_ne
    simpa [ha]
  have ha_ne_pow : a ≠ a ^ p := by
    -- Equality `a = a^p` would force `a^p = a^(p^2) = 1`, again contradicting the explicit
    -- semidirect-model computation.
    intro h
    have hpow : a ^ p = 1 := by
      have h' := congrArg (fun x : StandardGPrime => x ^ p) h
      have h'' : (a ^ p) ^ p = 1 := by
        calc
          (a ^ p) ^ p = a ^ (p * p) := by rw [pow_mul]
          _ = a ^ (p ^ 2) := by simp [pow_two]
          _ = 1 := by
                simpa [a] using
                  standard_nonabelian_semidirect_inl_one_pow_p_sq_eq_one (p := p)
      exact h'.trans h''
    exact hpow_ne hpow
  have hyPow :
      (((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) ^ p) =
        (MonoidAlgebra.of (ZMod p) StandardGPrime (a ^ p) : (ZMod p)[StandardGPrime]) - 1 := by
    simpa [a] using
      (monoidAlgebra_of_sub_one_pow_p (p := p) (G := StandardGPrime)
        (standard_nonabelian_semidirect_inl_one (p := p)))
  have hyPowSucc :
      (((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) ^ (p + 1)) =
        ((MonoidAlgebra.of (ZMod p) StandardGPrime (a ^ p) : (ZMod p)[StandardGPrime]) - 1) *
          ((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) := by
    calc
      (((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) ^ (p + 1))
          =
        (((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) ^ p) *
          ((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) := by
            simpa using
              (pow_succ
                ((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) p)
      _ = ((MonoidAlgebra.of (ZMod p) StandardGPrime (a ^ p) : (ZMod p)[StandardGPrime]) - 1) *
          ((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) := by
            exact
              congrArg
                (fun z : (ZMod p)[StandardGPrime] =>
                  z *
                    ((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1))
                hyPow
  -- Route correction: the old induction target was too strong. Compute the explicit counterexample
  -- `([a] - 1)^(p + 1) = ([a^p] - 1)([a] - 1)` instead.
  unfold standard_nonabelian_semidirect_pth_power_coefficient
  have hrewrite :
      ((((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1) ^ (p + 1))
          (a ^ p)) =
        (((MonoidAlgebra.of (ZMod p) StandardGPrime (a ^ p) : (ZMod p)[StandardGPrime]) - 1) *
            ((MonoidAlgebra.of (ZMod p) StandardGPrime a : (ZMod p)[StandardGPrime]) - 1))
          (a ^ p) := by
    exact congrArg (fun z : (ZMod p)[StandardGPrime] => z (a ^ p)) hyPowSucc
  have hcoeff :
      ((MonoidAlgebra.of (ZMod p) StandardGPrime (a ^ p) - 1) *
          (MonoidAlgebra.of (ZMod p) StandardGPrime a - 1)) (a ^ p) = -1 := by
    -- Only the `-[a^p]` summand contributes to the coefficient at `a^p`.
    simp [sub_eq_add_neg, add_mul, mul_add, MonoidAlgebra.of_apply, MonoidAlgebra.one_def,
      hpow_ne, ha_ne_one, ha_ne_pow]
  exact hrewrite.trans hcoeff

/-- Helper for Exercise 13-13.1-17: Serre's distinguished semidirect class survives modulo the
`(p + 1)`-st augmentation power on the canonical standard model. -/
private theorem standard_nonabelian_semidirect_generator_pth_power_survives_augmentation_quotient :
    let yRaw : (ZMod p)[StandardGPrime] :=
      (MonoidAlgebra.of (ZMod p) StandardGPrime
          (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1
    yRaw ^ p ∉
      (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^ (p + 1) := by
  dsimp
  intro hmem
  have hmap_zero :=
    standardNonabelianSemidirectDetectorAlgHom_eq_zero_of_mem_augmentation_pow_succ
      (p := p)
      (x := (((MonoidAlgebra.of (ZMod p) StandardGPrime
          (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1) ^ p))
      hmem
  rw [standardNonabelianSemidirectDetectorAlgHom_yRaw_pow_p (p := p)] at hmap_zero
  exact standardNonabelianSemidirectDetectorShift_pow_p_ne_zero (p := p) hmap_zero

/-- Helper for Exercise 13-13.1-17: Serre's source-side semidirect obstruction is detected by a
linear functional that kills `I^(p + 1)` but evaluates to `1` on the distinguished class
`([a] - 1)^p`. -/
private theorem standard_nonabelian_semidirect_pth_layer_detector :
    ∃ δ : (ZMod p)[StandardGPrime] →ₗ[ZMod p] ZMod p,
      (∀ z ∈
      (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^
            (p + 1), δ z = 0) ∧
        δ (((MonoidAlgebra.of (ZMod p) StandardGPrime
            (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1) ^
          p) = 1 := by
  let B := (ZMod p)[StandardGPrime]
  let I : Ideal B := RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom
  let yRaw : B :=
    (MonoidAlgebra.of (ZMod p) StandardGPrime
        (standard_nonabelian_semidirect_inl_one (p := p)) : B) - 1
  have hy_not_mem : yRaw ^ p ∉ I ^ (p + 1) := by
    -- The only remaining source-side input is the augmentation-quotient survival claim.
    simpa [B, I, yRaw] using
      standard_nonabelian_semidirect_generator_pth_power_survives_augmentation_quotient (p := p)
  have hy_not_mem_submodule :
      yRaw ^ p ∉
        Submodule.restrictScalars (ZMod p) (((I ^ (p + 1) : Ideal B) : Submodule B B)) := by
    simpa using hy_not_mem
  rcases linearDetectorOfNotMem
      (K := ZMod p) (V := B)
      (W := Submodule.restrictScalars (ZMod p) (((I ^ (p + 1) : Ideal B) : Submodule B B)))
      (v := yRaw ^ p) hy_not_mem_submodule with ⟨δ, hδ_zero, hδ_y⟩
  refine ⟨δ, ?_, ?_⟩
  · intro z hz
    exact hδ_zero z hz
  · simpa [B, yRaw] using hδ_y

/-- Helper for Exercise 13-13.1-17: Serre's distinguished semidirect augmentation generator
survives in the Jennings quotient `J^p / J^(p+1)`. -/
private theorem standard_nonabelian_semidirect_generator_pow_p_not_mem_augmentation_pow_succ :
    let yRaw : (ZMod p)[StandardGPrime] :=
      (MonoidAlgebra.of (ZMod p) StandardGPrime
          (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1
    yRaw ^ p ∉
      (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^ (p + 1) := by
  -- The detector theorem has been refactored down to this exact augmentation-quotient survival
  -- claim, so the public nonmembership owner is now just a wrapper.
  simpa using
    standard_nonabelian_semidirect_generator_pth_power_survives_augmentation_quotient (p := p)

/-- Helper for Exercise 13-13.1-17: Serre's distinguished semidirect augmentation generator
survives in the Jennings quotient `J^p / J^(p+1)`. -/
private theorem standard_nonabelian_semidirect_generator_pth_power_class_nonzero :
    ∃ y : Ring.jacobson ((ZMod p)[StandardGPrime]),
      Ideal.Quotient.mk
          (Ring.jacobson ((ZMod p)[StandardGPrime]) ^ (p + 1))
          (((y : (ZMod p)[StandardGPrime]) ^ p)) ≠
        0 := by
  let B := (ZMod p)[StandardGPrime]
  let yRaw : B :=
    (MonoidAlgebra.of (ZMod p) StandardGPrime
        (standard_nonabelian_semidirect_inl_one (p := p)) : B) - 1
  have hy_mem : yRaw ∈ Ring.jacobson B := by
    -- Freeze the distinguished augmentation generator as the Jacobson witness.
    simpa [B, yRaw] using standard_nonabelian_semidirect_inl_sub_one_mem_jacobson (p := p)
  have hy_not_mem :
      yRaw ^ p ∉
        (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^ (p + 1) := by
    simpa [B, yRaw] using
      standard_nonabelian_semidirect_generator_pow_p_not_mem_augmentation_pow_succ (p := p)
  refine ⟨⟨yRaw, hy_mem⟩, ?_⟩
  intro hy_zero
  have hy_mem_jac :
      (yRaw ^ p : B) ∈ Ring.jacobson B ^ (p + 1) :=
    Ideal.Quotient.eq_zero_iff_mem.1 hy_zero
  have hy_mem_aug :
      (yRaw ^ p : B) ∈
        (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^ (p + 1) := by
    -- Rewrite the Jacobson radical once to the augmentation kernel and read off the contradiction
    -- in the source-side filtration.
    simpa [B, standard_nonabelian_semidirect_jacobson_eq_augmentationKernel (p := p)] using hy_mem_jac
  exact hy_not_mem hy_mem_aug

/-- Helper for Exercise 13-13.1-17: the canonical Heisenberg and standard semidirect models have
nonisomorphic group algebras over `𝔽_p`. -/
private theorem canonical_models_modP_groupAlgebras_not_isomorphic
    (hp2 : p ≠ 2) :
    ¬ Nonempty
      ((ZMod p)[upperUnitriangularSubgroup (ZMod p) 3] ≃ₐ[ZMod p]
        (ZMod p)[StandardGPrime]) := by
  -- Route correction: compare one explicit augmentation/Jennings layer on the two canonical
  -- models, rather than trying to prove the modular obstruction directly for arbitrary transports.
  -- The raw `p`-th power computations are already closed:
  -- `upperUnitriangularSubgroup_of_sub_one_pow_p_eq_zero` kills each Heisenberg generator, while
  -- `standard_nonabelian_semidirect_inl_sub_one_pow_p_ne_zero` gives the surviving semidirect
  -- generator. The first transport step is now isolated in
  -- `jennings_pth_power_class_preserved_of_algEquiv`, which handles Jacobson-radical membership
  -- under an algebra equivalence. The ideal-power rewrite step is now closed by
  -- `jacobson_pow_map_eq_of_algEquiv`, and the quotient-level `Submodule.mapQ` owner is now
  -- explicit in `jacobson_pow_quotient_map_of_algEquiv` together with
  -- `jacobson_pth_power_quotient_map_of_algEquiv`. The remaining blocker is narrower: produce the
  -- source-faithful Heisenberg zero class and semidirect nonzero class in the actual Jennings
  -- quotient `J^p / J^(p+1)` so the new transport lemmas can contradict an algebra equivalence.
  intro hIso
  rcases hIso with ⟨e⟩
  let A := (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]
  let B := (ZMod p)[StandardGPrime]
  rcases standard_nonabelian_semidirect_generator_pth_power_class_nonzero (p := p) with
    ⟨y, hy_nonzero⟩
  have hx_mem :
      e.symm (y : B) ∈ Ring.jacobson A := by
    -- Pull the semidirect Jennings witness back through the hypothetical algebra equivalence.
    simpa [A, B] using
      (mem_jacobson_iff_of_algEquiv (p := p) e.symm (x := (y : B))).1 y.property
  let x : Ring.jacobson A := ⟨e.symm (y : B), hx_mem⟩
  have hx_zero :
      Ideal.Quotient.mk (Ring.jacobson A ^ (p + 1)) (((x : A) ^ p)) = 0 :=
    upperUnitriangularSubgroup_jacobson_pth_power_class_zero (p := p) hp2 x
  have htransport_zero :
      Ideal.Quotient.mk (Ring.jacobson B ^ (p + 1)) (((y : B) ^ p)) = 0 := by
    -- The quotient-level transport now turns the Heisenberg zero class into a zero class on the
    -- semidirect side.
    let f :=
      jacobson_pow_quotient_map_of_algEquiv (p := p) e (p + 1)
    have hmap_zero' :
        f (Ideal.Quotient.mk (Ring.jacobson A ^ (p + 1)) (((x : A) ^ p))) =
          f (0 : A ⧸ Ring.jacobson A ^ (p + 1)) := by
      exact congrArg f hx_zero
    have hmap_zero :
        f (Ideal.Quotient.mk (Ring.jacobson A ^ (p + 1)) (((x : A) ^ p))) = 0 := by
      have hfzero : f (0 : A ⧸ Ring.jacobson A ^ (p + 1)) = 0 := by
        change
          jacobson_pow_quotient_map_of_algEquiv (p := p) e (p + 1)
              (Ideal.Quotient.mk (Ring.jacobson A ^ (p + 1)) (0 : A)) =
            0
        rw [jacobson_pow_quotient_map_of_algEquiv_mk (p := p) e (p + 1) (0 : A)]
        simp
      exact hmap_zero'.trans hfzero
    calc
      Ideal.Quotient.mk (Ring.jacobson B ^ (p + 1)) (((y : B) ^ p))
          = f (Ideal.Quotient.mk (Ring.jacobson A ^ (p + 1)) (((x : A) ^ p))) := by
              symm
              calc
                f (Ideal.Quotient.mk (Ring.jacobson A ^ (p + 1)) (((x : A) ^ p)))
                    = Ideal.Quotient.mk (Ring.jacobson B ^ (p + 1)) (e ((x : A)) ^ p) := by
                        exact
                          jacobson_pth_power_quotient_map_of_algEquiv
                            (p := p) e (x := (x : A))
                _ = Ideal.Quotient.mk (Ring.jacobson B ^ (p + 1)) (((y : B) ^ p)) := by
                      simp [A, B, x]
      _ = 0 := hmap_zero
  exact hy_nonzero htransport_zero

-- Proof sketch: classify the irreducible rational representations of the nonabelian semidirect
-- product `G'`, compute their character fields, and apply Artin-Wedderburn to `ℚ[G']`.
/-- Exercise 13-13.1-17 (3): source part (b) for the nonabelian semidirect product
`G' = (Z / p² Z) ⋊ (Z / p Z)`. Its rational group algebra has the same Artin-Wedderburn shape as
that of the Sylow `p`-subgroup of `GL₃(𝔽_p)`, assuming `p` is odd. -/
theorem nonabelian_zmod_semidirectProduct_rational_groupAlgebra_decomposition
    (hp2 : p ≠ 2)
    (hφ : ¬ IsMulCommutative GPrime) :
    Nonempty
      (ℚ[GPrime] ≃ₐ[ℚ]
        RationalPacketTarget (p := p)) := by
  rcases nonabelian_zmod_semidirectProduct_mulEquiv_standard_action
      (p := p) (φ := φ) hφ with ⟨eStd⟩
  rcases groupAlgebra_equiv_of_mulEquiv (k := ℚ) eStd with ⟨eAlg⟩
  rcases standard_nonabelian_zmod_semidirectProduct_rational_groupAlgebra_decomposition
      (p := p) hp2 with ⟨eStdAlg⟩
  -- Normalize first to Serre's standard semidirect model, then apply the canonical decomposition.
  exact ⟨eAlg.trans eStdAlg⟩

-- Proof sketch: combine the two Artin-Wedderburn decompositions from parts (2) and (3) by
-- composing one algebra equivalence with the inverse of the other.
/-- Exercise 13-13.1-17 (4): source part (b). For odd `p`, the rational group algebras of the two
groups are isomorphic. -/
theorem sylowGL3_and_nonabelian_zmod_semidirectProduct_rational_groupAlgebras_isomorphic
    (hp2 : p ≠ 2)
    (P : Sylow p (GL (Fin 3) (ZMod p)))
    (hφ : ¬ IsMulCommutative GPrime) :
    Nonempty (ℚ[P] ≃ₐ[ℚ] ℚ[GPrime]) := by
  -- Compose the two decompositions through the common Artin-Wedderburn target from parts `(2)`
  -- and `(3)`.
  rcases sylowGL3_rational_groupAlgebra_decomposition (p := p) hp2 P with ⟨eP⟩
  rcases nonabelian_zmod_semidirectProduct_rational_groupAlgebra_decomposition
      (p := p) (φ := φ) hp2 hφ with ⟨eGPrime⟩
  exact ⟨eP.trans eGPrime.symm⟩

-- Proof sketch: compute invariants of the modular group algebras in characteristic `p`, such as
-- their Jacobson radicals or Loewy layers, and show these invariants differ for the two groups.
/-- Exercise 13-13.1-17 (5): source part (c). For odd `p`, the group algebras over `𝔽_p` of the
two groups are not isomorphic. -/
theorem sylowGL3_and_nonabelian_zmod_semidirectProduct_modP_groupAlgebras_not_isomorphic
    (hp2 : p ≠ 2)
    (P : Sylow p (GL (Fin 3) (ZMod p)))
    (hφ : ¬ IsMulCommutative GPrime) :
    ¬ Nonempty
      ((ZMod p)[P] ≃ₐ[ZMod p]
        (ZMod p)[GPrime]) := by
  rcases sylowGL3_mulEquiv_upperUnitriangularSubgroup (p := p) P with ⟨eP⟩
  rcases groupAlgebra_equiv_of_mulEquiv (k := ZMod p) eP with ⟨eAlgP⟩
  rcases nonabelian_zmod_semidirectProduct_mulEquiv_standard_action
      (p := p) (φ := φ) hφ with ⟨eStd⟩
  rcases groupAlgebra_equiv_of_mulEquiv (k := ZMod p) eStd with ⟨eAlgStd⟩
  -- Freeze both groups to Serre's canonical models, compare the distinguished modular layer
  -- there, and pull the contradiction back through the algebra transports.
  intro hIso
  rcases hIso with ⟨e⟩
  exact canonical_models_modP_groupAlgebras_not_isomorphic (p := p) hp2
    ⟨eAlgP.symm.trans e |>.trans eAlgStd⟩

end

end Exercise137

section Exercise138

variable {G : Type} [Group G] [Finite G]

local instance instFintypeG_Exercise_13_13_1_17 : Fintype G := Fintype.ofFinite G
local instance anonInstP_Exercise_13_13_1_17_1 (H : Subgroup G) : Fintype H := Fintype.ofFinite H

open Subgroup.CyclicConjClasses

-- Proof sketch: Theorem `13-13.1-6` gives that the permutation characters `ℓ_C^G` induced from
-- cyclic subgroups span `ℚ⊗R[ℚ](G)`. Conjugate representatives yield the same character, so the
-- chosen family still spans. A direct maximal-support argument on subgroup cardinalities proves
-- linear independence, and `Module.Basis.mk` then packages the basis.
/-- Exercise 13-13.1-17 (6): if `C₁, …, C_d` represent the conjugacy classes of cyclic subgroups
of `G`, then the induced trivial rational characters `ℓ_{C_i}^G` form a basis of `ℚ ⊗R[ℚ](G)`. -/
theorem cyclicSubgroup_representative_induced_trivial_characters_form_basis
    (d : ℕ) (C : Fin d → Subgroup G)
    (hC_cyclic : ∀ i, IsCyclic (C i))
    (hC_pairwise :
      Pairwise fun i j : Fin d ↦
        ¬ (C i).IsConj (C j))
    (hC_surj :
      ∀ H : Subgroup G, IsCyclic H →
        ∃ i : Fin d, (C i).IsConj H) :
    ∃ b : Module.Basis (Fin d) ℚ (ℚ ⊗R[ℚ](G)),
      ∀ i, (b i : G → ℚ) = (ℓ_{C i}^G : G → ℚ) := by
  classical
  let η : Fin d → ℚ ⊗R[ℚ](G) := representativeCyclicPermutationCharacter (G := G) C
  refine ⟨Module.Basis.mk (v := η) ?_ ?_, ?_⟩
  · -- The representative-family characters are independent by the maximal-support argument above.
    simpa [η] using
      linearIndependent_representative_cyclic_permutation_characters
        (G := G) d C hC_cyclic hC_pairwise
  · -- The same family spans because every cyclic subgroup is conjugate to one chosen
    -- representative.
    simpa [η] using
      top_le_span_representative_cyclic_permutation_characters
        (G := G) d C hC_cyclic hC_surj
  · intro i
    -- `Module.Basis.mk` evaluates to the generating family.
    simp [η, representativeCyclicPermutationCharacter]

end Exercise138
