section Exercise137

variable (p : ℕ) [Fact p.Prime]

/-- Helper for Exercise 13-13.1-17: the canonical primitive `p`-th root in `Q(p)`, viewed as a
unit. This is the common cyclotomic generator used by the rational one-dimensional packets. -/
private noncomputable def cyclotomicZetaPUnit : (CyclotomicField p ℚ)ˣ := by
  letI : NeZero (p : ℚ) := ⟨by exact_mod_cast (Fact.out : Nat.Prime p).ne_zero⟩
  letI : IsCyclotomicExtension {p} ℚ (CyclotomicField p ℚ) :=
    CyclotomicField.isCyclotomicExtension (n := p) (K := ℚ)
  let ζ : CyclotomicField p ℚ := IsCyclotomicExtension.zeta p ℚ (CyclotomicField p ℚ)
  have hζprim : IsPrimitiveRoot ζ p := by
    simpa [ζ] using IsCyclotomicExtension.zeta_spec p ℚ (CyclotomicField p ℚ)
  exact (hζprim.isUnit (Fact.out : Nat.Prime p).ne_zero).unit

/-- Helper for Exercise 13-13.1-17: the primitive cyclotomic unit has order dividing `p`. -/
private theorem cyclotomicZetaPUnit_pow :
    cyclotomicZetaPUnit (p := p) ^ p = 1 := by
  apply Units.ext
  dsimp [cyclotomicZetaPUnit]
  letI : NeZero (p : ℚ) := ⟨by exact_mod_cast (Fact.out : Nat.Prime p).ne_zero⟩
  letI : IsCyclotomicExtension {p} ℚ (CyclotomicField p ℚ) :=
    CyclotomicField.isCyclotomicExtension (n := p) (K := ℚ)
  let ζ : CyclotomicField p ℚ := IsCyclotomicExtension.zeta p ℚ (CyclotomicField p ℚ)
  have hζprim : IsPrimitiveRoot ζ p := by
    simpa [ζ] using IsCyclotomicExtension.zeta_spec p ℚ (CyclotomicField p ℚ)
  simpa [ζ] using hζprim.pow_eq_one

/-- Helper for Exercise 13-13.1-17: the primitive cyclotomic unit is nontrivial. -/
private theorem cyclotomicZetaPUnit_ne_one :
    cyclotomicZetaPUnit (p := p) ≠ 1 := by
  intro h
  have hcoe := congrArg (fun u : (CyclotomicField p ℚ)ˣ => (u : CyclotomicField p ℚ)) h
  dsimp [cyclotomicZetaPUnit] at hcoe
  letI : NeZero (p : ℚ) := ⟨by exact_mod_cast (Fact.out : Nat.Prime p).ne_zero⟩
  letI : IsCyclotomicExtension {p} ℚ (CyclotomicField p ℚ) :=
    CyclotomicField.isCyclotomicExtension (n := p) (K := ℚ)
  let ζ : CyclotomicField p ℚ := IsCyclotomicExtension.zeta p ℚ (CyclotomicField p ℚ)
  have hζprim : IsPrimitiveRoot ζ p := by
    simpa [ζ] using IsCyclotomicExtension.zeta_spec p ℚ (CyclotomicField p ℚ)
  exact hζprim.ne_one (Fact.out : Nat.Prime p).one_lt (by simpa [ζ] using hcoe)

/-- Helper for Exercise 13-13.1-17: the chosen cyclotomic unit is a primitive `p`-th root after
coercing to `Q(p)`. This is the primitive-root owner used for coefficient extraction in the
packet kernel calculation. -/
private theorem cyclotomicZetaPUnit_isPrimitiveRoot :
    IsPrimitiveRoot (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) p := by
  dsimp [cyclotomicZetaPUnit]
  letI : NeZero (p : ℚ) := ⟨by exact_mod_cast (Fact.out : Nat.Prime p).ne_zero⟩
  letI : IsCyclotomicExtension {p} ℚ (CyclotomicField p ℚ) :=
    CyclotomicField.isCyclotomicExtension (n := p) (K := ℚ)
  let ζ : CyclotomicField p ℚ := IsCyclotomicExtension.zeta p ℚ (CyclotomicField p ℚ)
  have hζprim : IsPrimitiveRoot ζ p := by
    simpa [ζ] using IsCyclotomicExtension.zeta_spec p ℚ (CyclotomicField p ℚ)
  simpa [ζ] using hζprim

/-- Helper for Exercise 13-13.1-17: the power basis of `Q(p)` generated by the chosen primitive
root. Its first `p - 1` powers are the standard cyclotomic coordinates. -/
private noncomputable def cyclotomicZetaPPowerBasis : PowerBasis ℚ (CyclotomicField p ℚ) := by
  letI : NeZero p := ⟨(Fact.out : Nat.Prime p).ne_zero⟩
  letI : IsCyclotomicExtension {p} ℚ (CyclotomicField p ℚ) :=
    CyclotomicField.isCyclotomicExtension (n := p) (K := ℚ)
  exact (cyclotomicZetaPUnit_isPrimitiveRoot (p := p)).powerBasis ℚ

/-- Helper for Exercise 13-13.1-17: the cyclotomic power basis generator is the chosen primitive
unit. -/
private theorem cyclotomicZetaPPowerBasis_gen :
    (cyclotomicZetaPPowerBasis (p := p)).gen =
      (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) := by
  dsimp [cyclotomicZetaPPowerBasis]

/-- Helper for Exercise 13-13.1-17: the cyclotomic power basis has the expected prime degree
`p - 1`. -/
private theorem cyclotomicZetaPPowerBasis_dim :
    (cyclotomicZetaPPowerBasis (p := p)).dim = p - 1 := by
  dsimp [cyclotomicZetaPPowerBasis]
  have hcyclo :
      minpoly ℚ (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) = cyclotomic p ℚ := by
    symm
    exact (cyclotomicZetaPUnit_isPrimitiveRoot (p := p)).minpoly_eq_cyclotomic_of_irreducible
      (Polynomial.cyclotomic.irreducible_rat (Fact.out : Nat.Prime p).pos)
  rw [hcyclo, natDegree_cyclotomic]
  exact Nat.totient_prime (Fact.out : Nat.Prime p)

/-- Helper for Exercise 13-13.1-17: the cyclotomic generator satisfies the additive-lift relation
needed to define a character of `Z / p Z`. -/
private theorem cyclotomicZetaPUnit_zmultiples_zero :
    zmultiplesHom (Additive (CyclotomicField p ℚ)ˣ)
        (Additive.ofMul (cyclotomicZetaPUnit (p := p))) p = 0 := by
  change cyclotomicZetaPUnit (p := p) ^ p = 1
  exact cyclotomicZetaPUnit_pow (p := p)

/-- Helper for Exercise 13-13.1-17: the standard `Q(p)`-valued character of the cyclic group
`Z / p Z`, sending the additive generator to the primitive cyclotomic unit. -/
private noncomputable def zmodP_cyclotomic_character :
    Multiplicative (ZMod p) →* (CyclotomicField p ℚ)ˣ :=
  AddMonoidHom.toMultiplicativeLeft <|
    ZMod.lift p
      ⟨zmultiplesHom (Additive (CyclotomicField p ℚ)ˣ)
          (Additive.ofMul (cyclotomicZetaPUnit (p := p))),
        cyclotomicZetaPUnit_zmultiples_zero (p := p)⟩

/-- Helper for Exercise 13-13.1-17: the standard cyclic character sends `1` to the chosen
primitive cyclotomic unit. -/
private theorem zmodP_cyclotomic_character_generator :
    zmodP_cyclotomic_character (p := p) (Multiplicative.ofAdd (1 : ZMod p)) =
      cyclotomicZetaPUnit (p := p) := by
  dsimp [zmodP_cyclotomic_character]
  simpa using
    congrArg Additive.toMul
      (ZMod.lift_coe
        (n := p)
        (f := ⟨zmultiplesHom (Additive (CyclotomicField p ℚ)ˣ)
          (Additive.ofMul (cyclotomicZetaPUnit (p := p))),
          cyclotomicZetaPUnit_zmultiples_zero (p := p)⟩)
        (1 : ℤ))

/-- Helper for Exercise 13-13.1-17: the standard cyclic character is nontrivial on the generator. -/
private theorem zmodP_cyclotomic_character_generator_ne_one :
    zmodP_cyclotomic_character (p := p) (Multiplicative.ofAdd (1 : ZMod p)) ≠ 1 := by
  rw [zmodP_cyclotomic_character_generator]
  exact cyclotomicZetaPUnit_ne_one (p := p)

/-- Helper for Exercise 13-13.1-17: the cyclotomic character extends to the corresponding
`Q(p)`-valued factor map on the group algebra of `Z / p Z`. -/
private noncomputable def zmodP_cyclotomic_groupAlgebraAlgHom :
    ℚ[Multiplicative (ZMod p)] →ₐ[ℚ] CyclotomicField p ℚ :=
  MonoidAlgebra.lift ℚ (CyclotomicField p ℚ) (Multiplicative (ZMod p))
    ((Units.coeHom (CyclotomicField p ℚ)).comp (zmodP_cyclotomic_character (p := p)))

/-- Helper for Exercise 13-13.1-17: on the group-algebra generator, the cyclic factor map is the
chosen primitive cyclotomic unit. -/
private theorem zmodP_cyclotomic_groupAlgebraAlgHom_generator :
    zmodP_cyclotomic_groupAlgebraAlgHom (p := p)
        (MonoidAlgebra.of ℚ (Multiplicative (ZMod p))
          (Multiplicative.ofAdd (1 : ZMod p))) =
      (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) := by
  rw [zmodP_cyclotomic_groupAlgebraAlgHom, MonoidAlgebra.lift_apply]
  simp [zmodP_cyclotomic_character_generator]

/-- Helper for Exercise 13-13.1-17: any homomorphism from a group to `Z / p Z` gives a
`Q(p)`-valued one-dimensional group-algebra factor by composing with the standard cyclotomic
character. -/
private noncomputable def cyclotomicCharacterAlgHomOf {G : Type*} [Monoid G]
    (ψ : G →* Multiplicative (ZMod p)) :
    ℚ[G] →ₐ[ℚ] CyclotomicField p ℚ :=
  MonoidAlgebra.lift ℚ (CyclotomicField p ℚ) G
    ((Units.coeHom (CyclotomicField p ℚ)).comp
      ((zmodP_cyclotomic_character (p := p)).comp ψ))

/-- Helper for Exercise 13-13.1-17: the composed cyclotomic factor map has the expected value on
group-basis elements. -/
private theorem cyclotomicCharacterAlgHomOf_of {G : Type*} [Monoid G]
    (ψ : G →* Multiplicative (ZMod p)) (g : G) :
    cyclotomicCharacterAlgHomOf (p := p) ψ (MonoidAlgebra.of ℚ G g) =
      (zmodP_cyclotomic_character (p := p) (ψ g) : CyclotomicField p ℚ) := by
  rw [cyclotomicCharacterAlgHomOf, MonoidAlgebra.lift_apply]
  simp

/-- Helper for Exercise 13-13.1-17: the trivial rational factor of a group algebra. -/
private def rationalTrivialGroupAlgebraAlgHom {G : Type*} [Monoid G] :
    ℚ[G] →ₐ[ℚ] ℚ :=
  MonoidAlgebra.lift ℚ ℚ G (1 : G →* ℚ)

/-- Helper for Exercise 13-13.1-17: the trivial rational factor sends every group-basis element
to `1`. -/
private theorem rationalTrivialGroupAlgebraAlgHom_of {G : Type*} [Monoid G] (g : G) :
    rationalTrivialGroupAlgebraAlgHom (G := G) (MonoidAlgebra.of ℚ G g) = 1 := by
  rw [rationalTrivialGroupAlgebraAlgHom, MonoidAlgebra.lift_of]
  rfl

/-- Helper for Exercise 13-13.1-17: the projective-line family of nontrivial characters of an
abelianized `F_p²`, represented by the slopes `ψ * η^r` and the point at infinity `η`. -/
private def zmodPProjectiveLineHom {G : Type*} [Group G]
    (ψ η : G →* Multiplicative (ZMod p)) (i : Fin (p + 1)) :
    G →* Multiplicative (ZMod p) :=
  if _h : i.1 < p then
    ψ * η ^ i.1
  else
    η

/-- Helper for Exercise 13-13.1-17: the projective-line characters give the `p + 1`
cyclotomic one-dimensional rational packet factors. -/
private noncomputable def cyclotomicProjectiveLinePacketAlgHom {G : Type*} [Group G]
    (ψ η : G →* Multiplicative (ZMod p)) :
    ℚ[G] →ₐ[ℚ] (Fin (p + 1) → CyclotomicField p ℚ) :=
  Pi.algHom ℚ (fun _ : Fin (p + 1) => CyclotomicField p ℚ) fun i =>
    cyclotomicCharacterAlgHomOf (p := p) (zmodPProjectiveLineHom (p := p) ψ η i)

/-- Helper for Exercise 13-13.1-17: evaluating the projective-line packet on a group-basis element
is just evaluation of the corresponding cyclotomic character. -/
private theorem cyclotomicProjectiveLinePacketAlgHom_of {G : Type*} [Group G]
    (ψ η : G →* Multiplicative (ZMod p)) (g : G) (i : Fin (p + 1)) :
    cyclotomicProjectiveLinePacketAlgHom (p := p) ψ η (MonoidAlgebra.of ℚ G g) i =
      (zmodP_cyclotomic_character (p := p)
        (zmodPProjectiveLineHom (p := p) ψ η i g) : CyclotomicField p ℚ) := by
  rw [cyclotomicProjectiveLinePacketAlgHom]
  change cyclotomicCharacterAlgHomOf (p := p) (zmodPProjectiveLineHom (p := p) ψ η i)
      (MonoidAlgebra.of ℚ G g) = _
  exact cyclotomicCharacterAlgHomOf_of (p := p)
    (zmodPProjectiveLineHom (p := p) ψ η i) g

/-- Helper for Exercise 13-13.1-17: multiplication in `UT₃(F_p)` adds the `(1,2)` root
coordinate. -/
private theorem upperUnitriangularSubgroup_entry01_mul
    (x y : upperUnitriangularSubgroup (ZMod p) 3) :
    ((((x * y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1) =
      ((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
          Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1) +
        ((((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
          Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1) := by
  have hxmem :=
    (mem_upperUnitriangularSubgroup_iff (k := ZMod p) (n := 3)
      ((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p))).1 x.property
  have hymem :=
    (mem_upperUnitriangularSubgroup_iff (k := ZMod p) (n := 3)
      ((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p))).1 y.property
  rcases hxmem with ⟨_hxtri, hxdiag⟩
  rcases hymem with ⟨hytri, hydiag⟩
  -- Expand the matrix product in the visible `(0,1)` entry and use upper-unitriangularity.
  change (((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) *
        ((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        GL (Fin 3) (ZMod p)) : Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1) = _
  rw [Matrix.GeneralLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_three]
  have hx00 :
      (((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 0 = 1 := by
    simpa using congrFun hxdiag 0
  have hy11 :
      (((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 1 = 1 := by
    simpa using congrFun hydiag 1
  have hy21 :
      (((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 2 1 = 0 := by
    exact hytri (show (2 : Fin 3) > 1 by decide)
  simp [hx00, hy11, hy21, add_comm]

/-- Helper for Exercise 13-13.1-17: multiplication in `UT₃(F_p)` adds the `(2,3)` root
coordinate. -/
private theorem upperUnitriangularSubgroup_entry12_mul
    (x y : upperUnitriangularSubgroup (ZMod p) 3) :
    ((((x * y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2) =
      ((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
          Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2) +
        ((((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
          Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2) := by
  have hxmem :=
    (mem_upperUnitriangularSubgroup_iff (k := ZMod p) (n := 3)
      ((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p))).1 x.property
  have hymem :=
    (mem_upperUnitriangularSubgroup_iff (k := ZMod p) (n := 3)
      ((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p))).1 y.property
  rcases hxmem with ⟨hxtri, hxdiag⟩
  rcases hymem with ⟨_hytri, hydiag⟩
  -- Expand the matrix product in the visible `(1,2)` entry and use upper-unitriangularity.
  change (((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) *
        ((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        GL (Fin 3) (ZMod p)) : Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2) = _
  rw [Matrix.GeneralLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_three]
  have hx10 :
      (((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 0 = 0 := by
    exact hxtri (show (1 : Fin 3) > 0 by decide)
  have hx11 :
      (((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 1 = 1 := by
    simpa using congrFun hxdiag 1
  have hy22 :
      (((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 2 2 = 1 := by
    simpa using congrFun hydiag 2
  simp [hx10, hx11, hy22, add_comm]

/-- Helper for Exercise 13-13.1-17: multiplication in `UT₃(F_p)` gives the Heisenberg central
coordinate law `c(gh) = c(g) + c(h) + a(g)b(h)`. -/
private theorem upperUnitriangularSubgroup_entry02_mul
    (x y : upperUnitriangularSubgroup (ZMod p) 3) :
    ((((x * y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2) =
      ((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
          Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2) +
        ((((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
          Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2) +
        ((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
          Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1) *
          ((((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
            Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2) := by
  have hxmem :=
    (mem_upperUnitriangularSubgroup_iff (k := ZMod p) (n := 3)
      ((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p))).1 x.property
  have hymem :=
    (mem_upperUnitriangularSubgroup_iff (k := ZMod p) (n := 3)
      ((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p))).1 y.property
  rcases hxmem with ⟨_hxtri, hxdiag⟩
  rcases hymem with ⟨_hytri, hydiag⟩
  -- The `(0,2)` entry is where the Heisenberg commutator term appears.
  change (((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) *
        ((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        GL (Fin 3) (ZMod p)) : Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2) = _
  rw [Matrix.GeneralLinearGroup.coe_mul, Matrix.mul_apply, Fin.sum_univ_three]
  have hx00 :
      (((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 0 = 1 := by
    simpa using congrFun hxdiag 0
  have hy22 :
      (((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 2 2 = 1 := by
    simpa using congrFun hydiag 2
  simp [hx00, hy22, add_assoc, add_comm, mul_comm]

/-- Helper for Exercise 13-13.1-17: the first simple-root coordinate of the Heisenberg model,
viewed as a character of the abelianization. -/
private def upperUnitriangularSubgroup_firstRootCoordinateHom :
    upperUnitriangularSubgroup (ZMod p) 3 →* Multiplicative (ZMod p) where
  toFun g :=
    Multiplicative.ofAdd
      ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1)
  map_one' := by
    simp
  map_mul' x y := by
    -- The root coordinate is additive, so `ofAdd` turns the coordinate law into multiplicativity.
    rw [upperUnitriangularSubgroup_entry01_mul (p := p) x y, ofAdd_add]

/-- Helper for Exercise 13-13.1-17: the second simple-root coordinate of the Heisenberg model,
viewed as a character of the abelianization. -/
private def upperUnitriangularSubgroup_secondRootCoordinateHom :
    upperUnitriangularSubgroup (ZMod p) 3 →* Multiplicative (ZMod p) where
  toFun g :=
    Multiplicative.ofAdd
      ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2)
  map_one' := by
    simp
  map_mul' x y := by
    -- The second root coordinate is additive for the same upper-unitriangular reason.
    rw [upperUnitriangularSubgroup_entry12_mul (p := p) x y, ofAdd_add]

/-- Helper for Exercise 13-13.1-17: the `p + 1` Heisenberg one-dimensional rational packet
factors coming from the projective line in the dual of `H/Z(H)`. -/
private noncomputable def upperUnitriangularSubgroup_linearPacketAlgHom :
    ℚ[upperUnitriangularSubgroup (ZMod p) 3] →ₐ[ℚ]
      (Fin (p + 1) → CyclotomicField p ℚ) :=
  cyclotomicProjectiveLinePacketAlgHom (p := p)
    (upperUnitriangularSubgroup_firstRootCoordinateHom (p := p))
    (upperUnitriangularSubgroup_secondRootCoordinateHom (p := p))

/-- Helper for Exercise 13-13.1-17: the Heisenberg trivial factor and the `p + 1`
one-dimensional cyclotomic factors, before adding the nonlinear matrix packet. -/
private noncomputable def upperUnitriangularSubgroup_trivialLinearPacketAlgHom :
    ℚ[upperUnitriangularSubgroup (ZMod p) 3] →ₐ[ℚ]
      ℚ × (Fin (p + 1) → CyclotomicField p ℚ) :=
  (rationalTrivialGroupAlgebraAlgHom :
      ℚ[upperUnitriangularSubgroup (ZMod p) 3] →ₐ[ℚ] ℚ).prod
    (upperUnitriangularSubgroup_linearPacketAlgHom (p := p))

/-- Helper for Exercise 13-13.1-17: choose the canonical representative of a residue class as
an index in the Schrödinger model. -/
private def zmodPIndex (x : ZMod p) : Fin p :=
  ⟨x.val, ZMod.val_lt x⟩

/-- Helper for Exercise 13-13.1-17: converting the canonical index back to `Z / p Z` recovers
the original residue class. -/
private theorem zmodPIndex_natCast (x : ZMod p) :
    ((zmodPIndex (p := p) x : ℕ) : ZMod p) = x := by
  simpa [zmodPIndex] using ZMod.natCast_zmod_val x

/-- Helper for Exercise 13-13.1-17: equality after coercion to `Z / p Z` identifies finite
indices. -/
private theorem fin_eq_of_natCast_zmod_eq {i j : Fin p}
    (h : ((i : ℕ) : ZMod p) = ((j : ℕ) : ZMod p)) : i = j := by
  apply Fin.ext
  have hmod : (i : ℕ) ≡ (j : ℕ) [MOD p] :=
    (ZMod.natCast_eq_natCast_iff (i : ℕ) (j : ℕ) p).1 h
  exact Nat.ModEq.eq_of_lt_of_lt hmod i.isLt j.isLt

/-- Helper for Exercise 13-13.1-17: indexing by a finite index is unchanged. -/
private theorem zmodPIndex_natCast_fin (i : Fin p) :
    zmodPIndex (p := p) (((i : ℕ) : ZMod p)) = i := by
  apply fin_eq_of_natCast_zmod_eq (p := p)
  rw [zmodPIndex_natCast]

/-- Helper for Exercise 13-13.1-17: two successive Schrödinger shifts combine additively. -/
private theorem zmodPIndex_sub_sub (i : Fin p) (a a' : ZMod p) :
    zmodPIndex (p := p)
        (((zmodPIndex (p := p) (((i : ℕ) : ZMod p) - a) : ℕ) : ZMod p) - a') =
      zmodPIndex (p := p) (((i : ℕ) : ZMod p) - (a + a')) := by
  apply fin_eq_of_natCast_zmod_eq (p := p)
  rw [zmodPIndex_natCast, zmodPIndex_natCast, zmodPIndex_natCast]
  ring_nf

/-- Helper for Exercise 13-13.1-17: the two equivalent forms of a combined shift index. -/
private theorem zmodPIndex_sub_add (i : Fin p) (a a' : ZMod p) :
    zmodPIndex (p := p) (((i : ℕ) : ZMod p) - (a + a')) =
      zmodPIndex (p := p) (((i : ℕ) : ZMod p) - a - a') := by
  apply fin_eq_of_natCast_zmod_eq (p := p)
  rw [zmodPIndex_natCast, zmodPIndex_natCast]
  ring_nf

/-- Helper for Exercise 13-13.1-17: the value of the standard cyclotomic character at an
additive exponent. This wrapper keeps the Schrödinger multiplication proof from unfolding the
character into the concrete `ZMod.lift` model. -/
private noncomputable def zmodP_cyclotomic_character_val (x : ZMod p) :
    CyclotomicField p ℚ :=
  (zmodP_cyclotomic_character (p := p) (Multiplicative.ofAdd x) : CyclotomicField p ℚ)

/-- Helper for Exercise 13-13.1-17: the exponent-one value is the chosen primitive cyclotomic
unit. -/
private theorem zmodP_cyclotomic_character_val_one :
    zmodP_cyclotomic_character_val (p := p) 1 =
      (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) := by
  simpa [zmodP_cyclotomic_character_val] using
    congrArg (fun u : (CyclotomicField p ℚ)ˣ => (u : CyclotomicField p ℚ))
      (zmodP_cyclotomic_character_generator (p := p))

/-- Helper for Exercise 13-13.1-17: the cyclotomic character is trivial at exponent zero. -/
@[simp] private theorem zmodP_cyclotomic_character_val_zero :
    zmodP_cyclotomic_character_val (p := p) 0 = 1 := by
  simp [zmodP_cyclotomic_character_val]

/-- Helper for Exercise 13-13.1-17: the cyclotomic character is additive in the exponent. -/
private theorem zmodP_cyclotomic_character_val_add (x y : ZMod p) :
    zmodP_cyclotomic_character_val (p := p) x *
      zmodP_cyclotomic_character_val (p := p) y =
    zmodP_cyclotomic_character_val (p := p) (x + y) := by
  change
    (((zmodP_cyclotomic_character (p := p)) (Multiplicative.ofAdd x) :
        CyclotomicField p ℚ) *
      ((zmodP_cyclotomic_character (p := p)) (Multiplicative.ofAdd y) :
        CyclotomicField p ℚ)) =
    ((zmodP_cyclotomic_character (p := p)) (Multiplicative.ofAdd (x + y)) :
        CyclotomicField p ℚ)
  rw [← Units.val_mul]
  congr 1
  rw [← map_mul, ← ofAdd_add]

/-- Helper for Exercise 13-13.1-17: the cyclotomic character evaluated at a natural
exponent is the corresponding power of the chosen primitive root. -/
private theorem zmodP_cyclotomic_character_val_natCast (n : ℕ) :
    zmodP_cyclotomic_character_val (p := p) ((n : ℕ) : ZMod p) =
      (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) ^ n := by
  induction n with
  | zero =>
      simp
  | succ n ih =>
      calc
        zmodP_cyclotomic_character_val (p := p) (((n + 1 : ℕ) : ZMod p))
            = zmodP_cyclotomic_character_val (p := p) (((n : ℕ) : ZMod p) + 1) := by
                simp [Nat.cast_succ]
        _ = zmodP_cyclotomic_character_val (p := p) ((n : ℕ) : ZMod p) *
              zmodP_cyclotomic_character_val (p := p) 1 := by
                rw [zmodP_cyclotomic_character_val_add]
        _ = (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) ^ n *
              (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) := by
                rw [ih, zmodP_cyclotomic_character_val_one]
        _ = (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) ^ (n + 1) := by
                rw [pow_succ]

/-- Helper for Exercise 13-13.1-17: a rational linear combination of the `p` powers of the
chosen primitive `p`-th root vanishes exactly when all `p` coefficients are equal. -/
private theorem cyclotomicZetaP_sum_eq_zero_iff_forall_eq (α : Fin p → ℚ) :
    (∑ i : Fin p, (α i : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) (((i : ℕ) : ZMod p)) = 0) ↔
      ∀ i j : Fin p, α i = α j := by
  simpa [zmodP_cyclotomic_character_val_natCast] using
    (IsPrimitiveRoot.sum_eq_zero_iff_forall_eq
      (Fact.out : Nat.Prime p)
      (cyclotomicZetaPUnit_isPrimitiveRoot (p := p)) α)


/-- Helper for Exercise 13-13.1-17: the same cyclotomic linear-dependence criterion indexed by
`Z / p Z` itself instead of by `Fin p`. -/
private theorem zmodP_cyclotomic_sum_eq_zero_iff_forall_eq (α : ZMod p → ℚ) :
    (∑ x : ZMod p, (α x : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) x = 0) ↔
      ∀ x y : ZMod p, α x = α y := by
  let β : Fin p → ℚ := fun i => α (((i : ℕ) : ZMod p))
  have hsum :
      (∑ i : Fin p, (β i : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (((i : ℕ) : ZMod p))) =
        ∑ x : ZMod p, (α x : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) x := by
    let e : Fin p ≃ ZMod p :=
      { toFun := fun i => ((i : ℕ) : ZMod p)
        invFun := fun x => zmodPIndex (p := p) x
        left_inv := by
          intro i
          exact zmodPIndex_natCast_fin (p := p) i
        right_inv := by
          intro x
          exact zmodPIndex_natCast (p := p) x }
    simpa [β, e] using
      Fintype.sum_equiv e
        (fun i : Fin p => (β i : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (((i : ℕ) : ZMod p)))
        (fun x : ZMod p => (α x : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) x)
        (by intro i; rfl)
  constructor
  · intro h x y
    have hβ : ∀ i j : Fin p, β i = β j :=
      (cyclotomicZetaP_sum_eq_zero_iff_forall_eq (p := p) β).1 (by rwa [hsum])
    have hxy := hβ (zmodPIndex (p := p) x) (zmodPIndex (p := p) y)
    simpa [β, zmodPIndex_natCast (p := p)] using hxy
  · intro h
    have hβ : ∀ i j : Fin p, β i = β j := by
      intro i j
      exact h (((i : ℕ) : ZMod p)) (((j : ℕ) : ZMod p))
    have hfin := (cyclotomicZetaP_sum_eq_zero_iff_forall_eq (p := p) β).2 hβ
    rwa [hsum] at hfin

/-- Helper for Exercise 13-13.1-17: a vanishing cyclotomic sum with total coefficient zero has
all `Z / p Z` coefficients zero. -/
private theorem zmodP_cyclotomic_sum_eq_zero_of_total_zero
    (α : ZMod p → ℚ)
    (hz : ∑ x : ZMod p, (α x : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) x = 0)
    (htotal : ∑ x : ZMod p, α x = 0) :
    ∀ x : ZMod p, α x = 0 := by
  have hconst : ∀ x y : ZMod p, α x = α y :=
    (zmodP_cyclotomic_sum_eq_zero_iff_forall_eq (p := p) α).1 hz
  intro x
  have hx0 : α x = α 0 := hconst x 0
  have hsum_const : ∑ y : ZMod p, α y = (p : ℚ) * α 0 := by
    calc
      ∑ y : ZMod p, α y = ∑ _y : ZMod p, α 0 := by
        apply Finset.sum_congr rfl
        intro y _
        exact hconst y 0
      _ = (p : ℚ) * α 0 := by
        simp [ZMod.card]
  have hpnonzero : (p : ℚ) ≠ 0 := by
    exact_mod_cast (Fact.out : Nat.Prime p).ne_zero
  have hp_mul : (p : ℚ) * α 0 = 0 := by
    simpa [hsum_const] using htotal
  have hzero0 : α 0 = 0 := (mul_eq_zero.mp hp_mul).resolve_left hpnonzero
  rw [hx0, hzero0]

/-- Helper for Exercise 13-13.1-17: finite sums over `Z / p Z` are invariant under translation. -/
private theorem zmodP_sum_translate_sub {A : Type*} [AddCommMonoid A]
    (F : ZMod p → A) (c : ZMod p) :
    (∑ u : ZMod p, F (u - c)) = ∑ a : ZMod p, F a := by
  let e : ZMod p ≃ ZMod p :=
    { toFun := fun a => a + c
      invFun := fun u => u - c
      left_inv := by
        intro a
        simp [sub_eq_add_neg, add_assoc]
      right_inv := by
        intro u
        simp [sub_eq_add_neg, add_comm] }
  exact (Fintype.sum_equiv e
    (fun a : ZMod p => F a)
    (fun u : ZMod p => F (u - c))
    (by
      intro a
      simp [e, sub_eq_add_neg, add_assoc])).symm

/-- Helper for Exercise 13-13.1-17: expand a finite sum over `F_p × F_p × F_p`. -/
private theorem zmodP_sum_triple {A : Type*} [AddCommMonoid A]
    (F : ZMod p × ZMod p × ZMod p → A) :
    (∑ q : ZMod p × ZMod p × ZMod p, F q) =
      ∑ a : ZMod p, ∑ b : ZMod p, ∑ c : ZMod p, F (a, b, c) := by
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro a _
  rw [Fintype.sum_prod_type]

/-- Helper for Exercise 13-13.1-17: reindex an affine line with nonzero direction in `Z / p Z`. -/
private theorem zmodP_sum_affine_line_reindex
    (F : ZMod p → ℚ) {d c0 : ZMod p} (hd : d ≠ 0) :
    (∑ i : ZMod p, F (c0 + d * i)) = ∑ c : ZMod p, F c := by
  let e : ZMod p ≃ ZMod p :=
    { toFun := fun i => c0 + d * i
      invFun := fun c => d⁻¹ * (c - c0)
      left_inv := by
        intro i
        field_simp [hd]
        ring_nf
      right_inv := by
        intro c
        field_simp [hd]
        ring_nf }
  simpa [e] using Fintype.sum_equiv e (fun i => F (c0 + d * i)) F (fun i => rfl)

/-- Helper for Exercise 13-13.1-17: in an affine plane over `Z / p Z`, all vertical and finite
slope line sums determine a rational function. -/
private theorem zmodP_plane_line_sums_zero
    (f : ZMod p × ZMod p → ℚ)
    (hvert : ∀ b : ZMod p, ∑ c : ZMod p, f (b, c) = 0)
    (hslope : ∀ i t : ZMod p, ∑ b : ZMod p, f (b, b * i - t) = 0) :
    f = 0 := by
  ext q
  rcases q with ⟨b0, c0⟩
  have htotal : (∑ b : ZMod p, ∑ c : ZMod p, f (b, c)) = 0 := by
    simp [hvert]
  have hSzero :
      (∑ i : ZMod p, ∑ b : ZMod p, f (b, c0 + (b - b0) * i)) +
        (∑ c : ZMod p, f (b0, c)) = 0 := by
    have hslope' : ∀ i : ZMod p, (∑ b : ZMod p, f (b, c0 + (b - b0) * i)) = 0 := by
      intro i
      have hrewrite : (∑ b : ZMod p, f (b, c0 + (b - b0) * i)) =
          ∑ b : ZMod p, f (b, b * i - (b0 * i - c0)) := by
        apply Finset.sum_congr rfl
        intro b _
        congr 1
        ring_nf
      rw [hrewrite]
      exact hslope i (b0 * i - c0)
    simp [hslope', hvert]
  have hS :
      (∑ i : ZMod p, ∑ b : ZMod p, f (b, c0 + (b - b0) * i)) +
        (∑ c : ZMod p, f (b0, c)) =
      (∑ b : ZMod p, ∑ c : ZMod p, f (b, c)) + (p : ℚ) * f (b0, c0) := by
    rw [Finset.sum_comm]
    let C : ZMod p → ℚ := fun b => ∑ c : ZMod p, f (b, c)
    let X : ℚ := (p : ℚ) * f (b0, c0)
    have hfirst :
        (∑ b : ZMod p, ∑ i : ZMod p, f (b, c0 + (b - b0) * i)) =
          ∑ b : ZMod p, if b = b0 then X else C b := by
      apply Finset.sum_congr rfl
      intro b _
      by_cases hb : b = b0
      · rw [if_pos hb]
        simp [hb, X, ZMod.card]
      · have hd : b - b0 ≠ 0 := by
          simpa [sub_eq_zero] using hb
        rw [if_neg hb]
        exact zmodP_sum_affine_line_reindex (p := p) (fun c => f (b, c))
          (c0 := c0) (d := b - b0) hd
    have hsumIf_eq :
        (∑ b : ZMod p, if b = b0 then X else C b) =
          (∑ b : ZMod p, C b) + (X - C b0) := by
      have hpoint :
          (∑ b : ZMod p, (if b = b0 then X - C b0 else 0)) = X - C b0 := by
        simp
      calc
        (∑ b : ZMod p, if b = b0 then X else C b)
            = ∑ b : ZMod p, (C b + if b = b0 then X - C b0 else 0) := by
                apply Finset.sum_congr rfl
                intro b _
                by_cases hb : b = b0 <;> simp [hb, C]
        _ = (∑ b : ZMod p, C b) +
              (∑ b : ZMod p, if b = b0 then X - C b0 else 0) := by
                rw [Finset.sum_add_distrib]
        _ = (∑ b : ZMod p, C b) + (X - C b0) := by
                rw [hpoint]
    rw [hfirst, hsumIf_eq]
    simp [C]
    abel
  have hpnonzero : (p : ℚ) ≠ 0 := by
    exact_mod_cast (Fact.out : Nat.Prime p).ne_zero
  have hp_mul : (p : ℚ) * f (b0, c0) = 0 := by
    have := hSzero
    rw [hS, htotal, zero_add] at this
    exact this
  exact (mul_eq_zero.mp hp_mul).resolve_left hpnonzero

/-- Helper for Exercise 13-13.1-17: the `p + 1` cyclotomic projective-line sums force a
function on the affine plane over `Z / p Z` to vanish. -/
private theorem zmodP_projective_plane_cyclotomic_sums_zero
    (F : ZMod p × ZMod p → ℚ)
    (htotal : ∑ q : ZMod p × ZMod p, F q = 0)
    (hfinite : ∀ s : ZMod p,
      ∑ q : ZMod p × ZMod p, (F q : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) (q.2 + s * q.1) = 0)
    (hinfty :
      ∑ q : ZMod p × ZMod p, (F q : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) q.1 = 0) :
    F = 0 := by
  apply zmodP_plane_line_sums_zero (p := p) F
  · let α : ZMod p → ℚ := fun b => ∑ a : ZMod p, F (b, a)
    have hz :
        ∑ b : ZMod p, (α b : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) b = 0 := by
      have hrewrite :
          (∑ b : ZMod p, (α b : CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) b) =
            ∑ q : ZMod p × ZMod p, (F q : CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) q.1 := by
        rw [Fintype.sum_prod_type]
        simp [α, Finset.sum_mul]
      rwa [hrewrite]
    have htotalα : ∑ b : ZMod p, α b = 0 := by
      have hrewrite : (∑ b : ZMod p, α b) = ∑ q : ZMod p × ZMod p, F q := by
        rw [Fintype.sum_prod_type]
      rwa [hrewrite]
    exact zmodP_cyclotomic_sum_eq_zero_of_total_zero (p := p) α hz htotalα
  · intro i t
    let s : ZMod p := -i
    let α : ZMod p → ℚ := fun u => ∑ b : ZMod p, F (b, u - s * b)
    have hz :
        ∑ u : ZMod p, (α u : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) u = 0 := by
      have hrewrite :
          (∑ u : ZMod p, (α u : CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) u) =
            ∑ q : ZMod p × ZMod p, (F q : CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) (q.2 + s * q.1) := by
        calc
          (∑ u : ZMod p, (α u : CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) u)
              = ∑ u : ZMod p, ∑ b : ZMod p,
                  (F (b, u - s * b) : CyclotomicField p ℚ) *
                    zmodP_cyclotomic_character_val (p := p) u := by
                    simp [α, Finset.sum_mul]
          _ = ∑ b : ZMod p, ∑ u : ZMod p,
                (F (b, u - s * b) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) u := by
                    rw [Finset.sum_comm]
          _ = ∑ b : ZMod p, ∑ a : ZMod p,
                (F (b, a) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (a + s * b) := by
                    apply Finset.sum_congr rfl
                    intro b _
                    let e : ZMod p ≃ ZMod p :=
                      { toFun := fun a => a + s * b
                        invFun := fun u => u - s * b
                        left_inv := by
                          intro a
                          simp [sub_eq_add_neg, add_assoc]
                        right_inv := by
                          intro u
                          simp [sub_eq_add_neg, add_left_comm, add_comm] }
                    simpa [e] using
                      (Fintype.sum_equiv e
                        (fun a : ZMod p => (F (b, a) : CyclotomicField p ℚ) *
                          zmodP_cyclotomic_character_val (p := p) (a + s * b))
                        (fun u : ZMod p => (F (b, u - s * b) : CyclotomicField p ℚ) *
                          zmodP_cyclotomic_character_val (p := p) u)
                        (by
                          intro a
                          simp [e, sub_eq_add_neg, add_assoc])).symm
          _ = ∑ q : ZMod p × ZMod p, (F q : CyclotomicField p ℚ) *
                zmodP_cyclotomic_character_val (p := p) (q.2 + s * q.1) := by
                    rw [Fintype.sum_prod_type]
      rw [hrewrite]
      exact hfinite s
    have htotalα : ∑ u : ZMod p, α u = 0 := by
      have hrewrite : (∑ u : ZMod p, α u) = ∑ q : ZMod p × ZMod p, F q := by
        calc
          (∑ u : ZMod p, α u) = ∑ u : ZMod p, ∑ b : ZMod p, F (b, u - s * b) := rfl
          _ = ∑ b : ZMod p, ∑ u : ZMod p, F (b, u - s * b) := by
                rw [Finset.sum_comm]
          _ = ∑ b : ZMod p, ∑ a : ZMod p, F (b, a) := by
                apply Finset.sum_congr rfl
                intro b _
                exact zmodP_sum_translate_sub (p := p) (fun a : ZMod p => F (b, a)) (s * b)
          _ = ∑ q : ZMod p × ZMod p, F q := by
                rw [Fintype.sum_prod_type]
      rwa [hrewrite]
    have hline := zmodP_cyclotomic_sum_eq_zero_of_total_zero (p := p) α hz htotalα (-t)
    calc
      ∑ b : ZMod p, F (b, b * i - t) = ∑ b : ZMod p, F (b, -t - s * b) := by
        apply Finset.sum_congr rfl
        intro b _
        congr 1
        simp [s]
        ring_nf
      _ = 0 := hline


/-- Helper for Exercise 13-13.1-17: vertical line sums and the Schrödinger Fourier sums
`χ(-c + rb)` determine a rational function on the affine plane. -/
private theorem zmodP_plane_vertical_schrodinger_sums_zero
    (F : ZMod p × ZMod p → ℚ)
    (hvert : ∀ b : ZMod p, ∑ c : ZMod p, F (b, c) = 0)
    (hfourier : ∀ r : ZMod p,
      ∑ q : ZMod p × ZMod p, (F q : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) (-q.2 + q.1 * r) = 0) :
    F = 0 := by
  apply zmodP_plane_line_sums_zero (p := p) F hvert
  intro r t
  let α : ZMod p → ℚ := fun u => ∑ b : ZMod p, F (b, b * r - u)
  have hz :
      ∑ u : ZMod p, (α u : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) u = 0 := by
    have hrewrite :
        (∑ u : ZMod p, (α u : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) u) =
          ∑ q : ZMod p × ZMod p, (F q : CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) (-q.2 + q.1 * r) := by
      calc
        (∑ u : ZMod p, (α u : CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) u)
            = ∑ u : ZMod p, ∑ b : ZMod p,
                (F (b, b * r - u) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) u := by
                  simp [α, Finset.sum_mul]
        _ = ∑ b : ZMod p, ∑ u : ZMod p,
              (F (b, b * r - u) : CyclotomicField p ℚ) *
                zmodP_cyclotomic_character_val (p := p) u := by
                  rw [Finset.sum_comm]
        _ = ∑ b : ZMod p, ∑ c : ZMod p,
              (F (b, c) : CyclotomicField p ℚ) *
                zmodP_cyclotomic_character_val (p := p) (-c + b * r) := by
                  apply Finset.sum_congr rfl
                  intro b _
                  let e : ZMod p ≃ ZMod p :=
                    { toFun := fun c => b * r - c
                      invFun := fun u => b * r - u
                      left_inv := by
                        intro c
                        simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
                      right_inv := by
                        intro u
                        simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] }
                  simpa [e, sub_eq_add_neg, add_assoc, add_comm, add_left_comm] using
                    (Fintype.sum_equiv e
                      (fun c : ZMod p => (F (b, c) : CyclotomicField p ℚ) *
                        zmodP_cyclotomic_character_val (p := p) (-c + b * r))
                      (fun u : ZMod p => (F (b, b * r - u) : CyclotomicField p ℚ) *
                        zmodP_cyclotomic_character_val (p := p) u)
                      (by
                        intro c
                        simp [e, sub_eq_add_neg, add_assoc, add_comm, add_left_comm])).symm
        _ = ∑ q : ZMod p × ZMod p, (F q : CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) (-q.2 + q.1 * r) := by
                rw [Fintype.sum_prod_type]
    rw [hrewrite]
    exact hfourier r
  have htotalα : ∑ u : ZMod p, α u = 0 := by
    calc
      (∑ u : ZMod p, α u) = ∑ u : ZMod p, ∑ b : ZMod p, F (b, b * r - u) := rfl
      _ = ∑ b : ZMod p, ∑ u : ZMod p, F (b, b * r - u) := by
            rw [Finset.sum_comm]
      _ = ∑ b : ZMod p, ∑ c : ZMod p, F (b, c) := by
            apply Finset.sum_congr rfl
            intro b _
            let e : ZMod p ≃ ZMod p :=
              { toFun := fun c => b * r - c
                invFun := fun u => b * r - u
                left_inv := by
                  intro c
                  simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
                right_inv := by
                  intro u
                  simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] }
            simpa [e] using
              (Fintype.sum_equiv e
                (fun c : ZMod p => F (b, c))
                (fun u : ZMod p => F (b, b * r - u))
                (by
                  intro c
                  simp [e, sub_eq_add_neg, add_assoc, add_left_comm, add_comm])).symm
      _ = 0 := by
            simp [hvert]
  exact zmodP_cyclotomic_sum_eq_zero_of_total_zero (p := p) α hz htotalα t

/-- Helper for Exercise 13-13.1-17: the `Q(p)`-space used for the nonlinear Heisenberg
Schrödinger packet. -/
private abbrev heisenbergSchrodingerSpace :=
  Fin p → CyclotomicField p ℚ

/-- Helper for Exercise 13-13.1-17: Serre's `p`-dimensional Heisenberg representation with
central character the chosen primitive `p`-th root. In coordinates
`(a,b,c) = (g₀₁,g₁₂,g₀₂)`, it acts by
`f(i) ↦ ζ^(-c + b i) f(i - a)`. -/
private noncomputable def heisenbergSchrodingerLinearMap
    (a b c : ZMod p) :
    Module.End (CyclotomicField p ℚ) (heisenbergSchrodingerSpace (p := p)) where
  toFun f i :=
    zmodP_cyclotomic_character_val (p := p) (-c + b * ((i : ℕ) : ZMod p)) *
      f (zmodPIndex (p := p) (((i : ℕ) : ZMod p) - a))
  map_add' f g := by
    ext i
    simp [mul_add]
  map_smul' r f := by
    ext i
    simp [mul_left_comm]

/-- Helper for Exercise 13-13.1-17: the Schrödinger operators multiply according to the
Heisenberg coordinate law `c(gh) = c(g) + c(h) + a(g)b(h)`. -/
private theorem heisenbergSchrodingerLinearMap_mul
    (a b c a' b' c' : ZMod p) :
    heisenbergSchrodingerLinearMap (p := p) (a + a') (b + b') (c + c' + a * b') =
      heisenbergSchrodingerLinearMap (p := p) a b c *
        heisenbergSchrodingerLinearMap (p := p) a' b' c' := by
  apply LinearMap.ext
  intro f
  ext i
  change
    (heisenbergSchrodingerLinearMap (p := p)
        (a + a') (b + b') (c + c' + a * b') f) i =
      (heisenbergSchrodingerLinearMap (p := p) a b c
        (heisenbergSchrodingerLinearMap (p := p) a' b' c' f)) i
  simp [heisenbergSchrodingerLinearMap, zmodPIndex_natCast, ← mul_assoc,
    zmodP_cyclotomic_character_val_add]
  rw [zmodPIndex_sub_add]
  congr 1
  ring

/-- Helper for Exercise 13-13.1-17: the nonlinear Heisenberg packet as an endomorphism-valued
representation. -/
private noncomputable def upperUnitriangularSubgroup_schrodingerEndMonoidHom :
    upperUnitriangularSubgroup (ZMod p) 3 →*
      Module.End (CyclotomicField p ℚ) (heisenbergSchrodingerSpace (p := p)) where
  toFun g :=
    heisenbergSchrodingerLinearMap (p := p)
      ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1)
      ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2)
      ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2)
  map_one' := by
    apply LinearMap.ext
    intro f
    ext i
    simp [heisenbergSchrodingerLinearMap, zmodPIndex_natCast_fin]
  map_mul' x y := by
    rw [upperUnitriangularSubgroup_entry01_mul (p := p) x y,
      upperUnitriangularSubgroup_entry12_mul (p := p) x y,
      upperUnitriangularSubgroup_entry02_mul (p := p) x y]
    exact heisenbergSchrodingerLinearMap_mul (p := p)
      ((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1)
      ((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2)
      ((((x : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2)
      ((((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1)
      ((((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2)
      ((((y : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2)

/-- Helper for Exercise 13-13.1-17: the standard basis for the Schrödinger model. -/
private noncomputable def heisenbergSchrodingerBasis :
    Module.Basis (Fin p) (CyclotomicField p ℚ) (heisenbergSchrodingerSpace (p := p)) :=
  Pi.basisFun (CyclotomicField p ℚ) (Fin p)

/-- Helper for Exercise 13-13.1-17: the matrix entries of the Heisenberg Schrödinger operator.
The entry `(i,j)` is the displayed cyclotomic scalar exactly when the shifted basis vector indexed
by `i - a` is `j`, and is zero otherwise. -/
private theorem heisenbergSchrodingerLinearMap_matrix_entry
    (a b c : ZMod p) (i j : Fin p) :
    (LinearMap.toMatrixAlgEquiv (heisenbergSchrodingerBasis (p := p))
        (heisenbergSchrodingerLinearMap (p := p) a b c)) i j =
      if zmodPIndex (p := p) (((i : ℕ) : ZMod p) - a) = j then
        zmodP_cyclotomic_character_val (p := p) (-c + b * ((i : ℕ) : ZMod p))
      else
        0 := by
  -- Expand `toMatrix` on the standard function basis; only the shifted basis coordinate can
  -- contribute to this matrix entry.
  rw [LinearMap.toMatrixAlgEquiv_apply]
  simp [heisenbergSchrodingerBasis, heisenbergSchrodingerLinearMap]
  by_cases hidx : zmodPIndex (p := p) (((i : ℕ) : ZMod p) - a) = j
  · rw [if_pos hidx, hidx, Pi.single_eq_same, mul_one]
  · rw [if_neg hidx, Pi.single_eq_of_ne hidx, mul_zero]

/-- Helper for Exercise 13-13.1-17: the nonlinear Heisenberg packet as a matrix-valued
representation. -/
private noncomputable def upperUnitriangularSubgroup_schrodingerMatrixMonoidHom :
    upperUnitriangularSubgroup (ZMod p) 3 →*
      Matrix (Fin p) (Fin p) (CyclotomicField p ℚ) where
  toFun g :=
    (LinearMap.toMatrixAlgEquiv (heisenbergSchrodingerBasis (p := p)))
      (upperUnitriangularSubgroup_schrodingerEndMonoidHom (p := p) g)
  map_one' := by
    simp [heisenbergSchrodingerBasis]
  map_mul' x y := by
    simp [map_mul]

/-- Helper for Exercise 13-13.1-17: the `(i,j)` entry of the Heisenberg nonlinear matrix packet
on a group element, expressed in the three matrix coordinates of `UT₃(F_p)`. -/
private theorem upperUnitriangularSubgroup_schrodingerMatrixMonoidHom_entry
    (g : upperUnitriangularSubgroup (ZMod p) 3) (i j : Fin p) :
    upperUnitriangularSubgroup_schrodingerMatrixMonoidHom (p := p) g i j =
      if zmodPIndex (p := p)
          (((i : ℕ) : ZMod p) -
            ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
              Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1)) = j then
        zmodP_cyclotomic_character_val (p := p)
          (-((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
              Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2) +
            ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
              Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2) * ((i : ℕ) : ZMod p))
      else
        0 := by
  -- Unfold the representation to the already-proved matrix-entry formula for the underlying
  -- Schrödinger operator.
  rw [upperUnitriangularSubgroup_schrodingerMatrixMonoidHom]
  exact heisenbergSchrodingerLinearMap_matrix_entry (p := p)
    ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
      Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1)
    ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
      Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2)
    ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
      Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2) i j

/-- Helper for Exercise 13-13.1-17: the nonlinear Heisenberg matrix packet on the rational group
algebra. -/
private noncomputable def upperUnitriangularSubgroup_schrodingerMatrixAlgHom :
    ℚ[upperUnitriangularSubgroup (ZMod p) 3] →ₐ[ℚ]
      Matrix (Fin p) (Fin p) (CyclotomicField p ℚ) :=
  MonoidAlgebra.lift ℚ
    (Matrix (Fin p) (Fin p) (CyclotomicField p ℚ))
    (upperUnitriangularSubgroup (ZMod p) 3)
    (upperUnitriangularSubgroup_schrodingerMatrixMonoidHom (p := p))

/-- Helper for Exercise 13-13.1-17: the `(i,j)` entry of the Heisenberg nonlinear matrix packet
on a single group-algebra basis element. -/
private theorem upperUnitriangularSubgroup_schrodingerMatrixAlgHom_of_entry
    (g : upperUnitriangularSubgroup (ZMod p) 3) (i j : Fin p) :
    upperUnitriangularSubgroup_schrodingerMatrixAlgHom (p := p)
        (MonoidAlgebra.of ℚ (upperUnitriangularSubgroup (ZMod p) 3) g) i j =
      if zmodPIndex (p := p)
          (((i : ℕ) : ZMod p) -
            ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
              Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1)) = j then
        zmodP_cyclotomic_character_val (p := p)
          (-((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
              Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2) +
            ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
              Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2) * ((i : ℕ) : ZMod p))
      else
        0 := by
  -- Evaluate the monoid-algebra lift on a group basis vector, then use the group-level entry
  -- formula.
  rw [upperUnitriangularSubgroup_schrodingerMatrixAlgHom, MonoidAlgebra.lift_of,
    upperUnitriangularSubgroup_schrodingerMatrixMonoidHom_entry]

/-- Helper for Exercise 13-13.1-17: Serre's full rational packet map on the Heisenberg model:
the trivial character, the `p + 1` abelianized cyclotomic packets, and the nonlinear
Schrödinger packet. -/
private noncomputable def upperUnitriangularSubgroup_rationalPacketAlgHom :
    ℚ[upperUnitriangularSubgroup (ZMod p) 3] →ₐ[ℚ] RationalPacketTarget (p := p) :=
  (rationalTrivialGroupAlgebraAlgHom :
      ℚ[upperUnitriangularSubgroup (ZMod p) 3] →ₐ[ℚ] ℚ).prod
    ((upperUnitriangularSubgroup_linearPacketAlgHom (p := p)).prod
      (upperUnitriangularSubgroup_schrodingerMatrixAlgHom (p := p)))


/-- Helper for Exercise 13-13.1-17: the visible `(0,1)` coordinate on `UT₃(F_p)`. -/
private abbrev upperUnitriangularSubgroupCoordA
    (g : upperUnitriangularSubgroup (ZMod p) 3) : ZMod p :=
  ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
    Matrix (Fin 3) (Fin 3) (ZMod p)) 0 1)

/-- Helper for Exercise 13-13.1-17: the visible `(1,2)` coordinate on `UT₃(F_p)`. -/
private abbrev upperUnitriangularSubgroupCoordB
    (g : upperUnitriangularSubgroup (ZMod p) 3) : ZMod p :=
  ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
    Matrix (Fin 3) (Fin 3) (ZMod p)) 1 2)

/-- Helper for Exercise 13-13.1-17: the visible central `(0,2)` coordinate on `UT₃(F_p)`. -/
private abbrev upperUnitriangularSubgroupCoordC
    (g : upperUnitriangularSubgroup (ZMod p) 3) : ZMod p :=
  ((((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
    Matrix (Fin 3) (Fin 3) (ZMod p)) 0 2)

/-- Helper for Exercise 13-13.1-17: the upper-unitriangular matrix with coordinates `(a,b,c)`. -/
private def upperUnitriangularSubgroupOfCoords (a b c : ZMod p) :
    upperUnitriangularSubgroup (ZMod p) 3 := by
  refine ⟨Matrix.GeneralLinearGroup.mk'' !![1, a, c; 0, 1, b; 0, 0, 1] ?_, ?_⟩
  · refine ⟨1, ?_⟩
    simp [Matrix.det_fin_three]
  · rw [mem_upperUnitriangularSubgroup_iff]
    change (!![1, a, c; 0, 1, b; 0, 0, 1]).BlockTriangular id ∧
        (!![1, a, c; 0, 1, b; 0, 0, 1]).diag = 1
    constructor
    · intro i j hij
      fin_cases i <;> fin_cases j <;> simp at hij ⊢
    · ext i
      fin_cases i <;> simp

private theorem upperUnitriangularSubgroupOfCoords_coordA (a b c : ZMod p) :
    upperUnitriangularSubgroupCoordA (p := p)
      (upperUnitriangularSubgroupOfCoords (p := p) a b c) = a := by
  simp [upperUnitriangularSubgroupCoordA, upperUnitriangularSubgroupOfCoords]

private theorem upperUnitriangularSubgroupOfCoords_coordB (a b c : ZMod p) :
    upperUnitriangularSubgroupCoordB (p := p)
      (upperUnitriangularSubgroupOfCoords (p := p) a b c) = b := by
  simp [upperUnitriangularSubgroupCoordB, upperUnitriangularSubgroupOfCoords]

private theorem upperUnitriangularSubgroupOfCoords_coordC (a b c : ZMod p) :
    upperUnitriangularSubgroupCoordC (p := p)
      (upperUnitriangularSubgroupOfCoords (p := p) a b c) = c := by
  simp [upperUnitriangularSubgroupCoordC, upperUnitriangularSubgroupOfCoords]

/-- Helper for Exercise 13-13.1-17: the three visible coordinates determine a point of
`UT₃(F_p)`. -/
private theorem upperUnitriangularSubgroupOfCoords_coords
    (g : upperUnitriangularSubgroup (ZMod p) 3) :
    upperUnitriangularSubgroupOfCoords (p := p)
      (upperUnitriangularSubgroupCoordA (p := p) g)
      (upperUnitriangularSubgroupCoordB (p := p) g)
      (upperUnitriangularSubgroupCoordC (p := p) g) = g := by
  have hmem :=
    (mem_upperUnitriangularSubgroup_iff (k := ZMod p) (n := 3)
      ((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p))).1 g.property
  rcases hmem with ⟨htri, hdiag⟩
  have h00 :
      (((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 0 0 = 1 := by
    simpa using congrFun hdiag 0
  have h11 :
      (((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 1 = 1 := by
    simpa using congrFun hdiag 1
  have h22 :
      (((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 2 2 = 1 := by
    simpa using congrFun hdiag 2
  have h10 :
      (((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 1 0 = 0 := by
    exact htri (show (1 : Fin 3) > 0 by decide)
  have h20 :
      (((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 2 0 = 0 := by
    exact htri (show (2 : Fin 3) > 0 by decide)
  have h21 :
      (((g : upperUnitriangularSubgroup (ZMod p) 3) : GL (Fin 3) (ZMod p)) :
        Matrix (Fin 3) (Fin 3) (ZMod p)) 2 1 = 0 := by
    exact htri (show (2 : Fin 3) > 1 by decide)
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [upperUnitriangularSubgroupOfCoords, upperUnitriangularSubgroupCoordA,
      upperUnitriangularSubgroupCoordB, upperUnitriangularSubgroupCoordC,
      h00, h11, h22, h10, h20, h21]

/-- Helper for Exercise 13-13.1-17: `UT₃(F_p)` is coordinatewise equivalent to `F_p³`. -/
private noncomputable def upperUnitriangularSubgroupCoordEquiv :
    upperUnitriangularSubgroup (ZMod p) 3 ≃ ZMod p × ZMod p × ZMod p where
  toFun g :=
    (upperUnitriangularSubgroupCoordA (p := p) g,
      upperUnitriangularSubgroupCoordB (p := p) g,
      upperUnitriangularSubgroupCoordC (p := p) g)
  invFun q := upperUnitriangularSubgroupOfCoords (p := p) q.1 q.2.1 q.2.2
  left_inv g := upperUnitriangularSubgroupOfCoords_coords (p := p) g
  right_inv q := by
    rcases q with ⟨a, b, c⟩
    simp [upperUnitriangularSubgroupOfCoords_coordA,
      upperUnitriangularSubgroupOfCoords_coordB,
      upperUnitriangularSubgroupOfCoords_coordC]


/-- Helper for Exercise 13-13.1-17: evaluate a cyclotomic projective-line packet on an arbitrary
group-algebra element as the corresponding finite coefficient sum. -/
private theorem cyclotomicProjectiveLinePacketAlgHom_apply {G : Type*} [Group G]
    [Fintype G] [DecidableEq G]
    (ψ η : G →* Multiplicative (ZMod p)) (z : ℚ[G]) (i : Fin (p + 1)) :
    cyclotomicProjectiveLinePacketAlgHom (p := p) ψ η z i =
      ∑ g : G, (z g : CyclotomicField p ℚ) *
        ((zmodP_cyclotomic_character (p := p)
          (zmodPProjectiveLineHom (p := p) ψ η i g) :
            (CyclotomicField p ℚ)ˣ) : CyclotomicField p ℚ) := by
  rw [cyclotomicProjectiveLinePacketAlgHom]
  change cyclotomicCharacterAlgHomOf (p := p) (zmodPProjectiveLineHom (p := p) ψ η i) z = _
  rw [cyclotomicCharacterAlgHomOf, MonoidAlgebra.lift_apply]
  simp [Finsupp.sum_fintype, Algebra.smul_def]

/-- Helper for Exercise 13-13.1-17: finite sums over `UT₃(F_p)` may be read in coordinates. -/
private theorem upperUnitriangularSubgroup_sum_coord {A : Type*} [AddCommMonoid A]
    (F : upperUnitriangularSubgroup (ZMod p) 3 → A) :
    (∑ g : upperUnitriangularSubgroup (ZMod p) 3, F g) =
      ∑ q : ZMod p × ZMod p × ZMod p,
        F ((upperUnitriangularSubgroupCoordEquiv (p := p)).symm q) := by
  let e := upperUnitriangularSubgroupCoordEquiv (p := p)
  simpa [e] using
    Fintype.sum_equiv e F (fun q => F (e.symm q)) (by intro g; simp [e])

/-- Helper for Exercise 13-13.1-17: powers in an additive group written multiplicatively are
natural multiples of the additive exponent. -/
private theorem multiplicative_ofAdd_pow_nat_mul (n : ℕ) (x : ZMod p) :
    (Multiplicative.ofAdd x) ^ n = Multiplicative.ofAdd (((n : ℕ) : ZMod p) * x) := by
  induction n with
  | zero =>
      simp
  | succ n ih =>
      rw [pow_succ, ih]
      simp [Nat.cast_succ, add_mul, one_mul, ofAdd_add]

/-- Helper for Exercise 13-13.1-17: the finite projective-line coordinates on `UT₃(F_p)` are
`a + s b` in visible matrix coordinates. -/
private theorem upperUnitriangularSubgroup_projectiveLine_finite_coord
    (s : ZMod p) (g : upperUnitriangularSubgroup (ZMod p) 3) :
    zmodPProjectiveLineHom (p := p)
        (upperUnitriangularSubgroup_firstRootCoordinateHom (p := p))
        (upperUnitriangularSubgroup_secondRootCoordinateHom (p := p))
        (⟨s.val, Nat.lt_trans (ZMod.val_lt s) (Nat.lt_succ_self p)⟩ : Fin (p + 1)) g =
      Multiplicative.ofAdd
        (upperUnitriangularSubgroupCoordA (p := p) g +
          s * upperUnitriangularSubgroupCoordB (p := p) g) := by
  have hslt :
      (⟨s.val, Nat.lt_trans (ZMod.val_lt s) (Nat.lt_succ_self p)⟩ : Fin (p + 1)).1 < p :=
    ZMod.val_lt s
  simp [zmodPProjectiveLineHom, hslt, upperUnitriangularSubgroup_firstRootCoordinateHom,
    upperUnitriangularSubgroup_secondRootCoordinateHom, upperUnitriangularSubgroupCoordA,
    upperUnitriangularSubgroupCoordB]
  rw [multiplicative_ofAdd_pow_nat_mul, ZMod.natCast_zmod_val]

/-- Helper for Exercise 13-13.1-17: the point at infinity on the Heisenberg projective line is the
second visible root coordinate. -/
private theorem upperUnitriangularSubgroup_projectiveLine_infty_coord
    (g : upperUnitriangularSubgroup (ZMod p) 3) :
    zmodPProjectiveLineHom (p := p)
        (upperUnitriangularSubgroup_firstRootCoordinateHom (p := p))
        (upperUnitriangularSubgroup_secondRootCoordinateHom (p := p))
        (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1)) g =
      Multiplicative.ofAdd (upperUnitriangularSubgroupCoordB (p := p) g) := by
  have hpnot : ¬ (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1)).1 < p := by
    simp
  simp [zmodPProjectiveLineHom, hpnot, upperUnitriangularSubgroup_secondRootCoordinateHom,
    upperUnitriangularSubgroupCoordB]

/-- Helper for Exercise 13-13.1-17: evaluate a matrix-entry of the Heisenberg nonlinear packet on
an arbitrary group-algebra element. -/
private theorem upperUnitriangularSubgroup_schrodingerMatrixAlgHom_apply_entry
    (z : ℚ[upperUnitriangularSubgroup (ZMod p) 3]) (i j : Fin p) :
    upperUnitriangularSubgroup_schrodingerMatrixAlgHom (p := p) z i j =
      ∑ g : upperUnitriangularSubgroup (ZMod p) 3,
        (z g : CyclotomicField p ℚ) *
          upperUnitriangularSubgroup_schrodingerMatrixMonoidHom (p := p) g i j := by
  rw [upperUnitriangularSubgroup_schrodingerMatrixAlgHom, MonoidAlgebra.lift_apply]
  rw [Finsupp.sum_fintype]
  · rw [Matrix.sum_apply i j Finset.univ
      (fun g : upperUnitriangularSubgroup (ZMod p) 3 =>
        z g • upperUnitriangularSubgroup_schrodingerMatrixMonoidHom (p := p) g)]
    simp [Algebra.smul_def]
  · intro g
    simp



/-- Helper for Exercise 13-13.1-17: the finite-slope Heisenberg linear packet in coordinates. -/
private theorem upperUnitriangularSubgroup_linearPacketAlgHom_finite_coord
    (z : ℚ[upperUnitriangularSubgroup (ZMod p) 3]) (s : ZMod p) :
    upperUnitriangularSubgroup_linearPacketAlgHom (p := p) z
        (⟨s.val, Nat.lt_trans (ZMod.val_lt s) (Nat.lt_succ_self p)⟩ : Fin (p + 1)) =
      ∑ q : ZMod p × ZMod p × ZMod p,
        (z (upperUnitriangularSubgroupOfCoords (p := p) q.1 q.2.1 q.2.2) :
            CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (q.1 + s * q.2.1) := by
  rw [upperUnitriangularSubgroup_linearPacketAlgHom]
  rw [cyclotomicProjectiveLinePacketAlgHom_apply]
  rw [upperUnitriangularSubgroup_sum_coord]
  apply Finset.sum_congr rfl
  intro q _
  rcases q with ⟨a, b, c⟩
  rw [upperUnitriangularSubgroup_projectiveLine_finite_coord]
  rfl

/-- Helper for Exercise 13-13.1-17: the point-at-infinity Heisenberg linear packet in
coordinates. -/
private theorem upperUnitriangularSubgroup_linearPacketAlgHom_infty_coord
    (z : ℚ[upperUnitriangularSubgroup (ZMod p) 3]) :
    upperUnitriangularSubgroup_linearPacketAlgHom (p := p) z
        (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1)) =
      ∑ q : ZMod p × ZMod p × ZMod p,
        (z (upperUnitriangularSubgroupOfCoords (p := p) q.1 q.2.1 q.2.2) :
            CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) q.2.1 := by
  rw [upperUnitriangularSubgroup_linearPacketAlgHom]
  rw [cyclotomicProjectiveLinePacketAlgHom_apply]
  rw [upperUnitriangularSubgroup_sum_coord]
  apply Finset.sum_congr rfl
  intro q _
  rcases q with ⟨a, b, c⟩
  rw [upperUnitriangularSubgroup_projectiveLine_infty_coord]
  rfl

/-- Helper for Exercise 13-13.1-17: a selected Schrödinger matrix entry is the finite Fourier sum
on the plane with fixed first root coordinate. -/
private theorem upperUnitriangularSubgroup_schrodingerMatrixAlgHom_coord_entry
    (z : ℚ[upperUnitriangularSubgroup (ZMod p) 3]) (a r : ZMod p) :
    upperUnitriangularSubgroup_schrodingerMatrixAlgHom (p := p) z
        (zmodPIndex (p := p) r) (zmodPIndex (p := p) (r - a)) =
      ∑ q : ZMod p × ZMod p,
        (z (upperUnitriangularSubgroupOfCoords (p := p) a q.1 q.2) :
            CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (-q.2 + q.1 * r) := by
  rw [upperUnitriangularSubgroup_schrodingerMatrixAlgHom_apply_entry]
  rw [upperUnitriangularSubgroup_sum_coord]
  let e := upperUnitriangularSubgroupCoordEquiv (p := p)
  calc
    (∑ q : ZMod p × ZMod p × ZMod p,
        (z (e.symm q) : CyclotomicField p ℚ) *
          upperUnitriangularSubgroup_schrodingerMatrixMonoidHom (p := p) (e.symm q)
            (zmodPIndex (p := p) r) (zmodPIndex (p := p) (r - a)))
        = ∑ a' : ZMod p, ∑ q : ZMod p × ZMod p,
            (z (upperUnitriangularSubgroupOfCoords (p := p) a' q.1 q.2) :
                CyclotomicField p ℚ) *
              (if zmodPIndex (p := p) (r - a') = zmodPIndex (p := p) (r - a) then
                zmodP_cyclotomic_character_val (p := p) (-q.2 + q.1 * r)
              else 0) := by
          rw [Fintype.sum_prod_type]
          apply Finset.sum_congr rfl
          intro a' _
          apply Finset.sum_congr rfl
          intro q _
          rcases q with ⟨b, c⟩
          rw [upperUnitriangularSubgroup_schrodingerMatrixMonoidHom_entry]
          simp [e, upperUnitriangularSubgroupCoordEquiv,
            upperUnitriangularSubgroupOfCoords_coordA,
            upperUnitriangularSubgroupOfCoords_coordB,
            upperUnitriangularSubgroupOfCoords_coordC,
            zmodPIndex_natCast, mul_comm]
    _ = ∑ q : ZMod p × ZMod p,
        (z (upperUnitriangularSubgroupOfCoords (p := p) a q.1 q.2) :
            CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (-q.2 + q.1 * r) := by
          rw [Finset.sum_eq_single a]
          · simp
          · intro a' _ ha'
            have hidx_ne :
                zmodPIndex (p := p) (r - a') ≠ zmodPIndex (p := p) (r - a) := by
              intro hidx
              apply ha'
              have hdiff : r - a' = r - a := by
                have hcast := congrArg (fun k : Fin p => ((k : ℕ) : ZMod p)) hidx
                simpa [zmodPIndex_natCast] using hcast
              exact (sub_right_inj).1 hdiff
            simp [hidx_ne]
          · intro ha
            simp at ha

/-- Helper for Exercise 13-13.1-17: reduction from `Z / p² Z` to `Z / p Z`, viewed on the
additive groups written multiplicatively. -/
private def zmodP2ReductionHom :
    Multiplicative (ZMod (p ^ 2)) →* Multiplicative (ZMod p) :=
  AddMonoidHom.toMultiplicative
    ((ZMod.castHom
      (show p ∣ p ^ 2 by exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p)).toAddMonoidHom)

/-- Helper for Exercise 13-13.1-17: Serre's standard action-unit hom sends the generator of
`Z / p Z` to `1 + p`. -/
private theorem standardSemidirectRational_unitsHom_generator :
    standard_nonabelian_zmodP2_units_hom (p := p)
        (Multiplicative.ofAdd (1 : ZMod p)) =
      standard_nonabelian_zmodP2_unit (p := p) := by
  -- Unfold the additive lift once at the generator.
  dsimp [standard_nonabelian_zmodP2_units_hom]
  simpa using
    congrArg Additive.toMul
      (ZMod.lift_coe
        (n := p)
        (f := ⟨zmultiplesHom (Additive ((ZMod (p ^ 2))ˣ))
          (Additive.ofMul (standard_nonabelian_zmodP2_unit (p := p))),
          standard_nonabelian_zmodP2_unit_zmultiples_zero (p := p)⟩)
        (1 : ℤ))

/-- Helper for Exercise 13-13.1-17: the standard unit `1 + p` reduces to `1` modulo `p`. -/
private theorem standardSemidirectRational_reducedUnit_eq_one :
    ((ZMod.castHom
        (show p ∣ p ^ 2 by exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
        ((standard_nonabelian_zmodP2_unit (p := p) : (ZMod (p ^ 2))ˣ) :
          ZMod (p ^ 2))) =
      1 := by
  -- This is the elementary congruence `(1 + p) ≡ 1 mod p`.
  simp [standard_nonabelian_zmodP2_unit, ZMod.coe_unitOfCoprime]

/-- Helper for Exercise 13-13.1-17: every unit used by the standard `Z / p Z` action reduces to
`1` modulo `p`. -/
private theorem standardSemidirectRational_reducedUnitsHom_eq_one
    (x : Multiplicative (ZMod p)) :
    ((ZMod.castHom
        (show p ∣ p ^ 2 by exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
        ((standard_nonabelian_zmodP2_units_hom (p := p) x : (ZMod (p ^ 2))ˣ) :
          ZMod (p ^ 2))) =
      1 := by
  let g : Multiplicative (ZMod p) := Multiplicative.ofAdd (1 : ZMod p)
  have hpow :
      standard_nonabelian_zmodP2_units_hom (p := p) x =
        standard_nonabelian_zmodP2_units_hom (p := p) g ^ x.val := by
    have hxpow : g ^ x.val = Multiplicative.ofAdd x := by
      simpa [g, ZMod.natCast_val] using (ofAdd_one_pow_mod_p (p := p) x.val)
    calc
      standard_nonabelian_zmodP2_units_hom (p := p) x
          = standard_nonabelian_zmodP2_units_hom (p := p) (g ^ x.val) := by
              simpa using congrArg (standard_nonabelian_zmodP2_units_hom (p := p)) hxpow.symm
      _ = standard_nonabelian_zmodP2_units_hom (p := p) g ^ x.val := by
            rw [map_pow]
  have hgen :
      ((ZMod.castHom
          (show p ∣ p ^ 2 by exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
          ((standard_nonabelian_zmodP2_units_hom (p := p) g : (ZMod (p ^ 2))ˣ) :
            ZMod (p ^ 2))) =
        1 := by
    rw [standardSemidirectRational_unitsHom_generator (p := p)]
    exact standardSemidirectRational_reducedUnit_eq_one (p := p)
  rw [hpow]
  simpa [Units.val_pow_eq_pow_val, map_pow, hgen]

/-- Helper for Exercise 13-13.1-17: Serre's standard semidirect action is trivial after reducing
the normal `Z / p² Z` factor modulo `p`. -/
private theorem standardSemidirectRational_action_reduces
    (g : Multiplicative (ZMod p)) (x : Multiplicative (ZMod (p ^ 2))) :
    zmodP2ReductionHom (p := p) (standard_nonabelian_zmodP2_action (p := p) g x) =
      zmodP2ReductionHom (p := p) x := by
  ext
  -- In additive coordinates, the action is multiplication by a unit congruent to `1 mod p`.
  change ((ZMod.castHom
          (show p ∣ p ^ 2 by exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
        (((standard_nonabelian_zmodP2_units_hom (p := p) g : (ZMod (p ^ 2))ˣ) :
          ZMod (p ^ 2)) * x.toAdd)) =
      ((ZMod.castHom
          (show p ∣ p ^ 2 by exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
        x.toAdd)
  rw [map_mul, standardSemidirectRational_reducedUnitsHom_eq_one (p := p) g]
  simp

/-- Helper for Exercise 13-13.1-17: the reduced normal coordinate of Serre's standard semidirect
model, i.e. the `Z / p² Z` coordinate modulo `p`. -/
private def standardSemidirect_normalModPCoordinateHom :
    Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p) →* Multiplicative (ZMod p) where
  toFun g := zmodP2ReductionHom (p := p) g.left
  map_one' := by
    simp
  map_mul' x y := by
    -- The left coordinate multiplies with an acted-on second factor, which reduces trivially.
    rw [SemidirectProduct.mul_left]
    change zmodP2ReductionHom (p := p)
        (x.left * standard_nonabelian_zmodP2_action (p := p) x.right y.left) =
      zmodP2ReductionHom (p := p) x.left * zmodP2ReductionHom (p := p) y.left
    rw [map_mul, standardSemidirectRational_action_reduces (p := p)]

/-- Helper for Exercise 13-13.1-17: the acting `Z / p Z` coordinate of Serre's standard
semidirect model. -/
private def standardSemidirect_actingCoordinateHom :
    Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p) →* Multiplicative (ZMod p) where
  toFun g := g.right
  map_one' := by
    simp
  map_mul' x y := by
    rw [SemidirectProduct.mul_right]

/-- Helper for Exercise 13-13.1-17: the `p + 1` semidirect one-dimensional rational packet
factors coming from the projective line in the dual of its abelianization. -/
private noncomputable def standardSemidirect_linearPacketAlgHom :
    ℚ[Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p)] →ₐ[ℚ]
      (Fin (p + 1) → CyclotomicField p ℚ) :=
  cyclotomicProjectiveLinePacketAlgHom (p := p)
    (standardSemidirect_normalModPCoordinateHom (p := p))
    (standardSemidirect_actingCoordinateHom (p := p))

/-- Helper for Exercise 13-13.1-17: the semidirect trivial factor and the `p + 1`
one-dimensional cyclotomic factors, before adding the nonlinear matrix packet. -/
private noncomputable def standardSemidirect_trivialLinearPacketAlgHom :
    ℚ[Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p)] →ₐ[ℚ]
      ℚ × (Fin (p + 1) → CyclotomicField p ℚ) :=
  (rationalTrivialGroupAlgebraAlgHom :
      ℚ[Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
          Multiplicative (ZMod p)] →ₐ[ℚ] ℚ).prod
    (standardSemidirect_linearPacketAlgHom (p := p))

/-- Helper for Exercise 13-13.1-17: the primitive scalar used in the rational nonlinear
packet for the standard semidirect model. -/
private noncomputable def standardSemidirectRationalZeta : CyclotomicField p ℚ :=
  zmodP_cyclotomic_character_val (p := p) 1

/-- Helper for Exercise 13-13.1-17: the semidirect packet scalar is the same primitive
cyclotomic generator used by the one-dimensional packets. -/
private theorem standardSemidirectRationalZeta_eq_cyclotomic :
    standardSemidirectRationalZeta (p := p) =
      (cyclotomicZetaPUnit (p := p) : CyclotomicField p ℚ) := by
  simpa [standardSemidirectRationalZeta] using zmodP_cyclotomic_character_val_one (p := p)

/-- Helper for Exercise 13-13.1-17: the semidirect packet scalar is primitive. -/
private theorem standardSemidirectRationalZeta_isPrimitiveRoot :
    IsPrimitiveRoot (standardSemidirectRationalZeta (p := p)) p := by
  rw [standardSemidirectRationalZeta_eq_cyclotomic]
  exact cyclotomicZetaPUnit_isPrimitiveRoot (p := p)

/-- Helper for Exercise 13-13.1-17: the scalar in the rational semidirect companion matrix has
`p`-th power `1`. -/
private theorem standardSemidirectRationalZeta_pow :
    standardSemidirectRationalZeta (p := p) ^ p = 1 := by
  have hsrc : (Multiplicative.ofAdd (1 : ZMod p)) ^ p = 1 := by
    rw [ofAdd_one_pow_mod_p (p := p) p, ZMod.natCast_self]
    rfl
  have hunit :
      (zmodP_cyclotomic_character (p := p) (Multiplicative.ofAdd (1 : ZMod p))) ^ p = 1 := by
    rw [← map_pow, hsrc]
    simp
  simpa [standardSemidirectRationalZeta, zmodP_cyclotomic_character_val,
    Units.val_pow_eq_pow_val] using
    congrArg (fun u : (CyclotomicField p ℚ)ˣ => (u : CyclotomicField p ℚ)) hunit

/-- Helper for Exercise 13-13.1-17: the `p`-dimensional `Q(p)`-space for the nonlinear standard
semidirect packet. -/
private abbrev standardSemidirectRationalSpace :=
  Fin p → CyclotomicField p ℚ

/-- Helper for Exercise 13-13.1-17: the standard basis for the nonlinear standard semidirect
packet. -/
private noncomputable def standardSemidirectRationalBasis :
    Module.Basis (Fin p) (CyclotomicField p ℚ) (standardSemidirectRationalSpace (p := p)) :=
  Pi.basisFun (CyclotomicField p ℚ) (Fin p)

/-- Helper for Exercise 13-13.1-17: the companion shift for the normal generator of
`Z / p² Z`; its wrap-around scalar is the chosen primitive `p`-th root. -/
private noncomputable def standardSemidirectRationalCompanionShift :
    Module.End (CyclotomicField p ℚ) (standardSemidirectRationalSpace (p := p)) :=
  (standardSemidirectRationalBasis (p := p)).constr (CyclotomicField p ℚ) fun i =>
    if h : i.1 + 1 < p then
      (standardSemidirectRationalBasis (p := p)) ⟨i.1 + 1, h⟩
    else
      standardSemidirectRationalZeta (p := p) • (standardSemidirectRationalBasis (p := p)) 0

/-- Helper for Exercise 13-13.1-17: the diagonal clock operator for the acting generator of
`Z / p Z`. -/
private noncomputable def standardSemidirectRationalClock :
    Module.End (CyclotomicField p ℚ) (standardSemidirectRationalSpace (p := p)) :=
  (standardSemidirectRationalBasis (p := p)).constr (CyclotomicField p ℚ) fun i =>
    (standardSemidirectRationalZeta (p := p) ^ i.1) •
      (standardSemidirectRationalBasis (p := p)) i

/-- Helper for Exercise 13-13.1-17: the companion shift on basis vectors. -/
private theorem standardSemidirectRationalCompanionShift_basis (i : Fin p) :
    standardSemidirectRationalCompanionShift (p := p)
        ((standardSemidirectRationalBasis (p := p)) i) =
      if h : i.1 + 1 < p then
        (standardSemidirectRationalBasis (p := p)) ⟨i.1 + 1, h⟩
      else
        standardSemidirectRationalZeta (p := p) •
          (standardSemidirectRationalBasis (p := p)) 0 := by
  rw [standardSemidirectRationalCompanionShift]
  exact (standardSemidirectRationalBasis (p := p)).constr_basis (CyclotomicField p ℚ) _ i

/-- Helper for Exercise 13-13.1-17: the companion-shift generator is a cyclic shift matrix with
the primitive scalar in the wrap-around entry. -/
private theorem standardSemidirectRationalCompanionShift_matrix_entry (i j : Fin p) :
    (LinearMap.toMatrixAlgEquiv (standardSemidirectRationalBasis (p := p))
        (standardSemidirectRationalCompanionShift (p := p))) i j =
      if h : j.1 + 1 < p then
        if i = (⟨j.1 + 1, h⟩ : Fin p) then 1 else 0
      else
        if i = 0 then standardSemidirectRationalZeta (p := p) else 0 := by
  -- Read the column indexed by `j` from the basis action: a normal shift, except that the last
  -- basis vector wraps to the first with scalar `ζ`.
  rw [LinearMap.toMatrixAlgEquiv_apply, standardSemidirectRationalCompanionShift_basis]
  by_cases hstep : j.1 + 1 < p
  · rw [dif_pos hstep]
    by_cases hij : i = (⟨j.1 + 1, hstep⟩ : Fin p)
    · rw [hij]
      simp [standardSemidirectRationalBasis, hstep]
    · simp [standardSemidirectRationalBasis, hstep, hij]
  · rw [dif_neg hstep]
    by_cases hi0 : i = 0
    · rw [hi0]
      simp [standardSemidirectRationalBasis, hstep]
    · simp [standardSemidirectRationalBasis, hstep, hi0]

/-- Helper for Exercise 13-13.1-17: powers of the companion shift before the first full wrap. -/
private theorem standardSemidirectRationalCompanionShift_pow_basis_aux
    (n : ℕ) (hn : n ≤ p) (i : Fin p) :
    (standardSemidirectRationalCompanionShift (p := p) ^ n)
        ((standardSemidirectRationalBasis (p := p)) i) =
      if h : i.1 + n < p then
        (standardSemidirectRationalBasis (p := p)) ⟨i.1 + n, h⟩
      else
        standardSemidirectRationalZeta (p := p) •
          (standardSemidirectRationalBasis (p := p)) ⟨i.1 + n - p, by omega⟩ := by
  induction n with
  | zero =>
      simp
  | succ n ih =>
      have hn_le : n ≤ p := Nat.le_of_succ_le hn
      rw [pow_succ', Module.End.mul_apply, ih hn_le]
      by_cases hprev : i.1 + n < p
      · rw [dif_pos hprev, standardSemidirectRationalCompanionShift_basis]
        have hval_prev : (⟨i.1 + n, hprev⟩ : Fin p).1 = i.1 + n := rfl
        split_ifs
        · simp [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm]
        · omega
        · omega
        · have hzero : i.1 + (n + 1) - p = 0 := by omega
          simp [hzero]
      · rw [dif_neg hprev]
        simp only [map_smul]
        rw [standardSemidirectRationalCompanionShift_basis]
        have hval_prev : (⟨i.1 + n - p, by omega⟩ : Fin p).1 = i.1 + n - p := rfl
        split_ifs
        · omega
        · have hidx :
              (⟨i.1 + n - p, by omega⟩ : Fin p).1 + 1 = i.1 + (n + 1) - p := by
            omega
          simp [hidx]
        · omega
        · omega

/-- Helper for Exercise 13-13.1-17: applying the companion shift `p` times gives the central
cyclotomic scalar. -/
private theorem standardSemidirectRationalCompanionShift_pow_p_basis (i : Fin p) :
    (standardSemidirectRationalCompanionShift (p := p) ^ p)
        ((standardSemidirectRationalBasis (p := p)) i) =
      standardSemidirectRationalZeta (p := p) •
        (standardSemidirectRationalBasis (p := p)) i := by
  rw [standardSemidirectRationalCompanionShift_pow_basis_aux (p := p) p (le_rfl) i]
  have hnot : ¬ i.1 + p < p := by omega
  have hsub : i.1 + p - p = i.1 := by omega
  simp [hnot, hsub]

/-- Helper for Exercise 13-13.1-17: the `p`-th power of the normal companion shift is the
central cyclotomic scalar. -/
private theorem standardSemidirectRationalCompanionShift_pow_p :
    standardSemidirectRationalCompanionShift (p := p) ^ p =
      standardSemidirectRationalZeta (p := p) •
        (1 : Module.End (CyclotomicField p ℚ) (standardSemidirectRationalSpace (p := p))) := by
  apply (standardSemidirectRationalBasis (p := p)).ext
  intro i
  rw [standardSemidirectRationalCompanionShift_pow_p_basis]
  simp

/-- Helper for Exercise 13-13.1-17: the companion shift has order dividing `p²`, as required for
the normal `Z / p² Z` generator. -/
private theorem standardSemidirectRationalCompanionShift_pow_p_sq :
    standardSemidirectRationalCompanionShift (p := p) ^ (p ^ 2) = 1 := by
  rw [pow_two]
  rw [pow_mul]
  rw [standardSemidirectRationalCompanionShift_pow_p (p := p)]
  rw [← Algebra.algebraMap_eq_smul_one
    (A := Module.End (CyclotomicField p ℚ) (standardSemidirectRationalSpace (p := p)))
    (standardSemidirectRationalZeta (p := p))]
  rw [← map_pow, standardSemidirectRationalZeta_pow (p := p), map_one]

/-- Helper for Exercise 13-13.1-17: the clock operator on basis vectors. -/
private theorem standardSemidirectRationalClock_basis (i : Fin p) :
    standardSemidirectRationalClock (p := p) ((standardSemidirectRationalBasis (p := p)) i) =
      (standardSemidirectRationalZeta (p := p) ^ i.1) •
        (standardSemidirectRationalBasis (p := p)) i := by
  rw [standardSemidirectRationalClock]
  exact (standardSemidirectRationalBasis (p := p)).constr_basis (CyclotomicField p ℚ) _ i

/-- Helper for Exercise 13-13.1-17: the clock generator is diagonal in the standard basis of the
nonlinear semidirect packet. -/
private theorem standardSemidirectRationalClock_matrix_entry (i j : Fin p) :
    (LinearMap.toMatrixAlgEquiv (standardSemidirectRationalBasis (p := p))
        (standardSemidirectRationalClock (p := p))) i j =
      if i = j then standardSemidirectRationalZeta (p := p) ^ j.1 else 0 := by
  -- The clock operator scales the `j`-th basis vector, so the only nonzero matrix entry in column
  -- `j` is the diagonal one.
  rw [LinearMap.toMatrixAlgEquiv_apply, standardSemidirectRationalClock_basis]
  by_cases hij : i = j
  · rw [if_pos hij, hij]
    simp [standardSemidirectRationalBasis]
  · rw [if_neg hij]
    simp [standardSemidirectRationalBasis, hij]

/-- Helper for Exercise 13-13.1-17: powers of the clock operator on basis vectors. -/
private theorem standardSemidirectRationalClock_pow_basis (n : ℕ) (i : Fin p) :
    (standardSemidirectRationalClock (p := p) ^ n)
        ((standardSemidirectRationalBasis (p := p)) i) =
      (standardSemidirectRationalZeta (p := p) ^ (n * i.1)) •
        (standardSemidirectRationalBasis (p := p)) i := by
  induction n with
  | zero =>
      simp
  | succ n ih =>
      rw [pow_succ', Module.End.mul_apply, ih]
      simp only [map_smul]
      rw [standardSemidirectRationalClock_basis]
      rw [smul_smul]
      congr 1
      rw [← pow_add]
      congr 1
      ring

/-- Helper for Exercise 13-13.1-17: the clock operator has order dividing `p`. -/
private theorem standardSemidirectRationalClock_pow_p :
    standardSemidirectRationalClock (p := p) ^ p = 1 := by
  apply (standardSemidirectRationalBasis (p := p)).ext
  intro i
  rw [standardSemidirectRationalClock_pow_basis]
  have hpowmul := pow_mul (standardSemidirectRationalZeta (p := p)) p i.1
  have hpow : standardSemidirectRationalZeta (p := p) ^ (p * i.1) = 1 := by
    rw [hpowmul, standardSemidirectRationalZeta_pow (p := p)]
    simp
  simp [hpow]

/-- Helper for Exercise 13-13.1-17: on basis vectors, the clock conjugates the companion shift by
the scalar prescribed by the `1 + p` action. -/
private theorem standardSemidirectRationalClock_companionShift_basis (i : Fin p) :
    (standardSemidirectRationalClock (p := p) *
        standardSemidirectRationalCompanionShift (p := p))
        ((standardSemidirectRationalBasis (p := p)) i) =
      standardSemidirectRationalZeta (p := p) •
        ((standardSemidirectRationalCompanionShift (p := p) *
            standardSemidirectRationalClock (p := p))
          ((standardSemidirectRationalBasis (p := p)) i)) := by
  rw [Module.End.mul_apply, Module.End.mul_apply]
  rw [standardSemidirectRationalCompanionShift_basis (p := p)]
  by_cases h : i.1 + 1 < p
  · simp [h, standardSemidirectRationalClock_basis,
      standardSemidirectRationalCompanionShift_basis, pow_succ, smul_smul, mul_comm]
  · have hi : i.1 + 1 = p := by omega
    rw [dif_neg h]
    simp only [map_smul]
    rw [standardSemidirectRationalClock_basis, standardSemidirectRationalClock_basis]
    simp only [map_smul]
    rw [standardSemidirectRationalCompanionShift_basis]
    simp [h, smul_smul, mul_comm]
    have hinner :
        standardSemidirectRationalZeta (p := p) *
          standardSemidirectRationalZeta (p := p) ^ i.1 =
        standardSemidirectRationalZeta (p := p) ^ p := by
      rw [mul_comm, ← pow_succ, hi]
    rw [hinner, standardSemidirectRationalZeta_pow (p := p), mul_one]

/-- Helper for Exercise 13-13.1-17: the clock-shift relation as an endomorphism identity. This is
the generator-level compatibility behind the nonlinear standard semidirect packet. -/
private theorem standardSemidirectRationalClock_companionShift :
    standardSemidirectRationalClock (p := p) *
        standardSemidirectRationalCompanionShift (p := p) =
      standardSemidirectRationalZeta (p := p) •
        (standardSemidirectRationalCompanionShift (p := p) *
          standardSemidirectRationalClock (p := p)) := by
  apply (standardSemidirectRationalBasis (p := p)).ext
  intro i
  exact standardSemidirectRationalClock_companionShift_basis (p := p) i

/-- Helper for Exercise 13-13.1-17: the endomorphism algebra used by the rational nonlinear
standard semidirect packet. -/
private abbrev standardSemidirectRationalEnd :=
  Module.End (CyclotomicField p ℚ) (standardSemidirectRationalSpace (p := p))

/-- Helper for Exercise 13-13.1-17: the normal generator as a unit of the rational nonlinear
endomorphism algebra. -/
private noncomputable def standardSemidirectRationalCompanionShiftUnit :
    (standardSemidirectRationalEnd (p := p))ˣ :=
  Units.ofPowEqOne (standardSemidirectRationalCompanionShift (p := p)) (p ^ 2)
    (standardSemidirectRationalCompanionShift_pow_p_sq (p := p))
    (pow_ne_zero 2 (Fact.out : Nat.Prime p).ne_zero)

/-- Helper for Exercise 13-13.1-17: the acting generator as a unit of the rational nonlinear
endomorphism algebra. -/
private noncomputable def standardSemidirectRationalClockUnit :
    (standardSemidirectRationalEnd (p := p))ˣ :=
  Units.ofPowEqOne (standardSemidirectRationalClock (p := p)) p
    (standardSemidirectRationalClock_pow_p (p := p))
    (Fact.out : Nat.Prime p).ne_zero

/-- Helper for Exercise 13-13.1-17: coercing the normal-generator unit recovers the companion
shift. -/
private theorem standardSemidirectRationalCompanionShiftUnit_coe :
    ((standardSemidirectRationalCompanionShiftUnit (p := p) :
        (standardSemidirectRationalEnd (p := p))ˣ) : standardSemidirectRationalEnd (p := p)) =
      standardSemidirectRationalCompanionShift (p := p) := by
  rfl

/-- Helper for Exercise 13-13.1-17: coercing the acting-generator unit recovers the clock. -/
private theorem standardSemidirectRationalClockUnit_coe :
    ((standardSemidirectRationalClockUnit (p := p) :
        (standardSemidirectRationalEnd (p := p))ˣ) : standardSemidirectRationalEnd (p := p)) =
      standardSemidirectRationalClock (p := p) := by
  rfl

/-- Helper for Exercise 13-13.1-17: the normal-generator unit has order dividing `p²`. -/
private theorem standardSemidirectRationalCompanionShiftUnit_pow :
    standardSemidirectRationalCompanionShiftUnit (p := p) ^ (p ^ 2) = 1 := by
  apply Units.ext
  simpa [standardSemidirectRationalCompanionShiftUnit_coe (p := p)] using
    standardSemidirectRationalCompanionShift_pow_p_sq (p := p)

/-- Helper for Exercise 13-13.1-17: the acting-generator unit has order dividing `p`. -/
private theorem standardSemidirectRationalClockUnit_pow :
    standardSemidirectRationalClockUnit (p := p) ^ p = 1 := by
  apply Units.ext
  simpa [standardSemidirectRationalClockUnit_coe (p := p)] using
    standardSemidirectRationalClock_pow_p (p := p)

/-- Helper for Exercise 13-13.1-17: the normal rational companion unit kills `p²` in the lifted
additive presentation of `Z / p² Z`. -/
private theorem standardSemidirectRationalCompanionShiftUnit_zmultiples_zero :
    zmultiplesHom (Additive (standardSemidirectRationalEnd (p := p))ˣ)
        (Additive.ofMul (standardSemidirectRationalCompanionShiftUnit (p := p))) (p ^ 2) = 0 := by
  change standardSemidirectRationalCompanionShiftUnit (p := p) ^ (p ^ 2) = 1
  exact standardSemidirectRationalCompanionShiftUnit_pow (p := p)

/-- Helper for Exercise 13-13.1-17: the acting rational clock unit kills `p` in the lifted
additive presentation of `Z / p Z`. -/
private theorem standardSemidirectRationalClockUnit_zmultiples_zero :
    zmultiplesHom (Additive (standardSemidirectRationalEnd (p := p))ˣ)
        (Additive.ofMul (standardSemidirectRationalClockUnit (p := p))) p = 0 := by
  change standardSemidirectRationalClockUnit (p := p) ^ p = 1
  exact standardSemidirectRationalClockUnit_pow (p := p)

/-- Helper for Exercise 13-13.1-17: the normal `Z / p² Z` coordinate in the rational nonlinear
standard semidirect packet. -/
private noncomputable def standardSemidirectRationalNormalHom :
    Multiplicative (ZMod (p ^ 2)) →* (standardSemidirectRationalEnd (p := p))ˣ :=
  AddMonoidHom.toMultiplicativeLeft <|
    ZMod.lift (p ^ 2)
      ⟨zmultiplesHom (Additive (standardSemidirectRationalEnd (p := p))ˣ)
          (Additive.ofMul (standardSemidirectRationalCompanionShiftUnit (p := p))),
        standardSemidirectRationalCompanionShiftUnit_zmultiples_zero (p := p)⟩

/-- Helper for Exercise 13-13.1-17: the acting `Z / p Z` coordinate in the rational nonlinear
standard semidirect packet. -/
private noncomputable def standardSemidirectRationalActingHom :
    Multiplicative (ZMod p) →* (standardSemidirectRationalEnd (p := p))ˣ :=
  AddMonoidHom.toMultiplicativeLeft <|
    ZMod.lift p
      ⟨zmultiplesHom (Additive (standardSemidirectRationalEnd (p := p))ˣ)
          (Additive.ofMul (standardSemidirectRationalClockUnit (p := p))),
        standardSemidirectRationalClockUnit_zmultiples_zero (p := p)⟩

/-- Helper for Exercise 13-13.1-17: the normal cyclic hom sends the additive generator to the
companion shift unit. -/
private theorem standardSemidirectRationalNormalHom_generator :
    standardSemidirectRationalNormalHom (p := p)
        (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) =
      standardSemidirectRationalCompanionShiftUnit (p := p) := by
  dsimp [standardSemidirectRationalNormalHom]
  simpa using
    congrArg Additive.toMul
      (ZMod.lift_coe
        (n := p ^ 2)
        (f := ⟨zmultiplesHom (Additive (standardSemidirectRationalEnd (p := p))ˣ)
          (Additive.ofMul (standardSemidirectRationalCompanionShiftUnit (p := p))),
          standardSemidirectRationalCompanionShiftUnit_zmultiples_zero (p := p)⟩)
        (1 : ℤ))

/-- Helper for Exercise 13-13.1-17: the acting cyclic hom sends the additive generator to the
clock unit. -/
private theorem standardSemidirectRationalActingHom_generator :
    standardSemidirectRationalActingHom (p := p)
        (Multiplicative.ofAdd (1 : ZMod p)) =
      standardSemidirectRationalClockUnit (p := p) := by
  dsimp [standardSemidirectRationalActingHom]
  simpa using
    congrArg Additive.toMul
      (ZMod.lift_coe
        (n := p)
        (f := ⟨zmultiplesHom (Additive (standardSemidirectRationalEnd (p := p))ˣ)
          (Additive.ofMul (standardSemidirectRationalClockUnit (p := p))),
          standardSemidirectRationalClockUnit_zmultiples_zero (p := p)⟩)
        (1 : ℤ))

/-- Helper for Exercise 13-13.1-17: the rational nonlinear generator relation lifted to units. -/
private theorem standardSemidirectRationalUnit_generatorCompatibility :
    standardSemidirectRationalClockUnit (p := p) *
        standardSemidirectRationalCompanionShiftUnit (p := p) =
      standardSemidirectRationalCompanionShiftUnit (p := p) ^ (p + 1) *
        standardSemidirectRationalClockUnit (p := p) := by
  apply Units.ext
  simp only [Units.val_mul, Units.val_pow_eq_pow_val,
    standardSemidirectRationalCompanionShiftUnit_coe,
    standardSemidirectRationalClockUnit_coe]
  rw [pow_succ, standardSemidirectRationalCompanionShift_pow_p (p := p)]
  rw [Algebra.smul_mul_assoc]
  exact standardSemidirectRationalClock_companionShift (p := p)

/-- Helper for Exercise 13-13.1-17: conjugating the normal rational generator by the acting
rational generator implements Serre's `1 + p` action. -/
private theorem standardSemidirectRationalUnit_generator_conj :
    (MulAut.conj (standardSemidirectRationalClockUnit (p := p)))
        (standardSemidirectRationalCompanionShiftUnit (p := p)) =
      standardSemidirectRationalCompanionShiftUnit (p := p) ^ (p + 1) := by
  apply_fun (fun u : (standardSemidirectRationalEnd (p := p))ˣ =>
      u * standardSemidirectRationalClockUnit (p := p))
  · simpa [MulAut.conj_apply] using standardSemidirectRationalUnit_generatorCompatibility (p := p)
  · intro x y hxy
    exact mul_right_cancel hxy

/-- Helper for Exercise 13-13.1-17: the normal additive generator generates `Z / p² Z`,
viewed multiplicatively. -/
private theorem standardSemidirectRational_zmodP2_mem_zpowers_one
    (x : Multiplicative (ZMod (p ^ 2))) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) := by
  refine Subgroup.mem_zpowers_iff.mpr ⟨(x.toAdd.val : ℤ), ?_⟩
  rw [zpow_natCast]
  calc
    (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ x.toAdd.val
        = Multiplicative.ofAdd ((x.toAdd.val : ℕ) : ZMod (p ^ 2)) := by
            rw [ofAdd_one_pow (p := p)]
    _ = Multiplicative.ofAdd x.toAdd := by
          rw [ZMod.natCast_zmod_val]
    _ = x := by
          simp

/-- Helper for Exercise 13-13.1-17: the standard action sends the normal generator to its
`(p + 1)`-st power. -/
private theorem standardSemidirectRational_action_generator :
    standard_nonabelian_zmodP2_action (p := p)
        (Multiplicative.ofAdd (1 : ZMod p))
        (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) =
      (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ (p + 1) := by
  change Multiplicative.ofAdd
        (((standard_nonabelian_zmodP2_units_hom (p := p)
            (Multiplicative.ofAdd (1 : ZMod p)) : (ZMod (p ^ 2))ˣ) : ZMod (p ^ 2)) *
          (1 : ZMod (p ^ 2))) =
      (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ (p + 1)
  rw [standardSemidirectRational_unitsHom_generator (p := p)]
  simp [standard_nonabelian_zmodP2_unit, ZMod.coe_unitOfCoprime, ofAdd_one_pow, Nat.cast_add,
    Nat.cast_one]

/-- Helper for Exercise 13-13.1-17: powers of the acting generator act on the normal generator by
the corresponding powers of Serre's unit `1 + p`. -/
private theorem standardSemidirectRational_action_generator_pow
    (n : ℕ) :
    standard_nonabelian_zmodP2_action (p := p)
        ((Multiplicative.ofAdd (1 : ZMod p)) ^ n)
        (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) =
      (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ ((p + 1) ^ n) := by
  change Multiplicative.ofAdd
        (((standard_nonabelian_zmodP2_units_hom (p := p)
            ((Multiplicative.ofAdd (1 : ZMod p)) ^ n) : (ZMod (p ^ 2))ˣ) :
            ZMod (p ^ 2)) *
          (1 : ZMod (p ^ 2))) =
      (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ ((p + 1) ^ n)
  rw [map_pow, standardSemidirectRational_unitsHom_generator (p := p)]
  simp [standard_nonabelian_zmodP2_unit, ZMod.coe_unitOfCoprime, ofAdd_one_pow, Nat.cast_add,
    Nat.cast_one, Units.val_pow_eq_pow_val]

/-- Helper for Exercise 13-13.1-17: the rational generator relation as a semiconjugation
statement. -/
private theorem standardSemidirectRationalUnit_semiconj_generator :
    SemiconjBy (standardSemidirectRationalClockUnit (p := p))
      (standardSemidirectRationalCompanionShiftUnit (p := p))
      (standardSemidirectRationalCompanionShiftUnit (p := p) ^ (p + 1)) := by
  unfold SemiconjBy
  exact standardSemidirectRationalUnit_generatorCompatibility (p := p)

/-- Helper for Exercise 13-13.1-17: iterated conjugation by the rational acting generator sends
`U` to the same powers as Serre's standard `1 + p` action. -/
private theorem standardSemidirectRationalUnit_semiconj_pow
    (n : ℕ) :
    SemiconjBy (standardSemidirectRationalClockUnit (p := p) ^ n)
      (standardSemidirectRationalCompanionShiftUnit (p := p))
      (standardSemidirectRationalCompanionShiftUnit (p := p) ^ ((p + 1) ^ n)) := by
  induction n with
  | zero =>
      simpa using
        (SemiconjBy.one_left (standardSemidirectRationalCompanionShiftUnit (p := p)))
  | succ n ih =>
      have hstep :
          SemiconjBy (standardSemidirectRationalClockUnit (p := p))
            (standardSemidirectRationalCompanionShiftUnit (p := p) ^ ((p + 1) ^ n))
            ((standardSemidirectRationalCompanionShiftUnit (p := p) ^ (p + 1)) ^
              ((p + 1) ^ n)) :=
        (standardSemidirectRationalUnit_semiconj_generator (p := p)).pow_right
          ((p + 1) ^ n)
      simpa [pow_succ', pow_mul, Nat.pow_succ'] using hstep.mul_left ih

/-- Helper for Exercise 13-13.1-17: the rational conjugation formula for powers of the acting
generator. -/
private theorem standardSemidirectRationalUnit_conj_pow
    (n : ℕ) :
    (MulAut.conj (standardSemidirectRationalClockUnit (p := p) ^ n))
        (standardSemidirectRationalCompanionShiftUnit (p := p)) =
      standardSemidirectRationalCompanionShiftUnit (p := p) ^ ((p + 1) ^ n) := by
  have hsemiconj := standardSemidirectRationalUnit_semiconj_pow (p := p) n
  rw [MulAut.conj_apply, hsemiconj.eq, mul_assoc, mul_inv_cancel, mul_one]

/-- Helper for Exercise 13-13.1-17: the rational nonlinear homs satisfy the semidirect-product
compatibility for Serre's standard action. -/
private theorem standardSemidirectRational_semidirectCompatibility
    (g : Multiplicative (ZMod p)) :
    (standardSemidirectRationalNormalHom (p := p)).comp
        ((standard_nonabelian_zmodP2_action (p := p) g).toMonoidHom) =
      ((MulAut.conj (standardSemidirectRationalActingHom (p := p) g)).toMonoidHom).comp
        (standardSemidirectRationalNormalHom (p := p)) := by
  apply (MonoidHom.eq_iff_eq_on_generator
      (standardSemidirectRational_zmodP2_mem_zpowers_one (p := p)) _ _).2
  let a : Multiplicative (ZMod (p ^ 2)) := Multiplicative.ofAdd (1 : ZMod (p ^ 2))
  let b : Multiplicative (ZMod p) := Multiplicative.ofAdd (1 : ZMod p)
  have hgpow : b ^ g.toAdd.val = g := by
    calc
      b ^ g.toAdd.val = Multiplicative.ofAdd ((g.toAdd.val : ℕ) : ZMod p) := by
        simpa [b] using ofAdd_one_pow_mod_p (p := p) g.toAdd.val
      _ = Multiplicative.ofAdd g.toAdd := by
        rw [ZMod.natCast_zmod_val]
      _ = g := by
        simp
  rw [← hgpow]
  calc
    (standardSemidirectRationalNormalHom (p := p))
        (standard_nonabelian_zmodP2_action (p := p) (b ^ g.toAdd.val) a)
        = (standardSemidirectRationalNormalHom (p := p))
            (a ^ ((p + 1) ^ g.toAdd.val)) := by
              rw [standardSemidirectRational_action_generator_pow (p := p)]
    _ = standardSemidirectRationalCompanionShiftUnit (p := p) ^ ((p + 1) ^ g.toAdd.val) := by
          rw [map_pow, standardSemidirectRationalNormalHom_generator (p := p)]
    _ = (MulAut.conj (standardSemidirectRationalClockUnit (p := p) ^ g.toAdd.val))
          (standardSemidirectRationalCompanionShiftUnit (p := p)) := by
          rw [standardSemidirectRationalUnit_conj_pow (p := p)]
    _ = (MulAut.conj (standardSemidirectRationalActingHom (p := p) (b ^ g.toAdd.val)))
          ((standardSemidirectRationalNormalHom (p := p)) a) := by
          have hact :
              standardSemidirectRationalActingHom (p := p) (b ^ g.toAdd.val) =
                standardSemidirectRationalClockUnit (p := p) ^ g.toAdd.val := by
            rw [map_pow]
            exact congrArg (fun u => u ^ g.toAdd.val)
              (standardSemidirectRationalActingHom_generator (p := p))
          have hnorm :
              (standardSemidirectRationalNormalHom (p := p)) a =
                standardSemidirectRationalCompanionShiftUnit (p := p) := by
            simpa [a] using standardSemidirectRationalNormalHom_generator (p := p)
          rw [hact, hnorm]

/-- Helper for Exercise 13-13.1-17: the rational nonlinear representation of Serre's standard
semidirect product by units of the `p`-dimensional cyclotomic endomorphism algebra. -/
private noncomputable def standardSemidirectRationalUnitHom :
    Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p) →* (standardSemidirectRationalEnd (p := p))ˣ :=
  SemidirectProduct.lift
    (standardSemidirectRationalNormalHom (p := p))
    (standardSemidirectRationalActingHom (p := p))
    (standardSemidirectRational_semidirectCompatibility (p := p))

/-- Helper for Exercise 13-13.1-17: the rational nonlinear representation, viewed in the
endomorphism algebra. -/
private noncomputable def standardSemidirectRationalMonoidHom :
    Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p) →* standardSemidirectRationalEnd (p := p) :=
  (Units.coeHom (standardSemidirectRationalEnd (p := p))).comp
    (standardSemidirectRationalUnitHom (p := p))

/-- Helper for Exercise 13-13.1-17: the rational nonlinear standard semidirect packet as a
matrix-valued representation. -/
private noncomputable def standardSemidirectRationalMatrixMonoidHom :
    Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p) →*
      Matrix (Fin p) (Fin p) (CyclotomicField p ℚ) where
  toFun g :=
    (LinearMap.toMatrixAlgEquiv (standardSemidirectRationalBasis (p := p)))
      (standardSemidirectRationalMonoidHom (p := p) g)
  map_one' := by
    simp [standardSemidirectRationalBasis]
  map_mul' x y := by
    simp [map_mul]

/-- Helper for Exercise 13-13.1-17: the rational nonlinear standard semidirect matrix packet on
the group algebra. -/
private noncomputable def standardSemidirectRationalMatrixAlgHom :
    ℚ[Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p)] →ₐ[ℚ]
      Matrix (Fin p) (Fin p) (CyclotomicField p ℚ) :=
  MonoidAlgebra.lift ℚ
    (Matrix (Fin p) (Fin p) (CyclotomicField p ℚ))
    (Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
      Multiplicative (ZMod p))
    (standardSemidirectRationalMatrixMonoidHom (p := p))

/-- Helper for Exercise 13-13.1-17: the nonlinear semidirect packet sends the
normal generator to the rational companion shift. -/
private theorem standardSemidirectRationalMonoidHom_inl_one :
    standardSemidirectRationalMonoidHom (p := p)
        (SemidirectProduct.inl (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (1 : ZMod (p ^ 2)))) =
      standardSemidirectRationalCompanionShift (p := p) := by
  change ((standardSemidirectRationalUnitHom (p := p)
        (SemidirectProduct.inl (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (1 : ZMod (p ^ 2)))) :
      (standardSemidirectRationalEnd (p := p))ˣ) :
        standardSemidirectRationalEnd (p := p)) =
    standardSemidirectRationalCompanionShift (p := p)
  rw [standardSemidirectRationalUnitHom, SemidirectProduct.lift_inl,
    standardSemidirectRationalNormalHom_generator]
  rfl

/-- Helper for Exercise 13-13.1-17: the nonlinear semidirect packet sends the
acting generator to the rational clock operator. -/
private theorem standardSemidirectRationalMonoidHom_inr_one :
    standardSemidirectRationalMonoidHom (p := p)
        (SemidirectProduct.inr (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (1 : ZMod p))) =
      standardSemidirectRationalClock (p := p) := by
  change ((standardSemidirectRationalUnitHom (p := p)
        (SemidirectProduct.inr (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (1 : ZMod p))) :
      (standardSemidirectRationalEnd (p := p))ˣ) :
        standardSemidirectRationalEnd (p := p)) =
    standardSemidirectRationalClock (p := p)
  rw [standardSemidirectRationalUnitHom, SemidirectProduct.lift_inr,
    standardSemidirectRationalActingHom_generator]
  rfl

/-- Helper for Exercise 13-13.1-17: the matrix entries of the nonlinear semidirect packet on
the normal generator. -/
private theorem standardSemidirectRationalMatrixMonoidHom_inl_one_entry (i j : Fin p) :
    standardSemidirectRationalMatrixMonoidHom (p := p)
        (SemidirectProduct.inl (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (1 : ZMod (p ^ 2)))) i j =
      if h : j.1 + 1 < p then
        if i = (⟨j.1 + 1, h⟩ : Fin p) then 1 else 0
      else
        if i = 0 then standardSemidirectRationalZeta (p := p) else 0 := by
  rw [standardSemidirectRationalMatrixMonoidHom]
  change (LinearMap.toMatrixAlgEquiv (standardSemidirectRationalBasis (p := p))
      (standardSemidirectRationalMonoidHom (p := p)
        (SemidirectProduct.inl (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (1 : ZMod (p ^ 2)))))) i j = _
  rw [standardSemidirectRationalMonoidHom_inl_one,
    standardSemidirectRationalCompanionShift_matrix_entry]

/-- Helper for Exercise 13-13.1-17: the matrix entries of the nonlinear semidirect packet on
the acting generator. -/
private theorem standardSemidirectRationalMatrixMonoidHom_inr_one_entry (i j : Fin p) :
    standardSemidirectRationalMatrixMonoidHom (p := p)
        (SemidirectProduct.inr (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (1 : ZMod p))) i j =
      if i = j then standardSemidirectRationalZeta (p := p) ^ j.1 else 0 := by
  rw [standardSemidirectRationalMatrixMonoidHom]
  change (LinearMap.toMatrixAlgEquiv (standardSemidirectRationalBasis (p := p))
      (standardSemidirectRationalMonoidHom (p := p)
        (SemidirectProduct.inr (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (1 : ZMod p))))) i j = _
  rw [standardSemidirectRationalMonoidHom_inr_one,
    standardSemidirectRationalClock_matrix_entry]

/-- Helper for Exercise 13-13.1-17: the normal generator matrix entries after lifting to the
rational group algebra. -/
private theorem standardSemidirectRationalMatrixAlgHom_of_inl_one_entry (i j : Fin p) :
    standardSemidirectRationalMatrixAlgHom (p := p)
        (MonoidAlgebra.of ℚ
          (Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
            Multiplicative (ZMod p))
          (SemidirectProduct.inl (φ := standard_nonabelian_zmodP2_action (p := p))
            (Multiplicative.ofAdd (1 : ZMod (p ^ 2))))) i j =
      if h : j.1 + 1 < p then
        if i = (⟨j.1 + 1, h⟩ : Fin p) then 1 else 0
      else
        if i = 0 then standardSemidirectRationalZeta (p := p) else 0 := by
  rw [standardSemidirectRationalMatrixAlgHom, MonoidAlgebra.lift_of,
    standardSemidirectRationalMatrixMonoidHom_inl_one_entry]

/-- Helper for Exercise 13-13.1-17: the acting generator matrix entries after lifting to the
rational group algebra. -/
private theorem standardSemidirectRationalMatrixAlgHom_of_inr_one_entry (i j : Fin p) :
    standardSemidirectRationalMatrixAlgHom (p := p)
        (MonoidAlgebra.of ℚ
          (Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
            Multiplicative (ZMod p))
          (SemidirectProduct.inr (φ := standard_nonabelian_zmodP2_action (p := p))
            (Multiplicative.ofAdd (1 : ZMod p)))) i j =
      if i = j then standardSemidirectRationalZeta (p := p) ^ j.1 else 0 := by
  rw [standardSemidirectRationalMatrixAlgHom, MonoidAlgebra.lift_of,
    standardSemidirectRationalMatrixMonoidHom_inr_one_entry]

/-- Helper for Exercise 13-13.1-17: Serre's full rational packet map on the standard semidirect
model: the trivial character, the `p + 1` abelianized cyclotomic packets, and the nonlinear
matrix packet induced from the normal cyclic subgroup of order `p²`. -/
private noncomputable def standardSemidirectRationalPacketAlgHom :
    ℚ[Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
        Multiplicative (ZMod p)] →ₐ[ℚ] RationalPacketTarget (p := p) :=
  (rationalTrivialGroupAlgebraAlgHom :
      ℚ[Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
          Multiplicative (ZMod p)] →ₐ[ℚ] ℚ).prod
    ((standardSemidirect_linearPacketAlgHom (p := p)).prod
      (standardSemidirectRationalMatrixAlgHom (p := p)))


private abbrev standardSemidirectGroup :=
  Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)]
    Multiplicative (ZMod p)

private def standardSemidirectNormalValue (r s : ZMod p) : ZMod (p ^ 2) :=
  ((r.val + p * s.val : ℕ) : ZMod (p ^ 2))

private theorem standardSemidirectNormalValue_nat_lt (r s : ZMod p) :
    r.val + p * s.val < p ^ 2 := by
  have hp0 : 0 < p := (Fact.out : Nat.Prime p).pos
  have hr := ZMod.val_lt r
  have hs := ZMod.val_lt s
  nlinarith [hr, hs, hp0]

private theorem standardSemidirectNormalValue_val (r s : ZMod p) :
    (standardSemidirectNormalValue (p := p) r s).val = r.val + p * s.val := by
  exact ZMod.val_cast_of_lt (standardSemidirectNormalValue_nat_lt (p := p) r s)

private def standardSemidirectOfCoords (r s k : ZMod p) :
    standardSemidirectGroup (p := p) :=
  ⟨Multiplicative.ofAdd (standardSemidirectNormalValue (p := p) r s),
    Multiplicative.ofAdd k⟩

private def standardSemidirectCoordR (g : standardSemidirectGroup (p := p)) : ZMod p :=
  ((g.left.toAdd.val % p : ℕ) : ZMod p)

private def standardSemidirectCoordS (g : standardSemidirectGroup (p := p)) : ZMod p :=
  ((g.left.toAdd.val / p : ℕ) : ZMod p)

private def standardSemidirectCoordK (g : standardSemidirectGroup (p := p)) : ZMod p :=
  g.right.toAdd

private theorem standardSemidirectOfCoords_coordR (r s k : ZMod p) :
    standardSemidirectCoordR (p := p)
        (standardSemidirectOfCoords (p := p) r s k) = r := by
  rw [standardSemidirectCoordR, standardSemidirectOfCoords]
  change ((((standardSemidirectNormalValue (p := p) r s).val % p : ℕ) : ZMod p) = r)
  rw [standardSemidirectNormalValue_val]
  have hmod : (r.val + p * s.val) % p = r.val := by
    rw [Nat.add_mul_mod_self_left]
    exact Nat.mod_eq_of_lt (ZMod.val_lt r)
  rw [hmod]
  exact ZMod.natCast_zmod_val r

private theorem standardSemidirectOfCoords_coordS (r s k : ZMod p) :
    standardSemidirectCoordS (p := p)
        (standardSemidirectOfCoords (p := p) r s k) = s := by
  rw [standardSemidirectCoordS, standardSemidirectOfCoords]
  change ((((standardSemidirectNormalValue (p := p) r s).val / p : ℕ) : ZMod p) = s)
  rw [standardSemidirectNormalValue_val]
  have hp0 : 0 < p := (Fact.out : Nat.Prime p).pos
  have hdiv : (r.val + p * s.val) / p = s.val := by
    rw [Nat.add_mul_div_left]
    · rw [Nat.div_eq_of_lt (ZMod.val_lt r), zero_add]
    · exact hp0
  rw [hdiv]
  exact ZMod.natCast_zmod_val s

private theorem standardSemidirectOfCoords_coordK (r s k : ZMod p) :
    standardSemidirectCoordK (p := p)
        (standardSemidirectOfCoords (p := p) r s k) = k := by
  rfl

private theorem standardSemidirectCoordR_val (g : standardSemidirectGroup (p := p)) :
    (standardSemidirectCoordR (p := p) g).val = g.left.toAdd.val % p := by
  exact ZMod.val_cast_of_lt (Nat.mod_lt _ (Fact.out : Nat.Prime p).pos)

private theorem standardSemidirectCoordS_val (g : standardSemidirectGroup (p := p)) :
    (standardSemidirectCoordS (p := p) g).val = g.left.toAdd.val / p := by
  have hlt : g.left.toAdd.val / p < p := by
    have hnlt_sq : g.left.toAdd.val < p ^ 2 := ZMod.val_lt g.left.toAdd
    have hnlt_mul : g.left.toAdd.val < p * p := by
      exact lt_of_lt_of_eq hnlt_sq (by rw [pow_two])
    exact Nat.div_lt_of_lt_mul hnlt_mul
  exact ZMod.val_cast_of_lt hlt

private theorem standardSemidirectOfCoords_coords (g : standardSemidirectGroup (p := p)) :
    standardSemidirectOfCoords (p := p)
        (standardSemidirectCoordR (p := p) g)
        (standardSemidirectCoordS (p := p) g)
        (standardSemidirectCoordK (p := p) g) = g := by
  apply SemidirectProduct.ext
  · change Multiplicative.ofAdd
        (standardSemidirectNormalValue (p := p)
          (standardSemidirectCoordR (p := p) g)
          (standardSemidirectCoordS (p := p) g)) = g.left
    apply Multiplicative.ofAdd.injective
    rw [standardSemidirectNormalValue, standardSemidirectCoordR_val,
      standardSemidirectCoordS_val]
    change (((g.left.toAdd.val % p + p * (g.left.toAdd.val / p) : ℕ) :
        ZMod (p ^ 2)) = g.left.toAdd)
    rw [Nat.mod_add_div, ZMod.natCast_zmod_val]
  · rfl

private noncomputable def standardSemidirectCoordEquiv :
    standardSemidirectGroup (p := p) ≃ ZMod p × ZMod p × ZMod p where
  toFun g :=
    (standardSemidirectCoordR (p := p) g,
      standardSemidirectCoordS (p := p) g,
      standardSemidirectCoordK (p := p) g)
  invFun q := standardSemidirectOfCoords (p := p) q.1 q.2.1 q.2.2
  left_inv g := by
    exact standardSemidirectOfCoords_coords (p := p) g
  right_inv q := by
    rcases q with ⟨r, s, k⟩
    simp [standardSemidirectOfCoords_coordR, standardSemidirectOfCoords_coordS,
      standardSemidirectOfCoords_coordK]

private theorem standardSemidirect_normalModPCoordinateHom_ofCoords (r s k : ZMod p) :
    standardSemidirect_normalModPCoordinateHom (p := p)
        (standardSemidirectOfCoords (p := p) r s k) =
      Multiplicative.ofAdd r := by
  ext
  change ((ZMod.castHom
        (show p ∣ p ^ 2 by exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
        (standardSemidirectNormalValue (p := p) r s)) = r
  rw [standardSemidirectNormalValue]
  rw [ZMod.castHom_apply]
  rw [ZMod.cast_eq_val]
  rw [ZMod.val_cast_of_lt]
  · simp [Nat.cast_add, Nat.cast_mul]
  · exact standardSemidirectNormalValue_nat_lt (p := p) r s

private theorem standardSemidirect_actingCoordinateHom_ofCoords (r s k : ZMod p) :
    standardSemidirect_actingCoordinateHom (p := p)
        (standardSemidirectOfCoords (p := p) r s k) =
      Multiplicative.ofAdd k := by
  rfl


private theorem standardSemidirect_sum_coord {A : Type*} [AddCommMonoid A]
    (F : standardSemidirectGroup (p := p) → A) :
    (∑ g : standardSemidirectGroup (p := p), F g) =
      ∑ q : ZMod p × ZMod p × ZMod p,
        F ((standardSemidirectCoordEquiv (p := p)).symm q) := by
  let e := standardSemidirectCoordEquiv (p := p)
  simpa [e] using
    Fintype.sum_equiv e F (fun q => F (e.symm q)) (by intro g; simp [e])

private theorem standardSemidirect_projectiveLine_finite_ofCoords
    (a r s k : ZMod p) :
    zmodPProjectiveLineHom (p := p)
        (standardSemidirect_normalModPCoordinateHom (p := p))
        (standardSemidirect_actingCoordinateHom (p := p))
        (⟨a.val, Nat.lt_trans (ZMod.val_lt a) (Nat.lt_succ_self p)⟩ : Fin (p + 1))
        (standardSemidirectOfCoords (p := p) r s k) =
      Multiplicative.ofAdd (r + a * k) := by
  have halt :
      (⟨a.val, Nat.lt_trans (ZMod.val_lt a) (Nat.lt_succ_self p)⟩ : Fin (p + 1)).1 < p :=
    ZMod.val_lt a
  simp [zmodPProjectiveLineHom, halt, standardSemidirect_normalModPCoordinateHom_ofCoords,
    standardSemidirect_actingCoordinateHom_ofCoords]
  rw [multiplicative_ofAdd_pow_nat_mul, ZMod.natCast_zmod_val]

private theorem standardSemidirect_projectiveLine_infty_ofCoords
    (r s k : ZMod p) :
    zmodPProjectiveLineHom (p := p)
        (standardSemidirect_normalModPCoordinateHom (p := p))
        (standardSemidirect_actingCoordinateHom (p := p))
        (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1))
        (standardSemidirectOfCoords (p := p) r s k) =
      Multiplicative.ofAdd k := by
  have hpnot : ¬ (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1)).1 < p := by
    simp
  simp [zmodPProjectiveLineHom, hpnot, standardSemidirect_actingCoordinateHom_ofCoords]

private theorem standardSemidirect_linearPacketAlgHom_finite_coord
    (z : ℚ[standardSemidirectGroup (p := p)]) (a : ZMod p) :
    standardSemidirect_linearPacketAlgHom (p := p) z
        (⟨a.val, Nat.lt_trans (ZMod.val_lt a) (Nat.lt_succ_self p)⟩ : Fin (p + 1)) =
      ∑ q : ZMod p × ZMod p × ZMod p,
        (z (standardSemidirectOfCoords (p := p) q.1 q.2.1 q.2.2) :
            CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (q.1 + a * q.2.2) := by
  rw [standardSemidirect_linearPacketAlgHom]
  rw [cyclotomicProjectiveLinePacketAlgHom_apply]
  rw [standardSemidirect_sum_coord]
  apply Finset.sum_congr rfl
  intro q _
  rcases q with ⟨r, s, k⟩
  change
    (z (standardSemidirectOfCoords (p := p) r s k) : CyclotomicField p ℚ) *
        (((zmodP_cyclotomic_character (p := p))
            ((zmodPProjectiveLineHom (p := p)
              (standardSemidirect_normalModPCoordinateHom (p := p))
              (standardSemidirect_actingCoordinateHom (p := p))
              (⟨a.val, Nat.lt_trans (ZMod.val_lt a) (Nat.lt_succ_self p)⟩ : Fin (p + 1)))
              (standardSemidirectOfCoords (p := p) r s k)) :
            (CyclotomicField p ℚ)ˣ) : CyclotomicField p ℚ) =
      (z (standardSemidirectOfCoords (p := p) r s k) : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) (r + a * k)
  rw [standardSemidirect_projectiveLine_finite_ofCoords]
  rfl

private theorem standardSemidirect_linearPacketAlgHom_infty_coord
    (z : ℚ[standardSemidirectGroup (p := p)]) :
    standardSemidirect_linearPacketAlgHom (p := p) z
        (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1)) =
      ∑ q : ZMod p × ZMod p × ZMod p,
        (z (standardSemidirectOfCoords (p := p) q.1 q.2.1 q.2.2) :
            CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) q.2.2 := by
  rw [standardSemidirect_linearPacketAlgHom]
  rw [cyclotomicProjectiveLinePacketAlgHom_apply]
  rw [standardSemidirect_sum_coord]
  apply Finset.sum_congr rfl
  intro q _
  rcases q with ⟨r, s, k⟩
  change
    (z (standardSemidirectOfCoords (p := p) r s k) : CyclotomicField p ℚ) *
        (((zmodP_cyclotomic_character (p := p))
            ((zmodPProjectiveLineHom (p := p)
              (standardSemidirect_normalModPCoordinateHom (p := p))
              (standardSemidirect_actingCoordinateHom (p := p))
              (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1)))
              (standardSemidirectOfCoords (p := p) r s k)) :
            (CyclotomicField p ℚ)ˣ) : CyclotomicField p ℚ) =
      (z (standardSemidirectOfCoords (p := p) r s k) : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) k
  rw [standardSemidirect_projectiveLine_infty_ofCoords]
  rfl


private theorem standardSemidirectOfCoords_eq_inl_mul_inr (r s k : ZMod p) :
    standardSemidirectOfCoords (p := p) r s k =
      SemidirectProduct.inl (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd (standardSemidirectNormalValue (p := p) r s)) *
        SemidirectProduct.inr (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd k) := by
  apply SemidirectProduct.ext
  · simp [standardSemidirectOfCoords]
  · simp [standardSemidirectOfCoords]

private theorem standardSemidirectRationalMonoidHom_inl_ofAdd_nat (n : ℕ) :
    standardSemidirectRationalMonoidHom (p := p)
        (SemidirectProduct.inl (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd ((n : ℕ) : ZMod (p ^ 2)))) =
      standardSemidirectRationalCompanionShift (p := p) ^ n := by
  change ((standardSemidirectRationalUnitHom (p := p)
        (SemidirectProduct.inl (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd ((n : ℕ) : ZMod (p ^ 2)))) :
      (standardSemidirectRationalEnd (p := p))ˣ) : standardSemidirectRationalEnd (p := p)) =
    standardSemidirectRationalCompanionShift (p := p) ^ n
  have hpow :
      Multiplicative.ofAdd ((n : ℕ) : ZMod (p ^ 2)) =
        (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ n := by
    rw [ofAdd_one_pow (p := p)]
  rw [standardSemidirectRationalUnitHom, SemidirectProduct.lift_inl]
  rw [hpow, map_pow, standardSemidirectRationalNormalHom_generator]
  simp [Units.val_pow_eq_pow_val, standardSemidirectRationalCompanionShiftUnit_coe]

private theorem standardSemidirectRationalMonoidHom_inr_ofAdd_nat (n : ℕ) :
    standardSemidirectRationalMonoidHom (p := p)
        (SemidirectProduct.inr (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd ((n : ℕ) : ZMod p))) =
      standardSemidirectRationalClock (p := p) ^ n := by
  change ((standardSemidirectRationalUnitHom (p := p)
        (SemidirectProduct.inr (φ := standard_nonabelian_zmodP2_action (p := p))
          (Multiplicative.ofAdd ((n : ℕ) : ZMod p))) :
      (standardSemidirectRationalEnd (p := p))ˣ) : standardSemidirectRationalEnd (p := p)) =
    standardSemidirectRationalClock (p := p) ^ n
  have hpow :
      Multiplicative.ofAdd ((n : ℕ) : ZMod p) =
        (Multiplicative.ofAdd (1 : ZMod p)) ^ n := by
    rw [ofAdd_one_pow_mod_p (p := p)]
  rw [standardSemidirectRationalUnitHom, SemidirectProduct.lift_inr]
  rw [hpow, map_pow, standardSemidirectRationalActingHom_generator]
  simp [Units.val_pow_eq_pow_val, standardSemidirectRationalClockUnit_coe]

private theorem standardSemidirectRationalMonoidHom_ofCoords (r s k : ZMod p) :
    standardSemidirectRationalMonoidHom (p := p)
        (standardSemidirectOfCoords (p := p) r s k) =
      standardSemidirectRationalCompanionShift (p := p) ^ (r.val + p * s.val) *
        standardSemidirectRationalClock (p := p) ^ k.val := by
  rw [standardSemidirectOfCoords_eq_inl_mul_inr, map_mul]
  rw [standardSemidirectNormalValue]
  have hk : Multiplicative.ofAdd k = Multiplicative.ofAdd ((k.val : ℕ) : ZMod p) := by
    rw [ZMod.natCast_zmod_val]
  rw [hk]
  rw [standardSemidirectRationalMonoidHom_inl_ofAdd_nat,
    standardSemidirectRationalMonoidHom_inr_ofAdd_nat]


private theorem standardSemidirectRationalMatrixAlgHom_apply_entry
    (z : ℚ[standardSemidirectGroup (p := p)]) (i j : Fin p) :
    standardSemidirectRationalMatrixAlgHom (p := p) z i j =
      ∑ g : standardSemidirectGroup (p := p),
        (z g : CyclotomicField p ℚ) *
          standardSemidirectRationalMatrixMonoidHom (p := p) g i j := by
  rw [standardSemidirectRationalMatrixAlgHom, MonoidAlgebra.lift_apply]
  rw [Finsupp.sum_fintype]
  · rw [Matrix.sum_apply i j Finset.univ
      (fun g : standardSemidirectGroup (p := p) =>
        z g • standardSemidirectRationalMatrixMonoidHom (p := p) g)]
    simp [Algebra.smul_def]
  · intro g
    simp


private theorem standardSemidirectRationalCompanionShift_pow_p_mul (n : ℕ) :
    standardSemidirectRationalCompanionShift (p := p) ^ (p * n) =
      standardSemidirectRationalZeta (p := p) ^ n •
        (1 : standardSemidirectRationalEnd (p := p)) := by
  rw [pow_mul, standardSemidirectRationalCompanionShift_pow_p]
  rw [← Algebra.algebraMap_eq_smul_one
    (A := standardSemidirectRationalEnd (p := p))
    (standardSemidirectRationalZeta (p := p))]
  rw [← map_pow]
  rw [Algebra.algebraMap_eq_smul_one]

private theorem standardSemidirectRationalCompanionShift_pow_coord_basis
    (r s : ZMod p) (i : Fin p) :
    (standardSemidirectRationalCompanionShift (p := p) ^ (r.val + p * s.val))
        ((standardSemidirectRationalBasis (p := p)) i) =
      standardSemidirectRationalZeta (p := p) ^ s.val •
        ((standardSemidirectRationalCompanionShift (p := p) ^ r.val)
          ((standardSemidirectRationalBasis (p := p)) i)) := by
  have hnat : r.val + p * s.val = p * s.val + r.val := by omega
  rw [hnat, pow_add, standardSemidirectRationalCompanionShift_pow_p_mul]
  rw [Module.End.mul_apply]
  simp

private theorem standardSemidirectRationalZeta_pow_mul_pow_eq_character
    (s k t : ZMod p) :
    standardSemidirectRationalZeta (p := p) ^ s.val *
        standardSemidirectRationalZeta (p := p) ^ (k.val * (zmodPIndex (p := p) t).1) =
      zmodP_cyclotomic_character_val (p := p) (s + k * t) := by
  rw [standardSemidirectRationalZeta_eq_cyclotomic]
  rw [← zmodP_cyclotomic_character_val_natCast (p := p) s.val]
  rw [← zmodP_cyclotomic_character_val_natCast (p := p)
    (k.val * (zmodPIndex (p := p) t).1)]
  rw [zmodP_cyclotomic_character_val_add]
  congr 1
  rw [Nat.cast_mul, ZMod.natCast_zmod_val, zmodPIndex_natCast]
  rw [ZMod.natCast_zmod_val]


private theorem zmodPIndex_add_eq_no_wrap (t r : ZMod p)
    (h : (zmodPIndex (p := p) t).1 + r.val < p) :
    zmodPIndex (p := p) (t + r) =
      (⟨(zmodPIndex (p := p) t).1 + r.val, h⟩ : Fin p) := by
  apply fin_eq_of_natCast_zmod_eq (p := p)
  rw [zmodPIndex_natCast]
  symm
  change ((((zmodPIndex (p := p) t).1 + r.val : ℕ) : ZMod p) = t + r)
  rw [Nat.cast_add, zmodPIndex_natCast, ZMod.natCast_zmod_val]

private theorem zmodPIndex_add_eq_wrap (t r : ZMod p)
    (h : ¬ (zmodPIndex (p := p) t).1 + r.val < p) :
    zmodPIndex (p := p) (t + r) =
      (⟨(zmodPIndex (p := p) t).1 + r.val - p, by
        have ht := (zmodPIndex (p := p) t).isLt
        have hr := ZMod.val_lt r
        omega⟩ : Fin p) := by
  apply fin_eq_of_natCast_zmod_eq (p := p)
  rw [zmodPIndex_natCast]
  symm
  change ((((zmodPIndex (p := p) t).1 + r.val - p : ℕ) : ZMod p) = t + r)
  have hsub_cast :
      (((zmodPIndex (p := p) t).1 + r.val - p : ℕ) : ZMod p) =
        (((zmodPIndex (p := p) t).1 + r.val : ℕ) : ZMod p) := by
    have hnp : ((zmodPIndex (p := p) t).1 + r.val - p) + p =
        (zmodPIndex (p := p) t).1 + r.val := by omega
    have hcast := congrArg (fun n : ℕ => ((n : ℕ) : ZMod p)) hnp
    simpa [Nat.cast_add] using hcast
  rw [hsub_cast, Nat.cast_add, zmodPIndex_natCast, ZMod.natCast_zmod_val]

private theorem standardSemidirectRationalMatrixMonoidHom_coord_entry
    (r s k t : ZMod p) :
    standardSemidirectRationalMatrixMonoidHom (p := p)
        (standardSemidirectOfCoords (p := p) r s k)
        (zmodPIndex (p := p) (t + r)) (zmodPIndex (p := p) t) =
      (if h : (zmodPIndex (p := p) t).1 + r.val < p then 1
        else standardSemidirectRationalZeta (p := p)) *
        zmodP_cyclotomic_character_val (p := p) (s + k * t) := by
  rw [standardSemidirectRationalMatrixMonoidHom]
  change (LinearMap.toMatrixAlgEquiv (standardSemidirectRationalBasis (p := p))
      (standardSemidirectRationalMonoidHom (p := p)
        (standardSemidirectOfCoords (p := p) r s k)))
      (zmodPIndex (p := p) (t + r)) (zmodPIndex (p := p) t) = _
  rw [standardSemidirectRationalMonoidHom_ofCoords]
  rw [LinearMap.toMatrixAlgEquiv_apply]
  rw [Module.End.mul_apply]
  rw [standardSemidirectRationalClock_pow_basis]
  simp only [map_smul]
  rw [standardSemidirectRationalCompanionShift_pow_coord_basis]
  rw [standardSemidirectRationalCompanionShift_pow_basis_aux (p := p) r.val
    (Nat.le_of_lt (ZMod.val_lt r)) (zmodPIndex (p := p) t)]
  by_cases hstep : (zmodPIndex (p := p) t).1 + r.val < p
  · rw [dif_pos hstep]
    rw [zmodPIndex_add_eq_no_wrap (p := p) t r hstep]
    simp [standardSemidirectRationalBasis, hstep, smul_smul]
    rw [mul_comm]
    exact standardSemidirectRationalZeta_pow_mul_pow_eq_character (p := p) s k t
  · rw [dif_neg hstep]
    rw [zmodPIndex_add_eq_wrap (p := p) t r hstep]
    simp [standardSemidirectRationalBasis, hstep, smul_smul, mul_assoc, mul_left_comm,
      mul_comm]
    left
    rw [Nat.mul_comm]
    exact standardSemidirectRationalZeta_pow_mul_pow_eq_character (p := p) s k t


private theorem standardSemidirectRationalMatrixMonoidHom_coord_entry_ne
    (a r s k t : ZMod p) (har : a ≠ r) :
    standardSemidirectRationalMatrixMonoidHom (p := p)
        (standardSemidirectOfCoords (p := p) a s k)
        (zmodPIndex (p := p) (t + r)) (zmodPIndex (p := p) t) = 0 := by
  have hrow_ne : zmodPIndex (p := p) (t + r) ≠ zmodPIndex (p := p) (t + a) := by
    intro hidx
    apply har
    have hcast :
        ((zmodPIndex (p := p) (t + r) : ℕ) : ZMod p) =
          ((zmodPIndex (p := p) (t + a) : ℕ) : ZMod p) := by
      simpa using congrArg (fun i : Fin p => ((i : ℕ) : ZMod p)) hidx
    rw [zmodPIndex_natCast, zmodPIndex_natCast] at hcast
    exact add_left_cancel hcast.symm
  rw [standardSemidirectRationalMatrixMonoidHom]
  change (LinearMap.toMatrixAlgEquiv (standardSemidirectRationalBasis (p := p))
      (standardSemidirectRationalMonoidHom (p := p)
        (standardSemidirectOfCoords (p := p) a s k)))
      (zmodPIndex (p := p) (t + r)) (zmodPIndex (p := p) t) = 0
  rw [standardSemidirectRationalMonoidHom_ofCoords]
  rw [LinearMap.toMatrixAlgEquiv_apply]
  rw [Module.End.mul_apply]
  rw [standardSemidirectRationalClock_pow_basis]
  simp only [map_smul]
  rw [standardSemidirectRationalCompanionShift_pow_coord_basis]
  rw [standardSemidirectRationalCompanionShift_pow_basis_aux (p := p) a.val
    (Nat.le_of_lt (ZMod.val_lt a)) (zmodPIndex (p := p) t)]
  by_cases hstep : (zmodPIndex (p := p) t).1 + a.val < p
  · rw [dif_pos hstep]
    have htarget := zmodPIndex_add_eq_no_wrap (p := p) t a hstep
    have hne : zmodPIndex (p := p) (t + r) ≠
        (⟨(zmodPIndex (p := p) t).1 + a.val, hstep⟩ : Fin p) := by
      intro hidx
      exact hrow_ne (hidx.trans htarget.symm)
    simp [standardSemidirectRationalBasis, hne]
  · rw [dif_neg hstep]
    have htarget := zmodPIndex_add_eq_wrap (p := p) t a hstep
    have hne : zmodPIndex (p := p) (t + r) ≠
        (⟨(zmodPIndex (p := p) t).1 + a.val - p, by
          have ht := (zmodPIndex (p := p) t).isLt
          have ha := ZMod.val_lt a
          omega⟩ : Fin p) := by
      intro hidx
      exact hrow_ne (hidx.trans htarget.symm)
    simp [standardSemidirectRationalBasis, hne]

private theorem standardSemidirectRationalMatrixAlgHom_coord_entry
    (z : ℚ[standardSemidirectGroup (p := p)]) (r t : ZMod p) :
    standardSemidirectRationalMatrixAlgHom (p := p) z
        (zmodPIndex (p := p) (t + r)) (zmodPIndex (p := p) t) =
      (if h : (zmodPIndex (p := p) t).1 + r.val < p then 1
        else standardSemidirectRationalZeta (p := p)) *
        ∑ q : ZMod p × ZMod p,
          (z (standardSemidirectOfCoords (p := p) r q.1 q.2) :
              CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) (q.1 + q.2 * t) := by
  rw [standardSemidirectRationalMatrixAlgHom_apply_entry]
  rw [standardSemidirect_sum_coord]
  let scalar : CyclotomicField p ℚ :=
    if h : (zmodPIndex (p := p) t).1 + r.val < p then 1
      else standardSemidirectRationalZeta (p := p)
  calc
    (∑ q : ZMod p × ZMod p × ZMod p,
        (z ((standardSemidirectCoordEquiv (p := p)).symm q) : CyclotomicField p ℚ) *
          standardSemidirectRationalMatrixMonoidHom (p := p)
            ((standardSemidirectCoordEquiv (p := p)).symm q)
            (zmodPIndex (p := p) (t + r)) (zmodPIndex (p := p) t))
        = ∑ a : ZMod p, ∑ q : ZMod p × ZMod p,
            (z (standardSemidirectOfCoords (p := p) a q.1 q.2) :
                CyclotomicField p ℚ) *
              (if ha : a = r then
                scalar * zmodP_cyclotomic_character_val (p := p) (q.1 + q.2 * t)
              else 0) := by
          rw [Fintype.sum_prod_type]
          apply Finset.sum_congr rfl
          intro a _
          apply Finset.sum_congr rfl
          intro q _
          rcases q with ⟨s, k⟩
          change
            (z (standardSemidirectOfCoords (p := p) a s k) : CyclotomicField p ℚ) *
                standardSemidirectRationalMatrixMonoidHom (p := p)
                  (standardSemidirectOfCoords (p := p) a s k)
                  (zmodPIndex (p := p) (t + r)) (zmodPIndex (p := p) t) =
              (z (standardSemidirectOfCoords (p := p) a s k) : CyclotomicField p ℚ) *
                (if ha : a = r then
                  scalar * zmodP_cyclotomic_character_val (p := p) (s + k * t)
                else 0)
          by_cases ha : a = r
          · subst a
            rw [standardSemidirectRationalMatrixMonoidHom_coord_entry]
            simp [scalar]
          · rw [standardSemidirectRationalMatrixMonoidHom_coord_entry_ne (p := p) a r s k t ha]
            simp [ha]
    _ = ∑ q : ZMod p × ZMod p,
          (z (standardSemidirectOfCoords (p := p) r q.1 q.2) :
              CyclotomicField p ℚ) *
            (scalar * zmodP_cyclotomic_character_val (p := p) (q.1 + q.2 * t)) := by
          rw [Finset.sum_eq_single r]
          · simp
          · intro a _ ha
            apply Finset.sum_eq_zero
            intro q _
            simp [ha]
          · intro hr
            simp at hr
    _ = scalar * ∑ q : ZMod p × ZMod p,
          (z (standardSemidirectOfCoords (p := p) r q.1 q.2) :
              CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) (q.1 + q.2 * t) := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro q _
          ring
    _ = (if h : (zmodPIndex (p := p) t).1 + r.val < p then 1
          else standardSemidirectRationalZeta (p := p)) *
        ∑ q : ZMod p × ZMod p,
          (z (standardSemidirectOfCoords (p := p) r q.1 q.2) :
              CyclotomicField p ℚ) *
            zmodP_cyclotomic_character_val (p := p) (q.1 + q.2 * t) := rfl

