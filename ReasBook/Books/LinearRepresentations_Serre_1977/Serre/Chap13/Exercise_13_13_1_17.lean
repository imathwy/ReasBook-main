  change standardNonabelianSemidirectDetectorU (p := p) ^ x.toAdd.val - 1 ∈
    standardNonabelianSemidirectDetectorRaises (p := p) 1
  exact standardNonabelianSemidirectDetectorRaises_pow_sub_one (p := p)
    (standardNonabelianSemidirectDetectorU_raises_zero (p := p))
    (standardNonabelianSemidirectDetectorU_sub_one_raises_one (p := p)) x.toAdd.val

/-- Helper for Exercise 13-13.1-17: the acting-factor detector image preserves the filtration. -/
private theorem standardNonabelianSemidirectDetectorActingHom_raises_zero
    (x : Multiplicative (ZMod p)) :
    ((standardNonabelianSemidirectDetectorActingHom (p := p) x :
        (standardNonabelianSemidirectDetectorEnd (p := p))ˣ) :
