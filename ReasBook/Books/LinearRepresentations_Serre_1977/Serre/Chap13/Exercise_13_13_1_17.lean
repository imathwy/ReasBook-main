  exact algEquiv_of_injective_algHom_of_finrank_eq Φ hdim hΦ

/-- Helper for Exercise 13-13.1-17: on the canonical Heisenberg model, every Jacobson-radical
element has trivial class in Serre's Jennings quotient `J^p / J^(p+1)`. -/
private theorem upperUnitriangularSubgroup_generator_pth_power_mem_augmentation_pow_succ
    (hp2 : p ≠ 2)
    (g : upperUnitriangularSubgroup (ZMod p) 3) :
    (((MonoidAlgebra.of (ZMod p) (upperUnitriangularSubgroup (ZMod p) 3) g :
        (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) - 1) ^ p) ∈
      (RingHom.ker (upperUnitriangularSubgroup_augmentation (p := p)).toRingHom) ^ (p + 1) := by
  -- The source-side Heisenberg generator already has zero `p`-th power, so its class vanishes in
  -- every later augmentation quotient.
  have hpow :
      (((MonoidAlgebra.of (ZMod p) (upperUnitriangularSubgroup (ZMod p) 3) g :
          (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) - 1) ^ p) = 0 :=
    upperUnitriangularSubgroup_of_sub_one_pow_p_eq_zero (p := p) hp2 g
  rw [hpow]
  exact Ideal.zero_mem _

/-- Helper for Exercise 13-13.1-17: on the canonical Heisenberg model, every Jacobson-radical
element has trivial class in Serre's Jennings quotient `J^p / J^(p+1)`. -/
private theorem upperUnitriangularSubgroup_generator_pth_power_class_zero
    (hp2 : p ≠ 2)
    (g : upperUnitriangularSubgroup (ZMod p) 3) :
    Ideal.Quotient.mk
        (Ring.jacobson ((ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) ^ (p + 1))
        ((((MonoidAlgebra.of (ZMod p) (upperUnitriangularSubgroup (ZMod p) 3) g :
            (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) - 1) ^ p)) =
      0 := by
  -- Route correction: record the source-side generator calculation directly as augmentation-power
  -- membership, since that is the invariant later transported through Jennings quotients.
  have hmem_aug :
      (((MonoidAlgebra.of (ZMod p) (upperUnitriangularSubgroup (ZMod p) 3) g :
          (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) - 1) ^ p) ∈
        (RingHom.ker (upperUnitriangularSubgroup_augmentation (p := p)).toRingHom) ^ (p + 1) :=
    upperUnitriangularSubgroup_generator_pth_power_mem_augmentation_pow_succ
      (p := p) hp2 g
  have hmem_jac :
      (((MonoidAlgebra.of (ZMod p) (upperUnitriangularSubgroup (ZMod p) 3) g :
          (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) - 1) ^ p) ∈
        Ring.jacobson ((ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) ^ (p + 1) := by
    -- Rewrite the closed augmentation estimate once to the actual Jacobson filtration.
    simpa [upperUnitriangularSubgroup_jacobson_eq_augmentationKernel (p := p)] using hmem_aug
  exact Ideal.Quotient.eq_zero_iff_mem.2 hmem_jac

/-- Helper for Exercise 13-13.1-17: on the canonical Heisenberg model, every Jacobson-radical
element has trivial class in Serre's Jennings quotient `J^p / J^(p+1)`. -/
private theorem upperUnitriangularSubgroup_augmentation_pth_power_mem_pow_succ
    (hp2 : p ≠ 2)
    (x : (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3])
    (hx : x ∈ RingHom.ker (upperUnitriangularSubgroup_augmentation (p := p)).toRingHom) :
    x ^ p ∈
      (RingHom.ker (upperUnitriangularSubgroup_augmentation (p := p)).toRingHom) ^ (p + 1) := by
  let G := upperUnitriangularSubgroup (ZMod p) 3
  let I : Ideal (ZMod p)[G] :=
    RingHom.ker (upperUnitriangularSubgroup_augmentation (p := p)).toRingHom
  rcases monoidAlgebra_exists_sub_one_sub_mem_augmentationKernel_sq
      (p := p) (G := G) x (by simpa [G, I] using hx) with ⟨g, hg⟩
  let y : (ZMod p)[G] := (MonoidAlgebra.of (ZMod p) G g : (ZMod p)[G]) - 1
  have hy : y ∈ I := by
    -- The chosen representative is itself an augmentation generator.
    simpa [G, I, y] using upperUnitriangularSubgroup_of_sub_one_mem_augmentationKernel
      (p := p) g
  have hyPow : y ^ p ∈ I ^ (p + 1) := by
    -- The Heisenberg generator estimate is already available for every group element.
    simpa [G, I, y] using
      upperUnitriangularSubgroup_generator_pth_power_mem_augmentation_pow_succ
        (p := p) hp2 g
  have hcongr : x ^ p - y ^ p ∈ I ^ (p + 1) := by
    -- Transport the `p`-th power across the `I²`-congruence between `x` and the chosen generator.
    exact augmentationKernel_pth_power_congr_of_sub_mem_sq I (by simpa [I] using hx) hy
      (by simpa [G, I, y] using hg) p
  have hsum : (x ^ p - y ^ p) + y ^ p ∈ I ^ (p + 1) := add_mem hcongr hyPow
  -- Reassemble `x^p` from the transported difference and the generator contribution.
  simpa [y, sub_eq_add_neg, add_assoc] using hsum

/-- Helper for Exercise 13-13.1-17: on the canonical Heisenberg model, every Jacobson-radical
element has trivial class in Serre's Jennings quotient `J^p / J^(p+1)`. -/
private theorem upperUnitriangularSubgroup_jacobson_pth_power_class_zero
    (hp2 : p ≠ 2)
    (x : Ring.jacobson ((ZMod p)[upperUnitriangularSubgroup (ZMod p) 3])) :
    Ideal.Quotient.mk
        (Ring.jacobson ((ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) ^ (p + 1))
        (((x : (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]) ^ p)) =
      0 := by
  let A := (ZMod p)[upperUnitriangularSubgroup (ZMod p) 3]
  have hx_aug :
      ((x : Ring.jacobson A) : A) ∈
        RingHom.ker (upperUnitriangularSubgroup_augmentation (p := p)).toRingHom := by
    -- Rewrite the radical once to the augmentation kernel and keep the remaining work in the
    -- source-side augmentation filtration.
    simpa [A, upperUnitriangularSubgroup_jacobson_eq_augmentationKernel (p := p)] using x.property
  have hx_pow_aug :
      (((x : Ring.jacobson A) : A) ^ p) ∈
        (RingHom.ker (upperUnitriangularSubgroup_augmentation (p := p)).toRingHom) ^ (p + 1) :=
    upperUnitriangularSubgroup_augmentation_pth_power_mem_pow_succ
      (p := p) hp2 ((x : Ring.jacobson A) : A) hx_aug
  have hx_pow_jac :
      (((x : Ring.jacobson A) : A) ^ p) ∈ Ring.jacobson A ^ (p + 1) := by
    -- The augmentation-kernel estimate is exactly the desired Jennings-layer membership after the
    -- already-closed Jacobson equals augmentation rewrite.
    simpa [A, upperUnitriangularSubgroup_jacobson_eq_augmentationKernel (p := p)] using hx_pow_aug
  exact Ideal.Quotient.eq_zero_iff_mem.2 hx_pow_jac

/-- Helper for Exercise 13-13.1-17: Serre's distinguished semidirect augmentation generator is
already a Jacobson-radical element on the canonical standard model. -/
private theorem standard_nonabelian_semidirect_inl_sub_one_mem_jacobson :
    let yRaw : (ZMod p)[StandardGPrime] :=
      (MonoidAlgebra.of (ZMod p) StandardGPrime
          (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1
    yRaw ∈ Ring.jacobson ((ZMod p)[StandardGPrime]) := by
  -- Rewrite the Jacobson radical as the augmentation kernel and reuse the closed generator fact.
  rw [standard_nonabelian_semidirect_jacobson_eq_augmentationKernel (p := p)]
  simpa using standard_nonabelian_semidirect_inl_sub_one_mem_augmentationKernel (p := p)

/-- Helper for Exercise 13-13.1-17: the canonical semidirect model already provides a Jacobson
witness whose ambient `p`-th power is nonzero. -/
private theorem standard_nonabelian_semidirect_generator_pth_power_ne_zero :
    ∃ y : Ring.jacobson ((ZMod p)[StandardGPrime]),
      (((y : (ZMod p)[StandardGPrime]) ^ p)) ≠ 0 := by
  let yRaw : (ZMod p)[StandardGPrime] :=
    (MonoidAlgebra.of (ZMod p) StandardGPrime
        (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1
  have hy_mem : yRaw ∈ Ring.jacobson ((ZMod p)[StandardGPrime]) := by
    simpa [yRaw] using standard_nonabelian_semidirect_inl_sub_one_mem_jacobson (p := p)
  refine ⟨⟨yRaw, hy_mem⟩, ?_⟩
  -- The remaining obstruction is no longer raw nonvanishing but survival modulo `J^(p+1)`.
  simpa [yRaw] using standard_nonabelian_semidirect_inl_sub_one_pow_p_ne_zero (p := p)

/-- Helper for Exercise 13-13.1-17: Serre's distinguished semidirect augmentation generator
already lies in the `p`-th augmentation power, so it defines a genuine degree-`p` Jennings-layer
class. -/
private theorem standard_nonabelian_semidirect_generator_pth_power_mem_augmentation_pow :
    let yRaw : (ZMod p)[StandardGPrime] :=
      (MonoidAlgebra.of (ZMod p) StandardGPrime
          (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1
    yRaw ^ p ∈
      (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^ p := by
  let yRaw : (ZMod p)[StandardGPrime] :=
    (MonoidAlgebra.of (ZMod p) StandardGPrime
        (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1
  have hy_mem :
      yRaw ∈ RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom := by
    simpa [yRaw] using standard_nonabelian_semidirect_inl_sub_one_mem_augmentationKernel (p := p)
  -- The source-side witness is an augmentation generator, so its `p`-th power lies in `I^p`.
  simpa [yRaw] using
    (Ideal.pow_mem_pow hy_mem p :
      yRaw ^ p ∈
        (RingHom.ker (standard_nonabelian_semidirect_augmentation (p := p)).toRingHom) ^ p)

/-- Helper for Exercise 13-13.1-17: over a field, a vector outside a submodule can be detected by
a linear functional that vanishes on the submodule and sends the chosen vector to `1`. -/
private theorem linearDetectorOfNotMem
    {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (W : Submodule K V) {v : V} (hv : v ∉ W) :
    ∃ f : V →ₗ[K] K, (∀ z ∈ W, f z = 0) ∧ f v = 1 := by
  rcases Submodule.exists_le_ker_of_notMem (p := W) (v := v) hv with ⟨f, hfv, hW⟩
  refine ⟨(f v)⁻¹ • f, ?_, ?_⟩
  · intro z hz
    -- Every element of the submodule already lies in the kernel of the unscaled detector.
    have hfz : f z = 0 := by
      exact LinearMap.mem_ker.1 (hW hz)
    simp [hfz]
  · -- Scaling by the inverse of `f v` normalizes the detector on the chosen vector.
    simp [hfv]

/-- Helper for Exercise 13-13.1-17: the filtered semidirect detector works on the coefficient
space of truncated polynomials of degree at most `p`. -/
private abbrev standardNonabelianSemidirectDetectorModule := Fin (p + 1) → ZMod p

/-- Helper for Exercise 13-13.1-17: the truncated-polynomial detector module carries the standard
coordinate basis indexed by the degrees `0, …, p`. -/
private abbrev standardNonabelianSemidirectDetectorBasis :
    Module.Basis (Fin (p + 1)) (ZMod p) (standardNonabelianSemidirectDetectorModule (p := p)) :=
  Pi.basisFun (ZMod p) (Fin (p + 1))

/-- Helper for Exercise 13-13.1-17: the degree-raising operator `N`, corresponding to
multiplication by `X` on truncated polynomials. -/
private noncomputable def standardNonabelianSemidirectDetectorShift :
    Module.End (ZMod p) (standardNonabelianSemidirectDetectorModule (p := p)) :=
  (standardNonabelianSemidirectDetectorBasis (p := p)).constr (ZMod p) fun i =>
    if h : i.1 + 1 < p + 1 then
      (standardNonabelianSemidirectDetectorBasis (p := p)) ⟨i.1 + 1, h⟩
    else 0

/-- Helper for Exercise 13-13.1-17: the sparse correction operator `E`, corresponding to the
substitution error term `X ↦ X + X^p` on the truncated-polynomial basis. -/
private noncomputable def standardNonabelianSemidirectDetectorShear :
    Module.End (ZMod p) (standardNonabelianSemidirectDetectorModule (p := p)) :=
  (standardNonabelianSemidirectDetectorBasis (p := p)).constr (ZMod p) fun i =>
    if hi : i = (1 : Fin (p + 1)) then
      (standardNonabelianSemidirectDetectorBasis (p := p)) ⟨p, by omega⟩
    else 0

/-- Helper for Exercise 13-13.1-17: the top basis vector of the detector module is not the degree
`1` basis vector. This is the small index fact behind the nilpotence of the shear operator. -/
private theorem standardNonabelianSemidirectDetectorTopIndex_ne_one :
    (⟨p, by omega⟩ : Fin (p + 1)) ≠ 1 := by
  -- Compare underlying naturals and use that a prime is never equal to `1`.
  intro h
  have hval : p = 1 % (p + 1) := congrArg Fin.val h
  have hlt : 1 < p + 1 := by
    have hp0 : 0 < p := (Fact.out : Nat.Prime p).pos
    omega
  have hmod : 1 % (p + 1) = 1 := Nat.mod_eq_of_lt hlt
  exact (Fact.out : Nat.Prime p).ne_one (hval.trans hmod)

/-- Helper for Exercise 13-13.1-17: the degree-raising operator sends the basis vector `X^i` to
`X^(i+1)` when the target degree stays inside the truncation range, and to `0` at the top. -/
private theorem standardNonabelianSemidirectDetectorShift_basis
    (i : Fin (p + 1)) :
    standardNonabelianSemidirectDetectorShift (p := p)
        ((standardNonabelianSemidirectDetectorBasis (p := p)) i) =
      if h : i.1 + 1 < p + 1 then
        (standardNonabelianSemidirectDetectorBasis (p := p)) ⟨i.1 + 1, h⟩
      else 0 := by
  -- Evaluate the linear map on one basis vector using `Basis.constr`.
  rw [standardNonabelianSemidirectDetectorShift]
  exact Module.Basis.constr_basis
    (standardNonabelianSemidirectDetectorBasis (p := p))
    (ZMod p)
    (fun i =>
      if h : i.1 + 1 < p + 1 then
        (standardNonabelianSemidirectDetectorBasis (p := p)) ⟨i.1 + 1, h⟩
      else 0)
    i

/-- Helper for Exercise 13-13.1-17: the sparse correction operator is supported only on the
degree-`1` basis vector, where it sends `X` to `X^p`. -/
private theorem standardNonabelianSemidirectDetectorShear_basis
    (i : Fin (p + 1)) :
    standardNonabelianSemidirectDetectorShear (p := p)
        ((standardNonabelianSemidirectDetectorBasis (p := p)) i) =
      if _hi : i = (1 : Fin (p + 1)) then
        (standardNonabelianSemidirectDetectorBasis (p := p)) ⟨p, by omega⟩
      else 0 := by
  -- Again evaluate the `Basis.constr` map directly on a basis vector.
  rw [standardNonabelianSemidirectDetectorShear]
  exact Module.Basis.constr_basis
    (standardNonabelianSemidirectDetectorBasis (p := p))
    (ZMod p)
    (fun i =>
      if _hi : i = (1 : Fin (p + 1)) then
        (standardNonabelianSemidirectDetectorBasis (p := p)) ⟨p, by omega⟩
      else 0)
    i

/-- Helper for Exercise 13-13.1-17: the shear operator is square-zero. This is the first stable
piece of the truncated-polynomial semidirect detector: applying the correction twice already lands
outside the truncation range. -/
private theorem standardNonabelianSemidirectDetectorShear_sq_zero :
    standardNonabelianSemidirectDetectorShear (p := p) *
        standardNonabelianSemidirectDetectorShear (p := p) =
      0 := by
  -- It is enough to test the composition on the standard basis.
  apply (standardNonabelianSemidirectDetectorBasis (p := p)).ext
  intro i
  rw [show
      (standardNonabelianSemidirectDetectorShear (p := p) *
          standardNonabelianSemidirectDetectorShear (p := p))
          ((standardNonabelianSemidirectDetectorBasis (p := p)) i) =
        standardNonabelianSemidirectDetectorShear (p := p)
          (standardNonabelianSemidirectDetectorShear (p := p)
            ((standardNonabelianSemidirectDetectorBasis (p := p)) i)) by
      rfl]
  rw [standardNonabelianSemidirectDetectorShear_basis (p := p)]
  split_ifs with hi
  · subst hi
    rw [standardNonabelianSemidirectDetectorShear_basis (p := p)]
    simp [standardNonabelianSemidirectDetectorTopIndex_ne_one (p := p)]
  · simp

/-- Helper for Exercise 13-13.1-17: iterating the degree-raising operator shifts the basis vector
`X^i` to `X^(i + n)` as long as the target degree stays within the truncation range. -/
private theorem standardNonabelianSemidirectDetectorShift_pow_basis
    (n : ℕ) (i : Fin (p + 1)) :
    (standardNonabelianSemidirectDetectorShift (p := p) ^ n)
        ((standardNonabelianSemidirectDetectorBasis (p := p)) i) =
      if h : i.1 + n < p + 1 then
        (standardNonabelianSemidirectDetectorBasis (p := p)) ⟨i.1 + n, h⟩
      else 0 := by
  induction n with
  | zero =>
      simp
      exact Nat.lt_succ_iff.mp i.2
  | succ n ih =>
      rw [pow_succ', Module.End.mul_apply, ih]
      by_cases h : i.1 + n < p + 1
      · rw [dif_pos h]
        rw [standardNonabelianSemidirectDetectorShift_basis (p := p)]
        by_cases hsucc : (⟨i.1 + n, h⟩ : Fin (p + 1)).1 + 1 < p + 1
        · have htarget : i.1 + (n + 1) < p + 1 := by
            simpa [Nat.add_assoc] using hsucc
          rw [dif_pos hsucc, dif_pos htarget]
          congr 1
        · have htarget : ¬ i.1 + (n + 1) < p + 1 := by
            intro htarget
            exact hsucc (by simpa [Nat.add_assoc] using htarget)
          rw [dif_neg hsucc, dif_neg htarget]
      · have htarget : ¬ i.1 + (n + 1) < p + 1 := by
          omega
        rw [dif_neg h, dif_neg htarget]
        simp

/-- Helper for Exercise 13-13.1-17: after `p + 1` shifts, every basis vector leaves the truncated
detector module. -/
private theorem standardNonabelianSemidirectDetectorShift_pow_succ_eq_zero :
    standardNonabelianSemidirectDetectorShift (p := p) ^ (p + 1) = 0 := by
  apply (standardNonabelianSemidirectDetectorBasis (p := p)).ext
  intro i
  rw [standardNonabelianSemidirectDetectorShift_pow_basis (p := p)]
  have htarget : ¬ i.1 + (p + 1) < p + 1 := by
    omega
  simp [htarget]

/-- Helper for Exercise 13-13.1-17: any shift by at least `p + 1` is zero on the truncated
detector module. -/
private theorem standardNonabelianSemidirectDetectorShift_pow_eq_zero_of_succ_le
    {n : ℕ} (hn : p + 1 ≤ n) :
    standardNonabelianSemidirectDetectorShift (p := p) ^ n = 0 := by
  apply (standardNonabelianSemidirectDetectorBasis (p := p)).ext
  intro i
  rw [standardNonabelianSemidirectDetectorShift_pow_basis (p := p)]
  have htarget : ¬ i.1 + n < p + 1 := by
    omega
  simp [htarget]

/-- Helper for Exercise 13-13.1-17: the shear-after-shift correction is exactly the top-degree
operator `N^p`. This is the concrete semidirect commutator term. -/
private theorem standardNonabelianSemidirectDetectorShear_mulShift_eq_shift_pow_p :
    standardNonabelianSemidirectDetectorShear (p := p) *
        standardNonabelianSemidirectDetectorShift (p := p) =
      standardNonabelianSemidirectDetectorShift (p := p) ^ p := by
  apply (standardNonabelianSemidirectDetectorBasis (p := p)).ext
  intro i
  by_cases hi0 : i = 0
  · subst hi0
    rw [Module.End.mul_apply]
    rw [standardNonabelianSemidirectDetectorShift_basis (p := p)]
    have hshift : (0 : Fin (p + 1)).1 + 1 < p + 1 := by
      have hp0 : 0 < p := (Fact.out : Nat.Prime p).pos
      simpa using Nat.succ_lt_succ hp0
    rw [dif_pos hshift]
    rw [standardNonabelianSemidirectDetectorShear_basis (p := p)]
    have hone : (⟨(0 : Fin (p + 1)).1 + 1, hshift⟩ : Fin (p + 1)) = 1 := by
      have hp1 : 1 < p + 1 := by
        have hp2 : 2 ≤ p := (Fact.out : Nat.Prime p).two_le
        omega
      ext
      simp [Nat.mod_eq_of_lt hp1]
    rw [dif_pos hone]
    rw [standardNonabelianSemidirectDetectorShift_pow_basis (p := p)]
    have hpTop : (0 : Fin (p + 1)).1 + p < p + 1 := by
      simpa using Nat.lt_succ_self p
    rw [dif_pos hpTop]
    simp
  · rw [Module.End.mul_apply]
    rw [standardNonabelianSemidirectDetectorShift_basis (p := p)]
    by_cases hshift : i.1 + 1 < p + 1
    · rw [dif_pos hshift]
      rw [standardNonabelianSemidirectDetectorShear_basis (p := p)]
      have hnext_ne_one : (⟨i.1 + 1, hshift⟩ : Fin (p + 1)) ≠ 1 := by
        intro hnext
        have hp1 : 1 < p + 1 := by
          have hp2 : 2 ≤ p := (Fact.out : Nat.Prime p).two_le
          omega
        have hval := congrArg Fin.val hnext
        have hi_val_zero : i.1 = 0 := by
          simp [Nat.mod_eq_of_lt hp1] at hval
          omega
        exact hi0 (Fin.ext hi_val_zero)
      rw [dif_neg hnext_ne_one]
      rw [standardNonabelianSemidirectDetectorShift_pow_basis (p := p)]
      have hpTop : ¬ i.1 + p < p + 1 := by
        intro hpTop
        have hi_val_zero : i.1 = 0 := by
          omega
        exact hi0 (Fin.ext hi_val_zero)
      rw [dif_neg hpTop]
    · rw [dif_neg hshift]
      simp only [map_zero]
      rw [standardNonabelianSemidirectDetectorShift_pow_basis (p := p)]
      have hpTop : ¬ i.1 + p < p + 1 := by
        omega
      rw [dif_neg hpTop]

/-- Helper for Exercise 13-13.1-17: shifting after the sparse correction already vanishes; the
shear sends everything to the top basis vector, where one more shift is zero. -/
private theorem standardNonabelianSemidirectDetectorShift_mulShear_eq_zero :
    standardNonabelianSemidirectDetectorShift (p := p) *
        standardNonabelianSemidirectDetectorShear (p := p) =
      0 := by
  -- The sparse correction has image in the top basis line, and the shift kills that line.
  apply (standardNonabelianSemidirectDetectorBasis (p := p)).ext
  intro i
  rw [show
      (standardNonabelianSemidirectDetectorShift (p := p) *
          standardNonabelianSemidirectDetectorShear (p := p))
          ((standardNonabelianSemidirectDetectorBasis (p := p)) i) =
        standardNonabelianSemidirectDetectorShift (p := p)
          (standardNonabelianSemidirectDetectorShear (p := p)
            ((standardNonabelianSemidirectDetectorBasis (p := p)) i)) by
      rfl]
  rw [standardNonabelianSemidirectDetectorShear_basis (p := p)]
  split_ifs with hi
  · subst hi
    rw [standardNonabelianSemidirectDetectorShift_basis (p := p)]
    simp
  · simp

/-- Helper for Exercise 13-13.1-17: the `p`-fold shift also kills the shear image, so no extra
high-degree error term survives in the semidirect compatibility computation. -/
private theorem standardNonabelianSemidirectDetectorShift_pow_p_mulShear_eq_zero :
    standardNonabelianSemidirectDetectorShift (p := p) ^ p *
        standardNonabelianSemidirectDetectorShear (p := p) =
      0 := by
  apply (standardNonabelianSemidirectDetectorBasis (p := p)).ext
  intro i
  rw [Module.End.mul_apply, standardNonabelianSemidirectDetectorShear_basis (p := p)]
  split_ifs with hi
  · rw [standardNonabelianSemidirectDetectorShift_pow_basis (p := p)]
    have htarget : ¬ (⟨p, by omega⟩ : Fin (p + 1)).1 + p < p + 1 := by
      simp
      have hp0 : 0 < p := (Fact.out : Nat.Prime p).pos
      omega
    simp [htarget]
  · simp

/-- Helper for Exercise 13-13.1-17: the two detector operators used for the standard semidirect
action are the unipotent maps `U = 1 + N` and `V = 1 + E`. -/
private abbrev standardNonabelianSemidirectDetectorU :
    Module.End (ZMod p) (standardNonabelianSemidirectDetectorModule (p := p)) :=
  1 + standardNonabelianSemidirectDetectorShift (p := p)

/-- Helper for Exercise 13-13.1-17: the detector companion for the acting `Z / p Z` factor is the
unipotent map `V = 1 + E`. -/
private abbrev standardNonabelianSemidirectDetectorV :
    Module.End (ZMod p) (standardNonabelianSemidirectDetectorModule (p := p)) :=
  1 + standardNonabelianSemidirectDetectorShear (p := p)

/-- Helper for Exercise 13-13.1-17: the prime scalar is the zero endomorphism over `ZMod p`. -/
private theorem standardNonabelianSemidirectDetectorEnd_natCast_prime_eq_zero :
    ((p : ℕ) : Module.End (ZMod p)
      (standardNonabelianSemidirectDetectorModule (p := p))) = 0 := by
  ext v i
  simp [Module.End.natCast_apply]

/-- Helper for Exercise 13-13.1-17: Frobenius for commuting detector endomorphisms. -/
private theorem standardNonabelianSemidirectDetector_add_pow_prime
    {X Y : Module.End (ZMod p) (standardNonabelianSemidirectDetectorModule (p := p))}
    (hXY : Commute X Y) :
    (X + Y) ^ p = X ^ p + Y ^ p := by
  obtain ⟨r, hr⟩ := hXY.exists_add_pow_prime_eq (Fact.out : Nat.Prime p)
  rw [hr, standardNonabelianSemidirectDetectorEnd_natCast_prime_eq_zero (p := p)]
  simp

/-- Helper for Exercise 13-13.1-17: `(1 + N)^p = 1 + N^p`. -/
private theorem standardNonabelianSemidirectDetectorU_pow_prime :
    standardNonabelianSemidirectDetectorU (p := p) ^ p =
      1 + standardNonabelianSemidirectDetectorShift (p := p) ^ p := by
  simpa [standardNonabelianSemidirectDetectorU] using
    standardNonabelianSemidirectDetector_add_pow_prime
      (p := p) (X := 1)
      (Y := standardNonabelianSemidirectDetectorShift (p := p))
      (Commute.one_left _)

/-- Helper for Exercise 13-13.1-17: `(1 + E)^p = 1 + E^p`. -/
private theorem standardNonabelianSemidirectDetectorV_pow_prime :
    standardNonabelianSemidirectDetectorV (p := p) ^ p =
      1 + standardNonabelianSemidirectDetectorShear (p := p) ^ p := by
  simpa [standardNonabelianSemidirectDetectorV] using
    standardNonabelianSemidirectDetector_add_pow_prime
      (p := p) (X := 1)
      (Y := standardNonabelianSemidirectDetectorShear (p := p))
      (Commute.one_left _)

/-- Helper for Exercise 13-13.1-17: the sparse shear is nilpotent in every prime degree. -/
private theorem standardNonabelianSemidirectDetectorShear_pow_prime_eq_zero :
    standardNonabelianSemidirectDetectorShear (p := p) ^ p = 0 := by
  have hp2 : 2 ≤ p := (Fact.out : Nat.Prime p).two_le
  obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le hp2
  calc
    standardNonabelianSemidirectDetectorShear (p := p) ^ p
        = standardNonabelianSemidirectDetectorShear (p := p) ^ (2 + k) := by
            exact congrArg (fun n => standardNonabelianSemidirectDetectorShear (p := p) ^ n) hk
    _ = standardNonabelianSemidirectDetectorShear (p := p) ^ 2 *
          standardNonabelianSemidirectDetectorShear (p := p) ^ k := by
            rw [pow_add]
    _ = 0 := by
          rw [pow_two, standardNonabelianSemidirectDetectorShear_sq_zero (p := p)]
          simp

/-- Helper for Exercise 13-13.1-17: the unipotent shift has order dividing `p²`. -/
private theorem standardNonabelianSemidirectDetectorU_pow_p_sq :
    standardNonabelianSemidirectDetectorU (p := p) ^ (p ^ 2) = 1 := by
  have hpow :
      standardNonabelianSemidirectDetectorShift (p := p) ^ (p ^ 2) = 0 := by
    apply standardNonabelianSemidirectDetectorShift_pow_eq_zero_of_succ_le (p := p)
    have hp2 : 2 ≤ p := (Fact.out : Nat.Prime p).two_le
    nlinarith [hp2]
  calc
    standardNonabelianSemidirectDetectorU (p := p) ^ (p ^ 2)
        = (standardNonabelianSemidirectDetectorU (p := p) ^ p) ^ p := by
            simpa [pow_two] using
              (pow_mul (standardNonabelianSemidirectDetectorU (p := p)) p p)
    _ = (1 + standardNonabelianSemidirectDetectorShift (p := p) ^ p) ^ p := by
          rw [standardNonabelianSemidirectDetectorU_pow_prime (p := p)]
    _ = 1 + (standardNonabelianSemidirectDetectorShift (p := p) ^ p) ^ p := by
          simpa using
            standardNonabelianSemidirectDetector_add_pow_prime
              (p := p) (X := 1)
              (Y := standardNonabelianSemidirectDetectorShift (p := p) ^ p)
              (Commute.one_left _)
    _ = 1 := by
          rw [← pow_mul, show p * p = p ^ 2 by ring, hpow]
          simp

/-- Helper for Exercise 13-13.1-17: the detector generators have the expected cyclic orders:
`U^(p^2) = 1` and `V^p = 1`. -/
private theorem standardNonabelianSemidirectDetectorGeneratorOrders :
    standardNonabelianSemidirectDetectorU (p := p) ^ (p ^ 2) = 1 ∧
      standardNonabelianSemidirectDetectorV (p := p) ^ p = 1 := by
  constructor
  · exact standardNonabelianSemidirectDetectorU_pow_p_sq (p := p)
  · rw [standardNonabelianSemidirectDetectorV_pow_prime (p := p),
      standardNonabelianSemidirectDetectorShear_pow_prime_eq_zero (p := p)]
    simp

/-- Helper for Exercise 13-13.1-17: the `(p + 1)`-st power of the unipotent shift is
`1 + N + N^p`. -/
private theorem standardNonabelianSemidirectDetectorU_pow_succ_prime :
    standardNonabelianSemidirectDetectorU (p := p) ^ (p + 1) =
      1 + standardNonabelianSemidirectDetectorShift (p := p) +
        standardNonabelianSemidirectDetectorShift (p := p) ^ p := by
  let N := standardNonabelianSemidirectDetectorShift (p := p)
  have hNsucc : N ^ (p + 1) = 0 := by
    simpa [N] using standardNonabelianSemidirectDetectorShift_pow_succ_eq_zero (p := p)
  calc
    standardNonabelianSemidirectDetectorU (p := p) ^ (p + 1)
        = standardNonabelianSemidirectDetectorU (p := p) ^ p *
            standardNonabelianSemidirectDetectorU (p := p) := by
              rw [pow_succ]
    _ = (1 + N ^ p) * (1 + N) := by
          rw [standardNonabelianSemidirectDetectorU_pow_prime (p := p)]
    _ = 1 + N + N ^ p + N ^ (p + 1) := by
          rw [mul_add, mul_one, add_mul, one_mul, ← pow_succ]
          abel_nf
    _ = 1 + N + N ^ p := by
          rw [hNsucc]
          abel_nf

/-- Helper for Exercise 13-13.1-17: the explicit detector generators satisfy the standard
semidirect relation `V * U = U^(p + 1) * V`. This is the concrete operator identity that packages
Serre's `a ↦ a^(1 + p)` action. -/
private theorem standardNonabelianSemidirectDetectorGeneratorCompatibility :
    standardNonabelianSemidirectDetectorV (p := p) *
        standardNonabelianSemidirectDetectorU (p := p) =
      standardNonabelianSemidirectDetectorU (p := p) ^ (p + 1) *
        standardNonabelianSemidirectDetectorV (p := p) := by
  let N := standardNonabelianSemidirectDetectorShift (p := p)
  let E := standardNonabelianSemidirectDetectorShear (p := p)
  have hEN : E * N = N ^ p := by
    simpa [N, E] using standardNonabelianSemidirectDetectorShear_mulShift_eq_shift_pow_p (p := p)
  have hNE : N * E = 0 := by
    simpa [N, E] using standardNonabelianSemidirectDetectorShift_mulShear_eq_zero (p := p)
  have hNpE : N ^ p * E = 0 := by
    simpa [N, E] using standardNonabelianSemidirectDetectorShift_pow_p_mulShear_eq_zero (p := p)
  calc
    standardNonabelianSemidirectDetectorV (p := p) *
        standardNonabelianSemidirectDetectorU (p := p)
        = (1 + E) * (1 + N) := rfl
    _ = 1 + N + E + N ^ p := by
          rw [mul_add, mul_one, add_mul, one_mul, hEN]
          abel_nf
    _ = (1 + N + N ^ p) * (1 + E) := by
          rw [mul_add, mul_one, add_mul, add_mul, one_mul, hNE, hNpE]
          abel_nf
    _ = standardNonabelianSemidirectDetectorU (p := p) ^ (p + 1) *
        standardNonabelianSemidirectDetectorV (p := p) := by
          simpa [N, E, standardNonabelianSemidirectDetectorV] using
            congrArg (fun T => T * standardNonabelianSemidirectDetectorV (p := p))
              (standardNonabelianSemidirectDetectorU_pow_succ_prime (p := p)).symm


/-- Helper for Exercise 13-13.1-17: the detector endomorphism ring. -/
private abbrev standardNonabelianSemidirectDetectorEnd :=
  Module.End (ZMod p) (standardNonabelianSemidirectDetectorModule (p := p))

/-- Helper for Exercise 13-13.1-17: the detector image of the normal `Z / p² Z` generator as a
unit. -/
private noncomputable def standardNonabelianSemidirectDetectorUUnit :
    (standardNonabelianSemidirectDetectorEnd (p := p))ˣ :=
  Units.ofPowEqOne (standardNonabelianSemidirectDetectorU (p := p)) (p ^ 2)
    (standardNonabelianSemidirectDetectorU_pow_p_sq (p := p))
    (by
      have hp0 : 0 < p := (Fact.out : Nat.Prime p).pos
      exact Nat.ne_of_gt (pow_pos hp0 2))

/-- Helper for Exercise 13-13.1-17: the detector image of the acting `Z / p Z` generator as a
unit. -/
private noncomputable def standardNonabelianSemidirectDetectorVUnit :
    (standardNonabelianSemidirectDetectorEnd (p := p))ˣ :=
  Units.ofPowEqOne (standardNonabelianSemidirectDetectorV (p := p)) p
    (standardNonabelianSemidirectDetectorGeneratorOrders (p := p)).2
    (Fact.out : Nat.Prime p).ne_zero

/-- Helper for Exercise 13-13.1-17: the normal detector unit has the required `p²`-torsion. -/
private theorem standardNonabelianSemidirectDetectorUUnit_pow :
    standardNonabelianSemidirectDetectorUUnit (p := p) ^ (p ^ 2) = 1 := by
  exact Units.pow_ofPowEqOne
    (standardNonabelianSemidirectDetectorU_pow_p_sq (p := p))
    (by
      have hp0 : 0 < p := (Fact.out : Nat.Prime p).pos
      exact Nat.ne_of_gt (pow_pos hp0 2))

/-- Helper for Exercise 13-13.1-17: the acting detector unit has the required `p`-torsion. -/
private theorem standardNonabelianSemidirectDetectorVUnit_pow :
    standardNonabelianSemidirectDetectorVUnit (p := p) ^ p = 1 := by
  exact Units.pow_ofPowEqOne
    (standardNonabelianSemidirectDetectorGeneratorOrders (p := p)).2
    (Fact.out : Nat.Prime p).ne_zero

/-- Helper for Exercise 13-13.1-17: the normal detector unit satisfies the relation needed to
factor the additive lift through `Z / p² Z`. -/
private theorem standardNonabelianSemidirectDetectorUUnit_zmultiples_zero :
    zmultiplesHom (Additive (standardNonabelianSemidirectDetectorEnd (p := p))ˣ)
        (Additive.ofMul (standardNonabelianSemidirectDetectorUUnit (p := p))) (p ^ 2) = 0 := by
  change standardNonabelianSemidirectDetectorUUnit (p := p) ^ (p ^ 2) = 1
  exact standardNonabelianSemidirectDetectorUUnit_pow (p := p)

/-- Helper for Exercise 13-13.1-17: the acting detector unit satisfies the relation needed to
factor the additive lift through `Z / p Z`. -/
private theorem standardNonabelianSemidirectDetectorVUnit_zmultiples_zero :
    zmultiplesHom (Additive (standardNonabelianSemidirectDetectorEnd (p := p))ˣ)
        (Additive.ofMul (standardNonabelianSemidirectDetectorVUnit (p := p))) p = 0 := by
  change standardNonabelianSemidirectDetectorVUnit (p := p) ^ p = 1
  exact standardNonabelianSemidirectDetectorVUnit_pow (p := p)

/-- Helper for Exercise 13-13.1-17: the detector hom on the normal cyclic factor. -/
private noncomputable def standardNonabelianSemidirectDetectorNormalHom :
    Multiplicative (ZMod (p ^ 2)) →* (standardNonabelianSemidirectDetectorEnd (p := p))ˣ :=
  AddMonoidHom.toMultiplicativeLeft <|
    ZMod.lift (p ^ 2)
      ⟨zmultiplesHom (Additive (standardNonabelianSemidirectDetectorEnd (p := p))ˣ)
          (Additive.ofMul (standardNonabelianSemidirectDetectorUUnit (p := p))),
        standardNonabelianSemidirectDetectorUUnit_zmultiples_zero (p := p)⟩

/-- Helper for Exercise 13-13.1-17: the detector hom on the acting cyclic factor. -/
private noncomputable def standardNonabelianSemidirectDetectorActingHom :
    Multiplicative (ZMod p) →* (standardNonabelianSemidirectDetectorEnd (p := p))ˣ :=
  AddMonoidHom.toMultiplicativeLeft <|
    ZMod.lift p
      ⟨zmultiplesHom (Additive (standardNonabelianSemidirectDetectorEnd (p := p))ˣ)
          (Additive.ofMul (standardNonabelianSemidirectDetectorVUnit (p := p))),
        standardNonabelianSemidirectDetectorVUnit_zmultiples_zero (p := p)⟩

/-- Helper for Exercise 13-13.1-17: the normal detector hom sends the additive generator to `U`. -/
private theorem standardNonabelianSemidirectDetectorNormalHom_generator :
    standardNonabelianSemidirectDetectorNormalHom (p := p)
        (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) =
      standardNonabelianSemidirectDetectorUUnit (p := p) := by
  dsimp [standardNonabelianSemidirectDetectorNormalHom]
  simpa using
    congrArg Additive.toMul
      (ZMod.lift_coe
        (n := p ^ 2)
        (f := ⟨zmultiplesHom (Additive (standardNonabelianSemidirectDetectorEnd (p := p))ˣ)
          (Additive.ofMul (standardNonabelianSemidirectDetectorUUnit (p := p))),
          standardNonabelianSemidirectDetectorUUnit_zmultiples_zero (p := p)⟩)
        (1 : ℤ))

/-- Helper for Exercise 13-13.1-17: the acting detector hom sends the additive generator to `V`. -/
private theorem standardNonabelianSemidirectDetectorActingHom_generator :
    standardNonabelianSemidirectDetectorActingHom (p := p)
        (Multiplicative.ofAdd (1 : ZMod p)) =
      standardNonabelianSemidirectDetectorVUnit (p := p) := by
  dsimp [standardNonabelianSemidirectDetectorActingHom]
  simpa using
    congrArg Additive.toMul
      (ZMod.lift_coe
        (n := p)
        (f := ⟨zmultiplesHom (Additive (standardNonabelianSemidirectDetectorEnd (p := p))ˣ)
          (Additive.ofMul (standardNonabelianSemidirectDetectorVUnit (p := p))),
          standardNonabelianSemidirectDetectorVUnit_zmultiples_zero (p := p)⟩)
        (1 : ℤ))


/-- Helper for Exercise 13-13.1-17: the detector generator relation lifted to units. -/
private theorem standardNonabelianSemidirectDetectorUnit_generatorCompatibility :
    standardNonabelianSemidirectDetectorVUnit (p := p) *
        standardNonabelianSemidirectDetectorUUnit (p := p) =
      standardNonabelianSemidirectDetectorUUnit (p := p) ^ (p + 1) *
        standardNonabelianSemidirectDetectorVUnit (p := p) := by
  apply Units.ext
  simpa [standardNonabelianSemidirectDetectorUUnit, standardNonabelianSemidirectDetectorVUnit]
    using standardNonabelianSemidirectDetectorGeneratorCompatibility (p := p)

/-- Helper for Exercise 13-13.1-17: conjugating the normal detector generator by the acting
detector generator implements Serre's `1 + p` action. -/
private theorem standardNonabelianSemidirectDetectorUnit_generator_conj :
    (MulAut.conj (standardNonabelianSemidirectDetectorVUnit (p := p)))
        (standardNonabelianSemidirectDetectorUUnit (p := p)) =
      standardNonabelianSemidirectDetectorUUnit (p := p) ^ (p + 1) := by
  apply_fun (fun u : (standardNonabelianSemidirectDetectorEnd (p := p))ˣ =>
      u * standardNonabelianSemidirectDetectorVUnit (p := p))
  · simpa [MulAut.conj_apply] using
      standardNonabelianSemidirectDetectorUnit_generatorCompatibility (p := p)
  · intro x y hxy
    exact mul_right_cancel hxy


/-- Helper for Exercise 13-13.1-17: the additive generator generates `Z / p² Z`, viewed
multiplicatively. -/
private theorem standardNonabelianSemidirect_zmodP2_mem_zpowers_one
    (x : Multiplicative (ZMod (p ^ 2))) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) := by
  refine Subgroup.mem_zpowers_iff.mpr ⟨(x.toAdd.val : ℤ), ?_⟩
  rw [zpow_natCast]
  calc
    (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ x.toAdd.val
        = Multiplicative.ofAdd ((x.toAdd.val : ℕ) : ZMod (p ^ 2)) := by
            rw [ofAdd_one_pow (p := p)]
    _ = Multiplicative.ofAdd x.toAdd := by
          rw [ZMod.natCast_zmod_val]
    _ = x := by
          simp

/-- Helper for Exercise 13-13.1-17: the additive generator generates `Z / p Z`, viewed
multiplicatively. -/
private theorem standardNonabelianSemidirect_zmodP_mem_zpowers_one
    (x : Multiplicative (ZMod p)) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd (1 : ZMod p)) := by
  refine Subgroup.mem_zpowers_iff.mpr ⟨(x.toAdd.val : ℤ), ?_⟩
  rw [zpow_natCast]
  calc
    (Multiplicative.ofAdd (1 : ZMod p)) ^ x.toAdd.val
        = Multiplicative.ofAdd ((x.toAdd.val : ℕ) : ZMod p) := by
            rw [ofAdd_one_pow_mod_p (p := p)]
    _ = Multiplicative.ofAdd x.toAdd := by
          rw [ZMod.natCast_zmod_val]
    _ = x := by
          simp

/-- Helper for Exercise 13-13.1-17: the standard unit-valued hom sends the generator of
`Z / p Z` to Serre's standard unit `1 + p`. -/
private theorem standardNonabelianSemidirect_unitsHom_generator :
    standard_nonabelian_zmodP2_units_hom (p := p)
        (Multiplicative.ofAdd (1 : ZMod p)) =
      standard_nonabelian_zmodP2_unit (p := p) := by
  -- Unfold the additive lift once at the generator `1`.
  dsimp [standard_nonabelian_zmodP2_units_hom]
  simpa using
    congrArg Additive.toMul
      (ZMod.lift_coe
        (n := p)
        (f := ⟨zmultiplesHom (Additive ((ZMod (p ^ 2))ˣ))
          (Additive.ofMul (standard_nonabelian_zmodP2_unit (p := p))),
          standard_nonabelian_zmodP2_unit_zmultiples_zero (p := p)⟩)
        (1 : ℤ))

/-- Helper for Exercise 13-13.1-17: the standard unit `1 + p` reduces to `1` modulo `p`. -/
private theorem standardNonabelianSemidirectReducedUnit_eq_one :
    ((ZMod.castHom (show p ∣ p ^ 2 by
          exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
        ((standard_nonabelian_zmodP2_unit (p := p) : (ZMod (p ^ 2))ˣ) :
          ZMod (p ^ 2))) =
      1 := by
  -- Reduce the explicit residue class `1 + p` modulo `p`.
  simp [standard_nonabelian_zmodP2_unit, ZMod.coe_unitOfCoprime]

/-- Helper for Exercise 13-13.1-17: after reducing Serre's action units modulo `p`, the whole
standard action becomes trivial on the residue class `Z / p Z`. -/
private theorem standardNonabelianSemidirect_reducedUnitsHom_eq_one
    (x : Multiplicative (ZMod p)) :
    ((ZMod.castHom (show p ∣ p ^ 2 by
          exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
        ((standard_nonabelian_zmodP2_units_hom (p := p) x : (ZMod (p ^ 2))ˣ) :
          ZMod (p ^ 2))) =
      1 := by
  let g : Multiplicative (ZMod p) := Multiplicative.ofAdd (1 : ZMod p)
  have hpow :
      standard_nonabelian_zmodP2_units_hom (p := p) x =
        standard_nonabelian_zmodP2_units_hom (p := p) g ^ x.val := by
    have hxpow : g ^ x.val = Multiplicative.ofAdd x := by
      -- This is the same generator calculation used earlier to control the action on `Z / p Z`.
      simpa [g, ZMod.natCast_val] using (ofAdd_one_pow_mod_p (p := p) x.val)
    calc
      standard_nonabelian_zmodP2_units_hom (p := p) x
          = standard_nonabelian_zmodP2_units_hom (p := p) (g ^ x.val) := by
              simpa using congrArg (standard_nonabelian_zmodP2_units_hom (p := p)) hxpow.symm
      _ = standard_nonabelian_zmodP2_units_hom (p := p) g ^ x.val := by
            rw [map_pow]
  have hgen :
      ((ZMod.castHom (show p ∣ p ^ 2 by
            exact dvd_pow_self p (show 2 ≠ 0 by decide)) (ZMod p))
          ((standard_nonabelian_zmodP2_units_hom (p := p) g : (ZMod (p ^ 2))ˣ) :
            ZMod (p ^ 2))) =
        1 := by
    rw [standardNonabelianSemidirect_unitsHom_generator (p := p)]
    exact standardNonabelianSemidirectReducedUnit_eq_one (p := p)
  rw [hpow]
  simpa [Units.val_pow_eq_pow_val, map_pow, hgen]

/-- Helper for Exercise 13-13.1-17: the standard action sends the normal generator to its
`(p + 1)`-st power. -/
private theorem standardNonabelianSemidirect_action_generator :
    standard_nonabelian_zmodP2_action (p := p)
        (Multiplicative.ofAdd (1 : ZMod p))
        (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) =
      (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ (p + 1) := by
  change Multiplicative.ofAdd
        (((standard_nonabelian_zmodP2_units_hom (p := p)
            (Multiplicative.ofAdd (1 : ZMod p)) : (ZMod (p ^ 2))ˣ) : ZMod (p ^ 2)) *
          (1 : ZMod (p ^ 2))) =
      (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ (p + 1)
  rw [standardNonabelianSemidirect_unitsHom_generator (p := p)]
  simp [standard_nonabelian_zmodP2_unit, ZMod.coe_unitOfCoprime, ofAdd_one_pow, Nat.cast_add,
    Nat.cast_one]

/-- Helper for Exercise 13-13.1-17: powers of the acting generator act on the normal generator by
the corresponding powers of Serre's unit `1 + p`. -/
private theorem standardNonabelianSemidirect_action_generator_pow
    (n : ℕ) :
    standard_nonabelian_zmodP2_action (p := p)
        ((Multiplicative.ofAdd (1 : ZMod p)) ^ n)
        (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) =
      (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ ((p + 1) ^ n) := by
  change Multiplicative.ofAdd
        (((standard_nonabelian_zmodP2_units_hom (p := p)
            ((Multiplicative.ofAdd (1 : ZMod p)) ^ n) : (ZMod (p ^ 2))ˣ) :
            ZMod (p ^ 2)) *
          (1 : ZMod (p ^ 2))) =
      (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ ((p + 1) ^ n)
  rw [map_pow, standardNonabelianSemidirect_unitsHom_generator (p := p)]
  simp [standard_nonabelian_zmodP2_unit, ZMod.coe_unitOfCoprime, ofAdd_one_pow, Nat.cast_add,
    Nat.cast_one, Units.val_pow_eq_pow_val]

/-- Helper for Exercise 13-13.1-17: the detector generator relation as a semiconjugation
statement. -/
private theorem standardNonabelianSemidirectDetectorUnit_semiconj_generator :
    SemiconjBy (standardNonabelianSemidirectDetectorVUnit (p := p))
      (standardNonabelianSemidirectDetectorUUnit (p := p))
      (standardNonabelianSemidirectDetectorUUnit (p := p) ^ (p + 1)) := by
  unfold SemiconjBy
  exact standardNonabelianSemidirectDetectorUnit_generatorCompatibility (p := p)

/-- Helper for Exercise 13-13.1-17: iterated conjugation by the detector acting generator sends
`U` to the same powers as the standard `1 + p` action. -/
private theorem standardNonabelianSemidirectDetectorUnit_semiconj_pow
    (n : ℕ) :
    SemiconjBy (standardNonabelianSemidirectDetectorVUnit (p := p) ^ n)
      (standardNonabelianSemidirectDetectorUUnit (p := p))
      (standardNonabelianSemidirectDetectorUUnit (p := p) ^ ((p + 1) ^ n)) := by
  induction n with
  | zero =>
      simpa using
        (SemiconjBy.one_left (standardNonabelianSemidirectDetectorUUnit (p := p)))
  | succ n ih =>
      have hstep :
          SemiconjBy (standardNonabelianSemidirectDetectorVUnit (p := p))
            (standardNonabelianSemidirectDetectorUUnit (p := p) ^ ((p + 1) ^ n))
            ((standardNonabelianSemidirectDetectorUUnit (p := p) ^ (p + 1)) ^
              ((p + 1) ^ n)) :=
        (standardNonabelianSemidirectDetectorUnit_semiconj_generator (p := p)).pow_right
          ((p + 1) ^ n)
      simpa [pow_succ', pow_mul, Nat.pow_succ'] using hstep.mul_left ih

/-- Helper for Exercise 13-13.1-17: the detector conjugation formula for powers of the acting
generator. -/
private theorem standardNonabelianSemidirectDetectorUnit_conj_pow
    (n : ℕ) :
    (MulAut.conj (standardNonabelianSemidirectDetectorVUnit (p := p) ^ n))
        (standardNonabelianSemidirectDetectorUUnit (p := p)) =
      standardNonabelianSemidirectDetectorUUnit (p := p) ^ ((p + 1) ^ n) := by
  have hsemiconj := standardNonabelianSemidirectDetectorUnit_semiconj_pow (p := p) n
  rw [MulAut.conj_apply, hsemiconj.eq, mul_assoc, mul_inv_cancel, mul_one]

/-- Helper for Exercise 13-13.1-17: the detector homs satisfy the semidirect-product
compatibility for Serre's standard action. -/
private theorem standardNonabelianSemidirectDetector_semidirectCompatibility
    (g : Multiplicative (ZMod p)) :
    (standardNonabelianSemidirectDetectorNormalHom (p := p)).comp
        ((standard_nonabelian_zmodP2_action (p := p) g).toMonoidHom) =
      ((MulAut.conj (standardNonabelianSemidirectDetectorActingHom (p := p) g)).toMonoidHom).comp
        (standardNonabelianSemidirectDetectorNormalHom (p := p)) := by
  apply (MonoidHom.eq_iff_eq_on_generator
      (standardNonabelianSemidirect_zmodP2_mem_zpowers_one (p := p)) _ _).2
  let a : Multiplicative (ZMod (p ^ 2)) := Multiplicative.ofAdd (1 : ZMod (p ^ 2))
  let b : Multiplicative (ZMod p) := Multiplicative.ofAdd (1 : ZMod p)
  have hgpow : b ^ g.toAdd.val = g := by
    calc
      b ^ g.toAdd.val = Multiplicative.ofAdd ((g.toAdd.val : ℕ) : ZMod p) := by
        simpa [b] using ofAdd_one_pow_mod_p (p := p) g.toAdd.val
      _ = Multiplicative.ofAdd g.toAdd := by
        rw [ZMod.natCast_zmod_val]
      _ = g := by
        simp
  rw [← hgpow]
  calc
    (standardNonabelianSemidirectDetectorNormalHom (p := p))
        (standard_nonabelian_zmodP2_action (p := p) (b ^ g.toAdd.val) a)
        = (standardNonabelianSemidirectDetectorNormalHom (p := p))
            (a ^ ((p + 1) ^ g.toAdd.val)) := by
              rw [standardNonabelianSemidirect_action_generator_pow (p := p)]
    _ = standardNonabelianSemidirectDetectorUUnit (p := p) ^ ((p + 1) ^ g.toAdd.val) := by
          rw [map_pow, standardNonabelianSemidirectDetectorNormalHom_generator (p := p)]
    _ = (MulAut.conj (standardNonabelianSemidirectDetectorVUnit (p := p) ^ g.toAdd.val))
          (standardNonabelianSemidirectDetectorUUnit (p := p)) := by
          rw [standardNonabelianSemidirectDetectorUnit_conj_pow (p := p)]
    _ = (MulAut.conj
          (standardNonabelianSemidirectDetectorActingHom (p := p) (b ^ g.toAdd.val)))
          ((standardNonabelianSemidirectDetectorNormalHom (p := p)) a) := by
          have hact :
              standardNonabelianSemidirectDetectorActingHom (p := p) (b ^ g.toAdd.val) =
                standardNonabelianSemidirectDetectorVUnit (p := p) ^ g.toAdd.val := by
            rw [map_pow]
            exact congrArg (fun u => u ^ g.toAdd.val)
              (standardNonabelianSemidirectDetectorActingHom_generator (p := p))
          have hnorm :
              (standardNonabelianSemidirectDetectorNormalHom (p := p)) a =
                standardNonabelianSemidirectDetectorUUnit (p := p) := by
            simpa [a] using standardNonabelianSemidirectDetectorNormalHom_generator (p := p)
          rw [hact, hnorm]

/-- Helper for Exercise 13-13.1-17: the detector representation of Serre's standard semidirect
product by units of the filtered endomorphism algebra. -/
private noncomputable def standardNonabelianSemidirectDetectorUnitHom :
    StandardGPrime →* (standardNonabelianSemidirectDetectorEnd (p := p))ˣ :=
  SemidirectProduct.lift
    (standardNonabelianSemidirectDetectorNormalHom (p := p))
    (standardNonabelianSemidirectDetectorActingHom (p := p))
    (standardNonabelianSemidirectDetector_semidirectCompatibility (p := p))

/-- Helper for Exercise 13-13.1-17: the detector representation sends Serre's distinguished
normal generator to `U`. -/
private theorem standardNonabelianSemidirectDetectorUnitHom_inl_one :
    standardNonabelianSemidirectDetectorUnitHom (p := p)
        (standard_nonabelian_semidirect_inl_one (p := p)) =
      standardNonabelianSemidirectDetectorUUnit (p := p) := by
  simp [standardNonabelianSemidirectDetectorUnitHom, standard_nonabelian_semidirect_inl_one,
    standardNonabelianSemidirectDetectorNormalHom_generator]

/-- Helper for Exercise 13-13.1-17: the detector representation, viewed in the endomorphism
algebra. -/
private noncomputable def standardNonabelianSemidirectDetectorMonoidHom :
    StandardGPrime →* standardNonabelianSemidirectDetectorEnd (p := p) :=
  (Units.coeHom (standardNonabelianSemidirectDetectorEnd (p := p))).comp
    (standardNonabelianSemidirectDetectorUnitHom (p := p))

/-- Helper for Exercise 13-13.1-17: Serre's distinguished normal generator maps to `1 + N`. -/
private theorem standardNonabelianSemidirectDetectorMonoidHom_inl_one :
    standardNonabelianSemidirectDetectorMonoidHom (p := p)
        (standard_nonabelian_semidirect_inl_one (p := p)) =
      standardNonabelianSemidirectDetectorU (p := p) := by
  rw [standardNonabelianSemidirectDetectorMonoidHom, MonoidHom.comp_apply,
    standardNonabelianSemidirectDetectorUnitHom_inl_one]
  rfl

/-- Helper for Exercise 13-13.1-17: the detector algebra hom out of the modular group algebra. -/
private noncomputable def standardNonabelianSemidirectDetectorAlgHom :
    (ZMod p)[StandardGPrime] →ₐ[ZMod p] standardNonabelianSemidirectDetectorEnd (p := p) :=
  MonoidAlgebra.lift (ZMod p) (standardNonabelianSemidirectDetectorEnd (p := p)) StandardGPrime
    (standardNonabelianSemidirectDetectorMonoidHom (p := p))

/-- Helper for Exercise 13-13.1-17: the distinguished augmentation generator maps to the
degree-raising operator `N`. -/
private theorem standardNonabelianSemidirectDetectorAlgHom_yRaw :
    standardNonabelianSemidirectDetectorAlgHom (p := p)
        ((MonoidAlgebra.of (ZMod p) StandardGPrime
            (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1) =
      standardNonabelianSemidirectDetectorShift (p := p) := by
  rw [map_sub]
  rw [standardNonabelianSemidirectDetectorAlgHom, MonoidAlgebra.lift_apply]
  simp [standardNonabelianSemidirectDetectorMonoidHom_inl_one,
    standardNonabelianSemidirectDetectorU]

/-- Helper for Exercise 13-13.1-17: the detector sends the `p`-th power of Serre's distinguished
augmentation generator to `N^p`. -/
private theorem standardNonabelianSemidirectDetectorAlgHom_yRaw_pow_p :
    standardNonabelianSemidirectDetectorAlgHom (p := p)
        (((MonoidAlgebra.of (ZMod p) StandardGPrime
            (standard_nonabelian_semidirect_inl_one (p := p)) : (ZMod p)[StandardGPrime]) - 1) ^ p) =
      standardNonabelianSemidirectDetectorShift (p := p) ^ p := by
  rw [map_pow, standardNonabelianSemidirectDetectorAlgHom_yRaw]

/-- Helper for Exercise 13-13.1-17: filtered endomorphisms that raise every basis degree by
at least `d`. -/
private def standardNonabelianSemidirectDetectorRaises (d : ℕ) :
    Submodule (ZMod p) (standardNonabelianSemidirectDetectorEnd (p := p)) where
  carrier :=
    {T | ∀ i j : Fin (p + 1), j.1 < i.1 + d →
      (standardNonabelianSemidirectDetectorBasis (p := p)).repr
        (T ((standardNonabelianSemidirectDetectorBasis (p := p)) i)) j = 0}
  zero_mem' := by
    intro i j _
    simp
  add_mem' := by
    intro A B hA hB i j hij
    have hAj : A (Pi.single i (1 : ZMod p)) j = 0 := by
      simpa [standardNonabelianSemidirectDetectorBasis] using hA i j hij
    have hBj : B (Pi.single i (1 : ZMod p)) j = 0 := by
      simpa [standardNonabelianSemidirectDetectorBasis] using hB i j hij
    simp [standardNonabelianSemidirectDetectorBasis, hAj, hBj]
  smul_mem' := by
    intro c A hA i j hij
    have hAj : A (Pi.single i (1 : ZMod p)) j = 0 := by
      simpa [standardNonabelianSemidirectDetectorBasis] using hA i j hij
    simp [standardNonabelianSemidirectDetectorBasis, hAj]

/-- Helper for Exercise 13-13.1-17: raising by more degrees is a stronger condition. -/
private theorem standardNonabelianSemidirectDetectorRaises_mono
    {d e : ℕ} (hde : d ≤ e) :
    standardNonabelianSemidirectDetectorRaises (p := p) e ≤
      standardNonabelianSemidirectDetectorRaises (p := p) d := by
  intro T hT i j hij
  exact hT i j (by omega)

/-- Helper for Exercise 13-13.1-17: the identity endomorphism preserves the filtration. -/
private theorem standardNonabelianSemidirectDetectorRaises_one :
    (1 : standardNonabelianSemidirectDetectorEnd (p := p)) ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 0 := by
  intro i j hij
  have hne : j ≠ i := by
    intro hji
    have hval := congrArg Fin.val hji
    omega
  simp [standardNonabelianSemidirectDetectorBasis, hne]

/-- Helper for Exercise 13-13.1-17: the shift raises degree by one. -/
private theorem standardNonabelianSemidirectDetectorRaises_shift :
    standardNonabelianSemidirectDetectorShift (p := p) ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
  intro i j hij
  rw [standardNonabelianSemidirectDetectorShift_basis (p := p)]
  split_ifs with hi
  · have hne : j ≠ (⟨i.1 + 1, hi⟩ : Fin (p + 1)) := by
      intro hji
      have hval := congrArg Fin.val hji
      simp at hval
      omega
    simp [standardNonabelianSemidirectDetectorBasis, hne]
  · simp

/-- Helper for Exercise 13-13.1-17: the sparse shear also raises degree by at least one. -/
private theorem standardNonabelianSemidirectDetectorRaises_shear :
    standardNonabelianSemidirectDetectorShear (p := p) ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
  intro i j hij
  rw [standardNonabelianSemidirectDetectorShear_basis (p := p)]
  split_ifs with hi
  · subst hi
    have hne : j ≠ (⟨p, by omega⟩ : Fin (p + 1)) := by
      intro hj
      have hjval : j.1 = p := by
        simpa using congrArg Fin.val hj
      have hp1 : 1 < p + 1 := by
        have hp0 : 0 < p := (Fact.out : Nat.Prime p).pos
        omega
      have hone_val : ((1 : Fin (p + 1)).1) = 1 := by
        simp [Nat.mod_eq_of_lt hp1]
      have hjlt : j.1 < 2 := by
        have hij' := hij
        simp [hone_val] at hij'
        omega
      have hp2 : 2 ≤ p := (Fact.out : Nat.Prime p).two_le
      omega
    simp [standardNonabelianSemidirectDetectorBasis, hne]
  · simp

/-- Helper for Exercise 13-13.1-17: composing degree-raising endomorphisms adds the degree
bounds. -/
private theorem standardNonabelianSemidirectDetectorRaises_mul_mem
    {d e : ℕ} {A B : standardNonabelianSemidirectDetectorEnd (p := p)}
    (hA : A ∈ standardNonabelianSemidirectDetectorRaises (p := p) d)
    (hB : B ∈ standardNonabelianSemidirectDetectorRaises (p := p) e) :
    A * B ∈ standardNonabelianSemidirectDetectorRaises (p := p) (d + e) := by
  intro i j hij
  rw [Module.End.mul_apply]
  conv_lhs =>
    rw [← (standardNonabelianSemidirectDetectorBasis (p := p)).sum_repr
      (B ((standardNonabelianSemidirectDetectorBasis (p := p)) i))]
  simp [map_sum, map_smul]
  apply Finset.sum_eq_zero
  intro k _
  by_cases hk : k.1 < i.1 + e
  · have hBk : B (Pi.single i (1 : ZMod p)) k = 0 := by
      simpa [standardNonabelianSemidirectDetectorBasis] using hB i k hk
    rw [hBk]
    simp
  · have hjk : j.1 < k.1 + d := by omega
    have hAj : A (Pi.single k (1 : ZMod p)) j = 0 := by
      simpa [standardNonabelianSemidirectDetectorBasis] using hA k j hjk
    rw [hAj]
    simp

/-- Helper for Exercise 13-13.1-17: products of filtered submodules respect the degree bounds. -/
private theorem standardNonabelianSemidirectDetectorRaises_mul_le
    (d e : ℕ) :
    standardNonabelianSemidirectDetectorRaises (p := p) d *
        standardNonabelianSemidirectDetectorRaises (p := p) e ≤
      standardNonabelianSemidirectDetectorRaises (p := p) (d + e) := by
  exact Submodule.mul_le.mpr fun A hA B hB =>
    standardNonabelianSemidirectDetectorRaises_mul_mem (p := p) hA hB

/-- Helper for Exercise 13-13.1-17: the detector unipotent `U` preserves the filtration and is
congruent to `1` modulo degree-raising maps. -/
private theorem standardNonabelianSemidirectDetectorU_raises_zero :
    standardNonabelianSemidirectDetectorU (p := p) ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 0 := by
  exact add_mem (standardNonabelianSemidirectDetectorRaises_one (p := p))
    (standardNonabelianSemidirectDetectorRaises_mono (p := p) (show 0 ≤ 1 by omega)
      (standardNonabelianSemidirectDetectorRaises_shift (p := p)))

/-- Helper for Exercise 13-13.1-17: `U - 1` raises degree by one. -/
private theorem standardNonabelianSemidirectDetectorU_sub_one_raises_one :
    standardNonabelianSemidirectDetectorU (p := p) - 1 ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
  simpa [standardNonabelianSemidirectDetectorU, sub_eq_add_neg, add_assoc, add_left_comm,
    add_comm] using standardNonabelianSemidirectDetectorRaises_shift (p := p)

/-- Helper for Exercise 13-13.1-17: the detector unipotent `V` preserves the filtration. -/
private theorem standardNonabelianSemidirectDetectorV_raises_zero :
    standardNonabelianSemidirectDetectorV (p := p) ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 0 := by
  exact add_mem (standardNonabelianSemidirectDetectorRaises_one (p := p))
    (standardNonabelianSemidirectDetectorRaises_mono (p := p) (show 0 ≤ 1 by omega)
      (standardNonabelianSemidirectDetectorRaises_shear (p := p)))

/-- Helper for Exercise 13-13.1-17: `V - 1` raises degree by one. -/
