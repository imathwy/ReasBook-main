/-- Helper for Exercise 13-13.1-17: powers of a filtration-preserving endomorphism preserve
the filtration. -/
private theorem standardNonabelianSemidirectDetectorRaises_pow_zero
    {T : standardNonabelianSemidirectDetectorEnd (p := p)}
    (hT : T ∈ standardNonabelianSemidirectDetectorRaises (p := p) 0)
    (n : ℕ) :
    T ^ n ∈ standardNonabelianSemidirectDetectorRaises (p := p) 0 := by
  induction n with
  | zero =>
      simpa using standardNonabelianSemidirectDetectorRaises_one (p := p)
  | succ n ih =>
      rw [pow_succ]
      simpa using
        standardNonabelianSemidirectDetectorRaises_mul_mem (p := p) ih hT

/-- Helper for Exercise 13-13.1-17: powers of a filtration-preserving map congruent to `1`
modulo degree-one maps remain congruent to `1`. -/
private theorem standardNonabelianSemidirectDetectorRaises_pow_sub_one
    {T : standardNonabelianSemidirectDetectorEnd (p := p)}
    (hT0 : T ∈ standardNonabelianSemidirectDetectorRaises (p := p) 0)
    (hT1 : T - 1 ∈ standardNonabelianSemidirectDetectorRaises (p := p) 1)
    (n : ℕ) :
    T ^ n - 1 ∈ standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
  induction n with
  | zero =>
      simp
  | succ n ih =>
      have hprod : T ^ n * (T - 1) ∈
          standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
        simpa using
          standardNonabelianSemidirectDetectorRaises_mul_mem (p := p)
            (standardNonabelianSemidirectDetectorRaises_pow_zero (p := p) hT0 n) hT1
      have hsum : T ^ n * (T - 1) + (T ^ n - 1) ∈
          standardNonabelianSemidirectDetectorRaises (p := p) 1 :=
        add_mem hprod ih
      have hrewrite : T ^ (n + 1) - 1 = T ^ n * (T - 1) + (T ^ n - 1) := by
        rw [pow_succ, mul_sub, mul_one]
        abel_nf
      simpa [hrewrite]

/-- Helper for Exercise 13-13.1-17: natural powers of the normal additive generator recover every
normal element. -/
private theorem standardNonabelianSemidirect_zmodP2_pow_val
    (x : Multiplicative (ZMod (p ^ 2))) :
    (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ x.toAdd.val = x := by
  calc
    (Multiplicative.ofAdd (1 : ZMod (p ^ 2))) ^ x.toAdd.val =
        Multiplicative.ofAdd ((x.toAdd.val : ℕ) : ZMod (p ^ 2)) := by
          rw [ofAdd_one_pow (p := p)]
    _ = Multiplicative.ofAdd x.toAdd := by
          rw [ZMod.natCast_zmod_val]
    _ = x := by
          simp

/-- Helper for Exercise 13-13.1-17: natural powers of the acting additive generator recover every
acting element. -/
private theorem standardNonabelianSemidirect_zmodP_pow_val
    (x : Multiplicative (ZMod p)) :
    (Multiplicative.ofAdd (1 : ZMod p)) ^ x.toAdd.val = x := by
  calc
    (Multiplicative.ofAdd (1 : ZMod p)) ^ x.toAdd.val =
        Multiplicative.ofAdd ((x.toAdd.val : ℕ) : ZMod p) := by
          rw [ofAdd_one_pow_mod_p (p := p)]
    _ = Multiplicative.ofAdd x.toAdd := by
          rw [ZMod.natCast_zmod_val]
    _ = x := by
          simp

/-- Helper for Exercise 13-13.1-17: the normal-factor detector image preserves the filtration. -/
private theorem standardNonabelianSemidirectDetectorNormalHom_raises_zero
    (x : Multiplicative (ZMod (p ^ 2))) :
    ((standardNonabelianSemidirectDetectorNormalHom (p := p) x :
        (standardNonabelianSemidirectDetectorEnd (p := p))ˣ) :
      standardNonabelianSemidirectDetectorEnd (p := p)) ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 0 := by
  rw [← standardNonabelianSemidirect_zmodP2_pow_val (p := p) x, map_pow,
    standardNonabelianSemidirectDetectorNormalHom_generator (p := p)]
  change standardNonabelianSemidirectDetectorU (p := p) ^ x.toAdd.val ∈
    standardNonabelianSemidirectDetectorRaises (p := p) 0
  exact standardNonabelianSemidirectDetectorRaises_pow_zero (p := p)
    (standardNonabelianSemidirectDetectorU_raises_zero (p := p)) x.toAdd.val

/-- Helper for Exercise 13-13.1-17: the normal-factor detector image is congruent to `1` modulo
degree-one maps. -/
private theorem standardNonabelianSemidirectDetectorNormalHom_sub_one_raises_one
    (x : Multiplicative (ZMod (p ^ 2))) :
    ((standardNonabelianSemidirectDetectorNormalHom (p := p) x :
        (standardNonabelianSemidirectDetectorEnd (p := p))ˣ) :
      standardNonabelianSemidirectDetectorEnd (p := p)) - 1 ∈
      standardNonabelianSemidirectDetectorRaises (p := p) 1 := by
