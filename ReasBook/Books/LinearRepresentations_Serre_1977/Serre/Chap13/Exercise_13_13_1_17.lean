/-- Helper for Exercise 13-13.1-17: the acting-factor detector image is congruent to `1` modulo
degree-one maps. -/
private theorem standardNonabelianSemidirectDetectorActingHom_sub_one_raises_one
    (x : Multiplicative (ZMod p)) :
    ((standardNonabelianSemidirectDetectorActingHom (p := p) x :
        (standardNonabelianSemidirectDetectorEnd (p := p))ˣ) :
      standardNonabelianSemidirectDetectorEnd (p := p)) - 1 ∈
