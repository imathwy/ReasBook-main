variable (φ : Multiplicative (ZMod p) →* MulAut (Multiplicative (ZMod (p ^ 2))))

local notation "GPrime" =>
  Multiplicative (ZMod (p ^ 2)) ⋊[φ] Multiplicative (ZMod p)
local notation "StandardGPrime" =>
  Multiplicative (ZMod (p ^ 2)) ⋊[standard_nonabelian_zmodP2_action (p := p)] Multiplicative
    (ZMod p)

/-- Helper for Exercise 13-13.1-17: once Serre's packet comparison map on the canonical standard
semidirect model is injective, finite-dimensionality upgrades it to the desired
Artin-Wedderburn equivalence. -/
private theorem standard_nonabelian_zmod_semidirectProduct_rational_packet_data
    (hp2 : p ≠ 2) :
    ∃ Φ :
      ℚ[StandardGPrime] →ₐ[ℚ] RationalPacketTarget (p := p),
      Function.Injective Φ := by
  refine ⟨standardSemidirectRationalPacketAlgHom (p := p), ?_⟩
  intro x y hxy
  let z : ℚ[StandardGPrime] := x - y
  have hz_packet : standardSemidirectRationalPacketAlgHom (p := p) z = 0 := by
    simp [z, map_sub, hxy]
  have htriv :
      (rationalTrivialGroupAlgebraAlgHom : ℚ[StandardGPrime] →ₐ[ℚ] ℚ) z = 0 := by
    have hz0 := congrArg Prod.fst hz_packet
    simpa [standardSemidirectRationalPacketAlgHom] using hz0
  have hlin : standardSemidirect_linearPacketAlgHom (p := p) z = 0 := by
    have hz0 := congrArg (fun w : RationalPacketTarget (p := p) => w.2.1) hz_packet
    simpa [standardSemidirectRationalPacketAlgHom] using hz0
  have hmat : standardSemidirectRationalMatrixAlgHom (p := p) z = 0 := by
    have hz0 := congrArg (fun w : RationalPacketTarget (p := p) => w.2.2) hz_packet
    simpa [standardSemidirectRationalPacketAlgHom] using hz0
  have htriv_sum : (∑ g : StandardGPrime, z g) = 0 := by
    rw [rationalTrivialGroupAlgebraAlgHom, MonoidAlgebra.lift_apply] at htriv
    simpa [Finsupp.sum_fintype, Algebra.smul_def] using htriv
  let f : ZMod p × ZMod p × ZMod p → ℚ := fun q =>
    z (standardSemidirectOfCoords (p := p) q.1 q.2.1 q.2.2)
  have htotal : (∑ q : ZMod p × ZMod p × ZMod p, f q) = 0 := by
    have hcoord := standardSemidirect_sum_coord (p := p)
      (fun g : StandardGPrime => z g)
    have hcoord' :
        (∑ g : StandardGPrime, z g) =
          ∑ q : ZMod p × ZMod p × ZMod p, f q := by
      simpa [f, standardSemidirectCoordEquiv] using hcoord
    rwa [← hcoord']
  let Fplane : ZMod p × ZMod p → ℚ := fun q => ∑ s : ZMod p, f (q.2, s, q.1)
  have htotalPlane : (∑ q : ZMod p × ZMod p, Fplane q) = 0 := by
    have hrewrite :
        (∑ q : ZMod p × ZMod p, Fplane q) =
          ∑ q : ZMod p × ZMod p × ZMod p, f q := by
      calc
        (∑ q : ZMod p × ZMod p, Fplane q)
            = ∑ k : ZMod p, ∑ r : ZMod p, ∑ s : ZMod p, f (r, s, k) := by
                rw [Fintype.sum_prod_type]
        _ = ∑ r : ZMod p, ∑ k : ZMod p, ∑ s : ZMod p, f (r, s, k) := by
                rw [Finset.sum_comm]
        _ = ∑ r : ZMod p, ∑ s : ZMod p, ∑ k : ZMod p, f (r, s, k) := by
                apply Finset.sum_congr rfl
                intro r _
                rw [Finset.sum_comm]
        _ = ∑ q : ZMod p × ZMod p × ZMod p, f q := by
                rw [zmodP_sum_triple (p := p) f]
    rwa [hrewrite]
  have hfinitePlane : ∀ a : ZMod p,
      ∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) (q.2 + a * q.1) = 0 := by
    intro a
    have hlin_a :
        standardSemidirect_linearPacketAlgHom (p := p) z
            (⟨a.val, Nat.lt_trans (ZMod.val_lt a) (Nat.lt_succ_self p)⟩ : Fin (p + 1)) = 0 := by
      simpa using congrFun hlin
        (⟨a.val, Nat.lt_trans (ZMod.val_lt a) (Nat.lt_succ_self p)⟩ : Fin (p + 1))
    rw [standardSemidirect_linearPacketAlgHom_finite_coord] at hlin_a
    have hrewrite :
        (∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (q.2 + a * q.1)) =
          ∑ q : ZMod p × ZMod p × ZMod p,
            (f q : CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) (q.1 + a * q.2.2) := by
      calc
        (∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) (q.2 + a * q.1))
            = ∑ k : ZMod p, ∑ r : ZMod p,
                ((∑ s : ZMod p, f (r, s, k) : ℚ) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (r + a * k) := by
                rw [Fintype.sum_prod_type]
        _ = ∑ k : ZMod p, ∑ r : ZMod p, ∑ s : ZMod p,
                (f (r, s, k) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (r + a * k) := by
                simp [Finset.sum_mul]
        _ = ∑ r : ZMod p, ∑ k : ZMod p, ∑ s : ZMod p,
                (f (r, s, k) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (r + a * k) := by
                rw [Finset.sum_comm]
        _ = ∑ r : ZMod p, ∑ s : ZMod p, ∑ k : ZMod p,
                (f (r, s, k) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) (r + a * k) := by
                apply Finset.sum_congr rfl
                intro r _
                rw [Finset.sum_comm]
        _ = ∑ q : ZMod p × ZMod p × ZMod p,
              (f q : CyclotomicField p ℚ) *
                zmodP_cyclotomic_character_val (p := p) (q.1 + a * q.2.2) := by
                rw [zmodP_sum_triple (p := p) (fun q : ZMod p × ZMod p × ZMod p =>
                  (f q : CyclotomicField p ℚ) *
                    zmodP_cyclotomic_character_val (p := p) (q.1 + a * q.2.2))]
    rw [hrewrite]
    simpa [f] using hlin_a
  have hinftyPlane :
      ∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
        zmodP_cyclotomic_character_val (p := p) q.1 = 0 := by
    have hlin_inf :
        standardSemidirect_linearPacketAlgHom (p := p) z
            (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1)) = 0 := by
      simpa using congrFun hlin (⟨p, Nat.lt_succ_self p⟩ : Fin (p + 1))
    rw [standardSemidirect_linearPacketAlgHom_infty_coord] at hlin_inf
    have hrewrite :
        (∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) q.1) =
          ∑ q : ZMod p × ZMod p × ZMod p,
            (f q : CyclotomicField p ℚ) *
              zmodP_cyclotomic_character_val (p := p) q.2.2 := by
      calc
        (∑ q : ZMod p × ZMod p, (Fplane q : CyclotomicField p ℚ) *
          zmodP_cyclotomic_character_val (p := p) q.1)
            = ∑ k : ZMod p, ∑ r : ZMod p,
                ((∑ s : ZMod p, f (r, s, k) : ℚ) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) k := by
                rw [Fintype.sum_prod_type]
        _ = ∑ k : ZMod p, ∑ r : ZMod p, ∑ s : ZMod p,
                (f (r, s, k) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) k := by
                simp [Finset.sum_mul]
        _ = ∑ r : ZMod p, ∑ k : ZMod p, ∑ s : ZMod p,
                (f (r, s, k) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) k := by
                rw [Finset.sum_comm]
        _ = ∑ r : ZMod p, ∑ s : ZMod p, ∑ k : ZMod p,
                (f (r, s, k) : CyclotomicField p ℚ) *
                  zmodP_cyclotomic_character_val (p := p) k := by
                apply Finset.sum_congr rfl
                intro r _
                rw [Finset.sum_comm]
        _ = ∑ q : ZMod p × ZMod p × ZMod p,
              (f q : CyclotomicField p ℚ) *
                zmodP_cyclotomic_character_val (p := p) q.2.2 := by
                rw [zmodP_sum_triple (p := p) (fun q : ZMod p × ZMod p × ZMod p =>
                  (f q : CyclotomicField p ℚ) *
                    zmodP_cyclotomic_character_val (p := p) q.2.2)]
    rw [hrewrite]
    simpa [f] using hlin_inf
  have hFplane_zero : Fplane = 0 :=
    zmodP_projective_plane_cyclotomic_sums_zero (p := p) Fplane htotalPlane
