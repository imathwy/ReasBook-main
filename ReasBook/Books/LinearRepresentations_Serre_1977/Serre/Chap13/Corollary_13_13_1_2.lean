section

variable {G : Type u} [Group G]

namespace Subgroup

/-- Two subgroups of `G` are conjugate when they lie in the same orbit for the conjugation action
of `G` on `Subgroup G`. -/
def IsConj (H K : Subgroup G) : Prop :=
  MulAction.orbitRel (ConjAct G) (Subgroup G) H K

theorem isConj_iff_orbitRel {H K : Subgroup G} :
    H.IsConj K ↔ MulAction.orbitRel (ConjAct G) (Subgroup G) H K :=
  Iff.rfl

theorem IsConj.refl (H : Subgroup G) : H.IsConj H := by
  rw [isConj_iff_orbitRel, MulAction.orbitRel_apply]
  exact ⟨1, by simp⟩

theorem IsConj.symm {H K : Subgroup G} (h : H.IsConj K) : K.IsConj H := by
  rw [isConj_iff_orbitRel, MulAction.orbitRel_apply] at h ⊢
  rcases h with ⟨g, hg⟩
  refine ⟨g⁻¹, ?_⟩
  simpa using (congrArg (fun S : Subgroup G ↦ g⁻¹ • S) hg).symm

private theorem isCyclic_conj_smul (g : ConjAct G) {H : Subgroup G} (hH : IsCyclic H) :
    IsCyclic ↥(g • H) := by
  rcases (Subgroup.isCyclic_iff_exists_zpowers_eq_top H).1 hH with ⟨x, rfl⟩
  refine (Subgroup.isCyclic_iff_exists_zpowers_eq_top _).2 ⟨g • x, ?_⟩
  rw [Subgroup.pointwise_smul_def]
  exact (MonoidHom.map_zpowers (MulDistribMulAction.toMonoidEnd (ConjAct G) G g) x).symm

instance anonInst_Corollary_13_13_1_2_1 : SMul (ConjAct G) { H : Subgroup G // IsCyclic H } where
  smul g H := ⟨g • H.1, isCyclic_conj_smul g H.2⟩

instance anonInst_Corollary_13_13_1_2_2 : MulAction (ConjAct G) { H : Subgroup G // IsCyclic H } :=
  Subtype.val_injective.mulAction _ fun _ _ ↦ rfl

/-- The conjugacy classes of cyclic subgroups of `G`. -/
abbrev CyclicConjClasses (G : Type u) [Group G] :=
  MulAction.orbitRel.Quotient (ConjAct G) { H : Subgroup G // IsCyclic H }

namespace CyclicConjClasses

/-- The conjugacy class of a cyclic subgroup of `G`. -/
  abbrev mk {G : Type u} [Group G] (H : { H : Subgroup G // IsCyclic H }) :
    Subgroup.CyclicConjClasses G :=
  Quotient.mk _ H

/-- Two cyclic subgroups define the same element of `Subgroup.CyclicConjClasses G` exactly when
their underlying subgroups are conjugate. -/
theorem mk_eq_mk_iff_isConj {G : Type u} [Group G]
    {H K : { H : Subgroup G // IsCyclic H }} :
    mk H = mk K ↔ H.1.IsConj K.1 := by
  rw [Quotient.eq'', MulAction.orbitRel_apply]
  constructor
  · rintro ⟨g, hg⟩
    exact ⟨g, congrArg Subtype.val hg⟩
  · rintro ⟨g, hg⟩
    exact ⟨g, Subtype.ext hg⟩

end CyclicConjClasses

end Subgroup

variable [NeZero (Monoid.exponent G)]

/-- Helper for Corollary 13-13.1-2: conjugating a generated cyclic subgroup gives the cyclic
subgroup generated by the conjugated element. -/
private theorem conj_smul_zpowers (g : ConjAct G) (x : G) :
    g • Subgroup.zpowers x = Subgroup.zpowers (g • x) := by
  -- Rewrite the subgroup action through the monoid endomorphism induced by conjugation.
  rw [Subgroup.pointwise_smul_def]
  exact MonoidHom.map_zpowers (MulDistribMulAction.toMonoidEnd (ConjAct G) G g) x

/-- Helper for Corollary 13-13.1-2: ordinary conjugate elements generate conjugate cyclic
subgroups. -/
private theorem zpowers_isConj_of_isConj {x y : G} (hxy : IsConj x y) :
    (Subgroup.zpowers x).IsConj (Subgroup.zpowers y) := by
  -- Unpack the conjugating element and transport the generated subgroup along it.
  rcases isConj_iff.mp hxy.symm with ⟨g, hg⟩
  rw [Subgroup.isConj_iff_orbitRel, MulAction.orbitRel_apply]
  refine ⟨ConjAct.toConjAct g, ?_⟩
  calc
    ConjAct.toConjAct g • Subgroup.zpowers y = Subgroup.zpowers (ConjAct.toConjAct g • y) :=
      conj_smul_zpowers (ConjAct.toConjAct g) y
    _ = Subgroup.zpowers x := by simpa [ConjAct.toConjAct_smul, hg]

/-- Helper for Corollary 13-13.1-2: a `Γ_ℚ(G)`-power generates the same cyclic subgroup as the
original element. -/
private theorem zpowers_pow_gammaRat_eq (x : G) (t : Γ_ℚ(G)) :
    Subgroup.zpowers (x ^ t) = Subgroup.zpowers x := by
  -- One inclusion is immediate because `x ^ t` is an ordinary power of `x`.
  apply le_antisymm
  · rw [Subgroup.zpowers_le]
    simp [pow_unit_eq_pow_nat]
  · rw [Subgroup.zpowers_le]
    have hcop_exp :
        Nat.Coprime
          (((t : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)).val)
          (Monoid.exponent G) :=
      ZMod.val_coe_unit_coprime (t : (ZMod (Monoid.exponent G))ˣ)
    have hcop_ord :
        Nat.Coprime
          (((t : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)).val)
          (orderOf x) :=
      Nat.Coprime.of_dvd_right (Monoid.order_dvd_exponent x) hcop_exp
    -- Invertibility modulo `orderOf x` says the original generator lies in the subgroup of the
    -- powered element.
    simpa [pow_unit_eq_pow_nat] using
      (mem_zpowers_pow_iff.mpr hcop_ord :
        x ∈ Subgroup.zpowers
          (x ^ (((t : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)).val)))

/-- Helper for Corollary 13-13.1-2: an exponent coprime to `orderOf y` can be realized by a
`Γ_ℚ(G)`-power on `y`. -/
private theorem gammaRat_power_eq_pow_of_coprime (y : G) {n : ℕ}
    (hcop : Nat.Coprime n (orderOf y)) :
    ∃ t : Γ_ℚ(G), y ^ t = y ^ n := by
  -- Lift the unit modulo `orderOf y` to a unit modulo `Monoid.exponent G`.
  let uOrd : (ZMod (orderOf y))ˣ := ZMod.unitOfCoprime n hcop
  have hdiv : orderOf y ∣ Monoid.exponent G := Monoid.order_dvd_exponent y
  obtain ⟨uExp, huExp⟩ :=
    ZMod.unitsMap_surjective (m := Monoid.exponent G) (n := orderOf y) hdiv uOrd
  refine ⟨uExp, ?_⟩
  have hmod :
      galoisPowerExponentUnit uExp ≡ n [MOD orderOf y] := by
    rw [← ZMod.natCast_eq_natCast_iff]
    calc
      ((galoisPowerExponentUnit uExp : ℕ) : ZMod (orderOf y)) =
          ((((uExp : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)).cast :
            ZMod (orderOf y))) := by
              simp [galoisPowerExponentUnit]
      (((uExp : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)).cast :
          ZMod (orderOf y)) =
          ↑(ZMod.unitsMap hdiv uExp) := by
            symm
            exact ZMod.unitsMap_val hdiv uExp
      _ = (uOrd : ZMod (orderOf y)) := by rw [huExp]
      _ = n := by simp [uOrd]
  -- Equal exponents modulo `orderOf y` give the same power of `y`.
  simpa [pow_unit_eq_pow_nat] using
    (pow_eq_pow_of_modEq hmod (pow_orderOf_eq_one y) : y ^ galoisPowerExponentUnit uExp = y ^ n)

/-- Helper for Corollary 13-13.1-2: equal generated cyclic subgroups differ by a `Γ_ℚ(G)`-power.
-/
private theorem exists_gammaRat_power_eq_of_zpowers_eq {x y : G}
    (hxy : Subgroup.zpowers x = Subgroup.zpowers y) :
    ∃ t : Γ_ℚ(G), x = y ^ t := by
  classical
  let hExp : Monoid.ExponentExists G :=
    (Monoid.exponent_ne_zero (G := G)).mp (by exact NeZero.ne (Monoid.exponent G))
  have hy_fin : IsOfFinOrder y := hExp.isOfFinOrder (g := y)
  have hx_mem : x ∈ Subgroup.zpowers y := by
    simpa [hxy] using (Subgroup.mem_zpowers x : x ∈ Subgroup.zpowers x)
  have hy_mem : y ∈ Subgroup.zpowers x := by
    simpa [hxy] using (Subgroup.mem_zpowers y : y ∈ Subgroup.zpowers y)
  have hx_range : x ∈ (Finset.range (orderOf y)).image (y ^ ·) :=
    (hy_fin.mem_zpowers_iff_mem_range_orderOf (y := x)).mp hx_mem
  obtain ⟨n, hn_range, hxn⟩ := Finset.mem_image.mp hx_range
  have hy_mem_pow : y ∈ Subgroup.zpowers (y ^ n) := by
    simpa [hxn] using hy_mem
  have hcop : Nat.Coprime n (orderOf y) := by
    rw [Nat.coprime_iff_gcd_eq_one]
    exact mem_zpowers_pow_iff.mp hy_mem_pow
  -- A generator of the same cyclic subgroup is a `Γ_ℚ(G)`-power of `y`.
  obtain ⟨t, ht⟩ := gammaRat_power_eq_pow_of_coprime y hcop
  refine ⟨t, ?_⟩
  calc
    x = y ^ n := hxn.symm
    _ = y ^ t := ht.symm

-- Proof sketch: by Theorem `13-13.1-1`, for `K = ℚ` the allowed Galois exponents are all units of
-- `ZMod (Monoid.exponent G)`. An element generates the same cyclic subgroup as precisely the
-- powers by exponents invertible modulo its order, so ordinary conjugacy after such a power twist
-- is
-- equivalent to conjugacy of the generated cyclic subgroups.
/-- Corollary 13-13.1-2: if `G` has nonzero exponent, then two elements of `G` are
`Γ_ℚ`-conjugate, meaning that one is conjugate to a power of the other by an exponent in
`(ZMod (Monoid.exponent G))ˣ`, if and only if the cyclic subgroups they generate are conjugate. -/
theorem gammaRat_conjugate_iff_conjugate_zpowers (x y : G) :
    (∃ t : Γ_ℚ(G), IsConj x (y ^ t)) ↔
      (Subgroup.zpowers x).IsConj (Subgroup.zpowers y) := by
  constructor
  · rintro ⟨t, hxyt⟩
    -- Pass element-conjugacy to generated cyclic subgroups, then remove the harmless
    -- `Γ_ℚ(G)`-power twist on `y`.
    have hconj :
        (Subgroup.zpowers x).IsConj (Subgroup.zpowers (y ^ t)) :=
      zpowers_isConj_of_isConj hxyt
    rw [Subgroup.isConj_iff_orbitRel, MulAction.orbitRel_apply] at hconj ⊢
    rcases hconj with ⟨g : ConjAct G, hg⟩
    refine ⟨g, ?_⟩
    calc
      g • Subgroup.zpowers y = g • Subgroup.zpowers (y ^ t) := by
        rw [zpowers_pow_gammaRat_eq y t]
      _ = Subgroup.zpowers x := hg
  · intro hxy
    rw [Subgroup.isConj_iff_orbitRel, MulAction.orbitRel_apply] at hxy
    rcases hxy with ⟨g : ConjAct G, hg⟩
    have hzpow :
        Subgroup.zpowers x = Subgroup.zpowers ((g : ConjAct G) • y) := by
      -- The subgroup conjugacy witness identifies the cyclic subgroup of `x` with that of a
      -- conjugate of `y`.
      calc
        Subgroup.zpowers x = g • Subgroup.zpowers y := hg.symm
        _ = Subgroup.zpowers ((g : ConjAct G) • y) := by
          simpa using conj_smul_zpowers (g := (g : ConjAct G)) y
    obtain ⟨t, hxt⟩ := exists_gammaRat_power_eq_of_zpowers_eq hzpow
    have hpow_conj :
        ((g • y) ^ t : G) = ConjAct.ofConjAct g * (y ^ t) * (ConjAct.ofConjAct g)⁻¹ := by
      -- `Γ_ℚ(G)`-powers are ordinary natural powers, and ordinary conjugation commutes with
      -- taking powers.
      rw [pow_unit_eq_pow_nat, pow_unit_eq_pow_nat]
      rw [ConjAct.smul_def]
      simpa using
        (conj_pow (a := ConjAct.ofConjAct g) (b := y) (i := galoisPowerExponentUnit t))
    -- Rewrite `x` as a conjugate of `y ^ t`, then package that equality as element-conjugacy.
    refine ⟨t, isConj_iff.mpr ⟨(ConjAct.ofConjAct g)⁻¹, ?_⟩⟩
    calc
      (ConjAct.ofConjAct g)⁻¹ * x * ((ConjAct.ofConjAct g)⁻¹)⁻¹ =
          (ConjAct.ofConjAct g)⁻¹ * ((g • y) ^ t : G) * ((ConjAct.ofConjAct g)⁻¹)⁻¹ := by
            rw [hxt]
      _ = (ConjAct.ofConjAct g)⁻¹ *
            (ConjAct.ofConjAct g * (y ^ t) * (ConjAct.ofConjAct g)⁻¹) *
            ((ConjAct.ofConjAct g)⁻¹)⁻¹ := by rw [hpow_conj]
      _ = y ^ t := by group

end
