local notation "A4" => alternatingGroup (Fin 4)
local notation "V4" => alternatingGroup.kleinFour (Fin 4)

private theorem a4_mem_kleinFour_of_cycleType_two_two {g : Perm (Fin 4)}
    (hg : g ∈ A4) (hcycle : g.cycleType = {2, 2}) :
    (⟨g, hg⟩ : A4) ∈ V4 := by
  change (⟨g, hg⟩ : A4) ∈
    Subgroup.closure {h : A4 | ((h : A4) : Perm (Fin 4)).cycleType = {2, 2}}
  exact Subgroup.subset_closure (by
    simp [hcycle])

private def a4_v4_of_cycleType_two_two (g : Perm (Fin 4))
    (hg : g ∈ A4) (hcycle : g.cycleType = {2, 2}) : V4 :=
  ⟨⟨g, hg⟩, a4_mem_kleinFour_of_cycleType_two_two hg hcycle⟩

/-- The source element `x = (12)(34)` of the Klein four subgroup `H = {1, x, y, z}`. -/
def a4_v4_x : V4 :=
  a4_v4_of_cycleType_two_two (swap (0 : Fin 4) 1 * swap 2 3)
    (by
      rw [Perm.mem_alternatingGroup]
      decide)
    (by decide)

/-- The source element `y = (13)(24)` of the Klein four subgroup `H = {1, x, y, z}`. -/
def a4_v4_y : V4 :=
  a4_v4_of_cycleType_two_two (swap (0 : Fin 4) 2 * swap 1 3)
    (by
      rw [Perm.mem_alternatingGroup]
      decide)
    (by decide)

/-- The source element `z = (14)(23)` of the Klein four subgroup `H = {1, x, y, z}`. -/
def a4_v4_z : V4 :=
  a4_v4_of_cycleType_two_two (swap (0 : Fin 4) 3 * swap 1 2)
    (by
      rw [Perm.mem_alternatingGroup]
      decide)
    (by decide)

/-- The values of Serre's degree-one character `θ` on the Klein four subgroup `H`. -/
private def a4_theta_value (h : V4) : ℂˣ :=
  if h = 1 ∨ h = a4_v4_x then
    1
  else
    -1

/-- Helper for Exercise 5-5.7-1: every element of the Klein four subgroup is one of the source
elements `1`, `x`, `y`, or `z`. -/
private lemma a4_v4_eq_one_or_source
    (h : V4) :
    h = 1 ∨ h = a4_v4_x ∨ h = a4_v4_y ∨ h = a4_v4_z := by
  by_cases h1 : h = 1
  · exact Or.inl h1
  by_cases hx : h = a4_v4_x
  · exact Or.inr <| Or.inl hx
  by_cases hy : h = a4_v4_y
  · exact Or.inr <| Or.inr <| Or.inl hy
  letI : IsKleinFour V4 :=
    alternatingGroup.kleinFour_isKleinFour (α := Fin 4) (by simp)
  have hz : h = a4_v4_z := by
    -- Once `1`, `x`, and `y` are excluded, the Klein-four multiplication table forces `z`.
    calc
      h = a4_v4_x * a4_v4_y := by
        exact IsKleinFour.eq_mul_of_ne_all
          (x := a4_v4_x) (y := a4_v4_y) (z := h)
          (by decide) (by decide) (by decide) h1 hx hy
      _ = a4_v4_z := by
        symm
        simpa [mul_comm] using
          (IsKleinFour.eq_mul_of_ne_all
            (x := a4_v4_x) (y := a4_v4_y) (z := a4_v4_z)
            (by decide) (by decide) (by decide) (by decide) (by decide) (by decide))
  exact Or.inr <| Or.inr <| Or.inr hz

/-- Helper for Exercise 5-5.7-1: the nontrivial source elements square to `1` in `V₄`. -/
private lemma a4_v4_mul_self_eq_one :
    a4_v4_x * a4_v4_x = 1 ∧ a4_v4_y * a4_v4_y = 1 ∧ a4_v4_z * a4_v4_z = 1 := by
  -- These are direct computations in the explicit permutation model of `A₄`.
  decide

/-- Helper for Exercise 5-5.7-1: the product `x y` is the third nontrivial element `z`. -/
private lemma a4_v4_x_mul_y : a4_v4_x * a4_v4_y = a4_v4_z := by
  -- This is the explicit multiplication table in the Klein four subgroup.
  decide

/-- Helper for Exercise 5-5.7-1: the product `x z` is the third nontrivial element `y`. -/
private lemma a4_v4_x_mul_z : a4_v4_x * a4_v4_z = a4_v4_y := by
  -- This is the explicit multiplication table in the Klein four subgroup.
  decide

/-- Helper for Exercise 5-5.7-1: the product `y z` is the third nontrivial element `x`. -/
private lemma a4_v4_y_mul_z : a4_v4_y * a4_v4_z = a4_v4_x := by
  -- This is the explicit multiplication table in the Klein four subgroup.
  decide

/-- Helper for Exercise 5-5.7-1: an explicit `3`-cycle in `A₄` used to exhibit a left transversal
for `A₄ / V₄`. -/
private def a4_three_cycle_012 : A4 :=
  ⟨swap (0 : Fin 4) 1 * swap 1 2, by
    rw [Perm.mem_alternatingGroup]
    decide⟩

/-- Helper for Exercise 5-5.7-1: the explicit element `a4_three_cycle_012` has order `3`. -/
private lemma a4_three_cycle_012_order :
    orderOf a4_three_cycle_012 = 3 := by
  -- The explicit permutation is a nontrivial `3`-cycle.
  exact orderOf_eq_prime
    (by decide : a4_three_cycle_012 ^ 3 = 1)
    (by decide : a4_three_cycle_012 ≠ 1)

/-- Helper for Exercise 5-5.7-1: the cyclic subgroup generated by the chosen `3`-cycle complements
`V₄`. -/
private lemma a4_order_three_subgroup_isComplement_kleinFour :
    (Subgroup.zpowers a4_three_cycle_012).IsComplement' V4 := by
  have hcard_mul :
      Nat.card (Subgroup.zpowers a4_three_cycle_012) * Nat.card V4 = Nat.card A4 := by
    rw [show Nat.card (Subgroup.zpowers a4_three_cycle_012) = 3 by
        simpa [a4_three_cycle_012_order] using Nat.card_zpowers a4_three_cycle_012]
    rw [show Nat.card V4 = 4 by
        simpa using alternatingGroup.kleinFour_card_of_card_eq_four (α := Fin 4) (by simp)]
    simpa using (show Nat.card A4 = 12 by
      simpa using alternatingGroup.card_of_card_eq_four (α := Fin 4) (by simp))
  have hcoprime :
      Nat.Coprime (Nat.card (Subgroup.zpowers a4_three_cycle_012)) (Nat.card V4) := by
    rw [show Nat.card (Subgroup.zpowers a4_three_cycle_012) = 3 by
        simpa [a4_three_cycle_012_order] using Nat.card_zpowers a4_three_cycle_012]
    rw [show Nat.card V4 = 4 by
        simpa using alternatingGroup.kleinFour_card_of_card_eq_four (α := Fin 4) (by simp)]
    decide
  -- Coprime cardinalities and the product formula identify the chosen cyclic subgroup as a
  -- complement to `V₄`.
  exact Subgroup.isComplement'_of_coprime hcard_mul hcoprime

/-- Helper for Exercise 5-5.7-1: an element of the chosen order-`3` subgroup is either `1`, the
generator `a4_three_cycle_012`, or its square. -/
private lemma a4_order_three_subgroup_eq_one_or_generator_or_sq
    (s : Subgroup.zpowers a4_three_cycle_012) :
    (s : A4) = 1 ∨ (s : A4) = a4_three_cycle_012 ∨
      (s : A4) = a4_three_cycle_012 ^ 2 := by
  -- The subgroup `⟨a4_three_cycle_012⟩` has order `3`, so only the first three powers occur.
  have hs_mem : (s : A4) ∈ Subgroup.zpowers a4_three_cycle_012 := s.2
  rw [mem_zpowers_iff_mem_range_orderOf, a4_three_cycle_012_order] at hs_mem
  simp at hs_mem
  rcases hs_mem with ⟨n, hnlt, hn⟩
  interval_cases n
  · simp at hn
    exact Or.inl hn.symm
  · simp at hn
    exact Or.inr <| Or.inl hn.symm
  · simp [pow_succ] at hn
    exact Or.inr <| Or.inr hn.symm

/-- Helper for Exercise 5-5.7-1: conjugation by the chosen `3`-cycle permutes the three
nontrivial elements of `V₄` cyclically. -/
private lemma a4_three_cycle_conj_v4_cycle :
    (a4_three_cycle_012 : A4) * (a4_v4_x : A4) * a4_three_cycle_012⁻¹ = a4_v4_z ∧
      (a4_three_cycle_012 : A4) * (a4_v4_y : A4) * a4_three_cycle_012⁻¹ = a4_v4_x ∧
      (a4_three_cycle_012 : A4) * (a4_v4_z : A4) * a4_three_cycle_012⁻¹ = a4_v4_y := by
  -- These are direct computations in the explicit permutation model of `A₄`.
  decide

/-- Helper for Exercise 5-5.7-1: conjugation by the square of the chosen `3`-cycle cyclically
permutes the nontrivial Klein-four elements in the opposite direction. -/
private lemma a4_three_cycle_sq_conj_v4_cycle :
    (a4_three_cycle_012 ^ 2 : A4) * (a4_v4_x : A4) * (a4_three_cycle_012 ^ 2)⁻¹ = a4_v4_y ∧
      (a4_three_cycle_012 ^ 2 : A4) * (a4_v4_y : A4) * (a4_three_cycle_012 ^ 2)⁻¹ = a4_v4_z ∧
      (a4_three_cycle_012 ^ 2 : A4) * (a4_v4_z : A4) * (a4_three_cycle_012 ^ 2)⁻¹ = a4_v4_x := by
  -- These are the corresponding explicit conjugation formulas for the other nonidentity element.
  decide

/-- Helper for Exercise 5-5.7-1: the explicit representatives `{1, c, c²}` form a left
transversal complementary to `V₄`. -/
private lemma a4_order_three_transversal_isComplement :
    Subgroup.IsComplement (({1, a4_three_cycle_012, a4_three_cycle_012 ^ 2} : Finset A4) : Set A4)
      (V4 : Set A4) := by
  have hset :
      Subgroup.IsComplement ((Subgroup.zpowers a4_three_cycle_012 : Set A4)) (V4 : Set A4) := by
    simpa [Subgroup.isComplement'_def] using a4_order_three_subgroup_isComplement_kleinFour
  have hcarrier :
      ((Subgroup.zpowers a4_three_cycle_012 : Set A4)) =
        (({1, a4_three_cycle_012, a4_three_cycle_012 ^ 2} : Finset A4) : Set A4) := by
    ext x
    constructor
    · intro hx
      let s : Subgroup.zpowers a4_three_cycle_012 := ⟨x, hx⟩
      rcases a4_order_three_subgroup_eq_one_or_generator_or_sq s with rfl | rfl | rfl <;> simp
    · intro hx
      simp at hx
      rcases hx with rfl | rfl | rfl
      · exact Subgroup.one_mem _
      · exact Subgroup.mem_zpowers a4_three_cycle_012
      · simpa using
          Subgroup.zpow_mem (Subgroup.zpowers a4_three_cycle_012)
            (Subgroup.mem_zpowers a4_three_cycle_012) (2 : ℤ)
  simpa [hcarrier] using hset

/-- Helper for Exercise 5-5.7-1: the table-defined function `a4_theta_value` is multiplicative
on the Klein four subgroup. -/
private theorem a4_theta_value_mul_all :
    ∀ a b : V4, a4_theta_value (a * b) = a4_theta_value a * a4_theta_value b := by
  intro a b
  rcases a4_v4_eq_one_or_source a with rfl | rfl | rfl | rfl <;>
    rcases a4_v4_eq_one_or_source b with rfl | rfl | rfl | rfl
  · simp [a4_theta_value]
  · simp [a4_theta_value]
  · have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    simp [a4_theta_value, hy1, hyx]
  · have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    simp [a4_theta_value, hz1, hzx]
  · simp [a4_theta_value]
  · rcases a4_v4_mul_self_eq_one with ⟨hxx, -, -⟩
    simp [a4_theta_value, hxx]
  · have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    simp [a4_theta_value, a4_v4_x_mul_y, hy1, hyx, hz1, hzx]
  · have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    simp [a4_theta_value, a4_v4_x_mul_z, hy1, hyx, hz1, hzx]
  · have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    simp [a4_theta_value, hy1, hyx]
  · have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    have hyx_mul : a4_v4_y * a4_v4_x = a4_v4_z := by
      calc
        a4_v4_y * a4_v4_x = a4_v4_x * a4_v4_y := by decide
        _ = a4_v4_z := a4_v4_x_mul_y
    simp [a4_theta_value, hyx_mul, hy1, hyx, hz1, hzx]
  · rcases a4_v4_mul_self_eq_one with ⟨-, ⟨hyy, -⟩⟩
    have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    simp [a4_theta_value, hyy, hy1, hyx]
  · have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    simp [a4_theta_value, a4_v4_y_mul_z, hy1, hyx, hz1, hzx]
  · have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    simp [a4_theta_value, hz1, hzx]
  · have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    have hzx_mul : a4_v4_z * a4_v4_x = a4_v4_y := by
      calc
        a4_v4_z * a4_v4_x = a4_v4_x * a4_v4_z := by decide
        _ = a4_v4_y := a4_v4_x_mul_z
    simp [a4_theta_value, hzx_mul, hy1, hyx, hz1, hzx]
  · have hy1 : a4_v4_y ≠ (1 : V4) := by decide
    have hyx : a4_v4_y ≠ a4_v4_x := by decide
    have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    have hzy_mul : a4_v4_z * a4_v4_y = a4_v4_x := by
      calc
        a4_v4_z * a4_v4_y = a4_v4_y * a4_v4_z := by decide
        _ = a4_v4_x := a4_v4_y_mul_z
    simp [a4_theta_value, hzy_mul, hy1, hyx, hz1, hzx]
  · rcases a4_v4_mul_self_eq_one with ⟨-, ⟨-, hzz⟩⟩
    have hz1 : a4_v4_z ≠ (1 : V4) := by decide
    have hzx : a4_v4_z ≠ a4_v4_x := by decide
    simp [a4_theta_value, hzz, hz1, hzx]

private theorem a4_theta_value_mul (h h' : V4) :
    a4_theta_value (h * h') = a4_theta_value h * a4_theta_value h' := by
  -- Specialize the finite multiplicativity table to the requested pair.
  exact a4_theta_value_mul_all h h'

/-- Serre's degree-one character `θ` of the Klein four subgroup `H ≤ A₄`, with
`θ(1) = θ(x) = 1` and `θ(y) = θ(z) = -1`. -/
def a4_theta : V4 →* ℂˣ where
  toFun := a4_theta_value
  map_one' := by
    simp [a4_theta_value]
  map_mul' := a4_theta_value_mul

local notation "θ" => a4_theta

/-- Helper for Exercise 5-5.7-1: the defining value `θ(1) = 1` on the identity of `H`. -/
@[simp] theorem a4_theta_apply_one : θ 1 = 1 := by
  -- The table definition of `θ` sends both `1` and `x` to `1`.
  simp [a4_theta, a4_theta_value]

/-- The defining value `θ(x) = 1` on the source element `x = (12)(34)` of `H`. -/
@[simp] theorem a4_theta_apply_x : θ a4_v4_x = 1 := by
  -- The table definition of `θ` sends both `1` and `x` to `1`.
  simp [a4_theta, a4_theta_value]

/-- The defining value `θ(y) = -1` on the source element `y = (13)(24)` of `H`. -/
@[simp] theorem a4_theta_apply_y : θ a4_v4_y = -1 := by
  -- The table definition of `θ` sends the other two nontrivial elements to `-1`.
  have hy1 : a4_v4_y ≠ (1 : V4) := by decide
  have hyx : a4_v4_y ≠ a4_v4_x := by decide
  simp [a4_theta, a4_theta_value, hy1, hyx]

/-- The defining value `θ(z) = -1` on the source element `z = (14)(23)` of `H`. -/
@[simp] theorem a4_theta_apply_z : θ a4_v4_z = -1 := by
  -- The table definition of `θ` sends the other two nontrivial elements to `-1`.
  have hz1 : a4_v4_z ≠ (1 : V4) := by decide
  have hzx : a4_v4_z ≠ a4_v4_x := by decide
  simp [a4_theta, a4_theta_value, hz1, hzx]

/-- Helper for Exercise 5-5.7-1: Serre's character `ψ` for the natural action of `A₄` on
`Fin 4`, realized as the permutation character minus the trivial summand. -/
private def a4_psi : A4 → ℂ :=
  fun g ↦ (ofMulAction ℂ A4 (Fin 4)).character g - 1

local notation "ψ" => a4_psi

/-- Helper for Exercise 5-5.7-1: the augmentation character takes the value `3` at the identity of
`A₄`. -/
private lemma a4_psi_apply_one : ψ 1 = 3 := by
  -- The identity fixes all four points of `Fin 4`, so the augmentation value is `4 - 1`.
  rw [a4_psi, Representation.ofMulAction_character_eq_ncard_fixedBy, MulAction.fixedBy_one_eq_univ]
  norm_num [Set.ncard_eq_toFinset_card]

/-- Helper for Exercise 5-5.7-1: the augmentation character takes the value `-1` on the element
`x = (12)(34)` of `V₄`. -/
private lemma a4_psi_apply_x : ψ a4_v4_x = -1 := by
  -- This double transposition has no fixed points on `Fin 4`, so `ψ(x) = 0 - 1`.
  rw [a4_psi, Representation.ofMulAction_character_eq_ncard_fixedBy, Set.ncard_eq_toFinset_card]
  have hfixed : (MulAction.fixedBy (Fin 4) (a4_v4_x : A4)).toFinset.card = 0 := by
    decide
  norm_num [hfixed]

/-- Helper for Exercise 5-5.7-1: the augmentation character takes the value `-1` on the element
`y = (13)(24)` of `V₄`. -/
private lemma a4_psi_apply_y : ψ a4_v4_y = -1 := by
  -- This double transposition has no fixed points on `Fin 4`, so `ψ(y) = 0 - 1`.
  rw [a4_psi, Representation.ofMulAction_character_eq_ncard_fixedBy, Set.ncard_eq_toFinset_card]
  have hfixed : (MulAction.fixedBy (Fin 4) (a4_v4_y : A4)).toFinset.card = 0 := by
    decide
  norm_num [hfixed]

/-- Helper for Exercise 5-5.7-1: the augmentation character takes the value `-1` on the element
`z = (14)(23)` of `V₄`. -/
private lemma a4_psi_apply_z : ψ a4_v4_z = -1 := by
  -- This double transposition has no fixed points on `Fin 4`, so `ψ(z) = 0 - 1`.
  rw [a4_psi, Representation.ofMulAction_character_eq_ncard_fixedBy, Set.ncard_eq_toFinset_card]
  have hfixed : (MulAction.fixedBy (Fin 4) (a4_v4_z : A4)).toFinset.card = 0 := by
    decide
  norm_num [hfixed]

private abbrev a4_induced_theta :=
  ind (Subgroup.subtype V4) a4_theta.toRepresentation

/-- Helper for Exercise 5-5.7-1: the induced representation from the degree-one Klein-four
character `θ` is finite-dimensional. -/
private local instance a4_induced_theta_finiteDimensional :
    FiniteDimensional ℂ (IndV (Subgroup.subtype V4) a4_theta.toRepresentation) := by
  letI : FiniteDimensional ℂ (V4 →₀ ℂ) := by
    infer_instance
  letI : FiniteDimensional ℂ (TensorProduct ℂ (V4 →₀ ℂ) ℂ) := by
    infer_instance
  exact
    FiniteDimensional.of_surjective (Representation.Coinvariants.mk _)
      (Representation.Coinvariants.mk_surjective _)

/-- Helper for Exercise 5-5.7-1: the degree-one Klein-four character `θ` is constant on
conjugacy classes of `V₄`. -/
private lemma a4_theta_character_isClassFunction :
    IsClassFunction a4_theta.toRepresentation.character := by
  refine ⟨?_⟩
  intro x y hxy
  rcases isConj_iff.1 (ConjClasses.mk_eq_mk_iff_isConj.mp hxy) with ⟨a, rfl⟩
  exact (a4_theta.toRepresentation.char_conj x a).symm

/-- Helper for Exercise 5-5.7-1: the universe of `V₄` is exactly the explicit table
`{1, x, y, z}`. -/
private lemma a4_v4_univ [Fintype V4] :
    (Finset.univ : Finset V4) = {1, a4_v4_x, a4_v4_y, a4_v4_z} := by
  ext h
  simp [a4_v4_eq_one_or_source h]

/-- Helper for Exercise 5-5.7-1: every element of `V₄` is its own inverse. -/
private lemma a4_v4_inv_eq_self (h : V4) : h⁻¹ = h := by
  rcases a4_v4_eq_one_or_source h with rfl | rfl | rfl | rfl <;> decide

/-- Helper for Exercise 5-5.7-1: every element of `A₄ \ V₄` is one of the two nontrivial
transversal representatives multiplied by an element of `V₄`. -/
private lemma a4_eq_three_cycle_mul_or_sq_mul_of_not_mem_v4
    (a : A4) (ha : a ∉ V4) :
    ∃ h : V4, a = a4_three_cycle_012 * h ∨ a = a4_three_cycle_012 ^ 2 * h := by
  let p := a4_order_three_transversal_isComplement.equiv a
  have hdecomp : ((p.1 : A4) * p.2 : A4) = a := by
    simpa [p] using a4_order_three_transversal_isComplement.equiv_fst_mul_equiv_snd a
  have hp1_ne_one : (p.1 : A4) ≠ 1 := by
    intro hp1
    apply ha
    have haeq : a = p.2 := by
      calc
        a = ((p.1 : A4) * p.2 : A4) := hdecomp.symm
        _ = p.2 := by simp [hp1]
    exact haeq ▸ p.2.2
  have hp1_cases_all :
      (p.1 : A4) = 1 ∨
        (p.1 : A4) = a4_three_cycle_012 ∨ (p.1 : A4) = a4_three_cycle_012 ^ 2 := by
    have hp1_mem : (p.1 : A4) ∈ ({1, a4_three_cycle_012, a4_three_cycle_012 ^ 2} : Finset A4) := by
      simpa [p] using p.1.property
    have hp1_cases_all' := hp1_mem
    simp only [Finset.mem_insert, Finset.mem_singleton] at hp1_cases_all'
    exact hp1_cases_all'
  have hp1_cases :
      (p.1 : A4) = a4_three_cycle_012 ∨ (p.1 : A4) = a4_three_cycle_012 ^ 2 := by
    rcases hp1_cases_all with hp1 | hp1 | hp1
    · exact (hp1_ne_one hp1).elim
    · exact Or.inl hp1
    · exact Or.inr hp1
  refine ⟨p.2, ?_⟩
  rcases hp1_cases with hp1 | hp1
  · left
    calc
      a = ((p.1 : A4) * p.2 : A4) := hdecomp.symm
      _ = a4_three_cycle_012 * p.2 := by simp [hp1]
  · right
    calc
      a = ((p.1 : A4) * p.2 : A4) := hdecomp.symm
      _ = a4_three_cycle_012 ^ 2 * p.2 := by simp [hp1]

/-- Helper for Exercise 5-5.7-1: the two nontrivial transversal representatives stay outside
`V₄` after multiplication by any element of `V₄`. -/
private lemma a4_nontrivial_transversal_not_mem_v4
    (h : V4) :
    (a4_three_cycle_012 * h : A4) ∉ V4 ∧ (a4_three_cycle_012 ^ 2 * h : A4) ∉ V4 := by
  have hnot_mem_of_ne_all {a : A4}
      (ha1 : a ≠ 1) (hax : a ≠ a4_v4_x) (hay : a ≠ a4_v4_y) (haz : a ≠ a4_v4_z) :
      a ∉ V4 := by
    intro ha
    rcases a4_v4_eq_one_or_source ⟨a, ha⟩ with hEq | hEq | hEq | hEq
    · exact (ha1 (congrArg Subtype.val hEq)).elim
    · exact (hax (congrArg Subtype.val hEq)).elim
    · exact (hay (congrArg Subtype.val hEq)).elim
    · exact (haz (congrArg Subtype.val hEq)).elim
  -- Check the four subgroup elements explicitly in the concrete permutation model.
  rcases a4_v4_eq_one_or_source h with rfl | rfl | rfl | rfl
  · exact ⟨hnot_mem_of_ne_all (by decide) (by decide) (by decide) (by decide),
      hnot_mem_of_ne_all (by decide) (by decide) (by decide) (by decide)⟩
  · exact ⟨hnot_mem_of_ne_all (by decide) (by decide) (by decide) (by decide),
      hnot_mem_of_ne_all (by decide) (by decide) (by decide) (by decide)⟩
  · exact ⟨hnot_mem_of_ne_all (by decide) (by decide) (by decide) (by decide),
      hnot_mem_of_ne_all (by decide) (by decide) (by decide) (by decide)⟩
  · exact ⟨hnot_mem_of_ne_all (by decide) (by decide) (by decide) (by decide),
      hnot_mem_of_ne_all (by decide) (by decide) (by decide) (by decide)⟩

/-- Helper for Exercise 5-5.7-1: each nontrivial transversal element fixes exactly one point of
`Fin 4`. -/
private lemma a4_non_v4_fixedBy_card_eq_one_explicit
    (h : V4) :
    (MulAction.fixedBy (Fin 4) (a4_three_cycle_012 * h : A4)).toFinset.card = 1 ∧
      (MulAction.fixedBy (Fin 4) (a4_three_cycle_012 ^ 2 * h : A4)).toFinset.card = 1 := by
  -- Each element in the two nontrivial cosets is a `3`-cycle, hence fixes exactly one point.
  rcases a4_v4_eq_one_or_source h with rfl | rfl | rfl | rfl <;> decide

/-- Helper for Exercise 5-5.7-1: the induced character from `θ` vanishes on the two nontrivial
transversal cosets of `V₄`. -/
private lemma a4_induced_theta_nontrivial_transversal_eq_zero
    (h : V4) :
    Ind[V4](a4_theta.toRepresentation.character) (a4_three_cycle_012 * h : A4) = 0 ∧
      Ind[V4](a4_theta.toRepresentation.character) (a4_three_cycle_012 ^ 2 * h : A4) = 0 := by
  classical
  let R : Finset A4 := {1, a4_three_cycle_012, a4_three_cycle_012 ^ 2}
  let _ : NeZero (Nat.card V4 : ℂ) := by
    refine ⟨?_⟩
    exact_mod_cast (Nat.card_pos : 0 < Nat.card V4).ne'
  have hneq1c : (1 : A4) ≠ a4_three_cycle_012 := by decide
  have hneq1csq : (1 : A4) ≠ a4_three_cycle_012 ^ 2 := by decide
  have hneqccsq : a4_three_cycle_012 ≠ a4_three_cycle_012 ^ 2 := by decide
  have hnormal : (V4 : Subgroup A4).Normal :=
    alternatingGroup.normal_kleinFour (show Nat.card (Fin 4) = 4 by simp)
  have hnot := a4_nontrivial_transversal_not_mem_v4 h
  have hconj_not_mem {a : A4} (ha : a ∉ V4) (r : A4) : ¬ r⁻¹ * a * r ∈ V4 := by
    intro hr
    apply ha
    simpa [mul_assoc] using hnormal.conj_mem (r⁻¹ * a * r) hr r
  constructor
  · have hsum :
        Ind[V4](a4_theta.toRepresentation.character) (a4_three_cycle_012 * h : A4) =
          ∑ r ∈ R,
            if hr : r⁻¹ * (a4_three_cycle_012 * h : A4) * r ∈ V4 then
              a4_theta.toRepresentation.character ⟨r⁻¹ * (a4_three_cycle_012 * h : A4) * r, hr⟩
            else 0 := by
        -- Expand the induced value through the fixed transversal `{1, c, c²}`.
        simpa [R] using
          (Subgroup.induced_class_function_eq_sum_over_left_transversal
            (H := V4) a4_theta.toRepresentation.character
            a4_theta_character_isClassFunction R a4_order_three_transversal_isComplement
            (a4_three_cycle_012 * h : A4))
    have h1 :
        ¬ (1 : A4)⁻¹ * (a4_three_cycle_012 * h : A4) * 1 ∈ V4 := by
      simpa using hnot.1
    have hc :
        ¬ a4_three_cycle_012⁻¹ * (a4_three_cycle_012 * h : A4) * a4_three_cycle_012 ∈ V4 :=
      hconj_not_mem hnot.1 a4_three_cycle_012
    have hcsq :
        ¬ (a4_three_cycle_012 ^ 2)⁻¹ * (a4_three_cycle_012 * h : A4) *
            (a4_three_cycle_012 ^ 2) ∈ V4 :=
      hconj_not_mem hnot.1 (a4_three_cycle_012 ^ 2)
    have hright : ¬ ((h : A4) * a4_three_cycle_012 ∈ V4) := by
      simpa [mul_assoc] using hc
    -- Every conjugate stays outside `V₄`, so each summand is zero.
    rw [hsum]
    have h1' : ¬ (a4_three_cycle_012 * h : A4) ∈ V4 := by
      simpa using h1
    simp [R, hright, hneq1c, hneq1csq, hneqccsq]
    by_cases hm1 : (a4_three_cycle_012 * h : A4) ∈ V4
    · exact (h1' hm1).elim
    · simp [hm1]
      by_cases hm2 :
          (a4_three_cycle_012 ^ 2)⁻¹ * (a4_three_cycle_012 * h : A4) * a4_three_cycle_012 ^ 2 ∈
            V4
      · exact (hcsq hm2).elim
      · simp [hm2]
  · have hsum :
        Ind[V4](a4_theta.toRepresentation.character) (a4_three_cycle_012 ^ 2 * h : A4) =
          ∑ r ∈ R,
            if hr : r⁻¹ * (a4_three_cycle_012 ^ 2 * h : A4) * r ∈ V4 then
              a4_theta.toRepresentation.character
                ⟨r⁻¹ * (a4_three_cycle_012 ^ 2 * h : A4) * r, hr⟩
            else 0 := by
        -- Expand the induced value through the fixed transversal `{1, c, c²}`.
        simpa [R] using
          (Subgroup.induced_class_function_eq_sum_over_left_transversal
            (H := V4) a4_theta.toRepresentation.character
            a4_theta_character_isClassFunction R a4_order_three_transversal_isComplement
            (a4_three_cycle_012 ^ 2 * h : A4))
    have h1 :
        ¬ (1 : A4)⁻¹ * (a4_three_cycle_012 ^ 2 * h : A4) * 1 ∈ V4 := by
      simpa using hnot.2
    have hc :
        ¬ a4_three_cycle_012⁻¹ * (a4_three_cycle_012 ^ 2 * h : A4) * a4_three_cycle_012 ∈ V4 :=
      hconj_not_mem hnot.2 a4_three_cycle_012
    have hcsq :
        ¬ (a4_three_cycle_012 ^ 2)⁻¹ * (a4_three_cycle_012 ^ 2 * h : A4) *
            (a4_three_cycle_012 ^ 2) ∈ V4 :=
      hconj_not_mem hnot.2 (a4_three_cycle_012 ^ 2)
    have hright : ¬ ((h : A4) * (a4_three_cycle_012 ^ 2) ∈ V4) := by
      simpa [mul_assoc] using hcsq
    -- Every conjugate stays outside `V₄`, so each summand is zero.
    rw [hsum]
    have h1' : ¬ (a4_three_cycle_012 ^ 2 * h : A4) ∈ V4 := by
      simpa using h1
    simp [R, hright, hneq1c, hneq1csq, hneqccsq]
    by_cases hm1 : (a4_three_cycle_012 ^ 2 * h : A4) ∈ V4
    · exact (h1' hm1).elim
    · simp [hm1]
      by_cases hm2 :
          a4_three_cycle_012⁻¹ * (a4_three_cycle_012 ^ 2 * h : A4) * a4_three_cycle_012 ∈ V4
      · exact (hc hm2).elim
      · simp [hm2]

/-- Helper for Exercise 5-5.7-1: on the Klein four subgroup itself, the induced character from
`θ` matches the augmentation character `ψ`. -/
private theorem a4_induced_theta_eq_psi_on_v4
    (h : V4) :
    Ind[V4](a4_theta.toRepresentation.character) (h : A4) = ψ h := by
  classical
  let R : Finset A4 := {1, a4_three_cycle_012, a4_three_cycle_012 ^ 2}
  let _ : NeZero (Nat.card V4 : ℂ) := by
    refine ⟨?_⟩
    exact_mod_cast (Nat.card_pos : 0 < Nat.card V4).ne'
  have hneq1c : (1 : A4) ≠ a4_three_cycle_012 := by decide
  have hneq1csq : (1 : A4) ≠ a4_three_cycle_012 ^ 2 := by decide
  have hneqccsq : a4_three_cycle_012 ≠ a4_three_cycle_012 ^ 2 := by decide
  have hy1 : a4_v4_y ≠ (1 : V4) := by decide
  have hyx : a4_v4_y ≠ a4_v4_x := by decide
  have hz1 : a4_v4_z ≠ (1 : V4) := by decide
  have hzx : a4_v4_z ≠ a4_v4_x := by decide
  have hsum :
      Ind[V4](a4_theta.toRepresentation.character) (h : A4) =
        ∑ r ∈ R,
          if hr : r⁻¹ * (h : A4) * r ∈ V4 then
            a4_theta.toRepresentation.character ⟨r⁻¹ * (h : A4) * r, hr⟩
          else 0 := by
    -- Rewrite the induced value through the explicit transversal `{1, c, c²}`.
    simpa [R] using
      (Subgroup.induced_class_function_eq_sum_over_left_transversal
        (H := V4) a4_theta.toRepresentation.character
        a4_theta_character_isClassFunction R a4_order_three_transversal_isComplement
        (h : A4))
  -- Reduce the subgroup computation to the four named elements of `V₄`.
  rcases a4_v4_eq_one_or_source h with rfl | rfl | rfl | rfl
  · -- At the identity, all three summands contribute `1`, giving `3 = ψ(1)`.
    rw [hsum]
    simp [R, a4_psi_apply_one, MonoidHom.toRepresentation_character_apply, a4_theta, a4_theta_value,
      hneq1c, hneq1csq, hneqccsq]
  · -- Route correction: the `r = c` summand uses `c⁻¹ x c`, so the square-conjugation table and
    -- the ordinary conjugation table must both be used in the right order.
    have hx_c :
        a4_three_cycle_012⁻¹ * (a4_v4_x : A4) * a4_three_cycle_012 = a4_v4_y := by
      decide
    have hx_csq :
        (a4_three_cycle_012 ^ 2)⁻¹ * (a4_v4_x : A4) * (a4_three_cycle_012 ^ 2) = a4_v4_z := by
      decide
    have hy_mem : a4_three_cycle_012⁻¹ * (a4_v4_x : A4) * a4_three_cycle_012 ∈ V4 := by
      rw [hx_c]
      exact a4_v4_y.2
    have hz_mem :
        (a4_three_cycle_012 ^ 2)⁻¹ * (a4_v4_x : A4) * (a4_three_cycle_012 ^ 2) ∈ V4 := by
      rw [hx_csq]
      exact a4_v4_z.2
    rw [hsum]
    simp [R, MonoidHom.toRepresentation_character_apply, a4_psi_apply_x, a4_theta, a4_theta_value,
      hx_c, hx_csq, hy_mem, hz_mem, hy1, hyx, hz1, hzx, hneq1c, hneq1csq, hneqccsq]
  · -- The same three-term transversal sum gives `θ(y) + θ(z) + θ(x) = -1 = ψ(y)`.
    have hy_c :
        a4_three_cycle_012⁻¹ * (a4_v4_y : A4) * a4_three_cycle_012 = a4_v4_z := by
      decide
    have hy_csq :
        (a4_three_cycle_012 ^ 2)⁻¹ * (a4_v4_y : A4) * (a4_three_cycle_012 ^ 2) = a4_v4_x := by
      decide
    have hz_mem : a4_three_cycle_012⁻¹ * (a4_v4_y : A4) * a4_three_cycle_012 ∈ V4 := by
      rw [hy_c]
      exact a4_v4_z.2
    have hx_mem :
        (a4_three_cycle_012 ^ 2)⁻¹ * (a4_v4_y : A4) * (a4_three_cycle_012 ^ 2) ∈ V4 := by
      rw [hy_csq]
      exact a4_v4_x.2
    rw [hsum]
    simp [R, MonoidHom.toRepresentation_character_apply, a4_psi_apply_y, a4_theta, a4_theta_value,
      hy_c, hy_csq, hz_mem, hx_mem, hy1, hyx, hz1, hzx, hneq1c, hneq1csq, hneqccsq]
  · -- The last subgroup element is analogous, with the three conjugates cycling through `z, x, y`.
    have hz_c :
        a4_three_cycle_012⁻¹ * (a4_v4_z : A4) * a4_three_cycle_012 = a4_v4_x := by
      decide
    have hz_csq :
        (a4_three_cycle_012 ^ 2)⁻¹ * (a4_v4_z : A4) * (a4_three_cycle_012 ^ 2) = a4_v4_y := by
      decide
    have hx_mem : a4_three_cycle_012⁻¹ * (a4_v4_z : A4) * a4_three_cycle_012 ∈ V4 := by
      rw [hz_c]
      exact a4_v4_x.2
    have hy_mem :
        (a4_three_cycle_012 ^ 2)⁻¹ * (a4_v4_z : A4) * (a4_three_cycle_012 ^ 2) ∈ V4 := by
      rw [hz_csq]
      exact a4_v4_y.2
    rw [hsum]
    simp [R, MonoidHom.toRepresentation_character_apply, a4_psi_apply_z, a4_theta, a4_theta_value,
      hz_c, hz_csq, hx_mem, hy_mem, hy1, hyx, hz1, hzx, hneq1c, hneq1csq, hneqccsq]

/-- Helper for Exercise 5-5.7-1: outside `V₄`, both the induced character from `θ` and the
augmentation character `ψ` vanish. -/
private theorem a4_non_v4_induced_and_psi_vanish
    (a : A4) (ha : a ∉ V4) :
    Ind[V4](a4_theta.toRepresentation.character) a = 0 ∧ ψ a = 0 := by
  rcases a4_eq_three_cycle_mul_or_sq_mul_of_not_mem_v4 a ha with ⟨h, rfl | rfl⟩
  · rcases a4_induced_theta_nontrivial_transversal_eq_zero h with ⟨hind, -⟩
    rcases a4_non_v4_fixedBy_card_eq_one_explicit h with ⟨hfixed, -⟩
    constructor
    · -- The induced value vanishes uniformly on the `cV₄` coset.
      exact hind
    · -- The natural permutation fixes exactly one point on the `cV₄` coset, so `ψ = 1 - 1 = 0`.
      rw [a4_psi, Representation.ofMulAction_character_eq_ncard_fixedBy, Set.ncard_eq_toFinset_card]
      norm_num [hfixed]
  · rcases a4_induced_theta_nontrivial_transversal_eq_zero h with ⟨-, hind⟩
    rcases a4_non_v4_fixedBy_card_eq_one_explicit h with ⟨-, hfixed⟩
    constructor
    · -- The induced value vanishes uniformly on the `c²V₄` coset.
      exact hind
    · -- The natural permutation fixes exactly one point on the `c²V₄` coset, so `ψ = 1 - 1 = 0`.
      rw [a4_psi, Representation.ofMulAction_character_eq_ncard_fixedBy, Set.ncard_eq_toFinset_card]
      norm_num [hfixed]

/-- Helper for Exercise 5-5.7-1: the explicit induced class function attached to `θ` agrees
pointwise with the augmentation character `ψ` of `A₄`. -/
private theorem a4_induced_theta_character_eq_psi_pointwise :
    ∀ a : A4, Ind[V4](a4_theta.toRepresentation.character) a = ψ a := by
  intro a
  by_cases ha : a ∈ V4
  · exact a4_induced_theta_eq_psi_on_v4 ⟨a, ha⟩
  · rcases a4_non_v4_induced_and_psi_vanish a ha with ⟨hind, hpsi⟩
    rw [hind, hpsi]

/-- Helper for Exercise 5-5.7-1: the augmentation character `ψ` of the natural action of `A₄`
on `Fin 4` has normalized self-pairing `1`. -/
private theorem a4_psi_self_pairing_eq_one : ⟪ψ, ψ⟫ = (1 : ℂ) := by
  classical
  rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
  have hsum_split :
      ∑ t : A4, ψ t * ψ t⁻¹ =
        (Finset.univ.filter fun t : A4 ↦ t ∈ V4).sum (fun t ↦ ψ t * ψ t⁻¹) +
          (Finset.univ.filter fun t : A4 ↦ t ∉ V4).sum (fun t ↦ ψ t * ψ t⁻¹) := by
    -- Split the finite sum into the subgroup contribution and the complementary cosets.
    simpa using
      (Finset.univ.sum_filter_add_sum_filter_not
        (fun t : A4 ↦ t ∈ V4)
        (fun t ↦ ψ t * ψ t⁻¹)).symm
  have hsum_not_mem :
      (Finset.univ.filter fun t : A4 ↦ t ∉ V4).sum (fun t ↦ ψ t * ψ t⁻¹) = 0 := by
    -- The pointwise vanishing off `V₄` kills every term in the complementary part of the sum.
    refine Finset.sum_eq_zero ?_
    intro t ht
    have ht_not_mem : t ∉ V4 := by
      simpa using (Finset.mem_filter.1 ht).2
    rcases a4_non_v4_induced_and_psi_vanish t ht_not_mem with ⟨-, hpsi⟩
    simp [hpsi]
  have hsum_mem :
      (Finset.univ.filter fun t : A4 ↦ t ∈ V4).sum (fun t ↦ ψ t * ψ t⁻¹) =
        ∑ h : V4, ψ h * ψ h⁻¹ := by
    -- Rewrite the subgroup part as a sum over the subtype `V₄`.
    simpa using
      (Finset.sum_subtype_eq_sum_filter
        (s := Finset.univ)
        (p := fun t : A4 ↦ t ∈ V4)
        (f := fun t ↦ ψ t * ψ t⁻¹)).symm
  have hsum_v4 :
      ∑ h : V4, ψ h * ψ h⁻¹ = (12 : ℂ) := by
    -- Evaluate the remaining four subgroup terms from the explicit value table of `ψ`.
    have hneq1x : (1 : V4) ≠ a4_v4_x := by decide
    have hneq1y : (1 : V4) ≠ a4_v4_y := by decide
    have hneq1z : (1 : V4) ≠ a4_v4_z := by decide
    have hneqxy : a4_v4_x ≠ a4_v4_y := by decide
    have hneqxz : a4_v4_x ≠ a4_v4_z := by decide
    have hneqyz : a4_v4_y ≠ a4_v4_z := by decide
    have hx_inv : ((a4_v4_x : V4) : A4)⁻¹ = a4_v4_x := by decide
    have hy_inv : ((a4_v4_y : V4) : A4)⁻¹ = a4_v4_y := by decide
    have hz_inv : ((a4_v4_z : V4) : A4)⁻¹ = a4_v4_z := by decide
    calc
      ∑ h : V4, ψ h * ψ h⁻¹
          = ({1, a4_v4_x, a4_v4_y, a4_v4_z} : Finset V4).sum
              (fun h : V4 => ψ (h : A4) * ψ ((h : A4)⁻¹)) := by
              exact congrArg
                (fun s : Finset V4 =>
                  s.sum (fun h : V4 => ψ (h : A4) * ψ ((h : A4)⁻¹)))
                a4_v4_univ
      _ = ψ 1 * ψ 1 +
              (ψ a4_v4_x * ψ a4_v4_x + (ψ a4_v4_y * ψ a4_v4_y + ψ a4_v4_z * ψ a4_v4_z)) := by
            simp [a4_v4_inv_eq_self, hneq1x, hneq1y, hneq1z, hneqxy, hneqxz, hneqyz, hx_inv,
              hy_inv, hz_inv]
      _ = (12 : ℂ) := by
            norm_num [a4_psi_apply_one, a4_psi_apply_x, a4_psi_apply_y, a4_psi_apply_z]
  have hcard_nat : Nat.card A4 = 12 := by
    simpa using
      alternatingGroup.card_of_card_eq_four (α := Fin 4) (by simp)
  have hcard : (Nat.card A4 : ℂ) = 12 := by
    exact_mod_cast hcard_nat
  -- Only the four subgroup values contribute, and their squares sum to `12`.
  calc
    (Nat.card A4 : ℂ)⁻¹ * (∑ t : A4, ψ t * ψ t⁻¹)
        = (12 : ℂ)⁻¹ *
            ((Finset.univ.filter fun t : A4 ↦ t ∈ V4).sum (fun t ↦ ψ t * ψ t⁻¹) +
              (Finset.univ.filter fun t : A4 ↦ t ∉ V4).sum (fun t ↦ ψ t * ψ t⁻¹)) := by
          rw [hcard, hsum_split]
    _ = (12 : ℂ)⁻¹ * (∑ h : V4, ψ h * ψ h⁻¹) := by
          rw [hsum_not_mem, add_zero, hsum_mem]
    _ = (12 : ℂ)⁻¹ * 12 := by
          rw [hsum_v4]
    _ = 1 := by
          norm_num

-- Proof sketch: apply the induced-character formula from Theorem `3-3.3-4` to the concrete
-- subgroup `H = {1, x, y, z}` and the degree-one character `θ`, compute the resulting class values
-- on the conjugacy classes of `A₄`, and identify them with the permutation-minus-trivial
-- character `ψ`. Then use character orthogonality for finite-dimensional complex representations
-- of `A₄` to conclude that the induced representation is irreducible.
/-- Exercise 5-5.7-1, character form: the induced representation `Ind_H^G(θ)` has augmentation
character `ψ` for the natural action of `A₄` on `Fin 4`. -/
theorem a4_induced_theta_character_eq_psi :
    a4_induced_theta.character = ψ := by
  -- Rewrite the induced character as the induced class function, then apply the pointwise
  -- calculation already isolated above.
  let _ : NeZero (Nat.card V4 : ℂ) := by
    refine ⟨?_⟩
    exact_mod_cast (Nat.card_pos : 0 < Nat.card V4).ne'
  have hInd :
      Ind[V4](a4_theta.toRepresentation.character) = a4_induced_theta.character := by
    simpa [a4_induced_theta] using
      (Subgroup.inducedClassFunction_eq_character_ind
        (H := V4) (K := ℂ) a4_theta.toRepresentation)
  ext a
  exact (congrFun hInd a).symm.trans (a4_induced_theta_character_eq_psi_pointwise a)

/-- Exercise 5-5.7-1, irreducibility form: the induced representation `Ind_H^G(θ)` is
irreducible. -/
theorem a4_induced_theta_isIrreducible :
    a4_induced_theta.IsIrreducible := by
  -- Rewrite the self-pairing through the identified character `ψ` and apply Schur's criterion.
  have hpair :
      ⟪a4_induced_theta.character, a4_induced_theta.character⟫ = (1 : ℂ) := by
    simpa [a4_induced_theta_character_eq_psi] using a4_psi_self_pairing_eq_one
  exact
    (Representation.self_character_pairing_eq_one_iff_isIrreducible a4_induced_theta).mp hpair

/-- Exercise 5-5.7-1, source-facing form: the induced representation `Ind_H^G(θ)` is irreducible
and has character `ψ`. -/
theorem a4_induced_theta_isIrreducible_and_character_eq_psi :
    a4_induced_theta.IsIrreducible ∧ a4_induced_theta.character = ψ :=
  ⟨a4_induced_theta_isIrreducible, a4_induced_theta_character_eq_psi⟩
