import LinearRepresentations_Serre_1977.Serre.Chap02.Remark_2_2_1_2
import LinearRepresentations_Serre_1977.Serre.Chap07.Proposition_7_7_2_1
import LinearRepresentations_Serre_1977.Serre.Chap10.Definition_10_10_1_4
import LinearRepresentations_Serre_1977.Serre.Chap11.Theorem_11_11_2_1.TensorCharacterBridge

-- Stable helper foundations extracted from Proposition 11-11.4-1.

universe u v

noncomputable section

open Representation
open scoped Representation SubgroupInduction TensorProduct

section BasicOwners

variable {A : Type v} [CommRing A]

/-- Nonzero maximal ideals of `A` whose residue field has characteristic `p`. -/
abbrev NonzeroResidualCharacteristicMaximalIdeal (A : Type v) [CommRing A] (p : ℕ) :=
  {M : MaximalSpectrum A // (M : Ideal A) ≠ ⊥ ∧ CharP M.asIdeal.ResidueField p}

variable {G : Type u} [Group G]

/-- Conjugacy classes of `G` consisting of `p`-regular elements. -/
abbrev PRegularConjClass (G : Type u) [Group G] (p : ℕ) :=
  {c : ConjClasses G // ∀ x ∈ c.carrier, IsPRegular p x}

namespace PRegularConjClass

variable {G : Type u} [Group G]

/-- The conjugacy class of a `p`-regular element, viewed in the owner `PRegularConjClass G p`. -/
def ofSubtype (p : ℕ) (s : { x : G // IsPRegular p x }) : PRegularConjClass G p :=
  ⟨ConjClasses.mk s.1, fun x hx ↦ by
    have hmk : ConjClasses.mk x = ConjClasses.mk s.1 :=
      ConjClasses.mem_carrier_iff_mk_eq.mp hx
    have hsx : IsConj s.1 x := (ConjClasses.mk_eq_mk_iff_isConj.mp hmk).symm
    rcases isConj_iff.1 hsx with ⟨t, rfl⟩
    simpa using isPRegular_conj p s.1 t s.2⟩

@[simp] theorem coe_ofSubtype {p : ℕ} (s : { x : G // IsPRegular p x }) :
    (ofSubtype p s : ConjClasses G) = ConjClasses.mk s.1 :=
  rfl

end PRegularConjClass

namespace IsClassFunction

variable {G : Type u} [Group G]
variable {R : Type v}

/-- A class function on `G` descends canonically to Serre's owner `PRegularConjClass G p` of
`p`-regular conjugacy classes. -/
def pRegularLift {f : G → R} (hf : _root_.IsClassFunction f) (p : ℕ) :
    PRegularConjClass G p → R :=
  fun c ↦ hf.lift c.1

@[simp] theorem pRegularLift_ofSubtype {p : ℕ} {f : G → R}
    (hf : _root_.IsClassFunction f)
    (s : { x : G // IsPRegular p x }) :
    hf.pRegularLift p (PRegularConjClass.ofSubtype p s) = f s.1 := by
  rw [pRegularLift, PRegularConjClass.coe_ofSubtype, _root_.IsClassFunction.lift_mk]

end IsClassFunction

section RegularPrime

variable {p : Nat.Primes}

local instance factPrime : Fact (p : ℕ).Prime := ⟨p.2⟩

/-- The subgroup `H` contains an associated `p`-elementary subgroup coming from some element of
the `p`-regular class `c`. -/
def HasAssociatedPElementarySubgroupInClass
    (c : PRegularConjClass G p) (H : Subgroup G) : Prop :=
  ∃ x : G, x ∈ c.1.carrier ∧
    ∃ P : Sylow p (Subgroup.centralizer {(x : G)}),
      associatedPElementarySubgroup p x P ≤ H

end RegularPrime

end BasicOwners

section

variable {G : Type} [Group G]
variable {A : Type v} [CommRing A]
variable [Finite G] [Algebra A ℂ]

local instance ownersAndPrimeFibersFintypeGroup : Fintype G := Fintype.ofFinite G
local instance ownersAndPrimeFibersFintypeSubgroup (H : Subgroup G) : Fintype H :=
  Fintype.ofFinite H

local notation "SpecARG" =>
  PrimeSpectrum (A ⊗R(G))

variable (A)

/-- Evaluation on a conjugacy class in the function-subalgebra realization of Serre's tensor
character ring. This is an internal bridge used to define `P₀,c` on the owner
`tensorCharacterRing A G`. -/
def characterRingScalarExtensionSubalgebraEval
    (c : ConjClasses G) :
    characterRingScalarExtensionSubalgebra A G →+* ℂ where
  toFun f :=
    (isClassFunction_of_mem_characterRingScalarExtension
      (show (f : G → ℂ) ∈ characterRingScalarExtension A G from f.2)).lift c
  map_one' := by
    obtain ⟨g, rfl⟩ := ConjClasses.mk_surjective c
    simp
  map_mul' f g := by
    obtain ⟨x, rfl⟩ := ConjClasses.mk_surjective c
    simp
  map_zero' := by
    obtain ⟨g, rfl⟩ := ConjClasses.mk_surjective c
    simp
  map_add' f g := by
    obtain ⟨x, rfl⟩ := ConjClasses.mk_surjective c
    simp

/-- Evaluation on a conjugacy class defines the internal bridge whose kernel is the prime ideal
`P₀,c`. -/
def tensorCharacterRingZeroPrimeIdealEval
    (c : ConjClasses G) :
    A ⊗R(G) →+* ℂ :=
  (characterRingScalarExtensionSubalgebraEval A c).comp
    (tensorCharacterRingToSubalgebra A G).toRingHom

/-- The prime ideal `P₀,c` of `A ⊗ R(G)` obtained by evaluating class functions on the conjugacy
class `c`. -/
def tensorCharacterRingZeroPrimeIdeal
    (c : ConjClasses G) : SpecARG :=
  ⟨RingHom.ker (tensorCharacterRingZeroPrimeIdealEval A c),
    RingHom.ker_isPrime _⟩

local notation "P0" => tensorCharacterRingZeroPrimeIdeal

variable {A}

/-- The ideal of `A ⊗ R(G)` generated by the induced virtual characters coming from the subgroup
`H`. On the theorem surface we write this source-facing owner as `ℐ H`, Lean's concise surface
for Serre's ideal `I_H` inside the tensor character ring. -/
noncomputable def tensorCharacterRingInductionIdeal
    (H : Subgroup G) : Ideal (A ⊗R(G)) :=
  Ideal.span <|
    Set.range fun χ : R[ℂ](H) ↦
      (Algebra.TensorProduct.includeRight (R := ℤ) (A := A) (B := R(G))) <|
        (Subgroup.characterRingInduction_local (G := G) H χ)

local notation "ℐ" => tensorCharacterRingInductionIdeal

section RegularPrime

/-- Serre's defining characterization of the regular prime `P_{M,c}`: it lies over the maximal
ideal `M`, and it contains exactly the induction ideals `I_H` for subgroups `H` containing no
associated `p`-elementary subgroup coming from the chosen `p`-regular class `c`. -/
def IsTensorCharacterRingRegularPrime
    (A : Type v) [CommRing A] (G : Type) [Group G] [Finite G] [Algebra A ℂ]
    (p : Nat.Primes) (M : NonzeroResidualCharacteristicMaximalIdeal A p)
    (c : PRegularConjClass G p)
    (P : PrimeSpectrum (A ⊗R(G))) : Prop :=
  Ideal.comap (algebraMap A (A ⊗R(G))) P.asIdeal =
      M.1.asIdeal ∧
    ∀ H : Subgroup G,
      tensorCharacterRingInductionIdeal (A := A) (G := G) H ≤ P.asIdeal ↔
        ¬ HasAssociatedPElementarySubgroupInClass c H

variable [IsDomain A] [Ring.HasFiniteQuotients A]

/-- Helper for Proposition 11-11.4-1: an explicit inclusion of an associated `p`-elementary
subgroup into `H` immediately gives the owner predicate
`HasAssociatedPElementarySubgroupInClass c H`. -/
theorem hasAssociatedPElementarySubgroupInClass_of_le
    {p : Nat.Primes} (c : PRegularConjClass G p) (H : Subgroup G)
    {x : G} (hx : x ∈ c.1.carrier)
    (P : Sylow (p : ℕ) (Subgroup.centralizer ({x} : Set G)))
    (hP : associatedPElementarySubgroup (p : ℕ) x P ≤ H) :
    HasAssociatedPElementarySubgroupInClass c H := by
  -- The defining witnesses are already the chosen class representative `x` and associated
  -- subgroup `associatedPElementarySubgroup p x P`.
  exact ⟨x, hx, P, hP⟩

/-- Helper for Proposition 11-11.4-1: if `H` contains an associated `p`-elementary subgroup from
the `p`-regular class `c`, then `H` already meets the carrier of `c`. This is the concrete
information extracted from the owner predicate before any regular-fiber transport is used. -/
theorem exists_mem_carrier_of_hasAssociatedPElementarySubgroupInClass
    {p : Nat.Primes} {c : PRegularConjClass G p} {H : Subgroup G}
    (hAssoc : HasAssociatedPElementarySubgroupInClass c H) :
    ∃ x : G, x ∈ c.1.carrier ∧ x ∈ H := by
  rcases hAssoc with ⟨x, hx, P, hP⟩
  have hxAssoc : x ∈ associatedPElementarySubgroup (p : ℕ) x P := by
    -- The cyclic factor `⟨x⟩` is one of the two defining summands of the associated subgroup.
    exact
      (show Subgroup.zpowers x ≤ associatedPElementarySubgroup (p : ℕ) x P from le_sup_left)
        (Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩)
  -- Pushing the canonical generator through the assumed subgroup inclusion places a carrier point
  -- of `c` inside `H`.
  exact ⟨x, hx, hP hxAssoc⟩

/-- Helper for Proposition 11-11.4-1: if a subgroup misses the carrier of the `p`-regular class
`c`, then it cannot contain any associated `p`-elementary subgroup coming from `c`. This is the
elementary carrier-side obstruction behind the regular-branch uniqueness blocker. -/
theorem not_hasAssociatedPElementarySubgroupInClass_of_disjoint_carrier
    {p : Nat.Primes} (c : PRegularConjClass G p) (H : Subgroup G)
    (hdisj : ((H : Set G) ∩ c.1.carrier) = ∅) :
    ¬ HasAssociatedPElementarySubgroupInClass c H := by
  intro hAssoc
  rcases exists_mem_carrier_of_hasAssociatedPElementarySubgroupInClass
      (c := c) (H := H) hAssoc with ⟨x, hxc, hxH⟩
  have hx : x ∈ ((H : Set G) ∩ c.1.carrier) := ⟨hxH, hxc⟩
  simpa [hdisj] using hx

/-- Helper for Proposition 11-11.4-1: the scalar algebra map from the arithmetic coefficient ring
into `ℂ` is injective, so its kernel is trivial. -/
theorem ker_algebraMap_complex_eq_bot :
    RingHom.ker (algebraMap A ℂ) = ⊥ := by
  -- If the kernel were nonzero, the finite-quotients hypothesis would make the quotient by that
  -- kernel finite; but that quotient still injects into `ℂ`, so its natural-number casts would
  -- give an infinite subset of a finite type.
  by_contra hker
  let I : Ideal A := RingHom.ker (algebraMap A ℂ)
  have hfinite : Finite (A ⧸ I) := Ring.HasFiniteQuotients.finiteQuotient hker
  let f : A ⧸ I →+* ℂ := RingHom.kerLift (algebraMap A ℂ)
  have hinjective_nat : Function.Injective (fun n : ℕ ↦ (n : A ⧸ I)) := by
    intro n m hnm
    apply Nat.cast_injective (R := ℂ)
    simpa [f, I] using congrArg f hnm
  have hinfinite : Infinite (A ⧸ I) :=
    Infinite.of_injective (fun n : ℕ ↦ (n : A ⧸ I)) hinjective_nat
  letI : Infinite (A ⧸ I) := hinfinite
  exact Finite.false hfinite

/-- Helper for Proposition 11-11.4-1: the residue field at `(0)` is a fraction-field model of
`A`. This is the scalar source needed for the zero-fiber transport. -/
noncomputable instance botResidueField_isFractionRing :
    IsFractionRing A ((⊥ : Ideal A).ResidueField) := by
  -- Rewrite the bottom quotient back to `A`, then reuse the standard residue-field fraction-ring
  -- instance over `A ⧸ (0)`.
  letI : IsFractionRing (A ⧸ (⊥ : Ideal A)) ((⊥ : Ideal A).ResidueField) := inferInstance
  exact IsFractionRing.of_ringEquiv_left (R := A) (S := A ⧸ (⊥ : Ideal A))
    (K := ((⊥ : Ideal A).ResidueField)) (RingEquiv.quotientBot A).symm
    (fun x ↦ by
      change algebraMap A ((⊥ : Ideal A).ResidueField) x =
        algebraMap (A ⧸ (⊥ : Ideal A)) ((⊥ : Ideal A).ResidueField)
          (Ideal.Quotient.mk (⊥ : Ideal A) x)
      rw [Ideal.algebraMap_quotient_residueField_mk])

/-- Helper for Proposition 11-11.4-1: the scalar map `A → ℂ` is injective. This is the exact
input needed to lift it to the fraction-field model `((0).ResidueField)`. -/
theorem algebraMap_complex_injective :
    Function.Injective (algebraMap A ℂ) := by
  rw [RingHom.injective_iff_ker_eq_bot]
  exact ker_algebraMap_complex_eq_bot (A := A)

/-- Helper for Proposition 11-11.4-1: the arithmetic coefficient ring `A` has characteristic
zero because it embeds into `ℂ`. This is the source-side input for transporting characteristic
zero to the bottom residue field. -/
instance charZeroA : CharZero A :=
  RingHom.charZero (algebraMap A ℂ)

/-- Helper for Proposition 11-11.4-1: the residue field at `(0)` is again of characteristic zero.
This is the coefficient-side instance needed for the bottom-fiber tensor-character comparisons. -/
instance botResidueField_charZero :
    CharZero ((⊥ : Ideal A).ResidueField) :=
  (RingHom.charZero_iff
    (IsFractionRing.injective A ((⊥ : Ideal A).ResidueField))).mp inferInstance

/-- Helper for Proposition 11-11.4-1: the bottom residue field inherits the ambient complex
embedding from `A`. This is the coefficient map used to compare the zero fiber with complex
evaluation. -/
noncomputable instance botResidueField_algebraComplex :
    Algebra ((⊥ : Ideal A).ResidueField) ℂ :=
  (IsFractionRing.lift (A := A) (K := ((⊥ : Ideal A).ResidueField)) (L := ℂ)
    (g := algebraMap A ℂ) (hg := algebraMap_complex_injective (A := A))).toAlgebra

/-- Helper for Proposition 11-11.4-1: the coefficient maps `A → ((0).ResidueField) → ℂ` agree
with the original scalar map `A → ℂ`. This scalar-tower instance is the coefficient-side input
needed to restrict transported bottom-fiber evaluation maps from `((0).ResidueField)` back to
`A`. -/
instance botResidueField_complex_isScalarTower :
    IsScalarTower A ((⊥ : Ideal A).ResidueField) ℂ :=
  IsScalarTower.of_algebraMap_eq fun x ↦ by
    -- The fraction-field lift was defined to extend the original coefficient map `A → ℂ`.
    change algebraMap A ℂ x =
      (algebraMap ((⊥ : Ideal A).ResidueField) ℂ)
        (algebraMap A ((⊥ : Ideal A).ResidueField) x)
    exact
      (IsFractionRing.lift_algebraMap
        (A := A) (K := ((⊥ : Ideal A).ResidueField)) (L := ℂ)
        (g := algebraMap A ℂ) (hg := algebraMap_complex_injective (A := A)) x).symm

/-- Helper for Proposition 11-11.4-1: a prime with zero contraction lies over `(0)` in the sense
used by `Ideal.primesOver`. -/
theorem prime_asIdeal_liesOver_bot
    (𝔭 : PrimeSpectrum (A ⊗R(G)))
    (h𝔭 : Ideal.comap (algebraMap A (A ⊗R(G))) 𝔭.asIdeal = ⊥) :
    𝔭.asIdeal.LiesOver (⊥ : Ideal A) := by
  exact ⟨h𝔭.symm⟩

/-- Helper for Proposition 11-11.4-1: a prime of `A ⊗ R(G)` with zero contraction packages
canonically as a point of the bottom fiber `Spec (((0).ResidueField) ⊗[A] (A ⊗ R(G)))`. -/
noncomputable def prime_over_bot_to_fiber
    (𝔭 : PrimeSpectrum (A ⊗R(G)))
    (h𝔭 : Ideal.comap (algebraMap A (A ⊗R(G))) 𝔭.asIdeal = ⊥) :
    PrimeSpectrum (((⊥ : Ideal A).Fiber (A ⊗R(G)))) :=
  letI : 𝔭.asIdeal.LiesOver (⊥ : Ideal A) := prime_asIdeal_liesOver_bot (A := A) (G := G) 𝔭 h𝔭
  PrimeSpectrum.primesOverOrderIsoFiber A (A ⊗R(G)) (⊥ : Ideal A)
    (Ideal.primesOver.mk (⊥ : Ideal A) 𝔭.asIdeal)

/-- Helper for Proposition 11-11.4-1: transporting the bottom-fiber point back along
`PrimeSpectrum.primesOverOrderIsoFiber` recovers the original prime ideal of `A ⊗ R(G)`. -/
theorem prime_over_bot_to_fiber_symm
    (𝔭 : PrimeSpectrum (A ⊗R(G)))
    (h𝔭 : Ideal.comap (algebraMap A (A ⊗R(G))) 𝔭.asIdeal = ⊥) :
    ((PrimeSpectrum.primesOverOrderIsoFiber A (A ⊗R(G)) (⊥ : Ideal A)).symm
      (prime_over_bot_to_fiber (A := A) (G := G) 𝔭 h𝔭)).1 =
        𝔭.asIdeal := by
  -- This is just the inverse-side normalization of the standard fiber/primes-over order isomorphism.
  letI : 𝔭.asIdeal.LiesOver (⊥ : Ideal A) := prime_asIdeal_liesOver_bot (A := A) (G := G) 𝔭 h𝔭
  simpa [prime_over_bot_to_fiber]
    using congrArg PrimeSpectrum.asIdeal
      ((PrimeSpectrum.primesOverOrderIsoFiber A (A ⊗R(G)) (⊥ : Ideal A)).symm_apply_apply
        (Ideal.primesOver.mk (⊥ : Ideal A) 𝔭.asIdeal))

/-- Helper for Proposition 11-11.4-1: a prime lying over the fixed maximal ideal `M` lies over
`M` in the sense used by `Ideal.primesOver`. -/
theorem prime_asIdeal_liesOver_fixed_maximal
    (p : Nat.Primes) (M : NonzeroResidualCharacteristicMaximalIdeal A p)
    (𝔭 : PrimeSpectrum (A ⊗R(G)))
    (h𝔭 : Ideal.comap (algebraMap A (A ⊗R(G))) 𝔭.asIdeal = M.1.asIdeal) :
    𝔭.asIdeal.LiesOver M.1.asIdeal := by
  exact ⟨h𝔭.symm⟩

/-- Helper for Proposition 11-11.4-1: a prime of `A ⊗ R(G)` lying over the fixed maximal ideal
`M` packages canonically as a point of the corresponding fiber over `M`. -/
noncomputable def prime_over_fixed_maximal_to_fiber
    (p : Nat.Primes) (M : NonzeroResidualCharacteristicMaximalIdeal A p)
    (𝔭 : PrimeSpectrum (A ⊗R(G)))
    (h𝔭 : Ideal.comap (algebraMap A (A ⊗R(G))) 𝔭.asIdeal = M.1.asIdeal) :
    PrimeSpectrum (M.1.asIdeal.Fiber (A ⊗R(G))) :=
  letI : 𝔭.asIdeal.LiesOver M.1.asIdeal :=
    prime_asIdeal_liesOver_fixed_maximal (A := A) (G := G) p M 𝔭 h𝔭
  PrimeSpectrum.primesOverOrderIsoFiber A (A ⊗R(G)) M.1.asIdeal
    (Ideal.primesOver.mk M.1.asIdeal 𝔭.asIdeal)

/-- Helper for Proposition 11-11.4-1: transporting the fixed-maximal-fiber point back along
`PrimeSpectrum.primesOverOrderIsoFiber` recovers the original prime ideal of `A ⊗ R(G)`. -/
theorem prime_over_fixed_maximal_to_fiber_symm
    (p : Nat.Primes) (M : NonzeroResidualCharacteristicMaximalIdeal A p)
    (𝔭 : PrimeSpectrum (A ⊗R(G)))
    (h𝔭 : Ideal.comap (algebraMap A (A ⊗R(G))) 𝔭.asIdeal = M.1.asIdeal) :
    ((PrimeSpectrum.primesOverOrderIsoFiber A (A ⊗R(G)) M.1.asIdeal).symm
      (prime_over_fixed_maximal_to_fiber (A := A) (G := G) p M 𝔭 h𝔭)).1 =
        𝔭.asIdeal := by
  -- This is the same normalization step as in the zero fiber, now over the chosen maximal ideal.
  letI : 𝔭.asIdeal.LiesOver M.1.asIdeal :=
    prime_asIdeal_liesOver_fixed_maximal (A := A) (G := G) p M 𝔭 h𝔭
  simpa [prime_over_fixed_maximal_to_fiber]
    using congrArg PrimeSpectrum.asIdeal
      ((PrimeSpectrum.primesOverOrderIsoFiber A (A ⊗R(G)) M.1.asIdeal).symm_apply_apply
        (Ideal.primesOver.mk M.1.asIdeal 𝔭.asIdeal))


end RegularPrime

end
