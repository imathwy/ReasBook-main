/-- Helper for Exercise 16-16.2-3: a complete-local forward range-to-character theorem gives the
product-coordinate trace vanishing in a `p`-elementary decomposition. -/
theorem pElementary_product_trace_eq_zero_of_forwardRange_character_vanishing
    {A : Type u} [CommRing A] [IsLocalRing A] [HenselianLocalRing A]
    [IsNoetherianRing A] [IsAdicComplete (IsLocalRing.maximalIdeal A) A]
    [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    (hforward :
      ∀ {x : R₀[K](H)},
        x ∈
          (projectiveGrothendieckScalarExtensionHom A K :
            P₀[IsLocalRing.ResidueField A](H) →+ R₀[K](H)).range →
        ∀ h : H, ¬ IsPRegular p h →
          (finiteRepGrothendieckCharacter K H x : H → K) h = 0)
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) (hhp : hp ≠ 1) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := H) Q.V) ((s : H) * (hp : H))) = 0 := by
  -- First turn the forward Grothendieck-range theorem into source-level integral trace
  -- vanishing for every `p`-singular element of `H`.
  have htrace :
      ∀ g : H, ¬ IsPRegular p g →
        LinearMap.trace A Q.V
          ((Representation.ofModule' (k := A) (G := H) Q.V) g) = 0 := by
    intro g hg
    exact trace_action_eq_zero_of_forwardRange_character_vanishing
      (A := A) (K := K) (H := H) (p := p) hforward Q g hg
  -- The product coordinate has nontrivial `p`-part, so the source-level trace theorem applies.
  exact pElementary_product_trace_eq_zero_of_pSingular_trace
    (A := A) (p := p) (H := H) (V := Q.V) hSP htrace s hp hhp

/-- Helper for Exercise 16-16.2-3: an existential Hattori-coefficient witness in an `A[P]`
basis is exactly the input needed to prove the corresponding composed `p`-group trace
vanishing. -/
theorem trace_comp_pGroupAction_eq_zero_of_exists_hattoriCoeff_basis
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A V] [Module.Finite A V]
    (u : V →ₗ[A[P]] V) {hp : P}
    (hbasis :
      ∃ (ι : Type u) (_ : Fintype ι) (b : Module.Basis ι A[P] V),
        ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0) :
    LinearMap.trace A V
      ((u.restrictScalars A).comp
        ((Representation.ofModule' (k := A) (G := P) V) hp)) = 0 := by
  rcases hbasis with ⟨ι, hι, b, hcoeff⟩
  letI : Fintype ι := hι
  -- The existing trace formula consumes precisely this coefficient sum in the chosen basis.
  exact trace_comp_pGroupAction_eq_zero_of_hattoriCoeff_basis
    (A := A) (P := P) (V := V) (b := b) (u := u) (hp := hp) hcoeff

/-- Helper for Exercise 16-16.2-3: coordinate-wise `PPartBlockTraceData` in the cyclic
`p`-elementary decomposition is enough to prove trace vanishing on every `p`-singular element. -/
theorem cyclic_trace_action_eq_zero_on_pSingular_of_coordBlockTraceData
    {A : Type u} [CommRing A] [IsLocalRing A]
    {p : ℕ} [Fact p.Prime]
    {H : Type u} [Group H] [Finite H] [IsCyclic H]
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (hdata :
      ∀ {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
        (s : S) (hp : P), hp ≠ 1 →
        let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
        let _ : Module A[P] Q.V := Module.compHom Q.V τ
        let _ : IsScalarTower A A[P] Q.V :=
          subgroup_compHom_isScalarTower (A := A) (G := H) P Q.V
        Nonempty
          (PPartBlockTraceData (A := A) (V := Q.V) (H := P)
            (((pElementary_leftCoord_action_pSubgroupLinear
              (A := A) (H := H) (V := Q.V) hSP s).restrictScalars A).comp
              ((Representation.ofModule' (k := A) (G := P) Q.V) hp))
            hp))
    (h : H) (hh : ¬ IsPRegular p h) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := H) Q.V) h) = 0 := by
  letI : Module.Free A Q.V :=
    FiniteProjectiveGroupAlgebraModule.free (A := A) (G := H) Q
  letI : Module.Finite A Q.V := Q.finite
  -- Reduce the cyclic singular element to a coordinate-product trace in a `p`-elementary
  -- decomposition.
  refine cyclic_trace_action_eq_zero_on_pSingular_of_rightCoord_trace
    (A := A) (p := p) (H := H) (V := Q.V) ?_ h hh
  intro S P hSP s hp hhp
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] Q.V := Module.compHom Q.V τ
  let _ : IsScalarTower A A[P] Q.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P Q.V
  have htraceP :
      LinearMap.trace A Q.V
        (((pElementary_leftCoord_action_pSubgroupLinear
            (A := A) (H := H) (V := Q.V) hSP s).restrictScalars A).comp
          ((Representation.ofModule' (k := A) (G := P) Q.V) hp)) = 0 := by
    -- The supplied block data kills the trace of the nontrivial `P`-coordinate action.
    exact trace_eq_zero_of_nonempty_pPartBlockTraceData
      (A := A) (V := Q.V) (H := P) hhp (hdata hSP s hp hhp)
  -- Rewrite the restricted `P`-coordinate spelling back to the ambient cyclic group action.
  rw [pElementary_coord_action_eq_pSubgroupLinear_comp
    (A := A) (H := H) (V := Q.V) hSP s hp] at htraceP
  exact htraceP

/-- Helper for Exercise 16-16.2-3: Swan's integral trace theorem reduces to the cyclic subgroup
generated by the `p`-singular element. -/
theorem localDVR_projective_trace_eq_zero_on_pSingular_of_cyclic_trace
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    (Q : FiniteProjectiveGroupAlgebraModule A G)
    (g : G) (hg : ¬ IsPRegular p g)
    (hcyclic :
      ∀ {H : Type u} [Group H] [Finite H] [IsCyclic H],
        (QH : FiniteProjectiveGroupAlgebraModule A H) →
        (h : H) → ¬ IsPRegular p h →
          LinearMap.trace A QH.V
            ((Representation.ofModule' (k := A) (G := H) QH.V) h) = 0) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := G) Q.V) g) = 0 := by
  -- Restrict the projective owner to the cyclic subgroup generated by the chosen singular
  -- element; the subgroup generator remains `p`-singular.
  let H : Subgroup G := Subgroup.zpowers g
  have hg_mem : g ∈ H := Subgroup.mem_zpowers g
  let h : H := ⟨g, hg_mem⟩
  let QH : FiniteProjectiveGroupAlgebraModule A H :=
    restrictedToSubgroup (A := A) (G := G) H Q
  have hh : ¬ IsPRegular p h :=
    zpowers_generator_not_isPRegular (p := p) (G := G) g hg
  have htraceH :
      LinearMap.trace A QH.V
        ((Representation.ofModule' (k := A) (G := H) QH.V) h) = 0 := by
    -- The supplied cyclic source theorem applies after installing cyclicity of `Subgroup.zpowers`.
    letI : IsCyclic H := by
      simpa [H] using Subgroup.isCyclic_zpowers g
    exact hcyclic QH h hh
  -- The restricted trace is the ambient trace of the original element.
  rw [← trace_action_restrictedToSubgroup_eq_ambient (A := A) (G := G) (Q := Q) (h := h)]
  exact htraceH

/-- Helper for Exercise 16-16.2-3: a source-facing cyclic integral trace theorem implies the
local DVR character vanishing theorem for the ambient projective owner. -/
