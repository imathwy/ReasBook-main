/-- Helper for Exercise 16-16.2-3: coordinate-wise block trace data on every cyclic restriction
implies Swan's integral trace vanishing over a local DVR. -/
theorem localDVR_projective_trace_eq_zero_on_pSingular_of_cyclic_coordBlockTraceData
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
