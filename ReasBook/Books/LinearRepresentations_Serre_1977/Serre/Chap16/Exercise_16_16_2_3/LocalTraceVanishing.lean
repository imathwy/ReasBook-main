/-- Helper for Exercise 16-16.2-3: the canonical generator of `Subgroup.zpowers g` stays
`p`-singular when `g` is `p`-singular. -/
theorem zpowers_generator_not_isPRegular
    {p : ℕ} [Fact p.Prime]
    {G : Type u} [Group G] [Finite G]
    (g : G) (hg : ¬ IsPRegular p g) :
    ¬ IsPRegular p (⟨g, by simp⟩ : Subgroup.zpowers g) := by
  -- Compare `IsPRegular` through the order-divisibility criterion and the subgroup order map.
  rw [isPRegular_iff_not_dvd_orderOf (p := p) g] at hg
  rw [isPRegular_iff_not_dvd_orderOf (p := p) (⟨g, by simp⟩ : Subgroup.zpowers g)]
  intro hregular
  exact hg (by simpa [Subgroup.orderOf_mk] using hregular)

/-- Helper for Exercise 16-16.2-3: the cyclic subgroup generated by the `p`-unipotent
component of a finite group element is a `p`-group. -/
theorem isPGroup_zpowers_pUnipotentComponent
    {p : ℕ} [Fact p.Prime]
    {G : Type u} [Group G] [Finite G]
    (g : G) :
    IsPGroup p (Subgroup.zpowers (pUnipotentComponent p g)) := by
  -- The Chapter 10 component theorem says the chosen unipotent component is a `p`-element.
  exact isPGroup_zpowers_of_isPElement
    (p := p) (x := pUnipotentComponent p g)
    (isPElement_pUnipotentComponent (p := p) g)

/-- Helper for Exercise 16-16.2-3: an element of the cyclic subgroup whose ambient value is the
`p`-unipotent component is nontrivial when the original element is not `p`-regular. -/
theorem zpowersElement_ne_one_of_coe_pUnipotentComponent
    {p : ℕ} [Fact p.Prime]
    {G : Type u} [Group G] [Finite G]
    {g : G} (hg : ¬ IsPRegular p g)
    {u : Subgroup.zpowers (pUnipotentComponent p g)}
    (hu : (u : G) = pUnipotentComponent p g) :
    u ≠ 1 := by
  -- Coercing an equality `u = 1` to the ambient group would make the unipotent component
  -- trivial, contradicting the canonical component theorem for a p-singular element.
  intro hu_one
  have hcomponent_one : pUnipotentComponent p g = 1 := by
    rw [← hu]
    exact congrArg Subtype.val hu_one
  exact pUnipotentComponent_ne_one_of_not_isPRegular
    (p := p) g hg hcomponent_one

/-- Helper for Exercise 16-16.2-3: the canonical generator of the cyclic subgroup generated by
the `p`-unipotent component is nontrivial for a `p`-singular element. -/
theorem pUnipotentComponent_zpowersGenerator_ne_one_of_not_isPRegular
    {p : ℕ} [Fact p.Prime]
    {G : Type u} [Group G] [Finite G]
    {g : G} (hg : ¬ IsPRegular p g) :
    (⟨pUnipotentComponent p g, Subgroup.mem_zpowers (pUnipotentComponent p g)⟩ :
      Subgroup.zpowers (pUnipotentComponent p g)) ≠ 1 := by
  -- Specialize the ambient-value criterion to the canonical subgroup generator.
  exact zpowersElement_ne_one_of_coe_pUnipotentComponent
    (p := p) (G := G) (g := g) hg rfl

/-- Helper for Exercise 16-16.2-3: a nonidentity element of a `p`-group is not `p`-regular. -/
theorem not_isPRegular_of_isPGroup_ne_one
    {p : ℕ} [Fact p.Prime]
    {P : Type u} [Group P] (hP : IsPGroup p P)
    {x : P} (hx : x ≠ 1) :
    ¬ IsPRegular p x := by
  -- A `p`-group element has order a power of `p`; if the element is nontrivial, that power has
  -- positive exponent, so `p` divides the order and regularity is impossible.
  rw [isPRegular_iff_not_dvd_orderOf (p := p) x]
  intro hnot_dvd
  rcases (IsPGroup.iff_orderOf.mp hP x) with ⟨k, hk⟩
  have hk_ne_zero : k ≠ 0 := by
    intro hk_zero
    apply hx
    exact orderOf_eq_one_iff.mp (by simp [hk, hk_zero])
  exact hnot_dvd (by
    rw [hk]
    exact dvd_pow_self p hk_ne_zero)

/-- Helper for Exercise 16-16.2-3: the canonical generator of the cyclic subgroup generated by
the `p`-unipotent component is itself `p`-singular when the original element is `p`-singular. -/
theorem pUnipotentComponent_zpowersGenerator_not_isPRegular_of_not_isPRegular
    {p : ℕ} [Fact p.Prime]
    {G : Type u} [Group G] [Finite G]
    {g : G} (hg : ¬ IsPRegular p g) :
    ¬ IsPRegular p
      (⟨pUnipotentComponent p g,
        Subgroup.mem_zpowers (pUnipotentComponent p g)⟩ :
        Subgroup.zpowers (pUnipotentComponent p g)) := by
  -- The generated subgroup is a `p`-group, and the previous lemma shows its nontrivial
  -- canonical generator cannot be `p`-regular.
  exact not_isPRegular_of_isPGroup_ne_one
    (p := p)
    (isPGroup_zpowers_pUnipotentComponent (p := p) (G := G) g)
    (pUnipotentComponent_zpowersGenerator_ne_one_of_not_isPRegular
      (p := p) (G := G) (g := g) hg)

/-- Helper for Exercise 16-16.2-3: the subgroup-algebra inclusion sends a basis element to the
corresponding ambient group-algebra basis element. -/
theorem subgroup_mapDomainRingHom_single
    {A : Type u} [CommRing A] {G : Type u} [Group G]
    (H : Subgroup G) (h : H) :
    (MonoidAlgebra.mapDomainRingHom A H.subtype)
        (MonoidAlgebra.single h (1 : A)) =
      (MonoidAlgebra.single (h : G) (1 : A) : A[G]) := by
  -- Unfold the domain map once; the singleton coefficient is transported along `H.subtype`.
  simp [MonoidAlgebra.mapDomainRingHom]

/-- Helper for Exercise 16-16.2-3: scalar extension of a local finite projective owner computes
the character value by mapping the integral trace to the fraction field. -/
theorem character_scalarExtension_eq_algebraMap_trace
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    (Q : FiniteProjectiveGroupAlgebraModule A G) (g : G) :
    (Q.scalarExtension K).character g =
      algebraMap A K
        (LinearMap.trace A Q.V ((Representation.ofModule' (k := A) (G := G) Q.V) g)) := by
  -- A finite projective module over the local DVR is free, so trace commutes with base change.
  letI : Module.Free A Q.V :=
    FiniteProjectiveGroupAlgebraModule.free (A := A) (G := G) Q
  have hbaseChange :
      (Q.scalarExtension K).ρ g =
        ((Representation.ofModule' (k := A) (G := G) Q.V) g).baseChange K := rfl
  change LinearMap.trace K _ ((Q.scalarExtension K).ρ g) = _
  rw [hbaseChange]
  exact LinearMap.trace_baseChange
    ((Representation.ofModule' (k := A) (G := G) Q.V) g) K

/-- Helper for Exercise 16-16.2-3: if a character value vanishes after an injective scalar
extension of fields, then it already vanishes over the base field. -/
theorem character_eq_zero_of_scalarExtension_character_eq_zero
    {K K' : Type u} [Field K] [Field K'] [Algebra K K']
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (ρ : Representation K H V) {g : H}
    (hzero : (Representation.scalarExtension (k := K') ρ).character g = 0) :
    ρ.character g = 0 := by
  -- Map the desired zero statement to the extension field, where trace base-change identifies
  -- it with the supplied scalar-extension character value.
  apply (algebraMap K K').injective
  rw [map_zero]
  calc
    algebraMap K K' (ρ.character g) =
        (Representation.scalarExtension (k := K') ρ).character g := by
          exact (LinearMap.trace_baseChange (ρ g) K').symm
    _ = 0 := hzero

/-- Helper for Exercise 16-16.2-3: the forward direction of Theorem 36 gives ordinary
character vanishing for an actual projective local owner. -/
theorem localDVR_projective_character_eq_zero_on_pSingular_of_forwardRange
    {A : Type u} [CommRing A] [IsLocalRing A] [HenselianLocalRing A]
    [IsNoetherianRing A] [IsAdicComplete (IsLocalRing.maximalIdeal A) A]
    [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    (hforward :
      ∀ {x : R₀[K](H)},
        x ∈
          (projectiveGrothendieckScalarExtensionHom A K :
            P₀[IsLocalRing.ResidueField A](H) →+ R₀[K](H)).range →
        ∀ h : H, ¬ IsPRegular p h →
          (finiteRepGrothendieckCharacter K H x : H → K) h = 0)
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (h : H) (hh : ¬ IsPRegular p h) :
    (Q.scalarExtension K).character h = 0 := by
  -- The projective owner contributes a range witness, so the supplied forward theorem applies
  -- directly to its scalar-extension class.
  exact projectiveScalarExtension_character_eq_zero_on_pSingular_of_forwardRange
    (A := A) (K := K) (H := H) (p := p) hforward Q h hh

/-- Helper for Exercise 16-16.2-3: the forward direction of Theorem 36 also gives the integral
trace vanishing statement by descending the scalar-extension character equality through the
fraction-field embedding. -/
theorem localDVR_projective_trace_eq_zero_on_pSingular_of_forwardRange
    {A : Type u} [CommRing A] [IsLocalRing A] [HenselianLocalRing A]
    [IsNoetherianRing A] [IsAdicComplete (IsLocalRing.maximalIdeal A) A]
    [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    (hforward :
      ∀ {x : R₀[K](H)},
        x ∈
          (projectiveGrothendieckScalarExtensionHom A K :
            P₀[IsLocalRing.ResidueField A](H) →+ R₀[K](H)).range →
        ∀ h : H, ¬ IsPRegular p h →
          (finiteRepGrothendieckCharacter K H x : H → K) h = 0)
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (h : H) (hh : ¬ IsPRegular p h) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := H) Q.V) h) = 0 := by
  -- First use the forward Grothendieck-range theorem to kill the quotient-field character.
  have hchar :
      (Q.scalarExtension K).character h = 0 :=
    localDVR_projective_character_eq_zero_on_pSingular_of_forwardRange
      (A := A) (K := K) (H := H) (p := p) hforward Q h hh
  -- The scalar-extension character is the image of the integral trace, so injectivity of the
  -- fraction-field map descends the zero statement back to `A`.
  rw [character_scalarExtension_eq_algebraMap_trace (G := H) (K := K) Q h] at hchar
  exact (IsFractionRing.injective A K) (by simpa using hchar)

/-- Helper for Exercise 16-16.2-3: a `p`-singular element cannot be the identity. -/
theorem ne_one_of_not_isPRegular
    {p : ℕ} {H : Type u} [Group H] {h : H} (hh : ¬ IsPRegular p h) :
    h ≠ 1 := by
  -- The identity is always `p`-regular, so a `p`-singular element must be nontrivial.
  intro h1
  exact hh (by simpa [h1] using (isPRegular_one (G := H) p))

/-- Helper for Exercise 16-16.2-3: a free group-algebra module has zero trace for a
`p`-singular group element. -/
theorem trace_action_eq_zero_of_free_over_groupAlgebra_of_not_isPRegular
    {R : Type u} [CommRing R] {H : Type u} [Group H] [Finite H]
    {M : Type u} [AddCommGroup M] [Module R M] [Module (MonoidAlgebra R H) M]
    [IsScalarTower R (MonoidAlgebra R H) M]
    [Module.Free (MonoidAlgebra R H) M] [Module.Finite (MonoidAlgebra R H) M]
    {p : ℕ} {h : H} (hh : ¬ IsPRegular p h) :
    LinearMap.trace R M ((Representation.ofModule' M : Representation R H M) h) = 0 := by
  -- Convert the source `p`-singularity side condition into the nonidentity hypothesis used by
  -- the explicit regular-module trace computation.
  exact
    trace_action_eq_zero_of_free_over_groupAlgebra
      (R := R) (H := H) (M := M)
      (ne_one_of_not_isPRegular (p := p) hh)

/-- Helper for Exercise 16-16.2-3: the trace of a block-diagonal endomorphism on a finite product
of finite free modules over a commutative ring is the sum of the traces of its blocks. -/
theorem trace_piMap_eq_sum_trace_commRing
    {R : Type u} [CommRing R] {ι : Type u} [Fintype ι]
    {M : ι → Type u} [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, Module.Free R (M i)] [∀ i, Module.Finite R (M i)]
    (f : ∀ i, M i →ₗ[R] M i) :
    LinearMap.trace R (∀ i, M i) (LinearMap.piMap f) =
      ∑ i, LinearMap.trace R (M i) (f i) := by
  classical
  let b : ∀ i, Module.Basis _ R (M i) := fun i ↦ Module.Free.chooseBasis R (M i)
  -- Use the sigma-indexed product basis, where the matrix trace separates into the block traces.
  rw [LinearMap.trace_eq_matrix_trace R (Pi.basis b)]
  simp [Matrix.trace, Matrix.diag_apply, Fintype.sum_sigma, LinearMap.piMap,
    LinearMap.toMatrix_apply]
  congr with i
  simpa [Matrix.trace, LinearMap.toMatrix_apply] using
    (LinearMap.trace_eq_matrix_trace R (b i) (f i)).symm

/-- Helper for Exercise 16-16.2-3: a scalar block decomposition has zero total trace when each
non-scalar block operator has zero trace. -/
theorem trace_eq_zero_of_scalarBlockDecomposition
    {R : Type u} [CommRing R]
    {V : Type u} [AddCommGroup V] [Module R V]
    {ι : Type u} [Fintype ι]
    {M : ι → Type u} [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, Module.Free R (M i)] [∀ i, Module.Finite R (M i)]
    (T : V →ₗ[R] V)
    (e : V ≃ₗ[R] ∀ i, M i)
    (ω : ι → R) (ν : ∀ i, M i →ₗ[R] M i)
    (haction : T = e.symm.conj (LinearMap.piMap fun i ↦ ω i • ν i))
    (htrace : ∀ i, LinearMap.trace R (M i) (ν i) = 0) :
    LinearMap.trace R V T = 0 := by
  -- Move the trace across the product decomposition and then sum the zero traces of the blocks.
  rw [haction, LinearMap.trace_conj',
    trace_piMap_eq_sum_trace_commRing (R := R) (f := fun i ↦ ω i • ν i)]
  simp [htrace]

/-- Helper for Exercise 16-16.2-3: multiplying the action of a nonidentity element on a finite
free group-algebra module by a scalar still has zero base-linear trace. -/
theorem trace_smul_action_eq_zero_of_free_over_pSubgroupAlgebra
    {R : Type u} [CommRing R] {H : Type u} [Group H] [Finite H]
    {M : Type u} [AddCommGroup M] [Module R M] [Module (MonoidAlgebra R H) M]
    [IsScalarTower R (MonoidAlgebra R H) M]
    [Module.Free (MonoidAlgebra R H) M] [Module.Finite (MonoidAlgebra R H) M]
    {h : H} (hh : h ≠ 1) (ω : R) :
    LinearMap.trace R M (ω • ((Representation.ofModule' (k := R) (G := H) M) h)) = 0 := by
  -- Pull the scalar through the linear trace and use the free group-algebra calculation.
  have htrace :
      LinearMap.trace R M ((Representation.ofModule' (k := R) (G := H) M) h) = 0 :=
    trace_action_eq_zero_of_free_over_groupAlgebra (R := R) (H := H) (M := M) hh
  calc
    LinearMap.trace R M (ω • ((Representation.ofModule' (k := R) (G := H) M) h)) =
        ω • LinearMap.trace R M ((Representation.ofModule' (k := R) (G := H) M) h) := by
          exact map_smul (LinearMap.trace R M) ω
            ((Representation.ofModule' (k := R) (G := H) M) h)
    _ = 0 := by
          rw [htrace, smul_zero]

/-- Helper for Exercise 16-16.2-3: on a finite free group-algebra module, the action of a single
nonidentity group-algebra coordinate with arbitrary base coefficient has zero base-linear trace. -/
theorem trace_single_groupAlgebraCoordinate_eq_zero_of_free
    {R : Type u} [CommRing R] {H : Type u} [Group H] [Finite H]
    {M : Type u} [AddCommGroup M] [Module R M] [Module (MonoidAlgebra R H) M]
    [IsScalarTower R (MonoidAlgebra R H) M]
    [Module.Free (MonoidAlgebra R H) M] [Module.Finite (MonoidAlgebra R H) M]
    (ω : R) {h : H} (hh : h ≠ 1) :
    LinearMap.trace R M
      (((Representation.ofModule' (k := R) (G := H) M).asAlgebraHom)
        (MonoidAlgebra.single h ω)) = 0 := by
  -- Normalize a singleton group-algebra coordinate to a scalar multiple of the corresponding
  -- group action, then reuse the free regular-basis trace calculation.
  rw [Representation.asAlgebraHom_single]
  exact trace_smul_action_eq_zero_of_free_over_pSubgroupAlgebra
    (R := R) (H := H) (M := M) hh ω

/-- Helper for Exercise 16-16.2-3: a block decomposition whose blocks are scalar multiples of a
nonidentity group-algebra-free action has zero total trace. -/
theorem trace_eq_zero_of_pPartBlockDecomposition
    {R : Type u} [CommRing R]
    {V : Type u} [AddCommGroup V] [Module R V]
    {H : Type u} [Group H] [Finite H]
    {ι : Type u} [Finite ι]
    {M : ι → Type u} [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
    [∀ i, Module (MonoidAlgebra R H) (M i)]
    [∀ i, IsScalarTower R (MonoidAlgebra R H) (M i)]
    [∀ i, Module.Free (MonoidAlgebra R H) (M i)]
    [∀ i, Module.Finite (MonoidAlgebra R H) (M i)]
    [∀ i, Module.Free R (M i)] [∀ i, Module.Finite R (M i)]
    (T : V →ₗ[R] V)
    (e : V ≃ₗ[R] ∀ i, M i)
    (ω : ι → R) {h : H} (hh : h ≠ 1)
    (haction :
      T =
        e.symm.conj
          (LinearMap.piMap fun i ↦
            ω i • ((Representation.ofModule' (k := R) (G := H) (M i)) h))) :
    LinearMap.trace R V T = 0 := by
  letI : Fintype ι := Fintype.ofFinite ι
  -- Reduce the product trace to the block traces; each block trace is zero by the free action
  -- lemma, after ignoring the harmless scalar.
  exact
    trace_eq_zero_of_scalarBlockDecomposition
      (R := R) (T := T) (e := e) (ω := ω)
      (ν := fun i ↦ (Representation.ofModule' (k := R) (G := H) (M i)) h)
      haction
      (fun i ↦
        trace_action_eq_zero_of_free_over_groupAlgebra
          (R := R) (H := H) (M := M i) hh)

/-- Helper for Exercise 16-16.2-3: the trace vanishes after base change once Swan's
`p`-singular action has been identified with scalar blocks over a nontrivial `p`-part action. -/
theorem trace_action_eq_zero_of_pSingularBlockTrace_after_baseChange
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {G : Type u} [Group G] [Finite G]
    (Q : FiniteProjectiveGroupAlgebraModule A G) (g : G)
    {H : Type u} [Group H] [Finite H]
    {ι : Type u} [Finite ι]
    {M : ι → Type u} [∀ i, AddCommGroup (M i)] [∀ i, Module B (M i)]
    [∀ i, Module (MonoidAlgebra B H) (M i)]
    [∀ i, IsScalarTower B (MonoidAlgebra B H) (M i)]
    [∀ i, Module.Free (MonoidAlgebra B H) (M i)]
    [∀ i, Module.Finite (MonoidAlgebra B H) (M i)]
    [∀ i, Module.Free B (M i)] [∀ i, Module.Finite B (M i)]
    (e : TensorProduct A B Q.V ≃ₗ[B] ∀ i, M i)
    (ω : ι → B) {h : H} (hh : h ≠ 1)
    (haction :
      (((Representation.ofModule' (k := A) (G := G) Q.V) g).baseChange B) =
        e.symm.conj
          (LinearMap.piMap fun i ↦
            ω i • ((Representation.ofModule' (k := B) (G := H) (M i)) h))) :
    LinearMap.trace B (TensorProduct A B Q.V)
      (((Representation.ofModule' (k := A) (G := G) Q.V) g).baseChange B) = 0 := by
  letI : Fintype ι := Fintype.ofFinite ι
  -- The base-changed action is already in the canonical block form, so the abstract block trace
  -- lemma applies directly.
  exact
    trace_eq_zero_of_pPartBlockDecomposition
      (R := B) (H := H)
      (T := ((Representation.ofModule' (k := A) (G := G) Q.V) g).baseChange B)
      (e := e) (ω := ω) hh haction

/-- Helper for Exercise 16-16.2-3: a vanishing trace after an injective scalar extension descends
to the original finite free module. -/
theorem trace_eq_zero_of_baseChange_trace_eq_zero
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {M : Type u} [AddCommGroup M] [Module A M]
    [Module.Free A M] [Module.Finite A M]
    (hinj : Function.Injective (algebraMap A B))
    (f : M →ₗ[A] M)
    (htrace : LinearMap.trace B (TensorProduct A B M) (f.baseChange B) = 0) :
    LinearMap.trace A M f = 0 := by
  -- Apply injectivity after rewriting the scalar-extended trace by the base-change formula.
  apply hinj
  rw [map_zero, ← LinearMap.trace_baseChange f B]
  exact htrace

/-- Helper for Exercise 16-16.2-3: in a tensor-regular model, a nonidentity element in the
regular right factor forces the total trace to vanish. -/
theorem trace_eq_zero_of_tensorRegularModel_right_ne_one
    {R : Type u} [CommRing R]
    {V F : Type u} [AddCommGroup V] [Module R V]
    [AddCommGroup F] [Module R F]
    [Module.Free R V] [Module.Finite R V]
    [Module.Free R F] [Module.Finite R F]
    {P : Type u} [Group P] [Finite P]
    (T : V →ₗ[R] V)
    (e : V ≃ₗ[R] TensorProduct R F (MonoidAlgebra R P))
    (u : F →ₗ[R] F) {hp : P} (hhp : hp ≠ 1)
    (haction :
      T =
        e.symm.conj
          (TensorProduct.map u
            ((Representation.ofModule' (k := R) (G := P) (MonoidAlgebra R P)) hp))) :
    LinearMap.trace R V T = 0 := by
  classical
  letI : Fintype P := Fintype.ofFinite P
  letI : Module.Free R (MonoidAlgebra R P) :=
    Module.Free.of_basis (MonoidAlgebra.basis P R)
  letI : Module.Finite R (MonoidAlgebra R P) :=
    Module.Finite.of_basis (MonoidAlgebra.basis P R)
  -- Transport the trace to the tensor model and separate it into the two tensor factors.
  rw [haction, LinearMap.trace_conj', LinearMap.trace_tensorProduct']
  have hright :
      LinearMap.trace R (MonoidAlgebra R P)
        ((Representation.ofModule' (k := R) (G := P) (MonoidAlgebra R P)) hp) = 0 := by
    -- The right factor is the regular `R[P]`-module, so the nonidentity action has zero trace.
    exact
      trace_action_eq_zero_of_free_over_groupAlgebra
        (R := R) (H := P) (M := MonoidAlgebra R P) hhp
  rw [hright, mul_zero]

/-- Helper for Exercise 16-16.2-3: a full projective owner over `A[H]` stays projective after
restricting scalars to the group algebra of a subgroup `P ≤ H`. -/
theorem pSubgroup_compHom_projective_of_ambient_projective
    {A : Type u} [CommRing A]
    {H : Type u} [Group H] [Finite H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    [Module.Projective A[H] V]
    (P : Subgroup H) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    let _ : IsScalarTower A A[P] V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P V
    Module.Projective A[P] V := by
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] A[H] := Module.compHom A[H] τ
  let _ : Module.Free A[P] A[H] :=
    subgroup_groupAlgebra_free_of_transversal (A := A) (G := H) P
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  let _ : IsScalarTower A[P] A[H] V := by
    -- The restricted scalar action is induced by the subgroup-algebra inclusion `τ`.
    refine ⟨?_⟩
    intro r s x
    simpa [τ, Module.compHom] using (mul_smul (τ r) s x)
  -- Since `A[H]` is free over `A[P]`, projectivity descends along restriction of scalars.
  exact projective_restrictScalars_of_free_hom
    (R := A[P]) (S := A[H]) (σ := τ) (M := V)
    (fun (r : A[P]) (s : A[H]) => rfl)

/-- Helper for Exercise 16-16.2-3: finite generation over the coefficient ring gives finite
generation after restricting to a subgroup algebra. -/
theorem pSubgroup_compHom_finite_of_base_finite
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    [Module.Finite A V]
    (P : Subgroup H) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    let _ : IsScalarTower A A[P] V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P V
    Module.Finite A[P] V := by
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  -- The `A`-finite generating set also generates after restriction from `A[P]` to `A`.
  exact Module.Finite.of_restrictScalars_finite A A[P] V

/-- Helper for Exercise 16-16.2-3: restricting a finite projective owner to a subgroup algebra
packages the projectivity and finiteness side conditions needed by the cyclic trace step. -/
theorem pSubgroup_compHom_projective_and_finite_of_ambient_projective
    {A : Type u} [CommRing A]
    {H : Type u} [Group H] [Finite H]
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (P : Subgroup H) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] Q.V := Module.compHom Q.V τ
    let _ : IsScalarTower A A[P] Q.V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P Q.V
    Module.Projective A[P] Q.V ∧ Module.Finite A[P] Q.V := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] Q.V := Module.compHom Q.V τ
  let _ : IsScalarTower A A[P] Q.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P Q.V
  constructor
  · -- Projectivity restricts along the subgroup-algebra inclusion because the ambient algebra is
    -- free over the subgroup algebra.
    simpa [τ] using
      pSubgroup_compHom_projective_of_ambient_projective
        (A := A) (H := H) (V := Q.V) P
  · -- The same finite `A`-generators also generate after the subgroup-algebra restriction.
    simpa [τ] using
      pSubgroup_compHom_finite_of_base_finite
        (A := A) (H := H) (V := Q.V) P

/-- Helper for Exercise 16-16.2-3: in the cyclic reduction, the `p`-factor is cyclic and the
ambient projective owner restricts to a finite projective `A[P]`-module. -/
theorem cyclic_pElementary_pSubgroup_projective_and_finite
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H] [Finite H] [IsCyclic H]
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] Q.V := Module.compHom Q.V τ
    let _ : IsScalarTower A A[P] Q.V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P Q.V
    IsCyclic P ∧ Module.Projective A[P] Q.V ∧ Module.Finite A[P] Q.V := by
  dsimp only
  have _hPGroup : IsPGroup p P := hSP.isPGroup
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] Q.V := Module.compHom Q.V τ
  let _ : IsScalarTower A A[P] Q.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P Q.V
  have hcyclic : IsCyclic P :=
    Subgroup.isCyclic_of_le (show P ≤ (⊤ : Subgroup H) from le_top)
  have hrestricted :
      Module.Projective A[P] Q.V ∧ Module.Finite A[P] Q.V := by
    -- Restrict the owner along `A[P] → A[H]`; the ambient group algebra is free over the
    -- subgroup algebra, and finite `A`-generation also gives finite `A[P]`-generation.
    simpa [τ] using
      pSubgroup_compHom_projective_and_finite_of_ambient_projective
        (A := A) (H := H) Q P
  -- Package the cyclicity and module-theoretic side conditions for the final scalar-block input.
  exact ⟨hcyclic, hrestricted.1, hrestricted.2⟩

/-- Helper for Exercise 16-16.2-3: a finite projective module over a commutative local ring is
free. -/
theorem finite_projective_module_free_of_commutative_local_ring
    {R : Type u} [CommRing R] [IsLocalRing R]
    {M : Type*} [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Module.Projective R M] :
    Module.Free R M := by
  -- Projectivity supplies flatness, and the finite-flat local criterion gives a basis.
  let _ : Module.Flat R M := Module.Flat.of_projective
  exact Module.free_of_flat_of_isLocalRing

/-- Helper for Exercise 16-16.2-3: once the cyclic subgroup algebra is known to be local, the
subgroup-restricted finite projective owner is free over it. -/
theorem pSubgroup_compHom_free_of_ambient_projective_of_local_groupAlgebra
    {A : Type u} [CommRing A]
    {H : Type u} [Group H] [Finite H]
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (P : Subgroup H) [IsCyclic P] [IsLocalRing A[P]] :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] Q.V := Module.compHom Q.V τ
    let _ : IsScalarTower A A[P] Q.V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P Q.V
    Module.Free A[P] Q.V := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] Q.V := Module.compHom Q.V τ
  let _ : IsScalarTower A A[P] Q.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P Q.V
  have hrestricted :
      Module.Projective A[P] Q.V ∧ Module.Finite A[P] Q.V := by
    -- Reuse the existing subgroup-restriction package for the two module-theoretic hypotheses.
    simpa [τ] using
      pSubgroup_compHom_projective_and_finite_of_ambient_projective
        (A := A) (H := H) Q P
  letI : Module.Projective A[P] Q.V := hrestricted.1
  letI : Module.Finite A[P] Q.V := hrestricted.2
  letI : CommGroup P := IsCyclic.commGroup
  letI : CommRing A[P] := inferInstance
  -- With commutativity and localness installed, the general local-ring freeness lemma applies.
  exact finite_projective_module_free_of_commutative_local_ring
    (R := A[P]) (M := Q.V)

/-- Helper for Exercise 16-16.2-3: finite projective modules over a local commutative cyclic
group algebra are free. -/
theorem finiteProjective_free_over_localCyclicGroupAlgebra
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P] [IsCyclic P] [IsLocalRing A[P]]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Projective A[P] V] [Module.Finite A[P] V] :
    Module.Free A[P] V := by
  -- Cyclicity makes the group algebra commutative, and local finite projective modules are free.
  letI : CommGroup P := IsCyclic.commGroup
  letI : CommRing A[P] := inferInstance
  exact finite_projective_module_free_of_commutative_local_ring (R := A[P]) (M := V)

/-- Helper for Exercise 16-16.2-3: over a local cyclic group algebra, a finite projective module
has zero trace for a single nonidentity group-algebra coordinate with arbitrary coefficient. -/
theorem trace_single_groupAlgebraCoordinate_eq_zero_of_projective_local_cyclic
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P] [IsCyclic P] [IsLocalRing A[P]]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Projective A[P] V] [Module.Finite A[P] V]
    (ω : A) {h : P} (hh : h ≠ 1) :
    LinearMap.trace A V
      (((Representation.ofModule' (k := A) (G := P) V).asAlgebraHom)
        (MonoidAlgebra.single h ω)) = 0 := by
  -- Local cyclic group algebras make finite projective modules free, reducing the calculation
  -- to the explicit free group-algebra coordinate trace theorem above.
  letI : CommGroup P := IsCyclic.commGroup
  letI : CommRing A[P] := inferInstance
  have hfree : Module.Free A[P] V :=
    finiteProjective_free_over_localCyclicGroupAlgebra (A := A) (P := P) (V := V)
  letI : Module.Free A[P] V := hfree
  exact trace_single_groupAlgebraCoordinate_eq_zero_of_free
    (R := A) (H := P) (M := V) ω hh

/-- Helper for Exercise 16-16.2-3: a faithful scalar extension identifies one operator with a
tensor product of an auxiliary endomorphism and a regular right `p`-part action. -/
structure PElementaryTensorRegularTraceModel
    {A : Type u} [CommRing A]
    {V : Type u} [AddCommGroup V] [Module A V]
    {P : Type u} [Group P] [Finite P]
    (T : V →ₗ[A] V) (hp : P) where
  B : Type u
  [commRingB : CommRing B]
  [algebraAB : Algebra A B]
  hinj : Function.Injective (algebraMap A B)
  W : Type u
  [addCommGroupW : AddCommGroup W]
  [moduleBW : Module B W]
  [freeBW : Module.Free B W]
  [finiteBW : Module.Finite B W]
  [freeTensor : Module.Free B (TensorProduct A B V)]
  [finiteTensor : Module.Finite B (TensorProduct A B V)]
  uW : W →ₗ[B] W
  e : TensorProduct A B V ≃ₗ[B] TensorProduct B W (MonoidAlgebra B P)
  action_eq :
    T.baseChange B =
      e.symm.conj
        (TensorProduct.map uW
          ((Representation.ofModule' (k := B) (G := P) (MonoidAlgebra B P)) hp))

/-- Helper for Exercise 16-16.2-3: a tensor-regular trace model with nontrivial regular
right coordinate descends to zero trace before the faithful base change. -/
theorem trace_eq_zero_of_pElementaryTensorRegularTraceModel
    {A : Type u} [CommRing A]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module.Free A V] [Module.Finite A V]
    {P : Type u} [Group P] [Finite P]
    {T : V →ₗ[A] V} {hp : P}
    (D : PElementaryTensorRegularTraceModel (A := A) (V := V) (P := P) T hp)
    (hhp : hp ≠ 1) :
    LinearMap.trace A V T = 0 := by
  letI : CommRing D.B := D.commRingB
  letI : Algebra A D.B := D.algebraAB
  letI : AddCommGroup D.W := D.addCommGroupW
  letI : Module D.B D.W := D.moduleBW
  letI : Module.Free D.B D.W := D.freeBW
  letI : Module.Finite D.B D.W := D.finiteBW
  letI : Module.Free D.B (TensorProduct A D.B V) := D.freeTensor
  letI : Module.Finite D.B (TensorProduct A D.B V) := D.finiteTensor
  have htraceB :
      LinearMap.trace D.B (TensorProduct A D.B V) (T.baseChange D.B) = 0 := by
    -- Over the faithful extension, the model is exactly a tensor-regular action with a
    -- nonidentity regular factor, so the already-proved regular trace lemma applies.
    exact
      trace_eq_zero_of_tensorRegularModel_right_ne_one
        (R := D.B) (V := TensorProduct A D.B V) (F := D.W) (P := P)
        (T := T.baseChange D.B) (e := D.e) (u := D.uW) hhp D.action_eq
  -- Injectivity of the scalar extension carries the zero trace back to the original ring.
  exact trace_eq_zero_of_baseChange_trace_eq_zero (A := A) (B := D.B) (M := V)
    D.hinj T htraceB

/-- Helper for Exercise 16-16.2-3: for a finite projective group-algebra owner over a local
coefficient ring, a tensor-regular model gives zero trace on the owner carrier. -/
theorem trace_eq_zero_of_owner_pElementaryTensorRegularTraceModel
    {A : Type u} [CommRing A] [IsLocalRing A]
    {G : Type u} [Group G] [Finite G]
    (Q : FiniteProjectiveGroupAlgebraModule A G)
    {P : Type u} [Group P] [Finite P]
    {T : Q.V →ₗ[A] Q.V} {hp : P}
    (D : PElementaryTensorRegularTraceModel (A := A) (V := Q.V) (P := P) T hp)
    (hhp : hp ≠ 1) :
    LinearMap.trace A Q.V T = 0 := by
  -- The local coefficient ring makes the owner carrier free, so the generic tensor-model
  -- trace lemma applies after installing the owner finiteness instance.
  letI : Module.Finite A Q.V := Q.finite
  letI : Module.Free A Q.V :=
    FiniteProjectiveGroupAlgebraModule.free (A := A) (G := G) Q
  exact trace_eq_zero_of_pElementaryTensorRegularTraceModel D hhp

/-- Helper for Exercise 16-16.2-3: in a `p`-elementary product decomposition, a product with
nontrivial right `p`-coordinate is not `p`-regular. -/
theorem pElementary_product_not_isPRegular_of_rightCoord_ne_one
    {p : ℕ} {H : Type u} [Group H] {S P : Subgroup H}
    (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) (hhp : hp ≠ 1) :
    ¬ IsPRegular p ((s : H) * (hp : H)) := by
  intro hregular
  let e := hSP.isComplement.prodMulEquiv hSP.commute
  have hright :
      ((e.symm ((s : H) * (hp : H))).2 : H) = 1 := by
    -- A `p`-regular product has trivial right coordinate in the `S × P` decomposition.
    simpa [e] using
      hSP.right_coord_eq_one_of_isPRegular
        (x := (s : H) * (hp : H)) hregular
  have hcoords :
      e.symm ((s : H) * (hp : H)) = (s, hp) := by
    -- The product equivalence reconstructs exactly the chosen coordinates.
    apply e.injective
    rw [e.apply_symm_apply]
    simp [e, Subgroup.IsComplement'.prodMulEquiv, MonoidHom.noncommCoprod_apply]
  have hp_one : hp = 1 := by
    -- Read the second coordinate and coerce back to the subgroup.
    apply Subtype.ext
    simpa [hcoords] using hright
  exact hhp hp_one

/-- Helper for Exercise 16-16.2-3: a source-level p-singular trace theorem immediately gives the
owner-level p-elementary product trace vanishing. -/
theorem pElementaryOwner_trace_eq_zero_of_rightCoord_ne_one_of_pSingular_trace
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (htrace :
      ∀ g : H, ¬ IsPRegular p g →
        LinearMap.trace A V
          ((Representation.ofModule' (k := A) (G := H) V) g) = 0)
    (s : S) (hp : P) (hhp : hp ≠ 1) :
    LinearMap.trace A V
      (((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) V) (hp : H))) = 0 := by
  let ρ : Representation A H V := Representation.ofModule' (k := A) (G := H) V
  have hsingular : ¬ IsPRegular p ((s : H) * (hp : H)) := by
    -- The nontrivial right coordinate makes the reconstructed product p-singular.
    exact pElementary_product_not_isPRegular_of_rightCoord_ne_one hSP s hp hhp
  have hproduct :
      LinearMap.trace A V (ρ ((s : H) * (hp : H))) = 0 := by
    -- Apply the source-level p-singular trace theorem to the product element.
    exact htrace ((s : H) * (hp : H)) hsingular
  have hfactor :
      ρ ((s : H) * (hp : H)) =
        ((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
          ((Representation.ofModule' (k := A) (G := H) V) (hp : H)) := by
    -- Multiplicativity of the group action identifies the product action with the composed one.
    rw [map_mul]
    rfl
  -- Rewrite the desired trace through the product action and consume the source theorem.
  rw [← hfactor]
  exact hproduct

/-- Helper for Exercise 16-16.2-3: p-singular trace vanishing in a p-elementary group reduces to
the coordinate-product trace case where the `p`-group coordinate is nontrivial. -/
theorem pElementary_trace_eq_zero_on_pSingular_of_rightCoord_trace
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (hcoord :
      ∀ (s : S) (hp : P), hp ≠ 1 →
        LinearMap.trace A V
          (((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
            ((Representation.ofModule' (k := A) (G := H) V) (hp : H))) = 0)
    (g : H) (hg : ¬ IsPRegular p g) :
    LinearMap.trace A V
      ((Representation.ofModule' (k := A) (G := H) V) g) = 0 := by
  let ρ : Representation A H V := Representation.ofModule' (k := A) (G := H) V
  let e := hSP.isComplement.prodMulEquiv hSP.commute
  let s : S := (e.symm g).1
  let hp : P := (e.symm g).2
  have hright : hp ≠ 1 := by
    intro hp_one
    have h_eq_left : g = (s : H) := by
      -- If the right coordinate is `1`, reconstruction from the product decomposition leaves
      -- only the cyclic coordinate.
      calc
        g = ((e.symm g).1 : H) * ((e.symm g).2 : H) := by
          simpa [e] using (hSP.symm_apply_eq_mul_coords g).symm
        _ = (s : H) * (hp : H) := rfl
        _ = (s : H) * 1 := by
          rw [show (hp : H) = 1 by simpa using congrArg Subtype.val hp_one]
        _ = (s : H) := by simp
    apply hg
    -- The cyclic coordinate is exactly the p-regular locus in a p-elementary decomposition.
    rw [h_eq_left]
    change (s : H) ∈ ({x : H | IsPRegular p x} : Set H)
    rw [← hSP.cyclic_factor_eq_setOf_isPRegular]
    exact s.2
  have hfactor :
      ρ g = (ρ (s : H)).comp (ρ (hp : H)) := by
    have hmul : g = (s : H) * (hp : H) := by
      -- Reconstruct the original group element from its two product coordinates.
      calc
        g = ((e.symm g).1 : H) * ((e.symm g).2 : H) := by
          simpa [e] using (hSP.symm_apply_eq_mul_coords g).symm
        _ = (s : H) * (hp : H) := rfl
    -- Multiplicativity of `Representation.ofModule'` turns the product into composition.
    calc
      ρ g = ρ ((s : H) * (hp : H)) := congrArg ρ hmul
      _ = (ρ (s : H)).comp (ρ (hp : H)) := by
          rw [map_mul]
          rfl
  -- With the product action normalized, consume the promised coordinate trace theorem.
  rw [hfactor]
  exact hcoord s hp hright

/-- Helper for Exercise 16-16.2-3: data identifying a faithful base change of an endomorphism
with scalar blocks of a nontrivial group-algebra action. -/
structure PPartBlockTraceData
    {A : Type u} [CommRing A]
    {V : Type u} [AddCommGroup V] [Module A V]
    {H : Type u} [Group H] [Finite H]
    (T : V →ₗ[A] V) (h : H) where
  B : Type u
  [commRingB : CommRing B]
  [algebraAB : Algebra A B]
  hinj : Function.Injective (algebraMap A B)
  ι : Type u
  [finiteι : Finite ι]
  M : ι → Type u
  [addCommGroupM : ∀ i, AddCommGroup (M i)]
  [moduleBM : ∀ i, Module B (M i)]
  [moduleBHM : ∀ i, Module (MonoidAlgebra B H) (M i)]
  [towerM : ∀ i, IsScalarTower B (MonoidAlgebra B H) (M i)]
  [freeBHM : ∀ i, Module.Free (MonoidAlgebra B H) (M i)]
  [finiteBHM : ∀ i, Module.Finite (MonoidAlgebra B H) (M i)]
  [freeBM : ∀ i, Module.Free B (M i)]
  [finiteBM : ∀ i, Module.Finite B (M i)]
  e : TensorProduct A B V ≃ₗ[B] ∀ i, M i
  ω : ι → B
  action_eq :
    T.baseChange B =
      e.symm.conj
        (LinearMap.piMap fun i ↦
          ω i • ((Representation.ofModule' (k := B) (G := H) (M i)) h))

/-- Helper for Exercise 16-16.2-3: source-facing scalar-block decomposition data for a
prime-to-`p` finite-order operator that is linear over a cyclic `p`-group algebra. -/
structure PrimeToPScalarBlockDecomposition
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    (u : V →ₗ[A[P]] V) where
  B : Type u
  [commRingB : CommRing B]
  [algebraAB : Algebra A B]
  hinj : Function.Injective (algebraMap A B)
  ι : Type u
  [finiteι : Finite ι]
  M : ι → Type u
  [addCommGroupM : ∀ i, AddCommGroup (M i)]
  [moduleBM : ∀ i, Module B (M i)]
  [moduleBPM : ∀ i, Module (MonoidAlgebra B P) (M i)]
  [towerM : ∀ i, IsScalarTower B (MonoidAlgebra B P) (M i)]
  [freeBPM : ∀ i, Module.Free (MonoidAlgebra B P) (M i)]
  [finiteBPM : ∀ i, Module.Finite (MonoidAlgebra B P) (M i)]
  [freeBM : ∀ i, Module.Free B (M i)]
  [finiteBM : ∀ i, Module.Finite B (M i)]
  e : TensorProduct A B V ≃ₗ[B] ∀ i, M i
  ω : ι → B
  action_eq :
    ∀ h : P,
      (((u.restrictScalars A).comp
          ((Representation.ofModule' (k := A) (G := P) V) h)).baseChange B) =
        e.symm.conj
          (LinearMap.piMap fun i ↦
            ω i • ((Representation.ofModule' (k := B) (G := P) (M i)) h))

/-- Helper for Exercise 16-16.2-3: a prime-to-`p` scalar-block decomposition rewrites the
base-changed composite of the torsion operator with any `P`-action into the corresponding
block-diagonal scalar action. -/
theorem primeToPScalarBlockDecomposition_comp_pAction
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    {u : V →ₗ[A[P]] V}
    (D : PrimeToPScalarBlockDecomposition (A := A) (P := P) (V := V) u)
    (hp : P) :
    letI : CommRing D.B := D.commRingB
    letI : Algebra A D.B := D.algebraAB
    letI : Finite D.ι := D.finiteι
    letI : ∀ i, AddCommGroup (D.M i) := D.addCommGroupM
    letI : ∀ i, Module D.B (D.M i) := D.moduleBM
    letI : ∀ i, Module (MonoidAlgebra D.B P) (D.M i) := D.moduleBPM
    letI : ∀ i, IsScalarTower D.B (MonoidAlgebra D.B P) (D.M i) := D.towerM
    letI : ∀ i, Module.Free (MonoidAlgebra D.B P) (D.M i) := D.freeBPM
    letI : ∀ i, Module.Finite (MonoidAlgebra D.B P) (D.M i) := D.finiteBPM
    letI : ∀ i, Module.Free D.B (D.M i) := D.freeBM
    letI : ∀ i, Module.Finite D.B (D.M i) := D.finiteBM
    (((u.restrictScalars A).comp
        ((Representation.ofModule' (k := A) (G := P) V) hp)).baseChange D.B) =
      D.e.symm.conj
        (LinearMap.piMap fun i ↦
          D.ω i • ((Representation.ofModule' (k := D.B) (G := P) (D.M i)) hp)) := by
  -- The decomposition structure stores exactly this composite-action normal form; this lemma
  -- gives later packaging proofs a stable rewrite name.
  exact D.action_eq hp

/-- Helper for Exercise 16-16.2-3: the identity scalar extension of a module is viewed as a
single product block. -/
abbrev oneBlockTensorEquiv
    (A : Type u) [CommRing A]
    (V : Type u) [AddCommGroup V] [Module A V] :
    TensorProduct A A V ≃ₗ[A] (PUnit → V) :=
  (_root_.TensorProduct.lid A V).trans (LinearEquiv.funUnique PUnit A V).symm

/-- Helper for Exercise 16-16.2-3: the self algebra map used in a one-block scalar extension is
injective. -/
theorem oneBlockAlgebraMapSelfInjective
    {A : Type u} [CommRing A] :
    Function.Injective (algebraMap A A) := by
  -- The algebra map from a commutative ring to itself is the identity map.
  intro x y hxy
  simpa using hxy

/-- Helper for Exercise 16-16.2-3: if the prime-to-`p` operator is already scalar after
forgetting to `A`, then its composite with every `P`-action has the one-block scalar normal form. -/
theorem oneBlockPrimeToPScalarBlockAction_eq
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    (u : V →ₗ[A[P]] V) (ω : A)
    (hu : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    (h : P) :
    (((u.restrictScalars A).comp
        ((Representation.ofModule' (k := A) (G := P) V) h)).baseChange A) =
      (oneBlockTensorEquiv A V).symm.conj
        (LinearMap.piMap fun _ : PUnit ↦
          ω • ((Representation.ofModule' (k := A) (G := P) V) h)) := by
  -- Rewrite the operator to a scalar multiple of the identity and compare the identity
  -- base-change with the single-coordinate product block.
  rw [hu]
  ext t
  simp [oneBlockTensorEquiv, LinearEquiv.conj_apply_apply]

/-- Helper for Exercise 16-16.2-3: a scalar operator on a finite free `A[P]`-module gives a
one-block prime-to-`p` scalar-block decomposition. -/
theorem nonempty_primeToPScalarBlockDecomposition_of_restrictScalars_scalar
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A[P] V] [Module.Finite A[P] V]
    [Module.Free A V] [Module.Finite A V]
    (u : V →ₗ[A[P]] V) (ω : A)
    (hu : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V)) :
    Nonempty (PrimeToPScalarBlockDecomposition (A := A) (P := P) (V := V) u) := by
  -- Package the identity scalar extension as a single block; the action equation is the
  -- preceding normal-form lemma, so this constructor carries no hidden proof search.
  exact ⟨{
    B := A
    hinj := oneBlockAlgebraMapSelfInjective (A := A)
    ι := PUnit
    M := fun _ ↦ V
    e := oneBlockTensorEquiv A V
    ω := fun _ ↦ ω
    action_eq :=
      oneBlockPrimeToPScalarBlockAction_eq
        (A := A) (P := P) (V := V) u ω hu
  }⟩

/-- Helper for Exercise 16-16.2-3: over a local cyclic group algebra, a projective module whose
prime-to-`p` operator is already scalar after forgetting to `A` has a one-block scalar
decomposition. -/
theorem nonempty_primeToPScalarBlockDecomposition_of_projective_local_restrictScalars_scalar
    {A : Type u} [CommRing A] [IsLocalRing A]
    {P : Type u} [Group P] [Finite P] [IsCyclic P] [IsLocalRing A[P]]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Projective A[P] V] [Module.Finite A[P] V]
    (u : V →ₗ[A[P]] V) (ω : A)
    (hu : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V)) :
    Nonempty (PrimeToPScalarBlockDecomposition (A := A) (P := P) (V := V) u) := by
  -- The cyclic group algebra is commutative and local, so finite projective modules over it are
  -- free; this reduces the source-facing scalar-block data to the explicit one-block package.
  have hfreeAP : Module.Free A[P] V := by
    exact finiteProjective_free_over_localCyclicGroupAlgebra (A := A) (P := P) (V := V)
  letI : Module.Free A[P] V := hfreeAP
  -- Finite generation over the finite group algebra gives finite generation over the base ring.
  have hfiniteAP_over_A : Module.Finite A A[P] := by
    exact Module.Finite.of_basis (MonoidAlgebra.basis P A)
  have hfiniteA : Module.Finite A V := by
    letI : Module.Finite A A[P] := hfiniteAP_over_A
    exact Module.Finite.trans A[P] V
  letI : Module.Finite A V := hfiniteA
  -- Projectivity also descends along the free extension `A → A[P]`.
  have hprojectiveA : Module.Projective A V := by
    letI : Module.Free A A[P] := Module.Free.of_basis (MonoidAlgebra.basis P A)
    have hsmul :
        ∀ (r : A) (s : A[P]), (r • s : A[P]) = algebraMap A A[P] r * s := by
      intro r s
      simpa using
        (Algebra.smul_def r s :
          (r • s : A[P]) = algebraMap A A[P] r * s)
    exact projective_restrictScalars_of_free_hom
      (R := A) (S := A[P]) (σ := algebraMap A A[P]) (M := V) hsmul
  letI : Module.Projective A V := hprojectiveA
  have hfreeA : Module.Free A V := by
    exact finite_projective_module_free_of_commutative_local_ring (R := A) (M := V)
  letI : Module.Free A V := hfreeA
  -- With both freeness instances available, the previously proved one-block scalar constructor
  -- supplies the desired source-facing decomposition.
  exact nonempty_primeToPScalarBlockDecomposition_of_restrictScalars_scalar
    (A := A) (P := P) (V := V) u ω hu

/-- Helper for Exercise 16-16.2-3: raw faithful scalar-block data repackages as
`PPartBlockTraceData`. -/
theorem nonempty_pPartBlockTraceData_of_baseChange_scalarBlocks
    {A : Type u} [CommRing A]
    {V : Type u} [AddCommGroup V] [Module A V]
    {H : Type u} [Group H] [Finite H]
    {T : V →ₗ[A] V} {h : H}
    {B : Type u} [CommRing B] [Algebra A B]
    (hinj : Function.Injective (algebraMap A B))
    {ι : Type u} [Finite ι]
    {M : ι → Type u}
    [∀ i, AddCommGroup (M i)]
    [∀ i, Module B (M i)]
    [∀ i, Module (MonoidAlgebra B H) (M i)]
    [∀ i, IsScalarTower B (MonoidAlgebra B H) (M i)]
    [∀ i, Module.Free (MonoidAlgebra B H) (M i)]
    [∀ i, Module.Finite (MonoidAlgebra B H) (M i)]
    [∀ i, Module.Free B (M i)]
    [∀ i, Module.Finite B (M i)]
    (e : TensorProduct A B V ≃ₗ[B] ∀ i, M i)
    (ω : ι → B)
    (haction :
      T.baseChange B =
        e.symm.conj
          (LinearMap.piMap fun i ↦
            ω i • ((Representation.ofModule' (k := B) (G := H) (M i)) h))) :
    Nonempty (PPartBlockTraceData (A := A) (V := V) (H := H) T h) := by
  -- Package exactly the scalar-block decomposition data expected by the trace-descent API.
  exact ⟨{
    B := B
    hinj := hinj
    ι := ι
    M := M
    e := e
    ω := ω
    action_eq := haction
  }⟩

/-- Helper for Exercise 16-16.2-3: a prime-to-`p` scalar-block decomposition supplies the
block trace data for any `P`-coordinate action. -/
theorem nonempty_pPartBlockTraceData_of_primeToPScalarBlockDecomposition
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    (u : V →ₗ[A[P]] V)
    (D : PrimeToPScalarBlockDecomposition (A := A) (P := P) (V := V) u)
    (hp : P) :
    Nonempty
      (PPartBlockTraceData (A := A) (V := V) (H := P)
        ((u.restrictScalars A).comp ((Representation.ofModule' (k := A) (G := P) V) hp))
        hp) := by
  -- Install the decomposition fields as local instances and package the selected coordinate
  -- equation in the existing faithful scalar-block constructor.
  letI : CommRing D.B := D.commRingB
  letI : Algebra A D.B := D.algebraAB
  letI : Finite D.ι := D.finiteι
  letI : ∀ i, AddCommGroup (D.M i) := D.addCommGroupM
  letI : ∀ i, Module D.B (D.M i) := D.moduleBM
  letI : ∀ i, Module (MonoidAlgebra D.B P) (D.M i) := D.moduleBPM
  letI : ∀ i, IsScalarTower D.B (MonoidAlgebra D.B P) (D.M i) := D.towerM
  letI : ∀ i, Module.Free (MonoidAlgebra D.B P) (D.M i) := D.freeBPM
  letI : ∀ i, Module.Finite (MonoidAlgebra D.B P) (D.M i) := D.finiteBPM
  letI : ∀ i, Module.Free D.B (D.M i) := D.freeBM
  letI : ∀ i, Module.Finite D.B (D.M i) := D.finiteBM
  exact
    nonempty_pPartBlockTraceData_of_baseChange_scalarBlocks
      (A := A) (V := V) (H := P)
      (T := (u.restrictScalars A).comp ((Representation.ofModule' (k := A) (G := P) V) hp))
      (h := hp) (B := D.B) D.hinj (ι := D.ι) (M := D.M) D.e D.ω
      (primeToPScalarBlockDecomposition_comp_pAction
        (A := A) (P := P) (V := V) D hp)

/-- Helper for Exercise 16-16.2-3: a single free `A[P]`-block already supplies
`PPartBlockTraceData` for a scalar multiple of the `P`-action. -/
theorem nonempty_pPartBlockTraceData_of_free_scalar_action
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A[P] V] [Module.Finite A[P] V]
    [Module.Free A V] [Module.Finite A V]
    (ω : A) (hp : P) :
    Nonempty
      (PPartBlockTraceData (A := A) (V := V) (H := P)
        (ω • ((Representation.ofModule' (k := A) (G := P) V) hp)) hp) := by
  let e : TensorProduct A A V ≃ₗ[A] (PUnit → V) :=
    (_root_.TensorProduct.lid A V).trans (LinearEquiv.funUnique PUnit A V).symm
  -- Use the identity scalar extension and the one-coordinate product decomposition.
  refine
    nonempty_pPartBlockTraceData_of_baseChange_scalarBlocks
      (A := A) (V := V) (H := P)
      (T := ω • ((Representation.ofModule' (k := A) (G := P) V) hp))
      (h := hp) (B := A)
      (hinj := ?_) (ι := PUnit) (M := fun _ ↦ V)
      e (fun _ ↦ ω) ?_
  · -- The identity algebra map is faithful, so no descent information is lost.
    simpa using (Function.injective_id : Function.Injective (id : A → A))
  · -- Under `A ⊗[A] V ≃ V ≃ (PUnit → V)`, the block action is exactly the
    -- base change of the original scalar multiple of the `P`-action.
    ext t
    simp [e, LinearEquiv.conj_apply_apply]

/-- Helper for Exercise 16-16.2-3: if an `A[P]`-linear operator is already scalar after
forgetting to `A`, then composing it with a `P`-action gives the one-block trace data. -/
theorem nonempty_pPartBlockTraceData_of_restrictScalars_scalar
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A[P] V] [Module.Finite A[P] V]
    [Module.Free A V] [Module.Finite A V]
    (u : V →ₗ[A[P]] V) (ω : A)
    (hu : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    (hp : P) :
    Nonempty
      (PPartBlockTraceData (A := A) (V := V) (H := P)
        ((u.restrictScalars A).comp ((Representation.ofModule' (k := A) (G := P) V) hp))
        hp) := by
  have hcomp :
      (u.restrictScalars A).comp
          ((Representation.ofModule' (k := A) (G := P) V) hp) =
        ω • ((Representation.ofModule' (k := A) (G := P) V) hp) := by
    -- The scalar hypothesis moves the composite to the exact one-block normal form.
    rw [hu]
    ext v
    simp
  -- The previously proved one-block constructor supplies the required faithful base-change data.
  rw [hcomp]
  exact nonempty_pPartBlockTraceData_of_free_scalar_action
    (A := A) (P := P) (V := V) ω hp

/-- Helper for Exercise 16-16.2-3: a faithful base change to nontrivial `p`-part blocks descends
to zero trace before base change. -/
theorem trace_eq_zero_of_baseChange_pPartBlockTraceData
    {A : Type u} [CommRing A]
    {V : Type u} [AddCommGroup V] [Module A V] [Module.Free A V] [Module.Finite A V]
    {H : Type u} [Group H] [Finite H]
    {T : V →ₗ[A] V} {h : H} (hh : h ≠ 1)
    (D : PPartBlockTraceData (A := A) (V := V) (H := H) T h) :
    LinearMap.trace A V T = 0 := by
  letI : CommRing D.B := D.commRingB
  letI : Algebra A D.B := D.algebraAB
  letI : Finite D.ι := D.finiteι
  letI : ∀ i, AddCommGroup (D.M i) := D.addCommGroupM
  letI : ∀ i, Module D.B (D.M i) := D.moduleBM
  letI : ∀ i, Module (MonoidAlgebra D.B H) (D.M i) := D.moduleBHM
  letI : ∀ i, IsScalarTower D.B (MonoidAlgebra D.B H) (D.M i) := D.towerM
  letI : ∀ i, Module.Free (MonoidAlgebra D.B H) (D.M i) := D.freeBHM
  letI : ∀ i, Module.Finite (MonoidAlgebra D.B H) (D.M i) := D.finiteBHM
  letI : ∀ i, Module.Free D.B (D.M i) := D.freeBM
  letI : ∀ i, Module.Finite D.B (D.M i) := D.finiteBM
  letI : Fintype D.ι := Fintype.ofFinite D.ι
  have htraceB :
      LinearMap.trace D.B (TensorProduct A D.B V) (T.baseChange D.B) = 0 := by
    -- Consume the supplied block normal form over the faithful scalar extension.
    exact
      trace_eq_zero_of_pPartBlockDecomposition
        (R := D.B) (V := TensorProduct A D.B V) (H := H)
        (T := T.baseChange D.B) (e := D.e) (ω := D.ω) hh D.action_eq
  -- Faithfulness of the scalar extension pushes the zero trace back to the original ring.
  exact trace_eq_zero_of_baseChange_trace_eq_zero (A := A) (B := D.B) (M := V)
    D.hinj T htraceB

/-- Helper for Exercise 16-16.2-3: nonempty `PPartBlockTraceData` is enough to kill the trace
of the corresponding nontrivial `p`-part action. -/
theorem trace_eq_zero_of_nonempty_pPartBlockTraceData
    {A : Type u} [CommRing A]
    {V : Type u} [AddCommGroup V] [Module A V] [Module.Free A V] [Module.Finite A V]
    {H : Type u} [Group H] [Finite H]
    {T : V →ₗ[A] V} {h : H} (hh : h ≠ 1)
    (hD : Nonempty (PPartBlockTraceData (A := A) (V := V) (H := H) T h)) :
    LinearMap.trace A V T = 0 := by
  -- Unpack the block data once, then use the faithful base-change trace descent theorem.
  rcases hD with ⟨D⟩
  exact trace_eq_zero_of_baseChange_pPartBlockTraceData
    (A := A) (V := V) (H := H) hh D

/-- Helper for Exercise 16-16.2-3: the identity scalar extension preserves trace vanishing. -/
theorem trace_self_baseChange_eq_zero_of_trace_eq_zero
    {A : Type u} [CommRing A]
    {M : Type u} [AddCommGroup M] [Module A M]
    [Module.Free A M] [Module.Finite A M]
    (f : M →ₗ[A] M) (hf : LinearMap.trace A M f = 0) :
    LinearMap.trace A (TensorProduct A A M) (f.baseChange A) = 0 := by
  -- Rewrite the identity base-change trace as the image of the original trace, then use `hf`.
  rw [LinearMap.trace_baseChange f A, hf, map_zero]

/-- Helper for Exercise 16-16.2-3: the group-algebra action recovered from
`Representation.ofModule'` is the original scalar action. -/
theorem ofModule'_asAlgebraHom_apply_commRing
    {R : Type u} [CommRing R] {H : Type u} [Group H]
    {M : Type u} [AddCommGroup M] [Module R M] [Module (MonoidAlgebra R H) M]
    [IsScalarTower R (MonoidAlgebra R H) M]
    (r : MonoidAlgebra R H) (m : M) :
    (((Representation.ofModule' (k := R) (G := H) M).asAlgebraHom r) m) = r • m := by
  -- Check the identity on group-algebra monomials and extend by linearity.
  refine MonoidAlgebra.induction_on
    (p := fun s : MonoidAlgebra R H =>
      (((Representation.ofModule' (k := R) (G := H) M).asAlgebraHom s) m) = s • m) r
      ?_ ?_ ?_
  · intro h
    simp [Representation.ofModule', MonoidAlgebra.of]
  · intro a b ha hb
    simp [ha, hb, add_smul]
  · intro a b hb
    simp [hb]

/-- Helper for Exercise 16-16.2-3: a finite cyclic group has the standard `p`-elementary
decomposition into its prime-to-`p` component and its `p`-component. -/
theorem exists_isPElementaryDecomposition_of_isCyclic
    {p : ℕ} [Fact p.Prime]
    {H : Type u} [Group H] [Finite H] [IsCyclic H] :
    ∃ S P : Subgroup H, IsPElementaryDecomposition p S P := by
  classical
  obtain ⟨c, hcgen⟩ := IsCyclic.exists_generator (α := H)
  let S : Subgroup H := Subgroup.zpowers (pRegularComponent p c)
  let P : Subgroup H := Subgroup.zpowers (pUnipotentComponent p c)
  have htop_eq_zpowers : (⊤ : Subgroup H) = Subgroup.zpowers c := by
    -- The chosen cyclic generator generates the whole ambient group.
    ext x
    constructor
    · intro _
      exact hcgen x
    · intro _
      exact Subgroup.mem_top x
  let hdecomp :=
    p_component_decomposition_exists (p := p) c (isOfFinOrder_of_finite c)
  have hS_cyclic : IsCyclic S := by
    -- The prime-to-`p` factor is cyclic because it is generated by one component.
    simpa [S] using Subgroup.isCyclic_zpowers (pRegularComponent p c)
  have hS_coprime : Nat.Coprime p (Nat.card S) := by
    -- Its order divides the prime-to-`p` part of the generator.
    simpa [S, Nat.card_zpowers, -Nat.card_eq_fintype_card] using hdecomp.isPRegular
  have hP_isPGroup : IsPGroup p P := by
    -- Every element of the cyclic subgroup generated by the `p`-component has `p`-power order.
    rw [isPGroup_iff_forall_isPElement]
    intro y
    have hy_div :
        orderOf ((y : P) : H) ∣ orderOf (pUnipotentComponent p c) :=
      orderOf_dvd_of_mem_zpowers y.2
    rcases hdecomp.isPElement with ⟨n, hn⟩
    have hy_pow : orderOf ((y : P) : H) ∣ p ^ n := by
      simpa [hn] using hy_div
    rcases (Nat.dvd_prime_pow Fact.out).1 hy_pow with ⟨m, -, hm⟩
    exact ⟨m, by simpa [Subgroup.orderOf_mk] using hm⟩
  have hS_cent : S ≤ Subgroup.centralizer (P : Set H) := by
    -- The two factors are generated by commuting powers of the same element.
    intro s hs
    rw [Subgroup.mem_centralizer_iff]
    intro u hu
    rcases (Subgroup.mem_zpowers_iff.mp hs) with ⟨m, rfl⟩
    rcases (Subgroup.mem_zpowers_iff.mp hu) with ⟨n, rfl⟩
    simpa using ((hdecomp.commute.zpow_left n).zpow_right m).eq
  have hSP_disjoint : Disjoint S P := by
    -- An element in both factors has order both prime to `p` and a power of `p`, hence is `1`.
    rw [disjoint_iff]
    ext z
    constructor
    · intro hz
      rw [Subgroup.mem_bot]
      rw [Subgroup.mem_inf] at hz
      have hzS : z ∈ S := hz.1
      have hzP : z ∈ P := hz.2
      have hzDivS : orderOf z ∣ orderOf (pRegularComponent p c) :=
        orderOf_dvd_of_mem_zpowers hzS
      have hzDivP : orderOf z ∣ orderOf (pUnipotentComponent p c) :=
        orderOf_dvd_of_mem_zpowers hzP
      rcases hdecomp.isPElement with ⟨n, hn⟩
      have hzPow : orderOf z ∣ p ^ n := by
        simpa [hn] using hzDivP
      rcases (Nat.dvd_prime_pow Fact.out).1 hzPow with ⟨m, -, hm⟩
      have hzOne : orderOf z = 1 := by
        exact hm.trans (Nat.Coprime.eq_one_of_dvd (hdecomp.isPRegular.pow_left m) (hm ▸ hzDivS))
      exact orderOf_eq_one_iff.mp hzOne
    · intro hz
      rw [Subgroup.mem_inf]
      have hz1 : z = 1 := Subgroup.mem_bot.mp hz
      constructor <;> simp [hz1]
  have hsup_eq_top : S ⊔ P = ⊤ := by
    -- The original generator is the product of its two components, so the two factors generate.
    have hc_sup : c ∈ S ⊔ P := by
      rw [show c = pRegularComponent p c * pUnipotentComponent p c by
        calc
          c = pUnipotentComponent p c * pRegularComponent p c := hdecomp.eq_mul
          _ = pRegularComponent p c * pUnipotentComponent p c := by
                simpa using hdecomp.commute.eq]
      exact Subgroup.mul_mem (S ⊔ P)
        ((show S ≤ S ⊔ P from le_sup_left) (Subgroup.mem_zpowers (pRegularComponent p c)))
        ((show P ≤ S ⊔ P from le_sup_right) (Subgroup.mem_zpowers (pUnipotentComponent p c)))
    have htop_le_sup : (⊤ : Subgroup H) ≤ S ⊔ P := by
      rw [htop_eq_zpowers]
      exact (Subgroup.zpowers_le).2 hc_sup
    exact le_antisymm le_top htop_le_sup
  have hS_norm : S ≤ Subgroup.normalizer P := by
    -- Centralizing the `P` factor gives the normalizer condition needed to identify product sets.
    intro s hs
    exact Subgroup.centralizer_le_normalizer (P : Set H) (hS_cent hs)
  have hmul_univ : ((↑S : Set H) * (↑P : Set H)) = (Set.univ : Set H) := by
    calc
      ((↑S : Set H) * (↑P : Set H)) = ↑(S ⊔ P) := by
        symm
        exact Subgroup.coe_mul_of_left_le_normalizer_right S P hS_norm
      _ = Set.univ := by
        simp [hsup_eq_top]
  have hSP_complement : S.IsComplement' P :=
    Subgroup.isComplement'_of_disjoint_and_mul_eq_univ hSP_disjoint hmul_univ
  exact ⟨S, P, Fact.out, inferInstance, hS_cyclic, hS_coprime, hP_isPGroup, hS_cent,
    hSP_complement⟩

/-- Helper for Exercise 16-16.2-3: in a `p`-elementary product decomposition, a `p`-singular
element has nontrivial coordinate in the `p`-group factor. -/
theorem pElementary_rightCoord_ne_one_of_not_isPRegular
    {p : ℕ} {H : Type u} [Group H] {S P : Subgroup H}
    (hSP : IsPElementaryDecomposition p S P) {h : H} (hh : ¬ IsPRegular p h) :
    (((hSP.isComplement.prodMulEquiv hSP.commute).symm h).2 : H) ≠ 1 := by
  let e := hSP.isComplement.prodMulEquiv hSP.commute
  intro hright
  have h_eq_left : h = ((e.symm h).1 : H) := by
    -- If the right coordinate is `1`, the product reconstruction leaves only the left coordinate.
    calc
      h = ((e.symm h).1 : H) * ((e.symm h).2 : H) := by
        simpa [e] using (hSP.symm_apply_eq_mul_coords h).symm
      _ = ((e.symm h).1 : H) * 1 := by rw [hright]
      _ = ((e.symm h).1 : H) := by simp
  have hmemS : h ∈ S := by
    -- The left coordinate lies in `S`, so the element itself lies in the prime-to-`p` factor.
    rw [h_eq_left]
    exact ((e.symm h).1).2
  have hregular : IsPRegular p h := by
    -- The cyclic factor of a `p`-elementary decomposition is exactly the `p`-regular locus.
    change h ∈ ({x : H | IsPRegular p x} : Set H)
    rw [← hSP.cyclic_factor_eq_setOf_isPRegular]
    exact hmemS
  exact hh hregular

/-- Helper for Exercise 16-16.2-3: a `p`-singular element in a cyclic group admits a
`p`-elementary product decomposition in which its `p`-group coordinate is nontrivial. -/
theorem exists_pElementaryDecomposition_rightCoord_ne_one_of_not_isPRegular
    {p : ℕ} [Fact p.Prime]
    {H : Type u} [Group H] [Finite H] [IsCyclic H]
    {h : H} (hh : ¬ IsPRegular p h) :
    ∃ (S P : Subgroup H) (hSP : IsPElementaryDecomposition p S P),
      (((hSP.isComplement.prodMulEquiv hSP.commute).symm h).2 : H) ≠ 1 := by
  -- Combine the cyclic decomposition with the regular-locus characterization of its left factor.
  rcases exists_isPElementaryDecomposition_of_isCyclic (p := p) (H := H) with
    ⟨S, P, hSP⟩
  exact
    ⟨S, P, hSP,
      pElementary_rightCoord_ne_one_of_not_isPRegular
        (p := p) (H := H) hSP hh⟩

/-- Helper for Exercise 16-16.2-3: the nontrivial right coordinate can be used directly in the
`p`-subgroup subtype. -/
theorem exists_pElementaryDecomposition_rightCoord_subtype_ne_one_of_not_isPRegular
    {p : ℕ} [Fact p.Prime]
    {H : Type u} [Group H] [Finite H] [IsCyclic H]
    {h : H} (hh : ¬ IsPRegular p h) :
    ∃ (S P : Subgroup H) (hSP : IsPElementaryDecomposition p S P),
      ((hSP.isComplement.prodMulEquiv hSP.commute).symm h).2 ≠ 1 := by
  -- Convert the already-proved ambient nonidentity statement by coercing out of the subgroup.
  rcases exists_pElementaryDecomposition_rightCoord_ne_one_of_not_isPRegular
      (p := p) (H := H) (h := h) hh with
    ⟨S, P, hSP, hright⟩
  refine ⟨S, P, hSP, ?_⟩
  intro hsub
  exact hright (by simp [hsub])

/-- Helper for Exercise 16-16.2-3: in a finite cyclic group, trace vanishing for all nontrivial
right coordinates in a `p`-elementary decomposition implies trace vanishing on every `p`-singular
element. -/
theorem cyclic_trace_action_eq_zero_on_pSingular_of_rightCoord_trace
    {A : Type u} [CommRing A]
    {p : ℕ} [Fact p.Prime]
    {H : Type u} [Group H] [Finite H] [IsCyclic H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    (hcoord :
      ∀ {S P : Subgroup H} (_ : IsPElementaryDecomposition p S P)
        (s : S) (hp : P), hp ≠ 1 →
        LinearMap.trace A V
          (((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
            ((Representation.ofModule' (k := A) (G := H) V) (hp : H))) = 0)
    (h : H) (hh : ¬ IsPRegular p h) :
    LinearMap.trace A V
      ((Representation.ofModule' (k := A) (G := H) V) h) = 0 := by
  -- Choose a p-elementary product decomposition where the p-coordinate of `h` is nontrivial.
  rcases exists_pElementaryDecomposition_rightCoord_subtype_ne_one_of_not_isPRegular
      (p := p) (H := H) (h := h) hh with
    ⟨S, P, hSP, _hright⟩
  -- The general p-elementary reduction now turns coordinate trace vanishing into trace
  -- vanishing for the original cyclic element.
  refine pElementary_trace_eq_zero_on_pSingular_of_rightCoord_trace
    (A := A) (p := p) (H := H) (V := V) hSP ?_ h hh
  intro s hp hhp
  exact hcoord hSP s hp hhp

/-- Helper for Exercise 16-16.2-3: the action of an element in a `p`-elementary product
decomposition factors as the action of its prime-to-`p` coordinate followed by the action of its
`p`-coordinate. -/
theorem pElementary_restricted_action_eq_coord_comp
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P) (h : H) :
    let e := hSP.isComplement.prodMulEquiv hSP.commute
    let s : S := (e.symm h).1
    let hp : P := (e.symm h).2
    ((Representation.ofModule' (k := A) (G := H) V) h) =
      ((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) V) (hp : H)) := by
  dsimp only
  let e := hSP.isComplement.prodMulEquiv hSP.commute
  have hmul : h = ((e.symm h).1 : H) * ((e.symm h).2 : H) := by
    -- Reconstruct `h` from its product coordinates before using multiplicativity of the action.
    simpa [e] using (hSP.symm_apply_eq_mul_coords h).symm
  have haction :
      ((Representation.ofModule' (k := A) (G := H) V) h) =
        ((Representation.ofModule' (k := A) (G := H) V)
          ((((e.symm h).1 : S) : H) * (((e.symm h).2 : P) : H))) := by
    -- Transport only the left action through the coordinate product identity.
    exact congrArg ((Representation.ofModule' (k := A) (G := H) V)) hmul
  -- Multiplicativity of `Representation.ofModule'` turns product reconstruction into composition.
  calc
    ((Representation.ofModule' (k := A) (G := H) V) h) =
        ((Representation.ofModule' (k := A) (G := H) V)
          ((((e.symm h).1 : S) : H) * (((e.symm h).2 : P) : H))) := haction
    _ =
        ((Representation.ofModule' (k := A) (G := H) V) (((e.symm h).1 : S) : H)).comp
          ((Representation.ofModule' (k := A) (G := H) V) (((e.symm h).2 : P) : H)) := by
          rw [map_mul]
          rfl

/-- Helper for Exercise 16-16.2-3: the two coordinate actions in a `p`-elementary
decomposition commute on every group-algebra module. -/
theorem pElementary_coord_actions_commute
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) :
    ((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) V) (hp : H)) =
      ((Representation.ofModule' (k := A) (G := H) V) (hp : H)).comp
        ((Representation.ofModule' (k := A) (G := H) V) (s : H)) := by
  let ρ : Representation A H V := Representation.ofModule' (k := A) (G := H) V
  -- Convert commutation in the group decomposition into commutation of the representation maps.
  calc
    ρ (s : H) ∘ₗ ρ (hp : H) = ρ ((s : H) * (hp : H)) := by
      rw [map_mul]
      rfl
    _ = ρ ((hp : H) * (s : H)) := by
      exact congrArg ρ (hSP.commute s hp).eq
    _ = ρ (hp : H) ∘ₗ ρ (s : H) := by
      rw [map_mul]
      rfl

/-- Helper for Exercise 16-16.2-3: the prime-to-`p` coordinate action is linear for the scalar
action restricted from the `p`-subgroup algebra. -/
theorem pElementary_leftCoord_action_smul_pSubgroupAlgebra
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (r : A[P]) (v : V) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    ((Representation.ofModule' (k := A) (G := H) V) (s : H)) (τ r • v) =
      τ r • ((Representation.ofModule' (k := A) (G := H) V) (s : H) v) := by
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let ρ : Representation A H V := Representation.ofModule' (k := A) (G := H) V
  change ρ (s : H) (τ r • v) = τ r • ρ (s : H) v
  -- It is enough to check the scalar-commutation identity on group-algebra generators.
  refine MonoidAlgebra.induction_on
    (p := fun r : A[P] => ρ (s : H) (τ r • v) = τ r • ρ (s : H) v) r ?_ ?_ ?_
  · intro hp
    have hleft : τ ((MonoidAlgebra.of A P) hp) • v = ρ (hp : H) v := by
      simp only [MonoidAlgebra.of_apply]
      rw [subgroup_mapDomainRingHom_single]
      rw [← ofModule'_asAlgebraHom_apply_commRing
        (R := A) (H := H) (M := V)
        (r := MonoidAlgebra.single (hp : H) (1 : A)) (m := v)]
      rw [Representation.asAlgebraHom_single_one]
    have hright :
        τ ((MonoidAlgebra.of A P) hp) • ρ (s : H) v = ρ (hp : H) (ρ (s : H) v) := by
      simp only [MonoidAlgebra.of_apply]
      rw [subgroup_mapDomainRingHom_single]
      rw [← ofModule'_asAlgebraHom_apply_commRing
        (R := A) (H := H) (M := V)
        (r := MonoidAlgebra.single (hp : H) (1 : A)) (m := ρ (s : H) v)]
      rw [Representation.asAlgebraHom_single_one]
    rw [hleft, hright]
    exact LinearMap.congr_fun
      (pElementary_coord_actions_commute (A := A) (H := H) (V := V) hSP s hp) v
  · intro a b ha hb
    simp [map_add, add_smul, ha, hb]
  · intro a b hb
    have hτalg : τ ((algebraMap A A[P]) a) = algebraMap A A[H] a := by
      simpa [τ] using
        congrArg (fun f : A →+* A[H] => f a)
          (MonoidAlgebra.mapDomainRingHom_comp_algebraMap
            (R := A) (A := A) P.subtype)
    have hτ : τ (a • b) = (algebraMap A A[H] a) * τ b := by
      calc
        τ (a • b) = τ ((algebraMap A A[P]) a * b) := by
          rw [Algebra.smul_def]
        _ = τ ((algebraMap A A[P]) a) * τ b := by
          rw [map_mul]
        _ = (algebraMap A A[H] a) * τ b := by
          rw [hτalg]
    -- The scalar case follows by peeling off the coefficient through the scalar tower.
    calc
      ρ (s : H) (τ (a • b) • v) =
          ρ (s : H) (((algebraMap A A[H] a) * τ b) • v) := by
            rw [hτ]
      _ = ρ (s : H) ((algebraMap A A[H] a) • (τ b • v)) := by
            rw [mul_smul]
      _ = ρ (s : H) (a • (τ b • v)) := by
            rw [IsScalarTower.algebraMap_smul (R := A) (A := A[H]) (M := V)]
      _ = a • ρ (s : H) (τ b • v) := by
            rw [map_smul]
      _ = a • (τ b • ρ (s : H) v) := by
            rw [hb]
      _ = (algebraMap A A[H] a) • (τ b • ρ (s : H) v) := by
            rw [IsScalarTower.algebraMap_smul (R := A) (A := A[H]) (M := V)]
      _ = ((algebraMap A A[H] a) * τ b) • ρ (s : H) v := by
            rw [mul_smul]
      _ = τ (a • b) • ρ (s : H) v := by
            rw [hτ]

/-- Helper for Exercise 16-16.2-3: the prime-to-`p` coordinate action commutes with the literal
`Module.compHom` scalar action of the `p`-subgroup algebra. -/
theorem pElementary_leftCoord_action_smul_compHom_pSubgroupAlgebra
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    ∀ (r : A[P]) (v : V),
      ((Representation.ofModule' (k := A) (G := H) V) (s : H)) (r • v) =
        r • ((Representation.ofModule' (k := A) (G := H) V) (s : H) v) := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  letI : Module A[P] V := Module.compHom V τ
  intro r v
  -- Rewrite the `A[P]`-scalar action to its defining image in `A[H]` and use the
  -- generator-checked scalar-commutation lemma above.
  change
    ((Representation.ofModule' (k := A) (G := H) V) (s : H)) (τ r • v) =
      τ r • ((Representation.ofModule' (k := A) (G := H) V) (s : H) v)
  exact pElementary_leftCoord_action_smul_pSubgroupAlgebra
    (A := A) (H := H) (V := V) hSP s r v

/-- Helper for Exercise 16-16.2-3: the prime-to-`p` coordinate action, packaged as an
`A[P]`-linear endomorphism for the scalar action restricted along `A[P] → A[H]`. -/
def pElementary_leftCoord_action_pSubgroupLinear
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    V →ₗ[A[P]] V :=
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let ρ : Representation A H V := Representation.ofModule' (k := A) (G := H) V
  { toFun := fun v ↦ ρ (s : H) v
    map_add' := (ρ (s : H)).map_add
    map_smul' := pElementary_leftCoord_action_smul_compHom_pSubgroupAlgebra hSP s }

/-- Helper for Exercise 16-16.2-3: the packaged prime-to-`p` coordinate operator acts
pointwise as the corresponding ambient cyclic action. -/
theorem pElementary_leftCoord_action_pSubgroupLinear_apply
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (v : V) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := V) hSP s v =
      ((Representation.ofModule' (k := A) (G := H) V) (s : H)) v := by
  -- Unfold the packaged operator once here so later trace proofs can rewrite by name.
  dsimp [pElementary_leftCoord_action_pSubgroupLinear]

/-- Helper for Exercise 16-16.2-3: after forgetting from `A[P]` to `A`, the packaged
prime-to-`p` coordinate operator is the usual cyclic action map. -/
theorem pElementary_leftCoord_action_pSubgroupLinear_restrictScalars
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    let _ : IsScalarTower A A[P] V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P V
    (pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := V) hSP s).restrictScalars A =
      ((Representation.ofModule' (k := A) (G := H) V) (s : H)) := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  -- Compare the two `A`-linear endomorphisms pointwise using the computation lemma above.
  ext v
  exact pElementary_leftCoord_action_pSubgroupLinear_apply
    (A := A) (H := H) (V := V) hSP s v

/-- Helper for Exercise 16-16.2-3: the packaged prime-to-`p` coordinate operator has finite
order bounded by the size of the prime-to-`p` factor. -/
theorem pElementary_leftCoord_action_pSubgroupLinear_pow_card_eq_id
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    (pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := V) hSP s) ^ Nat.card S = LinearMap.id := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let ρ : Representation A H V := Representation.ofModule' (k := A) (G := H) V
  let u : V →ₗ[A[P]] V :=
    pElementary_leftCoord_action_pSubgroupLinear
      (A := A) (H := H) (V := V) hSP s
  have hpow_apply : ∀ n v, (u ^ n) v = ((ρ (s : H)) ^ n) v := by
    intro n
    induction n with
    | zero =>
        intro v
        simp [u]
    | succ n ih =>
        intro v
        rw [pow_succ', pow_succ']
        change u ((u ^ n) v) = (ρ (s : H)) (((ρ (s : H)) ^ n) v)
        rw [ih]
        dsimp [u, pElementary_leftCoord_action_pSubgroupLinear, ρ]
  letI : Finite S := hSP.finite_cyclic_factor
  letI : Fintype S := Fintype.ofFinite S
  have hs_card_sub : s ^ Nat.card S = 1 := by
    rw [Nat.card_eq_fintype_card]
    exact pow_card_eq_one
  have hs_card : (s : H) ^ Nat.card S = 1 :=
    congrArg Subtype.val hs_card_sub
  have hρpow : (ρ (s : H)) ^ Nat.card S = 1 := by
    rw [← map_pow, hs_card, map_one]
  -- Compare powers pointwise and use that the coordinate lives in the finite factor `S`.
  ext v
  rw [hpow_apply, hρpow]
  rfl

/-- Helper for Exercise 16-16.2-3: the packaged prime-to-`p` coordinate operator has finite
order whose exponent is coprime to the residue characteristic prime. -/
theorem pElementary_leftCoord_action_pSubgroupLinear_coprime_order
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    Nat.Coprime p (Nat.card S) ∧
      (pElementary_leftCoord_action_pSubgroupLinear
          (A := A) (H := H) (V := V) hSP s) ^ Nat.card S = LinearMap.id := by
  dsimp only
  -- The `S`-factor is the prime-to-`p` factor in the elementary decomposition.
  refine ⟨hSP.coprime_card, ?_⟩
  -- The existing coordinate-operator lemma supplies the finite-order equation.
  exact pElementary_leftCoord_action_pSubgroupLinear_pow_card_eq_id
    (A := A) (H := H) (V := V) hSP s

/-- Helper for Exercise 16-16.2-3: the literal action after restricting scalars to a subgroup
algebra agrees with the original ambient cyclic action. -/
theorem pSubgroup_compHom_action_eq_ambient
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    (P : Subgroup H) (hp : P) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    let _ : IsScalarTower A A[P] V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P V
    ((Representation.ofModule' (k := A) (G := P) V) hp) =
      ((Representation.ofModule' (k := A) (G := H) V) (hp : H)) := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  -- Compare the two actions by evaluating their group-algebra singleton formulas.
  ext x
  rw [← Representation.asAlgebraHom_single_one
    (ρ := (Representation.ofModule' (k := A) (G := P) V)) hp]
  rw [← Representation.asAlgebraHom_single_one
    (ρ := (Representation.ofModule' (k := A) (G := H) V)) (hp : H)]
  rw [ofModule'_asAlgebraHom_apply_commRing
    (R := A) (H := P) (M := V)
    (r := MonoidAlgebra.single hp (1 : A)) (m := x)]
  rw [ofModule'_asAlgebraHom_apply_commRing
    (R := A) (H := H) (M := V)
    (r := MonoidAlgebra.single (hp : H) (1 : A)) (m := x)]
  change τ (MonoidAlgebra.single hp (1 : A)) • x =
    (MonoidAlgebra.single (hp : H) (1 : A) : A[H]) • x
  rw [subgroup_mapDomainRingHom_single]

/-- Helper for Exercise 16-16.2-3: the action of a finite-group element factors through its
`p`-regular component followed by the canonical generator of the cyclic subgroup generated by
its `p`-unipotent component. -/
theorem pComponent_action_eq_pRegular_comp_zpowersGenerator
    {A : Type u} [CommRing A]
    {p : ℕ} [Fact p.Prime]
    {H : Type u} [Group H] [Finite H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    (h : H) :
    let P : Subgroup H := Subgroup.zpowers (pUnipotentComponent p h)
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    let _ : IsScalarTower A A[P] V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P V
    ((Representation.ofModule' (k := A) (G := H) V) h) =
      ((Representation.ofModule' (k := A) (G := H) V) (pRegularComponent p h)).comp
        ((Representation.ofModule' (k := A) (G := P) V)
          (⟨pUnipotentComponent p h,
            Subgroup.mem_zpowers (pUnipotentComponent p h)⟩ : P)) := by
  dsimp only
  let P : Subgroup H := Subgroup.zpowers (pUnipotentComponent p h)
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  let ρ : Representation A H V := Representation.ofModule' (k := A) (G := H) V
  let hp : P :=
    ⟨pUnipotentComponent p h, Subgroup.mem_zpowers (pUnipotentComponent p h)⟩
  have hdecomp :
      IsPComponentDecomposition p h (pUnipotentComponent p h) (pRegularComponent p h) :=
    p_component_decomposition_exists (p := p) h (isOfFinOrder_of_finite h)
  have hmul : h = pRegularComponent p h * pUnipotentComponent p h := by
    -- The canonical decomposition stores the product in the opposite order; commute the two
    -- components to put the p-regular action first.
    calc
      h = pUnipotentComponent p h * pRegularComponent p h := hdecomp.eq_mul
      _ = pRegularComponent p h * pUnipotentComponent p h := by
            simpa using hdecomp.commute.eq
  have hp_action :
      ((Representation.ofModule' (k := A) (G := P) V) hp) =
        ρ (pUnipotentComponent p h) := by
    -- The subgroup action of the chosen generator is the same as its ambient `H`-action.
    simpa [P, hp, ρ] using
      pSubgroup_compHom_action_eq_ambient
        (A := A) (H := H) (V := V) P hp
  -- Multiplicativity of the representation now turns the component product into composition.
  rw [hp_action]
  calc
    ρ h = ρ (pRegularComponent p h * pUnipotentComponent p h) := congrArg ρ hmul
    _ = (ρ (pRegularComponent p h)).comp (ρ (pUnipotentComponent p h)) := by
          rw [map_mul]
          rfl

/-- Helper for Exercise 16-16.2-3: the p-elementary coordinate product is the restricted
`A[P]`-linear prime-to-`p` coordinate operator followed by the restricted `P` action. -/
theorem pElementary_coord_action_eq_pSubgroupLinear_comp
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {p : ℕ} {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    let _ : IsScalarTower A A[P] V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P V
    ((pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := V) hSP s).restrictScalars A).comp
      ((Representation.ofModule' (k := A) (G := P) V) hp) =
      ((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) V) (hp : H)) := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  -- Normalize each factor of the product to the ambient `H`-action spelling.
  rw [pElementary_leftCoord_action_pSubgroupLinear_restrictScalars
    (A := A) (H := H) (V := V) hSP s]
  rw [pSubgroup_compHom_action_eq_ambient (A := A) (H := H) (V := V) P hp]

/-- Helper for Exercise 16-16.2-3: an order prime to the residue characteristic prime is
nonzero, so finite-order polynomial arguments may use `X ^ m - 1` with `m > 0`. -/
theorem coprime_prime_right_ne_zero
    {p m : ℕ} [Fact p.Prime] (hm : Nat.Coprime p m) :
    m ≠ 0 := by
  -- If `m = 0`, coprimality says the prime `p` is `1`, contradicting primality.
  intro hm0
  have hcop : Nat.Coprime p 0 := by
    simpa [hm0] using hm
  have hp_eq_one : p = 1 := (Nat.coprime_zero_right p).mp hcop
  exact (Fact.out : Nat.Prime p).ne_one hp_eq_one

/-- Helper for Exercise 16-16.2-3: in the standard group-algebra basis, left multiplication by a
singleton reads off the coefficient at the translated group element. -/
theorem monoidAlgebra_basis_repr_single_mul_apply
    {A : Type u} [CommRing A] {P : Type u} [Group P]
    (a x : P) (c : A[P]) :
    ((MonoidAlgebra.basis P A).repr (MonoidAlgebra.single a (1 : A) * c)) x =
      c (a⁻¹ * x) := by
  -- The standard basis representation is coefficient evaluation, so the singleton product
  -- formula gives the translated coefficient directly.
  simp [MonoidAlgebra.basis]
  change (MonoidAlgebra.single a (1 : A) * c) x = c (a⁻¹ * x)
  rw [MonoidAlgebra.single_mul_apply]
  simp

/-- Helper for Exercise 16-16.2-3: with a finite free `A[P]`-basis, the `A`-trace of an
`A[P]`-linear operator followed by a `P`-action is the corresponding Hattori class-coefficient
sum. -/
theorem trace_comp_pGroupAction_eq_hattoriCoeff_of_basis
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A V] [Module.Finite A V]
    {ι : Type u} [Fintype ι]
    (b : Module.Basis ι A[P] V)
    (u : V →ₗ[A[P]] V) (hp : P) :
    LinearMap.trace A V
      ((u.restrictScalars A).comp
        ((Representation.ofModule' (k := A) (G := P) V) hp)) =
      ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) := by
  classical
  letI : Fintype P := Fintype.ofFinite P
  let bP : Module.Basis P A A[P] := MonoidAlgebra.basis P A
  let bA : Module.Basis (P × ι) A V := bP.smulTower b
  -- Compute the trace in the `A`-basis obtained by multiplying the group-algebra basis with the
  -- chosen free `A[P]`-basis.
  rw [LinearMap.trace_eq_matrix_trace A bA
    ((u.restrictScalars A).comp
      ((Representation.ofModule' (k := A) (G := P) V) hp)), Matrix.trace]
  refine Finset.sum_congr rfl ?_
  intro xi _hxi
  rcases xi with ⟨x, i⟩
  rw [Matrix.diag_apply, LinearMap.toMatrix_apply]
  have hT :
      ((u.restrictScalars A).comp
        ((Representation.ofModule' (k := A) (G := P) V) hp)) (bA (x, i)) =
        (MonoidAlgebra.single (hp * x) (1 : A)) • u (b i) := by
    -- The `P`-action shifts the group-algebra coordinate, and `A[P]`-linearity of `u` lets that
    -- shifted singleton pass through as a scalar.
    simp [bA, bP, Representation.ofModule', smul_smul]
  rw [hT]
  rw [Module.Basis.smulTower_repr]
  rw [map_smul]
  rw [Finsupp.smul_apply]
  change ((MonoidAlgebra.basis P A).repr
      (MonoidAlgebra.single (hp * x) (1 : A) * (b.repr (u (b i))) i)) x =
    ((b.repr (u (b i))) i) (x⁻¹ * hp⁻¹ * x)
  rw [monoidAlgebra_basis_repr_single_mul_apply]
  group

/-- Helper for Exercise 16-16.2-3: over the residue field, finite projective modules over a
finite `p`-group algebra are free by the already proved characteristic-`p` theorem. -/
theorem residueField_pGroupAlgebra_projective_free
    {A : Type u} [CommRing A] [IsLocalRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    {P : Type u} [Group P] [Finite P] (hP : IsPGroup p P)
    {V : Type u} [AddCommGroup V] [Module (IsLocalRing.ResidueField A) V]
    [Module (IsLocalRing.ResidueField A)[P] V]
    [IsScalarTower (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField A)[P] V]
    [Module.Finite (IsLocalRing.ResidueField A) V]
    [Module.Projective (IsLocalRing.ResidueField A)[P] V] :
    Module.Free (IsLocalRing.ResidueField A)[P] V := by
  let k := IsLocalRing.ResidueField A
  let _ : Module.Finite k[P] V := Module.Finite.of_restrictScalars_finite k k[P] V
  let Q : FiniteProjectiveGroupAlgebraModule k P :=
    ⟨FGModuleCat.of k[P] V, inferInstance⟩
  -- Package the residue-field module as a finite projective owner and use the canonical
  -- characteristic-`p` p-group freeness theorem.
  exact
    FiniteProjectiveGroupAlgebraModule.free_of_charP_of_isPGroup
      (k := k) (G := P) (p := p) Q hP

/-- Helper for Exercise 16-16.2-3: a group-algebra coefficient coming from the base ring has
zero total Hattori contribution on every nonidentity conjugacy class. -/
theorem hattoriCoeff_baseScalar_conjClass_sum_eq_zero
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {ι : Type u} [Fintype ι]
    (c : ι → A) {hp : P} (hhp : hp ≠ 1) :
    ∑ xi : P × ι,
      (algebraMap A A[P] (c xi.2)) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  classical
  letI : Fintype P := Fintype.ofFinite P
  -- Each summand is supported at the identity element of `P`, while a nonidentity conjugate
  -- of `hp⁻¹` cannot be the identity.
  apply Finset.sum_eq_zero
  intro xi _hxi
  rcases xi with ⟨x, i⟩
  have hne : x⁻¹ * hp⁻¹ * x ≠ 1 := by
    intro h
    apply hhp
    calc
      hp = (x * (x⁻¹ * hp⁻¹ * x) * x⁻¹)⁻¹ := by group
      _ = 1 := by
            rw [h]
            simp
  calc
    (algebraMap A A[P] (c i)) (x⁻¹ * hp⁻¹ * x) =
        (MonoidAlgebra.single (1 : P) (c i) : A[P]) (x⁻¹ * hp⁻¹ * x) := by
          rw [MonoidAlgebra.single_eq_algebraMap_mul_of]
          simp
    _ = 0 := by
          exact Finsupp.single_eq_of_ne hne

/-- Helper for Exercise 16-16.2-3: if the diagonal Hattori coefficients are represented by
base-ring scalars, their total contribution on a nonidentity conjugacy class vanishes. -/
theorem hattoriCoeff_eq_zero_of_diagonal_baseScalar
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A[P] V]
    {ι : Type u} [Fintype ι]
    (b : Module.Basis ι A[P] V) (u : V →ₗ[A[P]] V)
    (c : ι → A)
    (hdiag : ∀ i, b.repr (u (b i)) i = algebraMap A A[P] (c i))
    {hp : P} (hhp : hp ≠ 1) :
    ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  classical
  -- Replace the diagonal coefficients by their scalar representatives, then use the
  -- support calculation for base-ring scalar elements of the group algebra.
  calc
    ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) =
        ∑ xi : P × ι,
          (algebraMap A A[P] (c xi.2)) (xi.1⁻¹ * hp⁻¹ * xi.1) := by
          refine Finset.sum_congr rfl ?_
          intro xi _hxi
          rw [hdiag xi.2]
    _ = 0 := hattoriCoeff_baseScalar_conjClass_sum_eq_zero
          (A := A) (P := P) (ι := ι) c hhp

/-- Helper for Exercise 16-16.2-3: a scalar `A`-linear operator has scalar-supported diagonal
Hattori coefficients, so its nonidentity conjugacy-class coefficient sum is zero. -/
theorem hattoriCoeff_eq_zero_of_restrictScalars_scalar
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    {ι : Type u} [Fintype ι]
    (b : Module.Basis ι A[P] V) (u : V →ₗ[A[P]] V) (ω : A)
    (hu : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    {hp : P} (hhp : hp ≠ 1) :
    ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  -- First show that every basis-vector diagonal coefficient is the scalar `ω` in `A[P]`.
  refine hattoriCoeff_eq_zero_of_diagonal_baseScalar
    (A := A) (P := P) (V := V) (b := b) (u := u) (fun _ ↦ ω) ?_ hhp
  intro i
  have hu_apply : u (b i) = (algebraMap A A[P] ω) • b i := by
    calc
      u (b i) = (u.restrictScalars A) (b i) := rfl
      _ = (ω • (LinearMap.id : V →ₗ[A] V)) (b i) := by rw [hu]
      _ = ω • b i := by simp
      _ = (algebraMap A A[P] ω) • b i := by
            rw [algebraMap_smul]
  -- Basis coordinates of a scalar multiple of `b i` are zero off `i` and the scalar on `i`.
  rw [hu_apply]
  simp

/-- Helper for Exercise 16-16.2-3: the prime-to-`p` Hattori coefficient conclusion is already
proved in the scalar-supported diagonal case. -/
theorem hattoriCoeff_primeToP_torsion_eq_zero_of_diagonal_baseScalar
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    {P : Type u} [Group P] [Finite P] (hP : IsPGroup p P)
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    {ι : Type u} [Fintype ι]
    (b : Module.Basis ι A[P] V)
    {m : ℕ} (hm : Nat.Coprime p m)
    (u : V →ₗ[A[P]] V) (hu : u ^ m = LinearMap.id)
    (c : ι → A)
    (hdiag : ∀ i, b.repr (u (b i)) i = algebraMap A A[P] (c i))
    {hp : P} (hhp : hp ≠ 1) :
    ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  -- The global prime-to-`p` data is irrelevant once the diagonal coefficients are scalar
  -- supported; the earlier coefficient-support lemma kills the nonidentity conjugacy class.
  let _ := hP
  let _ := hm
  let _ := hu
  exact hattoriCoeff_eq_zero_of_diagonal_baseScalar
    (A := A) (P := P) (V := V) (b := b) (u := u) c hdiag hhp

/-- Helper for Exercise 16-16.2-3: after the basis trace formula, scalar-supported Hattori
diagonal coefficients force the nonidentity `P`-action trace to vanish. -/
theorem trace_comp_pGroupAction_eq_zero_of_diagonal_hattori_baseScalar
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A V] [Module.Finite A V]
    {ι : Type u} [Fintype ι]
    (b : Module.Basis ι A[P] V)
    (u : V →ₗ[A[P]] V) (c : ι → A)
    (hdiag : ∀ i, b.repr (u (b i)) i = algebraMap A A[P] (c i))
    {hp : P} (hhp : hp ≠ 1) :
    LinearMap.trace A V
      ((u.restrictScalars A).comp
        ((Representation.ofModule' (k := A) (G := P) V) hp)) = 0 := by
  -- First rewrite the trace as a Hattori coefficient sum in the chosen free basis.
  rw [trace_comp_pGroupAction_eq_hattoriCoeff_of_basis
    (A := A) (P := P) (V := V) (b := b) (u := u) (hp := hp)]
  -- The scalar-supported diagonal calculation then kills each nonidentity conjugacy-class sum.
  exact hattoriCoeff_eq_zero_of_diagonal_baseScalar
    (A := A) (P := P) (V := V) (b := b) (u := u) c hdiag hhp

/-- Helper for Exercise 16-16.2-3: the prime-to-`p` Hattori coefficient theorem is proved on any
free block where the torsion operator is already scalar after restricting to `A`. -/
theorem hattoriCoeff_primeToP_torsion_eq_zero_of_restrictScalars_scalar
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    {P : Type u} [Group P] [Finite P] (hP : IsPGroup p P)
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    {ι : Type u} [Fintype ι]
    (b : Module.Basis ι A[P] V)
    {m : ℕ} (hm : Nat.Coprime p m)
    (u : V →ₗ[A[P]] V) (hu : u ^ m = LinearMap.id) (ω : A)
    (hu_scalar : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    {hp : P} (hhp : hp ≠ 1) :
    ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  -- Once the diagonal entries are scalar-supported, the finite-order and p-group data are only
  -- side conditions; the scalar-support calculation kills the nonidentity class.
  let _ := hP
  let _ := hm
  let _ := hu
  exact hattoriCoeff_eq_zero_of_restrictScalars_scalar
    (A := A) (P := P) (V := V) (b := b) (u := u) ω hu_scalar hhp

/-- Helper for Exercise 16-16.2-3: on a free `A[P]`-block where the prime-to-`p` operator acts
as a scalar, composing with a nonidentity `P`-action has zero base-linear trace. -/
theorem trace_comp_pGroupAction_eq_zero_of_scalar_on_free_block
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A[P] V] [Module.Finite A[P] V]
    [Module.Free A V] [Module.Finite A V]
    (u : V →ₗ[A[P]] V) (ω : A)
    (hu : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    {hp : P} (hhp : hp ≠ 1) :
    LinearMap.trace A V
      ((u.restrictScalars A).comp
        ((Representation.ofModule' (k := A) (G := P) V) hp)) = 0 := by
  have hcomp :
      (u.restrictScalars A).comp
          ((Representation.ofModule' (k := A) (G := P) V) hp) =
        ω • ((Representation.ofModule' (k := A) (G := P) V) hp) := by
    -- Once the operator is scalar on the block, the composite is the same scalar multiple of the
    -- nonidentity group action.
    rw [hu]
    ext v
    simp
  -- The free group-algebra trace computation kills the nonidentity action, and the scalar is
  -- harmless.
  rw [hcomp]
  exact
    trace_smul_action_eq_zero_of_free_over_pSubgroupAlgebra
      (R := A) (H := P) (M := V) hhp ω

/-- Helper for Exercise 16-16.2-3: a Hattori coefficient vanishing statement in a chosen
`A[P]`-basis immediately gives the corresponding trace vanishing. -/
theorem trace_comp_pGroupAction_eq_zero_of_hattoriCoeff_basis
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A V] [Module.Finite A V]
    {ι : Type u} [Fintype ι]
    (b : Module.Basis ι A[P] V)
    (u : V →ₗ[A[P]] V) {hp : P}
    (hcoeff :
      ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0) :
    LinearMap.trace A V
      ((u.restrictScalars A).comp
        ((Representation.ofModule' (k := A) (G := P) V) hp)) = 0 := by
  -- The trace formula identifies the target trace with the Hattori coefficient sum, so the
  -- supplied coefficient vanishing closes the trace goal.
  rw [trace_comp_pGroupAction_eq_hattoriCoeff_of_basis
    (A := A) (P := P) (V := V) (b := b) (u := u) (hp := hp)]
  exact hcoeff

/-- Helper for Exercise 16-16.2-3: on a finite free `A[P]`-block where the torsion operator is
already scalar after restricting to `A`, the existential Hattori coefficient witness is obtained
from the chosen free basis. -/
theorem exists_basis_hattoriCoeff_eq_zero_of_restrictScalars_scalar
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    {P : Type u} [Group P] [Finite P] (hP : IsPGroup p P)
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Free A[P] V] [Module.Finite A[P] V]
    (u : V →ₗ[A[P]] V) {m : ℕ} (hm : Nat.Coprime p m)
    (hu : u ^ m = LinearMap.id) (ω : A)
    (hu_scalar : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    {hp : P} (hhp : hp ≠ 1) :
    ∃ (ι : Type u) (_ : Fintype ι) (b : Module.Basis ι A[P] V),
      ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  classical
  let ι : Type u := Module.Free.ChooseBasisIndex A[P] V
  let b : Module.Basis ι A[P] V := Module.Free.chooseBasis A[P] V
  letI : Finite ι := Module.Finite.finite_basis b
  letI : Fintype ι := Fintype.ofFinite ι
  -- Choose the canonical finite free basis and consume the already-proved scalar-block
  -- Hattori coefficient calculation.
  exact ⟨ι, inferInstance, b,
    hattoriCoeff_primeToP_torsion_eq_zero_of_restrictScalars_scalar
      (A := A) (p := p) (P := P) (V := V) hP (b := b) hm (u := u) hu ω
      hu_scalar hhp⟩

/-- Helper for Exercise 16-16.2-3: after the cyclic group algebra has been made local, the
projective scalar-block case reduces to the already-proved free scalar-block Hattori
calculation. -/
theorem exists_hattoriCoeff_basis_of_projective_local_scalar
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    {P : Type u} [Group P] [Finite P] [IsCyclic P] [IsLocalRing A[P]]
    (hP : IsPGroup p P)
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Projective A[P] V] [Module.Finite A[P] V]
    (u : V →ₗ[A[P]] V) {m : ℕ} (hm : Nat.Coprime p m)
    (hu : u ^ m = LinearMap.id) (ω : A)
    (hu_scalar : u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    {hp : P} (hhp : hp ≠ 1) :
    ∃ (ι : Type u) (_ : Fintype ι) (b : Module.Basis ι A[P] V),
      ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  letI : CommGroup P := IsCyclic.commGroup
  letI : CommRing A[P] := inferInstance
  have hfree : Module.Free A[P] V := by
    -- Localness of the commutative cyclic group algebra turns finite projective into free.
    exact finite_projective_module_free_of_commutative_local_ring (R := A[P]) (M := V)
  letI : Module.Free A[P] V := hfree
  -- With a free `A[P]`-basis available, reuse the scalar-supported coefficient calculation.
  exact exists_basis_hattoriCoeff_eq_zero_of_restrictScalars_scalar
    (A := A) (p := p) (P := P) (V := V) hP (u := u) hm hu ω hu_scalar hhp

/-- Helper for Exercise 16-16.2-3: integral trace vanishing over the local DVR implies
vanishing of the generic-fiber character value. -/
theorem scalarExtension_character_eq_zero_of_trace_action_eq_zero
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {H : Type u} [Group H] [Finite H]
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (h : H)
    (htrace :
      LinearMap.trace A Q.V
        ((Representation.ofModule' (k := A) (G := H) Q.V) h) = 0) :
    (Q.scalarExtension K).character h = 0 := by
  -- Compute the scalar-extension character by base-changing the integral trace, then map the
  -- integral zero into the fraction field.
  rw [character_scalarExtension_eq_algebraMap_trace (G := H) (K := K) Q h, htrace, map_zero]

/-- Helper for Exercise 16-16.2-3: generic-fiber character vanishing descends to the integral
trace over the DVR, because the map to the fraction field is injective. -/
theorem trace_action_eq_zero_of_scalarExtension_character_eq_zero
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {H : Type u} [Group H] [Finite H]
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (h : H)
    (hchar : (Q.scalarExtension K).character h = 0) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := H) Q.V) h) = 0 := by
  -- Push the integral trace to the fraction field, where it is the supplied character value.
  refine (IsFractionRing.injective A K) ?_
  rw [map_zero, ← character_scalarExtension_eq_algebraMap_trace (G := H) (K := K) Q h]
  exact hchar

/-- Helper for Exercise 16-16.2-3: for a local DVR owner, vanishing of the generic-fiber
character is equivalent to vanishing of the corresponding integral trace. -/
theorem scalarExtension_character_eq_zero_iff_trace_action_eq_zero
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {H : Type u} [Group H] [Finite H]
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (h : H) :
    (Q.scalarExtension K).character h = 0 ↔
      LinearMap.trace A Q.V
        ((Representation.ofModule' (k := A) (G := H) Q.V) h) = 0 := by
  constructor
  · -- Descend a character zero through the injective fraction-field map.
    exact trace_action_eq_zero_of_scalarExtension_character_eq_zero (K := K) Q h
  · -- Base-change an integral trace zero to the scalar-extension character.
    exact scalarExtension_character_eq_zero_of_trace_action_eq_zero (K := K) Q h

/-- Helper for Exercise 16-16.2-3: a complete-local forward range-to-character theorem gives the
integral trace vanishing needed in the local DVR Swan step. -/
theorem trace_action_eq_zero_of_forwardRange_character_vanishing
    {A : Type u} [CommRing A] [IsLocalRing A] [HenselianLocalRing A]
    [IsNoetherianRing A] [IsAdicComplete (IsLocalRing.maximalIdeal A) A]
    [IsDomain A] [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {H : Type u} [Group H] [Finite H]
    {p : ℕ}
    (hforward :
      ∀ {x : R₀[K](H)},
        x ∈
          (projectiveGrothendieckScalarExtensionHom A K :
            P₀[IsLocalRing.ResidueField A](H) →+ R₀[K](H)).range →
        ∀ h : H, ¬ IsPRegular p h →
          (finiteRepGrothendieckCharacter K H x : H → K) h = 0)
    (Q : FiniteProjectiveGroupAlgebraModule A H)
    (h : H) (hh : ¬ IsPRegular p h) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := H) Q.V) h) = 0 := by
  -- First consume the forward Grothendieck-range API at the honest projective owner.
  have hchar : (Q.scalarExtension K).character h = 0 :=
    projectiveScalarExtension_character_eq_zero_on_pSingular_of_forwardRange
      (A := A) (K := K) (H := H) (p := p) hforward Q h hh
  -- Then use the already-proved fraction-field trace/character bridge to descend to `A`.
  exact trace_action_eq_zero_of_scalarExtension_character_eq_zero (K := K) Q h hchar

/-- Helper for Exercise 16-16.2-3: the subgroup-restricted owner uses the same carrier and the
same base-linear action as the ambient owner, so traces of subgroup elements agree with the
corresponding ambient traces. -/
theorem trace_action_restrictedToSubgroup_eq_ambient
    {A : Type u} [CommRing A]
    {H : Subgroup G}
    (Q : FiniteProjectiveGroupAlgebraModule A G) (h : H) :
    LinearMap.trace A
        (restrictedToSubgroup (A := A) (G := G) H Q).V
        ((Representation.ofModule' (k := A) (G := H)
            (restrictedToSubgroup (A := A) (G := G) H Q).V) h) =
      LinearMap.trace A Q.V
        ((Representation.ofModule' (k := A) (G := G) Q.V) (h : G)) := by
  let QH : FiniteProjectiveGroupAlgebraModule A H :=
    restrictedToSubgroup (A := A) (G := G) H Q
  let σ : A[H] →+* A[G] := MonoidAlgebra.mapDomainRingHom A H.subtype
  let _ : Module A[H] Q.V := Module.compHom Q.V σ
  let _ : IsScalarTower A A[H] Q.V :=
    subgroup_compHom_isScalarTower (A := A) (G := G) H Q.V
  let e : Q.V ≃ₗ[A] QH.V :=
    { toFun := fun x => x
      invFun := fun x => x
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl
      map_smul' := by
        intro a x
        change a • x = (algebraMap A A[H] a) • x
        exact (IsScalarTower.algebraMap_smul (A := A[H]) (M := Q.V) a x).symm }
  have haction :
      ((Representation.ofModule' (k := A) (G := H) QH.V) h) =
        e.conj ((Representation.ofModule' (k := A) (G := G) Q.V) (h : G)) := by
    -- Compare the two group actions through their group-algebra singleton actions.
    ext x
    rw [← Representation.asAlgebraHom_single_one
      (ρ := (Representation.ofModule' (k := A) (G := H) QH.V)) h]
    rw [← Representation.asAlgebraHom_single_one
      (ρ := (Representation.ofModule' (k := A) (G := G) Q.V)) (h : G)]
    rw [LinearEquiv.conj_apply]
    rw [ofModule'_asAlgebraHom_apply_commRing
      (R := A) (H := H) (M := QH.V)
      (r := MonoidAlgebra.single h (1 : A)) (m := x)]
    apply e.symm.injective
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
    rw [ofModule'_asAlgebraHom_apply_commRing
      (R := A) (H := G) (M := Q.V)
      (r := MonoidAlgebra.single (h : G) (1 : A)) (m := e.symm x)]
    change
      σ (MonoidAlgebra.single h (1 : A)) • (e.symm x : Q.V) =
        (MonoidAlgebra.single (h : G) (1 : A) : A[G]) • (e.symm x : Q.V)
    simp [σ]
  -- Transport the trace across the identity carrier equivalence.
  change
    LinearMap.trace A QH.V ((Representation.ofModule' (k := A) (G := H) QH.V) h) =
      LinearMap.trace A Q.V ((Representation.ofModule' (k := A) (G := G) Q.V) (h : G))
  rw [haction]
  exact LinearMap.trace_conj'
    ((Representation.ofModule' (k := A) (G := G) Q.V) (h : G)) e

/-- Helper for Exercise 16-16.2-3: trace vanishing on a subgroup-restricted owner gives
ambient generic-fiber character vanishing for the same group element. -/
theorem scalarExtension_character_eq_zero_of_restricted_trace_action_eq_zero
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {H : Subgroup G}
    (Q : FiniteProjectiveGroupAlgebraModule A G) (h : H)
    (htrace :
      LinearMap.trace A
        (restrictedToSubgroup (A := A) (G := G) H Q).V
        ((Representation.ofModule' (k := A) (G := H)
            (restrictedToSubgroup (A := A) (G := G) H Q).V) h) = 0) :
    (Q.scalarExtension K).character (h : G) = 0 := by
  -- Reduce the generic-fiber character to the integral trace of the ambient action.
  refine scalarExtension_character_eq_zero_of_trace_action_eq_zero (K := K) Q (h : G) ?_
  -- The subgroup-restriction trace is already proved equal to that ambient trace.
  rw [← trace_action_restrictedToSubgroup_eq_ambient (A := A) (G := G) (Q := Q) (h := h)]
  exact htrace

/-- Helper for Exercise 16-16.2-3: a Hattori coefficient witness for the prime-to-`p`
coordinate gives the trace-zero coordinate step in a `p`-elementary group. -/
theorem pElementary_coord_trace_eq_zero_of_hattoriCoeff_basis
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    {V : Type u} [AddCommGroup V] [Module A V] [Module A[H] V]
    [IsScalarTower A A[H] V] [Module.Free A V] [Module.Finite A V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P)
    (hbasis :
      let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
      let _ : Module A[P] V := Module.compHom V τ
      let _ : IsScalarTower A A[P] V :=
        subgroup_compHom_isScalarTower (A := A) (G := H) P V
      ∃ (ι : Type u) (_ : Fintype ι) (b : Module.Basis ι A[P] V),
        ∑ xi : P × ι,
          (b.repr
            ((pElementary_leftCoord_action_pSubgroupLinear
              (A := A) (H := H) (V := V) hSP s) (b xi.2)) xi.2)
            (xi.1⁻¹ * hp⁻¹ * xi.1) = 0) :
    LinearMap.trace A V
      (((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) V) (hp : H))) = 0 := by
  dsimp only at hbasis
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  rcases hbasis with ⟨ι, hι, b, hcoeff⟩
  letI : Fintype ι := hι
  have htraceP :
      LinearMap.trace A V
        (((pElementary_leftCoord_action_pSubgroupLinear
          (A := A) (H := H) (V := V) hSP s).restrictScalars A).comp
          ((Representation.ofModule' (k := A) (G := P) V) hp)) = 0 := by
    -- The Hattori coefficient formula is exactly the trace of the `p`-coordinate action after
    -- the prime-to-`p` action is repackaged as an `A[P]`-linear operator.
    exact trace_comp_pGroupAction_eq_zero_of_hattoriCoeff_basis
      (A := A) (P := P) (V := V) (b := b)
      (u := pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := V) hSP s)
      (hp := hp) hcoeff
  -- Rewrite the `A[P]`-linear coordinate spelling back to the ambient `H`-action spelling.
  rw [pElementary_coord_action_eq_pSubgroupLinear_comp
    (A := A) (H := H) (V := V) hSP s hp] at htraceP
  exact htraceP

/-- Helper for Exercise 16-16.2-3: in a cyclic group, Hattori coefficient witnesses for the
prime-to-`p` coordinate imply trace vanishing on every `p`-singular element. -/
theorem cyclic_trace_action_eq_zero_on_pSingular_of_hattoriCoeff_basis
    {A : Type u} [CommRing A]
    {p : ℕ} [Fact p.Prime]
    {H : Type u} [Group H] [Finite H] [IsCyclic H]
    {V : Type u} [AddCommGroup V] [Module A V] [Module A[H] V]
    [IsScalarTower A A[H] V] [Module.Free A V] [Module.Finite A V]
    (hbasis :
      ∀ {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
        (s : S) (hp : P), hp ≠ 1 →
        let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
        let _ : Module A[P] V := Module.compHom V τ
        let _ : IsScalarTower A A[P] V :=
          subgroup_compHom_isScalarTower (A := A) (G := H) P V
        ∃ (ι : Type u) (_ : Fintype ι) (b : Module.Basis ι A[P] V),
          ∑ xi : P × ι,
            (b.repr
              ((pElementary_leftCoord_action_pSubgroupLinear
                (A := A) (H := H) (V := V) hSP s) (b xi.2)) xi.2)
              (xi.1⁻¹ * hp⁻¹ * xi.1) = 0)
    (h : H) (hh : ¬ IsPRegular p h) :
    LinearMap.trace A V
      ((Representation.ofModule' (k := A) (G := H) V) h) = 0 := by
  -- Use the cyclic reduction helper; its coordinate input is exactly the Hattori-coefficient
  -- trace bridge.
  refine cyclic_trace_action_eq_zero_on_pSingular_of_rightCoord_trace
    (A := A) (p := p) (H := H) (V := V) ?_ h hh
  intro S P hSP s hp hhp
  exact pElementary_coord_trace_eq_zero_of_hattoriCoeff_basis
    (A := A) (p := p) (H := H) (V := V) hSP s hp
    (hbasis hSP s hp hhp)

/-- Helper for Exercise 16-16.2-3: on a free `A[P]` block, a scalar prime-to-`p` coordinate
operator followed by a nontrivial `P`-coordinate action has zero ambient coordinate trace. -/
theorem pElementary_coord_trace_eq_zero_of_leftCoord_scalar_on_free_pSubgroup
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    {V : Type u} [AddCommGroup V] [Module A V] [Module A[H] V]
    [IsScalarTower A A[H] V] [Module.Free A V] [Module.Finite A V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) (hhp : hp ≠ 1) (ω : A)
    (hfree :
      let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
      let _ : Module A[P] V := Module.compHom V τ
      let _ : IsScalarTower A A[P] V :=
        subgroup_compHom_isScalarTower (A := A) (G := H) P V
      Module.Free A[P] V)
    (hfinite :
      let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
      let _ : Module A[P] V := Module.compHom V τ
      let _ : IsScalarTower A A[P] V :=
        subgroup_compHom_isScalarTower (A := A) (G := H) P V
      Module.Finite A[P] V)
    (hscalar :
      let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
      let _ : Module A[P] V := Module.compHom V τ
      let _ : IsScalarTower A A[P] V :=
        subgroup_compHom_isScalarTower (A := A) (G := H) P V
      (pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := V) hSP s).restrictScalars A =
        ω • (LinearMap.id : V →ₗ[A] V)) :
    LinearMap.trace A V
      (((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) V) (hp : H))) = 0 := by
  dsimp only at hfree hfinite hscalar
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  letI : Module.Free A[P] V := hfree
  letI : Module.Finite A[P] V := hfinite
  have htraceP :
      LinearMap.trace A V
        (((pElementary_leftCoord_action_pSubgroupLinear
            (A := A) (H := H) (V := V) hSP s).restrictScalars A).comp
          ((Representation.ofModule' (k := A) (G := P) V) hp)) = 0 := by
    -- The restricted prime-to-`p` operator is scalar on this block, so the existing free
    -- group-algebra trace calculation kills the nontrivial right coordinate.
    exact trace_comp_pGroupAction_eq_zero_of_scalar_on_free_block
      (A := A) (P := P) (V := V)
      (u := pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := V) hSP s)
      (ω := ω) hscalar hhp
  -- Rewrite from the restricted `A[P]`-linear coordinate spelling back to the ambient
  -- `H`-action coordinate product.
  rw [pElementary_coord_action_eq_pSubgroupLinear_comp
    (A := A) (H := H) (V := V) hSP s hp] at htraceP
  exact htraceP

/-- Helper for Exercise 16-16.2-3: once an `A[P]`-linear operator has been scalarized after
forgetting to `A` on a free `A[P]`-block, its composite with the `P`-action has the required
one-block trace data. -/
private theorem pSubgroupLinear_pPartBlockTraceData_of_free_restrictScalars_scalar
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Finite A[P] V]
    [Module.Free A V] [Module.Finite A V]
    (u : V →ₗ[A[P]] V) (hfree : Module.Free A[P] V)
    (hscalar :
      ∃ ω : A, u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    (hp : P) :
    Nonempty
      (PPartBlockTraceData (A := A) (V := V) (H := P)
        ((u.restrictScalars A).comp ((Representation.ofModule' (k := A) (G := P) V) hp))
        hp) := by
  letI : Module.Free A[P] V := hfree
  rcases hscalar with ⟨ω, hω⟩
  -- The existing one-block constructor is exactly the scalarized case of the block-data frontier.
  exact nonempty_pPartBlockTraceData_of_restrictScalars_scalar
    (A := A) (P := P) (V := V) u ω hω hp

/-- Helper for Exercise 16-16.2-3: over a local cyclic `p`-group algebra, the projective
scalar-block case reduces to the free scalar-block `PPartBlockTraceData` constructor. -/
theorem nonempty_pPartBlockTraceData_of_projective_local_restrictScalars_scalar
    {A : Type u} [CommRing A]
    {P : Type u} [Group P] [Finite P] [IsCyclic P] [IsLocalRing A[P]]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[P] V] [IsScalarTower A A[P] V]
    [Module.Projective A[P] V] [Module.Finite A[P] V]
    [Module.Free A V] [Module.Finite A V]
    (u : V →ₗ[A[P]] V)
    (hscalar :
      ∃ ω : A, u.restrictScalars A = ω • (LinearMap.id : V →ₗ[A] V))
    (hp : P) :
    Nonempty
      (PPartBlockTraceData (A := A) (V := V) (H := P)
        ((u.restrictScalars A).comp ((Representation.ofModule' (k := A) (G := P) V) hp))
        hp) := by
  letI : CommGroup P := IsCyclic.commGroup
  letI : CommRing A[P] := inferInstance
  have hfree : Module.Free A[P] V := by
    -- The local cyclic group-algebra hypothesis turns finite projective blocks into free blocks.
    exact finite_projective_module_free_of_commutative_local_ring (R := A[P]) (M := V)
  -- With freeness supplied, the existing scalar-block constructor packages the trace data.
  exact pSubgroupLinear_pPartBlockTraceData_of_free_restrictScalars_scalar
    (A := A) (P := P) (V := V) u hfree hscalar hp

/-- Helper for Exercise 16-16.2-3: a scalarized actual left-coordinate action on a local cyclic
`A[P]`-block supplies the block trace data used by the p-elementary trace route. -/
theorem pElementary_leftCoord_pPartBlockTraceData_of_local_scalarAction
    {A : Type u} [CommRing A] [IsLocalRing A]
    {p : ℕ} {H : Type u} [Group H] [Finite H] [IsCyclic H]
    (QH : FiniteProjectiveGroupAlgebraModule A H)
    {S P : Subgroup H} [IsLocalRing A[P]]
    (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P)
    (hscalar :
      let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
      let _ : Module A[P] QH.V := Module.compHom QH.V τ
      let _ : IsScalarTower A A[P] QH.V :=
        subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
      ∃ ω : A,
        (pElementary_leftCoord_action_pSubgroupLinear
          (A := A) (H := H) (V := QH.V) hSP s).restrictScalars A =
          ω • (LinearMap.id : QH.V →ₗ[A] QH.V)) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] QH.V := Module.compHom QH.V τ
    let _ : IsScalarTower A A[P] QH.V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
    Nonempty
      (PPartBlockTraceData (A := A) (V := QH.V) (H := P)
        (((pElementary_leftCoord_action_pSubgroupLinear
          (A := A) (H := H) (V := QH.V) hSP s).restrictScalars A).comp
          ((Representation.ofModule' (k := A) (G := P) QH.V) hp))
        hp) := by
  dsimp only at hscalar ⊢
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] QH.V := Module.compHom QH.V τ
  let _ : IsScalarTower A A[P] QH.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
  have hrestricted :
      IsCyclic P ∧ Module.Projective A[P] QH.V ∧ Module.Finite A[P] QH.V :=
    cyclic_pElementary_pSubgroup_projective_and_finite
      (A := A) (p := p) (H := H) QH hSP
  letI : IsCyclic P := hrestricted.1
  letI : Module.Projective A[P] QH.V := hrestricted.2.1
  letI : Module.Finite A[P] QH.V := hrestricted.2.2
  letI : Module.Free A QH.V :=
    FiniteProjectiveGroupAlgebraModule.free (A := A) (G := H) QH
  letI : Module.Finite A QH.V := QH.finite
  -- The generic local-projective scalar block adapter now applies to this concrete coordinate.
  exact nonempty_pPartBlockTraceData_of_projective_local_restrictScalars_scalar
    (A := A) (P := P) (V := QH.V)
    (pElementary_leftCoord_action_pSubgroupLinear
      (A := A) (H := H) (V := QH.V) hSP s)
    hscalar hp

/-- Helper for Exercise 16-16.2-3: the trace of a composed pair of group actions is the trace of
the action of the product element. -/
theorem trace_ofModule'_comp_eq_trace_mul
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    (x y : H) :
    LinearMap.trace A V
      (((Representation.ofModule' (k := A) (G := H) V) x).comp
        ((Representation.ofModule' (k := A) (G := H) V) y)) =
      LinearMap.trace A V
        ((Representation.ofModule' (k := A) (G := H) V) (x * y)) := by
  let ρ : Representation A H V := Representation.ofModule' (k := A) (G := H) V
  have hmul :
      ρ (x * y) = (ρ x).comp (ρ y) := by
    -- Multiplicativity of the module representation is the only normalization needed here.
    rw [map_mul]
    rfl
  -- Rewrite the product action to the composed-action spelling used in coordinate trace goals.
  rw [hmul]

/-- Helper for Exercise 16-16.2-3: a zero trace for a coordinate product action gives the same
zero trace for the corresponding composed coordinate action. -/
theorem pElementary_coord_trace_eq_zero_of_product_trace
    {A : Type u} [CommRing A]
    {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {S P : Subgroup H} (s : S) (hp : P)
    (hproduct :
      LinearMap.trace A V
        ((Representation.ofModule' (k := A) (G := H) V) ((s : H) * (hp : H))) = 0) :
    LinearMap.trace A V
      (((Representation.ofModule' (k := A) (G := H) V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) V) (hp : H))) = 0 := by
  -- Normalize the composed action to the product action, where the source trace theorem is
  -- expected to apply.
  rw [trace_ofModule'_comp_eq_trace_mul
    (A := A) (H := H) (V := V) (x := (s : H)) (y := (hp : H))]
  exact hproduct

/-- Helper for Exercise 16-16.2-3: in the free product-group case, a nontrivial right coordinate
forces zero trace of the product action. -/
theorem trace_action_eq_zero_of_free_primeToPProduct_right_ne_one
    {R : Type u} [CommRing R]
    {S P : Type u} [Group S] [Group P] [Finite S] [Finite P]
    {M : Type u} [AddCommGroup M] [Module R M] [Module (MonoidAlgebra R (S × P)) M]
    [IsScalarTower R (MonoidAlgebra R (S × P)) M]
    [Module.Free (MonoidAlgebra R (S × P)) M]
    [Module.Finite (MonoidAlgebra R (S × P)) M]
    (s : S) {hp : P} (hhp : hp ≠ 1) :
    LinearMap.trace R M
      ((Representation.ofModule' (k := R) (G := S × P) M) (s, hp)) = 0 := by
  have hne : (s, hp) ≠ (1 : S × P) := by
    -- Equality in the product group would force the right coordinate to be trivial.
    intro hpair
    exact hhp (congrArg Prod.snd hpair)
  -- The existing free group-algebra trace computation applies to the product group.
  exact trace_action_eq_zero_of_free_over_groupAlgebra
    (R := R) (H := S × P) (M := M) hne

/-- Helper for Exercise 16-16.2-3: in a `p`-elementary decomposition, a product with nontrivial
right coordinate is not the identity. -/
theorem pElementary_product_ne_one_of_rightCoord_ne_one
    {p : ℕ} {H : Type u} [Group H] {S P : Subgroup H}
    (hSP : IsPElementaryDecomposition p S P)
    (s : S) {hp : P} (hhp : hp ≠ 1) :
    ((s : H) * (hp : H)) ≠ 1 := by
  -- The established coordinate criterion makes the product p-singular; the identity is
  -- p-regular, so the product cannot be the identity.
  exact
    ne_one_of_not_isPRegular (p := p)
      (pElementary_product_not_isPRegular_of_rightCoord_ne_one
        (p := p) hSP s hp hhp)

/-- Helper for Exercise 16-16.2-3: the product-coordinate trace theorem is already true for a
module free over the ambient group algebra. -/
theorem pElementary_product_trace_eq_zero_of_free_groupAlgebra
    {R : Type u} [CommRing R]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    {V : Type u} [AddCommGroup V] [Module R V] [Module (MonoidAlgebra R H) V]
    [IsScalarTower R (MonoidAlgebra R H) V]
    [Module.Free (MonoidAlgebra R H) V] [Module.Finite (MonoidAlgebra R H) V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) {hp : P} (hhp : hp ≠ 1) :
    LinearMap.trace R V
      ((Representation.ofModule' (k := R) (G := H) V) ((s : H) * (hp : H))) = 0 := by
  have hne :
      ((s : H) * (hp : H)) ≠ 1 :=
    pElementary_product_ne_one_of_rightCoord_ne_one hSP s hhp
  -- On a free group-algebra module, every nonidentity group element acts with zero base trace.
  exact trace_action_eq_zero_of_free_over_groupAlgebra
    (R := R) (H := H) (M := V) hne

/-- Helper for Exercise 16-16.2-3: the product-coordinate trace theorem specializes to any
finite projective owner whose ambient group-algebra module is already free. -/
theorem pElementary_product_trace_eq_zero_of_free_owner_groupAlgebra
    {R : Type u} [CommRing R]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    (Q : FiniteProjectiveGroupAlgebraModule R H)
    [Module.Free (MonoidAlgebra R H) Q.V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) {hp : P} (hhp : hp ≠ 1) :
    LinearMap.trace R Q.V
      ((Representation.ofModule' (k := R) (G := H) Q.V) ((s : H) * (hp : H))) = 0 := by
  -- The owner is finite over `R`; those generators also generate after allowing `R[H]`
  -- coefficients, so the generic free group-algebra trace lemma applies.
  letI : Module.Finite (MonoidAlgebra R H) Q.V :=
    Module.Finite.of_restrictScalars_finite R (MonoidAlgebra R H) Q.V
  exact pElementary_product_trace_eq_zero_of_free_groupAlgebra
    (R := R) (p := p) (H := H) (V := Q.V) hSP s hhp

/-- Helper for Exercise 16-16.2-3: in the free ambient group-algebra case, the trace of a
composed p-elementary coordinate action is zero when the `p`-coordinate is nontrivial. -/
theorem pElementary_coord_trace_eq_zero_of_free_owner_groupAlgebra
    {R : Type u} [CommRing R]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    (Q : FiniteProjectiveGroupAlgebraModule R H)
    [Module.Free (MonoidAlgebra R H) Q.V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) {hp : P} (hhp : hp ≠ 1) :
    LinearMap.trace R Q.V
      (((Representation.ofModule' (k := R) (G := H) Q.V) (s : H)).comp
        ((Representation.ofModule' (k := R) (G := H) Q.V) (hp : H))) = 0 := by
  -- First turn the composed coordinate action into the action of the product element.
  rw [trace_ofModule'_comp_eq_trace_mul
    (A := R) (H := H) (V := Q.V) (x := (s : H)) (y := (hp : H))]
  -- The product element has nontrivial `p`-coordinate, so the free ambient trace lemma applies.
  exact pElementary_product_trace_eq_zero_of_free_owner_groupAlgebra
    (R := R) (p := p) (H := H) Q hSP s hhp

/-- Helper for Exercise 16-16.2-3: any source-level trace theorem for all `p`-singular group
elements immediately gives the product-coordinate trace theorem in a `p`-elementary
decomposition. -/
theorem pElementary_product_trace_eq_zero_of_pSingular_trace
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H]
    {V : Type u} [AddCommGroup V] [Module A V]
    [Module A[H] V] [IsScalarTower A A[H] V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (htrace :
      ∀ g : H, ¬ IsPRegular p g →
        LinearMap.trace A V
          ((Representation.ofModule' (k := A) (G := H) V) g) = 0)
    (s : S) (hp : P) (hhp : hp ≠ 1) :
    LinearMap.trace A V
      ((Representation.ofModule' (k := A) (G := H) V) ((s : H) * (hp : H))) = 0 := by
  -- The nontrivial right coordinate is exactly the source-side `p`-singularity input.
  exact htrace ((s : H) * (hp : H))
    (pElementary_product_not_isPRegular_of_rightCoord_ne_one hSP s hp hhp)

/-- Helper for Exercise 16-16.2-3: a source-level trace theorem for all `p`-singular elements
of a finite projective owner gives the p-elementary nontrivial-coordinate trace theorem. -/
theorem pElementary_owner_coord_trace_eq_zero_of_pSingular_trace
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    (QH : FiniteProjectiveGroupAlgebraModule A H)
