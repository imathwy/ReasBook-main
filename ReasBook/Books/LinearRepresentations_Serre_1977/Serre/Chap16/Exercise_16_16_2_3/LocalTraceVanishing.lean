    let _ : Module A[P] QH.V := Module.compHom QH.V τ
    let _ : IsScalarTower A A[P] QH.V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
    Module.Free A[P] QH.V ∧ Module.Finite A[P] QH.V := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] QH.V := Module.compHom QH.V τ
  let _ : IsScalarTower A A[P] QH.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
  -- The local cyclic subgroup algebra turns the restricted finite projective owner into a free
  -- module, while restriction supplies finite generation over `A[P]`.
  exact ⟨
    pSubgroup_compHom_free_of_ambient_projective_of_local_groupAlgebra
      (A := A) (H := H) QH P,
    (pSubgroup_compHom_projective_and_finite_of_ambient_projective
      (A := A) (H := H) QH P).2⟩

/-- Helper for Exercise 16-16.2-3: under the local subgroup-algebra hypothesis, a cyclic
projective owner restricted to `A[P]` admits a finite free `A[P]`-basis. -/
theorem exists_finite_pSubgroup_basis_of_local_cyclic_projective_owner
    {A : Type u} [CommRing A]
    {H : Type u} [Group H] [Finite H] [IsCyclic H]
    (QH : FiniteProjectiveGroupAlgebraModule A H)
    (P : Subgroup H) [IsCyclic P] [IsLocalRing A[P]] :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] QH.V := Module.compHom QH.V τ
    let _ : IsScalarTower A A[P] QH.V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
    ∃ (ι : Type u) (_ : Fintype ι), Nonempty (Module.Basis ι A[P] QH.V) := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] QH.V := Module.compHom QH.V τ
  let _ : IsScalarTower A A[P] QH.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
  have hfreeFinite :
      Module.Free A[P] QH.V ∧ Module.Finite A[P] QH.V :=
    pSubgroup_compHom_free_and_finite_of_local_cyclic_projective_owner
      (A := A) (H := H) QH P
  -- Install the packaged finite free structure before choosing the canonical finite basis.
  have hfree : Module.Free A[P] QH.V := hfreeFinite.1
  have hfinite : Module.Finite A[P] QH.V := hfreeFinite.2
  letI : Module.Free A[P] QH.V := hfree
  letI : Module.Finite A[P] QH.V := hfinite
  let ι : Type u := Module.Free.ChooseBasisIndex A[P] QH.V
  let b : Module.Basis ι A[P] QH.V := Module.Free.chooseBasis A[P] QH.V
  letI : Finite ι := Module.Finite.finite_basis b
  letI : Fintype ι := Fintype.ofFinite ι
  -- Choose the canonical finite free basis made available by the local subgroup algebra.
  exact ⟨ι, inferInstance, ⟨b⟩⟩

/-- Helper for Exercise 16-16.2-3: scalar-supported diagonal coefficients for the
prime-to-`p` coordinate action supply the Hattori-coefficient witness needed in the cyclic trace
reduction. -/
theorem pElementary_exists_hattoriCoeff_basis_of_leftCoord_diagonal_baseScalar
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H] [Finite H]
    {V : Type u} [AddCommGroup V] [Module A V] [Module A[H] V]
    [IsScalarTower A A[H] V]
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) (hhp : hp ≠ 1)
    (hbasis_diag :
      let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
      let _ : Module A[P] V := Module.compHom V τ
      let _ : IsScalarTower A A[P] V :=
        subgroup_compHom_isScalarTower (A := A) (G := H) P V
      ∃ (ι : Type u) (_ : Fintype ι) (b : Module.Basis ι A[P] V) (c : ι → A),
        ∀ i,
          (b.repr
            ((pElementary_leftCoord_action_pSubgroupLinear
              (A := A) (H := H) (V := V) hSP s) (b i)) i) =
            algebraMap A A[P] (c i)) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] V := Module.compHom V τ
    let _ : IsScalarTower A A[P] V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P V
    ∃ (ι : Type u) (_ : Fintype ι) (b : Module.Basis ι A[P] V),
      ∑ xi : P × ι,
        (b.repr
          ((pElementary_leftCoord_action_pSubgroupLinear
            (A := A) (H := H) (V := V) hSP s) (b xi.2)) xi.2)
          (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  dsimp only at hbasis_diag ⊢
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] V := Module.compHom V τ
  let _ : IsScalarTower A A[P] V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P V
  rcases hbasis_diag with ⟨ι, hι, b, c, hdiag⟩
  letI : Fintype ι := hι
  -- Replace the diagonal coefficients by their scalar representatives; scalar-supported
  -- coefficients have no contribution on a nontrivial conjugacy class in `P`.
  exact ⟨ι, hι, b,
    hattoriCoeff_eq_zero_of_diagonal_baseScalar
      (A := A) (P := P) (V := V) (b := b)
      (u := pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := V) hSP s)
      c hdiag hhp⟩

/-- Helper for Exercise 16-16.2-3: in the cyclic p-elementary reduction, the actual
left-coordinate operator has the finite-projective subgroup restriction and prime-to-`p`
finite-order side conditions needed for scalar-block decomposition. -/
theorem leftCoordAction_pSubgroupSideConditions
    {A : Type u} [CommRing A]
    {p : ℕ} {H : Type u} [Group H] [Finite H] [IsCyclic H]
    (QH : FiniteProjectiveGroupAlgebraModule A H)
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) :
    let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
    let _ : Module A[P] QH.V := Module.compHom QH.V τ
    let _ : IsScalarTower A A[P] QH.V :=
      subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
    IsCyclic P ∧ Module.Projective A[P] QH.V ∧ Module.Finite A[P] QH.V ∧
      Nat.Coprime p (Nat.card S) ∧
        (pElementary_leftCoord_action_pSubgroupLinear
          (A := A) (H := H) (V := QH.V) hSP s) ^ Nat.card S = LinearMap.id := by
  dsimp only
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] QH.V := Module.compHom QH.V τ
  let _ : IsScalarTower A A[P] QH.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
  have hrestricted :
      IsCyclic P ∧ Module.Projective A[P] QH.V ∧ Module.Finite A[P] QH.V :=
    cyclic_pElementary_pSubgroup_projective_and_finite
      (A := A) (p := p) (H := H) QH hSP
  have horder :
      Nat.Coprime p (Nat.card S) ∧
        (pElementary_leftCoord_action_pSubgroupLinear
          (A := A) (H := H) (V := QH.V) hSP s) ^ Nat.card S = LinearMap.id :=
    pElementary_leftCoord_action_pSubgroupLinear_coprime_order
      (A := A) (H := H) (V := QH.V) hSP s
  -- Combine the subgroup-restriction side conditions with the finite-order calculation for the
  -- actual `S`-coordinate operator.
  exact ⟨hrestricted.1, hrestricted.2.1, hrestricted.2.2, horder.1, horder.2⟩

