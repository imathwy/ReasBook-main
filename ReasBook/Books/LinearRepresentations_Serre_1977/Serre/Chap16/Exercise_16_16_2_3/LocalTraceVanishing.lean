            (((pElementary_leftCoord_action_pSubgroupLinear
              (A := A) (H := H) (V := QH.V) hSP s).restrictScalars A).comp
              ((Representation.ofModule' (k := A) (G := P) QH.V) hp))
            hp))
    (g : G) (hg : ¬ IsPRegular p g) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := G) Q.V) g) = 0 := by
  -- First reduce the ambient statement to the cyclic subgroup generated by the chosen
  -- `p`-singular element.
  refine localDVR_projective_trace_eq_zero_on_pSingular_of_cyclic_trace
    (A := A) (G := G) (p := p) Q g hg ?_
  intro H _ _ _ QH h hh
  -- On the cyclic subgroup, the coordinate block-data API kills each `p`-elementary coordinate
  -- trace and therefore kills the trace of the chosen singular element.
  refine cyclic_trace_action_eq_zero_on_pSingular_of_coordBlockTraceData
    (A := A) (p := p) QH ?_ h hh
  intro S P hSP s hp hhp
  exact hdata QH hSP s hp hhp

/-- Helper for Exercise 16-16.2-3: direct coordinate trace vanishing on every cyclic restriction
implies Swan's integral trace vanishing over a local DVR. -/
theorem localDVR_projective_trace_eq_zero_on_pSingular_of_cyclic_coordTrace
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    (Q : FiniteProjectiveGroupAlgebraModule A G)
    (hcoord :
      ∀ {H : Type u} [Group H] [Finite H] [IsCyclic H],
        (QH : FiniteProjectiveGroupAlgebraModule A H) →
        ∀ {S P : Subgroup H} (_ : IsPElementaryDecomposition p S P)
          (s : S) (hp : P), hp ≠ 1 →
        LinearMap.trace A QH.V
          (((Representation.ofModule' (k := A) (G := H) QH.V) (s : H)).comp
            ((Representation.ofModule' (k := A) (G := H) QH.V) (hp : H))) = 0)
    (g : G) (hg : ¬ IsPRegular p g) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := G) Q.V) g) = 0 := by
  -- Reduce the ambient trace to cyclic subgroups, then consume the direct coordinate theorem.
  refine localDVR_projective_trace_eq_zero_on_pSingular_of_cyclic_trace
    (A := A) (G := G) (p := p) Q g hg ?_
  intro H _ _ _ QH h hh
  -- On a cyclic subgroup, the existing p-elementary reduction needs only coordinate traces.
  refine cyclic_trace_action_eq_zero_on_pSingular_of_rightCoord_trace
    (A := A) (p := p) (H := H) (V := QH.V) ?_ h hh
