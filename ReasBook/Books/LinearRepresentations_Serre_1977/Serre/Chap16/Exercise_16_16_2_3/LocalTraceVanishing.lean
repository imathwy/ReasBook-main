/-- Helper for Exercise 16-16.2-3: on a scalarized local cyclic `A[P]`-block, the actual
left-coordinate and nontrivial right-coordinate product has zero trace. -/
theorem pElementary_leftCoord_trace_eq_zero_of_restrictScalars_scalar
    {A : Type u} [CommRing A] [IsLocalRing A]
    {p : ℕ} {H : Type u} [Group H] [Finite H] [IsCyclic H]
    (QH : FiniteProjectiveGroupAlgebraModule A H)
    {S P : Subgroup H} [IsLocalRing A[P]]
    (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) (hhp : hp ≠ 1) (ω : A)
    (hscalar :
      let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
      let _ : Module A[P] QH.V := Module.compHom QH.V τ
      let _ : IsScalarTower A A[P] QH.V :=
        subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
      (pElementary_leftCoord_action_pSubgroupLinear
        (A := A) (H := H) (V := QH.V) hSP s).restrictScalars A =
        ω • (LinearMap.id : QH.V →ₗ[A] QH.V)) :
    LinearMap.trace A QH.V
      (((Representation.ofModule' (k := A) (G := H) QH.V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) QH.V) (hp : H))) = 0 := by
  dsimp only at hscalar
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] QH.V := Module.compHom QH.V τ
  let _ : IsScalarTower A A[P] QH.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
  -- The scalar-action hypothesis now feeds the block-trace API for the nontrivial right
  -- coordinate.
  have htraceP :
      LinearMap.trace A QH.V
        (((pElementary_leftCoord_action_pSubgroupLinear
            (A := A) (H := H) (V := QH.V) hSP s).restrictScalars A).comp
          ((Representation.ofModule' (k := A) (G := P) QH.V) hp)) = 0 := by
    letI : Module.Free A QH.V :=
      FiniteProjectiveGroupAlgebraModule.free (A := A) (G := H) QH
    letI : Module.Finite A QH.V := QH.finite
    -- Package the scalarized left-coordinate action as block data, then descend the trace.
    exact trace_eq_zero_of_nonempty_pPartBlockTraceData
      (A := A) (V := QH.V) (H := P) hhp
      (pElementary_leftCoord_pPartBlockTraceData_of_local_scalarAction
        (A := A) (p := p) (H := H) QH hSP s hp ⟨ω, hscalar⟩)
  -- Rewrite the restricted `A[P]` trace back to the ambient `H`-coordinate product.
  rw [pElementary_coord_action_eq_pSubgroupLinear_comp
    (A := A) (H := H) (V := QH.V) hSP s hp] at htraceP
  exact htraceP

/-- Helper for Exercise 16-16.2-3: if the full cyclic group algebra is local, then finite
projectivity makes the owner free and the p-elementary coordinate trace vanishes. -/
theorem pElementary_coord_trace_eq_zero_of_local_groupAlgebra
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    {H : Type u} [Group H] [Finite H] [IsCyclic H] [IsLocalRing A[H]]
    (QH : FiniteProjectiveGroupAlgebraModule A H)
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) (hhp : hp ≠ 1) :
    LinearMap.trace A QH.V
      (((Representation.ofModule' (k := A) (G := H) QH.V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) QH.V) (hp : H))) = 0 := by
  -- Localness of the full cyclic group algebra turns the projective owner into a free block.
  have hfree : Module.Free A[H] QH.V := by
    exact finiteProjective_free_over_localCyclicGroupAlgebra (A := A) (P := H) (V := QH.V)
  letI : Module.Free A[H] QH.V := hfree
  -- On a free group-algebra block, the regular-basis trace calculation kills the nontrivial
  -- p-coordinate product.
  exact pElementary_coord_trace_eq_zero_of_free_owner_groupAlgebra
    (R := A) (p := p) (H := H) QH hSP s hhp

/-- Helper for Exercise 16-16.2-3: if the relative `A[P]`-trace of the prime-to-`p` left
coordinate operator is supported at the identity (a base scalar), then every Hattori
coefficient sum on a nontrivial `P`-conjugacy class vanishes.  This is the bridge from the
diagonalization kernel `trace_pSubgroupLinear_mem_algebraMap_range` to the basis trace formula:
since `P` is abelian the conjugacy class of `hp⁻¹` is `{hp⁻¹}`, and the whole sum collapses to
`|P|` copies of the identity-coefficient of a scalar element, which is `0` away from `1`. -/
theorem hattoriSum_eq_zero_of_trace_mem_algebraMap_range
    {A : Type u} [CommRing A] {P : Type u} [CommGroup P] [Finite P]
    {V : Type u} [AddCommGroup V] [Module A V] [Module A[P] V]
    [IsScalarTower A A[P] V]
    {ι : Type u} [Fintype ι] (b : Module.Basis ι A[P] V)
    (u : V →ₗ[A[P]] V) {hp : P} (hhp : hp ≠ 1)
    (htrace : ∃ a : A, LinearMap.trace A[P] V u = algebraMap A A[P] a) :
    ∑ xi : P × ι, (b.repr (u (b xi.2)) xi.2) (xi.1⁻¹ * hp⁻¹ * xi.1) = 0 := by
  classical
  letI : Fintype P := Fintype.ofFinite P
  obtain ⟨a, ha⟩ := htrace
  -- The matrix trace identifies the relative trace with the sum of diagonal coefficients.
  have hdiag : (∑ i, b.repr (u (b i)) i) = algebraMap A A[P] a := by
    rw [← ha, LinearMap.trace_eq_matrix_trace A[P] b u]
    simp [Matrix.trace, Matrix.diag_apply, LinearMap.toMatrix_apply]
  rw [Fintype.sum_prod_type]
  apply Finset.sum_eq_zero
  intro x _
  -- Pull the coefficient through the finite sum: each fixed `x` contributes the
  -- `x⁻¹ hp⁻¹ x`-coefficient of the (scalar) relative trace.
  have hinner : ∑ i, (b.repr (u (b i)) i) (x⁻¹ * hp⁻¹ * x)
      = (algebraMap A A[P] a) (x⁻¹ * hp⁻¹ * x) := by
    rw [← hdiag]
    exact (Finsupp.finset_sum_apply Finset.univ (fun i => (b.repr (u (b i))) i)
      (x⁻¹ * hp⁻¹ * x)).symm
  have hne : x⁻¹ * hp⁻¹ * x ≠ 1 := by
    intro h
    apply hhp
    have h3 : hp⁻¹ = (1 : P) := by
      have hcj : x * (x⁻¹ * hp⁻¹ * x) * x⁻¹ = x * (1 : P) * x⁻¹ := by rw [h]
      simpa [mul_assoc] using hcj
    simpa using h3
  have hzero : (algebraMap A A[P] a) (x⁻¹ * hp⁻¹ * x) = 0 := by
    rw [MonoidAlgebra.coe_algebraMap, Function.comp_apply, MonoidAlgebra.single_apply,
      if_neg (fun h => hne h.symm)]
  rw [hinner, hzero]

/-- Helper for Exercise 16-16.2-3: direct p-elementary coordinate trace vanishing over the
product algebra, with the prime-to-`p` coordinate absorbed into the coefficient ring.

This closes Swan's local finite-projective `p`-singular trace theorem for a cyclic
`p`-elementary owner via the genuine diagonalization kernel
`trace_pSubgroupLinear_mem_algebraMap_range`: the prime-to-`p` left-coordinate operator has
order coprime to `p`, so over a local extension containing the relevant roots of unity it splits
into scalar eigenblocks, whence its relative `A[P]`-trace is supported at the identity; the
Hattori basis formula then kills the nontrivial `p`-coordinate trace. -/
theorem pElementary_coord_trace_eq_zero_of_projective_pGroupAlgebra
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    {H : Type u} [Group H] [Finite H] [IsCyclic H]
    (QH : FiniteProjectiveGroupAlgebraModule A H)
    {S P : Subgroup H} (hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) (hhp : hp ≠ 1) :
    LinearMap.trace A QH.V
      (((Representation.ofModule' (k := A) (G := H) QH.V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) QH.V) (hp : H))) = 0 := by
  classical
  let τ : A[P] →+* A[H] := MonoidAlgebra.mapDomainRingHom A P.subtype
  let _ : Module A[P] QH.V := Module.compHom QH.V τ
  let _ : IsScalarTower A A[P] QH.V :=
    subgroup_compHom_isScalarTower (A := A) (G := H) P QH.V
  -- Restriction side conditions and the prime-to-`p` finite order of the left coordinate.
  obtain ⟨hcyc, hproj, hfin, hcop, hpow⟩ :=
    leftCoordAction_pSubgroupSideConditions (A := A) (p := p) (H := H) QH hSP s
  letI : IsCyclic P := hcyc
  letI : CommGroup P := IsCyclic.commGroup
  letI : Module.Projective A[P] QH.V := hproj
  letI : Module.Finite A[P] QH.V := hfin
  have hP : IsPGroup p P := hSP.isPGroup
  haveI : IsLocalRing A[P] := isLocalRing_monoidAlgebra_of_isPGroup hP
  -- The diagonalization kernel: the relative `A[P]`-trace of the left-coordinate operator is a
  -- base scalar (supported at the identity of `P`).
  have htr : ∃ a : A, LinearMap.trace A[P] QH.V
      (pElementary_leftCoord_action_pSubgroupLinear (A := A) (H := H) (V := QH.V) hSP s)
        = algebraMap A A[P] a := by
    refine trace_pSubgroupLinear_mem_algebraMap_range (A := A) (p := p) (P := P) (V := QH.V) hP
      (pElementary_leftCoord_action_pSubgroupLinear (A := A) (H := H) (V := QH.V) hSP s)
      hcop ?_
    rw [hpow, Module.End.one_eq_id]
  -- Choose a finite free `A[P]`-basis of the (local-cyclic, hence free) projective owner.
  obtain ⟨ι, hιfin, ⟨b⟩⟩ :=
    exists_finite_pSubgroup_basis_of_local_cyclic_projective_owner (A := A) (H := H) QH P
  letI : Fintype ι := hιfin
  letI : Module.Free A QH.V := FiniteProjectiveGroupAlgebraModule.free (A := A) (G := H) QH
  letI : Module.Finite A QH.V := QH.finite
  -- Rewrite the ambient coordinate product as the `A[P]`-linear coordinate composite and apply
  -- the Hattori basis trace formula, fed by the base-scalar relative trace.
  rw [← pElementary_coord_action_eq_pSubgroupLinear_comp (A := A) (H := H) (V := QH.V) hSP s hp]
  exact trace_comp_pGroupAction_eq_zero_of_hattoriCoeff_basis (A := A) (P := P) (V := QH.V) b
    (pElementary_leftCoord_action_pSubgroupLinear (A := A) (H := H) (V := QH.V) hSP s)
    (hattoriSum_eq_zero_of_trace_mem_algebraMap_range (A := A) (P := P) (V := QH.V) b
      (pElementary_leftCoord_action_pSubgroupLinear (A := A) (H := H) (V := QH.V) hSP s) hhp htr)

/-- Helper for Exercise 16-16.2-3: the p-elementary left-coordinate action has zero trace after
composition with every nontrivial right `p`-coordinate. -/
theorem pElementary_leftCoord_trace_eq_zero
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    {H : Type u} [Group H] [Finite H] [IsCyclic H]
    (QH : FiniteProjectiveGroupAlgebraModule A H)
    {S P : Subgroup H} (_hSP : IsPElementaryDecomposition p S P)
    (s : S) (hp : P) (hhp : hp ≠ 1) :
    LinearMap.trace A QH.V
      (((Representation.ofModule' (k := A) (G := H) QH.V) (s : H)).comp
        ((Representation.ofModule' (k := A) (G := H) QH.V) (hp : H))) = 0 := by
  -- The live proof path now consumes the direct p-elementary coordinate theorem; this avoids the
  -- obsolete p-component block-data route.
  exact pElementary_coord_trace_eq_zero_of_projective_pGroupAlgebra
    (A := A) (p := p) QH _hSP s hp hhp

/-- Helper for Exercise 16-16.2-3: Swan's local integral trace theorem over a DVR with residue
characteristic `p`.  This is the source-level local input needed after all Hattori-coefficient
wrappers have been removed from the live proof path. -/
theorem localDVR_projective_trace_eq_zero_on_pSingular
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    (Q : FiniteProjectiveGroupAlgebraModule A G)
    (g : G) (hg : ¬ IsPRegular p g) :
    LinearMap.trace A Q.V
      ((Representation.ofModule' (k := A) (G := G) Q.V) g) = 0 := by
  -- Route correction: the obsolete Hattori wrapper chain is no longer the main proof route.
  -- The cyclic and `p`-elementary trace reductions are now packaged in the direct coordinate
  -- helper; the only remaining source input is the Serre 15.7 split-coordinate trace theorem.
  refine localDVR_projective_trace_eq_zero_on_pSingular_of_cyclic_coordTrace
    (A := A) (G := G) (p := p) Q ?_ g hg
  intro H _ _ _ QH S P hSP s hp hhp
  -- The coordinate setup and finite-order side conditions are now isolated in the dedicated
  -- source-facing direct trace helper.
  exact pElementary_leftCoord_trace_eq_zero
    (A := A) (p := p) QH hSP s hp hhp

/-- Helper for Exercise 16-16.2-3: Swan's local DVR character-vanishing theorem for finite
projective group-algebra modules over a DVR with residue characteristic `p`. -/
theorem localDVR_projective_character_eq_zero_on_pSingular
    {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    (K : Type u) [Field K] [Algebra A K] [IsFractionRing A K]
    {p : ℕ} [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]
    (Q : FiniteProjectiveGroupAlgebraModule A G)
    (g : G) (hg : ¬ IsPRegular p g) :
    (Q.scalarExtension K).character g = 0 := by
  -- Route correction: the previous route expanded this into cyclic Hattori coefficient
  -- witnesses.  The live proof now uses the source-facing integral trace theorem directly, and
  -- only base-changes that trace equality to the quotient field.
  exact scalarExtension_character_eq_zero_of_trace_action_eq_zero
    (H := G) (K := K) Q g
    (localDVR_projective_trace_eq_zero_on_pSingular
      (A := A) (G := G) (p := p) Q g hg)

