variable {G : Type u} [Group G]

/-- A finite family of subgroups of `G` is a conjugacy cover if the conjugates of its members
cover all of `G`. -/
def is_conjugacy_cover (X : Finset (Subgroup G)) : Prop :=
  (Set.univ : Set G) ⊆ ⋃ H : X, Group.conjugatesOfSet (H.1 : Set G)

-- Proof sketch: unfold `is_conjugacy_cover` and rewrite subset membership in the union of
-- conjugates as an elementwise existential condition.
/-- A finite family of subgroups is a conjugacy cover exactly when every element lies in the
conjugate of one of its members. -/
theorem is_conjugacy_cover_iff (X : Finset (Subgroup G)) :
    is_conjugacy_cover X ↔
      ∀ g : G, ∃ H ∈ X, g ∈ Group.conjugatesOfSet (H : Set G) := by
  constructor
  · intro h g
    rcases Set.mem_iUnion.mp (h (Set.mem_univ g)) with ⟨H, hgH⟩
    exact ⟨H, H.2, hgH⟩
  · intro h g _
    rcases h g with ⟨H, hHX, hgH⟩
    exact Set.mem_iUnion.mpr ⟨⟨H, hHX⟩, hgH⟩

end

section

variable {G : Type} [Group G] [Finite G]

/-- Local finite-type witness for the first finite-group section of Theorem 9-9.2-1. -/
local instance instFintypeGroupSectionOne : Fintype G := Fintype.ofFinite G

namespace Subgroup

/-- Inducing a virtual character on `H` gives an element of the integral character ring `R(G)`. -/
theorem inducedClassFunction_mem_characterRing (H : Subgroup G) (χ : R(H)) :
    Ind[H]((χ : H → ℂ)) ∈ R(G) := by
  -- This is exactly the complex specialization of the general Chapter 12 induction theorem.
  simpa using Subgroup.inducedClassFunction_mem_characterRingOverField (K := ℂ) H χ

/-- The canonical `ℤ`-linear induction map `R(H) → R(G)` on Serre's integral character rings. -/
def characterRingInduction (H : Subgroup G) :
    R(H) →ₗ[ℤ] R(G) where
  toFun χ := ⟨Ind[H]((χ : H → ℂ)), inducedClassFunction_mem_characterRing H χ⟩
  map_add' χ ψ := by
    have h_add :=
      (((_root_.classFunctionSubspace G).subtype.comp H.classFunctionInduction).restrictScalars ℤ).map_add
        (χ : H → ℂ) (ψ : H → ℂ)
    ext g
    exact congrFun h_add g
  map_smul' n χ := by
    have h_smul :=
      (((_root_.classFunctionSubspace G).subtype.comp H.classFunctionInduction).restrictScalars ℤ).map_smul
        n (χ : H → ℂ)
    ext g
    exact congrFun h_smul g

/-- Evaluating the subgroup induction map recovers the induced complex-valued class function. -/
@[simp] theorem characterRingInduction_apply (H : Subgroup G) (χ : R(H)) :
    ((H.characterRingInduction χ : R(G)) : G → ℂ) = Ind[H]((χ : H → ℂ)) :=
  rfl

end Subgroup

namespace Representation

/-- The canonical owner submodule of `R(G)` generated by the subgroup-induction maps
`R(H) → R(G)` for `H ∈ X`. -/
def artinInducedCharacterSubmodule (X : Finset (Subgroup G)) : Submodule ℤ (R(G)) :=
  ⨆ H : X, LinearMap.range (H.1.characterRingInduction)

/-- The `ℚ`-submodule of complex-valued functions on `G` generated by the ambient images of the
owner submodule `artinInducedCharacterSubmodule X ⊆ R(G)`. This is the bridge/view appearing in
Theorem `9-9.2-1`. -/
def artinInducedCharacterSpan (X : Finset (Subgroup G)) : Submodule ℚ (G → ℂ) :=
  Submodule.span ℚ
    (((↑) : R(G) → G → ℂ) '' (artinInducedCharacterSubmodule X : Set (R(G))))

/-- Helper for Theorem 9-9.2-1: a subgroup-induced virtual character from a member of `X`
already lies in the owner submodule generated by the induction ranges attached to `X`. -/
lemma characterRingInduction_mem_artinInducedCharacterSubmodule
    {X : Finset (Subgroup G)} {H : Subgroup G} (hH : H ∈ X) (χ : R(H)) :
    H.characterRingInduction χ ∈ artinInducedCharacterSubmodule X := by
  -- Route correction: future Artin-span arguments should first place generators in the owner
  -- submodule, and only then pass to the ambient `ℚ`-span in `G → ℂ`.
  exact
    (show LinearMap.range H.characterRingInduction ≤ artinInducedCharacterSubmodule X from
      le_iSup (fun K : X ↦ LinearMap.range K.1.characterRingInduction) ⟨H, hH⟩) ⟨χ, rfl⟩

/-- Helper for Theorem 9-9.2-1: every subgroup-induced virtual character from a member of `X`
belongs to the ambient Artin span in complex-valued functions on `G`. -/
lemma inducedClassFunction_mem_artinInducedCharacterSpan
    {X : Finset (Subgroup G)} {H : Subgroup G} (hH : H ∈ X) (χ : R(H)) :
    Ind[H]((χ : H → ℂ)) ∈ artinInducedCharacterSpan X := by
  -- Lift the induced class function to the owner submodule and then include it into the ambient
  -- `ℚ`-span defining `artinInducedCharacterSpan`.
  rw [artinInducedCharacterSpan]
  refine Submodule.subset_span ?_
  refine ⟨H.characterRingInduction χ,
    characterRingInduction_mem_artinInducedCharacterSubmodule hH χ, ?_⟩
  ext g
  simp [Subgroup.characterRingInduction_apply]

/-- Helper for Theorem 9-9.2-1: any finite sum of subgroup-induced character differences from the
family `X` belongs to the Artin span. -/
lemma sum_inducedCharacter_difference_mem_artinInducedCharacterSpan
    {X : Finset (Subgroup G)}
    (Vpos : (H : X) → FDRep ℂ H.1)
    (Vneg : (H : X) → FDRep ℂ H.1) :
    (∑ H : X,
      (Ind[H.1]((Vpos H).character) - Ind[H.1]((Vneg H).character))) ∈
        artinInducedCharacterSpan X := by
  -- Each summand is a difference of two owner generators, so the whole finite sum stays inside
  -- the same `ℚ`-submodule.
  refine Submodule.sum_mem _ ?_
  intro H hH
  exact Submodule.sub_mem _
    (inducedClassFunction_mem_artinInducedCharacterSpan (X := X) H.2
      ⟨(Vpos H).character, Representation.rep_character_mem_characterRing (Rep.of (Vpos H).ρ)⟩)
    (inducedClassFunction_mem_artinInducedCharacterSpan (X := X) H.2
      ⟨(Vneg H).character, Representation.rep_character_mem_characterRing (Rep.of (Vneg H).ρ)⟩)

/-- Helper for Theorem 9-9.2-1: if a positive multiple of a character is written as a finite sum
of induced character differences from `X`, then the character itself already lies in the Artin
span. -/
lemma character_mem_artinInducedCharacterSpan_of_multiple_eq_sum_inducedCharacter_differences
    {X : Finset (Subgroup G)} {V : FDRep ℂ G}
    (hV : ∃ d : ℕ+,
      ∃ Vpos : (H : X) → FDRep ℂ H.1,
        ∃ Vneg : (H : X) → FDRep ℂ H.1,
          (d : ℂ) • V.character =
            ∑ H : X,
              (Ind[H.1]((Vpos H).character) -
                Ind[H.1]((Vneg H).character))) :
    V.character ∈ artinInducedCharacterSpan X := by
  rcases hV with ⟨d, Vpos, Vneg, hd⟩
  have hsum :
      (∑ H : X,
        (Ind[H.1]((Vpos H).character) - Ind[H.1]((Vneg H).character))) ∈
          artinInducedCharacterSpan X :=
    sum_inducedCharacter_difference_mem_artinInducedCharacterSpan Vpos Vneg
  have hscaledC : (d : ℂ) • V.character ∈ artinInducedCharacterSpan X := by
    simpa [hd] using hsum
  have hscaled : (d : ℚ) • V.character ∈ artinInducedCharacterSpan X := by
    rw [show ((d : ℚ) • V.character : G → ℂ) = (d : ℂ) • V.character by
      ext g
      change (((d : ℚ) : ℂ) * V.character g) = (d : ℂ) • V.character g
      simp [smul_eq_mul]]
    exact hscaledC
  have hd_ne_zero : (d : ℚ) ≠ 0 := by
    exact_mod_cast d.ne_zero
  -- Divide by the nonzero positive integer inside the ambient `ℚ`-submodule.
  have hinv : ((d : ℚ)⁻¹ : ℚ) • ((d : ℚ) • V.character) ∈ artinInducedCharacterSpan X :=
    (artinInducedCharacterSpan X).smul_mem ((d : ℚ)⁻¹) hscaled
  simpa [smul_smul, hd_ne_zero] using hinv

/-- Helper for Theorem 9-9.2-1: every element of the Artin span is automatically a rationalized
virtual character of `G`. -/
lemma artinInducedCharacterSpan_le_characterRingScalarExtension
    (X : Finset (Subgroup G)) :
    artinInducedCharacterSpan X ≤ characterRingScalarExtension ℚ G := by
  -- The Artin span is generated by actual virtual characters of `G`, so each generator already
  -- lies in the ambient rational scalar extension.
  rw [artinInducedCharacterSpan]
  refine Submodule.span_le.mpr ?_
  intro f hf
  rcases hf with ⟨χ, -, rfl⟩
  exact mem_characterRingScalarExtension_of_mem_characterRing (χ : G → ℂ) χ.property

/-- Helper for Theorem 9-9.2-1: inducing a rationalized subgroup character from a member of `X`
still lands in the ambient Artin span on `G`. -/
lemma inducedClassFunction_mem_artinInducedCharacterSpan_of_mem_characterRingScalarExtension
    {X : Finset (Subgroup G)} {H : Subgroup G} (hH : H ∈ X)
    {χ : H → ℂ} (hχ : χ ∈ characterRingScalarExtension ℚ H) :
    Ind[H](χ) ∈ artinInducedCharacterSpan X := by
  -- Extend the inclusion from honest subgroup virtual characters to their ambient `ℚ`-span.
  induction hχ using Submodule.span_induction with
  | mem ψ hψ =>
      exact inducedClassFunction_mem_artinInducedCharacterSpan (X := X) hH ⟨ψ, hψ⟩
  | zero =>
      have hzero : Ind[H]((0 : H → ℂ)) = 0 := by
        ext g
        simp [Subgroup.inducedClassFunction]
      rw [hzero]
      exact Submodule.zero_mem (artinInducedCharacterSpan X)
  | add χ ψ _ _ hχ hψ =>
      simpa [Subgroup.inducedClassFunction_map_add] using
        Submodule.add_mem (artinInducedCharacterSpan X) hχ hψ
  | smul a χ _ hχ =>
      simpa [Subgroup.inducedClassFunction_map_smul] using
        (artinInducedCharacterSpan X).smul_mem a hχ

/-- Helper for Theorem 9-9.2-1: under a conjugacy cover, the cyclic summand attached to
any cyclic subgroup can be routed through one of the covering subgroups. -/
lemma induced_cyclicTheta_mem_artinInducedCharacterSpan_of_is_conjugacy_cover
    {X : Finset (Subgroup G)} (hcover : is_conjugacy_cover X)
    (C : Subgroup G) [IsCyclic C] :
    Ind[C]((theorem9921CyclicGroupTheta C : C → ℂ)) ∈ artinInducedCharacterSpan X := by
  classical
  obtain ⟨c, hcgen⟩ := IsCyclic.exists_generator (α := C)
  have hcgen_top : Subgroup.zpowers c = (⊤ : Subgroup C) :=
    (Subgroup.eq_top_iff' (Subgroup.zpowers c)).2 hcgen
  rcases (is_conjugacy_cover_iff X).1 hcover (c : G) with ⟨H, hHX, hcH⟩
  rcases Group.mem_conjugatesOfSet_iff.1 hcH with ⟨a, haH, hconj⟩
  rcases isConj_iff.1 hconj with ⟨s, hs⟩
  let L : Subgroup G := Subgroup.zpowers a
  have hL : L ≤ H := Subgroup.zpowers_le.2 haH
  letI : IsCyclic L := Subgroup.isCyclic_zpowers a
  letI : IsCyclic (L.subgroupOf H) := by
    rw [Subgroup.isCyclic_iff_exists_zpowers_eq_top]
    refine ⟨⟨a, haH⟩, ?_⟩
    rw [← Subgroup.map_subtype_inj]
    rw [MonoidHom.map_zpowers, Subgroup.subgroupOf_map_subtype]
    exact (inf_eq_left.mpr hL).symm
  let M : Subgroup G := (MulAut.conj s • L : Subgroup G)
  have hCeq : C = M := by
    have hmap : M = Subgroup.zpowers ((MulAut.conj s) a) := by
      dsimp [M, L]
      rw [show (MulAut.conj s • Subgroup.zpowers a : Subgroup G) =
          (Subgroup.zpowers a).map (MulAut.conj s).toMonoidHom by rfl]
      rw [MonoidHom.map_zpowers]
      simp [MulAut.conj_apply]
    have hsa : (MulAut.conj s) a = (c : G) := by
      simpa [MulAut.conj_apply] using hs
    have hzp : Subgroup.zpowers ((MulAut.conj s) a) = C := by
      rw [hsa]
      exact (theorem9921_subgroup_zpowers_eq_top_iff C c).1 hcgen_top
    exact (hmap.trans hzp).symm
  have hthetaM :
      (fun x : M =>
          (theorem9921CyclicGroupTheta L : L → ℂ)
            (((MulAut.conj s).subgroupMap L).symm x)) =
        (theorem9921CyclicGroupTheta M : M → ℂ) := by
    simpa [M] using
      (theorem9921_cyclicGroupTheta_comp_equiv_symm
        (A := L) (B := M) (K := ℂ) ((MulAut.conj s).subgroupMap L))
  have hconjInd :
      Ind[M]((theorem9921CyclicGroupTheta M : M → ℂ)) =
        Ind[L]((theorem9921CyclicGroupTheta L : L → ℂ)) := by
    rw [← hthetaM]
    exact
      Subgroup.theorem9921_inducedClassFunction_conjugate_eq L s
        (theorem9921CyclicGroupTheta L : L → ℂ)
  let inner : L.subgroupOf H → ℂ := fun z =>
    (theorem9921CyclicGroupTheta L : L → ℂ) ((Subgroup.subgroupOfEquivOfLe hL) z)
  have hinner_eq :
      inner = (theorem9921CyclicGroupTheta (L.subgroupOf H) : L.subgroupOf H → ℂ) := by
    simpa [inner] using
      (theorem9921_cyclicGroupTheta_comp_equiv_symm
        (A := L) (B := L.subgroupOf H) (K := ℂ)
        (Subgroup.subgroupOfEquivOfLe hL).symm)
  have hinnerR : inner ∈ R(L.subgroupOf H) := by
    rw [hinner_eq]
    exact theorem9921_cyclicGroupTheta_mem_characterRing (A := L.subgroupOf H)
  let innerχ : R(L.subgroupOf H) := ⟨inner, hinnerR⟩
  let ηH : R(H) :=
    ⟨Ind[L.subgroupOf H]((innerχ : L.subgroupOf H → ℂ)),
      Subgroup.inducedClassFunction_mem_characterRing (G := H) (L.subgroupOf H) innerχ⟩
  have hstage :
      Ind[H]((ηH : H → ℂ)) =
        Ind[L]((theorem9921CyclicGroupTheta L : L → ℂ)) := by
    simpa [ηH, innerχ, inner] using
      Subgroup.theorem9921_inducedClassFunction_subgroupOf_induction_in_stages
        H L hL (theorem9921CyclicGroupTheta L : L → ℂ)
  have hHmem : Ind[H]((ηH : H → ℂ)) ∈ artinInducedCharacterSpan X :=
    inducedClassFunction_mem_artinInducedCharacterSpan (X := X) hHX ηH
  have hLmem :
      Ind[L]((theorem9921CyclicGroupTheta L : L → ℂ)) ∈ artinInducedCharacterSpan X := by
    simpa [hstage] using hHmem
  have hMmem :
      Ind[M]((theorem9921CyclicGroupTheta M : M → ℂ)) ∈ artinInducedCharacterSpan X := by
    simpa [hconjInd] using hLmem
  rw [hCeq]
  exact hMmem

/-- Helper for Theorem 9-9.2-1: Serre's cyclic-subgroup identity puts the trivial character in
the Artin span attached to any conjugacy cover. -/
lemma one_mem_artinInducedCharacterSpan_of_is_conjugacy_cover
    {X : Finset (Subgroup G)} (hcover : is_conjugacy_cover X) :
    (1 : G → ℂ) ∈ artinInducedCharacterSpan X := by
  classical
  have hsum_mem :
      (∑ C ∈ Subgroup.theorem9921CyclicSubgroups G,
        Ind[C]((theorem9921CyclicGroupTheta C : C → ℂ))) ∈
        artinInducedCharacterSpan X := by
    refine Submodule.sum_mem (artinInducedCharacterSpan X) ?_
    intro C hC
    haveI : IsCyclic C := Subgroup.mem_theorem9921CyclicSubgroups.mp hC
    exact induced_cyclicTheta_mem_artinInducedCharacterSpan_of_is_conjugacy_cover
      (X := X) hcover C
  have hscaledC : (Nat.card G : ℂ) • (1 : G → ℂ) ∈ artinInducedCharacterSpan X := by
    simpa [theorem9921_sum_induced_cyclicGroupTheta_eq_groupOrder_smul_one (G := G) (K := ℂ)]
      using hsum_mem
  have hscaledQ : (Nat.card G : ℚ) • (1 : G → ℂ) ∈ artinInducedCharacterSpan X := by
    convert hscaledC using 1
  have hcard_ne : (Nat.card G : ℚ) ≠ 0 := by
    exact_mod_cast (Nat.card_pos : 0 < Nat.card G).ne'
  have hinv :
      ((Nat.card G : ℚ)⁻¹ : ℚ) • ((Nat.card G : ℚ) • (1 : G → ℂ)) ∈
        artinInducedCharacterSpan X :=
    (artinInducedCharacterSpan X).smul_mem ((Nat.card G : ℚ)⁻¹) hscaledQ
  simpa [smul_smul, hcard_ne] using hinv

/-- Helper for Theorem 9-9.2-1: if `g` is not conjugate into any subgroup from `X`, then every
element of the Artin span vanishes at `g`. -/
lemma artinInducedCharacterSpan_apply_eq_zero_of_not_mem_conjugatesOfSet
    {X : Finset (Subgroup G)} {g : G}
    (hmiss : ∀ H ∈ X, g ∉ Group.conjugatesOfSet (H : Set G))
    {f : G → ℂ} (hf : f ∈ artinInducedCharacterSpan X) :
    f g = 0 := by
  classical
  let evalAt : R(G) →ₗ[ℤ] ℂ :=
    { toFun := fun χ ↦ (χ : G → ℂ) g
      map_add' := by
        intro χ ψ
        simp
      map_smul' := by
        intro n χ
        simp }
  have howner_zero :
      ∀ {χ : R(G)}, χ ∈ artinInducedCharacterSubmodule X → (χ : G → ℂ) g = 0 := by
    intro χ hχ
    have hle :
        artinInducedCharacterSubmodule X ≤ LinearMap.ker evalAt := by
      rw [artinInducedCharacterSubmodule]
      refine iSup_le ?_
      intro H
      rintro z ⟨η, rfl⟩
      change Ind[H.1]((η : H.1 → ℂ)) g = 0
      have hnot : ∀ s : G, ¬ s⁻¹ * g * s ∈ H.1 := by
        intro s hs
        apply hmiss H.1 H.2
        exact Group.mem_conjugatesOfSet_iff.2
          ⟨s⁻¹ * g * s, hs, isConj_iff.2 ⟨s, by group⟩⟩
      simp [Subgroup.inducedClassFunction, hnot]
    exact show evalAt χ = 0 from hle hχ
  rw [artinInducedCharacterSpan] at hf
  -- Lift the owner-level vanishing statement to the ambient `ℚ`-span.
  induction hf using Submodule.span_induction with
  | mem ψ hψ =>
      rcases hψ with ⟨χ, hχ, rfl⟩
      exact howner_zero hχ
  | zero =>
      simp
  | add φ ψ _ _ hφ hψ =>
      simp [hφ, hψ]
  | smul a φ _ hφ =>
      simp [hφ]

/-- Helper for Theorem 9-9.2-1: a finite group admits a complete pairwise nonisomorphic family of
irreducible complex finite-dimensional representations. -/
private theorem exists_complete_pairwise_nonisomorphic_irreducible_family :
    ∃ (ι : Type) (_ : Fintype ι) (π : ι → FDRep ℂ G),
      PairwiseNonisomorphic π ∧ IsCompleteIrreducibleFamily π := by
  classical
  letI : NeZero (Nat.card G : ℂ) := ⟨by
    exact_mod_cast Nat.card_pos.ne'⟩
  obtain ⟨κ, _, σ, hσ_indep, hσ_top, hσ_irr⟩ :=
    exists_isInternal_irreducible_subrepresentations (ρ := leftRegular ℂ G)
  let hinternal : DirectSum.IsInternal (fun j ↦ (σ j).toSubmodule) :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hσ_indep hσ_top
  let r : Setoid κ :=
    { r := fun i j ↦ Nonempty ((σ i).toRepresentation.Equiv (σ j).toRepresentation)
      iseqv :=
        ⟨fun i ↦ ⟨Representation.Equiv.refl _⟩,
          fun {i j} hij ↦ by
            rcases hij with ⟨e⟩
            exact ⟨e.symm⟩,
          fun {i j l} hij hjl ↦ by
            rcases hij with ⟨eij⟩
            rcases hjl with ⟨ejl⟩
            exact ⟨eij.trans ejl⟩⟩ }
  let ι : Type := Quotient r
  letI : Finite ι := by
    refine Finite.of_surjective (fun i : κ ↦ (⟦i⟧ : ι)) ?_
    intro q
    exact ⟨Quotient.out q, Quotient.out_eq q⟩
  letI : Fintype ι := Fintype.ofFinite ι
  let π : ι → FDRep ℂ G := fun q ↦ FDRep.of ((σ (Quotient.out q)).toRepresentation)
  have hπ_pairwise : PairwiseNonisomorphic π := by
    -- Distinct quotient classes cannot label isomorphic regular summands.
    intro q q' hqq' hIso
    rcases hIso with ⟨e⟩
    have hclasses : (⟦Quotient.out q⟧ : ι) = (⟦Quotient.out q'⟧ : ι) := by
      apply Quotient.sound
      exact ⟨Representation.equivOfIso ((forget₂ (FDRep ℂ G) (Rep ℂ G)).mapIso e)⟩
    apply hqq'
    calc
      q = (⟦Quotient.out q⟧ : ι) := (Quotient.out_eq q).symm
      _ = (⟦Quotient.out q'⟧ : ι) := hclasses
      _ = q' := Quotient.out_eq q'
  have hπ_simple (q : ι) : Simple (π q) := by
    letI : Representation.IsIrreducible (π q).ρ := by
      simpa [π] using hσ_irr (Quotient.out q)
    exact FDRep.simple_of_isIrreducible (π q)
  let S : ι → Finset κ :=
    fun q ↦ Finset.univ.filter fun j ↦ Nonempty ((σ j).toRepresentation.Equiv (π q).ρ)
  let dimσ : κ → Nat := fun j ↦ Module.finrank ℂ (σ j).toSubmodule
  have hS_disjoint : Pairwise fun q q' ↦ Disjoint (S q) (S q') := by
    -- Distinct quotient classes cannot label the same regular summand.
    intro q q' hqq'
    refine Finset.disjoint_left.mpr fun j hj hj' ↦ ?_
    rcases (Finset.mem_filter.mp hj).2 with ⟨eqj⟩
    rcases (Finset.mem_filter.mp hj').2 with ⟨eqj'⟩
    exact hπ_pairwise hqq' <| ⟨(eqj.symm.trans eqj').toFDRepIso⟩
  have hS_card (q : ι) : (S q).card = Module.finrank ℂ (π q) := by
    -- Multiplicity of one irreducible class in the regular representation equals its degree.
    have hmult :
        Nat.card { j // Nonempty ((σ j).toRepresentation.Equiv (π q).ρ) } =
          Module.finrank ℂ (π q) := by
      letI : Representation.IsIrreducible (π q).ρ := by
        exact FDRep.isIrreducible_of_simple (π q)
      simpa using
        leftRegular_irreducible_multiplicity_eq_finrank σ hinternal hσ_irr (π q).ρ
          inferInstance
    have hcard :
        Fintype.card { j // Nonempty ((σ j).toRepresentation.Equiv (π q).ρ) } = (S q).card := by
      rw [show S q = Finset.univ.filter fun j ↦ Nonempty ((σ j).toRepresentation.Equiv (π q).ρ) by
        rfl]
      rw [Fintype.card_of_subtype
        (Finset.univ.filter fun j ↦ Nonempty ((σ j).toRepresentation.Equiv (π q).ρ))]
      intro j
      simp
    exact hcard.symm.trans <| by
      simpa [Nat.card_eq_fintype_card] using hmult
  have hS_sum (q : ι) : Finset.sum (S q) dimσ = Module.finrank ℂ (π q) ^ 2 := by
    -- Every regular summand inside one isomorphism class has the same degree.
    calc
      Finset.sum (S q) dimσ = Finset.sum (S q) (fun _j ↦ Module.finrank ℂ (π q)) := by
        refine Finset.sum_congr rfl fun j hj ↦ ?_
        rcases (Finset.mem_filter.mp hj).2 with ⟨e⟩
        exact e.toLinearEquiv.finrank_eq
      _ = (S q).card * Module.finrank ℂ (π q) := by
            simp
      _ = Module.finrank ℂ (π q) ^ 2 := by
            rw [hS_card, pow_two]
  have hcover : Finset.univ.biUnion S = (Finset.univ : Finset κ) := by
    -- Every regular summand belongs to the quotient class determined by its own label.
    apply Finset.ext
    intro j
    constructor
    · intro _
      simp
    · intro hj
      have hj_mem : j ∈ S (⟦j⟧ : ι) := by
        refine Finset.mem_filter.mpr ?_
        constructor
        · simp
        · rcases Quotient.exact (Quotient.out_eq (⟦j⟧ : ι)) with ⟨e⟩
          exact ⟨e.symm⟩
      exact Finset.mem_biUnion.mpr ⟨(⟦j⟧ : ι), Finset.mem_univ _, hj_mem⟩
  have htotal_eq_card : Finset.sum (Finset.univ : Finset κ) dimσ = Nat.card G := by
    -- Summing the dimensions of the internal regular decomposition recovers `|G|`.
    letI := DirectSum.IsInternal.chooseDecomposition (fun j ↦ (σ j).toSubmodule) hinternal
    letI : ∀ j : κ, Module.Free ℂ (σ j).toSubmodule := fun j ↦
      Module.Free.of_divisionRing ℂ (σ j).toSubmodule
    let e := (DirectSum.decomposeLinearEquiv (fun j ↦ (σ j).toSubmodule)).symm
    calc
      Finset.sum (Finset.univ : Finset κ) dimσ = Module.finrank ℂ (G →₀ ℂ) := by
        symm
        calc
          Module.finrank ℂ (G →₀ ℂ) = Module.finrank ℂ (DirectSum κ fun j ↦ (σ j).toSubmodule) := by
            exact e.finrank_eq.symm
          _ = Finset.sum (Finset.univ : Finset κ) dimσ := by
                simpa [dimσ] using
                  (Module.finrank_directSum (R := ℂ) (M := fun j ↦ (σ j).toSubmodule))
      _ = Nat.card G := by
            rw [Nat.card_eq_fintype_card]
            exact Module.finrank_finsupp_self ℂ
  have hπ_sum : ∑ q : ι, Module.finrank ℂ (π q) ^ 2 = Nat.card G := by
    -- The quotient classes partition the regular summands, so the square-degree sum is `|G|`.
    calc
      ∑ q : ι, Module.finrank ℂ (π q) ^ 2 = ∑ q : ι, Finset.sum (S q) dimσ := by
        refine Finset.sum_congr rfl fun q _ ↦ (hS_sum q).symm
      _ = Finset.sum (Finset.univ.biUnion S) dimσ := by
            symm
            exact Finset.sum_biUnion fun q _ q' _ hqq' ↦ hS_disjoint hqq'
      _ = Finset.sum (Finset.univ : Finset κ) dimσ := by
            rw [hcover]
      _ = Nat.card G := htotal_eq_card
  have hπ_complete : IsCompleteIrreducibleFamily π := by
    -- The square-degree criterion upgrades the quotient family to completeness.
    exact isCompleteIrreducibleFamily_of_sum_sq_degree_eq_card π hπ_simple hπ_pairwise hπ_sum
  exact ⟨ι, inferInstance, π, hπ_pairwise, hπ_complete⟩

/-- Helper for Theorem 9-9.2-1: a finite sum of honest characters is again the character of an
honest finite-dimensional representation. -/
private theorem exists_fdRep_with_character_eq_sum
    {ι : Type*} (s : Finset ι) (π : ι → FDRep ℂ G) :
    ∃ τ : FDRep ℂ G, τ.character = s.sum fun i ↦ (π i).character := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      refine ⟨FDRep.of (Representation.trivial ℂ G (Fin 0 → ℂ)), ?_⟩
      -- The zero-dimensional trivial representation has zero character everywhere.
      ext g
      simp [FDRep.character, Representation.trivial]
  | insert i s hi ih =>
      rcases ih with ⟨τ, hτ⟩
      refine ⟨FDRep.of (Representation.prod (π i).ρ τ.ρ), ?_⟩
      -- Add one summand by using the direct-sum character formula.
      calc
        (FDRep.of (Representation.prod (π i).ρ τ.ρ)).character =
            (Representation.prod (π i).ρ τ.ρ).character := rfl
        _ = Representation.character (π i).ρ + Representation.character τ.ρ := by
            exact Representation.char_prod (π i).ρ τ.ρ
        _ = (π i).character + τ.character := rfl
        _ = (π i).character + s.sum (fun j ↦ (π j).character) := by
            rw [hτ]
        _ = (insert i s).sum (fun j ↦ (π j).character) := by
            rw [Finset.sum_insert hi]

/-- Helper for Theorem 9-9.2-1: a finite nonnegative integral combination of honest characters is
again the character of an honest finite-dimensional representation. -/
private theorem exists_fdRep_with_character_eq_repr_sum
    {ι : Type*} [Fintype ι]
    (π : ι → FDRep ℂ G) (c : ι → ℤ) (hc : ∀ i, 0 ≤ c i) :
    ∃ τ : FDRep ℂ G, τ.character = ∑ i, c i • (π i).character := by
  let n : ι → ℕ := fun i ↦ Int.toNat (c i)
  let π' : (Σ i, Fin (n i)) → FDRep ℂ G := fun j ↦ π j.1
  obtain ⟨τ, hτ⟩ :=
    exists_fdRep_with_character_eq_sum (s := Finset.univ) π'
  refine ⟨τ, ?_⟩
  -- Replicate the `i`th summand exactly `c i` times and collapse the sigma-indexed sum.
  calc
    τ.character = ∑ j : Σ i, Fin (n i), (π' j).character := hτ
    _ = ∑ i, ∑ _ : Fin (n i), (π i).character := by
          simpa [π'] using
            (Fintype.sum_sigma (fun j : Σ i, Fin (n i) ↦ (π' j).character))
    _ = ∑ i, n i • (π i).character := by
          refine Finset.sum_congr rfl ?_
          intro i _
          simp [n]
    _ = ∑ i, c i • (π i).character := by
          refine Finset.sum_congr rfl ?_
          intro i _
          rw [show c i = Int.ofNat (n i) by
            simpa [n] using (Int.toNat_of_nonneg (hc i)).symm]
          simp

/-- Helper for Theorem 9-9.2-1: every virtual character is the difference of two honest
characters. -/
lemma virtual_character_eq_character_difference
    (H : Subgroup G) (χ : R(H)) :
    ∃ Vpos Vneg : FDRep ℂ H,
      (χ : H → ℂ) = Vpos.character - Vneg.character := by
  classical
  obtain ⟨ι, _, π, hπ_pairwise, hπ_complete⟩ :=
    exists_complete_pairwise_nonisomorphic_irreducible_family (G := H)
  let b := irreducible_characters_basis_of_complete_family ℂ π hπ_pairwise hπ_complete
  let c : ι → ℤ := b.repr χ
  let cpos : ι → ℤ := fun i ↦ Int.toNat (c i)
  let cneg : ι → ℤ := fun i ↦ Int.toNat (-c i)
  have hcpos : ∀ i, 0 ≤ cpos i := by
    intro i
    change 0 ≤ (Int.toNat (c i) : ℤ)
    exact_mod_cast Nat.zero_le (Int.toNat (c i))
  have hcneg : ∀ i, 0 ≤ cneg i := by
    intro i
    change 0 ≤ (Int.toNat (-c i) : ℤ)
    exact_mod_cast Nat.zero_le (Int.toNat (-c i))
  obtain ⟨Vpos, hVpos⟩ := exists_fdRep_with_character_eq_repr_sum (π := π) cpos hcpos
  obtain ⟨Vneg, hVneg⟩ := exists_fdRep_with_character_eq_repr_sum (π := π) cneg hcneg
  have hχ_expand :
      ∑ i, c i • (π i).character = (χ : H → ℂ) := by
    -- Rewrite the irreducible-basis expansion of `χ` in the ambient function space on `H`.
    simpa [b, c, irreducible_characters_basis_of_complete_family_apply,
      FDRep.irreducibleCharacter_apply] using
      congrArg (fun z : R(H) ↦ (z : H → ℂ)) (b.sum_repr χ)
  have hsplit :
      ∑ i, c i • (π i).character =
        (∑ i, cpos i • (π i).character) - (∑ i, cneg i • (π i).character) := by
    -- Split each integral coefficient into its positive and negative parts.
    calc
      ∑ i, c i • (π i).character =
          ∑ i, (cpos i - cneg i) • (π i).character := by
            refine Finset.sum_congr rfl ?_
            intro i _
            have hi : c i = cpos i - cneg i := by
              dsimp [c, cpos, cneg]
              omega
            rw [hi]
      _ = ∑ i, (cpos i • (π i).character - cneg i • (π i).character) := by
            refine Finset.sum_congr rfl ?_
            intro i _
            ext h
            simp [zsmul_eq_mul, sub_eq_add_neg, add_mul]
      _ = (∑ i, cpos i • (π i).character) - (∑ i, cneg i • (π i).character) := by
            simp only [Finset.sum_sub_distrib]
  refine ⟨Vpos, Vneg, ?_⟩
  -- Replace the two nonnegative coefficient sums by the characters they realize.
  calc
    (χ : H → ℂ) = ∑ i, c i • (π i).character := hχ_expand.symm
    _ = (∑ i, cpos i • (π i).character) - (∑ i, cneg i • (π i).character) := hsplit
    _ = Vpos.character - (∑ i, cneg i • (π i).character) := by rw [hVpos]
    _ = Vpos.character - Vneg.character := by rw [hVneg]

/-- Helper for Theorem 9-9.2-1: if every honest character already lies in the Artin span, then so
does every integral virtual character. -/
lemma characterRing_mem_artinInducedCharacterSpan_of_honest
    {X : Finset (Subgroup G)}
    (hhonest : ∀ V : FDRep ℂ G, V.character ∈ artinInducedCharacterSpan X)
    (χ : R(G)) :
    (χ : G → ℂ) ∈ artinInducedCharacterSpan X := by
  let S : Set (G → ℂ) :=
    { ψ : G → ℂ |
        ∃ (V : Type _) (_ : AddCommGroup V) (_ : Module ℂ V)
          (_ : FiniteDimensional ℂ V) (ρ : Representation ℂ G V), ψ = ρ.character }
  have hmul_span :
      ∀ {f g : G → ℂ},
        f ∈ Submodule.span ℤ S →
        g ∈ Submodule.span ℤ S →
        f * g ∈ Submodule.span ℤ S := by
    intro f g hf hg
    have hfg : ∀ g : G → ℂ, g ∈ Submodule.span ℤ S → f * g ∈ Submodule.span ℤ S := by
      induction hf using Submodule.span_induction with
      | mem ψ hψ =>
          rcases hψ with ⟨V, _instAddCommGroupV, _instModuleV, _instFiniteDimensionalV, ρ, rfl⟩
          intro g hg
          induction hg using Submodule.span_induction with
          | mem ξ hξ =>
              rcases hξ with ⟨W, _instAddCommGroupW, _instModuleW, _instFiniteDimensionalW, σ, rfl⟩
              let τ : Representation ℂ G (TensorProduct ℂ V W) := Representation.tprod ρ σ
              refine Submodule.subset_span ?_
              refine ⟨TensorProduct ℂ V W, inferInstance, inferInstance, inferInstance, τ, ?_⟩
              ext x
              -- Products of honest characters are tensor-product characters.
              simpa [τ, Representation.character] using
                (LinearMap.trace_tensorProduct' (ρ x) (σ x)).symm
          | zero =>
              simpa using
                (Submodule.zero_mem (Submodule.span ℤ S) : (0 : G → ℂ) ∈ Submodule.span ℤ S)
          | add ξ ζ _ _ hξ hζ =>
              simpa [mul_add] using Submodule.add_mem (Submodule.span ℤ S) hξ hζ
          | smul n ξ _ hξ =>
              simpa [zsmul_eq_mul, mul_assoc, mul_left_comm, mul_comm] using
                Submodule.smul_mem (Submodule.span ℤ S) n hξ
      | zero =>
          intro g hg
          simpa using
            (Submodule.zero_mem (Submodule.span ℤ S) : (0 : G → ℂ) ∈ Submodule.span ℤ S)
      | add f₁ f₂ _ _ hf₁ hf₂ =>
          intro g hg
          simpa [add_mul] using
            Submodule.add_mem (Submodule.span ℤ S) (hf₁ g hg) (hf₂ g hg)
      | smul n f _ hf =>
          intro g hg
          simpa [zsmul_eq_mul, mul_left_comm, mul_assoc] using
            Submodule.smul_mem (Submodule.span ℤ S) n (hf g hg)
    exact hfg g hg
  have hχ_span :
      ((χ : R(G)) : G → ℂ) ∈ Submodule.span ℤ S := by
    -- The integral character ring is the `ℤ`-algebra generated by honest irreducible characters.
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ χ.2
    · intro ψ hψ
      rcases hψ with ⟨ρ, hρfd, _hρirr, rfl⟩
      exact Submodule.subset_span ⟨ρ, inferInstance, inferInstance, hρfd, ρ.ρ, rfl⟩
    · intro n
      have htriv :
          (Representation.trivial ℂ G (ULift ℂ)).character ∈ S := by
        refine ⟨ULift ℂ, inferInstance, inferInstance, inferInstance,
          Representation.trivial ℂ G (ULift ℂ), ?_⟩
        rfl
      have hscalar :
          algebraMap ℤ (G → ℂ) n = n • (Representation.trivial ℂ G (ULift ℂ)).character := by
        ext g
        simp [Representation.character, Representation.trivial]
      rw [hscalar]
      exact Submodule.smul_mem (Submodule.span ℤ S) n (Submodule.subset_span htriv)
    · intro f g _ _ hf hg
      exact Submodule.add_mem (Submodule.span ℤ S) hf hg
    · intro f g _ _ hf hg
      exact hmul_span hf hg
  have hspan_le :
      Submodule.span ℤ S ≤ (artinInducedCharacterSpan X).restrictScalars ℤ := by
    refine Submodule.span_le.2 ?_
    intro ψ hψ
    rcases hψ with ⟨V, _instAddCommGroupV, _instModuleV, _instFiniteDimensionalV, ρ, rfl⟩
    exact hhonest (FDRep.of ρ)
  exact hspan_le hχ_span

/-- Helper for Theorem 9-9.2-1: if every honest character of `G` lies in the Artin span, then the
entire rationalized character ring does as well. -/
lemma characterRingScalarExtension_le_artinInducedCharacterSpan_of_honest
    {X : Finset (Subgroup G)}
    (hhonest : ∀ V : FDRep ℂ G, V.character ∈ artinInducedCharacterSpan X) :
    characterRingScalarExtension ℚ G ≤ artinInducedCharacterSpan X := by
  -- Once every integral virtual character lies in the Artin span, the ambient `ℚ`-span does too.
  rw [characterRingScalarExtension]
  refine Submodule.span_le.2 ?_
  intro χ hχ
  exact characterRing_mem_artinInducedCharacterSpan_of_honest (X := X) hhonest ⟨χ, hχ⟩

/-- Helper for Theorem 9-9.2-1: every owner-level Artin-induced virtual character can be written
as a single finite family of subgroup inductions indexed by `X`. -/
lemma exists_family_characterRingInduction_eq_of_mem_artinInducedCharacterSubmodule
    {X : Finset (Subgroup G)} {χ : R(G)}
    (hχ : χ ∈ artinInducedCharacterSubmodule X) :
    ∃ ξ : (H : X) → R(H.1),
      χ = ∑ H : X, H.1.characterRingInduction (ξ H) := by
  classical
  let sumInductionMap : ((H : X) → R(H.1)) →ₗ[ℤ] R(G) :=
    { toFun := fun ξ : (H : X) → R(H.1) ↦ ∑ H : X, H.1.characterRingInduction (ξ H)
      map_add' := by
        intro ξ η
        -- The total induction map is pointwise additive in the subgroup family.
        calc
          ∑ H : X, H.1.characterRingInduction ((ξ + η) H)
              = ∑ H : X, (H.1.characterRingInduction (ξ H) +
                  H.1.characterRingInduction (η H)) := by
                    refine Finset.sum_congr rfl ?_
                    intro H _
                    simp
          _ = ∑ H : X, H.1.characterRingInduction (ξ H) +
                ∑ H : X, H.1.characterRingInduction (η H) := by
                  simp [Finset.sum_add_distrib]
      map_smul' := by
        intro n ξ
        -- Integer scalars distribute termwise across the finite induction sum.
        calc
          ∑ H : X, H.1.characterRingInduction ((n • ξ) H)
              = ∑ H : X, n • H.1.characterRingInduction (ξ H) := by
                  refine Finset.sum_congr rfl ?_
                  intro H _
                  simpa using H.1.characterRingInduction.map_smul n (ξ H)
          _ = n • ∑ H : X, H.1.characterRingInduction (ξ H) := by
                simpa using
                  (Finset.sum_zsmul
                    (f := fun H : X ↦ H.1.characterRingInduction (ξ H))
                    (s := Finset.univ) n) }
  have hrange :
      artinInducedCharacterSubmodule X ≤ LinearMap.range sumInductionMap := by
    -- Each generator range lands in the total map via the corresponding dependent `Pi.single`.
    rw [artinInducedCharacterSubmodule]
    refine iSup_le ?_
    intro H
    rintro z ⟨η, rfl⟩
    refine ⟨Pi.single H η, ?_⟩
    have hsingle :
        sumInductionMap (Pi.single H η) = H.1.characterRingInduction η := by
      dsimp [sumInductionMap]
      rw [Finset.sum_eq_single H]
      · simp
      · intro K _ hK
        simp [Pi.single, hK]
      · intro hH
        exact False.elim (hH (by simp))
    exact hsingle
  rcases hrange hχ with ⟨ξ, hξ⟩
  change (∑ H : X, H.1.characterRingInduction (ξ H)) = χ at hξ
  exact ⟨ξ, hξ.symm⟩

/-- Helper for Theorem 9-9.2-1: every element of the ambient Artin span can be written, after
clearing finitely many rational denominators, as a single finite sum of subgroup-induction terms
indexed by the family `X`. -/
lemma exists_multiple_eq_sum_characterRingInduction_of_mem_artinInducedCharacterSpan
    {X : Finset (Subgroup G)} {φ : G → ℂ}
    (hφ : φ ∈ artinInducedCharacterSpan X) :
    ∃ d : ℕ+, ∃ ξ : (H : X) → R(H.1),
      (d : ℂ) • φ = ∑ H : X, (((H.1.characterRingInduction (ξ H) : R(G)) : G → ℂ)) := by
  classical
  rw [artinInducedCharacterSpan] at hφ
  obtain ⟨s, hs, hspan⟩ := Submodule.mem_span_finite_of_mem_span hφ
  rcases (Submodule.mem_span_finset'.1 hspan) with ⟨c, hc⟩
  choose χ hχmem hχeq using fun a : s => hs a.2
  choose η hη using fun a : s =>
    exists_family_characterRingInduction_eq_of_mem_artinInducedCharacterSubmodule (hχmem a)
  let dNat : ℕ := ∏ a : s, Rat.den (c a)
  have hdNat_pos : 0 < dNat := by
    refine Nat.pos_of_ne_zero ?_
    refine Finset.prod_ne_zero_iff.mpr ?_
    intro a ha
    exact Rat.den_nz (c a)
  let d : ℕ+ := ⟨dNat, hdNat_pos⟩
  let m : s → ℤ := fun a ↦ ((dNat / Rat.den (c a) : ℕ) : ℤ) * Rat.num (c a)
  have hm : ∀ a : s, ((dNat : ℚ) * c a) = (m a : ℚ) := by
    intro a
    rcases Finset.dvd_prod_of_mem (fun b : s ↦ Rat.den (c b)) (Finset.mem_univ a) with ⟨k, hk⟩
    have hkdiv : dNat / Rat.den (c a) = k := by
      simpa [show dNat = Rat.den (c a) * k from hk, Nat.mul_comm] using
        (Nat.mul_div_right k (Rat.den (c a)))
    dsimp [m]
    calc
      ((dNat : ℚ) * c a)
          = ((((Rat.den (c a) : ℕ) : ℚ) * (k : ℚ)) * c a) := by
              rw [show dNat = Rat.den (c a) * k from hk, Nat.cast_mul]
      _ = (k : ℚ) * ((((Rat.den (c a) : ℕ) : ℚ) * c a)) := by ring
      _ = (k : ℚ) * Rat.num (c a) := by
            have hden : ((((Rat.den (c a) : ℕ) : ℚ) * c a)) = Rat.num (c a) := by
              simpa [mul_comm] using Rat.mul_den_eq_num (c a)
            rw [hden]
      _ = ((((k : ℕ) : ℤ) * Rat.num (c a) : ℤ) : ℚ) := by
            simp [Int.cast_mul]
      _ = (m a : ℚ) := by
            change ((((k : ℤ) * Rat.num (c a) : ℤ) : ℚ) =
              ((((dNat / Rat.den (c a) : ℕ) : ℤ) * Rat.num (c a) : ℤ) : ℚ))
            rw [hkdiv]
  let χsum : R(G) := ∑ a : s, m a • χ a
  have hscaledQ :
      (dNat : ℚ) • φ = ∑ a : s, (m a : ℚ) • (((χ a : R(G)) : G → ℂ)) := by
    calc
      (dNat : ℚ) • φ = (dNat : ℚ) • ∑ a : s, c a • a.1 := by
            rw [← hc]
      _ = ∑ a : s, ((dNat : ℚ) * c a) • a.1 := by
            simp [Finset.smul_sum, smul_smul]
      _ = ∑ a : s, (m a : ℚ) • (((χ a : R(G)) : G → ℂ)) := by
            refine Finset.sum_congr rfl ?_
            intro a ha
            rw [hm a, hχeq a]
  have hχsum :
      (d : ℂ) • φ = ((χsum : R(G)) : G → ℂ) := by
    -- Evaluate the rational-scalar identity pointwise and rewrite the integral coefficients as a
    -- character-ring linear combination.
    ext g
    have hscaledQg := congrFun hscaledQ g
    simpa [χsum, smul_eq_mul, zsmul_eq_mul] using hscaledQg
  let ξ : (H : X) → R(H.1) := fun H ↦ ∑ a : s, m a • η a H
  have howner :
      χsum = ∑ H : X, H.1.characterRingInduction (ξ H) := by
    -- First rewrite each owner summand using the chosen family decomposition, then commute the
    -- two finite sums and repackage the inner subgroup sum.
    calc
      χsum = ∑ a : s, m a • χ a := by
        simp [χsum]
      _ = ∑ a : s, m a • ∑ H : X, H.1.characterRingInduction (η a H) := by
            refine Finset.sum_congr rfl ?_
            intro a ha
            rw [hη a]
      _ = ∑ a : s, ∑ H : X, H.1.characterRingInduction (m a • η a H) := by
            refine Finset.sum_congr rfl ?_
            intro a ha
            calc
              m a • ∑ H : X, H.1.characterRingInduction (η a H)
                  = ∑ H : X, m a • H.1.characterRingInduction (η a H) := by
                      symm
                      simpa using
                        (Finset.sum_zsmul
                          (f := fun H : X ↦ H.1.characterRingInduction (η a H))
                          (s := Finset.univ) (m a))
              _ = ∑ H : X, H.1.characterRingInduction (m a • η a H) := by
                    refine Finset.sum_congr rfl ?_
                    intro H hH
                    simpa using (H.1.characterRingInduction.map_smul (m a) (η a H)).symm
      _ = ∑ H : X, ∑ a : s, H.1.characterRingInduction (m a • η a H) := by
            rw [Finset.sum_comm]
      _ = ∑ H : X, H.1.characterRingInduction (ξ H) := by
            refine Finset.sum_congr rfl ?_
            intro H hH
            simp [ξ]
  refine ⟨d, ξ, ?_⟩
  -- Coerce the owner-level induction identity to complex-valued functions on `G`.
  calc
    (d : ℂ) • φ = ((χsum : R(G)) : G → ℂ) := hχsum
    _ = ∑ H : X, (((H.1.characterRingInduction (ξ H) : R(G)) : G → ℂ)) := by
          simpa using congrArg (fun z : R(G) ↦ (z : G → ℂ)) howner

end Representation

end

section

variable {G : Type} [Group G] [Finite G]

/-- Local finite-type witness for the second finite-group section of Theorem 9-9.2-1. -/
local instance instFintypeGroupSectionTwo : Fintype G := Fintype.ofFinite G

/-- Helper for Theorem 9-9.2-1: if the rationalized character ring equals the Artin span attached
to `X`, then `X` is already a conjugacy cover. -/
theorem is_conjugacy_cover_of_characterRingScalarExtension_eq_artinInducedCharacterSpan
    (X : Finset (Subgroup G))
    (hspan : characterRingScalarExtension ℚ G = artinInducedCharacterSpan X) :
    is_conjugacy_cover X := by
  rw [is_conjugacy_cover_iff]
  intro g
  by_contra hnot
  have hmiss : ∀ H ∈ X, g ∉ Group.conjugatesOfSet (H : Set G) := by
    simpa using hnot
  have hOneW : (1 : G → ℂ) ∈ characterRingScalarExtension ℚ G :=
    mem_characterRingScalarExtension_of_mem_characterRing (A := ℚ) (1 : G → ℂ)
      ((1 : R(G)).property)
  have hOneS : (1 : G → ℂ) ∈ artinInducedCharacterSpan X := by
    simpa [hspan] using hOneW
  have hOne_zero : (1 : G → ℂ) g = 0 :=
    Representation.artinInducedCharacterSpan_apply_eq_zero_of_not_mem_conjugatesOfSet
      (X := X) (g := g) hmiss hOneS
  have hOne_eval : (1 : G → ℂ) g = 1 := by
    simp
  have hcontr : (1 : ℂ) = 0 := by
    simpa [hOne_eval] using hOne_zero
  exact one_ne_zero hcontr

/-- Helper for Theorem 9-9.2-1: restricting an honest character to a subgroup still lands in the
subgroup rationalized character ring. -/
lemma subgroup_character_restriction_mem_characterRingScalarExtension
    (H : Subgroup G) (V : FDRep ℂ G) :
    (fun h : H ↦ V.character h.1) ∈ characterRingScalarExtension ℚ H := by
  -- Restrict the honest representation itself along `H.subtype`; its character is the pointwise
  -- restriction of `V.character`.
  have hres : (fun h : H ↦ V.character h.1) ∈ R(H) := by
    simpa using
      (Representation.rep_character_mem_characterRing (Rep.res H.subtype (Rep.of V.ρ)))
  exact Representation.mem_characterRingScalarExtension_of_mem_characterRing _ hres

/-- Helper for Theorem 9-9.2-1: the Artin span is stable under pointwise multiplication
by any honest character of `G`. -/
lemma artinInducedCharacterSpan_mul_fdRepCharacter_mem
    {X : Finset (Subgroup G)} {f : G → ℂ} (hf : f ∈ artinInducedCharacterSpan X)
    (V : FDRep ℂ G) :
    f * V.character ∈ artinInducedCharacterSpan X := by
  classical
  let φ : classFunctionSubmodule ℂ G :=
    ⟨V.character, by
      refine (mem_classFunctionSubmodule_iff ℂ _).2 ?_
      refine ⟨fun {x y} hxy => ?_⟩
      rcases isConj_iff.1 (ConjClasses.mk_eq_mk_iff_isConj.mp hxy) with ⟨a, ha⟩
      rw [← ha]
      exact (V.char_conj x a).symm⟩
  have howner_mul :
      ∀ {χ : R(G)}, χ ∈ artinInducedCharacterSubmodule X →
        ((χ : G → ℂ) * V.character) ∈ artinInducedCharacterSpan X := by
    intro χ hχ
    rw [artinInducedCharacterSubmodule] at hχ
    refine Submodule.iSup_induction
      (p := fun H : X => LinearMap.range H.1.characterRingInduction)
      (motive := fun χ : R(G) =>
        ((χ : G → ℂ) * V.character) ∈ artinInducedCharacterSpan X)
      hχ ?_ ?_ ?_
    · intro H χ hχ
      rcases hχ with ⟨η, rfl⟩
      have hη :
          ((η : R(H.1)) : H.1 → ℂ) ∈ characterRingScalarExtension ℚ H.1 :=
        mem_characterRingScalarExtension_of_mem_characterRing (A := ℚ)
          ((η : R(H.1)) : H.1 → ℂ) η.property
      have hres :
          (H.1.classFunctionRestriction φ : H.1 → ℂ) ∈
            characterRingScalarExtension ℚ H.1 := by
        simpa [φ, Subgroup.classFunctionRestriction_apply] using
          subgroup_character_restriction_mem_characterRingScalarExtension H.1 V
      have hmul :
          (fun h : H.1 =>
            ((η : R(H.1)) : H.1 → ℂ) h *
              (H.1.classFunctionRestriction φ : H.1 → ℂ) h) ∈
            characterRingScalarExtension ℚ H.1 := by
        simpa [Pi.mul_apply] using mul_mem_characterRingScalarExtension hη hres
      have hind :
          Ind[H.1](fun h : H.1 =>
            ((η : R(H.1)) : H.1 → ℂ) h *
              (H.1.classFunctionRestriction φ : H.1 → ℂ) h) ∈
            artinInducedCharacterSpan X :=
        inducedClassFunction_mem_artinInducedCharacterSpan_of_mem_characterRingScalarExtension
          (X := X) H.2 hmul
      rw [Subgroup.characterRingInduction_apply]
      rw [show V.character = (φ : G → ℂ) by rfl]
      rw [induced_mul_eq_induced_mul_classFunctionRestriction H.1
        ((η : R(H.1)) : H.1 → ℂ) φ]
      exact hind
    · simpa using (zero_mem (artinInducedCharacterSpan X) :
        (0 : G → ℂ) ∈ artinInducedCharacterSpan X)
    · intro χ ψ hχ hψ
      simpa [Pi.mul_apply, add_mul] using
        (artinInducedCharacterSpan X).add_mem hχ hψ
  rw [artinInducedCharacterSpan] at hf
  induction hf using Submodule.span_induction with
  | mem ψ hψ =>
      rcases hψ with ⟨χ, hχ, rfl⟩
      exact howner_mul hχ
  | zero =>
      simpa using (zero_mem (artinInducedCharacterSpan X) :
        (0 : G → ℂ) ∈ artinInducedCharacterSpan X)
  | add f g _ _ hf hg =>
      simpa [Pi.mul_apply, add_mul] using
        (artinInducedCharacterSpan X).add_mem hf hg
  | smul a f _ hf =>
      simpa [Pi.smul_apply, smul_eq_mul, mul_assoc] using
        (artinInducedCharacterSpan X).smul_mem a hf

/-- Helper for Theorem 9-9.2-1: fixing a conjugator from `x` to `y` identifies the fiber
`{s | s⁻¹ * x * s = y}` with the ambient centralizer of `x`. -/
noncomputable def conjugator_fiber_equiv_centralizer
    (x y t : G) (ht : t⁻¹ * x * t = y) :
    {s : G // s⁻¹ * x * s = y} ≃ Subgroup.centralizer ({x} : Set G) where
  toFun s := by
    -- Rewrite the defining equation of the fiber into a centralizer relation for `t * s⁻¹`.
    refine ⟨t * s.1⁻¹, ?_⟩
    rw [Subgroup.mem_centralizer_singleton_iff]
    calc
      (t * s.1⁻¹) * x = t * (s.1⁻¹ * x * s.1) * s.1⁻¹ := by
        group
      _ = t * (t⁻¹ * x * t) * s.1⁻¹ := by
        rw [s.2, ht]
      _ = x * (t * s.1⁻¹) := by
        group
  invFun c := by
    -- Conversely, any ambient centralizer element transports the fixed conjugator back to the
    -- required fiber.
    refine ⟨c.1⁻¹ * t, ?_⟩
    have hc : (c : G) * x = x * c :=
      Subgroup.mem_centralizer_singleton_iff.mp c.2
    calc
      (c.1⁻¹ * t)⁻¹ * x * (c.1⁻¹ * t) = t⁻¹ * (c.1 * x * c.1⁻¹) * t := by
        group
      _ = t⁻¹ * x * t := by
        rw [hc]
        group
      _ = y := ht
  left_inv s := by
    apply Subtype.ext
    simp
  right_inv c := by
    apply Subtype.ext
    simp

/-- Helper for Theorem 9-9.2-1: if `x` and `y` are ambiently conjugate, then the conjugator
fiber over `y` has the cardinality of the ambient centralizer of `x`. -/
noncomputable def conjugator_fiber_equiv_centralizer_of_mk_eq
    (x y : G) (hxy : ConjClasses.mk x = ConjClasses.mk y) :
    {s : G // s⁻¹ * x * s = y} ≃ Subgroup.centralizer ({x} : Set G) := by
  let t : G := Classical.choose (isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hxy))
  have ht : t * x * t⁻¹ = y :=
    Classical.choose_spec (isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hxy))
  have ht' : (t⁻¹)⁻¹ * x * t⁻¹ = y := by
    simpa using ht
  exact conjugator_fiber_equiv_centralizer x y t⁻¹ ht'

/-- Helper for Theorem 9-9.2-1: conjugacy inside a subgroup remains conjugacy after coercing to
the ambient group. -/
lemma subgroup_conjclass_eq_ambient {H : Subgroup G} {h y : H}
    (hy : ConjClasses.mk y = ConjClasses.mk h) :
    ConjClasses.mk ((y : H) : G) = ConjClasses.mk ((h : H) : G) := by
  -- Promote the subgroup conjugator to the ambient group without changing the conjugation
  -- equation.
  rcases isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hy) with ⟨u, hu⟩
  apply ConjClasses.mk_eq_mk_iff_isConj.mpr
  refine isConj_iff.mpr ⟨(u : G), ?_⟩
  exact congrArg (fun z : H ↦ ((z : H) : G)) hu

/-- Helper for Theorem 9-9.2-1: the localized conjugator set over the `H`-class of `h`
decomposes into exact fibers indexed by that subgroup conjugacy class. -/
noncomputable def localized_conjugator_sigma_map
    (H : Subgroup G) (h : H) (x : G) :
    {s : G // ∃ hs : s⁻¹ * x * s ∈ H, ConjClasses.mk ⟨s⁻¹ * x * s, hs⟩ = ConjClasses.mk h} →
      Σ y : (ConjClasses.mk h).carrier, {s : G // s⁻¹ * x * s = ((y.1 : H) : G)} := by
  intro s
  let hs : s.1⁻¹ * x * s.1 ∈ H := Classical.choose s.2
  let hmk : ConjClasses.mk ⟨s.1⁻¹ * x * s.1, hs⟩ = ConjClasses.mk h :=
    Classical.choose_spec s.2
  -- The image remembers the subgroup conjugacy-class point and the exact ambient conjugator.
  refine
    ⟨⟨⟨s.1⁻¹ * x * s.1, hs⟩, by
        simp [ConjClasses.mem_carrier_iff_mk_eq, hmk]⟩, ⟨s.1, rfl⟩⟩

/-- Helper for Theorem 9-9.2-1: the sigma decomposition of the localized conjugator set is
injective because the second component remembers the original ambient conjugator. -/
lemma localized_conjugator_sigma_map_injective
    (H : Subgroup G) (h : H) (x : G) :
    Function.Injective (localized_conjugator_sigma_map H h x) := by
  intro s t hst
  apply Subtype.ext
  exact congrArg (fun z ↦ z.2.1) hst

/-- Helper for Theorem 9-9.2-1: every exact fiber indexed by the subgroup conjugacy class of `h`
arises from a localized conjugator. -/
lemma localized_conjugator_sigma_map_surjective
    (H : Subgroup G) (h : H) (x : G) :
    Function.Surjective (localized_conjugator_sigma_map H h x) := by
  intro ys
  rcases ys with ⟨y, s⟩
  have hs : s.1⁻¹ * x * s.1 ∈ H := by
    simpa [s.2] using y.1.2
  refine ⟨⟨s.1, ⟨hs, ?_⟩⟩, ?_⟩
  · -- Transport the target fiber equation back to the subgroup conjugacy-class statement.
    have hsub : (⟨s.1⁻¹ * x * s.1, hs⟩ : H) = y.1 := by
      apply Subtype.ext
      exact s.2
    simpa [hsub] using (ConjClasses.mem_carrier_iff_mk_eq.mp y.2)
  · -- The forward map recovers exactly the original sigma datum.
    ext <;> simp [localized_conjugator_sigma_map, s.2]

/-- Helper for Theorem 9-9.2-1: the localized conjugator set is equivalent to the sigma of exact
ambient conjugator fibers over the subgroup conjugacy class of `h`. -/
noncomputable def localized_conjugator_sigma_equiv
    (H : Subgroup G) (h : H) (x : G) :
    {s : G // ∃ hs : s⁻¹ * x * s ∈ H, ConjClasses.mk ⟨s⁻¹ * x * s, hs⟩ = ConjClasses.mk h} ≃
      Σ y : (ConjClasses.mk h).carrier, {s : G // s⁻¹ * x * s = ((y.1 : H) : G)} :=
  Equiv.ofBijective (localized_conjugator_sigma_map H h x)
    ⟨localized_conjugator_sigma_map_injective H h x,
      localized_conjugator_sigma_map_surjective H h x⟩

/-- Helper for Theorem 9-9.2-1: if `x` is conjugate to `h` in the ambient group, then the set of
conjugators sending `x` into the `H`-conjugacy class of `h` has cardinality
`|Cl_H(h)| * |C_G(x)|`. -/
lemma localized_conjugator_card_of_mk_eq
    {H : Subgroup G} (h : H) (x : G)
    (hxh : ConjClasses.mk x = ConjClasses.mk (h : G)) :
    Nat.card {s : G // ∃ hs : s⁻¹ * x * s ∈ H,
      ConjClasses.mk ⟨s⁻¹ * x * s, hs⟩ = ConjClasses.mk h} =
        Nat.card (ConjClasses.mk h).carrier *
          Nat.card (Subgroup.centralizer ({x} : Set G)) := by
  classical
  let e₁ := localized_conjugator_sigma_equiv H h x
  let e₂ :
      (Σ y : (ConjClasses.mk h).carrier, {s : G // s⁻¹ * x * s = ((y.1 : H) : G)}) ≃
        Σ _y : (ConjClasses.mk h).carrier, Subgroup.centralizer ({x} : Set G) := by
    refine Equiv.sigmaCongrRight ?_
    intro y
    -- Every point of the subgroup conjugacy class of `h` is ambiently conjugate to `h`, hence
    -- also ambiently conjugate to `x` by the hypothesis `hxh`.
    have hyH : ConjClasses.mk (y.1 : H) = ConjClasses.mk h :=
      ConjClasses.mem_carrier_iff_mk_eq.mp y.2
    have hyG : ConjClasses.mk (((y.1 : H) : G)) = ConjClasses.mk (h : G) :=
      subgroup_conjclass_eq_ambient hyH
    exact
      conjugator_fiber_equiv_centralizer_of_mk_eq x ((y.1 : H) : G)
        (hxh.trans hyG.symm)
  calc
    Nat.card {s : G // ∃ hs : s⁻¹ * x * s ∈ H,
        ConjClasses.mk ⟨s⁻¹ * x * s, hs⟩ = ConjClasses.mk h}
        = Nat.card (Σ y : (ConjClasses.mk h).carrier,
            {s : G // s⁻¹ * x * s = ((y.1 : H) : G)}) := by
            exact Nat.card_congr e₁
    _ = Nat.card (Σ _y : (ConjClasses.mk h).carrier,
          Subgroup.centralizer ({x} : Set G)) := by
          exact Nat.card_congr e₂
    _ = Nat.card ((ConjClasses.mk h).carrier × Subgroup.centralizer ({x} : Set G)) := by
          exact
            Nat.card_congr
              (Equiv.sigmaEquivProd (ConjClasses.mk h).carrier
                (Subgroup.centralizer ({x} : Set G)))
    _ = Nat.card (ConjClasses.mk h).carrier *
          Nat.card (Subgroup.centralizer ({x} : Set G)) := by
          rw [Nat.card_prod]

/-- Helper for Theorem 9-9.2-1: the normalization scalar in the localized induced-piece
computation cancels exactly against the subgroup class-size factor. -/
lemma normalized_localized_scalar_eq_one
    (H : Subgroup G) (h : H) :
    let a : ℚ :=
      (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) /
        ((Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) *
          (orderOf (h : G) : ℚ))
    ((Nat.card H : ℚ)⁻¹) * a * (orderOf (h : G) : ℚ) *
        (Nat.card (ConjClasses.mk h).carrier : ℚ) *
        (Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) = 1 := by
  let a : ℚ :=
    (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) /
      ((Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) *
        (orderOf (h : G) : ℚ))
  -- Rewrite the subgroup conjugacy-class size using the subgroup centralizer of `h`.
  haveI : Fintype (ConjClasses.mk h).carrier := Fintype.ofFinite (ConjClasses.mk h).carrier
  haveI : Fintype (MulAction.stabilizer (ConjAct H) h) :=
    Fintype.ofFinite (MulAction.stabilizer (ConjAct H) h)
  have hcarrier_nat :
      Nat.card (ConjClasses.mk h).carrier =
        Nat.card H / Nat.card (Subgroup.centralizer ({h} : Set H)) := by
    have hcarrier := ConjClasses.card_carrier (G := H) h
    rw [← Nat.card_eq_fintype_card (α := (ConjClasses.mk h).carrier),
      ← Nat.card_eq_fintype_card (α := H)] at hcarrier
    rw [show Fintype.card (MulAction.stabilizer (ConjAct H) h) =
        Nat.card (Subgroup.centralizer ({h} : Set H)) by
          simpa [Nat.card_eq_fintype_card] using
            (Subgroup.nat_card_centralizer_nat_card_stabilizer (G := H) h).symm] at hcarrier
    exact hcarrier
  have hdiv : Nat.card (Subgroup.centralizer ({h} : Set H)) ∣ Nat.card H := by
    simpa [Nat.card_eq_fintype_card] using
      (Subgroup.card_subgroup_dvd_card (Subgroup.centralizer ({h} : Set H)))
  have hcent_nat_ne_zero : Nat.card (Subgroup.centralizer ({h} : Set H)) ≠ 0 := by
    exact Nat.card_ne_zero.mpr ⟨⟨1, by simp⟩, inferInstance⟩
  have hamb_nat_ne_zero : Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) ≠ 0 := by
    exact Nat.card_ne_zero.mpr ⟨⟨1, by simp⟩, inferInstance⟩
  have hcarrier :
      (Nat.card (ConjClasses.mk h).carrier : ℚ) =
        (Nat.card H : ℚ) / (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) := by
    rw [hcarrier_nat]
    rw [Nat.cast_div hdiv]
    exact_mod_cast hcent_nat_ne_zero
  have hcent_ne_zero :
      (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) ≠ 0 := by
    exact_mod_cast hcent_nat_ne_zero
  have hamb_ne_zero :
      (Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) ≠ 0 := by
    exact_mod_cast hamb_nat_ne_zero
  have horder_ne_zero : (orderOf (h : G) : ℚ) ≠ 0 := by
    exact_mod_cast (orderOf_pos (h : G)).ne'
  -- The remaining arithmetic is a direct cancellation in `ℚ`.
  rw [hcarrier]
  dsimp [a]
  field_simp [hcent_ne_zero, hamb_ne_zero, horder_ne_zero]

/-- Helper for Theorem 9-9.2-1: evaluating the normalized localized induced piece at the chosen
representative `h` collapses to the original class-function value `χ(h)`. -/
lemma induced_localized_piece_value_at_representative
    (H : Subgroup G) (χ : G → ℂ) [_root_.IsClassFunction χ] (h : H) :
    let a : ℚ :=
      (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) /
        ((Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) *
          (orderOf (h : G) : ℚ))
    Ind[H](fun y ↦
      (a : ℂ) * χ y.1 *
        ((orderOf y : ℂ) * ((ConjClasses.mk h).indicator y : ℚ))) (h : G) = χ (h : G) := by
  classical
  let a : ℚ :=
    (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) /
      ((Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) *
        (orderOf (h : G) : ℚ))
  let ψ : H → ℂ := fun y ↦
    (a : ℂ) * χ y.1 *
      ((orderOf y : ℂ) * ((ConjClasses.mk h).indicator y : ℚ))
  change Ind[H](ψ) (h : G) = χ (h : G)
  let p : G → Prop := fun s ↦
    ∃ hs : s⁻¹ * (h : G) * s ∈ H,
      ConjClasses.mk ⟨s⁻¹ * (h : G) * s, hs⟩ = ConjClasses.mk h
  let c : ℂ := (a : ℂ) * χ (h : G) * (orderOf (h : G) : ℂ)
  have hsummand (s : G) :
      (if hs : s⁻¹ * (h : G) * s ∈ H then
        ψ ⟨s⁻¹ * (h : G) * s, hs⟩
      else 0) =
        if hp : p s then c else 0 := by
    by_cases hs : s⁻¹ * (h : G) * s ∈ H
    · let y : H := ⟨s⁻¹ * (h : G) * s, hs⟩
      by_cases hy : ConjClasses.mk y = ConjClasses.mk h
      · have hp : p s := ⟨hs, hy⟩
        have hχy : χ y.1 = χ (h : G) := by
          have hconj : IsConj y.1 (h : G) := by
            refine isConj_iff.mpr ?_
            refine ⟨s, ?_⟩
            dsimp [y]
            group
          exact _root_.IsClassFunction.eq_of_isConj (f := χ) inferInstance hconj
        have hordery : (orderOf y : ℂ) = (orderOf (h : G) : ℂ) := by
          have horder_nat : orderOf y = orderOf (h : G) := by
            simpa [y] using (((SemiconjBy.conj_mk s⁻¹ (h : G)).orderOf_eq s⁻¹).symm)
          exact_mod_cast horder_nat
        rw [dif_pos hs, dif_pos hp]
        -- On the localized support, the summand is the constant representative value.
        have hχs : χ (s⁻¹ * (h : G) * s) = χ (h : G) := by
          simpa [y] using hχy
        have hordery' :
            (orderOf (⟨s⁻¹ * (h : G) * s, hs⟩ : H) : ℂ) = (orderOf (h : G) : ℂ) := by
          simpa [y] using hordery
        have hind : ((ConjClasses.mk h).indicator ⟨s⁻¹ * (h : G) * s, hs⟩ : ℚ) = 1 := by
          have hy_mem : y ∈ (ConjClasses.mk h).carrier := by
            simpa [ConjClasses.mem_carrier_iff_mk_eq] using hy
          rw [ConjClasses.indicator]
          exact Set.indicator_of_mem hy_mem (fun _ : H ↦ (1 : ℚ))
        dsimp [ψ]
        rw [hχs, hordery', hind]
        dsimp [c]
        ring
      · have hp : ¬ p s := by
          rintro ⟨hs', hy'⟩
          exact hy hy'
        rw [dif_pos hs, dif_neg hp]
        -- Off the subgroup conjugacy class of `h`, the indicator forces the summand to vanish.
        have hind : ((ConjClasses.mk h).indicator ⟨s⁻¹ * (h : G) * s, hs⟩ : ℚ) = 0 := by
          have hy_not_mem : y ∉ (ConjClasses.mk h).carrier := by
            simpa [ConjClasses.mem_carrier_iff_mk_eq] using hy
          rw [ConjClasses.indicator]
          exact Set.indicator_of_notMem hy_not_mem (fun _ : H ↦ (1 : ℚ))
        dsimp [ψ]
        rw [hind]
        simp [hind]
    · have hp : ¬ p s := by
        rintro ⟨hs', -⟩
        exact hs hs'
      rw [dif_neg hs, dif_neg hp]
  have hsum_eq :
      ∑ s : G,
        (if hs : s⁻¹ * (h : G) * s ∈ H then
          ψ ⟨s⁻¹ * (h : G) * s, hs⟩
        else 0) =
          ∑ s : G, if hp : p s then c else 0 := by
    let f : G → ℂ := fun s ↦
      if hs : s⁻¹ * (h : G) * s ∈ H then
        ψ ⟨s⁻¹ * (h : G) * s, hs⟩
      else 0
    let g : G → ℂ := fun s ↦ if hp : p s then c else 0
    change ∑ s : G, f s = ∑ s : G, g s
    exact Fintype.sum_congr f g hsummand
  have hsum :
      ∑ s : G, (if hp : p s then c else 0) =
        (Nat.card {s : G // p s} : ℂ) * c := by
    show Finset.sum Finset.univ (fun s : G ↦ if hp : p s then c else 0) =
      (Nat.card {s : G // p s} : ℂ) * c
    calc
      Finset.sum Finset.univ (fun s : G ↦ if hp : p s then c else 0) =
          Finset.sum (Finset.univ.filter p) (fun _ ↦ c) := by
            simpa [p] using
              (Finset.sum_filter (s := Finset.univ) p (fun _ : G ↦ c)).symm
      _ = (Finset.univ.filter p).card • c := by
            simp
      _ = ((Finset.univ.filter p).card : ℂ) * c := by
            simp [nsmul_eq_mul]
      _ = (Nat.card {s : G // p s} : ℂ) * c := by
            have hcard :
                Fintype.card {s : G // p s} = (Finset.univ.filter p).card := by
              simpa using
                (Fintype.card_of_subtype (p := p) (Finset.univ.filter p) (by
                  intro x
                  simp))
            simpa [Nat.card_eq_fintype_card] using
              congrArg (fun n : ℕ => (n : ℂ) * c) hcard.symm
  have hcard :
      (Nat.card {s : G // p s} : ℂ) =
        (Nat.card (ConjClasses.mk h).carrier : ℂ) *
          (Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℂ) := by
    simpa [p, Nat.cast_mul] using
      congrArg (fun n : ℕ => (n : ℂ))
        (localized_conjugator_card_of_mk_eq (h := h) (x := (h : G)) rfl)
  have hnorm :
      (((Nat.card H : ℂ)⁻¹) * (a : ℂ) * (orderOf (h : G) : ℂ) *
          (Nat.card (ConjClasses.mk h).carrier : ℂ) *
          (Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℂ)) = 1 := by
    -- Cast the rational normalization identity into `ℂ` before cancelling the coefficient.
    simpa [a] using
      congrArg (fun z : ℚ => (z : ℂ)) (normalized_localized_scalar_eq_one H h)
  -- Expand the induced value, count the localized support, and cancel the normalization scalar.
  calc
    Ind[H](ψ) (h : G) =
        ((Nat.card H : ℂ)⁻¹) *
          ∑ s : G,
            (if hs : s⁻¹ * (h : G) * s ∈ H then
              ψ ⟨s⁻¹ * (h : G) * s, hs⟩
            else 0) := by
          simp [Subgroup.inducedClassFunction]
    _ = ((Nat.card H : ℂ)⁻¹) * ∑ s : G, (if hp : p s then c else 0) := by
          rw [hsum_eq]
    _ = ((Nat.card H : ℂ)⁻¹) * ((Nat.card {s : G // p s} : ℂ) * c) := by
          rw [hsum]
    _ = ((((Nat.card H : ℂ)⁻¹) * (a : ℂ) * (orderOf (h : G) : ℂ) *
            (Nat.card (ConjClasses.mk h).carrier : ℂ) *
            (Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℂ)) *
          χ (h : G)) := by
          rw [hcard]
          dsimp [c]
          ring
    _ = χ (h : G) := by
          rw [hnorm, one_mul]

/-- Helper for Theorem 9-9.2-1: away from the ambient conjugacy class of `h`, the localized
induced piece vanishes termwise in the induction sum. -/
lemma localized_piece_vanishes_off_ambient_conjclass
    (H : Subgroup G) (χ : G → ℂ) [_root_.IsClassFunction χ] (h : H) {x : G}
    (hx : ConjClasses.mk x ≠ ConjClasses.mk (h : G)) :
    let a : ℚ :=
      (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) /
        ((Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) *
          (orderOf (h : G) : ℚ))
    Ind[H](fun y ↦
      (a : ℂ) * χ y.1 *
        ((orderOf y : ℂ) * ((ConjClasses.mk h).indicator y : ℚ))) x = 0 := by
  classical
  let a : ℚ :=
    (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) /
      ((Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) *
        (orderOf (h : G) : ℚ))
  let ψ : H → ℂ := fun y ↦
    (a : ℂ) * χ y.1 *
      ((orderOf y : ℂ) * ((ConjClasses.mk h).indicator y : ℚ))
  change Ind[H](ψ) x = 0
  have hsummand_zero (s : G) :
      (if hs : s⁻¹ * x * s ∈ H then
        ψ ⟨s⁻¹ * x * s, hs⟩
      else 0) = 0 := by
    by_cases hs : s⁻¹ * x * s ∈ H
    · let y : H := ⟨s⁻¹ * x * s, hs⟩
      have hy : ConjClasses.mk y ≠ ConjClasses.mk h := by
        intro hy
        have hxy : ConjClasses.mk x = ConjClasses.mk ((y : H) : G) := by
          apply ConjClasses.mk_eq_mk_iff_isConj.mpr
          refine isConj_iff.mpr ?_
          refine ⟨s⁻¹, ?_⟩
          dsimp [y]
          group
        exact hx (hxy.trans (subgroup_conjclass_eq_ambient hy))
      rw [dif_pos hs]
      -- A nonzero subgroup indicator would force ambient conjugacy to `h`, contradicting `hx`.
      have hind : ((ConjClasses.mk h).indicator ⟨s⁻¹ * x * s, hs⟩ : ℚ) = 0 := by
        have hy_not_mem : y ∉ (ConjClasses.mk h).carrier := by
          simpa [ConjClasses.mem_carrier_iff_mk_eq] using hy
        rw [ConjClasses.indicator]
        exact Set.indicator_of_notMem hy_not_mem (fun _ : H ↦ (1 : ℚ))
      dsimp [ψ]
      rw [hind]
      simp [hind]
    · rw [dif_neg hs]
  -- Every induction summand is zero, so the induced value itself vanishes.
  rw [Subgroup.inducedClassFunction]
  simp_rw [hsummand_zero]
  simp

/-- Helper for Theorem 9-9.2-1: inducing the normalized localized subgroup class piece recovers
the corresponding global conjugacy-class piece of the ambient class function. -/
lemma induced_normalized_localized_character_piece_eq_class_piece
    (H : Subgroup G) (χ : G → ℂ) [_root_.IsClassFunction χ] (h : H) :
    let a : ℚ :=
      (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) /
        ((Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) *
          (orderOf (h : G) : ℚ))
    Ind[H](fun y ↦
      (a : ℂ) * χ y.1 *
        ((orderOf y : ℂ) * ((ConjClasses.mk h).indicator y : ℚ))) =
      fun x ↦ χ x * ((ConjClasses.mk (h : G)).indicator x : ℚ) := by
  classical
  -- Route correction: the old blocker was an abstract span-inclusion argument. The new route
  -- reduces the forward implication to this explicit orbit-stabilizer computation for one
  -- conjugacy-class piece at a time.
  let a : ℚ :=
    (Nat.card (Subgroup.centralizer ({h} : Set H)) : ℚ) /
      ((Nat.card (Subgroup.centralizer ({(h : G)} : Set G)) : ℚ) *
        (orderOf (h : G) : ℚ))
  let ψ : H → ℂ := fun y ↦
    (a : ℂ) * χ y.1 *
      ((orderOf y : ℂ) * ((ConjClasses.mk h).indicator y : ℚ))
  change Ind[H](ψ) = fun x ↦ χ x * ((ConjClasses.mk (h : G)).indicator x : ℚ)
  ext x
  by_cases hxh : ConjClasses.mk x = ConjClasses.mk (h : G)
  · have hconj : IsConj x (h : G) := ConjClasses.mk_eq_mk_iff_isConj.mp hxh
    have hinduced : _root_.IsClassFunction (Ind[H](ψ)) :=
      Subgroup.inducedClassFunction_isClassFunction H ψ
    have hleft : Ind[H](ψ) x = Ind[H](ψ) (h : G) :=
      hinduced.eq_of_isConj hconj
    have hχx : χ x = χ (h : G) :=
      _root_.IsClassFunction.eq_of_isConj (f := χ) inferInstance hconj
    -- On the ambient conjugacy class of `h`, reduce to the representative-value computation.
    calc
      Ind[H](ψ) x = Ind[H](ψ) (h : G) := hleft
      _ = χ (h : G) := by
            simpa [a, ψ] using induced_localized_piece_value_at_representative H χ h
      _ = χ x * ((ConjClasses.mk (h : G)).indicator x : ℚ) := by
            simp [ConjClasses.indicator, ConjClasses.mem_carrier_iff_mk_eq, hxh, hχx]
  · have hleft : Ind[H](ψ) x = 0 := by
        simpa [a, ψ] using localized_piece_vanishes_off_ambient_conjclass H χ h hxh
    -- Off the ambient conjugacy class of `h`, both the induced piece and the indicator vanish.
    rw [hleft]
    simp [ConjClasses.indicator, ConjClasses.mem_carrier_iff_mk_eq, hxh]

/-- Helper for Theorem 9-9.2-1: under the conjugacy-cover hypothesis, every honest character is a
positive-integer multiple of a sum of induced subgroup character differences. -/
theorem character_multiple_eq_sum_of_induced_character_differences_of_is_conjugacy_cover
    (X : Finset (Subgroup G)) (hcover : is_conjugacy_cover X) :
    ∀ V : FDRep ℂ G, ∃ d : ℕ+,
      ∃ Vpos : (H : X) → FDRep ℂ H.1,
        ∃ Vneg : (H : X) → FDRep ℂ H.1,
          (d : ℂ) • V.character =
            ∑ H : X,
              (Ind[H.1]((Vpos H).character) -
                Ind[H.1]((Vneg H).character)) := by
  -- Source route: Serre's cyclic-subgroup identity first puts the unit character in the Artin
  -- span; multiplying by the given honest character keeps the result in the same span.
  classical
  intro V
  have hone : (1 : G → ℂ) ∈ artinInducedCharacterSpan X :=
    Representation.one_mem_artinInducedCharacterSpan_of_is_conjugacy_cover (X := X) hcover
  have hVspan : V.character ∈ artinInducedCharacterSpan X := by
    have hmul :=
      artinInducedCharacterSpan_mul_fdRepCharacter_mem
        (X := X) hone V
    simpa [Pi.mul_apply] using hmul
  rcases Representation.exists_multiple_eq_sum_characterRingInduction_of_mem_artinInducedCharacterSpan
      (X := X) hVspan with ⟨d, ξ, hξ⟩
  choose Vpos Vneg hdiff using
    fun H : X ↦ Representation.virtual_character_eq_character_difference H.1 (ξ H)
  refine ⟨d, Vpos, Vneg, ?_⟩
  calc
    (d : ℂ) • V.character =
        ∑ H : X, (((H.1.characterRingInduction (ξ H) : R(G)) : G → ℂ)) := hξ
    _ = ∑ H : X, Ind[H.1]((ξ H : H.1 → ℂ)) := by
          refine Finset.sum_congr rfl ?_
          intro H hH
          simp [Subgroup.characterRingInduction_apply]
    _ = ∑ H : X,
          (Ind[H.1]((Vpos H).character) - Ind[H.1]((Vneg H).character)) := by
            refine Finset.sum_congr rfl ?_
            intro H hH
            calc
              Ind[H.1]((ξ H : H.1 → ℂ)) =
                  Ind[H.1]((Vpos H).character - (Vneg H).character) := by
                    rw [hdiff H]
              _ = Ind[H.1]((Vpos H).character) + Ind[H.1](-(Vneg H).character) := by
                    simpa [sub_eq_add_neg] using
                      Subgroup.inducedClassFunction_map_add H.1 (Vpos H).character
                        (-(Vneg H).character)
              _ = Ind[H.1]((Vpos H).character) - Ind[H.1]((Vneg H).character) := by
                    have hneg :
                        Ind[H.1](-(Vneg H).character) = -Ind[H.1]((Vneg H).character) := by
                      simpa using
                        (Subgroup.inducedClassFunction_map_smul (H := H.1) (-1 : ℂ)
                          (Vneg H).character)
                    simpa [sub_eq_add_neg, hneg]

-- Proof sketch: this is the source-facing Artin-induction statement. Starting from the
-- owner-level span formulation in `Representation.characterRingScalarExtension ℚ G`, clear
-- rational denominators and write each subgroup virtual character as a difference of genuine
-- subgroup characters.
/-- Theorem 9-9.2-1: a finite family of subgroups of a finite group is a conjugacy cover exactly
when every complex character becomes, after multiplication by a positive integer, a sum of induced
differences of subgroup characters. -/
theorem is_conjugacy_cover_iff_character_multiple_eq_sum_of_induced_character_differences
    (X : Finset (Subgroup G)) :
    is_conjugacy_cover X ↔
      ∀ V : FDRep ℂ G, ∃ d : ℕ+,
        ∃ Vpos : (H : X) → FDRep ℂ H.1,
          ∃ Vneg : (H : X) → FDRep ℂ H.1,
            (d : ℂ) • V.character =
              ∑ H : X,
                (Ind[H.1]((Vpos H).character) -
                  Ind[H.1]((Vneg H).character)) := by
  constructor
  · intro hcover V
    -- Apply the dedicated forward source-facing helper.
    exact
      character_multiple_eq_sum_of_induced_character_differences_of_is_conjugacy_cover
        (X := X) hcover V
  · intro hmultiple
    -- The source-facing hypothesis already puts every honest character in the Artin span.
    have hhonest :
        ∀ V : FDRep ℂ G, V.character ∈ artinInducedCharacterSpan X := by
      intro V
      exact
        Representation.character_mem_artinInducedCharacterSpan_of_multiple_eq_sum_inducedCharacter_differences
          (X := X) (V := V) (hmultiple V)
    have hleft :
        characterRingScalarExtension ℚ G ≤ artinInducedCharacterSpan X :=
      Representation.characterRingScalarExtension_le_artinInducedCharacterSpan_of_honest
        (X := X) hhonest
    have hright :
        artinInducedCharacterSpan X ≤ characterRingScalarExtension ℚ G :=
      Representation.artinInducedCharacterSpan_le_characterRingScalarExtension X
    have hspan :
        characterRingScalarExtension ℚ G = artinInducedCharacterSpan X :=
      le_antisymm hleft hright
    -- Apply the already-established owner-level reverse implication.
    exact
      is_conjugacy_cover_of_characterRingScalarExtension_eq_artinInducedCharacterSpan
        (X := X) hspan

end

section

variable {G : Type} [Group G] [Finite G]

/-- Local finite-type witness for the third finite-group section of Theorem 9-9.2-1. -/
local instance instFintypeGroupSectionThree : Fintype G := Fintype.ofFinite G

-- Proof sketch: this is the core owner-level reformulation of Theorem `9-9.2-1`. The family `X`
-- is a conjugacy cover exactly when the rationalized character ring `ℚ ⊗ R(G)`, realized as
-- `Representation.characterRingScalarExtension ℚ G`, is generated by the induced images of the
-- rationalized subgroup character rings `ℚ ⊗ R(H)` for `H ∈ X`.
/-- Owner-level bridge for Theorem 9-9.2-1: a finite family of subgroups of a finite group is a
conjugacy cover exactly when Serre's rationalized character ring `ℚ ⊗ R(G)`, realized as
`Representation.characterRingScalarExtension ℚ G`, is the `ℚ`-span of the characters induced from
the subgroup character rings `ℚ ⊗ R(H)` for `H ∈ X`. -/
theorem is_conjugacy_cover_iff_characterRingScalarExtension_eq_span_induced
    (X : Finset (Subgroup G)) :
    is_conjugacy_cover X ↔
      characterRingScalarExtension ℚ G = artinInducedCharacterSpan X := by
  constructor
  · intro hcover
    -- The source-facing forward theorem already puts every honest character in the Artin span.
    have hhonest :
        ∀ V : FDRep ℂ G, V.character ∈ artinInducedCharacterSpan X := by
      intro V
      exact
        Representation.character_mem_artinInducedCharacterSpan_of_multiple_eq_sum_inducedCharacter_differences
          (X := X) (V := V)
          (character_multiple_eq_sum_of_induced_character_differences_of_is_conjugacy_cover
            (X := X) hcover V)
    have hleft :
        characterRingScalarExtension ℚ G ≤ artinInducedCharacterSpan X :=
      Representation.characterRingScalarExtension_le_artinInducedCharacterSpan_of_honest
        (X := X) hhonest
    have hright :
        artinInducedCharacterSpan X ≤ characterRingScalarExtension ℚ G :=
      Representation.artinInducedCharacterSpan_le_characterRingScalarExtension X
    exact le_antisymm hleft hright
  · intro hspan
    -- The missed-class obstruction proved above gives the reverse implication directly.
    exact
      is_conjugacy_cover_of_characterRingScalarExtension_eq_artinInducedCharacterSpan
        (X := X) hspan

end
