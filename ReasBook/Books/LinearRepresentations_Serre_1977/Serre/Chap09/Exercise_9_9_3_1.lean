/-- Helper for Exercise 9-9.3-1: the restriction family of a global class function is compatible
with conjugation transport. -/
private theorem restrictionFamily_conjugation_compatible (X : Finset (Subgroup G))
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    (χ : classFunctionSubspace G) (H : X) (s : G) (x : (s •ᶜ H.1)) :
    (restrictionFamily X χ ⟨(s •ᶜ H.1), hconj H.2 s⟩ : (s •ᶜ H.1) → ℂ) x =
      (conjugateClassFunctionTransport H.1 s (restrictionFamily X χ H) : (s •ᶜ H.1) → ℂ) x := by
  -- Rewrite both sides as ambient evaluations and use the class-function invariance under
  -- conjugation in `G`.
  let hχ : IsClassFunction (χ : G → ℂ) := (mem_classFunctionSubspace_iff _).1 χ.2
  have hxs :
      IsConj (x : G) ((((MulAut.conj s).subgroupMap H.1).symm x : H.1) : G) := by
    rw [isConj_iff]
    refine ⟨s⁻¹, ?_⟩
    simp [MulEquiv.subgroupMap_symm_apply, mul_assoc]
  simpa [restrictionFamily_apply, subgroupClassFunctionRestriction_apply,
    conjugateClassFunctionTransport_apply] using hχ.eq_of_isConj hxs

