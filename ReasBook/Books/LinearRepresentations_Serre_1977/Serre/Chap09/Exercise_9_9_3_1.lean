/-- Helper for Exercise 9-9.3-1: every subgroup-indexed family in the range of the global
restriction-family map is automatically compatible. -/
private theorem compatibleFamily_of_mem_range_restrictionFamily (X : Finset (Subgroup G))
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    {φ : artinInductionSource X}
    (hφ : φ ∈ LinearMap.range (restrictionFamily X)) :
    CompatibleFamily X hconj φ := by
  rcases hφ with ⟨χ, rfl⟩
  -- Unpack the range witness and apply the already-proved compatibility of actual restrictions.
  exact compatibleFamily_restrictionFamily X hconj χ

