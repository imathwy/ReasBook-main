/-- Helper for Exercise 9-9.3-1: compatible families are exactly the range of the global
restriction-family map. -/
private theorem compatibleFamily_iff_mem_range_restrictionFamily
    (X : Finset (Subgroup G))
    (hsubgroups : ∀ {H H' : Subgroup G}, H ∈ X → H' ≤ H → H' ∈ X)
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    (hcover : is_conjugacy_cover X)
    {φ : artinInductionSource X} :
    CompatibleFamily X hconj φ ↔ φ ∈ LinearMap.range (restrictionFamily X) := by
  constructor
  · intro hφ
    rcases compatibleFamily_glues_to_global_classFunction X hsubgroups hconj hcover hφ with
      ⟨χ, hχ⟩
    exact ⟨χ, hχ⟩
  · intro hφ
    exact compatibleFamily_of_mem_range_restrictionFamily X hconj hφ

set_option maxHeartbeats 1000000
/-- Helper for Exercise 9-9.3-1: the rational relation submodule is stable under complex scaling
because each declared generator is already parameterized by complex-valued class functions. -/
private theorem artinInductionRelations_smul_mem
    (X : Finset (Subgroup G)) (a : ℂ) {ξ : artinInductionSource X}
    (hξ : ξ ∈ artinInductionRelations X) :
    a • ξ ∈ artinInductionRelations X := by
  classical
  -- View complex scaling by `a` as a `ℚ`-linear endomorphism and check it on the declared
  -- generators of the rational relation span.
  let scaleBy : artinInductionSource X →ₗ[ℚ] artinInductionSource X :=
    { toFun := fun η ↦ a • η
      map_add' := by
        intro η θ
        simp [smul_add]
      map_smul' := by
        intro q η
        exact smul_comm a q η }
  have hscale_mem :
      artinInductionRelations X ≤ Submodule.comap scaleBy (artinInductionRelations X) := by
    refine Submodule.span_le.2 ?_
    intro η hη
    show scaleBy η ∈ artinInductionRelations X
    rcases hη with hη | hη
    · rcases hη with ⟨H, H', hH'H, χ', rfl⟩
      have hscale :
          a • inductionInStagesRelation X H H' hH'H χ' =
            inductionInStagesRelation X H H' hH'H (a • χ') := by
        have hind :
            ((H'.1.subgroupOf H.1).classFunctionInduction
                (classFunctionTransport (subgroupOfEquivOfLe hH'H) (a • χ') :
                  H'.1.subgroupOf H.1 → ℂ)) =
              a • ((H'.1.subgroupOf H.1).classFunctionInduction
                (classFunctionTransport (subgroupOfEquivOfLe hH'H) χ' :
                  H'.1.subgroupOf H.1 → ℂ)) := by
          simp
        rw [inductionInStagesRelation, inductionInStagesRelation, smul_add]
        congr
        · ext K x
          by_cases hK : K = H
          · subst hK
            simp
          · simp [hK]
        · ext K x
          by_cases hK : K = H'
          · subst hK
            simp
          · simp [hK]
      rw [show scaleBy (inductionInStagesRelation X H H' hH'H χ') =
          inductionInStagesRelation X H H' hH'H (a • χ') by
        simpa [scaleBy] using hscale]
      change inductionInStagesRelation X H H' hH'H (a • χ') ∈
        Submodule.span ℚ
          { ξ : artinInductionSource X |
              (∃ (H H' : X) (hH'H : H'.1 ≤ H.1) (χ' : classFunctionSubspace H'.1),
                  ξ = inductionInStagesRelation X H H' hH'H χ') ∨
                ∃ (H : X) (s : G) (hHs : (s •ᶜ H.1) ∈ X)
                  (χ : classFunctionSubspace H.1),
                  ξ = conjugationRelation X H s hHs χ }
      exact Submodule.subset_span <| Or.inl ⟨H, H', hH'H, a • χ', rfl⟩
    · rcases hη with ⟨H, s, hHs, χ, rfl⟩
      have hscale :
          a • conjugationRelation X H s hHs χ =
            conjugationRelation X H s hHs (a • χ) := by
        have htransport :
            conjugateClassFunctionTransport H.1 s (a • χ) =
              a • conjugateClassFunctionTransport H.1 s χ := by
          simp
        rw [conjugationRelation, conjugationRelation, smul_add]
        congr
        · ext K x
          by_cases hK : K = H
          · subst hK
            simp
          · simp [hK]
        · ext K x
          by_cases hK : K = ⟨(s •ᶜ H.1), hHs⟩
          · subst hK
            simp [htransport]
          · simp [hK]
      rw [show scaleBy (conjugationRelation X H s hHs χ) =
          conjugationRelation X H s hHs (a • χ) by
        simpa [scaleBy] using hscale]
      change conjugationRelation X H s hHs (a • χ) ∈
        Submodule.span ℚ
          { ξ : artinInductionSource X |
              (∃ (H H' : X) (hH'H : H'.1 ≤ H.1) (χ' : classFunctionSubspace H'.1),
                  ξ = inductionInStagesRelation X H H' hH'H χ') ∨
                ∃ (H : X) (s : G) (hHs : (s •ᶜ H.1) ∈ X)
                  (χ : classFunctionSubspace H.1),
                  ξ = conjugationRelation X H s hHs χ }
      exact Submodule.subset_span <| Or.inr ⟨H, s, hHs, a • χ, rfl⟩
  exact hscale_mem hξ

/-- Helper for Exercise 9-9.3-1: the relation submodule regarded as a complex submodule on the
same carrier. -/
private def artinInductionRelationsC (X : Finset (Subgroup G)) :
    Submodule ℂ (artinInductionSource X) where
  carrier := artinInductionRelations X
  zero_mem' := (artinInductionRelations X).zero_mem
  add_mem' := fun hx hy ↦ (artinInductionRelations X).add_mem hx hy
  smul_mem' := fun a _ hx ↦ artinInductionRelations_smul_mem X a hx

/-- Helper for Exercise 9-9.3-1: the total induction map is naturally complex-linear on the same
subgroup-family source. -/
private def artinInductionMapC (X : Finset (Subgroup G)) :
    artinInductionSource X →ₗ[ℂ] classFunctionSubspace G where
  toFun ξ := ∑ H : X, H.1.classFunctionInduction (ξ H : H.1 → ℂ)
  map_add' := by
    intro ξ η
    ext g
    simp [Finset.sum_add_distrib]
  map_smul' := by
    intro a ξ
    ext g
    simp [Finset.smul_sum, Pi.smul_apply]

/-- Helper for Exercise 9-9.3-1: evaluating the complex Artin induction map is the same finite sum
of subgroup induction operators as in the rational view. -/
@[simp] private theorem artinInductionMapC_apply (X : Finset (Subgroup G))
    (ξ : artinInductionSource X) (g : G) :
    (artinInductionMapC X ξ : G → ℂ) g = ∑ H : X, Ind[H.1]((ξ H : H.1 → ℂ)) g := by
  simp [artinInductionMapC]

/-- Helper for Exercise 9-9.3-1: the componentwise pairing on subgroup-indexed class-function
families, built from Serre's normalized pairing on each subgroup. -/
private def artinSourcePairing (X : Finset (Subgroup G)) :
    LinearMap.BilinForm ℂ (artinInductionSource X) where
  toFun ξ :=
    { toFun := fun φ ↦
        ∑ H : X, Representation.groupFunctionPairingOverField ℂ
          (ξ H : H.1 → ℂ) (φ H : H.1 → ℂ)
      map_add' := by
        intro φ ψ
        simp [Representation.groupFunctionPairing_add_right, Finset.sum_add_distrib]
      map_smul' := by
        intro a φ
        simp [Representation.groupFunctionPairing_smul_right, Finset.mul_sum] }
  map_add' := by
    intro ξ η
    ext φ
    simp [Representation.groupFunctionPairing_add_left, Finset.sum_add_distrib]
  map_smul' := by
    intro a ξ
    ext φ
    simp [Representation.groupFunctionPairing_smul_left, Finset.mul_sum]

/-- Helper for Exercise 9-9.3-1: the componentwise pairing is symmetric on subgroup families
because each subgroup pairing is symmetric. -/
private theorem artinSourcePairing_isRefl (X : Finset (Subgroup G)) :
    (artinSourcePairing X).IsRefl := by
  intro ξ φ hξφ
  simpa [artinSourcePairing, Representation.groupFunctionPairing_comm] using hξφ

/-- Helper for Exercise 9-9.3-1: pairing against a family supported at one subgroup isolates that
single coordinate. -/
@[simp] private theorem artinSourcePairing_pi_single_left (X : Finset (Subgroup G))
    [DecidableEq X] (H : X) (χ : classFunctionSubspace H.1) (φ : artinInductionSource X) :
    artinSourcePairing X (Pi.single H χ) φ =
      Representation.groupFunctionPairingOverField ℂ (χ : H.1 → ℂ) (φ H : H.1 → ℂ) := by
  -- All coordinates except `H` vanish, so the family pairing reduces to the `H`-term.
  dsimp [artinSourcePairing]
  rw [Finset.sum_eq_single H]
  · rw [Pi.single_eq_same]
  · intro K _ hK
    rw [Pi.single_eq_of_ne hK]
    simp [Representation.groupFunctionPairingOverField]
  · simp

/-- Helper for Exercise 9-9.3-1: the right-supported version of the same coordinate simplification.
-/
@[simp] private theorem artinSourcePairing_pi_single_right (X : Finset (Subgroup G))
    [DecidableEq X] (ξ : artinInductionSource X) (H : X) (χ : classFunctionSubspace H.1) :
    artinSourcePairing X ξ (Pi.single H χ) =
      Representation.groupFunctionPairingOverField ℂ (ξ H : H.1 → ℂ) (χ : H.1 → ℂ) := by
  -- This is the same one-coordinate collapse on the right-hand family argument.
  dsimp [artinSourcePairing]
  rw [Finset.sum_eq_single H]
  · rw [Pi.single_eq_same]
  · intro K _ hK
    rw [Pi.single_eq_of_ne hK]
    simp [Representation.groupFunctionPairingOverField]
  · simp

