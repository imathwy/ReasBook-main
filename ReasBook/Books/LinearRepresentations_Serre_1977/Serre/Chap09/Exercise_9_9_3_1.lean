/-- Helper for Exercise 9-9.3-1: every global class function restricts to a compatible
subgroup-indexed family. -/
private theorem compatibleFamily_restrictionFamily (X : Finset (Subgroup G))
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    (χ : classFunctionSubspace G) :
    CompatibleFamily X hconj (restrictionFamily X χ) := by
  constructor
  · intro H H' hH'H x
    exact restrictionFamily_subgroup_compatible X χ hH'H x
  · intro H s x
    exact restrictionFamily_conjugation_compatible X hconj χ H s x

