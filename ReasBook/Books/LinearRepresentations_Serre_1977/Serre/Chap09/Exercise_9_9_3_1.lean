/-- Helper for Exercise 9-9.3-1: precomposing a class function with inversion stays inside the
class-function subspace. -/
private theorem inverseClassFunction_mem (χ : classFunctionSubspace G) :
    IsClassFunction (fun g : G ↦ (χ : G → ℂ) g⁻¹) := by
  -- Inversion carries a conjugacy class to the inverse conjugacy class, so class functions remain
  -- constant after precomposition with `g ↦ g⁻¹`.
  refine ⟨?_⟩
  intro x y hxy
  have hχ : IsClassFunction (χ : G → ℂ) := (mem_classFunctionSubspace_iff _).1 χ.2
  have hxy_inv : IsConj x⁻¹ y⁻¹ := by
    rcases isConj_iff.1 ((ConjClasses.mk_eq_mk_iff_isConj).1 hxy) with ⟨c, hc⟩
    refine isConj_iff.2 ⟨c, ?_⟩
    calc
      c * x⁻¹ * c⁻¹ = (c * x * c⁻¹)⁻¹ := by simp [mul_assoc]
      _ = y⁻¹ := by simp [hc]
  simpa using hχ.eq_of_isConj hxy_inv

/-- Helper for Exercise 9-9.3-1: inversion on the group transports class functions to class
functions by precomposition with `g ↦ g⁻¹`. -/
private def inverseClassFunctionTransport :
    classFunctionSubspace G →ₗ[ℂ] classFunctionSubspace G :=
  LinearMap.codRestrict (classFunctionSubspace G)
    { toFun := fun χ g ↦ (χ : G → ℂ) g⁻¹
      map_add' := by
        intro χ ψ
        ext g
        simp
      map_smul' := by
        intro a χ
        ext g
        simp }
    inverseClassFunction_mem

