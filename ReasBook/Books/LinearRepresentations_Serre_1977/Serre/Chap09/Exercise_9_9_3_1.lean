/-- Helper for Exercise 9-9.3-1: a compatible local family glues to a global class function under
the subgroup-closure and conjugacy-cover hypotheses. -/
private theorem compatibleFamily_glues_to_global_classFunction
    (X : Finset (Subgroup G))
    (hsubgroups : ∀ {H H' : Subgroup G}, H ∈ X → H' ≤ H → H' ∈ X)
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    (hcover : is_conjugacy_cover X)
    {φ : artinInductionSource X}
    (hφ : CompatibleFamily X hconj φ) :
    ∃ χ : classFunctionSubspace G, restrictionFamily X χ = φ := by
  classical
  have hcover' : ∀ g : G, ∃ H : X, ∃ x : H.1, IsConj (x : G) g := by
    intro g
    rcases (is_conjugacy_cover_iff X).1 hcover g with ⟨H, hHX, hgH⟩
    rcases Group.mem_conjugatesOfSet_iff.1 hgH with ⟨x, hxH, hxconj⟩
    exact ⟨⟨H, hHX⟩, ⟨x, hxH⟩, hxconj⟩
  choose witnessH witnessx witnessconj using hcover'
  let χfun : G → ℂ := fun g ↦
    (φ (witnessH g) : (witnessH g).1 → ℂ) (witnessx g)
  have hχclass : IsClassFunction χfun := by
    refine ⟨?_⟩
    intro g g' hgg'
    have hgg'_conj : IsConj g g' := (ConjClasses.mk_eq_mk_iff_isConj).1 hgg'
    have hlocal :
        IsConj (((witnessx g : (witnessH g).1) : G))
          (((witnessx g' : (witnessH g').1) : G)) := by
      exact (witnessconj g).trans (hgg'_conj.trans (witnessconj g').symm)
    -- The glued function only depends on the ambient conjugacy class because compatible families
    -- assign the same value to any ambiently conjugate local representatives.
    simpa [χfun] using
      compatibleFamily_value_eq_of_isConj X hsubgroups hconj hφ
        (H := witnessH g) (K := witnessH g') (x := witnessx g) (y := witnessx g') hlocal
  refine ⟨⟨χfun, (mem_classFunctionSubspace_iff _).2 hχclass⟩, ?_⟩
  ext H x
  -- Evaluate the glued function on a subgroup element and compare it with the canonical local
  -- witness `(H, x)` for the same ambient conjugacy class.
  simpa [restrictionFamily_apply, subgroupClassFunctionRestriction_apply, χfun] using
    compatibleFamily_value_eq_of_isConj X hsubgroups hconj hφ
      (H := witnessH (x : G)) (K := H) (x := witnessx (x : G)) (y := x)
      (witnessconj (x : G))

