noncomputable section

universe u

namespace Subgroup

section Transport

variable {G H J : Type u} [Group G] [Group H] [Group J]

local notation:max s " •ᶜ " H => (MulAut.conj s • H : Subgroup G)

private theorem classFunctionTransport_mem (e : H ≃* J) (χ : classFunctionSubspace J) :
    IsClassFunction ((χ : J → ℂ) ∘ e) := by
  refine ⟨?_⟩
  intro x y hxy
  have hχ : IsClassFunction (χ : J → ℂ) := (mem_classFunctionSubspace_iff _).1 χ.2
  exact hχ.eq_of_isConj <|
    e.toMonoidHom.map_isConj ((ConjClasses.mk_eq_mk_iff_isConj.1 hxy))

/-- Pullback of class functions along a group isomorphism. -/
private def classFunctionTransport (e : H ≃* J) :
    classFunctionSubspace J →ₗ[ℂ] classFunctionSubspace H :=
  LinearMap.codRestrict (classFunctionSubspace H)
    (((LinearEquiv.funCongrLeft ℂ ℂ e.toEquiv).toLinearMap).comp
      (classFunctionSubspace J).subtype)
    (fun χ ↦ classFunctionTransport_mem e χ)

/-- Helper for Exercise 9-9.3-1: evaluating transport along a group isomorphism is just
precomposition with that isomorphism. -/
@[simp] private theorem classFunctionTransport_apply (e : H ≃* J)
    (χ : classFunctionSubspace J) (x : H) :
    (classFunctionTransport e χ : H → ℂ) x = (χ : J → ℂ) (e x) :=
  rfl

/-- The canonical conjugation transport on class functions from `H` to `sHs⁻¹`. -/
def conjugateClassFunctionTransport (H : Subgroup G) (s : G) :
    classFunctionSubspace H →ₗ[ℂ] classFunctionSubspace (s •ᶜ H) :=
  classFunctionTransport ((MulAut.conj s).subgroupMap H).symm

-- Proof sketch: `conjugateClassFunctionTransport` is defined by composing `χ` with the subgroup
-- conjugation isomorphism `H ≃ sHs⁻¹`.
/-- Evaluating the conjugation transport is composition with the subgroup conjugation isomorphism.
-/
@[simp] theorem conjugateClassFunctionTransport_apply
    (H : Subgroup G) (s : G) (χ : classFunctionSubspace H)
    (x : (s •ᶜ H)) :
    (conjugateClassFunctionTransport H s χ : (s •ᶜ H) → ℂ) x =
      (χ : H → ℂ) (((MulAut.conj s).subgroupMap H).symm x) :=
  rfl

end Transport

section ArtinInductionRelations

variable {G : Type u} [Group G] [Finite G]

local notation:max s " •ᶜ " H => (MulAut.conj s • H : Subgroup G)

local instance instFintypeGArtinInductionRelations : Fintype G := Fintype.ofFinite G
local instance instFintypeSubgroupArtinInductionRelations (H : Subgroup G) : Fintype H :=
  Fintype.ofFinite H

/-- The source of the Artin induction map indexed by the subgroup family `X`. -/
abbrev artinInductionSource (X : Finset (Subgroup G)) :=
  (H : X) → classFunctionSubspace H.1

/-- The total induction map from subgroup-indexed class-function families on `X` to class
functions on `G`. -/
def artinInductionMap (X : Finset (Subgroup G)) :
    artinInductionSource X →ₗ[ℚ] classFunctionSubspace G where
  toFun ξ := ∑ H : X, H.1.classFunctionInduction (ξ H : H.1 → ℂ)
  map_add' := by
    intro ξ η
    ext g
    simp [Finset.sum_add_distrib]
  map_smul' := by
    intro a ξ
    ext g
    simp [Finset.smul_sum, Pi.smul_apply]

/-- Evaluating the Artin induction map is the sum of the subgroup induction operators over `X`. -/
@[simp] theorem artinInductionMap_apply (X : Finset (Subgroup G))
    (ξ : artinInductionSource X) (g : G) :
    (artinInductionMap X ξ : G → ℂ) g = ∑ H : X, Ind[H.1]((ξ H : H.1 → ℂ)) g := by
  simp [artinInductionMap]

/-- The class-function family relation expressing induction in stages inside the subgroup family
`X`. -/
def inductionInStagesRelation (X : Finset (Subgroup G)) (H H' : X) (hH'H : H'.1 ≤ H.1)
    (χ' : classFunctionSubspace H'.1) :
    artinInductionSource X :=
  let _ : DecidableEq X := Classical.decEq X
  Pi.single H
      ((H'.1.subgroupOf H.1).classFunctionInduction
        (classFunctionTransport (subgroupOfEquivOfLe hH'H) χ' :
          H'.1.subgroupOf H.1 → ℂ)) +
    Pi.single H' (-χ')

/-- The class-function family relation expressing conjugation by `s` inside the subgroup family
`X`. -/
def conjugationRelation (X : Finset (Subgroup G)) (H : X) (s : G)
    (hHs : (s •ᶜ H.1) ∈ X) (χ : classFunctionSubspace H.1) :
    artinInductionSource X :=
  let _ : DecidableEq X := Classical.decEq X
  Pi.single H χ +
    Pi.single ⟨(s •ᶜ H.1), hHs⟩
      (-(conjugateClassFunctionTransport H.1 s χ))

/-- The submodule of subgroup-family class-function data generated by the induction-in-stages and
conjugation relations. -/
def artinInductionRelations (X : Finset (Subgroup G)) : Submodule ℚ (artinInductionSource X) :=
  Submodule.span ℚ
    { ξ : artinInductionSource X |
        (∃ (H H' : X) (hH'H : H'.1 ≤ H.1) (χ' : classFunctionSubspace H'.1),
            ξ = inductionInStagesRelation X H H' hH'H χ') ∨
          ∃ (H : X) (s : G) (hHs : (s •ᶜ H.1) ∈ X)
            (χ : classFunctionSubspace H.1),
            ξ = conjugationRelation X H s hHs χ }

/-- Membership in the Artin-induction kernel is the vanishing of the total induced class function
on every element of `G`. -/
theorem mem_artinInductionMap_ker_iff (X : Finset (Subgroup G)) (ξ : artinInductionSource X) :
    ξ ∈ (artinInductionMap X).ker ↔
      ∀ g : G, ∑ H : X, Ind[H.1]((ξ H : H.1 → ℂ)) g = 0 := by
  change artinInductionMap X ξ = 0 ↔
      ∀ g : G, ∑ H : X, Ind[H.1]((ξ H : H.1 → ℂ)) g = 0
  constructor
  · intro hξ g
    simpa [artinInductionMap_apply] using
      congrFun (congrArg (fun χ : classFunctionSubspace G ↦ (χ : G → ℂ)) hξ) g
  · intro hξ
    ext g
    simpa [artinInductionMap_apply] using hξ g

/-- Helper for Exercise 9-9.3-1: a subgroup-family supported at a single subgroup induces to the
corresponding single subgroup induction term. -/
private theorem artinInductionMap_pi_single (X : Finset (Subgroup G))
    [DecidableEq X] (H : X) (χ : classFunctionSubspace H.1) :
    artinInductionMap X (Pi.single H χ) = H.1.classFunctionInduction (χ : H.1 → ℂ) := by
  -- Every coordinate except `H` is zero, so the defining Artin sum collapses to one term.
  ext g
  rw [artinInductionMap_apply]
  rw [Finset.sum_eq_single H]
  · simp
  · intro K _ hK
    simp [hK, Subgroup.inducedClassFunction]
  · simp

/-- Helper for Exercise 9-9.3-1: if `H' ≤ H`, then inducing from `H'` to `H` and then to `G`
agrees with inducing directly from `H'` to `G`. -/
private theorem classFunctionInduction_subgroupOf_transport_eq
    {H H' : Subgroup G} (hH'H : H' ≤ H) (χ' : classFunctionSubspace H') :
    (H.classFunctionInduction
      (((H'.subgroupOf H).classFunctionInduction
        (classFunctionTransport (subgroupOfEquivOfLe hH'H) χ' :
          H'.subgroupOf H → ℂ)) : H → ℂ) : G → ℂ) =
      (H'.classFunctionInduction (χ' : H' → ℂ) : G → ℂ) := by
  classical
  let _ : DecidablePred fun z : G ↦ z ∈ H := Classical.decPred _
  let _ : DecidablePred fun z : G ↦ z ∈ H' := Classical.decPred _
  let _ : DecidablePred fun z : H ↦ z ∈ H'.subgroupOf H := Classical.decPred _
  ext g
  have hcard : Nat.card (H'.subgroupOf H) = Nat.card H' := by
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hH'H).toEquiv
  let φ : G → ℂ := fun s ↦
    if hs : s⁻¹ * g * s ∈ H' then
      (χ' : H' → ℂ) ⟨s⁻¹ * g * s, hs⟩
    else
      0
  have hinner :
      ∀ x : G,
        (if hsg : x⁻¹ * g * x ∈ H then
          (↑(Nat.card ↥H') : ℂ)⁻¹ *
            ∑ y : H,
              if hsg_1 : y⁻¹ * ⟨x⁻¹ * g * x, hsg⟩ * y ∈ H'.subgroupOf H then
                (χ' : H' → ℂ) ((Subgroup.subgroupOfEquivOfLe hH'H)
                  ⟨y⁻¹ * ⟨x⁻¹ * g * x, hsg⟩ * y, hsg_1⟩)
              else
                0
        else
          0) =
        (↑(Nat.card ↥H') : ℂ)⁻¹ * ∑ y : H, φ (x * y) := by
    intro x
    by_cases hx : x⁻¹ * g * x ∈ H
    · -- Once `x⁻¹ g x` lands in `H`, both inner sums run over the same subgroup elements.
      rw [dif_pos hx]
      congr 1
      apply Finset.sum_congr rfl
      intro y hy
      have hmul :
          (((y : H) : G)⁻¹) * (x⁻¹ * g * x) * ((y : H) : G) =
            (x * y : G)⁻¹ * g * (x * y : G) := by
        group
      dsimp [φ]
      by_cases hxy : (x * y : G)⁻¹ * g * (x * y : G) ∈ H'
      · have hsub : ((y : H)⁻¹ * ⟨x⁻¹ * g * x, hx⟩ * y) ∈ H'.subgroupOf H := by
          change (((y : H) : G)⁻¹ * (x⁻¹ * g * x) * (y : H)) ∈ H'
          simpa [hmul] using hxy
        rw [dif_pos hsub, dif_pos hxy]
        have hEq :
            (Subgroup.subgroupOfEquivOfLe hH'H) ⟨y⁻¹ * ⟨x⁻¹ * g * x, hx⟩ * y, hsub⟩ =
              ⟨(x * y : G)⁻¹ * g * (x * y : G), hxy⟩ := by
          apply Subtype.ext
          simp [Subgroup.subgroupOfEquivOfLe, hmul]
        simpa using congrArg (fun z : H' ↦ (χ' : H' → ℂ) z) hEq
      · have hsub : ¬ ((y : H)⁻¹ * ⟨x⁻¹ * g * x, hx⟩ * y) ∈ H'.subgroupOf H := by
          change ¬ (((y : H) : G)⁻¹ * (x⁻¹ * g * x) * (y : H) ∈ H')
          simpa [hmul] using hxy
        rw [dif_neg hsub, dif_neg hxy]
    · -- If `x⁻¹ g x` misses `H`, then it also misses the smaller subgroup `H'`.
      have hall : ∀ y : H, φ (x * y) = 0 := by
        intro y
        dsimp [φ]
        by_cases hxy : (x * y : G)⁻¹ * g * (x * y : G) ∈ H'
        · exfalso
          apply hx
          have hxyH : (x * y : G)⁻¹ * g * (x * y : G) ∈ H := hH'H hxy
          simpa [mul_assoc] using
            H.mul_mem (H.mul_mem y.2 hxyH) (H.inv_mem y.2)
        · rw [dif_neg hxy]
      rw [dif_neg hx]
      simp [hall]
  -- Expand both induction operators and collapse the double sum by the bijection
  -- `(x, y) ↦ (x * y, y)` on `G × H`.
  calc
    (H.classFunctionInduction
        (((H'.subgroupOf H).classFunctionInduction
          (classFunctionTransport (subgroupOfEquivOfLe hH'H) χ' :
            H'.subgroupOf H → ℂ)) : H → ℂ) : G → ℂ) g =
      ((↑(Nat.card ↥H) : ℂ)⁻¹) * ∑ x : G,
        ((↑(Nat.card ↥H') : ℂ)⁻¹) * ∑ y : H, φ (x * y) := by
      change ((↑(Nat.card ↥H) : ℂ)⁻¹) *
          ∑ s : G,
            (if hsg : s⁻¹ * g * s ∈ H then
              Subgroup.inducedClassFunction (H'.subgroupOf H)
                (fun x : H'.subgroupOf H ↦
                  (classFunctionTransport (Subgroup.subgroupOfEquivOfLe hH'H) χ' :
                    H'.subgroupOf H → ℂ) x)
                ⟨s⁻¹ * g * s, hsg⟩
            else
              0) = _
      congr 1
      apply Finset.sum_congr rfl
      intro x hx
      rw [Subgroup.inducedClassFunction, hcard]
      exact hinner x
    _ = ((↑(Nat.card ↥H) : ℂ)⁻¹) *
        (((↑(Nat.card ↥H') : ℂ)⁻¹) * ∑ x : G, ∑ y : H, φ (x * y)) := by
      simp [Finset.mul_sum]
    _ = ((↑(Nat.card ↥H) : ℂ)⁻¹) *
        (((↑(Nat.card ↥H') : ℂ)⁻¹) * ∑ p : G × H, φ (p.1 * p.2)) := by
      congr 2
      rw [Fintype.sum_prod_type]
    _ = ((↑(Nat.card ↥H) : ℂ)⁻¹) *
        (((↑(Nat.card ↥H') : ℂ)⁻¹) * ∑ p : G × H, φ p.1) := by
      congr 2
      let e : G × H ≃ G × H :=
        { toFun := fun p ↦ (p.1 * p.2, p.2)
          invFun := fun p ↦ (p.1 * p.2⁻¹, p.2)
          left_inv := by
            intro p
            ext <;> simp [mul_assoc]
          right_inv := by
            intro p
            ext <;> simp [mul_assoc] }
      exact Fintype.sum_equiv e
        (fun p : G × H ↦ φ (p.1 * p.2))
        (fun p : G × H ↦ φ p.1)
        (fun p ↦ rfl)
    _ = ((↑(Nat.card ↥H) : ℂ)⁻¹) *
        (((↑(Nat.card ↥H') : ℂ)⁻¹) * ((↑(Nat.card ↥H) : ℂ) * ∑ z : G, φ z)) := by
      congr 2
      calc
        ∑ p : G × H, φ p.1 = ∑ z : G, ∑ y : H, φ z := by
          rw [Fintype.sum_prod_type]
        _ = ∑ z : G, (↑(Nat.card ↥H) : ℂ) * φ z := by
          simp
        _ = (↑(Nat.card ↥H) : ℂ) * ∑ z : G, φ z := by
          rw [Finset.mul_sum]
    _ = (↑(Nat.card ↥H') : ℂ)⁻¹ * ∑ z : G, φ z := by
      have hH0 : (↑(Nat.card ↥H) : ℂ) ≠ 0 := by
        exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
      field_simp [hH0, mul_assoc]
    _ = (H'.classFunctionInduction (χ' : H' → ℂ) : G → ℂ) g := by
      simp [Subgroup.inducedClassFunction, φ]

/-- Helper for Exercise 9-9.3-1: inducing a class function from a conjugate subgroup gives the
same class function on `G` as inducing before conjugation. -/
private theorem classFunctionInduction_conjugate_transport_eq
    (H : Subgroup G) (s : G) (χ : classFunctionSubspace H) :
    ((((MulAut.conj s • H : Subgroup G)).classFunctionInduction
      (conjugateClassFunctionTransport H s χ : ((MulAut.conj s • H : Subgroup G) → ℂ))) :
        G → ℂ) =
      (H.classFunctionInduction (χ : H → ℂ) : G → ℂ) := by
  classical
  let _ : DecidablePred fun z : G ↦ z ∈ H := Classical.decPred _
  let _ : DecidablePred fun z : G ↦ z ∈ (MulAut.conj s • H : Subgroup G) := Classical.decPred _
  ext g
  have hcard : Nat.card (MulAut.conj s • H : Subgroup G) = Nat.card H := by
    exact Nat.card_congr (((MulAut.conj s).subgroupMap H).symm.toEquiv)
  rw [Subgroup.classFunctionInduction_apply, Subgroup.classFunctionInduction_apply,
    Subgroup.inducedClassFunction, Subgroup.inducedClassFunction, hcard]
  let e : G ≃ G := Equiv.mulRight s
  exact congrArg (fun t : ℂ ↦ (↑(Nat.card ↥H) : ℂ)⁻¹ * t) <|
    Fintype.sum_equiv e
      (fun x : G ↦
        if hxs : x⁻¹ * g * x ∈ (MulAut.conj s • H : Subgroup G) then
          (χ : H → ℂ) (((MulAut.conj s).subgroupMap H).symm ⟨x⁻¹ * g * x, hxs⟩)
        else
          0)
      (fun x : G ↦
        if hxH : x⁻¹ * g * x ∈ H then
          (χ : H → ℂ) ⟨x⁻¹ * g * x, hxH⟩
        else
          0)
      (fun x ↦ by
        change
          (if hxs : x⁻¹ * g * x ∈ (MulAut.conj s • H : Subgroup G) then
            (χ : H → ℂ) (((MulAut.conj s).subgroupMap H).symm ⟨x⁻¹ * g * x, hxs⟩)
          else
            0) =
          if hxH : (x * s)⁻¹ * g * (x * s) ∈ H then
            (χ : H → ℂ) ⟨(x * s)⁻¹ * g * (x * s), hxH⟩
          else
            0
        by_cases hxs : x⁻¹ * g * x ∈ (MulAut.conj s • H : Subgroup G)
        · have hxH : ((x * s) : G)⁻¹ * g * (x * s) ∈ H := by
            change x⁻¹ * g * x ∈ H.map (MulAut.conj s).toMonoidHom at hxs
            simpa [mul_assoc] using
              (Subgroup.mem_map_equiv (f := MulAut.conj s) (K := H)).1 hxs
          have hsub :
              (((MulAut.conj s).subgroupMap H).symm ⟨x⁻¹ * g * x, hxs⟩ : H) =
                ⟨(x * s)⁻¹ * g * (x * s), hxH⟩ := by
            apply Subtype.ext
            simp [MulEquiv.subgroupMap_symm_apply, mul_assoc]
          rw [dif_pos hxs, dif_pos hxH]
          simpa using congrArg (fun z : H ↦ (χ : H → ℂ) z) hsub
        · have hxH : ¬ ((x * s) : G)⁻¹ * g * (x * s) ∈ H := by
            intro hxH
            apply hxs
            change x⁻¹ * g * x ∈ H.map (MulAut.conj s).toMonoidHom
            exact (Subgroup.mem_map_equiv (f := MulAut.conj s) (K := H)).2 <|
              by simpa [mul_assoc] using hxH
          rw [dif_neg hxs, dif_neg hxH])

-- Proof sketch: induction in stages gives `Ind_H^G (Ind_{H'}^H χ') = Ind_{H'}^G χ'`, so the
-- family supported on `H` and `H'` with values `Ind_{H'}^H χ'` and `-χ'` maps to zero under the
-- total induction map.
/-- The induction-in-stages relation lies in the rational Artin-induction kernel. -/
theorem inductionInStagesRelation_mem_artinInductionMap_ker (X : Finset (Subgroup G))
    (H H' : X) (hH'H : H'.1 ≤ H.1) (χ' : classFunctionSubspace H'.1) :
    inductionInStagesRelation X H H' hH'H χ' ∈ (artinInductionMap X).ker := by
  classical
  -- Split the relation into its two supported coordinates and simplify each Artin-induction term.
  rw [LinearMap.mem_ker]
  ext g
  -- The first summand is the two-step induction, and the second is its negative direct form.
  have hstageg := congrFun (classFunctionInduction_subgroupOf_transport_eq hH'H χ') g
  simpa [inductionInStagesRelation, artinInductionMap_pi_single, sub_eq_add_neg] using
    sub_eq_zero.mpr hstageg

-- Proof sketch: induction commutes with conjugation of subgroup data, so the contributions of
-- `χ` on `H` and of the conjugate class function on `sHs⁻¹` induce to the same class function on
-- `G`.
/-- The conjugation relation lies in the rational Artin-induction kernel. -/
theorem conjugationRelation_mem_artinInductionMap_ker (X : Finset (Subgroup G))
    (H : X) (s : G) (hHs : (s •ᶜ H.1) ∈ X)
    (χ : classFunctionSubspace H.1) :
    conjugationRelation X H s hHs χ ∈ (artinInductionMap X).ker := by
  classical
  -- Split the relation into its two supported coordinates and compare the two induced functions.
  rw [LinearMap.mem_ker]
  ext g
  -- Conjugation transport changes the subgroup label but not the induced class function on `G`.
  have hconjg := congrFun (classFunctionInduction_conjugate_transport_eq H.1 s χ) g
  simpa [conjugationRelation, artinInductionMap_pi_single, sub_eq_add_neg] using
    sub_eq_zero.mpr hconjg.symm

/-- Helper for Exercise 9-9.3-1: every generator relation from parts (a) and (b) already lies in
the Artin-induction kernel, so their span is contained in the kernel. -/
theorem artinInductionRelations_le_artinInductionMap_ker (X : Finset (Subgroup G)) :
    artinInductionRelations X ≤ (artinInductionMap X).ker := by
  -- It suffices to check the two declared generating families of the relation submodule.
  refine Submodule.span_le.2 ?_
  intro ξ hξ
  rcases hξ with hξ | hξ
  · rcases hξ with ⟨H, H', hH'H, χ', rfl⟩
    exact inductionInStagesRelation_mem_artinInductionMap_ker X H H' hH'H χ'
  · rcases hξ with ⟨H, s, hHs, χ, rfl⟩
    exact conjugationRelation_mem_artinInductionMap_ker X H s hHs χ

omit [Finite G] in
/-- Helper for Exercise 9-9.3-1: restricting a global class function to a subgroup produces a
class function on that subgroup. -/
private theorem classFunctionRestriction_mem (H : Subgroup G) (χ : classFunctionSubspace G) :
    IsClassFunction (fun h : H ↦ (χ : G → ℂ) h) := by
  -- Transport the class-function invariance from the ambient group to the subgroup by forgetting
  -- the subtype witnesses.
  let hχ : IsClassFunction (χ : G → ℂ) := (mem_classFunctionSubspace_iff _).1 χ.2
  refine ⟨?_⟩
  intro x y hxy
  have hxyH : IsConj x y := (ConjClasses.mk_eq_mk_iff_isConj).1 hxy
  have hxyG : IsConj (x : G) (y : G) := by
    rw [isConj_iff] at hxyH ⊢
    rcases hxyH with ⟨c, hc⟩
    exact ⟨(c : G), by simpa using congrArg Subtype.val hc⟩
  exact hχ.eq_of_isConj hxyG

/-- Helper for Exercise 9-9.3-1: restriction from `G` to a subgroup `H` on complex class
functions. -/
private def localClassFunctionRestriction (H : Subgroup G) :
    classFunctionSubspace G →ₗ[ℂ] classFunctionSubspace H :=
  LinearMap.codRestrict (classFunctionSubspace H)
    (((LinearMap.funLeft ℂ ℂ H.subtype).comp (classFunctionSubspace G).subtype))
    (classFunctionRestriction_mem H)

/-- Helper for Exercise 9-9.3-1: source-facing shorthand for the local subgroup restriction map.
-/
private abbrev subgroupClassFunctionRestriction (H : Subgroup G) :
    classFunctionSubspace G →ₗ[ℂ] classFunctionSubspace H :=
  localClassFunctionRestriction H

omit [Finite G] in
/-- Helper for Exercise 9-9.3-1: evaluating the subgroup restriction is just ambient evaluation on
the underlying group element. -/
@[simp] private theorem subgroupClassFunctionRestriction_apply (H : Subgroup G)
    (χ : classFunctionSubspace G) (h : H) :
    (subgroupClassFunctionRestriction H χ : H → ℂ) h = (χ : G → ℂ) h :=
  rfl

/-- Helper for Exercise 9-9.3-1: the global-to-local restriction map sending a class function on
`G` to its family of restrictions on the subgroups in `X`. -/
private def restrictionFamily (X : Finset (Subgroup G)) :
    classFunctionSubspace G →ₗ[ℂ] artinInductionSource X :=
  LinearMap.pi fun H : X ↦ subgroupClassFunctionRestriction H.1

omit [Finite G] in
/-- Helper for Exercise 9-9.3-1: evaluating the restriction-family map at a subgroup recovers the
corresponding subgroup restriction. -/
@[simp] private theorem restrictionFamily_apply (X : Finset (Subgroup G))
    (χ : classFunctionSubspace G) (H : X) :
    restrictionFamily X χ H = subgroupClassFunctionRestriction H.1 χ :=
  rfl

/-- Helper for Exercise 9-9.3-1: a subgroup-indexed family is compatible when it respects
subgroup restriction and conjugation transport. -/
private def CompatibleFamily (X : Finset (Subgroup G))
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    (φ : artinInductionSource X) : Prop :=
  (∀ {H H' : X} (hH'H : H'.1 ≤ H.1) (x : H'.1),
      (φ H' : H'.1 → ℂ) x = (φ H : H.1 → ℂ) ⟨x.1, hH'H x.2⟩) ∧
    ∀ (H : X) (s : G) (x : (s •ᶜ H.1)),
      (φ ⟨(s •ᶜ H.1), hconj H.2 s⟩ : (s •ᶜ H.1) → ℂ) x =
        (conjugateClassFunctionTransport H.1 s (φ H) : (s •ᶜ H.1) → ℂ) x

