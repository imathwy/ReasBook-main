/-- Helper for Exercise 9-9.3-1: restricting a global class function along nested subgroup
inclusions is automatically compatible with further restriction. -/
private theorem restrictionFamily_subgroup_compatible (X : Finset (Subgroup G))
    (χ : classFunctionSubspace G) {H H' : X} (hH'H : H'.1 ≤ H.1) (x : H'.1) :
    (restrictionFamily X χ H' : H'.1 → ℂ) x =
      (restrictionFamily X χ H : H.1 → ℂ) ⟨x.1, hH'H x.2⟩ := by
  -- Both sides evaluate the same ambient class function at the same underlying group element.
  simp [restrictionFamily_apply, subgroupClassFunctionRestriction_apply]

