/-- Helper for Exercise 9-9.3-1: under a conjugacy cover, the restriction family determines a
global class function uniquely. -/
private theorem restrictionFamily_injective_of_conjugacy_cover (X : Finset (Subgroup G))
    (hcover : is_conjugacy_cover X) :
    Function.Injective (restrictionFamily X) := by
  intro χ ψ hχψ
  ext g
  -- Move `g` into one subgroup from `X`; there the two restriction families agree by hypothesis.
  rcases (is_conjugacy_cover_iff X).1 hcover g with ⟨H, hHX, hgH⟩
  rcases Group.mem_conjugatesOfSet_iff.1 hgH with ⟨x, hxH, hxconj⟩
  have hH :
      restrictionFamily X χ ⟨H, hHX⟩ = restrictionFamily X ψ ⟨H, hHX⟩ := by
    exact congrArg (fun Φ : artinInductionSource X ↦ Φ ⟨H, hHX⟩) hχψ
  have hrestrict :
      (subgroupClassFunctionRestriction H χ : H → ℂ) ⟨x, hxH⟩ =
        (subgroupClassFunctionRestriction H ψ : H → ℂ) ⟨x, hxH⟩ := by
    simpa using congrArg (fun f : classFunctionSubspace H ↦ (f : H → ℂ) ⟨x, hxH⟩) hH
  have hχ : IsClassFunction (χ : G → ℂ) := (mem_classFunctionSubspace_iff _).1 χ.2
  have hψ : IsClassFunction (ψ : G → ℂ) := (mem_classFunctionSubspace_iff _).1 ψ.2
  calc
    (χ : G → ℂ) g = (χ : G → ℂ) x := by
      exact (hχ.eq_of_isConj hxconj).symm
    _ = (ψ : G → ℂ) x := by
      simpa [subgroupClassFunctionRestriction_apply] using hrestrict
    _ = (ψ : G → ℂ) g := by
      exact hψ.eq_of_isConj hxconj

