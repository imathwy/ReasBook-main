/-- Helper for Exercise 9-9.3-1: a compatible family assigns the same value to any two subgroup
elements that are conjugate in the ambient group. -/
private theorem compatibleFamily_value_eq_of_isConj
    (X : Finset (Subgroup G))
    (hsubgroups : ∀ {H H' : Subgroup G}, H ∈ X → H' ≤ H → H' ∈ X)
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    {φ : artinInductionSource X}
    (hφ : CompatibleFamily X hconj φ)
    {H K : X} {x : H.1} {y : K.1}
    (hxy : IsConj (x : G) (y : G)) :
    (φ H : H.1 → ℂ) x = (φ K : K.1 → ℂ) y := by
  rcases hφ with ⟨hres, hcompat⟩
  rcases isConj_iff.1 hxy with ⟨s, hs⟩
  let J : X := ⟨s •ᶜ H.1, hconj H.2 s⟩
  have hyJ : (y : G) ∈ J.1 := by
    change (y : G) ∈ H.1.map (MulAut.conj s).toMonoidHom
    rw [Subgroup.mem_map_equiv (f := MulAut.conj s) (K := H.1)]
    change s⁻¹ * (y : G) * s ∈ H.1
    have hsy : s⁻¹ * (y : G) * s = x := by
      calc
        s⁻¹ * (y : G) * s = s⁻¹ * (s * x * s⁻¹) * s := by rw [hs]
        _ = x := by simp [mul_assoc]
    simp [hsy]
  let yJ : J.1 := ⟨y, hyJ⟩
  let C : Subgroup G := Subgroup.zpowers (y : G)
  let CX : X := ⟨C, hsubgroups K.2 (Subgroup.zpowers_le.2 y.2)⟩
  let yC : C := ⟨y, Subgroup.mem_zpowers (y : G)⟩
  have hCJ : C ≤ J.1 := Subgroup.zpowers_le.2 hyJ
  have hCYK :
      (φ CX : C → ℂ) yC = (φ K : K.1 → ℂ) y := by
    -- Restrict the `K`-coordinate further down to the cyclic subgroup generated by `y`.
    simpa [CX, C, yC] using hres (H := K) (H' := CX) (Subgroup.zpowers_le.2 y.2) yC
  have hCYJ :
      (φ CX : C → ℂ) yC = (φ J : J.1 → ℂ) yJ := by
    -- The same cyclic subgroup also sits inside the conjugate of `H`, so the compatible family
    -- gives the same value there as well.
    simpa [CX, C, yC, J, yJ] using hres (H := J) (H' := CX) hCJ yC
  have hJH :
      (φ J : J.1 → ℂ) yJ = (φ H : H.1 → ℂ) x := by
    -- Conjugation compatibility transports the `H`-value at `x` to the conjugate subgroup value
    -- at `y = s x s⁻¹`.
    have hxeq : (((MulAut.conj s).subgroupMap H.1).symm yJ) = x := by
      apply Subtype.ext
      change s⁻¹ * ((yJ : J.1) : G) * s = x
      calc
        s⁻¹ * ((yJ : J.1) : G) * s = s⁻¹ * (s * x * s⁻¹) * s := by
          change s⁻¹ * (y : G) * s = s⁻¹ * (s * x * s⁻¹) * s
          rw [hs]
        _ = x := by simp [mul_assoc]
    calc
      (φ J : J.1 → ℂ) yJ =
          (conjugateClassFunctionTransport H.1 s (φ H) : J.1 → ℂ) yJ := by
            exact hcompat H s yJ
      _ = (φ H : H.1 → ℂ) x := by
            simp [conjugateClassFunctionTransport_apply, hxeq]
  calc
    (φ H : H.1 → ℂ) x = (φ J : J.1 → ℂ) yJ := hJH.symm
    _ = (φ CX : C → ℂ) yC := hCYJ.symm
    _ = (φ K : K.1 → ℂ) y := hCYK

