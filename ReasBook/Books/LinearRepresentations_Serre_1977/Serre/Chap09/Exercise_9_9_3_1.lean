/-- Helper for Exercise 9-9.3-1: evaluating inversion transport is pointwise inversion of the
group argument. -/
@[simp] private theorem inverseClassFunctionTransport_apply
    (χ : classFunctionSubspace G) (g : G) :
    (inverseClassFunctionTransport χ : G → ℂ) g = (χ : G → ℂ) g⁻¹ :=
  rfl

/-- Helper for Exercise 9-9.3-1: the normalized average of an induced class function over `G` is
the normalized average of the original class function over the subgroup. -/
private theorem classFunctionInduction_average_eq_average
    (H : Subgroup G) (ψ : H → ℂ) :
    (Nat.card G : ℂ)⁻¹ * ∑ g : G, Ind[H](ψ) g =
      (Nat.card H : ℂ)⁻¹ * ∑ h : H, ψ h := by
  classical
  let _ : DecidablePred fun x : G ↦ x ∈ H := Classical.decPred _
  -- Reindex the double sum by `(g, s) ↦ (s⁻¹ g s, s)` so the subgroup condition depends only on
  -- the first coordinate.
  have hsum :
      ∑ g : G, ∑ s : G,
        (if hsg : s⁻¹ * g * s ∈ H then ψ ⟨s⁻¹ * g * s, hsg⟩ else 0) =
        (Nat.card G : ℂ) * ∑ h : H, ψ h := by
    calc
      ∑ g : G, ∑ s : G,
          (if hsg : s⁻¹ * g * s ∈ H then ψ ⟨s⁻¹ * g * s, hsg⟩ else 0) =
        ∑ p : G × G,
          (if hsg : p.2⁻¹ * p.1 * p.2 ∈ H then ψ ⟨p.2⁻¹ * p.1 * p.2, hsg⟩ else 0) := by
            rw [Fintype.sum_prod_type]
      _ =
        ∑ p : G × G, (if hx : p.1 ∈ H then ψ ⟨p.1, hx⟩ else 0) := by
          let e : G × G ≃ G × G :=
            { toFun := fun p ↦ (p.2⁻¹ * p.1 * p.2, p.2)
              invFun := fun p ↦ (p.2 * p.1 * p.2⁻¹, p.2)
              left_inv := by
                intro p
                ext <;> simp [mul_assoc]
              right_inv := by
                intro p
                ext <;> simp [mul_assoc] }
          exact Fintype.sum_equiv e
            (fun p : G × G ↦
              if hsg : p.2⁻¹ * p.1 * p.2 ∈ H then
                ψ ⟨p.2⁻¹ * p.1 * p.2, hsg⟩
              else
                0)
            (fun p : G × G ↦ if hx : p.1 ∈ H then ψ ⟨p.1, hx⟩ else 0)
            (fun p ↦ rfl)
      _ = ∑ x : G, ∑ s : G, (if hx : x ∈ H then ψ ⟨x, hx⟩ else 0) := by
            rw [Fintype.sum_prod_type]
      _ = (Finset.univ.card : ℂ) * (∑ x : G, if hx : x ∈ H then ψ ⟨x, hx⟩ else 0) := by
            simp_rw [Finset.sum_const, nsmul_eq_mul]
            rw [← Finset.mul_sum]
      _ = (Nat.card G : ℂ) * (∑ x : G, if hx : x ∈ H then ψ ⟨x, hx⟩ else 0) := by
            simp [Nat.card_eq_fintype_card]
      _ = (Nat.card G : ℂ) * ∑ h : H, ψ h := by
            congr 1
            let e : G ≃ H ⊕ {x // x ∉ H} :=
              (Equiv.sumCompl fun x : G ↦ x ∈ H).symm
            calc
              (∑ x : G, if hx : x ∈ H then ψ ⟨x, hx⟩ else 0) =
                ∑ y : H ⊕ {x // x ∉ H},
                  match y with
                  | Sum.inl h => ψ h
                  | Sum.inr _ => 0 := by
                      refine Fintype.sum_bijective e e.bijective _ _ ?_
                      intro x
                      dsimp [e]
                      by_cases hx : x ∈ H
                      · rw [Equiv.sumCompl_symm_apply_of_pos hx]
                        simp [hx]
                      · rw [Equiv.sumCompl_symm_apply_of_neg hx]
                        simp [hx]
              _ = ∑ h : H, ψ h + ∑ z : {x // x ∉ H}, (0 : ℂ) := by
                    rw [Fintype.sum_sum_type]
              _ = ∑ h : H, ψ h := by
                    simp
  have hG0 : (Nat.card G : ℂ) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  -- After the reindexing, the ambient average collapses to the subgroup average.
  calc
    (Nat.card G : ℂ)⁻¹ * ∑ g : G, Ind[H](ψ) g =
      (Nat.card G : ℂ)⁻¹ * ((Nat.card H : ℂ)⁻¹ *
        ∑ g : G, ∑ s : G,
          (if hsg : s⁻¹ * g * s ∈ H then ψ ⟨s⁻¹ * g * s, hsg⟩ else 0)) := by
            simp [Subgroup.inducedClassFunction, Finset.mul_sum, mul_assoc]
    _ = (Nat.card G : ℂ)⁻¹ * ((Nat.card H : ℂ)⁻¹ *
          ((Nat.card G : ℂ) * ∑ h : H, ψ h)) := by
            rw [hsum]
    _ = (Nat.card H : ℂ)⁻¹ * ∑ h : H, ψ h := by
          field_simp [hG0, mul_assoc]

/-- Helper for Exercise 9-9.3-1: multiplying an induced class function by a global class function
is the same as inducing after restricting that second factor. -/
private theorem induced_mul_eq_induced_mul_classFunctionRestriction_local
    (H : Subgroup G) (ψ : H → ℂ) (φ : classFunctionSubspace G) :
    Ind[H](ψ) * (φ : G → ℂ) =
      Ind[H](fun h : H ↦ ψ h * (subgroupClassFunctionRestriction H φ : H → ℂ) h) := by
  classical
  -- Compare the two induced functions pointwise and replace the ambient value of `φ` by its
  -- conjugacy-invariant value on the subgroup element contributing to the induction summand.
  ext x
  simp only [Pi.mul_apply, Subgroup.inducedClassFunction]
  rw [mul_assoc, Finset.sum_mul]
  have hsum :
      ∑ s : G,
        (if hsx : s⁻¹ * x * s ∈ H then ψ ⟨s⁻¹ * x * s, hsx⟩ else 0) * (φ : G → ℂ) x =
      ∑ s : G,
        if hsx : s⁻¹ * x * s ∈ H then
          ψ ⟨s⁻¹ * x * s, hsx⟩ *
            (subgroupClassFunctionRestriction H φ : H → ℂ) ⟨s⁻¹ * x * s, hsx⟩
        else
          0 := by
    refine Finset.sum_congr rfl ?_
    intro s hs
    by_cases hsx : s⁻¹ * x * s ∈ H
    · have hsx' : s⁻¹ * (x * s) ∈ H := by
        simpa [mul_assoc] using hsx
      have hφ :
          (φ : G → ℂ) (s⁻¹ * x * s) = (φ : G → ℂ) x := by
        exact ((mem_classFunctionSubspace_iff _).1 φ.2).eq_of_isConj <|
          isConj_iff.2 ⟨s, by group⟩
      have hφ' :
          (φ : G → ℂ) (s⁻¹ * (x * s)) = (φ : G → ℂ) x := by
        simpa [mul_assoc] using hφ
      simp [hsx', subgroupClassFunctionRestriction_apply, hφ', mul_comm, mul_assoc]
    · simp [hsx]
  rw [hsum]

/-- Helper for Exercise 9-9.3-1: the normalized pairing is invariant under transport along a group
isomorphism when the second factor is transported back by the inverse isomorphism. -/
private theorem groupFunctionPairing_classFunctionTransport_eq
    {H J : Type u} [Group H] [Group J] [Finite H] [Finite J]
    (e : H ≃* J) (χ : classFunctionSubspace J) (ψ : classFunctionSubspace H) :
    Representation.groupFunctionPairingOverField ℂ
        (classFunctionTransport e χ : H → ℂ) (ψ : H → ℂ) =
      Representation.groupFunctionPairingOverField ℂ
        (χ : J → ℂ) (classFunctionTransport e.symm ψ : J → ℂ) := by
  -- Rewrite both pairings as explicit averages and reindex the finite sum by the group
  -- isomorphism.
  rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
  rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
  have hcard : Nat.card H = Nat.card J := Nat.card_congr e.toEquiv
  rw [hcard]
  refine congrArg (fun z : ℂ ↦ (Nat.card J : ℂ)⁻¹ * z) ?_
  simpa using Equiv.sum_comp e.toEquiv
    (fun y : J ↦
      (χ : J → ℂ) y *
        (classFunctionTransport e.symm ψ : J → ℂ) y⁻¹)

/-- Helper for Exercise 9-9.3-1: Frobenius reciprocity for the normalized class-function pairing,
stated for subgroup induction and ambient restriction. -/
private theorem groupFunctionPairing_classFunctionInduction_eq_restriction
    (H : Subgroup G) (ψ : classFunctionSubspace H) (φ : classFunctionSubspace G) :
    Representation.groupFunctionPairingOverField ℂ
        (H.classFunctionInduction (ψ : H → ℂ) : G → ℂ) (φ : G → ℂ) =
      Representation.groupFunctionPairingOverField ℂ
        (ψ : H → ℂ) (subgroupClassFunctionRestriction H φ : H → ℂ) := by
  -- Rewrite the ambient pairing as an average of a product, push the product through induction,
  -- and then collapse the average back down to `H`.
  rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
  have hmul :=
    induced_mul_eq_induced_mul_classFunctionRestriction_local H (ψ : H → ℂ)
      (inverseClassFunctionTransport φ)
  calc
    (Nat.card G : ℂ)⁻¹ *
        (∑ t : G, (H.classFunctionInduction (ψ : H → ℂ) : G → ℂ) t * (φ : G → ℂ) t⁻¹) =
      (Nat.card G : ℂ)⁻¹ *
        (∑ t : G,
          (Ind[H]((ψ : H → ℂ)) * (inverseClassFunctionTransport φ : G → ℂ)) t) := by
            simp [Subgroup.classFunctionInduction_apply]
    _ = (Nat.card G : ℂ)⁻¹ *
        (∑ t : G,
          Ind[H](fun h : H ↦
            (ψ : H → ℂ) h *
              (subgroupClassFunctionRestriction H (inverseClassFunctionTransport φ) : H → ℂ) h) t) := by
            rw [hmul]
    _ = (Nat.card H : ℂ)⁻¹ *
        (∑ h : H,
          (ψ : H → ℂ) h *
            (subgroupClassFunctionRestriction H (inverseClassFunctionTransport φ) : H → ℂ) h) := by
            simpa using
              classFunctionInduction_average_eq_average H
                (fun h : H ↦
                  (ψ : H → ℂ) h *
                    (subgroupClassFunctionRestriction H (inverseClassFunctionTransport φ) : H → ℂ) h)
    _ = Representation.groupFunctionPairingOverField ℂ
          (ψ : H → ℂ) (subgroupClassFunctionRestriction H φ : H → ℂ) := by
          rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
          simp [subgroupClassFunctionRestriction_apply]

/-- Helper for Exercise 9-9.3-1: every nonzero class function has a nonzero pairing with a
conjugacy-class indicator on its own group. -/
private theorem classFunctionPairing_exists_not_orthogonal
    {H : Subgroup G} {φ : classFunctionSubspace H} (hφ : φ ≠ 0) :
    ∃ ψ : classFunctionSubspace H,
      Representation.groupFunctionPairingOverField ℂ (φ : H → ℂ) (ψ : H → ℂ) ≠ 0 := by
  classical
  have hx :
      ∃ x : H, (φ : H → ℂ) x ≠ 0 := by
    by_contra hx
    apply hφ
    ext x
    by_contra hx0
    exact hx ⟨x, hx0⟩
  rcases hx with ⟨x, hx⟩
  let carrier : Set H := (ConjClasses.mk x).carrier
  let S : Finset H := Finset.univ.filter (fun t : H ↦ t ∈ carrier)
  let ψ : classFunctionSubspace H := (ConjClasses.mk x⁻¹).indicatorClassFunction
  have hmem_inv :
      ∀ t : H, t⁻¹ ∈ (ConjClasses.mk x⁻¹).carrier ↔ t ∈ carrier := by
    intro t
    constructor
    · intro ht
      have hconj : IsConj t⁻¹ x⁻¹ := by
        exact (ConjClasses.mk_eq_mk_iff_isConj).1 <|
          (ConjClasses.mem_carrier_iff_mk_eq).1 ht
      have hconj' : IsConj t x := by
        rcases isConj_iff.1 hconj with ⟨a, ha⟩
        refine isConj_iff.2 ⟨a, ?_⟩
        simpa [mul_assoc] using congrArg Inv.inv ha
      exact (ConjClasses.mem_carrier_iff_mk_eq).2 <|
        (ConjClasses.mk_eq_mk_iff_isConj).2 hconj'
    · intro ht
      have hconj : IsConj t x := by
        exact (ConjClasses.mk_eq_mk_iff_isConj).1 <|
          (ConjClasses.mem_carrier_iff_mk_eq).1 ht
      have hconj' : IsConj t⁻¹ x⁻¹ := by
        rcases isConj_iff.1 hconj with ⟨a, ha⟩
        refine isConj_iff.2 ⟨a, ?_⟩
        simpa [mul_assoc] using congrArg Inv.inv ha
      exact (ConjClasses.mem_carrier_iff_mk_eq).2 <|
        (ConjClasses.mk_eq_mk_iff_isConj).2 hconj'
  have hpair :
      Representation.groupFunctionPairingOverField ℂ
          (φ : H → ℂ) (ψ : H → ℂ) =
        ((Nat.card carrier : ℂ) / Nat.card H) * (φ : H → ℂ) x := by
    rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
    calc
      (↑(Nat.card H) : ℂ)⁻¹ * ∑ t : H, (φ : H → ℂ) t * (ψ : H → ℂ) t⁻¹ =
        (↑(Nat.card H) : ℂ)⁻¹ * Finset.sum S (fun t ↦ (φ : H → ℂ) t) := by
          congr 1
          simp [ψ, carrier, S, ConjClasses.indicator, Set.indicator, Finset.sum_filter,
            hmem_inv, mul_comm]
      _ = (↑(Nat.card H) : ℂ)⁻¹ * (S.card * (φ : H → ℂ) x) := by
          congr 1
          calc
            Finset.sum S (fun t ↦ (φ : H → ℂ) t) =
                Finset.sum S (fun _ ↦ (φ : H → ℂ) x) := by
                  refine Finset.sum_congr rfl ?_
                  intro t ht
                  have ht' : t ∈ carrier := by
                    simpa [S] using (Finset.mem_filter.1 ht).2
                  have hconj : IsConj t x := by
                    exact (ConjClasses.mk_eq_mk_iff_isConj).1 <|
                      (ConjClasses.mem_carrier_iff_mk_eq).1 ht'
                  exact ((mem_classFunctionSubspace_iff _).1 φ.2).eq_of_isConj hconj
            _ = S.card * (φ : H → ℂ) x := by
                  simp [nsmul_eq_mul]
      _ = ((Nat.card carrier : ℂ) / Nat.card H) * (φ : H → ℂ) x := by
          have hcard : S.card = Nat.card carrier := by
            let _ : Fintype carrier := Fintype.ofFinite carrier
            rw [Nat.card_eq_fintype_card]
            symm
            exact Fintype.card_of_subtype S (fun t ↦ by simp [S, carrier])
          rw [hcard]
          simp [div_eq_mul_inv, mul_assoc, mul_comm]
  have hcarrier_ne : (Nat.card carrier : ℂ) ≠ 0 := by
    let _ : Nonempty carrier := ⟨⟨x, ConjClasses.mem_carrier_iff_mk_eq.mpr rfl⟩⟩
    exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  have hH_ne : (Nat.card H : ℂ) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  refine ⟨ψ, ?_⟩
  rw [hpair]
  exact mul_ne_zero (div_ne_zero hcarrier_ne hH_ne) hx

/-- Helper for Exercise 9-9.3-1: pairing an induction-in-stages relation against a family measures
the failure of subgroup-restriction compatibility. -/
private theorem artinSourcePairing_inductionInStagesRelation_eq
    (X : Finset (Subgroup G)) (H H' : X) (hH'H : H'.1 ≤ H.1)
    (χ' : classFunctionSubspace H'.1) (φ : artinInductionSource X) :
    artinSourcePairing X (inductionInStagesRelation X H H' hH'H χ') φ =
      Representation.groupFunctionPairingOverField ℂ
        (χ' : H'.1 → ℂ)
        ((classFunctionTransport (subgroupOfEquivOfLe hH'H).symm
            (subgroupClassFunctionRestriction (H'.1.subgroupOf H.1) (φ H)) - φ H') : H'.1 → ℂ) := by
  classical
  -- Expand the two supported coordinates and rewrite the `H`-coordinate by Frobenius
  -- reciprocity followed by transport across `subgroupOfEquivOfLe hH'H`.
  calc
    artinSourcePairing X (inductionInStagesRelation X H H' hH'H χ') φ =
      Representation.groupFunctionPairingOverField ℂ
        (((H'.1.subgroupOf H.1).classFunctionInduction
            (classFunctionTransport (subgroupOfEquivOfLe hH'H) χ' :
              H'.1.subgroupOf H.1 → ℂ)) : H.1 → ℂ)
        (φ H : H.1 → ℂ) -
        Representation.groupFunctionPairingOverField ℂ
          (χ' : H'.1 → ℂ) (φ H' : H'.1 → ℂ) := by
        rw [inductionInStagesRelation]
        simp [artinSourcePairing_pi_single_left]
        have hneg :
            Representation.groupFunctionPairingOverField ℂ (-((χ' : classFunctionSubspace H'.1) :
              H'.1 → ℂ)) (φ H' : H'.1 → ℂ) =
              -Representation.groupFunctionPairingOverField ℂ
                (χ' : H'.1 → ℂ) (φ H' : H'.1 → ℂ) := by
          simpa using
            (Representation.groupFunctionPairing_smul_left (-1 : ℂ)
              (χ' : H'.1 → ℂ) (φ H' : H'.1 → ℂ))
        rw [hneg, sub_eq_add_neg]
    _ =
      Representation.groupFunctionPairingOverField ℂ
        (classFunctionTransport (subgroupOfEquivOfLe hH'H) χ' :
          H'.1.subgroupOf H.1 → ℂ)
        (subgroupClassFunctionRestriction (H'.1.subgroupOf H.1) (φ H) :
          H'.1.subgroupOf H.1 → ℂ) -
        Representation.groupFunctionPairingOverField ℂ
          (χ' : H'.1 → ℂ) (φ H' : H'.1 → ℂ) := by
        rw [groupFunctionPairing_classFunctionInduction_eq_restriction]
    _ =
      Representation.groupFunctionPairingOverField ℂ
        (χ' : H'.1 → ℂ)
        (classFunctionTransport (subgroupOfEquivOfLe hH'H).symm
          (subgroupClassFunctionRestriction (H'.1.subgroupOf H.1) (φ H)) : H'.1 → ℂ) -
        Representation.groupFunctionPairingOverField ℂ
          (χ' : H'.1 → ℂ) (φ H' : H'.1 → ℂ) := by
        rw [groupFunctionPairing_classFunctionTransport_eq
          (subgroupOfEquivOfLe hH'H) χ'
          (subgroupClassFunctionRestriction (H'.1.subgroupOf H.1) (φ H))]
    _ =
      Representation.groupFunctionPairingOverField ℂ
        (χ' : H'.1 → ℂ)
        ((classFunctionTransport (subgroupOfEquivOfLe hH'H).symm
            (subgroupClassFunctionRestriction (H'.1.subgroupOf H.1) (φ H)) - φ H') : H'.1 → ℂ) := by
        have hneg :
            Representation.groupFunctionPairingOverField ℂ
              (χ' : H'.1 → ℂ) (-((φ H' : classFunctionSubspace H'.1) : H'.1 → ℂ)) =
                -Representation.groupFunctionPairingOverField ℂ
                  (χ' : H'.1 → ℂ) (φ H' : H'.1 → ℂ) := by
          simpa using
            (Representation.groupFunctionPairing_smul_right (-1 : ℂ)
              (χ' : H'.1 → ℂ) (φ H' : H'.1 → ℂ))
        simp [sub_eq_add_neg, Representation.groupFunctionPairing_add_right, hneg]

/-- Helper for Exercise 9-9.3-1: pairing a conjugation relation against a family measures the
failure of conjugation compatibility. -/
private theorem artinSourcePairing_conjugationRelation_eq
    (X : Finset (Subgroup G)) (H : X) (s : G) (hHs : (s •ᶜ H.1) ∈ X)
    (χ : classFunctionSubspace H.1) (φ : artinInductionSource X) :
    artinSourcePairing X (conjugationRelation X H s hHs χ) φ =
      Representation.groupFunctionPairingOverField ℂ
        (χ : H.1 → ℂ)
        ((φ H -
            classFunctionTransport ((MulAut.conj s).subgroupMap H.1)
              (φ ⟨(s •ᶜ H.1), hHs⟩)) : H.1 → ℂ) := by
  classical
  -- Expand the two supported coordinates and transport the conjugate-subgroup term back along
  -- the subgroup conjugation isomorphism.
  calc
    artinSourcePairing X (conjugationRelation X H s hHs χ) φ =
      Representation.groupFunctionPairingOverField ℂ
        (χ : H.1 → ℂ) (φ H : H.1 → ℂ) -
        Representation.groupFunctionPairingOverField ℂ
          (conjugateClassFunctionTransport H.1 s χ : (s •ᶜ H.1) → ℂ)
          (φ ⟨(s •ᶜ H.1), hHs⟩ : (s •ᶜ H.1) → ℂ) := by
        rw [conjugationRelation]
        simp [artinSourcePairing_pi_single_left]
        have hneg :
            Representation.groupFunctionPairingOverField ℂ
              (-((conjugateClassFunctionTransport H.1 s χ :
                classFunctionSubspace (s •ᶜ H.1)) : (s •ᶜ H.1) → ℂ))
              (φ ⟨(s •ᶜ H.1), hHs⟩ : (s •ᶜ H.1) → ℂ) =
                -Representation.groupFunctionPairingOverField ℂ
                  (conjugateClassFunctionTransport H.1 s χ : (s •ᶜ H.1) → ℂ)
                  (φ ⟨(s •ᶜ H.1), hHs⟩ : (s •ᶜ H.1) → ℂ) := by
          simpa using
            (Representation.groupFunctionPairing_smul_left (-1 : ℂ)
              (conjugateClassFunctionTransport H.1 s χ : (s •ᶜ H.1) → ℂ)
              (φ ⟨(s •ᶜ H.1), hHs⟩ : (s •ᶜ H.1) → ℂ))
        rw [hneg, sub_eq_add_neg]
    _ =
      Representation.groupFunctionPairingOverField ℂ
        (χ : H.1 → ℂ) (φ H : H.1 → ℂ) -
        Representation.groupFunctionPairingOverField ℂ
          (χ : H.1 → ℂ)
          (classFunctionTransport ((MulAut.conj s).subgroupMap H.1)
            (φ ⟨(s •ᶜ H.1), hHs⟩) : H.1 → ℂ) := by
        rw [show conjugateClassFunctionTransport H.1 s χ =
            classFunctionTransport (((MulAut.conj s).subgroupMap H.1).symm) χ by rfl]
        simpa using
          (groupFunctionPairing_classFunctionTransport_eq
            (((MulAut.conj s).subgroupMap H.1).symm) χ
            (φ ⟨(s •ᶜ H.1), hHs⟩))
    _ =
      Representation.groupFunctionPairingOverField ℂ
        (χ : H.1 → ℂ)
        ((φ H -
            classFunctionTransport ((MulAut.conj s).subgroupMap H.1)
              (φ ⟨(s •ᶜ H.1), hHs⟩)) : H.1 → ℂ) := by
        have hneg :
            Representation.groupFunctionPairingOverField ℂ
              (χ : H.1 → ℂ)
              (-((classFunctionTransport ((MulAut.conj s).subgroupMap H.1)
                (φ ⟨(s •ᶜ H.1), hHs⟩) : classFunctionSubspace H.1) : H.1 → ℂ)) =
                -Representation.groupFunctionPairingOverField ℂ
                  (χ : H.1 → ℂ)
                  (classFunctionTransport ((MulAut.conj s).subgroupMap H.1)
                    (φ ⟨(s •ᶜ H.1), hHs⟩) : H.1 → ℂ) := by
          simpa using
            (Representation.groupFunctionPairing_smul_right (-1 : ℂ)
              (χ : H.1 → ℂ)
              (classFunctionTransport ((MulAut.conj s).subgroupMap H.1)
                (φ ⟨(s •ᶜ H.1), hHs⟩) : H.1 → ℂ))
        simp [sub_eq_add_neg, Representation.groupFunctionPairing_add_right, hneg]

/-- Helper for Exercise 9-9.3-1: the coordinatewise source pairing is nondegenerate because each
subgroup class-function pairing is already detected by conjugacy-class indicators. -/
private theorem artinSourcePairing_nondegenerate (X : Finset (Subgroup G)) :
    (artinSourcePairing X).Nondegenerate := by
  classical
  -- Each nonzero family has a nonzero coordinate, and that coordinate is detected by the local
  -- class-function pairing against a family supported only at that subgroup.
  refine (artinSourcePairing_isRefl X).nondegenerate_iff_separatingLeft.2 ?_
  intro ξ hξ
  ext H x
  by_contra hx
  have hH : ξ H ≠ 0 := by
    intro hH
    simp [hH] at hx
  rcases classFunctionPairing_exists_not_orthogonal hH with ⟨ψ, hψ⟩
  have hz : artinSourcePairing X ξ (Pi.single H ψ) = 0 := hξ (Pi.single H ψ)
  exact hψ <| by
    simpa [artinSourcePairing_pi_single_right] using hz

/-- Helper for Exercise 9-9.3-1: orthogonality to the relation span is equivalent to Serre's
subgroup-restriction and conjugation compatibility conditions. -/
private theorem mem_artinSourcePairing_orthogonal_iff_compatibleFamily
    (X : Finset (Subgroup G))
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    {φ : artinInductionSource X} :
    φ ∈ (artinSourcePairing X).orthogonal (artinInductionRelationsC X) ↔
      CompatibleFamily X hconj φ := by
  classical
  constructor
  · intro horth
    have horth' := LinearMap.BilinForm.mem_orthogonal_iff.mp horth
    constructor
    · intro H H' hH'H x
      let δ : classFunctionSubspace H'.1 :=
        classFunctionTransport (subgroupOfEquivOfLe hH'H).symm
          (subgroupClassFunctionRestriction (H'.1.subgroupOf H.1) (φ H)) - φ H'
      have hδ : δ = 0 := by
        by_contra hδ
        rcases classFunctionPairing_exists_not_orthogonal hδ with ⟨ψ, hψ⟩
        have hgen :
            inductionInStagesRelation X H H' hH'H ψ ∈ artinInductionRelations X := by
          exact Submodule.subset_span <| Or.inl ⟨H, H', hH'H, ψ, rfl⟩
        have hzero :
            artinSourcePairing X (inductionInStagesRelation X H H' hH'H ψ) φ = 0 := by
          have hgenC :
              inductionInStagesRelation X H H' hH'H ψ ∈ artinInductionRelationsC X := by
            simpa [artinInductionRelationsC] using hgen
          simpa [LinearMap.BilinForm.IsOrtho] using horth' _ hgenC
        rw [artinSourcePairing_inductionInStagesRelation_eq] at hzero
        have hzero' :
            Representation.groupFunctionPairingOverField ℂ
              (δ : H'.1 → ℂ) (ψ : H'.1 → ℂ) = 0 := by
          simpa [δ, Representation.groupFunctionPairing_comm] using hzero
        exact hψ hzero'
      have hδfun :
          (δ : H'.1 → ℂ) = 0 := by
        exact congrArg (fun f : classFunctionSubspace H'.1 ↦ (f : H'.1 → ℂ)) hδ
      have hxδ :
          (φ H : H.1 → ℂ) ⟨x.1, hH'H x.2⟩ = (φ H' : H'.1 → ℂ) x := by
        simpa [δ, classFunctionTransport_apply, subgroupClassFunctionRestriction_apply, sub_eq_zero] using
          congrFun hδfun x
      exact hxδ.symm
    · intro H s x
      let J : X := ⟨(s •ᶜ H.1), hconj H.2 s⟩
      let δ : classFunctionSubspace H.1 :=
        φ H - classFunctionTransport ((MulAut.conj s).subgroupMap H.1) (φ J)
      have hδ : δ = 0 := by
        by_contra hδ
        rcases classFunctionPairing_exists_not_orthogonal hδ with ⟨ψ, hψ⟩
        have hgen :
            conjugationRelation X H s (hconj H.2 s) ψ ∈ artinInductionRelations X := by
          exact Submodule.subset_span <| Or.inr ⟨H, s, hconj H.2 s, ψ, rfl⟩
        have hzero :
            artinSourcePairing X (conjugationRelation X H s (hconj H.2 s) ψ) φ = 0 := by
          have hgenC :
              conjugationRelation X H s (hconj H.2 s) ψ ∈ artinInductionRelationsC X := by
            simpa [artinInductionRelationsC] using hgen
          simpa [LinearMap.BilinForm.IsOrtho] using horth' _ hgenC
        rw [artinSourcePairing_conjugationRelation_eq] at hzero
        have hzero' :
            Representation.groupFunctionPairingOverField ℂ
              (δ : H.1 → ℂ) (ψ : H.1 → ℂ) = 0 := by
          simpa [δ, Representation.groupFunctionPairing_comm] using hzero
        exact hψ hzero'
      have hδfun : (δ : H.1 → ℂ) = 0 := by
        exact congrArg (fun f : classFunctionSubspace H.1 ↦ (f : H.1 → ℂ)) hδ
      have hxδ := congrFun hδfun (((MulAut.conj s).subgroupMap H.1).symm x)
      have hxδ' :
          (φ H : H.1 → ℂ) (((MulAut.conj s).subgroupMap H.1).symm x) =
            (classFunctionTransport ((MulAut.conj s).subgroupMap H.1) (φ J) : H.1 → ℂ)
              (((MulAut.conj s).subgroupMap H.1).symm x) := by
        simpa [δ, sub_eq_zero] using hxδ
      have htransport :
          (classFunctionTransport ((MulAut.conj s).subgroupMap H.1) (φ J) : H.1 → ℂ)
              (((MulAut.conj s).subgroupMap H.1).symm x) =
            (φ J : J.1 → ℂ) x := by
        rw [classFunctionTransport_apply]
        simpa [J] using
          congrArg (fun z : J.1 ↦ (φ J : J.1 → ℂ) z)
            (MulEquiv.apply_symm_apply ((MulAut.conj s).subgroupMap H.1) x)
      have hcompatx :
          (φ H : H.1 → ℂ) (((MulAut.conj s).subgroupMap H.1).symm x) =
            (φ J : J.1 → ℂ) x := by
        exact hxδ'.trans htransport
      simpa [J, conjugateClassFunctionTransport_apply] using hcompatx.symm
  · intro hcompat
    rcases hcompat with ⟨hres, hcompat⟩
    refine LinearMap.BilinForm.mem_orthogonal_iff.mpr ?_
    intro ξ hξ
    change ξ ∈ artinInductionRelations X at hξ
    change artinSourcePairing X ξ φ = 0
    -- Orthogonality to the span reduces to checking the two generator families.
    refine Submodule.span_induction
      (p := fun ξ (_ : ξ ∈ Submodule.span ℚ
        { ξ : artinInductionSource X |
            (∃ (H H' : X) (hH'H : H'.1 ≤ H.1) (χ' : classFunctionSubspace H'.1),
                ξ = inductionInStagesRelation X H H' hH'H χ') ∨
              ∃ (H : X) (s : G) (hHs : (s •ᶜ H.1) ∈ X)
                (χ : classFunctionSubspace H.1),
                ξ = conjugationRelation X H s hHs χ }) ↦
        artinSourcePairing X ξ φ = 0) ?_ ?_ ?_ ?_ hξ
    · intro η hη
      rcases hη with hη | hη
      · rcases hη with ⟨H, H', hH'H, χ', rfl⟩
        have hδ :
            ((classFunctionTransport (subgroupOfEquivOfLe hH'H).symm
                (subgroupClassFunctionRestriction (H'.1.subgroupOf H.1) (φ H)) - φ H') :
              classFunctionSubspace H'.1) = 0 := by
          ext x
          simpa [classFunctionTransport_apply, subgroupClassFunctionRestriction_apply, sub_eq_zero] using
            (hres (H := H) (H' := H') hH'H x).symm
        rw [artinSourcePairing_inductionInStagesRelation_eq]
        exact
          (congrArg
            (fun f : classFunctionSubspace H'.1 ↦
              Representation.groupFunctionPairingOverField ℂ
                (χ' : H'.1 → ℂ) (f : H'.1 → ℂ))
            hδ).trans <| by
              simp [Representation.groupFunctionPairingOverField]
      · rcases hη with ⟨H, s, hHs, χ, rfl⟩
        let J : X := ⟨(s •ᶜ H.1), hconj H.2 s⟩
        have hJ : (⟨(s •ᶜ H.1), hHs⟩ : X) = J := by
          ext
          rfl
        have hδ :
            ((φ H -
                classFunctionTransport ((MulAut.conj s).subgroupMap H.1)
                  (φ ⟨(s •ᶜ H.1), hHs⟩)) : classFunctionSubspace H.1) = 0 := by
          ext y
          have hcompat' :
              (φ ⟨(s •ᶜ H.1), hHs⟩ : (s •ᶜ H.1) → ℂ)
                  (((MulAut.conj s).subgroupMap H.1) y) =
                (conjugateClassFunctionTransport H.1 s (φ H) : (s •ᶜ H.1) → ℂ)
                  (((MulAut.conj s).subgroupMap H.1) y) := by
            simpa [hJ] using hcompat H s (((MulAut.conj s).subgroupMap H.1) y)
          simpa [classFunctionTransport_apply, conjugateClassFunctionTransport_apply, sub_eq_zero]
            using hcompat'.symm
        rw [artinSourcePairing_conjugationRelation_eq]
        exact
          (congrArg
            (fun f : classFunctionSubspace H.1 ↦
              Representation.groupFunctionPairingOverField ℂ
                (χ : H.1 → ℂ) (f : H.1 → ℂ))
            hδ).trans <| by
              simp [Representation.groupFunctionPairingOverField]
    · simp
    · intro η θ _ _ hη hθ
      simp [hη, hθ]
    · intro q η _ hη
      simpa using congrArg (fun z : ℂ ↦ (q : ℂ) * z) hη

/-- Helper for Exercise 9-9.3-1: the orthogonal complement of the relation span is exactly the
range of the restriction-family map. -/
private theorem artinInductionRelationsC_orthogonal_eq_range_restrictionFamily
    (X : Finset (Subgroup G))
    (hsubgroups : ∀ {H H' : Subgroup G}, H ∈ X → H' ≤ H → H' ∈ X)
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    (hcover : is_conjugacy_cover X) :
    (artinSourcePairing X).orthogonal (artinInductionRelationsC X) =
      LinearMap.range (restrictionFamily X) := by
  -- The orthogonal description proved above is exactly the same compatibility predicate that the
  -- gluing theorem identifies with the range of `restrictionFamily X`.
  ext φ
  rw [mem_artinSourcePairing_orthogonal_iff_compatibleFamily (X := X) (hconj := hconj),
    compatibleFamily_iff_mem_range_restrictionFamily X hsubgroups hconj hcover]

/-- Helper for Exercise 9-9.3-1: pairing a source family against a restricted global class
function is the same as pairing its total induction with that global class function. -/
private theorem artinSourcePairing_restrictionFamily_eq
    (X : Finset (Subgroup G)) (ξ : artinInductionSource X) (χ : classFunctionSubspace G) :
    artinSourcePairing X ξ (restrictionFamily X χ) =
      Representation.groupFunctionPairingOverField ℂ
        (artinInductionMapC X ξ : G → ℂ) (χ : G → ℂ) := by
  classical
  -- Unfold the source pairing coordinatewise and sum Frobenius reciprocity over the subgroup
  -- coordinates.
  let f : X → classFunctionSubspace G := fun H ↦
    H.1.classFunctionInduction (ξ H : H.1 → ℂ)
  let L : classFunctionSubspace G →+ ℂ :=
    { toFun := fun ψ ↦ Representation.groupFunctionPairingOverField ℂ
        (ψ : G → ℂ) (χ : G → ℂ)
      map_zero' := by
        simp [Representation.groupFunctionPairingOverField]
      map_add' := by
        intro ψ₁ ψ₂
        simpa using Representation.groupFunctionPairing_add_left
          (ψ₁ : G → ℂ) (ψ₂ : G → ℂ) (χ : G → ℂ) }
  have hpair_sum' :
      L (Finset.sum (Finset.univ : Finset X) f) =
        Finset.sum (Finset.univ : Finset X) (fun H ↦ L (f H)) := by
    exact _root_.map_sum L f (Finset.univ : Finset X)
  calc
    artinSourcePairing X ξ (restrictionFamily X χ) =
      ∑ H : X, Representation.groupFunctionPairingOverField ℂ
        (ξ H : H.1 → ℂ) (restrictionFamily X χ H : H.1 → ℂ) := by
        rfl
    _ = ∑ H : X,
          Representation.groupFunctionPairingOverField ℂ
            (H.1.classFunctionInduction (ξ H : H.1 → ℂ) : G → ℂ) (χ : G → ℂ) := by
        refine Finset.sum_congr rfl ?_
        intro H _
        simpa [restrictionFamily_apply] using
          (groupFunctionPairing_classFunctionInduction_eq_restriction H.1 (ξ H) χ).symm
    _ = Finset.sum (Finset.univ : Finset X) (fun H ↦ L (f H)) := by
        simp [L, f]
    _ = L (Finset.sum (Finset.univ : Finset X) f) := by
        exact hpair_sum'.symm
    _ =
      Representation.groupFunctionPairingOverField ℂ
        ((∑ H : X, f H : classFunctionSubspace G) : G → ℂ) (χ : G → ℂ) := by
        rfl
    _ = Representation.groupFunctionPairingOverField ℂ
          (artinInductionMapC X ξ : G → ℂ) (χ : G → ℂ) := by
        simp [f, artinInductionMapC]

/-- Helper for Exercise 9-9.3-1: the unresolved reverse inclusion is Serre's gluing and
finite-dimensional separation argument. -/
private theorem artinInductionMap_ker_le_artinInductionRelations
    (X : Finset (Subgroup G))
    (hsubgroups : ∀ {H H' : Subgroup G}, H ∈ X → H' ≤ H → H' ∈ X)
    (hconj : ∀ {H : Subgroup G}, H ∈ X → ∀ s : G, (s •ᶜ H) ∈ X)
    (hcover : is_conjugacy_cover X) :
    (artinInductionMap X).ker ≤ artinInductionRelations X := by
  intro ξ hξ
  -- Route correction: show kernel elements annihilate `LinearMap.range (restrictionFamily X)`,
  -- rewrite that range as the orthogonal complement of `artinInductionRelationsC X`, and conclude
  -- by double orthogonality for `artinSourcePairing X`.
  have hξker : artinInductionMap X ξ = 0 := by
    simpa [LinearMap.mem_ker] using hξ
  have hξkerC : artinInductionMapC X ξ = 0 := by
    ext g
    simpa [artinInductionMap_apply, artinInductionMapC_apply] using
      congrFun (congrArg (fun f : classFunctionSubspace G ↦ (f : G → ℂ)) hξker) g
  have horthRange :
      ξ ∈ (artinSourcePairing X).orthogonal (LinearMap.range (restrictionFamily X)) := by
    refine LinearMap.BilinForm.mem_orthogonal_iff.mpr ?_
    intro η hη
    rcases hη with ⟨χ, rfl⟩
    have hpair :
        artinSourcePairing X ξ (restrictionFamily X χ) = 0 := by
      rw [artinSourcePairing_restrictionFamily_eq]
      simp [hξkerC, Representation.groupFunctionPairingOverField]
    have hpair' :
        LinearMap.BilinForm.IsOrtho (artinSourcePairing X) ξ (restrictionFamily X χ) := by
      simpa [LinearMap.BilinForm.IsOrtho] using hpair
    exact ((artinSourcePairing_isRefl X).ortho_comm
      (x := restrictionFamily X χ) (y := ξ)).2 hpair'
  have horthorth :
      ξ ∈ (artinSourcePairing X).orthogonal
        ((artinSourcePairing X).orthogonal (artinInductionRelationsC X)) := by
    simpa [artinInductionRelationsC_orthogonal_eq_range_restrictionFamily
      X hsubgroups hconj hcover] using horthRange
  have hdouble :
      (artinSourcePairing X).orthogonal
          ((artinSourcePairing X).orthogonal (artinInductionRelationsC X)) =
        artinInductionRelationsC X :=
    LinearMap.BilinForm.orthogonal_orthogonal (artinSourcePairing_nondegenerate X)
      (artinSourcePairing_isRefl X) (artinInductionRelationsC X)
  rw [hdouble] at horthorth
  have horthorth' : ξ ∈ artinInductionRelations X := by
    simpa [artinInductionRelationsC] using horthorth
  exact horthorth'

-- Proof sketch: extend scalars to complex class functions and identify the annihilator of the
-- span of the relations using the restriction and conjugation compatibility conditions; duality
-- then reconstructs every element of the kernel from induction-in-stages and conjugation
-- relations.
/-- Exercise 9-9.3-1: in Serre's source context, the subgroup family `X` is the Chapter 9 Artin
family from Theorem 9-9.2-1. Besides conjugation stability and the conjugacy-cover hypothesis, this
source family is closed under passing to subgroups; without that closure the statement is false
even for an abelian Klein-four example. Under these source-faithful hypotheses, the rational
induction kernel is generated over `ℚ` by the induction-in-stages relations from part (a) and the
conjugation relations from part (b). -/
theorem artinInductionMap_ker_eq_artinInductionRelations
    (X : Finset (Subgroup G))
    (hsubgroups : ∀ {H H' : Subgroup G}, H ∈ X → H' ≤ H → H' ∈ X)
    (hconj : ∀ {H : Subgroup G} (_ : H ∈ X) (s : G), (s •ᶜ H) ∈ X)
    (hcover : is_conjugacy_cover X) :
    (artinInductionMap X).ker = artinInductionRelations X := by
  -- Route correction: the generator containment direction is already formalized above; the
  -- remaining work is the duality-and-gluing argument from Serre's hint for the reverse inclusion.
  apply le_antisymm
  · exact artinInductionMap_ker_le_artinInductionRelations X hsubgroups hconj hcover
  · exact artinInductionRelations_le_artinInductionMap_ker X

end ArtinInductionRelations

end Subgroup
