import Mathlib
import LinearRepresentations_Serre_1977.Chap03.Definition_3_3_3_1

noncomputable section

open Matrix
open QuaternionAlgebra
open scoped Quaternion Pointwise commutatorElement

local notation "ℂ²" => Fin 2 → ℂ
local notation "M₂(ℂ)" => Matrix (Fin 2) (Fin 2) ℂ

/- Source/core/bridge triage:
* `source-facing`: Serre's binary tetrahedral subgroup `G ≤ ℍˣ`, its quaternion subgroup
  `E ≤ G`, and the induced degree-`2` complex representation.
* `core/canonical`: `Subgroup.closure` for the group owners,
  `QuaternionAlgebra.Basis.liftHom` for the quaternion-to-matrix algebra map, and
  `Representation.IsMonomial` together with
  `Representation.isMonomial_of_irreducible_of_supersolvable`
  for the monomiality owner used in part (6).
* `bridge/view`: the restriction of the quaternion embedding from `ℍˣ` to the subgroup `G`.

Sampled owner declarations in this domain:
* `Subgroup.closure`
* `QuaternionAlgebra.Basis.liftHom`
* `Representation.IsMonomial`
* `Representation.isMonomial_of_irreducible_of_supersolvable`

Primitive data are the concrete Hurwitz generators in `ℍˣ` and the chosen matrices realizing the
Hamilton relations. The generator sets and the quaternion basis on `M₂(ℂ)` are only derived
implementation scaffolding, so the public API below keeps the subgroup, algebra map, and
representation owners directly instead of preserving those auxiliary wrappers. -/

/-- The Hamilton quaternion `i` is nonzero. -/
private theorem hamiltonQuaternionI_ne_zero : (Basis.self ℝ).i ≠ (0 : ℍ) := by
  intro h
  simpa using congrArg (fun q : ℍ ↦ q.imI) h

/-- The Hamilton quaternion `j` is nonzero. -/
private theorem hamiltonQuaternionJ_ne_zero : (Basis.self ℝ).j ≠ (0 : ℍ) := by
  intro h
  simpa using congrArg (fun q : ℍ ↦ q.imJ) h

/-- The standard Hurwitz unit of order `3`. -/
private def hurwitzQuaternionCubeRoot : ℍ :=
  (⟨-(1 : ℝ) / 2, 1 / 2, 1 / 2, 1 / 2⟩ : ℍ)

/-- The standard Hurwitz unit of order `3` is nonzero. -/
private theorem hurwitzQuaternionCubeRoot_ne_zero : hurwitzQuaternionCubeRoot ≠ 0 := by
  intro h
  have h' := congrArg (fun q : ℍ ↦ q.re) h
  norm_num [hurwitzQuaternionCubeRoot] at h'

/-- The Hamilton unit `i` inside `ℍˣ`. -/
private def hamiltonQuaternionIUnit : ℍˣ :=
  Units.mk0 (Basis.self ℝ).i hamiltonQuaternionI_ne_zero

/-- The Hamilton unit `j` inside `ℍˣ`. -/
private def hamiltonQuaternionJUnit : ℍˣ :=
  Units.mk0 (Basis.self ℝ).j hamiltonQuaternionJ_ne_zero

/-- The standard Hurwitz unit of order `3` inside `ℍˣ`. -/
private def hurwitzQuaternionCubeRootUnit : ℍˣ :=
  Units.mk0 hurwitzQuaternionCubeRoot hurwitzQuaternionCubeRoot_ne_zero

/-- Serre's subgroup `G ≤ ℍˣ`, generated by the quaternion subgroup `E` and the Hurwitz unit
`(-1 + i + j + k) / 2`; equivalently, it is obtained by adjoining the sixteen units
`(±1 ± i ± j ± k) / 2` to `E`. -/
def hurwitzQuaternionGroup : Subgroup ℍˣ :=
  Subgroup.closure
    (insert hurwitzQuaternionCubeRootUnit
      ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ))

/-- The subgroup `E` viewed internally as a subgroup of Serre's group `G`. -/
def hurwitzQuaternionEightSubgroup : Subgroup hurwitzQuaternionGroup :=
  (Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ)).subgroupOf
    hurwitzQuaternionGroup

/-- Helper for Exercise 8-8.5-4: the chosen Hurwitz unit has order dividing `3`. -/
private theorem hurwitz_quaternion_cube_root_unit_pow_three :
    hurwitzQuaternionCubeRootUnit ^ 3 = 1 := by
  -- Compare the quaternion coordinates after expanding the cube explicitly.
  apply Units.ext
  ext <;> norm_num [hurwitzQuaternionCubeRootUnit, hurwitzQuaternionCubeRoot, pow_succ, mul_assoc]

/-- Helper for Exercise 8-8.5-4: left multiplication by the Hurwitz unit sends `i` to `k`
after moving the extra Hurwitz factor to the right. -/
private theorem hurwitz_quaternion_cube_root_unit_mul_i :
    hurwitzQuaternionCubeRootUnit * hamiltonQuaternionIUnit =
      (hamiltonQuaternionIUnit * hamiltonQuaternionJUnit) * hurwitzQuaternionCubeRootUnit := by
  -- This is the source-level quaternion calculation `ω i = k ω`.
  apply Units.ext
  ext <;> norm_num [hurwitzQuaternionCubeRootUnit, hamiltonQuaternionIUnit,
    hamiltonQuaternionJUnit, hurwitzQuaternionCubeRoot]

/-- Helper for Exercise 8-8.5-4: left multiplication by the Hurwitz unit sends `j` to `i`
after moving the extra Hurwitz factor to the right. -/
private theorem hurwitz_quaternion_cube_root_unit_mul_j :
    hurwitzQuaternionCubeRootUnit * hamiltonQuaternionJUnit =
      hamiltonQuaternionIUnit * hurwitzQuaternionCubeRootUnit := by
  -- This is the source-level quaternion calculation `ω j = i ω`.
  apply Units.ext
  ext <;> norm_num [hurwitzQuaternionCubeRootUnit, hamiltonQuaternionIUnit,
    hamiltonQuaternionJUnit, hurwitzQuaternionCubeRoot]

/-- Helper for Exercise 8-8.5-4: conjugation by the Hurwitz unit sends `i` to `k = ij`. -/
private theorem hurwitz_quaternion_cube_root_unit_conj_i :
    hurwitzQuaternionCubeRootUnit * hamiltonQuaternionIUnit * hurwitzQuaternionCubeRootUnit⁻¹ =
      hamiltonQuaternionIUnit * hamiltonQuaternionJUnit := by
  -- Move the right-hand Hurwitz factor across and cancel it against its inverse.
  calc
    hurwitzQuaternionCubeRootUnit * hamiltonQuaternionIUnit * hurwitzQuaternionCubeRootUnit⁻¹ =
        ((hamiltonQuaternionIUnit * hamiltonQuaternionJUnit) * hurwitzQuaternionCubeRootUnit) *
          hurwitzQuaternionCubeRootUnit⁻¹ := by
            rw [hurwitz_quaternion_cube_root_unit_mul_i]
    _ = hamiltonQuaternionIUnit * hamiltonQuaternionJUnit := by
      group

/-- Helper for Exercise 8-8.5-4: conjugation by the Hurwitz unit sends `j` to `i`. -/
private theorem hurwitz_quaternion_cube_root_unit_conj_j :
    hurwitzQuaternionCubeRootUnit * hamiltonQuaternionJUnit * hurwitzQuaternionCubeRootUnit⁻¹ =
      hamiltonQuaternionIUnit := by
  -- Move the right-hand Hurwitz factor across and cancel it against its inverse.
  calc
    hurwitzQuaternionCubeRootUnit * hamiltonQuaternionJUnit * hurwitzQuaternionCubeRootUnit⁻¹ =
        (hamiltonQuaternionIUnit * hurwitzQuaternionCubeRootUnit) *
          hurwitzQuaternionCubeRootUnit⁻¹ := by
            rw [hurwitz_quaternion_cube_root_unit_mul_j]
    _ = hamiltonQuaternionIUnit := by
      group

/-- Helper for Exercise 8-8.5-4: conjugation by the Hurwitz unit sends `k = ij` to `j`. -/
private theorem hurwitz_quaternion_cube_root_unit_conj_k :
    hurwitzQuaternionCubeRootUnit * (hamiltonQuaternionIUnit * hamiltonQuaternionJUnit) *
        hurwitzQuaternionCubeRootUnit⁻¹ =
      hamiltonQuaternionJUnit := by
  -- Conjugation is multiplicative, so this follows from the formulas for `i` and `j`.
  calc
    hurwitzQuaternionCubeRootUnit * (hamiltonQuaternionIUnit * hamiltonQuaternionJUnit) *
        hurwitzQuaternionCubeRootUnit⁻¹ =
      (hurwitzQuaternionCubeRootUnit * hamiltonQuaternionIUnit * hurwitzQuaternionCubeRootUnit⁻¹) *
        (hurwitzQuaternionCubeRootUnit * hamiltonQuaternionJUnit *
          hurwitzQuaternionCubeRootUnit⁻¹) := by
            group
    _ = (hamiltonQuaternionIUnit * hamiltonQuaternionJUnit) * hamiltonQuaternionIUnit := by
      rw [hurwitz_quaternion_cube_root_unit_conj_i, hurwitz_quaternion_cube_root_unit_conj_j]
    _ = hamiltonQuaternionJUnit := by
      apply Units.ext
      ext <;> norm_num [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit]

/-- Helper for Exercise 8-8.5-4: the three concrete generators lie in Serre's subgroup `G`. -/
private theorem hamiltonQuaternionIUnit_mem_hurwitzQuaternionGroup :
    hamiltonQuaternionIUnit ∈ hurwitzQuaternionGroup := by
  exact Subgroup.subset_closure (by simp)

/-- Helper for Exercise 8-8.5-4: the three concrete generators lie in Serre's subgroup `G`. -/
private theorem hamiltonQuaternionJUnit_mem_hurwitzQuaternionGroup :
    hamiltonQuaternionJUnit ∈ hurwitzQuaternionGroup := by
  exact Subgroup.subset_closure (by simp)

/-- Helper for Exercise 8-8.5-4: the three concrete generators lie in Serre's subgroup `G`. -/
private theorem hurwitzQuaternionCubeRootUnit_mem_hurwitzQuaternionGroup :
    hurwitzQuaternionCubeRootUnit ∈ hurwitzQuaternionGroup := by
  exact Subgroup.subset_closure (by simp)

/-- Helper for Exercise 8-8.5-4: the standard quaternion generators viewed as elements of the
ambient Hurwitz subgroup `G`. -/
private def hamiltonQuaternionIInHurwitzGroup : hurwitzQuaternionGroup :=
  ⟨hamiltonQuaternionIUnit, hamiltonQuaternionIUnit_mem_hurwitzQuaternionGroup⟩

/-- Helper for Exercise 8-8.5-4: the standard quaternion generators viewed as elements of the
ambient Hurwitz subgroup `G`. -/
private def hamiltonQuaternionJInHurwitzGroup : hurwitzQuaternionGroup :=
  ⟨hamiltonQuaternionJUnit, hamiltonQuaternionJUnit_mem_hurwitzQuaternionGroup⟩

/-- Helper for Exercise 8-8.5-4: the Hurwitz cube root unit viewed as an element of `G`. -/
private def hurwitzQuaternionCubeRootInHurwitzGroup : hurwitzQuaternionGroup :=
  ⟨hurwitzQuaternionCubeRootUnit, hurwitzQuaternionCubeRootUnit_mem_hurwitzQuaternionGroup⟩

/-- Helper for Exercise 8-8.5-4: the quaternion unit `k = ij` viewed as an element of `G`. -/
private def hamiltonQuaternionKInHurwitzGroup : hurwitzQuaternionGroup :=
  ⟨hamiltonQuaternionIUnit * hamiltonQuaternionJUnit,
    hurwitzQuaternionGroup.mul_mem
      hamiltonQuaternionIUnit_mem_hurwitzQuaternionGroup
      hamiltonQuaternionJUnit_mem_hurwitzQuaternionGroup⟩

/-- Helper for Exercise 8-8.5-4: the order-`3` relation still holds inside `G`. -/
private theorem hurwitzQuaternionCubeRootInHurwitzGroup_pow_three :
    hurwitzQuaternionCubeRootInHurwitzGroup ^ 3 = 1 := by
  -- The ambient unit identity descends directly to the subgroup element.
  apply Subtype.ext
  simpa [hurwitzQuaternionCubeRootInHurwitzGroup] using
    hurwitz_quaternion_cube_root_unit_pow_three

/-- Helper for Exercise 8-8.5-4: conjugation by the subgroup element `ω` sends `i` to `k`. -/
private theorem hurwitzQuaternionCubeRootInHurwitzGroup_conj_i :
    hurwitzQuaternionCubeRootInHurwitzGroup * hamiltonQuaternionIInHurwitzGroup *
        hurwitzQuaternionCubeRootInHurwitzGroup⁻¹ =
      hamiltonQuaternionKInHurwitzGroup := by
  -- Restrict the ambient conjugation identity to the subgroup `G`.
  apply Subtype.ext
  simpa [hurwitzQuaternionCubeRootInHurwitzGroup, hamiltonQuaternionIInHurwitzGroup,
    hamiltonQuaternionKInHurwitzGroup] using hurwitz_quaternion_cube_root_unit_conj_i

/-- Helper for Exercise 8-8.5-4: conjugation by the subgroup element `ω` sends `j` to `i`. -/
private theorem hurwitzQuaternionCubeRootInHurwitzGroup_conj_j :
    hurwitzQuaternionCubeRootInHurwitzGroup * hamiltonQuaternionJInHurwitzGroup *
        hurwitzQuaternionCubeRootInHurwitzGroup⁻¹ =
      hamiltonQuaternionIInHurwitzGroup := by
  -- Restrict the ambient conjugation identity to the subgroup `G`.
  apply Subtype.ext
  simpa [hurwitzQuaternionCubeRootInHurwitzGroup, hamiltonQuaternionJInHurwitzGroup,
    hamiltonQuaternionIInHurwitzGroup] using hurwitz_quaternion_cube_root_unit_conj_j

/-- Helper for Exercise 8-8.5-4: the Hurwitz cube-root unit normalizes the quaternion subgroup
generated by `i` and `j`. -/
private theorem hurwitz_quaternion_cube_root_normalizes_eight_subgroup :
    hurwitzQuaternionCubeRootUnit ∈
      Subgroup.normalizer
        (Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ)) := by
  -- Route correction: the missing input is not a new transport lemma, but the backward
  -- generator images for the bidirectional normalizer criterion.
  have hi_mem :
      hamiltonQuaternionIUnit ∈
        Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) :=
    Subgroup.subset_closure (by simp)
  have hj_mem :
      hamiltonQuaternionJUnit ∈
        Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) :=
    Subgroup.subset_closure (by simp)
  have hk_mem :
      hamiltonQuaternionIUnit * hamiltonQuaternionJUnit ∈
        Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) :=
    Subgroup.mul_mem _ hi_mem hj_mem
  have hconj_inv_i :
      hurwitzQuaternionCubeRootUnit⁻¹ * hamiltonQuaternionIUnit * hurwitzQuaternionCubeRootUnit =
        hamiltonQuaternionJUnit := by
    -- Recover the inverse-conjugation formula from the forward cycle `ω j ω⁻¹ = i`.
    calc
      hurwitzQuaternionCubeRootUnit⁻¹ * hamiltonQuaternionIUnit * hurwitzQuaternionCubeRootUnit =
          hurwitzQuaternionCubeRootUnit⁻¹ *
            (hurwitzQuaternionCubeRootUnit * hamiltonQuaternionJUnit *
              hurwitzQuaternionCubeRootUnit⁻¹) * hurwitzQuaternionCubeRootUnit := by
            rw [hurwitz_quaternion_cube_root_unit_conj_j]
      _ = hamiltonQuaternionJUnit := by
        group
  have hconj_inv_j :
      hurwitzQuaternionCubeRootUnit⁻¹ * hamiltonQuaternionJUnit * hurwitzQuaternionCubeRootUnit =
        hamiltonQuaternionIUnit * hamiltonQuaternionJUnit := by
    -- Likewise recover `ω⁻¹ j ω = k` from the forward formula `ω k ω⁻¹ = j`.
    calc
      hurwitzQuaternionCubeRootUnit⁻¹ * hamiltonQuaternionJUnit * hurwitzQuaternionCubeRootUnit =
          hurwitzQuaternionCubeRootUnit⁻¹ *
            (hurwitzQuaternionCubeRootUnit *
              (hamiltonQuaternionIUnit * hamiltonQuaternionJUnit) *
              hurwitzQuaternionCubeRootUnit⁻¹) * hurwitzQuaternionCubeRootUnit := by
            rw [hurwitz_quaternion_cube_root_unit_conj_k]
      _ = hamiltonQuaternionIUnit * hamiltonQuaternionJUnit := by
        group
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    -- First show that conjugation by `ω` preserves the closure of the two generators.
    refine Subgroup.closure_induction (k := ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} :
      Set ℍˣ)) (p := fun y _ ↦
        hurwitzQuaternionCubeRootUnit * y * hurwitzQuaternionCubeRootUnit⁻¹ ∈
          Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ)) ?_ ?_ ?_
      ?_ hx
    · intro y hy
      simp at hy
      rcases hy with rfl | rfl
      · simpa [hurwitz_quaternion_cube_root_unit_conj_i] using hk_mem
      · simpa [hurwitz_quaternion_cube_root_unit_conj_j] using hi_mem
    · simpa using
        (Subgroup.one_mem
          (Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ)))
    · intro y z hy hz hy_mem hz_mem
      have hmul :
          (hurwitzQuaternionCubeRootUnit * y * hurwitzQuaternionCubeRootUnit⁻¹) *
              (hurwitzQuaternionCubeRootUnit * z * hurwitzQuaternionCubeRootUnit⁻¹) ∈
            Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) :=
        Subgroup.mul_mem _ hy_mem hz_mem
      simpa [mul_assoc] using hmul
    · intro y hy hy_mem
      have hinv :
          (hurwitzQuaternionCubeRootUnit * y * hurwitzQuaternionCubeRootUnit⁻¹)⁻¹ ∈
            Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) :=
        Subgroup.inv_mem _ hy_mem
      simpa [mul_assoc] using hinv
  · intro hx
    -- Then apply the same closure argument to conjugation by `ω⁻¹`.
    have hback :
        hurwitzQuaternionCubeRootUnit⁻¹ *
            (hurwitzQuaternionCubeRootUnit * x * hurwitzQuaternionCubeRootUnit⁻¹) *
            hurwitzQuaternionCubeRootUnit ∈
          Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) := by
      refine Subgroup.closure_induction (k := ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} :
        Set ℍˣ)) (p := fun y _ ↦
          hurwitzQuaternionCubeRootUnit⁻¹ * y * hurwitzQuaternionCubeRootUnit ∈
            Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ)) ?_
        ?_ ?_ ?_ hx
      · intro y hy
        simp at hy
        rcases hy with rfl | rfl
        · simpa [hconj_inv_i] using hj_mem
        · simpa [hconj_inv_j] using hk_mem
      · simpa using
          (Subgroup.one_mem
            (Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ)))
      · intro y z hy hz hy_mem hz_mem
        have hmul :
            (hurwitzQuaternionCubeRootUnit⁻¹ * y * hurwitzQuaternionCubeRootUnit) *
                (hurwitzQuaternionCubeRootUnit⁻¹ * z * hurwitzQuaternionCubeRootUnit) ∈
              Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) :=
          Subgroup.mul_mem _ hy_mem hz_mem
        simpa [mul_assoc] using hmul
      · intro y hy hy_mem
        have hinv :
            (hurwitzQuaternionCubeRootUnit⁻¹ * y * hurwitzQuaternionCubeRootUnit)⁻¹ ∈
              Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) :=
          Subgroup.inv_mem _ hy_mem
        simpa [mul_assoc] using hinv
    simpa [mul_assoc] using hback

/-- Helper for Exercise 8-8.5-4: the ambient quaternion subgroup generated by `i` and `j`. -/
private def hurwitzQuaternionEightSubgroupAmbient : Subgroup ℍˣ :=
  Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ)

/-- Helper for Exercise 8-8.5-4: the quaternion unit `k = ij` in `ℍˣ`. -/
private def hamiltonQuaternionKUnit : ℍˣ :=
  hamiltonQuaternionIUnit * hamiltonQuaternionJUnit

/-- Helper for Exercise 8-8.5-4: the Hamilton units satisfy `i² = -1`. -/
@[simp] private theorem hamiltonQuaternionIUnit_mul_self :
    hamiltonQuaternionIUnit * hamiltonQuaternionIUnit = (-1 : ℍˣ) := by
  -- Compare quaternion coordinates after multiplying the concrete units.
  apply Units.ext
  ext <;> norm_num [hamiltonQuaternionIUnit]

/-- Helper for Exercise 8-8.5-4: the Hamilton units satisfy `j² = -1`. -/
@[simp] private theorem hamiltonQuaternionJUnit_mul_self :
    hamiltonQuaternionJUnit * hamiltonQuaternionJUnit = (-1 : ℍˣ) := by
  -- Compare quaternion coordinates after multiplying the concrete units.
  apply Units.ext
  ext <;> norm_num [hamiltonQuaternionJUnit]

/-- Helper for Exercise 8-8.5-4: the chosen unit `k` is by definition `ij`. -/
private theorem hamiltonQuaternionIUnit_mul_jUnit :
    hamiltonQuaternionIUnit * hamiltonQuaternionJUnit = hamiltonQuaternionKUnit := by
  rfl

/-- Helper for Exercise 8-8.5-4: the Hamilton relation `ji = -k`. -/
@[simp] private theorem hamiltonQuaternionJUnit_mul_iUnit :
    hamiltonQuaternionJUnit * hamiltonQuaternionIUnit = -hamiltonQuaternionKUnit := by
  -- Compare quaternion coordinates after multiplying the concrete units.
  apply Units.ext
  ext <;> norm_num [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, hamiltonQuaternionKUnit]

/-- Helper for Exercise 8-8.5-4: the Hamilton relation `ik = -j`. -/
@[simp] private theorem hamiltonQuaternionIUnit_mul_kUnit :
    hamiltonQuaternionIUnit * hamiltonQuaternionKUnit = -hamiltonQuaternionJUnit := by
  -- Compare quaternion coordinates after multiplying the concrete units.
  apply Units.ext
  ext <;> norm_num [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, hamiltonQuaternionKUnit]

/-- Helper for Exercise 8-8.5-4: the Hamilton relation `ki = j`. -/
@[simp] private theorem hamiltonQuaternionKUnit_mul_iUnit :
    hamiltonQuaternionKUnit * hamiltonQuaternionIUnit = hamiltonQuaternionJUnit := by
  -- Compare quaternion coordinates after multiplying the concrete units.
  apply Units.ext
  ext <;> norm_num [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, hamiltonQuaternionKUnit]

/-- Helper for Exercise 8-8.5-4: the Hamilton relation `jk = i`. -/
@[simp] private theorem hamiltonQuaternionJUnit_mul_kUnit :
    hamiltonQuaternionJUnit * hamiltonQuaternionKUnit = hamiltonQuaternionIUnit := by
  -- Compare quaternion coordinates after multiplying the concrete units.
  apply Units.ext
  ext <;> norm_num [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, hamiltonQuaternionKUnit]

/-- Helper for Exercise 8-8.5-4: the Hamilton relation `kj = -i`. -/
@[simp] private theorem hamiltonQuaternionKUnit_mul_jUnit :
    hamiltonQuaternionKUnit * hamiltonQuaternionJUnit = -hamiltonQuaternionIUnit := by
  -- Compare quaternion coordinates after multiplying the concrete units.
  apply Units.ext
  ext <;> norm_num [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, hamiltonQuaternionKUnit]

/-- Helper for Exercise 8-8.5-4: the Hamilton unit `k` also satisfies `k² = -1`. -/
@[simp] private theorem hamiltonQuaternionKUnit_mul_self :
    hamiltonQuaternionKUnit * hamiltonQuaternionKUnit = (-1 : ℍˣ) := by
  -- Compare quaternion coordinates after multiplying the concrete units.
  apply Units.ext
  ext <;> norm_num [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, hamiltonQuaternionKUnit]

/-- Helper for Exercise 8-8.5-4: the inverse of `i` is `-i`. -/
@[simp] private theorem hamiltonQuaternionIUnit_inv :
    hamiltonQuaternionIUnit⁻¹ = -hamiltonQuaternionIUnit := by
  -- The quaternion identity `(-i) * i = 1` identifies the inverse.
  apply inv_eq_of_mul_eq_one_left
  simp

/-- Helper for Exercise 8-8.5-4: the inverse of `j` is `-j`. -/
@[simp] private theorem hamiltonQuaternionJUnit_inv :
    hamiltonQuaternionJUnit⁻¹ = -hamiltonQuaternionJUnit := by
  -- The quaternion identity `(-j) * j = 1` identifies the inverse.
  apply inv_eq_of_mul_eq_one_left
  simp

/-- Helper for Exercise 8-8.5-4: the inverse of `k` is `-k`. -/
@[simp] private theorem hamiltonQuaternionKUnit_inv :
    hamiltonQuaternionKUnit⁻¹ = -hamiltonQuaternionKUnit := by
  -- The quaternion identity `(-k) * k = 1` identifies the inverse.
  apply inv_eq_of_mul_eq_one_left
  simp

/-- Helper for Exercise 8-8.5-4: a finite code for the eight quaternion units `±1, ±i, ±j, ±k`.
This keeps the subgroup arguments on the `E`-side finite and explicit. -/
private inductive HurwitzQuaternionEightCode
  | one | negOne | i | negI | j | negJ | k | negK
  deriving DecidableEq, Fintype

/-- Helper for Exercise 8-8.5-4: decode the eight quaternion-unit codes into actual units. -/
private def HurwitzQuaternionEightCode.toUnit : HurwitzQuaternionEightCode → ℍˣ
  | .one => 1
  | .negOne => -1
  | .i => hamiltonQuaternionIUnit
  | .negI => -hamiltonQuaternionIUnit
  | .j => hamiltonQuaternionJUnit
  | .negJ => -hamiltonQuaternionJUnit
  | .k => hamiltonQuaternionKUnit
  | .negK => -hamiltonQuaternionKUnit

/-- Helper for Exercise 8-8.5-4: the multiplication table on the eight quaternion units. -/
private def HurwitzQuaternionEightCode.mul :
    HurwitzQuaternionEightCode → HurwitzQuaternionEightCode → HurwitzQuaternionEightCode
  | .one, a => a
  | .negOne, .one => .negOne
  | .negOne, .negOne => .one
  | .negOne, .i => .negI
  | .negOne, .negI => .i
  | .negOne, .j => .negJ
  | .negOne, .negJ => .j
  | .negOne, .k => .negK
  | .negOne, .negK => .k
  | .i, .one => .i
  | .i, .negOne => .negI
  | .i, .i => .negOne
  | .i, .negI => .one
  | .i, .j => .k
  | .i, .negJ => .negK
  | .i, .k => .negJ
  | .i, .negK => .j
  | .negI, .one => .negI
  | .negI, .negOne => .i
  | .negI, .i => .one
  | .negI, .negI => .negOne
  | .negI, .j => .negK
  | .negI, .negJ => .k
  | .negI, .k => .j
  | .negI, .negK => .negJ
  | .j, .one => .j
  | .j, .negOne => .negJ
  | .j, .i => .negK
  | .j, .negI => .k
  | .j, .j => .negOne
  | .j, .negJ => .one
  | .j, .k => .i
  | .j, .negK => .negI
  | .negJ, .one => .negJ
  | .negJ, .negOne => .j
  | .negJ, .i => .k
  | .negJ, .negI => .negK
  | .negJ, .j => .one
  | .negJ, .negJ => .negOne
  | .negJ, .k => .negI
  | .negJ, .negK => .i
  | .k, .one => .k
  | .k, .negOne => .negK
  | .k, .i => .j
  | .k, .negI => .negJ
  | .k, .j => .negI
  | .k, .negJ => .i
  | .k, .k => .negOne
  | .k, .negK => .one
  | .negK, .one => .negK
  | .negK, .negOne => .k
  | .negK, .i => .negJ
  | .negK, .negI => .j
  | .negK, .j => .i
  | .negK, .negJ => .negI
  | .negK, .k => .one
  | .negK, .negK => .negOne

/-- Helper for Exercise 8-8.5-4: the inversion table on the eight quaternion units. -/
private def HurwitzQuaternionEightCode.inv :
    HurwitzQuaternionEightCode → HurwitzQuaternionEightCode
  | .one => .one
  | .negOne => .negOne
  | .i => .negI
  | .negI => .i
  | .j => .negJ
  | .negJ => .j
  | .k => .negK
  | .negK => .k

/-- Helper for Exercise 8-8.5-4: decoding respects the quaternion multiplication table. -/
private theorem HurwitzQuaternionEightCode.toUnit_mul
    (a b : HurwitzQuaternionEightCode) :
    a.toUnit * b.toUnit = (HurwitzQuaternionEightCode.mul a b).toUnit := by
  -- The finite code table was chosen to match the Hamilton multiplication rules exactly.
  cases a <;> cases b <;>
    simp [HurwitzQuaternionEightCode.mul, HurwitzQuaternionEightCode.toUnit,
      hamiltonQuaternionIUnit_mul_jUnit]

/-- Helper for Exercise 8-8.5-4: decoding respects inversion on the quaternion units. -/
private theorem HurwitzQuaternionEightCode.toUnit_inv
    (a : HurwitzQuaternionEightCode) :
    a.toUnit⁻¹ = (HurwitzQuaternionEightCode.inv a).toUnit := by
  -- The inverse table is just the sign change on the order-`4` units.
  cases a <;> simp [HurwitzQuaternionEightCode.inv, HurwitzQuaternionEightCode.toUnit]

/-- Helper for Exercise 8-8.5-4: the eight quaternion units form an explicit subgroup of `ℍˣ`. -/
private def hurwitzQuaternionEightModelSubgroup : Subgroup ℍˣ where
  carrier := Set.range HurwitzQuaternionEightCode.toUnit
  one_mem' := ⟨HurwitzQuaternionEightCode.one, rfl⟩
  mul_mem' := by
    intro a b ha hb
    rcases ha with ⟨xa, rfl⟩
    rcases hb with ⟨xb, rfl⟩
    -- Multiply the codes and decode the result.
    exact ⟨HurwitzQuaternionEightCode.mul xa xb,
      (HurwitzQuaternionEightCode.toUnit_mul xa xb).symm⟩
  inv_mem' := by
    intro a ha
    rcases ha with ⟨xa, rfl⟩
    -- Inversion is encoded by the explicit inverse table.
    exact ⟨HurwitzQuaternionEightCode.inv xa,
      (HurwitzQuaternionEightCode.toUnit_inv xa).symm⟩

/-- Helper for Exercise 8-8.5-4: the generators `i` and `j` lie in the finite eight-unit model. -/
private theorem hurwitz_quaternion_eight_generators_le_model :
    hurwitzQuaternionEightSubgroupAmbient ≤ hurwitzQuaternionEightModelSubgroup := by
  -- The closure is contained in the explicit model once the two generators are.
  change Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) ≤
    hurwitzQuaternionEightModelSubgroup
  rw [Subgroup.closure_le]
  intro x hx
  simp at hx
  rcases hx with rfl | rfl
  · exact ⟨HurwitzQuaternionEightCode.i, rfl⟩
  · exact ⟨HurwitzQuaternionEightCode.j, rfl⟩

/-- Helper for Exercise 8-8.5-4: every coded quaternion unit already lies in the subgroup
generated by `i` and `j`. -/
private theorem hurwitz_quaternion_model_le_eight_generators :
    hurwitzQuaternionEightModelSubgroup ≤ hurwitzQuaternionEightSubgroupAmbient := by
  have hi : hamiltonQuaternionIUnit ∈ hurwitzQuaternionEightSubgroupAmbient :=
    Subgroup.subset_closure (by simp)
  have hj : hamiltonQuaternionJUnit ∈ hurwitzQuaternionEightSubgroupAmbient :=
    Subgroup.subset_closure (by simp)
  -- Route correction: decode each of the eight model elements and place it back in the closure.
  intro x hx
  rcases hx with ⟨a, rfl⟩
  cases a
  · exact hurwitzQuaternionEightSubgroupAmbient.one_mem
  · simpa using hurwitzQuaternionEightSubgroupAmbient.mul_mem hi hi
  · exact hi
  · simpa using hurwitzQuaternionEightSubgroupAmbient.inv_mem hi
  · exact hj
  · simpa using hurwitzQuaternionEightSubgroupAmbient.inv_mem hj
  · simpa [hamiltonQuaternionKUnit] using
      hurwitzQuaternionEightSubgroupAmbient.mul_mem hi hj
  · simpa [hamiltonQuaternionKUnit] using
      hurwitzQuaternionEightSubgroupAmbient.inv_mem
        (hurwitzQuaternionEightSubgroupAmbient.mul_mem hi hj)

/-- Helper for Exercise 8-8.5-4: the closure of `i` and `j` is exactly the explicit eight-unit
subgroup. -/
private theorem hurwitz_quaternion_eight_ambient_eq_model :
    hurwitzQuaternionEightSubgroupAmbient = hurwitzQuaternionEightModelSubgroup := by
  -- The source subgroup `E` is precisely the quaternion group `Q₈`.
  exact le_antisymm
    hurwitz_quaternion_eight_generators_le_model
    hurwitz_quaternion_model_le_eight_generators

/-- Helper for Exercise 8-8.5-4: the ambient quaternion subgroup generated by `i` and `j`
is finite because it is identified with the explicit eight-unit model. -/
private theorem hurwitz_quaternion_eight_subgroup_ambient_finite :
    Finite hurwitzQuaternionEightSubgroupAmbient := by
  -- The explicit eight-code model has finite carrier, and the closure equals that model.
  have hfinite : Finite hurwitzQuaternionEightModelSubgroup := by
    classical
    change Finite ↥(Set.range HurwitzQuaternionEightCode.toUnit)
    infer_instance
  rw [hurwitz_quaternion_eight_ambient_eq_model]
  exact hfinite

/-- Helper for Exercise 8-8.5-4: every element of the quaternion subgroup `E` has fourth power
equal to `1`. This is the exponent-`4` fact needed later to separate `E` from the order-`3`
cyclic complement. -/
private theorem hurwitz_quaternion_eight_subgroup_ambient_pow_four
    {x : ℍˣ} (hx : x ∈ hurwitzQuaternionEightSubgroupAmbient) :
    x ^ 4 = 1 := by
  -- Transport to the explicit eight-element model and check the eight cases directly.
  have hx' : x ∈ hurwitzQuaternionEightModelSubgroup := by
    simpa [hurwitz_quaternion_eight_ambient_eq_model] using hx
  rcases hx' with ⟨a, rfl⟩
  cases a
  · simp [HurwitzQuaternionEightCode.toUnit, pow_succ]
  · simp [HurwitzQuaternionEightCode.toUnit, pow_succ]
  · simp [HurwitzQuaternionEightCode.toUnit, pow_succ]
  · simp [HurwitzQuaternionEightCode.toUnit, pow_succ]
  · simp [HurwitzQuaternionEightCode.toUnit, pow_succ]
  · simp [HurwitzQuaternionEightCode.toUnit, pow_succ]
  · simp [HurwitzQuaternionEightCode.toUnit, pow_succ]
  · simp [HurwitzQuaternionEightCode.toUnit, pow_succ]

/-- Helper for Exercise 8-8.5-4: the ambient quaternion subgroup sits inside Serre's Hurwitz
group because it is generated by two of the three chosen generators of `G`. -/
private theorem hurwitz_quaternion_eight_subgroup_ambient_le_group :
    hurwitzQuaternionEightSubgroupAmbient ≤ hurwitzQuaternionGroup := by
  -- The subgroup `G` was defined by adjoining the same generators together with `ω`.
  change Subgroup.closure ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) ≤
    hurwitzQuaternionGroup
  rw [Subgroup.closure_le]
  intro x hx
  simp at hx
  rcases hx with rfl | rfl
  · exact hamiltonQuaternionIUnit_mem_hurwitzQuaternionGroup
  · exact hamiltonQuaternionJUnit_mem_hurwitzQuaternionGroup

/-- Helper for Exercise 8-8.5-4: viewed inside `G`, the quaternion subgroup `E` is finite. -/
private theorem hurwitz_quaternion_eight_subgroup_finite :
    Finite hurwitzQuaternionEightSubgroup := by
  letI : Finite hurwitzQuaternionEightSubgroupAmbient :=
    hurwitz_quaternion_eight_subgroup_ambient_finite
  -- The subgroup viewed inside `G` is equivalent to the same ambient subgroup.
  exact Finite.of_equiv hurwitzQuaternionEightSubgroupAmbient
    (Subgroup.subgroupOfEquivOfLe hurwitz_quaternion_eight_subgroup_ambient_le_group).symm.toEquiv

/-- Helper for Exercise 8-8.5-4: the quaternion subgroup `E` is normal in `G`. This private
version is placed early so the finite/complement package can depend on it. -/
private theorem hurwitz_quaternion_eight_subgroup_normal :
    hurwitzQuaternionEightSubgroup.Normal := by
  have hG_normalizes : hurwitzQuaternionGroup ≤
      Subgroup.normalizer hurwitzQuaternionEightSubgroupAmbient := by
    -- Each defining generator of `G` normalizes the ambient quaternion subgroup.
    change Subgroup.closure
        (insert hurwitzQuaternionCubeRootUnit
          ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ)) ≤
      Subgroup.normalizer hurwitzQuaternionEightSubgroupAmbient
    rw [Subgroup.closure_le]
    intro x hx
    simp at hx
    rcases hx with rfl | rfl | rfl
    · simpa [hurwitzQuaternionEightSubgroupAmbient] using
        hurwitz_quaternion_cube_root_normalizes_eight_subgroup
    · exact hurwitzQuaternionEightSubgroupAmbient.le_normalizer
        (Subgroup.subset_closure (by simp))
    · exact hurwitzQuaternionEightSubgroupAmbient.le_normalizer
        (Subgroup.subset_closure (by simp))
  -- Transport ambient normality to the subgroup of `G`.
  simpa [hurwitzQuaternionEightSubgroup, hurwitzQuaternionEightSubgroupAmbient] using
    (Subgroup.normal_subgroupOf_of_le_normalizer
      (H := hurwitzQuaternionGroup) (N := hurwitzQuaternionEightSubgroupAmbient) hG_normalizes)

/-- Helper for Exercise 8-8.5-4: the order-`3` Hurwitz generator is not the identity element of
`G`. -/
private theorem hurwitzQuaternionCubeRootInHurwitzGroup_ne_one :
    hurwitzQuaternionCubeRootInHurwitzGroup ≠ 1 := by
  -- Compare the real parts of the underlying quaternions.
  intro h
  have h' := congrArg
    (fun q : hurwitzQuaternionGroup ↦ ((((q : hurwitzQuaternionGroup) : ℍˣ) : ℍ).re)) h
  norm_num [hurwitzQuaternionCubeRootInHurwitzGroup, hurwitzQuaternionCubeRootUnit,
    hurwitzQuaternionCubeRoot] at h'

/-- Helper for Exercise 8-8.5-4: the subgroup generated by the Hurwitz unit `ω` has order `3`. -/
private theorem hurwitz_quaternion_cube_root_subgroup_card :
    Nat.card (Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup) = 3 := by
  -- The generator has exact order `3`, so its cyclic subgroup has cardinality `3`.
  have horder : orderOf hurwitzQuaternionCubeRootInHurwitzGroup = 3 := by
    exact orderOf_eq_prime
      hurwitzQuaternionCubeRootInHurwitzGroup_pow_three
      hurwitzQuaternionCubeRootInHurwitzGroup_ne_one
  simpa [horder] using Nat.card_zpowers hurwitzQuaternionCubeRootInHurwitzGroup

/-- Helper for Exercise 8-8.5-4: `G` is generated by the quaternion subgroup `E` together with the
order-`3` Hurwitz unit `ω`. -/
private theorem hurwitz_quaternion_eight_sup_cube_root_eq_top :
    hurwitzQuaternionEightSubgroup ⊔
        Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hi_mem : hamiltonQuaternionIInHurwitzGroup ∈ hurwitzQuaternionEightSubgroup := by
    simpa [hurwitzQuaternionEightSubgroup, hamiltonQuaternionIInHurwitzGroup] using
      (Subgroup.subset_closure (by simp) :
        hamiltonQuaternionIUnit ∈ hurwitzQuaternionEightSubgroupAmbient)
  have hj_mem : hamiltonQuaternionJInHurwitzGroup ∈ hurwitzQuaternionEightSubgroup := by
    simpa [hurwitzQuaternionEightSubgroup, hamiltonQuaternionJInHurwitzGroup] using
      (Subgroup.subset_closure (by simp) :
        hamiltonQuaternionJUnit ∈ hurwitzQuaternionEightSubgroupAmbient)
  -- The defining generators of `G` already lie in the displayed supremum.
  refine Subgroup.closure_induction
      (k := insert hurwitzQuaternionCubeRootUnit
        ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ))
      (p := fun y hy ↦
        (⟨y, hy⟩ : hurwitzQuaternionGroup) ∈
          hurwitzQuaternionEightSubgroup ⊔
            Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup) ?_ ?_ ?_ ?_ x.2
  · intro y hy
    simp at hy
    rcases hy with rfl | rfl | rfl
    · simpa [hurwitzQuaternionCubeRootInHurwitzGroup] using
        (show hurwitzQuaternionCubeRootInHurwitzGroup ∈
            hurwitzQuaternionEightSubgroup ⊔
              Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup from
          Subgroup.mem_sup_right (Subgroup.mem_zpowers hurwitzQuaternionCubeRootInHurwitzGroup))
    · simpa [hamiltonQuaternionIInHurwitzGroup] using
        (show hamiltonQuaternionIInHurwitzGroup ∈
            hurwitzQuaternionEightSubgroup ⊔
              Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup from
          Subgroup.mem_sup_left hi_mem)
    · simpa [hamiltonQuaternionJInHurwitzGroup] using
        (show hamiltonQuaternionJInHurwitzGroup ∈
            hurwitzQuaternionEightSubgroup ⊔
              Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup from
          Subgroup.mem_sup_left hj_mem)
  · show (1 : hurwitzQuaternionGroup) ∈
      hurwitzQuaternionEightSubgroup ⊔
        Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup
    exact Subgroup.one_mem _
  · intro y z hy hz hy_mem hz_mem
    simpa using
      (Subgroup.mul_mem
        (hurwitzQuaternionEightSubgroup ⊔
          Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup) hy_mem hz_mem)
  · intro y hy hy_mem
    show (⟨y, hy⟩ : hurwitzQuaternionGroup)⁻¹ ∈
      hurwitzQuaternionEightSubgroup ⊔
        Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup
    exact Subgroup.inv_mem _ hy_mem

/-- Helper for Exercise 8-8.5-4: every element of the cyclic subgroup generated by `ω` has cube
equal to `1`. -/
private theorem hurwitz_quaternion_cube_root_zpowers_pow_three
    {x : hurwitzQuaternionGroup}
    (hx : x ∈ Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup) :
    x ^ 3 = 1 := by
  have hω : orderOf hurwitzQuaternionCubeRootInHurwitzGroup = 3 := by
    exact orderOf_eq_prime
      hurwitzQuaternionCubeRootInHurwitzGroup_pow_three
      hurwitzQuaternionCubeRootInHurwitzGroup_ne_one
  have hx_order : orderOf x ∣ 3 := by
    simpa [hω] using orderOf_dvd_of_mem_zpowers hx
  obtain ⟨n, hn⟩ := hx_order
  -- Reduce the cube to a multiple of the element order.
  calc
    x ^ 3 = x ^ (orderOf x * n) := by rw [hn]
    _ = (x ^ orderOf x) ^ n := by rw [pow_mul]
    _ = 1 := by simp [pow_orderOf_eq_one]

/-- Helper for Exercise 8-8.5-4: the quaternion subgroup `E` and the cyclic subgroup `⟨ω⟩`
intersect trivially, because one has exponent dividing `4` and the other exponent dividing `3`. -/
private theorem hurwitz_quaternion_eight_subgroup_disjoint_cube_root :
    Disjoint hurwitzQuaternionEightSubgroup
      (Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup) := by
  rw [Subgroup.disjoint_def]
  intro x hxE hxω
  have hxE_ambient :
      (((x : hurwitzQuaternionGroup) : ℍˣ) ∈ hurwitzQuaternionEightSubgroupAmbient) :=
    Subgroup.mem_subgroupOf.mp hxE
  have hx_pow_four : x ^ 4 = 1 := by
    -- The ambient exponent-`4` relation descends to the subgroup element.
    apply Subtype.ext
    simpa using hurwitz_quaternion_eight_subgroup_ambient_pow_four hxE_ambient
  have hx_pow_three : x ^ 3 = 1 :=
    hurwitz_quaternion_cube_root_zpowers_pow_three hxω
  have h4 : orderOf x ∣ 4 := orderOf_dvd_of_pow_eq_one hx_pow_four
  have h3 : orderOf x ∣ 3 := orderOf_dvd_of_pow_eq_one hx_pow_three
  have h1 : orderOf x = 1 := by
    have hdiv : orderOf x ∣ Nat.gcd 4 3 := Nat.dvd_gcd h4 h3
    norm_num at hdiv
    exact (orderOf_eq_one_iff).2 hdiv
  exact orderOf_eq_one_iff.mp h1

/-- Helper for Exercise 8-8.5-4: the quaternion subgroup `E` has the cyclic order-`3` subgroup
generated by `ω` as an internal complement. -/
private theorem hurwitz_quaternion_eight_subgroup_complement_cube_root :
    hurwitzQuaternionEightSubgroup.IsComplement'
      (Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup) := by
  letI : hurwitzQuaternionEightSubgroup.Normal := hurwitz_quaternion_eight_subgroup_normal
  -- The normality of `E` turns the `sup = ⊤` statement into a set-theoretic product decomposition.
  refine Subgroup.isComplement'_of_disjoint_and_mul_eq_univ
    hurwitz_quaternion_eight_subgroup_disjoint_cube_root ?_
  calc
    ((hurwitzQuaternionEightSubgroup : Set hurwitzQuaternionGroup) *
        (Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup :
          Set hurwitzQuaternionGroup)) =
        ↑(hurwitzQuaternionEightSubgroup ⊔
          Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup) := by
            symm
            exact Subgroup.coe_mul_of_right_le_normalizer_left
              hurwitzQuaternionEightSubgroup
              (Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup)
              Subgroup.le_normalizer_of_normal
    _ = Set.univ := by
      simpa [hurwitz_quaternion_eight_sup_cube_root_eq_top]

-- Proof sketch: `hurwitzQuaternionGroup` is the binary tetrahedral group, generated by the
-- quaternion subgroup `E = {±1, ±i, ±j, ±k}` together with one Hurwitz unit of order `3`, hence
-- has order `24`.
/-- Serre's Hurwitz quaternion group `G` is finite. -/
theorem hurwitzQuaternionGroup_finite : Finite hurwitzQuaternionGroup := by
  let C : Subgroup hurwitzQuaternionGroup := Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup
  letI : Finite hurwitzQuaternionEightSubgroup := hurwitz_quaternion_eight_subgroup_finite
  have hCfinite : Finite C := by
    -- The cyclic factor has cardinality `3`, hence is finite.
    have hcardC : Nat.card C = 3 := by
      simpa [C] using hurwitz_quaternion_cube_root_subgroup_card
    exact Nat.finite_of_card_ne_zero (by rw [hcardC]; norm_num)
  letI : Finite C := hCfinite
  letI : hurwitzQuaternionEightSubgroup.Normal := hurwitz_quaternion_eight_subgroup_normal
  -- Surject onto `G` using the factorization coming from `G = ⟨ω⟩ ⋅ E`.
  refine Finite.of_surjective (fun p : C × hurwitzQuaternionEightSubgroup ↦ p.1 * p.2) ?_
  intro g
  have hg : g ∈ C ⊔ hurwitzQuaternionEightSubgroup := by
    simpa [C, sup_comm, hurwitz_quaternion_eight_sup_cube_root_eq_top]
  rw [Subgroup.mem_sup_of_normal_right] at hg
  rcases hg with ⟨c, hc, e, he, hce⟩
  exact ⟨(⟨c, hc⟩, ⟨e, he⟩), hce⟩

instance : Finite hurwitzQuaternionGroup := hurwitzQuaternionGroup_finite

/-- The matrix image of the Hamilton quaternion `i`. -/
private def hamiltonQuaternionMatrixI : M₂(ℂ) :=
  !![Complex.I, 0; 0, -Complex.I]

/-- The matrix image of the Hamilton quaternion `j`. -/
private def hamiltonQuaternionMatrixJ : M₂(ℂ) :=
  !![0, 1; -1, 0]

/-- The matrix image of the Hamilton quaternion `k = ij`. -/
private def hamiltonQuaternionMatrixK : M₂(ℂ) :=
  !![0, Complex.I; Complex.I, 0]

-- Proof sketch: multiply the diagonal matrix for `i` with itself and simplify entrywise.
/-- The chosen matrix for `i` satisfies the Hamilton relation `i² = -1`. -/
private theorem hamiltonQuaternionMatrixI_sq :
    hamiltonQuaternionMatrixI * hamiltonQuaternionMatrixI =
      (-1 : ℝ) • (1 : M₂(ℂ)) := by
  -- Compare the four entries after multiplying the explicit `2 × 2` matrices.
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hamiltonQuaternionMatrixI]

-- Proof sketch: multiply the off-diagonal matrix for `j` with itself and simplify entrywise.
/-- The chosen matrix for `j` satisfies the Hamilton relation `j² = -1`. -/
private theorem hamiltonQuaternionMatrixJ_sq :
    hamiltonQuaternionMatrixJ * hamiltonQuaternionMatrixJ =
      (-1 : ℝ) • (1 : M₂(ℂ)) := by
  -- Compare the four entries after multiplying the explicit `2 × 2` matrices.
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hamiltonQuaternionMatrixJ]

-- Proof sketch: compute the matrix product corresponding to `ij`.
/-- The chosen matrices satisfy `ij = k`. -/
private theorem hamiltonQuaternionMatrixI_mul_J :
    hamiltonQuaternionMatrixI * hamiltonQuaternionMatrixJ = hamiltonQuaternionMatrixK := by
  -- Compare the four entries of the matrix product with the chosen matrix for `k`.
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hamiltonQuaternionMatrixI,
    hamiltonQuaternionMatrixJ, hamiltonQuaternionMatrixK]

-- Proof sketch: compute the matrix product corresponding to `ji = -k`. -/
private theorem hamiltonQuaternionMatrixJ_mul_I :
    hamiltonQuaternionMatrixJ * hamiltonQuaternionMatrixI =
      -hamiltonQuaternionMatrixK := by
  -- Compare the four entries of the matrix product with the matrix `-k`.
  ext i j
  fin_cases i <;> fin_cases j <;> simp [hamiltonQuaternionMatrixI,
    hamiltonQuaternionMatrixJ, hamiltonQuaternionMatrixK]

/-- The standard `ℝ`-algebra homomorphism from the Hamilton quaternions to `M₂(ℂ)`. It is the
concrete form of the usual complexification map `ℍ ⊗[ℝ] ℂ ≃ M₂(ℂ)`. -/
def hamiltonQuaternionToComplexMatrix : ℍ →ₐ[ℝ] M₂(ℂ) :=
  ({ i := hamiltonQuaternionMatrixI
     j := hamiltonQuaternionMatrixJ
     k := hamiltonQuaternionMatrixK
     i_mul_i := by
       calc
         hamiltonQuaternionMatrixI * hamiltonQuaternionMatrixI = (-1 : ℝ) • (1 : M₂(ℂ)) :=
           hamiltonQuaternionMatrixI_sq
         _ = (-1 : ℝ) • (1 : M₂(ℂ)) + (0 : ℝ) • hamiltonQuaternionMatrixI := by
           rw [show (0 : ℝ) • hamiltonQuaternionMatrixI = (0 : M₂(ℂ)) by
             ext i j
             simp, add_zero]
     j_mul_j := by simpa using hamiltonQuaternionMatrixJ_sq
     i_mul_j := hamiltonQuaternionMatrixI_mul_J
     j_mul_i := by
       calc
         hamiltonQuaternionMatrixJ * hamiltonQuaternionMatrixI = -hamiltonQuaternionMatrixK :=
           hamiltonQuaternionMatrixJ_mul_I
         _ = (0 : ℝ) • hamiltonQuaternionMatrixJ - hamiltonQuaternionMatrixK := by
           rw [show (0 : ℝ) • hamiltonQuaternionMatrixJ = (0 : M₂(ℂ)) by
             ext i j
             simp, zero_sub] } :
      QuaternionAlgebra.Basis M₂(ℂ) (-1 : ℝ) 0 (-1 : ℝ)).liftHom

/-- The degree-`2` complex representation of Serre's group `G` obtained from the standard
embedding of the Hamilton quaternions into `M₂(ℂ)`. -/
def hurwitzQuaternionMatrixRepresentation :
    Representation ℂ hurwitzQuaternionGroup ℂ² :=
  toLinAlgEquiv'.toMonoidHom.comp
    ((hamiltonQuaternionToComplexMatrix.toMonoidHom.comp (Units.coeHom ℍ)).comp
      hurwitzQuaternionGroup.subtype)

/-- Helper for Exercise 8-8.5-4: the quaternion subgroup `E` is solvable because it is a finite
`2`-group. -/
private theorem hurwitz_quaternion_eight_subgroup_isSolvable :
    IsSolvable hurwitzQuaternionEightSubgroup := by
  letI : Fact (Nat.Prime 2) := ⟨by decide⟩
  have hP : IsPGroup 2 hurwitzQuaternionEightSubgroup := by
    intro x
    -- The ambient exponent-`4` relation descends directly to the subgroup element of `E`.
    refine ⟨2, ?_⟩
    apply Subtype.ext
    apply Subtype.ext
    simpa using
      hurwitz_quaternion_eight_subgroup_ambient_pow_four (Subgroup.mem_subgroupOf.mp x.2)
  -- Finite `p`-groups are nilpotent, hence solvable.
  letI : Group.IsNilpotent ↥hurwitzQuaternionEightSubgroup := by
    exact IsPGroup.isNilpotent hP
  show IsSolvable ↥hurwitzQuaternionEightSubgroup
  infer_instance

-- Proof sketch: the group has a normal `2`-Sylow subgroup `E` with cyclic quotient of order `3`,
-- so its derived series terminates after the derived series of `E` and the abelian quotient.
/-- Exercise 8-8.5-4 (1): Serre's subgroup `G` of the Hamilton quaternion units is solvable. -/
theorem hurwitzQuaternionGroup_isSolvable :
    IsSolvable hurwitzQuaternionGroup := by
  letI : IsSolvable hurwitzQuaternionEightSubgroup :=
    hurwitz_quaternion_eight_subgroup_isSolvable
  letI : hurwitzQuaternionEightSubgroup.Normal := hurwitz_quaternion_eight_subgroup_normal
  let C : Subgroup hurwitzQuaternionGroup := Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup
  have hquot : IsSolvable (hurwitzQuaternionGroup ⧸ hurwitzQuaternionEightSubgroup) := by
    let e : hurwitzQuaternionGroup ⧸ hurwitzQuaternionEightSubgroup ≃* C :=
      hurwitz_quaternion_eight_subgroup_complement_cube_root.symm.QuotientMulEquiv
    letI : IsCyclic C := inferInstance
    letI : CommGroup C := (IsCyclic.commGroup : CommGroup C)
    exact solvable_of_surjective (f := e.symm.toMonoidHom) e.symm.surjective
  letI : IsSolvable (hurwitzQuaternionGroup ⧸ hurwitzQuaternionEightSubgroup) := hquot
  let f : hurwitzQuaternionEightSubgroup →* hurwitzQuaternionGroup :=
    hurwitzQuaternionEightSubgroup.subtype
  let g : hurwitzQuaternionGroup →* hurwitzQuaternionGroup ⧸ hurwitzQuaternionEightSubgroup :=
    QuotientGroup.mk' hurwitzQuaternionEightSubgroup
  have hker : g.ker ≤ f.range := by
    -- The inclusion of `E` into `G` identifies the kernel of the quotient map.
    simpa [f, g, QuotientGroup.ker_mk', Subgroup.range_subtype]
  exact solvable_of_ker_le_range f g hker

-- Proof sketch: conjugation by the additional Hurwitz units permutes the set `±1, ±i, ±j, ±k`,
-- so the eight-element subgroup is stable under conjugation inside `G`.
/-- Exercise 8-8.5-4 (2): the quaternion subgroup `E = {±1, ±i, ±j, ±k}` is normal in `G`. -/
theorem hurwitzQuaternionEightSubgroup_normal :
    hurwitzQuaternionEightSubgroup.Normal := by
  exact hurwitz_quaternion_eight_subgroup_normal

/-- Helper for Exercise 8-8.5-4: the quaternion embedding sends the Hamilton unit `i` to the
chosen diagonal matrix. -/
private theorem hamiltonQuaternionToComplexMatrix_i :
    hamiltonQuaternionToComplexMatrix (↑hamiltonQuaternionIUnit : ℍ) = hamiltonQuaternionMatrixI := by
  -- Evaluate the quaternion lift on the basis vector `i` entrywise.
  unfold hamiltonQuaternionToComplexMatrix
  ext i j
  fin_cases i <;> fin_cases j
  all_goals
    change
      (({
          i := hamiltonQuaternionMatrixI
          j := hamiltonQuaternionMatrixJ
          k := hamiltonQuaternionMatrixK
          i_mul_i := hamiltonQuaternionToComplexMatrix._proof_1
          j_mul_j := by simpa using hamiltonQuaternionMatrixJ_sq
          i_mul_j := hamiltonQuaternionMatrixI_mul_J
          j_mul_i := hamiltonQuaternionToComplexMatrix._proof_2
        } : QuaternionAlgebra.Basis M₂(ℂ) (-1 : ℝ) 0 (-1 : ℝ)).lift
          (↑hamiltonQuaternionIUnit : ℍ)) _ _ =
        hamiltonQuaternionMatrixI _ _
    simp [QuaternionAlgebra.Basis.lift, hamiltonQuaternionIUnit,
      hamiltonQuaternionMatrixI, hamiltonQuaternionMatrixJ, hamiltonQuaternionMatrixK]

/-- Helper for Exercise 8-8.5-4: the quaternion embedding sends the Hamilton unit `j` to the
chosen off-diagonal matrix. -/
private theorem hamiltonQuaternionToComplexMatrix_j :
    hamiltonQuaternionToComplexMatrix (↑hamiltonQuaternionJUnit : ℍ) = hamiltonQuaternionMatrixJ := by
  -- Evaluate the quaternion lift on the basis vector `j` entrywise.
  unfold hamiltonQuaternionToComplexMatrix
  ext i j
  fin_cases i <;> fin_cases j
  all_goals
    change
      (({
          i := hamiltonQuaternionMatrixI
          j := hamiltonQuaternionMatrixJ
          k := hamiltonQuaternionMatrixK
          i_mul_i := hamiltonQuaternionToComplexMatrix._proof_1
          j_mul_j := by simpa using hamiltonQuaternionMatrixJ_sq
          i_mul_j := hamiltonQuaternionMatrixI_mul_J
          j_mul_i := hamiltonQuaternionToComplexMatrix._proof_2
        } : QuaternionAlgebra.Basis M₂(ℂ) (-1 : ℝ) 0 (-1 : ℝ)).lift
          (↑hamiltonQuaternionJUnit : ℍ)) _ _ =
        hamiltonQuaternionMatrixJ _ _
    simp [QuaternionAlgebra.Basis.lift, hamiltonQuaternionJUnit,
      hamiltonQuaternionMatrixI, hamiltonQuaternionMatrixJ, hamiltonQuaternionMatrixK]

/-- Helper for Exercise 8-8.5-4: the representation sends the quaternion generator `i` to the
expected diagonal action on coordinates. -/
private theorem hurwitzQuaternionMatrixRepresentation_apply_i (v : ℂ²) :
    hurwitzQuaternionMatrixRepresentation hamiltonQuaternionIInHurwitzGroup v =
      ![Complex.I * v 0, -Complex.I * v 1] := by
  -- Unfold the representation and read off the diagonal matrix action of `i`.
  ext i
  fin_cases i <;>
    simp [hurwitzQuaternionMatrixRepresentation, hamiltonQuaternionIInHurwitzGroup,
      hamiltonQuaternionToComplexMatrix_i, Matrix.toLinAlgEquiv'_apply, Matrix.mulVec,
      dotProduct, hamiltonQuaternionMatrixI]

/-- Helper for Exercise 8-8.5-4: the representation sends the first coordinate axis to the second
under the quaternion generator `j`. -/
private theorem hurwitzQuaternionMatrixRepresentation_apply_j_e0 :
    hurwitzQuaternionMatrixRepresentation hamiltonQuaternionJInHurwitzGroup ![(1 : ℂ), 0] =
      -(![0, (1 : ℂ)] : ℂ²) := by
  -- Unfold the representation and evaluate the `j`-matrix on the first basis vector.
  ext i
  fin_cases i <;>
    simp [hurwitzQuaternionMatrixRepresentation, hamiltonQuaternionJInHurwitzGroup,
      hamiltonQuaternionToComplexMatrix_j, Matrix.toLinAlgEquiv'_apply, Matrix.mulVec,
      dotProduct, hamiltonQuaternionMatrixJ]

/-- Helper for Exercise 8-8.5-4: the representation sends the second coordinate axis to the first
under the quaternion generator `j`. -/
private theorem hurwitzQuaternionMatrixRepresentation_apply_j_e1 :
    hurwitzQuaternionMatrixRepresentation hamiltonQuaternionJInHurwitzGroup ![0, (1 : ℂ)] =
      (![(1 : ℂ), 0] : ℂ²) := by
  -- Unfold the representation and evaluate the `j`-matrix on the second basis vector.
  ext i
  fin_cases i <;>
    simp [hurwitzQuaternionMatrixRepresentation, hamiltonQuaternionJInHurwitzGroup,
      hamiltonQuaternionToComplexMatrix_j, Matrix.toLinAlgEquiv'_apply, Matrix.mulVec,
      dotProduct, hamiltonQuaternionMatrixJ]

/-- Helper for Exercise 8-8.5-4: any nonzero subrepresentation of the quaternionic matrix model
already contains both coordinate axes, hence must be all of `ℂ²`. -/
private theorem hurwitz_quaternion_matrix_representation_nonzero_subrepresentation_eq_top
    (W : Subrepresentation hurwitzQuaternionMatrixRepresentation) (hW : W ≠ ⊥) :
    W = ⊤ := by
  have hW' : W.toSubmodule ≠ ⊥ := by
    intro hbot
    exact hW (Subrepresentation.toSubmodule_injective hbot)
  rcases (Submodule.ne_bot_iff _).mp hW' with ⟨v, hv, hv0⟩
  by_cases ha : v 0 = 0
  · have hb : v 1 ≠ 0 := by
      intro hb
      apply hv0
      ext i
      fin_cases i <;> simp [ha, hb]
    have he1_raw : ((v 1)⁻¹ : ℂ) • v ∈ W := by
      -- Scaling a nonzero vector on the second axis isolates `e₁`.
      exact W.toSubmodule.smul_mem _ hv
    have he1 : (![0, (1 : ℂ)] : ℂ²) ∈ W := by
      have he1_eq : ((v 1)⁻¹ : ℂ) • v = (![0, (1 : ℂ)] : ℂ²) := by
        ext i
        fin_cases i <;> simp [ha, hb]
      simpa [he1_eq] using he1_raw
    have hj_e1_mem :
        hurwitzQuaternionMatrixRepresentation hamiltonQuaternionJInHurwitzGroup
            (![0, (1 : ℂ)] : ℂ²) ∈ W := by
      exact W.apply_mem_toSubmodule _ he1
    have he0 : (![(1 : ℂ), 0] : ℂ²) ∈ W := by
      simpa [hurwitzQuaternionMatrixRepresentation_apply_j_e1] using hj_e1_mem
    apply Subrepresentation.toSubmodule_injective
    apply le_antisymm le_top
    intro x hx
    -- Once both coordinate axes lie in `W`, every vector in `ℂ²` lies in `W`.
    have hx_decomp :
        x = (x 0) • (![(1 : ℂ), 0] : ℂ²) + (x 1) • (![0, (1 : ℂ)] : ℂ²) := by
      ext i
      fin_cases i <;> simp
    rw [hx_decomp]
    exact W.toSubmodule.add_mem
      (W.toSubmodule.smul_mem _ he0)
      (W.toSubmodule.smul_mem _ he1)
  · have hi_v_mem :
      hurwitzQuaternionMatrixRepresentation hamiltonQuaternionIInHurwitzGroup v ∈ W := by
      exact W.apply_mem_toSubmodule _ hv
    have haxis0_raw :
        v - Complex.I • hurwitzQuaternionMatrixRepresentation hamiltonQuaternionIInHurwitzGroup v ∈
          W := by
      -- The diagonal `i`-action kills the second coordinate and doubles the first.
      exact W.toSubmodule.sub_mem hv (W.toSubmodule.smul_mem _ hi_v_mem)
    have haxis0 :
        (![(2 : ℂ) * v 0, 0] : ℂ²) ∈ W := by
      have haxis0_eq :
          v - Complex.I • hurwitzQuaternionMatrixRepresentation hamiltonQuaternionIInHurwitzGroup v =
            (![(2 : ℂ) * v 0, 0] : ℂ²) := by
        ext i
        fin_cases i
        · simpa [hurwitzQuaternionMatrixRepresentation_apply_i, sub_eq_add_neg, two_mul] using
            (show v 0 - Complex.I * (Complex.I * v 0) = (2 : ℂ) * v 0 from by
              calc
                v 0 - Complex.I * (Complex.I * v 0) = v 0 - ((Complex.I * Complex.I) * v 0) := by
                    ring
                _ = v 0 - (-v 0) := by
                    simp [Complex.I_sq]
                _ = (2 : ℂ) * v 0 := by ring)
        · simpa [hurwitzQuaternionMatrixRepresentation_apply_i, sub_eq_add_neg] using
            (show v 1 + Complex.I * (Complex.I * v 1) = 0 from by
              calc
                v 1 + Complex.I * (Complex.I * v 1) = v 1 + ((Complex.I * Complex.I) * v 1) := by
                    ring
                _ = v 1 + (-v 1) := by
                    simp [Complex.I_sq]
                _ = 0 := by ring)
      simpa [haxis0_eq] using haxis0_raw
    have htwo : (2 : ℂ) ≠ 0 := by norm_num
    have he0_raw : ((v 0)⁻¹ * (2 : ℂ)⁻¹ : ℂ) • (![(2 : ℂ) * v 0, 0] : ℂ²) ∈ W := by
      -- Rescale the isolated first axis to the standard basis vector `e₀`.
      exact W.toSubmodule.smul_mem _ haxis0
    have he0 : (![(1 : ℂ), 0] : ℂ²) ∈ W := by
      have he0_eq :
          ((v 0)⁻¹ * (2 : ℂ)⁻¹ : ℂ) • (![(2 : ℂ) * v 0, 0] : ℂ²) = (![(1 : ℂ), 0] : ℂ²) := by
        ext i
        fin_cases i
        · simp
          field_simp [ha, htwo]
        · simp
      simpa [he0_eq] using he0_raw
    have hj_e0_mem :
        hurwitzQuaternionMatrixRepresentation hamiltonQuaternionJInHurwitzGroup
            (![(1 : ℂ), 0] : ℂ²) ∈ W := by
      exact W.apply_mem_toSubmodule _ he0
    have hneg_e1 : -(![0, (1 : ℂ)] : ℂ²) ∈ W := by
      simpa [hurwitzQuaternionMatrixRepresentation_apply_j_e0] using hj_e0_mem
    have he1 : (![0, (1 : ℂ)] : ℂ²) ∈ W := by
      simpa using W.toSubmodule.neg_mem hneg_e1
    apply Subrepresentation.toSubmodule_injective
    apply le_antisymm le_top
    intro x hx
    -- The two coordinate axes generate the whole two-dimensional space.
    have hx_decomp :
        x = (x 0) • (![(1 : ℂ), 0] : ℂ²) + (x 1) • (![0, (1 : ℂ)] : ℂ²) := by
      ext i
      fin_cases i <;> simp
    rw [hx_decomp]
    exact W.toSubmodule.add_mem
      (W.toSubmodule.smul_mem _ he0)
      (W.toSubmodule.smul_mem _ he1)

-- Proof sketch: choose a Hurwitz unit of order `3`, show that the subgroup it generates has
-- cardinality `3`, and verify that this subgroup is complementary to `E` inside `G`; a subgroup
-- of prime order is automatically cyclic.
/-- Exercise 8-8.5-4 (3): Serre's group `G` admits a complement of order `3` to the normal
subgroup `E`; such a complement is automatically cyclic, so `G` is an internal semidirect product
of that cyclic subgroup by `E`. -/
theorem hurwitzQuaternionGroup_exists_cyclic_complement_of_order_three :
    ∃ C : Subgroup hurwitzQuaternionGroup,
      hurwitzQuaternionEightSubgroup.IsComplement' C ∧ Nat.card C = 3 := by
  let C : Subgroup hurwitzQuaternionGroup := Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup
  -- The source decomposition is `G = E ⋊ ⟨ω⟩`, with `ω` of order `3`.
  refine ⟨C, hurwitz_quaternion_eight_subgroup_complement_cube_root,
    hurwitz_quaternion_cube_root_subgroup_card⟩

-- Proof sketch: identify the action with the restriction of the standard `2 × 2` matrix
-- representation coming from `ℍ ⊗[ℝ] ℂ ≃ M₂(ℂ)`, then show that no nontrivial line in `ℂ²` is
-- stable under the images of both `E` and an element of order `3`.
/-- Exercise 8-8.5-4 (4): the standard matrix representation of `G` on `ℂ²` coming from the
complexified Hamilton quaternions is irreducible. -/
theorem hurwitzQuaternionMatrixRepresentation_isIrreducible :
    hurwitzQuaternionMatrixRepresentation.IsIrreducible := by
  -- Every nonzero stable subspace contains both coordinate axes, so there are no proper
  -- nontrivial subrepresentations.
  letI : Nontrivial (Subrepresentation hurwitzQuaternionMatrixRepresentation) := by
    refine ⟨⟨⊥, ⊤, ?_⟩⟩
    intro h
    have h' := congrArg Subrepresentation.toSubmodule h
    exact bot_ne_top h'
  refine IsSimpleOrder.of_forall_eq_top fun W hW ↦ ?_
  exact hurwitz_quaternion_matrix_representation_nonzero_subrepresentation_eq_top W hW

/-- Helper for Exercise 8-8.5-4: the `q`-indexed summand in an induced decomposition is the
`q.out`-translate of the inducing subspace. -/
private theorem hurwitz_quaternion_left_quotient_submodule_out
    (H : Subgroup hurwitzQuaternionGroup)
    (W : Subrepresentation (hurwitzQuaternionMatrixRepresentation.comp H.subtype))
    (q : hurwitzQuaternionGroup ⧸ H) :
    hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W q =
      W.toSubmodule.map (hurwitzQuaternionMatrixRepresentation q.out) := by
  -- Replace the quotient class by its chosen representative so the owner definition unfolds.
  simpa [Quotient.out_eq q] using
    (hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule_mk H W q.out)

/-- Helper for Exercise 8-8.5-4: every coset summand in an induced decomposition is linearly
equivalent to the original inducing subspace. -/
private noncomputable def hurwitz_quaternion_left_quotient_submodule_equiv
    (H : Subgroup hurwitzQuaternionGroup)
    (W : Subrepresentation (hurwitzQuaternionMatrixRepresentation.comp H.subtype))
    (q : hurwitzQuaternionGroup ⧸ H) :
    W.toSubmodule ≃ₗ[ℂ] hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W q :=
  let e : ℂ² ≃ₗ[ℂ] ℂ² :=
    LinearEquiv.ofBijective
      (hurwitzQuaternionMatrixRepresentation q.out)
      (hurwitzQuaternionMatrixRepresentation.apply_bijective q.out)
  (e.submoduleMap W.toSubmodule).trans
    (LinearEquiv.ofEq _ _ (hurwitz_quaternion_left_quotient_submodule_out H W q).symm)

/-- Helper for Exercise 8-8.5-4: a monomial witness for the two-dimensional quaternionic
representation has index `2`. -/
private theorem hurwitz_quaternion_monomial_witness_index_eq_two
    (H : Subgroup hurwitzQuaternionGroup)
    (W : Subrepresentation (hurwitzQuaternionMatrixRepresentation.comp H.subtype))
    (hW : Module.finrank ℂ W.toSubmodule = 1)
    (hInduced : hurwitzQuaternionMatrixRepresentation.IsInducedFromSubrepresentation H W) :
    H.index = 2 := by
  classical
  letI : DecidableEq (hurwitzQuaternionGroup ⧸ H) := Classical.decEq _
  letI : Fintype (hurwitzQuaternionGroup ⧸ H) := Fintype.ofFinite (hurwitzQuaternionGroup ⧸ H)
  have hInternal :
      DirectSum.IsInternal (hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W) := by
    -- Unpack the owner predicate into the internal direct-sum decomposition it controls.
    simpa [Representation.IsInducedFromSubrepresentation] using hInduced
  letI := DirectSum.IsInternal.chooseDecomposition
    (hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W) hInternal
  letI :
      ∀ q : hurwitzQuaternionGroup ⧸ H,
        Module.Free ℂ (hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W q) :=
    fun q ↦ Module.Free.of_divisionRing ℂ _
  have hsummand :
      ∀ q : hurwitzQuaternionGroup ⧸ H,
        Module.finrank ℂ (hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W q) = 1 := by
    intro q
    simpa [hW] using
      (hurwitz_quaternion_left_quotient_submodule_equiv H W q).finrank_eq.symm
  let e :=
    (DirectSum.decomposeLinearEquiv
      (hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W)).symm
  have hdim :
      Module.finrank ℂ ℂ² = H.index := by
    calc
      Module.finrank ℂ ℂ² =
          Module.finrank ℂ
            (DirectSum (hurwitzQuaternionGroup ⧸ H)
              fun q ↦ hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W q) := by
            exact e.finrank_eq.symm
      _ = ∑ q : hurwitzQuaternionGroup ⧸ H,
            Module.finrank ℂ (hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W q) := by
            exact Module.finrank_directSum
              (R := ℂ)
              (M := fun q ↦ hurwitzQuaternionMatrixRepresentation.leftQuotientSubmodule H W q)
      _ = ∑ _q : hurwitzQuaternionGroup ⧸ H, 1 := by
            refine Finset.sum_congr rfl ?_
            intro q hq
            exact hsummand q
      _ = H.index := by
            simp [Subgroup.index_eq_card]
  have hfinrank : Module.finrank ℂ ℂ² = 2 := by
    show Module.finrank ℂ (Fin 2 → ℂ) = 2
    simpa using (Module.finrank_fin_fun (R := ℂ) (n := 2))
  rw [hfinrank] at hdim
  exact hdim.symm

/-- Helper for Exercise 8-8.5-4: the quaternion subgroup `E` lies inside the commutator subgroup
of `G`. -/
private theorem hurwitz_quaternion_eight_subgroup_eq_closure_in_group :
    hurwitzQuaternionEightSubgroup =
      Subgroup.closure
        ({hamiltonQuaternionIInHurwitzGroup, hamiltonQuaternionJInHurwitzGroup} :
          Set hurwitzQuaternionGroup) := by
  -- Map both subgroup candidates to `ℍˣ`, where the left-hand side is exactly the ambient
  -- quaternion subgroup and the right-hand side becomes the image of the two subgroup generators.
  apply (Subgroup.map_subtype_inj).mp
  change Subgroup.map hurwitzQuaternionGroup.subtype
      (hurwitzQuaternionEightSubgroupAmbient.subgroupOf hurwitzQuaternionGroup) = _
  rw [Subgroup.map_subgroupOf_eq_of_le hurwitz_quaternion_eight_subgroup_ambient_le_group,
    MonoidHom.map_closure]
  -- The image of the two subgroup generators is exactly `{i, j}` in the ambient unit group.
  have himage :
      ((fun a : hurwitzQuaternionGroup ↦ (a : ℍˣ)) ''
          ({hamiltonQuaternionIInHurwitzGroup, hamiltonQuaternionJInHurwitzGroup} :
            Set hurwitzQuaternionGroup)) =
        ({hamiltonQuaternionIUnit, hamiltonQuaternionJUnit} : Set ℍˣ) := by
    ext x
    constructor
    · intro hx
      rcases hx with ⟨y, hy, rfl⟩
      simp at hy
      rcases hy with rfl | rfl <;> simp [hamiltonQuaternionIInHurwitzGroup,
        hamiltonQuaternionJInHurwitzGroup]
    · intro hx
      simp at hx
      rcases hx with rfl | rfl
      · exact ⟨hamiltonQuaternionIInHurwitzGroup, by simp, rfl⟩
      · exact ⟨hamiltonQuaternionJInHurwitzGroup, by simp, rfl⟩
  simpa [hurwitzQuaternionEightSubgroupAmbient, himage]

/-- Helper for Exercise 8-8.5-4: the quaternion generators `i`, `j`, and `k` already lie in the
commutator subgroup of `G`. -/
private theorem hurwitz_quaternion_basic_units_mem_commutator :
    hamiltonQuaternionIInHurwitzGroup ∈ commutator hurwitzQuaternionGroup ∧
      hamiltonQuaternionJInHurwitzGroup ∈ commutator hurwitzQuaternionGroup ∧
      hamiltonQuaternionKInHurwitzGroup ∈ commutator hurwitzQuaternionGroup := by
  have hcomm_ij :
      ⁅hamiltonQuaternionIInHurwitzGroup, hamiltonQuaternionJInHurwitzGroup⁆ =
        hamiltonQuaternionIInHurwitzGroup * hamiltonQuaternionIInHurwitzGroup := by
    -- Expand the commutator `[i, j]` and rewrite the result as `i²`.
    apply Subtype.ext
    change hamiltonQuaternionIUnit * hamiltonQuaternionJUnit * hamiltonQuaternionIUnit⁻¹ *
        hamiltonQuaternionJUnit⁻¹ =
      hamiltonQuaternionIUnit * hamiltonQuaternionIUnit
    rw [hamiltonQuaternionIUnit_inv, hamiltonQuaternionJUnit_inv]
    apply Units.ext
    ext <;> norm_num [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, mul_assoc]
  have hcomm_ωi :
      ⁅hurwitzQuaternionCubeRootInHurwitzGroup, hamiltonQuaternionIInHurwitzGroup⁆ =
        hamiltonQuaternionIInHurwitzGroup * hamiltonQuaternionKInHurwitzGroup := by
    -- Rewrite `[ω, i]` using the ambient conjugation formula before comparing coordinates.
    apply Subtype.ext
    change hurwitzQuaternionCubeRootUnit * hamiltonQuaternionIUnit *
        hurwitzQuaternionCubeRootUnit⁻¹ * hamiltonQuaternionIUnit⁻¹ =
      hamiltonQuaternionIUnit * (hamiltonQuaternionIUnit * hamiltonQuaternionJUnit)
    rw [hurwitz_quaternion_cube_root_unit_conj_i, hamiltonQuaternionIUnit_inv]
    apply Units.ext
    ext <;> norm_num [hurwitzQuaternionCubeRootUnit, hurwitzQuaternionCubeRoot,
      hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, mul_assoc]
  have hcomm_ωj :
      ⁅hurwitzQuaternionCubeRootInHurwitzGroup, hamiltonQuaternionJInHurwitzGroup⁆ =
        hamiltonQuaternionJInHurwitzGroup * hamiltonQuaternionIInHurwitzGroup := by
    -- Rewrite `[ω, j]` using the ambient conjugation formula before comparing coordinates.
    apply Subtype.ext
    change hurwitzQuaternionCubeRootUnit * hamiltonQuaternionJUnit *
        hurwitzQuaternionCubeRootUnit⁻¹ * hamiltonQuaternionJUnit⁻¹ =
      hamiltonQuaternionJUnit * hamiltonQuaternionIUnit
    rw [hurwitz_quaternion_cube_root_unit_conj_j, hamiltonQuaternionJUnit_inv]
    apply Units.ext
    ext <;> norm_num [hurwitzQuaternionCubeRootUnit, hurwitzQuaternionCubeRoot,
      hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, mul_assoc]
  have hcomm_ij_mem :
      ⁅hamiltonQuaternionIInHurwitzGroup, hamiltonQuaternionJInHurwitzGroup⁆ ∈
        commutator hurwitzQuaternionGroup := by
    -- Every group commutator lies in the commutator subgroup.
    simpa using
      (Subgroup.commutator_mem_commutator
        (H₁ := (⊤ : Subgroup hurwitzQuaternionGroup))
        (H₂ := (⊤ : Subgroup hurwitzQuaternionGroup))
        (by simp) (by simp))
  have hcomm_ωi_mem :
      ⁅hurwitzQuaternionCubeRootInHurwitzGroup, hamiltonQuaternionIInHurwitzGroup⁆ ∈
        commutator hurwitzQuaternionGroup := by
    -- Likewise for the commutator built from `ω` and `i`.
    simpa using
      (Subgroup.commutator_mem_commutator
        (H₁ := (⊤ : Subgroup hurwitzQuaternionGroup))
        (H₂ := (⊤ : Subgroup hurwitzQuaternionGroup))
        (by simp) (by simp))
  have hcomm_ωj_mem :
      ⁅hurwitzQuaternionCubeRootInHurwitzGroup, hamiltonQuaternionJInHurwitzGroup⁆ ∈
        commutator hurwitzQuaternionGroup := by
    -- Likewise for the commutator built from `ω` and `j`.
    simpa using
      (Subgroup.commutator_mem_commutator
        (H₁ := (⊤ : Subgroup hurwitzQuaternionGroup))
        (H₂ := (⊤ : Subgroup hurwitzQuaternionGroup))
        (by simp) (by simp))
  have hii_mem :
      hamiltonQuaternionIInHurwitzGroup * hamiltonQuaternionIInHurwitzGroup ∈
        commutator hurwitzQuaternionGroup := by
    -- Transport the explicit commutator value `[i, j] = i²` into subgroup membership.
    simpa [hcomm_ij] using hcomm_ij_mem
  have hik_mem :
      hamiltonQuaternionIInHurwitzGroup * hamiltonQuaternionKInHurwitzGroup ∈
        commutator hurwitzQuaternionGroup := by
    -- Transport the explicit commutator value `[ω, i] = ik` into subgroup membership.
    simpa [hcomm_ωi] using hcomm_ωi_mem
  have hji_mem :
      hamiltonQuaternionJInHurwitzGroup * hamiltonQuaternionIInHurwitzGroup ∈
        commutator hurwitzQuaternionGroup := by
    -- Transport the explicit commutator value `[ω, j] = ji` into subgroup membership.
    simpa [hcomm_ωj] using hcomm_ωj_mem
  have hj_mem : hamiltonQuaternionJInHurwitzGroup ∈ commutator hurwitzQuaternionGroup := by
    have hmul :
        (hamiltonQuaternionIInHurwitzGroup * hamiltonQuaternionIInHurwitzGroup) *
            (hamiltonQuaternionIInHurwitzGroup * hamiltonQuaternionKInHurwitzGroup) =
          hamiltonQuaternionJInHurwitzGroup := by
      -- The Hamilton identities collapse `i² * ik` back to `j`.
      apply Subtype.ext
      change (hamiltonQuaternionIUnit * hamiltonQuaternionIUnit) *
          (hamiltonQuaternionIUnit * (hamiltonQuaternionIUnit * hamiltonQuaternionJUnit)) =
        hamiltonQuaternionJUnit
      rw [hamiltonQuaternionIUnit_mul_self, hamiltonQuaternionIUnit_mul_jUnit,
        hamiltonQuaternionIUnit_mul_kUnit]
      simp [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, mul_assoc]
    simpa [hmul] using
      (Subgroup.mul_mem (commutator hurwitzQuaternionGroup) hii_mem hik_mem)
  have hk_mem : hamiltonQuaternionKInHurwitzGroup ∈ commutator hurwitzQuaternionGroup := by
    have hmul :
        (hamiltonQuaternionIInHurwitzGroup * hamiltonQuaternionIInHurwitzGroup) *
            (hamiltonQuaternionJInHurwitzGroup * hamiltonQuaternionIInHurwitzGroup) =
          hamiltonQuaternionKInHurwitzGroup := by
      -- The Hamilton identities collapse `i² * ji` back to `k`.
      apply Subtype.ext
      change (hamiltonQuaternionIUnit * hamiltonQuaternionIUnit) *
          (hamiltonQuaternionJUnit * hamiltonQuaternionIUnit) =
        hamiltonQuaternionIUnit * hamiltonQuaternionJUnit
      rw [hamiltonQuaternionIUnit_mul_self, hamiltonQuaternionJUnit_mul_iUnit,
        hamiltonQuaternionIUnit_mul_jUnit]
      simp [hamiltonQuaternionIUnit, hamiltonQuaternionJUnit, mul_assoc]
    simpa [hmul] using
      (Subgroup.mul_mem (commutator hurwitzQuaternionGroup) hii_mem hji_mem)
  have hjk :
      hamiltonQuaternionJInHurwitzGroup * hamiltonQuaternionKInHurwitzGroup =
        hamiltonQuaternionIInHurwitzGroup := by
    -- This is the Hamilton relation `jk = i`, now read inside the subgroup `G`.
    apply Subtype.ext
    change hamiltonQuaternionJUnit * (hamiltonQuaternionIUnit * hamiltonQuaternionJUnit) =
      hamiltonQuaternionIUnit
    rw [hamiltonQuaternionIUnit_mul_jUnit]
    exact hamiltonQuaternionJUnit_mul_kUnit
  have hi_mem : hamiltonQuaternionIInHurwitzGroup ∈ commutator hurwitzQuaternionGroup := by
    -- Multiply `j` and `k` inside the commutator subgroup and use `jk = i`.
    simpa [hjk] using
      (Subgroup.mul_mem (commutator hurwitzQuaternionGroup) hj_mem hk_mem)
  exact ⟨hi_mem, hj_mem, hk_mem⟩

private theorem hurwitz_quaternion_eight_subgroup_le_commutator :
    hurwitzQuaternionEightSubgroup ≤ commutator hurwitzQuaternionGroup := by
  -- Rewrite `E` as the closure of `i` and `j` inside `G`, then close by generator containment.
  rcases hurwitz_quaternion_basic_units_mem_commutator with ⟨hi_mem, hj_mem, _hk_mem⟩
  rw [hurwitz_quaternion_eight_subgroup_eq_closure_in_group]
  rw [Subgroup.closure_le]
  intro x hx
  simp at hx
  rcases hx with rfl | rfl
  · exact hi_mem
  · exact hj_mem

/-- Helper for Exercise 8-8.5-4: once `E` is killed in the quotient by a normal subgroup `H`,
the cyclic subgroup generated by `ω` still surjects onto `G ⧸ H`. -/
private theorem hurwitz_quaternion_quotient_surjective_from_cube_root
    (H : Subgroup hurwitzQuaternionGroup) [H.Normal]
    (hEH : hurwitzQuaternionEightSubgroup ≤ H) :
    Function.Surjective
      ((QuotientGroup.mk' H).comp
        (Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup).subtype) := by
  let C : Subgroup hurwitzQuaternionGroup := Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup
  letI : hurwitzQuaternionEightSubgroup.Normal := hurwitzQuaternionEightSubgroup_normal
  intro q
  rcases QuotientGroup.mk'_surjective H q with ⟨g, rfl⟩
  have hg : g ∈ C ⊔ hurwitzQuaternionEightSubgroup := by
    -- The complement theorem says every element of `G` factors through `C` and `E`.
    simpa [C, sup_comm, hurwitz_quaternion_eight_sup_cube_root_eq_top]
  rw [Subgroup.mem_sup_of_normal_right] at hg
  rcases hg with ⟨c, hc, e, he, hce⟩
  refine ⟨⟨c, hc⟩, ?_⟩
  -- The `E`-factor dies in `G ⧸ H` because `E ≤ H`.
  rw [← hce, MonoidHom.map_mul]
  change (QuotientGroup.mk' H) c = (QuotientGroup.mk' H) c * (QuotientGroup.mk' H) e
  have he_one : (QuotientGroup.mk' H) e = 1 := Iff.mpr (QuotientGroup.eq_one_iff e) (hEH he)
  rw [he_one, mul_one]

-- Proof sketch: identify `G` with `SL₂(𝔽₃)` or analyze the subgroup lattice directly; in either
-- description there is no subgroup with quotient of order `2`.
/-- Exercise 8-8.5-4 (5): Serre's group `G` has no subgroup of index `2`. -/
theorem hurwitzQuaternionGroup_index_ne_two (H : Subgroup hurwitzQuaternionGroup) :
    H.index ≠ 2 := by
  intro hindex
  letI : H.Normal := Subgroup.normal_of_index_eq_two hindex
  letI : Fact (Nat.Prime 2) := ⟨by decide⟩
  have hcardQ : Nat.card (hurwitzQuaternionGroup ⧸ H) = 2 := by
    simpa [Subgroup.index_eq_card] using hindex
  have hcommQ : IsMulCommutative (hurwitzQuaternionGroup ⧸ H) := by
    -- A group of prime order is cyclic, hence commutative.
    exact (isCyclic_of_prime_card (p := 2) hcardQ).isMulCommutative
  have hcomm_le : commutator hurwitzQuaternionGroup ≤ H :=
    (Subgroup.Normal.quotient_commutative_iff_commutator_le (N := H)).1 hcommQ
  have hEH : hurwitzQuaternionEightSubgroup ≤ H :=
    hurwitz_quaternion_eight_subgroup_le_commutator.trans hcomm_le
  let C : Subgroup hurwitzQuaternionGroup := Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup
  let φ : C →* hurwitzQuaternionGroup ⧸ H :=
    (QuotientGroup.mk' H).comp C.subtype
  have hsurj : Function.Surjective φ :=
    hurwitz_quaternion_quotient_surjective_from_cube_root H hEH
  have hdiv : Nat.card (hurwitzQuaternionGroup ⧸ H) ∣ Nat.card C :=
    Subgroup.card_dvd_of_surjective φ hsurj
  have hdiv' : Nat.card (hurwitzQuaternionGroup ⧸ H) ∣
      Nat.card (Subgroup.zpowers hurwitzQuaternionCubeRootInHurwitzGroup) := by
    simpa [C] using hdiv
  have htwo_dvd_three : 2 ∣ 3 := by
    rw [hcardQ, hurwitz_quaternion_cube_root_subgroup_card] at hdiv'
    exact hdiv'
  norm_num at htwo_dvd_three

-- Proof sketch: if the representation were induced from a one-dimensional `H`-stable subspace of
-- a subgroup `H`, then its degree would equal the index `[G : H]`. Since the representation has
-- degree `2`, this would force `H.index = 2`, contradicting the previous theorem.
/-- Exercise 8-8.5-4 (6): the degree-`2` irreducible representation of `G` obtained from the
quaternion-to-matrix embedding is not monomial, i.e. it is not induced from a one-dimensional
subrepresentation of any subgroup. -/
theorem hurwitzQuaternionMatrixRepresentation_not_isMonomial :
    ¬ hurwitzQuaternionMatrixRepresentation.IsMonomial := by
  -- A monomial witness would force the inducing subgroup to have index `2`, which does not exist.
  rintro ⟨H, W, hW, hInduced⟩
  exact hurwitzQuaternionGroup_index_ne_two H
    (hurwitz_quaternion_monomial_witness_index_eq_two H W hW hInduced)
