import LinearRepresentations_Serre_1977.Serre.Chap14.Infra_14_4_ProjectiveLift.ResidueFieldReductionOwner

noncomputable section

open CategoryTheory
open scoped MonoidAlgebra Representation

universe u

namespace Representation

section

variable {A : Type u} [CommRing A] [IsLocalRing A] [HenselianLocalRing A]
variable {G : Type u} [Group G] [Finite G]

local notation "k" => IsLocalRing.ResidueField A

/-- Infrastructure for Corollary 14-14.4-4: every finite projective `k[G]`-module is the
residue-field reduction of some finite projective `A[G]`-module.

Proof route from Serre, Ch. 14, Sec. 4:
1. Serre uses the Henselian local hypothesis to lift idempotents through reduction modulo the
   maximal ideal.  A finite projective `k[G]`-module is the image of an idempotent matrix over
   `k[G]`.
2. Choose an idempotent presentation of `F` in a finite free `k[G]`-module.  Lift the idempotent
   matrix entrywise to `A[G]`; the Henselian/idempotent-lifting theorem adjusts the lift to an
   actual idempotent over `A[G]`.
3. Take the image of the lifted idempotent.  This image is a finite projective `A[G]`-module `Q`.
4. Reducing `Q` modulo the maximal ideal recovers the original image of the idempotent over
   `k[G]`, hence gives an isomorphism `Q.residueFieldReduction ≅ F`.
5. The current Lean owner for this construction is
   `FiniteProjectiveGroupAlgebraModule.exists_residueFieldReduction_iso`, proved on a tiny support
   layer under `Infra_14_4_ProjectiveLift/ResidueFieldReductionOwner.lean`; this theorem is the
   public, source-facing wrapper around that owner.
-/
theorem exists_projective_lift_of_residueField_projective
    [IsNoetherianRing A] [IsAdicComplete (IsLocalRing.maximalIdeal A) A]
    (F : FiniteProjectiveGroupAlgebraModule k G) :
    ∃ Q : FiniteProjectiveGroupAlgebraModule A G,
      Nonempty (Q.residueFieldReduction ≅ F) := by
  simpa using
    FiniteProjectiveGroupAlgebraModule.exists_residueFieldReduction_iso
      (A := A) (G := G) F

/-- Infrastructure for Corollary 14-14.4-4: a lifted projective module maps to the target
generator class under the reduction homomorphism.

Proof route from Serre, Ch. 14, Sec. 4:
1. First apply `exists_projective_lift_of_residueField_projective` to obtain
   `Q : FiniteProjectiveGroupAlgebraModule A G` with `Q.residueFieldReduction ≅ F`.
2. The reduction homomorphism on projective Grothendieck groups is generated by
   `Q ↦ Q.residueFieldReduction`; in Lean this is
   `projectiveGrothendieckReductionHom_projectiveClass_eq`.
3. Convert the isomorphism `Q.residueFieldReduction ≅ F` into equality of projective
   Grothendieck classes by
   `finiteProjectiveGroupAlgebraGrothendieckClass_eq_of_nonempty_iso`.
4. Chaining these two equalities gives
   `projectiveGrothendieckReductionHom [Q] = [F]`.
5. In the proof of Corollary 14.4.4, this generator-level statement is applied to both positive
   and negative generators after writing an arbitrary element of `P₀[k](G)` as a difference of
   finite projective generator classes. -/
theorem projectiveGrothendieckReductionHom_lifted_projectiveClass_eq
    [IsNoetherianRing A] [IsAdicComplete (IsLocalRing.maximalIdeal A) A]
    (F : FiniteProjectiveGroupAlgebraModule k G) :
    ∃ Q : FiniteProjectiveGroupAlgebraModule A G,
      projectiveGrothendieckReductionHom (A := A) (G := G) [Q]ₚ₀ = [F]ₚ₀ := by
  obtain ⟨Q, hQ⟩ := exists_projective_lift_of_residueField_projective (A := A) (G := G) F
  refine ⟨Q, ?_⟩
  calc
    projectiveGrothendieckReductionHom (A := A) (G := G) [Q]ₚ₀ =
        [Q.residueFieldReduction]ₚ₀ := by
          exact projectiveGrothendieckReductionHom_projectiveClass_eq (A := A) (G := G) Q
    _ = [F]ₚ₀ := by
          exact
            finiteProjectiveGroupAlgebraGrothendieckClass_eq_of_nonempty_iso
              (A := k) (G := G) hQ

end

end Representation
