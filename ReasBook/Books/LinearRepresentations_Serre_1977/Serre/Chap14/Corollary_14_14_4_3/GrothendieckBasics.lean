universe u v w

namespace Representation

section ProjectiveGrothendieckGroup

variable (A : Type u) [CommRing A]
variable (G : Type v) [Group G]

/-- The subgroup of the free abelian group on finite projective `A[G]`-modules generated by the
direct-sum (split short-exact-sequence) relations `[Y] - [X] - [Z]`, where the underlying module of
`Y` is `A[G]`-linearly equivalent to `X × Z`.

This is Serre's actual relation set for `P_A(G)` (§14.4): the relations come from genuine module
short exact sequences of projectives, which always split (the right term is projective), so they
are exactly the direct-sum relations.  The earlier definition used *categorical* short exactness in
the (non-abelian) full subcategory of projectives; over a local ring `A` that is strictly weaker
(a categorical epimorphism such as `p • id` need not be surjective on underlying modules), which
made the residue-field reduction homomorphism ill-defined. -/
def finiteProjectiveGroupAlgebraGrothendieckRelations :
    AddSubgroup (FreeAbelianGroup (FiniteProjectiveGroupAlgebraModule A G)) :=
  AddSubgroup.closure <|
    Set.range fun S :
      { S : ShortComplex (FiniteProjectiveGroupAlgebraModule A G) //
        Nonempty (S.X₂.V ≃ₗ[A[G]] S.X₁.V × S.X₃.V) } ↦
      FreeAbelianGroup.of S.1.X₂ - FreeAbelianGroup.of S.1.X₁ - FreeAbelianGroup.of S.1.X₃

/-- Serre's Grothendieck group `P_A(G)`, realized as the Grothendieck group of the exact category
of finite projective `A[G]`-modules. -/
abbrev finiteProjectiveGroupAlgebraGrothendieckGroup :=
  FreeAbelianGroup (FiniteProjectiveGroupAlgebraModule A G) ⧸
    finiteProjectiveGroupAlgebraGrothendieckRelations A G

local notation:max "P₀[" A "](" G ")" =>
  finiteProjectiveGroupAlgebraGrothendieckGroup A G

variable {A : Type u} [CommRing A]
variable {G : Type v} [Group G]

/-- The class of a finite projective `A[G]`-module in `P_A(G)`. -/
def finiteProjectiveGroupAlgebraGrothendieckClass
    (P : FiniteProjectiveGroupAlgebraModule A G) :
    P₀[A](G) :=
  QuotientAddGroup.mk'
    (finiteProjectiveGroupAlgebraGrothendieckRelations A G)
    (FreeAbelianGroup.of P)

scoped[Representation] notation:max "[" P "]ₚ₀" =>
  finiteProjectiveGroupAlgebraGrothendieckClass P

open scoped Representation

variable {A : Type u} [CommRing A] [IsLocalRing A]
variable {G : Type v} [Group G] [Finite G]

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: in `P₀[A](G)`, a short complex of finite projective
`A[G]`-modules whose middle term splits as the product of the outer terms yields the expected
Grothendieck relation. -/
theorem finiteProjectiveGroupAlgebraGrothendieckClass_middle_eq_left_add_right
    (S : ShortComplex (FiniteProjectiveGroupAlgebraModule A G))
    (hS : Nonempty (S.X₂.V ≃ₗ[A[G]] S.X₁.V × S.X₃.V)) :
    [S.X₂]ₚ₀ = [S.X₁]ₚ₀ + [S.X₃]ₚ₀ := by
  -- The defining generator attached to `S` dies in the quotient Grothendieck group.
  have hzero :
      QuotientAddGroup.mk' (finiteProjectiveGroupAlgebraGrothendieckRelations A G)
        (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) =
        0 := by
    exact (QuotientAddGroup.eq_zero_iff _).2 <|
      AddSubgroup.subset_closure ⟨⟨S, hS⟩, rfl⟩
  refine (sub_eq_zero.mp ?_)
  simpa [finiteProjectiveGroupAlgebraGrothendieckClass, sub_eq_add_neg,
    add_assoc, add_left_comm, add_comm] using hzero

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: a triple of finite projective `A[G]`-modules together with a
linear equivalence `Y.V ≃ X.V × Z.V` yields the Grothendieck relation `[Y] = [X] + [Z]`. -/
theorem finiteProjectiveGroupAlgebraGrothendieckClass_eq_add_of_linearEquiv_prod
    (X Y Z : FiniteProjectiveGroupAlgebraModule A G)
    (e : Y.V ≃ₗ[A[G]] X.V × Z.V) :
    [Y]ₚ₀ = [X]ₚ₀ + [Z]ₚ₀ := by
  -- Package the data as a short complex with zero structure maps and apply the relation lemma.
  let S : ShortComplex (FiniteProjectiveGroupAlgebraModule A G) :=
    ShortComplex.mk (0 : X ⟶ Y) (0 : Y ⟶ Z) (by simp)
  exact finiteProjectiveGroupAlgebraGrothendieckClass_middle_eq_left_add_right S ⟨e⟩

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: the underlying module of the zero finite projective object is a
subsingleton. -/
theorem finiteProjectiveGroupAlgebraModule_zero_V_subsingleton :
    Subsingleton ((0 : FiniteProjectiveGroupAlgebraModule A G).V) := by
  let F : FiniteProjectiveGroupAlgebraModule A G ⥤ ModuleCat A[G] :=
    (ObjectProperty.ι (fun M : FGModuleCat A[G] ↦ Module.Projective A[G] M)) ⋙
      (ModuleCat.isFG A[G]).ι
  have hF0 : IsZero (F.obj 0) := (isZero_zero (ModuleCat A[G])).of_iso F.mapZeroObject
  exact (ModuleCat.isZero_iff_subsingleton (M := F.obj 0)).1 hF0

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: the zero finite projective `A[G]`-module has trivial class in
`P₀[A](G)`. -/
@[simp] theorem finiteProjectiveGroupAlgebraGrothendieckClass_zero :
    [(0 : FiniteProjectiveGroupAlgebraModule A G)]ₚ₀ = 0 := by
  haveI : Subsingleton ((0 : FiniteProjectiveGroupAlgebraModule A G).V) :=
    finiteProjectiveGroupAlgebraModule_zero_V_subsingleton (A := A) (G := G)
  haveI : Subsingleton
      ((0 : FiniteProjectiveGroupAlgebraModule A G).V ×
        (0 : FiniteProjectiveGroupAlgebraModule A G).V) :=
    inferInstance
  have hrelation :=
    finiteProjectiveGroupAlgebraGrothendieckClass_eq_add_of_linearEquiv_prod (A := A) (G := G)
      (0 : FiniteProjectiveGroupAlgebraModule A G) (0 : FiniteProjectiveGroupAlgebraModule A G)
      (0 : FiniteProjectiveGroupAlgebraModule A G)
      (LinearEquiv.ofSubsingleton _ _)
  -- `[0] = [0] + [0]` forces `[0] = 0`.
  have := hrelation
  simpa using this

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: isomorphic finite projective `A[G]`-modules define the same
Grothendieck class. -/
theorem finiteProjectiveGroupAlgebraGrothendieckClass_eq_of_nonempty_iso
    {P Q : FiniteProjectiveGroupAlgebraModule A G} (hPQ : Nonempty (P ≅ Q)) :
    [P]ₚ₀ = [Q]ₚ₀ := by
  rcases hPQ with ⟨e⟩
  -- The forgetful functor turns the iso `e : P ≅ Q` into a module linear equivalence.
  let F : FiniteProjectiveGroupAlgebraModule A G ⥤ ModuleCat A[G] :=
    (ObjectProperty.ι (fun M : FGModuleCat A[G] ↦ Module.Projective A[G] M)) ⋙
      (ModuleCat.isFG A[G]).ι
  let eM : Q.V ≃ₗ[A[G]] P.V := (F.mapIso e).symm.toLinearEquiv
  haveI : Subsingleton ((0 : FiniteProjectiveGroupAlgebraModule A G).V) :=
    finiteProjectiveGroupAlgebraModule_zero_V_subsingleton (A := A) (G := G)
  haveI : Unique ((0 : FiniteProjectiveGroupAlgebraModule A G).V) :=
    uniqueOfSubsingleton 0
  -- `Q.V ≃ P.V ≃ P.V × 0` gives the split relation `[Q] = [P] + [0] = [P]`.
  have hrelation :=
    finiteProjectiveGroupAlgebraGrothendieckClass_eq_add_of_linearEquiv_prod (A := A) (G := G)
      P (Q) (0 : FiniteProjectiveGroupAlgebraModule A G)
      (eM.trans (LinearEquiv.prodUnique (R := A[G]) (M := P.V)
        (M₂ := (0 : FiniteProjectiveGroupAlgebraModule A G).V)).symm)
  rw [finiteProjectiveGroupAlgebraGrothendieckClass_zero (A := A) (G := G), add_zero]
    at hrelation
  exact hrelation.symm

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: an isomorphism in the finite-projective owner category is the
same as an `A[G]`-linear equivalence of the underlying modules. -/
theorem finiteProjectiveGroupAlgebraModule_nonempty_iso_iff_nonempty_linearEquiv
    (P Q : FiniteProjectiveGroupAlgebraModule A G) :
    Nonempty (P ≅ Q) ↔ Nonempty (P.V ≃ₗ[A[G]] Q.V) := by
  constructor
  · intro hPQ
    rcases hPQ with ⟨i⟩
    -- Forget the full-subcategory isomorphism to `FGModuleCat` and then to a linear equivalence.
    let iFG : P.obj ≅ Q.obj :=
      { hom := i.hom.hom
        inv := i.inv.hom
        hom_inv_id := by
          exact ObjectProperty.isoHom_inv_id_hom i
        inv_hom_id := by
          exact ObjectProperty.isoInv_hom_id_hom i }
    exact ⟨FGModuleCat.isoToLinearEquiv iFG⟩
  · intro hPQ
    rcases hPQ with ⟨e⟩
    -- Repackage the module equivalence as an isomorphism in the full subcategory.
    let iFG : P.obj ≅ Q.obj :=
      { hom := ConcreteCategory.ofHom e.toLinearMap
        inv := ConcreteCategory.ofHom e.symm.toLinearMap
        hom_inv_id := by
          ext x
          exact e.left_inv x
        inv_hom_id := by
          ext x
          exact e.right_inv x }
    exact ⟨ObjectProperty.isoMk _ iFG⟩

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: from a linear equivalence `Y.V ≃ₗ X.V × Z.V`, the canonical
short complex on `(X, Y, Z)` whose structure maps are the inclusion and projection transported
along the equivalence.  This is the split (hence short exact) realization of the splitting carried
by a Grothendieck relation generator. -/
def splitShortComplexOfLinearEquivProd
    (X Y Z : FiniteProjectiveGroupAlgebraModule A G)
    (e : Y.V ≃ₗ[A[G]] X.V × Z.V) :
    ShortComplex (FiniteProjectiveGroupAlgebraModule A G) :=
  ShortComplex.mk
    (ObjectProperty.homMk (ConcreteCategory.ofHom
      (e.symm.toLinearMap ∘ₗ LinearMap.inl A[G] X.V Z.V)) : X ⟶ Y)
    (ObjectProperty.homMk (ConcreteCategory.ofHom
      (LinearMap.snd A[G] X.V Z.V ∘ₗ e.toLinearMap)) : Y ⟶ Z)
    (by
      apply ObjectProperty.hom_ext
      apply ObjectProperty.hom_ext
      apply ModuleCat.hom_ext
      ext x
      change (LinearMap.snd A[G] X.V Z.V) (e (e.symm (LinearMap.inl A[G] X.V Z.V x))) = 0
      rw [LinearEquiv.apply_symm_apply]
      simp)

omit [IsLocalRing A] [Finite G] in
@[simp] theorem splitShortComplexOfLinearEquivProd_X₁
    (X Y Z : FiniteProjectiveGroupAlgebraModule A G) (e : Y.V ≃ₗ[A[G]] X.V × Z.V) :
    (splitShortComplexOfLinearEquivProd X Y Z e).X₁ = X := rfl

omit [IsLocalRing A] [Finite G] in
@[simp] theorem splitShortComplexOfLinearEquivProd_X₂
    (X Y Z : FiniteProjectiveGroupAlgebraModule A G) (e : Y.V ≃ₗ[A[G]] X.V × Z.V) :
    (splitShortComplexOfLinearEquivProd X Y Z e).X₂ = Y := rfl

omit [IsLocalRing A] [Finite G] in
@[simp] theorem splitShortComplexOfLinearEquivProd_X₃
    (X Y Z : FiniteProjectiveGroupAlgebraModule A G) (e : Y.V ≃ₗ[A[G]] X.V × Z.V) :
    (splitShortComplexOfLinearEquivProd X Y Z e).X₃ = Z := rfl

omit [IsLocalRing A] [Finite G] in
/-- The canonical split short complex attached to a product splitting is short exact. -/
theorem splitShortComplexOfLinearEquivProd_shortExact
    (X Y Z : FiniteProjectiveGroupAlgebraModule A G)
    (e : Y.V ≃ₗ[A[G]] X.V × Z.V) :
    (splitShortComplexOfLinearEquivProd X Y Z e).ShortExact := by
  refine ShortComplex.Splitting.shortExact
    { r := ObjectProperty.homMk (ConcreteCategory.ofHom
        (LinearMap.fst A[G] X.V Z.V ∘ₗ e.toLinearMap))
      s := ObjectProperty.homMk (ConcreteCategory.ofHom
        (e.symm.toLinearMap ∘ₗ LinearMap.inr A[G] X.V Z.V))
      f_r := ?_
      s_g := ?_
      id := ?_ }
  · apply ObjectProperty.hom_ext
    apply ObjectProperty.hom_ext
    apply ModuleCat.hom_ext
    ext x
    change (LinearMap.fst A[G] X.V Z.V) (e (e.symm (LinearMap.inl A[G] X.V Z.V x))) = x
    rw [LinearEquiv.apply_symm_apply]
    simp
  · apply ObjectProperty.hom_ext
    apply ObjectProperty.hom_ext
    apply ModuleCat.hom_ext
    ext z
    change (LinearMap.snd A[G] X.V Z.V) (e (e.symm (LinearMap.inr A[G] X.V Z.V z))) = z
    rw [LinearEquiv.apply_symm_apply]
    simp
  · apply ObjectProperty.hom_ext
    apply ObjectProperty.hom_ext
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    have hsum : (LinearMap.inl A[G] X.V Z.V (LinearMap.fst A[G] X.V Z.V (e y)) +
        LinearMap.inr A[G] X.V Z.V (LinearMap.snd A[G] X.V Z.V (e y))) = e y := by
      ext <;> simp
    show e.symm (LinearMap.inl A[G] X.V Z.V (LinearMap.fst A[G] X.V Z.V (e y))) +
        e.symm (LinearMap.inr A[G] X.V Z.V (LinearMap.snd A[G] X.V Z.V (e y))) = y
    rw [← map_add, hsum, LinearEquiv.symm_apply_apply]

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: a product splitting `Y.V ≃ₗ X.V × Z.V` of finite projective
`A[G]`-modules realizes the categorical short exact sequence `0 → X → Y → Z → 0`. -/
theorem nonempty_shortExact_of_linearEquiv_prod
    (X Y Z : FiniteProjectiveGroupAlgebraModule A G)
    (e : Y.V ≃ₗ[A[G]] X.V × Z.V) :
    ∃ S : ShortComplex (FiniteProjectiveGroupAlgebraModule A G),
      S.X₁ = X ∧ S.X₂ = Y ∧ S.X₃ = Z ∧ S.ShortExact :=
  ⟨splitShortComplexOfLinearEquivProd X Y Z e, rfl, rfl, rfl,
    splitShortComplexOfLinearEquivProd_shortExact X Y Z e⟩

end ProjectiveGrothendieckGroup

end Representation
