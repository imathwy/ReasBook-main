import Mathlib
import LinearRepresentations_Serre_1977.Serre.RepresentationTheory.RealizableOver
import LinearRepresentations_Serre_1977.Serre.Chap14.Remark_14_14_5_1.FieldIndependence.GeneralBaseChange

/-!
# Absolute irreducibility ascends along any extension of an algebraically closed base — modular case

**Brick 1' (modular).**  Over an algebraically closed field `L` of *arbitrary characteristic*, every
irreducible finite-dimensional representation `ρ` of a finite group `G` stays irreducible after
scalar extension to **any** field extension `E ⊇ L`.  Unlike the characteristic-zero `Brick 1`
(`AbsoluteIrreducibleAscends.lean`), this version uses **no** `CharZero` hypothesis and **no**
Maschke semisimplicity argument.

## Proof route (Jacobson density / Burnside)

The argument produces simplicity *directly*, without ever invoking semisimplicity of the group
algebra (which fails in the modular case):

* **L-Burnside** (`span_range_eq_top_of_isAlgClosed`).  Over the algebraically closed `L`, the
  simple module `S = ρ.asModule` has endomorphism algebra `End_{L[G]}(S) = L` (Schur), so `S` is
  finite over `End_{L[G]}(S)` and the Jacobson density theorem
  (`Module.Finite.toModuleEnd_moduleEnd_surjective`) shows that the image of `L[G]` in `End_L(S)`
  is everything.  Concretely the `L`-span of `{ρ g : g ∈ G}` is the whole endomorphism algebra
  `End_L W`.

* **Descent of the span** (`span_range_scalarExtension_eq_top_of_span_eq_top`).  The `End`
  base-change isomorphism `endBaseChangeEquivGeneral : E ⊗_L End_L W ≅ End_E (E ⊗_L W)` carries the
  base change of `span_L {ρ g}` (which is `⊤` by the previous step) onto `span_E {ρ_E g}`, so the
  span of the scalar-extended representation is again the whole endomorphism algebra.

* **Burnside ⟹ irreducible** (`isIrreducible_of_span_range_eq_top`).  If the `E`-span of the image
  of a representation is the full endomorphism algebra, the representation is irreducible: given
  `x ≠ 0` and any target `y`, a rank-one `E`-endomorphism sends `x ↦ y`, and it lies in the image of
  `E[G]`, so `r • x = y` for some `r ∈ E[G]`; this is exactly simplicity of `asModule` via
  `isSimpleModule_iff_toSpanSingleton_surjective`.
-/

noncomputable section

universe u

open scoped TensorProduct MonoidAlgebra

namespace Representation

section LBurnside

variable {L : Type u} [Field L]
variable {G : Type u} [Group G]
variable {W : Type u} [AddCommGroup W] [Module L W]

/-- Every element of the image of `ρ.asAlgebraHom : L[G] → End_L W` lies in the `L`-span of the
representing endomorphisms `{ρ g : g ∈ G}`.  (The image is the `L`-subalgebra generated by these
endomorphisms.) -/
theorem asAlgebraHom_mem_span (ρ : Representation L G W) (r : MonoidAlgebra L G) :
    ρ.asAlgebraHom r ∈ Submodule.span L (Set.range (fun g => ρ g)) := by
  induction r using MonoidAlgebra.induction_on with
  | hM m => rw [asAlgebraHom_of]; exact Submodule.subset_span ⟨m, rfl⟩
  | hadd x y hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | hsmul c x hx => rw [map_smul]; exact Submodule.smul_mem _ c hx

variable [IsAlgClosed L] [FiniteDimensional L W]

set_option backward.isDefEq.respectTransparency false in
/-- **L-Burnside.**  Over an algebraically closed field `L` (any characteristic), an irreducible
finite-dimensional representation has its image spanning the *entire* endomorphism algebra:
`span_L {ρ g : g ∈ G} = End_L W`.

This is the Jacobson density / Burnside theorem.  Over `L` algebraically closed,
`End_{L[G]}(S) = L` by Schur, so `S = ρ.asModule` is finite over its endomorphism ring, and the
density theorem makes the image of `L[G]` in `End_L(S)` the whole thing. -/
theorem span_range_eq_top_of_isAlgClosed (ρ : Representation L G W) (hρ : ρ.IsIrreducible) :
    Submodule.span L (Set.range (fun g => ρ g)) = (⊤ : Submodule L (Module.End L W)) := by
  -- `S = ρ.asModule` is a simple `L[G]`-module.
  haveI hsimple : IsSimpleModule (MonoidAlgebra L G) ρ.asModule :=
    (irreducible_iff_isSimpleModule_asModule ρ).mp hρ
  -- Schur over the algebraically closed base: `End_{L[G]}(S) ≅ L` via the algebra map.
  have hbij : Function.Bijective (algebraMap L (Module.End (MonoidAlgebra L G) ρ.asModule)) :=
    IsSimpleModule.algebraMap_end_bijective_of_isAlgClosed L
  -- Hence `S` is finite over `End_{L[G]}(S)` (it is finite over `L ≅ End_{L[G]}(S)`).
  haveI : Module.Finite (Module.End (MonoidAlgebra L G) ρ.asModule) ρ.asModule :=
    Module.Finite.of_restrictScalars_finite L (Module.End (MonoidAlgebra L G) ρ.asModule) ρ.asModule
  -- Jacobson density: `L[G] → End_{End_{L[G]}(S)}(S)` is surjective.
  have hsurj := Module.Finite.toModuleEnd_moduleEnd_surjective
    (R := MonoidAlgebra L G) (M := ρ.asModule)
  rw [eq_top_iff]
  intro f _
  set B := Module.End (MonoidAlgebra L G) ρ.asModule with hB
  -- Every `B`-action on `S` is a scalar action of `L` (Schur), since `algebraMap L B` is bijective.
  have hscalar : ∀ (φ : B) (m : ρ.asModule), φ • m = (hbij.2 φ).choose • m := by
    intro φ m
    have hc := (hbij.2 φ).choose_spec
    conv_lhs => rw [← hc]
    rw [Module.End.smul_def, Module.algebraMap_end_apply]
  -- The given `L`-endomorphism `f` is therefore `B`-linear, i.e. an element of `End_B S`.
  let felt : Module.End B ρ.asModule :=
    { toFun := f
      map_add' := f.map_add
      map_smul' := by
        intro φ m
        simp only [RingHom.id_apply]
        rw [hscalar φ m, hscalar φ (f m), map_smul] }
  -- Density produces `r ∈ L[G]` acting as `f`.
  obtain ⟨r, hr⟩ := hsurj felt
  have hrm : ∀ m : ρ.asModule, r • m = f m := by
    intro m
    have := congrArg (fun (e : Module.End B ρ.asModule) => e m) hr
    simpa [Module.toModuleEnd, felt] using this
  -- So `f = ρ.asAlgebraHom r`, which lies in the span.
  have hfeq : f = ρ.asAlgebraHom r := by
    ext m; rw [← hrm m]; rfl
  rw [hfeq]
  exact asAlgebraHom_mem_span ρ r

end LBurnside

section Descent

variable {L : Type u} [Field L] {E : Type u} [Field E] [Algebra L E]
variable {G : Type u} [Group G]
variable {W : Type u} [AddCommGroup W] [Module L W] [FiniteDimensional L W]

/-- **Descent of the Burnside span.**  If the `L`-span of `{ρ g}` is the whole endomorphism algebra
`End_L W`, then the `E`-span of `{ρ_E g}` is the whole endomorphism algebra `End_E (E ⊗_L W)` of the
scalar extension.

The `End` base-change isomorphism `endBaseChangeEquivGeneral` carries `(span_L {ρ g}).baseChange E`
onto `span_E {ρ_E g}`, and base change of `⊤` is `⊤`. -/
theorem span_range_scalarExtension_eq_top_of_span_eq_top
    (ρ : Representation L G W)
    (h : Submodule.span L (Set.range (fun g => ρ g)) = (⊤ : Submodule L (Module.End L W))) :
    Submodule.span E (Set.range (fun g => (scalarExtension (k := E) ρ) g))
      = (⊤ : Submodule E (Module.End E (E ⊗[L] W))) := by
  -- `ρ_E g = endBaseChangeEquivGeneral (1 ⊗ ρ g)`.
  have key : ∀ g : G, (scalarExtension (k := E) ρ) g
      = endBaseChangeEquivGeneral (k₀ := L) (W := W) (K := E)
          (TensorProduct.mk L E (Module.End L W) 1 (ρ g)) := by
    intro g
    rw [TensorProduct.mk_apply, endBaseChangeEquivGeneral_tmul, one_smul]; rfl
  -- The image of `{ρ g}` under `1 ⊗ ·` then `endBaseChangeEquivGeneral` is the image of `{ρ_E g}`.
  have hrange : (Set.range (fun g => (scalarExtension (k := E) ρ) g))
      = (endBaseChangeEquivGeneral (k₀ := L) (W := W) (K := E)).toLinearMap ''
          ((TensorProduct.mk L E (Module.End L W) 1) '' (Set.range (fun g => ρ g))) := by
    rw [← Set.image_comp]
    ext x
    simp only [Set.mem_range, Set.mem_image, Function.comp_apply]
    constructor
    · rintro ⟨g, rfl⟩; exact ⟨ρ g, ⟨g, rfl⟩, (key g).symm⟩
    · rintro ⟨_, ⟨g, rfl⟩, rfl⟩; exact ⟨g, key g⟩
  rw [hrange, ← Submodule.map_span, ← Submodule.baseChange_span, h, Submodule.baseChange_top,
    Submodule.map_top]
  rw [LinearEquiv.range (endBaseChangeEquivGeneral (k₀ := L) (W := W) (K := E))]

end Descent

section BurnsideIrreducible

variable {E : Type u} [Field E]
variable {G : Type u} [Group G]
variable {V' : Type u} [AddCommGroup V'] [Module E V'] [FiniteDimensional E V']

set_option backward.isDefEq.respectTransparency false in
/-- **Burnside ⟹ irreducible.**  A finite-dimensional, nontrivial `E`-representation whose image
spans the entire endomorphism algebra `End_E V'` is irreducible.  No algebraic closedness is needed
here; this is the converse half of the Burnside characterisation, used to conclude irreducibility of
the scalar extension. -/
theorem isIrreducible_of_span_range_eq_top (σ : Representation E G V')
    [Nontrivial V'] (h : Submodule.span E (Set.range (fun g => σ g)) = ⊤) :
    σ.IsIrreducible := by
  haveI hntM : Nontrivial σ.asModule := σ.asModuleEquiv.toEquiv.nontrivial
  rw [irreducible_iff_isSimpleModule_asModule]
  rw [isSimpleModule_iff_toSpanSingleton_surjective]
  refine ⟨hntM, fun x hx y => ?_⟩
  -- Pick an `E`-functional `g` with `g x ≠ 0`.
  have hxV : (σ.asModuleEquiv x) ≠ 0 := by
    rwa [Ne, map_eq_zero_iff _ σ.asModuleEquiv.injective]
  have hxnotmem : (σ.asModuleEquiv x) ∉ (⊥ : Submodule E V') := by
    simp only [Submodule.mem_bot]; exact hxV
  obtain ⟨g, hgx, -⟩ := Submodule.exists_le_ker_of_notMem hxnotmem
  -- The rank-one endomorphism `v ↦ g(v) • ((g x)⁻¹ • y)` sends `x ↦ y`.
  set φ : Module.End E V' :=
    (LinearMap.toSpanSingleton E V' ((g (σ.asModuleEquiv x))⁻¹ • (σ.asModuleEquiv y))).comp g
    with hφ
  have hφx : φ (σ.asModuleEquiv x) = σ.asModuleEquiv y := by
    rw [hφ, LinearMap.comp_apply, LinearMap.toSpanSingleton_apply, smul_smul,
      mul_inv_cancel₀ hgx, one_smul]
  -- The full span lies in the image of `E[G]`, so `φ = σ.asAlgebraHom r`.
  have hsub : Submodule.span E (Set.range (fun g => σ g))
      ≤ LinearMap.range σ.asAlgebraHom.toLinearMap := by
    rw [Submodule.span_le]
    rintro _ ⟨g, rfl⟩
    exact ⟨MonoidAlgebra.of E G g, by simp⟩
  have hmem : φ ∈ LinearMap.range σ.asAlgebraHom.toLinearMap := hsub (h ▸ Submodule.mem_top)
  obtain ⟨r, hr⟩ := hmem
  refine ⟨r, ?_⟩
  rw [LinearMap.toSpanSingleton_apply]
  apply σ.asModuleEquiv.injective
  rw [asModuleEquiv_map_smul]
  change σ.asAlgebraHom r (σ.asModuleEquiv x) = _
  rw [show σ.asAlgebraHom r = φ from hr, hφx]

end BurnsideIrreducible

section Main

variable {L : Type u} [Field L] [IsAlgClosed L] {E : Type u} [Field E] [Algebra L E]
variable {G : Type u} [Group G] [Finite G]
variable {W : Type u} [AddCommGroup W] [Module L W] [FiniteDimensional L W]

set_option backward.isDefEq.respectTransparency false in
/-- **Brick 1' (modular) — absolute irreducibility ascends in any characteristic.**  If `L` is an
algebraically closed field (of *arbitrary* characteristic) and `ρ` is an irreducible
finite-dimensional `L`-representation of a finite group `G`, then its scalar extension to **any**
field extension `E ⊇ L` is again irreducible.

The proof is the Jacobson density / Burnside route: over the algebraically closed `L` the image of
`ρ` spans the whole endomorphism algebra (`span_range_eq_top_of_isAlgClosed`); this descends to `E`
(`span_range_scalarExtension_eq_top_of_span_eq_top`); and a representation spanning the whole
endomorphism algebra is irreducible (`isIrreducible_of_span_range_eq_top`).  No `CharZero` and no
Maschke semisimplicity are used. -/
theorem isIrreducible_scalarExtension_of_isAlgClosed_base_of_isAlgClosed
    (ρ : Representation L G W) (hρ : ρ.IsIrreducible) :
    (Representation.scalarExtension (k := E) ρ).IsIrreducible := by
  -- `W` is nontrivial (an irreducible representation has nonzero underlying space), and so is the
  -- extension `E ⊗_L W`.
  haveI hsimple : IsSimpleModule (MonoidAlgebra L G) ρ.asModule :=
    (irreducible_iff_isSimpleModule_asModule ρ).mp hρ
  haveI hntW : Nontrivial W := IsSimpleModule.nontrivial (MonoidAlgebra L G) ρ.asModule
  haveI hntEW : Nontrivial (E ⊗[L] W) := by
    obtain ⟨w, hw⟩ := exists_ne (0 : W)
    exact TensorProduct.nontrivial_of_linearMap_injective_of_flat_left L E W
      (LinearMap.toSpanSingleton L W w)
      (LinearMap.ker_eq_bot.mp (LinearMap.ker_toSpanSingleton L hw))
  -- L-Burnside.
  have hspanL : Submodule.span L (Set.range (fun g => ρ g))
      = (⊤ : Submodule L (Module.End L W)) :=
    span_range_eq_top_of_isAlgClosed ρ hρ
  -- Descend the span to `E`.
  have hspanE : Submodule.span E (Set.range (fun g => (scalarExtension (k := E) ρ) g))
      = (⊤ : Submodule E (Module.End E (E ⊗[L] W))) :=
    span_range_scalarExtension_eq_top_of_span_eq_top ρ hspanL
  -- Burnside ⟹ irreducible.
  exact isIrreducible_of_span_range_eq_top (scalarExtension (k := E) ρ) hspanE

end Main

end Representation
