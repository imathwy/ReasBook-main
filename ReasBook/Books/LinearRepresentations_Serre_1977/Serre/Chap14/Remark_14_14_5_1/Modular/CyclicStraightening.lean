import Mathlib
import LinearRepresentations_Serre_1977.Serre.Chap14.Remark_14_14_5_1.Modular.SemilinearGaloisDescent

/-!
# Cyclic-Frobenius straightening (Speiser / Hilbert 90 for cyclic groups)

This module builds the genuine semilinear Galois action that underlies the characteristic-`p`
modular splitting argument of Remark 14-14.5-1.

## Setup

Let `L / k` be a **finite Galois** extension over a *finite* base field `k`, whose Galois group
`Γ = L ≃ₐ[k] L` is **cyclic**, generated by an automorphism `φ`.  Let `M` be a finite-dimensional
`L`-vector space and `f : M ≃+ M` a `φ`-**semilinear** additive automorphism whose `[L:k]`-th power
is a (nonzero) scalar `lam ∈ k`:

* `f (c • v) = φ c • f v` for all `c : L`, `v : M`  (`φ`-semilinearity);
* `f ^ [L:k] = lam • id` with `lam ≠ 0`.

## Main result

* `Representation.exists_semilinearGaloisAction_of_generator` — there is a genuine
  `SemilinearGaloisAction k L M` whose value on the generator `φ` is `v ↦ c • f v`, where the scalar
  `c : Lˣ` is chosen (via finite-field norm surjectivity) so that the rescaled operator `g = c • f`
  satisfies `g ^ [L:k] = id`.

## Proof strategy

Because `k` is finite, the norm `N_{L/k} : L → k` is surjective (`FiniteField.norm_surjective`),
so we may pick `c ∈ Lˣ` with `N_{L/k}(c) = lam⁻¹`.  Set `g v = c • f v`.  An induction shows

  `g ^ j v = (∏_{i < j} φ^i c) • f ^ j v`,

and at `j = [L:k]` the product `∏_{i < [L:k]} φ^i c` runs over all of `Γ` (since `φ` generates and
`orderOf φ = [L:k]`), hence equals `∏_{σ ∈ Γ} σ c = N_{L/k}(c) = lam⁻¹`
(`Algebra.norm_eq_prod_automorphisms`).  Therefore

  `g ^ [L:k] v = lam⁻¹ • (lam • v) = v`,  i.e. `g ^ [L:k] = 1`.

Since `orderOf g ∣ orderOf φ`, the cyclic-generator universal map
`monoidHomOfForallMemZpowers` yields a monoid hom `Γ →* AddAut M` sending `φ ↦ g`; each `g ^ j` is
`φ^j`-semilinear, so the resulting action is genuinely semilinear.
-/

noncomputable section

universe u v

open Module

namespace Representation

/-- **Cyclic-Frobenius straightening.**  If the Galois group `L ≃ₐ[k] L` of a finite Galois
extension of a *finite* field is cyclic with generator `φ`, and `f : M ≃+ M` is a `φ`-semilinear
automorphism of a finite-dimensional `L`-space whose `[L:k]`-th power is the scalar `lam ≠ 0`, then
`f` can be rescaled by a unit `c : Lˣ` to a generator `v ↦ c • f v` of a genuine
`SemilinearGaloisAction k L M`. -/
theorem exists_semilinearGaloisAction_of_generator
    {k : Type u} [Field k] [Finite k] {L : Type u} [Field L] [Algebra k L]
    [FiniteDimensional k L] [IsGalois k L]
    {M : Type v} [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    (φ : L ≃ₐ[k] L) (hφ : ∀ σ : L ≃ₐ[k] L, σ ∈ Subgroup.zpowers φ)
    (f : M ≃+ M)
    (hsl : ∀ (c : L) (v : M), f (c • v) = φ c • f v)
    (lam : k) (hlam : lam ≠ 0)
    (hpow : ∀ v : M, (f ^ (Module.finrank k L)) v = (algebraMap k L lam) • v) :
    ∃ (A : SemilinearGaloisAction k L M) (c : Lˣ),
      (A.act φ : M → M) = fun v => (c : L) • f v := by
  classical
  haveI : Finite L := Module.finite_of_finite k
  set n := Module.finrank k L with hn
  -- choose the rescaling scalar via norm surjectivity over the finite field `k`
  obtain ⟨c0, hnorm⟩ := FiniteField.norm_surjective k L lam⁻¹
  have hc0ne : c0 ≠ 0 :=
    Algebra.norm_ne_zero_iff.mp (by rw [hnorm]; exact inv_ne_zero hlam)
  -- the rescaled operator `g v = c0 • f v` as an additive automorphism
  let gAut : M ≃+ M :=
    { toFun := fun v => c0 • f v
      invFun := fun v => f.symm (c0⁻¹ • v)
      left_inv := fun v => by
        dsimp only
        rw [smul_smul, inv_mul_cancel₀ hc0ne, one_smul, f.symm_apply_apply]
      right_inv := fun v => by
        dsimp only
        rw [f.apply_symm_apply, smul_smul, mul_inv_cancel₀ hc0ne, one_smul]
      map_add' := fun x y => by rw [map_add, smul_add] }
  have hgAut : ∀ y : M, gAut y = c0 • f y := fun _ => rfl
  -- the order of `φ` equals `[L:k]`
  have horder : orderOf φ = n :=
    (orderOf_eq_card_of_forall_mem_zpowers hφ).trans
      ((IsGalois.card_aut_eq_finrank k L).trans hn.symm)
  -- recursion for powers of `g` and `f`
  have hgpow_succ : ∀ (j : ℕ) (x : M), (gAut ^ (j + 1)) x = c0 • f ((gAut ^ j) x) := by
    intro j x
    rw [pow_succ']
    exact hgAut _
  have hfpow_succ : ∀ (j : ℕ) (x : M), (f ^ (j + 1)) x = f ((f ^ j) x) := by
    intro j x
    rw [pow_succ', AddAut.mul_apply]
  -- `g ^ j` is `φ ^ j`-semilinear
  have semilin_pow : ∀ (j : ℕ) (c : L) (v : M),
      (gAut ^ j) (c • v) = (φ ^ j) c • (gAut ^ j) v := by
    intro j
    induction j with
    | zero => intro c v; simp
    | succ j ih =>
      intro c v
      rw [hgpow_succ j (c • v), ih c v, hsl, hgpow_succ j v, smul_smul, smul_smul]
      congr 1
      rw [pow_succ', AlgEquiv.mul_apply, mul_comm c0]
  -- explicit form of `g ^ j v`
  have hprod_succ : ∀ j : ℕ, ∏ i ∈ Finset.range (j + 1), (φ ^ i) c0
      = c0 * φ (∏ i ∈ Finset.range j, (φ ^ i) c0) := by
    intro j
    have e1 : φ (∏ i ∈ Finset.range j, (φ ^ i) c0)
        = ∏ i ∈ Finset.range j, (φ ^ (i + 1)) c0 := by
      rw [map_prod]
      refine Finset.prod_congr rfl (fun i _ => ?_)
      rw [pow_succ', AlgEquiv.mul_apply]
    rw [e1, Finset.prod_range_succ', pow_zero, AlgEquiv.one_apply, mul_comm _ c0]
  have expand_pow : ∀ (j : ℕ) (v : M),
      (gAut ^ j) v = (∏ i ∈ Finset.range j, (φ ^ i) c0) • (f ^ j) v := by
    intro j
    induction j with
    | zero => intro v; simp
    | succ j ih =>
      intro v
      rw [hgpow_succ j v, ih v, hsl, ← hfpow_succ j v, hprod_succ j, smul_smul]
  -- the product `∏_{i < n} φ^i c0` runs over all of `Γ`
  have key_prod : ∏ i ∈ Finset.range n, (φ ^ i) c0 = ∏ σ : L ≃ₐ[k] L, σ c0 := by
    refine Finset.prod_bij (fun i _ => φ ^ i) (fun _ _ => Finset.mem_univ _) ?_ ?_ ?_
    · intro a ha b hb hab
      have ha' : a ∈ Set.Iio (orderOf φ) := by
        rw [Set.mem_Iio, horder]; exact Finset.mem_range.mp ha
      have hb' : b ∈ Set.Iio (orderOf φ) := by
        rw [Set.mem_Iio, horder]; exact Finset.mem_range.mp hb
      exact pow_injOn_Iio_orderOf ha' hb' hab
    · intro σ _
      have hmem : σ ∈ Submonoid.powers φ :=
        (isOfFinOrder_of_finite φ).mem_powers_iff_mem_zpowers.mpr (hφ σ)
      have himg : σ ∈ (Finset.range (orderOf φ)).image (φ ^ ·) :=
        (isOfFinOrder_of_finite φ).mem_powers_iff_mem_range_orderOf.mp hmem
      obtain ⟨i, hi_mem, hi⟩ := Finset.mem_image.mp himg
      refine ⟨i, ?_, hi⟩
      rw [Finset.mem_range, ← horder]
      exact Finset.mem_range.mp hi_mem
    · intro a _; rfl
  -- the rescaled operator has trivial `[L:k]`-th power
  have gpow_n : gAut ^ n = 1 := by
    refine AddEquiv.ext (fun v => ?_)
    rw [AddAut.one_apply, expand_pow n v, hpow v, key_prod,
      ← Algebra.norm_eq_prod_automorphisms, hnorm, smul_smul, ← map_mul,
      inv_mul_cancel₀ hlam, map_one, one_smul]
  have hord : orderOf gAut ∣ orderOf φ := by
    rw [horder]; exact orderOf_dvd_of_pow_eq_one gpow_n
  -- the universal map from the cyclic generator
  let myHom : (L ≃ₐ[k] L) →* AddAut M := monoidHomOfForallMemZpowers hφ hord
  have hgen : myHom φ = gAut := monoidHomOfForallMemZpowers_apply_gen hφ hord
  -- every `σ` is a *natural* power of `φ`, giving semilinearity of `myHom σ`
  have hsemi : ∀ (σ : L ≃ₐ[k] L) (c : L) (m : M), myHom σ (c • m) = σ c • myHom σ m := by
    intro σ c m
    obtain ⟨i, hi⟩ : ∃ i : ℕ, φ ^ i = σ :=
      (Submonoid.mem_powers_iff σ φ).mp
        ((isOfFinOrder_of_finite φ).mem_powers_iff_mem_zpowers.mpr (hφ σ))
    have hmh : myHom σ = gAut ^ i := by
      rw [← hi, map_pow, hgen]
    rw [hmh, ← hi]
    exact semilin_pow i c m
  refine ⟨{ act := fun σ => myHom σ
            map_smul' := hsemi
            act_one' := by rw [map_one]; rfl
            act_mul' := fun σ τ m => by rw [map_mul]; rfl },
    Units.mk0 c0 hc0ne, ?_⟩
  funext v
  simp only [Units.val_mk0]
  rw [hgen]
  exact hgAut v

end Representation
