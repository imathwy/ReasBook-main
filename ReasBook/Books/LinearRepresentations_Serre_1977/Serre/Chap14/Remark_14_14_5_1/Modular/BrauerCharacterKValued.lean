import Mathlib
import LinearRepresentations_Serre_1977.Serre.Chap18.Definition_18_18_1_1
import LinearRepresentations_Serre_1977.Serre.Chap18.Theorem_18_18_2_1.RegularConjClassCore

/-!
# `k`-valuedness of the modular Brauer character under the splitting hypothesis (Brick 1)

This module is **Brick 1** of the characteristic-`p` modular splitting case of Remark 14-14.5-1.
It proves that, under the splitting hypothesis on `k`, the modular (Brauer) character of any
finite-dimensional `k̄[G]`-representation — evaluated through the **canonical inclusion lift**
`(primeToPRoots p k̄).subtype` — takes values in the image of the coefficient embedding
`algebraMap k k̄`, where `k̄ = AlgebraicClosure k`.

## Mathematical content

Fix a field `k` of characteristic `p`, a finite group `G`, and the splitting hypothesis

> `hsplit : ∀ d, d ∣ Monoid.exponent G → (d : k) ≠ 0 → HasEnoughRootsOfUnity k d`

(`HasEnoughRootsOfUnity k d` says `k` already contains a primitive `d`-th root of unity and the
`d`-th roots of unity in `k` form a cyclic group — i.e. `k` "splits" the `d`-th roots).

The modular character of a representation `ρ : Representation k̄ G V` at a `p`-regular element `s`
is, by Definition 18-18.1-1, the sum of *chosen lifts* of the prime-to-`p` roots of unity below the
eigenvalues (characteristic-polynomial roots) of `ρ s`.  For the canonical inclusion lift the chosen
lift of a prime-to-`p` root **is** that root, so the character value is literally the sum of the
eigenvalues of `ρ s`.

Each such eigenvalue `μ` is an `orderOf s`-th root of unity (`charpolyRoot_rootsOfUnity_orderOf`).
For `p`-regular `s` the order `d := orderOf s` is prime to `p`, hence `(d : k) ≠ 0`, and `d` divides
the exponent of `G`; so `hsplit` supplies a primitive `d`-th root of unity `ζ ∈ k`.  Its image
`algebraMap k k̄ ζ` is a primitive `d`-th root of unity in `k̄` (injective transport), so the full
`d`-element group of `d`-th roots of unity of `k̄` is generated by it and lies in the image
of `k`.  In particular `μ`, a `d`-th root of unity, is `algebraMap k k̄ (ζ ^ i)` for some `i`, hence
in the range.  A finite sum of elements of `Set.range (algebraMap k k̄)` (a subalgebra) is again in
the range, giving the claim.

## Output

The headline `modularCharacterOnPRegularConjClass_mem_algebraMap_range` is exactly the `hT`
hypothesis consumed by `descend_simple_of_modularCharacter_kValued`
(`Serre/Chap14/Remark_14_14_5_1/Modular/GaloisDescent.lean`), instantiated with the canonical
inclusion lift `(primeToPRoots p (AlgebraicClosure k)).subtype`.
-/

noncomputable section

universe u

open scoped Representation

namespace Representation

variable {k : Type u} [Field k]
variable {p : ℕ} [hp : Fact p.Prime] [hk : CharP k p]
variable {G : Type u} [Group G] [Finite G]

local notation3 "k̄" => AlgebraicClosure k

/-- Characteristic `p` ascends from `k` to its algebraic closure along the (injective) coefficient
embedding. -/
instance instCharPAlgebraicClosure : CharP (AlgebraicClosure k) p :=
  charP_of_injective_algebraMap (algebraMap k (AlgebraicClosure k)).injective p

/-- The splitting hypothesis for `k`: for every prime-to-`p` divisor `d` of the exponent of `G`
(equivalently `(d : k) ≠ 0`), the field `k` already has enough `d`-th roots of unity.  This is the
explicit "`k` splits the prime-to-`p` roots of unity of `G`" condition. -/
abbrev SplitsPrimeToPRootsOfUnity (k : Type u) [Field k] (G : Type u) [Group G] : Prop :=
  ∀ d : ℕ, d ∣ Monoid.exponent G → (d : k) ≠ 0 → HasEnoughRootsOfUnity k d

section RootMembership

omit hp hk [Finite G] in
/-- **Key root-membership lemma.** Under the splitting hypothesis, any `d`-th root of unity `μ` of
`k̄` whose exponent `d` is a prime-to-`p` divisor of the exponent of `G` lies in the image of
`algebraMap k k̄`.

The primitive `d`-th root of unity supplied by `HasEnoughRootsOfUnity k d` maps to a primitive
`d`-th root of unity of `k̄`; every `d`-th root of unity of `k̄` is then a power of it, hence in the
image of `k`. -/
theorem dthRootOfUnity_mem_algebraMap_range (hsplit : SplitsPrimeToPRootsOfUnity k G)
    {d : ℕ} (hd_exp : d ∣ Monoid.exponent G) (hd_ne : (d : k) ≠ 0)
    {μ : k̄} (hμ : μ ^ d = 1) :
    μ ∈ Set.range (algebraMap k (AlgebraicClosure k)) := by
  -- `d ≠ 0` because its image in `k` is nonzero.
  have hd0 : d ≠ 0 := by
    rintro rfl
    simp at hd_ne
  haveI : NeZero d := ⟨hd0⟩
  -- `k` already has a primitive `d`-th root of unity.
  haveI hsplit_d : HasEnoughRootsOfUnity k d := hsplit d hd_exp hd_ne
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot k d
  -- Transport it to `k̄` along the injective coefficient embedding.
  have hζ' : IsPrimitiveRoot (algebraMap k (AlgebraicClosure k) ζ) d :=
    hζ.map_of_injective (algebraMap k (AlgebraicClosure k)).injective
  -- Every `d`-th root of unity of `k̄` is a power of the primitive root.
  obtain ⟨i, -, hi⟩ := hζ'.eq_pow_of_pow_eq_one hμ
  refine ⟨ζ ^ i, ?_⟩
  rw [map_pow, hi]

end RootMembership

section CharacterValue

omit hp hk [Finite G] in
/-- The order of a `p`-regular element divides the exponent of `G`. -/
private theorem orderOf_dvd_exponent_of_pRegular {s : G} : orderOf s ∣ Monoid.exponent G :=
  Monoid.order_dvd_exponent s

omit [Finite G] in
/-- The order of a `p`-regular element is nonzero in `k` (it is prime to `p = char k`). -/
private theorem orderOf_natCast_ne_zero_of_pRegular {s : G} (hs : IsPRegular p s) :
    (orderOf s : k) ≠ 0 := by
  intro hcast
  -- `(orderOf s : k) = 0` means `p ∣ orderOf s`, contradicting `p`-regularity.
  rw [CharP.cast_eq_zero_iff k p] at hcast
  exact (isPRegular_iff_not_dvd_orderOf (p := p) s).mp hs hcast

omit [Finite G] in
/-- For `p`-regular `s`, each root of the characteristic polynomial of `ρ s` is an `orderOf s`-th
root of unity, with `orderOf s` a prime-to-`p` divisor of the exponent of `G`; hence by the
splitting hypothesis it lies in the image of `algebraMap k k̄`. -/
theorem charpolyRoot_mem_algebraMap_range (hsplit : SplitsPrimeToPRootsOfUnity k G)
    {V : Type u} [AddCommGroup V] [Module (AlgebraicClosure k) V]
    [Module.Finite (AlgebraicClosure k) V]
    (ρ : Representation (AlgebraicClosure k) G V) {s : G} (hs : IsPRegular p s)
    {μ : AlgebraicClosure k} (hμ : μ ∈ (ρ s).charpoly.roots) :
    μ ∈ Set.range (algebraMap k (AlgebraicClosure k)) := by
  -- `μ` is an `orderOf s`-th root of unity.
  have hpow : μ ^ orderOf s = 1 := by
    have hmem := (charpolyRoot_rootsOfUnity_orderOf ρ s hμ).prop
    rw [mem_rootsOfUnity'] at hmem
    have hcoe := charpolyRoot_rootsOfUnity_orderOf_coe ρ s hμ
    rw [hcoe] at hmem
    exact hmem
  exact dthRootOfUnity_mem_algebraMap_range hsplit
    (orderOf_dvd_exponent_of_pRegular (s := s))
    (orderOf_natCast_ne_zero_of_pRegular hs) hpow

end CharacterValue

section ModularCharacter

/-- The canonical inclusion lift of prime-to-`p` roots of unity of `k̄` into `k̄ˣ`: the subgroup
inclusion `(primeToPRoots p k̄).subtype`.  This is the lift for which the chosen lift of a
prime-to-`p` root of unity is the root itself, so the modular character becomes literally the sum of
eigenvalues. -/
abbrev canonicalLift : PrimeToPRoot p (AlgebraicClosure k) →* (AlgebraicClosure k)ˣ :=
  (primeToPRoots p (AlgebraicClosure k)).subtype

omit hp hk [Finite G] in
theorem canonicalLift_injective : Function.Injective (canonicalLift (k := k) (p := p)) :=
  Subgroup.subtype_injective _

omit hp hk [Finite G] in
/-- The field value of the canonical inclusion lift on a prime-to-`p` root of unity is the root
itself. -/
@[simp] theorem toFieldLift_canonicalLift_apply (ζ : PrimeToPRoot p (AlgebraicClosure k)) :
    PrimeToPRoot.toFieldLift (canonicalLift (k := k) (p := p)) ζ = (ζ : AlgebraicClosure k) := rfl

omit [Finite G] in
/-- **Modular character is `k`-valued (representation level).** Under the splitting hypothesis, the
modular Brauer character of `ρ` at a `p`-regular element `s`, computed through the canonical
inclusion lift, lies in the image of `algebraMap k k̄`.

The character value is the sum of the chosen lifts of the prime-to-`p` roots underlying the
characteristic-polynomial roots of `ρ s`; for the inclusion lift these lifts are the roots
themselves, each of which is in the range by `charpolyRoot_mem_algebraMap_range`, and the range is a
subalgebra closed under finite sums. -/
theorem modularCharacter_mem_algebraMap_range (hsplit : SplitsPrimeToPRootsOfUnity k G)
    {V : Type u} [AddCommGroup V] [Module (AlgebraicClosure k) V]
    [Module.Finite (AlgebraicClosure k) V]
    (ρ : Representation (AlgebraicClosure k) G V) (s : { t : G // IsPRegular p t }) :
    φ[PrimeToPRoot.toFieldLift (canonicalLift (k := k) (p := p))](ρ) s
      ∈ Set.range (algebraMap k (AlgebraicClosure k)) := by
  -- The range of `algebraMap k k̄` is (the carrier of) a subalgebra, closed under sums.
  have hset :
      Set.range (algebraMap k (AlgebraicClosure k))
        = ((Algebra.ofId k (AlgebraicClosure k)).range : Set (AlgebraicClosure k)) := by
    ext x
    simp only [AlgHom.mem_range, Set.mem_range, Algebra.ofId_apply, SetLike.mem_coe]
  rw [hset]
  -- Unfold the modular character as a multiset sum of lifted prime-to-`p` roots.
  change ((((ρ s.1).charpoly.roots.attach).map fun μ ↦
      (PrimeToPRoot.toFieldLift (canonicalLift (k := k) (p := p)) ∘
        (((↑) : PrimeToPRoot _ _ → _)))
        (charpolyRoot_primeToPRoot (p := p) ρ s.2 μ.2)).sum) ∈ _
  apply Subalgebra.multiset_sum_mem
  intro x hx
  -- `x` is the lift of the prime-to-`p` owner of some charpoly root `μ`; the lift value is `μ`.
  simp only [Multiset.mem_map] at hx
  obtain ⟨μ, -, rfl⟩ := hx
  rw [AlgHom.mem_range]
  have hval :
      (PrimeToPRoot.toFieldLift (canonicalLift (k := k) (p := p)) ∘
          (((↑) : PrimeToPRoot _ _ → _)))
        (charpolyRoot_primeToPRoot (p := p) ρ s.2 μ.2)
        = (μ.1 : AlgebraicClosure k) := by
    simp only [Function.comp_apply]
    exact charpolyRoot_primeToPRoot_coe ρ s.2 μ.2
  rw [hval]
  obtain ⟨y, hy⟩ :=
    charpolyRoot_mem_algebraMap_range hsplit ρ s.2 μ.2
  exact ⟨y, by rw [Algebra.ofId_apply]; exact hy⟩

end ModularCharacter

section Headline

open CategoryTheory

/-- **Brick 1 (headline): the modular Brauer character is `k`-valued.**

Under the splitting hypothesis `hsplit`, for every finite-dimensional `k̄[G]`-representation `T` and
every `p`-regular conjugacy class `c`, the descended modular Brauer character of `T` — evaluated
through the canonical inclusion lift `(primeToPRoots p k̄).subtype` — lies in the image of the
coefficient embedding `algebraMap k k̄`.

This is exactly the `hT` hypothesis consumed by the Galois-descent summit
`descend_simple_of_modularCharacter_kValued`, instantiated with the canonical lift. -/
theorem modularCharacterOnPRegularConjClass_mem_algebraMap_range
    (hsplit : SplitsPrimeToPRootsOfUnity k G)
    (T : FDRep (AlgebraicClosure k) G) (c : PRegularConjClass G p) :
    FDRep.modularCharacterOnPRegularConjClass (p := p) T
        (PrimeToPRoot.toFieldLift (canonicalLift (k := k) (p := p))) c
      ∈ Set.range (algebraMap k (AlgebraicClosure k)) := by
  -- Reduce to a chosen representative `s` of the conjugacy class.
  rcases c with ⟨c, hc⟩
  obtain ⟨s, rfl⟩ := ConjClasses.mk_surjective c
  have hs : IsPRegular p s := hc s <| by
    simp [ConjClasses.mem_carrier_iff_mk_eq]
  have hsubtype :
      PRegularConjClass.ofSubtype p ⟨s, hs⟩ = ⟨ConjClasses.mk s, hc⟩ := by
    apply Subtype.ext; rfl
  rw [← hsubtype, FDRep.modularCharacterOnPRegularConjClass_ofSubtype]
  exact modularCharacter_mem_algebraMap_range hsplit T.ρ ⟨s, hs⟩

end Headline

end Representation
