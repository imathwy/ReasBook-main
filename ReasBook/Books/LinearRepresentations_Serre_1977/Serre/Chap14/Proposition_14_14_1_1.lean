variable {L : Type u} [Field L] {G : Type u} [Monoid G]

-- Proof sketch: the defining generator of `finiteRepGrothendieckRelations L G` attached to a
-- short exact sequence `0 → X → Y → Z → 0` becomes zero in the quotient, so the class of the
-- middle term equals the sum of the classes of the outer terms.
/-- In `R₀[L](G)`, a short exact sequence `0 → X → Y → Z → 0` yields the relation
`[Y] = [X] + [Z]`. -/
theorem finiteRepGrothendieckClass_middle_eq_left_add_right
    (S : ShortComplex (FDRep L G)) (hS : S.ShortExact) :
    [S.X₂]₀ = [S.X₁]₀ + [S.X₃]₀ := by
  -- The defining generator attached to `S` is zero in the quotient Grothendieck group.
  have hzero :
      QuotientAddGroup.mk' (finiteRepGrothendieckRelations L G)
        (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) =
        0 := by
    exact (QuotientAddGroup.eq_zero_iff _).2 <|
      AddSubgroup.subset_closure ⟨⟨S, hS⟩, rfl⟩
  refine (sub_eq_zero.mp ?_)
  simpa [finiteRepGrothendieckClass, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
    hzero

/-- Helper for Proposition 14-14.1-1: the zero representation has trivial Grothendieck class. -/
@[simp] theorem finiteRepGrothendieckClass_zero :
    [(0 : FDRep L G)]₀ = 0 := by
  let S : ShortComplex (FDRep L G) :=
    ShortComplex.mk (0 : (0 : FDRep L G) ⟶ 0) (0 : (0 : FDRep L G) ⟶ 0) (by simp)
  have hS : S.ShortExact := by
    -- The zero short complex is exact, and both structure maps have the expected mono/epi
    -- properties because every map out of or into the zero object is mono/epi.
    refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    exact (S.exact_iff_epi rfl).2 inferInstance
  have hrelation :=
    finiteRepGrothendieckClass_middle_eq_left_add_right (L := L) (G := G) S hS
  simpa [S] using hrelation

/-- Helper for Proposition 14-14.1-1: isomorphic finite-dimensional representations define the same
Grothendieck class. -/
theorem finiteRepGrothendieckClass_eq_of_nonempty_iso
    {V W : FDRep L G} (hVW : Nonempty (V ≅ W)) :
    [V]₀ = [W]₀ := by
  rcases hVW with ⟨e⟩
  let S : ShortComplex (FDRep L G) :=
    ShortComplex.mk e.hom (0 : W ⟶ (0 : FDRep L G)) (by simp)
  have hS : S.ShortExact := by
    -- Route correction: instead of rewriting classes directly in the quotient, build the exact
    -- short complex `0 → V → W → 0` coming from the isomorphism.
    refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    exact (S.exact_iff_epi rfl).2 inferInstance
  have hrelation :=
    finiteRepGrothendieckClass_middle_eq_left_add_right (L := L) (G := G) S hS
  simpa [S, finiteRepGrothendieckClass_zero (L := L) (G := G)] using hrelation.symm

/-- Helper for Proposition 14-14.1-1: a `Rep` isomorphism induces an equivalence of the
underlying representations. -/
private theorem nonempty_equiv_of_nonempty_iso_of_rep
    {V W : Type u} [AddCommGroup V] [Module L V]
    [AddCommGroup W] [Module L W]
    {ρ : Representation L G V} {σ : Representation L G W}
    (h : Nonempty (Rep.of ρ ≅ Rep.of σ)) :
    Nonempty (ρ.Equiv σ) := by
  rcases h with ⟨e⟩
  -- Package the forward and inverse `Rep` morphisms into a representation equivalence.
  refine ⟨Representation.Equiv.mk ?_ ?_⟩
  · refine
      { toLinearMap := e.hom.hom.toLinearMap
        invFun := e.inv.hom.toLinearMap
        left_inv := ?_
        right_inv := ?_ }
    · intro x
      exact Iso.hom_inv_id_apply e x
    · intro x
      exact Iso.inv_hom_id_apply e x
  · intro g
    ext x
    exact congrArg (fun m : V →ₗ[L] W => m x) (e.hom.hom.2 g)

/-- Helper for Proposition 14-14.1-1: for a module viewed through `Representation.ofModule'`,
the induced group-algebra action is the original `L[G]`-scalar multiplication. -/
private theorem ofModule'_asAlgebraHom_apply
    (M : Type u) [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    (r : L[G]) (m : M) :
    ((Representation.ofModule' (k := L) (G := G) M).asAlgebraHom r) m = r • m := by
  -- Expand the group-algebra element linearly and check the claim on monomials.
  refine MonoidAlgebra.induction_on
    (p := fun s : L[G] =>
      ((Representation.ofModule' (k := L) (G := G) M).asAlgebraHom s) m = s • m) r ?_ ?_ ?_
  · intro g
    simp [Representation.ofModule', MonoidAlgebra.of]
  · intro a b ha hb
    simp [ha, hb, add_smul]
  · intro a b hb
    simp [hb]

/-- Helper for Proposition 14-14.1-1: the owner module of `Representation.ofModule' M` is
canonically the original `L[G]`-module `M`. -/
private theorem nonempty_ofModule'_asModuleLinearEquiv
    (M : Type u) [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M] :
    Nonempty ((Representation.ofModule' (k := L) (G := G) M).asModule ≃ₗ[L[G]] M) := by
  -- Use `asModuleEquiv` and then show it respects the original `L[G]`-action.
  let toFun : (Representation.ofModule' (k := L) (G := G) M).asModule → M :=
    fun x => (Representation.ofModule' (k := L) (G := G) M).asModuleEquiv x
  let invFun : M → (Representation.ofModule' (k := L) (G := G) M).asModule :=
    fun x => (Representation.ofModule' (k := L) (G := G) M).asModuleEquiv.symm x
  have hleft : Function.LeftInverse invFun toFun := by
    intro x
    simp [toFun, invFun]
  have hright : Function.RightInverse invFun toFun := by
    intro x
    simp [toFun, invFun]
  have hadd : ∀ x y, toFun (x + y) = toFun x + toFun y := by
    intro x y
    rfl
  have hsmul : ∀ (r : L[G]) x, toFun (r • x) = r • toFun x := by
    intro r x
    -- Rewrite the transported action through `asModuleEquiv`, then identify it with the
    -- original `L[G]`-action on `M`.
    calc
      (Representation.ofModule' (k := L) (G := G) M).asModuleEquiv (r • x)
          = ((Representation.ofModule' (k := L) (G := G) M).asAlgebraHom r)
              ((Representation.ofModule' (k := L) (G := G) M).asModuleEquiv x) := by
                simpa using
                  (Representation.asModuleEquiv_map_smul
                    (ρ := Representation.ofModule' (k := L) (G := G) M) r x)
      _ = r • (Representation.ofModule' (k := L) (G := G) M).asModuleEquiv x := by
            simpa [toFun] using
              (ofModule'_asAlgebraHom_apply (L := L) (G := G) M r
                ((Representation.ofModule' (k := L) (G := G) M).asModuleEquiv x))
  refine ⟨
    { toFun := toFun
      invFun := invFun
      left_inv := hleft
      right_inv := hright
      map_add' := hadd
      map_smul' := hsmul }⟩

/-- Helper for Proposition 14-14.1-1: a simple `L[G]`-module viewed through
`Representation.ofModule'` is irreducible. -/
private theorem ofModule'_isIrreducible_of_isSimpleModule
    (M : Type u) [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    [IsSimpleModule L[G] M] :
    (Representation.ofModule' (k := L) (G := G) M).IsIrreducible := by
  -- Transfer simplicity across the canonical owner-module equivalence and then apply the
  -- irreducibility/simple-module bridge.
  rcases nonempty_ofModule'_asModuleLinearEquiv (L := L) (G := G) M with ⟨eM⟩
  exact
    (Representation.irreducible_iff_isSimpleModule_asModule
      (Representation.ofModule' (k := L) (G := G) M)).2
      (@IsSimpleModule.congr (L[G]) inferInstance
        ((Representation.ofModule' (k := L) (G := G) M).asModule)
        (Representation.ofModule' (k := L) (G := G) M).instAddCommGroupAsModule
        (Representation.ofModule' (k := L) (G := G) M).instModuleMonoidAlgebraAsModule
        M inferInstance inferInstance eM inferInstance)

/-- Helper for Proposition 14-14.1-1: viewing the owner module `ρ.asModule` through
`Representation.ofModule'` recovers `ρ` up to equivalence. -/
private theorem nonempty_equiv_of_ofModule'_asModule
    {V : Type u} [AddCommGroup V] [Module L V] [FiniteDimensional L V]
    (ρ : Representation L G V) :
    Nonempty ((Representation.ofModule' (k := L) (G := G) ρ.asModule).Equiv ρ) := by
  -- Route correction: keep the underlying `L[G]`-module carrier and use the canonical
  -- `asModuleEquiv` instead of rebuilding the equivalence through the `Rep`-module functor round-trip.
  refine ⟨Representation.Equiv.mk ?_ ?_⟩
  · exact ρ.asModuleEquiv
  · intro g
    ext x
    change ρ.asModuleEquiv ((MonoidAlgebra.of L G g) • x) = (ρ g) (ρ.asModuleEquiv x)
    convert (Representation.single_smul (ρ := ρ) (t := (1 : L)) g x) using 1
    simp

/-- Helper for Proposition 14-14.1-1: an `L[G]`-submodule of a finite-dimensional
`L`-representation remains finite-dimensional over `L`. -/
private theorem finiteDimensional_of_groupAlgebra_submodule
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M]
    (N : Submodule L[G] M) :
    FiniteDimensional L N := by
  -- The subtype inclusion realizes `N` as an `L`-subspace of a finite-dimensional space.
  simpa using
    FiniteDimensional.of_injective (Submodule.restrictScalars L N).subtype
      (Submodule.injective_subtype (Submodule.restrictScalars L N))

/-- Helper for Proposition 14-14.1-1: the quotient by an `L[G]`-submodule of a finite-dimensional
`L`-representation is still finite-dimensional over `L`. -/
private theorem finiteDimensional_of_groupAlgebra_quotient
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M]
    (N : Submodule L[G] M) :
    FiniteDimensional L (M ⧸ N) := by
  -- The quotient map is surjective, so the quotient inherits finite dimensionality.
  infer_instance

/-- Helper for Proposition 14-14.1-1: a subsingleton finite-dimensional `L[G]`-module defines the
zero Grothendieck class. -/
private theorem finiteRepGrothendieckClass_ofModule'_eq_zero_of_subsingleton
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M] [Subsingleton M] :
    [FDRep.of (Representation.ofModule' (k := L) (G := G) M)]₀ = 0 := by
  let Z : FDRep L G := FDRep.of (Representation.ofModule' (k := L) (G := G) M)
  -- A subsingleton carrier has zero identity map, so the corresponding representation is a zero
  -- object in `FDRep`.
  have hId : (𝟙 Z : Z ⟶ Z) = 0 := by
    ext x
    exact Subsingleton.elim _ _
  have hZero : IsZero Z := (IsZero.iff_id_eq_zero Z).2 hId
  simpa [Z] using
    (finiteRepGrothendieckClass_eq_of_nonempty_iso (L := L) (G := G)
      (V := Z) (W := 0) ⟨hZero.iso (isZero_zero (FDRep L G))⟩)

/-- Helper for Proposition 14-14.1-1: in `R₀[L](G)`, the class of a module viewed through
`Representation.ofModule'` splits as the sum of the class of a submodule and the class of the
quotient module. -/
private theorem finiteRepGrothendieckClass_ofModule'_eq_submodule_add_quotient
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M]
    (N : Submodule L[G] M)
    [FiniteDimensional L N] [FiniteDimensional L (M ⧸ N)] :
    [FDRep.of (Representation.ofModule' (k := L) (G := G) M)]₀ =
      [FDRep.of (Representation.ofModule' (k := L) (G := G) N)]₀ +
        [FDRep.of (Representation.ofModule' (k := L) (G := G) (M ⧸ N))]₀ := by
  -- Build the canonical short complex `0 → N → M → M ⧸ N → 0` in `FDRep`.
  let X₁ : FDRep L G := FDRep.of (Representation.ofModule' (k := L) (G := G) N)
  let X₂ : FDRep L G := FDRep.of (Representation.ofModule' (k := L) (G := G) M)
  let X₃ : FDRep L G := FDRep.of (Representation.ofModule' (k := L) (G := G) (M ⧸ N))
  let fRep :
      ((forget₂ (FDRep L G) (Rep L G)).obj X₁ ⟶
        (forget₂ (FDRep L G) (Rep L G)).obj X₂) :=
    Rep.ofHom ⟨N.subtype.restrictScalars L, fun g => by
      ext x
      rfl⟩
  let gRep :
      ((forget₂ (FDRep L G) (Rep L G)).obj X₂ ⟶
        (forget₂ (FDRep L G) (Rep L G)).obj X₃) :=
    Rep.ofHom ⟨N.mkQ.restrictScalars L, fun g => by
      ext x
      rfl⟩
  let f : X₁ ⟶ X₂ := (FDRep.forget₂HomLinearEquiv X₁ X₂) fRep
  let g : X₂ ⟶ X₃ := (FDRep.forget₂HomLinearEquiv X₂ X₃) gRep
  have hf : (forget₂ (FDRep L G) (Rep L G)).map f = fRep := by
    change (FDRep.forget₂HomLinearEquiv X₁ X₂).symm
        ((FDRep.forget₂HomLinearEquiv X₁ X₂) fRep) = fRep
    exact (FDRep.forget₂HomLinearEquiv X₁ X₂).left_inv fRep
  have hg : (forget₂ (FDRep L G) (Rep L G)).map g = gRep := by
    change (FDRep.forget₂HomLinearEquiv X₂ X₃).symm
        ((FDRep.forget₂HomLinearEquiv X₂ X₃) gRep) = gRep
    exact (FDRep.forget₂HomLinearEquiv X₂ X₃).left_inv gRep
  let S : ShortComplex (FDRep L G) := ShortComplex.mk f g (by
    apply (forget₂ (FDRep L G) (Rep L G)).map_injective
    rw [Functor.map_comp, hf, hg]
    ext x
    change N.mkQ (N.subtype x) = 0
    simp)
  let SRep : ShortComplex (Rep L G) := ShortComplex.mk fRep gRep (by
    ext x
    change N.mkQ (N.subtype x) = 0
    simp)
  have hMod : (SRep.map (forget₂ (Rep L G) (ModuleCat L))).ShortExact := by
    -- Forget once more to `ModuleCat L`, where the exactness statement is the familiar
    -- `LinearMap.exact_subtype_mkQ`.
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · rw [ShortComplex.moduleCat_exact_iff]
      intro x hx
      refine ⟨⟨x, ?_⟩, rfl⟩
      change N.mkQ x = 0 at hx
      simpa using hx
    · rw [ModuleCat.mono_iff_injective]
      intro x y hxy
      exact Subtype.ext hxy
    · rw [ModuleCat.epi_iff_surjective]
      intro x
      obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective N x
      exact ⟨y, rfl⟩
  have hRep' : SRep.ShortExact := by
    -- Reflect short exactness from `ModuleCat L` back to `Rep L G`.
    apply (CategoryTheory.ShortExact.shortExact_map_iff
      (S := SRep) (F := forget₂ (Rep L G) (ModuleCat L))).1
    simpa using hMod
  have hRep : (S.map (forget₂ (FDRep L G) (Rep L G))).ShortExact := by
    -- The `Rep`-image of the `FDRep` short complex is definitionally the same sequence.
    simpa [S, SRep, hf, hg] using hRep'
  have hS : S.ShortExact := by
    -- Finally reflect exactness and mono/epi back to `FDRep`.
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · exact
        ((S.exact_map_iff_of_faithful (forget₂ (FDRep L G) (Rep L G))).1 hRep.exact)
    · exact (forget₂ (FDRep L G) (Rep L G)).mono_of_mono_map hRep.mono_f
    · exact (forget₂ (FDRep L G) (Rep L G)).epi_of_epi_map hRep.epi_g
  -- Apply the defining Grothendieck relation to this canonical short exact sequence.
  have hrelation :=
    finiteRepGrothendieckClass_middle_eq_left_add_right (L := L) (G := G) S hS
  simpa [S, X₁, X₂, X₃] using hrelation

section Basis

variable {ι : Type x}

/-- Helper for Proposition 14-14.1-1: every `FDRep` owner is canonically isomorphic to the owner
rebuilt from its underlying unbundled representation. -/
private noncomputable def fdRepIsoOfRho (τ : FDRep L G) : τ ≅ FDRep.of τ.ρ :=
  Action.mkIso (Iso.refl _) fun g => by
    ext x
    rfl

/-- Helper for Proposition 14-14.1-1: the class of any finite-dimensional `L[G]`-module belongs
to the span of the classes of a complete simple family. -/
private theorem finiteRepGrothendieckClass_ofModule'_mem_span_simple_classes_of_complete_family
    (π : ι → FDRep L G)
    (hπ_complete : IsCompleteIrreducibleFamily π)
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M] :
    [FDRep.of (Representation.ofModule' (k := L) (G := G) M)]₀ ∈
      Submodule.span ℤ (Set.range fun i ↦ [π i]₀) := by
  let S : Submodule ℤ (R₀[L](G)) := Submodule.span ℤ (Set.range fun i ↦ [π i]₀)
  -- Induct on the vector-space dimension, using a simple quotient at each nontrivial step.
  have hmain :
      ∀ n : ℕ,
        ∀ (M : Type u), [AddCommGroup M] → [Module L M] → [FiniteDimensional L M] →
          [Module L[G] M] → [IsScalarTower L L[G] M] →
          Module.finrank L M ≤ n →
            [FDRep.of (Representation.ofModule' (k := L) (G := G) M)]₀ ∈ S := by
    intro n
    induction n with
    | zero =>
        intro M _ _ _ _ _ hM
        have hfinrank0 : Module.finrank L M = 0 := by
          omega
        letI : Subsingleton M := (Module.finrank_zero_iff (R := L) (M := M)).1 hfinrank0
        rw [finiteRepGrothendieckClass_ofModule'_eq_zero_of_subsingleton
          (L := L) (G := G) M]
        exact Submodule.zero_mem S
    | succ n ihn =>
        intro M _ _ _ _ _ hM
        by_cases hsub : Subsingleton M
        · letI := hsub
          -- The subsingleton case is already zero, so it lies in the span.
          rw [finiteRepGrothendieckClass_ofModule'_eq_zero_of_subsingleton
            (L := L) (G := G) M]
          exact Submodule.zero_mem S
        · have hlength : IsFiniteLength L[G] M :=
              (isFiniteLength_iff_isNoetherian_isArtinian).2
                ⟨isNoetherian_of_tower L inferInstance, isArtinian_of_tower L inferInstance⟩
          cases hlength with
          | of_subsingleton =>
              exact (hsub inferInstance).elim
          | @of_simple_quotient M _ _ N _ hNlength =>
              let _ : Module L N := inferInstance
              let _ : IsScalarTower L L[G] N := inferInstance
              let _ : FiniteDimensional L N :=
                finiteDimensional_of_groupAlgebra_submodule (L := L) (G := G) M N
              let _ : FiniteDimensional L (M ⧸ N) :=
                finiteDimensional_of_groupAlgebra_quotient (L := L) (G := G) M N
              have hN_ne_top : N ≠ ⊤ := by
                intro htop
                letI : Subsingleton (M ⧸ N) := by
                  simpa [htop]
                exact (not_subsingleton_iff_nontrivial.2
                  (IsSimpleModule.nontrivial (R := L[G]) (M := M ⧸ N))) inferInstance
              have hN_le : Module.finrank L N ≤ n := by
                have hlt : Module.finrank L N < Module.finrank L M := by
                  simpa using
                    (Submodule.finrank_lt (K := L) (V := M)
                      (s := Submodule.restrictScalars L N) (by simpa using hN_ne_top))
                omega
              have hN :
                  [FDRep.of (Representation.ofModule' (k := L) (G := G) N)]₀ ∈ S :=
                ihn N hN_le
              -- The quotient is simple, so completeness identifies it with one basis generator.
              have hquot_irr :
                  (Representation.ofModule' (k := L) (G := G) (M ⧸ N)).IsIrreducible :=
                ofModule'_isIrreducible_of_isSimpleModule (L := L) (G := G) (M := M ⧸ N)
              obtain ⟨i, hi⟩ :=
                IsCompleteIrreducibleFamily.exists_iso_of_representation
                  (π := π) hπ_complete
                  (τ := Representation.ofModule' (k := L) (G := G) (M ⧸ N)) inferInstance
              have hQ :
                  [FDRep.of (Representation.ofModule' (k := L) (G := G) (M ⧸ N))]₀ ∈ S := by
                rw [finiteRepGrothendieckClass_eq_of_nonempty_iso (L := L) (G := G) hi]
                exact Submodule.subset_span ⟨i, rfl⟩
              -- Reassemble the class of `M` from the submodule and simple quotient classes.
              rw [finiteRepGrothendieckClass_ofModule'_eq_submodule_add_quotient
                (L := L) (G := G) M N]
              exact Submodule.add_mem S hN hQ
  exact hmain (Module.finrank L M) M le_rfl

/-- Helper for Proposition 14-14.1-1: the `L[G]`-module underlying a finite-dimensional
representation. -/
private noncomputable abbrev fdRepAsModule (τ : FDRep L G) : ModuleCat L[G] :=
  Rep.toModuleMonoidAlgebra.obj ((forget₂ (FDRep L G) (Rep L G)).obj τ)

/-- Helper for Proposition 14-14.1-1: the underlying representation attached to a finite-dimensional
representation object. -/
private noncomputable abbrev fdRepOwnerRepresentation (τ : FDRep L G) : Representation L G τ :=
  τ.ρ

/-- Helper for Proposition 14-14.1-1: the raw owner type underlying a finite-dimensional
representation, viewed as an `L[G]`-module. -/
private noncomputable abbrev fdRepOwnerModule (τ : FDRep L G) :=
  (fdRepOwnerRepresentation (L := L) (G := G) τ).asModule

/-- Helper for Proposition 14-14.1-1: the quotient factor attached to the `i`-th step of a
composition series of `L[G]`-submodules. -/
private abbrev compositionSeriesFactor
    {M : Type u} [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    (s : CompositionSeries (Submodule L[G] M)) (i : Fin s.length) :=
  s i.succ ⧸ (s (Fin.castSucc i)).comap (s i.succ).subtype

/-- Helper for Proposition 14-14.1-1: the `i`-th factor of a composition series is isomorphic to
the fixed simple target `τ`. -/
private def compositionSeriesFactorMatches
    (τ : FDRep L G)
    {M : Type u} [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    (s : CompositionSeries (Submodule L[G] M)) (i : Fin s.length) : Prop :=
  Nonempty (compositionSeriesFactor (L := L) (G := G) s i ≃ₗ[L[G]] fdRepAsModule (L := L) (G := G) τ)

/-- Helper for Proposition 14-14.1-1: the number of factors in a composition series whose quotient
modules are isomorphic to the fixed simple target `τ`. -/
private noncomputable def simple_factor_count
    (τ : FDRep L G)
    {M : Type u} [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    (s : CompositionSeries (Submodule L[G] M)) : ℕ :=
  Nat.card { i : Fin s.length // compositionSeriesFactorMatches (L := L) (G := G) τ s i }

/-- Helper for Proposition 14-14.1-1: transporting a factor quotient across a linear equivalence
preserves the property of matching the fixed simple target `τ`. -/
private theorem compositionSeriesFactorMatches_iff_of_linearEquiv
    (τ : FDRep L G)
    {A B : Type u} [AddCommGroup A] [AddCommGroup B] [Module L[G] A] [Module L[G] B]
    (e : A ≃ₗ[L[G]] B) :
    Nonempty (A ≃ₗ[L[G]] fdRepAsModule (L := L) (G := G) τ) ↔
      Nonempty (B ≃ₗ[L[G]] fdRepAsModule (L := L) (G := G) τ) := by
  constructor
  · intro hA
    rcases hA with ⟨eA⟩
    exact ⟨e.symm.trans eA⟩
  · intro hB
    rcases hB with ⟨eB⟩
    exact ⟨e.trans eB⟩

/-- Helper for Proposition 14-14.1-1: equivalent composition series have the same fixed-simple
factor count. -/
private theorem simple_factor_count_series_equiv
    (τ : FDRep L G)
    {M : Type u} [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    {s₁ s₂ : CompositionSeries (Submodule L[G] M)}
    (h : s₁.Equivalent s₂) :
    simple_factor_count (L := L) (G := G) τ s₁ =
      simple_factor_count (L := L) (G := G) τ s₂ := by
  classical
  let e :
      { i : Fin s₁.length // compositionSeriesFactorMatches (L := L) (G := G) τ s₁ i } ≃
        { j : Fin s₂.length // compositionSeriesFactorMatches (L := L) (G := G) τ s₂ j } :=
    { toFun := fun i => ⟨h.choose i.1, by
        rcases h.choose_spec i.1 with ⟨ei⟩
        exact (compositionSeriesFactorMatches_iff_of_linearEquiv (L := L) (G := G) τ ei).1 i.2⟩
      invFun := fun j => ⟨h.choose.symm j.1, by
        rcases h.choose_spec (h.choose.symm j.1) with ⟨ej⟩
        have hj : h.choose (h.choose.symm j.1) = j.1 := by
          simp
        have ej' :
            compositionSeriesFactor (L := L) (G := G) s₁ (h.choose.symm j.1) ≃ₗ[L[G]]
              compositionSeriesFactor (L := L) (G := G) s₂ (h.choose (h.choose.symm j.1)) := by
          simpa [compositionSeriesFactor] using ej
        have hmatch :
            compositionSeriesFactorMatches (L := L) (G := G) τ s₂
              (h.choose (h.choose.symm j.1)) := by
          simpa [hj] using j.2
        exact (compositionSeriesFactorMatches_iff_of_linearEquiv (L := L) (G := G) τ ej').2 hmatch⟩
      left_inv := by
        intro i
        ext
        simp
      right_inv := by
        intro j
        ext
        simp }
  simpa [simple_factor_count] using Nat.card_congr e

/-- Helper for Proposition 14-14.1-1: mapping a factor quotient along an injective linear map
identifies it with the corresponding factor quotient in the mapped composition series. -/
private noncomputable def compositionSeriesFactor_map_equiv
    {M N : Type u} [AddCommGroup M] [AddCommGroup N]
    [Module L M] [Module L N] [Module L[G] M] [Module L[G] N]
    [IsScalarTower L L[G] M] [IsScalarTower L L[G] N]
    {f : N →ₗ[L[G]] M} (hf : Function.Injective f)
    (s : CompositionSeries (Submodule L[G] N)) (i : Fin s.length) :
    compositionSeriesFactor (L := L) (G := G) s i ≃ₗ[L[G]]
      compositionSeriesFactor (L := L) (G := G)
        (s.map ⟨Submodule.map f, fun {p q} h => Submodule.map_covBy_of_injective hf h⟩) i := by
  let e : s i.succ ≃ₗ[L[G]] Submodule.map f (s i.succ) :=
    Submodule.equivMapOfInjective (f := f) hf (s i.succ)
  have hmap :
      Submodule.map (e : s i.succ →ₗ[L[G]] Submodule.map f (s i.succ))
          ((s (Fin.castSucc i)).comap (s i.succ).subtype) =
        (Submodule.map f (s (Fin.castSucc i))).comap (Submodule.map f (s i.succ)).subtype := by
    -- Compare the two submodules inside the ambient factor domain by transporting along the map
    -- equivalence `e`.
    rw [Submodule.map_equiv_eq_comap_symm]
    ext z
    constructor
    · intro hz
      change ((e.symm z : s i.succ) : N) ∈ s (Fin.castSucc i) at hz
      change z.1 ∈ Submodule.map f (s (Fin.castSucc i))
      exact ⟨(e.symm z : s i.succ), hz, by
        simp [e]⟩
    · intro hz
      change ((e.symm z : s i.succ) : N) ∈ s (Fin.castSucc i)
      change z.1 ∈ Submodule.map f (s (Fin.castSucc i)) at hz
      rcases hz with ⟨y, hy, hyz⟩
      rcases z.2 with ⟨w, hw, hwz⟩
      have hwy : w = y := hf (hwz.trans hyz.symm)
      have hyq : y ∈ s i.succ := hwy ▸ hw
      have heyz : e ⟨y, hyq⟩ = z := by
        apply Subtype.ext
        simpa [e] using hyz
      have hEq : (⟨y, hyq⟩ : s i.succ) = e.symm z :=
        e.injective (heyz.trans (e.apply_symm_apply z).symm)
      simpa [hEq.symm] using hy
  simpa [compositionSeriesFactor] using
    (Submodule.Quotient.equiv
      ((s (Fin.castSucc i)).comap (s i.succ).subtype)
      ((Submodule.map f (s (Fin.castSucc i))).comap (Submodule.map f (s i.succ)).subtype)
      e hmap)

/-- Helper for Proposition 14-14.1-1: mapping a composition series along an injective linear map
preserves the fixed-simple factor count. -/
private theorem simple_factor_count_series_map
    (τ : FDRep L G)
    {M N : Type u} [AddCommGroup M] [AddCommGroup N]
    [Module L M] [Module L N] [Module L[G] M] [Module L[G] N]
    [IsScalarTower L L[G] M] [IsScalarTower L L[G] N]
    {f : N →ₗ[L[G]] M} (hf : Function.Injective f)
    (s : CompositionSeries (Submodule L[G] N)) :
    simple_factor_count (L := L) (G := G) τ
        (s.map ⟨Submodule.map f, fun {p q} h => Submodule.map_covBy_of_injective hf h⟩) =
      simple_factor_count (L := L) (G := G) τ s := by
  -- The mapped series has the same quotients, up to the canonical map-equivalences above.
  let s' : CompositionSeries (Submodule L[G] M) :=
    s.map ⟨Submodule.map f, fun {p q} h => Submodule.map_covBy_of_injective hf h⟩
  let e :
      { i : Fin s.length // compositionSeriesFactorMatches (L := L) (G := G) τ s i } ≃
        { i : Fin s'.length // compositionSeriesFactorMatches (L := L) (G := G) τ s' i } :=
    { toFun := fun i => ⟨i.1, by
        simpa [s'] using
          (compositionSeriesFactorMatches_iff_of_linearEquiv (L := L) (G := G) τ
            (compositionSeriesFactor_map_equiv (L := L) (G := G) hf s i.1)).1 i.2⟩
      invFun := fun i => ⟨i.1, by
        simpa [s'] using
          (compositionSeriesFactorMatches_iff_of_linearEquiv (L := L) (G := G) τ
            (compositionSeriesFactor_map_equiv (L := L) (G := G) hf s i.1)).2 i.2⟩
      left_inv := by
        intro i
        ext
        rfl
      right_inv := by
        intro i
        ext
        rfl }
  simpa [simple_factor_count, s'] using (Nat.card_congr e).symm

/-- Helper for Proposition 14-14.1-1: comapping along a surjective linear map identifies each
factor quotient with the corresponding factor quotient in the original series. -/
private noncomputable def compositionSeriesFactor_comap_equiv
    {M P : Type u} [AddCommGroup M] [AddCommGroup P]
    [Module L M] [Module L P] [Module L[G] M] [Module L[G] P]
    [IsScalarTower L L[G] M] [IsScalarTower L L[G] P]
    {g : M →ₗ[L[G]] P} (hg : Function.Surjective g)
    (s : CompositionSeries (Submodule L[G] P)) (i : Fin s.length) :
    compositionSeriesFactor (L := L) (G := G)
        (s.map ⟨Submodule.comap g, fun {p q} h => Submodule.comap_covBy_of_surjective hg h⟩) i ≃ₗ[L[G]]
      compositionSeriesFactor (L := L) (G := G) s i := by
  let φ₀ : Submodule.comap g (s i.succ) →ₗ[L[G]] s i.succ :=
    { toFun := fun x => ⟨g x, x.2⟩
      map_add' := by
        intro x y
        ext
        simp
      map_smul' := by
        intro a x
        ext
        simp }
  have hφ₀_surj : Function.Surjective φ₀ := by
    -- Surjectivity comes from surjectivity of `g` on the ambient module.
    intro y
    rcases hg y with ⟨x, hx⟩
    refine ⟨⟨x, ?_⟩, ?_⟩
    · simpa [hx] using y.2
    · ext
      simp [φ₀, hx]
  let φ :
      Submodule.comap g (s i.succ) →ₗ[L[G]]
        (s i.succ ⧸ (s (Fin.castSucc i)).comap (s i.succ).subtype) :=
    (Submodule.mkQ ((s (Fin.castSucc i)).comap (s i.succ).subtype)).comp φ₀
  have hφ_surj : Function.Surjective φ := by
    intro z
    refine Quotient.inductionOn' z ?_
    intro y
    rcases hφ₀_surj y with ⟨x, rfl⟩
    exact ⟨x, rfl⟩
  have hker :
      φ.ker =
        (Submodule.comap g (s (Fin.castSucc i))).comap (Submodule.comap g (s i.succ)).subtype := by
    -- The kernel condition is exactly the requirement that the image land in the previous step.
    ext x
    change
      ((Submodule.mkQ ((s (Fin.castSucc i)).comap (s i.succ).subtype)) (φ₀ x) = 0) ↔
        x.1 ∈ Submodule.comap g (s (Fin.castSucc i))
    simp [φ₀]
  exact
    (Submodule.quotEquivOfEq _ _ hker.symm).trans
      (LinearMap.quotKerEquivOfSurjective φ hφ_surj)

/-- Helper for Proposition 14-14.1-1: comapping a composition series along a surjective linear map
preserves the fixed-simple factor count. -/
private theorem simple_factor_count_series_comap
    (τ : FDRep L G)
    {M P : Type u} [AddCommGroup M] [AddCommGroup P]
    [Module L M] [Module L P] [Module L[G] M] [Module L[G] P]
    [IsScalarTower L L[G] M] [IsScalarTower L L[G] P]
    {g : M →ₗ[L[G]] P} (hg : Function.Surjective g)
    (s : CompositionSeries (Submodule L[G] P)) :
    simple_factor_count (L := L) (G := G) τ
        (s.map ⟨Submodule.comap g, fun {p q} h => Submodule.comap_covBy_of_surjective hg h⟩) =
      simple_factor_count (L := L) (G := G) τ s := by
  -- The comapped series has the same quotients, up to the canonical comap-equivalences above.
  let s' : CompositionSeries (Submodule L[G] M) :=
    s.map ⟨Submodule.comap g, fun {p q} h => Submodule.comap_covBy_of_surjective hg h⟩
  let e :
      { i : Fin s'.length // compositionSeriesFactorMatches (L := L) (G := G) τ s' i } ≃
        { i : Fin s.length // compositionSeriesFactorMatches (L := L) (G := G) τ s i } :=
    { toFun := fun i => ⟨i.1, by
        simpa [s'] using
          (compositionSeriesFactorMatches_iff_of_linearEquiv (L := L) (G := G) τ
            (compositionSeriesFactor_comap_equiv (L := L) (G := G) hg s i.1)).1 i.2⟩
      invFun := fun i => ⟨i.1, by
        simpa [s'] using
          (compositionSeriesFactorMatches_iff_of_linearEquiv (L := L) (G := G) τ
            (compositionSeriesFactor_comap_equiv (L := L) (G := G) hg s i.1)).2 i.2⟩
      left_inv := by
        intro i
        ext
        rfl
      right_inv := by
        intro i
        ext
        rfl }
  simpa [simple_factor_count, s'] using Nat.card_congr e

/-- Helper for Proposition 14-14.1-1: finite-dimensional `L[G]`-modules have finite length. -/
private theorem isFiniteLength_of_groupAlgebra_module
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M] :
    IsFiniteLength L[G] M := by
  -- Finite-dimensionality over `L` implies both noetherian and artinian over `L[G]`.
  exact (isFiniteLength_iff_isNoetherian_isArtinian).2
    ⟨isNoetherian_of_tower L inferInstance, isArtinian_of_tower L inferInstance⟩

/-- Helper for Proposition 14-14.1-1: choose a composition series from `⊥` to `⊤` for a
finite-dimensional `L[G]`-module. -/
private noncomputable def finiteLengthCompositionSeries
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M] :
    CompositionSeries (Submodule L[G] M) :=
  Classical.choose
    (isFiniteLength_iff_exists_compositionSeries.mp
      (isFiniteLength_of_groupAlgebra_module (L := L) (G := G) M))

/-- Helper for Proposition 14-14.1-1: the chosen composition series starts at `⊥`. -/
private theorem finiteLengthCompositionSeries_head
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M] :
    (finiteLengthCompositionSeries (L := L) (G := G) M).head = ⊥ :=
  (Classical.choose_spec
    (isFiniteLength_iff_exists_compositionSeries.mp
      (isFiniteLength_of_groupAlgebra_module (L := L) (G := G) M))).1

/-- Helper for Proposition 14-14.1-1: the chosen composition series ends at `⊤`. -/
private theorem finiteLengthCompositionSeries_last
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M] :
    (finiteLengthCompositionSeries (L := L) (G := G) M).last = ⊤ :=
  (Classical.choose_spec
    (isFiniteLength_iff_exists_compositionSeries.mp
      (isFiniteLength_of_groupAlgebra_module (L := L) (G := G) M))).2

/-- Helper for Proposition 14-14.1-1: the multiplicity of the fixed simple target `τ` in a
finite-dimensional `L[G]`-module, defined by counting matching factors in a chosen composition
series. -/
private noncomputable def simple_factor_multiplicity
    (τ : FDRep L G)
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M] : ℕ :=
  simple_factor_count (L := L) (G := G) τ
    (finiteLengthCompositionSeries (L := L) (G := G) M)

/-- Helper for Proposition 14-14.1-1: the chosen-series multiplicity agrees with the count computed
from any other composition series with endpoints `⊥` and `⊤`. -/
private theorem simple_factor_multiplicity_eq_count
    (τ : FDRep L G)
    (M : Type u) [AddCommGroup M] [Module L M] [FiniteDimensional L M]
    [Module L[G] M] [IsScalarTower L L[G] M]
    (s : CompositionSeries (Submodule L[G] M))
    (hs₁ : s.head = ⊥) (hs₂ : s.last = ⊤) :
    simple_factor_multiplicity (L := L) (G := G) τ M =
      simple_factor_count (L := L) (G := G) τ s := by
  -- Jordan-Hölder identifies the chosen composition series with any other one having the same
  -- endpoints, so the fixed-simple factor count is independent of the choice.
  exact simple_factor_count_series_equiv (L := L) (G := G) τ
    (CompositionSeries.jordan_holder
      (finiteLengthCompositionSeries (L := L) (G := G) M) s
      ((finiteLengthCompositionSeries_head (L := L) (G := G) M).trans hs₁.symm)
      ((finiteLengthCompositionSeries_last (L := L) (G := G) M).trans hs₂.symm))

/-- Helper for Proposition 14-14.1-1: in an exact sequence, the mapped composition series on the
submodule side and the comapped composition series on the quotient side meet at the exact seam. -/
private theorem compositionSeries_map_last_eq_comap_head_of_exact
    {M N P : Type u} [AddCommGroup M] [AddCommGroup N] [AddCommGroup P]
    [Module L M] [Module L N] [Module L P]
    [Module L[G] M] [Module L[G] N] [Module L[G] P]
    [IsScalarTower L L[G] M] [IsScalarTower L L[G] N] [IsScalarTower L L[G] P]
    {f : N →ₗ[L[G]] M} {g : M →ₗ[L[G]] P}
    (hf : Function.Injective f) (hg : Function.Surjective g) (hfg : Function.Exact f g)
    (t : CompositionSeries (Submodule L[G] N)) (ht : t.last = ⊤)
    (s : CompositionSeries (Submodule L[G] P)) (hs : s.head = ⊥) :
    let t' : CompositionSeries (Submodule L[G] M) :=
      t.map ⟨Submodule.map f, fun {p q} h => Submodule.map_covBy_of_injective hf h⟩
    let s' : CompositionSeries (Submodule L[G] M) :=
      s.map ⟨Submodule.comap g, fun {p q} h => Submodule.comap_covBy_of_surjective hg h⟩
    t'.last = s'.head := by
  dsimp
  let t' : CompositionSeries (Submodule L[G] M) :=
    t.map ⟨Submodule.map f, fun {p q} h => Submodule.map_covBy_of_injective hf h⟩
  let s' : CompositionSeries (Submodule L[G] M) :=
    s.map ⟨Submodule.comap g, fun {p q} h => Submodule.comap_covBy_of_surjective hg h⟩
  -- Exactness identifies `range f` with `ker g`, so the transported series glue at this common
  -- submodule of `M`.
  calc
    t'.last = Submodule.map f (⊤ : Submodule L[G] N) := by
      simpa [t'] using congrArg (Submodule.map f) ht
    _ = Submodule.comap g (⊥ : Submodule L[G] P) := by
      rw [Submodule.map_top, Submodule.comap_bot, LinearMap.exact_iff.mp hfg]
    _ = s'.head := by
      symm
      simpa [s'] using congrArg (Submodule.comap g) hs

/-- Helper for Proposition 14-14.1-1: the factors in the left block of a smashed composition
series agree with the factors of the original left series. -/
private noncomputable def compositionSeriesFactor_smash_left_equiv
    {M : Type u} [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    (t s : CompositionSeries (Submodule L[G] M)) (h : t.last = s.head) (i : Fin t.length) :
    compositionSeriesFactor (L := L) (G := G) (t.smash s h) (i.castAdd s.length) ≃ₗ[L[G]]
      compositionSeriesFactor (L := L) (G := G) t i := by
  -- The `smash` construction leaves the left block unchanged on both endpoints of each factor.
  have hsucc :
      (t.smash s h) (i.castAdd s.length).succ = t i.succ := by
    simpa using (RelSeries.smash_succ_castAdd (p := t) (q := s) h i)
  let e : (t.smash s h) (i.castAdd s.length).succ ≃ₗ[L[G]] t i.succ :=
    LinearEquiv.ofEq _ _ hsucc
  have hmap :
      Submodule.map (e : (t.smash s h) (i.castAdd s.length).succ →ₗ[L[G]] t i.succ)
          (((t.smash s h) (i.castAdd s.length).castSucc).comap
            ((t.smash s h) (i.castAdd s.length).succ).subtype) =
        (t i.castSucc).comap (t i.succ).subtype := by
    ext x
    simp [e, RelSeries.smash_castAdd]
  simpa [compositionSeriesFactor] using
    (Submodule.Quotient.equiv
      (((t.smash s h) (i.castAdd s.length).castSucc).comap
        ((t.smash s h) (i.castAdd s.length).succ).subtype)
      ((t i.castSucc).comap (t i.succ).subtype) e hmap)

/-- Helper for Proposition 14-14.1-1: the factors in the right block of a smashed composition
series agree with the factors of the original right series. -/
private noncomputable def compositionSeriesFactor_smash_right_equiv
    {M : Type u} [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    (t s : CompositionSeries (Submodule L[G] M)) (h : t.last = s.head) (i : Fin s.length) :
    compositionSeriesFactor (L := L) (G := G) (t.smash s h) (i.natAdd t.length) ≃ₗ[L[G]]
      compositionSeriesFactor (L := L) (G := G) s i := by
  -- The same endpoint comparison identifies the right block with the original right series.
  have hsucc :
      (t.smash s h) (i.natAdd t.length).succ = s i.succ := by
    simpa using (RelSeries.smash_succ_natAdd (p := t) (q := s) h i)
  let e : (t.smash s h) (i.natAdd t.length).succ ≃ₗ[L[G]] s i.succ :=
    LinearEquiv.ofEq _ _ hsucc
  have hmap :
      Submodule.map (e : (t.smash s h) (i.natAdd t.length).succ →ₗ[L[G]] s i.succ)
          (((t.smash s h) (i.natAdd t.length).castSucc).comap
            ((t.smash s h) (i.natAdd t.length).succ).subtype) =
        (s i.castSucc).comap (s i.succ).subtype := by
    ext x
    simp [e, -Fin.castSucc_natAdd, RelSeries.smash_natAdd]
  simpa [compositionSeriesFactor] using
    (Submodule.Quotient.equiv
      (((t.smash s h) (i.natAdd t.length).castSucc).comap
        ((t.smash s h) (i.natAdd t.length).succ).subtype)
      ((s i.castSucc).comap (s i.succ).subtype) e hmap)

/-- Helper for Proposition 14-14.1-1: the fixed-simple factor count on a smashed composition series
is the sum of the counts on the left and right blocks. -/
private theorem simple_factor_count_series_smash
    (τ : FDRep L G)
    {M : Type u} [AddCommGroup M] [Module L M] [Module L[G] M] [IsScalarTower L L[G] M]
    (t s : CompositionSeries (Submodule L[G] M)) (h : t.last = s.head) :
    simple_factor_count (L := L) (G := G) τ (t.smash s h) =
      simple_factor_count (L := L) (G := G) τ t +
        simple_factor_count (L := L) (G := G) τ s := by
  classical
  have hpred :
      ∀ k : Fin (t.length + s.length),
        compositionSeriesFactorMatches (L := L) (G := G) τ (t.smash s h) k ↔
          match finSumFinEquiv.symm k with
          | Sum.inl i => compositionSeriesFactorMatches (L := L) (G := G) τ t i
          | Sum.inr i => compositionSeriesFactorMatches (L := L) (G := G) τ s i := by
    intro k
    cases hk : finSumFinEquiv.symm k with
    | inl i =>
        have hk' : k = i.castAdd s.length := by
          have hk'' := congrArg (fun x : Fin t.length ⊕ Fin s.length =>
            (finSumFinEquiv x : Fin (t.length + s.length))) hk
          simpa using hk''
        subst k
        simpa [finSumFinEquiv_symm_apply_castAdd] using
          (compositionSeriesFactorMatches_iff_of_linearEquiv (L := L) (G := G) τ
            (compositionSeriesFactor_smash_left_equiv (L := L) (G := G) t s h i))
    | inr i =>
        have hk' : k = i.natAdd t.length := by
          have hk'' := congrArg (fun x : Fin t.length ⊕ Fin s.length =>
            (finSumFinEquiv x : Fin (t.length + s.length))) hk
          simpa using hk''
        subst k
        simpa [finSumFinEquiv_symm_apply_natAdd] using
          (compositionSeriesFactorMatches_iff_of_linearEquiv (L := L) (G := G) τ
            (compositionSeriesFactor_smash_right_equiv (L := L) (G := G) t s h i))
  let e :
      { k : Fin (t.length + s.length) //
          compositionSeriesFactorMatches (L := L) (G := G) τ (t.smash s h) k } ≃
        ({ i : Fin t.length // compositionSeriesFactorMatches (L := L) (G := G) τ t i } ⊕
          { i : Fin s.length // compositionSeriesFactorMatches (L := L) (G := G) τ s i }) :=
    ((finSumFinEquiv.symm).subtypeEquiv hpred).trans
      (Equiv.subtypeSum
        (p := fun u : Fin t.length ⊕ Fin s.length =>
          match u with
          | Sum.inl i => compositionSeriesFactorMatches (L := L) (G := G) τ t i
          | Sum.inr i => compositionSeriesFactorMatches (L := L) (G := G) τ s i))
  -- The matching factors of the smash split into the disjoint left and right blocks.
  calc
    simple_factor_count (L := L) (G := G) τ (t.smash s h) =
        Nat.card
          ({ i : Fin t.length // compositionSeriesFactorMatches (L := L) (G := G) τ t i } ⊕
            { i : Fin s.length // compositionSeriesFactorMatches (L := L) (G := G) τ s i }) := by
          simpa [simple_factor_count] using Nat.card_congr e
    _ = simple_factor_count (L := L) (G := G) τ t +
        simple_factor_count (L := L) (G := G) τ s := by
          rw [simple_factor_count, simple_factor_count, Nat.card_sum]

/-- Helper for Proposition 14-14.1-1: fixed-simple multiplicity is additive in short exact
sequences of finite-dimensional `L[G]`-modules. -/
private theorem simple_factor_multiplicity_eq_add_of_exact
    (τ : FDRep L G)
    {M N P : Type u} [AddCommGroup M] [AddCommGroup N] [AddCommGroup P]
    [Module L M] [Module L N] [Module L P]
    [FiniteDimensional L M] [FiniteDimensional L N] [FiniteDimensional L P]
    [Module L[G] M] [Module L[G] N] [Module L[G] P]
    [IsScalarTower L L[G] M] [IsScalarTower L L[G] N] [IsScalarTower L L[G] P]
    {f : N →ₗ[L[G]] M} {g : M →ₗ[L[G]] P}
    (hf : Function.Injective f) (hg : Function.Surjective g) (hfg : Function.Exact f g) :
    simple_factor_multiplicity (L := L) (G := G) τ M =
      simple_factor_multiplicity (L := L) (G := G) τ N +
        simple_factor_multiplicity (L := L) (G := G) τ P := by
  let t : CompositionSeries (Submodule L[G] N) :=
    finiteLengthCompositionSeries (L := L) (G := G) N
  let s : CompositionSeries (Submodule L[G] P) :=
    finiteLengthCompositionSeries (L := L) (G := G) P
  let t' : CompositionSeries (Submodule L[G] M) :=
    t.map ⟨Submodule.map f, fun {_ _} h => Submodule.map_covBy_of_injective hf h⟩
  let s' : CompositionSeries (Submodule L[G] M) :=
    s.map ⟨Submodule.comap g, fun {_ _} h => Submodule.comap_covBy_of_surjective hg h⟩
  let hseam : t'.last = s'.head :=
    compositionSeries_map_last_eq_comap_head_of_exact (L := L) (G := G) hf hg hfg
      t (finiteLengthCompositionSeries_last (L := L) (G := G) N)
      s (finiteLengthCompositionSeries_head (L := L) (G := G) P)
  let r : CompositionSeries (Submodule L[G] M) := t'.smash s' hseam
  have ht_head : t.head = ⊥ :=
    finiteLengthCompositionSeries_head (L := L) (G := G) N
  have hs_last : s.last = ⊤ :=
    finiteLengthCompositionSeries_last (L := L) (G := G) P
  -- Route correction: prove additivity at the series level on `r := t'.smash s' hseam`, then
  -- transfer back to the chosen multiplicities on `N`, `M`, and `P`.
  calc
    simple_factor_multiplicity (L := L) (G := G) τ M =
        simple_factor_count (L := L) (G := G) τ r := by
          apply simple_factor_multiplicity_eq_count (L := L) (G := G) τ M r
          · simpa [r, t', t, ht_head, -Submodule.map_bot] using Submodule.map_bot f
          · simpa [r, s', s, hs_last, -Submodule.comap_top] using Submodule.comap_top g
    _ = simple_factor_count (L := L) (G := G) τ t' +
        simple_factor_count (L := L) (G := G) τ s' := by
          simp [r, simple_factor_count_series_smash]
    _ = simple_factor_count (L := L) (G := G) τ t +
        simple_factor_count (L := L) (G := G) τ s := by
          rw [simple_factor_count_series_map (L := L) (G := G) τ hf t,
            simple_factor_count_series_comap (L := L) (G := G) τ hg s]
    _ = simple_factor_multiplicity (L := L) (G := G) τ N +
        simple_factor_multiplicity (L := L) (G := G) τ P := by
          rw [← simple_factor_multiplicity_eq_count (L := L) (G := G) τ N t
              ht_head
              (finiteLengthCompositionSeries_last (L := L) (G := G) N),
            ← simple_factor_multiplicity_eq_count (L := L) (G := G) τ P s
              (finiteLengthCompositionSeries_head (L := L) (G := G) P)
              hs_last]

/-- Helper for Proposition 14-14.1-1: an `L[G]`-linear equivalence of owner modules upgrades to a
representation equivalence. -/
private theorem nonempty_equiv_of_asModuleLinearEquiv
    {V : Type u} [AddCommGroup V] [Module L V]
    [FiniteDimensional L V]
    {W : Type u} [AddCommGroup W] [Module L W]
    [FiniteDimensional L W]
    {ρ : Representation L G V} {σ : Representation L G W}
    (e : ρ.asModule ≃ₗ[L[G]] σ.asModule) :
    Nonempty (ρ.Equiv σ) := by
  -- Compare both representations with the `ofModule'` models on their owner modules and use the
  -- given `L[G]`-linear equivalence as the middle intertwiner.
  rcases nonempty_equiv_of_ofModule'_asModule (L := L) (G := G) ρ with ⟨eρ⟩
  rcases nonempty_equiv_of_ofModule'_asModule (L := L) (G := G) σ with ⟨eσ⟩
  have emid :
      Nonempty ((Representation.ofModule' (k := L) (G := G) ρ.asModule).Equiv
        (Representation.ofModule' (k := L) (G := G) σ.asModule)) := by
    refine ⟨Representation.Equiv.mk (e.restrictScalars L) ?_⟩
    intro g
    ext x
    change e ((MonoidAlgebra.of L G g) • x) = (MonoidAlgebra.of L G g) • e x
    exact e.map_smul' (MonoidAlgebra.of L G g) x
  rcases emid with ⟨emid⟩
  exact ⟨eρ.symm.trans (emid.trans eσ)⟩

/-- Helper for Proposition 14-14.1-1: fixed-simple multiplicity packaged as an additive map on the
free abelian group generated by finite-dimensional representations. -/
private noncomputable abbrev simple_factor_multiplicity_lift
    (τ : FDRep L G) :
    FreeAbelianGroup (FDRep L G) →+ ℤ :=
  -- Evaluate Serre's counting functional on each generator by viewing the `FDRep` carrier as the
  -- corresponding `L[G]`-module.
  FreeAbelianGroup.lift fun σ ↦
    let ρσ : Representation L G σ := σ.ρ
    letI : Module L[G] σ := by
      simpa using (inferInstance : Module L[G] ρσ.asModule)
    letI : IsScalarTower L L[G] σ := by
      simpa using (inferInstance : IsScalarTower L L[G] ρσ.asModule)
    Int.ofNat (simple_factor_multiplicity (L := L) (G := G) τ σ)

/-- Helper for Proposition 14-14.1-1: fixed-simple multiplicity vanishes on the defining
Grothendieck relations. -/
private theorem finiteRepGrothendieckRelations_le_simple_factor_multiplicity_lift_ker
    (τ : FDRep L G) :
    finiteRepGrothendieckRelations L G ≤
      (simple_factor_multiplicity_lift (L := L) (G := G) τ).ker := by
  refine (AddSubgroup.closure_le _).2 ?_
  intro x hx
  rcases hx with ⟨⟨S, hS⟩, rfl⟩
  let ρ₁ : Representation L G S.X₁ := S.X₁.ρ
  let ρ₂ : Representation L G S.X₂ := S.X₂.ρ
  let ρ₃ : Representation L G S.X₃ := S.X₃.ρ
  letI : Module L[G] S.X₁ := by
    simpa using (inferInstance : Module L[G] ρ₁.asModule)
  letI : Module L[G] S.X₂ := by
    simpa using (inferInstance : Module L[G] ρ₂.asModule)
  letI : Module L[G] S.X₃ := by
    simpa using (inferInstance : Module L[G] ρ₃.asModule)
  letI : IsScalarTower L L[G] S.X₁ := by
    simpa using (inferInstance : IsScalarTower L L[G] ρ₁.asModule)
  letI : IsScalarTower L L[G] S.X₂ := by
    simpa using (inferInstance : IsScalarTower L L[G] ρ₂.asModule)
  letI : IsScalarTower L L[G] S.X₃ := by
    simpa using (inferInstance : IsScalarTower L L[G] ρ₃.asModule)
  let F : FDRep L G ⥤ ModuleCat L[G] :=
    forget₂ (FDRep L G) (Rep L G) ⋙ Rep.toModuleMonoidAlgebra (k := L) (G := G)
  let T : ShortComplex (ModuleCat L[G]) := S.map F
  have hT : T.ShortExact := hS.map_of_exact F
  let f : S.X₁ →ₗ[L[G]] S.X₂ := by
    simpa [T, F] using T.f.hom
  let g : S.X₂ →ₗ[L[G]] S.X₃ := by
    simpa [T, F] using T.g.hom
  have hf : Function.Injective f := by
    simpa [f] using hT.moduleCat_injective_f
  have hg : Function.Surjective g := by
    simpa [g] using hT.moduleCat_surjective_g
  have hfg : Function.Exact f g := by
    simpa [f, g] using
      (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact T).mp hT.exact
  have hadd :
      simple_factor_multiplicity (L := L) (G := G) τ S.X₂ =
        simple_factor_multiplicity (L := L) (G := G) τ S.X₁ +
          simple_factor_multiplicity (L := L) (G := G) τ S.X₃ := by
    -- Transport the defining short exact sequence to the owner `L[G]`-module carriers and apply
    -- the additivity of fixed-simple multiplicity.
    simpa using
      (simple_factor_multiplicity_eq_add_of_exact (L := L) (G := G) τ hf hg hfg)
  change
    simple_factor_multiplicity_lift (L := L) (G := G) τ
        (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  -- After evaluating the free-abelian-group lift on each generator, the exact-sequence
  -- additivity identity cancels the defining relation.
  simp [simple_factor_multiplicity_lift, hadd, sub_eq_add_neg,
    add_assoc, add_left_comm, add_comm]

/-- Helper for Proposition 14-14.1-1: the fixed-simple multiplicity descends to Serre's
Grothendieck group. -/
private noncomputable def simple_factor_multiplicity_hom
    (τ : FDRep L G) :
    R₀[L](G) →+ ℤ :=
  -- Quotient by the Grothendieck relations now that the lift kills every defining generator.
  QuotientAddGroup.lift
    (finiteRepGrothendieckRelations L G)
    (simple_factor_multiplicity_lift (L := L) (G := G) τ)
    (finiteRepGrothendieckRelations_le_simple_factor_multiplicity_lift_ker
      (L := L) (G := G) τ)

/-- Helper for Proposition 14-14.1-1: evaluating the descended multiplicity hom on a generator
class recovers the simple-factor multiplicity of the corresponding owner module. -/
@[simp] private theorem simple_factor_multiplicity_hom_finiteRepClass
    (τ σ : FDRep L G) :
    simple_factor_multiplicity_hom (L := L) (G := G) τ [σ]₀ =
      simple_factor_multiplicity_lift (L := L) (G := G) τ (FreeAbelianGroup.of σ) := by
  -- The quotient lift agrees with the original free-abelian-group lift on generators.
  simp [simple_factor_multiplicity_hom, finiteRepGrothendieckClass]

/-- Helper for Proposition 14-14.1-1: a subtype of `Fin 1` is either empty or has one element,
according to whether the unique index satisfies the defining predicate. -/
private theorem nat_card_subtype_fin_one_eq_ite
    (P : Fin 1 → Prop) [DecidablePred P] :
    Nat.card { i : Fin 1 // P i } = if P 0 then 1 else 0 := by
  classical
  by_cases h : P 0
  · have hAll : ∀ i : Fin 1, P i := by
      intro i
      simpa [Fin.eq_zero i] using h
    letI : Unique { i : Fin 1 // P i } :=
      ⟨⟨0, h⟩, fun x => by
        rcases x with ⟨i, hi⟩
        simp [Fin.eq_zero i]⟩
    simp [h]
  · have hNone : ∀ i : Fin 1, ¬ P i := by
      intro i
      simpa [Fin.eq_zero i] using h
    haveI : IsEmpty { i : Fin 1 // P i } := ⟨fun x => hNone x.1 x.2⟩
    simp [h]

/-- Helper for Proposition 14-14.1-1: an `L[G]`-linear equivalence between owner modules is exactly
an isomorphism in the finite-dimensional representation category. -/
private theorem nonempty_iso_iff_nonempty_fdRepAsModuleLinearEquiv
    {σ τ : FDRep L G} :
    Nonempty (σ ≅ τ) ↔
      Nonempty (fdRepAsModule (L := L) (G := G) σ ≃ₗ[L[G]]
        fdRepAsModule (L := L) (G := G) τ) := by
  constructor
  · intro hστ
    rcases hστ with ⟨e⟩
    -- Apply the module-valued equivalence functor to turn an isomorphism of representations into
    -- an `L[G]`-linear equivalence.
    exact
      ⟨(((forget₂ (FDRep L G) (Rep L G)) ⋙ Rep.toModuleMonoidAlgebra
        (k := L) (G := G)).mapIso e).toLinearEquiv⟩
  · intro hστ
    rcases hστ with ⟨e⟩
    -- Conversely, upgrade the owner-module equivalence to a representation equivalence.
    rcases
        nonempty_equiv_of_asModuleLinearEquiv (L := L) (G := G)
          (ρ := fdRepOwnerRepresentation (L := L) (G := G) σ)
          (σ := fdRepOwnerRepresentation (L := L) (G := G) τ) e with
      ⟨eρ⟩
    exact ⟨eρ.toFDRepIso⟩

/-- Helper for Proposition 14-14.1-1: the owner module of a simple finite-dimensional
representation has the two-step composition series `⊥ < ⊤`. -/
private noncomputable def simple_fdRep_compositionSeries
    (σ : FDRep L G) [Simple σ] :
    CompositionSeries (Submodule L[G] (fdRepAsModule (L := L) (G := G) σ)) := by
  let ρσ : Representation L G σ := σ.ρ
  letI : Module L[G] σ := by
    simpa using (inferInstance : Module L[G] ρσ.asModule)
  have hsimple : IsSimpleModule L[G] σ := by
    letI : Representation.IsIrreducible ρσ := by
      simpa [ρσ] using (FDRep.isIrreducible_of_simple σ)
    simpa using (Representation.irreducible_iff_isSimpleModule_asModule ρσ).mp inferInstance
  have hcov : (⊥ : Submodule L[G] σ) ⋖ ⊤ := by
    -- Route correction: execute Serre's explicit `⊥ < ⊤` series instead of introducing another
    -- abstract finite-length argument.
    rw [covBy_iff_quot_is_simple bot_le]
    let eTop :
        ((⊤ : Submodule L[G] σ) ⧸
          Submodule.comap (Submodule.subtype (⊤ : Submodule L[G] σ))
            (⊥ : Submodule L[G] σ)) ≃ₗ[L[G]] σ :=
      (Submodule.quotEquivOfEqBot _ (by simp)).trans Submodule.topEquiv
    exact (LinearEquiv.isSimpleModule_iff eTop).2 hsimple
  -- The owner carrier of `fdRepAsModule σ` is definitionally the same as the carrier `σ` with
  -- the transported `L[G]`-action, so the explicit two-step series can be reused verbatim.
  simpa [fdRepAsModule] using
    ((RelSeries.singleton _ (⊥ : Submodule L[G] σ)).snoc ⊤ hcov)

/-- Helper for Proposition 14-14.1-1: the unique factor in the simple two-step composition series
is the owner module itself. -/
private theorem simple_fdRep_compositionSeriesFactorEquiv
    (σ : FDRep L G) [Simple σ] :
    Nonempty (fdRepAsModule (L := L) (G := G) σ ≃ₗ[L[G]]
      fdRepAsModule (L := L) (G := G) σ) := by
  -- The ambient owner module is canonically linearly equivalent to itself.
  exact ⟨LinearEquiv.refl _ _⟩

/-- Helper for Proposition 14-14.1-1: the descended multiplicity hom evaluates on a simple class
as the expected Kronecker delta. -/
@[simp] private theorem simple_factor_multiplicity_hom_apply_simple
    (σ τ : FDRep L G) [Simple σ] [Decidable (Nonempty (σ ≅ τ))] :
    simple_factor_multiplicity_hom (L := L) (G := G) τ [σ]₀ =
      if Nonempty (σ ≅ τ) then 1 else 0 := by
  let ρσ : Representation L G σ := σ.ρ
  letI : Module L[G] σ := by
    simpa using (inferInstance : Module L[G] ρσ.asModule)
  letI : IsScalarTower L L[G] σ := by
    simpa using (inferInstance : IsScalarTower L L[G] ρσ.asModule)
  have hsimple : IsSimpleModule L[G] σ := by
    letI : Representation.IsIrreducible ρσ := by
      simpa [ρσ] using (FDRep.isIrreducible_of_simple σ)
    simpa using (Representation.irreducible_iff_isSimpleModule_asModule ρσ).mp inferInstance
  have hcov : (⊥ : Submodule L[G] σ) ⋖ ⊤ := by
    -- Route correction: compute the simple-case multiplicity on the explicit `⊥ < ⊤` series on
    -- the owner carrier `σ`.
    rw [covBy_iff_quot_is_simple bot_le]
    let eTop :
        ((⊤ : Submodule L[G] σ) ⧸
          Submodule.comap (Submodule.subtype (⊤ : Submodule L[G] σ))
            (⊥ : Submodule L[G] σ)) ≃ₗ[L[G]] σ :=
      (Submodule.quotEquivOfEqBot _ (by simp)).trans Submodule.topEquiv
    exact (LinearEquiv.isSimpleModule_iff eTop).2 hsimple
  let s : CompositionSeries (Submodule L[G] σ) :=
    (RelSeries.singleton _ (⊥ : Submodule L[G] σ)).snoc ⊤ hcov
  have hs_head : s.head = ⊥ := by
    simpa [s] using
      (RelSeries.head_snoc (RelSeries.singleton _ (⊥ : Submodule L[G] σ)) ⊤ hcov)
  have hs_last : s.last = ⊤ := by
    simpa [s] using
      (RelSeries.last_snoc (RelSeries.singleton _ (⊥ : Submodule L[G] σ)) ⊤ hcov)
  have hslen : s.length = 1 := by
    simp [s]
  let i0 : Fin s.length := hslen.symm ▸ (0 : Fin 1)
  have hmult :
      simple_factor_multiplicity (L := L) (G := G) τ σ =
        simple_factor_count (L := L) (G := G) τ s := by
    -- Replace the chosen Jordan-Hölder series by the explicit `⊥ < ⊤` series on the simple
    -- owner module.
    exact simple_factor_multiplicity_eq_count (L := L) (G := G) τ σ s hs_head hs_last
  have hfactor_equiv :
      compositionSeriesFactor (L := L) (G := G) s i0 ≃ₗ[L[G]]
        fdRepAsModule (L := L) (G := G) σ := by
    let eId : σ ≃ₗ[L[G]] fdRepAsModule (L := L) (G := G) σ := by
      simpa [fdRepAsModule] using (LinearEquiv.refl L[G] σ)
    simpa [s, i0, hslen, compositionSeriesFactor] using
      ((Submodule.quotEquivOfEqBot
          (Submodule.comap (Submodule.subtype (⊤ : Submodule L[G] σ))
            (⊥ : Submodule L[G] σ)) (by simp)).trans
        (Submodule.topEquiv.trans eId))
  have hmatch :
      compositionSeriesFactorMatches (L := L) (G := G) τ s i0 ↔
        Nonempty (σ ≅ τ) := by
    constructor
    · intro h
      rcases h with ⟨e⟩
      exact
        (nonempty_iso_iff_nonempty_fdRepAsModuleLinearEquiv (L := L) (G := G)
          (σ := σ) (τ := τ)).2 ⟨hfactor_equiv.symm.trans e⟩
    · intro h
      rcases
          (nonempty_iso_iff_nonempty_fdRepAsModuleLinearEquiv (L := L) (G := G)
            (σ := σ) (τ := τ)).1 h with
        ⟨e⟩
      exact ⟨hfactor_equiv.trans e⟩
  have hcount :
      simple_factor_count (L := L) (G := G) τ s =
        if Nonempty (σ ≅ τ) then 1 else 0 := by
    classical
    let P : Fin 1 → Prop := fun i ↦
      compositionSeriesFactorMatches (L := L) (G := G) τ s (hslen.symm ▸ i)
    let eCount :
        { i : Fin s.length // compositionSeriesFactorMatches (L := L) (G := G) τ s i } ≃
          { i : Fin 1 // P i } :=
      { toFun := fun i => ⟨Equiv.cast (congrArg Fin hslen) i.1, by simpa [P] using i.2⟩
        invFun := fun i => ⟨Equiv.cast (congrArg Fin hslen.symm) i.1, by simpa [P] using i.2⟩
        left_inv := fun i => by
          rcases i with ⟨i, hi⟩
          simp
        right_inv := fun i => by
          rcases i with ⟨i, hi⟩
          simp }
    have hP : ∀ i : Fin 1, P i ↔ Nonempty (σ ≅ τ) := by
      intro i
      have hi : i = 0 := Fin.eq_zero i
      subst i
      simpa [P, i0] using hmatch
    calc
      simple_factor_count (L := L) (G := G) τ s = Nat.card { i : Fin 1 // P i } := by
        rw [simple_factor_count]
        exact Nat.card_congr eCount
      _ = if P 0 then 1 else 0 := nat_card_subtype_fin_one_eq_ite P
      _ = if Nonempty (σ ≅ τ) then 1 else 0 := by
        simp [hP 0]
  -- Evaluate the descended map on `[σ]₀`, rewrite the multiplicity through the explicit simple
  -- two-step series, and then count the unique Jordan-Hölder factor.
  calc
    simple_factor_multiplicity_hom (L := L) (G := G) τ [σ]₀ =
        simple_factor_multiplicity_lift (L := L) (G := G) τ (FreeAbelianGroup.of σ) := by
          simp
    _ = Int.ofNat (simple_factor_multiplicity (L := L) (G := G) τ σ) := by
          simp [simple_factor_multiplicity_lift]
    _ = Int.ofNat (simple_factor_count (L := L) (G := G) τ s) := by
          rw [hmult]
    _ = if Nonempty (σ ≅ τ) then 1 else 0 := by
          simp [hcount]

-- Proof sketch: if a nontrivial integer relation among the classes of pairwise nonisomorphic
-- simple representations existed, evaluating multiplicities in Jordan-Hölder series would force
-- every coefficient to vanish.
/-- For a pairwise nonisomorphic family of simple finite-dimensional `L`-representations of `G`,
the corresponding classes in `R₀[L](G)` are `ℤ`-linearly independent. -/
theorem linearIndependent_simple_finiteRep_classes_of_pairwise_nonisomorphic
    (π : ι → FDRep L G)
    (hπ_simple : ∀ i, Simple (π i))
    (hπ_pairwise : PairwiseNonisomorphic π) :
    LinearIndependent ℤ (fun i ↦ [π i]₀) := by
  classical
  let f : ι → Module.Dual ℤ (R₀[L](G)) :=
    fun i ↦ (simple_factor_multiplicity_hom (L := L) (G := G) (π i)).toIntLinearMap
  -- The descended multiplicity maps form the dual family to the simple Grothendieck classes.
  refine LinearIndependent.of_pairwise_dual_eq_zero_one
    (fun i ↦ [π i]₀) f ?_ ?_
  · intro i j hij
    -- Distinct indices label nonisomorphic simples, so the `i`-th multiplicity map vanishes on
    -- the `j`-th simple class.
    letI : Simple (π i) := hπ_simple i
    letI : Simple (π j) := hπ_simple j
    have hnot : ¬ Nonempty (π j ≅ π i) := by
      intro hji
      exact hπ_pairwise (show j ≠ i from hij.symm) hji
    simpa [f, hnot] using
      (simple_factor_multiplicity_hom_apply_simple (L := L) (G := G)
        (σ := π j) (τ := π i))
  · intro i
    -- On its own generator, the multiplicity map returns `1`.
    letI : Simple (π i) := hπ_simple i
    have hself : Nonempty (π i ≅ π i) := ⟨Iso.refl _⟩
    simpa [f, hself] using
      (simple_factor_multiplicity_hom_apply_simple (L := L) (G := G)
        (σ := π i) (τ := π i))

-- Proof sketch: every class in `R₀[L](G)` is the alternating sum of composition factors of a
-- finite-dimensional representation, and completeness identifies each simple factor with some
-- member of `π`.
/-- For a complete irreducible family, the corresponding simple classes span all of `R₀[L](G)`. -/
theorem span_simple_finiteRep_classes_eq_top_of_complete_family
    (π : ι → FDRep L G)
    (hπ_complete : IsCompleteIrreducibleFamily π) :
    Submodule.span ℤ (Set.range fun i ↦ [π i]₀) = ⊤ := by
  let S : Submodule ℤ (R₀[L](G)) := Submodule.span ℤ (Set.range fun i ↦ [π i]₀)
  have hgenerator : ∀ V : FDRep L G, [V]₀ ∈ S := by
    intro V
    let ρV : Representation L G ↑V.V := V.ρ
    let _ : Module L[G] ↑V.V := by
      simpa [Representation.asModule] using (inferInstance : Module L[G] ρV.asModule)
    let _ : IsScalarTower L L[G] ↑V.V := by
      simpa [Representation.asModule] using
        (inferInstance : IsScalarTower L L[G] ρV.asModule)
    have htransport :
        [FDRep.of (Representation.ofModule' (k := L) (G := G) ↑V.V)]₀ = [FDRep.of ρV]₀ := by
      -- Recover the original representation from its owner module and identify the corresponding
      -- Grothendieck classes.
      rcases nonempty_equiv_of_ofModule'_asModule (L := L) (G := G) ρV with ⟨eρV⟩
      simpa using
        (finiteRepGrothendieckClass_eq_of_nonempty_iso (L := L) (G := G)
          (V := FDRep.of (Representation.ofModule' (k := L) (G := G) ↑V.V))
          (W := FDRep.of ρV) ⟨Representation.Equiv.toFDRepIso eρV⟩)
    -- First move to the canonical owner `FDRep.of V.ρ`, then apply the module-level spanning
    -- lemma through the `ofModule'` transport bridge.
    rw [finiteRepGrothendieckClass_eq_of_nonempty_iso (L := L) (G := G)
      (V := V) (W := FDRep.of V.ρ) ⟨fdRepIsoOfRho (L := L) (G := G) V⟩]
    rw [← htransport]
    simpa [S] using
      (finiteRepGrothendieckClass_ofModule'_mem_span_simple_classes_of_complete_family
        (L := L) (G := G) π hπ_complete ↑V.V)
  -- Descend from generator classes of the free abelian group presentation.
  refine top_unique ?_
  intro z hz
  refine QuotientAddGroup.induction_on z ?_
  intro a
  refine FreeAbelianGroup.induction_on a ?_ ?_ ?_ ?_
  · exact Submodule.zero_mem S
  · intro V
    simpa [S, finiteRepGrothendieckClass] using hgenerator V
  · intro V hV
    simpa [S] using Submodule.neg_mem S hV
  · intro a b ha hb
    simpa [S] using Submodule.add_mem S ha hb

/-- Proposition 14-14.1-1: if `π` is a complete family of pairwise nonisomorphic simple
finite-dimensional `L`-representations of `G`, then their classes form a `ℤ`-basis of Serre's
Grothendieck group `R_L(G)`, realized here as `R₀[L](G)`. -/
def simple_finiteRep_classes_basis_of_complete_family
    (π : ι → FDRep L G)
    (hπ_pairwise : PairwiseNonisomorphic π)
    (hπ_complete : IsCompleteIrreducibleFamily π) :
    Module.Basis ι ℤ (R₀[L](G)) :=
  Module.Basis.mk
    (linearIndependent_simple_finiteRep_classes_of_pairwise_nonisomorphic
      π hπ_complete.isSimple hπ_pairwise)
    (span_simple_finiteRep_classes_eq_top_of_complete_family π hπ_complete).ge

/-- Evaluating the basis from Proposition `14-14.1-1` at `i` returns the class of `π i`. -/
@[simp] theorem simple_finiteRep_classes_basis_of_complete_family_apply
    (π : ι → FDRep L G)
    (hπ_pairwise : PairwiseNonisomorphic π)
    (hπ_complete : IsCompleteIrreducibleFamily π)
    (i : ι) :
    simple_finiteRep_classes_basis_of_complete_family π hπ_pairwise hπ_complete i = [π i]₀ := by
  simp [simple_finiteRep_classes_basis_of_complete_family]

/-- Helper for Proposition 14-14.1-1: in the simple-class basis attached to a complete
pairwise-nonisomorphic family, the coordinates of an honest finite-dimensional representation
class are nonnegative Jordan-Hölder multiplicities. -/
theorem simple_finiteRep_classes_basis_repr_class_nonneg
    (π : ι → FDRep L G)
    (hπ_pairwise : PairwiseNonisomorphic π)
    (hπ_complete : IsCompleteIrreducibleFamily π)
    (V : FDRep L G) (i : ι) :
    0 ≤
      (simple_finiteRep_classes_basis_of_complete_family
        π hπ_pairwise hπ_complete).repr [V]₀ i := by
  classical
  let b :=
    simple_finiteRep_classes_basis_of_complete_family
      π hπ_pairwise hπ_complete
  let coord : R₀[L](G) →+ ℤ :=
    { toFun := fun x ↦ b.repr x i
      map_zero' := by simp
      map_add' := by
        intro x y
        simp }
  have hbasis :
      ∀ j, simple_factor_multiplicity_hom (L := L) (G := G) (π i) (b j) =
        coord (b j) := by
    intro j
    letI : Simple (π j) := hπ_complete.isSimple j
    have hleft :
        simple_factor_multiplicity_hom (L := L) (G := G) (π i) (b j) =
          if j = i then 1 else 0 := by
      have hdelta :
          (if Nonempty (π j ≅ π i) then 1 else 0 : ℤ) =
            if j = i then 1 else 0 := by
        by_cases hji : j = i
        · subst hji
          simp
        · have hnot : ¬ Nonempty (π j ≅ π i) := by
            intro h
            exact hπ_pairwise hji h
          simp [hji, hnot]
      simpa [b, simple_finiteRep_classes_basis_of_complete_family_apply, hdelta] using
        (simple_factor_multiplicity_hom_apply_simple
          (L := L) (G := G) (σ := π j) (τ := π i))
    have hright : coord (b j) = if j = i then 1 else 0 := by
      have hb : b.repr (b j) = Finsupp.single j (1 : ℤ) := by
        simpa using b.repr_self j
      have hbi := congrArg (fun c : ι →₀ ℤ ↦ c i) hb
      simpa [coord, Finsupp.single_apply] using hbi
    exact hleft.trans hright.symm
  have hhom :
      (simple_factor_multiplicity_hom (L := L) (G := G) (π i)).toIntLinearMap =
        coord.toIntLinearMap := by
    apply b.ext
    intro j
    exact hbasis j
  have hcoord :
      b.repr [V]₀ i =
        simple_factor_multiplicity_hom (L := L) (G := G) (π i) [V]₀ := by
    have h :=
      congrArg (fun f : R₀[L](G) →ₗ[ℤ] ℤ ↦ f [V]₀) hhom
    simpa [coord] using h.symm
  rw [hcoord, simple_factor_multiplicity_hom_finiteRepClass]
  -- The multiplicity lift evaluates to `Int.ofNat` of a composition-factor count.
  simp [simple_factor_multiplicity_lift]

end Basis
end GrothendieckGroup

