section GrothendieckGroup

variable (L : Type u) [Field L] (G : Type u) [Monoid G]

/-
Domain-style sampling for this item:
* source-facing owners introduced here: `finiteRepGrothendieckGroup L G` and
  `finiteRepGrothendieckClass`.
* upstream core/canonical owner reused throughout the basis layer: `IsCompleteIrreducibleFamily π`
  from Chapter `2`.
* chapter basis style for this domain: prove `LinearIndependent`, prove `span = ⊤`, then package
  the resulting owner with `Module.Basis.mk`.

Primitive data vs derived API:
* primitive data: the short-exact-sequence relations defining `R₀[L](G)` and the complete
  irreducible family owner.
* derived API: the short-exact relation in the quotient, the linear-independence and spanning
  theorems, and the resulting simple-class basis.
-/

/-- The subgroup of the free abelian group on finite-dimensional `L`-representations generated by
the short-exact-sequence relations `[Y] - [X] - [Z]`, indexed by short exact short complexes in
`FDRep L G`. -/
def finiteRepGrothendieckRelations : AddSubgroup (FreeAbelianGroup (FDRep L G)) :=
  AddSubgroup.closure <|
    Set.range fun S : { S : ShortComplex (FDRep L G) // S.ShortExact } ↦
      FreeAbelianGroup.of S.1.X₂ - FreeAbelianGroup.of S.1.X₁ - FreeAbelianGroup.of S.1.X₃

/-- Serre's Grothendieck group `R_L(G)`, realized as the quotient of the free abelian group on
finite-dimensional `L`-representations by the short-exact-sequence relations. Lean writes this
owner as `R₀[L](G)` to keep it distinct from the Chapter `12` character-ring notation
`R[L](G)`. -/
abbrev finiteRepGrothendieckGroup :=
  FreeAbelianGroup (FDRep L G) ⧸ finiteRepGrothendieckRelations L G

scoped[Representation] notation:max "R₀[" L "](" G ")" =>
  finiteRepGrothendieckGroup L G

/-- The class of a finite-dimensional `L`-representation in Serre's Grothendieck group
`R_L(G)`. -/
def finiteRepGrothendieckClass (V : FDRep L G) :
    R₀[L](G) :=
  QuotientAddGroup.mk' (finiteRepGrothendieckRelations L G) (FreeAbelianGroup.of V)

scoped[Representation] notation:max "[" V "]₀" =>
  @finiteRepGrothendieckClass _ _ _ _ V

open scoped Representation
open scoped ZeroObject
open scoped MonoidAlgebra
