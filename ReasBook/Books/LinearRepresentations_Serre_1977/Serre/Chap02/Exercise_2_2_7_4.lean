open scoped MonoidAlgebra
open scoped Representation.ExplicitDecomposition

noncomputable section

universe u v w x y

namespace Representation

section

variable {k : Type v} [CommSemiring k]
variable {G : Type u} [Monoid G]
variable {V : Type w} [AddCommMonoid V] [Module k V]

/-- The smallest subrepresentation `V(x)` containing a vector `x`, realized as the cyclic
subrepresentation generated by `x`. -/
abbrev cyclicSubrepresentation (ρ : Representation k G V) (x : V) : Subrepresentation ρ :=
  Subrepresentation.ofSubmodule' (Submodule.span k[G] {ρ.asModuleEquiv.symm x})

scoped[Representation.ExplicitDecomposition] notation3 "V⟮" ρ "⟯" =>
  Representation.cyclicSubrepresentation ρ

-- Proof sketch: `V⟮ρ⟯ x` is defined as the `k[G]`-span of the singleton `{x}`, so the
-- generator itself belongs to that span.
/-- The generator `x` lies in its cyclic subrepresentation `V(x)`. -/
theorem mem_cyclicSubrepresentation (ρ : Representation k G V) (x : V) :
    x ∈ V⟮ρ⟯ x := by
  change ρ.asModuleEquiv.symm x ∈ Submodule.span k[G] {ρ.asModuleEquiv.symm x}
  exact Submodule.mem_span_singleton_self _

/-- Helper for Exercise 2-2.7-4: the cyclic subrepresentation is the smallest stable subspace
containing its generator. -/
theorem cyclicSubrepresentation_le_of_mem
    (ρ : Representation k G V) {x : V} (U : Subrepresentation ρ)
    (hx : x ∈ U.toSubmodule) :
    V⟮ρ⟯ x ≤ U := by
  -- The `k[G]`-span of `{x}` is contained in every stable subspace containing `x`.
  change Submodule.span k[G] ({ρ.asModuleEquiv.symm x} : Set ρ.asModule) ≤ U.asSubmodule
  refine Submodule.span_le.2 ?_
  intro y hy
  rcases hy with rfl
  simpa using hx

end

namespace ExplicitDecomposition

private theorem finset_sup_toSubmodule
    {G : Type u} [Group G]
    {V : Type w} [AddCommGroup V] [Module ℂ V]
    (ρ : Representation ℂ G V) {κ : Type*} (s : Finset κ) (f : κ → Subrepresentation ρ) :
    (s.sup f).toSubmodule = s.sup (fun i ↦ (f i).toSubmodule) := by
  classical
  refine Finset.induction_on s ?_ ?_
  · rfl
  · intro a s ha hs
    simp [Finset.sup_insert, hs]

section

variable {G : Type u} [Group G]
variable [Finite G]
variable {V : Type w} [AddCommGroup V] [Module ℂ V]
variable {W : Type x} [AddCommGroup W] [Module ℂ W]
variable {ι : Type y} [Fintype ι]
local instance : DecidableEq ι := Classical.decEq ι

-- Proof sketch: decompose `x ∈ V_i` along the internal direct sum of the coordinate subspaces
-- `V_{i,β}` from Proposition `2-2.7-1`; on each summand, `p_{1α}` either vanishes or lands in
-- `V_{i,1}`, so the whole image lies in `V_{i,1}`.
/-- Applying `p_{1α}` to a vector of the `i`-isotypic piece produces a vector in the first
coordinate subspace `V_{i,1}`. -/
theorem matrixUnit_apply_mem_firstCoordinate
    (ρ : Representation ℂ G V) (σ : Representation ℂ G W) [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (x : (ρ.isotypicSubrepresentation σ).toSubmodule) (α : ι) :
    p⟮ρ,σ,basis⟯ oneIndex α x ∈ V⟮ρ,σ,basis⟯ oneIndex := by
  -- The matrix-unit identity `p_{11} ∘ p_{1α} = p_{1α}` places the image in the range of
  -- the diagonal projector defining `V_{i,1}`.
  refine LinearMap.mem_range.mpr ?_
  refine ⟨p⟮ρ,σ,basis⟯ oneIndex α x, ?_⟩
  simpa [LinearMap.comp_apply] using
    congrArg (fun f : Module.End ℂ V ↦ f x)
      (matrixUnit_comp ρ σ basis oneIndex oneIndex oneIndex α rfl)

/-- Helper for Exercise 2-2.7-4: every matrix-unit image of `x` lies in the cyclic
subrepresentation generated by `x`. -/
theorem matrixUnit_apply_mem_cyclicSubrepresentation
    (ρ : Representation ℂ G V) (σ : Representation ℂ G W)
    (basis : Module.Basis ι ℂ W)
    (x : (ρ.isotypicSubrepresentation σ).toSubmodule) (α β : ι) :
    p⟮ρ,σ,basis⟯ α β x ∈ V⟮ρ⟯ x := by
  -- Expand the matrix unit as a finite linear combination of translates of the generator `x`.
  let U : Subrepresentation ρ := V⟮ρ⟯ x
  have hx : (x : V) ∈ U.toSubmodule := mem_cyclicSubrepresentation ρ (x : V)
  have hsum :
      (∑ s : G, (basis.repr (σ s⁻¹ (basis α))) β • ρ s x) ∈ U.toSubmodule := by
    exact U.toSubmodule.sum_mem fun s _ ↦
      U.toSubmodule.smul_mem _ (U.apply_mem_toSubmodule s hx)
  simpa [Representation.ExplicitDecomposition.matrixUnit, Finset.smul_sum, smul_smul,
    mul_assoc, mul_left_comm, mul_comm] using
    U.toSubmodule.smul_mem (((Fintype.card ι : ℂ) / Nat.card G)) hsum

/-- The coordinate vector `x_1^α = p_{1α}(x)` attached to a vector `x ∈ V_i`. -/
def firstCoordinateVector
    (ρ : Representation ℂ G V) (σ : Representation ℂ G W) [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (x : (ρ.isotypicSubrepresentation σ).toSubmodule) (α : ι) :
    V⟮ρ,σ,basis⟯ oneIndex :=
  ⟨p⟮ρ,σ,basis⟯ oneIndex α x,
    matrixUnit_apply_mem_firstCoordinate ρ σ basis oneIndex x α⟩

section FirstCoordinateVectorNotation

variable (ρ : Representation ℂ G V) (σ : Representation ℂ G W) [σ.IsIrreducible]
variable (basis : Module.Basis ι ℂ W) (oneIndex : ι)

-- Lean tokenizes `x₁` as a single identifier, so the closest parsable surface to the textbook
-- notation `x_1^α` is `x₍1₎^α`.
local notation:max x "₍1₎^" α:max => firstCoordinateVector ρ σ basis oneIndex x α

/-- Helper for Exercise 2-2.7-4: each generated copy `W(x_1^α)` is contained in the cyclic
subrepresentation generated by `x`. -/
theorem generatedSubrepresentation_le_cyclicSubrepresentation
    (x : (ρ.isotypicSubrepresentation σ).toSubmodule) (α : ι) :
    W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α) ≤ V⟮ρ⟯ x := by
  -- Every generator of `W(x_1^α)` is a matrix-unit image `p_{βα} x`, hence belongs to `V(x)`.
  intro y hy
  rcases LinearMap.mem_range.mp hy with ⟨w, rfl⟩
  change coordinateFamilyMap ρ σ basis oneIndex (x₍1₎^α) w ∈ V⟮ρ⟯ x
  have hw_expand :
      coordinateFamilyMap ρ σ basis oneIndex (x₍1₎^α) w =
        ∑ β : ι,
          (basis.repr w β) •
            coordinateVector ρ σ basis oneIndex (x₍1₎^α) β := by
    simpa [coordinateFamilyMap] using
      (basis.constr_apply_fintype ℂ (coordinateVector ρ σ basis oneIndex (x₍1₎^α)) w)
  rw [hw_expand]
  refine Submodule.sum_mem _ ?_
  intro β hβ
  refine Submodule.smul_mem _ _ ?_
  have hcompose :
      p⟮ρ,σ,basis⟯ β oneIndex ((x₍1₎^α : V)) =
        p⟮ρ,σ,basis⟯ β α x := by
    -- Collapse the two matrix units `p_{β1}` and `p_{1α}` into `p_{βα}`.
    change p⟮ρ,σ,basis⟯ β oneIndex (p⟮ρ,σ,basis⟯ oneIndex α x) =
      p⟮ρ,σ,basis⟯ β α x
    simpa [LinearMap.comp_apply] using
      congrArg (fun f : Module.End ℂ V ↦ f x)
        (matrixUnit_comp ρ σ basis β oneIndex oneIndex α rfl)
  simpa [coordinateVector, hcompose] using
    matrixUnit_apply_mem_cyclicSubrepresentation ρ σ basis x β α

/-- Helper for Exercise 2-2.7-4: applying `p_{1η}` to the coordinate vector `p_{α1}(x₁)` either
returns `x₁` or vanishes, depending on whether `η = α`. -/
private theorem reverse_matrixUnit_apply_coordinateVector_local
    (η α : ι)
    (x₁ : V⟮ρ,σ,basis⟯ oneIndex) :
    p⟮ρ,σ,basis⟯ oneIndex η (coordinateVector ρ σ basis oneIndex x₁ α) =
      if η = α then x₁ else 0 := by
  -- Apply the matrix-unit composition law to `p_{1η} ∘ p_{α1}` and use that `x₁` is already in
  -- the image of `p_{11}`.
  by_cases hηα : η = α
  · subst η
    have hx₁_fix : p⟮ρ,σ,basis⟯ oneIndex oneIndex (x₁ : V) = x₁ := by
      obtain ⟨u, hu⟩ := LinearMap.mem_range.mp x₁.2
      calc
        p⟮ρ,σ,basis⟯ oneIndex oneIndex (x₁ : V)
            = p⟮ρ,σ,basis⟯ oneIndex oneIndex (p⟮ρ,σ,basis⟯ oneIndex oneIndex u) := by
                rw [hu]
        _ = p⟮ρ,σ,basis⟯ oneIndex oneIndex u := by
              simpa [LinearMap.comp_apply] using
                congrArg (fun f : Module.End ℂ V ↦ f u)
                  (matrixUnit_comp ρ σ basis oneIndex oneIndex oneIndex oneIndex rfl)
        _ = x₁ := hu
    calc
      p⟮ρ,σ,basis⟯ oneIndex α (coordinateVector ρ σ basis oneIndex x₁ α)
          = p⟮ρ,σ,basis⟯ oneIndex oneIndex (x₁ : V) := by
              simpa [coordinateVector, LinearMap.comp_apply] using
                congrArg (fun f : Module.End ℂ V ↦ f x₁)
                  (matrixUnit_comp ρ σ basis oneIndex α α oneIndex rfl)
      _ = x₁ := hx₁_fix
      _ = if α = α then x₁ else 0 := by simp
  · simpa [coordinateVector, hηα, LinearMap.comp_apply] using
      congrArg (fun f : Module.End ℂ V ↦ f x₁)
        (matrixUnit_comp_eq_zero_of_ne ρ σ basis oneIndex η α oneIndex hηα)

/-- Helper for Exercise 2-2.7-4: applying `p_{1η}` to a vector in `W(x₁)` extracts the `η`-th
basis coefficient of the model vector. -/
private theorem reverse_matrixUnit_apply_coordinateFamilyMap_local
    (η : ι)
    (x₁ : V⟮ρ,σ,basis⟯ oneIndex) (w : W) :
    p⟮ρ,σ,basis⟯ oneIndex η (coordinateFamilyMap ρ σ basis oneIndex x₁ w) =
      (basis.repr w η) • (x₁ : V) := by
  -- Expand the basis-constrained map and isolate each basis vector with the reverse matrix unit.
  have hw_expand :
      coordinateFamilyMap ρ σ basis oneIndex x₁ w =
        ∑ x : ι, (basis.repr w x) • coordinateVector ρ σ basis oneIndex x₁ x := by
    simpa [coordinateFamilyMap] using
      (basis.constr_apply_fintype ℂ (coordinateVector ρ σ basis oneIndex x₁) w)
  rw [hw_expand]
  calc
    p⟮ρ,σ,basis⟯ oneIndex η
        (∑ x : ι, (basis.repr w x) • coordinateVector ρ σ basis oneIndex x₁ x)
        = ∑ x : ι, (basis.repr w x) •
            p⟮ρ,σ,basis⟯ oneIndex η (coordinateVector ρ σ basis oneIndex x₁ x) := by
              simp [map_sum, map_smul]
    _ = ∑ x, (basis.repr w x) • ↑(if η = x then x₁ else 0) := by
          apply Finset.sum_congr rfl
          intro x hx
          rw [reverse_matrixUnit_apply_coordinateVector_local]
    _ = ∑ x, if η = x then (basis.repr w x) • (x₁ : V) else 0 := by
          apply Finset.sum_congr rfl
          intro x hx
          by_cases hηx : η = x <;> simp [hηx]
    _ = (basis.repr w η) • (x₁ : V) := by
          simp

/-- Helper for Exercise 2-2.7-4: linearly independent first-coordinate vectors generate
pairwise independent copies `W(u k)`. -/
theorem iSupIndep_generatedSubrepresentations_of_linearIndependent
    {κ : Type*} (u : κ → V⟮ρ,σ,basis⟯ oneIndex)
    (hu : LinearIndependent ℂ u) :
    iSupIndep
      (fun k : κ ↦ (W⟮ρ,σ,basis,oneIndex⟯ (u k)).toSubmodule) := by
  classical
  -- Route correction: coefficient isolation only needs linear independence of `u`, not a basis of
  -- the whole first-coordinate space.
  rw [iSupIndep_iff_finset_sum_eq_zero_imp_eq_zero]
  intro s v hv hsum k hk
  let w : κ → W := fun i ↦
    if hi : i ∈ s then Classical.choose (LinearMap.mem_range.mp (hv i hi)) else 0
  have hw :
      ∀ i ∈ s, coordinateFamilyMap ρ σ basis oneIndex (u i) (w i) = v i := by
    intro i hi
    simpa [w, hi] using Classical.choose_spec (LinearMap.mem_range.mp (hv i hi))
  have hsum_w :
      ∑ i ∈ s, coordinateFamilyMap ρ σ basis oneIndex (u i) (w i) = 0 := by
    calc
      ∑ i ∈ s, coordinateFamilyMap ρ σ basis oneIndex (u i) (w i)
          = ∑ i ∈ s, v i := by
              apply Finset.sum_congr rfl
              intro i hi
              exact hw i hi
      _ = 0 := hsum
  have hcoeff :
      ∀ η : ι, basis.repr (w k) η = 0 := by
    intro η
    have happly := congrArg (p⟮ρ,σ,basis⟯ oneIndex η) hsum_w
    have happly_sub :
        (∑ i ∈ s, (basis.repr (w i) η) • u i : V⟮ρ,σ,basis⟯ oneIndex) = 0 := by
      apply Subtype.ext
      simpa [map_sum, map_smul, reverse_matrixUnit_apply_coordinateFamilyMap_local] using happly
    exact (linearIndependent_iff'.mp hu) s
      (fun i ↦ (basis.repr (w i) η)) happly_sub k hk
  have hwk_repr : basis.repr (w k) = 0 := by
    ext η
    exact hcoeff η
  have hwk : w k = 0 := by
    apply basis.repr.injective
    simpa using hwk_repr
  calc
    v k = coordinateFamilyMap ρ σ basis oneIndex (u k) (w k) := by
            symm
            exact hw k hk
    _ = 0 := by
          simp [hwk]

end FirstCoordinateVectorNotation

/-- Helper for Exercise 2-2.7-4: if `x₁` lies in the span of a family `u`, then `W(x₁)` lies in
the sum of the corresponding copies `W(u k)`. -/
theorem generatedSubrepresentation_le_iSup_of_mem_span
    (ρ : Representation ℂ G V) (σ : Representation ℂ G W)
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    {κ : Type*} (u : κ → V⟮ρ,σ,basis⟯ oneIndex)
    {x₁ : V⟮ρ,σ,basis⟯ oneIndex}
    (hx₁ : x₁ ∈ Submodule.span ℂ (Set.range u)) :
    (W⟮ρ,σ,basis,oneIndex⟯ x₁).toSubmodule ≤
      iSup (fun k : κ ↦ (W⟮ρ,σ,basis,oneIndex⟯ (u k)).toSubmodule) := by
  intro y hy
  rcases LinearMap.mem_range.mp hy with ⟨w, rfl⟩
  change coordinateFamilyMap ρ σ basis oneIndex x₁ w ∈
    iSup (fun k : κ ↦ (W⟮ρ,σ,basis,oneIndex⟯ (u k)).toSubmodule)
  have hw_expand :
      coordinateFamilyMap ρ σ basis oneIndex x₁ w =
        ∑ α : ι, (basis.repr w α) • coordinateVector ρ σ basis oneIndex x₁ α := by
    simpa [coordinateFamilyMap] using
      (basis.constr_apply_fintype ℂ (coordinateVector ρ σ basis oneIndex x₁) w)
  rw [hw_expand]
  refine Submodule.sum_mem _ ?_
  intro α hα
  refine Submodule.smul_mem _ _ ?_
  have hcoord_aux :
      ∀ z : V⟮ρ,σ,basis⟯ oneIndex, z ∈ Submodule.span ℂ (Set.range u) →
        p⟮ρ,σ,basis⟯ α oneIndex (z : V) ∈
          iSup (fun k : κ ↦ (W⟮ρ,σ,basis,oneIndex⟯ (u k)).toSubmodule) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
        rcases hz with ⟨k, rfl⟩
        exact Submodule.mem_iSup_of_mem k <| by
          refine LinearMap.mem_range.mpr ?_
          refine ⟨basis α, ?_⟩
          simp [coordinateFamilyHom, coordinateFamilyMap, coordinateVector]
    | zero =>
        simp
    | add y₁ y₂ hy₁ hy₂ ih₁ ih₂ =>
        simpa [map_add] using Submodule.add_mem _ ih₁ ih₂
    | smul c z hz ih =>
        simpa [map_smul] using Submodule.smul_mem _ c ih
  have hcoord :
      p⟮ρ,σ,basis⟯ α oneIndex (x₁ : V) ∈
        iSup (fun k : κ ↦ (W⟮ρ,σ,basis,oneIndex⟯ (u k)).toSubmodule) :=
    hcoord_aux x₁ hx₁
  simpa [coordinateVector] using hcoord

section FirstCoordinateVectorNotation

variable (ρ : Representation ℂ G V) (σ : Representation ℂ G W) [σ.IsIrreducible]
variable (basis : Module.Basis ι ℂ W) (oneIndex : ι)

local notation:max x "₍1₎^" α:max => firstCoordinateVector ρ σ basis oneIndex x α

/-- Helper for Exercise 2-2.7-4: on underlying `ℂ`-submodules, the cyclic representation `V(x)`
is the sum of the copies `W(x_1^α)`. -/
private theorem cyclicSubrepresentation_toSubmodule_eq_iSup_generatedSubrepresentations_aux
    (x : (ρ.isotypicSubrepresentation σ).toSubmodule) :
    (V⟮ρ⟯ x).toSubmodule =
      iSup
        (fun α : ι ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) := by
  apply le_antisymm
  · -- Put the generator into the `iSup`, then use minimality of the cyclic span.
    have hxsum :
        (x : V) ∈ iSup
          (fun α : ι ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) := by
      have hfix :
          (∑ α : ι, p⟮ρ,σ,basis⟯ α α) x = x :=
        (LinearMap.IsProj.mem_iff_map_id
          (sum_diagonal_matrixUnit_isProj_isotypicSubrepresentation ρ σ basis)).1 x.2
      rw [← hfix]
      have hsum_mem :
          (∑ α : ι, p⟮ρ,σ,basis⟯ α α x) ∈
            iSup (fun α : ι ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) := by
        refine Submodule.sum_mem _ ?_
        intro α hα
        refine Submodule.mem_iSup_of_mem α ?_
        refine LinearMap.mem_range.mpr ?_
        refine ⟨basis α, ?_⟩
        -- The `α`-th basis vector maps to `p_{α1}(x_1^α) = p_{αα}(x)`.
        calc
          coordinateFamilyMap ρ σ basis oneIndex (x₍1₎^α) (basis α)
              = p⟮ρ,σ,basis⟯ α oneIndex ((x₍1₎^α : V)) := by
                    simp [coordinateFamilyMap, coordinateVector]
          _ = p⟮ρ,σ,basis⟯ α α x := by
                change p⟮ρ,σ,basis⟯ α oneIndex (p⟮ρ,σ,basis⟯ oneIndex α x) =
                  p⟮ρ,σ,basis⟯ α α x
                simpa [LinearMap.comp_apply] using
                  congrArg (fun f : Module.End ℂ V ↦ f x)
                    (matrixUnit_comp ρ σ basis α oneIndex oneIndex α rfl)
      simpa [Finset.sum_apply] using hsum_mem
    let U : Subrepresentation ρ :=
      Finset.univ.sup (fun α : ι ↦ W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α))
    have hxU : (x : V) ∈ U.toSubmodule := by
      change (x : V) ∈ (Finset.univ.sup
        (fun α : ι ↦ W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α))).toSubmodule
      rw [finset_sup_toSubmodule ρ Finset.univ (fun α : ι ↦ W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α))]
      simpa [Finset.sup_univ_eq_iSup] using hxsum
    have hle : V⟮ρ⟯ x ≤ U := cyclicSubrepresentation_le_of_mem ρ U hxU
    have hsub :
        (V⟮ρ⟯ x).toSubmodule ≤
          (Finset.univ.sup (fun α : ι ↦ W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α))).toSubmodule :=
      hle
    rw [finset_sup_toSubmodule ρ Finset.univ (fun α : ι ↦ W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α))] at hsub
    simpa [Finset.sup_univ_eq_iSup] using hsub
  · -- Each copy `W(x_1^α)` is generated by matrix-unit images of `x`, so it lies in `V(x)`.
    refine iSup_le ?_
    intro α
    exact generatedSubrepresentation_le_cyclicSubrepresentation ρ σ basis oneIndex x α

-- Proof sketch: use the decomposition of `x` given by the diagonal matrix units
-- `p_{αα}` and rewrite each component as lying in the subrepresentation generated by
-- `x_1^α = p_{1α}(x)`. The converse inclusion follows because each `W(x_1^α)` contains the
-- vector `p_{α1}(x_1^α) = p_{αα}(x)` and is stable under the ambient representation.
/-- Exercise 2-2.7-4: for `x ∈ V_i`, the cyclic subrepresentation `V(x)` is the sum of the
subrepresentations `W(x_1^α)` attached to the first-coordinate images `x_1^α = p_{1α}(x)`. -/
theorem cyclicSubrepresentation_eq_sup_generatedSubrepresentations
    (x : (ρ.isotypicSubrepresentation σ).toSubmodule) :
    V⟮ρ⟯ x =
      Finset.univ.sup (fun α : ι ↦ W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)) := by
    -- Compare subrepresentations by comparing their underlying `ℂ`-submodules.
    apply Subrepresentation.toSubmodule_injective
    calc
      (V⟮ρ⟯ x).toSubmodule
          = iSup (fun α : ι ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) :=
            cyclicSubrepresentation_toSubmodule_eq_iSup_generatedSubrepresentations_aux
              ρ σ basis oneIndex x
      _ = Finset.univ.sup (fun α : ι ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) := by
              symm
              exact Finset.sup_univ_eq_iSup _
      _ = (Finset.univ.sup (fun α : ι ↦ W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α))).toSubmodule := by
            symm
            exact finset_sup_toSubmodule ρ Finset.univ (fun α : ι ↦ W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α))

/-- The underlying `ℂ[G]`-submodule of `V(x)` is the sum of the underlying submodules of the
subrepresentations `W(x_1^α)`. -/
theorem cyclicSubrepresentation_toSubmodule_eq_iSup_generatedSubrepresentations
    (x : (ρ.isotypicSubrepresentation σ).toSubmodule) :
    (V⟮ρ⟯ x).toSubmodule =
      iSup
        (fun α : ι ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) := by
    exact cyclicSubrepresentation_toSubmodule_eq_iSup_generatedSubrepresentations_aux
      ρ σ basis oneIndex x

-- Proof sketch: the vectors `x_1^α` span a subspace of `V_{i,1}` generated by at most
-- `Fintype.card ι` vectors, so choose a basis indexed by a finite subset of `ι`.
-- Proposition `2-2.7-1` applied to that basis gives `iSupIndep` for the corresponding
-- `W(x_1^α)`, and the preceding theorem identifies their sum with `V(x)`.
/-- The cyclic subrepresentation generated by `x` is the sum of finitely many pairwise independent
subrepresentations `W(x_1^α)`, each equivariantly isomorphic to the model representation `W_i`. -/
theorem exists_finset_generatedSubrepresentations_iSupIndep_eq_cyclicSubrepresentation
    (x : (ρ.isotypicSubrepresentation σ).toSubmodule) :
    ∃ s : Finset ι,
      ∃ _ :
        ∀ α : s,
          σ.Equiv (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toRepresentation,
      iSupIndep
        (fun α : s ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) ∧
      iSup
          (fun α : s ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) =
        (V⟮ρ⟯ x).toSubmodule := by
  classical
  let v : ι → V⟮ρ,σ,basis⟯ oneIndex := fun α ↦ x₍1₎^α
  obtain ⟨κ, a, ha, hspan, hlin⟩ := exists_linearIndependent' ℂ v
  letI : Finite κ := Finite.of_injective a ha
  letI : Fintype κ := Fintype.ofFinite κ
  let s : Finset ι := Finset.univ.image a
  let eκs : κ ≃ s :=
    Equiv.ofBijective
      (fun k ↦ ⟨a k, Finset.mem_image.mpr ⟨k, Finset.mem_univ k, rfl⟩⟩)
      ⟨by
          intro k₁ k₂ hk
          exact ha (congrArg Subtype.val hk),
        by
          intro α
          rcases Finset.mem_image.mp α.2 with ⟨k, hk, hka⟩
          refine ⟨k, Subtype.ext ?_⟩
          exact hka⟩
  have hindκ :
      iSupIndep
        (fun k : κ ↦
          (W⟮ρ,σ,basis,oneIndex⟯ (v (a k))).toSubmodule) :=
    iSupIndep_generatedSubrepresentations_of_linearIndependent ρ σ basis oneIndex (v ∘ a) hlin
  have hind_s :
      iSupIndep
        (fun α : s ↦
          (W⟮ρ,σ,basis,oneIndex⟯ (v α)).toSubmodule) := by
    have hindκ' :
        iSupIndep
          ((fun α : s ↦
              (W⟮ρ,σ,basis,oneIndex⟯ (v α)).toSubmodule) ∘ eκs) := by
      simpa [eκs, v] using hindκ
    exact hindκ'.comp' eκs.surjective
  have hfull_le :
      iSup
          (fun α : ι ↦
            (W⟮ρ,σ,basis,oneIndex⟯ (v α)).toSubmodule) ≤
        iSup
          (fun k : κ ↦
            (W⟮ρ,σ,basis,oneIndex⟯ (v (a k))).toSubmodule) := by
    refine iSup_le ?_
    intro α
    have hvα : v α ∈ Submodule.span ℂ (Set.range (v ∘ a)) := by
      rw [hspan]
      exact Submodule.subset_span ⟨α, rfl⟩
    exact generatedSubrepresentation_le_iSup_of_mem_span ρ σ basis oneIndex (v ∘ a) hvα
  have hsupκ :
      iSup
          (fun k : κ ↦
            (W⟮ρ,σ,basis,oneIndex⟯ (v (a k))).toSubmodule) =
        (V⟮ρ⟯ x).toSubmodule := by
    apply le_antisymm
    · refine iSup_le ?_
      intro k
      exact generatedSubrepresentation_le_cyclicSubrepresentation ρ σ basis oneIndex x (a k)
    · calc
        (V⟮ρ⟯ x).toSubmodule
            = iSup
                (fun α : ι ↦ (W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α)).toSubmodule) :=
                cyclicSubrepresentation_toSubmodule_eq_iSup_generatedSubrepresentations
                  ρ σ basis oneIndex x
        _ ≤ iSup
              (fun k : κ ↦
                (W⟮ρ,σ,basis,oneIndex⟯ (v (a k))).toSubmodule) := hfull_le
  have hsup_s :
      iSup
          (fun α : s ↦
            (W⟮ρ,σ,basis,oneIndex⟯ (v α)).toSubmodule) =
        (V⟮ρ⟯ x).toSubmodule := by
    let g : s → Submodule ℂ V := fun α ↦
      (W⟮ρ,σ,basis,oneIndex⟯ (v α)).toSubmodule
    have hsupκ' :
        iSup (g ∘ eκs) = (V⟮ρ⟯ x).toSubmodule := by
      simpa [eκs, v] using hsupκ
    have hg :
        iSup (g ∘ eκs) = iSup g := by
      exact eκs.iSup_comp
    calc
      iSup g = iSup (g ∘ eκs) := by
        symm
        exact hg
      _ = (V⟮ρ⟯ x).toSubmodule := hsupκ'
  refine ⟨s, ?_, hind_s, ?_⟩
  · intro α
    let k : κ := eκs.symm α
    have hk_eq : a k = (α : ι) := congrArg Subtype.val (eκs.apply_symm_apply α)
    have hk_ne_zero :
        ((x₍1₎^(a k) : V⟮ρ,σ,basis⟯ oneIndex) : V) ≠ 0 := by
      intro hk0
      exact (hlin.ne_zero k) (Subtype.ext hk0)
    -- Each selected generator is nonzero because it comes from a linearly independent family.
    let e0 :=
      generatedSubrepresentationEquiv ρ σ basis oneIndex (x₍1₎^(a k)) hk_ne_zero
    have hW :
        W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^(a k)) = W⟮ρ,σ,basis,oneIndex⟯ (x₍1₎^α) := by
      simp [hk_eq]
    exact hW ▸ e0
  · simpa [v] using hsup_s

end FirstCoordinateVectorNotation

end

end ExplicitDecomposition

end Representation
