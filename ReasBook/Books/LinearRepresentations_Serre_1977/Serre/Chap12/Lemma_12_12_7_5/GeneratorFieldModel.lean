import LinearRepresentations_Serre_1977.Serre.Chap12.Lemma_12_12_7_5.CyclicIrreducibleBridge
import LinearRepresentations_Serre_1977.Serre.Chap12.Lemma_12_12_7_5.GeneratorFieldTwists

open Representation
open scoped Pointwise Representation

noncomputable section

universe u v

section Representation

variable {G : Type u} [Group G] [Finite G]
variable {L : Type v} [Field L] [NumberField L]
variable [IsCyclotomicExtension {Monoid.exponent G} ℚ L]
variable (K : IntermediateField ℚ L) (p : ℕ) (x : G)

/-- Helper for Lemma 12-12.7-5: a private `Fintype` witness for the finite group `G`. -/
private def instFintypeLemma121275GeneratorFieldModel : Fintype G :=
  Fintype.ofFinite G

attribute [local instance] instFintypeLemma121275GeneratorFieldModel

local notation "ΓK" => Γ[K](G)
local notation "N(" x ")" => N[ΓK](x)
local notation "C" => Subgroup.zpowers x

/-- Helper for Lemma 12-12.7-5: multiplication by the unit character value at the identity is the
identity endomorphism of the generator field. -/
private theorem generatorField_linearCharacter_map_one
    (β : C →* (AlgebraicClosure K)ˣ) :
    LinearMap.mulLeft K
        (⟨(((β 1 : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β 1⟩ :
            generatorFieldCarrier (K := K) (x := x) β) = 1 := by
  have hone :
      (⟨(((β 1 : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        linear_character_value_mem_generatorField (K := K) (x := x) β 1⟩ :
          generatorFieldCarrier (K := K) (x := x) β) = 1 := by
    apply Subtype.ext
    simp
  rw [hone]
  ext z
  simp [LinearMap.mulLeft_apply]

/-- Helper for Lemma 12-12.7-5: multiplication by character values is multiplicative on the
generator field model. -/
private theorem generatorField_linearCharacter_map_mul
    (β : C →* (AlgebraicClosure K)ˣ) (c d : C) :
    LinearMap.mulLeft K
        (⟨(((β (c * d) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β (c * d)⟩ :
            generatorFieldCarrier (K := K) (x := x) β) =
      LinearMap.mulLeft K
          (⟨(((β c : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            linear_character_value_mem_generatorField (K := K) (x := x) β c⟩ :
              generatorFieldCarrier (K := K) (x := x) β) *
        LinearMap.mulLeft K
          (⟨(((β d : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            linear_character_value_mem_generatorField (K := K) (x := x) β d⟩ :
              generatorFieldCarrier (K := K) (x := x) β) := by
  have hmul :
      (⟨(((β (c * d) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        linear_character_value_mem_generatorField (K := K) (x := x) β (c * d)⟩ :
          generatorFieldCarrier (K := K) (x := x) β) =
        (⟨(((β c : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β c⟩ :
            generatorFieldCarrier (K := K) (x := x) β) *
          (⟨(((β d : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            linear_character_value_mem_generatorField (K := K) (x := x) β d⟩ :
              generatorFieldCarrier (K := K) (x := x) β) := by
    apply Subtype.ext
    simp [map_mul]
  rw [hmul]
  ext z
  simp [LinearMap.mulLeft_apply, mul_assoc]

/-- Helper for Lemma 12-12.7-5: Serre's generator-field model attached to a linear character of
`C = ⟨x⟩`, acting by multiplication on the field generated by the character value of `x`. -/
def generatorField_linearCharacter_representation
    (β : C →* (AlgebraicClosure K)ˣ) :
    Representation K C (generatorFieldCarrier (K := K) (x := x) β) where
  toFun c :=
    LinearMap.mulLeft K
      (⟨(((β c : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        linear_character_value_mem_generatorField (K := K) (x := x) β c⟩ :
          generatorFieldCarrier (K := K) (x := x) β)
  map_one' := generatorField_linearCharacter_map_one (K := K) (x := x) β
  map_mul' c d := generatorField_linearCharacter_map_mul (K := K) (x := x) β c d

/-- Helper for Lemma 12-12.7-5: the cast-induced identification between the twisted and original
generator fields preserves multiplication by values of the twisted linear character. -/
private theorem generatorField_twist_linearEquiv_mul_twisted_value
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c : C)
    (z :
      generatorFieldCarrier (K := K) (x := x)
        (linearCharacter_twist (G := G) (K := K) (x := x) β t)) :
    generatorField_twist_linearEquiv (G := G) (K := K) (x := x) β t
        ((⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
            (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x)
            (linearCharacter_twist (G := G) (K := K) (x := x) β t) c⟩ :
            generatorFieldCarrier (K := K) (x := x)
              (linearCharacter_twist (G := G) (K := K) (x := x) β t)) * z) =
      generatorField_twist_linearEquiv (G := G) (K := K) (x := x) β t
          (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
              (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            linear_character_value_mem_generatorField (K := K) (x := x)
              (linearCharacter_twist (G := G) (K := K) (x := x) β t) c⟩ :
              generatorFieldCarrier (K := K) (x := x)
                (linearCharacter_twist (G := G) (K := K) (x := x) β t)) *
        generatorField_twist_linearEquiv (G := G) (K := K) (x := x) β t z := by
  let e :=
    AlgEquiv.cast
      (R := K)
      (A := fun S : IntermediateField K (AlgebraicClosure K) => ↥S)
      (generatorFieldOfLinearCharacter_twist_eq
        (G := G) (K := K) (x := x) β t)
  let a :
      generatorFieldCarrier (K := K) (x := x)
        (linearCharacter_twist (G := G) (K := K) (x := x) β t) :=
    ⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
        (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
      linear_character_value_mem_generatorField (K := K) (x := x)
        (linearCharacter_twist (G := G) (K := K) (x := x) β t) c⟩
  simpa [e, a, generatorField_twist_linearEquiv] using map_mul e a z

/-- Helper for Lemma 12-12.7-5: the twist-field carrier identification preserves multiplication by
the twisted character values. -/
theorem generatorField_twist_linearEquiv_mul_twisted_value_public
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c : C)
    (z :
      generatorFieldCarrier (K := K) (x := x)
        (linearCharacter_twist (G := G) (K := K) (x := x) β t)) :
    generatorField_twist_linearEquiv (G := G) (K := K) (x := x) β t
        ((⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
            (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x)
            (linearCharacter_twist (G := G) (K := K) (x := x) β t) c⟩ :
            generatorFieldCarrier (K := K) (x := x)
              (linearCharacter_twist (G := G) (K := K) (x := x) β t)) * z) =
      generatorField_twist_linearEquiv (G := G) (K := K) (x := x) β t
          (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
              (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            linear_character_value_mem_generatorField (K := K) (x := x)
              (linearCharacter_twist (G := G) (K := K) (x := x) β t) c⟩ :
              generatorFieldCarrier (K := K) (x := x)
                (linearCharacter_twist (G := G) (K := K) (x := x) β t)) *
        generatorField_twist_linearEquiv (G := G) (K := K) (x := x) β t z := by
  simpa using
    generatorField_twist_linearEquiv_mul_twisted_value
      (G := G) (K := K) (x := x) β t c z

/-- Helper for Lemma 12-12.7-5: any subrepresentation of Serre's generator-field model is stable
under multiplication by the distinguished character value `β(x)`. -/
private theorem generatorField_subrepresentation_mul_generator_mem
    (β : C →* (AlgebraicClosure K)ˣ)
    (σ : Subrepresentation (generatorField_linearCharacter_representation (K := K) (x := x) β))
    {y : generatorFieldCarrier (K := K) (x := x) β}
    (hy : y ∈ σ.toSubmodule) :
    (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
      linear_character_value_mem_generatorField (K := K) (x := x) β
        (zpowers_generator (x := x))⟩ :
        generatorFieldCarrier (K := K) (x := x) β) * y ∈ σ.toSubmodule := by
  have hy' := σ.apply_mem_toSubmodule (zpowers_generator (x := x)) hy
  simpa [generatorField_linearCharacter_representation, LinearMap.mulLeft_apply] using hy'

/-- Helper for Lemma 12-12.7-5: the same subrepresentation stability holds for every nonnegative
power of the distinguished generator value. -/
private theorem generatorField_subrepresentation_mul_generator_pow_mem
    (β : C →* (AlgebraicClosure K)ˣ)
    (σ : Subrepresentation (generatorField_linearCharacter_representation (K := K) (x := x) β))
    (n : ℕ)
    {y : generatorFieldCarrier (K := K) (x := x) β}
    (hy : y ∈ σ.toSubmodule) :
    (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
      linear_character_value_mem_generatorField (K := K) (x := x) β
        (zpowers_generator (x := x))⟩ :
        generatorFieldCarrier (K := K) (x := x) β) ^ n * y ∈ σ.toSubmodule := by
  induction n with
  | zero =>
      simpa using hy
  | succ n ihn =>
      have hstep :
          (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            linear_character_value_mem_generatorField (K := K) (x := x) β
              (zpowers_generator (x := x))⟩ :
              generatorFieldCarrier (K := K) (x := x) β) *
            ((⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
                AlgebraicClosure K)),
              linear_character_value_mem_generatorField (K := K) (x := x) β
                (zpowers_generator (x := x))⟩ :
                generatorFieldCarrier (K := K) (x := x) β) ^ n * y) ∈ σ.toSubmodule :=
        generatorField_subrepresentation_mul_generator_mem (K := K) (x := x) β σ ihn
      convert hstep using 1
      apply Subtype.ext
      simp [pow_succ', mul_assoc]

/-- Helper for Lemma 12-12.7-5: the generator value `β(x)` is algebraic over `K`, so Serre's
generator field is already a simple `K`-algebra. -/
theorem generatorField_generator_isAlgebraic
    (β : C →* (AlgebraicClosure K)ˣ) :
    IsAlgebraic K
      (((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) :=
  (AlgebraicClosure.isAlgebraic K).isAlgebraic _

/-- Helper for Lemma 12-12.7-5: Serre's generator field is the ordinary `K`-subalgebra generated
by the distinguished character value `β(x)`. -/
theorem generatorField_toSubalgebra_eq_adjoin
    (β : C →* (AlgebraicClosure K)ˣ) :
    (generatorFieldOfLinearCharacter (K := K) (x := x) β).toSubalgebra =
      Algebra.adjoin K
        ({(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K))} : Set (AlgebraicClosure K)) := by
  simpa [generatorFieldOfLinearCharacter] using
    (IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (F := K) (E := AlgebraicClosure K)
      (generatorField_generator_isAlgebraic (K := K) (x := x) β))

/-- Helper for Lemma 12-12.7-5: every value of the `Γ_K`-twisted character still lies in the
original generator field, since the twist does not change the simple field. -/
private theorem twisted_linear_character_value_mem_generatorField
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c : C) :
    (((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
        (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) ∈
      generatorFieldOfLinearCharacter (K := K) (x := x) β := by
  rw [← generatorFieldOfLinearCharacter_twist_eq (G := G) (K := K) (x := x) β t]
  exact linear_character_value_mem_generatorField (K := K) (x := x)
    (linearCharacter_twist (G := G) (K := K) (x := x) β t) c

/-- Helper for Lemma 12-12.7-5: every value of the twisted linear character belongs to the
original generator field `K(β(x))`. -/
theorem twisted_linear_character_value_mem_generator_field
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c : C) :
    (((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
        (AlgebraicClosure K)ˣ) : AlgebraicClosure K)) ∈
      generatorFieldOfLinearCharacter (K := K) (x := x) β := by
  -- This exposes the fixed-carrier scalar used in Serre's restricted `Γ_K`-action.
  simpa using
    twisted_linear_character_value_mem_generatorField
      (G := G) (K := K) (x := x) β t c

/-- Helper for Lemma 12-12.7-5: the twisted cyclic action may be written directly on the original
generator-field carrier because the twist leaves the simple field unchanged. -/
private theorem generatorField_twistedValue_map_one
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    LinearMap.mulLeft K
        (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t 1 :
            (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t 1⟩ :
            generatorFieldCarrier (K := K) (x := x) β) = 1 := by
  have hone :
      (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t 1 :
          (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t 1⟩ :
          generatorFieldCarrier (K := K) (x := x) β) = 1 := by
    apply Subtype.ext
    simp [linearCharacter_twist]
  rw [hone]
  ext z
  simp [LinearMap.mulLeft_apply]

/-- Helper for Lemma 12-12.7-5: the twisted cyclic action remains multiplicative on the original
generator-field carrier. -/
private theorem generatorField_twistedValue_map_mul
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) (c d : C) :
    LinearMap.mulLeft K
        (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t (c * d) :
            (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t
            (c * d)⟩ :
            generatorFieldCarrier (K := K) (x := x) β) =
      LinearMap.mulLeft K
          (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
              (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t
              c⟩ :
              generatorFieldCarrier (K := K) (x := x) β) *
        LinearMap.mulLeft K
          (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t d :
              (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t
              d⟩ :
              generatorFieldCarrier (K := K) (x := x) β) := by
  have hmul :
      (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t (c * d) :
          (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t
          (c * d)⟩ :
          generatorFieldCarrier (K := K) (x := x) β) =
        (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
            (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t
            c⟩ :
            generatorFieldCarrier (K := K) (x := x) β) *
          (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t d :
              (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
            twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t
              d⟩ :
              generatorFieldCarrier (K := K) (x := x) β) := by
    apply Subtype.ext
    simp [linearCharacter_twist, map_mul]
  rw [hmul]
  ext z
  simp [LinearMap.mulLeft_apply, mul_assoc]

/-- Helper for Lemma 12-12.7-5: the `Γ_K`-power twist of the cyclic action can be realized on the
fixed carrier `K(β(x))` itself. -/
def generatorField_twisted_linearCharacter_representation
    (β : C →* (AlgebraicClosure K)ˣ) (t : ΓK) :
    Representation K C (generatorFieldCarrier (K := K) (x := x) β) where
  toFun c :=
    LinearMap.mulLeft K
      (⟨(((linearCharacter_twist (G := G) (K := K) (x := x) β t c :
          (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
        twisted_linear_character_value_mem_generatorField (G := G) (K := K) (x := x) β t c⟩ :
          generatorFieldCarrier (K := K) (x := x) β)
  map_one' := generatorField_twistedValue_map_one (G := G) (K := K) (x := x) β t
  map_mul' c d := generatorField_twistedValue_map_mul (G := G) (K := K) (x := x) β t c d

/-- Helper for Lemma 12-12.7-5: the character of Serre's generator-field model is the field trace
of multiplication by the corresponding character value. -/
theorem generatorField_linearCharacter_character_eq_trace
    (β : C →* (AlgebraicClosure K)ˣ) (c : C) :
    (generatorField_linearCharacter_representation (K := K) (x := x) β).character c =
      Algebra.trace K (generatorFieldCarrier (K := K) (x := x) β)
        (⟨(((β c : (AlgebraicClosure K)ˣ) : AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β c⟩ :
            generatorFieldCarrier (K := K) (x := x) β) := by
  -- By construction, the operator at `c` is left multiplication by the scalar `β(c)`.
  rw [Representation.character, generatorField_linearCharacter_representation, Algebra.trace_apply]
  rfl

/-- Helper for Lemma 12-12.7-5: at the distinguished generator `x`, the character of Serre's
generator-field model is the field trace of `β(x)`. -/
theorem generatorField_linearCharacter_character_generator_eq_trace
    (β : C →* (AlgebraicClosure K)ˣ) :
    (generatorField_linearCharacter_representation (K := K) (x := x) β).character
        (zpowers_generator (x := x)) =
      Algebra.trace K (generatorFieldCarrier (K := K) (x := x) β)
        (⟨(((β (zpowers_generator (x := x)) : (AlgebraicClosure K)ˣ) :
            AlgebraicClosure K)),
          linear_character_value_mem_generatorField (K := K) (x := x) β
            (zpowers_generator (x := x))⟩ :
            generatorFieldCarrier (K := K) (x := x) β) := by
  simpa using
    generatorField_linearCharacter_character_eq_trace (K := K) (x := x) β
      (zpowers_generator (x := x))

/-- Helper for Lemma 12-12.7-5: once Serre's generator-field model for `C = ⟨x⟩` extends across
`H = C ⋅ P`, transporting that extension along an equivariant equivalence yields the desired
extension of the original irreducible `C`-representation. -/
theorem irreducible_extension_of_generatorField_extension
    (P : Sylow p N(x))
    {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (ρ : Representation K C V)
    (β : C →* (AlgebraicClosure K)ˣ)
    (e : (generatorField_linearCharacter_representation (K := K) (x := x) β).Equiv ρ)
    (σβ : Representation K (associatedGammaPElementarySubgroup ΓK x P)
      (generatorFieldCarrier (K := K) (x := x) β))
    (hσβ :
      σβ.comp
          (Subgroup.inclusion
            (zpowers_le_associatedGammaPElementarySubgroup ΓK p x P)) =
        generatorField_linearCharacter_representation (K := K) (x := x) β) :
    let H := associatedGammaPElementarySubgroup ΓK x P
    let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    ∃ σ : Representation K H V,
      σ.comp (Subgroup.inclusion hC) = ρ := by
  let H := associatedGammaPElementarySubgroup ΓK x P
  let hC : C ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
  exact exists_extension_of_equiv_of_extension (K := K) hC ρ
    (generatorField_linearCharacter_representation (K := K) (x := x) β) e σβ
    (by simpa [H, hC] using hσβ)

end Representation
