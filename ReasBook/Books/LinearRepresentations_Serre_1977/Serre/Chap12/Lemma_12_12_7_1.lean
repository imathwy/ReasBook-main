variable [IsIntegralClosure A ℤ K]
variable {p : ℕ} [Fact p.Prime]

/-- Helper for Lemma 12-12.7-1: if `A` is the integral closure of `ℤ` in a characteristic-zero
field `L`, then `A` is faithfully flat over `ℤ`. -/
lemma integral_closure_faithfullyFlat_over_int_gammaP
    (L : Type w) [Field L] [CharZero L] [Algebra A L]
    [IsIntegralClosure A ℤ L] :
    Module.FaithfullyFlat ℤ A := by
  let f := algebraMap A L
  have hAL : Function.Injective f := IsIntegralClosure.algebraMap_injective A ℤ L
  letI : IsDomain A := Function.Injective.isDomain f hAL
  -- The algebra map `ℤ → A` is injective because composing with `A → L` gives the usual
  -- injective integer embedding into the characteristic-zero field `L`.
  have hZA : Function.Injective (algebraMap ℤ A) := by
    intro m n hmn
    have hmn' := congrArg f hmn
    rw [← IsScalarTower.algebraMap_apply ℤ A L m, ← IsScalarTower.algebraMap_apply ℤ A L n] at hmn'
    exact Int.cast_injective hmn'
  letI : Module.IsTorsionFree ℤ A :=
    (Module.isTorsionFree_iff_algebraMap_injective).2 hZA
  haveI : Algebra.IsIntegral ℤ A := IsIntegralClosure.isIntegral_algebra ℤ L
  -- Integral extensions are surjective on prime spectra, so torsion-free flatness upgrades to
  -- faithful flatness.
  have hsurj : Function.Surjective (PrimeSpectrum.comap (algebraMap ℤ A)) := by
    exact Algebra.IsIntegral.comap_surjective ℤ A
  exact Module.FaithfullyFlat.of_comap_surjective hsurj

