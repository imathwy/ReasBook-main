/-- Helper for Lemma 12-12.7-1: realizing a basis expansion in `A ⊗ R_K(G)` evaluates
coefficientwise on the corresponding virtual characters. -/
lemma tensorCharacterRingToFunction_finsupp_sum_gammaP
    {ι : Type*} (b : Module.Basis ι ℤ (R[K](G))) (c : ι →₀ A) :
    tensorCharacterRingToFunction (A := A) (K := K) (G := G)
      (c.sum fun i a ↦ a ⊗ₜ[ℤ] b i) =
        c.sum fun i a ↦ a • (((b i : R[K](G)) : G → K)) := by
  classical
  -- Evaluate the ambient realization map termwise on the finitely supported basis expansion.
  simp [Finsupp.sum, map_sum, tensorCharacterRingToFunction_apply_tmul]

