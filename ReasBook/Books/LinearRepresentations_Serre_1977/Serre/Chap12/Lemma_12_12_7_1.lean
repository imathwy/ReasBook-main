/-- Helper for Lemma 12-12.7-1: realizing the ambient tensor owner `A ⊗ R_K(G)` in
`K`-valued functions is injective. -/
lemma tensorCharacterRingToFunction_injective_gammaP :
    Function.Injective (tensorCharacterRingToFunction (A := A) (K := K) (G := G)) := by
  classical
  intro ξ η hξη
  have hcard_ne : (Nat.card G : K) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  letI : NeZero (Nat.card G : K) := ⟨hcard_ne⟩
  obtain ⟨ι, hι, π, hπ_pairwise, hπ_complete⟩ :=
    exists_complete_pairwise_nonisomorphic_simple_family_local (K := K) (G := G)
  letI : Fintype ι := hι
  let b := irreducible_characters_basis_of_complete_family K π hπ_pairwise hπ_complete
  have hdiff :
      tensorCharacterRingToFunction (A := A) (K := K) (G := G) (ξ - η) = 0 := by
    -- Route correction: expand the tensor difference in an irreducible-character basis and kill
    -- its coefficients by orthogonality, rather than using a false tensor-collapse identity.
    have hsub := congrArg
      (fun z : G → K ↦ z - tensorCharacterRingToFunction (A := A) (K := K) (G := G) η) hξη
    simpa [map_sub] using hsub
  obtain ⟨c, hc⟩ := TensorProduct.eq_repr_basis_right (R := ℤ) (M := A) (𝒞 := b) (x := ξ - η)
  have hrealized :
      c.sum (fun i a ↦ a • (π i).character) = 0 := by
    -- Rewrite the chosen tensor coordinates through the ambient realization map.
    have hsum :=
      tensorCharacterRingToFunction_finsupp_sum_gammaP (A := A) (K := K) (G := G) b c
    have hsum' :
        tensorCharacterRingToFunction (A := A) (K := K) (G := G)
            (c.sum fun i a ↦ a ⊗ₜ[ℤ] b i) =
          c.sum (fun i a ↦ a • (π i).character) := by
      simpa [b, irreducible_characters_basis_of_complete_family_apply,
        FDRep.irreducibleCharacter_apply] using hsum
    rw [← hsum', hc, hdiff]
  have hc_zero : c = 0 :=
    irreducible_character_coefficients_eq_zero
      (A := A) (K := K) (G := G) π hπ_pairwise hπ_complete c hrealized
  have hξη' : ξ - η = 0 := by
    -- Once the coordinate vector is zero, the tensor itself is zero.
    rw [← hc, hc_zero]
    simp
  exact sub_eq_zero.mp hξη'

/-- Helper for Lemma 12-12.7-1: realizing a tensor in `A ⊗ V_{K,p}` agrees pointwise with first
viewing it inside the ambient tensor owner `A ⊗ R_K(G)` and then realizing there. -/
lemma tensorGammaPElementaryInducedCharacterToFunction_eq_tensorCharacterRingToFunction_lTensor
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ)
    (ξ : A ⊗V[K,p](ΓK)) :
    tensorGammaPElementaryInducedCharacterToFunction A K ΓK p ξ =
      tensorCharacterRingToFunction (A := A) (K := K) (G := G)
        (show TensorProduct ℤ A (R[K](G)) from
          LinearMap.lTensor A (V[K,p](ΓK)).subtype ξ) := by
  -- Compare the two realizations by tensor induction inside `A ⊗ V_{K,p}`.
  induction ξ using TensorProduct.induction_on with
  | zero =>
      rfl
  | tmul a χ =>
      -- On pure tensors both maps evaluate to the same scalar multiple of the underlying
      -- virtual character.
      ext g
      simp [tensorCharacterRingToFunction_apply_tmul]
  | add ξ η hξ hη =>
      simp [hξ, hη, map_add]

/-- Helper for Lemma 12-12.7-1: tensoring the quotient map
`R_K(G) → R_K(G) / V_{K,p}` identifies its kernel with the tensor image of `V_{K,p}`. -/
lemma ker_lTensor_mkQ_eq_range_lTensor_gammaP_subtype_gammaP
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    LinearMap.ker (LinearMap.lTensor A (Submodule.mkQ (V[K,p](ΓK)))) =
      LinearMap.range (LinearMap.lTensor A (V[K,p](ΓK)).subtype) := by
  -- This is the standard right-exactness statement for tensoring a submodule quotient.
  simpa using (lTensor_mkQ A (V[K,p](ΓK)))

/-- Helper for Lemma 12-12.7-1: the realized scalar extension `A ⊗ V_{K,p}` sits inside the
ambient realized scalar extension `A ⊗ R_K(G)`. -/
theorem gammaPElementaryInducedCharacterScalarExtension_le_characterRingOverFieldAlgebraScalarExtension_gammaP
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    gammaPElementaryInducedCharacterScalarExtension A K ΓK p ≤
      characterRingOverFieldAlgebraScalarExtension A K G := by
  -- Each generator coming from `V_{K,p}` is already an honest `K`-character, so its scalar
  -- extension lands in the ambient scalar-extended character ring.
  rintro _ ⟨χ, rfl⟩
  induction χ using TensorProduct.induction_on with
  | zero =>
      exact zero_mem (characterRingOverFieldAlgebraScalarExtension A K G)
  | tmul a χ =>
      simpa [tensorGammaPElementaryInducedCharacterToFunction_apply_tmul] using
        (characterRingOverFieldAlgebraScalarExtension A K G).smul_mem a
          (mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
            (A := A) (K := K) (χ : R[K](G)).property)
  | add χ ψ hχ hψ =>
      simpa [map_add] using (characterRingOverFieldAlgebraScalarExtension A K G).add_mem hχ hψ

/-- Helper for Lemma 12-12.7-1: if an integral character is realized inside Serre's scalar
extension `A ⊗ V_{K,p}`, then its quotient class in `R_K(G) / V_{K,p}` dies after tensoring with
`1 ∈ A`. -/
lemma quotient_class_eq_zero_of_mem_gammaP_scalarExtension_gammaP
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) {χ : R[K](G)}
    (hχ : (χ : G → K) ∈ gammaPElementaryInducedCharacterScalarExtension A K ΓK p) :
    Submodule.mkQ (V[K,p](ΓK)) χ = 0 := by
  rcases hχ with ⟨ξ, hξ⟩
  have htensor :
      ((1 : A) ⊗ₜ[ℤ] χ : TensorProduct ℤ A (R[K](G))) =
        LinearMap.lTensor A (V[K,p](ΓK)).subtype ξ := by
    -- Route correction: compare the honest tensor `1 ⊗ χ` with the ambient tensor witness inside
    -- `A ⊗ R_K(G)`, avoiding the false identity `1 ⊗ (a • f) = a ⊗ f`.
    apply tensorCharacterRingToFunction_injective_gammaP (A := A) (K := K) (G := G)
    calc
      tensorCharacterRingToFunction (A := A) (K := K) (G := G)
          ((1 : A) ⊗ₜ[ℤ] χ : TensorProduct ℤ A (R[K](G))) = χ := by
        simp [tensorCharacterRingToFunction_apply_tmul]
      _ = tensorGammaPElementaryInducedCharacterToFunction A K ΓK p ξ := by
        simpa [hξ]
      _ = tensorCharacterRingToFunction (A := A) (K := K) (G := G)
            (LinearMap.lTensor A (V[K,p](ΓK)).subtype ξ) := by
        simpa using
          tensorGammaPElementaryInducedCharacterToFunction_eq_tensorCharacterRingToFunction_lTensor
            (A := A) (K := K) (ΓK := ΓK) (p := p) ξ
  have hquot_tmul :
      (1 : A) ⊗ₜ[ℤ] (Submodule.mkQ (V[K,p](ΓK)) χ) = 0 := by
    -- Quotienting kills the tensor image of `V_{K,p}`, so the previous tensor equality descends
    -- to a vanishing pure tensor in the quotient.
    have hquot :=
      congrArg (LinearMap.lTensor A (Submodule.mkQ (V[K,p](ΓK)))) htensor
    calc
      (1 : A) ⊗ₜ[ℤ] (Submodule.mkQ (V[K,p](ΓK)) χ) =
          LinearMap.lTensor A (Submodule.mkQ (V[K,p](ΓK)))
            (LinearMap.lTensor A (V[K,p](ΓK)).subtype ξ) := by
        simpa [LinearMap.lTensor_tmul] using hquot
      _ = 0 := by
        have hcomp :
            (LinearMap.lTensor A (Submodule.mkQ (V[K,p](ΓK)))).comp
                (LinearMap.lTensor A (V[K,p](ΓK)).subtype) = 0 := by
          have hmkQ_subtype :
              (Submodule.mkQ (V[K,p](ΓK))).comp (V[K,p](ΓK)).subtype = 0 := by
            ext x
            exact (Submodule.Quotient.mk_eq_zero _).2 x.2
          rw [← LinearMap.lTensor_comp, hmkQ_subtype, LinearMap.lTensor_zero]
        simpa using congrArg (fun f ↦ f ξ) hcomp
  -- Faithful flatness reflects the vanishing of the quotient class from the vanishing of `1 ⊗ -`.
  exact
    quotient_eq_zero_of_one_tmul_eq_zero
      (A := A) (K := K) (p := p) ΓK (Submodule.mkQ (V[K,p](ΓK)) χ) hquot_tmul

/-- Helper for Lemma 12-12.7-1: if an integral character is realized inside Serre's scalar
extension `A ⊗ V_{K,p}`, then its quotient class in `R_K(G) / V_{K,p}` dies after tensoring with
`1 ∈ A`. -/
lemma one_tmul_quotient_eq_zero_of_mem_gammaP_scalarExtension
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) {χ : R[K](G)}
    (hχ : (χ : G → K) ∈ gammaPElementaryInducedCharacterScalarExtension A K ΓK p) :
    (1 : A) ⊗ₜ[ℤ] Submodule.mkQ (V[K,p](ΓK)) χ = 0 := by
  -- Route correction: work directly with the realization witness in `A ⊗ V_{K,p}`, then kill the
  -- resulting class after quotienting and reflect zero back by faithful flatness.
  have hq :
      Submodule.mkQ (V[K,p](ΓK)) χ = 0 :=
    quotient_class_eq_zero_of_mem_gammaP_scalarExtension_gammaP
      (A := A) (K := K) (p := p) ΓK hχ
  simp [hq]

-- Proof sketch: one inclusion is immediate from the scalar-extension realization of `V_{K,p}`.
-- For the reverse inclusion, represent an integral character in the scalar extension by a tensor,
-- kill its quotient class by the previous lemma, and recover membership in `V_{K,p}`.
/-- Helper for Lemma 12-12.7-1: the integral characters lying in Serre's scalar extension
`A ⊗ V_{K,p}` are exactly the original image of `V_{K,p}` in `G → K`. -/
theorem gammaPElementaryInducedCharacterScalarExtension_inter_characterRing_eq_image
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) :
    ((gammaPElementaryInducedCharacterScalarExtension A K ΓK p : Set (G → K)) ∩
        (R[K](G) : Set (G → K))) =
      ((LinearMap.range (gammaPElementaryInducedCharacterToFunction K ΓK p)) : Set (G → K)) := by
  ext χ
  constructor
  · rintro ⟨hχscalar, hχring⟩
    let χR : R[K](G) := ⟨χ, hχring⟩
    have hq :
        Submodule.mkQ (V[K,p](ΓK)) χR = 0 :=
      quotient_class_eq_zero_of_mem_gammaP_scalarExtension_gammaP
        (A := A) (K := K) (p := p) ΓK hχscalar
    have hmem : χR ∈ V[K,p](ΓK) :=
      (Submodule.Quotient.mk_eq_zero (V[K,p](ΓK))).1 hq
    -- Vanishing in the quotient means the original integral character already comes from
    -- `V_{K,p}`.
    exact ⟨⟨χR, hmem⟩, rfl⟩
  · rintro ⟨χ, rfl⟩
    constructor
    · exact
        mem_gammaPElementaryInducedCharacterScalarExtension_of_mem_gammaPImage
          (A := A) (K := K) ΓK p χ.property
    · exact (χ : R[K](G)).property

-- Proof sketch: compare the constant character `l` with its class in the finite quotient
-- `R_K(G) / V_{K,p}`. Membership of the constant function in `A ⊗ V_{K,p}` forces that quotient
-- class to vanish after scalar extension to `A`, and integrality over `ℤ` then forces the class
-- itself to vanish, so the constant virtual character already lies in `V_{K,p}`.
/-- Lemma 12-12.7-1: if the constant `K`-valued virtual character with value `l` belongs to the
function-space realization of Serre's scalar extension `A ⊗ V_{K,p}`, then it already belongs to
`V_{K,p}`. -/
theorem
    constantCharacter_mem_gammaPImageOverField_of_mem_gammaPImageScalarExtension
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (l : ℕ)
    (hl : (fun _ : G ↦ (l : K)) ∈
      gammaPElementaryInducedCharacterScalarExtension A K ΓK p) :
    l • (1 : R[K](G)) ∈ V[K,p](ΓK) := by
  let χ : R[K](G) := l • (1 : R[K](G))
  have hχ_apply : (χ : G → K) = fun _ : G ↦ (l : K) := by
    -- Rewrite Serre's constant function as the constant virtual character `l • 1`.
    ext g
    simp [χ]
  have hχ_inter :
      ((χ : G → K) ∈ gammaPElementaryInducedCharacterScalarExtension A K ΓK p) ∧
        ((χ : G → K) ∈ (R[K](G) : Set (G → K))) := by
    constructor
    · simpa [hχ_apply] using hl
    · exact χ.property
  have hχ_image :
      (χ : G → K) ∈
        ((LinearMap.range (gammaPElementaryInducedCharacterToFunction K ΓK p)) : Set (G → K)) := by
    rw [← gammaPElementaryInducedCharacterScalarExtension_inter_characterRing_eq_image
      (A := A) (K := K) (ΓK := ΓK) (p := p)]
    simpa [Set.mem_inter_iff] using hχ_inter
  rcases hχ_image with ⟨ψ, hψ⟩
  have hψ_eq : (ψ : R[K](G)) = χ := Subtype.ext hψ
  have hχ_mem : χ ∈ V[K,p](ΓK) := by
    exact hψ_eq ▸ ψ.property
  simpa [χ] using hχ_mem

end
end

