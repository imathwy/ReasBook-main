local instance instFintypeGammaPScalarExtension : Fintype G := Fintype.ofFinite G

/-- Serre's fixed-`p` subgroup `V_{K,p} ≤ R_K(G)`, generated by induction from the
`Γ_K`-`p`-elementary subgroups of `G`. -/
abbrev gammaPElementaryInducedCharacterSpan
    (K : Type w) [Field K] [CharZero K]
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    Submodule ℤ R[K](G) :=
  let _ : DecidablePred (fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H) :=
    Classical.decPred _
  inducedCharacterSubmoduleOverField K
    (Finset.univ.filter fun H : Subgroup G ↦ Subgroup.IsGammaPElementary ΓK p H)

scoped[Representation] notation:max "V[" K "," p "](" ΓK ")" =>
  Representation.gammaPElementaryInducedCharacterSpan K ΓK p

-- Source/core/bridge triage:
-- * source-facing: Serre's `A ⊗ V_{K,p}`.
-- * core/canonical: the tensor product owner `TensorProduct ℤ A (V[K,p](ΓK))`.
-- * bridge/view: `gammaPElementaryInducedCharacterScalarExtension A K ΓK p`, the realized
--   `A`-submodule of `K`-valued functions on `G`.
--
-- Primitive data: the owner `V[K,p](ΓK)` from Theorem `12-12.6-3`, its tensor product with `A`,
-- and the canonical image of `V[K,p](ΓK)` in `G → K`.
-- Derived API: the tensor-product realization map into `G → K`.
scoped[Representation] notation:max A " ⊗V[" K "," p "](" ΓK ")" =>
  TensorProduct ℤ A (V[K,p](ΓK))

/-- The canonical inclusion of `V_{K,p}` into the ambient space of `K`-valued functions on `G`. -/
abbrev gammaPElementaryInducedCharacterToFunction
    (K : Type w) [Field K] [CharZero K]
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    V[K,p](ΓK) →ₗ[ℤ] G → K :=
  ((R[K](G)).toSubmodule.subtype).comp (V[K,p](ΓK)).subtype

/-- The canonical realization of Serre's tensor product `A ⊗ V_{K,p}` as `K`-valued functions on
`G`. -/
abbrev tensorGammaPElementaryInducedCharacterToFunction
    (A : Type v) [CommRing A]
    (K : Type w) [Field K] [CharZero K] [Algebra A K]
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    A ⊗V[K,p](ΓK) →ₗ[A] G → K :=
  (gammaPElementaryInducedCharacterToFunction K ΓK p).liftBaseChange A

instance
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    CoeFun (A ⊗V[K,p](ΓK)) (fun _ ↦ G → K) where
  coe := tensorGammaPElementaryInducedCharacterToFunction A K ΓK p

@[simp] theorem tensorGammaPElementaryInducedCharacterToFunction_apply_tmul
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ)
    (a : A) (χ : V[K,p](ΓK)) :
    tensorGammaPElementaryInducedCharacterToFunction A K ΓK p (a ⊗ₜ[ℤ] χ) =
      a • ((χ : R[K](G)) : G → K) := by
  simp [tensorGammaPElementaryInducedCharacterToFunction,
    gammaPElementaryInducedCharacterToFunction]

/-- The ambient `K`-valued-function realization of Serre's tensor product `A ⊗ V_{K,p}`. This is
a bridge/view of the owner `A ⊗V[K,p](ΓK)`. -/
def gammaPElementaryInducedCharacterScalarExtension
    (A : Type v) [CommRing A] (K : Type w) [Field K] [CharZero K] [Algebra A K]
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    Submodule A (G → K) :=
  LinearMap.range (tensorGammaPElementaryInducedCharacterToFunction A K ΓK p)

/-- The realization bridge `gammaPElementaryInducedCharacterScalarExtension A K ΓK p` is the
`A`-span of the canonical image of `V_{K,p}` in `G → K`. -/
theorem gammaPElementaryInducedCharacterScalarExtension_eq_span
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    gammaPElementaryInducedCharacterScalarExtension A K ΓK p =
      Submodule.span A
        ((LinearMap.range (gammaPElementaryInducedCharacterToFunction K ΓK p)) : Set (G → K)) := by
  rw [gammaPElementaryInducedCharacterScalarExtension, LinearMap.range_liftBaseChange]

/-- Every realized tensor character in `A ⊗V[K,p](ΓK)` belongs to its ambient bridge/view
`gammaPElementaryInducedCharacterScalarExtension A K ΓK p`. -/
theorem tensorGammaPElementaryInducedCharacter_mem_gammaPElementaryInducedCharacterScalarExtension
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ)
    (χ : A ⊗V[K,p](ΓK)) :
    (χ : G → K) ∈ gammaPElementaryInducedCharacterScalarExtension A K ΓK p := by
  exact ⟨χ, rfl⟩

-- Proof sketch: realize `χ ∈ V_{K,p}` as the pure tensor `1 ⊗ χ` in `A ⊗V[K,p](ΓK)`; its image
-- under the canonical realization map is exactly the original `K`-valued function `χ`.
/-- Coercing an element of `V_{K,p}` to a `K`-valued function lands in the realization of its
scalar extension `A ⊗ V_{K,p}`. -/
theorem
    mem_gammaPElementaryInducedCharacterScalarExtension_of_mem_gammaPImage
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ)
    {χ : R[K](G)}
    (hχ : χ ∈ V[K,p](ΓK)) :
    (χ : G → K) ∈ gammaPElementaryInducedCharacterScalarExtension A K ΓK p := by
  let ψ : A ⊗V[K,p](ΓK) := (1 : A) ⊗ₜ[ℤ] (⟨χ, hχ⟩ : V[K,p](ΓK))
  have hψ : (ψ : G → K) = χ := by
    ext g
    simp [ψ]
  rw [← hψ]
  exact
    tensorGammaPElementaryInducedCharacter_mem_gammaPElementaryInducedCharacterScalarExtension
      ΓK p ψ

