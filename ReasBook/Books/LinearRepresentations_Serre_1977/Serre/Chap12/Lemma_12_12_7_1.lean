/-- Helper for Lemma 12-12.7-1: a quotient class in `R_K(G) / V_{K,p}` is zero once its pure
tensor with `1 ∈ A` vanishes. -/
lemma quotient_eq_zero_of_one_tmul_eq_zero
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ)
    (x : R[K](G) ⧸ V[K,p](ΓK))
    (hx : (1 : A) ⊗ₜ[ℤ] x = 0) :
    x = 0 := by
  letI : Module.FaithfullyFlat ℤ A := integral_closure_faithfullyFlat_over_int_gammaP (A := A) K
  -- Faithful flatness reflects the vanishing of the canonical pure tensor `1 ⊗ x`.
  exact (Module.FaithfullyFlat.one_tmul_eq_zero_iff
    (R := ℤ) (M := R[K](G) ⧸ V[K,p](ΓK)) (A := A) x).mp hx

/-- Helper for Lemma 12-12.7-1: identify `R_K(G)` with its underlying `ℤ`-submodule of
`K`-valued functions. -/
abbrev characterRingToSubmoduleLinear :
    R[K](G) →ₗ[ℤ] (R[K](G)).toSubmodule :=
  show R[K](G) →ₗ[ℤ] (R[K](G)).toSubmodule from
    (show R[K](G) ≃ₗ[ℤ] (R[K](G)).toSubmodule from LinearEquiv.refl ℤ R[K](G)).toLinearMap

/-- Helper for Lemma 12-12.7-1: the ambient inclusion of the character ring into the function
space `G → K`. -/
abbrev characterRingToFunctionLinear :
    R[K](G) →ₗ[ℤ] G → K :=
  ((R[K](G)).toSubmodule.subtype).comp (characterRingToSubmoduleLinear (G := G) (K := K))

/-- Helper for Lemma 12-12.7-1: tensoring the ambient inclusion `R_K(G) ↪ G → K` with `A`
preserves injectivity. -/
lemma lTensor_characterRing_toFunction_injective_gammaP :
    Function.Injective
      (LinearMap.lTensor A (characterRingToFunctionLinear (G := G) (K := K))) := by
  letI : Module.Flat ℤ A := (integral_closure_faithfullyFlat_over_int_gammaP (A := A) K).toFlat
  have hchar :
      Function.Injective (characterRingToFunctionLinear (G := G) (K := K)) := by
    intro χ ψ hχψ
    exact Subtype.ext hχψ
  -- The inclusion into the ambient function module is a genuine embedding, so flat base change
  -- keeps it injective.
  exact Module.Flat.lTensor_preserves_injective_linearMap (M := A)
    (characterRingToFunctionLinear (G := G) (K := K)) hchar

/-- Helper for Lemma 12-12.7-1: the realization map for `V_{K,p}` factors through the ambient
character-ring inclusion. -/
lemma gammaPElementaryInducedCharacterToFunction_eq_characterRing_toFunction_comp_subtype
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    gammaPElementaryInducedCharacterToFunction K ΓK p =
      (characterRingToFunctionLinear (G := G) (K := K)).comp (V[K,p](ΓK)).subtype := by
  -- Both maps simply view an element of `V_{K,p}` as its underlying `K`-valued class function.
  ext χ g
  rfl

/-- Helper for Lemma 12-12.7-1: tensoring the realization map for `V_{K,p}` factors through the
tensor of the ambient character-ring inclusion. -/
lemma lTensor_gammaPElementaryInducedCharacterToFunction_eq_lTensor_characterRing_toFunction_comp_gammaP
    (ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ) (p : ℕ) :
    LinearMap.lTensor A (gammaPElementaryInducedCharacterToFunction K ΓK p) =
      (LinearMap.lTensor A (characterRingToFunctionLinear (G := G) (K := K))).comp
        (LinearMap.lTensor A (V[K,p](ΓK)).subtype) := by
  -- This is the tensor-level form of the obvious factorization through `R_K(G)`.
  rw [gammaPElementaryInducedCharacterToFunction_eq_characterRing_toFunction_comp_subtype]
  ext a ξ
  simp

/-- Helper for Lemma 12-12.7-1: the ambient owner `A ⊗ R_K(G)` realized as `K`-valued functions
through the canonical tensor-to-span map. -/
abbrev tensorCharacterRingToFunction :
    TensorProduct ℤ A (R[K](G)) →ₗ[A] G → K :=
  (characterRingOverFieldAlgebraScalarExtension A K G).subtype.comp
    (((R[K](G)).toSubmodule).tensorToSpan A)

/-- Helper for Lemma 12-12.7-1: evaluating a pure tensor in `A ⊗ R_K(G)` gives the expected
scalar multiple of the underlying virtual character. -/
@[simp] lemma tensorCharacterRingToFunction_apply_tmul
    (a : A) (χ : R[K](G)) :
    tensorCharacterRingToFunction (A := A) (K := K) (G := G) (a ⊗ₜ[ℤ] χ) =
      a • (χ : G → K) := by
  rfl

omit [Fact p.Prime] in
/-- Helper for Lemma 12-12.7-1: the normalized character pairing is additive on finite
`A`-linear combinations in its left argument after transporting the coefficients along
`A → K`. -/
private theorem groupFunctionPairing_sum_algebra_smul_left
    {ι : Type*} (s : Finset ι) (a : ι → A) (χ : ι → G → K) (ψ : G → K) :
    ⟪∑ j ∈ s, a j • χ j, ψ⟫ = ∑ j ∈ s, algebraMap A K (a j) * ⟪χ j, ψ⟫ := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      simp [Representation.groupFunctionPairingOverField]
  | insert i s hi ih =>
      -- Replace the `A`-scalar action by the corresponding `K`-scalar action, then expand the
      -- pairing across the inserted summand.
      have hsmul : (a i • χ i : G → K) = algebraMap A K (a i) • χ i := by
        ext g
        simp [Algebra.smul_def, smul_eq_mul]
      rw [Finset.sum_insert hi, groupFunctionPairing_add_left, hsmul,
        groupFunctionPairing_smul_left, ih, Finset.sum_insert hi]

omit [Fact p.Prime] in
/-- Helper for Lemma 12-12.7-1: a finite `A`-linear combination of the characters of a complete
pairwise nonisomorphic irreducible family can vanish only if every coefficient is zero. -/
lemma irreducible_character_coefficients_eq_zero
    {ι : Type*} [Fintype ι]
    (π : ι → FDRep K G)
    (hπ_pairwise : PairwiseNonisomorphic π)
    (hπ_complete : IsCompleteIrreducibleFamily π)
    (c : ι →₀ A)
    (hc : c.sum (fun i a ↦ a • (π i).character) = 0) :
    c = 0 := by
  classical
  have hcard_ne : (Nat.card G : K) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  letI : Invertible (Nat.card G : K) := invertibleOfNonzero hcard_ne
  have horth :
      Pairwise fun i j ↦
        ⟪(π i).character, (π j).character⟫ = (0 : K) :=
    irreducible_characters_pairwise_orthogonal_of_pairwise_nonisomorphic
      K π hπ_complete.isSimple hπ_pairwise
  ext i
  -- Pair the vanishing relation against the `i`-th irreducible character to isolate the
  -- `i`-th coefficient.
  have hpair0 :
      ⟪c.sum (fun j a ↦ a • (π j).character), (π i).character⟫ = (0 : K) := by
    simpa [Representation.groupFunctionPairingOverField] using
      congrArg (fun ψ : G → K ↦ groupFunctionPairingOverField K ψ (π i).character) hc
  have hpair_expand :
      ⟪c.sum (fun j a ↦ a • (π j).character), (π i).character⟫ =
        c.sum (fun j a ↦ algebraMap A K a * ⟪(π j).character, (π i).character⟫) := by
    simpa [Finsupp.sum] using
      (groupFunctionPairing_sum_algebra_smul_left (A := A) (K := K) (G := G)
        (s := c.support) (a := c) (χ := fun j ↦ (π j).character) (ψ := (π i).character))
  rw [hpair_expand] at hpair0
  have hself_ne : ⟪(π i).character, (π i).character⟫ ≠ (0 : K) := by
    letI : Simple (π i) := hπ_complete.isSimple i
    let X : Rep K G := (forget₂ (FDRep K G) (Rep K G)).obj (π i)
    let e₁ : ((π i) ⟶ (π i)) ≃ₗ[K] (X ⟶ X) :=
      (FDRep.forget₂HomLinearEquiv (π i) (π i)).symm
    let e₂ : (X ⟶ X) ≃ₗ[K] (Representation.IntertwiningMap (π i).ρ (π i).ρ) := by
      simpa [X, FDRep.forget₂_ρ] using (Rep.homLinearEquiv X X)
    let e : ((π i) ⟶ (π i)) ≃ₗ[K] (Representation.IntertwiningMap (π i).ρ (π i).ρ) :=
      e₁.trans e₂
    letI : FiniteDimensional K (Representation.IntertwiningMap (π i).ρ (π i).ρ) :=
      FiniteDimensional.of_injective e.symm.toLinearMap e.symm.injective
    have hnontriv : Nontrivial (Representation.IntertwiningMap (π i).ρ (π i).ρ) := by
      refine ⟨0, e (𝟙 (π i)), ?_⟩
      intro h
      apply CategoryTheory.id_nonzero (π i)
      exact e.injective h.symm
    letI : Nontrivial (Representation.IntertwiningMap (π i).ρ (π i).ρ) := hnontriv
    have hpair :
        ⟪(π i).character, (π i).character⟫ =
          Module.finrank K (Representation.IntertwiningMap (π i).ρ (π i).ρ) :=
      Representation.groupFunctionPairingOverField_character_eq_finrank_intertwiningMap
        K (π i).ρ (π i).ρ
    rw [hpair]
    exact_mod_cast Module.finrank_pos.ne'
  have hpair_single :
      c.sum (fun j a ↦ algebraMap A K a * ⟪(π j).character, (π i).character⟫) =
        algebraMap A K (c i) * ⟪(π i).character, (π i).character⟫ := by
    rw [Finsupp.sum]
    refine Finset.sum_eq_single i ?_ ?_
    · intro j hj hji
      rw [horth hji, mul_zero]
    · intro hi
      by_cases hci : c i = 0
      · simp [hci]
      · exact (hi (Finsupp.mem_support_iff.2 hci)).elim
  rw [hpair_single] at hpair0
  · have hcoeffK : algebraMap A K (c i) = 0 :=
      (mul_eq_zero.mp hpair0).resolve_right hself_ne
    exact (IsIntegralClosure.algebraMap_injective A ℤ K) <| by
      simpa using hcoeffK

