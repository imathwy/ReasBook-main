import Mathlib

open scoped MatrixGroups

noncomputable section

local notation "A5" => alternatingGroup (Fin 5)

namespace Representation

/-- Helper for Exercise 18-18.6-3: the standard five-cycle belongs to `A₅`. -/
theorem a5_standardFiveCycle_mem :
    finRotate 5 ∈ alternatingGroup (Fin 5) := by
  -- The cycle `(0 1 2 3 4)` is even, so it is an element of the alternating group.
  rw [Equiv.Perm.mem_alternatingGroup]
  set_option maxRecDepth 100000 in
  decide

/-- Helper for Exercise 18-18.6-3: the standard double transposition belongs to `A₅`. -/
theorem a5_standardDoubleTransposition_mem :
    Equiv.swap 1 2 * Equiv.swap 3 4 ∈ alternatingGroup (Fin 5) := by
  -- A product of two transpositions is even.
  rw [Equiv.Perm.mem_alternatingGroup]
  decide

/-- Helper for Exercise 18-18.6-3: the standard five-cycle in `A₅`. -/
def a5_standardFiveCycle : A5 :=
  ⟨finRotate 5, a5_standardFiveCycle_mem⟩

/-- Helper for Exercise 18-18.6-3: the standard double transposition in `A₅`. -/
def a5_standardDoubleTransposition : A5 :=
  ⟨Equiv.swap 1 2 * Equiv.swap 3 4, a5_standardDoubleTransposition_mem⟩

/-- Helper for Exercise 18-18.6-3: the standard generators satisfy the
`(2,3,5)` triangle relations used in the `SL₂` normal-form route. -/
theorem a5_standardGenerator_triangle_relations :
    a5_standardFiveCycle ^ 5 = 1 ∧
      a5_standardDoubleTransposition ^ 2 = 1 ∧
      (a5_standardFiveCycle * a5_standardDoubleTransposition) ^ 3 = 1 ∧
      orderOf a5_standardFiveCycle = 5 ∧
      orderOf a5_standardDoubleTransposition = 2 ∧
      orderOf (a5_standardFiveCycle * a5_standardDoubleTransposition) = 3 := by
  have hpow :
      a5_standardFiveCycle ^ 5 = 1 ∧
        a5_standardDoubleTransposition ^ 2 = 1 ∧
        (a5_standardFiveCycle * a5_standardDoubleTransposition) ^ 3 = 1 := by
    -- The power relations are finite checks in the concrete permutation model of `A₅`.
    decide
  have hne :
      a5_standardFiveCycle ≠ 1 ∧
        a5_standardDoubleTransposition ≠ 1 ∧
        a5_standardFiveCycle * a5_standardDoubleTransposition ≠ 1 := by
    -- Nontriviality of the three generators is another finite check; the order facts then
    -- follow by the prime-order criterion.
    decide
  have hfive_order : orderOf a5_standardFiveCycle = 5 := by
    -- The prime-order criterion converts the computed fifth power and nonidentity facts.
    exact orderOf_eq_prime (p := 5) (hp := ⟨by decide⟩) hpow.1 hne.1
  have htwo_order : orderOf a5_standardDoubleTransposition = 2 := by
    -- The same criterion records that the double transposition is an involution.
    exact orderOf_eq_prime (p := 2) (hp := ⟨by decide⟩) hpow.2.1 hne.2.1
  have hthree_order : orderOf (a5_standardFiveCycle * a5_standardDoubleTransposition) = 3 := by
    -- The product has order three, matching the triangle presentation.
    exact orderOf_eq_prime (p := 3) (hp := ⟨by decide⟩) hpow.2.2 hne.2.2
  exact ⟨hpow.1, hpow.2.1, hpow.2.2,
    hfive_order, htwo_order, hthree_order⟩

/-- Helper for Exercise 18-18.6-3: evaluate a word in the two standard generators of `A₅`. -/
def a5_standardGeneratorWordEval : List Bool → A5
  | [] => 1
  | false :: w => a5_standardFiveCycle * a5_standardGeneratorWordEval w
  | true :: w => a5_standardDoubleTransposition * a5_standardGeneratorWordEval w

/-- Helper for Exercise 18-18.6-3: all boolean words of a fixed length. -/
def boolWordsOfLength : Nat → List (List Bool)
  | 0 => [[]]
  | n + 1 => List.flatMap (fun w => [false :: w, true :: w]) (boolWordsOfLength n)

/-- Helper for Exercise 18-18.6-3: all boolean words of length at most `n`. -/
def boolWordsUpTo (n : Nat) : List (List Bool) :=
  List.flatMap boolWordsOfLength (List.range (n + 1))

set_option maxRecDepth 100000 in
/-- Helper for Exercise 18-18.6-3: words of length at most `15` in the standard generators
hit every element of `A₅`. -/
theorem a5_standardGeneratorWordEval_surjective :
    ∀ g : A5, ∃ w ∈ boolWordsUpTo 15, a5_standardGeneratorWordEval w = g := by
  -- This finite computation records the concrete generation data while keeping subgroup
  -- membership out of the decidable proposition.
  decide

/-- Helper for Exercise 18-18.6-3: every evaluated standard-generator word lies in the subgroup
generated by the standard five-cycle and double transposition. -/
theorem a5_standardGeneratorWordEval_mem_closure (w : List Bool) :
    a5_standardGeneratorWordEval w ∈
      Subgroup.closure
        ({a5_standardFiveCycle, a5_standardDoubleTransposition} : Set A5) := by
  -- Induct on the word and add one generator at a time to the generated subgroup.
  induction w with
  | nil =>
      simp [a5_standardGeneratorWordEval]
  | cons b w ih =>
      cases b
      · have hgen :
            a5_standardFiveCycle ∈
              Subgroup.closure
                ({a5_standardFiveCycle, a5_standardDoubleTransposition} : Set A5) :=
          have hmem :
              a5_standardFiveCycle ∈
                ({a5_standardFiveCycle, a5_standardDoubleTransposition} : Set A5) := by
            simp
          Subgroup.subset_closure hmem
        exact Subgroup.mul_mem _ hgen ih
      · have hgen :
            a5_standardDoubleTransposition ∈
              Subgroup.closure
                ({a5_standardFiveCycle, a5_standardDoubleTransposition} : Set A5) :=
          have hmem :
              a5_standardDoubleTransposition ∈
                ({a5_standardFiveCycle, a5_standardDoubleTransposition} : Set A5) := by
            simp
          Subgroup.subset_closure hmem
        exact Subgroup.mul_mem _ hgen ih

/-- Helper for Exercise 18-18.6-3: the standard five-cycle and double transposition generate
`A₅`. -/
theorem a5_standardGenerators_closure_eq_top :
    Subgroup.closure
        ({a5_standardFiveCycle, a5_standardDoubleTransposition} : Set A5) = ⊤ := by
  ext g
  constructor
  · intro _hg
    simp
  · intro _hg
    -- Choose a computed standard-generator word for `g`, then use the word-membership lemma.
    rcases a5_standardGeneratorWordEval_surjective g with ⟨w, _hw, hwg⟩
    rw [← hwg]
    exact a5_standardGeneratorWordEval_mem_closure w

/-- Helper for Exercise 18-18.6-3: two homomorphisms out of `A₅` are equal when they agree on
the standard five-cycle and double transposition. -/
theorem a5_hom_ext_of_standard_generators {H : Type*} [Group H]
    (φ ψ : A5 →* H)
    (hfive : φ a5_standardFiveCycle = ψ a5_standardFiveCycle)
    (htwo : φ a5_standardDoubleTransposition = ψ a5_standardDoubleTransposition) :
    φ = ψ := by
  ext g
  have hg :
      g ∈
        Subgroup.closure
          ({a5_standardFiveCycle, a5_standardDoubleTransposition} : Set A5) := by
    rw [a5_standardGenerators_closure_eq_top]
    simp
  -- Closure induction propagates equality from the two generators to every element of `A₅`.
  refine Subgroup.closure_induction (p := fun h _ ↦ φ h = ψ h) ?_ ?_ ?_ ?_ hg
  · intro h hh
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hh
    rcases hh with rfl | rfl
    · exact hfive
    · exact htwo
  · simp
  · intro _ _ _ _ ha hb
    simp [ha, hb]
  · intro _ _ ha
    simp [ha]

/-- Helper for Exercise 18-18.6-3: a vector fixed by the two standard generators is fixed by
all of `A₅`. -/
theorem a5_fixed_of_fixed_standard_generators
    {k : Type*} [Semiring k]
    {V : Type*} [AddCommMonoid V] [Module k V]
    (ρ : Representation k A5 V) {x : V}
    (hfive : ρ a5_standardFiveCycle x = x)
    (htwo : ρ a5_standardDoubleTransposition x = x) :
    ∀ g : A5, ρ g x = x := by
  intro g
  have hg :
      g ∈
        Subgroup.closure
          ({a5_standardFiveCycle, a5_standardDoubleTransposition} : Set A5) := by
    rw [a5_standardGenerators_closure_eq_top]
    simp
  -- Closure induction propagates fixedness from the standard generators to every word in them.
  refine Subgroup.closure_induction (p := fun h _ ↦ ρ h x = x) ?_ ?_ ?_ ?_ hg
  · intro h hh
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hh
    rcases hh with rfl | rfl
    · exact hfive
    · exact htwo
  · simp
  · intro a b _ _ ha hb
    calc
      ρ (a * b) x = ρ a (ρ b x) := by simp
      _ = ρ a x := by rw [hb]
      _ = x := ha
  · intro a _ ha
    calc
      ρ a⁻¹ x = ρ a⁻¹ (ρ a x) := by rw [ha]
      _ = ρ (a⁻¹ * a) x := by simp
      _ = x := by simp

end Representation
