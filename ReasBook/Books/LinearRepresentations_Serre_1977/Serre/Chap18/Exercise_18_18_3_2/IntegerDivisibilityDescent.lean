section IntegerDivisibilityDescent

variable {p : ℕ}

section LocalRing

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
variable [Fact p.Prime] [CharZero A] [CharP (IsLocalRing.ResidueField A) p]

/-- Bounded integer descent inside a mixed-characteristic local domain: if an integer cast to `A`
is an `A`-multiple of `p ^ e`, then it was already an integer multiple of `p ^ e`. -/
theorem int_prime_pow_dvd_of_intCast_eq_mul_natCast_pow
    (e : ℕ) {m : ℤ} {a : A}
    (h : (m : A) = a * ((p ^ e : ℕ) : A)) :
    ((p ^ e : ℕ) : ℤ) ∣ m := by
  induction e generalizing m a with
  | zero =>
      simp
  | succ e ih =>
      have hres : (m : IsLocalRing.ResidueField A) = 0 := by
        have hres' := congrArg (IsLocalRing.residue A) h
        simpa [map_mul, pow_succ, mul_assoc] using hres'
      have hp_dvd_m : (p : ℤ) ∣ m :=
        (CharP.intCast_eq_zero_iff (IsLocalRing.ResidueField A) p m).mp hres
      rcases hp_dvd_m with ⟨m', hm'⟩
      have hpA_ne : ((p : ℕ) : A) ≠ 0 := by
        exact_mod_cast (Fact.out : Nat.Prime p).ne_zero
      have hcancel :
          (m' : A) * (p : A) =
            (a * ((p ^ e : ℕ) : A)) * (p : A) := by
        simpa [hm', pow_succ, mul_assoc, mul_comm, mul_left_comm] using h
      have hstep : (m' : A) = a * ((p ^ e : ℕ) : A) :=
        mul_right_cancel₀ hpA_ne hcancel
      rcases ih (m := m') (a := a) hstep with ⟨b, hb⟩
      refine ⟨b, ?_⟩
      simp [hm', hb, pow_succ, mul_comm, mul_left_comm]

end LocalRing

section PrimeToPUnits

variable {A : Type u} [CommRing A] [IsLocalRing A]
variable [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]

/-- Helper for Exercise 18-18.3-2: an integer prime to the residue characteristic is a unit in a
local ring. -/
theorem natCast_isUnit_of_coprime_residue_char
    (n : ℕ) (hn : Nat.Coprime n p) :
    IsUnit (n : A) := by
  -- A nonzero residue is a unit in a local ring; residue characteristic detects exactly
  -- divisibility by `p` for natural-number casts.
  rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
  intro hzero
  have hpdvd : p ∣ n :=
    (CharP.cast_eq_zero_iff (IsLocalRing.ResidueField A) p n).mp (by simpa using hzero)
  exact (Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime p)).mp hn.symm hpdvd

end PrimeToPUnits

section FractionField

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
variable {K : Type u} [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
variable [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]

/-- Bounded fraction-field descent: if an integer, cast to the fraction field `K` of a
mixed-characteristic local domain `A`, lies in the `A`-span of the cast generator `p ^ e`, then
`p ^ e` divides the integer in `ℤ`. -/
theorem int_prime_pow_dvd_of_intCast_mem_span_algebraMap
    (e : ℕ) {m : ℤ}
    (hmem :
      (m : K) ∈
        Submodule.span A ({algebraMap A K ((p ^ e : ℕ) : A)} : Set K)) :
    ((p ^ e : ℕ) : ℤ) ∣ m := by
  letI : CharZero A := (algebraMap A K).charZero
  rcases Submodule.mem_span_singleton.mp hmem with ⟨a, ha⟩
  have hK :
      algebraMap A K (m : A) =
        algebraMap A K (a * ((p ^ e : ℕ) : A)) := by
    calc
      algebraMap A K (m : A) = (m : K) := by
        simp
      _ = a • algebraMap A K ((p ^ e : ℕ) : A) := ha.symm
      _ = algebraMap A K (a * ((p ^ e : ℕ) : A)) := by
        rw [Algebra.smul_def, map_mul]
  have hA : (m : A) = a * ((p ^ e : ℕ) : A) :=
    IsFractionRing.injective A K hK
  exact int_prime_pow_dvd_of_intCast_eq_mul_natCast_pow
    (p := p) (A := A) e hA

/-- Descent from an `A`-span generated by any known `p`-power. -/
theorem int_dvd_of_intCast_mem_span_algebraMap_of_eq_prime_pow
    {n e : ℕ} (hn : n = p ^ e) {m : ℤ}
    (hmem :
      (m : K) ∈ Submodule.span A ({algebraMap A K (n : A)} : Set K)) :
    (n : ℤ) ∣ m := by
  subst n
  exact int_prime_pow_dvd_of_intCast_mem_span_algebraMap
    (p := p) (A := A) (K := K) e hmem

/-- Helper for Exercise 18-18.3-2: if an integer is in the fraction-field `A`-span of an
arbitrary nonzero integer `d`, then the `p`-part of `d` already divides that integer over `ℤ`. -/
theorem int_pPart_dvd_of_intCast_mem_span_algebraMap
    {d : ℕ} (hd : d ≠ 0) {m : ℤ}
    (hmem :
      (m : K) ∈ Submodule.span A ({algebraMap A K (d : A)} : Set K)) :
    ((p ^ d.factorization p : ℕ) : ℤ) ∣ m := by
  let q : ℕ := ordCompl[p] d
  have hq_coprime : Nat.Coprime q p := by
    simpa [q] using (Nat.coprime_ordCompl (Fact.out : Nat.Prime p) hd).symm
  have hfactor : p ^ d.factorization p * q = d := by
    simpa [q] using Nat.ordProj_mul_ordCompl_eq_self d p
  rcases Submodule.mem_span_singleton.mp hmem with ⟨a, ha⟩
  have hmem_pow :
      (m : K) ∈
        Submodule.span A ({algebraMap A K ((p ^ d.factorization p : ℕ) : A)} : Set K) := by
    rw [Submodule.mem_span_singleton]
    refine ⟨a * (q : A), ?_⟩
    -- The prime-to-`p` part `q` is a unit in `A`, so the `A`-span generated by `d`
    -- is the same as the span generated by the `p`-part of `d`.
    calc
      (a * (q : A)) • algebraMap A K ((p ^ d.factorization p : ℕ) : A) =
          a • algebraMap A K (d : A) := by
            rw [Algebra.smul_def, Algebra.smul_def, map_mul]
            have hcast : (((p ^ d.factorization p : ℕ) : A) * (q : A)) = (d : A) := by
              rw [← Nat.cast_mul, hfactor]
            rw [mul_assoc, mul_comm (algebraMap A K (q : A))]
            rw [← map_mul, hcast]
      _ = (m : K) := ha
  exact int_prime_pow_dvd_of_intCast_mem_span_algebraMap
    (p := p) (A := A) (K := K) (d.factorization p) hmem_pow

/-- Helper for Exercise 18-18.3-2: rank-one prime-to-`p` denominator clearing for a nonzero
integer generator. -/
theorem exists_coprime_nsmul_mem_span_singleton_natCast_int_of_intCast_mem_span_algebraMap
    {d : ℕ} (hd : d ≠ 0) {m : ℤ}
    (hmem :
      (m : K) ∈ Submodule.span A ({algebraMap A K (d : A)} : Set K)) :
    ∃ n : ℕ, Nat.Coprime n p ∧
      n • m ∈ Submodule.span ℤ ({(d : ℤ)} : Set ℤ) := by
  let q : ℕ := ordCompl[p] d
  refine ⟨q, ?_, ?_⟩
  · simpa [q] using (Nat.coprime_ordCompl (Fact.out : Nat.Prime p) hd).symm
  · rcases int_pPart_dvd_of_intCast_mem_span_algebraMap
        (p := p) (A := A) (K := K) (d := d) hd hmem with
      ⟨b, hb⟩
    rw [Submodule.mem_span_singleton]
    refine ⟨b, ?_⟩
    have hfactor : p ^ d.factorization p * q = d := by
      simpa [q] using Nat.ordProj_mul_ordCompl_eq_self d p
    -- Multiplying by the prime-to-`p` part upgrades divisibility by the `p`-part to
    -- divisibility by the original integer `d`.
    calc
      b • (d : ℤ) = b * (d : ℤ) := by simp
      _ = b * (((p ^ d.factorization p : ℕ) : ℤ) * (q : ℤ)) := by
          have hcast : (((p ^ d.factorization p * q : ℕ) : ℤ)) = (d : ℤ) := by
            exact_mod_cast hfactor
          rw [← hcast]
          simp
      _ = (q : ℤ) * (((p ^ d.factorization p : ℕ) : ℤ) * b) := by ring
      _ = (q : ℤ) * m := by rw [hb]
      _ = q • m := by simp

end FractionField

section RegularValueDivisibility

variable {A : Type u} [CommRing A] [IsLocalRing A] [HenselianLocalRing A] [IsDomain A]
variable [IsDiscreteValuationRing A]
variable {K : Type u} [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
variable {G : Type u} [Group G] [Finite G]
variable [Fact p.Prime] [IsAlgClosed (IsLocalRing.ResidueField A)]
variable [CharP (IsLocalRing.ResidueField A) p]

local instance instFintypePRegularConjClassIntegerDivisibilityDescent :
    Fintype (PRegularConjClass G p) :=
  Fintype.ofFinite (PRegularConjClass G p)

/-- Coordinatewise descent from Serre's `A`-valued regular divisibility lattice: if an
integer-valued regular-class function becomes an element of the fraction-field lattice after
casting, then each integer coordinate is divisible by the corresponding centralizer `p`-part. -/
theorem centralizerPPart_dvd_of_regularIntegerFunctionCast_mem_regularValueDivisibilitySubmodule
    {f : PRegularConjClass G p → ℤ}
    (hf :
      regularIntegerFunctionCast (p := p) (K := K) (G := G) f ∈
        regularValueDivisibilitySubmodule (p := p) (A := A) (K := K) (G := G))
    (c : PRegularConjClass G p) :
    (ConjClasses.centralizerPPart p c.1 : ℤ) ∣ f c := by
  rcases (mem_regularValueDivisibilitySubmodule_iff
      (p := p) (A := A) (K := K) (G := G)
      (regularIntegerFunctionCast (p := p) (K := K) (G := G) f)).1 hf c with
    ⟨a, ha⟩
  have hmem :
      ((f c : ℤ) : K) ∈
        Submodule.span A
          ({algebraMap A K (ConjClasses.centralizerPPart p c.1 : A)} : Set K) := by
    rw [Submodule.mem_span_singleton]
    refine ⟨a, ?_⟩
    calc
      a • algebraMap A K (ConjClasses.centralizerPPart p c.1 : A) =
          algebraMap A K ((ConjClasses.centralizerPPart p c.1 : A) * a) := by
            rw [Algebra.smul_def, map_mul, mul_comm]
      _ = (regularIntegerFunctionCast (p := p) (K := K) (G := G) f) c := ha.symm
      _ = ((f c : ℤ) : K) := rfl
  obtain ⟨e, he⟩ := ConjClasses.centralizerPPart_eq_prime_pow (p := p) c.1
  have hmem_pow :
      ((f c : ℤ) : K) ∈
        Submodule.span A ({algebraMap A K ((p ^ e : ℕ) : A)} : Set K) := by
    simpa [he] using hmem
  have hdvd :
      ((p ^ e : ℕ) : ℤ) ∣ f c :=
    int_prime_pow_dvd_of_intCast_mem_span_algebraMap
      (p := p) (A := A) (K := K) e hmem_pow
  simpa [he] using hdvd

/-- The cast of an integer-valued regular-class function lies in Serre's fraction-field regular
divisibility lattice only if the original function lies in the integer diagonal lattice. -/
theorem regularIntegerFunctionCast_mem_regularIntegerDiagonalSubmodule_of_mem_regularValue
    {f : PRegularConjClass G p → ℤ}
    (hf :
      regularIntegerFunctionCast (p := p) (K := K) (G := G) f ∈
        regularValueDivisibilitySubmodule (p := p) (A := A) (K := K) (G := G)) :
    f ∈ regularIntegerDiagonalSubmodule (p := p) (G := G) := by
  refine (mem_regularIntegerDiagonalSubmodule_iff (p := p) (G := G) f).2 ?_
  intro c
  exact centralizerPPart_dvd_of_regularIntegerFunctionCast_mem_regularValueDivisibilitySubmodule
    (p := p) (A := A) (K := K) (G := G) hf c

/-- The fraction-field regular divisibility lattice is pure on cast integer-valued functions. -/
theorem regularIntegerFunctionCast_mem_regularValueDivisibilitySubmodule_iff
    {f : PRegularConjClass G p → ℤ} :
    regularIntegerFunctionCast (p := p) (K := K) (G := G) f ∈
        regularValueDivisibilitySubmodule (p := p) (A := A) (K := K) (G := G) ↔
      f ∈ regularIntegerDiagonalSubmodule (p := p) (G := G) := by
  constructor
  · exact
      regularIntegerFunctionCast_mem_regularIntegerDiagonalSubmodule_of_mem_regularValue
        (p := p) (A := A) (K := K) (G := G)
  · intro hf
    refine (mem_regularValueDivisibilitySubmodule_iff
      (p := p) (A := A) (K := K) (G := G) _).2 ?_
    intro c
    rcases (mem_regularIntegerDiagonalSubmodule_iff (p := p) (G := G) f).1 hf c with
      ⟨a, ha⟩
    refine ⟨(a : A), ?_⟩
    simp [regularIntegerFunctionCast, ha]

end RegularValueDivisibility

end IntegerDivisibilityDescent

