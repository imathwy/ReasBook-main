import LinearRepresentations_Serre_1977.Chap18.Exercise_18_18_3_2.CanonicalSourceProductImageEndpoint

noncomputable section

open CategoryTheory
open scoped BigOperators MonoidAlgebra Representation TensorProduct ZeroObject

universe u

namespace Representation

section ReversePointSourceEndpoint

variable {p : ℕ}
variable {A : Type u} [CommRing A] [IsLocalRing A] [HenselianLocalRing A]
variable {K : Type u} [Field K] [Algebra A K] [IsFractionRing A K]
variable {G : Type u} [Group G] [Finite G]
variable [IsDomain A] [IsDiscreteValuationRing A]
variable [IsAdicComplete (IsLocalRing.maximalIdeal A) A]
variable [Fact p.Prime] [IsAlgClosed (IsLocalRing.ResidueField A)]
variable [CharP (IsLocalRing.ResidueField A) p] [CharZero K]
variable [HasEnoughRootsOfUnity K (Monoid.exponent G)]

local instance reversePointSourceEndpointFintypePRegularConjClass :
    Fintype (PRegularConjClass G p) :=
  Fintype.ofFinite (PRegularConjClass G p)

local instance reversePointSourceEndpointDecidableEqPRegularConjClass :
    DecidableEq (PRegularConjClass G p) :=
  Classical.decEq _

/-- The point-source witness statement is exactly the statement that every integer point-mass
class in Serre's displayed product lies in the canonical virtual-modular Cartan product range.

This is the non-fixed-witness endpoint: the witness on the right is an arbitrary preimage in
`R₀[IsLocalRing.ResidueField A](G)`, not the fixed coordinate vector `[π c]₀`. -/
theorem canonicalVirtualModularCartanProductReversePointSourceCongruence_iff_single_mem_range :
    canonicalVirtualModularCartanProductReversePointSourceCongruence
        (p := p) (A := A) (K := K) (G := G) ↔
      ∀ c : PRegularConjClass G p,
        regularIntegerDiagonalQuotientToIntegerImageProduct
            (p := p) (A := A) (K := K) (G := G)
            (QuotientAddGroup.mk'
              (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup
              (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ)) ∈
          (cartanCokernelToCanonicalVirtualModularCartanProduct
            (p := p) (A := A) (K := K) (G := G)).range := by
  constructor
  · intro hpoint c
    exact
      (canonicalVirtualModularCartanProduct_single_mem_range_iff_source_congruence
        (p := p) (A := A) (K := K) (G := G) c).2 (hpoint c)
  · intro hmem c
    exact
      (canonicalVirtualModularCartanProduct_single_mem_range_iff_source_congruence
        (p := p) (A := A) (K := K) (G := G) c).1 (hmem c)

omit [IsFractionRing A K] [CharZero K] [HasEnoughRootsOfUnity K (Monoid.exponent G)] in
/-- The point-source statement is equivalent to the reverse source congruence for every integer
regular-class function, since the latter is generated by the point masses. -/
theorem canonicalVirtualModularCartanProductReversePointSourceCongruence_iff_reverse_source_congruence :
    canonicalVirtualModularCartanProductReversePointSourceCongruence
        (p := p) (A := A) (K := K) (G := G) ↔
      ∀ g : PRegularConjClass G p → ℤ,
        ∃ x : R₀[IsLocalRing.ResidueField A](G),
          regularIntegerFunctionCast (p := p) (K := K) (G := G) g -
            virtualModularCharacterOnPRegularConjClass
              (p := p) (A := K) (G := G)
              (PrimeToPRoot.toFieldLift
                (projectiveCartanASpanFieldLift (p := p) (A := A) (K := K))) x ∈
              canonicalVirtualModularCartanRangeASpan
                (p := p) (A := A) (K := K) (G := G) := by
  constructor
  · exact
      canonicalVirtualModularCartanProduct_reverseSourceCongruence_of_reverse_point_source_congruence
        (p := p) (A := A) (K := K) (G := G)
  · intro hreverse c
    exact hreverse (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ)

omit [IsFractionRing A K] [CharZero K] [HasEnoughRootsOfUnity K (Monoid.exponent G)] in
/-- The source-congruence package contains the point-source statement as its reverse half. -/
theorem canonicalVirtualModularCartanProductReversePointSourceCongruence_of_imageSourceCongruences
    (hsource :
      canonicalVirtualModularCartanProductImageSourceCongruences
        (p := p) (A := A) (K := K) (G := G)) :
    canonicalVirtualModularCartanProductReversePointSourceCongruence
      (p := p) (A := A) (K := K) (G := G) := by
  intro c
  exact hsource.2 (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ)

/-- The representative-level reverse half of an image-match proof implies the point-source
statement. -/
theorem canonicalVirtualModularCartanProductReversePointSourceCongruence_of_reverseRepresentative
    (hreverse :
      ∀ g : PRegularConjClass G p → ℤ,
        ∃ x : R₀[IsLocalRing.ResidueField A](G),
          regularIntegerDiagonalQuotientToIntegerImageProduct
              (p := p) (A := A) (K := K) (G := G)
              (QuotientAddGroup.mk'
                (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup g) =
            cartanCokernelToCanonicalVirtualModularCartanProduct
              (p := p) (A := A) (K := K) (G := G)
              (QuotientAddGroup.mk' (cartanHom (IsLocalRing.ResidueField A) G).range x)) :
    canonicalVirtualModularCartanProductReversePointSourceCongruence
      (p := p) (A := A) (K := K) (G := G) := by
  refine
    (canonicalVirtualModularCartanProductReversePointSourceCongruence_iff_single_mem_range
      (p := p) (A := A) (K := K) (G := G)).2 ?_
  intro c
  rcases hreverse (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ) with ⟨x, hx⟩
  exact
    ⟨QuotientAddGroup.mk' (cartanHom (IsLocalRing.ResidueField A) G).range x, hx.symm⟩

/-- A range inclusion from the coordinatewise integer image into the canonical source-product
image is the precise image-level hypothesis needed for the point-source witnesses. -/
theorem canonicalVirtualModularCartanProductReversePointSourceCongruence_of_integerImage_le_productRange
    (hrange :
      (regularIntegerDiagonalQuotientToIntegerImageProduct
          (p := p) (A := A) (K := K) (G := G)).range ≤
        (cartanCokernelToCanonicalVirtualModularCartanProduct
          (p := p) (A := A) (K := K) (G := G)).range) :
    canonicalVirtualModularCartanProductReversePointSourceCongruence
      (p := p) (A := A) (K := K) (G := G) := by
  refine
    (canonicalVirtualModularCartanProductReversePointSourceCongruence_iff_single_mem_range
      (p := p) (A := A) (K := K) (G := G)).2 ?_
  intro c
  exact hrange
    ⟨QuotientAddGroup.mk'
      (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup
      (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ), rfl⟩

/-- In particular, equality of the two concrete images supplies the point-source witnesses. -/
theorem canonicalVirtualModularCartanProductReversePointSourceCongruence_of_productRange_eq_integerImage
    (hrange :
      (cartanCokernelToCanonicalVirtualModularCartanProduct
          (p := p) (A := A) (K := K) (G := G)).range =
        (regularIntegerDiagonalQuotientToIntegerImageProduct
          (p := p) (A := A) (K := K) (G := G)).range) :
    canonicalVirtualModularCartanProductReversePointSourceCongruence
      (p := p) (A := A) (K := K) (G := G) := by
  refine
    canonicalVirtualModularCartanProductReversePointSourceCongruence_of_integerImage_le_productRange
      (p := p) (A := A) (K := K) (G := G) ?_
  intro y hy
  simpa [hrange] using hy

end ReversePointSourceEndpoint

end Representation
