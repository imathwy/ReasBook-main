import LinearRepresentations_Serre_1977.Serre.Chap18.Exercise_18_18_3_2.EisensteinAdjoinRootDVR
import LinearRepresentations_Serre_1977.Serre.Chap14.Exercise_14_14_4_6.AdicNewtonIdempotent

/-!
# Adic completeness for Eisenstein `AdjoinRoot`

This file supplies the completeness part of the Eisenstein `AdjoinRoot` package.  The base
complete Noetherian ring gives completeness for the finite `AdjoinRoot` module, and a cofinality
comparison transfers this from the extended base ideal to the root ideal and, in the local case,
to the maximal ideal of the `AdjoinRoot`.
-/

noncomputable section

universe u

namespace Representation

open Polynomial

section CofinalIdeals

variable {A : Type u} [CommRing A]

private theorem ideal_pow_mul_le_of_pow_le {I J : Ideal A} {d : ℕ}
    (hJI : J ^ d ≤ I) (n : ℕ) : J ^ (d * n) ≤ I ^ n := by
  simpa [pow_mul] using pow_le_pow_left' hJI n

/-- If two ideal filtrations are cofinal in the form `I ≤ J` and `J ^ c ≤ I`, then
`I`-adic completeness implies `J`-adic completeness. -/
theorem isAdicComplete_of_ideal_le_of_pow_le {I J : Ideal A}
    [IsAdicComplete I A] (hIJ : I ≤ J) (hJI : ∃ c : ℕ, J ^ c ≤ I) :
    IsAdicComplete J A := by
  rcases hJI with ⟨c, hc⟩
  let d : ℕ := c + 1
  have hd_pos : 0 < d := Nat.succ_pos c
  have hdJI : J ^ d ≤ I := (Ideal.pow_le_pow_right (Nat.le_succ c)).trans hc
  refine { toIsHausdorff := ?_, toIsPrecomplete := ?_ }
  · constructor
    intro x hx
    apply IsHausdorff.haus (inferInstance : IsHausdorff I A) x
    intro n
    rw [SModEq.zero]
    have hxJ : x ∈ (J ^ (d * n) • ⊤ : Submodule A A) :=
      SModEq.zero.mp (hx (d * n))
    exact (Submodule.smul_mono (ideal_pow_mul_le_of_pow_le hdJI n) le_rfl) hxJ
  · constructor
    intro f hf
    have hsub_cauchy : ∀ {m n : ℕ}, m ≤ n →
        f (d * m) ≡ f (d * n) [SMOD (I ^ m • ⊤ : Submodule A A)] := by
      intro m n hmn
      have hJ : f (d * m) ≡ f (d * n)
          [SMOD (J ^ (d * m) • ⊤ : Submodule A A)] :=
        hf (Nat.mul_le_mul_left d hmn)
      exact SModEq.mono
        (Submodule.smul_mono (ideal_pow_mul_le_of_pow_le hdJI m) le_rfl) hJ
    obtain ⟨L, hL⟩ := IsPrecomplete.prec (inferInstance : IsPrecomplete I A) hsub_cauchy
    refine ⟨L, fun n => ?_⟩
    have hfn : f n ≡ f (d * n) [SMOD (J ^ n • ⊤ : Submodule A A)] :=
      hf (Nat.le_mul_of_pos_left n hd_pos)
    have hLJ : f (d * n) ≡ L [SMOD (J ^ n • ⊤ : Submodule A A)] := by
      exact SModEq.mono
        (Submodule.smul_mono (pow_le_pow_left' hIJ n) le_rfl) (hL n)
    exact hfn.trans hLJ

end CofinalIdeals

section FiniteAdjoinRoot

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
variable [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
variable {f : R[X]}

/-- A monic `AdjoinRoot` finite over a complete Noetherian local base is complete for the
extended base maximal ideal. -/
theorem adjoinRoot_isAdicComplete_map_maximalIdeal_of_monic (hmonic : f.Monic) :
    IsAdicComplete
      ((IsLocalRing.maximalIdeal R).map (algebraMap R (AdjoinRoot f))) (AdjoinRoot f) := by
  haveI : Module.Finite R (AdjoinRoot f) := hmonic.finite_adjoinRoot
  have hbase :
      IsAdicComplete (IsLocalRing.maximalIdeal R) (AdjoinRoot f) :=
    isAdicComplete_of_module_finite (IsLocalRing.maximalIdeal R)
  exact
    (IsAdicComplete.map_algebraMap_iff
      (I := IsLocalRing.maximalIdeal R) (S := AdjoinRoot f) (M := AdjoinRoot f)).mpr hbase

end FiniteAdjoinRoot

section RootCofinality

variable {R : Type u} [CommRing R]
variable {f : R[X]}

/-- The constant coefficient of `f` maps into the ideal generated by the adjoined root. -/
theorem adjoinRoot_algebraMap_coeff_zero_mem_span_root :
    algebraMap R (AdjoinRoot f) (f.coeff 0) ∈
      Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) := by
  have hX : f - C (f.coeff 0) ∈ Ideal.span ({X} : Set R[X]) := by
    rw [Ideal.mem_span_singleton]
    exact Polynomial.X_dvd_sub_C
  have hmap :
      AdjoinRoot.mk f (f - C (f.coeff 0)) ∈
        (Ideal.span ({X} : Set R[X])).map (AdjoinRoot.mk f) :=
    Ideal.mem_map_of_mem (AdjoinRoot.mk f) hX
  rw [← adjoinRoot_span_root_eq_map_span_X f] at hmap
  have hmk :
      AdjoinRoot.mk f (f - C (f.coeff 0)) =
        -algebraMap R (AdjoinRoot f) (f.coeff 0) := by
    rw [map_sub, AdjoinRoot.mk_self, AdjoinRoot.mk_C, AdjoinRoot.algebraMap_eq, zero_sub]
  have hneg : -algebraMap R (AdjoinRoot f) (f.coeff 0) ∈
      Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) := by
    rwa [hmk] at hmap
  simpa using (neg_mem_iff.mp hneg)

variable [IsDomain R] [IsDiscreteValuationRing R]

/-- For a positive-degree Eisenstein polynomial over a DVR, the extended base maximal ideal is
contained in the root ideal. -/
theorem adjoinRoot_map_maximalIdeal_le_span_root_of_eisenstein_of_complete
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hdeg : 0 < f.natDegree) :
    (IsLocalRing.maximalIdeal R).map (algebraMap R (AdjoinRoot f)) ≤
      Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) := by
  rw [← eisenstein_coeff_zero_span_eq_maximalIdeal_of_dvr hf hdeg]
  rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem]
  exact adjoinRoot_algebraMap_coeff_zero_mem_span_root (R := R) (f := f)

/-- The root ideal has a power contained in the extended base maximal ideal.  The exponent is the
degree of the Eisenstein polynomial. -/
theorem adjoinRoot_span_root_pow_natDegree_le_map_maximalIdeal_of_eisenstein
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hmonic : f.Monic) :
    (Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f))) ^ f.natDegree ≤
      (IsLocalRing.maximalIdeal R).map (algebraMap R (AdjoinRoot f)) := by
  rw [Ideal.span_singleton_pow, Ideal.span_singleton_le_iff_mem]
  exact
    hf.isWeaklyEisensteinAt.pow_natDegree_le_of_aeval_zero_of_monic_mem_map
      (S := AdjoinRoot f) (x := AdjoinRoot.root f)
      (by rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]) hmonic f.natDegree natDegree_map_le

/-- The standard cofinality comparison between the root ideal and the extended base maximal ideal
for a monic positive-degree Eisenstein polynomial over a DVR. -/
theorem adjoinRoot_eisenstein_root_maximalIdeal_cofinal
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hmonic : f.Monic)
    (hdeg : 0 < f.natDegree) :
    (Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f))) ^ f.natDegree ≤
        (IsLocalRing.maximalIdeal R).map (algebraMap R (AdjoinRoot f)) ∧
      (IsLocalRing.maximalIdeal R).map (algebraMap R (AdjoinRoot f)) ≤
        Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) :=
  ⟨adjoinRoot_span_root_pow_natDegree_le_map_maximalIdeal_of_eisenstein hf hmonic,
    adjoinRoot_map_maximalIdeal_le_span_root_of_eisenstein_of_complete hf hdeg⟩

end RootCofinality

section EisensteinComplete

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable [IsAdicComplete (IsLocalRing.maximalIdeal R) R]
variable {f : R[X]}

/-- A monic positive-degree Eisenstein `AdjoinRoot` over a complete DVR is complete for the root
ideal. -/
theorem adjoinRoot_isAdicComplete_span_root_of_eisenstein
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hmonic : f.Monic)
    (hdeg : 0 < f.natDegree) :
    IsAdicComplete (Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f))) (AdjoinRoot f) := by
  haveI :
      IsAdicComplete
        ((IsLocalRing.maximalIdeal R).map (algebraMap R (AdjoinRoot f))) (AdjoinRoot f) :=
    adjoinRoot_isAdicComplete_map_maximalIdeal_of_monic (R := R) (f := f) hmonic
  exact isAdicComplete_of_ideal_le_of_pow_le
    (I := (IsLocalRing.maximalIdeal R).map (algebraMap R (AdjoinRoot f)))
    (J := Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)))
    (adjoinRoot_map_maximalIdeal_le_span_root_of_eisenstein_of_complete hf hdeg)
    ⟨f.natDegree, adjoinRoot_span_root_pow_natDegree_le_map_maximalIdeal_of_eisenstein hf hmonic⟩

/-- In the local case, the maximal ideal of the Eisenstein `AdjoinRoot` is the root ideal, so the
same completeness is maximal-adic completeness. -/
theorem adjoinRoot_isAdicComplete_maximalIdeal_of_eisenstein
    [IsLocalRing (AdjoinRoot f)]
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hmonic : f.Monic)
    (hdeg : 0 < f.natDegree) :
    IsAdicComplete (IsLocalRing.maximalIdeal (AdjoinRoot f)) (AdjoinRoot f) := by
  have hroot :
      Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) =
        IsLocalRing.maximalIdeal (AdjoinRoot f) :=
    IsLocalRing.eq_maximalIdeal (adjoinRoot_span_root_isMaximal_of_eisenstein hf hdeg)
  rw [← hroot]
  exact adjoinRoot_isAdicComplete_span_root_of_eisenstein hf hmonic hdeg

end EisensteinComplete

end Representation
