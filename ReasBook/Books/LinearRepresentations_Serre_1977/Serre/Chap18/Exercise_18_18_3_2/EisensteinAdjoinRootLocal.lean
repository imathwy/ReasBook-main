import LinearRepresentations_Serre_1977.Serre.Chap18.Exercise_18_18_3_2.EisensteinAdjoinRoot
import Mathlib.RingTheory.Ideal.GoingUp

/-!
# Locality of Eisenstein `AdjoinRoot`

This file upgrades the quotient computation in `EisensteinAdjoinRoot` to the local-ring layer:
over a DVR, adjoining a root of a positive-degree Eisenstein polynomial gives a local ring whose
maximal ideal is generated by the adjoined root.
-/

noncomputable section

universe u

namespace Representation

open Polynomial

section Integral

variable {R : Type u} [CommRing R] {f : R[X]}

/-- If the leading coefficient of `f` is a unit, then `AdjoinRoot f` is integral over the base. -/
theorem adjoinRoot_algebra_isIntegral_of_isUnit_leadingCoeff
    (hf : IsUnit f.leadingCoeff) :
    Algebra.IsIntegral R (AdjoinRoot f) := by
  let A := AdjoinRoot f
  have hroot : IsIntegral R (AdjoinRoot.root f) := by
    refine ⟨hf.unit⁻¹ • f, Polynomial.monic_of_isUnit_leadingCoeff_inv_smul hf, ?_⟩
    change (hf.unit⁻¹ • f).eval₂ (algebraMap R A) (AdjoinRoot.root f) = 0
    rw [Units.smul_def, Polynomial.smul_eq_C_mul, eval₂_mul, eval₂_C,
      AdjoinRoot.algebraMap_eq, AdjoinRoot.eval₂_root, mul_zero]
  have hadjoin :
      Algebra.IsIntegral R
        (Algebra.adjoin R ({AdjoinRoot.root f} : Set (AdjoinRoot f))) :=
    Algebra.IsIntegral.adjoin (by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst x
      exact hroot)
  have htop :
      Algebra.IsIntegral R (⊤ : Subalgebra R (AdjoinRoot f)) := by
    rw [AdjoinRoot.adjoinRoot_eq_top] at hadjoin
    exact hadjoin
  exact (Subalgebra.topEquiv (R := R) (A := AdjoinRoot f)).isIntegral_iff.mp htop

end Integral

section EisensteinDVRLocal

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
variable {f : R[X]}

local notation "A" => AdjoinRoot f
local notation "𝔪" => IsLocalRing.maximalIdeal R
local notation "rootIdeal" =>
  Ideal.span ({AdjoinRoot.root f} : Set A)

/-- The base maximal ideal maps into the ideal generated by the adjoined root. -/
theorem adjoinRoot_map_maximalIdeal_le_span_root_of_eisenstein
    (hf : f.IsEisensteinAt 𝔪) (hdeg : 0 < f.natDegree) :
    (IsLocalRing.maximalIdeal R).map (algebraMap R A) ≤ rootIdeal := by
  rw [← eisenstein_coeff_zero_span_eq_maximalIdeal_of_dvr hf hdeg]
  rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_le_iff_mem]
  have hX : f - C (f.coeff 0) ∈ Ideal.span ({X} : Set R[X]) := by
    rw [Ideal.mem_span_singleton]
    exact Polynomial.X_dvd_sub_C
  have hmap :
      AdjoinRoot.mk f (f - C (f.coeff 0)) ∈ rootIdeal := by
    simpa [adjoinRoot_span_root_eq_map_span_X f] using
      (Ideal.mem_map_of_mem (AdjoinRoot.mk f) hX)
  have hneg :
      -(algebraMap R A (f.coeff 0)) ∈ rootIdeal := by
    simpa using hmap
  simpa using (neg_mem_iff.mp hneg)

/-- Every maximal ideal of the Eisenstein `AdjoinRoot` contains the adjoined root. -/
theorem adjoinRoot_root_mem_of_isMaximal_of_eisenstein
    (hf : f.IsEisensteinAt 𝔪) (_hdeg : 0 < f.natDegree)
    {I : Ideal A} (hI : I.IsMaximal) :
    AdjoinRoot.root f ∈ I := by
  let q : A →+* A ⧸ I := Ideal.Quotient.mk I
  let φ : R →+* A ⧸ I := q.comp (algebraMap R A)
  have hlead_unit : IsUnit f.leadingCoeff :=
    IsLocalRing.notMem_maximalIdeal.mp hf.leading
  haveI : Algebra.IsIntegral R A :=
    adjoinRoot_algebra_isIntegral_of_isUnit_leadingCoeff hlead_unit
  letI : I.IsMaximal := hI
  letI : Field (A ⧸ I) := Ideal.Quotient.field I
  have hcomap_max : (I.comap (algebraMap R A)).IsMaximal :=
    Ideal.isMaximal_comap_of_isIntegral_of_isMaximal I
  have hcomap : I.comap (algebraMap R A) = 𝔪 :=
    IsLocalRing.eq_maximalIdeal hcomap_max
  have hpoly : f.map φ = C (φ f.leadingCoeff) * X ^ f.natDegree := by
    ext n
    by_cases hn : n = f.natDegree
    · subst n
      rw [coeff_map, coeff_C_mul_X_pow, if_pos rfl, leadingCoeff]
    · have hcoeff_mem : f.coeff n ∈ I.comap (algebraMap R A) := by
        rw [hcomap]
        exact hf.coeff_mem hn
      have hcoeff_zero : φ (f.coeff n) = 0 := by
        change Ideal.Quotient.mk I (algebraMap R A (f.coeff n)) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact hcoeff_mem
      simp [coeff_map, hcoeff_zero, hn]
  have hroot_eval : f.eval₂ φ (q (AdjoinRoot.root f)) = 0 := by
    have h := Polynomial.hom_eval₂ (p := f) (f := AdjoinRoot.of f) (g := q)
      (x := AdjoinRoot.root f)
    rw [AdjoinRoot.eval₂_root, map_zero] at h
    simpa [φ, AdjoinRoot.algebraMap_eq] using h.symm
  have hmul : φ f.leadingCoeff * q (AdjoinRoot.root f) ^ f.natDegree = 0 := by
    rw [Polynomial.eval₂_eq_eval_map, hpoly] at hroot_eval
    simpa using hroot_eval
  have hlead_ne : φ f.leadingCoeff ≠ 0 := by
    change Ideal.Quotient.mk I (algebraMap R A f.leadingCoeff) ≠ 0
    intro hzero
    apply hf.leading
    rw [← hcomap]
    change algebraMap R A f.leadingCoeff ∈ I
    exact Ideal.Quotient.eq_zero_iff_mem.mp hzero
  have hpow : q (AdjoinRoot.root f) ^ f.natDegree = 0 :=
    (mul_eq_zero.mp hmul).resolve_left hlead_ne
  have hqroot : q (AdjoinRoot.root f) = 0 :=
    eq_zero_of_pow_eq_zero hpow
  exact Ideal.Quotient.eq_zero_iff_mem.mp hqroot

/-- The root ideal is the unique maximal ideal of the Eisenstein `AdjoinRoot`. -/
theorem adjoinRoot_isLocalRing_of_eisenstein
    (hf : f.IsEisensteinAt 𝔪) (hdeg : 0 < f.natDegree) :
    IsLocalRing A := by
  refine IsLocalRing.of_unique_max_ideal ?_
  refine ⟨rootIdeal, adjoinRoot_span_root_isMaximal_of_eisenstein hf hdeg, ?_⟩
  intro I hI
  have hroot_mem : AdjoinRoot.root f ∈ I :=
    adjoinRoot_root_mem_of_isMaximal_of_eisenstein hf hdeg hI
  have hroot_le : rootIdeal ≤ I :=
    by
      rw [Ideal.span_singleton_le_iff_mem]
      exact hroot_mem
  exact ((adjoinRoot_span_root_isMaximal_of_eisenstein hf hdeg).eq_of_le hI.1.1 hroot_le).symm

/-- With any local-ring structure on the Eisenstein `AdjoinRoot`, its maximal ideal is the root
ideal.  In particular this applies to `adjoinRoot_isLocalRing_of_eisenstein`. -/
theorem adjoinRoot_maximalIdeal_eq_span_root_of_eisenstein
    [IsLocalRing A]
    (hf : f.IsEisensteinAt 𝔪) (hdeg : 0 < f.natDegree) :
    IsLocalRing.maximalIdeal A = rootIdeal := by
  exact (IsLocalRing.eq_maximalIdeal
    (adjoinRoot_span_root_isMaximal_of_eisenstein hf hdeg)).symm

/-- Explicit maximal-ideal statement for the local structure constructed above. -/
theorem adjoinRoot_maximalIdeal_eq_span_root_of_eisenstein'
    (hf : f.IsEisensteinAt 𝔪) (hdeg : 0 < f.natDegree) :
    @IsLocalRing.maximalIdeal A _ (adjoinRoot_isLocalRing_of_eisenstein hf hdeg) =
      rootIdeal := by
  letI : IsLocalRing A := adjoinRoot_isLocalRing_of_eisenstein hf hdeg
  exact adjoinRoot_maximalIdeal_eq_span_root_of_eisenstein hf hdeg

end EisensteinDVRLocal

end Representation
