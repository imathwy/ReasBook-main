import LinearRepresentations_Serre_1977.Chap18.Exercise_18_18_3_2.EisensteinAdjoinRoot

/-!
# DVR criterion for Eisenstein `AdjoinRoot`

This file keeps the DVR step separate from the local/root-ideal step.  Once an `AdjoinRoot`
is known to be local and its maximal ideal is generated by the adjoined root, the standard
Mathlib DVR TFAE turns that principal maximal ideal into a discrete valuation ring structure.
-/

noncomputable section

universe u

namespace Representation

open Polynomial

section DVRCriterion

variable {R : Type u} [CommRing R] [IsNoetherianRing R]
variable {f : R[X]}

omit [IsNoetherianRing R] in
/-- If the maximal ideal of a local `AdjoinRoot` is generated by the adjoined root and that root
is nonzero, then the `AdjoinRoot` is not a field. -/
theorem adjoinRoot_not_isField_of_maximalIdeal_eq_span_root
    [IsLocalRing (AdjoinRoot f)]
    (hroot :
      IsLocalRing.maximalIdeal (AdjoinRoot f) =
        Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)))
    (hroot_ne_zero : AdjoinRoot.root f ≠ 0) :
    ¬ IsField (AdjoinRoot f) := by
  intro hfield
  have hbot :
      IsLocalRing.maximalIdeal (AdjoinRoot f) = ⊥ :=
    IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield
  have hspan :
      Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) = ⊥ := by
    rw [← hroot, hbot]
  exact hroot_ne_zero (Ideal.span_singleton_eq_bot.mp hspan)

/-- Conditional DVR criterion for `AdjoinRoot`: in a Noetherian local domain, a non-field whose
maximal ideal is principal is a DVR.  Here the principal generator is the adjoined root. -/
theorem adjoinRoot_isDiscreteValuationRing_of_maximalIdeal_eq_span_root
    [IsDomain (AdjoinRoot f)] [IsLocalRing (AdjoinRoot f)]
    (hroot :
      IsLocalRing.maximalIdeal (AdjoinRoot f) =
        Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)))
    (hroot_ne_zero : AdjoinRoot.root f ≠ 0) :
    IsDiscreteValuationRing (AdjoinRoot f) := by
  have hnotField : ¬ IsField (AdjoinRoot f) :=
    adjoinRoot_not_isField_of_maximalIdeal_eq_span_root
      (R := R) (f := f) hroot hroot_ne_zero
  have hprincipal : (IsLocalRing.maximalIdeal (AdjoinRoot f)).IsPrincipal := by
    rw [hroot]
    exact ⟨AdjoinRoot.root f, rfl⟩
  exact ((IsDiscreteValuationRing.TFAE (AdjoinRoot f) hnotField).out 4 0).mp hprincipal

end DVRCriterion

end Representation
