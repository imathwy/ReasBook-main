import LinearRepresentations_Serre_1977.Chap18.Exercise_18_18_3_2.IntegerDivisibilityDescent
import Mathlib.Data.ZMod.QuotientGroup

noncomputable section

universe u

namespace Representation

section IntegerQuotientImageBasic

variable {A : Type u} [CommRing A]
variable {K : Type u} [Field K] [Algebra A K]

/-- The rank-one `A`-submodule of the fraction field generated by an integer `d`. -/
noncomputable def integerQuotientImageSubmodule (d : ℕ) : Submodule A K :=
  Submodule.span A ({algebraMap A K (d : A)} : Set K)

/-- The additive homomorphism from integers to the quotient by the rank-one `A`-span of `d`. -/
noncomputable def integerQuotientImageHom (d : ℕ) :
    ℤ →+ K ⧸ integerQuotientImageSubmodule (A := A) (K := K) d where
  toFun m := Submodule.Quotient.mk
    (p := integerQuotientImageSubmodule (A := A) (K := K) d) (m : K)
  map_zero' := by
    simp
  map_add' m n := by
    simp [Int.cast_add]

@[simp]
theorem integerQuotientImageHom_apply (d : ℕ) (m : ℤ) :
    integerQuotientImageHom (A := A) (K := K) d m =
      Submodule.Quotient.mk
        (p := integerQuotientImageSubmodule (A := A) (K := K) d) (m : K) := by
  change Submodule.Quotient.mk
      (p := integerQuotientImageSubmodule (A := A) (K := K) d) (m : K) =
    Submodule.Quotient.mk
      (p := integerQuotientImageSubmodule (A := A) (K := K) d) (m : K)
  rfl

@[simp]
theorem mem_integerQuotientImageSubmodule_iff (d : ℕ) {x : K} :
    x ∈ integerQuotientImageSubmodule (A := A) (K := K) d ↔
      ∃ a : A, a • algebraMap A K (d : A) = x := by
  rw [integerQuotientImageSubmodule, Submodule.mem_span_singleton]

/-- If an integer is divisible by `d`, then its class in the quotient by the `A`-span of `d` is
zero. -/
theorem integerQuotientImageHom_eq_zero_of_mem_zmultiples
    (d : ℕ) {m : ℤ} (hm : m ∈ AddSubgroup.zmultiples (d : ℤ)) :
    integerQuotientImageHom (A := A) (K := K) d m = 0 := by
  rw [integerQuotientImageHom_apply, Submodule.Quotient.mk_eq_zero]
  rw [mem_integerQuotientImageSubmodule_iff]
  rcases (Int.mem_zmultiples_iff.mp hm) with ⟨b, hb⟩
  refine ⟨(b : A), ?_⟩
  calc
    (b : A) • algebraMap A K (d : A) = algebraMap A K ((b : A) * (d : A)) := by
      rw [Algebra.smul_def, map_mul]
    _ = algebraMap A K (m : A) := by
      congr 1
      simp [hb, mul_comm]
    _ = (m : K) := by simp

end IntegerQuotientImageBasic

section IntegerQuotientImageMixedCharacteristic

variable {p : ℕ}
variable {A : Type u} [CommRing A] [IsLocalRing A] [IsDomain A]
variable {K : Type u} [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
variable [Fact p.Prime] [CharP (IsLocalRing.ResidueField A) p]

/-- Kernel computation for the quotient by an `A`-span generated by a residue-characteristic
prime power. -/
theorem integerQuotientImageHom_ker_eq_zmultiples_prime_pow (e : ℕ) :
    (integerQuotientImageHom (A := A) (K := K) (p ^ e)).ker =
      AddSubgroup.zmultiples (((p ^ e : ℕ) : ℤ)) := by
  ext m
  constructor
  · intro hm
    rw [AddMonoidHom.mem_ker, integerQuotientImageHom_apply,
      Submodule.Quotient.mk_eq_zero] at hm
    exact Int.mem_zmultiples_iff.mpr
      (int_prime_pow_dvd_of_intCast_mem_span_algebraMap
        (p := p) (A := A) (K := K) e (by
          simpa [integerQuotientImageSubmodule] using hm))
  · intro hm
    exact integerQuotientImageHom_eq_zero_of_mem_zmultiples
      (A := A) (K := K) (p ^ e) hm

/-- Kernel computation for any generator known to be a residue-characteristic prime power. -/
theorem integerQuotientImageHom_ker_eq_zmultiples_of_eq_prime_pow
    {d e : ℕ} (hd : d = p ^ e) :
    (integerQuotientImageHom (A := A) (K := K) d).ker =
      AddSubgroup.zmultiples (d : ℤ) := by
  subst d
  exact integerQuotientImageHom_ker_eq_zmultiples_prime_pow
    (p := p) (A := A) (K := K) e

/-- The range of the integer map into the quotient by the `A`-span of `p ^ e` is additively
`ZMod (p ^ e)`. -/
noncomputable def integerQuotientImageRangeAddEquivZMod_prime_pow (e : ℕ) :
    (integerQuotientImageHom (A := A) (K := K) (p ^ e)).range ≃+
      ZMod (p ^ e) :=
  (QuotientAddGroup.quotientKerEquivRange
      (integerQuotientImageHom (A := A) (K := K) (p ^ e))).symm.trans
    ((QuotientAddGroup.quotientAddEquivOfEq
        (integerQuotientImageHom_ker_eq_zmultiples_prime_pow
          (p := p) (A := A) (K := K) e)).trans
      (Int.quotientZMultiplesNatEquivZMod (p ^ e)))

/-- The range of the integer map into the quotient by the `A`-span of a known `p`-power generator
is additively `ZMod d`. -/
noncomputable def integerQuotientImageRangeAddEquivZMod_of_eq_prime_pow
    {d e : ℕ} (hd : d = p ^ e) :
    (integerQuotientImageHom (A := A) (K := K) d).range ≃+ ZMod d := by
  subst d
  exact integerQuotientImageRangeAddEquivZMod_prime_pow
    (p := p) (A := A) (K := K) e

end IntegerQuotientImageMixedCharacteristic

end Representation
