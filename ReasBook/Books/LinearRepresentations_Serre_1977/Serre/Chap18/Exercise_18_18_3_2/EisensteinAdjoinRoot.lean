import LinearRepresentations_Serre_1977.Chap18.Exercise_18_18_3_2.MixedCharacteristicModel

/-!
# `AdjoinRoot` residue-quotient infrastructure for Eisenstein polynomials

This file proves the part of the complete-DVR Eisenstein `AdjoinRoot` package that is available
from quotient algebra alone: quotienting `AdjoinRoot f` by the adjoined root gives the base
quotient by the constant coefficient.  For an Eisenstein polynomial over a DVR, the latter quotient
is the residue field of the base DVR.

The remaining local/DVR gap is not assumed here: to turn this into an equivalence with
`IsLocalRing.ResidueField (AdjoinRoot f)`, one still has to prove that the ideal generated by
`AdjoinRoot.root f` is the maximal ideal of the `AdjoinRoot` ring.
-/

noncomputable section

universe u

namespace Representation

open Polynomial

section QuotientByRoot

variable {R : Type u} [CommRing R]

/-- In `AdjoinRoot f`, the ideal generated by the adjoined root is the image of `(X)`. -/
theorem adjoinRoot_span_root_eq_map_span_X (f : R[X]) :
    Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) =
      (Ideal.span ({X} : Set R[X])).map (AdjoinRoot.mk f) := by
  rw [Ideal.map_span, Set.image_singleton, AdjoinRoot.mk_X]

/-- The two-generator ideal `(f, X)` in `R[X]` is the same as `(C (f.coeff 0), X)`. -/
theorem polynomial_span_self_sup_span_X_eq_span_C_coeff_zero_X (f : R[X]) :
    Ideal.span ({f} : Set R[X]) ⊔ Ideal.span ({X} : Set R[X]) =
      Ideal.span ({C (f.coeff 0), X} : Set R[X]) := by
  rw [Ideal.span_insert]
  apply le_antisymm
  · refine sup_le ?_ ?_
    · rw [Ideal.span_singleton_le_iff_mem]
      have hX : f - C (f.coeff 0) ∈ Ideal.span ({X} : Set R[X]) := by
        rw [Ideal.mem_span_singleton]
        exact Polynomial.X_dvd_sub_C
      have hC :
          C (f.coeff 0) ∈
            Ideal.span ({C (f.coeff 0)} : Set R[X]) ⊔ Ideal.span ({X} : Set R[X]) :=
        Ideal.mem_sup_left (Ideal.mem_span_singleton_self _)
      have hXm :
          f - C (f.coeff 0) ∈
            Ideal.span ({C (f.coeff 0)} : Set R[X]) ⊔ Ideal.span ({X} : Set R[X]) :=
        Ideal.mem_sup_right hX
      simpa [sub_add_cancel] using (Ideal.add_mem _ hXm hC)
    · rw [Ideal.span_singleton_le_iff_mem]
      exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self X)
  · refine sup_le ?_ ?_
    · rw [Ideal.span_singleton_le_iff_mem]
      have hf : f ∈ Ideal.span ({f} : Set R[X]) ⊔ Ideal.span ({X} : Set R[X]) :=
        Ideal.mem_sup_left (Ideal.mem_span_singleton_self f)
      have hX : f - C (f.coeff 0) ∈ Ideal.span ({f} : Set R[X]) ⊔
          Ideal.span ({X} : Set R[X]) := by
        exact Ideal.mem_sup_right (by
          rw [Ideal.mem_span_singleton]
          exact Polynomial.X_dvd_sub_C)
      simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using
        (Ideal.sub_mem _ hf hX)
    · exact le_sup_right

/-- Quotienting `AdjoinRoot f` by the adjoined root gives the base quotient by `f.coeff 0`. -/
noncomputable def adjoinRoot_quotient_span_root_equiv_coeff_zero (f : R[X]) :
    AdjoinRoot f ⧸ Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) ≃+*
      R ⧸ Ideal.span ({f.coeff 0} : Set R) :=
  (Ideal.quotEquivOfEq (adjoinRoot_span_root_eq_map_span_X f)).trans <|
    (DoubleQuot.quotQuotEquivQuotSup (Ideal.span ({f} : Set R[X]))
      (Ideal.span ({X} : Set R[X]))).trans <|
      (Ideal.quotEquivOfEq (by
        simpa using polynomial_span_self_sup_span_X_eq_span_C_coeff_zero_X f)).trans <|
        (Polynomial.quotientSpanCXSubCAlgEquiv (f.coeff 0) (0 : R)).toRingEquiv

end QuotientByRoot

section EisensteinDVR

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- In a DVR, the constant coefficient of a positive-degree Eisenstein polynomial generates the
maximal ideal. -/
theorem eisenstein_coeff_zero_span_eq_maximalIdeal_of_dvr {f : R[X]}
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hdeg : 0 < f.natDegree) :
    Ideal.span ({f.coeff 0} : Set R) = IsLocalRing.maximalIdeal R := by
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hπmax : IsLocalRing.maximalIdeal R = Ideal.span ({π} : Set R) :=
    hπ.maximalIdeal_eq
  have hmem : f.coeff 0 ∈ IsLocalRing.maximalIdeal R := hf.mem hdeg
  have hdiv : π ∣ f.coeff 0 := by
    rwa [hπmax, Ideal.mem_span_singleton] at hmem
  obtain ⟨a, ha⟩ := hdiv
  have ha_unit : IsUnit a := by
    by_contra ha_nonunit
    have ha_mem : a ∈ IsLocalRing.maximalIdeal R :=
      by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        exact ha_nonunit
    have hadiv : π ∣ a := by
      rwa [hπmax, Ideal.mem_span_singleton] at ha_mem
    obtain ⟨b, hb⟩ := hadiv
    exact hf.notMem (by
      rw [hπmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      refine ⟨b, ?_⟩
      rw [ha, hb]
      ring)
  have hassoc : Associated (f.coeff 0) π := by
    rw [ha]
    exact associated_mul_unit_left π a ha_unit
  exact (Ideal.span_singleton_eq_span_singleton.mpr hassoc).trans hπmax.symm

/-- The quotient of `AdjoinRoot f` by its adjoined root is the base residue field for a
positive-degree Eisenstein polynomial over a DVR. -/
noncomputable def adjoinRoot_quotient_span_root_equiv_base_residueField_of_eisenstein {f : R[X]}
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hdeg : 0 < f.natDegree) :
    AdjoinRoot f ⧸ Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)) ≃+*
      IsLocalRing.ResidueField R :=
  (adjoinRoot_quotient_span_root_equiv_coeff_zero f).trans <|
    Ideal.quotEquivOfEq (eisenstein_coeff_zero_span_eq_maximalIdeal_of_dvr hf hdeg)

/-- For a positive-degree Eisenstein polynomial over a DVR, the root ideal has field quotient. -/
theorem adjoinRoot_span_root_isMaximal_of_eisenstein {f : R[X]}
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hdeg : 0 < f.natDegree) :
    (Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f))).IsMaximal := by
  rw [Ideal.Quotient.maximal_ideal_iff_isField_quotient]
  exact
    (adjoinRoot_quotient_span_root_equiv_base_residueField_of_eisenstein hf hdeg).toMulEquiv.isField
      (Field.toIsField _)

/-- Conditional residue-field invariance: once the root ideal is known to be the maximal ideal of
`AdjoinRoot f`, the quotient computation above gives the actual residue-field equivalence. -/
noncomputable def adjoinRoot_residueField_equiv_base_of_maximalIdeal_eq_span_root {f : R[X]}
    [IsLocalRing (AdjoinRoot f)]
    (hroot :
      IsLocalRing.maximalIdeal (AdjoinRoot f) =
        Ideal.span ({AdjoinRoot.root f} : Set (AdjoinRoot f)))
    (hf : f.IsEisensteinAt (IsLocalRing.maximalIdeal R)) (hdeg : 0 < f.natDegree) :
    IsLocalRing.ResidueField (AdjoinRoot f) ≃+* IsLocalRing.ResidueField R :=
  (Ideal.quotEquivOfEq hroot).trans <|
    adjoinRoot_quotient_span_root_equiv_base_residueField_of_eisenstein hf hdeg

end EisensteinDVR

section WittVectorShiftedCyclotomic

variable {p : ℕ} [Fact p.Prime]
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k p]

/-- For Serre's shifted `p`-power cyclotomic polynomial over `W(k)`, quotienting the
`AdjoinRoot` by the adjoined root gives the original residue field `k`. -/
noncomputable def shifted_prime_power_cyclotomic_adjoinRoot_quotient_root_equiv_residue
    (n : ℕ) :
    AdjoinRoot (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n) ⧸
        Ideal.span
          ({AdjoinRoot.root
            (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n)} :
            Set (AdjoinRoot
              (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n))) ≃+* k := by
  have hf :
      (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n).IsEisensteinAt
        (IsLocalRing.maximalIdeal (WittVector p k)) :=
    shifted_prime_power_cyclotomic_isEisenstein_over_wittVector (p := p) (k := k) n
  have hdeg :
      0 < (shifted_prime_power_cyclotomic_polynomial (p := p) (k := k) n).natDegree := by
    dsimp [shifted_prime_power_cyclotomic_polynomial]
    rw [natDegree_comp, natDegree_X_add_C, Nat.mul_one]
    rw [((cyclotomic.monic (p ^ (n + 1)) ℤ)).natDegree_map
      (Int.castRingHom (WittVector p k))]
    rw [natDegree_cyclotomic]
    exact (Nat.totient_pos).2 (pow_pos (Nat.Prime.pos (Fact.out : Nat.Prime p)) _)
  exact
    (adjoinRoot_quotient_span_root_equiv_base_residueField_of_eisenstein
      (R := WittVector p k) hf hdeg).trans
      (wittVector_residueField_ringEquiv (p := p) (k := k))

end WittVectorShiftedCyclotomic

end Representation
