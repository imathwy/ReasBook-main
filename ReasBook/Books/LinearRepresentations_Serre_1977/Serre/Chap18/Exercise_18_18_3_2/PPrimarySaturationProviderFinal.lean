import LinearRepresentations_Serre_1977.Chap18.Theorem_18_18_3_1
import LinearRepresentations_Serre_1977.Chap18.Exercise_18_18_3_2.CartanCokernelSaturation
import LinearRepresentations_Serre_1977.Chap18.Exercise_18_18_3_2.CartanCoordinateRangeGenerators
import LinearRepresentations_Serre_1977.Chap18.Exercise_18_18_3_2.CartanPPrimaryBridge

/-!
Negative bridge for the attempted Theorem 35' route.

The global Cartan-image theorem behind Theorem 35' supplies only the uniform multiplier
`p ^ Nat.factorization (Nat.card G) p` on every modular class.  In fixed regular-class
coordinates this gives point masses scaled by the global `p`-part of `|G|`, hence only the
coarser lattice generated by those global multiples.

The diagonal lattice in Exercise 18.5(b) is generated instead by the smaller class-dependent
centralizer `p`-parts.  The p-primary saturation API can remove only prime-to-`p` gaps.  Therefore
the global-multiple route closes the diagonal range only after adding one of the stronger local
inputs isolated below: either the prime-to-`p` intermediate quotient condition, or directly the
centralizer-`p`-part generator/divisibility statement.
-/

noncomputable section

open CategoryTheory
open scoped BigOperators MonoidAlgebra Representation TensorProduct ZeroObject

universe u

namespace Representation

section PPrimarySaturationProviderFinal

variable {p : ℕ}
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k p]
variable {G : Type u} [Group G] [Finite G]
variable [Fact p.Prime]

local instance pPrimarySaturationProviderFinalFintypePRegularConjClass :
    Fintype (PRegularConjClass G p) :=
  Fintype.ofFinite (PRegularConjClass G p)

local instance pPrimarySaturationProviderFinalDecidableEqPRegularConjClass :
    DecidableEq (PRegularConjClass G p) :=
  Classical.decEq _

local notation "pPartCardG" => p ^ Nat.factorization (Nat.card G) p

/-- The global `p`-part point mass obtained by reading the Theorem 35' multiplier in the fixed
regular-class coordinates. -/
noncomputable def globalPPart_regular_integer_indicator
    (c : PRegularConjClass G p) : PRegularConjClass G p → ℤ :=
  Pi.single c (pPartCardG : ℤ)

/-- The coarse coordinate lattice generated by the global `p`-part point masses. -/
noncomputable def globalPPartIntegerDiagonalSubmodule :
    Submodule ℤ (PRegularConjClass G p → ℤ) :=
  Submodule.span ℤ
    (Set.range (fun c : PRegularConjClass G p =>
      globalPPart_regular_integer_indicator (p := p) (G := G) c))

/-- The source-side generator statement supplied by the global `p^n` theorem: every
coordinate-normalized simple class has a Cartan preimage only after multiplying by the global
`p`-part of `|G|`. -/
def globalPPartCartanGeneratorStatement
    (π : PRegularConjClass G p → FDRep k G) : Prop :=
  ∀ c : PRegularConjClass G p,
    ∃ x : P₀[k](G),
      cartanHom k G x = (pPartCardG : ℕ) • [π c]₀

/-- The stronger local generator statement actually needed for the Exercise 18.5(b) diagonal
range: the multiplier must be the centralizer `p`-part attached to the class, not the global
`p`-part of `|G|`. -/
def localCentralizerPPartCartanGeneratorStatement
    (π : PRegularConjClass G p → FDRep k G) : Prop :=
  ∀ c : PRegularConjClass G p,
    ∃ x : P₀[k](G),
      cartanHom k G x =
        (ConjClasses.centralizerPPart p c.1 : ℤ) • [π c]₀

/-- The coordinatewise divisibility statement for the forward inclusion into the diagonal
lattice.  This is the other local input used by the existing generator criterion. -/
def cartanCoordinateCentralizerPPartDivisibilityStatement : Prop :=
  ∀ x : P₀[k](G), ∀ c : PRegularConjClass G p,
    ∃ a : ℤ,
      cartanCoordinateAddHom (p := p) (k := k) (G := G) x c =
        (ConjClasses.centralizerPPart p c.1 : ℤ) * a

/-- The public Cartan-image theorem underlying Theorem 35': every class of `R₀[k](G)` becomes
Cartan after multiplying by the global `p`-part of `|G|`. -/
theorem cartanHom_global_p_part_smul_mem_range
    (y : R₀[k](G)) :
    ((pPartCardG : ℕ) • y) ∈ (cartanHom k G).range := by
  let n : ℕ := Nat.factorization (Nat.card G) p
  let m : ℕ := ordCompl[p] (Nat.card G)
  have hcard : Nat.card G = p ^ n * m := by
    simpa [n, m] using (Nat.ordProj_mul_ordCompl_eq_self (Nat.card G) p).symm
  have hm : Nat.Coprime p m := by
    simpa [m] using
      Nat.coprime_ordCompl (Fact.out : Nat.Prime p) (Nat.card_pos (α := G)).ne'
  simpa [n] using
    (Representation.cartanHom_surjective_on_p_part_multiples
      (p := p) (k := k) (G := G) n m hcard hm y)

/-- The global `p`-part generator statement follows formally from the Cartan-image theorem behind
Theorem 35'. -/
theorem globalPPartCartanGeneratorStatement_of_global_p_part
    (π : PRegularConjClass G p → FDRep k G) :
    globalPPartCartanGeneratorStatement (p := p) (k := k) (G := G) π := by
  intro c
  exact cartanHom_global_p_part_smul_mem_range
    (p := p) (k := k) (G := G) ([π c]₀ : R₀[k](G))

/-- Fixed-coordinate readback of the global `p`-part generator statement: it gives only the
coarse global point mass, not the centralizer-`p`-part point mass. -/
theorem globalPPart_regular_integer_indicator_mem_cartanCoordinateAddHom_range_of_generators
    (π : PRegularConjClass G p → FDRep k G)
    (hπ_coord :
      ∀ c,
        regularClassCoordinateAddEquiv (p := p) (k := k) (G := G) [π c]₀ =
          (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ))
    (hglobal : globalPPartCartanGeneratorStatement (p := p) (k := k) (G := G) π)
    (c : PRegularConjClass G p) :
    globalPPart_regular_integer_indicator (p := p) (G := G) c ∈
      (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range := by
  rcases hglobal c with ⟨x, hx⟩
  refine ⟨x, ?_⟩
  change
    regularClassCoordinateAddEquiv (p := p) (k := k) (G := G) (cartanHom k G x) =
      globalPPart_regular_integer_indicator (p := p) (G := G) c
  rw [hx, map_nsmul, hπ_coord c]
  ext d
  by_cases hdc : d = c
  · subst d
    simp [globalPPart_regular_integer_indicator]
  · simp [globalPPart_regular_integer_indicator, hdc]

/-- Theorem 35' therefore places every global `p`-part coordinate generator in the fixed Cartan
coordinate range. -/
theorem globalPPart_regular_integer_indicator_mem_cartanCoordinateAddHom_range
    (π : PRegularConjClass G p → FDRep k G)
    (hπ_coord :
      ∀ c,
        regularClassCoordinateAddEquiv (p := p) (k := k) (G := G) [π c]₀ =
          (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ))
    (c : PRegularConjClass G p) :
    globalPPart_regular_integer_indicator (p := p) (G := G) c ∈
      (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range :=
  globalPPart_regular_integer_indicator_mem_cartanCoordinateAddHom_range_of_generators
    (p := p) (k := k) (G := G) π hπ_coord
    (globalPPartCartanGeneratorStatement_of_global_p_part
      (p := p) (k := k) (G := G) π)
    c

/-- The global `p`-part generators span only the coarse global lattice inside the fixed Cartan
coordinate range. -/
theorem globalPPartIntegerDiagonalSubmodule_le_cartanCoordinateAddHom_range
    (π : PRegularConjClass G p → FDRep k G)
    (hπ_coord :
      ∀ c,
        regularClassCoordinateAddEquiv (p := p) (k := k) (G := G) [π c]₀ =
          (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ)) :
    (globalPPartIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup ≤
      (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range := by
  let R : AddSubgroup (PRegularConjClass G p → ℤ) :=
    (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range
  have hle :
      globalPPartIntegerDiagonalSubmodule (p := p) (G := G) ≤ R.toIntSubmodule := by
    rw [globalPPartIntegerDiagonalSubmodule]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨c, rfl⟩
    change globalPPart_regular_integer_indicator (p := p) (G := G) c ∈ R
    exact
      globalPPart_regular_integer_indicator_mem_cartanCoordinateAddHom_range
        (p := p) (k := k) (G := G) π hπ_coord c
  intro f hf
  change f ∈ R
  change f ∈ R.toIntSubmodule
  exact hle hf

/-- Each centralizer `p`-part divides the global `p`-part of `|G|`.  Thus the global lattice is
contained in the desired diagonal lattice, but it may be strictly smaller. -/
theorem centralizerPPart_dvd_globalPPartCard
    (c : PRegularConjClass G p) :
    ConjClasses.centralizerPPart p c.1 ∣ pPartCardG := by
  obtain ⟨g, hg⟩ := ConjClasses.mk_surjective c.1
  rw [← hg, ConjClasses.centralizerPPart_mk]
  have hcard_dvd :
      Nat.card (Subgroup.centralizer ({g} : Set G)) ∣ Nat.card G := by
    exact Subgroup.card_subgroup_dvd_card (Subgroup.centralizer ({g} : Set G))
  have hord_dvd :
      ordProj[p] (Nat.card (Subgroup.centralizer ({g} : Set G))) ∣
        ordProj[p] (Nat.card G) :=
    Nat.ordProj_dvd_ordProj_of_dvd Nat.card_pos.ne' hcard_dvd p
  simpa [Representation.centralizerPPart] using hord_dvd

/-- The global `p`-part point mass is in the diagonal lattice because every centralizer `p`-part
divides the global `p`-part. -/
theorem globalPPart_regular_integer_indicator_mem_regularIntegerDiagonalSubmodule
    (c : PRegularConjClass G p) :
    globalPPart_regular_integer_indicator (p := p) (G := G) c ∈
      regularIntegerDiagonalSubmodule (p := p) (G := G) := by
  refine (mem_regularIntegerDiagonalSubmodule_iff
    (p := p) (G := G)
    (globalPPart_regular_integer_indicator (p := p) (G := G) c)).2 ?_
  intro d
  by_cases hdc : d = c
  · subst d
    rcases centralizerPPart_dvd_globalPPartCard (p := p) (G := G) c with ⟨q, hq⟩
    refine ⟨(q : ℤ), ?_⟩
    have hq_int :
        (pPartCardG : ℤ) = (ConjClasses.centralizerPPart p c.1 : ℤ) * (q : ℤ) := by
      exact_mod_cast hq
    simpa [globalPPart_regular_integer_indicator] using hq_int
  · refine ⟨0, ?_⟩
    simp [globalPPart_regular_integer_indicator, hdc]

/-- The coarse global lattice lies in Serre's diagonal lattice.  This is the maximum formal
containment supplied by the global `p^n` route alone. -/
theorem globalPPartIntegerDiagonalSubmodule_le_regularIntegerDiagonalSubmodule :
    (globalPPartIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup ≤
      (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup := by
  have hle :
      globalPPartIntegerDiagonalSubmodule (p := p) (G := G) ≤
        regularIntegerDiagonalSubmodule (p := p) (G := G) := by
    rw [globalPPartIntegerDiagonalSubmodule]
    refine Submodule.span_le.2 ?_
    rintro _ ⟨c, rfl⟩
    exact
      globalPPart_regular_integer_indicator_mem_regularIntegerDiagonalSubmodule
        (p := p) (G := G) c
  intro f hf
  exact hle hf

/-- P-primary saturation closes the fixed coordinate range only if the residual quotient between
the Cartan range and the diagonal lattice is prime-to-`p`.  This is exactly the missing condition
not supplied by global `p^n` generators. -/
theorem cartanCoordinateAddHom_range_eq_regularIntegerDiagonalSubmodule_of_prime_to_p_gap
    (hsubset :
      (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range ≤
        (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup)
    (hcop : Nat.Coprime p
      (Nat.card
        ((regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup ⧸
          ((cartanCoordinateAddHom (p := p) (k := k) (G := G)).range).addSubgroupOf
            (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup))) :
    (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range =
      (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup := by
  let R : AddSubgroup (PRegularConjClass G p → ℤ) :=
    (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range
  haveI : Finite ((PRegularConjClass G p → ℤ) ⧸ R) := by
    simpa [R] using
      cartanCoordinateAddHom_range_quotient_finite (p := p) (k := k) (G := G)
  have hP : IsPGroup p (Multiplicative ((PRegularConjClass G p → ℤ) ⧸ R)) := by
    simpa [R] using
      cartanCoordinateAddHom_range_quotient_isPGroup (p := p) (k := k) (G := G)
  exact
    addSubgroup_eq_of_quotient_isPGroup_of_quotient_card_coprime
      (p := p)
      R
      ((regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup)
      (by simpa [R] using hsubset)
      hP
      (by simpa [R] using hcop)

/-- The stronger local source lemma that would close the diagonal range without Brauer readback:
combine coordinatewise centralizer divisibility with centralizer-`p`-part Cartan generators. -/
theorem cartanCoordinateAddHom_range_eq_regularIntegerDiagonalSubmodule_of_localCentralizerInputs
    (π : PRegularConjClass G p → FDRep k G)
    (hπ_coord :
      ∀ c,
        regularClassCoordinateAddEquiv (p := p) (k := k) (G := G) [π c]₀ =
          (Pi.single c (1 : ℤ) : PRegularConjClass G p → ℤ))
    (hdiv :
      cartanCoordinateCentralizerPPartDivisibilityStatement
        (p := p) (k := k) (G := G))
    (hgen :
      localCentralizerPPartCartanGeneratorStatement
        (p := p) (k := k) (G := G) π) :
    (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range =
      (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup :=
  cartanCoordinateAddHom_range_eq_regularIntegerDiagonalSubmodule_of_coordinate_divisible_and_cartan_generators
    (p := p) (k := k) (G := G) (π := π) hπ_coord hdiv hgen

/-- Equivalent generator-only formulation of the missing stronger local input: every
centralizer-scaled regular point mass must already lie in the fixed Cartan-coordinate range. -/
theorem cartanCoordinateAddHom_range_eq_regularIntegerDiagonalSubmodule_of_coordinate_divisible_and_scaled_mem
    (hdiv :
      cartanCoordinateCentralizerPPartDivisibilityStatement
        (p := p) (k := k) (G := G))
    (hscaled :
      ∀ c : PRegularConjClass G p,
        scaled_regular_integer_indicator (p := p) (G := G) c ∈
          (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range) :
    (cartanCoordinateAddHom (p := p) (k := k) (G := G)).range =
      (regularIntegerDiagonalSubmodule (p := p) (G := G)).toAddSubgroup := by
  refine
    cartanCoordinateAddHom_range_eq_regularIntegerDiagonalSubmodule_of_range_le_and_scaled_mem
      (p := p) (k := k) (G := G) ?_ hscaled
  exact
    cartanCoordinateAddHom_range_le_regularIntegerDiagonalSubmodule_of_coordinate_divisible
      (p := p) (k := k) (G := G) hdiv

end PPrimarySaturationProviderFinal

end Representation
