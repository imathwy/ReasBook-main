import Mathlib

noncomputable section

namespace Representation

/-- The additive subgroup of a ring generated by all additive commutators `a*b - b*a`. -/
def ringCommutatorAddSubgroup (A : Type*) [Ring A] : AddSubgroup A :=
  AddSubgroup.closure {z | ∃ a b : A, z = a * b - b * a}

variable {A : Type*} [Ring A] {p : ℕ} [Fact p.Prime] [CharP A p]

theorem mul_sub_mul_mem_ringCommutatorAddSubgroup (a b : A) :
    a * b - b * a ∈ ringCommutatorAddSubgroup A :=
  AddSubgroup.subset_closure ⟨a, b, rfl⟩

/-! ### Words in two letters -/

/-- The product of the word in the letters `x`, `y` described by `w : Fin m → Bool`
(`true` ↦ `x`, `false` ↦ `y`), multiplied in order of increasing index. -/
private def wordProd (x y : A) {m : ℕ} (w : Fin m → Bool) : A :=
  (List.ofFn fun i => bif w i then x else y).prod

private theorem wordProd_cons (x y : A) {m : ℕ} (b : Bool) (w : Fin m → Bool) :
    wordProd x y (Fin.cons b w) = (bif b then x else y) * wordProd x y w := by
  simp [wordProd, List.ofFn_succ]

private theorem wordProd_const (x y : A) {m : ℕ} (b : Bool) :
    wordProd x y (fun _ : Fin m => b) = (bif b then x else y) ^ m := by
  simp [wordProd, List.ofFn_const, List.prod_replicate]

/-- Noncommutative multinomial expansion: `(x + y) ^ m` is the sum of all `2 ^ m`
words of length `m` in `x` and `y`. -/
private theorem add_pow_eq_sum_wordProd (x y : A) (m : ℕ) :
    (x + y) ^ m = ∑ w : Fin m → Bool, wordProd x y w := by
  induction m with
  | zero => simp [wordProd]
  | succ m ih =>
    rw [pow_succ', ih, Finset.mul_sum,
      ← Equiv.sum_comp (Fin.consEquiv fun _ => Bool) (wordProd x y),
      Fintype.sum_prod_type, Fintype.sum_bool, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun w _ => ?_
    show (x + y) * wordProd x y w
        = wordProd x y (Fin.cons true w) + wordProd x y (Fin.cons false w)
    rw [wordProd_cons, wordProd_cons]
    simp [add_mul]

/-! ### Cyclic rotation of words -/

/-- Cyclic rotation of a word by `c` places. -/
private def rotWord {m : ℕ} [NeZero m] (c : Fin m) (w : Fin m → Bool) : Fin m → Bool :=
  fun i => w (i + c)

private theorem rotWord_zero {m : ℕ} [NeZero m] (w : Fin m → Bool) : rotWord 0 w = w := by
  funext i
  simp [rotWord]

private theorem rotWord_rotWord {m : ℕ} [NeZero m] (c d : Fin m) (w : Fin m → Bool) :
    rotWord c (rotWord d w) = rotWord (c + d) w := by
  funext i
  simp [rotWord, add_assoc]

/-- Rotating a word by one place changes its product by an additive commutator. -/
private theorem wordProd_rotWord_one_sub_mem (x y : A) {q : ℕ} (w : Fin (q + 1) → Bool) :
    wordProd x y (rotWord 1 w) - wordProd x y w ∈ ringCommutatorAddSubgroup A := by
  have h1 : wordProd x y w
      = (bif w 0 then x else y)
        * (List.ofFn fun i : Fin q => bif w i.succ then x else y).prod := by
    simp [wordProd, List.ofFn_succ]
  have h2 : wordProd x y (rotWord 1 w)
      = (List.ofFn fun i : Fin q => bif w i.succ then x else y).prod
        * (bif w 0 then x else y) := by
    rw [wordProd, List.ofFn_succ', List.prod_concat]
    simp [rotWord, Fin.coeSucc_eq_succ, Fin.last_add_one]
  rw [h1, h2]
  exact mul_sub_mul_mem_ringCommutatorAddSubgroup _ _

/-- Rotating a word by any number of places changes its product by an element of the
commutator subgroup. -/
private theorem wordProd_rotWord_sub_mem (x y : A) {q : ℕ} (c : Fin (q + 1))
    (w : Fin (q + 1) → Bool) :
    wordProd x y (rotWord c w) - wordProd x y w ∈ ringCommutatorAddSubgroup A := by
  induction c using Fin.induction with
  | zero => rw [rotWord_zero, sub_self]; exact zero_mem _
  | succ i ih =>
    have h1 : rotWord i.succ w = rotWord 1 (rotWord i.castSucc w) := by
      rw [rotWord_rotWord, add_comm (1 : Fin (q + 1)) i.castSucc, Fin.coeSucc_eq_succ]
    rw [h1, ← sub_add_sub_cancel _ (wordProd x y (rotWord i.castSucc w)) _]
    exact add_mem (wordProd_rotWord_one_sub_mem x y (rotWord i.castSucc w)) ih

/-! ### Orbits of nonconstant words under rotation -/

/-- A word fixed by a nonzero rotation of prime length is constant. -/
private theorem eq_const_of_rotWord_eq {q : ℕ} (hq : (q + 1).Prime) {w : Fin (q + 1) → Bool}
    {e : Fin (q + 1)} (he : e ≠ 0) (hrot : rotWord e w = w) : w = fun _ => w 0 := by
  have hstep : ∀ i, w (i + e) = w i := fun i => congrFun hrot i
  have hiter : ∀ n : ℤ, ∀ i, w (i + n • e) = w i := by
    intro n
    induction n using Int.induction_on with
    | zero => simp
    | succ k ihk =>
      intro i
      have : i + ((k : ℤ) + 1) • e = i + (k : ℤ) • e + e := by
        rw [add_zsmul, one_zsmul, add_assoc]
      rw [this, hstep, ihk]
    | pred k ihk =>
      intro i
      have h1 : i + (-(k : ℤ) - 1) • e + e = i + (-(k : ℤ)) • e := by
        rw [sub_zsmul, one_zsmul]
        abel
      have := hstep (i + (-(k : ℤ) - 1) • e)
      rw [h1, ihk] at this
      exact this.symm
  -- `e` generates the whole group `Fin (q + 1)`
  have horder : addOrderOf e = q + 1 := by
    have hdvd : addOrderOf e ∣ q + 1 := by
      simpa using addOrderOf_dvd_card (x := e)
    rcases hq.eq_one_or_self_of_dvd _ hdvd with h1 | h1
    · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h1) he
    · exact h1
  have htop : AddSubgroup.zmultiples e = ⊤ := by
    apply AddSubgroup.eq_top_of_card_eq
    rw [Nat.card_zmultiples, horder, Nat.card_eq_fintype_card, Fintype.card_fin]
  funext i
  obtain ⟨n, hn⟩ : ∃ n : ℤ, n • e = i - 0 := by
    have : i - 0 ∈ AddSubgroup.zmultiples e := htop ▸ AddSubgroup.mem_top _
    exact AddSubgroup.mem_zmultiples_iff.mp this
  have := hiter n 0
  rw [hn, zero_add, sub_zero] at this
  exact this

/-- The rotations of a nonconstant word of prime length are pairwise distinct. -/
private theorem rotWord_injective {q : ℕ} (hq : (q + 1).Prime) {w : Fin (q + 1) → Bool}
    (hw : ∀ b, w ≠ fun _ => b) : Function.Injective fun c => rotWord c w := by
  have key : ∀ e : Fin (q + 1), rotWord e w = w → e = 0 := by
    intro e he
    by_contra he0
    exact hw (w 0) (eq_const_of_rotWord_eq hq he0 he)
  intro c d h
  have h' : rotWord c w = rotWord d w := h
  have h1 : rotWord (-d + c) w = rotWord (-d + d) w := by
    rw [← rotWord_rotWord, ← rotWord_rotWord, h']
  rw [neg_add_cancel, rotWord_zero] at h1
  have := key _ h1
  -- `-d + c = 0` gives `c = d`
  have h2 : d + (-d + c) = d + 0 := by rw [this]
  rwa [← add_assoc, add_neg_cancel, zero_add, add_zero] at h2

/-- The sum of the products of a rotation-closed finite set of nonconstant words of prime
length `p` lies in the commutator subgroup (in characteristic `p`): the set decomposes into
rotation orbits of size exactly `p`, and each orbit contributes `p • (word product) = 0`
modulo commutators. -/
private theorem sum_wordProd_mem (x y : A) :
    ∀ S : Finset (Fin p → Bool),
      (∀ w ∈ S, ∀ c : Fin p, rotWord c w ∈ S) →
      (∀ w ∈ S, ∀ b, w ≠ fun _ => b) →
      ∑ w ∈ S, wordProd x y w ∈ ringCommutatorAddSubgroup A := by
  obtain ⟨q, rfl⟩ : ∃ q, p = q + 1 :=
    ⟨p - 1, (Nat.succ_pred_eq_of_pos (Fact.out : p.Prime).pos).symm⟩
  intro S
  induction S using Finset.strongInduction with
  | _ S ih =>
    intro hclosed hconst
    rcases S.eq_empty_or_nonempty with rfl | ⟨w₀, hw₀⟩
    · rw [Finset.sum_empty]
      exact zero_mem _
    have hinj : Function.Injective fun c => rotWord c w₀ :=
      rotWord_injective (Fact.out : (q + 1).Prime) (hconst w₀ hw₀)
    set O : Finset (Fin (q + 1) → Bool) :=
      Finset.image (fun c => rotWord c w₀) Finset.univ with hO
    have hOS : O ⊆ S := by
      intro u hu
      rw [hO, Finset.mem_image] at hu
      obtain ⟨c, -, rfl⟩ := hu
      exact hclosed w₀ hw₀ c
    have hw₀O : w₀ ∈ O := by
      rw [hO, Finset.mem_image]
      exact ⟨0, Finset.mem_univ 0, rotWord_zero w₀⟩
    -- the sum over the orbit `O` lies in the commutator subgroup
    have hOsum : ∑ w ∈ O, wordProd x y w ∈ ringCommutatorAddSubgroup A := by
      rw [hO, Finset.sum_image fun a _ b _ h => hinj h]
      have hsplit : ∑ c : Fin (q + 1), wordProd x y (rotWord c w₀)
          = ∑ c : Fin (q + 1), (wordProd x y (rotWord c w₀) - wordProd x y w₀)
            + ∑ _c : Fin (q + 1), wordProd x y w₀ := by
        rw [← Finset.sum_add_distrib]
        simp
      rw [hsplit]
      refine add_mem (sum_mem fun c _ => wordProd_rotWord_sub_mem x y c w₀) ?_
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
        CharP.cast_eq_zero A, zero_mul]
      exact zero_mem _
    -- the complement is still rotation-closed and nonconstant, so we may recurse
    have hclosed' : ∀ w ∈ S \ O, ∀ c : Fin (q + 1), rotWord c w ∈ S \ O := by
      intro w hw c
      rw [Finset.mem_sdiff] at hw ⊢
      refine ⟨hclosed w hw.1 c, fun hmem => hw.2 ?_⟩
      rw [hO, Finset.mem_image] at hmem
      obtain ⟨d, -, hd⟩ := hmem
      have hw' : w = rotWord (-c) (rotWord c w) := by
        rw [rotWord_rotWord, neg_add_cancel, rotWord_zero]
      rw [hO, Finset.mem_image]
      exact ⟨-c + d, Finset.mem_univ _, by rw [← rotWord_rotWord, hd, ← hw']⟩
    have hconst' : ∀ w ∈ S \ O, ∀ b, w ≠ fun _ => b :=
      fun w hw => hconst w (Finset.mem_sdiff.mp hw).1
    have hssub : S \ O ⊂ S := Finset.sdiff_ssubset hOS ⟨w₀, hw₀O⟩
    have hrec := ih (S \ O) hssub hclosed' hconst'
    rw [← Finset.sum_sdiff hOS]
    exact add_mem hrec hOsum

theorem add_pow_prime_sub_mem_ringCommutatorAddSubgroup (x y : A) :
    (x + y) ^ p - (x ^ p + y ^ p) ∈ ringCommutatorAddSubgroup A := by
  have hp : p.Prime := Fact.out
  -- the two constant words
  have hne : (fun _ : Fin p => true) ≠ (fun _ : Fin p => false) := by
    intro h
    have h0 := congrFun h ⟨0, hp.pos⟩
    simp at h0
  have hsub : ({fun _ => true, fun _ => false} : Finset (Fin p → Bool)) ⊆ Finset.univ :=
    Finset.subset_univ _
  have hpair : ∑ w ∈ ({fun _ => true, fun _ => false} : Finset (Fin p → Bool)), wordProd x y w
      = x ^ p + y ^ p := by
    rw [Finset.sum_pair hne, wordProd_const, wordProd_const]
    rfl
  -- the nonconstant words sum to an element of the commutator subgroup
  have hmem : ∑ w ∈ (Finset.univ \ {fun _ => true, fun _ => false} : Finset (Fin p → Bool)),
      wordProd x y w ∈ ringCommutatorAddSubgroup A := by
    apply sum_wordProd_mem
    · intro w hw c
      rw [Finset.mem_sdiff] at hw ⊢
      refine ⟨Finset.mem_univ _, fun hmem => hw.2 ?_⟩
      rw [Finset.mem_insert, Finset.mem_singleton] at hmem ⊢
      have hwrot : ∀ b : Bool, rotWord c w = (fun _ => b) → w = fun _ => b := by
        intro b hb
        funext i
        have h1 := congrFun hb (i - c)
        simpa [rotWord, sub_add_cancel] using h1
      rcases hmem with h | h
      · exact Or.inl (hwrot true h)
      · exact Or.inr (hwrot false h)
    · intro w hw b hb
      rw [Finset.mem_sdiff, Finset.mem_insert, Finset.mem_singleton] at hw
      cases b
      · exact hw.2 (Or.inr hb)
      · exact hw.2 (Or.inl hb)
  have hkey : (x + y) ^ p - (x ^ p + y ^ p)
      = ∑ w ∈ (Finset.univ \ {fun _ => true, fun _ => false} : Finset (Fin p → Bool)),
        wordProd x y w := by
    rw [add_pow_eq_sum_wordProd, ← Finset.sum_sdiff hsub, hpair, add_sub_cancel_right]
  rw [hkey]
  exact hmem

/-- `(a * b) ^ m` and `(b * a) ^ m` differ by an additive commutator. -/
private theorem pow_mul_comm_sub_mem (a b : A) (m : ℕ) :
    (a * b) ^ m - (b * a) ^ m ∈ ringCommutatorAddSubgroup A := by
  cases m with
  | zero =>
    rw [pow_zero, pow_zero, sub_self]
    exact zero_mem _
  | succ m =>
    have h1 : (a * b) ^ (m + 1) = a * ((b * a) ^ m * b) := by
      rw [pow_succ, ← mul_assoc, mul_pow_mul, mul_assoc]
    have h2 : (b * a) ^ (m + 1) = ((b * a) ^ m * b) * a := by
      rw [pow_succ, ← mul_assoc]
    rw [h1, h2]
    exact mul_sub_mul_mem_ringCommutatorAddSubgroup _ _

theorem pow_prime_mem_ringCommutatorAddSubgroup_of_mem
    {x : A} (hx : x ∈ ringCommutatorAddSubgroup A) :
    x ^ p ∈ ringCommutatorAddSubgroup A := by
  have hp : p.Prime := Fact.out
  induction hx using AddSubgroup.closure_induction with
  | mem z hz =>
    obtain ⟨a, b, rfl⟩ := hz
    -- write `(a*b - b*a) ^ p ≡ (a*b)^p + (-(b*a))^p` modulo commutators
    have h1 := add_pow_prime_sub_mem_ringCommutatorAddSubgroup (a * b) (-(b * a))
    have heq : (a * b - b * a) ^ p
        = ((a * b + -(b * a)) ^ p - ((a * b) ^ p + (-(b * a)) ^ p))
          + ((a * b) ^ p + (-(b * a)) ^ p) := by
      rw [← sub_eq_add_neg]
      abel
    rw [heq]
    refine add_mem h1 ?_
    have hcomm := pow_mul_comm_sub_mem a b p
    rcases hp.eq_two_or_odd' with rfl | hodd
    · -- characteristic 2: `u² + v² = (u² - v²) + 2 v² = u² - v²`
      have h2 : ((2 : ℕ) : A) = 0 := CharP.cast_eq_zero A 2
      have h3 : (a * b) ^ 2 + (-(b * a)) ^ 2
          = ((a * b) ^ 2 - (b * a) ^ 2) + ((2 : ℕ) : A) * (b * a) ^ 2 := by
        push_cast
        rw [neg_sq, two_mul]
        abel
      rw [h3, h2, zero_mul, add_zero]
      exact hcomm
    · -- odd characteristic: `(-v)^p = -(v^p)`
      rw [hodd.neg_pow, ← sub_eq_add_neg]
      exact hcomm
  | zero =>
    rw [zero_pow hp.ne_zero]
    exact zero_mem _
  | add z w hz hw ihz ihw =>
    have h1 := add_pow_prime_sub_mem_ringCommutatorAddSubgroup z w
    have heq : (z + w) ^ p = ((z + w) ^ p - (z ^ p + w ^ p)) + (z ^ p + w ^ p) := by abel
    rw [heq]
    exact add_mem h1 (add_mem ihz ihw)
  | neg z hz ihz =>
    rcases hp.eq_two_or_odd' with rfl | hodd
    · rw [neg_sq]
      exact ihz
    · rw [hodd.neg_pow]
      exact neg_mem ihz

/-- The Frobenius `z ↦ z ^ p` preserves congruence modulo the commutator subgroup. -/
private theorem pow_p_sub_pow_p_mem {x y : A} (h : x - y ∈ ringCommutatorAddSubgroup A) :
    x ^ p - y ^ p ∈ ringCommutatorAddSubgroup A := by
  have h0 : y + (x - y) = x := by abel
  have h1 := add_pow_prime_sub_mem_ringCommutatorAddSubgroup y (x - y)
  rw [h0] at h1
  have h2 := pow_prime_mem_ringCommutatorAddSubgroup_of_mem h
  have heq : x ^ p - y ^ p = (x ^ p - (y ^ p + (x - y) ^ p)) + (x - y) ^ p := by abel
  rw [heq]
  exact add_mem h1 h2

/-- `n = 1` case of the finite-sum Frobenius congruence. -/
private theorem sum_pow_p_sub_mem {ι : Type*} (s : Finset ι) (f : ι → A) :
    (∑ j ∈ s, f j) ^ p - ∑ j ∈ s, f j ^ p ∈ ringCommutatorAddSubgroup A := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.sum_empty, Finset.sum_empty, zero_pow (Fact.out : p.Prime).ne_zero, sub_self]
    exact zero_mem _
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha]
    have h1 := add_pow_prime_sub_mem_ringCommutatorAddSubgroup (f a) (∑ j ∈ s, f j)
    have heq : (f a + ∑ j ∈ s, f j) ^ p - (f a ^ p + ∑ j ∈ s, f j ^ p)
        = ((f a + ∑ j ∈ s, f j) ^ p - (f a ^ p + (∑ j ∈ s, f j) ^ p))
          + ((∑ j ∈ s, f j) ^ p - ∑ j ∈ s, f j ^ p) := by abel
    rw [heq]
    exact add_mem h1 ih

theorem sum_pow_prime_pow_sub_sum_mem_ringCommutatorAddSubgroup
    {ι : Type*} (s : Finset ι) (f : ι → A) (n : ℕ) :
    (∑ j ∈ s, f j) ^ p ^ n - ∑ j ∈ s, f j ^ p ^ n ∈ ringCommutatorAddSubgroup A := by
  induction n with
  | zero =>
    simp only [pow_zero, pow_one, sub_self]
    exact zero_mem _
  | succ n ih =>
    have h1 := pow_p_sub_pow_p_mem ih
    have h2 := sum_pow_p_sub_mem s fun j => f j ^ p ^ n
    have hsum : ∑ j ∈ s, f j ^ p ^ (n + 1) = ∑ j ∈ s, (f j ^ p ^ n) ^ p :=
      Finset.sum_congr rfl fun j _ => by rw [pow_succ, pow_mul]
    rw [hsum, pow_succ, pow_mul,
      ← sub_add_sub_cancel _ ((∑ j ∈ s, f j ^ p ^ n) ^ p) _]
    exact add_mem h1 h2

theorem pow_prime_pow_sub_pow_mem_ringCommutatorAddSubgroup
    {x y : A} (h : x - y ∈ ringCommutatorAddSubgroup A) (n : ℕ) :
    x ^ p ^ n - y ^ p ^ n ∈ ringCommutatorAddSubgroup A := by
  induction n with
  | zero => simpa using h
  | succ n ih =>
    rw [pow_succ, pow_mul, pow_mul]
    exact pow_p_sub_pow_p_mem ih

end Representation
