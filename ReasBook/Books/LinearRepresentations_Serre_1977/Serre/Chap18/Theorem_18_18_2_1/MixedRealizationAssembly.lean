import Mathlib
import LinearRepresentations_Serre_1977.Chap18.Theorem_18_18_2_1.RealizationCore
import LinearRepresentations_Serre_1977.Chap18.Theorem_18_18_2_1.CharpolyPowRoots
import LinearRepresentations_Serre_1977.Chap18.Theorem_18_18_2_1.SubfieldRelationDescent
import LinearRepresentations_Serre_1977.Chap18.Theorem_18_18_2_1.BrauerRelationSeparator

/-!
Assembly of Serre part `(a)` of Theorem 18-18.2-1.

A normalized vanishing relation among the Brauer characters of pairwise nonisomorphic simple
`k[G]`-representations, with coefficients in an arbitrary field `K` equipped with an injective
multiplicative lift of the prime-to-`p` roots of unity, is transported here to a vanishing trace
relation over `k` itself:

1. the relation is evaluated pointwise on `p`-regular elements;
2. all Brauer values live in the subfield `F` of `K` generated by the lifted torsion generator,
   so the relation descends to coefficients in `F` (`exists_subfield_relation_of_relation`);
3. a valuation subring of `F` dominating a maximal ideal above `p` carries a residue
   homomorphism `θ` into `k` (`exists_residue_data`); after dividing by a coefficient of minimal
   valuation (`exists_valuation_scaling_index`), the relation maps to a relation over `k` whose
   lift is the tautological one twisted by a power `b` prime to the `p`-regular exponent;
4. the twist is absorbed by the `b`-th power bijection of the `p`-regular locus
   (`charpoly_pow_roots`, `exists_pow_inverse`);
5. Jacobson density (`support_product_separator_exists_local`) then forces the distinguished
   residue coefficient — which is `1` — to vanish.
-/

noncomputable section

universe u x

open CategoryTheory
open scoped Representation

namespace Representation

variable {p : ℕ} [Fact p.Prime]

/-- The tautological lift of the prime-to-`p` roots of unity of `k` into `k` itself. -/
def valueLift (p : ℕ) (k : Type u) [Field k] : PrimeToPRoot p k →* k where
  toFun x := ((x : kˣ) : k)
  map_one' := by simp
  map_mul' x y := by simp

section AlgebraicWitness

variable {K : Type u} [Field K]

/-- Helper: a monic integer witness for a root of unity. -/
private theorem isIntegral_of_pow_eq_one {S : Type*} [Field S] [Algebra S K]
    {y : K} {m : ℕ} (hm : m ≠ 0) (hy : y ^ m = 1) : IsIntegral S y := by
  refine ⟨Polynomial.X ^ m - Polynomial.C 1, Polynomial.monic_X_pow_sub_C 1 hm, ?_⟩
  simp [Polynomial.eval₂_sub, hy]

/-- Helper: the integral elements over a field form a subfield of `K`. -/
private def integralSubfield (S : Type*) [Field S] [Algebra S K] : Subfield K where
  carrier := {y : K | IsIntegral S y}
  zero_mem' := isIntegral_zero
  one_mem' := isIntegral_one
  add_mem' ha hb := ha.add hb
  mul_mem' ha hb := ha.mul hb
  neg_mem' ha := ha.neg
  inv_mem' _ ha := ha.inv

/-- Every element of the subfield generated by a prime-to-`p` root of unity admits an integer
algebraic witness which stays nonzero modulo `p`. -/
private theorem algebraic_witness_of_mem_closure
    {ηK : K} {m₀ : ℕ} (hm₀ : m₀ ≠ 0) (hηpow : ηK ^ m₀ = 1)
    (hchar : ringChar K = 0 ∨ ringChar K = p)
    {z : K} (hz : z ∈ Subfield.closure {ηK}) :
    ∃ q : Polynomial ℤ, Polynomial.aeval z q = 0 ∧
      q.map (Int.castRingHom (ZMod p)) ≠ 0 := by
  classical
  rcases hchar with h0 | hpchar
  · -- characteristic zero: descend the minimal polynomial over `ℚ` to a primitive integer
    -- polynomial.
    haveI : CharP K 0 := ringChar.eq_iff.mp h0
    haveI : CharZero K := CharP.charP_to_charZero K
    have hzint : IsIntegral ℚ z := by
      have hle : Subfield.closure {ηK} ≤ integralSubfield ℚ := by
        rw [Subfield.closure_le]
        intro y hy
        rcases hy with rfl
        exact isIntegral_of_pow_eq_one hm₀ hηpow
      exact hle hz
    obtain ⟨q₀, hq₀monic, hq₀eval⟩ := hzint
    haveI : IsScalarTower ℤ ℚ K := IsScalarTower.of_algebraMap_eq' (Subsingleton.elim _ _)
    set qZ : Polynomial ℤ := IsLocalization.integerNormalization (nonZeroDivisors ℤ) q₀
      with hqZdef
    have hq₀aeval : Polynomial.aeval z q₀ = 0 := by
      rw [Polynomial.aeval_def]
      exact hq₀eval
    have hqZeval : Polynomial.aeval z qZ = 0 := by
      rw [hqZdef]
      exact IsLocalization.integerNormalization_aeval_eq_zero (nonZeroDivisors ℤ) q₀ hq₀aeval
    have hqZne : qZ ≠ 0 := by
      rw [hqZdef, Ne, IsFractionRing.integerNormalization_eq_zero_iff]
      exact hq₀monic.ne_zero
    -- pass to the primitive part
    refine ⟨qZ.primPart, ?_, ?_⟩
    · have hsplit : qZ = Polynomial.C qZ.content * qZ.primPart :=
        qZ.eq_C_content_mul_primPart
      have : Polynomial.aeval z (Polynomial.C qZ.content * qZ.primPart) = 0 := by
        rw [← hsplit]
        exact hqZeval
      rw [map_mul, Polynomial.aeval_C] at this
      have hcontent : (algebraMap ℤ K) qZ.content ≠ 0 := by
        rw [Ne, map_eq_zero_iff _ (algebraMap ℤ K).injective_int]
        rw [Polynomial.content_eq_zero_iff]
        exact hqZne
      exact (mul_eq_zero.mp this).resolve_left hcontent
    · intro hmap
      have hdvd : Polynomial.C ((p : ℕ) : ℤ) ∣ qZ.primPart := by
        rw [Polynomial.C_dvd_iff_dvd_coeff]
        intro n
        have hcoeff : ((qZ.primPart.coeff n : ℤ) : ZMod p) = 0 := by
          have := congrArg (fun r ↦ Polynomial.coeff r n) hmap
          simpa [Polynomial.coeff_map] using this
        exact_mod_cast (ZMod.intCast_zmod_eq_zero_iff_dvd _ p).mp hcoeff
      have hunit : IsUnit ((p : ℕ) : ℤ) := qZ.isPrimitive_primPart _ hdvd
      rcases Int.isUnit_iff.mp hunit with h1 | h1
      · have : (p : ℕ) = 1 := by exact_mod_cast h1
        exact (Fact.out : p.Prime).one_lt.ne' this
      · have : ((p : ℕ) : ℤ) ≥ 0 := Int.natCast_nonneg p
        omega
  · -- characteristic `p`: descend the witness over `ZMod p` along the coefficient surjection.
    haveI : CharP K p := ringChar.eq_iff.mp hpchar
    letI : Algebra (ZMod p) K := ZMod.algebra _ p
    have hzint : IsIntegral (ZMod p) z := by
      have hle : Subfield.closure {ηK} ≤ integralSubfield (ZMod p) := by
        rw [Subfield.closure_le]
        intro y hy
        rcases hy with rfl
        exact isIntegral_of_pow_eq_one hm₀ hηpow
      exact hle hz
    obtain ⟨q₁, hq₁monic, hq₁eval⟩ := hzint
    obtain ⟨qZ, hqZmap⟩ :=
      Polynomial.map_surjective (Int.castRingHom (ZMod p)) ZMod.intCast_surjective q₁
    refine ⟨qZ, ?_, ?_⟩
    · -- evaluate over `ℤ` through the prime field
      rw [Polynomial.aeval_def]
      rw [show algebraMap ℤ K =
            (algebraMap (ZMod p) K).comp (Int.castRingHom (ZMod p)) from
          Subsingleton.elim _ _]
      rw [← Polynomial.eval₂_map, hqZmap, ← Polynomial.aeval_def]
      exact hq₁eval
    · rw [hqZmap]
      exact hq₁monic.ne_zero

end AlgebraicWitness

section Assembly

variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k p]
variable {K : Type u} [Field K]
variable {G : Type u} [Group G] [Finite G]
variable {ι : Type x}

/-- Mixed-characteristic realization of Serre part `(a)`, torsion-lift form: a normalized
vanishing Brauer-character relation is contradictory whenever the coefficient lift restricts to a
power-compatible injective lift of one generator of the relevant torsion.  This form only
constrains the lift on the `pRegularExponent p G`-torsion, so it also covers Serre's original
"sufficiently large" coefficient fields, which need not admit a lift of all prime-to-`p` roots of
unity. -/
theorem supported_normalized_brauer_relation_contradiction_of_torsion_lift
    (liftFn : PrimeToPRoot p k → K)
    (ζ : PrimeToPRoot p k)
    (hζord : orderOf ζ = pRegularExponent p G)
    (hζgen : ∀ x : PrimeToPRoot p k, x ^ pRegularExponent p G = 1 → ∃ t : ℕ, x = ζ ^ t)
    (η : Kˣ)
    (hηord : orderOf η = pRegularExponent p G)
    (hliftpow : ∀ t : ℕ, liftFn (ζ ^ t) = ((η : Kˣ) : K) ^ t)
    (hchar : ringChar K = 0 ∨ ringChar K = p)
    (E : ι → FDRep k G)
    (hE_simple : ∀ i, Simple (E i))
    (hE_pairwise : PairwiseNonisomorphic E)
    (s : Finset ι)
    (aNorm : ι → K)
    (hsumNorm :
      (Finset.sum s
          fun j ↦ aNorm j •
            FDRep.modularCharacterOnPRegularConjClass (p := p) (E j) liftFn) =
        (0 : PRegularConjClass G p → K))
    {i : ι} (hi : i ∈ s)
    (haNorm_i : aNorm i = 1) :
    False := by
  classical
  have hm₀ : pRegularExponent p G ≠ 0 := pRegularExponent_ne_zero (p := p) (G := G)
  have hpm₀ : ¬ p ∣ pRegularExponent p G :=
    not_prime_dvd_pRegularExponent (p := p) (G := G) Fact.out
  -- The lifted torsion generator and the coefficient subfield it generates.
  set ηK : K := ((η : Kˣ) : K) with hηKdef
  have hηKpow : ηK ^ pRegularExponent p G = 1 := by
    have := pow_orderOf_eq_one η
    rw [hηord] at this
    exact_mod_cast congrArg (Units.coeHom K) this
  set F : Subfield K := Subfield.closure {ηK} with hFdef
  have hηFmem : ηK ∈ F := Subfield.subset_closure rfl
  set ηF : F := ⟨ηK, hηFmem⟩ with hηFdef
  -- The torsion-supported lift into `F`.
  set liftF : PrimeToPRoot p k → F := fun y ↦
    if hy : y ^ pRegularExponent p G = 1 then ηF ^ Classical.choose (hζgen y hy) else 1
    with hliftFdef
  have hliftF_torsion : ∀ (y : PrimeToPRoot p k) (hy : y ^ pRegularExponent p G = 1),
      liftF y = ηF ^ Classical.choose (hζgen y hy) := by
    intro y hy
    rw [hliftFdef]
    exact dif_pos hy
  have hliftF_coe : ∀ (y : PrimeToPRoot p k), y ^ pRegularExponent p G = 1 →
      ((liftF y : F) : K) = liftFn y := by
    intro y hy
    have hyspec : y = ζ ^ Classical.choose (hζgen y hy) := Classical.choose_spec (hζgen y hy)
    rw [hliftF_torsion y hy]
    show ((ηF ^ Classical.choose (hζgen y hy) : F) : K) = liftFn y
    conv_rhs => rw [hyspec, hliftpow]
    push_cast [hηFdef]
    rfl
  -- Pointwise evaluation of the vanishing relation on `p`-regular elements.
  have hpoint : ∀ t : { g : G // IsPRegular p g },
      (Finset.sum s fun j ↦
        aNorm j * (φ[liftFn]((E j).ρ) t)) = 0 := fun t ↦
    sum_smul_modularCharacterOnPRegularConjClass_eq_zero_on_support_local
      (p := p) liftFn E s aNorm hsumNorm t
  -- The Brauer values descend to `F`.
  have hchar_eq : ∀ (j : ι) (t : { g : G // IsPRegular p g }),
      φ[liftFn]((E j).ρ) t =
        ((modularCharacter liftF (E j).ρ t : F) : K) := by
    intro j t
    have hcongr :=
      modularCharacter_congr_of_eqOn_torsion (p := p) (k := k) (G := G)
        (lift₁ := fun y ↦ ((liftF y : F) : K))
        (lift₂ := liftFn)
        hliftF_coe (E j).ρ t
    have hcomp :=
      ringHom_modularCharacter (p := p) (k := k) (G := G)
        F.subtype liftF (E j).ρ t
    calc
      φ[liftFn]((E j).ρ) t =
          modularCharacter (fun y ↦ ((liftF y : F) : K)) (E j).ρ t := hcongr.symm
      _ = ((modularCharacter liftF (E j).ρ t : F) : K) := hcomp.symm
  -- Descend the relation to coefficients in `F`.
  obtain ⟨c, hcrel, j₁, hj₁s, hj₁ne⟩ :=
    exists_subfield_relation_of_relation (K := K) F s
      (v := fun j t ↦ modularCharacter liftF (E j).ρ t) aNorm
      (fun t ↦ by
        rw [← hpoint t]
        exact (Finset.sum_congr rfl fun j _ ↦ by rw [hchar_eq j t]).symm)
      hi (by rw [haNorm_i]; exact one_ne_zero)
  -- The characteristic of `F` is `0` or `p`.
  have hcharK : ringChar K = 0 ∨ ringChar K = p := hchar
  have hcharF : ringChar (F : Type u) = 0 ∨ ringChar (F : Type u) = p := by
    have hCF : CharP (F : Type u) (ringChar K) := by
      constructor
      intro n
      rw [← CharP.cast_eq_zero_iff K (ringChar K) n]
      constructor
      · intro h
        have := congrArg F.subtype h
        simpa using this
      · intro h
        apply Subtype.ext
        simpa using h
    have : ringChar (F : Type u) = ringChar K := ringChar.eq_iff.mpr hCF
    rw [this]
    exact hcharK
  -- Every element of `F` admits a `p`-free integer algebraic witness.
  have halgF : ∀ z : (F : Type u), ∃ q : Polynomial ℤ, Polynomial.aeval z q = 0 ∧
      q.map (Int.castRingHom (ZMod p)) ≠ 0 := by
    intro z
    have hzc : (z : K) ∈ Subfield.closure {ηK} := by
      rw [← hFdef]
      exact z.property
    obtain ⟨q, hqeval, hqmap⟩ :=
      algebraic_witness_of_mem_closure (p := p) hm₀ hηKpow hcharK hzc
    refine ⟨q, ?_, hqmap⟩
    -- transfer the vanishing through the injective inclusion `F → K`
    have hcomm :
        (F.subtype.toIntAlgHom) (Polynomial.aeval z q) =
          Polynomial.aeval (F.subtype.toIntAlgHom z) q :=
      (Polynomial.aeval_algHom_apply (F.subtype.toIntAlgHom) z q).symm
    apply Subtype.coe_injective
    have : (F.subtype.toIntAlgHom) (Polynomial.aeval z q) = 0 := by
      rw [hcomm]
      exact hqeval
    simpa using this
  -- The generator is a unit of `F` of full order.
  have hηFpow : ηF ^ pRegularExponent p G = 1 := by
    apply Subtype.ext
    push_cast [hηFdef]
    exact hηKpow
  have hηFne : ηF ≠ 0 := by
    intro h0
    have h0K : ηK = 0 := by
      have := congrArg F.subtype h0
      simpa [hηFdef] using this
    rw [hηKdef] at h0K
    exact Units.ne_zero η h0K
  set ηFu : (F : Type u)ˣ := Units.mk0 ηF hηFne with hηFudef
  have hηFuord : orderOf ηFu = pRegularExponent p G := by
    have hiff : ∀ n : ℕ, ηFu ^ n = 1 ↔ η ^ n = 1 := by
      intro n
      have hcoeF : ((ηFu ^ n : (F : Type u)ˣ) : (F : Type u)) = ηF ^ n := by
        push_cast [hηFudef]
        rfl
      constructor
      · intro h
        have hF : ηF ^ n = 1 := by
          rw [← hcoeF, h]
          rfl
        have hK : ηK ^ n = 1 := by
          have := congrArg F.subtype hF
          push_cast [hηFdef] at this
          exact this
        apply Units.ext
        push_cast
        rw [hηKdef] at hK
        exact hK
      · intro h
        apply Units.ext
        rw [hcoeF]
        apply Subtype.ext
        push_cast [hηFdef]
        show ηK ^ n = 1
        rw [hηKdef]
        exact_mod_cast congrArg (Units.coeHom K) h
    rw [orderOf_eq_orderOf_iff.mpr hiff]
    exact hηord
  -- The residue package.
  obtain ⟨B, θ, ξ, hRB, hξord, hθpow⟩ :=
    exists_residue_data (p := p) (k := k) (L := (F : Type u)) hm₀ hpm₀ ηFu hηFuord hcharF halgF
  -- Scale the descended relation by a coefficient of minimal valuation.
  obtain ⟨j₀, hj₀s, hj₀ne, hdiv⟩ :=
    exists_valuation_scaling_index B c s ⟨j₁, hj₁s, hj₁ne⟩
  have hreldiv : ∀ t : { g : G // IsPRegular p g },
      (Finset.sum s fun j ↦ (c j / c j₀) * modularCharacter liftF (E j).ρ t) = 0 := by
    intro t
    have hzero := hcrel t
    calc
      (Finset.sum s fun j ↦ (c j / c j₀) * modularCharacter liftF (E j).ρ t) =
          (c j₀)⁻¹ * Finset.sum s fun j ↦ c j * modularCharacter liftF (E j).ρ t := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl fun j _ ↦ by ring
      _ = 0 := by rw [hzero, mul_zero]
  -- All lift values lie in the valuation subring.
  have hliftFB : ∀ y : PrimeToPRoot p k, liftF y ∈ B.toSubring := by
    intro y
    apply hRB
    by_cases hy : y ^ pRegularExponent p G = 1
    · rw [hliftF_torsion y hy]
      have hgen : ((ηFu : (F : Type u)ˣ) : (F : Type u)) ∈
          Subring.closure {((ηFu : (F : Type u)ˣ) : (F : Type u))} :=
        Subring.subset_closure rfl
      have : ηF ∈ Subring.closure {((ηFu : (F : Type u)ˣ) : (F : Type u))} := by
        rw [hηFudef] at hgen ⊢
        simpa using hgen
      exact pow_mem this _
    · rw [show liftF y = 1 from dif_neg hy]
      exact one_mem _
  set liftB : PrimeToPRoot p k → B := fun y ↦ ⟨liftF y, hliftFB y⟩ with hliftBdef
  -- Transport the relation through the residue homomorphism, with the `b`-power twist.
  set ζkU : kˣ := ((ζ : (primeToPRoots p k)) : kˣ) with hζkUdef
  have hζkUord : orderOf ζkU = pRegularExponent p G := by
    rw [hζkUdef, ← hζord]
    exact orderOf_injective (primeToPRoots p k).subtype
      (primeToPRoots p k).subtype_injective ζ
  obtain ⟨b, hb1, hbξ⟩ : ∃ b : ℕ, 1 ≤ b ∧ ξ = ζkU ^ b := by
    have hξpow : ξ ^ pRegularExponent p G = 1 := by
      rw [← hξord]
      exact pow_orderOf_eq_one ξ
    obtain ⟨b0, hb0⟩ := eq_pow_of_orderOf_eq_of_pow_eq_one (k := k) hm₀ hζkUord hξpow
    rcases Nat.eq_zero_or_pos b0 with rfl | hpos
    · refine ⟨pRegularExponent p G, Nat.one_le_iff_ne_zero.mpr hm₀, ?_⟩
      rw [pow_zero] at hb0
      rw [hb0, ← hζkUord, pow_orderOf_eq_one]
    · exact ⟨b0, hpos, hb0⟩
  have hb0 : b ≠ 0 := Nat.one_le_iff_ne_zero.mp hb1
  have hcob : Nat.Coprime b (pRegularExponent p G) := by
    have horder : orderOf (ζkU ^ b) = pRegularExponent p G := by
      rw [← hbξ]
      exact hξord
    rw [orderOf_pow' ζkU hb0, hζkUord] at horder
    have hgcd : Nat.gcd (pRegularExponent p G) b = 1 := by
      rcases Nat.div_eq_self.mp horder with h | h
      · exact absurd h hm₀
      · exact h
    exact Nat.Coprime.symm hgcd
  -- `θ ∘ liftB` is the tautological lift twisted by the `b`-th power.
  have hθliftB : ∀ (y : PrimeToPRoot p k), y ^ pRegularExponent p G = 1 →
      θ (liftB y) = (((y : kˣ) : k)) ^ b := by
    intro y hy
    have hyspec : y = ζ ^ Classical.choose (hζgen y hy) := Classical.choose_spec (hζgen y hy)
    have hval : ((liftB y : B) : (F : Type u)) =
        ((ηFu : (F : Type u)ˣ) : (F : Type u)) ^ Classical.choose (hζgen y hy) := by
      show liftF y = _
      rw [hliftF_torsion y hy, hηFudef]
      push_cast
      rfl
    rw [hθpow (liftB y) (Classical.choose (hζgen y hy)) hval]
    have hyk : ((y : kˣ) : k) = ((ζkU : kˣ) : k) ^ Classical.choose (hζgen y hy) := by
      conv_lhs => rw [hyspec]
      rw [hζkUdef]
      push_cast
      rfl
    rw [hyk, hbξ]
    push_cast
    rw [← pow_mul, ← pow_mul, Nat.mul_comm]
  -- The `b`-th power preserves `p`-regularity.
  have hregpow : ∀ (g : G) (n : ℕ), IsPRegular p g → IsPRegular p (g ^ n) := by
    intro g n hg
    exact Nat.Coprime.coprime_dvd_right (orderOf_pow_dvd n) hg
  obtain ⟨b', _hb'pos, hbb'⟩ := exists_pow_inverse (p := p) (G := G) hcob
  -- The residue coefficients.
  set w : ι → k := fun j ↦ if hj : j ∈ s then θ ⟨c j / c j₀, hdiv j hj⟩ else 0 with hwdef
  -- Per-term computation: the residue of a Brauer value is the tautological Brauer value at the
  -- `b`-th power of the evaluation point.
  have hterm : ∀ (j : ι) (t : { g : G // IsPRegular p g }),
      θ (modularCharacter liftB (E j).ρ t) =
        modularCharacter (⇑(valueLift p k)) (E j).ρ ⟨t.1 ^ b, hregpow t.1 b t.2⟩ := by
    intro j t
    rw [ringHom_modularCharacter (p := p) (k := k) (G := G) θ liftB (E j).ρ t]
    have hcg :=
      modularCharacter_congr_of_eqOn_torsion (p := p) (k := k) (G := G)
        (lift₁ := fun y ↦ θ (liftB y))
        (lift₂ := fun y ↦ (((y : kˣ) : k)) ^ b)
        hθliftB (E j).ρ t
    rw [hcg]
    rw [modularCharacter_eq_roots_sum (p := p) (k := k) (G := G)
      (lift := fun y ↦ (((y : kˣ) : k)) ^ b)
      (f := fun μ ↦ μ ^ b) (fun y ↦ rfl) (E j).ρ t]
    rw [modularCharacter_eq_roots_sum (p := p) (k := k) (G := G)
      (lift := ⇑(valueLift p k))
      (f := fun μ ↦ μ) (fun y ↦ rfl) (E j).ρ ⟨t.1 ^ b, hregpow t.1 b t.2⟩]
    have hrep : (E j).ρ (t.1 ^ b) = ((E j).ρ t.1) ^ b := map_pow _ _ _
    rw [show ((E j).ρ (t.1 ^ b)).charpoly.roots = (((E j).ρ t.1) ^ b).charpoly.roots by
      rw [hrep]]
    rw [charpoly_pow_roots ((E j).ρ t.1) hb0]
    rw [Multiset.map_map]
    rfl
  -- The transported pointwise relation over `k`.
  have hfinal : ∀ t : { g : G // IsPRegular p g },
      (Finset.sum s fun j ↦
        w j * modularCharacter (⇑(valueLift p k)) (E j).ρ t) = 0 := by
    intro t
    -- realize `t` as a `b`-th power of a `p`-regular element
    set t' : { g : G // IsPRegular p g } := ⟨t.1 ^ b', hregpow t.1 b' t.2⟩ with ht'def
    have ht'b : (⟨t'.1 ^ b, hregpow t'.1 b t'.2⟩ : { g : G // IsPRegular p g }) = t := by
      apply Subtype.ext
      show (t.1 ^ b') ^ b = t.1
      calc
        (t.1 ^ b') ^ b = (t.1 ^ b) ^ b' := by
          rw [← pow_mul, ← pow_mul, Nat.mul_comm]
        _ = t.1 := hbb' t.1 t.2
    -- the `B`-level relation at `t'`
    have hvB : ∀ (j : ι) (t0 : { g : G // IsPRegular p g }),
        ((modularCharacter liftB (E j).ρ t0 : B) : (F : Type u)) =
          modularCharacter liftF (E j).ρ t0 := fun j t0 ↦
      ringHom_modularCharacter (p := p) (k := k) (G := G)
        B.toSubring.subtype liftB (E j).ρ t0
    have hB : (Finset.sum s.attach fun j ↦
        (⟨c j.1 / c j₀, hdiv j.1 j.2⟩ : B) * modularCharacter liftB (E j.1).ρ t') = 0 := by
      refine Subtype.coe_injective ?_
      have hcoe : ((Finset.sum s.attach fun j ↦
          (⟨c j.1 / c j₀, hdiv j.1 j.2⟩ : B) * modularCharacter liftB (E j.1).ρ t' : B) :
            (F : Type u)) =
          Finset.sum s.attach fun j ↦
            (c j.1 / c j₀) * modularCharacter liftF (E j.1).ρ t' := by
        push_cast
        refine Finset.sum_congr rfl fun j _ ↦ ?_
        congr 1
        exact hvB j.1 t'
      show ((Finset.sum s.attach fun j ↦
          (⟨c j.1 / c j₀, hdiv j.1 j.2⟩ : B) * modularCharacter liftB (E j.1).ρ t' : B) :
            (F : Type u)) = ((0 : B) : (F : Type u))
      rw [hcoe]
      rw [Finset.sum_attach s fun j ↦ (c j / c j₀) * modularCharacter liftF (E j).ρ t']
      rw [hreldiv t']
      rfl
    have hθB := congrArg θ hB
    rw [map_sum, map_zero] at hθB
    simp only [map_mul] at hθB
    -- rewrite each summand through `hterm` and the `b`-th power realization
    have hθB' : (Finset.sum s.attach fun j ↦
        θ ⟨c j.1 / c j₀, hdiv j.1 j.2⟩ *
          modularCharacter (⇑(valueLift p k)) (E j.1).ρ t) = 0 := by
      rw [← hθB]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      congr 1
      rw [hterm j.1 t', ht'b]
    rw [← hθB']
    rw [← Finset.sum_attach s fun j ↦ w j * modularCharacter (⇑(valueLift p k)) (E j).ρ t]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    congr 1
    rw [hwdef]
    exact dif_pos j.2
  -- Lift the pointwise relation to the descended class functions.
  have hclass : (Finset.sum s fun j ↦
      w j • FDRep.modularCharacterOnPRegularConjClass (p := p) (E j) (⇑(valueLift p k))) =
      (0 : PRegularConjClass G p → k) := by
    funext cc
    rw [Finset.sum_apply, Pi.zero_apply]
    set r := PRegularConjClass.representative (G := G) (p := p) cc with hrdef
    have hr : PRegularConjClass.ofSubtype (G := G) p r = cc := by
      apply Subtype.ext
      simpa [hrdef] using PRegularConjClass.mk_representative (G := G) (p := p) cc
    rw [← hfinal r]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Pi.smul_apply, smul_eq_mul]
    congr 1
    rw [← hr]
    exact FDRep.modularCharacterOnPRegularConjClass_ofSubtype (p := p) (E j) _ r
  -- Jacobson density: the distinguished residue coefficient vanishes.
  obtain ⟨tsep, htsep_i, htsep_others⟩ :=
    support_product_separator_exists_local E hE_simple hE_pairwise s hj₀s
  have hzero :=
    coefficient_vanishes_on_support_of_zero_brauer_relation_with_residue_reduction_local
      (p := p) (k := k) (A := k) (valueLift p k) (RingHom.id k) (fun y ↦ rfl)
      E s w hclass hj₀s tsep htsep_i htsep_others
  -- But that coefficient is `θ 1 = 1`.
  have hw1 : w j₀ = 1 := by
    have hwval : w j₀ = θ ⟨c j₀ / c j₀, hdiv j₀ hj₀s⟩ := dif_pos hj₀s
    rw [hwval]
    have h1 : (⟨c j₀ / c j₀, hdiv j₀ hj₀s⟩ : B) = 1 := by
      apply Subtype.ext
      push_cast
      exact div_self hj₀ne
    rw [h1, map_one]
  rw [show (RingHom.id k) (w j₀) = w j₀ from rfl] at hzero
  rw [hw1] at hzero
  exact one_ne_zero hzero

/-- Mixed-characteristic realization of Serre part `(a)` for a globally defined injective
multiplicative lift: a normalized vanishing Brauer-character relation over any admissible
coefficient field is contradictory. -/
theorem supported_normalized_brauer_relation_contradiction_realization
    (lift : PrimeToPRoot p k →* Kˣ)
    (hlift : Function.Injective lift)
    (E : ι → FDRep k G)
    (hE_simple : ∀ i, Simple (E i))
    (hE_pairwise : PairwiseNonisomorphic E)
    (s : Finset ι)
    (aNorm : ι → K)
    (hsumNorm :
      (Finset.sum s
          fun j ↦ aNorm j •
            FDRep.modularCharacterOnPRegularConjClass (p := p) (E j)
              (PrimeToPRoot.toFieldLift lift)) =
        (0 : PRegularConjClass G p → K))
    {i : ι} (hi : i ∈ s)
    (haNorm_i : aNorm i = 1) :
    False := by
  classical
  obtain ⟨ζ, hζord, hζgen⟩ := exists_torsion_generator p k G
  refine
    supported_normalized_brauer_relation_contradiction_of_torsion_lift
      (p := p) (k := k) (K := K) (G := G)
      (PrimeToPRoot.toFieldLift lift) ζ hζord hζgen (lift ζ) ?_ ?_ ?_
      E hE_simple hE_pairwise s aNorm hsumNorm hi haNorm_i
  · rw [orderOf_injective lift hlift]
    exact hζord
  · intro t
    show ((lift (ζ ^ t) : Kˣ) : K) = ((lift ζ : Kˣ) : K) ^ t
    rw [map_pow]
    push_cast
    rfl
  · exact ringChar_eq_zero_or_eq_of_injective_lift lift hlift

