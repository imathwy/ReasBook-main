/-- A subgroup of a finite group is finite. -/
local instance (H : Subgroup G) : Fintype H := Fintype.ofFinite H

/-- Helper for Corollary 11-11.1-5: pairing a virtual character on a finite group with a linear
character lands in the image of `ℤ`. -/
lemma pairing_mem_range_int_of_mem_characterRing_with_linear_character
    {H : Type u} [Group H] [Finite H] (η : R(H)) (χ : H →* ℂˣ) :
    ⟪χ.toCharacterRing, (η : H → ℂ)⟫ ∈ Set.range (algebraMap ℤ ℂ) := by
  let S : Set (H → ℂ) :=
    { ψ |
        ∃ (X : Type u) (_ : AddCommGroup X) (_ : Module ℂ X)
          (_ : FiniteDimensional ℂ X) (σ : Representation ℂ H X),
          ψ = σ.character }
  have hmul_span :
      ∀ {f g : H → ℂ},
        f ∈ Submodule.span ℤ S →
        g ∈ Submodule.span ℤ S →
        f * g ∈ Submodule.span ℤ S := by
    intro f g hf hg
    have hfg : ∀ g : H → ℂ, g ∈ Submodule.span ℤ S → f * g ∈ Submodule.span ℤ S := by
      induction hf using Submodule.span_induction with
      | mem ψ hψ =>
          have hψ' :
              ∃ (X : Type u) (_ : AddCommGroup X) (_ : Module ℂ X)
                (_ : FiniteDimensional ℂ X) (σ : Representation ℂ H X),
                ψ = σ.character := by
            simpa [S] using hψ
          rcases hψ' with ⟨X, _instXAdd, _instXMod, _instXfd, σ, rfl⟩
          intro g hg
          induction hg using Submodule.span_induction with
          | mem ξ hξ =>
              have hξ' :
                  ∃ (Y : Type u) (_ : AddCommGroup Y) (_ : Module ℂ Y)
                    (_ : FiniteDimensional ℂ Y) (τ : Representation ℂ H Y),
                    ξ = τ.character := by
                simpa [S] using hξ
              rcases hξ' with ⟨Y, _instYAdd, _instYMod, _instYfd, τ, rfl⟩
              let π : Representation ℂ H (TensorProduct ℂ X Y) := σ.tprod τ
              -- Tensor products realize pointwise products of honest characters.
              refine Submodule.subset_span ?_
              refine ⟨TensorProduct ℂ X Y, inferInstance, inferInstance, inferInstance, π, ?_⟩
              change σ.character * τ.character = (σ.tprod τ).character
              exact (Representation.char_tensor (ρ := σ) (σ := τ)).symm
          | zero =>
              have hzero_mul : σ.character * (0 : H → ℂ) = 0 := by
                ext x
                simp
              rw [hzero_mul]
              exact
                (Submodule.zero_mem (Submodule.span ℤ S) : (0 : H → ℂ) ∈ Submodule.span ℤ S)
          | add ξ ζ _ _ hξ hζ =>
              simpa [mul_add] using Submodule.add_mem (Submodule.span ℤ S) hξ hζ
          | smul n ξ _ hξ =>
              have hmul_zsmul : σ.character * (n • ξ) = n • (σ.character * ξ) := by
                ext x
                simp [zsmul_eq_mul, mul_left_comm]
              rw [hmul_zsmul]
              exact Submodule.smul_mem (Submodule.span ℤ S) n hξ
      | zero =>
          intro g hg
          have hzero_mul : (0 : H → ℂ) * g = 0 := by
            ext x
            simp
          rw [hzero_mul]
          exact (Submodule.zero_mem (Submodule.span ℤ S) : (0 : H → ℂ) ∈ Submodule.span ℤ S)
      | add f₁ f₂ _ _ hf₁ hf₂ =>
          intro g hg
          simpa [add_mul] using
            Submodule.add_mem (Submodule.span ℤ S) (hf₁ g hg) (hf₂ g hg)
      | smul n f _ hf =>
          intro g hg
          simpa [zsmul_eq_mul, mul_left_comm, mul_assoc] using
            Submodule.smul_mem (Submodule.span ℤ S) n (hf g hg)
    exact hfg g hg
  have hηspan : (η : H → ℂ) ∈ Submodule.span ℤ S := by
    -- The local character ring is the `ℤ`-subalgebra generated by honest characters.
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ η.2
    · intro ψ hψ
      rcases hψ with ⟨σ, hσfd, _hσirr, rfl⟩
      exact Submodule.subset_span
        ⟨(σ : Type u), inferInstance, inferInstance, hσfd, σ.ρ, rfl⟩
    · intro n
      have htriv :
          (Representation.trivial ℂ H (ULift.{u} ℂ)).character = (1 : H → ℂ) := by
        ext x
        simp [Representation.character, Representation.trivial]
      have hmap :
          algebraMap ℤ (H → ℂ) n =
            n • (Representation.trivial ℂ H (ULift.{u} ℂ)).character := by
        ext x
        simp [htriv]
      rw [hmap]
      exact
        Submodule.smul_mem (Submodule.span ℤ S) n <|
          Submodule.subset_span
            ⟨ULift.{u} ℂ, inferInstance, inferInstance, inferInstance,
              Representation.trivial ℂ H (ULift.{u} ℂ), rfl⟩
    · intro f g _ _ hf hg
      exact Submodule.add_mem (Submodule.span ℤ S) hf hg
    · intro f g _ _ hf hg
      exact hmul_span hf hg
  -- Commute the pairing so it suffices to test the `ℤ`-span generators.
  rw [Representation.groupFunctionPairing_comm]
  refine
    Submodule.span_induction
      (p := fun ψ _ ↦ ⟪ψ, χ.toCharacterRing⟫ ∈ Set.range (algebraMap ℤ ℂ))
      ?_ ?_ ?_ ?_ hηspan
  · intro ψ hψ
    have hψ' :
        ∃ (X : Type u) (_ : AddCommGroup X) (_ : Module ℂ X)
          (_ : FiniteDimensional ℂ X) (σ : Representation ℂ H X),
          ψ = σ.character := by
      simpa [S] using hψ
    rcases hψ' with ⟨X, _instXAdd, _instXMod, _instXfd, σ, rfl⟩
    have hcard_ne : (Nat.card H : ℂ) ≠ 0 := by
      exact_mod_cast Nat.card_pos.ne'
    letI : Invertible (Nat.card H : ℂ) := invertibleOfNonzero hcard_ne
    have hpair :
        ⟪σ.character, χ.toCharacterRing⟫ =
          Module.finrank ℂ (σ.IntertwiningMap χ.toRepresentation) := by
      simpa [MonoidHom.toCharacterRing_apply] using
        (Representation.groupFunctionPairingOverField_character_eq_finrank_intertwiningMap
          (K := ℂ) σ χ.toRepresentation)
    refine ⟨(Module.finrank ℂ (σ.IntertwiningMap χ.toRepresentation) : ℤ), ?_⟩
    simpa using hpair.symm
  · change groupFunctionPairingOverField ℂ (0 : H → ℂ) (χ.toCharacterRing : H → ℂ) ∈
      Set.range (algebraMap ℤ ℂ)
    refine ⟨0, ?_⟩
    simp [Representation.groupFunctionPairingOverField]
  · intro ψ ξ _ _ hψ hξ
    rcases hψ with ⟨a, ha⟩
    rcases hξ with ⟨b, hb⟩
    refine ⟨a + b, ?_⟩
    calc
      algebraMap ℤ ℂ (a + b) = algebraMap ℤ ℂ a + algebraMap ℤ ℂ b := by simp
      _ = groupFunctionPairingOverField ℂ ψ (χ.toCharacterRing : H → ℂ) +
            groupFunctionPairingOverField ℂ ξ (χ.toCharacterRing : H → ℂ) := by
          rw [ha, hb]
      _ = groupFunctionPairingOverField ℂ (ψ + ξ) (χ.toCharacterRing : H → ℂ) := by
          rw [Representation.groupFunctionPairing_add_left]
  · intro n ψ _ hψ
    rcases hψ with ⟨a, ha⟩
    refine ⟨n * a, ?_⟩
    calc
      algebraMap ℤ ℂ (n * a) = (n : ℂ) * algebraMap ℤ ℂ a := by
        simp [map_mul]
      _ = (n : ℂ) * groupFunctionPairingOverField ℂ ψ (χ.toCharacterRing : H → ℂ) := by
          rw [ha]
      _ = groupFunctionPairingOverField ℂ (n • ψ) (χ.toCharacterRing : H → ℂ) := by
          symm
          simpa [zsmul_eq_mul] using
            (Representation.groupFunctionPairing_smul_left
              (a := (n : ℂ)) (φ := ψ) (ψ := (χ.toCharacterRing : H → ℂ)))

omit [Finite G] in
/-- Helper for Corollary 11-11.1-5: restricting a global virtual character to a subgroup stays in
the subgroup character ring. -/
lemma restrict_mem_characterRing
    (H : Subgroup G) {φ : G → ℂ} (hφ : φ ∈ R(G)) :
    (fun h : H ↦ φ h) ∈ R(H) := by
  -- Restriction respects the algebra generators defining LinearRepresentations_Serre_1977's character ring.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hφ
  · intro ψ hψ
    rcases hψ with ⟨σ, hσfd, _hσirr, rfl⟩
    letI : FiniteDimensional ℂ σ := hσfd
    simpa using
      (Representation.rep_character_mem_characterRing
        (Rep.res H.subtype (Rep.of σ.ρ)))
  · intro n
    exact (R(H)).algebraMap_mem n
  · intro f g _ _ hf hg
    simpa using (R(H)).add_mem hf hg
  · intro f g _ _ hf hg
    simpa using (R(H)).mul_mem hf hg

/-- Helper for Corollary 11-11.1-5: over `ℂ`, being integral over `ℤ` is exactly lying in the
image of the integer cast. -/
lemma isInteger_iff_mem_range_int_cast (z : ℂ) :
    IsLocalization.IsInteger ℤ z ↔ z ∈ Set.range (algebraMap ℤ ℂ) := by
  rfl

/-- Helper for Corollary 11-11.1-5: Frobenius reciprocity identifies the pairing of an induced
linear character with the restricted pairing on the subgroup. -/
private theorem groupFunctionPairing_induced_linearCharacter_eq_restriction_corollary
    {H : Type} [Group H] [Finite H]
    (K : Subgroup H) (α : K →* ℂˣ) (x : classFunctionSubmodule ℂ H) :
    ⟪Ind[K](α.toRepresentation.character), (x : H → ℂ)⟫ =
      ⟪α.toCharacterRing, Subgroup.classFunctionRestriction K x⟫ := by
  classical
  let _ : Fintype H := Fintype.ofFinite H
  let _ : Fintype K := Fintype.ofFinite K
  let _ : NeZero (Nat.card H : ℂ) := ⟨by
    exact_mod_cast Nat.card_pos.ne'⟩
  let _ : NeZero (Nat.card K : ℂ) := ⟨by
    exact_mod_cast Nat.card_pos.ne'⟩
  let _ : Invertible (Nat.card H : ℂ) := invertibleOfNonzero <| by
    simpa using (NeZero.ne (Nat.card H : ℂ))
  let _ : Invertible (Nat.card K : ℂ) := invertibleOfNonzero <| by
    simpa using (NeZero.ne (Nat.card K : ℂ))
  obtain ⟨ι, _, π, hπ_pairwise, hπ_complete⟩ :=
    FDRep.exists_complete_pairwise_nonisomorphic_simple_family (k := ℂ) (G := H)
  let b := irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family
    π hπ_pairwise hπ_complete
  let inducedPairing : classFunctionSubmodule ℂ H →ₗ[ℂ] ℂ :=
    { toFun := fun y ↦ ⟪Ind[K](α.toRepresentation.character), (y : H → ℂ)⟫
      map_add' := by
        intro y z
        simpa using Representation.groupFunctionPairing_add_right
          (Ind[K](α.toRepresentation.character)) (y : H → ℂ) (z : H → ℂ)
      map_smul' := by
        intro a y
        simpa using Representation.groupFunctionPairing_smul_right
          a (Ind[K](α.toRepresentation.character)) (y : H → ℂ) }
  let restrictedPairing : classFunctionSubmodule ℂ H →ₗ[ℂ] ℂ :=
    { toFun := fun y ↦ ⟪α.toCharacterRing, Subgroup.classFunctionRestriction K y⟫
      map_add' := by
        intro y z
        simp [Representation.groupFunctionPairing_add_right]
      map_smul' := by
        intro a y
        simp [Representation.groupFunctionPairing_smul_right] }
  have hmaps : inducedPairing = restrictedPairing := by
    -- Compare the two linear functionals on the irreducible-character basis of `H`.
    apply b.ext
    intro i
    have hind :
        Ind[K](α.toRepresentation.character) =
          (Representation.ind K.subtype α.toRepresentation).character := by
      simpa using
        (Subgroup.inducedClassFunction_eq_character_ind (H := K) (θ := α.toRepresentation))
    have hrestrict :
        ((Subgroup.classFunctionRestriction K (b i) : classFunctionSubmodule ℂ K) : K → ℂ) =
          Representation.character ((π i).ρ.comp K.subtype) := by
      ext k
      simp [b, irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family_apply,
        Subgroup.classFunctionRestriction_apply, FDRep.character, Representation.character]
    -- Frobenius reciprocity on characters gives the equality on each basis vector.
    calc
      inducedPairing (b i) =
          ⟪(Representation.ind K.subtype α.toRepresentation).character, (π i).character⟫ := by
            simp [inducedPairing, hind, b,
              irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family_apply]
      _ = ⟪α.toRepresentation.character, Representation.character ((π i).ρ.comp K.subtype)⟫ := by
            simpa using
              (groupFunctionPairing_character_comp_eq_character_ind_bridge
                (α := K.subtype) (E := (π i).ρ) (θ := α.toRepresentation)).symm
      _ = restrictedPairing (b i) := by
            simp [restrictedPairing, hrestrict]
  -- Apply the equality of linear functionals to the target class function.
  have hmaps_apply := congrArg
    (fun f : classFunctionSubmodule ℂ H →ₗ[ℂ] ℂ ↦ f x) hmaps
  simpa [inducedPairing, restrictedPairing] using hmaps_apply

/-- Helper for Corollary 11-11.1-5: any monomial character on an elementary subgroup pairs
integrally against the restricted class function. -/
private theorem pairing_mem_range_of_mem_monomialCharacterSpan_on_elementary_restriction_corollary
    (φ : classFunctionSubmodule ℂ G)
    (hpair : ∀ (H : Subgroup G) (_ : IsElementary H) (χ : H →* ℂˣ),
      ⟪χ.toCharacterRing, Subgroup.classFunctionRestriction H φ⟫ ∈ Set.range (algebraMap ℤ ℂ))
    (H : Subgroup G) (hH : IsElementary H)
    {η : R(H)} (hη : η ∈ monomialCharacterSpan H) :
    ⟪(η : H → ℂ), Subgroup.classFunctionRestriction H φ⟫ ∈ Set.range (algebraMap ℤ ℂ) := by
  rw [monomialCharacterSpan] at hη
  -- Extend the linear-character criterion to the full monomial span by `ℤ`-linearity.
  induction hη using Submodule.span_induction with
  | mem ξ hξ =>
      rcases hξ with ⟨K, α, hα⟩
      -- The generator case is Frobenius reciprocity followed by the nested subgroup bridge.
      rw [← hα]
      rw [groupFunctionPairing_induced_linearCharacter_eq_restriction_corollary]
      exact
        pairing_mem_range_on_nested_elementary_linear_character_local
          (A := ℤ) φ hpair H hH K α
  | zero =>
      refine ⟨0, ?_⟩
      simp [Representation.groupFunctionPairingOverField]
  | add ξ ζ _ _ hξ hζ =>
      rcases hξ with ⟨a, ha⟩
      rcases hζ with ⟨b, hb⟩
      refine ⟨a + b, ?_⟩
      calc
        algebraMap ℤ ℂ (a + b) = algebraMap ℤ ℂ a + algebraMap ℤ ℂ b := by
          simp [map_add]
        _ = groupFunctionPairingOverField ℂ (ξ : H → ℂ) (Subgroup.classFunctionRestriction H φ) +
              groupFunctionPairingOverField ℂ (ζ : H → ℂ) (Subgroup.classFunctionRestriction H φ) := by
            rw [ha, hb]
        _ = groupFunctionPairingOverField ℂ ((ξ : H → ℂ) + (ζ : H → ℂ))
              (Subgroup.classFunctionRestriction H φ) := by
            rw [Representation.groupFunctionPairing_add_left]
        _ = ⟪(((ξ : R(H)) + ζ : R(H)) : H → ℂ), Subgroup.classFunctionRestriction H φ⟫ := by
            rfl
  | smul n ξ _ hξ =>
      rcases hξ with ⟨a, ha⟩
      refine ⟨n * a, ?_⟩
      have hsmul :
          ⟪((n : ℤ) • (ξ : H → ℂ)), Subgroup.classFunctionRestriction H φ⟫ =
            (n : ℂ) * ⟪(ξ : H → ℂ), Subgroup.classFunctionRestriction H φ⟫ := by
        simpa using
          (Representation.groupFunctionPairing_smul_left
            (a := (n : ℂ)) (φ := (ξ : H → ℂ))
            (ψ := Subgroup.classFunctionRestriction H φ))
      change algebraMap ℤ ℂ (n * a) =
        ⟪((n • ξ : R(H)) : H → ℂ), Subgroup.classFunctionRestriction H φ⟫
      calc
        algebraMap ℤ ℂ (n * a) =
            (n : ℂ) * ⟪(ξ : H → ℂ), Subgroup.classFunctionRestriction H φ⟫ := by
              calc
                algebraMap ℤ ℂ (n * a) = (n : ℂ) * algebraMap ℤ ℂ a := by
                  simp [map_mul]
                _ = (n : ℂ) * ⟪(ξ : H → ℂ), Subgroup.classFunctionRestriction H φ⟫ := by
                  rw [ha]
        _ = ⟪((n : ℤ) • (ξ : H → ℂ)), Subgroup.classFunctionRestriction H φ⟫ := hsmul.symm
        _ = ⟪((n • ξ : R(H)) : H → ℂ), Subgroup.classFunctionRestriction H φ⟫ := by
              rfl

/-- Helper for Corollary 11-11.1-5: the elementary restriction already lies in the realized
integral character span once all linear-character pairings are integral. -/
private theorem elementary_restriction_mem_characterRingScalarExtension_of_pairing_mem_range_corollary
    (φ : classFunctionSubmodule ℂ G)
    (hpair : ∀ (H : Subgroup G) (_ : IsElementary H) (χ : H →* ℂˣ),
      ⟪χ.toCharacterRing, Subgroup.classFunctionRestriction H φ⟫ ∈ Set.range (algebraMap ℤ ℂ))
    (H : Subgroup G) (hH : IsElementary H) :
    (Subgroup.classFunctionRestriction H φ : H → ℂ) ∈ characterRingScalarExtension ℤ H := by
  classical
  let _ : NeZero (Nat.card H : ℂ) := ⟨by
    exact_mod_cast Nat.card_pos.ne'⟩
  obtain ⟨ι, _, π, hπ_pairwise, hπ_complete⟩ :=
    FDRep.exists_complete_pairwise_nonisomorphic_simple_family (k := ℂ) (G := H)
  let b := irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family
    π hπ_pairwise hπ_complete
  let x : classFunctionSubmodule ℂ H := Subgroup.classFunctionRestriction H φ
  have hsum :
      ((((∑ i, ((b.repr x i) • b i : classFunctionSubmodule ℂ H)) :
          classFunctionSubmodule ℂ H) : H → ℂ)) ∈ characterRingScalarExtension ℤ H := by
    have hsum_fun :
        (∑ i, ((((b.repr x i) • b i : classFunctionSubmodule ℂ H) : H → ℂ))) ∈
          characterRingScalarExtension ℤ H := by
      -- Expand `x` in the irreducible-character basis and check each coefficient is an integer.
      refine Submodule.sum_mem (characterRingScalarExtension ℤ H) ?_
      intro i hi
      have hmono : fdRepCharacterRing (π i) ∈ monomialCharacterSpan H := by
        rw [monomialCharacterSpan_eq_top_of_isElementary hH]
        simp
      have hpairing :
          ⟪((fdRepCharacterRing (π i) : R(H)) : H → ℂ), (x : H → ℂ)⟫ ∈
            Set.range (algebraMap ℤ ℂ) :=
        pairing_mem_range_of_mem_monomialCharacterSpan_on_elementary_restriction_corollary
          φ hpair H hH hmono
      rcases hpairing with ⟨a, ha⟩
      have ha' :
          algebraMap ℤ ℂ a =
            Representation.groupFunctionPairingOverField ℂ (x : H → ℂ) (π i).character := by
        simpa [fdRepCharacterRing, Representation.groupFunctionPairing_comm] using ha
      have hcoeff : b.repr x i = algebraMap ℤ ℂ a := by
        calc
          b.repr x i =
              Representation.groupFunctionPairingOverField ℂ (x : H → ℂ) (π i).character :=
            repr_irreducible_character_basis_eq_pairing_local
              (π := π) hπ_pairwise hπ_complete x i
          _ = algebraMap ℤ ℂ a := ha'.symm
      have hbase :
          (((b i : classFunctionSubmodule ℂ H) : H → ℂ)) ∈ characterRingScalarExtension ℤ H := by
        have hb :
            (((b i : classFunctionSubmodule ℂ H) : H → ℂ)) =
              (((fdRepCharacterRing (π i) : R(H)) : H → ℂ)) := by
          ext h
          simp [b, irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family_apply]
        rw [hb]
        exact mem_characterRingScalarExtension_of_mem_characterRing
          (((fdRepCharacterRing (π i) : R(H)) : H → ℂ)) (fdRepCharacterRing (π i)).property
      have hterm :
          ((((b.repr x i) • b i : classFunctionSubmodule ℂ H) : H → ℂ)) =
            a • (((b i : classFunctionSubmodule ℂ H) : H → ℂ)) := by
        ext h
        simp [hcoeff]
      rw [hterm]
      exact (characterRingScalarExtension ℤ H).smul_mem a hbase
    have hsum_coe :
        (∑ i, ((((b.repr x i) • b i : classFunctionSubmodule ℂ H) : H → ℂ))) =
          ((((∑ i, ((b.repr x i) • b i : classFunctionSubmodule ℂ H)) :
              classFunctionSubmodule ℂ H) : H → ℂ)) := by
      ext h
      let eval_h : classFunctionSubmodule ℂ H →ₗ[ℂ] ℂ :=
        { toFun := fun z ↦ z h
          map_add' := by
            intro y z
            rfl
          map_smul' := by
            intro a z
            rfl }
      simpa using
        (_root_.map_sum eval_h
          (fun j ↦ ((b.repr x j) • b j : classFunctionSubmodule ℂ H)) Finset.univ).symm
    -- Evaluate the basis expansion pointwise after proving each term lies in the scalar extension.
    exact hsum_coe.symm ▸ hsum_fun
  have hx :
      ((((∑ i, ((b.repr x i) • b i : classFunctionSubmodule ℂ H)) :
          classFunctionSubmodule ℂ H) : H → ℂ)) = (x : H → ℂ) := by
    exact congrArg (fun z : classFunctionSubmodule ℂ H ↦ (z : H → ℂ)) (b.sum_repr x)
  simpa [x] using hx ▸ hsum

/-- Helper for Corollary 11-11.1-5: once every elementary restriction lies in the realized
integral character span, Brauer's induction argument forces the ambient class function to do so
as well. -/
private theorem classFunction_mem_characterRingScalarExtension_of_restrict_mem_on_elementarySubgroups_corollary
    (φ : classFunctionSubmodule ℂ G)
    (hres : ∀ H : Subgroup G, IsElementary H →
      (fun h : H ↦ (φ : G → ℂ) h) ∈ characterRingScalarExtension ℤ H) :
    (φ : G → ℂ) ∈ characterRingScalarExtension ℤ G := by
  have hone' :
      (1 : R(G)) ∈ (⨆ p : Nat.Primes, pElementaryInducedCharacterSpan_local (G := G) (p : ℕ)) := by
    -- Rewrite the theorem-local Brauer spans back to the Chapter 10 owners.
    simpa [pElementaryInducedCharacterSpan_local, Representation.pElementaryInducedCharacterSpan,
      artinInducedCharacterSubmodule_local, Representation.artinInducedCharacterSubmodule,
      Subgroup.characterRingInduction_local, Representation.Subgroup.characterRingInduction] using
      (character_mem_iSup_pElementaryInducedCharacterSpan (G := G) (1 : R(G)))
  have hone :
      ((1 : R(G)) : G → ℂ) * (φ : G → ℂ) ∈ characterRingScalarExtension ℤ G := by
    -- Once the unit character lies in Brauer's supremum, `iSup`-induction reduces to one prime.
    refine Submodule.iSup_induction
        (p := fun p : Nat.Primes ↦ pElementaryInducedCharacterSpan_local (G := G) (p : ℕ))
        (motive := fun χ : R(G) ↦
          ((χ : G → ℂ) * (φ : G → ℂ)) ∈ characterRingScalarExtension ℤ G)
        hone' ?_ ?_ ?_
    · intro p χ hχ
      exact
        pElementaryInducedCharacterSpan_mul_classFunction_mem_characterRingScalarExtension_local
          (A := ℤ) φ hres p hχ
    · simpa using zero_mem (characterRingScalarExtension ℤ G)
    · intro χ ψ hχ hψ
      simpa [add_mul] using (characterRingScalarExtension ℤ G).add_mem hχ hψ
  -- The unit character acts trivially, so the `V[p]`-induction output is already `φ`.
  simpa [one_character_mul_classFunction φ] using hone

omit [Finite G] in
/-- Helper for Corollary 11-11.1-5: the realized scalar extension over `ℤ` is the original
integral character ring. -/
lemma characterRingScalarExtension_int_eq_characterRingSubmodule :
    characterRingScalarExtension ℤ G = (R(G)).toSubmodule := by
  -- Over `ℤ`, the realized scalar-extension span is exactly the integral character ring.
  rw [characterRingScalarExtension]
  exact Submodule.span_eq ((R(G)).toSubmodule : Submodule ℤ (G → ℂ))

/-- Corollary 11-11.1-5: for a complex-valued class function `φ` on `G`, `φ` is a virtual
character if and only if, for every elementary subgroup `H ≤ G` and every degree-one complex
character `χ : H →* ℂˣ`, the pairing of `χ` with the restriction of `φ` to `H` is an integer. -/
theorem mem_characterRing_iff_linearCharacter_pairing_restrict_isInteger_on_elementarySubgroups
    (φ : G → ℂ) (hφ : IsClassFunction φ) :
    φ ∈ R(G) ↔
      ∀ (H : Subgroup G) (_hH : IsElementary H) (χ : H →* ℂˣ),
        IsLocalization.IsInteger ℤ
          ⟪χ.toCharacterRing, fun h : H ↦ φ h⟫ := by
  constructor
  · intro hφR H _hH χ
    let φH : R(H) := ⟨fun h : H ↦ φ h, restrict_mem_characterRing H hφR⟩
    -- Restrict the global virtual character to `H` before applying the local pairing lemma.
    have hpair :
        ⟪χ.toCharacterRing, (φH : H → ℂ)⟫ ∈ Set.range (algebraMap ℤ ℂ) :=
      pairing_mem_range_int_of_mem_characterRing_with_linear_character φH χ
    simpa [isInteger_iff_mem_range_int_cast, φH] using hpair
  · intro hpair
    have hφ_root : _root_.IsClassFunction φ := by
      -- Convert the representation-theoretic class-function structure into the bundled one.
      refine ⟨?_⟩
      intro x y hxy
      exact hφ.factorsThrough hxy
    let φCF : classFunctionSubmodule ℂ G :=
      ⟨φ, (mem_classFunctionSubmodule_iff ℂ φ).2 hφ_root⟩
    have hpair_range :
        ∀ (H : Subgroup G) (_hH : IsElementary H) (χ : H →* ℂˣ),
          ⟪χ.toCharacterRing, Subgroup.classFunctionRestriction H φCF⟫ ∈
            Set.range (algebraMap ℤ ℂ) := by
      intro H hH χ
      -- Repackage the integrality assumption in the range form used by the elementary restriction
      -- criterion.
      simpa [isInteger_iff_mem_range_int_cast, φCF] using hpair H hH χ
    have hmem_scalar : (φCF : G → ℂ) ∈ characterRingScalarExtension ℤ G := by
      have hres :
          ∀ H : Subgroup G, IsElementary H →
            (H.classFunctionRestriction φCF : H → ℂ) ∈ characterRingScalarExtension ℤ H := by
        intro H hH
        -- Route correction: first build scalar-extension membership on each elementary subgroup,
        -- then apply the already-built Brauer descent theorem `11-11.1-1`.
        exact
          elementary_restriction_mem_characterRingScalarExtension_of_pairing_mem_range_corollary
            φCF hpair_range H hH
      exact
        classFunction_mem_characterRingScalarExtension_of_restrict_mem_on_elementarySubgroups_corollary
          φCF (fun H hH ↦ by simpa using hres H hH)
    have hmem : (φCF : G → ℂ) ∈ R(G) := by
      -- Over `ℤ`, scalar-extension membership is literal character-ring membership.
      rw [characterRingScalarExtension_int_eq_characterRingSubmodule] at hmem_scalar
      exact hmem_scalar
    simpa [φCF] using hmem

end CharacterizationOfCharacters

end Representation
