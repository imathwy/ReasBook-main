/-! ### Theorem_12_12_4_1 (from Chap12) -/
noncomputable section

open scoped Representation

universe u v w

namespace Representation

open IsCyclotomicExtension.Rat
open CategoryTheory

section RankOfRepresentationRing

variable (G : Type u) [Group G] [Finite G]
variable {L : Type v} [Field L] [NumberField L]
variable [IsCyclotomicExtension {Monoid.exponent G} ℚ L]

local instance : Fintype G := Fintype.ofFinite G
local instance : NeZero (Monoid.exponent G) := Monoid.neZero_exponent_of_finite

/-- Helper for Theorem 12-12.4-1: the natural-number representatives of exponent units multiply
modulo `Monoid.exponent G` in the expected way. -/
private theorem galoisPowerExponentUnit_mul_modEq
    (t u : (ZMod (Monoid.exponent G))ˣ) :
    galoisPowerExponentUnit (t * u) ≡
      galoisPowerExponentUnit t * galoisPowerExponentUnit u [MOD Monoid.exponent G] := by
  -- Rewrite the congruence in `ZMod` and unfold the chosen representatives.
  rw [← ZMod.natCast_eq_natCast_iff]
  simp [galoisPowerExponentUnit, Nat.cast_mul]

/-- Helper for Theorem 12-12.4-1: the cyclotomic hypothesis supplies enough roots of unity in `L`
for the exponent of `G`. -/
private instance cyclotomic_hasEnoughRootsOfUnity :
    HasEnoughRootsOfUnity L (Monoid.exponent G) where
  prim := by
    -- Extract a primitive `exp(G)`-th root from the defining cyclotomic-extension data.
    simpa using
      (IsCyclotomicExtension.exists_isPrimitiveRoot
        (S := {Monoid.exponent G}) (A := ℚ) (B := L)
        (n := Monoid.exponent G) (by simp)
        (show Monoid.exponent G ≠ 0 by exact NeZero.ne _))
  cyc := rootsOfUnity.isCyclic _ _

/-- Helper for Theorem 12-12.4-1: restricting a virtual `L`-character to a subgroup again lands in
the corresponding subgroup character ring. -/
private theorem restrict_mem_characterRingOverField_local
    (H : Subgroup G) (χ : R[L](G)) :
    (fun h : H ↦ (χ : G → L) h) ∈ R[L](H) := by
  -- Restrict the adjoin presentation of `χ` term-by-term along the subgroup inclusion.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ χ.property
  · intro ψ hψ
    rcases hψ with ⟨ρ, hρfd, -, rfl⟩
    letI : FiniteDimensional L ρ := hρfd
    change (Rep.res H.subtype ρ).ρ.character ∈ R[L](H)
    letI : FiniteDimensional L (Rep.res H.subtype ρ) := inferInstance
    exact Representation.rep_character_mem_characterRingOverField (Rep.res H.subtype ρ)
  · intro n
    exact (R[L](H)).algebraMap_mem n
  · intro f g _ _ hf hg
    simpa using (R[L](H)).add_mem hf hg
  · intro f g _ _ hf hg
    simpa using (R[L](H)).mul_mem hf hg

/-- Helper for Theorem 12-12.4-1: an irreducible representation has a nontrivial carrier. -/
private theorem irreducible_representation_nontrivial_local
    {H : Type*} [Group H] {F : Type*} [Field F]
    {V : Type*} [AddCommGroup V] [Module F V]
    (ρ : Representation F H V) [ρ.IsIrreducible] :
    Nontrivial V := by
  by_contra hV
  letI : Subsingleton V := not_nontrivial_iff_subsingleton.mp hV
  have hbot_top : (⊥ : Subrepresentation ρ) = ⊤ := by
    apply Subrepresentation.toSubmodule_injective
    ext v
    constructor
    · intro _
      trivial
    · intro _
      simpa using (Subsingleton.elim v 0)
  exact IsSimpleOrder.bot_ne_top hbot_top

/-- Helper for Theorem 12-12.4-1: on the cyclic subgroup generated by `x`, every ordinary
`L`-valued character is compatible with the ambient `Γ[K](G)` power action at the distinguished
generator. -/
private theorem zpowers_restricted_character_galois_compatible
    (K : IntermediateField ℚ L)
    (x : G) (ψ : R[L](Subgroup.zpowers x)) (t : Γ[K](G)) :
    let g0 : Subgroup.zpowers x := ⟨x, Subgroup.mem_zpowers x⟩
    t • ψ g0 =
      ψ (g0 ^
        galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) := by
  let C : Subgroup G := Subgroup.zpowers x
  let g0 : C := ⟨x, Subgroup.mem_zpowers x⟩
  let n : ℕ := galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)
  change t • ψ g0 = ψ (g0 ^ n)
  -- Route correction: prove the identity on irreducible character generators of `R[L](C)` by
  -- showing that the generator acts as a scalar root of unity.
  refine Algebra.adjoin_induction (p := fun φ _ ↦ t • φ g0 = φ (g0 ^ n)) ?_ ?_ ?_ ?_ ψ.property
  · intro φ hφ
    rcases hφ with ⟨ρ, hρfd, hρirr, rfl⟩
    letI : FiniteDimensional L ρ := hρfd
    letI : ρ.ρ.IsIrreducible := hρirr
    letI : Nontrivial ρ := irreducible_representation_nontrivial_local ρ.ρ
    haveI : Nontrivial (ρ →ₗ[L] ρ) := inferInstance
    letI : IsMulCommutative C := Subgroup.zpowers_isMulCommutative x
    have horder_div_exp : orderOf g0 ∣ Monoid.exponent G := by
      simpa [Subgroup.orderOf_coe] using Monoid.order_dvd_exponent (g0 : G)
    haveI : HasEnoughRootsOfUnity L (orderOf g0) := by
      exact HasEnoughRootsOfUnity.of_dvd L horder_div_exp
    let f : Module.End L ρ := ρ.ρ g0
    have h_ann :
        Polynomial.aeval f (Polynomial.X ^ orderOf g0 - 1 : Polynomial L) = 0 := by
      have hpow : f ^ orderOf g0 = 1 := by
        change ρ.ρ g0 ^ orderOf g0 = 1
        simpa [f, pow_orderOf_eq_one] using (ρ.ρ.map_pow g0 (orderOf g0)).symm
      simp [hpow, f]
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L (orderOf g0)
    have hsplit :
        (Polynomial.X ^ orderOf g0 - 1 : Polynomial L).Splits := by
      simpa using Polynomial.X_pow_sub_one_splits hζ
    have hsplit_min :
        (minpoly L f).Splits := by
      apply Polynomial.Splits.of_dvd hsplit
      · simpa using Polynomial.X_pow_sub_C_ne_zero
          (show 0 < orderOf g0 by exact orderOf_pos g0) (1 : L)
      · rw [minpoly.dvd_iff]
        exact h_ann
    have hμdeg : (minpoly L f).degree ≠ 0 := by
      exact ne_of_gt (minpoly.degree_pos (LinearMap.isIntegral f))
    let μ : L := Polynomial.rootOfSplits hsplit_min hμdeg
    have hμroot : (minpoly L f).IsRoot μ := by
      exact Polynomial.eval_rootOfSplits hsplit_min hμdeg
    have hμeig : Module.End.HasEigenvalue f μ := Module.End.hasEigenvalue_of_isRoot hμroot
    let E : Subrepresentation ρ.ρ :=
      { toSubmodule := Module.End.eigenspace f μ
        apply_mem_toSubmodule := by
          intro h v hv
          rw [Module.End.mem_eigenspace_iff] at hv ⊢
          have hcomm : Commute f (ρ.ρ h) := by
            change ρ.ρ g0 * ρ.ρ h = ρ.ρ h * ρ.ρ g0
            calc
              ρ.ρ g0 * ρ.ρ h = ρ.ρ (g0 * h) := by
                simpa using (ρ.ρ.map_mul g0 h).symm
              _ = ρ.ρ (h * g0) := by
                congr 1
                exact mul_comm' g0 h
              _ = ρ.ρ h * ρ.ρ g0 := by
                simpa using (ρ.ρ.map_mul h g0)
          have hcomm_apply : f ((ρ.ρ h) v) = (ρ.ρ h) (f v) := by
            simpa using LinearMap.congr_fun hcomm.eq v
          calc
            f ((ρ.ρ h) v) = (ρ.ρ h) (f v) := hcomm_apply
            _ = (ρ.ρ h) (μ • v) := by rw [hv]
            _ = μ • (ρ.ρ h v) := by simp }
    have hE_ne : E ≠ ⊥ := by
      intro hE
      exact (Module.End.hasEigenvalue_iff.mp hμeig) <| by
        simpa [E] using congrArg Subrepresentation.toSubmodule hE
    have hE_top : E = ⊤ := by
      exact (IsSimpleOrder.bot_lt_iff_eq_top).1 (bot_lt_iff_ne_bot.mpr hE_ne)
    have hf_scalar : f = μ • (1 : ρ →ₗ[L] ρ) := by
      ext v
      have hv : v ∈ E := by
        rw [hE_top]
        exact Submodule.mem_top
      exact Module.End.mem_eigenspace_iff.mp hv
    have hμpow : μ ^ orderOf g0 = 1 := by
      have hroot_pow :
          (Polynomial.X ^ orderOf g0 - 1 : Polynomial L).IsRoot μ :=
        hμroot.dvd (by rw [minpoly.dvd_iff]; exact h_ann)
      simpa [Polynomial.IsRoot, sub_eq_zero] using hroot_pow
    have hμcompat : t • μ = μ ^ n := by
      let σ : Gal(L / ℚ) :=
        (galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ)
      have hσunit :
          galEquivZMod (Monoid.exponent G) L σ = (t : (ZMod (Monoid.exponent G))ˣ) := by
        exact MulEquiv.apply_symm_apply (galEquivZMod (Monoid.exponent G) L) _
      change σ μ = μ ^ n
      have hμexp : μ ^ Monoid.exponent G = 1 := by
        rcases horder_div_exp with ⟨k, hk⟩
        calc
          μ ^ Monoid.exponent G = μ ^ (orderOf g0 * k) := by simpa [hk]
          _ = (μ ^ orderOf g0) ^ k := by rw [pow_mul]
          _ = 1 := by simp [hμpow]
      calc
        σ μ =
            μ ^ ((galEquivZMod (Monoid.exponent G) L σ).val.val) := by
              simpa using
                (galEquivZMod_apply_of_pow_eq
                  (n := Monoid.exponent G) (K := L) σ hμexp)
        _ = μ ^ n := by
          simp [hσunit, n, galoisPowerExponentUnit]
    have hchar_g0 :
        ρ.ρ.character g0 = μ * (Module.finrank L ρ : L) := by
      change LinearMap.trace L ρ f = μ * (Module.finrank L ρ : L)
      rw [hf_scalar]
      simp [LinearMap.trace_id, mul_comm]
    have hlsmul_pow (a : L) (m : ℕ) :
        (a • (1 : ρ →ₗ[L] ρ)) ^ m = a ^ m • (1 : ρ →ₗ[L] ρ) := by
      induction m with
      | zero =>
          ext v
          simp
      | succ m ihm =>
          rw [pow_succ, ihm]
          ext v
          simp [pow_succ, smul_smul, mul_assoc, mul_left_comm, mul_comm]
    have hf_pow_scalar : ρ.ρ (g0 ^ n) = μ ^ n • (1 : ρ →ₗ[L] ρ) := by
      calc
        ρ.ρ (g0 ^ n) = (ρ.ρ g0) ^ n := by simpa using (ρ.ρ.map_pow g0 n).symm
        _ = f ^ n := rfl
        _ = (μ • (1 : ρ →ₗ[L] ρ)) ^ n := by rw [hf_scalar]
        _ = μ ^ n • (1 : ρ →ₗ[L] ρ) := hlsmul_pow μ n
    have hchar_pow :
        ρ.ρ.character (g0 ^ n) = μ ^ n * (Module.finrank L ρ : L) := by
      rw [Representation.character, hf_pow_scalar]
      simp [LinearMap.trace_id, mul_comm]
    have hfinrank_fixed :
        t • (Module.finrank L ρ : L) = (Module.finrank L ρ : L) := by
      show
        (galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ)
            (Module.finrank L ρ : L) =
          (Module.finrank L ρ : L)
      simpa using
        AlgEquiv.commutes
          ((galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ))
          (Module.finrank L ρ : ℚ)
    -- The generator acts by a scalar root of unity, so the cyclotomic action transports its trace
    -- to the trace at the corresponding power.
    calc
      t • ρ.ρ.character g0 = t • (μ * (Module.finrank L ρ : L)) := by rw [hchar_g0]
      _ = (t • μ) * (t • (Module.finrank L ρ : L)) := by rw [smul_mul']
      _ = μ ^ n * (Module.finrank L ρ : L) := by rw [hμcompat, hfinrank_fixed]
      _ = ρ.ρ.character (g0 ^ n) := hchar_pow.symm
  · intro m
    -- Integer constants are fixed by the cyclotomic action.
    show
      (galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ) (m : L) =
        (m : L)
    simpa using
      AlgEquiv.commutes
        ((galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ))
        (m : ℚ)
  · intro φ ψ _ _ hφ hψ
    -- Compatibility is preserved by addition.
    calc
      t • (φ + ψ) g0 = t • (φ g0 + ψ g0) := by rfl
      _ = t • φ g0 + t • ψ g0 := by rw [smul_add]
      _ = φ (g0 ^ n) + ψ (g0 ^ n) := by rw [hφ, hψ]
      _ = (φ + ψ) (g0 ^ n) := by rfl
  · intro φ ψ _ _ hφ hψ
    -- Compatibility is also preserved by multiplication in the character ring.
    calc
      t • (φ * ψ) g0 = t • (φ g0 * ψ g0) := by rfl
      _ = t • φ g0 * (t • ψ g0) := by rw [smul_mul']
      _ = φ (g0 ^ n) * ψ (g0 ^ n) := by rw [hφ, hψ]
      _ = (φ * ψ) (g0 ^ n) := by rfl

/-- Helper for Theorem 12-12.4-1: every element of `R[L](G)` is compatible with the ambient
`Γ[K](G)` power action. -/
private theorem character_galois_compatible_of_mem_characterRingOverField
    (K : IntermediateField ℚ L) (χ : R[L](G)) :
    ∀ s (t : Γ[K](G)), t • (χ : G → L) s = (χ : G → L) (s ^ t) := by
  intro s t
  let C : Subgroup G := Subgroup.zpowers s
  let χC : R[L](C) := ⟨fun h : C ↦ (χ : G → L) h,
    restrict_mem_characterRingOverField_local (G := G) C χ⟩
  -- Restrict to the cyclic subgroup generated by `s` and evaluate at its generator.
  simpa [χC, C, pow_subgroup_eq_pow_nat] using
    (zpowers_restricted_character_galois_compatible (G := G) (K := K) s χC t)

/-- Helper for Theorem 12-12.4-1: values coming from the intermediate field `K` are fixed by
LinearRepresentations_Serre_1977's subgroup `Γ[K](G)` under the cyclotomic Galois action on `L`. -/
theorem gammaSubgroup_smul_algebraMap
    (K : IntermediateField ℚ L) (a : K) (t : Γ[K](G)) :
    t • algebraMap K L a = algebraMap K L a := by
  -- Rewrite the `Γ[K](G)`-action on `L` through the corresponding Galois automorphism of `L / ℚ`.
  change ((galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ))
      (algebraMap K L a) = algebraMap K L a
  have ht :
      ((galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ)) ∈
        K.fixingSubgroup := by
    exact Subgroup.mem_map_equiv.mp t.2
  -- Elements of `K` are fixed by every element of the fixing subgroup by definition.
  exact (IntermediateField.mem_fixingSubgroup_iff K _).1 ht _ a.2

/-- Helper for Theorem 12-12.4-1: if an `L`-scalar is fixed by every element of `Γ[K](G)`, then
it already belongs to the intermediate field `K`. -/
theorem mem_intermediateField_of_gammaSubgroup_fixed
    (K : IntermediateField ℚ L) (x : L)
    (hx : ∀ t : Γ[K](G), t • x = x) :
    x ∈ K := by
  letI : IsGalois ℚ L := IsCyclotomicExtension.isGalois (S := {Monoid.exponent G}) ℚ L
  have hx_fixed : x ∈ IntermediateField.fixedField K.fixingSubgroup := by
    -- Translate the `Γ[K](G)`-fixedness hypothesis back across `galEquivZMod`.
    rw [IntermediateField.mem_fixedField_iff]
    intro σ hσ
    rw [IntermediateField.mem_fixingSubgroup_iff] at hσ
    have hσ_fix :
        (galEquivZMod (Monoid.exponent G) L).symm
            (galEquivZMod (Monoid.exponent G) L σ) ∈
          K.fixingSubgroup := by
      -- Route correction: rewrite the transported automorphism pointwise before re-entering the
      -- fixing subgroup.
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro y hy
      convert hσ y hy using 1
      exact congrArg (fun f : L ≃ₐ[ℚ] L => f y)
        (MulEquiv.symm_apply_apply (galEquivZMod (Monoid.exponent G) L) σ)
    have ht_mem : galEquivZMod (Monoid.exponent G) L σ ∈ Γ[K](G) := by
      exact
        (Subgroup.mem_map_equiv.mpr hσ_fix :
          galEquivZMod (Monoid.exponent G) L σ ∈ Γ[K](G))
    let t : Γ[K](G) := ⟨galEquivZMod (Monoid.exponent G) L σ, ht_mem⟩
    have ht_fixed : t • x = x := hx t
    have ht_eq :
        (galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ) = σ := by
      simpa [t] using
        (MulEquiv.symm_apply_apply (galEquivZMod (Monoid.exponent G) L) σ)
    change
      (galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ) x = x at ht_fixed
    simpa [ht_eq] using ht_fixed
  -- The fixed-field theorem identifies the fixed scalars of the fixing subgroup with `K`.
  rw [IsGalois.fixedField_fixingSubgroup (F := ℚ) (E := L) K] at hx_fixed
  exact hx_fixed

/-- Helper for Theorem 12-12.4-1: the character of a finite-dimensional `L`-representation is
itself compatible with LinearRepresentations_Serre_1977's `Γ[K](G)`-action. -/
private theorem conjRepresentation_map_one_local
    {V : Type*} {W : Type*} [AddCommGroup V] [Module L V] [AddCommGroup W] [Module L W]
    (e : V ≃ₗ[L] W) (ρ : Representation L G V) :
    e.conj (ρ 1) = 1 := by
  -- Replace `ρ 1` by the identity map, then use the standard conjugation identity.
  calc
    e.conj (ρ 1) = e.conj 1 := by rw [map_one]
    _ = 1 := LinearEquiv.conj_id e

/-- Helper for Theorem 12-12.4-1: conjugating a representation through a linear equivalence
preserves the multiplication law. -/
private theorem conjRepresentation_map_mul_local
    {V : Type*} {W : Type*} [AddCommGroup V] [Module L V] [AddCommGroup W] [Module L W]
    (e : V ≃ₗ[L] W) (ρ : Representation L G V) (g h : G) :
    e.conj (ρ (g * h)) = e.conj (ρ g) * e.conj (ρ h) := by
  -- Conjugation transports composition, so the representation law is unchanged.
  rw [map_mul]
  ext x
  simp [LinearEquiv.conj_apply_apply]

/-- Helper for Theorem 12-12.4-1: move a finite-dimensional `L`-representation to the ambient
carrier universe through a chosen finite basis. -/
private def finBasisRepresentation_local
    {V : Type*} [AddCommGroup V] [Module L V] [FiniteDimensional L V]
    (ρ : Representation L G V) : Representation L G (Fin (Module.finrank L V) → L) :=
  let e := (Module.finBasis L V).equivFun
  { toFun := fun g ↦ e.conj (ρ g)
    map_one' := by
      exact conjRepresentation_map_one_local (G := G) (L := L) e ρ
    map_mul' := by
      intro g h
      exact conjRepresentation_map_mul_local (G := G) (L := L) e ρ g h }

/-- Helper for Theorem 12-12.4-1: transporting a representation through a finite basis does not
change its character. -/
private theorem character_finBasisRepresentation_eq_local
    {V : Type*} [AddCommGroup V] [Module L V] [FiniteDimensional L V]
    (ρ : Representation L G V) (g : G) :
    (finBasisRepresentation_local (G := G) (L := L) ρ).character g = ρ.character g := by
  -- Conjugation preserves trace, so the coordinate model has the same character values.
  simpa [finBasisRepresentation_local, Representation.character] using
    (LinearMap.trace_conj' (ρ g) ((Module.finBasis L V).equivFun))

/-- Helper for Theorem 12-12.4-1: a representation may be moved to the target carrier universe by
`ULift` without changing its action. -/
private def uliftRepresentation_local
    {V : Type*} [AddCommGroup V] [Module L V]
    (ρ : Representation L G V) : Representation L G (ULift.{u} V) where
  toFun g :=
    { toFun := fun x ↦ ⟨ρ g x.down⟩
      map_add' := by
        intro x y
        ext
        simp
      map_smul' := by
        intro a x
        ext
        simp }
  map_one' := by
    ext x
    simp
  map_mul' g h := by
    ext x
    simp [map_mul]

/-- Helper for Theorem 12-12.4-1: `ULift` preserves character values. -/
private theorem character_uliftRepresentation_eq_local
    {V : Type*} [AddCommGroup V] [Module L V]
    (ρ : Representation L G V) (g : G) :
    (uliftRepresentation_local (G := G) (L := L) ρ).character g = ρ.character g := by
  -- The canonical linear equivalence `V ≃ ULift V` conjugates the lifted action back to the
  -- original operator.
  change
    LinearMap.trace L (ULift.{u} V)
        ((ULift.moduleEquiv.symm : V ≃ₗ[L] ULift.{u} V).conj (ρ g)) =
      LinearMap.trace L V (ρ g)
  exact LinearMap.trace_conj' (ρ g) (ULift.moduleEquiv.symm : V ≃ₗ[L] ULift.{u} V)

/-- Helper for Theorem 12-12.4-1: any finite-dimensional `L`-representation contributes an honest
element of `R[L](G)`, independently of the carrier universe. -/
private theorem rep_character_mem_characterRingOverField_universe_local
    {V : Type*} [AddCommGroup V] [Module L V] [FiniteDimensional L V]
    (ρ : Representation L G V) :
    ρ.character ∈ R[L](G) := by
  let ρfin := finBasisRepresentation_local (G := G) (L := L) ρ
  let τρ : Representation L G (ULift.{u} (Fin (Module.finrank L V) → L)) :=
    uliftRepresentation_local (G := G) (L := L) ρfin
  let τ := Rep.of τρ
  have hchar : ρ.character = τ.ρ.character := by
    -- Move first to a coordinate model, then lift that carrier into the ambient universe.
    ext g
    calc
      ρ.character g = ρfin.character g := by
        symm
        simpa [ρfin] using character_finBasisRepresentation_eq_local (G := G) (L := L) ρ g
      _ = τ.ρ.character g := by
        simpa [τ, τρ] using
          (character_uliftRepresentation_eq_local (G := G) (L := L) ρfin g).symm
  -- Once the carrier is in the ambient universe, the Chapter 12 owner theorem applies directly.
  exact hchar ▸ Representation.rep_character_mem_characterRingOverField (K := L) (G := G) τ

/-- Helper for Theorem 12-12.4-1: the character of a finite-dimensional `L`-representation is
itself compatible with LinearRepresentations_Serre_1977's `Γ[K](G)`-action. -/
private theorem representation_character_galois_compatible
    (K : IntermediateField ℚ L)
    {V : Type u} [AddCommGroup V] [Module L V]
    (ρ : Representation L G V) [FiniteDimensional L V] :
    ∀ s (t : Γ[K](G)), t • ρ.character s = ρ.character (s ^ t) := by
  -- View the character as an honest element of `R[L](G)` and reuse the ring-level compatibility.
  exact
    character_galois_compatible_of_mem_characterRingOverField (G := G) (K := K)
      ⟨ρ.character, by
        exact rep_character_mem_characterRingOverField_universe_local (G := G) (L := L) ρ⟩

/-- Helper for Theorem 12-12.4-1: any finite-dimensional representation over any field defines an
honest character-ring element after moving the carrier into the ambient universe. -/
private theorem rep_character_mem_characterRingOverField_universe_generic_local
    {H : Type u} [Group H]
    {K' : Type v} [Field K']
    {V : Type w} [AddCommGroup V] [Module K' V] [FiniteDimensional K' V]
    (ρ : Representation K' H V) :
    ρ.character ∈ R[K'](H) := by
  let e := (Module.finBasis K' V).equivFun
  let ρfin : Representation K' H (Fin (Module.finrank K' V) → K') :=
    { toFun := fun h ↦ e.conj (ρ h)
      map_one' := by
        -- The coordinate-model action preserves the identity operator.
        calc
          e.conj (ρ 1) = e.conj 1 := by rw [map_one]
          _ = 1 := LinearEquiv.conj_id e
      map_mul' := by
        intro g h
        -- Conjugation transports the representation law unchanged.
        rw [map_mul]
        ext x
        simp [LinearEquiv.conj_apply_apply] }
  let τρ : Representation K' H (ULift.{max u v} (Fin (Module.finrank K' V) → K')) :=
    { toFun := fun h ↦
        { toFun := fun x ↦ ⟨ρfin h x.down⟩
          map_add' := by
            intro x y
            ext
            simp
          map_smul' := by
            intro a x
            ext
            simp }
      map_one' := by
        ext x
        simp
      map_mul' := by
        intro g h
        ext x
        simp [map_mul] }
  let τ : Rep K' H := Rep.of τρ
  have hfin : ρ.character = ρfin.character := by
    -- Conjugation preserves trace, so the coordinate-model character matches the original one.
    ext h
    symm
    simpa [ρfin, Representation.character] using
      (LinearMap.trace_conj' (ρ h) e)
  have hulift : τ.ρ.character = ρfin.character := by
    -- `ULift` does not change trace values.
    ext h
    change
      LinearMap.trace K' (ULift.{max u v} (Fin (Module.finrank K' V) → K'))
          ((ULift.moduleEquiv.symm : (Fin (Module.finrank K' V) → K') ≃ₗ[K']
            ULift.{max u v} (Fin (Module.finrank K' V) → K')).conj (ρfin h)) =
        LinearMap.trace K' (Fin (Module.finrank K' V) → K') (ρfin h)
    simpa [τ, τρ] using
      (LinearMap.trace_conj' (ρfin h)
        (ULift.moduleEquiv.symm : (Fin (Module.finrank K' V) → K') ≃ₗ[K']
          ULift.{max u v} (Fin (Module.finrank K' V) → K')))
  have hchar : ρ.character = τ.ρ.character := by
    exact hfin.trans hulift.symm
  -- Once the carrier sits in the ambient universe, the standard owner theorem applies directly.
  exact hchar ▸
    Representation.rep_character_mem_characterRingOverField (K := K') (G := H) τ

/-- Helper for Theorem 12-12.4-1: precomposing a virtual character with a multiplicative
equivalence preserves membership in the corresponding character ring. -/
private theorem mem_characterRingOverField_of_precomp_mulEquiv_local
    {K' : Type*} [Field K']
    {H : Type*} [Group H] [Finite H]
    (e : H ≃* G) {χ : G → K'} (hχ : χ ∈ R[K'](G)) :
    (fun h : H ↦ χ (e h)) ∈ R[K'](H) := by
  -- Transport each honest character generator through the multiplicative equivalence `e`.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hχ
  · intro ψ hψ
    rcases hψ with ⟨ρ, hρfd, -, rfl⟩
    letI : FiniteDimensional K' ρ := hρfd
    let τρ : Representation K' H ρ := ρ.ρ.comp e.toMonoidHom
    have hτ :
        τρ.character = fun h : H ↦ ρ.ρ.character (e h) := by
      -- Character transport across precomposition is pointwise definitional.
      ext h
      rfl
    exact hτ ▸
      rep_character_mem_characterRingOverField_universe_generic_local
        (H := H) (K' := K') (ρ := τρ)
  · intro n
    exact (R[K'](H)).algebraMap_mem n
  · intro f g _ _ hf hg
    simpa using (R[K'](H)).add_mem hf hg
  · intro f g _ _ hf hg
    simpa using (R[K'](H)).mul_mem hf hg

/-- Helper for Theorem 12-12.4-1: every ordinary complex character admits an `L`-valued lift
because `L` contains the roots of unity needed to realize complex representations of `G`. -/
private theorem ordinary_character_lift_to_characterRingOverField_local
    [Algebra L ℂ] [IsScalarTower ℚ L ℂ] (χ : R[ℂ](G)) :
    ∃ χL : R[L](G), ∀ g : G, algebraMap L ℂ (χL g) = χ g := by
  let G₀ : Type := Shrink.{0} G
  let e : G₀ ≃* G := Shrink.mulEquiv
  have hχ₀ : (fun x : G₀ ↦ χ (e x)) ∈ R[ℂ](G₀) := by
    -- Move the complex character to the small equivalent group so the Chapter 12 owner theorem
    -- applies without universe mismatch.
    exact mem_characterRingOverField_of_precomp_mulEquiv_local
      (G := G) (K' := ℂ) e χ.property
  have hroots₀ : HasEnoughRootsOfUnity L (Monoid.exponent G₀) := by
    -- The exponent is invariant under multiplicative equivalence, so the same roots of unity work.
    simpa [G₀, Monoid.exponent_eq_of_mulEquiv e] using
      (cyclotomic_hasEnoughRootsOfUnity (G := G) (L := L))
  have hχ₀_ext :
      (fun x : G₀ ↦ χ (e x)) ∈ characterRingOverFieldInExtension L ℂ G₀ := by
    rw [Representation.characterRingOverFieldInExtension_eq_characterRing_of_hasEnoughRootsOfUnity
      (K := L) (G := G₀)]
    exact hχ₀
  rcases Subalgebra.mem_map.mp hχ₀_ext with ⟨χL₀, hχL₀, hχL₀_map⟩
  have hχL : (fun g : G ↦ χL₀ (e.symm g)) ∈ R[L](G) := by
    -- Pull the descended `L`-valued witness back along the inverse equivalence.
    exact mem_characterRingOverField_of_precomp_mulEquiv_local
      (G := G₀) (K' := L) e.symm hχL₀
  refine ⟨⟨fun g : G ↦ χL₀ (e.symm g), hχL⟩, ?_⟩
  intro g
  -- Evaluate the small-group witness at the inverse image of `g`.
  simpa [e] using congrFun hχL₀_map (e.symm g)

/-- Helper for Theorem 12-12.4-1: coefficientwise extension from `L` to `ℂ` commutes with the
normalized class-function pairing. -/
private theorem groupFunctionPairingOverField_algebraMap_local
    [Algebra L ℂ]
    {J : Type*} [Group J] [Finite J] (φ ψ : J → L) :
    Representation.groupFunctionPairingOverField ℂ
        (fun s : J ↦ algebraMap L ℂ (φ s))
        (fun s : J ↦ algebraMap L ℂ (ψ s)) =
      algebraMap L ℂ (Representation.groupFunctionPairingOverField L φ ψ) := by
  have hcard : (Nat.card J : L) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr (Nat.ne_of_gt Nat.card_pos)
  -- Expand both normalized pairings and push the algebra map through the finite average.
  rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
  rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
  simp [map_sum, map_mul, hcard]

/-- Helper for Theorem 12-12.4-1: coefficientwise complexification preserves the class-function
property. -/
private theorem complexified_classFunction_mem_local
    [Algebra L ℂ] {H : Type*} [Group H] (φ : classFunctionSubmodule L H) :
    (fun h : H ↦ algebraMap L ℂ (φ h)) ∈ classFunctionSubmodule ℂ H := by
  -- Postcomposing with the chosen embedding `L → ℂ` preserves conjugacy invariance.
  simpa using (φ.2.comp (algebraMap L ℂ))

/-- Helper for Theorem 12-12.4-1: normalized class-function pairing is unchanged after
precomposition with a multiplicative equivalence. -/
private theorem groupFunctionPairingOverField_precomp_mulEquiv_local
    {H : Type*} [Group H] [Finite H] (e : H ≃* G) (φ ψ : G → ℂ) :
    Representation.groupFunctionPairingOverField ℂ
        (fun h : H ↦ φ (e h))
        (fun h : H ↦ ψ (e h)) =
      Representation.groupFunctionPairingOverField ℂ φ ψ := by
  letI : Fintype H := Fintype.ofFinite H
  letI : Fintype G := Fintype.ofFinite G
  have hcard : Fintype.card H = Fintype.card G := Fintype.card_congr e.toEquiv
  rw [Representation.groupFunctionPairingOverField, Representation.groupFunctionPairingOverField, hcard]
  congr 1
  simpa [MulEquiv.map_inv] using
    (Equiv.sum_comp e.toEquiv (fun g : G ↦ φ g⁻¹ * ψ g))

/-- Helper for Theorem 12-12.4-1: complexifying a class function after precomposing with a
multiplicative equivalence preserves conjugacy invariance. -/
private theorem complexified_precomp_classFunction_mem_local
    {H : Type*} [Group H] (e : H ≃* G) [Algebra L ℂ] (φ : classFunctionSubmodule L G) :
    (fun h : H ↦ algebraMap L ℂ (φ (e h))) ∈ classFunctionSubmodule ℂ H := by
  let hφclass : _root_.IsClassFunction (φ : G → L) :=
    (mem_classFunctionSubmodule_iff L (φ : G → L)).1 φ.2
  refine (mem_classFunctionSubmodule_iff ℂ _).2 ?_
  refine ⟨?_⟩
  intro x y hxy
  exact congrArg (algebraMap L ℂ) <|
    _root_.IsClassFunction.eq_of_isConj hφclass <| by
      rcases ConjClasses.mk_eq_mk_iff_isConj.mp hxy with ⟨a, ha⟩
      refine isConj_iff.2 ⟨e a, ?_⟩
      have hmap : SemiconjBy (e a) (e x) (e y) := ha.map e.toMonoidHom
      calc
        e a * e x * (e a)⁻¹ = (e y * e a) * (e a)⁻¹ := by
          simpa [SemiconjBy, mul_assoc] using congrArg (fun z : G => z * (e a)⁻¹) hmap
        _ = e y := by group

/-- Helper for Theorem 12-12.4-1: in the irreducible-character basis coming from a complete
family, the `i`-th coordinate of a complex class function is its normalized pairing with the
`i`-th irreducible character. -/
private theorem repr_complete_family_basis_eq_pairing_local
    {H : Type}
    [Group H] [Finite H]
    {ι : Type*}
    (π : ι → FDRep ℂ H)
    (hπ_pairwise : PairwiseNonisomorphic π)
    (hπ_complete : IsCompleteIrreducibleFamily π)
    [Finite ι]
    (b : Module.Basis ι ℂ (classFunctionSubmodule ℂ H))
    (hb : ∀ j : ι, (b j : H → ℂ) = (π j).character)
    (x : classFunctionSubmodule ℂ H) (i : ι) :
    b.repr x i =
      Representation.groupFunctionPairingOverField ℂ (x : H → ℂ) (π i).character := by
  classical
  let _ : Fintype H := Fintype.ofFinite H
  let _ : Fintype ι := Fintype.ofFinite ι
  let _ : NeZero (Nat.card H : ℂ) := ⟨by
    exact_mod_cast Nat.card_pos.ne'⟩
  let coordLinear : classFunctionSubmodule ℂ H →ₗ[ℂ] ℂ :=
    { toFun := fun y ↦ b.repr y i
      map_add' := by
        intro y z
        simp
      map_smul' := by
        intro a y
        simp }
  let pairLinear : classFunctionSubmodule ℂ H →ₗ[ℂ] ℂ :=
    { toFun := fun y ↦
        Representation.groupFunctionPairingOverField ℂ (y : H → ℂ) (π i).character
      map_add' := by
        intro y z
        simpa using Representation.groupFunctionPairing_add_left
          (y : H → ℂ) (z : H → ℂ) (π i).character
      map_smul' := by
        intro a y
        simpa using Representation.groupFunctionPairing_smul_left
          a (y : H → ℂ) (π i).character }
  have hmaps : coordLinear = pairLinear := by
    -- Compare the coordinate functional and the pairing functional on the basis vectors.
    apply b.ext
    intro j
    have hcoord_j : coordLinear (b j) = if i = j then 1 else 0 := by
      simpa [eq_comm] using
        (show coordLinear (b j) = if j = i then 1 else 0 by
          simp [coordLinear, Module.Basis.repr_self, Finsupp.single_apply])
    have hpair_j : pairLinear (b j) = if i = j then 1 else 0 := by
      by_cases hij : i = j
      · subst j
        letI : Simple (π i) := hπ_complete.isSimple i
        have hself_iso : Nonempty (π i ≅ π i) := ⟨Iso.refl _⟩
        calc
          pairLinear (b i) =
              Representation.groupFunctionPairingOverField ℂ
                (π i).character (π i).character := by
            simpa [pairLinear, hb i]
          _ = 1 := by
            simpa [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply,
              hself_iso] using
              (FDRep.char_orthonormal (π i) (π i))
          _ = if i = i then 1 else 0 := by simp
      · have hji : j ≠ i := fun h ↦ hij h.symm
        letI : Simple (π j) := hπ_complete.isSimple j
        letI : Simple (π i) := hπ_complete.isSimple i
        have hnot : ¬ Nonempty (π j ≅ π i) := hπ_pairwise hji
        calc
          pairLinear (b j) =
              Representation.groupFunctionPairingOverField ℂ
                (π j).character (π i).character := by
            simpa [pairLinear, hb j]
          _ = 0 := by
            simpa [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply,
              hnot] using
              (FDRep.char_orthonormal (π j) (π i))
          _ = if i = j then 1 else 0 := by simp [hij]
    exact hcoord_j.trans hpair_j.symm
  -- Apply the equality of linear functionals to the target class function.
  have hmaps_apply := congrArg
    (fun f : classFunctionSubmodule ℂ H →ₗ[ℂ] ℂ ↦ f x) hmaps
  simpa [coordLinear, pairLinear] using hmaps_apply

/-- Helper for Theorem 12-12.4-1: the normalized pairing of two `Γ[K](G)`-compatible
`L`-valued class functions is fixed by the cyclotomic action of `Γ[K](G)`. -/
private theorem groupFunctionPairing_fixed_of_galois_compatible_local
    (K : IntermediateField ℚ L) {φ ψ : G → L}
    (hφ : ∀ s (t : Γ[K](G)), t • φ s = φ (s ^ t))
    (hψ : ∀ s (t : Γ[K](G)), t • ψ s = ψ (s ^ t)) :
    ∀ t : Γ[K](G),
      t • Representation.groupFunctionPairingOverField L φ ψ =
        Representation.groupFunctionPairingOverField L φ ψ := by
  intro t
  let n : ℕ := galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)
  let m : ℕ := galoisPowerExponentUnit ((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ)
  let e : G ≃ G :=
    { toFun := fun s ↦ s ^ n
      invFun := fun s ↦ s ^ m
      left_inv := by
        intro s
        -- The inverse unit of `t` in `(ℤ / exp(G)ℤ)ˣ` undoes the power map on `G`.
        have hmod : n * m ≡ 1 [MOD Monoid.exponent G] := by
          have hprod :
              (t : (ZMod (Monoid.exponent G))ˣ) *
                  (((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ)) =
                (1 : (ZMod (Monoid.exponent G))ˣ) := by
            change
              (t : (ZMod (Monoid.exponent G))ˣ) *
                  ((t : (ZMod (Monoid.exponent G))ˣ)⁻¹) =
                (1 : (ZMod (Monoid.exponent G))ˣ)
            simp
          have hmod' :=
            galoisPowerExponentUnit_mul_modEq
              (G := G)
              (t := (t : (ZMod (Monoid.exponent G))ˣ))
              (u := (((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ)))
          have hmodbase :
              galoisPowerExponentUnit
                  ((t : (ZMod (Monoid.exponent G))ˣ) *
                    (((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ))) ≡
                n * m [MOD Monoid.exponent G] := by
            simpa [n, m] using hmod'
          have hone :
              galoisPowerExponentUnit
                  ((t : (ZMod (Monoid.exponent G))ˣ) *
                    (((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ))) ≡
                1 [MOD Monoid.exponent G] := by
            rw [hprod]
            rw [← ZMod.natCast_eq_natCast_iff]
            simp [galoisPowerExponentUnit]
          exact hmodbase.symm.trans hone
        calc
          (s ^ n) ^ m = (s ^ n) ^ m := by rfl
          _ = s ^ (n * m) := by rw [pow_mul]
          _ = s ^ 1 := by
                exact pow_eq_pow_of_modEq hmod (Monoid.pow_exponent_eq_one s)
          _ = s := by simp
      right_inv := by
        intro s
        -- The opposite unit identity gives the converse inverse law.
        have hmod : m * n ≡ 1 [MOD Monoid.exponent G] := by
          have hprod :
              (((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ) *
                  (t : (ZMod (Monoid.exponent G))ˣ)) =
                (1 : (ZMod (Monoid.exponent G))ˣ) := by
            change
              ((t : (ZMod (Monoid.exponent G))ˣ)⁻¹) *
                  (t : (ZMod (Monoid.exponent G))ˣ) =
                (1 : (ZMod (Monoid.exponent G))ˣ)
            simp
          have hmod' :=
            galoisPowerExponentUnit_mul_modEq
              (G := G)
              (t := (((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ))
              ) (u := (t : (ZMod (Monoid.exponent G))ˣ))
          have hmodbase :
              galoisPowerExponentUnit
                  ((((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ) *
                    (t : (ZMod (Monoid.exponent G))ˣ))) ≡
                m * n [MOD Monoid.exponent G] := by
            simpa [n, m] using hmod'
          have hone :
              galoisPowerExponentUnit
                  ((((t⁻¹ : Γ[K](G)) : (ZMod (Monoid.exponent G))ˣ) *
                    (t : (ZMod (Monoid.exponent G))ˣ))) ≡
                1 [MOD Monoid.exponent G] := by
            rw [hprod]
            rw [← ZMod.natCast_eq_natCast_iff]
            simp [galoisPowerExponentUnit]
          exact hmodbase.symm.trans hone
        calc
          (s ^ m) ^ n = (s ^ m) ^ n := by rfl
          _ = s ^ (m * n) := by rw [pow_mul]
          _ = s ^ 1 := by
                exact pow_eq_pow_of_modEq hmod (Monoid.pow_exponent_eq_one s)
          _ = s := by simp }
  let σ : L ≃ₐ[ℚ] L := (galEquivZMod (Monoid.exponent G) L).symm (t : (ZMod (Monoid.exponent G))ˣ)
  have hpair_formula :
      Representation.groupFunctionPairingOverField L φ ψ =
        (Nat.card G : L)⁻¹ * ∑ s : G, φ s * ψ s⁻¹ :=
    Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply φ ψ
  -- Reindex the finite sum along the permutation `s ↦ s ^ t` and use compatibility on both
  -- class functions.
  calc
    t • Representation.groupFunctionPairingOverField L φ ψ
        = t • ((↑(Nat.card G))⁻¹ * ∑ s : G, φ s * ψ s⁻¹) := by
            rw [hpair_formula]
    _ = σ (((Nat.card G : L)⁻¹) * ∑ s : G, φ s * ψ s⁻¹) := by
            rfl
    _ = ((Nat.card G : L)⁻¹) * (∑ s : G, σ (φ s * ψ s⁻¹)) := by
            simp [σ, map_sum, map_mul]
    _ = ((Nat.card G : L)⁻¹) * (∑ s : G, t • (φ s * ψ s⁻¹)) := by
            rfl
    _ = ((Nat.card G : L)⁻¹) * (∑ s : G, t • φ s * (t • ψ s⁻¹)) := by
            congr 1
            refine Finset.sum_congr rfl ?_
            intro s hs
            rw [smul_mul']
    _ = ((Nat.card G : L)⁻¹) *
          (∑ s : G, φ (s ^ t) * ψ ((s⁻¹) ^ t)) := by
            congr 1
            refine Finset.sum_congr rfl ?_
            intro s hs
            rw [hφ, hψ]
    _ = ((Nat.card G : L)⁻¹) *
          (∑ s : G, φ ((e.symm s) ^ t) * ψ (((e.symm s)⁻¹) ^ t)) := by
            congr 1
            symm
            simpa [e] using
              (Equiv.sum_comp e.symm
                (fun s : G ↦ φ (s ^ t) * ψ ((s⁻¹) ^ t)))
    _ = ((Nat.card G : L)⁻¹) * (∑ s : G, φ s * ψ s⁻¹) := by
            congr 1
            refine Finset.sum_congr rfl ?_
            intro s hs
            have hpow : (e.symm s) ^ t = s := by
              simpa [e, n, m, pow_subgroup_eq_pow_nat] using e.apply_symm_apply s
            have hpow_inv : ((e.symm s)⁻¹) ^ t = s⁻¹ := by
              have hpow_nat : (e.symm s) ^ n = s := by
                simpa [n, pow_subgroup_eq_pow_nat] using hpow
              have hinv := congrArg (fun z : G ↦ z⁻¹) hpow_nat
              have hpow_inv_nat : ((e.symm s)⁻¹) ^ n = s⁻¹ := by
                simpa [inv_pow] using hinv
              change ((e.symm s)⁻¹) ^ galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ) =
                s⁻¹
              simpa [n] using hpow_inv_nat
            rw [hpow, hpow_inv]
    _ = Representation.groupFunctionPairingOverField L φ ψ := by
          rw [hpair_formula]

/-- Helper for Theorem 12-12.4-1: pairing a `Γ[K](G)`-compatible class function with an
`L`-valued character produces a scalar already lying in the intermediate field `K`. -/
private theorem galois_compatible_pairing_mem_intermediateField_local
    (K : IntermediateField ℚ L) {φ : G → L}
    (hφ : ∀ s (t : Γ[K](G)), t • φ s = φ (s ^ t))
    (χL : R[L](G)) :
    Representation.groupFunctionPairingOverField L φ (χL : G → L) ∈ K := by
  -- First show the pairing is fixed by every element of `Γ[K](G)`.
  refine mem_intermediateField_of_gammaSubgroup_fixed (G := G) (K := K) _ ?_
  intro t
  exact
    groupFunctionPairing_fixed_of_galois_compatible_local (G := G) (L := L) K hφ
      (character_galois_compatible_of_mem_characterRingOverField (G := G) (K := K) χL) t

/-- Helper for Theorem 12-12.4-1: once the pairing coefficient with an `L`-valued ordinary
character descends to `K`, its complexification automatically lies in the image of `K → ℂ`. -/
private theorem complexified_pairing_in_image_of_K_local
    (K : IntermediateField ℚ L)
    [Algebra L ℂ] [IsScalarTower ℚ L ℂ]
    {φ : G → L}
    (hφ : ∀ s (t : Γ[K](G)), t • φ s = φ (s ^ t))
    (χL : R[L](G)) :
    algebraMap L ℂ (Representation.groupFunctionPairingOverField L φ (χL : G → L)) ∈
      Set.range (algebraMap K ℂ) := by
  refine ⟨⟨Representation.groupFunctionPairingOverField L φ (χL : G → L),
      galois_compatible_pairing_mem_intermediateField_local
        (G := G) (L := L) K hφ χL⟩, ?_⟩
  -- The image point is the composite `K → L → ℂ` applied to the descended pairing coefficient.
  change
    algebraMap L ℂ (Representation.groupFunctionPairingOverField L φ (χL : G → L)) =
      algebraMap L ℂ
        (((⟨Representation.groupFunctionPairingOverField L φ (χL : G → L),
          galois_compatible_pairing_mem_intermediateField_local
            (G := G) (L := L) K hφ χL⟩ : K) : L))
  rfl

/-- Helper for Theorem 12-12.4-1: any finite `K`-linear combination of ordinary `L`-valued
characters lies in the `K`-span generated by `R[L](G)`. -/
private theorem finite_character_sum_mem_span_local
    (K : IntermediateField ℚ L)
    {ι : Type*} [Finite ι]
    (a : ι → K) (χL : ι → R[L](G)) :
    (fun g : G ↦ ∑ i, (a i : L) * χL i g) ∈
      Submodule.span K ((R[L](G) : Set (G → L))) := by
  classical
  letI : Fintype ι := Fintype.ofFinite ι
  have hsum :
      (∑ i, (a i : L) • ((χL i : R[L](G)) : G → L)) ∈
        Submodule.span K ((R[L](G) : Set (G → L))) := by
    -- Check the claim term-by-term on the finite sum of generators.
    refine Submodule.sum_mem _ ?_
    intro i hi
    have hχL : ((χL i : R[L](G)) : G → L) ∈
        Submodule.span K ((R[L](G) : Set (G → L))) := by
      exact Submodule.subset_span (show (χL i : G → L) ∈ (R[L](G) : Set (G → L)) by
        exact (χL i).2)
    simpa [smul_eq_mul, Pi.smul_apply] using
      (Submodule.smul_mem (Submodule.span K ((R[L](G) : Set (G → L)))) (a i) hχL)
  have hfun :
      (fun g : G ↦ ∑ i, (a i : L) * χL i g) =
        ∑ i, (a i : L) • ((χL i : R[L](G)) : G → L) := by
    ext g
    simp [smul_eq_mul]
  rw [hfun]
  exact hsum

/-- Helper for Theorem 12-12.4-1: evaluating a finite linear combination of bundled class
functions is the same as evaluating the corresponding pointwise finite sum. -/
private theorem classFunctionSubmodule_sum_smul_apply_pointwise
    {H : Type*} [Group H] {K' : Type*} [Field K']
    {ι : Type*} [Fintype ι]
    (c : ι → K') (f : ι → classFunctionSubmodule K' H) (x : H) :
    (((∑ i, c i • f i : classFunctionSubmodule K' H) : H → K') x) =
      ∑ i, c i * ((f i : H → K') x) := by
  -- Push evaluation through the finite sum so the converse proof can compare basis coefficients
  -- pointwise, exactly as in LinearRepresentations_Serre_1977's reconstruction argument.
  simp [Pi.smul_apply, smul_eq_mul]

/-- Helper for Theorem 12-12.4-1: each coefficient in the complete irreducible complex basis of a
`Γ[K](G)`-compatible class function already comes from the intermediate field `K`. -/
private theorem complex_basis_coefficient_descends_to_K_local
    {H : Type} [Group H] [Finite H]
    (e : H ≃* G)
    (K : IntermediateField ℚ L)
    [Algebra L ℂ] [IsScalarTower ℚ L ℂ]
    {ι : Type*} [Finite ι]
    (π : ι → FDRep ℂ H)
    (hπ_pairwise : PairwiseNonisomorphic π)
    (hπ_complete : IsCompleteIrreducibleFamily π)
    (φ : classFunctionSubmodule L G)
    (hφ : ∀ s (t : Γ[K](G)), t • φ s = φ (s ^ t))
    (χL : ι → R[L](G))
    (hχL : ∀ i g, algebraMap L ℂ (χL i g) = (π i).character (e.symm g))
    (i : ι) :
    let φC : classFunctionSubmodule ℂ H :=
      ⟨fun h ↦ algebraMap L ℂ (φ (e h)),
        complexified_precomp_classFunction_mem_local (G := G) (L := L) e φ⟩
    let b := irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family
      π hπ_pairwise hπ_complete
    ∃ a : K, algebraMap K ℂ a = b.repr φC i := by
  classical
  let φC : classFunctionSubmodule ℂ H :=
    ⟨fun h ↦ algebraMap L ℂ (φ (e h)),
      complexified_precomp_classFunction_mem_local (G := G) (L := L) e φ⟩
  let b := irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family
    π hπ_pairwise hπ_complete
  letI : Fintype ι := Fintype.ofFinite ι
  have hb : ∀ j : ι, (b j : H → ℂ) = (π j).character := by
    intro j
    simp [b, irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family_apply]
  have hrepr :
      b.repr φC i =
        algebraMap L ℂ (Representation.groupFunctionPairingOverField L
          (φ : G → L) (χL i : G → L)) := by
    -- Identify the basis coefficient with LinearRepresentations_Serre_1977's pairing coefficient, then move it across
    -- the scalar-extension map `L → ℂ`.
    calc
      b.repr φC i =
          Representation.groupFunctionPairingOverField ℂ (φC : H → ℂ) (π i).character := by
            exact
              repr_complete_family_basis_eq_pairing_local
                (H := H) π hπ_pairwise hπ_complete b hb φC i
      _ =
          Representation.groupFunctionPairingOverField ℂ
            (fun h : H ↦ algebraMap L ℂ (φ (e h)))
            (fun h : H ↦ algebraMap L ℂ ((χL i : G → L) (e h))) := by
            congr
            ext h
            simpa using (hχL i (e h)).symm
      _ =
          Representation.groupFunctionPairingOverField ℂ
            (fun g : G ↦ algebraMap L ℂ (φ g))
            (fun g : G ↦ algebraMap L ℂ ((χL i : G → L) g)) := by
            exact
              groupFunctionPairingOverField_precomp_mulEquiv_local
                (G := G) e
                (fun g : G ↦ algebraMap L ℂ (φ g))
                (fun g : G ↦ algebraMap L ℂ ((χL i : G → L) g))
      _ =
          algebraMap L ℂ (Representation.groupFunctionPairingOverField L
            (φ : G → L) (χL i : G → L)) := by
            simpa using
              (groupFunctionPairingOverField_algebraMap_local
                (L := L) (J := G) (φ := (φ : G → L)) (ψ := (χL i : G → L)))
  rcases complexified_pairing_in_image_of_K_local
      (G := G) (L := L) K hφ (χL i) with ⟨a, ha⟩
  -- The descended pairing value is exactly the desired basis coefficient.
  exact ⟨a, ha.trans hrepr.symm⟩

/-- Helper for Theorem 12-12.4-1: evaluating the complete-family basis expansion pointwise and
replacing each complex character by an `L`-valued lift reconstructs the original class function
after applying `L → ℂ`. -/
private theorem complexified_reconstruction_from_basis_sum_local
    {H : Type} [Group H] [Finite H]
    (e : H ≃* G)
    (K : IntermediateField ℚ L)
    [Algebra L ℂ] [IsScalarTower ℚ L ℂ]
    {ι : Type*} [Finite ι]
    (π : ι → FDRep ℂ H)
    (hπ_pairwise : PairwiseNonisomorphic π)
    (hπ_complete : IsCompleteIrreducibleFamily π)
    (φ : classFunctionSubmodule L G)
    (a : ι → K)
    (ha : ∀ i,
      algebraMap K ℂ (a i) =
        (let φC : classFunctionSubmodule ℂ H :=
            ⟨fun h ↦ algebraMap L ℂ (φ (e h)),
              complexified_precomp_classFunction_mem_local (G := G) (L := L) e φ⟩
          let b := irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family
            π hπ_pairwise hπ_complete
          b.repr φC i))
    (χL : ι → R[L](G))
    (hχL : ∀ i g, algebraMap L ℂ (χL i g) = (π i).character (e.symm g)) :
    ∀ g : G, algebraMap L ℂ (∑ i, (a i : L) * χL i g) = algebraMap L ℂ (φ g) := by
  classical
  let φC : classFunctionSubmodule ℂ H :=
    ⟨fun h ↦ algebraMap L ℂ (φ (e h)),
      complexified_precomp_classFunction_mem_local (G := G) (L := L) e φ⟩
  let b := irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family
    π hπ_pairwise hπ_complete
  letI : Fintype ι := Fintype.ofFinite ι
  intro g
  have hsum :
      (((∑ i, b.repr φC i • b i : classFunctionSubmodule ℂ H) : H → ℂ) (e.symm g)) =
        algebraMap L ℂ (φ g) := by
    -- Evaluate the basis reconstruction `b.sum_repr φC` at the preimage of `g`.
    simpa [φC] using
      congrFun
        (congrArg (fun z : classFunctionSubmodule ℂ H ↦ (z : H → ℂ)) (b.sum_repr φC)) (e.symm g)
  calc
    algebraMap L ℂ (∑ i, (a i : L) * χL i g)
        = ∑ i, algebraMap L ℂ (a i : L) * (π i).character (e.symm g) := by
            -- Push the algebra map through the finite sum and replace each lifted character by
            -- the corresponding complex irreducible character.
            simp [map_sum, map_mul, hχL]
    _ = ∑ i, b.repr φC i * (π i).character (e.symm g) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          have hai : algebraMap L ℂ (a i : L) = b.repr φC i := by
            simpa [IsScalarTower.algebraMap_eq K L ℂ, RingHom.comp_apply, φC, b] using ha i
          exact congrArg (fun z : ℂ => z * (π i).character (e.symm g)) hai
    _ = ∑ i, b.repr φC i * ((b i : H → ℂ) (e.symm g)) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          simp [b, irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family_apply]
    _ = (((∑ i, b.repr φC i • b i : classFunctionSubmodule ℂ H) : H → ℂ) (e.symm g)) := by
          symm
          simpa using
            classFunctionSubmodule_sum_smul_apply_pointwise
              (c := fun i ↦ b.repr φC i) (f := fun i ↦ b i) (e.symm g)
    _ = algebraMap L ℂ (φ g) := hsum

/-- Helper for Theorem 12-12.4-1: once the reconstructed finite sum agrees with `φ` after
complexification, injectivity of `L → ℂ` shows that `φ` itself lies in the `K`-span of ordinary
`L`-valued characters. -/
private theorem span_membership_of_reconstructed_sum_local
    (K : IntermediateField ℚ L)
    [Algebra L ℂ] [IsScalarTower ℚ L ℂ]
    {ι : Type*} [Finite ι]
    (φ : classFunctionSubmodule L G)
    (a : ι → K) (χL : ι → R[L](G))
    (hrec : ∀ g : G, algebraMap L ℂ (∑ i, (a i : L) * χL i g) = algebraMap L ℂ (φ g)) :
    (φ : G → L) ∈ Submodule.span K ((R[L](G) : Set (G → L))) := by
  classical
  have hfun :
      (fun g : G ↦ ∑ i, (a i : L) * χL i g) = (φ : G → L) := by
    -- The complex embedding is injective, so the pointwise complexified equality descends to `L`.
    ext g
    exact (algebraMap L ℂ).injective (hrec g)
  rw [← hfun]
  -- The reconstructed finite `K`-linear combination is visibly in the target span.
  exact finite_character_sum_mem_span_local (G := G) (L := L) K a χL

-- Source/core/bridge triage:
-- * source-facing: LinearRepresentations_Serre_1977's criterion for an `L`-valued class function to come from
--   `ℚ ⊗ R_K(G)`.
-- * core/canonical owner: bundled `L`-valued class functions `classFunctionSubmodule L G`.
-- * bridge/view: the underlying function coercion `(φ : G → L)`.
--
-- Proof sketch: the source theorem is about the `K`-span of the ordinary `L`-valued characters
-- of `G`, i.e. `K ⊗_ℤ R(G)` realized inside `G → L`, not about the much smaller owner
-- `ℚ ⊗ R_K(G)` transported into `L`. The forward direction should be proved on honest characters
-- by the cyclic-subgroup eigenvalue argument; the converse is the standard coefficient-descent
-- argument on a complete irreducible complex basis realized over `L`.
/-- Theorem 12-12.4-1: let `L / ℚ` be a cyclotomic realization for the exponent of `G`, and let
`K ⊆ L` be an intermediate field. An `L`-valued class function on `G`, viewed through the canonical
owner `classFunctionSubmodule L G`, belongs to the `K`-span of the ordinary `L`-valued characters
of `G` if and only if it is equivariant for LinearRepresentations_Serre_1977's subgroup `Γ_K`, acting on values through the
canonical cyclotomic Galois action on `L`. This is the source-faithful realization of
`K ⊗_ℤ R(G)` inside `G → L`. -/
theorem classFunction_mem_characterRingOverFieldScalarExtension_map_iff_galoisCompatible
    (K : IntermediateField ℚ L) (φ : classFunctionSubmodule L G) :
    (φ : G → L) ∈ Submodule.span K ((R[L](G) : Set (G → L))) ↔
      ∀ s (t : Γ[K](G)), t • φ s = φ (s ^ t) := by
  constructor
  · intro hφ
    -- Prove the compatibility on generators of the `K`-span and extend by linearity.
    change ∀ s (t : Γ[K](G)), t • (φ : G → L) s = (φ : G → L) (s ^ t)
    refine Submodule.span_induction
        (p := fun f (_hf : f ∈ Submodule.span K ((R[L](G) : Set (G → L))) ) ↦
          ∀ s (t : Γ[K](G)), t • f s = f (s ^ t))
        ?_ ?_ ?_ ?_ hφ
    · intro χ hχ s t
      exact
        character_galois_compatible_of_mem_characterRingOverField (G := G) (K := K)
          ⟨χ, hχ⟩ s t
    · intro s t
      simpa using (smul_zero t : t • (0 : L) = 0)
    · intro f g hf hg hcompatf hcompatg s t
      -- Compatibility is preserved by addition.
      calc
        t • (f + g) s = t • (f s + g s) := by rfl
        _ = t • f s + t • g s := by rw [smul_add]
        _ = f (s ^ t) + g (s ^ t) := by rw [hcompatf, hcompatg]
        _ = (f + g) (s ^ t) := by rfl
    · intro a f hf hcompat s t
      -- Scalars from `K` are fixed by `Γ[K](G)`, so scalar multiples preserve compatibility.
      calc
        t • (a • f) s = t • (algebraMap K L a * f s) := by rfl
        _ = (t • algebraMap K L a) * (t • f s) := by rw [smul_mul']
        _ = algebraMap K L a * f (s ^ t) := by
              rw [gammaSubgroup_smul_algebraMap, hcompat]
        _ = (a • f) (s ^ t) := by rfl
  · intro hcompat
    -- Route correction: the converse should follow LinearRepresentations_Serre_1977's irreducible-character basis argument,
    -- not a local recursive decomposition. The pointwise evaluation normalization is now isolated
    -- in `classFunctionSubmodule_sum_smul_apply_pointwise`, so the remaining work is to assemble
    -- the complete-family expansion and coefficient descent along the existing local pairing API.
    classical
    let G₀ : Type := Shrink.{0} G
    let e : G₀ ≃* G := Shrink.mulEquiv
    let complexEmbedding : L →+* ℂ := NumberField.ComplexEmbedding.lift L (algebraMap ℚ ℂ)
    letI : Algebra L ℂ := RingHom.toAlgebra complexEmbedding
    letI : IsScalarTower ℚ L ℂ := by infer_instance
    letI : Finite G₀ := Finite.of_equiv G e.toEquiv.symm
    letI : NeZero (Nat.card G₀ : ℂ) := ⟨Nat.cast_ne_zero.mpr Nat.card_pos.ne'⟩
    letI : IsCyclotomicExtension {Monoid.exponent G₀} ℚ L := by
      simpa [G₀, Monoid.exponent_eq_of_mulEquiv e] using
        (inferInstance : IsCyclotomicExtension {Monoid.exponent G} ℚ L)
    obtain ⟨ι, _, π, hπ_pairwise, hπ_complete⟩ :=
      FDRep.exists_complete_pairwise_nonisomorphic_simple_family (k := ℂ) (G := G₀)
    letI : Finite ι := IsCompleteIrreducibleFamily.finite_index π hπ_complete hπ_pairwise
    letI : Fintype ι := Fintype.ofFinite ι
    let χL₀ : ι → R[L](G₀) := fun i ↦
      Classical.choose
        (ordinary_character_lift_to_characterRingOverField_local
          (G := G₀) (L := L)
          ⟨(π i).character, by
            simpa using
              (Representation.rep_character_mem_characterRingOverField
                (K := ℂ) (G := G₀) (ρ := Rep.of (π i).ρ))⟩)
    have hχL₀ : ∀ i g, algebraMap L ℂ (χL₀ i g) = (π i).character g := by
      intro i g
      exact
        Classical.choose_spec
          (ordinary_character_lift_to_characterRingOverField_local
            (G := G₀) (L := L)
            ⟨(π i).character, by
              simpa using
                (Representation.rep_character_mem_characterRingOverField
                  (K := ℂ) (G := G₀) (ρ := Rep.of (π i).ρ))⟩) g
    let χL : ι → R[L](G) := fun i ↦
      ⟨fun g ↦ χL₀ i (e.symm g),
        mem_characterRingOverField_of_precomp_mulEquiv_local
          (G := G₀) (K' := L) e.symm (χL₀ i).property⟩
    have hχL : ∀ i g, algebraMap L ℂ (χL i g) = (π i).character (e.symm g) := by
      intro i g
      simpa [χL] using hχL₀ i (e.symm g)
    let a : ι → K := fun i ↦
      Classical.choose
        (complex_basis_coefficient_descends_to_K_local
          (G := G) (L := L) (H := G₀) e K π hπ_pairwise hπ_complete φ hcompat χL hχL i)
    have ha : ∀ i,
        algebraMap K ℂ (a i) =
          (let φC : classFunctionSubmodule ℂ G₀ :=
              ⟨fun g ↦ algebraMap L ℂ (φ (e g)),
                complexified_precomp_classFunction_mem_local (G := G) (L := L) e φ⟩
            let b := irreducibleCharacters_basis_of_classFunctionSubspace_of_complete_family
              π hπ_pairwise hπ_complete
            b.repr φC i) := by
      intro i
      exact
        Classical.choose_spec
          (complex_basis_coefficient_descends_to_K_local
            (G := G) (L := L) (H := G₀) e K π hπ_pairwise hπ_complete φ hcompat χL hχL i)
    have hrec :
        ∀ g : G, algebraMap L ℂ (∑ i, (a i : L) * χL i g) = algebraMap L ℂ (φ g) :=
      complexified_reconstruction_from_basis_sum_local
        (G := G) (L := L) (H := G₀) e K π hπ_pairwise hπ_complete φ a ha χL hχL
    -- This is LinearRepresentations_Serre_1977's converse: the complex basis expansion descends coefficientwise to `K`,
    -- then the descended finite sum of lifted `L`-characters already lies in the desired span.
    exact
      span_membership_of_reconstructed_sum_local
        (G := G) (L := L) K φ a χL hrec

