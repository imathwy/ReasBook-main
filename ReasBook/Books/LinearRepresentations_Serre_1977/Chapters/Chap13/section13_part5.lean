variable {G : Type u} [Group G] [Finite G]

local instance : Fintype G := Fintype.ofFinite G
local instance (H : Subgroup G) : Fintype H := Fintype.ofFinite H

/-- Helper for Exercise 13-13.1-15: summing a restricted function over an internal subgroup agrees
with summing the ambient function over the corresponding mapped subgroup. -/
lemma subgroup_sum_restrict_eq_sum_map_subtype
    (C : Subgroup G) (J : Subgroup C) (f : G → ℚ) :
    (∑ s : J, f s) = ∑ t : J.map C.subtype, f t := by
  classical
  -- Reindex the finite sum along the canonical equivalence `J ≃ J.map C.subtype`.
  simpa using
    (Fintype.sum_equiv (J.equivMapOfInjective C.subtype C.subtype_injective)
      (fun s : J ↦ f s) (fun t : J.map C.subtype ↦ f t) (fun s ↦ rfl))

/-- Helper for Exercise 13-13.1-15: a proper subgroup of a finite group has strictly smaller
cardinality. -/
lemma proper_subgroup_natCard_lt {A : Type u} [Group A] [Finite A] (J : Subgroup A)
    (hJ : J ≠ ⊤) : Nat.card J < Nat.card A := by
  let _ : Fintype A := Fintype.ofFinite A
  let _ : Fintype J := Fintype.ofFinite J
  -- A proper subgroup omits some ambient element, so its subtype cardinality is strictly smaller.
  have hex : ∃ a : A, a ∉ J := by
    by_cases hall : ∀ a : A, a ∈ J
    · exact False.elim (hJ (by
        ext a
        simp [hall a]))
    · exact not_forall.mp hall
  rcases hex with ⟨a, ha⟩
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
  simpa using (Fintype.card_subtype_lt (p := fun b : A ↦ b ∈ J) ha)

/-- Helper for Exercise 13-13.1-15: on a finite cyclic group, a function that is constant on
elements generating the same cyclic subgroup and whose subgroup sums all vanish is identically
zero. -/
lemma cyclic_function_eq_zero_of_zero_subgroup_sums
    {A : Type u} [Group A] [Finite A] [IsCyclic A]
    (f : A → ℚ)
    (hconst : ∀ {x y : A}, Subgroup.zpowers x = Subgroup.zpowers y → f x = f y)
    (hsum : ∀ J : Subgroup A, ∑ s : J, f s = 0) :
    f = 0 := by
  classical
  let P : ℕ → Prop := fun n ↦
    ∀ (B : Type u) (_ : Group B) (_ : Finite B) (_ : IsCyclic B),
      Nat.card B = n →
      ∀ φ : B → ℚ,
        (∀ {x y : B}, Subgroup.zpowers x = Subgroup.zpowers y → φ x = φ y) →
        (∀ J : Subgroup B, ∑ s : J, φ s = 0) → φ = 0
  have hstrong : ∀ n : ℕ, P n := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih B _ _ _ hBcard φ hconstφ hsumφ
    -- First restrict to each proper cyclic subgroup generated by a nongenerator.
    have hzero_nongenerator :
        ∀ b : B, Subgroup.zpowers b ≠ (⊤ : Subgroup B) → φ b = 0 := by
      intro b hb
      let J : Subgroup B := Subgroup.zpowers b
      have hlt : Nat.card J < n := by
        rw [← hBcard]
        exact proper_subgroup_natCard_lt J hb
      let φJ : J → ℚ := fun j ↦ φ j
      have hconstJ :
          ∀ {x y : J}, Subgroup.zpowers x = Subgroup.zpowers y → φJ x = φJ y := by
        intro x y hxy
        apply hconstφ
        calc
          Subgroup.zpowers (x : B) = (Subgroup.zpowers x).map J.subtype := by
            symm
            exact MonoidHom.map_zpowers J.subtype x
          _ = (Subgroup.zpowers y).map J.subtype := by rw [hxy]
          _ = Subgroup.zpowers (y : B) := by
            exact MonoidHom.map_zpowers J.subtype y
      have hsumJ : ∀ K : Subgroup J, ∑ s : K, φJ s = 0 := by
        intro K
        -- Transport the internal subgroup sum to the corresponding subgroup of `B`.
        calc
          ∑ s : K, φJ s = ∑ t : K.map J.subtype, φ t := by
            exact subgroup_sum_restrict_eq_sum_map_subtype J K (φ : B → ℚ)
          _ = 0 := hsumφ (K.map J.subtype)
      have hφJ_zero : φJ = 0 := by
        simpa using
          ih (Nat.card J) hlt J inferInstance inferInstance inferInstance rfl φJ hconstJ hsumJ
      have hb_mem : b ∈ J := Subgroup.mem_zpowers b
      have hvalue : φJ ⟨b, hb_mem⟩ = 0 := by
        simp [hφJ_zero]
      simpa [φJ] using hvalue
    obtain ⟨g, hg⟩ := isCyclic_iff_exists_zpowers_eq_top.mp (inferInstance : IsCyclic B)
    let gen : B → Prop := fun b ↦ Subgroup.zpowers b = (⊤ : Subgroup B)
    have hgenerator_value :
        ∀ b : B, gen b → φ b = φ g := by
      intro b hb
      have hzpow : Subgroup.zpowers b = Subgroup.zpowers g := by
        rw [hb, hg]
      exact hconstφ hzpow
    have hsum_all : ∑ b : B, φ b = 0 := by
      have htop : ∑ s : (⊤ : Subgroup B), φ s = 0 := hsumφ ⊤
      have htop_sum : ∑ s : (⊤ : Subgroup B), φ s = ∑ b : B, φ b := by
        exact
          Fintype.sum_equiv (Subgroup.topEquiv : (⊤ : Subgroup B) ≃* B).toEquiv
            (fun s : (⊤ : Subgroup B) ↦ φ s)
            (fun b : B ↦ φ b) (fun s ↦ rfl)
      exact htop_sum.symm ▸ htop
    have hsum_nongenerators :
        Finset.sum (Finset.univ.filter (fun b : B ↦ ¬ gen b)) (fun b ↦ φ b) = 0 := by
      -- Every nongenerator vanishes after restricting to the proper subgroup it generates.
      refine Finset.sum_eq_zero ?_
      intro b hb
      exact hzero_nongenerator b (Finset.mem_filter.mp hb).2
    have hsum_generators :
        Finset.sum (Finset.univ.filter gen) (fun b ↦ φ b) =
          ((Finset.univ.filter gen).card : ℚ) * φ g := by
      -- All generators carry the same value, so the filtered sum is constant.
      calc
        Finset.sum (Finset.univ.filter gen) (fun b ↦ φ b)
            = Finset.sum (Finset.univ.filter gen) (fun _ ↦ φ g) := by
                refine Finset.sum_congr rfl ?_
                intro b hb
                exact hgenerator_value b (Finset.mem_filter.mp hb).2
        _ = ((Finset.univ.filter gen).card : ℚ) * φ g := by
              simp [nsmul_eq_mul]
    have hfiltered_zero :
        Finset.sum (Finset.univ.filter gen) (fun b ↦ φ b) = 0 := by
      -- Split the total sum into generators and nongenerators.
      have hsplit :=
        Finset.sum_filter_add_sum_filter_not Finset.univ gen (fun b : B ↦ φ b)
      rw [hsum_nongenerators, add_zero, hsum_all] at hsplit
      exact hsplit
    have hcard_generators_ne_zero :
        ((Finset.univ.filter gen).card : ℚ) ≠ 0 := by
      apply Nat.cast_ne_zero.mpr
      refine Finset.card_ne_zero.mpr ?_
      exact ⟨g, by simp [gen, hg]⟩
    have hg_zero : φ g = 0 := by
      have hprod_zero : ((Finset.univ.filter gen).card : ℚ) * φ g = 0 := by
        rw [← hsum_generators]
        exact hfiltered_zero
      rcases mul_eq_zero.mp hprod_zero with hcard_zero | hvalue_zero
      · exact False.elim (hcard_generators_ne_zero hcard_zero)
      · exact hvalue_zero
    -- Every element is either a generator, hence equal to the common zero value, or a
    -- nongenerator.
    funext b
    by_cases hb : gen b
    · simp [hgenerator_value b hb, hg_zero]
    · simp [hzero_nongenerator b hb]
  simpa using hstrong (Nat.card A) A inferInstance inferInstance inferInstance rfl f hconst hsum

/-- Helper for Exercise 13-13.1-15: if a function on a finite group has zero sum on every cyclic
subgroup and depends only on the generated cyclic subgroup, then it is identically zero. -/
theorem function_eq_zero_of_zero_cyclic_subgroup_sums
    (f : G → ℚ)
    (hconst : ∀ {x y : G}, Subgroup.zpowers x = Subgroup.zpowers y → f x = f y)
    (hsum : ∀ H : Subgroup.cyclicSubgroups G, ∑ s : H.1, f s = 0) :
    f = 0 := by
  -- Restrict to the cyclic subgroup generated by each element and apply the cyclic lemma there.
  funext g
  let C : Subgroup G := Subgroup.zpowers g
  let fC : C → ℚ := fun c ↦ f c
  have hconstC :
      ∀ {x y : C}, Subgroup.zpowers x = Subgroup.zpowers y → fC x = fC y := by
    intro x y hxy
    apply hconst
    calc
      Subgroup.zpowers (x : G) = (Subgroup.zpowers x).map C.subtype := by
        symm
        exact MonoidHom.map_zpowers C.subtype x
      _ = (Subgroup.zpowers y).map C.subtype := by rw [hxy]
      _ = Subgroup.zpowers (y : G) := by
        exact MonoidHom.map_zpowers C.subtype y
  have hsumC : ∀ J : Subgroup C, ∑ s : J, fC s = 0 := by
    intro J
    have hmap_cyclic : IsCyclic (J.map C.subtype) := by
      exact ((J.equivMapOfInjective C.subtype C.subtype_injective).isCyclic).1 inferInstance
    -- Reindex the internal subgroup sum to the corresponding cyclic subgroup of `G`.
    calc
      ∑ s : J, fC s = ∑ t : J.map C.subtype, f t := by
        exact subgroup_sum_restrict_eq_sum_map_subtype C J (f : G → ℚ)
      _ = 0 := hsum ⟨J.map C.subtype, Subgroup.mem_cyclicSubgroups.2 hmap_cyclic⟩
  have hfC_zero : fC = 0 :=
    cyclic_function_eq_zero_of_zero_subgroup_sums fC hconstC hsumC
  have hg_mem : g ∈ C := Subgroup.mem_zpowers g
  -- Evaluate the restricted vanishing theorem at the distinguished element `g ∈ ⟨g⟩`.
  have hvalue : fC ⟨g, hg_mem⟩ = 0 := by
    simp [hfC_zero]
  simpa [fC] using hvalue

end

