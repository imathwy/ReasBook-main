/-- Exercise 13-13.1-15: two finite `G`-sets are weakly isomorphic if their complex permutation
representations are isomorphic. The owner objects are bundled finite `G`-sets
`X Y : Action FintypeCat G`; their permutation representations are `Rep.ofMulAction ℂ G X.V` and
`Rep.ofMulAction ℂ G Y.V`. The fixed-point and orbit-count criteria are recorded below as
equivalent formulations. -/
abbrev WeaklyIsomorphic : Prop :=
  IsIsomorphic (Rep.ofMulAction ℂ G X.V) (Rep.ofMulAction ℂ G Y.V)

end

section

variable {G : Type u} [Group G]
variable {X Y : Action FintypeCat.{v} G}

/-- Helper for Exercise 13-13.1-15: package the two permutation actions into one homomorphism
to the product of the corresponding symmetric groups. -/
abbrev paired_permutation_hom :
    G →* (Equiv.Perm X.V × Equiv.Perm Y.V) :=
  MonoidHom.prod (MulAction.toPermHom G X.V) (MulAction.toPermHom G Y.V)

/-- Helper for Exercise 13-13.1-15: the common finite permutation image through which both actions
factor. -/
abbrev paired_permutation_range : Type _ :=
  (paired_permutation_hom (X := X) (Y := Y)).range

/-- Helper for Exercise 13-13.1-15: the canonical surjection from `G` onto the common permutation
image. -/
abbrev paired_permutation_range_lift :
    G →* paired_permutation_range (X := X) (Y := Y) :=
  (paired_permutation_hom (X := X) (Y := Y)).rangeRestrict

/-- Helper for Exercise 13-13.1-15: project the common permutation image to the `X`-permutation
factor. -/
abbrev paired_permutation_range_left_hom :
    paired_permutation_range (X := X) (Y := Y) →* Equiv.Perm X.V :=
  { toFun := fun q ↦ q.1.1
    map_one' := rfl
    map_mul' := by
      intro a b
      rfl }

/-- Helper for Exercise 13-13.1-15: project the common permutation image to the `Y`-permutation
factor. -/
abbrev paired_permutation_range_right_hom :
    paired_permutation_range (X := X) (Y := Y) →* Equiv.Perm Y.V :=
  { toFun := fun q ↦ q.1.2
    map_one' := rfl
    map_mul' := by
      intro a b
      rfl }

/-- Helper for Exercise 13-13.1-15: for a cyclic action generator `g`, being fixed by the whole
subgroup `⟨g⟩` is equivalent to being fixed by `g` itself, so the corresponding finite fixed-point
counts agree. -/
lemma card_fixedPoints_zpowers_eq_ncard_fixedBy {α : Type*} [MulAction G α] [Finite α] (g : G) :
    Nat.card (MulAction.fixedPoints (Subgroup.zpowers g) α) = (MulAction.fixedBy α g).ncard := by
  classical
  let e : MulAction.fixedPoints (Subgroup.zpowers g) α ≃ MulAction.fixedBy α g :=
    { toFun := fun x ↦
        ⟨x.1, by
          -- A point fixed by every element of `⟨g⟩` is in particular fixed by every power of `g`.
          have hx : ∀ j : ℤ, x.1 ∈ MulAction.fixedBy α (g ^ j) := by
            intro j
            rw [MulAction.mem_fixedBy]
            exact MulAction.mem_fixedPoints.mp x.2 ⟨g ^ j, ⟨j, rfl⟩⟩
          exact (MulAction.mem_fixedBy_zpowers_iff_mem_fixedBy).1 hx⟩
      invFun := fun x ↦
        ⟨x.1, by
          -- Conversely, fixedness under `g` propagates to every power, hence to the whole subgroup.
          rw [MulAction.mem_fixedPoints]
          intro h
          rcases h with ⟨h, ⟨j, rfl⟩⟩
          simpa [MulAction.mem_fixedBy] using MulAction.mem_fixedBy_zpow x.2 j⟩
      left_inv := by
        intro x
        rfl
      right_inv := by
        intro x
        rfl }
  calc
    Nat.card (MulAction.fixedPoints (Subgroup.zpowers g) α)
        = Nat.card (MulAction.fixedBy α g) := Nat.card_congr e
    _ = (MulAction.fixedBy α g).ncard := by
        letI : Fintype (MulAction.fixedBy α g) := Fintype.ofFinite _
        rw [Nat.card_eq_fintype_card]
        simp [Set.ncard_eq_toFinset_card']

/-- Helper for Exercise 13-13.1-15: an equivariant isomorphism induces a bijection on the
`H`-fixed points. -/
lemma card_fixedPoints_eq_of_isomorphic {X Y : Action FintypeCat G}
    (e : IsIsomorphic X Y) (H : Subgroup G) :
    Nat.card (MulAction.fixedPoints H X.V) = Nat.card (MulAction.fixedPoints H Y.V) := by
  rcases e with ⟨e⟩
  -- Transport each fixed point across the underlying equivariant bijection.
  refine Nat.card_congr
    { toFun := fun x ↦
        ⟨e.hom.hom x.1, by
          rw [MulAction.mem_fixedPoints]
          intro h
          have hx := MulAction.mem_fixedPoints.mp x.2 h
          have hcomm := ConcreteCategory.congr_hom (e.hom.comm (h : G)) x.1
          calc
            (h : G) • e.hom.hom x.1 = e.hom.hom ((h : G) • x.1) := by
              simpa using hcomm.symm
            _ = e.hom.hom x.1 := by
              exact congrArg e.hom.hom hx⟩
      invFun := fun y ↦
        ⟨e.inv.hom y.1, by
          rw [MulAction.mem_fixedPoints]
          intro h
          have hy := MulAction.mem_fixedPoints.mp y.2 h
          have hcomm := ConcreteCategory.congr_hom (e.inv.comm (h : G)) y.1
          calc
            (h : G) • e.inv.hom y.1 = e.inv.hom ((h : G) • y.1) := by
              simpa using hcomm.symm
            _ = e.inv.hom y.1 := by
              exact congrArg e.inv.hom hy⟩
      left_inv := by
        intro x
        ext
        exact Iso.hom_inv_id_apply e x.1
      right_inv := by
        intro y
        ext
        exact Iso.inv_hom_id_apply e y.1 }

/-- Helper for Exercise 13-13.1-15: the coproduct action is isomorphic to the evident action on
the disjoint union of the two underlying finite sets. -/
theorem coprod_sum_action_isomorphic {X Y : Action FintypeCat G} :
    IsIsomorphic (X ⨿ Y) (Action.FintypeCat.ofMulAction G (FintypeCat.of (X.V.obj ⊕ Y.V.obj))) := by
  let inlHom : X ⟶ Action.FintypeCat.ofMulAction G (FintypeCat.of (X.V.obj ⊕ Y.V.obj)) :=
    { hom := FintypeCat.homMk (fun x => (Sum.inl x : X.V.obj ⊕ Y.V.obj))
      comm := by
        intro g
        ext x
        -- On the left summand, the sum action applies the original `X`-action componentwise.
        change (Sum.inl (g • x) : X.V.obj ⊕ Y.V.obj) =
          g • (Sum.inl x : X.V.obj ⊕ Y.V.obj)
        rfl }
  let inrHom : Y ⟶ Action.FintypeCat.ofMulAction G (FintypeCat.of (X.V.obj ⊕ Y.V.obj)) :=
    { hom := FintypeCat.homMk (fun y => (Sum.inr y : X.V.obj ⊕ Y.V.obj))
      comm := by
        intro g
        ext y
        -- The right summand behaves symmetrically.
        change (Sum.inr (g • y) : X.V.obj ⊕ Y.V.obj) =
          g • (Sum.inr y : X.V.obj ⊕ Y.V.obj)
        rfl }
  let hom : X ⨿ Y ⟶ Action.FintypeCat.ofMulAction G (FintypeCat.of (X.V.obj ⊕ Y.V.obj)) :=
    Limits.coprod.desc inlHom inrHom
  let inv : Action.FintypeCat.ofMulAction G (FintypeCat.of (X.V.obj ⊕ Y.V.obj)) ⟶ X ⨿ Y :=
    { hom := FintypeCat.homMk
        (fun z ↦ Sum.elim (Limits.coprod.inl : X ⟶ X ⨿ Y) (Limits.coprod.inr : Y ⟶ X ⨿ Y) z)
      comm := by
        intro g
        ext z
        cases z with
        | inl x =>
            -- Route correction: instead of unfolding the coproduct action directly, use the
            -- equivariance of the coproduct injections already provided by `Limits.coprod.inl`.
            change (Limits.coprod.inl : X ⟶ X ⨿ Y) (g • x) =
              g • ((Limits.coprod.inl : X ⟶ X ⨿ Y) x)
            exact ConcreteCategory.congr_hom ((Limits.coprod.inl : X ⟶ X ⨿ Y).comm g) x
        | inr y =>
            change (Limits.coprod.inr : Y ⟶ X ⨿ Y) (g • y) =
              g • ((Limits.coprod.inr : Y ⟶ X ⨿ Y) y)
            exact ConcreteCategory.congr_hom ((Limits.coprod.inr : Y ⟶ X ⨿ Y).comm g) y }
  have hinl : inlHom ≫ inv = (Limits.coprod.inl : X ⟶ X ⨿ Y) := by
    -- Composing the inclusion of the left summand with the fold map returns the coproduct
    -- inclusion.
    ext x
    rfl
  have hinr : inrHom ≫ inv = (Limits.coprod.inr : Y ⟶ X ⨿ Y) := by
    -- The right summand is identical.
    ext y
    rfl
  have hhom_inl (x : X.V.obj) :
      hom.hom ((Limits.coprod.inl : X ⟶ X ⨿ Y).hom x) = Sum.inl x := by
    -- The universal map out of the coproduct restricts to the chosen left injection.
    simpa [hom, inlHom] using
      ConcreteCategory.congr_hom (Limits.coprod.inl_desc inlHom inrHom) x
  have hhom_inr (y : Y.V.obj) :
      hom.hom ((Limits.coprod.inr : Y ⟶ X ⨿ Y).hom y) = Sum.inr y := by
    -- Likewise on the right.
    simpa [hom, inrHom] using
      ConcreteCategory.congr_hom (Limits.coprod.inr_desc inlHom inrHom) y
  refine ⟨
    { hom := hom
      inv := inv
      hom_inv_id := ?_
      inv_hom_id := ?_ }⟩
  · -- Equality on a coproduct is checked on the two canonical summands.
    apply Limits.coprod.hom_ext
    · calc
        Limits.coprod.inl ≫ hom ≫ inv = inlHom ≫ inv := by
          simpa [hom] using
            (Limits.coprod.inl_desc (inlHom ≫ inv) (inrHom ≫ inv))
        _ = Limits.coprod.inl := hinl
    · calc
        Limits.coprod.inr ≫ hom ≫ inv = inrHom ≫ inv := by
          simpa [hom] using
            (Limits.coprod.inr_desc (inlHom ≫ inv) (inrHom ≫ inv))
        _ = Limits.coprod.inr := hinr
  · -- On the sum action, the two cases are explicit.
    apply Action.hom_ext
    apply FintypeCat.hom_ext
    intro z
    cases z with
    | inl x =>
        simpa [inv] using hhom_inl x
    | inr y =>
        simpa [inv] using hhom_inr y

/-- Helper for Exercise 13-13.1-15: fixed points of a binary coproduct split as the disjoint sum
of the fixed points on the two summands. -/
lemma card_fixedPoints_coprod {X Y : Action FintypeCat G} (H : Subgroup G) :
    Nat.card (MulAction.fixedPoints H (X ⨿ Y).V) =
      Nat.card (MulAction.fixedPoints H X.V) + Nat.card (MulAction.fixedPoints H Y.V) := by
  let S : Action FintypeCat G :=
    Action.FintypeCat.ofMulAction G (FintypeCat.of (X.V.obj ⊕ Y.V.obj))
  have hIso : IsIsomorphic (X ⨿ Y) S := coprod_sum_action_isomorphic (X := X) (Y := Y)
  have hsum :
      Nat.card (MulAction.fixedPoints H S.V) =
        Nat.card (MulAction.fixedPoints H X.V ⊕ MulAction.fixedPoints H Y.V) := by
    -- A fixed point of the sum action is exactly a fixed point in one summand or the other.
    refine Nat.card_congr
      { toFun := fun z ↦
          match z with
          | ⟨Sum.inl x, hx⟩ =>
              Sum.inl ⟨x, by
                rw [MulAction.mem_fixedPoints] at hx ⊢
                intro h
                have hh : (h : G) • (Sum.inl x : X.V.obj ⊕ Y.V.obj) = Sum.inl x := hx h
                injection hh⟩
          | ⟨Sum.inr y, hy⟩ =>
              Sum.inr ⟨y, by
                rw [MulAction.mem_fixedPoints] at hy ⊢
                intro h
                have hh : (h : G) • (Sum.inr y : X.V.obj ⊕ Y.V.obj) = Sum.inr y := hy h
                injection hh⟩
        invFun := fun z ↦
          match z with
          | Sum.inl x =>
              ⟨Sum.inl x.1, by
                rw [MulAction.mem_fixedPoints]
                intro h
                change (Sum.inl ((h : G) • x.1) : X.V.obj ⊕ Y.V.obj) = Sum.inl x.1
                exact congrArg Sum.inl ((MulAction.mem_fixedPoints.mp x.2) h)⟩
          | Sum.inr y =>
              ⟨Sum.inr y.1, by
                rw [MulAction.mem_fixedPoints]
                intro h
                change (Sum.inr ((h : G) • y.1) : X.V.obj ⊕ Y.V.obj) = Sum.inr y.1
                exact congrArg Sum.inr ((MulAction.mem_fixedPoints.mp y.2) h)⟩
        left_inv := by
          intro z
          cases z with
          | mk val hval =>
              cases val <;> rfl
        right_inv := by
          intro z
          cases z <;> rfl }
  -- Transport fixed points across the explicit coproduct/sum action isomorphism.
  calc
    Nat.card (MulAction.fixedPoints H (X ⨿ Y).V) =
        Nat.card (MulAction.fixedPoints H S.V) := by
          exact card_fixedPoints_eq_of_isomorphic (X := X ⨿ Y) (Y := S) hIso H
    _ = Nat.card (MulAction.fixedPoints H X.V ⊕ MulAction.fixedPoints H Y.V) := hsum
    _ = Nat.card (MulAction.fixedPoints H X.V) + Nat.card (MulAction.fixedPoints H Y.V) :=
          Nat.card_sum

/-- Helper for Exercise 13-13.1-15: the trivial subgroup fixes every point. -/
lemma card_fixedPoints_bot {α : Type*} [MulAction G α] [Finite α] :
    Nat.card (MulAction.fixedPoints (⊥ : Subgroup G) α) = Nat.card α := by
  classical
  -- The bottom subgroup contains only `1`, so its fixed-point subtype is all of `α`.
  refine Nat.card_congr
    { toFun := fun x ↦ x.1
      invFun := fun a ↦
        ⟨a, by
          rw [MulAction.mem_fixedPoints]
          intro h
          have h1 : h = 1 := Subsingleton.elim _ _
          simp [h1]⟩
      left_inv := by
        intro x
        rfl
      right_inv := by
        intro a
        rfl }

/-- Helper for Exercise 13-13.1-15: an inclusion of finite subgroups with equal cardinalities is
an equality. -/
lemma subgroup_eq_of_le_of_natCard_eq {H K : Subgroup G} [Finite G]
    (hHK : H ≤ K) (hcard : Nat.card H = Nat.card K) :
    H = K := by
  classical
  letI : Fintype H := Fintype.ofFinite H
  letI : Fintype K := Fintype.ofFinite K
  let f : H → K := fun h ↦ ⟨h, hHK h.2⟩
  have hf_inj : Function.Injective f := by
    intro a b hab
    cases a
    cases b
    cases hab
    rfl
  have hf_surj : Function.Surjective f := by
    have hbij := (Fintype.bijective_iff_injective_and_card f).2 ⟨hf_inj, by
      simpa [Nat.card_eq_fintype_card] using hcard⟩
    exact hbij.2
  ext k
  constructor
  · intro hk
    exact hHK hk
  · intro hk
    rcases hf_surj ⟨k, hk⟩ with ⟨h, hh⟩
    have hk_eq : (h : G) = k := by
      simpa [f] using congrArg Subtype.val hh
    simpa [hk_eq] using h.2

/-- Helper for Exercise 13-13.1-15: fixed points are unchanged when an action is restricted along
the quotient map to the image subgroup through which it factors. -/
lemma card_fixedPoints_compHom_map
    {A B α : Type*} [Group A] [Group B] [MulAction B α] [Finite α]
    (φ : A →* B) (H : Subgroup A) :
    letI : MulAction A α := MulAction.compHom α φ
    Nat.card (MulAction.fixedPoints H α) = Nat.card (MulAction.fixedPoints (H.map φ) α) := by
  classical
  letI : MulAction A α := MulAction.compHom α φ
  -- A point is fixed by `H` for the pulled-back action exactly when it is fixed by `H.map φ`.
  refine Nat.card_congr
    { toFun := fun x ↦
        ⟨x.1, by
          rw [MulAction.mem_fixedPoints]
          intro b
          rcases b with ⟨b, hb⟩
          rcases hb with ⟨a, ha, rfl⟩
          exact MulAction.mem_fixedPoints.mp x.2 ⟨a, ha⟩⟩
      invFun := fun x ↦
        ⟨x.1, by
          rw [MulAction.mem_fixedPoints]
          intro a
          exact MulAction.mem_fixedPoints.mp x.2 ⟨φ a, ⟨a, a.2, rfl⟩⟩⟩
      left_inv := by
        intro x
        rfl
      right_inv := by
        intro x
        rfl }

/-- Helper for Exercise 13-13.1-15: an equivariant bijection between two finite underlying
`G`-sets yields an isomorphism of the bundled finite actions. -/
lemma isomorphic_of_equivariant_equiv
    {α β : Type v} [MulAction G α] [Finite α] [MulAction G β] [Finite β]
    (e : α ≃ β)
    (he : ∀ g : G, ∀ a : α, e ((g : G) • a) = (g : G) • e a) :
    IsIsomorphic (Action.FintypeCat.ofMulAction G (FintypeCat.of α))
      (Action.FintypeCat.ofMulAction G (FintypeCat.of β)) := by
  classical
  -- Package the equivariant underlying bijection as an isomorphism in `Action FintypeCat G`.
  refine ⟨Action.mkIso
    { hom := FintypeCat.homMk (fun a : α ↦ e a)
      inv := FintypeCat.homMk (fun b : β ↦ e.symm b)
      hom_inv_id := by
        ext a
        simp
      inv_hom_id := by
        ext b
        simp } ?_⟩
  intro g
  ext a
  exact he g a

/-- Helper for Exercise 13-13.1-15: the orbit of a point is an invariant `SubMulAction`. -/
lemma smul_mem_orbit_of_mem_orbit (x y : X.V) (g : G)
    (hy : y ∈ MulAction.orbit G x) :
    (g : G) • y ∈ MulAction.orbit G x := by
  -- Rewrite the orbit-membership witness and repackage it after multiplying by `g`.
  rcases MulAction.mem_orbit_iff.mp hy with ⟨h, rfl⟩
  exact ⟨g * h, by simp [mul_smul]⟩

/-- Helper for Exercise 13-13.1-15: the orbit of a point, viewed as a `SubMulAction`. -/
def orbit_subaction (x : X.V) : SubMulAction G X.V :=
  { carrier := MulAction.orbit G x
    smul_mem' := fun g {y} hy => smul_mem_orbit_of_mem_orbit (X := X) x y g hy }

/-- Helper for Exercise 13-13.1-15: splitting a finite `G`-set into the orbit of `x` and its
invariant complement gives a coproduct decomposition in `Action FintypeCat G`. -/
lemma orbit_subaction_compl_iso_at_point (x : X.V) :
    let O : SubMulAction G X.V := orbit_subaction (X := X) x
    let C : SubMulAction G X.V := Oᶜ
    IsIsomorphic X
      (Action.FintypeCat.ofMulAction G (FintypeCat.of O) ⨿
        Action.FintypeCat.ofMulAction G (FintypeCat.of C)) := by
  classical
  let O : SubMulAction G X.V := orbit_subaction (X := X) x
  let C : SubMulAction G X.V := Oᶜ
  let S : Action FintypeCat G := Action.FintypeCat.ofMulAction G (FintypeCat.of (O ⊕ C))
  let eSelf : X ≅ Action.FintypeCat.ofMulAction G (FintypeCat.of X.V.obj) :=
    Action.mkIso (Iso.refl _) fun g ↦ by
      ext a
      rfl
  let eSplit :
      IsIsomorphic (Action.FintypeCat.ofMulAction G (FintypeCat.of X.V.obj)) S :=
    by
      letI : DecidablePred fun z : X.V ↦ z ∈ (O : Set X.V) := Classical.decPred _
      simpa [S, C] using
        (isomorphic_of_equivariant_equiv
          (G := G) (α := X.V.obj) (β := O ⊕ C)
          ((Equiv.Set.sumCompl (O : Set X.V)).symm) fun g a ↦ by
          -- The orbit carrier is invariant, so the sum-complement equivalence commutes with the
          -- componentwise action on the sum.
          by_cases ha : a ∈ (O : Set X.V)
          · have hga : (g : G) • a ∈ (O : Set X.V) := O.smul_mem (g : G) ha
            rw [Equiv.Set.sumCompl_symm_apply_of_mem hga, Equiv.Set.sumCompl_symm_apply_of_mem ha]
            rfl
          · have hga : (g : G) • a ∉ (O : Set X.V) := by
              intro hg
              exact ha (by simpa using O.smul_mem (g⁻¹ : G) hg)
            rw [
              Equiv.Set.sumCompl_symm_apply_of_notMem hga,
              Equiv.Set.sumCompl_symm_apply_of_notMem ha
            ]
            rfl)
  rcases eSplit with ⟨eSplit⟩
  rcases coprod_sum_action_isomorphic
      (X := Action.FintypeCat.ofMulAction G (FintypeCat.of O))
      (Y := Action.FintypeCat.ofMulAction G (FintypeCat.of C)) with ⟨eCoprod⟩
  -- Route correction: pass through the canonical sum-action owner before returning to the actual
  -- categorical coproduct.
  exact ⟨eSelf.trans (eSplit.trans eCoprod.symm)⟩

/-- Helper for Exercise 13-13.1-15: orbit subactions with the same stabilizer are isomorphic. -/
lemma orbit_subaction_isomorphic_of_stabilizer_eq [Finite G]
    {Y : Action FintypeCat.{v} G}
    (x : X.V) (y : Y.V)
    (hstab : MulAction.stabilizer G x = MulAction.stabilizer G y) :
    let OX : SubMulAction G X.V := orbit_subaction (X := X) x
    let OY : SubMulAction G Y.V := orbit_subaction (X := Y) y
    IsIsomorphic (Action.FintypeCat.ofMulAction G (FintypeCat.of OX))
      (Action.FintypeCat.ofMulAction G (FintypeCat.of OY)) := by
  classical
  let OX : SubMulAction G X.V := orbit_subaction (X := X) x
  let OY : SubMulAction G Y.V := orbit_subaction (X := Y) y
  let ϕx : OX ≃ G ⧸ MulAction.stabilizer G x := MulAction.orbitEquivQuotientStabilizer G x
  let ϕy : OY ≃ G ⧸ MulAction.stabilizer G y := MulAction.orbitEquivQuotientStabilizer G y
  let qeq : G ⧸ MulAction.stabilizer G x ≃ G ⧸ MulAction.stabilizer G y :=
    Subgroup.quotientEquivOfEq hstab
  let e : OX ≃ OY := ϕx.trans (qeq.trans ϕy.symm)
  have hϕx :
      ∀ g : G, ∀ a : OX, ϕx ((g : G) • a) = (g : G) • ϕx a := by
    intro g a
    have hsymm : ϕx.symm ((g : G) • ϕx a) = (g : G) • a := by
      apply Subtype.ext
      calc
        MulAction.ofQuotientStabilizer G x ((g : G) • ϕx a)
            = (g : G) • MulAction.ofQuotientStabilizer G x (ϕx a) := by
                simpa using (MulAction.ofQuotientStabilizer_smul G x g (ϕx a))
        _ = (g : G) • a := by
              congr 1
              exact congrArg Subtype.val (Equiv.symm_apply_apply ϕx a)
    have hcongr := congrArg ϕx hsymm
    simpa using hcongr.symm
  have hqeq :
      ∀ g : G, ∀ q : G ⧸ MulAction.stabilizer G x, qeq ((g : G) • q) = (g : G) • qeq q := by
    intro g q
    refine Quotient.inductionOn' q ?_
    intro a
    simp [qeq, Subgroup.quotientEquivOfEq_mk]
  have hϕy_symm :
      ∀ g : G, ∀ q : G ⧸ MulAction.stabilizer G y,
        ϕy.symm ((g : G) • q) = (g : G) • ϕy.symm q := by
    intro g q
    ext
    simpa [ϕy, MulAction.orbitEquivQuotientStabilizer_symm_apply] using
      (MulAction.ofQuotientStabilizer_smul G y g q)
  -- Route correction: compare the two orbit subactions through the common quotient set determined
  -- by the shared stabilizer, rather than trying to bundle the quotient action itself.
  refine isomorphic_of_equivariant_equiv (G := G) (α := OX) (β := OY) e ?_
  intro g a
  calc
    e ((g : G) • a) = ϕy.symm (qeq (ϕx ((g : G) • a))) := rfl
    _ = ϕy.symm (qeq ((g : G) • ϕx a)) := by rw [hϕx]
    _ = ϕy.symm ((g : G) • qeq (ϕx a)) := by rw [hqeq]
    _ = (g : G) • ϕy.symm (qeq (ϕx a)) := by rw [hϕy_symm]
    _ = (g : G) • e a := rfl

/-- Helper for Exercise 13-13.1-15: the complement of the orbit subaction at `x` has strictly
smaller cardinality than the whole action. -/
lemma orbit_subaction_compl_natCard_lt (x : X.V) :
    let O : SubMulAction G X.V := orbit_subaction (X := X) x
    let C : SubMulAction G X.V := Oᶜ
    Nat.card C < Nat.card X.V := by
  classical
  let O : SubMulAction G X.V := orbit_subaction (X := X) x
  let C : SubMulAction G X.V := Oᶜ
  let OX : Action FintypeCat G := Action.FintypeCat.ofMulAction G (FintypeCat.of O)
  let CX : Action FintypeCat G := Action.FintypeCat.ofMulAction G (FintypeCat.of C)
  have hsplit :
      Nat.card X.V = Nat.card O + Nat.card C := by
    -- Compare bottom-subgroup fixed points across the orbit/complement splitting.
    calc
      Nat.card X.V = Nat.card (MulAction.fixedPoints (⊥ : Subgroup G) X.V) := by
        symm
        exact card_fixedPoints_bot (G := G) (α := X.V)
      _ = Nat.card (MulAction.fixedPoints (⊥ : Subgroup G) (OX ⨿ CX).V) := by
            exact
              card_fixedPoints_eq_of_isomorphic (X := X) (Y := OX ⨿ CX)
                (by simpa [OX, CX, O, C] using orbit_subaction_compl_iso_at_point (X := X) x) ⊥
      _ = Nat.card (MulAction.fixedPoints (⊥ : Subgroup G) OX.V) +
            Nat.card (MulAction.fixedPoints (⊥ : Subgroup G) CX.V) := by
            exact card_fixedPoints_coprod (G := G) (X := OX) (Y := CX) ⊥
      _ = Nat.card O + Nat.card C := by
            rw [card_fixedPoints_bot (G := G) (α := OX.V), card_fixedPoints_bot (G := G) (α := CX.V)]
            rfl
  have hO_nonempty : Nonempty O := by
    refine ⟨⟨x, ?_⟩⟩
    exact ⟨1, by simp⟩
  have hO_pos : 0 < Nat.card O := Finite.card_pos_iff.mpr hO_nonempty
  -- The orbit summand is nonempty, so removing it strictly decreases the cardinality.
  have hlt : Nat.card C < Nat.card O + Nat.card C := by
    omega
  calc
    Nat.card C < Nat.card O + Nat.card C := hlt
    _ = Nat.card X.V := hsplit.symm

/-- Helper for Exercise 13-13.1-15: a maximal stabilizer on `X` is realized by a point of `Y`
with the same stabilizer whenever all subgroup fixed-point counts agree. -/
lemma exists_point_with_stabilizer_eq_of_maximal
    [Finite G]
    (x : X.V)
    (hmax :
      ∀ x' : X.V,
        Nat.card (MulAction.stabilizer G x') ≤ Nat.card (MulAction.stabilizer G x))
    (hfixed :
      ∀ H : Subgroup G,
        Nat.card (MulAction.fixedPoints H X.V) = Nat.card (MulAction.fixedPoints H Y.V)) :
    ∃ y : Y.V, MulAction.stabilizer G y = MulAction.stabilizer G x := by
  classical
  let H : Subgroup G := MulAction.stabilizer G x
  have hx_fixed : x ∈ MulAction.fixedPoints H X.V := by
    -- A point is fixed by its own stabilizer.
    rw [MulAction.mem_fixedPoints]
    intro h
    exact h.2
  have hHX_ne_zero : Nat.card (MulAction.fixedPoints H X.V) ≠ 0 := by
    exact Nat.card_ne_zero.mpr ⟨⟨x, hx_fixed⟩, by infer_instance⟩
  have hHY_ne_zero : Nat.card (MulAction.fixedPoints H Y.V) ≠ 0 := by
    rw [← hfixed H]
    exact hHX_ne_zero
  obtain ⟨⟨y, hy_fixed⟩⟩ := Nat.card_ne_zero.mp hHY_ne_zero |>.1
  let K : Subgroup G := MulAction.stabilizer G y
  have hHK : H ≤ K := by
    -- Any point of `Y` fixed by `H` has stabilizer containing `H`.
    intro h hh
    exact MulAction.mem_fixedPoints.mp hy_fixed ⟨h, hh⟩
  have hyK_fixed : y ∈ MulAction.fixedPoints K Y.V := by
    rw [MulAction.mem_fixedPoints]
    intro h
    exact h.2
  have hKY_ne_zero : Nat.card (MulAction.fixedPoints K Y.V) ≠ 0 := by
    exact Nat.card_ne_zero.mpr ⟨⟨y, hyK_fixed⟩, by infer_instance⟩
  have hKX_ne_zero : Nat.card (MulAction.fixedPoints K X.V) ≠ 0 := by
    rw [hfixed K]
    exact hKY_ne_zero
  obtain ⟨⟨x', hx'_fixed⟩⟩ := Nat.card_ne_zero.mp hKX_ne_zero |>.1
  have hKx' : K ≤ MulAction.stabilizer G x' := by
    -- A point fixed by `K` has stabilizer containing `K`.
    intro h hh
    exact MulAction.mem_fixedPoints.mp hx'_fixed ⟨h, hh⟩
  have hcard_H_le_K : Nat.card H ≤ Nat.card K := by
    exact Nat.card_le_card_of_injective
      (fun h : H ↦ (⟨(h : G), hHK h.2⟩ : K)) fun a b hab ↦ by
      apply Subtype.ext
      exact congrArg (fun z : K => (z : G)) hab
  have hcard_K_le_H : Nat.card K ≤ Nat.card H := by
    exact (Nat.card_le_card_of_injective
      (fun h : K ↦ (⟨(h : G), hKx' h.2⟩ : MulAction.stabilizer G x')) fun a b hab ↦ by
        apply Subtype.ext
        exact congrArg (fun z : MulAction.stabilizer G x' => (z : G)) hab).trans
        (by simpa [H] using hmax x')
  have hcardHK : Nat.card H = Nat.card K := le_antisymm hcard_H_le_K hcard_K_le_H
  use y
  -- Equality of cardinalities upgrades the inclusion `H ≤ K` to equality.
  exact (subgroup_eq_of_le_of_natCard_eq hHK hcardHK).symm

/-- Helper for Exercise 13-13.1-15: after splitting off the same common action summand from both
sides, the remaining complements still have matching subgroup fixed-point counts. -/
lemma cancel_common_quotient_marks
    {Q X' Y' : Action FintypeCat.{v} G}
    (eX : IsIsomorphic X (Q ⨿ X'))
    (eY : IsIsomorphic Y (Q ⨿ Y'))
    (hfixed :
      ∀ K : Subgroup G,
        Nat.card (MulAction.fixedPoints K X.V) = Nat.card (MulAction.fixedPoints K Y.V)) :
    ∀ K : Subgroup G,
      Nat.card (MulAction.fixedPoints K X'.V) = Nat.card (MulAction.fixedPoints K Y'.V) := by
  intro K
  have hXsplit :
      Nat.card (MulAction.fixedPoints K X.V) =
        Nat.card (MulAction.fixedPoints K Q.V) +
          Nat.card (MulAction.fixedPoints K X'.V) := by
    calc
      Nat.card (MulAction.fixedPoints K X.V) =
          Nat.card (MulAction.fixedPoints K ((Q ⨿ X').V)) := by
            exact card_fixedPoints_eq_of_isomorphic (X := X) (Y := Q ⨿ X') eX K
      _ = Nat.card (MulAction.fixedPoints K Q.V) +
            Nat.card (MulAction.fixedPoints K X'.V) := card_fixedPoints_coprod K
  have hYsplit :
      Nat.card (MulAction.fixedPoints K Y.V) =
        Nat.card (MulAction.fixedPoints K Q.V) +
          Nat.card (MulAction.fixedPoints K Y'.V) := by
    calc
      Nat.card (MulAction.fixedPoints K Y.V) =
          Nat.card (MulAction.fixedPoints K ((Q ⨿ Y').V)) := by
            exact card_fixedPoints_eq_of_isomorphic (X := Y) (Y := Q ⨿ Y') eY K
      _ = Nat.card (MulAction.fixedPoints K Q.V) +
            Nat.card (MulAction.fixedPoints K Y'.V) := card_fixedPoints_coprod K
  -- Cancel the common quotient contribution on both sides.
  have hsum :
      Nat.card (MulAction.fixedPoints K Q.V) +
          Nat.card (MulAction.fixedPoints K X'.V) =
        Nat.card (MulAction.fixedPoints K Q.V) +
          Nat.card (MulAction.fixedPoints K Y'.V) := by
    calc
      Nat.card (MulAction.fixedPoints K Q.V) +
          Nat.card (MulAction.fixedPoints K X'.V) =
          Nat.card (MulAction.fixedPoints K X.V) := hXsplit.symm
      _ = Nat.card (MulAction.fixedPoints K Y.V) := hfixed K
      _ = Nat.card (MulAction.fixedPoints K Q.V) +
          Nat.card (MulAction.fixedPoints K Y'.V) := hYsplit
  exact Nat.add_left_cancel hsum

/-- Helper for Exercise 13-13.1-15: for a finite acting group, equality of fixed-point counts on
all subgroups forces an equivariant bijection. -/
theorem finite_group_isomorphic_of_equal_subgroup_marks
    {G : Type u} [Group G] [Finite G]
    (X Y : Action FintypeCat.{v} G)
    (hfixed :
      ∀ H : Subgroup G,
        Nat.card (MulAction.fixedPoints H X.V) = Nat.card (MulAction.fixedPoints H Y.V)) :
    IsIsomorphic X Y := by
  classical
  let P : ℕ → Prop := fun n ↦
    ∀ (X Y : Action FintypeCat.{v} G),
      Nat.card X.V = n →
      (∀ H : Subgroup G,
        Nat.card (MulAction.fixedPoints H X.V) = Nat.card (MulAction.fixedPoints H Y.V)) →
      IsIsomorphic X Y
  have hstrong : ∀ n : ℕ, P n := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih X Y hXcard hfixed
    have hcardXY : Nat.card X.V = Nat.card Y.V := by
      -- The bottom subgroup fixes every point, so the fixed-point hypothesis also matches the
      -- underlying cardinalities.
      calc
        Nat.card X.V = Nat.card (MulAction.fixedPoints (⊥ : Subgroup G) X.V) := by
          symm
          exact card_fixedPoints_bot (G := G) (α := X.V)
        _ = Nat.card (MulAction.fixedPoints (⊥ : Subgroup G) Y.V) := hfixed ⊥
        _ = Nat.card Y.V := card_fixedPoints_bot (G := G) (α := Y.V)
    by_cases hn : n = 0
    · have hYcard : Nat.card Y.V = 0 := by
        calc
          Nat.card Y.V = Nat.card X.V := hcardXY.symm
          _ = 0 := by simpa [hn] using hXcard
      have hXempty : IsEmpty X.V := (Finite.card_eq_zero_iff).1 <| by simpa [hn] using hXcard
      have hYempty : IsEmpty Y.V := (Finite.card_eq_zero_iff).1 hYcard
      let eSelfX : X ≅ Action.FintypeCat.ofMulAction G (FintypeCat.of X.V.obj) :=
        Action.mkIso (Iso.refl _) fun g ↦ by
          ext a
          rfl
      let eSelfY : Y ≅ Action.FintypeCat.ofMulAction G (FintypeCat.of Y.V.obj) :=
        Action.mkIso (Iso.refl _) fun g ↦ by
          ext a
          rfl
      have hEmpty :
          IsIsomorphic (Action.FintypeCat.ofMulAction G (FintypeCat.of X.V.obj))
            (Action.FintypeCat.ofMulAction G (FintypeCat.of Y.V.obj)) := by
        let _ : IsEmpty X.V.obj := hXempty
        let _ : IsEmpty Y.V.obj := hYempty
        -- Route correction: in the zero-cardinality case, both bundled actions are the unique
        -- empty action, so an equivariant equivalence is immediate.
        exact isomorphic_of_equivariant_equiv
          (G := G)
          (α := X.V.obj)
          (β := Y.V.obj)
          (Equiv.equivOfIsEmpty _ _)
          (fun g a ↦ by exact isEmptyElim a)
      rcases hEmpty with ⟨eEmpty⟩
      exact ⟨eSelfX.trans (eEmpty.trans eSelfY.symm)⟩
    · have hX_nonempty : Nonempty X.V := by
        have hX_pos : 0 < Nat.card X.V := by
          exact Nat.pos_of_ne_zero (hXcard.symm ▸ hn)
        exact Finite.card_pos_iff.mp hX_pos
      obtain ⟨x, hmax⟩ := Finite.exists_max fun x' : X.V ↦ Nat.card (MulAction.stabilizer G x')
      obtain ⟨y, hyStab⟩ :=
        exists_point_with_stabilizer_eq_of_maximal (X := X) (Y := Y) x hmax hfixed
      let H : Subgroup G := MulAction.stabilizer G x
      let OX : SubMulAction G X.V := orbit_subaction (X := X) x
      let CX : SubMulAction G X.V := OXᶜ
      let OXA : Action FintypeCat G := Action.FintypeCat.ofMulAction G (FintypeCat.of OX)
      let CXA : Action FintypeCat G := Action.FintypeCat.ofMulAction G (FintypeCat.of CX)
      let OY : SubMulAction G Y.V := orbit_subaction (X := Y) y
      let CY : SubMulAction G Y.V := OYᶜ
      let OYA : Action FintypeCat G := Action.FintypeCat.ofMulAction G (FintypeCat.of OY)
      let CYA : Action FintypeCat G := Action.FintypeCat.ofMulAction G (FintypeCat.of CY)
      have hSplitX : IsIsomorphic X (OXA ⨿ CXA) := by
        -- Split `X` into the orbit of `x` and its invariant complement.
        simpa [OXA, CXA, OX, CX] using orbit_subaction_compl_iso_at_point (X := X) x
      have hSplitY : IsIsomorphic Y (OYA ⨿ CYA) := by
        -- Do the same for the matching point `y` on the `Y` side.
        simpa [OYA, CYA, OY, CY] using orbit_subaction_compl_iso_at_point (X := Y) y
      have hOrbitXY : IsIsomorphic OXA OYA := by
        -- Equal stabilizers identify the two transitive orbit summands.
        simpa [OXA, OYA, OX, OY] using
          orbit_subaction_isomorphic_of_stabilizer_eq (X := X) (Y := Y) x y hyStab.symm
      have hYquot : IsIsomorphic Y (OXA ⨿ CYA) := by
        rcases hSplitY with ⟨eSplitY⟩
        rcases hOrbitXY with ⟨eOrbitXY⟩
        -- Rewrite the `Y`-orbit summand to the common `X`-orbit summand before cancellation.
        exact ⟨eSplitY.trans (Limits.coprod.mapIso eOrbitXY.symm (Iso.refl _))⟩
      have hfixedCompl :
          ∀ K : Subgroup G,
            Nat.card (MulAction.fixedPoints K CXA.V) =
              Nat.card (MulAction.fixedPoints K CYA.V) := by
        -- After cancelling the common transitive quotient action, the complements still have the
        -- same Burnside marks.
        exact
          cancel_common_quotient_marks (X := X) (Y := Y) (Q := OXA)
            (X' := CXA) (Y' := CYA) hSplitX hYquot hfixed
      have hlt : Nat.card CXA.V < n := by
        -- The orbit summand is nonempty, so the complement is strictly smaller.
        have hlt' : Nat.card CX < Nat.card X.V := by
          simpa [OX, CX] using orbit_subaction_compl_natCard_lt (X := X) x
        simpa [CXA, hXcard] using hlt'
      have hRec : IsIsomorphic CXA CYA :=
        ih (Nat.card CXA.V) hlt CXA CYA rfl hfixedCompl
      rcases hSplitX with ⟨eXquot⟩
      rcases hYquot with ⟨eYquot⟩
      rcases hRec with ⟨eRec⟩
      -- Reassemble the common quotient summand with the recursively matched complements.
      exact ⟨eXquot.trans ((Limits.coprod.mapIso (Iso.refl OXA) eRec).trans eYquot.symm)⟩
  exact hstrong (Nat.card X.V) X Y rfl hfixed

-- Proof sketch: an equivariant bijection carries `H`-fixed points of `X` bijectively onto
-- `H`-fixed points of `Y`. For the converse, compare the Burnside marks of the two finite `G`-sets;
-- equality of all subgroup fixed-point counts forces equality in the Burnside ring and hence an
-- equivariant bijection.
/-- A finite `G`-set isomorphism is equivalent to equality of subgroup fixed-point counts. -/
theorem isomorphic_iff_card_fixedPoints_eq_forall_subgroup :
    IsIsomorphic X Y ↔
      ∀ H : Subgroup G,
        Nat.card (MulAction.fixedPoints H X.V) = Nat.card (MulAction.fixedPoints H Y.V) := by
  constructor
  · intro hIso H
    exact card_fixedPoints_eq_of_isomorphic (X := X) (Y := Y) hIso H
  · intro hfixed
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q X.V :=
      MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
    letI : MulAction Q Y.V :=
      MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
    letI : Finite Q := by
      change Finite (paired_permutation_hom (X := X) (Y := Y)).range
      infer_instance
    let XQ : Action FintypeCat Q := Action.FintypeCat.ofMulAction Q X.V
    let YQ : Action FintypeCat Q := Action.FintypeCat.ofMulAction Q Y.V
    have hfixedQ :
        ∀ K : Subgroup Q,
          Nat.card (MulAction.fixedPoints K XQ.V) =
            Nat.card (MulAction.fixedPoints K YQ.V) := by
      intro K
      let H : Subgroup G := K.comap (paired_permutation_range_lift (X := X) (Y := Y))
      have hmap :
          H.map (paired_permutation_range_lift (X := X) (Y := Y)) = K := by
        ext q
        constructor
        · intro hq
          rcases hq with ⟨g, hg, rfl⟩
          exact hg
        · intro hq
          rcases q.2 with ⟨g, hg⟩
          have hg' : paired_permutation_range_lift (X := X) (Y := Y) g = q := by
            apply Subtype.ext
            simpa [paired_permutation_range_lift] using hg
          exact ⟨g, by simpa [H, hg'] using hq, hg'⟩
      have hdescX :=
        card_fixedPoints_compHom_map (α := XQ.V)
          (paired_permutation_range_lift (X := X) (Y := Y)) H
      have hdescY :=
        card_fixedPoints_compHom_map (α := YQ.V)
          (paired_permutation_range_lift (X := X) (Y := Y)) H
      calc
        Nat.card (MulAction.fixedPoints K XQ.V)
            = Nat.card
                (MulAction.fixedPoints
                  (H.map (paired_permutation_range_lift (X := X) (Y := Y))) XQ.V) := by
                    rw [hmap]
        _ = Nat.card (MulAction.fixedPoints H X.V) := by
              symm
              simpa [Q, XQ, H, paired_permutation_range_lift, paired_permutation_hom,
                paired_permutation_range_left_hom, MulAction.compHom_smul_def] using hdescX
        _ = Nat.card (MulAction.fixedPoints H Y.V) := hfixed H
        _ = Nat.card
              (MulAction.fixedPoints
                (H.map (paired_permutation_range_lift (X := X) (Y := Y))) YQ.V) := by
              simpa [Q, YQ, H, paired_permutation_range_lift, paired_permutation_hom,
                paired_permutation_range_right_hom, MulAction.compHom_smul_def] using hdescY
        _ = Nat.card (MulAction.fixedPoints K YQ.V) := by
              rw [hmap]
    have hQIso : IsIsomorphic XQ YQ :=
      finite_group_isomorphic_of_equal_subgroup_marks XQ YQ hfixedQ
    rcases hQIso with ⟨eQ⟩
    have eG : X ≅ Y := by
      refine Action.mkIso
        { hom := eQ.hom.hom
          inv := eQ.inv.hom
          hom_inv_id := by
            ext x
            exact Iso.hom_inv_id_apply eQ x
          inv_hom_id := by
            ext y
            exact Iso.inv_hom_id_apply eQ y } ?_
      intro g
      simpa [Q, XQ, YQ, paired_permutation_range_lift, paired_permutation_hom,
        paired_permutation_range_left_hom, paired_permutation_range_right_hom] using
        eQ.hom.comm (paired_permutation_range_lift (X := X) (Y := Y) g)
    exact ⟨eG⟩

-- Proof sketch: clause (i) is the definition of `WeaklyIsomorphic`. Identify
-- `Nat.card (MulAction.fixedPoints H X)` with the dimension of the `H`-invariants in the
-- restricted permutation representation, then apply the rational-character criterion on cyclic
-- subgroups.
/-- Helper for Exercise 13-13.1-15: equality of cyclic subgroup fixed-point counts on `G`
descends to the same equality on the common finite permutation image. -/
lemma cyclic_fixedpoint_counts_descend_to_paired_permutation_range
    (hfixed :
      ∀ (H : Subgroup G) (_ : IsCyclic H),
        Nat.card (MulAction.fixedPoints H X.V) =
          Nat.card (MulAction.fixedPoints H Y.V)) :
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q X.V :=
      MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
    letI : MulAction Q Y.V :=
      MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
    ∀ (K : Subgroup Q) (_ : IsCyclic K),
      Nat.card (MulAction.fixedPoints K X.V) =
        Nat.card (MulAction.fixedPoints K Y.V) := by
  let Q := paired_permutation_range (X := X) (Y := Y)
  letI : MulAction Q X.V :=
    MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
  letI : MulAction Q Y.V :=
    MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
  change ∀ (K : Subgroup Q) (_ : IsCyclic K),
      Nat.card (MulAction.fixedPoints K X.V) =
        Nat.card (MulAction.fixedPoints K Y.V)
  intro K hK
  -- Choose a generator of `K`, lift it to `G`, and compare fixed points through the descended
  -- action of the cyclic subgroup it generates upstairs.
  rcases isCyclic_iff_exists_zpowers_eq_top.mp hK with ⟨k, hk⟩
  rcases (k : Q).2 with ⟨g, hg⟩
  have hgQ : paired_permutation_range_lift (X := X) (Y := Y) g = (k : Q) := by
    apply Subtype.ext
    simpa [paired_permutation_range_lift] using hg
  have hk' : Subgroup.zpowers (k : Q) = K := by
    apply le_antisymm
    · exact Subgroup.zpowers_le.2 k.2
    · intro q hq
      let qK : K := ⟨q, hq⟩
      have hqPow : qK ∈ Subgroup.zpowers k := by
        rw [hk]
        simp
      rcases hqPow with ⟨n, hn⟩
      exact ⟨n, congrArg Subtype.val hn⟩
  have hkLift :
      Subgroup.zpowers ((paired_permutation_range_lift (X := X) (Y := Y)) g) = K := by
    calc
      Subgroup.zpowers ((paired_permutation_range_lift (X := X) (Y := Y)) g)
          = Subgroup.zpowers (k : Q) := by rw [hgQ]
      _ = K := hk'
  have hkMap :
      (Subgroup.zpowers g).map (paired_permutation_range_lift (X := X) (Y := Y)) = K := by
    calc
      (Subgroup.zpowers g).map (paired_permutation_range_lift (X := X) (Y := Y))
          = Subgroup.zpowers ((paired_permutation_range_lift (X := X) (Y := Y)) g) := by
              rw [MonoidHom.map_zpowers]
      _ = K := hkLift
  have hdescX :=
    card_fixedPoints_compHom_map (α := X.V)
      (paired_permutation_range_lift (X := X) (Y := Y)) (Subgroup.zpowers g)
  have hdescY :=
    card_fixedPoints_compHom_map (α := Y.V)
      (paired_permutation_range_lift (X := X) (Y := Y)) (Subgroup.zpowers g)
  have hcyc : IsCyclic (Subgroup.zpowers g) := inferInstance
  have hG := hfixed (Subgroup.zpowers g) hcyc
  calc
    Nat.card (MulAction.fixedPoints K X.V)
        = Nat.card
            (MulAction.fixedPoints
              ((Subgroup.zpowers g).map (paired_permutation_range_lift (X := X) (Y := Y))) X.V) := by
              rw [hkMap]
    _ = Nat.card (MulAction.fixedPoints (Subgroup.zpowers g) X.V) := by
          symm
          simpa [Q, paired_permutation_range_lift, paired_permutation_hom,
            paired_permutation_range_left_hom, MulAction.compHom_smul_def] using hdescX
    _ = Nat.card (MulAction.fixedPoints (Subgroup.zpowers g) Y.V) := hG
    _ = Nat.card
          (MulAction.fixedPoints
            ((Subgroup.zpowers g).map (paired_permutation_range_lift (X := X) (Y := Y))) Y.V) := by
          simpa [Q, paired_permutation_range_lift, paired_permutation_hom,
            paired_permutation_range_right_hom, MulAction.compHom_smul_def] using hdescY
    _ = Nat.card (MulAction.fixedPoints K Y.V) := by
          rw [hkMap]

/-- Weak isomorphism is equivalent to equality of fixed-point counts on cyclic subgroups. -/
theorem weaklyIsomorphic_iff_card_fixedPoints_eq_forall_isCyclic :
    WeaklyIsomorphic X Y ↔
      ∀ (H : Subgroup G) (_ : IsCyclic H),
        Nat.card (MulAction.fixedPoints H X.V) = Nat.card (MulAction.fixedPoints H Y.V) := by
  constructor
  · rintro ⟨e⟩ H hH
    -- Compare characters at a generator of `H`, then rewrite that character value as the number of
    -- points fixed by the whole cyclic subgroup.
    rcases isCyclic_iff_exists_zpowers_eq_top.mp hH with ⟨h, hh⟩
    have hchar := congrFun (Representation.char_iso (Representation.equivOfIso e)) (h : G)
    have hnatG : (MulAction.fixedBy X.V (h : G)).ncard = (MulAction.fixedBy Y.V (h : G)).ncard := by
      rw [Representation.ofMulAction_character_eq_ncard_fixedBy,
        Representation.ofMulAction_character_eq_ncard_fixedBy] at hchar
      exact_mod_cast hchar
    have hnatH : (MulAction.fixedBy X.V h).ncard = (MulAction.fixedBy Y.V h).ncard := by
      calc
        (MulAction.fixedBy X.V h).ncard = (MulAction.fixedBy X.V (h : G)).ncard := by
          exact congrArg Set.ncard (by ext x; rfl)
        _ = (MulAction.fixedBy Y.V (h : G)).ncard := hnatG
        _ = (MulAction.fixedBy Y.V h).ncard := by
          exact congrArg Set.ncard (by ext x; rfl)
    have htopX :
        Nat.card (MulAction.fixedPoints H X.V) =
          Nat.card (MulAction.fixedPoints (⊤ : Subgroup H) X.V) := by
      refine Nat.card_congr
        { toFun := fun x ↦
            ⟨x.1, by
              rw [MulAction.mem_fixedPoints]
              intro htop
              exact MulAction.mem_fixedPoints.mp x.2 htop.1⟩
          invFun := fun x ↦
            ⟨x.1, by
              rw [MulAction.mem_fixedPoints]
              intro h'
              exact MulAction.mem_fixedPoints.mp x.2 ⟨h', by simp⟩⟩
          left_inv := by
            intro x
            rfl
          right_inv := by
            intro x
            rfl }
    have htopY :
        Nat.card (MulAction.fixedPoints H Y.V) =
          Nat.card (MulAction.fixedPoints (⊤ : Subgroup H) Y.V) := by
      refine Nat.card_congr
        { toFun := fun x ↦
            ⟨x.1, by
              rw [MulAction.mem_fixedPoints]
              intro htop
              exact MulAction.mem_fixedPoints.mp x.2 htop.1⟩
          invFun := fun x ↦
            ⟨x.1, by
              rw [MulAction.mem_fixedPoints]
              intro h'
              exact MulAction.mem_fixedPoints.mp x.2 ⟨h', by simp⟩⟩
          left_inv := by
            intro x
            rfl
          right_inv := by
            intro x
            rfl }
    calc
      Nat.card (MulAction.fixedPoints H X.V)
          = Nat.card (MulAction.fixedPoints (⊤ : Subgroup H) X.V) := by
              exact htopX
      _ = Nat.card (MulAction.fixedPoints (Subgroup.zpowers h) X.V) := by rw [hh]
      _ = (MulAction.fixedBy X.V h).ncard := by
            exact card_fixedPoints_zpowers_eq_ncard_fixedBy (G := H) (α := X.V) h
      _ = (MulAction.fixedBy Y.V h).ncard := hnatH
      _ = Nat.card (MulAction.fixedPoints (Subgroup.zpowers h) Y.V) := by
            symm
            exact card_fixedPoints_zpowers_eq_ncard_fixedBy (G := H) (α := Y.V) h
      _ = Nat.card (MulAction.fixedPoints (⊤ : Subgroup H) Y.V) := by rw [hh]
      _ = Nat.card (MulAction.fixedPoints H Y.V) := by
            exact htopY.symm
  · intro hfixed
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q X.V :=
      MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
    letI : MulAction Q Y.V :=
      MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
    letI : Finite Q := by
      change Finite (paired_permutation_hom (X := X) (Y := Y)).range
      infer_instance
    -- Route correction: instead of descending directly to orbit counts, keep the invariant in
    -- fixed-point form on the finite image and recover character equality elementwise there.
    have hfixedQ :
        ∀ (K : Subgroup Q) (_ : IsCyclic K),
          Nat.card (MulAction.fixedPoints K X.V) =
            Nat.card (MulAction.fixedPoints K Y.V) := by
      simpa [Q] using
        cyclic_fixedpoint_counts_descend_to_paired_permutation_range (X := X) (Y := Y) hfixed
    have hcharQ :
        (Representation.ofMulAction ℂ Q X.V).character =
          (Representation.ofMulAction ℂ Q Y.V).character := by
      ext q
      have hqfixed := hfixedQ (Subgroup.zpowers q) inferInstance
      have hqnat : (MulAction.fixedBy X.V q).ncard = (MulAction.fixedBy Y.V q).ncard := by
        calc
          (MulAction.fixedBy X.V q).ncard
              = Nat.card (MulAction.fixedPoints (Subgroup.zpowers q) X.V) := by
                  symm
                  exact card_fixedPoints_zpowers_eq_ncard_fixedBy (G := Q) (α := X.V) q
          _ = Nat.card (MulAction.fixedPoints (Subgroup.zpowers q) Y.V) := hqfixed
          _ = (MulAction.fixedBy Y.V q).ncard := by
                exact card_fixedPoints_zpowers_eq_ncard_fixedBy (G := Q) (α := Y.V) q
      rw [Representation.ofMulAction_character_eq_ncard_fixedBy,
        Representation.ofMulAction_character_eq_ncard_fixedBy]
      exact_mod_cast hqnat
    have hQcard_ne : (Nat.card Q : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr Nat.card_pos.ne'
    letI : Invertible (Nat.card Q : ℂ) := invertibleOfNonzero hQcard_ne
    have heQ :=
      (Representation.character_eq_iff_nonempty_equiv
        (Representation.ofMulAction ℂ Q X.V)
        (Representation.ofMulAction ℂ Q Y.V)).mp hcharQ
    rcases heQ with ⟨eQ⟩
    have eG : (Rep.ofMulAction ℂ G X.V).ρ.Equiv (Rep.ofMulAction ℂ G Y.V).ρ := by
      -- Any intertwiner for the descended `Q`-actions is automatically `G`-equivariant after
      -- composing with the quotient map `paired_permutation_range_lift`.
      refine Representation.Equiv.mk eQ.toLinearEquiv ?_
      intro g
      simpa [Q, paired_permutation_range_lift, paired_permutation_hom,
        paired_permutation_range_left_hom, paired_permutation_range_right_hom] using
        eQ.isIntertwining' (paired_permutation_range_lift (X := X) (Y := Y) g)
    exact ⟨Rep.mkIso eG⟩

/- The orbit-count criteria use the same finite-image descent as the fixed-point criterion, but
the relevant invariant is the quotient by `orbitRel` rather than the fixed-point subtype. -/
/-- Helper for Exercise 13-13.1-15: if an action of `A` factors through a surjective homomorphism
`A →* B`, then the `A`-orbit quotient and the `B`-orbit quotient are naturally equivalent. -/
noncomputable def orbitQuotientEquivOfSurjectiveCompHom
    {A B α : Type*} [Group A] [Group B] [MulAction B α]
    (φ : A →* B) (hφ : Function.Surjective φ) :
    letI : MulAction A α := MulAction.compHom α φ
    MulAction.orbitRel.Quotient A α ≃ MulAction.orbitRel.Quotient B α := by
  letI : MulAction A α := MulAction.compHom α φ
  refine
    { toFun := Quotient.map' id ?_
      invFun := Quotient.map' id ?_
      left_inv := ?_
      right_inv := ?_ }
  · intro a b hab
    -- Every `A`-orbit step is visibly a `B`-orbit step after applying `φ`.
    rw [MulAction.orbitRel_apply, MulAction.mem_orbit_iff] at hab ⊢
    rcases hab with ⟨g, rfl⟩
    exact ⟨φ g, rfl⟩
  · intro a b hab
    -- Surjectivity of `φ` lifts each `B`-orbit step back to an `A`-orbit step.
    rw [MulAction.orbitRel_apply, MulAction.mem_orbit_iff] at hab ⊢
    rcases hab with ⟨g, hg⟩
    rcases hφ g with ⟨g', rfl⟩
    exact ⟨g', by simpa [MulAction.compHom_smul_def] using hg⟩
  · intro q
    induction q using Quotient.inductionOn'
    rfl
  · intro q
    induction q using Quotient.inductionOn'
    rfl

/-- Helper for Exercise 13-13.1-15: the orbit quotient for a subgroup of `G` agrees with the
orbit quotient for its image inside the common finite permutation image. -/
lemma card_orbitQuotient_descend (H : Subgroup G) :
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q X.V :=
      MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
    let K : Subgroup Q := H.map (paired_permutation_range_lift (X := X) (Y := Y))
    letI : MulAction K X.V := MulAction.compHom X.V K.subtype
    Nat.card (MulAction.orbitRel.Quotient H X.V) =
      Nat.card (MulAction.orbitRel.Quotient K X.V) := by
  classical
  let Q := paired_permutation_range (X := X) (Y := Y)
  letI : MulAction Q X.V :=
    MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
  let K : Subgroup Q := H.map (paired_permutation_range_lift (X := X) (Y := Y))
  let φ : H →* K := (paired_permutation_range_lift (X := X) (Y := Y)).subgroupMap H
  have hφ : Function.Surjective φ :=
    (paired_permutation_range_lift (X := X) (Y := Y)).subgroupMap_surjective H
  letI : MulAction K X.V := MulAction.compHom X.V K.subtype
  let e := orbitQuotientEquivOfSurjectiveCompHom (α := X.V) φ hφ
  -- The two orbit relations are the same because the `H`-action factors through `K`.
  simpa [K, Q, φ, paired_permutation_range_left_hom,
    paired_permutation_range_lift, paired_permutation_hom, MulAction.compHom_smul_def] using
    Nat.card_congr e

/-- Helper for Exercise 13-13.1-15: the orbit quotient for the `Y`-action also agrees with the
orbit quotient for the image subgroup inside the same common finite permutation image. -/
lemma card_orbitQuotient_descend_right (H : Subgroup G) :
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q Y.V :=
      MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
    let K : Subgroup Q := H.map (paired_permutation_range_lift (X := X) (Y := Y))
    letI : MulAction K Y.V := MulAction.compHom Y.V K.subtype
    Nat.card (MulAction.orbitRel.Quotient H Y.V) =
      Nat.card (MulAction.orbitRel.Quotient K Y.V) := by
  classical
  let Q := paired_permutation_range (X := X) (Y := Y)
  letI : MulAction Q Y.V :=
    MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
  let K : Subgroup Q := H.map (paired_permutation_range_lift (X := X) (Y := Y))
  let φ : H →* K := (paired_permutation_range_lift (X := X) (Y := Y)).subgroupMap H
  have hφ : Function.Surjective φ :=
    (paired_permutation_range_lift (X := X) (Y := Y)).subgroupMap_surjective H
  letI : MulAction K Y.V := MulAction.compHom Y.V K.subtype
  let e := orbitQuotientEquivOfSurjectiveCompHom (α := Y.V) φ hφ
  simpa [K, Q, φ, paired_permutation_range_right_hom,
    paired_permutation_range_lift, paired_permutation_hom, MulAction.compHom_smul_def] using
    Nat.card_congr e

/-- Helper for Exercise 13-13.1-15: equality of cyclic subgroup orbit counts on `G` descends to
the same equality on the common finite permutation image. -/
lemma cyclic_orbit_counts_descend_to_paired_permutation_range
    (hOrbit :
      ∀ (H : Subgroup G) (_ : IsCyclic H),
        Nat.card (MulAction.orbitRel.Quotient H X.V) =
          Nat.card (MulAction.orbitRel.Quotient H Y.V)) :
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q X.V :=
      MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
    letI : MulAction Q Y.V :=
      MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
    ∀ (K : Subgroup Q) (_ : IsCyclic K),
      Nat.card (MulAction.orbitRel.Quotient K X.V) =
        Nat.card (MulAction.orbitRel.Quotient K Y.V) := by
  let Q := paired_permutation_range (X := X) (Y := Y)
  letI : MulAction Q X.V :=
    MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
  letI : MulAction Q Y.V :=
    MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
  change ∀ (K : Subgroup Q) (_ : IsCyclic K),
      Nat.card (MulAction.orbitRel.Quotient K X.V) =
        Nat.card (MulAction.orbitRel.Quotient K Y.V)
  intro K hK
  -- Choose a generator of `K`, lift it to `G`, and compare orbit counts through the descended
  -- action of the cyclic subgroup it generates upstairs.
  rcases isCyclic_iff_exists_zpowers_eq_top.mp hK with ⟨k, hk⟩
  rcases (k : Q).2 with ⟨g, hg⟩
  have hgQ : paired_permutation_range_lift (X := X) (Y := Y) g = (k : Q) := by
    apply Subtype.ext
    simpa [paired_permutation_range_lift] using hg
  have hk' : Subgroup.zpowers (k : Q) = K := by
    apply le_antisymm
    · exact Subgroup.zpowers_le.2 k.2
    · intro q hq
      let qK : K := ⟨q, hq⟩
      have hqPow : qK ∈ Subgroup.zpowers k := by
        rw [hk]
        simp
      rcases hqPow with ⟨n, hn⟩
      exact ⟨n, congrArg Subtype.val hn⟩
  have hkLift : Subgroup.zpowers ((paired_permutation_range_lift (X := X) (Y := Y)) g) = K := by
    calc
      Subgroup.zpowers ((paired_permutation_range_lift (X := X) (Y := Y)) g)
          = Subgroup.zpowers (k : Q) := by rw [hgQ]
      _ = K := hk'
  have hkMap :
      (Subgroup.zpowers g).map (paired_permutation_range_lift (X := X) (Y := Y)) = K := by
    calc
      (Subgroup.zpowers g).map (paired_permutation_range_lift (X := X) (Y := Y))
          = Subgroup.zpowers ((paired_permutation_range_lift (X := X) (Y := Y)) g) := by
              rw [MonoidHom.map_zpowers]
      _ = K := hkLift
  have hdescX :=
    card_orbitQuotient_descend (X := X) (Y := Y) (Subgroup.zpowers g)
  have hdescY :=
    card_orbitQuotient_descend_right (X := X) (Y := Y) (Subgroup.zpowers g)
  have hcyc : IsCyclic (Subgroup.zpowers g) := inferInstance
  have hG := hOrbit (Subgroup.zpowers g) hcyc
  calc
    Nat.card (MulAction.orbitRel.Quotient K X.V)
        = Nat.card
            (MulAction.orbitRel.Quotient
              ((Subgroup.zpowers g).map (paired_permutation_range_lift (X := X) (Y := Y))) X.V) := by
              rw [hkMap]
    _ = Nat.card (MulAction.orbitRel.Quotient (Subgroup.zpowers g) X.V) := by
          symm
          exact hdescX
    _ = Nat.card (MulAction.orbitRel.Quotient (Subgroup.zpowers g) Y.V) := hG
    _ = Nat.card
          (MulAction.orbitRel.Quotient
            ((Subgroup.zpowers g).map (paired_permutation_range_lift (X := X) (Y := Y))) Y.V) := by
          exact hdescY
    _ = Nat.card (MulAction.orbitRel.Quotient K Y.V) := by
          rw [hkMap]

/-- Helper for Exercise 13-13.1-15: over `ℚ`, the pairing of a permutation character with the
trivial character counts the orbits of the action. -/
lemma rational_permutation_character_pairing_with_trivial_eq_orbit_count
    {A α : Type*} [Group A] [Finite A] [MulAction A α] [Finite α] :
    ⟪(Representation.ofMulAction ℚ A α).character, (1 : A → ℚ)⟫ =
      Nat.card (MulAction.orbitRel.Quotient A α) := by
  letI : Fintype A := Fintype.ofFinite A
  letI : Invertible (Nat.card A : ℚ) := invertibleOfNonzero (by
    exact_mod_cast Nat.card_pos.ne')
  -- Rewrite the pairing as the normalized character sum and compare it with the invariant
  -- dimension formula for permutation representations.
  rw [Representation.groupFunctionPairing_eq_card_inv_sum_apply_mul_inv_apply]
  calc
    (Nat.card A : ℚ)⁻¹ *
        ∑ s : A, (Representation.ofMulAction ℚ A α).character s * (1 : A → ℚ) s⁻¹
        = (Nat.card A : ℚ)⁻¹ *
            ∑ s : A, (Representation.ofMulAction ℚ A α).character s := by
              simp
    _ = Module.finrank ℚ (Representation.ofMulAction ℚ A α).invariants := by
          simpa using
            (Representation.card_inv_mul_sum_char_eq_finrank
              (ρ := Representation.ofMulAction ℚ A α))
    _ = Nat.card (MulAction.orbitRel.Quotient A α) := by
          rw [← Representation.orbit_count_eq_finrank_invariants (k := ℚ) (G := A) (X := α)]

/-- Helper for Exercise 13-13.1-15: summing the rational permutation character over the whole
acting group gives the group order times the orbit count. -/
lemma sum_rational_permutation_character_eq_card_mul_orbit_count
    {A α : Type*} [Group A] [Fintype A] [MulAction A α] [Finite α] :
    ∑ a : A, (Representation.ofMulAction ℚ A α).character a =
      (Nat.card A : ℚ) * Nat.card (MulAction.orbitRel.Quotient A α) := by
  have hcardNat : Nat.card A ≠ 0 := by
    simp [Nat.card_eq_fintype_card]
  have hcard : (Nat.card A : ℚ) ≠ 0 := Nat.cast_ne_zero.2 hcardNat
  letI : Invertible (Nat.card A : ℚ) := invertibleOfNonzero hcard
  have havg :
      (Nat.card A : ℚ)⁻¹ * ∑ a : A, (Representation.ofMulAction ℚ A α).character a =
        Nat.card (MulAction.orbitRel.Quotient A α) := by
    calc
      (Nat.card A : ℚ)⁻¹ * ∑ a : A, (Representation.ofMulAction ℚ A α).character a
          = Module.finrank ℚ (Representation.ofMulAction ℚ A α).invariants := by
              simpa using
                (Representation.card_inv_mul_sum_char_eq_finrank
                  (ρ := Representation.ofMulAction ℚ A α))
      _ = Nat.card (MulAction.orbitRel.Quotient A α) := by
            rw [← Representation.orbit_count_eq_finrank_invariants (k := ℚ) (G := A) (X := α)]
  -- Clear the averaging factor so the subgroup-sum vanishing theorem can use raw sums.
  exact (inv_mul_eq_iff_eq_mul₀ hcard).1 <| by
    simpa using havg

/-- Helper for Exercise 13-13.1-15: on a finite group, equality of cyclic subgroup orbit counts
forces the complex permutation representations to be isomorphic. -/
lemma finite_group_weaklyIsomorphic_of_card_orbitQuotient_eq_forall_isCyclic
    {Q : Type u} [Group Q] [Finite Q]
    (XQ YQ : Action FintypeCat Q)
    (hOrbit :
      ∀ (C : Subgroup Q) (_ : IsCyclic C),
        Nat.card (MulAction.orbitRel.Quotient C XQ.V) =
          Nat.card (MulAction.orbitRel.Quotient C YQ.V)) :
    WeaklyIsomorphic XQ YQ := by
  classical
  letI : Fintype Q := Fintype.ofFinite Q
  letI (H : Subgroup Q) : Fintype H := Fintype.ofFinite H
  let f : Q → ℚ := fun q ↦
    (Representation.ofMulAction ℚ Q XQ.V).character q -
      (Representation.ofMulAction ℚ Q YQ.V).character q
  have hconst :
      ∀ {x y : Q}, Subgroup.zpowers x = Subgroup.zpowers y → f x = f y := by
    intro x y hxy
    have hX_nat : (MulAction.fixedBy XQ.V x).ncard = (MulAction.fixedBy XQ.V y).ncard := by
      calc
        (MulAction.fixedBy XQ.V x).ncard
            = Nat.card (MulAction.fixedPoints (Subgroup.zpowers x) XQ.V) := by
                symm
                exact card_fixedPoints_zpowers_eq_ncard_fixedBy (G := Q) (α := XQ.V) x
        _ = Nat.card (MulAction.fixedPoints (Subgroup.zpowers y) XQ.V) := by rw [hxy]
        _ = (MulAction.fixedBy XQ.V y).ncard := by
              exact card_fixedPoints_zpowers_eq_ncard_fixedBy (G := Q) (α := XQ.V) y
    have hY_nat : (MulAction.fixedBy YQ.V x).ncard = (MulAction.fixedBy YQ.V y).ncard := by
      calc
        (MulAction.fixedBy YQ.V x).ncard
            = Nat.card (MulAction.fixedPoints (Subgroup.zpowers x) YQ.V) := by
                symm
                exact card_fixedPoints_zpowers_eq_ncard_fixedBy (G := Q) (α := YQ.V) x
        _ = Nat.card (MulAction.fixedPoints (Subgroup.zpowers y) YQ.V) := by rw [hxy]
        _ = (MulAction.fixedBy YQ.V y).ncard := by
              exact card_fixedPoints_zpowers_eq_ncard_fixedBy (G := Q) (α := YQ.V) y
    -- The permutation character depends only on the generated cyclic subgroup.
    simp [f, Representation.ofMulAction_character_eq_ncard_fixedBy, hX_nat, hY_nat]
  have hsum : ∀ C : Subgroup.cyclicSubgroups Q, ∑ s : C.1, f s = 0 := by
    intro C
    have hsumX :=
      sum_rational_permutation_character_eq_card_mul_orbit_count (A := C.1) (α := XQ.V)
    have hsumY :=
      sum_rational_permutation_character_eq_card_mul_orbit_count (A := C.1) (α := YQ.V)
    have hfixedBy_restrict_X :
        ∀ s : C.1, (MulAction.fixedBy XQ.V (s : Q)).ncard = (MulAction.fixedBy XQ.V s).ncard := by
      intro s
      exact congrArg Set.ncard (by
        ext x
        rfl)
    have hfixedBy_restrict_Y :
        ∀ s : C.1, (MulAction.fixedBy YQ.V (s : Q)).ncard = (MulAction.fixedBy YQ.V s).ncard := by
      intro s
      exact congrArg Set.ncard (by
        ext x
        rfl)
    have hcharX :
        ∀ s : C.1,
          (Representation.ofMulAction ℚ Q XQ.V).character s =
            (Representation.ofMulAction ℚ C.1 XQ.V).character s := by
      intro s
      rw [Representation.ofMulAction_character_eq_ncard_fixedBy,
        Representation.ofMulAction_character_eq_ncard_fixedBy]
      exact_mod_cast hfixedBy_restrict_X s
    have hcharY :
        ∀ s : C.1,
          (Representation.ofMulAction ℚ Q YQ.V).character s =
            (Representation.ofMulAction ℚ C.1 YQ.V).character s := by
      intro s
      rw [Representation.ofMulAction_character_eq_ncard_fixedBy,
        Representation.ofMulAction_character_eq_ncard_fixedBy]
      exact_mod_cast hfixedBy_restrict_Y s
    have hsumX' :
        ∑ s : C.1, (Representation.ofMulAction ℚ Q XQ.V).character s =
          ∑ s : C.1, (Representation.ofMulAction ℚ C.1 XQ.V).character s := by
      refine Finset.sum_congr rfl ?_
      intro s hs
      exact hcharX s
    have hsumY' :
        ∑ s : C.1, (Representation.ofMulAction ℚ Q YQ.V).character s =
          ∑ s : C.1, (Representation.ofMulAction ℚ C.1 YQ.V).character s := by
      refine Finset.sum_congr rfl ?_
      intro s hs
      exact hcharY s
    -- Rewrite the cyclic orbit-count hypothesis as vanishing subgroup sums of the character
    -- difference.
    calc
      ∑ s : C.1, f s
          = ∑ s : C.1, (Representation.ofMulAction ℚ Q XQ.V).character s -
              ∑ s : C.1, (Representation.ofMulAction ℚ Q YQ.V).character s := by
                simp [f, Finset.sum_sub_distrib]
      _ = ∑ s : C.1, (Representation.ofMulAction ℚ C.1 XQ.V).character s -
            ∑ s : C.1, (Representation.ofMulAction ℚ C.1 YQ.V).character s := by
              rw [hsumX', hsumY']
      _ = (Nat.card C.1 : ℚ) * Nat.card (MulAction.orbitRel.Quotient C.1 XQ.V) -
            (Nat.card C.1 : ℚ) * Nat.card (MulAction.orbitRel.Quotient C.1 YQ.V) := by
              rw [hsumX, hsumY]
      _ = 0 := by rw [hOrbit C.1 (Subgroup.mem_cyclicSubgroups.1 C.2), sub_self]
  have hf_zero : f = 0 :=
    Representation.function_eq_zero_of_zero_cyclic_subgroup_sums f hconst hsum
  have hcharQ_rat :
      (Representation.ofMulAction ℚ Q XQ.V).character =
        (Representation.ofMulAction ℚ Q YQ.V).character := by
    ext q
    exact sub_eq_zero.mp (by simpa [f] using congrFun hf_zero q)
  have hcharQ :
      (Representation.ofMulAction ℂ Q XQ.V).character =
        (Representation.ofMulAction ℂ Q YQ.V).character := by
    ext q
    have hq_rat := congrFun hcharQ_rat q
    have hq_nat : (MulAction.fixedBy XQ.V q).ncard = (MulAction.fixedBy YQ.V q).ncard := by
      rw [Representation.ofMulAction_character_eq_ncard_fixedBy,
        Representation.ofMulAction_character_eq_ncard_fixedBy] at hq_rat
      exact_mod_cast hq_rat
    rw [Representation.ofMulAction_character_eq_ncard_fixedBy,
      Representation.ofMulAction_character_eq_ncard_fixedBy]
    exact_mod_cast hq_nat
  letI : Invertible (Nat.card Q : ℂ) := invertibleOfNonzero (by
    exact_mod_cast Nat.card_pos.ne')
  have heQ :=
    (Representation.character_eq_iff_nonempty_equiv
      (Representation.ofMulAction ℂ Q XQ.V)
      (Representation.ofMulAction ℂ Q YQ.V)).mp hcharQ
  rcases heQ with ⟨eQ⟩
  exact ⟨Rep.mkIso eQ⟩

-- Proof sketch: identify `Nat.card (MulAction.orbitRel.Quotient H X)` with the scalar product of
-- the permutation character of `X` against the induced trivial character `ℓ_H^G`. Equality of the
-- permutation representations is therefore equivalent to equality of orbit counts for every
-- subgroup.
/-- Weak isomorphism is equivalent to equality of orbit counts for every subgroup. -/
theorem weaklyIsomorphic_iff_card_orbitQuotient_eq_forall_subgroup :
    WeaklyIsomorphic X Y ↔
      ∀ H : Subgroup G,
        Nat.card (MulAction.orbitRel.Quotient H X.V) =
          Nat.card (MulAction.orbitRel.Quotient H Y.V) := by
  constructor
  · rintro ⟨e⟩ H
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q X.V :=
      MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
    letI : MulAction Q Y.V :=
      MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
    letI : Finite Q := by
      change Finite (paired_permutation_hom (X := X) (Y := Y)).range
      infer_instance
    letI : Fintype Q := Fintype.ofFinite Q
    let K : Subgroup Q := H.map (paired_permutation_range_lift (X := X) (Y := Y))
    letI : Fintype K := Fintype.ofFinite K
    let ρXQ := (Rep.ofMulAction ℂ Q X.V).ρ
    let ρYQ := (Rep.ofMulAction ℂ Q Y.V).ρ
    let eQ : ρXQ.Equiv ρYQ := by
      -- The original representation isomorphism is already equivariant for the finite image.
      refine Representation.Equiv.mk
        { toLinearMap := e.hom.hom.toLinearMap
          invFun := e.inv.hom
          left_inv := fun x ↦ Iso.hom_inv_id_apply e x
          right_inv := fun y ↦ Iso.inv_hom_id_apply e y } ?_
      intro q
      rcases q.2 with ⟨g, hg⟩
      have hq : q = paired_permutation_range_lift (X := X) (Y := Y) g := by
        apply Subtype.ext
        exact hg.symm
      subst hq
      simpa [ρXQ, ρYQ, paired_permutation_range_lift, paired_permutation_hom,
        paired_permutation_range_left_hom, paired_permutation_range_right_hom] using
        e.hom.hom.2 g
    have hOrbitK :
        Nat.card (MulAction.orbitRel.Quotient K X.V) =
          Nat.card (MulAction.orbitRel.Quotient K Y.V) := by
      letI : MulAction K X.V := MulAction.compHom X.V K.subtype
      letI : MulAction K Y.V := MulAction.compHom Y.V K.subtype
      letI : Fintype (MulAction.orbitRel.Quotient K X.V) := Fintype.ofFinite _
      letI : Fintype (MulAction.orbitRel.Quotient K Y.V) := Fintype.ofFinite _
      letI : ∀ k : K, Fintype (MulAction.fixedBy X.V k) := fun _ ↦ Fintype.ofFinite _
      letI : ∀ k : K, Fintype (MulAction.fixedBy Y.V k) := fun _ ↦ Fintype.ofFinite _
      have hfixed_nat :
          ∀ k : K, Nat.card (MulAction.fixedBy X.V k) = Nat.card (MulAction.fixedBy Y.V k) := by
        intro k
        have hk := congrFun (Representation.char_iso eQ) (k : Q)
        rw [Representation.ofMulAction_character_eq_ncard_fixedBy,
          Representation.ofMulAction_character_eq_ncard_fixedBy] at hk
        have hk_nat : (MulAction.fixedBy X.V (k : Q)).ncard = (MulAction.fixedBy Y.V (k : Q)).ncard := by
          exact_mod_cast hk
        exact
          (_root_.Nat.card_coe_set_eq (MulAction.fixedBy X.V k)).trans <|
            hk_nat.trans <|
              (_root_.Nat.card_coe_set_eq (MulAction.fixedBy Y.V k)).symm
      have hfixed :
          ∀ k : K, Fintype.card (MulAction.fixedBy X.V k) = Fintype.card (MulAction.fixedBy Y.V k) := by
        intro k
        exact
          (Nat.card_eq_fintype_card (α := MulAction.fixedBy X.V k)).symm.trans <|
            (hfixed_nat k).trans <|
              Nat.card_eq_fintype_card (α := MulAction.fixedBy Y.V k)
      have hsumX :=
        MulAction.sum_card_fixedBy_eq_card_orbits_mul_card_group (α := K) (β := X.V)
      have hsumY :=
        MulAction.sum_card_fixedBy_eq_card_orbits_mul_card_group (α := K) (β := Y.V)
      have hsumEq :
          ∑ k : K, Fintype.card (MulAction.fixedBy X.V k) =
            ∑ k : K, Fintype.card (MulAction.fixedBy Y.V k) := by
        exact Finset.sum_congr rfl (fun k _ ↦ hfixed k)
      rw [hsumX, hsumY] at hsumEq
      have hKpos : 0 < Fintype.card K := Fintype.card_pos_iff.mpr ⟨1⟩
      have hOrbitK_card :
          Fintype.card (MulAction.orbitRel.Quotient K X.V) =
            Fintype.card (MulAction.orbitRel.Quotient K Y.V) :=
        Nat.eq_of_mul_eq_mul_right hKpos hsumEq
      calc
        Nat.card (MulAction.orbitRel.Quotient K X.V)
            = Fintype.card (MulAction.orbitRel.Quotient K X.V) := by
                exact Nat.card_eq_fintype_card
        _ = Fintype.card (MulAction.orbitRel.Quotient K Y.V) := hOrbitK_card
        _ = Nat.card (MulAction.orbitRel.Quotient K Y.V) := by
              exact (Nat.card_eq_fintype_card).symm
    -- Descend to the finite image, compare orbit counts there, and transport back.
    calc
      Nat.card (MulAction.orbitRel.Quotient H X.V)
          = Nat.card (MulAction.orbitRel.Quotient K X.V) := by
              simpa [K] using card_orbitQuotient_descend (X := X) (Y := Y) H
      _ = Nat.card (MulAction.orbitRel.Quotient K Y.V) := hOrbitK
      _ = Nat.card (MulAction.orbitRel.Quotient H Y.V) := by
            symm
            simpa [K] using card_orbitQuotient_descend_right (X := X) (Y := Y) H
  · intro hOrbit
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q X.V :=
      MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
    letI : MulAction Q Y.V :=
      MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
    letI : Finite Q := by
      -- The common image is a finite subgroup of the product of the two permutation groups.
      change Finite (paired_permutation_hom (X := X) (Y := Y)).range
      infer_instance
    let XQ : Action FintypeCat Q := Action.FintypeCat.ofMulAction Q X.V
    let YQ : Action FintypeCat Q := Action.FintypeCat.ofMulAction Q Y.V
    have hOrbitQ :
        ∀ (K : Subgroup Q) (_ : IsCyclic K),
          Nat.card (MulAction.orbitRel.Quotient K XQ.V) =
            Nat.card (MulAction.orbitRel.Quotient K YQ.V) := by
      -- Every cyclic subgroup of the finite image is generated by the image of some `g : G`.
      simpa [Q, XQ, YQ] using
        cyclic_orbit_counts_descend_to_paired_permutation_range (X := X) (Y := Y)
          (fun H _ ↦ hOrbit H)
    -- Route correction: the descent to the common finite image is complete. The only remaining gap
    -- is the finite-image cyclic converse isolated in the helper above.
    have hQ : WeaklyIsomorphic XQ YQ :=
      finite_group_weaklyIsomorphic_of_card_orbitQuotient_eq_forall_isCyclic XQ YQ hOrbitQ
    rcases hQ with ⟨eQ⟩
    have eG : (Rep.ofMulAction ℂ G X.V).ρ.Equiv (Rep.ofMulAction ℂ G Y.V).ρ := by
      -- Any intertwiner for the descended `Q`-actions is automatically `G`-equivariant after
      -- composing with the quotient map `paired_permutation_range_lift`.
      refine Representation.Equiv.mk
        { toLinearMap := eQ.hom.hom.toLinearMap
          invFun := eQ.inv.hom
          left_inv := fun x ↦ Iso.hom_inv_id_apply eQ x
          right_inv := fun y ↦ Iso.inv_hom_id_apply eQ y } ?_
      intro g
      simpa [Q, XQ, YQ, paired_permutation_range_lift, paired_permutation_hom,
        paired_permutation_range_left_hom, paired_permutation_range_right_hom] using
        eQ.hom.hom.2 (paired_permutation_range_lift (X := X) (Y := Y) g)
    exact ⟨Rep.mkIso eG⟩

-- Proof sketch: combine the orbit-count interpretation with Artin's theorem, which reduces the
-- relevant character equalities to cyclic subgroups.
/-- Weak isomorphism is equivalent to equality of orbit counts for cyclic subgroups. -/
theorem weaklyIsomorphic_iff_card_orbitQuotient_eq_forall_isCyclic :
    WeaklyIsomorphic X Y ↔
      ∀ (H : Subgroup G) (_ : IsCyclic H),
        Nat.card (MulAction.orbitRel.Quotient H X.V) =
          Nat.card (MulAction.orbitRel.Quotient H Y.V) := by
  constructor
  · intro hweak H hH
    exact (weaklyIsomorphic_iff_card_orbitQuotient_eq_forall_subgroup (X := X) (Y := Y)).1 hweak H
  · intro hOrbit
    let Q := paired_permutation_range (X := X) (Y := Y)
    letI : MulAction Q X.V :=
      MulAction.compHom X.V (paired_permutation_range_left_hom (X := X) (Y := Y))
    letI : MulAction Q Y.V :=
      MulAction.compHom Y.V (paired_permutation_range_right_hom (X := X) (Y := Y))
    letI : Finite Q := by
      -- As above, the paired permutation image is finite because the underlying sets are finite.
      change Finite (paired_permutation_hom (X := X) (Y := Y)).range
      infer_instance
    let XQ : Action FintypeCat Q := Action.FintypeCat.ofMulAction Q X.V
    let YQ : Action FintypeCat Q := Action.FintypeCat.ofMulAction Q Y.V
    have hOrbitQ :
        ∀ (K : Subgroup Q) (_ : IsCyclic K),
          Nat.card (MulAction.orbitRel.Quotient K XQ.V) =
            Nat.card (MulAction.orbitRel.Quotient K YQ.V) := by
      simpa [Q, XQ, YQ] using
        cyclic_orbit_counts_descend_to_paired_permutation_range (X := X) (Y := Y) hOrbit
    have hQ : WeaklyIsomorphic XQ YQ :=
      finite_group_weaklyIsomorphic_of_card_orbitQuotient_eq_forall_isCyclic XQ YQ hOrbitQ
    rcases hQ with ⟨eQ⟩
    have eG : (Rep.ofMulAction ℂ G X.V).ρ.Equiv (Rep.ofMulAction ℂ G Y.V).ρ := by
      -- The same descended intertwiner works for the original actions after precomposing with
      -- the quotient homomorphism from `G` to the finite image `Q`.
      refine Representation.Equiv.mk
        { toLinearMap := eQ.hom.hom.toLinearMap
          invFun := eQ.inv.hom
          left_inv := fun x ↦ Iso.hom_inv_id_apply eQ x
          right_inv := fun y ↦ Iso.inv_hom_id_apply eQ y } ?_
      intro g
      simpa [Q, XQ, YQ, paired_permutation_range_lift, paired_permutation_hom,
        paired_permutation_range_left_hom, paired_permutation_range_right_hom] using
        eQ.hom.hom.2 (paired_permutation_range_lift (X := X) (Y := Y) g)
    exact ⟨Rep.mkIso eG⟩

-- Proof sketch: if `G` is cyclic, every subgroup of `G` is cyclic. Combine
-- `isomorphic_iff_card_fixedPoints_eq_forall_subgroup` with
-- `weaklyIsomorphic_iff_card_fixedPoints_eq_forall_isCyclic`.
/-- For a cyclic finite group, weakly isomorphic finite `G`-sets are already isomorphic. -/
theorem isomorphic_iff_weaklyIsomorphic_of_isCyclic [IsCyclic G] :
    IsIsomorphic X Y ↔ WeaklyIsomorphic X Y := by
  constructor
  · intro hXY
    -- Equality of subgroup fixed-point counts implies equality on the cyclic subgroups in
    -- particular, so the weak criterion follows immediately.
    refine (weaklyIsomorphic_iff_card_fixedPoints_eq_forall_isCyclic (X := X) (Y := Y)).2 ?_
    intro H hH
    exact (isomorphic_iff_card_fixedPoints_eq_forall_subgroup (X := X) (Y := Y)).1 hXY H
  · intro hweak
    -- In a cyclic group every subgroup is cyclic, so the weak fixed-point criterion upgrades to
    -- the full Burnside-mark criterion.
    refine (isomorphic_iff_card_fixedPoints_eq_forall_subgroup (X := X) (Y := Y)).2 ?_
    intro H
    exact
      (weaklyIsomorphic_iff_card_fixedPoints_eq_forall_isCyclic (X := X) (Y := Y)).1 hweak H
        inferInstance

-- Proof sketch: start from the classical Burnside-ring counterexample for
-- `Multiplicative (ZMod 2 × ZMod 2)` and transport it along an isomorphism from that model to an
-- arbitrary Klein four-group `G`, using `IsKleinFour.nonempty_mulEquiv`.
/-- Helper for Exercise 13-13.1-15: on an abelian quotient action, a coset is fixed by `g` exactly
when `g` lies in the quotient subgroup. -/
lemma quotient_fixedBy_iff_mem_subgroup_of_commutative
    {G : Type u} [Group G] [IsMulCommutative G]
    (K : Subgroup G) (g : G) (x : G ⧸ K) :
    x ∈ MulAction.fixedBy (G ⧸ K) g ↔ g ∈ K := by
  -- Rewrite the quotient point as a left coset and collapse the conjugation term using
  -- commutativity.
  rcases QuotientGroup.mk_surjective x with ⟨r, rfl⟩
  change (g • ((r : G) : G ⧸ K) = ((r : G) : G ⧸ K)) ↔ g ∈ K
  simp

open scoped Classical in
/-- Helper for Exercise 13-13.1-15: a quotient `G ⧸ K` is either entirely fixed by `H` or has no
`H`-fixed points at all, according to whether `H ≤ K`. -/
lemma card_fixedPoints_quotient_of_le_or_not_le
    {G : Type u} [Group G] [Finite G] [IsMulCommutative G]
    (H K : Subgroup G) :
    Nat.card (MulAction.fixedPoints H (G ⧸ K)) =
      if H ≤ K then Nat.card (G ⧸ K) else 0 := by
  classical
  let _ : Fintype (G ⧸ K) := Fintype.ofFinite _
  let _ : Fintype (MulAction.fixedPoints H (G ⧸ K)) := Fintype.ofFinite _
  by_cases hHK : H ≤ K
  · have hset : MulAction.fixedPoints H (G ⧸ K) = Set.univ := by
      ext x
      rw [MulAction.mem_fixedPoints]
      constructor
      · intro _
        simp
      · intro _ h
        exact
          (quotient_fixedBy_iff_mem_subgroup_of_commutative
            (K := K) (g := (h : G)) (x := x)).2 (hHK h.2)
    rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
    simp [hset, hHK]
  · have hnot : ¬ ∀ h : H, (h : G) ∈ K := by
      intro hh
      exact hHK (fun x hx ↦ hh ⟨x, hx⟩)
    rcases not_forall.mp hnot with ⟨h, hhK⟩
    have hset : MulAction.fixedPoints H (G ⧸ K) = (∅ : Set (G ⧸ K)) := by
      ext x
      rw [MulAction.mem_fixedPoints, Set.mem_empty_iff_false]
      constructor
      · intro hx
        exact
          hhK
            ((quotient_fixedBy_iff_mem_subgroup_of_commutative
              (K := K) (g := (h : G)) (x := x)).1 (hx h))
      · intro hx
        contradiction
    haveI : IsEmpty (MulAction.fixedPoints H (G ⧸ K)) := by
      rw [hset]
      infer_instance
    rw [Nat.card_eq_fintype_card]
    rw [if_neg hHK]
    simpa using (Fintype.card_of_isEmpty : Fintype.card (MulAction.fixedPoints H (G ⧸ K)) = 0)

/-- Helper for Exercise 13-13.1-15: a nontrivial cyclic quotient of a Klein four-group has two
elements. -/
lemma natCard_quotient_zpowers_eq_two_of_ne_one
    {G : Type u} [Group G] [Finite G] [IsKleinFour G] (a : G) (ha : a ≠ 1) :
    Nat.card (G ⧸ Subgroup.zpowers a) = 2 := by
  -- Rewrite `|⟨a⟩|` as `orderOf a = 2`, then solve the quotient-cardinality equation.
  have hz : Nat.card (Subgroup.zpowers a) = 2 := by
    rw [Nat.card_zpowers]
    exact (orderOf_eq_two_iff IsKleinFour.exponent_two).2 ha
  have hcard :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup (α := G) (Subgroup.zpowers a)
  rw [IsKleinFour.card_four, hz] at hcard
  omega

open scoped Classical in
/-- Helper for Exercise 13-13.1-15: in a Klein four-group, a point of `⟨y⟩` is either `1` or the
nontrivial generator `y`. -/
lemma eq_one_or_eq_generator_of_mem_zpowers_of_ne_one
    {G : Type u} [Group G] [Finite G] [IsKleinFour G]
    {x y : G} (hy : y ≠ 1) (hxy : x ∈ Subgroup.zpowers y) :
    x = 1 ∨ x = y := by
  -- Reduce membership in `⟨y⟩` to the two powers allowed by `orderOf y = 2`.
  have hy_order : orderOf y = 2 := (orderOf_eq_two_iff IsKleinFour.exponent_two).2 hy
  rw [mem_zpowers_iff_mem_range_orderOf, hy_order, Finset.mem_image] at hxy
  rcases hxy with ⟨n, hn, hxn⟩
  have hn' : n = 0 ∨ n = 1 := by
    have hlt : n < 2 := Finset.mem_range.mp hn
    omega
  rcases hn' with rfl | rfl
  · left
    simpa using hxn.symm
  · right
    simpa using hxn.symm

open scoped Classical in
/-- Helper for Exercise 13-13.1-15: distinct nontrivial elements of a Klein four-group generate
distinct order-two cyclic subgroups, so no inclusion can hold between them. -/
lemma not_zpowers_le_of_ne_one_of_ne
    {G : Type u} [Group G] [Finite G] [IsKleinFour G]
    {x y : G} (hx : x ≠ 1) (hy : y ≠ 1) (hxy : x ≠ y) :
    ¬ Subgroup.zpowers x ≤ Subgroup.zpowers y := by
  -- If `x ∈ ⟨y⟩`, the previous lemma forces `x = 1` or `x = y`, contradicting the hypotheses.
  intro hxy_le
  have hx_mem : x ∈ Subgroup.zpowers y := hxy_le (Subgroup.mem_zpowers x)
  rcases eq_one_or_eq_generator_of_mem_zpowers_of_ne_one hy hx_mem with h1 | hEq
  · exact hx h1
  · exact hxy hEq

/-- Helper for Exercise 13-13.1-15: every cyclic subgroup of a Klein four-group is either trivial
or generated by one of the three nontrivial elements `a`, `b`, `a * b`. -/
lemma cyclic_subgroup_eq_bot_or_eq_zpowers_of_kleinFour
    {G : Type u} [Group G] [Finite G] [IsKleinFour G]
    (a b : G) (ha : a ≠ 1) (hb : b ≠ 1) (hab : a ≠ b)
    (H : Subgroup G) (hH : IsCyclic H) :
    H = ⊥ ∨ H = Subgroup.zpowers a ∨ H = Subgroup.zpowers b ∨
      H = Subgroup.zpowers (a * b) := by
  -- Choose a generator of `H`; in a Klein four-group it must be `1`, `a`, `b`, or `a * b`.
  rcases (Subgroup.isCyclic_iff_exists_zpowers_eq_top H).mp hH with ⟨h, hHz⟩
  by_cases h1 : h = 1
  · left
    simpa [h1] using hHz.symm
  · by_cases ha' : h = a
    · right
      left
      simpa [ha'] using hHz.symm
    · by_cases hb' : h = b
      · right
        right
        left
        simpa [hb'] using hHz.symm
      · right
        right
        right
        have habh : h = a * b := by
          exact IsKleinFour.eq_mul_of_ne_all ha hb hab h1 ha' hb'
        simpa [habh] using hHz.symm

/-- Helper for Exercise 13-13.1-15: the transitive `G`-action on the quotient `G ⧸ K`. -/
abbrev quotient_action
    (G : Type u) [Group G] [Finite G] (K : Subgroup G) :
    Action FintypeCat G :=
  Action.FintypeCat.ofMulAction G (FintypeCat.of (G ⧸ K))

/-- Helper for Exercise 13-13.1-15: the left-hand side of the standard Klein-four counterexample,
the regular orbit together with two trivial orbits. -/
abbrev standard_counterexample_left_action
    (G : Type u) [Group G] [Finite G] :
    Action FintypeCat G :=
  quotient_action G (⊥ : Subgroup G) ⨿
    (quotient_action G (⊤ : Subgroup G) ⨿ quotient_action G (⊤ : Subgroup G))

/-- Helper for Exercise 13-13.1-15: the right-hand side of the standard Klein-four counterexample,
the sum of the three index-two transitive quotient actions. -/
abbrev standard_counterexample_right_action
    (G : Type u) [Group G] [Finite G] (a b : G) :
    Action FintypeCat G :=
  quotient_action G (Subgroup.zpowers a) ⨿
    (quotient_action G (Subgroup.zpowers b) ⨿
      quotient_action G (Subgroup.zpowers (a * b)))

/-- Helper for Exercise 13-13.1-15: a Klein four-group contains two distinct nonidentity
elements. -/
lemma exists_two_distinct_nontrivial_elements_of_kleinFour
    {G : Type u} [Group G] [IsKleinFour G] :
    ∃ a b : G, a ≠ 1 ∧ b ≠ 1 ∧ a ≠ b := by
  classical
  let e : G ≃* Multiplicative (ZMod 2 × ZMod 2) :=
    Classical.choice IsKleinFour.nonempty_mulEquiv
  -- Transport the two standard nontrivial elements of `V₄` back to `G`.
  refine
    ⟨e.symm (Multiplicative.ofAdd (((1 : ZMod 2), (0 : ZMod 2)) : ZMod 2 × ZMod 2)),
      e.symm (Multiplicative.ofAdd (((0 : ZMod 2), (1 : ZMod 2)) : ZMod 2 × ZMod 2)),
      ?_, ?_, ?_⟩
  · intro ha
    have h := congrArg e ha
    simp at h
  · intro hb
    have h := congrArg e hb
    simp at h
  · intro hab
    have h := congrArg e hab
    simp at h

/-- Helper for Exercise 13-13.1-15: the quotient by the top subgroup is a singleton. -/
lemma natCard_quotient_top_eq_one
    {G : Type u} [Group G] [Finite G] :
    Nat.card (G ⧸ (⊤ : Subgroup G)) = 1 := by
  -- The quotient by the whole group is the one-point transitive action.
  simp

/-- Helper for Exercise 13-13.1-15: when `H ≤ K`, the whole quotient action `G ⧸ K` is fixed by
`H`. -/
lemma card_fixedPoints_quotient_action_of_le
    {G : Type u} [Group G] [Finite G] [IsMulCommutative G]
    (H K : Subgroup G) (hHK : H ≤ K) :
    Nat.card (MulAction.fixedPoints H (quotient_action G K).V) = Nat.card (G ⧸ K) := by
  have hbase :
      Nat.card (MulAction.fixedPoints H (G ⧸ K)) = Nat.card (G ⧸ K) := by
    rw [card_fixedPoints_quotient_of_le_or_not_le]
    simp [hHK]
  exact hbase

/-- Helper for Exercise 13-13.1-15: when `H` is not contained in `K`, the quotient action `G ⧸ K`
has no `H`-fixed points. -/
lemma card_fixedPoints_quotient_action_of_not_le
    {G : Type u} [Group G] [Finite G] [IsMulCommutative G]
    (H K : Subgroup G) (hHK : ¬ H ≤ K) :
    Nat.card (MulAction.fixedPoints H (quotient_action G K).V) = 0 := by
  have hbase :
      Nat.card (MulAction.fixedPoints H (G ⧸ K)) = 0 := by
    rw [card_fixedPoints_quotient_of_le_or_not_le]
    simp [hHK]
  exact hbase

/-- Helper for Exercise 13-13.1-15: the two standard Klein-four quotient sums have the same
fixed-point counts on every cyclic subgroup. -/
lemma cyclic_fixedpoint_counts_standard_counterexample
    {G : Type u} [Group G] [Finite G] [IsKleinFour G] [IsMulCommutative G]
    {a b : G} (ha : a ≠ 1) (hb : b ≠ 1) (hab : a ≠ b) :
    ∀ H : Subgroup G, IsCyclic H →
      Nat.card (MulAction.fixedPoints H (standard_counterexample_left_action G).V) =
        Nat.card (MulAction.fixedPoints H (standard_counterexample_right_action G a b).V) := by
  have htop : Nat.card (G ⧸ (⊤ : Subgroup G)) = 1 := natCard_quotient_top_eq_one
  have hbot : Nat.card (G ⧸ (⊥ : Subgroup G)) = 4 := by
    -- Identify the regular quotient `G / ⊥` with `G` itself.
    calc
      Nat.card (G ⧸ (⊥ : Subgroup G)) = Nat.card G := by
        exact Nat.card_congr QuotientGroup.quotientBot.toEquiv
      _ = 4 := IsKleinFour.card_four
  have hab1 : a * b ≠ 1 := by
    -- Multiplying `a * b = 1` on the left by `a` would force `b = a`.
    intro hab1
    have : b = a := by
      calc
        b = 1 * b := by simp
        _ = (a * a) * b := by rw [IsKleinFour.mul_self a]
        _ = a * (a * b) := by simp [mul_assoc]
        _ = a := by rw [hab1]; simp
    exact hab this.symm
  have haba : a * b ≠ a := by
    -- Multiplying `a * b = a` on the left by `a` would force `b = 1`.
    intro haba
    have : b = 1 := by
      calc
        b = 1 * b := by simp
        _ = (a * a) * b := by rw [IsKleinFour.mul_self a]
        _ = a * (a * b) := by simp [mul_assoc]
        _ = a * a := by rw [haba]
        _ = 1 := IsKleinFour.mul_self a
    exact hb this
  have habb : a * b ≠ b := by
    -- Multiplying `a * b = b` on the right by `b` would force `a = 1`.
    intro habb
    have : a = 1 := by
      calc
        a = a * 1 := by simp
        _ = a * (b * b) := by rw [IsKleinFour.mul_self b]
        _ = (a * b) * b := by simp [mul_assoc]
        _ = b * b := by rw [habb]
        _ = 1 := IsKleinFour.mul_self b
    exact ha this
  intro H hH
  -- Classify cyclic subgroups of a Klein four-group into the trivial one and the three order-two
  -- subgroups.
  rcases cyclic_subgroup_eq_bot_or_eq_zpowers_of_kleinFour a b ha hb hab H hH with
    rfl | rfl | rfl | rfl
  · -- At the trivial subgroup, the mark is just the cardinality of the underlying finite set.
    have hR :
        Nat.card (MulAction.fixedPoints (⊥ : Subgroup G)
          (quotient_action G (⊥ : Subgroup G)).V) = 4 := by
      simpa [hbot] using
        card_fixedPoints_quotient_action_of_le
          (H := (⊥ : Subgroup G)) (K := (⊥ : Subgroup G)) bot_le
    have hT :
        Nat.card (MulAction.fixedPoints (⊥ : Subgroup G)
          (quotient_action G (⊤ : Subgroup G)).V) = 1 := by
      simpa [htop] using
        card_fixedPoints_quotient_action_of_le
          (H := (⊥ : Subgroup G)) (K := (⊤ : Subgroup G)) bot_le
    have hA :
        Nat.card (MulAction.fixedPoints (⊥ : Subgroup G)
          (quotient_action G (Subgroup.zpowers a)).V) = 2 := by
      simpa [natCard_quotient_zpowers_eq_two_of_ne_one, ha] using
        card_fixedPoints_quotient_action_of_le
          (H := (⊥ : Subgroup G)) (K := Subgroup.zpowers a) bot_le
    have hB :
        Nat.card (MulAction.fixedPoints (⊥ : Subgroup G)
          (quotient_action G (Subgroup.zpowers b)).V) = 2 := by
      simpa [natCard_quotient_zpowers_eq_two_of_ne_one, hb] using
        card_fixedPoints_quotient_action_of_le
          (H := (⊥ : Subgroup G)) (K := Subgroup.zpowers b) bot_le
    have hC :
        Nat.card (MulAction.fixedPoints (⊥ : Subgroup G)
          (quotient_action G (Subgroup.zpowers (a * b))).V) = 2 := by
      simpa [natCard_quotient_zpowers_eq_two_of_ne_one, hab1] using
        card_fixedPoints_quotient_action_of_le
          (H := (⊥ : Subgroup G)) (K := Subgroup.zpowers (a * b)) bot_le
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod]
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod]
    rw [hR, hT, hA, hB, hC]
  · -- At `⟨a⟩`, only the `a`-quotient contributes on the right-hand side.
    have hR :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers a)
          (quotient_action G (⊥ : Subgroup G)).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers a ≤ (⊥ : Subgroup G) := by
        intro hle
        have ha_mem : a ∈ (⊥ : Subgroup G) := hle (Subgroup.mem_zpowers a)
        have hEq : a = 1 := by simpa using ha_mem
        exact ha hEq
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers a) (K := (⊥ : Subgroup G)) hnot
    have hT :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers a)
          (quotient_action G (⊤ : Subgroup G)).V) = 1 := by
      simpa [htop] using
        card_fixedPoints_quotient_action_of_le
          (H := Subgroup.zpowers a) (K := (⊤ : Subgroup G)) le_top
    have hA :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers a)
          (quotient_action G (Subgroup.zpowers a)).V) = 2 := by
      simpa [natCard_quotient_zpowers_eq_two_of_ne_one, ha] using
        card_fixedPoints_quotient_action_of_le
          (H := Subgroup.zpowers a) (K := Subgroup.zpowers a) le_rfl
    have hB :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers a)
          (quotient_action G (Subgroup.zpowers b)).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers a ≤ Subgroup.zpowers b :=
        not_zpowers_le_of_ne_one_of_ne ha hb hab
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers a) (K := Subgroup.zpowers b) hnot
    have hC :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers a)
          (quotient_action G (Subgroup.zpowers (a * b))).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers a ≤ Subgroup.zpowers (a * b) :=
        not_zpowers_le_of_ne_one_of_ne ha hab1 haba.symm
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers a) (K := Subgroup.zpowers (a * b)) hnot
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod]
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod]
    rw [hR, hT, hA, hB, hC]
  · -- At `⟨b⟩`, the same table appears with the roles of `a` and `b` exchanged.
    have hR :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers b)
          (quotient_action G (⊥ : Subgroup G)).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers b ≤ (⊥ : Subgroup G) := by
        intro hle
        have hb_mem : b ∈ (⊥ : Subgroup G) := hle (Subgroup.mem_zpowers b)
        have hEq : b = 1 := by simpa using hb_mem
        exact hb hEq
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers b) (K := (⊥ : Subgroup G)) hnot
    have hT :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers b)
          (quotient_action G (⊤ : Subgroup G)).V) = 1 := by
      simpa [htop] using
        card_fixedPoints_quotient_action_of_le
          (H := Subgroup.zpowers b) (K := (⊤ : Subgroup G)) le_top
    have hA :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers b)
          (quotient_action G (Subgroup.zpowers a)).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers b ≤ Subgroup.zpowers a :=
        not_zpowers_le_of_ne_one_of_ne hb ha hab.symm
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers b) (K := Subgroup.zpowers a) hnot
    have hB :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers b)
          (quotient_action G (Subgroup.zpowers b)).V) = 2 := by
      simpa [natCard_quotient_zpowers_eq_two_of_ne_one, hb] using
        card_fixedPoints_quotient_action_of_le
          (H := Subgroup.zpowers b) (K := Subgroup.zpowers b) le_rfl
    have hC :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers b)
          (quotient_action G (Subgroup.zpowers (a * b))).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers b ≤ Subgroup.zpowers (a * b) :=
        not_zpowers_le_of_ne_one_of_ne hb hab1 habb.symm
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers b) (K := Subgroup.zpowers (a * b)) hnot
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod]
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod]
    rw [hR, hT, hA, hB, hC]
  · -- At `⟨a * b⟩`, only the third index-two quotient contributes on the right-hand side.
    have hR :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers (a * b))
          (quotient_action G (⊥ : Subgroup G)).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers (a * b) ≤ (⊥ : Subgroup G) := by
        intro hle
        have hab_mem : a * b ∈ (⊥ : Subgroup G) := hle (Subgroup.mem_zpowers (a * b))
        have hEq : a * b = 1 := by simpa using hab_mem
        exact hab1 hEq
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers (a * b)) (K := (⊥ : Subgroup G)) hnot
    have hT :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers (a * b))
          (quotient_action G (⊤ : Subgroup G)).V) = 1 := by
      simpa [htop] using
        card_fixedPoints_quotient_action_of_le
          (H := Subgroup.zpowers (a * b)) (K := (⊤ : Subgroup G)) le_top
    have hA :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers (a * b))
          (quotient_action G (Subgroup.zpowers a)).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers (a * b) ≤ Subgroup.zpowers a :=
        not_zpowers_le_of_ne_one_of_ne hab1 ha haba
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers (a * b)) (K := Subgroup.zpowers a) hnot
    have hB :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers (a * b))
          (quotient_action G (Subgroup.zpowers b)).V) = 0 := by
      have hnot : ¬ Subgroup.zpowers (a * b) ≤ Subgroup.zpowers b :=
        not_zpowers_le_of_ne_one_of_ne hab1 hb habb
      exact card_fixedPoints_quotient_action_of_not_le
        (H := Subgroup.zpowers (a * b)) (K := Subgroup.zpowers b) hnot
    have hC :
        Nat.card (MulAction.fixedPoints (Subgroup.zpowers (a * b))
          (quotient_action G (Subgroup.zpowers (a * b))).V) = 2 := by
      simpa [natCard_quotient_zpowers_eq_two_of_ne_one, hab1] using
        card_fixedPoints_quotient_action_of_le
          (H := Subgroup.zpowers (a * b)) (K := Subgroup.zpowers (a * b)) le_rfl
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod]
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod]
    rw [hR, hT, hA, hB, hC]

/-- Helper for Exercise 13-13.1-15: the top subgroup distinguishes the two standard Klein-four
quotient sums. -/
lemma top_fixedpoint_counts_standard_counterexample
    {G : Type u} [Group G] [Finite G] [IsKleinFour G] [IsMulCommutative G]
    {a b : G} (ha : a ≠ 1) (hb : b ≠ 1) (hab : a ≠ b) :
    Nat.card (MulAction.fixedPoints (⊤ : Subgroup G)
      (standard_counterexample_left_action G).V) = 2 ∧
      Nat.card (MulAction.fixedPoints (⊤ : Subgroup G)
        (standard_counterexample_right_action G a b).V) = 0 := by
  have htop : Nat.card (G ⧸ (⊤ : Subgroup G)) = 1 := natCard_quotient_top_eq_one
  have hab1 : a * b ≠ 1 := by
    -- As above, `a * b = 1` would collapse the two chosen nontrivial elements.
    intro hab1
    have : b = a := by
      calc
        b = 1 * b := by simp
        _ = (a * a) * b := by rw [IsKleinFour.mul_self a]
        _ = a * (a * b) := by simp [mul_assoc]
        _ = a := by rw [hab1]; simp
    exact hab this.symm
  have haba : a * b ≠ a := by
    -- As above, `a * b = a` would force `b = 1`.
    intro haba
    have : b = 1 := by
      calc
        b = 1 * b := by simp
        _ = (a * a) * b := by rw [IsKleinFour.mul_self a]
        _ = a * (a * b) := by simp [mul_assoc]
        _ = a * a := by rw [haba]
        _ = 1 := IsKleinFour.mul_self a
    exact hb this
  have hR :
      Nat.card (MulAction.fixedPoints (⊤ : Subgroup G)
        (quotient_action G (⊥ : Subgroup G)).V) = 0 := by
    have hnot : ¬ (⊤ : Subgroup G) ≤ (⊥ : Subgroup G) := by
      intro hle
      have ha_mem : a ∈ (⊥ : Subgroup G) := hle (by simp)
      have hEq : a = 1 := by simpa using ha_mem
      exact ha hEq
    simpa [quotient_action, hnot] using
      (card_fixedPoints_quotient_of_le_or_not_le
        (H := (⊤ : Subgroup G)) (K := (⊥ : Subgroup G)))
  have hT :
      Nat.card (MulAction.fixedPoints (⊤ : Subgroup G)
        (quotient_action G (⊤ : Subgroup G)).V) = 1 := by
    simpa [quotient_action, htop] using
      (card_fixedPoints_quotient_of_le_or_not_le
        (H := (⊤ : Subgroup G)) (K := (⊤ : Subgroup G)))
  have hA :
      Nat.card (MulAction.fixedPoints (⊤ : Subgroup G)
        (quotient_action G (Subgroup.zpowers a)).V) = 0 := by
    have hnot : ¬ (⊤ : Subgroup G) ≤ Subgroup.zpowers a := by
      intro hle
      have hb_mem : b ∈ Subgroup.zpowers a := hle (by simp)
      rcases eq_one_or_eq_generator_of_mem_zpowers_of_ne_one ha hb_mem with h1 | hEq
      · exact hb h1
      · exact hab hEq.symm
    simpa [quotient_action, hnot] using
      (card_fixedPoints_quotient_of_le_or_not_le
        (H := (⊤ : Subgroup G)) (K := Subgroup.zpowers a))
  have hB :
      Nat.card (MulAction.fixedPoints (⊤ : Subgroup G)
        (quotient_action G (Subgroup.zpowers b)).V) = 0 := by
    have hnot : ¬ (⊤ : Subgroup G) ≤ Subgroup.zpowers b := by
      intro hle
      have ha_mem : a ∈ Subgroup.zpowers b := hle (by simp)
      rcases eq_one_or_eq_generator_of_mem_zpowers_of_ne_one hb ha_mem with h1 | hEq
      · exact ha h1
      · exact hab hEq
    simpa [quotient_action, hnot] using
      (card_fixedPoints_quotient_of_le_or_not_le
        (H := (⊤ : Subgroup G)) (K := Subgroup.zpowers b))
  have hC :
      Nat.card (MulAction.fixedPoints (⊤ : Subgroup G)
        (quotient_action G (Subgroup.zpowers (a * b))).V) = 0 := by
    have hnot : ¬ (⊤ : Subgroup G) ≤ Subgroup.zpowers (a * b) := by
      intro hle
      have ha_mem : a ∈ Subgroup.zpowers (a * b) := hle (by simp)
      rcases eq_one_or_eq_generator_of_mem_zpowers_of_ne_one hab1 ha_mem with h1 | hEq
      · exact ha h1
      · exact haba hEq.symm
    simpa [quotient_action, hnot] using
      (card_fixedPoints_quotient_of_le_or_not_le
        (H := (⊤ : Subgroup G)) (K := Subgroup.zpowers (a * b)))
  constructor
  · -- The left action keeps exactly the two trivial summands fixed by the whole group.
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod, hR, hT]
  · -- The right action has no global fixed point because none of its transitive quotients is
    -- trivial.
    rw [card_fixedPoints_coprod, card_fixedPoints_coprod, hA, hB, hC]

/-- For a Klein four-group, there exist weakly isomorphic finite `G`-sets that are not
isomorphic. -/
theorem exists_weaklyIsomorphic_not_isomorphic_for_kleinFourGroup
    (G : Type u) [Group G] [IsKleinFour G] :
    ∃ X Y : Action FintypeCat.{u} G, WeaklyIsomorphic X Y ∧ ¬ IsIsomorphic X Y := by
  -- Route correction: the Burnside-mark converse is already proved above. The remaining step is
  -- the explicit Klein-four fixed-point table from LinearRepresentations_Serre_1977's standard counterexample.
  letI : Finite G := IsKleinFour.instFinite
  letI : IsMulCommutative G := IsKleinFour.isMulCommutative
  obtain ⟨a, b, ha, hb, hab⟩ :=
    exists_two_distinct_nontrivial_elements_of_kleinFour (G := G)
  let X : Action FintypeCat G := standard_counterexample_left_action G
  let Y : Action FintypeCat G := standard_counterexample_right_action G a b
  refine ⟨X, Y, ?_, ?_⟩
  · -- Equality of cyclic fixed-point marks yields weak isomorphism.
    change (standard_counterexample_left_action G).WeaklyIsomorphic
      (standard_counterexample_right_action G a b)
    refine
      (weaklyIsomorphic_iff_card_fixedPoints_eq_forall_isCyclic
        (X := standard_counterexample_left_action G)
        (Y := standard_counterexample_right_action G a b)).2 ?_
    exact cyclic_fixedpoint_counts_standard_counterexample ha hb hab
  · -- The top subgroup already distinguishes the two actions, so they cannot be isomorphic.
    change ¬ IsIsomorphic
      (standard_counterexample_left_action G) (standard_counterexample_right_action G a b)
    intro hIso
    have hfixed :=
      (isomorphic_iff_card_fixedPoints_eq_forall_subgroup
        (X := standard_counterexample_left_action G)
        (Y := standard_counterexample_right_action G a b)).1 hIso
    obtain ⟨hXtop, hYtop⟩ := top_fixedpoint_counts_standard_counterexample ha hb hab
    have htop := hfixed ⊤
    rw [hXtop, hYtop] at htop
    omega
end

