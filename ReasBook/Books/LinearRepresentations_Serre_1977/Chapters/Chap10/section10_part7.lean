/-! ### Remark_10_10_5_3 (from Chap10) -/
noncomputable section

namespace Representation

open scoped BigOperators Representation SubgroupInduction

/-
Source/core/bridge triage:
* `source-facing`: the remark-level claim that Brauer induction cannot, in general, be realized
  with only nonnegative integer coefficients of monomial characters.
* `core/canonical`: `Representation.IsMonomialCharacter` together with the integral character-ring
  owner `R(G)`.
* `bridge/view`: the concrete Chapter 8 witness
  `hurwitzQuaternionMatrixRepresentation.character`, viewed in `R(hurwitzQuaternionGroup)`, and
  the additive submonoid generated by the monomial characters inside that owner.

Sampled owner declarations in this domain:
* `Representation.IsMonomial`
* `Representation.IsMonomialCharacter`
* `Representation.monomialCharacterSpan`
* `Representation.hurwitzQuaternionMatrixRepresentation`

Primitive data versus derived API:
the primitive data for the canonical witness is already packaged upstream by the Hurwitz
quaternion representation from Chapter 8, so its character should be used directly inside the
owner `R(G)` rather than via a stronger ambient-function statement. The additive-closure and
finite-sum formulations are derived API expressing the source remark's failure of nonnegative
integral Brauer coefficients.
-/

private abbrev hurwitzQuaternionCharacter : R[ℂ](hurwitzQuaternionGroup) :=
  ⟨hurwitzQuaternionMatrixRepresentation.character,
    rep_character_mem_characterRing (Rep.of hurwitzQuaternionMatrixRepresentation)⟩

/-- Helper for Remark 10-10.5-3: the Hurwitz quaternion character has degree `2`, so its value at
`1` is `2`. -/
private theorem hurwitzQuaternionCharacter_one :
    hurwitzQuaternionCharacter 1 = (2 : ℂ) := by
  -- Evaluate the Chapter 8 witness at the identity and rewrite by the finite-dimensional degree.
  simpa [hurwitzQuaternionCharacter, Representation.char_one]

/-- Helper for Remark 10-10.5-3: the induced character of a linear character has degree equal to
the index of the inducing subgroup. -/
private theorem induced_linear_character_one_eq_index
    (H : Subgroup hurwitzQuaternionGroup) (α : H →* ℂˣ) :
    Ind[H](α.toRepresentation.character) 1 = (H.index : ℂ) := by
  letI : Fintype hurwitzQuaternionGroup := Fintype.ofFinite hurwitzQuaternionGroup
  -- The imported induced-value formula already records the identity value as `index * χ(1)`.
  simpa [Representation.char_one] using
    (Subgroup.inducedClassFunction_one_eq_index_mul_value
      (H := H) (χ := α.toRepresentation.character))

/-- Helper for Remark 10-10.5-3: the normalized pairing is additive on finite sums in its right
argument. -/
private theorem groupFunctionPairing_sum_right_local
    {ι : Type} (ψ : hurwitzQuaternionGroup → ℂ) (s : Finset ι)
    (χ : ι → hurwitzQuaternionGroup → ℂ) :
    ⟪ψ, ∑ i ∈ s, χ i⟫ = ∑ i ∈ s, ⟪ψ, χ i⟫ := by
  classical
  -- Expand the finite sum one term at a time and use additivity in the right argument.
  induction s using Finset.induction_on with
  | empty =>
      simp [Representation.groupFunctionPairingOverField]
  | insert i s hi ih =>
      simp [Finset.sum_insert, hi, ih, Representation.groupFunctionPairing_add_right]

/-- Helper for Remark 10-10.5-3: an index-`1` monomial summand is orthogonal to the Hurwitz
character because it would otherwise be isomorphic to the degree-`2` irreducible witness. -/
private theorem hurwitz_pairing_induced_linear_character_eq_zero_of_index_one
    (H : Subgroup hurwitzQuaternionGroup) (α : H →* ℂˣ) (hH : H.index = 1) :
    ⟪hurwitzQuaternionMatrixRepresentation.character, Ind[H](α.toRepresentation.character)⟫ = 0 := by
  letI : Fintype hurwitzQuaternionGroup := Fintype.ofFinite hurwitzQuaternionGroup
  letI : NeZero (Nat.card hurwitzQuaternionGroup : ℂ) :=
    ⟨Nat.cast_ne_zero.mpr Nat.card_pos.ne'⟩
  letI : Invertible (Nat.card hurwitzQuaternionGroup : ℂ) :=
    invertibleOfNonzero (NeZero.ne (Nat.card hurwitzQuaternionGroup : ℂ))
  let ρ : Representation ℂ hurwitzQuaternionGroup
      (Representation.IndV H.subtype α.toRepresentation) :=
    Representation.ind H.subtype α.toRepresentation
  letI : FiniteDimensional ℂ (hurwitzQuaternionGroup →₀ ℂ) := by
    infer_instance
  letI : FiniteDimensional ℂ (TensorProduct ℂ (hurwitzQuaternionGroup →₀ ℂ) ℂ) := by
    infer_instance
  letI : FiniteDimensional ℂ (Representation.IndV H.subtype α.toRepresentation) :=
    FiniteDimensional.of_surjective (Representation.Coinvariants.mk _)
      (Representation.Coinvariants.mk_surjective _)
  have hchar :
      Ind[H](α.toRepresentation.character) = ρ.character := by
    have hHcard : (Nat.card H : ℂ) ≠ 0 := by
      exact_mod_cast (Nat.card_pos : 0 < Nat.card H).ne'
    letI : NeZero (Nat.card H : ℂ) := ⟨hHcard⟩
    simpa [ρ] using
      (Subgroup.inducedClassFunction_eq_character_ind
        (H := H) (K := ℂ) α.toRepresentation)
  letI : hurwitzQuaternionMatrixRepresentation.IsIrreducible :=
    hurwitzQuaternionMatrixRepresentation_isIrreducible
  -- The induced representation has degree `1`, hence is irreducible.
  have hρone : ρ.character 1 = (1 : ℂ) := by
    calc
      ρ.character 1 = Ind[H](α.toRepresentation.character) 1 := by
        simpa using congrFun hchar.symm 1
      _ = (1 : ℂ) := by
        simpa [hH] using induced_linear_character_one_eq_index H α
  have hρfinrankC : (Module.finrank ℂ (Representation.IndV H.subtype α.toRepresentation) : ℂ) = 1 := by
    calc
      (Module.finrank ℂ (Representation.IndV H.subtype α.toRepresentation) : ℂ) = ρ.character 1 := by
        simpa [ρ] using (Representation.char_one ρ).symm
      _ = 1 := hρone
  have hρfinrank : Module.finrank ℂ (Representation.IndV H.subtype α.toRepresentation) = 1 := by
    exact_mod_cast hρfinrankC
  letI : ρ.IsIrreducible := isIrreducible_of_finrank_eq_one ρ hρfinrank
  have hnotIso : ¬ Nonempty (hurwitzQuaternionMatrixRepresentation.Equiv ρ) := by
    intro hEq
    rcases hEq with ⟨e⟩
    -- Compare the values at `1`: the Hurwitz character has degree `2`, while `ρ` has degree `1`.
    have hcharEq : hurwitzQuaternionMatrixRepresentation.character = ρ.character :=
      Representation.char_iso e
    have hone := congrFun hcharEq 1
    have hHurwitzOne : hurwitzQuaternionMatrixRepresentation.character 1 = (2 : ℂ) := by
      simpa [Representation.char_one]
    rw [hHurwitzOne, hρone] at hone
    norm_num at hone
  -- Orthogonality of nonisomorphic irreducibles forces the pairing to vanish.
  letI : IsEmpty (hurwitzQuaternionMatrixRepresentation.Equiv ρ) :=
    not_nonempty_iff.mp hnotIso
  have hpairρ :
      ⟪hurwitzQuaternionMatrixRepresentation.character, ρ.character⟫ = 0 := by
    -- The intertwining space is zero because nonisomorphic irreducibles have only the zero map.
    calc
      ⟪hurwitzQuaternionMatrixRepresentation.character, ρ.character⟫ =
          (Module.finrank ℂ (hurwitzQuaternionMatrixRepresentation.IntertwiningMap ρ) : ℂ) := by
        simpa using
          (Representation.groupFunctionPairingOverField_character_eq_finrank_intertwiningMap
            ℂ hurwitzQuaternionMatrixRepresentation ρ)
      _ = 0 := by
        rw [Module.finrank_zero_of_subsingleton]
        norm_num
  calc
    ⟪hurwitzQuaternionMatrixRepresentation.character, Ind[H](α.toRepresentation.character)⟫ =
        ⟪hurwitzQuaternionMatrixRepresentation.character, ρ.character⟫ := by
      rw [hchar]
    _ = 0 := hpairρ

/-- The Hurwitz quaternion representation from Chapter 8 gives a concrete counterexample showing
that Brauer induction cannot, in general, be written using only nonnegative integral coefficients
of monomial characters. -/
theorem hurwitzQuaternion_character_not_mem_monomialCharacterAddSubmonoid :
    hurwitzQuaternionCharacter ∉ AddSubmonoid.closure
      {χ : R[ℂ](hurwitzQuaternionGroup) |
        IsMonomialCharacter (χ : hurwitzQuaternionGroup → ℂ)} := by
  letI : Fintype hurwitzQuaternionGroup := Fintype.ofFinite hurwitzQuaternionGroup
  letI : NeZero (Nat.card hurwitzQuaternionGroup : ℂ) :=
    ⟨Nat.cast_ne_zero.mpr Nat.card_pos.ne'⟩
  letI : Invertible (Nat.card hurwitzQuaternionGroup : ℂ) :=
    invertibleOfNonzero (NeZero.ne (Nat.card hurwitzQuaternionGroup : ℂ))
  intro hmem
  let S : Set (R[ℂ](hurwitzQuaternionGroup)) := {χ : R[ℂ](hurwitzQuaternionGroup) |
    IsMonomialCharacter (χ : hurwitzQuaternionGroup → ℂ)}
  -- Rewrite additive-closure membership as a natural linear combination of monomial characters.
  have hspan : hurwitzQuaternionCharacter ∈ Submodule.span ℕ S := by
    have hspan' :
        hurwitzQuaternionCharacter ∈
          ((Submodule.span ℕ S).toAddSubmonoid : Set (R[ℂ](hurwitzQuaternionGroup))) := by
      simpa [Submodule.span_nat_eq_addSubmonoidClosure] using hmem
    exact hspan'
  obtain ⟨l, hl⟩ :=
    (Finsupp.mem_span_iff_linearCombination
      (R := ℕ) (s := S) (x := hurwitzQuaternionCharacter)).mp hspan
  choose H α hchar using fun i : S => i.property
  have hpair_deg_one :
      ∀ i : S, (H i).index = 1 →
        ⟪hurwitzQuaternionMatrixRepresentation.character,
          ((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ)⟫ = 0 := by
    intro i hi
    calc
      ⟪hurwitzQuaternionMatrixRepresentation.character,
          ((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ)⟫ =
          ⟪hurwitzQuaternionMatrixRepresentation.character,
            Ind[H i]((α i).toRepresentation.character)⟫ := by
        rw [← hchar i]
      _ = 0 := hurwitz_pairing_induced_linear_character_eq_zero_of_index_one (H i) (α i) hi
  have hsum_fun :
      Finset.sum l.support
        (fun i ↦
          (l i : ℂ) •
            (((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ))) =
        (hurwitzQuaternionCharacter : hurwitzQuaternionGroup → ℂ) := by
    -- Coercing the `ℕ`-linear combination to functions turns `nsmul` into scalar multiplication.
    have hcoe :=
      congrArg
        ((↑) : R[ℂ](hurwitzQuaternionGroup) → hurwitzQuaternionGroup → ℂ) hl
    simpa [Finsupp.linearCombination_apply, Finsupp.sum, nsmul_eq_mul] using hcoe
  have hvalue_one :
      ∀ i : S,
        (((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ) 1) = (H i).index := by
    intro i
    calc
      (((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ) 1) =
          Ind[H i]((α i).toRepresentation.character) 1 := by
        rw [← hchar i]
      _ = (H i).index := induced_linear_character_one_eq_index (H i) (α i)
  have hdegree :
      Finset.sum l.support (fun i ↦ l i * (H i).index) = 2 := by
    -- Evaluate the decomposition at `1` to record the total degree `2`.
    have hone := congrFun hsum_fun 1
    have hdegreeC :
        ((Finset.sum l.support (fun i ↦ l i * (H i).index) : ℕ) : ℂ) = 2 := by
      simpa [hvalue_one, hurwitzQuaternionCharacter_one, nsmul_eq_mul, Nat.cast_mul,
        mul_assoc, mul_left_comm, mul_comm] using hone
    exact_mod_cast hdegreeC
  have hpair_self :
      ⟪hurwitzQuaternionMatrixRepresentation.character,
          hurwitzQuaternionMatrixRepresentation.character⟫ = (1 : ℂ) := by
    letI : hurwitzQuaternionMatrixRepresentation.IsIrreducible :=
      hurwitzQuaternionMatrixRepresentation_isIrreducible
    -- The Hurwitz representation is irreducible, so its self-pairing is `1`.
    calc
      ⟪hurwitzQuaternionMatrixRepresentation.character,
          hurwitzQuaternionMatrixRepresentation.character⟫ =
          (Module.finrank ℂ
            (hurwitzQuaternionMatrixRepresentation.IntertwiningMap
              hurwitzQuaternionMatrixRepresentation) : ℂ) := by
        simpa using
          (Representation.groupFunctionPairingOverField_character_eq_finrank_intertwiningMap
            ℂ hurwitzQuaternionMatrixRepresentation hurwitzQuaternionMatrixRepresentation)
      _ = 1 := by
        simpa using
          (Representation.IsIrreducible.finrank_intertwiningMap_self
            (k := ℂ) (ρ := hurwitzQuaternionMatrixRepresentation))
  have hpair_sum :
      Finset.sum l.support
        (fun i ↦
          (l i : ℂ) *
            ⟪hurwitzQuaternionMatrixRepresentation.character,
              ((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ)⟫) = 1 := by
    -- Pair the decomposition with the Hurwitz character and expand by linearity.
    calc
      Finset.sum l.support
          (fun i ↦
            (l i : ℂ) *
              ⟪hurwitzQuaternionMatrixRepresentation.character,
                ((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ)⟫) =
          ⟪hurwitzQuaternionMatrixRepresentation.character,
            Finset.sum l.support
              (fun i ↦
                (l i : ℂ) •
                  ((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ))⟫ := by
        rw [groupFunctionPairing_sum_right_local
          (ψ := hurwitzQuaternionMatrixRepresentation.character)
          (s := l.support)
          (χ := fun i ↦
            (l i : ℂ) •
              ((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ))]
        simp [Representation.groupFunctionPairing_smul_right, mul_assoc, mul_left_comm, mul_comm]
      _ = ⟪hurwitzQuaternionMatrixRepresentation.character,
            (hurwitzQuaternionCharacter : hurwitzQuaternionGroup → ℂ)⟫ := by
        rw [hsum_fun]
      _ = 1 := by
        simpa [hurwitzQuaternionCharacter] using hpair_self
  have hexists_large :
      ∃ i ∈ l.support, (H i).index ≠ 1 := by
    by_contra hlarge
    have hall_one : ∀ i ∈ l.support, (H i).index = 1 := by
      intro i hi
      by_contra hne
      exact hlarge ⟨i, hi, hne⟩
    have hpair_zero :
        Finset.sum l.support
          (fun i ↦
            (l i : ℂ) *
              ⟪hurwitzQuaternionMatrixRepresentation.character,
                ((i.1 : R[ℂ](hurwitzQuaternionGroup)) : hurwitzQuaternionGroup → ℂ)⟫) = 0 := by
      apply Finset.sum_eq_zero
      intro i hi
      rw [hpair_deg_one i (hall_one i hi)]
      simp
    rw [hpair_zero] at hpair_sum
    norm_num at hpair_sum
  rcases hexists_large with ⟨i, hi, hi_ne_one⟩
  have hli_pos : 0 < l i := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hi)
  have hindex_pos : 0 < (H i).index := Nat.pos_of_ne_zero (H i).index_ne_zero_of_finite
  have hindex_ge_two : 2 ≤ (H i).index := by
    omega
  have hterm_le : l i * (H i).index ≤ 2 := by
    have hle :
        l i * (H i).index ≤ Finset.sum l.support (fun j ↦ l j * (H j).index) := by
      simpa using
        (Finset.single_le_sum
          (s := l.support) (a := i) (f := fun j ↦ l j * (H j).index)
          (fun j hj => Nat.zero_le _) hi)
    omega
  have hindex_lt_three : (H i).index < 3 := by
    by_contra hnotlt
    have hthree_le : 3 ≤ (H i).index := Nat.not_lt.mp hnotlt
    have hone_le : 1 ≤ l i := Nat.succ_le_of_lt hli_pos
    have hthree_term : 3 ≤ l i * (H i).index := by
      calc
        3 ≤ 1 * (H i).index := by simpa using hthree_le
        _ ≤ l i * (H i).index := by
          simpa using Nat.mul_le_mul_right (H i).index hone_le
    omega
  have hindex_eq_two : (H i).index = 2 := by
    omega
  exact hurwitzQuaternionGroup_index_ne_two (H i) hindex_eq_two

/-- Any finite sum of monomial characters on the Hurwitz quaternion group differs from its
degree-`2` irreducible character. -/
theorem hurwitzQuaternion_character_ne_sum_monomialCharacters
    {ι : Type} [Fintype ι] (χ : ι → R[ℂ](hurwitzQuaternionGroup))
    (hχ : ∀ i, IsMonomialCharacter (χ i : hurwitzQuaternionGroup → ℂ)) :
    (∑ i, χ i) ≠ hurwitzQuaternionCharacter := by
  intro hsum
  apply hurwitzQuaternion_character_not_mem_monomialCharacterAddSubmonoid
  rw [← hsum]
  show ∑ i, χ i ∈
      AddSubmonoid.closure
        {χ : R[ℂ](hurwitzQuaternionGroup) |
          IsMonomialCharacter (χ : hurwitzQuaternionGroup → ℂ)}
  simpa using
    (AddSubmonoid.closure
      {χ : R[ℂ](hurwitzQuaternionGroup) |
        IsMonomialCharacter (χ : hurwitzQuaternionGroup → ℂ)}).sum_mem
      (fun i _ ↦ AddSubmonoid.subset_closure (hχ i))

/-- Remark 10-10.5-3: there exists a finite group and a finite-dimensional complex representation
whose character is not a finite sum of monomial characters; equivalently, Brauer's theorem cannot
in general be realized using only nonnegative integral coefficients of monomial characters. -/
theorem exists_character_not_mem_monomialCharacterAddSubmonoid :
    ∃ (G : Type) (_ : Group G) (_ : Finite G) (V : FDRep ℂ G),
      (⟨V.character, rep_character_mem_characterRing (Rep.of V.ρ)⟩ : R[ℂ](G)) ∉
        AddSubmonoid.closure {χ : R[ℂ](G) | IsMonomialCharacter (χ : G → ℂ)} := by
  refine
    ⟨hurwitzQuaternionGroup, inferInstance, inferInstance,
      FDRep.of hurwitzQuaternionMatrixRepresentation, ?_⟩
  simpa using hurwitzQuaternion_character_not_mem_monomialCharacterAddSubmonoid

end Representation

/-! ### Remark_10_10_5_4 (from Chap10) -/
noncomputable section

namespace Representation

section

variable {G : Type} [Group G] [Finite G]

/- Source/core/bridge triage:
* `source-facing`: the remark-level restatement that Brauer induction reduces characters to the
  span of degree-`1` subgroup characters, together with the standard consequence that the image of
  a degree-`1` character is cyclic.
* `core/canonical`: `IsMonomialCharacter`, `character_mem_monomialCharacterSpan`,
  `MonoidHom.finite_iff_finite_ker_range`, and mathlib's canonical cyclicity owner for finite
  subgroups of units in an integral domain.
* `bridge/view`: `degree_one_character_range_isCyclic`, which specializes that owner to the range
  of a degree-`1` complex character `χ : G →* ℂˣ`.

Sampled owner declarations in this domain:
* `Representation.IsMonomialCharacter`
* `Representation.character_mem_monomialCharacterSpan`
* `MonoidHom.finite_iff_finite_ker_range`
* `RingTheory.IntegralDomain.isCyclic_subgroup_units`

Primitive data versus derived API:
the source-facing content of this remark is already owned upstream by the chapter-level monomial
character declarations. The cyclic-image statement for a degree-`1` character is derived API: its
primitive data is only the homomorphism `χ`; finite image is derived canonically from the
homomorphism owner `MonoidHom.finite_iff_finite_ker_range`, and cyclicity is then supplied by the
existing finite-subgroup-of-`ℂˣ` owner, not by new local structure. -/

/- Remark 10-10.5-4: the chapter's source-facing reduction to degree-`1` characters is already
owned by `IsMonomialCharacter`, whose defining data is induction from a one-dimensional complex
representation of a subgroup. The further reduction to cyclic groups, and the application to
Artin `L`-functions mentioned by LinearRepresentations_Serre_1977, are expository consequences of this canonical owner rather
than new declaration-level mathematics in this file. -/
recall IsMonomialCharacter

/- The actual Brauer-induction reduction theorem used by the remark is the canonical chapter-level
statement that every character of `G` belongs to the monomial-character span. -/
recall character_mem_monomialCharacterSpan

/-- Remark 10-10.5-4: the image of a degree-`1` complex character of a finite group is cyclic. -/
theorem degree_one_character_range_isCyclic (χ : G →* ℂˣ) : IsCyclic χ.range := by
  haveI : Finite χ.range := ((MonoidHom.finite_iff_finite_ker_range χ).1 inferInstance).2
  infer_instance

end

/- In this cyclic form, Brauer's induction theorem gives the classical application to Artin
`L`-functions. -/

end Representation

/-! ### Theorem_10_10_5_1 (from Chap10) -/
noncomputable section

open Representation
open scoped Representation

section

variable {G : Type} [Group G] [Finite G]

-- Proof sketch: let `W := ⨆ p, V[p](G)`. By Theorem `10-10.2-1`, the index of `W` in `R(G)` is
-- coprime to every prime, hence equal to `1`; therefore `W = R(G)`.
/-- Theorem 10-10.5-1: Brauer's subgroups `V_p` generated by characters induced from
`p`-elementary subgroups span the whole character ring `R(G)`. -/
theorem iSup_pElementaryInducedCharacterSpan_eq_top :
    (⨆ p : Nat.Primes, V[p](G)) = ⊤ := by
  let W : Submodule ℤ (R(G)) := ⨆ p : Nat.Primes, V[p](G)
  have hW_index : W.toAddSubgroup.index = 1 := by
    refine (Nat.eq_one_iff_not_exists_prime_dvd).2 ?_
    intro p hp hpdvd
    let q : Nat.Primes := ⟨p, hp⟩
    have hVq_le : V[q](G) ≤ W :=
      le_iSup (fun r : Nat.Primes ↦ V[r](G)) q
    have hW_dvd : W.toAddSubgroup.index ∣ (V[q](G)).toAddSubgroup.index :=
      AddSubgroup.index_dvd_of_le hVq_le
    have hq_coprime : Nat.Coprime p (V[q](G)).toAddSubgroup.index :=
      by simpa using (pElementaryInducedCharacterSpan_finiteIndex_and_index_coprime q).2
    have hW_coprime : Nat.Coprime p W.toAddSubgroup.index :=
      Nat.Coprime.of_dvd_right hW_dvd hq_coprime
    exact (hp.coprime_iff_not_dvd.1 hW_coprime) hpdvd
  simpa [W] using
    (Submodule.toAddSubgroup_eq_top.1 (AddSubgroup.index_eq_one.1 hW_index))

/-- Every character of `G` belongs to the supremum of Brauer's subgroups `V_p`. -/
theorem character_mem_iSup_pElementaryInducedCharacterSpan (χ : R(G)) :
    χ ∈ (⨆ p : Nat.Primes, V[p](G)) := by
  simp [iSup_pElementaryInducedCharacterSpan_eq_top]

end

/-! ### Theorem_10_10_5_2 (from Chap10) -/
noncomputable section

namespace Representation

open CategoryTheory Rep
open scoped Representation SubgroupInduction
open scoped BigOperators Pointwise

section

variable {G : Type} [Group G] [Finite G]

/-- A subgroup of a finite group is finite. -/
local instance theorem_10_10_5_2_target_fintype_of_finite : Fintype G := Fintype.ofFinite G

/-- A subgroup of a finite group is finite. -/
local instance theorem_10_10_5_2_target_subgroup_fintype_of_finite (H : Subgroup G) :
    Fintype H := Fintype.ofFinite H

/-- Helper for Theorem 10-10.5-2: the character of an irreducible finite-dimensional complex
representation of an elementary group is monomial. -/
theorem fdRepCharacterRing_mem_monomialCharacterSpan_of_irreducible
    (V : FDRep ℂ G) [CategoryTheory.Simple V] (hG : IsElementary G) :
    fdRepCharacterRing V ∈ monomialCharacterSpan G := by
  -- Reduce the target to the representation-level monomiality bridge isolated just above.
  exact
    fdRepCharacterRing_mem_monomialCharacterSpan_of_isMonomial V
      (fdRep_isMonomial_of_simple_of_isElementary V hG)

/-- Helper for Theorem 10-10.5-2: every honest finite-dimensional character of an elementary
group belongs to the monomial-character span. -/
theorem rep_character_mem_monomialCharacterSpan_of_isElementary
    (V : FDRep ℂ G) (hG : IsElementary G) :
    fdRepCharacterRing V ∈ monomialCharacterSpan G := by
  classical
  have hcard_ne : (Nat.card G : ℂ) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr Nat.card_pos.ne'
  letI : NeZero (Nat.card G : ℂ) := ⟨hcard_ne⟩
  obtain ⟨κ, _, σ, hσ_indep, hσ_top, hσ_irr⟩ :
      ∃ (κ : Type) (_ : Fintype κ) (σ : κ → Subrepresentation V.ρ),
        iSupIndep (fun i ↦ (σ i).toSubmodule) ∧
          (⨆ i, (σ i).toSubmodule) = ⊤ ∧
          ∀ i, (σ i).toRepresentation.IsIrreducible :=
    exists_isInternal_irreducible_subrepresentations (ρ := V.ρ)
  let hinternal : DirectSum.IsInternal (fun i : κ ↦ (σ i).toSubmodule) :=
    DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top hσ_indep hσ_top
  have hchar :
      V.character = ∑ i : κ, ((σ i).toRepresentation).character := by
    -- Decompose the trace of `V g` along the internal direct sum of irreducible summands.
    ext g
    simpa [Representation.character] using
      (LinearMap.trace_eq_sum_trace_restrict
        (R := ℂ) (M := V) (N := fun i ↦ (σ i).toSubmodule) hinternal
        (f := V.ρ g) (hf := fun i ↦ (σ i).apply_mem_toSubmodule g))
  have hring :
      fdRepCharacterRing V = ∑ i : κ, fdRepCharacterRing (FDRep.of (σ i).toRepresentation) := by
    -- Bundle the character decomposition inside `R(G)`.
    apply Subtype.ext
    ext g
    simpa [fdRepCharacterRing] using congrFun hchar g
  rw [hring]
  -- Each irreducible summand is already monomial on an elementary group, so the finite sum stays
  -- inside the monomial-character span.
  refine Submodule.sum_mem _ ?_
  intro i hi
  let τ : FDRep ℂ G := FDRep.of (σ i).toRepresentation
  letI : Representation.IsIrreducible τ.ρ := by
    simpa [τ] using hσ_irr i
  letI : CategoryTheory.Simple τ := FDRep.simple_of_isIrreducible τ
  simpa [τ] using
    fdRepCharacterRing_mem_monomialCharacterSpan_of_irreducible τ hG

/-- Helper for Theorem 10-10.5-2: an elementary finite group has monomial-character span equal to
its full character ring. -/
theorem monomialCharacterSpan_eq_top_of_isElementary
    (hG : IsElementary G) :
    monomialCharacterSpan G = ⊤ := by
  -- Reduce the elementary endpoint to the single honest-character membership statement above.
  refine top_unique ?_
  rw [← rep_character_span_eq_top (G := G)]
  rw [Submodule.span_le]
  intro χ hχ
  rcases hχ with ⟨V, rfl⟩
  exact rep_character_mem_monomialCharacterSpan_of_isElementary V hG

/-- Helper for Theorem 10-10.5-2: inducing a tensor character from any `p`-elementary subgroup
already lands in the realized local scalar span of `V[p](G)`. -/
private theorem induced_tensor_character_on_pElementary_subgroup_mem_local_scalar_span
    (p : Nat.Primes) (H : Subgroup G) (hH : IsPElementary (p : ℕ) H)
    (ψ : pElementaryScalarExtensionRing_local ⊗R(H)) :
    let W : Submodule pElementaryScalarExtensionRing_local (G → ℂ) :=
      Submodule.span pElementaryScalarExtensionRing_local
        { φ : G → ℂ | ∃ β : V[p](G), φ = ((β : R(G)) : G → ℂ) }
    Ind[H]((ψ : H → ℂ)) ∈ W := by
  let W : Submodule pElementaryScalarExtensionRing_local (G → ℂ) :=
    Submodule.span pElementaryScalarExtensionRing_local
      { φ : G → ℂ | ∃ β : V[p](G), φ = ((β : R(G)) : G → ℂ) }
  -- This is exactly the support-file bridge theorem, restated in the local notation of the main
  -- proof.
  simpa [W] using
    induced_tensor_character_mem_pElementary_scalarExtension_local
      (G := G) (p := (p : ℕ)) H hH ψ

-- Proof sketch: rewrite `V[p](G)` as the supremum of the ranges of the subgroup induction maps
-- over the `p`-elementary subgroups of `G`, then use the elementary `= ⊤` theorem and induction
-- closure of `monomialCharacterSpan`.
/-- Helper for Theorem 10-10.5-2: every Brauer submodule `V[p](G)` is contained in the
monomial-character span. -/
theorem pElementaryInducedCharacterSpan_le_monomialCharacterSpan (p : Nat.Primes) :
    V[p](G) ≤ monomialCharacterSpan G := by
  classical
  -- Route correction: the Brauer owner `V[p](G)` is a supremum of full `characterRingInduction`
  -- ranges, so the proof has to use the stronger elementary statement `= ⊤`, not only honest
  -- character membership.
  rw [Representation.pElementaryInducedCharacterSpan]
  simp_rw [Representation.artinInducedCharacterSubmodule]
  refine iSup_le ?_
  intro H
  rcases H with ⟨H, hHmem⟩
  have hH : IsPElementary (p : ℕ) H := by
    simpa using (Finset.mem_filter.mp hHmem).2
  -- Replace the induction range by the image of `⊤`, then apply the elementary `= ⊤` theorem.
  calc
    LinearMap.range (Representation.Subgroup.characterRingInduction H) =
        Submodule.map (Representation.Subgroup.characterRingInduction H) ⊤ := by
      rw [LinearMap.range_eq_map]
    _ ≤ Submodule.map (Representation.Subgroup.characterRingInduction H)
        (monomialCharacterSpan H) := by
      rw [monomialCharacterSpan_eq_top_of_isElementary ⟨p, hH⟩]
    _ ≤ monomialCharacterSpan G :=
        Representation.Subgroup.characterRingInduction_map_monomialCharacterSpan H

/-- Helper for Theorem 10-10.5-2: a submodule of the character ring whose additive index is `1`
is already the whole character ring. -/
private theorem eq_top_of_toAddSubgroup_index_eq_one
    (W : Submodule ℤ (R(G))) (hW_index : W.toAddSubgroup.index = 1) :
    W = ⊤ := by
  -- Translate the additive subgroup criterion back to the ambient `ℤ`-submodule.
  simpa using
    (Submodule.toAddSubgroup_eq_top.1 (AddSubgroup.index_eq_one.1 hW_index))

/-- Helper for Theorem 10-10.5-2: if each Brauer owner `V[q](G)` has additive index coprime to
its defining prime `q`, then their supremum is already the whole character ring. -/
private theorem iSup_pElementaryInducedCharacterSpan_eq_top_of_primewise_index_coprime
    (hcoprime : ∀ q : Nat.Primes, Nat.Coprime q (V[q](G)).toAddSubgroup.index) :
    (⨆ p : Nat.Primes, V[p](G)) = ⊤ := by
  let W : Submodule ℤ (R(G)) := ⨆ p : Nat.Primes, V[p](G)
  have hW_index : W.toAddSubgroup.index = 1 := by
    -- Brauer's standard index argument: `W` sits above each `V[q](G)`, so its index divides every
    -- primewise index and is therefore coprime to every prime.
    refine (Nat.eq_one_iff_not_exists_prime_dvd).2 ?_
    intro p hp hpdvd
    let q : Nat.Primes := ⟨p, hp⟩
    have hVq_le : V[q](G) ≤ W :=
      le_iSup (fun r : Nat.Primes ↦ V[r](G)) q
    have hW_dvd : W.toAddSubgroup.index ∣ (V[q](G)).toAddSubgroup.index :=
      AddSubgroup.index_dvd_of_le hVq_le
    have hW_coprime : Nat.Coprime p W.toAddSubgroup.index :=
      Nat.Coprime.of_dvd_right hW_dvd (by simpa using hcoprime q)
    exact (hp.coprime_iff_not_dvd.1 hW_coprime) hpdvd
  -- Once the additive index is `1`, the supremum submodule must be all of `R(G)`.
  simpa [W] using eq_top_of_toAddSubgroup_index_eq_one (G := G) W hW_index

/-- Helper for Theorem 10-10.5-2: Brauer's theorem places every integral character in the
supremum of the `p`-elementary induction spans. -/
theorem character_mem_iSup_pElementaryInducedCharacterSpan (χ : R(G)) :
    χ ∈ (⨆ p : Nat.Primes, V[p](G)) := by
  have hW_top : (⨆ p : Nat.Primes, V[p](G)) = ⊤ := by
    have hprimewise :
        ∀ q : Nat.Primes, Nat.Coprime q (V[q](G)).toAddSubgroup.index := by
      intro q
      -- The primewise coprimality input is exactly the earlier Brauer finite-index theorem.
      simpa using (pElementaryInducedCharacterSpan_finiteIndex_and_index_coprime (G := G) q).2
    -- The generic index argument is now separated from the primewise Brauer input.
    exact
      iSup_pElementaryInducedCharacterSpan_eq_top_of_primewise_index_coprime
        (G := G) hprimewise
  -- Once the Brauer supremum is identified with `⊤`, membership is immediate.
  simp [hW_top]

/-- Helper for Theorem 10-10.5-2: once Brauer's theorem puts a character in the supremum of the
`p`-elementary induction spans, the already-verified elementary-group argument places it in the
monomial-character span. -/
private theorem brauer_sup_le_monomialCharacterSpan :
    (⨆ p : Nat.Primes, V[p](G)) ≤ monomialCharacterSpan G := by
  -- Each Brauer owner `V[p](G)` is already inside the monomial-character span.
  exact
    iSup_le (fun p ↦
      pElementaryInducedCharacterSpan_le_monomialCharacterSpan (G := G) p)

-- Proof sketch: Theorem `10-10.5-1` reduces every character of `G` to an integral linear
-- combination of characters induced from elementary subgroups. For an elementary subgroup `H`,
-- Definition `10-10.1-3` gives nilpotence, and finite nilpotent groups are supersolvable; apply
-- Theorem `8-8.5-2` to decompose the irreducible constituents on `H` into inductions from
-- one-dimensional characters. Induction in stages then shows that each elementary induced
-- character lies in `monomialCharacterSpan G`, so this span is all of `R(G)`.
/-- Theorem 10-10.5-2: the monomial characters span LinearRepresentations_Serre_1977's integral character ring `R(G)`. -/
theorem monomialCharacterSpan_eq_top :
    monomialCharacterSpan G = ⊤ := by
  -- Brauer's theorem puts each character into the supremum of the elementary induction spans,
  -- and each such span already lies inside the monomial-character span.
  refine top_unique ?_
  intro χ _
  have hχ :
      χ ∈ (⨆ p : Nat.Primes, V[p](G)) := by
    simpa using character_mem_iSup_pElementaryInducedCharacterSpan (G := G) χ
  exact brauer_sup_le_monomialCharacterSpan (G := G) hχ

/-- Every character of `G` belongs to the monomial-character span. -/
theorem character_mem_monomialCharacterSpan (χ : R(G)) :
    χ ∈ monomialCharacterSpan G := by
  simp [monomialCharacterSpan_eq_top]

end

