import LinearRepresentations_Serre_1977.Chap18.Theorem_18_18_4_1.CommutativePrimeToPBridge
import LinearRepresentations_Serre_1977.Chap18.Theorem_18_18_4_1.ElementaryPrimeSplit

noncomputable section

