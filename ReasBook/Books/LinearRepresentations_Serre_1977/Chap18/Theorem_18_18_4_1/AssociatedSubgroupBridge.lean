universe u

namespace Representation

section CharacterRingLift

variable {p : ℕ} [Fact p.Prime]
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k p]
variable {K : Type u} [Field K] [CharZero K]
variable {G : Type u} [Group G] [Finite G]

/-- Helper for Theorem 18-18.4-1: on a cyclic group of order prime to `p`, every simple modular
class already yields an ordinary virtual character via the `p`-regular case above. -/
private theorem pRegularComponentVirtualModularCharacter_simple_class_mem_characterRingOverField_of_cyclic_coprime
    (lift : PrimeToPRoot p k →* Kˣ) (S : FDRep k G) [Simple S]
    [IsCyclic G] (hGcop : Nat.Coprime p (Nat.card G))
    (hlift : Function.Injective lift) :
    ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] ∈ R[K](G) := by
  letI : CommGroup G := IsCyclic.commGroup
  let _ := hlift
  exact pRegularComponentVirtualModularCharacter_simple_class_mem_characterRingOverField_of_commutative_coprime
    (p := p) (k := k) (K := K) lift S hGcop

/-- Helper for Theorem 18-18.4-1: on the canonical cyclic subgroup generated by a `p`-regular
element, the transformed class of a simple module is already an ordinary virtual character over
`K`. -/
private theorem cyclic_simple_class_mem_characterRingOverField
    (lift : PrimeToPRoot p k →* Kˣ) {x : G} (hx : IsPRegular p x)
    (S : FDRep k (Subgroup.zpowers x)) [Simple S] :
    ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] ∈ R[K](Subgroup.zpowers x) := by
  letI : IsCyclic (Subgroup.zpowers x) := Subgroup.isCyclic_zpowers x
  letI : CommGroup (Subgroup.zpowers x) := IsCyclic.commGroup
  have hcop : Nat.Coprime p (Nat.card (Subgroup.zpowers x)) := by
    simpa [Nat.card_zpowers, IsPRegular] using hx
  exact
    pRegularComponentVirtualModularCharacter_simple_class_mem_characterRingOverField_of_commutative_coprime
      (p := p) (k := k) (K := K) (H := Subgroup.zpowers x) lift S hcop

/-- Helper for Theorem 18-18.4-1: in a `Γ[K](G)`-`p`-elementary decomposition, the simple class
on the cyclic factor is already an ordinary virtual character over `K`. -/
private theorem cyclic_factor_simple_class_mem_characterRingOverField_of_gamma_p_elementary_decomposition
    (lift : PrimeToPRoot p k →* Kˣ)
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {H : Subgroup G} {C P : Subgroup H}
    (h : Subgroup.IsGammaPElementaryDecomposition ΓK p C P)
    (S : FDRep k C) [Simple S] :
    ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] ∈ R[K](C) := by
  letI : IsCyclic C := h.cyclic
  letI : CommGroup C := IsCyclic.commGroup
  have hcop : Nat.Coprime p (Nat.card C) := h.coprime_card
  exact
    pRegularComponentVirtualModularCharacter_simple_class_mem_characterRingOverField_of_commutative_coprime
      (p := p) (k := k) (K := K) (H := C) lift S hcop

/-- Helper for Theorem 18-18.4-1: in a `Γ[K](G)`-`p`-elementary decomposition, the cyclic factor
is normal in the ambient subgroup. -/
private theorem Subgroup.IsGammaPElementaryDecomposition.cyclic_factor_normal_local
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {H : Subgroup G} {C P : Subgroup H}
    (h : Subgroup.IsGammaPElementaryDecomposition ΓK p C P) :
    C.Normal := by
  rw [← Subgroup.normalizer_eq_top_iff, eq_top_iff]
  have hPnorm : P ≤ Subgroup.normalizer (C : Set H) := by
    intro y hy
    rw [Subgroup.mem_normalizer_iff]
    intro c
    constructor
    · intro hc
      rcases h.conjugation_eq_pow ⟨y, hy⟩ with ⟨t, ht⟩
      let z : H := ⟨c ^ (t : ZMod (Monoid.exponent G)).val, H.pow_mem c.2 _⟩
      have hzC : z ∈ C := by
        change c ^ (t : ZMod (Monoid.exponent G)).val ∈ C
        exact C.pow_mem hc _
      have hz : y * c * y⁻¹ = z := by
        apply Subtype.ext
        calc
          ((y * c * y⁻¹ : H) : G) = (c : G) ^ t := by
            simpa using ht ⟨c, hc⟩
          _ = (c : G) ^ (t : ZMod (Monoid.exponent G)).val := by
            rw [pow_subgroup_eq_pow_nat]
          _ = ((z : H) : G) := by
            rfl
      exact hz ▸ hzC
    · intro hc
      have hy_inv : (y⁻¹ : H) ∈ P := by
        simpa using P.inv_mem hy
      rcases h.conjugation_eq_pow ⟨y⁻¹, hy_inv⟩ with ⟨t, ht⟩
      let z : H := ⟨(y * c * y⁻¹ : H) ^ (t : ZMod (Monoid.exponent G)).val,
        H.pow_mem (H.mul_mem (H.mul_mem y.2 c.2) (H.inv_mem y.2)) _⟩
      have hzC : z ∈ C := by
        change (y * c * y⁻¹ : H) ^ (t : ZMod (Monoid.exponent G)).val ∈ C
        exact C.pow_mem hc _
      have hz : c = z := by
        apply Subtype.ext
        calc
          (c : G) = ((y⁻¹ : H) : G) * ((y * c * y⁻¹ : H) : G) * (((y⁻¹ : H) : G)⁻¹) := by
            group
          _ = ((y * c * y⁻¹ : H) : G) ^ t := by
            simpa using ht ⟨y * c * y⁻¹, hc⟩
          _ = ((y * c * y⁻¹ : H) : G) ^ (t : ZMod (Monoid.exponent G)).val := by
            rw [pow_subgroup_eq_pow_nat]
          _ = ((z : H) : G) := by
            rfl
      exact hz ▸ hzC
  have hsup :
      C ⊔ P ≤ Subgroup.normalizer (C : Set H) :=
    sup_le Subgroup.le_normalizer hPnorm
  simpa [h.isComplement.sup_eq_top] using hsup

/-- Helper for Theorem 18-18.4-1: a `Γ[K](G)`-`p`-elementary decomposition already makes the
ambient subgroup `p`-solvable. -/
private theorem isPSolvable_of_isGammaPElementaryDecomposition
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {H : Subgroup G} {C P : Subgroup H}
    (h : Subgroup.IsGammaPElementaryDecomposition ΓK p C P) :
    IsPSolvable p H := by
  exact
    Representation.isPSolvable_of_cyclicNormalByPGroupDecomposition
      (C := C) (P := P)
      (Subgroup.IsGammaPElementaryDecomposition.cyclic_factor_normal_local
        (p := p) (G := G) h)
      h.isComplement h.coprime_card h.isPGroup

/-- Helper for Theorem 18-18.4-1: in a `Γ[K](G)`-`p`-elementary subgroup, every `p`-regular
element already lies in the cyclic factor. -/
private theorem Subgroup.IsGammaPElementaryDecomposition.exists_cyclic_factor_of_isPRegular_local
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {H : Subgroup G} {C P : Subgroup H}
    (h : Subgroup.IsGammaPElementaryDecomposition ΓK p C P)
    {x : H} (hx : IsPRegular p x) :
    ∃ c : C, (c : H) = x := by
  letI : C.Normal :=
    Subgroup.IsGammaPElementaryDecomposition.cyclic_factor_normal_local
      (p := p) (G := G) h
  have hquotP : IsPGroup p (H ⧸ C) := by
    let e : H ⧸ C ≃* P := h.isComplement.symm.QuotientMulEquiv
    exact h.isPGroup.of_equiv e.symm
  have hq_order : orderOf (QuotientGroup.mk' C x : H ⧸ C) = 1 := by
    obtain ⟨n, hn⟩ := (IsPGroup.iff_orderOf.mp hquotP) (QuotientGroup.mk' C x)
    have hq_dvd : p ^ n ∣ orderOf x := by
      exact hn ▸ orderOf_map_dvd (QuotientGroup.mk' C) x
    exact hn.trans (Nat.Coprime.eq_one_of_dvd (hx.pow_left n) hq_dvd)
  have hq_one : (QuotientGroup.mk' C x : H ⧸ C) = 1 := orderOf_eq_one_iff.mp hq_order
  have hxker : x ∈ (QuotientGroup.mk' C).ker := by
    change QuotientGroup.mk' C x = 1
    exact hq_one
  have hxC : x ∈ C := by
    simpa [QuotientGroup.ker_mk'] using hxker
  exact ⟨⟨x, hxC⟩, rfl⟩

/-- Helper for Theorem 18-18.4-1: a `Γ[K](G)`-`p`-elementary subgroup sits inside an associated
subgroup attached to a generator of its cyclic factor. -/
private theorem Subgroup.IsGammaPElementaryDecomposition.exists_le_associatedGammaPElementarySubgroup_local
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {H : Subgroup G} {C P : Subgroup H}
    (h : Subgroup.IsGammaPElementaryDecomposition ΓK p C P) :
    ∃ x : H, ∃ Q : Sylow p N[ΓK]((x : G)),
      IsPRegular p (x : G) ∧ H ≤ associatedGammaPElementarySubgroup ΓK (x : G) Q := by
  obtain ⟨x, hxC⟩ := C.isCyclic_iff_exists_zpowers_eq_top.mp h.cyclic
  have hx_mem_C : x ∈ C := by
    rw [← hxC]
    exact Subgroup.mem_zpowers x
  have hx_regular_H : IsPRegular p x := by
    exact h.coprime_card.coprime_dvd_right (by simpa using orderOf_dvd_natCard x)
  have hx_regular : IsPRegular p (x : G) := by
    simpa [IsPRegular, Subgroup.orderOf_mk] using hx_regular_H
  let Nx : Subgroup G := N[ΓK]((x : G))
  let P' : Subgroup G := P.map H.subtype
  have hP'_le_gammaNormalizer : P' ≤ Nx := by
    rintro _ ⟨y, hy, rfl⟩
    rcases h.conjugation_eq_pow ⟨y, hy⟩ with ⟨t, ht⟩
    refine ⟨t, ?_⟩
    simpa using ht ⟨x, hx_mem_C⟩
  have hP' : IsPGroup p P' :=
    h.isPGroup.of_surjective (H.subtype.subgroupMap P) (H.subtype.subgroupMap_surjective P)
  have hP'_gammaNormalizer : IsPGroup p (P'.subgroupOf Nx) :=
    hP'.of_equiv (Subgroup.subgroupOfEquivOfLe hP'_le_gammaNormalizer).symm
  obtain ⟨Q, hPQ⟩ := hP'_gammaNormalizer.exists_le_sylow
  have hP'_le_Qmap : P' ≤ Subgroup.map Nx.subtype (Q : Subgroup Nx) := by
    calc
      P' = Subgroup.map Nx.subtype (P'.subgroupOf Nx) := by
        symm
        exact Subgroup.map_subgroupOf_eq_of_le hP'_le_gammaNormalizer
      _ ≤ Subgroup.map Nx.subtype (Q : Subgroup Nx) := Subgroup.map_mono hPQ
  have hH_eq :
      H = Subgroup.zpowers (x : G) ⊔ P' := by
    calc
      H = (⊤ : Subgroup H).map H.subtype := by
        rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
      _ = (C ⊔ P).map H.subtype := by
        rw [← h.isComplement.sup_eq_top]
      _ = (Subgroup.zpowers x ⊔ P).map H.subtype := by
        rw [hxC]
      _ = Subgroup.zpowers (H.subtype x) ⊔ P' := by
        rw [Subgroup.map_sup, MonoidHom.map_zpowers]
      _ = Subgroup.zpowers (x : G) ⊔ P.map H.subtype := by
        rfl
  refine ⟨x, Q, hx_regular, ?_⟩
  calc
    H = Subgroup.zpowers (x : G) ⊔ P' := hH_eq
    _ ≤ Subgroup.zpowers (x : G) ⊔ Subgroup.map Nx.subtype (Q : Subgroup Nx) :=
      sup_le_sup le_rfl hP'_le_Qmap
    _ = associatedGammaPElementarySubgroup ΓK (x : G) Q := by
      simp [associatedGammaPElementarySubgroup, Nx]

/-- Helper for Theorem 18-18.4-1: every `Γ[K](G)`-`p`-elementary subgroup is `p`-solvable. -/
private theorem isPSolvable_of_isGammaPElementary
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {H : Subgroup G} (hH : Subgroup.IsGammaPElementary ΓK p H) :
    IsPSolvable p H := by
  rcases hH with ⟨C, P, h⟩
  exact isPSolvable_of_isGammaPElementaryDecomposition (p := p) (ΓK := ΓK) h

/-- Helper for Theorem 18-18.4-1: on the cyclic factor attached to a `p`-regular generator, the
transformed class of the restricted representation already lies in `R[K](⟨x⟩)`. -/
private theorem associated_cyclic_restricted_simple_class_mem_characterRingOverField_local
    (lift : PrimeToPRoot p k →* Kˣ) {x : G} (hx : IsPRegular p x) (S : FDRep k G) :
    ([FDRep.of (S.ρ.comp (Subgroup.zpowers x).subtype)]₀)′[p, PrimeToPRoot.toFieldLift lift] ∈
      R[K](Subgroup.zpowers x) := by
  letI : IsCyclic (Subgroup.zpowers x) := Subgroup.isCyclic_zpowers x
  letI : CommGroup (Subgroup.zpowers x) := IsCyclic.commGroup
  have hcop : Nat.Coprime p (Nat.card (Subgroup.zpowers x)) := by
    simpa [Nat.card_zpowers, IsPRegular] using hx
  exact
    pRegularComponentVirtualModularCharacter_mem_characterRingOverField_of_commutative_coprime
      (p := p) (k := k) (K := K) (H := Subgroup.zpowers x) lift hcop
      [FDRep.of (S.ρ.comp (Subgroup.zpowers x).subtype)]₀

/-- Helper for Theorem 18-18.4-1: package the cyclic restricted simple class as an explicit
ordinary-character witness in `R[K](⟨x⟩)` before attempting the associated-subgroup extension. -/
private theorem associated_cyclic_restricted_simple_class_character_witness_local
    (lift : PrimeToPRoot p k →* Kˣ) {x : G} (hx : IsPRegular p x) (S : FDRep k G) :
    ∃ χC : R[K](Subgroup.zpowers x),
      (χC : Subgroup.zpowers x → K) =
        ([FDRep.of (S.ρ.comp (Subgroup.zpowers x).subtype)]₀)′[p,
          PrimeToPRoot.toFieldLift lift] := by
  let ψC : Subgroup.zpowers x → K :=
    ([FDRep.of (S.ρ.comp (Subgroup.zpowers x).subtype)]₀)′[p, PrimeToPRoot.toFieldLift lift]
  have hψC : ψC ∈ R[K](Subgroup.zpowers x) :=
    associated_cyclic_restricted_simple_class_mem_characterRingOverField_local
      (p := p) (k := k) (K := K) lift hx S
  exact ⟨⟨ψC, hψC⟩, rfl⟩

/-- Helper for Theorem 18-18.4-1: every element of the associated subgroup `A = ⟨x⟩ ⋅ Q`
admits a unique factorization into a cyclic-factor element followed by a `Q`-factor element. -/
private theorem associatedGammaPElementarySubgroup_factorization_local
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {x : G} {Q : Sylow p N[ΓK](x)} (hx : IsPRegular p x) :
    let A := associatedGammaPElementarySubgroup ΓK x Q
    let C₀ : Subgroup A := (Subgroup.zpowers x).subgroupOf A
    let P₀ : Subgroup A :=
      (Subgroup.map N[ΓK](x).subtype (Q : Subgroup N[ΓK](x))).subgroupOf A
    ∀ a : A, ∃! cp : C₀ × P₀, cp.1.1 * cp.2.1 = a := by
  intro A C₀ P₀ a
  simpa [A, C₀, P₀] using
    (associatedGammaPElementarySubgroup_decomposition ΓK p x hx Q).isComplement.existsUnique a

/-- Helper for Theorem 18-18.4-1: every element of the `Q`-factor in
`A = associatedGammaPElementarySubgroup ΓK x Q` carries a concrete `ΓK`-power witness for its
conjugation action on the distinguished generator `x`. -/
private theorem associatedGammaPElementarySubgroup_pfactor_conjugates_generator_by_power_local
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {x : G} {Q : Sylow p N[ΓK](x)} (hx : IsPRegular p x) :
    let A := associatedGammaPElementarySubgroup ΓK x Q
    let P₀ : Subgroup A :=
      (Subgroup.map N[ΓK](x).subtype (Q : Subgroup N[ΓK](x))).subgroupOf A
    ∀ y : P₀, ∃ t : ΓK, (((y : P₀) : A) : G) * x * (((y : P₀) : A) : G)⁻¹ = x ^ t := by
  intro A P₀ y
  let C₀ : Subgroup A := (Subgroup.zpowers x).subgroupOf A
  let hdecomp := associatedGammaPElementarySubgroup_decomposition ΓK p x hx Q
  rcases hdecomp.conjugation_eq_pow y with ⟨t, ht⟩
  let c0 : C₀ :=
    ⟨⟨x, zpowers_le_associatedGammaPElementarySubgroup ΓK p x Q (Subgroup.mem_zpowers x)⟩,
      Subgroup.mem_subgroupOf.mpr (Subgroup.mem_zpowers x)⟩
  refine ⟨t, ?_⟩
  simpa [c0, C₀] using ht c0

/-- Helper for Theorem 18-18.4-1: if an ordinary character on the associated subgroup `A = ⟨x⟩⋅Q`
restricts to the cyclic witness on `⟨x⟩`, then on every `p`-regular element of `A` it agrees with
the transformed class of the restricted simple representation. -/
private theorem associated_extension_apply_eq_restricted_simple_on_pregular_local
    (lift : PrimeToPRoot p k →* Kˣ)
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {x : G} (hx : IsPRegular p x)
    {Q : Sylow p N[ΓK](x)}
    (S : FDRep k G)
    (χA : R[K](associatedGammaPElementarySubgroup ΓK x Q))
    (hχA :
      ((((zpowers_le_associatedGammaPElementarySubgroup ΓK p x Q) ↾R[K]) χA :
          R[K](Subgroup.zpowers x)) : Subgroup.zpowers x → K) =
        (pRegularComponentVirtualModularCharacter (G := Subgroup.zpowers x) p
          (PrimeToPRoot.toFieldLift lift)
          [FDRep.of (S.ρ.comp (Subgroup.zpowers x).subtype)]₀ : Subgroup.zpowers x → K)) :
    ∀ a : associatedGammaPElementarySubgroup ΓK x Q, IsPRegular p a.1 →
      (χA : associatedGammaPElementarySubgroup ΓK x Q → K) a =
        (pRegularComponentVirtualModularCharacter
          (G := associatedGammaPElementarySubgroup ΓK x Q) p
          (PrimeToPRoot.toFieldLift lift)
          [FDRep.of (S.ρ.comp (associatedGammaPElementarySubgroup ΓK x Q).subtype)]₀) a := by
  intro a ha
  let A := associatedGammaPElementarySubgroup ΓK x Q
  let C := Subgroup.zpowers x
  let C₀ : Subgroup A := C.subgroupOf A
  let P₀ : Subgroup A :=
    (Subgroup.map N[ΓK](x).subtype (Q : Subgroup N[ΓK](x))).subgroupOf A
  let hC : C ≤ A := zpowers_le_associatedGammaPElementarySubgroup ΓK p x Q
  have hdecomp : Subgroup.IsGammaPElementaryDecomposition ΓK p C₀ P₀ :=
    associatedGammaPElementarySubgroup_decomposition ΓK p x hx Q
  have haA : IsPRegular p a := by
    simpa [IsPRegular, Subgroup.orderOf_mk] using ha
  obtain ⟨c0, hc0⟩ :=
    Subgroup.IsGammaPElementaryDecomposition.exists_cyclic_factor_of_isPRegular_local
      (p := p) hdecomp (x := a) haA
  let c : C := ⟨c0, c0.2⟩
  have hc : Subgroup.inclusion hC c = a := by
    apply Subtype.ext
    exact congrArg Subtype.val hc0
  have hca : (c : G) = a.1 := congrArg Subtype.val hc
  let ψC : C → K :=
    pRegularComponentVirtualModularCharacter (G := C) p
      (PrimeToPRoot.toFieldLift lift) [FDRep.of (S.ρ.comp C.subtype)]₀
  let ψA : A → K :=
    pRegularComponentVirtualModularCharacter (G := A) p
      (PrimeToPRoot.toFieldLift lift) [FDRep.of (S.ρ.comp A.subtype)]₀
  have hχA_eval :
      (χA : A → K) a = ψC c := by
    calc
      (χA : A → K) a = (χA : A → K) (Subgroup.inclusion hC c) := by simp [hc]
      _ = ((((hC ↾R[K]) χA : R[K](C)) : C → K) c) := by
            simp [Subgroup.characterRingOverFieldRestrictionOfLe_apply]
      _ = ψC c := by simpa [ψC] using congrFun hχA c
  have hC_global :
      ψC c = ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] (c : G) := by
    calc
      ψC c =
          (C.classFunctionRestriction
            ⟨([S]₀)′[p, PrimeToPRoot.toFieldLift lift],
              pRegularComponentVirtualModularCharacter_isClassFunction
                (p := p) (k := k) (K := K) (G := G) lift [S]₀⟩ : C → K) c := by
            symm
            simpa [ψC] using
              pRegularComponentVirtualModularCharacter_restrict_simple_class_apply
                (p := p) (k := k) (K := K) (G := G) lift C S c
      _ = ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] (c : G) := by
            simp [Subgroup.classFunctionRestriction_apply]
  have hA_global :
      ψA a = ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] a.1 := by
    calc
      ψA a =
          (A.classFunctionRestriction
            ⟨([S]₀)′[p, PrimeToPRoot.toFieldLift lift],
              pRegularComponentVirtualModularCharacter_isClassFunction
                (p := p) (k := k) (K := K) (G := G) lift [S]₀⟩ : A → K) a := by
            symm
            simpa [ψA] using
              pRegularComponentVirtualModularCharacter_restrict_simple_class_apply
                (p := p) (k := k) (K := K) (G := G) lift A S a
      _ = ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] a.1 := by
            simp [Subgroup.classFunctionRestriction_apply]
  calc
    (χA : A → K) a = ψC c := hχA_eval
    _ = ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] (c : G) := hC_global
    _ = ([S]₀)′[p, PrimeToPRoot.toFieldLift lift] a.1 := by simpa [hca]
    _ = ψA a := hA_global.symm

/-- Helper for Theorem 18-18.4-1: once the subgroup-local simple case is realized inside
`R[K](H)`, the restriction of the ambient transformed simple class to `H` is automatically the
same ordinary virtual character. -/
private theorem restrict_simple_class_mem_characterRingOverField_of_local_simple_case
    (lift : PrimeToPRoot p k →* Kˣ) (H : Subgroup G) (S : FDRep k G)
    (hlocal :
      ([FDRep.of (S.ρ.comp H.subtype)]₀)′[p, PrimeToPRoot.toFieldLift lift] ∈ R[K](H)) :
    (H.classFunctionRestriction
      ⟨([S]₀)′[p, PrimeToPRoot.toFieldLift lift],
        pRegularComponentVirtualModularCharacter_isClassFunction
          (p := p) (k := k) (K := K) (G := G) lift [S]₀⟩ : H → K) ∈ R[K](H) := by
  simpa [pRegularComponentVirtualModularCharacter_restrict_simple_class
    (p := p) (k := k) (K := K) (G := G) (lift := lift) H S] using hlocal

/-- Helper for Theorem 18-18.4-1: precomposing an ordinary virtual character with a group
homomorphism keeps it inside the ordinary character ring. -/
theorem precomp_mem_characterRingOverField_local
    {H J : Type u} [Group H] [Group J]
    (f : H →* J) (χ : R[K](J)) :
    (fun h : H ↦ (χ : J → K) (f h)) ∈ R[K](H) := by
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ χ.2
  · intro ψ hψ
    rcases hψ with ⟨ρ, hρfd, -, rfl⟩
    change (Rep.res f ρ).ρ.character ∈ R[K](H)
    letI : FiniteDimensional K ρ := hρfd
    letI : FiniteDimensional K (Rep.res f ρ) := by infer_instance
    exact Representation.rep_character_mem_characterRingOverField (Rep.res f ρ)
  · intro n
    exact (R[K](H)).algebraMap_mem n
  · intro x y _ _ hx hy
    simpa using (R[K](H)).add_mem hx hy
  · intro x y _ _ hx hy
    simpa using (R[K](H)).mul_mem hx hy

/-- Helper for Theorem 18-18.4-1: if the right factor acts trivially on a direct-product
representation, the whole action inflates from the left factor along `fst`. -/
theorem representation_eq_comp_inl_comp_fst_of_trivial_right_local
    {C : Type u} [Group C] {P : Type u} [Group P]
    {V : Type u} [AddCommGroup V] [Module k V]
    (ρ : Representation k (C × P) V) (hTriv : IsTrivial (ρ.comp (inr C P))) :
    ρ = (ρ.comp (inl C P)).comp (fst C P) := by
  letI : IsTrivial (ρ.comp (inr C P)) := hTriv
  ext g x
  rcases g with ⟨c, p'⟩
  calc
    ρ (c, p') x = ρ ((c, 1) * (1, p')) x := by simp
    _ = (ρ (c, 1) * ρ (1, p')) x := by rw [map_mul]
    _ = ρ (c, 1) (ρ (1, p') x) := rfl
    _ = ρ (c, 1) x := by
          have hp' : ρ (1, p') x = x := by
            change ((ρ.comp (inr C P)) p') x = x
            exact isTrivial_apply (ρ.comp (inr C P)) p' x
          simp [hp']
    _ = ((ρ.comp (inl C P)).comp (fst C P)) (c, p') x := rfl

/-- Helper for Theorem 18-18.4-1: the explicit cyclic witness on `C = ⟨x⟩` extends to an honest
ordinary character on the associated subgroup `A = ⟨x⟩ ⋅ Q`, and that chosen extension already
agrees with the transformed restricted simple class on the `p`-regular locus of `A`. -/
private theorem associated_subgroup_pregular_character_witness_local
    (lift : PrimeToPRoot p k →* Kˣ)
    {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {x : G} (hx : IsPRegular p x)
    {Q : Sylow p N[ΓK](x)}
    (S : FDRep k G) :
    ∃ χA : R[K](associatedGammaPElementarySubgroup ΓK x Q),
      ((((zpowers_le_associatedGammaPElementarySubgroup ΓK p x Q) ↾R[K]) χA :
          R[K](Subgroup.zpowers x)) : Subgroup.zpowers x → K) =
        ([FDRep.of (S.ρ.comp (Subgroup.zpowers x).subtype)]₀)′[p,
          PrimeToPRoot.toFieldLift lift] ∧
      ∀ a : associatedGammaPElementarySubgroup ΓK x Q, IsPRegular p a.1 →
        (χA : associatedGammaPElementarySubgroup ΓK x Q → K) a =
          (pRegularComponentVirtualModularCharacter
            (G := associatedGammaPElementarySubgroup ΓK x Q) p
            (PrimeToPRoot.toFieldLift lift)
            [FDRep.of (S.ρ.comp (associatedGammaPElementarySubgroup ΓK x Q).subtype)]₀) a := by
  obtain ⟨χC, hχC⟩ :=
    associated_cyclic_restricted_simple_class_character_witness_local
      (p := p) (k := k) (K := K) lift hx S
  obtain ⟨χA, hχA_res⟩ :=
    associatedGammaPElementarySubgroupRestrictionOverField_surjective
      (K := K) (p := p) (x := x) (P := Q) hx χC
  refine ⟨χA, hχA_res.trans hχC, ?_⟩
  exact associated_extension_apply_eq_restricted_simple_on_pregular_local
    (p := p) (k := k) (K := K) (G := G) (lift := lift)
    (ΓK := ΓK) (x := x) hx (Q := Q) S χA (hχA_res.trans hχC)

/-- Helper for Theorem 18-18.4-1: the exact remaining source-faithful local task is to upgrade the
associated-subgroup witness from `p`-regular agreement to pointwise equality on all of
`A = associatedGammaPElementarySubgroup ΓK x Q`. -/
private def associated_subgroup_all_elements_character_witness_prop
    (lift : PrimeToPRoot p k →* Kˣ) (S : FDRep k G) : Prop :=
  ∀ {ΓK : Subgroup (ZMod (Monoid.exponent G))ˣ}
    {x : G} (hx : IsPRegular p x) {Q : Sylow p N[ΓK](x)},
    ∃ χA : R[K](associatedGammaPElementarySubgroup ΓK x Q),
      ∀ a : associatedGammaPElementarySubgroup ΓK x Q,
        (χA : associatedGammaPElementarySubgroup ΓK x Q → K) a =
          (pRegularComponentVirtualModularCharacter
            (G := associatedGammaPElementarySubgroup ΓK x Q) p
            (PrimeToPRoot.toFieldLift lift)
            [FDRep.of (S.ρ.comp (associatedGammaPElementarySubgroup ΓK x Q).subtype)]₀) a

end CharacterRingLift

end Representation
