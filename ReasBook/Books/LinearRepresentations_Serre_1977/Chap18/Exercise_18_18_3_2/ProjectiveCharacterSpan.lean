section ProjectiveCharacterCriterion

variable {p : ℕ}
variable {A : Type u} [CommRing A] [IsLocalRing A] [HenselianLocalRing A]
variable {K : Type u} [Field K] [Algebra A K] [IsFractionRing A K]
variable {G : Type u} [Group G] [Finite G]
variable [IsDomain A] [IsDiscreteValuationRing A]
variable [CharZero K]
variable [Fact p.Prime] [IsAlgClosed (IsLocalRing.ResidueField A)]
variable [CharP (IsLocalRing.ResidueField A) p]

local notation "k" => IsLocalRing.ResidueField A
local notation "e" => (projectiveGrothendieckScalarExtensionHom A K : P₀[k](G) →+ R₀[K](G))
local instance : DecidableEq (PRegularConjClass G p) := Classical.decEq _

def projectiveCharacterScalarExtension
    (x : P₀[k](G)) : A ⊗R[K](G) :=
  ⟨finiteRepGrothendieckCharacter K G (e x),
    mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
      (finiteRepGrothendieckCharacter K G (e x)).property⟩

/-- The `A`-submodule of the canonical Chapter `12` owner `A ⊗R[K](G)` generated by the ordinary
characters in the image of Serre's canonical projective scalar-extension owner
`projectiveGrothendieckScalarExtensionHom A K`. This is the class-function realization of Serre's
`A ⊗[ℤ] P_k(G)`, obtained inside the canonical Chapter `12` owner `A ⊗R[K](G)` by applying the
Chapter `16` Grothendieck-character owner `finiteRepGrothendieckCharacter K G` and then viewing
the resulting virtual characters in the scalar-extension owner. -/
def projectiveCharacterSubmodule : Submodule A (A ⊗R[K](G)) :=
  Submodule.span A (Set.range projectiveCharacterScalarExtension)

omit [IsLocalRing A] [IsFractionRing A K] [Fact p.Prime] in
/-- Helper for Exercise 18-18.3-2: every element of `A ⊗R[K](G)` is a class function on `G`. -/
lemma isClassFunction_of_mem_characterRingOverFieldAlgebraScalarExtension_local
    {f : G → K} (hf : f ∈ A ⊗R[K](G)) :
    _root_.IsClassFunction f := by
  induction hf using Submodule.span_induction with
  | mem ψ hψ =>
      -- The scalar-extension owner already consists of genuine class functions.
      exact isClassFunction_of_mem_characterRingOverField ψ (by simpa using hψ)
  | zero =>
      -- Constant functions stay constant on conjugacy classes.
      simpa using (inferInstance : _root_.IsClassFunction (fun _ : G ↦ (0 : K)))
  | add f g _ _ hf hg =>
      -- Conjugacy invariance is preserved under pointwise addition.
      letI : _root_.IsClassFunction f := hf
      letI : _root_.IsClassFunction g := hg
      simpa using (inferInstance : _root_.IsClassFunction (f + g))
  | smul a f _ hf =>
      -- Conjugacy invariance is preserved under scalar multiplication.
      letI : _root_.IsClassFunction f := hf
      simpa using (inferInstance : _root_.IsClassFunction (a • f))

omit [Fact p.Prime] in
/-- Helper for Exercise 18-18.3-2: restrict a class function in `A ⊗R[K](G)` to the canonical
owner `PRegularConjClass G p` of `p`-regular conjugacy classes. -/
noncomputable def regularRestriction
    (Φ : A ⊗R[K](G)) : PRegularConjClass G p → K :=
  -- Descend the class function through the canonical `p`-regular conjugacy-class owner.
  _root_.IsClassFunction.pRegularLift
    (G := G) (p := p)
    (isClassFunction_of_mem_characterRingOverFieldAlgebraScalarExtension_local
      (A := A) (K := K) Φ.2)

omit [Fact p.Prime] in
/-- Helper for Exercise 18-18.3-2: regular restriction is `A`-linear on the scalar-extended
character space. -/
noncomputable def regularRestrictionLinearMap :
    (A ⊗R[K](G)) →ₗ[A] (PRegularConjClass G p → K) where
  toFun := regularRestriction (p := p)
  map_add' Φ Ψ := by
    classical
    -- Evaluate at a chosen representative of each regular conjugacy class, where the claim is
    -- just pointwise additivity of class functions.
    ext c
    let s := PRegularConjClass.representative (G := G) (p := p) c
    have hs : PRegularConjClass.ofSubtype (G := G) p s = c := by
      apply Subtype.ext
      simpa [s] using PRegularConjClass.mk_representative (G := G) (p := p) c
    rw [← hs]
    -- Evaluate each descended class function back on the chosen representative.
    rw [show regularRestriction (p := p) (Φ + Ψ) (PRegularConjClass.ofSubtype (G := G) p s) =
          (((Φ + Ψ : A ⊗R[K](G)) : G → K) s.1) by
          exact _root_.IsClassFunction.pRegularLift_ofSubtype (G := G) (p := p)
            (f := ((Φ + Ψ : A ⊗R[K](G)) : G → K))
            (isClassFunction_of_mem_characterRingOverFieldAlgebraScalarExtension_local
              (A := A) (K := K) (Φ + Ψ).2) s]
    simp only [Pi.add_apply]
    rw [show regularRestriction (p := p) Φ (PRegularConjClass.ofSubtype (G := G) p s) =
          ((Φ : G → K) s.1) by
          exact _root_.IsClassFunction.pRegularLift_ofSubtype (G := G) (p := p)
            (f := (Φ : G → K))
            (isClassFunction_of_mem_characterRingOverFieldAlgebraScalarExtension_local
              (A := A) (K := K) Φ.2) s]
    rw [show regularRestriction (p := p) Ψ (PRegularConjClass.ofSubtype (G := G) p s) =
          ((Ψ : G → K) s.1) by
          exact _root_.IsClassFunction.pRegularLift_ofSubtype (G := G) (p := p)
            (f := (Ψ : G → K))
            (isClassFunction_of_mem_characterRingOverFieldAlgebraScalarExtension_local
              (A := A) (K := K) Ψ.2) s]
    rfl
  map_smul' a Φ := by
    classical
    -- The same representative reduction turns `A`-linearity into pointwise scalar linearity.
    ext c
    let s := PRegularConjClass.representative (G := G) (p := p) c
    have hs : PRegularConjClass.ofSubtype (G := G) p s = c := by
      apply Subtype.ext
      simpa [s] using PRegularConjClass.mk_representative (G := G) (p := p) c
    rw [← hs]
    -- Evaluate the descended class function on the chosen representative before using pointwise
    -- scalar linearity.
    rw [show regularRestriction (p := p) (a • Φ) (PRegularConjClass.ofSubtype (G := G) p s) =
          (((a • Φ : A ⊗R[K](G)) : G → K) s.1) by
          exact _root_.IsClassFunction.pRegularLift_ofSubtype (G := G) (p := p)
            (f := ((a • Φ : A ⊗R[K](G)) : G → K))
            (isClassFunction_of_mem_characterRingOverFieldAlgebraScalarExtension_local
              (A := A) (K := K) (a • Φ).2) s]
    simp only [Pi.smul_apply]
    rw [show regularRestriction (p := p) Φ (PRegularConjClass.ofSubtype (G := G) p s) =
          ((Φ : G → K) s.1) by
          exact _root_.IsClassFunction.pRegularLift_ofSubtype (G := G) (p := p)
            (f := (Φ : G → K))
            (isClassFunction_of_mem_characterRingOverFieldAlgebraScalarExtension_local
              (A := A) (K := K) Φ.2) s]
    rfl

omit [Fact p.Prime] in
/-- Helper for Exercise 18-18.3-2: the regular restriction recovers the original value at a
`p`-regular element. -/
@[simp] theorem regularRestriction_ofSubtype
    (Φ : A ⊗R[K](G)) (g : G) (hg : IsPRegular p g) :
    regularRestriction (p := p) Φ (PRegularConjClass.ofSubtype p ⟨g, hg⟩) =
      (Φ : G → K) g := by
  -- Evaluate the descended class function on the chosen representative.
  exact _root_.IsClassFunction.pRegularLift_ofSubtype (G := G) (p := p)
    (f := (Φ : G → K))
    (isClassFunction_of_mem_characterRingOverFieldAlgebraScalarExtension_local
      (A := A) (K := K) Φ.2) ⟨g, hg⟩

/-- Helper for Exercise 18-18.3-2: vanishing away from the `p`-regular locus is equivalent to
being the zero-extension of the regular restriction. -/
theorem regular_restriction_zero_extension_iff
    (Φ : A ⊗R[K](G)) :
    (∀ g : G, ¬ IsPRegular p g → (Φ : G → K) g = 0) ↔
      ∀ g : G,
        (Φ : G → K) g =
          if hg : IsPRegular p g then
            regularRestriction (p := p) Φ (PRegularConjClass.ofSubtype p ⟨g, hg⟩)
          else 0 := by
  constructor
  · intro hzero g
    by_cases hg : IsPRegular p g
    · simp [hg, regularRestriction_ofSubtype]
    · simp [hg, hzero g hg]
  · intro hzero g hg
    simpa [hg] using hzero g

/-- Helper for Exercise 18-18.3-2: the coordinatewise divisibility lattice on
`PRegularConjClass G p → K` determined by the centralizer `p`-parts. -/
noncomputable def regularValueDivisibilitySubmodule :
    Submodule A (PRegularConjClass G p → K) :=
  Submodule.pi Set.univ fun c ↦
    Submodule.span A ({algebraMap A K (ConjClasses.centralizerPPart p c.1 : A)} : Set K)

/-- Helper for Exercise 18-18.3-2: the scaled point mass at a `p`-regular conjugacy class, whose
single nonzero value is the centralizer `p`-part attached to that class. -/
noncomputable def scaled_regular_indicator
    (c : PRegularConjClass G p) : PRegularConjClass G p → K := by
  classical
  exact Pi.single c (algebraMap A K (ConjClasses.centralizerPPart p c.1 : A))

/-- Helper for Exercise 18-18.3-2: membership in the regular divisibility lattice is exactly the
coordinatewise divisibility condition from the statement. -/
theorem mem_regularValueDivisibilitySubmodule_iff
    (f : PRegularConjClass G p → K) :
    f ∈ regularValueDivisibilitySubmodule (p := p) (A := A) (K := K) (G := G) ↔
      ∀ c : PRegularConjClass G p,
        ∃ a : A,
          f c =
            algebraMap A K ((ConjClasses.centralizerPPart p c.1 : A) * a) := by
  constructor
  · intro hf c
    have hpi :
        ∀ c' ∈ Set.univ,
          f c' ∈
            Submodule.span A ({algebraMap A K (ConjClasses.centralizerPPart p c'.1 : A)} : Set K) :=
      by
        simpa [regularValueDivisibilitySubmodule] using hf
    rcases Submodule.mem_span_singleton.mp (hpi c (by simp)) with ⟨a, ha⟩
    refine ⟨a, ?_⟩
    calc
      f c = a • algebraMap A K (ConjClasses.centralizerPPart p c.1 : A) := ha.symm
      _ = algebraMap A K a *
            algebraMap A K (ConjClasses.centralizerPPart p c.1 : A) := by
            rw [Algebra.smul_def]
      _ = algebraMap A K (ConjClasses.centralizerPPart p c.1 : A) *
            algebraMap A K a := by
            rw [mul_comm]
      _ = algebraMap A K ((ConjClasses.centralizerPPart p c.1 : A) * a) := by
            rw [map_mul]
  · intro hf
    have hpi :
        ∀ c' ∈ Set.univ,
          f c' ∈
            Submodule.span A ({algebraMap A K (ConjClasses.centralizerPPart p c'.1 : A)} : Set K) :=
      by
        intro c' _
        rcases hf c' with ⟨a, ha⟩
        rw [Submodule.mem_span_singleton]
        refine ⟨a, ?_⟩
        calc
          a • algebraMap A K (ConjClasses.centralizerPPart p c'.1 : A) =
              algebraMap A K a *
                algebraMap A K (ConjClasses.centralizerPPart p c'.1 : A) := by
                rw [Algebra.smul_def]
          _ = algebraMap A K (ConjClasses.centralizerPPart p c'.1 : A) *
                algebraMap A K a := by
                rw [mul_comm]
          _ = algebraMap A K ((ConjClasses.centralizerPPart p c'.1 : A) * a) := by
                rw [map_mul]
          _ = f c' := ha.symm
    simpa [regularValueDivisibilitySubmodule] using hpi

/-- Helper for Exercise 18-18.3-2: the regular divisibility lattice is spanned by the scaled
point masses on `PRegularConjClass G p`. -/
theorem scaled_regular_indicator_mem_regularValueDivisibilitySubmodule
    (c : PRegularConjClass G p) :
    scaled_regular_indicator (p := p) (A := A) (K := K) c ∈
      regularValueDivisibilitySubmodule (p := p) (A := A) (K := K) (G := G) := by
  refine (mem_regularValueDivisibilitySubmodule_iff
    (p := p) (A := A) (K := K) (G := G) _).2 ?_
  intro c'
  by_cases h : c' = c
  · subst h
    refine ⟨1, ?_⟩
    simp [scaled_regular_indicator, Pi.single_apply]
  · refine ⟨0, ?_⟩
    simp [scaled_regular_indicator, Pi.single_apply, h]

/-- Helper for Exercise 18-18.3-2: the regular divisibility lattice is spanned by the scaled
point masses on `PRegularConjClass G p`. -/
theorem regularValueDivisibilitySubmodule_eq_span_scaled_regular_indicator :
    regularValueDivisibilitySubmodule (p := p) (A := A) (K := K) (G := G) =
      Submodule.span A
        (Set.range
          (fun c : PRegularConjClass G p ↦
            scaled_regular_indicator (p := p) (A := A) (K := K) c)) := by
  classical
  letI : Fintype (PRegularConjClass G p) := Fintype.ofFinite (PRegularConjClass G p)
  apply le_antisymm
  · intro f hf
    rcases (mem_regularValueDivisibilitySubmodule_iff
      (p := p) (A := A) (K := K) (G := G) f).1 hf with hcoeff
    choose a ha using hcoeff
    have hsum :
        (∑ c : PRegularConjClass G p,
          a c •
            (Pi.single c (algebraMap A K (ConjClasses.centralizerPPart p c.1 : A)) :
              PRegularConjClass G p → K)) =
          f := by
      ext c
      simp [ha c, Pi.single_apply, Algebra.smul_def, mul_comm, mul_left_comm, mul_assoc]
    rw [← hsum]
    exact Submodule.sum_mem _ fun c _ ↦
      Submodule.smul_mem _ _ <|
        by
          refine Submodule.subset_span ?_
          refine ⟨c, ?_⟩
          simp [scaled_regular_indicator]
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨c, rfl⟩
    simpa [scaled_regular_indicator] using
      scaled_regular_indicator_mem_regularValueDivisibilitySubmodule
        (p := p) (A := A) (K := K) (G := G) c

variable [HasEnoughRootsOfUnity K (Monoid.exponent G)]

/-- Helper for Exercise 18-18.3-2: every projective character in the scalar-extension span
vanishes on the `p`-singular locus. -/
theorem projectiveCharacterSubmodule_zero_on_pSingular
    {Φ : A ⊗R[K](G)} (hΦ : Φ ∈ projectiveCharacterSubmodule (A := A) (K := K) (G := G)) :
    ∀ g : G, ¬ IsPRegular p g → (Φ : G → K) g = 0 := by
  induction hΦ using Submodule.span_induction with
  | mem ψ hψ =>
      rcases hψ with ⟨x, rfl⟩
      intro g hg
      have hx :
          e x ∈
            (projectiveGrothendieckScalarExtensionHom A K : P₀[k](G) →+ R₀[K](G)).range :=
        ⟨x, rfl⟩
      simpa [projectiveCharacterScalarExtension] using
        (mem_projectiveGrothendieckScalarExtension_range_iff_character_eq_zero_on_pSingular
          (A := A) (K := K) (G := G) (p := p) (e x)).1 hx g hg
  | zero =>
      intro g hg
      simp
  | add f g _ _ hf hg =>
      intro s hs
      simp [hf s hs, hg s hs]
  | smul a f _ hf =>
      intro g hg
      simp [hf g hg]

end ProjectiveCharacterCriterion

end Representation
