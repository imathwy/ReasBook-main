import Mathlib

noncomputable section

universe u

namespace Representation

section

variable {p : ℕ}
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k p]

/-- Helper for Theorem 18-18.2-1: for Witt vectors over the characteristic-`p` field `k`, the
maximal ideal is generated by `p`. This identifies the residue quotient used by the fixed mixed
character owner. -/
theorem wittVector_maximalIdeal_eq_span_prime_local [Fact p.Prime] :
    IsLocalRing.maximalIdeal (WittVector p k) = Ideal.span {((p : ℕ) : WittVector p k)} := by
  -- Compare the maximal ideal with the kernel of `constantCoeff`, then use the standard
  -- Witt-vector kernel computation.
  calc
    IsLocalRing.maximalIdeal (WittVector p k) =
        RingHom.ker (WittVector.constantCoeff : WittVector p k →+* k) := by
          symm
          exact
            IsLocalRing.ker_eq_maximalIdeal
              (WittVector.constantCoeff : WittVector p k →+* k)
              (WittVector.constantCoeff_surjective (p := p))
    _ = Ideal.span {((p : ℕ) : WittVector p k)} := by
      simpa using (WittVector.ker_constantCoeff (p := p) (k := k))

/-- Helper for Theorem 18-18.2-1: the residue field of `W(k)` is canonically identified with `k`.
This is the fixed residue-field comparison used in the mixed-character route. -/
noncomputable def wittVector_residueField_ringEquiv_local [Fact p.Prime] :
    IsLocalRing.ResidueField (WittVector p k) ≃+* k :=
  let hker :
      RingHom.ker (WittVector.constantCoeff : WittVector p k →+* k) =
        IsLocalRing.maximalIdeal (WittVector p k) :=
    IsLocalRing.ker_eq_maximalIdeal
      (WittVector.constantCoeff : WittVector p k →+* k)
      (WittVector.constantCoeff_surjective (p := p))
  -- Move from the residue-field quotient to the kernel quotient, then evaluate by
  -- `constantCoeff`.
  (Ideal.quotEquivOfEq hker.symm).trans <|
    RingHom.quotientKerEquivOfSurjective (WittVector.constantCoeff_surjective (p := p))

/-- Helper for Theorem 18-18.2-1: the Witt-vector DVR has characteristic zero, hence so does its
fraction field. This is the only arithmetic input needed to freeze the mixed-character owner at
`W(k)`. -/
private theorem wittVector_charZero_local [Fact p.Prime] :
    CharZero (WittVector p k) := by
  refine charZero_of_inj_zero ?_
  intro n hn
  induction n using Nat.strong_induction_on with
  | h n ih =>
      by_cases hn0 : n = 0
      · exact hn0
      have hconst : (n : k) = 0 := by
        -- The constant coefficient of a natural Witt vector is the same natural number in `k`.
        simpa using congrArg (WittVector.constantCoeff : WittVector p k →+* k) hn
      have hpdvd : p ∣ n := (CharP.cast_eq_zero_iff k p n).mp hconst
      rcases hpdvd with ⟨m, rfl⟩
      have hm_mul_zero : ((m : WittVector p k) * (p : WittVector p k)) = 0 := by
        -- Peel off one factor of `p` from the vanished natural Witt vector.
        simpa [Nat.cast_mul, mul_comm, mul_left_comm, mul_assoc] using hn
      have hm_zero : (m : WittVector p k) = 0 :=
        WittVector.eq_zero_of_p_mul_eq_zero (p := p) (k := k) (x := (m : WittVector p k))
          hm_mul_zero
      have hm0 : m ≠ 0 := by
        intro hm0
        exact hn0 (by simp [hm0])
      have hm_lt : m < p * m := by
        -- Dividing by `p` strictly decreases a positive natural number because `p > 1`.
        calc
          m = 1 * m := by simp
          _ < p * m := by
              exact
                Nat.mul_lt_mul_of_pos_right
                  (show 1 < p from (Fact.out : Nat.Prime p).one_lt)
                  (Nat.pos_of_ne_zero hm0)
      have hm_eq_zero : m = 0 := ih m hm_lt hm_zero
      simp [hm_eq_zero]

/-- Helper for Theorem 18-18.2-1: LinearRepresentations_Serre_1977's mixed-character route can be frozen at the single owner
`W(k)` with fraction field `Frac(W(k))`, together with the residue identification back to `k`. -/
theorem mixed_character_owner_with_residue_equiv_local [Fact p.Prime] :
    ∃ (A0 : Type u) (_ : CommRing A0) (_ : Fact p.Prime) (_ : IsLocalRing A0)
      (_ : IsDomain A0) (_ : IsDiscreteValuationRing A0)
      (K0 : Type u) (_ : Field K0) (_ : Algebra A0 K0) (_ : IsFractionRing A0 K0)
      (_ : CharZero K0) (_e0 : IsLocalRing.ResidueField A0 ≃+* k), True := by
  haveI : CharZero (WittVector p k) := wittVector_charZero_local (p := p) (k := k)
  -- Freeze all later transport on the single source-faithful owner `W(k)`.
  refine ⟨WittVector p k, inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, FractionRing (WittVector p k), inferInstance, inferInstance, inferInstance,
    inferInstance, wittVector_residueField_ringEquiv_local (p := p) (k := k), True.intro⟩

end

end Representation
