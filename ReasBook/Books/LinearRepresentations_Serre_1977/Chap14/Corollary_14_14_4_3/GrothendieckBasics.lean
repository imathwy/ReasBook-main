import Mathlib
import LinearRepresentations_Serre_1977.Chap14.Corollary_14_14_4_3.ProjectiveModules

noncomputable section

open Module
open CategoryTheory CategoryTheory.Limits
open scoped MonoidAlgebra Representation TensorProduct
open scoped ZeroObject

universe u w

namespace Representation

section ProjectiveGrothendieckGroup

variable (A : Type u) [CommRing A]
variable (G : Type u) [Group G]

/-- The subgroup of the free abelian group on finite projective `A[G]`-modules generated by the
short-exact-sequence relations `[Y] - [X] - [Z]`. -/
def finiteProjectiveGroupAlgebraGrothendieckRelations :
    AddSubgroup (FreeAbelianGroup (FiniteProjectiveGroupAlgebraModule A G)) :=
  AddSubgroup.closure <|
    Set.range fun S :
      { S : ShortComplex (FiniteProjectiveGroupAlgebraModule A G) // S.ShortExact } ↦
      FreeAbelianGroup.of S.1.X₂ - FreeAbelianGroup.of S.1.X₁ - FreeAbelianGroup.of S.1.X₃

/-- LinearRepresentations_Serre_1977's Grothendieck group `P_A(G)`, realized as the Grothendieck group of the exact category
of finite projective `A[G]`-modules. -/
abbrev finiteProjectiveGroupAlgebraGrothendieckGroup :=
  FreeAbelianGroup (FiniteProjectiveGroupAlgebraModule A G) ⧸
    finiteProjectiveGroupAlgebraGrothendieckRelations A G

local notation:max "P₀[" A "](" G ")" =>
  finiteProjectiveGroupAlgebraGrothendieckGroup A G

variable {A : Type u} [CommRing A]
variable {G : Type u} [Group G]

/-- The class of a finite projective `A[G]`-module in `P_A(G)`. -/
def finiteProjectiveGroupAlgebraGrothendieckClass
    (P : FiniteProjectiveGroupAlgebraModule A G) :
    P₀[A](G) :=
  QuotientAddGroup.mk'
    (finiteProjectiveGroupAlgebraGrothendieckRelations A G)
    (FreeAbelianGroup.of P)

scoped[Representation] notation:max "[" P "]ₚ₀" =>
  finiteProjectiveGroupAlgebraGrothendieckClass P

open scoped Representation

variable {A : Type u} [CommRing A] [IsLocalRing A]
variable {G : Type u} [Group G] [Finite G]

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: in `P₀[A](G)`, a short exact sequence of finite projective
`A[G]`-modules yields the expected Grothendieck relation. -/
theorem finiteProjectiveGroupAlgebraGrothendieckClass_middle_eq_left_add_right
    (S : ShortComplex (FiniteProjectiveGroupAlgebraModule A G)) (hS : S.ShortExact) :
    [S.X₂]ₚ₀ = [S.X₁]ₚ₀ + [S.X₃]ₚ₀ := by
  -- The defining generator attached to `S` dies in the quotient Grothendieck group.
  have hzero :
      QuotientAddGroup.mk' (finiteProjectiveGroupAlgebraGrothendieckRelations A G)
        (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) =
        0 := by
    exact (QuotientAddGroup.eq_zero_iff _).2 <|
      AddSubgroup.subset_closure ⟨⟨S, hS⟩, rfl⟩
  refine (sub_eq_zero.mp ?_)
  simpa [finiteProjectiveGroupAlgebraGrothendieckClass, sub_eq_add_neg,
    add_assoc, add_left_comm, add_comm] using hzero

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: the zero finite projective `A[G]`-module has trivial class in
`P₀[A](G)`. -/
@[simp] theorem finiteProjectiveGroupAlgebraGrothendieckClass_zero :
    [(0 : FiniteProjectiveGroupAlgebraModule A G)]ₚ₀ = 0 := by
  let S : ShortComplex (FiniteProjectiveGroupAlgebraModule A G) :=
    ShortComplex.mk
      (0 : (0 : FiniteProjectiveGroupAlgebraModule A G) ⟶ 0)
      (0 : (0 : FiniteProjectiveGroupAlgebraModule A G) ⟶ 0)
      (by simp)
  have hS : S.ShortExact := by
    -- The zero short complex is exact, and both structure maps are mono/epi by zero-object API.
    refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    exact (S.exact_iff_epi rfl).2 inferInstance
  have hrelation :=
    finiteProjectiveGroupAlgebraGrothendieckClass_middle_eq_left_add_right (A := A) (G := G) S hS
  simpa [S] using hrelation

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: isomorphic finite projective `A[G]`-modules define the same
Grothendieck class. -/
theorem finiteProjectiveGroupAlgebraGrothendieckClass_eq_of_nonempty_iso
    {P Q : FiniteProjectiveGroupAlgebraModule A G} (hPQ : Nonempty (P ≅ Q)) :
    [P]ₚ₀ = [Q]ₚ₀ := by
  rcases hPQ with ⟨e⟩
  let S : ShortComplex (FiniteProjectiveGroupAlgebraModule A G) :=
    ShortComplex.mk e.hom (0 : Q ⟶ (0 : FiniteProjectiveGroupAlgebraModule A G)) (by simp)
  have hS : S.ShortExact := by
    -- Route correction: instead of comparing classes directly, record the exact sequence
    -- `0 → P → Q → 0` induced by the isomorphism.
    refine ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance
    exact (S.exact_iff_epi rfl).2 inferInstance
  have hrelation :=
    finiteProjectiveGroupAlgebraGrothendieckClass_middle_eq_left_add_right (A := A) (G := G) S hS
  simpa [S, finiteProjectiveGroupAlgebraGrothendieckClass_zero (A := A) (G := G)] using
    hrelation.symm

omit [IsLocalRing A] [Finite G] in
/-- Helper for Corollary 14-14.4-3: an isomorphism in the finite-projective owner category is the
same as an `A[G]`-linear equivalence of the underlying modules. -/
theorem finiteProjectiveGroupAlgebraModule_nonempty_iso_iff_nonempty_linearEquiv
    (P Q : FiniteProjectiveGroupAlgebraModule A G) :
    Nonempty (P ≅ Q) ↔ Nonempty (P.V ≃ₗ[A[G]] Q.V) := by
  constructor
  · intro hPQ
    rcases hPQ with ⟨i⟩
    -- Forget the full-subcategory isomorphism to `FGModuleCat` and then to a linear equivalence.
    let iFG : P.obj ≅ Q.obj :=
      { hom := i.hom.hom
        inv := i.inv.hom
        hom_inv_id := by
          exact ObjectProperty.isoHom_inv_id_hom i
        inv_hom_id := by
          exact ObjectProperty.isoInv_hom_id_hom i }
    exact ⟨FGModuleCat.isoToLinearEquiv iFG⟩
  · intro hPQ
    rcases hPQ with ⟨e⟩
    -- Repackage the module equivalence as an isomorphism in the full subcategory.
    let iFG : P.obj ≅ Q.obj :=
      { hom := ConcreteCategory.ofHom e.toLinearMap
        inv := ConcreteCategory.ofHom e.symm.toLinearMap
        hom_inv_id := by
          ext x
          exact e.left_inv x
        inv_hom_id := by
          ext x
          exact e.right_inv x }
    exact ⟨ObjectProperty.isoMk _ iFG⟩

end ProjectiveGrothendieckGroup

end Representation
