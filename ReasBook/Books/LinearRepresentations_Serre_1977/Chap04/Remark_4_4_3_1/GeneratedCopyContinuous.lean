import LinearRepresentations_Serre_1977.Chap04.Remark_4_4_3_1.GeneratedCopyScalar

open MeasureTheory
open DomMulAct
open scoped ENNReal MonoidAlgebra
open scoped ComplexStarModule
open scoped Representation.ExplicitDecomposition

noncomputable section

universe u v

namespace Representation

open Remark_4_4_3_1
local notation "L²(" G ")" => G →₂[(Measure.haar : Measure G)] ℂ

section PeterWeyl

variable {G : Type u} [MeasurableSpace G] [Group G] [TopologicalSpace G] [BorelSpace G]
  [IsTopologicalGroup G] [CompactSpace G] [T2Space G] [Finite G]
variable {W : Type v} [TopologicalSpace W] [AddCommGroup W] [Module ℂ W]
  [IsTopologicalAddGroup W] [ContinuousSMul ℂ W] [T2Space W] [FiniteDimensional ℂ W]

theorem matrixCoefficient_codRestrict_generated_copy_smul_eq
    {ι : Type v} [Fintype ι]
    (σ : Representation ℂ G W) [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (hbasis : basis oneIndex = chosen_irreducible_vector (G := G) σ)
    (r : (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule)
    (hr : r ∈
      V⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis⟯ oneIndex)
    (hr0 : r ≠ 0)
    (c : ℂ) (hc : c ≠ 0) :
    let τ := ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)
    let y : (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule := c • r
    let hy : y ∈ V⟮τ,σ,basis⟯ oneIndex := by
      exact (V⟮τ,σ,basis⟯ oneIndex).smul_mem c hr
    let x₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨r, hr⟩
    let y₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨y, hy⟩
    W⟮τ,σ,basis,oneIndex⟯ y₁ = W⟮τ,σ,basis,oneIndex⟯ x₁ := by
  let τ := ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)
  let y : (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule := c • r
  have hy : y ∈ V⟮τ,σ,basis⟯ oneIndex := by
    exact (V⟮τ,σ,basis⟯ oneIndex).smul_mem c hr
  let x₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨r, hr⟩
  let y₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨y, hy⟩
  have hy0 : y ≠ 0 := by
    simpa [y] using smul_ne_zero hc hr0
  have hcyc_eq : V⟮τ⟯ y = V⟮τ⟯ r := by
    apply le_antisymm
    · -- The scaled generator `c • r` already lies in the cyclic representation generated by `r`.
      refine cyclicSubrepresentation_le_of_mem τ (V⟮τ⟯ r) ?_
      simpa [y] using
        (V⟮τ⟯ r).toSubmodule.smul_mem c (mem_cyclicSubrepresentation τ r)
    · -- Because `c` is nonzero, recover `r` from `c • r` by scaling with `c⁻¹`.
      refine cyclicSubrepresentation_le_of_mem τ (V⟮τ⟯ y) ?_
      have hy_mem : y ∈ (V⟮τ⟯ y).toSubmodule := mem_cyclicSubrepresentation τ y
      have hr_mem : r ∈ (V⟮τ⟯ y).toSubmodule := by
        simpa [y, smul_smul, inv_mul_cancel₀ hc, one_smul] using
          (V⟮τ⟯ y).toSubmodule.smul_mem c⁻¹ hy_mem
      exact hr_mem
  -- Replace both generated copies by the corresponding cyclic subrepresentations and compare them.
  calc
    W⟮τ,σ,basis,oneIndex⟯ y₁ = V⟮τ⟯ y := by
      symm
      simpa [τ, y, y₁] using
        matrixCoefficient_codRestrict_first_coordinate_cyclicSubrepresentation_eq_generated_copy
          (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex)
          hbasis (y := y) (hy := hy) (hy0 := hy0)
    _ = V⟮τ⟯ r := hcyc_eq
    _ = W⟮τ,σ,basis,oneIndex⟯ x₁ := by
      simpa [τ, x₁] using
        matrixCoefficient_codRestrict_first_coordinate_cyclicSubrepresentation_eq_generated_copy
          (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex)
          hbasis (y := r) (hy := hr) (hy0 := hr0)

/-- Helper for Remark 4-4.3-1: a nonzero evaluated coefficient vector `E ℓ = c • r` already
upgrades to a genuine coefficient intertwiner whose whole image lies in the single generated copy
`W(r)` and which is nonzero on the chosen source vector. This packages the postprocessing step
from an eventual Proposition 8(c) scalar witness to the stronger copy-local witness. -/
theorem matrixCoefficient_codRestrict_copy_local_witness_of_nonzero_eval
    {ι : Type v} [Fintype ι]
    (σ : Representation ℂ G W) (hσ : Continuous fun p : G × W ↦ σ p.1 p.2)
    [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (hbasis : basis oneIndex = chosen_irreducible_vector (G := G) σ)
    (r : (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule)
    (hr : r ∈
      V⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis⟯ oneIndex)
    (hr0 : r ≠ 0)
    (ell : Module.Dual ℂ W) (c : ℂ)
    (hc : c ≠ 0)
    (hEval :
      matrixCoefficient_codRestrict_evalAtChosenLinear (G := G) σ hσ ell = c • r) :
    ∃ T : σ.IntertwiningMap
        ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),
      T ∈ LinearMap.range
          (matrixCoefficientIntertwining_l2Regular_codRestrictLinear
            (G := G) σ hσ) ∧
        (∀ x : W,
          T x ∈
            (W⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis,
              oneIndex⟯ ⟨r, hr⟩).toSubmodule) ∧
        T (chosen_irreducible_vector (G := G) σ) ≠ 0 := by
  let τ := ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)
  let Φ := matrixCoefficientIntertwining_l2Regular_codRestrictLinear (G := G) σ hσ
  let E := matrixCoefficient_codRestrict_evalAtChosenLinear (G := G) σ hσ
  let x₀ : W := chosen_irreducible_vector (G := G) σ
  let y : (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule := c • r
  have hy : y ∈ V⟮τ,σ,basis⟯ oneIndex := by
    exact (V⟮τ,σ,basis⟯ oneIndex).smul_mem c hr
  have hy0 : y ≠ 0 := by
    simpa [y] using smul_ne_zero hc hr0
  let x₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨r, hr⟩
  let y₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨y, hy⟩
  have hT0_range : (Φ ell) ∈ LinearMap.range Φ := by
    exact ⟨ell, rfl⟩
  have hT0x₀ : (Φ ell) x₀ = y := by
    -- Evaluate the coefficient witness at the chosen source vector.
    simpa [E, Φ, x₀, y] using hEval
  let inclLin :
      (W⟮τ,σ,basis,oneIndex⟯ y₁).toSubmodule →ₗ[ℂ]
        (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule :=
    (W⟮τ,σ,basis,oneIndex⟯ y₁).toSubmodule.subtype
  let incl :
      ((W⟮τ,σ,basis,oneIndex⟯ y₁).toRepresentation).IntertwiningMap τ :=
    inclLin.intertwiningMap_of_isIntertwiningMap
      ((W⟮τ,σ,basis,oneIndex⟯ y₁).toRepresentation) τ
      (fun g x ↦ by
        apply Subtype.ext
        rfl)
  let T :
      σ.IntertwiningMap τ :=
    incl.comp (ExplicitDecomposition.generatedSubrepresentationHom τ σ basis oneIndex y₁)
  have hT_range :
      T ∈ LinearMap.range Φ := by
    -- First realize the scaled vector `c • r` as the chosen-vector value of a coefficient
    -- intertwiner, then upgrade it to the canonical generated-copy inclusion.
    simpa [T, y₁, incl, inclLin] using
      matrixCoefficient_codRestrict_generated_copy_hom_mem_range_of_fixedVector_preimage
        (G := G) (σ := σ) (hσ := hσ) (basis := basis) (oneIndex := oneIndex)
        hbasis (y := y) (hy := hy) (hy0 := hy0) (Φ ell) hT0_range hT0x₀
  have hcopy_eq :
      W⟮τ,σ,basis,oneIndex⟯ y₁ = W⟮τ,σ,basis,oneIndex⟯ x₁ := by
    -- The source copy does not change when the generator is rescaled by a nonzero scalar.
    simpa [τ, y, y₁, x₁] using
      matrixCoefficient_codRestrict_generated_copy_smul_eq
        (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex)
        hbasis (r := r) (hr := hr) (hr0 := hr0) c hc
  have hT_mem :
      ∀ x : W, T x ∈ (W⟮τ,σ,basis,oneIndex⟯ x₁).toSubmodule := by
    intro x
    have hmem_y :
        T x ∈ (W⟮τ,σ,basis,oneIndex⟯ y₁).toSubmodule := by
      -- By construction the canonical witness factors through the generated copy `W(c • r)`.
      simpa [T, incl, inclLin] using
        ((ExplicitDecomposition.generatedSubrepresentationHom τ σ basis oneIndex y₁) x).2
    simpa [hcopy_eq] using hmem_y
  have hT_eq_evalSymm :
      T = (ExplicitDecomposition.intertwiningMapEvaluationEquiv τ σ basis oneIndex).symm y₁ := by
    -- The canonical generated-copy inclusion is exactly the Exercise 2-2.7-2 inverse.
    simpa [T, incl, inclLin, y₁,
      ExplicitDecomposition.generatedSubrepresentationEquiv,
      ExplicitDecomposition.generatedSubrepresentationHom] using
      matrixCoefficient_codRestrict_generated_copy_ambient_intertwiner_eq_evalSymm
        (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex)
        (y := y) (hy := hy) (hy0 := hy0)
  have hTx₀ : T x₀ = y := by
    -- Evaluate the canonical Exercise 2-2.7-2 inverse on the chosen source vector.
    have hTbasis : T (basis oneIndex) = y := by
      have hcoord :
          ((ExplicitDecomposition.intertwiningMapEvaluationEquiv τ σ basis oneIndex).symm y₁)
              (basis oneIndex) = y := by
        exact congrArg Subtype.val
          (LinearEquiv.apply_symm_apply
            (ExplicitDecomposition.intertwiningMapEvaluationEquiv τ σ basis oneIndex) y₁)
      exact
        (congrArg (fun f : σ.IntertwiningMap τ ↦ f (basis oneIndex)) hT_eq_evalSymm).trans hcoord
    simpa [x₀, hbasis] using hTbasis
  have hTx₀_ne : T x₀ ≠ 0 := by
    -- The chosen-vector value is the nonzero scaled vector `c • r`.
    simpa [hTx₀] using hy0
  exact ⟨T, hT_range, hT_mem, hTx₀_ne⟩

/-- Helper for Remark 4-4.3-1: the remaining open source-local bridge is to produce a genuine
coefficient intertwiner already supported on the single generated copy `W(r)` and nonzero on the
chosen source vector. Once this witness exists, the scalar-line argument above finishes
Proposition 8(c). -/
theorem matrixCoefficient_codRestrict_mem_range_of_continuous_model
    (σ : Representation ℂ G W) (hσ : Continuous fun p : G × W ↦ σ p.1 p.2)
    [σ.IsIrreducible]
    (D : σ.IntertwiningMap
      ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation))
    (F : W →ₗ[ℂ] C(G, ℂ))
    (hF_toLp :
      (ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ).toLinearMap.comp
          F =
        ((l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule.subtype).comp D.toLinearMap)
    (hF_cov :
      ∀ g : G, ∀ x : W,
        F (σ g x) =
          (F x).comp ⟨fun t : G ↦ g⁻¹ * t, continuous_const.mul continuous_id⟩) :
    D ∈ LinearMap.range
      (matrixCoefficientIntertwining_l2Regular_codRestrictLinear (G := G) σ hσ) := by
  let ell : Module.Dual ℂ W where
    toFun x := F x 1
    map_add' x y := by
      simp
    map_smul' a x := by
      simp
  let e :=
    (nonempty_intertwiningMap_l2Regular_isotypicSubrepresentation_linearEquiv
      (G := G) (σ := σ)).some
  have hfull :
      matrixCoefficientIntertwining_l2Regular (G := G) σ hσ ell = e D := by
    apply Representation.IntertwiningMap.ext
    intro x
    have hFx :
        ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ (F x) =
          (e D) x := by
      have hFx_toLp := congrArg (fun L : W →ₗ[ℂ] L²(G) ↦ L x) hF_toLp
      simpa [e, nonempty_intertwiningMap_l2Regular_isotypicSubrepresentation_linearEquiv] using
        hFx_toLp
    have hcont :
        matrixCoefficientContinuousMap σ hσ x ell = F x := by
      ext t
      calc
        matrixCoefficientContinuousMap σ hσ x ell t
            = ell (σ t⁻¹ x) := rfl
        _ = F (σ t⁻¹ x) 1 := rfl
        _ = ((F x).comp ⟨fun u : G ↦ (t⁻¹)⁻¹ * u, continuous_const.mul continuous_id⟩) 1 := by
              rw [hF_cov t⁻¹ x]
        _ = F x t := by
              simp
    calc
      (matrixCoefficientIntertwining_l2Regular (G := G) σ hσ ell) x
          =
        ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ
          (matrixCoefficientContinuousMap σ hσ x ell) := rfl
      _ =
        ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ (F x) := by
            rw [hcont]
      _ = (e D) x := hFx
  refine ⟨ell, ?_⟩
  change e.symm (matrixCoefficientIntertwining_l2Regular (G := G) σ hσ ell) = D
  exact e.injective hfull

/-- Helper for Remark 4-4.3-1: the remaining open source-local bridge is to produce a genuine
coefficient intertwiner already supported on the single generated copy `W(r)` and nonzero on the
chosen source vector. Once this witness exists, the scalar-line argument above finishes
Proposition 8(c). -/
theorem
    matrixCoefficient_codRestrict_exists_copy_local_coefficient_witness_of_evalSymm_mem_range
    {ι : Type v} [Fintype ι]
    (σ : Representation ℂ G W) (hσ : Continuous fun p : G × W ↦ σ p.1 p.2)
    [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (hbasis : basis oneIndex = chosen_irreducible_vector (G := G) σ)
    (r : (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule)
    (hr : r ∈
      V⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis⟯ oneIndex)
    (hr0 : r ≠ 0)
    (hEvalSymm_range :
      let τ := ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)
      let x₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨r, hr⟩
      (ExplicitDecomposition.intertwiningMapEvaluationEquiv τ σ basis oneIndex).symm x₁ ∈
        LinearMap.range
          (matrixCoefficientIntertwining_l2Regular_codRestrictLinear
            (G := G) σ hσ)) :
    ∃ T : σ.IntertwiningMap
        ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),
      T ∈ LinearMap.range
          (matrixCoefficientIntertwining_l2Regular_codRestrictLinear
            (G := G) σ hσ) ∧
        (∀ x : W,
          T x ∈
            (W⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis,
              oneIndex⟯ ⟨r, hr⟩).toSubmodule) ∧
        T (chosen_irreducible_vector (G := G) σ) ≠ 0 := by
  let τ := ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)
  let Φ := matrixCoefficientIntertwining_l2Regular_codRestrictLinear (G := G) σ hσ
  let x₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨r, hr⟩
  let T : σ.IntertwiningMap τ :=
    (ExplicitDecomposition.intertwiningMapEvaluationEquiv τ σ basis oneIndex).symm x₁
  let x₀ : W := chosen_irreducible_vector (G := G) σ
  have hT_range : T ∈ LinearMap.range Φ := by
    -- This helper only repackages the precise remaining blocker as the desired witness.
    simpa [τ, Φ, x₁, T] using hEvalSymm_range
  have hT_mem :
      ∀ x : W, T x ∈ (W⟮τ,σ,basis,oneIndex⟯ x₁).toSubmodule := by
    intro x
    -- The canonical Exercise 2-2.7-2 inverse already factors through the generated copy `W(r)`.
    simpa [τ, x₁, T] using
      matrixCoefficient_codRestrict_evalSymm_mem_generated_copy
        (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex)
        (y := r) (hy := hr) (hy0 := hr0) x
  have hTx₀ : T x₀ = r := by
    rcases
        matrixCoefficient_codRestrict_generated_copy_exists_ambient_intertwiner
          (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex)
          hbasis (y := r) (hy := hr) (hy0 := hr0) with
      ⟨D, hDx₀, hD_mem⟩
    have hD_eq : D = T := by
      -- Compare the canonical ambient inclusion with the Exercise 2-2.7-2 inverse.
      simpa [τ, x₁, T] using
        matrixCoefficient_codRestrict_generated_copy_ambient_intertwiner_eq_evalSymm
          (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex)
          (y := r) (hy := hr) (hy0 := hr0)
    -- Evaluate the identified ambient inclusion on the chosen source vector.
    have hD_eval : D x₀ = T x₀ := by
      exact congrArg (fun f : σ.IntertwiningMap τ ↦ f x₀) hD_eq
    calc
      T x₀ = D x₀ := hD_eval.symm
      _ = r := hDx₀
  have hTx₀_ne : T x₀ ≠ 0 := by
    -- The prescribed first-coordinate vector is nonzero, so the canonical inverse is nonzero on
    -- the cyclic generator.
    simpa [hTx₀] using hr0
  exact ⟨T, hT_range, hT_mem, hTx₀_ne⟩

/-- Helper for Remark 4-4.3-1: the remaining open source-local bridge is to produce a genuine
coefficient intertwiner already supported on the single generated copy `W(r)` and nonzero on the
chosen source vector. Once this witness exists, the scalar-line argument above finishes
Proposition 8(c). -/
theorem
    matrixCoefficient_codRestrict_generated_copy_continuous_regular_model_of_nonzero_eval
    {ι : Type v} [Fintype ι]
    (σ : Representation ℂ G W) (hσ : Continuous fun p : G × W ↦ σ p.1 p.2)
    [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (hbasis : basis oneIndex = chosen_irreducible_vector (G := G) σ)
    (r : (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule)
    (hr : r ∈
      V⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis⟯ oneIndex)
    (hr0 : r ≠ 0)
    (ell : Module.Dual ℂ W) (c : ℂ) (hc : c ≠ 0)
    (hEval :
      matrixCoefficient_codRestrict_evalAtChosenLinear (G := G) σ hσ ell = c • r) :
    let τ := ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)
    let x₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨r, hr⟩
    let U := W⟮τ,σ,basis,oneIndex⟯ x₁
    ∃ R : U.toSubmodule →ₗ[ℂ] C(G, ℂ),
      (ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ).toLinearMap.comp
          R =
        (((l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule.subtype).comp
          U.toSubmodule.subtype) ∧
      (∀ g : G, ∀ u : U.toSubmodule,
        R (U.toRepresentation g u) =
          (R u).comp ⟨fun t : G ↦ g⁻¹ * t, continuous_const.mul continuous_id⟩) := by
  let τ := ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)
  let x₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨r, hr⟩
  let U := W⟮τ,σ,basis,oneIndex⟯ x₁
  obtain ⟨T, hT_range, hT_mem, hTx₀_ne⟩ :=
    matrixCoefficient_codRestrict_copy_local_witness_of_nonzero_eval
      (G := G) (σ := σ) (hσ := hσ) (basis := basis) (oneIndex := oneIndex)
      hbasis (r := r) (hr := hr) (hr0 := hr0) ell c hc hEval
  rcases hT_range with ⟨ellT, hTell⟩
  let TcopyLin : W →ₗ[ℂ] U.toSubmodule :=
    T.toLinearMap.codRestrict U.toSubmodule hT_mem
  let Tcopy : σ.IntertwiningMap U.toRepresentation :=
    TcopyLin.intertwiningMap_of_isIntertwiningMap σ U.toRepresentation
      (fun g x ↦ by
        apply Subtype.ext
        simpa [TcopyLin] using congr($(T.isIntertwining' g) x))
  let eU : σ.Equiv U.toRepresentation :=
    (matrixCoefficient_codRestrict_generated_copy_equiv
      (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex)
      (y := r) (hy := hr) (hy0 := hr0)).some
  let A : σ.IntertwiningMap σ := eU.symm.toIntertwiningMap.comp Tcopy
  have hTcopy_x₀_ne :
      Tcopy (chosen_irreducible_vector (G := G) σ) ≠ 0 := by
    intro hzero
    apply hTx₀_ne
    exact congrArg Subtype.val hzero
  have hTcopy_fromA :
      ∀ x : W, Tcopy x = eU (A x) := by
    intro x
    simp [A]
  have hA_ne : A ≠ 0 := by
    intro hA0
    apply hTcopy_x₀_ne
    rw [hTcopy_fromA (chosen_irreducible_vector (G := G) σ), hA0]
    simp
  have hA_bij : Function.Bijective A := by
    exact (Representation.IsIrreducible.bijective_or_eq_zero A).resolve_right hA_ne
  have hTcopy_bij : Function.Bijective Tcopy := by
    refine ⟨?_, ?_⟩
    · intro x y hxy
      apply hA_bij.1
      apply eU.injective
      simpa [hTcopy_fromA x, hTcopy_fromA y] using hxy
    · intro u
      rcases hA_bij.2 (eU.symm u) with ⟨x, hx⟩
      refine ⟨x, ?_⟩
      calc
        Tcopy x = eU (A x) := hTcopy_fromA x
        _ = eU (eU.symm u) := by rw [hx]
        _ = u := eU.apply_symm_apply u
  let eT : σ.Equiv U.toRepresentation := Tcopy.ofBijective hTcopy_bij
  let Rbase : W →ₗ[ℂ] C(G, ℂ) := matrixCoefficientLinear σ hσ ellT
  let R : U.toSubmodule →ₗ[ℂ] C(G, ℂ) := Rbase.comp eT.symm.toLinearEquiv.toLinearMap
  let eFull :=
    (nonempty_intertwiningMap_l2Regular_isotypicSubrepresentation_linearEquiv
      (G := G) (σ := σ)).some
  have hfull :
      matrixCoefficientIntertwining_l2Regular (G := G) σ hσ ellT = eFull T := by
    -- Apply the fixed corestriction equivalence to the chosen range witness for `T`.
    simpa [eFull, matrixCoefficientIntertwining_l2Regular_codRestrictLinear,
      matrixCoefficientIntertwining_l2RegularLinear] using congrArg eFull hTell
  refine ⟨R, ?_, ?_⟩
  · -- Evaluate the transported coefficient family pointwise and rewrite it as the ambient
    -- inclusion of the generated copy.
    ext u
    have hRu :
        ((ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ).toLinearMap
            (Rbase (eT.symm u))) =
          (((l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule.subtype)
            (T (eT.symm u))) := by
      have hfull_u := congrArg
        (fun F : σ.IntertwiningMap (l2RegularModel G) ↦ F (eT.symm u)) hfull
      simpa [Rbase, matrixCoefficientIntertwining_l2Regular, matrixCoefficientLinear,
        eFull, nonempty_intertwiningMap_l2Regular_isotypicSubrepresentation_linearEquiv] using
        hfull_u
    have hTu :
        T (eT.symm u) = U.toSubmodule.subtype u := by
      change U.toSubmodule.subtype (Tcopy (eT.symm u)) = U.toSubmodule.subtype u
      simpa [eT] using congrArg U.toSubmodule.subtype (eT.apply_symm_apply u)
    calc
      ((ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ).toLinearMap
          (R u))
        =
          ((ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ).toLinearMap
            (Rbase (eT.symm u))) := rfl
      _ =
          (((l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule.subtype)
            (T (eT.symm u))) := hRu
      _ =
          (((l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule.subtype)
            (U.toSubmodule.subtype u)) := by
              exact congrArg
                ((l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule.subtype) hTu
  · -- Transport the matrix-coefficient covariance along the copy equivalence `eT`.
    intro g u
    calc
      R (U.toRepresentation g u) = Rbase (eT.symm (U.toRepresentation g u)) := rfl
      _ = Rbase (σ g (eT.symm u)) := by
            simpa using congr($(eT.symm.isIntertwining' g) u)
      _ = (Rbase (eT.symm u)).comp
            ⟨fun t : G ↦ g⁻¹ * t, continuous_const.mul continuous_id⟩ := by
              simpa [Rbase] using
                matrixCoefficientContinuousMap_mul_left
                  (σ := σ) (hσ := hσ) (g := g) (x := eT.symm u) (ℓ := ellT)
      _ = (R u).comp
            ⟨fun t : G ↦ g⁻¹ * t, continuous_const.mul continuous_id⟩ := rfl

/-- Helper for Remark 4-4.3-1: the remaining open source-local bridge is to produce a genuine
coefficient intertwiner already supported on the single generated copy `W(r)` and nonzero on the
chosen source vector. Once this witness exists, the scalar-line argument above finishes
Proposition 8(c). -/
theorem
    matrixCoefficient_codRestrict_generated_copy_continuous_regular_model_of_scalar_evaluation
    {ι : Type v} [Fintype ι]
    (σ : Representation ℂ G W) (hσ : Continuous fun p : G × W ↦ σ p.1 p.2)
    [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (hbasis : basis oneIndex = chosen_irreducible_vector (G := G) σ)
    (r : (l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule)
    (hr : r ∈
      V⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis⟯ oneIndex)
    (hr0 : r ≠ 0)
    (hnonzero_eval :
      ∃ ell : Module.Dual ℂ W, ∃ c : ℂ, c ≠ 0 ∧
        matrixCoefficient_codRestrict_evalAtChosenLinear (G := G) σ hσ ell = c • r) :
    let τ := ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)
    let x₁ : V⟮τ,σ,basis⟯ oneIndex := ⟨r, hr⟩
    let U := W⟮τ,σ,basis,oneIndex⟯ x₁
    ∃ R : U.toSubmodule →ₗ[ℂ] C(G, ℂ),
      (ContinuousMap.toLp (E := ℂ) (p := (2 : ℝ≥0∞)) (Measure.haar : Measure G) ℂ).toLinearMap.comp
          R =
        (((l2RegularIsotypicSubrepresentation (G := G) σ).toSubmodule.subtype).comp
          U.toSubmodule.subtype) ∧
      (∀ g : G, ∀ u : U.toSubmodule,
        R (U.toRepresentation g u) =
          (R u).comp ⟨fun t : G ↦ g⁻¹ * t, continuous_const.mul continuous_id⟩) := by
  rcases hnonzero_eval with ⟨ell, c, hc, hEval⟩
  -- Once Proposition 8(c) gives a nonzero evaluated coefficient on the first coordinate line,
  -- the previously isolated transport lemma builds the full continuous model of `W(r)`.
  exact
    matrixCoefficient_codRestrict_generated_copy_continuous_regular_model_of_nonzero_eval
      (G := G) (σ := σ) (hσ := hσ) (basis := basis) (oneIndex := oneIndex)
      hbasis (r := r) (hr := hr) (hr0 := hr0) ell c hc hEval

/-- Helper for Remark 4-4.3-1: asking for a nonzero scalar multiple of `r` in the evaluated
coefficient range is equivalent to asking that `r` itself already lie in that range. This isolates
the remaining source-faithful blocker to exact first-coordinate range-membership. -/

end PeterWeyl

end Representation
