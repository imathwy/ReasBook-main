section CyclicSubrepresentation

variable {k : Type v} [CommSemiring k]
variable {G : Type u} [Monoid G]
variable {V : Type*} [AddCommMonoid V] [Module k V]

/-- Helper for Remark 4-4.3-1: the smallest subrepresentation `V(x)` containing a vector `x`,
realized as the cyclic subrepresentation generated by `x`. This local owner copy avoids the
duplicate-instance import collision from `Exercise_2_2_7_4`. -/
abbrev cyclicSubrepresentation (ρ : Representation k G V) (x : V) : Subrepresentation ρ :=
  Subrepresentation.ofSubmodule' (Submodule.span k[G] {ρ.asModuleEquiv.symm x})

scoped[Representation.ExplicitDecomposition] notation3 "V⟮" ρ "⟯" =>
  Representation.cyclicSubrepresentation ρ

/-- Helper for Remark 4-4.3-1: the generator `x` belongs to its cyclic subrepresentation
`V(x)`. This is the local owner lemma paired with `V⟮ρ⟯ x`. -/
theorem mem_cyclicSubrepresentation (ρ : Representation k G V) (x : V) :
    x ∈ V⟮ρ⟯ x := by
  change ρ.asModuleEquiv.symm x ∈ Submodule.span k[G] {ρ.asModuleEquiv.symm x}
  exact Submodule.mem_span_singleton_self _

/-- Helper for Remark 4-4.3-1: the cyclic subrepresentation is the smallest stable subspace
containing its generator. This local owner lemma replaces the colliding import from
`Exercise_2_2_7_4`. -/
theorem cyclicSubrepresentation_le_of_mem
    (ρ : Representation k G V) {x : V} (U : Subrepresentation ρ)
    (hx : x ∈ U.toSubmodule) :
    V⟮ρ⟯ x ≤ U := by
  change Submodule.span k[G] ({ρ.asModuleEquiv.symm x} : Set ρ.asModule) ≤ U.asSubmodule
  refine Submodule.span_le.2 ?_
  intro y hy
  rcases hy with rfl
  simpa using hx

end CyclicSubrepresentation

open Remark_4_4_3_1
local notation "L²(" G ")" => G →₂[(Measure.haar : Measure G)] ℂ
section L2Regular
variable (G : Type u) [MeasurableSpace G] [Group G] [TopologicalSpace G] [BorelSpace G]
  [IsTopologicalGroup G] [LocallyCompactSpace G]
/-- Remark 4-4.3-1 (1): source part (b). The left-regular `L²` representation of a locally compact
group is the Hilbert space `L²(G)` of Haar-square-integrable complex-valued functions,
with action `(ρ_s f)(t) = f (s⁻¹ * t)`. This source-facing owner is the thin bridge obtained by
composing mathlib's canonical `DomMulAct` action on `L²(G)` with the canonical inversion map
`MulEquiv.inv' G : G ≃* Gᵈᵐᵃ`. -/
abbrev l2Regular :
    Representation ℂ G L²(G) :=
  (ofDistribMulAction ℂ Gᵈᵐᵃ L²(G)).comp ((MulEquiv.inv' G).toMonoidHom : G →* Gᵈᵐᵃ)
/-- The defining operator formula for the `L²` regular representation of a locally compact group. -/
@[simp] theorem l2Regular_apply (g : G) (f : L²(G)) :
    l2Regular G g f =
      Lp.compMeasurePreservingₗ ℂ (fun t : G ↦ g⁻¹ * t)
        (measurePreserving_mul_left (Measure.haar : Measure G) g⁻¹) f :=
  rfl
end L2Regular

end Representation
