variable {W : Type v} [TopologicalSpace W] [AddCommGroup W] [Module ℂ W]
  [IsTopologicalAddGroup W] [ContinuousSMul ℂ W] [T2Space W] [FiniteDimensional ℂ W]

theorem matrixCoefficient_codRestrict_fixedVector_mem_coordinateSubspace
    {ι : Type v} [Fintype ι]
    (σ : Representation ℂ G W) [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (hbasis : basis oneIndex = chosen_irreducible_vector (G := G) σ)
    (D : σ.IntertwiningMap
      ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation)) :
    D (chosen_irreducible_vector (G := G) σ) ∈
      V⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis⟯ oneIndex := by
  let ev :=
    ExplicitDecomposition.intertwiningMapEvaluation
      ((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation) σ basis oneIndex
  have hmem :
      D (chosen_irreducible_vector (G := G) σ) ∈
        V⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis⟯ oneIndex := by
    -- Exercise 2-2.7-2 identifies evaluation at the distinguished basis vector with the first
    -- coordinate subspace.
    simpa [ev, ExplicitDecomposition.intertwiningMapEvaluation, hbasis] using (ev D).2
  exact hmem

/-- Helper for Remark 4-4.3-1: every evaluated matrix-coefficient vector already lies in the
distinguished first-coordinate copy `V_{i,1}`. This records the easy inclusion in the remaining
Proposition 8 range-identification step, so the blocker is only the reverse inclusion. -/
theorem matrixCoefficient_codRestrict_evalRange_le_coordinateSubspace
    {ι : Type v} [Fintype ι]
    (σ : Representation ℂ G W) (hσ : Continuous fun p : G × W ↦ σ p.1 p.2)
    [σ.IsIrreducible]
    (basis : Module.Basis ι ℂ W) (oneIndex : ι)
    (hbasis : basis oneIndex = chosen_irreducible_vector (G := G) σ) :
    LinearMap.range
        (matrixCoefficient_codRestrict_evalAtChosenLinear (G := G) σ hσ) ≤
      V⟮((l2RegularIsotypicSubrepresentation (G := G) σ).toRepresentation),σ,basis⟯ oneIndex := by
  rintro y ⟨ℓ, rfl⟩
  -- Evaluating a coefficient intertwiner at the chosen source vector lands in the first
  -- coordinate subspace by Exercise 2-2.7-2.
  simpa [matrixCoefficient_codRestrict_evalAtChosenLinear] using
    matrixCoefficient_codRestrict_fixedVector_mem_coordinateSubspace
      (G := G) (σ := σ) (basis := basis) (oneIndex := oneIndex) hbasis
      ((matrixCoefficientIntertwining_l2Regular_codRestrictLinear
        (G := G) σ hσ) ℓ)

/-- Helper for Remark 4-4.3-1: the fixed nonzero vector chosen in the irreducible source
representation already generates the whole source as a cyclic subrepresentation. -/
theorem chosen_irreducible_vector_cyclicSubrepresentation_eq_top
    (σ : Representation ℂ G W) [σ.IsIrreducible] :
    V⟮σ⟯ (chosen_irreducible_vector (G := G) σ) = ⊤ := by
  let x₀ : W := chosen_irreducible_vector (G := G) σ
  let U : Subrepresentation σ := V⟮σ⟯ x₀
  have hx₀ : x₀ ∈ U.toSubmodule := by
    -- The chosen irreducible vector belongs to the cyclic subrepresentation it generates.
    simpa [U, x₀] using mem_cyclicSubrepresentation σ x₀
  have hU_ne_bot : U ≠ ⊥ := by
    -- Because the chosen vector is nonzero, its cyclic subrepresentation cannot be trivial.
    intro hU
    exact chosen_irreducible_vector_ne_zero (G := G) σ <| by
      simpa [U, x₀, hU] using hx₀
  exact (IsSimpleOrder.eq_bot_or_eq_top U).resolve_left hU_ne_bot

/-- Helper for Remark 4-4.3-1: every intertwiner from the irreducible source representation lands
in the cyclic subrepresentation generated by the image of the chosen source vector. This packages
the source fact that the chosen irreducible vector already generates the whole domain. -/
theorem intertwiningMap_range_le_cyclicSubrepresentation_of_apply_chosen
    {V' : Type*} [AddCommGroup V'] [Module ℂ V']
    (τ : Representation ℂ G V') (σ : Representation ℂ G W) [σ.IsIrreducible]
    (D : σ.IntertwiningMap τ) :
    D.range.toSubmodule ≤
      (V⟮τ⟯ (D (chosen_irreducible_vector (G := G) σ))).toSubmodule := by
  let x₀ : W := chosen_irreducible_vector (G := G) σ
  let U : Subrepresentation σ :=
    { toSubmodule :=
        ((V⟮τ⟯ (D x₀)).toSubmodule).comap D.toLinearMap
      apply_mem_toSubmodule := by
        intro g w hw
        -- The preimage of the cyclic copy is stable because `D` intertwines the two actions.
        change D (σ g w) ∈ (V⟮τ⟯ (D x₀)).toSubmodule
        have hDw : D (σ g w) = τ g (D w) :=
          Representation.IntertwiningMap.isIntertwining (ρ := σ) (σ := τ) D g w
        rw [hDw]
        exact (V⟮τ⟯ (D x₀)).apply_mem_toSubmodule g (by simpa using hw) }
  have hx₀ : x₀ ∈ U.toSubmodule := by
    -- The chosen source vector maps to the generator of the target cyclic subrepresentation.
    change D x₀ ∈ (V⟮τ⟯ (D x₀)).toSubmodule
    simpa using mem_cyclicSubrepresentation τ (D x₀)
  have htop_le : V⟮σ⟯ x₀ ≤ U := by
    -- Minimality of the cyclic subrepresentation forces every domain vector into this preimage.
    exact cyclicSubrepresentation_le_of_mem σ U hx₀
  have hU_top : U = ⊤ := by
    -- The chosen irreducible vector already generates all of `σ`.
    have htop_le_U : (⊤ : Subrepresentation σ) ≤ U := by
      calc
        (⊤ : Subrepresentation σ) = V⟮σ⟯ x₀ := by
          rw [chosen_irreducible_vector_cyclicSubrepresentation_eq_top (G := G) (σ := σ)]
        _ ≤ U := htop_le
    exact top_le_iff.mp htop_le_U
  intro z hz
  rcases LinearMap.mem_range.mp hz with ⟨w, rfl⟩
  -- Once the preimage subrepresentation is `⊤`, every value `D w` lies in the target cyclic copy.
  have hwU : w ∈ U.toSubmodule := by
    rw [hU_top]
    exact Submodule.mem_top
  simpa [U] using hwU

end PeterWeyl

end Representation
