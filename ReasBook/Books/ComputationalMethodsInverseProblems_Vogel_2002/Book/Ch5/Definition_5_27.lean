module

public import Book.Ch5.Definition_5_27.BCCB

public section

open scoped Matrix

universe u

namespace Matrix

variable {α : Type u}

/- Definition 5.27 is represented by the canonical owner `Matrix.bccb`;
`Matrix.bccb_apply` gives the entrywise formula, `Matrix.bccb_block_apply`
gives the entrywise formula for each block, and the theorem below recovers the
displayed block description with `(j, l)` block
`Matrix.circulant (c.col (j - l))`. -/
#check Matrix.bccb
#check Matrix.bccb_apply
#check Matrix.bccb_block_apply

/-- Definition 5.27: the `(j, l)` block of `Matrix.bccb c` is the circulant
matrix generated by the column `c.col (j - l)`. -/
theorem bccb_block_eq_circulant {n_x n_y : ℕ} (c : Matrix (Fin n_x) (Fin n_y) α)
    (j l : Fin n_y) :
    (Matrix.bccb c).submatrix (fun i ↦ (j, i)) (fun k ↦ (l, k)) =
      Matrix.circulant (c.col (j - l)) := by
  -- Compare the displayed block description entrywise.
  ext i k
  -- Normalize the circulant entry and rewrite the block entry by the canonical BCCB formula.
  rw [Matrix.circulant_apply]
  simpa using Matrix.bccb_block_apply c j l i k

end Matrix
