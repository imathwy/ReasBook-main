import BauschkeLean.Chap29.Example_29_45
import BauschkeLean.Chap30.Theorem_30_8

-- Semantic recall: Chapter 30 already packages Haugazeau's method through the owner
-- `haugazeauIteration`, while Chapter 29 provides the reusable Chebyshev family API
-- `family_isChebyshev_of_iInter_nonempty_closed_convex` for finite families of closed convex
-- sets with nonempty intersection.

open Filter
open scoped Topology

universe u

noncomputable section

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {m : ℕ} (C : Fin m → Set H)
variable (hC_nonempty : (⋂ i, C i).Nonempty)
variable (hC_closed : ∀ i, IsClosed (C i))
variable (hC_convex : ∀ i, Convex ℝ (C i))

local notation "InterC" => (⋂ i, C i)
local notation "hFamily_cheb" =>
  (family_isChebyshev_of_iInter_nonempty_closed_convex C hC_nonempty hC_closed hC_convex)
local notation "hInter_cheb" =>
  (isChebyshev_of_nonempty_isClosed_convex hC_nonempty
    (isClosed_iInter hC_closed) (convex_iInter hC_convex))

/-- Helper for Corollary 30.15: after reindexing the source set `I = {1, ..., m}` by `Fin m`,
the cyclic Haugazeau orbit generated by the metric projectors onto the family `(C i)` satisfies
the recursion `xₙ₊₁ = Q(x₀, xₙ, P_{rem(n,m)} xₙ)`. -/
@[simp] theorem haugazeau_iteration_cyclic_projectors_succ
    (hm : 0 < m) (x0 : H) (n : ℕ) :
    haugazeauIteration
        (fun i ↦ P[C i, hFamily_cheb i])
        (fun k ↦ ⟨k % m, Nat.mod_lt k hm⟩) x0 (n + 1) =
      specialPolyhedronQ x0
        (haugazeauIteration
          (fun i ↦ P[C i, hFamily_cheb i])
          (fun k ↦ ⟨k % m, Nat.mod_lt k hm⟩) x0 n)
        (P[C ⟨n % m, Nat.mod_lt n hm⟩, hFamily_cheb ⟨n % m, Nat.mod_lt n hm⟩]
          (haugazeauIteration
            (fun i ↦ P[C i, hFamily_cheb i])
            (fun k ↦ ⟨k % m, Nat.mod_lt k hm⟩) x0 n)) := sorry

/-- Corollary 30.15: Haugazeau's algorithm. Let `m` be a strictly positive integer, let
`(C_i)_{i ∈ I}` be a finite family of closed convex subsets of `H` with nonempty intersection, and
let `x₀ ∈ H`. Writing the source index set `I = {1, ..., m}` as `Fin m`, if `P_i` denotes the
metric projector onto `C_i` and `(xₙ)` is generated by the cyclic Haugazeau recursion
`xₙ₊₁ = Q(x₀, xₙ, P_{1 + rem(n,m)} xₙ)`, then `xₙ` converges strongly to the metric projection of
`x₀` onto `⋂ i, C i`. -/
theorem haugazeau_iteration_cyclic_projectors_tendsto_projection_iInter
    (hm : 0 < m) (x0 : H) :
    Tendsto
      (haugazeauIteration
        (fun i ↦ P[C i, hFamily_cheb i])
        (fun n ↦ ⟨n % m, Nat.mod_lt n hm⟩) x0)
      atTop
      (𝓝 (P[InterC, hInter_cheb] x0)) := sorry

end
