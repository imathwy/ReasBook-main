open scoped InnerProductSpace SetValuedOperator
open ERealFunction

universe u v

namespace SetValuedOperator

/- Source/core/bridge triage:
- `source-facing`: Proposition 20.57 is the textbook product formula for the Fitzpatrick function
  and the induced first-coordinate domain projection identity.
- `core/canonical`: the owner abstractions are the chapter's `SetValuedOperator.prod` and the
  Fitzpatrick owner `F[_]` from Definition 20.51.
- `bridge/view`: this file only records how those two owners interact on the Chapter 9 raw-product
  `ℓ²` Hilbert structure and on `dom`; it does not introduce any new product wrapper. -/

attribute [-instance] Prod.toNorm Prod.seminormedAddCommGroup Prod.normedAddCommGroup
attribute [-instance] Prod.normedSpace Prod.pseudoMetricSpaceMax

variable {H : Type u} {K : Type v}
variable [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable [NormedAddCommGroup K] [InnerProductSpace ℝ K]

attribute [local instance] prod_pseudoMetricSpace_l2 prod_normedAddCommGroup_l2 prod_normedSpace_l2
  prod_innerProductSpace_l2

/-- Helper for Proposition 20.57: a nonempty graph gives a finite graph supremand, so the
Fitzpatrick function never attains `⊥`. -/
private theorem fitzpatrickFunction_ne_bot_of_graph_nonempty_local
    (A : SetValuedOperator H H) (hA_graph : A.graph.Nonempty) (p : H × H) :
    ⊥ < F[A] p := by
  rcases hA_graph with ⟨y, hy⟩
  let q : gra A := ⟨y, hy⟩
  have hq_le :
      ((⟪q.1.1, p.2⟫_ℝ + ⟪p.1, q.1.2⟫_ℝ - ⟪q.1.1, q.1.2⟫_ℝ : ℝ) : EReal) ≤ F[A] p :=
    by
      rw [fitzpatrickFunction]
      exact le_iSup (f := fun r : gra A ↦
        ((⟪r.1.1, p.2⟫_ℝ + ⟪p.1, r.1.2⟫_ℝ - ⟪r.1.1, r.1.2⟫_ℝ : ℝ) : EReal)) q
  have hq_bot :
      ⊥ <
        ((⟪q.1.1, p.2⟫_ℝ + ⟪p.1, q.1.2⟫_ℝ - ⟪q.1.1, q.1.2⟫_ℝ : ℝ) : EReal) :=
    EReal.bot_lt_coe _
  exact lt_of_lt_of_le hq_bot hq_le

/-- Helper for Proposition 20.57: a graph point of the product operator yields a graph point of
`A` by keeping the `H`-coordinates. -/
private theorem graph_prod_fst_mem
    (A : SetValuedOperator H H) (B : SetValuedOperator K K)
    (p : gra (A × B)) :
    p.1.2.1 ∈ A p.1.1.1 := by
  -- Split product-graph membership into its `A`- and `B`-components.
  exact (SetValuedOperator.mem_prod_iff A B p.1.1 p.1.2).1 p.2 |>.1

/-- Helper for Proposition 20.57: a graph point of the product operator yields a graph point of
`B` by keeping the `K`-coordinates. -/
private theorem graph_prod_snd_mem
    (A : SetValuedOperator H H) (B : SetValuedOperator K K)
    (p : gra (A × B)) :
    p.1.2.2 ∈ B p.1.1.2 := by
  -- Split product-graph membership into its `A`- and `B`-components.
  exact (SetValuedOperator.mem_prod_iff A B p.1.1 p.1.2).1 p.2 |>.2

/-- Helper for Proposition 20.57: graph points of `A` and `B` assemble into a graph point of the
product operator. -/
private theorem graph_prod_mem_of_pair
    (A : SetValuedOperator H H) (B : SetValuedOperator K K)
    (pq : gra A × gra B) :
    (pq.1.1.2, pq.2.1.2) ∈ (A × B) (pq.1.1.1, pq.2.1.1) := by
  -- Repackage the two coordinate graph memberships as product-graph membership.
  exact
    (SetValuedOperator.mem_prod_iff A B (pq.1.1.1, pq.2.1.1) (pq.1.1.2, pq.2.1.2)).2
      ⟨pq.1.2, pq.2.2⟩

/-- Helper for Proposition 20.57: the product graph is generated by pairing graph points of `A`
and `B`. -/
private def graph_prod_from_pair
    (A : SetValuedOperator H H) (B : SetValuedOperator K K) :
    gra A × gra B → gra (A × B) :=
  fun pq ↦
    ⟨((pq.1.1.1, pq.2.1.1), (pq.1.1.2, pq.2.1.2)), graph_prod_mem_of_pair A B pq⟩

/-- Helper for Proposition 20.57: every product-graph point comes from a pair of coordinate graph
points. -/
private theorem graph_prod_from_pair_surjective
    (A : SetValuedOperator H H) (B : SetValuedOperator K K) :
    Function.Surjective (graph_prod_from_pair A B) := by
  intro p
  -- Extract the two coordinate graph points from `p` and rebuild `p` from them.
  refine ⟨⟨⟨(p.1.1.1, p.1.2.1), graph_prod_fst_mem A B p⟩,
      ⟨(p.1.1.2, p.1.2.2), graph_prod_snd_mem A B p⟩⟩, ?_⟩
  cases p
  rfl

/-- Helper for Proposition 20.57: the Fitzpatrick supremand of the product operator is the sum of
the two coordinate Fitzpatrick supremands. -/
private theorem fitzpatrick_prod_supremand_split
    (x u : H) (y v : K) (p : gra A) (q : gra B) :
    ((⟪(p.1.1, q.1.1), (u, v)⟫_ℝ + ⟪(x, y), (p.1.2, q.1.2)⟫_ℝ -
        ⟪(p.1.1, q.1.1), (p.1.2, q.1.2)⟫_ℝ : ℝ) : EReal) =
      ((⟪p.1.1, u⟫_ℝ + ⟪x, p.1.2⟫_ℝ - ⟪p.1.1, p.1.2⟫_ℝ : ℝ) : EReal) +
        ((⟪q.1.1, v⟫_ℝ + ⟪y, q.1.2⟫_ℝ - ⟪q.1.1, q.1.2⟫_ℝ : ℝ) : EReal) := by
  -- Expand the product `ℓ²` inner products coordinatewise and normalize the resulting real sum.
  apply congrArg (fun t : ℝ => (t : EReal))
  change
    (⟪p.1.1, u⟫_ℝ + ⟪q.1.1, v⟫_ℝ) + (⟪x, p.1.2⟫_ℝ + ⟪y, q.1.2⟫_ℝ) -
        (⟪p.1.1, p.1.2⟫_ℝ + ⟪q.1.1, q.1.2⟫_ℝ) =
      (⟪p.1.1, u⟫_ℝ + ⟪x, p.1.2⟫_ℝ - ⟪p.1.1, p.1.2⟫_ℝ) +
        (⟪q.1.1, v⟫_ℝ + ⟪y, q.1.2⟫_ℝ - ⟪q.1.1, q.1.2⟫_ℝ)
  ring_nf

-- Proof sketch: expand the Fitzpatrick supremum of `A × B` over graph points, rewrite graph
-- membership componentwise through `mem_prod_iff`, and split the inner product on
-- `H × K` equipped with the Chapter 9 `ℓ²` product structure into the sum of its `H`- and
-- `K`-components. The supremum over the product graph then separates into the sum of the two
-- Fitzpatrick suprema.
/-- Proposition 20.57 (1): the Fitzpatrick function of the componentwise product operator
`(x, y) ↦ A x × B y` is the sum of the Fitzpatrick functions of `A` and `B` on the Chapter 9
raw-pair `ℓ²` Hilbert product `H × K`. -/
theorem fitzpatrickFunction_prod_apply
    (A : SetValuedOperator H H) (B : SetValuedOperator K K)
    (x u : H) (y v : K) :
    F[(A × B)] ((x, y), (u, v)) = F[A] (x, u) + F[B] (y, v) := by
  -- Reindex the product Fitzpatrick supremum by pairs of graph points from `A` and `B`.
  rw [fitzpatrickFunction]
  calc
    (⨆ p : gra (A × B),
      ((⟪p.1.1, (u, v)⟫_ℝ + ⟪(x, y), p.1.2⟫_ℝ - ⟪p.1.1, p.1.2⟫_ℝ : ℝ) : EReal)) =
        ⨆ pq : gra A × gra B,
          ((⟪(graph_prod_from_pair A B pq).1.1, (u, v)⟫_ℝ +
              ⟪(x, y), (graph_prod_from_pair A B pq).1.2⟫_ℝ -
              ⟪(graph_prod_from_pair A B pq).1.1, (graph_prod_from_pair A B pq).1.2⟫_ℝ :
                ℝ) : EReal) := by
            simpa using
              (Function.Surjective.iSup_comp (f := graph_prod_from_pair A B)
                (graph_prod_from_pair_surjective A B)
                (g := fun p : gra (A × B) ↦
                  ((⟪p.1.1, (u, v)⟫_ℝ + ⟪(x, y), p.1.2⟫_ℝ - ⟪p.1.1, p.1.2⟫_ℝ :
                    ℝ) : EReal))).symm
    _ = ⨆ p : gra A, ⨆ q : gra B,
          ((⟪(graph_prod_from_pair A B (p, q)).1.1, (u, v)⟫_ℝ +
              ⟪(x, y), (graph_prod_from_pair A B (p, q)).1.2⟫_ℝ -
              ⟪(graph_prod_from_pair A B (p, q)).1.1,
                (graph_prod_from_pair A B (p, q)).1.2⟫_ℝ : ℝ) : EReal) := by
          simpa using
            (iSup_prod
              (f := fun pq : gra A × gra B ↦
                ((⟪(graph_prod_from_pair A B pq).1.1, (u, v)⟫_ℝ +
                    ⟪(x, y), (graph_prod_from_pair A B pq).1.2⟫_ℝ -
                    ⟪(graph_prod_from_pair A B pq).1.1,
                      (graph_prod_from_pair A B pq).1.2⟫_ℝ : ℝ) : EReal)))
    _ = ⨆ p : gra A, ⨆ q : gra B,
          (((⟪p.1.1, u⟫_ℝ + ⟪x, p.1.2⟫_ℝ - ⟪p.1.1, p.1.2⟫_ℝ : ℝ) : EReal) +
            ((⟪q.1.1, v⟫_ℝ + ⟪y, q.1.2⟫_ℝ - ⟪q.1.1, q.1.2⟫_ℝ : ℝ) : EReal)) := by
          -- The product-space supremand splits into the sum of the two coordinate supremands.
          refine iSup_congr fun p ↦ ?_
          refine iSup_congr fun q ↦ ?_
          simpa [graph_prod_from_pair] using fitzpatrick_prod_supremand_split (x := x) (u := u)
            (y := y) (v := v) p q
    _ =
        (⨆ p : gra A,
          ((⟪p.1.1, u⟫_ℝ + ⟪x, p.1.2⟫_ℝ - ⟪p.1.1, p.1.2⟫_ℝ : ℝ) : EReal)) +
        (⨆ q : gra B,
          ((⟪q.1.1, v⟫_ℝ + ⟪y, q.1.2⟫_ℝ - ⟪q.1.1, q.1.2⟫_ℝ : ℝ) : EReal)) := by
            exact ERealFunction.iSup_iSup_add_eq_add_iSup _ _
    _ = F[A] (x, u) + F[B] (y, v) := by
          rw [fitzpatrickFunction, fitzpatrickFunction]

/-- Helper for Proposition 20.57: first-coordinate domain witnesses for `F[A × B]` are exactly
pairs of first-coordinate domain witnesses for `F[A]` and `F[B]`. -/
private theorem mem_fst_image_dom_fitzpatrickFunction_prod_iff
    (A : SetValuedOperator H H) (B : SetValuedOperator K K)
    (hA_graph : A.graph.Nonempty) (hB_graph : B.graph.Nonempty)
    (x₀ : H) (y₀ : K) :
    (x₀, y₀) ∈ Prod.fst '' ERealFunction.dom (F[(A × B)]) ↔
      x₀ ∈ Prod.fst '' ERealFunction.dom (F[A]) ∧
        y₀ ∈ Prod.fst '' ERealFunction.dom (F[B]) := by
  constructor
  · intro hxy
    rcases hxy with ⟨p, hdom, hp⟩
    rcases p with ⟨xy, uv⟩
    rcases xy with ⟨x, y⟩
    rcases uv with ⟨u, v⟩
    injection hp with hx hy
    subst x
    subst y
    -- Rewrite the product Fitzpatrick value as a sum and split finiteness above `⊤`.
    have hA_bot : F[A] (x₀, u) ≠ ⊥ := by
      exact ne_of_gt (fitzpatrickFunction_ne_bot_of_graph_nonempty_local A hA_graph (x₀, u))
    have hB_bot : F[B] (y₀, v) ≠ ⊥ := by
      exact ne_of_gt (fitzpatrickFunction_ne_bot_of_graph_nonempty_local B hB_graph (y₀, v))
    have hprod_top : F[(A × B)] ((x₀, y₀), (u, v)) ≠ ⊤ :=
      (ERealFunction.mem_dom_iff_ne_top _ _).1 hdom
    have hsplit :
        F[A] (x₀, u) ≠ ⊤ ∧ F[B] (y₀, v) ≠ ⊤ := by
      refine (EReal.add_ne_top_iff_ne_top₂ hA_bot hB_bot).1 ?_
      simpa [fitzpatrickFunction_prod_apply] using hprod_top
    constructor
    · exact ⟨(x₀, u), (ERealFunction.mem_dom_iff_ne_top _ _).2 hsplit.1, rfl⟩
    · exact ⟨(y₀, v), (ERealFunction.mem_dom_iff_ne_top _ _).2 hsplit.2, rfl⟩
  · intro hxy
    rcases hxy with ⟨hx, hy⟩
    rcases hx with ⟨pA, hAu, hpA⟩
    rcases hy with ⟨pB, hBv, hpB⟩
    rcases pA with ⟨x, u⟩
    rcases pB with ⟨y, v⟩
    have hx0 : x = x₀ := by
      simpa using hpA
    have hy0 : y = y₀ := by
      simpa using hpB
    subst x
    subst y
    -- Combine the two coordinate domain witnesses into a domain witness for the product formula.
    have hA_bot : F[A] (x₀, u) ≠ ⊥ := by
      exact ne_of_gt (fitzpatrickFunction_ne_bot_of_graph_nonempty_local A hA_graph (x₀, u))
    have hB_bot : F[B] (y₀, v) ≠ ⊥ := by
      exact ne_of_gt (fitzpatrickFunction_ne_bot_of_graph_nonempty_local B hB_graph (y₀, v))
    have hA_top : F[A] (x₀, u) ≠ ⊤ := (ERealFunction.mem_dom_iff_ne_top _ _).1 hAu
    have hB_top : F[B] (y₀, v) ≠ ⊤ := (ERealFunction.mem_dom_iff_ne_top _ _).1 hBv
    have hsum_top :
        F[A] (x₀, u) + F[B] (y₀, v) ≠ ⊤ :=
      (EReal.add_ne_top_iff_ne_top₂ hA_bot hB_bot).2 ⟨hA_top, hB_top⟩
    refine ⟨((x₀, y₀), (u, v)), ?_, rfl⟩
    -- The product sum formula transports the coordinate finiteness back to `F[A × B]`.
    refine (ERealFunction.mem_dom_iff_ne_top _ _).2 ?_
    simpa [fitzpatrickFunction_prod_apply] using hsum_top

-- Proof sketch: use the product formula from part (1). When `gra A` and `gra B` are nonempty,
-- the Fitzpatrick functions of `A`, `B`, and the componentwise product operator never take the
-- value `⊥`, so membership in `ERealFunction.dom` is controlled exactly by finiteness above. Then
-- the sum formula shows that a product point lies in the first-coordinate projection of
-- `dom F_{A×B}` exactly when its two components lie in the corresponding first-coordinate
-- projections for `F_A` and `F_B`.
/-- Proposition 20.57 (2): if `gra A` and `gra B` are nonempty, then the first-coordinate
projection of `dom F_{A × B}` is the product of the first-coordinate projections of `dom F_A`
and `dom F_B`. -/
theorem fst_image_dom_fitzpatrickFunction_prod
    (A : SetValuedOperator H H) (B : SetValuedOperator K K)
    (hA_graph : A.graph.Nonempty) (hB_graph : B.graph.Nonempty) :
    Prod.fst '' ERealFunction.dom (F[(A × B)]) =
      (Prod.fst '' ERealFunction.dom (F[A])) ×ˢ
        (Prod.fst '' ERealFunction.dom (F[B])) :=
  by
    ext z
    rcases z with ⟨x, y⟩
    -- Reduce the set equality to the witness-level iff for coordinate domain projections.
    constructor
    · intro hz
      simpa using
        (mem_fst_image_dom_fitzpatrickFunction_prod_iff A B hA_graph hB_graph x y).1 hz
    · intro hz
      exact
        (mem_fst_image_dom_fitzpatrickFunction_prod_iff A B hA_graph hB_graph x y).2
          (by simpa using hz)

end SetValuedOperator
