import BauschkeLean.Chap12.ScaledProximityOperator
import BauschkeLean.Chap16.Proposition_16_44
import BauschkeLean.Chap22.Example_22_5
import BauschkeLean.Chap26.Remark_26_23
import BauschkeLean.Chap26.Theorem_26_14

open Filter
open SetValuedOperator
open scoped InnerProductSpace Pointwise SetValuedOperator Topology

universe u

namespace ERealFunction

noncomputable section

/- Source/core/bridge triage:
- `source-facing`: Proposition 26.25 is the proximal forward-backward recursion `(26.85)` and its
  convergence consequences for `variationalInequalityProblem f B.toSetValuedOperator`.
- `core/canonical`: the Chapter 26 forward-backward owner surface is
  `forwardBackwardIteration`, together with the convergence theorems of `Theorem_26_14`.
- `bridge/view`: `Remark_26_23` identifies the source solution set with
  `primal_inclusion_solution_set (∂ f) B.toSetValuedOperator`, and the recursion below is a thin
  specialization of the canonical forward-backward orbit for `A = ∂ f`. -/

-- Semantic recall: `lean_leansearch` only surfaced generic convex-analysis material for this
-- item, so the source-facing API here is built from the verified local Chapter 26 owners
-- `variationalInequalityProblem`, `forwardBackwardRelaxationBound`, and
-- `forwardBackwardIteration`, together with the Chapter 12 scaled proximal notation
-- `Prox[γ, f, hf]`.

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {f : H → Set.Ioi (⊥ : EReal)} (hf : f ∈ Γ₀(H))
variable (B : H → H) (gamma : PosReal) (lam : ℕ → ℝ) (x0 : H)

local notation "VI" => variationalInequalityProblem f B.toSetValuedOperator
local notation "hSub" => subdifferential_isMaximallyMonotone_of_mem_gammaZero hf

/-- The proximal forward-backward orbit generated by the source recursion `(26.85)`. -/
noncomputable def proximalForwardBackwardIteration
    {f : H → Set.Ioi (⊥ : EReal)} (hf : f ∈ Γ₀(H)) (B : H → H)
    (gamma : PosReal) (lam : ℕ → ℝ) (x0 : H) : ℕ → H
  | 0 => x0
  | n + 1 =>
      let xn := proximalForwardBackwardIteration hf B gamma lam x0 n
      xn + lam n • (Prox[gamma, f, hf] (xn - (gamma : ℝ) • B xn) - xn)

/-- The auxiliary forward step `y_n = x_n - γ B x_n` attached to the proximal forward-backward
orbit. -/
noncomputable def proximalForwardBackwardAuxiliarySequence : ℕ → H :=
  fun n ↦
    proximalForwardBackwardIteration hf B gamma lam x0 n -
      (gamma : ℝ) • B (proximalForwardBackwardIteration hf B gamma lam x0 n)

/-- The auxiliary forward step is given by `y_n = x_n - γ B x_n`. -/
@[simp] theorem proximalForwardBackwardAuxiliarySequence_eq (n : ℕ) :
    proximalForwardBackwardAuxiliarySequence hf B gamma lam x0 n =
      proximalForwardBackwardIteration hf B gamma lam x0 n -
        (gamma : ℝ) • B (proximalForwardBackwardIteration hf B gamma lam x0 n) := rfl

/-- The forward-backward resolvent `J_{γ ∂ f}` is exactly the source-facing scaled proximal map
`Prox[γ, f, hf]`. -/
@[simp] theorem resolventMap_subdifferential_eq_scaledProximityOperator :
    SetValuedOperator.resolventMap (∂ f) hSub gamma = Prox[gamma, f, hf] := by
  -- Compare the two owners on the singleton-valued resolvent surface.
  have hrealizer :
      (SetValuedOperator.resolventMap (∂ f) hSub gamma).toSetValuedOperator =
        (Prox[gamma, f, hf]).toSetValuedOperator := by
    calc
      (SetValuedOperator.resolventMap (∂ f) hSub gamma).toSetValuedOperator =
          J[((gamma : ℝ) • (∂ f : SetValuedOperator H H))] := by
            simpa using
              SetValuedOperator.resolventMap_toSetValuedOperator_eq (∂ f) hSub gamma
      _ = (Prox[gamma, f, hf]).toSetValuedOperator := by
            rw [← subdifferential_posReal_smul_eq_smul f gamma, resolvent_def]
            simpa [scaledProximityOperator] using
              (singleton_proximityOperator_eq_inverse_add_subdifferential
                (smul_mem_gammaZero f hf gamma)).symm
  ext x
  -- Evaluating the set-valued equality at `x` reduces to equality of singleton carriers.
  have hx := congrArg (fun T : SetValuedOperator H H ↦ T x) hrealizer
  simpa [Function.toSetValuedOperator_apply, Set.singleton_eq_singleton_iff] using hx

/-- The source proximal forward-backward recursion is the Chapter 26 forward-backward orbit for
`A = ∂ f`. -/
theorem proximalForwardBackwardIteration_eq_forwardBackwardIteration :
    proximalForwardBackwardIteration hf B gamma lam x0 =
      forwardBackwardIteration (∂ f) hSub B gamma lam x0 := by
  funext n
  induction n with
  | zero =>
      -- Both recursions start from the prescribed initial point `x0`.
      simp [proximalForwardBackwardIteration, forwardBackwardIteration]
  | succ n ih =>
      have ih' :
          proximalForwardBackwardIteration hf B gamma lam x0 n =
            relaxedOperatorIteration
              (fun _ ↦ SetValuedOperator.forwardBackwardSplittingOperator (∂ f) hSub B gamma)
              lam x0 n := by
        simpa [forwardBackwardIteration] using ih
      -- Unfold one step of each recursion and rewrite the resolvent owner to the proximal map.
      rw [proximalForwardBackwardIteration, forwardBackwardIteration, relaxedOperatorIteration_succ]
      simp only [SetValuedOperator.forwardBackwardSplittingOperator_apply]
      rw [resolventMap_subdifferential_eq_scaledProximityOperator (hf := hf)]
      rw [ih']

omit [CompleteSpace H] in
/-- Helper for Proposition 26.25: the source uniform-convexity branch upgrades to local uniform
monotonicity of `∂ f`. -/
private theorem subdifferential_uniformMonotoneOnEveryBoundedSubset_or
    (hconv : ConvexOn f (effectiveDomain f))
    (hUniform :
      (∀ S : Set H,
        S.Nonempty → Bornology.IsBounded S → S ⊆ (∂ f).dom →
          ∃ φ : NNReal → EReal, UniformlyConvexOn f S φ) ∨
        ∀ S : Set H,
          S.Nonempty → Bornology.IsBounded S →
            B.toSetValuedOperator.IsUniformlyMonotoneOn S) :
    (∀ S : Set H,
      S.Nonempty → Bornology.IsBounded S → S ⊆ (∂ f).dom →
        (∂ f).IsUniformlyMonotoneOn S) ∨
      ∀ S : Set H,
        S.Nonempty → Bornology.IsBounded S →
          B.toSetValuedOperator.IsUniformlyMonotoneOn S := by
  rcases hUniform with hUniform | hUniform
  · left
    intro S hS hS_bounded hS_sub
    -- Example 22.5 converts the localized uniform-convexity modulus into monotonicity of `∂ f`.
    obtain ⟨φ, hφ⟩ := hUniform S hS hS_bounded hS_sub
    exact
      subdifferential_isUniformlyMonotoneOn_of_convexOn_of_uniformlyConvexOn
        f hconv hS_sub hφ
  · right
    -- The `B`-branch already has the exact owner-facing shape required by Theorem 26.14.
    exact hUniform

/-- Proposition 26.25 (1): let `f ∈ Γ₀(H)`, let `β ∈ ℝ_{++}`, let `B : H → H` be
`β`-cocoercive, let `γ ∈ ]0, 2β[`, and let `(λ_n)` lie in
`[0, 2 - γ / (2β)]` with `∑ λ_n (2 - γ / (2β) - λ_n) = +∞`. If the variational inequality
`variationalInequalityProblem f B.toSetValuedOperator` is nonempty, then the proximal
forward-backward orbit converges weakly to one of its solutions. -/
theorem proximalForwardBackward_tendsto_weakly_to_variationalInequalitySolution
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (hdiv :
      Tendsto
        (fun N ↦
          Finset.sum (Finset.range N)
            (fun n ↦ lam n * (forwardBackwardRelaxationBound beta gamma - lam n)))
        atTop atTop)
    (hsol : Set.Nonempty VI) (x0 : H) :
    ∃ p ∈ VI,
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (proximalForwardBackwardIteration hf B gamma lam x0 n))
        atTop (𝓝 (toWeakSpace ℝ H p)) := by
  have hVI : VI = primal_inclusion_solution_set (∂ f) B.toSetValuedOperator :=
    variationalInequalityProblem_eq_primal_inclusion_solution_set B.toSetValuedOperator
  have hzero : Set.Nonempty (primal_inclusion_solution_set (∂ f) B.toSetValuedOperator) := by
    rwa [hVI] at hsol
  -- Specialize Theorem 26.14 to `A = ∂ f` and translate both the orbit and the solution set.
  simpa [hVI, proximalForwardBackwardIteration_eq_forwardBackwardIteration (hf := hf)
    (B := B) (gamma := gamma) (lam := lam) (x0 := x0)] using
    (SetValuedOperator.forwardBackwardAlgorithm_tendsto_weakly_to_zeroSet
      (∂ f) hSub B beta gamma hB hgamma lam hlam hdiv hzero x0)

/-- Proposition 26.25 (2): under the assumptions of Proposition 26.25 (1), if `x` solves the
variational inequality `variationalInequalityProblem f B.toSetValuedOperator`, then
`(B x_n)` converges strongly to `B x`. -/
theorem proximalForwardBackward_B_tendsto_of_mem_variationalInequalityProblem
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (hdiv :
      Tendsto
        (fun N ↦
          Finset.sum (Finset.range N)
            (fun n ↦ lam n * (forwardBackwardRelaxationBound beta gamma - lam n)))
        atTop atTop)
    (x0 : H) {x : H} (hx : x ∈ VI) :
    Tendsto (fun n ↦ B (proximalForwardBackwardIteration hf B gamma lam x0 n))
      atTop (𝓝 (B x)) := by
  have hVI : VI = primal_inclusion_solution_set (∂ f) B.toSetValuedOperator :=
    variationalInequalityProblem_eq_primal_inclusion_solution_set B.toSetValuedOperator
  have hx' : x ∈ primal_inclusion_solution_set (∂ f) B.toSetValuedOperator := by
    simpa [hVI] using hx
  -- Reuse clause (ii) of Theorem 26.14 after normalizing the recursion.
  simpa [proximalForwardBackwardIteration_eq_forwardBackwardIteration (hf := hf)
    (B := B) (gamma := gamma) (lam := lam) (x0 := x0)] using
    (SetValuedOperator.forwardBackwardAlgorithm_B_tendsto_to_unique_dual_solution
      (∂ f) hSub B beta gamma hB hgamma lam hlam hdiv x0 hx').1

/-- Proposition 26.25 (3): under the assumptions of Proposition 26.25 (1), suppose that either
`f` is uniformly convex on every nonempty bounded subset of `(∂ f).dom` or `B` is uniformly
monotone on every nonempty bounded subset of `H`. Then the proximal forward-backward orbit
converges strongly to the unique solution of
`variationalInequalityProblem f B.toSetValuedOperator`. -/
theorem
    proximalForwardBackward_tendsto_to_unique_variationalInequalitySolution_of_uniformHypothesis
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (hdiv :
      Tendsto
        (fun N ↦
          Finset.sum (Finset.range N)
            (fun n ↦ lam n * (forwardBackwardRelaxationBound beta gamma - lam n)))
        atTop atTop)
    (hsol : Set.Nonempty VI)
    (hUniform :
      (∀ S : Set H,
        S.Nonempty → Bornology.IsBounded S → S ⊆ (∂ f).dom →
          ∃ φ : NNReal → EReal, UniformlyConvexOn f S φ) ∨
        ∀ S : Set H,
          S.Nonempty → Bornology.IsBounded S →
            B.toSetValuedOperator.IsUniformlyMonotoneOn S)
    (x0 : H) :
    ∃ p ∈ VI,
      Tendsto (proximalForwardBackwardIteration hf B gamma lam x0) atTop (𝓝 p) ∧
        VI = ({p} : Set H) := by
  have hVI : VI = primal_inclusion_solution_set (∂ f) B.toSetValuedOperator :=
    variationalInequalityProblem_eq_primal_inclusion_solution_set B.toSetValuedOperator
  have hzero : Set.Nonempty (primal_inclusion_solution_set (∂ f) B.toSetValuedOperator) := by
    rwa [hVI] at hsol
  have hUniform' :
      (∀ S : Set H,
        S.Nonempty → Bornology.IsBounded S → S ⊆ (∂ f).dom →
          (∂ f).IsUniformlyMonotoneOn S) ∨
        ∀ S : Set H,
          S.Nonempty → Bornology.IsBounded S →
            B.toSetValuedOperator.IsUniformlyMonotoneOn S :=
    subdifferential_uniformMonotoneOnEveryBoundedSubset_or
      (f := f) (B := B) (mem_gammaZero_iff.mp hf).2 hUniform
  have hstrong :=
    forwardBackwardAlgorithm_tendsto_to_unique_zero_of_uniformlyMonotoneOnEveryBoundedSubset
      (∂ f) hSub B beta gamma hB hgamma lam hlam hdiv hzero hUniform' x0
  -- Specialize the unique-convergence clause and translate the source-facing wrappers back.
  simpa [hVI, proximalForwardBackwardIteration_eq_forwardBackwardIteration (hf := hf)
    (B := B) (gamma := gamma) (lam := lam) (x0 := x0)] using hstrong

end

end ERealFunction
