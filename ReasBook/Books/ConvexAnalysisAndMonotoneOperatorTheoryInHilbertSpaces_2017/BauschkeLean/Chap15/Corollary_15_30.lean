-- Declarations for this item will be appended below by the statement pipeline.

universe u v

open Set
open scoped InnerProductSpace Pointwise

namespace ERealFunction

/- 
Source/core/bridge triage:
-- `source-facing`: this item is the raw bilinear minimax value equality on the original sets.
- `core/canonical`: `IsSaddlePointOn` for the payoff `(x, v) ↦ ⟪L x, v⟫` on `C × D`.
- `bridge/view`: the chapter-owner reformulation through `σ[D] (L x)` and
  `innerInfimumOn C (L.adjoint v)`, obtained from the image rewrites in Example 15.29.
- Mathlib recall: `isSaddlePointOn_value` is the canonical bridge from a saddle point to the
  corresponding minimax equality.
-/

section FenchelRockafellarDuality

variable {E : Type u} {F : Type v}
variable [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
variable [NormedAddCommGroup F] [InnerProductSpace ℝ F] [CompleteSpace F]

variable {C : Set E} {D : Set F}

variable (L : E →L[ℝ] F)

-- Semantic recall (verified against mathlib search): `isMinOn_iff` and `isMaxOn_iff` are the
-- current owners for attained constrained extrema, while `isSaddlePointOn_value` is the
-- canonical bridge from a saddle point to the corresponding minimax value equality.

omit [CompleteSpace F] in
/-- Helper for Corollary 15.30: the origin belongs to the strong relative interior of the whole
space. -/
private theorem zero_mem_sri_univ :
    (0 : F) ∈ sri (Set.univ : Set F) := by
  -- Reduce the strong-relative-interior claim to the cone/closed-span identity for `univ`.
  refine
    (zero_mem_strongRelativeInterior_iff_cone_eq_closure_span_of_nonempty_convex
      (E := F) Set.univ_nonempty convex_univ).2 ?_
  calc
    cone (Set.univ : Set F) = Set.univ := by
      ext x
      constructor
      · intro _hx
        simp
      · intro _hx
        -- Every point already lies in the conic hull generated by `univ`.
        simpa [Set.cone_def] using
          (ConvexCone.subset_hull
            (R := ℝ) (s := (Set.univ : Set F)) (by simp : x ∈ (Set.univ : Set F)))
    _ = ((Submodule.span ℝ (Set.univ : Set F)).topologicalClosure : Set F) := by
      simp

omit [CompleteSpace E] [CompleteSpace F] in
/-- Helper for Corollary 15.30: boundedness of `D` forces the Example 15.29 regularity condition
`0 ∈ sri (bar D - L '' C)`. -/
private theorem zero_mem_sri_barrier_sub_image_of_bounded
    (hC_nonempty : C.Nonempty) (hD_bounded : Bornology.IsBounded D) :
    (0 : F) ∈ sri (bar D - L '' C) := by
  have hLC_nonempty : (L '' C).Nonempty := Set.Nonempty.image L hC_nonempty
  -- Rewrite the barrier cone to `univ`, then use that subtracting a nonempty set from `univ`
  -- leaves `univ`.
  rw [Set.barrierCone_eq_univ_of_bounded hD_bounded,
    ERealFunction.InfimalConvolutionRegularity.univ_sub_eq_univ_of_nonempty hLC_nonempty]
  exact zero_mem_sri_univ (F := F)

omit [CompleteSpace E] [CompleteSpace F] in
/-- Helper for Corollary 15.30: the support-function slice `σ[D] (L y)` is the raw supremum of
`w ↦ ⟪L y, w⟫` over `D`. -/
private theorem supportFunction_apply_eq_innerSlice (y : E) :
    σ[D] (L y) = sSup ((fun w : F ↦ (⟪L y, w⟫_ℝ : EReal)) '' D) := by
  rw [supportFunction_eq_sSup_image]
  congr 1
  ext t
  constructor
  · rintro ⟨w, hw, rfl⟩
    refine ⟨w, hw, ?_⟩
    exact congrArg (fun r : ℝ ↦ (r : EReal)) (real_inner_comm w (L y))
  · rintro ⟨w, hw, rfl⟩
    refine ⟨w, hw, ?_⟩
    exact congrArg (fun r : ℝ ↦ (r : EReal)) (real_inner_comm (L y) w)

omit [CompleteSpace E] [CompleteSpace F] in
/-- Helper for Corollary 15.30: the support-function objective `x ↦ σ[D] (L x)` belongs to
`Γ₀(E)` once `D` is nonempty. -/
private theorem supportFunctionComp_mem_gammaZero_of_nonempty
    (hD_nonempty : D.Nonempty) :
    properIoi (σ[D]) (isProper_supportFunction_of_nonempty D hD_nonempty) ∘ L ∈ Γ₀(E) := by
  have hsupport :
      properIoi (σ[D]) (isProper_supportFunction_of_nonempty D hD_nonempty) ∈ Γ₀(F) :=
    example_11_2_2_supportFunction_mem_gammaZero D hD_nonempty
  -- The origin lies in the range of `L` and in the effective domain of the packaged support
  -- function, so the precomposition theorem applies.
  refine comp_continuousLinearMap_mem_gammaZero_of_range_inter_effectiveDomain_nonempty
    _ hsupport L ?_
  refine ⟨0, ?_⟩
  constructor
  · exact ⟨0, by simp⟩
  · rw [mem_effectiveDomain_iff]
    simp [supportFunction_zero_eq_zero_of_nonempty, hD_nonempty]

omit [CompleteSpace F] in
/-- Helper for Corollary 15.30: Proposition 11.15 yields a minimizer of the primal support slice
on `C`. -/
private theorem exists_isMinOn_supportSlice
    (hC_nonempty : C.Nonempty) (hC_bounded : Bornology.IsBounded C) (hC_closed : IsClosed C)
    (hC_convex : Convex ℝ C) (hD_nonempty : D.Nonempty) :
    ∃ x ∈ C,
      IsMinOn
        (fun y : E ↦ sSup ((fun w : F ↦ (⟪L y, w⟫_ℝ : EReal)) '' D))
        C x := by
  have hg :
      properIoi (σ[D]) (isProper_supportFunction_of_nonempty D hD_nonempty) ∘ L ∈ Γ₀(E) :=
    supportFunctionComp_mem_gammaZero_of_nonempty (L := L) hD_nonempty
  -- Apply the bounded-set minimizer theorem to the packaged support-function objective.
  obtain ⟨x, hxarg⟩ :=
    argminOn_nonempty_of_mem_gammaZero_of_coercive_or_bounded
      hg hC_closed hC_convex hC_nonempty (Or.inr hC_bounded)
  rcases mem_argminOn_iff.mp hxarg with ⟨hxC, hxmin⟩
  have hxminSupport : IsMinOn (fun y : E ↦ σ[D] (L y)) C x := by
    -- First remove the `properIoi` packaging to recover the raw support function.
    simpa [Function.comp, properIoi_apply] using hxmin
  refine ⟨x, hxC, ?_⟩
  -- Unpack `properIoi` and rewrite the support function into the raw `sSup` slice.
  simpa [supportFunction_apply_eq_innerSlice] using hxminSupport

/-- Helper for Corollary 15.30: combining the primal minimizer from Proposition 11.15 with the
dual maximizer from Example 15.29 yields an attained witness pair on the raw inner-product
slices. -/
private theorem existsInnerMinimaxWitness
    (hC_nonempty : C.Nonempty) (hC_bounded : Bornology.IsBounded C) (hC_closed : IsClosed C)
    (hC_convex : Convex ℝ C) (hD_nonempty : D.Nonempty) (hD_bounded : Bornology.IsBounded D)
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) :
    ∃ x ∈ C, ∃ v ∈ D,
      IsMinOn
          (fun y : E ↦ sSup ((fun w : F ↦ (⟪L y, w⟫_ℝ : EReal)) '' D))
          C x ∧
        IsMaxOn
          (fun w : F ↦ sInf ((fun y : E ↦ (⟪L y, w⟫_ℝ : EReal)) '' C))
          D v ∧
        sSup ((fun w : F ↦ (⟪L x, w⟫_ℝ : EReal)) '' D) =
          sInf ((fun y : E ↦ (⟪L y, v⟫_ℝ : EReal)) '' C) := by
  obtain ⟨x, hxC, hxmin⟩ :=
    exists_isMinOn_supportSlice (L := L) hC_nonempty hC_bounded hC_closed hC_convex hD_nonempty
  have hsri : (0 : F) ∈ sri (bar D - L '' C) :=
    zero_mem_sri_barrier_sub_image_of_bounded (L := L) hC_nonempty hD_bounded
  obtain ⟨v, hvD, hvmaxOwner, hvalue⟩ :=
    exists_dualMaximizer_inf_inner_eq_inf_supportFunction_of_zero_mem_sri_sub_image
      C hC_closed hC_convex D hD_nonempty hD_closed hD_convex L hsri
  have hvmax :
      IsMaxOn
        (fun w : F ↦ sInf ((fun y : E ↦ (⟪L y, w⟫_ℝ : EReal)) '' C))
        D v := by
    -- Rewrite Example 15.29's owner objective into the raw `sInf` slice.
    simpa [innerInfimumOn_adjoint_eq_sInf_image] using hvmaxOwner
  refine ⟨x, hxC, v, hvD, hxmin, hvmax, ?_⟩
  -- Identify the common minimax value by first using the primal minimizer and then Example 15.29.
  calc
    sSup ((fun w : F ↦ (⟪L x, w⟫_ℝ : EReal)) '' D) =
        sInf ((fun y : E ↦ sSup ((fun w : F ↦ (⟪L y, w⟫_ℝ : EReal)) '' D)) '' C) := by
          exact eq_sInf_image_of_isMinOn hxC hxmin
    _ = sInf ((fun y : E ↦ (⟪L y, v⟫_ℝ : EReal)) '' C) := by
          simpa [supportFunction_apply_eq_innerSlice, innerInfimumOn_adjoint_eq_sInf_image]
            using hvalue

-- Proof sketch: derive the attained minimax equality on the original sets `C` and `D`, then
-- forget the minimizers/maximizers and keep only the outer-value equality.
/-- Corollary 15.30: on nonempty bounded closed convex sets `C` and `D`, the bilinear minimax
values on
the original sets coincide:
`sInf ((fun y ↦ sSup ((fun w ↦ (⟪L y, w⟫_ℝ : EReal)) '' D)) '' C) =
  sSup ((fun w ↦ sInf ((fun y ↦ (⟪L y, w⟫_ℝ : EReal)) '' C)) '' D)`. -/
theorem vonNeumann_minimax_inner_eq
    (hC_nonempty : C.Nonempty) (hC_bounded : Bornology.IsBounded C) (hC_closed : IsClosed C)
    (hC_convex : Convex ℝ C) (hD_nonempty : D.Nonempty) (hD_bounded : Bornology.IsBounded D)
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) :
    sInf
        ((fun y : E ↦ sSup ((fun w : F ↦ (⟪L y, w⟫_ℝ : EReal)) '' D)) '' C) =
      sSup
        ((fun w : F ↦ sInf ((fun y : E ↦ (⟪L y, w⟫_ℝ : EReal)) '' C)) '' D) := by
  obtain ⟨x, hxC, v, hvD, hxmin, hvmax, hxv⟩ :=
    existsInnerMinimaxWitness (L := L)
      hC_nonempty hC_bounded hC_closed hC_convex hD_nonempty hD_bounded hD_closed hD_convex
  -- Realize both outer values at the witness pair `(x, v)` and compare the common value.
  calc
    sInf
        ((fun y : E ↦ sSup ((fun w : F ↦ (⟪L y, w⟫_ℝ : EReal)) '' D)) '' C) =
      sSup ((fun w : F ↦ (⟪L x, w⟫_ℝ : EReal)) '' D) := by
          symm
          exact eq_sInf_image_of_isMinOn hxC hxmin
    _ = sInf ((fun y : E ↦ (⟪L y, v⟫_ℝ : EReal)) '' C) := hxv
    _ =
      sSup ((fun w : F ↦ sInf ((fun y : E ↦ (⟪L y, w⟫_ℝ : EReal)) '' C)) '' D) := by
          exact eq_sSup_image_of_isMaxOn hvD hvmax

-- Proof sketch: apply the bounded closed convex minimax machinery directly to the source sets
-- `C` and `D`.
/-- Companion attainment consequence: on the same nonempty bounded closed convex sets `C` and `D`,
the bilinear minimax problem
attains a common primal-dual value on the original sets, realizing the source `min`/`max`
equality:
`∃ x ∈ C, ∃ v ∈ D, IsMinOn (fun y ↦ sSup ((fun w ↦ (⟪L y, w⟫_ℝ : EReal)) '' D)) C x ∧
  IsMaxOn (fun w ↦ sInf ((fun y ↦ (⟪L y, w⟫_ℝ : EReal)) '' C)) D v ∧
  sSup ((fun w ↦ (⟪L x, w⟫_ℝ : EReal)) '' D) =
    sInf ((fun y ↦ (⟪L y, v⟫_ℝ : EReal)) '' C)`. -/
theorem vonNeumann_minimax_inner_attains_eq
    (hC_nonempty : C.Nonempty) (hC_bounded : Bornology.IsBounded C) (hC_closed : IsClosed C)
    (hC_convex : Convex ℝ C) (hD_nonempty : D.Nonempty) (hD_bounded : Bornology.IsBounded D)
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) :
    ∃ x ∈ C, ∃ v ∈ D,
      IsMinOn
          (fun y : E ↦ sSup ((fun w : F ↦ (⟪L y, w⟫_ℝ : EReal)) '' D))
          C x ∧
        IsMaxOn
          (fun w : F ↦ sInf ((fun y : E ↦ (⟪L y, w⟫_ℝ : EReal)) '' C))
          D v ∧
        sSup ((fun w : F ↦ (⟪L x, w⟫_ℝ : EReal)) '' D) =
          sInf ((fun y : E ↦ (⟪L y, v⟫_ℝ : EReal)) '' C) := by
  -- The private witness theorem already packages the attained primal and dual slices.
  exact existsInnerMinimaxWitness (L := L)
    hC_nonempty hC_bounded hC_closed hC_convex hD_nonempty hD_bounded hD_closed hD_convex

-- Proof sketch: use `vonNeumann_minimax_inner_attains_eq` to choose `x ∈ C` and `v ∈ D`
-- realizing the primal and dual slice values, then apply `isSaddlePointOn_iff` to package those
-- two equalities as the canonical saddle-point owner condition.
/-- Stronger companion consequence: under the same closed-convex hypotheses, the bilinear
payoff on `C × D` admits a saddle point. This is the core/canonical owner consequence, not the
main source-facing entry. -/
theorem vonNeumann_minimax_isSaddlePointOn_inner
    (hC_nonempty : C.Nonempty) (hC_bounded : Bornology.IsBounded C) (hC_closed : IsClosed C)
    (hC_convex : Convex ℝ C) (hD_nonempty : D.Nonempty) (hD_bounded : Bornology.IsBounded D)
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D) :
    ∃ x ∈ C, ∃ v ∈ D,
      IsSaddlePointOn C D (fun y w ↦ (⟪L y, w⟫_ℝ : EReal)) x v := by
  obtain ⟨x, hxC, v, hvD, _hxmin, _hvmax, hxv⟩ :=
    existsInnerMinimaxWitness (L := L)
      hC_nonempty hC_bounded hC_closed hC_convex hD_nonempty hD_bounded hD_closed hD_convex
  refine ⟨x, hxC, v, hvD, ?_⟩
  intro y hy w hw
  -- The witness equality gives the common value; compare each fiber value to that common value by
  -- the universal upper and lower bound properties of `sSup` and `sInf`.
  have hxw_le :
      (⟪L x, w⟫_ℝ : EReal) ≤
        sSup ((fun u : F ↦ (⟪L x, u⟫_ℝ : EReal)) '' D) :=
    (isLUB_sSup_image (fun u : F ↦ (⟪L x, u⟫_ℝ : EReal)) D).1 (Set.mem_image_of_mem _ hw)
  have hvy_ge :
      sInf ((fun z : E ↦ (⟪L z, v⟫_ℝ : EReal)) '' C) ≤
        (⟪L y, v⟫_ℝ : EReal) :=
    (isGLB_sInf_image (fun z : E ↦ (⟪L z, v⟫_ℝ : EReal)) C).1 (Set.mem_image_of_mem _ hy)
  calc
    (⟪L x, w⟫_ℝ : EReal) ≤
        sSup ((fun u : F ↦ (⟪L x, u⟫_ℝ : EReal)) '' D) := hxw_le
    _ = sInf ((fun z : E ↦ (⟪L z, v⟫_ℝ : EReal)) '' C) := hxv
    _ ≤ (⟪L y, v⟫_ℝ : EReal) := hvy_ge

-- Proof sketch: pass from `C` and `D` to their closed convex hulls, which preserve the owner
-- slice-value functions by `supportFunction_eq_convexHull_and_closure_convexHull` and
-- `innerInfimumOn_closure_convexHull_eq`. Then apply Example 15.29 to those closed convex hulls
-- and rewrite the resulting saddle-value equality back on the original `σ[D]`/`innerInfimumOn C`
-- surface.
/-- Companion bridge: the owner equality
`inf_{x ∈ C} σ[D](Lx) = sup_{v ∈ D} innerInfimumOn C (L.adjoint v)` only needs the Chapter 15
regularity assumption together with closed-convex hypotheses on `C` and `D`. This is the
canonical `bridge/view` reformulation used by Example 15.29, not the main source-facing entry. -/
theorem vonNeumann_minimax_supportFunction_eq_innerInfimumOn
    (hC_closed : IsClosed C) (hC_convex : Convex ℝ C)
    (hD_nonempty : D.Nonempty) (hD_closed : IsClosed D) (hD_convex : Convex ℝ D)
    (hsri :
      (0 : F) ∈
        Set.strongRelativeInterior
          (bar D - L '' C)) :
    sInf ((fun x : E ↦ σ[D] (L x)) '' C) =
      sSup ((fun v : F ↦ innerInfimumOn C (L.adjoint v)) '' D) := by
  -- Route correction: use Example 15.29 on the actual barrier-cone regularity surface instead of
  -- forcing the old closed-convex-hull placeholder hypothesis.
  obtain ⟨v, hvD, hvmax, hvalue⟩ :=
    exists_dualMaximizer_inf_inner_eq_inf_supportFunction_of_zero_mem_sri_sub_image
      C hC_closed hC_convex D hD_nonempty hD_closed hD_convex L hsri
  -- The attained dual maximizer realizes the outer `sSup` value on the right-hand side.
  calc
    sInf ((fun x : E ↦ σ[D] (L x)) '' C) = innerInfimumOn C (L.adjoint v) := hvalue
    _ = sSup ((fun w : F ↦ innerInfimumOn C (L.adjoint w)) '' D) := by
          exact eq_sSup_image_of_isMaxOn hvD hvmax

end FenchelRockafellarDuality

end ERealFunction
