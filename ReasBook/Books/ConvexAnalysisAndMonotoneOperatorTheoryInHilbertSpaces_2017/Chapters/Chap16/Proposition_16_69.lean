section EpigraphicalOperator

variable {H : Type u}

/-- The epigraphical set-valued operator associated with an `]-∞,+∞]`-valued function, sending
`x` to the real heights lying above `f x`. -/
def epigraphicalOperator (f : H → Set.Ioi (⊥ : EReal)) : SetValuedOperator H ℝ :=
  fun x ↦ {y : ℝ | (f x : EReal) ≤ (y : EReal)}

end EpigraphicalOperator

section CoderivativeOfEpigraphicalOperator

open Set
open SetValuedOperator

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

omit [NormedAddCommGroup H] [InnerProductSpace ℝ H] in
/-- Helper for Proposition 16 69: the graph of the epigraphical operator is the real-height
epigraph of the underlying `EReal`-valued function. -/
lemma graph_epigraphicalOperator_eq_epigraph
    (f : H → Set.Ioi (⊥ : EReal)) :
    SetValuedOperator.graph (epigraphicalOperator f) = epigraph f.asEReal := by
  ext p
  rcases p with ⟨x, y⟩
  -- Unfold both owners to the same epigraph inequality.
  simp [epigraphicalOperator, mem_epigraph_iff]

/-- Helper for Proposition 16 69: the positive ray generated by the slice
`(∂ f x) × {-1}` is the same as the family of pairs `(u, -v)` with `v > 0` and
`u ∈ v • (∂ f) x`. -/
lemma mem_positive_ray_subdifferential_slice_iff
    (f : H → Set.Ioi (⊥ : EReal)) {x u : H} {v : ℝ} :
    (u, -v) ∈ Ioi (0 : ℝ) • ((∂ f) x ×ˢ ({-1} : Set ℝ)) ↔
      0 < v ∧ u ∈ v • (∂ f) x := by
  constructor
  · intro hu
    change (u, -v) ∈ Set.image2 (· • ·) (Ioi (0 : ℝ)) ((∂ f) x ×ˢ ({-1} : Set ℝ)) at hu
    rcases hu with ⟨a, ha, z, hz, hz_eq⟩
    rcases z with ⟨w, b⟩
    rcases hz with ⟨hw, hb⟩
    have hu_eq : a • w = u := by
      simpa using congrArg Prod.fst hz_eq
    have hb_eq : b = -1 := by
      simpa using hb
    have hv_eq : v = a := by
      simpa [smul_eq_mul, hb_eq, mul_comm] using congrArg Prod.snd hz_eq.symm
    have hu_mem : u ∈ a • (∂ f) x := by
      exact Set.mem_smul_set.mpr ⟨w, hw, hu_eq⟩
    exact ⟨by simpa [hv_eq] using ha, by simpa [hv_eq] using hu_mem⟩
  · rintro ⟨hv, hu⟩
    rcases Set.mem_smul_set.mp hu with ⟨w, hw, rfl⟩
    have hpair_mem : (w, (-1 : ℝ)) ∈ (∂ f) x ×ˢ ({-1} : Set ℝ) := by
      exact ⟨hw, by simp⟩
    change (v • w, -v) ∈ Set.image2 (· • ·) (Ioi (0 : ℝ)) ((∂ f) x ×ˢ ({-1} : Set ℝ))
    refine ⟨v, hv, (w, (-1 : ℝ)), hpair_mem, ?_⟩
    ext <;> simp

-- Proof sketch: identify the graph of `epigraphicalOperator f` with the real-height epigraph of
-- `f`, rewrite coderivative membership as epigraph normal-cone membership, and then analyze the
-- three vertical slices directly. Positive slices are exactly positive multiples of subgradients,
-- the zero slice is the normal cone to `effectiveDomain f`, and positive vertical normals are
-- impossible.
/-- Proposition 16 69: if `f` is convex on its effective domain and `x ∈ dom f`, then the
coderivative of the epigraphical operator `x ↦ {y ∈ ℝ | f x ≤ y}` at the graph point
`(x, (f x).toReal)` is `v • ∂ f x` for `v > 0`, the normal cone to `dom f` at `x` for `v = 0`,
and `∅` for `v < 0`. -/
theorem coderivative_epigraphicalOperator_eq_piecewise
    (f : H → Set.Ioi (⊥ : EReal)) (hconvex : ConvexOn f (effectiveDomain f))
    {x : H} (hx : x ∈ effectiveDomain f) :
    ((D* (epigraphicalOperator f)) x ((f x : EReal).toReal)) =
      fun v : ℝ ↦
        if 0 < v then
          v • (∂ f) x
        else if v = 0 then
          N[effectiveDomain f] x
        else
          ∅ := by
  let _ := hconvex
  funext v
  ext u
  -- Rewrite the coderivative through the graph/epigraph bridge and then apply the normal-cone
  -- piecewise characterization.
  rw [mem_coderivative_iff]
  rw [graph_epigraphicalOperator_eq_epigraph (f := f)]
  have hnormal :
      ((u, -v) ∈ N[epigraph f.asEReal] (x, (f x : EReal).toReal)) =
        ((u, -v) ∈
          N[effectiveDomain f] x ×ˢ ({0} : Set ℝ) ∪
            Ioi (0 : ℝ) • ((∂ f) x ×ˢ ({-1} : Set ℝ))) := by
    exact congrArg
      (fun s : Set (H × ℝ) ↦ (u, -v) ∈ s)
      (normalCone_epigraph_eq_effectiveDomain_normal_zero_union_positive_subdifferential
        (f := f) (x := x) hx)
  by_cases hpos : 0 < v
  · rw [if_pos hpos]
    constructor
    · intro hu
      have hu' :
          (u, -v) ∈
            N[effectiveDomain f] x ×ˢ ({0} : Set ℝ) ∪
              Ioi (0 : ℝ) • ((∂ f) x ×ˢ ({-1} : Set ℝ)) := by
        exact Eq.mp hnormal hu
      rcases hu' with hu_zero | hu_pos
      · have hv_zero : v = 0 := by
          have hnegv_zero : -v = 0 := by
            simpa using hu_zero.2
          linarith
        exact False.elim (by linarith [hpos, hv_zero])
      · have hray :=
          (mem_positive_ray_subdifferential_slice_iff (f := f) (x := x) (u := u) (v := v)).1 hu_pos
        exact hray.2
    · intro hu
      have hu' :
          (u, -v) ∈
            N[effectiveDomain f] x ×ˢ ({0} : Set ℝ) ∪
              Ioi (0 : ℝ) • ((∂ f) x ×ˢ ({-1} : Set ℝ)) := by
        exact Or.inr <|
          (mem_positive_ray_subdifferential_slice_iff (f := f) (x := x) (u := u) (v := v)).2
            ⟨hpos, hu⟩
      exact Eq.mpr hnormal hu'
  · rw [if_neg hpos]
    by_cases hzero : v = 0
    · rw [if_pos hzero]
      constructor
      · intro hu
        have hu' :
            (u, -v) ∈
              N[effectiveDomain f] x ×ˢ ({0} : Set ℝ) ∪
                Ioi (0 : ℝ) • ((∂ f) x ×ˢ ({-1} : Set ℝ)) := by
          exact Eq.mp hnormal hu
        rcases hu' with hu_zero | hu_pos
        · simpa [hzero] using hu_zero.1
        · have hray :=
            (mem_positive_ray_subdifferential_slice_iff (f := f) (x := x) (u := u) (v := v)).1
              hu_pos
          exact False.elim (hpos hray.1)
      · intro hu
        have hu' :
            (u, -v) ∈
              N[effectiveDomain f] x ×ˢ ({0} : Set ℝ) ∪
                Ioi (0 : ℝ) • ((∂ f) x ×ˢ ({-1} : Set ℝ)) := by
          exact Or.inl ⟨hu, by simp [hzero]⟩
        exact Eq.mpr hnormal hu'
    · rw [if_neg hzero]
      constructor
      · intro hu
        have hu' :
            (u, -v) ∈
              N[effectiveDomain f] x ×ˢ ({0} : Set ℝ) ∪
                Ioi (0 : ℝ) • ((∂ f) x ×ˢ ({-1} : Set ℝ)) := by
          exact Eq.mp hnormal hu
        rcases hu' with hu_zero | hu_pos
        · have hv_zero : v = 0 := by
            have hnegv_zero : -v = 0 := by
              simpa using hu_zero.2
            linarith
          exact False.elim (hzero hv_zero)
        · have hray :=
            (mem_positive_ray_subdifferential_slice_iff (f := f) (x := x) (u := u) (v := v)).1
              hu_pos
          exact False.elim (hpos hray.1)
      · intro hu
        have : False := by
          simp at hu
        exact False.elim this

end CoderivativeOfEpigraphicalOperator

end ERealFunction
