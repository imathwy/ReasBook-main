/-- Helper for Example 16 55: membership in the pointed cone generated by a finite family can be
rewritten as a nonnegative coefficient sum over the index set. -/
lemma mem_pointedConeHull_image_finset_iff
    {s : Finset α} {x : α → H} {y : H} :
    y ∈ (PointedCone.hull ℝ (x '' (s : Set α)) : Set H) ↔
      ∃ a : α → NNReal, ∑ i ∈ s, (a i : ℝ) • x i = y := by
  constructor
  · intro hy
    -- Reindex the finitely supported conical combination from the image support back to `s`.
    have hy' :
        ∃ c : H →₀ ℝ, ↑c.support ⊆ x '' (s : Set α) ∧ (∀ z, 0 ≤ c z) ∧
          c.sum (fun m r ↦ r • m) = y := by
      simpa using
        (PointedCone.mem_hull_set (R := ℝ) (s := x '' (s : Set α)) (x := y)).mp hy
    rcases hy' with ⟨c, hc, hc_nonneg, rfl⟩
    classical
    let c' : {m // m ∈ c.support} →₀ ℝ := c.subtypeDomain (fun m ↦ m ∈ c.support)
    have hrep :
        ∀ m : {m // m ∈ c.support}, ∃ i, i ∈ s ∧ x i = m.1 := by
      intro m
      rcases hc m.2 with ⟨i, hi, hxi⟩
      exact ⟨i, hi, hxi⟩
    let rep : {m // m ∈ c.support} → α := fun m ↦ Classical.choose (hrep m)
    have hrep_mem : ∀ m : {m // m ∈ c.support}, rep m ∈ s := by
      intro m
      simpa [rep] using (Classical.choose_spec (hrep m)).1
    have hrep_eq : ∀ m : {m // m ∈ c.support}, x (rep m) = m.1 := by
      intro m
      simpa [rep] using (Classical.choose_spec (hrep m)).2
    let e : {m // m ∈ c.support} ↪ α := ⟨rep, by
      intro m₁ m₂ h
      apply Subtype.ext
      calc
        m₁.1 = x (rep m₁) := by rw [hrep_eq m₁]
        _ = x (rep m₂) := by rw [h]
        _ = m₂.1 := by rw [hrep_eq m₂]⟩
    let d : α →₀ ℝ := c'.embDomain e
    have hd_support : d.support ⊆ s := by
      intro i hi
      by_contra his
      have hnot_range : i ∉ Set.range e := by
        intro hi_range
        rcases hi_range with ⟨m, hm⟩
        have hmemb : e m ∈ s := by
          simpa [e] using hrep_mem m
        exact his (hm ▸ hmemb)
      rw [Finsupp.mem_support_iff] at hi
      exact hi (Finsupp.embDomain_notin_range e c' i hnot_range)
    have hd_nonneg : ∀ i, 0 ≤ d i := by
      intro i
      rw [Finsupp.embDomain_apply]
      split_ifs with hi
      · simpa [c'] using hc_nonneg hi.choose.1
      · simp
    refine ⟨fun i ↦ ⟨d i, hd_nonneg i⟩, ?_⟩
    calc
      (∑ i ∈ s, ((⟨d i, hd_nonneg i⟩ : NNReal) : ℝ) • x i) = ∑ i ∈ s, d i • x i := by
        simp
      _ = Finset.sum d.support (fun i ↦ d i • x i) := by
        symm
        exact Finset.sum_subset hd_support fun i _ hi_not_mem ↦ by
          rw [Finsupp.notMem_support_iff.mp hi_not_mem, zero_smul]
      _ = d.sum (fun i r ↦ r • x i) := rfl
      _ = c'.sum (fun m r ↦ r • x (e m)) := by
        rw [Finsupp.sum_embDomain]
      _ = c'.sum (fun m r ↦ r • m.1) := by
        refine Finsupp.sum_congr ?_
        intro m hm
        simpa [e] using congrArg (fun z ↦ c' m • z) (hrep_eq m)
      _ = c.sum (fun m r ↦ r • m) := by
        have hemb :
            c'.embDomain (Function.Embedding.subtype fun m ↦ m ∈ c.support) = c := by
          calc
            c'.embDomain (Function.Embedding.subtype fun m ↦ m ∈ c.support) = c'.extendDomain := by
              symm
              rw [Finsupp.extendDomain_eq_embDomain_subtype]
            _ = c := by
              simpa [c'] using
                (Finsupp.extendDomain_subtypeDomain (f := c) (P := fun m ↦ m ∈ c.support)
                  (hf := fun m hm ↦ hm))
        calc
          c'.sum (fun m r ↦ r • m.1) =
              (c'.embDomain (Function.Embedding.subtype fun m ↦ m ∈ c.support)).sum
                (fun m r ↦ r • m) := by
                  symm
                  simpa using
                    (Finsupp.sum_embDomain
                      (f := Function.Embedding.subtype fun m ↦ m ∈ c.support)
                      (v := c') (g := fun m r ↦ r • m))
          _ = c.sum (fun m r ↦ r • m) := by rw [hemb]
  · rintro ⟨a, rfl⟩
    -- Each generator lies in the hull, so finite nonnegative sums stay in the pointed cone.
    exact Submodule.sum_mem _ fun i hi ↦
      (PointedCone.hull ℝ (x '' (s : Set α))).smul_mem
        (show 0 ≤ (a i : ℝ) by exact_mod_cast (show 0 ≤ a i from (a i).2))
        (PointedCone.subset_hull ⟨i, hi, rfl⟩)

/-- Helper for Example 16 55: membership in the finite pointed cone hull can be rewritten using
coefficients indexed by the subtype `s`. -/
lemma mem_pointedConeHull_image_finset_iff_exists_nonneg_subtype_sum
    {s : Finset α} {x : α → H} {y : H} :
    y ∈ (PointedCone.hull ℝ (x '' (s : Set α)) : Set H) ↔
      ∃ a : s → ℝ, (∀ i, 0 ≤ a i) ∧ (∑ i : s, a i • x i.1) = y := by
  classical
  rw [mem_pointedConeHull_image_finset_iff]
  constructor
  · rintro ⟨a, ha⟩
    -- Restrict the global coefficient family to the finite subtype.
    refine ⟨fun i ↦ a i.1, fun i ↦ by exact_mod_cast (a i.1).2, ?_⟩
    calc
      ∑ i : s, (a i.1 : ℝ) • x i.1 = ∑ i ∈ s, (a i : ℝ) • x i := by
        simpa using (s.sum_attach (f := fun i ↦ (a i : ℝ) • x i))
      _ = y := ha
  · rintro ⟨a, ha_nonneg, ha_sum⟩
    -- Extend the subtype coefficients by zero outside `s`.
    let b : α → NNReal := fun i ↦ if hi : i ∈ s then ⟨a ⟨i, hi⟩, ha_nonneg ⟨i, hi⟩⟩ else 0
    refine ⟨b, ?_⟩
    rw [← s.sum_attach (f := fun i ↦ (b i : ℝ) • x i)]
    simpa [b]

/-- Helper for Example 16 55: the coefficient linear map sends a finite coefficient family to the
corresponding conical combination. -/
def coefficient_sum_linear_map
    (s : Finset α) (x : α → H) : (s → ℝ) →ₗ[ℝ] H :=
  Fintype.linearCombination ℝ (fun i : s ↦ x i.1)

/-- Helper for Example 16 55: the finite nonnegative orthant in the coefficient space is closed. -/
lemma isClosed_nonnegative_subtype_coefficients
    (s : Finset α) : IsClosed {a : s → ℝ | ∀ i, 0 ≤ a i} := by
  -- The orthant is the finite intersection of the closed coordinate halfspaces.
  simpa [Set.pi, Set.mem_Ici] using
    (isClosed_set_pi (i := (Set.univ : Set s)) (s := fun _ : s ↦ Set.Ici (0 : ℝ))
      (fun _ _ ↦ isClosed_Ici))

/-- Helper for Example 16 55: the finite pointed cone hull is the image of the nonnegative orthant
under the coefficient linear map. -/
lemma image_nonnegative_subtype_coefficients_eq_pointedConeHull_image_finset
    (s : Finset α) (x : α → H) :
    coefficient_sum_linear_map s x '' {a : s → ℝ | ∀ i, 0 ≤ a i} =
      (PointedCone.hull ℝ (x '' (s : Set α)) : Set H) := by
  ext y
  constructor
  · rintro ⟨a, ha_nonneg, rfl⟩
    -- The image formula is exactly the subtype coefficient description of cone membership.
    refine mem_pointedConeHull_image_finset_iff_exists_nonneg_subtype_sum.mpr ?_
    refine ⟨a, ha_nonneg, ?_⟩
    simp [coefficient_sum_linear_map, Fintype.linearCombination_apply]
  · intro hy
    -- Conversely, every cone point comes with nonnegative subtype coefficients.
    rcases (mem_pointedConeHull_image_finset_iff_exists_nonneg_subtype_sum.mp hy) with
      ⟨a, ha_nonneg, ha_sum⟩
    refine ⟨a, ha_nonneg, ?_⟩
    simpa [coefficient_sum_linear_map, Fintype.linearCombination_apply] using ha_sum

/-- Helper for Example 16 55: a simplicial finite pointed cone is closed. -/
lemma isClosed_pointedConeHull_image_finset_of_linearIndependent
    (s : Finset α) (x : α → H) (hlin : LinearIndependent ℝ (fun i : s ↦ x i.1)) :
    IsClosed (PointedCone.hull ℝ (x '' (s : Set α)) : Set H) := by
  let coeffMap : (s → ℝ) →ₗ[ℝ] H := coefficient_sum_linear_map s x
  let P : Set (s → ℝ) := {a | ∀ i, 0 ≤ a i}
  have hcoeff_injective : Function.Injective coeffMap := by
    -- Linear independence makes the coefficient map injective on the finite coefficient space.
    simpa [coeffMap, coefficient_sum_linear_map] using hlin.fintypeLinearCombination_injective
  have hker : LinearMap.ker coeffMap = ⊥ := LinearMap.ker_eq_bot.mpr hcoeff_injective
  have hP : IsClosed P := isClosed_nonnegative_subtype_coefficients s
  letI : ContinuousNeg H := ContinuousNeg.of_continuousConstSMul ℝ H
  letI : IsTopologicalAddGroup H :=
    { toContinuousAdd := inferInstance
      toContinuousNeg := inferInstance }
  have hclosedEmbedding : Topology.IsClosedEmbedding coeffMap :=
    LinearMap.isClosedEmbedding_of_injective hker
  -- Work with the closed embedding of the coefficient map itself.
  rw [← image_nonnegative_subtype_coefficients_eq_pointedConeHull_image_finset (s := s) (x := x)]
  simpa [coeffMap, P] using hclosedEmbedding.isClosedMap _ hP

/-- Helper for Example 16 55: in a dependent finite family, one generator can be removed without
changing any cone point. -/
lemma exists_mem_pointedConeHull_image_finset_erase_of_not_linearIndependent
    [DecidableEq α]
    {s : Finset α} {x : α → H} {y : H}
    (hdep : ¬ LinearIndependent ℝ (fun i : s ↦ x i.1))
    (hy : y ∈ (PointedCone.hull ℝ (x '' (s : Set α)) : Set H)) :
    ∃ j ∈ s,
      y ∈ (PointedCone.hull ℝ (x '' (((s.erase j) : Finset α) : Set α)) : Set H) := by
  classical
  rcases (mem_pointedConeHull_image_finset_iff.mp hy) with ⟨a, ha_sum⟩
  have hdepOn : ¬ LinearIndepOn ℝ x (s : Set α) := by
    simpa [linearIndependent_restrict_iff] using hdep
  obtain ⟨β, hβsum, hβnz⟩ :=
    (not_linearIndepOn_finset_iff (R := ℝ) (v := x) (s := s)).mp hdepOn
  obtain ⟨β', hβ'sum, hβ'pos⟩ :
      ∃ β' : α → ℝ, (∑ i ∈ s, β' i • x i = 0) ∧ ∃ i ∈ s, 0 < β' i := by
    by_cases hpos : ∃ i ∈ s, 0 < β i
    · exact ⟨β, hβsum, hpos⟩
    · refine ⟨fun i ↦ -β i, ?_, ?_⟩
      · simpa [neg_smul, Finset.sum_neg_distrib] using congrArg Neg.neg hβsum
      · rcases hβnz with ⟨i, hi, hβi_ne⟩
        have hβi_nonpos : β i ≤ 0 := le_of_not_gt (fun h ↦ hpos ⟨i, hi, h⟩)
        have hβi_neg : β i < 0 := lt_of_le_of_ne hβi_nonpos (by simpa using hβi_ne)
        exact ⟨i, hi, by simpa using neg_pos.mpr hβi_neg⟩
  let positiveSupport : Finset α := s.filter (fun i ↦ 0 < β' i)
  have hpositiveSupport_nonempty : positiveSupport.Nonempty := by
    rcases hβ'pos with ⟨i, hi, hβi_pos⟩
    exact ⟨i, Finset.mem_filter.mpr ⟨hi, hβi_pos⟩⟩
  obtain ⟨j, hj_positiveSupport, hmin⟩ :=
    Finset.exists_min_image positiveSupport (fun i ↦ (a i : ℝ) / β' i)
      hpositiveSupport_nonempty
  have hj_mem : j ∈ s := (Finset.mem_filter.mp hj_positiveSupport).1
  have hj_pos : 0 < β' j := (Finset.mem_filter.mp hj_positiveSupport).2
  let γ : ℝ := (a j : ℝ) / β' j
  let δ : α → ℝ := fun i ↦ (a i : ℝ) - γ * β' i
  have hγ_nonneg : 0 ≤ γ := by
    exact div_nonneg (by exact_mod_cast (a j).2) (le_of_lt hj_pos)
  have hδ_nonneg : ∀ i ∈ s, 0 ≤ δ i := by
    intro i hi
    by_cases hβi_pos : 0 < β' i
    · have hi_positiveSupport : i ∈ positiveSupport := Finset.mem_filter.mpr ⟨hi, hβi_pos⟩
      have hratio : γ ≤ (a i : ℝ) / β' i := hmin i hi_positiveSupport
      have hupper : γ * β' i ≤ (a i : ℝ) := (le_div_iff₀ hβi_pos).mp hratio
      exact sub_nonneg.mpr (by simpa [δ, mul_comm] using hupper)
    · have hβi_nonpos : β' i ≤ 0 := le_of_not_gt hβi_pos
      have hmul_nonpos : γ * β' i ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hγ_nonneg hβi_nonpos
      have ha_nonneg : 0 ≤ (a i : ℝ) := by exact_mod_cast (a i).2
      exact sub_nonneg.mpr (le_trans hmul_nonpos ha_nonneg)
  have hδj : δ j = 0 := by
    have hj_ne : β' j ≠ 0 := ne_of_gt hj_pos
    have hmul : γ * β' j = (a j : ℝ) := by
      calc
        γ * β' j = ((a j : ℝ) / β' j) * β' j := rfl
        _ = (a j : ℝ) := by field_simp [hj_ne]
    calc
      δ j = (a j : ℝ) - γ * β' j := rfl
      _ = 0 := by simp [hmul]
  have hδ_sum : ∑ i ∈ s, δ i • x i = y := by
    calc
      ∑ i ∈ s, δ i • x i = ∑ i ∈ s, (((a i : ℝ) • x i) - ((γ * β' i) • x i)) := by
        refine Finset.sum_congr rfl ?_
        intro i hi
        simp [δ, sub_smul, mul_smul]
      _ = (∑ i ∈ s, (a i : ℝ) • x i) - ∑ i ∈ s, (γ * β' i) • x i := by
        rw [Finset.sum_sub_distrib]
      _ = (∑ i ∈ s, (a i : ℝ) • x i) - γ • ∑ i ∈ s, β' i • x i := by
        simp [Finset.smul_sum, mul_smul]
      _ = y := by
        rw [hβ'sum, smul_zero, sub_zero, ha_sum]
  let c : α → NNReal := fun i ↦
    if hi : i ∈ s.erase j then ⟨δ i, hδ_nonneg i (Finset.mem_of_mem_erase hi)⟩ else 0
  have hc_sum : ∑ i ∈ s.erase j, (c i : ℝ) • x i = y := by
    calc
      ∑ i ∈ s.erase j, (c i : ℝ) • x i = ∑ i ∈ s.erase j, δ i • x i := by
        refine Finset.sum_congr rfl ?_
        intro i hi
        have hij : i ≠ j := (Finset.mem_erase.mp hi).1
        have his : i ∈ s := (Finset.mem_erase.mp hi).2
        simp [c, Finset.mem_erase, hij, his]
      _ = ∑ i ∈ s, δ i • x i := by
        have hsplitted :
            ∑ i ∈ s.erase j, δ i • x i + δ j • x j = ∑ i ∈ s, δ i • x i :=
          Finset.sum_erase_add s (fun i ↦ δ i • x i) hj_mem
        simpa [hδj] using hsplitted
      _ = y := hδ_sum
  exact ⟨j, hj_mem, (mem_pointedConeHull_image_finset_iff.mpr ⟨c, hc_sum⟩)⟩

/-- Helper for Example 16 55: a dependent finite cone is a finite union of smaller cones obtained
by erasing one generator. -/
lemma pointedConeHull_image_finset_eq_biUnion_erase_of_not_linearIndependent
    [DecidableEq α]
    (s : Finset α) (x : α → H)
    (hdep : ¬ LinearIndependent ℝ (fun i : s ↦ x i.1)) :
    (PointedCone.hull ℝ (x '' (s : Set α)) : Set H) =
      ⋃ j ∈ s, (PointedCone.hull ℝ (x '' (((s.erase j) : Finset α) : Set α)) : Set H) := by
  ext y
  constructor
  · intro hy
    rcases exists_mem_pointedConeHull_image_finset_erase_of_not_linearIndependent hdep hy with
      ⟨j, hj, hyj⟩
    exact Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr ⟨hj, hyj⟩⟩
  · intro hy
    rcases Set.mem_iUnion.mp hy with ⟨j, hy⟩
    rcases Set.mem_iUnion.mp hy with ⟨hj, hyj⟩
    rcases (mem_pointedConeHull_image_finset_iff.mp hyj) with ⟨a, ha_sum⟩
    let b : α → NNReal := fun i ↦ if hi : i ∈ s.erase j then a i else 0
    refine (mem_pointedConeHull_image_finset_iff.mpr ?_)
    refine ⟨b, ?_⟩
    calc
      ∑ i ∈ s, (b i : ℝ) • x i = ∑ i ∈ s.erase j, (b i : ℝ) • x i + (b j : ℝ) • x j := by
        exact (Finset.sum_erase_add s (fun i ↦ (b i : ℝ) • x i) hj).symm
      _ = ∑ i ∈ s.erase j, (a i : ℝ) • x i := by
        have hb_sum :
            ∑ i ∈ s.erase j, (b i : ℝ) • x i = ∑ i ∈ s.erase j, (a i : ℝ) • x i := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          have hij : i ≠ j := (Finset.mem_erase.mp hi).1
          have his : i ∈ s := (Finset.mem_erase.mp hi).2
          simp [b, Finset.mem_erase, hij, his]
        have hbj : (b j : ℝ) • x j = 0 := by
          simp [b]
        rw [hbj, add_zero, hb_sum]
      _ = y := ha_sum

/-- Helper for Example 16 55: the pointed cone generated by a finite family is closed. -/
lemma isClosed_pointedConeHull_image_finset
    (s : Finset α) (x : α → H) :
    IsClosed (PointedCone.hull ℝ (x '' (s : Set α)) : Set H) := by
  classical
  let P : ℕ → Prop := fun n ↦
    ∀ t : Finset α, t.card = n →
      IsClosed (PointedCone.hull ℝ (x '' (t : Set α)) : Set H)
  have hP : ∀ n, (∀ m < n, P m) → P n := by
    intro n ih t ht
    by_cases hlin : LinearIndependent ℝ (fun i : t ↦ x i.1)
    · exact isClosed_pointedConeHull_image_finset_of_linearIndependent t x hlin
    · rw [pointedConeHull_image_finset_eq_biUnion_erase_of_not_linearIndependent t x hlin]
      refine isClosed_biUnion_finset ?_
      intro j hj
      have hcard : (t.erase j).card < n := by
        rw [← ht]
        exact Finset.card_erase_lt_of_mem hj
      exact ih (t.erase j).card hcard (t.erase j) rfl
  have hs_closed : P s.card := Nat.strong_induction_on (p := P) s.card hP
  exact hs_closed s rfl

/-- Helper for Example 16 55: the range version of finite cone membership has a direct nonnegative
coefficient description. -/
lemma mem_pointedConeHull_range_iff_exists_nonneg_sum
    [Fintype α] {x : α → H} {y : H} :
    y ∈ (PointedCone.hull ℝ (Set.range x) : Set H) ↔
      ∃ a : α → NNReal, ∑ i, (a i : ℝ) • x i = y := by
  simpa [Set.image_univ] using
    (mem_pointedConeHull_image_finset_iff
      (s := (Finset.univ : Finset α)) (x := x) (y := y))

/-- Helper for Example 16 55: the range version of the finite pointed cone is closed. -/
lemma isClosed_pointedConeHull_range
    [Finite α] {x : α → H} :
    IsClosed (PointedCone.hull ℝ (Set.range x) : Set H) := by
  let _ : Fintype α := Fintype.ofFinite α
  simpa [Set.image_univ] using
    (isClosed_pointedConeHull_image_finset
      (s := (Finset.univ : Finset α)) (x := x))

/-- Helper for Example 16 55: finite cone membership is equivalent to the containment of the
singleton polar cones of the generators inside the singleton polar cone of `y`. -/
lemma mem_pointedConeHull_range_iff_iInter_polarCone_singleton_subset
    [Finite α] {x : α → H} {y : H} :
    y ∈ (PointedCone.hull ℝ (Set.range x) : Set H) ↔
      (⋂ i, ({x i} : Set H)ᵒ⊖) ⊆ ({y} : Set H)ᵒ⊖ := by
  let _ : Fintype α := Fintype.ofFinite α
  let U : Submodule ℝ H := Submodule.span ℝ (insert y (Set.range x))
  letI : FiniteDimensional ℝ ↥U := by
    dsimp [U]
    exact FiniteDimensional.span_of_finite (K := ℝ) ((Set.finite_range x).insert y)
  letI : NormedAddCommGroup ↥U := inferInstance
  letI : NormedSpace ℝ ↥U := inferInstance
  letI : InnerProductSpace ℝ ↥U := inferInstance
  letI : ProperSpace ↥U := FiniteDimensional.proper ℝ ↥U
  let xU : α → ↥U := fun i ↦
    ⟨x i, by
      dsimp [U]
      exact Submodule.subset_span (Set.mem_insert_of_mem y (Set.mem_range_self i))⟩
  let yU : ↥U := ⟨y, by
    dsimp [U]
    exact Submodule.subset_span (by simp)⟩
  let K : ProperCone ℝ ↥U :=
    { toSubmodule := PointedCone.hull ℝ (Set.range xU)
      isClosed' := isClosed_pointedConeHull_range (x := xU) }
  have hcoeff :
      y ∈ (PointedCone.hull ℝ (Set.range x) : Set H) ↔
        ∃ a : α → NNReal, ∑ i, (a i : ℝ) • x i = y := by
    exact mem_pointedConeHull_range_iff_exists_nonneg_sum (x := x) (y := y)
  have hcoeffU :
      yU ∈ (PointedCone.hull ℝ (Set.range xU) : Set ↥U) ↔
        ∃ a : α → NNReal, ∑ i, (a i : ℝ) • xU i = yU := by
    exact mem_pointedConeHull_range_iff_exists_nonneg_sum (x := xU) (y := yU)
  have hlift :
      y ∈ (PointedCone.hull ℝ (Set.range x) : Set H) ↔
        yU ∈ (PointedCone.hull ℝ (Set.range xU) : Set ↥U) := by
    constructor
    · intro hy
      rcases hcoeff.mp hy with ⟨a, ha⟩
      refine hcoeffU.mpr ⟨a, ?_⟩
      apply Subtype.ext
      change (Submodule.subtype U) (∑ i, (a i : ℝ) • xU i) = y
      rw [map_sum]
      simpa [xU] using ha
    · intro hy
      rcases hcoeffU.mp hy with ⟨a, ha⟩
      refine hcoeff.mpr ⟨a, ?_⟩
      have ha' := congrArg (Submodule.subtype U) ha
      simpa [xU, yU, map_sum] using ha'
  constructor
  · intro hy
    rcases hcoeff.mp hy with ⟨a, ha⟩
    intro z hz
    rw [Set.mem_polarCone_iff_forall_inner_nonpos]
    have hz_singleton (i : α) : inner (𝕜 := ℝ) (x i) z ≤ 0 := by
      have hzi : z ∈ ({x i} : Set H)ᵒ⊖ := (Set.mem_iInter.mp hz) i
      exact
        (Set.mem_polarCone_iff_forall_inner_nonpos.mp hzi) (x i) (by simp)
    have hinner_yz : inner (𝕜 := ℝ) y z ≤ 0 := by
      calc
        inner (𝕜 := ℝ) y z = inner (𝕜 := ℝ) (∑ i, (a i : ℝ) • x i) z := by
          rw [← ha]
        _ = ∑ i, inner (𝕜 := ℝ) ((a i : ℝ) • x i) z := by
          simpa using
            (sum_inner (s := (Finset.univ : Finset α))
              (f := fun i ↦ (a i : ℝ) • x i) z)
        _ ≤ ∑ i, 0 := by
          refine Finset.sum_le_sum ?_
          intro i hi
          have hai : 0 ≤ (a i : ℝ) := by exact_mod_cast (a i).2
          simpa [real_inner_smul_left] using
            mul_le_mul_of_nonneg_left (hz_singleton i) hai
        _ = 0 := by simp
    simpa using hinner_yz
  · intro hsubset
    have hComplete : CompleteSpace ↥U := by infer_instance
    letI : CompleteSpace ↥U := hComplete
    let hcheb : IsChebyshev (K : Set ↥U) :=
      @properConeProjectionChebyshev ↥U _ _ hComplete K
    let p : ↥U := projectionPoint (K : Set ↥U) hcheb yU
    let r : ↥U := yU - p
    have hr_polar : r ∈ (K : Set ↥U)ᵒ⊖ := by
      simpa [p, r] using
        (@sub_mem_polarCone_of_eq_projectionPoint_on_properCone
          ↥U _ _ hComplete K (x := yU) (p := p) rfl)
    have hr_inter : (r : H) ∈ ⋂ i, ({x i} : Set H)ᵒ⊖ := by
      rw [Set.mem_iInter]
      intro i
      rw [Set.mem_polarCone_iff_forall_inner_nonpos]
      intro z hz
      have hxiK : xU i ∈ K := by
        simpa [K] using
          (PointedCone.subset_hull (R := ℝ) (s := Set.range xU) (Set.mem_range_self i))
      rcases Set.mem_singleton_iff.mp hz with rfl
      simpa [xU, r] using
        (Set.mem_polarCone_iff_forall_inner_nonpos.mp hr_polar) (xU i) hxiK
    have hry : (r : H) ∈ ({y} : Set H)ᵒ⊖ := hsubset hr_inter
    have hinner : inner (𝕜 := ℝ) yU (yU - p) ≤ 0 := by
      simpa [yU, p, r] using
        (Set.mem_polarCone_iff_forall_inner_nonpos.mp hry) y (by simp)
    have hyU_mem : yU ∈ K := by
      simpa [p, hcheb] using
        (@mem_of_inner_sub_projectionPoint_nonpos_of_properCone
          ↥U _ _ hComplete K yU hinner)
    exact hlift.mpr <| by
      simpa [K] using hyU_mem

end

end Example16_55Support


/-- Helper for Example 16 55: at a point of the set, normal-cone membership is equivalent to the
translated pointwise support inequality. -/
private lemma mem_normalCone_iff_forall_inner_sub_nonpos {C : Set H} {z v : H}
    (hz : z ∈ C) :
    v ∈ N[C] z ↔ ∀ y ∈ C, ⟪y - z, v⟫_ℝ ≤ 0 := by
  -- Rewrite the normal cone through Definition 6.38 at the base point `z`.
  rw [Set.normalCone_of_mem hz]
  constructor
  · intro hv
    -- Compare the translated supremum against the singleton infimum at `0`.
    have hsep : innerSupremumOn (C - ({z} : Set H)) v ≤ innerInfimumOn ({0} : Set H) v := by
      simpa using hv
    have hinner :=
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (C - ({z} : Set H)) ({0} : Set H) v).1 hsep
    intro y hy
    have hy_sub : y - z ∈ C - ({z} : Set H) := by
      exact ⟨y, hy, z, by simp, rfl⟩
    simpa using hinner (y - z) hy_sub 0 (by simp)
  · intro hv
    have hsep :
        innerSupremumOn (C - ({z} : Set H)) v ≤ innerInfimumOn ({0} : Set H) v :=
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (C - ({z} : Set H)) ({0} : Set H) v).2 <| by
          intro w hw y hy
          have hy0 : y = 0 := by simpa using hy
          subst hy0
          rcases hw with ⟨x, hx, z', hz', rfl⟩
          have hz' : z' = z := by simpa using hz'
          subst hz'
          simpa using hv x hx
    simpa using hsep

/-- Helper for Example 16 55: finitely many positive bounds admit a common positive scaling factor
that keeps every scaled coefficient under its bound. -/
private lemma exists_pos_forall_mul_le_of_pos
    {α : Type*} [Finite α] (a b : α → ℝ) (hb : ∀ i, 0 < b i) :
    ∃ t > 0, ∀ i, t * a i ≤ b i := by
  classical
  by_cases hα : IsEmpty α
  · refine ⟨1, zero_lt_one, ?_⟩
    intro i
    exact (hα.false i).elim
  · let _ : Fintype α := Fintype.ofFinite α
    let _ : Nonempty α := not_isEmpty_iff.mp hα
    let R : Finset ℝ := Finset.univ.image fun i ↦ b i / (|a i| + 1)
    have hR_nonempty : R.Nonempty := by
      rcases (show (Finset.univ : Finset α).Nonempty from Finset.univ_nonempty) with ⟨i⟩
      exact ⟨b i / (|a i| + 1), Finset.mem_image.mpr ⟨i, by simp, rfl⟩⟩
    let t : ℝ := R.min' hR_nonempty
    have ht_pos : 0 < t := by
      -- The minimum of the positive bounds remains positive.
      have ht_mem : t ∈ R := Finset.min'_mem R hR_nonempty
      rcases Finset.mem_image.mp ht_mem with ⟨i, -, hti⟩
      have hden_pos : 0 < |a i| + 1 := by positivity
      simpa [hti] using div_pos (hb i) hden_pos
    refine ⟨t, ht_pos, ?_⟩
    intro i
    have ht_le :
        t ≤ b i / (|a i| + 1) := by
      exact Finset.min'_le R (b i / (|a i| + 1)) (Finset.mem_image.mpr ⟨i, by simp, rfl⟩)
    by_cases hai_nonpos : a i ≤ 0
    · have hmul_nonpos : t * a i ≤ 0 := by
        exact mul_nonpos_of_nonneg_of_nonpos (le_of_lt ht_pos) hai_nonpos
      exact le_trans hmul_nonpos (le_of_lt (hb i))
    · have hai_le_abs_add_one : a i ≤ |a i| + 1 := by
        linarith [le_abs_self (a i)]
      have hden_pos : 0 < |a i| + 1 := by positivity
      have hmul_bound :
          t * (|a i| + 1) ≤ b i := by
        have hmul :=
          mul_le_mul_of_nonneg_right ht_le (le_of_lt hden_pos)
        calc
          t * (|a i| + 1) ≤ (b i / (|a i| + 1)) * (|a i| + 1) := hmul
          _ = b i := by field_simp [hden_pos.ne']
      have hmul_mono :
          t * a i ≤ t * (|a i| + 1) := by
        exact mul_le_mul_of_nonneg_left hai_le_abs_add_one (le_of_lt ht_pos)
      exact le_trans hmul_mono hmul_bound

/-- Helper for Example 16 55: a normal vector to the finite halfspace intersection annihilates
every vector that is polar to the active normals. -/
private lemma active_polar_subset_singleton_polar_of_mem_normalCone
    (s : Finset ι) (u : s → H) (β : s → ℝ) {z v : H}
    (hz : ∀ i : s, ⟪z, u i⟫_ℝ ≤ β i)
    (hv :
      v ∈
        N[({x : H | ∀ i : s, ⟪x, u i⟫_ℝ ≤ β i} : Set H)] z) :
    (⋂ i : {i : s // ⟪z, u i⟫_ℝ = β i}, ({u i.1} : Set H)ᵒ⊖) ⊆ ({v} : Set H)ᵒ⊖ := by
  classical
  let C : Set H := {x : H | ∀ i : s, ⟪x, u i⟫_ℝ ≤ β i}
  have hzC : z ∈ C := hz
  have hv' := (mem_normalCone_iff_forall_inner_sub_nonpos (C := C) (z := z) (v := v) hzC).1 hv
  intro x hx
  let I : Type v := {i : s // ⟪z, u i⟫_ℝ < β i}
  have hslack :
      ∃ t > 0, ∀ i : I, t * ⟪x, u i.1⟫_ℝ ≤ β i.1 - ⟪z, u i.1⟫_ℝ := by
    -- The inactive constraints have strictly positive slack, so one common scale works.
    refine exists_pos_forall_mul_le_of_pos
      (a := fun i : I ↦ ⟪x, u i.1⟫_ℝ)
      (b := fun i : I ↦ β i.1 - ⟪z, u i.1⟫_ℝ) ?_
    intro i
    exact sub_pos.mpr i.2
  rcases hslack with ⟨t, ht_pos, ht_bound⟩
  have hstep_mem : z + t • x ∈ C := by
    -- A sufficiently small step along `x` keeps every active and inactive inequality feasible.
    intro i
    by_cases hactive : ⟪z, u i⟫_ℝ = β i
    · have hpolar_i :
          x ∈ ({u i} : Set H)ᵒ⊖ := by
        simpa using Set.mem_iInter.mp hx ⟨i, hactive⟩
      have hx_ui : ⟪x, u i⟫_ℝ ≤ 0 := by
        have :=
          (Set.mem_polarCone_iff_forall_inner_nonpos.mp hpolar_i) (u i) (by simp)
        simpa [real_inner_comm] using this
      have hmul_nonpos : t * ⟪x, u i⟫_ℝ ≤ 0 := by
        exact mul_nonpos_of_nonneg_of_nonpos (le_of_lt ht_pos) hx_ui
      calc
        ⟪z + t • x, u i⟫_ℝ = ⟪z, u i⟫_ℝ + t * ⟪x, u i⟫_ℝ := by
          rw [inner_add_left, real_inner_smul_left]
        _ ≤ β i := by
          have hadd :
              ⟪z, u i⟫_ℝ + t * ⟪x, u i⟫_ℝ ≤ ⟪z, u i⟫_ℝ + 0 := by
            simpa [add_comm, add_left_comm, add_assoc] using
              add_le_add_right hmul_nonpos ⟪z, u i⟫_ℝ
          simpa using le_trans hadd (by simpa using hz i)
    · have hstrict : ⟪z, u i⟫_ℝ < β i := lt_of_le_of_ne (hz i) fun hEq ↦ hactive hEq
      let ii : I := ⟨i, hstrict⟩
      have hbound : t * ⟪x, u i⟫_ℝ ≤ β i - ⟪z, u i⟫_ℝ := by
        simpa [ii] using ht_bound ii
      calc
        ⟪z + t • x, u i⟫_ℝ = ⟪z, u i⟫_ℝ + t * ⟪x, u i⟫_ℝ := by
          rw [inner_add_left, real_inner_smul_left]
        _ ≤ β i := by
          have hadd :
              ⟪z, u i⟫_ℝ + t * ⟪x, u i⟫_ℝ ≤
                ⟪z, u i⟫_ℝ + (β i - ⟪z, u i⟫_ℝ) := by
            simpa [add_comm, add_left_comm, add_assoc] using
              add_le_add_right hbound ⟪z, u i⟫_ℝ
          simpa [sub_eq_add_neg, add_assoc] using hadd
  have hnormal := hv' (z + t • x) hstep_mem
  have hxv : ⟪x, v⟫_ℝ ≤ 0 := by
    have hscaled : ⟪t • x, v⟫_ℝ ≤ 0 := by
      simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hnormal
    have hscaled' : t * ⟪x, v⟫_ℝ ≤ 0 := by
      simpa [real_inner_smul_left] using hscaled
    by_contra hxv_pos
    have hxv_lt : 0 < ⟪x, v⟫_ℝ := lt_of_not_ge hxv_pos
    have hmul_pos : 0 < t * ⟪x, v⟫_ℝ := mul_pos ht_pos hxv_lt
    exact (not_lt_of_ge hscaled') hmul_pos
  -- Repackage the inequality as singleton-polar membership.
  rw [Set.mem_polarCone_iff_forall_inner_nonpos]
  intro y hy
  rw [Set.mem_singleton_iff.mp hy]
  simpa [real_inner_comm] using hxv

/- Source/core/bridge triage:
- `source-facing`: Example 16.55 is the normal-cone formula for a finite intersection of
  halfspaces.
- `core/canonical`: the owner objects are `Set.normalCone` and `PointedCone.hull`.
- `bridge/view`: the proof route factors the halfspace intersection through the negative orthant
  and applies the linear-pullback normal-cone computation from Corollary 16.53 together with the
  orthant normal-cone description from Example 6.42 (2).
-/

-- Proof sketch: encode the halfspace intersection as the preimage of the negative orthant under
-- the linear map `x ↦ (⟪x, u i⟫ - β i)_i`. Corollary 16.53 identifies the normal cone with the
-- adjoint image of the normal cone of that orthant, and Example 6.42(2) rewrites the latter as
-- the cone generated by the active coordinates, whose adjoint image is the cone generated by the
-- active normals `u i`.
/-- Example 16 55: if `z` belongs to the finite halfspace intersection
`{x | ∀ i : s, ⟪x, u i⟫ ≤ β i}`, then the normal cone at `z` is the pointed cone generated by
the active normals `u i` with `⟪z, u i⟫ = β i`, which is the Lean form of
`∑_{j ∈ J} ℝ₊ u_j`. -/
theorem normalCone_finiteHalfspaceIntersection_eq_pointedConeHull_activeNormals
    (s : Finset ι) (u : s → H) (β : s → ℝ) {z : H}
    (hz : ∀ i : s, ⟪z, u i⟫_ℝ ≤ β i) :
    N[({x : H | ∀ i : s, ⟪x, u i⟫_ℝ ≤ β i} : Set H)] z =
      (PointedCone.hull ℝ (u '' {i : s | ⟪z, u i⟫_ℝ = β i}) : Set H) := by
  classical
  let C : Set H := {x : H | ∀ i : s, ⟪x, u i⟫_ℝ ≤ β i}
  let A : Type v := {i : s // ⟪z, u i⟫_ℝ = β i}
  let uA : A → H := fun i ↦ u i.1
  have hzC : z ∈ C := hz
  have hactive_image : u '' {i : s | ⟪z, u i⟫_ℝ = β i} = Set.range uA := by
    ext x
    constructor
    · rintro ⟨i, hi, rfl⟩
      exact ⟨⟨i, hi⟩, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i.1, i.2, rfl⟩
  ext v
  constructor
  · intro hv
    -- Route correction: use the local finite-family bipolar criterion and prove its polar premise
    -- by a small feasible step from `z` along any active-polar direction. The Chapter 6
    -- finite-family bridge then converts that polar containment into cone membership.
    rw [hactive_image]
    exact
      (Example16_55Support.mem_pointedConeHull_range_iff_iInter_polarCone_singleton_subset
        (x := uA) (y := v)).2 <|
        active_polar_subset_singleton_polar_of_mem_normalCone s u β hz hv
  · intro hv
    rw [hactive_image] at hv
    rw [(mem_normalCone_iff_forall_inner_sub_nonpos (C := C) (z := z) (v := v) hzC)]
    rcases
      (Example16_55Support.mem_pointedConeHull_range_iff_exists_nonneg_sum
        (x := uA) (y := v)).mp hv with ⟨a, ha_sum⟩
    intro y hy
    -- Expand `v` through the finite coefficient formula and sum the active inequalities against
    -- the nonnegative coefficients.
    calc
      ⟪y - z, v⟫_ℝ = ⟪∑ i : A, (a i : ℝ) • uA i, y - z⟫_ℝ := by
        rw [← ha_sum, real_inner_comm]
      _ = ∑ i : A, ⟪(a i : ℝ) • uA i, y - z⟫_ℝ := by
        simpa using (sum_inner (s := (Finset.univ : Finset A))
          (f := fun i : A ↦ (a i : ℝ) • uA i) (y - z))
      _ ≤ ∑ _i : A, (0 : ℝ) := by
        refine Finset.sum_le_sum ?_
        intro i hi
        have hai_nonneg : 0 ≤ (a i : ℝ) := by exact_mod_cast (a i).2
        have hstep_nonpos : ⟪y - z, uA i⟫_ℝ ≤ 0 := by
          calc
            ⟪y - z, uA i⟫_ℝ = ⟪y, uA i⟫_ℝ - ⟪z, uA i⟫_ℝ := by rw [inner_sub_left]
            _ = ⟪y, uA i⟫_ℝ - β i.1 := by rw [i.2]
            _ ≤ 0 := sub_nonpos.mpr (hy i.1)
        have hstep_nonpos' : ⟪uA i, y - z⟫_ℝ ≤ 0 := by
          simpa [real_inner_comm] using hstep_nonpos
        calc
          ⟪(a i : ℝ) • uA i, y - z⟫_ℝ = (a i : ℝ) * ⟪uA i, y - z⟫_ℝ := by
            rw [real_inner_smul_left]
          _ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hai_nonneg hstep_nonpos'
      _ = 0 := by simp

end
