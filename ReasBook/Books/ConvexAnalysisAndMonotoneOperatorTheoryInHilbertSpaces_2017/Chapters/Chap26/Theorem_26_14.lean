/-- Helper for Theorem 26.14: on a bounded orbit, a localized modulus lower bound against a
strongly null companion sequence forces strong convergence to the base point. -/
theorem tendsto_of_inner_ge_modulus_of_bounded_of_tendsto_zero
    {z u : ℕ → H} {p : H} {φ : NNReal → EReal}
    (hz_bounded : Bornology.IsBounded (Set.range z))
    (hu_tendsto : Tendsto u atTop (𝓝 (0 : H)))
    (hφ_mono : Monotone φ)
    (hφ_zero : ∀ r : NNReal, φ r = 0 ↔ r = 0)
    (hineq : ∀ n, φ ‖z n - p‖₊ ≤ (⟪z n - p, u n⟫_ℝ : EReal)) :
    Tendsto z atTop (𝓝 p) := by
  rcases isBounded_iff_forall_norm_le.mp hz_bounded with ⟨R, hR⟩
  let C : ℝ := R + ‖p‖
  have hC : ∀ n, ‖z n - p‖ ≤ C := by
    intro n
    calc
      ‖z n - p‖ ≤ ‖z n‖ + ‖p‖ := norm_sub_le _ _
      _ ≤ R + ‖p‖ := add_le_add (hR _ (Set.mem_range_self n)) le_rfl
      _ = C := rfl
  have hmul : Tendsto (fun n ↦ C * ‖u n‖) atTop (𝓝 (0 : ℝ)) := by
    simpa [C] using hu_tendsto.norm.const_mul C
  have hinner_abs :
      Tendsto (fun n ↦ |⟪z n - p, u n⟫_ℝ|) atTop (𝓝 (0 : ℝ)) := by
    refine squeeze_zero'
      (Eventually.of_forall fun n ↦ abs_nonneg _) ?_ hmul
    exact Eventually.of_forall fun n ↦
      le_trans (abs_real_inner_le_norm _ _)
        (mul_le_mul_of_nonneg_right (hC n) (norm_nonneg _))
  have hinner_tendsto :
      Tendsto (fun n ↦ ⟪z n - p, u n⟫_ℝ) atTop (𝓝 (0 : ℝ)) := by
    rw [tendsto_zero_iff_abs_tendsto_zero]
    simpa [Function.comp] using hinner_abs
  by_contra hnot
  rw [Metric.tendsto_atTop] at hnot
  push Not at hnot
  rcases hnot with ⟨ε, hε, hbad⟩
  have hfreq : ∃ᶠ n in atTop, ε ≤ dist (z n) p := by
    rw [frequently_atTop]
    intro N
    rcases hbad N with ⟨n, hnN, hndist⟩
    exact ⟨n, hnN, hndist⟩
  rcases extraction_of_frequently_atTop hfreq with ⟨ψ, hψmono, hψdist⟩
  let εNN : NNReal := ⟨ε, hε.le⟩
  have hφ_nonneg : (0 : EReal) ≤ φ εNN := by
    rw [← (hφ_zero 0).2 rfl]
    exact hφ_mono bot_le
  have hφ_ne_zero : φ εNN ≠ 0 := by
    intro hzero
    have hεNN_zero : εNN = 0 := (hφ_zero εNN).1 hzero
    exact (ne_of_gt hε) <| by
      simpa [εNN] using congrArg (fun r : NNReal ↦ (r : ℝ)) hεNN_zero
  have hφ_subseq :
      ∀ n, φ εNN ≤ (⟪z (ψ n) - p, u (ψ n)⟫_ℝ : EReal) := by
    intro n
    have hε_le : εNN ≤ ‖z (ψ n) - p‖₊ := by
      exact_mod_cast (show ε ≤ ‖z (ψ n) - p‖ by simpa [dist_eq_norm] using hψdist n)
    exact le_trans (hφ_mono hε_le) (hineq (ψ n))
  have hφ_top : φ εNN ≠ ⊤ := ne_top_of_le_ne_top (by simp) (hφ_subseq 0)
  have hφ_bot : φ εNN ≠ ⊥ := by
    intro hbot
    rw [hbot] at hφ_nonneg
    simp at hφ_nonneg
  let c : ℝ := (φ εNN).toReal
  have hc_pos : 0 < c := by
    have hφ_pos : (0 : EReal) < φ εNN := lt_of_le_of_ne hφ_nonneg (Ne.symm hφ_ne_zero)
    simpa [c] using EReal.toReal_pos hφ_pos hφ_top
  have hinner_subseq :
      Tendsto (fun n ↦ ⟪z (ψ n) - p, u (ψ n)⟫_ℝ) atTop (𝓝 (0 : ℝ)) := by
    exact hinner_tendsto.comp hψmono.tendsto_atTop
  have hlow_real : ∀ n, c ≤ ⟪z (ψ n) - p, u (ψ n)⟫_ℝ := by
    intro n
    simpa [c] using
      EReal.toReal_le_toReal (hφ_subseq n) hφ_bot (by simp)
  rcases (Metric.tendsto_atTop.1 hinner_subseq) (c / 2) (by linarith) with ⟨N, hN⟩
  have htail : dist (⟪z (ψ N) - p, u (ψ N)⟫_ℝ) 0 < c / 2 := hN N le_rfl
  have habs_lt : |⟪z (ψ N) - p, u (ψ N)⟫_ℝ| < c / 2 := by
    simpa [dist_eq_norm] using htail
  have habs_ge : c ≤ |⟪z (ψ N) - p, u (ψ N)⟫_ℝ| := by
    exact le_trans (hlow_real N) (le_abs_self _)
  linarith

omit [CompleteSpace H] [InnerProductSpace ℝ H] in
/-- Helper for Theorem 26.14: if a localized modulus at `‖p - q‖` is forced below `0`, then the
comparison points coincide. -/
theorem eq_of_modulus_le_zero
    {p q : H} {φ : NNReal → EReal}
    (hφ_mono : Monotone φ)
    (hφ_zero : ∀ r : NNReal, φ r = 0 ↔ r = 0)
    (hineq : φ ‖p - q‖₊ ≤ 0) :
    p = q := by
  have hφ_nonneg : (0 : EReal) ≤ φ ‖p - q‖₊ := by
    rw [← (hφ_zero 0).2 rfl]
    exact hφ_mono bot_le
  have hφ_eq_zero : φ ‖p - q‖₊ = 0 := le_antisymm hineq hφ_nonneg
  have hdist_zero : ‖p - q‖₊ = 0 := (hφ_zero _).1 hφ_eq_zero
  have hnorm_zero : ‖p - q‖ = 0 := by
    simpa using congrArg (fun r : NNReal ↦ (r : ℝ)) hdist_zero
  exact sub_eq_zero.mp (norm_eq_zero.mp hnorm_zero)

/-- Clause (ii) of Theorem 26.14: under the hypotheses of clause (i), if `x ∈ zer (A + B)`, then
`(B x_n)` converges strongly to `B x`, and `B x` is the unique dual solution, formalized by
`dual_inclusion_solution_set A B.toSetValuedOperator = {B x}`. -/
theorem forwardBackwardAlgorithm_B_tendsto_to_unique_dual_solution
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H)
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (hdiv :
      Tendsto
        (fun N ↦
          Finset.sum (Finset.range N)
            (fun n ↦ lam n * (forwardBackwardRelaxationBound beta gamma - lam n)))
        atTop atTop)
    (x0 : H) {x : H} (hx : x ∈ primal_inclusion_solution_set A B.toSetValuedOperator) :
    Tendsto (fun n ↦ B (forwardBackwardIteration A hA B gamma lam x0 n)) atTop (𝓝 (B x)) ∧
      dual_inclusion_solution_set A B.toSetValuedOperator = ({B x} : Set H) := by
  let T := forwardBackwardSplittingOperator A hA B gamma
  let xSeq := forwardBackwardIteration A hA B gamma lam x0
  have hres :
      Tendsto (fun n ↦ T (xSeq n) - xSeq n) atTop (𝓝 (0 : H)) := by
    -- Specialize Proposition 5.16 to the forward-backward map.
    simpa [T, xSeq] using
      forwardBackwardResidualTendstoZero
        A hA B beta gamma hB hgamma lam hlam hdiv ⟨x, hx⟩ x0
  have hfejer :
      FejerMonotone (primal_inclusion_solution_set A B.toSetValuedOperator) xSeq := by
    -- Clause (ii) reuses the same Fejér monotonicity package as clause (i).
    simpa [xSeq] using forwardBackwardFejerMonotone A hA B beta gamma hB hgamma lam hlam x0
  have hbound : ∀ n, ‖xSeq n - x‖ ≤ ‖xSeq 0 - x‖ := by
    intro n
    simpa [xSeq, dist_eq_norm] using hfejer.dist_antitone_of_mem hx (Nat.zero_le n)
  have hgap :
      ∀ n,
        ((gamma : ℝ) * (beta : ℝ)) * ‖B (xSeq n) - B x‖ ^ 2 ≤
          (1 + (gamma : ℝ) / (beta : ℝ)) * ‖xSeq 0 - x‖ * ‖T (xSeq n) - xSeq n‖ := by
    intro n
    have hcore :=
      forwardBackwardDualGapSqLe A hA B beta gamma hB hgamma (u := xSeq n) hx
    exact le_trans hcore <|
      by
        have hdiv_nonneg : 0 ≤ (gamma : ℝ) / (beta : ℝ) := by
          rw [div_eq_mul_inv]
          exact mul_nonneg gamma.2.le (inv_nonneg.mpr beta.2.le)
        have hfac_nonneg : 0 ≤ 1 + (gamma : ℝ) / (beta : ℝ) := by
          linarith
        have hprod :
            ‖xSeq n - x‖ * ‖T (xSeq n) - xSeq n‖ ≤
              ‖xSeq 0 - x‖ * ‖T (xSeq n) - xSeq n‖ := by
          exact mul_le_mul_of_nonneg_right (hbound n) (norm_nonneg _)
        simpa [mul_assoc] using mul_le_mul_of_nonneg_left hprod hfac_nonneg
  have hsq_tendsto :
      Tendsto (fun n ↦ ‖B (xSeq n) - B x‖ ^ 2) atTop (𝓝 (0 : ℝ)) := by
    have hconst_pos : 0 < (gamma : ℝ) * (beta : ℝ) := mul_pos gamma.2 beta.2
    have hconst_inv_nonneg : 0 ≤ ((gamma : ℝ) * (beta : ℝ))⁻¹ := by
      positivity
    have hright :
        Tendsto
          (fun n ↦
            (1 + (gamma : ℝ) / (beta : ℝ)) * ‖xSeq 0 - x‖ * ‖T (xSeq n) - xSeq n‖)
          atTop (𝓝 (0 : ℝ)) := by
      simpa using hres.norm.const_mul ((1 + (gamma : ℝ) / (beta : ℝ)) * ‖xSeq 0 - x‖)
    have hupper :
        Tendsto
          (fun n ↦
            (((gamma : ℝ) * (beta : ℝ))⁻¹) *
              ((1 + (gamma : ℝ) / (beta : ℝ)) * ‖xSeq 0 - x‖ *
                ‖T (xSeq n) - xSeq n‖))
          atTop (𝓝 (0 : ℝ)) := by
      simpa [mul_assoc] using hright.const_mul (((gamma : ℝ) * (beta : ℝ))⁻¹)
    have hgap' :
        ∀ n,
          ‖B (xSeq n) - B x‖ ^ 2 ≤
            (((gamma : ℝ) * (beta : ℝ))⁻¹) *
              ((1 + (gamma : ℝ) / (beta : ℝ)) * ‖xSeq 0 - x‖ *
                ‖T (xSeq n) - xSeq n‖) := by
      intro n
      have hmul := mul_le_mul_of_nonneg_left (hgap n) hconst_inv_nonneg
      have hleft :
          (((gamma : ℝ) * (beta : ℝ))⁻¹) *
              (((gamma : ℝ) * (beta : ℝ)) * ‖B (xSeq n) - B x‖ ^ 2) =
            ‖B (xSeq n) - B x‖ ^ 2 := by
        have hunit :
            (((gamma : ℝ) * (beta : ℝ))⁻¹) * ((gamma : ℝ) * (beta : ℝ)) = (1 : ℝ) := by
          exact inv_mul_cancel₀ hconst_pos.ne'
        calc
          (((gamma : ℝ) * (beta : ℝ))⁻¹) *
              (((gamma : ℝ) * (beta : ℝ)) * ‖B (xSeq n) - B x‖ ^ 2) =
              ((((gamma : ℝ) * (beta : ℝ))⁻¹) * ((gamma : ℝ) * (beta : ℝ))) *
                ‖B (xSeq n) - B x‖ ^ 2 := by ring
          _ = (1 : ℝ) * ‖B (xSeq n) - B x‖ ^ 2 := by rw [hunit]
          _ = ‖B (xSeq n) - B x‖ ^ 2 := by ring
      rw [hleft] at hmul
      simpa [div_eq_mul_inv, mul_assoc, mul_left_comm, mul_comm] using hmul
    refine squeeze_zero' (Eventually.of_forall fun n ↦ sq_nonneg _) (Eventually.of_forall hgap')
      hupper
  have hnorm_tendsto :
      Tendsto (fun n ↦ ‖B (xSeq n) - B x‖) atTop (𝓝 (0 : ℝ)) := by
    -- Taking square roots converts the squared-norm estimate into norm convergence.
    have hsqrt_tendsto :
        Tendsto (fun n ↦ Real.sqrt (‖B (xSeq n) - B x‖ ^ 2)) atTop (𝓝 (Real.sqrt 0)) := by
      exact Real.continuous_sqrt.continuousAt.tendsto.comp hsq_tendsto
    simpa [Real.sqrt_zero, Real.sqrt_sq_eq_abs] using hsqrt_tendsto
  have hBx_tendsto :
      Tendsto (fun n ↦ B (xSeq n) - B x) atTop (𝓝 (0 : H)) := by
    exact (tendsto_zero_iff_norm_tendsto_zero).mpr hnorm_tendsto
  have hB_tendsto : Tendsto (fun n ↦ B (xSeq n)) atTop (𝓝 (B x)) := by
    -- Translate convergence of the differences back to the original orbit.
    have hsum := hBx_tendsto.add
      (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ B x) atTop (𝓝 (B x)))
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hsum
  have hdual_singleton :
      dual_inclusion_solution_set A B.toSetValuedOperator = ({B x} : Set H) := by
    ext u
    constructor
    · intro hu
      rw [dual_inclusion_solution_set_eq_image_primal_inclusion_solution_set_of_forwardBackward
        A B] at hu
      rcases hu with ⟨y, hy, rfl⟩
      have hy_eq : B y = B x := eq_dualValue_of_mem_primalSolutions A hA B beta hB hy hx
      simp [hy_eq]
    · intro hu
      rw [Set.mem_singleton_iff] at hu
      subst u
      rw [dual_inclusion_solution_set_eq_image_primal_inclusion_solution_set_of_forwardBackward
        A B]
      exact ⟨x, hx, rfl⟩
  exact ⟨hB_tendsto, hdual_singleton⟩

/-- Clause (iii) of Theorem 26.14: under the hypotheses of clause (i), if either `A` is uniformly
every nonempty bounded subset of `A.dom` or `B` is uniformly monotone on every nonempty bounded
subset of `H`, then the forward-backward orbit converges strongly to the unique point of
`zer (A + B)`. -/
theorem
    forwardBackwardAlgorithm_tendsto_to_unique_zero_of_uniformlyMonotoneOnEveryBoundedSubset
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H)
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (hdiv :
      Tendsto
        (fun N ↦
          Finset.sum (Finset.range N)
            (fun n ↦ lam n * (forwardBackwardRelaxationBound beta gamma - lam n)))
        atTop atTop)
    (hzero : (primal_inclusion_solution_set A B.toSetValuedOperator).Nonempty)
    (hUniform :
      (∀ S : Set H,
        S.Nonempty → Bornology.IsBounded S → S ⊆ A.dom → A.IsUniformlyMonotoneOn S) ∨
        ∀ S : Set H,
          S.Nonempty → Bornology.IsBounded S →
            B.toSetValuedOperator.IsUniformlyMonotoneOn S)
    (x0 : H) :
    ∃ p ∈ primal_inclusion_solution_set A B.toSetValuedOperator,
      Tendsto (forwardBackwardIteration A hA B gamma lam x0) atTop (𝓝 p) ∧
        primal_inclusion_solution_set A B.toSetValuedOperator = ({p} : Set H) := by
  let T := forwardBackwardSplittingOperator A hA B gamma
  let xSeq := forwardBackwardIteration A hA B gamma lam x0
  rcases
      forwardBackwardAlgorithm_tendsto_weakly_to_zeroSet
        A hA B beta gamma hB hgamma lam hlam hdiv hzero x0 with
    ⟨p, hp, hpweak⟩
  have hBp_tendsto :
      Tendsto (fun n ↦ B (xSeq n)) atTop (𝓝 (B p)) := by
    -- Clause (ii) supplies strong convergence of the dual orbit.
    simpa [xSeq] using
      (forwardBackwardAlgorithm_B_tendsto_to_unique_dual_solution
        A hA B beta gamma hB hgamma lam hlam hdiv x0 hp).1
  have hres :
      Tendsto (fun n ↦ T (xSeq n) - xSeq n) atTop (𝓝 (0 : H)) := by
    -- Reuse the Proposition 5.16 residual estimate from the same forward-backward data.
    simpa [T, xSeq] using
      forwardBackwardResidualTendstoZero
        A hA B beta gamma hB hgamma lam hlam hdiv hzero x0
  have hx_bounded : Bornology.IsBounded (Set.range xSeq) := by
    -- Weak convergence already gives boundedness of the orbit.
    exact bounded_range_of_tendsto_weakly hpweak
  have hpA : -B p ∈ A p := neg_mem_A_of_mem_primalSolution A B hp
  have hx_tendsto :
      Tendsto xSeq atTop (𝓝 p) := by
    rcases hUniform with hUniformA | hUniformB
    · let z : ℕ → H := fun n ↦ T (xSeq n)
      have hsub_tendsto : Tendsto (fun n ↦ xSeq n - z n) atTop (𝓝 (0 : H)) := by
        -- The residual `zₙ - xₙ → 0` is equivalent to `xₙ - zₙ → 0`.
        simpa [z, T, sub_eq_add_neg] using hres.neg
      have hsub_bounded : Bornology.IsBounded (Set.range fun n ↦ xSeq n - z n) :=
        Metric.isBounded_range_of_tendsto _ hsub_tendsto
      have hz_bounded : Bornology.IsBounded (Set.range z) := by
        rcases isBounded_iff_forall_norm_le.mp hx_bounded with ⟨Rx, hRx⟩
        rcases isBounded_iff_forall_norm_le.mp hsub_bounded with ⟨Rr, hRr⟩
        refine isBounded_iff_forall_norm_le.mpr ?_
        refine ⟨Rx + Rr, ?_⟩
        rintro w ⟨n, rfl⟩
        have hz_eq : xSeq n - (xSeq n - z n) = z n := by
          abel_nf
        calc
          ‖z n‖ = ‖xSeq n - (xSeq n - z n)‖ := by rw [hz_eq]
          _ ≤ ‖xSeq n‖ + ‖xSeq n - z n‖ := norm_sub_le _ _
          _ ≤ Rx + Rr := by
            exact add_le_add (hRx _ (Set.mem_range_self n)) (hRr _ (Set.mem_range_self n))
      let S : Set H := Set.insert p (Set.range z)
      have hpS : p ∈ S := by
        exact Set.mem_insert p (Set.range z)
      have hz_memS : ∀ n, z n ∈ S := by
        intro n
        exact Set.mem_insert_of_mem p (Set.mem_range_self n)
      have hS_nonempty : S.Nonempty := ⟨p, hpS⟩
      have hS_bounded : Bornology.IsBounded S := by
        exact (Bornology.isBounded_insert (x := p) (s := Set.range z)).2 hz_bounded
      have hz_dom : ∀ n, z n ∈ A.dom := by
        intro n
        exact (SetValuedOperator.mem_dom_iff A (z n)).2
          ⟨(gamma : ℝ)⁻¹ • (xSeq n - (gamma : ℝ) • B (xSeq n) - z n), by
            simpa [z, T] using forwardBackwardSplitting_mem_A_of_apply A hA B gamma (xSeq n)⟩
      have hS_subA : S ⊆ A.dom := by
        intro q hq
        rcases Set.mem_insert_iff.mp hq with hq | hq
        · subst q
          exact (SetValuedOperator.mem_dom_iff A p).2 ⟨-B p, hpA⟩
        · rcases hq with ⟨n, rfl⟩
          exact hz_dom n
      rcases hUniformA S hS_nonempty hS_bounded hS_subA with ⟨φ, hφ⟩
      let u : ℕ → H := fun n ↦ (gamma : ℝ)⁻¹ • (xSeq n - z n) - (B (xSeq n) - B p)
      have hu_tendsto : Tendsto u atTop (𝓝 (0 : H)) := by
        have hscaled :
            Tendsto (fun n ↦ (gamma : ℝ)⁻¹ • (xSeq n - z n)) atTop (𝓝 (0 : H)) := by
          simpa using hsub_tendsto.const_smul ((gamma : ℝ)⁻¹)
        have hBdiff :
            Tendsto (fun n ↦ B (xSeq n) - B p) atTop (𝓝 (0 : H)) := by
          simpa using hBp_tendsto.sub
            (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ B p) atTop (𝓝 (B p)))
        simpa [u] using hscaled.sub hBdiff
      have hineq_seq :
          ∀ n, φ ‖z n - p‖₊ ≤ (⟪z n - p, u n⟫_ℝ : EReal) := by
        intro n
        have hAz :
            (gamma : ℝ)⁻¹ • (xSeq n - (gamma : ℝ) • B (xSeq n) - z n) ∈ A (z n) := by
          simpa [z, T] using forwardBackwardSplitting_mem_A_of_apply A hA B gamma (xSeq n)
        -- Route correction: keep the graph witness in its canonical resolvent form, then rewrite
        -- the pairing once into the companion sequence `uₙ`.
        simpa [u, z, sub_eq_add_neg, smul_sub, smul_add, smul_smul, gamma.2.ne', add_assoc,
          add_left_comm, add_comm] using hφ.ineq (hz_memS n) hpS hAz hpA
      have hz_tendsto : Tendsto z atTop (𝓝 p) := by
        exact tendsto_of_inner_ge_modulus_of_bounded_of_tendsto_zero
          hz_bounded hu_tendsto hφ.monotone hφ.modulus_eq_zero_iff hineq_seq
      have hsum :
          Tendsto (fun n ↦ (xSeq n - z n) + z n) atTop (𝓝 ((0 : H) + p)) :=
        hsub_tendsto.add hz_tendsto
      have hsplit : (fun n ↦ (xSeq n - z n) + z n) = xSeq := by
        funext n
        abel_nf
      simpa [hsplit] using hsum
    · let S : Set H := Set.insert p (Set.range xSeq)
      have hpS : p ∈ S := by
        exact Set.mem_insert p (Set.range xSeq)
      have hx_memS : ∀ n, xSeq n ∈ S := by
        intro n
        exact Set.mem_insert_of_mem p (Set.mem_range_self n)
      have hS_nonempty : S.Nonempty := ⟨p, hpS⟩
      have hS_bounded : Bornology.IsBounded S := by
        exact (Bornology.isBounded_insert (x := p) (s := Set.range xSeq)).2 hx_bounded
      rcases hUniformB S hS_nonempty hS_bounded with ⟨φ, hφ⟩
      let u : ℕ → H := fun n ↦ B (xSeq n) - B p
      have hu_tendsto : Tendsto u atTop (𝓝 (0 : H)) := by
        simpa [u] using hBp_tendsto.sub
          (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ B p) atTop (𝓝 (B p)))
      have hineq_seq :
          ∀ n, φ ‖xSeq n - p‖₊ ≤ (⟪xSeq n - p, u n⟫_ℝ : EReal) := by
        intro n
        have hxB : B (xSeq n) ∈ B.toSetValuedOperator (xSeq n) := by
          simp [Function.toSetValuedOperator_apply]
        have hpB : B p ∈ B.toSetValuedOperator p := by
          simp [Function.toSetValuedOperator_apply]
        simpa [u, Function.toSetValuedOperator_apply] using hφ.ineq (hx_memS n) hpS hxB hpB
      exact tendsto_of_inner_ge_modulus_of_bounded_of_tendsto_zero
        hx_bounded hu_tendsto hφ.monotone hφ.modulus_eq_zero_iff hineq_seq
  have hsingle :
      primal_inclusion_solution_set A B.toSetValuedOperator = ({p} : Set H) := by
    ext q
    constructor
    · intro hq
      have hBqp : B q = B p := eq_dualValue_of_mem_primalSolutions A hA B beta hB hq hp
      rcases hUniform with hUniformA | hUniformB
      · let Sq : Set H := Set.insert p ({q} : Set H)
        have hpSq : p ∈ Sq := by
          exact Set.mem_insert p ({q} : Set H)
        have hqSq : q ∈ Sq := by
          exact Set.mem_insert_of_mem p (by simp)
        have hSq_nonempty : Sq.Nonempty := ⟨p, hpSq⟩
        have hSq_bounded : Bornology.IsBounded Sq := by
          exact ((Set.finite_singleton q).insert p).isBounded
        have hqA : -B q ∈ A q := neg_mem_A_of_mem_primalSolution A B hq
        have hSq_subA : Sq ⊆ A.dom := by
          intro r hr
          rcases Set.mem_insert_iff.mp hr with hr | hr
          · subst r
            exact (SetValuedOperator.mem_dom_iff A p).2 ⟨-B p, hpA⟩
          · rcases Set.mem_singleton_iff.mp hr with hqr
            subst r
            exact (SetValuedOperator.mem_dom_iff A q).2 ⟨-B q, hqA⟩
        rcases hUniformA Sq hSq_nonempty hSq_bounded hSq_subA with ⟨φ, hφ⟩
        have hineq :
            φ ‖q - p‖₊ ≤ (0 : EReal) := by
          have hAineq :
              φ ‖q - p‖₊ ≤ (⟪q - p, (-B q) - (-B p)⟫_ℝ : EReal) := by
            simpa using hφ.ineq hqSq hpSq hqA hpA
          have hupper :
              (⟪q - p, (-B q) - (-B p)⟫_ℝ : EReal) ≤ 0 := by
            have hupper_real : ⟪q - p, (-B q) - (-B p)⟫_ℝ ≤ 0 := by
              simp [hBqp]
            exact_mod_cast hupper_real
          exact le_trans hAineq hupper
        have hqp : q = p := eq_of_modulus_le_zero hφ.monotone hφ.modulus_eq_zero_iff hineq
        simp [hqp]
      · let Sq : Set H := Set.insert p ({q} : Set H)
        have hpSq : p ∈ Sq := by
          exact Set.mem_insert p ({q} : Set H)
        have hqSq : q ∈ Sq := by
          exact Set.mem_insert_of_mem p (by simp)
        have hSq_nonempty : Sq.Nonempty := ⟨p, hpSq⟩
        have hSq_bounded : Bornology.IsBounded Sq := by
          exact ((Set.finite_singleton q).insert p).isBounded
        rcases hUniformB Sq hSq_nonempty hSq_bounded with ⟨φ, hφ⟩
        have hineq :
            φ ‖q - p‖₊ ≤ (0 : EReal) := by
          have hqB : B q ∈ B.toSetValuedOperator q := by
            simp [Function.toSetValuedOperator_apply]
          have hpB' : B p ∈ B.toSetValuedOperator p := by
            simp [Function.toSetValuedOperator_apply]
          have hBineq :
              φ ‖q - p‖₊ ≤ (⟪q - p, B q - B p⟫_ℝ : EReal) := by
            simpa [Function.toSetValuedOperator_apply] using hφ.ineq hqSq hpSq hqB hpB'
          have hupper :
              (⟪q - p, B q - B p⟫_ℝ : EReal) ≤ 0 := by
            have hupper_real : ⟪q - p, B q - B p⟫_ℝ ≤ 0 := by
              simp [hBqp]
            exact_mod_cast hupper_real
          exact le_trans hBineq hupper
        have hqp : q = p := eq_of_modulus_le_zero hφ.monotone hφ.modulus_eq_zero_iff hineq
        simp [hqp]
    · intro hq
      rw [Set.mem_singleton_iff] at hq
      simpa [hq] using hp
  exact ⟨p, hp, by simpa [xSeq] using hx_tendsto, hsingle⟩

/-- Theorem 26.14. Under the forward-backward hypotheses, the orbit converges weakly to a primal
solution, the dual orbit converges strongly to the unique dual solution, and the additional
uniform monotonicity assumption forces strong convergence to the unique primal solution. -/
theorem forwardBackwardAlgorithm
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H)
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (hdiv :
      Tendsto
        (fun N ↦
          Finset.sum (Finset.range N)
            (fun n ↦ lam n * (forwardBackwardRelaxationBound beta gamma - lam n)))
        atTop atTop)
    (hzero : (primal_inclusion_solution_set A B.toSetValuedOperator).Nonempty)
    (x0 : H) :
    (∃ p ∈ primal_inclusion_solution_set A B.toSetValuedOperator,
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (forwardBackwardIteration A hA B gamma lam x0 n))
        atTop (𝓝 (toWeakSpace ℝ H p))) ∧
      (∀ x : H,
        x ∈ primal_inclusion_solution_set A B.toSetValuedOperator →
          Tendsto
              (fun n ↦ B (forwardBackwardIteration A hA B gamma lam x0 n))
              atTop (𝓝 (B x)) ∧
            dual_inclusion_solution_set A B.toSetValuedOperator = ({B x} : Set H)) ∧
      (((∀ S : Set H,
          S.Nonempty → Bornology.IsBounded S → S ⊆ A.dom → A.IsUniformlyMonotoneOn S) ∨
          ∀ S : Set H,
            S.Nonempty → Bornology.IsBounded S →
              B.toSetValuedOperator.IsUniformlyMonotoneOn S) →
        ∃ p ∈ primal_inclusion_solution_set A B.toSetValuedOperator,
          Tendsto (forwardBackwardIteration A hA B gamma lam x0) atTop (𝓝 p) ∧
            primal_inclusion_solution_set A B.toSetValuedOperator = ({p} : Set H)) := by
  refine ⟨?_, ?_⟩
  · -- Clause (i) is already proved in the dedicated weak convergence theorem.
    exact
      forwardBackwardAlgorithm_tendsto_weakly_to_zeroSet
        A hA B beta gamma hB hgamma lam hlam hdiv hzero x0
  · refine ⟨?_, ?_⟩
    · intro x hx
      -- Clause (ii) specializes the dual convergence theorem to the chosen primal solution.
      exact
        forwardBackwardAlgorithm_B_tendsto_to_unique_dual_solution
          A hA B beta gamma hB hgamma lam hlam hdiv x0 hx
    · intro hUniform
      -- Clause (iii) is the strong convergence upgrade under uniform monotonicity.
      exact
        forwardBackwardAlgorithm_tendsto_to_unique_zero_of_uniformlyMonotoneOnEveryBoundedSubset
          A hA B beta gamma hB hgamma lam hlam hdiv hzero hUniform x0

end

end SetValuedOperator
