namespace SetValuedOperator

noncomputable section

/- Source/core/bridge triage:
- `source-facing`: Theorem 26.14 is the relaxed forward-backward orbit `(26.53)` and its
  weak/strong convergence conclusions.
- `core/canonical`: the verified local owners are `forwardBackwardSplittingOperator`,
  `relaxedOperatorIteration`, `primal_inclusion_solution_set`, and
  `dual_inclusion_solution_set`.
- `bridge/view`: the source scalar `δ = 2 - γ / (2β)` is exposed explicitly as
  `forwardBackwardRelaxationBound`.
Semantic recall: `lean_leansearch` only surfaced generic fixed-point iteration material for this
item, so this file follows the verified Chapter 26/5/22 owners directly. -/

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The relaxation bound `δ = 2 - γ / (2β)` used in Theorem 26.14. -/
def forwardBackwardRelaxationBound (beta gamma : PosReal) : ℝ :=
  2 - (gamma : ℝ) / (2 * (beta : ℝ))

/-- The relaxed forward-backward orbit generated by `A`, `B`, `γ`, `lam`, and `x0`. -/
def forwardBackwardIteration
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H) (gamma : PosReal)
    (lam : ℕ → ℝ) (x0 : H) : ℕ → H :=
  relaxedOperatorIteration (fun _ ↦ forwardBackwardSplittingOperator A hA B gamma) lam x0

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- Helper for Theorem 26.14: every primal forward-backward solution `x` carries the canonical
graph witness `-B x ∈ A x`. -/
theorem neg_mem_A_of_mem_primalSolution
    (A : SetValuedOperator H H) (B : H → H) {x : H}
    (hx : x ∈ primal_inclusion_solution_set A B.toSetValuedOperator) :
    -B x ∈ A x := by
  -- Unpack the primal inclusion and isolate the unique singleton-valued `B`-fiber.
  have hx_zero : (0 : H) ∈ A x + B.toSetValuedOperator x := by
    simpa using hx
  rw [Function.toSetValuedOperator_apply, Set.mem_add] at hx_zero
  rcases hx_zero with ⟨a, ha, b, hb, hab⟩
  rw [Set.mem_singleton_iff] at hb
  subst b
  have ha_eq : a = -B x := by
    simpa [eq_neg_iff_add_eq_zero] using hab
  simpa [ha_eq] using ha

/-- Helper for Theorem 26.14: the forward-backward step produces the canonical graph witness for
`A` at the resolvent point. -/
theorem forwardBackwardSplitting_mem_A_of_apply
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H) (gamma : PosReal)
    (x : H) :
    (gamma : ℝ)⁻¹ •
        (x - (gamma : ℝ) • B x - forwardBackwardSplittingOperator A hA B gamma x) ∈
      A (forwardBackwardSplittingOperator A hA B gamma x) := by
  have hz_res :
      forwardBackwardSplittingOperator A hA B gamma x ∈
        J[((gamma : ℝ) • A)] (x - (gamma : ℝ) • B x) := by
    -- Rewrite the resolvent point as the unique element of the resolvent singleton.
    rw [forwardBackwardSplittingOperator_apply,
      resolvent_smul_eq_singleton_resolventMap_of_maximal A hA gamma
        (x - (gamma : ℝ) • B x)]
    simp
  have hz_scaled :
      x - (gamma : ℝ) • B x - forwardBackwardSplittingOperator A hA B gamma x ∈
        (gamma : ℝ) • A (forwardBackwardSplittingOperator A hA B gamma x) :=
    (mem_resolvent_smul_iff_sub_mem_smul A gamma
      (x - (gamma : ℝ) • B x) (forwardBackwardSplittingOperator A hA B gamma x)).1 hz_res
  -- Convert the scaled membership back to the graph-side normal form used in the proof.
  rw [Set.mem_smul_set_iff_inv_smul_mem₀ gamma.2.ne'] at hz_scaled
  simpa [smul_sub, smul_add, smul_smul, gamma.2.ne', sub_eq_add_neg, add_assoc, add_comm,
    add_left_comm] using hz_scaled

omit [CompleteSpace H] in
/-- Helper for Theorem 26.14: two primal solutions have the same dual value under `B`. -/
theorem eq_dualValue_of_mem_primalSolutions
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H)
    (beta : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    {x y : H}
    (hx : x ∈ primal_inclusion_solution_set A B.toSetValuedOperator)
    (hy : y ∈ primal_inclusion_solution_set A B.toSetValuedOperator) :
    B x = B y := by
  have hxA : -B x ∈ A x := neg_mem_A_of_mem_primalSolution A B hx
  have hyA : -B y ∈ A y := neg_mem_A_of_mem_primalSolution A B hy
  have hmonoA :
      0 ≤ ⟪x - y, (-B x) - (-B y)⟫_ℝ := by
    exact (SetValuedOperator.isMonotone_iff A).1 (SetValuedOperator.Maximal.isMonotone hA) hxA hyA
  have hcoco :
      (beta : ℝ) * ‖B x - B y‖ ^ 2 ≤ ⟪x - y, B x - B y⟫_ℝ := by
    simpa using hB.ineq ⟨x, by simp⟩ ⟨y, by simp⟩
  have hupper : ⟪x - y, B x - B y⟫_ℝ ≤ 0 := by
    have hneg :
        ⟪x - y, (-B x) - (-B y)⟫_ℝ = -⟪x - y, B x - B y⟫_ℝ := by
      have hterm : (-B x) - (-B y) = -(B x - B y) := by
        abel_nf
      rw [hterm, inner_neg_right]
    nlinarith [hmonoA]
  have hsq_zero : ‖B x - B y‖ ^ 2 = 0 := by
    nlinarith [hcoco, hupper, hB.pos]
  exact sub_eq_zero.mp (norm_eq_zero.mp (eq_zero_of_pow_eq_zero hsq_zero))

omit [CompleteSpace H] in
/-- Helper for Theorem 26.14: every averaged self-map on `H` is nonexpansive. -/
theorem lipschitzWithOne_of_averaged
    {α : ℝ} {T : H → H} (hT : Averaged α T) :
    LipschitzWith 1 T := by
  rcases averagedWith_iff.mp hT with ⟨hα, R, hR, hT_eq⟩
  have hα_nonneg : 0 ≤ α := hα.1.le
  have h_one_sub_nonneg : 0 ≤ 1 - α := sub_nonneg.mpr hα.2.le
  -- Use the affine representation of an averaged map and the nonexpansive companion estimate.
  refine LipschitzWith.of_dist_le_mul ?_
  intro x y
  have hRxy : ‖R ⟨x, by simp⟩ - R ⟨y, by simp⟩‖ ≤ ‖x - y‖ := by
    simpa [Subtype.dist_eq, dist_eq_norm] using
      hR.dist_le_mul ⟨x, by simp⟩ ⟨y, by simp⟩
  have hxy :
      T x - T y =
        (1 - α) • (x - y) + α • (R ⟨x, by simp⟩ - R ⟨y, by simp⟩) := by
    have hTx : T x = (1 - α) • x + α • R ⟨x, by simp⟩ := by
      simpa using
        congrArg (fun f : {z : H // z ∈ (Set.univ : Set H)} → H ↦ f ⟨x, by simp⟩) hT_eq
    have hTy : T y = (1 - α) • y + α • R ⟨y, by simp⟩ := by
      simpa using
        congrArg (fun f : {z : H // z ∈ (Set.univ : Set H)} → H ↦ f ⟨y, by simp⟩) hT_eq
    calc
      T x - T y =
          ((1 - α) • x + α • R ⟨x, by simp⟩) -
            ((1 - α) • y + α • R ⟨y, by simp⟩) := by
              rw [hTx, hTy]
      _ = (1 - α) • (x - y) + α • (R ⟨x, by simp⟩ - R ⟨y, by simp⟩) := by
            simp [sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
  simpa [dist_eq_norm, one_mul] using
    calc
      ‖T x - T y‖ =
          ‖(1 - α) • (x - y) + α • (R ⟨x, by simp⟩ - R ⟨y, by simp⟩)‖ := by
            rw [hxy]
      _ ≤ ‖(1 - α) • (x - y)‖ + ‖α • (R ⟨x, by simp⟩ - R ⟨y, by simp⟩)‖ := norm_add_le _ _
      _ = (1 - α) * ‖x - y‖ + α * ‖R ⟨x, by simp⟩ - R ⟨y, by simp⟩‖ := by
            rw [norm_smul, norm_smul]
            simp [Real.norm_eq_abs, abs_of_nonneg h_one_sub_nonneg, abs_of_nonneg hα_nonneg]
      _ ≤ (1 - α) * ‖x - y‖ + α * ‖x - y‖ := by
            nlinarith [hRxy, norm_nonneg (x - y)]
      _ = ‖x - y‖ := by ring

/-- Clause (i) of Theorem 26.14: if `A` is maximally monotone, `B` is `β`-cocoercive on `H`,
`0 < γ < 2β`, the relaxation parameters `lam n` lie in `[0, δ]` with
`δ = 2 - γ / (2β)`, `∑ lam n * (δ - lam n) = +∞`, and `zer (A + B)` is nonempty, then the
forward-backward orbit `(26.53)` converges weakly to a point of `zer (A + B)`. -/
theorem forwardBackwardAlgorithm_tendsto_weakly_to_zeroSet
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H)
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (hdiv :
      Tendsto
        (fun N ↦
          Finset.sum (Finset.range N)
            (fun n ↦ lam n * (forwardBackwardRelaxationBound beta gamma - lam n)))
        atTop atTop)
    (hzero : (primal_inclusion_solution_set A B.toSetValuedOperator).Nonempty) (x0 : H) :
    ∃ p ∈ primal_inclusion_solution_set A B.toSetValuedOperator,
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (forwardBackwardIteration A hA B gamma lam x0 n))
        atTop (𝓝 (toWeakSpace ℝ H p)) := by
  let α : ℝ := 2 * (beta : ℝ) / (4 * (beta : ℝ) - (gamma : ℝ))
  let T := forwardBackwardSplittingOperator A hA B gamma
  have hT : Averaged α T := by
    -- Proposition 26.1 already packages the forward-backward operator as averaged.
    simpa [α, T] using
      forwardBackwardSplittingOperator_averaged_of_cocoercive A hA B beta gamma hB hgamma
  have hα_pos : 0 < α := (AveragedWith.mem_Ioo hT).1
  have hdelta_eq : forwardBackwardRelaxationBound beta gamma = 1 / α := by
    have hdenom_pos : 0 < 4 * (beta : ℝ) - (gamma : ℝ) := by
      nlinarith [beta.2, hgamma]
    -- Normalize the source relaxation bound to the Proposition 5.16 form `1 / α`.
    dsimp [forwardBackwardRelaxationBound, α]
    field_simp [hdenom_pos.ne', beta.2.ne']
    ring
  have hlam' : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (1 / α) := by
    intro n
    simpa [hdelta_eq] using hlam n
  have hdiv' :
      Tendsto
        (fun N ↦ Finset.sum (Finset.range N) (fun n ↦ lam n * (1 - α * lam n)))
        atTop atTop := by
    -- Rescaling the source divergence sum by the positive averaging constant preserves `+∞`.
    convert Tendsto.const_mul_atTop hα_pos hdiv using 1
    ext N
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro n hn
    rw [hdelta_eq]
    field_simp [hα_pos.ne']
  have hfix : (fixedPoints T).Nonempty := by
    have hzero' := hzero
    rw [primal_inclusion_solution_set_eq_fixedPoints_forwardBackwardSplittingOperator
      A hA B gamma] at hzero'
    simpa [T] using hzero'
  rcases
      exists_tendsto_weakly_to_fixedPoint_of_relaxedOperatorIteration_of_averagedWith
        (hT := hT) lam hlam' hfix hdiv' x0 with
    ⟨p, hpfix, hlim⟩
  refine ⟨p, ?_, ?_⟩
  · -- Rewrite the fixed-point conclusion back to the primal solution set.
    rw [primal_inclusion_solution_set_eq_fixedPoints_forwardBackwardSplittingOperator
      A hA B gamma]
    simpa [T] using hpfix
  · -- The orbit is already the constant relaxed iteration of the forward-backward operator.
    simpa [forwardBackwardIteration, T] using hlim

/-- Helper for Theorem 26.14: the forward-backward orbit is Fejér monotone with respect to the
primal solution set. -/
theorem forwardBackwardFejerMonotone
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H)
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (x0 : H) :
    FejerMonotone
      (primal_inclusion_solution_set A B.toSetValuedOperator)
      (forwardBackwardIteration A hA B gamma lam x0) := by
  let α : ℝ := 2 * (beta : ℝ) / (4 * (beta : ℝ) - (gamma : ℝ))
  let T := forwardBackwardSplittingOperator A hA B gamma
  have hT : Averaged α T := by
    -- Proposition 26.1 already exposes the forward-backward map as averaged.
    simpa [α, T] using
      forwardBackwardSplittingOperator_averaged_of_cocoercive A hA B beta gamma hB hgamma
  have hα_pos : 0 < α := (AveragedWith.mem_Ioo hT).1
  have hdelta_eq : forwardBackwardRelaxationBound beta gamma = 1 / α := by
    have hdenom_pos : 0 < 4 * (beta : ℝ) - (gamma : ℝ) := by
      nlinarith [beta.2, hgamma]
    -- Normalize the textbook relaxation bound to Proposition 5.16's averaged parameter.
    dsimp [forwardBackwardRelaxationBound, α]
    field_simp [hdenom_pos.ne', beta.2.ne']
    ring
  have hlam' : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (1 / α) := by
    intro n
    simpa [hdelta_eq] using hlam n
  -- Rewrite the fixed-point owner back to the primal solution set before returning the result.
  simpa [forwardBackwardIteration, T,
    primal_inclusion_solution_set_eq_fixedPoints_forwardBackwardSplittingOperator A hA B gamma]
    using fejerMonotone_fixedPoints_of_relaxedOperatorIteration_of_averagedWith
      (hT := hT) (lam := lam) (hlam := hlam') x0

/-- Helper for Theorem 26.14: Proposition 5.16 gives asymptotic regularity for the relaxed
forward-backward orbit. -/
theorem forwardBackwardResidualTendstoZero
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H)
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ)) (lam : ℕ → ℝ)
    (hlam : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (forwardBackwardRelaxationBound beta gamma))
    (hdiv :
      Tendsto
        (fun N ↦
          Finset.sum (Finset.range N)
            (fun n ↦ lam n * (forwardBackwardRelaxationBound beta gamma - lam n)))
        atTop atTop)
    (hzero : (primal_inclusion_solution_set A B.toSetValuedOperator).Nonempty)
    (x0 : H) :
    Tendsto
      (fun n ↦
        forwardBackwardSplittingOperator A hA B gamma
            (forwardBackwardIteration A hA B gamma lam x0 n) -
          forwardBackwardIteration A hA B gamma lam x0 n)
      atTop (𝓝 (0 : H)) := by
  let α : ℝ := 2 * (beta : ℝ) / (4 * (beta : ℝ) - (gamma : ℝ))
  let T := forwardBackwardSplittingOperator A hA B gamma
  have hT : Averaged α T := by
    -- Keep the averaged owner in the same normal form as clause (i).
    simpa [α, T] using
      forwardBackwardSplittingOperator_averaged_of_cocoercive A hA B beta gamma hB hgamma
  have hα_pos : 0 < α := (AveragedWith.mem_Ioo hT).1
  have hdelta_eq : forwardBackwardRelaxationBound beta gamma = 1 / α := by
    have hdenom_pos : 0 < 4 * (beta : ℝ) - (gamma : ℝ) := by
      nlinarith [beta.2, hgamma]
    -- Reuse the same scalar normalization as in clause (i).
    dsimp [forwardBackwardRelaxationBound, α]
    field_simp [hdenom_pos.ne', beta.2.ne']
    ring
  have hlam' : ∀ n, lam n ∈ Set.Icc (0 : ℝ) (1 / α) := by
    intro n
    simpa [hdelta_eq] using hlam n
  have hdiv' :
      Tendsto
        (fun N ↦ Finset.sum (Finset.range N) (fun n ↦ lam n * (1 - α * lam n)))
        atTop atTop := by
    -- Proposition 5.16 uses the scaled divergence sum `∑ λₙ (1 - α λₙ)`.
    convert Tendsto.const_mul_atTop hα_pos hdiv using 1
    ext N
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl ?_
    intro n hn
    rw [hdelta_eq]
    field_simp [hα_pos.ne']
  have hfix : (fixedPoints T).Nonempty := by
    have hzero' := hzero
    rw [primal_inclusion_solution_set_eq_fixedPoints_forwardBackwardSplittingOperator
      A hA B gamma] at hzero'
    simpa [T] using hzero'
  -- Route correction: specialize Proposition 5.16 directly instead of reproving residual decay.
  simpa [forwardBackwardIteration, T] using
    residual_tendsto_zero_of_relaxedOperatorIteration_of_averagedWith
      (hT := hT) (lam := lam) (hlam := hlam') hfix hdiv' x0

/-- Helper for Theorem 26.14: monotonicity of `A` plus cocoercivity of `B` control the dual
residual `‖B u - B x‖` by the forward-backward residual `‖T u - u‖`. -/
theorem forwardBackwardDualGapSqLe
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (B : H → H)
    (beta gamma : PosReal)
    (hB : CocoerciveOn (beta : ℝ) (Set.univ : Set H) (fun x : Set.univ ↦ B x))
    (hgamma : (gamma : ℝ) < 2 * (beta : ℝ))
    {x u : H} (hx : x ∈ primal_inclusion_solution_set A B.toSetValuedOperator) :
    ((gamma : ℝ) * (beta : ℝ)) * ‖B u - B x‖ ^ 2 ≤
      (1 + (gamma : ℝ) / (beta : ℝ)) * ‖u - x‖ *
        ‖forwardBackwardSplittingOperator A hA B gamma u - u‖ := by
  let T := forwardBackwardSplittingOperator A hA B gamma
  let z := T u
  let Δ := B u - B x
  have hTavg : Averaged (2 * (beta : ℝ) / (4 * (beta : ℝ) - (gamma : ℝ))) T := by
    -- The forward-backward map is averaged, hence nonexpansive.
    simpa [T] using
      forwardBackwardSplittingOperator_averaged_of_cocoercive A hA B beta gamma hB hgamma
  have hxfix : x ∈ fixedPoints T := by
    rw [← primal_inclusion_solution_set_eq_fixedPoints_forwardBackwardSplittingOperator
      A hA B gamma]
    exact hx
  have hz_nonexp :
      ‖z - x‖ ≤ ‖u - x‖ := by
    -- Compare `z = T u` to the fixed point `x = T x` through nonexpansiveness.
    have hLip : LipschitzWith 1 T := lipschitzWithOne_of_averaged hTavg
    have hdist := hLip.dist_le_mul u x
    rw [Function.mem_fixedPoints_iff] at hxfix
    simpa [T, z, dist_eq_norm, hxfix, one_mul] using hdist
  have hxA : -B x ∈ A x := neg_mem_A_of_mem_primalSolution A B hx
  have hzA :
      (gamma : ℝ)⁻¹ • (u - (gamma : ℝ) • B u - z) ∈ A z := by
    simpa [T, z] using forwardBackwardSplitting_mem_A_of_apply A hA B gamma u
  have hmonoA :
      0 ≤
        ⟪z - x,
          (gamma : ℝ)⁻¹ • (u - z) - Δ⟫_ℝ := by
    have hmono :=
      (SetValuedOperator.isMonotone_iff A).1 (SetValuedOperator.Maximal.isMonotone hA) hzA hxA
    simpa [Δ, sub_eq_add_neg, smul_sub, smul_add, smul_smul, gamma.2.ne', add_assoc,
      add_left_comm, add_comm] using hmono
  have hmonoA' :
      (gamma : ℝ) * ⟪z - x, Δ⟫_ℝ ≤ ⟪z - x, u - z⟫_ℝ := by
    have hrewrite :
        ⟪z - x, (gamma : ℝ)⁻¹ • (u - z) - Δ⟫_ℝ =
          (gamma : ℝ)⁻¹ * ⟪z - x, u - z⟫_ℝ - ⟪z - x, Δ⟫_ℝ := by
      rw [inner_sub_right, inner_smul_right]
    rw [hrewrite] at hmonoA
    have hstep : ⟪z - x, Δ⟫_ℝ ≤ (gamma : ℝ)⁻¹ * ⟪z - x, u - z⟫_ℝ := by
      linarith
    have hmul := mul_le_mul_of_nonneg_left hstep gamma.2.le
    simpa [gamma.2.ne', mul_assoc] using hmul
  have hinner_res :
      ⟪z - x, u - z⟫_ℝ ≤ ‖u - x‖ * ‖z - u‖ := by
    have huz_eq : ‖u - z‖ = ‖z - u‖ := norm_sub_rev _ _
    have hstep :
        ‖z - x‖ * ‖u - z‖ ≤ ‖u - x‖ * ‖z - u‖ := by
      calc
        ‖z - x‖ * ‖u - z‖ = ‖z - x‖ * ‖z - u‖ := by rw [huz_eq]
        _ ≤ ‖u - x‖ * ‖z - u‖ := by
              exact mul_le_mul hz_nonexp le_rfl (norm_nonneg _) (norm_nonneg _)
    exact le_trans (real_inner_le_norm _ _) hstep
  have hcoco :
      (beta : ℝ) * ‖Δ‖ ^ 2 ≤ ⟪u - x, Δ⟫_ℝ := by
    simpa [Δ] using hB.ineq ⟨u, by simp⟩ ⟨x, by simp⟩
  have hDelta_le :
      (beta : ℝ) * ‖Δ‖ ≤ ‖u - x‖ := by
    by_cases hΔ : ‖Δ‖ = 0
    · simp [hΔ]
    · have hΔpos : 0 < ‖Δ‖ := lt_of_le_of_ne (norm_nonneg _) (Ne.symm hΔ)
      have hupper :
          (beta : ℝ) * ‖Δ‖ ^ 2 ≤ ‖u - x‖ * ‖Δ‖ := by
        exact le_trans hcoco (real_inner_le_norm _ _)
      nlinarith
  have hcross_lower :
      -‖z - u‖ * ‖Δ‖ ≤ ⟪z - u, Δ⟫_ℝ := by
    have habs : |⟪z - u, Δ⟫_ℝ| ≤ ‖z - u‖ * ‖Δ‖ := abs_real_inner_le_norm _ _
    have hneg : -‖z - u‖ * ‖Δ‖ ≤ -|⟪z - u, Δ⟫_ℝ| := by
      nlinarith
    exact le_trans hneg (neg_abs_le _)
  have hdecomp :
      ⟪z - x, Δ⟫_ℝ = ⟪z - u, Δ⟫_ℝ + ⟪u - x, Δ⟫_ℝ := by
    have hzxu : z - x = (z - u) + (u - x) := by
      abel_nf
    rw [hzxu, inner_add_left]
  have hmain :
      ((gamma : ℝ) * (beta : ℝ)) * ‖Δ‖ ^ 2 ≤
        ‖u - x‖ * ‖z - u‖ + (gamma : ℝ) * ‖z - u‖ * ‖Δ‖ := by
    have hstep1 :
        (gamma : ℝ) * ⟪z - x, Δ⟫_ℝ ≤ ‖u - x‖ * ‖z - u‖ := by
      exact le_trans hmonoA' hinner_res
    rw [hdecomp] at hstep1
    nlinarith [hstep1, hcoco, hcross_lower, gamma.2]
  have hcross_bound :
      (gamma : ℝ) * ‖z - u‖ * ‖Δ‖ ≤
        ((gamma : ℝ) / (beta : ℝ)) * ‖u - x‖ * ‖z - u‖ := by
    have hscale_nonneg : 0 ≤ ((gamma : ℝ) / (beta : ℝ)) * ‖z - u‖ := by
      rw [div_eq_mul_inv]
      exact mul_nonneg (mul_nonneg gamma.2.le (inv_nonneg.mpr beta.2.le)) (norm_nonneg _)
    have hmul := mul_le_mul_of_nonneg_left hDelta_le
      hscale_nonneg
    simpa [div_eq_mul_inv, beta.2.ne', mul_assoc, mul_left_comm, mul_comm] using hmul
  -- The final inequality is the textbook estimate `(26.55)` with the nonexpansive bound folded in.
  calc
    ((gamma : ℝ) * (beta : ℝ)) * ‖B u - B x‖ ^ 2
        = ((gamma : ℝ) * (beta : ℝ)) * ‖Δ‖ ^ 2 := by simp [Δ]
    _ ≤ ‖u - x‖ * ‖z - u‖ + (gamma : ℝ) * ‖z - u‖ * ‖Δ‖ := hmain
    _ ≤ ‖u - x‖ * ‖z - u‖ +
          ((gamma : ℝ) / (beta : ℝ)) * ‖u - x‖ * ‖z - u‖ := by
            exact add_le_add le_rfl hcross_bound
    _ = (1 + (gamma : ℝ) / (beta : ℝ)) * ‖u - x‖ * ‖z - u‖ := by ring
    _ = (1 + (gamma : ℝ) / (beta : ℝ)) * ‖u - x‖ * ‖T u - u‖ := by simp [T, z]

