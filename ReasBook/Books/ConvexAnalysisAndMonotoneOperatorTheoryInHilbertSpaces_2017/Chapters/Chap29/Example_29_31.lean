import BauschkeLean.Chap01.Text_1_0_2
import BauschkeLean.Chap03.Theorem_3_16_1
import BauschkeLean.Chap03.Theorem_3_16_2

-- Declarations for this item will be appended below by the statement pipeline.

open scoped InnerProductSpace Pointwise

universe u

section

variable {H : Type u} [AddCommGroup H] [Module ℝ H]

/-- The nonnegative ray generated by `u`. -/
def nonnegativeRay (u : H) : Set H :=
  Set.Ici (0 : ℝ) • ({u} : Set H)

/-- The source-facing nonnegative ray generated by a nonzero vector is a ray. -/
theorem nonnegativeRay_isRay (u : H) (hu : u ≠ 0) :
    IsRay (nonnegativeRay u) :=
  ⟨u, hu, rfl⟩

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

omit [CompleteSpace H] in
/-- Helper for Example 29.31: membership in `nonnegativeRay u` is exactly nonnegative scalar
multiplicity of `u`. -/
private theorem mem_nonnegativeRay_iff (u z : H) :
    z ∈ nonnegativeRay u ↔ ∃ a : ℝ, 0 ≤ a ∧ z = a • u := by
  -- Expand the pointwise scalar action on sets and collapse the singleton witness.
  rw [nonnegativeRay, Set.mem_smul]
  constructor
  · rintro ⟨a, ha, y, hy, rfl⟩
    refine ⟨a, ?_, ?_⟩
    · simpa using ha
    · have hy' : y = u := by
        exact Set.mem_singleton_iff.mp hy
      simp [hy']
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a, ha, u, by simp, rfl⟩

omit [CompleteSpace H] in
/-- Helper for Example 29.31: a point lies on `nonnegativeRay u` iff its inner product with `u`
is nonnegative and the point is the corresponding scalar multiple of `u`. -/
private theorem mem_nonnegativeRay_iff_inner_nonneg_and_eq_smul
    (u z : H) (hu : u ≠ 0) :
    z ∈ nonnegativeRay u ↔
      0 ≤ ⟪z, u⟫_ℝ ∧ z = (⟪z, u⟫_ℝ / ‖u‖ ^ 2) • u := by
  have hu_sq : ‖u‖ ^ 2 ≠ 0 := by
    exact pow_ne_zero 2 (norm_ne_zero_iff.mpr hu)
  constructor
  · intro hz
    rcases (mem_nonnegativeRay_iff u z).1 hz with ⟨a, ha, rfl⟩
    constructor
    · -- A nonnegative multiple of `u` has nonnegative inner product with `u`.
      rw [real_inner_smul_left, real_inner_self_eq_norm_sq]
      exact mul_nonneg ha (sq_nonneg ‖u‖)
    · -- Recover the scalar from the inner product formula.
      have hcoef : (⟪a • u, u⟫_ℝ / ‖u‖ ^ 2 : ℝ) = a := by
        rw [real_inner_smul_left, real_inner_self_eq_norm_sq]
        field_simp [hu_sq]
      simp [hcoef]
  · rintro ⟨hz_nonneg, hz_eq⟩
    -- The displayed scalar is already nonnegative, so the point belongs to the ray.
    exact (mem_nonnegativeRay_iff u z).2
      ⟨⟪z, u⟫_ℝ / ‖u‖ ^ 2, div_nonneg hz_nonneg (sq_nonneg ‖u‖), hz_eq⟩

omit [CompleteSpace H] in
/-- Helper for Example 29.31: the nonnegative ray is convex. -/
private theorem nonnegativeRay_convex (u : H) :
    Convex ℝ (nonnegativeRay u) := by
  intro x hx y hy a b ha hb hab
  rcases (mem_nonnegativeRay_iff u x).1 hx with ⟨s, hs, rfl⟩
  rcases (mem_nonnegativeRay_iff u y).1 hy with ⟨t, ht, rfl⟩
  -- Convex combinations of nonnegative scalars stay nonnegative and still multiply `u`.
  refine (mem_nonnegativeRay_iff u _).2 ⟨a * s + b * t, ?_, ?_⟩
  · nlinarith
  · calc
      a • (s • u) + b • (t • u) = (a * s) • u + (b * t) • u := by
        rw [smul_smul, smul_smul]
      _ = (a * s + b * t) • u := by
        rw [← add_smul]

omit [CompleteSpace H] in
/-- Helper for Example 29.31: for a nonzero direction, `nonnegativeRay u` is closed. -/
private theorem nonnegativeRay_isClosed (u : H) (hu : u ≠ 0) :
    IsClosed (nonnegativeRay u) := by
  have hcontInner : Continuous fun z : H ↦ ⟪z, u⟫_ℝ := by
    simpa [innerSLFlip_apply_apply] using (innerSLFlip ℝ u).continuous
  have hcontCoeff : Continuous fun z : H ↦ (⟪z, u⟫_ℝ / ‖u‖ ^ 2 : ℝ) := by
    simpa [div_eq_mul_inv] using
      (hcontInner.mul (continuous_const : Continuous fun _ : H ↦ (‖u‖ ^ 2)⁻¹))
  have hcontSmul : Continuous fun z : H ↦ ((⟪z, u⟫_ℝ / ‖u‖ ^ 2 : ℝ) • u) := by
    simpa using hcontCoeff.smul continuous_const
  have hclosedInner : IsClosed {z : H | 0 ≤ ⟪z, u⟫_ℝ} := by
    simpa [innerSLFlip_apply_apply] using isClosed_Ici.preimage hcontInner
  have hclosedEq : IsClosed {z : H | z = (⟪z, u⟫_ℝ / ‖u‖ ^ 2) • u} := by
    exact isClosed_eq continuous_id hcontSmul
  -- Combine the scalar-sign condition with the collinearity equation.
  convert hclosedInner.inter hclosedEq using 1
  ext z
  simp [mem_nonnegativeRay_iff_inner_nonneg_and_eq_smul, hu]

-- Semantic recall: `lean_leansearch` surfaced span/submodule orthogonal-projection formulas, but
-- Chapter 29 uses the project-local metric projector `P[C, hC]`, so the source-facing statement is
-- written directly for `nonnegativeRay u`.

/-- The nonnegative ray generated by a nonzero vector in a real Hilbert space is a Chebyshev set. -/
theorem isChebyshev_nonnegative_ray (u : H) (hu : u ≠ 0) :
    IsChebyshev (nonnegativeRay u) := by
  -- Package the ray as a nonempty closed convex set and apply the Hilbert projection theorem.
  refine isChebyshev_of_nonempty_isClosed_convex ?_ (nonnegativeRay_isClosed u hu)
    (nonnegativeRay_convex u)
  exact ⟨0, (mem_nonnegativeRay_iff u 0).2 ⟨0, le_rfl, by simp⟩⟩

/-- Example 29.31: if `u ≠ 0` and `K = nonnegativeRay u` is the associated ray, then the metric
projection onto `K` is given by formula (29.58):
`P_K x = (⟪x, u⟫_ℝ / ‖u‖^2) • u` when `⟪x, u⟫_ℝ > 0`, and `P_K x = 0` otherwise. -/
theorem projectionPoint_nonnegative_ray_eq_piecewise (u : H) (hu : u ≠ 0) (x : H) :
    P[nonnegativeRay u, isChebyshev_nonnegative_ray u hu] x =
      if ⟪x, u⟫_ℝ > 0 then
        (⟪x, u⟫_ℝ / ‖u‖ ^ 2) • u
      else
        0 := by
  have hconv : Convex ℝ (nonnegativeRay u) := nonnegativeRay_convex u
  have hu_sq : ‖u‖ ^ 2 ≠ 0 := by
    exact pow_ne_zero 2 (norm_ne_zero_iff.mpr hu)
  by_cases hx : 0 < ⟪x, u⟫_ℝ
  · -- Route correction: use the convex variational characterization directly, since the residual
    -- from the one-dimensional orthogonal projection is orthogonal to the ray direction.
    let a : ℝ := ⟪x, u⟫_ℝ / ‖u‖ ^ 2
    let p : H := a • u
    have hp_mem : p ∈ nonnegativeRay u := by
      exact (mem_nonnegativeRay_iff u p).2 ⟨a, div_nonneg hx.le (sq_nonneg ‖u‖), rfl⟩
    have horth : ⟪u, x - p⟫_ℝ = 0 := by
      calc
        ⟪u, x - p⟫_ℝ = ⟪u, x⟫_ℝ - ⟪u, p⟫_ℝ := by
          rw [inner_sub_right]
        _ = ⟪x, u⟫_ℝ - (a * ‖u‖ ^ 2) := by
          simp [p, real_inner_comm, real_inner_smul_right]
        _ = 0 := by
          have hcalc : a * ‖u‖ ^ 2 = ⟪x, u⟫_ℝ := by
            calc
              a * ‖u‖ ^ 2 = (⟪x, u⟫_ℝ / ‖u‖ ^ 2) * ‖u‖ ^ 2 := by
                simp [a]
              _ = ⟪x, u⟫_ℝ := by
                field_simp [hu_sq]
          linarith
    have hp_proj : p = P[nonnegativeRay u, isChebyshev_nonnegative_ray u hu] x := by
      refine
        (eq_projectionPoint_iff_mem_and_inner_sub_right_nonpos
          (isChebyshev_nonnegative_ray u hu) hconv).2 ?_
      constructor
      · -- The active-branch candidate is a positive scalar multiple of `u`.
        exact hp_mem
      · intro y hy
        rcases (mem_nonnegativeRay_iff u y).1 hy with ⟨b, hb, rfl⟩
        -- Every ray direction is orthogonal to the residual `x - p`.
        calc
          ⟪b • u - p, x - p⟫_ℝ = ⟪b • u - a • u, x - p⟫_ℝ := by
            simp [p]
          _ = ⟪(b - a) • u, x - p⟫_ℝ := by
            rw [← sub_smul]
          _ = (b - a) * ⟪u, x - p⟫_ℝ := by
            rw [real_inner_smul_left]
          _ = 0 := by rw [horth, mul_zero]
          _ ≤ 0 := le_rfl
    simpa [hx, p, a] using hp_proj.symm
  · have hx_nonpos : ⟪x, u⟫_ℝ ≤ 0 := not_lt.mp hx
    have hzero :
        (0 : H) = P[nonnegativeRay u, isChebyshev_nonnegative_ray u hu] x := by
      refine
        (eq_projectionPoint_iff_mem_and_inner_sub_right_nonpos
          (isChebyshev_nonnegative_ray u hu) hconv).2 ?_
      constructor
      · -- The origin is always the endpoint of the ray.
        exact (mem_nonnegativeRay_iff u 0).2 ⟨0, le_rfl, by simp⟩
      · intro y hy
        rcases (mem_nonnegativeRay_iff u y).1 hy with ⟨a, ha, rfl⟩
        -- On the inactive branch every ray point makes a nonpositive angle with `x`.
        calc
          ⟪a • u - 0, x - 0⟫_ℝ = a * ⟪x, u⟫_ℝ := by
            rw [sub_zero, sub_zero, real_inner_smul_left, real_inner_comm]
          _ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos ha hx_nonpos
    simpa [hx] using hzero.symm

/-- On the active branch `0 < ⟪x, u⟫_ℝ`, Example 29.31 gives the positive scalar multiple of
`u`. -/
theorem projectionPoint_nonnegative_ray_eq_smul_of_inner_pos
    (u : H) (hu : u ≠ 0) (x : H) (hx : 0 < ⟪x, u⟫_ℝ) :
    P[nonnegativeRay u, isChebyshev_nonnegative_ray u hu] x =
      (⟪x, u⟫_ℝ / ‖u‖ ^ 2) • u := by
  rw [projectionPoint_nonnegative_ray_eq_piecewise u hu x]
  simp [hx]

/-- On the inactive branch `⟪x, u⟫_ℝ ≤ 0`, Example 29.31 gives the origin. -/
theorem projectionPoint_nonnegative_ray_eq_zero_of_inner_nonpos
    (u : H) (hu : u ≠ 0) (x : H) (hx : ⟪x, u⟫_ℝ ≤ 0) :
    P[nonnegativeRay u, isChebyshev_nonnegative_ray u hu] x = 0 := by
  rw [projectionPoint_nonnegative_ray_eq_piecewise u hu x]
  simp [not_lt.mpr hx]

end
