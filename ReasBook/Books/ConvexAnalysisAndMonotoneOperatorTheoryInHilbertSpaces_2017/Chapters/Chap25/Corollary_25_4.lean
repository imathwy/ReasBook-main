/-- Helper for Corollary 25.4: maximal monotonicity forces the graph to be nonempty. -/
private theorem graphNonemptyOfMaximal
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {T : SetValuedOperator E E} (hT : Maximal IsMonotone T) :
    (gra T).Nonempty := by
  -- Compare `T` with the zero operator; emptiness would contradict maximality at the origin.
  by_contra hT_graph
  let Z : SetValuedOperator E E := fun _ ↦ ({0} : Set E)
  have hZ_mono : Z.IsMonotone := by
    rw [SetValuedOperator.isMonotone_iff]
    intro x u y v hu hv
    simp [Z] at hu hv
    subst u
    subst v
    simp
  have hTZ : T ≤ Z := by
    intro x u hu
    have hmem : (x, u) ∈ gra T := by
      simpa [SetValuedOperator.mem_graph] using hu
    exact (hT_graph ⟨(x, u), hmem⟩).elim
  have hzero_mem : 0 ∈ T 0 := (hT.2 hZ_mono hTZ 0) (by simp [Z])
  have hmem_zero : (0, 0) ∈ gra T := by
    simpa [SetValuedOperator.mem_graph] using hzero_mem
  exact hT_graph ⟨(0, 0), hmem_zero⟩

/-- Helper for Corollary 25.4: the projected Fitzpatrick domain is convex for a maximally
monotone operator. -/
private theorem convexFstImageDomFitzpatrickOfMaximal
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (T : SetValuedOperator E E) (hT : Maximal IsMonotone T) :
    Convex ℝ T.fstImageDomFitzpatrick := by
  have hT_graph : (gra T).Nonempty := graphNonemptyOfMaximal hT
  have hT_mono : T.IsMonotone := Maximal.isMonotone hT
  let FT : E × E → Set.Ioi (⊥ : EReal) :=
    properIoi (F[T])
      (fitzpatrickFunction_isProper_of_graph_nonempty_of_monotone T hT_graph hT_mono)
  have hFT : FT ∈ Γ₀(E × E) := by
    -- Package the Fitzpatrick owner through the canonical `Γ₀` interface before projecting.
    simpa [FT] using fitzpatrickFunction_mem_gammaZero T hT_graph hT_mono
  -- The first-coordinate image of a convex effective domain is convex.
  simpa [fstImageDomFitzpatrick, FT, ERealFunction.effectiveDomain, ERealFunction.dom] using
    hFT.2.convex_effectiveDomain.linear_image (ContinuousLinearMap.fst ℝ E E).toLinearMap

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- Helper for Corollary 25.4: first-coordinate projection commutes with Minkowski subtraction. -/
private theorem fstImageSub_eq_sub_fstImage {S T : Set (H × H)} :
    Prod.fst '' (S - T) = (Prod.fst '' S) - (Prod.fst '' T) := by
  ext x
  constructor
  · rintro ⟨p, hp, rfl⟩
    rcases Set.mem_sub.mp hp with ⟨s, hs, t, ht, hst⟩
    refine Set.mem_sub.mpr ⟨s.1, ⟨s, hs, rfl⟩, t.1, ⟨t, ht, rfl⟩, ?_⟩
    simpa using congrArg Prod.fst hst
  · intro hx
    rcases Set.mem_sub.mp hx with ⟨xs, hs, xt, ht, hxt⟩
    rcases hs with ⟨s, hs, rfl⟩
    rcases ht with ⟨t, ht, rfl⟩
    refine ⟨s - t, Set.mem_sub.mpr ⟨s, hs, t, ht, rfl⟩, ?_⟩
    simpa using hxt

/-- Helper for Corollary 25.4: the exact-span hypothesis puts the origin in
`ri (convexHull ℝ (A.dom - B.dom))`. -/
private theorem zeroMemRiConvexHullDomSub_of_coneDomSubEqSpan
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B)
    (hcone :
      cone (A.dom - B.dom) = (Submodule.span ℝ (A.dom - B.dom) : Set H)) :
    (0 : H) ∈ ri (convexHull ℝ (A.dom - B.dom)) := by
  let D : Set H := A.dom - B.dom
  let C : Set H := convexHull ℝ D
  have hD_nonempty : D.Nonempty := by
    rcases dom_nonempty_of_maximal A hA with ⟨x, hx⟩
    rcases dom_nonempty_of_maximal B hB with ⟨y, hy⟩
    exact ⟨x - y, Set.mem_sub.mpr ⟨x, hx, y, hy, rfl⟩⟩
  have hC_convex : Convex ℝ C := by
    simpa [C] using convex_convexHull ℝ D
  have hspanC :
      Submodule.span ℝ C = Submodule.span ℝ D := by
    apply le_antisymm
    · refine Submodule.span_le.2 ?_
      -- The convex hull already lies in the span generated by the original difference set.
      simpa [C] using
        (convexHull_min (fun z hz ↦ Submodule.subset_span hz) (Submodule.span ℝ D).convex)
    · exact Submodule.span_mono (subset_convexHull ℝ D)
  have hconeHull :
      cone C = cone D := by
    apply Set.Subset.antisymm
    · -- Passing to the convex hull does not enlarge the generated cone.
      intro z hz
      exact
        (ConvexCone.hull_min
          (C := ConvexCone.hull ℝ D)
          (convexHull_min ConvexCone.subset_hull (ConvexCone.hull ℝ D).convex)) hz
    · -- The original set sits inside its convex hull, so the cone only grows monotonically.
      intro z hz
      exact
        (ConvexCone.hull_min
          (C := ConvexCone.hull ℝ C)
          ((subset_convexHull ℝ D).trans ConvexCone.subset_hull)) hz
  have hconeC :
      cone C = (Submodule.span ℝ C : Set H) := by
    calc
      cone C = cone D := hconeHull
      _ = (Submodule.span ℝ D : Set H) := hcone
      _ = (Submodule.span ℝ C : Set H) := by rw [hspanC]
  have h0C : (0 : H) ∈ C := by
    rcases hD_nonempty with ⟨z, hzD⟩
    have hzC : z ∈ C := subset_convexHull ℝ D hzD
    have hnegConeD : -z ∈ cone D := by
      rw [hcone]
      exact (Submodule.span ℝ D).neg_mem (Submodule.subset_span hzD)
    have hnegConeC : -z ∈ cone C := by
      rwa [← hconeHull] at hnegConeD
    rw [cone_eq_toCone_of_convex hC_convex] at hnegConeC
    rcases (hC_convex.mem_toCone).1 hnegConeC with ⟨c, hc, y, hyC, hcy⟩
    have hdenom_pos : 0 < 1 + c := by
      linarith
    have ha : 0 ≤ (1 / (1 + c) : ℝ) := by
      positivity
    have hb : 0 ≤ c / (1 + c) := by
      positivity
    have hab : (1 / (1 + c) : ℝ) + c / (1 + c) = 1 := by
      field_simp [hdenom_pos.ne']
    have hb_mul : c / (1 + c) = (1 / (1 + c)) * c := by
      field_simp [hdenom_pos.ne']
    have hzero_combo :
        (1 / (1 + c) : ℝ) • z + (c / (1 + c)) • y = (0 : H) := by
      calc
        (1 / (1 + c) : ℝ) • z + (c / (1 + c)) • y
            = (1 / (1 + c) : ℝ) • z + ((1 / (1 + c)) * c) • y := by rw [hb_mul]
        _ = (1 / (1 + c) : ℝ) • z + (1 / (1 + c) : ℝ) • (c • y) := by
              rw [← smul_smul]
        _ = (1 / (1 + c) : ℝ) • (z + c • y) := by rw [smul_add]
        _ = 0 := by
              rw [hcy]
              simp
    have hcombo :
        (1 / (1 + c) : ℝ) • z + (c / (1 + c)) • y ∈ C := by
      exact hC_convex hzC hyC ha hb hab
    exact hzero_combo ▸ hcombo
  -- Evaluate the relative-interior criterion at the origin after normalizing the translation.
  refine Set.mem_relativeInterior_iff.mpr ⟨h0C, ?_⟩
  simpa [C, sub_singleton_zero_eq_self] using hconeC

/-- Helper for Corollary 25.4: the convex hull of `A.dom - B.dom` lies in the projected
Fitzpatrick-domain difference. -/
private theorem convexHullDomSub_subset_projectedFitzpatrickDifference
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B) :
    convexHull ℝ (A.dom - B.dom) ⊆ A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick := by
  have hconv :
      Convex ℝ (A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick) := by
    exact
      (convexFstImageDomFitzpatrickOfMaximal A hA).sub
        (convexFstImageDomFitzpatrickOfMaximal B hB)
  refine convexHull_min ?_ hconv
  intro z hz
  rcases Set.mem_sub.mp hz with ⟨x, hx, y, hy, rfl⟩
  refine Set.mem_sub.mpr ⟨x, ?_, y, ?_, rfl⟩
  · exact dom_subset_fst_image_dom_fitzpatrick (A := A) hA hx
  · exact dom_subset_fst_image_dom_fitzpatrick (A := B) hB hy

/-- Helper for Corollary 25.4: the projected Fitzpatrick-domain difference stays inside
`closure (convexHull ℝ (A.dom - B.dom))`. -/
private theorem projectedFitzpatrickDifference_subset_closureConvexHullDomSub
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B) :
    A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick ⊆
      closure (convexHull ℝ (A.dom - B.dom)) := by
  let Ψ : H × H →L[ℝ] H := ContinuousLinearMap.fst ℝ H H - ContinuousLinearMap.snd ℝ H H
  have hΨ_image_prod :
      Ψ '' (A.dom ×ˢ B.dom) = A.dom - B.dom := by
    ext z
    constructor
    · rintro ⟨p, hp, rfl⟩
      exact Set.mem_sub.mpr ⟨p.1, hp.1, p.2, hp.2, rfl⟩
    · intro hz
      rcases Set.mem_sub.mp hz with ⟨x, hx, y, hy, rfl⟩
      exact ⟨(x, y), ⟨hx, hy⟩, rfl⟩
  intro z hz
  rcases Set.mem_sub.mp hz with ⟨x, hx, y, hy, hxy⟩
  have hx_cl : x ∈ closure (convexHull ℝ A.dom) := by
    exact closure_mono (subset_convexHull ℝ A.dom)
      (fst_image_dom_fitzpatrick_subset_closure_dom (A := A) hA hx)
  have hy_cl : y ∈ closure (convexHull ℝ B.dom) := by
    exact closure_mono (subset_convexHull ℝ B.dom)
      (fst_image_dom_fitzpatrick_subset_closure_dom (A := B) hB hy)
  have hprod :
      (x, y) ∈ closure (convexHull ℝ A.dom ×ˢ convexHull ℝ B.dom) := by
    rw [closure_prod_eq]
    exact ⟨hx_cl, hy_cl⟩
  have hmaps :
      Set.MapsTo Ψ (convexHull ℝ A.dom ×ˢ convexHull ℝ B.dom)
        (Ψ '' (convexHull ℝ A.dom ×ˢ convexHull ℝ B.dom)) := by
    intro p hp
    exact Set.mem_image_of_mem Ψ hp
  have hz_closure :
      x - y ∈ closure (Ψ '' (convexHull ℝ A.dom ×ˢ convexHull ℝ B.dom)) := by
    exact (Set.MapsTo.closure hmaps Ψ.continuous) hprod
  have himageHull :
      Ψ '' (convexHull ℝ A.dom ×ˢ convexHull ℝ B.dom) =
        convexHull ℝ (A.dom - B.dom) := by
    calc
      Ψ '' (convexHull ℝ A.dom ×ˢ convexHull ℝ B.dom)
          = Ψ '' convexHull ℝ (A.dom ×ˢ B.dom) := by
              rw [← convexHull_prod]
      _ = convexHull ℝ (Ψ '' (A.dom ×ˢ B.dom)) := by
            simpa using (LinearMap.image_convexHull Ψ.toLinearMap (A.dom ×ˢ B.dom))
      _ = convexHull ℝ (A.dom - B.dom) := by
            rw [hΨ_image_prod]
  simpa [hxy, himageHull] using hz_closure

/-- Helper for Corollary 25.4: the convex hull of `A.dom - B.dom` and the projected
Fitzpatrick-domain difference have the same closure. -/
private theorem closureConvexHullDomSub_eq_closureProjectedFitzpatrickDifference
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B) :
    closure (convexHull ℝ (A.dom - B.dom)) =
      closure (A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick) := by
  -- Freeze the common ambient closure once so later projected regularity lemmas can just rewrite.
  apply Set.Subset.antisymm
  · exact closure_mono (convexHullDomSub_subset_projectedFitzpatrickDifference hA hB)
  · simpa using
      closure_mono (projectedFitzpatrickDifference_subset_closureConvexHullDomSub hA hB)

/-- Helper for Corollary 25.4: the convex-hull carrier and the projected Fitzpatrick carrier have
the same closed span. -/
private theorem closedSpanCarrier_eq_closedHullCarrier_of_coneDomSubEqSpan
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B) :
    let C : Set H := convexHull ℝ (A.dom - B.dom)
    let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
    (((Submodule.span ℝ C).topologicalClosure : Submodule ℝ H) : Set H) =
      (((Submodule.span ℝ S).topologicalClosure : Submodule ℝ H) : Set H) := by
  let C : Set H := convexHull ℝ (A.dom - B.dom)
  let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
  have hC_subset_S : C ⊆ S := by
    -- The hull-side source carrier already sits inside the projected Fitzpatrick surface.
    simpa [C, S] using convexHullDomSub_subset_projectedFitzpatrickDifference hA hB
  have hS_subset_closedSpanC :
      S ⊆ (((Submodule.span ℝ C).topologicalClosure : Submodule ℝ H) : Set H) := by
    -- The projected surface stays inside `closure C`, hence inside the closed span generated by `C`.
    intro x hx
    have hx_closureC : x ∈ closure C := by
      simpa [C, S] using projectedFitzpatrickDifference_subset_closureConvexHullDomSub hA hB hx
    have hx_closedSpanC : x ∈ closure ((Submodule.span ℝ C : Set H)) := by
      exact closure_mono (fun y hy ↦ Submodule.subset_span hy) hx_closureC
    simpa [Submodule.topologicalClosure_coe] using hx_closedSpanC
  have hclosedSpanC_le_closedSpanS :
      (Submodule.span ℝ C).topologicalClosure ≤ (Submodule.span ℝ S).topologicalClosure := by
    -- Inclusion `C ⊆ S` gives the forward closed-span comparison immediately.
    exact Submodule.topologicalClosure_mono (Submodule.span_mono hC_subset_S)
  have hclosedSpanS_le_closedSpanC :
      (Submodule.span ℝ S).topologicalClosure ≤ (Submodule.span ℝ C).topologicalClosure := by
    -- The reverse comparison only uses that every point of `S` already lies in the closed span of `C`.
    exact
      Submodule.topologicalClosure_minimal _
        (Submodule.span_le.2 hS_subset_closedSpanC)
        (Submodule.isClosed_topologicalClosure _)
  -- Freeze the carrier equality once so the remaining subtype arguments live on one ambient space.
  simpa using
    congrArg
      (fun V : Submodule ℝ H => (V : Set H))
      (le_antisymm hclosedSpanC_le_closedSpanS hclosedSpanS_le_closedSpanC)

/-- Helper for Corollary 25.4: cone membership on the closed-span subtype is exactly ambient cone
membership on the original convex carrier. -/
private theorem memConeClosedSpanSubtypePreimage_iff
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {S : Set E} (hS_convex : Convex ℝ S) :
    let B : ClosedSubmodule ℝ E :=
      ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
    let T : Set (B : Submodule ℝ E) := ((↑) ⁻¹' S)
    ∀ {v : (B : Submodule ℝ E)}, v ∈ cone T ↔ ((v : E) ∈ cone S) := by
  let B : ClosedSubmodule ℝ E :=
    ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
  let T : Set (B : Submodule ℝ E) := ((↑) ⁻¹' S)
  let B0 : Submodule ℝ E := (B : Submodule ℝ E)
  change ∀ {v : B0}, v ∈ cone T ↔ ((v : E) ∈ cone S)
  have hT_convex : Convex ℝ T := by
    -- Pull convexity back along the closed-span subtype inclusion.
    simpa [T, B0] using hS_convex.affine_preimage B0.subtype.toAffineMap
  intro v
  constructor
  · intro hv
    rw [cone_eq_toCone_of_convex_aux hT_convex] at hv
    rcases (Convex.mem_toCone hT_convex).1 hv with ⟨c, hc, y, hy, rfl⟩
    rw [cone_eq_toCone_of_convex_aux hS_convex]
    exact (Convex.mem_toCone hS_convex).2 ⟨c, hc, (y : E), hy, rfl⟩
  · intro hv
    rw [cone_eq_toCone_of_convex_aux hS_convex] at hv
    rcases (Convex.mem_toCone hS_convex).1 hv with ⟨c, hc, y, hy, hyv⟩
    have hyB : y ∈ (B : Set E) := by
      -- Every generator of `S` lies in the closed span generated by `S`.
      change y ∈ (((Submodule.span ℝ S).topologicalClosure : Submodule ℝ E) : Set E)
      exact (Submodule.span ℝ S).le_topologicalClosure (Submodule.subset_span hy)
    rw [cone_eq_toCone_of_convex_aux hT_convex]
    refine (Convex.mem_toCone hT_convex).2 ⟨c, hc, ⟨y, hyB⟩, hy, ?_⟩
    apply Subtype.ext
    simpa using hyv

/-- Helper for Corollary 25.4: on the closed-span subtype, the closure of the projected
Fitzpatrick-domain difference is exactly the closed hull of `convexHull ℝ (A.dom - B.dom)`. -/
private theorem closureClosedSpanSubtype_projectedFitzpatrickDifference_eq_closedHullSubtype_of_coneDomSubEqSpan
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B)
    (hcone :
      cone (A.dom - B.dom) = (Submodule.span ℝ (A.dom - B.dom) : Set H)) :
    let D : Set H := A.dom - B.dom
    let C : Set H := convexHull ℝ D
    let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
    let Bc : ClosedSubmodule ℝ H :=
      ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
    let T : Set (Bc : Submodule ℝ H) := ((↑) ⁻¹' S)
    let U : Set (Bc : Submodule ℝ H) := ((↑) ⁻¹' closure C)
    closure T = U := by
  let D : Set H := A.dom - B.dom
  let C : Set H := convexHull ℝ D
  let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
  let Bc : ClosedSubmodule ℝ H :=
    ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
  let T : Set (Bc : Submodule ℝ H) := ((↑) ⁻¹' S)
  let U : Set (Bc : Submodule ℝ H) := ((↑) ⁻¹' closure C)
  let B0 : Submodule ℝ H := (Bc : Submodule ℝ H)
  change closure T = U
  have hS_subset_B0 : S ⊆ (B0 : Set H) := by
    -- Every projected generator lies in the closed span used for the subtype carrier.
    intro x hx
    exact (Submodule.span ℝ S).le_topologicalClosure (Submodule.subset_span hx)
  have himageT : ((↑) : B0 → H) '' T = S := by
    -- Expanding the subtype preimage recovers the original projected support set.
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hy
    · intro hx
      exact ⟨⟨x, hS_subset_B0 hx⟩, hx, rfl⟩
  rw [Topology.IsInducing.subtypeVal.closure_eq_preimage_closure_image]
  change ((↑) : B0 → H) ⁻¹' closure (((↑) : B0 → H) '' T) = U
  rw [himageT]
  -- Route correction: normalize the subtype closure through the already-proved ambient closure
  -- identity instead of restarting the old containments-only argument.
  simpa [U, C, S, B0] using
    congrArg (fun V : Set H => ((↑) : B0 → H) ⁻¹' V)
      (closureConvexHullDomSub_eq_closureProjectedFitzpatrickDifference hA hB).symm

/-- Helper for Corollary 25.4: enlarging a raw-span subtype preimage preserves a core witness at
the origin. -/
private theorem zeroMemCore_subtypePreimage_mono
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {V : Submodule ℝ E} {C S : Set E} (hCS : C ⊆ S)
    (hcoreC : (0 : V) ∈ Set.core (((↑) : V → E) ⁻¹' C)) :
    (0 : V) ∈ Set.core (((↑) : V → E) ⁻¹' S) := by
  let TC : Set V := ((↑) : V → E) ⁻¹' C
  let TS : Set V := ((↑) : V → E) ⁻¹' S
  have hTC_subset_TS : TC ⊆ TS := by
    -- Pull the ambient inclusion back along the fixed subtype inclusion map.
    intro v hv
    exact hCS hv
  have h0TC : (0 : V) ∈ TC := (Set.mem_core_iff.mp hcoreC).1
  have h0TS : (0 : V) ∈ TS := hTC_subset_TS h0TC
  have hconeTC : cone TC = (Set.univ : Set V) := by
    -- Read the core predicate through the source-facing cone description.
    simpa [TC, sub_singleton_zero_eq_self] using (Set.mem_core_iff.mp hcoreC).2
  have hconeTS : cone TS = (Set.univ : Set V) := by
    apply Set.Subset.antisymm
    · simp
    · intro v hv
      have hvTC : v ∈ cone TC := by simpa [hconeTC]
      -- Any cone over the smaller preimage is also a cone over the larger preimage.
      exact
        ConvexCone.hull_min
          (C := ConvexCone.hull ℝ TS)
          (fun z hz ↦ ConvexCone.subset_hull (hTC_subset_TS hz))
          hvTC
  rw [Set.mem_core_iff]
  -- Rewrite the enlarged cone equality back into the literal `Set.core` spelling.
  exact ⟨h0TS, by simpa [TS, sub_singleton_zero_eq_self] using hconeTS⟩

/-- Helper for Corollary 25.4: the hull-side `ri` witness already gives a raw-span core witness on
the projected Fitzpatrick-domain difference. -/
private theorem zeroMemCore_spanConvexHullDomSub_preimage_projectedDifference_of_coneDomSubEqSpan
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B)
    (hcone :
      cone (A.dom - B.dom) = (Submodule.span ℝ (A.dom - B.dom) : Set H)) :
    let D : Set H := A.dom - B.dom
    let C : Set H := convexHull ℝ D
    let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
    let V : Submodule ℝ H := Submodule.span ℝ C
    let T : Set V := ((↑) ⁻¹' S)
    (0 : V) ∈ Set.core T := by
  let D : Set H := A.dom - B.dom
  let C : Set H := convexHull ℝ D
  let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
  let V : Submodule ℝ H := Submodule.span ℝ C
  let TC : Set V := ((↑) ⁻¹' C)
  let T : Set V := ((↑) ⁻¹' S)
  have hriC : (0 : H) ∈ ri C := by
    -- The source regularity first produces `ri` on the convex hull of the domain difference.
    simpa [C] using zeroMemRiConvexHullDomSub_of_coneDomSubEqSpan hA hB hcone
  have hC_convex : Convex ℝ C := by
    -- The frozen hull carrier is convex by construction.
    simpa [C] using convex_convexHull ℝ D
  have h0C : (0 : H) ∈ C := (Set.mem_relativeInterior_iff.mp hriC).1
  have hC_subset_S : C ⊆ S := by
    -- The hull-side carrier already lives inside the projected Fitzpatrick-domain difference.
    simpa [C, S] using convexHullDomSub_subset_projectedFitzpatrickDifference hA hB
  have hcoreTC : (0 : V) ∈ Set.core TC := by
    have hconeC : cone C = (V : Set H) := by
      -- Evaluate the hull-side `ri` witness at the origin.
      simpa [C, V, sub_singleton_zero_eq_self] using (Set.mem_relativeInterior_iff.mp hriC).2
    have hCsubZero : C - ({(0 : H)} : Set H) = C := by
      -- The hull-side carrier is normalized at the origin.
      simpa using sub_singleton_zero_eq_self C
    -- Rewrite the origin criterion into the Chapter 6 subtype-core bridge on `span C`.
    simpa [C, V, TC, hCsubZero] using
      (zero_mem_core_subtype_preimage_iff_cone_eq_span_translate
        (H := H) (C := C) hC_convex h0C).2
        (by simpa [V, hCsubZero] using hconeC)
  -- Route correction: stay on the raw span of `C`; the only transport here is the monotone
  -- enlargement from the preimage of `C` to the preimage of `S`.
  exact zeroMemCore_subtypePreimage_mono hC_subset_S hcoreTC

/-- Helper for Corollary 25.4: once the closed span of a nonempty convex set already lies in its
cone, the origin belongs to the strong relative interior. -/
private theorem zeroMemSri_of_closedSpanSubsetCone
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {S : Set E} (hS_nonempty : S.Nonempty) (hS_convex : Convex ℝ S)
    (hclosedSpanSubsetCone :
      (((Submodule.span ℝ S).topologicalClosure : Submodule ℝ E) : Set E) ⊆ cone S) :
    (0 : E) ∈ sri S := by
  have hconeS :
      cone S = (((Submodule.span ℝ S).topologicalClosure : Submodule ℝ E) : Set E) := by
    -- The generic `sri` criterion reduces the goal to the exact cone-equals-closed-span identity.
    exact Set.Subset.antisymm (cone_subset_topologicalClosure_span S) hclosedSpanSubsetCone
  -- Proposition 6.21 packages the closed-span cone identity into the origin-in-`sri` statement.
  exact
    (zero_mem_strongRelativeInterior_iff_cone_eq_closure_span_of_nonempty_convex
      hS_nonempty hS_convex).2 hconeS

/-- Helper for Corollary 25.4: the raw-span core witness forces the origin into the
interior of the closed-hull preimage on the closed span of the projected Fitzpatrick-domain
difference. -/
private theorem zeroMemInterior_closedHullSubtype_of_coneDomSubEqSpan
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B)
    (hcone :
      cone (A.dom - B.dom) = (Submodule.span ℝ (A.dom - B.dom) : Set H)) :
    let D : Set H := A.dom - B.dom
    let C : Set H := convexHull ℝ D
    let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
    let Bc : ClosedSubmodule ℝ H :=
      ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
    let U : Set (Bc : Submodule ℝ H) := Subtype.val ⁻¹' closure C
    (0 : (Bc : Submodule ℝ H)) ∈ interior U := by
  let D : Set H := A.dom - B.dom
  let C : Set H := convexHull ℝ D
  let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
  let V : Submodule ℝ H := Submodule.span ℝ C
  let Bc : ClosedSubmodule ℝ H :=
    ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
  let B0 : Submodule ℝ H := (Bc : Submodule ℝ H)
  let T : Set V := ((↑) : V → H) ⁻¹' S
  let Uraw : Set V := ((↑) : V → H) ⁻¹' closure C
  let U : Set B0 := ((↑) : B0 → H) ⁻¹' closure C
  have h0coreT : (0 : V) ∈ Set.core T := by
    -- The exact-span hypothesis already gives the origin in the core of the raw-span support.
    simpa [D, C, S, V, T] using
      zeroMemCore_spanConvexHullDomSub_preimage_projectedDifference_of_coneDomSubEqSpan
        hA hB hcone
  have hS_subset_closureC : S ⊆ closure C := by
    -- The projected Fitzpatrick-domain difference stays inside the closed hull of the source data.
    simpa [C, S] using projectedFitzpatrickDifference_subset_closureConvexHullDomSub hA hB
  have hC_convex : Convex ℝ C := by
    -- The hull-side carrier is convex by construction.
    simpa [C] using convex_convexHull ℝ D
  have hclosureC_convex : Convex ℝ (closure C) := hC_convex.closure
  have hUraw_convex : Convex ℝ Uraw := by
    -- Pull convexity of the closed hull back along the raw-span subtype inclusion.
    simpa [Uraw] using hclosureC_convex.affine_preimage V.subtype.toAffineMap
  have hUraw_closed : IsClosed Uraw := by
    -- The pulled-back closed hull remains closed on the raw-span carrier.
    simpa [Uraw] using isClosed_closure.preimage V.subtype.continuous
  have h0coreUraw : (0 : V) ∈ Set.core Uraw := by
    -- Enlarging the raw-span support preserves the core witness at the origin.
    exact zeroMemCore_subtypePreimage_mono hS_subset_closureC h0coreT
  have h0intUraw : (0 : V) ∈ interior Uraw := by
    -- For the closed pulled-back hull, core and interior agree.
    have hIntEqCore : interior Uraw = Set.core Uraw := by
      exact interior_eq_core_of_convex hUraw_convex (Or.inr (Or.inl hUraw_closed))
    rw [hIntEqCore]
    exact h0coreUraw
  rw [mem_interior_iff_mem_nhds] at h0intUraw
  rcases Metric.mem_nhds_iff.mp h0intUraw with ⟨ε, hε, hballε⟩
  have hcarrierEq :
      (((V.topologicalClosure : Submodule ℝ H) : Set H)) = (B0 : Set H) := by
    -- Freeze the equality between the hull-side closed span and the projected closed span carrier.
    simpa [C, S, V, Bc, B0] using
      (closedSpanCarrier_eq_closedHullCarrier_of_coneDomSubEqSpan
        (A := A) (B := B) hA hB)
  rw [mem_interior_iff_mem_nhds]
  refine Metric.mem_nhds_iff.mpr ⟨ε, hε, ?_⟩
  intro x hx
  have hxNorm : ‖(x : H)‖ < ε := by
    have hxNorm' : ‖x‖ < ε := by
      simpa [Metric.mem_ball, dist_eq_norm] using hx
    simpa using hxNorm'
  have hxClosureV : (x : H) ∈ closure (V : Set H) := by
    have hxB0 : (x : H) ∈ (B0 : Set H) := x.property
    have hxVclosure : (x : H) ∈ ((V.topologicalClosure : Submodule ℝ H) : Set H) := by
      rw [hcarrierEq]
      exact hxB0
    simpa [Submodule.topologicalClosure_coe] using hxVclosure
  have hxClosureC : (x : H) ∈ closure C := by
    rw [← closure_closure]
    refine Metric.mem_closure_iff.mpr ?_
    intro δ hδ
    let ρ : ℝ := min δ (ε - ‖(x : H)‖)
    have hρ : 0 < ρ := by
      have hxGap : 0 < ε - ‖(x : H)‖ := by
        linarith
      exact lt_min hδ hxGap
    rcases Metric.mem_closure_iff.mp hxClosureV ρ hρ with ⟨y, hyV, hyDist⟩
    have hyNorm : ‖y‖ < ε := by
      have hyDist' : dist y (x : H) < ε - ‖(x : H)‖ := by
        have hyDist'' : dist y (x : H) < ρ := by simpa [dist_comm] using hyDist
        exact lt_of_lt_of_le hyDist'' (min_le_right _ _)
      have hyNormLe : ‖y‖ ≤ dist y (x : H) + ‖(x : H)‖ := by
        simpa [dist_eq_norm, sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
          norm_add_le (y - (x : H)) (x : H)
      linarith
    have hyBall : (⟨y, hyV⟩ : V) ∈ Metric.ball (0 : V) ε := by
      simpa [Metric.mem_ball, dist_eq_norm] using hyNorm
    have hyClosureC : y ∈ closure C := by
      have hyUraw : (⟨y, hyV⟩ : V) ∈ Uraw := hballε hyBall
      simpa [Uraw] using hyUraw
    have hyDistToX : dist y (x : H) < δ := by
      have hyDist'' : dist y (x : H) < ρ := by simpa [dist_comm] using hyDist
      exact lt_of_lt_of_le hyDist'' (min_le_left _ _)
    exact ⟨y, hyClosureC, hyDistToX⟩
  -- The ambient closed-hull witness is exactly the subtype membership needed for `U`.
  simpa [U] using hxClosureC

/-- Helper for Corollary 25.4: the closed-hull interior witness can be normalized to interior on
the literal closed-span subtype of the projected Fitzpatrick-domain difference. -/
private theorem zeroMemInterior_closedSpanSubtype_projectedDifference_of_coneDomSubEqSpan
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B)
    (hcone :
      cone (A.dom - B.dom) = (Submodule.span ℝ (A.dom - B.dom) : Set H)) :
    let D : Set H := A.dom - B.dom
    let C : Set H := convexHull ℝ D
    let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
    let Bc : ClosedSubmodule ℝ H :=
      ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
    let T : Set (Bc : Submodule ℝ H) := Subtype.val ⁻¹' S
    (0 : (Bc : Submodule ℝ H)) ∈ interior T := by
  let D : Set H := A.dom - B.dom
  let C : Set H := convexHull ℝ D
  let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
  let Bc : ClosedSubmodule ℝ H :=
    ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
  let B0 : Submodule ℝ H := (Bc : Submodule ℝ H)
  let T : Set B0 := ((↑) : B0 → H) ⁻¹' S
  let U : Set B0 := ((↑) : B0 → H) ⁻¹' closure C
  have h0intU : (0 : B0) ∈ interior U := by
    -- Reuse the already-proved closed-hull interior witness on the fixed closed-span carrier.
    simpa [D, C, S, Bc, B0, U] using
      zeroMemInterior_closedHullSubtype_of_coneDomSubEqSpan hA hB hcone
  have hclosureTU : closure T = U := by
    -- Route correction: rewrite the closed-hull subtype closure to the literal projected surface
    -- instead of rebuilding the older raw-span transport argument.
    simpa [D, C, S, Bc, B0, T, U] using
      closureClosedSpanSubtype_projectedFitzpatrickDifference_eq_closedHullSubtype_of_coneDomSubEqSpan
        hA hB hcone
  have hT_convex : Convex ℝ T := by
    -- Pull convexity of the projected surface back along the closed-span subtype inclusion.
    simpa [S, Bc, B0, T] using
      ((convexFstImageDomFitzpatrickOfMaximal A hA).sub
        (convexFstImageDomFitzpatrickOfMaximal B hB)).affine_preimage B0.subtype.toAffineMap
  have hIntEq : interior U = interior T := by
    -- Convex sets with nonempty interior have the same interior as their closure.
    calc
      interior U = interior (closure T) := by rw [hclosureTU]
      _ = interior T := by
        exact interior_closure_eq_interior_of_convex_nonempty_interior hT_convex ⟨0, h0intU⟩
  -- Transport the interior witness back to the literal projected support on the same carrier.
  simpa [hIntEq] using h0intU

/-- Helper for Corollary 25.4: interior at the origin on the closed-span subtype forces the whole
closed span of the ambient convex set into its cone. -/
private theorem closedSpanSubsetCone_of_zeroMemInteriorClosedSpanSubtype
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    {S : Set E} (hS_convex : Convex ℝ S)
    (h0int :
      let B : ClosedSubmodule ℝ E :=
        ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
      let T : Set (B : Submodule ℝ E) := Subtype.val ⁻¹' S
      (0 : (B : Submodule ℝ E)) ∈ interior T) :
    (((Submodule.span ℝ S).topologicalClosure : Submodule ℝ E) : Set E) ⊆ cone S := by
  let B : ClosedSubmodule ℝ E :=
    ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
  let B0 : Submodule ℝ E := (B : Submodule ℝ E)
  let T : Set B0 := ((↑) : B0 → E) ⁻¹' S
  have h0intT : (0 : B0) ∈ interior T := by
    -- Freeze the closed-span subtype interior witness with explicit carrier names.
    simpa [B, B0, T] using h0int
  have hT_convex : Convex ℝ T := by
    -- Pull convexity of `S` back to the closed-span subtype.
    simpa [B, B0, T] using hS_convex.affine_preimage B0.subtype.toAffineMap
  have hconeInteriorT : cone (interior T) = (Set.univ : Set B0) := by
    -- Proposition 6.17 turns interior at the origin into a full cone on the subtype interior.
    exact Set.cone_interior_eq_univ_of_zero_mem_interior hT_convex h0intT
  have hconeT : cone T = (Set.univ : Set B0) := by
    apply Set.Subset.antisymm
    · simp
    · intro v hv
      have hvInterior : v ∈ cone (interior T) := by
        simpa [hconeInteriorT] using (show v ∈ (Set.univ : Set B0) from by simp)
      exact
        ConvexCone.hull_min
          (C := ConvexCone.hull ℝ T)
          (fun x hx ↦ ConvexCone.subset_hull (interior_subset hx))
          hvInterior
  intro x hx
  let xB : B0 := ⟨x, hx⟩
  have hxConeT : xB ∈ cone T := by
    -- Evaluate the subtype cone equality at the chosen closed-span vector.
    simpa [hconeT] using (show xB ∈ (Set.univ : Set B0) from by simp)
  -- Push the subtype cone statement back to the ambient carrier.
  exact (memConeClosedSpanSubtypePreimage_iff (E := E) (S := S) hS_convex).1 hxConeT

/-- Helper for Corollary 25.4: the exact-span hypothesis yields strong-relative-interior
regularity on the projected Fitzpatrick-domain difference. -/
private theorem zeroMemSri_projectedFitzpatrickDifference_of_coneDomSubEqSpan
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B)
    (hcone :
      cone (A.dom - B.dom) = (Submodule.span ℝ (A.dom - B.dom) : Set H)) :
    (0 : H) ∈ sri (A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick) := by
  let S : Set H := A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick
  let Bc : ClosedSubmodule ℝ H :=
    ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
  let B0 : Submodule ℝ H := (Bc : Submodule ℝ H)
  let T : Set B0 := ((↑) : B0 → H) ⁻¹' S
  have hS_convex : Convex ℝ S := by
    -- The projected Fitzpatrick-domain difference is convex because each projected domain is convex.
    dsimp [S]
    exact
      (convexFstImageDomFitzpatrickOfMaximal A hA).sub
        (convexFstImageDomFitzpatrickOfMaximal B hB)
  have h0intClosedSpan :
      let B : ClosedSubmodule ℝ H :=
        ⟨(Submodule.span ℝ S).topologicalClosure, Submodule.isClosed_topologicalClosure _⟩
      let T : Set (B : Submodule ℝ H) := Subtype.val ⁻¹' S
      (0 : (B : Submodule ℝ H)) ∈ interior T := by
    -- Normalize the existing closed-hull interior witness to the literal projected surface.
    simpa [S] using
      zeroMemInterior_closedSpanSubtype_projectedDifference_of_coneDomSubEqSpan hA hB hcone
  have h0intT : (0 : B0) ∈ interior T := by
    -- Use explicit carrier names for the subtype interior witness needed downstream.
    simpa [Bc, B0, T] using h0intClosedSpan
  have h0S : (0 : H) ∈ S := by
    -- The subtype interior witness already certifies that the ambient origin lies on the surface.
    simpa [T] using (interior_subset h0intT)
  have hS_nonempty : S.Nonempty := ⟨0, h0S⟩
  have hclosedSpanSubsetCone :
      (((Submodule.span ℝ S).topologicalClosure : Submodule ℝ H) : Set H) ⊆ cone S := by
    -- The closed-span subtype interior witness gives the exact cone inclusion used by the `sri`
    -- owner criterion.
    exact
      closedSpanSubsetCone_of_zeroMemInteriorClosedSpanSubtype
        (E := H) (S := S) hS_convex h0intClosedSpan
  -- Proposition 6.21 packages the closed-span cone identity into the projected `sri` witness.
  simpa [S] using zeroMemSri_of_closedSpanSubsetCone hS_nonempty hS_convex hclosedSpanSubsetCone

/-- Helper for Corollary 25.4: the projected Fitzpatrick-domain difference is exactly the same
owner surface used by the Chapter 25 projected-`sri` sum theorem. -/
private theorem zeroMemSri_ownerSurface_of_zeroMemSriProjectedDifference
    {A B : SetValuedOperator H H}
    (hsri :
      (0 : H) ∈ sri (A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick)) :
    (0 : H) ∈
      sri (Prod.fst '' (ERealFunction.dom (F[A]) - ERealFunction.dom (F[B]))) := by
  -- Normalize the projected Fitzpatrick-domain difference to the Chapter 25 owner spelling once.
  simpa [fstImageDomFitzpatrick, fstImageSub_eq_sub_fstImage] using hsri

/-- Helper for Corollary 25.4: once the projected Fitzpatrick-domain difference contains the
origin in its strong relative interior, the Chapter 25 projected-`sri` owner theorem closes the
maximal-sum statement. -/
private theorem maximalAdd_of_zeroMemSri_projectedDifference
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B)
    (hsri :
      (0 : H) ∈ sri (A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick)) :
    Maximal IsMonotone (A + B) := by
  -- Route correction: stop at the projected `sri` frontier and apply the dedicated same-space
  -- owner theorem instead of downgrading to `ri` and rebuilding the older endpoint.
  exact
    Maximal.add_of_zero_mem_sri_fst_image_dom_fitzpatrick_sub
      hA hB (zeroMemSri_ownerSurface_of_zeroMemSriProjectedDifference hsri)

/-- Corollary 25.4: let `A` and `B` be maximally monotone operators from `H → 2^H` such that
`cone (dom A - dom B) = span (dom A - dom B)`; then `A + B` is maximally monotone. -/
theorem Maximal.add_of_cone_dom_sub_eq_span
    {A B : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hB : Maximal IsMonotone B)
    (hcone :
      cone (A.dom - B.dom) = (Submodule.span ℝ (A.dom - B.dom) : Set H)) :
    Maximal IsMonotone (A + B) := by
  have hsriProjected :
      (0 : H) ∈ sri (A.fstImageDomFitzpatrick - B.fstImageDomFitzpatrick) := by
    -- Route correction: the local geometry already reaches projected `sri`, so the final proof
    -- now stops there and avoids the older projected-`ri` downgrade tail.
    exact zeroMemSri_projectedFitzpatrickDifference_of_coneDomSubEqSpan hA hB hcone
  -- Once the projected `sri` witness is available, the Chapter 25 owner theorem closes directly.
  exact maximalAdd_of_zeroMemSri_projectedDifference hA hB hsriProjected

end

