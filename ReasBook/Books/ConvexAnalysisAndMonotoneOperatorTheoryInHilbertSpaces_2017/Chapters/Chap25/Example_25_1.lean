open scoped InnerProductSpace Pointwise SetValuedOperator
open SetValuedOperator

universe u

namespace Set

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
variable {x : H}

local notation "C" => Metric.closedBall x ‖x‖
local notation "D" => (-(C : Set H))

/- Source/core/bridge triage:
- `source-facing`: Example 25.1 fixes `C = Metric.closedBall x ‖x‖` and `D = -C` for a nonzero
  vector `x` in a real Hilbert space of rank greater than `1`, then concludes that `N[C] + N[D]`
  is not maximally monotone.
- `core/canonical`: the public owner is the Chapter 20 maximal-monotonicity predicate
  `Maximal IsMonotone` on the bundled operator sum `N[C] + N[D]`.
- `bridge/view`: the local notation `C` and `D` preserves the textbook setup without introducing
  wrapper definitions.

Primitive data: the nonzero vector `x`, the ambient rank bound `1 < Module.rank ℝ H`, and the
resulting opposite tangent closed balls `C` and `D`.
Derived API: the order-theoretic owner `Maximal IsMonotone` applied to the canonical normal-cone
operators `N[C]` and `N[D]`.

Semantic recall: the owner choice is read directly from the canonical declarations
`Set.normalCone`/`N[_]` in Chapter 6 and `Maximal`/`SetValuedOperator.IsMonotone` in
Chapter 20, so no downstream example wrapper import is needed here. -/

omit [InnerProductSpace ℝ H] in
/-- Helper for Example 25.1: subtracting the singleton `{0}` leaves a set unchanged. -/
private theorem sub_singleton_zero_eq_self_of_set {E : Type*} [AddGroup E] (S : Set E) :
    S - ({(0 : E)} : Set E) = S := by
  -- Expand the set subtraction and use the unique element of `{0}`.
  ext z
  constructor
  · intro hz
    rcases Set.mem_sub.mp hz with ⟨u, hu, v, hv, huv⟩
    have hv_zero : v = 0 := by
      simpa using hv
    have huz : u = z := by
      simpa [hv_zero] using huv
    simpa [huz] using hu
  · intro hz
    exact Set.mem_sub.mpr ⟨z, hz, 0, by simp, by simp⟩

/-- Helper for Example 25.1: the reflected closed ball `D = -C` is the closed ball centered at
`-x` with the same radius. -/
private theorem neg_closedBall_eq_closedBall_neg :
    (D : Set H) = Metric.closedBall (-x) ‖x‖ := by
  -- Rewrite membership in `-C` by negating the point, then identify the transported distance.
  ext y
  have hdist : dist (-y) x = dist y (-x) := by
    simpa using (dist_neg_neg y (-x))
  constructor
  · intro hy
    rw [Set.mem_neg, Metric.mem_closedBall] at hy
    rw [Metric.mem_closedBall]
    rw [← hdist]
    exact hy
  · intro hy
    rw [Set.mem_neg, Metric.mem_closedBall]
    rw [Metric.mem_closedBall] at hy
    rw [hdist]
    exact hy

/-- Helper for Example 25.1: the two tangent closed balls meet only at the origin. -/
private theorem closedBall_inter_neg_closedBall_eq_singleton_zero :
    C ∩ D = ({0} : Set H) := by
  ext z
  constructor
  · intro hz
    rcases hz with ⟨hzC, hzD⟩
    rw [neg_closedBall_eq_closedBall_neg, Metric.mem_closedBall, dist_eq_norm] at hzD
    rw [Metric.mem_closedBall, dist_eq_norm] at hzC
    have hzD' : ‖z + x‖ ≤ ‖x‖ := by
      simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hzD
    have hzC_sq : ‖z - x‖ * ‖z - x‖ ≤ ‖x‖ * ‖x‖ := by
      nlinarith [hzC, norm_nonneg (z - x), norm_nonneg x]
    have hzD_sq : ‖z + x‖ * ‖z + x‖ ≤ ‖x‖ * ‖x‖ := by
      nlinarith [hzD', norm_nonneg (z + x), norm_nonneg x]
    have hz_sq_nonpos : ‖z‖ * ‖z‖ ≤ 0 := by
      nlinarith [hzC_sq, hzD_sq, norm_sub_mul_self_real z x, norm_add_mul_self_real z x]
    have hz_norm_zero : ‖z‖ = 0 := by
      nlinarith [norm_nonneg z, hz_sq_nonpos]
    have hz_zero : z = 0 := norm_eq_zero.mp hz_norm_zero
    simpa [hz_zero]
  · rintro rfl
    constructor
    · -- The origin is the touching point of the first ball.
      simpa [Metric.mem_closedBall, dist_eq_norm]
    · -- The origin is also the touching point of the reflected ball.
      rw [neg_closedBall_eq_closedBall_neg]
      simpa [Metric.mem_closedBall, dist_eq_norm]

/-- Helper for Example 25.1: at the tangency point `0`, the normal cone of
`Metric.closedBall x ‖x‖` is the nonnegative ray generated by `-x`. -/
private theorem normalCone_tangentClosedBall_at_origin_eq_negativeRay (hx : x ≠ 0) :
    Set.normalCone (Metric.closedBall x ‖x‖) (0 : H) = Set.Ici (0 : ℝ) • ({-x} : Set H) := by
  have h0C : (0 : H) ∈ Metric.closedBall x ‖x‖ := by
    -- The radius was chosen so that the ball passes through the origin.
    simpa [Metric.mem_closedBall, dist_eq_norm]
  ext u
  constructor
  · intro hu
    rw [Set.normalCone_eq_polarCone_translate_of_mem h0C, sub_singleton_zero_eq_self_of_set,
      Set.mem_polarCone_iff_forall_inner_nonpos] at hu
    by_cases hu_zero : u = 0
    · subst hu_zero
      exact ⟨0, by simp, -x, by simp, by simp⟩
    · have hu_norm_ne : ‖u‖ ≠ 0 := norm_ne_zero_iff.mpr hu_zero
      have hx_norm_ne : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
      have hunit_norm : ‖‖u‖⁻¹ • u‖ = 1 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (inv_nonneg.mpr (norm_nonneg u))]
        field_simp [hu_norm_ne]
      have hy_mem : x + ‖x‖ • (‖u‖⁻¹ • u) ∈ Metric.closedBall x ‖x‖ := by
        -- Move to the boundary point in the direction of `u`.
        rw [Metric.mem_closedBall, dist_eq_norm]
        calc
          ‖(x + ‖x‖ • (‖u‖⁻¹ • u)) - x‖ = ‖‖x‖ • (‖u‖⁻¹ • u)‖ := by abel_nf
          _ = ‖x‖ * ‖‖u‖⁻¹ • u‖ := by
            rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg x)]
          _ = ‖x‖ := by rw [hunit_norm, mul_one]
          _ ≤ ‖x‖ := le_rfl
      have hnormalized_inner : ⟪‖u‖⁻¹ • u, u⟫_ℝ = ‖u‖ := by
        rw [real_inner_smul_left, real_inner_self_eq_norm_sq]
        field_simp [hu_norm_ne]
      have hbound : ⟪x, u⟫_ℝ + ‖x‖ * ‖u‖ ≤ 0 := by
        calc
          ⟪x, u⟫_ℝ + ‖x‖ * ‖u‖ = ⟪x + ‖x‖ • (‖u‖⁻¹ • u), u⟫_ℝ := by
            rw [inner_add_left, real_inner_smul_left, hnormalized_inner]
          _ ≤ 0 := hu _ hy_mem
      have hinner_le : ⟪-x, u⟫_ℝ ≤ ‖-x‖ * ‖u‖ := real_inner_le_norm (-x) u
      have hinner_ge : ‖-x‖ * ‖u‖ ≤ ⟪-x, u⟫_ℝ := by
        have : ‖x‖ * ‖u‖ ≤ -⟪x, u⟫_ℝ := by
          nlinarith [hbound]
        simpa [inner_neg_left, norm_neg] using this
      have hcollinear : ‖u‖ • (-x) = ‖-x‖ • u :=
        (inner_eq_norm_mul_iff_real.mp (le_antisymm hinner_le hinner_ge))
      refine ⟨‖x‖⁻¹ * ‖u‖, by
        show 0 ≤ ‖x‖⁻¹ * ‖u‖
        positivity, -x, by simp, ?_⟩
      calc
        (‖x‖⁻¹ * ‖u‖) • (-x) = ‖x‖⁻¹ • (‖u‖ • (-x)) := by
          rw [smul_smul, mul_comm]
        _ = ‖x‖⁻¹ • (‖-x‖ • u) := by rw [hcollinear]
        _ = u := by
          rw [norm_neg, smul_smul, inv_mul_cancel₀ hx_norm_ne, one_smul]
  · rintro ⟨a, ha, z, hz, rfl⟩
    have hz' : z = -x := by
      simpa using hz
    subst hz'
    rw [Set.normalCone_eq_polarCone_translate_of_mem h0C, sub_singleton_zero_eq_self_of_set,
      Set.mem_polarCone_iff_forall_inner_nonpos]
    intro y hy
    have hy_norm : ‖y - x‖ ≤ ‖x‖ := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hy
    have hy_sq : ‖y - x‖ * ‖y - x‖ ≤ ‖x‖ * ‖x‖ := by
      nlinarith [hy_norm, norm_nonneg (y - x), norm_nonneg x]
    have hy_inner_nonneg : 0 ≤ ⟪y, x⟫_ℝ := by
      have hy_aux : ‖y‖ * ‖y‖ - 2 * ⟪y, x⟫_ℝ ≤ 0 := by
        nlinarith [hy_sq, norm_sub_mul_self_real y x]
      have hy_nonneg : 0 ≤ ‖y‖ * ‖y‖ := by
        positivity
      nlinarith [hy_nonneg, hy_aux]
    -- The sign of the inner product follows from the nonnegativity of `a`.
    rw [inner_smul_right, inner_neg_right]
    have hy_inner_nonpos : -⟪y, x⟫_ℝ ≤ 0 := by
      linarith
    exact mul_nonpos_of_nonneg_of_nonpos ha hy_inner_nonpos

/-- Helper for Example 25.1: every point in the domain of `N[C] + N[D]` is the origin. -/
private theorem sum_normalCone_dom_eq_singleton_zero :
    SetValuedOperator.dom (N[C] + N[D] : SetValuedOperator H H) = ({0} : Set H) := by
  ext z
  constructor
  · intro hz
    rcases (SetValuedOperator.mem_dom_iff (N[C] + N[D] : SetValuedOperator H H) z).1 hz with
      ⟨u, hu⟩
    rcases Set.mem_add.mp hu with ⟨uC, huC, uD, huD, rfl⟩
    have hzC : z ∈ C := by
      rw [Set.normalCone] at huC
      exact huC.1
    have hzD : z ∈ D := by
      rw [Set.normalCone] at huD
      exact huD.1
    have hz_zero : z = 0 := by
      have hz_inter : z ∈ C ∩ D := ⟨hzC, hzD⟩
      rwa [closedBall_inter_neg_closedBall_eq_singleton_zero] at hz_inter
    simpa [hz_zero]
  · rintro rfl
    have h0C : (0 : H) ∈ C := by
      simpa [Metric.mem_closedBall, dist_eq_norm]
    have h0D : (0 : H) ∈ D := by
      rw [neg_closedBall_eq_closedBall_neg]
      simpa [Metric.mem_closedBall, dist_eq_norm]
    have hzeroC : (0 : H) ∈ N[C] (0 : H) := by
      rw [Set.normalCone_eq_polarCone_translate_of_mem h0C, sub_singleton_zero_eq_self_of_set,
        Set.mem_polarCone_iff_forall_inner_nonpos]
      intro y hy
      simp
    have h0D' : (0 : H) ∈ Metric.closedBall (-x) ‖x‖ := by
      rw [neg_closedBall_eq_closedBall_neg] at h0D
      exact h0D
    have hzeroD' : (0 : H) ∈ Set.normalCone (Metric.closedBall (-x) ‖x‖) (0 : H) := by
      rw [Set.normalCone_eq_polarCone_translate_of_mem h0D', sub_singleton_zero_eq_self_of_set,
        Set.mem_polarCone_iff_forall_inner_nonpos]
      intro y hy
      simp
    have hzeroD : (0 : H) ∈ N[D] (0 : H) := by
      simpa [neg_closedBall_eq_closedBall_neg] using hzeroD'
    refine (SetValuedOperator.mem_dom_iff (N[C] + N[D] : SetValuedOperator H H) (0 : H)).2 ?_
    refine ⟨0, Set.mem_add.mpr ?_⟩
    exact ⟨0, hzeroC, 0, hzeroD, by simp⟩

/-- Helper for Example 25.1: the value of `N[C] + N[D]` at the origin lies in the line `ℝ ∙ x`. -/
private theorem sum_normalCone_at_origin_subset_span_singleton (hx : x ≠ 0) :
    ((N[C] + N[D]) (0 : H)) ⊆ (↑(ℝ ∙ x) : Set H) := by
  intro u hu
  rcases Set.mem_add.mp hu with ⟨uC, huC, uD, huD, rfl⟩
  rw [normalCone_tangentClosedBall_at_origin_eq_negativeRay hx] at huC
  have hnegRay :
      Set.normalCone (Metric.closedBall (-x) ‖x‖) (0 : H) = Set.Ici (0 : ℝ) • ({x} : Set H) := by
    simpa [norm_neg] using
      (normalCone_tangentClosedBall_at_origin_eq_negativeRay
        (x := -x) (by simpa using neg_ne_zero.mpr hx))
  rw [neg_closedBall_eq_closedBall_neg, hnegRay] at huD
  rcases huC with ⟨a, ha, zC, hzC, rfl⟩
  rcases huD with ⟨b, hb, zD, hzD, rfl⟩
  have hzC' : zC = -x := by
    simpa using hzC
  have hzD' : zD = x := by
    simpa using hzD
  have hu_eq : a • zC + b • zD = (b - a) • x := by
    subst hzC' hzD'
    simp [sub_eq_add_neg, add_comm, add_left_comm, add_assoc, add_smul, smul_add]
  exact (Submodule.mem_span_singleton).2 ⟨b - a, hu_eq.symm⟩

/-- Example 25.1: if `x ≠ 0`, the ambient real Hilbert space has rank greater than `1`,
`C = Metric.closedBall x ‖x‖`, and `D = -C`, then the sum of the two normal-cone operators
`N[C] + N[D]` is not maximally monotone. -/
theorem normalCone_closedBall_add_neg_not_maximallyMonotone_of_ne_zero_of_one_lt_rank
    (hx : x ≠ 0) (h_dim : 1 < Module.rank ℝ H) :
    ¬ Maximal IsMonotone (N[C] + N[D]) := by
  -- Route correction: rather than use the later Minty-surjectivity route, compute the domain and
  -- the origin fiber directly and then refute maximality via `maximal_iff_mem_iff`.
  intro hmax
  obtain ⟨y, hy_ne, hy_orth⟩ :=
    Set.exists_nonzero_mem_orthogonal_span_singleton_of_rank_gt_one hx h_dim
  have hy_not_span : y ∉ (↑(ℝ ∙ x) : Set H) := by
    intro hy_span
    rcases (Submodule.mem_span_singleton.mp hy_span) with ⟨a, rfl⟩
    have hy_inner_zero : ⟪a • x, x⟫_ℝ = 0 := by
      exact Submodule.mem_orthogonal_singleton_iff_inner_left.mp hy_orth
    have hx_norm_sq_pos : 0 < ‖x‖ ^ 2 := by
      have hx_norm_pos : 0 < ‖x‖ := norm_pos_iff.mpr hx
      positivity
    rw [real_inner_smul_left, real_inner_self_eq_norm_sq] at hy_inner_zero
    have ha_zero : a = 0 := by
      nlinarith
    exact hy_ne (by simpa [ha_zero])
  have hy_not_mem : y ∉ (N[C] + N[D]) (0 : H) := by
    intro hy_mem
    exact hy_not_span (sum_normalCone_at_origin_subset_span_singleton hx hy_mem)
  rw [SetValuedOperator.maximal_iff_mem_iff] at hmax
  have hy_minty :
      ∀ ⦃z v : H⦄, v ∈ (N[C] + N[D]) z → 0 ≤ ⟪(0 : H) - z, y - v⟫_ℝ := by
    intro z v hv
    have hz_dom : z ∈ SetValuedOperator.dom (N[C] + N[D] : SetValuedOperator H H) :=
      (SetValuedOperator.mem_dom_iff (N[C] + N[D] : SetValuedOperator H H) z).2 ⟨v, hv⟩
    have hz_zero : z = 0 := by
      rw [sum_normalCone_dom_eq_singleton_zero] at hz_dom
      have hz_singleton : z ∈ ({0} : Set H) := hz_dom
      simpa using hz_singleton
    subst hz_zero
    simp
  exact hy_not_mem ((hmax (0 : H) y).2 hy_minty)

end

end Set
