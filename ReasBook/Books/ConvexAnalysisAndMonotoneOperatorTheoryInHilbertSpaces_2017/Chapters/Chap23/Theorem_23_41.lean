-- Semantic recall note: `lean_leansearch` did not surface a proximal-point owner for this theorem,
-- so this file uses the verified local Chapter 23 resolvent map `resolventMap`, the zero-set
-- owner `A.zeros`, and the Chapter 22 localized owner `A.IsUniformlyMonotoneOn`.

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The variable-step proximal-point iteration generated by `A`, `γ`, and `x0`, i.e.
`x 0 = x0` and `x (n + 1) = resolventMap A hA (γ n) (x n)`. -/
noncomputable def proximalPointAlgorithm
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : ℕ → PosReal) (x0 : H) :
    ℕ → H
  | 0 => x0
  | n + 1 => resolventMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n)

/-- The variable-step proximal-point iteration starts at the prescribed initial point. -/
@[simp] theorem proximalPointAlgorithm_zero
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : ℕ → PosReal) (x0 : H) :
    proximalPointAlgorithm A hA γ x0 0 = x0 := rfl

/-- The variable-step proximal-point iteration satisfies its defining resolvent recursion. -/
@[simp] theorem proximalPointAlgorithm_succ
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : ℕ → PosReal)
    (x0 : H) (n : ℕ) :
    proximalPointAlgorithm A hA γ x0 (n + 1) =
      resolventMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) :=
  rfl

/-- A sequence `x` is the proximal-point iteration for `A` with step sizes `γ` and initial point
`x0` when it matches the canonical recursively defined variable-step proximal-point iteration. -/
def IsProximalPointAlgorithm (A : SetValuedOperator H H) (hA : Maximal IsMonotone A)
    (γ : ℕ → PosReal)
    (x0 : H) (x : ℕ → H) : Prop :=
  x 0 = x0 ∧ ∀ n : ℕ, x (n + 1) = resolventMap A hA (γ n) (x n)

/-- The canonical variable-step proximal-point iteration satisfies the source recursion. -/
theorem isProximalPointAlgorithm_proximalPointAlgorithm
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : ℕ → PosReal) (x0 : H) :
    IsProximalPointAlgorithm A hA γ x0 (proximalPointAlgorithm A hA γ x0) := by
  constructor
  · simp
  · intro n
    simp

/-- A sequence satisfying the source recursion is the canonical variable-step proximal-point
iteration. -/
theorem IsProximalPointAlgorithm.eq_proximalPointAlgorithm
    {A : SetValuedOperator H H} {hA : Maximal IsMonotone A} {γ : ℕ → PosReal} {x0 : H}
    {x : ℕ → H} (hx : IsProximalPointAlgorithm A hA γ x0 x) :
    x = proximalPointAlgorithm A hA γ x0 := by
  funext n
  induction n with
  | zero =>
      exact hx.1
  | succ n ih =>
      rw [hx.2 n, proximalPointAlgorithm_succ, ih]

/-- Source recursion and equality with the canonical variable-step proximal-point iteration are
equivalent descriptions of the same sequence. -/
theorem isProximalPointAlgorithm_iff_eq_proximalPointAlgorithm
    {A : SetValuedOperator H H} {hA : Maximal IsMonotone A} {γ : ℕ → PosReal} {x0 : H}
    {x : ℕ → H} :
    IsProximalPointAlgorithm A hA γ x0 x ↔ x = proximalPointAlgorithm A hA γ x0 := by
  constructor
  · exact IsProximalPointAlgorithm.eq_proximalPointAlgorithm
  · rintro rfl
    exact isProximalPointAlgorithm_proximalPointAlgorithm A hA γ x0

omit [CompleteSpace H] in
/-- Helper for Theorem 23.41: subtracting a strongly null residual preserves the weak limit of a
sequence in `H`. -/
private theorem tendstoWeaklyOfSubTendstoZeroSeq
    {aSeq bSeq : ℕ → H} {a : H}
    (ha :
      Tendsto (fun n ↦ toWeakSpace ℝ H (aSeq n)) atTop
        (𝓝 (toWeakSpace ℝ H a)))
    (hsub : Tendsto (fun n ↦ aSeq n - bSeq n) atTop (𝓝 (0 : H))) :
    Tendsto (fun n ↦ toWeakSpace ℝ H (bSeq n)) atTop
      (𝓝 (toWeakSpace ℝ H a)) := by
  -- Send the strong residual through `toWeakSpace`, then subtract it from the weakly convergent
  -- ambient sequence.
  have hsubWeak :
      Tendsto (fun n ↦ toWeakSpace ℝ H (aSeq n - bSeq n)) atTop
        (𝓝 (toWeakSpace ℝ H (0 : H))) := by
    simpa [toWeakSpaceCLM_eq_toWeakSpace] using
      ((toWeakSpaceCLM ℝ H).continuous.tendsto (0 : H)).comp hsub
  have hdiff :
      Tendsto
        (fun n ↦ toWeakSpace ℝ H (aSeq n) - toWeakSpace ℝ H (aSeq n - bSeq n))
        atTop
        (𝓝 (toWeakSpace ℝ H a - toWeakSpace ℝ H (0 : H))) :=
    ha.sub hsubWeak
  -- The ambient subtraction is exactly the desired weak image of `bSeq`.
  simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hdiff

/-- Helper for Theorem 23.41: each proximal-point step produces the graph point
`(x_{n+1}, u_n) ∈ gra A` and the residual identity `x_n - x_{n+1} = γ_n u_n`. -/
private theorem proximalPointYosidaStep_spec
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) {γ : ℕ → PosReal}
    (x0 : H) (n : ℕ) :
    let x := proximalPointAlgorithm A hA γ x0
    let u := fun k ↦ yosidaApproximationMap A hA (γ k) (x k)
    (x (n + 1), u n) ∈ gra A ∧ x n - x (n + 1) = (γ n : ℝ) • u n := by
  dsimp
  have hu_mem :
      yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) ∈
        yosidaApproximation A (γ n) (proximalPointAlgorithm A hA γ x0 n) := by
    rw [yosidaApproximation_eq_singleton_yosidaApproximationMap_of_maximal A hA]
    simp
  have hu_mem_A :
      yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) ∈
        A
          (proximalPointAlgorithm A hA γ x0 n -
            (γ n : ℝ) • yosidaApproximationMap A hA (γ n)
              (proximalPointAlgorithm A hA γ x0 n)) :=
    (mem_yosidaApproximation_iff_mem A (γ n)
      (proximalPointAlgorithm A hA γ x0 n)
      (yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n))).1 hu_mem
  have hstep :
      proximalPointAlgorithm A hA γ x0 n -
          proximalPointAlgorithm A hA γ x0 (n + 1) =
        (γ n : ℝ) • yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) := by
    rw [proximalPointAlgorithm_succ, yosidaApproximationMap_apply A hA (γ n)]
    simp [smul_smul, (γ n).2.ne']
  have hres_eq :
      proximalPointAlgorithm A hA γ x0 n -
          (γ n : ℝ) • yosidaApproximationMap A hA (γ n)
            (proximalPointAlgorithm A hA γ x0 n) =
        proximalPointAlgorithm A hA γ x0 (n + 1) := by
    rw [proximalPointAlgorithm_succ, yosidaApproximationMap_apply A hA (γ n)]
    simp [smul_smul, (γ n).2.ne', sub_eq_add_neg, add_comm]
  have hu_mem_next :
      yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) ∈
        A (proximalPointAlgorithm A hA γ x0 (n + 1)) := by
    rw [hres_eq] at hu_mem_A
    simpa using hu_mem_A
  refine ⟨?_, ?_⟩
  · rw [SetValuedOperator.mem_graph]
    exact hu_mem_next
  · simpa [yosidaApproximationMap_apply A hA (γ n)] using hstep

/-- Helper for Theorem 23.41: the Yosida residual norms along the proximal-point orbit are
antitone. -/
private theorem norm_proximalPointYosida_antitone
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) {γ : ℕ → PosReal}
    (x0 : H) :
    let x := proximalPointAlgorithm A hA γ x0
    let u := fun k ↦ yosidaApproximationMap A hA (γ k) (x k)
    Antitone (fun n ↦ ‖u n‖) := by
  dsimp
  refine antitone_nat_of_succ_le fun n ↦ ?_
  rcases proximalPointYosidaStep_spec (A := A) (γ := γ) hA x0 n with ⟨hgraph_n, hstep_n⟩
  rcases proximalPointYosidaStep_spec (A := A) (γ := γ) hA x0 (n + 1) with
    ⟨hgraph_succ, hstep_succ⟩
  have hmono :
      0 ≤
        inner ℝ
          (proximalPointAlgorithm A hA γ x0 (n + 1) -
            proximalPointAlgorithm A hA γ x0 (n + 2))
          (yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) -
            yosidaApproximationMap A hA (γ (n + 1))
              (proximalPointAlgorithm A hA γ x0 (n + 1))) :=
    (isMonotone_iff A).1 hA.1 hgraph_n hgraph_succ
  have hinner_nonneg :
      0 ≤
        inner ℝ
          (yosidaApproximationMap A hA (γ (n + 1))
            (proximalPointAlgorithm A hA γ x0 (n + 1)))
          (yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) -
            yosidaApproximationMap A hA (γ (n + 1))
              (proximalPointAlgorithm A hA γ x0 (n + 1))) := by
    have hγpos : 0 < (γ (n + 1) : ℝ) := (γ (n + 1)).2
    rw [hstep_succ, real_inner_smul_left] at hmono
    have hmono' :
        0 ≤
          (γ (n + 1) : ℝ) *
            inner ℝ
              (yosidaApproximationMap A hA (γ (n + 1))
                (proximalPointAlgorithm A hA γ x0 (n + 1)))
              (yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) -
                yosidaApproximationMap A hA (γ (n + 1))
                  (proximalPointAlgorithm A hA γ x0 (n + 1))) := by
      simpa [mul_comm] using hmono
    nlinarith
  have hsq_le_inner :
      ‖yosidaApproximationMap A hA (γ (n + 1))
          (proximalPointAlgorithm A hA γ x0 (n + 1))‖ ^ 2 ≤
        inner ℝ
          (yosidaApproximationMap A hA (γ (n + 1))
            (proximalPointAlgorithm A hA γ x0 (n + 1)))
          (yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) : H) := by
    have hrewrite :
        inner ℝ
            (yosidaApproximationMap A hA (γ (n + 1))
              (proximalPointAlgorithm A hA γ x0 (n + 1)))
            (yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n) -
              yosidaApproximationMap A hA (γ (n + 1))
                (proximalPointAlgorithm A hA γ x0 (n + 1))) =
          inner ℝ
              (yosidaApproximationMap A hA (γ (n + 1))
                (proximalPointAlgorithm A hA γ x0 (n + 1)))
              (yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n)) -
            ‖yosidaApproximationMap A hA (γ (n + 1))
                (proximalPointAlgorithm A hA γ x0 (n + 1))‖ ^ 2 := by
      rw [inner_sub_right, real_inner_self_eq_norm_sq]
    nlinarith [hinner_nonneg, hrewrite]
  have hsq_le_mul :
      ‖yosidaApproximationMap A hA (γ (n + 1))
          (proximalPointAlgorithm A hA γ x0 (n + 1))‖ ^ 2 ≤
        ‖yosidaApproximationMap A hA (γ (n + 1))
            (proximalPointAlgorithm A hA γ x0 (n + 1))‖ *
          ‖yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n)‖ := by
    exact le_trans hsq_le_inner (real_inner_le_norm _ _)
  let a :=
    ‖yosidaApproximationMap A hA (γ (n + 1))
        (proximalPointAlgorithm A hA γ x0 (n + 1))‖
  let b :=
    ‖yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n)‖
  change a ≤ b
  have hsq_le_mul' : a ^ 2 ≤ a * b := by
    simpa [a, b] using hsq_le_mul
  have ha_nonneg : 0 ≤ a := by
    simp [a]
  by_cases hzero : a = 0
  · simp [a, b, hzero]
  · have hpos : 0 < a :=
      lt_of_le_of_ne ha_nonneg (by simpa [eq_comm] using hzero)
    have hmul :
        a * a ≤ a * b := by
      simpa [pow_two] using hsq_le_mul'
    exact le_of_mul_le_mul_left hmul hpos

/-- Helper for Theorem 23.41: every zero of `A` yields the textbook Fejér drop estimate for the
proximal-point orbit. -/
private theorem sqDist_proximalPoint_le_sqDist_sub_weightedYosida
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) {γ : ℕ → PosReal}
    (x0 : H) {z : H} (hz : z ∈ A.zeros) (n : ℕ) :
    let x := proximalPointAlgorithm A hA γ x0
    let u := fun k ↦ yosidaApproximationMap A hA (γ k) (x k)
    ‖x (n + 1) - z‖ ^ 2 ≤
      ‖x n - z‖ ^ 2 - ((γ n : ℝ) ^ 2) * ‖u n‖ ^ 2 := by
  dsimp
  have hfixed :
      resolventMap A hA (γ n) z = z := by
    have hzfixedSet : z ∈ ({x : H | x ∈ J[((γ n : ℝ) • A)] x} : Set H) := by
      rw [fixedPointSet_resolvent_smul_eq_zeros]
      exact hz
    have hzfixed : z ∈ J[((γ n : ℝ) • A)] z := by
      simpa using hzfixedSet
    rw [resolvent_smul_eq_singleton_resolventMap_of_maximal A hA (γ n) z] at hzfixed
    simpa using hzfixed.symm
  have hfirm :
      ‖proximalPointAlgorithm A hA γ x0 (n + 1) - z‖ ^ 2 +
          ‖proximalPointAlgorithm A hA γ x0 n -
              proximalPointAlgorithm A hA γ x0 (n + 1)‖ ^ 2 ≤
        ‖proximalPointAlgorithm A hA γ x0 n - z‖ ^ 2 := by
    simpa [proximalPointAlgorithm_succ, hfixed, norm_sub_rev] using
      (firmlyNonexpansiveOn_iff.mp (resolventMap_firmlyNonexpansiveOn_univ A hA (γ n)))
        (proximalPointAlgorithm A hA γ x0 n) (by simp) z (by simp)
  have hstep := (proximalPointYosidaStep_spec (A := A) (γ := γ) hA x0 n).2
  have hstep_norm :
      ‖proximalPointAlgorithm A hA γ x0 n -
          proximalPointAlgorithm A hA γ x0 (n + 1)‖ ^ 2 =
        ((γ n : ℝ) ^ 2) *
          ‖yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2 := by
    rw [hstep, norm_smul, Real.norm_of_nonneg (γ n).2.le, pow_two]
    ring
  rw [hstep_norm] at hfirm
  exact (le_sub_iff_add_le).2 hfirm

/-- Helper for Theorem 23.41: the proximal-point orbit is Fejér monotone with respect to
`A.zeros`. -/
private theorem proximalPointFejerMonotone
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) {γ : ℕ → PosReal}
    (x0 : H) :
    FejerMonotone A.zeros (proximalPointAlgorithm A hA γ x0) := by
  intro z hz n
  -- Drop the nonnegative weighted residual term from the one-step square estimate.
  have hsq :
      ‖proximalPointAlgorithm A hA γ x0 (n + 1) - z‖ ^ 2 ≤
        ‖proximalPointAlgorithm A hA γ x0 n - z‖ ^ 2 := by
    have hdrop :=
      sqDist_proximalPoint_le_sqDist_sub_weightedYosida (A := A) (γ := γ) hA x0 hz n
    nlinarith [sq_nonneg
      ‖yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n)‖]
  simpa [dist_eq_norm] using
    (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 hsq

/-- Helper for Theorem 23.41: the proximal-point increments `x_n - x_{n+1}` converge strongly
to `0`. -/
private theorem proximalPointDifference_tendsto_zero
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hzeros : A.zeros.Nonempty)
    {γ : ℕ → PosReal} (x0 : H) :
    let x := proximalPointAlgorithm A hA γ x0
    Tendsto (fun n ↦ x n - x (n + 1)) atTop (𝓝 (0 : H)) := by
  dsimp
  rcases hzeros with ⟨z, hz⟩
  have hfejer :
      FejerMonotone A.zeros (proximalPointAlgorithm A hA γ x0) :=
    proximalPointFejerMonotone (A := A) hA x0
  obtain ⟨l, hdist_tendsto⟩ := FejerMonotone.dist_tendsto hfejer hz
  have hsq_tendsto :
      Tendsto
        (fun n ↦ ‖proximalPointAlgorithm A hA γ x0 n - z‖ ^ 2)
        atTop
        (𝓝 (l ^ 2)) := by
    simpa [dist_eq_norm] using hdist_tendsto.pow 2
  have hsq_shift :
      Tendsto
        (fun n ↦ ‖proximalPointAlgorithm A hA γ x0 (n + 1) - z‖ ^ 2)
        atTop
        (𝓝 (l ^ 2)) := by
    simpa [Function.comp, Nat.add_comm] using
      (Filter.tendsto_add_atTop_iff_nat 1).2 hsq_tendsto
  have hgap_tendsto :
      Tendsto
        (fun n ↦
          ‖proximalPointAlgorithm A hA γ x0 n - z‖ ^ 2 -
            ‖proximalPointAlgorithm A hA γ x0 (n + 1) - z‖ ^ 2)
        atTop
        (𝓝 (0 : ℝ)) := by
    simpa using hsq_tendsto.sub hsq_shift
  have hstep_sq_le :
      ∀ n,
        ‖proximalPointAlgorithm A hA γ x0 n -
            proximalPointAlgorithm A hA γ x0 (n + 1)‖ ^ 2 ≤
          ‖proximalPointAlgorithm A hA γ x0 n - z‖ ^ 2 -
            ‖proximalPointAlgorithm A hA γ x0 (n + 1) - z‖ ^ 2 := by
    intro n
    have hdrop :=
      sqDist_proximalPoint_le_sqDist_sub_weightedYosida (A := A) (γ := γ) hA x0 hz n
    rcases proximalPointYosidaStep_spec (A := A) (γ := γ) hA x0 n with ⟨-, hstep⟩
    have hstep_norm :
        ‖proximalPointAlgorithm A hA γ x0 n -
            proximalPointAlgorithm A hA γ x0 (n + 1)‖ ^ 2 =
          ((γ n : ℝ) ^ 2) *
            ‖yosidaApproximationMap A hA (γ n)
                (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2 := by
      rw [hstep, norm_smul, Real.norm_of_nonneg (γ n).2.le, pow_two]
      ring
    rw [hstep_norm]
    nlinarith [hdrop]
  have hres_sq_tendsto :
      Tendsto
        (fun n ↦
          ‖proximalPointAlgorithm A hA γ x0 n -
              proximalPointAlgorithm A hA γ x0 (n + 1)‖ ^ 2)
        atTop
        (𝓝 (0 : ℝ)) := by
    refine
      squeeze_zero'
        (f := fun n ↦
          ‖proximalPointAlgorithm A hA γ x0 n -
              proximalPointAlgorithm A hA γ x0 (n + 1)‖ ^ 2)
        (g := fun n ↦
          ‖proximalPointAlgorithm A hA γ x0 n - z‖ ^ 2 -
            ‖proximalPointAlgorithm A hA γ x0 (n + 1) - z‖ ^ 2)
        (Eventually.of_forall fun n ↦ sq_nonneg _)
        (Eventually.of_forall hstep_sq_le)
        hgap_tendsto
  have hsqrt_tendsto :
      Tendsto
        (fun n ↦
          Real.sqrt
            (‖proximalPointAlgorithm A hA γ x0 n -
                proximalPointAlgorithm A hA γ x0 (n + 1)‖ ^ 2))
        atTop
        (𝓝 (Real.sqrt 0)) := by
    exact Real.continuous_sqrt.continuousAt.tendsto.comp hres_sq_tendsto
  have hres_norm_tendsto :
      Tendsto
        (fun n ↦
          ‖proximalPointAlgorithm A hA γ x0 n -
              proximalPointAlgorithm A hA γ x0 (n + 1)‖)
        atTop
        (𝓝 (0 : ℝ)) := by
    simpa [Real.sqrt_zero, Real.sqrt_sq_eq_abs] using hsqrt_tendsto
  exact (tendsto_zero_iff_norm_tendsto_zero).mpr hres_norm_tendsto

/-- Helper for Theorem 23.41: the Yosida residuals of the proximal-point orbit converge strongly
to `0`. -/
private theorem proximalPointYosida_tendsto_zero
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hzeros : A.zeros.Nonempty)
    {γ : ℕ → PosReal}
    (hγsq_diverges :
      Tendsto (fun N : ℕ ↦ (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2))) atTop atTop)
    (x0 : H) :
    let x := proximalPointAlgorithm A hA γ x0
    let u := fun n ↦ yosidaApproximationMap A hA (γ n) (x n)
    Tendsto u atTop (𝓝 (0 : H)) := by
  dsimp
  rcases hzeros with ⟨z, hz⟩
  have hanti :
      Antitone
        (fun n ↦
          ‖yosidaApproximationMap A hA (γ n)
              (proximalPointAlgorithm A hA γ x0 n)‖) :=
    norm_proximalPointYosida_antitone (A := A) hA x0
  have hsum_bound :
      ∀ N : ℕ,
        (Finset.range N).sum
            (fun n ↦
              ((γ n : ℝ) ^ 2) *
                ‖yosidaApproximationMap A hA (γ n)
                    (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2) ≤
          ‖x0 - z‖ ^ 2 - ‖proximalPointAlgorithm A hA γ x0 N - z‖ ^ 2 := by
    intro N
    induction N with
    | zero =>
        simp
    | succ N ih =>
        have hdrop :=
          sqDist_proximalPoint_le_sqDist_sub_weightedYosida (A := A) (γ := γ) hA x0 hz N
        rw [Finset.sum_range_succ]
        nlinarith
  have hnorm_tendsto_zero :
      Tendsto
        (fun n ↦
          ‖yosidaApproximationMap A hA (γ n)
              (proximalPointAlgorithm A hA γ x0 n)‖)
        atTop
        (𝓝 (0 : ℝ)) := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    by_contra hnot
    rw [Filter.eventually_atTop] at hnot
    push Not at hnot
    have hlower :
        ∀ N : ℕ,
          ε ≤
            ‖yosidaApproximationMap A hA (γ N)
                (proximalPointAlgorithm A hA γ x0 N)‖ := by
      intro N
      rcases hnot N with ⟨m, hmN, hmnot⟩
      have hm_lower :
          ε ≤
            ‖yosidaApproximationMap A hA (γ m)
                (proximalPointAlgorithm A hA γ x0 m)‖ := by
        have hmnot' :
            ¬
              ‖yosidaApproximationMap A hA (γ m)
                    (proximalPointAlgorithm A hA γ x0 m)‖ < ε := by
          simpa [Real.dist_eq, abs_of_nonneg (norm_nonneg _)] using hmnot
        exact le_of_not_gt hmnot'
      exact le_trans hm_lower (hanti hmN)
    let M : ℝ := (‖x0 - z‖ ^ 2 + ε ^ 2) / ε ^ 2
    have hM_event : ∀ᶠ N in atTop,
        M ≤ (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2)) :=
      tendsto_atTop.1 hγsq_diverges M
    rw [Filter.eventually_atTop] at hM_event
    rcases hM_event with ⟨N, hN⟩
    have hM_le :
        M ≤ (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2)) :=
      hN N le_rfl
    have hterm_le :
        ∀ n : ℕ,
          ε ^ 2 * ((γ n : ℝ) ^ 2) ≤
            ((γ n : ℝ) ^ 2) *
              ‖yosidaApproximationMap A hA (γ n)
                  (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2 := by
      intro n
      have hsqnorm :
          ε ^ 2 ≤
            ‖yosidaApproximationMap A hA (γ n)
                (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2 := by
        nlinarith [hlower n, norm_nonneg
          (yosidaApproximationMap A hA (γ n) (proximalPointAlgorithm A hA γ x0 n))]
      have hγsq_nonneg : 0 ≤ ((γ n : ℝ) ^ 2) := sq_nonneg _
      calc
        ε ^ 2 * ((γ n : ℝ) ^ 2) = ((γ n : ℝ) ^ 2) * ε ^ 2 := by ring
        _ ≤ ((γ n : ℝ) ^ 2) *
            ‖yosidaApproximationMap A hA (γ n)
                (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2 := by
              exact mul_le_mul_of_nonneg_left hsqnorm hγsq_nonneg
    have hsum_ge :
        ε ^ 2 * (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2)) ≤
          (Finset.range N).sum
            (fun n ↦
              ((γ n : ℝ) ^ 2) *
                ‖yosidaApproximationMap A hA (γ n)
                    (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2) := by
      calc
        ε ^ 2 * (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2)) =
            (Finset.range N).sum (fun n ↦ ε ^ 2 * ((γ n : ℝ) ^ 2)) := by
              rw [Finset.mul_sum]
        _ ≤
            (Finset.range N).sum
              (fun n ↦
                ((γ n : ℝ) ^ 2) *
                  ‖yosidaApproximationMap A hA (γ n)
                      (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2) := by
              exact Finset.sum_le_sum fun n _hn ↦ hterm_le n
    have hM_eq :
        ε ^ 2 * M = ‖x0 - z‖ ^ 2 + ε ^ 2 := by
      unfold M
      have hεsq_ne : ε ^ 2 ≠ 0 := by positivity
      field_simp [hεsq_ne]
    have hcontr :
        ‖x0 - z‖ ^ 2 + ε ^ 2 ≤ ‖x0 - z‖ ^ 2 := by
      calc
        ‖x0 - z‖ ^ 2 + ε ^ 2 = ε ^ 2 * M := hM_eq.symm
        _ ≤ ε ^ 2 * (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2)) := by
              exact mul_le_mul_of_nonneg_left hM_le (sq_nonneg ε)
        _ ≤
            (Finset.range N).sum
              (fun n ↦
                ((γ n : ℝ) ^ 2) *
                  ‖yosidaApproximationMap A hA (γ n)
                      (proximalPointAlgorithm A hA γ x0 n)‖ ^ 2) := hsum_ge
        _ ≤ ‖x0 - z‖ ^ 2 - ‖proximalPointAlgorithm A hA γ x0 N - z‖ ^ 2 := hsum_bound N
        _ ≤ ‖x0 - z‖ ^ 2 := by
              nlinarith [sq_nonneg ‖proximalPointAlgorithm A hA γ x0 N - z‖]
    nlinarith
  exact (tendsto_zero_iff_norm_tendsto_zero).mpr hnorm_tendsto_zero

/-- Helper for Theorem 23.41: every weak sequential cluster point of the proximal-point orbit
belongs to `A.zeros`. -/
private theorem weakSequentialClusterPt_mem_zeros_of_proximalPoint
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hzeros : A.zeros.Nonempty)
    {γ : ℕ → PosReal}
    (hγsq_diverges :
      Tendsto (fun N : ℕ ↦ (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2))) atTop atTop)
    (x0 : H) {z : H}
    (hzcluster :
      IsSequentialClusterPt
        (fun n ↦ toWeakSpace ℝ H (proximalPointAlgorithm A hA γ x0 n))
        (toWeakSpace ℝ H z)) :
    z ∈ A.zeros := by
  let x := proximalPointAlgorithm A hA γ x0
  let u := fun n ↦ yosidaApproximationMap A hA (γ n) (x n)
  rcases hzcluster.exists_subseq_tendsto with ⟨φ, hφmono, hφtendsto⟩
  have hu_tendsto : Tendsto u atTop (𝓝 (0 : H)) := by
    simpa [x, u] using
      proximalPointYosida_tendsto_zero (A := A) hA hzeros hγsq_diverges x0
  have hu_subseq :
      Tendsto (fun n ↦ u (φ n)) atTop (𝓝 (0 : H)) :=
    hu_tendsto.comp hφmono.tendsto_atTop
  have hdiff_tendsto :
      Tendsto (fun n ↦ x n - x (n + 1)) atTop (𝓝 (0 : H)) := by
    simpa [x] using proximalPointDifference_tendsto_zero (A := A) hA hzeros x0
  have hdiff_subseq :
      Tendsto (fun n ↦ x (φ n) - x (φ n + 1)) atTop (𝓝 (0 : H)) := by
    simpa [Function.comp, x] using hdiff_tendsto.comp hφmono.tendsto_atTop
  have hshift_tendsto :
      Tendsto (fun n ↦ toWeakSpace ℝ H (x (φ n + 1))) atTop
        (𝓝 (toWeakSpace ℝ H z)) :=
    tendstoWeaklyOfSubTendstoZeroSeq hφtendsto hdiff_subseq
  have hx_bounded :
      Bornology.IsBounded (Set.range fun n ↦ x (φ n + 1)) :=
    bounded_range_of_tendsto_weakly hshift_tendsto
  have hu_bounded :
      Bornology.IsBounded (Set.range fun n ↦ u (φ n)) :=
    Metric.isBounded_range_of_tendsto _ hu_subseq
  have hgraph_bounded :
      Bornology.IsBounded (Set.range fun n ↦ (x (φ n + 1), u (φ n))) := by
    refine (hx_bounded.prod hu_bounded).subset ?_
    rintro _ ⟨n, rfl⟩
    exact ⟨⟨n, rfl⟩, ⟨n, rfl⟩⟩
  have hgraph_mem :
      ∀ n, (x (φ n + 1), u (φ n)) ∈ gra A := by
    intro n
    simpa [x, u] using (proximalPointYosidaStep_spec (A := A) (γ := γ) hA x0 (φ n)).1
  have hgraph_limit :
      (z, (0 : H)) ∈ gra A :=
    SetValuedOperator.Maximal.mem_graph_of_tendsto_weakly_of_tendsto
      hA hgraph_mem hgraph_bounded hshift_tendsto hu_subseq
  simpa [SetValuedOperator.mem_graph, SetValuedOperator.mem_zeros_iff] using hgraph_limit

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- Helper for Theorem 23.41: if a sequence in `H` does not converge strongly to `0`, then some
strictly monotone subsequence stays uniformly away from `0`. -/
private theorem exists_strictMono_subseq_norm_ge_of_not_tendsto_zero
    (u : ℕ → H) (hnot : ¬ Tendsto u atTop (𝓝 (0 : H))) :
    ∃ c > 0, ∃ k : ℕ → ℕ, StrictMono k ∧ ∀ n, c ≤ ‖u (k n)‖ := by
  rcases Filter.not_tendsto_iff_exists_frequently_notMem.1 hnot with ⟨s, hs0, hfreq⟩
  obtain ⟨c, hcpos, hcball⟩ := Metric.mem_nhds_iff.1 hs0
  rcases Filter.extraction_of_frequently_atTop hfreq with ⟨k, hkmono, hkout⟩
  refine ⟨c, hcpos, k, hkmono, ?_⟩
  intro n
  have hnot_ball : u (k n) ∉ Metric.ball (0 : H) c := by
    intro hkball
    exact hkout n (hcball hkball)
  have hdist : c ≤ dist (u (k n)) 0 := by
    by_contra hlt
    exact hnot_ball (by simpa [Metric.mem_ball, dist_eq_norm] using hlt)
  simpa [dist_eq_norm] using hdist

/-- Weak-convergence clause of Theorem 23.41: let `A : H → 2^H` be maximally monotone with
`A.zeros.Nonempty`, let
`γ : ℕ → ℝ_{++}` satisfy `∑ γ n ^ 2 = +∞`. Then the variable-step
proximal-point iteration generated from `x0` converges weakly to a point of
`A.zeros`. -/
theorem exists_weakLimit_mem_zeros_of_proximalPointAlgorithm
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hzeros : A.zeros.Nonempty)
    {γ : ℕ → PosReal}
    (hγsq_diverges :
      Tendsto (fun N : ℕ ↦ (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2))) atTop atTop)
    (x0 : H) :
    ∃ z ∈ A.zeros,
      Tendsto (fun n ↦ toWeakSpace ℝ H (proximalPointAlgorithm A hA γ x0 n)) atTop
        (𝓝 (toWeakSpace ℝ H z)) := by
  let x := proximalPointAlgorithm A hA γ x0
  have hfejer : FejerMonotone A.zeros x := by
    simpa [x] using proximalPointFejerMonotone (A := A) hA x0
  have hcluster :
      ∀ z : H,
        IsSequentialClusterPt (fun n ↦ toWeakSpace ℝ H (x n)) (toWeakSpace ℝ H z) →
          z ∈ A.zeros := by
    intro z hzcluster
    -- Route correction: package the subsequence shift and graph-closure argument once at the
    -- cluster-point level, then feed it directly to Theorem 5.5.
    simpa [x] using
      weakSequentialClusterPt_mem_zeros_of_proximalPoint
        (A := A) hA hzeros hγsq_diverges x0 hzcluster
  simpa [x] using
    tendsto_weakly_of_fejerMonotone_of_weakSequentialClusterPts_mem
      hzeros x hfejer hcluster

/-- The source recursion form of Theorem 23.41 (1). -/
theorem exists_weakLimit_mem_zeros_of_isProximalPointAlgorithm
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hzeros : A.zeros.Nonempty)
    {γ : ℕ → PosReal}
    (hγsq_diverges :
      Tendsto (fun N : ℕ ↦ (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2))) atTop atTop)
    {x0 : H} {x : ℕ → H} (hx : IsProximalPointAlgorithm A hA γ x0 x) :
    ∃ z ∈ A.zeros,
      Tendsto (fun n ↦ toWeakSpace ℝ H (x n)) atTop (𝓝 (toWeakSpace ℝ H z)) := by
  rcases exists_weakLimit_mem_zeros_of_proximalPointAlgorithm hA hzeros hγsq_diverges x0 with
    ⟨z, hz, hzlim⟩
  refine ⟨z, hz, ?_⟩
  simpa [hx.eq_proximalPointAlgorithm] using hzlim

/-- Theorem 23.41: under the hypotheses of the weak-convergence clause, if `A` is uniformly
monotone on every bounded subset `C ⊆ A.dom`, then the variable-step proximal-point iteration
converges strongly to the unique point of `A.zeros`. -/
theorem exists_strongLimit_mem_zeros_eq_singleton_of_proximalPointAlgorithm
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hzeros : A.zeros.Nonempty)
    {γ : ℕ → PosReal}
    (hγsq_diverges :
      Tendsto (fun N : ℕ ↦ (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2))) atTop atTop)
    (hunif :
      ∀ C : Set H, Bornology.IsBounded C → C ⊆ A.dom → A.IsUniformlyMonotoneOn C)
    (x0 : H) :
    ∃ z ∈ A.zeros,
      Tendsto (proximalPointAlgorithm A hA γ x0) atTop (𝓝 z) ∧ A.zeros = {z} :=
  by
  let x := proximalPointAlgorithm A hA γ x0
  let u := fun n ↦ yosidaApproximationMap A hA (γ n) (x n)
  rcases exists_weakLimit_mem_zeros_of_proximalPointAlgorithm hA hzeros hγsq_diverges x0 with
    ⟨z, hz, hzweak⟩
  have hu_tendsto : Tendsto u atTop (𝓝 (0 : H)) := by
    simpa [x, u] using
      proximalPointYosida_tendsto_zero (A := A) hA hzeros hγsq_diverges x0
  have hsingleton : A.zeros = ({z} : Set H) := by
    ext y
    constructor
    · intro hy
      let Cpair : Set H := Set.insert z ({y} : Set H)
      have hz_dom : z ∈ A.dom :=
        (SetValuedOperator.mem_dom_iff A z).2
          ⟨0, by simpa [SetValuedOperator.mem_zeros_iff] using hz⟩
      have hy_dom : y ∈ A.dom :=
        (SetValuedOperator.mem_dom_iff A y).2
          ⟨0, by simpa [SetValuedOperator.mem_zeros_iff] using hy⟩
      have hpair_bdd : Bornology.IsBounded Cpair := by
        have hpair_finite : Cpair.Finite := by
          change (Set.insert z ({y} : Set H)).Finite
          exact (Set.finite_singleton y).insert z
        exact hpair_finite.isBounded
      have hpair_dom : Cpair ⊆ A.dom := by
        intro w hw
        rcases Set.mem_insert_iff.mp hw with hw | hw
        · subst w
          exact hz_dom
        · rcases Set.mem_singleton_iff.mp hw with rfl
          exact hy_dom
      rcases hunif Cpair hpair_bdd hpair_dom with ⟨φ, hφ⟩
      have hφ_nonneg : (0 : EReal) ≤ φ ‖y - z‖₊ := by
        rw [← (hφ.modulus_eq_zero_iff 0).2 rfl]
        exact hφ.monotone bot_le
      have hy0 : (0 : H) ∈ A y := by
        simpa [SetValuedOperator.mem_zeros_iff] using hy
      have hz0 : (0 : H) ∈ A z := by
        simpa [SetValuedOperator.mem_zeros_iff] using hz
      have hineq : φ ‖y - z‖₊ ≤ (0 : EReal) := by
        have hy_mem : y ∈ Cpair := by
          change y ∈ Set.insert z ({y} : Set H)
          exact Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton y))
        have hz_mem : z ∈ Cpair := by
          change z ∈ Set.insert z ({y} : Set H)
          exact Set.mem_insert z ({y} : Set H)
        simpa using
          (hφ.ineq (x := y) (u := 0) (y := z) (v := 0) hy_mem hz_mem hy0 hz0)
      have hφ_zero : φ ‖y - z‖₊ = 0 :=
        le_antisymm hineq hφ_nonneg
      have hdist_zero : ‖y - z‖₊ = 0 :=
        (hφ.modulus_eq_zero_iff ‖y - z‖₊).1 hφ_zero
      have hnorm_zero : ‖y - z‖ = 0 := by
        simpa using congrArg (fun t : NNReal ↦ (t : ℝ)) hdist_zero
      have hyz : y = z := sub_eq_zero.mp (norm_eq_zero.mp hnorm_zero)
      simp [hyz]
    · intro hy
      rcases Set.mem_singleton_iff.mp hy with rfl
      exact hz
  have hzweak_shift :
      Tendsto (fun n ↦ toWeakSpace ℝ H (x (n + 1))) atTop (𝓝 (toWeakSpace ℝ H z)) := by
    simpa [x, Function.comp, Nat.add_comm] using
      (Filter.tendsto_add_atTop_iff_nat 1).2 hzweak
  have hxweak_zero :
      Tendsto (fun n ↦ toWeakSpace ℝ H (x (n + 1) - z)) atTop
        (𝓝 (toWeakSpace ℝ H (0 : H))) := by
    have hzconst :
        Tendsto (fun _ : ℕ ↦ toWeakSpace ℝ H z) atTop (𝓝 (toWeakSpace ℝ H z)) :=
      tendsto_const_nhds
    simpa using hzweak_shift.sub hzconst
  have hinner_tendsto :
      Tendsto (fun n ↦ inner ℝ (x (n + 1) - z) (u n)) atTop (𝓝 (0 : ℝ)) := by
    simpa [x, u] using
      tendsto_inner_of_tendsto_weakly_of_tendsto
        (fun n ↦ x (n + 1) - z) u (0 : H) (0 : H) hxweak_zero hu_tendsto
  have hxshift_zero :
      Tendsto (fun n ↦ x (n + 1) - z) atTop (𝓝 (0 : H)) := by
    by_contra hnot
    rcases exists_strictMono_subseq_norm_ge_of_not_tendsto_zero
      (fun n ↦ x (n + 1) - z) hnot with
      ⟨c, hc, k, hkmono, hkbound⟩
    let C : Set H := Set.insert z (Set.range fun n ↦ x (n + 1))
    have hx_bounded : Bornology.IsBounded (Set.range x) :=
      bounded_range_of_tendsto_weakly hzweak
    have hxshift_bounded : Bornology.IsBounded (Set.range fun n ↦ x (n + 1)) := by
      exact hx_bounded.subset fun _ hy ↦ by
        rcases hy with ⟨n, rfl⟩
        exact ⟨n + 1, rfl⟩
    have hC_bounded : Bornology.IsBounded C := by
      change Bornology.IsBounded (Set.insert z (Set.range fun n ↦ x (n + 1)))
      exact
        (Bornology.isBounded_insert (x := z) (s := Set.range fun n ↦ x (n + 1))).2
          hxshift_bounded
    have hC_dom : C ⊆ A.dom := by
      intro w hw
      rcases Set.mem_insert_iff.mp hw with hw | hw
      · subst w
        exact (SetValuedOperator.mem_dom_iff A z).2
          ⟨0, by simpa [SetValuedOperator.mem_zeros_iff] using hz⟩
      · rcases hw with ⟨n, rfl⟩
        rcases proximalPointYosidaStep_spec (A := A) (γ := γ) hA x0 n with ⟨hgraph, -⟩
        have hu_mem :
            yosidaApproximationMap A hA (γ n) (x n) ∈ A (x (n + 1)) := by
          simpa [x, u, SetValuedOperator.mem_graph] using hgraph
        exact (SetValuedOperator.mem_dom_iff A (x (n + 1))).2 ⟨u n, hu_mem⟩
    rcases hunif C hC_bounded hC_dom with ⟨φ, hφ⟩
    let cNN : NNReal := ⟨c, hc.le⟩
    have hmod_le_inner :
        ∀ n,
          φ cNN ≤ ((inner ℝ (x (k n + 1) - z) (u (k n)) : ℝ) : EReal) := by
      intro n
      have hc_le : cNN ≤ ‖x (k n + 1) - z‖₊ := by
        exact_mod_cast hkbound n
      have hu_mem :
          u (k n) ∈ A (x (k n + 1)) := by
        rcases proximalPointYosidaStep_spec (A := A) (γ := γ) hA x0 (k n) with ⟨hgraph, -⟩
        simpa [x, u, SetValuedOperator.mem_graph] using hgraph
      have hz0 : (0 : H) ∈ A z := by
        simpa [SetValuedOperator.mem_zeros_iff] using hz
      have hineq :
          φ ‖x (k n + 1) - z‖₊ ≤
            ((inner ℝ (x (k n + 1) - z) (u (k n) - 0) : ℝ) : EReal) := by
        have hx_mem : x (k n + 1) ∈ C := Set.mem_insert_iff.mpr (Or.inr ⟨k n, rfl⟩)
        have hz_mem : z ∈ C := by
          change z ∈ Set.insert z (Set.range fun n ↦ x (n + 1))
          exact Set.mem_insert z (Set.range fun n ↦ x (n + 1))
        exact hφ.ineq (x := x (k n + 1)) (u := u (k n)) (y := z) (v := 0)
          hx_mem hz_mem hu_mem hz0
      have hmono : φ cNN ≤ φ ‖x (k n + 1) - z‖₊ :=
        hφ.monotone hc_le
      simpa using le_trans hmono hineq
    have hφ_nonneg : (0 : EReal) ≤ φ cNN := by
      rw [← (hφ.modulus_eq_zero_iff 0).2 rfl]
      exact hφ.monotone bot_le
    have hcNN_ne_zero : cNN ≠ 0 := by
      intro hzero
      have hc_zero : c = 0 := by
        exact congrArg (fun t : NNReal ↦ (t : ℝ)) hzero
      exact (ne_of_gt hc) hc_zero
    have hφ_ne_zero : φ cNN ≠ 0 := by
      intro hzero
      exact hcNN_ne_zero ((hφ.modulus_eq_zero_iff cNN).1 hzero)
    have hφ_pos : (0 : EReal) < φ cNN :=
      lt_of_le_of_ne hφ_nonneg (Ne.symm hφ_ne_zero)
    have hφ_ne_top : φ cNN ≠ ⊤ := by
      intro htop
      have := hmod_le_inner 0
      rw [htop] at this
      simp at this
    have hφ_ne_bot : φ cNN ≠ ⊥ := by
      intro hbot
      rw [hbot] at hφ_nonneg
      simp at hφ_nonneg
    let δ : ℝ := (φ cNN).toReal
    have hδ_pos : 0 < δ := by
      have hcast :
          (0 : EReal) < (((φ cNN).toReal : ℝ) : EReal) := by
        simpa [EReal.coe_toReal hφ_ne_top hφ_ne_bot] using hφ_pos
      exact_mod_cast hcast
    have hδ_le_inner :
        ∀ n, δ ≤ inner ℝ (x (k n + 1) - z) (u (k n)) := by
      intro n
      have hle :
          (((φ cNN).toReal : ℝ) : EReal) ≤
            ((inner ℝ (x (k n + 1) - z) (u (k n)) : ℝ) : EReal) := by
        simpa [EReal.coe_toReal hφ_ne_top hφ_ne_bot] using hmod_le_inner n
      exact_mod_cast hle
    have hinner_subseq :
        Tendsto (fun n ↦ inner ℝ (x (k n + 1) - z) (u (k n))) atTop (𝓝 (0 : ℝ)) :=
      hinner_tendsto.comp hkmono.tendsto_atTop
    have hinner_nonneg :
        ∀ n, 0 ≤ inner ℝ (x (k n + 1) - z) (u (k n)) := by
      intro n
      have hle :
          (0 : EReal) ≤
            ((inner ℝ (x (k n + 1) - z) (u (k n)) : ℝ) : EReal) :=
        le_trans hφ_nonneg (hmod_le_inner n)
      exact_mod_cast hle
    have hsmall :
        ∀ᶠ n in atTop, dist (inner ℝ (x (k n + 1) - z) (u (k n))) 0 < δ / 2 :=
      (Metric.tendsto_nhds.1 hinner_subseq) (δ / 2) (by positivity)
    rw [Filter.eventually_atTop] at hsmall
    rcases hsmall with ⟨N, hN⟩
    have hlt : inner ℝ (x (k N + 1) - z) (u (k N)) < δ / 2 := by
      simpa [Real.dist_eq, abs_of_nonneg (hinner_nonneg N)] using hN N le_rfl
    nlinarith [hδ_le_inner N, hlt]
  have hxshift_strong :
      Tendsto (fun n ↦ x (n + 1)) atTop (𝓝 z) := by
    have hsum :
        Tendsto (fun n ↦ (x (n + 1) - z) + z) atTop (𝓝 ((0 : H) + z)) :=
      hxshift_zero.add tendsto_const_nhds
    simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hsum
  have hxstrong :
      Tendsto x atTop (𝓝 z) := by
    exact (Filter.tendsto_add_atTop_iff_nat 1).1
      (by simpa [x, Function.comp, Nat.add_comm] using hxshift_strong)
  exact ⟨z, hz, by simpa [x] using hxstrong, hsingleton⟩

/-- The source recursion form of Theorem 23.41 (2). -/
theorem exists_strongLimit_mem_zeros_eq_singleton_of_boundedUniformMonotonicity
    {A : SetValuedOperator H H} (hA : Maximal IsMonotone A) (hzeros : A.zeros.Nonempty)
    {γ : ℕ → PosReal}
    (hγsq_diverges :
      Tendsto (fun N : ℕ ↦ (Finset.range N).sum (fun n ↦ ((γ n : ℝ) ^ 2))) atTop atTop)
    {x0 : H} {x : ℕ → H} (hx : IsProximalPointAlgorithm A hA γ x0 x)
    (hunif :
      ∀ C : Set H, Bornology.IsBounded C → C ⊆ A.dom → A.IsUniformlyMonotoneOn C) :
    ∃ z ∈ A.zeros, Tendsto x atTop (𝓝 z) ∧ A.zeros = {z} := by
  rcases
      exists_strongLimit_mem_zeros_eq_singleton_of_proximalPointAlgorithm
        hA hzeros hγsq_diverges hunif x0
    with
    ⟨z, hz, hlim, hsingleton⟩
  refine ⟨z, hz, ?_, hsingleton⟩
  simpa [hx.eq_proximalPointAlgorithm] using hlim

end SetValuedOperator
