open Filter Function
open ERealFunction
open scoped InnerProductSpace Pointwise SetValuedOperator Topology

universe u

namespace SetValuedOperator

-- Semantic recall note: this file keeps the source-facing constant-step proximal-point sequence,
-- and reuses the Chapter 23 resolvent owners together with the Chapter 5 weak Picard theorem and
-- the Chapter 1 contraction owner `exists_fixedPoint_with_banach_picard_estimates`.

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The constant-step proximal-point sequence generated by `A`, `γ`, and `x0`, i.e.
`x 0 = x0` and `x (n + 1) = resolventMap A hA γ (x n)`. -/
noncomputable def proximalPointSequence
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : PosReal) (x0 : H) : ℕ → H :=
  fun n ↦ (resolventMap A hA γ)^[n] x0

/-- The proximal-point sequence starts at the prescribed initial point. -/
@[simp] theorem proximalPointSequence_zero
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : PosReal) (x0 : H) :
    proximalPointSequence A hA γ x0 0 = x0 := by
  simp [proximalPointSequence]

/-- The proximal-point sequence satisfies its defining resolvent recursion. -/
@[simp] theorem proximalPointSequence_succ
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : PosReal) (x0 : H) (n : ℕ) :
    proximalPointSequence A hA γ x0 (n + 1) =
      resolventMap A hA γ (proximalPointSequence A hA γ x0 n) := by
  simp [proximalPointSequence, iterate_succ_apply']

/-- Helper for Example 23.40: the constant-step proximal-point sequence is the relaxed iteration
of the resolvent map with the constant relaxation parameter `1`. -/
theorem proximalPointSequence_eq_relaxedOperatorIteration_resolventMap
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : PosReal) (x0 : H) :
    proximalPointSequence A hA γ x0 =
      relaxedOperatorIteration (fun _ : ℕ ↦ resolventMap A hA γ) (fun _ : ℕ ↦ (1 : ℝ)) x0 := by
  funext n
  induction n with
  | zero =>
      -- Both recursions start from the prescribed initial point.
      simp [proximalPointSequence]
  | succ n ihn =>
      -- One relaxed step with parameter `1` is exactly one resolvent application.
      rw [proximalPointSequence_succ, relaxedOperatorIteration_succ, ihn]
      simp

/-- For a maximally monotone operator, the fixed points of the chosen resolvent map are exactly
the zeros of the operator. -/
theorem fixedPoints_resolventMap_eq_zeros
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : PosReal) :
    fixedPoints (resolventMap A hA γ) = A.zeros := by
  ext x
  rw [← fixedPointSet_resolvent_smul_eq_zeros γ]
  constructor
  · intro hx
    change x ∈ J[((γ : ℝ) • A)] x
    rw [resolvent_smul_eq_singleton_resolventMap_of_maximal A hA γ x]
    exact Set.mem_singleton_iff.mpr (Function.mem_fixedPoints_iff.mp hx).symm
  · intro hx
    change x ∈ J[((γ : ℝ) • A)] x at hx
    rw [Function.mem_fixedPoints_iff]
    rw [resolvent_smul_eq_singleton_resolventMap_of_maximal A hA γ x] at hx
    exact (Set.mem_singleton_iff.mp hx).symm

/-- Helper for Example 23.40: the canonical resolvent map of a maximally monotone operator is
firmly nonexpansive as a self-map of the whole Hilbert space. -/
theorem resolventMap_firmlyNonexpansive
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : PosReal) :
    FirmlyNonexpansive (resolventMap A hA γ) := by
  -- Convert the Chapter 23 whole-space statement into the Chapter 5 self-map API.
  simpa [FirmlyNonexpansive] using resolventMap_firmlyNonexpansiveOn_univ A hA γ

omit [CompleteSpace H] in
private theorem IsStronglyMonotone.smul_posReal
    {A : SetValuedOperator H H} {β : ℝ} (hA : A.IsStronglyMonotone β) (γ : PosReal) :
    ((γ : ℝ) • A).IsStronglyMonotone (β * (γ : ℝ)) := by
  refine ⟨mul_pos hA.pos γ.2, ?_⟩
  intro x u y v hu hv
  rw [Pi.smul_apply] at hu hv
  rcases Set.mem_smul_set.mp hu with ⟨u', hu', rfl⟩
  rcases Set.mem_smul_set.mp hv with ⟨v', hv', rfl⟩
  have hineq : β * ‖x - y‖ ^ 2 ≤ ⟪x - y, u' - v'⟫_ℝ := hA.ineq hu' hv'
  have hmul :
      (γ : ℝ) * (β * ‖x - y‖ ^ 2) ≤ (γ : ℝ) * ⟪x - y, u' - v'⟫_ℝ := by
    exact mul_le_mul_of_nonneg_left hineq γ.2.le
  calc
    (β * (γ : ℝ)) * ‖x - y‖ ^ 2 = (γ : ℝ) * (β * ‖x - y‖ ^ 2) := by ring
    _ ≤ (γ : ℝ) * ⟪x - y, u' - v'⟫_ℝ := hmul
    _ = ⟪x - y, (γ : ℝ) • u' - (γ : ℝ) • v'⟫_ℝ := by
          rw [← smul_sub, real_inner_smul_right]

/-- If `A` is strongly monotone with constant `β`, then the chosen resolvent map `resolventMap A γ`
is a contraction with the textbook constant `1 / (β * γ + 1)`. -/
theorem resolventMap_contractingWith_of_isStronglyMonotone
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) {β : ℝ}
    (hstrong : A.IsStronglyMonotone β) (γ : PosReal) :
    ContractingWith (Real.toNNReal (1 / (β * (γ : ℝ) + 1))) (resolventMap A hA γ) := by
  let βγ : PosReal := ⟨β * (γ : ℝ), mul_pos hstrong.pos γ.2⟩
  have hscaled : ((γ : ℝ) • A).IsStronglyMonotone (βγ : ℝ) := by
    simpa [βγ, mul_comm] using hstrong.smul_posReal γ
  have hK : (1 / ((βγ : ℝ) + 1)) ∈ Set.Ioo (0 : ℝ) 1 := inv_one_add_mem_Ioo_zero_one βγ
  have hK_nonneg : 0 ≤ 1 / (β * (γ : ℝ) + 1) := by
    exact le_of_lt (by simpa [βγ, mul_comm] using hK.1)
  have hK_max : max (1 / (β * (γ : ℝ) + 1)) 0 = 1 / (β * (γ : ℝ) + 1) :=
    max_eq_left hK_nonneg
  refine ⟨?_, LipschitzWith.of_dist_le_mul fun x y ↦ ?_⟩
  · simpa [Real.toNNReal_of_nonneg hK_nonneg, βγ, mul_comm] using hK.2
  · have hx : resolventMap A hA γ x ∈ J[((γ : ℝ) • A)] x := by
      rw [resolvent_smul_eq_singleton_resolventMap_of_maximal A hA γ x]
      simp
    have hy : resolventMap A hA γ y ∈ J[((γ : ℝ) • A)] y := by
      rw [resolvent_smul_eq_singleton_resolventMap_of_maximal A hA γ y]
      simp
    have hdist :
        ‖resolventMap A hA γ x - resolventMap A hA γ y‖ ≤
          (1 / ((βγ : ℝ) + 1)) * ‖x - y‖ :=
      norm_sub_le_inv_one_add_mul_norm_sub_of_mem_resolvent βγ hscaled hx hy
    have hcoef :
        (Real.toNNReal (1 / (β * (γ : ℝ) + 1)) : ℝ) = 1 / ((βγ : ℝ) + 1) := by
      rw [Real.toNNReal_of_nonneg hK_nonneg]
      simp [βγ]
    calc
      dist (resolventMap A hA γ x) (resolventMap A hA γ y) =
          ‖resolventMap A hA γ x - resolventMap A hA γ y‖ := by
            rw [dist_eq_norm]
      _ ≤ (1 / ((βγ : ℝ) + 1)) * ‖x - y‖ := hdist
      _ = (Real.toNNReal (1 / (β * (γ : ℝ) + 1)) : ℝ) * dist x y := by
            rw [hcoef, dist_eq_norm]

/-- The strongly monotone proximal-point sequence enjoys a geometric distance bound to the unique
zero of `A`; this is the linear-convergence companion to the main strong-convergence statement. -/
theorem proximalPointSequence_linearRate_of_isStronglyMonotone
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) {β : ℝ}
    (hstrong : A.IsStronglyMonotone β) (γ : PosReal) (x0 : H) :
    ∃ z ∈ A.zeros, ∀ n : ℕ,
      dist (proximalPointSequence A hA γ x0 n) z ≤
        (1 / (β * (γ : ℝ) + 1)) ^ n * dist x0 z := by
  have hK_nonneg : 0 ≤ 1 / (β * (γ : ℝ) + 1) := by
    have hden_pos : 0 < β * (γ : ℝ) + 1 := by
      nlinarith [hstrong.pos, γ.2]
    exact le_of_lt (one_div_pos.mpr hden_pos)
  have hK_max : max (1 / (β * (γ : ℝ) + 1)) 0 = 1 / (β * (γ : ℝ) + 1) :=
    max_eq_left hK_nonneg
  have hcontract := resolventMap_contractingWith_of_isStronglyMonotone A hA hstrong γ
  rcases exists_fixedPoint_with_banach_picard_estimates hcontract with
    ⟨z, hzfix, _, hgeom, _, _, _⟩
  have hz : z ∈ A.zeros := by
    rw [← fixedPoints_resolventMap_eq_zeros A hA γ, hzfix]
    simp
  refine ⟨z, hz, ?_⟩
  intro n
  have hgeom' :
      dist (proximalPointSequence A hA γ x0 n) z ≤
        max (1 / (β * (γ : ℝ) + 1)) 0 ^ n * dist x0 z := by
    simpa [proximalPointSequence, NNReal.coe_pow, Real.coe_toNNReal'] using hgeom x0 n
  calc
    dist (proximalPointSequence A hA γ x0 n) z ≤
        max (1 / (β * (γ : ℝ) + 1)) 0 ^ n * dist x0 z := hgeom'
    _ = (1 / (β * (γ : ℝ) + 1)) ^ n * dist x0 z := by rw [hK_max]

/-- Example 23.40 (1): if `A.zeros.Nonempty`, then the constant-step proximal-point
`proximalPointSequence A hA γ x0` converges weakly to a point of `A.zeros`. -/
theorem exists_weakLimit_mem_zeros_of_proximalPointSequence
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : PosReal) (x0 : H)
    (hzeros : A.zeros.Nonempty) :
    ∃ z ∈ A.zeros,
      Tendsto (fun n ↦ toWeakSpace ℝ H (proximalPointSequence A hA γ x0 n)) atTop
        (𝓝 (toWeakSpace ℝ H z)) := by
  -- Route correction: replace the later Chapter 23 proximal-point theorem by the Chapter 5
  -- fixed-point iteration owner specialized to the constant relaxation `λₙ = 1`.
  have hfirm : FirmlyNonexpansive (resolventMap A hA γ) :=
    resolventMap_firmlyNonexpansive A hA γ
  have hfix : (fixedPoints (resolventMap A hA γ)).Nonempty := by
    rw [fixedPoints_resolventMap_eq_zeros A hA γ]
    exact hzeros
  have hrelax : ∀ n : ℕ, (fun _ : ℕ ↦ (1 : ℝ)) n ∈ Set.Icc (0 : ℝ) 2 := by
    intro n
    norm_num
  have hdiv :
      Tendsto
        (fun N : ℕ ↦
          ∑ n ∈ Finset.range N, (fun _ : ℕ ↦ (1 : ℝ)) n * (2 - (fun _ : ℕ ↦ (1 : ℝ)) n))
        atTop atTop := by
    have hsum :
        (fun N : ℕ ↦
          ∑ n ∈ Finset.range N, (fun _ : ℕ ↦ (1 : ℝ)) n * (2 - (fun _ : ℕ ↦ (1 : ℝ)) n)) =
          fun N : ℕ ↦ (N : ℝ) := by
      funext N
      -- For the constant relaxation `λₙ = 1`, each summand is exactly `1`.
      rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      ring
    rw [hsum]
    exact tendsto_natCast_atTop_atTop
  rcases exists_tendsto_weakly_to_fixedPoint_of_relaxedOperatorIteration_of_firmlyNonexpansive
      hfirm hfix (fun _ : ℕ ↦ (1 : ℝ)) hrelax hdiv x0 with
    ⟨z, hzfix, hzlim⟩
  refine ⟨z, ?_, ?_⟩
  · -- Rewrite the fixed-point conclusion back to the zero set of `A`.
    rw [← fixedPoints_resolventMap_eq_zeros A hA γ]
    exact hzfix
  · -- The Picard orbit is exactly the constant-step proximal-point sequence.
    simpa [proximalPointSequence_eq_relaxedOperatorIteration_resolventMap A hA γ x0] using hzlim

/-- Example 23.40 (2): if `A` is strongly monotone, then the constant-step proximal-point
sequence `proximalPointSequence A hA γ x0` converges strongly to the unique point of `A.zeros`;
the companion theorem `proximalPointSequence_linearRate_of_isStronglyMonotone` records the linear
rate. -/
theorem exists_strongLimit_mem_zeros_eq_singleton_of_proximalPointSequence_of_isStronglyMonotone
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) {β : ℝ}
    (hstrong : A.IsStronglyMonotone β) (γ : PosReal) (x0 : H) :
    ∃ z ∈ A.zeros, Tendsto (proximalPointSequence A hA γ x0) atTop (𝓝 z) ∧ A.zeros = {z} := by
  let T := resolventMap A hA γ
  have hcontract := resolventMap_contractingWith_of_isStronglyMonotone A hA hstrong γ
  have hz : hcontract.fixedPoint T ∈ A.zeros := by
    rw [← fixedPoints_resolventMap_eq_zeros A hA γ, Function.mem_fixedPoints_iff]
    simpa [T] using hcontract.fixedPoint_isFixedPt
  have hzeros : A.zeros = {hcontract.fixedPoint T} := by
    -- A contraction has a unique fixed point, so the zero set must also be a singleton.
    rw [← fixedPoints_resolventMap_eq_zeros A hA γ]
    ext y
    constructor
    · intro hy
      rw [Set.mem_singleton_iff]
      exact hcontract.fixedPoint_unique hy
    · intro hy
      rw [Set.mem_singleton_iff] at hy
      simpa [T, hy] using hcontract.fixedPoint_isFixedPt
  have htendsto : Tendsto (proximalPointSequence A hA γ x0) atTop (𝓝 (hcontract.fixedPoint T)) := by
    -- The proximal-point sequence is the iterate orbit of the contraction.
    simpa [proximalPointSequence, T] using hcontract.tendsto_iterate_fixedPoint x0
  exact ⟨hcontract.fixedPoint T, hz, htendsto, hzeros⟩

/-- Combined form of Example 23.40: the weak and strong convergence conclusions can be
packaged into a single conjunction. -/
theorem proximalPointSequence_weakAndStrongConvergence
    (A : SetValuedOperator H H) (hA : Maximal IsMonotone A) (γ : PosReal) (x0 : H) :
    ( (A.zeros.Nonempty →
        ∃ z ∈ A.zeros,
          Tendsto (fun n ↦ toWeakSpace ℝ H (proximalPointSequence A hA γ x0 n)) atTop
            (𝓝 (toWeakSpace ℝ H z))) ∧
      (∀ {β : ℝ}, A.IsStronglyMonotone β →
        ∃ z ∈ A.zeros, Tendsto (proximalPointSequence A hA γ x0) atTop (𝓝 z) ∧
          A.zeros = {z}) ) := by
  constructor
  · intro hzeros
    exact exists_weakLimit_mem_zeros_of_proximalPointSequence A hA γ x0 hzeros
  · intro β hstrong
    exact
      exists_strongLimit_mem_zeros_eq_singleton_of_proximalPointSequence_of_isStronglyMonotone
        A hA hstrong γ x0

end SetValuedOperator
