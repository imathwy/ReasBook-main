/-- Helper for Theorem 30.1: combining the anchored step identity with the vanishing successive
differences gives the strong residual decay from source equations `(30.13)`-`(30.14)`. -/
private theorem halpern_residual_tendsto_zero_of_anchor_start
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D)
    (hT_nonexp : LipschitzOnWith 1 T D)
    (hFix_nonempty : (fixedPointSetOn D T).Nonempty)
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    (hlam_tendsto_zero : Tendsto lam atTop (𝓝 (0 : ℝ)))
    (hlam_sum_diverges : Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) atTop atTop)
    (hlam_successive_diff_summable : Summable (fun n ↦ |lam (n + 1) - lam n|)) :
    Tendsto
      (fun n ↦ halpernIteration T lam x x n - T (halpernIteration T lam x x n))
      atTop (𝓝 (0 : H)) := by
