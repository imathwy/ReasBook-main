/-- Helper for Theorem 30.1: once the inner-product term and anchor coefficient are small,
source estimate `(30.18)` yields the one-step squared-distance recursion with the canonical
`3 λₙ ε` error term. -/
private theorem halpern_anchor_projection_sqnorm_step_le_eventually
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    (hlam_tendsto_zero : Tendsto lam atTop (𝓝 (0 : ℝ)))
    (hlam_sum_diverges : Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) atTop atTop)
    (hlam_successive_diff_summable : Summable (fun n ↦ |lam (n + 1) - lam n|)) :
    ∀ ε > 0,
      ∀ᶠ n in atTop,
        ‖halpernIteration T lam x x (n + 1) - P[FixT, hFix_cheb] x‖ ^ (2 : ℕ) ≤
          (1 - lam n) * ‖halpernIteration T lam x x n - P[FixT, hFix_cheb] x‖ ^ (2 : ℕ) +
            3 * lam n * ε := by
  intro ε hε
  let y : ℕ → H := halpernIteration T lam x x
  let p : H := P[FixT, hFix_cheb] x
  have hinner_event :=
    halpern_eventually_inner_projection_le_of_anchor_start
      (hD_closed := hD_closed) (hD_convex := hD_convex)
      (hT_nonexp := hT_nonexp) (hFix_nonempty := hFix_nonempty)
      (T := T) (lam := lam) (x := x)
      (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem)
      (hlam_tendsto_zero := hlam_tendsto_zero)
      (hlam_sum_diverges := hlam_sum_diverges)
      (hlam_successive_diff_summable := hlam_successive_diff_summable)
      ε hε
  have hlam_sq_tendsto :
      Tendsto (fun n ↦ lam n * ‖x - p‖ ^ (2 : ℕ)) atTop (𝓝 (0 : ℝ)) := by
    simpa [zero_mul] using hlam_tendsto_zero.mul_const (‖x - p‖ ^ (2 : ℕ))
  have hlam_sq_event :
      ∀ᶠ n in atTop, lam n * ‖x - p‖ ^ (2 : ℕ) ≤ ε := by
    filter_upwards [(tendsto_order.1 hlam_sq_tendsto).2 ε hε] with n hn
    exact hn.le
  filter_upwards [hinner_event, hlam_sq_event] with n hn_inner hn_sq
  have hlam_nonneg : 0 ≤ lam n := (hlam_mem n).1.le
  have hbeta_nonneg : 0 ≤ 1 - lam n := sub_nonneg.mpr (hlam_mem n).2.le
  have hp_fix : p ∈ FixT := by
    simpa [p] using projectionPoint_mem FixT hFix_cheb x
  have hyn_mem : y n ∈ D := by
    simpa [y] using halpernIteration_mem hD_convex hx hx hT_maps hlam_mem n
  have hp_mem : p ∈ D := (mem_fixedPointSetOn_iff.mp hp_fix).1
  have hT_norm_le : ‖T (y n) - p‖ ≤ ‖y n - p‖ := by
    simpa [y, p, dist_eq_norm, one_mul, (mem_fixedPointSetOn_iff.mp hp_fix).2] using
      hT_nonexp.dist_le_mul (y n) hyn_mem p hp_mem
  have hT_bound :=
    halpern_anchor_projection_bounds
      (hD_closed := hD_closed) (hD_convex := hD_convex)
      (hT_nonexp := hT_nonexp) (hFix_nonempty := hFix_nonempty)
      (T := T) (lam := lam) (x := x)
      (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem) n
  have hT_sq_le :
      ‖T (y n) - p‖ ^ (2 : ℕ) ≤ ‖y n - p‖ ^ (2 : ℕ) :=
    (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).2 hT_norm_le
  have hfirst_le :
      (lam n) ^ (2 : ℕ) * ‖x - p‖ ^ (2 : ℕ) ≤ lam n * ε := by
    -- The `‖x - p‖²` term is controlled by the small anchor coefficient `λₙ`.
    calc
      (lam n) ^ (2 : ℕ) * ‖x - p‖ ^ (2 : ℕ) =
          lam n * (lam n * ‖x - p‖ ^ (2 : ℕ)) := by ring
      _ ≤ lam n * ε := mul_le_mul_of_nonneg_left hn_sq hlam_nonneg
  have hcross_le :
      2 * lam n * (1 - lam n) * inner ℝ (T (y n) - p) (x - p) ≤
        2 * lam n * (1 - lam n) * ε := by
    -- The mixed term is bounded by the eventual inner-product estimate from `(30.17)`.
    exact
      mul_le_mul_of_nonneg_left hn_inner <|
        by positivity
  have hlast_le :
      (1 - lam n) ^ (2 : ℕ) * ‖T (y n) - p‖ ^ (2 : ℕ) ≤
        (1 - lam n) * ‖y n - p‖ ^ (2 : ℕ) := by
    have hbeta_le_one : 1 - lam n ≤ 1 := by
      linarith [(hlam_mem n).1]
    have hinside :
        (1 - lam n) * ‖T (y n) - p‖ ^ (2 : ℕ) ≤ ‖T (y n) - p‖ ^ (2 : ℕ) := by
      nlinarith [sq_nonneg (‖T (y n) - p‖)]
    calc
      (1 - lam n) ^ (2 : ℕ) * ‖T (y n) - p‖ ^ (2 : ℕ) =
          (1 - lam n) * ((1 - lam n) * ‖T (y n) - p‖ ^ (2 : ℕ)) := by ring
      _ ≤ (1 - lam n) * ‖T (y n) - p‖ ^ (2 : ℕ) := by
        exact mul_le_mul_of_nonneg_left hinside hbeta_nonneg
      _ ≤ (1 - lam n) * ‖y n - p‖ ^ (2 : ℕ) := by
        exact mul_le_mul_of_nonneg_left hT_sq_le hbeta_nonneg
  -- Expand `‖yₙ₊₁ - p‖²` and control the three source terms separately.
  calc
    ‖y (n + 1) - p‖ ^ (2 : ℕ) =
        ‖lam n • (x - p) + (1 - lam n) • (T (y n) - p)‖ ^ (2 : ℕ) := by
          rw [halpern_anchor_step_sub (T := T) (lam := lam) (x := x) p n]
    _ = (lam n) ^ (2 : ℕ) * ‖x - p‖ ^ (2 : ℕ) +
          2 * lam n * (1 - lam n) * inner ℝ (T (y n) - p) (x - p) +
          (1 - lam n) ^ (2 : ℕ) * ‖T (y n) - p‖ ^ (2 : ℕ) := by
          rw [norm_add_sq_real, norm_smul, norm_smul,
            Real.norm_of_nonneg hlam_nonneg, Real.norm_of_nonneg hbeta_nonneg,
            real_inner_smul_left, real_inner_smul_right, real_inner_comm]
          ring_nf
    _ ≤ lam n * ε + 2 * lam n * (1 - lam n) * ε +
          (1 - lam n) * ‖y n - p‖ ^ (2 : ℕ) := by
          exact add_le_add (add_le_add hfirst_le hcross_le) hlast_le
    _ ≤ (1 - lam n) * ‖y n - p‖ ^ (2 : ℕ) + 3 * lam n * ε := by
          nlinarith [(hlam_mem n).2]

/-- Helper for Theorem 30.1: iterating the one-step squared-distance estimate yields the tail
product bound `(30.19)` in the anchored-start case. -/
private theorem halpern_anchor_projection_sqnorm_tail_le
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    {ε : ℝ} (hε_nonneg : 0 ≤ ε) {m : ℕ}
