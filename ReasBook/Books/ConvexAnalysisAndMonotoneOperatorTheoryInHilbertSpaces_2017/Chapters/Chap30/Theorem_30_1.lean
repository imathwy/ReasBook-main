open Filter
open scoped BigOperators Topology

universe u

section

variable {H : Type u} [AddCommMonoid H] [Module ℝ H]

/-- The Halpern iteration generated by a self-map `T`, parameters `lam`, anchor `x`, and initial
point `x0`. -/
def halpernIteration (T : H → H) (lam : ℕ → ℝ) (x x0 : H) : ℕ → H
  | 0 => x0
  | n + 1 =>
      lam n • x + (1 - lam n) • T (halpernIteration T lam x x0 n)

/-- The Halpern iteration starts at the prescribed initial point. -/
@[simp] theorem halpernIteration_zero (T : H → H) (lam : ℕ → ℝ) (x x0 : H) :
    halpernIteration T lam x x0 0 = x0 := by
  rfl

/-- The Halpern iteration satisfies its defining recursion. -/
@[simp] theorem halpernIteration_succ (T : H → H) (lam : ℕ → ℝ) (x x0 : H) (n : ℕ) :
    halpernIteration T lam x x0 (n + 1) =
      lam n • x + (1 - lam n) • T (halpernIteration T lam x x0 n) := by
  rfl

end

section

variable {H : Type u} [AddCommGroup H] [Module ℝ H]
variable {D : Set H}

/-- One Halpern step stays in a convex set when both the anchor point and the current iterate do. -/
private theorem halpernStep_mem (hD_convex : Convex ℝ D) (T : D → D) (lam : ℕ → ℝ)
    (hlam_mem : ∀ n, lam n ∈ Set.Icc (0 : ℝ) 1) (x : D) (xn : D) (n : ℕ) :
    lam n • (x : H) + (1 - lam n) • (T xn : H) ∈ D := by
  have hline : AffineMap.lineMap (T xn : H) (x : H) (lam n) ∈ D :=
    hD_convex.lineMap_mem (T xn).2 x.2 (hlam_mem n)
  simpa [AffineMap.lineMap_apply, sub_eq_add_neg, smul_sub, add_smul, one_smul, add_assoc,
    add_left_comm, add_comm] using hline

/-- The Halpern iteration on a convex set `D`, generated by a self-map of `D`, parameters `lam`,
anchor `x`, and initial point `x0`. -/
def halpernIterationOn (hD_convex : Convex ℝ D) (T : D → D) (lam : ℕ → ℝ)
    (hlam_mem : ∀ n, lam n ∈ Set.Icc (0 : ℝ) 1) (x x0 : D) : ℕ → D
  | 0 => x0
  | n + 1 =>
      let xn := halpernIterationOn hD_convex T lam hlam_mem x x0 n
      ⟨lam n • (x : H) + (1 - lam n) • (T xn : H),
        halpernStep_mem hD_convex T lam hlam_mem x xn n⟩

/-- The Halpern iteration on `D` starts at the prescribed initial point. -/
@[simp] theorem halpernIterationOn_zero (hD_convex : Convex ℝ D) (T : D → D) (lam : ℕ → ℝ)
    (hlam_mem : ∀ n, lam n ∈ Set.Icc (0 : ℝ) 1) (x x0 : D) :
    halpernIterationOn hD_convex T lam hlam_mem x x0 0 = x0 := by
  rfl

/-- The ambient-value recursion for the Halpern iteration on `D`. -/
@[simp] theorem halpernIterationOn_succ (hD_convex : Convex ℝ D) (T : D → D) (lam : ℕ → ℝ)
    (hlam_mem : ∀ n, lam n ∈ Set.Icc (0 : ℝ) 1) (x x0 : D) (n : ℕ) :
    (halpernIterationOn hD_convex T lam hlam_mem x x0 (n + 1) : H) =
      lam n • (x : H) +
        (1 - lam n) • (T (halpernIterationOn hD_convex T lam hlam_mem x x0 n) : H) := by
  simp [halpernIterationOn]

end

section

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]
variable {D : Set H} {T : H → H} {x x0 : H} {lam : ℕ → ℝ}

/- Source/core/bridge triage:
- `source-facing`: the recursive owner `halpernIteration T lam x x0` is the Halpern iteration
  itself, and Theorem 30.1 is its strong convergence statement.
- `core/canonical`: use the ambient fixed-point owner `fixedPointSetOn D T` and the metric
  projection notation `P[C, hC]`.
- `bridge/view`: `halpernIterationOn` is the convex-domain subtype view of the same recursive
  construction; the fixed-point-set projection is expressed directly through `fixedPointSetOn D T`,
  deriving the Chebyshev witness from the canonical closed/convex fixed-point-set theorem and the
  Hilbert-space Chebyshev owner theorem, with no local duplicate wrapper.
-/

variable (hD_closed : IsClosed D) (hD_convex : Convex ℝ D)
variable (hT_nonexp : LipschitzOnWith 1 T D)
variable (hFix_nonempty : (fixedPointSetOn D T).Nonempty)

local notation "FixT" => fixedPointSetOn D T

local notation "hFix_closed_convex" =>
  isClosed_and_convex_fixedPointSetOn_of_quasinonexpansive
    hT_nonexp.quasinonexpansiveOn hD_closed hD_convex

local notation "hFix_cheb" =>
  isChebyshev_of_nonempty_isClosed_convex
    hFix_nonempty (hFix_closed_convex).1 (hFix_closed_convex).2

/-- Helper for Theorem 30.1: parameters in `]0,1[` can be reused as parameters in `[0,1]` for the
subtype-valued Halpern recursion. -/
private theorem halpernParams_mem_Icc
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1) :
    ∀ n, lam n ∈ Set.Icc (0 : ℝ) 1 :=
  fun n ↦ ⟨(hlam_mem n).1.le, (hlam_mem n).2.le⟩

/-- Helper for Theorem 30.1: the subtype-valued Halpern orbit agrees with the ambient-valued
Halpern orbit after coercion. -/
private theorem halpernIterationOn_coe_eq_halpernIteration
    (hD_convex : Convex ℝ D) (hx : x ∈ D) (hx0 : x0 ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1) :
    ∀ n,
      ((halpernIterationOn hD_convex
          (fun z : D ↦ ⟨T z, hT_maps z.2⟩)
          lam (halpernParams_mem_Icc hlam_mem) ⟨x, hx⟩ ⟨x0, hx0⟩ n : D) : H) =
        halpernIteration T lam x x0 n := by
  intro n
  induction n with
  | zero =>
      rfl
  | succ n ihn =>
      -- Both recursions unfold to the same affine combination once the previous iterates agree.
      simp [halpernIterationOn, halpernIteration, ihn]

/-- Helper for Theorem 30.1: every ambient Halpern iterate stays in `D`. -/
private theorem halpernIteration_mem
    (hD_convex : Convex ℝ D) (hx : x ∈ D) (hx0 : x0 ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1) :
    ∀ n, halpernIteration T lam x x0 n ∈ D := by
  intro n
  -- Transfer membership from the subtype recursion through the coercion bridge.
  simpa [halpernIterationOn_coe_eq_halpernIteration
    hD_convex hx hx0 hT_maps hlam_mem n] using
    (halpernIterationOn hD_convex
      (fun z : D ↦ ⟨T z, hT_maps z.2⟩)
      lam (halpernParams_mem_Icc hlam_mem) ⟨x, hx⟩ ⟨x0, hx0⟩ n).2

/-- Helper for Theorem 30.1: the initial Halpern weight products tend to `0` when the weights are
positive, bounded by `1`, and have divergent partial sums. -/
private theorem halpern_product_tendsto_zero
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    (hlam_sum_diverges : Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) atTop atTop) :
    Tendsto (fun n ↦ (Finset.range n).prod fun k ↦ (1 - lam k)) atTop (𝓝 (0 : ℝ)) := by
  have hnonneg :
      ∀ n, 0 ≤ (Finset.range n).prod (fun k ↦ (1 - lam k)) := by
    intro n
    -- Every factor `1 - λ_k` is nonnegative because `λ_k < 1`.
    refine Finset.prod_nonneg fun k _ ↦ ?_
    exact sub_nonneg.mpr (hlam_mem k).2.le
  have hprod_le_exp :
      ∀ n,
        (Finset.range n).prod (fun k ↦ (1 - lam k)) ≤
          Real.exp (-((Finset.range n).sum fun k ↦ lam k)) := by
    intro n
    -- Compare each factor with `exp (-λ_k)` and then collapse the product of exponentials.
    calc
      (Finset.range n).prod (fun k ↦ (1 - lam k)) ≤
          (Finset.range n).prod (fun k ↦ Real.exp (-(lam k))) := by
            refine Finset.prod_le_prod ?_ ?_
            · intro k hk
              exact sub_nonneg.mpr (hlam_mem k).2.le
            · intro k hk
              simpa using Real.one_sub_le_exp_neg (lam k)
      _ = Real.exp ((Finset.range n).sum fun k ↦ -(lam k)) := by
            symm
            exact Real.exp_sum (Finset.range n) (fun k ↦ -(lam k))
      _ = Real.exp (-((Finset.range n).sum fun k ↦ lam k)) := by
            rw [Finset.sum_neg_distrib]
  have hneg_sum :
      Tendsto (fun n ↦ -((Finset.range n).sum (fun k ↦ lam k))) atTop atBot := by
    -- Negating a sequence that tends to `+∞` forces it to tend to `-∞`.
    convert
      (Filter.Tendsto.const_mul_atTop_of_neg (l := atTop) (r := (-1 : ℝ))
        (by norm_num : (-1 : ℝ) < 0) hlam_sum_diverges) using 1
    funext n
    ring
  have hexp_tendsto :
      Tendsto (fun n ↦ Real.exp (-((Finset.range n).sum fun k ↦ lam k))) atTop (𝓝 (0 : ℝ)) :=
    Real.tendsto_exp_atBot.comp hneg_sum
  exact squeeze_zero hnonneg hprod_le_exp hexp_tendsto

/-- Helper for Theorem 30.1: the distance from a general Halpern orbit to the anchored orbit
started at `x` is controlled by the scalar product of the weights. -/
private theorem halpern_orbit_difference_norm_le
    (hD_convex : Convex ℝ D) (hT_nonexp : LipschitzOnWith 1 T D)
    (hx : x ∈ D) (hx0 : x0 ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1) :
    ∀ n,
      ‖halpernIteration T lam x x0 n - halpernIteration T lam x x n‖ ≤
        ‖x0 - x‖ * ((Finset.range n).prod fun k ↦ (1 - lam k)) := by
  intro n
  induction n with
  | zero =>
      -- At time `0`, the orbit difference is exactly the initial gap.
      simp
  | succ n ihn =>
      have hxn_mem :
          halpernIteration T lam x x0 n ∈ D :=
        halpernIteration_mem hD_convex hx hx0 hT_maps hlam_mem n
      have hyn_mem :
          halpernIteration T lam x x n ∈ D :=
        halpernIteration_mem hD_convex hx hx hT_maps hlam_mem n
      have hT_step :
          ‖T (halpernIteration T lam x x0 n) - T (halpernIteration T lam x x n)‖ ≤
            ‖halpernIteration T lam x x0 n - halpernIteration T lam x x n‖ := by
        simpa [dist_eq_norm] using
          hT_nonexp.dist_le_mul
            (halpernIteration T lam x x0 n) hxn_mem
            (halpernIteration T lam x x n) hyn_mem
      have hrewrite :
          halpernIteration T lam x x0 (n + 1) - halpernIteration T lam x x (n + 1) =
            (1 - lam n) •
              (T (halpernIteration T lam x x0 n) - T (halpernIteration T lam x x n)) := by
        -- The common anchor term cancels, leaving only the nonexpansive part.
        simp [halpernIteration_succ]
        module
      calc
        ‖halpernIteration T lam x x0 (n + 1) - halpernIteration T lam x x (n + 1)‖ =
            ‖(1 - lam n) •
              (T (halpernIteration T lam x x0 n) - T (halpernIteration T lam x x n))‖ := by
              rw [hrewrite]
        _ = (1 - lam n) *
              ‖T (halpernIteration T lam x x0 n) - T (halpernIteration T lam x x n)‖ := by
              rw [norm_smul, Real.norm_of_nonneg (sub_nonneg.mpr (hlam_mem n).2.le)]
        _ ≤ (1 - lam n) *
              ‖halpernIteration T lam x x0 n - halpernIteration T lam x x n‖ := by
              exact mul_le_mul_of_nonneg_left hT_step (sub_nonneg.mpr (hlam_mem n).2.le)
        _ ≤ (1 - lam n) * (‖x0 - x‖ * ((Finset.range n).prod fun k ↦ (1 - lam k))) := by
              exact mul_le_mul_of_nonneg_left ihn (sub_nonneg.mpr (hlam_mem n).2.le)
        _ = ‖x0 - x‖ * ((Finset.range (n + 1)).prod fun k ↦ (1 - lam k)) := by
              rw [Finset.prod_range_succ]
              ring

/-- Helper for Theorem 30.1: every Halpern orbit is asymptotic to the anchored orbit started at
the anchor point `x`. -/
private theorem halpern_orbit_difference_tendsto_zero_to_anchor
    (hD_convex : Convex ℝ D) (hT_nonexp : LipschitzOnWith 1 T D)
    (hx : x ∈ D) (hx0 : x0 ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    (hlam_sum_diverges : Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) atTop atTop) :
    Tendsto
      (fun n ↦ halpernIteration T lam x x0 n - halpernIteration T lam x x n)
      atTop (𝓝 (0 : H)) := by
  have hprod_zero :
      Tendsto
        (fun n ↦ ‖x0 - x‖ * ((Finset.range n).prod fun k ↦ (1 - lam k)))
        atTop (𝓝 (0 : ℝ)) := by
    -- The product bound tends to zero because the scalar weight product does.
    simpa [zero_mul] using
      (tendsto_const_nhds.mul (halpern_product_tendsto_zero
        (lam := lam) hlam_mem hlam_sum_diverges))
  -- A norm bound by a scalar sequence converging to zero gives norm convergence to zero.
  exact squeeze_zero_norm
    (halpern_orbit_difference_norm_le
      hD_convex hT_nonexp hx hx0 hT_maps hlam_mem)
    hprod_zero

/-- Helper for Theorem 30.1: every shifted partial-sum sequence of the Halpern weights still
diverges to `+∞`. -/
private theorem halpern_shifted_partial_sums_tendsto_atTop
    (hlam_sum_diverges : Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) atTop atTop)
    (m : ℕ) :
    Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam (m + n))) atTop atTop := by
  let head : ℝ := (Finset.range m).sum (fun n ↦ lam n)
  have hshifted :
      Tendsto (fun N ↦ head + (Finset.range N).sum (fun n ↦ lam (m + n))) atTop atTop := by
    -- Shift the divergent partial-sum sequence by the finite head block of length `m`.
    have hmain :
        Tendsto (fun N ↦ (Finset.range (m + N)).sum (fun n ↦ lam n)) atTop atTop := by
      simpa [Nat.add_comm, Function.comp] using
        (Filter.tendsto_add_atTop_iff_nat
          (f := fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) m).2 hlam_sum_diverges
    refine hmain.congr' ?_
    exact Eventually.of_forall fun N ↦ by
      simpa [head] using (Finset.sum_range_add (f := fun n ↦ lam n) m N)
  -- Remove the finite head block again; adding or subtracting a constant preserves divergence.
  simpa [head, add_assoc] using atTop.tendsto_atTop_add_const_left (-head) hshifted

/-- Helper for Theorem 30.1: every shifted Halpern weight product tends to `0`. -/
private theorem halpern_product_tail_tendsto_zero
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    (hlam_sum_diverges : Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) atTop atTop)
    (m : ℕ) :
    Tendsto
      (fun n ↦ (Finset.range n).prod fun k ↦ (1 - lam (m + k)))
      atTop (𝓝 (0 : ℝ)) := by
  -- Apply the initial-product lemma to the shifted parameter sequence `n ↦ λ_{m+n}`.
  exact
    halpern_product_tendsto_zero
      (lam := fun n ↦ lam (m + n))
      (fun n ↦ hlam_mem (m + n))
      (halpern_shifted_partial_sums_tendsto_atTop
        (lam := lam) hlam_sum_diverges m)

/-- Helper for Theorem 30.1: subtracting any reference point from one anchored Halpern step
rewrites it as the corresponding affine combination of the two residual vectors. -/
private theorem halpern_anchor_step_sub (z : H) (n : ℕ) :
    halpernIteration T lam x x (n + 1) - z =
      lam n • (x - z) +
        (1 - lam n) • (T (halpernIteration T lam x x n) - z) := by
  have hz_split : z = lam n • z + (1 - lam n) • z := by
    calc
      z = (1 : ℝ) • z := by simp
      _ = (lam n + (1 - lam n)) • z := by
        congr 1
        ring
      _ = lam n • z + (1 - lam n) • z := by rw [add_smul]
  -- Rewrite the step relative to `z`, then collect the two scaled residuals.
  calc
    halpernIteration T lam x x (n + 1) - z =
        (lam n • x + (1 - lam n) • T (halpernIteration T lam x x n)) - z := by
          rw [halpernIteration_succ]
    _ = (lam n • x + (1 - lam n) • T (halpernIteration T lam x x n)) -
          (lam n • z + (1 - lam n) • z) := by
          exact congrArg
            (fun t : H ↦
              (lam n • x + (1 - lam n) • T (halpernIteration T lam x x n)) - t)
            hz_split
    _ = lam n • (x - z) +
          (1 - lam n) • (T (halpernIteration T lam x x n) - z) := by
          module

/-- Helper for Theorem 30.1: in the anchored-start case, the distance to every fixed point is
bounded above by the initial anchor distance. -/
private theorem halpern_anchor_fixedPoint_bound
    (hD_convex : Convex ℝ D) (hT_nonexp : LipschitzOnWith 1 T D)
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1) :
    ∀ {z : H}, z ∈ FixT → ∀ n, ‖halpernIteration T lam x x n - z‖ ≤ ‖x - z‖ := by
  intro z hz n
  rcases mem_fixedPointSetOn_iff.mp hz with ⟨hzD, hzfix⟩
  induction n with
  | zero =>
      -- The anchored orbit starts exactly at the anchor point.
      simp
  | succ n ihn =>
      have hyn_mem : halpernIteration T lam x x n ∈ D :=
        halpernIteration_mem hD_convex hx hx hT_maps hlam_mem n
      have hT_step :
          ‖T (halpernIteration T lam x x n) - z‖ ≤ ‖halpernIteration T lam x x n - z‖ := by
        -- Compare the current iterate with the fixed point `z` through nonexpansiveness of `T`.
        simpa [dist_eq_norm, hzfix, one_mul] using
          hT_nonexp.dist_le_mul (halpernIteration T lam x x n) hyn_mem z hzD
      calc
        ‖halpernIteration T lam x x (n + 1) - z‖ =
            ‖lam n • (x - z) +
                (1 - lam n) • (T (halpernIteration T lam x x n) - z)‖ := by
              rw [halpern_anchor_step_sub (T := T) (lam := lam) (x := x) z n]
        _ ≤ ‖lam n • (x - z)‖ +
              ‖(1 - lam n) • (T (halpernIteration T lam x x n) - z)‖ := by
              exact norm_add_le _ _
        _ = lam n * ‖x - z‖ +
              (1 - lam n) * ‖T (halpernIteration T lam x x n) - z‖ := by
              rw [norm_smul, norm_smul,
                Real.norm_of_nonneg (hlam_mem n).1.le,
                Real.norm_of_nonneg (sub_nonneg.mpr (hlam_mem n).2.le)]
        _ ≤ lam n * ‖x - z‖ +
              (1 - lam n) * ‖halpernIteration T lam x x n - z‖ := by
              have hscaled :
                  (1 - lam n) * ‖T (halpernIteration T lam x x n) - z‖ ≤
                    (1 - lam n) * ‖halpernIteration T lam x x n - z‖ :=
                mul_le_mul_of_nonneg_left hT_step
                  (sub_nonneg.mpr (hlam_mem n).2.le)
              linarith
        _ ≤ lam n * ‖x - z‖ + (1 - lam n) * ‖x - z‖ := by
              have hscaled :
                  (1 - lam n) * ‖halpernIteration T lam x x n - z‖ ≤
                    (1 - lam n) * ‖x - z‖ :=
                mul_le_mul_of_nonneg_left ihn
                  (sub_nonneg.mpr (hlam_mem n).2.le)
              linarith
        _ = ‖x - z‖ := by ring

/-- Helper for Theorem 30.1: for the anchored orbit, the projection point controls the orbit, its
image under `T`, and the anchor residual by a common constant. -/
private theorem halpern_anchor_projection_bounds
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1) :
    ∀ n,
      ‖halpernIteration T lam x x n - P[FixT, hFix_cheb] x‖ ≤ ‖x - P[FixT, hFix_cheb] x‖ ∧
      ‖T (halpernIteration T lam x x n) - P[FixT, hFix_cheb] x‖ ≤ ‖x - P[FixT, hFix_cheb] x‖ ∧
      ‖x - T (halpernIteration T lam x x n)‖ ≤ 2 * ‖x - P[FixT, hFix_cheb] x‖ := by
  let p : H := P[FixT, hFix_cheb] x
  have hpFix : p ∈ FixT := by
    simpa [p] using projectionPoint_mem FixT hFix_cheb x
  intro n
  have hy_le : ‖halpernIteration T lam x x n - p‖ ≤ ‖x - p‖ :=
    halpern_anchor_fixedPoint_bound
      (hD_convex := hD_convex) (hT_nonexp := hT_nonexp)
      (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem) hpFix n
  have hyn_mem : halpernIteration T lam x x n ∈ D :=
    halpernIteration_mem hD_convex hx hx hT_maps hlam_mem n
  have hp_mem : p ∈ D := (mem_fixedPointSetOn_iff.mp hpFix).1
  have hTy_le : ‖T (halpernIteration T lam x x n) - p‖ ≤ ‖x - p‖ := by
    -- Nonexpansiveness controls the image of the orbit by the same projection radius.
    calc
      ‖T (halpernIteration T lam x x n) - p‖ ≤ ‖halpernIteration T lam x x n - p‖ := by
            simpa [dist_eq_norm, one_mul, (mem_fixedPointSetOn_iff.mp hpFix).2] using
              hT_nonexp.dist_le_mul (halpernIteration T lam x x n) hyn_mem p hp_mem
      _ ≤ ‖x - p‖ := hy_le
  refine ⟨hy_le, hTy_le, ?_⟩
  -- The residual to the anchor is bounded by the two projection radii and hence by `2 ‖x - p‖`.
  calc
    ‖x - T (halpernIteration T lam x x n)‖ =
        ‖(x - p) - (T (halpernIteration T lam x x n) - p)‖ := by
          congr 1
          abel_nf
    _ ≤ ‖x - p‖ + ‖T (halpernIteration T lam x x n) - p‖ := norm_sub_le _ _
    _ ≤ ‖x - p‖ + ‖x - p‖ := by
          linarith
    _ = 2 * ‖x - p‖ := by ring

/-- Helper for Theorem 30.1: in the anchored-start case, the difference between the next iterate
and the current image under `T` is exactly the current weight times the anchor residual. -/
private theorem halpern_anchor_step_residual_eq (n : ℕ) :
    halpernIteration T lam x x (n + 1) - T (halpernIteration T lam x x n) =
      lam n • (x - T (halpernIteration T lam x x n)) := by
  -- After expanding the recursion, the common `T` term factors out.
  rw [halpernIteration_succ]
  module

/-- Helper for Theorem 30.1: the anchored Halpern orbit satisfies the exact successive-difference
identity from source equation `(30.10)`. -/
private theorem halpern_anchor_successive_diff_eq (n : ℕ) :
    halpernIteration T lam x x (n + 2) - halpernIteration T lam x x (n + 1) =
      (lam (n + 1) - lam n) • (x - T (halpernIteration T lam x x n)) +
        (1 - lam (n + 1)) •
          (T (halpernIteration T lam x x (n + 1)) - T (halpernIteration T lam x x n)) := by
  -- Rewrite two consecutive recursion steps and then collect the anchor and map increments.
  rw [halpernIteration_succ, halpernIteration_succ]
  module

/-- Helper for Theorem 30.1: source equation `(30.11)` bounds the anchored successive
differences by the parameter variation and the previous iterate gap. -/
private theorem halpern_anchor_successive_diff_norm_le
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1) (n : ℕ) :
    ‖halpernIteration T lam x x (n + 2) - halpernIteration T lam x x (n + 1)‖ ≤
      |lam (n + 1) - lam n| * (2 * ‖x - P[FixT, hFix_cheb] x‖) +
        (1 - lam (n + 1)) *
          ‖halpernIteration T lam x x (n + 1) - halpernIteration T lam x x n‖ := by
  let y : ℕ → H := halpernIteration T lam x x
  have hFix_closed_convex' :
      IsClosed FixT ∧ Convex ℝ FixT :=
    isClosed_and_convex_fixedPointSetOn_of_quasinonexpansive
      hT_nonexp.quasinonexpansiveOn hD_closed hD_convex
  have hFix_cheb' : IsChebyshev FixT :=
    isChebyshev_of_nonempty_isClosed_convex
      hFix_nonempty hFix_closed_convex'.1 hFix_closed_convex'.2
  let p : H := P[FixT, hFix_cheb'] x
  have hbounds :=
    halpern_anchor_projection_bounds
      (hD_closed := hD_closed) (hD_convex := hD_convex)
      (hT_nonexp := hT_nonexp) (hFix_nonempty := hFix_nonempty)
      (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem) n
  have hresidual_bound : ‖x - T (y n)‖ ≤ 2 * ‖x - p‖ := by
    simpa [y, p] using hbounds.2.2
  have hyn_mem : y n ∈ D := by
    simpa [y] using halpernIteration_mem hD_convex hx hx hT_maps hlam_mem n
  have hyn_succ_mem : y (n + 1) ∈ D := by
    simpa [y] using halpernIteration_mem hD_convex hx hx hT_maps hlam_mem (n + 1)
  have hT_step :
      ‖T (y (n + 1)) - T (y n)‖ ≤ ‖y (n + 1) - y n‖ := by
    simpa [y, dist_eq_norm, one_mul] using
      hT_nonexp.dist_le_mul (y (n + 1)) hyn_succ_mem (y n) hyn_mem
  -- This is the scalar norm inequality that drives the later tail-product recursion.
  calc
    ‖y (n + 2) - y (n + 1)‖ =
        ‖(lam (n + 1) - lam n) • (x - T (y n)) +
            (1 - lam (n + 1)) • (T (y (n + 1)) - T (y n))‖ := by
          rw [halpern_anchor_successive_diff_eq
            (T := T) (lam := lam) (x := x) n]
    _ ≤ ‖(lam (n + 1) - lam n) • (x - T (y n))‖ +
          ‖(1 - lam (n + 1)) • (T (y (n + 1)) - T (y n))‖ := by
          exact norm_add_le _ _
    _ = |lam (n + 1) - lam n| * ‖x - T (y n)‖ +
          (1 - lam (n + 1)) * ‖T (y (n + 1)) - T (y n)‖ := by
          rw [norm_smul, norm_smul, Real.norm_eq_abs,
            Real.norm_of_nonneg (sub_nonneg.mpr (hlam_mem (n + 1)).2.le)]
    _ ≤ |lam (n + 1) - lam n| * (2 * ‖x - p‖) +
          (1 - lam (n + 1)) * ‖T (y (n + 1)) - T (y n)‖ := by
          exact add_le_add
            (mul_le_mul_of_nonneg_left hresidual_bound (abs_nonneg _))
            le_rfl
    _ ≤ |lam (n + 1) - lam n| * (2 * ‖x - p‖) +
          (1 - lam (n + 1)) * ‖y (n + 1) - y n‖ := by
          exact add_le_add le_rfl <|
            mul_le_mul_of_nonneg_left hT_step
              (sub_nonneg.mpr (hlam_mem (n + 1)).2.le)

/-- Helper for Theorem 30.1: source estimate `(30.12)` gives a shifted finite-horizon bound on the
anchored successive differences. -/
private theorem halpern_anchor_diff_tail_bound
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1) :
    ∀ m r,
      ‖halpernIteration T lam x x (m + r + 2) - halpernIteration T lam x x (m + r + 1)‖ ≤
        (2 * ‖x - P[FixT, hFix_cheb] x‖) *
          ((Finset.range (r + 1)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|) +
        ‖halpernIteration T lam x x (m + 1) - halpernIteration T lam x x m‖ *
          ((Finset.range (r + 1)).prod fun k ↦ (1 - lam (m + k + 1))) := by
  let y : ℕ → H := halpernIteration T lam x x
  let c : ℝ := 2 * ‖x - P[FixT, hFix_cheb] x‖
  intro m r
  induction r with
  | zero =>
      -- The horizon `r = 0` is exactly the one-step estimate `(30.11)`.
      simpa [y, c, Finset.sum_range_succ, Finset.prod_range_succ, Nat.add_assoc, Nat.add_left_comm,
        Nat.add_comm, mul_comm, mul_left_comm, mul_assoc] using
        (halpern_anchor_successive_diff_norm_le
          (hD_closed := hD_closed) (hD_convex := hD_convex)
          (hT_nonexp := hT_nonexp) (hFix_nonempty := hFix_nonempty)
          (T := T) (lam := lam) (x := x)
          (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem) m)
  | succ r ihr =>
      have hstep :=
        halpern_anchor_successive_diff_norm_le
          (hD_closed := hD_closed) (hD_convex := hD_convex)
          (hT_nonexp := hT_nonexp) (hFix_nonempty := hFix_nonempty)
          (T := T) (lam := lam) (x := x)
          (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem) (m + r + 1)
      have hβ_nonneg : 0 ≤ 1 - lam (m + r + 2) := by
        exact sub_nonneg.mpr (hlam_mem (m + r + 2)).2.le
      have hβ_le_one : 1 - lam (m + r + 2) ≤ 1 := by
        linarith [(hlam_mem (m + r + 2)).1]
      have hsum_nonneg :
          0 ≤ (Finset.range (r + 1)).sum (fun k ↦ |lam (m + k + 1) - lam (m + k)|) := by
        exact Finset.sum_nonneg fun _ _ ↦ abs_nonneg _
      have hc_nonneg : 0 ≤ c := by
        dsimp [c]
        positivity
      have hscaled_sum :
          (1 - lam (m + r + 2)) *
              (c * ((Finset.range (r + 1)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|)) ≤
            c * ((Finset.range (r + 1)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|) := by
        have hcs_nonneg :
            0 ≤ c * ((Finset.range (r + 1)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|) := by
          exact mul_nonneg hc_nonneg hsum_nonneg
        have hmul := mul_le_mul_of_nonneg_right hβ_le_one hcs_nonneg
        simpa [one_mul, mul_comm, mul_left_comm, mul_assoc] using hmul
      have hscaled_ih := mul_le_mul_of_nonneg_left ihr hβ_nonneg
      -- Multiply the induction bound by the new factor and absorb it into the enlarged tail sum.
      calc
        ‖y (m + (r + 1) + 2) - y (m + (r + 1) + 1)‖ ≤
            |lam (m + r + 2) - lam (m + r + 1)| * c +
              (1 - lam (m + r + 2)) * ‖y (m + r + 2) - y (m + r + 1)‖ := by
                simpa [y, c, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm,
                  mul_comm, mul_left_comm, mul_assoc] using hstep
        _ ≤
            |lam (m + r + 2) - lam (m + r + 1)| * c +
              (1 - lam (m + r + 2)) *
                (c * ((Finset.range (r + 1)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|) +
                  ‖y (m + 1) - y m‖ *
                    ((Finset.range (r + 1)).prod fun k ↦ (1 - lam (m + k + 1)))) := by
              exact add_le_add le_rfl hscaled_ih
        _ =
            |lam (m + r + 2) - lam (m + r + 1)| * c +
              ((1 - lam (m + r + 2)) *
                  (c * ((Finset.range (r + 1)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|)) +
                (1 - lam (m + r + 2)) *
                  (‖y (m + 1) - y m‖ *
                    ((Finset.range (r + 1)).prod fun k ↦ (1 - lam (m + k + 1)))) ) := by
              ring
        _ ≤
            |lam (m + r + 2) - lam (m + r + 1)| * c +
              (c * ((Finset.range (r + 1)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|) +
                (1 - lam (m + r + 2)) *
                  (‖y (m + 1) - y m‖ *
                    ((Finset.range (r + 1)).prod fun k ↦ (1 - lam (m + k + 1))))) := by
              exact add_le_add le_rfl (add_le_add hscaled_sum le_rfl)
        _ =
            (2 * ‖x - P[FixT, hFix_cheb] x‖) *
              ((Finset.range (r + 2)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|) +
            ‖y (m + 1) - y m‖ *
              ((Finset.range (r + 2)).prod fun k ↦ (1 - lam (m + k + 1))) := by
              have hsum :
                  ((Finset.range (r + 2)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|) =
                    ((Finset.range (r + 1)).sum fun k ↦ |lam (m + k + 1) - lam (m + k)|) +
                      |lam (m + r + 2) - lam (m + r + 1)| := by
                rw [show r + 2 = (r + 1) + 1 by omega, Finset.sum_range_succ]
                simp [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
              have hprod :
                  ((Finset.range (r + 2)).prod fun k ↦ (1 - lam (m + k + 1))) =
                    ((Finset.range (r + 1)).prod fun k ↦ (1 - lam (m + k + 1))) *
                      (1 - lam (m + r + 2)) := by
                rw [show r + 2 = (r + 1) + 1 by omega, Finset.prod_range_succ]
                simp [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
              rw [hsum, hprod]
              dsimp [c]
              ring

/-- Helper for Theorem 30.1: source estimate `(30.12)` forces the anchored successive
differences to converge strongly to `0`. -/
private theorem halpern_anchor_successive_diff_tendsto_zero
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D)
    (hT_nonexp : LipschitzOnWith 1 T D)
    (hFix_nonempty : (fixedPointSetOn D T).Nonempty)
