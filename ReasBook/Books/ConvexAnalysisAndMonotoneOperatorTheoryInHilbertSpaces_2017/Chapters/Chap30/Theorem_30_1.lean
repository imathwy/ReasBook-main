    (hlam_successive_diff_summable : Summable (fun n ↦ |lam (n + 1) - lam n|)) :
    Tendsto
      (fun n ↦ halpernIteration T lam x x (n + 1) - halpernIteration T lam x x n)
      atTop (𝓝 (0 : H)) := by
