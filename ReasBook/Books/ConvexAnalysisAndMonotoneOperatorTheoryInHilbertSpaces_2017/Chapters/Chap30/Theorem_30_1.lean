/-- Theorem 30.1: if `D` is a closed convex subset of a real Hilbert space, `T` is nonexpansive
on `D` with a fixed point in `D`, `lam n ∈ ]0,1[` tends to `0`, its partial sums diverge to
`+∞`, and `∑ |lam (n + 1) - lam n|` converges, then the Halpern iteration generated by `T`,
`lam`, `x`, and `x0 ∈ D` converges strongly to the metric projection of `x` onto `Fix T ∩ D`. -/
theorem halpern_iteration_tendsto_projection_fixedPointSetOn
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D) (hx0 : x0 ∈ D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    (hlam_tendsto_zero : Tendsto lam atTop (𝓝 (0 : ℝ)))
    (hlam_sum_diverges : Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) atTop atTop)
    (hlam_successive_diff_summable : Summable (fun n ↦ |lam (n + 1) - lam n|)) :
    Tendsto (halpernIteration T lam x x0) atTop (𝓝 (P[FixT, hFix_cheb] x)) := by
  have hanchor :
      Tendsto (halpernIteration T lam x x) atTop (𝓝 (P[FixT, hFix_cheb] x)) := by
    simpa using
      (halpern_iteration_tendsto_projection_fixedPointSetOn_of_anchor_start
        (hD_closed := hD_closed) (hD_convex := hD_convex)
        (hT_nonexp := hT_nonexp) (hFix_nonempty := hFix_nonempty)
        (D := D) (T := T) (x := x) (lam := lam)
        (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem)
        (hlam_tendsto_zero := hlam_tendsto_zero)
        (hlam_sum_diverges := hlam_sum_diverges)
        (hlam_successive_diff_summable := hlam_successive_diff_summable))
  have hdiff :
      Tendsto
        (fun n ↦ halpernIteration T lam x x0 n - halpernIteration T lam x x n)
        atTop (𝓝 (0 : H)) :=
    halpern_orbit_difference_tendsto_zero_to_anchor
      (hD_convex := hD_convex) (hT_nonexp := hT_nonexp) hx hx0 hT_maps hlam_mem
      hlam_sum_diverges
  -- Reduce the general initial point to the anchored-start orbit.
  exact Filter.tendsto_of_sub_tendsto_zero (m := P[FixT, hFix_cheb] x) hanchor hdiff

