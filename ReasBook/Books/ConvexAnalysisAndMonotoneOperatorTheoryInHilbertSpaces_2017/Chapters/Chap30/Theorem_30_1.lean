/-- Helper for Theorem 30.1: every weak sequential cluster point of the anchored Halpern orbit is
an actual fixed point of `T`. -/
private theorem halpern_weak_clusterPoint_mem_fixedPointSet_of_anchor_start
    (hD_closed : IsClosed D) (hD_convex : Convex ℝ D)
    (hT_nonexp : LipschitzOnWith 1 T D)
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    (hres :
      Tendsto
        (fun n ↦
          halpernIteration T lam x x n - T (halpernIteration T lam x x n))
        atTop (𝓝 (0 : H))) :
    ∀ z : H,
      IsSequentialClusterPt
        (fun n ↦ toWeakSpace ℝ H (halpernIteration T lam x x n))
        (toWeakSpace ℝ H z) →
      z ∈ FixT := by
  intro z hz
  let y : ℕ → H := halpernIteration T lam x x
  rcases hz.exists_subseq_tendsto with ⟨φ, hφ, hφz⟩
  have hy_mem : ∀ n, y n ∈ D := by
    intro n
    simpa [y] using halpernIteration_mem hD_convex hx hx hT_maps hlam_mem n
  have hzD : z ∈ D := by
    -- Closed convexity makes the weak image of `D` closed, so weak limits of orbit subsequences
    -- remain in `D`.
    have hD_weakClosed : IsClosed ((toWeakSpace ℝ H) '' D) := by
      rw [← closure_eq_iff_isClosed]
      calc
        closure ((toWeakSpace ℝ H) '' D) = (toWeakSpace ℝ H) '' closure D := by
          simpa using (hD_convex.toWeakSpace_closure ℝ).symm
        _ = (toWeakSpace ℝ H) '' D := by
          rw [hD_closed.closure_eq]
    have hzWeak :
        toWeakSpace ℝ H z ∈ closure ((toWeakSpace ℝ H) '' D) := by
      exact mem_closure_of_tendsto hφz <|
        Eventually.of_forall fun n ↦ ⟨y (φ n), hy_mem (φ n), rfl⟩
    rw [hD_weakClosed.closure_eq] at hzWeak
    rcases hzWeak with ⟨w, hwD, hwz⟩
    exact (toWeakSpace ℝ H).injective hwz ▸ hwD
  let zD : D := ⟨z, hzD⟩
  let ySub : ℕ → D := fun n ↦ ⟨y (φ n), hy_mem (φ n)⟩
  have hTsub : LipschitzWith 1 (fun y : D ↦ T y) := by
    refine LipschitzWith.of_dist_le_mul ?_
    intro y₁ y₂
    simpa [Subtype.dist_eq, one_mul] using
      hT_nonexp.dist_le_mul (y₁ : H) y₁.2 (y₂ : H) y₂.2
  have hweak :
      Tendsto (fun n ↦ toWeakSpace ℝ H (ySub n : H))
        atTop (𝓝 (toWeakSpace ℝ H (zD : H))) := by
    -- The cluster-point witness is already the weak convergence input required by Corollary 4.28.
    simpa [ySub, zD, y, Function.comp] using hφz
  have hres_sub :
      Tendsto (fun n ↦ (ySub n : H) - T (ySub n)) atTop (𝓝 (0 : H)) := by
    -- Residual convergence survives passage to the chosen subsequence.
    simpa [ySub, y] using hres.comp hφ.tendsto_atTop
  have hz_fixed : T zD = (zD : H) := by
    -- Demiclosedness turns the weak subsequential limit into a fixed point.
    simpa [zD] using
      map_eq_of_tendsto_weakly_of_residual_tendsto_zero_of_nonexpansive
        (D := D)
        (T := fun y : D ↦ T y)
        (xₙ := ySub)
        (x := zD)
        hD_closed hD_convex hTsub hweak hres_sub
  exact mem_fixedPointSetOn_iff.mpr ⟨hzD, by simpa [zD] using hz_fixed⟩

/-- Helper for Theorem 30.1: the source subsequence/projection argument `(30.15)`-`(30.16)`
shows that the anchored inner-product limsup is nonpositive. -/
private theorem halpern_limsup_inner_projection_le_zero_of_anchor_start
    (hx : x ∈ D) (hT_maps : Set.MapsTo T D D)
    (hlam_mem : ∀ n, lam n ∈ Set.Ioo (0 : ℝ) 1)
    (hlam_tendsto_zero : Tendsto lam atTop (𝓝 (0 : ℝ)))
    (hlam_sum_diverges : Tendsto (fun N ↦ (Finset.range N).sum (fun n ↦ lam n)) atTop atTop)
    (hlam_successive_diff_summable : Summable (fun n ↦ |lam (n + 1) - lam n|)) :
    Filter.limsup
      (fun n ↦
        ((inner ℝ
            (T (halpernIteration T lam x x n) - P[FixT, hFix_cheb] x)
            (x - P[FixT, hFix_cheb] x) : ℝ) : EReal))
      atTop ≤ 0 := by
  let y : ℕ → H := halpernIteration T lam x x
  let p : H := P[FixT, hFix_cheb] x
  let a : ℕ → ℝ := fun n ↦ inner ℝ (T (y n) - p) (x - p)
  let ξ : ℕ → EReal := fun n ↦ ((a n : ℝ) : EReal)
  have hres :
      Tendsto (fun n ↦ y n - T (y n)) atTop (𝓝 (0 : H)) := by
    -- Source equations `(30.13)`-`(30.14)` give the residual decay needed for demiclosedness.
    simpa [y] using
      halpern_residual_tendsto_zero_of_anchor_start
        (hD_closed := hD_closed) (hD_convex := hD_convex)
        (hT_nonexp := hT_nonexp) (hFix_nonempty := hFix_nonempty)
        (T := T) (lam := lam) (x := x)
        (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem)
        (hlam_tendsto_zero := hlam_tendsto_zero)
        (hlam_sum_diverges := hlam_sum_diverges)
        (hlam_successive_diff_summable := hlam_successive_diff_summable)
  obtain ⟨φ, hφ, hφξ⟩ := Net.exists_subsequence_tendsto_limsup ξ
  have hy_bounded :
      Bornology.IsBounded (Set.range fun n ↦ y (φ n)) := by
    rw [isBounded_iff_forall_norm_le]
    refine ⟨‖p‖ + ‖x - p‖, ?_⟩
    intro z hz
    rcases hz with ⟨n, rfl⟩
    have hy_le :
        ‖y (φ n) - p‖ ≤ ‖x - p‖ := by
      simpa [y, p] using
        (halpern_anchor_projection_bounds
          (hD_closed := hD_closed) (hD_convex := hD_convex)
          (hT_nonexp := hT_nonexp) (hFix_nonempty := hFix_nonempty)
          (T := T) (lam := lam) (x := x)
          (hx := hx) (hT_maps := hT_maps) (hlam_mem := hlam_mem) (φ n)).1
    -- The anchored orbit stays in the projection ball around `p`, hence it is bounded.
    calc
      ‖y (φ n)‖ = ‖(y (φ n) - p) + p‖ := by
        congr 1
        abel
      _ ≤ ‖y (φ n) - p‖ + ‖p‖ := norm_add_le _ _
      _ ≤ ‖x - p‖ + ‖p‖ := by
        linarith
      _ = ‖p‖ + ‖x - p‖ := by ring
  obtain ⟨z, ψ, hψ, hψz⟩ :=
    bounded_sequence_has_weakly_convergent_subsequence (fun n ↦ y (φ n)) hy_bounded
  let χ : ℕ → ℕ := φ ∘ ψ
  have hχ : StrictMono χ := hφ.comp hψ
  have hχz :
      Tendsto (fun n ↦ toWeakSpace ℝ H (y (χ n))) atTop (𝓝 (toWeakSpace ℝ H z)) := by
    -- The weakly convergent subsubsequence is exactly the one needed in `(30.15)`.
    simpa [χ, Function.comp] using hψz
  have hzFix : z ∈ FixT := by
    have hzCluster :
        IsSequentialClusterPt
          (fun n ↦ toWeakSpace ℝ H (y n))
          (toWeakSpace ℝ H z) := by
      exact ⟨χ, hχ, hχz⟩
    -- Demiclosedness identifies every weak cluster point of the anchored orbit as a fixed point.
    exact
      halpern_weak_clusterPoint_mem_fixedPointSet_of_anchor_start
        (hD_closed := hD_closed) (hD_convex := hD_convex)
        (hT_nonexp := hT_nonexp)
        (T := T) (lam := lam) (x := x) (hx := hx) (hT_maps := hT_maps)
        (hlam_mem := hlam_mem) hres z hzCluster
  have hres_sub :
      Tendsto (fun n ↦ T (y (χ n)) - y (χ n)) atTop (𝓝 (0 : H)) := by
    have hres_comp :
        Tendsto (fun n ↦ y (χ n) - T (y (χ n))) atTop (𝓝 (0 : H)) := by
      simpa [y, χ, Function.comp] using hres.comp hχ.tendsto_atTop
    -- The residual term in `(30.16)` is the negative of the already-vanishing residual.
    simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hres_comp.neg
  have hres_inner :
      Tendsto (fun n ↦ inner ℝ (T (y (χ n)) - y (χ n)) (x - p)) atTop (𝓝 0) := by
    have hnorm_zero :
        Tendsto (fun n ↦ ‖T (y (χ n)) - y (χ n)‖ * ‖x - p‖) atTop (𝓝 (0 : ℝ)) := by
      simpa [zero_mul] using hres_sub.norm.mul_const ‖x - p‖
    have habs_zero :
        Tendsto (fun n ↦ |inner ℝ (T (y (χ n)) - y (χ n)) (x - p)|) atTop (𝓝 0) := by
      exact squeeze_zero
        (fun _ ↦ abs_nonneg _)
        (fun n ↦ abs_real_inner_le_norm _ _)
        hnorm_zero
    -- A scalar sequence whose absolute values tend to `0` itself tends to `0`.
    exact (tendsto_zero_iff_abs_tendsto_zero _).2 habs_zero
  have hweak_inner :
      Tendsto (fun n ↦ inner ℝ (y (χ n) - p) (x - p)) atTop
        (𝓝 (inner ℝ (z - p) (x - p))) := by
    have hsub :
        Tendsto (fun n ↦ toWeakSpace ℝ H (y (χ n) - p)) atTop
          (𝓝 (toWeakSpace ℝ H (z - p))) := by
      -- Subtracting the fixed projection point preserves weak convergence.
      simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using
        hχz.sub
          (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ toWeakSpace ℝ H p) atTop
            (𝓝 (toWeakSpace ℝ H p)))
    simpa [real_inner_comm] using
      ((weakSpace_continuous_inner_right (H := H) (x - p)).tendsto
        (toWeakSpace ℝ H (z - p))).comp hsub
  have ha_tendsto :
      Tendsto (fun n ↦ a (χ n)) atTop (𝓝 (inner ℝ (z - p) (x - p))) := by
    have hsplit :
        (fun n ↦ a (χ n)) =
          fun n ↦ inner ℝ (T (y (χ n)) - y (χ n)) (x - p) +
            inner ℝ (y (χ n) - p) (x - p) := by
      funext n
      dsimp [a]
      have hdecomp :
          T (y (χ n)) - p = (T (y (χ n)) - y (χ n)) + (y (χ n) - p) := by
        abel
      rw [hdecomp, inner_add_left]
    -- Split `(30.16)` into the vanishing residual term and the weakly convergent orbit term.
    rw [hsplit]
    simpa using hres_inner.add hweak_inner
  have hχξ :
      Tendsto (fun n ↦ ξ (χ n)) atTop (𝓝 (Filter.limsup ξ atTop)) := by
    simpa [ξ, χ, Function.comp] using hφξ.comp hψ.tendsto_atTop
  have ha_ereal :
      Tendsto (fun n ↦ ξ (χ n)) atTop
        (𝓝 (((inner ℝ (z - p) (x - p) : ℝ) : EReal))) := by
    -- The scalar subsequence limit agrees with the real limit once coerced to `EReal`.
    simpa [ξ, a, χ] using
      (continuous_coe_real_ereal.tendsto _).comp ha_tendsto
  have hlimsup_eq :
      Filter.limsup ξ atTop = (((inner ℝ (z - p) (x - p) : ℝ) : EReal)) := by
    exact tendsto_nhds_unique hχξ ha_ereal
  have hp_nonpos :
      inner ℝ (z - p) (x - p) ≤ 0 := by
    have hp_char :
        p ∈ FixT ∧ ∀ w ∈ FixT, inner ℝ (w - p) (x - p) ≤ 0 := by
      exact
        (eq_projectionPoint_iff_mem_and_inner_sub_right_nonpos
          (C := FixT) hFix_cheb (hFix_closed_convex).2).mp rfl
    -- The projection variational inequality closes the source argument `(30.16)`.
    exact hp_char.2 z hzFix
  rw [hlimsup_eq]
  exact_mod_cast hp_nonpos

