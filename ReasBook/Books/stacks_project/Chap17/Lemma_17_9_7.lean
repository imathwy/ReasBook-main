import Mathlib
import stacks_project.Chap17.Definition_17_9_1

open CategoryTheory Limits

noncomputable section

universe u

namespace SheafOfModules

/- Domain-style sampling for Lemma 17.9.7:
- primary domain: directed colimits of finite-type sheaves of modules on a quasi-compact
  topological space;
- inspected owner declarations:
  `SheafOfModules.IsFiniteType`,
  `SheafOfModules.LocalGeneratorsData`,
  `SheafOfModules.GeneratingSections.ofEpi`,
  `colimit.ι`;
- best owner abstraction:
  the ambient owner category `SheafOfModules 𝒪`, with the canonical colimit coprojections
  `colimit.ι ℱ i`;
- primitive data:
  the sheaf of rings `𝒪`, the directed diagram `ℱ`, and finite local generator data for
  `colimit ℱ`;
- derived API:
  the source-facing existence of a stage whose canonical map to the colimit is epi, and the
  stabilization statement under monic transition maps.

Source/core/bridge triage:
- `source-facing`: the two Stacks Project assertions about finite-type directed colimits;
- `core/canonical`: `SheafOfModules 𝒪`, `SheafOfModules.IsFiniteType`, and the canonical colimit
  maps `colimit.ι`;
- `bridge/view`: the ringed-space specialization obtained by taking
  `𝒪 = RingedSpace.ringCatSheaf X`.

The file should therefore live at the generic `SheafOfModules` owner layer, with ringed spaces
appearing only as a specialization of the ambient sheaf of rings. -/

variable {X : TopCat.{u}} [CompactSpace X]
variable {𝒪 : TopCat.Sheaf RingCat.{u} X}
variable {I : Type u} [Preorder I] [Nonempty I] [IsDirectedOrder I]
variable (ℱ : I ⥤ SheafOfModules 𝒪)

-- Proof sketch: cover the quasi-compact space by finitely many opens on which the finite type
-- colimit sheaf is generated by finitely many local sections, choose a stage from which each of
-- those generators comes, and then use directedness to dominate all chosen stages at once.
/-- Lemma 17.9.7 (1): for a directed system of `\mathcal O`-module sheaves on a quasi-compact
space, if the colimit sheaf is of finite type, then some stage maps epimorphically onto the
colimit. -/
theorem exists_epi_colimit_iota_of_isFiniteType
    [(colimit ℱ).IsFiniteType] :
    ∃ i : I, Epi (colimit.ι ℱ i) := sorry

-- Proof sketch: apply the epimorphism statement above, then use that a colimit coprojection from a
-- mono directed system is also monic, so the chosen map is both epi and mono and hence an
-- isomorphism.
/-- Lemma 17.9.7 (2): if moreover every transition morphism in the directed system is mono, then
the finite type colimit stabilizes at some stage, i.e. one canonical map `\mathcal F_i \to \colim
\mathcal F_i` is an isomorphism. -/
theorem exists_isIso_colimit_iota_of_isFiniteType_of_mono
    [(colimit ℱ).IsFiniteType]
    (hmono : ∀ ⦃i i' : I⦄ (f : i ⟶ i'), Mono (ℱ.map f)) :
    ∃ i : I, IsIso (colimit.ι ℱ i) := sorry

end SheafOfModules
