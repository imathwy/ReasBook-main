open CategoryTheory
open CategoryTheory.Limits

universe u v

noncomputable section

namespace CategoryTheory

variable (A : Type u) [Category.{v} A] [Abelian A]

local notation "J" => Pretopology.toGrothendieck (singletonEpiPretopology : Pretopology A)

/- Domain-style sampling for Lemma 19.9.2:
- primary domain: Grothendieck topologies on abelian categories, stated source-facing via the
  singleton-epimorphism site and supported canonically by the exact-structure sheaf-Yoneda API;
- sampled owner declarations:
  `singletonEpiPretopology`,
  `Pretopology.toGrothendieck`,
  `ExactStructure.preadditiveYoneda_isSheaf`,
  `ExactStructure.sheafYoneda`;
- best owner abstraction: the source-facing site owner
  `(singletonEpiPretopology : Pretopology A).toGrothendieck`;
- primitive data: the singleton covering pretopology generated by epimorphisms, already introduced
  in Lemma 19.9.1;
- derived API: the induced Grothendieck topology, representables as sheaves, the sheaf-valued
  Yoneda functor, its exact-functor packaging, and enough points.

Source/core/bridge triage:
- `source-facing`: `singletonEpiPretopology` and its generated topology;
- `core/canonical`: `Pretopology.toGrothendieck`,
  `ExactStructure.preadditiveYoneda_isSheaf`, `ExactStructure.sheafYoneda`, and `ExactFunctor.of`;
- `bridge/view`: the internal abelian exact structure whose admissible epimorphisms are exactly the
  ordinary epimorphisms, together with the comparison to
  `(singletonEpiPretopology : Pretopology A).toGrothendieck`.

Primitive-versus-derived check:
- primitive data should remain the singleton-epimorphism pretopology from Lemma 19.9.1;
- the exact-structure realization is auxiliary bridge data, not the public owner for this file;
- the sheaf and Yoneda statements are derived from the source-facing site via that bridge.
-/

-- Internal bridge: realize the singleton-epimorphism site through the canonical exact structure on
-- an abelian category so that the exact-structure sheaf-Yoneda API can be reused without becoming
-- the public owner of Lemma 19.9.2.
private def singletonEpiExactStructure : ExactStructure A where
  admissible := {S | S.ShortExact}
  isKernelCokernelPair := by
    sorry
  ofIso := by
    sorry
  id_admissibleMono := by
    sorry
  id_admissibleEpi := by
    sorry
  comp_admissibleMono := by
    sorry
  comp_admissibleEpi := by
    sorry
  pushout_admissibleMono := by
    sorry
  pullback_admissibleEpi := by
    sorry

-- Internal bridge: in an abelian category the admissible epimorphisms for the canonical exact
-- structure are exactly the ordinary epimorphisms.
private theorem singletonEpiExactStructure_admissibleEpi_iff {Y Z : A} (p : Y ⟶ Z) :
    (singletonEpiExactStructure A).AdmissibleEpi p ↔ Epi p := by
  sorry

-- Internal bridge: the topology generated from the singleton-epimorphism pretopology is exactly
-- the admissible-epimorphism topology coming from the canonical abelian exact structure.
private theorem singletonEpiPretopology_toGrothendieck_eq_exactTopology :
    J = (singletonEpiExactStructure A).topology := by
  sorry

/-- Lemma 19.9.2: for every object `X`, the representable additive presheaf `U ↦ Hom(U, X)` is a
sheaf for the singleton-epimorphism topology on `A`. -/
theorem singletonEpiPretopology_preadditiveYoneda_isSheaf (X : A) :
    Presheaf.IsSheaf J (preadditiveYoneda.obj X) := by
  simpa [singletonEpiPretopology_toGrothendieck_eq_exactTopology] using
    ExactStructure.preadditiveYoneda_isSheaf (singletonEpiExactStructure A) X

/-- The sheaf-valued Yoneda functor for the singleton-epimorphism site of an abelian category. -/
noncomputable def singletonEpiSheafYoneda :
    A ⥤ Sheaf J AddCommGrpCat.{v} :=
  ObjectProperty.lift _ preadditiveYoneda
    (fun X ↦ singletonEpiPretopology_preadditiveYoneda_isSheaf A X)

/-- The sheaf-valued Yoneda functor on the singleton-epimorphism site preserves finite limits. -/
noncomputable instance singletonEpiSheafYoneda_preservesFiniteLimits :
    PreservesFiniteLimits (singletonEpiSheafYoneda A) := by
  sorry

/-- The sheaf-valued Yoneda functor on the singleton-epimorphism site preserves finite colimits. -/
noncomputable instance singletonEpiSheafYoneda_preservesFiniteColimits :
    PreservesFiniteColimits (singletonEpiSheafYoneda A) := by
  sorry

/- Lemma 19.9.2 (1): the assignment `X ↦ h_X` defines an exact functor from the abelian category
`A` to abelian sheaves on the singleton-epimorphism site of `A`; this is the canonical bundled
exact functor `ExactFunctor.of (singletonEpiSheafYoneda A)`. -/
#check
  (ExactFunctor.of (singletonEpiSheafYoneda A) :
    A ⥤ₑ Sheaf J AddCommGrpCat.{v})

/-- The sheaf-valued Yoneda functor for the singleton-epimorphism site is full. -/
noncomputable instance singletonEpiSheafYoneda_full :
    Functor.Full (singletonEpiSheafYoneda A) := by
  dsimp [singletonEpiSheafYoneda]
  infer_instance

/- Lemma 19.9.2 (2): the functor `X ↦ h_X` is full on the singleton-epimorphism site. -/
#synth Functor.Full (singletonEpiSheafYoneda A)

/-- The sheaf-valued Yoneda functor for the singleton-epimorphism site is faithful. -/
instance singletonEpiSheafYoneda_faithful :
    Functor.Faithful (singletonEpiSheafYoneda A) := by
  dsimp [singletonEpiSheafYoneda]
  infer_instance

/- Lemma 19.9.2 (3): the functor `X ↦ h_X` is faithful on the singleton-epimorphism site. -/
#synth Functor.Faithful (singletonEpiSheafYoneda A)

-- Internal bridge: enough points is obtained from the exact-structure topology and then
-- transported across the topology comparison.
private theorem singletonEpiExactStructure_topology_hasEnoughPoints :
    ((singletonEpiExactStructure A).topology : GrothendieckTopology A).HasEnoughPoints := by
  sorry

/-- Lemma 19.9.2 (4): the singleton-epimorphism topology on an abelian category has enough
points. -/
theorem singletonEpiPretopology_toGrothendieck_hasEnoughPoints :
    (J : GrothendieckTopology A).HasEnoughPoints :=
  by
    simpa [singletonEpiPretopology_toGrothendieck_eq_exactTopology] using
      singletonEpiExactStructure_topology_hasEnoughPoints A

end CategoryTheory
