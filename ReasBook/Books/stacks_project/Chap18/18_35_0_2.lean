import Mathlib
import stacks_project.Chap18.Lemma_18_33_8

open CategoryTheory CategoryTheory.Limits

noncomputable section

universe u

namespace SheafOfModules.RingedSite

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
variable [HasWeakSheafify J (Type u)]
variable [HasWeakSheafify J CommRingCat.{u}]
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat.{u})]
variable [J.HasSheafCompose (CategoryTheory.forget CommRingCat.{u})]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [HasBinaryCoproducts (Sheaf J CommRingCat.{u})]

/- Domain-style sampling for 18.35.0.2:
- primary domain: the conormal morphism for the canonical presentation of an `\mathcal A`-algebra
  sheaf `\mathcal B`;
- sampled owner declarations:
  `Sheaf.composeAndSheafify J CommRingCat.free`,
  `Sheaf.adjunction J CommRingCat.adj`,
  `Under.costarAdjForget`,
  `presentationBase`,
  `presentationMap`,
  `conormalMap`;
- best owner abstraction: the generic site-level owner
  `conormalMap φ α : conormalSource α ⟶ conormalTensorTerm φ α` from Lemma `18.33.8`, where
  `conormalSource α` is the scalar-extended source-side conormal term used in the exact sequence;
- primitive data: the underlying sheaf of sets of `\mathcal B`, the free commutative ring sheaf
  `\mathbf Z[\mathcal B]`, the relative free `\mathcal A`-algebra
  `\mathcal A[\mathcal B] = \mathcal A \amalg \mathbf Z[\mathcal B]`, its structure map
  `\mathcal A \to \mathcal A[\mathcal B]`, and the evaluation map
  `\mathcal A[\mathcal B] \to \mathcal B`;
- derived API: only the specialization of the owner `conormalMap` to that presentation.

Source/core/bridge triage:
- `source-facing`: Equation `18.35.0.2`, the conormal morphism of the canonical presentation;
- `core/canonical`: `conormalSource`, `conormalTensorTerm`, and `conormalMap` from
  Lemma `18.33.8`;
- `bridge/view`: the presentation-specific maps `presentationBase` and `presentationMap`.

This file therefore keeps only the presentation specialization and reuses the chapter owner
`conormalMap` directly instead of maintaining a parallel local copy of the conormal API. -/

/-- The underlying sheaf of sets of the `\mathcal A`-algebra sheaf `\mathcal B`. -/
abbrev presentationVariables
    {𝒜 : Sheaf J CommRingCat.{u}}
    (𝒝 : Under 𝒜) :
    Sheaf J (Type u) :=
  (sheafForget J).obj 𝒝.right

/-- The free commutative ring sheaf `\mathbf Z[E]` generated by a sheaf of sets `E`. -/
abbrev presentationFreeSheaf
    (E : Sheaf J (Type u)) :
    Sheaf J CommRingCat.{u} :=
  (Sheaf.composeAndSheafify J CommRingCat.free).obj E

/-- The free `\mathcal A`-algebra sheaf `\mathcal A[E]` on a sheaf of sets `E`, viewed as an
object of `Under 𝒜`. -/
abbrev presentationUnder
    (𝒜 : Sheaf J CommRingCat.{u})
    (E : Sheaf J (Type u)) :
    Under 𝒜 :=
  (Under.costar 𝒜).obj (presentationFreeSheaf (J := J) E)

/-- The structure morphism `\mathcal A \to \mathcal A[E]`. -/
abbrev presentationBaseOf
    (𝒜 : Sheaf J CommRingCat.{u})
    (E : Sheaf J (Type u)) :
    𝒜 ⟶ (presentationUnder (J := J) 𝒜 E).right :=
  (presentationUnder (J := J) 𝒜 E).hom

/-- The free-ring evaluation map `\mathbf Z[E] \to \mathcal B` induced by a map of sheaves of
sets `E \to \mathcal B`. -/
abbrev presentationFreeMap
    {𝒜 : Sheaf J CommRingCat.{u}}
    (𝒝 : Under 𝒜)
    (E : Sheaf J (Type u))
    (α : E ⟶ presentationVariables (J := J) 𝒝) :
    presentationFreeSheaf (J := J) E ⟶ 𝒝.right :=
  ((Sheaf.adjunction J CommRingCat.adj).homEquiv E 𝒝.right).symm α

/-- The induced `\mathcal A`-algebra map `\mathcal A[E] \to \mathcal B`. -/
abbrev presentationMapOf
    (𝒜 : Sheaf J CommRingCat.{u})
    (𝒝 : Under 𝒜)
    (E : Sheaf J (Type u))
    (α : E ⟶ presentationVariables (J := J) 𝒝) :
    (presentationUnder (J := J) 𝒜 E).right ⟶ 𝒝.right :=
  (((Under.costarAdjForget 𝒜).homEquiv
      (presentationFreeSheaf (J := J) E) 𝒝).symm
      (presentationFreeMap (J := J) 𝒝 E α)).right

/-- The canonical presentation sheaf `\mathcal A[\mathcal B]` of the `\mathcal A`-algebra sheaf
`\mathcal B`, obtained from the identity map of the underlying sheaf of sets of `\mathcal B`. -/
abbrev presentationSheaf
    (𝒜 : Sheaf J CommRingCat.{u})
    (𝒝 : Under 𝒜) :
    Sheaf J CommRingCat.{u} :=
  (presentationUnder (J := J) 𝒜 (presentationVariables (J := J) 𝒝)).right

variable (𝒜 : Sheaf J CommRingCat.{u}) (𝒝 : Under 𝒜)

/-- The structure morphism `\mathcal A \to \mathcal A[\mathcal B]`. -/
abbrev presentationBase :
    𝒜 ⟶ presentationSheaf 𝒜 𝒝 :=
  presentationBaseOf (J := J) 𝒜 (presentationVariables (J := J) 𝒝)

/-- The canonical presentation morphism `\mathcal A[\mathcal B] \to \mathcal B`. -/
abbrev presentationMap :
    presentationSheaf 𝒜 𝒝 ⟶ 𝒝.right :=
  presentationMapOf (J := J) 𝒜 𝒝 (presentationVariables (J := J) 𝒝) (𝟙 _)

/- Equation 18.35.0.2: the canonical morphism for the presentation
`\mathcal A[\mathcal B] \to \mathcal B` is the specialization of the site-level scalar-extended
conormal owner `conormalMap` to `presentationBase 𝒜 𝒝` and `presentationMap 𝒜 𝒝`. -/
#check
  (conormalMap (presentationBase 𝒜 𝒝) (presentationMap 𝒜 𝒝) :
    conormalSource (presentationMap 𝒜 𝒝) ⟶
      conormalTensorTerm (presentationBase 𝒜 𝒝) (presentationMap 𝒜 𝒝))

end SheafOfModules.RingedSite
