import Mathlib
import stacks_project.Chap10.Definition_10_137_10

-- Declarations for this item will be appended below by the statement pipeline.

open PrimeSpectrum
open Ideal.Quotient

universe u v w y

namespace Algebra

section

variable {R : Type u} {Λ : Type v} {Cbar : Type w}
variable [CommRing R] [CommRing Λ] [CommRing Cbar] [Algebra R Λ]
variable (π : R)

local notation "Ipi" => Ideal.span ({(π : R)} : Set R)
local notation "IpiSq" => Ideal.span ({π ^ 2} : Set R)
local notation "IpiBar" => Ideal.span ({Ideal.Quotient.mk IpiSq π} : Set (R ⧸ IpiSq))
local notation "CbarPi" =>
  Cbar ⧸ Ideal.map (algebraMap (R ⧸ IpiSq) Cbar) IpiBar

/-
Domain-style sampling pass for Lemma 16.6.1.

Primary domain: smoothness for finitely presented quotient algebras over `R ⧸ π²R`, together with
the canonical reduction maps modulo `π` and primewise smoothness over the induced map
`C̄ / π C̄ → D / π D`.

Sampled owner declarations:
* `SmoothAtPrime` from the project's source-facing smooth-locus API;
* `Algebra.IsSmoothAt` from mathlib's smooth-locus API;
* `Ideal.quotientMapₐ` for quotient maps induced by algebra maps;
* `Ideal.Quotient.liftₐ` for canonical descent along quotient ideals;
* `Ideal.Quotient.factorₐ` for quotient reduction maps;
* `Ideal.Quotient.algebraQuotientOfLEComap` for the canonical `(R ⧸ π²R)`-algebra structure on
  reductions modulo `π`.

Best owner abstraction: the theorem is source-facing existential data, but its bridge layer should
use the canonical quotient-map owners above rather than local copies. The mod-`π` smoothness
condition is naturally a statement about an explicit `AlgHom`
`C̄ / π C̄ → D / π D`, with `SmoothAtPrime` as the source-facing primewise owner and
`Algebra.IsSmoothAt` as its canonical local bridge.

Primitive-vs-derived split:
* primitive data: the quotient ideals `πR`, `π²R`, the given map
  `C̄ → Λ / π²Λ` and the comparison map `C̄ → D / πD`;
* derived API: the `(R ⧸ π²R)`-algebra structures on the quotient rings, the reduction
  compatibility maps to `Λ / πΛ`, the descended map `C̄ / π C̄ → D / πD` obtained from
  `Ideal.Quotient.liftₐ`, and the primewise smoothness predicates.

Source/core/bridge triage:
* `source-facing`: the existential lifting theorem below;
* `core/canonical`: `SmoothAtPrime`, `Algebra.IsSmoothAt`, `Ideal.quotientMapₐ`,
  `Ideal.Quotient.liftₐ`, `Ideal.Quotient.factorₐ`, and
  `Ideal.Quotient.algebraQuotientOfLEComap`;
* `bridge/view`: the explicit reduction maps modulo `π` and the canonical descended map
  `C̄ / π C̄ → D / πD`.
-/

/-- The principal ideal generated by `π²` is contained in the principal ideal generated by `π`. -/
private theorem piSq_le_pi : IpiSq ≤ Ipi := by
  rw [Ideal.span_singleton_le_iff_mem]
  simpa [pow_two] using
    Ideal.mul_mem_left (Ideal.span ({(π : R)} : Set R)) π (Ideal.mem_span_singleton_self π)

private theorem piSq_le_comap_map {A : Type y} [CommRing A] [Algebra R A] :
    IpiSq ≤ Ideal.comap (algebraMap R A) (Ideal.map (algebraMap R A) Ipi) :=
  (piSq_le_pi π).trans Ideal.le_comap_map

private theorem map_pi_le_comap_map_pi {D : Type y} [CommRing D] [Algebra R D]
    (lift : D →ₐ[R] Λ) :
    Ideal.map (algebraMap R D) Ipi ≤
      Ideal.comap (lift : D →+* Λ) (Ideal.map (algebraMap R Λ) Ipi) := by
  simpa [Ideal.map_map] using
    (show Ideal.map (algebraMap R D) Ipi ≤
        Ideal.comap (lift : D →+* Λ) (Ideal.map (lift : D →+* Λ) (Ideal.map (algebraMap R D) Ipi))
      from Ideal.le_comap_map)

local instance {A : Type y} [CommRing A] [Algebra R A] :
    IsLocalization.Away ((Algebra.ofId R A) π) (Localization.Away (algebraMap R A π)) := by
  simpa using
    (inferInstance : IsLocalization.Away (algebraMap R A π) (Localization.Away (algebraMap R A π)))

noncomputable local instance localizedAwayAlgebra {A : Type y} [CommRing A] [Algebra R A] :
    Algebra (Localization.Away π) (Localization.Away (algebraMap R A π)) :=
  (Localization.awayMapₐ (Algebra.ofId R A) π).toAlgebra

local instance {A : Type y} [CommRing A] [Algebra R A] :
    Algebra (R ⧸ IpiSq) (A ⧸ Ideal.map (algebraMap R A) Ipi) :=
  Ideal.Quotient.algebraQuotientOfLEComap (piSq_le_comap_map π)

private theorem map_CbarPi_ideal_le_ker {D : Type y} [CommRing D] [Algebra R D]
    [Algebra (R ⧸ IpiSq) Cbar] (fbar : Cbar →ₐ[R ⧸ IpiSq] D ⧸ Ideal.map (algebraMap R D) Ipi) :
    Ideal.map (algebraMap (R ⧸ IpiSq) Cbar) IpiBar ≤ RingHom.ker fbar.toRingHom := by
  rw [Ideal.map_le_iff_le_comap, Ideal.span_singleton_le_iff_mem]
  rw [Ideal.mem_comap, RingHom.mem_ker]
  rw [show
      fbar.toRingHom ((algebraMap (R ⧸ IpiSq) Cbar) (Ideal.Quotient.mk IpiSq π)) =
        algebraMap (R ⧸ IpiSq) (D ⧸ Ideal.map (algebraMap R D) Ipi)
          (Ideal.Quotient.mk IpiSq π) from
      fbar.commutes (Ideal.Quotient.mk IpiSq π)]
  change Ideal.Quotient.mk (Ideal.map (algebraMap R D) Ipi) (algebraMap R D π) = 0
  rw [eq_zero_iff_mem]
  exact Ideal.mem_map_of_mem (algebraMap R D) (Ideal.mem_span_singleton_self π)

-- Proof sketch: formalize the Stacks construction of `D` by adjoining variables that divide the
-- chosen generators of the presentation relations by `π`, use the annihilator equalities to define
-- the map `D → Λ`, and verify the two primewise smoothness statements by the Jacobian-minor
-- argument on the smooth locus of `R / π²R → C̄`.
/-- Lemma 16.6.1: let `R` be Noetherian, let `Λ` be an `R`-algebra, let `π ∈ R`, and assume
`Ann_R(π) = Ann_R(π²)` and `Ann_Λ(π) = Ann_Λ(π²)`. For a finitely presented
`(R / π²R)`-algebra `C̄` equipped with an `(R / π²R)`-algebra map `C̄ → Λ / π²Λ`, there exists a
finitely presented `R`-algebra `D` with a lift `D → Λ` and a comparison
`(R / π²R)`-algebra map `C̄ → D / π D` such that the induced reduction to `Λ / πΛ` is compatible,
the localized map `R_π → D_π` is smooth, every prime of `D / πD` lying over the smooth locus of
`R / π²R → C̄` is smooth over `R`, and the canonical reduction map `C̄ / π C̄ → D / π D`
induced by `fbar` is smooth at primes over that same locus. -/
theorem exists_finitePresentation_lift_with_smooth_mod_pi
    [IsNoetherianRing R]
    [Algebra (R ⧸ IpiSq) Cbar] [FinitePresentation (R ⧸ IpiSq) Cbar]
    (toLambda2 : Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) IpiSq)
    (hAnnR : (Ipi).annihilator = (IpiSq).annihilator)
    (hAnnΛ :
      (Ideal.span ({algebraMap R Λ π} : Set Λ)).annihilator =
        (Ideal.span ({algebraMap R Λ (π ^ 2)} : Set Λ)).annihilator) :
    ∃ (D : Type (max u v w)) (_ : CommRing D) (_ : Algebra R D) (_ : FinitePresentation R D)
      (lift : D →ₐ[R] Λ),
      let Dpi : Ideal D := Ideal.map (algebraMap R D) Ipi
      ∃ (fbar : Cbar →ₐ[R ⧸ IpiSq] D ⧸ Dpi),
        let smoothOverCbar : PrimeSpectrum (D ⧸ Dpi) → Prop := fun q ↦
          SmoothAtPrime (R ⧸ IpiSq) Cbar (PrimeSpectrum.comap fbar.toRingHom q)
        (Ideal.quotientMapₐ (Ideal.map (algebraMap R Λ) Ipi) lift
            (map_pi_le_comap_map_pi π lift)).toRingHom.comp fbar.toRingHom =
          (Ideal.Quotient.factorₐ R (Ideal.map_mono (piSq_le_pi π))).toRingHom.comp
            toLambda2.toRingHom ∧
        Smooth (Localization.Away π) (Localization.Away (algebraMap R D π)) ∧
        (∀ q : PrimeSpectrum (D ⧸ Dpi),
          smoothOverCbar q →
            SmoothAtPrime R D (PrimeSpectrum.comap (Ideal.Quotient.mk Dpi) q)) ∧
        (let fbarPi : CbarPi →ₐ[R ⧸ IpiSq] D ⧸ Dpi :=
            Ideal.Quotient.liftₐ
              (Ideal.map (algebraMap (R ⧸ IpiSq) Cbar) IpiBar) fbar
              (fun a ha ↦ RingHom.mem_ker.mp (map_CbarPi_ideal_le_ker π fbar ha))
         ∀ q : PrimeSpectrum (D ⧸ Dpi),
           smoothOverCbar q →
             let _ : Algebra CbarPi (D ⧸ Dpi) := fbarPi.toAlgebra
             SmoothAtPrime CbarPi (D ⧸ Dpi) q) := sorry

end

end Algebra
