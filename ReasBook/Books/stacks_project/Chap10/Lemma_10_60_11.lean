import Mathlib
import Mathlib.Tactic.Recall

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Ideal
open PrimeSpectrum

section

variable {R : Type u} [CommRing R] [IsNoetherianRing R]

/- Domain sampling:
* Primary domain: commutative algebra on `Spec R`, viewed as the specialization preorder on
  `PrimeSpectrum R`.
* Owner declarations inspected in this domain:
  - `Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes`
  - `Ideal.map_height_le_one_of_mem_minimalPrimes`
  - `PrimeSpectrum.exist_mem_one_of_mem_two`
  - `WCovBy` / `WCovBy.Ioo_eq`
* Best owner abstraction: clause `(2)` is intrinsically a weak-cover statement in the
  specialization order; the textbook negated-existence sentence is derived API.
* Primitive vs. derived: the primitive input is only membership in
  `(p.asIdeal ⊔ span {x}).minimalPrimes`; both `p ⩿ q` and “no prime strictly between” are
  consequences, not extra primitive data.
-/

/- Lemma 10.60.11 (1): the source statement is the specialization of Krull's principal ideal
theorem to the principal ideal `span {x}`. The canonical owner theorem is the more general
`Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes`. -/
recall Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes

-- Source/core/bridge triage:
-- * source-facing: the textbook sentence is that no prime lies strictly between `p` and `q`;
-- * core/canonical: this is the weak cover relation `p ⩿ q` in the specialization order;
-- * bridge/view: the source-facing negated-existence statement is a direct companion theorem below.
/-- Lemma 10.60.11 (2), core/canonical form: if `q` is minimal over the ideal generated by a prime
`p` together with `x`, then `q` weakly covers `p` in the specialization order on `Spec R`. -/
theorem wcovBy_of_mem_minimalPrimes_sup_span_singleton
    (p q : PrimeSpectrum R) (x : R)
    (hq : q.asIdeal ∈ (p.asIdeal ⊔ span {x}).minimalPrimes) :
    p ⩿ q := by
  refine wcovBy_of_eq_or_eq (le_sup_left.trans hq.1.2) fun r hpr hrq ↦ ?_
  by_cases hpr' : r = p
  · exact Or.inl hpr'
  by_cases hrq' : r = q
  · exact Or.inr hrq'
  have hpr_lt : p < r := lt_of_le_of_ne hpr fun h ↦ hpr' h.symm
  have hrq_lt : r < q := lt_of_le_of_ne hrq hrq'
  have hxq : x ∈ q.asIdeal := le_sup_right.trans hq.1.2 <| mem_span_singleton_self x
  obtain ⟨s, hxs, hps, hsq⟩ := exist_mem_one_of_mem_two hpr_lt hrq_lt hxq
  have hs_mem : p.asIdeal ⊔ span {x} ≤ s.asIdeal := by
    refine sup_le hps.le ?_
    exact (span_singleton_le_iff_mem s.asIdeal).2 hxs
  have hqs : q.asIdeal ≤ s.asIdeal := hq.2 ⟨s.isPrime, hs_mem⟩ hsq.le
  exact False.elim <| hsq.not_ge <| (asIdeal_le_asIdeal q s).1 hqs

/-- Lemma 10.60.11 (2), source-facing form: if `q` is minimal over the ideal generated by a prime
`p` together with `x`, then there is no point of `Spec R` strictly between `p` and `q` in the
specialization order. -/
theorem no_prime_strictly_between_of_mem_minimalPrimes_sup_span_singleton
    (p q : PrimeSpectrum R) (x : R)
    (hq : q.asIdeal ∈ (p.asIdeal ⊔ span {x}).minimalPrimes) :
    ¬ ∃ r : PrimeSpectrum R, p < r ∧ r < q := by
  rintro ⟨r, hpr, hrq⟩
  rcases (wcovBy_of_mem_minimalPrimes_sup_span_singleton p q x hq).eq_or_eq hpr.le hrq.le with
    rfl | rfl
  · exact hpr.ne rfl
  · exact hrq.ne rfl

end
