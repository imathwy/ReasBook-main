-- Proof sketch: combine the previous three statements. The counterexample ring supplies a
-- nonzerodivisor `x`, a quasi-regular singleton sequence given by the image of `y` modulo `(x)`,
-- and nevertheless a non-quasi-regular pair `(x, y)` in the original ring, so the direct
-- quasi-regular analogue of Lemma `10.68.7` fails.
/-- Remark 10.69.8: in the counterexample ring, having `x` as a nonzerodivisor and having the
image of `y` in `A/(x)` quasi-regular does not force the pair `(x, y)` to be quasi-regular. -/
theorem quasiRegularCounterexample_shows_quasiRegular_append_criterion_fails :
    ¬ (quasiRegularCounterexampleX k ∈ nonZeroDivisors (quasiRegularCounterexampleRing k) →
        IsQuasiRegularSequence [quasiRegularCounterexampleYModX k] →
        IsQuasiRegularSequence [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) := by
  intro happend
  -- Combine the three counterexample ingredients.
  have hpair :
      IsQuasiRegularSequence
        [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] :=
    happend
      (quasiRegularCounterexample_x_mem_nonZeroDivisors k)
      (quasiRegularCounterexample_y_mod_x_isQuasiRegular k)
  exact quasiRegularCounterexample_pair_not_isQuasiRegular k hpair

