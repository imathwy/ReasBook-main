open MvPolynomial
open RingTheory.Sequence
open scoped nonZeroDivisors

universe u

namespace RingTheory.Sequence

variable {R : Type*} [CommRing R]
variable {M : Type*} [AddCommGroup M] [Module R M]

/-- Helper for Remark 10.69.8: a sequence is quasi-regular when the canonical associated-graded
map is bijective. -/
def IsQuasiRegular (M : Type*) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  Function.Bijective (quasiRegularSequenceAssociatedGradedMap M rs)

/-- Helper for Remark 10.69.8: a ring sequence is quasi-regular when it is quasi-regular on the
regular module. -/
abbrev IsQuasiRegularSequence (rs : List R) : Prop :=
  IsQuasiRegular R rs

end RingTheory.Sequence

/-
Domain triage:
* primary domain: quasi-regular sequences in commutative algebra, expressed through an explicit
  quotient-ring counterexample;
* sampled owner API:
  `RingTheory.Sequence.IsQuasiRegular`,
  `RingTheory.Sequence.IsQuasiRegularSequence`,
  `nonZeroDivisors`,
  `Ideal.Quotient.mk`;
* core/canonical owner abstractions: the quotient-ring construction `R ⧸ I` for the counterexample
  ring and the sequence predicate `IsQuasiRegularSequence`;
* primitive vs derived split: the ambient polynomial ring, the defining relations, and the ideal
  they generate are primitive data, while the classes of `x` and `y` and the quotient-by-`(x)`
  viewpoint are derived source-facing API.
-/

/-- Variables for the quasi-regular counterexample ring. -/
inductive QuasiRegularCounterexampleVar
  | x | y | w | z (n : ℕ)
  deriving DecidableEq

open QuasiRegularCounterexampleVar

noncomputable section

variable (k : Type u) [CommRing k]

/-- The ambient polynomial ring for the quasi-regular counterexample. -/
abbrev quasiRegularCounterexamplePolynomialRing :=
  MvPolynomial QuasiRegularCounterexampleVar k

/-- The exceptional relation `y^2 z_0 - wx`. -/
def quasiRegularCounterexampleInitialRelation : quasiRegularCounterexamplePolynomialRing k :=
  X y ^ 2 * X (z 0) - X w * X x

/-- The recursive relation `z_n - y z_{n+1}`. -/
def quasiRegularCounterexampleRecurrenceRelation (n : ℕ) :
    quasiRegularCounterexamplePolynomialRing k :=
  X (z n) - X y * X (z (n + 1))

/-- The family of defining relations for the counterexample ring. -/
def quasiRegularCounterexampleRelations : Set (quasiRegularCounterexamplePolynomialRing k) :=
  {quasiRegularCounterexampleInitialRelation k} ∪
    Set.range (quasiRegularCounterexampleRecurrenceRelation k)

/-- The defining ideal generated by `y^2 z_0 - wx` and the relations `z_n - y z_{n+1}`. -/
def quasiRegularCounterexampleIdeal : Ideal (quasiRegularCounterexamplePolynomialRing k) :=
  Ideal.span (quasiRegularCounterexampleRelations k)

/-- The quotient ring used for the quasi-regular counterexample. -/
abbrev quasiRegularCounterexampleRing :=
  quasiRegularCounterexamplePolynomialRing k ⧸ quasiRegularCounterexampleIdeal k

/-- The image of the variable `x` in the counterexample ring. -/
abbrev quasiRegularCounterexampleX : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X x : quasiRegularCounterexamplePolynomialRing k)

/-- The image of the variable `y` in the counterexample ring. -/
abbrev quasiRegularCounterexampleY : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X y : quasiRegularCounterexamplePolynomialRing k)

/-- The image of the variable `w` in the counterexample ring. -/
abbrev quasiRegularCounterexampleW : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X w : quasiRegularCounterexamplePolynomialRing k)

/-- The image of the variable `z_n` in the counterexample ring. -/
abbrev quasiRegularCounterexampleZ (n : ℕ) : quasiRegularCounterexampleRing k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
    (X (z n) : quasiRegularCounterexamplePolynomialRing k)

/-- The principal ideal `(x)` in the counterexample ring. -/
def quasiRegularCounterexampleXIdeal : Ideal (quasiRegularCounterexampleRing k) :=
  Ideal.span ({quasiRegularCounterexampleX k} : Set (quasiRegularCounterexampleRing k))

/-- The image of `y` in the quotient of the counterexample ring by `(x)`. -/
abbrev quasiRegularCounterexampleYModX :
    quasiRegularCounterexampleRing k ⧸ quasiRegularCounterexampleXIdeal k :=
  Ideal.Quotient.mk (quasiRegularCounterexampleXIdeal k) (quasiRegularCounterexampleY k)

/-- Helper for Remark 10.69.8: the initial defining relation belongs to the counterexample ideal.
-/
theorem quasiRegularCounterexampleInitialRelation_mem_ideal :
    quasiRegularCounterexampleInitialRelation k ∈ quasiRegularCounterexampleIdeal k := by
  -- The initial relation is one of the specified generators of the defining ideal.
  exact Ideal.subset_span (Or.inl rfl)

/-- Helper for Remark 10.69.8: each recurrence relation belongs to the counterexample ideal. -/
theorem quasiRegularCounterexampleRecurrenceRelation_mem_ideal (n : ℕ) :
    quasiRegularCounterexampleRecurrenceRelation k n ∈ quasiRegularCounterexampleIdeal k := by
  -- Every recurrence relation appears in the generating family by construction.
  exact Ideal.subset_span (Or.inr ⟨n, rfl⟩)

/-- Helper for Remark 10.69.8: in the quotient ring, the initial relation becomes
`y^2 z_0 = w x`. -/
theorem quasiRegularCounterexample_initial_relation :
    quasiRegularCounterexampleY k ^ 2 * quasiRegularCounterexampleZ k 0 =
      quasiRegularCounterexampleW k * quasiRegularCounterexampleX k := by
  -- The initial generator vanishes after passing to the quotient by the defining ideal.
  have hzero :
      Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
        (quasiRegularCounterexampleInitialRelation k) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (quasiRegularCounterexampleInitialRelation_mem_ideal k)
  exact sub_eq_zero.mp <| by
    simpa [quasiRegularCounterexampleInitialRelation, quasiRegularCounterexampleY,
      quasiRegularCounterexampleZ, quasiRegularCounterexampleW, quasiRegularCounterexampleX] using
      hzero

/-- Helper for Remark 10.69.8: in the quotient ring, the recurrence relation becomes
`z_n = y z_{n+1}`. -/
theorem quasiRegularCounterexample_recurrence_relation (n : ℕ) :
    quasiRegularCounterexampleZ k n =
      quasiRegularCounterexampleY k * quasiRegularCounterexampleZ k (n + 1) := by
  -- Each recurrence generator also vanishes in the quotient ring.
  have hzero :
      Ideal.Quotient.mk (quasiRegularCounterexampleIdeal k)
        (quasiRegularCounterexampleRecurrenceRelation k n) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr
      (quasiRegularCounterexampleRecurrenceRelation_mem_ideal k n)
  exact sub_eq_zero.mp <| by
    simpa [quasiRegularCounterexampleRecurrenceRelation, quasiRegularCounterexampleZ,
      quasiRegularCounterexampleY] using hzero

/-- Helper for Remark 10.69.8: every `z_n` already lies in the ideal generated by `y`. -/
theorem quasiRegularCounterexample_z_mem_span_y (n : ℕ) :
    quasiRegularCounterexampleZ k n ∈
      Ideal.span ({quasiRegularCounterexampleY k} : Set (quasiRegularCounterexampleRing k)) := by
  -- Rewrite `z_n` using the recurrence and then use closure of the principal ideal under
  -- multiplication.
  rw [quasiRegularCounterexample_recurrence_relation k n]
  exact Ideal.mul_mem_right
    (quasiRegularCounterexampleZ k (n + 1))
    (Ideal.span ({quasiRegularCounterexampleY k} :
      Set (quasiRegularCounterexampleRing k)))
    (Ideal.subset_span (by simp))

/-- Helper for Remark 10.69.8: evaluation sending `w` to the polynomial variable and all other
counterexample generators to `0`. -/
def quasiRegularCounterexampleVarToPolynomial :
    QuasiRegularCounterexampleVar → Polynomial k
  | x => 0
  | y => 0
  | w => Polynomial.X
  | z _ => 0

/-- Helper for Remark 10.69.8: the polynomial evaluation used to detect the class of `w` modulo
`(x, y)`. -/
def quasiRegularCounterexamplePolynomialToW :
    quasiRegularCounterexamplePolynomialRing k →+* Polynomial k :=
  MvPolynomial.eval₂Hom Polynomial.C (quasiRegularCounterexampleVarToPolynomial k)

/-- Helper for Remark 10.69.8: the initial relation maps to zero under the `w`-detector
evaluation. -/
theorem quasiRegularCounterexamplePolynomialToW_initial_relation :
    quasiRegularCounterexamplePolynomialToW k
      (quasiRegularCounterexampleInitialRelation k) = 0 := by
  -- Every variable except `w` is killed by the evaluation, so both terms vanish.
  simp [quasiRegularCounterexamplePolynomialToW, quasiRegularCounterexampleVarToPolynomial,
    quasiRegularCounterexampleInitialRelation]

/-- Helper for Remark 10.69.8: every recurrence relation maps to zero under the `w`-detector
evaluation. -/
theorem quasiRegularCounterexamplePolynomialToW_recurrence_relation (n : ℕ) :
    quasiRegularCounterexamplePolynomialToW k
      (quasiRegularCounterexampleRecurrenceRelation k n) = 0 := by
  -- The recurrence only involves variables sent to zero by the evaluation.
  simp [quasiRegularCounterexamplePolynomialToW, quasiRegularCounterexampleVarToPolynomial,
    quasiRegularCounterexampleRecurrenceRelation]

/-- Helper for Remark 10.69.8: the defining ideal lies in the kernel of the `w`-detector
evaluation. -/
theorem quasiRegularCounterexampleIdeal_le_ker_polynomialToW :
    quasiRegularCounterexampleIdeal k ≤
      RingHom.ker (quasiRegularCounterexamplePolynomialToW k) := by
  -- Check the generators one by one and then use the universal property of the span.
  rw [quasiRegularCounterexampleIdeal, Ideal.span_le]
  intro f hf
  rcases hf with rfl | ⟨n, rfl⟩
  · simpa [RingHom.mem_ker] using
      quasiRegularCounterexamplePolynomialToW_initial_relation k
  · simpa [RingHom.mem_ker] using
      quasiRegularCounterexamplePolynomialToW_recurrence_relation k n

/-- Helper for Remark 10.69.8: the induced quotient map detecting the `w`-class in the residue
ring modulo `(x, y)`. -/
def quasiRegularCounterexampleResidueWMap :
    quasiRegularCounterexampleRing k →+* Polynomial k :=
  Ideal.Quotient.lift
    (quasiRegularCounterexampleIdeal k)
    (quasiRegularCounterexamplePolynomialToW k)
    (quasiRegularCounterexampleIdeal_le_ker_polynomialToW k)

/-- Helper for Remark 10.69.8: the residue `w`-detector kills the class of `x`. -/
theorem quasiRegularCounterexampleResidueWMap_x :
    quasiRegularCounterexampleResidueWMap k (quasiRegularCounterexampleX k) = 0 := by
  -- The defining evaluation sends `x` to zero already in the polynomial ring.
  simp [quasiRegularCounterexampleResidueWMap, quasiRegularCounterexamplePolynomialToW,
    quasiRegularCounterexampleVarToPolynomial, quasiRegularCounterexampleX]

/-- Helper for Remark 10.69.8: the residue `w`-detector kills the class of `y`. -/
theorem quasiRegularCounterexampleResidueWMap_y :
    quasiRegularCounterexampleResidueWMap k (quasiRegularCounterexampleY k) = 0 := by
  -- The defining evaluation sends `y` to zero already in the polynomial ring.
  simp [quasiRegularCounterexampleResidueWMap, quasiRegularCounterexamplePolynomialToW,
    quasiRegularCounterexampleVarToPolynomial, quasiRegularCounterexampleY]

/-- Helper for Remark 10.69.8: the residue `w`-detector sends the class of `w` to the polynomial
variable `X`. -/
theorem quasiRegularCounterexampleResidueWMap_w :
    quasiRegularCounterexampleResidueWMap k (quasiRegularCounterexampleW k) = Polynomial.X := by
  -- By construction, `w` is the unique variable seen by this evaluation.
  simp [quasiRegularCounterexampleResidueWMap, quasiRegularCounterexamplePolynomialToW,
    quasiRegularCounterexampleVarToPolynomial, quasiRegularCounterexampleW]

/-- Helper for Remark 10.69.8: the residue `w`-detector kills every `z_n`. -/
theorem quasiRegularCounterexampleResidueWMap_z (n : ℕ) :
    quasiRegularCounterexampleResidueWMap k (quasiRegularCounterexampleZ k n) = 0 := by
  -- All `z_n` are sent to zero by the defining evaluation.
  simp [quasiRegularCounterexampleResidueWMap, quasiRegularCounterexamplePolynomialToW,
    quasiRegularCounterexampleVarToPolynomial, quasiRegularCounterexampleZ]

section

variable [Field k]

/-- Helper for Remark 10.69.8: the class of `w` does not belong to the ideal generated by `x`
and `y`. -/
theorem quasiRegularCounterexampleW_not_mem_pairIdeal :
    quasiRegularCounterexampleW k ∉
      Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] := by
  -- The generators `x` and `y` are killed by the residue detector, so the whole pair ideal lies
  -- in its kernel.
  intro hw
  have hpair_le_ker :
      Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] ≤
        RingHom.ker (quasiRegularCounterexampleResidueWMap k) := by
    rw [Ideal.ofList_cons, Ideal.ofList_singleton]
    refine sup_le ?_ ?_
    · refine Ideal.span_le.mpr ?_
      intro r hr
      simp only [Set.mem_singleton_iff] at hr
      simp [RingHom.mem_ker, hr, quasiRegularCounterexampleResidueWMap_x]
    · refine Ideal.span_le.mpr ?_
      intro r hr
      simp only [Set.mem_singleton_iff] at hr
      simp [RingHom.mem_ker, hr, quasiRegularCounterexampleResidueWMap_y]
  have hwker :
      quasiRegularCounterexampleW k ∈ RingHom.ker (quasiRegularCounterexampleResidueWMap k) :=
    hpair_le_ker hw
  have hXzero : (Polynomial.X : Polynomial k) = 0 := by
    simpa [RingHom.mem_ker, quasiRegularCounterexampleResidueWMap_w] using hwker
  exact Polynomial.X_ne_zero hXzero

/-- Helper for Remark 10.69.8: the class of `w` stays nonzero after quotienting by `(x, y)`. -/
theorem quasiRegularCounterexampleW_mod_pair_ne_zero :
    Ideal.Quotient.mk
      (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])
      (quasiRegularCounterexampleW k) ≠ 0 := by
  -- The residue class vanishes exactly when `w` already belongs to the pair ideal.
  intro hw
  exact quasiRegularCounterexampleW_not_mem_pairIdeal k
    (Ideal.Quotient.eq_zero_iff_mem.mp hw)

/-- Helper for Remark 10.69.8: the relation `w x = y^2 z_0` places `w x` in the square of the
ideal `(x, y)`. -/
theorem quasiRegularCounterexample_w_mul_x_mem_pairSquare :
    quasiRegularCounterexampleW k * quasiRegularCounterexampleX k ∈
      (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) ^ 2 := by
  -- Rewrite `w * x` using the defining relation, then place one factor `y` in each copy of the
  -- pair ideal.
  rw [← quasiRegularCounterexample_initial_relation k]
  have hy :
      quasiRegularCounterexampleY k ∈
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] := by
    exact Ideal.subset_span (by simp [Ideal.ofList])
  have hyz :
      quasiRegularCounterexampleY k * quasiRegularCounterexampleZ k 0 ∈
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] := by
    simpa [mul_comm] using
      Ideal.mul_mem_right (quasiRegularCounterexampleZ k 0)
        (Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k]) hy
  -- Route correction: keep the source proof's conormal obstruction by proving the concrete square
  -- containment `y^2 z_0 ∈ (x, y)^2` directly, instead of trying to bypass the pair ideal.
  simpa [pow_two, mul_assoc] using
    (Ideal.mul_mem_mul hy hyz :
      quasiRegularCounterexampleY k *
          (quasiRegularCounterexampleY k * quasiRegularCounterexampleZ k 0) ∈
        Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k] *
          Ideal.ofList [quasiRegularCounterexampleX k, quasiRegularCounterexampleY k])

/-- Helper for Remark 10.69.8: in a polynomial equation
`g * X = (C a * X - C c) * h` with `c ≠ 0` over a domain, the right factor is already divisible by
`X`. -/
theorem counterexample_truncated_hypersurface_X_dvd_of_relation
    {S : Type*} [CommRing S] [IsDomain S] {a c : S} {g h : Polynomial S}
    (hc : c ≠ 0)
    (hrel : g * Polynomial.X = (Polynomial.C a * Polynomial.X - Polynomial.C c) * h) :
    Polynomial.X ∣ h := by
  -- Compare constant coefficients. The left-hand side has constant coefficient zero, while the
  -- right-hand side contributes `-(c * h.coeff 0)`.
  have hcoeff := congrArg (fun p : Polynomial S ↦ p.coeff 0) hrel
  have hmul_zero : c * h.coeff 0 = 0 := by
    apply neg_eq_zero.mp
    simpa [sub_mul, Polynomial.coeff_C_mul, Polynomial.coeff_mul_X_zero] using hcoeff.symm
  have hcoeff_zero : h.coeff 0 = 0 := by
    rcases mul_eq_zero.mp hmul_zero with hzero | hzero
    · exact (hc hzero).elim
    · exact hzero
  exact Polynomial.X_dvd_iff.mpr hcoeff_zero

