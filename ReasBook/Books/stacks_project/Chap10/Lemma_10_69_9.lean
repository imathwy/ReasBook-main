/-- Helper for Lemma 10.69.9: after identifying the source and target graded pieces through the
quotients by `⋂ n, J ^ n`, the canonical associated-graded map is conjugated by those
equivalences. -/
private theorem quasiRegularSequenceAssociatedGradedMap_iInf_pow_naturality
    (rs : List R) :
    iInf_pow_idealAssociatedGradedModule_equiv (R := R) (M := M) rs ∘
        quasiRegularSequenceAssociatedGradedMap M rs =
      quasiRegularSequenceAssociatedGradedMap
          (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) ∘
        iInf_pow_quasiRegularSource_equiv (R := R) (M := M) rs := by
