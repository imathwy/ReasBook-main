  -- `Submodule.Quotient.mk m ⊗ₜ MvPolynomial.monomial d 1`, rewrite with the source
  -- representative formula and `iInf_pow_idealAssociatedGradedPiece_equiv_apply_mk`, and then
  -- extend by quotient and polynomial induction.
