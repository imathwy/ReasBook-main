import Mathlib
import stacks_project.Chap10.«10_69_0_1»

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

open RingTheory
open Ideal
open scoped TensorProduct

namespace RingTheory.Sequence

attribute [local instance] RingHomInvPair.of_ringEquiv RingHomInvPair.of_ringEquiv_symm

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- Helper for Lemma 10.69.9: locally recover the quasi-regularity predicate from the stable
backup associated-graded model. -/
def IsQuasiRegular (M : Type v) [AddCommGroup M] [Module R M] (rs : List R) : Prop :=
  Function.Bijective (quasiRegularSequenceAssociatedGradedMap M rs)

/-- Helper for Lemma 10.69.9: the quotient module by `⋂ n, J^n M` carries the canonical action of
the quotient ring by `⋂ n, J^n`. -/
private instance (J : Ideal R) :
    Module (R ⧸ (⨅ n : ℕ, (J ^ n : Ideal R)))
      (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M))) := by
  let K : Ideal R := ⨅ n : ℕ, J ^ n
  have hK :
      Module.IsTorsionBySet R
        (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M)))
        (K : Set R) := by
    rw [Module.isTorsionBySet_quotient_iff]
    intro x r hr
    change r ∈ (⨅ n : ℕ, (J ^ n : Ideal R)) at hr
    rw [Submodule.mem_iInf]
    intro n
    exact Submodule.smul_mem_smul ((iInf_le (fun n : ℕ ↦ J ^ n) n) hr) (by simp)
  change Module (R ⧸ K) (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M)))
  exact Module.IsTorsionBySet.module hK

/-- Helper for Lemma 10.69.9: the quotient module by `⋂ n, J^n M` also forms a scalar tower over
`R → R / ⋂ n, J^n`. -/
private instance (J : Ideal R) :
    IsScalarTower R (R ⧸ (⨅ n : ℕ, (J ^ n : Ideal R)))
      (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M))) := by
  let K : Ideal R := ⨅ n : ℕ, J ^ n
  have hK :
      Module.IsTorsionBySet R
        (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M)))
        (K : Set R) := by
    rw [Module.isTorsionBySet_quotient_iff]
    intro x r hr
    change r ∈ (⨅ n : ℕ, (J ^ n : Ideal R)) at hr
    rw [Submodule.mem_iInf]
    intro n
    exact Submodule.smul_mem_smul ((iInf_le (fun n : ℕ ↦ J ^ n) n) hr) (by simp)
  change IsScalarTower R (R ⧸ K) (M ⧸ (⨅ n : ℕ, J ^ n • (⊤ : Submodule R M)))
  exact Module.IsTorsionBySet.isScalarTower hK

/-- Helper for Lemma 10.69.9: injectivity is preserved across a commuting square whose horizontal
maps are equivalences. -/
private theorem injective_iff_of_equiv_conjugate
    {α : Type*} {β : Type*} {γ : Type*} {δ : Type*}
    (eSrc : α ≃ β) (eTgt : γ ≃ δ)
    (f : α → γ) (g : β → δ)
    (hcomm : eTgt ∘ f = g ∘ eSrc) :
    Function.Injective f ↔ Function.Injective g := by
  -- Transfer injectivity across the conjugation square by moving equalities through the two
  -- equivalences.
  constructor
  · intro hf x y hxy
    apply eSrc.symm.injective
    apply hf
    apply eTgt.injective
    calc
      eTgt (f (eSrc.symm x)) = g x := by
        simpa [Function.comp] using congrFun hcomm (eSrc.symm x)
      _ = g y := hxy
      _ = eTgt (f (eSrc.symm y)) := by
        simpa [Function.comp] using (congrFun hcomm (eSrc.symm y)).symm
  · intro hg x y hxy
    apply eSrc.injective
    apply hg
    calc
      g (eSrc x) = eTgt (f x) := by
        simpa [Function.comp] using (congrFun hcomm x).symm
      _ = eTgt (f y) := by
        rw [hxy]
      _ = g (eSrc y) := by
        simpa [Function.comp] using congrFun hcomm y

/-- Helper for Lemma 10.69.9: the associated-graded comparison map is always surjective, so
quasi-regularity is equivalent to injectivity. -/
private theorem isQuasiRegular_iff_injective (rs : List R) :
    IsQuasiRegular M rs ↔ Function.Injective (quasiRegularSequenceAssociatedGradedMap M rs) := by
  -- The defining map is always surjective in the backup associated-graded model, so bijectivity
  -- reduces to injectivity.
  constructor
  · exact Function.Bijective.injective
  · intro h
    exact ⟨h, sorry⟩ -- quasiRegularSequenceAssociatedGradedMap_surjective not yet available

/-- Helper for Lemma 10.69.9: the ideal generated by the images of `rs` in `R / ⋂ J^n` is the map
of `Ideal.ofList rs`. -/
private theorem iInf_pow_map_ofList
    (rs : List R) :
    Ideal.map
        (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R)))
        (Ideal.ofList rs) =
      Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R)))) := by
  -- The quotient-side list ideal is exactly the image ideal under the canonical quotient map.
  simpa using
    (Ideal.map_ofList
      (f := Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R))) rs)

/-- Helper for Lemma 10.69.9: `⋂ n, J^n` is contained in `J`. -/
private theorem iInf_pow_le_ofList (rs : List R) :
    (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R)) ≤ Ideal.ofList rs := by
  -- The intersection is contained in its first nontrivial stage `J = J^1`.
  simpa using (iInf_le (fun n : ℕ ↦ ((Ideal.ofList rs) ^ n : Ideal R)) 1)

/-- Helper for Lemma 10.69.9: the quotient-side ideal generated by the images of `rs` is the map
of `Ideal.ofList rs`. -/
private theorem iInf_pow_ofList_map_eq (rs : List R) :
    Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R)))) =
      (Ideal.ofList rs).map
        (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R))) := by
  -- This is exactly the earlier list-ideal map identity, rewritten in the quotient-first order.
  simpa using (iInf_pow_map_ofList (R := R) rs).symm

/-- Helper for Lemma 10.69.9: quotienting first by `⋂ n, J^n` and then by the image of `J`
is canonically the same ring as quotienting directly by `J`. -/
private noncomputable def iInf_pow_ofList_quotient_ringEquiv
    (rs : List R) :
    ((R ⧸ (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R))) ⧸
      Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ n : ℕ, ((Ideal.ofList rs) ^ n : Ideal R))))) ≃+*
      R ⧸ Ideal.ofList rs :=
  -- Combine the image-ideal identification with the usual quotient-of-quotient equivalence.
  (Ideal.quotEquivOfEq (iInf_pow_ofList_map_eq (R := R) rs)).trans
    (DoubleQuot.quotQuotEquivQuotOfLE (iInf_pow_le_ofList (R := R) rs))

/-- Helper for Lemma 10.69.9: each quotient-side stage `J̄^n M̄` is exactly the image of
`J^n M` under the quotient map `M → M / ⋂ J^n M`. -/
private theorem iInf_pow_ofList_pow_smul_top_mem_iff
    (rs : List R) (n : ℕ)
    {y : M ⧸ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M))} :
    y ∈
        idealAssociatedGradedStage
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk (⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)))))
          (M ⧸ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M))) n ↔
      y ∈
        (idealAssociatedGradedStage (Ideal.ofList rs) M n).map
          (Submodule.mkQ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M))) := by
  let K : Ideal R := ⨅ k : ℕ, ((Ideal.ofList rs) ^ k : Ideal R)
  let KM : Submodule R M := ⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)
  have hmapPow :
      Ideal.map (Ideal.Quotient.mk K) ((Ideal.ofList rs) ^ n) =
        (Ideal.ofList (rs.map (Ideal.Quotient.mk K))) ^ n := by
    -- The image of `J^n` in `R / ⋂ J^m` is exactly `J̄^n`.
    simpa [Ideal.map_pow] using
      congrArg (fun I : Ideal (R ⧸ K) ↦ I ^ n) (iInf_pow_map_ofList (R := R) rs)
  have hstage :
      (idealAssociatedGradedStage
          (Ideal.ofList (rs.map (Ideal.Quotient.mk K)))
          (M ⧸ KM) n).restrictScalars R =
        (idealAssociatedGradedStage (Ideal.ofList rs) M n).map (Submodule.mkQ KM) := by
    -- Rewrite the quotient-side stage as the image ideal action, then identify it with the image
    -- of `J^n M` under the quotient map.
    calc
      (idealAssociatedGradedStage
          (Ideal.ofList (rs.map (Ideal.Quotient.mk K)))
          (M ⧸ KM) n).restrictScalars R
          = ((Ideal.map (Ideal.Quotient.mk K) ((Ideal.ofList rs) ^ n)) •
              (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R := by
              rw [idealAssociatedGradedStage, ← hmapPow]
      _ = ((Ideal.map (algebraMap R (R ⧸ K)) ((Ideal.ofList rs) ^ n)) •
              (⊤ : Submodule (R ⧸ K) (M ⧸ KM))).restrictScalars R := by
            rw [← Ideal.Quotient.algebraMap_eq]
      _ = ((Ideal.ofList rs) ^ n) • (⊤ : Submodule R (M ⧸ KM)) := by
            simpa using
              (Ideal.smul_restrictScalars
                (R := R) (S := R ⧸ K) (M := M ⧸ KM)
                ((Ideal.ofList rs) ^ n) (⊤ : Submodule (R ⧸ K) (M ⧸ KM)))
      _ = (idealAssociatedGradedStage (Ideal.ofList rs) M n).map (Submodule.mkQ KM) := by
            symm
            simp [idealAssociatedGradedStage, KM, Submodule.map_smul'', Submodule.range_mkQ]
  -- Membership is unchanged after restricting scalars from `R / ⋂ J^n` back to `R`.
  change y ∈
      (idealAssociatedGradedStage
        (Ideal.ofList (rs.map (Ideal.Quotient.mk K)))
        (M ⧸ KM) n).restrictScalars R ↔
    y ∈
      (idealAssociatedGradedStage (Ideal.ofList rs) M n).map
        (Submodule.mkQ (⨅ k : ℕ, (Ideal.ofList rs) ^ k • (⊤ : Submodule R M)))
  rw [hstage]

/-- Helper for Lemma 10.69.9: an element of `J ^ n M` maps to the `n`-th stage after quotienting
by `⋂ m, J ^ m M`. -/
private theorem iInf_pow_idealAssociatedGradedStageToQuotient_mem
    (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    Submodule.Quotient.mk
        ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
      idealAssociatedGradedStage
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) n := by
  -- Rewrite the quotient-side stage as the image of `J ^ n M` under the quotient map.
  rw [iInf_pow_ofList_pow_smul_top_mem_iff (R := R) (M := M) (rs := rs) n]
  exact Submodule.mem_map_of_mem x.2

/-- Helper for Lemma 10.69.9: every quotient-side stage element is represented by some element of
the original stage `J ^ n M`. -/
private theorem iInf_pow_idealAssociatedGradedStageToQuotient_exists
    (rs : List R) (n : ℕ)
    (y : idealAssociatedGradedStage
      (Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
      (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) n) :
    ∃ x : idealAssociatedGradedStage (Ideal.ofList rs) M n,
      Submodule.Quotient.mk (x : M) = (y : M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) := by
  rcases y with ⟨y, hy⟩
  -- Use the explicit image description of the quotient-side stage to lift the representative.
  rw [iInf_pow_ofList_pow_smul_top_mem_iff (R := R) (M := M) (rs := rs) n] at hy
  rcases Submodule.mem_map.1 hy with ⟨x, hx, rfl⟩
  exact ⟨⟨x, hx⟩, rfl⟩

/-- Helper for Lemma 10.69.9: if a class from `J^n M` lands in the next quotient-side stage, then
its representative already lies in `J^(n + 1) M`. -/
private theorem iInf_pow_stage_mem_succ_of_quotient_mem_succ
    (rs : List R) (n : ℕ)
    {x : idealAssociatedGradedStage (Ideal.ofList rs) M n}
    (hx :
      Submodule.Quotient.mk
          ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
        idealAssociatedGradedStage
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
          (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) (n + 1)) :
    ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M) ∈
      idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1) := by
  let KM : Submodule R M := ⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)
  let y :
      idealAssociatedGradedStage
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (M ⧸ KM) (n + 1) :=
    ⟨Submodule.Quotient.mk (x : M), hx⟩
  rcases iInf_pow_idealAssociatedGradedStageToQuotient_exists
      (R := R) (M := M) (rs := rs) (n := n + 1) y with
    ⟨z, hz⟩
  have hz' :
      (Submodule.Quotient.mk (p := KM) (x : M) : M ⧸ KM) =
        Submodule.Quotient.mk (p := KM) (z : M) := by
    -- Reorient the lifted representative equality so it matches `Submodule.Quotient.eq`.
    simpa [y] using hz.symm
  have hdiff : (x : M) - z ∈ KM := by
    -- Equal quotient classes differ by an element of the `⋂ J^m M` kernel.
    exact (Submodule.Quotient.eq KM).1 hz'
  have hdiff' :
      (x : M) - z ∈ idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1) := by
    -- The kernel is contained in every stage, in particular in stage `n + 1`.
    exact (iInf_le (fun m : ℕ ↦ (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)) (n + 1)) hdiff
  -- Add the correction term back to the lifted stage representative.
  simpa [sub_eq_add_neg, add_assoc] using
    (idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1)).add_mem hdiff' z.2

/-- Helper for Lemma 10.69.9: the source and quotient-side degree-`n` graded pieces are identified
by sending the class of `x ∈ J ^ n M` to the class of its image in `M / ⋂ m, J ^ m M`. -/
private noncomputable def iInf_pow_idealAssociatedGradedPiece_equiv
    (rs : List R) (n : ℕ) :
    idealAssociatedGradedPiece (Ideal.ofList rs) M n ≃+
      idealAssociatedGradedPiece
        (R := R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) n := by
  let K : Ideal R := ⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)
  let KM : Submodule R M := ⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
  let stageMap :
      idealAssociatedGradedStage (Ideal.ofList rs) M n →ₛₗ[Ideal.Quotient.mk K]
        idealAssociatedGradedStage Jbar (M ⧸ KM) n :=
    { toFun := fun x ↦
        ⟨Submodule.Quotient.mk ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M),
          iInf_pow_idealAssociatedGradedStageToQuotient_mem (R := R) (M := M) (rs := rs) n x⟩
      map_add' := by
        intro x y
        rfl
      map_smul' := by
        intro r x
        rfl }
  have hstageMap :
      ((idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1)).submoduleOf
        (idealAssociatedGradedStage (Ideal.ofList rs) M n)) ≤
        Submodule.comap stageMap
          ((idealAssociatedGradedStage Jbar (M ⧸ KM) (n + 1)).submoduleOf
            (idealAssociatedGradedStage Jbar (M ⧸ KM) n)) := by
    intro x hx
    -- The quotient map carries `J ^ (n + 1) M` into the next quotient-side stage.
    rw [Submodule.mem_comap]
    change
      stageMap x ∈
        ((idealAssociatedGradedStage Jbar (M ⧸ KM) (n + 1)).submoduleOf
          (idealAssociatedGradedStage Jbar (M ⧸ KM) n))
    simpa [stageMap] using
      iInf_pow_idealAssociatedGradedStageToQuotient_mem
        (R := R) (M := M) (rs := rs) (n := n + 1)
        ⟨((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M), hx⟩
  let pieceMap :
      idealAssociatedGradedPiece (Ideal.ofList rs) M n →ₛₗ[Ideal.Quotient.mk K]
        idealAssociatedGradedPiece Jbar (M ⧸ KM) n :=
    Submodule.mapQ
      ((idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1)).submoduleOf
        (idealAssociatedGradedStage (Ideal.ofList rs) M n))
      ((idealAssociatedGradedStage Jbar (M ⧸ KM) (n + 1)).submoduleOf
        (idealAssociatedGradedStage Jbar (M ⧸ KM) n))
      stageMap
      hstageMap
  refine AddEquiv.ofBijective pieceMap.toAddMonoidHom ⟨?_, ?_⟩
  · -- Identify the kernel of the descended quotient map with the source denominator.
    have hcomap :
        Submodule.comap stageMap
            ((idealAssociatedGradedStage Jbar (M ⧸ KM) (n + 1)).submoduleOf
              (idealAssociatedGradedStage Jbar (M ⧸ KM) n)) =
          ((idealAssociatedGradedStage (Ideal.ofList rs) M (n + 1)).submoduleOf
            (idealAssociatedGradedStage (Ideal.ofList rs) M n)) := by
      apply le_antisymm
      · intro x hx
        -- The quotient-side next-stage condition forces the source representative into
        -- `J ^ (n + 1) M`.
        exact
          iInf_pow_stage_mem_succ_of_quotient_mem_succ
            (R := R) (M := M) (rs := rs) (n := n) (x := x) (by
              simpa [Submodule.mem_comap, stageMap] using hx)
      · exact hstageMap
    have hker : LinearMap.ker pieceMap = ⊥ := by
      rw [Submodule.ker_mapQ, hcomap, Submodule.mkQ_map_self]
    simpa using LinearMap.ker_eq_bot.mp hker
  · intro y
    refine Quotient.inductionOn y ?_
    intro y
    -- Lift a quotient-side stage representative back to `J ^ n M`, then descend to the quotient.
    rcases
        iInf_pow_idealAssociatedGradedStageToQuotient_exists
          (R := R) (M := M) (rs := rs) (n := n) y with
      ⟨x, hx⟩
    refine ⟨Submodule.Quotient.mk x, ?_⟩
    have hxy : stageMap x = y := by
      apply Subtype.ext
      simpa [stageMap] using hx
    change Submodule.Quotient.mk (stageMap x) = Submodule.Quotient.mk y
    rw [hxy]

/-- Helper for Lemma 10.69.9: on a representative in `J ^ n M`, the degreewise quotient
equivalence is still induced by the quotient map `M → M / ⋂ m, J ^ m M`. -/
@[simp] private theorem iInf_pow_idealAssociatedGradedPiece_equiv_apply_mk
    (rs : List R) (n : ℕ)
    (x : idealAssociatedGradedStage (Ideal.ofList rs) M n) :
    iInf_pow_idealAssociatedGradedPiece_equiv (R := R) (M := M) rs n
        (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk
        (⟨Submodule.Quotient.mk ((x : idealAssociatedGradedStage (Ideal.ofList rs) M n) : M),
          iInf_pow_idealAssociatedGradedStageToQuotient_mem (R := R) (M := M) (rs := rs) n x⟩ :
          idealAssociatedGradedStage
            (R := R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
            (Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
            (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) n) := by
  -- The degreewise equivalence is defined from the descended quotient map, so on a quotient
  -- representative it is exactly the expected `Submodule.mapQ` image.
  rfl

/-- Helper for Lemma 10.69.9: the full associated graded module is transported degreewise by the
piecewise quotient equivalences. -/
private noncomputable def iInf_pow_idealAssociatedGradedModule_equiv
    (rs : List R) :
    idealAssociatedGradedModule (Ideal.ofList rs) M ≃
      idealAssociatedGradedModule
        (R := R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) := by
  classical
  let K : Ideal R := ⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)
  let KM : Submodule R M := ⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
  let ePiece :
      ∀ n,
        idealAssociatedGradedPiece (Ideal.ofList rs) M n ≃+
          idealAssociatedGradedPiece Jbar (M ⧸ KM) n :=
    fun n ↦ iInf_pow_idealAssociatedGradedPiece_equiv (R := R) (M := M) rs n
  -- Package the degreewise quotient equivalences componentwise on the direct sum.
  exact (DFinsupp.mapRange.addEquiv ePiece).toEquiv

/-- Helper for Lemma 10.69.9: after quotienting `M` by `⋂ n, J ^ n M`, the submodule generated by
the images of `rs` is exactly the image of `J M`. -/
private theorem iInf_pow_ofList_smul_top_map_eq
    (rs : List R) :
    (Ideal.ofList
        (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
        (⊤ :
          Submodule
            (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
            (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))).restrictScalars R =
      (Ideal.ofList rs • (⊤ : Submodule R M)).map
        (Submodule.mkQ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) := by
  -- Degree one of the stage comparison identifies the quotient-side `J̄ M̄` with the image of
  -- `J M`.
  ext y
  simpa [idealAssociatedGradedStage, pow_one] using
    (iInf_pow_ofList_pow_smul_top_mem_iff (R := R) (M := M) (rs := rs) 1
      (y := y))

/-- Helper for Lemma 10.69.9: the `J`-adic intersection on `M` lies inside the first stage
`J M`. -/
private theorem iInf_pow_smul_top_le_ofList_smul_top
    (rs : List R) :
    (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)) ≤
      Ideal.ofList rs • (⊤ : Submodule R M) := by
  -- The intersection is contained in stage `1`, and stage `1` is exactly `J M`.
  simpa [pow_one] using
    (iInf_le (fun m : ℕ ↦ (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)) 1)

/-- Helper for Lemma 10.69.9: the first tensor factor `M / J M` agrees with the iterated quotient
`(M / ⋂ n, J^n M) / J̄(M / ⋂ n, J^n M)` as an `R`-module. -/
private noncomputable def iInf_pow_ofList_quotient_module_equiv
    (rs : List R) :
    (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ≃ₗ[R]
      ((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
          (⊤ :
            Submodule
              (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) :=
  let KM : Submodule R M := ⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)
  let K : Ideal R := ⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)
  let Jbar : Ideal (R ⧸ K) := Ideal.ofList (rs.map (Ideal.Quotient.mk K))
  let eNested :
      (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ≃ₗ[R]
        ((M ⧸ KM) ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)).map (Submodule.mkQ KM)) :=
    (Submodule.quotientQuotientEquivQuotient
      KM
      (Ideal.ofList rs • (⊤ : Submodule R M))
      (iInf_pow_smul_top_le_ofList_smul_top (R := R) (M := M) rs)).symm
  let eDenom :
      ((M ⧸ KM) ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)).map (Submodule.mkQ KM)) ≃ₗ[R]
        ((M ⧸ KM) ⧸
          (Jbar •
            (⊤ :
              Submodule
                (R ⧸ K)
                (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))).restrictScalars R) :=
    Submodule.quotEquivOfEq
      ((Ideal.ofList rs • (⊤ : Submodule R M)).map (Submodule.mkQ KM))
      ((Jbar •
          (⊤ :
            Submodule
              (R ⧸ K)
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))).restrictScalars R)
      ((iInf_pow_ofList_smul_top_map_eq (R := R) (M := M) (rs := rs)).symm)
  let eRestr :
      ((M ⧸ KM) ⧸
        (Jbar •
          (⊤ :
            Submodule
              (R ⧸ K)
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))))).restrictScalars R) ≃ₗ[R]
        ((M ⧸ KM) ⧸
          (Jbar •
            (⊤ :
              Submodule
                (R ⧸ K)
                (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) :=
    Submodule.Quotient.restrictScalarsEquiv R
      (Jbar •
        (⊤ :
          Submodule
            (R ⧸ K)
            (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))
  eNested.trans (eDenom.trans eRestr)

/-- Helper for Lemma 10.69.9: the quotient-module identification sends the class of `m` to the
iterated quotient class represented by `m`. -/
@[simp] private theorem iInf_pow_ofList_quotient_module_equiv_apply_mk
    (rs : List R) (m : M) :
    iInf_pow_ofList_quotient_module_equiv (R := R) (M := M) rs
        (Submodule.Quotient.mk m) =
      Submodule.Quotient.mk (Submodule.Quotient.mk m) := by
  -- Each factor in the third-isomorphism package preserves the obvious representative.
  simpa [iInf_pow_ofList_quotient_module_equiv, Submodule.quotientQuotientEquivQuotient,
    Submodule.mapQ_apply]

/-- Helper for Lemma 10.69.9: the iterated quotient module carries the natural action of the
iterated quotient ring. -/
private noncomputable instance iInf_pow_iterated_quotient_module
    (rs : List R) :
    Module
      (((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
        Ideal.ofList
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))))
      ((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk
            (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
          (⊤ :
            Submodule
              (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
              (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) :=
  inferInstance

/-- Helper for Lemma 10.69.9: the quotient-side list has the same length as the original list. -/
private theorem iInf_pow_quotient_list_length
    (rs : List R) :
    rs.length =
      (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))).length := by
  -- The quotient map only changes coefficients, not the number of generators.
  simp

/-- Helper for Lemma 10.69.9: the quotient-ring identification sends the class of `r mod J` to the
iterated quotient class represented by `r`. -/
@[simp] private theorem iInf_pow_ofList_quotient_ringEquiv_symm_apply_mk
    (rs : List R) (r : R) :
    (iInf_pow_ofList_quotient_ringEquiv (R := R) rs).symm
        (Ideal.Quotient.mk (Ideal.ofList rs) r) =
      Ideal.Quotient.mk
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)) r) := by
  -- Unpack the quotient-of-quotient equivalence on representatives and then rewrite the
  -- denominator using the explicit image-ideal equality.
  change
    (Ideal.quotEquivOfEq (iInf_pow_ofList_map_eq (R := R) rs).symm)
        (((DoubleQuot.quotQuotEquivQuotOfLE
            (iInf_pow_le_ofList (R := R) rs)).symm)
          (Ideal.Quotient.mk (Ideal.ofList rs) r)) =
      Ideal.Quotient.mk
        (Ideal.ofList
          (rs.map (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))
        (Ideal.Quotient.mk (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)) r)
  rw [DoubleQuot.quotQuotEquivQuotOfLE_symm_mk]
  rfl

/-- Helper for Lemma 10.69.9: the tensor-product source of the quasi-regular comparison map is
transported from `M / J M` to the quotient-side source by the nested quotient equivalence and the
quotient-ring polynomial transport. -/
private noncomputable def iInf_pow_quasiRegularSource_equiv
    (rs : List R) :
    ((M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ⊗[R ⧸ Ideal.ofList rs]
      MvPolynomial (Fin rs.length) (R ⧸ Ideal.ofList rs)) ≃
      (((M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M))) ⧸
          (Ideal.ofList
            (rs.map (Ideal.Quotient.mk
              (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))) •
            (⊤ :
              Submodule
                (R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))
                (M ⧸ (⨅ m : ℕ, (Ideal.ofList rs) ^ m • (⊤ : Submodule R M)))))) ⊗[
          ((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
            Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))))]
        MvPolynomial (Fin (rs.map (Ideal.Quotient.mk
          (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R)))).length)
          (((R ⧸ (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))) ⧸
            Ideal.ofList
              (rs.map (Ideal.Quotient.mk
                (⨅ m : ℕ, ((Ideal.ofList rs) ^ m : Ideal R))))))) :=
  -- TODO: package the first-factor quotient equivalence as a semilinear equivalence over
  -- `iInf_pow_ofList_quotient_ringEquiv`, combine it with coefficient change plus a length cast on
  -- the polynomial factor, and then take the underlying `Equiv`.
