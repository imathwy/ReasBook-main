import Mathlib
import stacks_project.Chap15.Definition_15_32_1

-- Declarations for this item will be appended below by the statement pipeline.

open RingTheory
open PrimeSpectrum

universe u

section

variable {R : Type u} [CommRing R]

namespace Ideal

/- Domain triage:
- primary domain: Zariski-local finiteness descent for quasi-regular ideals in commutative
  algebra;
- sampled owner declarations: `Ideal.IsQuasiRegularIdeal`,
  `PrimeSpectrum.iSup_basicOpen_eq_top_iff'`,
  `Ideal.fg_of_localizationSpan`,
  `Submodule.fg_span`;
- layer split:
  `source-facing`: the local quasi-regularity predicate `Ideal.IsQuasiRegularIdeal`;
  `core/canonical`: finite generation `Ideal.FG`;
  `bridge/view`: a basic-open cover of `Spec R` together with localized finite generation of the
  mapped ideal. -/

-- Proof sketch: unfold `I.IsQuasiRegularIdeal` to obtain, near each prime containing `I`, a
-- localization in which `I` is generated by a finite quasi-regular sequence, hence by finitely
-- many elements. Let `s = {g | I_g is finitely generated}`. The localized quasi-regularity covers
-- `V(I)`, while for primes outside `V(I)` any `x ∈ I` not in the prime gives `I_x = ⊤`, hence
-- `x ∈ s`. Therefore the basic opens `D(g)` for `g ∈ s` cover `Spec R`, so
-- `PrimeSpectrum.iSup_basicOpen_eq_top_iff'` gives `Ideal.span s = ⊤`, and the owner theorem
-- `Ideal.fg_of_localizationSpan` concludes.
/-- Lemma 15.32.2: a quasi-regular ideal is finitely generated. -/
theorem fg_of_isQuasiRegularIdeal {I : Ideal R} (hI : I.IsQuasiRegularIdeal) :
    I.FG := by
  classical
  let J : (g : R) → Ideal (Localization.Away g) :=
    fun g ↦ I.map (algebraMap R (Localization.Away g))
  let s : Set R := {g | (J g).FG}
  have hs_mem {g : R} (hg : g ∈ s) :
      (basicOpen g : TopologicalSpace.Opens (PrimeSpectrum R)) ≤ ⨆ r ∈ s, basicOpen r :=
    le_iSup_of_le g <| le_iSup_of_le hg le_rfl
  have hs_cover : (⨆ r ∈ s, basicOpen r) = ⊤ := by
    apply SetLike.ext'
    change (↑(⨆ r ∈ s, basicOpen r) : Set (PrimeSpectrum R)) = Set.univ
    rw [Set.eq_univ_iff_forall]
    intro p
    by_cases hpI : I ≤ p.asIdeal
    · rcases (isQuasiRegularIdeal_iff I).1 hI p.asIdeal p.2 hpI with ⟨g, hg, r, f, -, hJg⟩
      have hgfg : g ∈ s := by
        simpa [J, s, hJg] using
          (Submodule.fg_span (Set.finite_range f) : (Ideal.span (Set.range f)).FG)
      have hpg : p ∈ (basicOpen g : Set (PrimeSpectrum R)) := by
        simpa [mem_basicOpen] using hg
      exact hs_mem hgfg hpg
    · have hpI' : ∃ x, x ∈ I ∧ x ∉ p.asIdeal := by
          simpa [SetLike.le_def] using hpI
      rcases hpI' with ⟨x, hxI, hxp⟩
      have hxfg : x ∈ s := by
        have hxmap : algebraMap R (Localization.Away x) x ∈ J x := Ideal.mem_map_of_mem _ hxI
        have hxtop : J x = ⊤ :=
          (J x).eq_top_of_isUnit_mem hxmap
            (IsLocalization.map_units (Localization.Away x) ⟨x, Submonoid.mem_powers x⟩)
        simpa [J, s, hxtop] using Ideal.fg_top (Localization.Away x)
      have hpx : p ∈ (basicOpen x : Set (PrimeSpectrum R)) := by
        simpa [mem_basicOpen] using hxp
      exact hs_mem hxfg hpx
  have hs_span : Ideal.span s = ⊤ :=
    iSup_basicOpen_eq_top_iff'.mp hs_cover
  refine Ideal.fg_of_localizationSpan s hs_span ?_
  intro g
  change (J g.1).FG
  exact g.2

end Ideal

end
