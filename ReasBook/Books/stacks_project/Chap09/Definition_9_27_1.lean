import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import Mathlib.Tactic.Recall

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

variable (k Ω : Type u) [Field k] [Field Ω] [Algebra k Ω]
variable (K L : IntermediateField k Ω)

/- Domain triage:
- primary domain: lattice operations on intermediate fields, with compositum realized as a join;
- sampled owner declarations: the `CompleteLattice` instance on `IntermediateField k Ω`,
  `IntermediateField.sup_def`, `IntermediateField.adjoin_union`, and `isLUB_pair`;
- core/canonical owner abstraction: the lattice supremum `K ⊔ L` in `IntermediateField k Ω`;
- layer: `core/canonical`, since Definition 9.27.1 identifies the compositum with an existing owner
  operation rather than introducing new primitive data;
- primitive data: only the two intermediate fields `K` and `L`;
- derived API: the least-upper-bound characterization and the concrete formula
  `K ⊔ L = IntermediateField.adjoin k (K ∪ L)`.
-/

/- Definition 9.27.1: for intermediate fields `K` and `L` of `Ω / k`, the compositum inside the
common overfield `Ω` is the canonical supremum `K ⊔ L`. -/
#check (K ⊔ L : IntermediateField k Ω)

/- Companion recall: the order-theoretic content of the definition is the generic least-upper-bound
statement for a pair, specialized here to intermediate fields. -/
#check (show IsLUB ({K, L} : Set (IntermediateField k Ω)) (K ⊔ L) from isLUB_pair)

/- Companion recall: concretely, the compositum is the intermediate field generated by the union of
the two given intermediate fields. -/
recall IntermediateField.sup_def

end
