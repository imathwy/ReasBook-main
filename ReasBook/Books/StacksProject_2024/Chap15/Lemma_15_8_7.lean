import Mathlib
import Mathlib.Data.List.TFAE
import stacks_project.Chap15.Lemma_15_8_4

-- Declarations for this item will be appended below by the statement pipeline.

open scoped FittingIdeal TensorProduct

universe u v

/-
Domain-style sampling for Lemma 15.8.7:
- primary domain: commutative algebra of finite modules, Fitting ideals, residue-field fibers, and
  local generation after localization;
- sampled owner-level declarations:
  `fittingIdeal`,
  `fittingIdeal_baseChange`,
  `Module.finrank`,
  `exists_sub_one_mem_and_span_localized_eq_top_of_quotient_span_eq_top`;
- best owner abstraction: clause (1) should use the chapter owner `fittingIdeal` directly, via the
  canonical notation `Fit[R]_(k)(M)`, while clauses (3) and (4) use the intrinsic generation
  owner `Submodule.span ... = ⊤` rather than introducing a parallel wrapper for "generated by
  `k` elements";
- primitive data: the finite module `M`, the integer `k`, and the prime ideal `p`;
- derived API: the residue-field finrank criterion, the at-prime generation criterion, and the
  away-local generation criterion linked by base change and Nakayama.

Source/core/bridge triage:
- `source-facing`: the four equivalent conditions of Lemma 15.8.7;
- `core/canonical`: `fittingIdeal` and the canonical localization/base-change objects;
- `bridge/view`: the residue-field finrank test and the localized generation clauses. -/

section

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]

-- Proof sketch: use `fittingIdeal_baseChange` from Lemma `15.8.4` to reduce clause (1) to
-- the case over the residue field `κ(p)`, where Example `15.8.5` computes the relevant Fitting
-- ideal of a finite-dimensional vector space. The equivalence of clauses (2), (3), and (4) is the
-- usual local-generation criterion via Nakayama's lemma, passing between `M ⊗[R] κ(p)`,
-- `M_p`, and an open neighborhood `D(f)` of `p`.
/-- Lemma 15.8.7: for a finite `R`-module `M`, a nonnegative integer `k`, and a prime ideal `p`,
the following are equivalent: the `k`th Fitting ideal of `M` is not contained in `p`; the
residue-field fiber `M ⊗[R] κ(p)` has dimension at most `k`; the localization `M_p` is generated
by `k` elements over `R_p`; and some localization `M_f` with `f ∉ p` is generated by `k`
elements over `R_f`. -/
theorem fittingIdeal_not_le_prime_tfae_residueField_finrank_and_local_generators
    (k : ℕ) (p : Ideal R) [p.IsPrime] :
    List.TFAE
      [ ¬ Fit[R]_(k)(M) ≤ p
      , Module.finrank p.ResidueField (p.ResidueField ⊗[R] M) ≤ k
      , ∃ v : Fin k → LocalizedModule.AtPrime p M,
          Submodule.span (Localization.AtPrime p) (Set.range v) = ⊤
      , ∃ f : R, f ∉ p ∧ ∃ v : Fin k → LocalizedModule.Away f M,
          Submodule.span (Localization.Away f) (Set.range v) = ⊤
      ] := sorry

end
