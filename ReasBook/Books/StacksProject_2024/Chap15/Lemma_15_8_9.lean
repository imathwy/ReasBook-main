open scoped FittingIdeal

/-
Domain-style sampling for Lemma 15.8.9:
- primary domain: local commutative algebra of finite modules, intrinsic Fitting ideals, and
  quotients by `f`-torsion;
- sampled owner-level declarations:
  `fittingIdeal`,
  `principalIdeal`,
  `Submodule.torsionBy`,
  `Submodule.span`,
  `span_range_eq_top_iff_surjective_fintypeLinearCombination`;
- best owner abstraction: the theorem is `source-facing`, and its main hypothesis should use the
  intrinsic owner `fittingIdeal` together with the chapter owner `principalIdeal`; the canonical
  "generated by `k` elements" conclusion is the
  intrinsic span statement for a family `Fin k → N`, while the surjective
  `Fintype.linearCombination` map is the operational bridge view;
- primitive data: the finite module `M`, the integer `k`, and the intrinsic Fitting-ideal
  equality `fittingIdeal R M k = principalIdeal f`;
- derived API: the surjective `Fintype.linearCombination` view obtained from the source-facing span
  theorem via `span_range_eq_top_iff_surjective_fintypeLinearCombination`.

Source/core/bridge triage:
- `source-facing`: `quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal`;
- `core/canonical`: `fittingIdeal`, `principalIdeal`, `Submodule.torsionBy`, `Submodule.span`;
- `bridge/view`:
  `quotient_torsionBy_fintypeLinearCombination_surjective_of_fittingIdeal_eq_principalIdeal`. -/

universe u v

section

variable {R : Type u} [CommRing R] [IsLocalRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]
variable {k : ℕ} {f : R}

/-- Lemma 15.8.9: over a local ring, if the chapter `k`th Fitting ideal of a finite module `M` is
the principal ideal `(f)`, then the quotient of `M` by its `f`-torsion is generated by `k`
elements. -/
-- Proof sketch: choose a finite free presentation of `M` computing `fittingIdeal R M k`,
-- apply the local determinantal normal-form argument to the resulting presentation matrix. Passing
-- to the quotient by `Submodule.torsionBy R M f` kills the `f`-torsion part, and the images of
-- the remaining `k` generators span the quotient module.
theorem quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal
    (hfit : Fit[R]_(k)(M) = principalIdeal f) :
    ∃ v : Fin k → M ⧸ Submodule.torsionBy R M f,
      Submodule.span R (Set.range v) = ⊤ := sorry

/-- Companion surjective linear-combination formulation of
`quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal`. -/
theorem quotient_torsionBy_fintypeLinearCombination_surjective_of_fittingIdeal_eq_principalIdeal
    (hfit : Fit[R]_(k)(M) = principalIdeal f) :
    ∃ v : Fin k → M ⧸ Submodule.torsionBy R M f,
      Function.Surjective (Fintype.linearCombination R v) := by
  rcases quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal hfit with ⟨v, hv⟩
  exact ⟨v, by
    simpa using (span_range_eq_top_iff_surjective_fintypeLinearCombination R v).1 hv⟩

end
