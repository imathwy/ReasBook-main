import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v w

open scoped TensorProduct

section

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- The `k`th Fitting ideal attached to a surjection `R^n → M`, computed from `(n - k)` kernel
vectors as in the intrinsic reformulation of the minors construction. -/
def freePresentationFittingIdeal (k : ℕ) {n : ℕ} (π : (Fin n → R) →ₗ[R] M) : Ideal R :=
  Ideal.span (Set.range fun p : (Fin (n - k) ↪ Fin n) × (Fin (n - k) → LinearMap.ker π) ↦
    Matrix.det (fun i j ↦ (((p.2 j : LinearMap.ker π) : Fin n → R) (p.1 i))))

variable (R) (M)

/-- The canonical `k`th Fitting ideal of a module, defined as the infimum of the Fitting ideals
coming from all finite free presentations. -/
def moduleFittingIdeal (k : ℕ) : Ideal R :=
  sInf { I : Ideal R | ∃ n : ℕ, ∃ π : (Fin n → R) →ₗ[R] M, Function.Surjective π ∧
    I = freePresentationFittingIdeal k π }

variable {R M}

/-- The canonical Fitting ideal is bounded above by the Fitting ideal of any chosen finite free
presentation. -/
-- Proof sketch: `moduleFittingIdeal` is the infimum of the set of all presentation ideals, so it
-- is below every member coming from a surjective finite free presentation.
theorem moduleFittingIdeal_le_freePresentationFittingIdeal (k : ℕ) {n : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π) :
    moduleFittingIdeal R M k ≤ freePresentationFittingIdeal k π := sorry

variable {M' : Type w} [AddCommGroup M'] [Module R M']

-- Proof sketch: choose a surjection `R^n → M`; the intrinsic presentation formula shows that all
-- `(n - n) × (n - n)` minors generate the unit ideal, and then compare with the canonical infimum
-- definition.
/-- Lemma 15.8.4 (1): if `M` is generated by `n` elements, then its `n`th Fitting ideal is the
unit ideal. -/
theorem moduleFittingIdeal_eq_top_of_exists_surjective_fin (n : ℕ)
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π) :
    moduleFittingIdeal R M n = ⊤ := sorry

-- Proof sketch: apply the block-diagonal formula for presentation matrices to the direct-sum
-- presentation of `M ⊕ M'`, and then specialize the antidiagonal sum at `l = 0`.
/-- Lemma 15.8.4 (2): the zeroth Fitting ideal of a direct sum is the product of the zeroth
Fitting ideals. -/
theorem moduleFittingIdeal_zero_directSum [Module.Finite R M] [Module.Finite R M'] :
    moduleFittingIdeal R (M × M') 0 =
      moduleFittingIdeal R M 0 * moduleFittingIdeal R M' 0 := sorry

-- Proof sketch: use finite free presentations of `M` and `M'`, form the block-diagonal
-- presentation of `M ⊕ M'`, and invoke the corresponding minors formula from the matrix-level
-- statement.
/-- Lemma 15.8.4 (3): the `l`th Fitting ideal of a direct sum is the sum of the products of the
`k`th and `k'`th Fitting ideals over all decompositions `k + k' = l`. -/
theorem moduleFittingIdeal_directSum [Module.Finite R M] [Module.Finite R M'] (l : ℕ) :
    moduleFittingIdeal R (M × M') l =
      Finset.sum (Finset.antidiagonal l) fun p ↦
        moduleFittingIdeal R M p.1 * moduleFittingIdeal R M' p.2 := sorry

-- Proof sketch: tensor a finite free presentation of `M` with `R'`; tensor product preserves
-- right exactness, and the minors in the base-changed presentation generate the image ideal.
/-- Lemma 15.8.4 (4): after base change along `R → R'`, the `k`th Fitting ideal is the ideal of
`R'` generated by the image of the `k`th Fitting ideal over `R`. -/
theorem moduleFittingIdeal_baseChange {R' : Type w} [CommRing R'] [Algebra R R']
    [Module R' (M ⊗[R] R')] [Module.Finite R M] (k : ℕ) :
    moduleFittingIdeal R' (M ⊗[R] R') k =
      Ideal.map (algebraMap R R') (moduleFittingIdeal R M k) := sorry

-- Proof sketch: start from a finite presentation of `M`; the relevant ideal is generated by a
-- finite set of minors of a finite presentation matrix, hence is finitely generated.
/-- Lemma 15.8.4 (5): if `M` is finitely presented, then each Fitting ideal of `M` is finitely
generated. -/
theorem moduleFittingIdeal_fg_of_finitePresentation [Module.FinitePresentation R M] (k : ℕ) :
    (moduleFittingIdeal R M k).FG := sorry

-- Proof sketch: compose a finite free presentation of `M` with the surjection `M → M'`. Every
-- presentation of `M` induces one of `M'`, so the defining presentation ideals for `M` lie below
-- those for `M'`.
/-- Lemma 15.8.4 (6): a surjection `M → M'` makes the `k`th Fitting ideal of `M` contained in the
`k`th Fitting ideal of `M'`. -/
theorem moduleFittingIdeal_mono_of_surjective [Module.Finite R M] [Module.Finite R M']
    (f : M →ₗ[R] M') (hf : Function.Surjective f) (k : ℕ) :
    moduleFittingIdeal R M k ≤ moduleFittingIdeal R M' k := sorry

-- Proof sketch: use a finite presentation of `M` and the determinant trick on the maximal minors
-- of a presentation matrix to show that every generator of `Fit₀(M)` annihilates `M`.
/-- Lemma 15.8.4 (7): the zeroth Fitting ideal of `M` is contained in the annihilator ideal of
`M`. -/
theorem moduleFittingIdeal_zero_le_annihilator [Module.Finite R M] :
    moduleFittingIdeal R M 0 ≤ Module.annihilator R M := sorry

-- Proof sketch: combine the previous annihilator containment with the characterization of support
-- of a finite module as the zero locus of its annihilator, and compare with the determinant
-- criterion after reducing modulo a prime.
/-- Lemma 15.8.4 (8): the zero locus of the zeroth Fitting ideal of `M` is the support of `M`. -/
theorem zeroLocus_moduleFittingIdeal_zero_eq_support [Module.Finite R M] :
    PrimeSpectrum.zeroLocus (moduleFittingIdeal R M 0) = Module.support R M := sorry

-- Proof sketch: use the standard one-generator presentation of `R ⧸ I`; its `1 × 1` minors are
-- exactly the elements of `I`, so the zeroth Fitting ideal recovers `I`.
/-- Lemma 15.8.4 (9): the zeroth Fitting ideal of the quotient module `R ⧸ I` is `I`. -/
theorem moduleFittingIdeal_zero_quotient (I : Ideal R) :
    moduleFittingIdeal R (R ⧸ I) 0 = I := sorry

end
