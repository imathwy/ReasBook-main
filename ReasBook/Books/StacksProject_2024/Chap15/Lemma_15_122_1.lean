/-- In a unique factorization domain, the powers of a nonzero nonunit element lie in the canonical
submonoid closure of the prime elements. -/
private theorem powers_le_closure_primes_of_ne_zero_of_not_isUnit
    {R : Type u} [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R] {f : R}
    (hf : f ≠ 0) (hfu : ¬ IsUnit f) :
    Submonoid.powers f ≤ Submonoid.closure {p : R | Prime p} := by
  have hf_closure : f ∈ Submonoid.closure {p : R | Prime p} := by
    rcases (WfDvdMonoid.not_unit_iff_exists_factors_eq f hf).mp hfu with ⟨g, hg, hprod, -⟩
    rw [← hprod]
    exact Submonoid.multiset_prod_mem _ _ fun p hp ↦
      Submonoid.subset_closure <|
        UniqueFactorizationMonoid.irreducible_iff_prime.mp (hg p hp)
  rw [Submonoid.powers_eq_closure]
  exact Submonoid.closure_le.2 (Set.singleton_subset_iff.2 hf_closure)

/-- Lemma 15.122.1: if `R` is a regular local ring and `f ∈ R`, then the localization `R_f`,
realized as `Localization.Away f`, has trivial Picard group. -/
theorem subsingleton_picardGroup_localizationAway_of_isRegularLocalRing
    {R : Type u} [CommRing R] [IsRegularLocalRing R] (f : R) :
    Subsingleton (CommRing.Pic (Localization.Away f)) := by
  by_cases hf : f = 0
  · subst hf
    let _ : Subsingleton (Localization.Away (0 : R)) :=
      IsLocalization.subsingleton
        (show (0 : R) ∈ Submonoid.powers (0 : R) from ⟨1, by simp⟩)
    infer_instance
  · by_cases hfu : IsUnit f
    · let e := IsLocalization.atUnit R (Localization.Away f) f hfu
      let _ : IsLocalRing (Localization.Away f) := e.toRingEquiv.isLocalRing
      exact CommRing.Pic.instSubsingletonOfIsLocalRing (Localization.Away f)
    · let _ : IsDomain (Localization.Away f) :=
        IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away f)
          (powers_le_nonZeroDivisors_of_noZeroDivisors hf)
      let _ : UniqueFactorizationMonoid (Localization.Away f) :=
        (nagataCriterionForFactoriality
          (powers_le_closure_primes_of_ne_zero_of_not_isUnit hf hfu)).mp inferInstance |>.2
      infer_instance

end
