open CategoryTheory Limits

universe v u

namespace CategoryTheory.ObjectProperty

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [Preadditive C] [HasShift C ℤ]
  [(n : ℤ) → (shiftFunctor C n).Additive] [Pretriangulated C]

/- Domain-style sampling for Lemma 13.36.1:
- primary domain: generators in a triangulated category, expressed through `ObjectProperty`,
  shift-closure, additive-extension stages, and bounded shift intervals;
- sampled owner declarations:
  `ObjectProperty.shiftClosure`,
  `ObjectProperty.additiveExtensionStage`,
  `CategoryTheory.shiftInterval`,
  `ObjectProperty.additiveExtensionStage_add`;
- best owner abstraction: keep the source-facing recursive stage `⟨E⟩_n` as the public owner,
  and use the canonical chapter owner `additiveExtensionStage ((singleton E).shiftClosure ℤ) n`
  only as a bridge theorem for the closed-form description;
- primitive-vs-derived split:
  primitive data are the recursive first stage `⟨E⟩_1`, the source recursion
  `⟨E⟩_(n + 1) = smd(⟨E⟩_1 ⋆ ⟨E⟩_n)`, and the canonical singleton shift-closure on `E`;
  derived API is the additive-extension-stage bridge together with the interval/addition
  descriptions below.

Source/core/bridge triage:
- `source-facing`: the textbook stages `⟨E⟩_n`;
- `core/canonical`: `singleton`, `shiftClosure`, `additiveExtensionStage`,
  `shiftInterval`, and extension-product iteration;
- `bridge/view`: the lemmas below identify the recursive stage owner with the canonical additive
  extension stage and then rewrite it into the textbook interval/addition forms used in
  Section `13.36`. -/

/-- The textbook stage `⟨E⟩_n`, obtained from finite direct sums of shifts of `E` by taking `n`
iterated extension steps and then closing under retracts/direct summands. The source defines
these stages recursively from the first stage `⟨E⟩_1`. -/
def objectGeneratedStage (E : C) (n : ℕ+) : ObjectProperty C :=
  let P0 : ObjectProperty C := ((singleton E).shiftClosure ℤ).additiveClosure
  @PNat.recOn n
    (fun _ ↦ ObjectProperty C)
    P0.retractClosure
    (fun _ ih ↦ (P0.retractClosure.extensionProduct ih).retractClosure)

end

end CategoryTheory.ObjectProperty

namespace CategoryTheory.ObjectProperty.GeneratedNotation

open CategoryTheory.ObjectProperty

/- Textbook notation for the generated stage `⟨E⟩_n`. -/
scoped notation:max "⟨" E "⟩_" n => objectGeneratedStage E n

end CategoryTheory.ObjectProperty.GeneratedNotation

namespace CategoryTheory.ObjectProperty

open scoped CategoryTheory.ObjectProperty.GeneratedNotation
open scoped CategoryTheory.ObjectProperty.ExtensionProductNotation

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [Preadditive C] [HasShift C ℤ]
  [(n : ℤ) → (shiftFunctor C n).Additive] [Pretriangulated C]

private theorem iSup_nat_eq_iSup_pNat {α : Type*} [CompleteLattice α] (A : ℕ → α)
    (hA : Monotone A) :
    (⨆ n : ℕ, A n) = ⨆ n : ℕ+, A n := by
  refine le_antisymm ?_ ?_
  · refine iSup_le fun n ↦ ?_
    cases n with
    | zero =>
        exact (hA (show 0 ≤ 1 by omega)).trans <| le_iSup (fun n : ℕ+ ↦ A n) 1
    | succ n =>
        exact le_iSup (fun n : ℕ+ ↦ A n) (Nat.succPNat n)
  · refine iSup_le fun n ↦ ?_
    exact le_iSup A n.1

-- Proof sketch: unfold the recursive base case of `objectGeneratedStage`.
/-- The first stage generated by `E` is the direct-summand closure of the additive closure of the
canonical shift-closure of `E`, i.e. of all shifts of `E` up to isomorphism. -/
theorem objectGeneratedStage_one_eq (E : C) :
    (⟨E⟩_1) = (((singleton E).shiftClosure ℤ).additiveClosure).retractClosure := by
  rfl

/-- The source recursion for the generated stages: `⟨E⟩_(n + 1)` is the retract/direct-summand
closure of `⟨E⟩_1 ⋆ ⟨E⟩_n`. -/
theorem objectGeneratedStage_succ (E : C) (n : ℕ+) :
    (⟨E⟩_(n + 1)) = (((⟨E⟩_1) ⋆ (⟨E⟩_n)).retractClosure) := by
  let P0 : ObjectProperty C := ((singleton E).shiftClosure ℤ).additiveClosure
  rw [objectGeneratedStage, PNat.recOn_succ]
  change ((P0.retractClosure ⋆ objectGeneratedStage E n).retractClosure) =
    (((⟨E⟩_1) ⋆ (⟨E⟩_n)).retractClosure)
  rw [objectGeneratedStage_one_eq]

/-- Bridge to the canonical Chapter 13 owner: the recursive stage `⟨E⟩_n` is exactly the
additive-extension stage of the singleton shift-closure of `E`. -/
theorem objectGeneratedStage_eq_additiveExtensionStage (E : C) (n : ℕ+) :
    (⟨E⟩_n) = additiveExtensionStage ((singleton E).shiftClosure ℤ) n := by
  let P0 : ObjectProperty C := ((singleton E).shiftClosure ℤ).additiveClosure
  refine PNat.recOn n ?_ ?_
  · change P0.retractClosure = (P0.extensionProductIter 0).retractClosure
    simp [P0]
  · intro n ih
    rw [objectGeneratedStage_succ, objectGeneratedStage_one_eq, ih, additiveExtensionStage]
    change
      ((P0.retractClosure ⋆ (P0.extensionProductIter n.natPred).retractClosure).retractClosure) =
        (P0.extensionProductIter (n : ℕ)).retractClosure
    rw [← PNat.natPred_add_one n, extensionProductIter_succ]
    simpa [P0] using
      (retractClosure_extensionProduct_retractClosure_retractClosure
        P0
        (P0.extensionProductIter n.natPred))

-- Proof sketch: rewrite `objectGeneratedStage E n` using `additiveExtensionStage`; then replace
-- the inner retract closure in the iterated extension product of `objectGeneratedStage E 1` using
-- `objectGeneratedStage_one_eq` and `retractClosure_extensionProductIter_retractClosure`.
/-- Lemma 13.36.1 (1): for `n ≥ 1`, the stage `⟨E⟩_n` is the direct-summand closure of the `n`-fold
extension product of the already retract-stable first stage `⟨E⟩_1`; this is the textbook
identity `smd(⟨E⟩_1 ⋆ \cdots ⋆ ⟨E⟩_1) = smd({⟨E⟩_1}^{\star n})`. -/
theorem objectGeneratedStage_eq_retract_iterated_stage_one (E : C) (n : ℕ+) :
    (⟨E⟩_n) = ((⟨E⟩_1).extensionProductIter n.natPred).retractClosure := by
  calc
    (⟨E⟩_n) = additiveExtensionStage ((singleton E).shiftClosure ℤ) n :=
      objectGeneratedStage_eq_additiveExtensionStage E n
    _ = ((⟨E⟩_1).extensionProductIter n.natPred).retractClosure := by
      rw [additiveExtensionStage, objectGeneratedStage_one_eq]
      symm
      simpa using
        retractClosure_extensionProductIter_retractClosure
          (((singleton E).shiftClosure ℤ).additiveClosure)

omit [HasZeroObject C] [Preadditive C] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] in
private theorem shiftClosure_eq_iSup_shiftInterval (P : ObjectProperty C)
    [P.IsClosedUnderIsomorphisms] :
    P.shiftClosure ℤ = ⨆ m : ℕ, P[-(m : ℤ), (m : ℤ)] := by
  let A : ℕ → ObjectProperty C := fun m ↦ P[-(m : ℤ), (m : ℤ)]
  calc
    P.shiftClosure ℤ = ⨆ a : ℤ, P.shift a := by
      simpa using P.shiftClosure_eq_iSup ℤ
    _ = ⨆ m : ℕ, A m := by
      ext X
      constructor
      · intro hX
        rcases (prop_iSup_iff (fun a : ℤ ↦ P.shift a) X).1 hX with ⟨a, hX⟩
        refine (prop_iSup_iff A X).2 ⟨a.natAbs, ?_⟩
        change (P[-((a.natAbs : ℕ) : ℤ), ((a.natAbs : ℕ) : ℤ)]) X
        rw [prop_shiftInterval_iff]
        refine ⟨a, ⟨?_, ?_⟩, (P.shift a).le_isoClosure _ hX⟩
        · simpa only [Int.abs_eq_natAbs] using neg_abs_le a
        · simpa only [Int.abs_eq_natAbs] using le_abs_self a
      · intro hX
        rcases (prop_iSup_iff A X).1 hX with ⟨m, hX⟩
        change (P[-(m : ℤ), (m : ℤ)]) X at hX
        rw [prop_shiftInterval_iff] at hX
        rcases hX with ⟨a, -, hX⟩
        rw [isoClosure_eq_self] at hX
        exact (prop_iSup_iff (fun a : ℤ ↦ P.shift a) X).2 ⟨a, hX⟩

omit [HasZeroObject C] [Preadditive C] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] in
private theorem singleton_shiftClosure_eq_iSup_objectShiftInterval (E : C) :
    (singleton E).shiftClosure ℤ = ⨆ m : ℕ, objectShiftInterval E (-(m : ℤ)) (m : ℤ) := by
  change (singleton E).shiftClosure ℤ =
    ⨆ m : ℕ, (singleton E).isoClosure[-(m : ℤ), (m : ℤ)]
  have hIso :
      (singleton E).shiftClosure ℤ = (singleton E).isoClosure.shiftClosure ℤ := by
    apply le_antisymm
    · exact monotone_shiftClosure (singleton E).le_isoClosure
    · rw [shiftClosure_le_iff, isoClosure_le_iff]
      exact (singleton E).le_shiftClosure
  calc
    (singleton E).shiftClosure ℤ = (singleton E).isoClosure.shiftClosure ℤ := hIso
    _ = ⨆ m : ℕ, (singleton E).isoClosure[-(m : ℤ), (m : ℤ)] :=
      shiftClosure_eq_iSup_shiftInterval (singleton E).isoClosure

-- Proof sketch: express the family of all shifts of `E` as the increasing union of the bounded
-- interval families `E[-m,m]`, viewed through the canonical owner `shiftInterval`; then use the
-- interval-supremum lemma `shiftInterval_iSup`,
-- `additiveClosure_iSup_of_monotone`, `extensionProductIter_iSup_of_monotone`, and
-- `retractClosure_iSup` to push the union through the constructions defining
-- `objectGeneratedStage`.
/-- Lemma 13.36.1 (2): for `n ≥ 1`, the stage `⟨E⟩_n` is the union over `m ≥ 1` of the stages
`smd(add(E[-m, m])^{\star n})`. -/
theorem objectGeneratedStage_eq_iSup_intervalStages (E : C) (n : ℕ+) :
    (⟨E⟩_n) =
      ⨆ m : ℕ+,
        additiveExtensionStage
          (objectShiftInterval E (-(m : ℤ)) (m : ℤ)) n := by
  let A : ℕ → ObjectProperty C := fun m ↦ objectShiftInterval E (-(m : ℤ)) (m : ℤ)
  have hA : Monotone A := by
    intro m m' hmm X hX
    change ((singleton E).isoClosure[-(m : ℤ), (m : ℤ)]) X at hX
    change ((singleton E).isoClosure[-(m' : ℤ), (m' : ℤ)]) X
    rw [prop_shiftInterval_iff] at hX ⊢
    rcases hX with ⟨a, ha, hX⟩
    refine ⟨a, ⟨?_, ?_⟩, hX⟩
    · exact le_trans (by simpa using neg_le_neg (show (m : ℤ) ≤ m' by exact_mod_cast hmm)) ha.1
    · exact le_trans ha.2 (show (m : ℤ) ≤ m' by exact_mod_cast hmm)
  let B : ℕ → ObjectProperty C := fun m ↦ additiveExtensionStage (A m) n
  have hB : Monotone B := by
    intro m m' hmm
    simpa [B] using additiveExtensionStage_monotone (hA hmm) n
  calc
    (⟨E⟩_n)
        = additiveExtensionStage ((singleton E).shiftClosure ℤ) n := by
            exact objectGeneratedStage_eq_additiveExtensionStage E n
    _   = additiveExtensionStage (⨆ m : ℕ, A m) n := by
            simpa [A] using
              congrArg (fun Q : ObjectProperty C ↦ additiveExtensionStage Q n)
                (singleton_shiftClosure_eq_iSup_objectShiftInterval E)
    _   = ⨆ m : ℕ, additiveExtensionStage (A m) n := by
            simp_rw [additiveExtensionStage]
            rw [additiveClosure_iSup_of_monotone A hA]
            have hAdd : Monotone fun m ↦ (A m).additiveClosure := by
              intro m m' hmm
              exact
                colimitsClosure_monotone (fun n : ℕ ↦ Discrete (Fin n)) (hA hmm)
            rw [extensionProductIter_iSup_of_monotone (fun m ↦ (A m).additiveClosure) hAdd n.natPred]
            rw [retractClosure_iSup]
    _ =
        ⨆ m : ℕ+,
          additiveExtensionStage
            (objectShiftInterval E (-(m : ℤ)) (m : ℤ)) n := by
          simpa [A, B] using iSup_nat_eq_iSup_pNat B hB

end

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [Preadditive C] [HasShift C ℤ]
  [(n : ℤ) → (shiftFunctor C n).Additive] [Pretriangulated C] [IsTriangulated C]

-- Proof sketch: specialize `additiveExtensionStage_add` to the object property generated by all
-- shifts of `E`.
/-- Lemma 13.36.1 (3): for `n, n' ≥ 1`, the stage `⟨E⟩_{n + n'}` is the direct-summand closure of
`⟨E⟩_n \star ⟨E⟩_{n'}`. -/
theorem objectGeneratedStage_add (E : C) (n n' : ℕ+) :
    (⟨E⟩_(n + n')) = (((⟨E⟩_n) ⋆ (⟨E⟩_n')).retractClosure) := by
  calc
    (⟨E⟩_(n + n')) = additiveExtensionStage ((singleton E).shiftClosure ℤ) (n + n') :=
      objectGeneratedStage_eq_additiveExtensionStage E (n + n')
    _ = (((⟨E⟩_n) ⋆ (⟨E⟩_n')).retractClosure) := by
      rw [additiveExtensionStage_add]
      rw [← objectGeneratedStage_eq_additiveExtensionStage E n]
      rw [← objectGeneratedStage_eq_additiveExtensionStage E n']

end

end CategoryTheory.ObjectProperty
