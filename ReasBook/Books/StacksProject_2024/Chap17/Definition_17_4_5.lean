import Mathlib
import StacksProject_2024.Chap17.Lemma_17_4_4

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry

universe u

/- Domain-style sampling for subsheaf generation by local sections:
- primary domain: subobjects of sheaves of modules on a ringed space;
- sampled owner declarations:
  `CategoryTheory.Subobject.sInf`,
  `CategoryTheory.Subobject.sInf_le`,
  `CategoryTheory.Subobject.le_sInf`,
  `subsheaf_contains_local_sections`,
  `existsUnique_subsheaf_generated_by_local_sections`;
- owner abstraction: the canonical generated subobject
  `subsheaf_generated_by_local_sections ℱ U s`, defined as the infimum of all subsheaves
  containing the prescribed local sections;
- primitive data: a family of opens `U i` together with sections `s i ∈ ℱ(U i)`;
- derived API: the containment predicate and the two atomic minimality theorems below.

Source/core/bridge triage:
- `source-facing`: the textbook phrase “the subsheaf generated by the local sections `s i`”;
- `core/canonical`: `subsheaf_generated_by_local_sections ℱ U s`;
- `bridge/view`: `subsheaf_contains_local_sections`,
  `subsheaf_generated_by_local_sections_contains_local_sections`, and
  `subsheaf_generated_by_local_sections_le`.
-/

namespace AlgebraicGeometry

variable {X : RingedSpace.{u}}
variable {I : Type u}
variable [LocallySmall (RingedSpace.Modules X)] [WellPowered (RingedSpace.Modules X)]

local notation "ModX" => RingedSpace.Modules X

/-- Definition 17.4.5: the subsheaf generated by the local sections `s i`. -/
noncomputable def subsheaf_generated_by_local_sections
    (ℱ : ModX) (U : I → Opens X) (s : ∀ i, ℱ.val.obj (op (U i))) :
    Subobject ℱ :=
  Subobject.sInf { G : Subobject ℱ | subsheaf_contains_local_sections ℱ U s G }

/-- Any least subsheaf containing the prescribed local sections is the generated subsheaf. -/
theorem subsheaf_generated_by_local_sections_eq_of_least
    (ℱ : ModX) (U : I → Opens X) (s : ∀ i, ℱ.val.obj (op (U i))) {G : Subobject ℱ}
    (hG : subsheaf_contains_local_sections ℱ U s G)
    (hleast : ∀ H : Subobject ℱ, subsheaf_contains_local_sections ℱ U s H → G ≤ H) :
    subsheaf_generated_by_local_sections ℱ U s = G := by
  refine le_antisymm ?_ ?_
  · simpa [subsheaf_generated_by_local_sections] using
      (Subobject.sInf_le { H : Subobject ℱ | subsheaf_contains_local_sections ℱ U s H } G hG)
  · simpa [subsheaf_generated_by_local_sections] using
      (Subobject.le_sInf { H : Subobject ℱ | subsheaf_contains_local_sections ℱ U s H } G
        fun H hH ↦ hleast H hH)

/-- The generated subsheaf contains the prescribed local sections. -/
theorem subsheaf_generated_by_local_sections_contains_local_sections
    (ℱ : ModX) (U : I → Opens X) (s : ∀ i, ℱ.val.obj (op (U i))) :
    subsheaf_contains_local_sections ℱ U s (subsheaf_generated_by_local_sections ℱ U s) := by
  obtain ⟨G, hG, hleast⟩ :=
    ExistsUnique.exists (existsUnique_subsheaf_generated_by_local_sections ℱ U s)
  have hgen : subsheaf_generated_by_local_sections ℱ U s = G :=
    subsheaf_generated_by_local_sections_eq_of_least ℱ U s hG hleast
  simpa [hgen] using hG

/-- The generated subsheaf is minimal among subsheaves containing the prescribed local sections. -/
theorem subsheaf_generated_by_local_sections_le
    (ℱ : ModX) (U : I → Opens X) (s : ∀ i, ℱ.val.obj (op (U i)))
    {G : Subobject ℱ} (hG : subsheaf_contains_local_sections ℱ U s G) :
    subsheaf_generated_by_local_sections ℱ U s ≤ G := by
  obtain ⟨G₀, hG₀, hleast⟩ :=
    ExistsUnique.exists (existsUnique_subsheaf_generated_by_local_sections ℱ U s)
  have hgen : subsheaf_generated_by_local_sections ℱ U s = G₀ :=
    subsheaf_generated_by_local_sections_eq_of_least ℱ U s hG₀ hleast
  simpa [hgen] using hleast G hG

end AlgebraicGeometry
