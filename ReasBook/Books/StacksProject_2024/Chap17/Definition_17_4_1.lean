open CategoryTheory
open AlgebraicGeometry
open Opposite
open TopologicalSpace

noncomputable section

universe u

/-
Domain-style sampling for global generation of sheaves of modules on a ringed space:
- inspected owner declarations:
  `RingedSpace.ringCatSheaf`,
  `RingedSpace.Modules`,
  `SheafOfModules.GeneratingSections`,
  `SheafOfModules.GeneratingSections.π`,
  `SheafOfModules.LocalGeneratorsData`
- owner abstractions:
  `RingedSpace.ringCatSheaf` for the coefficient sheaf and `RingedSpace.Modules` for the
  ambient module category,
  `SheafOfModules.GeneratingSections` for a generating family of global sections
- primitive data: an index type `I`, a family of global sections `s : I → ℱ.sections`, and the
  induced epimorphism `ℱ.freeHomEquiv.symm s`
- derived API: the associated morphism `GeneratingSections.π`, transport across epimorphisms via
  `GeneratingSections.ofEpi`, and the source-facing existential reformulation below

Layer triage:
- `source-facing`: the textbook phrase “generated by global sections”
- `core/canonical`: `ℱ.GeneratingSections`
- `bridge/view`: the explicit `∃ I, ∃ s, Epi (ℱ.freeHomEquiv.symm s)` reformulation below

The current file only needs the canonical owner and a thin source-facing bridge theorem. A separate
public predicate alias `IsGeneratedByGlobalSections` would duplicate the owner-level notion
`Nonempty ℱ.GeneratingSections` without adding mathematical content.
-/
namespace AlgebraicGeometry

variable {X : RingedSpace.{u}}

/-- The restriction of a morphism of `\mathcal O_X`-module sheaves to an open subset `U`. -/
noncomputable abbrev RingedSpace.moduleRestrictionMap
    {ℱ 𝒢 : (RingedSpace.Modules X)}
    (U : Opens X) (φ : ℱ ⟶ 𝒢) :
    ℱ.over U ⟶ 𝒢.over U :=
  (SheafOfModules.pushforward (𝟙 ((RingedSpace.ringCatSheaf X).over U))).map φ

scoped[ModuleRestriction] notation:max φ " |_ " U => RingedSpace.moduleRestrictionMap U φ

/-- The restriction of a morphism of `\mathcal O_U`-module sheaves along an inclusion
`V ⊆ U`. -/
noncomputable abbrev RingedSpace.moduleRestrictionMapLE
    {U V : Opens X} (hVU : V ≤ U)
    {ℱ 𝒢 : SheafOfModules ((RingedSpace.ringCatSheaf X).over U)}
    (φ : ℱ ⟶ 𝒢) :
    ℱ.over (Over.mk (homOfLE hVU)) ⟶ 𝒢.over (Over.mk (homOfLE hVU)) :=
  (SheafOfModules.pushforward
    (𝟙 (((RingedSpace.ringCatSheaf X).over U).over (Over.mk (homOfLE hVU))))).map φ

/-- The map on stalks induced by a morphism of `\mathcal O_X`-module sheaves. -/
noncomputable abbrev RingedSpace.moduleStalkMap
    {ℱ 𝒢 : (RingedSpace.Modules X)}
    (x : X) (φ : ℱ ⟶ 𝒢) :
    TopCat.Presheaf.stalk ℱ.val.presheaf x ⟶ TopCat.Presheaf.stalk 𝒢.val.presheaf x :=
  (TopCat.Presheaf.stalkFunctor AddCommGrpCat x).map
    ((PresheafOfModules.toPresheaf (RingedSpace.ringCatSheaf X).obj).map φ.val)

/-- The additive stalk map induced by a morphism of `\mathcal O_X`-modules preserves addition. -/
theorem RingedSpace.moduleStalkMap_map_add
    (x : X) {ℱ 𝒢 : (RingedSpace.Modules X)} (φ : ℱ ⟶ 𝒢)
    (m n : ↑(TopCat.Presheaf.stalk ℱ.val.presheaf x)) :
    RingedSpace.moduleStalkMap x φ (m + n) =
      RingedSpace.moduleStalkMap x φ m + RingedSpace.moduleStalkMap x φ n := by
  simpa using (RingedSpace.moduleStalkMap x φ).hom.map_add m n

/-- The stalk map induced by a morphism of `\mathcal O_X`-modules sends a germ to the germ of the
image section. -/
theorem RingedSpace.moduleStalkMap_germ
    {ℱ 𝒢 : (RingedSpace.Modules X)} (x : X) (φ : ℱ ⟶ 𝒢)
    (U : Opens X) (hx : x ∈ U) (s : ℱ.val.obj (op U)) :
    RingedSpace.moduleStalkMap x φ (TopCat.Presheaf.germ ℱ.val.presheaf U x hx s) =
      TopCat.Presheaf.germ 𝒢.val.presheaf U x hx ((φ.val.app (op U)) s) := by
  simpa [RingedSpace.moduleStalkMap] using
    (TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx
      ((PresheafOfModules.toPresheaf (RingedSpace.ringCatSheaf X).obj).map φ.val) s)

-- Proof sketch: represent scalars and elements by germs, use `PresheafOfModules.germ_smul`
-- together with functoriality of stalks, and pass to the colimit defining the stalk.
/-- The additive stalk map induced by a morphism of `\mathcal O_X`-modules is
`\mathcal O_{X, x}`-linear. -/
theorem RingedSpace.moduleStalkMap_map_smul
    (x : X) {ℱ 𝒢 : (RingedSpace.Modules X)} (φ : ℱ ⟶ 𝒢)
    (r : X.presheaf.stalk x)
    (m : ↑(RingedSpace.stalkModuleCat ℱ x)) :
    RingedSpace.moduleStalkMap x φ (r • m) =
      r • RingedSpace.moduleStalkMap x φ m := sorry

/-- The morphism on stalk modules induced by a morphism of `\mathcal O_X`-modules. -/
noncomputable def RingedSpace.moduleStalkHom
    (x : X) {ℱ 𝒢 : (RingedSpace.Modules X)} (φ : ℱ ⟶ 𝒢) :
    RingedSpace.stalkModuleCat ℱ x ⟶ RingedSpace.stalkModuleCat 𝒢 x :=
  ModuleCat.ofHom
    { toFun := RingedSpace.moduleStalkMap x φ
      map_add' := RingedSpace.moduleStalkMap_map_add x φ
      map_smul' := by
        intro r m
        simpa using RingedSpace.moduleStalkMap_map_smul x φ r m }

/-- The underlying additive stalk of the unit `\mathcal O_X`-module identifies with the additive
group of the stalk ring `\mathcal O_{X, x}`. -/
noncomputable abbrev RingedSpace.unitStalkAddIso (x : X) :
    TopCat.Presheaf.stalk (SheafOfModules.unit (RingedSpace.ringCatSheaf X)).val.presheaf x ≅
      (forget₂ CommRingCat RingCat.{u} ⋙ forget₂ RingCat AddCommGrpCat).obj
        (X.presheaf.stalk x) := by
  change TopCat.Presheaf.stalk
      (X.presheaf ⋙ forget₂ CommRingCat RingCat.{u} ⋙ forget₂ RingCat AddCommGrpCat) x ≅ _
  exact Limits.colimit.isoColimitCocone
    ⟨_, Limits.isColimitOfPreserves
      (forget₂ CommRingCat RingCat.{u} ⋙ forget₂ RingCat AddCommGrpCat)
      (Limits.colimit.isColimit ((OpenNhds.inclusion x).op ⋙ X.presheaf))⟩

-- Proof sketch: the additive stalk identification comes from forgetting ring structure along a
-- colimit-preserving functor, so it respects the canonical `\mathcal O_{X,x}`-scalar action on the
-- unit-module stalk.
private theorem RingedSpace.unitStalkLinearEquiv_map_smul (x : X)
    (r : X.presheaf.stalk x)
    (m : ↑(RingedSpace.stalkModuleCat (SheafOfModules.unit (RingedSpace.ringCatSheaf X)) x)) :
    (show ↑(X.presheaf.stalk x) from (RingedSpace.unitStalkAddIso x).hom (r • m)) =
      r • (show ↑(X.presheaf.stalk x) from (RingedSpace.unitStalkAddIso x).hom m) := sorry

/-- The stalk of the unit `\mathcal O_X`-module, identified linearly with the stalk ring
`\mathcal O_{X, x}`. -/
noncomputable def RingedSpace.unitStalkLinearEquiv (x : X) :
    ↑(RingedSpace.stalkModuleCat (SheafOfModules.unit (RingedSpace.ringCatSheaf X)) x) ≃ₗ[X.presheaf.stalk x]
      ↑(X.presheaf.stalk x) where
  __ := (RingedSpace.unitStalkAddIso x).addCommGroupIsoToAddEquiv
  map_smul' := RingedSpace.unitStalkLinearEquiv_map_smul x

/-- The canonical linear map from the stalk of the unit module sheaf to the stalk ring
`\mathcal O_{X, x}`. -/
noncomputable def RingedSpace.unitStalkLinearMap (x : X) :
    RingedSpace.stalkModuleCat (SheafOfModules.unit (RingedSpace.ringCatSheaf X)) x ⟶
      ModuleCat.of (X.presheaf.stalk x) ↑(X.presheaf.stalk x) :=
  ModuleCat.ofHom (RingedSpace.unitStalkLinearEquiv x).toLinearMap

end AlgebraicGeometry

namespace SheafOfModules

variable {X : RingedSpace.{u}}

-- Proof sketch: unfold `SheafOfModules.unit` on `(RingedSpace.ringCatSheaf X)`; sectionwise it is the free
-- rank-one module presheaf, whose underlying carrier is exactly `\mathcal O_X(U)`.
private theorem unit_obj_eq_ring_obj (U : Opens X) :
    (((SheafOfModules.unit ((RingedSpace.ringCatSheaf X))).val.obj (op U) :
        Type u)) =
      X.presheaf.obj (op U) := sorry

/-- A section of the unit `\mathcal O_X`-module sheaf, viewed as a section of the structure
sheaf. -/
abbrev unitSectionToRingSection (U : Opens X) :
    (SheafOfModules.unit ((RingedSpace.ringCatSheaf X))).val.obj (op U) →
      X.presheaf.obj (op U) :=
  Eq.mp (unit_obj_eq_ring_obj U)

/-- On germs, `RingedSpace.unitStalkLinearMap` agrees with the canonical identification of a local
section of the unit module with the corresponding section of the structure sheaf. -/
theorem unitStalkLinearMap_germ
    (x : X) (U : Opens X) (hx : x ∈ U)
    (s : (SheafOfModules.unit (RingedSpace.ringCatSheaf X)).val.obj (op U)) :
    RingedSpace.unitStalkLinearMap x
        (TopCat.Presheaf.germ (SheafOfModules.unit (RingedSpace.ringCatSheaf X)).val.presheaf U x hx s) =
      X.presheaf.germ U x hx (unitSectionToRingSection U s) := sorry

/- Definition 17.4.1: the canonical owner for a generating family of global sections of an
`\mathcal O_X`-module is `ℱ.GeneratingSections`; existence of such a family is the source
condition that `ℱ` is generated by global sections. -/
recall SheafOfModules.GeneratingSections

/- Companion recall: `GeneratingSections.π` is the canonical morphism from the free sheaf on the
chosen generators. -/
recall SheafOfModules.GeneratingSections.π

/-- Definition 17.4.1: an `\mathcal O_X`-module is generated by global sections if and only if
there exists an index type and a family of global sections whose associated morphism from the free
module sheaf is an epimorphism. This is the source-facing bridge from the textbook wording to the
canonical owner `ℱ.GeneratingSections`. -/
theorem nonempty_generatingSections_iff_exists_generating_family
    (ℱ : (RingedSpace.Modules X)) :
    Nonempty ℱ.GeneratingSections ↔
      ∃ (I : Type u) (s : I → ℱ.sections), Epi ((ℱ.freeHomEquiv).symm s) := by
  constructor
  · rintro ⟨σ⟩
    exact ⟨σ.I, σ.s, σ.epi⟩
  · rintro ⟨I, s, hs⟩
    exact ⟨{ I := I, s := s, epi := hs }⟩

end SheafOfModules
