namespace AlgebraicGeometry.RingedSpace

section

variable {X : RingedSpace.{u}} {𝓑 : Set (Opens X.carrier)}

-- Proof sketch: the owner functors `derivedRestrictionBetweenOpens` from Lemma `20.45.7` are
-- obtained by transport along the same nested-open identification, so iterated restriction agrees
-- with direct restriction after extensionality on objects.
/-- Derived restriction functors compose for nested inclusions of open subsets. -/
theorem derivedRestrictionBetweenOpens_comp_eq
    {W V U : Opens X.carrier} (hWV : W ≤ V) (hVU : V ≤ U) :
    derivedRestrictionBetweenOpens X hVU ⋙ derivedRestrictionBetweenOpens X hWV =
      derivedRestrictionBetweenOpens X (hWV.trans hVU) := sorry

/-- The canonical isomorphism identifying two-step derived restriction with direct restriction. -/
noncomputable def derivedRestrictionBetweenOpensCompIso
    {W V U : Opens X.carrier} (hWV : W ≤ V) (hVU : V ≤ U) :
    derivedRestrictionBetweenOpens X hVU ⋙ derivedRestrictionBetweenOpens X hWV ≅
      derivedRestrictionBetweenOpens X (hWV.trans hVU) :=
  eqToIso (derivedRestrictionBetweenOpens_comp_eq hWV hVU)

-- Proof sketch: the Chapter 6 restriction functors from `X` to `V` and from `X` to `U`
-- followed by restriction from `U` to `V` agree on the nose. Passing to derived categories yields
-- the same identity.
/-- Restricting a global derived `\mathcal O_X`-module first to `U` and then to `V ⊆ U` agrees
with restricting directly to `V`. -/
theorem moduleRestrictionToOpenDerived_comp_eq
    {V U : Opens X.carrier} (hVU : V ≤ U) :
    moduleRestrictionToOpenDerived X U ⋙ derivedRestrictionBetweenOpens X hVU =
      moduleRestrictionToOpenDerived X V := sorry

/-- The canonical comparison identifying two-step restriction of a global derived object with the
direct restriction to the smaller open subset. -/
noncomputable def moduleRestrictionToOpenDerivedCompIso
    {V U : Opens X.carrier} (hVU : V ≤ U) :
    moduleRestrictionToOpenDerived X U ⋙ derivedRestrictionBetweenOpens X hVU ≅
      moduleRestrictionToOpenDerived X V :=
  eqToIso (moduleRestrictionToOpenDerived_comp_eq hVU)

/-- The basis opens in `𝓑` cover the whole space `X`. -/
abbrev BasisCoversSpace (X : RingedSpace.{u}) (𝓑 : Set (Opens X.carrier)) : Prop :=
  sSup 𝓑 = ⊤

/-- Any pairwise intersection of basis opens is generated by the basis members contained in that
intersection. -/
abbrev BasisIntersectionsGenerated
    (X : RingedSpace.{u}) (𝓑 : Set (Opens X.carrier)) : Prop :=
  ∀ ⦃U V : Opens X.carrier⦄, U ∈ 𝓑 → V ∈ 𝓑 →
    U ⊓ V = sSup {W : Opens X.carrier | W ∈ 𝓑 ∧ W ≤ U ⊓ V}

/-- Situation 20.45.3: a family of local derived objects on the opens of `𝓑`, together with
restriction isomorphisms satisfying the cocycle condition on triple inclusions. -/
structure OpenFamilyDerivedGluing
    (X : RingedSpace.{u}) (𝓑 : Set (Opens X.carrier)) where
  /-- The derived object attached to a basis open `U ∈ 𝓑`. -/
  obj : ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 → moduleDerivedOnOpen X U
  /-- The restriction isomorphism `K_U|_V ≅ K_V` for an inclusion `V ⊆ U` in the basis. -/
  ρ :
    ∀ ⦃U V : Opens X.carrier⦄
      (hU : U ∈ 𝓑) (hV : V ∈ 𝓑) (hVU : V ≤ U),
      (derivedRestrictionBetweenOpens X hVU).obj (obj hU) ≅ obj hV
  /-- The restriction isomorphisms satisfy the cocycle condition on triple inclusions. -/
  ρ_comp :
    ∀ ⦃U V W : Opens X.carrier⦄
      (hU : U ∈ 𝓑) (hV : V ∈ 𝓑) (hW : W ∈ 𝓑)
      (hWV : W ≤ V) (hVU : V ≤ U),
      (derivedRestrictionBetweenOpensCompIso (X := X) hWV hVU).app (obj hU) ≪≫
          ρ hU hW (hWV.trans hVU) =
        (Functor.mapIso (derivedRestrictionBetweenOpens X hWV) (ρ hU hV hVU)) ≪≫
          ρ hV hW hWV

namespace OpenFamilyDerivedGluing

/-- The local derived objects of a gluing system have vanishing negative self-Ext groups on the
basis opens. -/
abbrev NegativeSelfExtVanishing
    (glue : OpenFamilyDerivedGluing X 𝓑) : Prop :=
  ∀ ⦃U : Opens X.carrier⦄ (hU : U ∈ 𝓑) (i : ℤ), i < 0 →
    Subsingleton
      (glue.obj hU ⟶ (shiftFunctor (moduleDerivedOnOpen X U) i).obj (glue.obj hU))

/-- A global realization of a local derived gluing datum is an ambient object
`K ∈ D(\mathcal O_X)` together with compatible identifications of its restrictions to the basis
opens with the prescribed local objects. -/
structure GlobalSolution (glue : OpenFamilyDerivedGluing X 𝓑) where
  /-- The ambient derived object on the whole ringed space `X`. -/
  obj : DerivedCategory (RingedSpace.Modules X)
  /-- The identification of the restriction of the global object to a basis open with the
  prescribed local object. -/
  iso :
    ∀ ⦃U : Opens X.carrier⦄, (hU : U ∈ 𝓑) →
      (moduleRestrictionToOpenDerived X U).obj obj ≅ glue.obj hU
  /-- The restriction identifications are compatible with the transition maps of the gluing datum
  on inclusions `V ⊆ U` inside the basis. -/
  iso_comp :
    ∀ ⦃U V : Opens X.carrier⦄
      (hU : U ∈ 𝓑) (hV : V ∈ 𝓑) (hVU : V ≤ U),
      ((moduleRestrictionToOpenDerivedCompIso hVU).app obj).symm ≪≫
          (derivedRestrictionBetweenOpens X hVU).mapIso (iso hU) ≪≫
            glue.ρ hU hV hVU =
        iso hV

end OpenFamilyDerivedGluing

end

end AlgebraicGeometry.RingedSpace
