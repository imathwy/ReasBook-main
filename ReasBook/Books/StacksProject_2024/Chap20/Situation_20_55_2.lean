import Mathlib
import StacksProject_2024.Chap20.Definition_20_46_1

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open CategoryTheory
open TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace

variable {X : RingedSpace.{u}}
variable {ℐ : (RingedSpace.Modules X)}

/-- The restriction to an open subset of a morphism from an `\mathcal O_X`-module to the
structure sheaf. -/
abbrev restricted_structure_sheaf_map
    (ι : ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X)) (U : Opens X) :
    ℐ.over U ⟶ (SheafOfModules.unit (RingedSpace.ringCatSheaf X)).over U :=
  (SheafOfModules.pushforward (𝟙 ((RingedSpace.ringCatSheaf X).over U))).map ι

/-- The local condition appearing in Lemma `20.55.1 (1)`: around each point, the ideal sheaf
inclusion is identified with multiplication by a monomorphism of the restricted structure sheaf. -/
def satisfies_locally_principal_regular_ideal_condition
    (ι : ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X)) : Prop :=
  ∀ x : X, ∃ (U : Opens X) (_ : x ∈ U)
    (e : ℐ.over U ≅ (SheafOfModules.unit (RingedSpace.ringCatSheaf X)).over U)
    (μ : (SheafOfModules.unit (RingedSpace.ringCatSheaf X)).over U ⟶
      (SheafOfModules.unit (RingedSpace.ringCatSheaf X)).over U),
      Mono μ ∧ e.hom ≫ μ = restricted_structure_sheaf_map ι U

/-- Situation 20.55.2: a sheaf of ideals `\mathcal I \subset \mathcal O_X` on a ringed space
`(X, \mathcal O_X)` satisfying condition (1) of Lemma `20.55.1`, namely that the inclusion
`ι : \mathcal I \to \mathcal O_X` is locally principal and generated by a regular local
section. -/
class locally_principal_regular_ideal_situation
    (ℐ : (RingedSpace.Modules X))
    (ι : outParam (ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X))) : Prop
    extends Mono ι where
  /-- The ideal sheaf inclusion satisfies the local principal regularity condition from
  Lemma `20.55.1 (1)`. -/
  condition : satisfies_locally_principal_regular_ideal_condition ι

/-- A monomorphism into the structure sheaf satisfying
`satisfies_locally_principal_regular_ideal_condition` gives the corresponding setup. -/
instance locally_principal_regular_ideal_situation_of_fact
    (ι : ℐ ⟶ SheafOfModules.unit (RingedSpace.ringCatSheaf X))
    [Mono ι] [h : Fact (satisfies_locally_principal_regular_ideal_condition ι)] :
    locally_principal_regular_ideal_situation ℐ ι where
  toMono := inferInstance
  condition := h.out

end AlgebraicGeometry.RingedSpace
