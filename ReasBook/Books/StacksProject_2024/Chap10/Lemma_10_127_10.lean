/-- Helper for Lemma 10.127.10: the target-stage inclusion does not change the pulled-back maximal
ideal. This is the target-side localization hypothesis for the fixed-generator system. -/
private theorem fixed_target_stage_comap_maximal_eq (Γ : Finset S) {A B : Finset R}
    (hAB : A ⊆ B) :
    Ideal.comap (fixedTargetRawStageInclusion (f := f) Γ hAB)
      (fixedTargetStagePrime (f := f) Γ B) =
        fixedTargetStagePrime (f := f) Γ A := by
  -- Route correction: same kernel-timeout avoidance as on the source side.
  ext x
  simp only [Ideal.mem_comap, Subalgebra.coe_val, fixedTargetRawStageInclusion_coe]

/-- Helper for Lemma 10.127.10: the fixed raw stage map pulls back the target maximal ideal to
the source maximal ideal, so it can be localized stagewise. -/
private theorem fixed_stage_zero_map_comap_maximal_eq (Γ : Finset S) (A : Finset R) :
    Ideal.comap (fixedRawStageMap (f := f) Γ A)
      (fixedTargetStagePrime (f := f) Γ A) =
        fixedSourceStagePrime A := by
  -- Proof comment: reduce pointwise to the maximal-ideal pullback formula for local homomorphisms.
  ext x
  change fixedRawStageMap (f := f) Γ A x ∈ fixedTargetStagePrime (f := f) Γ A ↔
      x ∈ fixedSourceStagePrime A
  change f (x : R) ∈ IsLocalRing.maximalIdeal S ↔ (x : R) ∈ IsLocalRing.maximalIdeal R
  have hmax :
      ((x : R) ∈ Ideal.comap f (IsLocalRing.maximalIdeal S)) =
        ((x : R) ∈ IsLocalRing.maximalIdeal R) :=
    congrArg (fun I : Ideal R => (x : R) ∈ I) (IsLocalRing.maximalIdeal_comap (f := f))
  simpa [Ideal.mem_comap] using hmax

/-- Helper for Lemma 10.127.10: enlarging the source coefficient set induces the localized source
transition map. -/
private noncomputable def fixedSourceLocalizedTransition {A B : Finset R} (hAB : A ⊆ B) :
    fixedSourceLocalizedStage A →+* fixedSourceLocalizedStage B :=
  Localization.localRingHom
    (fixedSourceStagePrime A)
    (fixedSourceStagePrime B)
    (fixedSourceRawStageInclusion hAB)
    (fixed_source_stage_comap_maximal_eq hAB).symm

/-- Helper for Lemma 10.127.10: enlarging the source coefficient set induces the localized target
transition map while keeping the fixed generators `Γ`. -/
private noncomputable def fixedTargetLocalizedTransition (Γ : Finset S) {A B : Finset R}
    (hAB : A ⊆ B) :
    fixedTargetLocalizedStage (f := f) Γ A →+* fixedTargetLocalizedStage (f := f) Γ B :=
  Localization.localRingHom
    (fixedTargetStagePrime (f := f) Γ A)
    (fixedTargetStagePrime (f := f) Γ B)
    (fixedTargetRawStageInclusion (f := f) Γ hAB)
    (fixed_target_stage_comap_maximal_eq (f := f) Γ hAB).symm

/-- Helper for Lemma 10.127.10: the localized stage map attached to one fixed-generator stage. -/
private noncomputable def fixedLocalizedStageMap (Γ : Finset S) (A : Finset R) :
    fixedSourceLocalizedStage A →+* fixedTargetLocalizedStage (f := f) Γ A :=
  Localization.localRingHom
    (fixedSourceStagePrime A)
    (fixedTargetStagePrime (f := f) Γ A)
    (fixedRawStageMap (f := f) Γ A)
    (fixed_stage_zero_map_comap_maximal_eq (f := f) Γ A).symm

/-- Helper for Lemma 10.127.10: the localized source transition is the identity on a fixed stage.
-/
private theorem fixed_source_localized_transition_id (A : Finset R) :
    fixedSourceLocalizedTransition (A := A) (B := A) (Finset.Subset.refl _) = RingHom.id _ := by
  have hincl :
      (fixedSourceRawStageInclusion (A := A) (B := A) (Finset.Subset.refl _)) =
        RingHom.id _ := by
    ext x
    simp only [RingHom.id_apply, fixedSourceRawStageInclusion_coe]
  -- Proof comment: this is the canonical identity statement for `Localization.localRingHom`.
  simpa [fixedSourceLocalizedTransition, hincl] using
    (Localization.localRingHom_id
      (R := fixedSourceRawStage A) (I := fixedSourceStagePrime A))

