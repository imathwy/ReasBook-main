/-- Helper for Lemma 10.127.10: the localized stage map sends a raw source-stage generator to its
image in the localized target stage. -/
private theorem fixed_localizedStageMap_to_map (Γ : Finset S) (A : Finset R)
    (x : fixedSourceRawStage A) :
    fixedLocalizedStageMap (f := f) Γ A (algebraMap _ _ x) =
      algebraMap _ _ (fixedRawStageMap (f := f) Γ A x) := by
  simpa [fixedLocalizedStageMap] using
    (Localization.localRingHom_to_map
      (I := fixedSourceStagePrime A)
      (J := fixedTargetStagePrime (f := f) Γ A)
