/-- Helper for Lemma 10.127.10: the raw source-target square commutes before localization for the
fixed-generator stages. -/
private theorem fixed_raw_stage_square_apply (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B)
    (x : fixedSourceRawStage A) :
    fixedRawStageMap (f := f) Γ B (fixedSourceRawStageInclusion hAB x) =
      fixedTargetRawStageInclusion (f := f) Γ hAB (fixedRawStageMap (f := f) Γ A x) := by
  -- Route correction: state the square inside the target stage and rewrite both ambient values
  -- to `f ↑x` with the named coercion lemmas; this keeps every step propositional.
  refine Subtype.ext ?_
  rw [fixedRawStageMap_coe, fixedSourceRawStageInclusion_coe, fixedTargetRawStageInclusion_coe,
    fixedRawStageMap_coe]

/-- Helper for Lemma 10.127.10: the localized stage maps commute with localized transitions in the
fixed-generator system. -/
private theorem fixed_localized_stage_square_commutes (Γ : Finset S) {A B : Finset R}
    (hAB : A ⊆ B) :
    (fixedLocalizedStageMap (f := f) Γ B).comp
        (fixedSourceLocalizedTransition hAB) =
      (fixedTargetLocalizedTransition (f := f) Γ hAB).comp
        (fixedLocalizedStageMap (f := f) Γ A) := by
  -- Route correction: instead of comparing two `Localization.localRingHom` presentations of the
  -- square, check it directly on the localization generators and rewrite both composites to the
  -- same raw-stage image.
  refine IsLocalization.ringHom_ext (fixedSourceStagePrime A).primeCompl ?_
  ext x
  simp only [RingHom.comp_apply]
  rw [fixed_source_localized_transition_to_map]
  rw [fixed_localizedStageMap_to_map (f := f) Γ B (fixedSourceRawStageInclusion hAB x)]
  rw [fixed_localizedStageMap_to_map (f := f) Γ A x]
  rw [fixed_target_localized_transition_to_map (f := f) Γ hAB (fixedRawStageMap (f := f) Γ A x)]
  exact congrArg (algebraMap _ _) (fixed_raw_stage_square_apply (f := f) Γ hAB x)

/-- Helper for Lemma 10.127.10: the canonical map from a localized fixed-generator source stage
back to the ambient local ring `R`. -/
private noncomputable abbrev fixedSourceLocalizedToAmbient (A : Finset R) :
    fixedSourceLocalizedStage A →+* R :=
  localizationAtComapMaximalToAmbient
    (A := fixedSourceRawStage A) (B := R)
    (fixedSourceRawStage A).val.toRingHom

/-- Helper for Lemma 10.127.10: the ambient comparison map from a localized fixed-generator source
stage sends a raw-stage generator to its ambient value in `R`. -/
private theorem fixed_source_localized_to_ambient_to_map (A : Finset R)
    (x : fixedSourceRawStage A) :
    fixedSourceLocalizedToAmbient A (algebraMap _ _ x) = (x : R) := by
  -- Proof comment: this is the source-side specialization of the general localization formula.
  exact
    localizationAtComapMaximalToAmbient_to_map
      (g := (fixedSourceRawStage A).val.toRingHom) x

/-- Helper for Lemma 10.127.10: the ambient source comparison maps are compatible with localized
source transitions. -/
private theorem fixed_source_localized_to_ambient_comp {A B : Finset R} (hAB : A ⊆ B) :
    (fixedSourceLocalizedToAmbient B).comp
        (fixedSourceLocalizedTransition hAB) =
      fixedSourceLocalizedToAmbient A := by
  -- Proof comment: both comparison maps agree on the raw generators of the source localization.
  refine IsLocalization.ringHom_ext (fixedSourceStagePrime A).primeCompl ?_
  ext x
  simp only [RingHom.comp_apply]
  rw [fixed_source_localized_transition_to_map, fixed_source_localized_to_ambient_to_map,
    fixed_source_localized_to_ambient_to_map]
  exact fixedSourceRawStageInclusion_coe hAB x

