/-- Helper for Lemma 10.127.10: the compatible ambient source-stage maps induce the comparison map
from the source direct limit to `R` for the fixed-generator system. -/
private noncomputable def fixedSourceColimitToAmbient :
    Ring.DirectLimit
        (fun A : Finset R ↦ fixedSourceLocalizedStage A)
        (fun _ _ hAB ↦ fixedSourceLocalizedTransition hAB) →+* R :=
  Ring.DirectLimit.lift
    (fun A : Finset R ↦ fixedSourceLocalizedStage A)
    (fun _ _ hAB ↦ fixedSourceLocalizedTransition hAB)
    R
    (fun A ↦ fixedSourceLocalizedToAmbient A)
    (fun A B hAB x ↦ by
      simpa [RingHom.comp_apply] using
        congrArg (fun g => g x)
          (fixed_source_localized_to_ambient_comp (A := A) (B := B) hAB))

/-- Helper for Lemma 10.127.10: the compatible ambient target-stage maps induce the comparison map
from the target direct limit to `S` for the fixed-generator system. -/
private noncomputable def fixedTargetColimitToAmbient (Γ : Finset S) :
    Ring.DirectLimit
        (fun A : Finset R ↦ fixedTargetLocalizedStage (f := f) Γ A)
        (fun _ _ hAB ↦ fixedTargetLocalizedTransition (f := f) Γ hAB) →+* S :=
  Ring.DirectLimit.lift
    (fun A : Finset R ↦ fixedTargetLocalizedStage (f := f) Γ A)
    (fun _ _ hAB ↦ fixedTargetLocalizedTransition (f := f) Γ hAB)
    S
    (fun A ↦ fixedTargetLocalizedToAmbient (f := f) Γ A)
    (fun A B hAB x ↦ by
      simpa [RingHom.comp_apply] using
        congrArg (fun g => g x)
          (fixed_target_localized_to_ambient_comp (f := f) Γ (A := A) (B := B) hAB))

/-- Helper for Lemma 10.127.10: the source direct-limit comparison map is bijective because every
source element already occurs at a singleton stage and every stage map is injective. -/
private theorem fixed_source_colimit_comparison_bijective :
    Function.Bijective ⇑(fixedSourceColimitToAmbient (R := R)) := by
  -- Proof comment: combine stagewise injectivity with the singleton-stage cover.
  exact Ring.DirectLimit.lift_bijective_of_stagewise_injective_cover
    (A := fun A : Finset R ↦ fixedSourceLocalizedStage A)
    (map := fun _ _ hAB ↦ fixedSourceLocalizedTransition hAB)
    (B := R)
    (g := fun A ↦ fixedSourceLocalizedToAmbient A)
    (hg := fun A B hAB x ↦ by
      simpa [RingHom.comp_apply] using
        congrArg (fun g => g x)
          (fixed_source_localized_to_ambient_comp (A := A) (B := B) hAB))
    (hinj := fun A ↦ fixedSourceLocalizedToAmbient_injective A)
    (hcover := fun r ↦ fixed_source_localized_stage_cover r)

