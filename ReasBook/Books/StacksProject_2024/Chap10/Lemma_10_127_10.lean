open scoped TensorProduct

universe u v

section

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]
variable [IsLocalRing R] [IsLocalRing S]

/-
Domain sampling:
* Primary domain: directed approximation systems for local ring homomorphisms in commutative
  algebra.
* Owner declarations inspected in this domain:
  - `RingHom.EssFiniteType`
  - `DirectedRingColimit`
  - `DirectedLocalHomApproximation`
  - `DirectedLocalHomApproximation.targetStageBaseChange`
  - `DirectedLocalHomApproximation.stageBaseChangeMap`
* Best owner abstractions:
  - source-facing approximation owner: `DirectedLocalHomApproximation f`
  - essentially finite type owner: `RingHom.EssFiniteType`
* Primitive vs. derived: the stage rings, local transition maps, colimit identifications, and
  essential finite type hypotheses already belong to the owner abstraction from
  `Lemma_10_127_9`; this lemma adds only the transition property that those canonical base-change
  maps are localizations of quotients.
-/

namespace DirectedLocalHomApproximation

/-- The transition maps in a directed local approximation present each later target stage as a
localization of a quotient of the corresponding base change from an earlier stage. -/
def HasLocalizationOfQuotientTransitions {f : R →+* S}
    (A : DirectedLocalHomApproximation f) : Prop :=
  ∀ {i j : A.Λ} (h : i ≤ j), RingHom.IsLocalizationOfQuotient (A.stageBaseChangeMap h)

end DirectedLocalHomApproximation

variable (f : R →+* S) [IsLocalHom f]

omit [IsLocalRing R] [IsLocalRing S] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: the canonical finite-type witness subalgebra of an essentially
finite type map is generated by finitely many target elements chosen once and for all. -/
private theorem exists_fixed_generator_finset_for_essFiniteType_witness (hf : f.EssFiniteType) :
    letI := f.toAlgebra
    haveI : Algebra.EssFiniteType R S := hf
    ∃ Γ : Finset S,
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S := by
  letI := f.toAlgebra
  -- Proof comment: `f.EssFiniteType` is by definition the algebra-level instance for `f.toAlgebra`.
  haveI : Algebra.EssFiniteType R S := hf
  change ∃ Γ : Finset S,
    Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S
  let B₀ : Subalgebra R S := Algebra.EssFiniteType.subalgebra R S
  have hfg : B₀.FG := (Subalgebra.fg_iff_finiteType B₀).mpr inferInstance
  rcases Subalgebra.fg_def.mp hfg with ⟨t, htfin, htB⟩
  -- Proof comment: convert the finite generating set from `Set S` to a `Finset S`.
  refine ⟨htfin.toFinset, ?_⟩
  simpa using htB

/-- Helper for Lemma 10.127.10: the raw source stage attached to a finite subset of `R` is the
`ℤ`-subalgebra generated by that subset. -/
private noncomputable abbrev fixedSourceRawStage (A : Finset R) : Subalgebra ℤ R :=
  Algebra.adjoin ℤ (↑A : Set R)

/-- Helper for Lemma 10.127.10: the raw target stage attached to a finite subset of `R` is the
`ℤ`-subalgebra generated by the images of that subset together with one fixed finite generator set
for the essential-finite-type witness subalgebra. -/
private noncomputable abbrev fixedTargetRawStage (Γ : Finset S) (A : Finset R) : Subalgebra ℤ S :=
  Algebra.adjoin ℤ (f '' (↑A : Set R) ∪ (↑Γ : Set S))

omit [IsLocalRing R] in
/-- Helper for Lemma 10.127.10: enlarging the source coefficient set enlarges the corresponding
raw source stage. -/
private theorem fixed_sourceRawStage_mono {A B : Finset R} (hAB : A ⊆ B) :
    fixedSourceRawStage A ≤ fixedSourceRawStage B := by
  -- Proof comment: later stages adjoin every earlier source coefficient.
  exact Algebra.adjoin_le_iff.2 fun r hr ↦ Algebra.subset_adjoin (hAB hr)

/-- Helper for Lemma 10.127.10: the corresponding source raw-stage inclusion ring map. -/
private noncomputable def fixedSourceRawStageInclusion {A B : Finset R} (hAB : A ⊆ B) :
    fixedSourceRawStage A →+* fixedSourceRawStage B :=
  Subalgebra.inclusion (fixed_sourceRawStage_mono hAB)

omit [IsLocalRing R] [IsLocalRing S] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: enlarging the source coefficient set enlarges the corresponding
raw target stage while keeping the fixed generators unchanged. -/
private theorem fixed_targetRawStage_mono (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B) :
    fixedTargetRawStage (f := f) Γ A ≤ fixedTargetRawStage (f := f) Γ B := by
  -- Proof comment: the only new raw target generators come from additional source coefficients.
  refine Algebra.adjoin_le_iff.2 ?_
  intro s hs
  rcases (Set.mem_union _ _ _).mp hs with hs | hs
  · rcases hs with ⟨r, hr, rfl⟩
    exact Algebra.subset_adjoin <| (Set.mem_union _ _ _).mpr <| Or.inl ⟨r, hAB hr, rfl⟩
  · exact Algebra.subset_adjoin <| (Set.mem_union _ _ _).mpr <| Or.inr hs

/-- Helper for Lemma 10.127.10: the corresponding target raw-stage inclusion algebra map. -/
private noncomputable def fixedTargetRawStageInclusion (Γ : Finset S) {A B : Finset R}
    (hAB : A ⊆ B) :
    fixedTargetRawStage (f := f) Γ A →+* fixedTargetRawStage (f := f) Γ B :=
  Subalgebra.inclusion (fixed_targetRawStage_mono (f := f) Γ hAB)

omit [IsLocalRing R] in
/-- Helper for Lemma 10.127.10: the raw source-stage inclusion does not change ambient values. -/
private theorem fixedSourceRawStageInclusion_coe {A B : Finset R} (hAB : A ⊆ B)
    (x : fixedSourceRawStage A) :
    (fixedSourceRawStageInclusion hAB x : R) = ↑x := by
  unfold fixedSourceRawStageInclusion
  rw [AlgHom.coe_toRingHom, Subalgebra.coe_inclusion]

omit [IsLocalRing R] [IsLocalRing S] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: the raw target-stage inclusion does not change ambient values. -/
private theorem fixedTargetRawStageInclusion_coe (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B)
    (x : fixedTargetRawStage (f := f) Γ A) :
    (fixedTargetRawStageInclusion (f := f) Γ hAB x : S) = ↑x := by
  unfold fixedTargetRawStageInclusion
  rw [AlgHom.coe_toRingHom, Subalgebra.coe_inclusion]

omit [IsLocalRing R] [IsLocalRing S] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: every element of a raw source stage maps into the corresponding
raw target stage. -/
private theorem fixed_source_stage_image_le_target_stage (Γ : Finset S) (A : Finset R) :
    ∀ x : fixedSourceRawStage A, f (x : R) ∈ fixedTargetRawStage (f := f) Γ A := by
  intro x
  -- Proof comment: the source generators map into the target generators, and the target stage is
  -- closed under the ring operations.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ x.property
  · intro r hr
    exact Algebra.subset_adjoin <| (Set.mem_union _ _ _).mpr <| Or.inl ⟨r, hr, rfl⟩
  · intro z
    simpa using (fixedTargetRawStage (f := f) Γ A).algebraMap_mem z
  · intro y z _ _ hy hz
    simpa [map_add] using (fixedTargetRawStage (f := f) Γ A).add_mem hy hz
  · intro y z _ _ hy hz
    simpa [map_mul] using (fixedTargetRawStage (f := f) Γ A).mul_mem hy hz

/-- Helper for Lemma 10.127.10: the ambient map `f` restricts to the fixed raw stages. -/
private noncomputable def fixedRawStageMap (Γ : Finset S) (A : Finset R) :
    fixedSourceRawStage A →+* fixedTargetRawStage (f := f) Γ A :=
  (f.comp (fixedSourceRawStage A).val.toRingHom).codRestrict _
    (fixed_source_stage_image_le_target_stage (f := f) Γ A)

omit [IsLocalRing R] [IsLocalRing S] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: the restricted raw stage map still agrees with the ambient map on
the underlying source-stage element. -/
private theorem fixedRawStageMap_coe (Γ : Finset S) (A : Finset R)
    (x : fixedSourceRawStage A) :
    ((fixedRawStageMap (f := f) Γ A x : fixedTargetRawStage (f := f) Γ A) : S) = f x := by
  rfl

omit [IsLocalRing R] [IsLocalRing S] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: every element of the essential-finite-type witness subalgebra is
already contained in one fixed-generator raw target stage. -/
private theorem exists_raw_fixed_generator_stage_of_witness_element {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S)
    (b : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.EssFiniteType.subalgebra R S) :
    ∃ A : Finset R, ∃ x : fixedTargetRawStage (f := f) Γ A, (x : S) = b := by
  classical
  letI := f.toAlgebra
  haveI : Algebra.EssFiniteType R S := hf
  have hΓ : Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S := hΓ
  have hdesc :
      ∀ s ∈ Algebra.adjoin R (↑Γ : Set S),
        ∃ A : Finset R, ∃ x : fixedTargetRawStage (f := f) Γ A, (x : S) = s := by
    intro s hs
    -- Proof comment: induct on the expression of `s` inside the fixed finite `R`-adjoin.
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hs
    · intro γ hγ
      refine ⟨∅, ⟨γ, ?_⟩, rfl⟩
      exact Algebra.subset_adjoin <| (Set.mem_union _ _ _).mpr <| Or.inr hγ
    · intro r
      refine ⟨{r}, fixedRawStageMap (f := f) Γ {r} ⟨r, Algebra.subset_adjoin (by simp)⟩, ?_⟩
      -- Proof comment: the singleton coefficient stage already contains the base-ring element.
      simpa using fixedRawStageMap_coe (f := f) Γ ({r} : Finset R)
        ⟨r, Algebra.subset_adjoin (by simp)⟩
    · intro x y _ _ hx hy
      rcases hx with ⟨Ax, xStage, rfl⟩
      rcases hy with ⟨Ay, yStage, rfl⟩
      refine ⟨Ax ∪ Ay,
        fixedTargetRawStageInclusion (f := f) Γ
            (show Ax ⊆ Ax ∪ Ay by intro a ha; exact Finset.mem_union.mpr <| Or.inl ha) xStage +
          fixedTargetRawStageInclusion (f := f) Γ
            (show Ay ⊆ Ax ∪ Ay by intro a ha; exact Finset.mem_union.mpr <| Or.inr ha) yStage,
        ?_⟩
      -- Route correction: avoid a subtype-level `rfl` (kernel timeout); rewrite the coercions
      -- propositionally instead.
      simp only [Subalgebra.coe_add, fixedTargetRawStageInclusion_coe]
    · intro x y _ _ hx hy
      rcases hx with ⟨Ax, xStage, rfl⟩
      rcases hy with ⟨Ay, yStage, rfl⟩
      refine ⟨Ax ∪ Ay,
        fixedTargetRawStageInclusion (f := f) Γ
            (show Ax ⊆ Ax ∪ Ay by intro a ha; exact Finset.mem_union.mpr <| Or.inl ha) xStage *
          fixedTargetRawStageInclusion (f := f) Γ
            (show Ay ⊆ Ax ∪ Ay by intro a ha; exact Finset.mem_union.mpr <| Or.inr ha) yStage,
        ?_⟩
      -- Route correction: avoid a subtype-level `rfl` (kernel timeout); rewrite the coercions
      -- propositionally instead.
      simp only [Subalgebra.coe_mul, fixedTargetRawStageInclusion_coe]
  have hb : (b : S) ∈ Algebra.adjoin R (↑Γ : Set S) := by
    -- Proof comment: rewrite the witness subalgebra using the chosen fixed generators.
    simpa [hΓ] using b.property
  simpa using hdesc b hb

section FixedGeneratorLocalizedStages

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [IsLocalRing B]

/-- Helper for Lemma 10.127.10: the image of an element outside the pulled-back maximal ideal is a
unit in the ambient local ring. -/
private theorem map_comap_maximal_primeCompl_le_units (g : A →+* B) :
    Submonoid.map g (Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl ≤ IsUnit.submonoid B :=
    by
  intro y hy
  rcases hy with ⟨x, hx, rfl⟩
  -- Proof comment: elements outside the pulled-back maximal ideal map to units in the ambient
  -- local ring.
  exact
    (IsLocalRing.notMem_maximalIdeal).mp <|
      by simpa [Ideal.primeCompl, Ideal.mem_comap] using hx

/-- Helper for Lemma 10.127.10: localizing at the contraction of the ambient maximal ideal maps
canonically to the ambient local ring. -/
private noncomputable def localizationAtComapMaximalToAmbient (g : A →+* B) :
    Localization.AtPrime (Ideal.comap g (IsLocalRing.maximalIdeal B)) →+* B :=
  let imageLocalization :
      Localization.AtPrime (Ideal.comap g (IsLocalRing.maximalIdeal B)) →+*
        Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g) :=
    IsLocalization.map
      (Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g))
      g
      (Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.le_comap_map
  let collapseUnits :
      Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g) →+* B :=
    ((IsLocalization.atUnits
      B
      ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g)
      (map_comap_maximal_primeCompl_le_units g)).symm.toRingHom)
  collapseUnits.comp imageLocalization

/-- Helper for Lemma 10.127.10: the canonical map from the pulled-back localization into the
ambient local ring is injective once the original ring map is injective. -/
private theorem localization_at_comap_maximal_to_ambient_injective
    (g : A →+* B) (hg : Function.Injective g) :
    Function.Injective (localizationAtComapMaximalToAmbient g) := by
  let imageLocalization :
      Localization.AtPrime (Ideal.comap g (IsLocalRing.maximalIdeal B)) →+*
        Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g) :=
    IsLocalization.map
      (Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g))
      g
      (Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.le_comap_map
  have hImageLocalization : Function.Injective imageLocalization := by
    -- Proof comment: injective maps stay injective after localizing at a multiplicative set.
    exact
      IsLocalization.map_injective_of_injective
        ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl)
        (Localization.AtPrime (Ideal.comap g (IsLocalRing.maximalIdeal B)))
        (Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g))
        hg
  let collapseUnits :
      Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g) →+* B :=
    ((IsLocalization.atUnits
      B
      ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g)
      (map_comap_maximal_primeCompl_le_units g)).symm.toRingHom)
  have hCollapseUnits : Function.Injective collapseUnits := by
    -- Proof comment: cancelling a localization at units is an equivalence.
    exact
      ((IsLocalization.atUnits
        B
        ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g)
        (map_comap_maximal_primeCompl_le_units g)).symm.injective)
  -- Proof comment: the ambient comparison map is the composite of those two injective maps.
  simpa [localizationAtComapMaximalToAmbient, imageLocalization, collapseUnits] using
    Function.Injective.comp hCollapseUnits hImageLocalization

/-- Helper for Lemma 10.127.10: the canonical map from the pulled-back localization into the
ambient local ring sends each raw generator to its ambient value. -/
private theorem localizationAtComapMaximalToAmbient_to_map (g : A →+* B) (x : A) :
    localizationAtComapMaximalToAmbient g (algebraMap _ _ x) = g x := by
  let imageLocalization :
      Localization.AtPrime (Ideal.comap g (IsLocalRing.maximalIdeal B)) →+*
        Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g) :=
    IsLocalization.map
      (Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g))
      g
      (Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.le_comap_map
  let collapseUnits :
      Localization ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g) →+* B :=
    ((IsLocalization.atUnits
      B
      ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g)
      (map_comap_maximal_primeCompl_le_units g)).symm.toRingHom)
  -- Proof comment: evaluate the canonical localization map on a generator and then cancel the
  -- localization at units.
  change collapseUnits (imageLocalization (algebraMap _ _ x)) = g x
  rw [IsLocalization.map_eq]
  change collapseUnits (algebraMap _ _ (g x)) = g x
  exact
    (IsLocalization.atUnits B
      ((Ideal.comap g (IsLocalRing.maximalIdeal B)).primeCompl.map g)
      (map_comap_maximal_primeCompl_le_units g)).symm.commutes (g x)

end FixedGeneratorLocalizedStages

/-- Helper for Lemma 10.127.10: the target-side prime used to localize one fixed-generator raw
stage. -/
private noncomputable abbrev fixedTargetStagePrime (Γ : Finset S) (A : Finset R) :
    Ideal (fixedTargetRawStage (f := f) Γ A) :=
  Ideal.comap (fixedTargetRawStage (f := f) Γ A).val (IsLocalRing.maximalIdeal S)

/-- Helper for Lemma 10.127.10: the localized target stage attached to one fixed-generator raw
stage. -/
private noncomputable abbrev fixedTargetLocalizedStage (Γ : Finset S) (A : Finset R) : Type v :=
  Localization.AtPrime (fixedTargetStagePrime (f := f) Γ A)

/-- Helper for Lemma 10.127.10: the canonical map from a localized fixed-generator target stage
back to the ambient local ring `S`. -/
private noncomputable abbrev fixedTargetLocalizedToAmbient (Γ : Finset S) (A : Finset R) :
    fixedTargetLocalizedStage (f := f) Γ A →+* S :=
  localizationAtComapMaximalToAmbient
    (A := fixedTargetRawStage (f := f) Γ A) (B := S)
    (fixedTargetRawStage (f := f) Γ A).val.toRingHom

omit [IsLocalRing R] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: the ambient comparison map from a localized fixed-generator target
stage sends a raw-stage generator to its ambient value in `S`. -/
private theorem fixed_target_localized_to_ambient_to_map (Γ : Finset S) (A : Finset R)
    (x : fixedTargetRawStage (f := f) Γ A) :
    fixedTargetLocalizedToAmbient (f := f) Γ A (algebraMap _ _ x) = (x : S) := by
  -- Proof comment: this is the fixed-generator specialization of the general localization
  -- generator formula above.
  exact
    localizationAtComapMaximalToAmbient_to_map
      (g := (fixedTargetRawStage (f := f) Γ A).val.toRingHom) x

omit [IsLocalRing R] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: every ambient target element already appears in some localized
fixed-generator stage. This is the textbook denominator-clearing step with one global generator
set `Γ`. -/
private theorem fixed_generator_target_localized_stage_cover {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S) :
    ∀ s : S,
      ∃ A : Finset R, ∃ x : fixedTargetLocalizedStage (f := f) Γ A,
        fixedTargetLocalizedToAmbient (f := f) Γ A x = s := by
  classical
  letI := f.toAlgebra
  haveI : Algebra.EssFiniteType R S := hf
  have hΓ : Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S := hΓ
  -- Route correction: rewriting `Algebra.adjoin R ↑Γ` to the witness subalgebra inside a type
  -- (`↥(...)`) is not possible for `simp`; instead extract the denominator condition for the
  -- canonical generators and transfer the memberships along `hΓ` propositionally.
  have hcond : ∀ s : S, ∃ t ∈ Algebra.adjoin R (↑Γ : Set S),
      IsUnit t ∧ s * t ∈ Algebra.adjoin R (↑Γ : Set S) := by
    intro s
    obtain ⟨t, ht, htunit, hst⟩ :=
      (Algebra.essFiniteType_cond_iff (R := R) (S := S)
        (Algebra.EssFiniteType.finset R S)).mp
        (inferInstance : IsLocalization (Algebra.EssFiniteType.submonoid R S) S) s
    refine ⟨t, ?_, htunit, ?_⟩
    · rw [hΓ]; exact ht
    · rw [hΓ]; exact hst
  intro s
  obtain ⟨t, ht, htunit, hst⟩ := hcond s
  obtain ⟨At, tStage, htStage_eq⟩ :=
    exists_raw_fixed_generator_stage_of_witness_element (f := f) hf hΓ
      ⟨t, by simpa [hΓ] using ht⟩
  obtain ⟨Au, uStage, huStage_eq⟩ :=
    exists_raw_fixed_generator_stage_of_witness_element (f := f) hf hΓ
      ⟨s * t, by simpa [hΓ] using hst⟩
  let Aunion : Finset R := At ∪ Au
  let tUnion : fixedTargetRawStage (f := f) Γ Aunion :=
    fixedTargetRawStageInclusion (f := f) Γ
      (show At ⊆ Aunion by
        intro a ha
        exact Finset.mem_union.mpr <| Or.inl ha) tStage
  let uUnion : fixedTargetRawStage (f := f) Γ Aunion :=
    fixedTargetRawStageInclusion (f := f) Γ
      (show Au ⊆ Aunion by
        intro a ha
        exact Finset.mem_union.mpr <| Or.inr ha) uStage
  have htUnion_eq : ((tUnion : fixedTargetRawStage (f := f) Γ Aunion) : S) = t := by
    -- Proof comment: the raw-stage inclusion is literally the ambient subtype inclusion.
    simpa [Aunion, tUnion, fixedTargetRawStageInclusion_coe] using htStage_eq
  have huUnion_eq : ((uUnion : fixedTargetRawStage (f := f) Γ Aunion) : S) = s * t := by
    -- Proof comment: the same ambient-compatibility applies to the numerator stage.
    simpa [Aunion, uUnion, fixedTargetRawStageInclusion_coe] using huStage_eq
  have htUnion_primeCompl : tUnion ∈ (fixedTargetStagePrime (f := f) Γ Aunion).primeCompl := by
    -- Proof comment: a denominator chosen from the essential-finite-type localization witness is a
    -- unit in `S`, hence misses the maximal ideal of every contracted local stage.
    change tUnion ∉ fixedTargetStagePrime (f := f) Γ Aunion
    simp only [Ideal.mem_comap, Subalgebra.coe_val]
    simpa [htUnion_eq] using (IsLocalRing.notMem_maximalIdeal).2 htunit
  refine ⟨Aunion, IsLocalization.mk' _ uUnion ⟨tUnion, htUnion_primeCompl⟩, ?_⟩
  have hspec :
      algebraMap
          (fixedTargetRawStage (f := f) Γ Aunion)
          (fixedTargetLocalizedStage (f := f) Γ Aunion)
          tUnion *
        IsLocalization.mk' (fixedTargetLocalizedStage (f := f) Γ Aunion) uUnion
          ⟨tUnion, htUnion_primeCompl⟩ =
      algebraMap
        (fixedTargetRawStage (f := f) Γ Aunion)
        (fixedTargetLocalizedStage (f := f) Γ Aunion)
        uUnion := by
    -- Proof comment: use the defining numerator-denominator relation in the localized stage.
    simpa using
      (IsLocalization.mk'_spec'
        (fixedTargetLocalizedStage (f := f) Γ Aunion) uUnion ⟨tUnion, htUnion_primeCompl⟩)
  have himage :=
    congrArg (fixedTargetLocalizedToAmbient (f := f) Γ Aunion) hspec
  have hmul :
      t * fixedTargetLocalizedToAmbient (f := f) Γ Aunion
          (IsLocalization.mk' (fixedTargetLocalizedStage (f := f) Γ Aunion) uUnion
            ⟨tUnion, htUnion_primeCompl⟩) =
        s * t := by
    -- Proof comment: map the localization relation back to `S`, where the numerator is `s * t`
    -- and the denominator is the unit `t`.
    have h := himage
    rw [map_mul, fixed_target_localized_to_ambient_to_map,
      fixed_target_localized_to_ambient_to_map, htUnion_eq, huUnion_eq] at h
    exact h
  rcases htunit with ⟨u, rfl⟩
  -- Proof comment: cancel the unit denominator on the right to recover the original element `s`.
  exact (Units.mul_right_inj u).1 <| by
    simpa [mul_comm, mul_left_comm, mul_assoc] using hmul

/-- Helper for Lemma 10.127.10: finite subsets of `R` form a directed preorder under inclusion,
with union as a common upper bound. -/
private instance fixedGeneratorIndexDirectedOrder : IsDirectedOrder (Finset R) where
  directed := by
    classical
    intro A B
    refine ⟨A ∪ B, ?_, ?_⟩
    · intro a ha
      exact Finset.mem_union.mpr <| Or.inl ha
    · intro b hb
      exact Finset.mem_union.mpr <| Or.inr hb

/-- Helper for Lemma 10.127.10: the source-side prime used to localize one fixed-generator raw
source stage. -/
private noncomputable abbrev fixedSourceStagePrime (A : Finset R) :
    Ideal (fixedSourceRawStage A) :=
  Ideal.comap (fixedSourceRawStage A).val (IsLocalRing.maximalIdeal R)

/-- Helper for Lemma 10.127.10: the localized source stage attached to one fixed-generator raw
source stage. -/
private noncomputable abbrev fixedSourceLocalizedStage (A : Finset R) : Type u :=
  Localization.AtPrime (fixedSourceStagePrime A)

/-- Helper for Lemma 10.127.10: the source-stage inclusion does not change the pulled-back maximal
ideal. This is the source-side localization hypothesis for the fixed-generator system. -/
private theorem fixed_source_stage_comap_maximal_eq {A B : Finset R} (hAB : A ⊆ B) :
    Ideal.comap (fixedSourceRawStageInclusion hAB)
      (fixedSourceStagePrime B) =
        fixedSourceStagePrime A := by
  -- Route correction: the former `change`+`rfl` made the kernel reduce through the subalgebra
  -- coercions and hit a deterministic timeout; rewrite both memberships propositionally instead.
  ext x
  simp only [Ideal.mem_comap, Subalgebra.coe_val, fixedSourceRawStageInclusion_coe]

