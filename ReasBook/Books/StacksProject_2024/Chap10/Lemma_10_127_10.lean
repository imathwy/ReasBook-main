    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S) :
