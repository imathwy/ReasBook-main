/-- Helper for Lemma 10.127.10: localized source transitions compose along inclusion of finite
coefficient sets. -/
private theorem fixed_source_localized_transition_comp {A B C : Finset R}
    (hAB : A ⊆ B) (hBC : B ⊆ C) :
    fixedSourceLocalizedTransition (A := A) (B := C) (Finset.Subset.trans hAB hBC) =
      (fixedSourceLocalizedTransition (A := B) (B := C) hBC).comp
        (fixedSourceLocalizedTransition (A := A) (B := B) hAB) := by
  -- Route correction: the generatorwise route closed with a localization-level `rfl` whose
  -- kernel check times out; reuse the canonical `localRingHom_comp` theorem instead, exactly as
  -- `fixed_source_localized_transition_id` reuses `localRingHom_id`.
  have hincl :
      (fixedSourceRawStageInclusion (Finset.Subset.trans hAB hBC)) =
        (fixedSourceRawStageInclusion hBC).comp
          (fixedSourceRawStageInclusion hAB) := by
    ext x
    simp only [RingHom.comp_apply, fixedSourceRawStageInclusion_coe]
  simpa [fixedSourceLocalizedTransition, hincl] using
    (Localization.localRingHom_comp
      (I := fixedSourceStagePrime A)
      (J := fixedSourceStagePrime B)
      (K := fixedSourceStagePrime C)
      (f := (fixedSourceRawStageInclusion hAB))
      (hIJ := (fixed_source_stage_comap_maximal_eq hAB).symm)
      (g := (fixedSourceRawStageInclusion hBC))
      (hJK := (fixed_source_stage_comap_maximal_eq hBC).symm))

