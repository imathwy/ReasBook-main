    (hg := fun A B hAB x ↦ by
      simpa [RingHom.comp_apply] using
        congrArg (fun g => g x)
          (fixed_target_localized_to_ambient_comp (f := f) Γ (A := A) (B := B) hAB))
    (hinj := fun A ↦ fixedTargetLocalizedToAmbient_injective (f := f) Γ A)
    (hcover := fixed_generator_target_localized_stage_cover (f := f) hf hΓ)

/-- Helper for Lemma 10.127.10: the source direct limit identifies with the ambient source ring
through the stagewise ambient maps. -/
private noncomputable def fixedSourceColimitIso :
    Ring.DirectLimit
        (fun A : Finset R ↦ fixedSourceLocalizedStage A)
        (fun _ _ hAB ↦ fixedSourceLocalizedTransition hAB) ≃+* R :=
  RingEquiv.ofBijective
    (fixedSourceColimitToAmbient)
    (fixed_source_colimit_comparison_bijective)

/-- Helper for Lemma 10.127.10: the target direct limit identifies with the ambient target ring
through the stagewise ambient maps. -/
private noncomputable def fixedTargetColimitIso {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S) :
    Ring.DirectLimit
        (fun A : Finset R ↦ fixedTargetLocalizedStage (f := f) Γ A)
        (fun _ _ hAB ↦ fixedTargetLocalizedTransition (f := f) Γ hAB) ≃+* S :=
  RingEquiv.ofBijective
    (fixedTargetColimitToAmbient (f := f) Γ)
    (fixed_target_colimit_comparison_bijective (f := f) hf hΓ)

/-- Helper for Lemma 10.127.10: the colimit square commutes on each canonical generator from a
localized source stage. -/
private theorem fixed_colimit_comm_on_generators (Γ : Finset S) (A : Finset R)
    (x : fixedSourceLocalizedStage A) :
    ((fixedTargetColimitToAmbient (f := f) Γ).comp
        (Ring.DirectLimit.map
          (fun A ↦ fixedLocalizedStageMap (f := f) Γ A)
          (fun _ _ hAB ↦ fixed_localized_stage_square_commutes (f := f) Γ hAB)))
      (Ring.DirectLimit.of
        (fun A : Finset R ↦ fixedSourceLocalizedStage A)
        (fun _ _ hAB ↦ fixedSourceLocalizedTransition hAB)
        A x) =
      ((f.comp (fixedSourceColimitToAmbient (R := R)))
        (Ring.DirectLimit.of
          (fun A : Finset R ↦ fixedSourceLocalizedStage A)
          (fun _ _ hAB ↦ fixedSourceLocalizedTransition hAB)
          A x)) := by
  -- Proof comment: reduce the direct-limit plumbing on one generator and read off the stagewise
  -- ambient commutation square.
  simp only [RingHom.comp_apply, Ring.DirectLimit.map_apply_of, fixedTargetColimitToAmbient,
    Ring.DirectLimit.lift_of, fixedSourceColimitToAmbient]
  simpa [RingHom.comp_apply] using
    congrArg
      (fun g : fixedSourceLocalizedStage A →+* S => g x)
      (fixed_localized_stage_to_ambient_commutes (f := f) Γ A)

/-- Helper for Lemma 10.127.10: after identifying the two direct limits with `R` and `S`, the
induced map on colimits is exactly the original local homomorphism `f`. -/
private theorem fixed_localized_colimit_comm {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S) :
    ((fixedTargetColimitIso (f := f) hf hΓ : _ ≃+* S) : _ →+* S).comp
        (Ring.DirectLimit.map
          (fun A ↦ fixedLocalizedStageMap (f := f) Γ A)
          (fun _ _ hAB ↦ fixed_localized_stage_square_commutes (f := f) Γ hAB)) =
      f.comp ((fixedSourceColimitIso (R := R) : _ ≃+* R) : _ →+* R) := by
  -- Proof comment: the two comparison maps agree on stage generators, hence on the direct limit.
  apply Ring.DirectLimit.hom_ext
  intro A
  ext x
  exact fixed_colimit_comm_on_generators (f := f) Γ A x

omit [IsLocalRing R] in
/-- Helper for Lemma 10.127.10: each raw source stage is finite type over `ℤ` because it is the
adjoin of a finite subset of `R`. -/
private theorem fixedSourceRawStage_finiteType (A : Finset R) :
    Algebra.FiniteType ℤ (fixedSourceRawStage A) := by
  -- Proof comment: finite adjoin over `ℤ` is finite type.
  simpa [fixedSourceRawStage] using
    (Algebra.FiniteType.adjoin_of_finite
      (R := ℤ) (A := R) (t := (↑A : Set R)) A.finite_toSet)

omit [IsLocalRing R] [IsLocalRing S] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: each raw target stage is finite type over `ℤ` because it is the
adjoin of finitely many source images together with the fixed finite generator set `Γ`. -/
private theorem fixedTargetRawStage_finiteType (Γ : Finset S) (A : Finset R) :
    Algebra.FiniteType ℤ (fixedTargetRawStage (f := f) Γ A) := by
  have hfinite : (f '' (↑A : Set R) ∪ (↑Γ : Set S)).Finite :=
    (A.finite_toSet.image f).union Γ.finite_toSet
  -- Proof comment: the raw target stage is exactly the finite adjoin of those generators.
  simpa [fixedTargetRawStage] using
    (Algebra.FiniteType.adjoin_of_finite
      (R := ℤ) (A := S) (t := f '' (↑A : Set R) ∪ (↑Γ : Set S)) hfinite)

omit [IsLocalRing R] [IsLocalRing S] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: before localization, each raw target stage is finite type as an
algebra over the corresponding raw source stage. -/
private theorem fixedRawStageMap_finiteType (Γ : Finset S) (A : Finset R) :
    (fixedRawStageMap (f := f) Γ A).FiniteType := by
  let _ : Algebra (fixedSourceRawStage A) (fixedTargetRawStage (f := f) Γ A) :=
    (fixedRawStageMap (f := f) Γ A).toAlgebra
  -- Proof comment: restriction of scalars transports finite type from `ℤ` to the intermediate
  -- source raw stage.
  rw [RingHom.FiniteType]
  exact Algebra.FiniteType.of_restrictScalars_finiteType
    (R := ℤ) (S := fixedSourceRawStage A) (A := fixedTargetRawStage (f := f) Γ A)
    (hA := fixedTargetRawStage_finiteType (f := f) Γ A)

/-- Helper for Lemma 10.127.10: each localized source stage remains essentially of finite type
over `ℤ` because it is the localization of a finite-type raw source stage. -/
private theorem fixedSourceLocalizedStage_essFiniteType (A : Finset R) :
    (Int.castRingHom (fixedSourceLocalizedStage A)).EssFiniteType := by
  have hSourceFinite :
      (Int.castRingHom (fixedSourceRawStage A)).FiniteType := by
    exact RingHom.finiteType_algebraMap.mpr (fixedSourceRawStage_finiteType A)
  have hSourceLocalization :
      (algebraMap (fixedSourceRawStage A)
        (fixedSourceLocalizedStage A)).EssFiniteType := by
    rw [RingHom.essFiniteType_algebraMap]
    exact Algebra.EssFiniteType.of_isLocalization
      (fixedSourceLocalizedStage A)
      (fixedSourceStagePrime A).primeCompl
  have hComposite :
      ((algebraMap (fixedSourceRawStage A)
          (fixedSourceLocalizedStage A)).comp
        (Int.castRingHom (fixedSourceRawStage A))).EssFiniteType := by
    exact RingHom.EssFiniteType.comp hSourceFinite.essFiniteType hSourceLocalization
  have hcomp :
      (algebraMap (fixedSourceRawStage A)
          (fixedSourceLocalizedStage A)).comp
        (Int.castRingHom (fixedSourceRawStage A)) =
      Int.castRingHom (fixedSourceLocalizedStage A) := by
    ext n
    simp
  simpa [hcomp] using hComposite

/-- Helper for Lemma 10.127.10: each localized fixed-generator stage map is essentially of finite
type because it comes from localizing a finite-type raw stage map. -/
private theorem fixedLocalizedStageMap_essFiniteType (Γ : Finset S) (A : Finset R) :
    (fixedLocalizedStageMap (f := f) Γ A).EssFiniteType := by
  have hTargetLocalization :
      (algebraMap (fixedTargetRawStage (f := f) Γ A)
        (fixedTargetLocalizedStage (f := f) Γ A)).EssFiniteType := by
    rw [RingHom.essFiniteType_algebraMap]
    exact Algebra.EssFiniteType.of_isLocalization
      (fixedTargetLocalizedStage (f := f) Γ A)
      (fixedTargetStagePrime (f := f) Γ A).primeCompl
  have hComposite :
      ((algebraMap (fixedTargetRawStage (f := f) Γ A)
          (fixedTargetLocalizedStage (f := f) Γ A)).comp
        (fixedRawStageMap (f := f) Γ A)).EssFiniteType := by
    exact RingHom.EssFiniteType.comp
      (fixedRawStageMap_finiteType (f := f) Γ A).essFiniteType
      hTargetLocalization
  have hcomp :
      ((fixedLocalizedStageMap (f := f) Γ A).comp
        (algebraMap (fixedSourceRawStage A)
          (fixedSourceLocalizedStage A))) =
        ((algebraMap (fixedTargetRawStage (f := f) Γ A)
            (fixedTargetLocalizedStage (f := f) Γ A)).comp
          (fixedRawStageMap (f := f) Γ A)) := by
    ext x
    rw [RingHom.comp_apply, fixed_localizedStageMap_to_map]
    rfl
  have hLocalizedComposite :
      ((fixedLocalizedStageMap (f := f) Γ A).comp
        (algebraMap (fixedSourceRawStage A)
          (fixedSourceLocalizedStage A))).EssFiniteType := by
    simpa [hcomp] using hComposite
  exact RingHom.EssFiniteType.of_comp
    (algebraMap (fixedSourceRawStage A)
      (fixedSourceLocalizedStage A))
    hLocalizedComposite

/-- Helper for Lemma 10.127.10: the source-faithful directed approximation attached to one global
finite generator set `Γ`. -/
private noncomputable def fixed_generator_approximation (Γ : Finset S)
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S) :
    DirectedLocalHomApproximation f :=
  { Λ := Finset R
    instPreorder := inferInstance
    instNonempty := inferInstance
    instDirectedOrder := fixedGeneratorIndexDirectedOrder (R := R)
    RStage := fun A ↦ fixedSourceLocalizedStage A
    instCommRingRStage := fun _ ↦ inferInstance
    map := fun _ _ hAB ↦ fixedSourceLocalizedTransition hAB
    instDirectedSystemRStage := fixedSourceLocalizedDirectedSystem
    colimitIso := fixedSourceColimitIso
    instIsLocalRingRStage := fun _ ↦ inferInstance
    SStage := fun A ↦ fixedTargetLocalizedStage (f := f) Γ A
    instCommRingSStage := fun _ ↦ inferInstance
    instIsLocalRingSStage := fun _ ↦ inferInstance
    stageMap := fun A ↦ fixedLocalizedStageMap (f := f) Γ A
    stageMap_isLocalHom := fixedLocalizedStageMap_isLocalHom (f := f) Γ
    targetMap := fun _ _ hAB ↦ fixedTargetLocalizedTransition (f := f) Γ hAB
    instDirectedSystemTarget := fixedTargetLocalizedDirectedSystem (f := f) Γ
    comm := fun {_ _} hAB ↦ fixed_localized_stage_square_commutes (f := f) Γ hAB
    targetColimit := fixedTargetColimitIso (f := f) hf hΓ
    colimit_comm := fixed_localized_colimit_comm (f := f) hf hΓ
    source_essFiniteType := fun A ↦ fixedSourceLocalizedStage_essFiniteType A
    target_essFiniteType := fun A ↦ fixedLocalizedStageMap_essFiniteType (f := f) Γ A }

/-- Helper for Lemma 10.127.10: on pure tensors, the owner base-change map is the product of the
target transition and the later stage map. -/
private theorem fixed_stageBaseChangeMap_tmul {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S)
    {A B : Finset R} (hAB : A ⊆ B) :
    let Afix := fixed_generator_approximation (f := f) Γ hf hΓ
    let _ : Algebra (Afix.RStage A) (Afix.SStage A) := (Afix.stageMap A).toAlgebra
    let _ : Algebra (Afix.RStage A) (Afix.RStage B) := (Afix.map A B hAB).toAlgebra
    let _ : Algebra (Afix.RStage A) (Afix.SStage B) :=
      ((Afix.stageMap B).comp (Afix.map A B hAB)).toAlgebra
    ∀ x : Afix.SStage A,
      ∀ y : Afix.RStage B,
        Afix.stageBaseChangeMap hAB (x ⊗ₜ[Afix.RStage A] y) =
          Afix.targetMap A B hAB x * Afix.stageMap B y := by
  intro _ _ _ _ x y
  -- Proof comment: unfold the owner base-change map, evaluate `productMap` on the pure tensor,
  -- and close the remaining algebra-hom coercions definitionally.
  simp [DirectedLocalHomApproximation.stageBaseChangeMap,
    Algebra.TensorProduct.productMap_apply_tmul]
  rfl

/-- Helper for Lemma 10.127.10: a ring homomorphism into a local ring presents its target as a
localization of a quotient of its source as soon as every target element is a fraction of image
elements whose denominator image avoids the maximal ideal. -/
private theorem isLocalizationOfQuotient_of_fraction_cover {A : Type*} {B : Type*}
    [CommRing A] [CommRing B] [IsLocalRing B] (g : A →+* B)
    (hcov : ∀ b : B, ∃ p q : A,
      g q ∉ IsLocalRing.maximalIdeal B ∧ b * g q = g p) :
    RingHom.IsLocalizationOfQuotient g := by
  letI : Algebra (A ⧸ RingHom.ker g) B := (RingHom.kerLift g).toAlgebra
  have halg : algebraMap (A ⧸ RingHom.ker g) B = RingHom.kerLift g :=
    RingHom.algebraMap_toAlgebra _
  letI : IsLocalization
      (Ideal.comap (RingHom.kerLift g) (IsLocalRing.maximalIdeal B)).primeCompl B := by
    refine ⟨fun y ↦ ?_, fun z ↦ ?_, fun {x y} hxy ↦ ?_⟩
    · -- Proof comment: classes outside the contracted maximal ideal map to units of the local
      -- target ring.
      rcases y with ⟨y, hy⟩
      have hy' : y ∉ Ideal.comap (RingHom.kerLift g) (IsLocalRing.maximalIdeal B) := hy
      by_contra hunit
      rw [halg] at hunit
      exact hy' (Ideal.mem_comap.mpr
        ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hunit)))
    · -- Proof comment: the fraction cover provides a numerator and a denominator class for every
      -- target element.
      obtain ⟨p, q, hq', hpq⟩ := hcov z
      refine ⟨⟨Ideal.Quotient.mk _ p, ⟨Ideal.Quotient.mk _ q, fun hmem ↦ ?_⟩⟩, ?_⟩
      · exact hq' (by simpa [RingHom.kerLift_mk] using Ideal.mem_comap.mp hmem)
      · rw [halg]
        simpa [RingHom.kerLift_mk] using hpq
    · -- Proof comment: the induced map out of the quotient by the kernel is injective, so equal
      -- images force equal classes.
      refine ⟨1, ?_⟩
      rw [halg] at hxy
      rw [RingHom.kerLift_injective g hxy]
  refine ⟨RingHom.ker g, inferInstance,
    (Ideal.comap (RingHom.kerLift g) (IsLocalRing.maximalIdeal B)).primeCompl,
    inferInstance, ?_⟩
  ext x
  rw [RingHom.comp_apply, halg, RingHom.kerLift_mk]

/-- Helper for Lemma 10.127.10: the owner base-change map retyped on the explicit localized
tensor product, so that later proofs elaborate only against explicit localization types. -/
private noncomputable def fixedStageBaseChangeExplicit (Γ : Finset S)
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S)
    {A B : Finset R} (hAB : A ⊆ B) :
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      (fixedLocalizedStageMap (f := f) Γ A).toAlgebra
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      (fixedSourceLocalizedTransition hAB).toAlgebra
    let _ : Module (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      Algebra.toModule
    let _ : Module (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      Algebra.toModule
    fixedTargetLocalizedStage (f := f) Γ A ⊗[fixedSourceLocalizedStage A]
      fixedSourceLocalizedStage B →+* fixedTargetLocalizedStage (f := f) Γ B :=
  (fixed_generator_approximation (f := f) Γ hf hΓ).stageBaseChangeMap hAB

/-- Helper for Lemma 10.127.10: the explicit owner base-change map multiplies the target
transition and the later stage map on pure tensors. -/
private theorem fixed_stageBaseChangeExplicit_tmul (Γ : Finset S)
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S)
    {A B : Finset R} (hAB : A ⊆ B) :
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      (fixedLocalizedStageMap (f := f) Γ A).toAlgebra
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      (fixedSourceLocalizedTransition hAB).toAlgebra
    let _ : Module (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      Algebra.toModule
    let _ : Module (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      Algebra.toModule
    ∀ (x : fixedTargetLocalizedStage (f := f) Γ A) (y : fixedSourceLocalizedStage B),
      fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB
          (x ⊗ₜ[fixedSourceLocalizedStage A] y) =
        fixedTargetLocalizedTransition (f := f) Γ hAB x *
          fixedLocalizedStageMap (f := f) Γ B y := by
  intro _ _ _ _ x y
  -- Proof comment: this is the owner pure-tensor formula transported across the definitional
  -- retyping of the base-change map.
  exact fixed_stageBaseChangeMap_tmul (f := f) (Γ := Γ) hf hΓ hAB x y

/-- Helper for Lemma 10.127.10: the image of a new source coefficient is hit by the explicit
base-change map from the right tensor factor. -/
private theorem fixed_stageBaseChange_hits_coefficient {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S)
    {A B : Finset R} (hAB : A ⊆ B) {r : R} (hr : r ∈ (↑B : Set R))
    (hfr : f r ∈ fixedTargetRawStage (f := f) Γ B) :
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      (fixedLocalizedStageMap (f := f) Γ A).toAlgebra
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      (fixedSourceLocalizedTransition hAB).toAlgebra
    let _ : Module (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      Algebra.toModule
    let _ : Module (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      Algebra.toModule
    ∃ p : fixedTargetLocalizedStage (f := f) Γ A ⊗[fixedSourceLocalizedStage A]
        fixedSourceLocalizedStage B,
      fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB p =
        algebraMap (fixedTargetRawStage (f := f) Γ B)
          (fixedTargetLocalizedStage (f := f) Γ B) ⟨f r, hfr⟩ := by
  intro _ _ _ _
  refine ⟨(1 : fixedTargetLocalizedStage (f := f) Γ A) ⊗ₜ[fixedSourceLocalizedStage A]
    (algebraMap (fixedSourceRawStage B) (fixedSourceLocalizedStage B)
      (⟨r, Algebra.subset_adjoin hr⟩ : fixedSourceRawStage B)), ?_⟩
  rw [fixed_stageBaseChangeExplicit_tmul (f := f) Γ hf hΓ hAB 1
      (algebraMap (fixedSourceRawStage B) (fixedSourceLocalizedStage B)
        (⟨r, Algebra.subset_adjoin hr⟩ : fixedSourceRawStage B)),
    map_one, one_mul, fixed_localizedStageMap_to_map]
  exact congrArg (algebraMap _ _) (Subtype.ext (by simp [fixedRawStageMap_coe]))

/-- Helper for Lemma 10.127.10: a fixed generator from `Γ` is hit by the explicit base-change map
from the left tensor factor. -/
private theorem fixed_stageBaseChange_hits_gamma {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S)
    {A B : Finset R} (hAB : A ⊆ B) {y : S} (hy : y ∈ (↑Γ : Set S))
    (hyB : y ∈ fixedTargetRawStage (f := f) Γ B) :
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      (fixedLocalizedStageMap (f := f) Γ A).toAlgebra
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      (fixedSourceLocalizedTransition hAB).toAlgebra
    let _ : Module (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      Algebra.toModule
    let _ : Module (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      Algebra.toModule
    ∃ p : fixedTargetLocalizedStage (f := f) Γ A ⊗[fixedSourceLocalizedStage A]
        fixedSourceLocalizedStage B,
      fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB p =
        algebraMap (fixedTargetRawStage (f := f) Γ B)
          (fixedTargetLocalizedStage (f := f) Γ B) ⟨y, hyB⟩ := by
  intro _ _ _ _
  refine ⟨(algebraMap (fixedTargetRawStage (f := f) Γ A)
      (fixedTargetLocalizedStage (f := f) Γ A)
      (⟨y, Algebra.subset_adjoin ((Set.mem_union _ _ _).mpr (Or.inr hy))⟩ :
        fixedTargetRawStage (f := f) Γ A)) ⊗ₜ[fixedSourceLocalizedStage A]
    (1 : fixedSourceLocalizedStage B), ?_⟩
  rw [fixed_stageBaseChangeExplicit_tmul (f := f) Γ hf hΓ hAB
      (algebraMap (fixedTargetRawStage (f := f) Γ A)
        (fixedTargetLocalizedStage (f := f) Γ A)
        (⟨y, Algebra.subset_adjoin ((Set.mem_union _ _ _).mpr (Or.inr hy))⟩ :
          fixedTargetRawStage (f := f) Γ A)) 1,
    map_one, mul_one, fixed_target_localized_transition_to_map]
  exact congrArg (algebraMap _ _)
    (Subtype.ext (by simp [fixedTargetRawStageInclusion_coe]))

omit [IsLocalRing R] [IsLocalHom f] in
/-- Helper for Lemma 10.127.10: a subring of the later localized target stage containing the
images of all coefficient generators and all fixed generators contains the image of the whole
raw target stage. -/
private theorem fixed_targetRawStage_algebraMap_mem_of_generators {Γ : Finset S}
    {B : Finset R} (T : Subring (fixedTargetLocalizedStage (f := f) Γ B))
    (hcoeff : ∀ {r : R} (_ : r ∈ (↑B : Set R))
      (hfr : f r ∈ fixedTargetRawStage (f := f) Γ B),
      algebraMap (fixedTargetRawStage (f := f) Γ B)
        (fixedTargetLocalizedStage (f := f) Γ B) ⟨f r, hfr⟩ ∈ T)
    (hgamma : ∀ {y : S} (_ : y ∈ (↑Γ : Set S))
      (hyB : y ∈ fixedTargetRawStage (f := f) Γ B),
      algebraMap (fixedTargetRawStage (f := f) Γ B)
        (fixedTargetLocalizedStage (f := f) Γ B) ⟨y, hyB⟩ ∈ T)
    (a : fixedTargetRawStage (f := f) Γ B) :
    algebraMap (fixedTargetRawStage (f := f) Γ B)
      (fixedTargetLocalizedStage (f := f) Γ B) a ∈ T := by
  obtain ⟨s, hs⟩ := a
  -- Proof comment: run over the adjoin generators of the raw target stage; ring operations stay
  -- inside the subring.
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hs
  · intro y hy
    rcases (Set.mem_union _ _ _).mp hy with hy' | hy'
    · -- Proof comment: a coefficient generator is covered by the coefficient hypothesis.
      rcases hy' with ⟨r, hr, rfl⟩
      exact hcoeff hr (Algebra.subset_adjoin hy)
    · -- Proof comment: a fixed generator is covered by the fixed-generator hypothesis.
      exact hgamma hy' (Algebra.subset_adjoin hy)
  · -- Proof comment: integer constants lie in every subring.
    intro n
    have hn : (⟨algebraMap ℤ S n, (fixedTargetRawStage (f := f) Γ B).algebraMap_mem n⟩ :
        fixedTargetRawStage (f := f) Γ B) = (n : fixedTargetRawStage (f := f) Γ B) :=
      Subtype.ext (by simp)
    rw [hn, map_intCast]
    exact intCast_mem _ n
  · -- Proof comment: the subring is closed under addition.
    intro x y hx hy ihx ihy
    have hxy : (⟨x + y, add_mem hx hy⟩ : fixedTargetRawStage (f := f) Γ B) =
        ⟨x, hx⟩ + ⟨y, hy⟩ := Subtype.ext (by simp)
    rw [hxy, map_add]
    exact add_mem ihx ihy
  · -- Proof comment: the subring is closed under multiplication.
    intro x y hx hy ihx ihy
    have hxy : (⟨x * y, mul_mem hx hy⟩ : fixedTargetRawStage (f := f) Γ B) =
        ⟨x, hx⟩ * ⟨y, hy⟩ := Subtype.ext (by simp)
    rw [hxy, map_mul]
    exact mul_mem ihx ihy

/-- Helper for Lemma 10.127.10: every raw generator of the later target stage is hit by the
explicit base-change map, viewed inside the later localized target stage. -/
private theorem fixed_stageBaseChange_hits_raw {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S)
    {A B : Finset R} (hAB : A ⊆ B) (a : fixedTargetRawStage (f := f) Γ B) :
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      (fixedLocalizedStageMap (f := f) Γ A).toAlgebra
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      (fixedSourceLocalizedTransition hAB).toAlgebra
    let _ : Module (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      Algebra.toModule
    let _ : Module (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      Algebra.toModule
    ∃ p : fixedTargetLocalizedStage (f := f) Γ A ⊗[fixedSourceLocalizedStage A]
        fixedSourceLocalizedStage B,
      fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB p =
        algebraMap (fixedTargetRawStage (f := f) Γ B)
          (fixedTargetLocalizedStage (f := f) Γ B) a := by
  intro _ _ _ _
  -- Proof comment: resolve the ring structure on the explicit tensor once, so that the range
  -- subring below elaborates without re-running the instance search.
  letI : CommRing (fixedTargetLocalizedStage (f := f) Γ A ⊗[fixedSourceLocalizedStage A]
      fixedSourceLocalizedStage B) := inferInstance
  -- Proof comment: land in the range subring of the explicit base-change map; the generatorwise
  -- cover is provided by the two tensor-factor lemmas.
  suffices h : algebraMap (fixedTargetRawStage (f := f) Γ B)
      (fixedTargetLocalizedStage (f := f) Γ B) a ∈
      (fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB).range by
    obtain ⟨p, hp⟩ := RingHom.mem_range.mp h
    exact ⟨p, hp⟩
  refine fixed_targetRawStage_algebraMap_mem_of_generators (f := f) _ ?_ ?_ a
  · intro r hr hfr
    obtain ⟨p, hp⟩ := fixed_stageBaseChange_hits_coefficient (f := f) hf hΓ hAB hr hfr
    exact RingHom.mem_range.mpr ⟨p, hp⟩
  · intro y hy hyB
    obtain ⟨p, hp⟩ := fixed_stageBaseChange_hits_gamma (f := f) hf hΓ hAB hy hyB
    exact RingHom.mem_range.mpr ⟨p, hp⟩


/-- Helper for Lemma 10.127.10: every element of the later localized target stage is a fraction
of images of the explicit base-change map whose denominator image avoids the maximal ideal. -/
private theorem fixed_stageBaseChange_fraction_cover {Γ : Finset S}
    (hf : f.EssFiniteType)
    (hΓ : letI := f.toAlgebra
      haveI : Algebra.EssFiniteType R S := hf
      Algebra.adjoin R (↑Γ : Set S) = Algebra.EssFiniteType.subalgebra R S)
    {A B : Finset R} (hAB : A ⊆ B)
    (z : fixedTargetLocalizedStage (f := f) Γ B) :
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      (fixedLocalizedStageMap (f := f) Γ A).toAlgebra
    let _ : Algebra (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      (fixedSourceLocalizedTransition hAB).toAlgebra
    let _ : Module (fixedSourceLocalizedStage A) (fixedTargetLocalizedStage (f := f) Γ A) :=
      Algebra.toModule
    let _ : Module (fixedSourceLocalizedStage A) (fixedSourceLocalizedStage B) :=
      Algebra.toModule
    ∃ p q : fixedTargetLocalizedStage (f := f) Γ A ⊗[fixedSourceLocalizedStage A]
        fixedSourceLocalizedStage B,
      fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB q ∉
          IsLocalRing.maximalIdeal (fixedTargetLocalizedStage (f := f) Γ B) ∧
        z * fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB q =
          fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB p := by
  intro _ _ _ _
  obtain ⟨x, s, rfl⟩ := IsLocalization.exists_mk'_eq
    (fixedTargetStagePrime (f := f) Γ B).primeCompl z
  obtain ⟨p, hp⟩ := fixed_stageBaseChange_hits_raw (f := f) hf hΓ hAB x
  obtain ⟨q, hq⟩ := fixed_stageBaseChange_hits_raw (f := f) hf hΓ hAB
    (s : fixedTargetRawStage (f := f) Γ B)
  refine ⟨p, q, ?_, ?_⟩
  · -- Proof comment: the denominator avoids the prime, so its localization image avoids the
    -- maximal ideal.
    rw [hq]
    intro hmem
    exact s.property ((IsLocalization.AtPrime.to_map_mem_maximal_iff
      (S := fixedTargetLocalizedStage (f := f) Γ B)
      (I := fixedTargetStagePrime (f := f) Γ B)
      ((s : fixedTargetRawStage (f := f) Γ B))).mp hmem)
  · -- Proof comment: clearing the denominator is the defining property of the localization
    -- fraction.
    rw [hp, hq]
    exact IsLocalization.mk'_spec _ x s

-- Proof sketch: choose one finite generator set `Γ` for the essential-finite-type witness
-- subalgebra once and for all, and take the directed system of fixed-generator stages. Every raw
-- generator of a later target stage is then hit by the base-change map, so each later localized
-- target stage is a localization of a quotient of the base-change tensor source.
/-- Lemma 10.127.10: a local homomorphism `R → S` that is essentially of finite type is the
pointwise colimit of a directed system of local ring maps `R_λ → S_λ` such that each `R_λ` is
essentially of finite type over `ℤ`, each `S_λ` is essentially of finite type over `R_λ`, and for
every transition `λ ≤ μ` the canonical map `S_λ ⊗[R_λ] R_μ → S_μ` presents `S_μ` as a
localization of a quotient. -/
theorem exists_directed_local_essFiniteType_approximation (hf : f.EssFiniteType) :
    ∃ A : DirectedLocalHomApproximation.{u, v, u} f,
      A.HasLocalizationOfQuotientTransitions := by
  obtain ⟨Γ, hΓ⟩ := exists_fixed_generator_finset_for_essFiniteType_witness (f := f) hf
  refine ⟨fixed_generator_approximation (f := f) Γ hf hΓ, ?_⟩
  intro A B hAB
  -- Proof comment: the base-change target is a local ring covered by fractions of base-change
  -- images, so the base-change map presents it as a localization of a quotient.
  exact isLocalizationOfQuotient_of_fraction_cover
    (fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB)
    (fixed_stageBaseChange_fraction_cover (f := f) hf hΓ hAB)

/-- Helper for Lemma 10.127.10: the canonical stage-to-colimit comparison of a directed system of
local rings with local transition maps is a local homomorphism. -/
private theorem toLimitHom_isLocalHom_of_maps
    {Λ : Type*} [Preorder Λ] [Nonempty Λ] [IsDirectedOrder Λ]
    (RStage : Λ → Type u) [∀ i, CommRing (RStage i)]
    (map : ∀ i j, i ≤ j → RStage i →+* RStage j)
    [DirectedSystem RStage (fun i j h ↦ map i j h)]
    [∀ i, IsLocalRing (RStage i)] [∀ i j h, IsLocalHom (map i j h)]
    (colimitIso : Ring.DirectLimit RStage (fun i j h ↦ map i j h) ≃+* R) (i : Λ) :
    IsLocalHom
      (Ring.DirectLimit.toLimitHom RStage (fun i j h ↦ map i j h) colimitIso i) := by
  letI : IsLocalHom colimitIso.toRingHom :=
    Function.Surjective.isLocalHom _ colimitIso.surjective
  -- Proof comment: the stage map into the direct limit is local, and the colimit equivalence
  -- preserves locality under composition.
  exact RingHom.isLocalHom_comp _ _

/-- Strengthened form of Lemma 10.127.10: the directed approximation can be chosen so that all
transition maps and all stage-to-colimit comparison maps are local homomorphisms. -/
theorem exists_directed_local_essFiniteType_approximation_isLocalHom (hf : f.EssFiniteType) :
    ∃ A : DirectedLocalHomApproximation.{u, v, u} f,
      A.HasLocalizationOfQuotientTransitions ∧
        (∀ i j (h : i ≤ j), IsLocalHom (A.map i j h)) ∧
          ∀ i, IsLocalHom
            (Ring.DirectLimit.toLimitHom A.RStage (fun i j h ↦ A.map i j h) A.colimitIso i) := by
  obtain ⟨Γ, hΓ⟩ := exists_fixed_generator_finset_for_essFiniteType_witness (f := f) hf
  refine ⟨fixed_generator_approximation (f := f) Γ hf hΓ, ?_, ?_, ?_⟩
  · intro A B hAB
    -- Proof comment: the localization-of-quotient property is exactly the fraction cover used in
    -- the main theorem.
    exact isLocalizationOfQuotient_of_fraction_cover
      (fixedStageBaseChangeExplicit (f := f) Γ hf hΓ hAB)
      (fixed_stageBaseChange_fraction_cover (f := f) hf hΓ hAB)
  · intro i j h
    -- Proof comment: the source transitions are canonical maps between prime localizations.
    change IsLocalHom (fixedSourceLocalizedTransition h)
    unfold fixedSourceLocalizedTransition
    infer_instance
  · intro i
    -- Proof comment: the stage-to-colimit comparison is local because all transitions are local
    -- and the colimit identification is an isomorphism of local rings.
    haveI : ∀ (a b : (fixed_generator_approximation (f := f) Γ hf hΓ).Λ) (h : a ≤ b),
        IsLocalHom ((fixed_generator_approximation (f := f) Γ hf hΓ).map a b h) := by
      intro a b h
      change IsLocalHom (fixedSourceLocalizedTransition h)
      unfold fixedSourceLocalizedTransition
      infer_instance
    exact toLimitHom_isLocalHom_of_maps _ _ _ i

end
