/-- Helper for Lemma 10.127.10: the localized source transition sends a raw-stage generator to the
corresponding generator in the larger localized source stage. -/
private theorem fixed_source_localized_transition_to_map {A B : Finset R} (hAB : A ⊆ B)
    (x : fixedSourceRawStage A) :
    fixedSourceLocalizedTransition hAB (algebraMap _ _ x) =
      algebraMap _ _ ((fixedSourceRawStageInclusion hAB) x) := by
  simpa [fixedSourceLocalizedTransition] using
    (Localization.localRingHom_to_map
      (I := fixedSourceStagePrime A)
      (J := fixedSourceStagePrime B)
      (f := (fixedSourceRawStageInclusion hAB))
