/-- Helper for Lemma 10.127.10: the localized target transition is the identity on a fixed stage.
-/
private theorem fixed_target_localized_transition_id (Γ : Finset S) (A : Finset R) :
    fixedTargetLocalizedTransition (f := f) Γ (A := A) (B := A) (Finset.Subset.refl _) = RingHom.id _ := by
  have hincl :
      (fixedTargetRawStageInclusion (f := f) Γ (A := A) (B := A) (Finset.Subset.refl _)) =
        RingHom.id _ := by
    ext x
    simp only [RingHom.id_apply, fixedTargetRawStageInclusion_coe]
