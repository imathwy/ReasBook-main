/-- Helper for Lemma 10.127.10: the ambient target comparison maps are compatible with localized
target transitions in the fixed-generator system. -/
private theorem fixed_target_localized_to_ambient_comp (Γ : Finset S) {A B : Finset R}
    (hAB : A ⊆ B) :
    (fixedTargetLocalizedToAmbient (f := f) Γ B).comp
        (fixedTargetLocalizedTransition (f := f) Γ hAB) =
      fixedTargetLocalizedToAmbient (f := f) Γ A := by
  -- Proof comment: the target-side comparison is likewise determined on the raw generators.
  refine IsLocalization.ringHom_ext (fixedTargetStagePrime (f := f) Γ A).primeCompl ?_
  ext x
  simp only [RingHom.comp_apply]
  rw [fixed_target_localized_transition_to_map, fixed_target_localized_to_ambient_to_map,
    fixed_target_localized_to_ambient_to_map]
  exact fixedTargetRawStageInclusion_coe (f := f) Γ hAB x

/-- Helper for Lemma 10.127.10: the localized fixed-generator stage square still commutes after
mapping each stage back to the ambient local rings. -/
private theorem fixed_localized_stage_to_ambient_commutes (Γ : Finset S) (A : Finset R) :
    (fixedTargetLocalizedToAmbient (f := f) Γ A).comp (fixedLocalizedStageMap (f := f) Γ A) =
      f.comp (fixedSourceLocalizedToAmbient A) := by
  -- Proof comment: verify the square on the algebra-map generators of the localized source stage.
  apply IsLocalization.ringHom_ext (fixedSourceStagePrime A).primeCompl
  ext x
  simp only [RingHom.comp_apply]
  rw [fixed_localizedStageMap_to_map]
  rw [fixed_target_localized_to_ambient_to_map, fixed_source_localized_to_ambient_to_map]
  exact fixedRawStageMap_coe (f := f) Γ A x

/-- Helper for Lemma 10.127.10: the localized source transitions form the directed system used for
the source colimit of the fixed-generator approximation. -/
private instance fixedSourceLocalizedDirectedSystem :
    DirectedSystem
      (fun A : Finset R ↦ fixedSourceLocalizedStage A)
      (fun _ _ hAB ↦ fixedSourceLocalizedTransition hAB) where
  map_self := by
    intro A x
    have h :=
      congrArg
        (fun g :
          fixedSourceLocalizedStage A →+*
            fixedSourceLocalizedStage A => g x)
        (fixed_source_localized_transition_id A)
    simpa using h
  map_map := by
    intro C B A hAB hBC x
    have h :=
      congrArg
        (fun g :
          fixedSourceLocalizedStage A →+*
            fixedSourceLocalizedStage C => g x)
        (fixed_source_localized_transition_comp hAB hBC)
    simpa [RingHom.comp_apply] using h.symm

/-- Helper for Lemma 10.127.10: the localized target transitions form the directed system used for
the target colimit of the fixed-generator approximation. -/
private instance fixedTargetLocalizedDirectedSystem (Γ : Finset S) :
    DirectedSystem
      (fun A : Finset R ↦ fixedTargetLocalizedStage (f := f) Γ A)
      (fun _ _ hAB ↦ fixedTargetLocalizedTransition (f := f) Γ hAB) where
  map_self := by
    intro A x
    have h :=
      congrArg
        (fun g :
          fixedTargetLocalizedStage (f := f) Γ A →+*
            fixedTargetLocalizedStage (f := f) Γ A => g x)
        (fixed_target_localized_transition_id (f := f) Γ A)
    simpa using h
  map_map := by
    intro C B A hAB hBC x
    have h :=
      congrArg
        (fun g :
          fixedTargetLocalizedStage (f := f) Γ A →+*
            fixedTargetLocalizedStage (f := f) Γ C => g x)
        (fixed_target_localized_transition_comp (f := f) Γ hAB hBC)
    simpa [RingHom.comp_apply] using h.symm

/-- Helper for Lemma 10.127.10: each localized fixed-generator stage map is a local homomorphism
because it is the canonical map between localizations at pulled-back maximal ideals. -/
private theorem fixedLocalizedStageMap_isLocalHom (Γ : Finset S) (A : Finset R) :
    IsLocalHom (fixedLocalizedStageMap (f := f) Γ A) := by
  -- Proof comment: apply the standard locality theorem for canonical localization maps.
  simpa [fixedLocalizedStageMap] using
    (Localization.isLocalHom_localRingHom
      (I := fixedSourceStagePrime A)
      (J := fixedTargetStagePrime (f := f) Γ A)
      (f := fixedRawStageMap (f := f) Γ A)
      (fixed_stage_zero_map_comap_maximal_eq (f := f) Γ A).symm)

/-- Helper for Lemma 10.127.10: every ambient source element already appears in some localized
fixed-generator source stage, namely the singleton coefficient stage. -/
private theorem fixed_source_localized_stage_cover (r : R) :
    ∃ A : Finset R, ∃ x : fixedSourceLocalizedStage A,
      fixedSourceLocalizedToAmbient A x = r := by
  refine ⟨{r},
    algebraMap
      (fixedSourceRawStage ({r} : Finset R))
      (fixedSourceLocalizedStage ({r} : Finset R))
      ?_, ?_⟩
  · exact ⟨r, Algebra.subset_adjoin (by simp)⟩
  · simpa using
      (fixed_source_localized_to_ambient_to_map ({r} : Finset R)
        ⟨r, Algebra.subset_adjoin (by simp)⟩)

