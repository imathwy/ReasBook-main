namespace DirectedFiniteTypeHomApproximation

variable {f : R →+* S} (A : DirectedFiniteTypeHomApproximation f)

/-- The transition maps in an approximation system present later target stages as quotients of the
corresponding base changes from earlier stages. -/
def HasSurjectiveBaseChangeTransitions : Prop :=
  ∀ {i j : A.Λ} (h : i ≤ j), Function.Surjective (A.stageBaseChangeMap h)

end DirectedFiniteTypeHomApproximation

section

/-- Helper for Lemma 10.127.16: throughout this file we view `S` as an `R`-algebra via the
ambient ring map `f`. -/
private noncomputable instance instAlgebraOfRingHom (f : R →+* S) : Algebra R S :=
  f.toAlgebra

variable (f : R →+* S)

/-- Helper for Lemma 10.127.16: finite subsets of `R` form a directed preorder under inclusion,
with union as a common upper bound. -/
private instance fixedGeneratorIndexDirectedOrder : IsDirectedOrder (Finset R) where
  directed := by
    classical
    intro A B
    refine ⟨A ∪ B, ?_, ?_⟩
    · intro a ha
      exact Finset.mem_union.mpr <| Or.inl ha
    · intro b hb
      exact Finset.mem_union.mpr <| Or.inr hb

/-- Helper for Lemma 10.127.16: a finite-type ring map admits one finite target generator set
that generates `S` as an `R`-algebra. -/
private theorem exists_fixed_generator_finset_for_finiteType (hf : f.FiniteType) :
    letI := f.toAlgebra
    ∃ Γ : Finset S, Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S) := by
  letI := f.toAlgebra
  haveI : Algebra.FiniteType R S := by
    simpa [RingHom.algebraMap_toAlgebra] using hf
  let e : (⊤ : Subalgebra R S) ≃ₐ[R] S := Subalgebra.topEquiv
  have htop : Algebra.FiniteType R (⊤ : Subalgebra R S) :=
    Algebra.FiniteType.equiv inferInstance e.symm
  have hfg : (⊤ : Subalgebra R S).FG :=
    (Subalgebra.fg_iff_finiteType (⊤ : Subalgebra R S)).mpr htop
  rcases Subalgebra.fg_def.mp hfg with ⟨t, htfin, htTop⟩
  -- Proof comment: convert the finite generating set from a finite set in `Set S` to a `Finset`.
  refine ⟨htfin.toFinset, ?_⟩
  simpa using htTop

namespace FixedGeneratorFiniteTypeData

variable (f : R →+* S)

/-- Helper for Lemma 10.127.16: the source stage indexed by a finite subset of `R` is the
`ℤ`-subalgebra generated by that subset. -/
private abbrev sourceStage (_f : R →+* S) (A : Finset R) : Subalgebra ℤ R :=
  Algebra.adjoin ℤ (A : Set R)

/-- Helper for Lemma 10.127.16: the ambient inclusion from a source stage back to `R`. -/
private abbrev sourceStageToAmbient (A : Finset R) :
    sourceStage f A →+* R :=
  (sourceStage f A).val.toRingHom

/-- Helper for Lemma 10.127.16: the ambient map from a source stage into `S` induced by `f`. -/
private abbrev sourceStageToTargetAmbient (A : Finset R) :
    sourceStage f A →+* S :=
  f.comp (sourceStage f A).val.toRingHom

/-- Helper for Lemma 10.127.16: each source stage inherits its ambient `S`-algebra structure from
the ring map `f`. -/
private noncomputable instance instAlgebraSourceStage (A : Finset R) :
    Algebra (sourceStage f A) S :=
  (sourceStageToTargetAmbient f A).toAlgebra

/-- Helper for Lemma 10.127.16: the target stage indexed by a finite subset of `R` is generated
over the corresponding source stage by one fixed finite generator set `Γ`. -/
private abbrev targetStage (Γ : Finset S) (A : Finset R) : Subalgebra ℤ S :=
  let _ : Algebra (sourceStage f A) S := (sourceStageToTargetAmbient f A).toAlgebra
  (Algebra.adjoin (sourceStage f A) (Γ : Set S)).restrictScalars ℤ

/-- Helper for Lemma 10.127.16: the ambient inclusion from a target stage back to `S`. -/
private abbrev targetStageToAmbient (Γ : Finset S) (A : Finset R) :
    targetStage f Γ A →+* S :=
  (targetStage f Γ A).val.toRingHom

/-- Helper for Lemma 10.127.16: enlarging the source coefficient set enlarges the corresponding
source stage. -/
private theorem sourceStage_mono {A B : Finset R} (hAB : A ⊆ B) :
    sourceStage f A ≤ sourceStage f B :=
  Algebra.adjoin_mono hAB

/-- Helper for Lemma 10.127.16: enlarging the source coefficient set enlarges the ambient image
of the corresponding source stage in `S`. -/
private theorem sourceStageRange_mono {A B : Finset R} (hAB : A ⊆ B) :
    ((IsScalarTower.toAlgHom ℤ (sourceStage f A) S).range : Set S) ⊆
      ((IsScalarTower.toAlgHom ℤ (sourceStage f B) S).range : Set S) := by
  rintro x ⟨y, rfl⟩
  -- Proof comment: the canonical inclusion of the smaller source stage into the larger one keeps
  -- the same ambient value in `S`.
  exact ⟨Subalgebra.inclusion (sourceStage_mono (f := f) hAB) y, rfl⟩

/-- Helper for Lemma 10.127.16: after restricting scalars back to `ℤ`, the target stage is the
`ℤ`-subalgebra generated by the source-stage image together with the fixed generators `Γ`. -/
private theorem targetStage_eq_adjoin_union (Γ : Finset S) (A : Finset R) :
    targetStage f Γ A =
      Algebra.adjoin ℤ
        (((IsScalarTower.toAlgHom ℤ (sourceStage f A) S).range : Set S) ∪ (Γ : Set S)) := by
  let _ : Algebra (sourceStage f A) S := (sourceStageToTargetAmbient f A).toAlgebra
  have hrange :
      targetStage f Γ A =
        (Algebra.adjoin
          (IsScalarTower.toAlgHom ℤ (sourceStage f A) S).range
          (Γ : Set S)).restrictScalars ℤ := by
    -- Proof comment: rewrite the target stage through the image of the source stage inside `S`.
    simpa [targetStage] using
      (IsScalarTower.adjoin_range_toAlgHom
        (R := ℤ) (S := sourceStage f A) (A := S) (t := (Γ : Set S))).symm
  rw [hrange, Algebra.restrictScalars_adjoin]

/-- Helper for Lemma 10.127.16: enlarging the source coefficient set enlarges the corresponding
target stage while keeping the fixed generators unchanged. -/
private theorem targetStage_mono (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B) :
    targetStage f Γ A ≤ targetStage f Γ B := by
  -- Proof comment: rewrite both target stages as ambient `ℤ`-adjoins and apply monotonicity.
  rw [targetStage_eq_adjoin_union (f := f) Γ A, targetStage_eq_adjoin_union (f := f) Γ B]
  refine Algebra.adjoin_mono ?_
  exact Set.union_subset
    (fun x hx ↦ Or.inl <| sourceStageRange_mono (f := f) hAB hx)
    (fun x hx ↦ Or.inr hx)

/-- Helper for Lemma 10.127.16: the transition maps on source stages are the obvious inclusions. -/
private abbrev sourceTransition {A B : Finset R} (hAB : A ⊆ B) :
    sourceStage f A →+* sourceStage f B :=
  Subalgebra.inclusion (sourceStage_mono (f := f) hAB)

/-- Helper for Lemma 10.127.16: the transition maps on target stages are the obvious inclusions. -/
private abbrev targetTransition (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B) :
    targetStage f Γ A →+* targetStage f Γ B :=
  Subalgebra.inclusion (targetStage_mono (f := f) Γ hAB)

/-- Helper for Lemma 10.127.16: the source-stage transition is literally the subtype inclusion on
ambient elements of `R`. -/
private theorem sourceTransition_coe {A B : Finset R} (hAB : A ⊆ B)
    (x : sourceStage f A) :
    ((sourceTransition (f := f) hAB x : sourceStage f B) : R) = x := by
  -- Route correction: avoid a definitional-kernel proof here; unfold the inclusion and rewrite
  -- with the standard subtype-coercion lemma instead.
  unfold sourceTransition
  rw [AlgHom.coe_toRingHom, Subalgebra.coe_inclusion]

/-- Helper for Lemma 10.127.16: the target-stage transition is literally the subtype inclusion on
ambient elements of `S`. -/
private theorem targetTransition_coe (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B)
    (x : targetStage f Γ A) :
    ((targetTransition (f := f) Γ hAB x : targetStage f Γ B) : S) = x := by
  -- Route correction: prove the target-side inclusion propositionally to avoid the same kernel
  -- timeout as on the source side.
  unfold targetTransition
  rw [AlgHom.coe_toRingHom, Subalgebra.coe_inclusion]

/-- Helper for Lemma 10.127.16: the source-stage maps form a directed system because inclusions
of subalgebras compose strictly. -/
private instance sourceDirectedSystem :
    DirectedSystem
      (fun A : Finset R ↦ sourceStage f A)
      (fun _ _ hAB ↦ sourceTransition (f := f) hAB) := by
  refine ⟨?_, ?_⟩
  · intro A x
    rfl
  · intro C B A hAB hBC x
    -- Proof comment: composing two source-stage inclusions is the canonical inclusion to the top
    -- stage.
    simpa using
      (Subalgebra.inclusion_inclusion
        (sourceStage_mono (f := f) hAB)
        (sourceStage_mono (f := f) hBC)
        x)

/-- Helper for Lemma 10.127.16: the target-stage maps form a directed system because inclusions
of subalgebras compose strictly. -/
private instance targetDirectedSystem (Γ : Finset S) :
    DirectedSystem
      (fun A : Finset R ↦ targetStage f Γ A)
      (fun _ _ hAB ↦ targetTransition (f := f) Γ hAB) := by
  refine ⟨?_, ?_⟩
  · intro A x
    rfl
  · intro C B A hAB hBC x
    -- Proof comment: composing two target-stage inclusions is again the canonical inclusion.
    simpa using
      (Subalgebra.inclusion_inclusion
        (targetStage_mono (f := f) Γ hAB)
        (targetStage_mono (f := f) Γ hBC)
        x)

/-- Helper for Lemma 10.127.16: the stage map is the algebra map from the source stage into the
corresponding target stage. -/
private abbrev stageMap (Γ : Finset S) (A : Finset R) :
    sourceStage f A →+* targetStage f Γ A :=
  let _ : Algebra (sourceStage f A) S := (sourceStageToTargetAmbient f A).toAlgebra
  algebraMap (sourceStage f A) (Algebra.adjoin (sourceStage f A) (Γ : Set S))

/-- Helper for Lemma 10.127.16: after evaluating in the ambient ring `S`, the stage map is just
the algebra map from the source stage into `S`. -/
private theorem stageMap_coe (Γ : Finset S) (A : Finset R) (x : sourceStage f A) :
    ((stageMap f Γ A x : targetStage f Γ A) : S) =
      algebraMap (sourceStage f A) S x := by
  rfl

/-- Helper for Lemma 10.127.16: the stage square commutes because both paths are the same subtype
map inside the ambient ring `S`. -/
private theorem stage_square_commutes (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B) :
    (stageMap f Γ B).comp (sourceTransition (f := f) hAB) =
      (targetTransition (f := f) Γ hAB).comp (stageMap f Γ A) := by
  -- Proof comment: compare both composites after evaluating in the ambient ring `S`, where both
  -- paths become the same restricted ring map `f`.
  ext x
  rw [RingHom.comp_apply, RingHom.comp_apply, targetTransition_coe, stageMap_coe, stageMap_coe]
  change f (((sourceTransition (f := f) hAB x : sourceStage f B) : R)) = f (x : R)
  rw [sourceTransition_coe]

/-- Helper for Lemma 10.127.16: each source stage is finite type over `ℤ` because it is generated
by a finite subset of `R`. -/
private theorem sourceStage_finiteType (A : Finset R) :
    (Int.castRingHom (sourceStage f A)).FiniteType := by
  exact RingHom.finiteType_algebraMap.mpr <|
    by
      simpa [sourceStage] using
        (Algebra.FiniteType.adjoin_of_finite (R := ℤ) (A := R) (t := (A : Set R))
          A.finite_toSet)

/-- Helper for Lemma 10.127.16: each stage map is finite type because the target stage is
generated over the source stage by the fixed finite set `Γ`. -/
private theorem stageMap_finiteType (Γ : Finset S) (A : Finset R) :
    RingHom.FiniteType (stageMap f Γ A) := by
  let _ : Algebra (sourceStage f A) S := (sourceStageToTargetAmbient f A).toAlgebra
  change RingHom.FiniteType
    (algebraMap (sourceStage f A) (Algebra.adjoin (sourceStage f A) (Γ : Set S)))
  rw [RingHom.finiteType_algebraMap]
  -- Proof comment: adjoining finitely many fixed generators over the source stage is finite type.
  exact Algebra.FiniteType.adjoin_of_finite
    (R := sourceStage f A) (A := S) (t := (Γ : Set S)) Γ.finite_toSet

/-- Helper for Lemma 10.127.16: every ambient source element already occurs on a singleton source
stage. -/
private theorem source_stage_cover (r : R) :
    ∃ A : Finset R, ∃ x : sourceStage f A, (x : R) = r := by
  refine ⟨{r}, ⟨r, Algebra.subset_adjoin (by simp)⟩, rfl⟩

/-- Helper for Lemma 10.127.16: every ambient target element already appears on some fixed
generator stage. -/
private theorem exists_fixed_generator_stage_of_element {Γ : Finset S}
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S))
    (s : S) :
    ∃ A : Finset R, ∃ x : targetStage f Γ A, (x : S) = s := by
  classical
  letI := f.toAlgebra
  have hdesc :
      ∀ t ∈ Algebra.adjoin R (↑Γ : Set S),
        ∃ A : Finset R, ∃ x : targetStage f Γ A, (x : S) = t := by
    intro t ht
    -- Proof comment: induct on an expression of `t` in the fixed `R`-algebra generated by `Γ`,
    -- enlarging the source coefficient stage only when coefficients from `R` appear.
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ ht
    · intro y hy
      refine ⟨∅, ⟨y, ?_⟩, rfl⟩
      let _ : Algebra (sourceStage f ∅) S := (sourceStageToTargetAmbient f ∅).toAlgebra
      simpa [targetStage] using
        (Algebra.subset_adjoin (R := sourceStage f ∅) hy :
          y ∈ Algebra.adjoin (sourceStage f ∅) (Γ : Set S))
    · intro r
      refine ⟨{r}, stageMap f Γ {r} ⟨r, Algebra.subset_adjoin (by simp)⟩, ?_⟩
      -- Proof comment: the singleton source stage already contains the required coefficient.
      change ((stageMap f Γ {r} ⟨r, Algebra.subset_adjoin (by simp)⟩ : targetStage f Γ {r}) :
          S) = algebraMap R S r
      rfl
    · intro x y _ _ hx hy
      rcases hx with ⟨Ax, xStage, rfl⟩
      rcases hy with ⟨Ay, yStage, rfl⟩
      refine ⟨Ax ∪ Ay,
        targetTransition (f := f) Γ Finset.subset_union_left xStage +
          targetTransition (f := f) Γ Finset.subset_union_right yStage,
        ?_⟩
      -- Proof comment: both stage elements map to the same ambient values after moving to the
      -- union stage.
      simp only [Subalgebra.coe_add, targetTransition_coe]
    · intro x y _ _ hx hy
      rcases hx with ⟨Ax, xStage, rfl⟩
      rcases hy with ⟨Ay, yStage, rfl⟩
      refine ⟨Ax ∪ Ay,
        targetTransition (f := f) Γ Finset.subset_union_left xStage *
          targetTransition (f := f) Γ Finset.subset_union_right yStage,
        ?_⟩
      -- Proof comment: multiplication is handled identically after passing to the union stage.
      simp only [Subalgebra.coe_mul, targetTransition_coe]
  have hs : s ∈ Algebra.adjoin R (↑Γ : Set S) := by
    rw [hΓ]
    simp
  exact hdesc s hs

/-- Helper for Lemma 10.127.16: the ambient source comparison maps are compatible with source-stage
transitions. -/
private theorem sourceStageToAmbient_comp {A B : Finset R} (hAB : A ⊆ B) :
    (sourceStageToAmbient (f := f) B).comp (sourceTransition (f := f) hAB) =
      sourceStageToAmbient (f := f) A := by
  ext x
  -- Proof comment: both maps are the ambient subtype inclusion of the smaller source stage.
  exact sourceTransition_coe (f := f) hAB x

/-- Helper for Lemma 10.127.16: evaluating the source ambient compatibility square on an element
gives the same ambient value in `R`. -/
private theorem sourceStageToAmbient_compatible {A B : Finset R} (hAB : A ⊆ B)
    (x : sourceStage f A) :
    sourceStageToAmbient (f := f) B (sourceTransition (f := f) hAB x) =
      sourceStageToAmbient (f := f) A x := by
  -- Proof comment: this is the elementwise form of the source ambient compatibility identity.
  exact sourceTransition_coe (f := f) hAB x

/-- Helper for Lemma 10.127.16: the ambient target comparison maps are compatible with
target-stage transitions. -/
private theorem targetStageToAmbient_comp (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B) :
    (targetStageToAmbient (f := f) Γ B).comp (targetTransition (f := f) Γ hAB) =
      targetStageToAmbient (f := f) Γ A := by
  ext x
  -- Proof comment: the target-stage transitions are again subtype inclusions in the ambient ring.
  exact targetTransition_coe (f := f) Γ hAB x

/-- Helper for Lemma 10.127.16: evaluating the target ambient compatibility square on an element
gives the same ambient value in `S`. -/
private theorem targetStageToAmbient_compatible (Γ : Finset S) {A B : Finset R} (hAB : A ⊆ B)
    (x : targetStage f Γ A) :
    targetStageToAmbient (f := f) Γ B (targetTransition (f := f) Γ hAB x) =
      targetStageToAmbient (f := f) Γ A x := by
  -- Proof comment: this is the elementwise form of the target ambient compatibility identity.
  exact targetTransition_coe (f := f) Γ hAB x

/-- Helper for Lemma 10.127.16: the source direct-limit comparison map is the lift of the ambient
source-stage inclusions. -/
private noncomputable def sourceColimitToAmbient :
    Ring.DirectLimit
        (fun A : Finset R ↦ sourceStage f A)
        (fun _ _ hAB ↦ sourceTransition (f := f) hAB) →+* R :=
  -- Proof comment: package the compatible ambient source-stage inclusions into the universal
  -- direct-limit map.
  Ring.DirectLimit.lift
    (fun A : Finset R ↦ sourceStage f A)
    (fun _ _ hAB ↦ sourceTransition (f := f) hAB)
    R
    (fun A ↦ sourceStageToAmbient (f := f) A)
    (fun A B hAB x ↦ sourceStageToAmbient_compatible (f := f) (A := A) (B := B) hAB x)

/-- Helper for Lemma 10.127.16: the target direct-limit comparison map is the lift of the ambient
target-stage inclusions. -/
private noncomputable def targetColimitToAmbient (Γ : Finset S) :
    Ring.DirectLimit
        (fun A : Finset R ↦ targetStage f Γ A)
        (fun _ _ hAB ↦ targetTransition (f := f) Γ hAB) →+* S :=
  -- Proof comment: package the compatible ambient target-stage inclusions into the universal
  -- direct-limit map on the target system.
  Ring.DirectLimit.lift
    (fun A : Finset R ↦ targetStage f Γ A)
    (fun _ _ hAB ↦ targetTransition (f := f) Γ hAB)
    S
    (fun A ↦ targetStageToAmbient (f := f) Γ A)
    (fun A B hAB x ↦ targetStageToAmbient_compatible (f := f) Γ (A := A) (B := B) hAB x)

/-- Helper for Lemma 10.127.16: the source direct-limit comparison is bijective because every
ambient source element already appears on a singleton source stage. -/
private theorem sourceColimitToAmbient_bijective :
    Function.Bijective (sourceColimitToAmbient (f := f)) := by
  refine ⟨?_, ?_⟩
  · -- Proof comment: injectivity is the standard direct-limit criterion for stagewise injective
    -- subtype maps.
    exact Ring.DirectLimit.lift_injective
      (G := fun A : Finset R ↦ sourceStage f A)
      (f := fun A B hAB ↦ sourceTransition (f := f) hAB)
      (P := R)
      (g := fun A ↦ sourceStageToAmbient (f := f) A)
      (Hg := fun A B hAB x ↦ sourceStageToAmbient_compatible (f := f) (A := A) (B := B) hAB x)
      (fun _ ↦ Subtype.val_injective)
  · -- Proof comment: every ambient source element comes from a singleton source stage.
    intro r
    rcases source_stage_cover (f := f) r with ⟨A, x, rfl⟩
    refine ⟨Ring.DirectLimit.of
      (fun B : Finset R ↦ sourceStage f B)
      (fun B C hBC ↦ sourceTransition (f := f) hBC)
      A x, ?_⟩
    rw [sourceColimitToAmbient, Ring.DirectLimit.lift_of]
    rfl

/-- Helper for Lemma 10.127.16: the target direct-limit comparison is bijective because every
ambient target element already appears on one fixed-generator stage. -/
private theorem targetColimitToAmbient_bijective (Γ : Finset S)
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S)) :
    Function.Bijective (targetColimitToAmbient (f := f) Γ) := by
  refine ⟨?_, ?_⟩
  · -- Proof comment: injectivity again comes from stagewise injective subtype maps.
    exact Ring.DirectLimit.lift_injective
      (G := fun A : Finset R ↦ targetStage f Γ A)
      (f := fun A B hAB ↦ targetTransition (f := f) Γ hAB)
      (P := S)
      (g := fun A ↦ targetStageToAmbient (f := f) Γ A)
      (Hg := fun A B hAB x ↦
        targetStageToAmbient_compatible (f := f) Γ (A := A) (B := B) hAB x)
      (fun _ ↦ Subtype.val_injective)
  · -- Proof comment: every ambient target element comes from one fixed-generator stage.
    intro s
    rcases exists_fixed_generator_stage_of_element (f := f) hΓ s with ⟨A, x, rfl⟩
    refine ⟨Ring.DirectLimit.of
      (fun B : Finset R ↦ targetStage f Γ B)
      (fun B C hBC ↦ targetTransition (f := f) Γ hBC)
      A x, ?_⟩
    rw [targetColimitToAmbient, Ring.DirectLimit.lift_of]
    rfl

/-- Helper for Lemma 10.127.16: the source direct limit identifies with `R` via the ambient
subtype maps. -/
private noncomputable def sourceColimitIso :
    Ring.DirectLimit
        (fun A : Finset R ↦ sourceStage f A)
        (fun _ _ hAB ↦ sourceTransition (f := f) hAB) ≃+* R :=
  -- Proof comment: upgrade the bijective comparison map to a ring equivalence.
  RingEquiv.ofBijective
    (sourceColimitToAmbient (f := f))
    (sourceColimitToAmbient_bijective (f := f))

/-- Helper for Lemma 10.127.16: the target direct limit identifies with `S` via the ambient
subtype maps. -/
private noncomputable def targetColimitIso (Γ : Finset S)
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S)) :
    Ring.DirectLimit
        (fun A : Finset R ↦ targetStage f Γ A)
        (fun _ _ hAB ↦ targetTransition (f := f) Γ hAB) ≃+* S :=
  -- Proof comment: upgrade the bijective target comparison map to a ring equivalence.
  RingEquiv.ofBijective
    (targetColimitToAmbient (f := f) Γ)
    (targetColimitToAmbient_bijective (f := f) Γ hΓ)

/-- Helper for Lemma 10.127.16: evaluating the stage map in the ambient ring recovers the
original ring homomorphism `f` on each source stage. -/
private theorem stage_to_ambient_commutes (Γ : Finset S) (A : Finset R) :
    (targetStageToAmbient (f := f) Γ A).comp (stageMap f Γ A) =
      f.comp (sourceStageToAmbient (f := f) A) := by
  ext x
  rfl

/-- Helper for Lemma 10.127.16: the induced map on colimits agrees with the ambient map `f` on
every canonical source-stage generator. -/
private theorem colimit_comm_toAmbient_on_generators (Γ : Finset S) (A : Finset R)
    (x : sourceStage f A) :
    ((targetColimitToAmbient (f := f) Γ).comp
        (Ring.DirectLimit.map
          (fun B ↦ stageMap f Γ B)
          (fun _ _ hAB ↦ stage_square_commutes (f := f) Γ hAB)))
      (Ring.DirectLimit.of
        (fun B : Finset R ↦ sourceStage f B)
        (fun _ _ hAB ↦ sourceTransition (f := f) hAB)
        A x) =
      ((f.comp (sourceColimitToAmbient (f := f)))
        (Ring.DirectLimit.of
          (fun B : Finset R ↦ sourceStage f B)
          (fun _ _ hAB ↦ sourceTransition (f := f) hAB)
          A x)) := by
  -- Proof comment: evaluate both direct-limit morphisms on the same stage generator and read off
  -- the ambient square on stage `A`.
  rw [RingHom.comp_apply, Ring.DirectLimit.map_apply_of, targetColimitToAmbient,
    Ring.DirectLimit.lift_of, sourceColimitToAmbient, RingHom.comp_apply, Ring.DirectLimit.lift_of]
  simpa [RingHom.comp_apply] using
    congrArg
      (fun g : sourceStage f A →+* S => g x)
      (stage_to_ambient_commutes (f := f) Γ A)

/-- Helper for Lemma 10.127.16: before identifying the direct limits with `R` and `S`, the map
on colimits induced by the stage maps is exactly the ambient map `f`. -/
private theorem colimit_comm_toAmbient (Γ : Finset S) :
    (targetColimitToAmbient (f := f) Γ).comp
        (Ring.DirectLimit.map
          (fun A ↦ stageMap f Γ A)
          (fun _ _ hAB ↦ stage_square_commutes (f := f) Γ hAB)) =
      f.comp (sourceColimitToAmbient (f := f)) := by
  -- Proof comment: direct-limit ring homomorphisms are equal once they agree on every canonical
  -- stage generator.
  apply Ring.DirectLimit.hom_ext
  intro A
  ext x
  exact colimit_comm_toAmbient_on_generators (f := f) Γ A x

/-- Helper for Lemma 10.127.16: after identifying both directed colimits with the ambient rings,
the induced colimit map is exactly the original ring homomorphism `f`. -/
private theorem colimit_comm (Γ : Finset S)
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S)) :
    (targetColimitIso (f := f) Γ hΓ).toRingHom.comp
        (Ring.DirectLimit.map
          (fun A ↦ stageMap f Γ A)
          (fun _ _ hAB ↦ stage_square_commutes (f := f) Γ hAB)) =
      f.comp (sourceColimitIso (f := f)).toRingHom := by
  -- Proof comment: the chosen colimit isomorphisms are exactly the ambient comparison maps,
  -- repackaged as `RingEquiv.ofBijective`.
  simpa [sourceColimitIso, targetColimitIso] using
    (colimit_comm_toAmbient (f := f) Γ)

/-- Helper for Lemma 10.127.16: the explicit fixed-generator directed approximation attached to a
single finite generating set `Γ`. -/
private noncomputable def fixed_generator_approximation (Γ : Finset S)
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S)) :
    DirectedFiniteTypeHomApproximation f :=
  { Λ := Finset R
    instPreorder := inferInstance
    instNonempty := inferInstance
    instDirectedOrder := fixedGeneratorIndexDirectedOrder (R := R)
    RStage := fun A ↦ sourceStage f A
    SStage := fun A ↦ targetStage f Γ A
    instCommRingRStage := fun _ ↦ inferInstance
    instCommRingSStage := fun _ ↦ inferInstance
    RMap := fun _ _ hAB ↦ sourceTransition (f := f) hAB
    SMap := fun _ _ hAB ↦ targetTransition (f := f) Γ hAB
    instDirectedSystemRStage := sourceDirectedSystem (f := f)
    instDirectedSystemSStage := targetDirectedSystem (f := f) Γ
    stageMap := fun A ↦ stageMap f Γ A
    comm := fun {_ _} hAB ↦ stage_square_commutes (f := f) Γ hAB
    source_finiteType := sourceStage_finiteType (f := f)
    target_finiteType := stageMap_finiteType (f := f) Γ
    colimitSource := sourceColimitIso (f := f)
    colimitTarget := targetColimitIso (f := f) Γ hΓ
    colimit_comm := colimit_comm (f := f) Γ hΓ }

/-- Helper for Lemma 10.127.16: the owner base-change map, retyped on the concrete source and
target stages so later proofs can work without an opaque local approximation constant. -/
private noncomputable def fixedStageBaseChangeExplicit {Γ : Finset S}
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S))
    {A B : Finset R} (hAB : A ⊆ B) :
    let _ : Algebra (sourceStage f A) (targetStage f Γ A) := (stageMap f Γ A).toAlgebra
    let _ : Algebra (sourceStage f A) (sourceStage f B) := (sourceTransition (f := f) hAB).toAlgebra
    let _ : Module (sourceStage f A) (targetStage f Γ A) := Algebra.toModule
    let _ : Module (sourceStage f A) (sourceStage f B) := Algebra.toModule
    targetStage f Γ A ⊗[sourceStage f A] sourceStage f B →+* targetStage f Γ B :=
  (fixed_generator_approximation (f := f) Γ hΓ).stageBaseChangeMap (i := A) (j := B) hAB

/-- Helper for Lemma 10.127.16: on pure tensors, the stage base-change map should multiply the
target transition and the later stage map. -/
private theorem fixed_stageBaseChangeMap_tmul {Γ : Finset S}
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S))
    {A B : Finset R} (hAB : A ⊆ B)
    (x : targetStage f Γ A) (y : sourceStage f B) :
    let _ : Algebra (sourceStage f A) (targetStage f Γ A) := (stageMap f Γ A).toAlgebra
    let _ : Algebra (sourceStage f A) (sourceStage f B) := (sourceTransition (f := f) hAB).toAlgebra
    let _ : Module (sourceStage f A) (targetStage f Γ A) := Algebra.toModule
    let _ : Module (sourceStage f A) (sourceStage f B) := Algebra.toModule
    fixedStageBaseChangeExplicit (f := f) (Γ := Γ) hΓ hAB (x ⊗ₜ[sourceStage f A] y) =
      targetTransition (f := f) Γ hAB x * stageMap f Γ B y := by
  -- Proof comment: unfold the owner base-change map, evaluate `productMap` on a pure tensor, and
  -- let the remaining algebra-hom coercions close definitionally.
  simp
  rfl

/-- Helper for Lemma 10.127.16: on pure tensors, the explicit base-change map multiplies the
target transition and the later stage map. -/
private theorem fixed_stageBaseChangeExplicit_tmul {Γ : Finset S}
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S))
    {A B : Finset R} (hAB : A ⊆ B)
    (x : targetStage f Γ A) (y : sourceStage f B) :
    let _ : Algebra (sourceStage f A) (targetStage f Γ A) := (stageMap f Γ A).toAlgebra
    let _ : Algebra (sourceStage f A) (sourceStage f B) := (sourceTransition (f := f) hAB).toAlgebra
    let _ : Module (sourceStage f A) (targetStage f Γ A) := Algebra.toModule
    let _ : Module (sourceStage f A) (sourceStage f B) := Algebra.toModule
    fixedStageBaseChangeExplicit (f := f) (Γ := Γ) hΓ hAB (x ⊗ₜ[sourceStage f A] y) =
      targetTransition (f := f) Γ hAB x * stageMap f Γ B y := by
  -- Proof comment: this is exactly the owner pure-tensor computation, retyped on the explicit
  -- source and target stages.
  exact fixed_stageBaseChangeMap_tmul (f := f) (Γ := Γ) hΓ hAB x y

/-- Helper for Lemma 10.127.16: every fixed target generator lies in every target stage. -/
private theorem fixed_generator_mem_targetStage {Γ : Finset S} (A : Finset R) {y : S}
    (hy : y ∈ (↑Γ : Set S)) :
    y ∈ targetStage f Γ A := by
  let _ : Algebra (sourceStage f A) S := (sourceStageToTargetAmbient f A).toAlgebra
  -- Proof comment: the target stage is the algebra generated by the fixed set `Γ`, so each
  -- generator belongs to every stage by definition.
  simpa [targetStage] using
    (Algebra.subset_adjoin (R := sourceStage f A) hy :
      y ∈ Algebra.adjoin (sourceStage f A) (Γ : Set S))

/-- Helper for Lemma 10.127.16: the image of a source-stage element already belongs to the
corresponding target stage. -/
private theorem source_stage_image_mem_targetStage (Γ : Finset S) (A : Finset R)
    (r : sourceStage f A) :
    algebraMap (sourceStage f A) S r ∈ targetStage f Γ A := by
  -- Proof comment: the stage map lands in the target stage, and its ambient value is the source
  -- algebra map into `S`.
  simpa [stageMap_coe (f := f) Γ A r] using (stageMap f Γ A r).property

/-- Helper for Lemma 10.127.16: the subtype representing a source-stage image is exactly the
stage-map value. -/
private theorem source_stage_image_subtype_eq_stageMap (Γ : Finset S) (A : Finset R)
    (r : sourceStage f A) :
    (⟨algebraMap (sourceStage f A) S r,
        source_stage_image_mem_targetStage (f := f) Γ A r⟩ : targetStage f Γ A) =
      stageMap f Γ A r := by
  -- Proof comment: both target-stage elements have the same ambient value in `S`.
  apply Subtype.ext
  simpa [stageMap_coe (f := f) Γ A r]

/-- Helper for Lemma 10.127.16: the image of a later source-stage coefficient is hit by the
explicit base-change map from the right tensor factor. -/
private theorem fixed_stageBaseChange_hits_coefficient {Γ : Finset S}
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S))
    {A B : Finset R} (hAB : A ⊆ B) (r : sourceStage f B) :
    ∃ p, fixedStageBaseChangeExplicit (f := f) hΓ hAB p = stageMap f Γ B r := by
  let _ : Algebra (sourceStage f A) (targetStage f Γ A) := (stageMap f Γ A).toAlgebra
  let _ : Algebra (sourceStage f A) (sourceStage f B) := (sourceTransition (f := f) hAB).toAlgebra
  let _ : Module (sourceStage f A) (targetStage f Γ A) := Algebra.toModule
  let _ : Module (sourceStage f A) (sourceStage f B) := Algebra.toModule
  -- Proof comment: the coefficient image is the value of the base-change map on the pure tensor
  -- `1 ⊗ r`.
  refine ⟨(1 : targetStage f Γ A) ⊗ₜ[sourceStage f A] r, ?_⟩
  rw [fixed_stageBaseChangeExplicit_tmul (f := f) (Γ := Γ) hΓ hAB 1 r, map_one, one_mul]

/-- Helper for Lemma 10.127.16: every fixed generator from `Γ` is hit by the explicit
base-change map from the left tensor factor. -/
private theorem fixed_stageBaseChange_hits_gamma {Γ : Finset S}
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S))
    {A B : Finset R} (hAB : A ⊆ B) {y : S} (hy : y ∈ (↑Γ : Set S)) :
    ∃ p,
      fixedStageBaseChangeExplicit (f := f) hΓ hAB p =
        (⟨y, fixed_generator_mem_targetStage (f := f) B hy⟩ : targetStage f Γ B) := by
  let _ : Algebra (sourceStage f A) (targetStage f Γ A) := (stageMap f Γ A).toAlgebra
  let _ : Algebra (sourceStage f A) (sourceStage f B) := (sourceTransition (f := f) hAB).toAlgebra
  let _ : Module (sourceStage f A) (targetStage f Γ A) := Algebra.toModule
  let _ : Module (sourceStage f A) (sourceStage f B) := Algebra.toModule
  -- Proof comment: a fixed generator is the image of the pure tensor `y ⊗ 1`.
  refine ⟨(⟨y, fixed_generator_mem_targetStage (f := f) A hy⟩ : targetStage f Γ A) ⊗ₜ[
      sourceStage f A] (1 : sourceStage f B), ?_⟩
  rw [fixed_stageBaseChangeExplicit_tmul (f := f) (Γ := Γ) hΓ hAB
      ⟨y, fixed_generator_mem_targetStage (f := f) A hy⟩ 1,
    map_one, mul_one]
  apply Subtype.ext
  simp

/-- Helper for Lemma 10.127.16: a subring of a target stage that contains every later-stage
coefficient image and every fixed generator contains the whole target stage. -/
private theorem fixed_targetStage_mem_of_generators {Γ : Finset S} {B : Finset R}
    (T : Subring (targetStage f Γ B))
    (hcoeff : ∀ r : sourceStage f B, stageMap f Γ B r ∈ T)
    (hgamma : ∀ {y : S} (hy : y ∈ (↑Γ : Set S)),
      (⟨y, fixed_generator_mem_targetStage (f := f) B hy⟩ : targetStage f Γ B) ∈ T)
    (a : targetStage f Γ B) :
    a ∈ T := by
  obtain ⟨s, hs⟩ := a
  let P : S → Prop := fun t =>
    ∀ ht : t ∈ targetStage f Γ B, (⟨t, ht⟩ : targetStage f Γ B) ∈ T
  have hP :
      ∀ t,
        t ∈ Algebra.adjoin ℤ
            (((IsScalarTower.toAlgHom ℤ (sourceStage f B) S).range : Set S) ∪ (Γ : Set S)) →
          P t := by
    intro t ht
    -- Proof comment: the target stage is generated by coefficient images and the fixed finite set
    -- `Γ`, so induction on the ambient adjoin reduces membership to those generators.
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ ht
    · intro y hy hyStage
      rcases Set.mem_union _ _ _ |>.mp hy with hyRange | hyGamma
      · rcases hyRange with ⟨r, rfl⟩
        have hstage :
            (⟨algebraMap (sourceStage f B) S r, hyStage⟩ : targetStage f Γ B) =
              stageMap f Γ B r := by
          apply Subtype.ext
          simp [stageMap_coe]
        simpa [hstage] using hcoeff r
      · have hstage :
            (⟨y, hyStage⟩ : targetStage f Γ B) =
              (⟨y, fixed_generator_mem_targetStage (f := f) B hyGamma⟩ : targetStage f Γ B) := by
          apply Subtype.ext
          simp
        simpa [hstage] using hgamma hyGamma
    · intro n hnStage
      have hcast :
          (⟨algebraMap ℤ S n, hnStage⟩ : targetStage f Γ B) = (n : targetStage f Γ B) := by
        apply Subtype.ext
        simp
      rw [hcast]
      exact intCast_mem T n
    · intro x y hx hy ihx ihy hxyStage
      have hxT : x ∈ targetStage f Γ B := by
        simpa [targetStage_eq_adjoin_union (f := f) Γ B] using hx
      have hyT : y ∈ targetStage f Γ B := by
        simpa [targetStage_eq_adjoin_union (f := f) Γ B] using hy
      have hadd :
          (⟨x + y, hxyStage⟩ : targetStage f Γ B) =
            (⟨x, hxT⟩ : targetStage f Γ B) + (⟨y, hyT⟩ : targetStage f Γ B) := by
        apply Subtype.ext
        simp
      rw [hadd]
      exact T.add_mem (ihx hxT) (ihy hyT)
    · intro x y hx hy ihx ihy hxyStage
      have hxT : x ∈ targetStage f Γ B := by
        simpa [targetStage_eq_adjoin_union (f := f) Γ B] using hx
      have hyT : y ∈ targetStage f Γ B := by
        simpa [targetStage_eq_adjoin_union (f := f) Γ B] using hy
      have hmul :
          (⟨x * y, hxyStage⟩ : targetStage f Γ B) =
            (⟨x, hxT⟩ : targetStage f Γ B) * (⟨y, hyT⟩ : targetStage f Γ B) := by
        apply Subtype.ext
        simp
      rw [hmul]
      exact T.mul_mem (ihx hxT) (ihy hyT)
  -- Proof comment: rewrite the target stage as the required `ℤ`-adjoin and apply the induction
  -- result to the underlying ambient element of `a`.
  have hsAdjoin :
      s ∈ Algebra.adjoin ℤ
        (((IsScalarTower.toAlgHom ℤ (sourceStage f B) S).range : Set S) ∪ (Γ : Set S)) := by
    simpa [targetStage_eq_adjoin_union (f := f) Γ B] using hs
  exact hP s hsAdjoin hs

/-- Helper for Lemma 10.127.16: every element of the later target stage has a preimage under the
explicit base-change map. -/
private theorem fixed_targetStage_preimage {Γ : Finset S}
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S))
    {A B : Finset R} (hAB : A ⊆ B) (z : targetStage f Γ B) :
    ∃ p, fixedStageBaseChangeExplicit (f := f) hΓ hAB p = z := by
  let _ : Algebra (sourceStage f A) (targetStage f Γ A) := (stageMap f Γ A).toAlgebra
  let _ : Algebra (sourceStage f A) (sourceStage f B) := (sourceTransition (f := f) hAB).toAlgebra
  let _ : Module (sourceStage f A) (targetStage f Γ A) := Algebra.toModule
  let _ : Module (sourceStage f A) (sourceStage f B) := Algebra.toModule
  -- Proof comment: it is enough to show that `z` lies in the range subring of the explicit
  -- base-change map, and the previous generator theorem gives exactly that.
  have hz :
      z ∈ (fixedStageBaseChangeExplicit (f := f) hΓ hAB).range := by
    refine fixed_targetStage_mem_of_generators (f := f)
      ((fixedStageBaseChangeExplicit (f := f) hΓ hAB).range) ?_ ?_ z
    · intro r
      obtain ⟨p, hp⟩ := fixed_stageBaseChange_hits_coefficient (f := f) (Γ := Γ) hΓ hAB r
      exact RingHom.mem_range.mpr ⟨p, hp⟩
    · intro y hy
      obtain ⟨p, hp⟩ := fixed_stageBaseChange_hits_gamma (f := f) (Γ := Γ) hΓ hAB hy
      exact RingHom.mem_range.mpr ⟨p, hp⟩
  exact RingHom.mem_range.mp hz

/-- Helper for Lemma 10.127.16: every stage-transition base-change map in the fixed-generator
system is surjective. -/
private theorem fixed_stageBaseChange_surjective {Γ : Finset S}
    (hΓ : letI := f.toAlgebra
      Algebra.adjoin R (↑Γ : Set S) = (⊤ : Subalgebra R S))
    {A B : Finset R} (hAB : A ⊆ B) :
    let _ : Algebra (sourceStage f A) (targetStage f Γ A) := (stageMap f Γ A).toAlgebra
    let _ : Algebra (sourceStage f A) (sourceStage f B) := (sourceTransition (f := f) hAB).toAlgebra
    let _ : Module (sourceStage f A) (targetStage f Γ A) := Algebra.toModule
    let _ : Module (sourceStage f A) (sourceStage f B) := Algebra.toModule
    ∀ z : targetStage f Γ B, ∃ p, fixedStageBaseChangeExplicit (f := f) (Γ := Γ) hΓ hAB p = z := by
  intro _ _ _ _ z
  -- Proof comment: the preimage theorem already constructs a tensor mapping to the chosen target
  -- element.
  exact fixed_targetStage_preimage (f := f) (Γ := Γ) hΓ hAB z

end FixedGeneratorFiniteTypeData

-- Proof sketch: choose one finite generator set `Γ` for `S` over `R`, index stages by finite
-- subsets of `R`, let the source stage be the `ℤ`-subalgebra generated by the chosen subset, and
-- let the target stage be generated over that source stage by the same fixed `Γ`. The direct
-- limits recover `R` and `S`, and the later target stage is generated by the image of the earlier
-- target stage after base change together with no new target generators, so the canonical
-- base-change map is surjective.
/-- Lemma 10.127.16: if a ring map `f : R →+* S` is of finite type, then `f` is the direct limit
of a directed system of ring maps `R_λ → S_λ` such that each `R_λ` is of finite type over `ℤ`,
each `S_λ` is of finite type over `R_λ`, and for each transition `λ ≤ μ` the canonical map
`S_λ ⊗[R_λ] R_μ → S_μ` is surjective, presenting `S_μ` as a quotient of the base change. -/
theorem exists_directedFiniteTypeQuotientApproximation (f : R →+* S) (hf : f.FiniteType) :
    ∃ A : DirectedFiniteTypeHomApproximation.{u, v, u} f, A.HasSurjectiveBaseChangeTransitions := by
  classical
  letI := f.toAlgebra
  rcases exists_fixed_generator_finset_for_finiteType (f := f) hf with ⟨Γ, hΓ⟩
  let A := FixedGeneratorFiniteTypeData.fixed_generator_approximation (f := f) Γ hΓ
  refine ⟨A, ?_⟩
  intro i j hij
  -- Proof comment: for the fixed-generator approximation, the owner transition base-change map is
  -- exactly the explicit map already proved surjective.
  simpa [A, FixedGeneratorFiniteTypeData.fixed_generator_approximation,
    FixedGeneratorFiniteTypeData.fixedStageBaseChangeExplicit, Function.Surjective] using
    (FixedGeneratorFiniteTypeData.fixed_stageBaseChange_surjective
      (f := f) (Γ := Γ) hΓ hij)

end
