import Mathlib
import Mathlib.Tactic.Recall
import stacks_project.Chap10.Lemma_10_58_1
import stacks_project.Chap10.Lemma_10_58_4
import stacks_project.Chap10.Proposition_10_58_7

-- Declarations for this item will be appended below by the statement pipeline.

open HomogeneousIdeal
open CategoryTheory
open CategoryTheory.ShortComplex.ShortExact
open scoped DirectSum

noncomputable section

universe u v

attribute [local instance] MvPolynomial.gradedAlgebra
attribute [local instance] MvPolynomial.decomposition
attribute [local instance] MvPolynomial.HomogeneousSubmodule.gradedMonoid

/- Definition 10.58.3: the notion of a numerical polynomial used in Example 10.58.9 is the
canonical project definition `IsNumericalPolynomial`. -/
recall IsNumericalPolynomial {A : Type u} [AddCommGroup A] (f : ℤ → A) : Prop

/-- The standard nonnegative grading on `k[X₁, …, X_d]` shifts an integer grading on a graded
module by addition. -/
local instance : AddAction ℕ ℤ where
  vadd n d := (n : ℤ) + d
  zero_vadd := by
    intro d
    change ((0 : ℕ) : ℤ) + d = d
    simp
  add_vadd := by
    intro m n d
    change (((m + n : ℕ) : ℤ) + d) = ((m : ℤ) + ((n : ℤ) + d))
    simp [Nat.cast_add, add_assoc]

section

variable {k : Type u} [Field k] {d : ℕ}
variable {M : Type v} [AddCommGroup M] [Module (MvPolynomial (Fin d) k) M]
variable [Module k M] [IsScalarTower k (MvPolynomial (Fin d) k) M]
variable (ℳ : ℤ → Submodule (MvPolynomial (Fin d) k) M)
variable [DirectSum.Decomposition ℳ]
variable [SetLike.GradedSMul (MvPolynomial.homogeneousSubmodule (Fin d) k) ℳ]
variable [Module.Finite (MvPolynomial (Fin d) k) M]

local notation "S" => MvPolynomial (Fin d) k
local notation "𝒜" => MvPolynomial.homogeneousSubmodule (Fin d) k

/-- Helper for Example 10.58.9: constant polynomials lie in the degree-zero piece of the standard
grading on `MvPolynomial (Fin d) k`. -/
lemma mvPolynomial_C_mem_degree_zero (r : k) :
    (MvPolynomial.C r : S) ∈ 𝒜 0 := by
  -- Rewrite the degree-zero piece as the scalar submodule and then use that constants are scalars.
  simpa [MvPolynomial.homogeneousSubmodule_zero, Submodule.one_eq_range] using
    (show (MvPolynomial.C r : S) ∈ LinearMap.range (Algebra.linearMap k S) from ⟨r, rfl⟩)

/-- Helper for Example 10.58.9: every variable lies in the degree-one piece of the standard
grading on `MvPolynomial (Fin d) k`. -/
lemma mvPolynomial_X_mem_degree_one (i : Fin d) :
    (MvPolynomial.X i : S) ∈ 𝒜 1 := by
  -- The standard grading places each variable in degree one by definition of homogeneity.
  exact MvPolynomial.mem_homogeneousSubmodule 1 (MvPolynomial.X i) |>.2 (MvPolynomial.isHomogeneous_X _ i)

/-- Helper for Example 10.58.9: the degree-zero algebra together with the degree-one part generates
the whole polynomial ring. -/
lemma mvPolynomial_standard_grading_adjoin_degree_one_eq_top :
    Algebra.adjoin (𝒜 0) (𝒜 1 : Set S) = ⊤ := by
  let B : Subalgebra (𝒜 0) S := Algebra.adjoin (𝒜 0) (𝒜 1 : Set S)
  -- It is enough to show that every polynomial belongs to the generated subalgebra.
  rw [show B = ⊤ ↔ ⊤ ≤ B by rw [← top_le_iff]]
  intro p _
  -- The polynomial ring is generated by constants and the variables.
  refine MvPolynomial.induction_on p ?_ ?_ ?_
  · intro r
    change (MvPolynomial.C r : S) ∈ B
    let r₀ : 𝒜 0 := ⟨MvPolynomial.C r, mvPolynomial_C_mem_degree_zero (k := k) (d := d) r⟩
    exact B.algebraMap_mem r₀
  · intro p q hp hq
    exact B.add_mem hp hq
  · intro p i hp
    exact B.mul_mem hp (Algebra.subset_adjoin (mvPolynomial_X_mem_degree_one (k := k) (d := d) i))

/-- Helper for Example 10.58.9: the canonical scalar map into the degree-zero piece is injective. -/
lemma mvPolynomial_degree_zero_algebraMap_injective :
    Function.Injective (Algebra.ofId k (𝒜 0)) := by
  intro r s hrs
  exact MvPolynomial.C_injective (Fin d) k (Subtype.ext_iff.mp hrs)

/-- Helper for Example 10.58.9: the canonical scalar map into the degree-zero piece is surjective. -/
lemma mvPolynomial_degree_zero_algebraMap_surjective :
    Function.Surjective (Algebra.ofId k (𝒜 0)) := by
  intro x
  -- A degree-zero homogeneous polynomial is a constant polynomial.
  have hx_one : ((x : 𝒜 0) : S) ∈ (1 : Submodule k S) := by
    simpa [MvPolynomial.homogeneousSubmodule_zero] using x.2
  rw [Submodule.one_eq_range] at hx_one
  rcases hx_one with ⟨r, hr⟩
  refine ⟨r, ?_⟩
  apply Subtype.ext
  simpa [Algebra.ofId_apply] using hr

/-- Helper for Example 10.58.9: the degree-zero piece is reached bijectively by constants from the
base field. -/
lemma mvPolynomial_degree_zero_algebraMap_bijective :
    Function.Bijective (Algebra.ofId k (𝒜 0)) :=
  ⟨mvPolynomial_degree_zero_algebraMap_injective (k := k) (d := d),
    mvPolynomial_degree_zero_algebraMap_surjective (k := k) (d := d)⟩

/-- Helper for Example 10.58.9: the degree-zero piece of the standard grading is canonically the
base field. -/
noncomputable def mvPolynomial_degree_zero_algEquiv :
    k ≃ₐ[k] 𝒜 0 :=
  AlgEquiv.ofBijective (Algebra.ofId k (𝒜 0))
    (mvPolynomial_degree_zero_algebraMap_bijective (k := k) (d := d))

/-- Helper for Example 10.58.9: under the degree-zero equivalence, a scalar is represented by the
corresponding constant polynomial. -/
@[simp] lemma mvPolynomial_degree_zero_algEquiv_apply_coe (r : k) :
    ((mvPolynomial_degree_zero_algEquiv (k := k) (d := d) r : 𝒜 0) : S) = MvPolynomial.C r := by
  rfl

/-- Helper for Example 10.58.9: the degree-zero piece is finite-dimensional over the base field. -/
noncomputable local instance mvPolynomial_degree_zero_moduleFinite : Module.Finite k (𝒜 0) :=
  Module.Finite.equiv (mvPolynomial_degree_zero_algEquiv (k := k) (d := d)).toLinearEquiv

/-- Helper for Example 10.58.9: the underlying `k`-dimension of a finitely generated module over
the degree-zero piece. -/
private noncomputable def graded_piece_generator_dimension (N : FGModuleCat (𝒜 0)) : ℤ :=
  let _ : Module.Finite (𝒜 0) N.obj := N.property
  let _ : Module k N.obj := Module.restrictScalars k (𝒜 0) N.obj
  let _ : IsScalarTower k (𝒜 0) N.obj := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  let _ : Module.Finite k N.obj := Module.Finite.trans (R := k) (A := 𝒜 0) N.obj
  (Module.finrank k N.obj : ℤ)

/-- Helper for Example 10.58.9: the underlying `k`-dimension functional on finitely generated
modules over the degree-zero piece vanishes on Grothendieck relations. -/
private theorem graded_piece_dimension_relations_le_ker :
    modulePropertyK0Relations (𝒜 0) (ModuleCat.isFG (𝒜 0)) ≤
      (FreeAbelianGroup.lift (graded_piece_generator_dimension (k := k) (d := d))).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨T, hT⟩, rfl⟩
  change
    FreeAbelianGroup.lift
        (graded_piece_generator_dimension (k := k) (d := d))
        (FreeAbelianGroup.of T.X₂ - FreeAbelianGroup.of T.X₁ - FreeAbelianGroup.of T.X₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  let U : ShortComplex (ModuleCat (𝒜 0)) := T.map (ModuleCat.isFG (𝒜 0)).ι
  let _ : Module.Finite (𝒜 0) T.X₁.obj := T.X₁.property
  let _ : Module.Finite (𝒜 0) T.X₂.obj := T.X₂.property
  let _ : Module.Finite (𝒜 0) T.X₃.obj := T.X₃.property
  let _ : Module k T.X₁.obj := Module.restrictScalars k (𝒜 0) T.X₁.obj
  let _ : Module k T.X₂.obj := Module.restrictScalars k (𝒜 0) T.X₂.obj
  let _ : Module k T.X₃.obj := Module.restrictScalars k (𝒜 0) T.X₃.obj
  let _ : IsScalarTower k (𝒜 0) T.X₁.obj := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  let _ : IsScalarTower k (𝒜 0) T.X₂.obj := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  let _ : IsScalarTower k (𝒜 0) T.X₃.obj := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  let _ : Module.Finite k T.X₁.obj := Module.Finite.trans (R := k) (A := 𝒜 0) T.X₁.obj
  let _ : Module.Finite k T.X₂.obj := Module.Finite.trans (R := k) (A := 𝒜 0) T.X₂.obj
  let _ : Module.Finite k T.X₃.obj := Module.Finite.trans (R := k) (A := 𝒜 0) T.X₃.obj
  let fₖ : T.X₁.obj →ₗ[k] T.X₂.obj :=
    { toFun := U.f.hom
      map_add' := U.f.hom.map_add
      map_smul' := fun r x ↦ by
        change U.f.hom ((algebraMap k (𝒜 0) r) • x) = (algebraMap k (𝒜 0) r) • U.f.hom x
        exact U.f.hom.map_smul _ _ }
  let gₖ : T.X₂.obj →ₗ[k] T.X₃.obj :=
    { toFun := U.g.hom
      map_add' := U.g.hom.map_add
      map_smul' := fun r x ↦ by
        change U.g.hom ((algebraMap k (𝒜 0) r) • x) = (algebraMap k (𝒜 0) r) • U.g.hom x
        exact U.g.hom.map_smul _ _ }
  have hU : U.ShortExact := by
    simpa [U] using hT
  have hExact : Function.Exact U.f.hom U.g.hom := by
    simpa using (moduleCat_exact_iff_function_exact U).mp hU.exact
  have hlength :
      Module.length k T.X₂.obj =
        Module.length k T.X₁.obj + Module.length k T.X₃.obj := by
    simpa [U] using Module.length_eq_add_of_exact
      fₖ
      gₖ
      hU.moduleCat_injective_f
      hU.moduleCat_surjective_g
      hExact
  have hlen₁ : Module.length k T.X₁.obj ≠ ⊤ := Module.length_ne_top
  have hlen₃ : Module.length k T.X₃.obj ≠ ⊤ := Module.length_ne_top
  have hlengthNat :
      (Module.length k T.X₂.obj).toNat =
        (Module.length k T.X₁.obj).toNat + (Module.length k T.X₃.obj).toNat := by
    simpa [ENat.toNat_add hlen₁ hlen₃] using congrArg ENat.toNat hlength
  have hlengthInt :
      (Module.finrank k T.X₂.obj : ℤ) =
        (Module.finrank k T.X₁.obj : ℤ) + (Module.finrank k T.X₃.obj : ℤ) := by
    simpa [Nat.cast_add, Module.length_eq_finrank] using
      congrArg (fun n : ℕ ↦ (n : ℤ)) hlengthNat
  have hdim :
      graded_piece_generator_dimension (k := k) (d := d) T.X₂ =
        graded_piece_generator_dimension (k := k) (d := d) T.X₁ +
          graded_piece_generator_dimension (k := k) (d := d) T.X₃ := by
    simpa [graded_piece_generator_dimension] using hlengthInt
  linarith

/-- Helper for Example 10.58.9: the canonical `k`-dimension homomorphism on `K'_0((S₀))` for the
degree-zero piece of the standard grading. -/
private def graded_piece_dimension_map :
    finiteGrothendieckGroup (𝒜 0) →+ ℤ :=
  ModulePropertyK0.lift (𝒜 0)
    (graded_piece_generator_dimension (k := k) (d := d))
    (graded_piece_dimension_relations_le_ker (k := k) (d := d))

/-- Helper for Example 10.58.9: the degree-zero `k`-dimension map evaluates on a generator by
underlying `k`-dimension. -/
@[simp] private theorem graded_piece_dimension_map_apply_of
    (N : FGModuleCat (𝒜 0)) :
    graded_piece_dimension_map (k := k) (d := d)
        (finiteGrothendieckGroupOf (𝒜 0) N) =
      graded_piece_generator_dimension (k := k) (d := d) N := by
  simpa [graded_piece_dimension_map] using
    ModulePropertyK0.lift_of (𝒜 0)
      (graded_piece_generator_dimension (k := k) (d := d))
      (graded_piece_dimension_relations_le_ker (k := k) (d := d))
      N

/-- Helper for Example 10.58.9: applying the degree-zero `k`-dimension map to the class of a graded piece
recovers its `k`-dimension. -/
lemma length_of_graded_piece_class_eq_finrank (n : ℤ) :
    graded_piece_dimension_map (k := k) (d := d) (gradedPieceFiniteGrothendieckGroupClass 𝒜 ℳ n) =
      (Module.finrank k (ℳ n) : ℤ) := by
  let _ : Module (𝒜 0) M := Module.restrictScalars (𝒜 0) S M
  let _ : Module (𝒜 0) (ℳ n) := Module.restrictScalars (𝒜 0) S (ℳ n)
  let _ : Module.Finite (𝒜 0) (ℳ n) := finite_degree_component_of_finiteType 𝒜 ℳ n
  have hrestrict_smul :
      ∀ (r : k) (m : ℳ n), ((algebraMap k (𝒜 0) r) : 𝒜 0) • m = r • m := by
    intro r m
    change (mvPolynomial_degree_zero_algEquiv (k := k) (d := d) r) • m = r • m
    ext
    change (MvPolynomial.C r : S) • (m : M) = (r : k) • (m : M)
    simpa using (algebraMap_smul S r (m : M))
  have hrestrict :
      @Module.finrank k (ℳ n) Field.toSemifield.toDivisionSemiring.toSemiring (ℳ n).addCommMonoid
          (Module.restrictScalars k (𝒜 0) (ℳ n)) =
        Module.finrank k (ℳ n) := by
    have hrank :
        @Module.rank k (ℳ n) Field.toSemifield.toDivisionSemiring.toSemiring (ℳ n).addCommMonoid
            (Module.restrictScalars k (𝒜 0) (ℳ n)) =
          Module.rank k (ℳ n) := by
      exact
        @rank_eq_of_equiv_equiv
          k k (ℳ n) (ℳ n)
          Field.toSemifield.toDivisionSemiring.toSemiring
          (ℳ n).addCommMonoid
          (Module.restrictScalars k (𝒜 0) (ℳ n))
          Field.toSemifield.toDivisionSemiring.toSemiring
          (ℳ n).addCommMonoid
          (ℳ n).module'
          (RingHom.id k)
          (AddEquiv.refl (ℳ n))
          (by
            constructor
            · intro x y hxy
              simpa using hxy
            · intro x
              exact ⟨x, rfl⟩)
          hrestrict_smul
    simpa [Module.finrank] using congrArg Cardinal.toNat hrank
  -- Unfold the owner-valued class and evaluate the canonical dimension map on the generator.
  simpa [gradedPieceFiniteGrothendieckGroupClass, graded_piece_generator_dimension,
    hrestrict] using
    graded_piece_dimension_map_apply_of (k := k) (d := d) (FGModuleCat.of (𝒜 0) (ℳ n))

-- Proof sketch: convert the standard generated-in-degree-one hypothesis for `k[X₁, …, X_d]` to
-- `Ideal.span (S₁) = S₊` via Lemma `10.58.1`, apply Proposition `10.58.7` to the owner-valued
-- function `n ↦ [Mₙ] ∈ K'_0(S₀)`, and then compose with the canonical length map
-- `K'_0(S₀) → ℤ`. For the standard grading, this length map is exactly
-- `n ↦ dim_k(M_n)`.
/-- Example 10.58.9: a finitely generated graded module over the standard graded polynomial ring
`k[X₁, …, X_d]`, represented by `MvPolynomial (Fin d) k`, has a Hilbert function
`n ↦ dim_k(M_n)` which is a numerical polynomial. -/
theorem graded_mvPolynomial_module_dimension_isNumericalPolynomial :
    IsNumericalPolynomial (fun n ↦ (Module.finrank k (ℳ n) : ℤ)) := by
  -- The standard polynomial grading is generated in degree one.
  have hgenerated : Algebra.adjoin (𝒜 0) (𝒜 1 : Set S) = ⊤ := by
    exact mvPolynomial_standard_grading_adjoin_degree_one_eq_top (k := k) (d := d)
  -- Convert the algebra-generation statement into the irrelevant-ideal generation hypothesis.
  have hspan : Ideal.span (𝒜 1 : Set S) = 𝒜₊.toIdeal :=
    (homogeneous_adjoin_eq_top_iff_span_eq_irrelevant 𝒜 (𝒜 1 : Set S)
      (fun _ hx ↦ ⟨1, by simp, hx⟩)).1 hgenerated
  -- Proposition 10.58.7 gives the owner-valued Hilbert function as a numerical polynomial.
  have howner :
      IsNumericalPolynomial (gradedPieceFiniteGrothendieckGroupClass 𝒜 ℳ) := by
    exact
      gradedPieceFiniteGrothendieckGroupClass_isNumericalPolynomial_of_span_degreeOne_eq_irrelevant
        𝒜 ℳ hspan
  -- Identify the owner-valued Hilbert function `n ↦ [Mₙ] ∈ K'_0(S₀)` with the usual
  -- dimension function `n ↦ dim_k(M_n)` by passing to the canonical degree-zero comparison map.
  -- Postcompose with the degree-zero length map and rewrite it as `k`-dimension.
  convert IsNumericalPolynomial.comp howner (graded_piece_dimension_map (k := k) (d := d)) using 1
  funext n
  exact (length_of_graded_piece_class_eq_finrank (k := k) (d := d) (ℳ := ℳ) n).symm

end
