import Mathlib
import Mathlib.Tactic.Recall
import StacksProject_2024.Chap10.Definition_10_17_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

open PrimeSpectrum
open scoped PrimeSpectrum

section

variable {R : Type u} [CommRing R]

/- Lemma 10.17.2 (1): the prime spectrum of `R` is empty if and only if `R` is the zero ring. -/
recall isEmpty_iff_subsingleton

section Nontrivial

variable [Nontrivial R]

/- Lemma 10.17.2 (2): every nonzero ring admits a maximal ideal. -/
recall Ideal.exists_maximal

/-- Lemma 10.17.2 (3): every nonzero ring admits a minimal prime ideal. -/
-- Proof sketch: apply `Ideal.nonempty_minimalPrimes` to the proper ideal `⊥`, using
-- `bot_ne_top` in a nontrivial ring, and unpack the resulting `Nonempty`.
theorem exists_minimal_prime_ideal :
    ∃ p : Ideal R, p ∈ minimalPrimes R := by
  simpa [minimalPrimes] using
    (show Nonempty ((⊥ : Ideal R).minimalPrimes) from Ideal.nonempty_minimalPrimes bot_ne_top)

end Nontrivial

/- Lemma 10.17.2 (4): if `I ⊆ p` and `p` is prime, then there exists a prime `q` with
`I ⊆ q ⊆ p` such that `q` is minimal over `I`. -/
recall Ideal.exists_minimalPrimes_le

/- Lemma 10.17.2 (5): the zero locus of the ideal generated by `T` equals the zero locus of the
subset `T`. -/
recall zeroLocus_span

/- Lemma 10.17.2 (6): the zero locus of an ideal depends only on its radical. -/
recall zeroLocus_radical

/- Lemma 10.17.2 (7): the radical of `I` is the intersection of all prime ideals containing `I`.
-/
recall Ideal.radical_eq_sInf

/- Lemma 10.17.2 (8): the zero locus of an ideal is empty exactly when the ideal is the unit
ideal. -/
recall zeroLocus_empty_iff_eq_top

/- Lemma 10.17.2 (9): the union of the zero loci of `I` and `J` is the zero locus of `I ∩ J`.
Equivalently, `zeroLocus (I ⊓ J) = zeroLocus I ∪ zeroLocus J`. -/
recall zeroLocus_inf

/- Lemma 10.17.2 (10): for a family of ideals `(I a)`, the intersection of their zero loci equals
the zero locus of the union of the underlying subsets. -/
recall zeroLocus_iUnion

/- Lemma 10.17.2 (11): `D(f)` is the complement of `V(f)` in `Spec R`. -/
recall basicOpen_eq_zeroLocus_compl

/- Lemma 10.17.2 (12): `D(f)` is empty if and only if `f` is nilpotent. -/
recall basicOpen_eq_bot_iff

/-- Lemma 10.17.2 (13): multiplying `f` by a unit does not change `D(f)`. -/
-- Proof sketch: use the canonical owner identity `basicOpen_mul`, then observe that `D(u) = ⊤`
-- for a unit `u`.
theorem D_eq_of_unit_mul (u : Rˣ) (f : R) :
    D((u : R) * f) = D(f) := by
  rw [basicOpen_mul]
  have hu : D((u : R)) = ⊤ := by
    ext p
    constructor
    · intro _
      simp
    · intro _ hu
      exact p.2.ne_top (Ideal.eq_top_of_isUnit_mem p.asIdeal hu u.isUnit)
  simp [hu]

/-- Lemma 10.17.2 (14): if `p` does not lie in `V(I)`, there is some `f ∈ I`
such that `D(f)` contains `p` and is disjoint from `V(I)`. -/
-- Proof sketch: choose `f ∈ I` with `f ∉ p` from the negation of `p ∈ V(I)`. Then `p ∈ D(f)`,
-- and any prime in `D(f)` cannot contain `I`, since it would contain this chosen element of `I`.
theorem exists_D_disjoint_zeroLocus_of_not_mem (I : Ideal R) (p : PrimeSpectrum R)
    (hp : p ∉ V((I : Set R))) :
    ∃ f : R, f ∈ I ∧
      p ∈ D(f) ∧
        Disjoint (D(f) : Set (PrimeSpectrum R)) (V((I : Set R))) := by
  rw [mem_zeroLocus, Set.not_subset] at hp
  obtain ⟨f, hfI, hfp⟩ := hp
  refine ⟨f, hfI, hfp, ?_⟩
  refine Set.disjoint_left.2 fun x hx₁ hx₂ ↦ ?_
  exact hx₁ (hx₂ hfI)

/- Lemma 10.17.2 (15): `D(fg)` is the intersection of `D(f)` and `D(g)`. Equivalently,
`basicOpen (f * g) = basicOpen f ⊓ basicOpen g`. -/
recall basicOpen_mul

/-- Lemma 10.17.2 (16): the union of the basic opens `D(f i)` is the
complement of the zero locus of the family `{f i}`. -/
-- Proof sketch: rewrite each `D(f i)` as the complement of `V({f i})`, then apply
-- `zeroLocus_iUnion` to the singleton family.
theorem iUnion_D_eq_compl_zeroLocus_range {ι : Type v} (f : ι → R) :
    (⋃ i, (D(f i) : Set (PrimeSpectrum R))) = (V(Set.range f))ᶜ := by
  ext p
  simp [basicOpen_eq_zeroLocus_compl, Set.not_subset]

/-- Lemma 10.17.2 (17): if `D(f)` is all of `Spec R`, then `f` is a unit. -/
-- Proof sketch: view `D(f)` as the singleton indexed union of basic opens and apply the canonical
-- cover criterion `iSup_basicOpen_eq_top_iff'`, then rewrite
-- `Ideal.span ({f} : Set R) = ⊤` as `IsUnit f`.
theorem isUnit_of_D_eq_top (f : R) (hf : D(f) = ⊤) :
    IsUnit f := by
  have hcover : (⨆ i ∈ ({f} : Set R), D(i)) = D(f) := by
    ext p
    simp
  exact Ideal.span_singleton_eq_top.mp <|
    iSup_basicOpen_eq_top_iff'.mp (hcover.trans hf)

end
