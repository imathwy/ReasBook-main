variable {R : Type u} {S : Type v} [CommRing R] [CommRing S]

namespace RingHom

/-- A ring homomorphism is generated by elements `x` for which some positive power of `X - x`
comes from a polynomial with coefficients in the source. -/
def ShiftPowerPolynomialImageGenerating (f : R →+* S) : Prop :=
  let _ : Algebra R S := f.toAlgebra
  Algebra.adjoin R
      {x : S |
        ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n} = ⊤

/-- Helper for Lemma 10.46.11: a ring homomorphism induces purely inseparable extensions on all
residue fields. -/
def HasPurelyInseparableResidueFieldExtensions (f : R →+* S) : Prop :=
  ∀ q : PrimeSpectrum S,
    let p : PrimeSpectrum R := comap f q
    let fκ := Ideal.ResidueField.map p.asIdeal q.asIdeal f rfl
    let _ : Algebra p.asIdeal.ResidueField q.asIdeal.ResidueField := fκ.toAlgebra
    IsPurelyInseparable p.asIdeal.ResidueField q.asIdeal.ResidueField

/-- Helper for Lemma 10.46.11: the auxiliary prime-power/scalar-image generator predicate used in
the positive-characteristic fibers. -/
def IsGeneratedByPrimePowerAndScalarImage (f : R →+* S) (p : ℕ) [Fact p.Prime] : Prop :=
  let _ : Algebra R S := f.toAlgebra
  Algebra.adjoin R
      {x : S |
        ∃ n : ℕ, 0 < n ∧ x ^ (p ^ n) ∈ f.range ∧ p ^ n • x ∈ f.range} = ⊤

/-- Helper for Lemma 10.46.11: base-ring elements satisfy the prime-power/scalar-image predicate
with exponent `1`. -/
lemma primePowerAndScalarImage_map_mem
    {p : ℕ} [Fact p.Prime] (f : R →+* S) (r : R) :
    ∃ n : ℕ, 0 < n ∧ (f r) ^ (p ^ n) ∈ f.range ∧ p ^ n • f r ∈ f.range := by
  refine ⟨1, Nat.one_pos, ?_, ?_⟩
  · exact ⟨r ^ (p ^ 1), by simp⟩
  · exact ⟨p ^ 1 • r, by simp⟩

/-- Helper for Lemma 10.46.11: the prime-power/scalar-image predicate is multiplicatively closed. -/
lemma primePowerAndScalarImage_mul_mem
    {p : ℕ} [Fact p.Prime] (f : R →+* S) {x y : S}
    (hx : ∃ n : ℕ, 0 < n ∧ x ^ (p ^ n) ∈ f.range ∧ p ^ n • x ∈ f.range)
    (hy : ∃ m : ℕ, 0 < m ∧ y ^ (p ^ m) ∈ f.range ∧ p ^ m • y ∈ f.range) :
    ∃ a : ℕ, 0 < a ∧ (x * y) ^ (p ^ a) ∈ f.range ∧ p ^ a • (x * y) ∈ f.range := by
  rcases hx with ⟨n, hn, hxpow, hxsmul⟩
  rcases hy with ⟨m, hm, hypow, hysmul⟩
  refine ⟨n + m, by omega, ?_, ?_⟩
  · rcases hxpow with ⟨rx, hrx⟩
    rcases hypow with ⟨ry, hry⟩
    refine ⟨rx ^ (p ^ m) * ry ^ (p ^ n), ?_⟩
    calc
      f (rx ^ (p ^ m) * ry ^ (p ^ n))
          = f (rx ^ (p ^ m)) * f (ry ^ (p ^ n)) := by simp
      _ = (f rx) ^ (p ^ m) * (f ry) ^ (p ^ n) := by simp
      _ = (x ^ (p ^ n)) ^ (p ^ m) * (y ^ (p ^ m)) ^ (p ^ n) := by simp [hrx, hry]
      _ = x ^ (p ^ n * p ^ m) * y ^ (p ^ m * p ^ n) := by rw [pow_mul, pow_mul]
      _ = x ^ (p ^ (n + m)) * y ^ (p ^ (n + m)) := by rw [Nat.pow_add, Nat.mul_comm]
      _ = (x * y) ^ (p ^ (n + m)) := by rw [mul_pow]
  · rcases hxsmul with ⟨rx, hrx⟩
    rcases hysmul with ⟨ry, hry⟩
    refine ⟨rx * ry, ?_⟩
    calc
      f (rx * ry) = f rx * f ry := by simp
      _ = (p ^ n • x) * (p ^ m • y) := by simp [hrx, hry]
      _ = p ^ (n + m) • (x * y) := by
            simp [nsmul_eq_mul, Nat.pow_add, mul_assoc, mul_left_comm, mul_comm]

/-- Helper for Lemma 10.46.11: the prime-power/scalar-image predicate is additively closed. -/
lemma primePowerAndScalarImage_add_mem
    {p : ℕ} [Fact p.Prime] (f : R →+* S) {x y : S}
    (hx : ∃ n : ℕ, 0 < n ∧ x ^ (p ^ n) ∈ f.range ∧ p ^ n • x ∈ f.range)
    (hy : ∃ m : ℕ, 0 < m ∧ y ^ (p ^ m) ∈ f.range ∧ p ^ m • y ∈ f.range) :
    ∃ a : ℕ, 0 < a ∧ (x + y) ^ (p ^ a) ∈ f.range ∧ p ^ a • (x + y) ∈ f.range := by
  rcases hx with ⟨n, hn, hxpow, hxsmul⟩
  rcases hy with ⟨m, hm, hypow, hysmul⟩
  let φ : MvPolynomial (Fin 2) ℤ →ₐ[ℤ] S := MvPolynomial.aeval ![x, y]
  let G : Set (MvPolynomial (Fin 2) ℤ) :=
    {MvPolynomial.X (0 : Fin 2) ^ (p ^ n), p ^ n • MvPolynomial.X (0 : Fin 2),
      MvPolynomial.X (1 : Fin 2) ^ (p ^ m), p ^ m • MvPolynomial.X (1 : Fin 2)}
  have hmem_range :
      ∀ z : MvPolynomial (Fin 2) ℤ, z ∈ Algebra.adjoin ℤ G → φ z ∈ f.range := by
    intro z hz
    refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hz
    · intro z hzG
      simp only [G, Set.mem_insert_iff, Set.mem_singleton_iff] at hzG
      rcases hzG with rfl | rfl | rfl | rfl
      · simpa [φ] using hxpow
      · simpa [φ] using hxsmul
      · simpa [φ] using hypow
      · simpa [φ] using hysmul
    · intro z
      exact ⟨(z : R), by simpa [φ] using (f.map_intCast z)⟩
    · intro z w _ _ hz hw
      rcases hz with ⟨rz, hrz⟩
      rcases hw with ⟨rw, hrw⟩
      refine ⟨rz + rw, ?_⟩
      calc
        f (rz + rw) = f rz + f rw := by simp
        _ = φ z + φ w := by rw [hrz, hrw]
        _ = φ (z + w) := by simp [φ]
    · intro z w _ _ hz hw
      rcases hz with ⟨rz, hrz⟩
      rcases hw with ⟨rw, hrw⟩
      refine ⟨rz * rw, ?_⟩
      calc
        f (rz * rw) = f rz * f rw := by simp
        _ = φ z * φ w := by rw [hrz, hrw]
        _ = φ (z * w) := by simp [φ]
  let a : ℕ := n * p ^ n + m * p ^ m + n + m
  have ha_pos : 0 < a := by
    dsimp [a]
    omega
  have hpow_mem_poly :
      (MvPolynomial.X (0 : Fin 2) + MvPolynomial.X (1 : Fin 2)) ^ (p ^ a) ∈ Algebra.adjoin ℤ G := by
    simpa [G, a] using
      binomial_power_mem_mixedPowerMultipleSubalgebra (p := p) (n := n) (m := m) (Fact.out)
  have hsmul_mem_poly :
      p ^ a • (MvPolynomial.X (0 : Fin 2) + MvPolynomial.X (1 : Fin 2)) ∈ Algebra.adjoin ℤ G := by
    refine sum_multiple_mem_mixedPowerMultipleSubalgebra_of_le (p := p) (n := n) (m := m) (a := a)
      ?_ ?_
    · dsimp [a]
      omega
    · dsimp [a]
      omega
  refine ⟨a, ha_pos, ?_, ?_⟩
  · simpa [φ, a] using hmem_range _ hpow_mem_poly
  · simpa [φ, a] using hmem_range _ hsmul_mem_poly

/-- Helper for Lemma 10.46.11: once the displayed generators adjoin to all of `S`, every element
of `S` satisfies the prime-power/scalar-image predicate. -/
lemma mem_primePowerAndScalarImage_of_isGeneratedByPrimePowerAndScalarImage
    {p : ℕ} [Fact p.Prime] (f : R →+* S) (hgen : f.IsGeneratedByPrimePowerAndScalarImage p) :
    ∀ x : S, ∃ n : ℕ, 0 < n ∧ x ^ (p ^ n) ∈ f.range ∧ p ^ n • x ∈ f.range := by
  let _ : Algebra R S := f.toAlgebra
  let G : Set S :=
    {x : S | ∃ n : ℕ, 0 < n ∧ x ^ (p ^ n) ∈ f.range ∧ p ^ n • x ∈ f.range}
  have hgen' : Algebra.adjoin R G = ⊤ := by
    simpa [RingHom.IsGeneratedByPrimePowerAndScalarImage, G] using hgen
  intro x
  have hx : x ∈ Algebra.adjoin R G := by
    rw [hgen']
    simp
  refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ hx
  · intro y hy
    exact hy
  · intro r
    simpa [RingHom.algebraMap_toAlgebra] using primePowerAndScalarImage_map_mem (f := f) (p := p) r
  · intro y z _ _ hy hz
    exact primePowerAndScalarImage_add_mem (f := f) (p := p) hy hz
  · intro y z _ _ hy hz
    exact primePowerAndScalarImage_mul_mem (f := f) (p := p) hy hz

/-- Helper for Lemma 10.46.11: every element of a prime-power/scalar-image generated algebra
inherits a positive power lying in the source image. -/
lemma exists_pow_mem_range_of_isGeneratedByPrimePowerAndScalarImage
    {p : ℕ} [Fact p.Prime] (f : R →+* S) (hgen : f.IsGeneratedByPrimePowerAndScalarImage p) :
    ∀ x : S, ∃ n > 0, x ^ n ∈ f.range := by
  have hp : Nat.Prime p := Fact.out
  intro x
  rcases
      mem_primePowerAndScalarImage_of_isGeneratedByPrimePowerAndScalarImage
        (f := f) (p := p) hgen x with
    ⟨n, hn, hxpow, -⟩
  exact ⟨p ^ n, Nat.pow_pos hp.pos, hxpow⟩

variable {R' : Type w} [CommRing R'] [Algebra R R']

/-- Helper for Lemma 10.46.11: after base change, an element coming from `R` maps to the pure
tensor `1 ⊗ₜ[R] f r`. -/
lemma baseChange_algebraMap_eq_one_tmul
    (f : R →+* S) (r : R) :
    let _ : Algebra R S := f.toAlgebra
    let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
    f' (algebraMap R R' r) = (1 : R') ⊗ₜ[R] f r := by
  let _ : Algebra R S := f.toAlgebra
  let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
  calc
    f' (algebraMap R R' r) = algebraMap R (R' ⊗[R] S) r := by
      rw [← IsScalarTower.algebraMap_apply R R' (R' ⊗[R] S)]
    _ = (1 : R') ⊗ₜ[R] f r := by
      simpa [RingHom.algebraMap_toAlgebra] using
        (Algebra.TensorProduct.algebraMap_apply' (R := R) (A := R') (B := S) r)

end RingHom

/- Canonical owner theorem used in the base-change endgame of Lemma 10.46.11. -/
recall specComap_surjective_stable_under_baseChange

namespace RingHom

/-- Helper for Lemma 10.46.11: the constant coefficient of a shift-power witness shows that a
positive power of the generator already lies in the image. -/
lemma pow_mem_range_of_shift_power_witness
    (f : R →+* S) {x : S} {n : ℕ} {P : R[X]}
    (hP : Polynomial.map f P = (X - C x) ^ n) :
    x ^ n ∈ f.range := by
  -- Extract the constant coefficient of `(X - C x)^n` and remove the harmless sign.
  have hcoeff :
      f (P.coeff 0) = ((X - C x) ^ n).coeff 0 := by
    simpa [Polynomial.coeff_map] using congrArg (fun Q : S[X] => Q.coeff 0) hP
  refine ⟨(-1 : R) ^ n * P.coeff 0, ?_⟩
  calc
    f ((-1 : R) ^ n * P.coeff 0) = f ((-1 : R) ^ n) * f (P.coeff 0) := by simp
    _ = f ((-1 : R) ^ n) * (((X - C x) ^ n).coeff 0) := by rw [hcoeff]
    _ = f ((-1 : R) ^ n) * ((-x) ^ n) := by
          rw [Polynomial.coeff_zero_eq_eval_zero]
          simp
    _ = ((-1 : S) ^ n) * ((-x) ^ n) := by simp
    _ = x ^ n := by
          rw [← mul_pow]
          simp

/-- Helper for Lemma 10.46.11: the next coefficient of a shift-power witness yields the natural
number multiple `n • x` in the image. -/
lemma nsmul_mem_range_of_shift_power_witness
    (f : R →+* S) {x : S} {n : ℕ} (hn : 0 < n) {P : R[X]}
    (hP : Polynomial.map f P = (X - C x) ^ n) :
    n • x ∈ f.range := by
  -- Compute the coefficient of degree `n - 1` via the repeated-root product formula.
  have hcoeff :
      f (P.coeff (n - 1)) = -(∑ i ∈ Finset.range n, x) := by
    calc
      f (P.coeff (n - 1)) = ((X - C x) ^ n).coeff (n - 1) := by
            simpa [Polynomial.coeff_map] using
              congrArg (fun Q : S[X] => Q.coeff (n - 1)) hP
      _ = -(∑ i ∈ Finset.range n, x) := by
            simpa [Finset.prod_const, Finset.card_range] using
              (Polynomial.prod_X_sub_C_coeff_card_pred
                (s := Finset.range n) (f := fun _ : ℕ => x) (by simpa using hn))
  refine ⟨-(P.coeff (n - 1)), ?_⟩
  calc
    f (-(P.coeff (n - 1))) = -(f (P.coeff (n - 1))) := by simp
    _ = -(-(∑ i ∈ Finset.range n, x)) := by rw [hcoeff]
    _ = n • x := by simp

/-- Helper for Lemma 10.46.11: in a field extension, a nonzero natural-number scalar can be
divided out of a range witness. -/
lemma mem_range_of_nsmul_mem_range
    {K : Type*} {L : Type*} [Field K] [Field L] (φ : K →+* L)
    {n : ℕ} {x : L} (hn : (n : K) ≠ 0) (hx : n • x ∈ φ.range) :
    x ∈ φ.range := by
  rcases hx with ⟨a, ha⟩
  have hnL : φ (n : K) ≠ 0 := by
    exact fun h ↦ hn <| φ.injective (by simpa using h)
  refine ⟨(n : K)⁻¹ * a, ?_⟩
  calc
    φ ((n : K)⁻¹ * a) = (φ (n : K))⁻¹ * φ a := by simp
    _ = (φ (n : K))⁻¹ * (n • x) := by rw [ha]
    _ = (φ (n : K))⁻¹ * (φ (n : K) * x) := by simp [nsmul_eq_mul]
    _ = x := by rw [← mul_assoc, inv_mul_cancel₀ hnL, one_mul]

/-- Helper for Lemma 10.46.11: over characteristic zero, a shift-power witness already places the
generator in the base-field image. -/
lemma mem_range_of_shift_power_witness_charZero
    {K : Type*} {L : Type*} [Field K] [Field L] [CharZero K]
    (φ : K →+* L) {y : L} {n : ℕ} (hn : 0 < n) {P : K[X]}
    (hP : Polynomial.map φ P = (X - C y) ^ n) :
    y ∈ φ.range := by
  -- Divide the nonzero scalar `n` out of the next-coefficient witness.
  have hsmul : n • y ∈ φ.range :=
    nsmul_mem_range_of_shift_power_witness (f := φ) hn hP
  exact mem_range_of_nsmul_mem_range φ (Nat.cast_ne_zero.mpr hn.ne') hsmul

/-- Helper for Lemma 10.46.11: in characteristic `p`, expanding the shifted polynomial by `p^k`
recovers the Frobenius power of the original shift. -/
lemma shift_power_expand_frobenius_charP
    {K : Type*} {L : Type*} [Field K] [CommRing L] [Nontrivial L] (φ : K →+* L)
    {p : ℕ} [Fact p.Prime] [CharP K p] (y : L) (k m : ℕ) :
    Polynomial.expand L (p ^ k) ((X - C (y ^ (p ^ k))) ^ m) = (X - C y) ^ (p ^ k * m) := by
  letI : CharP L p := charP_of_injective_ringHom φ.injective p
  -- Frobenius sends `X - C y` to `X^(p^k) - C(y^(p^k))`, which is exactly `expand`.
  calc
    Polynomial.expand L (p ^ k) ((X - C (y ^ (p ^ k))) ^ m) =
        (Polynomial.expand L (p ^ k) (X - C (y ^ (p ^ k)))) ^ m := by
          rw [map_pow]
    _ = (X ^ (p ^ k) - C (y ^ (p ^ k))) ^ m := by
          simp [map_sub]
    _ = (((X - C y) ^ (p ^ k))) ^ m := by
          congr 1
          rw [sub_pow_char_pow_of_commute (p := p) (n := k) (h := Commute.all _ _)]
          simp
    _ = (X - C y) ^ (p ^ k * m) := by
          rw [pow_mul]

/-- Helper for Lemma 10.46.11: contracting a characteristic-`p` shift-power witness by `p^k`
produces a witness for `y^(p^k)` with the reduced exponent. -/
lemma contract_shift_power_witness_charP
    {K : Type*} {L : Type*} [Field K] [CommRing L] [Nontrivial L] (φ : K →+* L)
    {p : ℕ} [Fact p.Prime] [CharP K p] {y : L} {P : K[X]} (k m : ℕ)
    (hP : Polynomial.map φ P = (X - C y) ^ (p ^ k * m)) :
    Polynomial.map φ (Polynomial.contract (p ^ k) P) = (X - C (y ^ (p ^ k))) ^ m := by
  have hp : Nat.Prime p := Fact.out
  have hp_pow_ne : p ^ k ≠ 0 := pow_ne_zero _ hp.ne_zero
  -- Route correction: contract after rewriting the target witness as an `expand`, rather than
  -- extracting a bespoke coefficient identity from the uncontracted polynomial.
  calc
    Polynomial.map φ (Polynomial.contract (p ^ k) P) =
        Polynomial.contract (p ^ k) (Polynomial.map φ P) := by
          exact Polynomial.map_contract (p := p ^ k) hp_pow_ne
    _ = Polynomial.contract (p ^ k) ((X - C y) ^ (p ^ k * m)) := by
          rw [hP]
    _ = Polynomial.contract (p ^ k)
          (Polynomial.expand L (p ^ k) ((X - C (y ^ (p ^ k))) ^ m)) := by
          rw [shift_power_expand_frobenius_charP (φ := φ) (p := p) (y := y) (k := k) (m := m)]
    _ = (X - C (y ^ (p ^ k))) ^ m := by
          rw [Polynomial.contract_expand (R := L) (p := p ^ k) hp_pow_ne]

/-- Helper for Lemma 10.46.11: over characteristic `p`, a shift-power witness yields a prime-power
range witness for the generator. -/
lemma exists_prime_power_mem_range_of_shift_power_witness_charP
    {K : Type*} {L : Type*} [Field K] [Field L] (φ : K →+* L)
    {p : ℕ} [Fact p.Prime] [CharP K p] {y : L} {n : ℕ} (hn : 0 < n) {P : K[X]}
    (hP : Polynomial.map φ P = (X - C y) ^ n) :
    ∃ k : ℕ, y ^ (p ^ k) ∈ φ.range := by
  -- Route correction: factor `n = p^k * m`, contract the witness by `p^k`, and reuse the
  -- existing next-coefficient lemma on the contracted polynomial.
  have hp : Nat.Prime p := Fact.out
  rcases Nat.exists_eq_pow_mul_and_not_dvd hn.ne' p hp.ne_one with ⟨k, m, hm, rfl⟩
  have hm_pos : 0 < m := by
    apply Nat.pos_of_ne_zero
    intro hm_zero
    exact hm <| hm_zero.symm ▸ dvd_zero p
  have hcontract :
      Polynomial.map φ (Polynomial.contract (p ^ k) P) =
        (X - C (y ^ (p ^ k))) ^ m :=
    contract_shift_power_witness_charP (φ := φ) (p := p) (k := k) (m := m) hP
  have hsmul : m • (y ^ (p ^ k)) ∈ φ.range :=
    nsmul_mem_range_of_shift_power_witness
      (f := φ) (x := y ^ (p ^ k)) hm_pos hcontract
  have hmK : (m : K) ≠ 0 := by
    exact (CharP.cast_eq_zero_iff K p m).not.mpr hm
  exact ⟨k, mem_range_of_nsmul_mem_range φ hmK hsmul⟩

/-- Helper for Lemma 10.46.11: the image of `S / q` inside `κ(q)` is generated as a subring by
the image of `R` together with the images of the shift-power generators. -/
lemma residueField_image_range_eq_closure_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating)
    (q : PrimeSpectrum S) :
    let _ : Algebra R S := f.toAlgebra
    let G : Set S :=
      {x : S | ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n}
    let gS : S →ₐ[R] q.asIdeal.ResidueField := IsScalarTower.toAlgHom R S q.asIdeal.ResidueField
    ((algebraMap (S ⧸ q.asIdeal) q.asIdeal.ResidueField) : S ⧸ q.asIdeal →+* q.asIdeal.ResidueField).range =
      Subring.closure
        (Set.range (algebraMap R q.asIdeal.ResidueField) ∪ ((gS : S → q.asIdeal.ResidueField) '' G)) := by
  let _ : Algebra R S := f.toAlgebra
  let G : Set S :=
    {x : S | ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n}
  let gS : S →ₐ[R] q.asIdeal.ResidueField := IsScalarTower.toAlgHom R S q.asIdeal.ResidueField
  have hgen' : Algebra.adjoin R G = ⊤ := by
    simpa [RingHom.ShiftPowerPolynomialImageGenerating, G] using hgen
  have hs_alg : gS.range = Algebra.adjoin R ((gS : S → q.asIdeal.ResidueField) '' G) := by
    -- Map the source-generation hypothesis into the residue field and record the resulting image.
    calc
      gS.range = (⊤ : Subalgebra R S).map gS := by
        ext y
        constructor
        · rintro ⟨x, rfl⟩
          exact ⟨x, by trivial, rfl⟩
        · rintro ⟨x, -, rfl⟩
          exact ⟨x, rfl⟩
      _ = (Algebra.adjoin R G).map gS := by
        rw [hgen'.symm]
      _ = Algebra.adjoin R ((gS : S → q.asIdeal.ResidueField) '' G) := by
        rw [AlgHom.map_adjoin]
  have hs :
      (gS : S →+* q.asIdeal.ResidueField).range =
        Subring.closure
          (Set.range (algebraMap R q.asIdeal.ResidueField) ∪
            ((gS : S → q.asIdeal.ResidueField) '' G)) := by
    -- Convert the algebra-adjoin description into the corresponding subring closure statement.
    simpa [Algebra.adjoin_eq_ring_closure] using congrArg Subalgebra.toSubring hs_alg
  have hrange :
      ((algebraMap (S ⧸ q.asIdeal) q.asIdeal.ResidueField) : S ⧸ q.asIdeal →+* q.asIdeal.ResidueField).range =
        (gS : S →+* q.asIdeal.ResidueField).range := by
    -- Passing from `S` to `S / q` does not change the image inside `κ(q)`.
    apply le_antisymm
    · rintro y ⟨x, rfl⟩
      rcases Ideal.Quotient.mk_surjective x with ⟨s, rfl⟩
      refine ⟨s, ?_⟩
      simp [gS]
    · rintro y ⟨s, rfl⟩
      refine ⟨Ideal.Quotient.mk q.asIdeal s, ?_⟩
      simp [gS]
  rw [hrange]
  exact hs

/-- Helper for Lemma 10.46.11: the subfield of `κ(q)` generated by the image of `R` together with
the images of the shift-power generators is all of `κ(q)`. -/
lemma residueField_closure_eq_top_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating)
    (q : PrimeSpectrum S) :
    let _ : Algebra R S := f.toAlgebra
    let G : Set S :=
      {x : S | ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n}
    Subfield.closure
      (Set.range (algebraMap R q.asIdeal.ResidueField) ∪
        ((algebraMap S q.asIdeal.ResidueField) '' G)) = ⊤ := by
  let _ : Algebra R S := f.toAlgebra
  let G : Set S :=
    {x : S | ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n}
  let gA : S ⧸ q.asIdeal →+* q.asIdeal.ResidueField := algebraMap _ _
  have hgA : Function.Injective gA := q.asIdeal.injective_algebraMap_quotient_residueField
  have hs :
      gA.range =
        Subring.closure
          (Set.range (algebraMap R q.asIdeal.ResidueField) ∪
            ((algebraMap S q.asIdeal.ResidueField) '' G)) := by
    simpa [G] using
      residueField_image_range_eq_closure_of_shiftPowerPolynomialImageGenerating
        (f := f) hgen q
  have hlift :
      IsFractionRing.lift hgA = RingHom.id q.asIdeal.ResidueField := by
    -- The fraction-ring lift of the identity embedding is the identity on `κ(q)`.
    apply IsFractionRing.lift_unique hgA
    intro x
    simpa [gA]
  have hfieldRange :
      (IsFractionRing.lift hgA : q.asIdeal.ResidueField →+* q.asIdeal.ResidueField).fieldRange = ⊤ := by
    rw [hlift, RingHom.fieldRange_eq_top_iff]
    exact fun x ↦ ⟨x, rfl⟩
  -- The fraction field of `S / q` is generated by the image of `S / q`.
  rw [← hfieldRange]
  exact (IsFractionRing.lift_fieldRange_eq_of_range_eq hgA hs).symm

/-- Helper for Lemma 10.46.11: a source shift-power witness transports to the induced residue
field map. -/
lemma residueField_generator_image_has_shift_power_witness
    (f : R →+* S) (q : PrimeSpectrum S) {x : S}
    (hx : ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n) :
    let p' : PrimeSpectrum R := comap f q
    let fκ := Ideal.ResidueField.map p'.asIdeal q.asIdeal f rfl
    let _ : Algebra p'.asIdeal.ResidueField q.asIdeal.ResidueField := fκ.toAlgebra
    ∃ n : ℕ, 0 < n ∧
      ∃ P : p'.asIdeal.ResidueField[X],
        Polynomial.map fκ P =
          (X - C (algebraMap S q.asIdeal.ResidueField x)) ^ n := by
  let p' : PrimeSpectrum R := comap f q
  let fκ : p'.asIdeal.ResidueField →+* q.asIdeal.ResidueField :=
    Ideal.ResidueField.map p'.asIdeal q.asIdeal f rfl
  let _ : Algebra p'.asIdeal.ResidueField q.asIdeal.ResidueField := fκ.toAlgebra
  rcases hx with ⟨n, hn, P, hP⟩
  refine ⟨n, hn, Polynomial.map (algebraMap R p'.asIdeal.ResidueField) P, ?_⟩
  -- Transport the polynomial witness through the canonical residue-field map.
  calc
    Polynomial.map fκ (Polynomial.map (algebraMap R p'.asIdeal.ResidueField) P) =
        Polynomial.map (algebraMap S q.asIdeal.ResidueField) (Polynomial.map f P) := by
          rw [Polynomial.map_map, Polynomial.map_map]
          congr 1
          ext r
          simpa [fκ] using
            (Ideal.ResidueField.map_algebraMap p'.asIdeal q.asIdeal f rfl r)
    _ = Polynomial.map (algebraMap S q.asIdeal.ResidueField) ((X - C x) ^ n) := by rw [hP]
    _ = (X - C (algebraMap S q.asIdeal.ResidueField x)) ^ n := by
          simp

/-- Helper for Lemma 10.46.11: the prime spectrum of a field is a singleton. -/
lemma primeSpectrum_subsingleton_of_field
    (K : Type*) [Field K] :
    Subsingleton (PrimeSpectrum K) := by
  refine ⟨fun x y ↦ ?_⟩
  ext z
  simp [Ideal.eq_bot_of_prime (I := x.asIdeal), Ideal.eq_bot_of_prime (I := y.asIdeal)]

/-- Helper for Lemma 10.46.11: over characteristic zero, the induced residue-field map is
surjective because every shift-power generator image already comes from the base field. -/
theorem residueFieldMap_surjective_of_shiftPowerPolynomialImageGenerating_charZero
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating)
    (q : PrimeSpectrum S)
    (hchar0 : ringChar (comap f q).asIdeal.ResidueField = 0) :
    let p' : PrimeSpectrum R := comap f q
    let fκ := Ideal.ResidueField.map p'.asIdeal q.asIdeal f rfl
    Function.Surjective fκ := by
  let _ : Algebra R S := f.toAlgebra
  let p' : PrimeSpectrum R := comap f q
  let fκ : p'.asIdeal.ResidueField →+* q.asIdeal.ResidueField :=
    Ideal.ResidueField.map p'.asIdeal q.asIdeal f rfl
  let _ : Algebra p'.asIdeal.ResidueField q.asIdeal.ResidueField := fκ.toAlgebra
  letI : CharZero p'.asIdeal.ResidueField :=
    (CharP.ringChar_zero_iff_CharZero p'.asIdeal.ResidueField).1 hchar0
  have hclosure_le :
      Subfield.closure
        (Set.range (algebraMap R q.asIdeal.ResidueField) ∪
          ((algebraMap S q.asIdeal.ResidueField) ''
            {x : S |
              ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n})) ≤
        fκ.fieldRange := by
    refine Subfield.closure_le.mpr ?_
    intro y hy
    rcases hy with hyR | hyG
    · rcases hyR with ⟨r, rfl⟩
      exact ⟨algebraMap R p'.asIdeal.ResidueField r, by
        calc
          fκ (algebraMap R p'.asIdeal.ResidueField r) =
              algebraMap S q.asIdeal.ResidueField (f r) := by
                simpa [fκ] using
                  (Ideal.ResidueField.map_algebraMap p'.asIdeal q.asIdeal f rfl r)
          _ = algebraMap R q.asIdeal.ResidueField r := by
                simpa [RingHom.algebraMap_toAlgebra] using
                  (IsScalarTower.algebraMap_apply R S q.asIdeal.ResidueField r)⟩
    · rcases hyG with ⟨x, hx, rfl⟩
      rcases residueField_generator_image_has_shift_power_witness (f := f) q hx with
        ⟨n, hn, P, hP⟩
      rcases mem_range_of_shift_power_witness_charZero
          (φ := fκ) (y := algebraMap S q.asIdeal.ResidueField x) hn hP with
        ⟨a, ha⟩
      exact ⟨a, ha⟩
  have hfieldRange_top : fκ.fieldRange = ⊤ := by
    -- Route correction: the source proof works through the whole generated subfield.
    apply top_unique
    rw [← residueField_closure_eq_top_of_shiftPowerPolynomialImageGenerating
      (f := f) hgen q]
    exact hclosure_le
  -- Once the field range is all of `κ(q)`, surjectivity is immediate.
  simpa [p', fκ] using (RingHom.fieldRange_eq_top_iff.mp hfieldRange_top)

/-- Helper for Lemma 10.46.11: in characteristic `p`, the induced residue-field extension is
purely inseparable because the generator images satisfy the prime-power/scalar criterion. -/
theorem residueField_charP_purelyInseparable_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating)
    (q : PrimeSpectrum S) {p : ℕ} [Fact p.Prime]
    [CharP (comap f q).asIdeal.ResidueField p] :
    let p' : PrimeSpectrum R := comap f q
    let fκ := Ideal.ResidueField.map p'.asIdeal q.asIdeal f rfl
    let _ : Algebra p'.asIdeal.ResidueField q.asIdeal.ResidueField := fκ.toAlgebra
    IsPurelyInseparable p'.asIdeal.ResidueField q.asIdeal.ResidueField := by
  let _ : Algebra R S := f.toAlgebra
  let p' : PrimeSpectrum R := comap f q
  let fκ : p'.asIdeal.ResidueField →+* q.asIdeal.ResidueField :=
    Ideal.ResidueField.map p'.asIdeal q.asIdeal f rfl
  let _ : Algebra p'.asIdeal.ResidueField q.asIdeal.ResidueField := fκ.toAlgebra
  letI : CharP q.asIdeal.ResidueField p := charP_of_injective_ringHom fκ.injective p
  have hclosure_le :
      Subfield.closure
        (Set.range (algebraMap p'.asIdeal.ResidueField q.asIdeal.ResidueField) ∪
          ((algebraMap S q.asIdeal.ResidueField) ''
            {x : S |
              ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n})) ≤
        (IntermediateField.adjoin p'.asIdeal.ResidueField
          (elements_with_pow_and_scalar_mem
            p'.asIdeal.ResidueField q.asIdeal.ResidueField p)).toSubfield := by
    refine Subfield.closure_le.mpr ?_
    intro y hy
    rcases hy with hyR | hyG
    · exact IntermediateField.set_range_subset _ hyR
    · rcases hyG with ⟨x, hx, rfl⟩
      rcases residueField_generator_image_has_shift_power_witness (f := f) q hx with
        ⟨n, hn, P, hP⟩
      rcases exists_prime_power_mem_range_of_shift_power_witness_charP
          (φ := fκ) (p := p) (y := algebraMap S q.asIdeal.ResidueField x) hn hP with
        ⟨k, hk⟩
      refine IntermediateField.subset_adjoin p'.asIdeal.ResidueField _ ?_
      refine ⟨k + 1, Nat.succ_pos _, ?_, ?_⟩
      · rcases hk with ⟨a, ha⟩
        refine ⟨a ^ p, ?_⟩
        calc
          fκ (a ^ p) = (fκ a) ^ p := by simp
          _ = (algebraMap S q.asIdeal.ResidueField x ^ (p ^ k)) ^ p := by simpa [ha]
          _ = algebraMap S q.asIdeal.ResidueField x ^ (p ^ (k + 1)) := by
                rw [← pow_mul, Nat.pow_succ', Nat.mul_comm]
      · refine ⟨0, ?_⟩
        simp [nsmul_eq_mul]
  have hadjoin_top :
      IntermediateField.adjoin p'.asIdeal.ResidueField
        (elements_with_pow_and_scalar_mem
          p'.asIdeal.ResidueField q.asIdeal.ResidueField p) = ⊤ := by
    have hclosure_top_R :
        Subfield.closure
          (Set.range (algebraMap R q.asIdeal.ResidueField) ∪
            ((algebraMap S q.asIdeal.ResidueField) ''
              {x : S |
                ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n})) = ⊤ := by
      simpa using
        residueField_closure_eq_top_of_shiftPowerPolynomialImageGenerating
          (f := f) hgen q
    have hbase_subset :
        Set.range (algebraMap R q.asIdeal.ResidueField) ⊆
          Set.range (algebraMap p'.asIdeal.ResidueField q.asIdeal.ResidueField) := by
      intro y hy
      rcases hy with ⟨r, rfl⟩
      refine ⟨algebraMap R p'.asIdeal.ResidueField r, ?_⟩
      calc
        algebraMap p'.asIdeal.ResidueField q.asIdeal.ResidueField
            (algebraMap R p'.asIdeal.ResidueField r) = fκ (algebraMap R p'.asIdeal.ResidueField r) := by
              rfl
        _ = algebraMap S q.asIdeal.ResidueField (f r) := by
              simpa [fκ] using
                (Ideal.ResidueField.map_algebraMap p'.asIdeal q.asIdeal f rfl r)
        _ = algebraMap R q.asIdeal.ResidueField r := by
              simpa [RingHom.algebraMap_toAlgebra] using
                (IsScalarTower.algebraMap_apply R S q.asIdeal.ResidueField r)
    have hclosure_top :
        Subfield.closure
          (Set.range (algebraMap p'.asIdeal.ResidueField q.asIdeal.ResidueField) ∪
            ((algebraMap S q.asIdeal.ResidueField) ''
              {x : S |
                ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n})) = ⊤ := by
      apply top_unique
      rw [← hclosure_top_R]
      exact Subfield.closure_le.mpr <|
        Set.union_subset
          (fun y hy => Subfield.subset_closure (Or.inl (hbase_subset hy)))
          (fun y hy => Subfield.subset_closure (Or.inr hy))
    apply top_unique
    intro y hy
    have hy' :
        y ∈ Subfield.closure
          (Set.range (algebraMap p'.asIdeal.ResidueField q.asIdeal.ResidueField) ∪
            ((algebraMap S q.asIdeal.ResidueField) ''
              {x : S |
                ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n})) := by
      rw [hclosure_top]
      simpa using hy
    exact hclosure_le hy'
  have hcases :
      Function.Surjective fκ ∨
        ringChar p'.asIdeal.ResidueField = p ∧
          IsPurelyInseparable p'.asIdeal.ResidueField q.asIdeal.ResidueField := by
    simpa [trivial_or_char_p_purely_inseparable, fκ] using
      (generated_by_elements_with_pow_and_scalar_mem_iff
        (k := p'.asIdeal.ResidueField) (k' := q.asIdeal.ResidueField) (p := p)).mp hadjoin_top
  rcases hcases with hsurj | hpi
  · let e : p'.asIdeal.ResidueField ≃ₐ[p'.asIdeal.ResidueField] q.asIdeal.ResidueField :=
      AlgEquiv.ofBijective (Algebra.ofId p'.asIdeal.ResidueField q.asIdeal.ResidueField)
        ⟨FaithfulSMul.algebraMap_injective p'.asIdeal.ResidueField q.asIdeal.ResidueField, hsurj⟩
    exact e.isPurelyInseparable
  · exact hpi.2

-- Proof sketch: for each chosen generator `x`, the displayed polynomial identity makes `x`
-- integral over `R`; integrality of the whole map then follows from the canonical theorem
-- `Algebra.IsIntegral.adjoin`.
/-- The shift-power polynomial generation hypothesis forces the ring map to be integral. -/
theorem isIntegral_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating) :
    f.IsIntegral := by
  let _ : Algebra R S := f.toAlgebra
  let G : Set S :=
    {x : S | ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n}
  have hIntegralMap : (algebraMap R S).IsIntegral := by
    rw [algebraMap_isIntegral_iff]
    have hIntegralAdjoin : Algebra.IsIntegral R (Algebra.adjoin R G) := by
      -- Each chosen generator has a positive power in the image, hence is integral.
      refine Algebra.IsIntegral.adjoin ?_
      intro x hx
      rcases hx with ⟨n, hn, P, hP⟩
      have hxpow : x ^ n ∈ f.range :=
        pow_mem_range_of_shift_power_witness (f := f) hP
      rcases hxpow with ⟨r, hr⟩
      exact IsIntegral.of_pow hn (hr ▸ isIntegral_algebraMap)
    have hgen' : Algebra.adjoin R G = ⊤ := by
      simpa [RingHom.ShiftPowerPolynomialImageGenerating, G] using hgen
    have hIntegralTop : Algebra.IsIntegral R (⊤ : Subalgebra R S) := by
      rw [← hgen']
      exact hIntegralAdjoin
    exact (Subalgebra.topEquiv (R := R) (A := S)).isIntegral_iff.mp hIntegralTop
  simpa [RingHom.algebraMap_toAlgebra] using hIntegralMap

/-- Helper for Lemma 10.46.11: every fiber ring inherits the same shift-power generation
hypothesis from the source map. -/
lemma fiber_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating)
    (p : PrimeSpectrum R) :
    let _ : Algebra R S := f.toAlgebra
    let K : Type _ := p.asIdeal.ResidueField
    let g : K →+* p.asIdeal.Fiber S := algebraMap K (p.asIdeal.Fiber S)
    g.ShiftPowerPolynomialImageGenerating := by
  let _ : Algebra R S := f.toAlgebra
  let K : Type _ := p.asIdeal.ResidueField
  let g : K →+* p.asIdeal.Fiber S := algebraMap K (p.asIdeal.Fiber S)
  let G : Set (p.asIdeal.Fiber S) :=
    {y : p.asIdeal.Fiber S |
      ∃ n : ℕ, 0 < n ∧ ∃ P : K[X], Polynomial.map g P = (X - C y) ^ n}
  let G₀ : Set S :=
    {x : S | ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n}
  -- Transport the original generating family literally to the fiber via `1 ⊗ x`.
  dsimp [RingHom.ShiftPowerPolynomialImageGenerating]
  have htop :
      Algebra.adjoin K (((1 : K) ⊗ₜ[R] ·) '' G₀) = ⊤ := by
    simpa [RingHom.ShiftPowerPolynomialImageGenerating, G₀] using
      Algebra.TensorProduct.adjoin_one_tmul_image_eq_top (A := K) (s := G₀) hgen
  have hsubset : (((1 : K) ⊗ₜ[R] ·) '' G₀) ⊆ G := by
    intro y hy
    rcases hy with ⟨x, hx, rfl⟩
    let _ : Algebra S (K ⊗[R] S) := Algebra.TensorProduct.rightAlgebra
    rcases hx with ⟨n, hn, P, hP⟩
    refine ⟨n, hn, Polynomial.map (algebraMap R K) P, ?_⟩
    calc
      Polynomial.map g (Polynomial.map (algebraMap R K) P) =
          Polynomial.map (algebraMap S (K ⊗[R] S)) (Polynomial.map f P) := by
            rw [Polynomial.map_map, Polynomial.map_map]
            congr 1
            ext r
            calc
              g (algebraMap R K r) = (1 : K) ⊗ₜ[R] f r := by
                simpa [g] using
                  RingHom.baseChange_algebraMap_eq_one_tmul
                    (f := f) (R' := K) r
              _ = algebraMap S (K ⊗[R] S) (f r) := by
                rw [Algebra.TensorProduct.algebraMap_eq_includeRight]
                exact
                  (Algebra.TensorProduct.includeRight_apply
                    (R := R) (A := K) (B := S) (f r)).symm
      _ = Polynomial.map (algebraMap S (K ⊗[R] S)) ((X - C x) ^ n) := by rw [hP]
      _ = (X - C (algebraMap S (K ⊗[R] S) x)) ^ n := by simp
      _ = (X - C ((1 : K) ⊗ₜ[R] x)) ^ n := by
            rw [Algebra.TensorProduct.algebraMap_eq_includeRight]
            simpa using
              congrArg (fun z : K ⊗[R] S => (X - C z) ^ n)
                (Algebra.TensorProduct.includeRight_apply
                  (R := R) (A := K) (B := S) x)
  have hadjoin_le :
      Algebra.adjoin K (((1 : K) ⊗ₜ[R] ·) '' G₀) ≤ Algebra.adjoin K G := by
    rw [Algebra.adjoin_le_iff]
    intro y hy
    exact Algebra.subset_adjoin (hsubset hy)
  refine top_unique ?_
  calc
    (⊤ : Subalgebra K (p.asIdeal.Fiber S)) =
        Algebra.adjoin K (((1 : K) ⊗ₜ[R] ·) '' G₀) := htop.symm
    _ ≤ Algebra.adjoin K G := hadjoin_le

/-- Helper for Lemma 10.46.11: every fiber ring `κ(p) ⊗[R] S` has subsingleton prime spectrum. -/
lemma fiber_primeSpectrum_subsingleton_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating)
    (p : PrimeSpectrum R) :
    let _ : Algebra R S := f.toAlgebra
    Subsingleton (PrimeSpectrum (p.asIdeal.Fiber S)) := by
  sorry

/-- Helper for Lemma 10.46.11: the singleton-fiber statement upgrades directly to injectivity on
`Spec(S) → Spec(R)`. -/
theorem comap_injective_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating) :
    Function.Injective (comap f) := by
  let _ : Algebra R S := f.toAlgebra
  intro q q' hqq'
  have hqq_alg : comap (algebraMap R S) q = comap (algebraMap R S) q' := by
    simpa [RingHom.algebraMap_toAlgebra] using hqq'
  let p : PrimeSpectrum R := comap (algebraMap R S) q
  let e := PrimeSpectrum.preimageEquivFiber R S p
  have hsub :
      Subsingleton (PrimeSpectrum (p.asIdeal.Fiber S)) :=
    fiber_primeSpectrum_subsingleton_of_shiftPowerPolynomialImageGenerating
      (f := f) hgen p
  have heq :
      e ⟨q, by simp [p]⟩ = e ⟨q', by simpa [p] using hqq_alg.symm⟩ := hsub.elim _ _
  exact congrArg Subtype.val (e.injective heq)

-- Proof sketch: combine the positive-power bridge above with the locally nilpotent-kernel
-- hypothesis and apply the canonical owner theorem `PrimeSpectrum.isHomeomorph_comap`; a
-- homeomorphism is in particular bijective.
/-- With locally nilpotent kernel, the shift-power generation hypothesis makes the map on spectra
bijective. -/
theorem bijective_comap_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hker : (RingHom.ker f).IsLocallyNilpotent)
    (hgen : f.ShiftPowerPolynomialImageGenerating) :
    Function.Bijective (comap f) := by
  have hInt : f.IsIntegral := isIntegral_of_shiftPowerPolynomialImageGenerating (f := f) hgen
  have hclosed : IsClosedMap (comap f) :=
    PrimeSpectrum.isClosedMap_comap_of_isIntegral _ hInt
  have hdense : DenseRange (comap f) := by
    -- The locally nilpotent-kernel hypothesis is exactly the dense-image criterion.
    exact (denseRange_comap_iff_ker_le_nilRadical f).2
      (by simpa [Ideal.IsLocallyNilpotent] using hker)
  have hsurj : Function.Surjective (comap f) := by
    rw [← Set.range_eq_univ]
    rw [← hclosed.isClosed_range.closure_eq, hdense.closure_range]
  exact
    ⟨comap_injective_of_shiftPowerPolynomialImageGenerating (f := f) hgen, hsurj⟩

-- Proof sketch: after passing to any residue field `κ(q ∩ R) → κ(q)`, the induced generators
-- satisfy the same shift-power polynomial identities. Over fields this is the canonical
-- purely-inseparable criterion expressed by `IsPurelyInseparable.minpoly_eq_X_sub_C_pow`, so the
-- residue-field extensions are purely inseparable.
/-- The shift-power generation hypothesis implies purely inseparable residue-field extensions. -/
theorem hasPurelyInseparableResidueFieldExtensions_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating) :
    f.HasPurelyInseparableResidueFieldExtensions := by
  intro q
  let p' : PrimeSpectrum R := comap f q
  let fκ : p'.asIdeal.ResidueField →+* q.asIdeal.ResidueField :=
    Ideal.ResidueField.map p'.asIdeal q.asIdeal f rfl
  let _ : Algebra p'.asIdeal.ResidueField q.asIdeal.ResidueField := fκ.toAlgebra
  by_cases hchar0 : ringChar p'.asIdeal.ResidueField = 0
  · letI : CharZero p'.asIdeal.ResidueField :=
      (CharP.ringChar_zero_iff_CharZero p'.asIdeal.ResidueField).1 hchar0
    have hsurj :
        Function.Surjective fκ := by
      simpa [p', fκ] using
        residueFieldMap_surjective_of_shiftPowerPolynomialImageGenerating_charZero
          (f := f) hgen q hchar0
    let e : p'.asIdeal.ResidueField ≃ₐ[p'.asIdeal.ResidueField] q.asIdeal.ResidueField :=
      AlgEquiv.ofBijective (Algebra.ofId p'.asIdeal.ResidueField q.asIdeal.ResidueField)
        ⟨FaithfulSMul.algebraMap_injective p'.asIdeal.ResidueField q.asIdeal.ResidueField, hsurj⟩
    exact e.isPurelyInseparable
  · letI : CharP p'.asIdeal.ResidueField (ringChar p'.asIdeal.ResidueField) := inferInstance
    have hprime : (ringChar p'.asIdeal.ResidueField).Prime :=
      CharP.char_prime_of_ne_zero p'.asIdeal.ResidueField hchar0
    letI : Fact (ringChar p'.asIdeal.ResidueField).Prime := ⟨hprime⟩
    simpa [p', fκ] using
      residueField_charP_purelyInseparable_of_shiftPowerPolynomialImageGenerating
        (f := f) hgen q (p := ringChar p'.asIdeal.ResidueField)

variable {R' : Type w} [CommRing R'] [Algebra R R']

/-- Helper for Lemma 10.46.11: a source shift-power witness survives after tensoring with `1`. -/
lemma baseChange_one_tmul_has_shift_power_witness
    (f : R →+* S) {x : S}
    (hx : ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n) :
    let _ : Algebra R S := f.toAlgebra
    let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
    ∃ n : ℕ, 0 < n ∧
      ∃ P : R'[X], Polynomial.map f' P = (X - C ((1 : R') ⊗ₜ[R] x)) ^ n := by
  let _ : Algebra R S := f.toAlgebra
  let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
  let _ : Algebra S (R' ⊗[R] S) := Algebra.TensorProduct.rightAlgebra
  rcases hx with ⟨n, hn, P, hP⟩
  refine ⟨n, hn, Polynomial.map (algebraMap R R') P, ?_⟩
  -- Transport the witness polynomial coefficientwise through the tensor-product algebra maps.
  calc
    Polynomial.map f' (Polynomial.map (algebraMap R R') P) =
        Polynomial.map (algebraMap S (R' ⊗[R] S)) (Polynomial.map f P) := by
          rw [Polynomial.map_map, Polynomial.map_map]
          congr 1
          ext r
          calc
            f' (algebraMap R R' r) = (1 : R') ⊗ₜ[R] f r := by
              simpa using RingHom.baseChange_algebraMap_eq_one_tmul (f := f) (R' := R') r
            _ = algebraMap S (R' ⊗[R] S) (f r) := by
              rw [Algebra.TensorProduct.algebraMap_eq_includeRight]
              exact
                (Algebra.TensorProduct.includeRight_apply
                  (R := R) (A := R') (B := S) (f r)).symm
    _ = Polynomial.map (algebraMap S (R' ⊗[R] S)) ((X - C x) ^ n) := by rw [hP]
    _ = (X - C (algebraMap S (R' ⊗[R] S) x)) ^ n := by simp
    _ = (X - C ((1 : R') ⊗ₜ[R] x)) ^ n := by
          rw [Algebra.TensorProduct.algebraMap_eq_includeRight]
          simpa using
            congrArg (fun y : R' ⊗[R] S => (X - C y) ^ n)
              (Algebra.TensorProduct.includeRight_apply
                (R := R) (A := R') (B := S) x)

/-- The shift-power generation hypothesis is preserved by arbitrary base change. -/
theorem shiftPowerPolynomialImageGenerating_baseChange_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hgen : f.ShiftPowerPolynomialImageGenerating) :
    let _ : Algebra R S := f.toAlgebra
    let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
    f'.ShiftPowerPolynomialImageGenerating := by
  let _ : Algebra R S := f.toAlgebra
  let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
  let G : Set S :=
    {x : S | ∃ n : ℕ, 0 < n ∧ ∃ P : R[X], Polynomial.map f P = (X - C x) ^ n}
  dsimp [RingHom.ShiftPowerPolynomialImageGenerating]
  have htop :
      Algebra.adjoin R' (((1 : R') ⊗ₜ[R] ·) '' G) = ⊤ := by
    -- The original generating set still generates after literal base change.
    simpa [RingHom.ShiftPowerPolynomialImageGenerating, G] using
      Algebra.TensorProduct.adjoin_one_tmul_image_eq_top (A := R') (s := G) hgen
  have hsubset :
      (((1 : R') ⊗ₜ[R] ·) '' G) ⊆
        {y : R' ⊗[R] S |
          ∃ n : ℕ, 0 < n ∧ ∃ P : R'[X], Polynomial.map f' P = (X - C y) ^ n} := by
    intro y hy
    rcases hy with ⟨x, hx, rfl⟩
    -- Each source witness transports to a witness for the corresponding pure tensor.
    simpa using
      baseChange_one_tmul_has_shift_power_witness
        (f := f) (R' := R') (x := x) hx
  have hadjoin_le :
      Algebra.adjoin R' (((1 : R') ⊗ₜ[R] ·) '' G) ≤
        Algebra.adjoin R'
          {y : R' ⊗[R] S |
            ∃ n : ℕ, 0 < n ∧ ∃ P : R'[X], Polynomial.map f' P = (X - C y) ^ n} := by
    rw [Algebra.adjoin_le_iff]
    intro y hy
    exact Algebra.subset_adjoin (hsubset hy)
  have htop_le :
      (⊤ : Subalgebra R' (R' ⊗[R] S)) ≤
        Algebra.adjoin R'
          {y : R' ⊗[R] S |
            ∃ n : ℕ, 0 < n ∧ ∃ P : R'[X], Polynomial.map f' P = (X - C y) ^ n} := by
    rw [← htop]
    exact hadjoin_le
  exact top_unique htop_le

-- Proof sketch: the generation condition base changes termwise, and locally nilpotent kernels are
-- stable under arbitrary base change; the two source-facing conclusions are therefore recorded
-- directly in a separate theorem.
/-- Lemma 10.46.11, source-facing base-change clause: if `ker f` is locally nilpotent and `f`
satisfies the shift-power generation hypothesis, then every base change `R' → R' ⊗[R] S`
inherits the same generation hypothesis and has locally nilpotent kernel. The homeomorphism and
purely inseparable residue-field conclusions are obtained by combining the bridge theorems above
with the direct closed-map and residue-field arguments already established in this file. -/
theorem shiftPowerPolynomialImageGenerating_and_ker_baseChange_isLocallyNilpotent_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hker : (RingHom.ker f).IsLocallyNilpotent)
    (hgen : f.ShiftPowerPolynomialImageGenerating) :
    let _ : Algebra R S := f.toAlgebra
    let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
    f'.ShiftPowerPolynomialImageGenerating ∧
      (RingHom.ker f').IsLocallyNilpotent := by
  let _ : Algebra R S := f.toAlgebra
  let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
  have hsurj : Function.Surjective (comap f) :=
    (bijective_comap_of_shiftPowerPolynomialImageGenerating (f := f) hker hgen).2
  -- The source route keeps the base-changed generation statement literal and recovers local
  -- nilpotence of the base-changed kernel from surjectivity of spectra after base change.
  have hsurj' : Function.Surjective (comap f') :=
    specComap_surjective_stable_under_baseChange
      (R := R) (S := S) (R' := R') hsurj
  have hker' : (RingHom.ker f').IsLocallyNilpotent := by
    exact (denseRange_comap_iff_ker_le_nilRadical f').mp hsurj'.denseRange
  exact ⟨
    shiftPowerPolynomialImageGenerating_baseChange_of_shiftPowerPolynomialImageGenerating
      (f := f) (R' := R') hgen,
    hker'
  ⟩

/-- Lemma 10.46.11: if `ker f` is locally nilpotent and `f` satisfies the shift-power generation
hypothesis, then `Spec(S) → Spec(R)` is a homeomorphism, `f` induces purely inseparable residue
field extensions, and both conclusions remain true after arbitrary base change. -/
theorem isHomeomorph_comap_and_hasPurelyInseparableResidueFieldExtensions_and_baseChange_of_shiftPowerPolynomialImageGenerating
    (f : R →+* S) (hker : (RingHom.ker f).IsLocallyNilpotent)
    (hgen : f.ShiftPowerPolynomialImageGenerating) :
    IsHomeomorph (comap f) ∧
      f.HasPurelyInseparableResidueFieldExtensions ∧
      ∀ {R' : Type w} [CommRing R'] [Algebra R R'],
        let _ : Algebra R S := f.toAlgebra
        let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
        IsHomeomorph (comap f') ∧
          f'.HasPurelyInseparableResidueFieldExtensions := by
  let _ : Algebra R S := f.toAlgebra
  have hInt : f.IsIntegral :=
    isIntegral_of_shiftPowerPolynomialImageGenerating (f := f) hgen
  have hbij : Function.Bijective (comap f) :=
    bijective_comap_of_shiftPowerPolynomialImageGenerating (f := f) hker hgen
  have hres : f.HasPurelyInseparableResidueFieldExtensions :=
    hasPurelyInseparableResidueFieldExtensions_of_shiftPowerPolynomialImageGenerating
      (f := f) hgen
  have hclosedEmb : Topology.IsClosedEmbedding (comap f) := by
    exact .of_continuous_injective_isClosedMap (continuous_comap _) hbij.1
      (PrimeSpectrum.isClosedMap_comap_of_isIntegral _ hInt)
  have hhomeo : IsHomeomorph (comap f) := by
    exact (isHomeomorph_iff_isEmbedding_surjective).2 ⟨hclosedEmb.isEmbedding, hbij.2⟩
  refine ⟨hhomeo, hres, ?_⟩
  intro R' _ _
  let f' : R' →+* R' ⊗[R] S := algebraMap R' (R' ⊗[R] S)
  have hgen' : f'.ShiftPowerPolynomialImageGenerating :=
    shiftPowerPolynomialImageGenerating_baseChange_of_shiftPowerPolynomialImageGenerating
      (f := f) (R' := R') hgen
  have hker' : (RingHom.ker f').IsLocallyNilpotent :=
    (shiftPowerPolynomialImageGenerating_and_ker_baseChange_isLocallyNilpotent_of_shiftPowerPolynomialImageGenerating
      (f := f) (R' := R') hker hgen).2
  have hInt' : f'.IsIntegral :=
    isIntegral_of_shiftPowerPolynomialImageGenerating (f := f') hgen'
  have hbij' : Function.Bijective (comap f') :=
    bijective_comap_of_shiftPowerPolynomialImageGenerating (f := f') hker' hgen'
  have hres' : f'.HasPurelyInseparableResidueFieldExtensions :=
    hasPurelyInseparableResidueFieldExtensions_of_shiftPowerPolynomialImageGenerating
      (f := f') hgen'
  have hclosedEmb' : Topology.IsClosedEmbedding (comap f') := by
    exact .of_continuous_injective_isClosedMap (continuous_comap _) hbij'.1
      (PrimeSpectrum.isClosedMap_comap_of_isIntegral _ hInt')
  have hhomeo' : IsHomeomorph (comap f') := by
    exact (isHomeomorph_iff_isEmbedding_surjective).2 ⟨hclosedEmb'.isEmbedding, hbij'.2⟩
  exact ⟨hhomeo', hres'⟩

end RingHom

