import StacksProject_2024.Chap10.Definition_10_32_1

-- Declarations for this item will be appended below by the statement pipeline.

open MvPolynomial

universe u

noncomputable section

section

variable (k : Type u) [CommSemiring k]

/-- The ideal of `k[X_n \mid n ∈ ℕ+]` generated by the powers `X_n^n`. -/
def variablePowerIdeal : Ideal (MvPolynomial ℕ+ k) :=
  Ideal.span (Set.range fun n : ℕ+ ↦ X n ^ (n : ℕ))

end

section

variable (k : Type u) [CommSemiring k]

/-- The quotient of `k[X_n \mid n ∈ ℕ+]` by `variablePowerIdeal k`, modeled via `RingQuot` so it
is available over commutative semirings. -/
abbrev variablePowerQuotient :=
  RingQuot (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0)

/-- The image of the owner ideal `idealOfVars ℕ+ k` in the quotient by `variablePowerIdeal k`. -/
def quotientVariableIdeal : Ideal (variablePowerQuotient k) :=
  Ideal.map
    (RingQuot.mkRingHom (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0))
    (idealOfVars ℕ+ k)

section

variable [Nontrivial k]

local instance :
    MulAction (variablePowerQuotient k) (variablePowerQuotient k) :=
  Monoid.toMulAction _

local notation "q" =>
  RingQuot.mkRingHom
    (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0)

/-- Helper for Example 10.32.2: each variable class in `variablePowerQuotient k` is nilpotent. -/
lemma quotient_variable_generator_isNilpotent (i : ℕ+) :
    IsNilpotent (q (X i : MvPolynomial ℕ+ k)) := by
  -- The defining relation kills the prescribed power `X i ^ i` in the quotient.
  refine ⟨(i : ℕ), ?_⟩
  have hrel :
      (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0)
        ((X i : MvPolynomial ℕ+ k) ^ (i : ℕ)) 0 := by
    exact ⟨Ideal.subset_span ⟨i, rfl⟩, rfl⟩
  calc
    (q (X i : MvPolynomial ℕ+ k)) ^ (i : ℕ) = q ((X i : MvPolynomial ℕ+ k) ^ (i : ℕ)) := by
      rw [map_pow]
    _ = 0 := by
      simpa using
        (RingQuot.mkRingHom_rel
          (r := fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0) hrel)

/-- Helper for Example 10.32.2: any quotient monomial with a variable factor is nilpotent. -/
lemma quotient_monomial_isNilpotent_of_support {m : ℕ+ →₀ ℕ} {a : k} {i : ℕ+}
    (hi : i ∈ m.support) :
    IsNilpotent (q (monomial m a : MvPolynomial ℕ+ k)) := by
  -- Removing one copy of `X i` exposes the nilpotent generator factor.
  let m' : ℕ+ →₀ ℕ := m - Finsupp.single i 1
  have hm : m' + Finsupp.single i 1 = m := by
    dsimp [m']
    exact Finsupp.sub_add_single_one_cancel <| by
      simpa [Finsupp.mem_support_iff] using hi
  have hmonomial : monomial m a = monomial m' a * X i := by
    rw [← hm, monomial_add_single, pow_one]
  rw [hmonomial, map_mul]
  exact (Commute.all _ _).isNilpotent_mul_left
    (quotient_variable_generator_isNilpotent (k := k) i)

/-- Helper for Example 10.32.2: membership in `variablePowerIdeal k` is detected monomial by
support monomial. -/
lemma variablePowerIdeal_mem_iff_support (p : MvPolynomial ℕ+ k) :
    p ∈ variablePowerIdeal k ↔
      ∀ d ∈ p.support, ∃ i : ℕ+, (i : ℕ) ≤ d i := by
  -- Rewrite the ideal as a monomial ideal and apply the standard support criterion.
  have hspan :
      variablePowerIdeal k =
        Ideal.span
          ((fun d : (ℕ+ →₀ ℕ) ↦ monomial d (1 : k)) ''
            Set.range (fun i : ℕ+ ↦ Finsupp.single i (i : ℕ))) := by
    rw [variablePowerIdeal]
    congr 1
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      refine ⟨Finsupp.single i (i : ℕ), ⟨i, rfl⟩, ?_⟩
      simp [X_pow_eq_monomial]
    · rintro ⟨d, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, by simp [X_pow_eq_monomial]⟩
  rw [hspan, MvPolynomial.mem_ideal_span_monomial_image]
  constructor
  · intro hp d hd
    obtain ⟨s, ⟨i, rfl⟩, hs⟩ := hp d hd
    exact ⟨i, by simpa using hs i⟩
  · intro hp d hd
    obtain ⟨i, hi⟩ := hp d hd
    refine ⟨Finsupp.single i (i : ℕ), ⟨i, rfl⟩, ?_⟩
    intro j
    by_cases hj : j = i
    · subst hj
      simpa using hi
    · simp [hj]

/-- Helper for Example 10.32.2: the monomial `X_(n+1)^n` is not killed by `variablePowerIdeal k`. -/
lemma succ_variable_pow_not_mem_variablePowerIdeal (n : ℕ) :
    ((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n) ∉ variablePowerIdeal k := by
  intro hmem
  have hsupport :=
    (variablePowerIdeal_mem_iff_support (k := k)
      ((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n)).1 hmem
  have hsingle :
      Finsupp.single (Nat.succPNat n) n ∈
        (((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n).support) := by
    simpa [X_pow_eq_monomial, one_ne_zero]
  obtain ⟨i, hi⟩ := hsupport (Finsupp.single (Nat.succPNat n) n) hsingle
  by_cases hni : i = Nat.succPNat n
  · subst hni
    simpa [Nat.succPNat_coe] using hi
  · have hizero : (i : ℕ) ≤ 0 := by
      simpa [Finsupp.single_apply, hni] using hi
    have hipos : 0 < (i : ℕ) := i.2
    omega

/-- Helper for Example 10.32.2: an exponent survives exactly when each coordinate stays below
its killing power. -/
def variablePowerIdeal_survives (d : ℕ+ →₀ ℕ) : Prop :=
  ∀ i : ℕ+, d i < (i : ℕ)

/-- Helper for Example 10.32.2: keep only the monomials whose exponents survive the defining
ideal. -/
def variablePowerIdeal_survivorPart (p : MvPolynomial ℕ+ k) : MvPolynomial ℕ+ k :=
  letI : DecidablePred variablePowerIdeal_survives := Classical.decPred _
  ∑ d ∈ p.support,
    if variablePowerIdeal_survives d then monomial d (p.coeff d) else 0

/-- Helper for Example 10.32.2: a surviving exponent keeps its original coefficient. -/
lemma variablePowerIdeal_survivorPart_coeff_of_survives
    (p : MvPolynomial ℕ+ k) {d : ℕ+ →₀ ℕ} (hd : variablePowerIdeal_survives d) :
    coeff d (variablePowerIdeal_survivorPart (k := k) p) = p.coeff d := by
  classical
  -- Compute the coefficient from the defining support sum and isolate the unique matching monomial.
  dsimp [variablePowerIdeal_survivorPart]
  rw [MvPolynomial.coeff_sum]
  by_cases hdp : d ∈ p.support
  · rw [Finset.sum_eq_single d]
    · simp [hd]
    · intro e he hed
      by_cases hs : variablePowerIdeal_survives e
      · simp [hs, hed]
      · simp [hs]
    · intro hd_not_mem
      exact (hd_not_mem hdp).elim
  · have hcoeff : p.coeff d = 0 := by
      simpa using (MvPolynomial.notMem_support_iff.mp hdp)
    rw [hcoeff]
    refine Finset.sum_eq_zero ?_
    intro e he
    by_cases hed : e = d
    · exact (hdp <| by simpa [hed] using he).elim
    · by_cases hs : variablePowerIdeal_survives e
      · simp [hs, hed]
      · simp [hs]

/-- Helper for Example 10.32.2: a non-surviving exponent is deleted by the survivor projection. -/
lemma variablePowerIdeal_survivorPart_coeff_of_not_survives
    (p : MvPolynomial ℕ+ k) {d : ℕ+ →₀ ℕ} (hd : ¬ variablePowerIdeal_survives d) :
    coeff d (variablePowerIdeal_survivorPart (k := k) p) = 0 := by
  classical
  -- Every monomial contributing to the `d`-coefficient is either indexed by `d` and killed, or
  -- indexed by another exponent and has zero `d`-coefficient.
  dsimp [variablePowerIdeal_survivorPart]
  rw [MvPolynomial.coeff_sum]
  refine Finset.sum_eq_zero ?_
  intro e he
  by_cases hed : e = d
  · subst hed
    simp [hd]
  · by_cases hs : variablePowerIdeal_survives e
    · simp [hs, hed]
    · simp [hs]

/-- Helper for Example 10.32.2: the survivor projection of zero is zero. -/
lemma variablePowerIdeal_survivorPart_zero :
    variablePowerIdeal_survivorPart (k := k) (0 : MvPolynomial ℕ+ k) = 0 := by
  classical
  simp [variablePowerIdeal_survivorPart]

/-- Helper for Example 10.32.2: the survivor projection vanishes exactly on the defining ideal. -/
lemma variablePowerIdeal_survivorPart_eq_zero_iff (p : MvPolynomial ℕ+ k) :
    variablePowerIdeal_survivorPart (k := k) p = 0 ↔ p ∈ variablePowerIdeal k := by
  constructor
  · intro hzero
    -- A support monomial with nonzero coefficient cannot survive if the survivor projection is zero.
    rw [variablePowerIdeal_mem_iff_support]
    intro d hd
    have hd_coeff : p.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
    have hcoeff_zero :
        coeff d (variablePowerIdeal_survivorPart (k := k) p) = 0 := by
      simpa [hzero] using congrArg (MvPolynomial.coeff d) hzero
    have hnot_survives : ¬ variablePowerIdeal_survives d := by
      intro hsurvives
      have : p.coeff d = 0 := by
        simpa [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p hsurvives] using
          hcoeff_zero
      exact hd_coeff this
    by_contra hno_witness
    apply hnot_survives
    intro i
    exact lt_of_not_ge fun hi ↦ hno_witness ⟨i, hi⟩
  · intro hmem
    -- If every support monomial violates the survivor condition, every survivor coefficient is zero.
    apply MvPolynomial.ext
    intro d
    by_cases hd : variablePowerIdeal_survives d
    · rw [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p hd]
      by_contra hcoeff
      have hd_mem : d ∈ p.support := MvPolynomial.mem_support_iff.mpr hcoeff
      obtain ⟨i, hi⟩ :=
        (variablePowerIdeal_mem_iff_support (k := k) p).1 hmem d hd_mem
      exact (Nat.not_le_of_lt (hd i)) hi
    · rw [variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) p hd,
        MvPolynomial.coeff_zero]

/-- Helper for Example 10.32.2: a surviving sum forces both summands to survive. -/
lemma survivor_of_add {u v d : ℕ+ →₀ ℕ}
    (hadd : u + v = d) (hd : variablePowerIdeal_survives d) :
    variablePowerIdeal_survives u ∧ variablePowerIdeal_survives v := by
  constructor
  · intro i
    have hsum : (u + v) i < (i : ℕ) := by
      simpa [hadd] using hd i
    have hsum' : u i + v i < (i : ℕ) := by
      simpa [Finsupp.add_apply] using hsum
    exact lt_of_le_of_lt (Nat.le_add_right (u i) (v i)) hsum'
  · intro i
    have hsum : (u + v) i < (i : ℕ) := by
      simpa [hadd] using hd i
    have hsum' : u i + v i < (i : ℕ) := by
      simpa [Finsupp.add_apply] using hsum
    exact lt_of_le_of_lt (by simpa [add_comm] using Nat.le_add_right (v i) (u i)) hsum'

/-- Helper for Example 10.32.2: the survivor projection is additive. -/
lemma variablePowerIdeal_survivorPart_add (p₁ p₂ : MvPolynomial ℕ+ k) :
    variablePowerIdeal_survivorPart (k := k) (p₁ + p₂) =
      variablePowerIdeal_survivorPart (k := k) p₁ + variablePowerIdeal_survivorPart (k := k) p₂ := by
  -- Compare coefficients: the survivor projection keeps the same survivor test on each summand.
  apply MvPolynomial.ext
  intro d
  by_cases hd : variablePowerIdeal_survives d
  · rw [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) (p₁ + p₂) hd,
      MvPolynomial.coeff_add, MvPolynomial.coeff_add,
      variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p₁ hd,
      variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p₂ hd]
  · rw [variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) (p₁ + p₂) hd,
      MvPolynomial.coeff_add,
      variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) p₁ hd,
      variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) p₂ hd]
    simp

/-- Helper for Example 10.32.2: multiplying on the left only depends on the survivor part of the
right factor. -/
lemma variablePowerIdeal_survivorPart_mul_congr {p₁ p₂ a : MvPolynomial ℕ+ k}
    (h : variablePowerIdeal_survivorPart (k := k) p₁ =
      variablePowerIdeal_survivorPart (k := k) p₂) :
    variablePowerIdeal_survivorPart (k := k) (a * p₁) =
      variablePowerIdeal_survivorPart (k := k) (a * p₂) := by
  -- Route correction: instead of a coarse quotient argument, compare survivor coefficients of the
  -- product directly and use that a surviving output exponent has surviving right summands.
  apply MvPolynomial.ext
  intro d
  by_cases hd : variablePowerIdeal_survives d
  · rw [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) (a * p₁) hd,
      variablePowerIdeal_survivorPart_coeff_of_survives (k := k) (a * p₂) hd]
    rw [MvPolynomial.coeff_mul, MvPolynomial.coeff_mul]
    refine Finset.sum_congr rfl ?_
    intro uv huv
    have huv_eq : uv.1 + uv.2 = d := by
      simpa [Finset.mem_antidiagonal] using huv
    have huv_survives : variablePowerIdeal_survives uv.2 :=
      (survivor_of_add (hadd := huv_eq) hd).2
    have hcoeff := congrArg (MvPolynomial.coeff uv.2) h
    rw [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p₁ huv_survives,
      variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p₂ huv_survives] at hcoeff
    simp [hcoeff]
  · rw [variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) (a * p₁) hd,
      variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) (a * p₂) hd]

/-- Helper for Example 10.32.2: the survivor projection is constant along the generated quotient
relation. -/
lemma variablePowerIdeal_survivorPart_congr_rel
    {p₁ p₂ : MvPolynomial ℕ+ k}
    (h :
      RingConGen.Rel
        (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0) p₁ p₂) :
    variablePowerIdeal_survivorPart (k := k) p₁ =
      variablePowerIdeal_survivorPart (k := k) p₂ := by
  -- Induct over the generated congruence and discharge each constructor with the survivor API.
  induction h
  case of x y hxy =>
      rcases hxy with ⟨hx, hy⟩
      subst hy
      have hx_zero : variablePowerIdeal_survivorPart (k := k) x = 0 :=
        (variablePowerIdeal_survivorPart_eq_zero_iff (k := k) x).2 hx
      simpa [variablePowerIdeal_survivorPart_zero (k := k)] using hx_zero
  case refl x =>
      rfl
  case symm h ih =>
      exact ih.symm
  case trans h₁ h₂ ih₁ ih₂ =>
      exact ih₁.trans ih₂
  case add w x y z h₁ h₂ ih₁ ih₂ =>
      calc
        variablePowerIdeal_survivorPart (k := k) (w + y) =
            variablePowerIdeal_survivorPart (k := k) w +
              variablePowerIdeal_survivorPart (k := k) y :=
          variablePowerIdeal_survivorPart_add (k := k) w y
        _ =
            variablePowerIdeal_survivorPart (k := k) x +
              variablePowerIdeal_survivorPart (k := k) z := by rw [ih₁, ih₂]
        _ = variablePowerIdeal_survivorPart (k := k) (x + z) :=
          (variablePowerIdeal_survivorPart_add (k := k) x z).symm
  case mul w x y z h₁ h₂ ih₁ ih₂ =>
      have hleft :
          variablePowerIdeal_survivorPart (k := k) (w * y) =
            variablePowerIdeal_survivorPart (k := k) (x * y) := by
        simpa [mul_comm] using
          variablePowerIdeal_survivorPart_mul_congr (k := k) (a := y) ih₁
      have hright :
          variablePowerIdeal_survivorPart (k := k) (x * y) =
            variablePowerIdeal_survivorPart (k := k) (x * z) :=
          variablePowerIdeal_survivorPart_mul_congr (k := k) (a := x) ih₂
      exact hleft.trans hright

/-- Helper for Example 10.32.2: the class of `X_(n+1)^n` survives in the quotient. -/
lemma succ_variable_pow_class_ne_zero (n : ℕ) :
    q (((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n)) ≠ 0 := by
  intro hzero
  let p : MvPolynomial ℕ+ k := (X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n
  let r : MvPolynomial ℕ+ k → MvPolynomial ℕ+ k → Prop :=
    fun f g ↦ f ∈ variablePowerIdeal k ∧ g = 0
  -- Convert quotient equality to the generated congruence and then to vanishing survivor part.
  have hrel_eqv : Relation.EqvGen (RingQuot.Rel r) p 0 := by
    exact Quot.eqvGen_exact (by simpa [p, r, RingQuot.mkRingHom_def] using congrArg RingQuot.toQuot hzero)
  have hrel : RingConGen.Rel r p 0 := by
    rw [← RingQuot.eqvGen_rel_eq]
    exact hrel_eqv
  have hsurvivor :
      variablePowerIdeal_survivorPart (k := k) p =
        variablePowerIdeal_survivorPart (k := k) 0 :=
    variablePowerIdeal_survivorPart_congr_rel (k := k) hrel
  have hp_mem : p ∈ variablePowerIdeal k := by
    rw [← variablePowerIdeal_survivorPart_eq_zero_iff (k := k) p]
    simpa [variablePowerIdeal_survivorPart_zero (k := k)] using hsurvivor
  exact succ_variable_pow_not_mem_variablePowerIdeal (k := k) n hp_mem

-- Proof sketch: each generator of `quotientVariableIdeal k` is nilpotent in the quotient, so
-- `quotientVariableIdeal k` is a locally nilpotent ideal. But the image of `X (n + 1)` has
-- nonzero `n`th power for every `n`, so no power of `quotientVariableIdeal k` is zero.
/-- Example 10.32.2: if `R = k[X_n | n ∈ ℕ+]`, `I` is generated by the powers `X n ^ n`, and
`J` is the ideal of `R ⧸ I` generated by the images of the variables, then `J` is locally
nilpotent but not nilpotent. -/
theorem quotient_variable_ideal_locally_nilpotent_not_nilpotent :
    (quotientVariableIdeal k).IsLocallyNilpotent ∧ ¬ IsNilpotent (quotientVariableIdeal k) :=
  by
  constructor
  · -- Pull an element of the image ideal back to `idealOfVars`, then decompose it into support
    -- monomials, each of which carries a nilpotent variable factor.
    rw [Ideal.isLocallyNilpotent_iff]
    intro z hz
    obtain ⟨p, hp, rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective q (RingQuot.mkRingHom_surjective _)).mp hz
    have hp' : p ∈ Ideal.span (X '' (Set.univ : Set ℕ+)) := by
      simpa [idealOfVars, Set.image_univ] using hp
    have hsupport : ∀ m ∈ p.support, ∃ i : ℕ+, m i ≠ 0 := by
      simpa using
        (MvPolynomial.mem_ideal_span_X_image (R := k) (σ := ℕ+) (x := p) (s := Set.univ)).mp hp'
    rw [p.as_sum, map_sum]
    apply isNilpotent_sum
    intro m hm
    obtain ⟨i, hi⟩ := hsupport m hm
    exact quotient_monomial_isNilpotent_of_support (k := k)
      (m := m) (a := p.coeff m) (i := i) <| by
        simpa [Finsupp.mem_support_iff] using hi
  · -- The class of `X_(n+1)^n` lies in `J^n` and stays nonzero for every `n`.
    intro hnil
    obtain ⟨n, hn⟩ := hnil
    let i : ℕ+ := Nat.succPNat n
    have hxJ : q (X i : MvPolynomial ℕ+ k) ∈ quotientVariableIdeal k := by
      exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
    have hpowmem : q ((X i : MvPolynomial ℕ+ k) ^ n) ∈ quotientVariableIdeal k ^ n := by
      simpa [map_pow] using Ideal.pow_mem_pow hxJ n
    have hzero : q ((X i : MvPolynomial ℕ+ k) ^ n) = 0 := by
      simpa [hn] using hpowmem
    exact succ_variable_pow_class_ne_zero (k := k) n hzero

end

end
