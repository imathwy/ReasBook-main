import StacksProject_2024.Chap04.Lemma_4_21_5
import StacksProject_2024.Chap10.Lemma_10_127_1

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.Limits

universe u v

section

variable (R : Type u) [CommRing R]
variable (A : Type u) [CommRing A] [Algebra R A]

/-- The canonical diagram of finitely presented `R`-algebras over `A`, viewed in `CommAlgCat R`.
-/
abbrev finitelyPresentedAlgebrasOverDiagram :=
  selectedAlgebrasOverTargetDiagram (finitelyPresentedAlgebrasOverProperty R A)

/-- Helper for Lemma 10.127.2: whiskering the canonical finitely presented cocone along a final
functor preserves its colimit property. -/
noncomputable def directed_whisker_isColimit {I : Type v} [Preorder I] [Nonempty I]
    (F : I ⥤ finitelyPresentedAlgebrasOver R A) [F.Final] :
    IsColimit ((finitelyPresentedAlgebrasOverCocone R A).whisker F) := by
  -- Transfer the canonical colimit witness along the final functor from the directed refinement.
  exact
    (Functor.Final.isColimitWhiskerEquiv F (finitelyPresentedAlgebrasOverCocone R A)).symm
      (finitelyPresentedAlgebrasOverCoconeIsColimit R A)

/-- Helper for Lemma 10.127.2: evaluation on a finite generating family is surjective once those
generators adjoin the whole algebra. -/
lemma aeval_finset_surjective_of_adjoin_eq_top (s : Finset A)
    (hs : Algebra.adjoin R (s : Set A) = ⊤) :
    Function.Surjective
      (MvPolynomial.aeval ((↑) : s → A) : MvPolynomial s R →ₐ[R] A) := by
  -- Identify the range of the evaluation map with the subalgebra generated by the chosen family.
  rw [← AlgHom.range_eq_top]
  simpa [Algebra.adjoin_eq_range] using hs

/-- Helper for Lemma 10.127.2: a kernel-approximation stage is a finitely generated ideal inside
the kernel of the fixed polynomial presentation. -/
abbrev KernelApproximationStage {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) :=
  { J : Ideal (MvPolynomial s R) // J ≤ RingHom.ker π ∧ J.FG }

/-- Helper for Lemma 10.127.2: the kernel-approximation stages are nonempty via the zero ideal. -/
lemma kernelApproximationStage_nonempty {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) :
    Nonempty (KernelApproximationStage (R := R) (A := A) π) := by
  -- The zero ideal is finitely generated and lies in every kernel.
  exact ⟨⟨⊥, by
    constructor
    · exact bot_le
    · simpa using (Submodule.fg_bot : (⊥ : Ideal (MvPolynomial s R)).FG)⟩⟩

/-- Helper for Lemma 10.127.2: the kernel-approximation stages form a directed preorder under
inclusion, with joins providing common upper bounds. -/
lemma kernelApproximationStage_isDirectedOrder {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) :
    IsDirectedOrder (KernelApproximationStage (R := R) (A := A) π) := by
  -- Build the directed-order structure explicitly so that joins supply common upper bounds.
  refine ⟨?_⟩
  -- Enlarge two finite relation sets by taking the sum of the corresponding ideals.
  intro J K
  refine ⟨(⟨J.1 ⊔ K.1, ?_⟩ :
      KernelApproximationStage (R := R) (A := A) π), ?_, ?_⟩
  · constructor
    · exact sup_le J.2.1 K.2.1
    · exact Submodule.FG.sup J.2.2 K.2.2
  · change J.1 ≤ J.1 ⊔ K.1
    exact le_sup_left
  · change K.1 ≤ J.1 ⊔ K.1
    exact le_sup_right

/-- Helper for Lemma 10.127.2: the quotient by a kernel-approximation stage is the corresponding
`R`-algebra over `A`. -/
noncomputable abbrev kernelApproximationStageOver {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (J : KernelApproximationStage (R := R) (A := A) π) :
    Over (CommAlgCat.of R A) :=
  Over.mk (CommAlgCat.ofHom (Ideal.Quotient.liftₐ J.1 π J.2.1))

/-- Helper for Lemma 10.127.2: every kernel-approximation stage quotient is finitely presented
over `R`. -/
lemma kernelApproximationStage_finitePresentation {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (J : KernelApproximationStage (R := R) (A := A) π) :
    Algebra.FinitePresentation R (kernelApproximationStageOver (R := R) (A := A) π J).left := by
  -- Polynomial algebras on finitely many variables are finitely presented, and quotienting by a
  -- finitely generated ideal preserves finite presentation.
  letI : Algebra.FinitePresentation R (MvPolynomial s R) := by infer_instance
  simpa [kernelApproximationStageOver] using
    (Algebra.FinitePresentation.quotient (R := R) (A := MvPolynomial s R) J.2.2)

/-- Helper for Lemma 10.127.2: each kernel-approximation stage defines an object of the category
of finitely presented `R`-algebras over `A`. -/
noncomputable abbrev kernelApproximationStageObject {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (J : KernelApproximationStage (R := R) (A := A) π) :
    finitelyPresentedAlgebrasOver R A :=
  ⟨kernelApproximationStageOver (R := R) (A := A) π J,
    kernelApproximationStage_finitePresentation (R := R) (A := A) π J⟩

/-- Helper for Lemma 10.127.2: the zero ideal gives the bottom stage in the fixed-generator
kernel approximation system. -/
lemma kernelApproximationStage_bot_property {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) :
    (⊥ : Ideal (MvPolynomial s R)) ≤ RingHom.ker π ∧ (⊥ : Ideal (MvPolynomial s R)).FG := by
  -- The bottom stage carries no relations, so it is contained in every kernel and is finitely
  -- generated.
  constructor
  · exact bot_le
  · simpa using (Submodule.fg_bot : (⊥ : Ideal (MvPolynomial s R)).FG)

/-- Helper for Lemma 10.127.2: the quotient by the zero ideal is the initial stage of the
fixed-generator system. -/
noncomputable abbrev kernelApproximationStage_bot {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) :
    KernelApproximationStage (R := R) (A := A) π :=
  ⟨⊥, kernelApproximationStage_bot_property (R := R) (A := A) π⟩

/-- Helper for Lemma 10.127.2: enlarging the relation ideal gives a quotient map over `A`. -/
lemma kernelApproximationStage_map_commutes {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    {J K : KernelApproximationStage (R := R) (A := A) π} (hJK : J ≤ K) :
    CommAlgCat.ofHom (Ideal.Quotient.factorₐ R hJK) ≫
        (kernelApproximationStageOver (R := R) (A := A) π K).hom =
      (kernelApproximationStageOver (R := R) (A := A) π J).hom := by
  -- Both composites agree on quotient representatives from the source stage.
  apply CommAlgCat.hom_ext
  ext y
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective R J.1 y
  change
    (Ideal.Quotient.liftₐ K.1 π K.2.1)
        (Ideal.Quotient.factorₐ R hJK (Ideal.Quotient.mkₐ R J.1 x)) =
      (Ideal.Quotient.liftₐ J.1 π J.2.1) (Ideal.Quotient.mkₐ R J.1 x)
  simp [Ideal.Quotient.liftₐ]

/-- Helper for Lemma 10.127.2: the transition map between two kernel-approximation stages. -/
noncomputable abbrev kernelApproximationStage_map {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    {J K : KernelApproximationStage (R := R) (A := A) π} (hJK : J ≤ K) :
    kernelApproximationStageObject (R := R) (A := A) π J ⟶
      kernelApproximationStageObject (R := R) (A := A) π K :=
  CategoryTheory.ObjectProperty.homMk <|
    Over.homMk (CommAlgCat.ofHom (Ideal.Quotient.factorₐ R hJK))
      (kernelApproximationStage_map_commutes (R := R) (A := A) π hJK)

/-- Helper for Lemma 10.127.2: on polynomial representatives, the transition map is the canonical
quotient map. -/
@[simp] lemma kernelApproximationStage_map_apply_mk {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    {J K : KernelApproximationStage (R := R) (A := A) π} (hJK : J ≤ K)
    (x : MvPolynomial s R) :
    (kernelApproximationStage_map (R := R) (A := A) π hJK).hom.left
        (Ideal.Quotient.mkₐ R J.1 x) =
      Ideal.Quotient.mkₐ R K.1 x := by
  rfl

/-- Helper for Lemma 10.127.2: the identity morphism in the kernel-stage diagram is the identity
quotient map. -/
lemma kernelApproximationStage_diagram_map_id {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (J : KernelApproximationStage (R := R) (A := A) π) :
    kernelApproximationStage_map (R := R) (A := A) π (show J ≤ J from le_rfl) =
      𝟙 (kernelApproximationStageObject (R := R) (A := A) π J) := by
  -- The quotient map induced by `J ≤ J` agrees with the identity after restricting to polynomial
  -- representatives.
  apply CategoryTheory.ObjectProperty.hom_ext
  apply Over.OverMorphism.ext
  ext y
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective R J.1 y
  simp [kernelApproximationStage_map]

/-- Helper for Lemma 10.127.2: composing two transition maps is the transition map for the
composite inclusion of ideals. -/
lemma kernelApproximationStage_diagram_map_comp {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    {J K L : KernelApproximationStage (R := R) (A := A) π}
    (hJK : J ≤ K) (hKL : K ≤ L) :
    kernelApproximationStage_map (R := R) (A := A) π (show J ≤ L from hJK.trans hKL) =
      kernelApproximationStage_map (R := R) (A := A) π hJK ≫
        kernelApproximationStage_map (R := R) (A := A) π hKL := by
  -- Both composites are the same quotient map from `P ⧸ J` to `P ⧸ L`.
  apply CategoryTheory.ObjectProperty.hom_ext
  apply Over.OverMorphism.ext
  ext y
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective R J.1 y
  simp [kernelApproximationStage_map]

/-- Helper for Lemma 10.127.2: the fixed-generator finite-relation system assembled as a functor
to finitely presented `R`-algebras over `A`. -/
noncomputable def kernelApproximationStage_diagram {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) :
    KernelApproximationStage (R := R) (A := A) π ⥤ finitelyPresentedAlgebrasOver R A where
  obj J := kernelApproximationStageObject (R := R) (A := A) π J
  map h := kernelApproximationStage_map (R := R) (A := A) π (leOfHom h)
  map_id J := kernelApproximationStage_diagram_map_id (R := R) (A := A) π J
  map_comp h₁ h₂ :=
    kernelApproximationStage_diagram_map_comp (R := R) (A := A) π
      (leOfHom h₁) (leOfHom h₂)

/-- Helper for Lemma 10.127.2: the bottom-stage cocone leg defines a polynomial map into any
target cocone point. -/
noncomputable abbrev kernelApproximationStage_desc0 {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (t : Cocone ((kernelApproximationStage_diagram (R := R) (A := A) π) ⋙
      finitelyPresentedAlgebrasOverDiagram R A)) :
    MvPolynomial s R →ₐ[R] t.pt :=
  (t.ι.app (kernelApproximationStage_bot (R := R) (A := A) π)).hom.comp
    (Ideal.Quotient.mkₐ R ⊥)

/-- Helper for Lemma 10.127.2: cocone naturality from the bottom quotient stage identifies the
representative `x` at any stage with the same polynomial seen at the bottom stage. -/
lemma kernelApproximationStage_bottom_naturality_on_mk {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (t : Cocone ((kernelApproximationStage_diagram (R := R) (A := A) π) ⋙
      finitelyPresentedAlgebrasOverDiagram R A))
    (J : KernelApproximationStage (R := R) (A := A) π)
    (x : MvPolynomial s R) :
    (t.ι.app J).hom (Ideal.Quotient.mkₐ R J.1 x) =
      (t.ι.app (kernelApproximationStage_bot (R := R) (A := A) π)).hom
        (Ideal.Quotient.mkₐ R ⊥ x) := by
  -- Evaluate cocone naturality on the canonical map from the bottom stage to `J`.
  have hbotJ : kernelApproximationStage_bot (R := R) (A := A) π ≤ J := by
    change (kernelApproximationStage_bot (R := R) (A := A) π).1 ≤ J.1
    exact bot_le
  let h :=
    t.w (homOfLE hbotJ)
  -- On quotient representatives the transition map is exactly the quotient factor map.
  simpa [kernelApproximationStage_map_apply_mk] using
    congrArg
      (fun φ =>
        φ (Ideal.Quotient.mkₐ R (⊥ : Ideal (MvPolynomial s R)) x))
      h

/-- Helper for Lemma 10.127.2: every cocone leg agrees with the bottom-stage map on polynomial
representatives. -/
lemma kernelApproximationStage_cocone_leg_on_mk {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (t : Cocone ((kernelApproximationStage_diagram (R := R) (A := A) π) ⋙
      finitelyPresentedAlgebrasOverDiagram R A))
    (J : KernelApproximationStage (R := R) (A := A) π)
    (x : MvPolynomial s R) :
    (t.ι.app J).hom (Ideal.Quotient.mkₐ R J.1 x) =
      kernelApproximationStage_desc0 (R := R) (A := A) π t x := by
  -- Naturality along the bottom-stage map identifies all representatives with the same polynomial.
  simpa [kernelApproximationStage_desc0] using
    kernelApproximationStage_bottom_naturality_on_mk (R := R) (A := A) π t J x

/-- Helper for Lemma 10.127.2: the span of one kernel element is again a finitely generated stage
in the directed relation system. -/
lemma kernelApproximationStage_singleton_property {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) {x : MvPolynomial s R} (hx : x ∈ RingHom.ker π) :
    Ideal.span ({x} : Set (MvPolynomial s R)) ≤ RingHom.ker π ∧
      (Ideal.span ({x} : Set (MvPolynomial s R))).FG := by
  -- A single relation generates a finitely generated ideal, and it lies in the kernel because the
  -- chosen polynomial itself maps to zero in `A`.
  constructor
  · rw [Ideal.span_singleton_le_iff_mem]
    exact hx
  · simpa using (Submodule.fg_span_singleton x :
      (Ideal.span ({x} : Set (MvPolynomial s R))).FG)

/-- Helper for Lemma 10.127.2: the bottom-stage polynomial map vanishes on the full kernel of the
fixed polynomial presentation. -/
lemma kernelApproximationStage_desc0_kills_kernel {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (t : Cocone ((kernelApproximationStage_diagram (R := R) (A := A) π) ⋙
      finitelyPresentedAlgebrasOverDiagram R A))
    {x : MvPolynomial s R} (hx : x ∈ RingHom.ker π) :
    kernelApproximationStage_desc0 (R := R) (A := A) π t x = 0 := by
  -- Use the stage generated by the single relation `x`; there the class of `x` is zero, and the
  -- cocone-leg formula forces the bottom-stage value to vanish.
  let J : KernelApproximationStage (R := R) (A := A) π :=
    ⟨Ideal.span ({x} : Set (MvPolynomial s R)),
      kernelApproximationStage_singleton_property (R := R) (A := A) π hx⟩
  have hJ :
      Ideal.Quotient.mkₐ R J.1 x = 0 := by
    change (Ideal.Quotient.mk J.1 x : MvPolynomial s R ⧸ J.1) = 0
    exact (Ideal.Quotient.eq_zero_iff_mem).2
      (Ideal.subset_span (by simp : x ∈ ({x} : Set (MvPolynomial s R))))
  -- The singleton-relation stage sends the class of `x` to zero, so the bottom-stage value also
  -- vanishes by the cocone-leg formula.
  calc
    kernelApproximationStage_desc0 (R := R) (A := A) π t x
        = (t.ι.app J).hom (Ideal.Quotient.mkₐ R J.1 x) := by
            symm
            exact kernelApproximationStage_cocone_leg_on_mk (R := R) (A := A) π t J x
    _ = (t.ι.app J).hom 0 := by
          rw [hJ]
          rfl
    _ = 0 := by simpa using (map_zero (t.ι.app J).hom)

/-- Helper for Lemma 10.127.2: the canonical cocone to `A` evaluates a quotient representative by
the fixed polynomial presentation `π`. -/
@[simp] lemma kernelApproximationStage_canonical_cocone_leg_on_mk {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    (J : KernelApproximationStage (R := R) (A := A) π)
    (x : MvPolynomial s R) :
    (((finitelyPresentedAlgebrasOverCocone R A).whisker
      (kernelApproximationStage_diagram (R := R) (A := A) π)).ι.app J)
        (Ideal.Quotient.mkₐ R J.1 x) = π x := by
  -- The canonical cocone leg is the quotient lift of `π` along the stage ideal.
  change (Ideal.Quotient.liftₐ J.1 π J.2.1) (Ideal.Quotient.mkₐ R J.1 x) = π x
  simp [Ideal.Quotient.liftₐ]

/-- Helper for Lemma 10.127.2: the canonical cocone on the fixed-generator quotient system is
colimiting. -/
theorem kernelApproximationStage_cocone_hasColimit {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) (hπ : Function.Surjective π) :
    Nonempty (IsColimit ((finitelyPresentedAlgebrasOverCocone R A).whisker
      (kernelApproximationStage_diagram (R := R) (A := A) π))) := by
  -- Descend the bottom-stage polynomial map through the surjective presentation `π`.
  let descAlg :
      ∀ t : Cocone ((kernelApproximationStage_diagram (R := R) (A := A) π) ⋙
          finitelyPresentedAlgebrasOverDiagram R A),
        A →ₐ[R] t.pt :=
    fun t ↦
      AlgHom.liftOfSurjective π hπ
        (kernelApproximationStage_desc0 (R := R) (A := A) π t)
        (by
          intro x hx
          exact kernelApproximationStage_desc0_kills_kernel (R := R) (A := A) π t hx)
  refine ⟨{ desc := fun t ↦ CommAlgCat.ofHom (descAlg t), fac := ?_, uniq := ?_ }⟩
  · intro t J
    -- Check the factorization on quotient representatives at the stage `J`.
    apply CommAlgCat.hom_ext
    ext y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective R J.1 y
    calc
      ((((finitelyPresentedAlgebrasOverCocone R A).whisker
          (kernelApproximationStage_diagram (R := R) (A := A) π)).ι.app J) ≫
          CommAlgCat.ofHom (descAlg t)) (Ideal.Quotient.mkₐ R J.1 x)
          = descAlg t
              ((((finitelyPresentedAlgebrasOverCocone R A).whisker
                  (kernelApproximationStage_diagram (R := R) (A := A) π)).ι.app J)
                (Ideal.Quotient.mkₐ R J.1 x)) := by
                  rfl
      _ = descAlg t (π x) := by
            rw [kernelApproximationStage_canonical_cocone_leg_on_mk (R := R) (A := A) π J x]
      _ = kernelApproximationStage_desc0 (R := R) (A := A) π t x := by
            simp [descAlg]
      _ = (t.ι.app J).hom (Ideal.Quotient.mkₐ R J.1 x) := by
            symm
            exact kernelApproximationStage_cocone_leg_on_mk (R := R) (A := A) π t J x
  · intro t m hm
    -- Surjectivity of `π` reduces uniqueness to the bottom-stage representative formula.
    apply CommAlgCat.hom_ext
    ext a
    obtain ⟨x, rfl⟩ := hπ a
    have hbot := congrArg
      (fun φ => φ (Ideal.Quotient.mkₐ R (⊥ : Ideal (MvPolynomial s R)) x))
      (hm (kernelApproximationStage_bot (R := R) (A := A) π))
    have hm_apply :
        m (π x) =
          (t.ι.app (kernelApproximationStage_bot (R := R) (A := A) π)).hom
            (Ideal.Quotient.mkₐ R (⊥ : Ideal (MvPolynomial s R)) x) := by
      simpa [kernelApproximationStage_canonical_cocone_leg_on_mk (R := R) (A := A) π
        (kernelApproximationStage_bot (R := R) (A := A) π) x] using hbot
    have hdesc0 :
        (t.ι.app (kernelApproximationStage_bot (R := R) (A := A) π)).hom
            (Ideal.Quotient.mkₐ R (⊥ : Ideal (MvPolynomial s R)) x) =
          kernelApproximationStage_desc0 (R := R) (A := A) π t x := by
      rfl
    have hdesc_apply :
        descAlg t (π x) = kernelApproximationStage_desc0 (R := R) (A := A) π t x := by
      simp [descAlg]
    exact hm_apply.trans (hdesc0.trans hdesc_apply.symm)

/-- Helper for Lemma 10.127.2: every transition map in the kernel-stage diagram is surjective on
the underlying quotient rings. -/
lemma kernelApproximationStage_map_surjective {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A)
    {J K : KernelApproximationStage (R := R) (A := A) π} (hJK : J ≤ K) :
    Function.Surjective ((kernelApproximationStage_map (R := R) (A := A) π hJK).hom.left) := by
  -- Every quotient class in the target is represented by a polynomial already coming from `J`.
  intro y
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mkₐ_surjective R K.1 y
  refine ⟨Ideal.Quotient.mkₐ R J.1 x, ?_⟩
  exact Ideal.Quotient.factorₐ_apply_mk (R₁ := R) (hIJ := hJK) x

/-- Helper for Lemma 10.127.2: reindex the kernel-stage diagram by `ULift` to land in the
required universe for the theorem statement. -/
noncomputable def kernelApproximationStage_diagram_ulift {s : Finset A}
    (π : MvPolynomial s R →ₐ[R] A) :
    ULift.{u + 1} (KernelApproximationStage (R := R) (A := A) π) ⥤
      finitelyPresentedAlgebrasOver R A where
  obj i := (kernelApproximationStage_diagram (R := R) (A := A) π).obj i.down
  map {X Y} h :=
    let hij : X ≤ Y := leOfHom h
    (kernelApproximationStage_diagram (R := R) (A := A) π).map
      (homOfLE (show X.down ≤ Y.down from hij))
  map_id X := by
    simpa using (kernelApproximationStage_diagram (R := R) (A := A) π).map_id X.down
  map_comp {X Y Z} h₁ h₂ := by
    let h₁' : X ≤ Y := leOfHom h₁
    let h₂' : Y ≤ Z := leOfHom h₂
    simpa using
      (kernelApproximationStage_diagram (R := R) (A := A) π).map_comp
        (homOfLE (show X.down ≤ Y.down from h₁'))
        (homOfLE (show Y.down ≤ Z.down from h₂'))

-- Proof sketch: apply the directed-set refinement of filtered colimits from Lemma 4.21.5 to the
-- finite-presentation approximation of `A` from Lemma 10.127.1. Equivalently, present `A` by the
-- directed system of quotients `R[X_s; s ∈ S] / (E)` attached to finite sets of generators and
-- finitely many polynomial relations among them.
/-- Lemma 10.127.2 (1): every `R`-algebra `A` is isomorphic to the colimit of a directed system of
`R`-algebras of finite presentation. -/
theorem exists_directed_system_of_finitelyPresented_algebras :
    ∃ (I : Type (u + 1)) (_ : Preorder I) (_ : Nonempty I) (_ : IsDirectedOrder I)
      (F : I ⥤ finitelyPresentedAlgebrasOver R A),
      Nonempty
          (IsColimit
            ((finitelyPresentedAlgebrasOverCocone R A).whisker
              F)) := by
  classical
  -- Reindex the canonical filtered presentation from Lemma 10.127.1 by a final functor from a
  -- directed preorder, exactly as in Lemma 4.21.5.
  let _ : EssentiallySmall.{u + 1, u, u + 1} (finitelyPresentedAlgebrasOver R A) := by
    infer_instance
  let _ : FinallySmall.{u + 1, u, u + 1} (finitelyPresentedAlgebrasOver R A) :=
    CategoryTheory.finallySmall_of_essentiallySmall.{u + 1, u, u + 1}
      (J := finitelyPresentedAlgebrasOver R A)
  obtain ⟨I, hI, hInonempty, hIdir, F, hF⟩ :=
    CategoryTheory.exists_final_from_directed.{u + 1, u, u + 1}
      (finitelyPresentedAlgebrasOver R A)
  let _ : PartialOrder I := hI
  let _ : Nonempty I := hInonempty
  let _ : IsDirectedOrder I := hIdir
  let _ : F.Final := hF
  refine ⟨I, inferInstance, inferInstance, inferInstance, F, ?_⟩
  -- The reindexed cocone is colimiting because whiskering along a final functor preserves colimits.
  exact ⟨directed_whisker_isColimit (R := R) (A := A) F⟩

-- Proof sketch: choose a finite generating set of `A` over `R`. Restrict the directed system from
-- the first clause to stages built from that fixed finite set of generators and varying finite sets
-- of relations; enlarging the relation set gives quotient maps, hence all transition maps are
-- surjective, and the restricted system still has colimit `A`.
/-- Lemma 10.127.2 (2): if `A` is of finite type over `R`, then `A` is isomorphic to the colimit
of a directed system of finitely presented `R`-algebras whose transition maps are all
surjective. -/
theorem exists_directed_system_of_finitelyPresented_algebras_with_surjective_transition_maps
    [Algebra.FiniteType R A] :
    ∃ (I : Type (u + 1)) (_ : Preorder I) (_ : Nonempty I) (_ : IsDirectedOrder I)
      (F : I ⥤ finitelyPresentedAlgebrasOver R A),
      (∀ ⦃i j : I⦄, (hij : i ≤ j) →
        Function.Surjective
          ((F ⋙ finitelyPresentedAlgebrasOverDiagram R A).map (homOfLE hij))) ∧
        Nonempty
          (IsColimit
            ((finitelyPresentedAlgebrasOverCocone R A).whisker
              F)) := by
  classical
  -- Route correction: the quotient-stage diagram is now explicit, but the remaining step needs a
  -- universe-lifted index type together with the colimit witness from
  -- `kernelApproximationStage_cocone_hasColimit`.
  obtain ⟨s, hs⟩ := (inferInstance : Algebra.FiniteType R A).out
  let π : MvPolynomial s R →ₐ[R] A := MvPolynomial.aeval ((↑) : s → A)
  have hπ : Function.Surjective π :=
    aeval_finset_surjective_of_adjoin_eq_top (R := R) (A := A) s hs
  let _ : Nonempty (KernelApproximationStage (R := R) (A := A) π) :=
    kernelApproximationStage_nonempty (R := R) (A := A) π
  let _ : IsDirectedOrder (KernelApproximationStage (R := R) (A := A) π) :=
    kernelApproximationStage_isDirectedOrder (R := R) (A := A) π
  let I : Type (u + 1) :=
    ULift.{u + 1} (KernelApproximationStage (R := R) (A := A) π)
  let hdown : Monotone (fun i : I ↦ i.down) := fun _ _ h ↦ h
  let Fdown : I ⥤ KernelApproximationStage (R := R) (A := A) π :=
    hdown.functor
  let F : I ⥤ finitelyPresentedAlgebrasOver R A :=
    Fdown ⋙ kernelApproximationStage_diagram (R := R) (A := A) π
  have hIdir : IsDirectedOrder I := by
    refine ⟨?_⟩
    intro i j
    obtain ⟨k, hik, hjk⟩ :=
      (kernelApproximationStage_isDirectedOrder (R := R) (A := A) π).1 i.down j.down
    exact ⟨ULift.up k, hik, hjk⟩
  obtain ⟨hcolimBase⟩ :=
    kernelApproximationStage_cocone_hasColimit (R := R) (A := A) π hπ
  have hFinal : Fdown.Final := by
    change hdown.functor.Final
    exact (Monotone.final_functor_iff hdown).2 fun j ↦ ⟨ULift.up j, le_rfl⟩
  have hcolim :
      IsColimit ((finitelyPresentedAlgebrasOverCocone R A).whisker F) := by
    let _ : Fdown.Final := hFinal
    simpa [F, Fdown, I] using
      (Functor.Final.isColimitWhiskerEquiv
        (F := Fdown)
        ((finitelyPresentedAlgebrasOverCocone R A).whisker
          (kernelApproximationStage_diagram (R := R) (A := A) π))).symm hcolimBase
  refine ⟨I, inferInstance, inferInstance, hIdir, F, ?_⟩
  constructor
  · intro i j hij
    -- The transition maps are quotient maps obtained by enlarging the relation ideal.
    simpa [F, Fdown, I, finitelyPresentedAlgebrasOverDiagram] using
      kernelApproximationStage_map_surjective (R := R) (A := A) π
        (show (ULift.down i) ≤ ULift.down j from hij)
  · exact ⟨hcolim⟩

end
