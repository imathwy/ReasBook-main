import StacksProject_2024.Chap10.Lemma_10_32_6

-- Theorem-local support for Lemma 10.77.5.

open Polynomial

universe u

section

variable {A : Type u} [Ring A]

/-- Helper for Lemma 10.77.5: in a commutative ring, the principal ideal generated by a nilpotent
element is locally nilpotent. -/
lemma span_singleton_isLocallyNilpotent_of_isNilpotent {R : Type*} [CommRing R] {x : R}
    (hx : IsNilpotent x) : (Ideal.span ({x} : Set R)).IsLocallyNilpotent := by
  -- Local nilpotence is checked elementwise, and every element of a principal ideal is a multiple
  -- of the generator.
  rw [Ideal.isLocallyNilpotent_iff]
  intro y hy
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hy
  obtain ⟨n, hn⟩ := hx
  refine ⟨n, ?_⟩
  simp [mul_pow, hn]

/-- Helper for Lemma 10.77.5: in the universal quotient by `((X^2 - X)^n)`, the defect class of
`X` is nilpotent. -/
lemma universal_idempotency_defect_nilpotent (n : ℕ) :
    let P : ℤ[X] := X ^ 2 - X
    let J : Ideal ℤ[X] := Ideal.span ({P ^ n} : Set ℤ[X])
    (Ideal.Quotient.mk J P : ℤ[X] ⧸ J) ^ n = 0 := by
  intro P J
  -- The quotient relation is exactly the vanishing of `(X^2 - X)^n`.
  calc
    (Ideal.Quotient.mk J P : ℤ[X] ⧸ J) ^ n = Ideal.Quotient.mk J (P ^ n) := by
      simp
    _ = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))

/-- Helper for Lemma 10.77.5: modulo the principal ideal generated by its defect `e^2 - e`, an
element becomes idempotent. -/
lemma quotient_mk_isIdempotentElem_of_span_idempotency_defect {R : Type*} [CommRing R] (e : R) :
    IsIdempotentElem (Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) e) := by
  -- The idempotency defect vanishes in the quotient by the ideal it generates.
  rw [IsIdempotentElem]
  apply sub_eq_zero.mp
  calc
    Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) e *
        Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) e -
        Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) e =
      Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) (e ^ 2 - e) := by
        simp [pow_two]
    _ = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)

/-- Helper for Lemma 10.77.5: the local support version of Lemma `10.32.7`, used to correct a
lifted pre-idempotent by adding its defect times a polynomial in the original element. -/
theorem exists_idempotent_eq_add_defect_mul_aeval (e : A)
    (hx : IsNilpotent (e ^ 2 - e)) :
    ∃ q : ℤ[X], IsIdempotentElem (e + (e ^ 2 - e) * aeval e q) := by
  obtain ⟨n, hxn⟩ := hx
  let P : ℤ[X] := X ^ 2 - X
  let J : Ideal ℤ[X] := Ideal.span ({P ^ n} : Set ℤ[X])
  let ebar : ℤ[X] ⧸ J := Ideal.Quotient.mk J X
  let xbar : ℤ[X] ⧸ J := Ideal.Quotient.mk J P
  let I : Ideal (ℤ[X] ⧸ J) := Ideal.span ({xbar} : Set (ℤ[X] ⧸ J))
  have hxbar_nilpotent : IsNilpotent xbar := by
    -- The universal quotient imposes the relation `(X^2 - X)^n = 0`.
    refine ⟨n, ?_⟩
    simpa [P, J, xbar] using universal_idempotency_defect_nilpotent n
  have hI : I.IsLocallyNilpotent := by
    -- The defect ideal in the universal commutative quotient is principal and generated by a
    -- nilpotent element.
    simpa [I] using
      span_singleton_isLocallyNilpotent_of_isNilpotent (x := xbar) hxbar_nilpotent
  have hebar_mod : IsIdempotentElem (Ideal.Quotient.mk I ebar) := by
    -- Modding out by the defect ideal makes the class of `X` idempotent.
    simpa [I, xbar, P, ebar] using
      quotient_mk_isIdempotentElem_of_span_idempotency_defect (e := ebar)
  obtain ⟨ebar', hebar', -⟩ :=
    existsUnique_idempotent_lift_quotient_of_isLocallyNilpotent hI
      (Ideal.Quotient.mk I ebar) hebar_mod
  have hdiff_mem : ebar' - ebar ∈ I := by
    -- The lifted idempotent has the same image as `ebar`, so their difference lies in the defect
    -- ideal.
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem ebar' ebar).mp hebar'.2
  obtain ⟨qbar, hqbar⟩ := Ideal.mem_span_singleton.mp hdiff_mem
  obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective qbar
  let ψ : ℤ[X] →+* A := (aeval e).toRingHom
  have hJzero : ∀ p : ℤ[X], p ∈ J → ψ p = 0 := by
    -- Evaluation at `e` kills the universal relation because `(e^2 - e)^n = 0`.
    intro p hp
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hp
    simp [ψ, P, hxn]
  let φ : ℤ[X] ⧸ J →+* A := Ideal.Quotient.lift J ψ hJzero
  have hφ_ebar : φ ebar = e := by
    -- The factor map agrees with evaluation on the class of `X`.
    simp [φ, ebar, ψ]
  have hφ_xbar : φ xbar = e ^ 2 - e := by
    -- The factor map also agrees with evaluation on the idempotency defect polynomial.
    simp [φ, xbar, P, ψ]
  have hebar'_eq : ebar' = ebar + xbar * qbar := by
    -- The difference computation rewrites the lifted idempotent into the required correction form.
    rw [sub_eq_iff_eq_add] at hqbar
    simpa [add_comm, add_left_comm, add_assoc] using hqbar
  have hφ_ebar' : φ ebar' = e + (e ^ 2 - e) * aeval e q := by
    -- Evaluating the universal correction polynomial gives the desired explicit element of `A`.
    calc
      φ ebar' = φ (ebar + xbar * qbar) := by rw [hebar'_eq]
      _ = φ ebar + φ xbar * φ qbar := by simp
      _ = e + (e ^ 2 - e) * aeval e q := by
        rw [hφ_ebar, hφ_xbar, ← hq]
        simp [φ, ψ]
  refine ⟨q, ?_⟩
  -- The universal idempotent stays idempotent after applying the factor map.
  simpa [hφ_ebar'] using hebar'.1.map φ

end
