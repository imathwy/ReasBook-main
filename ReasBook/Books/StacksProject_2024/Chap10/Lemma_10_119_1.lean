import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

section

variable {R : Type u} {K : Type v}
variable [CommRing R] [IsDomain R] [IsLocalRing R] [IsNoetherianRing R]
variable [Field K] [Algebra R K] [IsFractionRing R K]

/-
Domain triage:
* primary domain: local overrings of a Noetherian local domain inside its fraction field;
* sampled owner API:
  - `LocalSubring.exists_le_valuationSubring` for dominating local overrings of a field;
  - `RingHom.EssFiniteType` / `Algebra.EssFiniteType` for the essentially finite type condition;
  - `ringKrullDim` for the Krull-dimension owner recalled in Definition `10.60.2`.
* best owner abstractions:
  - `source-facing`: the existence of an intermediate `R`-subalgebra of `K`;
  - `core/canonical`: domination is expressed through the local-map owner
    `IsLocalHom (algebraMap R A)` together with `IsLocalRing A`, and finite-type data belongs to
    `Algebra.EssFiniteType R A`.
* primitive vs. derived:
  - the primitive conclusion data are the intermediate subalgebra `A`, its local structure, the
    locality of `R → A`, the dimension statement, and essential finite type over `R`;
  - Noetherianity of `A` is derived from `Algebra.EssFiniteType R A` and the ambient
    `[IsNoetherianRing R]`, so it should not be stored as separate primitive output data.
-/

-- Proof sketch: choose a valuation overring of `R` in `K` dominating `R` via
-- `LocalSubring.exists_le_valuationSubring`. Let `x₁, …, x_r` be a minimal generating set of the
-- maximal ideal, form the finitely generated `R`-subalgebra generated by the quotients `xᵢ / x_r`,
-- and localize at a minimal prime over the principal ideal generated by `x_r`. Krull's principal
-- ideal theorem gives Krull dimension `1`, the localization is local Noetherian, and the map from
-- `R` remains local and essentially of finite type.
/-- Helper for Lemma 10.119.1: a local domain which is not a field contains a nonzero element of
its maximal ideal. -/
lemma exists_nonzero_mem_maximalIdeal_of_not_isField (hR : ¬ IsField R) :
    ∃ x : R, x ∈ IsLocalRing.maximalIdeal R ∧ x ≠ 0 := by
  -- The maximal ideal is nontrivial precisely because `R` is not a field.
  have hm_ne_bot : IsLocalRing.maximalIdeal R ≠ ⊥ :=
    IsLocalRing.isField_iff_maximalIdeal_eq.not.mp hR
  -- Extract a nonzero element from that nonzero ideal.
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm_ne_bot
  exact ⟨x, hx, hx0⟩

/-- Helper for Lemma 10.119.1: a prime minimal over a nonzero principal ideal in a Noetherian
domain has prime height `1`. -/
lemma primeHeight_eq_one_of_mem_minimalPrimes_span_singleton_of_nonzero
    {S : Type*} [CommRing S] [IsDomain S] [IsNoetherianRing S]
    {x : S} (hx : x ≠ 0) (q : Ideal S) [q.IsPrime]
    (hq : q ∈ (Ideal.span ({x} : Set S)).minimalPrimes) :
    q.primeHeight = 1 := by
  -- Krull's principal ideal theorem gives the upper bound.
  have hq_le : q.primeHeight ≤ 1 := by
    rw [← Ideal.height_eq_primeHeight]
    exact Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes
      (Ideal.span ({x} : Set S)) q hq
  -- Since `x ≠ 0` and `x ∈ q`, the prime ideal `q` is strictly above `⊥`.
  have hq_ne_bot : q ≠ ⊥ := by
    intro hq_bot
    have hxq : x ∈ q := hq.1.2 (Ideal.subset_span (by simp))
    rw [hq_bot, Ideal.mem_bot] at hxq
    exact hx hxq
  have hbot_lt : (⊥ : Ideal S) < q := bot_lt_iff_ne_bot.mpr hq_ne_bot
  -- Height strictly increases along a strict prime inclusion.
  have hbot_height : (⊥ : Ideal S).primeHeight = 0 := by
    rw [Ideal.primeHeight_eq_zero_iff, IsDomain.minimalPrimes_eq_singleton_bot]
    simp
  have hq_ge : (1 : ℕ∞) ≤ q.primeHeight := by
    simpa [hbot_height] using
      Ideal.primeHeight_add_one_le_of_lt (I := (⊥ : Ideal S)) (J := q) hbot_lt
  exact le_antisymm hq_le hq_ge

/-- Helper for Lemma 10.119.1: localizing a domain at a prime and then viewing that localization
inside the ambient fraction field preserves the prime height as Krull dimension. -/
lemma ringKrullDim_localization_subalgebra_eq_primeHeight
    {S : Type*} [CommRing S] [IsDomain S]
    [Algebra S K] [IsFractionRing S K] (q : PrimeSpectrum S) :
    ringKrullDim
        (Localization.subalgebra.ofField K q.asIdeal.primeCompl
          q.asIdeal.primeCompl_le_nonZeroDivisors) =
      q.asIdeal.primeHeight := by
  -- The subalgebra model is itself an `AtPrime` localization, so its dimension is the height of
  -- the chosen prime.
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height q.asIdeal,
    Ideal.height_eq_primeHeight]

/-- Helper for Lemma 10.119.1: in a finite nonempty subset of a valuation ring consisting of
nonzero elements, one element divides all the others. -/
lemma exists_mem_finset_dvd_all_of_valuationRing
    {V : Type*} [CommRing V] [IsDomain V] [ValuationRing V]
    (t : Finset V) (ht : t.Nonempty) (h0 : ∀ y ∈ t, y ≠ 0) :
    ∃ yr ∈ t, yr ≠ 0 ∧ ∀ y ∈ t, yr ∣ y := by
  classical
  -- Use strong induction on the size of the finite set.
  refine Finset.strongInductionOn t ?_ ht h0
  intro t ih ht' h0'
  obtain ⟨a, ha⟩ := ht'
  let s := t.erase a
  have hst : insert a s = t := by
    simp [s, ha]
  by_cases hs_empty : s.Nonempty
  · -- Compare `a` with a common divisor chosen from the smaller finset.
    have hs0 : ∀ y ∈ s, y ≠ 0 := by
      intro y hy
      exact h0' y (hst ▸ Finset.mem_insert_of_mem hy)
    obtain ⟨yr, hyrs, hyr0, hyr_all⟩ := ih s (Finset.erase_ssubset ha) hs_empty hs0
    rcases ValuationRing.dvd_total a yr with h | h
    · refine ⟨a, hst ▸ by simp [s], h0' a (hst ▸ by simp), ?_⟩
      intro y hy
      rw [← hst] at hy
      rcases Finset.mem_insert.mp hy with rfl | hys
      · exact dvd_rfl
      · exact dvd_trans h (hyr_all y hys)
    · refine ⟨yr, hst ▸ by simp [s, hyrs], hyr0, ?_⟩
      intro y hy
      rw [← hst] at hy
      rcases Finset.mem_insert.mp hy with rfl | hys
      · exact h
      · exact hyr_all y hys
  · -- If the smaller finset is empty, the unique remaining element is the desired divisor.
    have hs_eq : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs_empty
    refine ⟨a, hst ▸ by simp [s, hs_eq], h0' a (hst ▸ by simp), ?_⟩
    intro y hy
    rw [← hst] at hy
    rcases Finset.mem_insert.mp hy with rfl | hys
    · exact dvd_rfl
    · simpa [s, hs_eq] using hys

/-- Helper for Lemma 10.119.1: if a valuation subring dominates the range of `R` in `K`, then
every element of `R` maps into that valuation subring. -/
lemma algebraMap_mem_valuationSubring_of_le
    {V : ValuationSubring K}
    (hRV : LocalSubring.range (algebraMap R K) ≤ V.toLocalSubring) (x : R) :
    algebraMap R K x ∈ V.toSubring := by
  -- Membership is immediate because the range local subring is generated by the image of `R`.
  exact hRV.1
    (show algebraMap R K x ∈ (LocalSubring.range (algebraMap R K)).toSubring from by
      change algebraMap R K x ∈ Set.range (algebraMap R K)
      exact ⟨x, rfl⟩)

/-- Helper for Lemma 10.119.1: a valuation subring dominating the image of `R` in `K` canonically
defines an `R`-subalgebra of `K`. -/
noncomputable def valuationSubringSubalgebra (V : ValuationSubring K)
    (hRV : LocalSubring.range (algebraMap R K) ≤ V.toLocalSubring) : Subalgebra R K where
  __ := V.toSubring
  algebraMap_mem' := algebraMap_mem_valuationSubring_of_le hRV

/-- Helper for Lemma 10.119.1: from a finite generating set of the maximal ideal, one can choose
one nonzero generator whose quotients with all generators lie in the dominating valuation
subring. -/
lemma exists_nonzero_generator_with_quotients_mem_valuationSubring
    (hR : ¬ IsField R) {V : ValuationSubring K}
    (hRV : LocalSubring.range (algebraMap R K) ≤ V.toLocalSubring)
    (s : Finset R) (hs : Ideal.span (↑s : Set R) = IsLocalRing.maximalIdeal R) :
    ∃ xr ∈ s, xr ≠ 0 ∧ ∀ x ∈ s, algebraMap R K x / algebraMap R K xr ∈ V.toSubring := by
  classical
  let e : R ↪ V :=
    { toFun := fun x =>
        (⟨algebraMap R K x, algebraMap_mem_valuationSubring_of_le hRV x⟩ : V)
      inj' := by
        intro x y hxy
        exact (IsFractionRing.injective R K) (congrArg Subtype.val hxy) }
  let s₀ := s.filter fun x => x ≠ 0
  have hs₀_nonempty : s₀.Nonempty := by
    -- If all generators were zero, the maximal ideal would vanish, contradicting `hR`.
    obtain ⟨x, hx, hx0⟩ := exists_nonzero_mem_maximalIdeal_of_not_isField (R := R) hR
    have hxspan : x ∈ Ideal.span (↑s : Set R) := by
      simpa [hs] using hx
    by_contra hs₀_empty
    have hs₀_eq : s₀ = ∅ := Finset.not_nonempty_iff_eq_empty.mp hs₀_empty
    have hs_zero : ∀ y ∈ s, y = 0 := by
      intro y hy
      by_contra hy0
      have : y ∈ s₀ := by
        simp [s₀, hy, hy0]
      simpa [hs₀_eq] using this
    have hspan_bot : Ideal.span (↑s : Set R) = ⊥ := by
      refine le_antisymm ?_ bot_le
      refine Ideal.span_le.mpr ?_
      intro y hy
      rw [hs_zero y (by simpa using hy)]
      exact Ideal.zero_mem _
    have hxbot : x ∈ (⊥ : Ideal R) := by
      simpa [hspan_bot] using hxspan
    exact hx0 (by simpa using hxbot)
  let t : Finset V := s₀.image e
  have ht_nonempty : t.Nonempty := by
    -- The image finset stays nonempty because the chosen embedding is injective.
    obtain ⟨x, hx⟩ := hs₀_nonempty
    refine ⟨e x, ?_⟩
    simp [t, hx]
  have ht0 : ∀ y ∈ t, y ≠ 0 := by
    -- Every element of the image finset comes from a nonzero generator.
    intro y hy
    rcases Finset.mem_image.mp hy with ⟨x, hx, rfl⟩
    intro hx0
    have hx0' : algebraMap R K x = 0 := congrArg Subtype.val hx0
    exact (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).2
      ((Finset.mem_filter.mp hx).2) hx0'
  obtain ⟨yr, hyrt, _, hyr_all⟩ :=
    exists_mem_finset_dvd_all_of_valuationRing t ht_nonempty ht0
  rcases Finset.mem_image.mp hyrt with ⟨xr, hxr0, hyr_eq⟩
  refine ⟨xr, (Finset.mem_filter.mp hxr0).1, (Finset.mem_filter.mp hxr0).2, ?_⟩
  intro x hx
  by_cases hx0 : x = 0
  · -- Zero has quotient `0`, so this case is immediate.
    simp [hx0]
  · -- For nonzero generators, divisibility in the valuation ring gives the required quotient.
    have hxt : e x ∈ t := by
      simp [t, s₀, hx, hx0]
    obtain ⟨c, hc⟩ := hyr_all (e x) hxt
    have hxrK : algebraMap R K xr ≠ 0 := by
      exact (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).2
        ((Finset.mem_filter.mp hxr0).2)
    have hcK : algebraMap R K x = algebraMap R K xr * (c : V) := by
      exact congrArg Subtype.val (hyr_eq ▸ hc)
    have hdiv : algebraMap R K x / algebraMap R K xr = (c : V) := by
      apply div_eq_iff hxrK |>.2
      simpa [hcK, mul_comm]
    exact hdiv ▸ c.2

/-- Helper for Lemma 10.119.1: adjoining finitely many quotients that already lie in the
dominating valuation subring keeps the whole adjoin inside that valuation subring. -/
lemma adjoin_quotients_le_valuationSubring
    {V : ValuationSubring K}
    (hRV : LocalSubring.range (algebraMap R K) ≤ V.toLocalSubring)
    (s : Finset R) (xr : R)
    (hquot : ∀ x ∈ s, algebraMap R K x / algebraMap R K xr ∈ V.toSubring) :
    Algebra.adjoin R ((fun x : R ↦ algebraMap R K x / algebraMap R K xr) '' (↑s : Set R)) ≤
      valuationSubringSubalgebra (R := R) (K := K) V hRV := by
  -- This is the canonical `adjoin_le_iff` interface step for the source proof.
  rw [Algebra.adjoin_le_iff]
  intro z hz
  rcases hz with ⟨x, hx, rfl⟩
  exact hquot x (by simpa using hx)

/-- Helper for Lemma 10.119.1: every chosen generator becomes a multiple of the distinguished
generator inside the quotient-adjoin subalgebra. -/
lemma generator_mem_span_singleton_adjoin
    (s : Finset R) (xr : R)
    {x : R} (hx : x ∈ s) (hxr0 : xr ≠ 0)
    (S : Subalgebra R K)
    (hS : S = Algebra.adjoin R ((fun y : R ↦ algebraMap R K y / algebraMap R K xr) '' (↑s : Set R))) :
    algebraMap R S x ∈ Ideal.span ({algebraMap R S xr} : Set S) := by
  have hxrK : algebraMap R K xr ≠ 0 :=
    (map_ne_zero_iff (algebraMap R K) (IsFractionRing.injective R K)).2 hxr0
  -- Rewrite `x` as the distinguished generator times the corresponding adjoined quotient.
  rw [hS]
  refine Ideal.mem_span_singleton.mpr ?_
  refine ⟨⟨algebraMap R K x / algebraMap R K xr, Algebra.subset_adjoin ?_⟩, ?_⟩
  · exact ⟨x, by simpa using hx, rfl⟩
  · ext
    change algebraMap R K x = algebraMap R K xr * (algebraMap R K x / algebraMap R K xr)
    field_simp [hxrK]

/-- Helper for Lemma 10.119.1: if generators of the maximal ideal all become multiples of one
element, then any prime containing that distinguished element contracts to the maximal ideal. -/
lemma maximalIdeal_le_comap_of_generators_in_span_singleton
    {S : Type*} [CommRing S] [Algebra R S]
    (s : Finset R) (hs : Ideal.span (↑s : Set R) = IsLocalRing.maximalIdeal R)
    {xr : R}
    (hspan : ∀ x ∈ s, algebraMap R S x ∈ Ideal.span ({algebraMap R S xr} : Set S))
    (q : Ideal S) [q.IsPrime] (hqxr : algebraMap R S xr ∈ q) :
    Ideal.comap (algebraMap R S) q = IsLocalRing.maximalIdeal R := by
  have hle : Ideal.span (↑s : Set R) ≤ Ideal.comap (algebraMap R S) q := by
    -- Each generator lands in the prime because it is a multiple of the distinguished element.
    refine Ideal.span_le.mpr ?_
    intro x hx
    have hxq : algebraMap R S x ∈ q := by
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (hspan x (by simpa using hx))
      rw [hc]
      exact q.mul_mem_right _ hqxr
    simpa [Ideal.mem_comap] using hxq
  have hge : IsLocalRing.maximalIdeal R ≤ Ideal.comap (algebraMap R S) q := by
    simpa [hs] using hle
  have hq_ne_top : q ≠ ⊤ := Ideal.IsPrime.ne_top (I := q) inferInstance
  -- In a local ring, every proper ideal is contained in the maximal ideal.
  exact le_antisymm (IsLocalRing.le_maximalIdeal (Ideal.comap_ne_top _ hq_ne_top)) hge

/-- Helper for Lemma 10.119.1: if a valuation subring dominates the image of `R` in `K`, then
the induced map from `R` to the corresponding valuation-subring subalgebra is local. -/
lemma isLocalHom_algebraMap_valuationSubringSubalgebra_of_dominates
    {V : ValuationSubring K}
    (hRV : LocalSubring.range (algebraMap R K) ≤ V.toLocalSubring) :
    IsLocalHom (algebraMap R (valuationSubringSubalgebra (R := R) (K := K) V hRV)) := by
  -- Factor `R → V` through the local image of `R` in `K` and compose the two local maps.
  have hcomp :
      IsLocalHom
        ((Subring.inclusion hRV.1).comp ((algebraMap R K).rangeRestrict)) := by
    exact @RingHom.isLocalHom_comp _ _ _ _ _ _ _ _
      hRV.2 (.of_surjective _ (algebraMap R K).rangeRestrict_surjective)
  simpa [valuationSubringSubalgebra] using hcomp

/-- Helper for Lemma 10.119.1: an element of the maximal ideal of `R` stays a nonunit in any
subalgebra contained in the dominating valuation subring subalgebra. -/
lemma not_isUnit_algebraMap_of_mem_maximalIdeal_of_le_valuationSubringSubalgebra
    {V : ValuationSubring K}
    (hRV : LocalSubring.range (algebraMap R K) ≤ V.toLocalSubring)
    (S : Subalgebra R K)
    (hSV : S ≤ valuationSubringSubalgebra (R := R) (K := K) V hRV)
    {x : R} (hx : x ∈ IsLocalRing.maximalIdeal R) :
    ¬ IsUnit (algebraMap R S x) := by
  -- First move `x` into the maximal ideal of the dominating valuation subalgebra.
  letI :
      IsLocalHom (algebraMap R (valuationSubringSubalgebra (R := R) (K := K) V hRV)) :=
    isLocalHom_algebraMap_valuationSubringSubalgebra_of_dominates (R := R) (K := K) hRV
  have hxV :
      ¬ IsUnit (algebraMap R (valuationSubringSubalgebra (R := R) (K := K) V hRV) x) := by
    intro hxunit
    exact hx (isUnit_of_map_unit
      (algebraMap R (valuationSubringSubalgebra (R := R) (K := K) V hRV)) x hxunit)
  -- A unit in `S` would remain a unit after inclusion into the valuation subalgebra.
  intro hxS
  exact hxV (by simpa using hxS.map (Subalgebra.inclusion hSV))

/-- Helper for Lemma 10.119.1: if a prime of the quotient-adjoin subalgebra contracts to the
maximal ideal of `R`, then the induced map to the corresponding localization subalgebra is local. -/
lemma localization_subalgebra_algebraMap_isLocalHom_of_comap_maximalIdeal
    {S : Type*} [CommRing S] [IsDomain S] [Algebra R S] [Algebra S K] [IsScalarTower R S K]
    [IsFractionRing S K]
    (q : PrimeSpectrum S)
    (hcomap : Ideal.comap (algebraMap R S) q.asIdeal = IsLocalRing.maximalIdeal R) :
    IsLocalHom
      (algebraMap R
        ((Localization.subalgebra.ofField K q.asIdeal.primeCompl
          q.asIdeal.primeCompl_le_nonZeroDivisors).restrictScalars R)) := by
  let A0 : Subalgebra S K :=
    Localization.subalgebra.ofField K q.asIdeal.primeCompl
      q.asIdeal.primeCompl_le_nonZeroDivisors
  have hlocal_atPrime :
      IsLocalHom (algebraMap R (Localization.AtPrime q.asIdeal)) := by
    -- The pullback criterion for local maps applies once the maximal ideal is identified.
    have hmax :
        Ideal.comap (algebraMap R (Localization.AtPrime q.asIdeal))
          (IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal)) =
        IsLocalRing.maximalIdeal R := by
      change
        Ideal.comap
            ((algebraMap S (Localization.AtPrime q.asIdeal)).comp (algebraMap R S))
            (IsLocalRing.maximalIdeal (Localization.AtPrime q.asIdeal)) =
          IsLocalRing.maximalIdeal R
      rw [← Ideal.comap_comap (algebraMap R S) (algebraMap S (Localization.AtPrime q.asIdeal))]
      simpa [Localization.AtPrime.comap_maximalIdeal] using hcomap
    exact ((IsLocalRing.local_hom_TFAE
      (algebraMap R (Localization.AtPrime q.asIdeal))).out 4 0).mp hmax
  let e : Localization.AtPrime q.asIdeal ≃ₐ[S] A0 :=
    IsLocalization.algEquiv q.asIdeal.primeCompl (Localization.AtPrime q.asIdeal) A0
  letI : IsLocalHom (e : Localization.AtPrime q.asIdeal →+* A0) :=
    IsLocalHom.of_surjective (e : Localization.AtPrime q.asIdeal →+* A0) e.surjective
  have hcomp :
      IsLocalHom
        (((e : Localization.AtPrime q.asIdeal →+* A0).comp
          (algebraMap R (Localization.AtPrime q.asIdeal)))) := by
    infer_instance
  have hEq :
      (((e : Localization.AtPrime q.asIdeal →+* A0).comp
        (algebraMap R (Localization.AtPrime q.asIdeal))) :
          R →+* A0) =
        algebraMap R (A0.restrictScalars R) := by
    ext x
    rw [show algebraMap R (Localization.AtPrime q.asIdeal) =
        (algebraMap S (Localization.AtPrime q.asIdeal)).comp (algebraMap R S) by
          ext y
          rfl]
    rw [show algebraMap R (A0.restrictScalars R) =
        (algebraMap S A0).comp (algebraMap R S) by
          ext y
          change algebraMap R K y = algebraMap S K ((algebraMap R S) y)
          rw [show algebraMap R K = (algebraMap S K).comp (algebraMap R S) by
            simpa using (IsScalarTower.algebraMap_eq R S K)]
          rfl]
    simp only [RingHom.comp_apply]
    simpa using e.commutes ((algebraMap R S) x)
  -- Transport the local map along the canonical localization equivalence.
  exact hEq ▸ hcomp

/-- Lemma 10.119.1: if `R` is a local Noetherian domain with fraction field `K` and `R` is not a
field, then there exists an intermediate `R`-subalgebra `A ⊆ K` such that `A` is local, has
Krull dimension `1`, the map `R → A` is local, and `A` is essentially of finite type over `R`.
Since `R` is Noetherian, the last condition canonically implies that `A` is Noetherian as well. -/
theorem exists_one_dimensional_dominating_essFiniteType_overring_of_not_isField
    (hR : ¬ IsField R) :
    ∃ A : Subalgebra R K,
      ringKrullDim A = 1 ∧
        IsLocalRing A ∧
        IsLocalHom (algebraMap R A) ∧
        Algebra.EssFiniteType R A := by
  -- Choose a dominating valuation overring of the image of `R` in `K`.
  let R₀ : LocalSubring K := LocalSubring.range (algebraMap R K)
  obtain ⟨V, hV⟩ := LocalSubring.exists_le_valuationSubring R₀
  -- Route correction: the previous attempt stopped before making the finite valuation-ring choice
  -- explicit. We now build that denominator chooser and the contraction package first.
  obtain ⟨sSet, hsSetFinite, hsSetSpan⟩ :=
    Submodule.fg_def.mp (Ideal.fg_of_isNoetherianRing (IsLocalRing.maximalIdeal R))
  classical
  let s : Finset R := hsSetFinite.toFinset
  have hs : Ideal.span (↑s : Set R) = IsLocalRing.maximalIdeal R := by
    simpa [s] using hsSetSpan
  -- Choose the generator of minimal valuation in the finite generating set.
  obtain ⟨xr, hxr_mem, hxr0, hquot⟩ :=
    exists_nonzero_generator_with_quotients_mem_valuationSubring
      (R := R) (K := K) hR hV s hs
  let S : Subalgebra R K :=
    Algebra.adjoin R ((fun x : R ↦ algebraMap R K x / algebraMap R K xr) '' (↑s : Set R))
  have hSV : S ≤ valuationSubringSubalgebra (R := R) (K := K) V hV := by
    -- All adjoined quotients already lie in the dominating valuation ring.
    exact adjoin_quotients_le_valuationSubring (R := R) (K := K) hV s xr hquot
  have hgenerators :
      ∀ x ∈ s, algebraMap R S x ∈ Ideal.span ({algebraMap R S xr} : Set S) := by
    -- This is the principal-ideal reformulation of `mS = (xr)`.
    intro x hx
    exact generator_mem_span_singleton_adjoin (R := R) (K := K) s xr hx hxr0 S rfl
  have hxr_mem_maximal : xr ∈ IsLocalRing.maximalIdeal R := by
    have hxspan : xr ∈ Ideal.span (↑s : Set R) := Ideal.subset_span (by simpa using hxr_mem)
    simpa [hs] using hxspan
  have hxr_nonunit : ¬ IsUnit (algebraMap R S xr) := by
    -- The distinguished generator stays inside the maximal ideal of the dominating valuation ring.
    exact
      not_isUnit_algebraMap_of_mem_maximalIdeal_of_le_valuationSubringSubalgebra
        (R := R) (K := K) hV S hSV hxr_mem_maximal
  have hspan_ne_top : Ideal.span ({algebraMap R S xr} : Set S) ≠ ⊤ :=
    Ideal.span_singleton_ne_top hxr_nonunit
  obtain ⟨qIdeal, hqIdeal⟩ := Ideal.nonempty_minimalPrimes hspan_ne_top
  let q : PrimeSpectrum S := ⟨qIdeal, Ideal.minimalPrimes_isPrime hqIdeal⟩
  letI : q.asIdeal.IsPrime := q.isPrime
  have hq :
      q.asIdeal ∈ (Ideal.span ({algebraMap R S xr} : Set S)).minimalPrimes := by
    simpa [q] using hqIdeal
  have hqxr : algebraMap R S xr ∈ q.asIdeal := by
    exact hq.1.2 (Ideal.mem_span_singleton_self _)
  have hcomapS : Ideal.comap (algebraMap R S) q.asIdeal = IsLocalRing.maximalIdeal R := by
    -- The source generators all lie in the principal ideal `(xr)` inside `S`.
    exact
      maximalIdeal_le_comap_of_generators_in_span_singleton
        (R := R) s hs hgenerators q.asIdeal hqxr
  have hfiniteS : Algebra.FiniteType R S := by
    let t : Finset K := s.image fun x : R => algebraMap R K x / algebraMap R K xr
    have hS_eq : S = Algebra.adjoin R (↑t : Set K) := by
      ext z
      simp [S, t]
    rw [hS_eq, ← Subalgebra.fg_iff_finiteType]
    simpa [t] using (Subalgebra.fg_adjoin_finset (R := R) t)
  let A0 : Subalgebra S K :=
    Localization.subalgebra.ofField K q.asIdeal.primeCompl
      q.asIdeal.primeCompl_le_nonZeroDivisors
  let A : Subalgebra R K := A0.restrictScalars R
  have hxrS0 : algebraMap R S xr ≠ 0 := by
    -- The chosen generator was nonzero already in `R`, and `S` still sits inside the field `K`.
    intro hx0
    have hx0K : algebraMap R K xr = 0 := by
      simpa using congrArg Subtype.val hx0
    apply hxr0
    exact (IsFractionRing.injective R K) (by simpa using hx0K)
  have hdim : ringKrullDim A = 1 := by
    -- Krull's principal ideal theorem on the chosen minimal prime gives the dimension computation.
    letI : Algebra.FiniteType R S := hfiniteS
    letI : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing R S
    change ringKrullDim A0 = 1
    calc
      ringKrullDim A0 = q.asIdeal.primeHeight := by
        simpa [A0] using
          (ringKrullDim_localization_subalgebra_eq_primeHeight (K := K) (S := S) q)
      _ = 1 :=
        by
          simpa using
            (primeHeight_eq_one_of_mem_minimalPrimes_span_singleton_of_nonzero
              hxrS0 q.asIdeal hq)
  have hlocalA : IsLocalRing A := by
    -- The localization at a prime is local, and `restrictScalars` does not change the ring.
    let e : Localization.AtPrime q.asIdeal ≃ₐ[S] A0 :=
      IsLocalization.algEquiv q.asIdeal.primeCompl (Localization.AtPrime q.asIdeal) A0
    letI : IsLocalRing A0 := RingEquiv.isLocalRing e.toRingEquiv
    change IsLocalRing A0
    infer_instance
  have hmapLocal : IsLocalHom (algebraMap R A) := by
    -- The contraction computation identifies the pullback of the maximal ideal after localization.
    change IsLocalHom (algebraMap R (A0.restrictScalars R))
    simpa [A0] using
      localization_subalgebra_algebraMap_isLocalHom_of_comap_maximalIdeal
        (R := R) (K := K) (S := S) q hcomapS
  have hessA : Algebra.EssFiniteType R A := by
    -- Compose finite type for `S` with essential finite type for the prime localization.
    letI : Algebra.FiniteType R S := hfiniteS
    change Algebra.EssFiniteType R A0
    letI : Algebra.EssFiniteType S A0 := Algebra.EssFiniteType.of_isLocalization A0 q.asIdeal.primeCompl
    exact Algebra.EssFiniteType.comp R S A0
  exact ⟨A, hdim, hlocalA, hmapLocal, hessA⟩

end
