import Mathlib
import StacksProject_2024.Chap16.Theorem_16_13_2

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Algebra IsLocalRing IsScalarTower
open MvPolynomial

section

variable {R : Type u} [CommRing R] [HenselianLocalRing R] [IsNoetherianRing R]

local notation "Rhat" => AdicCompletion (maximalIdeal R) R

-- Proof sketch: interpret the G-ring hypothesis as geometric regularity of the formal fibers of
-- `R → Rhat`. By Popescu's theorem, factor the finite `R`-subalgebra of `Rhat` generated by the
-- given formal solution through a smooth `R`-algebra. Then use the henselian local lifting lemma
-- for étale neighborhoods to descend the induced point of that smooth algebra to an `R`-point, and
-- finally apply the standard Artin-approximation reduction modulo `(maximalIdeal R)^N`.
/-- Theorem 16.13.1: if `R` is a Noetherian henselian local ring whose completion map
`R → AdicCompletion (maximalIdeal R) R` has geometrically regular formal fibers, then every
solution in the maximal-ideal adic completion of a finite system of polynomial equations over `R`
is congruent modulo `(maximalIdeal R)^N` to a solution in `R`. -/
theorem exists_solution_in_ring_of_adicCompletion_solution
    (hRhat : (algebraMap R Rhat).IsRegularRingMap)
    {m n : ℕ} (f : Fin m → MvPolynomial (Fin n) R) (a : Fin n → Rhat)
    (ha : ∀ j, aeval a (f j) = 0) (N : ℕ) :
    ∃ b : Fin n → R,
      (∀ j, eval b (f j) = 0) ∧
        ∀ i, a i - algebraMap R Rhat (b i) ∈
          Ideal.map (algebraMap R Rhat) ((maximalIdeal R) ^ N) := sorry

end
