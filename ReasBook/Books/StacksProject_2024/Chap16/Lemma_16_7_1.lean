import Mathlib
import StacksProject_2024.Chap16.Definition_16_2_1
import StacksProject_2024.Chap16.Definition_16_2_3

-- Declarations for this item will be appended below by the statement pipeline.

universe u v w

namespace Algebra

open scoped SingularIdealNotation

section

variable {R : Type u} {A : Type v} {Λ : Type w}
variable [CommRing R] [CommRing A] [CommRing Λ]
variable [Algebra R A] [Algebra R Λ]

variable (π : R)

local notation "I4" => Ideal.span ({π ^ 4} : Set R)
local notation "A4" => A ⧸ Ideal.map (algebraMap R A) I4
local notation "R4" => R ⧸ I4
local notation "Λ4" => Λ ⧸ Ideal.map (algebraMap R Λ) I4
local notation "AnnR[" x "]" => Ideal.torsionOf R R x
local notation "AnnΛ[" x "]" => Ideal.torsionOf Λ Λ x

/-
Domain-style sampling for Lemma 16.7.1:
- primary domain: commutative algebra of finite-presentation `R`-algebras, quotient algebra maps,
  strict-standard elements, and the singular ideal `H[B⁄R]`;
- sampled owner declarations:
  `Ideal.torsionOf`,
  `Module.annihilator`,
  `Algebra.IsStrictlyStandard`,
  `Algebra.singularIdeal`,
  `Ideal.quotientMapₐ`,
  `Ideal.Quotient.mkₐ`,
  `Ideal.Quotient.algebraQuotientOfLEComap`;
- best owner abstraction: the source-facing theorem stays an existence statement, with
  the quotient-element annihilators expressed through `Ideal.torsionOf`, the outer quotient-module
  annihilator expressed through `Module.annihilator`, and the mod-`π⁴` comparison map used
  through the named bridge `piPowFourQuotientMap π f`, built from the canonical quotient-map owner
  `Ideal.quotientMapₐ`;
- primitive data: `f : A →ₐ[R] Λ`, the strict-standardness witness for `π`, the annihilator
  equality in `Λ`, and a compatible `R4`-algebra section `A4 →ₐ[R4] R4`;
- derived API: the compatibility equation between the section and the canonical quotient map to
  `Λ4`.

Source/core/bridge triage:
- `source-facing`: the factorization theorem below, with the source ideal written directly as
  `Ann_R(Ann_R(π²) / Ann_R(π))`;
- `core/canonical`: `Ideal.torsionOf`, `Module.annihilator`, `IsStrictlyStandard`, `H[B⁄R]`, and
  `Ideal.quotientMapₐ`;
- `bridge/view`: `piPowFourQuotientMap π f` and the section-compatibility equation.
-/

/-- The ideal generated by `π⁴` maps into the corresponding quotient ideal along any `R`-algebra
map. -/
private theorem map_piPowFour_le_comap_map_piPowFour
    {S : Type*} {T : Type*} [CommRing S] [CommRing T] [Algebra R S] [Algebra R T]
    (f : S →ₐ[R] T) :
    Ideal.map (algebraMap R S) I4 ≤
      Ideal.comap f (Ideal.map (algebraMap R T) I4) := by
  simpa [Ideal.map_map] using
    (show Ideal.map (algebraMap R S) I4 ≤
        Ideal.comap (f : S →+* T) (Ideal.map (f : S →+* T) (Ideal.map (algebraMap R S) I4)) from
      Ideal.le_comap_map)

/-- The reduction modulo `π⁴` induced by an `R`-algebra map. -/
def piPowFourQuotientMap
    (f : A →ₐ[R] Λ) :
    A4 →ₐ[R4] Λ4 :=
  { toRingHom := Ideal.quotientMap _ f.toRingHom (map_piPowFour_le_comap_map_piPowFour π f)
    commutes' := by
      intro r
      refine Quotient.inductionOn' r ?_
      intro r
      change Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I4) (f (algebraMap R A r)) =
        Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) I4) (algebraMap R Λ r)
      rw [f.commutes] }

-- Proof sketch: the proof follows the Stacks construction of the auxiliary finitely presented
-- algebra `B` obtained by adjoining variables to a finite presentation of `A` coming from the
-- strict-standard witness for `π` and using the section modulo `π⁴` to normalize the presentation.
-- The annihilator hypothesis on `Λ` kills the extra relations after mapping to `Λ`, while the
-- strict standardness of `π` and Elkik's Jacobian criterion imply that the image of `𝔞` in `B` is
-- contained in the singular ideal `H_{B/R}`.
/-- Lemma 16.7.1: let `R` be Noetherian, let `Λ` be an `R`-algebra, let `π ∈ R`, and let
`A → Λ` be an `R`-algebra map. Assume the image of `π` is strictly standard in `A` over `R`
(hence witnessed by a finite presentation of `A`), assume `Ann_Λ(π) = Ann_Λ(π²)`, and assume there
is a section `A / π⁴A → R / π⁴R` compatible with the map to `Λ / π⁴Λ`. Then there is a
factorization `A → B → Λ` through a finitely presented `R`-algebra `B` such that the image of
`𝔞 = Ann_R(Ann_R(π²) / Ann_R(π))` in `B` is contained in the singular ideal `H_{B/R}`. -/
theorem exists_factorization_with_quotient_annihilator_map_le_singularIdeal
    [IsNoetherianRing R]
    (f : A →ₐ[R] Λ)
    (hπ : IsStrictlyStandard R (algebraMap R A π))
    (hAnnΛ : AnnΛ[algebraMap R Λ π] = AnnΛ[algebraMap R Λ (π ^ 2)])
    (hρ : ∃ ρ : A4 →ₐ[R4] R4,
      (Algebra.ofId R4 Λ4).comp ρ = piPowFourQuotientMap π f) :
    ∃ (B : Type (max u v w)) (_ : CommRing B) (_ : Algebra R B) (_ : FinitePresentation R B)
      (fA : A →ₐ[R] B) (g : B →ₐ[R] Λ),
      g.comp fA = f ∧
        Ideal.map (algebraMap R B)
            (Module.annihilator R
              (AnnR[π ^ 2] ⧸ Submodule.comap (AnnR[π ^ 2]).subtype AnnR[π])) ≤
          H[B⁄R] :=
  sorry

end

end Algebra
