open CategoryTheory

universe v u v' u'

namespace CategoryTheory.SimplicialObject

section

variable {C : Type u} [Category.{v} C]
variable {U V : SimplicialObject C} {a b : U ⟶ V}

/- Domain-style sampling for Remark 14.26.4:
- primary domain: functoriality of simplicial homotopies and of the zigzag relation they generate;
- sampled same-kind declarations:
  `CategoryTheory.SimplicialObject.Homotopy.whiskerRight`,
  `CategoryTheory.SimplicialObject.Homotopic.precomp`,
  `CategoryTheory.CosimplicialObject.DeltaOneHomotopic.whiskerRight`;
- best owner abstraction: the source-facing owner is `CategoryTheory.SimplicialObject.Homotopic`,
  with `Homotopy` as the primitive directed data;
- primitive data: a directed simplicial homotopy `H : Homotopy a b`;
- derived API: whiskering directed homotopies by a functor and lifting that operation to the
  equivalence closure defining `Homotopic`.

Source/core/bridge triage:
- `source-facing`: the preservation of zigzag simplicial homotopy under a functor;
- `core/canonical`: `Homotopic` as the owner relation generated from `Homotopy`;
- `bridge/view`: `Homotopy.whiskerRight` on directed homotopies, which induces the owner theorem
  below.
-/

/- Remark 14.26.4: any functor sends a simplicial homotopy `H : Homotopy a b` to the induced
simplicial homotopy between the whiskered morphisms of simplicial objects. Consequently the finite
zigzag relation generated by directed simplicial homotopies is preserved by functors; in the
presence of finite coproducts this also preserves the older coproduct-based notion of homotopy. -/
recall Homotopy.whiskerRight
    (H : Homotopy a b) {D : Type u'} [Category.{v'} D] (F : C ⥤ D) :
  Homotopy (Functor.whiskerRight a F) (Functor.whiskerRight b F)

/- Functors preserve the zigzag relation generated by directed simplicial homotopies. -/
recall Homotopic.whiskerRight
    {D : Type u'} [Category.{v'} D] (h : Homotopic a b) (F : C ⥤ D) :
  Homotopic (Functor.whiskerRight a F) (Functor.whiskerRight b F)

end

end CategoryTheory.SimplicialObject
