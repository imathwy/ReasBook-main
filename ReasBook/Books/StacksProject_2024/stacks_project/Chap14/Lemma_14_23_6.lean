      (degenerateSubobject U n).arrow ≫ (PInfty : K[U] ⟶ K[U]).f n +
        (degenerateSubobject U n).arrow ≫ (QInfty : K[U] ⟶ K[U]).f n := by
  -- This is the additive expansion needed when comparing the two projectors on the degenerate owner.
  exact
    (Preadditive.comp_add
      (degenerateSubobject U n : C) (U _⦋n⦌) (U _⦋n⦌)
      (degenerateSubobject U n).arrow
      ((PInfty : K[U] ⟶ K[U]).f n)
      ((QInfty : K[U] ⟶ K[U]).f n))

