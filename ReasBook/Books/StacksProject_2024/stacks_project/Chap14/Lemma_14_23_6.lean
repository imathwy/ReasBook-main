/-- Helper for Lemma 14.23.6: each individual degeneracy image is contained in the canonical
degreewise degenerate subobject. -/
private theorem degeneracy_image_le_degenerateSubobject
    (U : SimplicialObject C) (n : ℕ) (i : Fin (n + 1)) :
    imageSubobject (U.σ i) ≤ degenerateSubobject U (n + 1) := by
  -- The owner `degenerateSubobject U (n + 1)` is defined as the finite supremum of these images.
  change imageSubobject (U.σ i) ≤
      Finset.univ.sup (fun j : Fin (n + 1) ↦ imageSubobject (U.σ j))
  exact Finset.le_sup (s := Finset.univ)
    (f := fun j : Fin (n + 1) ↦ imageSubobject (U.σ j))
    (by simpa using (Finset.mem_univ i))

/-- Helper for Lemma 14.23.6: each summand in the source decomposition of `Q∞` lands in the
corresponding degeneracy image, hence in the degreewise degenerate owner. -/
private theorem decomposition_Q_summand_factors
    (U : SimplicialObject C) (n : ℕ) (i : Fin (n + 1)) :
    (degenerateSubobject U (n + 1)).Factors
      ((P i).f (n + 1) ≫ U.δ i.rev.succ ≫ U.σ (Fin.rev i)) := by
  -- First factor through the image of the last degeneracy, then compare that image with the sup.
  refine Subobject.factors_of_le _ (degeneracy_image_le_degenerateSubobject U n (Fin.rev i)) ?_
  simpa [Category.assoc] using imageSubobject_factors_comp_self (f := U.σ (Fin.rev i))
    ((P i).f (n + 1) ≫ U.δ i.rev.succ)

