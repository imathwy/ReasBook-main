`K(U)` compose to the identity on `K(U)`. -/
private theorem decomposition_hom_inv_id (U : SimplicialObject A) :
    biprod.lift (PInftyToNormalizedMooreComplex U) (QInftyToDegenerateComplex U) ≫
      biprod.desc (inclusionOfMooreComplexMap U) (degenerateComplexι U) = 𝟙 K[U] := by
