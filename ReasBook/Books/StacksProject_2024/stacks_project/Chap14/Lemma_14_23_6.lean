/-- Helper for Lemma 14.23.6: the degreewise degenerate owner is contained in the image of `Q∞`.
-/
private theorem degenerateSubobject_le_image_QInfty
    (U : SimplicialObject C) (n : ℕ) :
    degenerateSubobject U n ≤ imageSubobject ((QInfty : K[U] ⟶ K[U]).f n) := by
  cases n with
  | zero =>
      -- In degree `0`, the degenerate owner is bottom.
      simp [degenerateSubobject]
  | succ n =>
      -- In positive degree, the degenerate owner is the finite sup of the degeneracy images.
      change Finset.univ.sup (fun i : Fin (n + 1) ↦ imageSubobject (U.σ i)) ≤
        imageSubobject ((QInfty : K[U] ⟶ K[U]).f (n + 1))
      refine Finset.sup_le ?_
      intro i hi
      exact degeneracy_image_le_image_QInfty U n i

