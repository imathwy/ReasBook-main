/-- Definition 14.26.1: two morphisms `a, b : U ⟶ V` are homotopic if they are connected by a
finite zigzag of directed simplicial homotopies in either direction, where a directed homotopy
from `a` to `b` is the canonical simplicial-object homotopy `CategoryTheory.SimplicialObject.Homotopy a b`. -/
def Homotopic (a b : U ⟶ V) : Prop :=
  Relation.EqvGen DirectedHomotopy a b

@[refl] lemma Homotopic.refl (a : U ⟶ V) : Homotopic a a :=
  Relation.EqvGen.refl a

@[symm] lemma Homotopic.symm (h : Homotopic a b) : Homotopic b a := by
  simpa [Homotopic] using Relation.EqvGen.symm a b h

@[trans] lemma Homotopic.trans (hab : Homotopic a b) (hbc : Homotopic b c) : Homotopic a c := by
  simpa [Homotopic] using Relation.EqvGen.trans a b c hab hbc

-- Proof sketch: a directed simplicial homotopy is one generating relation for the equivalence
-- closure defining `Homotopic`, so apply the canonical constructor `Relation.EqvGen.rel`.
/-- A directed simplicial homotopy gives the associated zigzag homotopy relation. -/
lemma Homotopic.of_homotopy (h : Homotopy a b) : Homotopic a b :=
  Relation.EqvGen.rel a b ⟨h⟩

/-- Any map on morphisms that sends directed simplicial homotopies to zigzag homotopies also
preserves the induced zigzag homotopy relation. -/
theorem Homotopic.map
    {D : Type u'} [Category.{v'} D]
    {U' V' : SimplicialObject D}
    (F : (U ⟶ V) → (U' ⟶ V'))
    (hF : ∀ {x y : U ⟶ V}, Homotopy x y → Homotopic (F x) (F y))
    (h : Homotopic a b) :
    Homotopic (F a) (F b) := by
  induction h with
  | rel x y hxy =>
      exact hF hxy.some
  | refl x =>
      exact Homotopic.refl (F x)
  | symm x y _ ih =>
      exact ih.symm
  | trans x y z _ _ ihxy ihyz =>
      exact ihxy.trans ihyz

/-- Precomposing preserves the zigzag simplicial homotopy relation. -/
lemma Homotopic.precomp (h : Homotopic a b) (p : T ⟶ U) : Homotopic (p ≫ a) (p ≫ b) := by
  let F : (U ⟶ V) → (T ⟶ V) := fun f ↦ p ≫ f
  simpa [F] using Homotopic.map F (fun hfg ↦ .of_homotopy (hfg.precomp p)) h

/-- Postcomposing preserves the zigzag simplicial homotopy relation. -/
lemma Homotopic.postcomp (h : Homotopic a b) (p : V ⟶ W) : Homotopic (a ≫ p) (b ≫ p) := by
  let F : (U ⟶ V) → (U ⟶ W) := fun f ↦ f ≫ p
  simpa [F] using Homotopic.map F (fun hfg ↦ .of_homotopy (hfg.postcomp p)) h

/-- Functors preserve the zigzag relation generated by directed simplicial homotopies. -/
theorem Homotopic.whiskerRight
    {D : Type*} [Category D]
    (h : Homotopic a b) (F : C ⥤ D) :
    Homotopic (Functor.whiskerRight a F) (Functor.whiskerRight b F) := by
  let G :
      (U ⟶ V) →
        (((SimplicialObject.whiskering C D).obj F).obj U ⟶
          ((SimplicialObject.whiskering C D).obj F).obj V) :=
    fun f ↦ Functor.whiskerRight f F
  simpa [G] using Homotopic.map G (fun hfg ↦ .of_homotopy (hfg.whiskerRight F)) h

end

end CategoryTheory.SimplicialObject
