  · exact (ModuleCat.mono_iff_injective _).2 (Submodule.torsionBy R M f).injective_subtype
  · exact (ModuleCat.epi_iff_surjective _).2 (Submodule.mkQ_surjective _)

/-- Helper for Lemma 15.8.10: after inverting `g`, every `g`-torsion element vanishes, so the
localized `g`-torsion submodule is zero. -/
lemma localized_torsionBy_eq_bot_away
    {A : Type*} [CommRing A]
    {N : Type*} [AddCommGroup N] [Module A N] (g : A) :
    (Submodule.torsionBy A N g).localized (p := Submonoid.powers g) = ⊥ := by
  -- A localized torsion element is still killed by `g`, but `g` is a unit away from itself.
  rw [Submodule.eq_bot_iff]
  intro x hx
  rw [Submodule.mem_localized'] at hx
  rcases hx with ⟨m, hm, s, rfl⟩
  rw [Submodule.mem_torsionBy_iff] at hm
  have hsmul :
      (algebraMap A (Localization.Away g) g) •
          IsLocalizedModule.mk'
            (LocalizedModule.mkLinearMap (Submonoid.powers g) N) m s = 0 := by
    -- Rewrite the torsion relation inside the away localization.
    simpa [IsLocalizedModule.mk'_smul] using congrArg
      (fun y : N ↦
        IsLocalizedModule.mk'
          (LocalizedModule.mkLinearMap (Submonoid.powers g) N) y s)
      hm
  have hunit : IsUnit (algebraMap A (Localization.Away g) g) := by
    -- The distinguished element becomes invertible in the away localization.
    exact IsLocalization.map_units (Localization.Away g)
      ⟨g, show g ∈ Submonoid.powers g by exact ⟨1, by simp⟩⟩
  rcases hunit with ⟨u, hu⟩
  calc
    IsLocalizedModule.mk'
        (LocalizedModule.mkLinearMap (Submonoid.powers g) N) m s =
        (↑u⁻¹ : Localization.Away g) •
          ((algebraMap A (Localization.Away g) g) •
            IsLocalizedModule.mk'
              (LocalizedModule.mkLinearMap (Submonoid.powers g) N) m s) := by
          calc
            IsLocalizedModule.mk'
                (LocalizedModule.mkLinearMap (Submonoid.powers g) N) m s =
                (1 : Localization.Away g) •
                  IsLocalizedModule.mk'
                    (LocalizedModule.mkLinearMap (Submonoid.powers g) N) m s := by
                      simp
            _ = (((↑u⁻¹ : Localization.Away g) * ↑u) :
                  Localization.Away g) •
                  IsLocalizedModule.mk'
                    (LocalizedModule.mkLinearMap (Submonoid.powers g) N) m s := by
                      rw [Units.inv_mul]
            _ = (↑u⁻¹ : Localization.Away g) •
                  (↑u •
                    IsLocalizedModule.mk'
                      (LocalizedModule.mkLinearMap (Submonoid.powers g) N) m s) := by
                      simp [Units.smul_def, smul_smul]
            _ = (↑u⁻¹ : Localization.Away g) •
                  ((algebraMap A (Localization.Away g) g) •
                    IsLocalizedModule.mk'
                      (LocalizedModule.mkLinearMap (Submonoid.powers g) N) m s) := by
                      simp [Units.smul_def, hu]
    _ = 0 := by
          simp [hsmul]

/-- Helper for Lemma 15.8.10: after inverting `g`, quotienting by the `g`-torsion submodule does
not change the localized module. -/
noncomputable def away_localized_quotient_torsionBy_linearEquiv
    {A : Type*} [CommRing A]
    {N : Type*} [AddCommGroup N] [Module A N] (g : A) :
    LocalizedModule.Away g (N ⧸ Submodule.torsionBy A N g) ≃ₗ[Localization.Away g]
      LocalizedModule.Away g N :=
  (localizedQuotientEquiv (Submonoid.powers g) (Submodule.torsionBy A N g)).symm ≪≫ₗ
    (Submodule.localized (p := Submonoid.powers g) (Submodule.torsionBy A N g)).quotEquivOfEqBot
      (localized_torsionBy_eq_bot_away (A := A) (N := N) g)

/-- Helper for Lemma 15.8.10: if `g` is a nonzerodivisor, then a nonzero coefficient remains
nonzero after localizing away from `g`. -/
lemma away_map_nonzero_of_nonZeroDivisor
    {A : Type*} [CommRing A] {g a : A}
    (hg : g ∈ nonZeroDivisors A) (ha : a ≠ 0) :
    algebraMap A (Localization.Away g) a ≠ 0 := by
  -- Proof comment: vanishing in the away localization would force some power of `g` to kill `a`,
  -- which contradicts regularity of every power of `g`.
  intro hzero
  have hpowers :
      Submonoid.powers g ≤ nonZeroDivisors A := by
    intro s hs
    rcases hs with ⟨n, rfl⟩
    exact pow_mem hg n
  exact ha <|
    (IsLocalization.to_map_eq_zero_iff (Localization.Away g) hpowers).mp hzero

/-- Helper for Lemma 15.8.10: over a flat module, a nonzerodivisor has no visible power torsion. -/
lemma torsion'_eq_bot_of_flat_of_nonZeroDivisor
    {A : Type*} [CommRing A]
    {N : Type*} [AddCommGroup N] [Module A N] [Module.Flat A N]
    {g : A} (hg : g ∈ nonZeroDivisors A) :
    Submodule.torsion' A N (Submonoid.powers g) = ⊥ := by
  -- Flatness makes multiplication by a nonzerodivisor injective, hence also every power.
  rw [Submodule.eq_bot_iff]
  intro x hx
  rw [Submodule.mem_torsion'_iff] at hx
  rcases hx with ⟨a, ha⟩
  obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff a.1 g).mp a.2
  have hgRegular : IsSMulRegular N g :=
    Module.Flat.isSMulRegular_of_nonZeroDivisors hg
  have hkill : ∀ n : ℕ, (g ^ n : A) • x = 0 → x = 0 := by
    intro n
    induction n with
    | zero =>
        intro hn
        simpa using hn
    | succ n ih =>
        intro hn
        have hn' : (g ^ n : A) • x = 0 := by
          apply hgRegular
          simpa [pow_succ', smul_smul, mul_comm, mul_left_comm, mul_assoc] using hn
        exact ih hn'
  have hpow : (g ^ n : A) • x = 0 := by
    simpa [hn] using ha
  exact hkill n hpow

