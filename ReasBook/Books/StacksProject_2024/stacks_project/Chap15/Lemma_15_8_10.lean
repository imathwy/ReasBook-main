/-- Helper for Lemma 15.8.10: localizing the free module `A^r` away from `g` identifies it with
coordinatewise values in the away-localized ring, first as an `A`-linear equivalence. -/
noncomputable def away_free_linearEquiv_fin_pi_restrictScalars
    {A : Type*} [CommRing A] (g : A) (r : ℕ) :
    LocalizedModule.Away g (Fin r → A) ≃ₗ[A] (Fin r → Localization.Away g) :=
  IsLocalizedModule.linearEquiv (Submonoid.powers g)
    (LocalizedModule.mkLinearMap (Submonoid.powers g) (Fin r → A))
    (LinearMap.pi fun i : Fin r ↦
      (Algebra.linearMap A (Localization.Away g)).comp (LinearMap.proj i))

/-- Helper for Lemma 15.8.10: the previous away-local free-module comparison is also linear over
`A[g⁻¹]`. -/
noncomputable def away_free_linearEquiv_fin_pi
    {A : Type*} [CommRing A] (g : A) (r : ℕ) :
    LocalizedModule.Away g (Fin r → A) ≃ₗ[Localization.Away g] (Fin r → Localization.Away g) :=
  LinearEquiv.extendScalarsOfIsLocalization (Submonoid.powers g) (Localization.Away g)
    (away_free_linearEquiv_fin_pi_restrictScalars (A := A) g r)

/-- Helper for Lemma 15.8.10: on denominator-`1` generators, the away-local free-module
comparison localizes each coordinate separately. -/
lemma away_free_linearEquiv_fin_pi_apply_mk
    {A : Type*} [CommRing A] (g : A) (r : ℕ) (v : Fin r → A) (i : Fin r) :
    away_free_linearEquiv_fin_pi_restrictScalars (A := A) g r
        ((LocalizedModule.mkLinearMap (Submonoid.powers g) (Fin r → A)) v) i =
      algebraMap A (Localization.Away g) (v i) := by
  -- Evaluate the localization comparison on a source generator and then read off the chosen
  -- coordinate.
  simpa [away_free_linearEquiv_fin_pi_restrictScalars] using
    congrFun
      (IsLocalizedModule.linearEquiv_apply (Submonoid.powers g)
        (LocalizedModule.mkLinearMap (Submonoid.powers g) (Fin r → A))
        (LinearMap.pi fun j : Fin r ↦
          (Algebra.linearMap A (Localization.Away g)).comp (LinearMap.proj j)) v) i

/-- Helper for Lemma 15.8.10: a surjective coordinate map remains surjective after localizing
away from `g` and identifying the localized free source with `(A[g⁻¹])^r`. -/
lemma away_fintypeLinearCombination_surjective_of_surjective
    {A : Type*} [CommRing A]
    {N : Type*} [AddCommGroup N] [Module A N]
    {g : A} {r : ℕ} (v : Fin r → N)
    (hv : Function.Surjective (Fintype.linearCombination A v)) :
    Function.Surjective
      ((LocalizedModule.map (Submonoid.powers g) (Fintype.linearCombination A v)).comp
        (away_free_linearEquiv_fin_pi (A := A) g r).symm.toLinearMap) := by
  -- First localize the surjective map, then rewrite the localized free source in coordinates.
  have hmap :
      Function.Surjective
        (LocalizedModule.map (Submonoid.powers g) (Fintype.linearCombination A v)) := by
    exact LocalizedModule.map_surjective (Submonoid.powers g) (Fintype.linearCombination A v) hv
  intro z
  rcases hmap z with ⟨y, rfl⟩
  refine ⟨away_free_linearEquiv_fin_pi (A := A) g r y, ?_⟩
