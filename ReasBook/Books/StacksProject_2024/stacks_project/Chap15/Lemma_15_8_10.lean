/-- Helper for Lemma 15.8.10: localizing the principal ideal `(f)` at a prime again produces the
principal ideal generated by the image of `f`. -/
lemma localized_principalIdeal_map_at_prime (p : PrimeSpectrum R) :
    Ideal.map (algebraMap R (Localization.AtPrime p.asIdeal)) (principalIdeal f) =
      principalIdeal (algebraMap R (Localization.AtPrime p.asIdeal) f) := by
  -- Localization commutes with the span of a singleton generator.
  simp [principalIdeal, Ideal.map_span, Set.image_singleton]

/-- Helper for Lemma 15.8.10: a nonzerodivisor remains a nonzerodivisor after localizing at a
prime. -/
lemma localized_nonZeroDivisor_at_prime
    (hf : f ∈ nonZeroDivisors R) (p : PrimeSpectrum R) :
    algebraMap R (Localization.AtPrime p.asIdeal) f ∈
      nonZeroDivisors (Localization.AtPrime p.asIdeal) := by
  -- Flatness of localization preserves regularity of multiplication by `f`.
  letI : Module.Flat R (Localization.AtPrime p.asIdeal) :=
    IsLocalization.flat (Localization.AtPrime p.asIdeal) p.asIdeal.primeCompl
  rw [mem_nonZeroDivisors_iff_left]
  intro x hx
  let hRegular : IsSMulRegular (Localization.AtPrime p.asIdeal)
      (algebraMap R (Localization.AtPrime p.asIdeal) f) :=
    (isSMulRegular_algebraMap_iff (Localization.AtPrime p.asIdeal)).2
      (Module.Flat.isSMulRegular_of_nonZeroDivisors hf)
  exact hRegular <| by
    simpa [smul_eq_mul] using hx

