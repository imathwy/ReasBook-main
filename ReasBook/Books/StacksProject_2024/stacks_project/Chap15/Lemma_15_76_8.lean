/-- Termwise localization of a cochain complex of `R`-modules away from `f`. -/
abbrev localizationAwayComplex (f : R) (M : CpxR) :
    CochainComplex (ModuleCat (Localization.Away f)) ℤ :=
  ((ModuleCat.extendScalars (algebraMap R (Localization.Away f))).mapHomologicalComplex
    (up ℤ)).obj M

-- Proof sketch: unfold `localizationAwayComplex`; it is degreewise scalar extension along
-- `R → R_f`.
/-- The localization-away complex is obtained by degreewise extension of scalars to `R_f`. -/
theorem localizationAwayComplex_def (f : R) (M : CpxR) :
    localizationAwayComplex f M =
      ((ModuleCat.extendScalars (algebraMap R (Localization.Away f))).mapHomologicalComplex
        (up ℤ)).obj M :=
  rfl

/-- The elementary two-term contractible complex over `R_f` concentrated in degrees `n` and
`n + 1`. -/
abbrev localizationAwayElementaryTrivialComplex (f : R) (n : ℤ) :
    CochainComplex (ModuleCat (Localization.Away f)) ℤ :=
  CochainComplex.mappingCone
    (𝟙 ((CochainComplex.singleFunctor (ModuleCat (Localization.Away f)) (n + 1)).obj
      (ModuleCat.of (Localization.Away f) (Localization.Away f))))

/-- The object property of the elementary contractible two-term complexes over `R_f`. -/
abbrev localizationAwayElementaryTrivialComplexProperty (f : R) :
    ObjectProperty (CochainComplex (ModuleCat (Localization.Away f)) ℤ) :=
  ObjectProperty.ofObj (localizationAwayElementaryTrivialComplex f)

/-- Termwise localization of a cochain complex of `R`-modules at the prime `p`. -/
abbrev localizationAtPrimeComplex (p : PrimeSpectrum R) (M : CpxR) :
    CochainComplex (ModuleCat (Localization.AtPrime p.asIdeal)) ℤ :=
  ((ModuleCat.extendScalars (algebraMap R (Localization.AtPrime p.asIdeal))).mapHomologicalComplex
    (up ℤ)).obj M

-- Proof comment: unfold `localizationAtPrimeComplex`; it is degreewise extension of scalars along
-- the canonical map `R → R_𝔭`.
/-- The localization-at-prime complex is obtained by degreewise extension of scalars to `R_𝔭`. -/
theorem localizationAtPrimeComplex_def (p : PrimeSpectrum R) (M : CpxR) :
    localizationAtPrimeComplex p M =
      ((ModuleCat.extendScalars (algebraMap R (Localization.AtPrime p.asIdeal)))
        .mapHomologicalComplex (up ℤ)).obj M :=
  rfl

/-- Helper for Lemma 15.76.8: the strict localization-at-prime complex computes exact scalar
extension of the original derived object. -/
noncomputable def q_obj_localizationAtPrimeComplex_mapDerived_iso
    (p : PrimeSpectrum R) (L : CpxR) :
    DerivedCategory.Q.obj (localizationAtPrimeComplex p L) ≅
      (((ModuleCat.extendScalars (algebraMap R (Localization.AtPrime p.asIdeal))).mapDerivedCategory)
        .obj (DerivedCategory.Q.obj L)) := by
  let Rp := Localization.AtPrime p.asIdeal
  -- Proof comment: compare exact scalar extension on strict complexes with the derived
  -- localization functor, then rewrite the strict scalar-extended complex as
  -- `localizationAtPrimeComplex p L`.
  simpa [localizationAtPrimeComplex, Rp] using
    ((ModuleCat.extendScalars (algebraMap R Rp)).mapDerivedCategoryFactors.app L).symm

/-- The elementary two-term contractible complex over `R_𝔭` concentrated in degrees `n` and
`n + 1`. -/
abbrev localizationAtPrimeElementaryTrivialComplex (p : PrimeSpectrum R) (n : ℤ) :
    CochainComplex (ModuleCat (Localization.AtPrime p.asIdeal)) ℤ :=
  CochainComplex.mappingCone
    (𝟙 ((CochainComplex.singleFunctor (ModuleCat (Localization.AtPrime p.asIdeal)) (n + 1)).obj
      (ModuleCat.of (Localization.AtPrime p.asIdeal) (Localization.AtPrime p.asIdeal))))

/-- The object property of the elementary contractible two-term complexes over `R_𝔭`. -/
abbrev localizationAtPrimeElementaryTrivialComplexProperty (p : PrimeSpectrum R) :
    ObjectProperty (CochainComplex (ModuleCat (Localization.AtPrime p.asIdeal)) ℤ) :=
  ObjectProperty.ofObj (localizationAtPrimeElementaryTrivialComplex p)

/-- Helper for Lemma 15.76.8: the explicit finite biproduct of localization-at-prime elementary
trivial complexes indexed by a list of degrees. -/
def localizationAtPrimeElementaryDiskSum (p : PrimeSpectrum R) :
    List ℤ → CochainComplex (ModuleCat (Localization.AtPrime p.asIdeal)) ℤ
  | [] => 0
  | n :: σ =>
      localizationAtPrimeElementaryTrivialComplex p n ⊞
        localizationAtPrimeElementaryDiskSum p σ

/-- Helper for Lemma 15.76.8: the explicit finite biproduct of localization-away elementary
trivial complexes indexed by a list of degrees. -/
def localizationAwayElementaryDiskSum (f : R) :
    List ℤ → CochainComplex (ModuleCat (Localization.Away f)) ℤ
  | [] => 0
  | n :: σ =>
      localizationAwayElementaryTrivialComplex f n ⊞
        localizationAwayElementaryDiskSum f σ

/-- Helper for Lemma 15.76.8: the explicit at-prime disk sum belongs to the additive closure of
the elementary trivial complexes. -/
lemma localizationAtPrimeElementaryDiskSum_mem_additiveClosure
    (p : PrimeSpectrum R) :
    ∀ σ : List ℤ,
      (localizationAtPrimeElementaryTrivialComplexProperty p).additiveClosure
        (localizationAtPrimeElementaryDiskSum p σ) := by
  intro σ
  induction σ with
  | nil =>
      -- Proof comment: the empty disk sum is the zero complex, and additive closures contain zero.
      simpa [localizationAtPrimeElementaryDiskSum] using
        (ObjectProperty.prop_zero
          ((localizationAtPrimeElementaryTrivialComplexProperty p).additiveClosure))
  | cons n σ ih =>
      have hhead :
          (localizationAtPrimeElementaryTrivialComplexProperty p).additiveClosure
            (localizationAtPrimeElementaryTrivialComplex p n) := by
        -- Proof comment: each elementary disk is one of the generators of the additive closure.
        have hmem :
            localizationAtPrimeElementaryTrivialComplexProperty p
              (localizationAtPrimeElementaryTrivialComplex p n) := by
          simpa [localizationAtPrimeElementaryTrivialComplexProperty] using
            (ObjectProperty.ofObj_apply
              (localizationAtPrimeElementaryTrivialComplex p) n)
        simpa [ObjectProperty.additiveClosure] using
          (((localizationAtPrimeElementaryTrivialComplexProperty p).le_colimitsClosure
            (fun m : ℕ ↦ Discrete (Fin m))) _ hmem)
      -- Proof comment: additive closures are stable under binary biproducts, so consing one
      -- elementary disk preserves membership.
      simpa [localizationAtPrimeElementaryDiskSum] using
        ((localizationAtPrimeElementaryTrivialComplexProperty p).additiveClosure
          .prop_of_isColimit_binaryCofan
            (BinaryBiproduct.isColimit
              (localizationAtPrimeElementaryTrivialComplex p n)
              (localizationAtPrimeElementaryDiskSum p σ))
            hhead
            ih)

/-- Helper for Lemma 15.76.8: the explicit away disk sum belongs to the additive closure of the
elementary trivial complexes. -/
lemma localizationAwayElementaryDiskSum_mem_additiveClosure
    (f : R) :
    ∀ σ : List ℤ,
      (localizationAwayElementaryTrivialComplexProperty f).additiveClosure
        (localizationAwayElementaryDiskSum f σ) := by
  intro σ
  induction σ with
  | nil =>
      -- Proof comment: the empty disk sum is the zero complex, and additive closures contain zero.
      simpa [localizationAwayElementaryDiskSum] using
        (ObjectProperty.prop_zero
          ((localizationAwayElementaryTrivialComplexProperty f).additiveClosure))
  | cons n σ ih =>
      have hhead :
          (localizationAwayElementaryTrivialComplexProperty f).additiveClosure
            (localizationAwayElementaryTrivialComplex f n) := by
        -- Proof comment: each elementary away disk is a generating object by definition.
        have hmem :
            localizationAwayElementaryTrivialComplexProperty f
              (localizationAwayElementaryTrivialComplex f n) := by
          simpa [localizationAwayElementaryTrivialComplexProperty] using
            (ObjectProperty.ofObj_apply
              (localizationAwayElementaryTrivialComplex f) n)
        simpa [ObjectProperty.additiveClosure] using
          (((localizationAwayElementaryTrivialComplexProperty f).le_colimitsClosure
            (fun m : ℕ ↦ Discrete (Fin m))) _ hmem)
      -- Proof comment: additive closure stays closed under binary biproducts, so appending one
      -- more elementary disk preserves the property.
      simpa [localizationAwayElementaryDiskSum] using
        ((localizationAwayElementaryTrivialComplexProperty f).additiveClosure
          .prop_of_isColimit_binaryCofan
            (BinaryBiproduct.isColimit
              (localizationAwayElementaryTrivialComplex f n)
              (localizationAwayElementaryDiskSum f σ))
            hhead
            ih)

-- Proof comment: a bounded finite-projective representative already exhibits the corresponding
-- derived object as perfect, with no further construction needed.
/-- Helper for Lemma 15.76.8: the derived object of a bounded finite-projective complex is
perfect. -/
lemma q_obj_isPerfect_of_isBoundedFiniteProjective
    (L : CpxR) [hL : CochainComplex.IsBoundedFiniteProjective L] :
    DerivedCategory.IsPerfect (DerivedCategory.Q.obj L) := by
  exact ⟨L, Iso.refl _, hL⟩

-- Proof comment: choose an actual isomorphism representing `IsIsomorphic` and apply the canonical
-- derived scalar-extension functor to that isomorphism.
/-- Helper for Lemma 15.76.8: derived scalar extension preserves proposition-level isomorphism. -/
lemma isIsomorphic_derivedTensorWithAlgebra
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {K L : DerivedCategory (ModuleCat A)}
    (hKL : IsIsomorphic K L) :
    IsIsomorphic (K ⊗[A]^L[B]) (L ⊗[A]^L[B]) := by
  rcases hKL with ⟨e⟩
  exact ⟨(derivedTensorWithAlgebra (algebraMap A B)).mapIso e⟩

/-- Helper for Lemma 15.76.8: exact scalar extension on derived categories preserves
proposition-level isomorphism. -/
lemma isIsomorphic_mapDerivedCategory
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    {K L : DerivedCategory (ModuleCat A)}
    (hKL : IsIsomorphic K L) :
    IsIsomorphic
      (((ModuleCat.extendScalars (algebraMap A B)).mapDerivedCategory).obj K)
      (((ModuleCat.extendScalars (algebraMap A B)).mapDerivedCategory).obj L) := by
  rcases hKL with ⟨e⟩
  -- Proof comment: apply the exact scalar-extension functor to a chosen isomorphism witness.
  exact ⟨((ModuleCat.extendScalars (algebraMap A B)).mapDerivedCategory).mapIso e⟩

/-- Helper for Lemma 15.76.8: localizing a bounded finite-projective complex at `p` preserves the
support interval and makes every term finite free over `R_𝔭`. -/
lemma localizationAtPrimeComplex_is_bounded_termwiseFiniteFree_of_isBoundedFiniteProjective
    (p : PrimeSpectrum R) (L : CpxR) (hL : L.IsBoundedFiniteProjective) :
    (∃ a b : ℤ, (localizationAtPrimeComplex p L).IsStrictlyGE a ∧
      (localizationAtPrimeComplex p L).IsStrictlyLE b) ∧
      (localizationAtPrimeComplex p L).IsTermwiseFiniteFree := by
  let Rp := Localization.AtPrime p.asIdeal
  letI : IsLocalRing Rp := IsLocalization.AtPrime.isLocalRing Rp p.asIdeal
  rcases hL.bounded with ⟨a, b, hLge, hLle⟩
  constructor
  · refine ⟨a, b, ?_, ?_⟩
    · rw [CochainComplex.isStrictlyGE_iff]
      intro i hi
      -- Proof comment: below the lower bound, the source term is zero, and scalar extension
      -- preserves zero objects.
      exact (ModuleCat.extendScalars (algebraMap R Rp)).map_isZero (L.isZero_of_isStrictlyGE a i hi)
    · rw [CochainComplex.isStrictlyLE_iff]
      intro i hi
      -- Proof comment: above the upper bound, the source term is zero, and scalar extension
      -- preserves zero objects.
      exact (ModuleCat.extendScalars (algebraMap R Rp)).map_isZero (L.isZero_of_isStrictlyLE b i hi)
  · refine ⟨fun i ↦ ?_⟩
    -- Proof comment: each localized term is still finite projective, hence free over the local
    -- ring `R_𝔭` by Lemma `10.55.8`.
    let _ : Module.Finite R (L.X i) := hL.finite i
    let _ : Module.Projective R (L.X i) := hL.projective i
    change
      Module.Free Rp (((ModuleCat.extendScalars (algebraMap R Rp)).obj (L.X i)) : Type u) ∧
        Module.Finite Rp (((ModuleCat.extendScalars (algebraMap R Rp)).obj (L.X i)) : Type u)
    refine ⟨?_, inferInstance⟩
    exact
      finite_projective_module_free_of_isLocalRing
        (R := Rp)
        (M := (((ModuleCat.extendScalars (algebraMap R Rp)).obj (L.X i)) : Type u))

/-- Helper for Lemma 15.76.8: isomorphic derived objects over a local ring have the same
residue-field homology dimensions. -/
lemma residueFieldDerivedHomology_finrank_eq_of_isIsomorphic
    {A : Type u} [CommRing A] [IsLocalRing A]
    {K L : DerivedCategory (ModuleCat A)}
    (hKL : IsIsomorphic K L) (i : ℤ) :
    Module.finrank (ResidueField A) (residueFieldDerivedHomology (R := A) K i) =
      Module.finrank (ResidueField A) (residueFieldDerivedHomology (R := A) L i) := by
  rcases hKL with ⟨e⟩
  -- Proof comment: derived scalar extension and homology carry the chosen isomorphism to an
  -- isomorphism of residue-field homology modules, and `Module.finrank` is invariant under that
  -- linear equivalence.
  exact
    Module.finrank_eq_of_equiv
      (((DerivedCategory.homologyFunctor (ModuleCat (ResidueField A)) i).mapIso
        ((derivedTensorWithAlgebra (algebraMap A (ResidueField A))).mapIso e)).toLinearEquiv)

/-- Helper for Lemma 15.76.8: over a field, a module with prescribed finrank is linearly
equivalent to the standard coordinate module of that rank. -/
lemma nonempty_linearEquiv_fin_of_finrank_eq
    {k : Type u} [Field k] {V : Type*} [AddCommGroup V] [Module k V]
    [FiniteDimensional k V] {n : ℕ} (hV : Module.finrank k V = n) :
    Nonempty (V ≃ₗ[k] (Fin n → k)) := by
  -- Proof comment: choose the canonical `Fin n`-indexed basis coming from the finrank equality
  -- and read off its coordinate linear equivalence.
  let b : Module.Basis (Fin n) k V := Module.finBasisOfFinrankEq k V hV
  exact ⟨b.equivFun⟩

/-- Helper for Lemma 15.76.8: a bounded-above termwise finite-free complex canonically defines the
Chapter 13 `MinusWithTermsIn` owner. -/
lemma minusWithTermsIn_of_isStrictlyLE_termwiseFiniteFree
    {A : Type u} [CommRing A]
    (K : CochainComplex (ModuleCat A) ℤ) {b : ℤ}
    (hKb : K.IsStrictlyLE b) (hKfree : K.IsTermwiseFiniteFree) :
    CochainComplex.MinusWithTermsIn
      (fun M : ModuleCat A ↦ Module.Free A M ∧ Module.Finite A M) := by
  -- Proof comment: package the bounded-above witness and the termwise finite-free data into the
  -- canonical bounded-above owner.
  refine ⟨⟨K, (CochainComplex.minus_iff (ModuleCat A) K).2 ⟨b, hKb⟩⟩, fun i ↦ ?_⟩
  simpa using CochainComplex.IsTermwiseFiniteFree.out (E := K) i

/-- Helper for Lemma 15.76.8: a bounded-above termwise finite-free complex also canonically
defines the Chapter 13 `ProjectiveMinus` owner. -/
lemma projectiveMinus_of_isStrictlyLE_termwiseFiniteFree
    {A : Type u} [CommRing A]
    (K : CochainComplex (ModuleCat A) ℤ) {b : ℤ}
    (hKb : K.IsStrictlyLE b) (hKfree : K.IsTermwiseFiniteFree) :
    CochainComplex.ProjectiveMinus (ModuleCat A) := by
  -- Proof comment: the upper support bound gives the bounded-above owner, and each finite free
  -- term is projective.
  letI : K.IsTermwiseFiniteFree := hKfree
  refine ⟨⟨K, (CochainComplex.minus_iff (ModuleCat A) K).2 ⟨b, hKb⟩⟩, fun i ↦ ?_⟩
  change Projective (K.X i)
  rcases CochainComplex.IsTermwiseFiniteFree.out (E := K) i with ⟨hFree, _⟩
  let _ : Module.Free A (K.X i) := hFree
  infer_instance

/-- Helper for Lemma 15.76.8: every derived morphism out of a bounded-above projective complex is
represented by an actual cochain map. -/
lemma exists_cochainMap_of_projectiveMinus_derived_morphism
    {A : Type u} [CommRing A]
    (P : CochainComplex.ProjectiveMinus (ModuleCat A))
    {L : CochainComplex (ModuleCat A) ℤ}
    (α : DerivedCategory.Q.obj (P : CochainComplex (ModuleCat A) ℤ) ⟶
      DerivedCategory.Q.obj L) :
    ∃ β : (P : CochainComplex (ModuleCat A) ℤ) ⟶ L, DerivedCategory.Q.map β = α := by
  let HoQ := HomotopyCategory.quotient (ModuleCat A) (ComplexShape.up ℤ)
  let eHom :
      (DerivedCategory.Qh.obj (HoQ.obj (P : CochainComplex (ModuleCat A) ℤ)) ⟶
        DerivedCategory.Qh.obj (HoQ.obj L)) ≃
        (DerivedCategory.Q.obj (P : CochainComplex (ModuleCat A) ℤ) ⟶
          DerivedCategory.Q.obj L) :=
    Iso.homCongr
      ((DerivedCategory.quotientCompQhIso (ModuleCat A)).app
        (P : CochainComplex (ModuleCat A) ℤ))
      ((DerivedCategory.quotientCompQhIso (ModuleCat A)).app L)
  let αh :
      DerivedCategory.Qh.obj (HoQ.obj (P : CochainComplex (ModuleCat A) ℤ)) ⟶
        DerivedCategory.Qh.obj (HoQ.obj L) :=
    eHom.symm α
  -- Proof comment: the Chapter 13 bijection lifts the derived morphism to the homotopy category,
  -- and then the quotient functor supplies an actual cochain representative.
  obtain ⟨βh, hβh⟩ :=
    (CochainComplex.homotopyCategory_to_derived_bijective_of_boundedAbove_projective P L).surjective
      αh
  obtain ⟨β, rfl⟩ := HoQ.map_surjective βh
  refine ⟨β, ?_⟩
  calc
    DerivedCategory.Q.map β =
        eHom (DerivedCategory.Qh.map (HoQ.map β)) := by
          simpa using quotientCompQhIso_homCongr_map (R := A) (f := β)
    _ = eHom αh := by rw [hβh]
    _ = α := by simp [αh]

/-- Helper for Lemma 15.76.8: two strict maps out of a bounded-above projective complex are
homotopic once they induce the same derived morphism. -/
lemma nonempty_homotopy_of_projectiveMinus_q_map_eq
    {A : Type u} [CommRing A]
    (P : CochainComplex.ProjectiveMinus (ModuleCat A))
    {L : CochainComplex (ModuleCat A) ℤ}
    {f g : (P : CochainComplex (ModuleCat A) ℤ) ⟶ L}
    (hfg : DerivedCategory.Q.map f = DerivedCategory.Q.map g) :
    Nonempty (Homotopy f g) := by
  let HoQ := HomotopyCategory.quotient (ModuleCat A) (ComplexShape.up ℤ)
  let eHom :
      (DerivedCategory.Qh.obj (HoQ.obj (P : CochainComplex (ModuleCat A) ℤ)) ⟶
        DerivedCategory.Qh.obj (HoQ.obj L)) ≃
        (DerivedCategory.Q.obj (P : CochainComplex (ModuleCat A) ℤ) ⟶
          DerivedCategory.Q.obj L) :=
    Iso.homCongr
      ((DerivedCategory.quotientCompQhIso (ModuleCat A)).app
        (P : CochainComplex (ModuleCat A) ℤ))
      ((DerivedCategory.quotientCompQhIso (ModuleCat A)).app L)
  have hQh :
      DerivedCategory.Qh.map (HoQ.map f) = DerivedCategory.Qh.map (HoQ.map g) := by
    have hfQ :
        eHom (DerivedCategory.Qh.map (HoQ.map f)) = DerivedCategory.Q.map f := by
      simpa using quotientCompQhIso_homCongr_map (R := A) (f := f)
    have hgQ :
        eHom (DerivedCategory.Qh.map (HoQ.map g)) = DerivedCategory.Q.map g := by
      simpa using quotientCompQhIso_homCongr_map (R := A) (f := g)
    apply eHom.injective
    calc
      eHom (DerivedCategory.Qh.map (HoQ.map f)) = DerivedCategory.Q.map f := hfQ
      _ = DerivedCategory.Q.map g := hfg
      _ = eHom (DerivedCategory.Qh.map (HoQ.map g)) := hgQ.symm
  have hquot : HoQ.map f = HoQ.map g := by
    exact
      (CochainComplex.homotopyCategory_to_derived_bijective_of_boundedAbove_projective P L)
        .injective hQh
  have hzero : HoQ.map (f - g) = 0 := by
    simpa [Functor.map_sub, hquot] using sub_eq_zero.mpr hquot
  rcases (HomotopyCategory.quotient_map_eq_zero_iff (f - g)).1 hzero with ⟨h⟩
  -- Proof comment: null-homotopy of `f - g` is the same as a homotopy from `f` to `g`.
  refine ⟨?_⟩
  simpa [sub_eq_add_neg, add_assoc] using Homotopy.add h (Homotopy.refl g)

/-- Helper for Lemma 15.76.8: if two bounded-above projective complexes have isomorphic derived
images, then they are homotopy equivalent already as strict complexes. -/
lemma nonempty_homotopyEquiv_of_isIsomorphic_q_obj_of_projectiveMinus
    {A : Type u} [CommRing A]
    {K L : CochainComplex (ModuleCat A) ℤ}
    (PK : CochainComplex.ProjectiveMinus (ModuleCat A))
    (PL : CochainComplex.ProjectiveMinus (ModuleCat A))
    (hKL : IsIsomorphic
      (DerivedCategory.Q.obj (PK : CochainComplex (ModuleCat A) ℤ))
      (DerivedCategory.Q.obj (PL : CochainComplex (ModuleCat A) ℤ))) :
    Nonempty (HomotopyEquiv (PK : CochainComplex (ModuleCat A) ℤ)
      (PL : CochainComplex (ModuleCat A) ℤ)) := by
  rcases hKL with ⟨e⟩
  -- Proof comment: lift the chosen derived isomorphism and its inverse to actual cochain maps.
  obtain ⟨f, hf⟩ :=
    exists_cochainMap_of_projectiveMinus_derived_morphism
      (A := A) PK e.hom
  obtain ⟨g, hg⟩ :=
    exists_cochainMap_of_projectiveMinus_derived_morphism
      (A := A) PL e.inv
  have hfgQ :
      DerivedCategory.Q.map (f ≫ g) =
        DerivedCategory.Q.map
          (𝟙 (PK : CochainComplex (ModuleCat A) ℤ)) := by
    calc
      DerivedCategory.Q.map (f ≫ g) =
          DerivedCategory.Q.map f ≫ DerivedCategory.Q.map g := by simp
      _ = e.hom ≫ e.inv := by rw [hf, hg]
      _ = DerivedCategory.Q.map
            (𝟙 (PK : CochainComplex (ModuleCat A) ℤ)) := by simp
  have hgfQ :
      DerivedCategory.Q.map (g ≫ f) =
        DerivedCategory.Q.map
          (𝟙 (PL : CochainComplex (ModuleCat A) ℤ)) := by
    calc
      DerivedCategory.Q.map (g ≫ f) =
          DerivedCategory.Q.map g ≫ DerivedCategory.Q.map f := by simp
      _ = e.inv ≫ e.hom := by rw [hg, hf]
      _ = DerivedCategory.Q.map
            (𝟙 (PL : CochainComplex (ModuleCat A) ℤ)) := by simp
  rcases nonempty_homotopy_of_projectiveMinus_q_map_eq
      (A := A) PK hfgQ with ⟨hfg⟩
  rcases nonempty_homotopy_of_projectiveMinus_q_map_eq
      (A := A) PL hgfQ with ⟨hgf⟩
  -- Proof comment: the lifted forward and inverse maps now satisfy the defining homotopy
  -- relations of a homotopy equivalence.
  exact ⟨⟨f, g, hfg, hgf⟩⟩

/-- Helper for Lemma 15.76.8: the mapping cone of a homotopy equivalence is acyclic. -/
lemma mappingCone_acyclic_of_homotopyEquiv
    {A : Type u} [CommRing A]
    {K L : CochainComplex (ModuleCat A) ℤ}
    (e : HomotopyEquiv K L) :
    (CochainComplex.mappingCone e.hom).Acyclic := by
  -- Proof comment: homotopy equivalences are quasi-isomorphisms, so the standard abelian
  -- mapping-cone criterion applies to the chosen forward map.
  have hq : QuasiIso e.hom := by
    rw [← HomologicalComplex.mem_quasiIso_iff]
    exact
      (homotopyEquivalences_le_quasiIso (ModuleCat A) (up ℤ))
        e.isHomotopyEquivalence
  have hq' :
      HomotopyCategory.quasiIso (ModuleCat A) (up ℤ)
        ((HomotopyCategory.quotient (ModuleCat A) (up ℤ)).map e.hom) := by
    exact
      (HomotopyCategory.quotient_map_mem_quasiIso_iff
        (C := ModuleCat A) (c := up ℤ) e.hom).2 hq
  have hq'' :
      (HomotopyCategory.subcategoryAcyclic (ModuleCat A)).trW
        ((HomotopyCategory.quotient (ModuleCat A) (up ℤ)).map e.hom) := by
    simpa [HomotopyCategory.quasiIso_eq_subcategoryAcyclic_W (C := ModuleCat A)] using hq'
  have hmem :
      HomotopyCategory.subcategoryAcyclic (ModuleCat A)
        ((HomotopyCategory.quotient (ModuleCat A) (up ℤ)).obj
          (CochainComplex.mappingCone e.hom)) := by
    -- Proof comment: the standard mapping-cone triangle identifies the cone with the witness
    -- object attached to the quasi-isomorphism of `e.hom`.
    simpa using
      ((HomotopyCategory.subcategoryAcyclic (ModuleCat A)).trW_iff_of_distinguished
        (CochainComplex.mappingCone.triangleh e.hom)
        (HomotopyCategory.mappingCone_triangleh_distinguished e.hom)).1 hq''
  exact
    (HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_acyclic
      (C := ModuleCat A) (CochainComplex.mappingCone e.hom)).1 hmem

/-- Helper for Lemma 15.76.8: if two complexes split over isomorphic middle models, then after
swapping the auxiliary summands they become strictly isomorphic. -/
lemma nonempty_iso_biprod_swap_of_model_iso
    {A : Type u} [CommRing A]
    {C1 C2 P1 P2 T1 T2 : CochainComplex (ModuleCat A) ℤ}
    (hC1 : Nonempty (C1 ≅ P1 ⊞ T1))
    (hP : Nonempty (P1 ≅ P2))
    (hC2 : Nonempty (C2 ≅ P2 ⊞ T2)) :
    Nonempty (C1 ⊞ T2 ≅ C2 ⊞ T1) := by
  rcases hC1 with ⟨e1⟩
  rcases hP with ⟨eP⟩
  rcases hC2 with ⟨e2⟩
  -- Proof comment: reassociate to expose the common model, transport it across `eP`, swap the
  -- two auxiliary summands by the biproduct braiding, and reassociate back.
  refine ⟨?_⟩
  calc
    C1 ⊞ T2 ≅ (P1 ⊞ T1) ⊞ T2 := biprod.mapIso e1 (Iso.refl T2)
    _ ≅ P1 ⊞ (T1 ⊞ T2) := biprod.associator P1 T1 T2
    _ ≅ P2 ⊞ (T2 ⊞ T1) := biprod.mapIso eP (biprod.braiding T1 T2)
    _ ≅ (P2 ⊞ T2) ⊞ T1 := (biprod.associator P2 T2 T1).symm
    _ ≅ C2 ⊞ T1 := biprod.mapIso e2.symm (Iso.refl T1)

