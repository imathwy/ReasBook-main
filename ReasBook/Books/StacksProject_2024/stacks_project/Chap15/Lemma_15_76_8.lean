-- Proof sketch: localize the given derived-category isomorphism at the prime `p`, use the
-- filtered-colimit description `R_p = colim_{f ∉ p} R_f` to descend an isomorphism of complexes
-- from the local ring `R_p` to some localization `R_f`, and in the local case split each bounded
-- finite-projective complex into its minimal summand plus a finite direct sum of elementary
-- contractible two-term complexes using Lemmas `15.76.6` and `10.102.2`.
/-- Lemma 15.76.8: if `M^•` and `N^•` are bounded complexes of finite projective `R`-modules
representing the same object of `D(R)`, then after localizing away from some element
`f ∉ 𝔭` there exist complexes `P^•` and `Q^•` in the additive closure of the elementary trivial
two-term complexes over `R_f` such that `M^•_f ⊞ P^•` and `N^•_f ⊞ Q^•` are isomorphic as
complexes. -/
theorem exists_localizationAway_iso_biproduct_trivialComplexes_of_same_derivedObject
    (p : PrimeSpectrum R) {M N : CpxR}
    (hM : M.IsBoundedFiniteProjective)
    (hN : N.IsBoundedFiniteProjective)
    (hMN : IsIsomorphic (DerivedCategory.Q.obj M) (DerivedCategory.Q.obj N)) :
    ∃ f : R, f ∉ p.asIdeal ∧
      ∃ P Q : CochainComplex (ModuleCat (Localization.Away f)) ℤ,
        (localizationAwayElementaryTrivialComplexProperty f).additiveClosure P ∧
        (localizationAwayElementaryTrivialComplexProperty f).additiveClosure Q ∧
          IsIsomorphic
            (localizationAwayComplex f M ⊞ P)
            (localizationAwayComplex f N ⊞ Q) := by
  let Rp := Localization.AtPrime p.asIdeal
  let Mp := localizationAtPrimeComplex p M
  let Np := localizationAtPrimeComplex p N
  let hM' : M.IsBoundedFiniteProjective := hM
  let hN' : N.IsBoundedFiniteProjective := hN
  letI : IsLocalRing Rp := IsLocalization.AtPrime.isLocalRing Rp p.asIdeal
  -- Proof comment: the given complexes already define perfect objects, so the source proof can
  -- begin by passing their common derived object to the local ring `R_𝔭`.
  have hQMP : DerivedCategory.IsPerfect (DerivedCategory.Q.obj M) := by
    let _ : M.IsBoundedFiniteProjective := hM'
    exact q_obj_isPerfect_of_isBoundedFiniteProjective M
  have hQNP : DerivedCategory.IsPerfect (DerivedCategory.Q.obj N) := by
    let _ : N.IsBoundedFiniteProjective := hN'
    exact q_obj_isPerfect_of_isBoundedFiniteProjective N
  have hMpPerfect : ((DerivedCategory.Q.obj M) ⊗[R]^L[Rp]).IsPerfect := by
    exact derivedTensorWithAlgebra_isPerfect (DerivedCategory.Q.obj M) hQMP
  have hNpPerfect : ((DerivedCategory.Q.obj N) ⊗[R]^L[Rp]).IsPerfect := by
    exact derivedTensorWithAlgebra_isPerfect (DerivedCategory.Q.obj N) hQNP
  have hMNp :
      IsIsomorphic
        ((DerivedCategory.Q.obj M) ⊗[R]^L[Rp])
        ((DerivedCategory.Q.obj N) ⊗[R]^L[Rp]) := by
    exact isIsomorphic_derivedTensorWithAlgebra (A := R) (B := Rp) hMN
  have hMpQ :
      DerivedCategory.Q.obj Mp ≅
        (((ModuleCat.extendScalars (algebraMap R Rp)).mapDerivedCategory).obj
          (DerivedCategory.Q.obj M)) := by
    -- Proof comment: identify the strict localized complex `Mp` with exact scalar extension of
    -- `Q.obj M`.
    simpa [Mp] using q_obj_localizationAtPrimeComplex_mapDerived_iso (R := R) (p := p) M
  have hNpQ :
      DerivedCategory.Q.obj Np ≅
        (((ModuleCat.extendScalars (algebraMap R Rp)).mapDerivedCategory).obj
          (DerivedCategory.Q.obj N)) := by
    -- Proof comment: the same strict comparison identifies `Np` with exact scalar extension of
    -- `Q.obj N`.
    simpa [Np] using q_obj_localizationAtPrimeComplex_mapDerived_iso (R := R) (p := p) N
  have hMNp_strict :
      IsIsomorphic (DerivedCategory.Q.obj Mp) (DerivedCategory.Q.obj Np) := by
    have hMNp_map :
        IsIsomorphic
          (((ModuleCat.extendScalars (algebraMap R Rp)).mapDerivedCategory).obj
            (DerivedCategory.Q.obj M))
          (((ModuleCat.extendScalars (algebraMap R Rp)).mapDerivedCategory).obj
            (DerivedCategory.Q.obj N)) := by
      exact isIsomorphic_mapDerivedCategory (A := R) (B := Rp) hMN
    rcases hMNp_map with ⟨eMNp⟩
    -- Proof comment: transport the localized derived isomorphism across the strict comparison
    -- isomorphisms for `Mp` and `Np`.
    exact ⟨hMpQ ≪≫ eMNp ≪≫ hNpQ.symm⟩
  have hMpBoundedFree :
      (∃ a b : ℤ, Mp.IsStrictlyGE a ∧ Mp.IsStrictlyLE b) ∧ Mp.IsTermwiseFiniteFree := by
    -- Proof comment: this is the direct cochain-level localization of `M`, now termwise finite
    -- free over the local ring `R_𝔭`.
    simpa [Mp] using
      localizationAtPrimeComplex_is_bounded_termwiseFiniteFree_of_isBoundedFiniteProjective
        (p := p) (L := M) hM
  have hNpBoundedFree :
      (∃ a b : ℤ, Np.IsStrictlyGE a ∧ Np.IsStrictlyLE b) ∧ Np.IsTermwiseFiniteFree := by
    -- Proof comment: the same localization argument applies to `N`.
    simpa [Np] using
      localizationAtPrimeComplex_is_bounded_termwiseFiniteFree_of_isBoundedFiniteProjective
        (p := p) (L := N) hN
  -- Route correction: the remaining source-faithful work is the genuinely local step over `R_𝔭`
  -- (split each localized bounded finite-projective complex into a minimal finite-free model plus
  -- elementary disks, compare the minimal parts by Lemma `15.76.6`, then descend that finite
  -- stable isomorphism to some `R_f` with `f ∉ 𝔭`).
  have hMNκ_rank :
      ∀ i : ℤ,
        Module.finrank (ResidueField Rp)
            (residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Mp) i) =
          Module.finrank (ResidueField Rp)
            (residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Np) i) := by
    -- Proof comment: after the strict comparison above, the local source datum is the common
    -- residue-field rank function of the actual localized complexes `Mp` and `Np`.
    intro i
    exact residueFieldDerivedHomology_finrank_eq_of_isIsomorphic (A := Rp) hMNp_strict i
  have hMpStrictPerfect : (DerivedCategory.Q.obj Mp).IsPerfect := by
    -- Proof comment: transport perfectness of the derived scalar-extension object back to the
    -- strict localized complex `Mp`.
    exact DerivedCategory.IsPerfect.prop_of_iso hMpQ hMpPerfect
  have hNpStrictPerfect : (DerivedCategory.Q.obj Np).IsPerfect := by
    -- Proof comment: likewise for `Np`.
    exact DerivedCategory.IsPerfect.prop_of_iso hNpQ hNpPerfect
  have hMpPseudo :
      (DerivedCategory.Q.obj Mp).IsPseudoCoherent := by
    -- Proof comment: Lemma `15.76.6` works with pseudo-coherent objects, so extract that half of
    -- perfectness for the strict localized object `Mp`.
    exact
      (isPerfect_iff_isPseudoCoherent_and_hasFiniteTorDimension
        (DerivedCategory.Q.obj Mp)).1 hMpStrictPerfect |>.1
  have hNpPseudo :
      (DerivedCategory.Q.obj Np).IsPseudoCoherent := by
    -- Proof comment: the same pseudo-coherence package is available for `Np`.
    exact
      (isPerfect_iff_isPseudoCoherent_and_hasFiniteTorDimension
        (DerivedCategory.Q.obj Np)).1 hNpStrictPerfect |>.1
  let d : ℤ → ℕ := fun i ↦
    Module.finrank (ResidueField Rp)
      (residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Mp) i)
  have hMpFiniteDim :
      ∀ i : ℤ,
        FiniteDimensional (ResidueField Rp)
          (residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Mp) i) := by
    -- Proof comment: pseudo-coherence over the local ring gives finite-dimensional residue-field
    -- homology in every degree.
    intro i
    exact
      (residueFieldDerivedHomology_finiteDimensional_and_eventually_isZero_of_isPseudoCoherent
        (R := Rp) (K := DerivedCategory.Q.obj Mp) hMpPseudo).1 i
  have hNpFiniteDim :
      ∀ i : ℤ,
        FiniteDimensional (ResidueField Rp)
          (residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Np) i) := by
    -- Proof comment: the same finite-dimensionality statement applies to `Np`.
    intro i
    exact
      (residueFieldDerivedHomology_finiteDimensional_and_eventually_isZero_of_isPseudoCoherent
        (R := Rp) (K := DerivedCategory.Q.obj Np) hNpPseudo).1 i
  have hdMp :
      ∀ i : ℤ,
        Nonempty
          ((residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Mp) i) ≃ₗ[
              ResidueField Rp] (Fin (d i) → ResidueField Rp)) := by
    -- Proof comment: choose coordinate bases for the local residue-field homology groups of `Mp`
    -- using their finrank.
    intro i
    let _ := hMpFiniteDim i
    simpa [d] using
      (nonempty_linearEquiv_fin_of_finrank_eq
        (k := ResidueField Rp)
        (V := residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Mp) i)
        (n := d i) rfl)
  have hdNp :
      ∀ i : ℤ,
        Nonempty
          ((residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Np) i) ≃ₗ[
              ResidueField Rp] (Fin (d i) → ResidueField Rp)) := by
    -- Proof comment: transport the common rank function `d` across `hMNκ_rank` and choose the
    -- corresponding coordinate bases for `Np`.
    intro i
    let _ := hNpFiniteDim i
    have hfin :
        Module.finrank (ResidueField Rp)
            (residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Np) i) = d i := by
      simpa [d] using (hMNκ_rank i).symm
    exact
      nonempty_linearEquiv_fin_of_finrank_eq
        (k := ResidueField Rp)
        (V := residueFieldDerivedHomology (R := Rp) (DerivedCategory.Q.obj Np) i)
        (n := d i) hfin
  obtain ⟨Pm, hPmTerms, hPmQ⟩ :=
    exists_boundedAbove_termwiseFree_representative_of_residueFieldDerivedHomology
      (R := Rp) (K := DerivedCategory.Q.obj Mp) hMpPseudo d hdMp
  obtain ⟨Pn, hPnTerms, hPnQ⟩ :=
    exists_boundedAbove_termwiseFree_representative_of_residueFieldDerivedHomology
      (R := Rp) (K := DerivedCategory.Q.obj Np) hNpPseudo d hdNp
  have hPnQFromMp :
      Nonempty
        (DerivedCategory.Q.obj Mp ≅
          DerivedCategory.Q.obj
            (Pn : CochainComplex (ModuleCat Rp) ℤ)) := by
    rcases hMNp_strict with ⟨eMNp⟩
    rcases hPnQ with ⟨ePnQ⟩
    -- Proof comment: transport the chosen bounded-above free representative of `Np` across the
    -- strict derived isomorphism `Q.obj Mp ≅ Q.obj Np`.
    exact ⟨eMNp ≪≫ ePnQ⟩
  have hPmPn :
      Nonempty
        ((Pm : CochainComplex (ModuleCat Rp) ℤ) ≅
          (Pn : CochainComplex (ModuleCat Rp) ℤ)) := by
    -- Proof comment: Lemma `15.76.6` identifies the bounded-above free local models once the
    -- common residue-field rank function `d` has been fixed.
    exact
      boundedAbove_termwiseFree_representative_unique_of_residueFieldDerivedHomology
        (R := Rp) (K := DerivedCategory.Q.obj Mp) d hdMp
        hPmTerms hPmQ hPnTerms hPnQFromMp
  obtain ⟨σm, hMpSplit⟩ :=
    exists_local_iso_biproduct_prescribed_rank_model_and_disk_sum
      (p := p) (C := Mp) hMpBoundedFree Pm hPmTerms hPmQ
  obtain ⟨σn, hNpSplit⟩ :=
    exists_local_iso_biproduct_prescribed_rank_model_and_disk_sum
      (p := p) (C := Np) hNpBoundedFree Pn hPnTerms hPnQ
  have hlocalStable :
      Nonempty
        ((Mp ⊞ localizationAtPrimeElementaryDiskSum p σn) ≅
          (Np ⊞ localizationAtPrimeElementaryDiskSum p σm)) := by
    -- Proof comment: once both localized complexes are split over isomorphic minimal models, a
    -- single biproduct reassociation and braiding yields the stabilized strict isomorphism.
    exact nonempty_iso_biprod_swap_of_model_iso hMpSplit hPmPn hNpSplit
  -- Proof comment: the theorem now reduces exactly to the source proof's final finite-data
  -- descent step from `R_𝔭` to some `R_f`, after which the explicit disk sums are repackaged in
  -- the required additive closures.
  obtain ⟨f, hf, haway⟩ :=
    exists_away_descent_of_explicit_local_stable_iso_disk_sum
      (p := p) (M := M) (N := N) σn σm hlocalStable
  refine
    ⟨f, hf, localizationAwayElementaryDiskSum f σn, localizationAwayElementaryDiskSum f σm, ?_,
      ?_, haway⟩
  · -- Proof comment: the explicit left disk sum is by construction in the required additive
    -- closure.
    exact localizationAwayElementaryDiskSum_mem_additiveClosure (f := f) σn
  · -- Proof comment: the same closure lemma packages the explicit right disk sum.
    exact localizationAwayElementaryDiskSum_mem_additiveClosure (f := f) σm

end

end CategoryTheory
