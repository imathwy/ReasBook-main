/- Domain-style sampling:
- primary domain: derived completeness for finitely generated ideals and the intersection of their
  powers in a commutative ring;
- sampled owner-side declarations:
  `ModuleCat.IsDerivedCompleteWithRespectTo`,
  `DerivedCategory.ideal_fg_of_exists_fin_generators`,
  `principalPowerIntersection_sq_eq_bot_of_ring_isDerivedComplete`,
  `isAdicComplete_of_isReduced_of_isDerivedCompleteWithRespectTo_of_fg`;
- best owner abstraction: the source-facing ideal-level theorem on an arbitrary ideal `I`,
  together with the witness that `I` is generated by `r` elements;
- primitive data: the ideal `I`, the integer `r`, a generating-family witness
  `∃ f : Fin r → A, Ideal.span (Set.range f) = I`, and derived completeness of `A` with respect
  to `I`;
- derived API: the chosen-presentation specialization for `Ideal.span (Set.range f)`.

Layer triage:
- `source-facing`: the ideal-level nilpotence statement for `J = ⋂ n, I ^ n`;
- `core/canonical`: `ModuleCat.IsDerivedCompleteWithRespectTo` and the ideal-power intersection
  `⨅ n : ℕ, I ^ n`;
- `bridge/view`: the specialization to a chosen family `f : Fin r → A`. -/

local notation "J(" I ")" => ⨅ n : ℕ, I ^ n

/-- Helper for Lemma 15.94.11: derived completeness descends along inclusions of ideals. -/
lemma moduleCat_isDerivedCompleteWithRespectTo_of_le
    {R : Type u} [CommRing R] {J I : Ideal R} {M : ModuleCat R}
    (hM : M.IsDerivedCompleteWithRespectTo I) (hJI : J ≤ I) :
    M.IsDerivedCompleteWithRespectTo J := by
  -- Proof comment: the defining localization-vanishing condition for `J` is a subset of the one
  -- already known for `I`.
  intro f hf
  exact hM f (hJI hf)

/-- Helper for Lemma 15.94.11: kernels of maps from derived-complete modules remain derived
complete. -/
lemma moduleCat_isDerivedCompleteWithRespectTo_kernel_map
    {R : Type u} [CommRing R] {I : Ideal R} {M N : ModuleCat R} (u : M ⟶ N)
    (hM : M.IsDerivedCompleteWithRespectTo I) :
    (kernel u).IsDerivedCompleteWithRespectTo I := by
  sorry

/-- Helper for Lemma 15.94.11: derived completeness in `D(R)` is preserved by the shift by `1`.
-/
private lemma derivedCategory_isDerivedCompleteWithRespectTo_shift
    {R : Type u} [CommRing R] {I : Ideal R}
    {K : DerivedCategory (ModuleCat R)}
    (hK : K.IsDerivedCompleteWithRespectTo I) :
    K⟦(1 : ℤ)⟧.IsDerivedCompleteWithRespectTo I := by
  intro f hf E
  let F :
      DerivedCategory (ModuleCat (Localization.Away f)) ⥤
        DerivedCategory (ModuleCat R) :=
    (ModuleCat.restrictScalars (algebraMap R (Localization.Away f))).mapDerivedCategory
  have hsub : Subsingleton (F.obj (E⟦(-1 : ℤ)⟧) ⟶ K) := hK f hf (E⟦(-1 : ℤ)⟧)
  let eK : ((K⟦(1 : ℤ)⟧)⟦(-1 : ℤ)⟧) ≅ K :=
    (shiftFunctorCompIsoId (DerivedCategory (ModuleCat R)) (1 : ℤ) (-1 : ℤ) (by simp)).app K
  refine ⟨fun u v ↦ ?_⟩
  let u' : F.obj (E⟦(-1 : ℤ)⟧) ⟶ K :=
    ((F.commShiftIso (-1 : ℤ)).hom.app E) ≫ u⟦(-1 : ℤ)⟧' ≫ eK.hom
  let v' : F.obj (E⟦(-1 : ℤ)⟧) ⟶ K :=
    ((F.commShiftIso (-1 : ℤ)).hom.app E) ≫ v⟦(-1 : ℤ)⟧' ≫ eK.hom
  have hu'v' : u' = v' := hsub.elim _ _
  have huv :
      ((F.commShiftIso (-1 : ℤ)).hom.app E) ≫ u⟦(-1 : ℤ)⟧' ≫ eK.hom =
        ((F.commShiftIso (-1 : ℤ)).hom.app E) ≫ v⟦(-1 : ℤ)⟧' ≫ eK.hom := by
    simpa [u', v'] using hu'v'
  have hshift : u⟦(-1 : ℤ)⟧' = v⟦(-1 : ℤ)⟧' := by
    have huv' :
        (((F.commShiftIso (-1 : ℤ)).hom.app E) ≫ u⟦(-1 : ℤ)⟧') ≫ eK.hom =
          (((F.commShiftIso (-1 : ℤ)).hom.app E) ≫ v⟦(-1 : ℤ)⟧') ≫ eK.hom := by
      simpa [Category.assoc] using huv
    apply (cancel_epi ((F.commShiftIso (-1 : ℤ)).hom.app E)).1
    simpa [Category.assoc] using (cancel_mono eK.hom).1 huv'
  exact (shiftFunctor (DerivedCategory (ModuleCat R)) (-1 : ℤ)).map_injective hshift

/-- Helper for Lemma 15.94.11: cokernels of monomorphisms between derived-complete modules remain
derived complete. -/
lemma moduleCat_isDerivedCompleteWithRespectTo_cokernel_of_mono_map
    {R : Type u} [CommRing R] {I : Ideal R} {M N : ModuleCat R} (u : M ⟶ N) [Mono u]
    (hM : M.IsDerivedCompleteWithRespectTo I)
    (hN : N.IsDerivedCompleteWithRespectTo I) :
    (cokernel u).IsDerivedCompleteWithRespectTo I := by
  let S : ShortComplex (ModuleCat R) :=
    ShortComplex.mk u (cokernel.π u) (cokernel.condition u)
  have hS : S.ShortExact := by
    -- Proof comment: a monomorphism together with its cokernel projection is the canonical short
    -- exact row `0 → M → N → cokernel u → 0`.
    exact ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel S (cokernelIsCokernel u))
      inferInstance inferInstance
  let T : Triangle (DerivedCategory (ModuleCat R)) := hS.singleTriangle
  have hsubObj₂ :
      ∀ f ∈ I, ∀ E : DerivedCategory (ModuleCat (Localization.Away f)),
        Subsingleton
          (((ModuleCat.restrictScalars (algebraMap R (Localization.Away f))).mapDerivedCategory.obj E) ⟶
            T.obj₂) := by
    intro f hf E
    simpa [T, S] using hN f hf E
  have hsubShiftObj₁ :
      ∀ f ∈ I, ∀ E : DerivedCategory (ModuleCat (Localization.Away f)),
        Subsingleton
          (((ModuleCat.restrictScalars (algebraMap R (Localization.Away f))).mapDerivedCategory.obj E) ⟶
            T.obj₁⟦(1 : ℤ)⟧) := by
    intro f hf E
    simpa [T, S] using
      (derivedCategory_isDerivedCompleteWithRespectTo_shift (R := R) (I := I)
        (K := (ModuleCat.single0Functor : ModuleCat R ⥤ DerivedCategory (ModuleCat R)).obj M)
        (by simpa [ModuleCat.IsDerivedCompleteWithRespectTo] using hM)) f hf E
  intro f hf E
  let E' :
      DerivedCategory (ModuleCat R) :=
    ((ModuleCat.restrictScalars (algebraMap R (Localization.Away f))).mapDerivedCategory.obj E)
  have hsub₂ : Subsingleton (E' ⟶ T.obj₂) := hsubObj₂ f hf E
  have hsub₁shift : Subsingleton (E' ⟶ T.obj₁⟦(1 : ℤ)⟧) := hsubShiftObj₁ f hf E
  -- Proof comment: the triangle exactness says every map into the cokernel factors through the
  -- middle term, and any two such factors agree because that term is already derived complete.
  refine ⟨fun x y ↦ ?_⟩
  have hxy_zero : (x - y) ≫ T.mor₃ = 0 := by
    have hxy : x ≫ T.mor₃ = y ≫ T.mor₃ := hsub₁shift.elim _ _
    rw [Preadditive.sub_comp, hxy, sub_self]
  obtain ⟨z, hz⟩ := Triangle.coyoneda_exact₃ (T := T) hS.singleTriangle_distinguished (x - y) hxy_zero
  have hz_zero : z = 0 := hsub₂.elim _ _
  apply sub_eq_zero.mp
  calc
    x - y = z ≫ T.mor₂ := hz
    _ = 0 := by simpa [hz_zero]

/-- Helper for Lemma 15.94.11: module-level derived completeness is invariant under module
isomorphism. -/
private lemma module_isDerivedCompleteWithRespectTo_iff_of_iso_local
    {R : Type u} [CommRing R] {I : Ideal R} {M N : ModuleCat R} (e : M ≅ N) :
    M.IsDerivedCompleteWithRespectTo I ↔ N.IsDerivedCompleteWithRespectTo I := by
  -- Proof comment: transport the module statement through the degree-zero embedding into the
  -- derived category.
  constructor
  · intro hM f hf E
    have hSub :
        Subsingleton
          ((((ModuleCat.restrictScalars (algebraMap R (Localization.Away f))).mapDerivedCategory).obj
              E) ⟶
            (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj M) :=
      hM f hf E
    refine ⟨fun g₁ g₂ ↦ ?_⟩
    have hEq :
        g₁ ≫ ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).mapIso e).inv =
          g₂ ≫ ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).mapIso e).inv :=
      @Subsingleton.elim _ hSub _ _
    simpa [Category.assoc] using
      congrArg
        (fun h ↦ h ≫ ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).mapIso e).hom) hEq
  · intro hN f hf E
    have hSub :
        Subsingleton
          ((((ModuleCat.restrictScalars (algebraMap R (Localization.Away f))).mapDerivedCategory).obj
              E) ⟶
            (DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).obj N) :=
      hN f hf E
    refine ⟨fun g₁ g₂ ↦ ?_⟩
    have hEq :
        g₁ ≫ ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).mapIso e).hom =
          g₂ ≫ ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).mapIso e).hom :=
      @Subsingleton.elim _ hSub _ _
    simpa [Category.assoc] using
      congrArg
        (fun h ↦ h ≫ ((DerivedCategory.singleFunctor (ModuleCat R) (0 : ℤ)).mapIso e).inv) hEq

/-- Helper for Lemma 15.94.11: quotients by submodules of the form `J M` remain derived complete. -/
lemma moduleCat_isDerivedCompleteWithRespectTo_quotient_smul_top
    {R : Type u} [CommRing R] {I J : Ideal R} {M : ModuleCat R}
    (hM : M.IsDerivedCompleteWithRespectTo I) :
    (ModuleCat.of R (M ⧸ J • (⊤ : Submodule R M))).IsDerivedCompleteWithRespectTo I := by
  let K : Submodule R M := J • (⊤ : Submodule R M)
  have hKker :
      (kernel (ModuleCat.ofHom (Submodule.mkQ K))).IsDerivedCompleteWithRespectTo I := by
    -- Proof comment: the submodule `K = J M` is the kernel object of the quotient map `M → M / K`.
    exact
      moduleCat_isDerivedCompleteWithRespectTo_kernel_map (I := I)
        (u := ModuleCat.ofHom (Submodule.mkQ K)) hM
  have hK : (ModuleCat.of R K).IsDerivedCompleteWithRespectTo I := by
    have hK' : (ModuleCat.of R ((Submodule.mkQ K).ker)).IsDerivedCompleteWithRespectTo I := by
      exact
        (module_isDerivedCompleteWithRespectTo_iff_of_iso_local
          (I := I) (ModuleCat.kernelIsoKer (ModuleCat.ofHom (Submodule.mkQ K)))).1 hKker
    let eK : ModuleCat.of R ((Submodule.mkQ K).ker) ≅ ModuleCat.of R K :=
      (LinearEquiv.ofEq _ _ (Submodule.ker_mkQ K)).toModuleIso
    exact (module_isDerivedCompleteWithRespectTo_iff_of_iso_local (I := I) eK).1 hK'
  have hQcoker :
      (cokernel (ModuleCat.ofHom K.subtype)).IsDerivedCompleteWithRespectTo I := by
    exact
      moduleCat_isDerivedCompleteWithRespectTo_cokernel_of_mono_map (I := I)
        (u := ModuleCat.ofHom K.subtype) hK hM
  -- Proof comment: the quotient `M / K` is the cokernel of the inclusion `K ↪ M`.
  have hQ' :
      (ModuleCat.of R (M ⧸ (K.subtype : K →ₗ[R] M).range)).IsDerivedCompleteWithRespectTo I := by
    exact
      (module_isDerivedCompleteWithRespectTo_iff_of_iso_local
        (I := I) (ModuleCat.cokernelIsoRangeQuotient (ModuleCat.ofHom K.subtype))).1 hQcoker
  let eQ : ModuleCat.of R (M ⧸ (K.subtype : K →ₗ[R] M).range) ≅ ModuleCat.of R (M ⧸ K) :=
    (Submodule.quotEquivOfEq (K.subtype.range) K (Submodule.range_subtype K)).toModuleIso
  exact (module_isDerivedCompleteWithRespectTo_iff_of_iso_local (I := I) eQ).1 hQ'

/-- Helper for Lemma 15.94.11: module-level derived completeness is compatible with restriction of
scalars along an algebra map. -/
lemma moduleCat_isDerivedCompleteWithRespectTo_restrictScalars_single0_iff
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    (I : Ideal R) (M : ModuleCat S) :
    ((ModuleCat.restrictScalars (algebraMap R S)).obj M).IsDerivedCompleteWithRespectTo I ↔
      M.IsDerivedCompleteWithRespectTo (I.map (algebraMap R S)) := by
  sorry

/-- Helper for Lemma 15.94.11: quotienting the regular module by an ideal agrees with quotienting
by the corresponding submodule `J • ⊤`. -/
private noncomputable abbrev ideal_quotient_equiv_module_quotient_over_quotient
    {R : Type u} [CommRing R] (J : Ideal R) :
    (R ⧸ J) ≃ₗ[R ⧸ J] (R ⧸ ((J • (⊤ : Submodule R R)) : Submodule R R)) := by
  let eR : (R ⧸ J) ≃ₗ[R] (R ⧸ ((J • (⊤ : Submodule R R)) : Submodule R R)) :=
    (Submodule.quotEquivOfEq
      (((J • (⊤ : Submodule R R)) : Submodule R R))
      (J : Submodule R R)
      (by simpa using ideal_smul_top_eq_self (J := J))).symm
  refine
    { toFun := eR
      invFun := eR.symm
      left_inv := eR.left_inv
      right_inv := eR.right_inv
      map_add' := eR.map_add
      map_smul' := ?_ }
  intro c x
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- Helper for Lemma 15.94.11: adjoining the last generator splits the span into the truncated
span plus the corresponding principal ideal. -/
private lemma span_range_snoc_eq_sup_principalIdeal
    {R : Type u} [CommRing R] {r : ℕ} (fs : Fin r → R) (a : R) :
    Ideal.span (Set.range (Fin.snoc fs a)) = Ideal.span (Set.range fs) ⊔ principalIdeal a := by
  have hrange : Set.range (Fin.snoc fs a) = insert a (Set.range fs) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      refine Fin.lastCases ?_ ?_ i
      · simp
      · intro j
        right
        exact ⟨j, by simp⟩
    · intro hx
      rcases hx with rfl | hx
      · exact ⟨Fin.last r, by simp⟩
      · rcases hx with ⟨j, rfl⟩
        exact ⟨j.castSucc, by simp⟩
  -- Proof comment: once the range is rewritten as an insert, the canonical `Ideal.span_insert`
  -- identity gives the desired decomposition.
  rw [hrange, Ideal.span_insert, principalIdeal, sup_comm]

/-- Helper for Lemma 15.94.11: quotient rings inherit derived completeness with respect to the
image ideal. -/
private lemma derivedComplete_quotientRing_of_isDerivedComplete
    {R : Type u} [CommRing R] (I Q : Ideal R)
    (hR : (ModuleCat.of R R).IsDerivedCompleteWithRespectTo I) :
    (ModuleCat.of (R ⧸ Q) (R ⧸ Q)).IsDerivedCompleteWithRespectTo
      (Ideal.map (Ideal.Quotient.mk Q) I) := by
  have hquot :
      (ModuleCat.of R (R ⧸ Q • (⊤ : Submodule R R))).IsDerivedCompleteWithRespectTo I := by
    -- Proof comment: quotienting by `Q • R` preserves derived completeness by Lemma `15.92.7`.
    simpa using
      (moduleCat_isDerivedCompleteWithRespectTo_quotient_smul_top
        (R := R) (I := I) (J := Q) hR)
  let e :
      ModuleCat.of R (R ⧸ Q) ≅ ModuleCat.of R (R ⧸ Q • (⊤ : Submodule R R)) :=
    ((ideal_quotient_equiv_module_quotient_over_quotient (R := R) Q).restrictScalars R).toModuleIso
  have hrestrict :
      (ModuleCat.of R (R ⧸ Q)).IsDerivedCompleteWithRespectTo I :=
    (module_isDerivedCompleteWithRespectTo_iff_of_iso_local (I := I) e).2 hquot
  -- Proof comment: the restriction-of-scalars bridge turns the `R`-module statement into the
  -- quotient-ring statement over `R ⧸ Q`.
  exact
    (moduleCat_isDerivedCompleteWithRespectTo_restrictScalars_single0_iff
      (R := R) (S := R ⧸ Q) (I := I) (M := ModuleCat.of (R ⧸ Q) (R ⧸ Q))).mp hrestrict

/-- Helper for Lemma 15.94.11: after quotienting by `(a)^(t+1)`, a sufficiently high power of the
full snoc-generated ideal lands in the same power of the truncated ideal. -/
private lemma map_span_range_snoc_pow_le_truncated_pow
    {R : Type u} [CommRing R] {r : ℕ} (fs : Fin r → R) (a : R) (m t : ℕ) :
    let Q : Ideal R := principalPowerIdeal a (t + 1)
    let q : R →+* R ⧸ Q := Ideal.Quotient.mk Q
    let K : Ideal (R ⧸ Q) := Ideal.span (Set.range fun i : Fin r ↦ q (fs i))
    Ideal.map q ((Ideal.span (Set.range (Fin.snoc fs a))) ^ (m + t + 1)) ≤ K ^ m := by
  dsimp
  let Q : Ideal R := principalPowerIdeal a (t + 1)
  let q : R →+* R ⧸ Q := Ideal.Quotient.mk Q
  let K : Ideal (R ⧸ Q) := Ideal.span (Set.range fun i : Fin r ↦ q (fs i))
  have hmap_fs :
      Ideal.map q (Ideal.span (Set.range fs)) = K := by
    rw [Ideal.map_span]
    congr 1
    ext x
    constructor
    · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨fs i, ⟨i, rfl⟩, rfl⟩
  have hmap_a :
      Ideal.map q (principalIdeal a) = principalIdeal (q a) := by
    rw [principalIdeal, Ideal.map_span]
    congr 1
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact congrArg q hy
    · rintro rfl
      exact ⟨a, by simp, rfl⟩
  have hqpow_zero : (q a) ^ (t + 1) = 0 := by
    -- Proof comment: in the quotient by `(a)^(t+1)`, the class of `a` is nilpotent of order
    -- `t + 1`.
    apply Ideal.Quotient.eq_zero_iff_mem.mpr
    simpa [Q, principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow] using
      (Ideal.subset_span (by simp : a ^ (t + 1) ∈ ({a ^ (t + 1)} : Set R)))
  have hprincipal_pow :
      (principalIdeal (q a)) ^ (t + 1) = ⊥ := by
    simpa [principalIdeal, hqpow_zero] using Ideal.span_singleton_pow (q a) (t + 1)
  -- Proof comment: first map the snoc-generated ideal to `K ⊔ (q a)`, then apply the standard
  -- power estimate for a sum of ideals and kill the principal part by nilpotence.
  calc
    Ideal.map q ((Ideal.span (Set.range (Fin.snoc fs a))) ^ (m + t + 1))
        = (Ideal.map q (Ideal.span (Set.range (Fin.snoc fs a)))) ^ (m + t + 1) := by
            rw [Ideal.map_pow]
    _ = (K ⊔ principalIdeal (q a)) ^ (m + t + 1) := by
          rw [span_range_snoc_eq_sup_principalIdeal, Ideal.map_sup, hmap_fs, hmap_a]
    _ ≤ K ^ m ⊔ (principalIdeal (q a)) ^ (t + 1) := by
          simpa [Nat.add_assoc, add_comm, add_left_comm] using
            (Ideal.sup_pow_add_le_pow_sup_pow
              (I := K) (J := principalIdeal (q a)) (n := m) (m := t + 1))
    _ = K ^ m := by rw [hprincipal_pow, sup_bot_eq]

/-- Helper for Lemma 15.94.11: the image of the power intersection in the quotient lies in the
power intersection of the truncated ideal. -/
private lemma powerIntersection_map_le_truncated_powerIntersection
    {R : Type u} [CommRing R] {r : ℕ} (fs : Fin r → R) (a : R) (t : ℕ) :
    let Q : Ideal R := principalPowerIdeal a (t + 1)
    let q : R →+* R ⧸ Q := Ideal.Quotient.mk Q
    let K : Ideal (R ⧸ Q) := Ideal.span (Set.range fun i : Fin r ↦ q (fs i))
    Ideal.map q (J(Ideal.span (Set.range (Fin.snoc fs a)))) ≤ J(K) := by
  dsimp
  refine le_iInf ?_
  intro m
  -- Proof comment: `J(I)` lies in every power of `I`, so after quotienting it lies in the
  -- truncated power estimated in the previous lemma.
  calc
    Ideal.map (Ideal.Quotient.mk (principalPowerIdeal a (t + 1)))
        (J(Ideal.span (Set.range (Fin.snoc fs a))))
        ≤ Ideal.map (Ideal.Quotient.mk (principalPowerIdeal a (t + 1)))
            ((Ideal.span (Set.range (Fin.snoc fs a))) ^ (m + t + 1)) := by
              exact Ideal.map_mono
                (iInf_le (fun n : ℕ ↦ (Ideal.span (Set.range (Fin.snoc fs a))) ^ n) (m + t + 1))
    _ ≤ (Ideal.span
          (Set.range
            (fun i : Fin r ↦
              (Ideal.Quotient.mk (principalPowerIdeal a (t + 1))) (fs i)))) ^ m :=
      map_span_range_snoc_pow_le_truncated_pow (fs := fs) (a := a) (m := m) (t := t)

/-- Helper for Lemma 15.94.11: the chosen-generator version of the theorem follows by induction on
the number of generators, exactly along the source quotient-by-the-last-generator proof. -/
private theorem powerIntersection_pow_two_pow_eq_bot_of_ring_isDerivedComplete_span_range_aux
    {R : Type u} [CommRing R] :
    ∀ {r : ℕ} (f : Fin r → R),
      (ModuleCat.of R R).IsDerivedCompleteWithRespectTo (Ideal.span (Set.range f)) →
        J(Ideal.span (Set.range f)) ^ (2 ^ r) = ⊥
  | 0, f, hR => by
      have hbot : Ideal.span (Set.range f) = (⊥ : Ideal R) := by
        rw [Ideal.span_eq_bot]
        rintro x ⟨i, rfl⟩
        exact Fin.elim0 i
      -- Proof comment: with no generators the ideal is zero, so its power intersection is zero.
      rw [hbot]
      refine le_antisymm ?_ bot_le
      simpa using (iInf_le (fun n : ℕ ↦ ((⊥ : Ideal R) ^ n)) 1)
  | Nat.succ r, f, hR => by
      cases r with
      | zero =>
          let a : R := f 0
          have hrange : Set.range f = ({a} : Set R) := by
            ext x
            constructor
            · rintro ⟨i, rfl⟩
              fin_cases i
              simp [a]
            · rintro rfl
              exact ⟨0, by simp [a]⟩
          have hspan : Ideal.span (Set.range f) = principalIdeal a := by
            rw [hrange, principalIdeal]
          have hprincipal :
              (ModuleCat.of R R).IsDerivedCompleteWithRespectTo (principalIdeal a) := by
            simpa [hspan] using hR
          -- Proof comment: the one-generator case is exactly Lemma `15.94.9`.
          simpa [hspan, a] using
            principalPowerIntersection_sq_eq_bot_of_ring_isDerivedComplete (A := R) a hprincipal
      | succ n =>
          let fs : Fin (n + 1) → R := fun i ↦ f i.castSucc
          let a : R := f (Fin.last (n + 1))
          have hsnoc : f = Fin.snoc fs a := by
            ext i
            refine Fin.lastCases ?_ ?_ i
            · simp [fs, a]
            · intro j
              simp [fs, a]
          have hRsnoc :
              (ModuleCat.of R R).IsDerivedCompleteWithRespectTo
                (Ideal.span (Set.range (Fin.snoc fs a))) := by
            simpa [hsnoc] using hR
          have hprincipal :
              (ModuleCat.of R R).IsDerivedCompleteWithRespectTo (principalIdeal a) := by
            -- Proof comment: the last generator already lies in the full snoc-generated ideal.
            refine moduleCat_isDerivedCompleteWithRespectTo_of_le hRsnoc ?_
            rw [span_range_snoc_eq_sup_principalIdeal]
            exact le_sup_right
          have hstage :
              ∀ t : ℕ,
                J(Ideal.span (Set.range (Fin.snoc fs a))) ^ (2 ^ (n + 1)) ≤
                  principalPowerIdeal a (t + 1) := by
            intro t
            let Q : Ideal R := principalPowerIdeal a (t + 1)
            let q : R →+* R ⧸ Q := Ideal.Quotient.mk Q
            let K : Ideal (R ⧸ Q) := Ideal.span (Set.range fun i : Fin (n + 1) ↦ q (fs i))
            have hquot_full :
                (ModuleCat.of (R ⧸ Q) (R ⧸ Q)).IsDerivedCompleteWithRespectTo
                  (Ideal.map q (Ideal.span (Set.range (Fin.snoc fs a)))) :=
              derivedComplete_quotientRing_of_isDerivedComplete
                (I := Ideal.span (Set.range (Fin.snoc fs a))) (Q := Q) hRsnoc
            have hK_le :
                K ≤ Ideal.map q (Ideal.span (Set.range (Fin.snoc fs a))) := by
              -- Proof comment: the truncated family is a subfamily of the full snoc family.
              refine Ideal.span_le.2 ?_
              rintro _ ⟨i, rfl⟩
              exact Ideal.mem_map_of_mem q <|
                Ideal.subset_span ⟨i.castSucc, by simp⟩
            have hquot_trunc :
                (ModuleCat.of (R ⧸ Q) (R ⧸ Q)).IsDerivedCompleteWithRespectTo K := by
              exact moduleCat_isDerivedCompleteWithRespectTo_of_le hquot_full hK_le
            have hnil_quot :
                J(K) ^ (2 ^ (n + 1)) = ⊥ :=
              powerIntersection_pow_two_pow_eq_bot_of_ring_isDerivedComplete_span_range_aux
                (f := fun i : Fin (n + 1) ↦ q (fs i)) hquot_trunc
            have hmapJ :
                Ideal.map q (J(Ideal.span (Set.range (Fin.snoc fs a)))) ≤ J(K) :=
              powerIntersection_map_le_truncated_powerIntersection (fs := fs) (a := a) (t := t)
            have hmapPow :
                Ideal.map q
                    (J(Ideal.span (Set.range (Fin.snoc fs a))) ^ (2 ^ (n + 1))) = ⊥ := by
              rw [Ideal.map_pow]
              refine le_antisymm ?_ bot_le
              calc
                (Ideal.map q (J(Ideal.span (Set.range (Fin.snoc fs a))))) ^ (2 ^ (n + 1))
                    ≤ J(K) ^ (2 ^ (n + 1)) :=
                  Ideal.pow_right_mono hmapJ _
                _ = ⊥ := hnil_quot
            -- Proof comment: zero image in the quotient says the powered ideal is contained in
            -- the quotient kernel, namely `(a)^(t+1)`.
            simpa [Q, q] using
              (Ideal.map_eq_bot_iff_le_ker q).mp hmapPow
          have hinto_principal :
              J(Ideal.span (Set.range (Fin.snoc fs a))) ^ (2 ^ (n + 1)) ≤ J(principalIdeal a) := by
            -- Proof comment: the previous containment holds for every `t`, so the powered ideal
            -- lies in the full principal power intersection.
            intro x hx
            rw [Ideal.mem_iInf]
            intro m
            cases m with
            | zero =>
                simp
            | succ t =>
                exact hstage t hx
          have hsq :
              (J(Ideal.span (Set.range (Fin.snoc fs a))) ^ (2 ^ (n + 1))) ^ 2 = ⊥ := by
            -- Proof comment: once inside the principal power intersection, one more squaring step
            -- is killed by the principal case.
            refine le_antisymm ?_ bot_le
            calc
              (J(Ideal.span (Set.range (Fin.snoc fs a))) ^ (2 ^ (n + 1))) ^ 2
                  ≤ (J(principalIdeal a)) ^ 2 :=
                Ideal.pow_right_mono hinto_principal 2
              _ = ⊥ :=
                principalPowerIntersection_sq_eq_bot_of_ring_isDerivedComplete (A := R) a hprincipal
          have hexp : 2 ^ Nat.succ (Nat.succ n) = 2 ^ (n + 1) * 2 := by
            simp [pow_succ]
          -- Proof comment: rewrite the final exponent as the square of the inductive exponent.
          simpa [hsnoc, hexp, pow_mul] using hsq

-- Proof sketch: argue by induction on the number of generators. For one generator this is
-- Lemma `15.94.9`. For `I = (f₁, …, fᵣ)` with `r > 1`, choose generators, quotient by powers of
-- the last generator and use Lemma `15.92.6` to keep derived completeness after passage to
-- `A / fᵣ^t A`.
-- The image of `J(I) = ⋂ n, I^n` in each quotient lies in the corresponding intersection for
-- the ideal generated by `f₁, …, fᵣ₋₁`, so the induction hypothesis gives nilpotence of order
-- `2^(r - 1)` there. Intersecting the kernels over all `t` produces the principal-generator case
-- for `fᵣ`, whose square-zero conclusion yields `J(I)^(2^r) = 0`.
/-- Lemma 15.94.11: if a ring `A`, viewed as an `A`-module, is derived complete with respect to an
ideal `I`, then for `J(I) = ⋂ n, I^n` one has `J(I)^N = 0` with `N = 2^r` whenever `I` can be
generated by `r` elements. -/
theorem powerIntersection_pow_two_pow_eq_bot_of_ring_isDerivedComplete
    (I : Ideal A) (r : ℕ) (hgen : ∃ f : Fin r → A, Ideal.span (Set.range f) = I)
    (hA : (ModuleCat.of A A).IsDerivedCompleteWithRespectTo I) :
    J(I) ^ (2 ^ r) = ⊥ := by
  rcases hgen with ⟨f, rfl⟩
  -- Proof comment: reduce to the chosen-generator auxiliary theorem proved above by induction on
  -- the family length.
  exact
    powerIntersection_pow_two_pow_eq_bot_of_ring_isDerivedComplete_span_range_aux
      (f := f) hA

/-- The chosen-generator specialization of Lemma `15.94.11`. -/
theorem powerIntersection_pow_two_pow_eq_bot_of_ring_isDerivedComplete_of_span_range
    {r : ℕ} (f : Fin r → A)
    (hA : (ModuleCat.of A A).IsDerivedCompleteWithRespectTo (Ideal.span (Set.range f))) :
    J(Ideal.span (Set.range f)) ^ (2 ^ r) = ⊥ := by
  -- Proof comment: this is exactly the chosen-generator auxiliary theorem over `A`.
  exact
    powerIntersection_pow_two_pow_eq_bot_of_ring_isDerivedComplete_span_range_aux
      (f := f) hA

end
