/-- Helper for Lemma 15.125.8: under the local prevaluation hypothesis, a finitely presented
module is a retract of a finite direct sum of principal quotients. -/
theorem finitelyPresented_module_directSummand_finite_directSum_principal_quotients_of_maximal_localizations_preValuationRing
    {M : Type v} [AddCommGroup M] [Module R M] [Module.FinitePresentation R M]
    (hR : ∀ (m : Ideal R) (_ : m.IsMaximal), PreValuationRing (Localization.AtPrime m)) :
    ∃ (n : ℕ) (f : Fin n → R)
      (i : M →ₗ[R] (⨁ j : Fin n, R ⧸ principalIdeal (f j)))
      (s : (⨁ j : Fin n, R ⧸ principalIdeal (f j)) →ₗ[R] M),
      s.comp i = LinearMap.id := by
  classical
  have hsplit :
      ∃ (ι : Type (max u v)) (r : ι → R)
        (i : M →ₗ[R] (⨁ j : ι, R ⧸ principalIdeal (r j)))
        (s : (⨁ j : ι, R ⧸ principalIdeal (r j)) →ₗ[R] M),
        s.comp i = LinearMap.id := by
    refine
      (directSummand_iff_surjective_compRight_of_principalPure_shortExact
        (R := R) (P := M)).2 ?_
    intro S hS hi
    have hsurj_local :
        ∀ (m : Ideal R) [m.IsMaximal],
          Function.Surjective
            (LocalizedModule.map m.primeCompl
              (LinearMap.compRight R S.g.hom :
                (M →ₗ[R] S.X₂) →ₗ[R] (M →ₗ[R] S.X₃))) := by
      intro m hm
      exact atPrime_surjective_compRight_of_preValuationRing
        (R := R) (M := M) hS hi m (hR m hm)
    have hsurj :
        Function.Surjective
          (LinearMap.compRight R S.g.hom :
            (M →ₗ[R] S.X₂) →ₗ[R] (M →ₗ[R] S.X₃)) := by
      let hTfae :=
        surjective_localization_tfae
          (LinearMap.compRight R S.g.hom :
            (M →ₗ[R] S.X₂) →ₗ[R] (M →ₗ[R] S.X₃))
      exact (hTfae.out 2 0).mp hsurj_local
    exact hsurj
  obtain ⟨ι, r, i, s, hs⟩ := hsplit
  obtain ⟨n, g, i', s', hs'⟩ :=
    finite_retract_of_finite_module_directSum (R := R) (M := M)
      (A := fun j : ι ↦ R ⧸ principalIdeal (r j)) i s hs
  exact ⟨n, fun j ↦ r (g j), i', s', hs'⟩

/-- Helper for Lemma 15.125.8: every principal ideal of a domain is free as an `R`-module. -/
theorem principalIdeal_free_over_domain (g : R) :
    Module.Free R (principalIdeal g : Ideal R) := by
  classical
  by_cases hg : g = 0
  · -- If the generator vanishes, the principal ideal is the zero module.
    have hzero : (principalIdeal g : Ideal R) = ⊥ := by
      simpa [principalIdeal, hg]
    letI : Subsingleton (principalIdeal g : Ideal R) := by
      rw [hzero]
      infer_instance
    exact Module.Free.of_subsingleton (R := R) (N := (principalIdeal g : Ideal R))
  · let toPrincipal : R →ₗ[R] (principalIdeal g : Ideal R) :=
        LinearMap.codRestrict (principalIdeal g : Ideal R) (LinearMap.toSpanSingleton R R g)
          (fun a ↦ by
            -- Multiples of `g` land in the principal ideal `(g)` by construction.
            change a * g ∈ principalIdeal g
            simpa [principalIdeal, mul_comm] using
              (Ideal.mem_span_singleton.mpr ⟨a, by rw [mul_comm]⟩ :
                a * g ∈ Ideal.span ({g} : Set R)))
    have htoPrincipal_bijective : Function.Bijective toPrincipal := by
      constructor
      · intro a b hab
        -- Equality in the codomain reduces to equality of the underlying multiples of `g`.
        have hab' : a * g = b * g := by
          exact congrArg Subtype.val hab
        exact mul_right_cancel₀ hg hab'
      · intro y
        -- Every element of `(g)` is a multiple of `g`, so the codomain map is surjective.
        obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp y.2
        refine ⟨a, ?_⟩
        apply Subtype.ext
        change a * g = y.1
        simpa [toPrincipal, LinearMap.toSpanSingleton_apply, mul_comm] using ha.symm
    -- Transport the standard free structure on `R` across the explicit linear equivalence.
    exact Module.Free.of_equiv (LinearEquiv.ofBijective toPrincipal htoPrincipal_bijective)

/-- Helper for Lemma 15.125.8: a submodule of a free module over a Bézout domain is torsion-free,
hence flat. -/
theorem submodule_flat_of_free_over_isBezout
    {F : Type v} [AddCommGroup F] [Module R F] [Module.Free R F]
    (N : Submodule R F) :
    Module.Flat R N := by
  letI : Module.IsTorsionFree R F := by infer_instance
  letI : Module.IsTorsionFree R N :=
    (Submodule.subtype_injective N).moduleIsTorsionFree N.subtype fun r x ↦ rfl
  -- Over a Bézout domain, torsion-freeness is equivalent to flatness.
  rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, ← Submodule.isTorsionFree_iff_torsion_eq_bot]
  infer_instance

/-- Helper for Lemma 15.125.8: the zero-coordinate tail of a product submodule is exactly the
kernel of the second projection restricted to that submodule. -/
theorem prod_submodule_zero_tail_equiv_ker_snd
    {n : ℕ} (P : Submodule R ((Fin n → R) × R)) :
    Nonempty
      ((LinearMap.ker ((LinearMap.snd R (Fin n → R) R).comp P.subtype)) ≃ₗ[R]
        P.comap (LinearMap.inl R (Fin n → R) R)) := by
  refine ⟨
    { toFun := fun ⟨x, hx⟩ ↦
        ⟨x.1.1, by
          -- The kernel condition says the last coordinate vanishes, so the point already lies in
          -- the zero-tail owner.
          have hx0 : x.1.2 = 0 := by
            simpa [LinearMap.mem_ker, LinearMap.comp_apply] using hx
          have hxmem : (((x.1.1), 0) : (Fin n → R) × R) = x.1 := by
            ext <;> simp [hx0]
          exact hxmem ▸ x.2⟩
      invFun := fun x ↦
        ⟨⟨((x.1, 0) : (Fin n → R) × R), x.2⟩, by
          -- The reconstructed point visibly has zero second coordinate.
          change (LinearMap.snd R (Fin n → R) R) ((x.1, 0) : (Fin n → R) × R) = 0
          rfl⟩
      left_inv := by
        intro x
        rcases x with ⟨x, hx⟩
        -- Compare the underlying point in `P`; the last coordinate is zero by the kernel
        -- hypothesis.
        have hx0 : x.1.2 = 0 := by
          simpa [LinearMap.mem_ker, LinearMap.comp_apply] using hx
        apply Subtype.ext
        apply Subtype.ext
        ext
        · rfl
        · simpa [hx0]
      right_inv := by
        intro x
        -- The forward map forgets only the now-trivial zero coordinate.
        apply Subtype.ext
        rfl
      map_add' := by
        intro x y
        rfl
      map_smul' := by
        intro a x
        rfl }⟩

/-- Helper for Lemma 15.125.8: if the second-coordinate image of a product submodule is
projective, then the submodule splits as its zero-coordinate tail times that image. -/
theorem prod_submodule_split_of_projective_snd_range
    {n : ℕ} (P : Submodule R ((Fin n → R) × R))
    [Module.Projective R
      (LinearMap.range ((LinearMap.snd R (Fin n → R) R).comp P.subtype))] :
    Nonempty
      (P ≃ₗ[R]
        P.comap (LinearMap.inl R (Fin n → R) R) ×
          LinearMap.range ((LinearMap.snd R (Fin n → R) R).comp P.subtype)) := by
  let q : P →ₗ[R] R := (LinearMap.snd R (Fin n → R) R).comp P.subtype
  obtain ⟨s, hs⟩ :=
    Module.projective_lifting_property q.rangeRestrict
      (LinearMap.id : q.range →ₗ[R] q.range)
      q.surjective_rangeRestrict
  rcases prod_submodule_zero_tail_equiv_ker_snd (R := R) P with ⟨eZero⟩
  let eKer :
      LinearMap.ker q.rangeRestrict ≃ₗ[R] P.comap (LinearMap.inl R (Fin n → R) R) :=
    (LinearEquiv.ofEq _ _ (LinearMap.ker_rangeRestrict (f := q))).trans eZero
  let eSplit :
      ((LinearMap.ker q.rangeRestrict) × q.range) ≃ₗ[R] P :=
    kernel_prod_equiv_of_rightInverse q.rangeRestrict s hs
  refine ⟨eSplit.symm.trans (LinearEquiv.prodCongr eKer (LinearEquiv.refl R q.range))⟩

/-- Helper for Lemma 15.125.8: if the second-coordinate image is the principal ideal `(g)`, then
the product splitting lands in the principal ideal directly. -/
theorem prod_submodule_split_of_principal_snd_range
    {n : ℕ} (P : Submodule R ((Fin n → R) × R)) (g : R)
    (hP :
      LinearMap.range ((LinearMap.snd R (Fin n → R) R).comp P.subtype) =
        (principalIdeal g : Ideal R)) :
    Nonempty
      (P ≃ₗ[R]
        P.comap (LinearMap.inl R (Fin n → R) R) × (principalIdeal g : Ideal R)) := by
  let eRange :
      LinearMap.range ((LinearMap.snd R (Fin n → R) R).comp P.subtype) ≃ₗ[R]
        (principalIdeal g : Ideal R) :=
    LinearEquiv.ofEq _ _ hP
  letI : Module.Free R (principalIdeal g : Ideal R) :=
    principalIdeal_free_over_domain (R := R) g
  letI : Module.Projective R (principalIdeal g : Ideal R) := inferInstance
  letI :
      Module.Projective R
        (LinearMap.range ((LinearMap.snd R (Fin n → R) R).comp P.subtype)) :=
    Module.Projective.of_equiv eRange.symm
  rcases prod_submodule_split_of_projective_snd_range (R := R) P with ⟨eSplit⟩
  -- Transport the second factor across the identified principal ideal.
  exact ⟨eSplit.trans (LinearEquiv.prodCongr
    (LinearEquiv.refl R _) eRange)⟩

/-- Helper for Lemma 15.125.8: the last-coordinate image of a finite product submodule is a
principal ideal. -/
theorem prod_submodule_snd_range_eq_principalIdeal
    {n : ℕ} (P : Submodule R ((Fin n → R) × R)) [Module.Finite R P] :
    ∃ g : R,
      LinearMap.range ((LinearMap.snd R (Fin n → R) R).comp P.subtype) =
        (principalIdeal g : Ideal R) := by
  let sndP : P →ₗ[R] R := (LinearMap.snd R (Fin n → R) R).comp P.subtype
  let I : Ideal R := LinearMap.range sndP
  letI : Module.Finite R I :=
    Module.Finite.of_surjective sndP.rangeRestrict sndP.surjective_rangeRestrict
  letI : I.IsPrincipal := IsBezout.isPrincipal_of_FG I Submodule.FG.of_finite
  refine ⟨Submodule.IsPrincipal.generator I, ?_⟩
  -- Rewrite the finitely generated range ideal through its distinguished principal generator.
  change I = principalIdeal (Submodule.IsPrincipal.generator I)
  simpa [principalIdeal] using (Ideal.span_singleton_generator I).symm

/-- Helper for Lemma 15.125.8: `Fin (n + 1)`-indexed coordinate modules split off their last
coordinate as a product. -/
noncomputable def fin_succ_arrow_linearEquiv (n : ℕ) :
    (Fin (n + 1) → R) ≃ₗ[R] ((Fin n → R) × R) :=
  let e₁ : (Fin (n + 1) → R) ≃ₗ[R] (Option (Fin n) → R) :=
    LinearEquiv.piCongrLeft R (fun _ : Option (Fin n) ↦ R) (finSuccEquiv n)
  let e₂ : (Option (Fin n) → R) ≃ₗ[R] (R × (Fin n → R)) :=
    LinearEquiv.piOptionEquivProd R
  (e₁.trans e₂).trans (LinearEquiv.prodComm R R (Fin n → R))

/-- Helper for Lemma 15.125.8: every finite submodule of a finite coordinate free module over a
Bézout domain is free. -/
theorem finite_submodule_free_of_fin_over_isBezout :
    ∀ n : ℕ, ∀ P : Submodule R (Fin n → R), Module.Finite R P → Module.Free R P
  | 0, P, _ => by
      -- In rank zero the ambient module is subsingleton, so every submodule is trivially free.
      letI : Subsingleton P := by
        refine ⟨fun x y ↦ ?_⟩
        apply Subtype.ext
        funext i
        exact Fin.elim0 i
      exact Module.Free.of_subsingleton (R := R) (N := P)
  | n + 1, P, hP => by
      let eSucc : (Fin (n + 1) → R) ≃ₗ[R] ((Fin n → R) × R) :=
        fin_succ_arrow_linearEquiv (R := R) n
      let P' : Submodule R ((Fin n → R) × R) := P.map eSucc.toLinearMap
      let eP : P ≃ₗ[R] P' := P.equivMapOfInjective eSucc.toLinearMap eSucc.injective
      letI : Module.Finite R P' := Module.Finite.equiv eP
      obtain ⟨g, hRange⟩ := prod_submodule_snd_range_eq_principalIdeal (R := R) P'
      rcases prod_submodule_split_of_principal_snd_range (R := R) P' g hRange with ⟨eSplit⟩
      let tail : Submodule R (Fin n → R) := P'.comap (LinearMap.inl R (Fin n → R) R)
      letI : Module.Finite R (tail × (principalIdeal g : Ideal R)) :=
        Module.Finite.equiv eSplit
      letI : Module.Finite R tail :=
        Module.Finite.of_surjective
          (LinearMap.fst R tail (principalIdeal g : Ideal R))
          LinearMap.fst_surjective
      have htailFree : Module.Free R tail :=
        finite_submodule_free_of_fin_over_isBezout n tail inferInstance
      letI : Module.Free R (principalIdeal g : Ideal R) :=
        principalIdeal_free_over_domain (R := R) g
      letI : Module.Free R (tail × (principalIdeal g : Ideal R)) := inferInstance
      have hP'free : Module.Free R P' := Module.Free.of_equiv eSplit.symm
      exact Module.Free.of_equiv eP.symm

/-- Helper for Lemma 15.125.8: a finite submodule of a free module is contained in a finite free
submodule obtained by keeping only finitely many basis coordinates. -/
theorem finite_submodule_le_finite_free
    {F : Type v} [AddCommGroup F] [Module R F] [Module.Free R F]
    (N : Submodule R F) [Module.Finite R N] :
    ∃ L : Submodule R F, N ≤ L ∧ Module.Free R L ∧ Module.Finite R L := by
  classical
  let b : Module.Basis (Module.Free.ChooseBasisIndex R F) R F := Module.Free.chooseBasis R F
  let Ncoord : Submodule R ((Module.Free.ChooseBasisIndex R F) →₀ R) :=
    N.map b.repr.toLinearMap
  let eNcoord : N ≃ₗ[R] Ncoord := N.equivMapOfInjective b.repr.toLinearMap b.repr.injective
  letI : Module.Finite R Ncoord := Module.Finite.equiv eNcoord
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := Ncoord)
  let t : Finset (Module.Free.ChooseBasisIndex R F) :=
    Finset.univ.biUnion fun i ↦ ((s i : Ncoord) : (Module.Free.ChooseBasisIndex R F) →₀ R).support
  let Kcoord : Submodule R ((Module.Free.ChooseBasisIndex R F) →₀ R) :=
    Finsupp.supported R R (↑t : Set (Module.Free.ChooseBasisIndex R F))
  have hsKcoord :
      ∀ i,
        (((s i : Ncoord) : (Module.Free.ChooseBasisIndex R F) →₀ R)) ∈ Kcoord := by
    intro i
    change ↑(((s i : Ncoord) : (Module.Free.ChooseBasisIndex R F) →₀ R).support) ⊆
      (↑t : Set (Module.Free.ChooseBasisIndex R F))
    intro x hx
    change x ∈ t
    exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_univ _, hx⟩
  have htop : (⊤ : Submodule R Ncoord) ≤ Kcoord.comap Ncoord.subtype := by
    rw [← hs]
    refine Submodule.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    simpa using hsKcoord i
  have hNcoord_le : Ncoord ≤ Kcoord := (Submodule.comap_subtype_eq_top).mp (top_le_iff.mp htop)
  let L : Submodule R F := Kcoord.comap b.repr.toLinearMap
  have hN_le_L : N ≤ L := by
    -- Pull the coordinate containment back through the basis representation.
    simpa [L, Ncoord] using (Submodule.map_le_iff_le_comap.mp hNcoord_le)
  have hL_map : L.map b.repr.toLinearMap = Kcoord := by
    exact Submodule.map_comap_eq_of_surjective b.repr.surjective Kcoord
  let eL : Kcoord ≃ₗ[R] L := (LinearEquiv.ofSubmodules b.repr L Kcoord hL_map).symm
  have hKcoordFree : Module.Free R Kcoord := by
    exact Module.Free.of_equiv
      (Finsupp.supportedEquivFinsupp
        (R := R) (M := R) (↑t : Set (Module.Free.ChooseBasisIndex R F))).symm
  have hKcoordFinite : Module.Finite R Kcoord := by
    exact Module.Finite.equiv
      (Finsupp.supportedEquivFinsupp
        (R := R) (M := R) (↑t : Set (Module.Free.ChooseBasisIndex R F))).symm
  have hLFree : Module.Free R L := by
    letI : Module.Free R Kcoord := hKcoordFree
    exact Module.Free.of_equiv eL
  have hLFinite : Module.Finite R L := by
    letI : Module.Finite R Kcoord := hKcoordFinite
    exact Module.Finite.equiv eL
  exact ⟨L, hN_le_L, hLFree, hLFinite⟩

-- Proof sketch: reduce from an arbitrary free ambient module to a finite free one by choosing
-- finitely many basis vectors supporting a finite generating set of the submodule. Then argue by
-- induction on the rank, projecting to the last coordinate and using that a finitely generated
-- ideal in a Bézout domain is principal.
/-- Lemma 15.125.8 (1): every finite submodule of a free `R`-module is finite free. -/
theorem finite_submodule_free_of_free_over_isBezout
    {F : Type v} [AddCommGroup F] [Module R F] [Module.Free R F]
    (N : Submodule R F) [Module.Finite R N] :
    Module.Free R N := by
  obtain ⟨L, hN_le_L, hLFree, hLFinite⟩ :=
    finite_submodule_le_finite_free (R := R) (F := F) N
  let iNL : N →ₗ[R] L :=
    LinearMap.codRestrict L N.subtype fun x ↦ hN_le_L x.2
  have hiNL : Function.Injective iNL := by
    intro x y hxy
    have hxy' : ((iNL x : L) : F) = ((iNL y : L) : F) := by
      exact congrArg (fun z : L => (z : F)) hxy
    apply N.subtype_injective
    exact hxy'
  let eRange : N ≃ₗ[R] LinearMap.range iNL := LinearEquiv.ofInjective iNL hiNL
  letI : Module.Finite R (LinearMap.range iNL) := Module.Finite.equiv eRange
  letI : Module.Free R L := hLFree
  letI : Module.Finite R L := hLFinite
  obtain ⟨m, ⟨eL⟩⟩ := CategoryTheory.ShortComplex.finite_free_linearEquiv_fin (R := R) (F := L)
  let Nfin : Submodule R (Fin m → R) := (LinearMap.range iNL).map eL.toLinearMap
  let eNfin : LinearMap.range iNL ≃ₗ[R] Nfin :=
    (LinearMap.range iNL).equivMapOfInjective eL.toLinearMap eL.injective
  letI : Module.Finite R Nfin := Module.Finite.equiv (eRange.trans eNfin)
  have hNfinFree : Module.Free R Nfin :=
    finite_submodule_free_of_fin_over_isBezout m Nfin inferInstance
  have hRangeFree : Module.Free R (LinearMap.range iNL) :=
    Module.Free.of_equiv eNfin.symm
  exact Module.Free.of_equiv eRange.symm

section

variable {M : Type v} [AddCommGroup M] [Module R M] [Module.FinitePresentation R M]

/-- Helper for Lemma 15.125.8: the canonical map from the torsion submodule into `M`, followed by
the quotient map to `M / M_tors`, is zero. -/
theorem torsion_subtype_comp_mkQ_eq_zero :
    (Submodule.mkQ (Submodule.torsion R M)).comp
      (Submodule.subtype (Submodule.torsion R M)) = 0 := by
  -- The quotient map kills every element of the defining submodule.
  ext x
  change (Submodule.Quotient.mk x.1 : M ⧸ Submodule.torsion R M) = 0
  exact (Submodule.Quotient.mk_eq_zero (p := Submodule.torsion R M)).2 x.2

/-- Helper for Lemma 15.125.8: the standard short complex
`Submodule.torsion R M → M → M / Submodule.torsion R M` as a module-category object. -/
abbrev torsion_shortComplex : CategoryTheory.ShortComplex (ModuleCat R) :=
  CategoryTheory.ShortComplex.moduleCatMk
    (Submodule.subtype (Submodule.torsion R M))
    (Submodule.mkQ (Submodule.torsion R M))
    (torsion_subtype_comp_mkQ_eq_zero (R := R) (M := M))

/-- Helper for Lemma 15.125.8: the quotient by the torsion submodule is torsion-free. -/
theorem torsion_quotient_isTorsionFree :
    Module.IsTorsionFree R (M ⧸ Submodule.torsion R M) := by
  infer_instance

/-- Helper for Lemma 15.125.8: the quotient by the torsion submodule is flat over a Bézout
domain, because it is canonically torsion-free. -/
theorem torsion_quotient_flat_of_isBezout :
    Module.Flat R (M ⧸ Submodule.torsion R M) := by
  -- The quotient is torsion-free by the owner API from Lemma `15.22.2`, and over a Bézout domain
  -- torsion-free modules are flat.
  rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, ← Submodule.isTorsionFree_iff_torsion_eq_bot]
  exact torsion_quotient_isTorsionFree (R := R) (M := M)

/-- Helper for Lemma 15.125.8: a zero generator gives the zero principal ideal. -/
theorem principalIdeal_eq_bot_of_eq_zero {r : R} (hr : r = 0) :
    (principalIdeal r : Ideal R) = ⊥ := by
  -- The singleton span of zero is the bottom ideal.
  simpa [principalIdeal, hr]

/-- Helper for Lemma 15.125.8: if the generator is zero, then the corresponding principal quotient
is canonically isomorphic to `R`. -/
noncomputable def principal_quotient_linearEquiv_of_eq_zero {r : R} (hr : r = 0) :
    (R ⧸ principalIdeal r) ≃ₗ[R] R :=
  Submodule.quotEquivOfEqBot (principalIdeal r) (principalIdeal_eq_bot_of_eq_zero (R := R) hr)

/-- Helper for Lemma 15.125.8: a linear map from a torsion module to a torsion-free module
vanishes identically. -/
theorem linearMap_eq_zero_of_isTorsion_to_torsionFree
    {T : Type*} [AddCommGroup T] [Module R T]
    {N : Type*} [AddCommGroup N] [Module R N]
    (hT : Module.IsTorsion R T) [Module.IsTorsionFree R N] (g : T →ₗ[R] N) :
    g = 0 := by
  -- Every source element is killed by some nonzero scalar, so torsion-freeness forces its image
  -- to be zero as well.
  ext x
  obtain ⟨a, ha⟩ := hT (x := x)
  have hga' : g (a • x) = 0 := by
    simpa only [LinearMap.map_zero] using congrArg g ha
  have hga : (a : R) • (g x) = 0 := by
    calc
      (a : R) • (g x) = g ((a : R) • x) := by
        exact (g.map_smul (a : R) x).symm
      _ = 0 := hga'
  have ha0 : (a : R) ≠ 0 := by
    simpa using a.2
  exact (smul_eq_zero.mp hga).resolve_left ha0

/-- Helper for Lemma 15.125.8: if `f ≠ 0`, then the cyclic quotient `R ⧸ (f)` is torsion. -/
theorem principal_quotient_isTorsion_of_ne_zero
    {f : R} (hf : f ≠ 0) :
    Module.IsTorsion R (R ⧸ principalIdeal f) := by
  intro q
  refine Quotient.inductionOn' q ?_
  intro x
  refine ⟨⟨f, mem_nonZeroDivisors_iff_ne_zero.mpr hf⟩, ?_⟩
  -- Multiplication by the defining generator lands in the principal ideal, so the class vanishes.
  change (Submodule.Quotient.mk ((f : R) * x) : R ⧸ principalIdeal f) = 0
  refine (Submodule.Quotient.mk_eq_zero (p := principalIdeal f)).2 ?_
  simpa [principalIdeal, mul_comm] using
    (Ideal.mem_span_singleton.mpr ⟨x, by rw [mul_comm]⟩ : f * x ∈ Ideal.span ({f} : Set R))

/-- Helper for Lemma 15.125.8: a zero-generator coordinate of a retract from the torsion submodule
into a finite direct sum of principal quotients is already zero. -/
theorem torsion_coordinate_eq_zero_of_generator_eq_zero
    {n : ℕ} {f : Fin n → R}
    (i : Submodule.torsion R M →ₗ[R] (⨁ j : Fin n, R ⧸ principalIdeal (f j)))
    {j : Fin n} (hj : f j = 0) :
    DirectSum.component R (Fin n) (fun j => R ⧸ principalIdeal (f j)) j ∘ₗ i = 0 := by
  let e0 : (R ⧸ principalIdeal (f j)) ≃ₗ[R] R :=
    principal_quotient_linearEquiv_of_eq_zero (R := R) hj
  let g : Submodule.torsion R M →ₗ[R] R :=
    e0.toLinearMap.comp ((DirectSum.component R (Fin n) (fun j => R ⧸ principalIdeal (f j)) j).comp i)
  have hg : g = 0 :=
    linearMap_eq_zero_of_isTorsion_to_torsionFree (R := R)
      (hT := Submodule.torsion_isTorsion (R := R) (M := M)) g
  -- Transport the coordinate to `R`, where torsion-freeness of the domain ring itself kills it.
  ext x
  have hgx : g x = 0 := by
    simpa using congrArg (fun h : Submodule.torsion R M →ₗ[R] R => h x) hg
  exact e0.injective (by simpa [g, LinearMap.comp_apply] using hgx)

/-- Helper for Lemma 15.125.8: after quotienting by the torsion submodule, any cyclic summand with
nonzero generator contributes nothing. -/
theorem torsion_quotient_comp_lof_eq_zero_of_ne_zero
    {n : ℕ} {f : Fin n → R}
    (sM : (⨁ j : Fin n, R ⧸ principalIdeal (f j)) →ₗ[R] M)
    {j : Fin n} (hj : f j ≠ 0) :
    (Submodule.mkQ (Submodule.torsion R M)).comp
      (sM.comp (DirectSum.lof R (Fin n) (fun j => R ⧸ principalIdeal (f j)) j)) = 0 := by
  let gj : (R ⧸ principalIdeal (f j)) →ₗ[R] (M ⧸ Submodule.torsion R M) :=
    (Submodule.mkQ (Submodule.torsion R M)).comp
      (sM.comp (DirectSum.lof R (Fin n) (fun j => R ⧸ principalIdeal (f j)) j))
  have hgj : gj = 0 :=
    linearMap_eq_zero_of_isTorsion_to_torsionFree (R := R)
      (hT := principal_quotient_isTorsion_of_ne_zero (R := R) hj) gj
  simpa [gj, LinearMap.comp_assoc] using hgj

/-- Helper for Lemma 15.125.8: the torsion-free quotient is a retract of a finite free module. -/
-- Route correction: the old zero-generator pruning route has been removed from this file. The
-- ambient local-global theorem above is still the source-faithful route for the torsion summand,
-- but the torsion-free quotient itself can already be handled by the earlier chapter owner
-- `isTorsionFree_iff_exists_injective_to_fin_fun`: embed the finite torsion-free quotient into a
-- finite free module, identify it with its range, and apply part `(1)` to that finite submodule.
theorem torsion_quotient_retract_finite_free_of_finitelyPresented_over_isBezout :
    ∃ (m : ℕ)
      (i : (M ⧸ Submodule.torsion R M) →ₗ[R] (Fin m → R))
      (s : (Fin m → R) →ₗ[R] (M ⧸ Submodule.torsion R M)),
        s.comp i = LinearMap.id := by
  let Q := M ⧸ Submodule.torsion R M
  letI : Module.Finite R Q := inferInstance
  obtain ⟨n, i₀, hi₀⟩ :=
    (isTorsionFree_iff_exists_injective_to_fin_fun (R := R) (M := Q)).mp
      (torsion_quotient_isTorsionFree (R := R) (M := M))
  let eRange : Q ≃ₗ[R] LinearMap.range i₀ := LinearEquiv.ofInjective i₀ hi₀
  letI : Module.Finite R (LinearMap.range i₀) := Module.Finite.equiv eRange
  have hRangeFree : Module.Free R (LinearMap.range i₀) :=
    finite_submodule_free_of_free_over_isBezout
      (R := R) (F := Fin n → R) (N := LinearMap.range i₀)
  letI : Module.Free R (LinearMap.range i₀) := hRangeFree
  obtain ⟨m, ⟨eFin⟩⟩ :=
    CategoryTheory.ShortComplex.finite_free_linearEquiv_fin
      (R := R) (F := LinearMap.range i₀)
  refine
    ⟨m, eFin.toLinearMap.comp eRange.toLinearMap,
      eRange.symm.toLinearMap.comp eFin.symm.toLinearMap, ?_⟩
  -- The quotient identifies with its range in `Rⁿ`, and the finite-free range identifies with
  -- the standard model `R^m`; composing the two equivalences gives the required retract.
  ext x
  simp [LinearMap.comp_apply, eRange]

-- Proof sketch: apply Lemma `15.125.4` using Lemma `15.125.7` to realize `M` as a direct summand
-- of a finite direct sum of cyclic quotients. The quotient by `Submodule.torsion R M` is then a
-- finite torsion-free summand of a free module; the torsion-free input is the canonical owner
-- `Module.IsTorsionFree R (M ⧸ Submodule.torsion R M)` from Lemma `15.22.2`, so part (1) gives
-- freeness without introducing a local wrapper for torsion-freeness.
/-- Lemma 15.125.8 (2): for a finitely presented `R`-module `M`, the quotient by its torsion
submodule is a finite free `R`-module. -/
theorem torsion_quotient_free_of_finitelyPresented_over_isBezout :
    Module.Free R (M ⧸ Submodule.torsion R M) := by
  rcases torsion_quotient_retract_finite_free_of_finitelyPresented_over_isBezout
      (R := R) (M := M) with ⟨m, i, s, hs⟩
  have hleft : Function.LeftInverse s i := by
    intro x
    exact congrArg (fun h : (M ⧸ Submodule.torsion R M) →ₗ[R] (M ⧸ Submodule.torsion R M) ↦ h x) hs
  have hi : Function.Injective i := hleft.injective
  let eRange : (M ⧸ Submodule.torsion R M) ≃ₗ[R] LinearMap.range i :=
    LinearEquiv.ofInjective i hi
  letI : Module.Finite R (LinearMap.range i) := by
    -- The range is a quotient of the finite source module `(M / M_tors)`.
    exact Module.Finite.of_surjective i.rangeRestrict i.surjective_rangeRestrict
  have hRangeFree : Module.Free R (LinearMap.range i) :=
    finite_submodule_free_of_free_over_isBezout (R := R) (F := Fin m → R) (N := LinearMap.range i)
  -- Part `(1)` applies to the range inside the finite free ambient module `R^m`.
  exact Module.Free.of_equiv eRange.symm

-- Proof sketch: the quotient `M ⧸ Submodule.torsion R M` is free by part (2), hence projective.
-- Apply the canonical splitting of the short exact sequence
-- `0 → Submodule.torsion R M → M → M ⧸ Submodule.torsion R M → 0`; a section of the quotient map
-- then gives the source-facing product decomposition via the canonical split-exact owner
-- `lequivProdOfRightSplitExact`.
/-- Lemma 15.125.8 (3): a finitely presented `R`-module splits as the product of its torsion-free
quotient and its torsion submodule. -/
theorem nonempty_linearEquiv_quotient_torsion_prod_of_finitelyPresented_over_isBezout :
    Nonempty (M ≃ₗ[R] (M ⧸ Submodule.torsion R M) × Submodule.torsion R M) := by
  let S : CategoryTheory.ShortComplex (ModuleCat R) := torsion_shortComplex (M := M)
  have hS : S.ShortExact :=
    ModuleCat.shortComplex_shortExact S
      (by
        simpa using LinearMap.exact_subtype_mkQ (Submodule.torsion R M))
      (Submodule.torsion R M).injective_subtype
      (Submodule.mkQ_surjective _)
  letI : Module.Projective R S.X₃ := by
    change Module.Projective R (M ⧸ Submodule.torsion R M)
    letI : Module.Free R (M ⧸ Submodule.torsion R M) :=
      torsion_quotient_free_of_finitelyPresented_over_isBezout (R := R) (M := M)
    infer_instance
  -- Split the canonical short exact sequence and then swap the two product factors.
  rcases CategoryTheory.ShortComplex.shortExact_middle_linearEquiv_prod_nonempty
      (R := R) (S := S) hS with ⟨e⟩
  exact ⟨e.trans (LinearEquiv.prodComm R _ _)⟩

/-- Helper for Lemma 15.125.8: before pruning the zero generators, the torsion submodule is already
a retract of a finite direct sum of principal quotients. -/
theorem torsion_retract_finite_directSum_principal_quotients_of_finitelyPresented_over_isBezout :
    ∃ (n : ℕ) (f : Fin n → R)
      (i : Submodule.torsion R M →ₗ[R] (⨁ j : Fin n, R ⧸ principalIdeal (f j)))
      (s : (⨁ j : Fin n, R ⧸ principalIdeal (f j)) →ₗ[R] Submodule.torsion R M),
        s.comp i = LinearMap.id := by
  classical
  let hR : ∀ (m : Ideal R) (_ : m.IsMaximal), PreValuationRing (Localization.AtPrime m) := by
    intro m hm
    letI : m.IsPrime := hm.isPrime
    letI : ValuationRing (Localization.AtPrime m) :=
      valuationRing_localizationAtPrime_of_isBezout R m
    infer_instance
  obtain ⟨n, f, iM, sM, hsM⟩ :=
    finitelyPresented_module_directSummand_finite_directSum_principal_quotients_of_maximal_localizations_preValuationRing
      (R := R) (M := M) hR
  rcases nonempty_linearEquiv_quotient_torsion_prod_of_finitelyPresented_over_isBezout
      (R := R) (M := M) with ⟨e⟩
  let includeT : Submodule.torsion R M →ₗ[R] M :=
    e.symm.toLinearMap.comp
      (LinearMap.inr R (M ⧸ Submodule.torsion R M) (Submodule.torsion R M))
  let projectT : M →ₗ[R] Submodule.torsion R M :=
    (LinearMap.snd R (M ⧸ Submodule.torsion R M) (Submodule.torsion R M)).comp e.toLinearMap
  have hsM_eval : ∀ y : M, sM (iM y) = y := by
    intro y
    simpa using congrArg (fun g : M →ₗ[R] M => g y) hsM
  refine ⟨n, f, iM.comp includeT, projectT.comp sM, ?_⟩
  -- The ambient retraction restricts to the torsion factor through the split product decomposition.
  ext x
  simp [LinearMap.comp_apply, includeT, projectT, hsM_eval]

-- Proof sketch: again start from the direct-summand presentation of Lemma `15.125.4`. Applying
-- the torsion functor to the finite direct sum `⨁ i, R ⧸ (f i)` identifies `Submodule.torsion R M`
-- with a direct summand of that torsion module; because each `f i` is nonzero in a domain, the
-- whole direct sum is already torsion, so the torsion submodule is a direct summand of a module of
-- the required form. The public surface keeps the finite-index owner level, quantifying over a
-- finite type `ι` rather than choosing a specific encoding `Fin n`.
/-- Lemma 15.125.8 (4): the torsion submodule of a finitely presented `R`-module is a direct
summand of a finite direct sum of cyclic modules `R ⧸ (fᵢ)` with `fᵢ ≠ 0`. -/
theorem torsion_directSummand_finite_directSum_principal_quotients_of_finitelyPresented_over_isBezout :
    ∃ (ι : Type v) (_ : Fintype ι) (f : ι → R),
      (∀ i, f i ≠ 0) ∧
        ∃ (i : Submodule.torsion R M →ₗ[R] (⨁ j : ι, R ⧸ principalIdeal (f j)))
          (s : (⨁ j : ι, R ⧸ principalIdeal (f j)) →ₗ[R] Submodule.torsion R M),
            s.comp i = LinearMap.id := by
  classical
  obtain ⟨n, f, i, s, hs⟩ :=
    torsion_retract_finite_directSum_principal_quotients_of_finitelyPresented_over_isBezout
      (R := R) (M := M)
  let ι := ULift.{v, 0} {j : Fin n // f j ≠ 0}
  let allEquiv :
      (⨁ j : Fin n, R ⧸ principalIdeal (f j)) ≃ₗ[R] (∀ j : Fin n, R ⧸ principalIdeal (f j)) :=
    DirectSum.linearEquivFunOnFintype R (Fin n) (fun j => R ⧸ principalIdeal (f j))
  let nonzeroEquiv :
      (⨁ j : ι, R ⧸ principalIdeal (f j.down.1)) ≃ₗ[R] (∀ j : ι, R ⧸ principalIdeal (f j.down.1)) :=
    DirectSum.linearEquivFunOnFintype R ι (fun j => R ⧸ principalIdeal (f j.down.1))
  let restrictFun :
      (∀ j : Fin n, R ⧸ principalIdeal (f j)) →ₗ[R] (∀ j : ι, R ⧸ principalIdeal (f j.down.1)) :=
    { toFun := fun g j => g j.down.1
      map_add' := by
        intro g h
        rfl
      map_smul' := by
        intro a g
        rfl }
  let extendFun :
      (∀ j : ι, R ⧸ principalIdeal (f j.down.1)) →ₗ[R] (∀ j : Fin n, R ⧸ principalIdeal (f j)) :=
    { toFun := fun g j => if hj : f j = 0 then 0 else g ⟨⟨j, hj⟩⟩
      map_add' := by
        intro g h
        ext j
        by_cases hj : f j = 0
        · simp [hj]
        · simp [hj]
      map_smul' := by
        intro a g
        ext j
        by_cases hj : f j = 0
        · simp [hj]
        · simp [hj] }
  let pruneMap :
      (⨁ j : Fin n, R ⧸ principalIdeal (f j)) →ₗ[R] (⨁ j : ι, R ⧸ principalIdeal (f j.down.1)) :=
    nonzeroEquiv.symm.toLinearMap.comp (restrictFun.comp allEquiv.toLinearMap)
  let includeMap :
      (⨁ j : ι, R ⧸ principalIdeal (f j.down.1)) →ₗ[R] (⨁ j : Fin n, R ⧸ principalIdeal (f j)) :=
    allEquiv.symm.toLinearMap.comp (extendFun.comp nonzeroEquiv.toLinearMap)
  have hinclude_prune_i : (includeMap.comp pruneMap).comp i = i := by
    -- Route correction: prune zero-generator coordinates only after converting the direct sums to
    -- finite products, where restriction and extension-by-zero are literal function operations.
    apply DFunLike.ext
    intro x
    apply allEquiv.injective
    ext j
    change extendFun (restrictFun (allEquiv (i x))) j = allEquiv (i x) j
    by_cases hj : f j ≠ 0
    · have hj0 : ¬f j = 0 := by
        simpa using hj
      simp [includeMap, pruneMap, allEquiv, nonzeroEquiv, restrictFun, extendFun, hj, hj0]
    · have hcoord :
          DirectSum.component R (Fin n) (fun j => R ⧸ principalIdeal (f j)) j (i x) = 0 := by
        have hzero :=
          congrArg
            (fun g :
              Submodule.torsion R M →ₗ[R] R ⧸ principalIdeal (f j) => g x)
            (torsion_coordinate_eq_zero_of_generator_eq_zero
              (R := R) (M := M) (i := i) (j := j) (by simpa using hj))
        simpa using hzero
      have hj0 : f j = 0 := by
        simpa using hj
      have hcoord' : allEquiv (i x) j = 0 := by
        simpa [allEquiv] using hcoord
      simp [restrictFun, extendFun, hj0, hcoord']
  let i' : Submodule.torsion R M →ₗ[R] (⨁ j : ι, R ⧸ principalIdeal (f j.down.1)) :=
    pruneMap.comp i
  let s' : (⨁ j : ι, R ⧸ principalIdeal (f j.down.1)) →ₗ[R] Submodule.torsion R M :=
    s.comp includeMap
  have hs' : s'.comp i' = LinearMap.id := by
    calc
      s'.comp i' = s.comp ((includeMap.comp pruneMap).comp i) := by
        simp [s', i', LinearMap.comp_assoc]
      _ = s.comp i := by
        rw [hinclude_prune_i]
      _ = LinearMap.id := hs
  refine ⟨ι, inferInstance, fun j => f j.down.1, fun j => j.down.2, i', s', hs'⟩

end

end
