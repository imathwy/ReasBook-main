/-- Helper for Lemma 15.8.7: forming determinantal ideals commutes with coefficientwise reduction
to the prime residue field. -/
private theorem matrix_minorIdeal_map_eq_residueField
    (p : Ideal R) [p.IsPrime] {ι κ : Type*} (t : ℕ) (A : Matrix ι κ R) :
    Ideal.map (algebraMap R p.ResidueField) (Matrix.minorIdeal t A) =
      Matrix.minorIdeal t (A.map (algebraMap R p.ResidueField)) := by
  classical
  -- Proof comment: unfold the determinantal ideal and move the residue-field map across each
  -- determinant generator separately.
  unfold Matrix.minorIdeal
  rw [Ideal.map_span]
  congr 1
  ext y
  constructor
  · rintro ⟨x, ⟨q, rfl⟩, rfl⟩
    refine ⟨q, ?_⟩
    have hsub :
        (algebraMap R p.ResidueField).mapMatrix (A.submatrix q.1 q.2) =
          (A.map (algebraMap R p.ResidueField)).submatrix q.1 q.2 := by
      ext i j
      rfl
    simpa [hsub] using
      (RingHom.map_det (algebraMap R p.ResidueField) (A.submatrix q.1 q.2)).symm
  · rintro ⟨q, hq⟩
    refine ⟨(A.submatrix q.1 q.2).det, ?_, ?_⟩
    · exact ⟨q, rfl⟩
    · have hsub :
          (algebraMap R p.ResidueField).mapMatrix (A.submatrix q.1 q.2) =
            (A.map (algebraMap R p.ResidueField)).submatrix q.1 q.2 := by
        ext i j
        rfl
      calc
        algebraMap R p.ResidueField (A.submatrix q.1 q.2).det =
            ((A.map (algebraMap R p.ResidueField)).submatrix q.1 q.2).det := by
              simpa [hsub] using
                RingHom.map_det (algebraMap R p.ResidueField) (A.submatrix q.1 q.2)
        _ = y := hq

/-- Helper for Lemma 15.8.7: tensoring the standard free module `R^n` with the prime residue
field identifies it with `κ(p)^n`. -/
private noncomputable abbrev residueField_tensor_free_equiv
    (p : Ideal R) [p.IsPrime] (n : ℕ) :
    p.ResidueField ⊗[R] (Fin n → R) ≃ₗ[p.ResidueField] (Fin n → p.ResidueField) :=
  TensorProduct.piScalarRight R p.ResidueField p.ResidueField (Fin n)

/-- Helper for Lemma 15.8.7: a surjection `R^n → M` induces the standard residue-field
presentation `κ(p)^n → κ(p) ⊗ M`. -/
private noncomputable abbrev residueField_presentation
    {n : ℕ} (p : Ideal R) [p.IsPrime]
    (π : (Fin n → R) →ₗ[R] M) :
    (Fin n → p.ResidueField) →ₗ[p.ResidueField] p.ResidueField ⊗[R] M :=
  (π.baseChange p.ResidueField).comp
    ((residueField_tensor_free_equiv (R := R) (p := p) n).symm.toLinearMap)

/-- Helper for Lemma 15.8.7: the residue-field presentation obtained from a surjection remains
surjective after tensoring. -/
private theorem residueField_presentation_surjective
    {n : ℕ} (p : Ideal R) [p.IsPrime]
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π) :
    Function.Surjective (residueField_presentation (R := R) (M := M) p π) := by
  -- Proof comment: tensoring preserves surjections, and the free-module tensor model is the
  -- canonical `κ(p)^n` linear equivalence.
  exact
    (by
      simpa [residueField_presentation, LinearMap.baseChange_eq_ltensor] using
        (LinearMap.lTensor_surjective p.ResidueField hπ).comp
          (residueField_tensor_free_equiv (R := R) (p := p) n).symm.surjective)

/-- Helper for Lemma 15.8.7: after base change to the prime residue field, the `k`th Fitting
ideal is the image of the original `k`th Fitting ideal. -/
private theorem fittingIdeal_residueField_baseChange
    (k : ℕ) (p : Ideal R) [p.IsPrime] :
    Fit[p.ResidueField]_(k)(p.ResidueField ⊗[R] M) =
      Ideal.map (algebraMap R p.ResidueField) (Fit[R]_(k)(M)) := by
  -- Proof comment: the deterministic transport pieces are now isolated. The remaining blocker is
  -- the finite exactness step that extracts a finite spanning family in
  -- `LinearMap.ker (residueField_presentation p π)` from the exact sequence
  -- `κ(p) ⊗ ker π → κ(p)^n → κ(p) ⊗ M → 0`, so that
  -- `presentationFittingIdeal` on the residue-field side can be compared with the image of the
  -- original presentation ideal via `matrix_minorIdeal_map_eq_residueField`.
  sorry

/-- Helper for Lemma 15.8.7: noncontainment of the `k`th Fitting ideal in a prime ideal is
equivalent to the residue-field fiber having dimension at most `k`. -/
private theorem fittingIdeal_not_le_prime_iff_finrank_le_residueField
    (k : ℕ) (p : Ideal R) [p.IsPrime] :
    (¬ Fit[R]_(k)(M) ≤ p) ↔ Module.finrank p.ResidueField (p.ResidueField ⊗[R] M) ≤ k := by
  have hmap_bot :
      Ideal.map (algebraMap R p.ResidueField) (Fit[R]_(k)(M)) = (⊥ : Ideal p.ResidueField) ↔
        Fit[R]_(k)(M) ≤ p := by
    -- The residue-field quotient kills exactly the prime ideal `p`.
    rw [Ideal.map_eq_bot_iff_le_ker]
    have hker : RingHom.ker (algebraMap R p.ResidueField) = p := by
      ext x
      simp
    simpa [hker]
  -- Base-change the Fitting ideal to the residue field and then invoke the field computation.
  calc
    (¬ Fit[R]_(k)(M) ≤ p)
        ↔ ¬ Ideal.map (algebraMap R p.ResidueField) (Fit[R]_(k)(M)) ≤
            (⊥ : Ideal p.ResidueField) := by
          rw [show Ideal.map (algebraMap R p.ResidueField) (Fit[R]_(k)(M)) ≤
              (⊥ : Ideal p.ResidueField) ↔
              Ideal.map (algebraMap R p.ResidueField) (Fit[R]_(k)(M)) =
                (⊥ : Ideal p.ResidueField) by simp]
          simpa [hmap_bot]
    _ ↔ ¬ Fit[p.ResidueField]_(k)(p.ResidueField ⊗[R] M) ≤ (⊥ : Ideal p.ResidueField) := by
          rw [fittingIdeal_residueField_baseChange (R := R) (M := M) k p]
    _ ↔ Module.finrank p.ResidueField (p.ResidueField ⊗[R] M) ≤ k := by
          exact
            fittingIdeal_not_le_bot_iff_finrank_le_of_field
              (K := p.ResidueField) (V := p.ResidueField ⊗[R] M) k

/-- Helper for Lemma 15.8.7: if a localized submodule is all of a localization, then the
localization of the corresponding quotient module is trivial. -/
private theorem localized_quotient_subsingleton_of_localized_eq_top
    {A : Type*} [CommRing A]
    {N : Type*} [AddCommGroup N] [Module A N]
    (S : Submonoid A) (P : Submodule A N)
    (hlocalized : Submodule.localized (p := S) P = ⊤) :
    Subsingleton (LocalizedModule S (N ⧸ P)) := by
  let e :
      (LocalizedModule S N ⧸ Submodule.localized (p := S) P) ≃ₗ[Localization S]
        LocalizedModule S (N ⧸ P) :=
    localizedQuotientEquiv S P
  have hquot :
      Subsingleton (LocalizedModule S N ⧸ Submodule.localized (p := S) P) := by
    -- Quotienting by the localized whole submodule leaves only the zero quotient.
    rw [hlocalized]
    infer_instance
  letI : Subsingleton (LocalizedModule S N ⧸ Submodule.localized (p := S) P) := hquot
  -- Transport the quotient-by-`⊤` subsingleton structure across `localizedQuotientEquiv`.
  exact e.symm.toEquiv.subsingleton

/-- Helper for Lemma 15.8.7: if a finite module vanishes after localizing at a prime, then some
basic open neighborhood of that prime already kills the away-localized module. -/
private theorem exists_localizationAway_subsingleton_of_finite_localizedAtPrime_subsingleton
    {A : Type*} [CommRing A] (q : PrimeSpectrum A)
    {N : Type*} [AddCommGroup N] [Module A N] [Module.Finite A N]
    (hsub : Subsingleton (LocalizedModule.AtPrime q.asIdeal N)) :
    ∃ s : A, s ∉ q.asIdeal ∧ Subsingleton (LocalizedModule.Away s N) := by
  classical
  rcases Module.Finite.exists_fin' A N with ⟨n, π, hπ⟩
  let kill : Fin n → A := fun j ↦
    Classical.choose <|
      (LocalizedModule.subsingleton_iff (S := q.asIdeal.primeCompl) (M := N)).mp
        hsub (π (Pi.single j (1 : A)))
  have hkill_mem : ∀ j : Fin n, kill j ∉ q.asIdeal := by
    -- Each chosen annihilator lies in the prime complement by construction.
    intro j
    exact (Classical.choose_spec <|
      (LocalizedModule.subsingleton_iff (S := q.asIdeal.primeCompl) (M := N)).mp
        hsub (π (Pi.single j (1 : A)))).1
  have hkill_zero : ∀ j : Fin n, kill j • π (Pi.single j (1 : A)) = 0 := by
    -- The same witnesses kill the chosen finite generating family.
    intro j
    exact (Classical.choose_spec <|
      (LocalizedModule.subsingleton_iff (S := q.asIdeal.primeCompl) (M := N)).mp
        hsub (π (Pi.single j (1 : A)))).2
  let s' : q.asIdeal.primeCompl := ∏ j, ⟨kill j, hkill_mem j⟩
  have hs_gen : ∀ j : Fin n, s'.1 • π (Pi.single j (1 : A)) = 0 := by
    intro j
    have hs_split :
        ((Finset.univ.erase j).prod fun i ↦ kill i) * kill j = s'.1 := by
      simpa [s'] using
        (Finset.prod_erase_mul (s := Finset.univ) (f := fun i : Fin n ↦ kill i)
          (a := j) (by simp : j ∈ (Finset.univ : Finset (Fin n))))
    -- Multiplying by the full product still kills the `j`th generator because one factor does.
    calc
      s'.1 • π (Pi.single j (1 : A)) =
          ((Finset.univ.erase j).prod fun i ↦ kill i) •
            (kill j • π (Pi.single j (1 : A))) := by
              rw [← hs_split, mul_smul]
      _ = 0 := by
            simp [hkill_zero j]
  have hs_ann : s'.1 ∈ Module.annihilator A N := by
    rw [Module.mem_annihilator]
    intro x
    rcases hπ x with ⟨y, rfl⟩
    have hy :
        (∑ j, y j • (Pi.single j (1 : A) : Fin n → A)) = y := by
      ext j
      simpa [Pi.single_apply, mul_comm] using
        (Fintype.sum_pi_single (i := j) (f := y))
    -- Surjectivity reduces the annihilator computation to the chosen finite generators after
    -- expanding an arbitrary vector in the standard basis of `A^n`.
    rw [← hy]
    calc
      s'.1 • π (∑ j, y j • (Pi.single j (1 : A) : Fin n → A)) =
          s'.1 • ∑ j, y j • π (Pi.single j (1 : A) : Fin n → A) := by
            simp [map_sum, map_smul]
      _ = ∑ j, s'.1 • (y j • π (Pi.single j (1 : A) : Fin n → A)) := by
            simpa using
              (Finset.smul_sum
                (s := Finset.univ)
                (r := s'.1)
                (f := fun j : Fin n ↦ y j • π (Pi.single j (1 : A) : Fin n → A)))
      _ = ∑ j, y j • (s'.1 • π (Pi.single j (1 : A) : Fin n → A)) := by
            refine Finset.sum_congr rfl ?_
            intro j hj
            rw [smul_smul, mul_comm, smul_smul]
      _ = 0 := by
            refine Finset.sum_eq_zero ?_
            intro j hj
            rw [hs_gen j, smul_zero]
  refine ⟨s'.1, s'.2, ?_⟩
  rw [LocalizedModule.subsingleton_iff (S := Submonoid.powers s'.1) (M := N)]
  intro x
  refine ⟨s'.1, ⟨1, by simp⟩, ?_⟩
  exact (Module.mem_annihilator.mp hs_ann) x

/-- Helper for Lemma 15.8.7: generators of the prime localization descend to generators on some
basic open neighborhood of the prime. -/
private theorem exists_away_generators_of_atPrime_generators
    {k : ℕ} (p : Ideal R) [p.IsPrime]
    (v : Fin k → LocalizedModule.AtPrime p M)
    (hv : Submodule.span (Localization.AtPrime p) (Set.range v) = ⊤) :
    ∃ f : R, f ∉ p ∧ ∃ w : Fin k → LocalizedModule.Away f M,
      Submodule.span (Localization.Away f) (Set.range w) = ⊤ := by
  classical
  let locp : M →ₗ[R] LocalizedModule.AtPrime p M :=
    LocalizedModule.mkLinearMap p.primeCompl M
  let rep : Fin k → M × p.primeCompl := fun i ↦
    Classical.choose (IsLocalizedModule.mk'_surjective p.primeCompl locp (v i))
  let num : Fin k → M := fun i ↦ (rep i).1
  let den : Fin k → p.primeCompl := fun i ↦ (rep i).2
  have hrepr : ∀ i : Fin k, IsLocalizedModule.mk' locp (num i) (den i) = v i := by
    -- Choose one numerator/denominator representation for each localized generator.
    intro i
    exact Classical.choose_spec (IsLocalizedModule.mk'_surjective p.primeCompl locp (v i))
  let P : Submodule R M := Submodule.span R (Set.range num)
  have hv_mem : ∀ i : Fin k, v i ∈ Submodule.localized (p := p.primeCompl) P := by
    -- Each chosen localized generator comes from a numerator already lying in the source span.
    intro i
    rw [Submodule.mem_localized']
    exact ⟨num i, Submodule.subset_span ⟨i, rfl⟩, den i, hrepr i⟩
  have hPlocal_top : Submodule.localized (p := p.primeCompl) P = ⊤ := by
    have hspan_le :
        Submodule.span (Localization.AtPrime p) (Set.range v) ≤
          Submodule.localized (p := p.primeCompl) P := by
      refine Submodule.span_le.2 ?_
      rintro _ ⟨i, rfl⟩
      exact hv_mem i
    -- Once the chosen localized generators lie in the localized source span, that span is all of
    -- `M_p` because the generators already span `M_p`.
    exact top_unique <| by
      simpa [hv] using hspan_le
  have hquot_sub :
      Subsingleton (LocalizedModule.AtPrime p (M ⧸ P)) :=
    localized_quotient_subsingleton_of_localized_eq_top
      (S := p.primeCompl) P hPlocal_top
  let q : PrimeSpectrum R := ⟨p, inferInstance⟩
  obtain ⟨f, hfp, haway_sub⟩ :=
    exists_localizationAway_subsingleton_of_finite_localizedAtPrime_subsingleton
      (q := q) (N := M ⧸ P) hquot_sub
  let w : Fin k → LocalizedModule.Away f M := fun i ↦
    LocalizedModule.mkLinearMap (Submonoid.powers f) M (num i)
  have hPaway_top : Submodule.localized (p := Submonoid.powers f) P = ⊤ := by
    let e :
        (LocalizedModule.Away f M ⧸ Submodule.localized (p := Submonoid.powers f) P) ≃ₗ[
          Localization.Away f] LocalizedModule.Away f (M ⧸ P) :=
      localizedQuotientEquiv (Submonoid.powers f) P
    have hquot :
        Subsingleton
          (LocalizedModule.Away f M ⧸ Submodule.localized (p := Submonoid.powers f) P) := by
      letI : Subsingleton (LocalizedModule.Away f (M ⧸ P)) := haway_sub
      exact e.toEquiv.subsingleton
    letI :
        Subsingleton
          (LocalizedModule.Away f M ⧸ Submodule.localized (p := Submonoid.powers f) P) := hquot
    -- A quotient module is subsingleton exactly when the localized submodule is all of the
    -- localization.
    exact top_unique fun y _ ↦ by
      have hyzero :
          Submodule.mkQ (Submodule.localized (p := Submonoid.powers f) P) y = 0 :=
        Subsingleton.elim _ _
      simpa using hyzero
  have hspan_away :
      Submodule.span (Localization.Away f) (Set.range w) = ⊤ := by
    have himage :
        ((fun a ↦ LocalizedModule.mk a 1) '' Set.range num : Set (LocalizedModule.Away f M)) =
          Set.range w := by
      ext y
      constructor
      · rintro ⟨a, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩
        exact ⟨num i, ⟨i, rfl⟩, rfl⟩
    -- Rewrite the localized span of the chosen numerators as the span of their denominator-`1`
    -- away-local images.
    have hspan_image :
        Submodule.span (Localization.Away f)
          (((fun a ↦ LocalizedModule.mk a 1) '' Set.range num : Set (LocalizedModule.Away f M))) =
            ⊤ := by
      simpa [P, Submodule.localized'_span] using hPaway_top
    simpa [w, himage] using hspan_image
  exact ⟨f, hfp, w, hspan_away⟩

-- Proof sketch: use `fittingIdeal_baseChange` from Lemma `15.8.4` to reduce clause (1) to
-- the case over the residue field `κ(p)`, where Example `15.8.5` computes the relevant Fitting
-- ideal of a finite-dimensional vector space. The equivalence of clauses (2), (3), and (4) is the
-- usual local-generation criterion via Nakayama's lemma, passing between `M ⊗[R] κ(p)`,
-- `M_p`, and an open neighborhood `D(f)` of `p`.
/-- Lemma 15.8.7: for a finite `R`-module `M`, a nonnegative integer `k`, and a prime ideal `p`,
the following are equivalent: the `k`th Fitting ideal of `M` is not contained in `p`; the
residue-field fiber `M ⊗[R] κ(p)` has dimension at most `k`; the localization `M_p` is generated
by `k` elements over `R_p`; and some localization `M_f` with `f ∉ p` is generated by `k`
elements over `R_f`. -/
theorem fittingIdeal_not_le_prime_tfae_residueField_finrank_and_local_generators
    (k : ℕ) (p : Ideal R) [p.IsPrime] :
    List.TFAE
      [ ¬ Fit[R]_(k)(M) ≤ p
      , Module.finrank p.ResidueField (p.ResidueField ⊗[R] M) ≤ k
      , ∃ v : Fin k → LocalizedModule.AtPrime p M,
          Submodule.span (Localization.AtPrime p) (Set.range v) = ⊤
      , ∃ f : R, f ∉ p ∧ ∃ v : Fin k → LocalizedModule.Away f M,
          Submodule.span (Localization.Away f) (Set.range v) = ⊤
      ] := by
  -- Route correction: the source-faithful proof should reduce `(1) ↔ (2)` by base change and only
  -- then run the Nakayama/localization argument for `(2)`, `(3)`, and `(4)`.
  tfae_have 1 ↔ 2 := by
    -- Proof comment: clause `(1)` is already reduced to the residue-field finrank condition once
    -- the local base-change identity for Fitting ideals is available.
    exact fittingIdeal_not_le_prime_iff_finrank_le_residueField (R := R) (M := M) k p
  tfae_have 2 ↔ 3 := by
    -- TODO for Lemma 15.8.7: identify `κ(p) ⊗[R] M` with the closed fiber of `M_p`, lift residue
    -- generators through the quotient map, and apply the local Nakayama lemma embodied in
    -- `span_eq_top_of_residue_quotient_span_eq_top`.
    exact residueField_finrank_le_iff_exists_atPrime_generators (R := R) (M := M) k p
  tfae_have 3 → 4 := by
    intro h₃
    rcases h₃ with ⟨v, hv⟩
    exact exists_away_generators_of_atPrime_generators (R := R) (M := M) p v hv
  tfae_have 4 → 3 := by
    intro h₄
    rcases h₄ with ⟨f, hf, v, hv⟩
    -- Proof comment: refine the away-local spanning family further to the prime localization via
    -- the canonical comparison `M_f → M_p`.
    exact atPrime_generators_of_away_generators (R := R) (M := M) p hf v hv
  tfae_finish

end
