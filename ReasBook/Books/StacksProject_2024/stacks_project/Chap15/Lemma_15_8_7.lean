section

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- Helper for Lemma 15.8.7: over a field, the `k`th Fitting ideal of the standard free module of
rank `n` is `0` for `k < n` and the unit ideal for `n ≤ k`. -/
private theorem fittingIdeal_free_eq_zero_or_top_of_field
    {K : Type*} [Field K] (n k : ℕ) :
    Fit[K]_(k)(Fin n → K) = if k < n then ⊥ else ⊤ := by
  let π : (Fin n → K) →ₗ[K] (Fin n → K) := LinearMap.id
  have hπ : Function.Surjective π := by
    intro x
    exact ⟨x, rfl⟩
  -- Compute the intrinsic Fitting ideal from the identity presentation of the free module.
  rw [fittingIdeal_eq_presentationFittingIdeal (R := K) (M := Fin n → K) k π hπ]
  by_cases hk : k < n
  · have hnk : 0 < n - k := Nat.sub_pos_of_lt hk
    -- When the requested minors have positive size, every column of the identity-presentation
    -- kernel matrix is zero, so every determinant vanishes.
    rw [presentationFittingIdeal, if_pos hk, Matrix.minorIdeal, Ideal.span_eq_bot]
    intro x hx
    rcases hx with ⟨⟨e₁, e₂⟩, rfl⟩
    exact Matrix.det_eq_zero_of_row_eq_zero ⟨0, hnk⟩ fun j ↦ by
      have he₂j : (((e₂ j : LinearMap.ker π) : Fin n → K)) = 0 := by
        exact LinearMap.mem_ker.mp (e₂ j).property
      simpa [he₂j]
  · have hk' : n ≤ k := Nat.le_of_not_gt hk
    -- Once `k` reaches the rank, the presentation-level Fitting ideal is already the unit ideal.
    rw [if_neg hk]
    simpa [π] using
      presentationFittingIdeal_eq_top_of_le (R := K) (M := Fin n → K) hk' π

/-- Helper for Lemma 15.8.7: over a field, noncontainment of the `k`th Fitting ideal in `0` is
equivalent to the vector-space dimension being at most `k`. -/
private theorem fittingIdeal_not_le_bot_iff_finrank_le_of_field
    {K : Type*} [Field K]
    {V : Type*} [AddCommGroup V] [Module K V] [Module.Finite K V]
    (k : ℕ) :
    (¬ Fit[K]_(k)(V) ≤ (⊥ : Ideal K)) ↔ Module.finrank K V ≤ k := by
  let e : V ≃ₗ[K] (Fin (Module.finrank K V) → K) := (Module.finBasis K V).equivFun
  have hfit :
      Fit[K]_(k)(V) = Fit[K]_(k)(Fin (Module.finrank K V) → K) := by
    simpa using fittingIdeal_eq_of_linearEquiv (R := K) (M := V) (k := k) e
  -- Transport the problem to the standard free module of rank `finrank K V`.
  rw [hfit, fittingIdeal_free_eq_zero_or_top_of_field]
  by_cases hk : k < Module.finrank K V
  · have hnot : ¬ Module.finrank K V ≤ k := Nat.not_le_of_gt hk
    simp [hk, hnot]
  · have hk' : Module.finrank K V ≤ k := Nat.le_of_not_gt hk
    simp [hk, hk']

/-- Helper for Lemma 15.8.7: a finite-dimensional vector space of dimension at most `k` is
generated by `k` vectors. -/
private theorem exists_generators_of_finrank_le_of_field
    {K : Type*} [Field K]
    {V : Type*} [AddCommGroup V] [Module K V] [Module.Finite K V]
    {k : ℕ} (hk : Module.finrank K V ≤ k) :
    ∃ v : Fin k → V, Submodule.span K (Set.range v) = ⊤ := by
  let r := Module.finrank K V
  let e : V ≃ₗ[K] (Fin r → K) := (Module.finBasis K V).equivFun
  let ρ : (Fin k → K) →ₗ[K] (Fin r → K) :=
    LinearMap.pi fun i : Fin r ↦ LinearMap.proj (Fin.castLE hk i)
  have hρ : Function.Surjective ρ := by
    -- Extend a coordinate vector on `Fin r` by zero on the remaining coordinates.
    intro y
    refine ⟨fun i ↦ if h : i.1 < r then y ⟨i.1, h⟩ else 0, ?_⟩
    ext i
    simp [ρ, i.2]
  let σ : (Fin k → K) →ₗ[K] V := e.symm.toLinearMap.comp ρ
  have hσ : Function.Surjective σ := e.symm.surjective.comp hρ
  let v : Fin k → V := fun i ↦ σ (Pi.single i (1 : K))
  have hlin : Fintype.linearCombination K v = σ := by
    -- The standard coordinate vectors of `Fin k → K` recover the original linear map `σ`.
    apply LinearMap.ext
    intro x
    calc
      (Fintype.linearCombination K v) x
          = ∑ i, x i • σ (Pi.single i (1 : K)) := by
              simp [v, Fintype.linearCombination_apply]
      _ = ∑ i, σ (x i • (Pi.single i (1 : K) : Fin k → K)) := by
            congr with i
            exact (σ.map_smul (x i) (Pi.single i (1 : K))).symm
      _ = σ (∑ i, x i • (Pi.single i (1 : K) : Fin k → K)) := by
            symm
            simp [map_sum]
      _ = σ x := by
            congr 1
            ext i
            simpa [Pi.single_apply, mul_comm] using
              (Fintype.sum_pi_single (i := i) (f := x))
  refine ⟨v, ?_⟩
  -- Rephrase the surjective coordinate map as a spanning statement.
  rw [span_range_eq_top_iff_surjective_fintypeLinearCombination]
  intro x
  rcases hσ x with ⟨c, rfl⟩
  refine ⟨c, ?_⟩
  simpa [hlin]

/-- Helper for Lemma 15.8.7: the maximal-ideal residue field of a local ring agrees with its
ambient residue field. -/
private noncomputable abbrev maximalIdeal_residueField_equiv
    (A : Type*) [CommRing A] [IsLocalRing A] :
    (IsLocalRing.maximalIdeal A).ResidueField ≃+* IsLocalRing.ResidueField A :=
  (RingEquiv.ofBijective
    (algebraMap (IsLocalRing.ResidueField A) (IsLocalRing.maximalIdeal A).ResidueField)
    (Ideal.bijective_algebraMap_quotient_residueField (IsLocalRing.maximalIdeal A))).symm

/-- Helper for Lemma 15.8.7: the maximal-ideal residue-field identification sends a residue class
to the canonical local residue class. -/
private theorem maximalIdeal_residueField_equiv_apply_algebraMap
    (A : Type*) [CommRing A] [IsLocalRing A] (a : A) :
    maximalIdeal_residueField_equiv A
        (algebraMap A (IsLocalRing.maximalIdeal A).ResidueField a) =
      IsLocalRing.residue A a := by
  -- Both residue-field models of `A` represent the same class of `a`.
  rw [show algebraMap A (IsLocalRing.maximalIdeal A).ResidueField a =
      algebraMap (IsLocalRing.ResidueField A)
        (IsLocalRing.maximalIdeal A).ResidueField (IsLocalRing.residue A a) by rfl]
  change
    maximalIdeal_residueField_equiv A
        ((maximalIdeal_residueField_equiv A).symm (IsLocalRing.residue A a)) =
      IsLocalRing.residue A a
  exact (maximalIdeal_residueField_equiv A).apply_symm_apply (IsLocalRing.residue A a)

/-- Helper for Lemma 15.8.7: localizing at a prime does not change the corresponding residue
field. -/
private noncomputable abbrev prime_localization_residueField_equiv
    (p : Ideal R) [p.IsPrime] :
    IsLocalRing.ResidueField (Localization.AtPrime p) ≃+* p.ResidueField :=
  (maximalIdeal_residueField_equiv (Localization.AtPrime p)).symm.trans <|
    by
      -- Reinterpret the prime residue field as the ambient residue field of the local ring `R_p`.
      change (IsLocalRing.maximalIdeal (Localization.AtPrime p)).ResidueField ≃+* p.ResidueField
      exact maximalIdeal_residueField_equiv (Localization.AtPrime p)

/-- Helper for Lemma 15.8.7: the prime-local residue-field equivalence sends the local residue
class of a base element to its prime-residue-field class. -/
private theorem prime_localization_residueField_equiv_apply_algebraMap
    (p : Ideal R) [p.IsPrime] (a : R) :
    prime_localization_residueField_equiv (R := R) (p := p)
        (algebraMap (Localization.AtPrime p)
          (IsLocalRing.ResidueField (Localization.AtPrime p))
          (algebraMap R (Localization.AtPrime p) a)) =
      algebraMap R p.ResidueField a := by
  -- First identify the chosen equivalence with the local residue class, then rewrite that class in
  -- the prime-residue-field model.
  calc
    prime_localization_residueField_equiv (R := R) (p := p)
        (algebraMap (Localization.AtPrime p)
          (IsLocalRing.ResidueField (Localization.AtPrime p))
          (algebraMap R (Localization.AtPrime p) a)) =
      IsLocalRing.residue (Localization.AtPrime p) (algebraMap R (Localization.AtPrime p) a) := by
        simpa [prime_localization_residueField_equiv, RingEquiv.trans_apply] using
          maximalIdeal_residueField_equiv_apply_algebraMap (Localization.AtPrime p)
            (algebraMap R (Localization.AtPrime p) a)
    _ = algebraMap R p.ResidueField a := by
      rfl

/-- Helper for Lemma 15.8.7: the inverse prime-local residue-field equivalence sends the
prime-residue-field class of a base element to the canonical local residue class. -/
private theorem prime_localization_residueField_equiv_symm_apply_algebraMap
    (p : Ideal R) [p.IsPrime] (a : R) :
    (prime_localization_residueField_equiv (R := R) (p := p)).symm
        (algebraMap R p.ResidueField a) =
      algebraMap (Localization.AtPrime p)
        (IsLocalRing.ResidueField (Localization.AtPrime p))
        (algebraMap R (Localization.AtPrime p) a) := by
  -- Apply the forward formula and invert the residue-field equivalence.
  exact (prime_localization_residueField_equiv (R := R) (p := p)).injective <| by
    rw [RingEquiv.apply_symm_apply,
      prime_localization_residueField_equiv_apply_algebraMap (R := R) (p := p) (a := a)]

/-- Helper for Lemma 15.8.7: if `f ∉ p`, then every power of `f` also avoids `p`. -/
private abbrev prime_compl_of_not_mem
    (p : Ideal R) [p.IsPrime] {f : R} (hf : f ∉ p) :
    p.primeCompl :=
  ⟨f, hf⟩

/-- Helper for Lemma 15.8.7: if `f ∉ p`, then every power of `f` also avoids `p`. -/
private theorem pow_not_mem_prime
    (p : Ideal R) [p.IsPrime] {f : R} (hf : f ∉ p) (n : ℕ) :
    f ^ n ∉ p := by
  -- Prime ideals are radical, so membership of a power forces membership of the base element.
  intro hpow
  exact hf ((inferInstance : p.IsPrime).mem_of_pow_mem n hpow)

/-- Helper for Lemma 15.8.7: if `f ∉ p`, every power of `f` maps into the prime-complement
submonoid used to define `R_p`. -/
private theorem powers_le_primeCompl_comap_of_not_mem
    (p : Ideal R) [p.IsPrime] {f : R} (hf : f ∉ p) :
    Submonoid.powers f ≤ Submonoid.comap (RingHom.id R) p.primeCompl := by
  -- The identity map preserves the fact that every power of `f` stays outside the prime ideal.
  intro x hx
  rcases hx with ⟨n, rfl⟩
  simpa using pow_not_mem_prime (p := p) (f := f) hf n

/-- Helper for Lemma 15.8.7: if `f ∉ p`, then every power of `f` lies in the prime-complement
submonoid of `R`. -/
private theorem powers_le_primeCompl_of_not_mem
    (p : Ideal R) [p.IsPrime] {f : R} (hf : f ∉ p) :
    Submonoid.powers f ≤ p.primeCompl := by
  -- Forget the trivial `RingHom.id` from the localization-ready inclusion above.
  simpa using powers_le_primeCompl_comap_of_not_mem (R := R) (p := p) hf

/-- Helper for Lemma 15.8.7: if `f ∉ p`, there is a canonical comparison map `R_f → R_p`. -/
private noncomputable abbrev awayToAtPrime
    (p : Ideal R) [p.IsPrime] (f : R) (hf : f ∉ p) :
    Localization.Away f →+* Localization.AtPrime p :=
  IsLocalization.map
    (Localization.AtPrime p)
    (RingHom.id R)
    (powers_le_primeCompl_comap_of_not_mem (R := R) (p := p) hf)

/-- Helper for Lemma 15.8.7: the canonical map `R_f → R_p` sends the standard fraction `r / f^n`
to the same fraction in the prime localization. -/
private theorem awayToAtPrime_map_mk'
    (p : Ideal R) [p.IsPrime] (f : R) (hf : f ∉ p) (r : R) (n : ℕ) :
    awayToAtPrime (R := R) p f hf
        (IsLocalization.mk' (Localization.Away f) r (Submonoid.pow f n)) =
      IsLocalization.mk' (Localization.AtPrime p) r
        (prime_compl_of_not_mem (p := p) (hf := pow_not_mem_prime (p := p) (f := f) hf n)) := by
  -- This is the strict transport formula for `IsLocalization.map` on a standard fraction.
  simpa [awayToAtPrime] using
    (IsLocalization.map_mk'
      (Q := Localization.AtPrime p)
      (g := RingHom.id R)
      (powers_le_primeCompl_comap_of_not_mem (R := R) (p := p) hf)
      r
      (Submonoid.pow f n))

/-- Helper for Lemma 15.8.7: the canonical away-to-at-prime comparison on localized modules is
the localization map induced by `powers f ≤ pᶜ`. -/
private noncomputable abbrev awayToAtPrime_linearMap
    (p : Ideal R) [p.IsPrime] (f : R) (hf : f ∉ p) :
    LocalizedModule.Away f M →ₗ[R] LocalizedModule.AtPrime p M :=
  LocalizedModule.liftOfLE (Submonoid.powers f) p.primeCompl
    (powers_le_primeCompl_of_not_mem (R := R) (p := p) hf)

/-- Helper for Lemma 15.8.7: on a standard away-local fraction `m / f^n`, the localized
comparison `M_f → M_p` sends it to the same fraction in `M_p`. -/
private theorem awayToAtPrime_linearMap_apply_mk
    (p : Ideal R) [p.IsPrime] (f : R) (hf : f ∉ p) (m : M) (s : Submonoid.powers f) :
    awayToAtPrime_linearMap (R := R) (M := M) p f hf (LocalizedModule.mk m s) =
      IsLocalizedModule.mk'
        (LocalizedModule.mkLinearMap p.primeCompl M)
        m
        ⟨s.1, (powers_le_primeCompl_of_not_mem (R := R) (p := p) hf) s.2⟩ := by
  -- Proof comment: `liftOfLE` is defined by the universal localization map, so it preserves the
  -- represented numerator and only changes the denominator witness from `f^n` to the same element
  -- viewed in `pᶜ`.
  simp only [awayToAtPrime_linearMap, IsLocalizedModule.mk_eq_mk',
    IsLocalizedModule.liftOfLE_mk']

/-- Helper for Lemma 15.8.7: the away-to-at-prime comparison agrees with the prime-localization
map on denominator-`1` generators. -/
private theorem awayToAtPrime_linearMap_apply_mk_one
    (p : Ideal R) [p.IsPrime] (f : R) (hf : f ∉ p) (m : M) :
    awayToAtPrime_linearMap (R := R) (M := M) p f hf (LocalizedModule.mk m 1) =
      LocalizedModule.mkLinearMap p.primeCompl M m := by
  -- Proof comment: specialize the fraction formula to denominator `1` and simplify the target
  -- localization class.
  rw [awayToAtPrime_linearMap_apply_mk (R := R) (M := M) (p := p) (f := f) (hf := hf) m 1]
  convert
    (IsLocalizedModule.mk'_one p.primeCompl
      (LocalizedModule.mkLinearMap p.primeCompl M) m) using 1

/-- Helper for Lemma 15.8.7: composing the away-to-at-prime comparison with the away-localization
map from `M` recovers the prime-localization map from `M`. -/
private theorem awayToAtPrime_linearMap_comp_mkLinearMap
    (p : Ideal R) [p.IsPrime] (f : R) (hf : f ∉ p) :
    (awayToAtPrime_linearMap (R := R) (M := M) p f hf).comp
        (LocalizedModule.mkLinearMap (Submonoid.powers f) M) =
      LocalizedModule.mkLinearMap p.primeCompl M := by
  -- Proof comment: both sides send a global element `m` to the denominator-`1` class of `m` in
  -- `M_p`.
  ext m
  simpa using awayToAtPrime_linearMap_apply_mk_one (R := R) (M := M) (p := p) (f := f) hf m

/-- Helper for Lemma 15.8.7: a set of `k` generators over `R_f` still generates after further
localizing at a prime `p` with `f ∉ p`. -/
private theorem atPrime_generators_of_away_generators
    {k : ℕ} (p : Ideal R) [p.IsPrime] {f : R} (hf : f ∉ p)
    (w : Fin k → LocalizedModule.Away f M)
    (hw : Submodule.span (Localization.Away f) (Set.range w) = ⊤) :
    ∃ v : Fin k → LocalizedModule.AtPrime p M,
      Submodule.span (Localization.AtPrime p) (Set.range v) = ⊤ := by
  -- Proof comment: the remaining step is to upgrade the explicit `R`-linear comparison
  -- `awayToAtPrime_linearMap` to an `R_f`-linear map and then transport the `R_f`-spanning family
  -- through that map. The comparison lemmas above isolate the denominator-`1` and localization
  -- compatibility calculations needed for that upgrade.
  let _ := awayToAtPrime_linearMap_comp_mkLinearMap (R := R) (M := M) p f hf
  let _ := w
  let _ := hw
  sorry

section LocalResidueGeneration

variable {A : Type*} [CommRing A] [IsLocalRing A]
variable {N : Type*} [AddCommGroup N] [Module A N] [Module.Finite A N]

local notation "𝔪" => IsLocalRing.maximalIdeal A
local notation "κ" => IsLocalRing.ResidueField A
local notation "Nbar" => N ⧸ (𝔪 • (⊤ : Submodule A N))

/-- Helper for Lemma 15.8.7: the maximal-ideal quotient carries the residue-field scalar action. -/
local instance residueQuotient_module : Module κ Nbar :=
  inferInstanceAs (Module (A ⧸ 𝔪) Nbar)

/-- Helper for Lemma 15.8.7: the ambient ring and residue field act compatibly on the quotient. -/
local instance residueQuotient_smulCommClass : SMulCommClass A κ Nbar :=
  inferInstanceAs (SMulCommClass A (A ⧸ 𝔪) Nbar)

/-- Helper for Lemma 15.8.7: scalar restriction from the residue field to the local ring is a
tower on the maximal-ideal quotient. -/
local instance residueQuotient_isScalarTower : IsScalarTower A κ Nbar :=
  inferInstanceAs (IsScalarTower A (A ⧸ 𝔪) Nbar)

/-- Helper for Lemma 15.8.7: the maximal-ideal quotient stays finite over the residue field. -/
local instance residueQuotient_moduleFinite : Module.Finite κ Nbar :=
  inferInstanceAs (Module.Finite (A ⧸ 𝔪) Nbar)

/-- Helper for Lemma 15.8.7: over a local ring, tensoring a module with the residue field
identifies it with the quotient by the maximal-ideal multiple. -/
private noncomputable def residue_tensor_quotient_linearEquiv :
    (κ ⊗[A] N) ≃ₗ[κ] Nbar := by
  let f : κ →ₗ[κ] N →ₗ[A] Nbar :=
    (LinearMap.ringLmapEquivSelf κ κ (N →ₗ[A] Nbar)).symm
      (Submodule.mkQ (𝔪 • (⊤ : Submodule A N)))
  let e₀ : (κ ⊗[A] N) →ₗ[κ] Nbar :=
    TensorProduct.AlgebraTensorModule.lift f
  have e₀_apply (y : N) : e₀ ((1 : κ) ⊗ₜ[A] y) = Submodule.mkQ (𝔪 • (⊤ : Submodule A N)) y := by
    -- Evaluate the tensor lift on a denominator-`1` tensor to recover the quotient class of `y`.
    simp [e₀, f]
  have e₀_restrictScalars :
      e₀.restrictScalars A = (TensorProduct.quotTensorEquivQuotSMul N 𝔪).toLinearMap := by
    -- Both tensor-to-quotient maps agree on pure tensors, hence they are equal by extensionality.
    apply TensorProduct.ext'
    intro r y
    refine Quotient.inductionOn r ?_
    intro a
    change e₀ (Ideal.Quotient.mk 𝔪 a ⊗ₜ[A] y) =
      TensorProduct.quotTensorEquivQuotSMul N 𝔪 (Ideal.Quotient.mk 𝔪 a ⊗ₜ[A] y)
    rw [TensorProduct.quotTensorEquivQuotSMul_mk_tmul]
    simp [e₀, f]
    simpa using (algebraMap_smul κ a (Submodule.Quotient.mk y))
  exact
    LinearEquiv.ofBijective e₀
      ⟨by
          intro u v huv
          have huv' : e₀.restrictScalars A u = e₀.restrictScalars A v := huv
          rw [e₀_restrictScalars] at huv'
          exact (TensorProduct.quotTensorEquivQuotSMul N 𝔪).injective huv'
        , by
          intro z
          obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective (𝔪 • (⊤ : Submodule A N)) z
          exact ⟨(1 : κ) ⊗ₜ[A] y, e₀_apply y⟩⟩

/-- Helper for Lemma 15.8.7: in a local ring, if the residue classes of `k` chosen lifts span the
closed fiber, then the lifts already generate the whole module. -/
private theorem span_eq_top_of_residue_quotient_span_eq_top
    {k : ℕ} (x : Fin k → N)
    (hquot :
      Submodule.span A
        (Set.range (fun i : Fin k ↦ Submodule.mkQ (𝔪 • (⊤ : Submodule A N)) (x i))) = ⊤) :
    Submodule.span A (Set.range x) = ⊤ := by
  classical
  let s : Finset N := Finset.univ.image x
  have hs : (s : Set N) = Set.range x := by
    -- Replace the finite image of `Fin k` with the corresponding range set.
    ext y
    simp [s]
  have himage :
      ((Submodule.mkQ (𝔪 • (⊤ : Submodule A N))) '' (s : Set N) : Set Nbar) =
        Set.range (fun i : Fin k ↦ Submodule.mkQ (𝔪 • (⊤ : Submodule A N)) (x i)) := by
    -- Passing the finite set `s` through the quotient map recovers exactly the chosen residue
    -- classes of the lifts.
    rw [hs]
    ext y
    constructor
    · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨x i, ⟨i, rfl⟩, rfl⟩
  have hquot' :
      Submodule.span A ((Submodule.mkQ (𝔪 • (⊤ : Submodule A N))) '' (s : Set N)) = ⊤ := by
    -- Rewrite the quotient-span hypothesis into the finite-set form required by Nakayama.
    rw [himage]
    exact hquot
  have hmaxJac₀ : 𝔪 ≤ Ideal.jacobson (⊥ : Ideal A) :=
    IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal A)
  have hmaxJac : 𝔪 ≤ Ring.jacobson A := by
    -- In a local ring the maximal ideal lies in the Jacobson radical.
    rw [← Ideal.jacobson_bot]
    exact hmaxJac₀
  -- Nakayama upgrades generation of the closed fiber to generation of the original module.
  simpa [hs] using
    (span_eq_top_of_quotient_span_eq_top_of_le_ring_jacobson
      (R := A) (M := N) (I := 𝔪) (s := s) hquot' hmaxJac)

/-- Helper for Lemma 15.8.7: once the closed fiber over a local ring has `κ`-dimension at most
`k`, one can choose `k` residue generators and lift them to generators of the module itself. -/
private theorem exists_generators_of_finrank_le_residue_quotient
    {k : ℕ} (hk : Module.finrank κ Nbar ≤ k) :
    ∃ x : Fin k → N, Submodule.span A (Set.range x) = ⊤ := by
  classical
  obtain ⟨w, hw⟩ :=
    exists_generators_of_finrank_le_of_field (K := κ) (V := Nbar) hk
  let x : Fin k → N := fun i ↦
    Classical.choose ((Submodule.mkQ_surjective (𝔪 • (⊤ : Submodule A N))) (w i))
  have hx :
      ∀ i : Fin k, Submodule.mkQ (𝔪 • (⊤ : Submodule A N)) (x i) = w i := by
    -- Pick arbitrary lifts of the residue generators.
    intro i
    exact Classical.choose_spec
      ((Submodule.mkQ_surjective (𝔪 • (⊤ : Submodule A N))) (w i))
  have hquot :
      Submodule.span A
        (Set.range (fun i : Fin k ↦ Submodule.mkQ (𝔪 • (⊤ : Submodule A N)) (x i))) = ⊤ := by
    have hcomp :
        (fun i : Fin k ↦ Submodule.mkQ (𝔪 • (⊤ : Submodule A N)) (x i)) = w := by
      funext i
      exact hx i
    -- Forgetting scalars from `κ` back to `A` preserves the spanning statement on the quotient.
    rw [hcomp, ← Submodule.restrictScalars_span A κ Ideal.Quotient.mk_surjective,
      Submodule.restrictScalars_eq_top_iff]
    exact hw
  -- Apply the local lifting lemma to the chosen residue generators.
  exact ⟨x, span_eq_top_of_residue_quotient_span_eq_top (A := A) (N := N) x hquot⟩

/-- Helper for Lemma 15.8.7: if `k` elements generate a module over a local ring, then their
residue classes span a `k`-dimensional quotient over the residue field. -/
private theorem finrank_le_residue_quotient_of_exists_generators
    {k : ℕ} (x : Fin k → N)
    (hx : Submodule.span A (Set.range x) = ⊤) :
    Module.finrank κ Nbar ≤ k := by
  let xbar : Fin k → Nbar := fun i ↦ Submodule.mkQ (𝔪 • (⊤ : Submodule A N)) (x i)
  have hspanA :
      Submodule.span A (Set.range xbar) = ⊤ := by
    have hmap :
        Submodule.map (Submodule.mkQ (𝔪 • (⊤ : Submodule A N)))
            (Submodule.span A (Set.range x)) =
          Submodule.span A (Set.range xbar) := by
      rw [Submodule.map_span]
      congr 1
      ext y
      constructor
      · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, rfl⟩
      · rintro ⟨i, rfl⟩
        exact ⟨x i, ⟨i, rfl⟩, rfl⟩
    -- Mapping a generating family through the quotient map still spans the whole quotient.
    rw [← hmap, hx, Submodule.map_top]
    rw [LinearMap.range_eq_top]
    exact Submodule.mkQ_surjective (𝔪 • (⊤ : Submodule A N))
  have hspanκ :
      Submodule.span κ (Set.range xbar) = ⊤ := by
    -- Forgetting scalars from `κ` to `A` does not change the spanning statement on the quotient.
    rw [← Submodule.restrictScalars_eq_top_iff]
    simpa [Submodule.restrictScalars_span A κ Ideal.Quotient.mk_surjective] using hspanA
  have hsurj :
      Function.Surjective (Fintype.linearCombination κ xbar) := by
    rw [span_range_eq_top_iff_surjective_fintypeLinearCombination] at hspanκ
    exact hspanκ
  -- A surjective map `κ^k → Nbar` bounds the residue-field dimension by `k`.
  have hle :
      Module.finrank κ (LinearMap.range (Fintype.linearCombination κ xbar)) ≤ k := by
    have hrank :
        Module.finrank κ (LinearMap.range (Fintype.linearCombination κ xbar)) +
          Module.finrank κ (LinearMap.ker (Fintype.linearCombination κ xbar)) = k := by
      simpa using LinearMap.finrank_range_add_finrank_ker (Fintype.linearCombination κ xbar)
    rw [← hrank]
    exact Nat.le_add_right _ _
  have hrange : LinearMap.range (Fintype.linearCombination κ xbar) = ⊤ :=
    LinearMap.range_eq_top.2 hsurj
  rw [hrange, finrank_top] at hle
  exact hle

end LocalResidueGeneration

/-- Helper for Lemma 15.8.7: the residue-field fiber has dimension at most `k` exactly when the
prime localization can be generated by `k` elements. -/
private theorem residueField_finrank_le_iff_exists_atPrime_generators
    (k : ℕ) (p : Ideal R) [p.IsPrime] :
    Module.finrank p.ResidueField (p.ResidueField ⊗[R] M) ≤ k ↔
      ∃ v : Fin k → LocalizedModule.AtPrime p M,
