-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

open scoped TensorProduct
open scoped KoszulComplex
open Algebra.TensorProduct
open TensorProduct.AlgebraTensorModule

namespace RingTheory.Sequence

section

variable {A B A' : Type u} [CommRing A] [CommRing B] [CommRing A']
variable [Algebra A B] [Algebra A A']
variable {r : ℕ}

local notation "B'" => A' ⊗[A] B

/- Domain-style sampling for the base-change map on first Koszul homology:
- primary domain: first Koszul homology under scalar extension/base change in commutative algebra;
- sampled owner declarations:
  `koszulH1`,
  `koszulH1Presentation`,
  `koszulH1IsoPresentation`,
  `LinearMap.baseChange`,
  `LinearMap.liftBaseChange`;
- owner abstraction: the source-facing owner is the chapter declaration `koszulH1 f B`; the
  quotient presentation `koszulH1Presentation` is only an internal bridge/view;
- source/core/bridge triage:
  `source-facing`: the canonical comparison on first Koszul homology under base change;
  `core/canonical`: the owner `koszulH1 f B`;
  `bridge/view`: the quotient presentation `koszulH1Presentation` and its induced base-change map;
- primitive data vs derived API: the only public datum is the canonical base-change map on the
  owner `koszulH1`, obtained by conjugating the private quotient-presentation map with the
  canonical presentation isomorphisms; surjectivity under the flat-quotient hypothesis is the
  derived theorem.
-/
private abbrev baseChangeSequence (f : Fin r → B) : Fin r → B' :=
  fun i ↦ includeRight (f i)

private abbrev koszulFirstCyclesSelf
    (R : Type u) [CommRing R] {n : ℕ} (f : Fin n → R) : Submodule R (Fin n → R) :=
  show Submodule R (Fin n → R) from koszulFirstCycles f R

private abbrev koszulH1Self
    (R : Type u) [CommRing R] {n : ℕ} (f : Fin n → R) : ModuleCat R :=
  show ModuleCat R from koszulH1 f R

private abbrev koszulH1PresentationSelf
    (R : Type u) [CommRing R] {n : ℕ} (f : Fin n → R) : Type u :=
  (koszulFirstCyclesSelf R f) ⧸ (koszulDiagonalMap f R).range

private theorem baseChangeSequence_firstCycleCondition (f : Fin r → B)
    (x : koszulFirstCyclesSelf B f) :
    ∀ i j : Fin r,
      (includeRight (f i) : B') * (includeRight (x.1 j) : B') =
        (includeRight (f j) : B') * (includeRight (x.1 i) : B') := by
  intro i j
  simpa [Algebra.smul_def] using
    congrArg (includeRight : B →ₐ[A] B') ((koszulFirstCycleCondition_of_mem f B x.2) i j)

/-- Helper for Lemma 15.31.3: the ideal generated by the base-changed sequence is exactly the
image of the source ideal under `B → A' ⊗[A] B`. -/
private theorem baseChangeSequence_span_range_eq_map_span_range (f : Fin r → B) :
    Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) =
      Ideal.map (includeRight : B →ₐ[A] B') (Ideal.span (Set.range f)) := by
  -- Rewrite the target generators as the image of the original sequence under `includeRight`.
  rw [Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨f i, ⟨i, rfl⟩, rfl⟩
  · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, rfl⟩

private def koszulFirstCyclesBaseChangeMap (f : Fin r → B) :
    koszulFirstCyclesSelf B f →ₗ[A]
      koszulFirstCyclesSelf (A' ⊗[A] B) (baseChangeSequence f) where
  toFun x := ⟨fun i ↦ includeRight (x.1 i), by
    exact
      (mem_koszulFirstCycles_iff (baseChangeSequence f) B' (fun i ↦ includeRight (x.1 i))).2
        (baseChangeSequence_firstCycleCondition f x)⟩
  map_add' x y := by
    ext i
    simpa using (includeRight : B →ₐ[A] B').toLinearMap.map_add (x.1 i) (y.1 i)
  map_smul' a x := by
    ext i
    simpa using (includeRight : B →ₐ[A] B').toLinearMap.map_smul a (x.1 i)

local instance (f : Fin r → B) : Module A ↑(koszulH1 f B) :=
  Module.compHom ↑(koszulH1 f B) (algebraMap A B)

local instance (f : Fin r → B) : Module A (koszulH1PresentationSelf B f) :=
  inferInstance

local instance (f : Fin r → B) :
    Module A ↑(koszulH1Self (A' ⊗[A] B) (baseChangeSequence f)) :=
  Module.compHom ↑(koszulH1Self (A' ⊗[A] B) (baseChangeSequence f)) (algebraMap A B')

local instance (f : Fin r → B) :
    Module A' ↑(koszulH1Self (A' ⊗[A] B) (baseChangeSequence f)) :=
  Module.compHom ↑(koszulH1Self (A' ⊗[A] B) (baseChangeSequence f)) (algebraMap A' B')

local instance (f : Fin r → B) :
    IsScalarTower A A' ↑(koszulH1Self (A' ⊗[A] B) (baseChangeSequence f)) :=
  IsScalarTower.of_compHom A A' ↑(koszulH1Self (A' ⊗[A] B) (baseChangeSequence f))

local instance (f : Fin r → B) :
    Module A (koszulH1PresentationSelf (A' ⊗[A] B) (baseChangeSequence f)) :=
  inferInstance

local instance (f : Fin r → B) :
    Module A' (koszulH1PresentationSelf (A' ⊗[A] B) (baseChangeSequence f)) :=
  inferInstance

local instance (f : Fin r → B) :
    IsScalarTower A A' (koszulH1PresentationSelf (A' ⊗[A] B) (baseChangeSequence f)) :=
  inferInstance

private def koszulH1PresentationBaseChangeMap (f : Fin r → B) :
    koszulH1PresentationSelf B f →ₗ[A]
      koszulH1PresentationSelf (A' ⊗[A] B) (baseChangeSequence f) :=
  let pB : Submodule B (koszulFirstCyclesSelf B f) :=
    LinearMap.range (koszulDiagonalMap f B)
  let p : Submodule A (koszulFirstCyclesSelf B f) :=
    pB.restrictScalars A
  let qB : Submodule B' (koszulFirstCyclesSelf (A' ⊗[A] B) (baseChangeSequence f)) :=
    LinearMap.range (koszulDiagonalMap (baseChangeSequence f) B')
  let q : Submodule A (koszulFirstCyclesSelf (A' ⊗[A] B) (baseChangeSequence f)) :=
    qB.restrictScalars A
  let mapQ : (koszulFirstCyclesSelf B f ⧸ p) →ₗ[A]
      (koszulFirstCyclesSelf (A' ⊗[A] B) (baseChangeSequence f) ⧸ q) :=
    p.mapQ q (koszulFirstCyclesBaseChangeMap f) (by
      intro x hx
      rcases hx with ⟨y, rfl⟩
      refine ⟨includeRight y, ?_⟩
      ext i
      change
        (includeRight (f i) : B') * (includeRight y : B') =
          (includeRight (f i * y) : B')
      simp)
  let sourceEquiv' :
      (koszulFirstCyclesSelf B f ⧸ p) ≃ₗ[A]
        ((koszulFirstCyclesSelf B f) ⧸ (koszulDiagonalMap f B).range) :=
    by
      simpa [p, pB] using (Submodule.Quotient.restrictScalarsEquiv A pB)
  let sourceEquiv :
      (koszulFirstCyclesSelf B f ⧸ p) ≃ₗ[A] koszulH1PresentationSelf B f :=
    by
      simpa [koszulH1PresentationSelf] using sourceEquiv'
  let targetEquiv' :
      (koszulFirstCyclesSelf (A' ⊗[A] B) (baseChangeSequence f) ⧸ q) ≃ₗ[A]
        ((koszulFirstCyclesSelf (A' ⊗[A] B) (baseChangeSequence f)) ⧸
          (koszulDiagonalMap (baseChangeSequence f) B').range) :=
    by
      simpa [q, qB] using (Submodule.Quotient.restrictScalarsEquiv A qB)
  let targetEquiv :
      (koszulFirstCyclesSelf (A' ⊗[A] B) (baseChangeSequence f) ⧸ q) ≃ₗ[A]
        koszulH1PresentationSelf (A' ⊗[A] B) (baseChangeSequence f) :=
    by
      simpa [koszulH1PresentationSelf] using targetEquiv'
  targetEquiv.toLinearMap ∘ₗ mapQ ∘ₗ sourceEquiv.symm.toLinearMap

private noncomputable def koszulH1PresentationBaseChangeHom (f : Fin r → B) :
    A' ⊗[A] koszulH1PresentationSelf B f →ₗ[A']
      koszulH1PresentationSelf (A' ⊗[A] B) (baseChangeSequence f) :=
  (koszulH1PresentationBaseChangeMap f).liftBaseChange A'

/-- Helper for Lemma 15.31.3: on pure tensors, the lifted base-change map on first cycles reads
off the expected coordinatewise scalar multiple. -/
private theorem koszulFirstCyclesBaseChangeMap_liftBaseChange_tmul_apply
    (f : Fin r → B) (a : A') (x : koszulFirstCyclesSelf B f) (i : Fin r) :
    ((((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A')
        (a ⊗ₜ[A] x)).1 i) =
      a • (includeRight (x.1 i) : B') := by
  -- Expand the lifted base-change map on a pure tensor, then read off the `i`-th coordinate.
  simp [LinearMap.liftBaseChange_tmul, koszulFirstCyclesBaseChangeMap]

/-- Helper for Lemma 15.31.3: the tensorized inclusion of the source ideal sends `1 ⊗ x` to the
canonical base-change image of `x`. -/
private theorem ideal_span_tensor_inclusion_tmul_eq_includeRight
    (f : Fin r → B) (x : Ideal.span (Set.range f)) :
    (LinearMap.baseChange A'
      (((Ideal.span (Set.range f)).subtype).restrictScalars A))
        (1 ⊗ₜ[A] x) =
      (includeRight (x : B) : B') := by
  -- The base-change formula on pure tensors is exactly the canonical `includeRight` map.
  simp [LinearMap.baseChange_tmul]

-- Proof sketch: first send a degree-one Koszul cycle `(x₁, …, xᵣ)` in `B` to the base-changed
-- cycle `(1 ⊗ x₁, …, xᵣ)` in `A' ⊗[A] B`; compatibility with diagonal boundaries makes this
-- descend to the canonical base-change map on the quotient presentation of `H₁`. Conjugating
-- that map by the presentation isomorphisms `koszulH1IsoPresentation` yields the public owner-
-- level comparison `A' ⊗[A] koszulH1(B, f) → koszulH1(A' ⊗[A] B, f')`.
/-- Helper for Lemma 15.31.3: the source presentation isomorphism, viewed after restricting
scalars from `B` to `A`. -/
private noncomputable def koszulH1IsoPresentation_sourceLinearEquiv
    (f : Fin r → B) :
    koszulH1Self B f ≃ₗ[A] koszulH1PresentationSelf B f := by
  let eB : koszulH1Self B f ≃ₗ[B] koszulH1PresentationSelf B f := by
    simpa [koszulH1Self, koszulH1PresentationSelf] using
      (koszulH1IsoPresentation f B).toLinearEquiv
  exact
    { toFun := eB
      map_add' := eB.map_add
      map_smul' := by
        intro a x
        show eB ((algebraMap A B a) • x) = (algebraMap A B a) • eB x
        exact eB.map_smul (algebraMap A B a) x
      invFun := eB.symm
      left_inv := eB.left_inv
      right_inv := eB.right_inv }

/-- Helper for Lemma 15.31.3: the target presentation isomorphism, viewed after restricting
scalars from `B'` to `A'`. -/
private noncomputable def koszulH1IsoPresentation_targetLinearEquiv
    (f : Fin r → B) :
    koszulH1Self B' (baseChangeSequence f) ≃ₗ[A']
      koszulH1PresentationSelf B' (baseChangeSequence f) := by
  let eB' :
      koszulH1Self B' (baseChangeSequence f) ≃ₗ[B']
        koszulH1PresentationSelf B' (baseChangeSequence f) := by
    simpa [koszulH1Self, koszulH1PresentationSelf] using
      (koszulH1IsoPresentation (baseChangeSequence f) B').toLinearEquiv
  exact
    { toFun := eB'
      map_add' := eB'.map_add
      map_smul' := by
        intro a x
        show eB' ((algebraMap A' B' a) • x) = (algebraMap A' B' a) • eB' x
        exact eB'.map_smul (algebraMap A' B' a) x
      invFun := eB'.symm
      left_inv := eB'.left_inv
      right_inv := eB'.right_inv }

private noncomputable def koszulH1BaseChangeCore (f : Fin r → B) :
    A' ⊗[A] koszulH1Self B f →ₗ[A']
      koszulH1Self (A' ⊗[A] B) (baseChangeSequence f) :=
  -- Package the owner map by conjugating the presentation-level map with the restricted-scalars
  -- versions of `koszulH1IsoPresentation` on the source and the target.
  let eSource :=
    koszulH1IsoPresentation_sourceLinearEquiv (A := A) (B := B) f
  let eTarget :=
    koszulH1IsoPresentation_targetLinearEquiv (A := A) (A' := A') (B := B) f
  eTarget.symm.toLinearMap ∘ₗ koszulH1PresentationBaseChangeHom (A := A) (A' := A') f ∘ₗ
    LinearMap.baseChange A' eSource.toLinearMap

/-- Helper for Lemma 15.31.3: a surjective `A`-linear map remains surjective after tensoring over
`A`, proved by tensor induction on the target element. -/
private theorem baseChange_surjective_of_surjective
    {M N : Type u} [AddCommMonoid M] [AddCommMonoid N] [Module A M] [Module A N]
    (g : M →ₗ[A] N) (hg : Function.Surjective g) :
    Function.Surjective (LinearMap.baseChange A' g) := by
  intro z
  -- Tensor induction reduces surjectivity to pure tensors, where a source preimage suffices.
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · exact ⟨0, by simp⟩
  · intro a y
    rcases hg y with ⟨x, rfl⟩
    refine ⟨a ⊗ₜ[A] x, ?_⟩
    simp [LinearMap.baseChange_tmul]
  · intro x y hx hy
    rcases hx with ⟨x', rfl⟩
    rcases hy with ⟨y', rfl⟩
    refine ⟨x' + y', by simp⟩

/-- Helper for Lemma 15.31.3: after tensoring the ideal row
`0 → J → B → B ⧸ J → 0`, exactness becomes the concrete equality
`range(1 ⊗ J → 1 ⊗ B) = ker(1 ⊗ B → 1 ⊗ (B ⧸ J))`. -/
private theorem ideal_span_quotient_tensor_range_eq_ker
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))] :
    let J : Ideal B := Ideal.span (Set.range f)
    let ι : J →ₗ[A] B := (J.subtype).restrictScalars A
    let π : B →ₗ[A] B ⧸ J := (Ideal.Quotient.mkₐ A J).toLinearMap
    let ιT : A' ⊗[A] J →ₗ[A'] B' := LinearMap.baseChange A' ι
    let πT : B' →ₗ[A'] A' ⊗[A] (B ⧸ J) := LinearMap.baseChange A' π
    LinearMap.range ιT = LinearMap.ker πT := by
  let J : Ideal B := Ideal.span (Set.range f)
  let ι : J →ₗ[A] B := (J.subtype).restrictScalars A
  let π : B →ₗ[A] B ⧸ J := (Ideal.Quotient.mkₐ A J).toLinearMap
  let S : CategoryTheory.ShortComplex (ModuleCat A) :=
    CategoryTheory.ShortComplex.moduleCatMk ι π (by
      -- The quotient map kills the ideal inclusion by construction.
      apply LinearMap.ext
      intro x
      exact Ideal.Quotient.eq_zero_iff_mem.mpr x.2)
  have hS : S.ShortExact := by
    -- This is the standard short exact row `0 → J → B → B ⧸ J → 0`.
    refine ModuleCat.shortComplex_shortExact _ ?_ ?_ ?_
    · simpa [S, ι, π, J] using
        (LinearMap.exact_subtype_mkQ J :
          Function.Exact ((J.subtype : J →ₗ[B] B).restrictScalars A)
            ((Ideal.Quotient.mkₐ A J).toLinearMap))
    · exact Submodule.injective_subtype J
    · exact Ideal.Quotient.mkₐ_surjective A J
  have hTensor :
      (S.map (CategoryTheory.MonoidalCategory.tensorLeft (ModuleCat.of A A'))).ShortExact := by
    -- Flatness of `B ⧸ J` is exactly the hypothesis needed to tensor the short exact row.
    letI : Module.Flat A S.X₃ := by
      dsimp [S, J, π]
      infer_instance
    simpa [S, J] using
      (CategoryTheory.ShortComplex.ShortExact.tensorLeft_of_flat_cokernel
        (S := S) hS (ModuleCat.of A A'))
  have hExact :
      Function.Exact (LinearMap.baseChange A' ι) (LinearMap.baseChange A' π) := by
    -- Exit the short-complex API immediately and record exactness on the concrete tensor maps.
    simpa [S, ι, π, LinearMap.baseChange_eq_ltensor] using
      (CategoryTheory.ShortComplex.ShortExact.moduleCat_exact_iff_function_exact
        (S.map (CategoryTheory.MonoidalCategory.tensorLeft (ModuleCat.of A A')))).mp hTensor.exact
  -- `LinearMap.exact_iff` turns the function-level exactness into the desired `range = ker`.
  dsimp [J, ι, π]
  exact (LinearMap.exact_iff.mp hExact).symm

/-- Helper for Lemma 15.31.3: an element of `A' ⊗[A] B` whose image in
`A' ⊗[A] (B ⧸ J)` vanishes comes from `A' ⊗[A] J`. -/
private theorem ideal_span_quotient_tensor_lift_of_zero
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (u : B')
    (hu :
      (LinearMap.baseChange A'
        ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range f))).toLinearMap)) u = 0) :
    ∃ v : A' ⊗[A] Ideal.span (Set.range f),
      (LinearMap.baseChange A'
        (((Ideal.span (Set.range f)).subtype).restrictScalars A)) v = u := by
  -- Rewrite the vanishing condition as kernel membership, then apply the concrete `range = ker`.
  have huKer :
      u ∈ LinearMap.ker
        (LinearMap.baseChange A'
          ((Ideal.Quotient.mkₐ A (Ideal.span (Set.range f))).toLinearMap)) := by
    exact LinearMap.mem_ker.2 hu
  rw [← ideal_span_quotient_tensor_range_eq_ker (A := A) (A' := A') f] at huKer
  exact LinearMap.mem_range.1 huKer

/-- Helper for Lemma 15.31.3: the flatness input is used only at the quotient-presentation level,
where it should imply surjectivity of the base-change map on `koszulH1Presentation`. -/
private theorem idealSpanHomToKoszulFirstCycles_comp_spanToIdealSpanHom_eq_koszulDiagonalMap
    (f : Fin r → B) (y : B') :
    idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B'
        (spanToIdealSpanHom (baseChangeSequence (A := A) (A' := A') f) B' y) =
      koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y := by
  -- Compare both target cycles coordinatewise on the generators `fᵢ'`.
  ext i
  simp [idealSpanHomToKoszulFirstCycles, spanToIdealSpanHom, koszulDiagonalMap_coe_apply]

/-- Helper for Lemma 15.31.3: equal classes in the target presentation differ by a diagonal
boundary at the cycle level. -/
private theorem target_cycles_eq_mod_diagonal
    (f : Fin r → B)
    (x y : koszulFirstCyclesSelf B' (baseChangeSequence (A := A) (A' := A') f))
    (h :
      (Submodule.Quotient.mk x :
        koszulH1PresentationSelf B' (baseChangeSequence (A := A) (A' := A') f)) =
        Submodule.Quotient.mk y) :
    ∃ t : B', y + koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' t = x := by
  -- Translate equality of quotient classes into membership in the diagonal range.
  have hmem :
      x - y ∈ LinearMap.range
        (koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B') := by
    exact
      (Submodule.Quotient.eq
        (LinearMap.range
          (koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B'))).1 h
  rcases LinearMap.mem_range.1 hmem with ⟨t, ht⟩
  refine ⟨t, ?_⟩
  -- Re-express the difference as an explicit diagonal correction term.
  calc
    y + koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' t
      = y + (x - y) := by rw [ht]
    _ = x := by simp [sub_eq_add_neg, add_left_comm]

/-- Helper for Lemma 15.31.3: if two target ideal-hom maps define the same presentation class,
then their associated target cycles differ by a diagonal boundary. -/
private theorem target_idealSpanHom_cycles_eq_mod_diagonal
    (f : Fin r → B)
    (φ ψ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B')
    (h :
      idealSpanHomToKoszulH1Presentation (baseChangeSequence (A := A) (A' := A') f) B' φ =
        idealSpanHomToKoszulH1Presentation (baseChangeSequence (A := A) (A' := A') f) B' ψ) :
    ∃ y : B',
      idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ =
        idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' ψ +
          koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y := by
  -- The difference of the two ideal-hom maps lies in the diagonal kernel on the presentation side.
  have hker :
      φ - ψ ∈ LinearMap.ker
        (idealSpanHomToKoszulH1Presentation (baseChangeSequence (A := A) (A' := A') f) B') := by
    rw [LinearMap.mem_ker, LinearMap.map_sub, h, sub_self]
  rw [idealSpanHomToKoszulH1Presentation_ker_eq_range_spanToIdealSpanHom
    (f := baseChangeSequence (A := A) (A' := A') f) (N := B')] at hker
  rcases LinearMap.mem_range.1 hker with ⟨y, hy⟩
  refine ⟨y, ?_⟩
  -- Apply the cycle-level map to the recovered diagonal ideal-hom correction.
  have hcycles := congrArg
    (idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B') hy
  have hsub :
      idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ -
        idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' ψ =
          koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y := by
    simpa [LinearMap.map_sub,
      idealSpanHomToKoszulFirstCycles_comp_spanToIdealSpanHom_eq_koszulDiagonalMap
        (A := A) (A' := A') f y] using
      hcycles.symm
  rw [sub_eq_iff_eq_add] at hsub
  simpa [add_comm] using hsub

/-- Helper for Lemma 15.31.3: if a target ideal-hom map and a target cycle induce the same
relation-module map, then they define the same target cycle. -/
private theorem idealSpanHom_cycle_eq_of_relation_module_eq
    (f : Fin r → B)
    (φ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B')
    (c : koszulFirstCyclesSelf B' (baseChangeSequence (A := A) (A' := A') f))
    (h :
      φ.comp
          (idealGeneratorRelationModuleToSpan
            (baseChangeSequence (A := A) (A' := A') f)) =
        koszulCycleToRelationModuleHom
          (baseChangeSequence (A := A) (A' := A') f) B' c) :
    idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ = c := by
  -- Compare the two candidate cycles through the injective owner map to the relation module.
  apply koszulCycleToRelationModuleHom_injective
    (f := baseChangeSequence (A := A) (A' := A') f) (N := B')
  calc
    koszulCycleToRelationModuleHom
        (baseChangeSequence (A := A) (A' := A') f) B'
        (idealSpanHomToKoszulFirstCycles
          (baseChangeSequence (A := A) (A' := A') f) B' φ)
      =
        φ.comp
          (idealGeneratorRelationModuleToSpan
            (baseChangeSequence (A := A) (A' := A') f)) := by
              symm
              exact idealSpanHom_cycle_to_relation_module_factorization
                (f := baseChangeSequence (A := A) (A' := A') f) (N := B') φ
    _ =
        koszulCycleToRelationModuleHom
          (baseChangeSequence (A := A) (A' := A') f) B' c := h

/-- Helper for Lemma 15.31.3: an owner-level comparison on the relation module already determines
the target presentation class of the corresponding ideal-hom datum. -/
private theorem idealSpanHom_presentation_eq_of_relation_module_eq
    (f : Fin r → B)
    (φ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B')
    (c : koszulFirstCyclesSelf B' (baseChangeSequence (A := A) (A' := A') f))
    (h :
      φ.comp
          (idealGeneratorRelationModuleToSpan
            (baseChangeSequence (A := A) (A' := A') f)) =
        koszulCycleToRelationModuleHom
          (baseChangeSequence (A := A) (A' := A') f) B' c) :
    idealSpanHomToKoszulH1Presentation (baseChangeSequence (A := A) (A' := A') f) B' φ =
      (Submodule.Quotient.mk c :
        koszulH1PresentationSelf B' (baseChangeSequence (A := A) (A' := A') f)) := by
  -- Move from the owner comparison back to the quotient presentation through the induced cycle
  -- equality, without reopening any quotient transport.
  have hcycle :=
    idealSpanHom_cycle_eq_of_relation_module_eq (A := A) (A' := A') f φ c h
  simp [idealSpanHomToKoszulH1Presentation, hcycle]

/-- Helper for Lemma 15.31.3: if an ideal-hom datum takes the target generators `fᵢ'` to the
entries of a target cycle, then it recovers that cycle exactly. -/
private theorem idealSpanHom_cycle_eq_of_generator_values
    (f : Fin r → B)
    (φ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B')
    (c : koszulFirstCyclesSelf B' (baseChangeSequence (A := A) (A' := A') f))
    (hgen :
      ∀ i : Fin r,
        φ ⟨baseChangeSequence (A := A) (A' := A') f i, Ideal.subset_span ⟨i, rfl⟩⟩ = c.1 i) :
    idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ = c := by
  -- The cycle associated to `φ` is computed coordinatewise on the generators `fᵢ'`.
  ext i
  simpa [idealSpanHomToKoszulFirstCycles] using hgen i

/-- Helper for Lemma 15.31.3: matching the target generator values already forces equality of the
induced relation-module maps. -/
private theorem idealSpanHom_relation_module_eq_of_generator_values
    (f : Fin r → B)
    (φ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B')
    (c : koszulFirstCyclesSelf B' (baseChangeSequence (A := A) (A' := A') f))
    (hgen :
      ∀ i : Fin r,
        φ ⟨baseChangeSequence (A := A) (A' := A') f i, Ideal.subset_span ⟨i, rfl⟩⟩ = c.1 i) :
    φ.comp
        (idealGeneratorRelationModuleToSpan
          (baseChangeSequence (A := A) (A' := A') f)) =
      koszulCycleToRelationModuleHom
        (baseChangeSequence (A := A) (A' := A') f) B' c := by
  -- First identify the cycle attached to `φ`, then use the standard factorization through the
  -- relation module.
  have hcycle :=
    idealSpanHom_cycle_eq_of_generator_values (A := A) (A' := A') f φ c hgen
  calc
    φ.comp
        (idealGeneratorRelationModuleToSpan
          (baseChangeSequence (A := A) (A' := A') f))
      =
        koszulCycleToRelationModuleHom
          (baseChangeSequence (A := A) (A' := A') f) B'
          (idealSpanHomToKoszulFirstCycles
            (baseChangeSequence (A := A) (A' := A') f) B' φ) := by
              symm
              exact idealSpanHom_cycle_to_relation_module_factorization
                (f := baseChangeSequence (A := A) (A' := A') f) (N := B') φ
    _ =
        koszulCycleToRelationModuleHom
          (baseChangeSequence (A := A) (A' := A') f) B' c := by
              rw [hcycle]

/-- Helper for Lemma 15.31.3: matching the target generator values is enough to identify the
target presentation class of an ideal-hom datum. -/
private theorem idealSpanHom_presentation_eq_of_generator_values
    (f : Fin r → B)
    (φ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B')
    (c : koszulFirstCyclesSelf B' (baseChangeSequence (A := A) (A' := A') f))
    (hgen :
      ∀ i : Fin r,
        φ ⟨baseChangeSequence (A := A) (A' := A') f i, Ideal.subset_span ⟨i, rfl⟩⟩ = c.1 i) :
    idealSpanHomToKoszulH1Presentation (baseChangeSequence (A := A) (A' := A') f) B' φ =
      (Submodule.Quotient.mk c :
        koszulH1PresentationSelf B' (baseChangeSequence (A := A) (A' := A') f)) := by
  -- After reducing to the generator values, the earlier owner-to-presentation bridge applies.
  exact idealSpanHom_presentation_eq_of_relation_module_eq (A := A) (A' := A') f φ c
    (idealSpanHom_relation_module_eq_of_generator_values (A := A) (A' := A') f φ c hgen)

/-- Helper for Lemma 15.31.3: once the extracted ideal datum matches a chosen base-changed source
cycle on the generators `fᵢ'`, the desired target presentation equality follows formally. -/
private theorem lifted_target_ideal_cycle_data_of_flat_quotient_of_generator_values
    (f : Fin r → B)
    (z : koszulFirstCyclesSelf B' (baseChangeSequence f))
    (w : A' ⊗[A] koszulFirstCyclesSelf B f)
    (φ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B')
    (y : B')
    (hz :
      idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ +
          koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y =
        z)
    (hgen :
      ∀ i : Fin r,
        φ ⟨baseChangeSequence (A := A) (A' := A') f i, Ideal.subset_span ⟨i, rfl⟩⟩ =
          ((((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w).1 i)) :
    ∃ w' : A' ⊗[A] koszulFirstCyclesSelf B f,
      ∃ φ' : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B',
        ∃ y' : B',
          idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ' +
              koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y' =
            z ∧
          idealSpanHomToKoszulH1Presentation (baseChangeSequence (A := A) (A' := A') f) B' φ' =
            (Submodule.Quotient.mk
              (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w') :
              koszulH1PresentationSelf B' (baseChangeSequence (A := A) (A' := A') f)) := by
  -- Package the already-matched generator data with the quotient-class bridge proved above.
  refine ⟨w, φ, y, hz, ?_⟩
  exact idealSpanHom_presentation_eq_of_generator_values (A := A) (A' := A') f φ
    (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w) hgen

/-- Helper for Lemma 15.31.3: if a lifted target ideal datum and a base-changed source cycle have
the same target presentation class, then their underlying target cycles differ by a diagonal
boundary. -/
private theorem target_idealSpanHom_cycle_eq_baseChanged_cycle_mod_diagonal
    (f : Fin r → B)
    (φ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B')
    (w : A' ⊗[A] koszulFirstCyclesSelf B f)
    (h :
      idealSpanHomToKoszulH1Presentation (baseChangeSequence (A := A) (A' := A') f) B' φ =
        (Submodule.Quotient.mk
          (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w) :
          koszulH1PresentationSelf B' (baseChangeSequence (A := A) (A' := A') f))) :
    ∃ y : B',
      (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w) +
          koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y =
        idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ := by
  -- Convert the presentation-class equality into an explicit diagonal correction on target cycles.
  apply target_cycles_eq_mod_diagonal (A := A) (A' := A') f
    (idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ)
    (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w)
  simpa [idealSpanHomToKoszulH1Presentation] using h

/-- Helper for Lemma 15.31.3: a target ideal-hom presentation class should lift to a
base-changed source cycle class under the flat quotient hypothesis. -/
private theorem ideal_presentation_class_lift_of_flat_quotient
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (φ : Ideal.span (Set.range (baseChangeSequence (A := A) (A' := A') f)) →ₗ[B'] B') :
    ∃ w : A' ⊗[A] koszulFirstCyclesSelf B f,
      idealSpanHomToKoszulH1Presentation (baseChangeSequence (A := A) (A' := A') f) B' φ =
        (Submodule.Quotient.mk
          (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w) :
          koszulH1PresentationSelf B' (baseChangeSequence (A := A) (A' := A') f)) := by
  -- Route correction: the old combined helper was false for trivial sequences such as `r = 1`
  -- and `f₁ = 0`. The source-faithful remaining task is only the left-term lift from
  -- `Hom_{B'}(J', B')` to the base-changed source presentation class.
  -- TODO for Lemma 15.31.3: rewrite the target ideal once via
  -- `baseChangeSequence_span_range_eq_map_span_range`, apply
  -- `ideal_span_quotient_tensor_lift_of_zero` to the extracted quotient-zero relations, and use
  -- the generator-value bridge above to identify the resulting target ideal-hom class with a
  -- base-changed source cycle class.
