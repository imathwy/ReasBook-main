/-- Helper for Lemma 15.31.3: once the target presentation class of a cycle is killed by the map
to `Hom_R(K', B')`, the remaining class should lift from the source and hence differ from a
base-changed source cycle by a diagonal boundary. -/
private theorem lifted_target_ideal_cycle_data_of_flat_quotient
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (z : koszulFirstCyclesSelf B' (baseChangeSequence f))
    (hz :
      koszulH1PresentationToHomKernel (baseChangeSequence (A := A) (A' := A') f) B'
        (Submodule.Quotient.mk z) = 0) :
    ∃ w : A' ⊗[A] koszulFirstCyclesSelf B f,
      ∃ y : B',
        ((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w +
            koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y =
          z := by
  -- Convert the kernel condition into an ideal-hom class, then lift that class back from the
  -- source and absorb the remaining quotient equalities into explicit diagonal corrections.
  have hzker :
      (Submodule.Quotient.mk z :
        koszulH1PresentationSelf B' (baseChangeSequence (A := A) (A' := A') f)) ∈
        LinearMap.ker
          (koszulH1PresentationToHomKernel (baseChangeSequence (A := A) (A' := A') f) B') := by
    exact LinearMap.mem_ker.2 hz
  rw [← idealSpanHomToKoszulH1Presentation_range_eq_ker_presentationToHomKernel
    (f := baseChangeSequence (A := A) (A' := A') f) (N := B')] at hzker
  rcases LinearMap.mem_range.1 hzker with ⟨φ, hφ⟩
  rcases ideal_presentation_class_lift_of_flat_quotient (A := A) (A' := A') f φ with ⟨w, hw⟩
  rcases target_idealSpanHom_cycle_eq_baseChanged_cycle_mod_diagonal
      (A := A) (A' := A') f φ w hw with ⟨y₁, hy₁⟩
  rcases target_cycles_eq_mod_diagonal
      (A := A) (A' := A') f z
      (idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ)
      (by
        simpa [idealSpanHomToKoszulH1Presentation] using hφ.symm) with ⟨y₂, hy₂⟩
  refine ⟨w, y₁ + y₂, ?_⟩
  -- Assemble the two diagonal corrections coming from the ideal lift and the residual quotient
  -- equality.
  calc
    ((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w +
        koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' (y₁ + y₂)
      = ((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w +
          (koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y₁ +
            koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y₂) := by
              rw [LinearMap.map_add]
    _ = ((((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w) +
          koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y₁) +
            koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y₂ := by
              simp [add_assoc]
    _ = idealSpanHomToKoszulFirstCycles (baseChangeSequence (A := A) (A' := A') f) B' φ +
          koszulDiagonalMap (baseChangeSequence (A := A) (A' := A') f) B' y₂ := by
              rw [hy₁]
    _ = z := hy₂

/-- Helper for Lemma 15.31.3: the flatness input is used only at the quotient-presentation level,
where it should imply surjectivity of the base-change map on `koszulH1Presentation`. -/
private theorem target_kernel_hom_residual_lift_of_flat_quotient
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (z : koszulFirstCyclesSelf B' (baseChangeSequence f)) :
    ∃ w : A' ⊗[A] koszulFirstCyclesSelf B f,
      koszulH1PresentationToHomKernel (baseChangeSequence (A := A) (A' := A') f) B'
        (Submodule.Quotient.mk
          (z - (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w))) =
        0 := by
  -- The remaining missing source-faithful step is the `K ⊗ A' → K'` lifting from the proof in
  -- the Stacks text: first match the target `Hom(K', B')`-component by a base-changed source
  -- cycle, then pass the residual cycle to the left-term argument above.
  -- TODO for Lemma 15.31.3: encode the tensorized exactness of
  -- `0 → K → idealGeneratorRelationModule f → Ideal.span (Set.range f) → 0` and use it to pick
  -- `w` so that the residual cycle `z - ((koszulFirstCyclesBaseChangeMap f).liftBaseChange A') w`
  -- has trivial image under `koszulH1PresentationToHomKernel`.
  sorry

/-- Helper for Lemma 15.31.3: the flatness input is used only at the quotient-presentation level,
where it should imply surjectivity of the base-change map on `koszulH1Presentation`. -/
private theorem presentation_cycle_class_lift_of_flat_quotient
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (z : koszulFirstCyclesSelf B' (baseChangeSequence f)) :
    ∃ w : A' ⊗[A] koszulFirstCyclesSelf B f, ∃ y : B',
      ((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w +
        koszulDiagonalMap (baseChangeSequence f) B' y = z := by
  -- First lift the `Hom(K', B')`-component of the target class, so the remaining residual cycle
  -- lies in the left term where the corrected helper above applies.
  rcases target_kernel_hom_residual_lift_of_flat_quotient (A := A) (A' := A') f z with
    ⟨w₀, hw₀⟩
  let z₀ : koszulFirstCyclesSelf B' (baseChangeSequence f) :=
    z - (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w₀)
  have hz₀ :
      koszulH1PresentationToHomKernel (baseChangeSequence (A := A) (A' := A') f) B'
        (Submodule.Quotient.mk z₀) = 0 := by
    simpa [z₀] using hw₀
  rcases lifted_target_ideal_cycle_data_of_flat_quotient (A := A) (A' := A') f z₀ hz₀ with
    ⟨w₁, y, hy⟩
  refine ⟨w₀ + w₁, y, ?_⟩
  -- Combine the kernel-part lift with the zero-kernel residual lift.
  calc
    ((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') (w₀ + w₁) +
        koszulDiagonalMap (baseChangeSequence f) B' y
      = (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w₀) +
          ((((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w₁) +
            koszulDiagonalMap (baseChangeSequence f) B' y) := by
              rw [LinearMap.map_add]
              simp [add_assoc]
    _ = (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w₀) + z₀ := by
              rw [hy]
    _ = z := by
              simp [z₀, sub_eq_add_neg, add_assoc, add_left_comm, add_comm]

/-- Helper for Lemma 15.31.3: the restricted-scalars target quotient map still evaluates to the
usual quotient generator on cycle representatives. -/
private theorem target_presentation_mkQ_restrictScalars_apply
    (f : Fin r → B) (z : koszulFirstCyclesSelf B' (baseChangeSequence f)) :
    ((((LinearMap.range (koszulDiagonalMap (baseChangeSequence f) B')).mkQ :
        koszulFirstCyclesSelf B' (baseChangeSequence f) →ₗ[B']
          koszulH1PresentationSelf B' (baseChangeSequence f)).restrictScalars A') z) =
      (Submodule.Quotient.mk z : koszulH1PresentationSelf B' (baseChangeSequence f)) := by
  -- The quotient equivalence for restriction of scalars fixes actual generators.
  simpa using
    (Submodule.Quotient.restrictScalarsEquiv_mk A'
      (LinearMap.range (koszulDiagonalMap (baseChangeSequence f) B')) z)

/-- Helper for Lemma 15.31.3: on quotient representatives, the presentation base-change map is
induced by the degree-one cycle map. -/
private theorem koszulH1PresentationBaseChangeMap_mk
    (f : Fin r → B) (x : koszulFirstCyclesSelf B f) :
    koszulH1PresentationBaseChangeMap (A := A) (A' := A') f (Submodule.Quotient.mk x) =
      Submodule.Quotient.mk ((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f) x) := by
  -- Unfold once: the auxiliary restrict-scalars quotients cancel on actual representatives.
  simp [koszulH1PresentationBaseChangeMap, LinearMap.comp_apply, Submodule.mapQ_apply]

/-- Helper for Lemma 15.31.3: after tensoring the source quotient map, the presentation
base-change hom sends a tensor of source cycles to the corresponding target quotient class. -/
private theorem presentation_base_change_square_commutes_on_pure_tensors
    (f : Fin r → B) (a : A') (x : koszulFirstCyclesSelf B f) :
    koszulH1PresentationBaseChangeHom (A := A) (A' := A') f
        ((LinearMap.baseChange A'
          ((LinearMap.range (koszulDiagonalMap f B)).mkQ :
            koszulFirstCyclesSelf B f →ₗ[A] koszulH1PresentationSelf B f))
          (a ⊗ₜ[A] x)) =
      ((((LinearMap.range (koszulDiagonalMap (baseChangeSequence f) B')).mkQ :
          koszulFirstCyclesSelf B' (baseChangeSequence f) →ₗ[B']
            koszulH1PresentationSelf B' (baseChangeSequence f)).restrictScalars A')
        (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A')
          (a ⊗ₜ[A] x))) := by
  -- On a pure tensor, both routes are computed by the scalar multiple of the base-changed
  -- quotient class of `x`.
  calc
    koszulH1PresentationBaseChangeHom (A := A) (A' := A') f
        ((LinearMap.baseChange A'
          ((LinearMap.range (koszulDiagonalMap f B)).mkQ :
            koszulFirstCyclesSelf B f →ₗ[A] koszulH1PresentationSelf B f))
          (a ⊗ₜ[A] x))
      = koszulH1PresentationBaseChangeHom (A := A) (A' := A') f
          (a ⊗ₜ[A]
            (Submodule.Quotient.mk x : koszulH1PresentationSelf B f)) := by
            simp [LinearMap.baseChange_tmul]
    _ = a •
          koszulH1PresentationBaseChangeMap (A := A) (A' := A') f
            (Submodule.Quotient.mk x : koszulH1PresentationSelf B f) := by
            simp [koszulH1PresentationBaseChangeHom, LinearMap.liftBaseChange_tmul]
    _ = a •
          (Submodule.Quotient.mk
            ((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f) x) :
              koszulH1PresentationSelf B' (baseChangeSequence f)) := by
            rw [koszulH1PresentationBaseChangeMap_mk]
    _ = ((((LinearMap.range (koszulDiagonalMap (baseChangeSequence f) B')).mkQ :
            koszulFirstCyclesSelf B' (baseChangeSequence f) →ₗ[B']
              koszulH1PresentationSelf B' (baseChangeSequence f)).restrictScalars A')
          (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A')
            (a ⊗ₜ[A] x))) := by
            have hmk :=
              target_presentation_mkQ_restrictScalars_apply (A := A) (A' := A') f
                (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A')
                  (a ⊗ₜ[A] x))
            simpa [LinearMap.liftBaseChange_tmul] using hmk.symm

/-- Helper for Lemma 15.31.3: after tensoring the source quotient map, the presentation
base-change hom sends a tensor of source cycles to the corresponding target quotient class. -/
private theorem koszulH1PresentationBaseChangeHom_lift_mk
    (f : Fin r → B) (w : A' ⊗[A] koszulFirstCyclesSelf B f) :
    koszulH1PresentationBaseChangeHom (A := A) (A' := A') f
        ((LinearMap.baseChange A'
          ((LinearMap.range (koszulDiagonalMap f B)).mkQ :
            koszulFirstCyclesSelf B f →ₗ[A] koszulH1PresentationSelf B f)) w) =
      ((((LinearMap.range (koszulDiagonalMap (baseChangeSequence f) B')).mkQ :
          koszulFirstCyclesSelf B' (baseChangeSequence f) →ₗ[B']
            koszulH1PresentationSelf B' (baseChangeSequence f)).restrictScalars A')
        (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w)) := by
  -- Tensor induction reduces the comparison to the pure-tensor square proved above.
  refine TensorProduct.induction_on w ?_ ?_ ?_
  · simp [koszulH1PresentationBaseChangeHom]
  · intro a x
    exact presentation_base_change_square_commutes_on_pure_tensors
      (A := A) (A' := A') f a x
  · intro x y hx hy
    simp [hx, hy]

/-- Helper for Lemma 15.31.3: a diagonal boundary vanishes in the target quotient presentation. -/
private theorem target_presentation_diagonal_eq_zero
    (f : Fin r → B) (y : B') :
    (Submodule.Quotient.mk (koszulDiagonalMap (baseChangeSequence f) B' y) :
      koszulH1PresentationSelf B' (baseChangeSequence f)) = 0 := by
  -- The quotient kills the range of the target diagonal map by definition.
  exact (Submodule.Quotient.eq _).2 ⟨y, by simp⟩

/-- Helper for Lemma 15.31.3: after reducing to representatives in the cycle quotient, the only
remaining work is the explicit cycle-lifting statement above. -/
private theorem koszulH1PresentationBaseChangeHom_surjective_of_flat_quotient
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))] :
    Function.Surjective (koszulH1PresentationBaseChangeHom (A := A) (A' := A') f) := by
  intro q
  -- Choose a target cycle representative and reduce surjectivity to the explicit decomposition of
  -- that cycle into a lifted source cycle plus a target diagonal boundary.
  obtain ⟨z, rfl⟩ :=
    Submodule.mkQ_surjective (LinearMap.range (koszulDiagonalMap (baseChangeSequence f) B')) q
  rcases presentation_cycle_class_lift_of_flat_quotient (A := A) (A' := A') f z with
    ⟨w, y, hw⟩
  refine
    ⟨(LinearMap.baseChange A'
        ((LinearMap.range (koszulDiagonalMap f B)).mkQ :
          koszulFirstCyclesSelf B f →ₗ[A] koszulH1PresentationSelf B f)) w, ?_⟩
  -- Compare quotient classes after applying the target quotient map to the cycle decomposition.
  have hq :
      (Submodule.Quotient.mk
        (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w) :
          koszulH1PresentationSelf B' (baseChangeSequence f)) =
        Submodule.Quotient.mk z := by
    have hmk :
        (Submodule.Quotient.mk
          (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w +
            koszulDiagonalMap (baseChangeSequence f) B' y) :
            koszulH1PresentationSelf B' (baseChangeSequence f)) =
          Submodule.Quotient.mk z := by
      simpa using congrArg
        (fun t : koszulFirstCyclesSelf B' (baseChangeSequence f) ↦
          (Submodule.Quotient.mk t :
            koszulH1PresentationSelf B' (baseChangeSequence f))) hw
    -- The target quotient kills the diagonal term, so only the lifted source cycle remains.
    simpa [map_add, target_presentation_diagonal_eq_zero (A := A) (A' := A') f y] using hmk
  -- Rewrite the source image by the presentation square and then substitute the quotient-class
  -- equality just proved.
  calc
    koszulH1PresentationBaseChangeHom (A := A) (A' := A') f
        ((LinearMap.baseChange A'
          ((LinearMap.range (koszulDiagonalMap f B)).mkQ :
            koszulFirstCyclesSelf B f →ₗ[A] koszulH1PresentationSelf B f)) w)
      =
        (Submodule.Quotient.mk
          (((koszulFirstCyclesBaseChangeMap (A := A) (A' := A') f).liftBaseChange A') w) :
            koszulH1PresentationSelf B' (baseChangeSequence f)) := by
          exact koszulH1PresentationBaseChangeHom_lift_mk (A := A) (A' := A') f w
    _ = Submodule.Quotient.mk z := hq

/-- Helper for Lemma 15.31.3: once surjectivity is known for the private quotient presentation,
the public owner-level map is surjective by transporting across the presentation isomorphisms. -/
private theorem koszulH1BaseChangeCore_surjective_of_flat_quotient
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))] :
    Function.Surjective (koszulH1BaseChangeCore (A := A) (A' := A') f) := by
  let eSource :=
    koszulH1IsoPresentation_sourceLinearEquiv (A := A) (B := B) f
  let eTarget :=
    koszulH1IsoPresentation_targetLinearEquiv (A := A) (A' := A') (B := B) f
  have hSource :
      Function.Surjective (LinearMap.baseChange A' eSource.toLinearMap) := by
    -- Tensoring preserves surjectivity of the source presentation isomorphism.
    exact baseChange_surjective_of_surjective (A := A) (A' := A')
      eSource.toLinearMap eSource.surjective
  have hMid :
      Function.Surjective
        (koszulH1PresentationBaseChangeHom (A := A) (A' := A') f) := by
    -- The presentation-level source proof already established the only substantive surjectivity.
    exact koszulH1PresentationBaseChangeHom_surjective_of_flat_quotient
      (A := A) (A' := A') f
  intro z
  -- First move the target owner element to the presentation model, then lift there and transport
  -- the source lift back across the tensorized source presentation isomorphism.
  obtain ⟨q, hq⟩ := eTarget.symm.surjective z
  obtain ⟨p, hp⟩ := hMid q
  obtain ⟨x, hx⟩ := hSource p
  refine ⟨x, ?_⟩
  dsimp [koszulH1BaseChangeCore, eSource, eTarget]
  rw [hx, hp]
  exact hq

variable (A A') in
/-- The canonical base-change map on the source-facing first Koszul homology owner `koszulH1`.
The quotient presentation `koszulH1Presentation` remains private support data. -/
noncomputable def koszulH1BaseChange (f : Fin r → B) :
    A' ⊗[A] koszulH1 f B →ₗ[A']
      koszulH1 (fun i : Fin r ↦ (includeRight (f i) : A' ⊗[A] B)) (A' ⊗[A] B) :=
  show A' ⊗[A] koszulH1 f B →ₗ[A']
      koszulH1 (fun i : Fin r ↦ (includeRight (f i) : A' ⊗[A] B)) (A' ⊗[A] B) from
    koszulH1BaseChangeCore f

-- Proof sketch: tensoring the owner `koszulH1(B, f)` over `A` can be computed through the
-- private quotient presentation, and flatness of `B ⧸ Ideal.span (Set.range f)` over `A` makes
-- the resulting canonical comparison map onto the base-changed first homology surjective.
variable (A A') in
/-- Lemma 15.31.3: if `B ⧸ Ideal.span (Set.range f)` is flat over `A`, then the canonical map
`A' ⊗[A] H_1(K_\\bullet(B, f)) → H_1(K_\\bullet(A' ⊗[A] B, f'))` is surjective. In Lean the public
surface is the chapter owner `koszulH1`, with the quotient presentation
used only privately to build the comparison map. -/
theorem koszulH1_baseChange_surjective_of_flat_quotient (f : Fin r → B)
    [Module.Flat A (B ⧸ Ideal.span (Set.range f))] :
    Function.Surjective (koszulH1BaseChange A A' f) := by
  -- After isolating the presentation-level flatness argument, the public theorem is only the
  -- owner-level transport statement proved above.
  simpa [koszulH1BaseChange] using
    koszulH1BaseChangeCore_surjective_of_flat_quotient (A := A) (A' := A') f

end

end RingTheory.Sequence
