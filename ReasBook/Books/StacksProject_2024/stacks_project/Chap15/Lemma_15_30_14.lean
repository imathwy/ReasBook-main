universe u

namespace Ideal

variable {A : Type u} [CommRing A]

/-- Helper for Lemma 15.30.14: the canonical list-side ideal `Ideal.ofList (List.ofFn f)` agrees
with the source-facing span ideal of the same finite family. -/
private theorem ofList_ofFn_eq_span_range_local {n : ℕ} (f : Fin n → A) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  -- Unfold both finite-generation presentations and compare the resulting membership predicates
  -- directly through `List.mem_ofFn'`.
  ext x
  simp [Ideal.ofList, List.mem_ofFn', Set.range]

end Ideal

namespace RingTheory.Sequence

variable {A : Type u} [CommRing A]

/-
Domain triage:
* primary domain: Koszul-regular finite sequences in commutative algebra and their behavior under
  quotienting by the ideal generated by an initial block;
* sampled owner declarations:
  `RingTheory.Sequence.IsKoszulRegularSequence`,
  `RingTheory.Sequence.isKoszulRegularSequence_append_of_quotient`,
  `Ideal.ofList_ofFn_eq_span_range`,
  `RingTheory.Sequence.IsQuasiRegular.tail_quotient`;
* best owner abstraction: the finite-family owner predicate `IsKoszulRegularSequence`, with the
  canonical quotient-by-prefix ideal expressed chapter-wide as `Ideal.ofList (List.ofFn f)`;
* primitive data vs derived API: the primitive source data are the families `f`, `g`, and the two
  Koszul-regularity hypotheses; the source-facing quotient by `Ideal.span (Set.range f)` is a
  derived view obtained from the owner-level quotient by `Ideal.ofList (List.ofFn f)`.
-/

-- Proof sketch: use Lemma 15.28.12 to identify the Koszul complex on `Fin.append f g` with the
-- total complex of the tensor product of the Koszul complexes on `f` and `g`. Since `f` is
-- Koszul-regular, the complex on `f` resolves `A ⧸ Ideal.span (Set.range f)`, so tensoring with the
-- complex on `g` identifies the homology with that of the Koszul complex on the image family of
-- `g` in the quotient ring. The assumed Koszul-regularity of `Fin.append f g` then forces all
-- positive homology of that quotient Koszul complex to vanish.
/-- Helper for Lemma 15.30.14: the prefix Koszul-regularity hypothesis already gives the standard
`H_1`-regular consequence for `f`. -/
private theorem prefix_isH1Regular_of_koszul {n : ℕ} (f : Fin n → A)
    (hf : IsKoszulRegularSequence f) : IsH1RegularSequence f := by
  -- This is the direct Chapter 15 bridge `Koszul-regular => H₁-regular`.
  exact isH1RegularSequence_of_isKoszulRegularSequence hf

/-- Helper for Lemma 15.30.14: the appended Koszul-regularity hypothesis likewise gives the
standard `H_1`-regular consequence for `Fin.append f g`. -/
private theorem append_isH1Regular_of_koszul {n m : ℕ} (f : Fin n → A) (g : Fin m → A)
    (hfg : IsKoszulRegularSequence (Fin.append f g)) :
    IsH1RegularSequence (Fin.append f g) := by
  -- This keeps the degree-one vanishing consequence of the target hypotheses available while the
  -- higher-homology comparison is still missing.
  exact isH1RegularSequence_of_isKoszulRegularSequence hfg

private theorem isKoszulRegularSequence_quotient_of_append_ofList {n m : ℕ} (f : Fin n → A)
    (g : Fin m → A) (hf : IsKoszulRegularSequence f)
    (hfg : IsKoszulRegularSequence (Fin.append f g)) :
    IsKoszulRegularSequence (fun i ↦ Ideal.Quotient.mk (Ideal.ofList (List.ofFn f)) (g i)) := by
  -- Route correction: the stable local frontier is now the degree-one `H₁`-regular consequences of
  -- the two Koszul hypotheses. The source-faithful next step should either use the quotient `H₁`
  -- theorem of Lemma `15.30.12` or the Chapter `10/15` bridge from `H₁`-regularity to
  -- quasi-regularity, but both prerequisite files currently fail their own single-file checks in
  -- this workspace (`Lemma_15_30_12.lean` has unresolved category-instance / `hExtZero` errors,
  -- and `Lemma_15_30_6.lean` has unresolved tensor/Koszul proof obligations), so the
  -- higher-homology upgrade cannot be carried out from this file alone.
  have hprefix_h1 : IsH1RegularSequence f :=
    prefix_isH1Regular_of_koszul f hf
  have happend_h1 : IsH1RegularSequence (Fin.append f g) :=
    append_isH1Regular_of_koszul f g hfg
  -- TODO(Lemma 15.30.14): follow the textbook bicomplex route to compare the quotient-side
  -- Koszul complex on `g mod (f)` with the tensor total complex resolving `A/(f,g)`, and use the
  -- appended Koszul-regularity hypothesis to kill every positive quotient-side homology object.
  -- The first missing prerequisite is a compiling earlier-owner bridge that exposes the quotient
  -- tail as either `H₁`-regular or quasi-regular in a stable importable form; once that is
  -- available, the current local prefix/appended `H₁` consequences above can feed directly into
  -- the source proof's higher-homology comparison.
  sorry

/-- Lemma 15.30.14: if both `f_1, \ldots, f_n` and the concatenated family
`f_1, \ldots, f_n, g_1, \ldots, g_m` are Koszul-regular sequences in `A`, then the images of
`g_1, \ldots, g_m` in `A / (f_1, \ldots, f_n)` form a Koszul-regular sequence. -/
theorem isKoszulRegularSequence_quotient_of_append {n m : ℕ} (f : Fin n → A) (g : Fin m → A)
    (hf : IsKoszulRegularSequence f) (hfg : IsKoszulRegularSequence (Fin.append f g)) :
    IsKoszulRegularSequence (fun i ↦ Ideal.Quotient.mk (Ideal.span (Set.range f)) (g i)) := by
  rw [← Ideal.ofList_ofFn_eq_span_range_local f]
  exact isKoszulRegularSequence_quotient_of_append_ofList f g hf hfg

end RingTheory.Sequence
