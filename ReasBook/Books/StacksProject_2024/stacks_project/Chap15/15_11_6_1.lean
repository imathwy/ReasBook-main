import Mathlib.Algebra.Algebra.Prod
import Mathlib.RingTheory.Etale.Basic
import Mathlib.RingTheory.FinitePresentation
import Mathlib.RingTheory.Idempotents
import Mathlib.RingTheory.Ideal.IdempotentFG
import Mathlib.RingTheory.TensorProduct.Quotient

-- Declarations for this item will be appended below by the statement pipeline.

open scoped TensorProduct

universe u v

section

variable {A : Type u} {A' : Type v} [CommRing A] [CommRing A'] [Algebra A A']
variable (I : Ideal A)

/-
Domain-style sampling for 15.11.6.1:
- primary domain: commutative algebra of étale quotient sections and product decompositions cut
  out by split quotients and the idempotents they determine;
- sampled owner declarations:
  `Algebra.TensorProduct.quotIdealMapEquivQuotTensor`,
  `AlgHom.liftOfSurjective`,
  `AlgHom.extendScalarsOfSurjective`,
  `Algebra.FinitePresentation.ker_fG_of_surjective`,
  `Ideal.quotientKerAlgEquivOfSurjective`,
  `AlgEquiv.prodQuotientOfIsIdempotentElem`;
- best owner abstraction: the quotient algebra is canonically the base change
  `(A ⧸ I) ⊗[A] A'`, so its étale structure should be inherited from the base-change owner
  `Algebra.TensorProduct.quotIdealMapEquivQuotTensor`; the descended section to `A ⧸ I` is bridge
  data obtained from `AlgHom.liftOfSurjective` and `AlgHom.extendScalarsOfSurjective`, after which
  the idempotent kernel and product decomposition are owned by
  `Algebra.FinitePresentation.ker_fG_of_surjective`,
  `Ideal.quotientKerAlgEquivOfSurjective`, and
  `AlgEquiv.prodQuotientOfIsIdempotentElem`;
- primitive data: the `A`-algebra section `σ : A' →ₐ[A] A ⧸ I`;
- derived API: the descended quotient retraction, its idempotent kernel, and the first-projection
  compatibility are companion bridge data rather than the source-facing payload.

Source/core/bridge triage:
- `source-facing`: the existence of the quotient decomposition `A' / I A' ≃ (A / I) × C`;
- `core/canonical`: the base-change equivalence
  `Algebra.TensorProduct.quotIdealMapEquivQuotTensor`, the kernel quotient owner
  `Ideal.quotientKerAlgEquivOfSurjective`, and the idempotent product owner
  `AlgEquiv.prodQuotientOfIsIdempotentElem`;
- `bridge/view`: the descended quotient map obtained from the quotient universal property via
  `AlgHom.liftOfSurjective`, upgraded to an `(A ⧸ I)`-algebra retraction by
  `AlgHom.extendScalarsOfSurjective`.
-/

local notation "Abar" => A ⧸ I
local notation "Q" => A' ⧸ Ideal.map (algebraMap A A') I

-- Proof sketch: identify `Q` with the base change `(A ⧸ I) ⊗[A] A'`, so `Q` is étale over
-- `A ⧸ I`. The given `A`-algebra map `σ : A' → A / I` descends to an `(A / I)`-algebra retraction
-- `Q → A / I`. After viewing `A / I` as a `Q`-algebra via that retraction, formal étaleness shows
-- its kernel ideal is idempotent; finite presentation upgrades that ideal to one generated by an
-- idempotent element, and `AlgEquiv.prodQuotientOfIsIdempotentElem` yields the product
-- decomposition with complementary factor `C`.
/-- Helper for 15.11.6.1: the ideal `I A'` is killed by the section `σ : A' → A / I`. -/
private theorem ideal_map_le_section_ker
    (σ : A' →ₐ[A] Abar) :
    Ideal.map (algebraMap A A') I ≤ RingHom.ker σ.toRingHom := by
  -- Reduce the quotient-compatibility to the defining relation `I = 0` inside `A / I`.
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  change σ ((algebraMap A A') x) = 0
  rw [σ.commutes]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hx

/-- Helper for 15.11.6.1: the section `σ` descends to the quotient `A' / I A'` as an
`A`-algebra map. -/
private noncomputable def quotientSectionA
    (σ : A' →ₐ[A] Abar) :
    Q →ₐ[A] Abar :=
  Ideal.Quotient.liftₐ (Ideal.map (algebraMap A A') I) σ fun _ hx ↦
    ideal_map_le_section_ker (I := I) σ hx

/-- Helper for 15.11.6.1: the descended section is naturally an `(A / I)`-algebra map. -/
private noncomputable def quotientSection
    (σ : A' →ₐ[A] Abar) :
    Q →ₐ[Abar] Abar :=
  AlgHom.extendScalarsOfSurjective (Ideal.Quotient.mkₐ_surjective A I)
    (quotientSectionA (I := I) σ)

/-- Helper for 15.11.6.1: the descended quotient section is a retraction of the canonical
`A / I`-algebra map. -/
private theorem quotient_section_retraction
    (σ : A' →ₐ[A] Abar) :
    ∀ x : Abar, quotientSection (I := I) σ (algebraMap Abar Q x) = x := by
  -- Check the identity on quotient representatives of `A / I`.
  intro x
  refine Quotient.inductionOn' x ?_
  intro a
  simp [quotientSection, quotientSectionA]

/-- Helper for 15.11.6.1: the quotient `A' / I A'` is étale over `A / I` via the canonical
base-change equivalence. -/
private theorem quotient_etale
    [Algebra.Etale A A'] :
    Algebra.Etale Abar Q := by
  -- Transport the base-changed étale structure back across the quotient-tensor equivalence.
  let e : Q ≃ₐ[Abar] TensorProduct A Abar A' :=
    Algebra.TensorProduct.quotIdealMapEquivQuotTensor A' I
  letI : Algebra.Etale Abar (TensorProduct A Abar A') := Algebra.Etale.baseChange A A' Abar
  exact Algebra.Etale.of_equiv e.symm

/-- Helper for 15.11.6.1: the canonical map `A / I → A' / I A'` is finite type. -/
private theorem quotient_algebraMap_finiteType
    [Algebra.Etale A A'] :
    (algebraMap Abar Q).FiniteType := by
  -- First use the étale structure on the quotient to obtain the finite-type instance.
  letI : Algebra.Etale Abar Q := quotient_etale (A := A) (A' := A') (I := I)
  have hft : Algebra.FiniteType Abar Q := by
    infer_instance
  -- Then rewrite the algebra structure attached to `algebraMap` to the ambient quotient instance.
  have hAlg : (algebraMap Abar Q).toAlgebra = (inferInstance : Algebra Abar Q) := by
    apply Algebra.algebra_ext
    intro x
    rfl
  rw [RingHom.FiniteType, hAlg]
  exact hft

/-- Helper for 15.11.6.1: a quotient retraction `τ : Q → A / I` is finitely presented over
`A / I`. -/
private theorem quotient_section_finite_presentation
    [Algebra.Etale A A']
    (τ : Q →ₐ[Abar] Abar)
    (hτ : ∀ x : Abar, τ (algebraMap Abar Q x) = x) :
    τ.FinitePresentation := by
  letI : Algebra.Etale Abar Q := quotient_etale (A := A) (A' := A') (I := I)
  -- The section identity identifies `τ ∘ (A / I → Q)` with the identity of `A / I`.
  have hcompEq : τ.comp (Algebra.ofId Abar Q) = AlgHom.id Abar Abar :=
    AlgHom.ext hτ
  have hcomp : (τ.comp (Algebra.ofId Abar Q)).FinitePresentation := by
    rw [hcompEq]
    simpa [AlgHom.FinitePresentation, RingHom.FinitePresentation] using
      (inferInstance : Algebra.FinitePresentation Abar Abar)
  -- The source map `A / I → Q` is finite type because `Q` is étale over `A / I`.
  have hft : (Algebra.ofId Abar Q).FiniteType := by
    simpa [AlgHom.FiniteType] using
      quotient_algebraMap_finiteType (A := A) (A' := A') (I := I)
  exact AlgHom.FinitePresentation.of_comp_finiteType (Algebra.ofId Abar Q) hcomp hft

/-- Helper for 15.11.6.1: the kernel of an étale quotient retraction is generated by an
idempotent element. -/
private theorem kernel_span_idempotent_of_etale_retraction
    [Algebra.Etale A A']
    (τ : Q →ₐ[Abar] Abar)
    (hτ : ∀ x : Abar, τ (algebraMap Abar Q x) = x) :
    ∃ e : Q, IsIdempotentElem e ∧ RingHom.ker τ.toRingHom = Ideal.span ({e} : Set Q) := by
  letI : Algebra.Etale Abar Q := quotient_etale (A := A) (A' := A') (I := I)
  letI : Algebra Q Abar := τ.toRingHom.toAlgebra
  letI : IsScalarTower Abar Q Abar :=
    IsScalarTower.of_algebraMap_eq fun x ↦ by
      change x = τ (algebraMap Abar Q x)
      simp [hτ x]
  letI : Algebra.FormallyEtale Abar Abar := by
    -- The identity map is formally étale by the cotangent characterization.
    rw [Algebra.formallyEtale_iff]
    constructor <;> infer_instance
  -- The retraction immediately gives surjectivity.
  have hsurj : Function.Surjective τ := by
    intro x
    exact ⟨algebraMap Abar Q x, hτ x⟩
  have hsurjQ : Function.Surjective (algebraMap Q Abar) := by
    simpa using hsurj
  -- Formal étaleness of the retract makes the kernel ideal idempotent.
  have hfe : Algebra.FormallyEtale Q Abar :=
    Algebra.FormallyEtale.of_restrictScalars (R := Abar) (A := Q) (B := Abar)
  have hkerIdem : IsIdempotentElem (RingHom.ker τ.toRingHom) := by
    simpa using ((Algebra.FormallyEtale.iff_of_surjective hsurjQ).mp hfe)
  -- Finite presentation upgrades the idempotent ideal to a principal idempotent ideal.
  have hτfp : τ.FinitePresentation :=
    quotient_section_finite_presentation (A := A) (A' := A') (I := I) τ hτ
  have hfg : (RingHom.ker τ.toRingHom).FG := by
    exact Algebra.FinitePresentation.ker_fG_of_surjective τ hsurj
  rcases (Ideal.isIdempotentElem_iff_of_fg _ hfg).mp hkerIdem with ⟨e, he, hspan⟩
  exact ⟨e, he, hspan⟩

/-- 15.11.6.1: if an étale `A`-algebra `A'` admits an `A`-algebra map to `A / I`, then the
quotient `A' / I A'` is canonically isomorphic, as an `A / I`-algebra, to `(A / I) × C`, where
the complementary factor is the quotient by the complement of a distinguished idempotent of
`A' / I A'`. The first-projection compatibility with the base `(A ⧸ I)`-algebra structure is a
derived consequence of this owner-level formulation. -/
theorem exists_quotient_product_decomposition_of_etale_section
    [Algebra.Etale A A']
    (σ : A' →ₐ[A] A ⧸ I) :
    ∃ e : Q,
      IsIdempotentElem e ∧
        ∃ productDecomposition :
            Q ≃ₐ[Abar] (Abar × (Q ⧸ Ideal.span ({1 - e} : Set Q))),
          ∀ x : Abar, (productDecomposition (algebraMap Abar Q x)).1 = x := by
  -- Route correction: descend the section to the quotient first, then split along the
  -- idempotent generator of its kernel.
  let τ : Q →ₐ[Abar] Abar := quotientSection (I := I) σ
  have hτ : ∀ x : Abar, τ (algebraMap Abar Q x) = x :=
    quotient_section_retraction (A := A) (A' := A') (I := I) σ
  -- The kernel of the quotient retraction is generated by an idempotent element.
  obtain ⟨e, he, hker⟩ :=
    kernel_span_idempotent_of_etale_retraction
      (A := A) (A' := A') (I := I) τ hτ
  have hsurj : Function.Surjective τ := by
    intro x
    exact ⟨algebraMap Abar Q x, hτ x⟩
  -- Reidentify the first quotient factor with `A / I` and keep the complementary idempotent
  -- quotient as the second factor.
  let firstFactor : (Q ⧸ Ideal.span ({e} : Set Q)) ≃ₐ[Abar] Abar :=
    (Ideal.quotientEquivAlgOfEq Abar hker.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hsurj)
  let split :
      Q ≃ₐ[Abar]
        ((Q ⧸ Ideal.span ({e} : Set Q)) × (Q ⧸ Ideal.span ({1 - e} : Set Q))) :=
    AlgEquiv.prodQuotientOfIsIdempotentElem Abar he he.one_sub
      (by simp)
      (by simp [mul_sub, he.eq])
  let productDecomposition :
      Q ≃ₐ[Abar] (Abar × (Q ⧸ Ideal.span ({1 - e} : Set Q))) :=
    split.trans <|
      AlgEquiv.prodCongr firstFactor
        (AlgEquiv.refl (R := Abar) (A₁ := Q ⧸ Ideal.span ({1 - e} : Set Q)))
  refine ⟨e, he, productDecomposition, ?_⟩
  -- On the first coordinate, the canonical split recovers the retraction `τ`.
  intro x
  change firstFactor ((split (algebraMap Abar Q x)).1) = x
  simp [firstFactor, split]

end
