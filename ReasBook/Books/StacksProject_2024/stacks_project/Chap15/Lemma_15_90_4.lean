/-- Helper for Lemma 15.90.4: equality of zero loci upgrades the Koszul homology support bound to
`I`-power torsion. -/
private theorem koszulComplex_homology_isIdealPowerTorsion_of_zeroLocus_eq
    (I : Ideal R) {r : ℕ} (f : Fin r → R)
    (hI_fg : I.FG)
    (hV : PrimeSpectrum.zeroLocus (Ideal.span (Set.range f) : Set R) =
      PrimeSpectrum.zeroLocus (I : Set R))
    (n : ℕ) :
    Module.IsIdealPowerTorsion I ((K^•(f)).homology n) := by
  have hsupp :
      Module.support R ((K^•(f)).homology n) ⊆
        PrimeSpectrum.zeroLocus (Ideal.span (Set.range f) : Set R) := by
    intro p hp
    rw [PrimeSpectrum.mem_zeroLocus]
    intro x hx
    obtain ⟨m, hm⟩ := Module.mem_support_iff_exists_annihilator.mp hp
    have hx_ann :
        x ∈ Module.annihilator R ((K^•(f)).homology n) :=
      ideal_span_le_annihilator_koszulComplex_homology (f := f) n hx
    -- Proof comment: the annihilator containment from Lemma `15.28.6` forces every support prime
    -- to contain the ideal generated by the `f i`.
    have hxm : x • m = 0 := (Module.mem_annihilator.mp hx_ann) m
    exact hm ((Submodule.mem_annihilator_span_singleton _ _).mpr hxm)
  have hsuppI :
      Module.support R ((K^•(f)).homology n) ⊆ PrimeSpectrum.zeroLocus (I : Set R) := by
    simpa [hV] using hsupp
  -- Proof comment: finite generation of `I` converts the support bound into the torsion property.
  exact
    (Module.isIdealPowerTorsion_iff_support_subset_zeroLocus I hI_fg).2 hsuppI

