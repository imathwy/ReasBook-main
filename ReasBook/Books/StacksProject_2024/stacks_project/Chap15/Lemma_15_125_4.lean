/-- Helper for Lemma 15.125.4: include the direct sum over a finite subtype back into the ambient
direct sum. -/
private noncomputable def finsetDirectSumInclusion
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    (S : Finset ι) :
    (⨁ j : {j // j ∈ S}, A j.1) →ₗ[R] (⨁ j : ι, A j) :=
  DirectSum.toModule R {j // j ∈ S} (⨁ j : ι, A j) fun s ↦
    DirectSum.lof R ι A s.1

/-- Helper for Lemma 15.125.4: restrict an ambient direct sum to the finite subtype cut out by a
finite set of indices. -/
private noncomputable def finsetDirectSumRestriction
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    (S : Finset ι) :
    (⨁ j : ι, A j) →ₗ[R] (⨁ j : {j // j ∈ S}, A j.1) :=
  DirectSum.toModule R ι (⨁ j : {j // j ∈ S}, A j.1) fun j ↦
    if hj : j ∈ S then
      DirectSum.lof R {k // k ∈ S} (fun k ↦ A k.1) ⟨j, hj⟩
    else
      0

/-- Helper for Lemma 15.125.4: the finite-support inclusion sends a subtype summand basis vector
to the corresponding ambient summand basis vector. -/
@[simp] private theorem finsetDirectSumInclusion_lof
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    (S : Finset ι) (s : {j // j ∈ S}) (x : A s.1) :
    finsetDirectSumInclusion (R := R) A S
        (DirectSum.lof R {j // j ∈ S} (fun j ↦ A j.1) s x) =
      DirectSum.lof R ι A s.1 x := by
  -- The inclusion is defined by `DirectSum.toModule`, so it evaluates on basis vectors directly.
  simp [finsetDirectSumInclusion]

/-- Helper for Lemma 15.125.4: restricting an ambient basis vector indexed inside `S` lands in
the matching finite subtype summand. -/
@[simp] private theorem finsetDirectSumRestriction_lof_of_mem
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    (S : Finset ι) {j : ι} (hj : j ∈ S) (x : A j) :
    finsetDirectSumRestriction (R := R) A S (DirectSum.lof R ι A j x) =
      DirectSum.lof R {k // k ∈ S} (fun k ↦ A k.1) ⟨j, hj⟩ x := by
  -- On a retained summand, the restriction is the corresponding coprojection.
  simp [finsetDirectSumRestriction, hj]

/-- Helper for Lemma 15.125.4: restricting an ambient basis vector indexed outside `S` kills that
summand. -/
@[simp] private theorem finsetDirectSumRestriction_lof_of_not_mem
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    (S : Finset ι) {j : ι} (hj : j ∉ S) (x : A j) :
    finsetDirectSumRestriction (R := R) A S (DirectSum.lof R ι A j x) = 0 := by
  -- A basis vector outside the chosen finite carrier is discarded by the restriction map.
  simp [finsetDirectSumRestriction, hj]

/-- Helper for Lemma 15.125.4: restricting to a finite subtype and then including back preserves
the coordinates indexed by that finite set. -/
@[simp] private theorem finsetDirectSumInclusion_restriction_apply_of_mem
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    (S : Finset ι) (x : ⨁ j : ι, A j) {a : ι} (ha : a ∈ S) :
    finsetDirectSumInclusion (R := R) A S
        (finsetDirectSumRestriction (R := R) A S x) a = x a := by
  -- Induct over the ambient direct sum, where the retained coordinates are exactly those in `S`.
  refine DirectSum.induction_on x ?_ ?_ ?_
  · simp
  · intro j y
    by_cases hj : j ∈ S
    · by_cases hja : j = a
      · subst hja
        simp [finsetDirectSumRestriction, finsetDirectSumInclusion, hj, ha]
      · simp [finsetDirectSumRestriction, finsetDirectSumInclusion, hj, hja]
    · simp [finsetDirectSumRestriction, hj]
  · intro x y hx hy
    simp [hx, hy]

/-- Helper for Lemma 15.125.4: restricting to a finite subtype and then including back kills the
coordinates outside that finite set. -/
@[simp] private theorem finsetDirectSumInclusion_restriction_apply_of_not_mem
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    (S : Finset ι) (x : ⨁ j : ι, A j) {a : ι} (ha : a ∉ S) :
    finsetDirectSumInclusion (R := R) A S
        (finsetDirectSumRestriction (R := R) A S x) a = 0 := by
  -- The same induction now shows every discarded coordinate stays zero after inclusion.
  refine DirectSum.induction_on x ?_ ?_ ?_
  · simp
  · intro j y
    by_cases hj : j ∈ S
    · have hja : j ≠ a := fun hja ↦ ha (hja ▸ hj)
      simp [finsetDirectSumRestriction, finsetDirectSumInclusion, hj, hja]
    · simp [finsetDirectSumRestriction, hj]
  · intro x y hx hy
    simp [hx, hy]

/-- Helper for Lemma 15.125.4: if finitely many vectors generate `M` and each generator image
under the retract inclusion is supported in `S`, then every image is supported in `S`. -/
lemma finite_support_union_contains_retract_image
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    {n : ℕ} (g : Fin n → M)
    (hg : Submodule.span R (Set.range g) = ⊤)
    (i : M →ₗ[R] (⨁ j : ι, A j))
    (S : Finset ι)
    (hS : ∀ t, (i (g t)).support ⊆ S) :
    ∀ x : M, (i x).support ⊆ S := by
  classical
  have hsurj : Function.Surjective (Fintype.linearCombination R g) := by
    -- The spanning family `g` is equivalent to surjectivity of the standard finite linear
    -- combination map.
    simpa using (span_range_eq_top_iff_surjective_fintypeLinearCombination R g).1 hg
  intro x a ha
  rcases hsurj x with ⟨c, rfl⟩
  by_contra haS
  have hcoord_generator : ∀ t, i (g t) a = 0 := by
    intro t
    by_contra hnonzero
    exact haS (hS t (DFinsupp.mem_support_iff.mpr hnonzero))
  have hcoord :
      i (Fintype.linearCombination R g c) a = 0 := by
    -- After expanding `x` in the chosen generators, every summand has zero `a`-coordinate.
    calc
      i (Fintype.linearCombination R g c) a = (∑ t, c t • i (g t)) a := by
        simp [Fintype.linearCombination_apply, map_sum, map_smul]
      _ = ∑ t, c t • (i (g t) a) := by
            simp
      _ = 0 := by
            refine Finset.sum_eq_zero ?_
            intro t ht
            simp [hcoord_generator t]
  exact (DFinsupp.mem_support_iff.mp ha) hcoord

/-- Helper for Lemma 15.125.4: a map into a direct sum whose image is supported in `S` factors
through the direct sum over the finite subtype `S`. -/
lemma factor_through_finite_directSum_support
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    (i : M →ₗ[R] (⨁ j : ι, A j))
    (S : Finset ι)
    (hS : ∀ x : M, (i x).support ⊆ S) :
    ∃ iS : M →ₗ[R] (⨁ j : {j // j ∈ S}, A j.1),
      finsetDirectSumInclusion (R := R) A S ∘ₗ iS = i := by
  classical
  let iS : M →ₗ[R] (⨁ j : {j // j ∈ S}, A j.1) :=
    (finsetDirectSumRestriction (R := R) A S).comp i
  refine ⟨iS, ?_⟩
  apply LinearMap.ext
  intro x
  ext a
  by_cases ha : a ∈ S
  · -- On retained coordinates, restrict-then-include is literally the identity.
    simp [iS, finsetDirectSumInclusion_restriction_apply_of_mem, ha]
  · have hnot : a ∉ (i x).support := fun hmem ↦ ha (hS x hmem)
    have hcoord : i x a = 0 := by
      by_contra hnonzero
      exact hnot (DFinsupp.mem_support_iff.mpr hnonzero)
    -- Outside `S`, the support bound forces the original coordinate to vanish as well.
    simp [iS, finsetDirectSumInclusion_restriction_apply_of_not_mem, ha, hcoord]

/-- Helper for Lemma 15.125.4: if a finite module is a retract of an arbitrary direct sum, the
retract already lands in a finite subsum. -/
lemma finite_retract_of_finite_module_directSum
    {ι : Type*} (A : ι → Type*) [∀ i, AddCommGroup (A i)] [∀ i, Module R (A i)]
    [Module.Finite R M]
    (i : M →ₗ[R] (⨁ j : ι, A j))
    (s : (⨁ j : ι, A j) →ₗ[R] M)
    (hs : s.comp i = LinearMap.id) :
    ∃ (n : ℕ) (f : Fin n → ι)
      (i' : M →ₗ[R] (⨁ j : Fin n, A (f j)))
      (s' : (⨁ j : Fin n, A (f j)) →ₗ[R] M),
      s'.comp i' = LinearMap.id := by
  classical
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := R) (M := M)
  let S : Finset ι := Finset.univ.biUnion fun t : Fin n ↦ (i (g t)).support
  have hS_generators : ∀ t, (i (g t)).support ⊆ S := by
    intro t a ha
    -- Each generator support is one term in the defining finite union for `S`.
    exact Finset.mem_biUnion.mpr ⟨t, Finset.mem_univ _, ha⟩
  have hsupport :
      ∀ x : M, (i x).support ⊆ S := by
    -- Once the chosen generators are controlled, every linear combination is controlled too.
    exact finite_support_union_contains_retract_image
      (R := R) (A := A) g hg i S hS_generators
  obtain ⟨iS, hiS⟩ :=
    factor_through_finite_directSum_support (R := R) (A := A) i S hsupport
  let sS : (⨁ j : {j // j ∈ S}, A j.1) →ₗ[R] M :=
    s.comp (finsetDirectSumInclusion (R := R) A S)
  have hsS : sS.comp iS = LinearMap.id := by
    -- Replace `i` by its finite-support factorization inside the given retract identity.
    calc
      sS.comp iS = s.comp ((finsetDirectSumInclusion (R := R) A S).comp iS) := by
        rw [sS, LinearMap.comp_assoc]
      _ = s.comp i := by
        rw [hiS]
      _ = LinearMap.id := hs
  let e :
      (⨁ j : {j // j ∈ S}, A j.1) ≃ₗ[R]
        (⨁ j : Fin S.card, A (((Finset.equivFin S).symm j).1)) :=
    DirectSum.lequivCongrLeft R (Finset.equivFin S)
  refine ⟨S.card, fun j ↦ ((Finset.equivFin S).symm j).1,
    e.toLinearMap.comp iS, sS.comp e.symm.toLinearMap, ?_⟩
  have heid : e.symm.toLinearMap.comp e.toLinearMap = LinearMap.id := by
    -- The direct-sum reindexing is an honest linear equivalence, so its inverse cancels.
    apply LinearMap.ext
    intro x
    exact e.symm_apply_apply x
  -- Reindex the finite subtype by `Fin S.card` without changing the retract identity.
  calc
    (sS.comp e.symm.toLinearMap).comp (e.toLinearMap.comp iS)
        = sS.comp ((e.symm.toLinearMap.comp e.toLinearMap).comp iS) := by
            rw [LinearMap.comp_assoc, LinearMap.comp_assoc]
    _ = sS.comp iS := by
          rw [heid, LinearMap.id_comp]
    _ = LinearMap.id := hsS

-- Proof sketch: by the bridge theorem
-- `directSummand_iff_surjective_compRight_of_principalPure_shortExact`, it
-- suffices to prove the required lifting property for `M`. Check surjectivity after localization
-- at each maximal ideal using the locality result of Algebra, Lemma `10.23.1`; finite
-- presentation identifies localized `Hom` with `Hom` out of the localized module, and the owner
-- lemma `finitelyPresented_module_exists_linearEquiv_directSum_principal_quotients` gives that
-- each `M_m` is a finite direct sum of principal quotients over `Localization.AtPrime m`. Apply
-- Lemma `15.125.1` locally to obtain the chapter's canonical split-data conclusion, then shrink
-- the indexing set to a finite subset because `M` is finite.
/-- Lemma 15.125.4: if every localization of `R` at a maximal ideal is a generalized valuation
ring, then every finitely presented `R`-module is a direct summand of a finite direct sum of
principal quotient modules `R ⧸ (fᵢ)`. -/
theorem finitelyPresented_module_directSummand_finite_directSum_principal_quotients_of_maximal_localizations_preValuationRing
    (hR : ∀ (m : Ideal R) (_ : m.IsMaximal), PreValuationRing (Localization.AtPrime m)) :
    ∃ (n : ℕ) (f : Fin n → R)
      (i : M →ₗ[R] (⨁ j : Fin n, R ⧸ principalIdeal (f j)))
      (s : (⨁ j : Fin n, R ⧸ principalIdeal (f j)) →ₗ[R] M),
      s.comp i = LinearMap.id := by
  classical
  have hsplit :
      ∃ (ι : Type (max u v)) (r : ι → R)
        (i : M →ₗ[R] (⨁ j : ι, R ⧸ principalIdeal (r j)))
        (s : (⨁ j : ι, R ⧸ principalIdeal (r j)) →ₗ[R] M),
        s.comp i = LinearMap.id := by
    refine
      (directSummand_iff_surjective_compRight_of_principalPure_shortExact
        (R := R) (P := M)).2 ?_
    intro S hS hi
    have hsurj_local :
        ∀ (m : Ideal R) [m.IsMaximal],
          Function.Surjective
            (LocalizedModule.map m.primeCompl
              (LinearMap.compRight R S.g.hom :
                (M →ₗ[R] S.X₂) →ₗ[R] (M →ₗ[R] S.X₃))) := by
      intro m hm
      exact atPrime_surjective_compRight_of_preValuationRing
        (R := R) (M := M) hS hi m (hR m hm)
    have hsurj :
        Function.Surjective
          (LinearMap.compRight R S.g.hom :
            (M →ₗ[R] S.X₂) →ₗ[R] (M →ₗ[R] S.X₃)) := by
      let hTfae :=
        surjective_localization_tfae
          (LinearMap.compRight R S.g.hom :
            (M →ₗ[R] S.X₂) →ₗ[R] (M →ₗ[R] S.X₃))
      exact (hTfae.out 2 0).mp hsurj_local
    exact hsurj
  obtain ⟨ι, r, i, s, hs⟩ := hsplit
  obtain ⟨n, g, i', s', hs'⟩ :=
    finite_retract_of_finite_module_directSum (R := R)
      (A := fun j : ι ↦ R ⧸ principalIdeal (r j)) i s hs
  exact ⟨n, fun j ↦ r (g j), i', s', hs'⟩

end
