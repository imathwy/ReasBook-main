variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.FinitePresentation R M]

/-- Helper for Lemma 15.125.4: localizing a principal ideal at a maximal ideal keeps it principal
with the localized generator. -/
lemma atPrime_map_principalIdeal
    (m : Ideal R) [m.IsPrime] (r : R) :
    Ideal.map (algebraMap R (Localization.AtPrime m)) (principalIdeal r) =
      principalIdeal (algebraMap R (Localization.AtPrime m) r) := by
  -- Localization commutes with the span of a singleton generator.
  simp [principalIdeal, Ideal.map_span, Set.image_singleton]

/-- Helper for Lemma 15.125.4: a principal ideal generated by a localization fraction is already
the image of a principal ideal from the base ring. -/
lemma atPrime_principalIdeal_mk'_eq_map
    (m : Ideal R) [m.IsPrime] (r : R) (s : m.primeCompl) :
    principalIdeal (IsLocalization.mk' (Localization.AtPrime m) r s) =
      Ideal.map (algebraMap R (Localization.AtPrime m)) (principalIdeal r) := by
  have hunit : IsUnit (IsLocalization.mk' (Localization.AtPrime m) 1 s) := by
    letI : Invertible (IsLocalization.mk' (Localization.AtPrime m) 1 s) :=
      IsLocalization.invertible_mk'_one s
    exact isUnit_of_invertible (IsLocalization.mk' (Localization.AtPrime m) 1 s)
  -- Clear the denominator by rewriting the fraction as a unit multiple of the numerator image.
  calc
    principalIdeal (IsLocalization.mk' (Localization.AtPrime m) r s) =
        principalIdeal
          ((algebraMap R (Localization.AtPrime m) r) *
            IsLocalization.mk' (Localization.AtPrime m) 1 s) := by
          rw [IsLocalization.mk'_eq_mul_mk'_one]
    _ = principalIdeal (algebraMap R (Localization.AtPrime m) r) := by
          simpa [principalIdeal] using
            Ideal.span_singleton_mul_right_unit hunit
              (algebraMap R (Localization.AtPrime m) r)
    _ = Ideal.map (algebraMap R (Localization.AtPrime m)) (principalIdeal r) := by
          symm
          exact atPrime_map_principalIdeal (R := R) m r

/-- Helper for Lemma 15.125.4: localizing the defining zero composite of a short complex keeps
that composite zero. -/
lemma atPrime_shortComplex_maps_comp_eq_zero
    {S : ShortComplex (ModuleCat R)}
    (m : Ideal R) [m.IsPrime] :
    LocalizedModule.map m.primeCompl S.g.hom ∘ₗ
        LocalizedModule.map m.primeCompl S.f.hom = 0 := by
  -- Surjective generators of the localized source reduce the claim to denominator fractions.
  ext x
  rcases IsLocalizedModule.mk'_surjective m.primeCompl
      (LocalizedModule.mkLinearMap m.primeCompl S.X₁) x with ⟨⟨y, s⟩, rfl⟩
  change
    (IsLocalizedModule.map m.primeCompl
        (LocalizedModule.mkLinearMap m.primeCompl S.X₂)
        (LocalizedModule.mkLinearMap m.primeCompl S.X₃)
        S.g.hom)
      (((LocalizedModule.map m.primeCompl) S.f.hom)
        (IsLocalizedModule.mk' (LocalizedModule.mkLinearMap m.primeCompl S.X₁) y s)) = 0
  change
    (IsLocalizedModule.map m.primeCompl
        (LocalizedModule.mkLinearMap m.primeCompl S.X₂)
        (LocalizedModule.mkLinearMap m.primeCompl S.X₃)
        S.g.hom)
      ((IsLocalizedModule.map m.primeCompl
          (LocalizedModule.mkLinearMap m.primeCompl S.X₁)
          (LocalizedModule.mkLinearMap m.primeCompl S.X₂)
          S.f.hom)
        (IsLocalizedModule.mk' (LocalizedModule.mkLinearMap m.primeCompl S.X₁) y s)) = 0
  rw [IsLocalizedModule.map_mk', IsLocalizedModule.map_mk']
  change IsLocalizedModule.mk' (LocalizedModule.mkLinearMap m.primeCompl S.X₃)
      ((S.g.hom ∘ₗ S.f.hom) y) s = 0
  have hzero : S.g.hom ∘ₗ S.f.hom = 0 := by
    ext z
    exact congrArg (fun h : S.X₁ ⟶ S.X₃ => h z) S.zero
  rw [hzero]
  simp

/-- Helper for Lemma 15.125.4: localizing a short exact sequence at a maximal ideal preserves
short exactness. -/
lemma atPrime_shortExact_of_shortExact
    {S : ShortComplex (ModuleCat R)} (hS : S.ShortExact) (m : Ideal R) [m.IsMaximal] :
    let T : ShortComplex (ModuleCat (Localization.AtPrime m)) :=
      CategoryTheory.ShortComplex.moduleCatMk
        (LocalizedModule.map m.primeCompl S.f.hom)
        (LocalizedModule.map m.primeCompl S.g.hom)
        (atPrime_shortComplex_maps_comp_eq_zero (R := R) (S := S) m)
    T.ShortExact := by
  -- Localize exactness, injectivity, and surjectivity termwise.
  dsimp
  apply ModuleCat.shortComplex_shortExact
  · have hExact :
        Function.Exact (S.f.hom : S.X₁ →ₗ[R] S.X₂) (S.g.hom : S.X₂ →ₗ[R] S.X₃) := by
        exact
          (CategoryTheory.ShortComplex.ShortExact.moduleCat_exact_iff_function_exact S).1
            hS.exact
    simpa using LocalizedModule.map_exact m.primeCompl S.f.hom S.g.hom hExact
  · simpa using LocalizedModule.map_injective m.primeCompl S.f.hom hS.moduleCat_injective_f
  · simpa using LocalizedModule.map_surjective m.primeCompl S.g.hom hS.moduleCat_surjective_g
/-- Helper for Lemma 15.125.4: principal-purity survives localization at a maximal ideal. -/
lemma atPrime_isPrincipalPure_of_isPrincipalPure
    {X Y : Type*} [AddCommGroup X] [Module R X] [AddCommGroup Y] [Module R Y]
    (f : X →ₗ[R] Y) (hf : LinearMap.IsPrincipalPure f) (m : Ideal R) [m.IsMaximal] :
    LinearMap.IsPrincipalPure (LocalizedModule.map m.primeCompl f) := by
  -- Route correction: localize the source equality only after first reducing the localized scalar
  -- to a fraction generator `mk' r s`; this keeps the transport confined to owner lemmas for
  -- localized ideals and localized ranges.
  intro z
  obtain ⟨⟨r, s⟩, rfl⟩ := IsLocalization.mk'_surjective m.primeCompl z
  let locY : Y →ₗ[R] LocalizedModule.AtPrime m Y := LocalizedModule.mkLinearMap m.primeCompl Y
  have hrange :
      Submodule.localized' (Localization.AtPrime m) m.primeCompl locY f.range =
        (LocalizedModule.map m.primeCompl f).range := by
    -- Compare the localized image owner with the actual range by passing through the carrier-level
    -- `localized₀` description from `LinearMap.range_localizedMap_eq_localized₀_range`.
    ext x
    change x ∈ Submodule.localized' (Localization.AtPrime m) m.primeCompl locY f.range ↔
      x ∈ ((LocalizedModule.map m.primeCompl f).range : Set (LocalizedModule.AtPrime m Y))
    have hrange0 :
        ((LocalizedModule.map m.primeCompl f).range : Set (LocalizedModule.AtPrime m Y)) =
          (Submodule.localized₀ m.primeCompl locY f.range :
            Set (LocalizedModule.AtPrime m Y)) := by
      change
        (((LinearMap.restrictScalars R (LocalizedModule.map m.primeCompl f)).range :
          Submodule R (LocalizedModule.AtPrime m Y)) :
            Set (LocalizedModule.AtPrime m Y)) =
          (Submodule.localized₀ m.primeCompl locY f.range :
            Set (LocalizedModule.AtPrime m Y))
      exact congrArg
        (fun K : Submodule R (LocalizedModule.AtPrime m Y) =>
          (K : Set (LocalizedModule.AtPrime m Y)))
        (LinearMap.range_localizedMap_eq_localized₀_range
          (p := m.primeCompl)
          (f := LocalizedModule.mkLinearMap m.primeCompl X)
          (f' := locY)
          (g := f))
    rw [Submodule.mem_localized', hrange0]
    change (∃ y ∈ f.range, ∃ t, IsLocalizedModule.mk' locY y t = x) ↔
      x ∈ Submodule.localized₀ m.primeCompl locY f.range
    rw [Submodule.mem_localized₀]
  have hloc := congrArg
      (Submodule.localized' (Localization.AtPrime m) m.primeCompl locY) (hf r)
  -- Now every term in the localized equality is rewritten by the owner localization lemmas, and
  -- the chosen denominator is absorbed by the principal-ideal transport from the previous helper.
  simpa [locY, hrange, atPrime_principalIdeal_mk'_eq_map, atPrime_map_principalIdeal,
    Submodule.localized'_smul, Submodule.localized'_inf, Submodule.localized'_top,
    Ideal.localized'_eq_map] using hloc

/-- Helper for Lemma 15.125.4: on denominator-`1` generators, transporting localized
postcomposition through the finite-presentation `Hom` comparison agrees with local
postcomposition. -/
lemma atPrime_compRight_conjugate_apply_mk_apply_mk
    {S : ShortComplex (ModuleCat R)}
    (m : Ideal R) [m.IsPrime]
    (φ : M →ₗ[R] S.X₂) (x : M) :
    let e₂ :
        LocalizedModule m.primeCompl (M →ₗ[R] S.X₂) ≃ₗ[Localization.AtPrime m]
          (LocalizedModule.AtPrime m M →ₗ[Localization.AtPrime m]
            LocalizedModule.AtPrime m S.X₂) :=
      LinearEquiv.extendScalarsOfIsLocalization m.primeCompl (Localization.AtPrime m)
        (Module.FinitePresentation.linearEquivMapExtendScalars
          (M := M) (N := S.X₂) m.primeCompl)
    let e₃ :
        LocalizedModule m.primeCompl (M →ₗ[R] S.X₃) ≃ₗ[Localization.AtPrime m]
          (LocalizedModule.AtPrime m M →ₗ[Localization.AtPrime m]
            LocalizedModule.AtPrime m S.X₃) :=
      LinearEquiv.extendScalarsOfIsLocalization m.primeCompl (Localization.AtPrime m)
        (Module.FinitePresentation.linearEquivMapExtendScalars
          (M := M) (N := S.X₃) m.primeCompl)
    (e₃
        (LocalizedModule.map m.primeCompl
          (LinearMap.compRight R S.g.hom :
            (M →ₗ[R] S.X₂) →ₗ[R] (M →ₗ[R] S.X₃))
          (LocalizedModule.mk φ 1)))
      (LocalizedModule.mk x 1) =
      (LocalizedModule.map m.primeCompl S.g.hom)
        ((e₂ (LocalizedModule.mk φ 1)) (LocalizedModule.mk x 1)) := by
  dsimp
  -- First normalize the localized postcomposition map on the source `Hom` generator `φ`.
  rw [LocalizedModule.map_mk, LinearEquiv.extendScalarsOfIsLocalization_apply]
  rw [show (Module.FinitePresentation.linearEquivMapExtendScalars
      (M := M) (N := S.X₃) m.primeCompl)
      (LocalizedModule.mk ((LinearMap.compRight R S.g.hom) φ) 1) =
      (IsLocalizedModule.mapExtendScalars m.primeCompl
        (LocalizedModule.mkLinearMap m.primeCompl M)
        (LocalizedModule.mkLinearMap m.primeCompl S.X₃)
        (Localization.AtPrime m))
        ((LinearMap.compRight R S.g.hom) φ) by
      simpa using Module.FinitePresentation.linearEquivMapExtendScalars_apply
        (S := m.primeCompl) (f := (LinearMap.compRight R S.g.hom) φ)]
  rw [LinearEquiv.extendScalarsOfIsLocalization_apply]
  rw [show (Module.FinitePresentation.linearEquivMapExtendScalars
      (M := M) (N := S.X₂) m.primeCompl)
      (LocalizedModule.mk φ 1) =
      (IsLocalizedModule.mapExtendScalars m.primeCompl
        (LocalizedModule.mkLinearMap m.primeCompl M)
        (LocalizedModule.mkLinearMap m.primeCompl S.X₂)
        (Localization.AtPrime m))
        φ by
      simpa using Module.FinitePresentation.linearEquivMapExtendScalars_apply
        (S := m.primeCompl) (f := φ)]
  have hleft :
      ((IsLocalizedModule.mapExtendScalars m.primeCompl
          (LocalizedModule.mkLinearMap m.primeCompl M)
          (LocalizedModule.mkLinearMap m.primeCompl S.X₃)
          (Localization.AtPrime m))
        ((LinearMap.compRight R S.g.hom) φ))
        (LocalizedModule.mk x 1)) =
      LocalizedModule.mk (((LinearMap.compRight R S.g.hom) φ) x) 1 := by
    -- Evaluate the transported postcomposition map on the denominator-`1` generator `x`.
    change ((LinearMap.restrictScalars R
        ((IsLocalizedModule.mapExtendScalars m.primeCompl
          (LocalizedModule.mkLinearMap m.primeCompl M)
          (LocalizedModule.mkLinearMap m.primeCompl S.X₃)
          (Localization.AtPrime m))
          ((LinearMap.compRight R S.g.hom) φ)))
        (LocalizedModule.mk x 1)) = _
    simpa using
      LinearMap.congr_fun
        (IsLocalizedModule.map_comp m.primeCompl
          (LocalizedModule.mkLinearMap m.primeCompl M)
          (LocalizedModule.mkLinearMap m.primeCompl S.X₃)
          ((LinearMap.compRight R S.g.hom) φ))
        x
  have hright :
      ((IsLocalizedModule.mapExtendScalars m.primeCompl
          (LocalizedModule.mkLinearMap m.primeCompl M)
          (LocalizedModule.mkLinearMap m.primeCompl S.X₂)
          (Localization.AtPrime m))
        φ
        (LocalizedModule.mk x 1)) =
      LocalizedModule.mk (φ x) 1 := by
    -- The transported source map evaluates on `x` exactly as the original `φ`.
    change ((LinearMap.restrictScalars R
        ((IsLocalizedModule.mapExtendScalars m.primeCompl
          (LocalizedModule.mkLinearMap m.primeCompl M)
          (LocalizedModule.mkLinearMap m.primeCompl S.X₂)
          (Localization.AtPrime m))
          φ))
        (LocalizedModule.mk x 1)) = _
    simpa using
      LinearMap.congr_fun
        (IsLocalizedModule.map_comp m.primeCompl
          (LocalizedModule.mkLinearMap m.primeCompl M)
          (LocalizedModule.mkLinearMap m.primeCompl S.X₂)
          φ)
        x
  -- After both normalizations, the claim is the literal compatibility of localization with
  -- postcomposition by `S.g`.
  rw [hleft, hright, LocalizedModule.map_mk]
  simp [LinearMap.compRight_apply]

