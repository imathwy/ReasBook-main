/-- Helper for Lemma 15.8.9: a coordinate linear map is the linear combination of the images of
the standard basis vectors. -/
lemma fintype_linearCombination_std_basis_eq {α : Type*} [Fintype α] [DecidableEq α]
    (σ : (α → R) →ₗ[R] M) :
    Fintype.linearCombination R (fun i ↦ σ (Pi.single i (1 : R))) = σ := by
  -- Evaluate the linear-combination map on an arbitrary coordinate vector and rewrite it as the
  -- image of the usual basis expansion of that vector.
  apply LinearMap.ext
  intro x
  calc
    (Fintype.linearCombination R (fun i ↦ σ (Pi.single i (1 : R)))) x
        = ∑ i, x i • σ (Pi.single i (1 : R)) := by
            simp [Fintype.linearCombination_apply]
    _ = ∑ i, σ (x i • (Pi.single i (1 : R) : α → R)) := by
      congr with i
      exact (σ.map_smul (x i) (Pi.single i (1 : R) : α → R)).symm
    _ = σ (∑ i, x i • (Pi.single i (1 : R) : α → R)) := by
      symm
      simp only [map_sum]
    _ = σ x := by
      congr 1
      ext i
      simpa [Pi.single_apply, mul_comm] using (Fintype.sum_pi_single (i := i) (f := x))

/-- Helper for Lemma 15.8.9: if `M` is a quotient of `R^n` and `n ≤ k`, then every quotient of
`M` is generated by `k` elements. -/
lemma quotient_span_eq_top_of_surjective_fin_of_le {N : Submodule R M} {n : ℕ}
    (hnk : n ≤ k) (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π) :
    ∃ v : Fin k → M ⧸ N, Submodule.span R (Set.range v) = ⊤ := by
  let ρ : (Fin k → R) →ₗ[R] (Fin n → R) :=
    LinearMap.pi fun i : Fin n ↦ LinearMap.proj (Fin.castLE hnk i)
  have hρ : Function.Surjective ρ := by
    -- Extend a coordinate vector on `Fin n` by zero on the remaining coordinates.
    intro y
    refine ⟨fun i ↦ if h : i.1 < n then y ⟨i.1, h⟩ else 0, ?_⟩
    ext i
    simp [ρ]
  let σ : (Fin k → R) →ₗ[R] M ⧸ N := (Submodule.mkQ N).comp (π.comp ρ)
  have hσ : Function.Surjective σ := by
    -- Surjectivity is preserved under the padded source map and the quotient map.
    exact (Submodule.mkQ_surjective N).comp (hπ.comp hρ)
  refine ⟨fun i ↦ σ (Pi.single i (1 : R)), ?_⟩
  -- The quotient is spanned by the images of the padded coordinate basis.
  rw [span_range_eq_top_iff_surjective_fintypeLinearCombination]
  simpa [fintype_linearCombination_std_basis_eq (σ := σ)] using hσ

/-- Helper for Lemma 15.8.9: if `(f)` is contained in the annihilator of `M`, then every element
of `M` is `f`-torsion. -/
lemma torsionBy_eq_top_of_principalIdeal_le_annihilator
    (hann : principalIdeal f ≤ Module.annihilator R M) :
    Submodule.torsionBy R M f = ⊤ := by
  -- The generator `f` of the principal ideal acts by zero on all elements of `M`.
  ext x
  constructor
  · intro hx
    simp
  · intro hx
    rw [Submodule.mem_torsionBy_iff]
    have hfann : f ∈ Module.annihilator R M := by
      exact hann (Ideal.subset_span (by simp))
    exact (Module.mem_annihilator (R := R) (M := M)).1 hfann x

/-- Helper for Lemma 15.8.9: if all of `M` is `f`-torsion, then the quotient by `f`-torsion is the
zero module and is generated by `0` elements. -/
lemma zero_generators_of_torsionBy_eq_top
    (htop : Submodule.torsionBy R M f = ⊤) :
    ∃ v : Fin 0 → M ⧸ Submodule.torsionBy R M f,
      Submodule.span R (Set.range v) = ⊤ := by
  haveI : Subsingleton (M ⧸ Submodule.torsionBy R M f) := by
    rw [htop]
    infer_instance
  refine ⟨fun i ↦ Fin.elim0 i, ?_⟩
  -- In the zero quotient, every element equals `0`, so the empty family spans `⊤`.
  apply top_unique
  intro x
  have hx : x = 0 := Subsingleton.elim _ _
  simpa [hx] using
    (Submodule.zero_mem
      (Submodule.span R
        (Set.range (fun i : Fin 0 ↦ (Fin.elim0 i :
          M ⧸ Submodule.torsionBy R M f)))))

/-- Helper for Lemma 15.8.9: if the quotient submodule is all of `M`, then the quotient is the
zero module, so any prescribed number of zero classes generates it. -/
lemma generators_of_quotient_eq_top {N : Submodule R M} (hN : N = ⊤) :
    ∃ v : Fin k → M ⧸ N, Submodule.span R (Set.range v) = ⊤ := by
  haveI : Subsingleton (M ⧸ N) := by
    rw [hN]
    infer_instance
  refine ⟨fun _ ↦ 0, ?_⟩
  -- In the zero quotient every class vanishes, so the zero family already spans `⊤`.
  apply top_unique
  intro x
  have hx : x = 0 := Subsingleton.elim _ _
  simp [hx]

/-- Helper for Lemma 15.8.9: a finite module over `R` admits a surjective coordinate presentation
from some finite free module `R^n`. -/
lemma exists_coordinate_surjection :
    ∃ n : ℕ, ∃ π : (Fin n → R) →ₗ[R] M, Function.Surjective π := by
  -- Choose a finite generating set of `M`, view the associated linear-combination map as a
  -- surjection from a finite coordinate module, and then replace the finite index type by `Fin n`.
  rcases (Submodule.fg_def.mp (Module.Finite.fg_top (R := R) (M := M))) with ⟨S, hSfin, hSspan⟩
  let s : Finset M := hSfin.toFinset
  let v0 : s → M := fun x ↦ x.1
  have hv0 : Submodule.span R (Set.range v0) = ⊤ := by
    -- The chosen finite set generates exactly the same span as the original finite generating set.
    rw [← hSspan]
    congr 1
    ext x
    constructor
    · intro hx
      rcases hx with ⟨y, rfl⟩
      exact (Set.Finite.mem_toFinset hSfin).1 y.2
    · intro hx
      refine ⟨⟨x, (Set.Finite.mem_toFinset hSfin).2 hx⟩, rfl⟩
  have hsurj0 : Function.Surjective (Fintype.linearCombination R v0) := by
    -- A spanning family yields a surjective coordinate linear-combination map.
    exact (span_range_eq_top_iff_surjective_fintypeLinearCombination R v0).1 hv0
  let e : s ≃ Fin (Fintype.card s) := Fintype.equivFin s
  let π0 : (s → R) →ₗ[R] M := Fintype.linearCombination R v0
  refine ⟨Fintype.card s, π0.comp (LinearEquiv.funCongrLeft (R := R) (M := R) e).toLinearMap, ?_⟩
  -- Transport surjectivity across the equivalence between the finite index type and `Fin n`.
  intro x
  rcases hsurj0 x with ⟨y, rfl⟩
  refine ⟨fun i ↦ y (e.symm i), ?_⟩
  change π0 ((LinearMap.funLeft R R e) (fun i ↦ y (e.symm i))) = π0 y
  congr 1
  ext j
  simp [LinearMap.funLeft_apply]

/-- Helper for Lemma 15.8.9: the kernel vectors of a presentation map assemble into the canonical
matrix whose minors generate the presentation Fitting ideal. -/
abbrev presentationKernelMatrix {n : ℕ} (π : (Fin n → R) →ₗ[R] M) :
    Matrix (Fin n) (LinearMap.ker π) R :=
  fun i x ↦ x.1 i

/-- Helper for Lemma 15.8.9: every concrete presentation minor lies in `(f)` once the whole
presentation Fitting ideal equals `(f)`. -/
lemma presentation_minor_mem_principal_of_presentationFittingIdeal_eq_principalIdeal
    {n : ℕ} (π : (Fin n → R) →ₗ[R] M)
    (hπfit : presentationFittingIdeal R M k π = principalIdeal f)
    (rows : Fin (n - k) ↪ Fin n) (cols : Fin (n - k) ↪ LinearMap.ker π) :
    (((presentationKernelMatrix (R := R) π).submatrix rows cols).det) ∈
      principalIdeal f := by
  -- The chosen determinant is one of the generators of the presentation Fitting ideal.
  have hminor :
      (((presentationKernelMatrix (R := R) π).submatrix rows cols).det) ∈
        presentationFittingIdeal R M k π := by
    simpa [presentationFittingIdeal] using
      (Matrix.det_submatrix_mem_minorIdeal (n - k)
        (presentationKernelMatrix (R := R) π) rows cols)
  -- Rewrite that generator membership through the principal-ideal hypothesis.
  simpa [hπfit] using hminor

/-- Helper for Lemma 15.8.9: membership of `f` in the presentation Fitting ideal gives a
finite-support expression of `f` as a sum of actual presentation minors. -/
lemma exists_finsupp_presentation_minor_combination_eq
    {n : ℕ} (π : (Fin n → R) →ₗ[R] M)
    (hπfit : presentationFittingIdeal R M k π = principalIdeal f) :
    ∃ c : ((Fin (n - k) ↪ Fin n) × (Fin (n - k) ↪ LinearMap.ker π)) →₀ R,
      c.sum (fun p a ↦
        a * (((presentationKernelMatrix (R := R) π).submatrix p.1 p.2).det)) = f := by
  have hf_mem : f ∈ presentationFittingIdeal R M k π := by
    -- The principal-ideal equality puts the generator `f` itself into the presentation ideal.
    simpa [hπfit, principalIdeal] using
      (Ideal.mem_span_singleton_self f : f ∈ Ideal.span ({f} : Set R))
  -- Unfold the determinantal owner and extract the finite-support span witness.
  rw [presentationFittingIdeal, Matrix.minorIdeal] at hf_mem
  exact Finsupp.mem_ideal_span_range_iff_exists_finsupp.mp hf_mem

/-- Helper for Lemma 15.8.9: in a local ring, a nonzero element written as a finite linear
combination of elements of `(f)` has one supporting term that is unit-associated to `f`. -/
lemma exists_unit_associated_minor_of_finsupp_combination
    {α : Type*} (δ : α → R) (c : α →₀ R)
    (hsum : c.sum (fun i a ↦ a * δ i) = f)
    (hδ : ∀ i ∈ c.support, δ i ∈ principalIdeal f) (hf0 : f ≠ 0) :
    ∃ i ∈ c.support, ∃ u : Rˣ, δ i = (u : R) * f := by
  classical
  by_contra hnot
  let b : α → R := fun i ↦
    if hi : i ∈ c.support then
      Classical.choose (Ideal.mem_span_singleton'.mp (by simpa [principalIdeal] using hδ i hi))
    else 0
  have hb_mul : ∀ i ∈ c.support, b i * f = δ i := by
    intro i hi
    simp only [b, dif_pos hi]
    exact Classical.choose_spec
      (Ideal.mem_span_singleton'.mp (by simpa [principalIdeal] using hδ i hi))
  have hb_nonunit : ∀ i ∈ c.support, ¬ IsUnit (b i) := by
    intro i hi hbi
    rcases hbi with ⟨u, hu⟩
    refine hnot ⟨i, hi, u, ?_⟩
    simpa [hu] using (hb_mul i hi).symm
  let s : R := c.sum (fun i a ↦ a * b i)
  have hs_mul : s * f = f := by
    -- Rewrite the finite sum through the chosen coefficients inside `(f)`.
    calc
      s * f = c.sum (fun i a ↦ (a * b i) * f) := by
        simpa [s] using
          (Finsupp.sum_mul (b := f) (s := c) (f := fun i a ↦ a * b i))
      _ = c.sum (fun i a ↦ a * δ i) := by
        rw [Finsupp.sum, Finsupp.sum]
        refine Finset.sum_congr rfl ?_
        intro i hi
        rw [mul_assoc, hb_mul i hi]
      _ = f := hsum
  have hs_mem_max : s ∈ IsLocalRing.maximalIdeal R := by
    -- Every supporting coefficient `b i` is a nonunit, so the whole sum stays in the maximal ideal.
    unfold s
    refine Ideal.sum_mem _ ?_
    intro i hi
    have hbi_mem : b i ∈ IsLocalRing.maximalIdeal R := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact hb_nonunit i hi
    exact Ideal.mul_mem_left _ _ hbi_mem
  have hs_nonunit : ¬ IsUnit s := by
    rw [← mem_nonunits_iff, ← IsLocalRing.mem_maximalIdeal]
    exact hs_mem_max
  have h_one_sub : IsUnit (1 - s) := by
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self s with hs_unit | h_one_sub
    · exact (hs_nonunit hs_unit).elim
    · exact h_one_sub
  have hzero : (1 - s) * f = 0 := by
    calc
      (1 - s) * f = f - s * f := by ring
      _ = 0 := by rw [hs_mul, sub_self]
  rcases h_one_sub with ⟨u, hu⟩
  have hf_zero : f = 0 := by
    calc
      f = (↑u⁻¹ : R) * (↑u * f) := by
        simp [mul_assoc]
      _ = (↑u⁻¹ : R) * ((1 - s) * f) := by rw [hu]
      _ = 0 := by simp [hzero]
  exact hf0 hf_zero

/-- Helper for Lemma 15.8.9: a chosen row embedding `Fin (n - k) ↪ Fin n` extends to an explicit
row split `Fin (n - k) ⊕ Fin k ≃ Fin n`. -/
lemma selected_minor_row_reindex {n : ℕ} (rows : Fin (n - k) ↪ Fin n) (hkn : k < n) :
    ∃ rowComp : Fin k ↪ Fin n, ∃ eRows : Fin (n - k) ⊕ Fin k ≃ Fin n,
      (∀ i, eRows (Sum.inl i) = rows i) ∧
      (∀ j, eRows (Sum.inr j) = rowComp j) := by
  classical
  let RowRange : Type := {i : Fin n // i ∈ Set.range rows}
  let RowCompType : Type := {i : Fin n // i ∉ Set.range rows}
  let rowRangeEquiv : Fin (n - k) ≃ RowRange := by
    refine
      { toFun := fun i ↦ ⟨rows i, ⟨i, rfl⟩⟩
        invFun := fun i ↦ Classical.choose i.2
        left_inv := ?_
        right_inv := ?_ }
    · intro i
      apply rows.injective
      simpa using
        (Classical.choose_spec (show rows i ∈ Set.range rows from ⟨i, rfl⟩))
    · intro i
      apply Subtype.ext
      simpa using Classical.choose_spec i.2
  let rowSubtypeSplit : Fin n ≃ RowRange ⊕ RowCompType := by
    refine
      { toFun := fun i ↦
          if h : i ∈ Set.range rows then Sum.inl ⟨i, h⟩ else Sum.inr ⟨i, h⟩
        invFun := fun s ↦ match s with
          | Sum.inl i => i.1
          | Sum.inr i => i.1
        left_inv := ?_
        right_inv := ?_ }
    · intro i
      by_cases h : i ∈ Set.range rows
      · simp [h]
      · simp [h]
    · intro s
      cases s with
      | inl i =>
          simp [i.2]
      | inr i =>
          simp [i.2]
  have hcardRange : Fintype.card RowRange = n - k := by
    simpa [RowRange] using (Fintype.card_congr rowRangeEquiv).symm
  have hcardSplit :
      Fintype.card RowRange + Fintype.card RowCompType = n := by
    -- Split `Fin n` into the chosen rows and their complement.
    simpa [Fintype.card_sum] using (Fintype.card_congr rowSubtypeSplit.symm)
  have hcardComp : Fintype.card RowCompType = k := by
    rw [hcardRange] at hcardSplit
    omega
  let rowCompEquiv : Fin k ≃ RowCompType := (Fintype.equivFinOfCardEq hcardComp).symm
  let rowComp : Fin k ↪ Fin n :=
    { toFun := fun j ↦ (rowCompEquiv j).1
      inj' := by
        intro i j hij
        apply rowCompEquiv.injective
        apply Subtype.ext
        simpa using hij }
  let eRows : Fin (n - k) ⊕ Fin k ≃ Fin n :=
    (Equiv.sumCongr rowRangeEquiv rowCompEquiv).trans rowSubtypeSplit.symm
  refine ⟨rowComp, eRows, ?_, ?_⟩
  · intro i
    -- The left summand is exactly the originally chosen row embedding.
    simp [eRows, rowSubtypeSplit, rowRangeEquiv]
  · intro j
    -- The right summand records the complementary row embedding.
    simp [eRows, rowSubtypeSplit, rowComp, rowCompEquiv]

/-- Helper for Lemma 15.8.9: this item needs the determinant-trick row replacement formula from
Lemma `10.15.6`, so we keep a local copy here instead of importing an additional theorem file. -/
private theorem lower_block_mul_adjugate_apply_local {m l : ℕ}
    (A : Matrix (Fin m ⊕ Fin l) (Fin m) R)
    (i : Fin l) (j : Fin m) :
    (A.toRows₂ * A.toRows₁.adjugate) i j = (A.toRows₁.updateRow j (A.toRows₂ i)).det := by
  -- Rewrite the lower block entry as a Cramer coordinate, then invoke the standard determinant
  -- formula for replacing one row of the top square block.
  calc
    (A.toRows₂ * A.toRows₁.adjugate) i j = Matrix.vecMul (A.toRows₂ i) A.toRows₁.adjugate j := by
      rw [Matrix.mul_apply, Matrix.vecMul, dotProduct]
    _ = Matrix.mulVec A.toRows₁.transpose.adjugate (A.toRows₂ i) j := by
      rw [← Matrix.adjugate_transpose, ← Matrix.mulVec_transpose]
    _ = (A.toRows₁.transpose.cramer (A.toRows₂ i)) j := by
      simpa using
        (congr_fun (Matrix.cramer_eq_adjugate_mulVec A.toRows₁.transpose (A.toRows₂ i)).symm j)
    _ = (A.toRows₁.updateRow j (A.toRows₂ i)).det := by
      simpa using Matrix.cramer_transpose_apply A.toRows₁ (A.toRows₂ i) j

/-- Helper for Lemma 15.8.9: multiplying by the adjugate of the top square block gives the
row-partitioned matrix used in the source proof. -/
private theorem mul_adjugate_top_block_eq_fromRows_local {m l : ℕ}
    (A : Matrix (Fin m ⊕ Fin l) (Fin m) R) :
    A * A.toRows₁.adjugate =
      Matrix.fromRows (A.toRows₁.det • 1)
        (A.toRows₂ * A.toRows₁.adjugate) := by
  -- This is the companion block identity from the same determinant-trick argument.
  simpa [Matrix.fromRows_toRows, A.toRows₁.mul_adjugate] using
    (Matrix.fromRows_mul A.toRows₁ A.toRows₂ A.toRows₁.adjugate)

/-- Helper for Lemma 15.8.9: after reindexing the selected rows to the top block, replacing the
`j`th selected row by the complementary row `rowComp i` is exactly `updateRow`. -/
lemma selected_presentation_minor_replaceRow_eq_updateRow
    {n : ℕ} (π : (Fin n → R) →ₗ[R] M)
    (rows : Fin (n - k) ↪ Fin n) (cols : Fin (n - k) ↪ LinearMap.ker π)
    (rowComp : Fin k ↪ Fin n) (eRows : Fin (n - k) ⊕ Fin k ≃ Fin n)
    (heRows_left : ∀ i, eRows (Sum.inl i) = rows i)
    (heRows_right : ∀ j, eRows (Sum.inr j) = rowComp j)
    (A0 : Matrix (Fin (n - k) ⊕ Fin k) (Fin (n - k)) R)
    (hA0 :
      A0 = Matrix.reindex eRows.symm (Equiv.refl _)
        (fun r t ↦ ((cols t : LinearMap.ker π) : Fin n → R) r))
    (i : Fin k) (j : Fin (n - k)) :
    ∃ rowsReplace : Fin (n - k) ↪ Fin n,
      ((presentationKernelMatrix (R := R) π).submatrix rowsReplace cols) =
        A0.toRows₁.updateRow j (A0.toRows₂ i) := by
  classical
  subst A0
  have hrowComp_ne_rows : ∀ i : Fin k, ∀ j : Fin (n - k), rowComp i ≠ rows j := by
    intro i' j' hij
    have hsum : Sum.inr i' = Sum.inl j' := eRows.injective <| by
      rw [heRows_right, heRows_left, hij]
    cases hsum
  let rowReplacement : Fin (n - k) → Fin n :=
    fun s ↦ if hs : s = j then rowComp i else rows s
  let rowsReplace : Fin (n - k) ↪ Fin n :=
    { toFun := rowReplacement
      inj' := by
        intro s t hst
        by_cases hs : s = j
        · subst s
          by_cases ht : t = j
          · simpa [ht]
          · have hneq : rowComp i ≠ rows t := hrowComp_ne_rows i t
            have : rowComp i = rows t := by
              simpa [rowReplacement, ht] using hst
            exact (hneq this).elim
        · by_cases ht : t = j
          · subst t
            have hneq : rowComp i ≠ rows s := hrowComp_ne_rows i s
            have : rowComp i = rows s := by
              simpa [rowReplacement, hs] using hst.symm
            exact (hneq this).elim
          · exact rows.injective <| by simpa [rowReplacement, hs, ht] using hst }
  refine ⟨rowsReplace, ?_⟩
  -- Compare the replacement minor and `updateRow` entrywise, separating the replaced row from the
  -- untouched selected rows.
  ext s t
  by_cases hs : s = j
  · subst s
    rw [Matrix.submatrix_apply, presentationKernelMatrix, Matrix.updateRow_self,
      Matrix.toRows₂_apply, Matrix.reindex_apply, Matrix.submatrix_apply]
    change ((cols t : LinearMap.ker π) : Fin n → R) (rowReplacement j) =
      ((cols t : LinearMap.ker π) : Fin n → R) (eRows (Sum.inr i))
    simp [rowReplacement]
    simpa using
      congrArg (fun x ↦ ((cols t : LinearMap.ker π) : Fin n → R) x) (heRows_right i).symm
  · simp only [Matrix.submatrix_apply, presentationKernelMatrix, Matrix.updateRow_apply, hs,
      Matrix.toRows₁_apply, Matrix.reindex_apply, Matrix.submatrix_apply]
    change ((cols t : LinearMap.ker π) : Fin n → R) (rowReplacement s) =
      ((cols t : LinearMap.ker π) : Fin n → R) (eRows (Sum.inl s))
    simp [rowReplacement, hs]
    simpa using
      congrArg (fun x ↦ ((cols t : LinearMap.ker π) : Fin n → R) x) (heRows_left s).symm

/-- Helper for Lemma 15.8.9: every lower adjugate-block entry of the reindexed selected minor is
again a presentation minor, hence belongs to `(f)`. -/
lemma lower_block_entries_mem_principal_of_selected_presentation_minor
    {n : ℕ} (π : (Fin n → R) →ₗ[R] M)
    (hπfit : presentationFittingIdeal R M k π = principalIdeal f)
    (rows : Fin (n - k) ↪ Fin n) (cols : Fin (n - k) ↪ LinearMap.ker π)
    (rowComp : Fin k ↪ Fin n) (eRows : Fin (n - k) ⊕ Fin k ≃ Fin n)
    (heRows_left : ∀ i, eRows (Sum.inl i) = rows i)
    (heRows_right : ∀ j, eRows (Sum.inr j) = rowComp j)
    (A0 : Matrix (Fin (n - k) ⊕ Fin k) (Fin (n - k)) R)
    (hA0 :
      A0 = Matrix.reindex eRows.symm (Equiv.refl _)
        (fun r t ↦ ((cols t : LinearMap.ker π) : Fin n → R) r))
    (i : Fin k) (j : Fin (n - k)) :
    (A0.toRows₂ * A0.toRows₁.adjugate) i j ∈ principalIdeal f := by
  -- Route correction: the remaining source step is to identify the row-replacement determinant
  -- with a literal presentation minor before invoking the Fitting-ideal hypothesis.
  rw [lower_block_mul_adjugate_apply_local]
  rcases selected_presentation_minor_replaceRow_eq_updateRow
      (R := R) (M := M) (k := k) π rows cols rowComp eRows
      heRows_left heRows_right A0 hA0 i j with
    ⟨rowsReplace, hrowsReplace⟩
  rw [← hrowsReplace]
  exact presentation_minor_mem_principal_of_presentationFittingIdeal_eq_principalIdeal
    (R := R) (M := M) (k := k) (f := f) π hπfit rowsReplace cols

/-- Helper for Lemma 15.8.9: principal-ideal membership of the lower block can be unpacked into
explicit coefficients once and for all. -/
lemma lower_block_coefficients_of_selected_minor
    {n : ℕ} (A0 : Matrix (Fin (n - k) ⊕ Fin k) (Fin (n - k)) R)
    (hlower :
      ∀ i : Fin k, ∀ j : Fin (n - k),
        (A0.toRows₂ * A0.toRows₁.adjugate) i j ∈ principalIdeal f) :
    ∃ b : Fin k → Fin (n - k) → R, ∀ i j,
      (A0.toRows₂ * A0.toRows₁.adjugate) i j = b i j * f := by
  classical
  have hcoeff :
      ∀ i : Fin k, ∀ j : Fin (n - k),
        ∃ b : R, b * f = (A0.toRows₂ * A0.toRows₁.adjugate) i j := by
    intro i j
    simpa [principalIdeal] using Ideal.mem_span_singleton'.mp (hlower i j)
  refine ⟨fun i j ↦ Classical.choose (hcoeff i j), ?_⟩
  intro i j
  simpa using (Classical.choose_spec (hcoeff i j)).symm

/-- Helper for Lemma 15.8.9: once the first block basis vectors land in the span of the second
block basis vectors, surjectivity of the reindexed presentation forces that second-block span to be
all of the target module. -/
lemma span_last_block_eq_top_of_surjective_reindexed_presentation
    {r : ℕ} {Q : Type*} [AddCommGroup Q] [Module R Q]
    (σQ : ((Fin r ⊕ Fin k) → R) →ₗ[R] Q) (hσQ : Function.Surjective σQ)
    (hleft :
      ∀ j : Fin r,
        σQ (Pi.single (Sum.inl j) (1 : R)) ∈
          Submodule.span R (Set.range fun i : Fin k ↦ σQ (Pi.single (Sum.inr i) (1 : R)))) :
    Submodule.span R (Set.range fun i : Fin k ↦ σQ (Pi.single (Sum.inr i) (1 : R))) = ⊤ := by
  let W : Submodule R Q :=
    Submodule.span R (Set.range fun i : Fin k ↦ σQ (Pi.single (Sum.inr i) (1 : R)))
  have hlin :
      Fintype.linearCombination R (fun s : Fin r ⊕ Fin k ↦ σQ (Pi.single s (1 : R))) = σQ := by
    -- The reindexed coordinate map is still the linear combination of its standard basis images.
    apply LinearMap.ext
    intro x
    calc
      (Fintype.linearCombination R (fun s : Fin r ⊕ Fin k ↦ σQ (Pi.single s (1 : R)))) x
          = ∑ s, x s • σQ (Pi.single s (1 : R)) := by
              simp [Fintype.linearCombination_apply]
      _ = ∑ s, σQ (x s • (Pi.single s (1 : R) : (Fin r ⊕ Fin k) → R)) := by
        congr with s
        exact (σQ.map_smul (x s) (Pi.single s (1 : R) : (Fin r ⊕ Fin k) → R)).symm
      _ = σQ (∑ s, x s • (Pi.single s (1 : R) : (Fin r ⊕ Fin k) → R)) := by
        symm
        simp only [map_sum]
      _ = σQ x := by
        congr 1
        ext s
        simpa [Pi.single_apply, mul_comm] using (Fintype.sum_pi_single (i := s) (f := x))
  have hspan_all :
      Submodule.span R (Set.range fun s : Fin r ⊕ Fin k ↦ σQ (Pi.single s (1 : R))) = ⊤ := by
    -- Surjectivity of the full reindexed basis family is the standard span criterion.
    rw [span_range_eq_top_iff_surjective_fintypeLinearCombination]
    simpa [hlin] using hσQ
  have hspan_le :
      Submodule.span R (Set.range fun s : Fin r ⊕ Fin k ↦ σQ (Pi.single s (1 : R))) ≤ W := by
    -- Every left-block basis image is assumed to lie in `W`, and every right-block basis image
    -- belongs to `W` by construction.
    refine Submodule.span_le.2 ?_
    rintro _ ⟨s, rfl⟩
    cases s with
    | inl j =>
        simpa [W] using hleft j
    | inr i =>
        exact Submodule.subset_span ⟨i, rfl⟩
  -- Comparing the total span with the right-block span shows that the latter is already `⊤`.
  apply top_unique
  rw [← hspan_all]
  exact hspan_le

/-- Helper for Lemma 15.8.9: every selected adjugate column is still a linear combination of
presentation-kernel columns, so it maps to zero under the presentation map. -/
lemma sigma_mul_adjugate_selected_column_eq_zero
    {r : ℕ} (A0 : Matrix (Fin r ⊕ Fin k) (Fin r) R)
    (σ : ((Fin r ⊕ Fin k) → R) →ₗ[R] M)
    (hcol : ∀ t : Fin r, σ (fun s ↦ A0 s t) = 0) :
    ∀ j : Fin r, σ (fun s ↦ (A0 * A0.toRows₁.adjugate) s j) = 0 := by
  intro j
  -- Expand the `j`th adjugate column as a sum of kernel columns and use linearity of `σ`.
  have hdecomp :
      (fun s ↦ (A0 * A0.toRows₁.adjugate) s j) =
        ∑ t : Fin r, (A0.toRows₁.adjugate t j) • fun s ↦ A0 s t := by
    ext s
    simp [Matrix.mul_apply, dotProduct, mul_comm]
  rw [hdecomp, map_sum]
  refine Finset.sum_eq_zero ?_
  intro t ht
  rw [σ.map_smul, hcol t, smul_zero]

/-- Helper for Lemma 15.8.9: after rewriting the selected adjugate column by the block identity,
the resulting combination becomes zero in the quotient by `f`-torsion. -/
lemma selected_minor_column_combination_eq_zero_in_quotient
    {r : ℕ} (A0 : Matrix (Fin r ⊕ Fin k) (Fin r) R)
    (σ : ((Fin r ⊕ Fin k) → R) →ₗ[R] M) (u : Rˣ)
    (htop : A0.toRows₁.det = (u : R) * f)
    (b : Fin k → Fin r → R)
    (hb : ∀ i j, (A0.toRows₂ * A0.toRows₁.adjugate) i j = b i j * f)
    (hzero : ∀ j : Fin r, σ (fun s ↦ (A0 * A0.toRows₁.adjugate) s j) = 0) :
    ∀ j : Fin r,
      (Submodule.mkQ (Submodule.torsionBy R M f))
        (((u : R) • σ (Pi.single (Sum.inl j) (1 : R)))
          + ∑ i : Fin k, b i j • σ (Pi.single (Sum.inr i) (1 : R))) = 0 := by
  intro j
  let xj : (Fin r ⊕ Fin k) → R :=
    (u : R) • (Pi.single (Sum.inl j) (1 : R) : (Fin r ⊕ Fin k) → R) +
      ∑ i : Fin k, b i j • (Pi.single (Sum.inr i) (1 : R) : (Fin r ⊕ Fin k) → R)
  have hxσ :
      σ xj =
        ((u : R) • σ (Pi.single (Sum.inl j) (1 : R))
          + ∑ i : Fin k, b i j • σ (Pi.single (Sum.inr i) (1 : R))) := by
    -- Re-express the chosen coordinate vector through the standard basis of the source.
    simp only [xj, map_add, map_sum, map_smul]
  have hcolumn :
      (fun s ↦ (A0 * A0.toRows₁.adjugate) s j) = f • xj := by
    -- Read the `j`th column of the block-adjugate identity and factor out the common `f`.
    calc
      (fun s ↦ (A0 * A0.toRows₁.adjugate) s j)
          = fun s ↦
              (Matrix.fromRows (A0.toRows₁.det • 1)
                (A0.toRows₂ * A0.toRows₁.adjugate)) s j := by
              simpa using
                congrArg (fun B => fun s ↦ B s j) (mul_adjugate_top_block_eq_fromRows_local A0)
      _ = f • xj := by
        ext s
        cases s with
        | inl j' =>
            by_cases hsj : j' = j
            · subst hsj
              change ((A0.toRows₁.det • (1 : Matrix (Fin r) (Fin r) R)) j' j') =
                (f • xj) (Sum.inl j')
              rw [htop]
              simp [xj, Pi.single_apply, smul_eq_mul, mul_comm, mul_left_comm, mul_assoc]
            · change ((A0.toRows₁.det • (1 : Matrix (Fin r) (Fin r) R)) j' j) =
                (f • xj) (Sum.inl j')
              simp [xj, hsj, Pi.single_apply, smul_eq_mul]
        | inr i =>
            change (A0.toRows₂ * A0.toRows₁.adjugate) i j = (f • xj) (Sum.inr i)
            rw [hb]
            simp [xj, Pi.single_apply, smul_eq_mul, mul_comm, mul_left_comm, mul_assoc]
  have hxzero : f • σ xj = 0 := by
    -- The rewritten column relation is exactly the required torsion equation.
    calc
      f • σ xj = σ (f • xj) := by
        symm
        exact σ.map_smul f xj
      _ = σ (fun s ↦ (A0 * A0.toRows₁.adjugate) s j) := by rw [hcolumn]
      _ = 0 := hzero j
  rw [← hxσ]
  exact (LinearMap.mem_ker).1 <| by
    simpa [Submodule.ker_mkQ, Submodule.mem_torsionBy_iff] using hxzero

/-- Helper for Lemma 15.8.9: the quotient relation from the selected adjugate column already puts
the unit-scaled first-block image inside the span of the second-block quotient classes. -/
lemma unit_smul_first_block_image_mem_span_after_torsion_quotient
    {r : ℕ} (σ : ((Fin r ⊕ Fin k) → R) →ₗ[R] M) (u : Rˣ) (b : Fin k → Fin r → R)
    (hzero :
      ∀ j : Fin r,
        (Submodule.mkQ (Submodule.torsionBy R M f))
          (((u : R) • σ (Pi.single (Sum.inl j) (1 : R)))
            + ∑ i : Fin k, b i j • σ (Pi.single (Sum.inr i) (1 : R))) = 0) :
    ∀ j : Fin r,
      (u : R) • (Submodule.mkQ (Submodule.torsionBy R M f))
        (σ (Pi.single (Sum.inl j) (1 : R))) ∈
          Submodule.span R
            (Set.range fun i : Fin k ↦
              (Submodule.mkQ (Submodule.torsionBy R M f))
                (σ (Pi.single (Sum.inr i) (1 : R)))) := by
  intro j
  let W : Submodule R (M ⧸ Submodule.torsionBy R M f) :=
    Submodule.span R
      (Set.range fun i : Fin k ↦
        (Submodule.mkQ (Submodule.torsionBy R M f))
          (σ (Pi.single (Sum.inr i) (1 : R))))
  have hzero' :
      (u : R) • (Submodule.mkQ (Submodule.torsionBy R M f))
          (σ (Pi.single (Sum.inl j) (1 : R))) +
        ∑ i : Fin k, b i j •
          (Submodule.mkQ (Submodule.torsionBy R M f))
            (σ (Pi.single (Sum.inr i) (1 : R))) = 0 := by
    -- Push the quotient-combination relation through linearity of `mkQ`.
    simpa only [map_add, map_sum, map_smul] using hzero j
  have hsum_mem :
      ∑ i : Fin k, b i j •
        (Submodule.mkQ (Submodule.torsionBy R M f))
          (σ (Pi.single (Sum.inr i) (1 : R))) ∈ W := by
    -- Every right-block basis image lies in the spanning submodule by construction.
    refine Submodule.sum_mem W ?_
    intro i hi
    exact Submodule.smul_mem W _ (Submodule.subset_span ⟨i, rfl⟩)
  have hneg :
      (u : R) • (Submodule.mkQ (Submodule.torsionBy R M f))
          (σ (Pi.single (Sum.inl j) (1 : R))) =
        -∑ i : Fin k, b i j •
          (Submodule.mkQ (Submodule.torsionBy R M f))
            (σ (Pi.single (Sum.inr i) (1 : R))) :=
    eq_neg_of_add_eq_zero_left hzero'
  -- Rearranging the zero relation keeps the left-block image inside the right-block span.
  rw [hneg]
  exact Submodule.neg_mem W hsum_mem

/-- Helper for Lemma 15.8.9: since the selected determinant is unit-associated to `f`, the unit
factor can be removed and the first-block quotient images lie in the span of the second block. -/
lemma first_block_images_mem_span_after_torsion_quotient_of_selected_minor
    {r : ℕ} (σ : ((Fin r ⊕ Fin k) → R) →ₗ[R] M) (u : Rˣ) (b : Fin k → Fin r → R)
    (hunit :
      ∀ j : Fin r,
        (u : R) • (Submodule.mkQ (Submodule.torsionBy R M f))
          (σ (Pi.single (Sum.inl j) (1 : R))) ∈
            Submodule.span R
              (Set.range fun i : Fin k ↦
                (Submodule.mkQ (Submodule.torsionBy R M f))
                  (σ (Pi.single (Sum.inr i) (1 : R)))) ) :
    ∀ j : Fin r,
      (Submodule.mkQ (Submodule.torsionBy R M f))
        (σ (Pi.single (Sum.inl j) (1 : R))) ∈
          Submodule.span R
            (Set.range fun i : Fin k ↦
              (Submodule.mkQ (Submodule.torsionBy R M f))
                (σ (Pi.single (Sum.inr i) (1 : R)))) := by
  intro j
  let W : Submodule R (M ⧸ Submodule.torsionBy R M f) :=
    Submodule.span R
      (Set.range fun i : Fin k ↦
        (Submodule.mkQ (Submodule.torsionBy R M f))
          (σ (Pi.single (Sum.inr i) (1 : R))))
  have hrewrite :
      (Submodule.mkQ (Submodule.torsionBy R M f))
          (σ (Pi.single (Sum.inl j) (1 : R))) =
        (↑u⁻¹ : R) •
          ((u : R) • (Submodule.mkQ (Submodule.torsionBy R M f))
            (σ (Pi.single (Sum.inl j) (1 : R)))) := by
    -- Cancel the unit by multiplying with its inverse inside the quotient module.
    simp only [smul_smul]
    simp
  -- The span is a submodule, so it is stable under scaling by the inverse unit.
  rw [hrewrite]
  exact Submodule.smul_mem W _ (hunit j)

/-- Helper for Lemma 15.8.9: a surjective coordinate presentation whose presentation Fitting ideal
is the principal ideal `(f)` yields `k` generators for the quotient by `f`-torsion. -/
lemma quotient_torsionBy_span_eq_top_of_presentationFittingIdeal_eq_principalIdeal
    {n : ℕ} (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π)
    (hπfit : presentationFittingIdeal R M k π = principalIdeal f) :
    ∃ v : Fin k → M ⧸ Submodule.torsionBy R M f,
      Submodule.span R (Set.range v) = ⊤ := by
  by_cases hk0 : k = 0
  · subst hk0
    -- When `k = 0`, the zeroth Fitting ideal annihilates `M`, so the quotient by `f`-torsion is
    -- zero and no generators are needed.
    have hfit0 : Fit[R]_(0)(M) = principalIdeal f := by
      exact (fittingIdeal_eq_presentationFittingIdeal R M 0 π hπ).trans hπfit
    have hann : principalIdeal f ≤ Module.annihilator R M := by
      rw [← hfit0]
      exact fittingIdeal_zero_le_annihilator (R := R) (M := M)
    exact zero_generators_of_torsionBy_eq_top
      (R := R) (M := M) (f := f)
      (torsionBy_eq_top_of_principalIdeal_le_annihilator (R := R) (M := M) (f := f) hann)
  by_cases hnk : n ≤ k
  · -- If the presentation already uses at most `k` coordinates, pad it and pass to the quotient.
    exact quotient_span_eq_top_of_surjective_fin_of_le
      (R := R) (M := M) (k := k) hnk π hπ
  by_cases hf0 : f = 0
  · subst hf0
    have htop : Submodule.torsionBy R M 0 = ⊤ := by
      ext x
      rw [Submodule.mem_torsionBy_iff]
      simp
    -- The quotient by `0`-torsion is already zero, so any `k` zero classes generate it.
    exact generators_of_quotient_eq_top (R := R) (M := M) (k := k) htop
  · -- Route correction: the remaining case is the genuine source proof with `0 < k < n`.
    have hkpos : 0 < k := Nat.pos_of_ne_zero hk0
    have hkn : k < n := Nat.lt_of_not_ge hnk
    rcases exists_finsupp_presentation_minor_combination_eq
        (R := R) (M := M) (k := k) (f := f) π hπfit with ⟨c, hc⟩
    have hminor_mem :
        ∀ p ∈ c.support,
          (((presentationKernelMatrix (R := R) π).submatrix p.1 p.2).det) ∈
            principalIdeal f := by
      intro p hp
      -- Each support term is still a genuine presentation minor, so it belongs to `(f)`.
      exact presentation_minor_mem_principal_of_presentationFittingIdeal_eq_principalIdeal
        (R := R) (M := M) (k := k) (f := f) π hπfit p.1 p.2
    rcases exists_unit_associated_minor_of_finsupp_combination
        (R := R) (f := f)
        (δ := fun p : ((Fin (n - k) ↪ Fin n) × (Fin (n - k) ↪ LinearMap.ker π)) ↦
          (((presentationKernelMatrix (R := R) π).submatrix p.1 p.2).det))
        c hc hminor_mem hf0 with
      ⟨p, hp, u, hu⟩
    let rows : Fin (n - k) ↪ Fin n := p.1
    let cols : Fin (n - k) ↪ LinearMap.ker π := p.2
    have hselected :
        (((presentationKernelMatrix (R := R) π).submatrix rows cols).det) =
          (u : R) * f := by
      simpa [rows, cols] using hu
    obtain ⟨rowComp, eRows, heRows_left, heRows_right⟩ :=
      selected_minor_row_reindex (k := k) rows hkn
    let A : Matrix (Fin n) (Fin (n - k)) R :=
      fun i j ↦ ((cols j : LinearMap.ker π) : Fin n → R) i
    let A0 : Matrix (Fin (n - k) ⊕ Fin k) (Fin (n - k)) R :=
      Matrix.reindex eRows.symm (Equiv.refl _) A
    have htop :
        A0.toRows₁.det = (u : R) * f := by
      -- Reindexing turns the selected rows into the literal top block.
      have htopBlock :
          A0.toRows₁ = ((presentationKernelMatrix (R := R) π).submatrix rows cols) := by
        ext i j
        simp [A0, A, heRows_left, Matrix.reindex_apply, Matrix.submatrix_apply]
      rw [htopBlock]
      exact hselected
    let σ : ((Fin (n - k) ⊕ Fin k) → R) →ₗ[R] M :=
      π.comp (LinearEquiv.funCongrLeft (R := R) (M := R) eRows).symm.toLinearMap
    have hσ : Function.Surjective σ := by
      -- Reindexing the source coordinates does not affect surjectivity of the presentation.
      intro x
      rcases hπ x with ⟨y, rfl⟩
      refine ⟨(LinearEquiv.funCongrLeft (R := R) (M := R) eRows) y, ?_⟩
      change π ((LinearMap.funLeft R R eRows.symm) ((LinearMap.funLeft R R eRows) y)) = π y
      congr 1
      ext i
      simp [LinearMap.funLeft_apply]
    have hcol :
        ∀ t : Fin (n - k), σ (fun s ↦ A0 s t) = 0 := by
      intro t
      -- Each selected column already lies in `ker π`, and the reindexing only changes coordinates.
      have hfun :
          ((LinearEquiv.funCongrLeft (R := R) (M := R) eRows).symm
              (fun s ↦ A0 s t)) =
            fun i ↦ ((cols t : LinearMap.ker π) : Fin n → R) i := by
        ext i
        simp [A0, A, Matrix.reindex_apply]
      rw [show σ (fun s ↦ A0 s t) =
          π (((LinearEquiv.funCongrLeft (R := R) (M := R) eRows).symm
            (fun s ↦ A0 s t)) ) by rfl]
      rw [hfun]
      exact (cols t).2
    have hA0 :
        A0 = Matrix.reindex eRows.symm (Equiv.refl _)
          (fun r t ↦ ((cols t : LinearMap.ker π) : Fin n → R) r) := rfl
    have hlower :
        ∀ i : Fin k, ∀ j : Fin (n - k),
          (A0.toRows₂ * A0.toRows₁.adjugate) i j ∈ principalIdeal f := by
      intro i j
      exact lower_block_entries_mem_principal_of_selected_presentation_minor
        (R := R) (M := M) (k := k) (f := f)
        π hπfit rows cols rowComp eRows heRows_left heRows_right A0 hA0 i j
    rcases lower_block_coefficients_of_selected_minor
        (R := R) (k := k) (f := f) A0 hlower with ⟨b, hb⟩
    let q : M →ₗ[R] M ⧸ Submodule.torsionBy R M f := Submodule.mkQ _
    have hzero :
        ∀ j : Fin (n - k), σ (fun s ↦ (A0 * A0.toRows₁.adjugate) s j) = 0 :=
      sigma_mul_adjugate_selected_column_eq_zero (R := R) (M := M) (k := k) A0 σ hcol
    have hcomb :
        ∀ j : Fin (n - k),
          q (((u : R) • σ (Pi.single (Sum.inl j) (1 : R)))
            + ∑ i : Fin k, b i j • σ (Pi.single (Sum.inr i) (1 : R))) = 0 :=
      selected_minor_column_combination_eq_zero_in_quotient
        (R := R) (M := M) (k := k) (f := f) A0 σ u htop b hb hzero
    have hunit :
        ∀ j : Fin (n - k),
          (u : R) • q (σ (Pi.single (Sum.inl j) (1 : R))) ∈
            Submodule.span R (Set.range fun i : Fin k ↦ q (σ (Pi.single (Sum.inr i) (1 : R)))) :=
      unit_smul_first_block_image_mem_span_after_torsion_quotient
        (R := R) (M := M) (k := k) (f := f) σ u b hcomb
    have hleft :
        ∀ j : Fin (n - k),
          q (σ (Pi.single (Sum.inl j) (1 : R))) ∈
            Submodule.span R (Set.range fun i : Fin k ↦ q (σ (Pi.single (Sum.inr i) (1 : R)))) :=
      first_block_images_mem_span_after_torsion_quotient_of_selected_minor
        (R := R) (M := M) (k := k) (f := f) σ u b hunit
    refine ⟨fun i ↦ q (σ (Pi.single (Sum.inr i) (1 : R))), ?_⟩
    -- Once the first block also lands in the right-block span, the reindexed presentation gives
    -- the desired `k` generators of the quotient.
    simpa [q] using
      span_last_block_eq_top_of_surjective_reindexed_presentation
        (R := R) (k := k) (σQ := q.comp σ)
        ((Submodule.mkQ_surjective (Submodule.torsionBy R M f)).comp hσ)
        hleft

/-- Lemma 15.8.9: over a local ring, if the chapter `k`th Fitting ideal of a finite module `M` is
the principal ideal `(f)`, then the quotient of `M` by its `f`-torsion is generated by `k`
elements. -/
-- Proof sketch: choose a finite free presentation of `M` computing `fittingIdeal R M k`,
-- apply the local determinantal normal-form argument to the resulting presentation matrix. Passing
-- to the quotient by `Submodule.torsionBy R M f` kills the `f`-torsion part, and the images of
-- the remaining `k` generators span the quotient module.
theorem quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal
    (hfit : Fit[R]_(k)(M) = principalIdeal f) :
    ∃ v : Fin k → M ⧸ Submodule.torsionBy R M f,
      Submodule.span R (Set.range v) = ⊤ := by
  -- Reduce the intrinsic Fitting-ideal hypothesis to one finite coordinate presentation.
  obtain ⟨n, π, hπ⟩ := exists_coordinate_surjection (R := R) (M := M)
  have hπfit : presentationFittingIdeal R M k π = principalIdeal f := by
    -- The intrinsic Fitting ideal agrees with the chosen surjective presentation.
    exact (fittingIdeal_eq_presentationFittingIdeal R M k π hπ).symm.trans hfit
  -- Apply the presentation-level elimination statement to that coordinate presentation.
  exact quotient_torsionBy_span_eq_top_of_presentationFittingIdeal_eq_principalIdeal
    (R := R) (M := M) (k := k) (f := f) π hπ hπfit

/-- Companion surjective linear-combination formulation of
`quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal`. -/
theorem quotient_torsionBy_fintypeLinearCombination_surjective_of_fittingIdeal_eq_principalIdeal
    (hfit : Fit[R]_(k)(M) = principalIdeal f) :
    ∃ v : Fin k → M ⧸ Submodule.torsionBy R M f,
      Function.Surjective (Fintype.linearCombination R v) := by
  rcases quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal hfit with ⟨v, hv⟩
  exact ⟨v, by
    simpa using (span_range_eq_top_iff_surjective_fintypeLinearCombination R v).1 hv⟩

end
