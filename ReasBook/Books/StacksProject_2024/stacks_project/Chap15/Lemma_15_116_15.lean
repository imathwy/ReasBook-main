section

/-- A degree-`p` extension of fraction fields is of finite level when it is generated by a root of
the quotient polynomial from Lemma `15.116.13` attached to a primitive `p`th root of unity, with
parameter `ξ = a / π^n` and `1 - ζ` associated to `π ^ e₁`. This keeps the source's denominator
data, while the exact rational level `n / e₁` is added only in Lemma `15.116.16`. -/
def IsDegreePFiniteLevelExtension
    (B : Type u) [CommRing B]
    (L : Type v) [Field L] [Algebra B L]
    (M : Type w) [Field M] [Algebra L M]
    (p : ℕ) [Fact p.Prime] [FiniteDimensional L M] : Prop :=
  ∃ ζ : B, IsPrimitiveRoot ζ p ∧
    ∃ π : B, ∃ e₁ n : ℕ,
      0 < e₁ ∧ Associated (1 - ζ) (π ^ e₁) ∧
        ∃ P : B[X], IsOneSubZetaQuotientPolynomial p ζ P ∧
          ∃ a : B, ∃ z : M,
            Polynomial.aeval z (P.map (algebraMap B L)) =
                algebraMap L M ((algebraMap B L a) / (algebraMap B L π) ^ n) ∧
              Algebra.adjoin L ({z} : Set M) = ⊤ ∧
              Module.finrank L M = p

/-- A degree-`p` finite-level extension has degree `p`. -/
theorem isDegreePFiniteLevelExtension_finrank_eq
    {B : Type u} [CommRing B]
    {L : Type v} [Field L] [Algebra B L]
    {M : Type w} [Field M] [Algebra L M]
    {p : ℕ} [Fact p.Prime] [FiniteDimensional L M]
    (h : IsDegreePFiniteLevelExtension B L M p) :
    Module.finrank L M = p := by
  rcases h with ⟨_, _, _, _, _, _, _, _, _, _, _, _, hgen, hfinrank⟩
  clear hgen
  exact hfinrank

end

noncomputable section

section

attribute [local instance] Algebra.TensorProduct.rightAlgebra

variable {B : Type v}
variable [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
variable {K : Type x} {L : Type y} {M : Type z}
variable [Field K] [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
variable [Field M] [Algebra K M] [Algebra L M] [IsScalarTower K L M]
variable {p : ℕ} [Fact p.Prime] [FiniteDimensional L M]

/-- Bridge/view for Lemma `15.116.15`: after the canonical reduced tensor-product base change
`L₁ = (L ⊗[K] K₁)_red`, some canonical branch field `F = L₁ ⧸ m` makes the branch tensor
`M ⊗[L] F` into a field, and that branch extension over `F` satisfies the source-facing
finite-level owner, including the denominator witness. -/
def IsDegreePFiniteLevelExtensionAfterBaseChange
    (B : Type v) (K : Type x) (L : Type y) (M : Type z)
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [Field K] [Field L] [Field M]
    [Algebra B L] [Algebra K L] [IsFractionRing B L]
    [Algebra K M] [Algebra L M] [IsScalarTower K L M]
    (p : ℕ) [Fact p.Prime] [FiniteDimensional L M]
    (K1 : Type*) [Field K1] [Algebra K K1] [FiniteDimensional K K1] : Prop :=
  let L1 := (L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)
  ∃ m : MaximalSpectrum L1,
    let F := L1 ⧸ m.asIdeal
    let _ : Field F := Ideal.Quotient.field m.asIdeal
    let _ : Algebra B F := inferInstance
    let _ : Algebra L F := inferInstance
    let _ : IsScalarTower B L F := inferInstance
    let _ : FiniteDimensional L F := inferInstance
    let MF := M ⊗[L] F
    ∃ hField : IsField MF, ∃ hFinite : FiniteDimensional F MF,
      let _ : Field MF := hField.toField
      let _ : Algebra F MF := Algebra.TensorProduct.rightAlgebra
      let _ : FiniteDimensional F MF := hFinite
      let BF := integralClosure B F
      let _ : Algebra BF F := RingHom.toAlgebra BF.val.toRingHom
      IsDegreePFiniteLevelExtension BF F MF p

/-- Source-facing finite-level alternative for Lemma `15.116.15`: on the actual global tensor
base change `L₁ = L ⊗[K] K₁`, the base-changed extension `M₁ = M ⊗[L] L₁` is a field extension of
degree `p` finite level over `integralClosure B L₁`, with the finite-level denominator data kept
inside the owner. The field and finite-dimensional structures are kept propositionally so this
statement can stand on its own, while the theorem below supplies them via the totally ramified
base change. -/
def IsDegreePFiniteLevelExtensionOnGlobalBaseChange
    (B : Type v) (K : Type x) (L : Type y) (M : Type z)
    [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    [Field K] [Field L] [Field M]
    [Algebra B L] [Algebra K L] [IsFractionRing B L]
    [Algebra K M] [Algebra L M] [IsScalarTower K L M]
    (p : ℕ) [Fact p.Prime] [FiniteDimensional L M]
    (K1 : Type*) [Field K1] [Algebra K K1] [FiniteDimensional K K1] : Prop :=
  let L1 := L ⊗[K] K1
  let M1 := M ⊗[L] L1
  ∃ hL1 : IsField L1,
    let _ : Field L1 := hL1.toField
    ∃ hM1 : IsField M1, ∃ hFinite : FiniteDimensional L1 M1,
      let _ : Algebra B L1 := RingHom.toAlgebra ((algebraMap L L1).comp (algebraMap B L))
      let _ : Field M1 := hM1.toField
      let _ : Algebra L1 M1 := Algebra.TensorProduct.rightAlgebra
      let _ : FiniteDimensional L1 M1 := hFinite
      let B1 := integralClosure B L1
      let _ : Algebra B1 L1 := RingHom.toAlgebra B1.val.toRingHom
      IsDegreePFiniteLevelExtension B1 L1 M1 p

namespace IsDegreePFiniteLevelExtensionOnGlobalBaseChange

/-- Helper for Lemma 15.116.15: if `L ⊗[K] K₁` is a field, then its nilradical is zero. -/
private theorem reduced_tensor_nilradical_eq_bot_of_global_tensor_isField
    {B : Type v} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {K : Type x} [Field K]
    {L : Type y} [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
    {K1 : Type*} [Field K1] [Algebra K K1] [FiniteDimensional K K1]
    (hL1 : IsField (L ⊗[K] K1)) :
    nilradical (L ⊗[K] K1) = (⊥ : Ideal (L ⊗[K] K1)) := by
  let _ : Field (L ⊗[K] K1) := hL1.toField
  -- A field is reduced, so the nilradical vanishes.
  simpa using (nilradical_eq_zero (R := L ⊗[K] K1))

/-- Helper for Lemma 15.116.15: if `L ⊗[K] K₁` is a field, then its reduced quotient is also a
field. -/
private theorem reduced_tensor_isField_of_global_tensor_isField
    {B : Type v} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {K : Type x} [Field K]
    {L : Type y} [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
    {K1 : Type*} [Field K1] [Algebra K K1] [FiniteDimensional K K1]
    (hL1 : IsField (L ⊗[K] K1)) :
    IsField ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) := by
  let _ : Field (L ⊗[K] K1) := hL1.toField
  have hnil :
      nilradical (L ⊗[K] K1) = (⊥ : Ideal (L ⊗[K] K1)) :=
    reduced_tensor_nilradical_eq_bot_of_global_tensor_isField
      (B := B) (K := K) (L := L) (K1 := K1) hL1
  -- Rewrite the reduced quotient as the quotient by `⊥`, which is canonically a field.
  rw [hnil]
  let hField : Field ((L ⊗[K] K1) ⧸ (⊥ : Ideal (L ⊗[K] K1))) :=
    Ideal.Quotient.field (⊥ : Ideal (L ⊗[K] K1))
  let _ : Field ((L ⊗[K] K1) ⧸ (⊥ : Ideal (L ⊗[K] K1))) := hField
  change @IsField ((L ⊗[K] K1) ⧸ (⊥ : Ideal (L ⊗[K] K1))) hField.toSemiring
  exact Field.toIsField ((L ⊗[K] K1) ⧸ (⊥ : Ideal (L ⊗[K] K1)))

/-- Helper for Lemma 15.116.15: when the global tensor is already a field, the reduced tensor
quotient canonically identifies with that tensor field. -/
private noncomputable def reduced_tensor_equiv_tensor_of_global_tensor_isField
    {B : Type v} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {K : Type x} [Field K]
    {L : Type y} [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
    {K1 : Type*} [Field K1] [Algebra K K1] [FiniteDimensional K K1]
    (hL1 : IsField (L ⊗[K] K1)) :
    ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) ≃ₐ[L] (L ⊗[K] K1) :=
  let _ : Field (L ⊗[K] K1) := hL1.toField
  let hnil :
      nilradical (L ⊗[K] K1) = (⊥ : Ideal (L ⊗[K] K1)) :=
    reduced_tensor_nilradical_eq_bot_of_global_tensor_isField
      (B := B) (K := K) (L := L) (K1 := K1) hL1
  let eQuot :
      ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) ≃ₐ[L]
        ((L ⊗[K] K1) ⧸ (⊥ : Ideal (L ⊗[K] K1))) :=
    Ideal.quotientEquivAlgOfEq L hnil
  let eBot :
      ((L ⊗[K] K1) ⧸ (⊥ : Ideal (L ⊗[K] K1))) ≃ₐ[L] (L ⊗[K] K1) :=
    AlgEquiv.ofRingEquiv (f := RingEquiv.quotientBot (L ⊗[K] K1)) (fun _ ↦ rfl)
  -- Proof comment: first collapse the nilradical quotient to the quotient by `⊥`, then use the
  -- standard quotient-by-zero equivalence.
  eQuot.trans eBot

/-- Helper for Lemma 15.116.15: after collapsing the reduced tensor quotient to the tensor field,
the corresponding integral closures are canonically equivalent. -/
private noncomputable def reduced_tensor_integralClosure_equiv_tensor_integralClosure_of_global_tensor_isField
    {B : Type v} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {K : Type x} [Field K]
    {L : Type y} [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
    {K1 : Type*} [Field K1] [Algebra K K1] [FiniteDimensional K K1]
    (hL1 : IsField (L ⊗[K] K1)) :
    integralClosure B ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) ≃ₐ[B]
      integralClosure B (L ⊗[K] K1) :=
  let eTensor :
      ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) ≃ₐ[B] (L ⊗[K] K1) :=
    (reduced_tensor_equiv_tensor_of_global_tensor_isField
      (B := B) (K := K) (L := L) (K1 := K1) hL1).restrictScalars B
  -- Proof comment: `mapIntegralClosure` transports the normalization data along the explicit
  -- reduced-quotient collapse.
  AlgEquiv.mapIntegralClosure eTensor

/-- Helper for Lemma 15.116.15: when the reduced tensor quotient is a field, its unique branch is
the bottom maximal ideal. -/
private noncomputable def reduced_tensor_bot_branch_of_global_tensor_isField
    {B : Type v} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {K : Type x} [Field K]
    {L : Type y} [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
    {K1 : Type*} [Field K1] [Algebra K K1] [FiniteDimensional K K1]
    (hL1 : IsField (L ⊗[K] K1)) :
    MaximalSpectrum ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) :=
  let _ : Field ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) :=
    (reduced_tensor_isField_of_global_tensor_isField
      (B := B) (K := K) (L := L) (K1 := K1) hL1).toField
  ⟨⊥, by simpa using (Ideal.bot_isMaximal :
    (⊥ : Ideal ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1))).IsMaximal)⟩

/-- Helper for Lemma 15.116.15: the actual `⊥`-branch field of the reduced tensor quotient
identifies canonically with the global tensor field. -/
private noncomputable def bot_branch_equiv_tensor_of_global_tensor_isField
    {B : Type v} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {K : Type x} [Field K]
    {L : Type y} [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
    {K1 : Type*} [Field K1] [Algebra K K1] [FiniteDimensional K K1]
    (hL1 : IsField (L ⊗[K] K1)) :
    ((((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) ⧸
        (⊥ : Ideal ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1))))) ≃ₐ[L]
      (L ⊗[K] K1) :=
  let Lred := ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1))
  let eBot : (Lred ⧸ (⊥ : Ideal Lred)) ≃ₐ[L] Lred :=
    AlgEquiv.quotientBot L Lred
  -- Proof comment: the chosen branch is the quotient by `⊥`, so the branch field is the reduced
  -- tensor field itself, which was already identified with the tensor field above.
  eBot.trans <|
    reduced_tensor_equiv_tensor_of_global_tensor_isField
      (B := B) (K := K) (L := L) (K1 := K1) hL1

/-- Helper for Lemma 15.116.15: transporting along the actual `⊥`-branch also identifies the
corresponding integral closures. -/
private noncomputable def bot_branch_integralClosure_equiv_tensor_integralClosure_of_global_tensor_isField
    {B : Type v} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {K : Type x} [Field K]
    {L : Type y} [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
    {K1 : Type*} [Field K1] [Algebra K K1] [FiniteDimensional K K1]
    (hL1 : IsField (L ⊗[K] K1)) :
    integralClosure B
        (((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) ⧸
          (⊥ : Ideal ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)))) ≃ₐ[B]
      integralClosure B (L ⊗[K] K1) :=
  let eTensor :
      ((((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1)) ⧸
          (⊥ : Ideal ((L ⊗[K] K1) ⧸ nilradical (L ⊗[K] K1))))) ≃ₐ[B]
        (L ⊗[K] K1) :=
    (bot_branch_equiv_tensor_of_global_tensor_isField
      (B := B) (K := K) (L := L) (K1 := K1) hL1).restrictScalars B
  -- Proof comment: once the branch field is explicitly identified with the tensor field, the
  -- integral-closure transport is the standard `mapIntegralClosure`.
  AlgEquiv.mapIntegralClosure eTensor

/-- Helper for Lemma 15.116.15: mapping coefficients along a ring equivalence preserves the
quotient-polynomial predicate from Lemma `15.116.13`. -/
private theorem isOneSubZetaQuotientPolynomial_map_ringEquiv
    {R : Type*} {S : Type*} [CommRing R] [CommRing S]
    {p : ℕ} (e : R ≃+* S) {ζ : R} {P : R[X]}
    (hP : IsOneSubZetaQuotientPolynomial p ζ P) :
    IsOneSubZetaQuotientPolynomial p (e ζ) (P.map e.toRingHom) := by
  classical
  rcases hP with ⟨a, ha_mem, hshape, hquot, hadd⟩
  refine ⟨fun i ↦ e (a i), ?_, ?_, ?_, ?_⟩
  · -- Proof comment: principal-ideal membership is preserved by the equivalence because divisors
    -- and their witnesses can be transported coefficientwise.
    intro i hi hip
    have hmem := ha_mem i hi hip
    rw [Ideal.mem_span_singleton] at hmem ⊢
    rcases hmem with ⟨c, hc⟩
    refine ⟨e c, ?_⟩
    simpa [map_sub, hc, mul_comm, mul_left_comm, mul_assoc]
  · -- Proof comment: the displayed polynomial shape is coefficientwise functorial under `map`.
    simpa [Polynomial.map_sum] using congrArg (Polynomial.map e.toRingHom) hshape
  · -- Proof comment: the quotient identity is an equality in the coefficient ring, so applying
    -- the ring equivalence transports it directly.
    calc
      C ((1 - e ζ) ^ p) * P.map e.toRingHom
          = Polynomial.map e.toRingHom (C ((1 - ζ) ^ p) * P) := by
              simp [map_sub]
      _ = Polynomial.map e.toRingHom ((C (1 : R) + C (1 - ζ) * X) ^ p - 1) := by
            rw [hquot]
      _ = (C (1 : S) + C (1 - e ζ) * X) ^ p - 1 := by
            simp [map_sub]
  · -- Proof comment: the additive identity is likewise preserved after mapping coefficients in
    -- the two-variable polynomial ring.
    let X0R : MvPolynomial (Fin 2) R := MvPolynomial.X (0 : Fin 2)
    let X1R : MvPolynomial (Fin 2) R := MvPolynomial.X (1 : Fin 2)
    let X0S : MvPolynomial (Fin 2) S := MvPolynomial.X (0 : Fin 2)
    let X1S : MvPolynomial (Fin 2) S := MvPolynomial.X (1 : Fin 2)
    have hcomm :
        (algebraMap S (MvPolynomial (Fin 2) S)).comp e.toRingHom =
          (MvPolynomial.map e.toRingHom).comp (algebraMap R (MvPolynomial (Fin 2) R)) := by
      ext r
      simp
    have hα :
        (MvPolynomial.map e.toRingHom)
            (X0R + X1R + MvPolynomial.C (1 - ζ) * X0R * X1R) =
          X0S + X1S + MvPolynomial.C (1 - e ζ) * X0S * X1S := by
      -- Proof comment: mapping the substitution term only changes the coefficient `1 - ζ`.
      simp [X0R, X1R, X0S, X1S, map_add, map_mul, map_sub, MvPolynomial.map_X]
    have hleft :
        MvPolynomial.map e.toRingHom
            ((Polynomial.aeval (X0R + X1R + MvPolynomial.C (1 - ζ) * X0R * X1R) P :
                MvPolynomial (Fin 2) R)) =
          Polynomial.aeval (X0S + X1S + MvPolynomial.C (1 - e ζ) * X0S * X1S)
            (P.map e.toRingHom) := by
      -- Proof comment: `map_aeval_eq_aeval_map` transports the left-hand substitution through
      -- coefficient mapping, and the remaining normalization is functoriality of `MvPolynomial`.
      calc
        MvPolynomial.map e.toRingHom
            ((Polynomial.aeval (X0R + X1R + MvPolynomial.C (1 - ζ) * X0R * X1R) P :
                MvPolynomial (Fin 2) R)) =
          Polynomial.aeval
            ((MvPolynomial.map e.toRingHom)
              (X0R + X1R + MvPolynomial.C (1 - ζ) * X0R * X1R))
            (P.map e.toRingHom) := by
              exact
                (Polynomial.map_aeval_eq_aeval_map
                  (R := R) (S := MvPolynomial (Fin 2) R) (T := S) (U := MvPolynomial (Fin 2) S)
                  (φ := e.toRingHom) (ψ := MvPolynomial.map e.toRingHom) hcomm P
                  (X0R + X1R + MvPolynomial.C (1 - ζ) * X0R * X1R))
        _ =
          Polynomial.aeval (X0S + X1S + MvPolynomial.C (1 - e ζ) * X0S * X1S)
            (P.map e.toRingHom) := by
              rw [hα]
    have hx0 :
        MvPolynomial.map e.toRingHom
            ((Polynomial.aeval X0R P : MvPolynomial (Fin 2) R)) =
          Polynomial.aeval X0S (P.map e.toRingHom) := by
      -- Proof comment: the same transport identifies evaluation at the first source variable.
      simpa [X0R, X0S, MvPolynomial.map_X, MvPolynomial.map_C] using
        (Polynomial.map_aeval_eq_aeval_map
          (R := R) (S := MvPolynomial (Fin 2) R) (T := S) (U := MvPolynomial (Fin 2) S)
          (φ := e.toRingHom) (ψ := MvPolynomial.map e.toRingHom) hcomm P X0R)
    have hx1 :
        MvPolynomial.map e.toRingHom
            ((Polynomial.aeval X1R P : MvPolynomial (Fin 2) R)) =
          Polynomial.aeval X1S (P.map e.toRingHom) := by
      -- Proof comment: likewise for the second source variable.
      simpa [X1R, X1S, MvPolynomial.map_X] using
        (Polynomial.map_aeval_eq_aeval_map
          (R := R) (S := MvPolynomial (Fin 2) R) (T := S) (U := MvPolynomial (Fin 2) S)
          (φ := e.toRingHom) (ψ := MvPolynomial.map e.toRingHom) hcomm P X1R)
    have hright :
        MvPolynomial.map e.toRingHom
            ((Polynomial.aeval X0R P : MvPolynomial (Fin 2) R) +
              Polynomial.aeval X1R P +
              MvPolynomial.C ((1 - ζ) ^ p) *
                Polynomial.aeval X0R P * Polynomial.aeval X1R P) =
          Polynomial.aeval X0S (P.map e.toRingHom) +
            Polynomial.aeval X1S (P.map e.toRingHom) +
            MvPolynomial.C ((1 - e ζ) ^ p) *
              Polynomial.aeval X0S (P.map e.toRingHom) *
                Polynomial.aeval X1S (P.map e.toRingHom) := by
      -- Proof comment: after expanding the ring-hom image of the sum, the transported `aeval`
      -- identities `hx0` and `hx1` close the right-hand side in one normalization step.
      calc
        MvPolynomial.map e.toRingHom
            ((Polynomial.aeval X0R P : MvPolynomial (Fin 2) R) +
              Polynomial.aeval X1R P +
              MvPolynomial.C ((1 - ζ) ^ p) *
                Polynomial.aeval X0R P * Polynomial.aeval X1R P)
            =
          MvPolynomial.map e.toRingHom ((Polynomial.aeval X0R P : MvPolynomial (Fin 2) R)) +
            MvPolynomial.map e.toRingHom (Polynomial.aeval X1R P) +
            MvPolynomial.C ((1 - e ζ) ^ p) *
              MvPolynomial.map e.toRingHom (Polynomial.aeval X0R P) *
                MvPolynomial.map e.toRingHom (Polynomial.aeval X1R P) := by
                  simp [map_add, map_mul, map_sub, X0R, X1R]
        _ =
          Polynomial.aeval X0S (P.map e.toRingHom) +
            Polynomial.aeval X1S (P.map e.toRingHom) +
            MvPolynomial.C ((1 - e ζ) ^ p) *
              Polynomial.aeval X0S (P.map e.toRingHom) *
                Polynomial.aeval X1S (P.map e.toRingHom) := by
                  rw [hx0, hx1]
    calc
      Polynomial.aeval (X0S + X1S + MvPolynomial.C (1 - e ζ) * X0S * X1S) (P.map e.toRingHom)
          =
        MvPolynomial.map e.toRingHom
            ((Polynomial.aeval (X0R + X1R + MvPolynomial.C (1 - ζ) * X0R * X1R) P :
                MvPolynomial (Fin 2) R)) := by
              exact hleft.symm
      _ =
        MvPolynomial.map e.toRingHom
            ((Polynomial.aeval X0R P : MvPolynomial (Fin 2) R) +
              Polynomial.aeval X1R P +
              MvPolynomial.C ((1 - ζ) ^ p) *
                Polynomial.aeval X0R P * Polynomial.aeval X1R P) := by
              exact congrArg (MvPolynomial.map e.toRingHom) hadd
      _ =
        Polynomial.aeval X0S (P.map e.toRingHom) +
          Polynomial.aeval X1S (P.map e.toRingHom) +
          MvPolynomial.C ((1 - e ζ) ^ p) *
            Polynomial.aeval X0S (P.map e.toRingHom) *
              Polynomial.aeval X1S (P.map e.toRingHom) := by
              exact hright

/-- Helper for Lemma 15.116.15: if a singleton generates the ambient algebra after applying an
algebra equivalence, then the original singleton already generated the source algebra. -/
private theorem adjoin_singleton_eq_top_of_algEquiv
    {R : Type*} {A : Type*} {A' : Type*}
    [CommSemiring R] [Semiring A] [Semiring A']
    [Algebra R A] [Algebra R A']
    (e : A ≃ₐ[R] A') {x : A}
    (h : Algebra.adjoin R ({e x} : Set A') = ⊤) :
    Algebra.adjoin R ({x} : Set A) = ⊤ := by
  have hcomap :=
    congrArg (Subalgebra.comap (e : A →ₐ[R] A')) h
  -- Proof comment: the equivalence has trivial kernel, so comapping the mapped adjoin returns the
  -- original subalgebra.
  have hreturn :
      Subalgebra.comap (e : A →ₐ[R] A') (Algebra.adjoin R ({e x} : Set A')) =
        Algebra.adjoin R ({x} : Set A) := by
    -- Proof comment: rewrite the target adjoin as the image of the source adjoin, then use the
    -- injectivity of the algebra equivalence on subalgebras.
    simpa [Set.image_singleton, Algebra.adjoin_image] using
      (Subalgebra.comap_map_eq_self_of_injective (f := (e : A →ₐ[R] A')) e.injective
        (Algebra.adjoin R ({x} : Set A)))
  rw [hreturn] at hcomap
  simpa using hcomap

