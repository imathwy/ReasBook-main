field preserves the field property of the tensor extension. -/
private theorem tensorProduct_isField_of_rightFactor_algEquiv
    {B : Type v} [CommRing B] [IsDomain B] [IsDiscreteValuationRing B]
    {K : Type x} [Field K]
    {L : Type y} [Field L] [Algebra B L] [Algebra K L] [IsFractionRing B L]
    {M : Type z} [Field M] [Algebra K M] [Algebra L M] [IsScalarTower K L M]
    {K1 : Type*} [Field K1] [Algebra K K1] [FiniteDimensional K K1]
    {F : Type*} [Field F] [Algebra B F] [Algebra L F] [IsScalarTower B L F]
    [FiniteDimensional L F]
    (eF : F ≃ₐ[L] (L ⊗[K] K1))
    (hM1 : IsField (M ⊗[L] (L ⊗[K] K1))) :
    IsField (M ⊗[L] F) := by
  let _ : Field (M ⊗[L] (L ⊗[K] K1)) := hM1.toField
  let eM : (M ⊗[L] F) ≃ₐ[L] (M ⊗[L] (L ⊗[K] K1)) :=
    Algebra.TensorProduct.congr (AlgEquiv.refl : M ≃ₐ[L] M) eF
  -- Proof comment: transport the field structure back across the explicit branch-tensor
  -- equivalence.
  exact eM.toRingEquiv.toMulEquiv.isField (Field.toIsField (M ⊗[L] (L ⊗[K] K1)))

