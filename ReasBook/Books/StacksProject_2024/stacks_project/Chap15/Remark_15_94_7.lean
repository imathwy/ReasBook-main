/-- The submodule `f^n M`, modeled as the action of the principal ideal `(f)^n` on `M`. -/
abbrev principalPowerSubmodule (f : A) (M : ModuleCat.{u} A) (n : ℕ) : Submodule A M :=
  principalPowerIdeal f n • (⊤ : Submodule A M)

/- Textbook notation for the principal-power submodule `f^n M`. -/
scoped[PrincipalPowerSubmodule] notation:max f:max "^{" n:max "} " M:max =>
  principalPowerSubmodule f M n

open scoped PrincipalPowerSubmodule

-- Proof sketch: `(f)^(n + 2) ≤ (f)^(n + 1)` implies the same containment after acting on `M`.
/-- The principal-power submodules `f^n M` form a descending chain. -/
theorem principalPowerSubmodule_step_le
    (f : A) (M : ModuleCat.{u} A) (n : ℕ) :
    f^{(n + 2)} M ≤ f^{(n + 1)} M := by
  -- Move the ideal-power containment through the scalar action on `M`.
  simpa [principalPowerSubmodule] using
    Submodule.smul_mono (Ideal.pow_le_pow_right (Nat.le_succ (n + 1))) le_rfl

/-- The quotient stage `M / f^(n + 1) M`. -/
abbrev principalPowerQuotientStage (f : A) (M : ModuleCat.{u} A) (n : ℕ) : ModuleCat.{u} A :=
  ModuleCat.of A (M ⧸ f^{(n + 1)} M)

/-- The transition map `M / f^(n + 2) M ⟶ M / f^(n + 1) M` in the principal-power quotient
tower. -/
abbrev principalPowerQuotientStep (f : A) (M : ModuleCat.{u} A) (n : ℕ) :
    principalPowerQuotientStage f M (n + 1) ⟶ principalPowerQuotientStage f M n :=
  ModuleCat.ofHom <|
    Submodule.mapQ
      (f^{(n + 2)} M)
      (f^{(n + 1)} M)
      (LinearMap.id : M →ₗ[A] M)
      (principalPowerSubmodule_step_le f M n)

/-- The inverse system `(M / f^(n + 1) M)_n` of principal-power quotients. -/
abbrev principalPowerQuotientTower (f : A) (M : ModuleCat.{u} A) :
    SequentialInverseSystem (ModuleCat.{u} A) :=
  Functor.ofOpSequence (principalPowerQuotientStep f M)

/-- The stage `M[f^(n + 1)]` of the principal-power torsion tower. -/
abbrev principalPowerTorsionStage (f : A) (M : ModuleCat.{u} A) (n : ℕ) : ModuleCat.{u} A :=
  ModuleCat.of A (M[f ^ (n + 1)])

-- Proof sketch: if `x` is annihilated by `f^(n + 2)`, then `f • x` is annihilated by
-- `f^(n + 1)`.
/-- Multiplication by `f` maps `M[f^(n + 2)]` into `M[f^(n + 1)]`. -/
theorem principalPowerTorsion_smul_mem
    (f : A) (M : ModuleCat.{u} A) (n : ℕ) (x : M[f ^ (n + 2)]) :
    f • x.1 ∈ (M[f ^ (n + 1)] : Submodule A M) := by
  -- Rewrite both torsion-membership conditions as annihilation by the relevant power of `f`.
  rw [Submodule.mem_torsionBy_iff]
  have hx : f ^ (n + 2) • x.1 = 0 := by
    simpa [Submodule.mem_torsionBy_iff] using x.2
  -- Reassociate the scalar multiplication so the given annihilation hypothesis applies.
  simpa [pow_succ', smul_smul, mul_assoc, mul_comm, mul_left_comm] using hx

/-- The transition map `M[f^(n + 2)] ⟶ M[f^(n + 1)]` in the principal-power torsion tower. -/
abbrev principalPowerTorsionStep (f : A) (M : ModuleCat.{u} A) (n : ℕ) :
    principalPowerTorsionStage f M (n + 1) ⟶ principalPowerTorsionStage f M n :=
  ModuleCat.ofHom <|
    LinearMap.codRestrict
      (M[f ^ (n + 1)] : Submodule A M)
      ((((f : A) • (LinearMap.id : M →ₗ[A] M)).domRestrict
          (M[f ^ (n + 2)] : Submodule A M)))
      (principalPowerTorsion_smul_mem f M n)

/-- The inverse system `(M[f^(n + 1)])_n` with transition maps given by multiplication by `f`. -/
abbrev principalPowerTorsionTower (f : A) (M : ModuleCat.{u} A) :
    SequentialInverseSystem (ModuleCat.{u} A) :=
  Functor.ofOpSequence (principalPowerTorsionStep f M)

/-- The principal Tate module `T_f(M) = \varprojlim_n M[f^(n + 1)]`. -/
abbrev principalTateModule (f : A) (M : ModuleCat.{u} A) : ModuleCat.{u} A :=
  limit (principalPowerTorsionTower f M)

/- Textbook notation for the principal Tate module `T_f(M)`. -/
scoped[PrincipalTateModule] notation:max "T[" f "]" M:max => principalTateModule f M

/-- Helper for Remark 15.94.7: in `ModuleCat`, the categorical image of a morphism is represented
by the concrete range submodule of the underlying linear map. -/
private theorem moduleCat_imageSubobject_to_range_arrow
    {X Y : ModuleCat.{u} A} (g : X ⟶ Y) :
    ((imageSubobjectIso g).hom ≫ (ModuleCat.imageIsoRange g).hom) ≫
      ModuleCat.ofHom g.hom.range.subtype = (imageSubobject g).arrow := by
  -- First rewrite the range model through the categorical image object.
  rw [Category.assoc]
  change (imageSubobjectIso g).hom ≫ (ModuleCat.imageIsoRange g).hom ≫
      ModuleCat.image.ι g = (imageSubobject g).arrow
  -- Then identify the chosen comparison with the universal image map.
  rw [show (ModuleCat.imageIsoRange g).hom ≫ ModuleCat.image.ι g = image.ι g by
    simpa [ModuleCat.imageIsoRange] using
      (IsImage.isoExt_hom_m (hF := Image.isImage g) (hF' := ModuleCat.isImage g))]
  simp

/-- Helper for Remark 15.94.7: inclusion of image subobjects in `ModuleCat` implies inclusion of
the corresponding concrete linear ranges. -/
private theorem moduleCat_range_subset_of_imageSubobject_le
    {X₁ X₂ Y : ModuleCat.{u} A} {g₁ : X₁ ⟶ Y} {g₂ : X₂ ⟶ Y}
    (h : imageSubobject g₁ ≤ imageSubobject g₂) :
    (g₁.hom).range ≤ (g₂.hom).range := by
  intro y hy
  rw [LinearMap.mem_range] at hy ⊢
  rcases hy with ⟨x, rfl⟩
  let φ : X₁ ⟶ ModuleCat.of A g₂.hom.range :=
    factorThruImageSubobject g₁ ≫ Subobject.ofLE _ _ h ≫
      (imageSubobjectIso g₂).hom ≫ (ModuleCat.imageIsoRange g₂).hom
  have hφ : φ ≫ ModuleCat.ofHom g₂.hom.range.subtype = g₁ := by
    -- Compare the factorization through `imageSubobject g₂` with the original map `g₁`.
    dsimp [φ]
    calc
      factorThruImageSubobject g₁ ≫
          Subobject.ofLE (imageSubobject g₁) (imageSubobject g₂) h ≫
            (imageSubobjectIso g₂).hom ≫
              (ModuleCat.imageIsoRange g₂).hom ≫
                ModuleCat.ofHom g₂.hom.range.subtype
          = factorThruImageSubobject g₁ ≫
              Subobject.ofLE (imageSubobject g₁) (imageSubobject g₂) h ≫
                (((imageSubobjectIso g₂).hom ≫ (ModuleCat.imageIsoRange g₂).hom) ≫
                  ModuleCat.ofHom g₂.hom.range.subtype) := by
              simp [Category.assoc]
      _ = factorThruImageSubobject g₁ ≫
            Subobject.ofLE (imageSubobject g₁) (imageSubobject g₂) h ≫
              (imageSubobject g₂).arrow := by
            rw [moduleCat_imageSubobject_to_range_arrow]
      _ = factorThruImageSubobject g₁ ≫ (imageSubobject g₁).arrow := by
            rw [Subobject.ofLE_arrow]
      _ = g₁ := by
            rw [imageSubobject_arrow_comp]
  refine ⟨(φ.hom x).2.choose, ?_⟩
  have hφx := congrArg (fun k ↦ k.hom x) hφ
  exact ((φ.hom x).2.choose_spec).trans hφx

/-- Helper for Remark 15.94.7: equality of image subobjects in `ModuleCat` forces equality of the
corresponding concrete linear ranges. -/
private theorem moduleCat_range_eq_of_imageSubobject_eq
    {X₁ X₂ Y : ModuleCat.{u} A} {g₁ : X₁ ⟶ Y} {g₂ : X₂ ⟶ Y}
    (h : imageSubobject g₁ = imageSubobject g₂) :
    (g₁.hom).range = (g₂.hom).range := by
  -- Compare both inclusions through the previous image-subobject containment lemma.
  exact le_antisymm
    (moduleCat_range_subset_of_imageSubobject_le h.le)
    (moduleCat_range_subset_of_imageSubobject_le h.symm.le)

/-- Helper for Remark 15.94.7: in `ModuleCat`, the image subobject can be replaced by the concrete
range submodule viewed as a subobject. -/
private theorem moduleCat_imageSubobject_eq_range_mk
    {X Y : ModuleCat.{u} A} (g : X ⟶ Y) :
    imageSubobject g = Subobject.mk (ModuleCat.ofHom g.hom.range.subtype) := by
  let _ : Mono (ModuleCat.ofHom g.hom.range.subtype) :=
    ConcreteCategory.mono_of_injective _ Subtype.val_injective
  -- Compare the image subobject directly with the range model chosen by `ModuleCat.imageIsoRange`.
  exact CategoryTheory.Subobject.eq_mk_of_comm
    (ModuleCat.ofHom g.hom.range.subtype)
    ((imageSubobjectIso g).trans (ModuleCat.imageIsoRange g))
    (by simpa [Category.assoc] using moduleCat_imageSubobject_to_range_arrow g)

/-- Helper for Remark 15.94.7: equality of concrete linear ranges in `ModuleCat` upgrades to
equality of image subobjects. -/
private theorem moduleCat_imageSubobject_eq_of_range_eq
    {X₁ X₂ Y : ModuleCat.{u} A} {g₁ : X₁ ⟶ Y} {g₂ : X₂ ⟶ Y}
    (h : (g₁.hom).range = (g₂.hom).range) :
    imageSubobject g₁ = imageSubobject g₂ := by
  -- Build the canonical linear equivalence between the equal range submodules.
  let eMap : (g₁.hom).range →ₗ[A] (g₂.hom).range :=
    { toFun := fun x ↦ ⟨x.1, h ▸ x.2⟩
      map_add' := by
        intro x y
        ext
        rfl
      map_smul' := by
        intro a x
        ext
        rfl }
  have heMap_bijective : Function.Bijective eMap := by
    constructor
    · intro x y hxy
      cases x
      cases y
      cases hxy
      rfl
    · intro y
      refine ⟨⟨y.1, h.symm ▸ y.2⟩, ?_⟩
      ext
      rfl
  let eLin : (g₁.hom).range ≃ₗ[A] (g₂.hom).range :=
    LinearEquiv.ofBijective eMap heMap_bijective
  let e : ModuleCat.of A (g₁.hom).range ≅ ModuleCat.of A (g₂.hom).range := eLin.toModuleIso
  have he :
      e.hom ≫ ModuleCat.ofHom g₂.hom.range.subtype =
        ModuleCat.ofHom g₁.hom.range.subtype := by
    ext x
    rfl
  calc
    imageSubobject g₁ = Subobject.mk (ModuleCat.ofHom g₁.hom.range.subtype) :=
      moduleCat_imageSubobject_eq_range_mk g₁
    _ = Subobject.mk (ModuleCat.ofHom g₂.hom.range.subtype) :=
      CategoryTheory.Subobject.mk_eq_mk_of_comm
        (ModuleCat.ofHom g₁.hom.range.subtype)
        (ModuleCat.ofHom g₂.hom.range.subtype)
        e
        he
    _ = imageSubobject g₂ := (moduleCat_imageSubobject_eq_range_mk g₂).symm

/-- Helper for Remark 15.94.7: a sequential inverse system of modules is Mittag-Leffler exactly
when the concrete ranges of its long transition maps stabilize. -/
private theorem moduleCat_isMittagLeffler_iff_eventual_range
    (F : SequentialInverseSystem (ModuleCat.{u} A)) :
    IsMittagLeffler F ↔
      ∀ i : ℕ, ∃ (c : ℕ) (hic : i ≤ c),
        ∀ ⦃k : ℕ⦄ (hck : c ≤ k),
          ((F.transitionMap (hic.trans hck)).hom).range =
            ((F.transitionMap hic).hom).range := by
  constructor
  · intro hF i
    obtain ⟨c, hic, hc⟩ := hF i
    refine ⟨c, hic, ?_⟩
    intro k hck
    exact moduleCat_range_eq_of_imageSubobject_eq (hc hck)
  · intro hF i
    obtain ⟨c, hic, hc⟩ := hF i
    refine ⟨c, hic, ?_⟩
    intro k hck
    exact moduleCat_imageSubobject_eq_of_range_eq (hc hck)

/-- Helper for Remark 15.94.7: each successor map in the principal-power quotient tower is
surjective. -/
private theorem principalPowerQuotientStep_surjective
    (f : A) (M : ModuleCat.{u} A) (n : ℕ) :
    Function.Surjective (principalPowerQuotientStep f M n).hom := by
  intro q
  obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective (f^{(n + 1)} M) q
  refine ⟨(f^{(n + 2)} M).mkQ x, ?_⟩
  -- The successor map is the canonical quotient map induced by the identity on `M`.
  simpa [principalPowerQuotientStep, principalPowerQuotientStage] using
    LinearMap.congr_fun
      (Submodule.mapQ_mkQ
        (f^{(n + 2)} M)
        (f^{(n + 1)} M)
        (LinearMap.id : M →ₗ[A] M))
      x

/-- Helper for Remark 15.94.7: every long transition map in the principal-power quotient tower is
surjective. -/
private theorem principalPowerQuotient_transition_surjective
    (f : A) (M : ModuleCat.{u} A) {i j : ℕ} (hij : i ≤ j) :
    Function.Surjective ((principalPowerQuotientTower f M).transitionMap hij).hom := by
  induction j generalizing i with
  | zero =>
      have hi : i = 0 := Nat.eq_zero_of_le_zero hij
      subst hi
      intro q
      refine ⟨q, ?_⟩
      rfl
  | succ j ih =>
      by_cases hij_eq : i = j + 1
      · subst hij_eq
        intro q
        refine ⟨q, ?_⟩
        have hij_rfl : hij = le_rfl := by
          apply Subsingleton.elim
        cases hij_rfl
        have h_id :
            (((principalPowerQuotientTower f M).transitionMap (i := j + 1) (j := j + 1) le_rfl).hom) =
              LinearMap.id := by
          ext x
          simp [SequentialInverseSystem.transitionMap]
          rfl
        rw [h_id]
        rfl
      · have hij' : i ≤ j := Nat.le_of_lt_succ (lt_of_le_of_ne hij hij_eq)
        have hcomp : homOfLE hij = homOfLE hij' ≫ homOfLE (Nat.le_succ j) := by
          simpa [homOfLE_comp] using
            (Subsingleton.elim (homOfLE hij) (homOfLE hij' ≫ homOfLE (Nat.le_succ j)))
        have hcomp_op :
            (homOfLE hij).op = (homOfLE (Nat.le_succ j)).op ≫ (homOfLE hij').op := by
          exact Subsingleton.elim _ _
        have hmap :
            (principalPowerQuotientTower f M).transitionMap hij =
              principalPowerQuotientStep f M j ≫
                (principalPowerQuotientTower f M).transitionMap hij' := by
          change (principalPowerQuotientTower f M).map (homOfLE hij).op =
              principalPowerQuotientStep f M j ≫
                (principalPowerQuotientTower f M).map (homOfLE hij').op
          rw [hcomp_op, Functor.map_comp]
          simpa [principalPowerQuotientTower] using
            (Functor.ofOpSequence_map_homOfLE_succ
              (f := principalPowerQuotientStep f M) j)
        have hmap_hom :
            ((principalPowerQuotientTower f M).transitionMap hij).hom =
              ((principalPowerQuotientTower f M).transitionMap hij').hom.comp
                (principalPowerQuotientStep f M j).hom := by
          simpa using congrArg ModuleCat.Hom.hom hmap
        rw [hmap_hom]
        exact (ih hij').comp (principalPowerQuotientStep_surjective f M j)

-- Proof sketch: each transition map in the quotient tower
-- `M / f^(n + 2) M ⟶ M / f^(n + 1) M` is surjective, so the images into any fixed stage are
-- eventually constant.
/-- The quotient tower `(M / f^(n + 1) M)_n` attached to powers of a principal ideal is
Mittag-Leffler. -/
theorem principalPowerQuotientTower_isMittagLeffler
    (f : A) (M : ModuleCat.{u} A) :
    IsMittagLeffler (principalPowerQuotientTower f M) := by
  rw [moduleCat_isMittagLeffler_iff_eventual_range]
  intro i
  refine ⟨i, le_rfl, ?_⟩
  intro k hik
  -- Every long quotient transition is surjective, so its range is all of the target stage.
  calc
    (((principalPowerQuotientTower f M).transitionMap hik).hom).range = ⊤ := by
      exact LinearMap.range_eq_top.2 (principalPowerQuotient_transition_surjective f M hik)
    _ = (((principalPowerQuotientTower f M).transitionMap (i := i) (j := i) le_rfl).hom).range := by
      symm
      exact LinearMap.range_eq_top.2 (by
        intro x
        refine ⟨x, ?_⟩
        have h_id :
            (((principalPowerQuotientTower f M).transitionMap (i := i) (j := i) le_rfl).hom) =
              LinearMap.id := by
          ext y
          simp [SequentialInverseSystem.transitionMap]
          rfl
        rw [h_id]
        rfl)

/-- Helper for Remark 15.94.7: evaluating the given short exact sequence of towers at a stage
`n` yields a short exact sequence of `A`-modules. -/
private theorem principalPower_stage_shortExact
    (f : A) (M N : ModuleCat.{u} A) (B : SequentialInverseSystem (ModuleCat.{u} A))
    (ι : principalPowerQuotientTower f M ⟶ B)
    (π : B ⟶ principalPowerTorsionTower f N)
    (h : ι ≫ π = 0)
    (hShort : (ShortComplex.mk ι π).ShortExact)
    (n : ℕ) :
    ((ShortComplex.mk ι π h).map ((CategoryTheory.evaluation ℕᵒᵖ (ModuleCat A)).obj (op n))).ShortExact := by
  -- Evaluation is an exact functor on functor categories, so short exactness descends to stage
  -- `n`.
  let S : ShortComplex (SequentialInverseSystem (ModuleCat A)) := ShortComplex.mk ι π h
  have hS : S.ShortExact := by
    simpa [S] using hShort
  simpa [S] using hS.map_of_exact ((CategoryTheory.evaluation ℕᵒᵖ (ModuleCat A)).obj (op n))

/-- Helper for Remark 15.94.7: at stage `n`, exactness identifies the image of the left map with
the kernel of the right map. -/
private theorem principalPower_stage_range_eq_ker
    (f : A) (M N : ModuleCat.{u} A) (B : SequentialInverseSystem (ModuleCat.{u} A))
    (ι : principalPowerQuotientTower f M ⟶ B)
    (π : B ⟶ principalPowerTorsionTower f N)
    (h : ι ≫ π = 0)
    (hShort : (ShortComplex.mk ι π).ShortExact)
    (n : ℕ) :
    LinearMap.range (ι.app (op n)).hom = LinearMap.ker (π.app (op n)).hom := by
  let S : ShortComplex (ModuleCat A) :=
    (ShortComplex.mk ι π h).map ((CategoryTheory.evaluation ℕᵒᵖ (ModuleCat A)).obj (op n))
  have hS : S.ShortExact := by
    -- The staged short exactness is the source-faithful bridge from the tower sequence to
    -- concrete ranges and kernels.
    simpa [S] using principalPower_stage_shortExact f M N B ι π h hShort n
  simpa [S] using ShortComplex.Exact.moduleCat_range_eq_ker hS.exact

/-- Helper for Remark 15.94.7: each stage map `B_n ⟶ N[f^(n+1)]` in the short exact sequence is
surjective. -/
private theorem principalPower_stage_surjective
    (f : A) (M N : ModuleCat.{u} A) (B : SequentialInverseSystem (ModuleCat.{u} A))
    (ι : principalPowerQuotientTower f M ⟶ B)
    (π : B ⟶ principalPowerTorsionTower f N)
    (h : ι ≫ π = 0)
    (hShort : (ShortComplex.mk ι π).ShortExact)
    (n : ℕ) :
    Function.Surjective (π.app (op n)).hom := by
  let S : ShortComplex (ModuleCat A) :=
    (ShortComplex.mk ι π h).map ((CategoryTheory.evaluation ℕᵒᵖ (ModuleCat A)).obj (op n))
  have hS : S.ShortExact := by
    -- The stagewise short exact sequence supplies the required epimorphism on the right.
    simpa [S] using principalPower_stage_shortExact f M N B ι π h hShort n
  simpa [S] using hS.moduleCat_surjective_g

/-- Helper for Remark 15.94.7: the image of the left stage map lies inside every middle
transition range, because the quotient tower transitions are surjective. -/
private theorem principalPower_left_range_le_middle_transition_range
    (f : A) (M : ModuleCat.{u} A) (B : SequentialInverseSystem (ModuleCat.{u} A))
    (ι : principalPowerQuotientTower f M ⟶ B)
    {i j : ℕ} (hij : i ≤ j) :
    LinearMap.range (ι.app (op i)).hom ≤ ((B.transitionMap hij).hom).range := by
  intro x hx
  rw [LinearMap.mem_range] at hx ⊢
  rcases hx with ⟨qᵢ, rfl⟩
  obtain ⟨qⱼ, hqⱼ⟩ := principalPowerQuotient_transition_surjective f M hij qᵢ
  refine ⟨(ι.app (op j)).hom qⱼ, ?_⟩
  have hnat :
      (ι.app (op i)).hom.comp ((principalPowerQuotientTower f M).transitionMap hij).hom =
        ((B.transitionMap hij).hom).comp (ι.app (op j)).hom := by
    -- Naturality of `ι` rewrites the two possible routes from stage `j` to stage `i`.
    simpa [SequentialInverseSystem.transitionMap] using
      congrArg ModuleCat.Hom.hom (ι.naturality ((homOfLE hij).op))
  have hnat_apply := LinearMap.congr_fun hnat qⱼ
  rw [LinearMap.comp_apply, LinearMap.comp_apply, hqⱼ] at hnat_apply
  exact hnat_apply.symm

/-- Helper for Remark 15.94.7: the torsion transition range is the image of the corresponding
middle transition range under the stage-`i` surjection `π_i`. -/
private theorem principalPower_torsion_transition_range_eq_map
    (f : A) (M N : ModuleCat.{u} A) (B : SequentialInverseSystem (ModuleCat.{u} A))
    (ι : principalPowerQuotientTower f M ⟶ B)
    (π : B ⟶ principalPowerTorsionTower f N)
    (h : ι ≫ π = 0)
    (hShort : (ShortComplex.mk ι π).ShortExact)
    {i j : ℕ} (hij : i ≤ j) :
    (((principalPowerTorsionTower f N).transitionMap hij).hom).range =
      Submodule.map (π.app (op i)).hom (((B.transitionMap hij).hom).range) := by
  let πᵢ := (π.app (op i)).hom
  let πⱼ := (π.app (op j)).hom
  let bji := ((B.transitionMap hij).hom)
  let tji := (((principalPowerTorsionTower f N).transitionMap hij).hom)
  have hnat : πᵢ.comp bji = tji.comp πⱼ := by
    -- Naturality of `π` identifies the two composites from the middle stage `j` to the torsion
    -- stage `i`.
    simpa [πᵢ, πⱼ, bji, tji, SequentialInverseSystem.transitionMap] using
      congrArg ModuleCat.Hom.hom (π.naturality ((homOfLE hij).op))
  have hsurj : Function.Surjective πⱼ := principalPower_stage_surjective f M N B ι π h hShort j
  -- Rewrite the torsion range through the naturality square and the surjectivity of `π_j`.
  calc
    tji.range = Submodule.map tji ⊤ := by
      exact LinearMap.range_eq_map tji
    _ = Submodule.map tji πⱼ.range := by
      rw [LinearMap.range_eq_top.2 hsurj]
    _ = (tji.comp πⱼ).range := by
      rw [← LinearMap.range_comp πⱼ tji]
    _ = (πᵢ.comp bji).range := by
      rw [hnat]
    _ = Submodule.map πᵢ bji.range := by
      rw [LinearMap.range_comp]

/-- Helper for Remark 15.94.7: the middle transition range is recovered as the preimage of the
torsion transition range under the stage-`i` map `π_i`. -/
private theorem principalPower_middle_transition_range_eq_comap
    (f : A) (M N : ModuleCat.{u} A) (B : SequentialInverseSystem (ModuleCat.{u} A))
    (ι : principalPowerQuotientTower f M ⟶ B)
    (π : B ⟶ principalPowerTorsionTower f N)
    (h : ι ≫ π = 0)
    (hShort : (ShortComplex.mk ι π).ShortExact)
    {i j : ℕ} (hij : i ≤ j) :
    ((B.transitionMap hij).hom).range =
      Submodule.comap (π.app (op i)).hom
        ((((principalPowerTorsionTower f N).transitionMap hij).hom).range) := by
  have hker_le :
      LinearMap.ker (π.app (op i)).hom ≤ ((B.transitionMap hij).hom).range := by
    -- Exactness turns the kernel of `π_i` into the image of `ι_i`, and that image already lies in
    -- the middle transition range by surjectivity on the quotient tower.
    rw [← principalPower_stage_range_eq_ker f M N B ι π h hShort i]
    exact principalPower_left_range_le_middle_transition_range f M B ι hij
  -- The forward range formula and `comap_map_eq` show that no extra elements appear in the
  -- preimage, since the kernel is already contained in the middle range.
  calc
    ((B.transitionMap hij).hom).range =
        ((B.transitionMap hij).hom).range ⊔ LinearMap.ker (π.app (op i)).hom := by
          symm
          exact sup_of_le_left hker_le
    _ = Submodule.comap (π.app (op i)).hom
          (Submodule.map (π.app (op i)).hom (((B.transitionMap hij).hom).range)) := by
          rw [Submodule.comap_map_eq]
    _ = Submodule.comap (π.app (op i)).hom
          ((((principalPowerTorsionTower f N).transitionMap hij).hom).range) := by
          rw [principalPower_torsion_transition_range_eq_map f M N B ι π h hShort hij]

/-- Helper for Remark 15.94.7: for each fixed target stage `i`, the middle transition ranges
stabilize exactly when the torsion transition ranges do. -/
private theorem principalPower_transition_ranges_stabilize_iff_torsion
    (f : A) (M N : ModuleCat.{u} A) (B : SequentialInverseSystem (ModuleCat.{u} A))
    (ι : principalPowerQuotientTower f M ⟶ B)
    (π : B ⟶ principalPowerTorsionTower f N)
    (h : ι ≫ π = 0)
    (hShort : (ShortComplex.mk ι π).ShortExact)
    (i : ℕ) :
    (∃ (c : ℕ) (hic : i ≤ c),
        ∀ ⦃k : ℕ⦄ (hck : c ≤ k),
          ((B.transitionMap (hic.trans hck)).hom).range =
            ((B.transitionMap hic).hom).range) ↔
      (∃ (c : ℕ) (hic : i ≤ c),
        ∀ ⦃k : ℕ⦄ (hck : c ≤ k),
          (((principalPowerTorsionTower f N).transitionMap (hic.trans hck)).hom).range =
            (((principalPowerTorsionTower f N).transitionMap hic).hom).range) := by
  constructor
  · rintro ⟨c, hic, hc⟩
    refine ⟨c, hic, ?_⟩
    intro k hck
    -- Map the stabilized middle range equality forward along `π_i`.
    calc
      (((principalPowerTorsionTower f N).transitionMap (hic.trans hck)).hom).range =
          Submodule.map (π.app (op i)).hom
            (((B.transitionMap (hic.trans hck)).hom).range) := by
              exact principalPower_torsion_transition_range_eq_map f M N B ι π h hShort _
      _ = Submodule.map (π.app (op i)).hom
            (((B.transitionMap hic).hom).range) := by
              rw [hc hck]
      _ = (((principalPowerTorsionTower f N).transitionMap hic).hom).range := by
              symm
              exact principalPower_torsion_transition_range_eq_map f M N B ι π h hShort _
  · rintro ⟨c, hic, hc⟩
    refine ⟨c, hic, ?_⟩
    intro k hck
    -- Pull the stabilized torsion range equality back along `π_i`.
    calc
      ((B.transitionMap (hic.trans hck)).hom).range =
          Submodule.comap (π.app (op i)).hom
            ((((principalPowerTorsionTower f N).transitionMap (hic.trans hck)).hom).range) := by
              exact principalPower_middle_transition_range_eq_comap f M N B ι π h hShort _
      _ = Submodule.comap (π.app (op i)).hom
            ((((principalPowerTorsionTower f N).transitionMap hic).hom).range) := by
              rw [hc hck]
      _ = ((B.transitionMap hic).hom).range := by
              symm
              exact principalPower_middle_transition_range_eq_comap f M N B ι π h hShort _

-- Proof sketch: Lemma `15.94.6` provides a short exact sequence of inverse systems
-- `0 → (H^p(K) / f^(n + 1) H^p(K))_n → (H^p(K_n))_n → (H^{p + 1}(K)[f^(n + 1)])_n → 0`. The left
-- quotient tower is Mittag-Leffler by the preceding theorem, so the middle tower is
-- Mittag-Leffler exactly when the right torsion tower is.
/-- Remark 15.94.7: if a sequential inverse system `B` of `A`-modules fits into a short exact
sequence
`0 → (M / f^(n + 1) M)_n → B → (N[f^(n + 1)])_n → 0`,
then `B` is Mittag-Leffler if and only if the torsion tower `(N[f^(n + 1)])_n` is
Mittag-Leffler. Applying this with `M = H^p(K)`, `B_n = H^p(K_n)`, and `N = H^{p + 1}(K)`
recovers the textbook remark. -/
theorem principalPower_shortExact_middle_isMittagLeffler_iff_torsion
    (f : A) (M N : ModuleCat.{u} A) (B : SequentialInverseSystem (ModuleCat.{u} A))
    (ι : principalPowerQuotientTower f M ⟶ B)
    (π : B ⟶ principalPowerTorsionTower f N)
    (h : ι ≫ π = 0)
    (hShort : (ShortComplex.mk ι π).ShortExact) :
    IsMittagLeffler B ↔ IsMittagLeffler (principalPowerTorsionTower f N) := by
  let S : ShortComplex (SequentialInverseSystem (ModuleCat A)) := ShortComplex.mk ι π h
  have hS : S.ShortExact := by
    -- Route correction: the unavailable imported `Lemma_15_87_15` proof is replaced locally by
    -- the source-faithful range-stabilization argument on the given short exact sequence.
    simpa [S] using hShort
  -- Compare both Mittag-Leffler predicates through the concrete stabilization of transition
  -- ranges into each fixed stage.
  rw [moduleCat_isMittagLeffler_iff_eventual_range, moduleCat_isMittagLeffler_iff_eventual_range]
  constructor
  · intro hB i
    exact (principalPower_transition_ranges_stabilize_iff_torsion f M N B ι π h hShort i).1
      (hB i)
  · intro hT i
    exact (principalPower_transition_ranges_stabilize_iff_torsion f M N B ι π h hShort i).2
      (hT i)

end
