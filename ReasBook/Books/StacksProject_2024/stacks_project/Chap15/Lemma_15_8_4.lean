/-- Helper for Lemma 15.8.4: forming the `r × r` minor ideal commutes with a ring map. -/
private theorem matrix_minorIdeal_map_eq
    {S : Type*} [CommRing S] (σ : R →+* S) {ι κ : Type*} (r : ℕ) (A : Matrix ι κ R) :
    Ideal.map σ (Matrix.minorIdeal r A) = Matrix.minorIdeal r (A.map σ) := by
  classical
  -- Unfold the determinantal-ideal owner and move the ring map across each determinant generator.
  unfold Matrix.minorIdeal
  rw [Ideal.map_span]
  congr 1
  ext y
  constructor
  · rintro ⟨x, ⟨p, rfl⟩, rfl⟩
    refine ⟨p, ?_⟩
    have hsub :
        σ.mapMatrix (A.submatrix p.1 p.2) = (A.map σ).submatrix p.1 p.2 := by
      ext i j
      rfl
    simpa [hsub] using (RingHom.map_det σ (A.submatrix p.1 p.2)).symm
  · rintro ⟨p, hp⟩
    refine ⟨(A.submatrix p.1 p.2).det, ?_, ?_⟩
    · exact ⟨p, rfl⟩
    · have hsub :
          σ.mapMatrix (A.submatrix p.1 p.2) = (A.map σ).submatrix p.1 p.2 := by
        ext i j
        rfl
      calc
        σ (A.submatrix p.1 p.2).det = ((A.map σ).submatrix p.1 p.2).det := by
          simpa [hsub] using RingHom.map_det σ (A.submatrix p.1 p.2)
        _ = y := hp

/-- Helper for Lemma 15.8.4: a surjective finite relation family computes the same presentation
Fitting ideal as the full kernel-column matrix. -/
private theorem presentationFittingIdeal_eq_minorIdeal_of_surjective_fin_family
    {n m k : ℕ} (π : (Fin n → R) →ₗ[R] M)
    (φ : (Fin m → R) →ₗ[R] LinearMap.ker π) (hφ : Function.Surjective φ) :
    presentationFittingIdeal R M k π =
      Matrix.minorIdeal (n - k)
        (fun i j ↦ ((φ (Pi.single j (1 : R)) : LinearMap.ker π) : Fin n → R) i :
          Matrix (Fin n) (Fin m) R) := by
  let e : (Fin m →₀ R) ≃ₗ[R] (Fin m → R) := Finsupp.linearEquivFunOnFinite R R (Fin m)
  let ψ : (Fin m →₀ R) →ₗ[R] LinearMap.ker π := φ.comp e.toLinearMap
  have hψ : Function.Surjective ψ := by
    intro x
    rcases hφ x with ⟨y, rfl⟩
    refine ⟨e.symm y, ?_⟩
    simp [ψ, e]
  -- Transport the finite-family presentation through the canonical equivalence between functions
  -- on `Fin m` and finitely supported functions on `Fin m`.
  calc
    presentationFittingIdeal R M k π =
        Matrix.minorIdeal (n - k)
          (fun i a ↦ ((ψ (Finsupp.single a (1 : R)) : LinearMap.ker π) : Fin n → R) i :
            Matrix (Fin n) (Fin m) R) := by
              exact presentationFittingIdeal_eq_minorIdeal_of_surjective_finsupp_family
                (R := R) (M := M) (n := n) (k := k) (α := Fin m) π ψ hψ
    _ =
        Matrix.minorIdeal (n - k)
          (fun i j ↦ ((φ (Pi.single j (1 : R)) : LinearMap.ker π) : Fin n → R) i :
            Matrix (Fin n) (Fin m) R) := by
              congr 1
              ext i j
              simp [ψ, e]

/-- Helper for Lemma 15.8.4: tensoring the range inclusion of a linear map identifies the same
submodule as the range of the tensorized map. -/
private theorem range_subtype_baseChange_eq_range_baseChange
    {R' : Type w} [CommRing R'] [Algebra R R']
    {N : Type*} [AddCommGroup N] [Module R N]
    {P : Type*} [AddCommGroup P] [Module R P]
    (g : N →ₗ[R] P) :
    LinearMap.range (((LinearMap.range g).subtype).baseChange R') =
      LinearMap.range (g.baseChange R') := by
  -- Factor `g` through its range before tensoring, so the tensorized range restriction witnesses
  -- that tensoring the subtype inclusion does not change the image.
  have hfactor : g = (LinearMap.range g).subtype.comp g.rangeRestrict := by
    ext x
    rfl
  have hcomp :
      g.baseChange R' =
        (((LinearMap.range g).subtype).baseChange R').comp (g.rangeRestrict.baseChange R') := by
    have hbase :=
      LinearMap.baseChange_comp (A := R') (f := g.rangeRestrict) ((LinearMap.range g).subtype)
    rw [hfactor] at hbase
    exact hbase
  rw [hcomp, LinearMap.range_comp_of_range_eq_top]
  rw [LinearMap.range_eq_top]
  simpa [LinearMap.baseChange_eq_ltensor] using
    LinearMap.lTensor_surjective R' g.surjective_rangeRestrict

/-- Helper for Lemma 15.8.4: tensoring the quotient map by a submodule makes its kernel equal to
the canonical tensorized submodule. -/
private theorem ker_mkQ_baseChange_eq
    {R' : Type w} [CommRing R'] [Algebra R R']
    {N : Type*} [AddCommGroup N] [Module R N]
    (P : Submodule R N) :
    LinearMap.ker (P.mkQ.baseChange R') = P.baseChange R' := by
  -- Rewrite the tensorized quotient map in the canonical `lTensor` form and use its kernel owner
  -- theorem directly.
  ext x
  have hx :=
    congrArg (fun S : Submodule R (TensorProduct R R' N) ↦ x ∈ S) (lTensor_mkQ R' P)
  simpa [LinearMap.baseChange_eq_ltensor, Submodule.baseChange] using hx

-- Proof sketch: tensor a finite free presentation of `M` with `R'` on the left; tensor product
-- preserves right exactness, and the minors in the base-changed presentation generate the image
-- ideal.
/-- Lemma 15.8.4 (4): after base change along `R → R'`, the `k`th Fitting ideal of the canonical
scalar extension `R' ⊗[R] M` is the ideal of `R'` generated by the image of the `k`th Fitting
ideal over `R`. -/
theorem fittingIdeal_baseChange {R' : Type w} [CommRing R'] [Algebra R R'] (k : ℕ) :
    Fit[R']_(k)(R' ⊗[R] M) = Ideal.map (algebraMap R R') (Fit[R]_(k)(M)) := by
  -- The coefficientwise minor-ideal transport is now isolated in `matrix_minorIdeal_map_eq`.
  -- Route correction: the remaining source-faithful work is now concentrated in one quotient
  -- presentation bridge. The new helpers `range_subtype_baseChange_eq_range_baseChange` and
  -- `ker_mkQ_baseChange_eq` reduce the tensor comparison to identifying the finite free source
  -- `R' ⊗[R] (Fin n → R)` with `Fin n → R'` and then transporting the resulting presentation
  -- matrix through `matrix_minorIdeal_map_eq`.
