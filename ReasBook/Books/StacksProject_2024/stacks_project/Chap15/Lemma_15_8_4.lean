variable [Module.Finite R M']

/-- Helper for Lemma 15.8.4: enlarging the kernel of a presentation only enlarges the associated
presentation Fitting ideal. -/
private theorem presentationFittingIdeal_mono_of_ker_le {n k : ℕ}
    {π : (Fin n → R) →ₗ[R] M} {π' : (Fin n → R) →ₗ[R] M'}
    (hker : LinearMap.ker π ≤ LinearMap.ker π') :
    presentationFittingIdeal R M k π ≤ presentationFittingIdeal R M' k π' := by
  classical
  -- Every chosen kernel minor for `π` is also a kernel minor for `π'` via the kernel inclusion.
  rw [presentationFittingIdeal, presentationFittingIdeal]
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
  let e₂' : Fin (n - k) ↪ LinearMap.ker π' :=
    ⟨fun i ↦ ⟨(e₂ i).1, hker (e₂ i).2⟩,
      fun i j hij ↦ by
        have hval : (e₂ i).1 = (e₂ j).1 := by
          exact congrArg (fun z : LinearMap.ker π' => z.1) hij
        apply e₂.injective
        exact Subtype.ext hval⟩
  have hsub :
      Matrix.submatrix (fun i x ↦ x.1 i : Matrix (Fin n) (LinearMap.ker π) R) e₁ e₂ =
        Matrix.submatrix (fun i x ↦ x.1 i : Matrix (Fin n) (LinearMap.ker π') R) e₁ e₂' := by
    ext i j
    rfl
  -- After reindexing the columns through the inclusion `ker π ↪ ker π'`, the selected minor is
  -- literally one of the generators for the larger determinantal ideal.
  simpa [hsub] using
    (Matrix.det_submatrix_mem_minorIdeal (n - k)
      (fun i x ↦ x.1 i : Matrix (Fin n) (LinearMap.ker π') R) e₁ e₂')

-- Proof sketch: compose a finite free presentation of `M` with the surjection `M → M'`. Every
-- presentation of `M` induces one of `M'`, so the defining presentation ideals for `M` lie below
-- those for `M'`.
/-- Lemma 15.8.4 (6): a surjection `M → M'` makes the `k`th Fitting ideal of `M` contained in the
`k`th Fitting ideal of `M'`. -/
theorem fittingIdeal_mono_of_surjective (f : M →ₗ[R] M') (hf : Function.Surjective f) (k : ℕ) :
    Fit[R]_(k)(M) ≤ Fit[R]_(k)(M') := by
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' R M
  have hcomp : Function.Surjective (f.comp π) := by
    -- The composed presentation is still surjective because both maps are surjective.
    intro x
    rcases hf x with ⟨y, rfl⟩
    rcases hπ y with ⟨z, rfl⟩
    exact ⟨z, rfl⟩
  have hker : LinearMap.ker π ≤ LinearMap.ker (f.comp π) := by
    -- A relation for `π` is automatically a relation after postcomposing with `f`.
    intro x hx
    rw [LinearMap.mem_ker] at hx ⊢
    simpa [LinearMap.comp_apply, hx]
  -- Compute both intrinsic ideals from the chosen presentation and compare the kernels.
  calc
    Fit[R]_(k)(M) = presentationFittingIdeal R M k π := by
      exact fittingIdeal_eq_presentationFittingIdeal (R := R) (M := M) k π hπ
    _ ≤ presentationFittingIdeal R M' k (f.comp π) := by
      exact presentationFittingIdeal_mono_of_ker_le (R := R) (M := M) (M' := M') hker
    _ = Fit[R]_(k)(M') := by
      symm
      exact fittingIdeal_eq_presentationFittingIdeal (R := R) (M := M') k (f.comp π) hcomp

end

