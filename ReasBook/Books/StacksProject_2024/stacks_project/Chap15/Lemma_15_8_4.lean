/-- Helper for Lemma 15.8.4: the `0`th minor ideal of any matrix is the unit ideal. -/
private theorem matrix_minorIdeal_zero_eq_top {ι : Type*} {κ : Type*} (A : Matrix ι κ R) :
    Matrix.minorIdeal 0 A = ⊤ := by
  classical
  -- The empty minor contributes determinant `1`, so the span already contains a unit.
  rw [Matrix.minorIdeal]
  refine Ideal.eq_top_of_isUnit_mem _ ?_ isUnit_one
  let e₁ : Fin 0 ↪ ι := ⟨Fin.elim0, fun i ↦ Fin.elim0 i⟩
  let e₂ : Fin 0 ↪ κ := ⟨Fin.elim0, fun i ↦ Fin.elim0 i⟩
  have hmem :
      (1 : R) ∈
        Set.range (fun p : (Fin 0 ↪ ι) × (Fin 0 ↪ κ) ↦
          Matrix.det (Matrix.submatrix A p.1 p.2)) := by
    refine ⟨⟨e₁, e₂⟩, ?_⟩
    simp [e₁, e₂, Matrix.det_fin_zero]
  exact Ideal.subset_span hmem

/-- Helper for Lemma 15.8.4: reindexing the rows and columns of a matrix by equivalences does not
change the corresponding minor ideal. -/
private theorem matrix_minorIdeal_reindex_eq
    {ι : Type*} {ι' : Type*} {κ : Type*} {κ' : Type*}
    (r : ℕ) (A : Matrix ι κ R) (e₁ : ι' ≃ ι) (e₂ : κ' ≃ κ) :
    Matrix.minorIdeal r (A.submatrix e₁ e₂) = Matrix.minorIdeal r A := by
  refine le_antisymm ?_ ?_
  · -- A selected minor of the reindexed matrix is the same selected minor of the original matrix
    -- after composing the chosen row and column embeddings with `e₁` and `e₂`.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨⟨f₁, f₂⟩, rfl⟩
    simpa [Matrix.submatrix_submatrix, Function.comp_def] using
      Matrix.det_submatrix_mem_minorIdeal r A
        (f₁.trans e₁.toEmbedding) (f₂.trans e₂.toEmbedding)
  · -- The reverse inclusion is the same argument applied to the inverse reindexing functions.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨⟨f₁, f₂⟩, rfl⟩
    let f₁' : Fin r ↪ ι' := f₁.trans e₁.symm.toEmbedding
    let f₂' : Fin r ↪ κ' := f₂.trans e₂.symm.toEmbedding
    have hsub :
        Matrix.submatrix (A.submatrix e₁ e₂) f₁' f₂' = Matrix.submatrix A f₁ f₂ := by
      ext i j
      simp [f₁', f₂', Matrix.submatrix]
    simpa [hsub] using
      Matrix.det_submatrix_mem_minorIdeal r (A.submatrix e₁ e₂) f₁' f₂'

/-- Helper for Lemma 15.8.4: at the source rank, a presentation Fitting ideal is the unit ideal. -/
private theorem presentationFittingIdeal_eq_top_at_sourceRank {n : ℕ}
    (π : (Fin n → R) →ₗ[R] M) :
    presentationFittingIdeal R M n π = ⊤ := by
  -- At `k = n`, the presentation owner asks for `0 × 0` minors of the kernel-vector matrix.
  rw [presentationFittingIdeal, Nat.sub_self]
  simpa using
    matrix_minorIdeal_zero_eq_top
      (R := R)
      (A := (fun i x ↦ x.1 i : Matrix (Fin n) (LinearMap.ker π) R))

-- Proof sketch: choose a surjection `R^n → M`; the intrinsic presentation formula shows that all
-- `(n - n) × (n - n)` minors generate the unit ideal, and then compare with the canonical infimum
-- definition.
/-- Lemma 15.8.4 (1): if `M` is generated by `n` elements, then its `n`th Fitting ideal is the
unit ideal. -/
theorem fittingIdeal_eq_top_of_exists_surjective_fin (n : ℕ)
    (h : ∃ π : (Fin n → R) →ₗ[R] M, Function.Surjective π) :
    Fit[R]_(n)(M) = ⊤ := by
  rcases h with ⟨π, hπ⟩
  -- Route correction: clause (1) closes directly from one surjective presentation, so no further
  -- block-diagonal or base-change transport is needed here.
  rw [fittingIdeal_eq_presentationFittingIdeal R M n π hπ]
  exact presentationFittingIdeal_eq_top_at_sourceRank (R := R) (M := M) π

section

variable [Module.Finite R M']

/-- Helper for Lemma 15.8.4: the free module on `Fin (n + n')` splits into the two coordinate
blocks used for the product presentation. -/
private def fin_add_arrow_linearEquiv (n n' : ℕ) :
    (Fin (n + n') → R) ≃ₗ[R] (Fin n → R) × (Fin n' → R) :=
  let e₁ : (Fin (n + n') → R) ≃ₗ[R] ((Fin n ⊕ Fin n') → R) :=
    LinearEquiv.funCongrLeft (R := R) (M := R) (finSumFinEquiv (m := n) (n := n'))
  let e₂ : ((Fin n ⊕ Fin n') → R) ≃ₗ[R] ((Fin n → R) × (Fin n' → R)) :=
    LinearEquiv.sumArrowLequivProdArrow (Fin n) (Fin n') R R
  e₁.trans e₂

/-- Helper for Lemma 15.8.4: the surjective presentations of `M` and `M'` combine into the
standard product presentation of `M × M'`. -/
private def prod_presentation {n n' : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M') :
    (Fin (n + n') → R) →ₗ[R] M × M' :=
  (LinearMap.prodMap π π').comp (fin_add_arrow_linearEquiv (R := R) n n').toLinearMap

/-- Helper for Lemma 15.8.4: the product presentation is surjective once each factor presentation
is surjective. -/
private theorem prod_presentation_surjective {n n' : ℕ}
    {π : (Fin n → R) →ₗ[R] M} {π' : (Fin n' → R) →ₗ[R] M'}
    (hπ : Function.Surjective π) (hπ' : Function.Surjective π') :
    Function.Surjective (prod_presentation (R := R) (M := M) (M' := M') π π') := by
  intro x
  rcases hπ x.1 with ⟨a, ha⟩
  rcases hπ' x.2 with ⟨b, hb⟩
  -- Use the free-source splitting equivalence to glue preimages of the two coordinates.
  refine ⟨(fin_add_arrow_linearEquiv (R := R) n n').symm (a, b), ?_⟩
  ext <;> simp [prod_presentation, ha, hb]

/-- Helper for Lemma 15.8.4: after splitting the free source, the kernel of the product
presentation is linearly equivalent to the product of the two original kernels. -/
private theorem ker_prod_presentation_equiv_exists {n n' : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M') :
    Nonempty <|
      LinearMap.ker (prod_presentation (R := R) (M := M) (M' := M') π π') ≃ₗ[R]
        LinearMap.ker π × LinearMap.ker π' := by
  let e := fin_add_arrow_linearEquiv (R := R) n n'
  -- Split a kernel vector into its two coordinate blocks, and reassemble it with `e.symm`.
  refine ⟨
    { toFun := fun x ↦
        (⟨(e x.1).1, by
            have hx := x.2
            change (π ((e x.1).1), π' ((e x.1).2)) = 0 at hx
            exact congrArg Prod.fst hx
          ⟩,
         ⟨(e x.1).2, by
            have hx := x.2
            change (π ((e x.1).1), π' ((e x.1).2)) = 0 at hx
            exact congrArg Prod.snd hx
          ⟩)
      invFun := fun x ↦
        ⟨e.symm (x.1.1, x.2.1), by
          -- The inverse simply concatenates the two kernel vectors back into one source vector.
          have hx : (π x.1.1, π' x.2.1) = 0 := by
            ext <;> simp
          simpa [prod_presentation, e, LinearMap.comp_apply] using hx
        ⟩
      left_inv := by
        intro x
        ext i
        simpa [e] using congrFun (e.left_inv x.1) i
      right_inv := by
        intro x
        rcases x with ⟨x, y⟩
        apply Prod.ext
        · ext i
          have hx : (e (e.symm (x.1, y.1))).1 = x.1 := by
            exact congrArg Prod.fst (e.apply_symm_apply (x.1, y.1))
          simpa [e] using congrFun hx i
        · ext i
          have hy : (e (e.symm (x.1, y.1))).2 = y.1 := by
            exact congrArg Prod.snd (e.apply_symm_apply (x.1, y.1))
          simpa [e] using congrFun hy i
      map_add' := by
        intro x y
        apply Prod.ext
        · ext i
          simp [e]
        · ext i
          simp [e]
      map_smul' := by
        intro a x
        apply Prod.ext
        · ext i
          simp [e]
        · ext i
          simp [e] }⟩

/-- Helper for Lemma 15.8.4: choose the kernel equivalence supplied by
`ker_prod_presentation_equiv_exists`. -/
private noncomputable def ker_prod_presentation_equiv {n n' : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M') :
    LinearMap.ker (prod_presentation (R := R) (M := M) (M' := M') π π') ≃ₗ[R]
      LinearMap.ker π × LinearMap.ker π' :=
  Classical.choice <|
    ker_prod_presentation_equiv_exists (R := R) (M := M) (M' := M') π π'

/-- Helper for Lemma 15.8.4: the direct-sum presentation relations are generated by the left and
right kernel vectors inserted into the two source blocks. -/
private noncomputable def prod_kernel_relationMap {n n' : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M') :
    ((LinearMap.ker π ⊕ LinearMap.ker π') →₀ R) →ₗ[R] (Fin (n + n') → R) :=
  Finsupp.lsum R fun s ↦
    (LinearMap.id : R →ₗ[R] R).smulRight <|
      match s with
      | Sum.inl x => (fin_add_arrow_linearEquiv (R := R) n n').symm (x.1, 0)
      | Sum.inr y => (fin_add_arrow_linearEquiv (R := R) n n').symm (0, y.1)

/-- Helper for Lemma 15.8.4: a left-kernel generator of the relation map lands in the left source
block. -/
private theorem prod_kernel_relationMap_single_inl {n n' : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M')
    (x : LinearMap.ker π) (a : R) :
    prod_kernel_relationMap (R := R) (M := M) (M' := M') π π'
        (Finsupp.single (Sum.inl x) a) =
      a • (fin_add_arrow_linearEquiv (R := R) n n').symm (x.1, 0) := by
  -- Unfold the `Finsupp.lsum` definition on one generator and simplify the scalar action.
  simp [prod_kernel_relationMap, LinearMap.smulRight_apply]

/-- Helper for Lemma 15.8.4: a right-kernel generator of the relation map lands in the right
source block. -/
private theorem prod_kernel_relationMap_single_inr {n n' : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M')
    (y : LinearMap.ker π') (a : R) :
    prod_kernel_relationMap (R := R) (M := M) (M' := M') π π'
        (Finsupp.single (Sum.inr y) a) =
      a • (fin_add_arrow_linearEquiv (R := R) n n').symm (0, y.1) := by
  -- Unfold the `Finsupp.lsum` definition on one generator and simplify the scalar action.
  simp [prod_kernel_relationMap, LinearMap.smulRight_apply]

/-- Helper for Lemma 15.8.4: the chosen sum-indexed relation map generates exactly the kernel of
the product presentation. -/
private theorem prod_kernel_relationMap_range_eq_ker {n n' : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M') :
    LinearMap.range (prod_kernel_relationMap (R := R) (M := M) (M' := M') π π') =
      LinearMap.ker (prod_presentation (R := R) (M := M) (M' := M') π π') := by
  classical
  let e := fin_add_arrow_linearEquiv (R := R) n n'
  refine le_antisymm ?_ ?_
  · -- Each relation generator maps to a kernel vector, so the whole range lies in the kernel.
    rw [LinearMap.range_le_ker_iff]
    apply LinearMap.ext
    intro l
    induction l using Finsupp.induction_linear with
    | zero =>
        simp [prod_kernel_relationMap]
    | add l₁ l₂ hl₁ hl₂ =>
        simp [map_add, hl₁, hl₂]
    | single s a =>
        cases s with
        | inl x =>
            -- The left block generator dies because `x` already lies in `ker π`.
            simp [prod_kernel_relationMap_single_inl, prod_presentation, e, x.2]
        | inr y =>
            -- The right block generator dies because `y` already lies in `ker π'`.
            simp [prod_kernel_relationMap_single_inr, prod_presentation, e, y.2]
  · -- A kernel vector splits into its two coordinate blocks, each of which is generated by one
    -- relation basis element.
    intro z hz
    rw [LinearMap.mem_ker] at hz
    let x : LinearMap.ker π := by
      refine ⟨(e z).1, ?_⟩
      change (π (e z).1, π' (e z).2) = 0 at hz
      exact congrArg Prod.fst hz
    let y : LinearMap.ker π' := by
      refine ⟨(e z).2, ?_⟩
      change (π (e z).1, π' (e z).2) = 0 at hz
      exact congrArg Prod.snd hz
    refine ⟨Finsupp.single (Sum.inl x) (1 : R) + Finsupp.single (Sum.inr y) (1 : R), ?_⟩
    -- Apply the source splitting equivalence so both sides become the same explicit pair.
    apply e.injective
    simp [prod_kernel_relationMap_single_inl, prod_kernel_relationMap_single_inr, e, x, y]

/-- Helper for Lemma 15.8.4: a finitely supported function is the sum of its single-coordinate
generators over any finite set containing its support. -/
private theorem finsupp_eq_sum_attach_single_smul_of_support_subset
    {α : Type*} (f : α →₀ R) (s : Finset α) (hs : f.support ⊆ s) :
    (∑ a : {x // x ∈ s}, f a.1 • Finsupp.single a.1 (1 : R)) = f := by
  classical
  -- Compare the two finitely supported functions coefficientwise on each ambient index.
  ext b
  by_cases hb : b ∈ s
  · -- Inside the chosen support set, only the `b`-summand survives.
    simp [hb, Finsupp.single_apply]
  · -- Outside the chosen support set, `f b = 0` because the support is contained in `s`.
    have hfb : f b = 0 := by
      by_contra hfb
      exact hb (hs (by simpa [Finsupp.mem_support_iff] using hfb))
    simp [hb, Finsupp.single_apply, hfb]

/-- Helper for Lemma 15.8.4: transposing a matrix does not change the corresponding minor ideal. -/
private theorem matrix_minorIdeal_transpose_eq
    {ι : Type*} {κ : Type*} (r : ℕ) (A : Matrix ι κ R) :
    Matrix.minorIdeal r (Matrix.transpose A) = Matrix.minorIdeal r A := by
  refine le_antisymm ?_ ?_
  · -- Each selected minor of the transpose is the transpose of a selected minor of the original
    -- matrix, so the determinant generator is unchanged.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
    change ((Matrix.transpose A).submatrix e₁ e₂).det ∈ Matrix.minorIdeal r A
    have hdet : ((Matrix.transpose A).submatrix e₁ e₂).det = (A.submatrix e₂ e₁).det := by
      calc
        ((Matrix.transpose A).submatrix e₁ e₂).det =
            (Matrix.transpose (A.submatrix e₂ e₁)).det := by
          rw [Matrix.transpose_submatrix]
        _ = (A.submatrix e₂ e₁).det := by
          rw [Matrix.det_transpose]
    rw [hdet]
    exact Matrix.det_submatrix_mem_minorIdeal r A e₂ e₁
  · -- Apply the same transpose comparison again to move back from `Aᵀ` to `A`.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
    change (A.submatrix e₁ e₂).det ∈ Matrix.minorIdeal r (Matrix.transpose A)
    have hdet : (A.submatrix e₁ e₂).det =
        ((Matrix.transpose A).submatrix e₂ e₁).det := by
      calc
        (A.submatrix e₁ e₂).det = (Matrix.transpose (A.submatrix e₁ e₂)).det := by
          rw [Matrix.det_transpose]
        _ = ((Matrix.transpose A).submatrix e₂ e₁).det := by
          rw [Matrix.transpose_submatrix]
    rw [hdet]
    exact Matrix.det_submatrix_mem_minorIdeal r (Matrix.transpose A) e₂ e₁

/-- Helper for Lemma 15.8.4: a determinant built from any column-selector already belongs to the
corresponding minor ideal; repeated columns force the non-injective cases to vanish. -/
private theorem det_submatrix_mem_minorIdeal_of_colMap
    {ι : Type*} {κ : Type*} (r : ℕ) (A : Matrix ι κ R)
    (e₁ : Fin r ↪ ι) (f : Fin r → κ) :
    (A.submatrix e₁ f).det ∈ Matrix.minorIdeal r A := by
  -- Apply the repeated-row version to the transpose and then identify the transposed determinant.
  have hmem :
      ((Matrix.transpose A).submatrix f e₁).det ∈ Matrix.minorIdeal r (Matrix.transpose A) :=
    Matrix.det_submatrix_mem_minorIdeal_of_rowMap r (Matrix.transpose A) f e₁
  have hdet : ((Matrix.transpose A).submatrix f e₁).det = (A.submatrix e₁ f).det := by
    calc
      ((Matrix.transpose A).submatrix f e₁).det =
          (Matrix.transpose (A.submatrix e₁ f)).det := by
        rw [Matrix.transpose_submatrix]
      _ = (A.submatrix e₁ f).det := by
        rw [Matrix.det_transpose]
  rw [matrix_minorIdeal_transpose_eq (R := R) r A] at hmem
  rwa [hdet] at hmem

/-- Helper for Lemma 15.8.4: right multiplication does not enlarge a minor ideal. -/
private theorem matrix_minorIdeal_mul_right_le
    {ι : Type*} {κ : Type*} {κ' : Type*} [Fintype κ]
    (r : ℕ) (A : Matrix ι κ R) (T : Matrix κ κ' R) :
    Matrix.minorIdeal r (A * T) ≤ Matrix.minorIdeal r A := by
  classical
  -- Expand each selected minor of `A * T` by Cauchy-Binet along the chosen output columns.
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
  change (((A * T).submatrix e₁ e₂).det) ∈ Matrix.minorIdeal r A
  let M : Matrix (Fin r) κ R := A.submatrix e₁ (fun x : κ ↦ x)
  let N : Matrix κ (Fin r) R := T.submatrix (fun x : κ ↦ x) e₂
  have hmul : (A * T).submatrix e₁ e₂ = M * N := by
    ext i j
    simp [M, N, Matrix.mul_apply]
  have hdet : (((A * T).submatrix e₁ e₂).det) = (M * N).det := by
    rw [hmul]
  rw [hdet]
  rw [show (M * N).det =
      ∑ p : Fin r → κ, ∑ σ : Equiv.Perm (Fin r),
        ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) * N (p i) i by
      simp only [Matrix.det_apply', Matrix.mul_apply, Finset.prod_univ_sum, Finset.mul_sum,
        Fintype.piFinset_univ]
      rw [Finset.sum_comm]]
  refine (Matrix.minorIdeal r A).sum_mem fun p _ ↦ ?_
  have hp_det :
      ∑ σ : Equiv.Perm (Fin r), ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) =
        (M.submatrix id p).det := by
    symm
    exact Matrix.det_apply' (M.submatrix id p)
  have hp_factor :
      (∑ σ : Equiv.Perm (Fin r), ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) * N (p i) i) =
        (∏ i, N (p i) i) * (M.submatrix id p).det := by
    -- Pull the `T`-coefficients out of the determinant expansion and keep the chosen minor of `A`.
    calc
      (∑ σ : Equiv.Perm (Fin r), ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) * N (p i) i) =
          ∑ σ : Equiv.Perm (Fin r),
            (∏ i, N (p i) i) * (↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i)) := by
              refine Finset.sum_congr rfl fun σ _ ↦ ?_
              simp [Finset.prod_mul_distrib, mul_assoc, mul_left_comm, mul_comm]
      _ = (∏ i, N (p i) i) * ∑ σ : Equiv.Perm (Fin r),
            ↑(Equiv.Perm.sign σ) * ∏ i, M (σ i) (p i) := by
              rw [Finset.mul_sum]
      _ = (∏ i, N (p i) i) * (M.submatrix id p).det := by
              rw [hp_det]
  rw [hp_factor]
  have hminor : (M.submatrix id p).det ∈ Matrix.minorIdeal r A := by
    -- The chosen rows of `M` are exactly the chosen rows of `A`, with the column selector `p`.
    simpa [M, Matrix.submatrix_submatrix, Function.comp_def] using
      det_submatrix_mem_minorIdeal_of_colMap (R := R) r A e₁ p
  exact Ideal.mul_mem_left _ _ hminor

/-- Helper for Lemma 15.8.4: passing to a selected submatrix can only decrease the corresponding
minor ideal. -/
private theorem matrix_minorIdeal_submatrix_le
    {ι : Type*} {ι' : Type*} {κ : Type*} {κ' : Type*}
    (r : ℕ) (A : Matrix ι κ R) (e₁ : ι' ↪ ι) (e₂ : κ' ↪ κ) :
    Matrix.minorIdeal r (A.submatrix e₁ e₂) ≤ Matrix.minorIdeal r A := by
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨f₁, f₂⟩, rfl⟩
  simpa [Matrix.submatrix_submatrix, Function.comp_def] using
    Matrix.det_submatrix_mem_minorIdeal r A (f₁.trans e₁) (f₂.trans e₂)

/-- Helper for Lemma 15.8.4: after restricting to the union of supports of chosen preimages, the
selected kernel-column matrix factors through the finitely many `Finsupp.single` columns. -/
private theorem finsupp_minor_factorization_through_support_union
    {n r : ℕ} {α : Type*} [DecidableEq α] (π : (Fin n → R) →ₗ[R] M)
    (φ : (α →₀ R) →ₗ[R] LinearMap.ker π)
    (e₂ : Fin r ↪ LinearMap.ker π)
    (g : Fin r → α →₀ R)
    (hg : ∀ j : Fin r, φ (g j) = e₂ j) :
    let s : Finset α := Finset.univ.biUnion fun j : Fin r => (g j).support
    let A : Matrix (Fin n) {a // a ∈ s} R :=
      fun i a ↦ ((φ (Finsupp.single a.1 (1 : R)) : LinearMap.ker π) : Fin n → R) i
    let T : Matrix {a // a ∈ s} (Fin r) R := fun a j ↦ g j a.1
    (fun i j ↦ ((e₂ j : LinearMap.ker π) : Fin n → R) i : Matrix (Fin n) (Fin r) R) = A * T := by
  classical
  intro s A T
  ext i j
  -- Expand the chosen preimage `g j` over the finite support union `s`.
  have hs : (g j).support ⊆ s := by
    intro a ha
    exact Finset.mem_biUnion.2 ⟨j, by simp, ha⟩
  have hsum :
      (∑ a : {x // x ∈ s}, g j a.1 • Finsupp.single a.1 (1 : R)) = g j :=
    finsupp_eq_sum_attach_single_smul_of_support_subset (R := R) (f := g j) s hs
  have hpreimage :
      g j = ∑ a : {x // x ∈ s}, g j a.1 • Finsupp.single a.1 (1 : R) := by
    simpa using hsum.symm
  have hmap :
      φ (g j) =
        φ (∑ a : {x // x ∈ s}, g j a.1 • Finsupp.single a.1 (1 : R)) :=
    congrArg φ hpreimage
  have hφsum :
      φ (g j) =
        ∑ a : {x // x ∈ s}, g j a.1 • φ (Finsupp.single a.1 (1 : R)) := by
    calc
      φ (g j) = φ (∑ a : {x // x ∈ s}, g j a.1 • Finsupp.single a.1 (1 : R)) := hmap
      _ = ∑ a : {x // x ∈ s}, φ (g j a.1 • Finsupp.single a.1 (1 : R)) := by
        rw [map_sum]
      _ = ∑ a : {x // x ∈ s}, g j a.1 • φ (Finsupp.single a.1 (1 : R)) := by
        refine Finset.sum_congr rfl ?_
        intro a ha
        rw [map_smul]
  -- Evaluating the expanded preimage at coordinate `i` produces the matrix product formula.
  calc
    ((e₂ j : LinearMap.ker π) : Fin n → R) i = ((φ (g j) : LinearMap.ker π) : Fin n → R) i := by
      simpa [hg j]
    _ =
        ((∑ a : {x // x ∈ s}, g j a.1 • φ (Finsupp.single a.1 (1 : R)) :
            LinearMap.ker π) : Fin n → R) i := by
          rw [hφsum]
    _ = ∑ a : {x // x ∈ s},
          ((φ (Finsupp.single a.1 (1 : R)) : LinearMap.ker π) : Fin n → R) i * g j a.1 := by
          simp [mul_comm, mul_left_comm, mul_assoc]
    _ = (A * T) i j := by
          simp [A, T, Matrix.mul_apply, mul_comm, mul_left_comm, mul_assoc]

/-- Helper for Lemma 15.8.4: every selected kernel minor coming from a surjective `Finsupp`
relation family already lies in the minor ideal generated by the `Finsupp.single` columns. -/
private theorem selected_minorIdeal_le_finsupp_family_minorIdeal
    {n r : ℕ} {α : Type*} (π : (Fin n → R) →ₗ[R] M)
    (φ : (α →₀ R) →ₗ[R] LinearMap.ker π) (hφ : Function.Surjective φ)
    (e₂ : Fin r ↪ LinearMap.ker π) :
    Matrix.minorIdeal r
        (fun i j ↦ ((e₂ j : LinearMap.ker π) : Fin n → R) i : Matrix (Fin n) (Fin r) R) ≤
      Matrix.minorIdeal r
        (fun i a ↦ ((φ (Finsupp.single a (1 : R)) : LinearMap.ker π) : Fin n → R) i :
          Matrix (Fin n) α R) := by
  classical
  choose g hg using fun j : Fin r => hφ (e₂ j)
  let s : Finset α := Finset.univ.biUnion fun j : Fin r => (g j).support
  let A : Matrix (Fin n) {a // a ∈ s} R :=
    fun i a ↦ ((φ (Finsupp.single a.1 (1 : R)) : LinearMap.ker π) : Fin n → R) i
  let T : Matrix {a // a ∈ s} (Fin r) R := fun a j ↦ g j a.1
  let B : Matrix (Fin n) α R :=
    fun i a ↦ ((φ (Finsupp.single a (1 : R)) : LinearMap.ker π) : Fin n → R) i
  let e : {a // a ∈ s} ↪ α := ⟨Subtype.val, fun a b h => Subtype.ext h⟩
  have hfactor :
      (fun i j ↦ ((e₂ j : LinearMap.ker π) : Fin n → R) i : Matrix (Fin n) (Fin r) R) = A * T :=
    finsupp_minor_factorization_through_support_union
      (R := R) (M := M) π φ e₂ g hg
  have hsub : A = B.submatrix (Function.Embedding.refl (Fin n)) e := by
    ext i a
    rfl
  -- First factor the selected matrix through the finite support union, then enlarge back to the
  -- full `α`-indexed family matrix.
  calc
    Matrix.minorIdeal r
        (fun i j ↦ ((e₂ j : LinearMap.ker π) : Fin n → R) i : Matrix (Fin n) (Fin r) R) =
      Matrix.minorIdeal r (A * T) := by
        rw [hfactor]
    _ ≤ Matrix.minorIdeal r A := by
        exact matrix_minorIdeal_mul_right_le (R := R) r A T
    _ ≤ Matrix.minorIdeal r B := by
        simpa [hsub] using
          (matrix_minorIdeal_submatrix_le
            (R := R) r B (Function.Embedding.refl (Fin n)) e :
              Matrix.minorIdeal r (B.submatrix (Function.Embedding.refl (Fin n)) e) ≤
                Matrix.minorIdeal r B)

/-- Helper for Lemma 15.8.4: a surjective finitely supported relation family computes the same
presentation Fitting ideal as the full kernel-column matrix. -/
private theorem presentationFittingIdeal_eq_minorIdeal_of_surjective_finsupp_family
    {n k : ℕ} {α : Type*} (π : (Fin n → R) →ₗ[R] M)
    (φ : (α →₀ R) →ₗ[R] LinearMap.ker π) (hφ : Function.Surjective φ) :
    presentationFittingIdeal R M k π =
      Matrix.minorIdeal (n - k)
        (fun i a ↦ ((φ (Finsupp.single a (1 : R)) : LinearMap.ker π) : Fin n → R) i :
          Matrix (Fin n) α R) := by
  classical
  let K : Matrix (Fin n) (LinearMap.ker π) R := fun i x ↦ x.1 i
  let B : Matrix (Fin n) α R :=
    fun i a ↦ ((φ (Finsupp.single a (1 : R)) : LinearMap.ker π) : Fin n → R) i
  -- Route correction: split the equality into the surjective-family inclusion and the tautological
  -- inclusion coming from the fact that every `Finsupp.single` column is itself a kernel vector.
  rw [presentationFittingIdeal]
  refine le_antisymm ?_ ?_
  · -- Each selected kernel-column minor factors through finitely many preimages under `φ`.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
    let S : Matrix (Fin n) (Fin (n - k)) R :=
      fun i j ↦ ((e₂ j : LinearMap.ker π) : Fin n → R) i
    have hSel :
        Matrix.minorIdeal (n - k) S ≤ Matrix.minorIdeal (n - k) B :=
      selected_minorIdeal_le_finsupp_family_minorIdeal
        (R := R) (M := M) π φ hφ e₂
    have hmem :
        Matrix.det (Matrix.submatrix S e₁ (Function.Embedding.refl (Fin (n - k)))) ∈
          Matrix.minorIdeal (n - k) B := by
      exact hSel <|
        Matrix.det_submatrix_mem_minorIdeal (n - k) S e₁
          (Function.Embedding.refl (Fin (n - k)))
    simpa [S] using hmem
  · -- Every chosen minor of the `Finsupp.single` family is already a kernel-column minor.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
    let g : Fin (n - k) → LinearMap.ker π := fun j ↦ φ (Finsupp.single (e₂ j) (1 : R))
    have hsub : B.submatrix e₁ e₂ = K.submatrix e₁ g := by
      ext i j
      simp [B, K, g]
    change (B.submatrix e₁ e₂).det ∈ Matrix.minorIdeal (n - k) K
    rw [hsub]
    exact det_submatrix_mem_minorIdeal_of_colMap (R := R) (n - k) K e₁ g

/-- Helper for Lemma 15.8.4: once the product kernel is replaced by the explicit relation map, the
remaining direct-sum computation is the block-diagonal minors identity. -/
private theorem presentationFittingIdeal_directSum_of_presentations {n n' l : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M') :
    presentationFittingIdeal R (M × M') l
        (prod_presentation (R := R) (M := M) (M' := M') π π') =
      Finset.sum (Finset.antidiagonal l) fun p ↦
        presentationFittingIdeal R M p.1 π * presentationFittingIdeal R M' p.2 π' := by
  -- Route correction: the previous endgame stayed on the raw kernel subtype. The source-faithful
  -- next step is to rewrite through `prod_kernel_relationMap_range_eq_ker`, apply the new
  -- `presentationFittingIdeal_eq_minorIdeal_of_surjective_finsupp_family`, and then identify the
  -- resulting relation matrix with a literal block-diagonal matrix.
  have hrange :=
    prod_kernel_relationMap_range_eq_ker (R := R) (M := M) (M' := M') π π'
  -- TODO: transport `presentationFittingIdeal` across `hrange`, rewrite the relation matrix of
  -- `prod_kernel_relationMap` as `Matrix.fromBlocks`, and finish with
  -- `Matrix.minorIdeal_fromBlocks`.
  sorry

-- Proof sketch: use finite free presentations of `M` and `M'`, form the block-diagonal
-- presentation of `M ⊕ M'`, and invoke the corresponding minors formula from the matrix-level
-- statement.
/-- Lemma 15.8.4 (3): the `l`th Fitting ideal of a direct sum is the sum of the products of the
`k`th and `k'`th Fitting ideals over all decompositions `k + k' = l`. -/
theorem fittingIdeal_directSum (l : ℕ) :
    Fit[R]_(l)(M × M') =
      Finset.sum (Finset.antidiagonal l) fun p ↦ Fit[R]_(p.1)(M) * Fit[R]_(p.2)(M') := by
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' R M
  obtain ⟨n', π', hπ'⟩ := Module.Finite.exists_fin' R M'
  have hprod :
      Function.Surjective
        (prod_presentation (R := R) (M := M) (M' := M') π π') :=
    prod_presentation_surjective (R := R) (M := M) (M' := M') hπ hπ'
  have hM :
      ∀ k : ℕ, Fit[R]_(k)(M) = presentationFittingIdeal R M k π := fun k ↦
        fittingIdeal_eq_presentationFittingIdeal (R := R) (M := M) k π hπ
  have hM' :
      ∀ k : ℕ, Fit[R]_(k)(M') = presentationFittingIdeal R M' k π' := fun k ↦
        fittingIdeal_eq_presentationFittingIdeal (R := R) (M := M') k π' hπ'
  -- Route correction: first rewrite the intrinsic Fitting ideals on both sides using one chosen
  -- surjective presentation for each module, so the remaining gap is the source-level
  -- block-diagonal presentation identity for `prod_presentation`.
  rw [fittingIdeal_eq_presentationFittingIdeal (R := R) (M := M × M') l
    (prod_presentation (R := R) (M := M) (M' := M') π π') hprod]
  simp_rw [hM, hM']
  -- The presentation-level direct-sum identity is now isolated in a dedicated helper built from
  -- the sum-indexed relation map `prod_kernel_relationMap`.
  exact presentationFittingIdeal_directSum_of_presentations
    (R := R) (M := M) (M' := M') π π'

-- Proof sketch: specialize the general direct-sum formula at `l = 0`; the antidiagonal of `0`
-- has the single term `(0, 0)`.
/-- Lemma 15.8.4 (2): the zeroth Fitting ideal of a direct sum is the product of the zeroth
Fitting ideals. -/
theorem fittingIdeal_zero_directSum :
    Fit[R]_(0)(M × M') = Fit[R]_(0)(M) * Fit[R]_(0)(M') := by
  have h :
      Fit[R]_(0)(M × M') =
        Finset.sum (Finset.antidiagonal 0) fun p ↦ Fit[R]_(p.1)(M) * Fit[R]_(p.2)(M') :=
    fittingIdeal_directSum 0
  simpa [Finset.antidiagonal] using h

end

