/-- Helper for Lemma 15.8.4: for a surjective presentation, the determinant of any square matrix
whose columns are kernel vectors annihilates the quotient module. -/
private theorem det_kernel_matrix_mem_annihilator_of_surjective {n : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π)
    (e₂ : Fin n ↪ LinearMap.ker π) :
    Matrix.det (fun i j ↦ ((e₂ j : LinearMap.ker π) : Fin n → R) i : Matrix (Fin n) (Fin n) R) ∈
      Module.annihilator R M := by
  let A : Matrix (Fin n) (Fin n) R :=
    fun i j ↦ ((e₂ j : LinearMap.ker π) : Fin n → R) i
  have hcolumn_zero : ∀ j : Fin n, π (fun i ↦ A i j) = 0 := by
    intro j
    exact (e₂ j).2
  have hadjugate_column_zero : ∀ j : Fin n, π (fun i ↦ (A * A.adjugate) i j) = 0 := by
    intro j
    -- Each adjugate column is an `R`-linear combination of the original kernel columns.
    have hcolumn :
        (fun i ↦ (A * A.adjugate) i j) =
          ∑ t : Fin n, A.adjugate t j • fun i ↦ A i t := by
      ext i
      simp [A, Matrix.mul_apply, dotProduct, mul_comm]
    rw [hcolumn, map_sum]
    refine Finset.sum_eq_zero ?_
    intro t ht
    rw [π.map_smul, hcolumn_zero t, smul_zero]
  have hbasis_zero : ∀ j : Fin n, π (A.det • (Pi.single j (1 : R) : Fin n → R)) = 0 := by
    intro j
    -- Rewrite the adjugate identity columnwise to get the determinant relation on a basis vector.
    calc
      π (A.det • (Pi.single j (1 : R) : Fin n → R)) =
          π (fun i ↦ ((A.det • (1 : Matrix (Fin n) (Fin n) R)) i j)) := by
            congr 1
            ext i
            by_cases hij : i = j
            · subst hij
              simp
            · simp [Matrix.one_apply, Pi.single_apply, hij]
      _ = π (fun i ↦ (A * A.adjugate) i j) := by
            rw [Matrix.mul_adjugate]
      _ = 0 := hadjugate_column_zero j
  -- Evaluate the determinant relation on a chosen preimage of an arbitrary module element.
  rw [Module.mem_annihilator]
  intro x
  rcases hπ x with ⟨v, rfl⟩
  have hv :
      ∑ j : Fin n, v j • (Pi.single j (1 : R) : Fin n → R) = v := by
    ext i
    simpa [Pi.single_apply, mul_comm] using (Fintype.sum_pi_single (i := i) (f := v))
  have hπv :
      π v = ∑ j : Fin n, v j • π (Pi.single j (1 : R) : Fin n → R) := by
    calc
      π v = π (∑ j : Fin n, v j • (Pi.single j (1 : R) : Fin n → R)) := by
        rw [hv]
      _ = ∑ j : Fin n, π (v j • (Pi.single j (1 : R) : Fin n → R)) := by
        simp [map_sum]
      _ = ∑ j : Fin n, v j • π (Pi.single j (1 : R) : Fin n → R) := by
        simp [map_sum, map_smul]
  calc
    A.det • π v = A.det • ∑ j : Fin n, v j • π (Pi.single j (1 : R) : Fin n → R) := by
      rw [hπv]
    _ = ∑ j : Fin n, A.det • (v j • π (Pi.single j (1 : R) : Fin n → R)) := by
      simpa using Finset.smul_sum (s := Finset.univ) (r := A.det)
        (f := fun j : Fin n ↦ v j • π (Pi.single j (1 : R) : Fin n → R))
    _ = ∑ j : Fin n, v j • (A.det • π (Pi.single j (1 : R) : Fin n → R)) := by
      refine Finset.sum_congr rfl ?_
      intro j hj
      simp [smul_smul, mul_comm]
    _ = ∑ j : Fin n, v j • π (A.det • (Pi.single j (1 : R) : Fin n → R)) := by
      refine Finset.sum_congr rfl ?_
      intro j hj
      rw [← π.map_smul]
    _ = 0 := by
      refine Finset.sum_eq_zero ?_
      intro j hj
      rw [hbasis_zero j, smul_zero]

/-- Helper for Lemma 15.8.4: every full-row presentation minor of a surjective presentation is an
annihilator element. -/
private theorem full_row_minor_mem_annihilator_of_surjective {n : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π)
    (e₁ : Fin n ↪ Fin n) (e₂ : Fin n ↪ LinearMap.ker π) :
    Matrix.det
        (Matrix.submatrix
          (fun i x ↦ x.1 i : Matrix (Fin n) (LinearMap.ker π) R) e₁ e₂) ∈
      Module.annihilator R M := by
  classical
  let e : Fin n ≃ Fin n :=
    Equiv.ofBijective e₁ ⟨e₁.injective,
      (Finite.injective_iff_surjective (f := e₁)).1 e₁.injective⟩
  let A : Matrix (Fin n) (Fin n) R :=
    fun i j ↦ ((e₂ j : LinearMap.ker π) : Fin n → R) i
  have hsub :
      Matrix.submatrix
          (fun i x ↦ x.1 i : Matrix (Fin n) (LinearMap.ker π) R) e₁ e₂ =
        Matrix.reindex e.symm (Equiv.refl (Fin n)) A := by
    ext i j
    simp [Matrix.reindex_apply, A, e]
  -- The selected rows are a permutation of all rows, so the determinant changes only by a sign.
  rw [hsub]
  have hdet :
      Matrix.det (Matrix.reindex e.symm (Equiv.refl (Fin n)) A) =
        (↑(Equiv.Perm.sign ((Equiv.refl (Fin n)).symm.trans e.symm)) : R) * Matrix.det A := by
    simpa using Matrix.det_reindex e.symm (Equiv.refl (Fin n)) A
  rw [hdet]
  exact Ideal.mul_mem_left _ _
    (det_kernel_matrix_mem_annihilator_of_surjective (R := R) (M := M) π hπ e₂)

-- Proof sketch: use a finite presentation of `M` and the determinant trick on the maximal minors
-- of a presentation matrix to show that every generator of `Fit₀(M)` annihilates `M`.
/-- Lemma 15.8.4 (7): the zeroth Fitting ideal of `M` is contained in the annihilator ideal of
`M`. -/
theorem fittingIdeal_zero_le_annihilator :
    Fit[R]_(0)(M) ≤ Module.annihilator R M := by
  obtain ⟨n, π, hπ⟩ := Module.Finite.exists_fin' R M
  -- Route correction: for `k = 0`, every generator is a full-size determinant, so the source proof
  -- reduces to the adjugate identity on one surjective presentation.
  rw [fittingIdeal_eq_presentationFittingIdeal (R := R) (M := M) 0 π hπ, presentationFittingIdeal]
  refine Ideal.span_le.2 ?_
  rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
  -- Each selected maximal minor is a row permutation of a square kernel-column matrix, hence it
  -- annihilates `M` by the determinant trick proved above.
  exact full_row_minor_mem_annihilator_of_surjective (R := R) (M := M) π hπ e₁ e₂

-- Proof sketch: combine the previous annihilator containment with the characterization of support
-- of a finite module as the zero locus of its annihilator via `Module.support_eq_zeroLocus`, and
-- compare with the determinant criterion after reducing modulo a prime.
/-- Lemma 15.8.4 (8): the zero locus of the zeroth Fitting ideal of `M` is the support of `M`. -/
theorem zeroLocus_fittingIdeal_zero_eq_support :
    zeroLocus (Fit[R]_(0)(M)) = Module.support R M := by
  apply le_antisymm
  · -- TODO: prove the reverse inclusion by localizing at a prime and invoking clause `(1)` after
    -- base change to the residue field; the remaining blocker is the missing base-change theorem.
    sorry
  · -- The annihilator containment already gives the easy support inclusion.
    rw [Module.support_eq_zeroLocus]
    exact (zeroLocus_subset_zeroLocus_iff (I := Module.annihilator R M)
      (J := Fit[R]_(0)(M))).2 <|
      le_trans (fittingIdeal_zero_le_annihilator (R := R) (M := M)) Ideal.le_radical

end

end

-- Proof sketch: start from a finite presentation of `M`; the relevant ideal is generated by a
-- finite set of minors of a finite presentation matrix, hence is finitely generated.
/-- Lemma 15.8.4 (5): if `M` is finitely presented, then each Fitting ideal of `M` is finitely
generated. -/
theorem fittingIdeal_fg_of_finitePresentation [Module.FinitePresentation R M] (k : ℕ) :
    (Fit[R]_(k)(M)).FG := by
  rcases (Module.FinitePresentation.iff_exists_exact_free_sequence R M).mp inferInstance with
    ⟨n, m, f, g, hfg, hg⟩
  rw [fittingIdeal_eq_presentationFittingIdeal (R := R) (M := M) k g hg]
  rw [LinearMap.exact_iff] at hfg
  have hfker : ∀ x, f x ∈ LinearMap.ker g := by
    intro x
    rw [hfg]
    exact LinearMap.mem_range_self f x
  let φ : (Fin m → R) →ₗ[R] LinearMap.ker g := LinearMap.codRestrict (LinearMap.ker g) f hfker
  have hφ : Function.Surjective φ := by
    intro x
    have hx : x.1 ∈ LinearMap.range f := by
      simpa [hfg] using x.2
    rcases hx with ⟨y, hy⟩
    refine ⟨y, ?_⟩
    apply Subtype.ext
    exact hy
  let A : Matrix (Fin n) (Fin m) R :=
    fun i j ↦ ((φ (Pi.single j (1 : R)) : LinearMap.ker g) : Fin n → R) i
  have hpresent :
      presentationFittingIdeal R M k g = Matrix.minorIdeal (n - k) A := by
    exact presentationFittingIdeal_eq_minorIdeal_of_surjective_fin_family
      (R := R) (M := M) g φ hφ
  -- Compute the presentation ideal from the finite family `φ`, then observe that the resulting
  -- determinantal ideal is the span of a finite set of minors.
  rw [hpresent, Matrix.minorIdeal]
  simpa [A] using
    (Submodule.fg_span
      (Set.finite_range
        (fun p : (Fin (n - k) ↪ Fin n) × (Fin (n - k) ↪ Fin m) ↦
          Matrix.det (Matrix.submatrix A p.1 p.2))) :
      (Ideal.span
        (Set.range fun p : (Fin (n - k) ↪ Fin n) × (Fin (n - k) ↪ Fin m) ↦
          Matrix.det (Matrix.submatrix A p.1 p.2))).FG)

/-- Helper for Lemma 15.8.4: the first minor ideal of a `1 × κ` matrix is the ideal spanned by
its entries. -/
private theorem matrix_minorIdeal_one_eq_span_single_row {κ : Type*} (A : Matrix (Fin 1) κ R) :
    Matrix.minorIdeal 1 A = Ideal.span (Set.range fun j : κ ↦ A (0 : Fin 1) j) := by
  classical
  rw [Matrix.minorIdeal]
  refine le_antisymm ?_ ?_
  · -- Every `1 × 1` minor is just one matrix entry from some chosen column.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
    have he₁ : e₁ = Function.Embedding.refl (Fin 1) := by
      ext i
      exact congrArg Fin.val (Subsingleton.elim (e₁ i) i)
    rw [he₁]
    exact Ideal.subset_span ⟨e₂ (0 : Fin 1), by simp⟩
  · -- Conversely, each entry appears as the determinant of the minor picking that column.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨j, rfl⟩
    let e₂ : Fin 1 ↪ κ := ⟨fun _ ↦ j, fun _ _ _ ↦ Subsingleton.elim _ _⟩
    exact Ideal.subset_span ⟨⟨Function.Embedding.refl (Fin 1), e₂⟩, by
      simp [e₂]⟩

/-- Helper for Lemma 15.8.4: the entries of the kernel vectors in the rank-`1` quotient
presentation generate exactly the quotient ideal. -/
private theorem quotient_presentation_entry_span_eq_ideal (I : Ideal R) :
    let π : (Fin 1 → R) →ₗ[R] R ⧸ I :=
      (Ideal.Quotient.mkₐ R I).toLinearMap.comp (LinearEquiv.funUnique (Fin 1) R R).toLinearMap
    Ideal.span (Set.range fun x : LinearMap.ker π => x.1 (0 : Fin 1)) = I := by
  let e : (Fin 1 → R) ≃ₗ[R] R := LinearEquiv.funUnique (Fin 1) R R
  let π : (Fin 1 → R) →ₗ[R] R ⧸ I := (Ideal.Quotient.mkₐ R I).toLinearMap.comp e.toLinearMap
  change Ideal.span (Set.range fun x : LinearMap.ker π => x.1 (0 : Fin 1)) = I
  refine le_antisymm ?_ ?_
  · -- A kernel vector maps to zero in `R ⧸ I`, so its unique coordinate lies in `I`.
    refine Ideal.span_le.2 ?_
    rintro _ ⟨x, rfl⟩
    have hx := x.2
    change (Ideal.Quotient.mkₐ R I) (x.1 (0 : Fin 1)) = 0 at hx
    exact (Ideal.Quotient.eq_zero_iff_mem).1 hx
  · -- Every element of `I` gives a kernel vector by placing it in the unique source coordinate.
    intro r hr
    refine Ideal.subset_span ?_
    have hx : π (e.symm r) = 0 := by
      change (Ideal.Quotient.mkₐ R I) r = 0
      exact (Ideal.Quotient.eq_zero_iff_mem).2 hr
    refine ⟨⟨e.symm r, hx⟩, ?_⟩
    simp [e]

-- Proof sketch: use the standard one-generator presentation of `R ⧸ I`; its `1 × 1` minors are
-- exactly the elements of `I`, so the zeroth Fitting ideal recovers `I`.
/-- Lemma 15.8.4 (9): the zeroth Fitting ideal of the quotient module `R ⧸ I` is `I`. -/
theorem fittingIdeal_zero_quotient (I : Ideal R) :
    Fit[R]_(0)(R ⧸ I) = I := by
  let e : (Fin 1 → R) ≃ₗ[R] R := LinearEquiv.funUnique (Fin 1) R R
  let π : (Fin 1 → R) →ₗ[R] R ⧸ I := (Ideal.Quotient.mkₐ R I).toLinearMap.comp e.toLinearMap
  have hπ : Function.Surjective π := by
    -- The quotient map is surjective, and `Fin 1 → R` is canonically `R`.
    intro x
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    refine ⟨e.symm r, ?_⟩
    simp [π, e]
  rw [fittingIdeal_eq_presentationFittingIdeal R (R ⧸ I) 0 π hπ]
  -- Route correction: for the quotient clause we stay on the source route and compute from the
  -- canonical one-generator quotient presentation rather than detouring through direct sums.
  calc
    presentationFittingIdeal R (R ⧸ I) 0 π
        = Matrix.minorIdeal 1 (fun i x ↦ x.1 i : Matrix (Fin 1) (LinearMap.ker π) R) := by
            simp [presentationFittingIdeal]
    _ = Ideal.span (Set.range fun x : LinearMap.ker π => x.1 0) := by
      exact matrix_minorIdeal_one_eq_span_single_row
        (R := R) (A := (fun i x ↦ x.1 i : Matrix (Fin 1) (LinearMap.ker π) R))
    _ = I := by
      simpa [π] using quotient_presentation_entry_span_eq_ideal (R := R) I

end
