/-- Helper for Lemma 15.31.4: for a finite family indexed by `Fin`, the owner ideal
`Ideal.ofList (List.ofFn f)` is the source-facing span ideal `Ideal.span (Set.range f)`. -/
theorem ofList_ofFn_eq_span_range {S : Type u} [CommRing S] {n : ℕ} (f : Fin n → S) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  -- Both descriptions generate exactly the same finite subset of `S`.
  ext x
  simp [Ideal.ofList, List.mem_ofFn', Set.range]

end Ideal

section

variable {A B A' : Type u} [CommRing A] [CommRing B] [CommRing A']
variable [Algebra A B] [Algebra A A']
variable {r : ℕ}

local notation "B'" => A' ⊗[A] B

/- Domain triage:
* primary domain: quasi-regular and `H₁`-regular finite sequences under tensor base change in
  commutative algebra;
* sampled owner declarations: `IsQuasiRegularSequence` from Chapter 10, `IsH1RegularSequence`
  from Definition `15.30.1`, `IsQuasiRegular.of_flat` from Lemma `10.69.3`, and
  `koszulH1BaseChange`/`koszulH1_baseChange_surjective_of_flat_quotient` from Lemma `15.31.3`;
* best owner abstraction: the ring-valued quasi-regular statement should use the ring-level owner
  `IsQuasiRegularSequence`, while the `H₁`-regular statement should stay on the finite-family
  owner `IsH1RegularSequence`;
* primitive data vs derived API: the only primitive input is the finite family `f`; the tensor
  base-changed family is a derived view, so the public surface should reuse the existing owner
  predicates rather than restating the regular-module case through the more general
  module-valued predicate.
-/

-- Proof sketch: let `J = Ideal.span (Set.range f)`. Quasi-regularity identifies each graded piece
-- `J^n / J^(n + 1)` with a direct sum of copies of `B ⧸ J`, hence these graded pieces are flat
-- over `A`. By the flatness criterion for successive quotients, the quotients `B ⧸ J^n` remain
-- flat over `A`. After base change, the powers of the extended ideal are the tensor products of
-- the powers of `J`, so the associated graded criterion for quasi-regularity carries over to the
-- image sequence in `A' ⊗[A] B`.
/-- Helper for Lemma 15.31.4: the ideal generated by the base-changed family is the image of the
source ideal under `B → A' ⊗[A] B`. -/
private theorem baseChange_span_range_eq_map_span_range (f : Fin r → B) :
    Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) =
      Ideal.map (includeRight : B →ₐ[A] B') (Ideal.span (Set.range f)) := by
  -- Normalize both sides to the span of the image set under `includeRight`.
  rw [Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨f i, ⟨i, rfl⟩, rfl⟩
  · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
    exact ⟨i, rfl⟩

/-- Helper for Lemma 15.31.4: after base change, the `n`th power of the ideal generated by the
family is the image of the `n`th power of the source ideal. -/
private theorem map_span_range_pow_eq_baseChange_span_range_pow
    (f : Fin r → B) (n : ℕ) :
    Ideal.map (includeRight : B →ₐ[A] B') ((Ideal.span (Set.range f)) ^ n) =
      (Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n) := by
  -- Normalize powers after identifying the target ideal with the mapped source ideal.
  rw [Ideal.map_pow, baseChange_span_range_eq_map_span_range]

/-- Helper for Lemma 15.31.4: transporting quotient classes along the equality of the mapped and
base-changed ideal powers fixes representatives. -/
private theorem map_span_range_pow_quotEquiv_mk
    (f : Fin r → B) (n : ℕ) (x : B') :
    Ideal.quotEquivOfEq
        (map_span_range_pow_eq_baseChange_span_range_pow
          (A := A) (B := B) (A' := A') f n)
        ((Ideal.Quotient.mk
          (Ideal.map (includeRight : B →ₐ[A] B') ((Ideal.span (Set.range f)) ^ n))) x) =
      (Ideal.Quotient.mk
        ((Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n))) x := by
  -- The owner quotient transport acts by the identity on representatives.
  rw [Ideal.quotEquivOfEq_mk]

/-- Helper for Lemma 15.31.4: the inverse quotient transport along the equality of the mapped and
base-changed ideal powers also fixes representatives. -/
private theorem map_span_range_pow_quotEquiv_symm_mk
    (f : Fin r → B) (n : ℕ) (x : B') :
    (Ideal.quotEquivOfEq
        (map_span_range_pow_eq_baseChange_span_range_pow
          (A := A) (B := B) (A' := A') f n)).symm
        ((Ideal.Quotient.mk
          ((Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n))) x) =
      (Ideal.Quotient.mk
        (Ideal.map (includeRight : B →ₐ[A] B') ((Ideal.span (Set.range f)) ^ n))) x := by
  -- Apply the forward representative-level computation and solve by symmetry.
  exact
    (Ideal.quotEquivOfEq
      (map_span_range_pow_eq_baseChange_span_range_pow
        (A := A) (B := B) (A' := A') f n)).symm_apply_eq.2 <|
      map_span_range_pow_quotEquiv_mk (A := A) (B := B) (A' := A') f n x

/-- Helper for Lemma 15.31.4: quotient transport along an equality of ideals preserves the
restricted `A'`-scalar action on quotient modules over `B'`. -/
private theorem quotEquivOfEq_map_smul_over_baseChange
    {I J : Ideal B'} (h : I = J) (a : A') (x : B' ⧸ I) :
    Ideal.quotEquivOfEq h (a • x) = a • Ideal.quotEquivOfEq h x := by
  -- The quotient transport is the identity on representatives, so scalar multiplication is
  -- preserved after choosing any representative of the quotient class.
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- Helper for Lemma 15.31.4: transport along an equality of ideals gives an `A'`-linear
equivalence between the corresponding quotient modules of `B'`. -/
private noncomputable def quotEquivOfEq_linearOver_baseChange
    {I J : Ideal B'} (h : I = J) :
    (B' ⧸ I) ≃ₗ[A'] (B' ⧸ J) :=
  { toFun := Ideal.quotEquivOfEq h
    invFun := (Ideal.quotEquivOfEq h).symm
    left_inv := (Ideal.quotEquivOfEq h).left_inv
    right_inv := (Ideal.quotEquivOfEq h).right_inv
    map_add' := (Ideal.quotEquivOfEq h).map_add
    map_smul' := quotEquivOfEq_map_smul_over_baseChange (A := A) (B := B) (A' := A') h }

/-- Helper for Lemma 15.31.4: the explicit `A'`-linear quotient transport still fixes quotient
representatives. -/
private theorem quotEquivOfEq_linearOver_baseChange_mk
    {I J : Ideal B'} (h : I = J) (x : B') :
    quotEquivOfEq_linearOver_baseChange (A := A) (B := B) (A' := A') h
        ((Ideal.Quotient.mk I) x) =
      (Ideal.Quotient.mk J) x := by
  rfl

/-- Helper for Lemma 15.31.4: the inverse of the explicit `A'`-linear quotient transport also
fixes quotient representatives. -/
private theorem quotEquivOfEq_linearOver_baseChange_symm_mk
    {I J : Ideal B'} (h : I = J) (x : B') :
    (quotEquivOfEq_linearOver_baseChange (A := A) (B := B) (A' := A') h).symm
        ((Ideal.Quotient.mk J) x) =
      (Ideal.Quotient.mk I) x := by
  exact
    (quotEquivOfEq_linearOver_baseChange (A := A) (B := B) (A' := A') h).symm_apply_eq.2 <|
      quotEquivOfEq_linearOver_baseChange_mk (A := A) (B := B) (A' := A') h x

/-- Helper for Lemma 15.31.4: inside the regular `B`-module, the submodule `J • ⊤` is exactly
`J` itself. -/
private theorem ideal_smul_top_eq_self_submodule (J : Ideal B) :
    ((J • (⊤ : Submodule B B)) : Submodule B B) = (J : Submodule B B) := by
  -- Normalize `J • ⊤` to the image of `J` under the identity algebra map on `B`.
  ext x
  constructor
  · intro hx
    rw [Ideal.smul_top_eq_map] at hx
    simpa using hx
  · intro hx
    rw [Ideal.smul_top_eq_map]
    simpa using hx

/-- Helper for Lemma 15.31.4: inside the regular `B`-module, the submodule `J • ⊤` is exactly
`J` itself for the ideal generated by the source finite family. -/
private theorem source_ideal_smul_top_eq_self_submodule (f : Fin r → B) :
    (((Ideal.span (Set.range f)) • (⊤ : Submodule B B)) : Submodule B B) =
      (Ideal.span (Set.range f) : Submodule B B) := by
  -- This is the general ring-module identity specialized to `Ideal.span (Set.range f)`.
  simpa using
    ideal_smul_top_eq_self_submodule (B := B) (Ideal.span (Set.range f))

/-- Helper for Lemma 15.31.4: for the regular `B`-module, the quotient by an ideal agrees over
the quotient ring with the module quotient by `J • ⊤`. -/
private noncomputable abbrev ideal_quotient_equiv_module_quotient_over_quotient
    (J : Ideal B) :
    (B ⧸ J) ≃ₗ[B ⧸ J] (B ⧸ ((J • (⊤ : Submodule B B)) : Submodule B B)) := by
  let eB : (B ⧸ J) ≃ₗ[B] (B ⧸ ((J • (⊤ : Submodule B B)) : Submodule B B)) :=
    -- First rewrite the quotienting submodule from `J • ⊤` back to `J`, then use the identity on
    -- quotient representatives.
    (Submodule.quotEquivOfEq
      (((J • (⊤ : Submodule B B)) : Submodule B B))
      (J : Submodule B B)
      (ideal_smul_top_eq_self_submodule (B := B) (J := J))).symm
  -- The same underlying quotient map is already `B ⧸ J`-linear on quotient representatives.
  refine
    { toFun := eB
      invFun := eB.symm
      left_inv := eB.left_inv
      right_inv := eB.right_inv
      map_add' := eB.map_add
      map_smul' := ?_ }
  intro c x
  -- Evaluate both scalar and module elements on representatives of the quotient ring.
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective c
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- Helper for Lemma 15.31.4: over the quotient ring `B ⧸ J`, the source ideal quotient is the
same module as the quotient by `J • ⊤` used by `hqr.linearEquiv`. -/
private noncomputable abbrev source_ideal_quotient_equiv_module_quotient_over_quotient
    (f : Fin r → B) :
    (B ⧸ Ideal.span (Set.range f)) ≃ₗ[B ⧸ Ideal.span (Set.range f)]
      (B ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule B B))) :=
  -- Specialize the general quotient/model bridge to the ideal generated by the finite family.
  ideal_quotient_equiv_module_quotient_over_quotient (B := B) (Ideal.span (Set.range f))

/-- Helper for Lemma 15.31.4: viewed over `A`, the quotient ring `B ⧸ J` agrees with the module
quotient `B ⧸ (J • ⊤)` used by `hqr.linearEquiv`. -/
private noncomputable abbrev source_ideal_quotient_equiv_module_quotient (f : Fin r → B) :
    (B ⧸ Ideal.span (Set.range f)) ≃ₗ[A]
      (B ⧸ ((Ideal.span (Set.range f)) • (⊤ : Submodule B B))) :=
  -- Route correction: first keep the native `B ⧸ J`-linearity, then forget only at the end to
  -- the base ring `A`.
  (source_ideal_quotient_equiv_module_quotient_over_quotient (B := B) (f := f)).restrictScalars A

/-- Helper for Lemma 15.31.4: the quotient-model bridge sends an ideal-quotient generator to the
corresponding module-quotient generator. -/
private theorem source_ideal_quotient_equiv_module_quotient_over_quotient_mk
    (f : Fin r → B) (x : B) :
    source_ideal_quotient_equiv_module_quotient_over_quotient (B := B) f
        ((Ideal.Quotient.mk (Ideal.span (Set.range f))) x) =
      (((Ideal.span (Set.range f)) • (⊤ : Submodule B B)) : Submodule B B).mkQ x := by
  -- The stronger bridge is definitionally the identity on quotient representatives.
  rfl

/-- Helper for Lemma 15.31.4: after forgetting to `A`, the quotient-model bridge still sends an
ideal-quotient generator to the corresponding module-quotient generator. -/
private theorem source_ideal_quotient_equiv_module_quotient_mk
    (f : Fin r → B) (x : B) :
    source_ideal_quotient_equiv_module_quotient (A := A) f
        ((Ideal.Quotient.mk (Ideal.span (Set.range f))) x) =
      (((Ideal.span (Set.range f)) • (⊤ : Submodule B B)) : Submodule B B).mkQ x := by
  -- The restricted-scalars bridge has the same underlying function as the quotient-ring-linear
  -- bridge above, so the generator computation is unchanged.
  simpa using
    source_ideal_quotient_equiv_module_quotient_over_quotient_mk (B := B) (f := f) x

/-- Helper for Lemma 15.31.4: over the owner ideal `Ideal.ofList (List.ofFn f)`, the source of
`hqr.linearEquiv` collapses to the plain polynomial ring after normalizing the left tensor factor
to the quotient ring and then applying the tensor left-unit equivalence. -/
private noncomputable def quasi_regular_owner_source_to_plain_tensor (f : Fin r → B) :
    ((B ⧸ ((Ideal.ofList (List.ofFn f)) • (⊤ : Submodule B B))) ⊗[B ⧸ Ideal.ofList (List.ofFn f)]
      MvPolynomial (Fin r) (B ⧸ Ideal.ofList (List.ofFn f))) ≃ₗ[B ⧸ Ideal.ofList (List.ofFn f)]
      MvPolynomial (Fin r) (B ⧸ Ideal.ofList (List.ofFn f)) :=
  -- First replace the owner-side quotient model by the quotient ring `B ⧸ Ideal.ofList _`,
  -- then collapse the remaining tensor product with `TensorProduct.lid`.
  (TensorProduct.congr
      (ideal_quotient_equiv_module_quotient_over_quotient
        (B := B) (Ideal.ofList (List.ofFn f))).symm
      (LinearEquiv.refl
        (B ⧸ Ideal.ofList (List.ofFn f))
        (MvPolynomial (Fin r) (B ⧸ Ideal.ofList (List.ofFn f))))).trans
    (TensorProduct.lid
      (B ⧸ Ideal.ofList (List.ofFn f))
      (MvPolynomial (Fin r) (B ⧸ Ideal.ofList (List.ofFn f))))

/-- Helper for Lemma 15.31.4: the owner index set `Fin (List.ofFn f).length` normalizes back to
the source index set `Fin r`. -/
private theorem list_ofFn_length_eq (f : Fin r → B) :
    (List.ofFn f).length = r := by
  simp

/-- Helper for Lemma 15.31.4: first normalize `hqr.linearEquiv` over the owner ideal
`Ideal.ofList (List.ofFn f)`, and then forget scalars back to `A` since only `A`-flatness is used
downstream. -/
private noncomputable def quasi_regular_linearEquiv_ofList_quotient
    (f : Fin r → B) (hqr : IsQuasiRegularSequence (List.ofFn f)) :
    MvPolynomial (Fin r) (B ⧸ Ideal.ofList (List.ofFn f)) ≃
      idealAssociatedGradedModule (Ideal.ofList (List.ofFn f)) B := by
  let J : Ideal B := Ideal.ofList (List.ofFn f)
  let eRenameQ :
      MvPolynomial (Fin r) (B ⧸ J) ≃ₗ[B ⧸ J]
        MvPolynomial (Fin (List.ofFn f).length) (B ⧸ J) :=
    (MvPolynomial.renameEquiv (B ⧸ J) (finCongr (list_ofFn_length_eq f).symm)).toLinearEquiv
  let eTensorReindexQ :
      ((B ⧸ (((J • (⊤ : Submodule B B)) : Submodule B B))) ⊗[B ⧸ J]
          MvPolynomial (Fin r) (B ⧸ J)) ≃ₗ[B ⧸ J]
        ((B ⧸ (((J • (⊤ : Submodule B B)) : Submodule B B))) ⊗[B ⧸ J]
          MvPolynomial (Fin (List.ofFn f).length) (B ⧸ J)) :=
    TensorProduct.congr
      (LinearEquiv.refl (B ⧸ J) (B ⧸ (((J • (⊤ : Submodule B B)) : Submodule B B))))
      eRenameQ
  have hOwner :
      ((B ⧸ (((J • (⊤ : Submodule B B)) : Submodule B B))) ⊗[B ⧸ J]
          MvPolynomial (Fin (List.ofFn f).length) (B ⧸ J)) ≃
        idealAssociatedGradedModule J B := by
    -- Proof comment: after forgetting the ambient scalar action, `hqr.linearEquiv` already has
    -- the desired source and target.
    simpa [J] using hqr.linearEquiv.toEquiv
  -- Proof comment: first collapse the owner tensor source to the plain polynomial ring on `Fin r`,
  -- then reindex to the owner source `Fin (List.ofFn f).length`.
  exact
    ((quasi_regular_owner_source_to_plain_tensor (B := B) f).symm.toEquiv).trans <|
      eTensorReindexQ.toEquiv.trans hOwner

/-- Helper for Lemma 15.31.4: rewrite the owner ideal `Ideal.ofList (List.ofFn f)` to the
source-facing ideal `Ideal.span (Set.range f)` in the `A`-linear normalization above. -/
private noncomputable def quasi_regular_linearEquiv_over_quotient
    (f : Fin r → B) (hqr : IsQuasiRegularSequence (List.ofFn f)) :
    MvPolynomial (Fin r) (B ⧸ Ideal.span (Set.range f)) ≃
      idealAssociatedGradedModule (Ideal.span (Set.range f)) B := by
  -- TODO for Lemma 15.31.4: transport the `A`-linear equivalence above across the equality
  -- `Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f)` without triggering dependent
  -- elimination on quotient and associated-graded module types.
  sorry

/-- Helper for Lemma 15.31.4: after restricting scalars along `A → B ⧸ J`, the `A`-action on the
polynomial ring agrees with the quotient-ring action. -/
private theorem mvPolynomial_smul_via_quotient (J : Ideal B) (a : A)
    (x : MvPolynomial (Fin r) (B ⧸ J)) :
    a • x = (algebraMap A (B ⧸ J) a) • x := by
  -- This is the defining restricted-scalars action through the coefficient-ring quotient.
  simp [Algebra.smul_def]

/-- Helper for Lemma 15.31.4: quasi-regularity makes the whole associated graded module flat over
the base ring once `B ⧸ J` is flat over `A`. -/
private theorem associated_graded_module_flat_of_quasi_regular (f : Fin r → B)
    [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (hqr : IsQuasiRegularSequence (List.ofFn f)) :
    Module.Flat A (idealAssociatedGradedModule (Ideal.span (Set.range f)) B) := by
