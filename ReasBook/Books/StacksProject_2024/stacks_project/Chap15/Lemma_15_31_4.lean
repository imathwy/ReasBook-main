  sorry

/-- Helper for Lemma 15.31.4: the `n`th direct-sum projection is a left inverse to the
corresponding inclusion on the associated graded module. -/
private theorem graded_piece_component_lof_apply (J : Ideal B) (n : ℕ)
    (x : idealAssociatedGradedPiece J B n) :
    DirectSum.component (R := A) (ι := ℕ)
        (fun i ↦ idealAssociatedGradedPiece J B i) n
        (DirectSum.lof A ℕ (idealAssociatedGradedPiece J B) n x) =
      x := by
  -- This is the defining diagonal formula for `DirectSum.component` on the matching summand.
  simp

/-- Helper for Lemma 15.31.4: each degree piece of the associated graded module is flat over `A`
because it is a retract of the whole flat associated graded module. -/
private theorem graded_piece_flat_of_quasi_regular (f : Fin r → B)
