  -- `DirectSum.component`.
  sorry

/-- Helper for Lemma 15.31.4: tensoring the quotient by a power of the source ideal identifies
with the quotient by the corresponding power of the base-changed ideal. -/
private noncomputable def tensor_quotient_pow_map_equiv_of_span_range (f : Fin r → B) (n : ℕ) :
    A' ⊗[A] (B ⧸ (Ideal.span (Set.range f)) ^ n) ≃ₗ[A']
      B' ⧸ (Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B')))) ^ n :=
  -- First identify tensoring with the quotient by the mapped ideal, then rewrite that ideal to
  -- the one generated by the base-changed sequence.
  let eRewrite :
      (B' ⧸ Ideal.map (includeRight : B →ₐ[A] B') ((Ideal.span (Set.range f)) ^ n)) ≃ₗ[A']
        (B' ⧸ (Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n)) :=
    quotEquivOfEq_linearOver_baseChange (A := A) (B := B) (A' := A')
      (map_span_range_pow_eq_baseChange_span_range_pow
        (A := A) (B := B) (A' := A') f n)
  ((Algebra.TensorProduct.tensorQuotientEquiv
      (R := A) (S := A') (T := B) (A := A')
      ((Ideal.span (Set.range f)) ^ n)).toLinearEquiv).trans eRewrite

/-- Helper for Lemma 15.31.4: the tensor/quotient comparison sends the quotient generator coming
from `includeRight x` back to the pure tensor `1 ⊗ x`. -/
private theorem tensor_quotient_pow_map_equiv_of_span_range_symm_mk
    (f : Fin r → B) (n : ℕ) (x : B) :
    (tensor_quotient_pow_map_equiv_of_span_range (A := A) (B := B) (A' := A') f n).symm
        ((Ideal.Quotient.mk
          ((Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n)))
          (includeRight x : B')) =
      (1 : A') ⊗ₜ[A] (Ideal.Quotient.mk ((Ideal.span (Set.range f)) ^ n) x) := by
  -- Unfold the composed equivalence and evaluate each inverse factor on the displayed
  -- representative.
  let hpow :=
    map_span_range_pow_eq_baseChange_span_range_pow
      (A := A) (B := B) (A' := A') f n
  let eRewrite :
      (B' ⧸ Ideal.map (includeRight : B →ₐ[A] B') ((Ideal.span (Set.range f)) ^ n)) ≃ₗ[A']
        (B' ⧸ (Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n)) :=
    quotEquivOfEq_linearOver_baseChange (A := A) (B := B) (A' := A') hpow
  let eTensor :=
    (Algebra.TensorProduct.tensorQuotientEquiv
      (R := A) (S := A') (T := B) (A := A')
      ((Ideal.span (Set.range f)) ^ n)).toLinearEquiv
  change
    eTensor.symm
        (eRewrite.symm
          ((Ideal.Quotient.mk
            ((Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n)))
            (includeRight x : B'))) =
      (1 : A') ⊗ₜ[A] (Ideal.Quotient.mk ((Ideal.span (Set.range f)) ^ n) x)
  rw [quotEquivOfEq_linearOver_baseChange_symm_mk (A := A) (B := B) (A' := A') hpow]
  refine eTensor.symm_apply_eq.2 ?_
  rfl

/-- Helper for Lemma 15.31.4: the tensor/quotient comparison sends a pure tensor with quotient
representative to the corresponding quotient class in the base-changed ring. -/
private theorem tensor_quotient_pow_map_equiv_of_span_range_tmul_mk
    (f : Fin r → B) (n : ℕ) (a : A') (x : B) :
    tensor_quotient_pow_map_equiv_of_span_range (A := A) (B := B) (A' := A') f n
        (a ⊗ₜ[A] (Ideal.Quotient.mk ((Ideal.span (Set.range f)) ^ n) x)) =
      (Ideal.Quotient.mk
        ((Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n)))
        (a ⊗ₜ[A] x) := by
  -- Evaluate the base tensor/quotient equivalence on pure tensors and then rewrite the target
  -- ideal along the span-range equality.
  -- Split the composed equivalence into the tensor/quotient identification and the quotient
  -- transport along the equality of ideal powers.
  let hpow :=
    map_span_range_pow_eq_baseChange_span_range_pow
      (A := A) (B := B) (A' := A') f n
  let eRewrite :
      (B' ⧸ Ideal.map (includeRight : B →ₐ[A] B') ((Ideal.span (Set.range f)) ^ n)) ≃ₗ[A']
        (B' ⧸ (Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n)) :=
    quotEquivOfEq_linearOver_baseChange (A := A) (B := B) (A' := A') hpow
  let eTensor :=
    (Algebra.TensorProduct.tensorQuotientEquiv
      (R := A) (S := A') (T := B) (A := A')
      ((Ideal.span (Set.range f)) ^ n)).toLinearEquiv
  -- Both factors have explicit formulas on pure tensors.
  change eRewrite (eTensor (a ⊗ₜ[A] (Ideal.Quotient.mk ((Ideal.span (Set.range f)) ^ n) x))) = _
  rw [show eTensor (a ⊗ₜ[A] (Ideal.Quotient.mk ((Ideal.span (Set.range f)) ^ n) x)) =
      (Ideal.Quotient.mk
        (Ideal.map (includeRight : B →ₐ[A] B') ((Ideal.span (Set.range f)) ^ n)))
        (a ⊗ₜ[A] x) by rfl]
  exact
    quotEquivOfEq_linearOver_baseChange_mk (A := A) (B := B) (A' := A') hpow (a ⊗ₜ[A] x)

/-- Helper for Lemma 15.31.4: the quotient transition
`B ⧸ J^(n + 1) → B ⧸ J^n` is viewed as an `A`-linear map by restriction of scalars. -/
private noncomputable abbrev factorPowLinearMap (J : Ideal B) (n : ℕ) :
    (B ⧸ J ^ (n + 1)) →ₗ[A] (B ⧸ J ^ n) :=
  -- View the owner quotient transition as an `A`-linear map by using the quotient `A`-algebra
  -- structures on both source and target.
  { toFun := Ideal.Quotient.factorPowSucc J n
    map_add' := by
      intro x y
      simpa using (Ideal.Quotient.factorPowSucc J n).map_add x y
    map_smul' := by
      intro a x
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
      rfl }

/-- Helper for Lemma 15.31.4: the quotient transition sends the class of a representative modulo
`J^(n + 1)` to the same representative modulo `J^n`. -/
private theorem factorPowLinearMap_mk (J : Ideal B) (n : ℕ) (x : B) :
    factorPowLinearMap (A := A) (B := B) J n ((Ideal.Quotient.mk (J ^ (n + 1))) x) =
      (Ideal.Quotient.mk (J ^ n)) x := by
  -- The owner quotient transition keeps the same representative when passing to the lower power.
  rfl

/-- Helper for Lemma 15.31.4: after tensor base change, the quotient transition still acts on a
pure tensor by applying the source quotient map in the right tensor factor. -/
private theorem factorPowLinearMap_baseChange_tmul_mk
    (J : Ideal B) (n : ℕ) (a : A') (x : B) :
    ((factorPowLinearMap (A := A) (B := B) J n).baseChange A')
        (a ⊗ₜ[A] (Ideal.Quotient.mk (J ^ (n + 1)) x)) =
      a ⊗ₜ[A] (Ideal.Quotient.mk (J ^ n) x) := by
  -- Base change acts on pure tensors by applying the source linear map in the right tensor factor.
  rw [LinearMap.baseChange_tmul]
  rw [factorPowLinearMap_mk]

/-- Helper for Lemma 15.31.4: a surjective `A`-linear map remains surjective after tensor base
change to `A'`. -/
private theorem baseChange_surjective_of_surjective
    {M N : Type u} [AddCommMonoid M] [AddCommMonoid N] [Module A M] [Module A N]
    (g : M →ₗ[A] N) (hg : Function.Surjective g) :
    Function.Surjective (LinearMap.baseChange A' g) := by
  -- Tensor induction reduces surjectivity to pure tensors, where a source preimage suffices.
  intro z
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · exact ⟨0, by simp⟩
  · intro a y
    rcases hg y with ⟨x, rfl⟩
    refine ⟨a ⊗ₜ[A] x, ?_⟩
    simp [LinearMap.baseChange_tmul]
  · intro x y hx hy
    rcases hx with ⟨x', rfl⟩
    rcases hy with ⟨y', rfl⟩
    refine ⟨x' + y', by simp⟩

/-- Helper for Lemma 15.31.4: the quotient transition stays surjective after tensor base change. -/
private theorem factorPowLinearMap_baseChange_surjective
    (J : Ideal B) (n : ℕ) :
    Function.Surjective
      ((factorPowLinearMap (A := A) (B := B) J n).baseChange A') := by
  -- Apply the generic surjectivity-under-base-change lemma to the quotient transition map.
  refine
    baseChange_surjective_of_surjective (A := A) (A' := A')
      (factorPowLinearMap (A := A) (B := B) J n) ?_
  intro y
  rcases Ideal.Quotient.mk_surjective y with ⟨x, rfl⟩
  exact ⟨Ideal.Quotient.mk (J ^ (n + 1)) x, factorPowLinearMap_mk (A := A) (B := B) J n x⟩

/-- Helper for Lemma 15.31.4: the tensor/quotient comparison conjugates the source quotient
transition `B ⧸ J^(n + 1) → B ⧸ J^n` with the corresponding target transition after base change. -/
private theorem tensor_factorPow_conj_of_span_range
    (f : Fin r → B) (n : ℕ) :
    (tensor_quotient_pow_map_equiv_of_span_range (A := A) (B := B) (A' := A') f n).toLinearMap ∘ₗ
        (factorPowLinearMap (A := A) (B := B) (Ideal.span (Set.range f)) n).baseChange A' =
      factorPowLinearMap (A := A') (B := B')
          (Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B')))) n ∘ₗ
        (tensor_quotient_pow_map_equiv_of_span_range (A := A) (B := B) (A' := A') f (n + 1)).toLinearMap := by
  -- Compare both composites on pure tensors, then close by tensor induction.
  refine LinearMap.ext fun z ↦ ?_
  refine TensorProduct.induction_on z ?_ ?_ ?_
  · -- Both composites are linear, so they agree on the zero tensor.
    simp only [map_zero]
  · intro a y
    -- Choose a quotient representative and evaluate the two composites explicitly.
    rcases Ideal.Quotient.mk_surjective y with ⟨x, rfl⟩
    simp only [LinearMap.comp_apply]
    calc
      tensor_quotient_pow_map_equiv_of_span_range (A := A) (B := B) (A' := A') f n
          (((factorPowLinearMap (A := A) (B := B) (Ideal.span (Set.range f)) n).baseChange A')
            (a ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span (Set.range f) ^ (n + 1)) x))) =
        tensor_quotient_pow_map_equiv_of_span_range (A := A) (B := B) (A' := A') f n
          (a ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span (Set.range f) ^ n) x)) := by
            rw [factorPowLinearMap_baseChange_tmul_mk]
      _ =
        (Ideal.Quotient.mk
          ((Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ n)))
          (a ⊗ₜ[A] x) := by
            simpa using
              (tensor_quotient_pow_map_equiv_of_span_range_tmul_mk
                (A := A) (B := B) (A' := A') f n a x)
      _ =
        factorPowLinearMap (A := A') (B := B')
          (Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B')))) n
          ((Ideal.Quotient.mk
            ((Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ (n + 1))))
            (a ⊗ₜ[A] x)) := by
              rw [factorPowLinearMap_mk]
      _ =
        factorPowLinearMap (A := A') (B := B')
          (Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B')))) n
          (tensor_quotient_pow_map_equiv_of_span_range (A := A) (B := B) (A' := A') f (n + 1)
            (a ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span (Set.range f) ^ (n + 1)) x))) := by
              rw [show
                tensor_quotient_pow_map_equiv_of_span_range (A := A) (B := B) (A' := A') f (n + 1)
                    (a ⊗ₜ[A] (Ideal.Quotient.mk (Ideal.span (Set.range f) ^ (n + 1)) x)) =
                  (Ideal.Quotient.mk
                    ((Ideal.span (Set.range (fun i ↦ (includeRight (f i) : B'))) ^ (n + 1))))
                    (a ⊗ₜ[A] x) by
                  simpa using
                    (tensor_quotient_pow_map_equiv_of_span_range_tmul_mk
                      (A := A) (B := B) (A' := A') f (n + 1) a x)]
  · intro x y hx hy
    -- The pure-tensor formula is additive in the tensor argument, so the result follows.
    simp only [LinearMap.comp_apply, map_add, hx, hy]

/-- Helper for Lemma 15.31.4: every quotient transition `B ⧸ J^(n + 1) → B ⧸ J^n` is surjective,
since quotient classes always have lifts by representatives in `B`. -/
private theorem factorPowLinearMap_surjective (J : Ideal B) (n : ℕ) :
    Function.Surjective (factorPowLinearMap (A := A) (B := B) J n) := by
  -- Every quotient class in `B ⧸ J^n` is represented by some element of `B`, which also lifts to
  -- a class modulo `J^(n + 1)`.
  intro y
  rcases Ideal.Quotient.mk_surjective y with ⟨x, rfl⟩
  exact ⟨Ideal.Quotient.mk (J ^ (n + 1)) x, factorPowLinearMap_mk (A := A) (B := B) J n x⟩

/-- Helper for Lemma 15.31.4: an element of `J^n` defines a kernel class in
`B ⧸ J^(n + 1)` because its image in `B ⧸ J^n` vanishes. -/
private theorem idealAssociatedGradedStage_mem_pow
    (J : Ideal B) (n : ℕ) (x : idealAssociatedGradedStage J B n) :
    ((x : idealAssociatedGradedStage J B n) : B) ∈ J ^ n := by
  -- Rewrite the filtration stage back to the ideal itself, since `B` is the regular module.
  have hx :
      ((x : idealAssociatedGradedStage J B n) : B) ∈
        (((J ^ n) • (⊤ : Submodule B B)) : Submodule B B) :=
    x.property
  rwa [ideal_smul_top_eq_self_submodule (B := B) (J := J ^ n)] at hx

/-- Helper for Lemma 15.31.4: a stage element maps to a kernel element in the quotient model,
because it already vanishes modulo `J^n`. -/
private theorem idealAssociatedGradedPiece_to_ker_factorPow_map_mem_ker
    (J : Ideal B) (n : ℕ) (x : idealAssociatedGradedStage J B n) :
    ((Ideal.Quotient.mkₐ A (J ^ (n + 1))).toLinearMap.comp
        ((((idealAssociatedGradedStage J B n).subtype :
            idealAssociatedGradedStage J B n →ₗ[B] B).restrictScalars A))) x ∈
      LinearMap.ker (factorPowLinearMap (A := A) (B := B) J n) := by
  -- The quotient transition keeps the same representative, and that representative already lies in
  -- `J^n`, so its class modulo `J^n` is zero.
  change
    factorPowLinearMap (A := A) (B := B) J n
        ((Ideal.Quotient.mk (J ^ (n + 1))) ((x : idealAssociatedGradedStage J B n) : B)) = 0
  rw [factorPowLinearMap_mk]
  exact Ideal.Quotient.eq_zero_iff_mem.2 <|
    idealAssociatedGradedStage_mem_pow (B := B) J n x

/-- Helper for Lemma 15.31.4: an element of `J^n` maps to the corresponding quotient class modulo
`J^(n + 1)`, viewed inside the kernel of the transition to `B ⧸ J^n`. -/
private noncomputable def idealAssociatedGradedPiece_to_ker_factorPow_map
    (J : Ideal B) (n : ℕ) :
    idealAssociatedGradedStage J B n →ₗ[A]
      LinearMap.ker (factorPowLinearMap (A := A) (B := B) J n) :=
  -- Restrict the quotient map `B → B ⧸ J^(n + 1)` to the stage `J^n`, then codomain-restrict it to
  -- the kernel identified in the source filtration proof.
  LinearMap.codRestrict
    (LinearMap.ker (factorPowLinearMap (A := A) (B := B) J n))
    (((Ideal.Quotient.mkₐ A (J ^ (n + 1))).toLinearMap).comp
      ((((idealAssociatedGradedStage J B n).subtype :
          idealAssociatedGradedStage J B n →ₗ[B] B).restrictScalars A)))
    (idealAssociatedGradedPiece_to_ker_factorPow_map_mem_ker (A := A) (B := B) J n)

/-- Helper for Lemma 15.31.4: the only classes in `J^n` mapping to zero in the kernel model are
those coming from `J^(n + 1)`. -/
private theorem idealAssociatedGradedPiece_to_ker_factorPow_map_ker
    (J : Ideal B) (n : ℕ) :
    LinearMap.ker
        (idealAssociatedGradedPiece_to_ker_factorPow_map (A := A) (B := B) J n) =
      ((idealAssociatedGradedStage J B (n + 1)).submoduleOf
        (idealAssociatedGradedStage J B n)).restrictScalars A := by
  -- Route correction: compute the kernel after removing the codomain restriction, then rewrite
  -- vanishing in the quotient as membership in the next power.
  rw [idealAssociatedGradedPiece_to_ker_factorPow_map, LinearMap.ker_codRestrict]
  ext x
  constructor
  · intro hx
    rw [LinearMap.mem_ker] at hx
    change (Ideal.Quotient.mk (J ^ (n + 1))) ((x : idealAssociatedGradedStage J B n) : B) = 0 at hx
    have hxpow : ((x : idealAssociatedGradedStage J B n) : B) ∈ J ^ (n + 1) :=
      Ideal.Quotient.eq_zero_iff_mem.1 hx
    simpa [idealAssociatedGradedStage,
      ideal_smul_top_eq_self_submodule (B := B) (J := J ^ (n + 1))] using hxpow
  · intro hx
    rw [LinearMap.mem_ker]
    change (Ideal.Quotient.mk (J ^ (n + 1))) ((x : idealAssociatedGradedStage J B n) : B) = 0
    have hxpow : ((x : idealAssociatedGradedStage J B n) : B) ∈ J ^ (n + 1) := by
      simpa [idealAssociatedGradedStage,
        ideal_smul_top_eq_self_submodule (B := B) (J := J ^ (n + 1))] using hx
    exact Ideal.Quotient.eq_zero_iff_mem.2 hxpow

/-- Helper for Lemma 15.31.4: every kernel class of the quotient transition has a representative
lying in `J^n`. -/
private theorem idealAssociatedGradedPiece_to_ker_factorPow_map_surjective
    (J : Ideal B) (n : ℕ) :
    Function.Surjective
      (idealAssociatedGradedPiece_to_ker_factorPow_map (A := A) (B := B) J n) := by
  intro y
  -- Choose a quotient representative and use the kernel condition to recover membership in `J^n`.
  obtain ⟨x, hxquot⟩ := Ideal.Quotient.mk_surjective y.1
  have hxker :
      factorPowLinearMap (A := A) (B := B) J n ((Ideal.Quotient.mk (J ^ (n + 1))) x) = 0 := by
    simpa [hxquot] using y.2
  have hxpow : x ∈ J ^ n := by
    rw [factorPowLinearMap_mk] at hxker
    exact Ideal.Quotient.eq_zero_iff_mem.1 hxker
  refine ⟨⟨x, ?_⟩, ?_⟩
  · -- The chosen representative lies in the `n`th filtration stage.
    simpa [idealAssociatedGradedStage,
      ideal_smul_top_eq_self_submodule (B := B) (J := J ^ n)] using hxpow
  · -- The restricted quotient map sends that stage representative back to the original kernel
    -- element.
    ext
    exact hxquot

/-- Helper for Lemma 15.31.4: the `n`th graded piece `J^n / J^(n + 1)` is canonically the kernel
of the transition `B ⧸ J^(n + 1) → B ⧸ J^n`. -/
private noncomputable def idealAssociatedGradedPiece_equiv_ker_factorPow
    (J : Ideal B) (n : ℕ) :
    idealAssociatedGradedPiece J B n ≃ₗ[A]
      LinearMap.ker (factorPowLinearMap (A := A) (B := B) J n) := by
  -- First identify the graded piece with the quotient by the map kernel.
  let eRange :
      idealAssociatedGradedPiece J B n ≃ₗ[A]
        LinearMap.range
          (idealAssociatedGradedPiece_to_ker_factorPow_map
            (A := A) (B := B) J n) :=
    (Submodule.quotEquivOfEq _ _
      (idealAssociatedGradedPiece_to_ker_factorPow_map_ker
        (A := A) (B := B) J n).symm).trans <|
      (idealAssociatedGradedPiece_to_ker_factorPow_map
        (A := A) (B := B) J n).quotKerEquivRange
  have hrange :
      LinearMap.range
          (idealAssociatedGradedPiece_to_ker_factorPow_map
            (A := A) (B := B) J n) =
        ⊤ := by
    rw [LinearMap.range_eq_top]
    exact idealAssociatedGradedPiece_to_ker_factorPow_map_surjective
      (A := A) (B := B) J n
  -- Then collapse the full range submodule back to the kernel codomain.
  exact eRange.trans <| (LinearEquiv.ofEq _ _ hrange).trans Submodule.topEquiv

/-- Helper for Lemma 15.31.4: the graded piece `J^(n + 1) / J^(n + 2)` includes into
`B ⧸ J^(n + 2)` through its kernel model for the quotient transition to `B ⧸ J^(n + 1)`. -/
private noncomputable def factorPowKernelInclusion (J : Ideal B) (n : ℕ) :
    idealAssociatedGradedPiece J B (n + 1) →ₗ[A] (B ⧸ J ^ (n + 2)) :=
  -- First rewrite the graded piece as the kernel of the quotient transition, then forget the
  -- kernel subtype back into the ambient quotient.
  ((LinearMap.ker (factorPowLinearMap (A := A) (B := B) J (n + 1))).subtype).comp
    (idealAssociatedGradedPiece_equiv_ker_factorPow (A := A) (B := B) J (n + 1)).toLinearMap

/-- Helper for Lemma 15.31.4: each graded-piece element maps to zero under the next quotient
transition after including it into `B ⧸ J^(n + 2)`. -/
private theorem factorPowKernelInclusion_mem_ker
    (J : Ideal B) (n : ℕ) (x : idealAssociatedGradedPiece J B (n + 1)) :
    factorPowLinearMap (A := A) (B := B) J (n + 1)
        (factorPowKernelInclusion (A := A) (B := B) J n x) =
      0 := by
  -- The inclusion lands in the kernel model by definition.
  exact
    (idealAssociatedGradedPiece_equiv_ker_factorPow
      (A := A) (B := B) J (n + 1) x).2

/-- Helper for Lemma 15.31.4: the inclusion of the graded piece
`J^(n + 1) / J^(n + 2)` into `B ⧸ J^(n + 2)` has image exactly the kernel of the transition to
`B ⧸ J^(n + 1)`. -/
private theorem factorPowKernelInclusion_range_eq_ker
    (J : Ideal B) (n : ℕ) :
    LinearMap.range (factorPowKernelInclusion (A := A) (B := B) J n) =
      LinearMap.ker (factorPowLinearMap (A := A) (B := B) J (n + 1)) := by
  -- Route correction: identify the graded piece with the kernel first, then forget the kernel
  -- subtype back into the ambient quotient.
  ext y
  constructor
  · rintro ⟨x, rfl⟩
    exact LinearMap.mem_ker.2 <|
      factorPowKernelInclusion_mem_ker (A := A) (B := B) J n x
  · intro hy
    let yker :
        LinearMap.ker (factorPowLinearMap (A := A) (B := B) J (n + 1)) := ⟨y, hy⟩
    refine LinearMap.mem_range.2 ⟨
      (idealAssociatedGradedPiece_equiv_ker_factorPow
        (A := A) (B := B) J (n + 1)).symm yker,
      ?_⟩
    change
      (((idealAssociatedGradedPiece_equiv_ker_factorPow
        (A := A) (B := B) J (n + 1))
          ((idealAssociatedGradedPiece_equiv_ker_factorPow
            (A := A) (B := B) J (n + 1)).symm yker) : LinearMap.ker _) : B ⧸ J ^ (n + 2)) = y
    exact congrArg Subtype.val <|
      (idealAssociatedGradedPiece_equiv_ker_factorPow
        (A := A) (B := B) J (n + 1)).apply_symm_apply yker

/-- Helper for Lemma 15.31.4: the inclusion of `J^(n + 1) / J^(n + 2)` into `B ⧸ J^(n + 2)`
followed by the transition to `B ⧸ J^(n + 1)` is zero. -/
private theorem factorPowShortComplex_comp_zero
    (J : Ideal B) (n : ℕ) :
    (ModuleCat.ofHom (factorPowKernelInclusion (A := A) (B := B) J n)) ≫
        (ModuleCat.ofHom (factorPowLinearMap (A := A) (B := B) J (n + 1))) =
      0 := by
  -- The inclusion lands in the kernel model of the quotient transition by construction.
  apply ModuleCat.hom_ext
  exact LinearMap.ext fun x ↦ factorPowKernelInclusion_mem_ker (A := A) (B := B) J n x

/-- Helper for Lemma 15.31.4: the owner short complex for the quotient row
`0 → J^(n + 1) / J^(n + 2) → B / J^(n + 2) → B / J^(n + 1) → 0`. -/
private abbrev factorPowShortComplex
    (J : Ideal B) (n : ℕ) : CategoryTheory.ShortComplex (ModuleCat A) :=
  CategoryTheory.ShortComplex.mk
    (ModuleCat.ofHom (factorPowKernelInclusion (A := A) (B := B) J n))
    (ModuleCat.ofHom (factorPowLinearMap (A := A) (B := B) J (n + 1)))
    (factorPowShortComplex_comp_zero (A := A) (B := B) J n)

/-- Helper for Lemma 15.31.4: the canonical quotient row
`0 → J^(n + 1) / J^(n + 2) → B / J^(n + 2) → B / J^(n + 1) → 0` is short exact. -/
private theorem factorPow_shortExact_row
    (J : Ideal B) (n : ℕ) :
    (factorPowShortComplex (A := A) (B := B) J n).ShortExact := by
  -- The kernel model identifies exactness, and the outer maps are mono/epi by construction.
  refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
  · rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact, LinearMap.exact_iff]
    exact (factorPowKernelInclusion_range_eq_ker (A := A) (B := B) J n).symm
  · refine (ModuleCat.mono_iff_injective _).2 ?_
    intro x y hxy
    apply (idealAssociatedGradedPiece_equiv_ker_factorPow
      (A := A) (B := B) J (n + 1)).injective
    apply Subtype.ext
    simpa [factorPowKernelInclusion] using hxy
  · exact (ModuleCat.epi_iff_surjective _).2 <|
      factorPowLinearMap_surjective (A := A) (B := B) J (n + 1)

/-- Helper for Lemma 15.31.4: once the graded pieces are flat, the successive quotients
`B ⧸ J^(n + 1)` are flat by induction on `n` using the canonical kernel short exact sequence of
`B ⧸ J^(n + 2) → B ⧸ J^(n + 1)`. -/
private theorem quotient_pow_flat_of_quasi_regular (f : Fin r → B)
    [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (hqr : IsQuasiRegularSequence (List.ofFn f)) (n : ℕ) :
    Module.Flat A (B ⧸ (Ideal.span (Set.range f)) ^ (n + 1)) := by
  -- Induct on the filtration level using the canonical short exact row
  -- `0 → J^(n + 1) / J^(n + 2) → B / J^(n + 2) → B / J^(n + 1) → 0`.
  let J : Ideal B := Ideal.span (Set.range f)
  induction n with
  | zero =>
      have hpow : (Ideal.span (Set.range f)) ^ (0 + 1) = Ideal.span (Set.range f) := by
        simp
      rw [hpow]
      infer_instance
  | succ n ih =>
      let S := factorPowShortComplex (A := A) (B := B) J n
      have hS : S.ShortExact :=
        factorPow_shortExact_row (A := A) (B := B) J n
      have hflatLeft : Module.Flat A (idealAssociatedGradedPiece J B (n + 1)) :=
        graded_piece_flat_of_quasi_regular (A := A) (B := B) f hqr (n + 1)
      let _ : Module.Flat A S.X₁ := by
        simpa [S, factorPowShortComplex] using hflatLeft
      let _ : Module.Flat A S.X₃ := by
        simpa [S, factorPowShortComplex, J] using ih
      simpa [S, factorPowShortComplex, J] using
        (CategoryTheory.ShortComplex.ShortExact.flat_X₂ (S := S) hS)

/-- Helper for Lemma 15.31.4: tensoring the canonical quotient row by `A'` stays short exact,
because the cokernel `B ⧸ J^(n + 1)` is flat over `A`. -/
private theorem factorPow_baseChange_shortExact_row_of_span_range
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (hqr : IsQuasiRegularSequence (List.ofFn f)) (n : ℕ) :
    ((factorPowShortComplex (A := A) (B := B) (Ideal.span (Set.range f)) n).map
      (MonoidalCategory.tensorLeft (ModuleCat.of A A'))).ShortExact := by
  -- Keep the source proof route: first tensor the already-proved short exact filtration row.
  let J : Ideal B := Ideal.span (Set.range f)
  let S := factorPowShortComplex (A := A) (B := B) J n
  have hS : S.ShortExact := factorPow_shortExact_row (A := A) (B := B) J n
  let _ : Module.Flat A S.X₃ := by
    simpa [S, factorPowShortComplex, J] using
      quotient_pow_flat_of_quasi_regular (A := A) (B := B) f hqr n
  simpa [S, factorPowShortComplex, J] using
    (CategoryTheory.ShortComplex.ShortExact.tensorLeft_of_flat_cokernel
      (S := S) hS (ModuleCat.of A A'))

/-- Helper for Lemma 15.31.4: after tensor base change, the image of the graded-piece inclusion
is exactly the kernel of the next quotient transition. -/
private theorem factorPowKernelInclusion_baseChange_range_eq_ker_of_span_range
    (f : Fin r → B) [Module.Flat A (B ⧸ Ideal.span (Set.range f))]
    (hqr : IsQuasiRegularSequence (List.ofFn f)) (n : ℕ) :
    LinearMap.range
        ((LinearMap.baseChange A'
          (factorPowKernelInclusion (A := A) (B := B) (Ideal.span (Set.range f)) n)).restrictScalars A) =
      LinearMap.ker
        ((LinearMap.baseChange A'
          (factorPowLinearMap (A := A) (B := B) (Ideal.span (Set.range f)) (n + 1))).restrictScalars A) := by
  -- Tensor the short exact quotient row and read exactness back off on the concrete base-change
  -- linear maps.
  let J : Ideal B := Ideal.span (Set.range f)
  let S := factorPowShortComplex (A := A) (B := B) J n
  have hTensor :
      (S.map (MonoidalCategory.tensorLeft (ModuleCat.of A A'))).ShortExact := by
    simpa [S, factorPowShortComplex, J] using
      factorPow_baseChange_shortExact_row_of_span_range (A := A) (B := B) (A' := A') f hqr n
  have hExact :
      Function.Exact
        ((LinearMap.baseChange A' (factorPowKernelInclusion (A := A) (B := B) J n)).restrictScalars A)
        ((LinearMap.baseChange A' (factorPowLinearMap (A := A) (B := B) J (n + 1))).restrictScalars A) := by
    -- The tensor-left functor acts on `ModuleCat` morphisms by `LinearMap.baseChange`.
    simpa [S, factorPowShortComplex, J, LinearMap.baseChange_eq_ltensor] using
      (CategoryTheory.ShortComplex.ShortExact.moduleCat_exact_iff_function_exact
        (S.map (MonoidalCategory.tensorLeft (ModuleCat.of A A')))).mp hTensor.exact
  -- Exactness is the desired `range = ker` identity.
  simpa [J] using (LinearMap.exact_iff.mp hExact).symm

