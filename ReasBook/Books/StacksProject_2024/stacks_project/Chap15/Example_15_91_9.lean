/-- Helper for Example 15.91.9: the class of `X^N` survives in `k[X] / (X^(N+1))`. -/
theorem secondBeauvilleLaszloCounterexample_X_pow_stage_ne_zero (N : ℕ) :
    Ideal.Quotient.mk
        (principalPowerIdeal ((@Polynomial.X k Field.toCommRing) : Polynomial k) (N + 1))
        (((@Polynomial.X k Field.toCommRing) : Polynomial k) ^ N) ≠ 0 := by
  intro hzero
  -- Rewrite vanishing in the quotient as divisibility by `X^(N+1)`.
  have hmem :
      (((@Polynomial.X k Field.toCommRing) : Polynomial k) ^ N : Polynomial k) ∈
        principalPowerIdeal ((@Polynomial.X k Field.toCommRing) : Polynomial k) (N + 1) :=
    Ideal.Quotient.eq_zero_iff_mem.mp hzero
  rw [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow,
    Ideal.mem_span_singleton'] at hmem
  rcases hmem with ⟨q, hq⟩
  -- Compare the `N`-th coefficient on both sides of the divisibility identity.
  have hcoeff :=
    congrArg (fun p : Polynomial k ↦ p.coeff N) hq
  have hleft :
      (q * ((@Polynomial.X k Field.toCommRing) : Polynomial k) ^ (N + 1)).coeff N = 0 := by
    rw [Polynomial.coeff_mul_X_pow']
    split_ifs with h
    · exact (Nat.not_succ_le_self N h).elim
    · rfl
  have hright :
      (((( @Polynomial.X k Field.toCommRing) : Polynomial k) ^ N : Polynomial k).coeff N) = 1 := by
    simp
  have hzero_eq_one : (0 : k) = 1 := by
    calc
      (0 : k) = (q * ((@Polynomial.X k Field.toCommRing) : Polynomial k) ^ (N + 1)).coeff N := hleft.symm
      _ = (((( @Polynomial.X k Field.toCommRing) : Polynomial k) ^ N : Polynomial k).coeff N) := hcoeff
      _ = 1 := hright
  exact zero_ne_one hzero_eq_one

/-- In the second ring, the map `R[f^∞] → R^∧[f^∞]` is not surjective. -/
theorem secondBeauvilleLaszloCounterexample_fPowerTorsionToExtension_not_surjective
