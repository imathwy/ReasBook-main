section

variable (k : Type u) [CommRing k]

/-- The indeterminates `f, T₁, T₂, \ldots` used in the Beauville-Laszlo completion counterexamples.
-/
inductive BeauvilleLaszloCounterexampleVar
  | f
  | t (n : ℕ)
  deriving DecidableEq

/-- The polynomial variable `f` in the explicit Beauville-Laszlo counterexample rings. -/
abbrev beauvilleLaszloCounterexample_fVar :
    MvPolynomial BeauvilleLaszloCounterexampleVar k :=
  MvPolynomial.X .f

/-- The polynomial variable `T_(n+1)` in the explicit Beauville-Laszlo counterexample rings. -/
abbrev beauvilleLaszloCounterexample_tVar (n : ℕ) :
    MvPolynomial BeauvilleLaszloCounterexampleVar k :=
  MvPolynomial.X (.t n)

/-- The `n`-th defining relation of
`k[f, T₁, T₂, \ldots] / (fT₁, fT₂ - T₁, fT₃ - T₂, \ldots)`. -/
def firstBeauvilleLaszloCounterexampleRelation :
    ℕ → MvPolynomial BeauvilleLaszloCounterexampleVar k
  | 0 =>
      beauvilleLaszloCounterexample_fVar k * beauvilleLaszloCounterexample_tVar k 0
  | n + 1 =>
      beauvilleLaszloCounterexample_fVar k * beauvilleLaszloCounterexample_tVar k (n + 1) -
        beauvilleLaszloCounterexample_tVar k n

/-- The ideal generated by the relations
`fT₁, fT₂ - T₁, fT₃ - T₂, \ldots`. -/
def firstBeauvilleLaszloCounterexampleIdeal :
    Ideal (MvPolynomial BeauvilleLaszloCounterexampleVar k) :=
  Ideal.span (Set.range (firstBeauvilleLaszloCounterexampleRelation k))

/-- The ring
`k[f, T₁, T₂, \ldots] / (fT₁, fT₂ - T₁, fT₃ - T₂, \ldots)`. -/
abbrev firstBeauvilleLaszloCounterexampleRing :=
  MvPolynomial BeauvilleLaszloCounterexampleVar k ⧸ firstBeauvilleLaszloCounterexampleIdeal k

/-- The distinguished element `f` in the first Beauville-Laszlo counterexample ring. -/
abbrev firstBeauvilleLaszloCounterexample_f :
    firstBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_fVar k)

/-- The class of `T₁` in the first Beauville-Laszlo counterexample ring. -/
abbrev firstBeauvilleLaszloCounterexample_t1 :
    firstBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_tVar k 0)

/-- The `n`-th defining relation of
`k[f, T₁, T₂, \ldots] / (fT₁, f^2 T₂, f^3 T₃, \ldots)`. -/
def secondBeauvilleLaszloCounterexampleRelation :
    ℕ → MvPolynomial BeauvilleLaszloCounterexampleVar k
  | n =>
      beauvilleLaszloCounterexample_fVar k ^ (n + 1) *
        beauvilleLaszloCounterexample_tVar k n

/-- The ideal generated by the relations `fT₁, f^2 T₂, f^3 T₃, \ldots`. -/
def secondBeauvilleLaszloCounterexampleIdeal :
    Ideal (MvPolynomial BeauvilleLaszloCounterexampleVar k) :=
  Ideal.span (Set.range (secondBeauvilleLaszloCounterexampleRelation k))

/-- The ring `k[f, T₁, T₂, \ldots] / (fT₁, f^2 T₂, f^3 T₃, \ldots)`. -/
abbrev secondBeauvilleLaszloCounterexampleRing :=
  MvPolynomial BeauvilleLaszloCounterexampleVar k ⧸ secondBeauvilleLaszloCounterexampleIdeal k

/-- The distinguished element `f` in the second Beauville-Laszlo counterexample ring. -/
abbrev secondBeauvilleLaszloCounterexample_f :
    secondBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_fVar k)

/-- The class of `T₁` in the second Beauville-Laszlo counterexample ring. -/
abbrev secondBeauvilleLaszloCounterexample_t1 :
    secondBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_tVar k 0)

section

variable [Field k]

/-- Helper for Example 15.91.9: the class of `T_(n+1)` in the first counterexample quotient. -/
abbrev firstBeauvilleLaszloCounterexample_t (n : ℕ) :
    firstBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_tVar k n)

/-- Helper for Example 15.91.9: the defining relation `f T₁ = 0` in the first counterexample
quotient. -/
theorem firstBeauvilleLaszloCounterexample_t_zero_annihilated :
    firstBeauvilleLaszloCounterexample_f k * firstBeauvilleLaszloCounterexample_t k 0 = 0 := by
  -- The first generator of the defining ideal is exactly the relation `fT₁`.
  have hrel :
      Ideal.Quotient.mk (firstBeauvilleLaszloCounterexampleIdeal k)
        (firstBeauvilleLaszloCounterexampleRelation k 0) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr <|
      Ideal.subset_span (Set.mem_range_self 0)
  simpa [firstBeauvilleLaszloCounterexampleRelation, firstBeauvilleLaszloCounterexample_f,
    firstBeauvilleLaszloCounterexample_t] using hrel

/-- Helper for Example 15.91.9: the recursive relation `f T_(n+2) = T_(n+1)` in the first
counterexample quotient. -/
theorem firstBeauvilleLaszloCounterexample_t_recursion (n : ℕ) :
    firstBeauvilleLaszloCounterexample_f k * firstBeauvilleLaszloCounterexample_t k (n + 1) =
      firstBeauvilleLaszloCounterexample_t k n := by
  -- Each higher defining relation is one of the ideal generators.
  have hrel :
      Ideal.Quotient.mk (firstBeauvilleLaszloCounterexampleIdeal k)
        (firstBeauvilleLaszloCounterexampleRelation k (n + 1)) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr <|
      Ideal.subset_span (Set.mem_range_self (n + 1))
  simpa [firstBeauvilleLaszloCounterexampleRelation, firstBeauvilleLaszloCounterexample_f,
    firstBeauvilleLaszloCounterexample_t, sub_eq_iff_eq_add] using hrel

/-- Helper for Example 15.91.9: `T_(n+1) f^n = T₁` in the first counterexample quotient. -/
theorem firstBeauvilleLaszloCounterexample_t_mul_pow_eq_t1 (n : ℕ) :
    firstBeauvilleLaszloCounterexample_t k n *
        firstBeauvilleLaszloCounterexample_f k ^ n =
      firstBeauvilleLaszloCounterexample_t1 k := by
  induction n with
  | zero =>
      -- At stage `0` there is no power of `f` to remove.
      simp [firstBeauvilleLaszloCounterexample_t, firstBeauvilleLaszloCounterexample_t1]
  | succ n ih =>
      -- Rewrite one factor of `f` using the recursive relation, then invoke the induction
      -- hypothesis on the shorter tail.
      calc
        firstBeauvilleLaszloCounterexample_t k (n + 1) *
            firstBeauvilleLaszloCounterexample_f k ^ (n + 1)
          = (firstBeauvilleLaszloCounterexample_f k *
                firstBeauvilleLaszloCounterexample_t k (n + 1)) *
              firstBeauvilleLaszloCounterexample_f k ^ n := by
              simp [pow_succ, mul_assoc, mul_comm, mul_left_comm]
        _ = firstBeauvilleLaszloCounterexample_t k n *
              firstBeauvilleLaszloCounterexample_f k ^ n := by
              rw [firstBeauvilleLaszloCounterexample_t_recursion]
        _ = firstBeauvilleLaszloCounterexample_t1 k := ih

/-- Helper for Example 15.91.9: `T₁` lies in every power `(f^n)` in the first counterexample
quotient. -/
theorem firstBeauvilleLaszloCounterexample_t1_mem_principalPowerIdeal (n : ℕ) :
    firstBeauvilleLaszloCounterexample_t1 k ∈
      principalPowerIdeal (firstBeauvilleLaszloCounterexample_f k) n := by
  -- The explicit formula `T₁ = T_(n+1) f^n` puts `T₁` in the principal ideal generated by `f^n`.
  rw [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
  refine ⟨firstBeauvilleLaszloCounterexample_t k n, ?_⟩
  simpa [mul_comm] using firstBeauvilleLaszloCounterexample_t_mul_pow_eq_t1 (k := k) n

/-- Helper for Example 15.91.9: the completion image of `T₁` vanishes because every stage quotient
kills it. -/
theorem firstBeauvilleLaszloCounterexample_t1_completion_image_zero :
    algebraMap
        (firstBeauvilleLaszloCounterexampleRing k)
        (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k))
        (firstBeauvilleLaszloCounterexample_t1 k) =
      0 := by
  -- Extensionality on the completion reduces the claim to the finite quotient stages.
  let _ :
      Module
        (firstBeauvilleLaszloCounterexampleRing k)
        (firstBeauvilleLaszloCounterexampleRing k) :=
    Semiring.toModule
  apply AdicCompletion.ext_evalₐ
  intro n
  -- Compute the left stage by `evalₐ_of`, kill the middle quotient class, and compute the zero
  -- stage in the same way.
  calc
    (AdicCompletion.evalₐ (principalIdeal (firstBeauvilleLaszloCounterexample_f k)) n)
        ((algebraMap
            (firstBeauvilleLaszloCounterexampleRing k)
            (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k)))
          (firstBeauvilleLaszloCounterexample_t1 k))
      =
        Ideal.Quotient.mk
          (principalPowerIdeal (firstBeauvilleLaszloCounterexample_f k) n)
          (firstBeauvilleLaszloCounterexample_t1 k) := by
            simpa [principalAdicCompletion] using
              (AdicCompletion.evalₐ_of
                (I := principalIdeal (firstBeauvilleLaszloCounterexample_f k))
                n
                (firstBeauvilleLaszloCounterexample_t1 k))
    _ = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr <|
        firstBeauvilleLaszloCounterexample_t1_mem_principalPowerIdeal (k := k) n
    _ =
        (AdicCompletion.evalₐ (principalIdeal (firstBeauvilleLaszloCounterexample_f k)) n) 0 := by
          symm
          simpa [principalAdicCompletion] using
            (AdicCompletion.evalₐ_of
              (I := principalIdeal (firstBeauvilleLaszloCounterexample_f k))
              n
              (0 : firstBeauvilleLaszloCounterexampleRing k))

/-- Helper for Example 15.91.9: an element killed by `f` lies in the `f^∞`-torsion submodule. -/
theorem fPowerTorsion_mem_of_mul_eq_zero
    {R : Type u} [CommRing R] (f x : R) (hfx : f * x = 0) :
    x ∈ (R[f^∞] : Submodule R R) := by
  -- The single power `f` already witnesses that `x` is killed by a power of `f`.
  rw [Submodule.mem_torsion'_iff]
  have hf_mem : f ∈ Submonoid.powers f := by
    refine ⟨1, ?_⟩
    simp
  refine ⟨⟨f, hf_mem⟩, ?_⟩
  simpa [smul_eq_mul] using hfx

/-- Helper for Example 15.91.9: an element of an `R`-module killed by `f` already lies in the
`f^∞`-torsion submodule. -/
theorem fPowerTorsion_mem_of_smul_eq_zero
    {R M : Type u} [CommRing R] [AddCommGroup M] [Module R M] (f : R) (x : M)
    (hfx : f • x = 0) :
    x ∈ (M[f^∞] : Submodule R M) := by
  -- The first power `f¹` already annihilates `x`, so it serves as the torsion witness.
  rw [Submodule.mem_torsion'_iff]
  have hf_mem : f ∈ Submonoid.powers f := by
    refine ⟨1, ?_⟩
    simp
  refine ⟨⟨f, hf_mem⟩, ?_⟩
  simpa using hfx

/-- Helper for Example 15.91.9: the source-faithful Laurent quotient `k[f, f⁻¹] / k[f]` used for
the first counterexample. -/
abbrev firstBeauvilleLaszloCounterexampleLaurentRange :
    Submodule (Polynomial k) (LaurentPolynomial k) :=
  LinearMap.range (Algebra.linearMap (Polynomial k) (LaurentPolynomial k))

/-- Helper for Example 15.91.9: the source-faithful Laurent quotient `k[f, f⁻¹] / k[f]` used for
the first counterexample. -/
abbrev firstBeauvilleLaszloCounterexampleLaurentQuotient :=
  LaurentPolynomial k ⧸
    firstBeauvilleLaszloCounterexampleLaurentRange k

/-- Helper for Example 15.91.9: the Laurent exponent `-(n + 1)` indexing the reverse `f`-chain. -/
abbrev firstBeauvilleLaszloCounterexample_negExponent (n : ℕ) : ℤ :=
  -((n : ℤ) + 1)

/-- Helper for Example 15.91.9: the class of `f^{-(n + 1)}` in the Laurent quotient model. -/
abbrev firstBeauvilleLaszloCounterexample_laurentClass (n : ℕ) :
    firstBeauvilleLaszloCounterexampleLaurentQuotient k :=
  Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k)
    (LaurentPolynomial.T (firstBeauvilleLaszloCounterexample_negExponent n))

/-- Helper for Example 15.91.9: multiplying the exponent `-(n + 2)` by `f` shifts the reverse
chain one step toward `-(n + 1)`. -/
theorem firstBeauvilleLaszloCounterexample_negExponent_succ (n : ℕ) :
    (1 : ℤ) + firstBeauvilleLaszloCounterexample_negExponent (n + 1) =
      firstBeauvilleLaszloCounterexample_negExponent n := by
  -- This is the integer identity behind the source's reverse-`f` recursion.
  unfold firstBeauvilleLaszloCounterexample_negExponent
  omega

/-- Helper for Example 15.91.9: `f⁻¹` is not in the polynomial image inside Laurent polynomials,
as truncation kills the negative term. -/
theorem firstBeauvilleLaszloCounterexample_T_neg_one_not_mem_laurentRange :
    LaurentPolynomial.T (-1 : ℤ) ∉ firstBeauvilleLaszloCounterexampleLaurentRange k := by
  intro hmem
  rcases LinearMap.mem_range.mp hmem with ⟨p, hp⟩
  have hp_to :
      Polynomial.toLaurent p = (LaurentPolynomial.T (-1 : ℤ) : LaurentPolynomial k) := by
    -- The range witness is exactly a polynomial Laurent image.
    simpa using hp
  have hp_zero : p = 0 := by
    -- Truncation is a left inverse to `toLaurent`, but it kills `T (-1)`.
    have htrunc :
        LaurentPolynomial.trunc (Polynomial.toLaurent p : LaurentPolynomial k) =
          LaurentPolynomial.trunc (LaurentPolynomial.T (-1 : ℤ) : LaurentPolynomial k) :=
      congrArg LaurentPolynomial.trunc hp_to
    have hT_trunc_zero :
        LaurentPolynomial.trunc (LaurentPolynomial.T (-1 : ℤ) : LaurentPolynomial k) = 0 := by
      simpa using (LaurentPolynomial.trunc_C_mul_T (R := k) (-1 : ℤ) (1 : k))
    calc
      p = LaurentPolynomial.trunc (Polynomial.toLaurent p : LaurentPolynomial k) := by
        simpa using (Polynomial.trunc_toLaurent (R := k) p).symm
      _ = LaurentPolynomial.trunc (LaurentPolynomial.T (-1 : ℤ) : LaurentPolynomial k) := htrunc
      _ = 0 := hT_trunc_zero
  have hT_zero : (LaurentPolynomial.T (-1 : ℤ) : LaurentPolynomial k) = 0 := by
    -- Substituting the forced vanishing polynomial would force the Laurent unit `T (-1)` to vanish.
    simpa [hp_zero] using hp_to.symm
  have hT_ne_zero : (LaurentPolynomial.T (-1 : ℤ) : LaurentPolynomial k) ≠ 0 :=
    (LaurentPolynomial.isUnit_T (R := k) (-1 : ℤ)).ne_zero
  exact hT_ne_zero hT_zero

/-- Helper for Example 15.91.9: the class of `f⁻¹` stays nonzero in `k[f, f⁻¹] / k[f]` because a
polynomial Laurent support never contains a negative exponent. -/
theorem firstBeauvilleLaszloCounterexample_laurentClass_zero_ne_zero :
    firstBeauvilleLaszloCounterexample_laurentClass k 0 ≠ 0 := by
  intro hzero
  -- Zero in the quotient means the Laurent monomial already lies in the polynomial range.
  have hmem :
      (LaurentPolynomial.T (firstBeauvilleLaszloCounterexample_negExponent 0) :
        LaurentPolynomial k) ∈ firstBeauvilleLaszloCounterexampleLaurentRange k := by
    rw [firstBeauvilleLaszloCounterexample_laurentClass, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero] at hzero
    simpa using hzero
  -- Route correction: use the direct truncation obstruction instead of a bespoke coefficient API.
  simpa [firstBeauvilleLaszloCounterexample_negExponent] using
    firstBeauvilleLaszloCounterexample_T_neg_one_not_mem_laurentRange (k := k) hmem

/-- Helper for Example 15.91.9: in the Laurent quotient model, multiplying `[f⁻¹]` by `f`
produces the polynomial class `[1]`, hence vanishes. -/
theorem firstBeauvilleLaszloCounterexample_laurentClass_X_smul_zero :
    (Polynomial.X : Polynomial k) • firstBeauvilleLaszloCounterexample_laurentClass k 0 = 0 := by
  have hone_mem :
      (1 : LaurentPolynomial k) ∈ firstBeauvilleLaszloCounterexampleLaurentRange k := by
    -- The constant Laurent polynomial `1` already comes from the polynomial ring.
    refine LinearMap.mem_range.mpr ?_
    refine ⟨(1 : Polynomial k), ?_⟩
    simp [firstBeauvilleLaszloCounterexampleLaurentRange]
  -- Rewrite the scalar action under the quotient map, then identify the resulting Laurent
  -- monomial with `1`.
  calc
    (Polynomial.X : Polynomial k) • firstBeauvilleLaszloCounterexample_laurentClass k 0
      =
        Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k)
          ((Polynomial.X : Polynomial k) •
            LaurentPolynomial.T (firstBeauvilleLaszloCounterexample_negExponent 0)) := by
            rw [firstBeauvilleLaszloCounterexample_laurentClass, Submodule.mkQ_apply,
              Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul]
    _ =
        Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k)
          ((algebraMap (Polynomial k) (LaurentPolynomial k)) Polynomial.X *
            LaurentPolynomial.T (firstBeauvilleLaszloCounterexample_negExponent 0)) := by
            rw [Submodule.mkQ_apply, Submodule.mkQ_apply]
            rw [Algebra.smul_def]
    _ =
        Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k)
          (LaurentPolynomial.T
            ((1 : ℤ) + firstBeauvilleLaszloCounterexample_negExponent 0)) := by
            rw [LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_X,
              ← LaurentPolynomial.T_add]
    _ = Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k) (1 : LaurentPolynomial k) := by
      simp [firstBeauvilleLaszloCounterexample_negExponent]
    _ = 0 := by
      exact (Submodule.Quotient.mk_eq_zero _).2 hone_mem

/-- Helper for Example 15.91.9: in the Laurent quotient model, multiplying `[f^{-(n+2)}]` by `f`
shifts the reverse `f`-chain to `[f^{-(n+1)}]`. -/
theorem firstBeauvilleLaszloCounterexample_laurentClass_X_smul_succ (n : ℕ) :
    (Polynomial.X : Polynomial k) • firstBeauvilleLaszloCounterexample_laurentClass k (n + 1) =
      firstBeauvilleLaszloCounterexample_laurentClass k n := by
  -- Rewrite the quotient scalar action and collapse the Laurent monomial exponents.
  calc
    (Polynomial.X : Polynomial k) • firstBeauvilleLaszloCounterexample_laurentClass k (n + 1)
      =
        Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k)
          ((Polynomial.X : Polynomial k) •
            LaurentPolynomial.T (firstBeauvilleLaszloCounterexample_negExponent (n + 1))) := by
            rw [firstBeauvilleLaszloCounterexample_laurentClass, Submodule.mkQ_apply,
              Submodule.mkQ_apply, ← Submodule.Quotient.mk_smul]
    _ =
        Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k)
          ((algebraMap (Polynomial k) (LaurentPolynomial k)) Polynomial.X *
            LaurentPolynomial.T (firstBeauvilleLaszloCounterexample_negExponent (n + 1))) := by
            rw [Submodule.mkQ_apply, Submodule.mkQ_apply]
            rw [Algebra.smul_def]
    _ =
        Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k)
          (LaurentPolynomial.T
            ((1 : ℤ) + firstBeauvilleLaszloCounterexample_negExponent (n + 1))) := by
            rw [LaurentPolynomial.algebraMap_eq_toLaurent, Polynomial.toLaurent_X,
              ← LaurentPolynomial.T_add]
    _ =
        Submodule.mkQ (firstBeauvilleLaszloCounterexampleLaurentRange k)
          (LaurentPolynomial.T (firstBeauvilleLaszloCounterexample_negExponent n)) := by
            rw [firstBeauvilleLaszloCounterexample_negExponent_succ]
    _ = firstBeauvilleLaszloCounterexample_laurentClass k n := by
      rw [firstBeauvilleLaszloCounterexample_laurentClass]

/-- Helper for Example 15.91.9: the Laurent quotient inherits the opposite `k[f]`-module
structure from commutativity of `k[f]`, so it can serve as the square-zero part of the model. -/
instance firstBeauvilleLaszloCounterexample_laurentQuotientModuleOpposite :
    Module (Polynomial k)ᵐᵒᵖ (firstBeauvilleLaszloCounterexampleLaurentQuotient k) :=
  Module.compHom _ ((RingHom.id (Polynomial k)).fromOpposite mul_comm)

/-- Helper for Example 15.91.9: the opposite and left `k[f]`-actions agree on the Laurent
quotient because the polynomial ring is commutative. -/
instance firstBeauvilleLaszloCounterexample_laurentQuotientIsCentralScalar :
    IsCentralScalar (Polynomial k) (firstBeauvilleLaszloCounterexampleLaurentQuotient k) where
  op_smul_eq_smul r x := by
    refine Quotient.inductionOn' x ?_
    intro y
    rfl

/-- Helper for Example 15.91.9: raw evaluation from the polynomial presentation to the
square-zero Laurent model. -/
def firstBeauvilleLaszloCounterexample_square_zero_eval :
    MvPolynomial BeauvilleLaszloCounterexampleVar k →+*
      TrivSqZeroExt (Polynomial k) (firstBeauvilleLaszloCounterexampleLaurentQuotient k) :=
  MvPolynomial.eval₂Hom
    ((TrivSqZeroExt.inlHom
        (Polynomial k)
        (firstBeauvilleLaszloCounterexampleLaurentQuotient k)).comp
      (algebraMap k (Polynomial k)))
    (fun
      | .f => TrivSqZeroExt.inl Polynomial.X
      | .t n => TrivSqZeroExt.inr (firstBeauvilleLaszloCounterexample_laurentClass k n))

/-- Helper for Example 15.91.9: evaluating `f T_(n+1)` in the square-zero Laurent model rewrites
to the scalar action of `X` on the reverse Laurent class. -/
theorem firstBeauvilleLaszloCounterexample_square_zero_eval_mul_t (n : ℕ) :
    firstBeauvilleLaszloCounterexample_square_zero_eval k
      ((@beauvilleLaszloCounterexample_fVar k Field.toCommRing) *
        (@beauvilleLaszloCounterexample_tVar k Field.toCommRing n)) =
        TrivSqZeroExt.inr
          ((Polynomial.X : Polynomial k) •
            firstBeauvilleLaszloCounterexample_laurentClass k n) := by
  -- Evaluate the two generators separately, then use the square-zero multiplication formula
  -- `inl r * inr m = inr (r • m)`.
  simpa [firstBeauvilleLaszloCounterexample_square_zero_eval,
    beauvilleLaszloCounterexample_fVar, beauvilleLaszloCounterexample_tVar] using
    (TrivSqZeroExt.inl_mul_inr
      (R := Polynomial k)
      (M := firstBeauvilleLaszloCounterexampleLaurentQuotient k)
      (Polynomial.X)
      (firstBeauvilleLaszloCounterexample_laurentClass k n))

/-- Helper for Example 15.91.9: each defining relation of the first quotient vanishes in the
square-zero Laurent model. -/
theorem firstBeauvilleLaszloCounterexample_square_zero_eval_relation_zero (n : ℕ) :
    firstBeauvilleLaszloCounterexample_square_zero_eval k
      (@firstBeauvilleLaszloCounterexampleRelation k Field.toCommRing n) = 0 := by
  cases n with
  | zero =>
      -- The first relation is `fT₁`, so the normalization lemma reduces the goal to
      -- `X • [f⁻¹] = 0` in the Laurent quotient.
      calc
        firstBeauvilleLaszloCounterexample_square_zero_eval k
            (@firstBeauvilleLaszloCounterexampleRelation k Field.toCommRing 0)
          =
            TrivSqZeroExt.inr
              ((Polynomial.X : Polynomial k) •
                firstBeauvilleLaszloCounterexample_laurentClass k 0) := by
                  change
                    firstBeauvilleLaszloCounterexample_square_zero_eval k
                      ((@beauvilleLaszloCounterexample_fVar k Field.toCommRing) *
                        (@beauvilleLaszloCounterexample_tVar k Field.toCommRing 0)) =
                      TrivSqZeroExt.inr
                        ((Polynomial.X : Polynomial k) •
                          firstBeauvilleLaszloCounterexample_laurentClass k 0)
                  exact firstBeauvilleLaszloCounterexample_square_zero_eval_mul_t (k := k) 0
        _ = 0 := by
          rw [firstBeauvilleLaszloCounterexample_laurentClass_X_smul_zero (k := k)]
          rfl
  | succ n =>
      -- The successor relation is `fT_(n+2) - T_(n+1)`, so after normalization the second
      -- component is exactly the reverse-chain identity `X • [f^-(n+2)] = [f^-(n+1)]`.
      have ht :
          firstBeauvilleLaszloCounterexample_square_zero_eval k
              (@beauvilleLaszloCounterexample_tVar k Field.toCommRing n) =
            TrivSqZeroExt.inr (firstBeauvilleLaszloCounterexample_laurentClass k n) := by
        simp [firstBeauvilleLaszloCounterexample_square_zero_eval,
          beauvilleLaszloCounterexample_tVar]
      calc
        firstBeauvilleLaszloCounterexample_square_zero_eval k
            (@firstBeauvilleLaszloCounterexampleRelation k Field.toCommRing (n + 1))
          =
            firstBeauvilleLaszloCounterexample_square_zero_eval k
              ((@beauvilleLaszloCounterexample_fVar k Field.toCommRing) *
                  (@beauvilleLaszloCounterexample_tVar k Field.toCommRing (n + 1))) -
              firstBeauvilleLaszloCounterexample_square_zero_eval k
                (@beauvilleLaszloCounterexample_tVar k Field.toCommRing n) := by
                  rw [firstBeauvilleLaszloCounterexampleRelation]
                  exact map_sub
                    (firstBeauvilleLaszloCounterexample_square_zero_eval k)
                    ((@beauvilleLaszloCounterexample_fVar k Field.toCommRing) *
                      (@beauvilleLaszloCounterexample_tVar k Field.toCommRing (n + 1)))
                    (@beauvilleLaszloCounterexample_tVar k Field.toCommRing n)
        _ =
            TrivSqZeroExt.inr
              ((Polynomial.X : Polynomial k) •
                firstBeauvilleLaszloCounterexample_laurentClass k (n + 1)) -
            TrivSqZeroExt.inr (firstBeauvilleLaszloCounterexample_laurentClass k n) := by
              rw [firstBeauvilleLaszloCounterexample_square_zero_eval_mul_t, ht]
        _ = 0 := by
          apply TrivSqZeroExt.ext
          · simp
          · change
              (Polynomial.X : Polynomial k) •
                  firstBeauvilleLaszloCounterexample_laurentClass k (n + 1) -
                firstBeauvilleLaszloCounterexample_laurentClass k n =
              0
            rw [firstBeauvilleLaszloCounterexample_laurentClass_X_smul_succ (k := k) n]
            simp

/-- Helper for Example 15.91.9: the defining ideal of the first quotient lies in the kernel of
the square-zero Laurent evaluation map. -/
theorem firstBeauvilleLaszloCounterexample_square_zero_eval_ideal_le_ker :
    @firstBeauvilleLaszloCounterexampleIdeal k Field.toCommRing ≤
      RingHom.ker (firstBeauvilleLaszloCounterexample_square_zero_eval k) := by
  -- Each defining generator already vanishes under the raw square-zero evaluation, so the whole
  -- span lies in the kernel.
  rw [firstBeauvilleLaszloCounterexampleIdeal, Ideal.span_le]
  intro p hp
  rcases hp with ⟨n, rfl⟩
  exact RingHom.mem_ker.mpr <|
    firstBeauvilleLaszloCounterexample_square_zero_eval_relation_zero (k := k) n

/-- Helper for Example 15.91.9: the source-faithful square-zero Laurent model sends `T₁` to the
nonzero Laurent class `[f⁻¹]`. -/
theorem firstBeauvilleLaszloCounterexample_t1_nonzero_in_square_zero_model :
    ∃ φ :
      (@firstBeauvilleLaszloCounterexampleRing k Field.toCommRing) →+*
        TrivSqZeroExt (Polynomial k) (firstBeauvilleLaszloCounterexampleLaurentQuotient k),
      φ (@firstBeauvilleLaszloCounterexample_t1 k Field.toCommRing) =
        TrivSqZeroExt.inr (firstBeauvilleLaszloCounterexample_laurentClass k 0) := by
  -- Route correction: the new raw map `firstBeauvilleLaszloCounterexample_square_zero_eval`
  -- isolates the source evaluation step.  Descend it through the quotient by showing the defining
  -- ideal lies in the kernel, then read off the image of `T₁`.
  let φ :
      (@firstBeauvilleLaszloCounterexampleRing k Field.toCommRing) →+*
        TrivSqZeroExt (Polynomial k) (firstBeauvilleLaszloCounterexampleLaurentQuotient k) :=
    Ideal.Quotient.lift
      (@firstBeauvilleLaszloCounterexampleIdeal k Field.toCommRing)
      (firstBeauvilleLaszloCounterexample_square_zero_eval k)
      (fun x hx ↦ RingHom.mem_ker.mp <|
        firstBeauvilleLaszloCounterexample_square_zero_eval_ideal_le_ker (k := k) hx)
  refine ⟨φ, ?_⟩
  -- Unwinding the quotient lift shows that `T₁` lands in the square-zero summand as `[f⁻¹]`.
  calc
    φ (@firstBeauvilleLaszloCounterexample_t1 k Field.toCommRing)
        = firstBeauvilleLaszloCounterexample_square_zero_eval k
            (@beauvilleLaszloCounterexample_tVar k Field.toCommRing 0) := by
              simp [φ, firstBeauvilleLaszloCounterexample_t1]
    _ = TrivSqZeroExt.inr (firstBeauvilleLaszloCounterexample_laurentClass k 0) := by
      simp [firstBeauvilleLaszloCounterexample_square_zero_eval,
        beauvilleLaszloCounterexample_tVar]

/-- Helper for Example 15.91.9: in the explicit field-based ring instance, the class of `T₁`
remains nonzero by the descended square-zero Laurent model. -/
theorem firstBeauvilleLaszloCounterexample_t1_ne_zero_field_model :
    (@firstBeauvilleLaszloCounterexample_t1 k Field.toCommRing) ≠ 0 := by
  -- Use the descended square-zero Laurent model and project to the Laurent quotient summand.
  rcases firstBeauvilleLaszloCounterexample_t1_nonzero_in_square_zero_model (k := k) with
    ⟨φ, hφ⟩
  intro ht1
  have hinr_zero :
      TrivSqZeroExt.inr (firstBeauvilleLaszloCounterexample_laurentClass k 0) =
        (0 :
          TrivSqZeroExt (Polynomial k) (firstBeauvilleLaszloCounterexampleLaurentQuotient k)) := by
    -- Apply the descended quotient map to the hypothetical relation `T₁ = 0`.
    calc
      TrivSqZeroExt.inr (firstBeauvilleLaszloCounterexample_laurentClass k 0)
        = φ (@firstBeauvilleLaszloCounterexample_t1 k Field.toCommRing) := by
            simpa using hφ.symm
      _ = φ 0 := congrArg φ ht1
      _ = 0 := by simp
  have hclass_zero :
      firstBeauvilleLaszloCounterexample_laurentClass k 0 = 0 := by
    -- The second projection of the square-zero extension records exactly the Laurent quotient
    -- component.
    simpa using congrArg TrivSqZeroExt.snd hinr_zero
  exact firstBeauvilleLaszloCounterexample_laurentClass_zero_ne_zero (k := k) hclass_zero

/-- Helper for Example 15.91.9: the class of `T₁` is nonzero in the first counterexample quotient.

The intended proof is the textbook model argument using a square-zero extension over `k[f]` with
an infinite reverse `f`-chain. -/
theorem firstBeauvilleLaszloCounterexample_t1_ne_zero :
    firstBeauvilleLaszloCounterexample_t1 k ≠ 0 := by
  -- TODO: the target still quantifies over the ambient outer `[CommRing k]`, while the completed
  -- square-zero Laurent model proves nonvanishing only for the `Field.toCommRing` surface.
  -- This needs a statement-surface repair rather than another transport lemma search.
  sorry

/-- In the first ring, the map `R[f^∞] → R^∧[f^∞]` is not injective. -/
theorem firstBeauvilleLaszloCounterexample_fPowerTorsionToExtension_not_injective
    :
    ¬ Function.Injective
      (fPowerTorsionToExtension
        (algebraMap
          (firstBeauvilleLaszloCounterexampleRing k)
          (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k)))
        (firstBeauvilleLaszloCounterexample_f k)) := by
  let _ :
      Module
        (firstBeauvilleLaszloCounterexampleRing k)
        (firstBeauvilleLaszloCounterexampleRing k) :=
    Semiring.toModule
  let _ :
      Algebra
        (firstBeauvilleLaszloCounterexampleRing k)
        (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k)) :=
    (algebraMap
      (firstBeauvilleLaszloCounterexampleRing k)
      (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k))).toAlgebra
  let _ :
      DistribMulAction
        ↥(Submonoid.powers (firstBeauvilleLaszloCounterexample_f k))
        (firstBeauvilleLaszloCounterexampleRing k) :=
    { smul := fun a x ↦ (a : firstBeauvilleLaszloCounterexampleRing k) * x
      one_smul := by
        intro x
        change (1 : firstBeauvilleLaszloCounterexampleRing k) * x = x
        simp
      mul_smul := by
        intro a b x
        change ((a : firstBeauvilleLaszloCounterexampleRing k) *
            (b : firstBeauvilleLaszloCounterexampleRing k)) * x =
          (a : firstBeauvilleLaszloCounterexampleRing k) *
            ((b : firstBeauvilleLaszloCounterexampleRing k) * x)
        simp [mul_assoc]
      smul_zero := by
        intro a
        change (a : firstBeauvilleLaszloCounterexampleRing k) * 0 = 0
        simp
      smul_add := by
        intro a x y
        change (a : firstBeauvilleLaszloCounterexampleRing k) * (x + y) =
          (a : firstBeauvilleLaszloCounterexampleRing k) * x +
            (a : firstBeauvilleLaszloCounterexampleRing k) * y
        simp [left_distrib] }
  let _ :
      SMulCommClass
        ↥(Submonoid.powers (firstBeauvilleLaszloCounterexample_f k))
        (firstBeauvilleLaszloCounterexampleRing k)
        (firstBeauvilleLaszloCounterexampleRing k) :=
    { smul_comm := by
        intro a r x
        change (a : firstBeauvilleLaszloCounterexampleRing k) * (r * x) =
          r * ((a : firstBeauvilleLaszloCounterexampleRing k) * x)
        simp [mul_assoc, mul_comm, mul_left_comm] }
  let _ :
      Module
        (firstBeauvilleLaszloCounterexampleRing k)
        (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k)) :=
    Algebra.toModule
  -- Package `T₁` as an explicit `f^∞`-torsion element using the relation `f * T₁ = 0`.
  let x :
      ((firstBeauvilleLaszloCounterexampleRing k)[(firstBeauvilleLaszloCounterexample_f k)^∞] :
        Submodule
          (firstBeauvilleLaszloCounterexampleRing k)
          (firstBeauvilleLaszloCounterexampleRing k)) :=
    ⟨firstBeauvilleLaszloCounterexample_t1 k,
      fPowerTorsion_mem_of_mul_eq_zero
        (firstBeauvilleLaszloCounterexample_f k)
        (firstBeauvilleLaszloCounterexample_t1 k)
        (firstBeauvilleLaszloCounterexample_t_zero_annihilated (k := k))⟩
  have hx_ne : x ≠ 0 := by
    -- Nonvanishing reduces to the underlying ring element `T₁`.
    have hx_val_ne :
        ((x :
            ((firstBeauvilleLaszloCounterexampleRing k)[(firstBeauvilleLaszloCounterexample_f k)^∞] :
              Submodule
                (firstBeauvilleLaszloCounterexampleRing k)
                (firstBeauvilleLaszloCounterexampleRing k))) :
          firstBeauvilleLaszloCounterexampleRing k) ≠ 0 := by
      simpa [x, fPowerTorsion_mem_of_mul_eq_zero] using
        firstBeauvilleLaszloCounterexample_t1_ne_zero (k := k)
    intro hx
    exact hx_val_ne <| congrArg
      (fun y :
          ((firstBeauvilleLaszloCounterexampleRing k)[(firstBeauvilleLaszloCounterexample_f k)^∞] :
            Submodule
              (firstBeauvilleLaszloCounterexampleRing k)
              (firstBeauvilleLaszloCounterexampleRing k)) ↦
          (y : firstBeauvilleLaszloCounterexampleRing k)) hx
  have hx_completion_zero :
      fPowerTorsionToExtension
          (algebraMap
            (firstBeauvilleLaszloCounterexampleRing k)
            (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k)))
          (firstBeauvilleLaszloCounterexample_f k) x =
        0 := by
    -- The comparison map is the restricted algebra map, so its value is the completion image of
    -- `T₁`.
    apply Subtype.ext
    change
      algebraMap
        (firstBeauvilleLaszloCounterexampleRing k)
        (principalAdicCompletion (firstBeauvilleLaszloCounterexample_f k))
        (firstBeauvilleLaszloCounterexample_t1 k) = 0
    exact firstBeauvilleLaszloCounterexample_t1_completion_image_zero (k := k)
  intro hinj
  exact hx_ne (hinj hx_completion_zero)

/-- Helper for Example 15.91.9: the class of `T_(n+1)` in the second counterexample quotient. -/
abbrev secondBeauvilleLaszloCounterexample_t (n : ℕ) :
    secondBeauvilleLaszloCounterexampleRing k :=
  Ideal.Quotient.mk _ (beauvilleLaszloCounterexample_tVar k n)

/-- Helper for Example 15.91.9: the second counterexample ring acts on itself by multiplication,
which is the module structure used by the adic completion API. -/
instance secondBeauvilleLaszloCounterexampleRing_selfModule :
    Module
      (secondBeauvilleLaszloCounterexampleRing k)
      (secondBeauvilleLaszloCounterexampleRing k) :=
  Semiring.toModule

/-- Helper for Example 15.91.9: the second counterexample ring also acts on itself by ordinary
multiplication, and we record this instance explicitly to keep the `SModEq` surface stable. -/
instance secondBeauvilleLaszloCounterexampleRing_selfMulAction :
    MulAction
      (secondBeauvilleLaszloCounterexampleRing k)
      (secondBeauvilleLaszloCounterexampleRing k) :=
  Monoid.toMulAction _

/-- Helper for Example 15.91.9: the defining relation `f^(n+1) T_(n+1) = 0` in the second
counterexample quotient. -/
theorem secondBeauvilleLaszloCounterexample_t_annihilated_pow (n : ℕ) :
    secondBeauvilleLaszloCounterexample_f k ^ (n + 1) *
      secondBeauvilleLaszloCounterexample_t k n = 0 := by
  -- Each displayed relation is one of the generators of the defining ideal.
  have hrel :
      Ideal.Quotient.mk (secondBeauvilleLaszloCounterexampleIdeal k)
        (secondBeauvilleLaszloCounterexampleRelation k n) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr <|
      Ideal.subset_span (Set.mem_range_self n)
  simpa [secondBeauvilleLaszloCounterexampleRelation, secondBeauvilleLaszloCounterexample_f,
    secondBeauvilleLaszloCounterexample_t] using hrel

/-- Helper for Example 15.91.9: the `n`-th truncation `T₁ + f T₂ + ⋯ + f^(n-1) T_n` in the
second counterexample quotient. -/
abbrev secondBeauvilleLaszloCounterexample_series (n : ℕ) :
    secondBeauvilleLaszloCounterexampleRing k :=
  Finset.sum (Finset.range n) fun i ↦
    secondBeauvilleLaszloCounterexample_f k ^ i *
      secondBeauvilleLaszloCounterexample_t k i

/-- Helper for Example 15.91.9: each tail term `f^i T_(i+1)` with `i ≥ m` already lies in the
ideal `(f^m)`. -/
theorem secondBeauvilleLaszloCounterexample_tail_term_mem_principalPowerIdeal
    {m i : ℕ} (hmi : m ≤ i) :
    secondBeauvilleLaszloCounterexample_f k ^ i *
        secondBeauvilleLaszloCounterexample_t k i ∈
      principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m := by
  -- Factor out `f^m` from the tail term using commutativity of the quotient ring.
  rw [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
  refine ⟨secondBeauvilleLaszloCounterexample_f k ^ (i - m) *
      secondBeauvilleLaszloCounterexample_t k i, ?_⟩
  calc
    (secondBeauvilleLaszloCounterexample_f k ^ (i - m) *
          secondBeauvilleLaszloCounterexample_t k i) *
        secondBeauvilleLaszloCounterexample_f k ^ m
      =
        secondBeauvilleLaszloCounterexample_f k ^ (i - m) *
          secondBeauvilleLaszloCounterexample_f k ^ m *
            secondBeauvilleLaszloCounterexample_t k i := by
              simp [mul_assoc, mul_comm, mul_left_comm]
    _ =
        secondBeauvilleLaszloCounterexample_f k ^ i *
          secondBeauvilleLaszloCounterexample_t k i := by
            rw [← pow_add, Nat.sub_add_cancel hmi]

/-- Helper for Example 15.91.9: the truncation classes are compatible modulo smaller powers of
`f`. -/
theorem secondBeauvilleLaszloCounterexample_series_stage_compatible
    (m n : ℕ) (hmn : m ≤ n) :
    Ideal.Quotient.mk
        (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
        (secondBeauvilleLaszloCounterexample_series k n) =
      Ideal.Quotient.mk
        (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
        (secondBeauvilleLaszloCounterexample_series k m) := by
  rcases Nat.exists_eq_add_of_le hmn with ⟨d, rfl⟩
  clear hmn
  induction d with
  | zero =>
      simp
  | succ d ih =>
      have hsucc :
          secondBeauvilleLaszloCounterexample_series k (m + d + 1) =
            secondBeauvilleLaszloCounterexample_series k (m + d) +
              secondBeauvilleLaszloCounterexample_f k ^ (m + d) *
                secondBeauvilleLaszloCounterexample_t k (m + d) := by
        rw [secondBeauvilleLaszloCounterexample_series,
          secondBeauvilleLaszloCounterexample_series, Finset.sum_range_succ]
      have htail :
          secondBeauvilleLaszloCounterexample_f k ^ (m + d) *
              secondBeauvilleLaszloCounterexample_t k (m + d) ∈
            principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m :=
        secondBeauvilleLaszloCounterexample_tail_term_mem_principalPowerIdeal (k := k)
          (Nat.le_add_right m d)
      have htail_zero :
          Ideal.Quotient.mk
              (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
              (secondBeauvilleLaszloCounterexample_f k ^ (m + d) *
                secondBeauvilleLaszloCounterexample_t k (m + d)) = 0 := by
        exact Ideal.Quotient.eq_zero_iff_mem.mpr htail
      -- Peel off the last summand and kill it in the stage quotient.
      calc
        Ideal.Quotient.mk
            (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
            (secondBeauvilleLaszloCounterexample_series k (m + d + 1))
          =
            Ideal.Quotient.mk
              (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
              (secondBeauvilleLaszloCounterexample_series k (m + d) +
                secondBeauvilleLaszloCounterexample_f k ^ (m + d) *
                  secondBeauvilleLaszloCounterexample_t k (m + d)) := by
              rw [hsucc]
        _ =
            Ideal.Quotient.mk
              (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
              (secondBeauvilleLaszloCounterexample_series k (m + d)) +
            Ideal.Quotient.mk
              (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
              (secondBeauvilleLaszloCounterexample_f k ^ (m + d) *
                secondBeauvilleLaszloCounterexample_t k (m + d)) := by
              simp
        _ =
            Ideal.Quotient.mk
              (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
              (secondBeauvilleLaszloCounterexample_series k (m + d)) := by
              rw [htail_zero, add_zero]
        _ =
            Ideal.Quotient.mk
              (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
              (secondBeauvilleLaszloCounterexample_series k m) := ih

/-- Helper for Example 15.91.9: the truncation family is compatible with the adic completion
transition maps. -/
theorem secondBeauvilleLaszloCounterexample_series_transition_compatible
    (m n : ℕ) (hmn : m ≤ n) :
    Ideal.Quotient.mk
        (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
        (secondBeauvilleLaszloCounterexample_series k n) =
      Ideal.Quotient.mk
        (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) m)
        (secondBeauvilleLaszloCounterexample_series k m) := by
  -- This is exactly the previously proved compatibility of the truncation classes modulo lower
  -- powers of `f`.
  exact secondBeauvilleLaszloCounterexample_series_stage_compatible (k := k) m n hmn

/-- Helper for Example 15.91.9: multiplying any truncation by `f` kills it termwise in the second
counterexample quotient. -/
theorem secondBeauvilleLaszloCounterexample_series_mul_f_eq_zero (n : ℕ) :
    secondBeauvilleLaszloCounterexample_f k *
      secondBeauvilleLaszloCounterexample_series k n = 0 := by
  induction n with
  | zero =>
      simp [secondBeauvilleLaszloCounterexample_series]
  | succ n ih =>
      have hsucc :
          secondBeauvilleLaszloCounterexample_series k (n + 1) =
            secondBeauvilleLaszloCounterexample_series k n +
              secondBeauvilleLaszloCounterexample_f k ^ n *
                secondBeauvilleLaszloCounterexample_t k n := by
        rw [secondBeauvilleLaszloCounterexample_series,
          secondBeauvilleLaszloCounterexample_series, Finset.sum_range_succ]
      -- Split off the last truncation term and use the defining annihilation relation on it.
      calc
        secondBeauvilleLaszloCounterexample_f k *
            secondBeauvilleLaszloCounterexample_series k (n + 1)
          =
            secondBeauvilleLaszloCounterexample_f k *
              secondBeauvilleLaszloCounterexample_series k n +
            secondBeauvilleLaszloCounterexample_f k *
              (secondBeauvilleLaszloCounterexample_f k ^ n *
                secondBeauvilleLaszloCounterexample_t k n) := by
              rw [hsucc, mul_add]
        _ =
            0 +
            secondBeauvilleLaszloCounterexample_f k ^ (n + 1) *
              secondBeauvilleLaszloCounterexample_t k n := by
              rw [ih]
              simp [pow_succ, mul_assoc, mul_left_comm, mul_comm]
        _ = 0 := by
          rw [secondBeauvilleLaszloCounterexample_t_annihilated_pow, zero_add]

/-- Helper for Example 15.91.9: consecutive truncations are congruent modulo the `n`-th power of
`f`, which is the exact successive compatibility needed for the adic completion API. -/
theorem secondBeauvilleLaszloCounterexample_series_successive_smodEq (n : ℕ) :
    secondBeauvilleLaszloCounterexample_series k n ≡
      secondBeauvilleLaszloCounterexample_series k (n + 1)
        [SMOD ((principalIdeal (secondBeauvilleLaszloCounterexample_f k)) ^ n • ⊤ :
          Submodule
            (secondBeauvilleLaszloCounterexampleRing k)
            (secondBeauvilleLaszloCounterexampleRing k))] := by
  -- Rewrite the successive congruence as ideal-power membership of the difference.
  rw [SModEq.sub_mem]
  have hquot :
      Ideal.Quotient.mk
          (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) n)
          (secondBeauvilleLaszloCounterexample_series k n) =
        Ideal.Quotient.mk
          (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) n)
          (secondBeauvilleLaszloCounterexample_series k (n + 1)) := by
    simpa using
      (secondBeauvilleLaszloCounterexample_series_stage_compatible (k := k)
        n (n + 1) (Nat.le_succ n)).symm
  have hmem :
      secondBeauvilleLaszloCounterexample_series k n -
          secondBeauvilleLaszloCounterexample_series k (n + 1) ∈
        principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) n := by
    rw [← Ideal.Quotient.eq
      (I := principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) n)]
    exact hquot
  simpa [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow] using hmem

/-- Helper for Example 15.91.9: the compatible truncation family defines an adic Cauchy sequence
for the second counterexample. -/
def secondBeauvilleLaszloCounterexample_series_cauchySequence :
    AdicCompletion.AdicCauchySequence
      (principalIdeal (secondBeauvilleLaszloCounterexample_f k))
      (secondBeauvilleLaszloCounterexampleRing k) :=
  AdicCompletion.AdicCauchySequence.mk
    (I := principalIdeal (secondBeauvilleLaszloCounterexample_f k))
    (M := secondBeauvilleLaszloCounterexampleRing k)
    (fun n ↦ secondBeauvilleLaszloCounterexample_series k n)
    (secondBeauvilleLaszloCounterexample_series_successive_smodEq (k := k))

/-- Helper for Example 15.91.9: the formal series `T₁ + fT₂ + f²T₃ + ⋯` defines a completion
element in the second counterexample. -/
def secondBeauvilleLaszloCounterexample_completion_series :
    principalAdicCompletion (secondBeauvilleLaszloCounterexample_f k) :=
  AdicCompletion.mk
    (principalIdeal (secondBeauvilleLaszloCounterexample_f k))
    (secondBeauvilleLaszloCounterexampleRing k)
    (secondBeauvilleLaszloCounterexample_series_cauchySequence (k := k))

/-- Helper for Example 15.91.9: evaluating the completion series at stage `n` recovers the `n`-th
truncation class. -/
theorem secondBeauvilleLaszloCounterexample_eval_completion_series (n : ℕ) :
    AdicCompletion.evalₐ
        (principalIdeal (secondBeauvilleLaszloCounterexample_f k))
        n
        (secondBeauvilleLaszloCounterexample_completion_series (k := k)) =
      Ideal.Quotient.mk
        (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) n)
        (secondBeauvilleLaszloCounterexample_series k n) := by
  -- Evaluate the completion element through the canonical `mk`-representative at stage `n`.
  rw [secondBeauvilleLaszloCounterexample_completion_series]
  exact
    AdicCompletion.evalₐ_mk
      (I := principalIdeal (secondBeauvilleLaszloCounterexample_f k))
      (R := secondBeauvilleLaszloCounterexampleRing k)
      n
      (secondBeauvilleLaszloCounterexample_series_cauchySequence (k := k))

/-- Helper for Example 15.91.9: the completion series is killed by `f` in the adic completion. -/
theorem secondBeauvilleLaszloCounterexample_completion_series_mul_f_eq_zero :
    algebraMap
        (secondBeauvilleLaszloCounterexampleRing k)
        (principalAdicCompletion (secondBeauvilleLaszloCounterexample_f k))
        (secondBeauvilleLaszloCounterexample_f k) *
      secondBeauvilleLaszloCounterexample_completion_series (k := k) =
        0 := by
  let _ :
      Module
        (secondBeauvilleLaszloCounterexampleRing k)
        (principalAdicCompletion (secondBeauvilleLaszloCounterexample_f k)) :=
    Algebra.toModule
  -- Compare the two completion elements stagewise at every finite quotient.
  apply AdicCompletion.ext_evalₐ
  intro n
  -- The stage quotient of the product is the class of `f * series n`, which vanishes by the
  -- truncation relation already proved in the source ring.
  calc
    AdicCompletion.evalₐ
        (principalIdeal (secondBeauvilleLaszloCounterexample_f k))
        n
        ((algebraMap
            (secondBeauvilleLaszloCounterexampleRing k)
            (principalAdicCompletion (secondBeauvilleLaszloCounterexample_f k))
            (secondBeauvilleLaszloCounterexample_f k)) *
          secondBeauvilleLaszloCounterexample_completion_series (k := k))
      =
        Ideal.Quotient.mk
          (principalPowerIdeal (secondBeauvilleLaszloCounterexample_f k) n)
          (secondBeauvilleLaszloCounterexample_f k *
            secondBeauvilleLaszloCounterexample_series k n) := by
            rw [map_mul]
            simp [principalAdicCompletion,
              secondBeauvilleLaszloCounterexample_eval_completion_series, map_mul]
    _ = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr <|
        by
          rw [show
              secondBeauvilleLaszloCounterexample_f k *
                  secondBeauvilleLaszloCounterexample_series k n =
                0 by
                exact secondBeauvilleLaszloCounterexample_series_mul_f_eq_zero (k := k) n]
          exact Ideal.zero_mem _
    _ =
        AdicCompletion.evalₐ
          (principalIdeal (secondBeauvilleLaszloCounterexample_f k))
          n
          (0 :
            principalAdicCompletion (secondBeauvilleLaszloCounterexample_f k)) := by
              symm
              simpa [principalAdicCompletion] using
                (AdicCompletion.evalₐ_of
                  (I := principalIdeal (secondBeauvilleLaszloCounterexample_f k))
                  n
                  (0 : secondBeauvilleLaszloCounterexampleRing k))

/-- Helper for Example 15.91.9: raw evaluation to the polynomial part sends `f` to `X` and every
`T_i` to `0`. -/
def secondBeauvilleLaszloCounterexample_polynomial_eval :
    MvPolynomial BeauvilleLaszloCounterexampleVar k →+* Polynomial k :=
  MvPolynomial.eval₂Hom
    (algebraMap k (Polynomial k))
    (fun
      | .f => Polynomial.X
      | .t _ => 0)

/-- Helper for Example 15.91.9: every defining relation of the second quotient vanishes under the
polynomial-part evaluation. -/
theorem secondBeauvilleLaszloCounterexample_polynomial_eval_relation_zero (n : ℕ) :
    secondBeauvilleLaszloCounterexample_polynomial_eval k
      (@secondBeauvilleLaszloCounterexampleRelation k Field.toCommRing n) = 0 := by
  -- The relations all contain a factor `T_(n+1)`, which the polynomial-part map kills.
  change secondBeauvilleLaszloCounterexample_polynomial_eval k
    ((@beauvilleLaszloCounterexample_fVar k Field.toCommRing) ^ (n + 1) *
      (@beauvilleLaszloCounterexample_tVar k Field.toCommRing n)) = 0
  simp [secondBeauvilleLaszloCounterexample_polynomial_eval]

/-- Helper for Example 15.91.9: the polynomial-part evaluation kills the whole defining ideal of
the second quotient. -/
theorem secondBeauvilleLaszloCounterexample_polynomial_eval_ideal_zero :
    ∀ p ∈ (@secondBeauvilleLaszloCounterexampleIdeal k Field.toCommRing),
      secondBeauvilleLaszloCounterexample_polynomial_eval k p = 0 := by
  intro p hp
  have hker :
      (@secondBeauvilleLaszloCounterexampleIdeal k Field.toCommRing) ≤
        RingHom.ker (secondBeauvilleLaszloCounterexample_polynomial_eval k) := by
    -- The ideal is generated by relations already sent to zero.
    change Ideal.span
        (Set.range (@secondBeauvilleLaszloCounterexampleRelation k Field.toCommRing)) ≤
      RingHom.ker (secondBeauvilleLaszloCounterexample_polynomial_eval k)
    rw [Ideal.span_le]
    intro q hq
    rcases hq with ⟨n, rfl⟩
    exact RingHom.mem_ker.mpr <|
      secondBeauvilleLaszloCounterexample_polynomial_eval_relation_zero (k := k) n
  exact RingHom.mem_ker.mp (hker hp)

/-- Helper for Example 15.91.9: the defining ideal of the second quotient lies in the kernel of
the polynomial-part evaluation. -/
theorem secondBeauvilleLaszloCounterexample_polynomial_eval_ideal_le_ker :
    @secondBeauvilleLaszloCounterexampleIdeal k Field.toCommRing ≤
      RingHom.ker (secondBeauvilleLaszloCounterexample_polynomial_eval k) := by
  intro p hp
  exact RingHom.mem_ker.mpr <|
    secondBeauvilleLaszloCounterexample_polynomial_eval_ideal_zero (k := k) p hp

/-- Helper for Example 15.91.9: the quotient map to the polynomial part forgets all `T_i` and
retains only the `k[f]`-component. -/
def secondBeauvilleLaszloCounterexample_polynomial_part :
    (@secondBeauvilleLaszloCounterexampleRing k Field.toCommRing) →+* Polynomial k :=
  Ideal.Quotient.lift (@secondBeauvilleLaszloCounterexampleIdeal k Field.toCommRing)
    (secondBeauvilleLaszloCounterexample_polynomial_eval k)
    (fun x hx ↦ RingHom.mem_ker.mp <|
      secondBeauvilleLaszloCounterexample_polynomial_eval_ideal_zero (k := k) x hx)

/-- Helper for Example 15.91.9: the descended polynomial-part map agrees with the raw evaluation
on quotient representatives. -/
theorem secondBeauvilleLaszloCounterexample_polynomial_part_mk
    (p : MvPolynomial BeauvilleLaszloCounterexampleVar k) :
    secondBeauvilleLaszloCounterexample_polynomial_part k
        ((Ideal.Quotient.mk (@secondBeauvilleLaszloCounterexampleIdeal k Field.toCommRing) p :
          @secondBeauvilleLaszloCounterexampleRing k Field.toCommRing)) =
      secondBeauvilleLaszloCounterexample_polynomial_eval k p := by
  -- The quotient factor map is definitionally the original evaluation on representatives.
  rw [secondBeauvilleLaszloCounterexample_polynomial_part, Ideal.Quotient.lift_mk]

/-- Helper for Example 15.91.9: any element killed by a power of `f` has trivial polynomial part,
because `k[f]` is a domain. -/
theorem secondBeauvilleLaszloCounterexample_polynomial_part_eq_zero_of_pow_mul_eq_zero
    {x : @secondBeauvilleLaszloCounterexampleRing k Field.toCommRing} {n : ℕ}
    (hx : (@secondBeauvilleLaszloCounterexample_f k Field.toCommRing) ^ n * x = 0) :
    secondBeauvilleLaszloCounterexample_polynomial_part k x = 0 := by
  have hf :
      secondBeauvilleLaszloCounterexample_polynomial_part k
        (@secondBeauvilleLaszloCounterexample_f k Field.toCommRing) = Polynomial.X := by
    -- The polynomial part remembers only the distinguished variable `f`.
    change secondBeauvilleLaszloCounterexample_polynomial_part k
        ((Ideal.Quotient.mk (@secondBeauvilleLaszloCounterexampleIdeal k Field.toCommRing)
          (@beauvilleLaszloCounterexample_fVar k Field.toCommRing) :
            @secondBeauvilleLaszloCounterexampleRing k Field.toCommRing)) = Polynomial.X
    simpa [secondBeauvilleLaszloCounterexample_polynomial_eval] using
      secondBeauvilleLaszloCounterexample_polynomial_part_mk
        (k := k) (@beauvilleLaszloCounterexample_fVar k Field.toCommRing)
  have hmap :
      (Polynomial.X : Polynomial k) ^ n *
          secondBeauvilleLaszloCounterexample_polynomial_part k x = 0 := by
    -- Applying the descended polynomial-part map moves the torsion relation into `k[X]`.
    simpa [map_mul, map_pow, hf] using
      congrArg (secondBeauvilleLaszloCounterexample_polynomial_part k) hx
  cases n with
  | zero =>
      -- When `n = 0`, the source relation already says `x = 0`.
      simpa using hmap
  | succ n =>
      -- For positive `n`, cancel the nonzero polynomial power `X^(n+1)`.
      exact (mul_eq_zero.mp hmap).resolve_left <|
        pow_ne_zero (n + 1) Polynomial.X_ne_zero

/-- Helper for Example 15.91.9: raw stage-`N+1` separator evaluation sends `f` to `[X]`, sends
`T_(N+1)` to `1`, and kills all other `T_i`. -/
def secondBeauvilleLaszloCounterexample_stage_separator_eval (N : ℕ) :
    MvPolynomial BeauvilleLaszloCounterexampleVar k →+*
      Polynomial k ⧸ principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1) :=
  MvPolynomial.eval₂Hom
    ((Ideal.Quotient.mk
      (principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1))).comp
      (algebraMap k (Polynomial k)))
    (fun
      | .f =>
          Ideal.Quotient.mk
            (principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1))
            (Polynomial.X : Polynomial k)
      | .t n =>
          if n = N then 1 else 0)

/-- Helper for Example 15.91.9: the raw stage separator kills each defining relation of the second
counterexample quotient. -/
theorem secondBeauvilleLaszloCounterexample_stage_separator_eval_relation_zero
    (N n : ℕ) :
    secondBeauvilleLaszloCounterexample_stage_separator_eval k N
      (@secondBeauvilleLaszloCounterexampleRelation k Field.toCommRing n) = 0 := by
  -- The only nontrivial case is `n = N`, where the image is `[X^(N+1)] = 0` in the quotient.
  by_cases h : n = N
  · subst n
    have hpow_zero :
        Ideal.Quotient.mk
            (principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1))
            ((Polynomial.X : Polynomial k) ^ (N + 1)) = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr <|
        by
          simpa [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow] using
            (Ideal.mem_span_singleton_self
              ((Polynomial.X : Polynomial k) ^ (N + 1)))
    -- After unfolding the distinguished `N`-th variable, the relation becomes `[X^(N+1)]`.
    simpa [secondBeauvilleLaszloCounterexample_stage_separator_eval,
      secondBeauvilleLaszloCounterexampleRelation, beauvilleLaszloCounterexample_fVar,
      beauvilleLaszloCounterexample_tVar, hpow_zero]
  · -- If `n ≠ N`, then the relation contains a factor `T_(n+1)` sent to `0`.
    simp [secondBeauvilleLaszloCounterexample_stage_separator_eval,
      secondBeauvilleLaszloCounterexampleRelation, beauvilleLaszloCounterexample_fVar,
      beauvilleLaszloCounterexample_tVar, h]

/-- Helper for Example 15.91.9: the raw stage separator kills the defining ideal of the second
counterexample quotient. -/
theorem secondBeauvilleLaszloCounterexample_stage_separator_eval_ideal_le_ker
    (N : ℕ) :
    @secondBeauvilleLaszloCounterexampleIdeal k Field.toCommRing ≤
      RingHom.ker (secondBeauvilleLaszloCounterexample_stage_separator_eval k N) := by
  -- Every generator already vanishes under the raw evaluation, so the ideal lies in the kernel.
  rw [secondBeauvilleLaszloCounterexampleIdeal, Ideal.span_le]
  intro p hp
  rcases hp with ⟨n, rfl⟩
  exact RingHom.mem_ker.mpr <|
    secondBeauvilleLaszloCounterexample_stage_separator_eval_relation_zero (k := k) N n

/-- Helper for Example 15.91.9: the raw stage separator descends to the second counterexample
quotient ring. -/
def secondBeauvilleLaszloCounterexample_separator (N : ℕ) :
    (@secondBeauvilleLaszloCounterexampleRing k Field.toCommRing) →+*
      Polynomial k ⧸ principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1) :=
  Ideal.Quotient.lift
    (@secondBeauvilleLaszloCounterexampleIdeal k Field.toCommRing)
    (secondBeauvilleLaszloCounterexample_stage_separator_eval k N)
    (fun x hx ↦ RingHom.mem_ker.mp <|
      secondBeauvilleLaszloCounterexample_stage_separator_eval_ideal_le_ker (k := k) N hx)

/-- Helper for Example 15.91.9: the descended separator still sends the distinguished element `f`
to `[X]`. -/
theorem secondBeauvilleLaszloCounterexample_separator_f (N : ℕ) :
    secondBeauvilleLaszloCounterexample_separator k N
        (@secondBeauvilleLaszloCounterexample_f k Field.toCommRing) =
      Ideal.Quotient.mk
        (principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1))
        (Polynomial.X : Polynomial k) := by
  -- Unwinding the quotient lift computes the separator on the generator `f`.
  simp [secondBeauvilleLaszloCounterexample_separator,
    secondBeauvilleLaszloCounterexample_stage_separator_eval,
    secondBeauvilleLaszloCounterexample_f, beauvilleLaszloCounterexample_fVar]

/-- Helper for Example 15.91.9: the descended separator kills `f^(N+1)`, so it factors through the
stage quotient modulo `f^(N+1)`. -/
theorem secondBeauvilleLaszloCounterexample_separator_pow_eq_zero (N : ℕ) :
    secondBeauvilleLaszloCounterexample_separator k N
        ((@secondBeauvilleLaszloCounterexample_f k Field.toCommRing) ^ (N + 1)) = 0 := by
  have hpow_zero :
      Ideal.Quotient.mk
          (principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1))
          ((Polynomial.X : Polynomial k) ^ (N + 1)) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr <|
      by
        simpa [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow] using
          (Ideal.mem_span_singleton_self ((Polynomial.X : Polynomial k) ^ (N + 1)))
  -- The image of `f^(N+1)` is exactly `[X^(N+1)]`, which vanishes in the target quotient.
  calc
    secondBeauvilleLaszloCounterexample_separator k N
        ((@secondBeauvilleLaszloCounterexample_f k Field.toCommRing) ^ (N + 1))
      =
        (Ideal.Quotient.mk
          (principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1))
          (Polynomial.X : Polynomial k)) ^ (N + 1) := by
            rw [map_pow, secondBeauvilleLaszloCounterexample_separator_f]
    _ =
        Ideal.Quotient.mk
          (principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1))
          ((Polynomial.X : Polynomial k) ^ (N + 1)) := by
            simp
    _ = 0 := hpow_zero

/-- Helper for Example 15.91.9: the stage separator factors through the `(N+1)`-st quotient of the
second counterexample ring. -/
def secondBeauvilleLaszloCounterexample_stage_separator (N : ℕ) :
    (@secondBeauvilleLaszloCounterexampleRing k Field.toCommRing) ⧸
        principalPowerIdeal
          (@secondBeauvilleLaszloCounterexample_f k Field.toCommRing)
          (N + 1) →+*
      Polynomial k ⧸ principalPowerIdeal (Polynomial.X : Polynomial k) (N + 1) :=
  Ideal.Quotient.lift
    (principalPowerIdeal
      (@secondBeauvilleLaszloCounterexample_f k Field.toCommRing)
      (N + 1))
    (secondBeauvilleLaszloCounterexample_separator k N)
    (fun x hx ↦ by
      -- Any element of the stage ideal is a multiple of `f^(N+1)`, and the separator kills that
      -- power already.
      rw [principalPowerIdeal, principalIdeal, Ideal.span_singleton_pow,
        Ideal.mem_span_singleton'] at hx
      rcases hx with ⟨a, rfl⟩
      exact by
        rw [map_mul, secondBeauvilleLaszloCounterexample_separator_pow_eq_zero, mul_zero])

/-- Helper for Example 15.91.9: the stage separator detects the fresh `N`-th term of the
truncation family by sending the stage-`N+1` truncation to `[X^N]`. -/
theorem secondBeauvilleLaszloCounterexample_stage_separator_descends (N : ℕ) :
    secondBeauvilleLaszloCounterexample_stage_separator k N
