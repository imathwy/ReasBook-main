import Mathlib.Algebra.Category.FGModuleCat.Basic
import Mathlib.Algebra.Module.Torsion.Basic
import Mathlib.CategoryTheory.Quotient
import Mathlib.Data.PNat.Basic
import Mathlib.RingTheory.Ideal.Quotient.PowTransition

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory

noncomputable section

universe u

namespace IadicFiniteModuleSystem

variable (A : Type u) [CommRing A] (I : Ideal A)

/-- The quotient ring `A / I^n` at stage `n`. -/
abbrev stageRing (n : ℕ+) :=
  A ⧸ I ^ (n : ℕ)

end IadicFiniteModuleSystem

variable (A : Type u) [CommRing A] (I : Ideal A)

/-- A system of finite modules over the quotients `A / I^n`, indexed by positive integers `n`. -/
abbrev IadicFiniteModuleSystem :=
  ∀ n : ℕ+, FGModuleCat.{u} (IadicFiniteModuleSystem.stageRing A I n)

namespace IadicFiniteModuleSystem

variable {A I}

/- Domain-style sampling for Remark 15.101.6:
- primary domain: i-adic systems of finite modules together with representative-level morphisms
  and the quotient category they generate;
- sampled same-kind declarations:
  `CategoryTheory.Quotient.functor`,
  `CategoryTheory.Quotient.lift`,
  `CategoryTheory.Quotient.sound`,
  `CategoryTheory.SimplicialObject.HomotopyCategory`;
- best owner abstraction:
  `source-facing`: the quotient category of i-adic finite module systems from the remark;
  `core/canonical`: `CategoryTheory.Quotient` applied to the congruence on the representative
    category generated by one-step promotion;
  `bridge/view`: the representative category with morphisms `HomRepresentative X Y` and the
    defining promotion relation `g = f.successor`.
- primitive data: the level modules, the stage ideal, the representative family `map`, and the
  one-step promotion operation on representatives.
- derived API: the representative-category composition law, the congruence on representatives, and
  the canonical quotient functor into the category of the remark.

This item is therefore centered on the canonical quotient-category owner, not on a bespoke raw-hom
quotient `Category` instance. -/

variable (A) (I) in
/-- The image of `I` inside the quotient ring `A / I^n`. -/
abbrev stageIdeal (n : ℕ+) : Ideal (stageRing A I n) :=
  Ideal.map (Ideal.Quotient.mk (I ^ (n : ℕ))) I

/-- The submodule `I^c E_n` obtained from the image of `I^c` in `A / I^n`. -/
abbrev powerSubmodule (c : ℕ) (X : IadicFiniteModuleSystem A I) (n : ℕ+) :
    Submodule (stageRing A I n) (X n) :=
  (stageIdeal A I n) ^ c • ⊤

/-- The torsion submodule `E_n[I^c]`. -/
abbrev torsionSubmodule (c : ℕ) (X : IadicFiniteModuleSystem A I) (n : ℕ+) :
    Submodule (stageRing A I n) (X n) :=
  Submodule.torsionBySet (stageRing A I n) (X n) ↑(stageIdeal A I n ^ c)

/-- The quotient `E_n / E_n[I^c]`. -/
abbrev torsionQuotient
    (c : ℕ) (X : IadicFiniteModuleSystem A I) (n : ℕ+) :=
  X n ⧸ torsionSubmodule c X n

/-- Remark 15.101.6: a representative of a morphism between finite `A/I^n`-module systems is a
cutoff `c` together with maps `I^c E_n → E'_n / E'_n[I^c]` for every `n ≥ c`. -/
structure HomRepresentative (X Y : IadicFiniteModuleSystem A I) where
  /-- The cutoff `c` from which the family of maps is defined. -/
  cutoff : ℕ
  /-- The maps `I^c E_n → E'_n / E'_n[I^c]` for all levels `n ≥ c`. -/
  map (n : ℕ+) (_ : cutoff ≤ (n : ℕ)) :
    powerSubmodule cutoff X n →ₗ[stageRing A I n]
      torsionQuotient cutoff Y n

namespace HomRepresentative

variable {X Y : IadicFiniteModuleSystem A I}

/-- A representative can be evaluated at an admissible level to recover its levelwise linear map. -/
instance :
    CoeFun (HomRepresentative X Y) (fun f ↦
      ∀ n : ℕ+, f.cutoff ≤ (n : ℕ) →
        powerSubmodule f.cutoff X n →ₗ[stageRing A I n]
          torsionQuotient f.cutoff Y n) where
  coe f := f.map

end HomRepresentative

/-- Helper for Remark 15.101.6: evaluating a representative at a fixed level does not depend on
the particular admissibility proof. -/
private theorem homRepresentative_apply_eq_of_proof_irrel
    {X Y : IadicFiniteModuleSystem A I} (f : HomRepresentative X Y) (n : ℕ+)
    {h₁ h₂ : f.cutoff ≤ (n : ℕ)} (x : powerSubmodule f.cutoff X n) :
    f n h₁ x = f n h₂ x := by
  cases Subsingleton.elim h₁ h₂
  rfl

private abbrev AdmissibleLevel (c : ℕ) :=
  {n : ℕ+ // c ≤ (n : ℕ)}

private abbrev quotientPowerMap
    (c d : ℕ) (X : IadicFiniteModuleSystem A I) (n : ℕ+) :
    powerSubmodule d X n →ₗ[stageRing A I n] torsionQuotient c X n :=
  (torsionSubmodule c X n).mkQ.comp (powerSubmodule d X n).subtype

/-- The canonical inclusion `I^d E_n ↪ I^c E_n` for `c ≤ d`. -/
private abbrev powerSubmoduleInclusion
    (X : IadicFiniteModuleSystem A I) {c d : ℕ} (h : c ≤ d) (n : ℕ+) :
    powerSubmodule d X n →ₗ[stageRing A I n] powerSubmodule c X n :=
  Submodule.inclusion <| by
    simpa [powerSubmodule] using
      (Submodule.pow_smul_top_le (stageIdeal A I n) (X n) h)

/-- The canonical quotient map induced by increasing the torsion cutoff. -/
private noncomputable abbrev torsionQuotientMap
    (X : IadicFiniteModuleSystem A I) {c d : ℕ} (h : c ≤ d) (n : ℕ+) :
    torsionQuotient c X n →ₗ[stageRing A I n] torsionQuotient d X n :=
  (torsionSubmodule c X n).mapQ
    (torsionSubmodule d X n)
    LinearMap.id
    (by
      simpa using
        (Submodule.torsionBySet_le_torsionBySet_pow c d h (stageIdeal A I n)))

/-- The promoted representative `(c + 1, \bar \varphi_n)` attached to a representative
`(c, \varphi_n)`. -/
private noncomputable def HomRepresentative.successor
    {X Y : IadicFiniteModuleSystem A I} (f : HomRepresentative X Y) :
    HomRepresentative X Y where
  cutoff := f.cutoff + 1
  map n hn :=
    (torsionQuotientMap Y (Nat.le_succ f.cutoff) n).comp
      ((f n (Nat.le_trans (Nat.le_succ f.cutoff) hn)).comp
        (powerSubmoduleInclusion X (Nat.le_succ f.cutoff) n))

private noncomputable abbrev restrictedLevelMap
    {X Y : IadicFiniteModuleSystem A I} (f : HomRepresentative X Y) (d : ℕ)
    (n : AdmissibleLevel (f.cutoff + d)) :
    powerSubmodule (f.cutoff + d) X n.1 →ₗ[stageRing A I n.1]
      torsionQuotient f.cutoff Y n.1 :=
  (f n.1 (Nat.le_trans (Nat.le_add_right f.cutoff d) n.2)).comp
    (powerSubmoduleInclusion X (Nat.le_add_right f.cutoff d) n.1)

/-- Helper for Remark 15.101.6: multiplying a `c`-torsion element by an element of `I^d` keeps it
inside the same `c`-torsion submodule. -/
private theorem torsionSubmodule_smul_mem
    {Y : IadicFiniteModuleSystem A I} (c d : ℕ) (n : ℕ+)
    {a : stageRing A I n} (ha : a ∈ stageIdeal A I n ^ d)
    {y : Y n} (hy : y ∈ torsionSubmodule c Y n) :
    a • y ∈ torsionSubmodule c Y n := by
  -- We test the new element against every element of `I^c` and absorb the extra factor into the
  -- same cutoff using monotonicity of ideal powers.
  rw [Submodule.mem_torsionBySet_iff] at hy ⊢
  intro b
  have hab : (↑b : stageRing A I n) * a ∈ stageIdeal A I n ^ c := by
    have hab' : (↑b : stageRing A I n) * a ∈ stageIdeal A I n ^ c * stageIdeal A I n ^ d := by
      simpa [mul_comm, mul_left_comm, mul_assoc] using
        (Submodule.smul_mem_smul b.2 ha :
          (↑b : stageRing A I n) • a ∈
            (stageIdeal A I n ^ c) •
              (stageIdeal A I n ^ d : Submodule (stageRing A I n) (stageRing A I n)))
    have hab'' : (↑b : stageRing A I n) * a ∈ stageIdeal A I n ^ (c + d) := by
      simpa [pow_add] using hab'
    exact (Ideal.pow_le_pow_right (Nat.le_add_right c d)) hab''
  simpa [smul_smul, mul_comm, mul_left_comm, mul_assoc] using
    hy ⟨(↑b : stageRing A I n) * a, hab⟩

/-- Helper for Remark 15.101.6: after multiplying a quotient class by an element of `I^d`, the
result is represented by an element of `I^d E_n`. -/
private theorem smul_mem_quotientPowerRange
    {Y : IadicFiniteModuleSystem A I} (c d : ℕ) (n : ℕ+)
    {a : stageRing A I n} (ha : a ∈ stageIdeal A I n ^ d)
    (q : torsionQuotient c Y n) :
    a • q ∈ (quotientPowerMap c d Y n).range := by
  -- We choose a representative of the quotient class and multiply it upstairs.
  obtain ⟨y, rfl⟩ := (torsionSubmodule c Y n).mkQ_surjective q
  refine ⟨⟨a • y, ?_⟩, ?_⟩
  · simpa [powerSubmodule] using
      (Submodule.smul_mem_smul ha
        (show y ∈ (⊤ : Submodule (stageRing A I n) (Y n)) from by simp))
  · rfl

private theorem representativeImage_mem_quotientPowerRange
    {X Y : IadicFiniteModuleSystem A I} (f : HomRepresentative X Y) (d : ℕ)
    (n : AdmissibleLevel (f.cutoff + d))
    (x : powerSubmodule (f.cutoff + d) X n.1) :
    restrictedLevelMap f d n x ∈
      (quotientPowerMap f.cutoff d Y n.1).range := by
  let J : Ideal (stageRing A I n.1) := stageIdeal A I n.1
  have hpow :
      powerSubmodule (f.cutoff + d) X n.1 = J ^ d • powerSubmodule f.cutoff X n.1 := by
    -- This is the standard `I^(c+d) = I^d I^c` rewrite behind the source proof.
    calc
      powerSubmodule (f.cutoff + d) X n.1
          = J ^ (d + f.cutoff) • (⊤ : Submodule (stageRing A I n.1) (X n.1)) := by
              simp [J, powerSubmodule, Nat.add_comm]
      _ = (J ^ d * J ^ f.cutoff) • (⊤ : Submodule (stageRing A I n.1) (X n.1)) := by
            rw [pow_add]
      _ = ((J ^ d : Submodule (stageRing A I n.1) (stageRing A I n.1)) •
            (J ^ f.cutoff : Submodule (stageRing A I n.1) (stageRing A I n.1))) •
              (⊤ : Submodule (stageRing A I n.1) (X n.1)) := by
            rfl
      _ = J ^ d • powerSubmodule f.cutoff X n.1 := by
            rw [Submodule.smul_assoc]
  have hx : (x : X n.1) ∈ J ^ d • powerSubmodule f.cutoff X n.1 := by
    simpa [hpow] using x.2
  -- We now reduce to generators of `I^d • I^c E_n` and explicitly build the required witness.
  have hx_range :
      ∃ y : powerSubmodule d Y n.1,
        quotientPowerMap f.cutoff d Y n.1 y =
          restrictedLevelMap f d n ⟨(x : X n.1), by simpa [hpow] using hx⟩ := by
    refine
      Submodule.smul_induction_on' hx
        (p := fun z hz ↦
          ∃ y : powerSubmodule d Y n.1,
            quotientPowerMap f.cutoff d Y n.1 y =
              restrictedLevelMap f d n ⟨z, by simpa [hpow] using hz⟩)
        ?_ ?_
    · intro a ha y hy
      -- A pure generator maps to `a • φ_n(y)`, and such classes are exactly the range we need.
      let φ :=
        f n.1 (Nat.le_trans (Nat.le_add_right f.cutoff d) n.2)
      rcases
        smul_mem_quotientPowerRange (A := A) (I := I) f.cutoff d n.1 ha
          (φ ⟨y, hy⟩)
        with ⟨w, hw⟩
      have hsmul :
          φ ⟨a • y, (powerSubmodule f.cutoff X n.1).smul_mem a hy⟩ =
            a • φ ⟨y, hy⟩ := by
        change φ (a • (⟨y, hy⟩ : powerSubmodule f.cutoff X n.1)) = _
        rw [LinearMap.map_smul]
      refine ⟨w, ?_⟩
      change quotientPowerMap f.cutoff d Y n.1 w =
        φ ⟨a • y, (powerSubmodule f.cutoff X n.1).smul_mem a hy⟩
      rw [hsmul]
      exact hw
    · intro z hz w hw hzmem hwmem
      let ι := powerSubmoduleInclusion X (Nat.le_add_right f.cutoff d) n.1
      let φ := f n.1 (Nat.le_trans (Nat.le_add_right f.cutoff d) n.2)
      rcases hzmem with ⟨yz, hyz⟩
      rcases hwmem with ⟨yw, hyw⟩
      refine ⟨yz + yw, ?_⟩
      calc
        quotientPowerMap f.cutoff d Y n.1 (yz + yw)
            = quotientPowerMap f.cutoff d Y n.1 yz + quotientPowerMap f.cutoff d Y n.1 yw := by
                simp
        _ = φ (ι ⟨z, by simpa [hpow] using hz⟩) +
              φ (ι ⟨w, by simpa [hpow] using hw⟩) := by
                rw [hyz, hyw]
                simp [restrictedLevelMap, ι, φ, LinearMap.comp_apply]
        _ = φ (ι ⟨z + w, by simpa [hpow] using add_mem hz hw⟩) := by
              rw [← LinearMap.map_add]
              rfl
        _ = restrictedLevelMap f d n ⟨z + w, by simpa [hpow] using add_mem hz hw⟩ := by
              rfl
  simpa using hx_range

private noncomputable def representativeToQuotientPowerRange
    {X Y : IadicFiniteModuleSystem A I} (f : HomRepresentative X Y) (d : ℕ)
    (n : AdmissibleLevel (f.cutoff + d)) :
    powerSubmodule (f.cutoff + d) X n.1 →ₗ[stageRing A I n.1]
      (quotientPowerMap f.cutoff d Y n.1).range :=
  LinearMap.codRestrict
    (quotientPowerMap f.cutoff d Y n.1).range
    (restrictedLevelMap f d n)
    (representativeImage_mem_quotientPowerRange f d n)

private noncomputable def promotedLevelMapAux
    (c : ℕ) {Y Z : IadicFiniteModuleSystem A I} (g : HomRepresentative Y Z)
    (n : AdmissibleLevel (c + g.cutoff)) :
    powerSubmodule g.cutoff Y n.1 →ₗ[stageRing A I n.1]
      torsionQuotient (c + g.cutoff) Z n.1 :=
  let hgcut : g.cutoff ≤ c + g.cutoff := Nat.le_add_left g.cutoff c
  (torsionQuotientMap Z hgcut n.1).comp
    (g n.1 <| Nat.le_trans hgcut n.2)

/-- Helper for Remark 15.101.6: a class in `E_n / E_n[I^d]` that is already `I^c`-torsion becomes
zero in the quotient by `E_n[I^(c+d)]`. -/
private theorem torsionQuotientMap_eq_zero_of_mem_torsion
    {Z : IadicFiniteModuleSystem A I} (c d : ℕ) (n : ℕ+)
    {q : torsionQuotient d Z n}
    (hq : q ∈
      Submodule.torsionBySet (stageRing A I n) (torsionQuotient d Z n) ↑(stageIdeal A I n ^ c)) :
    (torsionQuotientMap Z (show d ≤ c + d by exact Nat.le_add_left d c) n) q = 0 := by
  obtain ⟨z, rfl⟩ := (torsionSubmodule d Z n).mkQ_surjective q
  -- We show that any representative of the class already lies in the larger torsion submodule.
  change (Submodule.Quotient.mk z : torsionQuotient (c + d) Z n) = 0
  refine (Submodule.Quotient.mk_eq_zero (p := torsionSubmodule (c + d) Z n)).2 ?_
  rw [Submodule.mem_torsionBySet_iff]
  intro b
  have hb :
      (↑b : stageRing A I n) ∈
        (stageIdeal A I n ^ c) •
          (stageIdeal A I n ^ d : Submodule (stageRing A I n) (stageRing A I n)) := by
    simpa [pow_add] using b.2
  -- Every generator of `I^c I^d` kills the chosen representative.
  refine Submodule.smul_induction_on hb ?_ ?_
  · intro a ha r hr
    have haq : (a : stageRing A I n) • (Submodule.Quotient.mk z : torsionQuotient d Z n) = 0 := by
      exact (Submodule.mem_torsionBySet_iff _ _).mp hq ⟨a, ha⟩
    have haz : (a : stageRing A I n) • z ∈ torsionSubmodule d Z n := by
      exact (Submodule.Quotient.mk_eq_zero
        (p := torsionSubmodule d Z n)).1 <| by
          simpa using haq
    have hrz : (r : stageRing A I n) • ((a : stageRing A I n) • z) = 0 := by
      exact (Submodule.mem_torsionBySet_iff _ _).mp haz ⟨r, hr⟩
    simpa [smul_smul, mul_comm, mul_left_comm, mul_assoc] using hrz
  · intro x y hx hy
    simp [add_smul, hx, hy]

private theorem quotientPowerMap_ker_le_promotedLevelMapAux_ker
    (c : ℕ) {Y Z : IadicFiniteModuleSystem A I} (g : HomRepresentative Y Z)
    (n : AdmissibleLevel (c + g.cutoff)) :
    (quotientPowerMap c g.cutoff Y n.1).ker ≤
      (promotedLevelMapAux c g n).ker := by
  intro y hy
  rw [LinearMap.mem_ker] at hy ⊢
  -- The kernel condition says precisely that the chosen element of `I^c Y_n` is `I^c`-torsion.
  have hy_torsion : ((powerSubmodule g.cutoff Y n.1).subtype y : Y n.1) ∈ torsionSubmodule c Y n.1 := by
    exact (Submodule.Quotient.mk_eq_zero
      (p := torsionSubmodule c Y n.1)).1 <| by
        simpa [quotientPowerMap, LinearMap.comp_apply] using hy
  have hq_torsion :
      g n.1 (Nat.le_trans (Nat.le_add_left g.cutoff c) n.2) y ∈
        Submodule.torsionBySet (stageRing A I n.1) (torsionQuotient g.cutoff Z n.1)
          ↑(stageIdeal A I n.1 ^ c) := by
    -- Applying `g_n` preserves the `I^c`-torsion relation because `g_n` is linear.
    rw [Submodule.mem_torsionBySet_iff]
    intro a
    have hay : (↑a : stageRing A I n.1) • ((powerSubmodule g.cutoff Y n.1).subtype y : Y n.1) = 0 := by
      exact (Submodule.mem_torsionBySet_iff _ _).mp hy_torsion a
    have hay' : (↑a : stageRing A I n.1) • y = 0 := by
      apply Subtype.ext
      simpa using hay
    rw [← LinearMap.map_smul, hay', map_zero]
  -- The promoted map is the quotient map to the larger torsion cutoff, so the class dies there.
  simpa [promotedLevelMapAux, LinearMap.comp_apply] using
    torsionQuotientMap_eq_zero_of_mem_torsion (A := A) (I := I) c g.cutoff n.1 hq_torsion

private noncomputable def promotedLevelMap
    (c : ℕ) {Y Z : IadicFiniteModuleSystem A I} (g : HomRepresentative Y Z)
    (n : AdmissibleLevel (c + g.cutoff)) :
    (quotientPowerMap c g.cutoff Y n.1).range →ₗ[stageRing A I n.1]
      torsionQuotient (c + g.cutoff) Z n.1 :=
  let lifted :
      (powerSubmodule g.cutoff Y n.1 ⧸ (quotientPowerMap c g.cutoff Y n.1).ker) →ₗ[stageRing A I n.1]
        torsionQuotient (c + g.cutoff) Z n.1 :=
    (quotientPowerMap c g.cutoff Y n.1).ker.liftQ
      (promotedLevelMapAux c g n)
      (quotientPowerMap_ker_le_promotedLevelMapAux_ker c g n)
  lifted.comp (quotientPowerMap c g.cutoff Y n.1).quotKerEquivRange.symm.toLinearMap

/-- Helper for Remark 15.101.6: on a canonical range witness, the descended map agrees with the
obvious representative-level formula before passing to the quotient-range model. -/
@[simp] private theorem promotedLevelMap_apply_quotientPowerMap
    (c : ℕ) {Y Z : IadicFiniteModuleSystem A I} (g : HomRepresentative Y Z)
    (n : AdmissibleLevel (c + g.cutoff))
    (y : powerSubmodule g.cutoff Y n.1) :
    promotedLevelMap c g n
      ⟨quotientPowerMap c g.cutoff Y n.1 y, LinearMap.mem_range_self _ y⟩ =
      promotedLevelMapAux c g n y := by
  -- This is the normalization lemma that removes the quotient-range packaging.
  rw [promotedLevelMap]
  dsimp
  have hs :
      (quotientPowerMap c g.cutoff Y n.1).quotKerEquivRange.symm
        ⟨Submodule.Quotient.mk ↑y, LinearMap.mem_range_self _ y⟩ =
        (quotientPowerMap c g.cutoff Y n.1).ker.mkQ y := by
    simpa [quotientPowerMap, LinearMap.comp_apply] using
      (LinearMap.quotKerEquivRange_symm_apply_image
        (f := quotientPowerMap c g.cutoff Y n.1) y
        (LinearMap.mem_range_self _ y))
  rw [hs]
  have hlift :
      (((quotientPowerMap c g.cutoff Y n.1).ker.liftQ
          (promotedLevelMapAux c g n)
          (quotientPowerMap_ker_le_promotedLevelMapAux_ker c g n)).comp
        (quotientPowerMap c g.cutoff Y n.1).ker.mkQ) =
        promotedLevelMapAux c g n := by
    exact
      (Submodule.liftQ_mkQ
        (p := (quotientPowerMap c g.cutoff Y n.1).ker)
        (f := promotedLevelMapAux c g n)
        (h := quotientPowerMap_ker_le_promotedLevelMapAux_ker c g n))
  change
    (((quotientPowerMap c g.cutoff Y n.1).ker.liftQ
        (promotedLevelMapAux c g n)
        (quotientPowerMap_ker_le_promotedLevelMapAux_ker c g n))
      ((quotientPowerMap c g.cutoff Y n.1).ker.mkQ y)) =
      (promotedLevelMapAux c g n) y
  simpa [LinearMap.comp_apply] using congrArg (fun φ => φ y) hlift

namespace HomRepresentative

variable {W X Y Z : IadicFiniteModuleSystem A I}

/-- One representative promotes to another when the cutoff is increased by one. -/
def promotesTo (f g : HomRepresentative X Y) : Prop :=
  g = f.successor

/-- The identity representative `(0, \mathrm{id})`. -/
noncomputable def id (X : IadicFiniteModuleSystem A I) : HomRepresentative X X where
  cutoff := 0
  map n _ := quotientPowerMap 0 0 X n

/-- The obvious composition of representatives from Remark 15.101.6, with cutoff equal to the sum
of the two cutoffs. -/
noncomputable def comp
    (f : HomRepresentative X Y) (g : HomRepresentative Y Z) :
    HomRepresentative X Z where
  cutoff := f.cutoff + g.cutoff
  map n hn :=
    (promotedLevelMap f.cutoff g ⟨n, hn⟩).comp
      (representativeToQuotientPowerRange f g.cutoff ⟨n, hn⟩)

instance : Setoid (HomRepresentative X Y) :=
  Relation.EqvGen.setoid promotesTo

-- Route correction: instead of unfolding record equality directly, compare representatives by
-- cutoff equality and levelwise formulas, then normalize `comp` through an explicit range witness.

/-- Helper for Remark 15.101.6: representatives with the same cutoff are equal once their levelwise
maps agree, even if the admissibility proofs differ. -/
private theorem levelwise_extensionality
    (f g : HomRepresentative X Y)
    (hcut : f.cutoff = g.cutoff)
    (hmap : ∀ (n : ℕ+) (hn : f.cutoff ≤ (n : ℕ)),
      HEq (f n hn) (g n (by simpa [hcut] using hn))) :
    f = g := by
  -- We first normalize the shared cutoff, then the proof arguments are irrelevant by subsingleton.
  cases f
  cases g
  cases hcut
  simp only [mk.injEq, heq_eq_eq, true_and] at hmap ⊢
  funext n hn
  simpa using hmap n hn

/-- Helper for Remark 15.101.6: representatives with the same cutoff are equal once their
pointwise values agree after the source-power transport induced by the cutoff equality. -/
private theorem levelwise_extensionality_cast
    (f g : HomRepresentative X Y)
    (hcut : f.cutoff = g.cutoff)
    (hmap : ∀ (n : ℕ+) (hn : f.cutoff ≤ (n : ℕ))
      (x : powerSubmodule f.cutoff X n),
        HEq ((f n hn) x)
          ((g n (by simpa [hcut] using hn)) (by simpa [hcut] using x))) :
    f = g := by
  -- We normalize the shared cutoff first; then the source and target transports become
  -- definitional and only the value-level equality remains.
  cases f
  cases g
  cases hcut
  simp only [mk.injEq, heq_eq_eq, true_and] at hmap ⊢
  funext n hn
  apply LinearMap.ext
  intro x
  simpa using hmap n hn x

/-- Helper for Remark 15.101.6: a chosen explicit witness for the quotient-range model computes the
value of the composed representative. -/
private theorem comp_map_apply_of_range_witness
    (f : HomRepresentative X Y) (g : HomRepresentative Y Z)
    (n : ℕ+) (hn : f.cutoff + g.cutoff ≤ (n : ℕ))
    (x : powerSubmodule (f.cutoff + g.cutoff) X n)
    (y : powerSubmodule g.cutoff Y n)
    (hy : quotientPowerMap f.cutoff g.cutoff Y n y =
      restrictedLevelMap f g.cutoff ⟨n, hn⟩ x) :
    (f.comp g) n hn x = promotedLevelMapAux f.cutoff g ⟨n, hn⟩ y := by
  -- We replace the `codRestrict` witness produced by `comp` with the chosen explicit witness `y`.
  change
    promotedLevelMap f.cutoff g ⟨n, hn⟩
      (representativeToQuotientPowerRange f g.cutoff ⟨n, hn⟩ x) =
        promotedLevelMapAux f.cutoff g ⟨n, hn⟩ y
  have hwitness :
      representativeToQuotientPowerRange f g.cutoff ⟨n, hn⟩ x =
        ⟨quotientPowerMap f.cutoff g.cutoff Y n y, LinearMap.mem_range_self _ y⟩ := by
    apply Subtype.ext
    simpa [representativeToQuotientPowerRange] using hy.symm
  rw [hwitness]
  -- The descended map agrees with the original representative-level formula on canonical witnesses.
  simpa using
    promotedLevelMap_apply_quotientPowerMap (A := A) (I := I) f.cutoff g ⟨n, hn⟩ y

/-- Helper for Remark 15.101.6: composing the cutoff-`0` quotient map with the inclusion
`I^d E_n ↪ E_n` is the canonical quotient map from `I^d E_n`. -/
private theorem quotientPowerMap_zero_comp_powerSubmoduleInclusion_eq
    (X : IadicFiniteModuleSystem A I) (d : ℕ) (n : ℕ+) :
    (quotientPowerMap 0 0 X n).comp
      (powerSubmoduleInclusion X (show 0 ≤ d by exact Nat.zero_le d) n) =
        quotientPowerMap 0 d X n := by
  -- Both sides send `x ∈ I^d E_n` to the same quotient class of its underlying element.
  ext x
  rfl

/-- Helper for Remark 15.101.6: the reflexive torsion transition map is the identity. -/
private theorem torsionQuotientMap_refl_eq_id
    (X : IadicFiniteModuleSystem A I) (c : ℕ) (n : ℕ+) (h : c ≤ c) :
    torsionQuotientMap X h n = LinearMap.id := by
  -- The proof term for `c ≤ c` is irrelevant, so we reduce to `le_rfl` and evaluate on classes.
  have hh : h = le_rfl := Subsingleton.elim _ _
  subst hh
  ext z
  rfl

/-- Helper for Remark 15.101.6: composing two power-submodule inclusions is the direct inclusion
across the transitive cutoff inequality. -/
private theorem powerSubmoduleInclusion_comp_eq
    (X : IadicFiniteModuleSystem A I) {c d e : ℕ}
    (hcd : c ≤ d) (hde : d ≤ e) (n : ℕ+) :
    (powerSubmoduleInclusion X hcd n).comp (powerSubmoduleInclusion X hde n) =
      powerSubmoduleInclusion X (Nat.le_trans hcd hde) n := by
  -- Both maps are the same subtype inclusion after proof irrelevance on the cutoff inequalities.
  ext x
  rfl

/-- Helper for Remark 15.101.6: composing two torsion quotient transitions is the direct
transition across the transitive cutoff inequality. -/
private theorem torsionQuotientMap_comp_eq
    (X : IadicFiniteModuleSystem A I) {c d e : ℕ}
    (hcd : c ≤ d) (hde : d ≤ e) (n : ℕ+) :
    (torsionQuotientMap X hde n).comp (torsionQuotientMap X hcd n) =
      torsionQuotientMap X (Nat.le_trans hcd hde) n := by
  -- We evaluate on quotient representatives, where each transition keeps the same chosen class.
  ext x
  rfl

/-- Helper for Remark 15.101.6: transporting a torsion transition across an equality of target
cutoffs only changes the proof parameter. -/
private theorem torsionQuotientMap_cast_eq_of_cutoff_eq
    (Z : IadicFiniteModuleSystem A I) {c d₁ d₂ : ℕ} (hd : d₁ = d₂)
    (h₁ : c ≤ d₁) (h₂ : c ≤ d₂) (n : ℕ+) (q : torsionQuotient c Z n) :
    cast (by cases hd; rfl) ((torsionQuotientMap Z h₁ n) q) =
      (torsionQuotientMap Z h₂ n) q := by
  cases hd
  cases Subsingleton.elim h₁ h₂
  rfl

/-- Helper for Remark 15.101.6: transporting a quotient class along an equality of submodules does
not change its chosen representative. -/
private theorem submodule_quotient_mk_cast_eq
    {R : Type*} [Ring R] {M : Type*} [AddCommGroup M] [Module R M]
    (p q : Submodule R M) (h : p = q) (x : M) :
    cast (congrArg (fun s => M ⧸ s) h) (Submodule.Quotient.mk x : M ⧸ p) =
      (Submodule.Quotient.mk x : M ⧸ q) := by
  -- We normalize the submodule equality first, so the cast becomes definitional.
  cases h
  rfl

/-- Helper for Remark 15.101.6: transporting a subtype element along an equality of predicates
preserves its ambient value. -/
private theorem subtype_transport_coe_eq
    {α : Type*} {p q : α → Prop} (h : p = q) (x : Subtype p) :
    ((Eq.mp (congrArg Subtype h) x : Subtype q) : α) = x := by
  cases h
  rfl

/-- Helper for Remark 15.101.6: the torsion transition map sends a quotient class represented by
`x` to the same representative in the larger quotient. -/
private theorem torsionQuotientMap_apply_mk
    (X : IadicFiniteModuleSystem A I) {c d : ℕ} (h : c ≤ d) (n : ℕ+)
    (x : X n) :
    (torsionQuotientMap X h n) (Submodule.Quotient.mk x : torsionQuotient c X n) =
      (Submodule.Quotient.mk x : torsionQuotient d X n) := by
  -- The transition is induced by `LinearMap.id`, so it preserves the chosen representative.
  rfl

/-- Helper for Remark 15.101.6: first quotienting by cutoff `0` and then enlarging the torsion
cutoff to `c` is the same as quotienting directly by cutoff `c`. -/
private theorem torsionQuotientMap_comp_quotientPowerMap_zero_eq
    (Y : IadicFiniteModuleSystem A I) (c : ℕ) (n : ℕ+) :
    (torsionQuotientMap Y (show 0 ≤ c by exact Nat.zero_le c) n).comp
      (quotientPowerMap 0 0 Y n) =
        quotientPowerMap c 0 Y n := by
  -- Both maps send an element of `E_n = I^0 E_n` to its class modulo `E_n[I^c]`.
  ext y
  rfl

/-- Helper for Remark 15.101.6: evaluating the cutoff-`0` inclusion composite on a transported
element of `I^(0 + d) E_n` matches the canonical quotient map from `I^d E_n`. -/
private theorem quotientPowerMap_zero_comp_powerSubmoduleInclusion_apply_cast
    (X : IadicFiniteModuleSystem A I) (d : ℕ) (n : ℕ+)
    (x : powerSubmodule (0 + d) X n) :
    ((quotientPowerMap 0 0 X n).comp
      (powerSubmoduleInclusion X (show 0 ≤ 0 + d by exact Nat.zero_le _) n)) x =
        quotientPowerMap 0 d X n (by simpa [Nat.zero_add] using x) := by
  -- Both sides are the quotient class of the same underlying element of `X n`.
  rcases x with ⟨val, property⟩
  have hpred :
      (fun a : X n => a ∈ powerSubmodule (0 + d) X n) =
        fun a : X n => a ∈ powerSubmodule d X n := by
    funext a
    simp
  simp only [LinearMap.coe_comp, Submodule.coe_subtype, Function.comp_apply,
    Submodule.coe_inclusion, Submodule.mkQ_apply, eq_mp_eq_cast]
  refine congrArg Submodule.Quotient.mk ?_
  symm
  simpa [hpred] using
    subtype_transport_coe_eq hpred
      (x := (⟨val, property⟩ : powerSubmodule (0 + d) X n))

/-- Helper for Remark 15.101.6: after transporting `0 + c` back to `c`, the zero-left torsion
transition acts as the identity on each quotient class as an ordinary equality. -/
private theorem torsionQuotientMap_zero_add_apply_cast_eq
    (Z : IadicFiniteModuleSystem A I) (c : ℕ) (n : ℕ+)
    (q : torsionQuotient c Z n) :
    cast (by simp [torsionQuotient])
      ((torsionQuotientMap Z (Nat.le_add_left c 0) n) q) = q := by
  -- Route correction: we first align the codomains by an explicit cast, so only the reflexive
  -- cutoff transition remains.
  obtain ⟨z, rfl⟩ := (torsionSubmodule c Z n).mkQ_surjective q
  -- On quotient representatives, the zero-left transition is literally the same quotient class.
  -- The remaining step is exactly transport of `Submodule.Quotient.mk z` across equal cutoffs.
  simpa [torsionQuotient,
      torsionQuotientMap_apply_mk (A := A) (I := I) Z (Nat.le_add_left c 0) n z] using
    submodule_quotient_mk_cast_eq
      (R := stageRing A I n) (M := Z n)
      (torsionSubmodule (0 + c) Z n)
      (torsionSubmodule c Z n)
      (by simp)
      z

/-- Helper for Remark 15.101.6: after transporting `0 + c` back to `c`, the zero-left torsion
transition acts as the identity on each quotient class. -/
private theorem torsionQuotientMap_zero_add_apply_heq
    (Z : IadicFiniteModuleSystem A I) (c : ℕ) (n : ℕ+)
    (q : torsionQuotient c Z n) :
    HEq ((torsionQuotientMap Z (Nat.le_add_left c 0) n) q) q := by
  -- We now convert the aligned equality into the `HEq` form used by downstream transport lemmas.
  exact heq_of_cast_eq _ <|
    torsionQuotientMap_zero_add_apply_cast_eq (A := A) (I := I) Z c n q

/-- Helper for Remark 15.101.6: the restricted map of the identity representative is the canonical
quotient map on `I^d E_n`. -/
private theorem restrictedLevelMap_id_eq_quotientPowerMap
    (X : IadicFiniteModuleSystem A I) (d : ℕ)
    (n : AdmissibleLevel (0 + d))
    (x : powerSubmodule (0 + d) X n.1) :
    restrictedLevelMap (HomRepresentative.id X) d n x =
      quotientPowerMap 0 d X n.1 (by simpa [Nat.zero_add] using x) := by
  -- We unfold one layer of `restrictedLevelMap` and then use the apply-level cutoff-`0` adapter.
  simpa [restrictedLevelMap, HomRepresentative.id, LinearMap.comp_apply] using
    quotientPowerMap_zero_comp_powerSubmoduleInclusion_apply_cast
      (A := A) (I := I) X d n.1 x

/-- Helper for Remark 15.101.6: promoting by cutoff `0` does not change the target representative. -/
private theorem promotedLevelMapAux_zero_eq
    (f : HomRepresentative Y Z)
    (n : AdmissibleLevel (0 + f.cutoff))
    (y : powerSubmodule f.cutoff Y n.1) :
    HEq (promotedLevelMapAux 0 f n y)
      (f n.1 (by simpa [Nat.zero_add] using n.2) y) := by
  -- We unfold one layer of `promotedLevelMapAux` and remove the remaining codomain transport.
  simpa [promotedLevelMapAux, LinearMap.comp_apply] using
    torsionQuotientMap_zero_add_apply_heq
      (A := A) (I := I) Z f.cutoff n.1
      (f n.1 (by simpa [Nat.zero_add] using n.2) y)

/-- Helper for Remark 15.101.6: promoting the identity representative is the canonical quotient
map to the larger torsion cutoff. -/
private theorem promotedLevelMapAux_id_eq
    (c : ℕ) (Y : IadicFiniteModuleSystem A I)
    (n : AdmissibleLevel (c + 0))
    (y : powerSubmodule 0 Y n.1) :
    promotedLevelMapAux c (HomRepresentative.id Y) n y =
      quotientPowerMap c 0 Y n.1 (by simpa [Nat.add_zero] using y) := by
  -- We unfold the promoted identity map and collapse the quotient transition to the direct map.
  simpa [promotedLevelMapAux, HomRepresentative.id, Nat.add_zero, LinearMap.comp_apply] using
    congrArg
      (fun φ => φ (by simpa [Nat.add_zero] using y))
      (torsionQuotientMap_comp_quotientPowerMap_zero_eq
        (A := A) (I := I) Y c n.1)

/-- Helper for Remark 15.101.6: restricting a representative by cutoff `0` leaves its level map
unchanged. -/
private theorem restrictedLevelMap_zero_eq
    (f : HomRepresentative X Y)
    (n : AdmissibleLevel (f.cutoff + 0))
    (x : powerSubmodule (f.cutoff + 0) X n.1) :
    restrictedLevelMap f 0 n x =
      f n.1 (by simpa [Nat.add_zero] using n.2) (by simpa [Nat.add_zero] using x) := by
  -- The inclusion `I^c E_n ↪ I^c E_n` is the identity map once the proof is normalized.
  cases x
  rfl

/-- Helper for Remark 15.101.6: restricting the promoted source representative is the same as
first restricting by one extra power and then enlarging the torsion cutoff. -/
private theorem quotientPowerMap_inclusion_eq
    (c d : ℕ) (Y : IadicFiniteModuleSystem A I) (n : ℕ+)
    (y : powerSubmodule (d + 1) Y n) :
    quotientPowerMap c d Y n (powerSubmoduleInclusion Y (Nat.le_succ d) n y) =
      quotientPowerMap c (d + 1) Y n y := by
  -- Both sides are the same quotient class of the same underlying element after dropping one
  -- source-power witness.
  rfl

/-- Helper for Remark 15.101.6: quotienting after first dropping `e` source powers agrees with
quotienting directly from the larger source power. -/
private theorem quotientPowerMap_inclusion_add_eq
    (c d e : ℕ) (Y : IadicFiniteModuleSystem A I) (n : ℕ+)
    (y : powerSubmodule (d + e) Y n) :
    quotientPowerMap c d Y n
        (powerSubmoduleInclusion Y
          (show d ≤ d + e by exact Nat.le_add_right d e) n y) =
      quotientPowerMap c (d + e) Y n y := by
  -- After unpacking the subtype witness, both maps keep the same underlying representative.
  cases y
  rfl

/-- Helper for Remark 15.101.6: restricting by one fewer source power before applying the level map
agrees with restricting directly at the larger cutoff. -/
private theorem restrictedLevelMap_drop_one_eq
    (f : HomRepresentative X Y) (d : ℕ)
    (n : AdmissibleLevel (f.cutoff + d + 1))
    (x : powerSubmodule (f.cutoff + d + 1) X n.1) :
    restrictedLevelMap f d
        ⟨n.1, by omega⟩
        (powerSubmoduleInclusion X (show f.cutoff + d ≤ f.cutoff + d + 1 by omega) n.1 x) =
      restrictedLevelMap f (d + 1)
        ⟨n.1, by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using n.2⟩
        x := by
  -- We unfold one layer of `restrictedLevelMap` and collapse the successive inclusions to the
  -- direct inclusion.
  cases x
  rfl

/-- Helper for Remark 15.101.6: dropping one source power from the right-associated cutoff
`f.cutoff + (d + 1)` agrees with restricting directly at cutoff `d + 1`. -/
private theorem restrictedLevelMap_drop_one_assoc_eq
    (f : HomRepresentative X Y) (d : ℕ) (n : ℕ+)
    (hn : f.cutoff + (d + 1) ≤ (n : ℕ))
    (hfd : f.cutoff + d ≤ (n : ℕ))
    (x : powerSubmodule (f.cutoff + (d + 1)) X n) :
    restrictedLevelMap f d
        ⟨n, hfd⟩
        (powerSubmoduleInclusion X
          (show f.cutoff + d ≤ f.cutoff + (d + 1) by omega) n x) =
      restrictedLevelMap f (d + 1)
        ⟨n, hn⟩
        x := by
  -- After one unfold, both sides evaluate the same representative on the same underlying element.
  simp only [restrictedLevelMap, LinearMap.comp_apply]
  cases x
  rfl

/-- Helper for Remark 15.101.6: restricting the promoted source representative is the same as
first restricting by one extra power and then enlarging the torsion cutoff. -/
private theorem restrictedLevelMap_successor_unfold_apply
    (f : HomRepresentative X Y) (d : ℕ)
    (n : AdmissibleLevel (f.cutoff + 1 + d))
    (x : powerSubmodule (f.cutoff + 1 + d) X n.1) :
    restrictedLevelMap f.successor d n x =
      (torsionQuotientMap Y (Nat.le_succ f.cutoff) n.1)
        (restrictedLevelMap f d
          ⟨n.1, by omega⟩
          (powerSubmoduleInclusion X
            (show f.cutoff + d ≤ f.cutoff + 1 + d by omega) n.1 x)) := by
  -- Route correction: we expose the raw successor formula first, before rewriting the source
  -- cutoff from `d` to `d + 1`.
  simp only [restrictedLevelMap, HomRepresentative.successor, LinearMap.comp_apply]
  -- After unpacking the subtype element, both sides are the same nested inclusion formula.
  cases x
  rfl

/-- Helper for Remark 15.101.6: restricting the promoted source representative is the same as
first restricting by one extra power and then enlarging the torsion cutoff. -/
private theorem powerSubmoduleInclusion_add_succ_cast_eq
    (c d : ℕ) (X : IadicFiniteModuleSystem A I) (n : ℕ+)
    (x : powerSubmodule (c + 1 + d) X n) :
    powerSubmoduleInclusion X (show c + d ≤ c + 1 + d by omega) n x =
      powerSubmoduleInclusion X (show c + d ≤ c + d + 1 by omega) n
        (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x) := by
  -- After unpacking the subtype witness, both inclusions are the same underlying subtype map.
  have hpred :
      (fun a : X n => a ∈ powerSubmodule (c + 1 + d) X n) =
        fun a : X n => a ∈ powerSubmodule (c + d + 1) X n := by
    funext a
    simp [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
  apply Subtype.ext
  symm
  simpa [powerSubmoduleInclusion, hpred, eq_mp_eq_cast] using
    subtype_transport_coe_eq hpred x

/-- Helper for Remark 15.101.6: transporting a source element across the reassociation
`c + d + e = c + (d + e)` does not change the smaller-cutoff inclusion. -/
private theorem powerSubmoduleInclusion_add_assoc_cast_eq
    (c d e : ℕ) (X : IadicFiniteModuleSystem A I) (n : ℕ+)
    (x : powerSubmodule (c + d + e) X n) :
    powerSubmoduleInclusion X (show c + d ≤ c + d + e by omega) n x =
      powerSubmoduleInclusion X (show c + d ≤ c + (d + e) by omega) n
        (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x) := by
  -- Both inclusions keep the same underlying element after reassociating the cutoff sum.
  have hpred :
      (fun a : X n => a ∈ powerSubmodule (c + d + e) X n) =
        fun a : X n => a ∈ powerSubmodule (c + (d + e)) X n := by
    funext a
    simp [Nat.add_left_comm, Nat.add_comm]
  apply Subtype.ext
  symm
  simpa [powerSubmoduleInclusion, hpred, eq_mp_eq_cast] using
    subtype_transport_coe_eq hpred x

/-- Helper for Remark 15.101.6: transporting an element across the reassociation
`c + d + e = c + (d + e)` does not change the direct inclusion into cutoff `c`. -/
private theorem powerSubmoduleInclusion_base_assoc_cast_eq
    (c d e : ℕ) (X : IadicFiniteModuleSystem A I) (n : ℕ+)
    (x : powerSubmodule (c + d + e) X n) :
    powerSubmoduleInclusion X (show c ≤ c + d + e by omega) n x =
      powerSubmoduleInclusion X (show c ≤ c + (d + e) by omega) n
        (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x) := by
  -- Reassociating the source exponent does not change the ambient element being included.
  have hpred :
      (fun a : X n => a ∈ powerSubmodule (c + d + e) X n) =
        fun a : X n => a ∈ powerSubmodule (c + (d + e)) X n := by
    funext a
    simp [Nat.add_left_comm, Nat.add_comm]
  apply Subtype.ext
  symm
  simpa [powerSubmoduleInclusion, hpred, eq_mp_eq_cast] using
    subtype_transport_coe_eq hpred x

/-- Helper for Remark 15.101.6: shifting the left cutoff in `promotedLevelMapAux` by one applies
the successor torsion transition after the smaller-cutoff map. -/
private theorem promotedLevelMapAux_cutoff_succ_eq
    (c : ℕ) (g : HomRepresentative Y Z)
    (n : AdmissibleLevel ((c + 1) + g.cutoff))
    (y : powerSubmodule g.cutoff Y n.1) :
    promotedLevelMapAux (c + 1) g n y =
      (torsionQuotientMap Z
        (show c + g.cutoff ≤ (c + 1) + g.cutoff by omega) n.1)
        (promotedLevelMapAux c g
          ⟨n.1, by omega⟩
          y) := by
  -- Both sides are the direct torsion transition from `g.cutoff` to `(c + 1) + g.cutoff`.
  have hg_cutoff : g.cutoff ≤ (n : ℕ) := by
    exact Nat.le_trans (Nat.le_add_left g.cutoff (c + 1)) n.2
  have hcomp :
      (torsionQuotientMap Z
        (show c + g.cutoff ≤ (c + 1) + g.cutoff by omega) n.1).comp
        (torsionQuotientMap Z (Nat.le_add_left g.cutoff c) n.1) =
      torsionQuotientMap Z
        (show g.cutoff ≤ (c + 1) + g.cutoff by omega) n.1 := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      torsionQuotientMap_comp_eq (A := A) (I := I) (X := Z)
        (hcd := Nat.le_add_left g.cutoff c)
        (hde := show c + g.cutoff ≤ (c + 1) + g.cutoff from
          Nat.add_le_add_right (Nat.le_succ c) g.cutoff)
        (n := n.1)
  -- We compare the two paths after evaluating them on the common representative `g_n(y)`.
  symm
  simpa [promotedLevelMapAux, LinearMap.comp_apply, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
    using
      congrArg
        (fun φ => φ ((g n.1 hg_cutoff) y))
        hcomp

/-- Helper for Remark 15.101.6: promoting the target representative before applying cutoff `c`
agrees with first applying the unpromoted target map and then enlarging the torsion cutoff by one. -/
private theorem promotedLevelMapAux_successor_eq
    (c : ℕ) (g : HomRepresentative Y Z)
    (n : AdmissibleLevel (c + (g.cutoff + 1)))
    (y : powerSubmodule (g.cutoff + 1) Y n.1) :
    promotedLevelMapAux c g.successor n y =
      (torsionQuotientMap Z (show c + g.cutoff ≤ c + (g.cutoff + 1) by
          omega) n.1)
        (promotedLevelMapAux c g
          ⟨n.1, by
            omega⟩
          (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n.1 y)) := by
  -- Route correction: we normalize the target successor transport before any witness arguments,
  -- so the proof reduces to composing the two torsion transitions and dropping proof transport.
  have hg_cutoff : g.cutoff ≤ (n : ℕ) := by
    exact Nat.le_trans
      (Nat.le_trans (Nat.le_succ g.cutoff) (Nat.le_add_left (g.cutoff + 1) c))
      n.2
  have hleft :
      (torsionQuotientMap Z (show g.cutoff + 1 ≤ c + (g.cutoff + 1) by omega) n.1).comp
        (torsionQuotientMap Z (Nat.le_succ g.cutoff) n.1) =
      torsionQuotientMap Z (show g.cutoff ≤ c + (g.cutoff + 1) by omega) n.1 := by
    -- The left path first raises the cutoff by one and then by `c`.
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      torsionQuotientMap_comp_eq (A := A) (I := I) (X := Z)
        (hcd := Nat.le_succ g.cutoff)
        (hde := show g.cutoff + 1 ≤ c + (g.cutoff + 1) from
          Nat.le_add_left (g.cutoff + 1) c)
        (n := n.1)
  have hright :
      (torsionQuotientMap Z (show c + g.cutoff ≤ c + (g.cutoff + 1) by omega) n.1).comp
        (torsionQuotientMap Z (Nat.le_add_left g.cutoff c) n.1) =
      torsionQuotientMap Z (show g.cutoff ≤ c + (g.cutoff + 1) by omega) n.1 := by
    -- The right path first raises the cutoff by `c` and then takes the successor transition.
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      torsionQuotientMap_comp_eq (A := A) (I := I) (X := Z)
        (hcd := Nat.le_add_left g.cutoff c)
        (hde := show c + g.cutoff ≤ c + (g.cutoff + 1) from
          Nat.add_le_add_left (Nat.le_succ g.cutoff) c)
        (n := n.1)
  -- Both sides are the same direct transition from cutoff `g.cutoff` to `c + (g.cutoff + 1)`.
  change
    ((torsionQuotientMap Z (show g.cutoff + 1 ≤ c + (g.cutoff + 1) by omega) n.1).comp
        (torsionQuotientMap Z (Nat.le_succ g.cutoff) n.1))
      ((g n.1 hg_cutoff) (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n.1 y)) =
      ((torsionQuotientMap Z (show c + g.cutoff ≤ c + (g.cutoff + 1) by omega) n.1).comp
        (torsionQuotientMap Z (Nat.le_add_left g.cutoff c) n.1))
      ((g n.1 hg_cutoff) (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n.1 y))
  calc
    _ =
        (torsionQuotientMap Z (show g.cutoff ≤ c + (g.cutoff + 1) by omega) n.1)
          ((g n.1 hg_cutoff) (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n.1 y)) := by
            simpa using
              congrArg
                (fun φ =>
                  φ ((g n.1 hg_cutoff)
                    (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n.1 y)))
                hleft
    _ = _ := by
      symm
      simpa using
        congrArg
          (fun φ =>
            φ ((g n.1 hg_cutoff)
              (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n.1 y)))
          hright

/-- Helper for Remark 15.101.6: enlarging the torsion cutoff after `quotientPowerMap c (d + 1)`
is the same as quotienting directly at cutoff `c + 1`. -/
private theorem torsionQuotientMap_quotientPowerMap_successor_eq
    (c d : ℕ) (Y : IadicFiniteModuleSystem A I) (n : ℕ+) :
    (torsionQuotientMap Y (Nat.le_succ c) n).comp
      (quotientPowerMap c (d + 1) Y n) =
        quotientPowerMap (c + 1) (d + 1) Y n := by
  -- Both sides keep the same representative and only change the quotient submodule upstairs.
  rfl

/-- Helper for Remark 15.101.6: enlarging the torsion cutoff after `quotientPowerMap c d`
is the same as quotienting directly at the larger cutoff. -/
private theorem torsionQuotientMap_comp_quotientPowerMap_eq
    (c c' d : ℕ) (Y : IadicFiniteModuleSystem A I) (n : ℕ+) :
    (torsionQuotientMap Y (show c ≤ c + c' by exact Nat.le_add_right c c') n).comp
      (quotientPowerMap c d Y n) =
        quotientPowerMap (c + c') d Y n := by
  -- Both maps keep the same representative and only change the quotient submodule upstairs.
  rfl

/-- Helper for Remark 15.101.6: promoting the source representative before composing agrees with
promoting the composite once. -/
private theorem comp_successor_witness_normalization
    (f : HomRepresentative X Y) (g : HomRepresentative Y Z)
    (n : ℕ+) (hn : f.cutoff + 1 + g.cutoff ≤ (n : ℕ))
    (x : powerSubmodule (f.cutoff + 1 + g.cutoff) X n)
    (hfg : f.cutoff + g.cutoff ≤ (n : ℕ))
    {y : powerSubmodule (g.cutoff + 1) Y n}
    (hy : quotientPowerMap f.cutoff (g.cutoff + 1) Y n y =
      restrictedLevelMap f (g.cutoff + 1)
        ⟨n, by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
        (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x)) :
    let y0 := powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y
    let x0 := powerSubmoduleInclusion X
      (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n x
    quotientPowerMap (f.cutoff + 1) g.cutoff Y n y0 =
        restrictedLevelMap f.successor g.cutoff ⟨n, hn⟩ x ∧
      quotientPowerMap f.cutoff g.cutoff Y n y0 = restrictedLevelMap f g.cutoff ⟨n, hfg⟩ x0 := by
  -- We package the included witness `y0` once so both successor comparisons reduce to the already
  -- normalized restriction formulas.
  dsimp
  let n' : AdmissibleLevel (f.cutoff + g.cutoff + 1) := by
    exact ⟨n, by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
  let x' : powerSubmodule (f.cutoff + g.cutoff + 1) X n := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x
  have hx :
      powerSubmoduleInclusion X
          (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n x =
        powerSubmoduleInclusion X
          (show f.cutoff + g.cutoff ≤ f.cutoff + g.cutoff + 1 by omega) n x' := by
    simpa [x', Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      powerSubmoduleInclusion_add_succ_cast_eq
        (A := A) (I := I) (X := X) f.cutoff g.cutoff n x
  have hdrop_map :
      restrictedLevelMap f g.cutoff ⟨n, hfg⟩
          (powerSubmoduleInclusion X
            (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n x) =
        restrictedLevelMap f (g.cutoff + 1) n' x' := by
    calc
      restrictedLevelMap f g.cutoff ⟨n, hfg⟩
          (powerSubmoduleInclusion X
            (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n x) =
        restrictedLevelMap f g.cutoff ⟨n, hfg⟩
          (powerSubmoduleInclusion X
            (show f.cutoff + g.cutoff ≤ f.cutoff + g.cutoff + 1 by omega) n x') := by
              exact congrArg (fun z => restrictedLevelMap f g.cutoff ⟨n, hfg⟩ z) hx
      _ = restrictedLevelMap f (g.cutoff + 1) n' x' := by
            simpa [n', x', Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
              restrictedLevelMap_drop_one_eq
                (A := A) (I := I) (X := X) (Y := Y) f g.cutoff n' x'
  have hsucc_map :
      restrictedLevelMap f.successor g.cutoff ⟨n, hn⟩ x =
        (torsionQuotientMap Y (Nat.le_succ f.cutoff) n)
          (restrictedLevelMap f (g.cutoff + 1) n' x') := by
    rw [restrictedLevelMap_successor_unfold_apply]
    change
      (torsionQuotientMap Y (Nat.le_succ f.cutoff) n)
          (restrictedLevelMap f g.cutoff ⟨n, hfg⟩
            (powerSubmoduleInclusion X
              (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n x)) =
        (torsionQuotientMap Y (Nat.le_succ f.cutoff) n)
          (restrictedLevelMap f (g.cutoff + 1) n' x')
    exact congrArg (fun q => (torsionQuotientMap Y (Nat.le_succ f.cutoff) n) q) hdrop_map
  constructor
  · -- First enlarge the source witness and then enlarge the torsion cutoff on the target.
    calc
      quotientPowerMap (f.cutoff + 1) g.cutoff Y n
          (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y)
        = quotientPowerMap (f.cutoff + 1) (g.cutoff + 1) Y n y := by
            simpa using
              quotientPowerMap_inclusion_eq
                (A := A) (I := I) (c := f.cutoff + 1) (d := g.cutoff) Y n y
      _ = (torsionQuotientMap Y (Nat.le_succ f.cutoff) n)
            (quotientPowerMap f.cutoff (g.cutoff + 1) Y n y) := by
            symm
            simpa [LinearMap.comp_apply] using
              congrArg
                (fun φ => φ y)
                (torsionQuotientMap_quotientPowerMap_successor_eq
                  (A := A) (I := I) f.cutoff g.cutoff Y n)
      _ = (torsionQuotientMap Y (Nat.le_succ f.cutoff) n)
            (restrictedLevelMap f (g.cutoff + 1)
              ⟨n, by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
              (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x)) := by
            rw [hy]
      _ = restrictedLevelMap f.successor g.cutoff ⟨n, hn⟩ x := by
            symm
            exact hsucc_map
  · -- The same witness also computes the unpromoted restriction after dropping one source power.
    calc
      quotientPowerMap f.cutoff g.cutoff Y n
          (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y)
        = quotientPowerMap f.cutoff (g.cutoff + 1) Y n y := by
            simpa using
              quotientPowerMap_inclusion_eq
                (A := A) (I := I) (c := f.cutoff) (d := g.cutoff) Y n y
      _ = restrictedLevelMap f (g.cutoff + 1)
            ⟨n, by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
            (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x) := hy
      _ = restrictedLevelMap f g.cutoff ⟨n, hfg⟩
            (powerSubmoduleInclusion X
              (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n x) := by
            symm
            exact hdrop_map

/-- Helper for Remark 15.101.6: promoting the source representative before composing agrees with
promoting the composite once. -/
private theorem comp_successor_apply_normal_form
    (f : HomRepresentative X Y) (g : HomRepresentative Y Z)
    (n : ℕ+) (hn : f.cutoff + 1 + g.cutoff ≤ (n : ℕ))
    (x : powerSubmodule (f.cutoff + 1 + g.cutoff) X n)
    (hfg : f.cutoff + g.cutoff ≤ (n : ℕ))
    {y : powerSubmodule (g.cutoff + 1) Y n}
    (hy : quotientPowerMap f.cutoff (g.cutoff + 1) Y n y =
      restrictedLevelMap f (g.cutoff + 1)
        ⟨n, by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
        (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x)) :
    let y0 := powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y
    HEq
      (((f.comp g).successor) n
        (by
          simpa [HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn)
        (by
          simpa [HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x))
      ((torsionQuotientMap Z
          (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n)
        (promotedLevelMapAux f.cutoff g ⟨n, hfg⟩ y0)) := by
  -- Route correction: we expose the successor of the composite on the same normalized witness
  -- `y0`, so the remaining proof only compares explicit promoted formulas.
  let y0 := powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y
  let x0 := powerSubmoduleInclusion X
    (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n x
  have hnorm :=
    comp_successor_witness_normalization
      (A := A) (I := I) (X := X) (Y := Y) (Z := Z)
      f g n hn x hfg hy
  dsimp [y0, x0] at hnorm
  have hinner :
      (f.comp g) n
          (by simpa [HomRepresentative.comp] using hfg)
          x0 =
        promotedLevelMapAux f.cutoff g
          ⟨n, hfg⟩
          y0 := by
    -- The inner composite is computed by the same chosen witness `y0`.
    exact
      comp_map_apply_of_range_witness (A := A) (I := I)
        (f := f) (g := g) n
        hfg
        x0 y0 hnorm.2
  -- One unfold of `successor` turns the target into the outer torsion transition of that inner
  -- composite value, which we already normalized above.
  let x' : powerSubmodule (f.cutoff + g.cutoff + 1) X n := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x
  have hn' : f.cutoff + g.cutoff + 1 ≤ (n : ℕ) := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn
  have hx :
      powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x' = x0 := by
    symm
    simpa [x', x0, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      powerSubmoduleInclusion_add_succ_cast_eq
        (A := A) (I := I) (X := X) f.cutoff g.cutoff n x
  have hfg_comp :
      f.cutoff + g.cutoff ≤ (n : ℕ) := by
    simpa [HomRepresentative.comp] using hfg
  have hsource :
      (f.comp g) n
          (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
          (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x') =
        (f.comp g) n
          hfg_comp
          x0 := by
    rw [hx]
  have hsucc_cut :
      f.cutoff + g.cutoff ≤ (f.comp g).successor.cutoff := by
    simp [HomRepresentative.successor, HomRepresentative.comp, Nat.add_assoc]
  have hprom_cut :
      f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff := by
    omega
  have hsucc_apply :
      (torsionQuotientMap Z hprom_cut n)
        ((f.comp g) n
          (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
          (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x')) =
      (torsionQuotientMap Z hprom_cut n) ((f.comp g) n hfg_comp x0) := by
    exact
      congrArg
        (fun q => (torsionQuotientMap Z hprom_cut n) q)
        hsource
  have hsucc_eq :
      HEq
        (((f.comp g).successor) n
          (by simpa [HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn)
          (by simpa [HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x))
        ((torsionQuotientMap Z
          hprom_cut n)
          ((f.comp g) n hfg_comp x0)) := by
    have hsucc_apply' :
        (torsionQuotientMap Z hprom_cut n)
          ((f.comp g) n
            (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
            (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x')) =
        (torsionQuotientMap Z hprom_cut n) ((f.comp g) n hfg_comp x0) := by
      simpa [x0, x', HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
        hsucc_apply
    have hcast_left :
        cast
            (by
              simp [torsionQuotient, HomRepresentative.successor, HomRepresentative.comp,
                Nat.add_assoc, Nat.add_left_comm, Nat.add_comm])
            ((torsionQuotientMap Z hsucc_cut n)
              ((f.comp g) n
                (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
                (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x'))) =
          (torsionQuotientMap Z hprom_cut n)
            ((f.comp g) n
              (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
              (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x')) := by
      have hsucc_cut' : f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff := by
        simpa [HomRepresentative.successor, HomRepresentative.comp,
          Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hsucc_cut
      have hcast_left' :
          cast
              (by
                simp [torsionQuotient, HomRepresentative.successor, HomRepresentative.comp,
                  Nat.add_assoc, Nat.add_left_comm, Nat.add_comm])
              ((torsionQuotientMap Z hsucc_cut n)
                ((f.comp g) n
                  (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
                  (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x'))) =
            (torsionQuotientMap Z hsucc_cut' n)
              ((f.comp g) n
                (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
                (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x')) := by
        exact
          torsionQuotientMap_cast_eq_of_cutoff_eq
            (A := A) (I := I) (Z := Z)
            (hd := by
              simp [HomRepresentative.successor, HomRepresentative.comp,
                Nat.add_assoc, Nat.add_left_comm, Nat.add_comm])
            hsucc_cut hsucc_cut' n
            ((f.comp g) n
              (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
              (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x'))
      cases Subsingleton.elim hsucc_cut' hprom_cut
      simpa using hcast_left'
    have hsucc_cast_eq :
        cast
            (by
              simp [torsionQuotient, HomRepresentative.successor, HomRepresentative.comp,
                Nat.add_assoc, Nat.add_left_comm, Nat.add_comm])
            (((f.comp g).successor) n
              (by simpa [HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
                hn)
              (by simpa [HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
                x)) =
          (torsionQuotientMap Z hprom_cut n) ((f.comp g) n hfg_comp x0) := by
      simpa [x', HomRepresentative.successor, HomRepresentative.comp,
        Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
        hcast_left.trans hsucc_apply'
    exact heq_of_cast_eq _ hsucc_cast_eq
  exact hsucc_eq.trans <|
    (congrArg
      (fun q =>
        (torsionQuotientMap Z
          (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n) q)
      hinner).heq

/-- Helper for Remark 15.101.6: promoting the source representative before composing agrees with
promoting the composite once. -/
private theorem comp_successor_left_eq
    (f : HomRepresentative X Y) (g : HomRepresentative Y Z) :
    f.successor.comp g = (f.comp g).successor := by
  -- Route correction: we first normalize both sides on the same included witness `y0`, and only
  -- then compare the two explicit promoted formulas levelwise.
  have hcut : (f.successor.comp g).cutoff = (f.comp g).successor.cutoff := by
    simp [HomRepresentative.comp, HomRepresentative.successor,
      Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
  refine levelwise_extensionality_cast (f.successor.comp g) (f.comp g).successor hcut ?_
  intro n hn x
  have hdrop : f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      Nat.le_succ (f.cutoff + g.cutoff)
  have hfg : f.cutoff + g.cutoff ≤ (n : ℕ) := by
    exact Nat.le_trans hdrop <|
      by
        simpa [HomRepresentative.comp, HomRepresentative.successor,
          Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn
  obtain ⟨y, hy⟩ :=
    representativeImage_mem_quotientPowerRange
      (A := A) (I := I) (f := f) (d := g.cutoff + 1)
      ⟨n, by
        simpa [HomRepresentative.comp, HomRepresentative.successor,
          Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
      (by
        simpa [HomRepresentative.comp, HomRepresentative.successor,
          Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x)
  let y0 := powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y
  have hnorm :=
    comp_successor_witness_normalization
      (A := A) (I := I) (X := X) (Y := Y) (Z := Z)
      f g n hn x hfg hy
  dsimp [y0] at hnorm
  have hleft :
      (f.successor.comp g) n hn x =
        promotedLevelMapAux (f.cutoff + 1) g ⟨n, hn⟩ y0 := by
    -- The left composite is computed directly from the normalized witness.
    exact
      comp_map_apply_of_range_witness (A := A) (I := I)
        (f := f.successor) (g := g) n hn x y0 hnorm.1
  have hright :
      HEq
        (((f.comp g).successor) n
          (by simpa [hcut] using hn)
          (by simpa [hcut] using x))
        ((torsionQuotientMap Z
            (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n)
          (promotedLevelMapAux f.cutoff g
            ⟨n, hfg⟩
            y0)) := by
    -- The successor of the composite has the same outer torsion transition after one normal-form
    -- reduction.
    simpa [y0] using
      comp_successor_apply_normal_form
        (A := A) (I := I) (X := X) (Y := Y) (Z := Z)
        f g n hn x hfg hy
  have hprom :
      HEq
        (promotedLevelMapAux (f.cutoff + 1) g ⟨n, hn⟩ y0)
        ((torsionQuotientMap Z
            (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) n)
          (promotedLevelMapAux f.cutoff g ⟨n, hfg⟩ y0)) := by
    -- The source-side promotion formula is exactly the same torsion transition.
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      (promotedLevelMapAux_cutoff_succ_eq
        (A := A) (I := I) (Y := Y) (Z := Z)
        f.cutoff g ⟨n, hn⟩ y0).heq
  exact hleft.heq.trans <| hprom.trans hright.symm

/-- Helper for Remark 15.101.6: the dropped witness induced from cutoff `g.cutoff + 1` still
computes the unpromoted restriction of `f` on the dropped source element. -/
private theorem comp_successor_right_witness_normalization
    (f : HomRepresentative X Y) (g : HomRepresentative Y Z)
    (n : ℕ+) (hn : f.cutoff + (g.cutoff + 1) ≤ (n : ℕ))
    (x : powerSubmodule (f.cutoff + (g.cutoff + 1)) X n)
    (hfg : f.cutoff + g.cutoff ≤ (n : ℕ))
    {y : powerSubmodule (g.cutoff + 1) Y n}
    (y0 : powerSubmodule g.cutoff Y n)
    (hy0 : y0 = powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y)
    (hy : quotientPowerMap f.cutoff (g.cutoff + 1) Y n y =
      restrictedLevelMap f (g.cutoff + 1) ⟨n, hn⟩ x) :
    quotientPowerMap f.cutoff g.cutoff Y n y0 =
      restrictedLevelMap f g.cutoff
        ⟨n, hfg⟩
        (powerSubmoduleInclusion X
          (show f.cutoff + g.cutoff ≤ f.cutoff + (g.cutoff + 1) by omega) n x) := by
  -- We drop one source power on both the witness and the source element while keeping the
  -- right-associated cutoff fixed.
  subst hy0
  calc
    quotientPowerMap f.cutoff g.cutoff Y n
        (powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y)
      = quotientPowerMap f.cutoff (g.cutoff + 1) Y n y := by
          simpa using
            quotientPowerMap_inclusion_eq
              (A := A) (I := I) (c := f.cutoff) (d := g.cutoff) Y n y
    _ = restrictedLevelMap f (g.cutoff + 1) ⟨n, hn⟩ x := hy
    _ = restrictedLevelMap f g.cutoff
          ⟨n, hfg⟩
          (powerSubmoduleInclusion X
            (show f.cutoff + g.cutoff ≤ f.cutoff + (g.cutoff + 1) by omega) n x) := by
              symm
              exact
                restrictedLevelMap_drop_one_assoc_eq
                  (A := A) (I := I) (X := X) (Y := Y)
                  f g.cutoff n hn hfg x

/-- Helper for Remark 15.101.6: promoting the target representative before composing agrees with
promoting the composite once. -/
private theorem comp_successor_right_eq
    (f : HomRepresentative X Y) (g : HomRepresentative Y Z) :
    f.comp g.successor = (f.comp g).successor := by
  -- Route correction: we reuse the same witness extracted from `f` at cutoff `g.cutoff + 1`,
  -- compute `f.comp g.successor` on that witness, and then compare both sides with the common
  -- right-promotion normal form from `comp_successor_right_apply_eq`.
  have hcut : (f.comp g.successor).cutoff = (f.comp g).successor.cutoff := by
    simp [HomRepresentative.comp, HomRepresentative.successor, Nat.add_assoc]
  refine levelwise_extensionality_cast (f.comp g.successor) (f.comp g).successor hcut ?_
  intro n hn x
  have hfgsucc : f.cutoff + (g.cutoff + 1) ≤ (n : ℕ) := by
    simpa [HomRepresentative.comp, HomRepresentative.successor, Nat.add_assoc] using hn
  have hfg : f.cutoff + g.cutoff ≤ (n : ℕ) := by
    exact Nat.le_trans (show f.cutoff + g.cutoff ≤ f.cutoff + 1 + g.cutoff by omega) <|
      by
        simpa [HomRepresentative.comp, HomRepresentative.successor,
          Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn
  obtain ⟨y, hy⟩ :=
    representativeImage_mem_quotientPowerRange
      (A := A) (I := I) (f := f) (d := g.cutoff + 1)
      ⟨n, by
        simpa [HomRepresentative.comp, HomRepresentative.successor,
          Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
      (by
        simpa [HomRepresentative.comp, HomRepresentative.successor,
          Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x)
  let y0 := powerSubmoduleInclusion Y (Nat.le_succ g.cutoff) n y
  have hleft :
      (f.comp g.successor) n hn x =
        promotedLevelMapAux f.cutoff g.successor ⟨n, hfgsucc⟩ y := by
    -- The composite with `g.successor` is computed by the same chosen witness `y`.
    exact
      comp_map_apply_of_range_witness (A := A) (I := I)
        (f := f) (g := g.successor) n hfgsucc x y hy
  have hprom :
      promotedLevelMapAux f.cutoff g.successor ⟨n, hfgsucc⟩ y =
        (torsionQuotientMap Z
          (show f.cutoff + g.cutoff ≤ f.cutoff + (g.cutoff + 1) by omega) n)
          (promotedLevelMapAux f.cutoff g ⟨n, hfg⟩ y0) := by
    -- The target-side promotion formula is exactly the outer torsion transition of the
    -- unpromoted formula on the dropped witness `y0`.
    simpa [y0, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      promotedLevelMapAux_successor_eq
        (A := A) (I := I) (Y := Y) (Z := Z)
        f.cutoff g ⟨n, hfgsucc⟩ y
  have hright :
      HEq
        (((f.comp g).successor) n
          (by simpa [hcut] using hn)
          (by simpa [hcut] using x))
        ((torsionQuotientMap Z
            (show f.cutoff + g.cutoff ≤ f.cutoff + (g.cutoff + 1) by omega) n)
          (promotedLevelMapAux f.cutoff g
            ⟨n, hfg⟩
            y0)) := by
    -- The composite successor is already normalized on the same dropped witness `y0`.
    let x0 : powerSubmodule (f.cutoff + g.cutoff) X n :=
      powerSubmoduleInclusion X
        (show f.cutoff + g.cutoff ≤ f.cutoff + (g.cutoff + 1) by omega) n x
    have hwitness :
        quotientPowerMap f.cutoff g.cutoff Y n y0 =
          restrictedLevelMap f g.cutoff ⟨n, hfg⟩ x0 := by
      exact
        comp_successor_right_witness_normalization
          (A := A) (I := I) (X := X) (Y := Y) (Z := Z)
          f g n hfgsucc x hfg y0 rfl hy
    have hinner :
        (f.comp g) n hfg x0 =
          promotedLevelMapAux f.cutoff g ⟨n, hfg⟩ y0 := by
      -- The inner composite is computed by the same dropped witness `y0`.
      exact
        comp_map_apply_of_range_witness
          (A := A) (I := I)
          (f := f) (g := g) n hfg x0 y0 hwitness
    let x' : powerSubmodule (f.cutoff + g.cutoff + 1) X n := by
      simpa [Nat.add_assoc] using x
    have hn' : f.cutoff + g.cutoff + 1 ≤ (n : ℕ) := by
      simpa [Nat.add_assoc] using hfgsucc
    have hx :
        powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x' = x0 := by
      simpa [x0, x', Nat.add_assoc] using
        powerSubmoduleInclusion_add_assoc_cast_eq
          (A := A) (I := I) (X := X) f.cutoff g.cutoff 1 n x'
    have hsource :
        (f.comp g) n
            (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
            (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x') =
          (f.comp g) n hfg x0 := by
      rw [hx]
    have hsucc_cut :
        f.cutoff + g.cutoff ≤ (f.comp g).successor.cutoff := by
      simp [HomRepresentative.successor, HomRepresentative.comp, Nat.add_assoc]
    have hprom_cut :
        f.cutoff + g.cutoff ≤ f.cutoff + (g.cutoff + 1) := by
      omega
    have hsucc_apply :
        (torsionQuotientMap Z hprom_cut n)
          ((f.comp g) n
            (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
            (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x')) =
        (torsionQuotientMap Z hprom_cut n) ((f.comp g) n hfg x0) := by
      exact
        congrArg
          (fun q => (torsionQuotientMap Z hprom_cut n) q)
          hsource
    have hsucc_eq :
        HEq
          (((f.comp g).successor) n
            (by simpa [HomRepresentative.comp, Nat.add_assoc] using hfgsucc)
            (by simpa [HomRepresentative.comp, Nat.add_assoc] using x))
          ((torsionQuotientMap Z hprom_cut n) ((f.comp g) n hfg x0)) := by
      have hsucc_apply' :
          (torsionQuotientMap Z hprom_cut n)
            ((f.comp g) n
              (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
              (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x')) =
          (torsionQuotientMap Z hprom_cut n) ((f.comp g) n hfg x0) := by
        simpa [x0, x', HomRepresentative.comp, Nat.add_assoc] using hsucc_apply
      have hcast_left :
          cast
              (by
                simp [torsionQuotient, HomRepresentative.successor, HomRepresentative.comp,
                  Nat.add_assoc])
              ((torsionQuotientMap Z hsucc_cut n)
                ((f.comp g) n
                  (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
                  (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x'))) =
            (torsionQuotientMap Z hprom_cut n)
              ((f.comp g) n
                (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
                (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x')) := by
        have hsucc_cut' : f.cutoff + g.cutoff ≤ f.cutoff + (g.cutoff + 1) := by
          simpa [HomRepresentative.successor, HomRepresentative.comp, Nat.add_assoc] using
            hsucc_cut
        have hcast_left' :
            cast
                (by
                  simp [torsionQuotient, HomRepresentative.successor, HomRepresentative.comp,
                    Nat.add_assoc])
                ((torsionQuotientMap Z hsucc_cut n)
                  ((f.comp g) n
                    (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
                    (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x'))) =
              (torsionQuotientMap Z hsucc_cut' n)
                ((f.comp g) n
                  (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
                  (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x')) := by
          exact
            torsionQuotientMap_cast_eq_of_cutoff_eq
              (A := A) (I := I) (Z := Z)
              (hd := by
                simp [HomRepresentative.successor, HomRepresentative.comp, Nat.add_assoc])
              hsucc_cut hsucc_cut' n
              ((f.comp g) n
                (Nat.le_trans (Nat.le_succ (f.cutoff + g.cutoff)) hn')
                (powerSubmoduleInclusion X (Nat.le_succ (f.cutoff + g.cutoff)) n x'))
        cases Subsingleton.elim hsucc_cut' hprom_cut
        simpa using hcast_left'
      have hsucc_cast_eq :
          cast
              (by
                simp [torsionQuotient, HomRepresentative.successor, HomRepresentative.comp,
                  Nat.add_assoc])
              (((f.comp g).successor) n
                (by simpa [HomRepresentative.comp, Nat.add_assoc] using hfgsucc)
                (by simpa [HomRepresentative.comp, Nat.add_assoc] using x)) =
            (torsionQuotientMap Z hprom_cut n) ((f.comp g) n hfg x0) := by
        simpa [x0, x', HomRepresentative.successor, HomRepresentative.comp, Nat.add_assoc] using
          hcast_left.trans hsucc_apply'
      exact heq_of_cast_eq _ hsucc_cast_eq
    exact hsucc_eq.trans <| (congrArg (fun q => torsionQuotientMap Z hprom_cut n q) hinner).heq
  exact (hleft.trans hprom).heq.trans hright.symm

/-- Helper for Remark 15.101.6: the identity representative is a strict left identity before
passing to the promotion quotient. -/
private theorem id_comp_strict (f : HomRepresentative X Y) :
    (id X).comp f = f := by
  -- We compare the composite with the original representative on each level using the canonical
  -- cutoff-`0` witness coming from the source element itself.
  have hcut : ((id X).comp f).cutoff = f.cutoff := by
    simp [HomRepresentative.comp, HomRepresentative.id]
  refine levelwise_extensionality_cast ((id X).comp f) f hcut ?_
  intro n hnf x
  let y : powerSubmodule f.cutoff X n := by
    simpa [HomRepresentative.comp, HomRepresentative.id, Nat.zero_add] using x
  have hy_base :
      quotientPowerMap 0 f.cutoff X n
          (by
            simpa [HomRepresentative.comp, HomRepresentative.id, Nat.zero_add] using x) =
        restrictedLevelMap (id X) f.cutoff
          ⟨n, by
            simpa [HomRepresentative.comp, HomRepresentative.id, Nat.zero_add] using hnf⟩
          x := by
    exact
      (restrictedLevelMap_id_eq_quotientPowerMap
        (A := A) (I := I) X f.cutoff
        ⟨n, by
          simpa [HomRepresentative.comp, HomRepresentative.id, Nat.zero_add] using hnf⟩
        x).symm
  have hy :
      quotientPowerMap 0 f.cutoff X n y =
        restrictedLevelMap (id X) f.cutoff
          ⟨n, by
            simpa [HomRepresentative.comp, HomRepresentative.id, Nat.zero_add] using hnf⟩
          x := by
    simpa [y] using hy_base
  have hcomp :
      ((id X).comp f) n hnf x =
        promotedLevelMapAux 0 f
          ⟨n, by
            simpa [HomRepresentative.comp, HomRepresentative.id, Nat.zero_add] using hnf⟩
          y := by
    exact comp_map_apply_of_range_witness (A := A) (I := I)
      (f := id X) (g := f) n hnf x y hy
  -- The auxiliary promoted map at cutoff `0` is exactly the original level map.
  exact hcomp.heq.trans <|
    by
      simpa [hcut, y, Nat.zero_add] using
        promotedLevelMapAux_zero_eq
          (A := A) (I := I) (Y := X) (Z := Y) f
          ⟨n, by
            simpa [HomRepresentative.comp, HomRepresentative.id, Nat.zero_add] using hnf⟩
          y

/-- Helper for Remark 15.101.6: the identity representative is a strict right identity before
passing to the promotion quotient. -/
private theorem comp_id_strict (f : HomRepresentative X Y) :
    f.comp (id Y) = f := by
  -- We choose an explicit representative for the quotient class produced by `restrictedLevelMap`
  -- and use it as the canonical witness for composing with the identity representative.
  have hcut : (f.comp (id Y)).cutoff = f.cutoff := by
    simp [HomRepresentative.comp, HomRepresentative.id]
  refine levelwise_extensionality_cast (f.comp (id Y)) f hcut ?_
  intro n hnf x
  let n₀ : AdmissibleLevel (f.cutoff + 0) := ⟨n, hnf⟩
  let q := restrictedLevelMap f 0 n₀ x
  obtain ⟨y0, hy0⟩ := (torsionSubmodule f.cutoff Y n).mkQ_surjective q
  let y : powerSubmodule 0 Y n := ⟨y0, by simp [powerSubmodule]⟩
  have hy :
      quotientPowerMap f.cutoff 0 Y n y = q := by
    simpa [q, y, quotientPowerMap, LinearMap.comp_apply]
      using hy0
  have hcomp :
      (f.comp (id Y)) n hnf x =
        promotedLevelMapAux f.cutoff (id Y) n₀ y := by
    exact comp_map_apply_of_range_witness (A := A) (I := I)
      (f := f) (g := id Y) n hnf x y hy
  have hid :
      promotedLevelMapAux f.cutoff (id Y) n₀ y =
        quotientPowerMap f.cutoff 0 Y n y := by
    simpa [n₀] using
      promotedLevelMapAux_id_eq
        (A := A) (I := I) (c := f.cutoff) (Y := Y) n₀ y
  have hzero :
      restrictedLevelMap f 0 n₀ x =
        f n (by simpa [Nat.add_zero] using hnf)
          (by simpa [hcut, Nat.add_zero] using x) := by
    simpa [n₀, hcut] using
      restrictedLevelMap_zero_eq (A := A) (I := I) (X := X) (Y := Y) f n₀ x
  -- After identifying the chosen witness with the original quotient class, the promoted identity
  -- formula collapses to the original level map.
  exact (hcomp.trans <| hid.trans <| hy.trans hzero).heq

/-- Helper for Remark 15.101.6: dropping any extra source power before restricting agrees with
restricting directly at the larger cutoff. -/
private theorem restrictedLevelMap_drop_add_cast_eq
    (f : HomRepresentative X Y) (d e : ℕ)
    (n : AdmissibleLevel (f.cutoff + d + e))
    (x : powerSubmodule (f.cutoff + d + e) X n.1) :
    restrictedLevelMap f d
        ⟨n.1, by omega⟩
        (powerSubmoduleInclusion X
          (show f.cutoff + d ≤ f.cutoff + d + e by omega) n.1 x) =
      restrictedLevelMap f (d + e)
        ⟨n.1, by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using n.2⟩
        (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x) := by
  -- We first collapse the two source inclusions to the direct inclusion into cutoff `f.cutoff`,
  -- and then transport across the reassociation `f.cutoff + d + e = f.cutoff + (d + e)`.
  let h₁ : f.cutoff ≤ (n.1 : ℕ) :=
    Nat.le_trans (show f.cutoff ≤ f.cutoff + d + e by omega) n.2
  let h₂ : f.cutoff ≤ (n.1 : ℕ) :=
    Nat.le_trans (show f.cutoff ≤ f.cutoff + (d + e) by omega)
      (by simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using n.2)
  let x' : powerSubmodule (f.cutoff + (d + e)) X n.1 := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x
  have hcomp :
      ((powerSubmoduleInclusion X (Nat.le_add_right f.cutoff d) n.1).comp
        (powerSubmoduleInclusion X
          (show f.cutoff + d ≤ f.cutoff + d + e by omega) n.1)) =
      powerSubmoduleInclusion X
        (show f.cutoff ≤ f.cutoff + d + e by omega) n.1 := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      powerSubmoduleInclusion_comp_eq (A := A) (I := I) (X := X)
        (hcd := Nat.le_add_right f.cutoff d)
        (hde := show f.cutoff + d ≤ f.cutoff + d + e by omega)
        (n := n.1)
  have hleft :
      restrictedLevelMap f d
          ⟨n.1, by omega⟩
          (powerSubmoduleInclusion X
            (show f.cutoff + d ≤ f.cutoff + d + e by omega) n.1 x) =
        f n.1 h₁
          (powerSubmoduleInclusion X
            (show f.cutoff ≤ f.cutoff + d + e by omega) n.1 x) := by
    simpa [restrictedLevelMap, LinearMap.comp_apply, h₁] using
      congrArg (fun φ => f n.1 h₁ (φ x)) hcomp
  have hproof :
      f n.1 h₁
          (powerSubmoduleInclusion X
            (show f.cutoff ≤ f.cutoff + d + e from
              by omega) n.1 x) =
        f n.1 h₂
          (powerSubmoduleInclusion X
            (show f.cutoff ≤ f.cutoff + d + e from
              by omega) n.1 x) := by
    simpa [h₁, h₂] using
      homRepresentative_apply_eq_of_proof_irrel
        (A := A) (I := I) (X := X) (Y := Y) f n.1
        (x := powerSubmoduleInclusion X
          (show f.cutoff ≤ f.cutoff + d + e from
            Nat.le_add_right f.cutoff (d + e)) n.1 x)
  have hright :
      f n.1 h₂
          (powerSubmoduleInclusion X
            (show f.cutoff ≤ f.cutoff + d + e by omega) n.1 x) =
        f n.1 h₂
          (powerSubmoduleInclusion X
            (show f.cutoff ≤ f.cutoff + (d + e) by omega) n.1 x') := by
    have hbase :
        powerSubmoduleInclusion X
            (show f.cutoff ≤ f.cutoff + d + e by omega) n.1 x =
          powerSubmoduleInclusion X
            (show f.cutoff ≤ f.cutoff + (d + e) by omega) n.1 x' := by
      simpa [x', Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
        powerSubmoduleInclusion_base_assoc_cast_eq
          (A := A) (I := I) (X := X) f.cutoff d e n.1 x
    exact congrArg (fun z => f n.1 h₂ z) hbase
  exact hleft.trans <| hproof.trans hright

/-- Helper for Remark 15.101.6: transporting `quotientPowerMap` across an equality of torsion
cutoffs preserves the represented class. -/
private theorem quotientPowerMap_cast_eq_of_cutoff_eq
    (Y : IadicFiniteModuleSystem A I) {c₁ c₂ d : ℕ} (hc : c₁ = c₂)
    (n : ℕ+) (y : powerSubmodule d Y n) :
    cast (by cases hc; rfl) (quotientPowerMap c₁ d Y n y) =
      quotientPowerMap c₂ d Y n y := by
  -- After normalizing the target cutoff equality, the quotient class is definitionally unchanged.
  cases hc
  rfl

/-- Helper for Remark 15.101.6: the same two-stage witnesses `z` and `y` normalize both
associative composites on a fixed level. -/
private theorem comp_assoc_witness_normalization
    (f : HomRepresentative W X) (g : HomRepresentative X Y) (h : HomRepresentative Y Z)
    (n : ℕ+) (hn : (f.cutoff + g.cutoff) + h.cutoff ≤ (n : ℕ))
    (x : powerSubmodule ((f.cutoff + g.cutoff) + h.cutoff) W n) :
    ∃ z : powerSubmodule (g.cutoff + h.cutoff) X n,
      ∃ y : powerSubmodule h.cutoff Y n,
        quotientPowerMap f.cutoff (g.cutoff + h.cutoff) X n z =
            restrictedLevelMap f (g.cutoff + h.cutoff)
              ⟨n, by
                simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
              (by
                simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x) ∧
          quotientPowerMap g.cutoff h.cutoff Y n y =
            restrictedLevelMap g h.cutoff
              ⟨n, by omega⟩
              z ∧
          quotientPowerMap (f.cutoff + g.cutoff) h.cutoff Y n y =
            restrictedLevelMap (f.comp g) h.cutoff ⟨n, hn⟩ x := by
  let hn_fg_h : f.cutoff + (g.cutoff + h.cutoff) ≤ (n : ℕ) := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn
  let x_fg_h : powerSubmodule (f.cutoff + (g.cutoff + h.cutoff)) W n := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x
  -- First choose the intermediate witness `z` for the right-associated source restriction.
  obtain ⟨z, hz⟩ :=
    representativeImage_mem_quotientPowerRange
      (A := A) (I := I) (f := f) (d := g.cutoff + h.cutoff)
      ⟨n, hn_fg_h⟩ x_fg_h
  let hn_gh : g.cutoff + h.cutoff ≤ (n : ℕ) := by
    omega
  -- Then choose the witness `y` for the restriction of `g` on that intermediate class.
  obtain ⟨y, hy⟩ :=
    representativeImage_mem_quotientPowerRange
      (A := A) (I := I) (f := g) (d := h.cutoff)
      ⟨n, hn_gh⟩ z
  let x_fg : powerSubmodule (f.cutoff + g.cutoff) W n :=
    powerSubmoduleInclusion W
      (show f.cutoff + g.cutoff ≤ (f.cutoff + g.cutoff) + h.cutoff by omega) n x
  let z_g : powerSubmodule g.cutoff X n :=
    powerSubmoduleInclusion X
      (show g.cutoff ≤ g.cutoff + h.cutoff by omega) n z
  have hz_fg :
      quotientPowerMap f.cutoff g.cutoff X n z_g =
        restrictedLevelMap f g.cutoff
          ⟨n, by omega⟩
          x_fg := by
    -- We drop the extra `h.cutoff` source power from the right-associated witness `z`.
    calc
      quotientPowerMap f.cutoff g.cutoff X n z_g
          = quotientPowerMap f.cutoff (g.cutoff + h.cutoff) X n z := by
              simpa [z_g] using
                quotientPowerMap_inclusion_add_eq
                  (A := A) (I := I)
                  (c := f.cutoff) (d := g.cutoff) (e := h.cutoff) X n z
      _ = restrictedLevelMap f (g.cutoff + h.cutoff) ⟨n, hn_fg_h⟩ x_fg_h := hz
      _ = restrictedLevelMap f g.cutoff
            ⟨n, by omega⟩
            x_fg := by
              symm
              simpa [x_fg, x_fg_h, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
                restrictedLevelMap_drop_add_cast_eq
                  (A := A) (I := I) (X := W) (Y := X)
                  f g.cutoff h.cutoff ⟨n, hn⟩ x
  let hn_fg : f.cutoff + g.cutoff ≤ (n : ℕ) := by
    omega
  have hcomp_fg :
      (f.comp g) n hn_fg x_fg =
        promotedLevelMapAux f.cutoff g ⟨n, hn_fg⟩ z_g := by
    -- The chosen witness `z_g` computes the intermediate composite `f.comp g`.
    exact
      comp_map_apply_of_range_witness
        (A := A) (I := I)
        (f := f) (g := g) n hn_fg x_fg z_g hz_fg
  let hg : g.cutoff ≤ (n : ℕ) :=
    Nat.le_trans (Nat.le_add_left g.cutoff f.cutoff) hn_fg
  have hy_apply :
      quotientPowerMap g.cutoff h.cutoff Y n y =
        (g n hg) z_g := by
    -- We rewrite the restricted map of `g` on `z` as evaluation on the dropped witness `z_g`.
    have hproof :
        (g n (Nat.le_trans (Nat.le_add_right g.cutoff h.cutoff) hn_gh)) z_g =
          (g n hg) z_g := by
      simpa [hg] using
        homRepresentative_apply_eq_of_proof_irrel
          (A := A) (I := I) (X := X) (Y := Y) g n
          (h₁ := Nat.le_trans (Nat.le_add_right g.cutoff h.cutoff) hn_gh)
          (h₂ := hg)
          z_g
    calc
      quotientPowerMap g.cutoff h.cutoff Y n y
          = restrictedLevelMap g h.cutoff ⟨n, hn_gh⟩ z := hy
      _ = (g n (Nat.le_trans (Nat.le_add_right g.cutoff h.cutoff) hn_gh)) z_g := by
            rfl
      _ = (g n hg) z_g := hproof
  have htransition :
      (torsionQuotientMap Y (Nat.le_add_left g.cutoff f.cutoff) n)
          (quotientPowerMap g.cutoff h.cutoff Y n y) =
        quotientPowerMap (f.cutoff + g.cutoff) h.cutoff Y n y := by
    -- We first compute the transition through cutoff `g.cutoff + f.cutoff`, then transport it
    -- across commutativity of addition to the target cutoff `f.cutoff + g.cutoff`.
    have hgf :
        cast (by
          simp [torsionQuotient, Nat.add_comm])
          ((torsionQuotientMap Y
              (show g.cutoff ≤ g.cutoff + f.cutoff by omega) n)
            (quotientPowerMap g.cutoff h.cutoff Y n y)) =
          quotientPowerMap (f.cutoff + g.cutoff) h.cutoff Y n y := by
      have hraw :
          (torsionQuotientMap Y
              (show g.cutoff ≤ g.cutoff + f.cutoff by omega) n)
            (quotientPowerMap g.cutoff h.cutoff Y n y) =
            quotientPowerMap (g.cutoff + f.cutoff) h.cutoff Y n y := by
        simpa [LinearMap.comp_apply] using
          congrArg
            (fun φ => φ y)
            (torsionQuotientMap_comp_quotientPowerMap_eq
              (A := A) (I := I)
              (c := g.cutoff) (c' := f.cutoff) (d := h.cutoff) Y n)
      calc
        cast (by
          simp [torsionQuotient, Nat.add_comm])
            ((torsionQuotientMap Y
                (show g.cutoff ≤ g.cutoff + f.cutoff by omega) n)
              (quotientPowerMap g.cutoff h.cutoff Y n y)) =
            cast (by
              simp [torsionQuotient, Nat.add_comm])
              (quotientPowerMap (g.cutoff + f.cutoff) h.cutoff Y n y) := by
                exact
                  congrArg
                    (cast (by
                      simp [torsionQuotient, Nat.add_comm]))
                    hraw
        _ = quotientPowerMap (f.cutoff + g.cutoff) h.cutoff Y n y := by
              simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
                quotientPowerMap_cast_eq_of_cutoff_eq
                  (A := A) (I := I) Y
                  (hc := Nat.add_comm g.cutoff f.cutoff) n y
    have hcast :
        cast (by
          simp [torsionQuotient, Nat.add_comm])
          ((torsionQuotientMap Y
              (show g.cutoff ≤ g.cutoff + f.cutoff by omega) n)
            (quotientPowerMap g.cutoff h.cutoff Y n y)) =
          (torsionQuotientMap Y (Nat.le_add_left g.cutoff f.cutoff) n)
            (quotientPowerMap g.cutoff h.cutoff Y n y) := by
      exact
        torsionQuotientMap_cast_eq_of_cutoff_eq
          (A := A) (I := I) (Z := Y)
          (hd := Nat.add_comm g.cutoff f.cutoff)
          (show g.cutoff ≤ g.cutoff + f.cutoff by omega)
          (Nat.le_add_left g.cutoff f.cutoff)
          n
          (quotientPowerMap g.cutoff h.cutoff Y n y)
    exact hcast.symm.trans hgf
  have hprom :
      quotientPowerMap (f.cutoff + g.cutoff) h.cutoff Y n y =
        promotedLevelMapAux f.cutoff g ⟨n, hn_fg⟩ z_g := by
    -- Applying the outer torsion transition to the `g`-witness recovers the promoted map.
    calc
      quotientPowerMap (f.cutoff + g.cutoff) h.cutoff Y n y
          = (torsionQuotientMap Y (Nat.le_add_left g.cutoff f.cutoff) n)
              (quotientPowerMap g.cutoff h.cutoff Y n y) := by
                symm
                exact htransition
      _ = (torsionQuotientMap Y (Nat.le_add_left g.cutoff f.cutoff) n)
            ((g n hg) z_g) := by
              rw [hy_apply]
      _ = promotedLevelMapAux f.cutoff g ⟨n, hn_fg⟩ z_g := by
            rfl
  refine ⟨z, y, hz, hy, ?_⟩
  -- The same witness `y` computes the left-associated restriction of `f.comp g`.
  calc
    quotientPowerMap (f.cutoff + g.cutoff) h.cutoff Y n y
        = promotedLevelMapAux f.cutoff g ⟨n, hn_fg⟩ z_g := hprom
    _ = (f.comp g) n hn_fg x_fg := hcomp_fg.symm
    _ = restrictedLevelMap (f.comp g) h.cutoff ⟨n, hn⟩ x := by
          rfl

/-- Helper for Remark 15.101.6: after transporting along `Nat.add_assoc`, the two explicit
promotion normal forms agree as ordinary equalities. -/
private theorem promotedLevelMapAux_assoc_transition_cast_eq
    (f : HomRepresentative W X) (g : HomRepresentative X Y) (h : HomRepresentative Y Z)
    (n : ℕ+) (hn : (f.cutoff + g.cutoff) + h.cutoff ≤ (n : ℕ))
    {z : powerSubmodule (g.cutoff + h.cutoff) X n}
    {y : powerSubmodule h.cutoff Y n}
    (hy : quotientPowerMap g.cutoff h.cutoff Y n y =
      restrictedLevelMap g h.cutoff ⟨n, by omega⟩ z) :
    cast (by
      simp [torsionQuotient, HomRepresentative.comp,
        Nat.add_left_comm, Nat.add_comm])
      (promotedLevelMapAux (f.cutoff + g.cutoff) h ⟨n, hn⟩ y) =
        promotedLevelMapAux f.cutoff (g.comp h)
          ⟨n, by
            simpa [HomRepresentative.comp,
              Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
          z := by
  let hn_gh : g.cutoff + h.cutoff ≤ (n : ℕ) := by
    omega
  let hh_left : h.cutoff ≤ (n : ℕ) :=
    Nat.le_trans (Nat.le_add_left h.cutoff (f.cutoff + g.cutoff)) hn
  let hh_inner : h.cutoff ≤ (n : ℕ) :=
    Nat.le_trans (Nat.le_add_left h.cutoff g.cutoff) hn_gh
  let hn_right : f.cutoff + (g.cutoff + h.cutoff) ≤ (n : ℕ) := by
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn
  let hg_comp : (g.comp h).cutoff ≤ (n : ℕ) := by
    simpa [HomRepresentative.comp] using hn_gh
  have hh_eq :
      (h n hh_inner) y =
        (h n hh_left) y := by
    simpa [hh_left, hh_inner] using
      homRepresentative_apply_eq_of_proof_irrel
        (A := A) (I := I) (X := Y) (Y := Z) h n
        (h₁ := hh_inner) (h₂ := hh_left) y
  have hinner :
      (g.comp h) n hg_comp z =
        promotedLevelMapAux g.cutoff h ⟨n, hn_gh⟩ y := by
    -- The chosen witness `y` computes the composite `g.comp h` on `z`.
    exact
      comp_map_apply_of_range_witness
        (A := A) (I := I)
        (f := g) (g := h) n hn_gh z y hy
  have hcast_left :
      cast (by
        simp [torsionQuotient, Nat.add_left_comm, Nat.add_comm])
        (promotedLevelMapAux (f.cutoff + g.cutoff) h ⟨n, hn⟩ y) =
          (torsionQuotientMap Z
            (show h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
            ((h n hh_left) y) := by
    -- The only change on the left is the codomain transport from `((f + g) + h)` to
    -- `f + (g + h)`.
    exact
      torsionQuotientMap_cast_eq_of_cutoff_eq
        (A := A) (I := I) (Z := Z)
        (hd := Nat.add_assoc f.cutoff g.cutoff h.cutoff)
        (Nat.le_add_left h.cutoff (f.cutoff + g.cutoff))
        (show h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega)
        n
        ((h n hh_left) y)
  have hcomp :
      (torsionQuotientMap Z
          (show g.cutoff + h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n).comp
        (torsionQuotientMap Z (Nat.le_add_left h.cutoff g.cutoff) n) =
        torsionQuotientMap Z
          (show h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n := by
    -- The right-associated two-step torsion transition is the direct transition from `h.cutoff`.
    simpa [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      torsionQuotientMap_comp_eq
        (A := A) (I := I) (X := Z)
        (hcd := Nat.le_add_left h.cutoff g.cutoff)
        (hde := Nat.le_add_left (g.cutoff + h.cutoff) f.cutoff)
        (n := n)
  have hcomp_apply :
      (torsionQuotientMap Z
          (show h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
          ((h n hh_left) y) =
        (torsionQuotientMap Z
            (show g.cutoff + h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
          ((torsionQuotientMap Z (Nat.le_add_left h.cutoff g.cutoff) n)
            ((h n hh_left) y)) := by
    -- We evaluate the composite transition on the same representative of `h_n(y)`.
    symm
    simpa [LinearMap.comp_apply] using
      congrArg (fun φ => φ ((h n hh_left) y)) hcomp
  have hright_inner :
      promotedLevelMapAux g.cutoff h ⟨n, hn_gh⟩ y =
        (torsionQuotientMap Z (Nat.le_add_left h.cutoff g.cutoff) n)
          ((h n hh_left) y) := by
    -- The inner promoted map only depends on the value of `h_n(y)`, so we replace the proof of
    -- admissibility by proof irrelevance.
    change
      (torsionQuotientMap Z (Nat.le_add_left h.cutoff g.cutoff) n)
        ((h n hh_inner) y) =
        (torsionQuotientMap Z (Nat.le_add_left h.cutoff g.cutoff) n)
          ((h n hh_left) y)
    rw [hh_eq]
  have hright :
      promotedLevelMapAux f.cutoff (g.comp h) ⟨n, hn_right⟩ z =
        (torsionQuotientMap Z
            (show g.cutoff + h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
          ((torsionQuotientMap Z (Nat.le_add_left h.cutoff g.cutoff) n)
            ((h n hh_left) y)) := by
    -- After computing `g.comp h` on `z`, the right-associated normal form becomes the same
    -- two-step transition chain.
    calc
      promotedLevelMapAux f.cutoff (g.comp h) ⟨n, hn_right⟩ z
          = (torsionQuotientMap Z
              (show g.cutoff + h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
              ((g.comp h) n hg_comp z) := by
                rfl
      _ = (torsionQuotientMap Z
            (show g.cutoff + h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
            (promotedLevelMapAux g.cutoff h ⟨n, hn_gh⟩ y) := by
              rw [hinner]
      _ = (torsionQuotientMap Z
            (show g.cutoff + h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
            ((torsionQuotientMap Z (Nat.le_add_left h.cutoff g.cutoff) n)
              ((h n hh_left) y)) := by
                rw [hright_inner]
  -- Both sides now reduce to the same two-step torsion transition chain.
  calc
    cast (by
      simp [torsionQuotient, Nat.add_left_comm, Nat.add_comm])
      (promotedLevelMapAux (f.cutoff + g.cutoff) h ⟨n, hn⟩ y)
        = (torsionQuotientMap Z
            (show h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
            ((h n hh_left) y) := hcast_left
    _ = (torsionQuotientMap Z
          (show g.cutoff + h.cutoff ≤ f.cutoff + (g.cutoff + h.cutoff) by omega) n)
          ((torsionQuotientMap Z (Nat.le_add_left h.cutoff g.cutoff) n)
            ((h n hh_left) y)) := hcomp_apply
    _ = promotedLevelMapAux f.cutoff (g.comp h) ⟨n, hn_right⟩ z := hright.symm

/-- Helper for Remark 15.101.6: the associativity normal-form comparison above is the `HEq`
needed by `levelwise_extensionality_cast`. -/
private theorem promotedLevelMapAux_assoc_transition_heq
    (f : HomRepresentative W X) (g : HomRepresentative X Y) (h : HomRepresentative Y Z)
    (n : ℕ+) (hn : (f.cutoff + g.cutoff) + h.cutoff ≤ (n : ℕ))
    {z : powerSubmodule (g.cutoff + h.cutoff) X n}
    {y : powerSubmodule h.cutoff Y n}
    (hy : quotientPowerMap g.cutoff h.cutoff Y n y =
      restrictedLevelMap g h.cutoff ⟨n, by omega⟩ z) :
    HEq
      (promotedLevelMapAux (f.cutoff + g.cutoff) h ⟨n, hn⟩ y)
      (promotedLevelMapAux f.cutoff (g.comp h)
        ⟨n, by
          simpa [HomRepresentative.comp,
            Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn⟩
        z) := by
  -- We first align the codomain by an explicit cast equality and then convert that equality to
  -- the heterogeneous form consumed by `levelwise_extensionality_cast`.
  exact heq_of_cast_eq _ <|
    promotedLevelMapAux_assoc_transition_cast_eq
      (A := A) (I := I) f g h n hn hy

/-- Helper for Remark 15.101.6: representative composition is strictly associative before
quotienting by promotion. -/
private theorem comp_assoc_strict
    (f : HomRepresentative W X) (g : HomRepresentative X Y) (h : HomRepresentative Y Z) :
    (f.comp g).comp h = f.comp (g.comp h) := by
  -- Route correction: we compare both triple composites on one level using the same witnesses
  -- `z` and `y`, then isolate the only non-definitional issue as the final `Nat.add_assoc` cast.
  have hcut : ((f.comp g).comp h).cutoff = (f.comp (g.comp h)).cutoff := by
    simp [HomRepresentative.comp, Nat.add_left_comm, Nat.add_comm]
  refine levelwise_extensionality_cast ((f.comp g).comp h) (f.comp (g.comp h)) hcut ?_
  intro n hn x
  let hn_right : f.cutoff + (g.cutoff + h.cutoff) ≤ (n : ℕ) := by
    simpa [HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using hn
  let x_right : powerSubmodule (f.cutoff + (g.cutoff + h.cutoff)) W n := by
    simpa [HomRepresentative.comp, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using x
  obtain ⟨z, y, hz, hy, hy_left⟩ :=
    comp_assoc_witness_normalization
      (A := A) (I := I) (W := W) (X := X) (Y := Y) (Z := Z)
      f g h n hn x
  have hleft :
      ((f.comp g).comp h) n hn x =
        promotedLevelMapAux (f.cutoff + g.cutoff) h ⟨n, hn⟩ y := by
    -- The left-associated composite is computed by the same witness `y`.
    exact
      comp_map_apply_of_range_witness
        (A := A) (I := I)
        (f := f.comp g) (g := h) n hn x y hy_left
  have hright :
      (f.comp (g.comp h)) n
          hn_right
          x_right =
        promotedLevelMapAux f.cutoff (g.comp h)
          ⟨n, hn_right⟩
          z := by
    -- The right-associated composite is computed by the witness `z`.
    exact
      comp_map_apply_of_range_witness
        (A := A) (I := I)
        (f := f) (g := g.comp h) n hn_right x_right z hz
  have htransition :
      HEq
        (promotedLevelMapAux (f.cutoff + g.cutoff) h ⟨n, hn⟩ y)
        (promotedLevelMapAux f.cutoff (g.comp h)
          ⟨n, hn_right⟩
          z) := by
    -- The explicit left and right normal forms differ only by the final reassociation cast.
    exact
      promotedLevelMapAux_assoc_transition_heq
        (A := A) (I := I) (W := W) (X := X) (Y := Y) (Z := Z)
        f g h n hn hy
  exact hleft.heq.trans <| htransition.trans hright.heq.symm

/-- The composite of representatives is compatible with promotion in the source variable. -/
private theorem comp_congr_left
    {f₁ f₂ : HomRepresentative X Y} (h : f₁ ≈ f₂)
    (g : HomRepresentative Y Z) :
    f₁.comp g ≈ f₂.comp g := by
  -- We transport each generating promotion step across composition on the right.
  induction h with
  | rel a b hab =>
      rcases hab with rfl
      rw [comp_successor_left_eq]
      exact Relation.EqvGen.rel _ _ rfl
  | refl a =>
      exact Relation.EqvGen.refl (a.comp g)
  | symm a b hab ih =>
      exact Relation.EqvGen.symm _ _ ih
  | trans a b c hab hbc ihab ihbc =>
      exact Relation.EqvGen.trans _ _ _ ihab ihbc

/-- The composite of representatives is compatible with promotion in the target variable. -/
private theorem comp_congr_right
    (f : HomRepresentative X Y) {g₁ g₂ : HomRepresentative Y Z}
    (h : g₁ ≈ g₂) :
    f.comp g₁ ≈ f.comp g₂ := by
  -- We transport each generating promotion step across composition on the left.
  induction h with
  | rel a b hab =>
      rcases hab with rfl
      rw [comp_successor_right_eq]
      exact Relation.EqvGen.rel _ _ rfl
  | refl a =>
      exact Relation.EqvGen.refl (f.comp a)
  | symm a b hab ih =>
      exact Relation.EqvGen.symm _ _ ih
  | trans a b c hab hbc ihab ihbc =>
      exact Relation.EqvGen.trans _ _ _ ihab ihbc

/-- The identity representative acts as a left identity up to the promotion relation. -/
private theorem id_comp_rel (f : HomRepresentative X Y) :
    (id X).comp f ≈ f := by
  -- The strict computation is a special case of the generated equivalence relation.
  simpa [id_comp_strict (A := A) (I := I) f] using (Relation.EqvGen.refl f)

/-- The identity representative acts as a right identity up to the promotion relation. -/
private theorem comp_id_rel (f : HomRepresentative X Y) :
    f.comp (id Y) ≈ f := by
  -- The strict computation is a special case of the generated equivalence relation.
  simpa [comp_id_strict (A := A) (I := I) f] using (Relation.EqvGen.refl f)

/-- Composition of representatives is associative up to the promotion relation. -/
private theorem comp_assoc_rel
    (f : HomRepresentative W X) (g : HomRepresentative X Y) (h : HomRepresentative Y Z) :
    (f.comp g).comp h ≈ f.comp (g.comp h) := by
  -- The strict associativity computation immediately gives the relation-level statement.
  simpa [comp_assoc_strict (A := A) (I := I) f g h] using
    (Relation.EqvGen.refl (f.comp (g.comp h)))

private theorem id_comp_eq (f : HomRepresentative X Y) :
    (id X).comp f = f := by
  -- This is exactly the strict left-identity computation.
  exact id_comp_strict (A := A) (I := I) f

private theorem comp_id_eq (f : HomRepresentative X Y) :
    f.comp (id Y) = f := by
  -- This is exactly the strict right-identity computation.
  exact comp_id_strict (A := A) (I := I) f

private theorem comp_assoc_eq
    (f : HomRepresentative W X) (g : HomRepresentative X Y) (h : HomRepresentative Y Z) :
    (f.comp g).comp h = f.comp (g.comp h) := by
  -- This is exactly the strict associativity computation.
  exact comp_assoc_strict (A := A) (I := I) f g h

private abbrev Representative (A : Type u) [CommRing A] (I : Ideal A) :=
  IadicFiniteModuleSystem A I

private instance representativeCategory (A : Type u) [CommRing A] (I : Ideal A) :
    Category (Representative A I) where
  Hom X Y := HomRepresentative X Y
  id := id
  comp f g := comp f g
  id_comp := by
    intro X Y f
    exact id_comp_eq f
  comp_id := by
    intro X Y f
    exact comp_id_eq f
  assoc := by
    intro W X Y Z f g h
    exact comp_assoc_eq f g h

/-- The congruence on representative morphisms generated by one-step promotion. -/
def relation (A : Type u) [CommRing A] (I : Ideal A) :
    HomRel (IadicFiniteModuleSystem A I) :=
  fun _ _ f g ↦ Relation.EqvGen promotesTo f g

instance relation_congruence (A : Type u) [CommRing A] (I : Ideal A) :
    Congruence (relation A I) where
  equivalence := by
    intro X Y
    refine
      { refl := fun f ↦ by
          simpa [relation] using (Relation.EqvGen.refl f)
        symm := fun h ↦ by
          simpa [relation] using (Relation.EqvGen.symm _ _ h)
        trans := fun h₁ h₂ ↦ by
          simpa [relation] using (Relation.EqvGen.trans _ _ _ h₁ h₂) }
  comp_left := by
    intro _ _ _ f _ _ h
    simpa [relation] using comp_congr_right f h
  comp_right := by
    intro _ _ _ _ _ g h
    simpa [relation] using comp_congr_left h g

end HomRepresentative

open HomRepresentative

/-- Remark 15.101.6: finite `A/I^n`-module systems form a category whose morphisms are
equivalence classes of representatives under promotion. Lean realizes this category as the
canonical quotient of the representative category by the congruence `HomRepresentative.relation`. -/
abbrev Category (A : Type u) [CommRing A] (I : Ideal A) :=
  CategoryTheory.Quotient (HomRepresentative.relation A I)

namespace Category

/-- The canonical quotient functor from raw representatives to the quotient category of Remark
15.101.6. -/
abbrev quotient (A : Type u) [CommRing A] (I : Ideal A) :
    IadicFiniteModuleSystem A I ⥤ IadicFiniteModuleSystem.Category A I :=
  CategoryTheory.Quotient.functor (HomRepresentative.relation A I)

/-- The image of a finite module system in the quotient category has the same underlying object. -/
theorem quotient_obj_as (X : IadicFiniteModuleSystem A I) :
    ((quotient A I).obj X).as = X :=
  rfl

end Category

end IadicFiniteModuleSystem
