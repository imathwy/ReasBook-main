import Mathlib
import StacksProject_2024.stacks_project.Chap10.Definition_10_69_1
import StacksProject_2024.stacks_project.Chap15.Definition_15_30_1
import StacksProject_2024.stacks_project.Chap15.Lemma_15_30_3

-- Declarations for this item will be appended below by the statement pipeline.

universe u

namespace Ideal

/-- Helper for Lemma 15.30.15: for a finite family, the ideal generated by the associated list is
the span of the indexed family. -/
private theorem ofList_ofFn_eq_span_range {A : Type u} [CommRing A] {n : ℕ} (f : Fin n → A) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  ext x
  simp [Ideal.ofList, List.mem_ofFn', Set.range]

/-- Helper for Lemma 15.30.15: equality of the spans of two finite families is equivalent to
equality of the ideals generated by their associated lists. -/
private theorem ofList_ofFn_eq_of_span_eq {A : Type u} [CommRing A] {n : ℕ}
    (f g : Fin n → A) (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g)) :
    Ideal.ofList (List.ofFn f) = Ideal.ofList (List.ofFn g) := by
  -- Proof comment: rewrite both list-generated ideals as spans of the indexed ranges and use the
  -- assumed equality of spans.
  rw [ofList_ofFn_eq_span_range, ofList_ofFn_eq_span_range, hspan]

end Ideal

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R]

open scoped Matrix TensorProduct

/- Domain triage:
* primary domain: finite regularity conditions in commutative algebra that depend only on the ideal
  generated by a finite family;
* sampled owner declarations: `IsQuasiRegularSequence`, `IsH1RegularSequence`,
  `IsKoszulRegularSequence`, and the canonical bridge `Ideal.ofList_ofFn_eq_span_range`;
* best owner abstraction: the regularity predicates above are the owner-level notions, while
  `Ideal.ofList (List.ofFn f)` is the canonical list-side ideal attached to a finite family;
* primitive data vs derived API: the primitive source data are just the two families `f`, `g`, and
  the equality of the ideals they generate; rewriting between the list-side owner ideal and the
  source-facing span ideal is derived bridge data, so it should be reused from the chapter owner
  theorem rather than reproved locally.
-/

section

variable {r : ℕ} (f g : Fin r → R)

/-- Helper for Lemma 15.30.15: if two finite families generate the same ideal, then one family is
obtained from the other by a square change-of-generators matrix. -/
private theorem generator_change_matrix_of_span_eq
    (hspan : Ideal.span (Set.range f) = Ideal.span (Set.range g)) :
    ∃ A : Matrix (Fin r) (Fin r) R, g = A.toLin' f := by
  -- Proof comment: each generator `g i` lies in the span of the `f j`, so finite generation by a
  -- `Fin r`-indexed family gives an explicit coefficient row.
  choose row hrow using fun i ↦
    Ideal.mem_span_range_iff_exists_fun.mp <| by
      have hmem : g i ∈ Ideal.span (Set.range f) := by
        rw [hspan]
        exact Ideal.subset_span (Set.mem_range_self i)
      exact hmem
  refine ⟨Matrix.of fun i j ↦ row i j, ?_⟩
  -- Proof comment: assembling the chosen coefficient rows gives the required matrix identity.
  ext i
  simpa [Matrix.toLin'_apply, Matrix.mulVec, dotProduct] using (hrow i).symm

/-- Helper for Lemma 15.30.15: an element of the annihilator acts as the zero endomorphism. -/
private theorem smul_end_eq_zero_of_mem_annihilator
    {M : Type u} [AddCommGroup M] [Module R M] {a : R}
    (ha : a ∈ Module.annihilator R M) :
    a • (1 : Module.End R M) = 0 := by
  -- Proof comment: evaluate the scalar endomorphism on an arbitrary element and unfold the
  -- annihilator membership.
  ext x
  exact Module.mem_annihilator.mp ha x

/-- Helper for Lemma 15.30.15: a scalar whose class is a unit modulo an annihilating ideal acts
invertibly on the whole module. -/
private theorem isUnit_smul_end_of_isUnit_quotient_of_le_annihilator
    {M : Type u} [AddCommGroup M] [Module R M] {I : Ideal R} {a : R}
    (hI : I ≤ Module.annihilator R M)
    (ha : IsUnit (Ideal.Quotient.mk I a)) :
    IsUnit (a • (1 : Module.End R M)) := by
  let u : Units (R ⧸ I) := ha.unit
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (↑(u⁻¹) : R ⧸ I)
  refine ⟨⟨a • (1 : Module.End R M), b • (1 : Module.End R M), ?_, ?_⟩, rfl⟩
  · ext x
    -- Proof comment: the quotient inverse relation says `ab - 1 ∈ I`, hence it annihilates `x`.
    have hab_mem : a * b - 1 ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      calc
        Ideal.Quotient.mk I (a * b - 1)
            = Ideal.Quotient.mk I a * Ideal.Quotient.mk I b - 1 := by
                simp
        _ = (u : R ⧸ I) * ↑(u⁻¹) - 1 := by
                simp [u, hb]
        _ = 0 := by simp
    have hab_ann : a * b - 1 ∈ Module.annihilator R M := hI hab_mem
    have hab_zero : (a * b - 1) • x = 0 := Module.mem_annihilator.mp hab_ann x
    have hab_eq : (a * b) • x = x := by
      rw [sub_smul, one_smul] at hab_zero
      exact sub_eq_zero.mp hab_zero
    -- Proof comment: after rewriting the composite scalar action as multiplication by `ab`,
    -- the annihilator relation gives the identity action.
    change a • (b • x) = x
    simpa [smul_smul, mul_comm, mul_left_comm, mul_assoc] using hab_eq
  · ext x
    -- Proof comment: the symmetric quotient inverse relation gives `ba - 1 ∈ I` as well.
    have hba_mem : b * a - 1 ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      calc
        Ideal.Quotient.mk I (b * a - 1)
            = Ideal.Quotient.mk I b * Ideal.Quotient.mk I a - 1 := by
                simp
        _ = ↑(u⁻¹) * (u : R ⧸ I) - 1 := by
                simp [u, hb]
        _ = 0 := by simp
    have hba_ann : b * a - 1 ∈ Module.annihilator R M := hI hba_mem
    have hba_zero : (b * a - 1) • x = 0 := Module.mem_annihilator.mp hba_ann x
    have hba_eq : (b * a) • x = x := by
      rw [sub_smul, one_smul] at hba_zero
      exact sub_eq_zero.mp hba_zero
    -- Proof comment: this gives the reverse inverse relation on endomorphisms.
    change b • (a • x) = x
    simpa [smul_smul, mul_comm, mul_left_comm, mul_assoc] using hba_eq

/-- Helper for Lemma 15.30.15: each member of a finite family lies in the ideal generated by the
associated list. -/
private theorem generator_mem_ofList_ofFn (s : Fin r → R) (i : Fin r) :
    s i ∈ Ideal.ofList (List.ofFn s) := by
  -- Proof comment: the `i`th generator belongs to the span of the family by construction.
  rw [Ideal.ofList_ofFn_eq_span_range]
  exact Ideal.subset_span (Set.mem_range_self i)

/-- Helper for Lemma 15.30.15: in degree `1`, the associated-graded stage of an ideal is the
ideal itself. -/
private theorem idealAssociatedGradedStage_one_eq (J : Ideal R) :
    idealAssociatedGradedStage J R 1 = J := by
  -- Proof comment: for the regular module `R`, the first stage `J • R` is exactly `J`.
  ext x
  change x ∈ ((J ^ 1) • (⊤ : Submodule R R)) ↔ x ∈ J
  simp

/-- Helper for Lemma 15.30.15: after identifying the degree-`1` stage with `J`, the degree-`2`
substage becomes `J²` inside `J`. -/
private theorem idealAssociatedGradedStage_two_map_eq (J : Ideal R) :
    Submodule.map
      (LinearEquiv.ofEq
        (idealAssociatedGradedStage J R 1)
        J
        (idealAssociatedGradedStage_one_eq (R := R) J)).toLinearMap
      ((idealAssociatedGradedStage J R 2).submoduleOf
        (idealAssociatedGradedStage J R 1)) =
      (J • (⊤ : Submodule R J)) := by
  -- Proof comment: the degree-`2` stage is `J²`, which is exactly the denominator defining the
  -- cotangent module `J / J²`.
  ext x
  constructor
  · rintro ⟨y, hy, rfl⟩
    rw [Submodule.mem_smul_top_iff]
    change
      (((y : idealAssociatedGradedStage J R 1) : R) ∈
        idealAssociatedGradedStage J R 2) at hy
    simpa [idealAssociatedGradedStage, pow_two] using hy
  · intro hx
    rw [Submodule.mem_smul_top_iff] at hx
    refine ⟨
      ((LinearEquiv.ofEq
        (idealAssociatedGradedStage J R 1)
        J
        (idealAssociatedGradedStage_one_eq (R := R) J)).symm x),
      ?_,
      ?_⟩
    · change
        ((((LinearEquiv.ofEq
          (idealAssociatedGradedStage J R 1)
          J
          (idealAssociatedGradedStage_one_eq (R := R) J)).symm x :
            idealAssociatedGradedStage J R 1) : R) ∈
          idealAssociatedGradedStage J R 2)
      simpa [idealAssociatedGradedStage, pow_two] using hx
    · ext
      rfl

/-- Helper for Lemma 15.30.15: the cotangent module `J / J²` is the degree-`1` associated-graded
piece. -/
private noncomputable def cotangent_equiv_degree_one_piece_over_base (J : Ideal R) :
    J.Cotangent ≃ₗ[R] idealAssociatedGradedPiece J R 1 := by
  -- Proof comment: rewrite the degree-`1` stage as `J`, identify the transported denominator with
  -- `J²`, and compare the two quotient presentations directly.
  let eStage : idealAssociatedGradedStage J R 1 ≃ₗ[R] J :=
    LinearEquiv.ofEq _ _ (idealAssociatedGradedStage_one_eq (R := R) J)
  let eQuot :
      (idealAssociatedGradedStage J R 1 ⧸
        (idealAssociatedGradedStage J R 2).submoduleOf
          (idealAssociatedGradedStage J R 1)) ≃ₗ[R]
        J ⧸ (J • (⊤ : Submodule R J)) :=
    Submodule.Quotient.equiv _ _ eStage
      (idealAssociatedGradedStage_two_map_eq (R := R) J)
  exact eQuot.symm

/-- Helper for Lemma 15.30.15: the chosen generators define the canonical base-linear map from
`R^r` to the cotangent module of their ideal. -/
private noncomputable abbrev cotangent_family_map_over_base (s : Fin r → R) :
    (Fin r → R) →ₗ[R] (Ideal.ofList (List.ofFn s)).Cotangent :=
  Fintype.linearCombination R fun i ↦
    (Ideal.ofList (List.ofFn s)).toCotangent
      ⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩

/-- Helper for Lemma 15.30.15: if a finite family generates an ideal, its cotangent classes span
the cotangent module already over the base ring. -/
private theorem cotangent_family_map_over_base_surjective (s : Fin r → R) :
    Function.Surjective (cotangent_family_map_over_base (R := R) s) := by
  let J : Ideal R := Ideal.ofList (List.ofFn s)
  intro z
  obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective J z
  have hy_span : (y : R) ∈ Ideal.span (Set.range s) := by
    simpa [J, Ideal.ofList_ofFn_eq_span_range] using y.property
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy_span
  refine ⟨c, ?_⟩
  have hy_eq : ∑ i, c i • (⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ : J) = y := by
    ext
    simpa [J] using hc
  -- Proof comment: rewrite the chosen representative of the cotangent class as an explicit linear
  -- combination of the generator classes and evaluate the canonical map on that coefficient vector.
  calc
    cotangent_family_map_over_base (R := R) s c
        = ∑ i, c i • J.toCotangent
            (⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ : J) := by
              simp [cotangent_family_map_over_base, J, Fintype.linearCombination_apply]
    _ = J.toCotangent (∑ i, c i • (⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ : J)) := by
          symm
          calc
            J.toCotangent (∑ i, c i • (⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ : J)) =
                ∑ i, J.toCotangent (c i • (⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ : J)) := by
                  simp
            _ = ∑ i, c i • J.toCotangent
                  (⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ : J) := by
                    refine Finset.sum_congr rfl ?_
                    intro i _
                    exact J.toCotangent.map_smul (c i)
                      (⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ : J)
    _ = J.toCotangent y := by rw [hy_eq]

/-- Helper for Lemma 15.30.15: the quotient-ring action on a cotangent module is computed by
ambient representatives. -/
private theorem cotangent_quotient_smul_eq
    (J : Ideal R) (a : R) (x : J.Cotangent) :
    ((Ideal.Quotient.mk J a : R ⧸ J) • x) = a • x := by
  -- Proof comment: the quotient-module structure on `J / J²` is definitionally induced from the
  -- ambient `R`-module structure.
  rfl

/-- Helper for Lemma 15.30.15: quotient scalars on the degree-`n` associated-graded piece are
computed by representatives in the ambient ring. -/
private theorem idealAssociatedGradedPiece_quotient_smul_eq
    (J : Ideal R) (n : ℕ) (a : R)
    (y : idealAssociatedGradedPiece J R n) :
    ((Ideal.Quotient.mk J a : R ⧸ J) • y) = a • y := by
  -- Proof comment: the quotient action on `I^n / I^(n + 1)` is induced from the ambient
  -- `R`-module structure, so it can be checked directly on quotient representatives.
  refine Quotient.inductionOn y ?_
  intro z
  rfl

/-- Helper for Lemma 15.30.15: the degree-`1` cotangent/graded comparison is already linear over
the quotient ring `R / J`. -/
private noncomputable def cotangent_equiv_degree_one_piece_over_quotient (J : Ideal R) :
    J.Cotangent ≃ₗ[R ⧸ J] idealAssociatedGradedPiece J R 1 := by
  let e := cotangent_equiv_degree_one_piece_over_base (R := R) J
  -- Proof comment: the underlying bijection is the base-linear degree-`1` identification; only
  -- quotient-linearity remains, and both scalar actions reduce to multiplication by
  -- representatives in `R`.
  refine
    { toFun := e
      invFun := e.symm
      left_inv := e.left_inv
      right_inv := e.right_inv
      map_add' := e.map_add'
      map_smul' := ?_ }
  intro a x
  refine Quotient.inductionOn a ?_
  intro a
  calc
    e (((Ideal.Quotient.mk J a : R ⧸ J) • x)) = e (a • x) := by
      rw [cotangent_quotient_smul_eq (J := J) (a := a) (x := x)]
    _ = a • e x := e.map_smul a x
    _ = ((Ideal.Quotient.mk J a : R ⧸ J) • e x) := by
      symm
      exact
        idealAssociatedGradedPiece_quotient_smul_eq
          (J := J) (n := 1) (a := a) (y := e x)

/-- Helper for Lemma 15.30.15: for the regular module `R`, quotienting by an ideal agrees with
quotienting by the corresponding submodule `J • ⊤`, already over the quotient ring. -/
private noncomputable abbrev ideal_quotient_equiv_module_quotient_over_quotient
    (J : Ideal R) :
    (R ⧸ J) ≃ₗ[R ⧸ J] (R ⧸ ((J • (⊤ : Submodule R R)) : Submodule R R)) := by
  let eR : (R ⧸ J) ≃ₗ[R] (R ⧸ ((J • (⊤ : Submodule R R)) : Submodule R R)) :=
    -- Proof comment: rewrite the submodule `J • ⊤` back to the ideal `J`, then use the identity
    -- map on quotient representatives.
    (Submodule.quotEquivOfEq
      (((J • (⊤ : Submodule R R)) : Submodule R R))
      (J : Submodule R R)
      (by simpa using ideal_smul_top_eq_self (J := J))).symm
  refine
    { toFun := eR
      invFun := eR.symm
      left_inv := eR.left_inv
      right_inv := eR.right_inv
      map_add' := eR.map_add
      map_smul' := ?_ }
  intro c x
  -- Proof comment: over the quotient ring, both scalar actions are computed on representatives.
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
  rfl

/-- Helper for Lemma 15.30.15: a quasi-regular family identifies the plain polynomial source with
the associated-graded module of its span ideal. -/
private noncomputable def quasi_regular_linearEquiv_over_quotient_source
    (s : Fin r → R) (hs : IsQuasiRegularSequence (List.ofFn s)) :
    MvPolynomial (Fin (List.ofFn s).length) (R ⧸ Ideal.ofList (List.ofFn s)) ≃
      idealAssociatedGradedModule (Ideal.ofList (List.ofFn s)) R := by
  let J : Ideal R := Ideal.ofList (List.ofFn s)
  let eSource :
      TensorProduct (R ⧸ J) (R ⧸ ((J • (⊤ : Submodule R R)) : Submodule R R))
          (MvPolynomial (Fin (List.ofFn s).length) (R ⧸ J)) ≃ₗ[R ⧸ J]
        TensorProduct (R ⧸ J) (R ⧸ J) (MvPolynomial (Fin (List.ofFn s).length) (R ⧸ J)) :=
    TensorProduct.AlgebraTensorModule.congr
      (ideal_quotient_equiv_module_quotient_over_quotient (R := R) J).symm
      (LinearEquiv.refl (R ⧸ J) _)
  have hlinear :
      TensorProduct (R ⧸ J) (R ⧸ ((J • (⊤ : Submodule R R)) : Submodule R R))
          (MvPolynomial (Fin (List.ofFn s).length) (R ⧸ J)) ≃
        idealAssociatedGradedModule J R := by
    -- Proof comment: after forgetting the ambient scalar action, `hs.linearEquiv` already has
    -- the desired underlying source and target.
    simpa [J] using hs.linearEquiv.toEquiv
  -- Proof comment: `hs.linearEquiv` already gives the associated-graded equivalence, but its
  -- source is the owner tensor `(R / J·R) ⊗ P`. We first rewrite `R / J·R` as the plain quotient
  -- ring `R / J`, then cancel the trivial left tensor factor with `TensorProduct.lid`.
  exact
    ((TensorProduct.lid
        (R ⧸ J) (MvPolynomial (Fin (List.ofFn s).length) (R ⧸ J))).symm.toEquiv).trans
      (eSource.symm.toEquiv.trans hlinear)

/-- Helper for Lemma 15.30.15: the coefficient vector of a linear polynomial in distinct
variables is uniquely determined by the polynomial itself. -/
private theorem linear_polynomial_map_injective (J : Ideal R) :
    Function.Injective
      (fun c : Fin r → R ⧸ J ↦ ∑ i, c i • (MvPolynomial.X i : MvPolynomial (Fin r) (R ⧸ J))) := by
  intro c d hcd
  funext i
  -- Proof comment: read off the coefficient of the monomial `X_i` on both sides.
  have hcoeff := congrArg
    (fun p : MvPolynomial (Fin r) (R ⧸ J) ↦ MvPolynomial.coeff (Finsupp.single i 1) p) hcd
  simpa [MvPolynomial.coeff_sum] using hcoeff

/-- Helper for Lemma 15.30.15: the source-faithful cotangent family map is already linear over the
quotient ring `R / J`. -/
private noncomputable abbrev cotangent_family_map (s : Fin r → R) :
    (Fin r → R ⧸ Ideal.ofList (List.ofFn s)) →ₗ[R ⧸ Ideal.ofList (List.ofFn s)]
      (Ideal.ofList (List.ofFn s)).Cotangent :=
  Fintype.linearCombination (R ⧸ Ideal.ofList (List.ofFn s)) fun i ↦
    (Ideal.ofList (List.ofFn s)).toCotangent
      ⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩

/-- Helper for Lemma 15.30.15: evaluating the quotient-linear cotangent family map on
representatives recovers the already constructed base-linear map. -/
private theorem cotangent_family_map_mk (s : Fin r → R) (y : Fin r → R) :
    cotangent_family_map (R := R) s (fun i ↦ Ideal.Quotient.mk (Ideal.ofList (List.ofFn s)) (y i)) =
      cotangent_family_map_over_base (R := R) s y := by
  let J : Ideal R := Ideal.ofList (List.ofFn s)
  -- Proof comment: both maps are the same finite linear combination once quotient scalars are
  -- read via representatives in `R`.
  calc
    cotangent_family_map (R := R) s (fun i ↦ Ideal.Quotient.mk J (y i)) =
        ∑ i, (Ideal.Quotient.mk J (y i) : R ⧸ J) •
          J.toCotangent ⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ := by
            simp [cotangent_family_map, J, Fintype.linearCombination_apply]
    _ = ∑ i, y i • J.toCotangent
          ⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ := by
            simpa [cotangent_quotient_smul_eq (J := J)]
    _ = cotangent_family_map_over_base (R := R) s y := by
          simp [cotangent_family_map_over_base, J, Fintype.linearCombination_apply]

/-- Helper for Lemma 15.30.15: on the standard basis vector, the quotient-linear cotangent family
map returns the cotangent class of the corresponding generator. -/
private theorem cotangent_family_map_basisFun
    (s : Fin r → R) (i : Fin r) :
    cotangent_family_map (R := R) s ((Pi.basisFun
      (R ⧸ Ideal.ofList (List.ofFn s)) (Fin r)) i) =
      (Ideal.ofList (List.ofFn s)).toCotangent
        ⟨s i, generator_mem_ofList_ofFn (R := R) s i⟩ := by
  let J : Ideal R := Ideal.ofList (List.ofFn s)
  -- Proof comment: all coefficients vanish except the `i`th one, where the basis vector carries
  -- the scalar `1`.
  simp [cotangent_family_map, J, Fintype.linearCombination_apply]

/-- Helper for Lemma 15.30.15: the quotient-linear cotangent family map is surjective because the
base-linear spanning map is already surjective on representatives. -/
private theorem cotangent_family_map_surjective (s : Fin r → R) :
    Function.Surjective (cotangent_family_map (R := R) s) := by
  intro z
  obtain ⟨y, hy⟩ := cotangent_family_map_over_base_surjective (R := R) s z
  refine ⟨fun i ↦ Ideal.Quotient.mk (Ideal.ofList (List.ofFn s)) (y i), ?_⟩
  simpa [cotangent_family_map_mk (R := R) s y] using hy

/-- Helper for Lemma 15.30.15: on a standard basis vector, transporting the cotangent class of the
`g`-family across the common ideal matches the transpose action of the quotient change matrix on
the `f`-family coefficients. -/
private theorem cotangent_family_map_transpose_basisFun
    {A : Matrix (Fin r) (Fin r) R}
    (hI : Ideal.ofList (List.ofFn f) = Ideal.ofList (List.ofFn g))
    (hA : g = A.toLin' f) (i : Fin r) :
    (Ideal.Cotangent.equivOfEq
        (Ideal.ofList (List.ofFn g))
        (Ideal.ofList (List.ofFn f))
        hI.symm)
        (cotangent_family_map (R := R) g
          ((Pi.basisFun (R ⧸ Ideal.ofList (List.ofFn g)) (Fin r)) i)) =
      cotangent_family_map (R := R) f
        ((((A.map (Ideal.Quotient.mk (Ideal.ofList (List.ofFn f)))).transpose).toLin')
          ((Pi.basisFun (R ⧸ Ideal.ofList (List.ofFn f)) (Fin r)) i)) := by
  let I : Ideal R := Ideal.ofList (List.ofFn f)
  let J : Ideal R := Ideal.ofList (List.ofFn g)
  -- Proof comment: after identifying the ideals, the transpose sends the `i`th basis vector to
  -- the `i`th coefficient row of `A`, whose cotangent linear combination is exactly `g i`.
  have hAi :
      g i = ∑ j, A i j * f j := by
    simpa [Matrix.toLin'_apply, Matrix.mulVec, dotProduct] using congrArg (fun x ↦ x i) hA
  have hgi_mem : g i ∈ I := by
    simpa [I, J, hI] using generator_mem_ofList_ofFn (R := R) g i
  have hsum_mem : ∑ j, A i j * f j ∈ I := by
    simpa [hAi] using hgi_mem
  calc
    (Ideal.Cotangent.equivOfEq J I hI.symm)
        (cotangent_family_map (R := R) g
          ((Pi.basisFun (R ⧸ J) (Fin r)) i)) =
      (Ideal.Cotangent.equivOfEq J I hI.symm)
        (J.toCotangent ⟨g i, generator_mem_ofList_ofFn (R := R) g i⟩) := by
          rw [cotangent_family_map_basisFun]
    _ = I.toCotangent ⟨g i, hgi_mem⟩ := by
          change I.toCotangent ((LinearEquiv.ofEq J I hI.symm)
              ⟨g i, generator_mem_ofList_ofFn (R := R) g i⟩) =
            I.toCotangent ⟨g i, hgi_mem⟩
          apply congrArg I.toCotangent
          ext
          rfl
    _ = I.toCotangent ⟨∑ j, A i j * f j, hsum_mem⟩ := by
          apply congrArg I.toCotangent
          exact Subtype.ext hAi
    _ = I.toCotangent (∑ j, A i j • (⟨f j, generator_mem_ofList_ofFn (R := R) f j⟩ : I)) := by
          apply congrArg I.toCotangent
          ext
          simp [mul_comm, mul_left_comm, mul_assoc]
    _ = ∑ j, I.toCotangent
          (A i j • (⟨f j, generator_mem_ofList_ofFn (R := R) f j⟩ : I)) := by
          simp
    _ = ∑ j, A i j • I.toCotangent
          ⟨f j, generator_mem_ofList_ofFn (R := R) f j⟩ := by
          refine Finset.sum_congr rfl ?_
          intro j _
          exact I.toCotangent.map_smul (A i j)
            (⟨f j, generator_mem_ofList_ofFn (R := R) f j⟩ : I)
    _ = cotangent_family_map (R := R) f
          ((((A.map (Ideal.Quotient.mk I)).transpose).toLin')
            ((Pi.basisFun (R ⧸ I) (Fin r)) i)) := by
          symm
          calc
            cotangent_family_map (R := R) f
                ((((A.map (Ideal.Quotient.mk I)).transpose).toLin')
                  ((Pi.basisFun (R ⧸ I) (Fin r)) i)) =
              ∑ j,
                ((((A.map (Ideal.Quotient.mk I)).transpose).toLin')
                  ((Pi.basisFun (R ⧸ I) (Fin r)) i) j) •
                    I.toCotangent
                      ⟨f j, generator_mem_ofList_ofFn (R := R) f j⟩ := by
                        simp [cotangent_family_map, I, Fintype.linearCombination_apply]
            _ = ∑ j, (Ideal.Quotient.mk I (A i j) : R ⧸ I) •
                  I.toCotangent
                    ⟨f j, generator_mem_ofList_ofFn (R := R) f j⟩ := by
                      refine Finset.sum_congr rfl ?_
                      intro j _
                      have hcoeff :
                          ((((A.map (Ideal.Quotient.mk I)).transpose).toLin')
                            ((Pi.basisFun (R ⧸ I) (Fin r)) i) j) =
                            (Ideal.Quotient.mk I (A i j) : R ⧸ I) := by
                        rw [Matrix.toLin'_apply, Matrix.mulVec, dotProduct]
                        rw [Finset.sum_eq_single i]
                        · simp [Pi.basisFun, Matrix.transpose_apply]
                        · intro j' _ hj'
                          simp [Pi.basisFun, Matrix.transpose_apply, hj']
                        · intro hi
                          exact (hi (Finset.mem_univ i)).elim
                      rw [hcoeff]
            _ = ∑ j, A i j • I.toCotangent
                  ⟨f j, generator_mem_ofList_ofFn (R := R) f j⟩ := by
                      refine Finset.sum_congr rfl ?_
                      intro j _
                      rw [cotangent_quotient_smul_eq (J := I)]

/-- Helper for Lemma 15.30.15: an injective endomorphism of a finite free module has unit
determinant. -/
private theorem toLin'_toMatrix_basisFun
    {S : Type u} [CommRing S] {m n : ℕ}
    (φ : (Fin m → S) →ₗ[S] (Fin n → S)) :
    (LinearMap.toMatrix (Pi.basisFun S (Fin m)) (Pi.basisFun S (Fin n)) φ).toLin' = φ := by
  -- Proof comment: both linear maps are determined by their values on the standard basis vectors.
  ext x i
  simp [Matrix.toLin'_apply, LinearMap.toMatrix, dotProduct]

/-- Helper for Lemma 15.30.15: a bijective endomorphism of a finite free module has unit
determinant. -/
private theorem det_isUnit_of_bijective_toLin'
    {S : Type u} [CommRing S] {n : ℕ} (A : Matrix (Fin n) (Fin n) S)
    (hA : Function.Bijective (A.toLin' : (Fin n → S) →ₗ[S] (Fin n → S))) :
    IsUnit (Matrix.det A) := by
  classical
  -- Route correction: injective endomorphisms of free modules do not force unit determinant over a
  -- general ring, so this helper packages only the correct bijective conclusion needed later.
  let e : (Fin n → S) ≃ₗ[S] (Fin n → S) := LinearEquiv.ofBijective A.toLin' hA
  let B : Matrix (Fin n) (Fin n) S :=
    LinearMap.toMatrix (Pi.basisFun S (Fin n)) (Pi.basisFun S (Fin n)) e.symm.toLinearMap
  have hB :
      B.toLin' = e.symm.toLinearMap := by
    -- Proof comment: the coordinate matrix of `e.symm` recovers the original linear map.
    simpa [B] using
      (toLin'_toMatrix_basisFun (S := S) (m := n) (n := n) (φ := e.symm.toLinearMap))
  have hBA_lin :
      (B * A).toLin' = (1 : Matrix (Fin n) (Fin n) S).toLin' := by
    -- Proof comment: the coordinate matrix of the inverse composes with `A.toLin'` to the
    -- identity on the free module.
    calc
      (B * A).toLin' = B.toLin'.comp A.toLin' := by rw [Matrix.toLin'_mul]
      _ = e.symm.toLinearMap.comp e.toLinearMap := by simpa [e, hB]
      _ = LinearMap.id := by
            ext x i
            exact congrArg (fun y ↦ y i) (e.left_inv x)
      _ = (1 : Matrix (Fin n) (Fin n) S).toLin' := by
            simp [Matrix.toLin'_one]
  have hAB_lin :
      (A * B).toLin' = (1 : Matrix (Fin n) (Fin n) S).toLin' := by
    -- Proof comment: the same argument gives the inverse relation in the other order.
    calc
      (A * B).toLin' = A.toLin'.comp B.toLin' := by rw [Matrix.toLin'_mul]
      _ = e.toLinearMap.comp e.symm.toLinearMap := by simpa [e, hB]
      _ = LinearMap.id := by
            ext x i
            exact congrArg (fun y ↦ y i) (e.right_inv x)
      _ = (1 : Matrix (Fin n) (Fin n) S).toLin' := by
            simp [Matrix.toLin'_one]
  have hBA : B * A = 1 := by
    -- Proof comment: read off the matrix entries by evaluating the equality of endomorphisms on
    -- standard basis vectors.
    ext i j
    have hEntry := congrArg
      (fun φ : (Fin n → S) →ₗ[S] (Fin n → S) ↦ φ (Pi.basisFun S (Fin n) j) i) hBA_lin
    simpa [Matrix.toLin'_apply, Matrix.mul_apply, dotProduct] using hEntry
  have hAB : A * B = 1 := by
    -- Proof comment: the same basis-vector evaluation gives the reverse matrix inverse relation.
    ext i j
    have hEntry := congrArg
      (fun φ : (Fin n → S) →ₗ[S] (Fin n → S) ↦ φ (Pi.basisFun S (Fin n) j) i) hAB_lin
    simpa [Matrix.toLin'_apply, Matrix.mul_apply, dotProduct] using hEntry
  have hA_unit : IsUnit A := by
    exact ⟨⟨A, B, hAB, hBA⟩, rfl⟩
  -- Proof comment: once the matrix is a unit in the matrix ring, its determinant is a unit.
  exact (Matrix.isUnit_iff_isUnit_det A).1 hA_unit

