-- Proof sketch: apply Lemma `15.109.3` to complement the local idempotent factor defined by the
-- surjection `Bhat → C`, glue the resulting finite algebra over `B`, then use henselian lifting of
-- idempotents after an étale neighborhood to split the finite algebra into two factors whose
-- `I`-adic completions are `C` and its complement.
/-- Helper for Lemma 15.109.4: the extended ideal of the completion is generated by finitely many
elements coming from a finite generating family of the base ideal `I ⊂ A`. -/
lemma completion_ideal_explicit_fg_witness :
    ∃ r : ℕ, ∃ f : Fin r → A,
      Ideal.span (Set.range f) = I ∧
      Ideal.span (Set.range fun i ↦ algebraMap A Bhat (f i)) =
        Ideal.map (algebraMap A Bhat) I := by
  -- The source proof first fixes finitely many generators of `I`, then pushes them into the
  -- completion to obtain a matching generating family of the extended ideal.
  obtain ⟨s, hs⟩ := I.fg_of_isNoetherianRing
  let f : Fin s.card → A := fun i ↦ (s.equivFin.symm i : A)
  have hf : Ideal.span (Set.range f) = I := by
    -- Rewrite the finite generating set supplied by `Ideal.FG` as a `Fin`-indexed family.
    rw [← hs]
    congr 1
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact (s.equivFin.symm i).2
    · intro hx
      exact ⟨s.equivFin ⟨x, hx⟩, by simp [f]⟩
  refine ⟨s.card, f, hf, ?_⟩
  -- Mapping a spanning family along the completion map gives the spanning family of the extended
  -- ideal in `Bhat`.
  calc
    Ideal.span (Set.range fun i : Fin s.card ↦ algebraMap A Bhat (f i)) =
        Ideal.span ((algebraMap A Bhat) '' Set.range f) := by
          congr 1
          ext x
          constructor
          · rintro ⟨i, rfl⟩
            exact ⟨f i, Set.mem_range_self i, rfl⟩
          · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
            exact ⟨i, rfl⟩
    _ = Ideal.map (algebraMap A Bhat) (Ideal.span (Set.range f)) := by
          rw [Ideal.map_span]
    _ = Ideal.map (algebraMap A Bhat) I := by
          rw [hf]

/-- Helper for Lemma 15.109.4: once the cotangent-annihilation hypothesis is converted into
idempotent localizations on the completion charts, the specialized mechanism of Lemma `15.109.3`
supplies a complementary
quotient factor `Bhat ⧸ J` whose product with `C` is locally equal to `Bhat`. -/
lemma completion_quotient_has_complementary_local_factor
    (r : ℕ) (f : Fin r → A)
    (hf : Ideal.span (Set.range f) = I)
    (hmap : Ideal.span (Set.range fun i ↦ algebraMap A Bhat (f i)) =
      Ideal.map (algebraMap A Bhat) I)
    (φ : Bhat →ₐ[A] C) (hφ : Function.Surjective φ) (c : ℕ)
    (hBhatNoeth : IsNoetherianRing Bhat)
    (hker_fg : (RingHom.ker φ).FG)
    (hker :
      Ideal.map (algebraMap A Bhat) (I ^ c) ≤
        Module.annihilator Bhat (RingHom.ker φ).Cotangent) :
    ∃ J : Ideal Bhat, ∀ ⦃g : Bhat⦄, g ∈ Ideal.map (algebraMap A Bhat) I →
      Function.Bijective (Localization.awayMapₐ (φ.prod (Ideal.Quotient.mkₐ A J)) g) := by
  have hmap_fg : (Ideal.map (algebraMap A Bhat) I).FG := by
    -- The chosen generators of `I` already generate its extension to the completion.
    simpa [hmap] using
      (Submodule.fg_span
        (Set.finite_range fun i : Fin r ↦ algebraMap A Bhat (f i)) :
          (Ideal.span (Set.range fun i : Fin r ↦ algebraMap A Bhat (f i)) : Ideal Bhat).FG)
  -- Route correction: the next structural step really is the specialized `15.109.3` quotient
  -- factor theorem on `Bhat`, not a direct attempt to descend `C` globally first.
  --
  -- TODO: first prove the arbitrary-chart local statement
  -- `∀ g ∈ map(I), ∃ e : Bhat[g], IsIdempotentElem e ∧ IsLocalization.Away e C[g]`
  -- from `hker` by localizing the cotangent module and using that `g ^ c` becomes a unit. Then
  -- feed that family, together with `hmap_fg`, into the specialized `15.109.3` quotient-factor
  -- mechanism.
  --
  -- Current blocker: importing `stacks_project.Chap15.Lemma_15_109_3` to reuse its public theorem
  -- fails because that file presently has a Lean error at line 818 (`invalid 'calc' step`), so
  -- the specialization has to be ported locally or the external file must be repaired first.
  let _ := hmap_fg
  let _ := hBhatNoeth
  let _ := hker_fg
  let _ := hφ
  let _ := c
  let _ := hker
  sorry

