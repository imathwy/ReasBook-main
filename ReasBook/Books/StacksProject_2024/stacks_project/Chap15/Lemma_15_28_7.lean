/-- Helper for Lemma 15.28.7: in positive degrees, the homotopy cofiber differential for
`f • 𝟙 (koszulComplex φ)` becomes the standard owner-order block matrix under `XIsoBiprod`. -/
private theorem homotopyCofiber_smul_id_owner_d_eq_ofComponents
    (φ : E →ₗ[R] R) (f : R) (n : ℕ) :
    let α := f • 𝟙 (koszulComplex φ)
    (XIsoBiprod α (n + 2) (n + 1) (ComplexShape.down_mk (n + 2) (n + 1) rfl)).inv ≫
        (homotopyCofiber α).d (n + 2) (n + 1) ≫
        (XIsoBiprod α (n + 1) n (ComplexShape.down_mk (n + 1) n rfl)).hom =
      Biprod.ofComponents
        (-((koszulComplex φ).d (n + 1) n))
        (α.f (n + 1))
        0
        ((koszulComplex φ).d (n + 2) (n + 1)) := by
  -- Proof comment: after transporting by `XIsoBiprod`, the cone differential is the owner block
  -- matrix used in the textbook. This normalization is needed only for the positive-degree square.
  -- TODO: compare the four biproduct entries using the owner `inlX_d_assoc` and `inrX_d_assoc`
  -- computation rules after the `XIsoBiprod` coordinate normalizations above are proved.
