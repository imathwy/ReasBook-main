/-- Helper for Lemma 15.28.7: the degree-`n + 1` split map sends an exterior class in `E × R`
to its `snd`-Koszul component together with its pure-`E` projection. -/
private noncomputable def coprod_scalar_succ_split_hom (n : ℕ) :
    (ModuleCat.of R (E × R)).exteriorPower (n + 1) ⟶
      (ModuleCat.of R E).exteriorPower n ⊞ (ModuleCat.of R E).exteriorPower (n + 1) :=
  biprod.lift
    (ModuleCat.ofHom (koszulDifferentialLinearMap (LinearMap.snd R E R) n) ≫
      ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) n)
    (ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) (n + 1))

/-- Helper for Lemma 15.28.7: the inverse split map reinserts the pure-`E` part and wedges the
lower-degree component with `e0 = (0, 1)`. -/
private noncomputable def coprod_scalar_succ_split_inv (n : ℕ) :
    (ModuleCat.of R E).exteriorPower n ⊞ (ModuleCat.of R E).exteriorPower (n + 1) ⟶
      (ModuleCat.of R (E × R)).exteriorPower (n + 1) :=
  biprod.desc
    (ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) n ≫
      ModuleCat.ofHom (koszulLeftWedge ((0 : E), (1 : R)) n))
    (ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) (n + 1))

/-- Helper for Lemma 15.28.7: the `snd`-Koszul differential vanishes on pure `E` generators. -/
private theorem coprod_scalar_succ_split_diff_inl_zero (n : ℕ) :
    ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) (n + 1) ≫
      ModuleCat.ofHom (koszulDifferentialLinearMap (LinearMap.snd R E R) n) = 0 := by
  apply ModuleCat.hom_ext
  apply exteriorPower.linearMap_ext
  ext m
  -- On a pure `E` generator, every coefficient seen by `LinearMap.snd` is zero.
  simpa using (show
    ((ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) (n + 1) ≫
      ModuleCat.ofHom (koszulDifferentialLinearMap (LinearMap.snd R E R) n)).hom)
      (exteriorPower.ιMulti R (n + 1) m) = 0 from by
        change koszulDifferentialLinearMap (LinearMap.snd R E R) n
          (exteriorPower.map (n + 1) (LinearMap.inl R E R) (exteriorPower.ιMulti R (n + 1) m)) = 0
        rw [exteriorPower.map_apply_ιMulti, koszulDifferentialLinearMap_apply_ιMulti_eq_sum]
        simp)

/-- Helper for Lemma 15.28.7: wedging a pure `E` generator with `e0 = (0, 1)` and then
projecting back to `E` kills the class because the new head projects to zero. -/
private theorem coprod_scalar_succ_split_wedge_fst_zero (n : ℕ) :
    ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) n ≫
      ModuleCat.ofHom (koszulLeftWedge ((0 : E), (1 : R)) n) ≫
      ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) (n + 1) = 0 := by
  apply ModuleCat.hom_ext
  apply exteriorPower.linearMap_ext
  ext m
  -- The `fst` projection of the wedged head `e0` is zero, so the alternating generator vanishes.
  simpa using (show
    ((ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) n ≫
      ModuleCat.ofHom (koszulLeftWedge ((0 : E), (1 : R)) n) ≫
      ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) (n + 1)).hom)
      (exteriorPower.ιMulti R n m) = 0 from by
        change exteriorPower.map (n + 1) (LinearMap.fst R E R)
          (koszulLeftWedge ((0 : E), (1 : R)) n
            (exteriorPower.map n (LinearMap.inl R E R) (exteriorPower.ιMulti R n m))) = 0
        rw [exteriorPower.map_apply_ιMulti, koszulLeftWedge_apply_ιMulti, exteriorPower.map_apply_ιMulti]
        refine AlternatingMap.map_coord_zero (ιMulti R (n + 1)) 0 ?_
        simp)

/-- Helper for Lemma 15.28.7: projecting a pure `E` class along `fst` after reinserting it by
`inl` is the identity on the exterior power of `E`. -/
private theorem coprod_scalar_succ_split_fst_inl_id (n : ℕ) :
    ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) n ≫
      ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) n = 𝟙 _ := by
  apply ModuleCat.hom_ext
  apply exteriorPower.linearMap_ext
  ext m
  -- The two exterior-power maps reduce to `fst ∘ inl = id` on every generator.
  simpa using (show
    ((ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) n ≫
      ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) n).hom)
      (exteriorPower.ιMulti R n m) = exteriorPower.ιMulti R n m from by
        change exteriorPower.map n (LinearMap.fst R E R)
          (exteriorPower.map n (LinearMap.inl R E R) (exteriorPower.ιMulti R n m)) = _
        rw [exteriorPower.map_apply_ιMulti, exteriorPower.map_apply_ιMulti]
        congr 1)

/-- Helper for Lemma 15.28.7: on the pure-`E` summand, wedging with `e0 = (0, 1)`, applying the
`snd`-Koszul differential, and projecting back with `fst` recovers the original class. -/
