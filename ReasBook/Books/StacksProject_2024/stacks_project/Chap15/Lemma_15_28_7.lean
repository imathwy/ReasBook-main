/-- Helper for Lemma 15.28.7: the split maps are inverse on the biproduct side.

The three easy matrix entries are now stabilized. The remaining diagonal entry is the source proof's
Cartan-identity computation on the `e0`-wedged summand. -/
private theorem coprod_scalar_succ_split_hom_inv_id (n : ℕ) :
    coprod_scalar_succ_split_inv (R := R) (E := E) n ≫
      coprod_scalar_succ_split_hom (R := R) (E := E) n = 𝟙 _ := by
  apply biprod.hom_ext
  · apply biprod.hom_ext'
    · -- The remaining diagonal entry is the Cartan identity on the pure `E` summand.
      simpa [coprod_scalar_succ_split_hom, coprod_scalar_succ_split_inv, Category.assoc] using
        coprod_scalar_snd_cartan_on_pure_E (R := R) (E := E) n
    · -- The `e0`-wedged summand dies after projecting back to `E`.
      have hzero :
          ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) (n + 1) ≫
              ModuleCat.ofHom (koszulDifferentialLinearMap (LinearMap.snd R E R) n) ≫
              ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) n = 0 := by
        -- Proof comment: postcompose the already proved vanishing differential with the `fst`
        -- projection on the pure `E` summand.
        have hzero' :=
          congrArg
            (fun k ↦ k ≫ ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) n)
            (coprod_scalar_succ_split_diff_inl_zero (R := R) (E := E) n)
        have hzero'' :
            (ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.inl R E R)) (n + 1) ≫
                ModuleCat.ofHom (koszulDifferentialLinearMap (LinearMap.snd R E R) n)) ≫
              ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) n = 0 := by
          have hzeroComp :
              (fun k ↦ k ≫ ModuleCat.exteriorPower.map (ModuleCat.ofHom (LinearMap.fst R E R)) n)
                (0 :
                  (ModuleCat.of R E).exteriorPower (n + 1) ⟶
                    (ModuleCat.of R (E × R)).exteriorPower n) = 0 := by
            apply ModuleCat.hom_ext
            ext m
            simp
          exact hzero'.trans hzeroComp
        simpa [Category.assoc] using hzero''
      simpa [coprod_scalar_succ_split_hom, coprod_scalar_succ_split_inv, Category.assoc] using
        hzero
  · apply biprod.hom_ext'
    · -- The `snd`-Koszul differential vanishes on pure `E` generators.
      simpa [coprod_scalar_succ_split_hom, coprod_scalar_succ_split_inv, Category.assoc] using
        coprod_scalar_succ_split_wedge_fst_zero (R := R) (E := E) n
    · -- The pure `E` projection/reinclusion pair is the identity.
      simpa [coprod_scalar_succ_split_hom, coprod_scalar_succ_split_inv, Category.assoc] using
        coprod_scalar_succ_split_fst_inl_id (R := R) (E := E) (n + 1)

