lemma ker_principalAdicCompletion_eq_principalPowerIntersection
    (f : A) :
    RingHom.ker (algebraMap A (principalAdicCompletion f)) =
      (⨅ n : ℕ, principalPowerIdeal f n : Ideal A) := by
