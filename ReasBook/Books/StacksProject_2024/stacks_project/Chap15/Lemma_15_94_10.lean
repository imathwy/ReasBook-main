/-- Helper for Lemma 15.94.10: if every principal subideal of `I` is henselian, then `I` is
henselian. -/
lemma henselianRing_of_henselian_principalIdeals
    (hprincipal : ∀ f : A, f ∈ I → HenselianRing A (principalIdeal f)) :
    HenselianRing A I := by
  have hI_le_largest : I ≤ largestHenselianIdeal := by
    intro x hx
    let _ : HenselianRing A (principalIdeal x) := hprincipal x hx
    -- Proof comment: every generator `x ∈ I` lies in the largest henselian ideal because its
    -- principal ideal is henselian.
    exact
      (le_largestHenselianIdeal (A := A) (principalIdeal x))
        (Ideal.subset_span (by simp))
  have hlargest_pair :
      HenselianRing A largestHenselianIdeal := inferInstance
  have hdecomp :
      HenselianRing A I ∧
        HenselianRing (A ⧸ I)
          (Ideal.map (Ideal.Quotient.mk I) largestHenselianIdeal) :=
    -- Proof comment: descend henselianity from the maximal henselian ideal via Lemma `15.11.9`.
    (henselianRing_iff_henselianRing_and_quotient_henselianRing
      (A := A) (I := I) (J := largestHenselianIdeal) hI_le_largest).1 hlargest_pair
  exact hdecomp.1

/-- Lemma 15.94.10: if the ring `A`, viewed as an `A`-module, is derived complete with respect to
an ideal `I`, then the canonical owner predicate `HenselianRing A I` holds. -/
theorem henselianRing_of_isDerivedCompleteWithRespectTo
    (hA : (ModuleCat.of A A).IsDerivedCompleteWithRespectTo I) :
    HenselianRing A I := by
  -- Route correction: instead of the abandoned direct root-lift detour, follow the source route.
  -- First prove the statement for each principal ideal `(f)` with `f ∈ I`, then rebuild the full
  -- ideal `I` from its finitely generated subideals.
  refine henselianRing_of_henselian_principalIdeals (A := A) (I := I) ?_
  intro f hf
  exact henselianRing_principalIdeal_of_isDerivedCompleteWithRespectTo (A := A) f
    (isDerivedCompleteWithRespectTo_principalIdeal_of_mem (I := I) hf hA)

