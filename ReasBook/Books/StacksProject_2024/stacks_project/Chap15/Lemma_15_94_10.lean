-- Proof sketch: use the canonical maximal owner `largestHenselianIdeal` from Lemma `15.11.15` to
-- reduce to the principal ideals generated by elements of `I`. For a fixed `f ∈ I`, derived
-- completeness with respect to `I` restricts to derived completeness with respect to the principal
-- ideal `(f)`, so Lemma `15.92.3` makes the map to the `f`-adic completion surjective. The target
-- quotient is henselian by the canonical completion owner bridge `IsAdicComplete.henselianRing`,
-- and Lemma `15.11.9` reduces the original henselianity statement to showing that the
-- intersection `⋂ n, (f)^n` is locally nilpotent; this follows from Lemma `15.94.9` together with
-- the locally nilpotent owner bridge `henselianRing_of_isLocallyNilpotent`.
/-- Helper for Lemma 15.94.10: if `f ∈ I`, then the principal ideal generated by `f` is contained
in `I`. -/
lemma principalIdeal_le_of_mem {f : A} (hf : f ∈ I) :
    principalIdeal f ≤ I := by
  -- Proof comment: the span of a singleton is the smallest ideal containing its generator.
  simpa [principalIdeal] using (Ideal.span_singleton_le_iff_mem I).2 hf

/-- Helper for Lemma 15.94.10: derived completeness with respect to `I` restricts to derived
completeness with respect to the principal ideal generated by any `f ∈ I`. -/
lemma isDerivedCompleteWithRespectTo_principalIdeal_of_mem {f : A} (hf : f ∈ I)
    (hA : (ModuleCat.of A A).IsDerivedCompleteWithRespectTo I) :
    (ModuleCat.of A A).IsDerivedCompleteWithRespectTo (principalIdeal f) := by
  intro g hg
  -- Proof comment: every generator of the smaller principal ideal already lies in `I`.
  exact hA g (principalIdeal_le_of_mem (I := I) hf hg)

/-- Helper for Lemma 15.94.10: if the image of `x` modulo a Jacobson ideal is a unit, then `x`
is already a unit. -/
lemma isUnit_of_isUnit_quotient_of_le_jacobson
    {R : Type*} [CommRing R] (J : Ideal R) {x : R}
    (hx : IsUnit ((Ideal.Quotient.mk J) x)) (hJ : J ≤ Ring.jacobson R) :
    IsUnit x := by
  -- Proof comment: quotienting by a Jacobson ideal is a local ring hom, so units reflect.
  let _ : IsLocalHom (Ideal.Quotient.mk J) :=
    isLocalHom_of_le_jacobson_bot J (by simpa [Ideal.jacobson_bot] using hJ)
  exact (isUnit_map_iff (Ideal.Quotient.mk J) x).mp hx

/-- Helper for Lemma 15.94.10: polynomial evaluation respects congruence modulo an ideal. -/
lemma eval_sub_mem_of_sub_mem_ideal
    {R : Type*} [CommRing R] (J : Ideal R) (p : Polynomial R) {x y : R}
    (hxy : x - y ∈ J) :
    p.eval x - p.eval y ∈ J := by
  -- Proof comment: pass to the quotient by `J`, where `x` and `y` have the same class.
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  have hq : (Ideal.Quotient.mk J) x = (Ideal.Quotient.mk J) y := by
    rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hxy
  calc
    (Ideal.Quotient.mk J) (p.eval x - p.eval y)
        = Polynomial.eval₂ (Ideal.Quotient.mk J) ((Ideal.Quotient.mk J) x) p -
            Polynomial.eval₂ (Ideal.Quotient.mk J) ((Ideal.Quotient.mk J) y) p := by
            rw [map_sub, ← Polynomial.eval₂_at_apply, ← Polynomial.eval₂_at_apply]
    _ = 0 := by
          simpa [hq]

/-- Helper for Lemma 15.94.10: the intersection of the powers of `(f)` is contained in `(f)`. -/
lemma principal_power_intersection_le_principalIdeal (f : A) :
    (⨅ n : ℕ, principalPowerIdeal f n) ≤ principalIdeal f := by
  -- Proof comment: the `n = 1` term of the intersection is exactly `(f)`.
  intro x hx
  simpa [principalPowerIdeal] using
    (Submodule.mem_iInf
      (p := fun n : ℕ ↦ (principalPowerIdeal f n : Ideal A))).1 hx 1

/-- Helper for Lemma 15.94.10: the completion-side congruence modulo `(f)` descends back to a
congruence modulo `(f)` in `A` once the completion map is surjective and its kernel lies in
`(f)`. -/
lemma sub_mem_principalIdeal_of_completion_mem_and_ker_le
    {f a a₀ : A}
    (hsurj : Function.Surjective (algebraMap A (principalAdicCompletion f)))
    (hker : RingHom.ker (algebraMap A (principalAdicCompletion f)) ≤ principalIdeal f)
    (hmem :
      algebraMap A (principalAdicCompletion f) (a - a₀) ∈
        Ideal.map (algebraMap A (principalAdicCompletion f)) (principalIdeal f)) :
    a - a₀ ∈ principalIdeal f := by
  -- Proof comment: lift a witness from the mapped principal ideal and absorb the kernel error into
  -- `(f)`.
  rcases (Ideal.mem_map_iff_of_surjective (algebraMap A (principalAdicCompletion f)) hsurj).mp hmem
    with ⟨y, hy, hyEq⟩
  have hsubker :
      a - a₀ - y ∈ RingHom.ker (algebraMap A (principalAdicCompletion f)) := by
    rw [RingHom.mem_ker, map_sub, hyEq, sub_self]
  have hsubf : a - a₀ - y ∈ principalIdeal f := hker hsubker
  have hsum : (a - a₀ - y) + y ∈ principalIdeal f := Ideal.add_mem _ hsubf hy
  simpa [sub_eq_add_neg, add_assoc, add_left_comm, add_comm] using hsum

