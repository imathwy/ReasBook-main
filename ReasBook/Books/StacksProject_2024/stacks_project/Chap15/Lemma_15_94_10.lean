/-- Helper for Lemma 15.94.10: a square-zero ideal is locally nilpotent. -/
lemma ideal_isLocallyNilpotent_of_sq_eq_bot
    (J : Ideal A) (hJ : J ^ 2 = ⊥) :
    J.IsLocallyNilpotent := by
  -- Proof comment: every element of `J` has square zero because `J^2 = 0`.
  rw [Ideal.IsLocallyNilpotent]
  intro x hx
  refine ⟨2, ?_⟩
  have hx2 : x ^ 2 ∈ J ^ 2 := by
    simpa [pow_two] using Ideal.mul_mem_mul hx hx
  simpa [hJ] using hx2

