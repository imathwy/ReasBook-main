import Mathlib
import StacksProject_2024.stacks_project.Chap10.Definition_10_135_5
import StacksProject_2024.stacks_project.Chap10.Lemma_10_69_2
import StacksProject_2024.stacks_project.Chap15.Definition_15_30_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open RingTheory
open RingTheory.Sequence

section

variable {R : Type u} [CommRing R]

namespace Ideal

/- Domain triage:
- primary domain: Zariski-local regularity conditions on ideals in commutative algebra;
- sampled owner declarations: `Ideal.IsGeneratedByRegularSequence`, `Sequence.IsRegular`,
  `Sequence.IsKoszulRegularSequence`, and `Sequence.IsH1RegularSequence`;
- layer: `source-facing`; Definition `15.32.1` introduces ideal-level predicates, but their core
  mathematical data is already owned by the localized ideal predicate
  `Ideal.IsGeneratedByRegularSequence` and the finite-sequence predicates above after passing to
  `Localization.Away g`;
- primitive vs derived split: for the regular branch the primitive localized datum is the owner
  predicate `(Ideal.map (algebraMap R (Localization.Away g)) I).IsGeneratedByRegularSequence`,
  while the explicit `Fin`-indexed generating family is only companion specification API. -/
private def IsGeneratedByFiniteAwaySequence (I : Ideal R)
    (P : ∀ g : R, {r : ℕ} → (Fin r → Localization.Away g) → Prop) : Prop :=
  ∀ p : Ideal R, p.IsPrime → I ≤ p →
    ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
      P g f ∧
        Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)

private theorem ofList_ofFn_eq_span_range {S : Type*} [CommRing S] {r : ℕ} (f : Fin r → S) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  ext x
  simp [Ideal.ofList, List.mem_ofFn', Set.range]

/-- Definition 15.32.1 (1): an ideal `I` is regular if for every prime ideal `p` containing `I`
there is an element `g ∉ p` such that after localizing away from `g`, the localized ideal is
generated by a finite regular sequence. -/
def IsRegularIdeal (I : Ideal R) : Prop :=
  ∀ p : Ideal R, p.IsPrime → I ≤ p →
    ∃ g : R, g ∉ p ∧
      (Ideal.map (algebraMap R (Localization.Away g)) I).IsGeneratedByRegularSequence

-- Proof sketch: the owner predicate `Ideal.IsGeneratedByRegularSequence` is equivalent to the
-- existence of a regular list of generators, and `List.ofFn` converts that owner theorem to the
-- textbook finite-family formulation.
/-- The predicate `I.IsRegularIdeal` is equivalent to the stated local generation criterion by a
finite regular sequence on each basic neighborhood meeting `V(I)`. -/
theorem isRegularIdeal_iff (I : Ideal R) :
    I.IsRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsRegular (Localization.Away g) (List.ofFn f) ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) := by
  constructor
  · intro h p hp hIp
    rcases h p hp hIp with ⟨g, hg, hgen⟩
    rcases (Ideal.isGeneratedByRegularSequence_iff _).1 hgen with ⟨ys, hreg, hys⟩
    refine ⟨g, hg, ys.length, ys.get, ?_, ?_⟩
    · simpa [List.ofFn_get] using hreg
    · simpa [List.ofFn_get, ofList_ofFn_eq_span_range ys.get] using hys.symm
  · intro h p hp hIp
    rcases h p hp hIp with ⟨g, hg, r, f, hf, hspan⟩
    refine ⟨g, hg, (Ideal.isGeneratedByRegularSequence_iff _).2 ?_⟩
    refine ⟨List.ofFn f, by simpa using hf, ?_⟩
    simpa [ofList_ofFn_eq_span_range f] using hspan.symm

/-- Definition 15.32.1 (2): an ideal `I` is Koszul-regular if for every prime ideal `p`
containing `I` there is an element `g ∉ p` such that after localizing away from `g`, the localized
ideal is generated by a finite Koszul-regular sequence. -/
def IsKoszulRegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I (fun _ {_} f ↦ IsKoszulRegularSequence f)

-- Proof sketch: unfold `Ideal.IsKoszulRegularIdeal`; the statement is precisely the local
-- generation condition by a finite Koszul-regular sequence in the localization away from `g`.
/-- The predicate `I.IsKoszulRegularIdeal` is equivalent to the stated local generation criterion
by a finite Koszul-regular sequence on each basic neighborhood meeting `V(I)`. -/
theorem isKoszulRegularIdeal_iff (I : Ideal R) :
    I.IsKoszulRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsKoszulRegularSequence f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) :=
  Iff.rfl

/-- Definition 15.32.1 (3): an ideal `I` is `H_1`-regular if for every prime ideal `p`
containing `I` there is an element `g ∉ p` such that after localizing away from `g`, the localized
ideal is generated by a finite `H_1`-regular sequence. -/
def IsH1RegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I (fun _ {_} f ↦ IsH1RegularSequence f)

-- Proof sketch: unfold `Ideal.IsH1RegularIdeal`; this is exactly the localized generation
-- condition by a finite `H_1`-regular sequence over each basic neighborhood meeting `V(I)`.
/-- The predicate `I.IsH1RegularIdeal` is equivalent to the stated local generation criterion by a
finite `H_1`-regular sequence on each basic neighborhood meeting `V(I)`. -/
theorem isH1RegularIdeal_iff (I : Ideal R) :
    I.IsH1RegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsH1RegularSequence f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) :=
  Iff.rfl

/-- Definition 15.32.1 (4): an ideal `I` is quasi-regular if for every prime ideal `p`
containing `I` there is an element `g ∉ p` such that after localizing away from `g`, the localized
ideal is generated by a finite quasi-regular sequence. -/
def IsQuasiRegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I
    (fun g {_} f ↦ IsQuasiRegular (Localization.Away g) (List.ofFn f))

-- Proof sketch: unfold `Ideal.IsQuasiRegularIdeal`; the statement is precisely the localized
-- generation criterion by a finite quasi-regular sequence on each basic neighborhood meeting
-- `V(I)`.
/-- The predicate `I.IsQuasiRegularIdeal` is equivalent to the stated local generation criterion by
a finite quasi-regular sequence on each basic neighborhood meeting `V(I)`. -/
theorem isQuasiRegularIdeal_iff (I : Ideal R) :
    I.IsQuasiRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsQuasiRegular (Localization.Away g) (List.ofFn f) ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) :=
  Iff.rfl

end Ideal

end
