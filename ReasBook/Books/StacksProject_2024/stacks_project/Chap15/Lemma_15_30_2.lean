/-- Helper for Lemma 15.30.2: scalar multiplication on a chain complex induces scalar
multiplication on each homology object. -/
private theorem homologyMap_smul_id
    {K : ChainComplex (ModuleCat R) ℕ} (a : R) (n : ℕ) [K.HasHomology n] :
    HomologicalComplex.homologyMap (a • 𝟙 K) n = a • 𝟙 (K.homology n) := by
  -- Proof comment: pass to the degree-`n` short complex, where homology is linear in the chain
  -- map by `ShortComplex.homologyMap_smul`.
  change
    ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor
          (ModuleCat R) (ComplexShape.down ℕ) n).map (a • 𝟙 K)) =
      a • 𝟙 (K.homology n)
  have hshort :
      ((HomologicalComplex.shortComplexFunctor
        (ModuleCat R) (ComplexShape.down ℕ) n).map (a • 𝟙 K)) =
        a • 𝟙
          (((HomologicalComplex.shortComplexFunctor
            (ModuleCat R) (ComplexShape.down ℕ) n).obj K)) := by
    ext <;> rfl
  have hshort_homology :
      ShortComplex.homologyMap
          (a • 𝟙
            (((HomologicalComplex.shortComplexFunctor
              (ModuleCat R) (ComplexShape.down ℕ) n).obj K))) =
        a • 𝟙
          ((((HomologicalComplex.shortComplexFunctor
            (ModuleCat R) (ComplexShape.down ℕ) n).obj K)).homology) := by
    rw [ShortComplex.homologyMap_smul, ShortComplex.homologyMap_id]
    rfl
  rw [hshort]
  simpa using hshort_homology

/-- Helper for Lemma 15.30.2: in degree `0`, scalar multiplication on the tensorized prefix
Koszul complex induces scalar multiplication on zeroth homology. -/
private theorem tensor_koszul_zero_homologyMap_smul_id (rs : List R) (a : R) :
    HomologicalComplex.homologyMap (a • 𝟙 (koszulComplexOnTensorLeft R M rs.get)) 0 =
      a • 𝟙 ((koszulComplexOnTensorLeft R M rs.get).homology 0) := by
  -- Proof comment: specialize the general homology-linearity statement to the prefix Koszul
  -- complex in degree `0`.
  simpa using
    (homologyMap_smul_id (R := R)
      (K := koszulComplexOnTensorLeft R M rs.get) a 0)

/-- Helper for Lemma 15.30.2: regularity of `a` on the prefix quotient makes the corresponding
scalar endomorphism of that quotient monic in `ModuleCat`. -/
private theorem quotient_smul_mono_of_isSMulRegular (rs : List R) {a : R}
    (ha : IsSMulRegular (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) a) :
    Mono (a • 𝟙 (tensor_koszul_zero_quotient (R := R) (M := M) rs)) := by
  -- Proof comment: in `ModuleCat`, monomorphisms are injective linear maps, and scalar
  -- regularity is exactly injectivity of multiplication by the scalar.
  rw [ModuleCat.mono_iff_injective]
  rw [isSMulRegular_iff_right_eq_zero_of_smul] at ha
  intro x y hxy
  change a • x = a • y at hxy
  apply sub_eq_zero.mp
  exact ha (x - y) <| by
    simpa [smul_sub] using sub_eq_zero.mpr hxy

