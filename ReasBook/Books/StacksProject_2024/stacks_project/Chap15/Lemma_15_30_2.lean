import Mathlib
import StacksProject_2024.stacks_project.Chap15.Definition_15_30_1

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

open CategoryTheory
open CategoryTheory.Limits
open HomologicalComplex
open MonoidalCategory
open ModuleCat
open exteriorPower
open scoped KoszulComplex

namespace RingTheory.Sequence

variable {R : Type u} [CommRing R]
variable {M : Type u} [AddCommGroup M] [Module R M]

/-- Helper for Lemma 15.30.2: this is the module-valued Koszul complex obtained by tensoring the
family Koszul complex on the left with `M`. -/
private abbrev koszulComplexOnTensorLeft (R : Type u) [CommRing R] (M : Type u)
    [AddCommGroup M] [Module R M] {r : ℕ} (f : Fin r → R) :
    ChainComplex (ModuleCat R) ℕ :=
  ((tensorLeft (of R M)).mapHomologicalComplex (ComplexShape.down ℕ)).obj (K^•(f))

/-- Helper for Lemma 15.30.2: every positive exterior power of the zero free module `Fin 0 → R`
is the zero object. -/
private theorem isZero_exteriorPower_empty (i : ℕ) (hi : 1 ≤ i) :
    IsZero ((ModuleCat.of R (Fin 0 → R)).exteriorPower i) := by
  rw [ModuleCat.isZero_iff_subsingleton]
  rcases Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hi) with ⟨j, rfl⟩
  -- The positive-degree exterior power is generated by alternating tensors of the unique zero
  -- vector, so the whole submodule is zero.
  have hbot :
      (⋀[R]^(j + 1) (Fin 0 → R) : Submodule R (ExteriorAlgebra R (Fin 0 → R))) = ⊥ := by
    calc
      (⋀[R]^(j + 1) (Fin 0 → R) : Submodule R (ExteriorAlgebra R (Fin 0 → R))) =
          Submodule.span R (Set.range (ExteriorAlgebra.ιMulti R (j + 1) :
            (Fin (j + 1) → Fin 0 → R) → ExteriorAlgebra R (Fin 0 → R))) := by
        symm
        exact exteriorPower.ιMulti_span_fixedDegree (R := R) (n := j + 1) (M := Fin 0 → R)
      _ = ⊥ := by
        apply le_antisymm
        · rw [Submodule.span_le]
          rintro _ ⟨f, rfl⟩
          have hf : f = 0 := funext fun k ↦ Subsingleton.elim _ _
          rw [hf]
          simpa using (ExteriorAlgebra.ιMulti R (j + 1)).map_zero
        · exact bot_le
  refine ⟨fun x y ↦ ?_⟩
  have hx : x = 0 := by
    simpa [hbot] using x.2
  have hy : y = 0 := by
    simpa [hbot] using y.2
  exact hx.trans hy.symm

/-- Helper for Lemma 15.30.2: in the empty-family Koszul complex tensored with `M`, every
positive-degree term is already zero. -/
private theorem isZero_koszulComplexOnTensorLeft_nil_X (i : ℕ) (hi : 1 ≤ i) :
    IsZero ((koszulComplexOnTensorLeft R M ([] : List R).get).X i) := by
  -- The empty family uses the zero free module `Fin 0 → R`, whose positive exterior powers vanish.
  have hZ : IsZero ((ModuleCat.of R (Fin 0 → R)).exteriorPower i) :=
    isZero_exteriorPower_empty (R := R) i hi
  -- Tensoring with a fixed module preserves zero objects.
  simpa [koszulComplexOnTensorLeft, koszulLinearForm] using
    ((tensorLeft (ModuleCat.of R M)).map_isZero hZ)

/-- Helper for Lemma 15.30.2: the empty sequence is Koszul-regular on every module. -/
private theorem isKoszulRegularOn_nil :
    IsKoszulRegularOn M ([] : List R).get := by
  intro i hi
  -- Positive homology vanishes because the middle term of the degree-`i` short complex is zero.
  have hExact : (koszulComplexOnTensorLeft R M ([] : List R).get).ExactAt i := by
    apply ShortComplex.exact_of_isZero_X₂
    exact isZero_koszulComplexOnTensorLeft_nil_X (R := R) (M := M) i hi
  exact hExact.isZero_homology

/-- Helper for Lemma 15.30.2: the ideal generated by a list is the span of the corresponding
`Fin`-indexed family obtained from `List.get`. -/
private theorem ideal_ofList_eq_span_range_get (rs : List R) :
    Ideal.ofList rs = Ideal.span (Set.range rs.get) := by
  induction rs with
  | nil =>
      -- Both sides are the zero ideal for the empty list.
      ext r
      simp [Ideal.ofList]
  | cons a rs ih =>
      -- Split off the first element and identify the new range with an inserted head term.
      have hRange : Set.range (List.get (a :: rs)) = insert a (Set.range rs.get) := by
        ext x
        constructor
        · rintro ⟨i, rfl⟩
          cases i using Fin.cases with
          | zero =>
              simp
          | succ i =>
              right
              exact ⟨i, by simp⟩
        · intro hx
          rcases hx with rfl | hx
          · exact ⟨0, by simp⟩
          · rcases hx with ⟨i, hi⟩
            exact ⟨i.succ, by simpa using hi⟩
      -- The ideal-side and range-side decompositions are both given by adjoining the head.
      rw [Ideal.ofList_cons, ih, hRange, Ideal.span_insert]

/-- Helper for Lemma 15.30.2: the tuple linear-combination map attached to a list `rs` sends
`x : Fin rs.length → M` to `∑ i, rs[i] • x i`. This is the algebraic model of the first Koszul
differential after transporting degree `1` and degree `0` to concrete module coordinates. -/
private def listLinearCombination (rs : List R) :
    (Fin rs.length → M) →ₗ[R] M where
  toFun := fun x ↦ ∑ i, rs.get i • x i
  map_add' := by
    intro x y
    simp [smul_add, Finset.sum_add_distrib]
  map_smul' := by
    intro a x
    simp [Finset.smul_sum, smul_smul, mul_comm]

/-- Helper for Lemma 15.30.2: the tuple linear-combination map lands in the prefix ideal times
the whole module. This is the easy half of the concrete `H₀` computation needed later. -/
private theorem listLinearCombination_range_le_ideal_smul_top (rs : List R) :
    LinearMap.range (listLinearCombination (R := R) (M := M) rs) ≤
      Ideal.ofList rs • (⊤ : Submodule R M) := by
  · -- Every image element is visibly a sum of prefix generators acting on module elements.
    rintro x ⟨y, rfl⟩
    change (∑ i, rs.get i • y i) ∈ Ideal.ofList rs • (⊤ : Submodule R M)
    refine Submodule.sum_mem _ ?_
    intro i hi
    apply Submodule.smul_mem_smul ?_ Submodule.mem_top
    rw [ideal_ofList_eq_span_range_get (R := R) rs]
    exact Ideal.subset_span ⟨i, rfl⟩

/-- Helper for Lemma 15.30.2: every scalar from the prefix ideal sends every module element into
the range of the concrete first-differential model `listLinearCombination rs`. -/
private theorem ideal_smul_mem_listLinearCombination_range (rs : List R) {b : R}
    (hb : b ∈ Ideal.ofList rs) (m : M) :
    b • m ∈ LinearMap.range (listLinearCombination (R := R) (M := M) rs) := by
  rw [ideal_ofList_eq_span_range_get (R := R) rs] at hb
  -- Induct on the presentation of `b` inside the span of the list entries.
  refine Submodule.span_induction (p := fun x _ ↦ x • m ∈
      LinearMap.range (listLinearCombination (R := R) (M := M) rs)) ?_ ?_ ?_ ?_ hb
  · intro x hx
    rcases hx with ⟨i, rfl⟩
    -- A single generator is realized by the basis vector supported at `i`.
    refine ⟨Pi.single i m, ?_⟩
    change ∑ x, rs.get x • (Pi.single i m) x = rs.get i • m
    simp [Pi.single_apply]
  · -- The zero scalar is represented by the zero tuple.
    refine ⟨0, ?_⟩
    simp [listLinearCombination]
  · intro x y hx hy hxmem hymem
    -- The range is a submodule, so it is closed under addition.
    simpa [add_smul] using
      Submodule.add_mem (LinearMap.range (listLinearCombination (R := R) (M := M) rs))
        hxmem hymem
  · intro a x _ hx
    -- Scalar multiples in the ideal correspond to scalar multiples inside the range.
    simpa [smul_smul, mul_comm, mul_left_comm, mul_assoc] using
      Submodule.smul_mem (LinearMap.range (listLinearCombination (R := R) (M := M) rs)) a hx

/-- Helper for Lemma 15.30.2: the tuple linear-combination map has range exactly the prefix ideal
times the whole module. This is the concrete algebra needed later to identify zeroth Koszul
homology with the quotient `M / (f_1, …, f_r)M`. -/
private theorem listLinearCombination_range_eq_ideal_smul_top (rs : List R) :
    LinearMap.range (listLinearCombination (R := R) (M := M) rs) =
      Ideal.ofList rs • (⊤ : Submodule R M) := by
  -- The forward inclusion is the easy algebraic half proved above.
  apply le_antisymm
  · exact listLinearCombination_range_le_ideal_smul_top (R := R) (M := M) rs
  · -- Induct on the submodule-smul presentation to reduce to a single prefix generator.
    intro x hx
    refine Submodule.smul_induction_on hx ?_ ?_
    · intro b hb m hm
      -- The strengthened scalar-action lemma handles the generator step directly.
      simpa using
        ideal_smul_mem_listLinearCombination_range (R := R) (M := M) (rs := rs) hb m
    · intro y z hy hz
      -- The range is a submodule, hence closed under addition.
      simpa using
        Submodule.add_mem (LinearMap.range (listLinearCombination (R := R) (M := M) rs)) hy hz

/-- Helper for Lemma 15.30.2: coercing the restricted degree-one Koszul differential back to the
ambient exterior algebra recovers contraction by the defining linear form. -/
@[simp] private theorem koszul_differential_linearMap_apply_coe
    {r : ℕ} (φ : (Fin r → R) →ₗ[R] R) (x : ⋀[R]^1 (Fin r → R)) :
    (koszulDifferentialLinearMap φ 0 x : ExteriorAlgebra R (Fin r → R)) =
      CliffordAlgebra.contractLeft φ x :=
  rfl

/-- Helper for Lemma 15.30.2: transporting a scalar through `⋀⁰(R^r) ≃ R` is just the scalar
inclusion into the ambient exterior algebra. -/
private theorem exteriorPower_zeroEquiv_symm_scalar_as_algebraMap (rs : List R) (a : R) :
    (((exteriorPower.zeroEquiv R (Fin rs.length → R)).symm a : ⋀[R]^0 (Fin rs.length → R)) :
      ExteriorAlgebra R (Fin rs.length → R)) =
      algebraMap R (ExteriorAlgebra R (Fin rs.length → R)) a := by
  -- The degree-zero exterior power is the copy of `R` generated by `1`.
  simpa [exteriorPower.zeroEquiv_symm_apply, ExteriorAlgebra.ιMulti,
    Algebra.algebraMap_eq_smul_one]

/-- Helper for Lemma 15.30.2: tensoring a linear map on the right acts on pure tensors by
applying the map to the second tensor factor. -/
private theorem tensorLeft_map_apply_tmul {N P : Type u}
    [AddCommGroup N] [Module R N] [AddCommGroup P] [Module R P]
    (φ : N →ₗ[R] P) (x : M) (y : N) :
    (((tensorLeft (ModuleCat.of R M)).map (ModuleCat.ofHom φ)).hom) (x ⊗ₜ[R] y) =
      x ⊗ₜ[R] φ y :=
  rfl

/-- Helper for Lemma 15.30.2: before tensoring with `M`, the first Koszul differential on the
family `rs.get` becomes the tuple linear form after transporting degree `1` and degree `0` through
`⋀¹(R^r) ≃ R^r` and `⋀⁰(R^r) ≃ R`. -/
private theorem first_koszul_differential_eq_linearForm (rs : List R) :
    (exteriorPower.zeroEquiv R (Fin rs.length → R)).toLinearMap.comp
        (koszulDifferentialLinearMap (koszulLinearForm rs.get) 0) =
      (koszulLinearForm rs.get).comp
        (exteriorPower.oneEquiv R (Fin rs.length → R)).toLinearMap := by
  -- Route correction: normalize the degree-one generator first, then transport the resulting
  -- degree-zero scalar through `⋀⁰(R^r) ≃ R`.
  apply exteriorPower.linearMap_ext
  ext m
  simp only [LinearMap.compAlternatingMap_apply, LinearMap.coe_comp, Function.comp_apply]
  have hone :
      (exteriorPower.oneEquiv R (Fin rs.length → R)) (exteriorPower.ιMulti R 1 m) = m 0 := by
    -- The degree-one transport identifies the generator with its unique coordinate.
    simpa using (exteriorPower.oneEquiv_ιMulti (R := R) (M := Fin rs.length → R) (f := m))
  have hone' :
      (koszulLinearForm rs.get)
          ((exteriorPower.oneEquiv R (Fin rs.length → R)) (exteriorPower.ιMulti R 1 m)) =
        (koszulLinearForm rs.get) (m 0) := by
    -- Rewriting along the degree-one identification exposes the concrete scalar.
    simpa [hone]
  have hone'' :
      (koszulLinearForm rs.get)
          ((exteriorPower.oneEquiv R (Fin rs.length → R)).toLinearMap
            (exteriorPower.ιMulti R 1 m)) =
        (koszulLinearForm rs.get) (m 0) := by
    -- The same rewrite works after viewing `oneEquiv` as a linear map.
    simpa using hone'
  rw [hone'']
  apply_fun (exteriorPower.zeroEquiv R (Fin rs.length → R)).symm using
    (exteriorPower.zeroEquiv R (Fin rs.length → R)).symm.injective
  simp only [Nat.reduceAdd, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply, Fin.isValue]
  -- Compare the resulting degree-zero classes in the ambient exterior algebra.
  apply Subtype.ext
  rw [exteriorPower_zeroEquiv_symm_scalar_as_algebraMap
    (R := R) (rs := rs) ((koszulLinearForm rs.get) (m 0))]
  simpa [koszul_differential_linearMap_apply_coe, ExteriorAlgebra.ιMulti,
    Algebra.algebraMap_eq_smul_one] using
    (CliffordAlgebra.contractLeft_ι
      (Q := (0 : QuadraticForm R (Fin rs.length → R)))
      (d := koszulLinearForm rs.get) (x := m 0))

/-- Helper for Lemma 15.30.2: after transporting `Fin rs.length → M` back to a tensor product,
the tensorized tuple linear form sends the `i`th basis vector to `rs[i] • x`. -/
private theorem tensor_koszul_linearForm_on_single (rs : List R) (i : Fin rs.length) (x : M) :
    (((TensorProduct.piScalarRight R R M (Fin rs.length)).toModuleIso.inv ≫
        (tensorLeft (ModuleCat.of R M)).map (ModuleCat.ofHom (koszulLinearForm rs.get)) ≫
        (TensorProduct.rid R M).toModuleIso.hom).hom) (Pi.single i x) =
      rs.get i • x := by
  -- First rewrite the basis vector through `TensorProduct.piScalarRight`.
  change
    (TensorProduct.rid R M)
      (((tensorLeft (ModuleCat.of R M)).map (ModuleCat.ofHom (koszulLinearForm rs.get))).hom
        (((TensorProduct.piScalarRight R R M (Fin rs.length)).symm) (Pi.single i x))) =
      rs.get i • x
  have hsingle :
      ((TensorProduct.piScalarRight R R M (Fin rs.length)).symm) (Pi.single i x) =
        x ⊗ₜ[R] (Pi.single i (1 : R)) := by
    -- `piScalarRight` identifies the tensor basis element with the corresponding supported tuple.
    apply (TensorProduct.piScalarRight R R M (Fin rs.length)).injective
    ext j
    simp [Pi.single_apply]
  rw [hsingle, tensorLeft_map_apply_tmul]
  have hcoeff : koszulLinearForm rs.get (Pi.single i (1 : R)) = rs.get i := by
    -- The tuple linear form picks out the `i`th coefficient on the supported basis vector.
    simp [koszulLinearForm, Module.piEquiv_apply_apply, Pi.single_apply]
  -- After tensoring the linear form and collapsing the right tensor factor, only the scalar
  -- `rs[i]` acting on `x` remains.
  simp [hcoeff]

/-- Helper for Lemma 15.30.2: after transporting the tensorized tuple linear form through
`TensorProduct.piScalarRight` and `TensorProduct.rid`, it becomes the concrete map
`listLinearCombination rs`. -/
private theorem tensor_koszul_linearForm_eq_listLinearCombination (rs : List R) :
    (TensorProduct.piScalarRight R R M (Fin rs.length)).toModuleIso.inv ≫
        (tensorLeft (ModuleCat.of R M)).map (ModuleCat.ofHom (koszulLinearForm rs.get)) ≫
        (TensorProduct.rid R M).toModuleIso.hom =
      ModuleCat.ofHom (listLinearCombination (R := R) (M := M) rs) := by
  -- Compare the two linear maps on supported basis vectors of `Fin rs.length → M`.
  apply ModuleCat.hom_ext
  change
    (((TensorProduct.piScalarRight R R M (Fin rs.length)).toModuleIso.inv ≫
        (tensorLeft (ModuleCat.of R M)).map (ModuleCat.ofHom (koszulLinearForm rs.get)) ≫
        (TensorProduct.rid R M).toModuleIso.hom).hom) =
      listLinearCombination (R := R) (M := M) rs
  apply LinearMap.pi_ext
  intro i x
  -- The left side is the basis-vector computation proved above.
  rw [tensor_koszul_linearForm_on_single (R := R) (M := M) rs i x]
  -- The right side is the defining sum for `listLinearCombination`.
  simp [listLinearCombination, Pi.single_apply]

/-- Helper for Lemma 15.30.2: in the untensored family Koszul complex, the degree `1 → 0`
differential is the defining Koszul differential linear map in degree `0`. -/
private theorem koszul_complex_first_differential_eq_ofHom (rs : List R) :
    (K^•(rs.get)).d 1 0 =
      ModuleCat.ofHom (koszulDifferentialLinearMap (koszulLinearForm rs.get) 0) := by
  -- Unfold the family Koszul complex once so the categorical differential becomes the defining
  -- linear map on exterior powers.
  simpa [koszulComplex, koszulDifferential] using
    (ChainComplex.of_d ((ModuleCat.of R (Fin rs.length → R)).exteriorPower)
      (koszulDifferential (koszulLinearForm rs.get)) _ 0)

/-- Helper for Lemma 15.30.2: after transporting the untensored degree `1 → 0` Koszul
differential to concrete coordinates, it is exactly the tuple linear form `koszulLinearForm
rs.get`. -/
private theorem first_koszul_differential_transport_eq_linearForm (rs : List R) :
    (ModuleCat.exteriorPower.iso₁ (ModuleCat.of R (Fin rs.length → R))).inv ≫
        (K^•(rs.get)).d 1 0 ≫
        (ModuleCat.exteriorPower.iso₀ (ModuleCat.of R (Fin rs.length → R))).hom =
      ModuleCat.ofHom (koszulLinearForm rs.get) := by
  -- Compose the previously proved transport identity with the inverse of `⋀¹(R^r) ≃ R^r`.
  apply ModuleCat.hom_ext
  have htransport :=
    congrArg
      (fun ψ : ⋀[R]^1 (Fin rs.length → R) →ₗ[R] R ↦
        ψ.comp (exteriorPower.oneEquiv R (Fin rs.length → R)).symm.toLinearMap)
      (first_koszul_differential_eq_linearForm (R := R) (rs := rs))
  -- Rewrite the categorical first differential to the owner linear map and cancel the two degree-1
  -- coordinate changes.
  simpa [koszul_complex_first_differential_eq_ofHom (R := R) (rs := rs), LinearMap.comp_assoc]
    using htransport

/-- Helper for Lemma 15.30.2: degree `0` of the tensorized prefix Koszul complex is canonically
`M` after transporting `⋀⁰(R^r)` to `R`. -/
private noncomputable abbrev tensor_koszul_zero_term_iso (rs : List R) :
    (koszulComplexOnTensorLeft R M rs.get).X 0 ≅ ModuleCat.of R M :=
  ((tensorLeft (ModuleCat.of R M)).mapIso
      (ModuleCat.exteriorPower.iso₀ (ModuleCat.of R (Fin rs.length → R)))) ≪≫
    (TensorProduct.rid R M).toModuleIso

/-- Helper for Lemma 15.30.2: degree `1` of the tensorized prefix Koszul complex is canonically
`Fin rs.length → M` after transporting `⋀¹(R^r)` to `R^r` and then tensoring with the finite free
module `R^r`. -/
private noncomputable abbrev tensor_koszul_one_term_iso (rs : List R) :
    (koszulComplexOnTensorLeft R M rs.get).X 1 ≅ ModuleCat.of R (Fin rs.length → M) :=
  ((tensorLeft (ModuleCat.of R M)).mapIso
      (ModuleCat.exteriorPower.iso₁ (ModuleCat.of R (Fin rs.length → R)))) ≪≫
    (TensorProduct.piScalarRight R R M (Fin rs.length)).toModuleIso

/-- Helper for Lemma 15.30.2: the quotient module `M / (f_1, \ldots, f_r)M` attached to a prefix
list `rs`. -/
private noncomputable abbrev tensor_koszul_zero_quotient (rs : List R) : ModuleCat R :=
  ModuleCat.of R (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)))

/-- Helper for Lemma 15.30.2: the canonical degree-zero quotient map from the tensorized prefix
Koszul complex to `M / (f_1, \ldots, f_r)M`. -/
private noncomputable abbrev tensor_koszul_zero_quotientMap (rs : List R) :
    (koszulComplexOnTensorLeft R M rs.get).X 0 ⟶ tensor_koszul_zero_quotient (R := R) (M := M) rs :=
  (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom ≫
    ModuleCat.ofHom (Submodule.mkQ (Ideal.ofList rs • (⊤ : Submodule R M)))

/-- Helper for Lemma 15.30.2: after transporting degree `1` and degree `0` to concrete module
coordinates, the first differential of the tensorized prefix Koszul complex is exactly the tuple
linear-combination map. -/
private theorem tensor_koszul_first_differential_eq_listLinearCombination (rs : List R) :
    (tensor_koszul_one_term_iso (R := R) (M := M) rs).inv ≫
        (koszulComplexOnTensorLeft R M rs.get).d 1 0 ≫
        (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom =
      ModuleCat.ofHom (listLinearCombination (R := R) (M := M) rs) := by
  -- First peel off the degree-one and degree-zero tensor identifications so only the untensored
  -- first Koszul differential remains in the middle.
  calc
    (tensor_koszul_one_term_iso (R := R) (M := M) rs).inv ≫
        (koszulComplexOnTensorLeft R M rs.get).d 1 0 ≫
        (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom =
      (TensorProduct.piScalarRight R R M (Fin rs.length)).toModuleIso.inv ≫
          (tensorLeft (ModuleCat.of R M)).map
            ((ModuleCat.exteriorPower.iso₁ (ModuleCat.of R (Fin rs.length → R))).inv ≫
              (K^•(rs.get)).d 1 0 ≫
              (ModuleCat.exteriorPower.iso₀ (ModuleCat.of R (Fin rs.length → R))).hom) ≫
          (TensorProduct.rid R M).toModuleIso.hom := by
            simp [tensor_koszul_one_term_iso, tensor_koszul_zero_term_iso, koszulComplexOnTensorLeft,
              Category.assoc, CategoryTheory.Functor.mapHomologicalComplex_obj_d]
    _ =
      (TensorProduct.piScalarRight R R M (Fin rs.length)).toModuleIso.inv ≫
          (tensorLeft (ModuleCat.of R M)).map (ModuleCat.ofHom (koszulLinearForm rs.get)) ≫
          (TensorProduct.rid R M).toModuleIso.hom := by
            -- Transport the untensored differential to the concrete tuple linear form.
            rw [first_koszul_differential_transport_eq_linearForm (R := R) (rs := rs)]
    _ = ModuleCat.ofHom (listLinearCombination (R := R) (M := M) rs) := by
          -- The remaining tensor-model comparison was already computed on supported basis vectors.
          exact tensor_koszul_linearForm_eq_listLinearCombination (R := R) (M := M) rs

/-- Helper for Lemma 15.30.2: after transporting degree `1` to `Fin rs.length → M`, the image of
the first tensorized Koszul differential is `(f_1, \ldots, f_r)M`. -/
private theorem tensor_koszul_first_differential_range_eq_ideal_smul_top (rs : List R) :
    LinearMap.range
        (((tensor_koszul_one_term_iso (R := R) (M := M) rs).inv ≫
            (koszulComplexOnTensorLeft R M rs.get).d 1 0 ≫
            (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom) =
      Ideal.ofList rs • (⊤ : Submodule R M) := by
  -- The transported first differential is `listLinearCombination rs`, whose image is already
  -- identified with the prefix ideal times the whole module.
  rw [tensor_koszul_first_differential_eq_listLinearCombination (R := R) (M := M) rs]
  simpa using listLinearCombination_range_eq_ideal_smul_top (R := R) (M := M) rs

/-- Helper for Lemma 15.30.2: after transporting only degree `0` to `M`, the image of the first
tensorized Koszul differential is still `(f_1, \ldots, f_r)M`. This is the exact form needed by
the quotient short-complex argument. -/
private theorem tensor_koszul_first_differential_post_zero_range_eq_ideal_smul_top (rs : List R) :
    LinearMap.range
        ((((koszulComplexOnTensorLeft R M rs.get).d 1 0) ≫
            (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom) =
      Ideal.ofList rs • (⊤ : Submodule R M) := by
  -- The degree-one transport is an isomorphism, so it does not change the image submodule.
  rw [← tensor_koszul_first_differential_range_eq_ideal_smul_top (R := R) (M := M) rs]
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    refine ⟨(tensor_koszul_one_term_iso (R := R) (M := M) rs).hom.hom y, ?_⟩
    have hy :
        (tensor_koszul_one_term_iso (R := R) (M := M) rs).inv.hom
            ((tensor_koszul_one_term_iso (R := R) (M := M) rs).hom.hom y) = y := by
      simpa using congrArg (fun k ↦ k.hom y)
        ((tensor_koszul_one_term_iso (R := R) (M := M) rs).hom_inv_id)
    simpa [Category.assoc] using congrArg
      (fun z ↦
        ((((koszulComplexOnTensorLeft R M rs.get).d 1 0) ≫
            (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom) z) hy
  · rintro ⟨y, hy⟩
    refine ⟨(tensor_koszul_one_term_iso (R := R) (M := M) rs).inv.hom y, ?_⟩
    simpa [tensor_koszul_one_term_iso, Category.assoc] using hy

/-- Helper for Lemma 15.30.2: the degree-zero quotient map kills the first differential of the
tensorized prefix Koszul complex. -/
private theorem tensor_koszul_first_differential_comp_zero_quotientMap (rs : List R) :
    (koszulComplexOnTensorLeft R M rs.get).d 1 0 ≫
        tensor_koszul_zero_quotientMap (R := R) (M := M) rs = 0 := by
  -- The quotient annihilates the image of the first differential because that image is exactly
  -- `(f_1, \ldots, f_r)M`.
  ext x
  have hxmem :
      ((((koszulComplexOnTensorLeft R M rs.get).d 1 0) ≫
          (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom) x ∈
        Ideal.ofList rs • (⊤ : Submodule R M) := by
    rw [← tensor_koszul_first_differential_post_zero_range_eq_ideal_smul_top
      (R := R) (M := M) rs]
    exact ⟨x, rfl⟩
  change
    Submodule.mkQ (Ideal.ofList rs • (⊤ : Submodule R M))
        ((((tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom)
          ((((koszulComplexOnTensorLeft R M rs.get).d 1 0).hom) x)) =
      0
  exact (Submodule.Quotient.mk_eq_zero _).2 hxmem

/-- Helper for Lemma 15.30.2: the degree `1 → 0 → M / (f_1, \ldots, f_r)M` short complex for the
tensorized prefix Koszul complex is exact. -/
private theorem tensor_koszul_first_shortComplex_exact (rs : List R) :
    (ShortComplex.mk
      ((koszulComplexOnTensorLeft R M rs.get).d 1 0)
      (tensor_koszul_zero_quotientMap (R := R) (M := M) rs)
      (tensor_koszul_first_differential_comp_zero_quotientMap (R := R) (M := M) rs)).Exact := by
  -- Compare the kernel of the quotient map with the image of the first differential after
  -- transporting degree `0` to the concrete module `M`.
  rw [ShortComplex.moduleCat_exact_iff_range_eq_ker]
  ext x
  constructor
  · rintro ⟨y, rfl⟩
    have hyzero :=
      congrArg (fun k ↦ k.hom y)
        (tensor_koszul_first_differential_comp_zero_quotientMap (R := R) (M := M) rs)
    simpa using hyzero
  · intro hx
    have hxmem :
        (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom.hom x ∈
          Ideal.ofList rs • (⊤ : Submodule R M) := by
      change
        Submodule.mkQ (Ideal.ofList rs • (⊤ : Submodule R M))
            (((tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom x) = 0 at hx
      exact (Submodule.Quotient.mk_eq_zero _).1 hx
    rw [← tensor_koszul_first_differential_post_zero_range_eq_ideal_smul_top
      (R := R) (M := M) rs] at hxmem
    rcases hxmem with ⟨y, hy⟩
    refine ⟨y, ?_⟩
    have hinj :
        Function.Injective
          (ModuleCat.Hom.hom ((tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom)) :=
      (ModuleCat.mono_iff_injective
        ((tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom)).1 inferInstance
    apply hinj
    simpa [Category.assoc] using hy

/-- Helper for Lemma 15.30.2: the concrete quotient map is a cokernel of the first differential of
the tensorized prefix Koszul complex. -/
private theorem tensor_koszul_zero_quotientMap_is_cokernel (rs : List R) :
    Nonempty
      (IsColimit
        (CokernelCofork.ofπ
          (tensor_koszul_zero_quotientMap (R := R) (M := M) rs)
          (tensor_koszul_first_differential_comp_zero_quotientMap (R := R) (M := M) rs))) := by
  -- Package the exact degree `1 → 0 → quotient` row as the universal cokernel cofork.
  have hEpi :
      Epi (tensor_koszul_zero_quotientMap (R := R) (M := M) rs) := by
    rw [ModuleCat.epi_iff_surjective]
    intro x
    obtain ⟨y, rfl⟩ :=
      Submodule.mkQ_surjective (Ideal.ofList rs • (⊤ : Submodule R M)) x
    refine ⟨(tensor_koszul_zero_term_iso (R := R) (M := M) rs).inv.hom y, ?_⟩
    change
      Submodule.mkQ (Ideal.ofList rs • (⊤ : Submodule R M))
          (((tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom
            (((tensor_koszul_zero_term_iso (R := R) (M := M) rs).inv).hom y)) =
        Submodule.mkQ (Ideal.ofList rs • (⊤ : Submodule R M)) y
    have hy :
        (((tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom
          (((tensor_koszul_zero_term_iso (R := R) (M := M) rs).inv).hom y)) = y := by
      change
        (((tensor_koszul_zero_term_iso (R := R) (M := M) rs).inv ≫
          (tensor_koszul_zero_term_iso (R := R) (M := M) rs).hom).hom y) = y
      simpa using congrArg
        (fun k ↦ k.hom y)
        ((tensor_koszul_zero_term_iso (R := R) (M := M) rs).inv_hom_id)
    exact congrArg (Submodule.mkQ (Ideal.ofList rs • (⊤ : Submodule R M))) hy
  let S : ShortComplex (ModuleCat R) :=
    ShortComplex.mk
      ((koszulComplexOnTensorLeft R M rs.get).d 1 0)
      (tensor_koszul_zero_quotientMap (R := R) (M := M) rs)
      (tensor_koszul_first_differential_comp_zero_quotientMap (R := R) (M := M) rs)
  letI : Epi S.g := by
    simpa [S] using hEpi
  exact
    (ShortComplex.exact_and_epi_g_iff_g_is_cokernel (S := S)).1
      ⟨by simpa [S] using tensor_koszul_first_shortComplex_exact (R := R) (M := M) rs,
        inferInstance⟩

/-- Helper for Lemma 15.30.2: the zeroth homology of the tensorized prefix Koszul complex is the
quotient `M / (f_1, \ldots, f_r)M`. -/
