import Mathlib
import StacksProject_2024.stacks_project.Chap15.Definition_15_30_1
import StacksProject_2024.stacks_project.Chap15.Lemma_15_90_6

-- Declarations for this item will be appended below by the statement pipeline.

universe u

namespace RingTheory.Sequence

variable {A : Type u} [CommRing A]

open CategoryTheory
open CategoryTheory.Abelian
open CategoryTheory.Abelian.Ext

namespace Ideal

/-- Helper for Lemma 15.30.12: the canonical list-generated ideal attached to `f : Fin n → A`
agrees with the span of its image. -/
private theorem ofList_ofFn_eq_span_range_local {n : ℕ} (f : Fin n → A) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  ext x
  simp [Ideal.ofList, List.mem_ofFn', Set.range]

end Ideal

/-- Helper for Lemma 15.30.12: the canonical prefix ideal generated by the family `f`. -/
private abbrev quotient_tail_prefix_ideal {n : ℕ} (f : Fin n → A) : Ideal A :=
  Ideal.ofList (List.ofFn f)

/-- Helper for Lemma 15.30.12: the quotient ring by the canonical prefix ideal. -/
private abbrev quotient_tail_ring {n : ℕ} (f : Fin n → A) :=
  A ⧸ quotient_tail_prefix_ideal f

/-- Helper for Lemma 15.30.12: the image family of `g` in the quotient by the prefix ideal of
`f`. -/
private abbrev quotient_tail_family {n m : ℕ} (f : Fin n → A) (g : Fin m → A) :
    Fin m → quotient_tail_ring f :=
  fun j ↦ Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (g j)

/-- Helper for Lemma 15.30.12: the owner `H_1`-regularity predicate is equivalent to vanishing of
the source-facing first Koszul homology object `koszulH1`. -/
private theorem isH1RegularSequence_iff_isZero_koszulH1_local {r : ℕ} (s : Fin r → A) :
    IsH1RegularSequence s ↔ CategoryTheory.Limits.IsZero (koszulH1 s A) := by
  sorry

/-- Helper for Lemma 15.30.12: `H₁`-regularity forces the degree-one Koszul presentation to be
subsingleton. -/
private theorem subsingleton_koszulH1Presentation_of_isH1RegularSequence_local {r : ℕ}
    (s : Fin r → A) (hs : IsH1RegularSequence s) :
    Subsingleton (koszulH1Presentation s A) := by
  -- Rewrite `H₁`-regularity as vanishing of the owner first Koszul homology object.
  have hzero : CategoryTheory.Limits.IsZero (koszulH1 s A) :=
    (isH1RegularSequence_iff_isZero_koszulH1_local s).1 hs
  -- Then transport that vanishing to the explicit presentation quotient.
  have hzeroPresentation :
      CategoryTheory.Limits.IsZero (ModuleCat.of A (koszulH1Presentation s A)) :=
    (koszulH1IsoPresentation s A).isZero_iff.mp hzero
  exact (ModuleCat.isZero_iff_subsingleton).1 hzeroPresentation

/-- Helper for Lemma 15.30.12: if the first Koszul presentation is subsingleton, then every map
out of the generated ideal is diagonal. -/
private theorem ideal_hom_eq_diagonal_of_subsingleton_presentation {r : ℕ} (s : Fin r → A)
    (N : Type u) [AddCommGroup N] [Module A N]
    (hsub : Subsingleton (koszulH1Presentation s N))
    (φ : Ideal.span (Set.range s) →ₗ[A] N) :
    ∃ a : N, φ = spanToIdealSpanHom s N a := by
  -- In a subsingleton presentation, every presentation class is already zero.
  have hφzero : idealSpanHomToKoszulH1Presentation s N φ = (0 : koszulH1Presentation s N) :=
    hsub.elim _ _
  have hφmem :
      φ ∈ LinearMap.ker (idealSpanHomToKoszulH1Presentation s N) := by
    simpa [LinearMap.mem_ker] using hφzero
  -- The kernel description from Lemma `15.90.6` identifies those maps with diagonals.
  rw [idealSpanHomToKoszulH1Presentation_ker_eq_range_spanToIdealSpanHom] at hφmem
  rcases hφmem with ⟨a, ha⟩
  exact ⟨a, ha.symm⟩

/-- Helper for Lemma 15.30.12: `H₁`-regularity forces the append-side relation kernel to be
subsingleton. -/
private theorem relation_kernel_subsingleton_of_isH1RegularSequence_local {r : ℕ}
    (s : Fin r → A) (hs : IsH1RegularSequence s) :
    Subsingleton (idealGeneratorRelationKernel s) := by
  sorry

/-- Helper for Lemma 15.30.12: a quotient relation among the images of `g` lifts to one relation
among the appended family `Fin.append f g` in `A`. -/
private theorem exists_append_relation_lift_of_quotient_tail_relation {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (w : Fin m → quotient_tail_ring f)
    (hw :
      (idealGeneratorRelationModuleToSpan (quotient_tail_family f g))
          ((idealGeneratorRelationSubmodule (quotient_tail_family f g)).mkQ w) = 0) :
    ∃ a : Fin m → A, ∃ b : Fin n → A,
      (∀ j, Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (a j) = w j) ∧
        (∑ j, g j * a j) + ∑ i, f i * b i = 0 := by
  -- Lift each quotient coefficient to `A`; these are the tail coordinates in the source proof.
  choose a ha using fun j ↦ Ideal.Quotient.mk_surjective (I := quotient_tail_prefix_ideal f) (w j)
  have hsum_zero :
      Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (∑ j, g j * a j) = 0 := by
    -- Rewrite the quotient relation map on the chosen representative and forget the ideal subtype.
    have hw' :
        ((idealGeneratorRelationModuleToSpan (quotient_tail_family f g))
            ((idealGeneratorRelationSubmodule (quotient_tail_family f g)).mkQ w) :
          quotient_tail_ring f) = 0 := by
      exact congrArg Subtype.val hw
    have hspan :
        ((idealGeneratorRelationModuleToSpan (quotient_tail_family f g))
            ((idealGeneratorRelationSubmodule (quotient_tail_family f g)).mkQ w) :
          quotient_tail_ring f) =
          ∑ j : Fin m, (quotient_tail_family f g) j * w j := by
      exact congrArg Subtype.val
        (idealGeneratorRelationModuleToSpan_apply_mkQ (f := quotient_tail_family f g) w)
    calc
      Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (∑ j, g j * a j)
          = ∑ j : Fin m, (quotient_tail_family f g) j * w j := by
              simpa [quotient_tail_family, ha, map_sum, map_mul]
      _ =
          ((idealGeneratorRelationModuleToSpan (quotient_tail_family f g))
              ((idealGeneratorRelationSubmodule (quotient_tail_family f g)).mkQ w) :
            quotient_tail_ring f) := by
              symm
              exact hspan
      _ = 0 := hw'
  have hmem :
      -(∑ j, g j * a j) ∈ Ideal.span (Set.range f) := by
    -- Vanishing in the quotient means the lifted scalar lies in the prefix ideal.
    rw [← Ideal.ofList_ofFn_eq_span_range_local f]
    exact (Ideal.Quotient.eq_zero_iff_mem).1 <| by
      simpa [map_neg] using hsum_zero
  obtain ⟨b, hb⟩ := Ideal.mem_span_range_iff_exists_fun.mp hmem
  have hb' : ∑ i, f i * b i = -(∑ j, g j * a j) := by
    calc
      ∑ i, f i * b i = ∑ i, b i * f i := by
        refine Finset.sum_congr rfl ?_
        intro i _
        rw [mul_comm]
      _ = -(∑ j, g j * a j) := by
        simpa [eq_comm] using hb
  refine ⟨a, b, ha, ?_⟩
  -- Move the prefix contribution to the right-hand side and then close by the chosen coefficients.
  calc
    (∑ j, g j * a j) + ∑ i, f i * b i
        = (∑ j, g j * a j) + (-(∑ j, g j * a j)) := by rw [hb']
    _ = 0 := by simp

/-- Helper for Lemma 15.30.12: the lifted append tuple attached to a quotient relation really is
an append-side relation upstairs. -/
private theorem lifted_append_relation_mem_kernel {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (a : Fin m → A) (b : Fin n → A)
    (hsum : (∑ j, g j * a j) + ∑ i, f i * b i = 0) :
    ((idealGeneratorRelationSubmodule (Fin.append f g)).mkQ (Fin.append b a)) ∈
      idealGeneratorRelationKernel (Fin.append f g) := by
  -- Proof comment: by definition the append-side kernel consists of relation-module classes whose
  -- canonical image in the generated ideal vanishes, so we evaluate that map on the lifted tuple.
  rw [LinearMap.mem_ker]
  apply Subtype.ext
  have hspan :
      ((idealGeneratorRelationModuleToSpan (Fin.append f g))
          ((idealGeneratorRelationSubmodule (Fin.append f g)).mkQ (Fin.append b a)) : A) =
        ∑ i : Fin (n + m), (Fin.append f g) i * (Fin.append b a) i := by
    exact congrArg Subtype.val
      (idealGeneratorRelationModuleToSpan_apply_mkQ (f := Fin.append f g) (Fin.append b a))
  have hsum' :
      ∑ i : Fin (n + m), (Fin.append f g) i * (Fin.append b a) i = 0 := by
    calc
      ∑ i : Fin (n + m), (Fin.append f g) i * (Fin.append b a) i
          = (∑ i : Fin n, f i * b i) + ∑ j : Fin m, g j * a j := by
              simpa [Fin.append, add_comm, add_left_comm, add_assoc] using
                (Fin.sum_univ_add
                  (f := fun i : Fin (n + m) ↦ (Fin.append f g) i * (Fin.append b a) i))
      _ = 0 := by
            simpa [add_comm] using hsum
  calc
    ((idealGeneratorRelationModuleToSpan (Fin.append f g))
        ((idealGeneratorRelationSubmodule (Fin.append f g)).mkQ (Fin.append b a)) : A)
        = ∑ i : Fin (n + m), (Fin.append f g) i * (Fin.append b a) i := hspan
    _ = 0 := hsum'

/-- Helper for Lemma 15.30.12: the specific lifted append relation becomes zero once the appended
family is `H₁`-regular. -/
private theorem append_lifted_relation_class_zero_of_h1 {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (hfg : IsH1RegularSequence (Fin.append f g))
    (a : Fin m → A) (b : Fin n → A)
    (hsum : (∑ j, g j * a j) + ∑ i, f i * b i = 0) :
    ((idealGeneratorRelationSubmodule (Fin.append f g)).mkQ (Fin.append b a)) = 0 := by
  let z : idealGeneratorRelationKernel (Fin.append f g) :=
    ⟨(idealGeneratorRelationSubmodule (Fin.append f g)).mkQ (Fin.append b a),
      lifted_append_relation_mem_kernel f g a b hsum⟩
  have hsub :
      Subsingleton (idealGeneratorRelationKernel (Fin.append f g)) :=
    relation_kernel_subsingleton_of_isH1RegularSequence_local (Fin.append f g) hfg
  have hz : z = 0 := hsub.elim z 0
  -- Proof comment: forgetting the kernel subtype turns the append-side kernel equality into the
  -- desired zero statement in the relation module.
  exact congrArg Subtype.val hz

/-- Helper for Lemma 15.30.12: a zero append-side trivial-relation class descends to a zero class
for the quotient tail family. -/
private theorem append_relation_zero_descends_to_quotient_tail_kernel {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (a : Fin m → A) (b : Fin n → A)
    (hzero :
      ((idealGeneratorRelationSubmodule (Fin.append f g)).mkQ (Fin.append b a)) = 0) :
    ((idealGeneratorRelationSubmodule (quotient_tail_family f g)).mkQ
      (fun j ↦ Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (a j))) = 0 := by
  sorry

/-- Helper for Lemma 15.30.12: quotienting an element of the append ideal lands in the tail ideal
of the quotient family. -/
private theorem append_span_image_mem_quotient_tail_span {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) {x : A}
    (hx : x ∈ Ideal.span (Set.range (Fin.append f g))) :
    Ideal.Quotient.mk (quotient_tail_prefix_ideal f) x ∈
      Ideal.span (Set.range (quotient_tail_family f g)) := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hx
  refine Ideal.mem_span_range_iff_exists_fun.mpr ⟨
    fun j ↦ Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (c (Fin.natAdd n j)),
    ?_⟩
  have hsplit :
      ∑ i : Fin (n + m), c i * (Fin.append f g) i =
        (∑ i : Fin n, c (Fin.castAdd m i) * f i) + ∑ j : Fin m, c (Fin.natAdd n j) * g j := by
    -- Proof comment: split the append sum into its prefix and tail pieces.
    simpa [Fin.append, add_comm, add_left_comm, add_assoc] using
      (Fin.sum_univ_add (f := fun i : Fin (n + m) ↦ c i * (Fin.append f g) i))
  have hprefix_zero :
      Ideal.Quotient.mk (quotient_tail_prefix_ideal f)
        (∑ i : Fin n, c (Fin.castAdd m i) * f i) = 0 := by
    -- Proof comment: each prefix generator already vanishes in the quotient by `(f₁, ..., fₙ)`.
    rw [map_sum]
    refine Finset.sum_eq_zero ?_
    intro i hi
    rw [map_mul]
    have hfi :
        Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (f i) = 0 := by
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      rw [quotient_tail_prefix_ideal, Ideal.ofList_ofFn_eq_span_range_local]
      exact Ideal.subset_span (Set.mem_range_self i)
    simp [hfi]
  -- Proof comment: map the append-side coefficient expression to the quotient and discard the
  -- prefix terms that become zero there.
  calc
    ∑ j : Fin m,
        Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (c (Fin.natAdd n j)) *
          quotient_tail_family f g j
        = Ideal.Quotient.mk (quotient_tail_prefix_ideal f)
            (∑ j : Fin m, c (Fin.natAdd n j) * g j) := by
              simp [quotient_tail_family, map_sum, map_mul]
    _ = Ideal.Quotient.mk (quotient_tail_prefix_ideal f)
          ((∑ i : Fin n, c (Fin.castAdd m i) * f i) + ∑ j : Fin m, c (Fin.natAdd n j) * g j) := by
            rw [map_add, hprefix_zero, zero_add]
    _ = Ideal.Quotient.mk (quotient_tail_prefix_ideal f)
          (∑ i : Fin (n + m), c i * (Fin.append f g) i) := by
            rw [hsplit]
    _ = Ideal.Quotient.mk (quotient_tail_prefix_ideal f) x := by rw [hc]

/-- Helper for Lemma 15.30.12: the quotient map on `A` restricts to the canonical map from the
append ideal to the quotient-tail ideal. -/
private def append_span_to_quotient_tail_span {n m : ℕ} (f : Fin n → A) (g : Fin m → A) :
    Ideal.span (Set.range (Fin.append f g)) →ₗ[A]
      Ideal.span (Set.range (quotient_tail_family f g)) := sorry

/-- Helper for Lemma 15.30.12: the canonical append-to-quotient ideal map is computed by applying
the quotient map to the underlying ring element. -/
private theorem append_span_to_quotient_tail_span_apply {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A)
    (x : Ideal.span (Set.range (Fin.append f g))) :
    ((append_span_to_quotient_tail_span f g x :
        Ideal.span (Set.range (quotient_tail_family f g))) :
      quotient_tail_ring f) =
      Ideal.Quotient.mk (quotient_tail_prefix_ideal f) (x : A) :=
  by
    sorry

/-- Helper for Lemma 15.30.12: every element of the quotient-tail ideal has a preimage in the
append ideal. -/
private theorem append_span_to_quotient_tail_span_surjective {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A)
    (y : Ideal.span (Set.range (quotient_tail_family f g))) :
    ∃ x : Ideal.span (Set.range (Fin.append f g)),
      append_span_to_quotient_tail_span f g x = y := by
  sorry

/-- Helper for Lemma 15.30.12: the append-side diagonal map factors through the canonical
append-to-quotient ideal map. -/
private theorem append_diagonal_factors_through_quotient_tail_span {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (b : quotient_tail_ring f) :
    spanToIdealSpanHom (Fin.append f g) (quotient_tail_ring f) b =
      ((spanToIdealSpanHom (quotient_tail_family f g) (quotient_tail_ring f) b)
        |> LinearMap.restrictScalars A).comp
        (append_span_to_quotient_tail_span f g) := by
  sorry

/-- Helper for Lemma 15.30.12: every quotient relation among the tail generators is already
trivial once the appended family is `H₁`-regular upstairs. -/
private theorem quotient_tail_source_consequences_of_append_h1 {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (hfg : IsH1RegularSequence (Fin.append f g)) :
    Subsingleton (idealGeneratorRelationKernel (quotient_tail_family f g)) ∧
      (∀ φ :
          Ideal.span (Set.range (quotient_tail_family f g)) →ₗ[quotient_tail_ring f]
            quotient_tail_ring f,
        ∃ b : quotient_tail_ring f,
          φ =
            spanToIdealSpanHom (quotient_tail_family f g) (quotient_tail_ring f) b) := by
  sorry

/-- Helper for Lemma 15.30.12: every quotient relation among the tail generators is already
trivial once the appended family is `H₁`-regular upstairs. -/
private theorem quotient_tail_relation_kernel_subsingleton_of_append_h1 {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (hfg : IsH1RegularSequence (Fin.append f g)) :
    Subsingleton (idealGeneratorRelationKernel (quotient_tail_family f g)) := by
  -- Proof comment: this is the first projection of the bundled source-proof package above.
  exact (quotient_tail_source_consequences_of_append_h1 f g hfg).1

/-- Helper for Lemma 15.30.12: every quotient-side map from the tail ideal is diagonal once the
appended family is `H₁`-regular upstairs. -/
private theorem quotient_tail_ideal_hom_eq_diagonal_of_append_h1 {n m : ℕ} (f : Fin n → A)
    (g : Fin m → A) (hfg : IsH1RegularSequence (Fin.append f g))
    (φ :
      Ideal.span (Set.range (quotient_tail_family f g)) →ₗ[quotient_tail_ring f]
        quotient_tail_ring f) :
    ∃ b : quotient_tail_ring f,
      φ =
        spanToIdealSpanHom (quotient_tail_family f g) (quotient_tail_ring f) b := by
  -- Proof comment: this is the second projection of the bundled source-proof package above.
  exact (quotient_tail_source_consequences_of_append_h1 f g hfg).2 φ

/-- Helper for Lemma 15.30.12: every quotient-side map out of the relation kernel is zero once the
appended family is `H₁`-regular upstairs. -/
private theorem quotient_tail_kernel_hom_zero_of_append_h1 {n m : ℕ} (f : Fin n → A)
    (g : Fin m → A) (hfg : IsH1RegularSequence (Fin.append f g))
    (ψ :
      idealGeneratorRelationKernel (quotient_tail_family f g) →ₗ[quotient_tail_ring f]
        quotient_tail_ring f) :
    ψ = 0 := by
  let qg := quotient_tail_family f g
  have hsub :
      Subsingleton (idealGeneratorRelationKernel qg) :=
    quotient_tail_relation_kernel_subsingleton_of_append_h1 f g hfg
  -- Once the quotient relation kernel is subsingleton, every linear map out of it is zero.
  ext z
  have hz : z = 0 := hsub.elim z 0
  simpa [hz]

/-- Helper for Lemma 15.30.12: once both quotient-side relation terms vanish, the quotient tail
presentation itself is subsingleton. -/
private theorem subsingleton_koszulH1Presentation_quotient_tail_of_append_h1 {n m : ℕ}
    (f : Fin n → A) (g : Fin m → A) (hfg : IsH1RegularSequence (Fin.append f g)) :
    Subsingleton
      (koszulH1Presentation (quotient_tail_family f g) (quotient_tail_ring f)) := by
  let qg := quotient_tail_family f g
  have hExtZero :
      ∀ e :
          Ext
            (ModuleCat.of (quotient_tail_ring f)
              (quotient_tail_ring f ⧸ Ideal.span (Set.range qg)))
            (ModuleCat.of (quotient_tail_ring f) (quotient_tail_ring f)) 1,
        e = 0 := by
    intro e
    obtain ⟨φ, rfl⟩ :=
      idealSpanHomToExt_surjective (f := qg) (N := quotient_tail_ring f) e
    rcases quotient_tail_ideal_hom_eq_diagonal_of_append_h1 f g hfg φ with ⟨b, rfl⟩
    -- Diagonal maps already die in the quotient-row connecting morphism.
    simpa [LinearMap.comp_apply] using
      LinearMap.congr_fun
        (idealSpanHomToExt_comp_spanToIdealSpanHom (f := qg) (N := quotient_tail_ring f)) b
  have hExtSub :
      Subsingleton
        (Ext
          (ModuleCat.of (quotient_tail_ring f)
            (quotient_tail_ring f ⧸ Ideal.span (Set.range qg)))
          (ModuleCat.of (quotient_tail_ring f) (quotient_tail_ring f)) 1) :=
    ⟨fun e₁ e₂ ↦ by rw [hExtZero e₁, hExtZero e₂]⟩
  have hqZero :
      ∀ q : koszulH1Presentation qg (quotient_tail_ring f), q = 0 := by
    intro q
    have hkernelZero :
        koszulH1PresentationToHomKernel qg (quotient_tail_ring f) q = 0 :=
      quotient_tail_kernel_hom_zero_of_append_h1 f g hfg
        (koszulH1PresentationToHomKernel qg (quotient_tail_ring f) q)
    have hqMem :
        q ∈ LinearMap.ker (koszulH1PresentationToHomKernel qg (quotient_tail_ring f)) := by
      simpa [LinearMap.mem_ker] using hkernelZero
    rw [← koszulExtToH1Presentation_range_eq_ker (f := qg) (N := quotient_tail_ring f)] at hqMem
    rcases hqMem with ⟨e, rfl⟩
    have heZero :
        e =
          (0 :
            Ext
              (ModuleCat.of (quotient_tail_ring f)
                (quotient_tail_ring f ⧸ Ideal.span (Set.range qg)))
              (ModuleCat.of (quotient_tail_ring f) (quotient_tail_ring f)) 1) :=
      hExtSub.elim e 0
    rw [heZero]
    simpa using (koszulExtToH1Presentation qg (quotient_tail_ring f)).map_zero
  refine ⟨fun q₁ q₂ ↦ by rw [hqZero q₁, hqZero q₂]⟩

/-
Domain triage:
* primary domain: `H₁`-regular and quasi-regular finite sequences in commutative algebra;
* sampled owner API:
  `Ideal.ofList`,
  `Ideal.ofList_ofFn_eq_span_range`,
  `RingTheory.Sequence.IsH1RegularSequence`,
  `RingTheory.Sequence.IsH1RegularOn.isQuasiRegular`,
  `RingTheory.Sequence.IsQuasiRegular.tail_quotient`;
* core/canonical owner abstraction: the canonical quotient-by-prefix and tail construction already
  organized by `IsQuasiRegular.tail_quotient`, with the prefix ideal canonically expressed as
  `Ideal.ofList (List.ofFn f)`;
* primitive data: the prefix `f` and the tail `g`;
  derived API: the source-facing quotient ring `A ⧸ Ideal.span (Set.range f)` and the quotient-side
  `H₁`-regularity statement for the image family of `g`;
* layer: `bridge/view`, since the public theorem keeps the source-facing quotient by
  `(f₁, \ldots, fₙ)` while the owner-level regular-sequence API is already organized around
  `Ideal.ofList (List.ofFn f)`.
-/

-- Proof sketch: first prove the quotient-side statement for the canonical prefix ideal
-- `Ideal.ofList (List.ofFn f)`, which is the owner-level quotient-by-prefix input for finite
-- sequences. Then rewrite that owner-level quotient to the source-facing ideal
-- `Ideal.span (Set.range f)`.
/-- Helper for Lemma 15.30.12: the owner-level quotient-tail statement over the canonical prefix
ideal `Ideal.ofList (List.ofFn f)`. -/
private theorem isH1RegularSequence_quotient_of_append_ofList {n m : ℕ} (f : Fin n → A)
    (g : Fin m → A) (hfg : IsH1RegularSequence (Fin.append f g)) :
    IsH1RegularSequence (quotient_tail_family f g) := by
  let B := quotient_tail_ring f
  let qg := quotient_tail_family f g
  have hsub :
      Subsingleton (koszulH1Presentation qg B) :=
    subsingleton_koszulH1Presentation_quotient_tail_of_append_h1 f g hfg
  -- Convert the quotient presentation vanishing back to the owner `H₁` predicate.
  have hzeroPresentation :
      CategoryTheory.Limits.IsZero (ModuleCat.of B (koszulH1Presentation qg B)) :=
    (ModuleCat.isZero_iff_subsingleton).2 hsub
  exact (isH1RegularSequence_iff_isZero_koszulH1_local qg).2
    ((koszulH1IsoPresentation qg B).isZero_iff.mpr hzeroPresentation)

/-- Lemma 15.30.12: if the concatenated family `f_1, \ldots, f_n, g_1, \ldots, g_m` is
`H_1`-regular in `A`, then the images of `g_1, \ldots, g_m` in `A / (f_1, \ldots, f_n)` form an
`H_1`-regular sequence. -/
theorem isH1RegularSequence_quotient_of_append {n m : ℕ} (f : Fin n → A) (g : Fin m → A)
    (hfg : IsH1RegularSequence (Fin.append f g)) :
    IsH1RegularSequence (fun i ↦ Ideal.Quotient.mk (Ideal.span (Set.range f)) (g i)) := by
  suffices hcanon :
      IsH1RegularSequence (fun i ↦ Ideal.Quotient.mk (Ideal.ofList (List.ofFn f)) (g i)) by
    rw [← Ideal.ofList_ofFn_eq_span_range_local f]
    exact hcanon
  -- Finish by invoking the owner-level statement over the canonical prefix ideal.
  exact isH1RegularSequence_quotient_of_append_ofList f g hfg

end RingTheory.Sequence
