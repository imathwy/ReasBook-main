import Mathlib
import Mathlib.Data.List.TFAE
import StacksProject_2024.Chap10.Lemma_10_68_6
import StacksProject_2024.Chap10.Lemma_10_69_6
import StacksProject_2024.Chap31.Lemma_31_20_3
import StacksProject_2024.Chap31.Lemma_31_20_7

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits
open Opposite
open RingTheory
open RingTheory.Sequence

noncomputable section

universe u

namespace AlgebraicGeometry

-- Semantic recall: `lean_leansearch` surfaced the canonical sequence-level owners
-- `RingTheory.Sequence.IsRegular`, `RingTheory.Sequence.IsQuasiRegular`, and the local-ring bridge
-- `IsLocalRing.isRegular_iff_isWeaklyRegular_of_subset_maximalIdeal`; the Chapter 31 owner API
-- provides `idealSheafStalkIdeal`, `IsRegularIdealSheaf`, `IsKoszulRegularIdealSheaf`,
-- `IsH1RegularIdealSheaf`, `IsQuasiRegularIdealSheaf`, and `Lemma_31_20_7` provides the
-- affine-local witness API `idealSheafSectionIdeal`.

section

variable {X : Scheme.{u}}

local notation "ModX" => RingedSpace.Modules X.toRingedSpace
local notation "𝒪X" => (SheafOfModules.unit X.ringCatSheaf : ModX)

section

variable [IsLocallyNoetherian X]
variable (I : Subobject 𝒪X)

local notation "ℐ" => (I : ModX)
local notation "𝒪X/ℐ" => (cokernel (I.arrow : ℐ ⟶ 𝒪X))

/-- Lemma 31.20.8 (1): let `X` be a locally Noetherian scheme, let `\mathcal J \subset \mathcal
O_X` be a quasi-coherent sheaf of ideals, and let `x` lie in the support of `\mathcal O_X /
\mathcal J`. Then the stalk ideal `\mathcal J_x` is generated by a regular sequence if and only
if it is represented on some affine neighbourhood of `x` by an ideal generated by a finite
regular sequence. -/
@[stacks 063I]
theorem stalkRegularIdeal_iff_exists_affine_regularSequence
    (hIqc : (Subobject.underlying.obj I).IsQuasicoherent)
    (x : X) (hx : x ∈ moduleSupport 𝒪X/ℐ) :
    (idealSheafStalkIdeal I x).IsRegularIdeal ↔
      ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens), ∃ r : ℕ,
        ∃ f : Fin r → X.presheaf.obj (op (U : X.Opens)),
          IsRegular (X.presheaf.obj (op (U : X.Opens))) (List.ofFn f) ∧
            idealSheafSectionIdeal I (U : X.Opens) = Ideal.span (Set.range f) := sorry

/-- Lemma 31.20.8 (2): under the same hypotheses, the stalk ideal `\mathcal J_x` is generated by
a Koszul-regular sequence if and only if it is represented on some affine neighbourhood of `x` by
an ideal generated by a finite Koszul-regular sequence. -/
@[stacks 063I]
theorem stalkKoszulRegularIdeal_iff_exists_affine_koszulRegularSequence
    (hIqc : (Subobject.underlying.obj I).IsQuasicoherent)
    (x : X) (hx : x ∈ moduleSupport 𝒪X/ℐ) :
    (idealSheafStalkIdeal I x).IsKoszulRegularIdeal ↔
      ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens), ∃ r : ℕ,
        ∃ f : Fin r → X.presheaf.obj (op (U : X.Opens)),
          IsKoszulRegularSequence f ∧
            idealSheafSectionIdeal I (U : X.Opens) = Ideal.span (Set.range f) := sorry

/-- Lemma 31.20.8 (3): under the same hypotheses, the stalk ideal `\mathcal J_x` is generated by
an `H_1`-regular sequence if and only if it is represented on some affine neighbourhood of `x` by
an ideal generated by a finite `H_1`-regular sequence. -/
@[stacks 063I]
theorem stalkH1RegularIdeal_iff_exists_affine_h1RegularSequence
    (hIqc : (Subobject.underlying.obj I).IsQuasicoherent)
    (x : X) (hx : x ∈ moduleSupport 𝒪X/ℐ) :
    (idealSheafStalkIdeal I x).IsH1RegularIdeal ↔
      ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens), ∃ r : ℕ,
        ∃ f : Fin r → X.presheaf.obj (op (U : X.Opens)),
          IsH1RegularSequence f ∧
            idealSheafSectionIdeal I (U : X.Opens) = Ideal.span (Set.range f) := sorry

/-- Lemma 31.20.8 (4): under the same hypotheses, the stalk ideal `\mathcal J_x` is generated by
a quasi-regular sequence if and only if it is represented on some affine neighbourhood of `x` by
an ideal generated by a finite quasi-regular sequence. -/
@[stacks 063I]
theorem stalkQuasiRegularIdeal_iff_exists_affine_quasiRegularSequence
    (hIqc : (Subobject.underlying.obj I).IsQuasicoherent)
    (x : X) (hx : x ∈ moduleSupport 𝒪X/ℐ) :
    (idealSheafStalkIdeal I x).IsQuasiRegularIdeal ↔
      ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens), ∃ r : ℕ,
        ∃ f : Fin r → X.presheaf.obj (op (U : X.Opens)),
          IsQuasiRegular (X.presheaf.obj (op (U : X.Opens))) (List.ofFn f) ∧
            idealSheafSectionIdeal I (U : X.Opens) = Ideal.span (Set.range f) := sorry

/-- In particular, on a locally Noetherian scheme, the notions of regular, Koszul-regular,
`H_1`-regular, and quasi-regular ideal sheaf agree. -/
@[stacks 063I]
theorem idealSheafRegularity_tfae :
    List.TFAE
      [ IsRegularIdealSheaf I
      , IsKoszulRegularIdealSheaf I
      , IsH1RegularIdealSheaf I
      , IsQuasiRegularIdealSheaf I
      ] := sorry

end

end

end AlgebraicGeometry
