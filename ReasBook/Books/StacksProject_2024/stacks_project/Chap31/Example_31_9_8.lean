import Mathlib
import StacksProject_2024.stacks_project.Chap15.Definition_15_105_1
import StacksProject_2024.stacks_project.Chap15.Definition_15_8_3

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits
open TopologicalSpace
open scoped FittingIdeal

noncomputable section

/- Semantic recall: `lean_leansearch` surfaced the affine spectrum coproduct map
`AlgebraicGeometry.sigmaSpec`, `PrimeSpectrum.zeroLocus_eq_singleton`, and flatness over
absolutely flat rings. Local Chapter 31 precedent states Fitting-rank factorization through
`Over.mk` and `Nonempty`, so this example is recorded by the explicit affine counterexample
ring, its finite-support ideal, and the resulting non-factorization of the identity morphism. -/

/-- The product ring `R = \prod_{n \in \mathbb N} \mathbf F_2` from Example 31.9.8. -/
@[stacks 0FJ0]
abbrev fittingCounterexampleRing :=
  ℕ → ZMod 2

/-- The ideal generated by the coordinate idempotents, i.e. the ideal of sequences with finite
support in `\prod_n \mathbf F_2`. -/
@[stacks 0FJ0]
def fittingCounterexampleFiniteSupportIdeal : Ideal fittingCounterexampleRing :=
  Ideal.span (Set.range fun n : ℕ ↦ Pi.single n (1 : ZMod 2))

/-- Membership in the finite-support ideal is the source condition that almost all components
are zero. -/
@[stacks 0FJ0]
theorem mem_fittingCounterexampleFiniteSupportIdeal_iff {a : fittingCounterexampleRing} :
    a ∈ fittingCounterexampleFiniteSupportIdeal ↔ {n : ℕ | a n ≠ 0}.Finite := sorry

/-- The quotient module `M = R / \mathfrak m` attached to a maximal ideal of the counterexample
ring. -/
@[stacks 0FJ0]
abbrev fittingCounterexampleModule (m : Ideal fittingCounterexampleRing) :=
  fittingCounterexampleRing ⧸ m

/-- The affine scheme `S = \operatorname{Spec}(R)` from the example. -/
@[stacks 0FJ0]
abbrev fittingCounterexampleSpectrum : Scheme :=
  Spec (CommRingCat.of fittingCounterexampleRing)

/-- The point of `\operatorname{Spec}(R)` corresponding to a maximal ideal
`\mathfrak m \supset I`. -/
@[stacks 0FJ0]
def fittingCounterexamplePoint (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal) :
    PrimeSpectrum fittingCounterexampleRing where
  asIdeal := m
  isPrime := hm.isPrime

/-- The open complement `S \setminus \{\mathfrak m\}` appearing in the attempted finite-type
version of the Fitting-rank decomposition. -/
@[stacks 0FJ0]
def fittingCounterexampleOpenComplement
    (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal) :
    fittingCounterexampleSpectrum.Opens :=
  ⟨({fittingCounterexamplePoint m hm} : Set (PrimeSpectrum fittingCounterexampleRing))ᶜ,
    ((PrimeSpectrum.isClosed_singleton_iff_isMaximal
      (fittingCounterexamplePoint m hm)).2 hm).isOpen_compl⟩

/-- The closed affine subscheme `Z_0 = \operatorname{Spec}(R / \mathfrak m)`. -/
@[stacks 0FJ0]
abbrev fittingCounterexampleClosedPointScheme (m : Ideal fittingCounterexampleRing) : Scheme :=
  Spec (CommRingCat.of (fittingCounterexampleRing ⧸ m))

/-- The closed immersion `\operatorname{Spec}(R / \mathfrak m) -> \operatorname{Spec}(R)`. -/
@[stacks 0FJ0]
abbrev fittingCounterexampleClosedPointι (m : Ideal fittingCounterexampleRing) :
    fittingCounterexampleClosedPointScheme m ⟶ fittingCounterexampleSpectrum :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk m))

/-- The disjoint union `(S \setminus Z_0) \amalg Z_0` from Example 31.9.8. -/
@[stacks 0FJ0]
abbrev fittingCounterexampleOpenClosedDecomposition
    (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal) : Scheme :=
  (fittingCounterexampleOpenComplement m hm).toScheme ⨿
    fittingCounterexampleClosedPointScheme m

/-- The canonical map `(S \setminus Z_0) \amalg Z_0 -> S`. -/
@[stacks 0FJ0]
abbrev fittingCounterexampleOpenClosedDecompositionι
    (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal) :
    fittingCounterexampleOpenClosedDecomposition m hm ⟶ fittingCounterexampleSpectrum :=
  coprod.desc (fittingCounterexampleOpenComplement m hm).ι
    (fittingCounterexampleClosedPointι m)

/-- Example 31.9.8 (1): the finite-support ideal is contained in a maximal ideal. -/
@[stacks 0FJ0]
theorem exists_maximalIdeal_containing_fittingCounterexampleFiniteSupportIdeal :
    ∃ m : Ideal fittingCounterexampleRing,
      m.IsMaximal ∧ fittingCounterexampleFiniteSupportIdeal ≤ m := sorry

/-- Example 31.9.8 (2): the ring `R = \prod_n \mathbf F_2` is absolutely flat. -/
@[stacks 0FJ0]
theorem fittingCounterexampleRing_isAbsolutelyFlat :
    IsAbsolutelyFlatRing fittingCounterexampleRing := sorry

/-- Example 31.9.8 (3): for a maximal ideal `\mathfrak m` containing the finite-support ideal,
the quotient module `M = R / \mathfrak m` is finite and flat over `R`. -/
@[stacks 0FJ0]
theorem fittingCounterexample_quotient_finite_flat
    (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal)
    (hI : fittingCounterexampleFiniteSupportIdeal ≤ m) :
    Module.Finite fittingCounterexampleRing (fittingCounterexampleModule m) ∧
      Module.Flat fittingCounterexampleRing (fittingCounterexampleModule m) := sorry

/-- Example 31.9.8 (4): the zeroth Fitting ideal of `R / \mathfrak m` cuts out
`\operatorname{Spec}(R / \mathfrak m)`. -/
@[stacks 0FJ0]
theorem fittingCounterexample_fittingIdeal_zero_eq
    (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal)
    (hI : fittingCounterexampleFiniteSupportIdeal ≤ m) :
    Fit[fittingCounterexampleRing]_(0)(fittingCounterexampleModule m) = m := sorry

/-- Example 31.9.8 (5): all positive Fitting ideals of `R / \mathfrak m` are the unit ideal,
so the higher closed subschemes `Z_i` are empty. -/
@[stacks 0FJ0]
theorem fittingCounterexample_fittingIdeal_succ_eq_top
    (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal)
    (hI : fittingCounterexampleFiniteSupportIdeal ≤ m) (i : ℕ) :
    Fit[fittingCounterexampleRing]_(i + 1)(fittingCounterexampleModule m) = ⊤ := sorry

/-- Example 31.9.8 (6): a maximal ideal containing the finite-support ideal is a non-isolated
point of `\operatorname{Spec}(R)`. -/
@[stacks 0FJ0]
theorem fittingCounterexample_point_not_isOpen_singleton
    (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal)
    (hI : fittingCounterexampleFiniteSupportIdeal ≤ m) :
    ¬ IsOpen ({fittingCounterexamplePoint m hm} :
      Set (PrimeSpectrum fittingCounterexampleRing)) := sorry

/-- Example 31.9.8 (7): the identity of `S = \operatorname{Spec}(R)` does not factor through
`(S \setminus Z_0) \amalg Z_0`; hence the finite-presentation hypothesis in the Fitting-flat
stratification cannot be weakened to finite type. -/
@[stacks 0FJ0]
theorem fittingCounterexample_identity_not_factor_through_openClosedDecomposition
    (m : Ideal fittingCounterexampleRing) (hm : m.IsMaximal)
    (hI : fittingCounterexampleFiniteSupportIdeal ≤ m) :
    ¬ Nonempty (Over.mk (𝟙 fittingCounterexampleSpectrum) ⟶
      Over.mk (fittingCounterexampleOpenClosedDecompositionι m hm)) := sorry
