open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits

noncomputable section

universe u

namespace AlgebraicGeometry

section IdealSheafRegularity

variable {X : Scheme.{u}}

local notation "ModX" => RingedSpace.Modules X.toRingedSpace
local notation "𝒪X" => (SheafOfModules.unit X.ringCatSheaf : RingedSpace.Modules X.toRingedSpace)

/-- A scheme ideal sheaf is regular if near every point of
`\operatorname{Supp}(\mathcal O_X / \mathcal I)` it is generated by a finite regular sequence of
local sections. -/
abbrev IsRegularIdealSheaf (I : Subobject 𝒪X) : Prop :=
  RingedSpace.IsRegularIdealSheaf I

/-- A scheme ideal sheaf is Koszul-regular if near every point of
`\operatorname{Supp}(\mathcal O_X / \mathcal I)` it is generated by a finite Koszul-regular
sequence of local sections. -/
abbrev IsKoszulRegularIdealSheaf (I : Subobject 𝒪X) : Prop :=
  RingedSpace.IsKoszulRegularIdealSheaf I

/-- A scheme ideal sheaf is `H_1`-regular if near every point of
`\operatorname{Supp}(\mathcal O_X / \mathcal I)` it is generated by a finite `H_1`-regular
sequence of local sections. -/
abbrev IsH1RegularIdealSheaf (I : Subobject 𝒪X) : Prop :=
  RingedSpace.IsH1RegularIdealSheaf I

/-- A scheme ideal sheaf is quasi-regular if near every point of
`\operatorname{Supp}(\mathcal O_X / \mathcal I)` it is generated by a finite quasi-regular
sequence of local sections. -/
abbrev IsQuasiRegularIdealSheaf (I : Subobject 𝒪X) : Prop :=
  RingedSpace.IsQuasiRegularIdealSheaf I

end IdealSheafRegularity

section ClosedImmersionRegularity

variable {X Z : Scheme.{u}}

/-- A closed immersion is regular if its ideal sheaf is regular. -/
@[mk_iff]
class IsRegularClosedImmersion (i : Z ⟶ X) : Prop
    extends IsClosedImmersion i where
  /-- The ideal sheaf of a regular closed immersion is regular. -/
  idealSheaf_isRegular :
    IsRegularIdealSheaf (closedImmersionIdealSubobject i)

/-- A Koszul-regular closed immersion has a Koszul-regular ideal sheaf. -/
@[mk_iff]
class IsKoszulRegularClosedImmersion (i : Z ⟶ X) : Prop
    extends IsClosedImmersion i where
  /-- The ideal sheaf of a Koszul-regular closed immersion is Koszul-regular. -/
  idealSheaf_isKoszulRegular :
    IsKoszulRegularIdealSheaf (closedImmersionIdealSubobject i)

/-- An `H_1`-regular closed immersion has an `H_1`-regular ideal sheaf. -/
@[mk_iff]
class IsH1RegularClosedImmersion (i : Z ⟶ X) : Prop
    extends IsClosedImmersion i where
  /-- The ideal sheaf of an `H_1`-regular closed immersion is `H_1`-regular. -/
  idealSheaf_isH1Regular :
    IsH1RegularIdealSheaf (closedImmersionIdealSubobject i)

/-- A quasi-regular closed immersion has a quasi-regular ideal sheaf. -/
@[mk_iff]
class IsQuasiRegularClosedImmersion (i : Z ⟶ X) : Prop
    extends IsClosedImmersion i where
  /-- The ideal sheaf of a quasi-regular closed immersion is quasi-regular. -/
  idealSheaf_isQuasiRegular :
    IsQuasiRegularIdealSheaf (closedImmersionIdealSubobject i)

end ClosedImmersionRegularity

section ClosedImmersionCompanions

variable {X Z : Scheme.{u}} (i : Z ⟶ X)

/-- A regular closed immersion has regular ideal sheaf. -/
instance instIsRegularIdealSheafClosedImmersionIdealSubobject
    [h : IsRegularClosedImmersion i] :
    IsRegularIdealSheaf (closedImmersionIdealSubobject i) :=
  h.idealSheaf_isRegular

/-- A Koszul-regular closed immersion has Koszul-regular ideal sheaf. -/
instance instIsKoszulRegularIdealSheafClosedImmersionIdealSubobject
    [h : IsKoszulRegularClosedImmersion i] :
    IsKoszulRegularIdealSheaf (closedImmersionIdealSubobject i) :=
  h.idealSheaf_isKoszulRegular

/-- An `H_1`-regular closed immersion has `H_1`-regular ideal sheaf. -/
instance instIsH1RegularIdealSheafClosedImmersionIdealSubobject
    [h : IsH1RegularClosedImmersion i] :
    IsH1RegularIdealSheaf (closedImmersionIdealSubobject i) :=
  h.idealSheaf_isH1Regular

/-- A quasi-regular closed immersion has quasi-regular ideal sheaf. -/
instance instIsQuasiRegularIdealSheafClosedImmersionIdealSubobject
    [h : IsQuasiRegularClosedImmersion i] :
    IsQuasiRegularIdealSheaf (closedImmersionIdealSubobject i) :=
  h.idealSheaf_isQuasiRegular

end ClosedImmersionCompanions

section ImmersionRegularity

variable {X Z : Scheme.{u}}

/-- Definition 31.21.1 (1): an immersion `i : Z ⟶ X` is a regular immersion if, after shrinking
the target to an open subscheme, `i` becomes a regular closed immersion. -/
@[stacks 063J, mk_iff]
class IsRegularImmersion (i : Z ⟶ X) : Prop extends IsImmersion i where
  /-- A regular immersion is locally a regular closed immersion. -/
  exists_isRegularClosedImmersion :
    ∃ U : X.Opens, ∃ j : Z ⟶ U.toScheme, IsRegularClosedImmersion j ∧ j ≫ U.ι = i

/-- Definition 31.21.1 (2): an immersion `i : Z ⟶ X` is a Koszul-regular immersion if, after
shrinking the target to an open subscheme, `i` becomes a Koszul-regular closed immersion. -/
@[stacks 063J, mk_iff]
class IsKoszulRegularImmersion (i : Z ⟶ X) : Prop
    extends IsImmersion i where
  /-- A Koszul-regular immersion is locally a Koszul-regular closed immersion. -/
  exists_isKoszulRegularClosedImmersion :
    ∃ U : X.Opens, ∃ j : Z ⟶ U.toScheme, IsKoszulRegularClosedImmersion j ∧ j ≫ U.ι = i

/-- Definition 31.21.1 (3): an immersion `i : Z ⟶ X` is an `H_1`-regular immersion if, after
shrinking the target to an open subscheme, `i` becomes an `H_1`-regular closed immersion. -/
@[stacks 063J, mk_iff]
class IsH1RegularImmersion (i : Z ⟶ X) : Prop extends IsImmersion i where
  /-- An `H_1`-regular immersion is locally an `H_1`-regular closed immersion. -/
  exists_isH1RegularClosedImmersion :
    ∃ U : X.Opens, ∃ j : Z ⟶ U.toScheme, IsH1RegularClosedImmersion j ∧ j ≫ U.ι = i

/-- Definition 31.21.1 (4): an immersion `i : Z ⟶ X` is a quasi-regular immersion if, after
shrinking the target to an open subscheme, `i` becomes a quasi-regular closed immersion. -/
@[stacks 063J, mk_iff]
class IsQuasiRegularImmersion (i : Z ⟶ X) : Prop
    extends IsImmersion i where
  /-- A quasi-regular immersion is locally a quasi-regular closed immersion. -/
  exists_isQuasiRegularClosedImmersion :
    ∃ U : X.Opens, ∃ j : Z ⟶ U.toScheme, IsQuasiRegularClosedImmersion j ∧ j ≫ U.ι = i

end ImmersionRegularity

section ImmersionCompanions

variable {X Z : Scheme.{u}} (i : Z ⟶ X)

/-- A regular immersion is locally a regular closed immersion. -/
theorem exists_restrict_isRegularClosedImmersion [h : IsRegularImmersion i] :
    ∃ U : X.Opens, ∃ j : Z ⟶ U.toScheme, IsRegularClosedImmersion j ∧ j ≫ U.ι = i :=
  h.exists_isRegularClosedImmersion

/-- A Koszul-regular immersion is locally a Koszul-regular closed immersion. -/
theorem exists_restrict_isKoszulRegularClosedImmersion
    [h : IsKoszulRegularImmersion i] :
    ∃ U : X.Opens, ∃ j : Z ⟶ U.toScheme, IsKoszulRegularClosedImmersion j ∧ j ≫ U.ι = i :=
  h.exists_isKoszulRegularClosedImmersion

/-- An `H_1`-regular immersion is locally an `H_1`-regular closed immersion. -/
theorem exists_restrict_isH1RegularClosedImmersion [h : IsH1RegularImmersion i] :
    ∃ U : X.Opens, ∃ j : Z ⟶ U.toScheme, IsH1RegularClosedImmersion j ∧ j ≫ U.ι = i :=
  h.exists_isH1RegularClosedImmersion

/-- A quasi-regular immersion is locally a quasi-regular closed immersion. -/
theorem exists_restrict_isQuasiRegularClosedImmersion
    [h : IsQuasiRegularImmersion i] :
    ∃ U : X.Opens, ∃ j : Z ⟶ U.toScheme, IsQuasiRegularClosedImmersion j ∧ j ≫ U.ι = i :=
  h.exists_isQuasiRegularClosedImmersion

end ImmersionCompanions

end AlgebraicGeometry
