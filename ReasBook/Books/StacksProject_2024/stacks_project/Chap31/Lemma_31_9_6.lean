open AlgebraicGeometry
open CategoryTheory
open TopologicalSpace

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme

-- Semantic recall: `lean_leansearch` surfaced the sheaf finite-presentation owner, while local
-- Chapter 31 precedent fixes the Fitting-locus owner as `Scheme.fittingIdealSheaf` and the
-- relevant module properties as `SheafOfModules.IsGeneratedBy` and
-- `SheafOfModules.IsFiniteLocallyFreeOfRank`.

/-- The open complement of the closed subscheme cut out by the `r`th Fitting ideal sheaf. -/
abbrev fittingOpenComplement
    {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) :
    Opens S :=
  idealSheafOpenComplement (fittingIdealSheaf F r)

/-- The locally closed rank-`r` Fitting locus, with the convention `Z_{-1} = S`. -/
private abbrev fittingRankLocus
    {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] : ℕ → Scheme
  | 0 => (fittingOpenComplement F 0).toScheme
  | r + 1 =>
      (((fittingIdealSheaf F r).subschemeι) ⁻¹ᵁ fittingOpenComplement F (r + 1)).toScheme

/-- The inclusion of the locally closed rank-`r` Fitting locus into the ambient scheme. -/
private abbrev fittingRankLocusι
    {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] : (r : ℕ) →
      fittingRankLocus F r ⟶ S
  | 0 => (fittingOpenComplement F 0).ι
  | r + 1 =>
      (((fittingIdealSheaf F r).subschemeι) ⁻¹ᵁ fittingOpenComplement F (r + 1)).ι ≫
        (fittingIdealSheaf F r).subschemeι

/-- Lemma 31.9.6 (1): for a finite type quasi-coherent module, the intersection of the closed
subschemes defined by all Fitting ideals is empty. -/
@[stacks 05P8]
theorem iInter_support_fittingIdealSheaf_eq_empty
    {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] :
    (⋂ r : ℕ, ((fittingIdealSheaf F r).support : Set S)) = (∅ : Set S) := sorry

/-- Lemma 31.9.6 (2): the open complement of `Z_r` represents the subfunctor of
`Sch/S` on which the pullback of `F` is locally generated by at most `r` sections. -/
@[stacks 05P8]
theorem fittingOpenComplement_nonempty_over_hom_iff_isGeneratedBy
    {S T : Scheme.{u}} (g : T ⟶ S) (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    Subsingleton (Over.mk g ⟶ Over.mk (fittingOpenComplement F r).ι) ∧
      (Nonempty (Over.mk g ⟶ Over.mk (fittingOpenComplement F r).ι) ↔
        SheafOfModules.IsGeneratedBy ((Modules.pullback g).obj F) r) := sorry

/-- Lemma 31.9.6 (3): the locally closed subscheme `Z_{r-1} \ Z_r`, with `Z_{-1}=S`,
represents the subfunctor of `Sch/S` on which the pullback of `F` is finite locally free of rank
`r`. -/
@[stacks 05P8]
theorem fittingRankLocus_nonempty_over_hom_iff_isFiniteLocallyFreeOfRank
    {S T : Scheme.{u}} (g : T ⟶ S) (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) :
    Subsingleton (Over.mk g ⟶ Over.mk (fittingRankLocusι F r)) ∧
      (Nonempty (Over.mk g ⟶ Over.mk (fittingRankLocusι F r)) ↔
        SheafOfModules.IsFiniteLocallyFreeOfRank r ((Modules.pullback g).obj F)) := sorry

/-- Lemma 31.9.6 (4): if `F` is of finite presentation, then the closed subscheme `Z_r`
defined by the `r`th Fitting ideal is of finite presentation over `S`. -/
@[stacks 05P8]
theorem fittingClosedSubscheme_hom_finitePresentation
    {S : Scheme.{u}} (F : S.Modules) [F.IsFinitePresentation] (r : ℕ) :
    Hom.FinitePresentation (fittingIdealSheaf F r).subschemeι := sorry

/-- Lemma 31.9.6 (5): if `F` is of finite presentation, then the open subscheme
`S \ Z_r` is of finite presentation over `S`. -/
@[stacks 05P8]
theorem fittingOpenComplement_hom_finitePresentation
    {S : Scheme.{u}} (F : S.Modules) [F.IsFinitePresentation] (r : ℕ) :
    Hom.FinitePresentation (fittingOpenComplement F r).ι := sorry

/-- Lemma 31.9.6 (6): if `F` is of finite presentation, then the locally closed subscheme
`Z_{r-1} \ Z_r`, with `Z_{-1}=S`, is of finite presentation over `S`. -/
@[stacks 05P8]
theorem fittingRankLocus_hom_finitePresentation
    {S : Scheme.{u}} (F : S.Modules) [F.IsFinitePresentation] (r : ℕ) :
    Hom.FinitePresentation (fittingRankLocusι F r) := sorry

end AlgebraicGeometry.Scheme
