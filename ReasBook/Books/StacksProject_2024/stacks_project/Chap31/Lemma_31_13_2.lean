import StacksProject_2024.Chap31.Definition_31_13_1_EffectiveCartier

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open CategoryTheory
open scoped AlgebraicGeometry nonZeroDivisors

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

-- Semantic recall: Chapter 31 already uses `D.IsEffectiveCartierDivisor` as the canonical owner
-- on `S.IdealSheafData`, introduced alongside the closed-immersion owner in
-- `Definition_31_13_1`. This file keeps the source-facing
-- affine-local nonzerodivisor criterion as a bridge to that owner.

variable {S : Scheme.{u}}

section EffectiveCartier

variable [MonoidalCategory (RingedSpace.Modules S.toRingedSpace)]

/-- The source-facing affine-local criterion for an ideal sheaf datum to define an effective
Cartier divisor: near every point of the support, the defining ideal is generated by a single
nonzerodivisor on some affine neighborhood. -/
def AffineLocalNonZeroDivisorGenerator (D : S.IdealSheafData) : Prop :=
  ∀ x : S, x ∈ D.support →
    ∃ U : S.affineOpens, x ∈ U ∧
      ∃ f : Γ(S, U),
        f ∈ nonZeroDivisors (Γ(S, U)) ∧
          D.ideal U = Ideal.span ({f} : Set (Γ(S, U)))

theorem affineLocalNonZeroDivisorGenerator_iff (D : S.IdealSheafData) :
    AffineLocalNonZeroDivisorGenerator D ↔
      ∀ x : S, x ∈ D.support →
        ∃ U : S.affineOpens, x ∈ U ∧
          ∃ f : Γ(S, U),
            f ∈ nonZeroDivisors (Γ(S, U)) ∧
              D.ideal U = Ideal.span ({f} : Set (Γ(S, U))) :=
  Iff.rfl

/-- Lemma 31.13.2: for a closed subscheme represented by ideal sheaf data `D` on a scheme `S`,
being an effective Cartier divisor is equivalent to the affine-local condition that around every
point of `D`, the defining ideal is generated by a single nonzerodivisor. -/
@[stacks 01WS]
theorem isEffectiveCartierDivisor_iff_affineLocalNonZeroDivisorGenerator
    (D : S.IdealSheafData) :
    D.IsEffectiveCartierDivisor ↔ AffineLocalNonZeroDivisorGenerator D := sorry

/-- The affine-local nonzerodivisor criterion implies that the ideal sheaf data `D` defines an
effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_of_affineLocal_nonZeroDivisorGenerator
    (D : S.IdealSheafData)
    (hlocal : AffineLocalNonZeroDivisorGenerator D) :
    D.IsEffectiveCartierDivisor :=
  (isEffectiveCartierDivisor_iff_affineLocalNonZeroDivisorGenerator D).2 hlocal

/-- An effective Cartier divisor satisfies the affine-local nonzerodivisor criterion. -/
theorem affineLocalNonZeroDivisorGenerator_of_isEffectiveCartierDivisor
    (D : S.IdealSheafData) (hD : D.IsEffectiveCartierDivisor) :
    AffineLocalNonZeroDivisorGenerator D :=
  (isEffectiveCartierDivisor_iff_affineLocalNonZeroDivisorGenerator D).1 hD

/-- An effective Cartier divisor admits affine-local generators that are nonzerodivisors near
every point of its support. -/
theorem exists_affineOpen_nonZeroDivisor_generator
    (D : S.IdealSheafData)
    (hD : D.IsEffectiveCartierDivisor) {x : S} (hx : x ∈ D.support) :
    ∃ U : S.affineOpens, x ∈ U ∧
      ∃ f : Γ(S, U),
        f ∈ nonZeroDivisors (Γ(S, U)) ∧
          D.ideal U = Ideal.span ({f} : Set (Γ(S, U))) := by
  have hlocal := affineLocalNonZeroDivisorGenerator_of_isEffectiveCartierDivisor D hD
  exact hlocal x hx

end EffectiveCartier

end AlgebraicGeometry.Scheme.IdealSheafData
