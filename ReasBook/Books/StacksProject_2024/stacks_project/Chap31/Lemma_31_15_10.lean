universe u

/- Semantic recall: `lean_leansearch` surfaced only principal-ideal height bounds from mathlib,
not a ready-made theorem for this source statement. The local Chapter 10 owner
`embeddedPrimes (R ⧸ I)` is the faithful way to state that `R/I` has no embedded primes, so the
public surface here is a ring-theoretic principality statement for `I` with an explicit
single-generator companion. -/

section

variable {R : Type u} [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R]
variable [IsNoetherianRing R]

/-- Lemma 31.15.10: let `R` be a Noetherian unique factorization domain and let `I ⊆ R` be an
ideal. If the quotient ring `R/I` has no embedded primes and every minimal prime over `I` has
height `1`, then `I` is principal. -/
@[stacks 0BXI]
theorem ideal_isPrincipal_of_quotient_embeddedPrimes_eq_empty_of_minimalPrimes_height_eq_one
    (I : Ideal R)
    (hembedded : embeddedPrimes (R ⧸ I) = ∅)
    (hheight : ∀ p ∈ I.minimalPrimes, p.height = 1) :
    I.IsPrincipal := sorry

/-- If the quotient ring `R/I` has no embedded primes and every minimal prime over `I` has
height `1`, then `I` is generated by a single element. -/
@[stacks 0BXI]
theorem exists_eq_span_singleton_of_quotient_embeddedPrimes_eq_empty_of_minimalPrimes_height_eq_one
    (I : Ideal R)
    (hembedded : embeddedPrimes (R ⧸ I) = ∅)
    (hheight : ∀ p ∈ I.minimalPrimes, p.height = 1) :
    ∃ f : R, I = Ideal.span ({f} : Set R) := sorry

end
