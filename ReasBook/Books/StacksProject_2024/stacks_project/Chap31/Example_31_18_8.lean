import Mathlib.Algebra.Quotient
import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.RingTheory.Flat.Basic
import Mathlib.Algebra.Ring.NonZeroDivisors
import StacksProject_2024.Chap17.SheafOfModulesTensorUnit
import StacksProject_2024.Chap31.Definition_31_18_2
import StacksProject_2024.Chap31.Definition_31_14_6
import StacksProject_2024.Chap31.Definition_31_14_8

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.MonoidalCategory
open scoped nonZeroDivisors
open MvPolynomial

noncomputable section

/-
Semantic recall: Chapter 31 already fixes the source-facing owner for relative effective Cartier
divisors as `IsRelativeEffectiveCartierDivisor f D`. This file keeps the explicit affine ring
presentation of Example `31.18.8` as companion construction data, but records the example itself
through the affine morphism `Spec(B) ⟶ Spec(A)` and the divisor on `Spec(B)` cut out by `x ∈ B`.
-/

/-- The polynomial variables used in the affine presentation of the counterexample ring. -/
inductive relativeCartierCounterexampleVar
  | x
  | y : ℕ → relativeCartierCounterexampleVar
  deriving DecidableEq

section

variable (k : Type u) [Field k]

/-- The base ring `A = k[t]` from Example `31.18.8`. -/
abbrev relativeCartierCounterexampleBase := Polynomial k

/-- The polynomial presentation over `A = k[t]` before imposing the source relations. -/
abbrev relativeCartierCounterexamplePresentation :=
  MvPolynomial relativeCartierCounterexampleVar (relativeCartierCounterexampleBase k)

/-- The ideal generated by the relations `x * y_(n+1) = y_n` and `t * y_n = 0`. -/
def relativeCartierCounterexampleRelations :
    Ideal (relativeCartierCounterexamplePresentation k) :=
  Ideal.span
      (Set.range fun n : ℕ ↦
        (X relativeCartierCounterexampleVar.x) * (X (relativeCartierCounterexampleVar.y (n + 1))) -
          X (relativeCartierCounterexampleVar.y n)) +
    Ideal.span
      (Set.range fun n : ℕ ↦
        (Polynomial.X : relativeCartierCounterexampleBase k) •
          X (relativeCartierCounterexampleVar.y n))

/-- The explicit `A`-algebra `B` from Example `31.18.8`. -/
abbrev relativeCartierCounterexampleAlgebra :=
  relativeCartierCounterexamplePresentation k ⧸ relativeCartierCounterexampleRelations k

/-- The image of the generator `x` in the quotient algebra `B`. -/
def relativeCartierCounterexampleX :
    relativeCartierCounterexampleAlgebra k :=
  Ideal.Quotient.mk (relativeCartierCounterexampleRelations k) (X relativeCartierCounterexampleVar.x)

/-- The principal ideal `(x)` inside the quotient algebra `B`. -/
def relativeCartierCounterexampleXIdeal :
    Ideal (relativeCartierCounterexampleAlgebra k) :=
  Ideal.span ({relativeCartierCounterexampleX k} : Set (relativeCartierCounterexampleAlgebra k))

/-- The quotient `B / xB` from Example `31.18.8`. -/
abbrev relativeCartierCounterexampleQuotient :=
  relativeCartierCounterexampleAlgebra k ⧸ relativeCartierCounterexampleXIdeal k

local notation "A" => relativeCartierCounterexampleBase k
local notation "P" => relativeCartierCounterexamplePresentation k
local notation "B" => relativeCartierCounterexampleAlgebra k
local notation "Bmodx" => relativeCartierCounterexampleQuotient k
/-- The affine base scheme `Spec(A)` from Example `31.18.8`. -/
def relativeCartierCounterexampleBaseScheme :=
  Spec (CommRingCat.of A)

/-- The affine scheme `Spec(B)` from Example `31.18.8`. -/
def relativeCartierCounterexampleScheme :=
  Spec (CommRingCat.of B)

local abbrev XA : Scheme := relativeCartierCounterexampleBaseScheme k
local abbrev XB : Scheme := relativeCartierCounterexampleScheme k
local notation "ModB" => XB.Modules
local notation "𝒪B" => (SheafOfModules.unit XB.ringCatSheaf : ModB)

local instance structureSheaf_tensorRight_isEquivalence
    [MonoidalCategory ModB] :
    Functor.IsEquivalence (tensorRight 𝒪B) := by
  let η : 𝒪B ≅ 𝟙_ ModB := SheafOfModules.unitIsoTensorUnit
  exact
    (tensorRight_isEquivalence_iff_exists_tensor_inverse 𝒪B).2
      ⟨𝒪B, ⟨(η ▷ᵢ 𝒪B) ≪≫ λ_ 𝒪B ≪≫ η⟩, ⟨(Iso.refl 𝒪B ⊗ᵢ η) ≪≫ ρ_ 𝒪B ≪≫ η⟩⟩

/-- The affine structural morphism `Spec(B) ⟶ Spec(A)` induced by the `A`-algebra structure on
`B`. -/
def relativeCartierCounterexampleMorphism :
    XB ⟶ XA :=
  Spec.map (CommRingCat.ofHom (algebraMap A B))

/-- The global section of `𝒪_{Spec(B)}` corresponding to `x ∈ B`. -/
def relativeCartierCounterexampleXGlobalSection :
    Γ(XB, ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (relativeCartierCounterexampleX k)

/-- The structure-sheaf section corresponding to `x ∈ B`. -/
  def relativeCartierCounterexampleXSection
    [MonoidalCategory ModB] :
    𝒪B.sections :=
  (𝒪B).unitHomEquiv
    (RingedSpace.globalSectionMul (relativeCartierCounterexampleXGlobalSection k) 𝒪B)

/-- The divisor on `Spec(B)` cut out by the global section corresponding to `x`. -/
def relativeCartierCounterexampleDivisor
    [MonoidalCategory ModB]
    [SymmetricCategory ModB]
    [MonoidalClosed ModB] :
    XB.IdealSheafData :=
  Scheme.zeroIdealSheaf 𝒪B (relativeCartierCounterexampleXSection k)

/-- Evaluation of the presentation ring at `x = 0` and `y_n = 0`, fixing the coefficient ring
`A = k[t]`. -/
def relativeCartierCounterexamplePresentationToBase : P →ₐ[A] A :=
  MvPolynomial.aeval fun _ ↦ (0 : A)

/-- The evaluation map used in Example `31.18.8` kills every polynomial variable. -/
@[simp] theorem relativeCartierCounterexamplePresentationToBase_X
    (v : relativeCartierCounterexampleVar) :
    relativeCartierCounterexamplePresentationToBase k (X v) = 0 := by
  simp [relativeCartierCounterexamplePresentationToBase]

/-- The defining relations lie in the kernel of the evaluation sending `x` and each `y_n` to `0`.
-/
private theorem relativeCartierCounterexampleRelations_le_ker :
    relativeCartierCounterexampleRelations k ≤
      RingHom.ker (relativeCartierCounterexamplePresentationToBase k).toRingHom := by
  refine sup_le ?_ ?_
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨n, rfl⟩
    change relativeCartierCounterexamplePresentationToBase k
        ((X relativeCartierCounterexampleVar.x) *
          X (relativeCartierCounterexampleVar.y (n + 1)) -
          X (relativeCartierCounterexampleVar.y n)) = 0
    simp [relativeCartierCounterexamplePresentationToBase]
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨n, rfl⟩
    change relativeCartierCounterexamplePresentationToBase k
        ((Polynomial.X : A) • X (relativeCartierCounterexampleVar.y n)) = 0
    simp [relativeCartierCounterexamplePresentationToBase]

/-- The defining relations vanish under the evaluation sending `x` and each `y_n` to `0`. -/
private theorem relativeCartierCounterexampleRelations_vanish {f : P}
    (hf : f ∈ relativeCartierCounterexampleRelations k) :
    relativeCartierCounterexamplePresentationToBase k f = 0 := by
  exact RingHom.mem_ker.mp (relativeCartierCounterexampleRelations_le_ker k hf)

/-- The quotient algebra `B` maps to the base ring `A` by killing the images of `x` and all
`y_n`. -/
def relativeCartierCounterexampleToBase : B →ₐ[A] A :=
  Ideal.Quotient.liftₐ (relativeCartierCounterexampleRelations k)
    (relativeCartierCounterexamplePresentationToBase k)
    fun _ hf ↦ relativeCartierCounterexampleRelations_vanish k hf

/-- The quotient map `B → A` is induced from the evaluation map on the presentation ring. -/
@[simp] theorem relativeCartierCounterexampleToBase_mk
    (f : P) :
    relativeCartierCounterexampleToBase k
        (Ideal.Quotient.mk (relativeCartierCounterexampleRelations k) f) =
      relativeCartierCounterexamplePresentationToBase k f :=
  rfl

/-- The quotient map `B → A` sends the class of `x` to `0`. -/
@[simp] theorem relativeCartierCounterexampleToBase_x :
    relativeCartierCounterexampleToBase k (relativeCartierCounterexampleX k) = 0 := by
  change relativeCartierCounterexamplePresentationToBase k (X relativeCartierCounterexampleVar.x) = 0
  simp

/-- The principal ideal generated by the class of `x` lies in the kernel of `B → A`. -/
private theorem relativeCartierCounterexampleXIdeal_le_ker :
    relativeCartierCounterexampleXIdeal k ≤
      RingHom.ker (relativeCartierCounterexampleToBase k).toRingHom := by
  refine Ideal.span_le.2 ?_
  intro b hb
  rcases Set.mem_singleton_iff.mp hb with rfl
  change relativeCartierCounterexampleToBase k (relativeCartierCounterexampleX k) = 0
  simpa using relativeCartierCounterexampleToBase_x k

/-- The quotient map `B → A` kills the principal ideal generated by the class of `x`. -/
private theorem relativeCartierCounterexampleXIdeal_vanish {b : B}
    (hb : b ∈ relativeCartierCounterexampleXIdeal k) :
    relativeCartierCounterexampleToBase k b = 0 := by
  exact RingHom.mem_ker.mp (relativeCartierCounterexampleXIdeal_le_ker k hb)

/-- The explicit comparison map `B / xB → A = k[t]`. -/
def relativeCartierCounterexampleQuotientToBase : Bmodx →ₐ[A] A :=
  Ideal.Quotient.liftₐ (relativeCartierCounterexampleXIdeal k)
    (relativeCartierCounterexampleToBase k)
    fun _ hb ↦ relativeCartierCounterexampleXIdeal_vanish k hb

/-- The comparison map `B / xB → A` is induced from the quotient map `B → A`. -/
@[simp] theorem relativeCartierCounterexampleQuotientToBase_mk
    (b : B) :
    relativeCartierCounterexampleQuotientToBase k
        (Ideal.Quotient.mk (relativeCartierCounterexampleXIdeal k) b) =
      relativeCartierCounterexampleToBase k b :=
  rfl

/-- Example 31.18.8 (1): the explicit `A`-algebra `B` is not flat over `A = k[t]`. -/
@[stacks 062X]
theorem relativeCartierCounterexample_notFlat : ¬ Module.Flat A B := sorry

/-- Example 31.18.8 (2): the explicit comparison map identifies `B / xB` with `A = k[t]`. -/
@[stacks 062X]
theorem relativeCartierCounterexampleQuotientToBase_bijective :
    Function.Bijective (relativeCartierCounterexampleQuotientToBase k) := sorry

/-- Companion to Example 31.18.8 (2): the affine comparison morphism `B / xB → A` is an
isomorphism in `CommRingCat`. This packages the same affine identification in the categorical form
used by `Spec.map` and other affine-scheme constructions. -/
theorem relativeCartierCounterexampleQuotientToBase_isIso :
    IsIso
      (CommRingCat.ofHom (relativeCartierCounterexampleQuotientToBase k).toRingHom) := by
  exact
    (CategoryTheory.ConcreteCategory.isIso_iff_bijective _).2
      (relativeCartierCounterexampleQuotientToBase_bijective k)

/-- Companion to Example 31.18.8 (2): the comparison map `B / xB → A` is injective. -/
theorem relativeCartierCounterexampleQuotientToBase_injective :
    Function.Injective (relativeCartierCounterexampleQuotientToBase k) :=
  (relativeCartierCounterexampleQuotientToBase_bijective k).1

/-- Companion to Example 31.18.8 (2): the comparison map `B / xB → A` is surjective. -/
theorem relativeCartierCounterexampleQuotientToBase_surjective :
    Function.Surjective (relativeCartierCounterexampleQuotientToBase k) :=
  (relativeCartierCounterexampleQuotientToBase_bijective k).2

/-- Example 31.18.8 (3): the quotient `B / xB` is flat over `A = k[t]`. -/
@[stacks 062X]
theorem relativeCartierCounterexample_quotient_flat : Module.Flat A Bmodx := sorry

/-- Example 31.18.8 (4): the class of `x` in `B` is a nonzerodivisor. -/
@[stacks 062X]
theorem relativeCartierCounterexample_x_mem_nonZeroDivisors :
    relativeCartierCounterexampleX k ∈ nonZeroDivisors B := sorry

/-- Example 31.18.8 (5): the structure-sheaf section corresponding to `x ∈ B` is regular on
`Spec(B)`. -/
@[stacks 062X]
theorem relativeCartierCounterexample_xSection_isRegular
    [MonoidalCategory ModB] :
    LocallyRingedSpace.IsRegularSection 𝒪B (relativeCartierCounterexampleXSection k) := sorry

/-- Example 31.18.8 (6): the divisor cut out by `x` on `Spec(B)` is a relative effective Cartier
divisor over `Spec(A)`. This is the Chapter 31 source-facing form of the example. -/
@[stacks 062X]
theorem relativeCartierCounterexample_isRelativeEffectiveCartierDivisor
    [MonoidalCategory ModB]
    [SymmetricCategory ModB]
    [MonoidalClosed ModB] :
    IsRelativeEffectiveCartierDivisor
      (relativeCartierCounterexampleMorphism k)
      (relativeCartierCounterexampleDivisor k) := sorry

/-- Example 31.18.8 (7): although the divisor cut out by `x` is relative effective Cartier, the
ambient affine morphism `Spec(B) ⟶ Spec(A)` is not flat. -/
@[stacks 062X]
theorem relativeCartierCounterexample_morphism_notFlat :
    ¬ Flat (relativeCartierCounterexampleMorphism k) := sorry

end
