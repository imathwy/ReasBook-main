import Mathlib.Algebra.GCDMonoid.Finset
import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
import Mathlib.RingTheory.MvPolynomial.WeightedHomogeneous
import Mathlib.RingTheory.Noetherian.Defs

-- Declarations for this item will be appended below by the statement pipeline.

open scoped BigOperators

noncomputable section

universe u v

namespace AlgebraicGeometry

/- Semantic recall: `lean_leansearch` surfaced the canonical absolute owners
`AlgebraicGeometry.Proj`, `ProjectiveSpectrum.vanishingIdeal`, and
`ProjectiveSpectrum.zeroLocus`. Local Chapter 30/31 precedent shows that the scheme-side
operation `I ↦ I(V_+(I))` is not yet packaged as a canonical declaration, so the source-facing
theorems below take that operation as an explicit parameter while exposing the concrete algebraic
formulas as reusable set-valued APIs. -/

/-- The degree-one saturation set `{x | A_n x ⊆ I for some n}` for a graded ring. -/
@[stacks 0BXK]
def projDegreeOneSaturationSet
    {A : Type u} {σ : Type v} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] (I : Ideal A) : Set A :=
  {x | ∃ n : ℕ, ∀ a : A, a ∈ 𝒜 n → a * x ∈ I}

/-- The eventual degree-multiple closure set
`{x | (Ax)_{nd} ⊆ I for all n ≫ 0}` for a graded ring. -/
@[stacks 0BXK]
def projDegreeMultipleClosureSet
    {A : Type u} {σ : Type v} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] (I : Ideal A) (d : ℕ) : Set A :=
  {x | ∀ᶠ n : ℕ in Filter.atTop, ∀ a : A,
    a ∈ 𝒜 (n * d) → a ∈ Ideal.span ({x} : Set A) → a ∈ I}

/-- The weights `deg(x) = 2` and `deg(y) = 3` on `ℚ[x, y]`, with variables indexed by `Fin 2`. -/
@[stacks 0BXK]
def weightedProjExampleWeight (i : Fin 2) : ℕ :=
  if i = 0 then 2 else 3

/-- The weighted grading on `ℚ[x, y]` used in the final example. -/
@[stacks 0BXK]
abbrev weightedProjExampleGrading : ℕ → Submodule ℚ (MvPolynomial (Fin 2) ℚ) :=
  MvPolynomial.weightedHomogeneousSubmodule ℚ weightedProjExampleWeight

/-- The variable `x` in the weighted polynomial example. -/
@[stacks 0BXK]
abbrev weightedProjExampleX : MvPolynomial (Fin 2) ℚ :=
  MvPolynomial.X 0

/-- The variable `y` in the weighted polynomial example. -/
@[stacks 0BXK]
abbrev weightedProjExampleY : MvPolynomial (Fin 2) ℚ :=
  MvPolynomial.X 1

/-- The ideal `(y^2)` in the weighted polynomial example. -/
@[stacks 0BXK]
abbrev weightedProjExampleIdeal : Ideal (MvPolynomial (Fin 2) ℚ) :=
  Ideal.span ({weightedProjExampleY ^ 2} : Set (MvPolynomial (Fin 2) ℚ))

/-- The ideal `(y)` in the weighted polynomial example. -/
@[stacks 0BXK]
abbrev weightedProjExampleLineIdeal : Ideal (MvPolynomial (Fin 2) ℚ) :=
  Ideal.span ({weightedProjExampleY} : Set (MvPolynomial (Fin 2) ℚ))

/-- Example 31.31.2 (1): if a Noetherian graded ring `A` is generated by `A₁` over `A₀`,
then for every homogeneous ideal `I`, the operation `I ↦ I(V_+(I))` is the degree-one
saturation `{x | A_n x ⊆ I for some n}`.  The parameter `projClosedSubschemeIdeal` represents
the currently-unpackaged scheme-side operation `I(V_+(I))`. -/
@[stacks 0BXK]
theorem projClosedSubschemeIdeal_eq_degreeOneSaturation
    {A : Type u} {σ : Type v} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing A]
    (hgenerated : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤)
    (projClosedSubschemeIdeal : Ideal A → Ideal A)
    (I : Ideal A) (hI : I.IsHomogeneous 𝒜) :
    (projClosedSubschemeIdeal I : Set A) = projDegreeOneSaturationSet 𝒜 I := sorry

/-- Example 31.31.2 (2): in the degree-one-generated Noetherian case, a homogeneous ideal is
of the form `I(Z)` precisely when it is equal to its degree-one saturation.  Equivalently, it is
a fixed point of the operation `I ↦ I(V_+(I))`. -/
@[stacks 0BXK]
theorem projClosedSubschemeIdeal_eq_self_iff_degreeOneSaturated
    {A : Type u} {σ : Type v} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing A]
    (hgenerated : Algebra.adjoin (𝒜 0) (𝒜 1 : Set A) = ⊤)
    (projClosedSubschemeIdeal : Ideal A → Ideal A)
    (I : Ideal A) (hI : I.IsHomogeneous 𝒜) :
    projClosedSubschemeIdeal I = I ↔
      (I : Set A) = projDegreeOneSaturationSet 𝒜 I := sorry

/-- Example 31.31.2 (3): for a general Noetherian graded ring with homogeneous generators,
if `d` is the least common multiple of the generator degrees, then `I(V_+(I))` consists exactly
of the elements `x` such that `(Ax)_{nd} ⊆ I` for all sufficiently large `n`. -/
@[stacks 0BXK]
theorem projClosedSubschemeIdeal_eq_degreeMultipleClosure
    {A : Type u} {σ : Type v} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing A]
    (generators : Finset A) (degree : A → ℕ)
    (hgenerated : Algebra.adjoin (𝒜 0) (generators : Set A) = ⊤)
    (hdegree : ∀ a ∈ generators, a ∈ 𝒜 (degree a))
    (hdegree_pos : ∀ a ∈ generators, 0 < degree a)
    (d : ℕ) (hd : d = generators.lcm degree)
    (projClosedSubschemeIdeal : Ideal A → Ideal A)
    (I : Ideal A) (hI : I.IsHomogeneous 𝒜) :
    (projClosedSubschemeIdeal I : Set A) =
      projDegreeMultipleClosureSet 𝒜 I d := sorry

/-- Example 31.31.2 (4): in `ℚ[x, y]` with `deg(x) = 2` and `deg(y) = 3`, the element
`x^n y` is never in the ideal `(y^2)`. -/
@[stacks 0BXK]
theorem weightedProjExample_x_pow_y_not_mem_ySquared (n : ℕ) :
    weightedProjExampleX ^ n * weightedProjExampleY ∉ weightedProjExampleIdeal := sorry

/-- Example 31.31.2 (5): for the weighted grading on `ℚ[x, y]` with weights `2` and `3`,
the general Noetherian formula with `d = 6` sends the ideal `(y^2)` to `(y)`. -/
@[stacks 0BXK]
theorem weightedProjExample_closedIdeal_eq_spanY
    [GradedRing weightedProjExampleGrading]
    (projClosedSubschemeIdeal :
      Ideal (MvPolynomial (Fin 2) ℚ) → Ideal (MvPolynomial (Fin 2) ℚ))
    (hformula : ∀ I : Ideal (MvPolynomial (Fin 2) ℚ),
      (projClosedSubschemeIdeal I : Set (MvPolynomial (Fin 2) ℚ)) =
        projDegreeMultipleClosureSet weightedProjExampleGrading I 6) :
    projClosedSubschemeIdeal weightedProjExampleIdeal = weightedProjExampleLineIdeal := sorry

/-- Example 31.31.2 (6): in the same weighted example, `(y)` is not the degree-one saturation of
`(y^2)`, so the formula with `d = 6` can differ from saturation. -/
@[stacks 0BXK]
theorem weightedProjExample_lineIdeal_ne_degreeOneSaturation
    [GradedRing weightedProjExampleGrading] :
    (weightedProjExampleLineIdeal : Set (MvPolynomial (Fin 2) ℚ)) ≠
      projDegreeOneSaturationSet weightedProjExampleGrading weightedProjExampleIdeal := sorry

end AlgebraicGeometry
