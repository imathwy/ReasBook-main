import Mathlib
import StacksProject_2024.stacks_project.Chap17.Definition_17_5_1
import StacksProject_2024.stacks_project.Chap31.Definition_31_21_1

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits
open Opposite
open RingTheory
open RingTheory.Sequence

noncomputable section

universe u

namespace AlgebraicGeometry

-- Semantic recall: `lean_leansearch` surfaced the canonical support owner
-- `Scheme.IdealSheafData.support`, and local Chapter 31 precedent fixes the scheme-level regular,
-- Koszul-regular, `H_1`-regular, and quasi-regular ideal-sheaf predicates on subobjects of the
-- structure sheaf via `Definition_31_21_1`. The affine-local ideals below are therefore exposed
-- directly on section rings of affine opens, with quotient support detected by the cokernel sheaf.

section

variable {X : Scheme.{u}}

local notation "ModX" => RingedSpace.Modules X.toRingedSpace
local notation "𝒪X" => (SheafOfModules.unit X.ringCatSheaf : ModX)

/-- The ideal of sections of `\mathcal O_X(U)` cut out by the ideal-sheaf subobject `I`. -/
noncomputable def idealSheafSectionIdeal
    (I : Subobject 𝒪X) (U : X.Opens) : Ideal (Γ(X, U)) :=
  let iArrow := I.arrow.val
  Ideal.span <| Set.range fun s : (I : ModX).val.obj (op U) ↦
    SheafOfModules.unitSectionToRingSection U ((iArrow.app (op U)) s)

variable (I : Subobject 𝒪X)

local notation "ℐ" => (I : ModX)
local notation "𝒪X/ℐ" => (cokernel (I.arrow : ℐ ⟶ 𝒪X))

/-- Lemma 31.20.7 (1): a regular ideal sheaf on a scheme is equivalently one that, near each point
of the support of `\mathcal O_X / \mathcal I`, is represented on some affine open by an ideal
generated by a finite regular sequence in the affine coordinate ring. -/
@[stacks 063G]
theorem regularIdealSheaf_iff_forall_mem_support_exists_affine_regularSequence :
    IsRegularIdealSheaf I ↔
      ∀ x : X, x ∈ moduleSupport 𝒪X/ℐ →
        ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens),
          ∃ r : ℕ, ∃ f : Fin r → X.presheaf.obj (op (U : X.Opens)),
            IsRegular (X.presheaf.obj (op (U : X.Opens))) (List.ofFn f) ∧
              idealSheafSectionIdeal I (U : X.Opens) = Ideal.span (Set.range f) := sorry

/-- Lemma 31.20.7 (2): a Koszul-regular ideal sheaf on a scheme is equivalently one that, near
each point of the support of `\mathcal O_X / \mathcal I`, is represented on some affine open by
an ideal generated by a finite Koszul-regular sequence in the affine coordinate ring. -/
@[stacks 063G]
theorem koszulRegularIdealSheaf_iff_forall_mem_support_exists_affine_koszulRegularSequence :
    IsKoszulRegularIdealSheaf I ↔
      ∀ x : X, x ∈ moduleSupport 𝒪X/ℐ →
        ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens),
          ∃ r : ℕ, ∃ f : Fin r → X.presheaf.obj (op (U : X.Opens)),
            IsKoszulRegularSequence f ∧
              idealSheafSectionIdeal I (U : X.Opens) = Ideal.span (Set.range f) := sorry

/-- Lemma 31.20.7 (3): an `H_1`-regular ideal sheaf on a scheme is equivalently one that, near
each point of the support of `\mathcal O_X / \mathcal I`, is represented on some affine open by
an ideal generated by a finite `H_1`-regular sequence in the affine coordinate ring. -/
@[stacks 063G]
theorem h1RegularIdealSheaf_iff_forall_mem_support_exists_affine_h1RegularSequence :
    IsH1RegularIdealSheaf I ↔
      ∀ x : X, x ∈ moduleSupport 𝒪X/ℐ →
        ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens),
          ∃ r : ℕ, ∃ f : Fin r → X.presheaf.obj (op (U : X.Opens)),
            IsH1RegularSequence f ∧
              idealSheafSectionIdeal I (U : X.Opens) = Ideal.span (Set.range f) := sorry

/-- Lemma 31.20.7 (4): a quasi-regular ideal sheaf on a scheme is equivalently one that, near
each point of the support of `\mathcal O_X / \mathcal I`, is represented on some affine open by
an ideal generated by a finite quasi-regular sequence in the affine coordinate ring. -/
@[stacks 063G]
theorem quasiRegularIdealSheaf_iff_forall_mem_support_exists_affine_quasiRegularSequence :
    IsQuasiRegularIdealSheaf I ↔
      ∀ x : X, x ∈ moduleSupport 𝒪X/ℐ →
        ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens),
          ∃ r : ℕ, ∃ f : Fin r → X.presheaf.obj (op (U : X.Opens)),
            IsQuasiRegular (X.presheaf.obj (op (U : X.Opens))) (List.ofFn f) ∧
              idealSheafSectionIdeal I (U : X.Opens) = Ideal.span (Set.range f) := sorry

end

end AlgebraicGeometry
