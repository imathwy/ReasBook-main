namespace AlgebraicGeometry.Scheme.Modules

-- Semantic recall: `lean_leansearch` only surfaced the general sheaf-generator owners, while the
-- local Chapter 31 files fix the scheme-side surface through `Scheme.fittingIdealSheaf`,
-- `IsBlowup`, and `strictTransformModule`. The source statement is therefore recorded directly on
-- those owners, keeping only the pointwise neighbourhood formulation that is genuinely part of
-- the source statement.

section

variable {S S' : Scheme.{u}} (b : S' ⟶ S)

/-- Lemma 31.35.1: let `S` be a scheme, let `\mathcal F` be a finite type quasi-coherent
`\mathcal O_S`-module, and let `Z_k` be the closed subscheme cut out by
`Scheme.fittingIdealSheaf ℱ k`. If `b : S' ⟶ S` is the blowup of `S` in `Z_k`, then the strict
transform of `ℱ` along `b` can locally be generated by `≤ k` sections. -/
@[stacks 0CZP]
theorem exists_isGeneratedBy_on_neighborhood_of_strictTransformModule_of_isBlowup_fittingIdealSheaf
    (ℱ : S.Modules) [ℱ.IsFiniteType] [ℱ.IsQuasicoherent]
    (k : ℕ) [IsBlowup b (Scheme.fittingIdealSheaf ℱ k)]
    (y : strictTransformAmbient b (𝟙 S)) :
    ∃ U : Opens (strictTransformAmbient b (𝟙 S)), y ∈ U ∧
      SheafOfModules.IsGeneratedBy
        ((strictTransformModule b ((Scheme.fittingIdealSheaf ℱ k).comap b) (𝟙 S) ℱ).over U) k :=
  sorry

end

end AlgebraicGeometry.Scheme.Modules
