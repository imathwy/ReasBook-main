namespace AlgebraicGeometry.Scheme.IdealSheafData

section LocallyNoetherian

variable {X : Scheme.{u}} [IsLocallyNoetherian X]

/-- The canonical local-principality owner on `D.subschemeι` is equivalent to the affine-local
principal-generation condition on the ideal sheaf data `D`. -/
theorem isLocallyPrincipalClosedSubscheme_subschemeι_iff (D : X.IdealSheafData) :
    IsLocallyPrincipalClosedSubscheme D.subschemeι ↔
      ∀ x : X, x ∈ D.support →
        ∃ U : X.affineOpens, x ∈ U ∧
          ∃ f : Γ(X, U), D.ideal U = Ideal.span ({f} : Set (Γ(X, U))) := sorry

/-- Lemma 31.15.2 (1): for a locally Noetherian scheme `X` and a closed subscheme `D ⊆ X`, if
for every `x ∈ D` the stalk ideal `D.stalkIdeal x ⊆ \mathcal O_{X, x}` is principal, then `D` is
locally principal. -/
theorem isLocallyPrincipal_of_stalks_principal
    (D : X.IdealSheafData)
    (hprincipal : ∀ x : X, x ∈ D.support → (D.stalkIdeal x).IsPrincipal) :
    IsLocallyPrincipalClosedSubscheme D.subschemeι := sorry

end LocallyNoetherian

section EffectiveCartier

variable {X : Scheme.{u}} [IsLocallyNoetherian X]
variable [MonoidalCategory X.Modules]

local instance schemeToRingedSpaceModulesMonoidal :
    MonoidalCategory (RingedSpace.Modules X.toRingedSpace) := by
  simpa using (inferInstance : MonoidalCategory X.Modules)

/-- Lemma 31.15.2 (2): for a locally Noetherian scheme `X` and a closed subscheme `D ⊆ X`, if
for every `x ∈ D` the stalk ideal `D.stalkIdeal x ⊆ \mathcal O_{X, x}` is generated by a single
nonzerodivisor, then `D` is an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_of_stalks_generatedByNonZeroDivisor
    (D : X.IdealSheafData)
    (hregular :
      ∀ x : X, x ∈ D.support →
        ∃ f : X.presheaf.stalk x,
          f ∈ nonZeroDivisors (X.presheaf.stalk x) ∧
            D.stalkIdeal x = Ideal.span ({f} : Set (X.presheaf.stalk x))) :
    D.IsEffectiveCartierDivisor := sorry

end EffectiveCartier

end AlgebraicGeometry.Scheme.IdealSheafData
