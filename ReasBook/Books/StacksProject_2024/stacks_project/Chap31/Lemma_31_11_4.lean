import StacksProject_2024.Chap17.Definition_17_4_5
import StacksProject_2024.Chap30.AffineOpenSubsheafSections

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits
open Opposite
open SheafOfModules
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme.Modules

variable {X : Scheme.{u}} [IsIntegral X]

-- Semantic recall: `lean_leansearch` surfaced the algebraic analogue
-- `Submodule.torsion`, `Submodule.QuotientTorsion.instIsTorsionFree`, and
-- `Submodule.isTorsionFree_iff_torsion_eq_bot`. Chapter 30 already provides the canonical
-- affine-open section submodule owner `affineOpenSubsheafSectionsSubmodule`, so the
-- scheme-level statement below uses a `Subobject ℱ` whose affine-open section submodules are
-- exactly the module-theoretic torsion submodules, with the quotient expressed canonically as
-- `cokernel T.arrow`.

/-- The affine-open torsion sections used to generate the canonical torsion subobject. -/
private abbrev torsionAffineOpenSectionIndex
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] :=
  Σ U : X.affineOpens, { s : Γ(ℱ, U) // s ∈ Submodule.torsion (Γ(X, U)) (Γ(ℱ, U)) }

/-- The canonical subobject generated by all torsion affine-open sections of `ℱ`. -/
noncomputable def torsionSubobject
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] : Subobject ℱ :=
  subsheaf_generated_by_local_sections ℱ
    (fun i : torsionAffineOpenSectionIndex ℱ ↦ i.1.1)
    (fun i : torsionAffineOpenSectionIndex ℱ ↦ i.2.1)

/-- Every torsion affine-open section of `ℱ` lies in the affine-open sections of the canonical
torsion subobject. -/
theorem mem_affineOpenSubsheafSectionsSubmodule_torsionSubobject
    (ℱ : X.Modules) [ℱ.IsQuasicoherent]
    (U : X.affineOpens) (s : Γ(ℱ, U))
    (hs : s ∈ Submodule.torsion (Γ(X, U)) (Γ(ℱ, U))) :
    s ∈ affineOpenSubsheafSectionsSubmodule (torsionSubobject ℱ) U := by
  rw [mem_affineOpenSubsheafSectionsSubmodule]
  simpa [torsionSubobject] using
    (subsheaf_generated_by_local_sections_contains_local_sections ℱ
      (fun i : torsionAffineOpenSectionIndex ℱ ↦ i.1.1)
      (fun i : torsionAffineOpenSectionIndex ℱ ↦ i.2.1))
      ⟨U, ⟨s, hs⟩⟩

/-- Affine-open torsion sections lie in the affine-open sections of the canonical torsion
subobject. -/
theorem torsion_affineOpenSubsheafSectionsSubmodule_le
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] (U : X.affineOpens) :
    Submodule.torsion (Γ(X, U)) (Γ(ℱ, U)) ≤
      affineOpenSubsheafSectionsSubmodule (torsionSubobject ℱ) U := by
  intro s hs
  exact mem_affineOpenSubsheafSectionsSubmodule_torsionSubobject ℱ U s hs

/-- Lemma 31.11.4: let `X` be an integral scheme and let `\mathcal F` be a quasi-coherent
`\mathcal O_X`-module. Then the torsion sections of `\mathcal F` form a quasi-coherent
`\mathcal O_X`-submodule `\mathcal F_{tors} \subset \mathcal F`; moreover the quotient is
quasi-coherent and torsion free. -/
@[stacks 0AXT]
theorem torsionSubobject_spec
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] :
    ((torsionSubobject ℱ : X.Modules)).IsQuasicoherent ∧
      (∀ U : X.affineOpens,
        affineOpenSubsheafSectionsSubmodule (torsionSubobject ℱ) U =
          Submodule.torsion (Γ(X, U)) (Γ(ℱ, U))) ∧
      (cokernel (torsionSubobject ℱ).arrow).IsQuasicoherent ∧
      IsTorsionFree (cokernel (torsionSubobject ℱ).arrow) := sorry

/-- The canonical torsion subobject is quasi-coherent. -/
@[instance]
theorem torsionSubobject_isQuasicoherent
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] :
    ((torsionSubobject ℱ : X.Modules)).IsQuasicoherent :=
  (torsionSubobject_spec ℱ).1

/-- The quotient by the canonical torsion subobject is quasi-coherent. -/
@[instance]
theorem cokernel_torsionSubobject_isQuasicoherent
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] :
    (cokernel (torsionSubobject ℱ).arrow).IsQuasicoherent :=
  (torsionSubobject_spec ℱ).2.2.1

/-- The quotient by the canonical torsion subobject is torsion free. -/
@[instance]
theorem cokernel_torsionSubobject_isTorsionFree
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] :
    IsTorsionFree (cokernel (torsionSubobject ℱ).arrow) :=
  (torsionSubobject_spec ℱ).2.2.2

/-- The affine-open sections of the canonical torsion subobject are exactly the torsion sections. -/
theorem torsionSubobject_affineOpenSections_eq_torsion
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] (U : X.affineOpens) :
    affineOpenSubsheafSectionsSubmodule (torsionSubobject ℱ) U =
      Submodule.torsion (Γ(X, U)) (Γ(ℱ, U)) :=
  (torsionSubobject_spec ℱ).2.1 U

/-- Companion existential form of Lemma 31.11.4, derived from the canonical torsion subobject. -/
theorem exists_torsionSubobject_torsionFree_quotient
    (ℱ : X.Modules) [ℱ.IsQuasicoherent] :
    ∃ T : Subobject ℱ,
      ((T : X.Modules)).IsQuasicoherent ∧
        (∀ U : X.affineOpens,
          affineOpenSubsheafSectionsSubmodule T U =
            Submodule.torsion (Γ(X, U)) (Γ(ℱ, U))) ∧
        (cokernel T.arrow).IsQuasicoherent ∧
        IsTorsionFree (cokernel T.arrow) :=
  ⟨torsionSubobject ℱ, torsionSubobject_spec ℱ⟩

end AlgebraicGeometry.Scheme.Modules
