import StacksProject_2024.stacks_project.Chap31.Definition_31_13_1_EffectiveCartier
import StacksProject_2024.stacks_project.Chap17.Definition_17_13_1_Owner

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.MonoidalCategory
open AlgebraicGeometry

noncomputable section

universe u v

namespace AlgebraicGeometry

/-- Definition 31.13.1 (1): a locally principal closed subscheme of a scheme `S` is a closed
subscheme `i : D ⟶ S` whose ideal sheaf is locally generated by one section of
`\mathcal O_S`. -/
class IsLocallyPrincipalClosedSubscheme
    {S D : Scheme.{u}} (i : D ⟶ S) : Prop extends IsClosedImmersion i where
  idealSheaf_isGeneratedBy_one (x : S) :
    ∃ U : S.Opens, x ∈ U ∧
      ∃ s :
        (((RingedSpace.closedImmersionIdealSheaf i.toShHom).over U :
          SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).sections),
        Epi
          ((((RingedSpace.closedImmersionIdealSheaf i.toShHom).over U :
            SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).freeHomEquiv).symm
            (fun _ : PUnit ↦ s))

/-- Companion to Definition 31.13.1 (1): a locally principal closed subscheme is exactly a closed
immersion whose ideal sheaf is locally generated by one section. -/
theorem isLocallyPrincipalClosedSubscheme_iff
    {S D : Scheme.{u}} (i : D ⟶ S) :
    IsLocallyPrincipalClosedSubscheme i ↔
      IsClosedImmersion i ∧
        ∀ x : S, ∃ U : S.Opens, x ∈ U ∧
          ∃ s :
            (((RingedSpace.closedImmersionIdealSheaf i.toShHom).over U :
              SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).sections),
            Epi
              ((((RingedSpace.closedImmersionIdealSheaf i.toShHom).over U :
                SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).freeHomEquiv).symm
                (fun _ : PUnit ↦ s)) := by
  constructor
  · intro h
    exact ⟨h.toIsClosedImmersion, h.idealSheaf_isGeneratedBy_one⟩
  · rintro ⟨hi, hgen⟩
    exact
      { toIsClosedImmersion := hi
        idealSheaf_isGeneratedBy_one := hgen }

/-- The ideal sheaf of a locally principal closed subscheme is generated near each point by one
section on some open neighborhood. -/
theorem exists_isGeneratedBy_one_closedImmersionIdealSheaf_over_of_isLocallyPrincipalClosedSubscheme
    {S D : Scheme.{u}} {i : D ⟶ S} [h : IsLocallyPrincipalClosedSubscheme i] (x : S) :
    ∃ U : S.Opens, x ∈ U ∧
      ∃ s :
        (((RingedSpace.closedImmersionIdealSheaf i.toShHom).over U :
          SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).sections),
        Epi
          ((((RingedSpace.closedImmersionIdealSheaf i.toShHom).over U :
            SheafOfModules (S.toRingedSpace.ringCatSheaf.over U)).freeHomEquiv).symm
            (fun _ : PUnit ↦ s)) :=
  h.idealSheaf_isGeneratedBy_one x

/-- Every effective Cartier divisor is a locally principal closed subscheme. -/
theorem isLocallyPrincipalClosedSubscheme_of_isEffectiveCartierDivisor
    {S D : Scheme.{u}} {i : D ⟶ S}
    [MonoidalCategory (RingedSpace.Modules S.toRingedSpace)]
    [IsEffectiveCartierDivisor i] :
    IsLocallyPrincipalClosedSubscheme i := sorry
namespace Scheme.IdealSheafData

variable {X : Scheme.{u}}
variable [MonoidalCategory (RingedSpace.Modules X.toRingedSpace)]

/-- An effective Cartier divisor encoded by ideal-sheaf data has a locally principal defining
closed immersion. -/
theorem isLocallyPrincipalClosedSubscheme_subschemeι
    (D : X.IdealSheafData) [D.IsEffectiveCartierDivisor] :
    AlgebraicGeometry.IsLocallyPrincipalClosedSubscheme D.subschemeι :=
  AlgebraicGeometry.isLocallyPrincipalClosedSubscheme_of_isEffectiveCartierDivisor

end Scheme.IdealSheafData

end AlgebraicGeometry
