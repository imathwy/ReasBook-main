import StacksProject_2024.stacks_project.Chap17.Definition_17_13_1_Owner

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open TopologicalSpace

universe u

namespace SheafOfModules

variable {X : RingedSpace.{u}}

-- Semantic recall: `lean_leansearch` surfaced `SheafOfModules.GeneratingSections` and
-- `SheafOfModules.LocalGeneratorsData` as the canonical owner layer for local generation by
-- sections, so Definition 28.23.1 is formalized as a cardinal-bounded refinement of that API on
-- ringed spaces.

/-- Definition 28.23.1: a sheaf of `\mathcal{O}_X`-modules on a ringed space is `κ`-generated if
every point has an open neighbourhood on which the restricted sheaf is generated by a family of
sections of cardinality at most `κ`.

The Stacks Project states this for infinite `κ`, but that side condition is redundant for the
predicate itself, so the owner is defined for arbitrary cardinals. -/
class IsKappaGenerated (ℱ : X.Modules) (κ : Cardinal.{u}) : Prop where
  /-- Around every point there is a neighborhood on which `ℱ` is generated by at most `κ`
  sections. -/
  locally (x : X) :
    ∃ (U : Opens X) (_ : x ∈ U) (σ : (ℱ.over U).GeneratingSections),
      Cardinal.mk σ.I ≤ κ

/-- Unfold the pointwise local-generation formulation of `κ`-generated sheaves. -/
theorem isKappaGenerated_iff
    (ℱ : X.Modules) (κ : Cardinal.{u}) :
    ℱ.IsKappaGenerated κ ↔
      ∀ x : X, ∃ (U : Opens X) (_ : x ∈ U) (σ : (ℱ.over U).GeneratingSections),
        Cardinal.mk σ.I ≤ κ := by
  constructor
  · intro h x
    exact h.locally x
  · intro h
    exact ⟨h⟩

end SheafOfModules
