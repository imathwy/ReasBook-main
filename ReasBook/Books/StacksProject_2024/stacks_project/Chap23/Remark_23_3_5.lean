import Mathlib.Algebra.Category.Ring.Constructions
import Mathlib.LinearAlgebra.TensorProduct.RightExactness
import Mathlib.RingTheory.Ideal.Quotient.Operations
import StacksProject_2024.stacks_project.Chapters.Chap23.section03

open CategoryTheory
open CategoryTheory.Limits
open DividedPowers

universe u

namespace DividedPowerRing

-- Semantic search hits used here: `CommRingCat.isPushout_tensorProduct`, `Ideal.quotientMap`, and
-- `Algebra.TensorProduct.map_ker`, matching the quotient-pushout and tensor-product ideal surfaces
-- for the three clauses of Remark 23.3.5.

/-- The quotient ring map induced by a morphism of divided power rings. -/
abbrev quotientMap {A B : DividedPowerRing.{u}} (f : A ⟶ B) :=
  show A ⧸ A.ideal →+* B ⧸ B.ideal from
    Ideal.quotientMap B.ideal f.toRingHom (Ideal.map_le_iff_le_comap.mp f.ideal_comp)

/-- On quotient classes, `quotientMap` applies the underlying ring homomorphism before passing to
quotients. -/
theorem quotientMap_mk {A B : DividedPowerRing.{u}} (f : A ⟶ B) (a : A) :
    quotientMap f (Ideal.Quotient.mk A.ideal a) = Ideal.Quotient.mk B.ideal (f.toRingHom a) := by
  rfl

/-- The tensor-product ideal generated by the left and right divided-power ideals in `B ⊗_A B'`. -/
abbrev tensorIdeal {A B B' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B') :=
  let _ : Algebra A B := f.toRingHom.toAlgebra
  let _ : Algebra A B' := g.toRingHom.toAlgebra
  show Ideal (TensorProduct A B B') from
    Ideal.map (Algebra.TensorProduct.includeLeft : B →ₐ[A] TensorProduct A B B') B.ideal ⊔
      Ideal.map (Algebra.TensorProduct.includeRight : B' →ₐ[A] TensorProduct A B B') B'.ideal

/-- The canonical ring map `B ⊗_A B' → B''` underlying the source `A`-algebra map attached to a
commutative square of divided power rings. -/
abbrev tensorProductTo {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B')
    (i : B ⟶ B'') (j : B' ⟶ B'') (hcomm : f ≫ i = g ≫ j) :=
  let _ : Algebra A B := f.toRingHom.toAlgebra
  let _ : Algebra A B' := g.toRingHom.toAlgebra
  let _ : Algebra A B'' := (i.toRingHom.comp f.toRingHom).toAlgebra
  let leftToPushout : B →ₐ[A] B'' :=
    AlgHom.mk i.toRingHom (by
      intro a
      change i.toRingHom (f.toRingHom a) = (i.toRingHom.comp f.toRingHom) a
      rfl)
  let rightToPushout : B' →ₐ[A] B'' :=
    AlgHom.mk j.toRingHom (by
      intro a
      change j.toRingHom (g.toRingHom a) = (i.toRingHom.comp f.toRingHom) a
      simpa using congrArg (fun k : A ⟶ B'' ↦ k.toRingHom a) hcomm.symm)
  show TensorProduct A B B' →+* B'' from
    (Algebra.TensorProduct.productMap leftToPushout rightToPushout).toRingHom

/-- Remark 23.3.5 (1): after quotienting by the divided-power ideals, a pushout square of divided
power rings becomes a pushout square of commutative rings; this is the canonical tensor-product
formalization of `B''/J'' = B/J ⊗_{A/I} B'/J'`. -/
@[stacks 0H86]
theorem quotient_isPushout {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B) (g : A ⟶ B')
    (i : B ⟶ B'') (j : B' ⟶ B'') (hpush : IsPushout f g i j) :
    IsPushout (CommRingCat.ofHom (quotientMap f)) (CommRingCat.ofHom (quotientMap g))
      (CommRingCat.ofHom (quotientMap i)) (CommRingCat.ofHom (quotientMap j)) := sorry

/-- Remark 23.3.5 (2): the canonical map `B ⊗_A B' → B''` induced by a pushout square of divided
power rings is surjective. -/
@[stacks 0H86]
theorem pushoutTensorProductTo_surjective {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B)
    (g : A ⟶ B') (i : B ⟶ B'') (j : B' ⟶ B'') (hpush : IsPushout f g i j) :
    Function.Surjective (tensorProductTo f g i j hpush.w) := sorry

/-- Remark 23.3.5 (3): the image in `B''` of the tensor-product ideal generated by `J` and `J'`
is exactly `J''`; equivalently, the induced map `J ⊗_A B' + B ⊗_A J' → J''` is surjective. -/
@[stacks 0H86]
theorem pushoutTensorIdeal_image_eq {A B B' B'' : DividedPowerRing.{u}} (f : A ⟶ B)
    (g : A ⟶ B') (i : B ⟶ B'') (j : B' ⟶ B'') (hpush : IsPushout f g i j) :
    Ideal.map (tensorProductTo f g i j hpush.w) (tensorIdeal f g) = B''.ideal := sorry

end DividedPowerRing
