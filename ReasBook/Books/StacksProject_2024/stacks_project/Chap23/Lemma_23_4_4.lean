namespace DividedPowers

section

variable {A : Type u} [CommRing A] {I : Ideal A}

/-
Lemma 23.4.4: let `(A, I, γ)` be a divided power ring and let `E ⊆ I` be a subset. Then the
smallest ideal `J ⊆ I` preserved by `γ` and containing `E` is the ideal generated by the
positive divided powers `γ_n(f)` with `n ≥ 1` and `f ∈ E`. This is formalized by the canonical
theorem `DividedPowers.SubDPIdeal.span_carrier_eq_dpow_span`.
-/
recall SubDPIdeal.span_carrier_eq_dpow_span

end

end DividedPowers
