import Mathlib
import Mathlib.Tactic.TFAE
import StacksProject_2024.stacks_project.Chap10.Definition_10_135_5
import StacksProject_2024.stacks_project.Chap15.Definition_15_61_1
import StacksProject_2024.stacks_project.Chap23.Lemma_23_7_4

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.Limits
open IsLocalRing

universe u

section

variable {R : Type u} {S : Type u} [CommRing R] [CommRing S]
variable [IsLocalRing R] [IsLocalRing S] [IsNoetherianRing R] [IsNoetherianRing S]
variable [Algebra R S] [IsLocalHom (algebraMap R S)] [Module.Flat R S]
variable {I : Ideal R} {J : Ideal S}

-- Semantic recall note: `lean_leansearch` surfaced the core regular-sequence owner
-- `RingTheory.Sequence.IsRegular`; the local Chapter 23/15 precedents then fix the source-facing
-- API here to `Ideal.IsGeneratedByRegularSequence`, `ModuleHasFiniteTorDimension`, the canonical
-- quotient-algebra instances, and `IsZero (Tor[_, _](...))` for the Tor-vanishing clause.

/-- Lemma 23.7.6: let `R → S` be a local ring map of Noetherian local rings, let `I ⊆ R` and
`J ⊆ S` be ideals with `I S ⊆ J`, and assume `R → S` is flat and the closed fiber
`S / maximalIdeal R S` is regular. Then the following are equivalent: `J` is generated by a
regular sequence and `S / J` has finite tor dimension over `R / I`; `J` is generated by a regular
sequence and `Tor_p^(R / I)(S / J, R / maximalIdeal R)` is nonzero for only finitely many `p`;
and `I` is generated by a regular sequence while `J / I S` is generated by a regular sequence in
`S / I S`. -/
@[stacks 09PX]
theorem generatedByRegularSequence_tfae_of_flat_localRingMap_of_regular_closedFiber
    (hI : I ≠ ⊤) (hJ : J ≠ ⊤)
    (hIJ : Ideal.map (algebraMap R S) I ≤ J)
    (hclosed :
      IsRegularLocalRing (S ⧸ Ideal.map (algebraMap R S) (maximalIdeal R))) :
    let SI : Ideal S := Ideal.map (algebraMap R S) I
    List.TFAE
      [ J.IsGeneratedByRegularSequence ∧
          (let _inst : Algebra (R ⧸ I) (S ⧸ J) :=
            RingHom.toAlgebra <|
              Ideal.quotientMap J (algebraMap R S) <| by
                intro x hx
                exact hIJ (Ideal.mem_map_of_mem _ hx)
            ModuleHasFiniteTorDimension (ModuleCat.of (R ⧸ I) (S ⧸ J)))
      , J.IsGeneratedByRegularSequence ∧
          (let _inst : Algebra (R ⧸ I) (S ⧸ J) :=
              RingHom.toAlgebra <|
                Ideal.quotientMap J (algebraMap R S) <| by
                  intro x hx
                  exact hIJ (Ideal.mem_map_of_mem _ hx)
            let _inst : Algebra (R ⧸ I) (R ⧸ maximalIdeal R) :=
              Ideal.quotientFactorAlgebra (IsLocalRing.le_maximalIdeal hI)
            ∃ n : ℕ, ∀ p : ℕ, n < p → IsZero (Tor[R ⧸ I, p](S ⧸ J, R ⧸ maximalIdeal R)))
      , I.IsGeneratedByRegularSequence ∧
          (Ideal.map (Ideal.Quotient.mk SI) J).IsGeneratedByRegularSequence
      ] := sorry

end
