import Mathlib
import StacksProject_2024.Chap23.Lemma_23_6_11

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe uR uK uA uB uι

open DifferentialGradedAlgebra

/- Semantic search note: `lean_leansearch` was unavailable in this runner (HTTP 521). The owner
choice below is therefore checked against the local Chapter 23 precedent in
`Lemma_23_6_11` and `Lemma_23_12_4`: this file reuses the upstream canonical owner
