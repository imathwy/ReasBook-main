section

variable {R : Type uR} [CommRing R]
variable {r : ℕ}

/-- The ideal generated by the powers `f_i^N` of the chosen finite family `f`. This is the ideal
cutting out the quotient ring `R/(f_1^N, \ldots, f_r^N)` appearing in Lemma 23.12.1. -/
def powerIdeal (f : Fin r → R) (N : ℕ) : Ideal R :=
  Ideal.span (Set.range fun i : Fin r ↦ f i ^ N)

/-- Unfolding `powerIdeal` recovers the span of the family of powers `f_i^N`. -/
theorem powerIdeal_def (f : Fin r → R) (N : ℕ) :
    powerIdeal f N = Ideal.span (Set.range fun i : Fin r ↦ f i ^ N) :=
  rfl

/-- The canonical graded divided-power polynomial algebra over `R` generated by finitely many
positive-degree variables. The degree index `n : ℕ+` is part of the generator label. -/
abbrev PositiveDividedPowerPolynomialAlgebra
    (R : Type uR) [CommRing R] (vars : ℕ+ → Type uι) : Type (max uR uι) :=
  DividedPowerAlgebra R ((Σ n : ℕ+, vars n) →₀ R)

/-- The generator indexed by `v : vars n` in the positive-degree divided-power polynomial algebra
over `R`. -/
abbrev positiveDPGenerator
    (R : Type uR) [CommRing R] (vars : ℕ+ → Type uι)
    (n : ℕ+) (v : vars n) :
    PositiveDividedPowerPolynomialAlgebra R vars :=
  DividedPowerAlgebra.embed R ((Σ n : ℕ+, vars n) →₀ R)
    (Finsupp.single (Sigma.mk n v) (1 : R))

/-- A graded divided-power polynomial presentation of an `R`-algebra using only positive-degree
generators, with finitely many generators in each degree. This is the source-facing form of
condition (4) in Lemma 23.12.1. -/
structure PositiveGradedDividedPowerPolynomialPresentation
    (R : Type uR) [CommRing R] (A : Type uA) [CommRing A] [Algebra R A] where
  /-- The variables adjoined in each positive degree. -/
  vars : ℕ+ → Type uι
  /-- Each positive degree has only finitely many adjoined variables. -/
  fintypeVars : ∀ n : ℕ+, Fintype (vars n)
  /-- The chosen algebra equivalence with the canonical divided-power polynomial algebra on those
  generators. -/
  equiv : A ≃ₐ[R] PositiveDividedPowerPolynomialAlgebra R vars

/-- Each positive degree of a positive graded divided-power polynomial presentation has finitely
many generators. -/
instance
    (A : Type uA) [CommRing A] [Algebra R A]
    (P : PositiveGradedDividedPowerPolynomialPresentation R A) (n : ℕ+) :
    Fintype (P.vars n) :=
  P.fintypeVars n

/-- The packaged positive presentation exhibits the algebra as the corresponding canonical
positive-degree divided-power polynomial algebra. -/
abbrev presentationEquiv
    (A : Type uA) [CommRing A] [Algebra R A]
    (P : PositiveGradedDividedPowerPolynomialPresentation R A) :
    A ≃ₐ[R] PositiveDividedPowerPolynomialAlgebra R P.vars :=
  P.equiv

/-- The ambient powered Koszul system appearing in Lemma 23.12.1: for each stage `N`, a
compatible graded divided-power differential graded `R`-algebra `K_N`, its canonical map to the
quotient `R/(f_1^N, \ldots, f_r^N)`, and the transition maps `K_N → K_n` for `n ≤ N`. -/
structure PoweredKoszulApproximationContext (f : Fin r → R) where
  /-- The powered Koszul algebra `K_N`. -/
  koszul : ℕ → GradedDividedPowerDGAlgebra.{uR, uK} R
  /-- The canonical map from `K_N` to `R/(f_1^N, \ldots, f_r^N)`. -/
  toQuotient : ∀ N : ℕ, koszul N →ₐ[R] R ⧸ powerIdeal f N
  /-- The transition map `K_N → K_n` for `n ≤ N`. -/
  transition :
    ∀ {n N : ℕ}, n ≤ N →
      GradedDividedPowerDGAlgebraHom R (koszul N) (koszul n)

/-- The transition map in a powered Koszul approximation context, viewed only as an algebra map. -/
abbrev PoweredKoszulApproximationContext.transitionAlgHom
    {f : Fin r → R} (ctx : PoweredKoszulApproximationContext.{uR, uK} f)
    {n N : ℕ} (h : n ≤ N) :
    ctx.koszul N →ₐ[R] ctx.koszul n :=
  (ctx.transition h).toAlgHom

/-- A finite Tate-style approximation to the powered Koszul algebra `K_n`: a larger stage `N`,
a compatible graded divided-power differential graded `R`-algebra `A`, maps
`K_N → A → R/(f_1^N, \ldots, f_r^N)` and `A → K_n`, and the explicit source conditions from
Lemma 23.12.1. -/
structure PoweredKoszulTateApproximation
    {f : Fin r → R} (ctx : PoweredKoszulApproximationContext.{uR, uK} f) (n : ℕ) where
  /-- The larger powered stage `N ≥ n`. -/
  N : ℕ
  /-- The comparison stage dominates the requested stage `n`. -/
  hnN : n ≤ N
  /-- The intermediate compatible graded divided-power differential graded algebra `A`. -/
  A : GradedDividedPowerDGAlgebra.{uR, uA} R
  /-- The chosen positive-degree graded divided-power polynomial presentation of `A`. -/
  presentation : PositiveGradedDividedPowerPolynomialPresentation.{uR, uA, uι} R A
  /-- The map `K_N → A`. -/
  fromKoszul : ctx.koszul N →ₐ[R] A
  /-- The quasi-isomorphism target map `A → R/(f_1^N, \ldots, f_r^N)`. -/
  toQuotient : A →ₐ[R] R ⧸ powerIdeal f N
  /-- The map `A → K_n`, compatible with the differential graded `R`-algebra structures and
  divided powers. -/
  toKoszul : GradedDividedPowerDGAlgebraHom R A (ctx.koszul n)
  /-- The positive generator indexed by degree `d` lands in the homogeneous degree `d` piece of
  `A`. -/
  positive_generator_mem :
    ∀ d : ℕ+, ∀ v : presentation.vars d,
      presentation.equiv.symm (positiveDPGenerator R presentation.vars d v) ∈ A.grading d
  /-- Degree `0` of `A` consists exactly of scalars from `R`. -/
  grading_zero_iff :
    ∀ x : A, x ∈ A.grading 0 ↔ ∃ r : R, x = algebraMap R A r
  /-- The comparison map kills boundaries because the quotient ring carries the zero differential. -/
  toQuotient_d : ∀ x : A, toQuotient (A.d x) = 0
  /-- The map `A → R/(f_1^N, \ldots, f_r^N)` is surjective on degree-zero homology. -/
  h0_surjective :
    ∀ q : R ⧸ powerIdeal f N, ∃ x : A, x ∈ A.grading 0 ∧ toQuotient x = q
  /-- A degree-zero cycle in `A` maps to `0` in the quotient exactly when it is a boundary from
  degree `1`. -/
  h0_exact :
    ∀ ⦃x : A⦄, x ∈ A.grading 0 → toQuotient x = 0 →
      ∃ y : A, y ∈ A.grading 1 ∧ A.d y = x
  /-- Every positive-degree cycle in `A` is a boundary from the next degree. -/
  higher_exact :
    ∀ ⦃m : ℕ⦄, 0 < m → ∀ ⦃x : A⦄, x ∈ A.grading m → A.d x = 0 →
      ∃ y : A, y ∈ A.grading (m + 1) ∧ A.d y = x
  /-- The composition `K_N → A → R/(f_1^N, \ldots, f_r^N)` is the canonical quotient map. -/
  fromKoszul_toQuotient :
    toQuotient.comp fromKoszul = ctx.toQuotient N
  /-- The composition `K_N → A → K_n` is the transition map `K_N → K_n`. -/
  fromKoszul_toKoszul :
    toKoszul.toAlgHom.comp fromKoszul = ctx.transitionAlgHom hnN
  /-- On the scalar degree-zero part `A_0 = R`, the map to the quotient is the canonical
  surjection. -/
  toQuotient_on_scalars :
    ∀ r : R, toQuotient (algebraMap R A r) = Ideal.Quotient.mk (powerIdeal f N) r
  /-- On degree-zero classes, the map `A → K_n` induces the canonical quotient transition
  `R → R/(f_1^n, \ldots, f_r^n)` on the scalar degree-zero part. -/
  toKoszul_h0 :
    ∀ r : R, ctx.toQuotient n (toKoszul (algebraMap R A r)) = Ideal.Quotient.mk (powerIdeal f n) r

/-- A powered Koszul Tate approximation exposes its intermediate differential graded algebra. -/
abbrev PoweredKoszulTateApproximation.resolvingAlgebra
    {f : Fin r → R} {ctx : PoweredKoszulApproximationContext.{uR, uK} f} {n : ℕ}
    (A : PoweredKoszulTateApproximation.{uR, uK, uA, uι} ctx n) :
    GradedDividedPowerDGAlgebra.{uR, uA} R :=
  A.A

/-- Lemma 23.12.1: in the powered Koszul situation over a Noetherian ring `R`, for every stage
`n` there exists a larger stage `N ≥ n` together with maps
`K_N → A → R/(f_1^N, \ldots, f_r^N)` and `A → K_n` such that `A` is a compatible graded divided
power differential graded `R`-algebra, `A → R/(f_1^N, \ldots, f_r^N)` is a quasi-isomorphism,
`K_N → A` composes to the canonical quotient map and to the transition `K_N → K_n`, degree `0`
of `A` is exactly `R`, `A` is a graded divided-power polynomial algebra over `R` with finitely
many generators in each positive degree, and `A → K_n` induces the canonical quotient transition
on degree-zero homology. -/
theorem exists_poweredKoszulTateApproximation
    [IsNoetherianRing R]
    (f : Fin r → R) (ctx : PoweredKoszulApproximationContext.{uR, uK} f) (n : ℕ) :
    Nonempty (PoweredKoszulTateApproximation.{uR, uK, uA, uι} ctx n) := sorry

end
