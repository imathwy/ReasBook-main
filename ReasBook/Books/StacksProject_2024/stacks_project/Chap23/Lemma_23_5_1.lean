import Mathlib.RingTheory.DividedPowerAlgebra.Init
import StacksProject_2024.stacks_project.Chapters.Chap23.section03

open DividedPowers

universe uA uW uC

-- Semantic search returned only generic divided-powers hits, so the owner/API choice was
-- verified directly against the local mathlib snapshot, which provides the canonical
-- `DividedPowerAlgebra` owner with `dp` and `embed`, together with the local
-- `DividedPowerRing`/`DPMorphism` precedent from `section03`.

noncomputable section

section

variable (A : Type uA) [CommRing A] (W : Type uW)

/-- The divided-power polynomial algebra over `A` with variables indexed by `W`, represented by
the canonical mathlib divided-power algebra on finitely supported `A`-linear combinations of
variables. -/
abbrev indexedDividedPowerPolynomial : Type (max uA uW) :=
  DividedPowerAlgebra A (W →₀ A)

/-- The variable indexed by `w : W` inside the indexed divided-power polynomial algebra. -/
abbrev indexedDividedPowerPolynomialVariable (w : W) :
    indexedDividedPowerPolynomial A W :=
  DividedPowerAlgebra.embed A (W →₀ A) (Finsupp.single w (1 : A))

/-- Unfolding the indexed variable recovers the canonical divided-power algebra embedding of the
corresponding basis vector. -/
theorem indexedDividedPowerPolynomialVariable_def (w : W) :
    indexedDividedPowerPolynomialVariable A W w =
      DividedPowerAlgebra.embed A (W →₀ A) (Finsupp.single w (1 : A)) :=
  rfl

/-- The positive ideal of the indexed divided-power polynomial algebra, generated by all positive
divided powers of the variables. -/
def indexedDividedPowerPolynomialPositiveIdeal :
    Ideal (indexedDividedPowerPolynomial A W) :=
  Ideal.span <| Set.range fun q : W × ℕ+ ↦
    DividedPowerAlgebra.dp A (q.2 : ℕ) (Finsupp.single q.1 (1 : A))

/-- Unfolding the positive ideal recovers the span of the positive divided powers of all indexed
variables. -/
theorem indexedDividedPowerPolynomialPositiveIdeal_def :
    indexedDividedPowerPolynomialPositiveIdeal A W =
      Ideal.span (Set.range fun q : W × ℕ+ ↦
        DividedPowerAlgebra.dp A (q.2 : ℕ) (Finsupp.single q.1 (1 : A))) :=
  rfl

/-- The canonical ideal obtained by adjoining the base divided-power ideal and the positive
variable ideal. -/
def indexedDividedPowerPolynomialIdeal (I : Ideal A) :
    Ideal (indexedDividedPowerPolynomial A W) :=
  Ideal.map (algebraMap A (indexedDividedPowerPolynomial A W)) I +
    indexedDividedPowerPolynomialPositiveIdeal A W

/-- Unfolding the canonical indexed ideal recovers the sum of the image of the base
divided-power ideal and the positive variable ideal. -/
theorem indexedDividedPowerPolynomialIdeal_def (I : Ideal A) :
    indexedDividedPowerPolynomialIdeal A W I =
      Ideal.map (algebraMap A (indexedDividedPowerPolynomial A W)) I +
        indexedDividedPowerPolynomialPositiveIdeal A W :=
  rfl

variable {A W}

/-- A ring hom out of the indexed divided-power polynomial algebra is a lift of the chosen base
divided-power morphism with prescribed images for all indexed variables. -/
class IsIndexedDividedPowerPolynomialLift
    (I : Ideal A) (γ : DividedPowers I)
    {C : Type uC} [CommRing C] (K : Ideal C) (ε : DividedPowers K)
    (δ : DividedPowers (indexedDividedPowerPolynomialIdeal A W I))
    (f : DPMorphism γ ε) (k : W → K)
    (φ : indexedDividedPowerPolynomial A W →+* C) : Prop
    extends IsDPMorphism δ ε φ where
  /-- The lift restricts to the chosen divided-power morphism on the base ring. -/
  comp_algebraMap :
    φ.comp (algebraMap A (indexedDividedPowerPolynomial A W)) = f.toRingHom
  /-- The lift sends each indexed variable to its prescribed element of the target ideal. -/
  variable_eq (w : W) : φ (indexedDividedPowerPolynomialVariable A W w) = k w

/-- The source-facing lift predicate exposes exactly the divided-power morphism condition, the
base-map compatibility, and the prescribed values on indexed variables. -/
theorem isIndexedDividedPowerPolynomialLift_iff
    {I : Ideal A} {γ : DividedPowers I}
    {C : Type uC} [CommRing C] {K : Ideal C} {ε : DividedPowers K}
    {δ : DividedPowers (indexedDividedPowerPolynomialIdeal A W I)}
    {f : DPMorphism γ ε} {k : W → K}
    {φ : indexedDividedPowerPolynomial A W →+* C} :
    IsIndexedDividedPowerPolynomialLift I γ K ε δ f k φ ↔
      IsDPMorphism δ ε φ ∧
        φ.comp (algebraMap A (indexedDividedPowerPolynomial A W)) = f.toRingHom ∧
        ∀ w : W, φ (indexedDividedPowerPolynomialVariable A W w) = k w := by
  constructor
  · intro hφ
    exact ⟨hφ.toIsDPMorphism, hφ.comp_algebraMap, hφ.variable_eq⟩
  · rintro ⟨hφ, hcomp, hvar⟩
    exact ⟨hφ, hcomp, hvar⟩

end

section

variable (A : Type uA) [CommRing A]
variable (I : Ideal A) (γ : DividedPowers I) (t : ℕ)

/-- The divided power polynomial algebra on `t` variables over `A`, formalized as the `Fin t`
specialization of the indexed divided-power polynomial owner. -/
abbrev dividedPowerPolynomial : Type uA :=
  indexedDividedPowerPolynomial A (Fin t)

/-- The `i`th adjoined divided-power variable inside `A⟨x_1, \ldots, x_t⟩`. -/
abbrev dividedPowerPolynomialVariable (i : Fin t) :
    dividedPowerPolynomial A t :=
  indexedDividedPowerPolynomialVariable A (Fin t) i

/-- Unfolding the `i`th variable recovers the canonical divided-power algebra embedding of the
corresponding basis vector. -/
theorem dividedPowerPolynomialVariable_def (i : Fin t) :
    dividedPowerPolynomialVariable A t i =
      DividedPowerAlgebra.embed A (Fin t →₀ A) (Finsupp.single i (1 : A)) :=
  rfl

/-- The positive ideal `A⟨x_1, \ldots, x_t⟩_+`, generated by the positive divided powers
`x_i^[n]` of the adjoined variables. -/
def dividedPowerPolynomialPositiveIdeal :
    Ideal (dividedPowerPolynomial A t) :=
  indexedDividedPowerPolynomialPositiveIdeal A (Fin t)

/-- The canonical ideal `J = IA⟨x_1, \ldots, x_t⟩ + A⟨x_1, \ldots, x_t⟩_+` of the divided power
polynomial algebra. -/
def dividedPowerPolynomialIdeal :
    Ideal (dividedPowerPolynomial A t) :=
  indexedDividedPowerPolynomialIdeal A (Fin t) I

/-- Unfolding the positive ideal recovers it as the span of the positive divided powers
`x_i^[n]` of the adjoined variables. -/
theorem dividedPowerPolynomialPositiveIdeal_def :
    dividedPowerPolynomialPositiveIdeal A t =
      Ideal.span (Set.range fun q : Fin t × ℕ+ ↦
        DividedPowerAlgebra.dp A (q.2 : ℕ) (Finsupp.single q.1 (1 : A))) :=
  rfl

/-- Unfolding the canonical ideal recovers the source formula
`J = IA⟨x_1, \ldots, x_t⟩ + A⟨x_1, \ldots, x_t⟩_+`. -/
theorem dividedPowerPolynomialIdeal_def :
    dividedPowerPolynomialIdeal A I t =
      Ideal.map (algebraMap A (dividedPowerPolynomial A t)) I +
        dividedPowerPolynomialPositiveIdeal A t :=
  rfl

/-- Lemma 23.5.1 (1): on the canonical ideal
`J = IA⟨x_1, \ldots, x_t⟩ + A⟨x_1, \ldots, x_t⟩_+` there is a unique divided power structure whose
`n`th divided power of the `i`th variable is the canonical class `x_i^[n]`, and for which the
base map `A → A⟨x_1, \ldots, x_t⟩` is a divided power morphism. -/
@[stacks 07H5]
theorem existsUnique_dividedPowerPolynomialDividedPowers :
    ∃! δ : DividedPowers (dividedPowerPolynomialIdeal A I t),
      (∀ n : ℕ, ∀ i : Fin t,
        δ.dpow n (dividedPowerPolynomialVariable A t i) =
          DividedPowerAlgebra.dp A n (Finsupp.single i (1 : A))) ∧
      IsDPMorphism γ δ (algebraMap A (dividedPowerPolynomial A t)) := sorry

/-- A ring hom out of the divided power polynomial algebra is a lift of the chosen base
divided power morphism `f` with prescribed images `k` for the adjoined variables. -/
abbrev IsDividedPowerPolynomialLift
    {C : Type uC} [CommRing C] (K : Ideal C) (ε : DividedPowers K)
    (δ : DividedPowers (dividedPowerPolynomialIdeal A I t))
    (f : DPMorphism γ ε) (k : Fin t → K)
    (φ : dividedPowerPolynomial A t →+* C) : Prop :=
  IsIndexedDividedPowerPolynomialLift (A := A) (W := Fin t) I γ K ε δ f k φ

/-- The source-facing lift predicate is exactly the conjunction of the divided-power morphism
condition, the prescribed base map, and the chosen values of the adjoined variables. -/
theorem isDividedPowerPolynomialLift_iff
    {C : Type uC} [CommRing C] {K : Ideal C} {ε : DividedPowers K}
    {δ : DividedPowers (dividedPowerPolynomialIdeal A I t)}
    {f : DPMorphism γ ε} {k : Fin t → K} {φ : dividedPowerPolynomial A t →+* C} :
    IsDividedPowerPolynomialLift A I γ t K ε δ f k φ ↔
      IsDPMorphism δ ε φ ∧
        φ.comp (algebraMap A (dividedPowerPolynomial A t)) = f.toRingHom ∧
        ∀ i : Fin t, φ (dividedPowerPolynomialVariable A t i) = k i := by
  simpa [IsDividedPowerPolynomialLift, dividedPowerPolynomialVariable] using
    (isIndexedDividedPowerPolynomialLift_iff
      (A := A) (W := Fin t) (I := I) (γ := γ) (K := K) (ε := ε) (δ := δ)
      (f := f) (k := k) (φ := φ))

/-- Lemma 23.5.1 (2): for any target divided power ring `(C, K, ε)`, a divided power morphism
from `A⟨x_1, \ldots, x_t⟩` with the canonical divided powers on
`J = IA⟨x_1, \ldots, x_t⟩ + A⟨x_1, \ldots, x_t⟩_+` is uniquely determined by its restriction
`A → C` and the chosen images of the adjoined variables in `K`. -/
@[stacks 07H5]
theorem existsUnique_dividedPowerPolynomialLift
    {C : Type uC} [CommRing C] (K : Ideal C) (ε : DividedPowers K)
    (δ : DividedPowers (dividedPowerPolynomialIdeal A I t))
    (hδvar : ∀ n : ℕ, ∀ i : Fin t,
      δ.dpow n (dividedPowerPolynomialVariable A t i) =
        DividedPowerAlgebra.dp A n (Finsupp.single i (1 : A)))
    (hδbase : IsDPMorphism γ δ (algebraMap A (dividedPowerPolynomial A t)))
    (f : DPMorphism γ ε) (k : Fin t → K) :
    ∃! φ : dividedPowerPolynomial A t →+* C,
      IsDividedPowerPolynomialLift A I γ t K ε δ f k φ := sorry

end

