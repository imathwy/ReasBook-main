import StacksProject_2024.stacks_project.Chap10.Definition_10_110_7
import StacksProject_2024.stacks_project.Chap10.Definition_10_135_5
import StacksProject_2024.stacks_project.Chap23.Definition_23_8_5

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

variable {R : Type u} [CommRing R] [IsRegularRing R]
variable (p : PrimeSpectrum R) (fs : List p.asIdeal)

local notation "Rₚ" => Localization.AtPrime p.asIdeal
local notation "Iₚ" => Ideal.map (algebraMap R Rₚ) (Ideal.ofList (fs.map p.asIdeal.subtype))

/-
Source/core/bridge triage:
* source-facing: the regular sequence `fs : List p.asIdeal` from the Stacks statement;
* core/canonical: `Ideal.IsGeneratedByRegularSequence` and the chapter owner
  `IsCompleteIntersectionLocalRing` on the local quotient;
* bridge/view: the canonical localized ideal `Iₚ`.

The source-facing statement should therefore keep the explicit sequence in the prime ideal, but the
quotient ideal itself should be expressed through the canonical ideal-localization bridge rather
than by rebuilding a second list-side ideal in the localized ring.
-/

/-- Lemma 23.8.2: if `R` is a regular ring, `p` is a prime of `R`, and `fs` is a regular sequence
of elements of `p`, then the local quotient `Rₚ / Iₚ` is a complete intersection local
ring, equivalently its maximal-ideal completion is a complete intersection complete local ring. -/
@[stacks 09Q0]
theorem isCompleteIntersectionLocalRing_quotient_atPrime_of_regularSequence
    (hfs : RingTheory.Sequence.IsRegular R (fs.map p.asIdeal.subtype)) :
    IsCompleteIntersectionLocalRing (Rₚ ⧸ Iₚ) := by
  sorry

/-- The localized ideal generated by a regular sequence in `p` is generated by a regular sequence
in the local ring `Rₚ`. This is the bridge from the source-facing list of generators to the
canonical ideal-level owner used elsewhere in the chapter. -/
theorem ideal_map_isGeneratedByRegularSequence_atPrime_of_regularSequence
    (hfs : RingTheory.Sequence.IsRegular R (fs.map p.asIdeal.subtype)) :
    (Iₚ).IsGeneratedByRegularSequence := by
  sorry

end
