import StacksProject_2024.Chap10.Remark_10_160_9
import StacksProject_2024.Chap23.CompleteIntersectionCompleteLocalRing

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open IsLocalRing

section

variable {A : Type u} [CommRing A]

/-
Source/core/bridge triage:
* source-facing: the universality clause over regular-local presentations of `A`;
* core/canonical: `IsCompleteIntersectionCompleteLocalRing A`;
* bridge/view: the canonical owner companions
  the theorem `RingHom.RegularLocalPresentation.nonempty`,
  `RingHom.RegularLocalPresentation
    .kernelIsGeneratedByRegularSequence_iff_isCompleteIntersectionCompleteLocalRing`,
  `IsCompleteIntersectionCompleteLocalRing.presentation`, and
  `IsCompleteIntersectionCompleteLocalRing.of_exists_regularLocalPresentation`.

`RingHom.RegularLocalPresentation A` is the source-facing owner for the presentation data, while
`RingHom.IsRegularLocalPresentation` remains the map-level predicate on its structure map. This
keeps the lemma on textbook presentations rather than a raw existential telescope, and uses the
canonical owner companions above instead of a duplicate local existence wrapper.
-/

section

variable [IsNoetherianRing A] [IsCompleteLocalRing A]

namespace RingHom.RegularLocalPresentation

/-- Helper for 09PZ: a Noetherian complete local ring admits a regular-local presentation. -/
theorem nonempty : Nonempty (RingHom.RegularLocalPresentation A) := by
  rcases exists_regularLocalRing_quotient_of_isCompleteLocalRing A with
    ⟨R, _, _, I, ⟨e⟩⟩
  let q : R →+* A := e.toRingHom.comp (Ideal.Quotient.mk I)
  have hq_local : IsLocalHom q := by
    let er := e.toRingHom
    have her : IsLocalHom er := by
      refine IsLocalHom.mk fun x hx_unit ↦ ?_
      have : IsUnit (e.symm (er x)) := by
        simpa using hx_unit.map e.symm
      simpa [er] using this
    letI : Nontrivial A := IsLocalRing.toNontrivial
    letI : Nontrivial (R ⧸ I) := e.toEquiv.nontrivial
    letI : IsLocalHom (Ideal.Quotient.mk I) :=
      Function.Surjective.isLocalHom _ Ideal.Quotient.mk_surjective
    simpa [q, er] using
      (RingHom.isLocalHom_comp er (Ideal.Quotient.mk I) : IsLocalHom (er.comp (Ideal.Quotient.mk I)))
  refine ⟨RingHom.RegularLocalPresentation.ofHom q ?_⟩
  exact ⟨hq_local, e.surjective.comp Ideal.Quotient.mk_surjective⟩

/-- For a Noetherian complete local ring, the regular-sequence kernel condition is independent of
the chosen regular-local presentation. -/
theorem kernelIsGeneratedByRegularSequence_iff_isCompleteIntersectionCompleteLocalRing
    (P : RingHom.RegularLocalPresentation A) :
    P.KernelIsGeneratedByRegularSequence ↔ IsCompleteIntersectionCompleteLocalRing A := by
  constructor
  · exact P.isCompleteIntersectionCompleteLocalRing
  · intro hA
    letI : IsCompleteIntersectionCompleteLocalRing A := hA
    sorry

/-- In a complete-intersection complete local ring, every regular-local presentation has kernel
generated by a regular sequence. -/
theorem kernelIsGeneratedByRegularSequence
    [IsCompleteIntersectionCompleteLocalRing A]
    (P : RingHom.RegularLocalPresentation A) :
    P.KernelIsGeneratedByRegularSequence := by
  exact
    (P.kernelIsGeneratedByRegularSequence_iff_isCompleteIntersectionCompleteLocalRing).2
      inferInstance

/-- For a Noetherian complete local ring, the regular-sequence kernel condition is independent of
the chosen regular-local presentation. -/
theorem kernelIsGeneratedByRegularSequence_iff_of_regularLocalPresentation
    (P Q : RingHom.RegularLocalPresentation A) :
    P.KernelIsGeneratedByRegularSequence ↔ Q.KernelIsGeneratedByRegularSequence := by
  rw [P.kernelIsGeneratedByRegularSequence_iff_isCompleteIntersectionCompleteLocalRing,
    Q.kernelIsGeneratedByRegularSequence_iff_isCompleteIntersectionCompleteLocalRing]

end RingHom.RegularLocalPresentation

/-- Lemma 23.8.1: for a Noetherian complete local ring `A`, it is enough that one regular-local
presentation of `A` have kernel generated by a regular sequence; then every regular-local
presentation does. -/
@[stacks 09PZ]
theorem exists_regularLocalPresentation_kernelIsGeneratedByRegularSequence_iff_forall :
    (∃ P : RingHom.RegularLocalPresentation A,
      P.KernelIsGeneratedByRegularSequence) ↔
      ∀ P : RingHom.RegularLocalPresentation A, P.KernelIsGeneratedByRegularSequence := by
  constructor
  · rintro ⟨P, hP⟩ Q
    exact (P.kernelIsGeneratedByRegularSequence_iff_of_regularLocalPresentation Q).1 hP
  · intro hP
    have hne : Nonempty (RingHom.RegularLocalPresentation A) :=
      RingHom.RegularLocalPresentation.nonempty
    rcases hne with ⟨P⟩
    exact ⟨P, hP P⟩

end

end
