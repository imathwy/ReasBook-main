/-- Helper for 09QD: the regularity hypothesis may be stated on the canonical closed fiber
`Ideal.Fiber (maximalIdeal A) S`, and this identifies the same completed-map criterion. -/
theorem kernelIsGeneratedByRegularSequence_iff_completionMap_isLocalCompleteIntersection_of_regularClosedFiber
    (hSB : Function.Surjective (algebraMap S B))
    (hclosedFiber : IsRegularLocalRing (Ideal.Fiber (maximalIdeal A) S)) :
    (algebraMap S B).KernelIsGeneratedByRegularSequence ↔
      RingHom.IsLocalCompleteIntersection (maximalIdealCompletionMap (algebraMap A B)) := by
  sorry

/-- Lemma 23.9.4: for a commutative diagram `A → S → B` of Noetherian local rings with `S → B`
surjective, `A → S` flat, and regular closed fiber `S / 𝔪_A S`, the kernel of `S → B` is
generated by a regular sequence if and only if the induced map on maximal-ideal completions
`A^∧ → B^∧` is a local complete intersection homomorphism. -/
@[stacks 09QD]
theorem kernelIsGeneratedByRegularSequence_iff_completionMap_isLocalCompleteIntersection
    (hSB : Function.Surjective (algebraMap S B))
    (hclosedFiber : IsRegularLocalRing (S ⧸ Ideal.map (algebraMap A S) (maximalIdeal A))) :
    (algebraMap S B).KernelIsGeneratedByRegularSequence ↔
      RingHom.IsLocalCompleteIntersection (maximalIdealCompletionMap (algebraMap A B)) := by
  have hclosedFiber' : IsRegularLocalRing (Ideal.Fiber (maximalIdeal A) S) := by
    let _ : IsRegularLocalRing (S ⧸ Ideal.map (algebraMap A S) (maximalIdeal A)) := hclosedFiber
    exact IsRegularLocalRing.of_ringEquiv
      ((closedFiberQuotAlgEquiv :
          Ideal.Fiber (maximalIdeal A) S ≃ₐ[A]
            S ⧸ Ideal.map (algebraMap A S) (maximalIdeal A)).symm.toRingEquiv)
  simpa using
    kernelIsGeneratedByRegularSequence_iff_completionMap_isLocalCompleteIntersection_of_regularClosedFiber
      hSB hclosedFiber'

end

