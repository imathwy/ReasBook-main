import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.RingTheory.DividedPowerAlgebra.Init
import Mathlib.RingTheory.FiniteType
import StacksProject_2024.Chap23.Definition_23_6_5

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe uR uS uJ uι uA uB uH0A uH0B

open DifferentialGradedAlgebra

/- Semantic search note: `lean_leansearch` surfaced only the generic ideal-based divided-powers
API in mathlib, while local Chapter 23 search showed that this section already uses the explicit
`CompatibleDividedPowers` owner from `Definition_23_6_5` and packages existence statements as
`Nonempty` of a bundled resolution object. This file therefore records a Tate resolution over a
chosen polynomial presentation `π₀ : R[x_j] → S` by combining explicit grading/differential data
with a canonical polynomial-plus-divided-power presentation owner. -/

section

variable {R : Type uR} {S : Type uS} [CommRing R] [CommRing S] [Algebra R S]
variable {J : Type uJ}

/-- The canonical `R`-algebra generated by ordinary polynomial variables `x_j` in degree `0`
and divided-power variables in strictly positive degrees. This is the library-facing owner used in
this file for a graded divided power polynomial algebra over `R` with degree-zero polynomial part
`R[x_j : j ∈ J]`. -/
abbrev TatePolynomialAlgebra (R : Type uR) [CommRing R] (J : Type uJ)
    (vars : ℕ+ → Type uι) : Type (max uR uJ uι) :=
  MvPolynomial J (DividedPowerAlgebra R ((Σ n : ℕ+, vars n) →₀ R))

/-- The degree-zero polynomial part of the canonical Tate polynomial algebra is obtained by
mapping coefficients along the algebra map `R → DividedPowerAlgebra R (...)`. -/
abbrev polynomialPart
    (R : Type uR) [CommRing R] (J : Type uJ) (vars : ℕ+ → Type uι) :
    MvPolynomial J R →ₐ[R] TatePolynomialAlgebra R J vars :=
  MvPolynomial.mapAlgHom
    (Algebra.ofId R (DividedPowerAlgebra R ((Σ n : ℕ+, vars n) →₀ R)))

/-- Expanding `polynomialPart` shows that it is the coefficientwise algebra-map inclusion of the
polynomial ring `R[x_j : j ∈ J]` into the canonical Tate polynomial algebra. -/
theorem polynomialPart_def
    (R : Type uR) [CommRing R] (J : Type uJ) (vars : ℕ+ → Type uι) :
    polynomialPart R J vars =
      MvPolynomial.mapAlgHom
        (Algebra.ofId R (DividedPowerAlgebra R ((Σ n : ℕ+, vars n) →₀ R))) :=
  rfl

/-- The positive generator indexed by `v : vars n` inside the canonical Tate polynomial algebra,
viewed through the divided-power algebra factor. Its index `n : ℕ+` records the intended
homogeneous degree of this generator. -/
abbrev positiveGenerator
    (R : Type uR) [CommRing R] (J : Type uJ) (vars : ℕ+ → Type uι)
    (n : ℕ+) (v : vars n) :
    TatePolynomialAlgebra R J vars :=
  MvPolynomial.C
    (DividedPowerAlgebra.embed R ((Σ n : ℕ+, vars n) →₀ R)
      (Finsupp.single (Sigma.mk n v) (1 : R)))

/-- A compatible graded divided-power differential graded `R`-algebra, recorded in the explicit
Chapter 23 style: a commutative `R`-algebra with a grading, a differential, divided powers, and
the basic grading identities used by the Tate-resolution statements. -/
structure GradedDividedPowerDGAlgebra (R : Type uR) [CommRing R] where
  /-- The underlying commutative `R`-algebra. -/
  carrier : Type uA
  /-- The commutative ring structure on the underlying carrier. -/
  [instCommRing : CommRing carrier]
  /-- The structural `R`-algebra map. -/
  [instAlgebra : Algebra R carrier]
  /-- The homogeneous pieces `A_n` of the grading. -/
  grading : ℕ → Submodule R carrier
  /-- The differential. -/
  d : Derivation R carrier carrier
  /-- The chosen divided-power operations. -/
  gamma : ℕ → carrier → carrier
  /-- Compatibility between the differential and the divided powers in the sense of
  Definition 23.6.5. -/
  compatible : CompatibleDividedPowers grading d gamma
  /-- Scalars lie in degree `0`. -/
  algebraMap_mem : ∀ r : R, algebraMap R carrier r ∈ grading 0
  /-- Homogeneous multiplication respects the grading. -/
  mul_mem :
    ∀ ⦃m n : ℕ⦄ ⦃x y : carrier⦄,
      x ∈ grading m → y ∈ grading n → x * y ∈ grading (m + n)
  /-- The differential lowers degree by one. -/
  d_mem :
    ∀ ⦃n : ℕ⦄ ⦃x : carrier⦄, x ∈ grading (n + 1) → d x ∈ grading n
  /-- The differential vanishes on degree `0`. -/
  d_zero :
    ∀ ⦃x : carrier⦄, x ∈ grading 0 → d x = 0
  /-- The differential squares to zero. -/
  d_sq : ∀ x : carrier, d (d x) = 0

/-- A graded divided-power differential graded algebra can be used as its underlying carrier
type. -/
instance :
    CoeSort (GradedDividedPowerDGAlgebra R) (Type uA) where
  coe A := A.carrier

/-- A graded divided-power differential graded algebra carries its underlying commutative ring
structure. -/
instance (A : GradedDividedPowerDGAlgebra R) : CommRing A :=
  A.instCommRing

/-- A graded divided-power differential graded algebra carries its structural `R`-algebra map. -/
instance (A : GradedDividedPowerDGAlgebra R) : Algebra R A :=
  A.instAlgebra

namespace GradedDividedPowerDGAlgebra

/-- Vanishing of positive homology for a compatible graded differential algebra, written in the
elementwise source form: every closed homogeneous element in positive degree is a boundary from
the next degree. -/
def PositiveHomologyVanishes
    (A : GradedDividedPowerDGAlgebra.{uR, uA} R) : Prop :=
  ∀ ⦃n : ℕ⦄, 0 < n → ∀ ⦃x : A⦄, x ∈ A.grading n → A.d x = 0 →
    ∃ y : A, y ∈ A.grading (n + 1) ∧ A.d y = x

/-- Unfolding positive homology vanishing recovers the source cycle-boundary condition in each
positive degree. -/
theorem positiveHomologyVanishes_iff
    (A : GradedDividedPowerDGAlgebra.{uR, uA} R) :
    A.PositiveHomologyVanishes ↔
      ∀ ⦃n : ℕ⦄, 0 < n → ∀ ⦃x : A⦄, x ∈ A.grading n → A.d x = 0 →
        ∃ y : A, y ∈ A.grading (n + 1) ∧ A.d y = x :=
  Iff.rfl

/-- A source-facing presentation of a compatible differential graded algebra as a graded divided
power polynomial algebra over `R`: ordinary polynomial variables in degree `0`, divided-power
variables in positive degrees, and the chosen divided powers on the positive generators matching
the canonical divided powers in `TatePolynomialAlgebra`. -/
structure PolynomialPresentation
    (A : GradedDividedPowerDGAlgebra.{uR, uA} R) where
  /-- The degree-zero ordinary polynomial variables. -/
  degreeZeroVars : Type uJ
  /-- The positive-degree divided-power variables. -/
  positiveVars : ℕ+ → Type uι
  /-- The algebra presentation by the canonical polynomial-plus-divided-power algebra. -/
  equiv : A ≃ₐ[R] TatePolynomialAlgebra R degreeZeroVars positiveVars
  /-- Each degree-zero polynomial generator lies in the homogeneous degree-zero part. -/
  degreeZero_generator_mem :
    ∀ j : degreeZeroVars,
      equiv.symm ((polynomialPart R degreeZeroVars positiveVars) (MvPolynomial.X j)) ∈
        A.grading 0
  /-- Each positive divided-power generator lies in its declared positive degree. -/
  positive_generator_mem :
    ∀ n : ℕ+, ∀ v : positiveVars n,
      equiv.symm (positiveGenerator R degreeZeroVars positiveVars n v) ∈ A.grading n
  /-- The chosen divided powers on positive generators agree with the canonical divided powers in
  the presentation. -/
  gamma_positiveGenerator :
    ∀ k : ℕ, ∀ n : ℕ+, ∀ v : positiveVars n,
      A.gamma k (equiv.symm (positiveGenerator R degreeZeroVars positiveVars n v)) =
        equiv.symm
          (MvPolynomial.C
            (DividedPowerAlgebra.dp R k
              (Finsupp.single (Sigma.mk n v) (1 : R))))

/-- A graded divided-power polynomial presentation can be used as its algebra equivalence with the
canonical polynomial-plus-divided-power algebra. -/
instance
    (A : GradedDividedPowerDGAlgebra.{uR, uA} R) :
    CoeFun A.PolynomialPresentation
      (fun P ↦ A ≃ₐ[R] TatePolynomialAlgebra R P.degreeZeroVars P.positiveVars) where
  coe P := P.equiv

/-- In a graded divided-power polynomial presentation, the chosen divided powers of each positive
generator match the canonical divided-power monomials in the model algebra. -/
theorem PolynomialPresentation.gamma_positiveGenerator_eq
    {A : GradedDividedPowerDGAlgebra.{uR, uA} R}
    (P : A.PolynomialPresentation) (k : ℕ) (n : ℕ+) (v : P.positiveVars n) :
    A.gamma k (P.equiv.symm (positiveGenerator R P.degreeZeroVars P.positiveVars n v)) =
      P.equiv.symm
        (MvPolynomial.C
          (DividedPowerAlgebra.dp R k
            (Finsupp.single (Sigma.mk n v) (1 : R)))) :=
  P.gamma_positiveGenerator k n v

end GradedDividedPowerDGAlgebra

/-- A homomorphism of compatible graded divided-power differential graded `R`-algebras: an
`R`-algebra map preserving the grading, commuting with the differential, and respecting divided
powers on the positive even part. -/
structure GradedDividedPowerDGAlgebraHom
    (R : Type uR) [CommRing R]
    (A : GradedDividedPowerDGAlgebra.{uR, uA} R)
    (B : GradedDividedPowerDGAlgebra.{uR, uB} R) where
  /-- The underlying `R`-algebra map. -/
  toAlgHom : A →ₐ[R] B
  /-- The grading is preserved degreewise. -/
  map_grading :
    ∀ ⦃n : ℕ⦄ ⦃x : A⦄, x ∈ A.grading n → toAlgHom x ∈ B.grading n
  /-- The differential commutes with the map. -/
  comm_d : ∀ x : A, toAlgHom (A.d x) = B.d (toAlgHom x)
  /-- Divided powers on the positive even part are preserved. -/
  map_gamma :
    ∀ ⦃n : ℕ⦄ ⦃x : A⦄,
      x ∈ evenPositivePart A.grading →
        toAlgHom (A.gamma n x) = B.gamma n (toAlgHom x)

/-- A homomorphism of compatible graded divided-power differential graded algebras can be used as
its underlying function. -/
instance
    (A : GradedDividedPowerDGAlgebra.{uR, uA} R)
    (B : GradedDividedPowerDGAlgebra.{uR, uB} R) :
    CoeFun (GradedDividedPowerDGAlgebraHom R A B) (fun _ ↦ A → B) where
  coe φ := φ.toAlgHom

/-- Evaluating a graded divided-power differential graded algebra homomorphism is evaluating its
underlying algebra map. -/
@[simp]
theorem GradedDividedPowerDGAlgebraHom.coe_apply
    {A : GradedDividedPowerDGAlgebra.{uR, uA} R}
    {B : GradedDividedPowerDGAlgebra.{uR, uB} R}
    (φ : GradedDividedPowerDGAlgebraHom R A B)
    (x : A) :
    φ x = φ.toAlgHom x :=
  rfl

namespace GradedDividedPowerDGAlgebraHom

/-- A graded divided-power differential graded algebra homomorphism induces the chosen map on
degree-zero homology when it agrees with that map on degree-zero representatives. -/
def InducesH0
    {A : GradedDividedPowerDGAlgebra.{uR, uA} R}
    {B : GradedDividedPowerDGAlgebra.{uR, uB} R}
    (φ : GradedDividedPowerDGAlgebraHom R A B)
    {H0A : Type uH0A} [CommRing H0A] [Algebra R H0A]
    {H0B : Type uH0B} [CommRing H0B] [Algebra R H0B]
    (qA : A →ₐ[R] H0A) (qB : B →ₐ[R] H0B) (φbar : H0A →ₐ[R] H0B) : Prop :=
  ∀ ⦃x : A⦄, x ∈ A.grading 0 → φbar (qA x) = qB (φ x)

/-- Unfolding `InducesH0` recovers the source degree-zero representative formula for the induced
map on `H₀`. -/
theorem inducesH0_iff
    {A : GradedDividedPowerDGAlgebra.{uR, uA} R}
    {B : GradedDividedPowerDGAlgebra.{uR, uB} R}
    (φ : GradedDividedPowerDGAlgebraHom R A B)
    {H0A : Type uH0A} [CommRing H0A] [Algebra R H0A]
    {H0B : Type uH0B} [CommRing H0B] [Algebra R H0B]
    (qA : A →ₐ[R] H0A) (qB : B →ₐ[R] H0B) (φbar : H0A →ₐ[R] H0B) :
    φ.InducesH0 qA qB φbar ↔
      ∀ ⦃x : A⦄, x ∈ A.grading 0 → φbar (qA x) = qB (φ x) :=
  Iff.rfl

end GradedDividedPowerDGAlgebraHom

/-- A Tate resolution of the chosen polynomial presentation `π₀ : R[x_j : j ∈ J] → S` consists
of a compatible differential graded divided-power `R`-algebra `A`, a comparison map `A → S`, and
an explicit presentation of `A` by polynomial variables in degree `0` and divided-power variables
in every positive degree. The quasi-isomorphism to `S` with the zero differential is recorded
elementwise by exactness in positive degrees and by the usual degree-zero cokernel condition. -/
structure TateResolution (π₀ : MvPolynomial J R →ₐ[R] S)
    extends GradedDividedPowerDGAlgebra.{uR, uA} R where
  /-- The positive-degree generators of the graded divided power polynomial presentation of `A`. -/
  positiveVars : ℕ+ → Type uι
  /-- The chosen algebra presentation of `A` by polynomial variables in degree `0` and
  divided-power variables in positive degrees. -/
  presentation : carrier ≃ₐ[R] TatePolynomialAlgebra R J positiveVars
  /-- The comparison map `A → S`. -/
  toS : carrier →ₐ[R] S
  /-- The chosen polynomial degree-zero presentation factors through the comparison map `A → S`
  and the canonical degree-zero polynomial inclusion into the Tate polynomial algebra. -/
  comparison_polynomialPart :
    ∀ p : MvPolynomial J R,
      toS (presentation.symm ((polynomialPart R J positiveVars) p)) = π₀ p
  /-- Each degree-zero polynomial generator remains in the degree-zero piece of `A`. -/
  polynomial_generator_mem :
    ∀ j : J,
      presentation.symm ((polynomialPart R J positiveVars) (MvPolynomial.X j)) ∈ grading 0
  /-- Each positive generator of degree `n` lies in the homogeneous piece `A_n`. -/
  positive_generator_mem :
    ∀ n : ℕ+, ∀ v : positiveVars n,
      presentation.symm (positiveGenerator R J positiveVars n v) ∈ grading n
  /-- The chosen divided powers on positive generators agree with the canonical divided powers in
  the presentation. -/
  gamma_positiveGenerator :
    ∀ k : ℕ, ∀ n : ℕ+, ∀ v : positiveVars n,
      gamma k (presentation.symm (positiveGenerator R J positiveVars n v)) =
        presentation.symm
          (MvPolynomial.C
            (DividedPowerAlgebra.dp R k
              (Finsupp.single (Sigma.mk n v) (1 : R))))
  /-- The comparison map kills boundaries because `S` carries the zero differential. -/
  toS_d :
    ∀ x : carrier, toS (d x) = 0
  /-- The induced map on degree-zero homology is surjective. -/
  h0_surjective :
    ∀ s : S, ∃ x : carrier, x ∈ grading 0 ∧ toS x = s
  /-- A degree-zero cycle maps to `0` in `S` exactly when it is a boundary from degree `1`. -/
  h0_exact :
    ∀ ⦃x : carrier⦄, x ∈ grading 0 → toS x = 0 →
      ∃ y : carrier, y ∈ grading 1 ∧ d y = x
  /-- Every cycle in a positive degree is a boundary from the next degree. This is the elementwise
  acyclicity part of the quasi-isomorphism to `S` with zero differential. -/
  higher_exact :
    ∀ ⦃n : ℕ⦄, 0 < n → ∀ ⦃x : carrier⦄, x ∈ grading n → d x = 0 →
      ∃ y : carrier, y ∈ grading (n + 1) ∧ d y = x

namespace TateResolution

/-- A Tate resolution can be used as its underlying resolving algebra. -/
instance (π₀ : MvPolynomial J R →ₐ[R] S) :
    CoeSort (TateResolution π₀) (Type uA) where
  coe A := A.toGradedDividedPowerDGAlgebra

/-- A Tate resolution carries its resolving commutative ring structure. -/
instance (π₀ : MvPolynomial J R →ₐ[R] S) (A : TateResolution π₀) :
    CommRing A :=
  A.instCommRing

/-- A Tate resolution carries its structural `R`-algebra map. -/
instance (π₀ : MvPolynomial J R →ₐ[R] S) (A : TateResolution π₀) :
    Algebra R A :=
  A.instAlgebra

/-- The underlying compatible graded divided-power differential graded algebra of a Tate
resolution has vanishing positive homology. -/
theorem positiveHomologyVanishes
    {π₀ : MvPolynomial J R →ₐ[R] S}
    (A : TateResolution π₀) :
    A.toGradedDividedPowerDGAlgebra.PositiveHomologyVanishes :=
  A.higher_exact

/-- The comparison map of a Tate resolution kills boundaries because the target ring `S` carries
the zero differential. -/
@[simp] theorem toS_d_apply
    {π₀ : MvPolynomial J R →ₐ[R] S}
    (A : TateResolution π₀) (x : A) :
    A.toS (A.d x) = 0 :=
  A.toS_d x

/-- On degree `0`, the comparison map of a Tate resolution vanishes exactly on boundaries from
degree `1`. This is the source-facing exactness statement for the induced map on `H₀`. -/
theorem toS_eq_zero_iff_exists_boundary
    {π₀ : MvPolynomial J R →ₐ[R] S}
    (A : TateResolution π₀) {x : A} (hx : x ∈ A.grading 0) :
    A.toS x = 0 ↔ ∃ y : A, y ∈ A.grading 1 ∧ A.d y = x := by
  constructor
  · exact A.h0_exact hx
  · rintro ⟨y, hy, rfl⟩
    simpa using A.toS_d y

/-- The polynomial-presentation data carried by a Tate resolution is the source degree-zero
specialization of the chapter's reusable graded divided-power polynomial presentation owner. -/
abbrev polynomialPresentation
    {π₀ : MvPolynomial J R →ₐ[R] S}
    (A : TateResolution π₀) :
    A.toGradedDividedPowerDGAlgebra.PolynomialPresentation where
  degreeZeroVars := J
  positiveVars := A.positiveVars
  equiv := A.presentation
  degreeZero_generator_mem := A.polynomial_generator_mem
  positive_generator_mem := A.positive_generator_mem
  gamma_positiveGenerator := A.gamma_positiveGenerator

/-- Having finitely many generators in each positive degree means that every degree-indexed set of
adjoined divided-power variables is finite. -/
def HasFiniteDegreeGenerators
    {π₀ : MvPolynomial J R →ₐ[R] S}
    (A : TateResolution π₀) : Prop :=
  ∀ n : ℕ+, Finite (A.positiveVars n)

/-- Unfolding `HasFiniteDegreeGenerators` recovers the degreewise finiteness condition on the
adjoined divided-power generators. -/
theorem hasFiniteDegreeGenerators_iff
    {π₀ : MvPolynomial J R →ₐ[R] S}
    (A : TateResolution π₀) :
    A.HasFiniteDegreeGenerators ↔ ∀ n : ℕ+, Finite (A.positiveVars n) :=
  Iff.rfl

end TateResolution

/-- Lemma 23.6.9 (1): for any surjection `π₀ : R[x_j : j ∈ J] → S` from a polynomial ring onto
`S`, there exists a Tate resolution of `S` over `R` whose degree-zero polynomial part is exactly
the chosen presentation `π₀`, whose differential and divided powers are compatible in the sense
of Definition 23.6.5, whose comparison map to `S` is a quasi-isomorphism for the zero
differential on `S`, and whose underlying algebra is a graded divided power polynomial algebra
over `R`. -/
@[stacks 09PN]
theorem exists_tateResolution
    (π₀ : MvPolynomial J R →ₐ[R] S) (hπ₀ : Function.Surjective π₀) :
    Nonempty (TateResolution π₀) := sorry

/-- Lemma 23.6.9 (2): if `R` is Noetherian and `S` is of finite type over `R`, then the Tate
resolution may be chosen with only finitely many adjoined generators in each positive degree. -/
@[stacks 09PN]
theorem exists_tateResolution_with_finiteDegreeGenerators
    [IsNoetherianRing R] [Algebra.FiniteType R S]
    (π₀ : MvPolynomial J R →ₐ[R] S) (hπ₀ : Function.Surjective π₀) :
    ∃ A : TateResolution π₀, A.HasFiniteDegreeGenerators := sorry

end
