import Mathlib
import StacksProject_2024.Chap10.Definition_10_135_5
import StacksProject_2024.Chap23.Lemma_23_7_4

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory

universe u

section

variable {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
variable {I J : Ideal A}

-- Semantic recall note: the semantic `lean_leansearch` tool was unavailable in this environment,
-- so the owner choices here were verified directly against local Chapter 10/15/23 precedents for
-- `Ideal.IsGeneratedByRegularSequence`, quotient ideals via `Ideal.map (Ideal.Quotient.mk I) J`,
-- and `ModuleHasFiniteTorDimension`.

/-- Lemma 23.7.5 (1): let `(A, 𝔪)` be a Noetherian local ring, and let `I ⊆ J ⊆ A` be proper
ideals. Assume `A / J` has finite tor dimension over `A / I`, and `J` is generated by a regular
sequence. Then `I` is generated by a regular sequence. -/
@[stacks 09PW]
theorem isGeneratedByRegularSequence_of_moduleHasFiniteTorDimension_quotient
    (hI : I ≠ ⊤) (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hTor :
      let _inst : Algebra (A ⧸ I) (A ⧸ J) := Ideal.quotientFactorAlgebra hIJ
      ModuleHasFiniteTorDimension (ModuleCat.of (A ⧸ I) (A ⧸ J)))
    (hJreg : J.IsGeneratedByRegularSequence) :
    I.IsGeneratedByRegularSequence := sorry

/-- Lemma 23.7.5 (2): let `(A, 𝔪)` be a Noetherian local ring, and let `I ⊆ J ⊆ A` be proper
ideals. Assume `A / J` has finite tor dimension over `A / I`, and `J` is generated by a regular
sequence. Then the quotient ideal `J / I` in `A / I` is generated by a regular sequence. -/
@[stacks 09PW]
theorem quotientIdeal_isGeneratedByRegularSequence_of_moduleHasFiniteTorDimension_quotient
    (hI : I ≠ ⊤) (hJ : J ≠ ⊤) (hIJ : I ≤ J)
    (hTor :
      let _inst : Algebra (A ⧸ I) (A ⧸ J) := Ideal.quotientFactorAlgebra hIJ
      ModuleHasFiniteTorDimension (ModuleCat.of (A ⧸ I) (A ⧸ J)))
    (hJreg : J.IsGeneratedByRegularSequence) :
    (Ideal.map (Ideal.Quotient.mk I) J).IsGeneratedByRegularSequence := sorry

end
