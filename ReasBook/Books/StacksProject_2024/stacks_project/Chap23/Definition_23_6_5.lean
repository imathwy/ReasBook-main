import Mathlib.Data.PNat.Defs
import Mathlib.RingTheory.Derivation.Basic

-- Declarations for this item will be appended below by the statement pipeline.

universe uR uA

namespace DifferentialGradedAlgebra

section

variable {R : Type uR} {A : Type uA}
variable [CommRing R] [CommRing A] [Algebra R A]

/- Source/core/bridge triage:
- `source-facing`: `CompatibleDividedPowers` records Definition 23.6.5 itself, namely the
  compatibility equation between the differential and the divided powers.
- `core/canonical`: the positive even part `A_{even,+}` is the canonical supremum of the positive
  even homogeneous pieces.
- `bridge/view`: companion lemmas expose the same compatibility formula with the source indexing
  `2 * (m + 1)`, the successor index `n + 1`, and ambient elements `x : A` together with
  membership in `A_{even,+}`.
-/

/-- The positive even part `A_{even,+}` of a graded `R`-algebra, recorded canonically as the
submodule generated by the homogeneous pieces of degrees `2n` for positive integers `n`. -/
def evenPositivePart (grading : ℕ → Submodule R A) : Submodule R A :=
  ⨆ n : ℕ+, grading (2 * (n : ℕ))

/-- Each positive even homogeneous piece lies in the canonical positive even part
`A_{even,+}`. -/
theorem le_evenPositivePart
    (grading : ℕ → Submodule R A) (n : ℕ+) :
    grading (2 * (n : ℕ)) ≤ evenPositivePart grading := by
  simpa [evenPositivePart] using
    (le_iSup (fun k : ℕ+ ↦ grading (2 * (k : ℕ))) n)

/-- The source-indexed piece `A_{2(m + 1)}` lies in the canonical positive even part
`A_{even,+}`. -/
theorem le_evenPositivePart_nat
    (grading : ℕ → Submodule R A) (m : ℕ) :
    grading (2 * (m + 1)) ≤ evenPositivePart grading := by
  simpa using le_evenPositivePart grading (Nat.succPNat m)

/-- An element in an explicit positive even homogeneous piece belongs to `A_{even,+}`. -/
theorem mem_evenPositivePart_of_mem
    {grading : ℕ → Submodule R A} {n : ℕ+} {x : A}
    (hx : x ∈ grading (2 * (n : ℕ))) :
    x ∈ evenPositivePart grading :=
  le_evenPositivePart grading n hx

/-- An element in the explicit piece `A_{2(m + 1)}` belongs to `A_{even,+}`. -/
theorem mem_evenPositivePart_of_mem_nat
    {grading : ℕ → Submodule R A} {m : ℕ} {x : A}
    (hx : x ∈ grading (2 * (m + 1))) :
    x ∈ evenPositivePart grading := by
  exact le_evenPositivePart_nat grading m hx

/-- Definition 23.6.5: let `A` be a differential graded `R`-algebra and let `γ` be a family of
operations whose restriction to the positive even part is the relevant divided-power structure.
This source-facing owner records precisely the compatibility predicate saying that
`d(γ_n(x)) = d(x)γ_{n-1}(x)` for every positive integer `n` and every `x ∈ A_{even,+}`. -/
@[stacks 09PJ]
class CompatibleDividedPowers
    (grading : ℕ → Submodule R A) (d : Derivation R A A) (γ : ℕ → A → A) : Prop where
  /-- The defining differential compatibility formula on the positive even part `A_{even,+}`,
  written in the ambient source form `x ∈ A_{even,+}` with a positive natural number index. -/
  differential_gamma {n : ℕ} (hn : 0 < n) {x : A} (hx : x ∈ evenPositivePart grading) :
    d (γ n x) = d x * γ (n - 1) x

namespace CompatibleDividedPowers

variable {grading : ℕ → Submodule R A} {d : Derivation R A A} {γ : ℕ → A → A}

/-- The defining compatibility formula evaluated on an element of the source positive even part
`A_{even,+}`. -/
theorem differential_gamma_eq
    (h : CompatibleDividedPowers grading d γ) {n : ℕ} (hn : 0 < n)
    (x : evenPositivePart grading) :
    d (γ n x) = d x * γ (n - 1) x :=
  h.differential_gamma hn x.property

/-- The defining compatibility formula with a positive-integer index presented as `ℕ+`. -/
theorem differential_gamma_pnat
    (h : CompatibleDividedPowers grading d γ) (n : ℕ+) {x : A}
    (hx : x ∈ evenPositivePart grading) :
    d (γ n x) = d x * γ ((n : ℕ) - 1) x :=
  h.differential_gamma n.pos hx

/-- The defining compatibility formula with the positive index written canonically as a successor.
-/
theorem differential_gamma_succ
    (h : CompatibleDividedPowers grading d γ) (n : ℕ) {x : A}
    (hx : x ∈ evenPositivePart grading) :
    d (γ (n + 1) x) = d x * γ n x := by
  simpa using h.differential_gamma (Nat.succ_pos n) hx

/-- The defining compatibility formula applies in particular to an element of any explicit
positive even homogeneous piece `A_{2(m + 1)}`. -/
theorem differential_gamma_eq_of_mem_grading
    (h : CompatibleDividedPowers grading d γ) {n : ℕ} (hn : 0 < n) {m : ℕ+} {x : A}
    (hx : x ∈ grading (2 * (m : ℕ))) :
    d (γ n x) = d x * γ (n - 1) x :=
  h.differential_gamma hn (mem_evenPositivePart_of_mem hx)

/-- The defining compatibility formula applies in particular to an element of the explicit piece
`A_{2(m + 1)}`. -/
theorem differential_gamma_eq_of_mem_grading_nat
    (h : CompatibleDividedPowers grading d γ) {n : ℕ} (hn : 0 < n) {m : ℕ} {x : A}
    (hx : x ∈ grading (2 * (m + 1))) :
    d (γ n x) = d x * γ (n - 1) x :=
  h.differential_gamma hn (mem_evenPositivePart_of_mem_nat hx)

end CompatibleDividedPowers

/-- Companion specification: `CompatibleDividedPowers` is exactly the ambient source statement
with a positive natural-number index and an element `x : A` lying in `A_{even,+}`. -/
theorem compatibleDividedPowers_iff
    (grading : ℕ → Submodule R A) (d : Derivation R A A) (γ : ℕ → A → A) :
    CompatibleDividedPowers grading d γ ↔
      ∀ (n : ℕ) (x : A),
        0 < n → x ∈ evenPositivePart grading → d (γ n x) = d x * γ (n - 1) x :=
  by
    constructor
    · intro h n x hn hx
      simpa using h.differential_gamma hn hx
    · intro h
      exact ⟨fun {n} hn {x} hx ↦ h n x hn hx⟩

/-- Companion bridge: `CompatibleDividedPowers` can also be used with the positive index
presented canonically as an element of `ℕ+`. -/
theorem compatibleDividedPowers_iff_pnat
    (grading : ℕ → Submodule R A) (d : Derivation R A A) (γ : ℕ → A → A) :
    CompatibleDividedPowers grading d γ ↔
      ∀ (n : ℕ+) (x : A),
        x ∈ evenPositivePart grading → d (γ n x) = d x * γ ((n : ℕ) - 1) x :=
  by
    constructor
    · intro h n x hx
      simpa using h.differential_gamma n.pos hx
    · intro h
      exact ⟨fun {n} hn {x} hx ↦ h ⟨n, hn⟩ x hx⟩

/-- Companion bridge: `CompatibleDividedPowers` can be used without positivity bookkeeping by
writing the index as a successor. -/
theorem compatibleDividedPowers_iff_succ
    (grading : ℕ → Submodule R A) (d : Derivation R A A) (γ : ℕ → A → A) :
    CompatibleDividedPowers grading d γ ↔
      ∀ (n : ℕ) (x : A),
        x ∈ evenPositivePart grading → d (γ (n + 1) x) = d x * γ n x := by
  constructor
  · intro h n x hx
    simpa using h.differential_gamma (Nat.succ_pos n) hx
  · intro h
    exact ⟨fun {n} hn {x} hx ↦ by
      rcases Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn) with ⟨m, rfl⟩
      simpa using h m x hx⟩

end

end DifferentialGradedAlgebra
