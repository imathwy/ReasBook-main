/-- A short complex in an additive category is a kernel-cokernel pair when its left map is a
kernel of its right map and its right map is a cokernel of its left map. -/
def IsKernelCokernelPair
    {A : Type u} [Category.{v} A] [Preadditive A] (S : ShortComplex A) :
    Prop :=
  Nonempty (IsLimit (KernelFork.ofι S.f S.zero)) ∧
    Nonempty (IsColimit (CokernelCofork.ofπ S.g S.zero))

/-- A morphism is an admissible monomorphism for a chosen class of short complexes if it occurs as
the left map of one of those complexes. -/
def IsAdmissibleMono
    {A : Type u} [Category.{v} A] [Preadditive A]
    (admissible : Set (ShortComplex A))
    {X Y : A} (i : X ⟶ Y) : Prop :=
  ∃ (Z : A) (p : Y ⟶ Z) (w : i ≫ p = 0), admissible (ShortComplex.mk i p w)

/-- A morphism is an admissible epimorphism for a chosen class of short complexes if it occurs as
the right map of one of those complexes. -/
def IsAdmissibleEpi
    {A : Type u} [Category.{v} A] [Preadditive A]
    (admissible : Set (ShortComplex A))
    {Y Z : A} (p : Y ⟶ Z) : Prop :=
  ∃ (X : A) (i : X ⟶ Y) (w : i ≫ p = 0), admissible (ShortComplex.mk i p w)

/-- Remark 19.9.6: an exact structure on an additive category is a class of admissible
kernel-cokernel pairs that is closed under isomorphism, contains the identity as both an
admissible monomorphism and admissible epimorphism, is closed under composition, and is stable
under pushout of admissible monomorphisms and pullback of admissible epimorphisms. -/
structure ExactStructure (A : Type u) [Category.{v} A] [Preadditive A] where
  /-- The admissible kernel-cokernel pairs. -/
  admissible : Set (ShortComplex A)
  /-- Every admissible short complex is a kernel-cokernel pair. -/
  isKernelCokernelPair {S : ShortComplex A} : admissible S → IsKernelCokernelPair S
  /-- Admissible kernel-cokernel pairs are stable under isomorphism. -/
  ofIso {S T : ShortComplex A} (e : S ≅ T) : admissible S → admissible T
  /-- Identity morphisms are admissible monomorphisms. -/
  id_admissibleMono (X : A) : IsAdmissibleMono admissible (𝟙 X)
  /-- Identity morphisms are admissible epimorphisms. -/
  id_admissibleEpi (X : A) : IsAdmissibleEpi admissible (𝟙 X)
  /-- Admissible monomorphisms are stable under composition. -/
  comp_admissibleMono {X Y Z : A} {i : X ⟶ Y} {j : Y ⟶ Z}
      (_ : IsAdmissibleMono admissible i) (_ : IsAdmissibleMono admissible j) :
      IsAdmissibleMono admissible (i ≫ j)
  /-- Admissible epimorphisms are stable under composition. -/
  comp_admissibleEpi {X Y Z : A} {p : X ⟶ Y} {q : Y ⟶ Z}
      (_ : IsAdmissibleEpi admissible p) (_ : IsAdmissibleEpi admissible q) :
      IsAdmissibleEpi admissible (p ≫ q)
  /-- Pushouts of admissible monomorphisms exist and remain admissible monomorphisms. -/
  pushout_admissibleMono {X Y X' : A} (i : X ⟶ Y) (f : X ⟶ X')
      (_ : IsAdmissibleMono admissible i) :
      ∃ (_ : HasPushout i f), IsAdmissibleMono admissible (pushout.inr i f)
  /-- Pullbacks of admissible epimorphisms exist and remain admissible epimorphisms. -/
  pullback_admissibleEpi {Y Z Z' : A} (p : Y ⟶ Z) (f : Z' ⟶ Z)
      (_ : IsAdmissibleEpi admissible p) :
      ∃ (_ : HasPullback p f), IsAdmissibleEpi admissible (pullback.snd p f)

namespace ExactStructure

variable {A : Type u} [Category.{v} A] [Preadditive A]

/-- The admissible monomorphisms for an exact structure. -/
def AdmissibleMono (E : ExactStructure A) {X Y : A} (i : X ⟶ Y) : Prop :=
  IsAdmissibleMono E.admissible i

/-- The admissible epimorphisms for an exact structure. -/
def AdmissibleEpi (E : ExactStructure A) {Y Z : A} (p : Y ⟶ Z) : Prop :=
  IsAdmissibleEpi E.admissible p

open MorphismProperty

-- Internal bridge: the larger morphism-property site of arbitrary admissible-epimorphism
-- families. The public site owner for this file remains
-- `ExactStructure.singletonAdmissibleEpiCoverage`.
private def admissibleEpiProperty (E : ExactStructure A) : MorphismProperty A :=
  fun _ _ p ↦ E.AdmissibleEpi p

private instance admissibleEpiProperty_containsIdentities (E : ExactStructure A) :
    (admissibleEpiProperty E).ContainsIdentities where
  id_mem := E.id_admissibleEpi

private instance admissibleEpiProperty_isStableUnderComposition (E : ExactStructure A) :
    (admissibleEpiProperty E).IsStableUnderComposition where
  comp_mem _ _ hp hq := E.comp_admissibleEpi hp hq

private instance admissibleEpiProperty_respectsIso (E : ExactStructure A) :
    (admissibleEpiProperty E).RespectsIso := by
  refine RespectsIso.of_respects_arrow_iso _ ?_
  intro f g e hf
  rcases hf with ⟨X, i, w, hS⟩
  have w' : (i ≫ e.hom.left) ≫ g.hom = 0 := by
    calc
      (i ≫ e.hom.left) ≫ g.hom = i ≫ (e.hom.left ≫ g.hom) := by simp [Category.assoc]
      _ = i ≫ (f.hom ≫ e.hom.right) := by rw [e.hom.w]
      _ = (i ≫ f.hom) ≫ e.hom.right := by simp [Category.assoc]
      _ = 0 := by simp [w]
  let T : ShortComplex A := ShortComplex.mk (i ≫ e.hom.left) g.hom w'
  let φ : ShortComplex.mk i f.hom w ≅ T :=
    ShortComplex.isoMk (Iso.refl _) (asIso e.hom.left) (asIso e.hom.right)
      (by simp [T]) e.hom.w
  refine ⟨X, i ≫ e.hom.left, w', ?_⟩
  exact E.ofIso φ hS

private instance admissibleEpiProperty_hasPullbacks (E : ExactStructure A) :
    (admissibleEpiProperty E).HasPullbacks where
  hasPullback {_ _ _} {f} g hf :=
    (E.pullback_admissibleEpi f g hf).choose

private instance admissibleEpiProperty_isStableUnderBaseChange (E : ExactStructure A) :
    (admissibleEpiProperty E).IsStableUnderBaseChange := by
  refine IsStableUnderBaseChange.mk' ?_
  intro X Y S f g _ hg
  obtain ⟨hpb, h⟩ := E.pullback_admissibleEpi g f hg
  let _ : HasPullback g f := hpb
  let _ : HasPullback f g := hasPullback_symmetry g f
  simpa [admissibleEpiProperty, pullbackSymmetry_hom_comp_snd] using
    RespectsIso.precomp (admissibleEpiProperty E) (pullbackSymmetry f g).hom
      (pullback.snd g f) h

/-- Any isomorphism is an admissible epimorphism for an exact structure. -/
theorem admissibleEpi_of_isIso (E : ExactStructure A) {X Y : A} (p : X ⟶ Y) [IsIso p] :
    E.AdmissibleEpi p := by
  rcases E.id_admissibleEpi Y with ⟨W, i, w, hi⟩
  have w' : (i ≫ inv p) ≫ p = 0 := by
    calc
      (i ≫ inv p) ≫ p = i ≫ (inv p ≫ p) := by simp [Category.assoc]
      _ = i ≫ 𝟙 Y := by simp
      _ = 0 := w
  let T : ShortComplex A := ShortComplex.mk (i ≫ inv p) p w'
  let e : ShortComplex.mk i (𝟙 Y) w ≅ T :=
    ShortComplex.isoMk (Iso.refl _) (asIso (inv p)) (Iso.refl _)
      (by simp [T]) (by simp)
  exact ⟨W, i ≫ inv p, w', E.ofIso e hi⟩

section Site

/-- The source-facing coverage on an exact category whose covering presieves are singleton
admissible epimorphisms. -/
def singletonAdmissibleEpiCoverage (E : ExactStructure A) : Coverage A where
  coverings X := {S | ∃ (Y : A) (p : Y ⟶ X), E.AdmissibleEpi p ∧ S = Presieve.singleton p}
  pullback := by
    intro X Y f S hS
    rcases hS with ⟨Z, p, hp, rfl⟩
    obtain ⟨hasPullback, hpb⟩ := E.pullback_admissibleEpi p f hp
    let _ : HasPullback p f := hasPullback
    refine ⟨Presieve.pullbackArrows f (Presieve.singleton p), ?_,
      Presieve.FactorsThruAlong.pullbackArrows f (Presieve.singleton p)⟩
    refine ⟨pullback p f, pullback.snd p f, hpb, ?_⟩
    simpa using (Presieve.pullback_singleton f p)

-- Proof sketch: this is exactly the defining membership condition of
-- `ExactStructure.singletonAdmissibleEpiCoverage`.
/-- A cover in `ExactStructure.singletonAdmissibleEpiCoverage` is exactly a singleton presieve
generated by an admissible epimorphism. -/
theorem mem_singletonAdmissibleEpiCoverage_iff (E : ExactStructure A) {X : A}
    {S : Presieve X} :
    S ∈ singletonAdmissibleEpiCoverage E X ↔
      ∃ (Y : A) (p : Y ⟶ X), E.AdmissibleEpi p ∧ S = Presieve.singleton p :=
  Iff.rfl

/-- The Grothendieck topology generated by singleton admissible epimorphisms in an exact
category. -/
abbrev topology (E : ExactStructure A) : GrothendieckTopology A :=
  (singletonAdmissibleEpiCoverage E).toGrothendieck

private theorem coverage_le_admissibleEpiProperty_precoverage (E : ExactStructure A) :
    (singletonAdmissibleEpiCoverage E).toPrecoverage ≤ (admissibleEpiProperty E).precoverage := by
  intro X S hS Y f hf
  rcases hS with ⟨Z, p, hp, rfl⟩
  cases hf
  exact hp

-- Internal bridge comparison: the singleton admissible-epimorphism topology is contained in the
-- larger topology generated by arbitrary admissible-epimorphism families.
private theorem topology_le_admissibleEpiProperty_topology (E : ExactStructure A) :
    E.topology ≤ (admissibleEpiProperty E).grothendieckTopology := by
  change (singletonAdmissibleEpiCoverage E).toGrothendieck ≤
    (admissibleEpiProperty E).coverage.toGrothendieck
  rw [← Coverage.toGrothendieck_toPrecoverage (singletonAdmissibleEpiCoverage E)]
  rw [← Coverage.toGrothendieck_toPrecoverage ((admissibleEpiProperty E).coverage)]
  exact Precoverage.toGrothendieck_mono (coverage_le_admissibleEpiProperty_precoverage E)

section PretopologyBridge

variable [HasPullbacks A]

/-- Under global pullbacks, the singleton admissible-epimorphism coverage is represented by the
corresponding singleton admissible-epimorphism pretopology. -/
def singletonAdmissibleEpiPretopology (E : ExactStructure A) : Pretopology A where
  coverings := singletonAdmissibleEpiCoverage E
  has_isos := by
    intro X Y f _
    exact ⟨Y, f, E.admissibleEpi_of_isIso f, rfl⟩
  pullbacks := by
    intro X Y f S hS
    rcases hS with ⟨Z, p, hp, rfl⟩
    obtain ⟨hasPullback, hpb⟩ := E.pullback_admissibleEpi p f hp
    let _ : HasPullback p f := hasPullback
    exact ⟨pullback p f, pullback.snd p f, hpb, by
      simpa using (Presieve.pullback_singleton f p)⟩
  transitive := by
    rintro X S Ti ⟨Z, p, hp, rfl⟩ hTi
    rcases hTi p (Presieve.singleton_self p) with ⟨Y, q, hq, hTi⟩
    refine ⟨Y, q ≫ p, E.comp_admissibleEpi hq hp, ?_⟩
    funext W
    ext k
    constructor
    · rintro ⟨V, h, k, ⟨_⟩, hk, rfl⟩
      rw [hTi] at hk
      cases hk
      exact Presieve.singleton.mk
    · rintro ⟨_⟩
      refine Presieve.bind_comp p Presieve.singleton.mk ?_
      rw [hTi]
      exact Presieve.singleton.mk

-- Proof sketch: this is exactly the defining membership condition of
-- `ExactStructure.singletonAdmissibleEpiPretopology`.
/-- A cover in `ExactStructure.singletonAdmissibleEpiPretopology` is exactly a singleton presieve
generated by an admissible epimorphism. -/
theorem mem_singletonAdmissibleEpiPretopology_iff (E : ExactStructure A) {X : A}
    {S : Presieve X} :
    S ∈ singletonAdmissibleEpiPretopology E X ↔
      ∃ (Y : A) (p : Y ⟶ X), E.AdmissibleEpi p ∧ S = Presieve.singleton p :=
  Iff.rfl

/-- Under global pullbacks, the stronger singleton admissible-epimorphism pretopology generates
the same Grothendieck topology as the source-facing singleton admissible-epimorphism coverage. -/
theorem singletonAdmissibleEpiPretopology_toGrothendieck (E : ExactStructure A) :
    (singletonAdmissibleEpiPretopology E).toGrothendieck = E.topology := by
  change (singletonAdmissibleEpiPretopology E).toGrothendieck =
    (singletonAdmissibleEpiCoverage E).toGrothendieck
  rw [← Pretopology.toGrothendieck_toCoverage (singletonAdmissibleEpiPretopology E)]
  rfl

end PretopologyBridge

-- Proof sketch: first prove the sheaf condition on the larger admissible-epimorphism topology
-- attached to the morphism-property owner, then restrict along the comparison
-- `topology_le_admissibleEpiProperty_topology`.
private theorem preadditiveYoneda_isSheaf_for_admissibleEpiProperty_topology
    (E : ExactStructure A) (X : A) :
    Presheaf.IsSheaf ((admissibleEpiProperty E).grothendieckTopology)
      (preadditiveYoneda.obj X) := sorry

-- Proof sketch: for a singleton admissible epimorphism `V ⟶ U`, the sheaf condition for
-- `preadditiveYoneda.obj X` reduces to the kernel-cokernel exactness built into the admissible
-- pair and the usual descent computation for singleton covers.
/-- The additive representable presheaf is a sheaf for the singleton admissible-epimorphism
topology of an exact category. -/
theorem preadditiveYoneda_isSheaf (E : ExactStructure A) (X : A) :
    Presheaf.IsSheaf (topology E) (preadditiveYoneda.obj X) :=
  Presheaf.IsSheaf.of_le (topology_le_admissibleEpiProperty_topology E)
    (preadditiveYoneda_isSheaf_for_admissibleEpiProperty_topology E X)

/-- The sheaf-valued Yoneda functor associated to the admissible-epimorphism topology of an exact
category. -/
def sheafYoneda (E : ExactStructure A) : A ⥤ Sheaf (topology E) AddCommGrpCat.{v} :=
  ObjectProperty.lift _ preadditiveYoneda (fun X ↦ preadditiveYoneda_isSheaf E X)

/-- The sheaf-valued Yoneda functor for an exact category is full. -/
noncomputable instance sheafYoneda_full (E : ExactStructure A) : Functor.Full (sheafYoneda E) :=
  sorry

/-- The sheaf-valued Yoneda functor for an exact category is faithful. -/
instance sheafYoneda_faithful (E : ExactStructure A) : Functor.Faithful (sheafYoneda E) := sorry

-- Proof sketch: map an admissible kernel-cokernel pair to a short complex of sheaves and use the
-- sheaf condition together with the kernel-cokernel universal properties to identify it as short
-- exact in the abelian sheaf category.
/-- The sheaf-valued Yoneda functor sends admissible kernel-cokernel pairs to short exact
sequences of sheaves. -/
theorem sheafYoneda_maps_admissible
    (E : ExactStructure A) {S : ShortComplex A} (hS : E.admissible S) :
    (S.map (sheafYoneda E)).ShortExact := sorry

-- Proof sketch: use full faithfulness of `sheafYoneda` to reconstruct the kernel-cokernel data in
-- `A` from a short exact image sequence of sheaves, then invoke the defining exact-structure
-- axioms to show the original pair is admissible.
/-- The sheaf-valued Yoneda functor reflects admissible exact sequences. -/
theorem sheafYoneda_reflects_admissible
    (E : ExactStructure A) {S : ShortComplex A} (hS : (S.map (sheafYoneda E)).ShortExact) :
    E.admissible S := sorry

-- Proof sketch: realize a short exact extension in the sheaf category as the image of an
-- admissible kernel-cokernel pair by reflecting exactness and then use full faithfulness to
-- identify the middle term with the Yoneda image of an object of `A`.
/-- Any short exact extension of two sheaves in the essential image of `sheafYoneda` again lies in
the essential image. -/
theorem sheafYoneda_essImage_closedUnderExtensions
    (E : ExactStructure A) {S : ShortComplex (Sheaf (topology E) AddCommGrpCat.{v})}
    (hS : S.ShortExact)
    (h₁ : (sheafYoneda E).essImage S.X₁) (h₃ : (sheafYoneda E).essImage S.X₃) :
    (sheafYoneda E).essImage S.X₂ := sorry

end Site

end ExactStructure

end CategoryTheory
