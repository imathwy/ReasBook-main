/-- Lemma 19.9.2: for every object `X`, the representable additive presheaf `U ↦ Hom(U, X)` is a
sheaf for the singleton-epimorphism topology on `A`. -/
theorem singletonEpiPretopology_preadditiveYoneda_isSheaf (X : A) :
    Presheaf.IsSheaf J (preadditiveYoneda.obj X) := by
  -- This is the exact-structure sheaf statement from Remark 19.9.6 specialized to the abelian
  -- exact structure from Lemma 19.9.1.
  simpa using ExactStructure.preadditiveYoneda_isSheaf (abelianExactStructure A) X

/-- Helper for Lemma 19.9.2: in the abelian exact structure, the sheaf-valued Yoneda functor sends
short exact sequences to short exact sequences of sheaves. -/
private theorem abelianExactStructure_sheafYoneda_maps_shortExact {S : ShortComplex A}
    (hS : S.ShortExact) :
    (S.map F).ShortExact := by
  -- The source short exact sequence is admissible for the canonical abelian exact structure, so
  -- Remark 19.9.6 applies directly.
  simpa [abelianExactStructure] using
    (ExactStructure.sheafYoneda_maps_admissible (E := abelianExactStructure A) hS)

