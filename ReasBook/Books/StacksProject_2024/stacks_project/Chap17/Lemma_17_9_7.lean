-- Proof sketch: apply the epimorphism statement above, then use that a colimit coprojection from a
-- mono directed system is also monic, so the chosen map is both epi and mono and hence an
-- isomorphism.
/-- Lemma 17.9.7 (2): if moreover every transition morphism in the directed system is mono, then
the finite type colimit stabilizes at some stage, i.e. one canonical map `\mathcal F_i \to \colim
\mathcal F_i` is an isomorphism. -/
theorem exists_isIso_colimit_iota_of_isFiniteType_of_mono
    (hmono : ∀ ⦃i i' : I⦄ (f : i ⟶ i'), Mono (ℱ.map f)) :
    ∃ i : I, IsIso (colimit.ι ℱ i) := by
  -- First choose a stage whose coprojection is epi by finite generation of the colimit.
  obtain ⟨i, hi⟩ := exists_epi_colimit_iota_of_isFiniteType (ℱ := ℱ)
  letI : Epi (colimit.ι ℱ i) := hi
  -- Proof comment: mono transition maps force every stage coprojection into the colimit to be
  -- mono after checking injectivity on each open-set section module of the underlying presheaf.
  letI : Mono (colimit.ι ℱ i) := colimitIotaMonoOfTransitionMono (ℱ := ℱ) hmono i
  -- In the abelian category of sheaves of modules, a map that is both mono and epi is an iso.
  exact ⟨i, isIso_of_mono_of_epi (colimit.ι ℱ i)⟩

