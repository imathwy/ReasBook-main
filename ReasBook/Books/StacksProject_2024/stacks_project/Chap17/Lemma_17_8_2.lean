import Mathlib
import StacksProject_2024.stacks_project.Chap17.Definition_17_8_1

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

universe u

/- 
Domain-style sampling for Lemma 17.8.2:
- primary domain: local generation of `\mathcal O_X`-module sheaves under pullback on ringed
  spaces;
- inspected owner declarations:
  `(RingedSpace.Modules AlgebraicGeometry.RingedSpace)`,
  `SheafOfModules.LocalGeneratorsData`,
  `AlgebraicGeometry.RingedSpace.Hom.pullback`;
- best owner abstraction:
  the ambient owner category `(RingedSpace.Modules X)`, together with the primitive owner data
  `SheafOfModules.LocalGeneratorsData` and the canonical pullback functor `(f^*)`;
- primitive data:
  a morphism of ringed spaces `f : X ⟶ Y`, a module sheaf `𝒢 : (RingedSpace.Modules Y)`, and chosen local
  generator data on `𝒢`;
- derived API:
  the source-facing pullback-stability statement together with the corresponding instance-style
  propagation of `LocalGeneratorsData`.

Source/core/bridge triage:
- `source-facing`: pullback preserves the property of being locally generated by sections;
- `core/canonical`: `(RingedSpace.Modules X)`, `SheafOfModules.LocalGeneratorsData`, and `(f^*)`;
- `bridge/view`: the instance and companion theorem
  `Nonempty (((f^*).obj 𝒢).LocalGeneratorsData)`, obtained from chosen local generator data on
  `𝒢`.
-/

open AlgebraicGeometry
open CategoryTheory TopologicalSpace
open CategoryTheory Limits
open scoped AlgebraicGeometry

namespace AlgebraicGeometry

variable {X Y : RingedSpace.{u}}

local notation "ModX" => RingedSpace.Modules X
local notation "ModY" => RingedSpace.Modules Y

/-- Helper for Lemma 17.8.2: the open subset `f^{-1}(V)` of `X` attached to an open
`V ⊆ Y`. -/
private abbrev preimageOpen (f : X ⟶ Y) (V : Opens Y) : Opens X :=
  (Opens.map f.hom.base).obj V

/-- Helper for Lemma 17.8.2: the opens functor induced by restricting to `U` is final, which is
the instance required by `SheafOfModules.pullbackObjFreeIso` on the restricted ringed space. -/
private instance opensMapOfRestrictFinal (U : Opens X) :
    Functor.Final (Opens.map (X.ofRestrict U.isOpenEmbedding).hom.base) := by
  -- Proof comment: the inclusion of an open subset is an open map, and finality follows from the
  -- standard adjunction between direct and inverse image on opens.
  let hU : IsOpenMap U.inclusion' := U.isOpenEmbedding.isOpenMap
  simpa using
    (CategoryTheory.Functor.final_of_adjunction hU.adjunction :
      Functor.Final (Opens.map U.inclusion'))

/-- Helper for Lemma 17.8.2: the composite from the restricted source
`X|_{f^{-1}(V)}` to `Y` lands in the restricted target `Y|_V`. -/
private theorem preimageOpen_range_subset
    (f : X ⟶ Y) (V : Opens Y) :
    Set.range
        ((((X.ofRestrict (preimageOpen f V).isOpenEmbedding).hom ≫ f.hom)).base) ⊆
      Set.range ((Y.ofRestrict V.isOpenEmbedding).hom.base) := by
  rintro y ⟨x, rfl⟩
  -- Proof comment: a point of `f^{-1}(V)` maps into `V` by the definition of the preimage open.
  exact ⟨⟨f.hom.base x.1, x.2⟩, rfl⟩

/-- Helper for Lemma 17.8.2: the morphism of restricted ringed spaces from
`X|_{f^{-1}(V)}` to `Y|_V` induced by `f`. -/
private noncomputable def pullbackToPreimageOpenMorphism
    (f : X ⟶ Y) (V : Opens Y) :
    X.restrict (preimageOpen f V).isOpenEmbedding ⟶
      Y.restrict V.isOpenEmbedding :=
  ⟨PresheafedSpace.IsOpenImmersion.lift
    (Y.ofRestrict V.isOpenEmbedding).hom
    ((X.ofRestrict (preimageOpen f V).isOpenEmbedding).hom ≫ f.hom)
    (preimageOpen_range_subset f V)⟩

/-- Helper for Lemma 17.8.2: the induced restricted morphism factors the composite
`X|_{f^{-1}(V)} ⟶ X ⟶ Y`. -/
private theorem pullbackToPreimageOpen_fac
    (f : X ⟶ Y) (V : Opens Y) :
    pullbackToPreimageOpenMorphism f V ≫ (Y.ofRestrict V.isOpenEmbedding).hom =
      (X.ofRestrict (preimageOpen f V).isOpenEmbedding).hom ≫ f := by
  -- Proof comment: the restricted morphism was defined using the universal-property lift through
  -- the open immersion `Y|_V ⟶ Y`, so the required factorization is exactly `lift_fac`.
  apply LocallyRingedSpace.Hom.ext'
  simpa [pullbackToPreimageOpenMorphism] using
    PresheafedSpace.IsOpenImmersion.lift_fac
      (Y.ofRestrict V.isOpenEmbedding).hom
      ((X.ofRestrict (preimageOpen f V).isOpenEmbedding).hom ≫ f.hom)
      (preimageOpen_range_subset f V)

/-- Helper for Lemma 17.8.2: pullback carries the free sheaf on `I` to the free sheaf on the
same index type by preserving the coproduct cocone and transporting the pulled-back unit sheaf
along `pullbackObjUnitToUnit`. -/
private noncomputable def ringedSpacePullbackFreeIso
    (f : X ⟶ Y) (I : Type u) :
    ((RingedSpace.Hom.pullback f).obj
      (SheafOfModules.free.{u} I : ModY)) ≅
      (SheafOfModules.free.{u} I : ModX) :=
  SheafOfModules.mapFree
    (RingedSpace.Hom.pullback f)
    (asIso (SheafOfModules.pullbackObjUnitToUnit (RingedSpace.Hom.toRingCatSheafHom f)))
    I

/-- Helper for Lemma 17.8.2: a generating family on `𝒢` pulls back to a generating family on
`f^*𝒢` for a morphism of ringed spaces. -/
private theorem ringedSpacePullback_nonempty_generatingSections
    (f : X ⟶ Y) (𝒢 : ModY) (h𝒢 : Nonempty 𝒢.GeneratingSections) :
    Nonempty (((RingedSpace.Hom.pullback f).obj 𝒢).GeneratingSections) := by
  classical
  rcases h𝒢 with ⟨σ⟩
  let π : (SheafOfModules.free.{u} σ.I : ModX) ⟶ (RingedSpace.Hom.pullback f).obj 𝒢 :=
    (ringedSpacePullbackFreeIso f σ.I).inv ≫
      (RingedSpace.Hom.pullback f).map σ.π
  have hπ : Epi π := by
    -- Proof comment: pullback preserves the epimorphism defined by the chosen generators, and the
    -- free-source comparison isomorphism contributes another epi.
    let _ : Epi ((RingedSpace.Hom.pullback f).map σ.π) := by
      infer_instance
    let _ : Epi (ringedSpacePullbackFreeIso f σ.I).inv := by
      infer_instance
    dsimp [π]
    infer_instance
  -- Proof comment: the pulled-back epimorphism out of the normalized free source is exactly the
  -- data of a generating family on the pullback module.
  refine ⟨{ I := σ.I, s := ((RingedSpace.Hom.pullback f).obj 𝒢).freeHomEquiv π, epi := ?_ }⟩
  simpa [π] using hπ

/-- Helper for Lemma 17.8.2: pulling back the restriction `𝒢.over V` along the induced morphism
from `X|_{f^{-1}(V)}` agrees with restricting the ambient pullback `f^*𝒢` to `f^{-1}(V)`. -/
private noncomputable def pullbackOverPreimageComparison
    (f : X ⟶ Y) (𝒢 : ModY) (V : Opens Y) :
    (RingedSpace.Hom.pullback (pullbackToPreimageOpenMorphism f V)).obj (𝒢.over V) ≅
      ((RingedSpace.Hom.pullback f).obj 𝒢).over (preimageOpen f V) := by
  let U := preimageOpen f V
  let iU : X.restrict U.isOpenEmbedding ⟶ X := (X.ofRestrict U.isOpenEmbedding).hom
  let iV : Y.restrict V.isOpenEmbedding ⟶ Y := (Y.ofRestrict V.isOpenEmbedding).hom
  let g : X.restrict U.isOpenEmbedding ⟶ Y.restrict V.isOpenEmbedding :=
    pullbackToPreimageOpenMorphism f V
  have leftIso :
      (RingedSpace.Hom.pullback g).obj (𝒢.over V) ≅
        (RingedSpace.Hom.pullback (g ≫ iV)).obj 𝒢 := by
    -- Proof comment: rewrite the iterated pullback `g^*(iV^*𝒢)` as pullback along the composite
    -- `g ≫ iV`.
    simpa [g, iV, SheafOfModules.over, RingedSpace.Hom.pullback] using
      (SheafOfModules.pullbackComp
        (RingedSpace.Hom.toRingCatSheafHom g)
        (RingedSpace.Hom.toRingCatSheafHom iV)).app 𝒢
  have rightIso :
      (((RingedSpace.Hom.pullback f).obj 𝒢).over U) ≅
        (RingedSpace.Hom.pullback (iU ≫ f)).obj 𝒢 := by
    -- Proof comment: restricting `f^*𝒢` to `U` is the pullback of `𝒢` along `iU ≫ f`.
    simpa [U, iU, SheafOfModules.over, RingedSpace.Hom.pullback] using
      (SheafOfModules.pullbackComp
        (RingedSpace.Hom.toRingCatSheafHom iU)
        (RingedSpace.Hom.toRingCatSheafHom f)).app 𝒢
  have hfac :
      g ≫ iV = iU ≫ f := by
    simpa [U, iU, iV, g] using pullbackToPreimageOpen_fac (f := f) (V := V)
  have hfacRingCat :
      RingedSpace.Hom.toRingCatSheafHom (g ≫ iV) =
        RingedSpace.Hom.toRingCatSheafHom (iU ≫ f) :=
    congrArg RingedSpace.Hom.toRingCatSheafHom hfac
  have compIso :
      (RingedSpace.Hom.pullback (g ≫ iV)).obj 𝒢 ≅
        (RingedSpace.Hom.pullback (iU ≫ f)).obj 𝒢 := by
    exact (SheafOfModules.pullbackCongr hfacRingCat).app 𝒢
  -- Proof comment: after normalizing both sides to pullback along the same composite morphism,
  -- only the factorization equality `g ≫ iV = iU ≫ f` remains.
  exact leftIso ≪≫ compIso ≪≫ rightIso.symm

/-- Helper for Lemma 17.8.2: global generators on `𝒢.over V` pull back to global generators on
the preimage restriction `((f^*).obj 𝒢).over (f^{-1}(V))`. -/
private theorem pullbackGeneratingSectionsOnPreimage
    (f : X ⟶ Y) (𝒢 : ModY) {V : Opens Y}
    (hV : Nonempty ((𝒢.over V).GeneratingSections)) :
    Nonempty ((((RingedSpace.Hom.pullback f).obj 𝒢).over (preimageOpen f V)).GeneratingSections) := by
  let U := preimageOpen f V
  let g : X.restrict U.isOpenEmbedding ⟶ Y.restrict V.isOpenEmbedding :=
    pullbackToPreimageOpenMorphism f V
  have hpull :
      Nonempty (((RingedSpace.Hom.pullback g).obj (𝒢.over V)).GeneratingSections) :=
    ringedSpacePullback_nonempty_generatingSections g (𝒢.over V) hV
  rcases hpull with ⟨σ⟩
  -- Proof comment: pull back the generating family along the restricted morphism and then
  -- transport it across the standard comparison isomorphism with the restricted ambient pullback.
  exact ⟨(SheafOfModules.GeneratingSections.equivOfIso
    (pullbackOverPreimageComparison (f := f) (𝒢 := 𝒢) V)) σ⟩

-- Proof sketch: use the pointwise characterization of `LocalGeneratorsData`, choose a
-- neighborhood of `f x` where `𝒢` is globally generated, pull those generators back to the
-- preimage open, and transport them across the restriction/pullback comparison.
private theorem ringedSpaceModulePullback_exists_localGeneratorsData
    (f : X ⟶ Y) (𝒢 : Y.Modules) (h𝒢 : 𝒢.LocalGeneratorsData) :
    Nonempty (((RingedSpace.Hom.pullback f).obj 𝒢).LocalGeneratorsData) := by
  -- Route correction: work pointwise on neighborhoods of `f x`, pull back a generating family on
  -- that neighborhood, and then transport it to the restriction of the ambient pullback.
  refine (SheafOfModules.nonempty_localGeneratorsData_iff_pointwise
    ((RingedSpace.Hom.pullback f).obj 𝒢)).2 ?_
  intro x
  rcases (SheafOfModules.nonempty_localGeneratorsData_iff_pointwise 𝒢).1 ⟨h𝒢⟩ (f.hom.base x) with
    ⟨V, hxV, hV⟩
  have hxpre : x ∈ preimageOpen f V := by
    -- Proof comment: the preimage open around `x` is exactly the pullback of the chosen
    -- neighborhood of `f x`.
    simpa [preimageOpen] using hxV
  refine ⟨preimageOpen f V, hxpre, ?_⟩
  -- Proof comment: a generating family on `𝒢.over V` stays generating after pullback to the
  -- restricted morphism `X|_{f^{-1}(V)} ⟶ Y|_V`.
  exact pullbackGeneratingSectionsOnPreimage (f := f) (𝒢 := 𝒢) hV

/-- Lemma 17.8.2: for a morphism of ringed spaces
`f : (X, \mathcal O_X) \to (Y, \mathcal O_Y)`, if an `\mathcal O_Y`-module sheaf `\mathcal G`
is locally generated by sections, then its pullback `f^*\mathcal G` is locally generated by
sections. -/
theorem ringedSpaceModulePullback_nonempty_localGeneratorsData
    (f : X ⟶ Y) (𝒢 : Y.Modules)
    (h𝒢 : Nonempty 𝒢.LocalGeneratorsData) :
    Nonempty (((RingedSpace.Hom.pullback f).obj 𝒢).LocalGeneratorsData) := by
  rcases h𝒢 with ⟨σ⟩
  exact ringedSpaceModulePullback_exists_localGeneratorsData f 𝒢 σ

instance (f : X ⟶ Y) (𝒢 : Y.Modules) [h𝒢 : Nonempty 𝒢.LocalGeneratorsData] :
    Nonempty (((RingedSpace.Hom.pullback f).obj 𝒢).LocalGeneratorsData) :=
  ringedSpaceModulePullback_nonempty_localGeneratorsData f 𝒢 h𝒢

end AlgebraicGeometry
