import Mathlib
import StacksProject_2024.Chap06.Definition_6_26_1
import Mathlib.Tactic.Recall

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open AlgebraicGeometry

noncomputable section

universe u

/-
Domain-style sampling for global generation of sheaves of modules on a ringed space:
- inspected owner declarations:
  `RingedSpace.ringCatSheaf`,
  `RingedSpace.Modules`,
  `SheafOfModules.GeneratingSections`,
  `SheafOfModules.GeneratingSections.π`,
  `SheafOfModules.LocalGeneratorsData`
- owner abstractions:
  `RingedSpace.ringCatSheaf` for the coefficient sheaf and `RingedSpace.Modules` for the
  ambient module category,
  `SheafOfModules.GeneratingSections` for a generating family of global sections
- primitive data: an index type `I`, a family of global sections `s : I → ℱ.sections`, and the
  induced epimorphism `ℱ.freeHomEquiv.symm s`
- derived API: the associated morphism `GeneratingSections.π`, transport across epimorphisms via
  `GeneratingSections.ofEpi`, and the source-facing existential reformulation below

Layer triage:
- `source-facing`: the textbook phrase “generated by global sections”
- `core/canonical`: `ℱ.GeneratingSections`
- `bridge/view`: the explicit `∃ I, ∃ s, Epi (ℱ.freeHomEquiv.symm s)` reformulation below

The current file only needs the canonical owner and a thin source-facing bridge theorem. A separate
public predicate alias `IsGeneratedByGlobalSections` would duplicate the owner-level notion
`Nonempty ℱ.GeneratingSections` without adding mathematical content.
-/

namespace SheafOfModules

variable {X : RingedSpace.{u}}

/- Definition 17.4.1: the canonical owner for a generating family of global sections of an
`\mathcal O_X`-module is `ℱ.GeneratingSections`; existence of such a family is the source
condition that `ℱ` is generated by global sections. -/
recall SheafOfModules.GeneratingSections

/- Companion recall: `GeneratingSections.π` is the canonical morphism from the free sheaf on the
chosen generators. -/
recall SheafOfModules.GeneratingSections.π

/-- Definition 17.4.1: an `\mathcal O_X`-module is generated by global sections if and only if
there exists an index type and a family of global sections whose associated morphism from the free
module sheaf is an epimorphism. This is the source-facing bridge from the textbook wording to the
canonical owner `ℱ.GeneratingSections`. -/
theorem nonempty_generatingSections_iff_exists_generating_family
    (ℱ : (RingedSpace.Modules X)) :
    Nonempty ℱ.GeneratingSections ↔
      ∃ (I : Type u) (s : I → ℱ.sections), Epi ((ℱ.freeHomEquiv).symm s) := by
  constructor
  · rintro ⟨σ⟩
    exact ⟨σ.I, σ.s, σ.epi⟩
  · rintro ⟨I, s, hs⟩
    exact ⟨{ I := I, s := s, epi := hs }⟩

end SheafOfModules
