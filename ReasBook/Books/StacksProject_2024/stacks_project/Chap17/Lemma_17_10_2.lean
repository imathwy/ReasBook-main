/-- Helper for Lemma 17.10.2: a presentation on `M.over U` restricts further to any object
`V : Over U` once the iterated slice site is identified with the ordinary slice over `V.left`. -/
noncomputable def presentation_restrict
    {M : SheafOfModules.{w} R} {U : C} (P : (M.over U).Presentation) (V : Over U)
    [HasBinaryProducts (Over U)]
    [((J.over U).over V).HasSheafCompose (forget₂ RingCat.{w} AddCommGrpCat.{w})]
    [HasSheafify ((J.over U).over V) AddCommGrpCat.{w}]
    [((J.over U).over V).WEqualsLocallyBijective AddCommGrpCat.{w}] :
    (M.over V.left).Presentation := by
  letI : PreservesColimitsOfSize.{w, w}
      (pushforward (R := R.over U) (𝟙 ((R.over U).over V))) :=
    (overPushforwardOverAdj (R := R.over U) V).leftAdjoint_preservesColimits
  -- First restrict the given presentation once more to the iterated slice over `V`.
  let P' : ((M.over U).over V).Presentation :=
    P.map (pushforward (𝟙 ((R.over U).over V))) (by rfl)
  -- Then transport that iterated-slice presentation across the canonical slice equivalence.
  let e := pushforwardPushforwardEquivalence (Over.iteratedSliceEquiv V)
    (S := (R.over U).over V) (R := R.over V.left) (𝟙 _) (𝟙 _)
    (by ext : 2; exact R.1.map_id _) (by ext : 2; exact R.1.map_id _)
  -- The counit identifies the transported object with the ordinary restriction `M.over V.left`.
  exact
    ((P'.map e.inverse (.refl _)).of_isIso
      (e.fullyFaithfulFunctor.preimageIso
        (by exact e.counitIso.app ((M.over U).over V))).hom)

