-- Proof sketch: refine the local quasi-coherent presentations of the two summands to a common
-- cover, take the biproduct of the resulting local cokernel presentations, and then package that
-- local construction once as the owner-level binary-product closure instance.
instance isQuasicoherent_isClosedUnderBinaryProducts :
    (SheafOfModules.isQuasicoherent R).IsClosedUnderBinaryProducts := by
  -- Reduce an arbitrary binary-product cone to the canonical biproduct cone.
  refine IsClosedUnderLimitsOfShape.mk' ?_
  rintro _ ⟨F, hF⟩
  let X := F.obj ⟨WalkingPair.left⟩
  let Y := F.obj ⟨WalkingPair.right⟩
  letI : X.IsQuasicoherent := hF _
  letI : Y.IsQuasicoherent := hF _
  -- Apply the source-facing biproduct lemma to the canonical binary biproduct.
  have hXY : (X ⊞ Y).IsQuasicoherent := biprod_isQuasicoherent (M := X) (N := Y)
  -- Transport the property across the comparison between the given binary-product cone and
  -- the canonical biproduct limit cone.
  let hPair :
      IsLimit ((Cone.postcompose (diagramIsoPair F).hom).obj (limit.cone F)) :=
    (IsLimit.postcomposeHomEquiv (diagramIsoPair F) _).2 (limit.isLimit F)
  letI : (BinaryBiproduct.bicone X Y).toCone.pt.IsQuasicoherent := by
    simpa using hXY
  exact isQuasicoherent_of_iso
    ((IsLimit.conePointUniqueUpToIso hPair (BinaryBiproduct.isLimit X Y)).symm)

/- Lemma 17.10.2: the direct sum of two quasi-coherent `\mathcal O_X`-modules is
quasi-coherent. -/
omit [HasBinaryProducts C] [J.HasSheafCompose (forget₂ RingCat.{w} AddCommGrpCat.{w})] in
lemma isQuasicoherent_biprod
    {M N : SheafOfModules.{w} R} [M.IsQuasicoherent] [N.IsQuasicoherent] :
    (M ⊞ N).IsQuasicoherent := by
  simpa using biprod_isQuasicoherent (M := M) (N := N)

omit [HasBinaryProducts C] [J.HasSheafCompose (forget₂ RingCat.{w} AddCommGrpCat.{w})] in
instance instIsQuasicoherentBiprod
    {M N : SheafOfModules.{w} R} [M.IsQuasicoherent] [N.IsQuasicoherent] :
    (M ⊞ N).IsQuasicoherent :=
  isQuasicoherent_biprod

end SheafOfModules
