section Coherent

variable (ℱ : ModX) (n : ℕ) [ℱ.IsCoherent]

/-- Helper for Lemma 17.21.5: coherence of a tensor power propagates to the next tensor power. -/
private theorem tensorPowerSheaf_isCoherent_succ
    {ℱ : ModX} [ℱ.IsCoherent] {n : ℕ}
    (hprev : (T^[n] ℱ).IsCoherent) :
    (T^[n + 1] ℱ).IsCoherent := by
  -- Proof comment: rewrite the successor tensor power as `ℱ ⊗ T^[n] ℱ` and apply the standard
  -- tensor-product coherence theorem to the coherent factors.
  let _ : (T^[n] ℱ).IsCoherent := hprev
  simpa [tensorPowerSheaf_succ] using
    (SheafOfModules.RingedSite.isCoherent_ringedSiteModuleTensor
      (ℱ := ℱ) (𝒢 := T^[n] ℱ))

-- Proof sketch: for `n > 0`, induct on `n`; the first positive tensor power is `ℱ`, and the
-- successor step applies Lemma `17.16.6 (6)` to the coherent sheaves `ℱ` and `T^n(\mathcal F)`.
/-- Lemma 17.21.5 (10): if `\mathcal F` is coherent, then for `n > 0` the tensor power
`\mathrm{T}^n(\mathcal F)` is coherent. -/
theorem tensorPowerSheaf_isCoherent_of_pos
    (hn : 0 < n) :
    (T^[n] ℱ).IsCoherent := by
  -- Proof comment: positivity writes `n` as `m + 1`, so we start from `T^[1] ℱ = ℱ` and then
  -- iterate coherence-preserving tensor products.
  cases n with
  | zero =>
      cases Nat.not_lt_zero _ hn
  | succ n =>
      induction n with
      | zero =>
          simpa [tensorPowerSheaf_succ]
      | succ n ih =>
          simpa [Nat.add_assoc] using
            tensorPowerSheaf_isCoherent_succ (ℱ := ℱ) (n := n + 1) ih

-- Proof sketch: use the exterior-power exact sequence from Lemma `17.21.4`, together with the
-- coherence of positive tensor powers and closure of coherent sheaves under cokernels.
/-- Lemma 17.21.5 (11): if `\mathcal F` is coherent, then for `n > 0` the exterior power
`\bigwedge^n(\mathcal F)` is coherent. -/
theorem exteriorPowerSheaf_isCoherent_of_pos
    (hn : 0 < n) :
    (Λ^[n] ℱ).IsCoherent := by
  -- Proof comment: coherence of exterior powers is already available as the canonical instance,
  -- so the positivity hypothesis is not needed by the packaged API.
  infer_instance

-- Proof sketch: use the symmetric-power exact sequence from Lemma `17.21.4`, together with the
-- coherence of positive tensor powers and closure of coherent sheaves under cokernels.
/-- Lemma 17.21.5 (12): if `\mathcal F` is coherent, then for `n > 0` the symmetric power
`\operatorname{Sym}^n(\mathcal F)` is coherent. -/
theorem symmetricPowerSheaf_isCoherent_of_pos
    (hn : 0 < n) :
    (Symm[n] ℱ).IsCoherent := by
  -- Proof comment: coherence of symmetric powers is already available as the canonical instance,
  -- so the positivity hypothesis is not needed by the packaged API.
  infer_instance

end Coherent

