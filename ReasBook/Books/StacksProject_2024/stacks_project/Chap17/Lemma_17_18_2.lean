/-- Helper for Lemma 17.18.2: the sieve on `U` obtained from a slice-site family
`Ui : ι → Over U` is exactly the ordinary sieve generated by the underlying arrows
`(Ui i).hom`. -/
private theorem over_sieve_of_objects_eq_of_arrows
    {U : Opens X} {ι : Type*} (Ui : ι → Over U) :
    (Sieve.overEquiv (Over.mk (𝟙 U)))
        (Sieve.ofObjects Ui (Over.mk (𝟙 U))) =
      Sieve.ofArrows (fun i ↦ (Ui i).left) (fun i ↦ (Ui i).hom) := by
  ext W g
  constructor
  · intro hg
    -- A factorization in the slice gives the same factorization in the base site.
    rw [Sieve.overEquiv_iff] at hg
    rw [Sieve.mem_ofObjects_iff] at hg
    rcases hg with ⟨i, ⟨a⟩⟩
    rw [Sieve.mem_ofArrows_iff]
    exact ⟨i, a.left, by simpa using a.w⟩
  · intro hg
    -- Conversely, any base-site factorization is a morphism in the slice over `U`.
    rw [Sieve.overEquiv_iff]
    rw [Sieve.mem_ofArrows_iff] at hg
    rcases hg with ⟨i, a, ha⟩
    rw [Sieve.mem_ofObjects_iff]
    exact ⟨i, ⟨Over.homMk a (by simpa using ha)⟩⟩

/-- Helper for Lemma 17.18.2: a slice-site cover of `⊤` contains a member whose underlying open
contains any chosen point of `X`. -/
private theorem point_mem_of_coversTop_over_top
    {ι : Type*} (Ui : ι → Over (⊤ : Opens X))
    (hUi : ((Opens.grothendieckTopology X).over (⊤ : Opens X)).CoversTop Ui)
    (x : X) :
    ∃ i, x ∈ (Ui i).left := by
  -- Proof comment: rewrite the slice-site cover of `⊤` as the ordinary sieve generated by the
  -- underlying open inclusions, then apply the cover-membership condition at the point `x`.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal
    (J := (Opens.grothendieckTopology X).over (⊤ : Opens X))
    (Over.mk (𝟙 (⊤ : Opens X))) Over.mkIdTerminal] at hUi
  rw [GrothendieckTopology.mem_over_iff, over_sieve_of_objects_eq_of_arrows] at hUi
  rcases hUi x (by trivial) with ⟨W, f, hf, hxW⟩
  rw [Sieve.mem_ofArrows_iff] at hf
  rcases hf with ⟨i, a, ha⟩
  exact ⟨i, a.le hxW⟩

/-- Helper for Lemma 17.18.2: restricting a finite-free trivialization along an inclusion of opens
produces a finite-free trivialization on the smaller open. -/
private theorem restrict_iso_free
    (ℱ : ModX) {V W : Opens X} (hWV : W ≤ V)
    {α : Type u}
    (e : ℱ.over V ≅
      (SheafOfModules.free.{u} α : SheafOfModules (X.ringCatSheaf.over V))) :
    Nonempty
      (ℱ.over W ≅
        (SheafOfModules.free.{u} α : SheafOfModules (X.ringCatSheaf.over W))) := by
  sorry

/-- Helper for Lemma 17.18.2: a pointwise open cover of `U` yields a cover of the terminal object
in the slice site `(Opens X)/U`. -/
private theorem over_open_cover_coversTop
    {U : Opens X} {ι : Type*} (V : ι → Opens X) (π : ∀ i, V i ⟶ U)
    (hV : ∀ x ∈ U, ∃ i, x ∈ V i) :
    ((Opens.grothendieckTopology X).over U).CoversTop (fun i ↦ Over.mk (π i)) := by
  -- Proof comment: convert the slice-site cover condition to the ordinary sieve generated by the
  -- open inclusions `π i`, then use the pointwise covering hypothesis.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal
    (J := (Opens.grothendieckTopology X).over U)
    (Over.mk (𝟙 U)) Over.mkIdTerminal]
  rw [GrothendieckTopology.mem_over_iff]
  rw [over_sieve_of_objects_eq_of_arrows]
  intro x hxU
  rcases hV x hxU with ⟨i, hxi⟩
  exact ⟨V i, π i, Sieve.ofArrows_mk V π i, hxi⟩

/-- Bridge: unpacking the canonical opens-site owner yields the point-neighborhood retract form
used in the Stacks Project statement. -/
theorem RingedSite.IsLocallyDirectSummandOfFiniteFree.exists_open_neighborhood_retract_free
    (ℱ : ModX) [IsLocallyDirectSummandOfFiniteFreeX ℱ] (x : X) :
    ∃ (U : Opens X) (_ : x ∈ U) (I : Type u), Finite I ∧
      Nonempty (Retract (ℱ.over U) (SheafOfModules.free.{u} I)) := by
  sorry

-- Proof sketch: each local isomorphism with a finite free module exhibits the sheaf as a retract
-- of that finite free module via the inverse isomorphism.
/-- A finite locally free sheaf is locally a direct summand of a finite free sheaf. -/
instance isFiniteLocallyFree_to_isLocallyDirectSummandOfFiniteFree
    (ℱ : ModX) [ℱ.IsFiniteLocallyFree] :
    IsLocallyDirectSummandOfFiniteFreeX ℱ := by
  sorry

