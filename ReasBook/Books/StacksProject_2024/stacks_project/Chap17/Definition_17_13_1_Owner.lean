import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
import StacksProject_2024.Chap06.RingedSpaceModuleCore

open CategoryTheory CategoryTheory.Limits TopologicalSpace Topology
open TopCat.Presheaf
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace

/-- The ideal sheaf attached to a morphism of ringed spaces, viewed as the kernel of the canonical
`\mathcal O_X`-linear map `\mathcal O_X \to i_*\mathcal O_Z`. -/
noncomputable abbrev closedImmersionIdealSheaf
    {X Z : RingedSpace.{u}} (i : Z ⟶ X) : RingedSpace.Modules X :=
  kernel (SheafOfModules.unitToPushforwardObjUnit (RingedSpace.Hom.toRingCatSheafHom i))

/-- Definition 17.13.1: a morphism `i : (Z, \mathcal O_Z) \to (X, \mathcal O_X)` of ringed
spaces is a closed immersion if the underlying map of topological spaces is a closed embedding, the
associated map `\mathcal O_X \to i_*\mathcal O_Z` is locally surjective as a sheaf morphism, and
its kernel ideal sheaf is locally generated by sections. -/
class IsClosedImmersion
    {X Z : RingedSpace.{u}} (i : Z ⟶ X) : Prop
    extends Sheaf.IsLocallySurjective (RingedSpace.Hom.commRingSheafPushforwardMap i) where
  /-- The underlying continuous map of a closed immersion of ringed spaces is a closed embedding. -/
  isClosedEmbedding : Topology.IsClosedEmbedding i.hom.base
  /-- The kernel ideal sheaf of a closed immersion is locally generated by sections. -/
  idealSheaf_locallyGenerated :
    Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData

instance {X Z : RingedSpace.{u}} {i : Z ⟶ X} [hi : RingedSpace.IsClosedImmersion i] :
    Topology.IsClosedEmbedding i.hom.base :=
  hi.isClosedEmbedding

/-- For a closed immersion, the kernel ideal sheaf is locally generated by sections. -/
instance {X Z : RingedSpace.{u}} {i : Z ⟶ X} [hi : RingedSpace.IsClosedImmersion i] :
    Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData :=
  hi.idealSheaf_locallyGenerated

end AlgebraicGeometry.RingedSpace
