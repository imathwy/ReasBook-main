  exact etale_syntomic hf

/-- Lemma 34.6.2 (3): any Zariski covering is a syntomic covering. Equivalently, the big Zariski
Grothendieck topology on schemes is contained in the Grothendieck topology generated by syntomic
morphisms. -/
@[stacks 0226]
theorem zariskiTopology_le_syntomicTopology :
    Scheme.zariskiTopology ≤ Scheme.grothendieckTopology (@Syntomic) := by
  refine Scheme.grothendieckTopology_monotone (P := @IsOpenImmersion) (Q := @Syntomic) ?_
  intro X Y f hf
  letI : IsOpenImmersion f := hf
  exact syntomic_of_isOpenImmersion f

