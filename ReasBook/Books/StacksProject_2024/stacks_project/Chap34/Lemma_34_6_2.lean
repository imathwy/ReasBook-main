namespace AlgebraicGeometry.Scheme

/-- Lemma 34.6.2 (1): any smooth covering is a syntomic covering. Equivalently, the big smooth
Grothendieck topology on schemes is contained in the Grothendieck topology generated by syntomic
morphisms. -/
@[stacks 0226]
theorem smoothTopology_le_syntomicTopology :
    Scheme.bigSmoothSite ≤ Scheme.grothendieckTopology (@Syntomic) := by
  refine Scheme.grothendieckTopology_monotone (P := @Smooth) (Q := @Syntomic) ?_
  intro X Y f hf
  exact smooth_syntomic hf

/-- Lemma 34.6.2 (2): any étale covering is a syntomic covering. Equivalently, the big étale
Grothendieck topology on schemes is contained in the Grothendieck topology generated by syntomic
morphisms. -/
@[stacks 0226]
theorem etaleTopology_le_syntomicTopology :
    Scheme.etaleTopology ≤ Scheme.grothendieckTopology (@Syntomic) := by
  refine Scheme.grothendieckTopology_monotone (P := @Etale) (Q := @Syntomic) ?_
