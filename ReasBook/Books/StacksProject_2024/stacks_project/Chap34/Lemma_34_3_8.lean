      IsOpenImmersion S inferInstance inferInstance inferInstance inferInstance)

/-- The big affine Zariski Grothendieck topology is generated by the restricted big Zariski
precoverage on affine `S`-schemes. -/
theorem bigAffineZariskiTopology_eq_toGrothendieck :
    bigAffineZariskiTopology S = (bigAffineZariskiPrecoverage S).toGrothendieck :=
  rfl

/-- The small affine Zariski Grothendieck topology is generated by the restricted Zariski
precoverage on affine opens of `S`. -/
theorem smallAffineZariskiTopology_eq_toGrothendieck :
    smallAffineZariskiTopology S = (smallAffineZariskiPrecoverage S).toGrothendieck :=
  rfl

