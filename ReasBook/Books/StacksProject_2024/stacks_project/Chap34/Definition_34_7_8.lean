import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
import Mathlib.CategoryTheory.Sites.Over
import Mathlib.AlgebraicGeometry.Sites.Fpqc

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open AlgebraicGeometry

universe u

namespace AlgebraicGeometry

namespace Scheme

-- Semantic recall checked the canonical full-subcategory owner
-- `ObjectProperty.FullSubcategory (fun X : Over S ↦ IsAffine X.left)` together with
-- `ObjectProperty.ι` and `Precoverage.mem_comap_iff`; the source-facing affine slice and
-- restricted precoverage below are built directly on that canonical object-property API.

variable (S : Scheme.{u})

/- Recall: the big fppf site of `S` is the canonical over-site
`Scheme.fppfTopology.over S` on `Over S`. -/
#check Scheme.fppfTopology.over S

/-- Definition 34.7.8 (1): the big affine fppf site of `S` has as underlying category the full
subcategory of `Over S` whose objects have affine source scheme. -/
@[stacks 021S]
abbrev AffineOver (S : Scheme.{u}) :=
  ObjectProperty.FullSubcategory (fun X : Over S ↦ IsAffine X.left)

namespace AffineOver

/-- The inclusion functor from affine `S`-schemes to all `S`-schemes. -/
abbrev forget (S : Scheme.{u}) : S.AffineOver ⥤ Over S :=
  ObjectProperty.ι (fun X : Over S ↦ IsAffine X.left)

/-- An object of `S.AffineOver` has affine source scheme. -/
instance instIsAffineLeft (U : S.AffineOver) : IsAffine U.obj.left :=
  U.property

end AffineOver

/-- Definition 34.7.8 (2): a covering of the big affine fppf site is a standard fppf covering in
the canonical big fppf site over `S`, restricted along the inclusion `S.AffineOver ⥤ Over S`. -/
@[stacks 021S]
abbrev bigAffineFppfPrecoverage (S : Scheme.{u}) : Precoverage S.AffineOver :=
  (Scheme.fppfTopology.over S).toPrecoverage.comap (AffineOver.forget S)

/-- A presieve on the affine slice is covering for the big affine fppf precoverage exactly when
its image in `Over S` is covering for the canonical slice-site fppf precoverage. -/
@[simp] theorem mem_bigAffineFppfPrecoverage_iff
    {U : S.AffineOver} {R : Presieve U} :
    R ∈ bigAffineFppfPrecoverage S U ↔
      R.map (AffineOver.forget S) ∈ (Scheme.fppfTopology.over S).toPrecoverage U.obj := by
  rw [bigAffineFppfPrecoverage, Precoverage.mem_comap_iff]
  rfl

/-- A finite affine family is covering for the restricted affine fppf precoverage exactly when
its underlying family in `Over S` is covering for the canonical big fppf precoverage. -/
@[simp] theorem ofArrows_mem_bigAffineFppfPrecoverage_iff
    {U : S.AffineOver} {ι : Type u} [Finite ι] (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ bigAffineFppfPrecoverage S U ↔
      Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (π i).hom) ∈
        (Scheme.fppfTopology.over S).toPrecoverage U.obj := by
  rw [mem_bigAffineFppfPrecoverage_iff]
  simpa [Presieve.map_ofArrows]

/-- The affine fppf Grothendieck topology is the restriction of the canonical slice-site topology
`Scheme.fppfTopology.over S` along the affine inclusion. -/
@[stacks 021S]
abbrev bigAffineFppfTopology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  (bigAffineFppfPrecoverage S).toGrothendieck

/-- Unfolding `bigAffineFppfTopology` recovers the Grothendieck topology generated by the
restricted fppf precoverage on affine `S`-schemes. -/
theorem bigAffineFppfTopology_def (S : Scheme.{u}) :
    bigAffineFppfTopology S = (bigAffineFppfPrecoverage S).toGrothendieck :=
  rfl

end Scheme

end AlgebraicGeometry
