open CategoryTheory.ObjectProperty

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme

-- Semantic recall: `lean_leansearch` surfaced the canonical site-level upgrade
-- `CategoryTheory.Precoverage.toPretopology`, and the chapter-local owner choice was verified
-- against `bigAffineFppfPrecoverage` from Definition 34.7.8.

variable (S : Scheme.{u})

/-- Affine objects in `Over S` are closed under isomorphisms. -/
instance affineOver_isClosedUnderIsomorphisms :
    IsClosedUnderIsomorphisms (fun X : Over S ↦ IsAffine X.left) where
  of_iso := by
    intro X Y e hX
    exact (IsAffine.iff_of_isIso e.hom.left).mp hX

/-- Affine objects in `Over S` are closed under pullbacks. -/
instance affineOver_isClosedUnderLimitsOfShape_walkingCospan :
    ObjectProperty.IsClosedUnderLimitsOfShape
      (fun X : Over S ↦ IsAffine X.left) WalkingCospan := by
  refine ObjectProperty.IsClosedUnderLimitsOfShape.mk' ?_
  rintro _ ⟨F, hF⟩
  let X := F.obj WalkingCospan.left
  let Y := F.obj WalkingCospan.right
  let Z := F.obj WalkingCospan.one
  let f : X ⟶ Z := F.map WalkingCospan.Hom.inl
  let g : Y ⟶ Z := F.map WalkingCospan.Hom.inr
  let e := HasLimit.isoOfNatIso (diagramIsoCospan F)
  let epb := PreservesPullback.iso (Over.forget S) f g
  have hpull : IsAffine (limit (cospan f g)).left := by
    exact
      (IsAffine.iff_of_isIso epb.hom).mpr
        (Scheme.Pullback.isAffine_of_isAffine_isAffine_isAffine f.left g.left)
  exact
    (IsAffine.iff_of_isIso e.hom.left).mpr hpull

/-- The category `S.AffineOver` has pullbacks. -/
instance affineOver_hasPullbacks : HasPullbacks S.AffineOver :=
  CategoryTheory.Limits.hasLimitsOfShape_of_closedUnderLimits
    WalkingCospan
    (fun X : Over S ↦ IsAffine X.left)

/-- Singleton isomorphisms are coverings in the restricted standard fppf precoverage on affine
`S`-schemes. -/
instance bigAffineFppfPrecoverage_hasIsos : (bigAffineFppfPrecoverage S).HasIsos where
  mem_coverings_of_isIso := by
    intro U V f _
    let _ : IsIso ((Scheme.AffineOver.forget S).map f) :=
      Functor.map_isIso (Scheme.AffineOver.forget S) f
    rw [mem_bigAffineFppfPrecoverage_iff]
    simpa using
      ((Scheme.fppfTopology.over S).toPrecoverage.mem_coverings_of_isIso
        ((Scheme.AffineOver.forget S).map f))

/-- Lemma 34.7.9: the big affine fppf site `(\textit{Aff}/S)_{fppf}` is the canonical
pretopology obtained by promoting the restricted standard fppf precoverage on affine `S`-schemes
to a site. -/
@[stacks 021T]
abbrev bigAffineFppfSite : Pretopology S.AffineOver :=
  (bigAffineFppfPrecoverage S).toPretopology

/-- The source-facing big affine fppf site is definitionally the canonical pretopology attached
to the restricted standard fppf precoverage on affine `S`-schemes. -/
theorem bigAffineFppfSite_eq_bigAffineFppfPrecoverage_toPretopology :
    bigAffineFppfSite S = (bigAffineFppfPrecoverage S).toPretopology :=
  rfl

/-- The underlying precoverage of `bigAffineFppfSite S` is the restricted standard fppf
precoverage on affine `S`-schemes. -/
theorem bigAffineFppfSite_toPrecoverage :
    (bigAffineFppfSite S).toPrecoverage = bigAffineFppfPrecoverage S :=
  rfl

/-- The Grothendieck topology underlying `bigAffineFppfSite S` is the Grothendieck topology
generated by the restricted standard fppf precoverage on affine `S`-schemes. -/
theorem bigAffineFppfSite_toGrothendieck :
    (bigAffineFppfSite S).toGrothendieck = (bigAffineFppfPrecoverage S).toGrothendieck := by
  simpa [bigAffineFppfSite] using
    (bigAffineFppfPrecoverage S).toGrothendieck_toPretopology_eq_toGrothendieck

end AlgebraicGeometry.Scheme
