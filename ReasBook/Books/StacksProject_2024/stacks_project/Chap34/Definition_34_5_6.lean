import Mathlib
import Mathlib.AlgebraicGeometry.Cover.MorphismProperty
import Mathlib.AlgebraicGeometry.Morphisms.Smooth

open CategoryTheory
open AlgebraicGeometry

universe u

namespace AlgebraicGeometry.Scheme

-- Source/core/bridge triage:
-- `source-facing`: the Stacks notion of smooth covering families of schemes;
-- `core/canonical`: the repository/mathlib owners `Scheme.precoverage @Smooth` and
--   `Scheme.grothendieckTopology @Smooth`;
-- `bridge/view`: the comparison theorem `bigSmoothSite_eq_toGrothendieck`.
--
-- As in the syntomic analogue, the source-facing covering families should keep the precoverage as
-- a named repository-level owner, while the big smooth site itself is the canonical
-- Grothendieck topology generated by that precoverage.

instance smooth_containsIdentities : MorphismProperty.ContainsIdentities (@Smooth) :=
  HasRingHomProperty.containsIdentities RingHom.Smooth.id

/-- The source-facing smooth covering families on the universe-sized category of schemes. -/
abbrev bigSmoothPrecoverage : Precoverage Scheme.{u} :=
  Scheme.precoverage (@Smooth)

/-- Definition 34.5.6: the big smooth site is the canonical Grothendieck topology on the
universe-sized category of schemes generated by jointly surjective families of smooth morphisms.
This is Lean's faithful replacement for the source's chosen set-sized presentation of the big
smooth site. -/
abbrev bigSmoothSite : GrothendieckTopology Scheme.{u} :=
  Scheme.grothendieckTopology (@Smooth)

/-- The big smooth site is generated by the canonical smooth precoverage on schemes. -/
theorem bigSmoothSite_eq_toGrothendieck :
    bigSmoothSite = bigSmoothPrecoverage.toGrothendieck :=
  rfl

/- Definition 34.5.6: a smooth covering family of a scheme is the canonical cover object for the
smooth precoverage on schemes. -/
#check Scheme.Cover bigSmoothPrecoverage

end AlgebraicGeometry.Scheme
