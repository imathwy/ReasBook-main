import Mathlib.CategoryTheory.Limits.Constructions.Over.Products
import Mathlib.CategoryTheory.ObjectProperty.FullSubcategory
import Mathlib.CategoryTheory.ObjectProperty.LimitsOfShape
import Mathlib.AlgebraicGeometry.Sites.Etale
import StacksProject_2024.stacks_project.Chap34.Definition_34_7_8

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.ObjectProperty
open AlgebraicGeometry
open GrothendieckTopology

noncomputable section

universe u

namespace AlgebraicGeometry.Scheme

variable (S : Scheme.{u})

private abbrev bigAffineObjects : ObjectProperty (Over S) :=
  fun X ↦ IsAffine X.left

private abbrev smallAffineObjects : ObjectProperty S.Etale :=
  fun X ↦ IsAffine X.left

instance bigAffineObjects_isClosedUnderIsomorphisms :
    ObjectProperty.IsClosedUnderIsomorphisms (bigAffineObjects S) where
  of_iso := by
    intro X Y e hX
    exact (IsAffine.iff_of_isIso e.hom.left).mp hX

instance smallAffineObjects_isClosedUnderIsomorphisms :
    ObjectProperty.IsClosedUnderIsomorphisms (smallAffineObjects S) where
  of_iso := by
    intro X Y e hX
    exact (IsAffine.iff_of_isIso e.hom.left).mp hX

/- Semantic recall:
- `S.overGrothendieckTopology @Etale` is the canonical big étale site over `S`;
- `S.smallEtaleTopology` is the canonical small étale site of `S`;
- `S.AffineOver` is the repository-standard affine full subcategory of `Over S`, and the source-
  facing affine étale site data below is the restricted topology/covering layer on that existing
  owner.
-/

/- Recall for Definition 34.4.8: the big étale site of `S` is `Over S` equipped with the induced
étale Grothendieck topology `S.overGrothendieckTopology @Etale`. -/
#check (S.overGrothendieckTopology @Etale)

/- Recall for Definition 34.4.8: the small étale site of `S` is `S.Etale` equipped with the small
étale Grothendieck topology `S.smallEtaleTopology`. -/
#check S.smallEtaleTopology

/-- The canonical forgetful functor from the small étale site of `S` to schemes. -/
abbrev smallEtaleToScheme (S : Scheme.{u}) : S.Etale ⥤ Scheme :=
  MorphismProperty.Over.forget @Etale ⊤ S ⋙ Over.forget S

/-- The canonical forgetful functor from the small étale site of `S` to schemes preserves
pullbacks. -/
instance smallEtaleToScheme_preservesPullbacks :
    PreservesLimitsOfShape WalkingCospan (smallEtaleToScheme S) := by
  change
    PreservesLimitsOfShape WalkingCospan
      (MorphismProperty.Over.forget @Etale ⊤ S ⋙ Over.forget S)
  infer_instance

/-- Pullbacks of affine objects in `Over S` along affine objects are again affine. -/
instance bigAffineEtaleSite_isClosedUnderLimitsOfShape_walkingCospan :
    ObjectProperty.IsClosedUnderLimitsOfShape
      (bigAffineObjects S) WalkingCospan := by
  refine ObjectProperty.IsClosedUnderLimitsOfShape.mk' ?_
  rintro _ ⟨F, hF⟩
  let X := F.obj WalkingCospan.left
  let Y := F.obj WalkingCospan.right
  let Z := F.obj WalkingCospan.one
  let f : X ⟶ Z := F.map WalkingCospan.Hom.inl
  let g : Y ⟶ Z := F.map WalkingCospan.Hom.inr
  let e := HasLimit.isoOfNatIso (diagramIsoCospan F)
  let epb := PreservesPullback.iso (Over.forget S) f g
  have hpull : IsAffine (limit (cospan f g)).left := by
    exact
      (IsAffine.iff_of_isIso epb.hom).mpr
        (Scheme.Pullback.isAffine_of_isAffine_isAffine_isAffine f.left g.left)
  exact
    (IsAffine.iff_of_isIso e.hom.left).mpr hpull

/-- The underlying category of the big affine étale site of `S` has pullbacks. -/
instance bigAffineEtaleSite_hasPullbacks : HasPullbacks S.AffineOver :=
  inferInstance

/-- The canonical functor from the big affine étale site of `S` to schemes. -/
abbrev bigAffineEtaleToScheme (S : Scheme.{u}) : S.AffineOver ⥤ Scheme :=
  Scheme.AffineOver.forget S ⋙ Over.forget S

/-- A presieve on `S.AffineOver` is a standard étale covering if it is generated by a
finite family of affine `S`-schemes whose underlying family is a covering in the big étale site
from the canonical restricted precoverage. -/
def bigAffineEtaleCovering (S : Scheme.{u}) {X : S.AffineOver} (R : Presieve X) : Prop :=
  ∃ (ι : Type u) (_ : Finite ι) (Y : ι → S.AffineOver) (f : ∀ i, Y i ⟶ X),
    R = Presieve.ofArrows Y f ∧
      (Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (f i).hom) ∈
        (S.overGrothendieckTopology @Etale).toPrecoverage X.obj)

/-- A finite affine family of étale arrows that covers in `Over S` defines a standard étale
covering presieve on `S.AffineOver`. -/
theorem bigAffineEtaleCovering_ofArrows {X : S.AffineOver} {ι : Type u} [Finite ι]
    (Y : ι → S.AffineOver) (f : ∀ i, Y i ⟶ X)
    (hcover :
      Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (f i).hom) ∈
        (S.overGrothendieckTopology @Etale).toPrecoverage X.obj) :
    bigAffineEtaleCovering S (Presieve.ofArrows Y f) :=
  ⟨ι, inferInstance, Y, f, rfl, hcover⟩

/-- The restricted standard étale precoverage on affine `S`-schemes. -/
abbrev bigAffineEtalePrecoverage (S : Scheme.{u}) : Precoverage S.AffineOver :=
  (S.overGrothendieckTopology @Etale).toPrecoverage.comap (Scheme.AffineOver.forget S)

/-- Definition 34.4.8 (1): the big affine étale site of `S` is the full subcategory of `Over S`
on affine `S`-schemes, equipped with the restricted étale Grothendieck topology. -/
abbrev bigAffineEtaleTopology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  (bigAffineEtalePrecoverage S).toGrothendieck

/-- A presieve on the big affine étale site is covering exactly when its image in `Over S` is
covering for the canonical big étale precoverage. -/
@[simp] theorem mem_bigAffineEtalePrecoverage_iff
    {X : S.AffineOver} {R : Presieve X} :
    R ∈ bigAffineEtalePrecoverage S X ↔
      R.map (Scheme.AffineOver.forget S) ∈
        (S.overGrothendieckTopology @Etale).toPrecoverage X.obj := by
  rw [bigAffineEtalePrecoverage, Precoverage.mem_comap_iff]
  rfl

/-- Every source-facing finite affine étale covering family defines a covering presieve for the
canonical restricted precoverage on `S.AffineOver`. -/
theorem bigAffineEtaleCovering_mem_precoverage
    {X : S.AffineOver} {R : Presieve X}
    (hR : bigAffineEtaleCovering S R) :
    R ∈ bigAffineEtalePrecoverage S X := by
  rcases hR with ⟨ι, _, Y, f, rfl, hcover⟩
  rw [mem_bigAffineEtalePrecoverage_iff]
  simpa [Presieve.map_ofArrows] using hcover

/-- `bigAffineEtaleCovering` unfolds to the finite-family presentation from the source
definition. -/
theorem bigAffineEtaleCovering_iff
    {X : S.AffineOver} {R : Presieve X} :
    bigAffineEtaleCovering S R ↔
      ∃ (ι : Type u) (_ : Finite ι) (Y : ι → S.AffineOver) (f : ∀ i, Y i ⟶ X),
        R = Presieve.ofArrows Y f ∧
          Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (f i).hom) ∈
            (S.overGrothendieckTopology @Etale).toPrecoverage X.obj :=
  Iff.intro (fun h ↦ h) (fun h ↦ h)

/-- The affine big étale topology is the Grothendieck topology generated by the restricted
standard étale precoverage. -/
theorem bigAffineEtaleTopology_def (S : Scheme.{u}) :
    bigAffineEtaleTopology S = (bigAffineEtalePrecoverage S).toGrothendieck :=
  rfl

/-- The full subcategory of `S.Etale` consisting of affine étale `S`-schemes. -/
abbrev smallAffineEtaleSite (S : Scheme.{u}) : Type (u + 1) :=
  ObjectProperty.FullSubcategory (smallAffineObjects S)

/-- The inclusion `S.smallAffineEtaleSite ⥤ S.Etale`. -/
abbrev smallAffineEtaleSiteInclusion (S : Scheme.{u}) :
    smallAffineEtaleSite S ⥤ S.Etale :=
  ObjectProperty.ι (smallAffineObjects S)

/-- Objects of `S.smallAffineEtaleSite` are affine schemes. -/
instance smallAffineEtaleSite_obj_isAffine (X : smallAffineEtaleSite S) : IsAffine X.obj.left :=
  X.property

/-- Pullbacks of affine objects in `S.Etale` along affine objects are again affine. -/
instance smallAffineEtaleSite_isClosedUnderLimitsOfShape_walkingCospan :
    ObjectProperty.IsClosedUnderLimitsOfShape
      (smallAffineObjects S) WalkingCospan := by
  refine ObjectProperty.IsClosedUnderLimitsOfShape.mk' ?_
  rintro _ ⟨F, hF⟩
  let X := F.obj WalkingCospan.left
  let Y := F.obj WalkingCospan.right
  let Z := F.obj WalkingCospan.one
  let f : X ⟶ Z := F.map WalkingCospan.Hom.inl
  let g : Y ⟶ Z := F.map WalkingCospan.Hom.inr
  let e := HasLimit.isoOfNatIso (diagramIsoCospan F)
  let epb := PreservesPullback.iso (MorphismProperty.Over.forget @Etale ⊤ S ⋙ Over.forget S) f g
  have hpull : IsAffine (limit (cospan f g)).left := by
    exact
      (IsAffine.iff_of_isIso epb.hom).mpr
        (Scheme.Pullback.isAffine_of_isAffine_isAffine_isAffine f.left g.left)
  exact
    (IsAffine.iff_of_isIso e.hom.left).mpr hpull

/-- The category `S.smallAffineEtaleSite` has pullbacks. -/
instance smallAffineEtaleSite_hasPullbacks : HasPullbacks (smallAffineEtaleSite S) :=
  inferInstance

/-- The canonical functor from the small affine étale site of `S` to schemes. -/
abbrev smallAffineEtaleToScheme (S : Scheme.{u}) : smallAffineEtaleSite S ⥤ Scheme :=
  smallAffineEtaleSiteInclusion S ⋙ smallEtaleToScheme S

/-- The canonical functor from the small affine étale site of `S` to schemes preserves
pullbacks. -/
instance smallAffineEtaleToScheme_preservesPullbacks :
    PreservesLimitsOfShape WalkingCospan (smallAffineEtaleToScheme S) := by
  change
    PreservesLimitsOfShape WalkingCospan
      (smallAffineEtaleSiteInclusion S ⋙ MorphismProperty.Over.forget @Etale ⊤ S ⋙ Over.forget S)
  infer_instance

/-- A presieve on `S.smallAffineEtaleSite` is a standard étale covering if it is generated by a
finite family of affine étale `S`-schemes whose underlying family is a covering in the small
étale site via the canonical restricted precoverage. -/
def smallAffineEtaleCovering (S : Scheme.{u}) {X : smallAffineEtaleSite S} (R : Presieve X) : Prop :=
  ∃ (ι : Type u) (_ : Finite ι) (Y : ι → smallAffineEtaleSite S) (f : ∀ i, Y i ⟶ X),
    R = Presieve.ofArrows Y f ∧
      (Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (f i).hom) ∈
        S.smallEtaleTopology.toPrecoverage X.obj)

/-- A finite affine family of étale arrows that covers in `S.Etale` defines a standard étale
covering presieve on `S.smallAffineEtaleSite`. -/
theorem smallAffineEtaleCovering_ofArrows {X : smallAffineEtaleSite S} {ι : Type u} [Finite ι]
    (Y : ι → smallAffineEtaleSite S) (f : ∀ i, Y i ⟶ X)
    (hcover :
      Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (f i).hom) ∈
        S.smallEtaleTopology.toPrecoverage X.obj) :
    smallAffineEtaleCovering S (Presieve.ofArrows Y f) :=
  ⟨ι, inferInstance, Y, f, rfl, hcover⟩

/-- The restricted standard small étale precoverage on affine étale `S`-schemes. -/
abbrev smallAffineEtalePrecoverage (S : Scheme.{u}) : Precoverage (smallAffineEtaleSite S) :=
  (S.smallEtaleTopology.toPrecoverage).comap (smallAffineEtaleSiteInclusion S)

/-- Definition 34.4.8 (2): the small affine étale site of `S` is the full subcategory of
`S.Etale` on affine objects, equipped with the restricted small étale Grothendieck topology. -/
abbrev smallAffineEtaleTopology (S : Scheme.{u}) :
    GrothendieckTopology (smallAffineEtaleSite S) :=
  (smallAffineEtalePrecoverage S).toGrothendieck

/-- A presieve on the small affine étale site is covering exactly when its image in `S.Etale` is
covering for the canonical small étale precoverage. -/
@[simp] theorem mem_smallAffineEtalePrecoverage_iff
    {X : smallAffineEtaleSite S} {R : Presieve X} :
    R ∈ smallAffineEtalePrecoverage S X ↔
      R.map (smallAffineEtaleSiteInclusion S) ∈
        S.smallEtaleTopology.toPrecoverage X.obj := by
  rw [smallAffineEtalePrecoverage, Precoverage.mem_comap_iff]
  rfl

/-- Every source-facing finite affine étale covering family defines a covering presieve for the
canonical restricted precoverage on `S.smallAffineEtaleSite`. -/
theorem smallAffineEtaleCovering_mem_precoverage
    {X : smallAffineEtaleSite S} {R : Presieve X}
    (hR : smallAffineEtaleCovering S R) :
    R ∈ smallAffineEtalePrecoverage S X := by
  rcases hR with ⟨ι, _, Y, f, rfl, hcover⟩
  rw [mem_smallAffineEtalePrecoverage_iff]
  simpa [Presieve.map_ofArrows] using hcover

/-- `smallAffineEtaleCovering` unfolds to the finite-family presentation from the source
definition. -/
theorem smallAffineEtaleCovering_iff
    {X : smallAffineEtaleSite S} {R : Presieve X} :
    smallAffineEtaleCovering S R ↔
      ∃ (ι : Type u) (_ : Finite ι) (Y : ι → smallAffineEtaleSite S) (f : ∀ i, Y i ⟶ X),
        R = Presieve.ofArrows Y f ∧
          Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (f i).hom) ∈
            S.smallEtaleTopology.toPrecoverage X.obj :=
  Iff.intro (fun h ↦ h) (fun h ↦ h)

/-- The affine small étale topology is the Grothendieck topology generated by the restricted
small étale precoverage. -/
theorem smallAffineEtaleTopology_def (S : Scheme.{u}) :
    smallAffineEtaleTopology S = (smallAffineEtalePrecoverage S).toGrothendieck :=
  rfl

end AlgebraicGeometry.Scheme
