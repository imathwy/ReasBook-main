import Mathlib.AlgebraicGeometry.Cover.MorphismProperty
import Mathlib.AlgebraicGeometry.Morphisms.Smooth
import Mathlib.AlgebraicGeometry.Sites.Etale
import Mathlib.AlgebraicGeometry.Sites.Fpqc

-- Declarations for this item will be appended below by the statement pipeline.

namespace AlgebraicGeometry.Scheme

-- Semantic recall: this remark only identifies the canonical Grothendieck topologies on schemes.
-- The Zariski, étale, and fppf sites already have mathlib owners; the smooth and syntomic clauses
-- are the canonical topologies generated by the morphism properties `@Smooth` and `@Syntomic`.

/- Remark 34.11.1: the big Zariski site on schemes is the canonical Zariski Grothendieck
topology. -/
#check zariskiTopology

/- Remark 34.11.1: the big étale site on schemes is the canonical étale Grothendieck topology. -/
#check etaleTopology

/- Remark 34.11.1: the big fppf site on schemes is the canonical fppf Grothendieck topology. -/
#check fppfTopology

/- Remark 34.11.1: the big smooth site on schemes is the Chapter 34 owner for the canonical smooth
Grothendieck topology. -/
#check Scheme.grothendieckTopology (@Smooth)

/- Remark 34.11.1: the big syntomic site on schemes is the Chapter 34 owner for the canonical
syntomic Grothendieck topology. -/
#check Scheme.grothendieckTopology (@Syntomic)

end AlgebraicGeometry.Scheme
