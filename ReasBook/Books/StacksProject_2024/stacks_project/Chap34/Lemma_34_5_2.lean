import Mathlib
import StacksProject_2024.stacks_project.Chap34.Definition_34_5_6

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry

/- Semantic recall:
The canonical owner for these comparisons is the Grothendieck topology generated by a morphism
property on `Scheme`, together with the monotonicity theorem
`AlgebraicGeometry.Scheme.grothendieckTopology_monotone`. The étale-to-smooth implication is
supplied by the canonical instance `Etale f -> Smooth f`, and the Zariski clause reuses the
existing bridge `Scheme.zariskiTopology_le_etaleTopology`. -/

namespace AlgebraicGeometry.Scheme

/-- Lemma 34.5.2 (1): any étale covering is a smooth covering. Equivalently, the big étale
Grothendieck topology on schemes is contained in the Grothendieck topology generated by smooth
morphisms. -/
@[stacks 0220]
theorem etaleTopology_le_smoothTopology :
    etaleTopology ≤ bigSmoothSite := by
  intro X R hR
  exact
    grothendieckTopology_monotone
      (fun _ _ f hf ↦ by
        let _ : Etale f := hf
        infer_instance) _ hR

/-- Lemma 34.5.2 (2): any Zariski covering is a smooth covering. Equivalently, the big Zariski
Grothendieck topology on schemes is contained in the Grothendieck topology generated by smooth
morphisms. -/
@[stacks 0220]
theorem zariskiTopology_le_smoothTopology :
    zariskiTopology ≤ bigSmoothSite :=
  zariskiTopology_le_etaleTopology.trans etaleTopology_le_smoothTopology

end AlgebraicGeometry.Scheme
