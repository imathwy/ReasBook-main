import Mathlib
import Mathlib.CategoryTheory.Sites.DenseSubsite.SheafEquiv
import StacksProject_2024.Chap34.Definition_34_7_8

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory

universe u

namespace AlgebraicGeometry
namespace Scheme

-- Semantic recall: `lean_leansearch` returned `AlgebraicGeometry.IsAffine` as the affineness
-- owner; `Definition_34_7_8` already owns the affine full subcategory `S.AffineOver`. The
-- source-facing finite covering families are kept below, but the affine-slice inclusion and the
-- induced affine-slice topology/precoverage are also owned here so downstream files can reuse one
-- coherent site surface instead of rebuilding it independently.

/-- The morphism property on schemes consisting of being proper and surjective. -/
abbrev properSurjectiveMorphismProperty : MorphismProperty Scheme.{u} :=
  (@IsProper) ⊓ (@Surjective)

/-- The Grothendieck topology on `Over S` generated by proper-surjective morphisms. -/
abbrev properSurjectiveTopology (S : Scheme.{u}) : GrothendieckTopology (Over S) :=
  S.overGrothendieckTopology properSurjectiveMorphismProperty

/-- Definition 34.8.11 (1): the big ph site of `S` is the slice site `(\mathit{Sch}/S)_{ph}`,
realized as the join of the Zariski slice topology and the proper-surjective slice topology on
`Over S`. -/
abbrev bigPhSite (S : Scheme.{u}) : GrothendieckTopology (Over S) :=
  Scheme.zariskiTopology.over S ⊔ properSurjectiveTopology S

/-- Unfolding `bigPhSite` recovers the Zariski-plus-proper-surjective slice topology. -/
theorem bigPhSite_def (S : Scheme.{u}) :
    bigPhSite S = Scheme.zariskiTopology.over S ⊔ properSurjectiveTopology S :=
  rfl

/- Definition 34.8.11 (3): the big affine ph site of `S` has underlying category
`S.AffineOver`, already introduced in Definition 34.7.8 as the full subcategory of `Over S`
spanned by the affine objects over `S`. -/
recall Scheme.AffineOver
recall Scheme.AffineOver.forget

/-- The affine inclusion is locally cover-dense for the big ph topology on `Over S`. -/
theorem bigAffinePhInclusion_isLocallyCoverDense (S : Scheme.{u}) :
    (Scheme.AffineOver.forget S).LocallyCoverDense (bigPhSite S) :=
  sorry

instance bigAffinePhInclusion_locallyCoverDense (S : Scheme.{u}) :
    (Scheme.AffineOver.forget S).LocallyCoverDense (bigPhSite S) :=
  bigAffinePhInclusion_isLocallyCoverDense S

/-- Definition 34.8.11 (4): a covering of the big affine ph site is a finite family of affine
objects over `S` whose underlying family in `(\mathit{Sch}/S)_{ph}` is covering. This is the
source-facing finite-family owner for affine `ph` coverings. -/
def bigAffinePhCovering (S : Scheme.{u}) {U : S.AffineOver} (R : Presieve U) : Prop :=
  ∃ (ι : Type u) (_ : Finite ι) (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U),
    R = Presieve.ofArrows Y π ∧
      Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (π i).hom) ∈
        (bigPhSite S).toPrecoverage U.obj

/-- The canonical affine `ph` precoverage on affine `S`-schemes, obtained by restricting the big
`ph` precoverage on `Over S` along the affine inclusion. -/
abbrev bigAffinePhPrecoverage (S : Scheme.{u}) : Precoverage S.AffineOver :=
  (bigPhSite S).toPrecoverage.comap (Scheme.AffineOver.forget S)

/-- A presieve on the affine slice is covering for the affine `ph` precoverage exactly when its
image in `(\mathit{Sch}/S)_{ph}` is covering for the canonical big `ph` precoverage. -/
@[simp] theorem mem_bigAffinePhPrecoverage_iff (S : Scheme.{u})
    {U : S.AffineOver} {R : Presieve U} :
    R ∈ bigAffinePhPrecoverage S U ↔
      R.map (Scheme.AffineOver.forget S) ∈ (bigPhSite S).toPrecoverage U.obj := by
  rw [bigAffinePhPrecoverage, Precoverage.mem_comap_iff]
  rfl

/-- A finite affine family is covering for the affine `ph` precoverage exactly when its underlying
family in `(\mathit{Sch}/S)_{ph}` is covering. -/
@[simp] theorem ofArrows_mem_bigAffinePhPrecoverage_iff (S : Scheme.{u})
    {U : S.AffineOver} {ι : Type u} [Finite ι] (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U) :
    Presieve.ofArrows Y π ∈ bigAffinePhPrecoverage S U ↔
      Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (π i).hom) ∈
        (bigPhSite S).toPrecoverage U.obj := by
  rw [mem_bigAffinePhPrecoverage_iff]
  simpa [Presieve.map_ofArrows]

/-- The canonical Grothendieck topology on the big affine `ph` site of `S`, generated by the
restricted affine `ph` precoverage on affine `S`-schemes. -/
abbrev bigAffinePhTopology (S : Scheme.{u}) : GrothendieckTopology S.AffineOver :=
  (bigAffinePhPrecoverage S).toGrothendieck

/-- Unfolding `bigAffinePhTopology` recovers the Grothendieck topology generated by the
restricted affine `ph` precoverage. -/
theorem bigAffinePhTopology_def (S : Scheme.{u}) :
    bigAffinePhTopology S = (bigAffinePhPrecoverage S).toGrothendieck :=
  rfl

/-- A finite affine family over `S` whose underlying family covers in `(\mathit{Sch}/S)_{ph}`
defines a covering presieve on the big affine ph site. -/
theorem bigAffinePhCovering_ofArrows (S : Scheme.{u})
    {U : S.AffineOver} {ι : Type u} [Finite ι] (Y : ι → S.AffineOver)
    (π : ∀ i, Y i ⟶ U)
    (hcover :
      Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (π i).hom) ∈
        (bigPhSite S).toPrecoverage U.obj) :
    bigAffinePhCovering S (Presieve.ofArrows Y π) :=
  ⟨ι, inferInstance, Y, π, rfl, hcover⟩

/-- Every source-facing finite affine `ph` covering family defines a covering presieve for the
canonical pulled-back affine `ph` precoverage. -/
theorem bigAffinePhCovering_mem_precoverage (S : Scheme.{u})
    {U : S.AffineOver} {R : Presieve U} (hR : bigAffinePhCovering S R) :
    R ∈ bigAffinePhPrecoverage S U := by
  rcases hR with ⟨ι, _, Y, π, rfl, hcover⟩
  rw [mem_bigAffinePhPrecoverage_iff]
  simpa [Presieve.map_ofArrows] using hcover

/-- `bigAffinePhCovering` unfolds to the source-facing finite-family presentation from the
definition. -/
theorem bigAffinePhCovering_iff (S : Scheme.{u}) {U : S.AffineOver} {R : Presieve U} :
    bigAffinePhCovering S R ↔
      ∃ (ι : Type u) (_ : Finite ι) (Y : ι → S.AffineOver) (π : ∀ i, Y i ⟶ U),
        R = Presieve.ofArrows Y π ∧
          Presieve.ofArrows (fun i ↦ (Y i).obj) (fun i ↦ (π i).hom) ∈
            (bigPhSite S).toPrecoverage U.obj :=
  Iff.intro (fun h ↦ h) (fun h ↦ h)

end Scheme
end AlgebraicGeometry
