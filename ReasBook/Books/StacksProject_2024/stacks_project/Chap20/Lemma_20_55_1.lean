/- Domain-style sampling for Lemma 20.55.1:
- primary domain: canonical ideal sheaves `I : Subobject 𝒪X` on a ringed space and the induced
  module-theoretic properties of the underlying `𝒪_X`-module `(I : ModX)`;
- inspected owner declarations:
  `SatisfiesLocallyPrincipalRegularIdealCondition`,
  `CategoryTheory.Subobject`,
  `SheafOfModules.IsFiniteLocallyFreeOfRank`,
  `Functor.IsEquivalence (tensorRight ℒ)`,
  `isFiniteLocallyFreeOfRank_one_of_isInvertible_of_stalk_isLocalRing`,
  `Fact`;
- best owner abstraction: the source-facing regularity owner
  `SatisfiesLocallyPrincipalRegularIdealCondition I` on the canonical ideal sheaf
  `I : Subobject 𝒪X`, while the canonical downstream owners here are
  `SheafOfModules.IsFiniteLocallyFreeOfRank` and `IsInvertibleX (I : ModX)`;
- primitive data: an ideal sheaf `I : Subobject 𝒪X`;
- derived API: the bridge theorem and canonical instance bridge from the regular condition to
  rank-one local freeness, together with the converse Prop-valued bridge from an assumed
  invertibility witness under local-stalk hypotheses.

Layer triage:
- `source-facing`: the local-principal-regular condition on an ideal sheaf inclusion;
- `core/canonical`: `SheafOfModules.IsFiniteLocallyFreeOfRank` and
  `IsInvertibleX (I : ModX)`;
- `bridge/view`: the bridge theorems and instance bridges from
  `[SatisfiesLocallyPrincipalRegularIdealCondition I]` to those canonical owners. -/

/-- A locally principal ideal sheaf generated by a regular local section is finite locally free of
rank `1`. -/
theorem isFiniteLocallyFreeOfRank_one_of_isLocallyPrincipalRegularIdeal
    (I : Subobject 𝒪X)
    (hprincipal : SatisfiesLocallyPrincipalRegularIdealCondition I) :
    SheafOfModules.IsFiniteLocallyFreeOfRank 1 (I : ModX) := by
  -- Proof comment: on a principal chart from `Situation 20.55.2`, the restricted ideal sheaf is
  -- identified with the restricted structure sheaf, which is the rank-one free module.
  refine ⟨fun x ↦ ?_⟩
  rcases hprincipal.exists_chart x with ⟨U, hxU, e, s, he⟩
  -- Proof comment: compose the chosen ideal-sheaf chart with the canonical singleton-basis chart
  -- for the restricted structure sheaf.
  rcases SheafOfModules.unit_over_iso_free_singleton (X := X) U with ⟨eUnit⟩
  exact ⟨U, hxU, ⟨e ≪≫ eUnit⟩⟩

/-- The local principal regular ideal condition makes the ideal sheaf finite locally free of rank
`1`. -/
instance instIsFiniteLocallyFreeOfRankOneOfLocallyPrincipalRegularIdeal
    (I : Subobject 𝒪X)
    [SatisfiesLocallyPrincipalRegularIdealCondition I] :
    SheafOfModules.IsFiniteLocallyFreeOfRank 1 (I : ModX) :=
  isFiniteLocallyFreeOfRank_one_of_isLocallyPrincipalRegularIdeal I inferInstance

section InvertibleIdeal

variable [MonoidalCategory (RingedSpace.Modules X)]

/-- The local principal regular ideal condition makes the ideal sheaf invertible. -/
instance instTensorRightIsEquivalenceOfLocallyPrincipalRegularIdeal
    (I : Subobject 𝒪X)
    [SatisfiesLocallyPrincipalRegularIdealCondition I] :
    IsInvertibleX (I : ModX) :=
  isInvertible_of_isFiniteLocallyFreeOfRank_one (I : ModX)

omit [MonoidalCategory ModX] in
/-- Helper for Lemma 20.55.1: `unitHomEquiv` on the slice over `U` is computed by evaluating the
underlying unit morphism at the terminal object `U ⟶ U`. -/
private theorem unitHomEquiv_apply_terminal
    {U : Opens X} (M : SheafOfModules (X.ringCatSheaf.over U))
    (f : SheafOfModules.unit (X.ringCatSheaf.over U) ⟶ M) :
    (M.unitHomEquiv f).1 (op (Over.mk (𝟙 U))) =
      (f.val.app (op (Over.mk (𝟙 U))))
        (show ((SheafOfModules.unit (X.ringCatSheaf.over U)).val.obj
            (op (Over.mk (𝟙 U)))) from (1 : X.presheaf.obj (op U))) := by
  -- Proof comment: `unitHomEquiv` is defined by evaluating the unit morphism on the terminal
  -- section `1`.
  rfl

omit [MonoidalCategory ModX] in
/-- Helper for Lemma 20.55.1: on an object `W ⟶ U` of the slice, `localSectionMul` acts by scalar
multiplication with the restriction of the section from `U` to `W`. -/
private theorem localSectionMul_app_overMk_eq_smul
    (U W : Opens X) (i : W ⟶ U) (s : X.presheaf.obj (op U))
    (t : X.presheaf.obj (op W)) :
    ((SheafOfModules.localSectionMul X.sheaf 𝒪X U s).val.app (op (Over.mk i))) t =
      (X.presheaf.map i.op s) • t := by
  -- Proof comment: evaluating `localSectionMul` on `W ⟶ U` is definitionally scalar
  -- multiplication by the restricted section.
  rfl

omit [MonoidalCategory ModX] in
/-- Helper for Lemma 20.55.1: multiplication by a section `s` sends the terminal section `1` of
`𝒪_U` to `s`. -/
private theorem localSectionMul_applyTerminalOne
    (U : Opens X) (s : X.presheaf.obj (op U)) :
    ((SheafOfModules.localSectionMul X.sheaf 𝒪X U s).val.app (op (Over.mk (𝟙 U))))
      (show ((SheafOfModules.unit (X.ringCatSheaf.over U)).val.obj
          (op (Over.mk (𝟙 U)))) from (1 : X.presheaf.obj (op U))) =
    (show ((SheafOfModules.over 𝒪X U).val.obj (op (Over.mk (𝟙 U)))) from s) := by
  -- Proof comment: on the terminal object of the slice, `localSectionMul` is literal
  -- multiplication by `s`; applying it to `1` returns `s`.
  calc
    ((SheafOfModules.localSectionMul X.sheaf 𝒪X U s).val.app (op (Over.mk (𝟙 U))))
        (show ((SheafOfModules.unit (X.ringCatSheaf.over U)).val.obj
            (op (Over.mk (𝟙 U)))) from (1 : X.presheaf.obj (op U))) =
      (X.presheaf.map (𝟙 U).op s) • (1 : X.presheaf.obj (op U)) := by
        -- Proof comment: specialize the general slice-object formula to the terminal object
        -- `U ⟶ U`.
        simpa using
          localSectionMul_app_overMk_eq_smul (X := X) U U (𝟙 U) s
            (1 : X.presheaf.obj (op U))
    _ = s • (1 : X.presheaf.obj (op U)) := by
      -- Proof comment: the restriction of a section along the identity map is the section itself.
      have hmap :
          (X.presheaf.map (𝟙 U).op).hom = RingHom.id (X.presheaf.obj (op U)) := by
        simpa using congrArg CommRingCat.Hom.hom (X.presheaf.map_id (op U))
      have hrestrict : X.presheaf.map (𝟙 U).op s = s := by
        simpa [hmap] using congrArg (fun f ↦ f s) hmap
      rw [hrestrict]
    _ = s := by
      -- Proof comment: the scalar action of the ring on itself is multiplication, so `s • 1 = s`.
      simpa [smul_eq_mul]

omit [MonoidalCategory ModX] in
/-- Helper for Lemma 20.55.1: an endomorphism of `𝒪_U` is multiplication by the local section
obtained from its terminal value on the slice over `U`. -/
private theorem unitEndomorphism_eq_localSectionMul
    (U : Opens X)
    (φ : SheafOfModules.over 𝒪X U ⟶ SheafOfModules.over 𝒪X U) :
    let s : X.presheaf.obj (op U) :=
      RingedSpace.over_sections_equiv_evaluation (SheafOfModules.over 𝒪X U)
        ((SheafOfModules.over 𝒪X U).unitHomEquiv φ)
    SheafOfModules.localSectionMul X.sheaf 𝒪X U s = φ := by
  dsimp
  -- Proof comment: compare both morphisms through `unitHomEquiv`; after evaluating at the
  -- terminal object of the slice, the left-hand side is multiplication by `1`, hence the chosen
  -- section itself.
  apply (SheafOfModules.over 𝒪X U).unitHomEquiv.injective
  apply (RingedSpace.over_sections_equiv_evaluation (SheafOfModules.over 𝒪X U)).injective
  dsimp [RingedSpace.over_sections_equiv_evaluation]
  simpa using
    localSectionMul_applyTerminalOne (X := X) U
      ((φ.val.app (op (Over.mk (𝟙 U))))
        (show ((SheafOfModules.unit (X.ringCatSheaf.over U)).val.obj
            (op (Over.mk (𝟙 U)))) from (1 : X.presheaf.obj (op U))))

omit [MonoidalCategory ModX] in
/-- Helper for Lemma 20.55.1: a local trivialization `I |_ U ≅ 𝒪_U` yields a local generator of
the restricted ideal sheaf. -/
private theorem existsLocalGenerator_of_unitTrivialization
    (I : Subobject 𝒪X) {U : Opens X}
    (e : SheafOfModules.over I U ≅ SheafOfModules.over 𝒪X U) :
    ∃ s : X.presheaf.obj (op U),
      e.hom ≫ SheafOfModules.localSectionMul X.sheaf 𝒪X U s = I.arrow |_ U := by
  let φ : SheafOfModules.over 𝒪X U ⟶ SheafOfModules.over 𝒪X U :=
    e.inv ≫ I.arrow |_ U
  let s : X.presheaf.obj (op U) :=
    RingedSpace.over_sections_equiv_evaluation (SheafOfModules.over 𝒪X U)
      ((SheafOfModules.over 𝒪X U).unitHomEquiv φ)
  refine ⟨s, ?_⟩
  -- Proof comment: rewrite the transported inclusion as multiplication by its associated section,
  -- then cancel the local trivialization isomorphism.
  calc
    e.hom ≫ SheafOfModules.localSectionMul X.sheaf 𝒪X U s
        = e.hom ≫ φ := by
            rw [unitEndomorphism_eq_localSectionMul (X := X) U φ]
    _ = I.arrow |_ U := by
      simp [φ]

-- Proof sketch: by Lemma `17.25.4 (2)`, an invertible ideal sheaf on a ringed space with local
-- stalk rings is finite locally free of rank `1`. After shrinking around any point, choose a
-- rank-one trivialization of the ideal sheaf; transporting `I.arrow` into the structure sheaf
-- across this trivialization identifies it with multiplication by a local section. Since `I` is a
-- subobject, no extra monomorphism hypothesis is needed; regularity is then read off from the
-- local principal description.

/-- Lemma 20.55.1 (2): if all stalks `𝒪_{X, x}` are local rings, then every invertible
ideal sheaf of `𝒪_X` is locally principal and generated by a regular section. -/
@[stacks 0GT3]
theorem isLocallyPrincipalRegularIdeal_of_isInvertible_of_stalk_isLocalRing
    (I : Subobject 𝒪X)
    (hlocal : ∀ x : X, IsLocalRing (X.presheaf.stalk x))
    (hinvertible : IsInvertibleX (I : ModX)) :
    SatisfiesLocallyPrincipalRegularIdealCondition I := by
  let _ : IsInvertibleX (I : ModX) := hinvertible
  -- Proof comment: choose a rank-one trivialization around each point and transport `I.arrow`
  -- across it to multiplication by the corresponding local generator of `𝒪_U`.
  refine ⟨fun x ↦ ?_⟩
  have hfree :
      SheafOfModules.IsFiniteLocallyFreeOfRank 1 (I : ModX) :=
    isFiniteLocallyFreeOfRank_one_of_isInvertible_of_stalk_isLocalRing
      (X := X) hlocal (I : ModX)
  rcases hfree.exists_open_neighborhood_iso_free x with ⟨U, hxU, hU⟩
  rcases hU with ⟨eI⟩
  -- Proof comment: normalize the chosen free rank-one chart to a chart with the restricted
  -- structure sheaf via the canonical singleton-basis identification.
  rcases SheafOfModules.unit_over_iso_free_singleton (X := X) U with ⟨eUnit⟩
  let e : SheafOfModules.over I U ≅ SheafOfModules.over 𝒪X U := eI ≪≫ eUnit.symm
  rcases existsLocalGenerator_of_unitTrivialization (X := X) I e with ⟨s, hs⟩
  exact ⟨U, hxU, e, s, hs⟩

/-- If all stalks are local rings, invertibility of the ideal sheaf yields the local principal
regular ideal condition. -/
instance instIsLocallyPrincipalRegularIdealOfIsInvertibleOfStalkIsLocalRing
    (I : Subobject 𝒪X)
    (hlocal : ∀ x : X, IsLocalRing (X.presheaf.stalk x)) [IsInvertibleX (I : ModX)] :
    SatisfiesLocallyPrincipalRegularIdealCondition I :=
  isLocallyPrincipalRegularIdeal_of_isInvertible_of_stalk_isLocalRing I hlocal inferInstance

end InvertibleIdeal

end AlgebraicGeometry.RingedSpace
