import StacksProject_2024.Chap20.Lemma_20_45_4

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open CategoryTheory
open TopologicalSpace

noncomputable section

universe u

attribute [local instance] HasDerivedCategory.standard

/-
Domain-style sampling for Remark 20.45.5:
- primary domain: descent-style overlap comparisons for derived `\mathcal O_X`-module objects on
  a cover whose pairwise intersections are generated by smaller basis members of a ringed space;
- sampled owner declarations:
  `moduleDerivedOnOpen`,
  `derivedRestrictionBetweenOpens`,
  `derivedRestrictionBetweenOpensCompIso`,
  `OpenFamilyDerivedGluing`,
  `OpenFamilyDerivedGluing.ρ_comp`,
  `OpenFamilyDerivedGluing.existsUniqueIso`,
  `CategoryTheory.CommSq`;
- best owner abstraction: the source-facing owner remains `OpenFamilyDerivedGluing`, while the
  restriction-identification API already belongs to the Chapter 20 open-restriction owners from
  `Situation_20_45_3`; the remark itself should therefore stay as derived overlap API on that
  owner, under the weaker overlap-generation hypotheses from Lemma `20.45.4`, rather than being
  collapsed to the stronger basis owner `Opens.IsBasis`;
- primitive data: the local objects `glue.obj`, the basis restriction isomorphisms `glue.ρ`, and
  their cocycle law `glue.ρ_comp`;
- derived API: the canonical overlap isomorphism on `U ⊓ V`, its restriction squares on smaller
  basis opens, and the cocycle condition on triple intersections.

Layer triage:
- `source-facing`: the canonical overlap comparison extracted in Remark 20.45.5;
- `core/canonical`: `OpenFamilyDerivedGluing`, the Chapter 20 restriction functors on derived
  categories of open subspaces, and the square owner `CommSq`;
- `bridge/view`: restricting an overlap isomorphism from `U ⊓ V` to any `W ≤ U ⊓ V`.

This file therefore keeps the overlap comparison as derived API on the owner
`OpenFamilyDerivedGluing`, with the source-faithful overlap-generation hypotheses from
Lemma `20.45.4`, rather than packaging it into a parallel public structure or replacing the
compatibility diagrams by raw composite equalities.
-/

namespace AlgebraicGeometry.RingedSpace

section

variable {X : RingedSpace.{u}} {𝓑 : Set (Opens X.carrier)}

namespace OpenFamilyDerivedGluing

local notation "OpenX" => Opens X.carrier
local notation "DMod[" U "]" => moduleDerivedOnOpen X U
local notation "DRes≤[" h "]" => derivedRestrictionBetweenOpens X h
local notation "DResComp[" h₁ "," h₂ "]" => derivedRestrictionBetweenOpensCompIso X h₁ h₂

/-- Pairwise intersections of members of `𝓑` are generated by basis members contained in the
intersection. -/
abbrev OverlapGeneratedByBasis (X : RingedSpace.{u}) (𝓑 : Set (Opens X.carrier)) : Prop :=
  ∀ ⦃U V : Opens X.carrier⦄ (_ : U ∈ 𝓑) (_ : V ∈ 𝓑),
    U ⊓ V = sSup {W : Opens X.carrier | W ∈ 𝓑 ∧ W ≤ U ⊓ V}

variable
    (glue : OpenFamilyDerivedGluing X 𝓑)

/-- Restrict an isomorphism over `U ⊓ V` to a smaller open `W ≤ U ⊓ V`, identifying the two-step
restrictions with the direct restrictions from `U` and `V` to `W`. -/
def overlapIsoRestrict
    {U V W : OpenX}
    {A : DMod[U]} {B : DMod[V]}
    (e : (DRes≤[inf_le_left]).obj A ≅ (DRes≤[inf_le_right]).obj B)
    (hW : W ≤ U ⊓ V) :
    (DRes≤[hW.trans inf_le_left]).obj A ≅ (DRes≤[hW.trans inf_le_right]).obj B :=
  ((DResComp[hW, inf_le_left]).app A).symm ≪≫
    (DRes≤[hW]).mapIso e ≪≫
      (DResComp[hW, inf_le_right]).app B

/-- An overlap comparison over `U ⊓ V` is compatible with the gluing data if, after restriction to
every basis open inside `U ⊓ V`, it identifies the two prescribed transition maps. -/
def IsOverlapCompatible
    {U V : OpenX} (hU : U ∈ 𝓑) (hV : V ∈ 𝓑)
    (e : (DRes≤[inf_le_left]).obj (glue.obj U hU) ≅
      (DRes≤[inf_le_right]).obj (glue.obj V hV)) : Prop :=
  ∀ ⦃U' : OpenX⦄ (hU' : U' ∈ 𝓑) (hU'UV : U' ≤ U ⊓ V),
    CommSq
      (overlapIsoRestrict e hU'UV).hom
      (glue.ρ U U' hU hU' (hU'UV.trans inf_le_left)).hom
      (glue.ρ V U' hV hU' (hU'UV.trans inf_le_right)).hom
      (𝟙 (glue.obj U' hU'))

-- Proof sketch: for fixed `U, V ∈ 𝓑`, let `𝓑'` be the subset of members of `𝓑` contained in
-- `U ⊓ V`. The overlap-generation hypothesis implies that `𝓑'` covers `U ⊓ V` and again
-- generates pairwise intersections there, so Lemma `20.45.4` applies to the restricted system on
-- the ringed space `U ⊓ V`. The two restricted objects `K_U|_{U ⊓ V}` and `K_V|_{U ⊓ V}` are
-- both solutions, hence the lemma yields a unique compatible overlap isomorphism.
/-- The restrictions of `K_U` and `K_V` to `U ⊓ V` admit a unique overlap comparison compatible
with all smaller basis opens inside `U ⊓ V`, assuming pairwise intersections in `𝓑` are generated
by basis members contained in the intersection. -/
theorem existsUniqueOverlapIso
    (hoverlap : OverlapGeneratedByBasis X 𝓑)
    (hneg : NegativeSelfExtVanishing glue)
    {U V : OpenX} (hU : U ∈ 𝓑) (hV : V ∈ 𝓑) :
    ∃! e :
        (DRes≤[inf_le_left]).obj (glue.obj U hU) ≅
          (DRes≤[inf_le_right]).obj (glue.obj V hV),
      glue.IsOverlapCompatible hU hV e := by
  sorry

/-- Unpack one restriction square from a basis-compatible overlap comparison. -/
theorem IsOverlapCompatible.commSq
    {U V U' : OpenX}
    {hU : U ∈ 𝓑} {hV : V ∈ 𝓑}
    {e : (DRes≤[inf_le_left]).obj (glue.obj U hU) ≅
      (DRes≤[inf_le_right]).obj (glue.obj V hV)}
    (he : glue.IsOverlapCompatible hU hV e)
    (hU' : U' ∈ 𝓑) (hU'UV : U' ≤ U ⊓ V) :
    CommSq
      (overlapIsoRestrict e hU'UV).hom
      (glue.ρ U U' hU hU' (hU'UV.trans inf_le_left)).hom
      (glue.ρ V U' hV hU' (hU'UV.trans inf_le_right)).hom
      (𝟙 (glue.obj U' hU')) :=
  he hU' hU'UV

/-- Equational form of the restriction-square compatibility for an overlap comparison. -/
theorem IsOverlapCompatible.w
    {U V U' : OpenX}
    {hU : U ∈ 𝓑} {hV : V ∈ 𝓑}
    {e : (DRes≤[inf_le_left]).obj (glue.obj U hU) ≅
      (DRes≤[inf_le_right]).obj (glue.obj V hV)}
    (he : glue.IsOverlapCompatible hU hV e)
    (hU' : U' ∈ 𝓑) (hU'UV : U' ≤ U ⊓ V) :
    (overlapIsoRestrict e hU'UV).hom ≫
        (glue.ρ V U' hV hU' (hU'UV.trans inf_le_right)).hom =
      (glue.ρ U U' hU hU' (hU'UV.trans inf_le_left)).hom ≫
        (𝟙 (glue.obj U' hU')) := by
  simpa using (he hU' hU'UV).w

/-- Compatible overlap comparisons over `U ⊓ V` are unique. -/
theorem eq_of_isOverlapCompatible
    (hoverlap : OverlapGeneratedByBasis X 𝓑)
    (hneg : NegativeSelfExtVanishing glue)
    {U V : OpenX} (hU : U ∈ 𝓑) (hV : V ∈ 𝓑)
    {e e' : (DRes≤[inf_le_left]).obj (glue.obj U hU) ≅
      (DRes≤[inf_le_right]).obj (glue.obj V hV)}
    (he : glue.IsOverlapCompatible hU hV e)
    (he' : glue.IsOverlapCompatible hU hV e') :
    e = e' := by
  rcases glue.existsUniqueOverlapIso hoverlap hneg hU hV with ⟨_, -, huniq⟩
  exact (huniq e he).trans (huniq e' he').symm

-- Proof sketch: restrict the three canonical overlap isomorphisms to `U ⊓ V ⊓ W`. Both the direct
-- map `ρ_{U,W}` and the composite `ρ_{U,V}` followed by `ρ_{V,W}` satisfy the same compatibility
-- with all basis opens contained in the triple intersection, so uniqueness of the canonical
-- overlap isomorphism identifies them.
/-- Remark 20.45.5: any overlap comparisons compatible with the datum satisfy the usual cocycle
condition on triple intersections. -/
@[stacks 0D69]
theorem overlapCompatible_cocycle
    (hoverlap : OverlapGeneratedByBasis X 𝓑)
    (hneg : NegativeSelfExtVanishing glue)
    {U V W : OpenX}
    (hU : U ∈ 𝓑) (hV : V ∈ 𝓑) (hW : W ∈ 𝓑)
    {eUW : (DRes≤[inf_le_left]).obj (glue.obj U hU) ≅
      (DRes≤[inf_le_right]).obj (glue.obj W hW)}
    {eUV : (DRes≤[inf_le_left]).obj (glue.obj U hU) ≅
      (DRes≤[inf_le_right]).obj (glue.obj V hV)}
    {eVW : (DRes≤[inf_le_left]).obj (glue.obj V hV) ≅
      (DRes≤[inf_le_right]).obj (glue.obj W hW)}
    (heUW : glue.IsOverlapCompatible hU hW eUW)
    (heUV : glue.IsOverlapCompatible hU hV eUV)
    (heVW : glue.IsOverlapCompatible hV hW eVW) :
      overlapIsoRestrict eUW
        (le_inf (inf_le_left.trans inf_le_left) inf_le_right) =
        overlapIsoRestrict eUV inf_le_left ≪≫
          overlapIsoRestrict eVW
          (le_inf (inf_le_left.trans inf_le_right) inf_le_right) := sorry

end OpenFamilyDerivedGluing

end

end AlgebraicGeometry.RingedSpace
