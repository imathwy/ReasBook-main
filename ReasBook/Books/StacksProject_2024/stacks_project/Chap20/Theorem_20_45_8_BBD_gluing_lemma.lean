open AlgebraicGeometry
open CategoryTheory
open TopologicalSpace

noncomputable section

universe u

attribute [local instance] HasDerivedCategory.standard

namespace AlgebraicGeometry.RingedSpace

section

variable {X : RingedSpace.{u}} {𝓑 : Set (Opens X.carrier)}

namespace OpenFamilyDerivedGluing

/- Domain-style sampling for Theorem 20.45.8 (BBD gluing lemma):
- primary domain: gluing derived objects on a basis of opens of a ringed space, with existence
  of an ambient realization and uniqueness measured by compatible isomorphisms between explicit
  realization identifications;
- sampled owner declarations:
  `OpenFamilyDerivedGluing.RealizationIso`,
  `OpenFamilyDerivedGluing.IsRealization`,
  `OpenFamilyDerivedGluing.Realizes`,
  `OpenFamilyDerivedGluing.IsCompatibleIso`,
  `OpenFamilyDerivedGluing.existsUniqueIso`,
  `OpenFamilyDerivedGluing.NegativeSelfExtVanishing`,
  `Opens.IsBasis`;
- best owner abstraction:
  `source-facing`: the basis-cover BBD gluing theorem stated below;
  `core/canonical`: the owner `OpenFamilyDerivedGluing` together with the realization predicate
    `Realizes`, the compatibility predicate `IsCompatibleIso`, the derived uniqueness theorem
    `existsUniqueIso`, and the basis owner `Opens.IsBasis`;
  `bridge/view`: the passage from local basis data to a global realization.
- primitive data: the gluing datum and the basis/negative-Ext hypotheses;
- derived API: existence of a realizing ambient derived object and uniqueness up to a unique
  compatible isomorphism between any two explicit realizations.

Source/core/bridge triage:
- `source-facing`: the BBD gluing theorem for basis-indexed local derived objects;
- `core/canonical`: `OpenFamilyDerivedGluing.Realizes`,
  `OpenFamilyDerivedGluing.IsCompatibleIso`, and `OpenFamilyDerivedGluing.existsUniqueIso`;
- `bridge/view`: the compatibility between a global object and the prescribed basiswise local
  objects.
-/

local notation "DModX" => ModuleDerived X

-- Proof sketch: obtain a global derived object whose restrictions recover the prescribed local
-- data, record those restriction identifications as realization data, and then invoke the
-- canonical uniqueness theorem `OpenFamilyDerivedGluing.existsUniqueIso` for the uniqueness
-- clause.
/-- Theorem 20.45.8 (BBD gluing lemma): if the basis opens in `𝓑` cover `X`, pairwise
intersections are generated by basis opens contained in the intersection, and the local objects of
the gluing datum have vanishing negative self-Ext groups, then there exists an ambient derived
realization and any two realizations are uniquely isomorphic in a compatible way. -/
@[stacks 0D6C]
theorem exists_realization_uniqueUpToUniqueIso
    (glue : OpenFamilyDerivedGluing X 𝓑)
    (h𝓑 : Opens.IsBasis 𝓑)
    (hneg : NegativeSelfExtVanishing glue) :
    (∃ K : DModX, glue.Realizes K) ∧
      ∀ (K L : DModX)
        (isoK : glue.RealizationIso K) (hisoK : glue.IsRealization K isoK)
        (isoL : glue.RealizationIso L) (hisoL : glue.IsRealization L isoL),
        ∃! e : K ≅ L, glue.IsCompatibleIso isoK isoL e := by
  sorry

/-- Under the BBD gluing hypotheses on the basis `𝓑`, a realizing ambient derived object
exists. -/
theorem exists_realization
    (glue : OpenFamilyDerivedGluing X 𝓑)
    (h𝓑 : Opens.IsBasis 𝓑)
    (hneg : NegativeSelfExtVanishing glue) :
    ∃ K : DModX, glue.Realizes K :=
  (exists_realization_uniqueUpToUniqueIso glue h𝓑 hneg).1

/-- Under the BBD gluing hypotheses on the basis `𝓑`, any two explicit realizations are
uniquely isomorphic in a way compatible with their chosen basiswise identification data. -/
theorem existsUniqueIso_of_isBasis
    (glue : OpenFamilyDerivedGluing X 𝓑)
    (h𝓑 : Opens.IsBasis 𝓑)
    (hneg : NegativeSelfExtVanishing glue)
    (K L : DModX)
    (isoK : glue.RealizationIso K) (hisoK : glue.IsRealization K isoK)
    (isoL : glue.RealizationIso L) (hisoL : glue.IsRealization L isoL) :
    ∃! e : K ≅ L, glue.IsCompatibleIso isoK isoL e :=
  (exists_realization_uniqueUpToUniqueIso glue h𝓑 hneg).2 K L isoK hisoK isoL hisoL

end OpenFamilyDerivedGluing

end

end AlgebraicGeometry.RingedSpace
