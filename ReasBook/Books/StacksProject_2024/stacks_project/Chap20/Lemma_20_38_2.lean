import StacksProject_2024.stacks_project.Chap07.HasEnoughObjectsWithProperty
import StacksProject_2024.stacks_project.Chap20.RingedSpaceOpensModuleCategory
import StacksProject_2024.stacks_project.Chap20.«20_11_0_1»
import StacksProject_2024.stacks_project.Chap21.Lemma_21_24_2

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.SequentialInverseSystem
open Opposite
open TopologicalSpace
open AlgebraicGeometry
open RingedSite.Hom

noncomputable section

universe u v

namespace AlgebraicGeometry.RingedSpace

section

variable (X : RingedSpace.{u})
variable [IsGrothendieckAbelian.{v} (RingedSpace.Modules X)]

local notation "Xsite" => opensRingedSite X
local notation "CpxX" => CochainComplex X.Modules ℤ
local notation "HMod" => HomologicalComplex.homologyFunctor X.Modules (ComplexShape.up ℤ)

/-- For a tower of complexes and a fixed open `U`, this is the inverse system of degree-`i`
sections `n ↦ ℱₙⁱ(U)`. -/
abbrev complexSectionDegreeInverseSystem
    (ℱ : ℕᵒᵖ ⥤ CpxX) (U : Opens X.carrier) (i : ℤ) :
    SequentialInverseSystem AddCommGrpCat.{u} :=
  RingedSite.Hom.complexSectionDegreeInverseSystem Xsite ℱ U i

/-- For a tower of complexes and a fixed open `U`, this is the inverse system of cohomology groups
`n ↦ H^i(ℱₙ(U))`. -/
abbrev complexSectionCohomologyInverseSystem
    (ℱ : ℕᵒᵖ ⥤ CpxX) (U : Opens X.carrier) (i : ℤ) :
    SequentialInverseSystem AddCommGrpCat.{u} :=
  RingedSite.Hom.complexSectionCohomologyInverseSystem Xsite ℱ U i

namespace Opens.IsBasis

/-- Helper for Lemma 20.38.2: the sieve generated by basis opens contained in `U` is a covering
family of `U` on the opens ringed site of `X`. -/
private theorem basisSubtypeCover
    {𝓑 : Set (Opens X.carrier)}
    (h𝓑 : Opens.IsBasis 𝓑)
    (U : Opens X.carrier) :
    Xsite.siteTopology.Cover U := by
  let ι : Type u := {V : Opens X.carrier // V ∈ 𝓑 ∧ V ≤ U}
  let Uᵢ : ι → Opens X.carrier := fun i ↦ i.1
  let π : (i : ι) → Uᵢ i ⟶ U := fun i ↦ homOfLE i.2.2
  refine ⟨Sieve.ofArrows Uᵢ π, ?_⟩
  intro z hz
  obtain ⟨V, hV, hzV, hVU⟩ := Opens.isBasis_iff_nbhd.mp h𝓑 hz
  exact ⟨V, homOfLE hVU, Sieve.ofArrows_mk Uᵢ π ⟨V, hV, hVU⟩, hzV⟩

/-- Helper for Lemma 20.38.2: a basis of opens yields enough objects on the opens ringed site of
`X`. -/
private theorem hasEnoughObjectsWithProperty
    {𝓑 : Set (Opens X.carrier)}
    (h𝓑 : Opens.IsBasis 𝓑) :
    Xsite.siteTopology.HasEnoughObjectsWithProperty (fun U : Opens X.carrier ↦ U ∈ 𝓑) := by
  intro U
  let ι : Type u := {V : Opens X.carrier // V ∈ 𝓑 ∧ V ≤ U}
  let Uᵢ : ι → Opens X.carrier := fun i ↦ i.1
  let π : (i : ι) → Uᵢ i ⟶ U := fun i ↦ homOfLE i.2.2
  let S : Xsite.siteTopology.Cover U := basisSubtypeCover (X := X) h𝓑 U
  refine ⟨S, ?_⟩
  intro I
  rcases (Sieve.mem_ofArrows_iff Uᵢ π I.f).1 I.hf with ⟨i, _, _⟩
  exact i.2.1

/-- Helper for Lemma 20.38.2: the basiswise degree-`m - 2` `R¹ lim` vanishing hypothesis matches
the opens-site inverse system used by the Chapter 21 comparison theorem. -/
private theorem basiswiseDegreeMinusTwoVanishing
    {𝓑 : Set (Opens X.carrier)}
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ)
    (hdegree_m_sub_two :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionDegreeInverseSystem X ℱ U (m - 2)).firstDerivedLimit)) :
    ∀ U : Opens X.carrier, U ∈ 𝓑 →
      IsZero ((RingedSite.Hom.complexSectionDegreeInverseSystem Xsite ℱ U (m - 2)).firstDerivedLimit) := by
  intro U hU
  simpa [complexSectionDegreeInverseSystem] using hdegree_m_sub_two hU

/-- Helper for Lemma 20.38.2: the basiswise degree-`m - 1` `R¹ lim` vanishing hypothesis matches
the opens-site inverse system used by the Chapter 21 comparison theorem. -/
private theorem basiswiseDegreeMinusOneVanishing
    {𝓑 : Set (Opens X.carrier)}
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ)
    (hdegree_m_sub_one :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionDegreeInverseSystem X ℱ U (m - 1)).firstDerivedLimit)) :
    ∀ U : Opens X.carrier, U ∈ 𝓑 →
      IsZero ((RingedSite.Hom.complexSectionDegreeInverseSystem Xsite ℱ U (m - 1)).firstDerivedLimit) := by
  intro U hU
  simpa [complexSectionDegreeInverseSystem] using hdegree_m_sub_one hU

/-- Helper for Lemma 20.38.2: the basiswise `H^(m - 1)` `R¹ lim` vanishing hypothesis matches the
opens-site inverse system used by the Chapter 21 comparison theorem. -/
private theorem basiswiseCohomologyMinusOneVanishing
    {𝓑 : Set (Opens X.carrier)}
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ)
    (hcohomology_m_sub_one :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionCohomologyInverseSystem X ℱ U (m - 1)).firstDerivedLimit)) :
    ∀ U : Opens X.carrier, U ∈ 𝓑 →
      IsZero
        ((RingedSite.Hom.complexSectionCohomologyInverseSystem Xsite ℱ U (m - 1)).firstDerivedLimit) := by
  intro U hU
  simpa [complexSectionCohomologyInverseSystem] using hcohomology_m_sub_one hU

/-- Helper for Lemma 20.38.2: the basiswise eventual constancy hypothesis matches the opens-site
cohomology tower used by the Chapter 21 projection theorem. -/
private theorem basiswiseCohomologyEventualConstancy
    {𝓑 : Set (Opens X.carrier)}
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ) (n₀ : ℕ)
    (heventually_constant :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 → ∀ n : ℕ, ∀ hn : n₀ ≤ n,
        IsIso ((complexSectionCohomologyInverseSystem X ℱ U m).transitionMap hn)) :
    ∀ U : Opens X.carrier, U ∈ 𝓑 → ∀ n : ℕ, ∀ hn : n₀ ≤ n,
      IsIso ((RingedSite.Hom.complexSectionCohomologyInverseSystem Xsite ℱ U m).transitionMap hn) := by
  intro U hU n hn
  simpa [complexSectionCohomologyInverseSystem] using heventually_constant hU n hn

/-- Helper for Lemma 20.38.2: after forgetting to abelian sheaves, the comparison
`H^m(limₙ ℱₙ^•) ⟶ limₙ H^m(ℱₙ^•)` differs from the opens-site comparison only by the standard
limit-preservation isomorphism on the target. -/
private theorem moduleUnderlyingSheaf_map_limit_post_comp
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ) :
    (moduleUnderlyingSheaf X).map (limit.post ℱ (HMod m)) ≫
        (preservesLimitIso (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m)).hom =
      limit.post ℱ ((HMod m) ⋙ moduleUnderlyingSheaf X) := by
  apply limit.hom_ext
  intro j
  calc
    (moduleUnderlyingSheaf X).map (limit.post ℱ (HMod m)) ≫
        (preservesLimitIso (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m)).hom ≫
          limit.π (ℱ ⋙ HMod m ⋙ moduleUnderlyingSheaf X) j =
      (moduleUnderlyingSheaf X).map (limit.post ℱ (HMod m)) ≫
        (moduleUnderlyingSheaf X).map (limit.π (ℱ ⋙ HMod m) j) := by
          simpa [Category.assoc] using
            congrArg
              (fun k ↦ (moduleUnderlyingSheaf X).map (limit.post ℱ (HMod m)) ≫ k)
              (preservesLimitIso_hom_π (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m) j)
    _ =
      (moduleUnderlyingSheaf X).map (limit.post ℱ (HMod m) ≫ limit.π (ℱ ⋙ HMod m) j) := by
        rw [← Functor.map_comp, Category.assoc]
    _ =
      (moduleUnderlyingSheaf X).map (HomologicalComplex.homologyMap (limit.π ℱ j) m) := by
        simpa [HMod] using
          congrArg
            (fun k ↦ (moduleUnderlyingSheaf X).map k)
            (limit.post_π (F := ℱ) (G := HMod m) j)
    _ =
      limit.post ℱ ((HMod m) ⋙ moduleUnderlyingSheaf X) ≫
        limit.π (ℱ ⋙ HMod m ⋙ moduleUnderlyingSheaf X) j := by
          simpa [HMod, Category.assoc] using
            (limit.post_π (F := ℱ) (G := (HMod m) ⋙ moduleUnderlyingSheaf X) j).symm

/-- Helper for Lemma 20.38.2: after forgetting to abelian sheaves, the stage projection
`limₙ H^m(ℱₙ^•) ⟶ H^m(ℱₙ₀^•)` differs from the opens-site projection only by the standard
limit-preservation isomorphism on the source. -/
private theorem moduleUnderlyingSheaf_map_limit_π_comp
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ) (j : ℕᵒᵖ) :
    (moduleUnderlyingSheaf X).map (limit.π (ℱ ⋙ HMod m) j) ≫
        (preservesLimitIso (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m)).hom =
      limit.π (ℱ ⋙ HMod m ⋙ moduleUnderlyingSheaf X) j := by
  simpa [Category.assoc] using
    (preservesLimitIso_hom_π (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m) j)

/-- Companion for Lemma 20.38.2: under the basiswise `R¹ lim` vanishing hypotheses, the canonical
comparison `H^m(limₙ ℱₙ^•) ⟶ limₙ H^m(ℱₙ^•)` is an isomorphism of sheaves of `𝒪_X`-modules. -/
@[stacks 08BY]
theorem cohomologySheaf_limitComparison_isIso
    {𝓑 : Set (Opens X.carrier)}
    (h𝓑 : Opens.IsBasis 𝓑)
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ)
    (hdegree_m_sub_two :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionDegreeInverseSystem X ℱ U (m - 2)).firstDerivedLimit))
    (hdegree_m_sub_one :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionDegreeInverseSystem X ℱ U (m - 1)).firstDerivedLimit))
    (hcohomology_m_sub_one :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionCohomologyInverseSystem X ℱ U (m - 1)).firstDerivedLimit)) :
    IsIso (limit.post ℱ (HMod m)) := by
  let hcover := hasEnoughObjectsWithProperty (X := X) h𝓑
  have hUnderComp :
      IsIso ((moduleUnderlyingSheaf X).map (limit.post ℱ (HMod m)) ≫
        (preservesLimitIso (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m)).hom) := by
    rw [moduleUnderlyingSheaf_map_limit_post_comp (X := X) (ℱ := ℱ) (m := m)]
    simpa [HMod] using
      (cohomologySheafLimitComparison_isIso_of_basiswise_vanishing_r1lim
        (X := Xsite) (F := ℱ) (m := m) 𝓑 hcover
        (basiswiseDegreeMinusTwoVanishing (X := X) (𝓑 := 𝓑) ℱ m hdegree_m_sub_two)
        (basiswiseDegreeMinusOneVanishing (X := X) (𝓑 := 𝓑) ℱ m hdegree_m_sub_one)
        (basiswiseCohomologyMinusOneVanishing
          (X := X) (𝓑 := 𝓑) ℱ m hcohomology_m_sub_one))
  letI : IsIso ((moduleUnderlyingSheaf X).map (limit.post ℱ (HMod m))) :=
    (isIso_comp_right_iff
      ((moduleUnderlyingSheaf X).map (limit.post ℱ (HMod m)))
      ((preservesLimitIso (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m)).hom)).1 hUnderComp
  -- Proof comment: the Chapter 21 opens-site theorem proves the underlying additive-sheaf
  -- comparison is invertible, and `moduleUnderlyingSheaf X` reflects isomorphisms.
  exact isIso_of_reflects_iso (limit.post ℱ (HMod m)) (moduleUnderlyingSheaf X)

/-- Companion for Lemma 20.38.2: if the basiswise cohomology tower is constant for `n ≥ n₀`, then
the projection `limₙ H^m(ℱₙ^•) ⟶ H^m(ℱₙ₀^•)` is an isomorphism of sheaves of `𝒪_X`-modules. -/
@[stacks 08BY]
theorem cohomologySheaf_eventualProjection_isIso
    {𝓑 : Set (Opens X.carrier)}
    (h𝓑 : Opens.IsBasis 𝓑)
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ) (n₀ : ℕ)
    (heventually_constant :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 → ∀ n : ℕ, ∀ hn : n₀ ≤ n,
        IsIso ((complexSectionCohomologyInverseSystem X ℱ U m).transitionMap hn)) :
    IsIso (limit.π (ℱ ⋙ HMod m) (op n₀)) := by
  let hcover := hasEnoughObjectsWithProperty (X := X) h𝓑
  have hUnderComp :
      IsIso ((moduleUnderlyingSheaf X).map (limit.π (ℱ ⋙ HMod m) (op n₀)) ≫
        (preservesLimitIso (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m)).hom) := by
    rw [moduleUnderlyingSheaf_map_limit_π_comp (X := X) (ℱ := ℱ) (m := m) (j := op n₀)]
    simpa [HMod] using
      (cohomologySheafLimitProjection_isIso_of_basiswise_eventually_constant
        (X := Xsite) (F := ℱ) (m := m) 𝓑 n₀ hcover
        (basiswiseCohomologyEventualConstancy
          (X := X) (𝓑 := 𝓑) ℱ m n₀ heventually_constant))
  letI : IsIso ((moduleUnderlyingSheaf X).map (limit.π (ℱ ⋙ HMod m) (op n₀))) :=
    (isIso_comp_right_iff
      ((moduleUnderlyingSheaf X).map (limit.π (ℱ ⋙ HMod m) (op n₀)))
      ((preservesLimitIso (moduleUnderlyingSheaf X) (ℱ ⋙ HMod m)).hom)).1 hUnderComp
  -- Proof comment: as above, invertibility is proved on the underlying additive sheaves and then
  -- reflected back to sheaves of `𝒪_X`-modules.
  exact isIso_of_reflects_iso (limit.π (ℱ ⋙ HMod m) (op n₀)) (moduleUnderlyingSheaf X)

/-- Companion for Lemma 20.38.2: under the basiswise `R¹ lim` vanishing hypotheses and eventual
constancy, the canonical map `H^m(limₙ ℱₙ^•) ⟶ H^m(ℱₙ₀^•)` is an isomorphism of sheaves of
`𝒪_X`-modules.
-/
@[stacks 08BY]
theorem cohomologySheaf_limitToStage_isIso
    {𝓑 : Set (Opens X.carrier)}
    (h𝓑 : Opens.IsBasis 𝓑)
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ) (n₀ : ℕ)
    (hdegree_m_sub_two :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionDegreeInverseSystem X ℱ U (m - 2)).firstDerivedLimit))
    (hdegree_m_sub_one :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionDegreeInverseSystem X ℱ U (m - 1)).firstDerivedLimit))
    (hcohomology_m_sub_one :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionCohomologyInverseSystem X ℱ U (m - 1)).firstDerivedLimit))
    (heventually_constant :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 → ∀ n : ℕ, ∀ hn : n₀ ≤ n,
        IsIso ((complexSectionCohomologyInverseSystem X ℱ U m).transitionMap hn)) :
    IsIso
      (limit.post ℱ (HMod m) ≫
        limit.π (ℱ ⋙ HMod m) (op n₀)) := by
  letI : IsIso (limit.post ℱ (HMod m)) :=
    cohomologySheaf_limitComparison_isIso X h𝓑 ℱ m
      hdegree_m_sub_two hdegree_m_sub_one hcohomology_m_sub_one
  letI : IsIso (limit.π (ℱ ⋙ HMod m) (op n₀)) :=
    cohomologySheaf_eventualProjection_isIso X h𝓑 ℱ m n₀ heventually_constant
  infer_instance

/-- Lemma 20.38.2: let `(X, 𝒪_X)` be a ringed space and let `(ℱₙ^•)ₙ` be an inverse system of
complexes of `𝒪_X`-modules. Assume `𝓑` is a basis of open subsets of `X` such that for each
`U ∈ 𝓑` the inverse systems `n ↦ ℱₙ^(m - 2)(U)`, `n ↦ ℱₙ^(m - 1)(U)`, and
`n ↦ H^(m - 1)(ℱₙ(U))` have vanishing `R¹ lim`, and `n ↦ H^m(ℱₙ(U))` is constant for `n ≥ n₀`.
Then, for the termwise inverse limit complex `ℱ^• = limₙ ℱₙ^•`, the canonical maps
`H^m(ℱ^•) ⟶ limₙ H^m(ℱₙ^•) ⟶ H^m(ℱₙ₀^•)` are isomorphisms of sheaves of `𝒪_X`-modules on `X`.
-/
@[stacks 08BY]
theorem cohomologySheaf_limitComparison_and_eventualProjection_isIso
    {𝓑 : Set (Opens X.carrier)}
    (h𝓑 : Opens.IsBasis 𝓑)
    (ℱ : ℕᵒᵖ ⥤ CpxX) (m : ℤ) (n₀ : ℕ)
    (hdegree_m_sub_two :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionDegreeInverseSystem X ℱ U (m - 2)).firstDerivedLimit))
    (hdegree_m_sub_one :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionDegreeInverseSystem X ℱ U (m - 1)).firstDerivedLimit))
    (hcohomology_m_sub_one :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 →
        IsZero ((complexSectionCohomologyInverseSystem X ℱ U (m - 1)).firstDerivedLimit))
    (heventually_constant :
      ∀ ⦃U : Opens X.carrier⦄, U ∈ 𝓑 → ∀ n : ℕ, ∀ hn : n₀ ≤ n,
        IsIso ((complexSectionCohomologyInverseSystem X ℱ U m).transitionMap hn)) :
    IsIso (limit.post ℱ (HMod m)) ∧
      IsIso (limit.π (ℱ ⋙ HMod m) (op n₀)) := by
  constructor
  · exact cohomologySheaf_limitComparison_isIso X h𝓑 ℱ m
      hdegree_m_sub_two hdegree_m_sub_one hcohomology_m_sub_one
  · exact cohomologySheaf_eventualProjection_isIso X h𝓑 ℱ m n₀
      heventually_constant

end Opens.IsBasis

end

end AlgebraicGeometry.RingedSpace
