noncomputable section

universe u

namespace SheafOfModules.RingedSite

section

variable {C : Type u} [Category.{u} C] [HasBinaryProducts C] {J : GrothendieckTopology C}
variable (𝒪 : Sheaf J CommRingCat.{u})
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [J.HasSheafCompose (forget₂ RingCat AddCommGrpCat.{u})]

local notation "Mod(" 𝒪 ")" => ringedSiteModuleCategory J 𝒪

/- Domain-style sampling for Lemma 21.17.10:
- primary domain: upper-truncation resolution towers of complexes of `𝒪`-modules on a
  ringed site, built from the Chapter 13 owner `UpperTruncationResolutionTower` and an
  object-property input;
- sampled owner declarations:
  `ringedSiteModuleCategory`,
  `UpperTruncationResolutionTower`,
  `ObjectProperty.HasEpiCover`,
  `exists_epi_from_coproduct_localizedStructureModuleExtensionByZero`;
- best owner abstraction: the core owner is
  `UpperTruncationResolutionTower (isCoproductOfLocalizedStructureModules 𝒪) 𝒢`, while the local
  source-facing input is only the object property generated by coproducts of the canonical objects
  `j![𝒪, U]`;
- primitive-vs-derived split:
  primitive data: the object property `isCoproductOfLocalizedStructureModules 𝒪`;
  derived API: its `ContainsZero`, `IsClosedUnderFiniteCoproducts`, and `HasEpiCover` instances,
    followed by the upper-truncation existence theorem. -/

/-- The object property on `Mod(𝒪)` saying that a module is a direct sum, equivalently a
categorical coproduct, of modules of the canonical form `j![𝒪, U]`. -/
def isCoproductOfLocalizedStructureModules : ObjectProperty (Mod(𝒪)) :=
  fun ℱ ↦ ∃ (I : Type u) (U : I → C),
    Nonempty (ℱ ≅ ∐ fun i : I ↦ j![𝒪, (U i)])

/-- The zero `𝒪`-module is the empty coproduct of localized structure modules. -/
instance isCoproductOfLocalizedStructureModules_containsZero :
    (isCoproductOfLocalizedStructureModules 𝒪).ContainsZero := by
  let F : Discrete PEmpty ⥤ Mod(𝒪) := Discrete.functor (fun i : PEmpty ↦ j![𝒪, (PEmpty.elim i)])
  -- Use the empty coproduct itself as the chosen zero object in the property.
  refine ⟨colimit F, ?_, ?_⟩
  · -- The coproduct over the empty index type is initial, hence zero in the abelian category.
    refine (IsInitial.ofIso initialIsInitial ?_).isZero
    let e :
        F ≅ (Functor.const (Discrete PEmpty)).obj (⊥_ Mod(𝒪)) :=
      NatIso.ofComponents (fun i ↦ PEmpty.elim i.as)
    exact colimitConstInitial.symm ≪≫ (HasColimit.isoOfNatIso e).symm
  · refine ⟨PEmpty, PEmpty.elim, ?_⟩
    simpa [F] using (show Nonempty (colimit F ≅ colimit F) from ⟨Iso.refl _⟩)

/-- Helper for Lemma 21.17.10: being a coproduct of localized structure modules is stable under
isomorphisms. -/
private instance isCoproductOfLocalizedStructureModules_isClosedUnderIsomorphisms :
    (isCoproductOfLocalizedStructureModules 𝒪).IsClosedUnderIsomorphisms where
  of_iso e hX := by
    -- Transport the chosen coproduct presentation across the ambient isomorphism.
    rcases hX with ⟨I, U, ⟨hU⟩⟩
    exact ⟨I, U, ⟨e.symm ≪≫ hU⟩⟩

/-- Helper for Lemma 21.17.10: present the binary coproduct of two chosen coproducts as one
explicit cocone indexed by the disjoint union `I₁ ⊕ I₂`. -/
private def localizedStructureModule_sumIndexCofan
    {I₁ I₂ : Type u} (U₁ : I₁ → C) (U₂ : I₂ → C) :
    Cofan (fun k : I₁ ⊕ I₂ ↦ j![𝒪, (Sum.elim U₁ U₂ k)]) :=
  Cofan.mk
    ((∐ fun i : I₁ ↦ j![𝒪, (U₁ i)]) ⨿ (∐ fun j : I₂ ↦ j![𝒪, (U₂ j)]))
    (fun k =>
      match k with
      | Sum.inl i => colimit.ι (Discrete.functor (fun i : I₁ ↦ j![𝒪, (U₁ i)])) ⟨i⟩ ≫ coprod.inl
      | Sum.inr j => colimit.ι (Discrete.functor (fun j : I₂ ↦ j![𝒪, (U₂ j)])) ⟨j⟩ ≫ coprod.inr)

/-- Helper for Lemma 21.17.10: the explicit sum-indexed cocone is colimiting by the universal
property of the two separate coproducts and the ambient binary coproduct. -/
private lemma localizedStructureModule_sumIndexCofanIsColimit
    {I₁ I₂ : Type u} (U₁ : I₁ → C) (U₂ : I₂ → C) :
    IsColimit (localizedStructureModule_sumIndexCofan (𝒪 := 𝒪) U₁ U₂) := by
  let c := localizedStructureModule_sumIndexCofan (𝒪 := 𝒪) U₁ U₂
  refine mkCofanColimit c
    (fun s ↦
      coprod.desc
        (colimit.desc (Discrete.functor (fun i : I₁ ↦ j![𝒪, (U₁ i)]))
          (Cofan.mk s.pt (fun i ↦ s.ι.app ⟨Sum.inl i⟩)))
        (colimit.desc (Discrete.functor (fun j : I₂ ↦ j![𝒪, (U₂ j)]))
          (Cofan.mk s.pt (fun j ↦ s.ι.app ⟨Sum.inr j⟩))))
    ?_ ?_
  · intro s k
    -- Route correction: avoid the old sigma-index transport chain and verify each summand by the
    -- concrete coproduct universal property on the explicit `I₁ ⊕ I₂`-indexed cocone.
    cases k with
    | inl i =>
        simp [c, localizedStructureModule_sumIndexCofan, Category.assoc]
    | inr j =>
        simp [c, localizedStructureModule_sumIndexCofan, Category.assoc]
  · intro s m hm
    -- The mediating morphism is determined by its restrictions to the two coproduct summands.
    apply coprod.hom_ext
    · apply colimit.hom_ext
      intro i
      rw [Category.assoc, colimit.ι_desc]
      simpa [c, localizedStructureModule_sumIndexCofan, Category.assoc] using hm (Sum.inl i)
    · apply colimit.hom_ext
      intro j
      rw [Category.assoc, colimit.ι_desc]
      simpa [c, localizedStructureModule_sumIndexCofan, Category.assoc] using hm (Sum.inr j)

/-- Helper for Lemma 21.17.10: the coproduct of two coproducts of localized structure modules is
the coproduct over the disjoint union of the two index types. -/
private noncomputable def localizedStructureModule_sumIndexCoprodIso
    {I₁ I₂ : Type u} (U₁ : I₁ → C) (U₂ : I₂ → C) :
    ((∐ fun i : I₁ ↦ j![𝒪, (U₁ i)]) ⨿ (∐ fun j : I₂ ↦ j![𝒪, (U₂ j)])) ≅
      ∐ fun k : I₁ ⊕ I₂ ↦ j![𝒪, (Sum.elim U₁ U₂ k)] :=
  -- Proof comment: compare the explicit sum-indexed cocone with the canonical coproduct cocone
  -- on the same family, and use uniqueness of colimits to obtain the flattening isomorphism.
  (localizedStructureModule_sumIndexCofanIsColimit (𝒪 := 𝒪) U₁ U₂).coconePointUniqueUpToIso
    (colimit.isColimit
      (Discrete.functor (fun k : I₁ ⊕ I₂ ↦ j![𝒪, (Sum.elim U₁ U₂ k)])))

/-- Helper for Lemma 21.17.10: the coproduct of two coproducts of localized structure modules is
again a coproduct of localized structure modules, now indexed by the sum of the two index types. -/
private lemma localizedStructureModule_binaryCoproduct_mem
    {I₁ I₂ : Type u} (U₁ : I₁ → C) (U₂ : I₂ → C) :
    isCoproductOfLocalizedStructureModules 𝒪
      ((∐ fun i : I₁ ↦ j![𝒪, (U₁ i)]) ⨿ (∐ fun j : I₂ ↦ j![𝒪, (U₂ j)])) := by
  -- Proof comment: flatten the two chosen coproduct presentations into one coproduct indexed by
  -- the disjoint union `I₁ ⊕ I₂`.
  refine ⟨I₁ ⊕ I₂, Sum.elim U₁ U₂, ?_⟩
  exact ⟨localizedStructureModule_sumIndexCoprodIso 𝒪 U₁ U₂⟩

/-- Helper for Lemma 21.17.10: the object property
`isCoproductOfLocalizedStructureModules 𝒪` is closed under actual binary coproducts. -/
private lemma isCoproductOfLocalizedStructureModules_prop_coprod
    {X Y : Mod(𝒪)}
    (hX : isCoproductOfLocalizedStructureModules 𝒪 X)
    (hY : isCoproductOfLocalizedStructureModules 𝒪 Y) :
    isCoproductOfLocalizedStructureModules 𝒪 (X ⨿ Y) := by
  rcases hX with ⟨I₁, U₁, ⟨e₁⟩⟩
  rcases hY with ⟨I₂, U₂, ⟨e₂⟩⟩
  have hExplicit :
      isCoproductOfLocalizedStructureModules 𝒪
        ((∐ fun i : I₁ ↦ j![𝒪, (U₁ i)]) ⨿ (∐ fun j : I₂ ↦ j![𝒪, (U₂ j)])) :=
    localizedStructureModule_binaryCoproduct_mem 𝒪 U₁ U₂
  -- Proof comment: transport the canonical coproduct presentation of the two chosen summands
  -- across the binary-coproduct isomorphism induced by the two presentation isomorphisms.
  exact (isCoproductOfLocalizedStructureModules 𝒪).prop_of_iso
    (coprod.mapIso e₁.symm e₂.symm) hExplicit

/-- Helper for Lemma 21.17.10: binary coproducts of coproducts of localized structure modules are
again coproducts of localized structure modules. -/
private instance isCoproductOfLocalizedStructureModules_isClosedUnderBinaryCoproducts :
    (isCoproductOfLocalizedStructureModules 𝒪).IsClosedUnderBinaryCoproducts where
  colimitsOfShape_le := by
    rintro Z ⟨p⟩
    let A := p.diag.obj ⟨WalkingPair.left⟩
    let B := p.diag.obj ⟨WalkingPair.right⟩
    have hA : isCoproductOfLocalizedStructureModules 𝒪 A := by
      simpa [A] using p.prop_diag_obj ⟨WalkingPair.left⟩
    have hB : isCoproductOfLocalizedStructureModules 𝒪 B := by
      simpa [B] using p.prop_diag_obj ⟨WalkingPair.right⟩
    let c : BinaryCofan A B :=
      BinaryCofan.mk (p.ι.app ⟨WalkingPair.left⟩) (p.ι.app ⟨WalkingPair.right⟩)
    have hc : IsColimit c := by
      let hp :=
        ((IsColimit.precomposeHomEquiv (diagramIsoPair p.diag).symm p.cocone).2 p.isColimit)
      simpa [c, BinaryCofan.inl, BinaryCofan.inr] using hp
    have e : A ⨿ B ≅ Z := by
      simpa [c] using (coprodIsCoprod A B).coconePointUniqueUpToIso hc
    -- Proof comment: replace the arbitrary pair-shaped colimit presentation by the standard
    -- binary coproduct of its two objects, prove the property there, and transport across `e`.
    exact (isCoproductOfLocalizedStructureModules 𝒪).prop_of_iso e.symm
      (isCoproductOfLocalizedStructureModules_prop_coprod (𝒪 := 𝒪) hA hB)

/-- Finite coproducts of coproducts of localized structure modules are again coproducts of
localized structure modules. -/
instance isCoproductOfLocalizedStructureModules_isClosedUnderFiniteCoproducts :
    (isCoproductOfLocalizedStructureModules 𝒪).IsClosedUnderFiniteCoproducts := by
  -- Binary coproducts and the zero object already suffice for the owner-level finite-coproduct
  -- promotion.
  exact ObjectProperty.IsClosedUnderFiniteCoproducts.mk'

/-- Every `𝒪`-module admits an epimorphism from a coproduct of localized structure
modules. -/
instance isCoproductOfLocalizedStructureModules_hasEpiCover :
    HasEpiCover (isCoproductOfLocalizedStructureModules 𝒪) where
  exists_epi ℱ := by
    obtain ⟨I, U, φ, hφ⟩ :=
      exists_epi_from_coproduct_localizedStructureModuleExtensionByZero ℱ
    refine ⟨∐ fun i : I ↦ j![𝒪, (U i)], ?_, φ, hφ⟩
    exact ⟨I, U, ⟨Iso.refl _⟩⟩

variable [HasSheafify J AddCommGrpCat.{u}]

-- Proof sketch: use Lemma `18.28.8 (3)` to obtain objectwise epimorphic covers by coproducts of
-- `j![𝒪, U]`, feed this object property into Lemma `13.29.1` to get the compatible
-- upper-truncation resolution tower, and then apply exactness of filtered colimits in `Mod(𝒪)`
-- to deduce that the canonical colimit map is a quasi-isomorphism.
/-- Lemma 21.17.10: every complex of `𝒪`-modules on a ringed site admits a compatible
upper-truncation resolution tower by bounded-above complexes whose terms and successive degreewise
cokernels are coproducts of modules `j![𝒪, U]` such that the canonical morphism from
the sequential colimit of the tower to the original complex is a quasi-isomorphism. -/
@[stacks 077J]
theorem exists_upperTruncationResolutionTower_of_localizedStructureModuleCoproducts
    (𝒢 : CochainComplex (Mod(𝒪)) ℤ) :
    ∃ T : UpperTruncationResolutionTower (isCoproductOfLocalizedStructureModules 𝒪) 𝒢,
      QuasiIso T.fromColimit := by
  -- The Chapter 13 tower theorem supplies the compatible upper-truncation system.
  obtain ⟨T⟩ :=
    exists_upperTruncationResolutionTower
      (isCoproductOfLocalizedStructureModules 𝒪) 𝒢
  refine ⟨T, ?_⟩
  exact UpperTruncationResolutionTower.fromColimit_quasiIso_of_ringedSite 𝒪 T

end

end SheafOfModules.RingedSite
