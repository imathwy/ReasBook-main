import StacksProject_2024.stacks_project.Chap21.Definition_21_13_4
import StacksProject_2024.stacks_project.Chap21.SiteAbelianDerived
import StacksProject_2024.stacks_project.Chap19.AdditiveFunctorTotalRightDerived

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.Pretriangulated
open CategoryTheory.Sheaf
open DerivedCategory

noncomputable section

universe u v

attribute [local instance] HasDerivedCategory.standard

namespace CategoryTheory.GrothendieckTopology

section

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
variable [HasWeakSheafify J (Type (max u v))]
variable [HasWeakSheafify J AddCommGrpCat.{max u v}]

namespace SetValuedSheafification

/- Textbook notation for sheafification of a set-valued presheaf on a site. Since the site is not
inferable from the presheaf, we keep it explicit in `K^#[J]` and attach it directly to the
canonical owner `(presheafToSheaf J (Type (max u v))).obj`. -/
set_option quotPrecheck false in
scoped macro:max K:term noWs "^#[" J:term "]" : term => do
  `((CategoryTheory.presheafToSheaf $J (Type _)).obj $K)

end SetValuedSheafification

open scoped SetValuedSheafification

/-- The canonical morphism induced on sheafifications of set-valued presheaves. -/
abbrev setValuedSheafifyMap {K L : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) :
    K^#[J] ⟶ L^#[J] :=
  (presheafToSheaf J (Type (max u v))).map f

local notation "AbSheaf" => Sheaf J AddCommGrpCat
local notation "DSheaf" => DerivedCategory AbSheaf
local notation "DAb" => DerivedCategory AddCommGrpCat
local notation "QSh" =>
  (DerivedCategory.Q : CochainComplex AbSheaf ℤ ⥤ DerivedCategory AbSheaf)
local notation "QisSh" => HomologicalComplex.quasiIso AbSheaf (ComplexShape.up ℤ)
local instance : EssentiallySmall.{max u v} C := CategoryTheory.essentiallySmallSelf C
local instance : IsGrothendieckAbelian.{max u v} AbSheaf :=
  Sheaf.isGrothendieckAbelian_of_essentiallySmall J AddCommGrpCat.{max u v}

/-- The free abelian sheaf generated by the sheafification `K^#[J]`. This is the Section 21.13
owner whose derived Hom functor realizes `RΓ(K^#[J],-)`. -/
private abbrev freeAbSheafifiedPresheaf (K : Cᵒᵖ ⥤ Type (max u v)) : AbSheaf :=
  (Sheaf.composeAndSheafify J AddCommGrpCat.free).obj (K^#[J])

private abbrev derivedSectionsToDerived (K : Cᵒᵖ ⥤ Type (max u v)) :
    CochainComplex AbSheaf ℤ ⥤ DAb :=
  (preadditiveCoyoneda.obj (Opposite.op (J.freeAbSheafifiedPresheaf K))).mapHomologicalComplex
    (ComplexShape.up ℤ) ⋙ DerivedCategory.Q

private instance derivedSectionsToDerived_hasRightDerivedFunctor
    (K : Cᵒᵖ ⥤ Type (max u v)) :
    (J.derivedSectionsToDerived K).HasRightDerivedFunctor QisSh := by
  simpa [derivedSectionsToDerived] using
    (mapHomologicalComplexQ_hasRightDerivedFunctor
      (preadditiveCoyoneda.obj (Opposite.op (J.freeAbSheafifiedPresheaf K))))

/-- The derived sections functor `RΓ(K^#[J],-)` attached to a presheaf of sets `K`, realized as
the total right derived functor of `Hom(FreeAb(K^#[J]), -)`. -/
abbrev derivedSectionsOverPresheaf (K : Cᵒᵖ ⥤ Type (max u v)) : DSheaf ⥤ DAb :=
  (J.derivedSectionsToDerived K).totalRightDerived QSh QisSh

set_option quotPrecheck false in
local notation "RΓ#[" K "]" =>
  J.derivedSectionsOverPresheaf K
set_option quotPrecheck false in
local notation "η#[" K "]" =>
  Functor.totalRightDerivedUnit (J.derivedSectionsToDerived K) QSh QisSh
set_option quotPrecheck false in
local notation "ρ₀#[" f "]" =>
  Functor.whiskerRight
    (NatTrans.mapHomologicalComplex
      (preadditiveCoyoneda.map
        (((Sheaf.composeAndSheafify J AddCommGrpCat.free).map
          (J.setValuedSheafifyMap f)).op))
      (ComplexShape.up ℤ))
    DerivedCategory.Q

private theorem derivedSectionsRestrictionToDerivedNatTrans_eq_of_setValuedSheafifyMap_eq
    {K L : Cᵒᵖ ⥤ Type (max u v)} {f g : K ⟶ L}
    (hfg : J.setValuedSheafifyMap f = J.setValuedSheafifyMap g) :
    ρ₀#[f] = ρ₀#[g] := by
  simp [hfg]

/-- The canonical derived restriction natural transformation
`RΓ(L^#[J], -) ⟶ RΓ(K^#[J], -)` induced by `f : K ⟶ L`. -/
abbrev derivedSectionsOverPresheafRestrictionNatTrans
    {K L : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) :
    RΓ#[L] ⟶ RΓ#[K] :=
  Functor.rightDerivedNatTrans
    (RΓ#[L]) (RΓ#[K]) (η#[L]) (η#[K]) QisSh (ρ₀#[f])

/-- Equal sheafification maps induce the same derived restriction natural transformation. -/
theorem derivedSectionsOverPresheafRestrictionNatTrans_eq_of_setValuedSheafifyMap_eq
    {K L : Cᵒᵖ ⥤ Type (max u v)} {f g : K ⟶ L}
    (hfg : J.setValuedSheafifyMap f = J.setValuedSheafifyMap g) :
    J.derivedSectionsOverPresheafRestrictionNatTrans f =
      J.derivedSectionsOverPresheafRestrictionNatTrans g := by
  simpa [derivedSectionsOverPresheafRestrictionNatTrans] using
    congrArg
      (fun τ ↦
        Functor.rightDerivedNatTrans
          (RΓ#[L]) (RΓ#[K]) (η#[L]) (η#[K]) QisSh τ)
      (J.derivedSectionsRestrictionToDerivedNatTrans_eq_of_setValuedSheafifyMap_eq hfg)

private theorem derivedSectionsRestrictionToDerivedNatTrans_comp
    {K L M : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) (g : L ⟶ M) :
    ρ₀#[g] ≫ ρ₀#[f] = ρ₀#[f ≫ g] := by
  ext X
  have hmap :
      ((NatTrans.mapHomologicalComplex
            (preadditiveCoyoneda.map
              (((Sheaf.composeAndSheafify J AddCommGrpCat.free).map
                (J.setValuedSheafifyMap g)).op))
            (ComplexShape.up ℤ)).app X) ≫
          ((NatTrans.mapHomologicalComplex
            (preadditiveCoyoneda.map
              (((Sheaf.composeAndSheafify J AddCommGrpCat.free).map
                (J.setValuedSheafifyMap f)).op))
            (ComplexShape.up ℤ)).app X) =
        (NatTrans.mapHomologicalComplex
          (preadditiveCoyoneda.map
            (((Sheaf.composeAndSheafify J AddCommGrpCat.free).map
              (J.setValuedSheafifyMap (f ≫ g))).op))
          (ComplexShape.up ℤ)).app X := by
    apply HomologicalComplex.hom_ext _ _
    intro n
    simp [Functor.map_comp]
  simpa [NatTrans.comp_app, Functor.whiskerRight_app, Functor.map_comp] using
      congrArg (fun η ↦ DerivedCategory.Q.map η) hmap

/-- Derived restrictions along presheaf morphisms compose contravariantly. -/
theorem derivedSectionsOverPresheafRestrictionNatTrans_comp
    {K L M : Cᵒᵖ ⥤ Type (max u v)} (f : K ⟶ L) (g : L ⟶ M) :
    J.derivedSectionsOverPresheafRestrictionNatTrans g ≫
      J.derivedSectionsOverPresheafRestrictionNatTrans f =
        J.derivedSectionsOverPresheafRestrictionNatTrans (f ≫ g) := by
  rw [derivedSectionsOverPresheafRestrictionNatTrans,
    derivedSectionsOverPresheafRestrictionNatTrans,
    derivedSectionsOverPresheafRestrictionNatTrans,
    Functor.rightDerivedNatTrans_comp]
  rw [J.derivedSectionsRestrictionToDerivedNatTrans_comp f g]

section

variable {D E F G : Cᵒᵖ ⥤ Type (max u v)}
variable {a : D ⟶ E} {b : D ⟶ F} {c : E ⟶ G} {d : F ⟶ G}

set_option quotPrecheck false in
/-- The canonical first Mayer-Vietoris map
`RΓ(G^#[J], -) ⟶ RΓ(E^#[J], -) ⊞ RΓ(F^#[J], -)` induced by `c` and `d`. -/
abbrev derivedSectionsOverPresheafMayerVietorisToBiprod
    {E F G : Cᵒᵖ ⥤ Type (max u v)} (c : E ⟶ G) (d : F ⟶ G) :
    RΓ#[G] ⟶ (RΓ#[E] ⊞ RΓ#[F]) :=
  biprod.lift
    (J.derivedSectionsOverPresheafRestrictionNatTrans c)
    (J.derivedSectionsOverPresheafRestrictionNatTrans d)

set_option quotPrecheck false in
/-- The canonical second Mayer-Vietoris map
`RΓ(E^#[J], -) ⊞ RΓ(F^#[J], -) ⟶ RΓ(D^#[J], -)` given by the overlap difference. -/
abbrev derivedSectionsOverPresheafMayerVietorisDifference
    {D E F : Cᵒᵖ ⥤ Type (max u v)} (a : D ⟶ E) (b : D ⟶ F) :
    (RΓ#[E] ⊞ RΓ#[F]) ⟶ RΓ#[D] :=
  biprod.desc
    (J.derivedSectionsOverPresheafRestrictionNatTrans a)
    (-J.derivedSectionsOverPresheafRestrictionNatTrans b)

private theorem derivedSectionsOverPresheafMayerVietorisToBiprod_comp_difference_explicit
    (hpushout :
      IsPushout
        (J.setValuedSheafifyMap a)
        (J.setValuedSheafifyMap b)
        (J.setValuedSheafifyMap c)
        (J.setValuedSheafifyMap d)) :
    biprod.lift
        (J.derivedSectionsOverPresheafRestrictionNatTrans c)
        (J.derivedSectionsOverPresheafRestrictionNatTrans d) ≫
      biprod.desc
        (J.derivedSectionsOverPresheafRestrictionNatTrans a)
        (-J.derivedSectionsOverPresheafRestrictionNatTrans b) = 0 := by
  rw [biprod.lift_desc]
  have hcomp :
      J.setValuedSheafifyMap (a ≫ c) = J.setValuedSheafifyMap (b ≫ d) := by
    simpa [setValuedSheafifyMap, Functor.map_comp] using hpushout.w
  have hderived :
      J.derivedSectionsOverPresheafRestrictionNatTrans (a ≫ c) =
        J.derivedSectionsOverPresheafRestrictionNatTrans (b ≫ d) :=
    J.derivedSectionsOverPresheafRestrictionNatTrans_eq_of_setValuedSheafifyMap_eq hcomp
  have hac :
      J.derivedSectionsOverPresheafRestrictionNatTrans c ≫
        J.derivedSectionsOverPresheafRestrictionNatTrans a =
      J.derivedSectionsOverPresheafRestrictionNatTrans (a ≫ c) :=
    J.derivedSectionsOverPresheafRestrictionNatTrans_comp a c
  have hbd :
      J.derivedSectionsOverPresheafRestrictionNatTrans d ≫
        J.derivedSectionsOverPresheafRestrictionNatTrans b =
      J.derivedSectionsOverPresheafRestrictionNatTrans (b ≫ d) :=
    J.derivedSectionsOverPresheafRestrictionNatTrans_comp b d
  calc
    J.derivedSectionsOverPresheafRestrictionNatTrans c ≫
        J.derivedSectionsOverPresheafRestrictionNatTrans a +
      J.derivedSectionsOverPresheafRestrictionNatTrans d ≫
        (-J.derivedSectionsOverPresheafRestrictionNatTrans b) =
          J.derivedSectionsOverPresheafRestrictionNatTrans (a ≫ c) +
            -J.derivedSectionsOverPresheafRestrictionNatTrans (b ≫ d) := by
            rw [hac]
            simp [CategoryTheory.Preadditive.comp_neg, hbd]
    _ = J.derivedSectionsOverPresheafRestrictionNatTrans (b ≫ d) +
          -J.derivedSectionsOverPresheafRestrictionNatTrans (b ≫ d) := by
          rw [hderived]
    _ = 0 := by
          simp

/-- The canonical first two presheaf Mayer-Vietoris maps compose to zero. -/
theorem derivedSectionsOverPresheafMayerVietorisToBiprod_comp_difference
    (hpushout :
      IsPushout
        (J.setValuedSheafifyMap a)
        (J.setValuedSheafifyMap b)
        (J.setValuedSheafifyMap c)
        (J.setValuedSheafifyMap d)) :
    J.derivedSectionsOverPresheafMayerVietorisToBiprod c d ≫
      J.derivedSectionsOverPresheafMayerVietorisDifference a b = 0 := by
  simpa [derivedSectionsOverPresheafMayerVietorisToBiprod,
    derivedSectionsOverPresheafMayerVietorisDifference] using
    J.derivedSectionsOverPresheafMayerVietorisToBiprod_comp_difference_explicit hpushout

/-
Domain-style sampling for Lemma 21.26.4:
- primary domain: Mayer-Vietoris triangles for the canonical derived `Hom` functors
  `R Hom(FreeAb[J](K), -)` attached to presheaves of sets `K`;
- sampled owner declarations:
  `Sheaf.composeAndSheafify`,
  `preadditiveCoyoneda.obj`,
  `presheafToSheaf`,
  `additiveFunctorTotalRightDerived`,
  `IsPushout`;
- best owner abstraction: the source-facing objects are the four sheafified presheaves
  `D^#[J], E^#[J], F^#[J], G^#[J]`, and the canonical functor `RΓ(K^#[J],-)` is expressed
  directly as the derived `Hom` owner out of `FreeAb[J](K)`;
- primitive data: the canonical sheafified pushout witness and the monomorphism hypothesis on
  `D^#[J] ⟶ F^#[J]`;
- derived API: the comparison natural transformations induced by the free-abelian sheaf maps
  `FreeAb[J](E) ⟶ FreeAb[J](G)`, `FreeAb[J](F) ⟶ FreeAb[J](G)`,
  `FreeAb[J](D) ⟶ FreeAb[J](E)`, and `FreeAb[J](D) ⟶ FreeAb[J](F)`, together with the direct
  distinguished-triangle conclusion.

Source/core/bridge triage:
- `source-facing`: the Mayer-Vietoris triangle for the four functors
  `RΓ(G^#[J],-)`, `RΓ(E^#[J],-)`, `RΓ(F^#[J],-)`, and `RΓ(D^#[J],-)`;
- `core/canonical`: `Sheaf.composeAndSheafify`, `preadditiveCoyoneda.obj`,
  `additiveFunctorTotalRightDerived`, the functor-category biproduct, `IsPushout`, `Triangle.mk`,
  and `distTriang`;
- `bridge/view`: the localized-site realization from Section `21.13` and the representable-site
  presentation from Lemma `21.26.3`, used only as the proof route for distinguishedness.
-/

-- Proof sketch: first rewrite the four source-facing functors `RΓ(K^#[J],-)` as the derived `Hom`
-- owners attached to the free abelian sheaves on `K^#[J]`, so the first two Mayer-Vietoris maps
-- are the canonical derived precomposition maps induced by `c`, `d`, `a`, and `b`. To prove
-- distinguishedness, pass to the localized-site realization from Section `21.13`, then to a site
-- presentation from Lemma `7.29.5` in which the sheafified presheaves become representable.
-- Lemma `21.26.3` supplies the corresponding Mayer-Vietoris triangle there, and the final step is
-- to transport that distinguished triangle back through the Section `21.13` comparison.
/-- Lemma 21.26.4: for presheaves of sets on a site `(C, J)`, if the sheafified square
`D^#[J] ⟶ E^#[J]`, `D^#[J] ⟶ F^#[J]`, `E^#[J] ⟶ G^#[J]`, `F^#[J] ⟶ G^#[J]` is a pushout square
and `D^#[J] ⟶ F^#[J]` is a monomorphism, then the canonical derived functors
`RΓ(D^#[J],-)`, `RΓ(E^#[J],-)`, `RΓ(F^#[J],-)`, and `RΓ(G^#[J],-)` fit into a functorial distinguished
Mayer-Vietoris triangle
`RΓ(G^#[J], K) ⟶ RΓ(E^#[J], K) ⊕ RΓ(F^#[J], K) ⟶ RΓ(D^#[J], K) ⟶ RΓ(G^#[J], K)[1]`
for every `K : DerivedCategory (Sheaf J AddCommGrpCat.{max u v})`. The first two maps are the
canonical maps `derivedSectionsOverPresheafMayerVietorisToBiprod c d` and
`derivedSectionsOverPresheafMayerVietorisDifference a b`; only the boundary map is existentially
chosen. -/
@[stacks 0EVZ]
theorem exists_functorial_mayerVietoris_triangle_of_sheafified_presheaf_pushout
    (hpushout :
      IsPushout
        (J.setValuedSheafifyMap a)
        (J.setValuedSheafifyMap b)
        (J.setValuedSheafifyMap c)
        (J.setValuedSheafifyMap d))
    (hmono : Mono (J.setValuedSheafifyMap b)) :
    ∃ δ : RΓ#[D] ⟶ RΓ#[G] ⋙ shiftFunctor DAb (1 : ℤ),
      ∀ K : DSheaf,
        Triangle.mk
            ((J.derivedSectionsOverPresheafMayerVietorisToBiprod c d).app K)
            ((J.derivedSectionsOverPresheafMayerVietorisDifference a b).app K)
            (δ.app K) ∈
          distTriang DAb := by
  sorry

end

end

end CategoryTheory.GrothendieckTopology
