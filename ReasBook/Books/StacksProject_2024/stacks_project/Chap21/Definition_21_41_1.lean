noncomputable section

universe u

namespace CategoryTheory

open Functor

section

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}

/-- The projection `π : Δ × 𝒞 ⥤ 𝒞` from the simplicial site to the base site. -/
def simplicialProjection : SimplexCategory × C ⥤ C :=
  Prod.snd SimplexCategory C

/- Domain-style sampling for Definition 21.41.1:
- primary domain: module sheaves over the ring-valued sheaf on the simplicial site `Δ × 𝒞`;
- sampled owner declarations:
  `Precoverage.toGrothendieck`,
  `Presheaf.isSheaf_iff_isLimit_coverage`,
  `Presheaf.isLimit_iff_isSheafFor_presieve`,
  `SheafOfModules.RingedSite.ringedSiteModuleCategory`,
  `SheafOfModules.RingedSite.unitModule`;
- best owner abstraction: the source-facing category `Mod(A_•)` should be the actual ringed-site
  module category over the sheaf of rings on `Δ × 𝒞`, not a separate degreewise wrapper.

Primitive-vs-derived split:
- primitive data: the uncurried ring-valued presheaf on `(SimplexCategory × C)ᵒᵖ` attached to
  `A : SimplicialObject (Sheaf J CommRingCat)`;
- derived API: the induced topology, the direct sheaf-on-`Δ × 𝒞` attached to `A`, the owner
  category `SimplicialSheafOfModules A`, its source-facing Lean notation `Mod(A•)` for the
  textbook category `Mod(A_•)`, and the unit module object.

Source/core/bridge triage:
- `source-facing`: `SimplicialSheafOfModules A`;
- `core/canonical`: `ringedSiteModuleCategory (simplicialSite J) (simplicialAssociatedRingSheaf A)`;
- `bridge/view`: `simplicialSite`, presented via the explicit simplicial precoverage below,
  `simplicialAssociatedRingPresheaf`, and the identification of `simplicialAssociatedRingSheaf`.
-/

private def simplicialPrecoverage (J : Precoverage C) : Precoverage (SimplexCategory × C) where
  coverings x :=
    { R |
        ∃ (ι : Type u) (U : ι → C) (f : ∀ i, U i ⟶ x.2),
          R = Presieve.ofArrows (fun i ↦ (x.1, U i)) (fun i ↦ ((𝟙 x.1), f i)) ∧
            Presieve.ofArrows U f ∈ J x.2 }

/-- The Grothendieck topology on `Δ × 𝒞` generated by covering families in fixed simplicial
degree whose images in `𝒞` are `J`-covering families. -/
def simplicialSite (J : GrothendieckTopology C) : GrothendieckTopology (SimplexCategory × C) :=
  (simplicialPrecoverage J.toPrecoverage).toGrothendieck

private noncomputable def simplicialAssociatedRingPresheaf
    (A : SimplicialObject (Sheaf J CommRingCat.{u})) :
    (SimplexCategory × C)ᵒᵖ ⥤ CommRingCat.{u} where
  obj X := (A.obj (op X.unop.1)).1.obj (op X.unop.2)
  map {X Y} f :=
    ((A.map f.unop.1.op).hom.app (op X.unop.2)) ≫
      (A.obj (op Y.unop.1)).1.map f.unop.2.op
  map_id X := by
    ext x
    simp
  map_comp f g := by
    ext x
    simp [Category.assoc]

private noncomputable def simplicialAssociatedRingPresheafMap
    {A B : SimplicialObject (Sheaf J CommRingCat.{u})} (α : A ⟶ B) :
    simplicialAssociatedRingPresheaf A ⟶ simplicialAssociatedRingPresheaf B where
  app X := (α.app (op X.unop.1)).hom.app (op X.unop.2)
  naturality := by
    intro X Y f
    ext x
    change (((A.map f.unop.1.op).hom.app (op X.unop.2)) ≫
        (A.obj (op Y.unop.1)).1.map f.unop.2.op ≫
        (α.app (op Y.unop.1)).hom.app (op Y.unop.2)) x =
      (((α.app (op X.unop.1)).hom.app (op X.unop.2)) ≫
        ((B.map f.unop.1.op).hom.app (op X.unop.2)) ≫
        (B.obj (op Y.unop.1)).1.map f.unop.2.op) x
    rw [(α.app (op Y.unop.1)).hom.naturality f.unop.2.op]
    have hnat :
        ((A.map f.unop.1.op ≫ α.app (op Y.unop.1)).hom.app (op X.unop.2)) =
          ((α.app (op X.unop.1) ≫ B.map f.unop.1.op).hom.app (op X.unop.2)) := by
      simpa using congrArg (fun η ↦ η.app (op X.unop.2))
        (congrArg (fun η ↦ η.hom) (NatTrans.naturality α f.unop.1.op))
    have hnatx := congrArg (fun g :
        (A.obj (op X.unop.1)).1.obj (op X.unop.2) ⟶
          (B.obj (op Y.unop.1)).1.obj (op X.unop.2) ↦ g x) hnat
    exact congrArg (fun y ↦ ((B.obj (op Y.unop.1)).1.map f.unop.2.op) y) hnatx

/-- The sheaf of commutative rings on the simplicial site `Δ × 𝒞` canonically obtained by
sheafifying the directly induced simplicial ring presheaf attached to `A_•`. -/
abbrev simplicialAssociatedRingSheaf
    (A : SimplicialObject (Sheaf J CommRingCat.{u})) :
    Sheaf (simplicialSite J) CommRingCat.{u} :=
  (presheafToSheaf (simplicialSite J) CommRingCat.{u}).obj
    (simplicialAssociatedRingPresheaf A)

/-- A morphism of simplicial structure sheaves induces the corresponding morphism of associated
sheaves of commutative rings on the simplicial site `Δ × 𝒞`. -/
abbrev simplicialAssociatedRingSheafMap
    {A B : SimplicialObject (Sheaf J CommRingCat.{u})} (α : A ⟶ B) :
    simplicialAssociatedRingSheaf A ⟶ simplicialAssociatedRingSheaf B :=
  (presheafToSheaf (simplicialSite J) CommRingCat.{u}).map
    (simplicialAssociatedRingPresheafMap α)

/-- The identity-pushforward form of `simplicialAssociatedRingSheafMap α`, used by the Chapter 21
site-presented pullback owners on the simplicial site. -/
abbrev simplicialAssociatedRingSheafMapOverId
    {A B : SimplicialObject (Sheaf J CommRingCat.{u})} (α : A ⟶ B) :
    simplicialAssociatedRingSheaf A ⟶
      ((𝟭 (SimplexCategory × C)).sheafPushforwardContinuous
        CommRingCat.{u} (simplicialSite J) (simplicialSite J)).obj
        (simplicialAssociatedRingSheaf B) :=
  simplicialAssociatedRingSheafMap α ≫
    (Functor.sheafPushforwardContinuousId CommRingCat.{u} (simplicialSite J)).inv.app
      (simplicialAssociatedRingSheaf B)

/-- The Chapter 21 site-presented bridge attached to `simplicialAssociatedRingSheafMapOverId α`
has the same underlying `RingCat`-valued structure map as the Chapter 18 same-site owner
`ringedSiteStructureMap (simplicialAssociatedRingSheafMap α)`. -/
@[simp] theorem simplicialAssociatedRingSheafMapOverId_underlying_eq
    {A B : SimplicialObject (Sheaf J CommRingCat.{u})} (α : A ⟶ B) :
    ringedSiteUnderlyingStructureMap
        (𝟭 (SimplexCategory × C))
        (simplicialAssociatedRingSheafMapOverId α) =
      ringedSiteStructureMap (simplicialAssociatedRingSheafMap α) :=
  rfl

section

/-- Definition 21.41.1: a simplicial `A_•`-module is a sheaf of modules over the associated sheaf
of commutative rings on the simplicial site `Δ × 𝒞`. -/
@[stacks 09D1]
abbrev SimplicialSheafOfModules
    (A : SimplicialObject (Sheaf J CommRingCat.{u})) :=
  ringedSiteModuleCategory (simplicialSite J) (simplicialAssociatedRingSheaf A)

/- Source-facing bridge: the textbook category `Mod(A_•)` is written `Mod(A•)` on the Lean
surface. -/
scoped[CategoryTheory] notation:max "Mod(" A:arg "•)" => SimplicialSheafOfModules A

/-- The simplicial structure sheaf `A_•` itself, viewed as the unit object of `Mod(A•)`. -/
abbrev simplicialUnitModule
    (A : SimplicialObject (Sheaf J CommRingCat.{u})) :
    Mod(A•) :=
  unitModule (simplicialSite J) (simplicialAssociatedRingSheaf A)

end

end

end CategoryTheory
