import StacksProject_2024.stacks_project.Chap18.Lemma_18_28_8

open CategoryTheory CategoryTheory.Limits
open scoped SheafOfModules.RingedSite.LocalizedStructureModuleExtensionByZero

noncomputable section

universe u

namespace SheafOfModules.RingedSite

section

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
variable {𝒪 : Sheaf J CommRingCat.{u}}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable [J.HasSheafCompose (forget₂ RingCat AddCommGrpCat.{u})]

local notation "Mod" => ringedSiteModuleCategory J 𝒪

/- Domain-style sampling for 21.42.2.1:
- primary domain: sheaves of modules on a ringed site, generated by coproducts of the canonical
  lower-shriek structure modules `j![𝒪, U]`;
- sampled owner API:
  `localizedStructureModuleExtensionByZero`,
  `exists_epi_from_coproduct_localizedStructureModuleExtensionByZero`,
  `ShortComplex.exact_kernel`;
- best owner abstraction:
  `exists_epi_from_coproduct_localizedStructureModuleExtensionByZero` for the source map, together
  with the canonical kernel-sequence owner attached to an epimorphism;
- primitive data: an `𝒪`-module `𝒢`, an indexing type `I`, objects `U i`, and an epimorphism
  `π : (∐ fun i ↦ j![𝒪, U i]) ⟶ 𝒢`;
- derived API: the short exact sequence `ShortComplex.kernelSequence π`.

Source/core/bridge triage:
- `source-facing`: the existence of a short exact sequence
  `0 ⟶ 𝒢' ⟶ (∐ fun i ↦ j![𝒪, U i]) ⟶ 𝒢 ⟶ 0`;
- `core/canonical`: the Chapter 18 owner
  `exists_epi_from_coproduct_localizedStructureModuleExtensionByZero` and the short-complex owner
  API for kernels of epimorphisms;
- `bridge/view`: the canonical identification of the left term with `kernel π`.

This file should therefore keep only the source-facing short-exact existence theorem and derive it
directly from the chapter owner, rather than introducing any parallel wrapper for the coproduct map
or spelling the kernel sequence entrywise instead of using the owner `ShortComplex.kernelSequence`.
-/

-- Proof sketch: the source-facing short exact sequence is derived API from the chapter owner
-- `exists_epi_from_coproduct_localizedStructureModuleExtensionByZero`. Once we have the canonical
-- epimorphism `π`, the canonical owner `ShortComplex.kernelSequence π` is exact by
-- `ShortComplex.exact_kernel π`; its first map is the kernel inclusion and `hπ` supplies that
-- `π` is epi.
/-- 21.42.2.1: every `𝒪`-module `𝒢` admits a short exact sequence
`0 ⟶ 𝒢' ⟶ (∐ fun i ↦ j![𝒪, U i]) ⟶ 𝒢 ⟶ 0`. -/
@[stacks 08S1]
theorem exists_shortExact_coproduct_localizedStructureModuleExtensionByZero
    (𝒢 : Mod) :
    ∃ (I : Type u) (U : I → C)
      (π : (∐ fun i ↦ j![𝒪, (U i)]) ⟶ 𝒢),
      (ShortComplex.kernelSequence π).ShortExact := by
  obtain ⟨I, U, π, hπ⟩ :=
    exists_epi_from_coproduct_localizedStructureModuleExtensionByZero 𝒢
  have hExact : (ShortComplex.kernelSequence π).Exact := by
    simpa [ShortComplex.kernelSequence] using ShortComplex.exact_kernel π
  exact ⟨I, U, π, { exact := hExact, epi_g := hπ }⟩

end

end SheafOfModules.RingedSite
