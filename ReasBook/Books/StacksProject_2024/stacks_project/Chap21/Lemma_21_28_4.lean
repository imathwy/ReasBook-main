section

variable {X Y : RingedSite.{u, v}} (f : RingedSite.Hom X Y)
variable [HasWeakSheafify X.siteTopology AddCommGrpCat.{max u v}]
variable [X.siteTopology.WEqualsLocallyBijective AddCommGrpCat.{max u v}]
variable [f.modulePushforward.Additive]
variable [(PresheafOfModules.pushforward.{max u v} f.structureSheafMap.hom).IsRightAdjoint]
variable [Functor.Additive (SheafOfModules.pullback.{max u v} f.structureSheafMap)]
variable [Functor.HasRightDerivedFunctor (modulePushforwardToDerived f) (ModuleQis X)]
variable [Functor.HasLeftDerivedFunctor (modulePullbackToDerived f) (ModuleQis Y)]
variable [Fact (IsFlat f)]
local notation "single0" => DerivedCategory.singleFunctor (ModuleCat Y) (0 : ℤ)
local notation:max "H^" q:max => DerivedCategory.homologyFunctor (ModuleCat Y) q

/- Route correction: the remaining bounded-below argument has to pass through the exact pullback
model `(f^*).mapDerivedCategory`, because that is where cohomology and truncation are controlled
source-faithfully. The helpers below package that exact-model comparison before the final square
chase. -/

/-- Helper for Lemma 21.28.4: exact pullback identifies the cohomology of `K` with the cohomology
of `Lf^* K`. -/
private noncomputable def modulePullbackDerived_homology_iso
    (K : ModuleDerived Y) (q : ℤ) :
    (f^*).obj ((H^q).obj K) ≅
      (DerivedCategory.homologyFunctor (ModuleCat X) q).obj
        ((modulePullbackDerived f).obj K) := by
  let eExact :
      (f^*).obj ((H^q).obj K) ≅
        (DerivedCategory.homologyFunctor (ModuleCat X) q).obj
          (((f^*).mapDerivedCategory).obj K) :=
    CategoryTheory.exactFunctor_homology_iso_mapDerivedCategory
      (f^*)
      K
      q
  -- Transport the exact-model cohomology comparison along the owner isomorphism above.
  exact eExact ≪≫
    (DerivedCategory.homologyFunctor (ModuleCat X) q).mapIso
      ((modulePullbackDerived_exactIso f).app K)

omit [f.modulePushforward.Additive]
  [Functor.HasRightDerivedFunctor (modulePushforwardToDerived f) (ModuleQis X)] in
/-- Helper for Lemma 21.28.4: if `K` has no cohomology above `j`, then neither does `Lf^* K`. -/
private theorem modulePullbackDerived_isLE_of_isLE
    (K : ModuleDerived Y) (j : ℤ) [K.IsLE j] :
    ((modulePullbackDerived f).obj K).IsLE j := by
  rw [DerivedCategory.isLE_iff]
  intro q hq
  have hzeroSource : IsZero ((H^q).obj K) :=
    DerivedCategory.isZero_of_isLE K j q hq
  have hzeroPullback : IsZero ((f^*).obj ((H^q).obj K)) :=
    Functor.map_isZero (f^*) hzeroSource
  -- Rewrite the target cohomology sheaf through the exact-model comparison and transport zero-ness.
  exact
    ((modulePullbackDerived_homology_iso f K q).symm.isZero_iff).2
      hzeroPullback

/- Domain-style sampling for Lemma 21.28.4:
- primary domain: flat pullback/right-derived-pushforward adjunctions on derived categories of
  module sheaves over ringed sites;
- sampled owner declarations:
  `RingedSite.Hom.modulePullbackDerivedOfExact`,
  `RingedSite.Hom.modulePushforwardDerived`,
  `RingedSite.Hom.modulePullbackDerived_pushforward_adjunction`,
  `CategoryTheory.unitIsomorphismProperty_of_bounded_of_cohomology`;
- best owner abstraction:
  `source-facing`: the flat ringed-site specialization of the unit-isomorphism criterion;
  `core/canonical`: the Chapter 21 owners `modulePullbackDerived f`,
    `modulePushforwardDerived f`, and
    `modulePullbackDerived_pushforward_adjunction f`, together with the owner
    `CategoryTheory.unitIsomorphismProperty` and its bounded detection theorem
    `CategoryTheory.unitIsomorphismProperty_of_bounded_of_cohomology`;
  `bridge/view`: the flatness-to-left-derived instance
    `modulePullbackToDerived_hasLeftDerivedFunctor_of_isFlat`.

Primitive data are the flat morphism `f`, the canonical adjunction
`modulePullbackDerived_pushforward_adjunction f : L(f)^* ⊣ R(f)_*`, the
bounded-below derived object `K`, and the degree-zero membership hypotheses in the canonical
unit-isomorphism property on its cohomology sheaves. The theorem below is therefore a
source-facing specialization of that generic owner, not a new owner declaration. The exact
pullback owner `modulePullbackDerivedOfExact` is used only as a bridge to recover the canonical
shift and triangulated instances needed by the abstract theorem.
-/

-- Proof sketch: let `D'` be the full triangulated subcategory of `D(𝒪_Y)` on objects for
-- which the adjunction unit is an isomorphism. Each cohomology sheaf `H^q(K)[0]` lies in `D'` by
-- hypothesis, and bounded-below truncation induction then shows that the bounded-below object `K`
-- itself lies in `D'`.
/-- Helper for Lemma 21.28.4: the bounded version already follows from the abstract Chapter 21
unit-isomorphism criterion once the flat pullback functor is viewed as a triangulated left
adjoint. -/
private theorem unit_isIso_of_bounded_of_cohomologySheaf_owner
    (K : ModuleDerived Y)
    (hbounded : ∃ a b : ℤ, K.IsGE a ∧ K.IsLE b)
    (hcohom : ∀ q : ℤ,
      IsIso
        ((modulePullbackDerived_pushforward_adjunction f).unit.app
          ((single0).obj ((H^q).obj K)))) :
    unitIsomorphismProperty
      (modulePullbackDerived f)
      (modulePushforwardDerived f)
      (modulePullbackDerived_pushforward_adjunction f)
      K := by
  letI : (modulePullbackDerived f).CommShift ℤ := modulePullbackDerived_commShift_of_isFlat f
  letI : (modulePullbackDerived f).IsTriangulated :=
    modulePullbackDerived_isTriangulated_of_isFlat f
  -- The bounded case is exactly the abstract criterion specialized to `Lf^* ⊣ Rf_*`.
  exact
    CategoryTheory.unitIsomorphismProperty_of_bounded_of_cohomology
      (modulePullbackDerived f)
      (modulePushforwardDerived f)
      (modulePullbackDerived_pushforward_adjunction f)
      K
      hbounded
      (fun q ↦ hcohom q)

/-- Helper for Lemma 21.28.4: the bounded flat specialization gives an actual `IsIso` statement
for the adjunction unit. -/
private theorem unit_isIso_of_bounded_of_cohomologySheaf
    (K : ModuleDerived Y)
    (hbounded : ∃ a b : ℤ, K.IsGE a ∧ K.IsLE b)
    (hcohom : ∀ q : ℤ,
      IsIso
        ((modulePullbackDerived_pushforward_adjunction f).unit.app
          ((single0).obj ((H^q).obj K)))) :
    IsIso ((modulePullbackDerived_pushforward_adjunction f).unit.app K) := by
  simpa [unitIsomorphismProperty] using
    unit_isIso_of_bounded_of_cohomologySheaf_owner f K hbounded hcohom

/-- Helper for Lemma 21.28.4: a morphism between zero objects is automatically an isomorphism. -/
private theorem isIso_of_isZero_of_isZero
    {C : Type*} [Category C] [HasZeroMorphisms C] {A B : C} (φ : A ⟶ B)
    (hA : IsZero A) (hB : IsZero B) :
    IsIso φ := by
  -- The zero morphism is a two-sided inverse because every endomorphism of a zero object agrees.
  refine ⟨⟨0, ?_, ?_⟩⟩
  · exact hA.eq_of_src _ _
  · exact hB.eq_of_src _ _

/-- Helper for Lemma 21.28.4: truncating above degree `j` turns a bounded-below object into a
bounded object with upper bound `j`. -/
private theorem truncLE_bounded_of_boundedBelow
    (K : ModuleDerived Y) (j : ℤ)
    (hbounded : ∃ n : ℤ, K.IsGE n) :
    ∃ a b : ℤ, ((t.truncLE j).obj K).IsGE a ∧ ((t.truncLE j).obj K).IsLE b := by
  rcases hbounded with ⟨a, hGE⟩
  letI : K.IsGE a := hGE
  -- The truncation inherits the lower bound from `K` and acquires the upper bound `j`.
  exact ⟨a, j, inferInstance, inferInstance⟩

/-- Helper for Lemma 21.28.4: the truncation map `τ≤j K ⟶ K` induces an isomorphism on `H^q`
whenever `q ≤ j`. -/
private theorem homology_map_truncLEι_isIso
    (K : ModuleDerived Y) (j q : ℤ) (hqj : q ≤ j) :
    IsIso
      ((DerivedCategory.homologyFunctor (ModuleCat Y) q).map
        ((t.truncLEι j).app K)) := by
  let T : Triangle (ModuleDerived Y) := (t.triangleLEGT j).obj K
  have hT : T ∈ distTriang (ModuleDerived Y) := by
    simpa [T] using t.triangleLEGT_distinguished j K
  have h₃ : T.obj₃.IsGE (j + 1) := by
    dsimp [T]
    infer_instance
  have hmor₂_zero : ((H^q).map T.mor₂) = 0 := by
    exact (DerivedCategory.isZero_of_isGE T.obj₃ (j + 1) q (by omega)).eq_of_tgt _ _
  have hδ_zero : DerivedCategory.HomologySequence.δ T (q - 1) q (by omega) = 0 := by
    exact (DerivedCategory.isZero_of_isGE T.obj₃ (j + 1) (q - 1) (by omega)).eq_of_src _ _
  letI : Epi ((H^q).map T.mor₁) :=
    (DerivedCategory.HomologySequence.epi_homologyMap_mor₁_iff T hT q).2 hmor₂_zero
  letI : Mono ((H^q).map T.mor₁) :=
    (DerivedCategory.HomologySequence.mono_homologyMap_mor₁_iff T hT (q - 1) q (by omega)).2
      hδ_zero
  simpa [T] using isIso_of_mono_of_epi ((H^q).map T.mor₁)

/-- Helper for Lemma 21.28.4: the degree-zero single object on a zero module is zero in the
derived category. -/
private theorem single0_obj_isZero_of_isZero
    {M : ModuleCat Y} (hM : IsZero M) :
    IsZero ((single0).obj M) := by
  -- Apply the degree-zero single functor to the zero module comparison.
  simpa using Functor.map_isZero single0 hM

/-- Helper for Lemma 21.28.4: the unit hypothesis on the cohomology sheaves of `K` transfers to
the bounded truncation `τ≤j K`. -/
private theorem truncLE_cohomology_unit_hypothesis
    (K : ModuleDerived Y) (j : ℤ)
    (hcohom : ∀ q : ℤ,
      IsIso
        ((modulePullbackDerived_pushforward_adjunction f).unit.app
          ((single0).obj ((H^q).obj K)))) :
    ∀ q : ℤ,
      IsIso
        ((modulePullbackDerived_pushforward_adjunction f).unit.app
          ((single0).obj ((H^q).obj ((t.truncLE j).obj K)))) := by
  intro q
  by_cases hqj : q ≤ j
  · let eH :
        (H^q).obj ((t.truncLE j).obj K) ≅ (H^q).obj K :=
      by
        have hIso : IsIso ((H^q).map ((t.truncLEι j).app K)) :=
          homology_map_truncLEι_isIso K j q hqj
        exact @asIso _ _ _ _ ((H^q).map ((t.truncLEι j).app K)) hIso
    -- For `q ≤ j`, transport the given unit-isomorphism hypothesis across the cohomology
    -- comparison `H^q(τ≤j K) ≅ H^q(K)`.
    exact
      (unitIsomorphismProperty
        (modulePullbackDerived f)
        (modulePushforwardDerived f)
        (modulePullbackDerived_pushforward_adjunction f)).prop_of_iso
        ((single0).mapIso eH.symm)
        (hcohom q)
  · have hqj' : j < q := by omega
    have hzeroH : IsZero ((H^q).obj ((t.truncLE j).obj K)) := by
      -- Above the truncation bound, the cohomology of `τ≤j K` vanishes.
      exact DerivedCategory.isZero_of_isLE _ j q hqj'
    have hzeroSingle :
        IsZero ((single0).obj ((H^q).obj ((t.truncLE j).obj K))) := by
      -- Passing to the degree-zero single object preserves zero objects.
      exact single0_obj_isZero_of_isZero hzeroH
    have hzeroImage :
        IsZero
          ((modulePushforwardDerived f).obj
            ((modulePullbackDerived f).obj
              ((single0).obj ((H^q).obj ((t.truncLE j).obj K))))) := by
      -- Both `Lf^*` and `Rf_*` preserve zero objects, so the unit is a map between zero objects.
      exact
        Functor.map_isZero
          (modulePushforwardDerived f)
          (Functor.map_isZero (modulePullbackDerived f) hzeroSingle)
    exact
      isIso_of_isZero_of_isZero
        ((modulePullbackDerived_pushforward_adjunction f).unit.app
          ((single0).obj ((H^q).obj ((t.truncLE j).obj K))))
        hzeroSingle
        hzeroImage

/-- Lemma 21.28.4: for a flat morphism of ringed topoi formalized by a flat morphism of ringed
sites `f`, if a derived `𝒪_Y`-module `K` is bounded below and the canonical adjunction unit
`H^q(K)[0] ⟶ R(f)_* L(f)^*(H^q(K)[0])` is an isomorphism for every `q`, then the canonical unit
`K ⟶ R(f)_* L(f)^* K` is an isomorphism. Since `f` is flat, `L(f)^*` is computed by the exact
pullback functor on the derived category. -/
@[stacks 0D7T]
theorem unit_isIso_of_boundedBelow_of_cohomologySheaf
    (K : ModuleDerived Y)
    (hbounded : ∃ n : ℤ, K.IsGE n)
    (hcohom : ∀ q : ℤ,
      IsIso
        ((modulePullbackDerived_pushforward_adjunction f).unit.app
          ((single0).obj ((H^q).obj K)))) :
    IsIso ((modulePullbackDerived_pushforward_adjunction f).unit.app K) := by
  letI : (modulePullbackDerived f).CommShift ℤ := modulePullbackDerived_commShift_of_isFlat f
  letI : (modulePullbackDerived f).IsTriangulated := modulePullbackDerived_isTriangulated_of_isFlat f
  sorry

end

end RingedSite.Hom
