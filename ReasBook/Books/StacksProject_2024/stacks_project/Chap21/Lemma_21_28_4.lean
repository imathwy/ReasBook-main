variable {A : Type*} [Category A] [Abelian A] [HasDerivedCategory A]
variable {B : Type*} [Category B] [Abelian B] [HasDerivedCategory B]
local notation "H" => DerivedCategory.homologyFunctor B
local notation "single0" => DerivedCategory.singleFunctor B (0 : ℤ)
variable (F : DerivedCategory B ⥤ DerivedCategory A)
variable (G : DerivedCategory A ⥤ DerivedCategory B)
variable (adj : F ⊣ G)
local notation "P" => unitIsomorphismProperty F G adj
/-- Helper for Lemma 21.28.4: every bounded interval stage generated by degree-zero cohomology
objects already satisfying the unit-isomorphism condition lies in the same unit-isomorphism
property. -/
lemma unit_interval_stage_le
    [F.CommShift ℤ] [F.IsTriangulated]
    (a b : ℤ) (n : ℕ+) :
    additiveExtensionStage
      ((CategoryTheory.ObjectProperty.map
          (((fun M : B ↦ P ((single0).obj M)) : ObjectProperty B))
          single0)[a, b]) n ≤ P := by
  let P₀ : ObjectProperty (DerivedCategory B) := unitIsomorphismProperty F G adj
  letI : P₀.IsStableUnderRetracts := unitIsomorphismProperty_isStableUnderRetracts F G adj
  letI : G.CommShift ℤ := adj.rightAdjointCommShift ℤ
  letI : adj.CommShift ℤ := adj.commShift_of_leftAdjoint ℤ
  letI : adj.IsTriangulated := Adjunction.IsTriangulated.mk' adj
  letI : G.IsTriangulated := adj.isTriangulated_rightAdjoint
  letI : P₀.IsTriangulated := unitIsomorphismProperty_isTriangulated F G adj
  let E : ObjectProperty B := fun M ↦ P₀ ((single0).obj M)
  let hshift :
      ((E.map single0)[a, b]) ≤ P₀ := by
    intro X hX
    rw [prop_shiftInterval_iff] at hX
    rcases hX with ⟨m, hm, hXm⟩
    rw [ObjectProperty.prop_isoClosure_iff] at hXm
    rcases hXm with ⟨Y, hY, ⟨e⟩⟩
    rw [ObjectProperty.prop_shift_iff] at hY
    have hmap : (E.map single0) (Y⟦m⟧) := hY
    rcases hmap with ⟨Z, hZ, ⟨eZ⟩⟩
    have hshifted : P₀ (Y⟦m⟧) := by
      exact P₀.prop_of_iso eZ hZ
    have hbase : P₀ Y := by
      simpa using
        ((P₀.prop_shift_iff_of_isStableUnderShift Y m).1 hshifted)
    exact P₀.prop_of_iso e.symm hbase
  have hadd : ((E.map single0)[a, b]).additiveClosure ≤ P₀ := by
    -- The triangulated property already supplies the finite-coproduct and shift closure needed
    -- for the additive hull to stay inside `P`.
    simpa [ObjectProperty.additiveClosure] using
      (by
        refine colimitsClosure_le ?_
        exact hshift)
  have hstage : additiveExtensionStage ((E.map single0)[a, b]) n ≤ P₀ := by
    -- Rewrite the stage and then iterate the middle-object closure of the triangulated property.
    rw [ObjectProperty.additiveExtensionStage, retractClosure_le_iff]
    exact
      (((E.map single0)[a, b]).additiveClosure).extensionProductIter_le_of_isTriangulatedClosed₂
        hadd
        n.natPred
  simpa [E, P₀] using hstage

/- Domain-style sampling for the abstract form of Lemma 21.28.4:
- primary domain: unit-isomorphism object properties for triangulated adjunctions on derived
  categories;
- sampled owner declarations:
  `unitIsomorphismProperty`,
  `restrictedLeftAdjoint_fullyFaithful`,
  `unitIsomorphismProperty_isTriangulated`,
  `Adjunction.isTriangulated_rightAdjoint`;
- best owner abstraction:
  `source-facing`: the bounded cohomological detection criterion below;
  `core/canonical`: the object property `P`;
  `bridge/view`: the underlying unit-isomorphism statement `IsIso (adj.unit.app _)`.

Primitive data are the adjunction `F ⊣ G`, the exact/triangulated structure on the left adjoint
encoded by `[F.CommShift ℤ] [F.IsTriangulated]`, the bounded object `K`, and the cohomology
objects `H^q(K)[0]`. The shift compatibility and right-adjoint triangulated structure used in the
proof are derived from this owner data rather than primitive fields of a separate wrapper.
-/

-- Proof sketch: first apply the Chapter 13 bounded-reconstruction theorem to express `K` as a
-- bounded additive-extension stage generated by its cohomology singles, then absorb that stage
-- into the unit-isomorphism property using the triangulated closure from Lemma `21.28.1`.
/-- Helper for Lemma 21.28.4: if a derived object is bounded both below and above and each
degree-zero cohomology object `H^q(K)[0]` lies in the unit-isomorphism property, then `K` lies in
that property as well. -/
theorem unitIsomorphismProperty_of_bounded_of_cohomology
    [F.CommShift ℤ] [F.IsTriangulated]
    (K : DerivedCategory B)
    (hbounded : ∃ a b : ℤ, K.IsGE a ∧ K.IsLE b)
    (hcohom : ∀ q : ℤ, P ((single0).obj ((H q).obj K))) :
    P K := by
  let P₀ : ObjectProperty (DerivedCategory B) := unitIsomorphismProperty F G adj
  letI : P₀.IsStableUnderRetracts := unitIsomorphismProperty_isStableUnderRetracts F G adj
  letI : G.CommShift ℤ := adj.rightAdjointCommShift ℤ
  letI : adj.CommShift ℤ := adj.commShift_of_leftAdjoint ℤ
  letI : adj.IsTriangulated := Adjunction.IsTriangulated.mk' adj
  letI : G.IsTriangulated := adj.isTriangulated_rightAdjoint
  letI : P₀.IsTriangulated := unitIsomorphismProperty_isTriangulated F G adj
  let E : ObjectProperty B := fun M ↦ P₀ ((single0).obj M)
  rcases hbounded with ⟨a, b, hGE, hLE⟩
  have hstage :
      additiveExtensionStage
        ((E.map single0)[a, b])
        (Nat.succPNat (Int.toNat (b - a)))
        K := by
    -- Reconstruct the bounded object from its cohomology objects inside the canonical interval
    -- stage of Lemma `13.35.7`.
    refine mem_additiveExtensionStage_of_homology_mem_additiveClosure E K a b hGE hLE ?_
    intro i
    exact mem_additiveClosure_retractClosure_of_mem E (hcohom i.1)
  -- The interval stage is already contained in the unit-isomorphism property by triangulated
  -- closure, so the reconstruction immediately puts `K` in `P`.
  exact
    unit_interval_stage_le
      F
      G
      adj
      a
      b
      (Nat.succPNat (Int.toNat (b - a)))
      K
      hstage

end

end CategoryTheory

