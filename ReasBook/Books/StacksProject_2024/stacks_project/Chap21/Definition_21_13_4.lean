import Mathlib.Algebra.Category.Grp.Adjunctions
import Mathlib.Algebra.Homology.DerivedCategory.Ext.Basic
import Mathlib.CategoryTheory.Sites.PreservesSheafification

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory CategoryTheory.Abelian CategoryTheory.Limits

noncomputable section

universe u v w

namespace CategoryTheory
namespace Sheaf

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable [HasWeakSheafify J AddCommGrpCat.{w}]
variable [Abelian (Sheaf J AddCommGrpCat.{w})]
variable [HasExt.{w} (Sheaf J AddCommGrpCat.{w})]

/- Domain-style sampling for Definition 21.13.4:
- primary domain: higher sheaf cohomology over a sheaf of sets, expressed in the abelian sheaf
  category by `Ext` from the free abelian sheaf on that sheaf of sets;
- sampled owner declarations:
  `cohomologyOverSheaf`,
  `Sheaf.composeAndSheafify`,
  `Abelian.extFunctorObj`,
  `IsZero`;
- best owner abstraction:
  `source-facing`: `cohomologyOverSheaf K F p`, the chapter owner for `H^p(K, F)`, and total
    acyclicity over all sheaves of sets;
  `core/canonical`: the free abelian sheaf owner `composeAndSheafify J AddCommGrpCat.free` and the
    abelian-category `Ext` owner `Abelian.extFunctorObj`;
  `bridge/view`: the later localized-site realization of the same cohomology groups.

Primitive data versus derived API:
- primitive data: an abelian sheaf `F` together with vanishing of the positive cohomology objects
  `cohomologyOverSheaf K F (n + 1)` for each sheaf of sets `K`;
- derived API: downstream objectwise and Čech-style consequences such as Lemma `21.13.5`.
-/

/-- The cohomology `H^p(K, F)` of an abelian sheaf `F` over a sheaf of sets `K`, formalized as the
`p`-th `Ext` object from the free abelian sheaf generated by `K` to `F`. -/
noncomputable abbrev cohomologyOverSheaf
    (K : Sheaf J (Type w)) (F : Sheaf J AddCommGrpCat.{w}) (p : ℕ) :
    AddCommGrpCat.{w} :=
  (Abelian.extFunctorObj ((composeAndSheafify J AddCommGrpCat.free).obj K) p).obj F

/-- The cohomology `H^p(K, F)` of an abelian sheaf `F` over a presheaf of sets `K`, defined by
first sheafifying `K` and then applying the canonical sheaf-level owner `cohomologyOverSheaf`. -/
noncomputable abbrev cohomologyOverPresheaf
    [HasSheafify J (Type w)]
    (K : Cᵒᵖ ⥤ Type w) (F : Sheaf J AddCommGrpCat.{w}) (p : ℕ) :
    AddCommGrpCat.{w} :=
  cohomologyOverSheaf ((presheafToSheaf J (Type w)).obj K) F p

/- Textbook surface notation for the source-facing cohomology object `H^p(K, F)`. -/
scoped notation:max "H^" p:max "(" K ", " F ")" =>
  CategoryTheory.Sheaf.cohomologyOverSheaf K F p

open scoped CategoryTheory.Sheaf

/-- Definition 21.13.4: an abelian sheaf `F` on a site is totally acyclic `1` if for every sheaf
of sets `K`, all positive cohomology groups `H^p(K, F)` vanish. -/
@[stacks 072Y, mk_iff isTotallyAcyclicOne_iff]
class IsTotallyAcyclicOne (F : Sheaf J AddCommGrpCat.{w}) : Prop where
  /-- Every positive cohomology group of `F` over every sheaf of sets vanishes, formalized by the
  corresponding cohomology object `H^p(K, F)`. -/
  isZero_higherCohomologyOverSheaf (K : Sheaf J (Type w)) (n : ℕ) :
    IsZero (H^(n + 1)(K, F))

variable {F : Sheaf J AddCommGrpCat.{w}}

/-- A totally acyclic sheaf has vanishing higher cohomology over every sheaf of sets. -/
instance instIsZeroHigherCohomologyOverSheaf
    [hF : IsTotallyAcyclicOne F] (K : Sheaf J (Type w)) (n : ℕ) :
    IsZero (H^(n + 1)(K, F)) :=
  hF.isZero_higherCohomologyOverSheaf K n

/-- A totally acyclic sheaf has vanishing higher cohomology over every presheaf of sets after
sheafification. -/
instance instIsZeroHigherCohomologyOverPresheaf
    [HasSheafify J (Type w)] [hF : IsTotallyAcyclicOne F] (K : Cᵒᵖ ⥤ Type w) (n : ℕ) :
    IsZero (cohomologyOverPresheaf K F (n + 1)) :=
  hF.isZero_higherCohomologyOverSheaf ((presheafToSheaf J (Type w)).obj K) n

end Sheaf
end CategoryTheory
