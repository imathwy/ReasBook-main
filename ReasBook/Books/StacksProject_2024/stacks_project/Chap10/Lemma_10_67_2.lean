import Mathlib
import StacksProject_2024.Chap10.Definition_10_67_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

section

variable (R : Type u) [CommRing R]
variable (M : Type v) [AddCommGroup M] [Module R M]

/-- The support of a cyclic submodule generated by an element of `N` is contained in the support of
`N`. -/
private theorem support_cyclic_subset_of_submodule {N : Submodule R M} {m : M} (hm : m ∈ N) :
    Module.support R (R ∙ m) ⊆ Module.support R N := by
  exact Module.support_subset_of_injective (Submodule.inclusion <|
    (Submodule.span_singleton_le_iff_mem m N).2 hm) (Submodule.inclusion_injective _)

/-- The support of a product of modules is the union of the supports of its factors. -/
private theorem support_prod_eq_union (N P : Submodule R M) :
    Module.support R (N × P) = Module.support R N ∪ Module.support R P := by
  have hExact : Function.Exact (LinearMap.inl R N P) (LinearMap.snd R N P) :=
    Function.Exact.inl_snd
  simpa using
    (Module.support_of_exact hExact LinearMap.inl_injective LinearMap.snd_surjective)

/-- The support of a supremum of two submodules is contained in the union of their supports. -/
private theorem support_sup_subset_union (N P : Submodule R M) :
    Module.support R ↥(N ⊔ P) ⊆ Module.support R N ∪ Module.support R P := by
  let φ : N × P →ₗ[R] ↥(N ⊔ P) :=
    (N.subtype.coprod P.subtype).codRestrict (N ⊔ P) fun z ↦
      Submodule.mem_sup.2 ⟨z.1, z.1.2, z.2, z.2.2, rfl⟩
  have hφ : Function.Surjective φ := by
    intro z
    rcases Submodule.mem_sup.mp z.2 with ⟨x, hx, y, hy, hxy⟩
    refine ⟨(⟨x, hx⟩, ⟨y, hy⟩), ?_⟩
    ext
    exact hxy
  exact (Module.support_subset_of_surjective φ hφ).trans <| by
    simp [support_prod_eq_union R M N P]

/-- The canonical submodule from Lemma 10.67.2: the elements whose cyclic support is contained in
the union of the zero loci of the embedded associated primes of `M`. -/
def embeddedPrimeFreeSubmodule : Submodule R M where
  carrier := { m | Module.support R (R ∙ m) ⊆
    ⋃ p ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus p }
  zero_mem' := by
    intro p hp
    letI : Subsingleton ↥(R ∙ (0 : M)) :=
      (Submodule.subsingleton_iff_eq_bot.2 <| Submodule.span_singleton_eq_bot.2 rfl)
    have hsupp : Module.support R ↥(R ∙ (0 : M)) = ∅ := Module.support_eq_empty
    rw [hsupp] at hp
    exact hp.elim
  add_mem' := by
    intro m n hm hn
    exact (support_cyclic_subset_of_submodule R M <|
        Submodule.mem_sup.2 ⟨m, Submodule.mem_span_singleton_self m, n,
          Submodule.mem_span_singleton_self n, rfl⟩).trans <|
      (support_sup_subset_union R M (R ∙ m) (R ∙ n)).trans <|
        Set.union_subset hm hn
  smul_mem' := by
    intro r m hm
    exact (support_cyclic_subset_of_submodule R M <|
      Submodule.smul_mem (R ∙ m) r (Submodule.mem_span_singleton_self m)).trans hm

/-- An element lies in the canonical submodule from Lemma 10.67.2 exactly when the support of its
cyclic submodule is contained in the embedded-prime locus. This is the source-text definition of
the construction. -/
theorem mem_embeddedPrimeFreeSubmodule_iff (m : M) :
    m ∈ embeddedPrimeFreeSubmodule R M ↔
      Module.support R (R ∙ m) ⊆
        ⋃ p ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus p :=
  Iff.rfl

end

section

variable (R : Type u) [CommRing R] [IsNoetherianRing R]
variable (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- The canonical submodule from Lemma 10.67.2 is maximal among the submodules whose support is
nowhere dense in the support of `M`. -/
theorem embeddedPrimeFreeSubmodule_isMaximal_nowhereDense :
    Maximal
      (fun K : Submodule R M ↦
        IsNowhereDense { p : Module.support R M | (p : PrimeSpectrum R) ∈ Module.support R K })
      (embeddedPrimeFreeSubmodule R M) := sorry

/-- The quotient by the canonical submodule from Lemma 10.67.2 has the same support as `M`. -/
theorem support_quotient_embeddedPrimeFreeSubmodule :
    Module.support R (M ⧸ embeddedPrimeFreeSubmodule R M) =
      Module.support R M := sorry

/-- The quotient by the canonical submodule from Lemma 10.67.2 has no embedded associated
primes. -/
theorem embeddedAssociatedPrimes_quotient_embeddedPrimeFreeSubmodule :
    embeddedAssociatedPrimes R (M ⧸ embeddedPrimeFreeSubmodule R M) = ∅ := sorry

private theorem localizedMap_bijective_embeddedPrimeFreeSubmodule (f : R)
    (hf : ∀ p ∈ embeddedAssociatedPrimes R M, f ∈ p) :
    Function.Bijective
      (LocalizedModule.map (.powers f)
        (embeddedPrimeFreeSubmodule R M).mkQ) := sorry

-- Proof sketch: let `K` be the submodule of elements whose cyclic support is contained in the
-- union of the embedded associated primes of `M`. This submodule is maximal among those whose
-- support is nowhere dense in `Supp(M)`. The minimal points of `Supp(M)` survive in `M ⧸ K`,
-- giving equal support and removing embedded associated primes. After localizing away from an
-- element contained in every embedded associated prime, the localized submodule vanishes, so the
-- canonical localized quotient map is bijective.
/-- Lemma 10.67.2: a finite module over a Noetherian ring admits a maximal submodule whose
support is nowhere dense in the support of the ambient module, and the resulting quotient has the
same support, no embedded associated primes, and agrees with the original module after localizing
away from any element contained in every embedded associated prime. -/
theorem exists_maximal_nowhereDense_support_submodule_with_embeddedPrimeFree_quotient
    :
    ∃ K : Submodule R M,
      Maximal
        (fun K : Submodule R M ↦
          IsNowhereDense { p : Module.support R M | (p : PrimeSpectrum R) ∈ Module.support R K })
        K ∧
      Module.support R (M ⧸ K) = Module.support R M ∧
      embeddedAssociatedPrimes R (M ⧸ K) = ∅ ∧
      ∀ f : R,
        (∀ p ∈ embeddedAssociatedPrimes R M, f ∈ p) →
          Function.Bijective (LocalizedModule.map (.powers f) K.mkQ) := by
  refine ⟨embeddedPrimeFreeSubmodule R M, ?_, ?_, ?_, ?_⟩
  · exact embeddedPrimeFreeSubmodule_isMaximal_nowhereDense R M
  · exact support_quotient_embeddedPrimeFreeSubmodule R M
  · exact embeddedAssociatedPrimes_quotient_embeddedPrimeFreeSubmodule R M
  · intro f hf
    exact localizedMap_bijective_embeddedPrimeFreeSubmodule R M f hf

end
