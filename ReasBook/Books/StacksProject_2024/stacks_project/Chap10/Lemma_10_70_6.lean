import Mathlib
import StacksProject_2024.stacks_project.Chap10.Definition_10_70_1
import StacksProject_2024.stacks_project.Chap10.Lemma_10_70_3

-- Declarations for this item will be appended below by the statement pipeline.

universe u

noncomputable section

open MvPolynomial
open scoped AffineBlowupChart

/-
Domain-style sampling pass for Lemma 10.70.6.

Primary domain: commutative algebra of affine blowup charts and polynomial presentations.

Sampled owner declarations:
* `affineBlowupChart` and its notation `R[I / a]` from `Definition_10_70_1.lean`;
* `affineBlowupChartBasicFraction` from `Definition_10_70_1.lean`;
* `tensorToAffineBlowupAlgebra` and
  `affineBlowupChart_baseChange_surjective_and_ker_eq_primaryComponent` from
  `Lemma_10_70_3.lean`;
* `MvPolynomial.aeval` and `Ideal.Quotient.liftₐ` from mathlib's polynomial-quotient API.

Owner abstraction: the canonical quotient-to-chart map
`affineBlowupTuplePresentationMap f :
    let I : Ideal R := Ideal.span (Set.range f)
    let a : I := tupleSpanFirst f
    affineBlowupTuplePresentationQuotient f →ₐ[R] R[I / a]`.

Primitive data are the tuple-generated ideal, its distinguished first generator, the relations
`a₁ X i - aᵢ₊₁`, and the quotient presentation. The map to the affine blowup chart and the kernel
descriptions are derived API.

Source/core/bridge triage:
* source-facing: the canonical quotient presentation map and its `a₁`-power torsion kernel;
* core/canonical: the same kernel as a primary component;
* bridge/view: the polynomial evaluation map before passing to the quotient.
-/

section

variable {R : Type u} [CommRing R]
variable {r : ℕ} (f : Fin (r + 1) → R)

/-- The first tuple entry viewed as an element of the ideal `Ideal.span (Set.range f)`. -/
def tupleSpanFirst : Ideal.span (Set.range f) :=
  ⟨f 0, Ideal.subset_span ⟨0, rfl⟩⟩

/-- The relation `a₁ xᵢ - aᵢ₊₁` in the polynomial presentation over `R`. -/
def affineBlowupTuplePresentationRelation (i : Fin r) :
    MvPolynomial (Fin r) R :=
  C (f 0) * X i - C (f i.succ)

/-- The ideal generated by the relations `a₁ xᵢ - aᵢ₊₁` for `i = 1, …, r`. -/
def affineBlowupTuplePresentationRelationIdeal :
    Ideal (MvPolynomial (Fin r) R) :=
  Ideal.span (Set.range fun i : Fin r ↦ affineBlowupTuplePresentationRelation f i)

/-- The quotient presentation
`R[x₂, …, xᵣ₊₁] / (a₁ x₂ - a₂, …, a₁ xᵣ₊₁ - aᵣ₊₁)`. -/
abbrev affineBlowupTuplePresentationQuotient :=
  MvPolynomial (Fin r) R ⧸ affineBlowupTuplePresentationRelationIdeal f

private instance instModuleAffineBlowupTuplePresentationQuotient :
    Module (affineBlowupTuplePresentationQuotient f)
      (affineBlowupTuplePresentationQuotient f) :=
  Semiring.toModule

section

local notation "I" => Ideal.span (Set.range f)
local notation "a" => tupleSpanFirst f
local notation "Q" => affineBlowupTuplePresentationQuotient f
local notation "Chart" => R[I / a]

/-- The canonical generator `xᵢ ↦ aᵢ₊₁ / a₁` in the tuple presentation of the affine blowup
chart. -/
private def affineBlowupTuplePresentationGenerator (i : Fin r) : Chart :=
  affineBlowupChartBasicFraction I a
    ⟨f i.succ, Ideal.subset_span ⟨i.succ, rfl⟩⟩

/-- The polynomial map sending each presentation variable to the corresponding fraction
`aᵢ₊₁ / a₁` in the affine blowup chart. -/
private def affineBlowupTuplePresentationToBlowup :
    MvPolynomial (Fin r) R →ₐ[R] Chart :=
  MvPolynomial.aeval (affineBlowupTuplePresentationGenerator f)

/-- Each defining relation `a₁ xᵢ - aᵢ₊₁` maps to zero in the affine blowup chart. -/
private theorem affineBlowupTuplePresentationRelation_map_eq_zero (i : Fin r) :
    affineBlowupTuplePresentationToBlowup f (affineBlowupTuplePresentationRelation f i) = 0 :=
  sorry

/-- Every element of the relation ideal maps to zero in the affine blowup chart. -/
private theorem affineBlowupTuplePresentationRelationIdeal_map_eq_zero (φ : MvPolynomial (Fin r) R)
    (hφ : φ ∈ affineBlowupTuplePresentationRelationIdeal f) :
    affineBlowupTuplePresentationToBlowup f φ = 0 := sorry

-- Proof sketch: Example 10.70.5 gives the polynomial presentation before base change, and
-- Lemma 10.70.3 identifies the kernel after base change with the `a₁`-power torsion ideal.
/-- Lemma 10.70.6 (Stacks tag `0G8S`): the canonical quotient presentation map
`R[x₂, …, xᵣ₊₁] / (a₁ x₂ - a₂, …, a₁ xᵣ₊₁ - aᵣ₊₁) → R[I/a₁]`. -/
def affineBlowupTuplePresentationMap : Q →ₐ[R] Chart :=
  Ideal.Quotient.liftₐ (affineBlowupTuplePresentationRelationIdeal f)
    (affineBlowupTuplePresentationToBlowup f)
    (affineBlowupTuplePresentationRelationIdeal_map_eq_zero f)

end

/-- Membership in the kernel of the tuple-presentation map is exactly `a₁`-power torsion in the
source quotient. -/
theorem mem_ker_affineBlowupTuplePresentationMap_iff_exists_pow_mul_eq_zero
    (x : affineBlowupTuplePresentationQuotient f) :
    x ∈ RingHom.ker (affineBlowupTuplePresentationMap f).toRingHom ↔
      ∃ n : ℕ, (algebraMap R (affineBlowupTuplePresentationQuotient f) (f 0)) ^ n * x = 0 := sorry

/-- Lemma 10.70.6: the canonical quotient presentation map is surjective, and its kernel consists
exactly of the elements annihilated by some power of the image of `a₁`. -/
theorem affineBlowupTuplePresentationMap_surjective_and_ker_eq_a_power_torsion :
    let Q := affineBlowupTuplePresentationQuotient f
    let φ := affineBlowupTuplePresentationMap f
    let aQ : Q := algebraMap R Q (f 0)
    Function.Surjective φ ∧
      ∀ x : Q, x ∈ RingHom.ker φ.toRingHom ↔ ∃ n : ℕ, aQ ^ n * x = 0 := by
  refine ⟨?_, ?_⟩
  · sorry
  · intro x
    exact mem_ker_affineBlowupTuplePresentationMap_iff_exists_pow_mul_eq_zero f x

/-- Canonical reformulation of Lemma 10.70.6: the kernel of the quotient presentation map is the
primary component of the principal ideal generated by the image of `a₁`. -/
theorem affineBlowupTuplePresentationMap_surjective_and_ker_eq_primaryComponent :
    let Q := affineBlowupTuplePresentationQuotient f
    let φ := affineBlowupTuplePresentationMap f
    let aQ : Q := algebraMap R Q (f 0)
    Function.Surjective φ ∧
      RingHom.ker φ.toRingHom = (Ideal.span ({aQ} : Set Q)).primaryComponent Q := by
  let Q := affineBlowupTuplePresentationQuotient f
  let φ := affineBlowupTuplePresentationMap f
  let aQ : Q := algebraMap R Q (f 0)
  change Function.Surjective φ ∧
    RingHom.ker φ.toRingHom = (Ideal.span ({aQ} : Set Q)).primaryComponent Q
  refine ⟨(affineBlowupTuplePresentationMap_surjective_and_ker_eq_a_power_torsion f).1, ?_⟩
  ext x
  rw [Ideal.primaryComponent_mem]
  constructor
  · intro hx
    rcases
      (affineBlowupTuplePresentationMap_surjective_and_ker_eq_a_power_torsion f).2 x |>.mp hx with
        ⟨n, hn⟩
    have hn' : aQ ^ n * x = 0 := by
      simpa [aQ] using hn
    refine ⟨n, ?_⟩
    rw [Submodule.mem_torsionBySet_iff]
    intro y
    rcases y with ⟨y, hy⟩
    rw [Ideal.span_singleton_pow] at hy
    change y ∈ Ideal.span ({aQ ^ n} : Set Q) at hy
    rw [Ideal.mem_span_singleton'] at hy
    rcases hy with ⟨c, rfl⟩
    simp [smul_eq_mul, mul_assoc, hn']
  · rintro ⟨n, hx⟩
    refine
      (affineBlowupTuplePresentationMap_surjective_and_ker_eq_a_power_torsion f).2 x |>.mpr ⟨n, ?_⟩
    rw [Submodule.mem_torsionBySet_iff] at hx
    simpa [smul_eq_mul, Ideal.span_singleton_pow] using
      hx ⟨aQ ^ n, by
        rw [Ideal.span_singleton_pow]
        exact Ideal.subset_span (by simp)⟩

end
