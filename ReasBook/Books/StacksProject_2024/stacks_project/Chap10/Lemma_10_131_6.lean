import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v w z

/-
Domain triage:
* primary domain: functoriality of Kähler differentials for a commutative-algebra square with a
  surjective top map;
* sampled owner API:
  `KaehlerDifferential.map`,
  `KaehlerDifferential.map_surjective_of_surjective`,
  `KaehlerDifferential.ker_map`,
  `KaehlerDifferential.kerTotal_map`;
* source-facing layer: the Stacks-project kernel description in terms of differentials of elements
  of `S` whose image in `S'` comes from `R'`;
* core/canonical owner: `KaehlerDifferential.map`;
* bridge/view: the pullback subalgebra of `range (R' → S')` along `S → S'`.

Primitive data are just the commutative square and the surjectivity hypothesis. The induced map on
Kähler differentials is owner data upstream, while the pullback-subalgebra generating set is the
source-facing view used to restate the owner kernel description.
-/

open IsScalarTower (toAlgHom)
open KaehlerDifferential

variable (R : Type u) (R' : Type v) {S : Type w} {S' : Type z}
  [CommRing R] [CommRing R'] [CommRing S] [CommRing S']
  [Algebra R S] [Algebra R R'] [Algebra R S'] [Algebra R' S'] [Algebra S S']
  [IsScalarTower R S S'] [IsScalarTower R R' S']

-- Proof sketch: combine the owner presentation theorem `KaehlerDifferential.kerTotal_map` with the
-- quotient description `KaehlerDifferential.ker_map`, then rewrite the remaining free-module
-- generator span through the pullback subalgebra.
/-- The pullback-span description of the presentation-level kernel used in Lemma 10.131.6. -/
private theorem presentationComap_map_eq_span_d_mem_pullback :
    (((kerTotal R' S').restrictScalars S).comap
        ((Finsupp.mapRange.linearMap (Algebra.linearMap S S')).comp
          (Finsupp.lmapDomain S S (algebraMap S S')))).map
        (Finsupp.linearCombination S (D R S)) =
      Submodule.span S
        (Set.range fun a :
          Subalgebra.comap (toAlgHom R S S') (toAlgHom R R' S').range ↦ D R S a.1) := sorry

-- Proof sketch: the surjectivity clause is the owner theorem
-- `KaehlerDifferential.map_surjective_of_surjective`. For the kernel, specialize the owner kernel
-- description `KaehlerDifferential.ker_map` to this square and rewrite it through the source-facing
-- pullback subalgebra `Subalgebra.comap (toAlgHom R S S') (toAlgHom R R' S').range`.
/-- Lemma 10.131.6: if `S → S'` is surjective in a commutative square
`R → S`, `R → R'`, `R' → S'`, `S → S'`, then the induced map
`Ω[S⁄R] → Ω[S'⁄R']` is surjective, and its kernel is the `S`-submodule generated by the
differentials `d a` of elements whose image in `S'` lies in the image of `R' → S'`. In
particular, this generating set contains every `d i` with `i` in the kernel of `S → S'`. -/
theorem kaehlerDifferential_map_surjective_and_ker_eq_span_d_mem_range
    (hφ : Function.Surjective (algebraMap S S')) :
    Function.Surjective (map R R' S S') ∧
      LinearMap.ker (map R R' S S') =
        Submodule.span S
          (Set.range fun a :
            Subalgebra.comap (toAlgHom R S S') (toAlgHom R R' S').range ↦ D R S a.1) := sorry
