import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

noncomputable section

open CategoryTheory

universe u₁ u₂

section GrothendieckGroups

variable (R : Type u₁) [Ring R]

/-- The subgroup generated by short-exact-sequence relations for modules satisfying `P`. -/
def modulePropertyK0Relations (P : ObjectProperty (ModuleCat R)) :
    AddSubgroup (FreeAbelianGroup P.FullSubcategory) :=
  AddSubgroup.closure <| Set.range fun S :
      { S : ShortComplex P.FullSubcategory // (S.map P.ι).ShortExact } ↦
    FreeAbelianGroup.of S.1.X₂ - FreeAbelianGroup.of S.1.X₁ - FreeAbelianGroup.of S.1.X₃

/-- The Grothendieck group attached to an object property in `ModuleCat R`. -/
abbrev ModulePropertyK0 (P : ObjectProperty (ModuleCat R)) :=
  FreeAbelianGroup P.FullSubcategory ⧸ modulePropertyK0Relations R P

namespace ModulePropertyK0

/-- The class of a module satisfying `P` in its Grothendieck group. -/
abbrev of (P : ObjectProperty (ModuleCat R)) (M : P.FullSubcategory) :
    ModulePropertyK0 R P :=
  QuotientAddGroup.mk' (modulePropertyK0Relations R P) (FreeAbelianGroup.of M)

/-- An additive invariant on modules satisfying `P` descends to the Grothendieck group as soon as
it vanishes on the defining short-exact-sequence relations. -/
def lift {P : ObjectProperty (ModuleCat R)} {A : Type u₂} [AddCommGroup A]
    (f : P.FullSubcategory → A)
    (hf : modulePropertyK0Relations R P ≤ (FreeAbelianGroup.lift f).ker) :
    ModulePropertyK0 R P →+ A :=
  QuotientAddGroup.lift (modulePropertyK0Relations R P) (FreeAbelianGroup.lift f) hf

/-- The descended additive invariant evaluates on a generator class by the original function. -/
@[simp] theorem lift_of {P : ObjectProperty (ModuleCat R)} {A : Type u₂} [AddCommGroup A]
    (f : P.FullSubcategory → A)
    (hf : modulePropertyK0Relations R P ≤ (FreeAbelianGroup.lift f).ker)
    (M : P.FullSubcategory) :
    ModulePropertyK0.lift R f hf (ModulePropertyK0.of R P M) = f M := by
  simp [ModulePropertyK0.lift, ModulePropertyK0.of]

private theorem relations_le_ker_map {P Q : ObjectProperty (ModuleCat R)} (hPQ : P ≤ Q) :
    modulePropertyK0Relations R P ≤
      (FreeAbelianGroup.lift fun M : P.FullSubcategory ↦
        ModulePropertyK0.of R Q ((ObjectProperty.ιOfLE hPQ).obj M)).ker := by
  rw [modulePropertyK0Relations, AddSubgroup.closure_le]
  rintro _ ⟨⟨S, hS⟩, rfl⟩
  change
    FreeAbelianGroup.lift
        (fun M : P.FullSubcategory ↦ ModulePropertyK0.of R Q ((ObjectProperty.ιOfLE hPQ).obj M))
        (FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  change
    QuotientAddGroup.mk' (modulePropertyK0Relations R Q)
      (FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₂) -
        FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₁) -
        FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₃)) =
      QuotientAddGroup.mk' (modulePropertyK0Relations R Q) 0
  rw [QuotientAddGroup.mk'_eq_mk']
  refine ⟨-(
      FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₂) -
        FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₁) -
        FreeAbelianGroup.of ((ObjectProperty.ιOfLE hPQ).obj S.X₃)), ?_, by simp⟩
  exact AddSubgroup.neg_mem _ <|
    AddSubgroup.subset_closure <| Set.mem_range.2 ⟨⟨S.map (ObjectProperty.ιOfLE hPQ), by
      simpa using hS⟩, rfl⟩

/-- An inclusion `P ≤ Q` of object properties induces the canonical map `K₀(P) → K₀(Q)`. -/
def map {P Q : ObjectProperty (ModuleCat R)} (hPQ : P ≤ Q) :
    ModulePropertyK0 R P →+ ModulePropertyK0 R Q :=
  ModulePropertyK0.lift R
    (fun M : P.FullSubcategory ↦ ModulePropertyK0.of R Q ((ObjectProperty.ιOfLE hPQ).obj M))
    (relations_le_ker_map R hPQ)

/-- The canonical map induced by `P ≤ Q` sends the class of an object of `P` to its class in `Q`.
-/
@[simp] theorem map_of {P Q : ObjectProperty (ModuleCat R)} (hPQ : P ≤ Q)
    (M : P.FullSubcategory) :
    ModulePropertyK0.map R hPQ (ModulePropertyK0.of R P M) =
      ModulePropertyK0.of R Q ((ObjectProperty.ιOfLE hPQ).obj M) := by
  rfl

end ModulePropertyK0

/-- The object property of finitely generated projective `R`-modules in `ModuleCat R`. -/
abbrev finiteProjectiveModuleProperty : ObjectProperty (ModuleCat R) :=
  fun M ↦ Module.Finite R M ∧ Module.Projective R M

/-- A finitely generated projective module is, in particular, finitely generated. -/
theorem finiteProjectiveModuleProperty_le_isFG :
    finiteProjectiveModuleProperty R ≤ ModuleCat.isFG R := fun _ hM ↦ hM.1

/-- The full subcategory of finitely generated projective `R`-modules. -/
abbrev FiniteProjectiveModuleCat :=
  (finiteProjectiveModuleProperty R).FullSubcategory

instance (M : FiniteProjectiveModuleCat R) : Module.Finite R M.obj :=
  M.2.1

instance (M : FiniteProjectiveModuleCat R) : Module.Projective R M.obj :=
  M.2.2

/-- The Grothendieck group `K₀(R)` of finitely generated projective `R`-modules. -/
abbrev projectiveGrothendieckGroup :=
  ModulePropertyK0 R (finiteProjectiveModuleProperty R)

/-- The class of a finitely generated projective `R`-module in `K₀(R)`. -/
abbrev projectiveGrothendieckGroupOf (M : FiniteProjectiveModuleCat R) :
    projectiveGrothendieckGroup R :=
  ModulePropertyK0.of R (finiteProjectiveModuleProperty R) M

/-- The Grothendieck group `K'_0(R)` of finitely generated `R`-modules. -/
abbrev finiteGrothendieckGroup :=
  ModulePropertyK0 R (ModuleCat.isFG R)

/-- The class of a finitely generated `R`-module in `K'_0(R)`. -/
abbrev finiteGrothendieckGroupOf (M : FGModuleCat R) :
    finiteGrothendieckGroup R :=
  ModulePropertyK0.of R (ModuleCat.isFG R) M

end GrothendieckGroups

section ProductFactors

variable (R₁ : Type u₁) (R₂ : Type u₂) [CommRing R₁] [CommRing R₂]

/-- The left idempotent of the product ring `R₁ × R₂`. -/
private abbrev leftIdempotent : R₁ × R₂ := (1, 0)

/-- The right idempotent of the product ring `R₁ × R₂`. -/
private abbrev rightIdempotent : R₁ × R₂ := (0, 1)

/-- The `R₁`-factor of an `(R₁ × R₂)`-module, encoded as the submodule killed by `(0, 1)`. -/
private def leftFactorSubmodule (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    Submodule (R₁ × R₂) M where
  carrier := { m | (rightIdempotent R₁ R₂) • m = 0 }
  zero_mem' := by
    simp [rightIdempotent]
  add_mem' := by
    intro m n hm hn
    show (rightIdempotent R₁ R₂) • (m + n) = 0
    rw [smul_add, hm, hn]
    simp
  smul_mem' := by
    intro a m hm
    show (rightIdempotent R₁ R₂) • (a • m) = 0
    rw [smul_smul, mul_comm, ← smul_smul, hm, smul_zero]

/-- The `R₂`-factor of an `(R₁ × R₂)`-module, encoded as the submodule killed by `(1, 0)`. -/
private def rightFactorSubmodule (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    Submodule (R₁ × R₂) M where
  carrier := { m | (leftIdempotent R₁ R₂) • m = 0 }
  zero_mem' := by
    simp [leftIdempotent]
  add_mem' := by
    intro m n hm hn
    show (leftIdempotent R₁ R₂) • (m + n) = 0
    rw [smul_add, hm, hn]
    simp
  smul_mem' := by
    intro a m hm
    show (leftIdempotent R₁ R₂) • (a • m) = 0
    rw [smul_smul, mul_comm, ← smul_smul, hm, smul_zero]

private instance leftFactorSubmodule_module
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    Module R₁ (leftFactorSubmodule R₁ R₂ M) where
  smul r m := ⟨((r, (0 : R₂)) : R₁ × R₂) • m.1, by
    show (rightIdempotent R₁ R₂) • (((r, (0 : R₂)) : R₁ × R₂) • m.1) = 0
    rw [smul_smul]
    have hmul :
        (rightIdempotent R₁ R₂) * (((r, (0 : R₂)) : R₁ × R₂)) = 0 := by
      ext <;> simp [rightIdempotent]
    rw [hmul, zero_smul]
  ⟩
  one_smul m := by
    apply Subtype.ext
    calc
      (((1 : R₁), (0 : R₂)) : R₁ × R₂) • m.1
          = ((((1 : R₁), (0 : R₂)) : R₁ × R₂) + rightIdempotent R₁ R₂) • m.1 := by
              rw [add_smul, Subtype.mem m, add_zero]
      _ = m.1 := by
        have hsum :
            ((((1 : R₁), (0 : R₂)) : R₁ × R₂) + rightIdempotent R₁ R₂) = 1 := by
          ext <;> simp [rightIdempotent]
        rw [hsum]
        exact one_smul (R₁ × R₂) (m.1 : M)
  mul_smul a b m := by
    apply Subtype.ext
    change (((a * b : R₁), (0 : R₂)) : R₁ × R₂) • m.1 =
        (((a : R₁), (0 : R₂)) : R₁ × R₂) •
          ((((b : R₁), (0 : R₂)) : R₁ × R₂) • m.1)
    simp [smul_smul]
  smul_zero a := by
    apply Subtype.ext
    show (((a : R₁), (0 : R₂)) : R₁ × R₂) • (0 : M) = 0
    simp
  smul_add a m n := by
    apply Subtype.ext
    show (((a : R₁), (0 : R₂)) : R₁ × R₂) • (m.1 + n.1) =
        (((a : R₁), (0 : R₂)) : R₁ × R₂) • m.1 +
          (((a : R₁), (0 : R₂)) : R₁ × R₂) • n.1
    rw [smul_add]
  zero_smul m := by
    apply Subtype.ext
    change (((0 : R₁), (0 : R₂)) : R₁ × R₂) • m.1 = 0
    exact (show (0 : R₁ × R₂) • (m.1 : M) = 0 from zero_smul (R₁ × R₂) (m.1 : M))
  add_smul a b m := by
    apply Subtype.ext
    change (((a + b : R₁), (0 : R₂)) : R₁ × R₂) • m.1 =
        ((((a : R₁), (0 : R₂)) : R₁ × R₂) • m.1) +
          ((((b : R₁), (0 : R₂)) : R₁ × R₂) • m.1)
    have hadd :
        (((a + b : R₁), (0 : R₂)) : R₁ × R₂) =
          (((a : R₁), (0 : R₂)) : R₁ × R₂) + (((b : R₁), (0 : R₂)) : R₁ × R₂) := by
      ext <;> simp
    rw [hadd, add_smul]

private instance rightFactorSubmodule_module
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    Module R₂ (rightFactorSubmodule R₁ R₂ M) where
  smul r m := ⟨(((0 : R₁), r) : R₁ × R₂) • m.1, by
    show (leftIdempotent R₁ R₂) • ((((0 : R₁), r) : R₁ × R₂) • m.1) = 0
    rw [smul_smul]
    have hmul :
        (leftIdempotent R₁ R₂) * ((((0 : R₁), r) : R₁ × R₂)) = 0 := by
      ext <;> simp [leftIdempotent]
    rw [hmul, zero_smul]
  ⟩
  one_smul m := by
    apply Subtype.ext
    calc
      (((0 : R₁), (1 : R₂)) : R₁ × R₂) • m.1
          = ((((0 : R₁), (1 : R₂)) : R₁ × R₂) + leftIdempotent R₁ R₂) • m.1 := by
              rw [add_smul, Subtype.mem m, add_zero]
      _ = m.1 := by
        have hsum :
            ((((0 : R₁), (1 : R₂)) : R₁ × R₂) + leftIdempotent R₁ R₂) = 1 := by
          ext <;> simp [leftIdempotent]
        rw [hsum]
        exact one_smul (R₁ × R₂) (m.1 : M)
  mul_smul a b m := by
    apply Subtype.ext
    change (((0 : R₁), (a * b : R₂)) : R₁ × R₂) • m.1 =
        (((0 : R₁), (a : R₂)) : R₁ × R₂) •
          ((((0 : R₁), (b : R₂)) : R₁ × R₂) • m.1)
    simp [smul_smul]
  smul_zero a := by
    apply Subtype.ext
    show (((0 : R₁), (a : R₂)) : R₁ × R₂) • (0 : M) = 0
    simp
  smul_add a m n := by
    apply Subtype.ext
    show (((0 : R₁), (a : R₂)) : R₁ × R₂) • (m.1 + n.1) =
        (((0 : R₁), (a : R₂)) : R₁ × R₂) • m.1 +
          (((0 : R₁), (a : R₂)) : R₁ × R₂) • n.1
    rw [smul_add]
  zero_smul m := by
    apply Subtype.ext
    change (((0 : R₁), (0 : R₂)) : R₁ × R₂) • m.1 = 0
    exact (show (0 : R₁ × R₂) • (m.1 : M) = 0 from zero_smul (R₁ × R₂) (m.1 : M))
  add_smul a b m := by
    apply Subtype.ext
    change (((0 : R₁), (a + b : R₂)) : R₁ × R₂) • m.1 =
        ((((0 : R₁), (a : R₂)) : R₁ × R₂) • m.1) +
          ((((0 : R₁), (b : R₂)) : R₁ × R₂) • m.1)
    have hadd :
        (((0 : R₁), (a + b : R₂)) : R₁ × R₂) =
          (((0 : R₁), (a : R₂)) : R₁ × R₂) + (((0 : R₁), (b : R₂)) : R₁ × R₂) := by
      ext <;> simp
    rw [hadd, add_smul]

private abbrev leftFactorModuleCat (M : ModuleCat (R₁ × R₂)) : ModuleCat R₁ :=
  ModuleCat.of R₁ (leftFactorSubmodule R₁ R₂ M)

private abbrev rightFactorModuleCat (M : ModuleCat (R₁ × R₂)) : ModuleCat R₂ :=
  ModuleCat.of R₂ (rightFactorSubmodule R₁ R₂ M)

private def leftFactorElement (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] (m : M) :
    leftFactorSubmodule R₁ R₂ M :=
  ⟨(leftIdempotent R₁ R₂) • m, by
    show (rightIdempotent R₁ R₂) • ((leftIdempotent R₁ R₂) • m) = 0
    rw [smul_smul]
    have hmul : (rightIdempotent R₁ R₂) * leftIdempotent R₁ R₂ = 0 := by
      ext <;> simp [leftIdempotent, rightIdempotent]
    rw [hmul, zero_smul]⟩

private def rightFactorElement (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] (m : M) :
    rightFactorSubmodule R₁ R₂ M :=
  ⟨(rightIdempotent R₁ R₂) • m, by
    show (leftIdempotent R₁ R₂) • ((rightIdempotent R₁ R₂) • m) = 0
    rw [smul_smul]
    have hmul : (leftIdempotent R₁ R₂) * rightIdempotent R₁ R₂ = 0 := by
      ext <;> simp [leftIdempotent, rightIdempotent]
    rw [hmul, zero_smul]⟩

private def leftFactorFiniteMap
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] {n : ℕ}
    (f : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M) :
    (Fin n → R₁) →ₗ[R₁] leftFactorSubmodule R₁ R₂ M where
  toFun x := ⟨f fun i ↦ (x i, 0), by
    show (rightIdempotent R₁ R₂) • f (fun i ↦ (x i, 0)) = 0
    rw [← f.map_smul]
    have hzero : (rightIdempotent R₁ R₂) • (fun i ↦ (x i, (0 : R₂))) = 0 := by
      ext i <;> simp [rightIdempotent]
    rw [hzero, map_zero]⟩
  map_add' x y := by
    apply Subtype.ext
    change f (fun i ↦ ((x + y) i, (0 : R₂))) =
      f (fun i ↦ (x i, (0 : R₂))) + f (fun i ↦ (y i, (0 : R₂)))
    rw [show (fun i ↦ ((x + y) i, (0 : R₂))) =
        (fun i ↦ (x i, (0 : R₂))) + fun i ↦ (y i, (0 : R₂)) by
          ext i <;> simp]
    exact map_add f _ _
  map_smul' a x := by
    apply Subtype.ext
    change f (fun i ↦ ((a • x) i, (0 : R₂))) =
      (((a : R₁), (0 : R₂)) : R₁ × R₂) • f (fun i ↦ (x i, (0 : R₂)))
    rw [show (fun i ↦ ((a • x) i, (0 : R₂))) =
        (((a : R₁), (0 : R₂)) : R₁ × R₂) • fun i ↦ (x i, (0 : R₂)) by
          ext i <;> simp]
    exact map_smul f _ _

private def rightFactorFiniteMap
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] {n : ℕ}
    (f : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M) :
    (Fin n → R₂) →ₗ[R₂] rightFactorSubmodule R₁ R₂ M where
  toFun x := ⟨f fun i ↦ (0, x i), by
    show (leftIdempotent R₁ R₂) • f (fun i ↦ ((0 : R₁), x i)) = 0
    rw [← f.map_smul]
    have hzero : (leftIdempotent R₁ R₂) • (fun i ↦ ((0 : R₁), x i)) = 0 := by
      ext i <;> simp [leftIdempotent]
    rw [hzero, map_zero]⟩
  map_add' x y := by
    apply Subtype.ext
    change f (fun i ↦ ((0 : R₁), (x + y) i)) =
      f (fun i ↦ ((0 : R₁), x i)) + f (fun i ↦ ((0 : R₁), y i))
    rw [show (fun i ↦ ((0 : R₁), (x + y) i)) =
        (fun i ↦ ((0 : R₁), x i)) + fun i ↦ ((0 : R₁), y i) by
          ext i <;> simp]
    exact map_add f _ _
  map_smul' a x := by
    apply Subtype.ext
    change f (fun i ↦ ((0 : R₁), (a • x) i)) =
      (((0 : R₁), (a : R₂)) : R₁ × R₂) • f (fun i ↦ ((0 : R₁), x i))
    rw [show (fun i ↦ ((0 : R₁), (a • x) i)) =
        (((0 : R₁), (a : R₂)) : R₁ × R₂) • fun i ↦ ((0 : R₁), x i) by
          ext i <;> simp]
    exact map_smul f _ _

private theorem leftFactorFiniteMap_surjective
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] {n : ℕ}
    (f : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M) (hf : Function.Surjective f) :
    Function.Surjective (leftFactorFiniteMap R₁ R₂ f) := by
  intro m
  obtain ⟨x, hx⟩ := hf m.1
  refine ⟨fun i ↦ (x i).1, ?_⟩
  apply Subtype.ext
  change f (fun i ↦ ((x i).1, (0 : R₂))) = m.1
  rw [show (fun i ↦ ((x i).1, (0 : R₂))) = (leftIdempotent R₁ R₂) • x by
    ext i <;> simp [leftIdempotent]]
  rw [map_smul, hx]
  calc
    (leftIdempotent R₁ R₂) • m.1
        = (leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂) • m.1 := by
            rw [add_smul, Subtype.mem m, add_zero]
    _ = m.1 := by
      have hsum : leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂ = 1 := by
        ext <;> simp [leftIdempotent, rightIdempotent]
      rw [hsum, one_smul]

private theorem rightFactorFiniteMap_surjective
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] {n : ℕ}
    (f : (Fin n → R₁ × R₂) →ₗ[R₁ × R₂] M) (hf : Function.Surjective f) :
    Function.Surjective (rightFactorFiniteMap R₁ R₂ f) := by
  intro m
  obtain ⟨x, hx⟩ := hf m.1
  refine ⟨fun i ↦ (x i).2, ?_⟩
  apply Subtype.ext
  change f (fun i ↦ ((0 : R₁), (x i).2)) = m.1
  rw [show (fun i ↦ ((0 : R₁), (x i).2)) = (rightIdempotent R₁ R₂) • x by
    ext i <;> simp [rightIdempotent]]
  rw [map_smul, hx]
  calc
    (rightIdempotent R₁ R₂) • m.1
        = (leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂) • m.1 := by
            rw [add_smul, Subtype.mem m, zero_add]
    _ = m.1 := by
      have hsum : leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂ = 1 := by
        ext <;> simp [leftIdempotent, rightIdempotent]
      rw [hsum, one_smul]

private def leftFactorLinearCombination
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    (M →₀ R₁) →ₗ[R₁] leftFactorSubmodule R₁ R₂ M :=
  Finsupp.linearCombination R₁ (leftFactorElement R₁ R₂ M)

private def rightFactorLinearCombination
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] :
    (M →₀ R₂) →ₗ[R₂] rightFactorSubmodule R₁ R₂ M :=
  Finsupp.linearCombination R₂ (rightFactorElement R₁ R₂ M)

private def leftFactorProjectiveSection
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (s : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂)) :
    leftFactorSubmodule R₁ R₂ M →ₗ[R₁] M →₀ R₁ where
  toFun m := (s m.1).mapRange Prod.fst (by simp)
  map_add' m n := by
    ext x
    simp
  map_smul' a m := by
    ext x
    change Prod.fst (s ((((a : R₁), (0 : R₂)) : R₁ × R₂) • m.1) x) =
      a * Prod.fst (s m.1 x)
    rw [s.map_smul]
    simp

private def rightFactorProjectiveSection
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (s : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂)) :
    rightFactorSubmodule R₁ R₂ M →ₗ[R₂] M →₀ R₂ where
  toFun m := (s m.1).mapRange Prod.snd (by simp)
  map_add' m n := by
    ext x
    simp
  map_smul' a m := by
    ext x
    change Prod.snd (s ((((0 : R₁), (a : R₂)) : R₁ × R₂) • m.1) x) =
      a * Prod.snd (s m.1 x)
    rw [s.map_smul]
    simp

private theorem leftIdempotent_smul_leftFactor
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (m : leftFactorSubmodule R₁ R₂ M) :
    (leftIdempotent R₁ R₂) • m.1 = m.1 := by
  calc
    (leftIdempotent R₁ R₂) • m.1
        = (leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂) • m.1 := by
            rw [add_smul, Subtype.mem m, add_zero]
    _ = m.1 := by
      have hsum : leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂ = 1 := by
        ext <;> simp [leftIdempotent, rightIdempotent]
      rw [hsum, one_smul]

private theorem rightIdempotent_smul_rightFactor
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (m : rightFactorSubmodule R₁ R₂ M) :
    (rightIdempotent R₁ R₂) • m.1 = m.1 := by
  calc
    (rightIdempotent R₁ R₂) • m.1
        = (leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂) • m.1 := by
            rw [add_smul, Subtype.mem m, zero_add]
    _ = m.1 := by
      have hsum : leftIdempotent R₁ R₂ + rightIdempotent R₁ R₂ = 1 := by
        ext <;> simp [leftIdempotent, rightIdempotent]
      rw [hsum, one_smul]

private theorem leftFactor_sum
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] (x : M →₀ (R₁ × R₂)) :
    (((x.sum fun a b ↦ b.1 • leftFactorElement R₁ R₂ M a) : leftFactorSubmodule R₁ R₂ M) : M) =
      (leftIdempotent R₁ R₂) • x.sum fun i a ↦ a • i := by
  classical
  induction x using Finsupp.induction_linear with
  | zero =>
      simp [leftIdempotent]
  | add x y hx hy =>
      simp [Finsupp.sum_add_index, hx, hy, add_smul]
  | single a b =>
      simp [Finsupp.sum_single_index]
      change (((((b.1 : R₁), (0 : R₂)) : R₁ × R₂) • ((leftIdempotent R₁ R₂) • a) : M)) =
        (leftIdempotent R₁ R₂) • (b • a)
      rw [smul_smul, smul_smul]
      congr 1
      ext <;> simp [leftIdempotent]

private theorem rightFactor_sum
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M] (x : M →₀ (R₁ × R₂)) :
    (((x.sum fun a b ↦ b.2 • rightFactorElement R₁ R₂ M a) : rightFactorSubmodule R₁ R₂ M) : M) =
      (rightIdempotent R₁ R₂) • x.sum fun i a ↦ a • i := by
  classical
  induction x using Finsupp.induction_linear with
  | zero =>
      simp [rightIdempotent]
  | add x y hx hy =>
      simp [Finsupp.sum_add_index, hx, hy, add_smul]
  | single a b =>
      simp [Finsupp.sum_single_index]
      change (((((0 : R₁), (b.2 : R₂)) : R₁ × R₂) • ((rightIdempotent R₁ R₂) • a) : M)) =
        (rightIdempotent R₁ R₂) • (b • a)
      rw [smul_smul, smul_smul]
      congr 1
      ext <;> simp [rightIdempotent]

private theorem leftFactorLinearCombination_section
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (s : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂))
    (hs : Function.LeftInverse (Finsupp.linearCombination (R₁ × R₂) id) s) :
    (leftFactorLinearCombination R₁ R₂ M).comp (leftFactorProjectiveSection R₁ R₂ s) =
      LinearMap.id := by
  ext m
  have hm : (leftIdempotent R₁ R₂) • Finsupp.linearCombination (R₁ × R₂) id (s m.1) = m.1 := by
    simpa [leftIdempotent_smul_leftFactor R₁ R₂ m] using
      congrArg (fun z : M ↦ (leftIdempotent R₁ R₂) • z) (hs m.1)
  calc
    (((leftFactorLinearCombination R₁ R₂ M) ((leftFactorProjectiveSection R₁ R₂ s) m)) : M)
        = (leftIdempotent R₁ R₂) • Finsupp.linearCombination (R₁ × R₂) id (s m.1) := by
            simpa [leftFactorLinearCombination, leftFactorProjectiveSection,
              Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index] using
              leftFactor_sum R₁ R₂ (s m.1)
    _ = m.1 := hm

private theorem rightFactorLinearCombination_section
    {M : Type _} [AddCommGroup M] [Module (R₁ × R₂) M]
    (s : M →ₗ[R₁ × R₂] M →₀ (R₁ × R₂))
    (hs : Function.LeftInverse (Finsupp.linearCombination (R₁ × R₂) id) s) :
    (rightFactorLinearCombination R₁ R₂ M).comp (rightFactorProjectiveSection R₁ R₂ s) =
      LinearMap.id := by
  ext m
  have hm : (rightIdempotent R₁ R₂) • Finsupp.linearCombination (R₁ × R₂) id (s m.1) = m.1 := by
    simpa [rightIdempotent_smul_rightFactor R₁ R₂ m] using
      congrArg (fun z : M ↦ (rightIdempotent R₁ R₂) • z) (hs m.1)
  calc
    (((rightFactorLinearCombination R₁ R₂ M) ((rightFactorProjectiveSection R₁ R₂ s) m)) : M)
        = (rightIdempotent R₁ R₂) • Finsupp.linearCombination (R₁ × R₂) id (s m.1) := by
            simpa [rightFactorLinearCombination, rightFactorProjectiveSection,
              Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index] using
              rightFactor_sum R₁ R₂ (s m.1)
    _ = m.1 := hm

private instance leftFactorModule_finite
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] [Module.Finite (R₁ × R₂) M] :
    Module.Finite R₁ (leftFactorSubmodule R₁ R₂ M) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' (R₁ × R₂) M
  exact Module.Finite.of_surjective (leftFactorFiniteMap R₁ R₂ f)
    (leftFactorFiniteMap_surjective R₁ R₂ f hf)

private instance rightFactorModule_finite
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] [Module.Finite (R₁ × R₂) M] :
    Module.Finite R₂ (rightFactorSubmodule R₁ R₂ M) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' (R₁ × R₂) M
  exact Module.Finite.of_surjective (rightFactorFiniteMap R₁ R₂ f)
    (rightFactorFiniteMap_surjective R₁ R₂ f hf)

private instance leftFactorModule_projective
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] [Module.Projective (R₁ × R₂) M] :
    Module.Projective R₁ (leftFactorSubmodule R₁ R₂ M) := by
  obtain ⟨s, hs⟩ := ‹Module.Projective (R₁ × R₂) M›
  exact Module.Projective.of_split
    (leftFactorProjectiveSection R₁ R₂ s)
    (leftFactorLinearCombination R₁ R₂ M)
    (leftFactorLinearCombination_section R₁ R₂ s hs)

private instance rightFactorModule_projective
    (M : Type _) [AddCommGroup M] [Module (R₁ × R₂) M] [Module.Projective (R₁ × R₂) M] :
    Module.Projective R₂ (rightFactorSubmodule R₁ R₂ M) := by
  obtain ⟨s, hs⟩ := ‹Module.Projective (R₁ × R₂) M›
  exact Module.Projective.of_split
    (rightFactorProjectiveSection R₁ R₂ s)
    (rightFactorLinearCombination R₁ R₂ M)
    (rightFactorLinearCombination_section R₁ R₂ s hs)

/-- A finite projective `(R₁ × R₂)`-module determines a finite projective `R₁`-module by taking
the factor cut out by the idempotent `(1, 0)`. -/
abbrev leftFactorFiniteProjective
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) : FiniteProjectiveModuleCat R₁ :=
  letI : Module.Finite (R₁ × R₂) M.obj := M.property.1
  letI : Module.Projective (R₁ × R₂) M.obj := M.property.2
  ⟨leftFactorModuleCat R₁ R₂ M.obj, ⟨inferInstance, inferInstance⟩⟩

/-- A finite projective `(R₁ × R₂)`-module determines a finite projective `R₂`-module by taking
the factor cut out by the idempotent `(0, 1)`. -/
abbrev rightFactorFiniteProjective
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) : FiniteProjectiveModuleCat R₂ :=
  letI : Module.Finite (R₁ × R₂) M.obj := M.property.1
  letI : Module.Projective (R₁ × R₂) M.obj := M.property.2
  ⟨rightFactorModuleCat R₁ R₂ M.obj, ⟨inferInstance, inferInstance⟩⟩

/-- A finite `(R₁ × R₂)`-module determines a finite `R₁`-module by taking the factor cut out by
the idempotent `(1, 0)`. -/
abbrev leftFactorFinite
    (M : FGModuleCat (R₁ × R₂)) : FGModuleCat R₁ :=
  letI : Module.Finite (R₁ × R₂) M.obj := M.property
  ⟨leftFactorModuleCat R₁ R₂ M.obj, by
    rw [ModuleCat.isFG_iff]
    infer_instance⟩

/-- A finite `(R₁ × R₂)`-module determines a finite `R₂`-module by taking the factor cut out by
the idempotent `(0, 1)`. -/
abbrev rightFactorFinite
    (M : FGModuleCat (R₁ × R₂)) : FGModuleCat R₂ :=
  letI : Module.Finite (R₁ × R₂) M.obj := M.property
  ⟨rightFactorModuleCat R₁ R₂ M.obj, by
    rw [ModuleCat.isFG_iff]
    infer_instance⟩

private abbrev projectiveGrothendieckGroupFactorPair
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) :
    projectiveGrothendieckGroup R₁ × projectiveGrothendieckGroup R₂ :=
  ( projectiveGrothendieckGroupOf R₁ (leftFactorFiniteProjective R₁ R₂ M)
  , projectiveGrothendieckGroupOf R₂ (rightFactorFiniteProjective R₁ R₂ M) )

private theorem projectiveGrothendieckGroup_relations_le_ker_prodMap :
    modulePropertyK0Relations (R₁ × R₂) (finiteProjectiveModuleProperty (R₁ × R₂)) ≤
      (FreeAbelianGroup.lift (projectiveGrothendieckGroupFactorPair R₁ R₂)).ker := sorry

private def projectiveGrothendieckGroupProdMap :
    projectiveGrothendieckGroup (R₁ × R₂) →+
      (projectiveGrothendieckGroup R₁ × projectiveGrothendieckGroup R₂) :=
  ModulePropertyK0.lift (R₁ × R₂)
    (projectiveGrothendieckGroupFactorPair R₁ R₂)
    (projectiveGrothendieckGroup_relations_le_ker_prodMap R₁ R₂)

private theorem projectiveGrothendieckGroupProdMap_bijective :
    Function.Bijective (projectiveGrothendieckGroupProdMap R₁ R₂) := sorry

private abbrev finiteGrothendieckGroupFactorPair (M : FGModuleCat (R₁ × R₂)) :
    finiteGrothendieckGroup R₁ × finiteGrothendieckGroup R₂ :=
  ( finiteGrothendieckGroupOf R₁ (leftFactorFinite R₁ R₂ M)
  , finiteGrothendieckGroupOf R₂ (rightFactorFinite R₁ R₂ M) )

private theorem finiteGrothendieckGroup_relations_le_ker_prodMap :
    modulePropertyK0Relations (R₁ × R₂) (ModuleCat.isFG (R₁ × R₂)) ≤
      (FreeAbelianGroup.lift (finiteGrothendieckGroupFactorPair R₁ R₂)).ker := sorry

private def finiteGrothendieckGroupProdMap :
    finiteGrothendieckGroup (R₁ × R₂) →+
      (finiteGrothendieckGroup R₁ × finiteGrothendieckGroup R₂) :=
  ModulePropertyK0.lift (R₁ × R₂)
    (finiteGrothendieckGroupFactorPair R₁ R₂)
    (finiteGrothendieckGroup_relations_le_ker_prodMap R₁ R₂)

private theorem finiteGrothendieckGroupProdMap_bijective :
    Function.Bijective (finiteGrothendieckGroupProdMap R₁ R₂) := sorry

-- Proof sketch: pass from a finitely generated projective `(R₁ × R₂)`-module to the two
-- idempotent factors cut out by `(1, 0)` and `(0, 1)`, descend that assignment to `K₀`, and use
-- the canonical reconstruction of product-ring modules from their two factors to prove bijectivity.
/-- Lemma 10.55.6 (1): the Grothendieck group `K₀(R₁ × R₂)` of finitely generated projective
modules is canonically the product of `K₀(R₁)` and `K₀(R₂)`. -/
noncomputable def projectiveGrothendieckGroup_prod :
    projectiveGrothendieckGroup (R₁ × R₂) ≃+
      (projectiveGrothendieckGroup R₁ × projectiveGrothendieckGroup R₂) :=
  AddEquiv.ofBijective (projectiveGrothendieckGroupProdMap R₁ R₂)
    (projectiveGrothendieckGroupProdMap_bijective R₁ R₂)

-- Proof sketch: unfold `projectiveGrothendieckGroup_prod`; it was defined to be the additive
-- equivalence produced by `AddEquiv.ofBijective` from `projectiveGrothendieckGroupProdMap`.
/-- The product equivalence on `K₀` is definitionally the additive equivalence attached to the
canonical Grothendieck-group homomorphism from the two idempotent factors. -/
theorem projectiveGrothendieckGroup_prod_def :
    projectiveGrothendieckGroup_prod R₁ R₂ =
      AddEquiv.ofBijective (projectiveGrothendieckGroupProdMap R₁ R₂)
        (projectiveGrothendieckGroupProdMap_bijective R₁ R₂) := sorry

/-- The additive equivalence `projectiveGrothendieckGroup_prod` is induced by the canonical
Grothendieck-group homomorphism built from the two idempotent factors. -/
-- Proof sketch: `projectiveGrothendieckGroup_prod` is defined by `AddEquiv.ofBijective` from
-- `projectiveGrothendieckGroupProdMap`, so its underlying additive homomorphism is exactly that
-- map.
@[simp] theorem projectiveGrothendieckGroup_prod_toAddMonoidHom :
    (projectiveGrothendieckGroup_prod R₁ R₂).toAddMonoidHom =
      projectiveGrothendieckGroupProdMap R₁ R₂ := sorry

/-- Applying `projectiveGrothendieckGroup_prod` is the same as applying the canonical additive
homomorphism induced by the two idempotent factors. -/
-- Proof sketch: `projectiveGrothendieckGroup_prod` is defined by `AddEquiv.ofBijective`, whose
-- underlying function is the additive homomorphism `projectiveGrothendieckGroupProdMap`.
@[simp] theorem projectiveGrothendieckGroup_prod_apply
    (x : projectiveGrothendieckGroup (R₁ × R₂)) :
    projectiveGrothendieckGroup_prod R₁ R₂ x =
      projectiveGrothendieckGroupProdMap R₁ R₂ x := sorry

/-- On the class of a finite projective `(R₁ × R₂)`-module, `projectiveGrothendieckGroup_prod`
records the two idempotent factors cut out by `(1, 0)` and `(0, 1)`. -/
-- Proof sketch: evaluate the general `projectiveGrothendieckGroup_prod_apply` formula on a
-- generator class and then use `ModulePropertyK0.lift_of` for the defining quotient map.
@[simp] theorem projectiveGrothendieckGroup_prod_apply_of
    (M : FiniteProjectiveModuleCat (R₁ × R₂)) :
    projectiveGrothendieckGroup_prod R₁ R₂
        (projectiveGrothendieckGroupOf (R₁ × R₂) M) =
      projectiveGrothendieckGroupFactorPair R₁ R₂ M := sorry

-- Proof sketch: take the two idempotent factors of a finite `(R₁ × R₂)`-module,
-- descend the resulting pair of classes to `K'_0`, and prove this quotient map is bijective by
-- reconstructing finite modules over the product ring from pairs over the factors.
/-- Lemma 10.55.6 (2): the Grothendieck group `K'_0(R₁ × R₂)` of finite modules is
canonically the product of `K'_0(R₁)` and `K'_0(R₂)`. -/
noncomputable def finiteGrothendieckGroup_prod :
    finiteGrothendieckGroup (R₁ × R₂) ≃+
      (finiteGrothendieckGroup R₁ × finiteGrothendieckGroup R₂) :=
  AddEquiv.ofBijective (finiteGrothendieckGroupProdMap R₁ R₂)
    (finiteGrothendieckGroupProdMap_bijective R₁ R₂)

-- Proof sketch: unfold `finiteGrothendieckGroup_prod`; it was defined to be the additive
-- equivalence produced by `AddEquiv.ofBijective` from `finiteGrothendieckGroupProdMap`.
/-- The product equivalence on `K'_0` is definitionally the additive equivalence attached to the
canonical Grothendieck-group homomorphism from the two idempotent factors. -/
theorem finiteGrothendieckGroup_prod_def :
    finiteGrothendieckGroup_prod R₁ R₂ =
      AddEquiv.ofBijective (finiteGrothendieckGroupProdMap R₁ R₂)
        (finiteGrothendieckGroupProdMap_bijective R₁ R₂) := sorry

/-- The additive equivalence `finiteGrothendieckGroup_prod` is induced by the canonical
Grothendieck-group homomorphism built from the two idempotent factors. -/
-- Proof sketch: `finiteGrothendieckGroup_prod` is defined by `AddEquiv.ofBijective` from
-- `finiteGrothendieckGroupProdMap`, so its underlying additive homomorphism is exactly that map.
@[simp] theorem finiteGrothendieckGroup_prod_toAddMonoidHom :
    (finiteGrothendieckGroup_prod R₁ R₂).toAddMonoidHom =
      finiteGrothendieckGroupProdMap R₁ R₂ := sorry

/-- Applying `finiteGrothendieckGroup_prod` is the same as applying the canonical additive
homomorphism induced by the two idempotent factors. -/
-- Proof sketch: `finiteGrothendieckGroup_prod` is defined by `AddEquiv.ofBijective`, whose
-- underlying function is the additive homomorphism `finiteGrothendieckGroupProdMap`.
@[simp] theorem finiteGrothendieckGroup_prod_apply
    (x : finiteGrothendieckGroup (R₁ × R₂)) :
    finiteGrothendieckGroup_prod R₁ R₂ x =
      finiteGrothendieckGroupProdMap R₁ R₂ x := sorry

/-- On the class of a finite `(R₁ × R₂)`-module, `finiteGrothendieckGroup_prod` records the two
idempotent factors cut out by `(1, 0)` and `(0, 1)`. -/
-- Proof sketch: evaluate the general `finiteGrothendieckGroup_prod_apply` formula on a generator
-- class and then use `ModulePropertyK0.lift_of` for the defining quotient map.
@[simp] theorem finiteGrothendieckGroup_prod_apply_of
    (M : FGModuleCat (R₁ × R₂)) :
    finiteGrothendieckGroup_prod R₁ R₂
        (finiteGrothendieckGroupOf (R₁ × R₂) M) =
      finiteGrothendieckGroupFactorPair R₁ R₂ M := sorry

end ProductFactors
