import StacksProject_2024.stacks_project.Chap10.Lemma_10_21_4
import StacksProject_2024.stacks_project.Chap10.Lemma_10_17_7
import StacksProject_2024.stacks_project.Chap10.Lemma_10_22_1

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open Ideal
open Ideal.Quotient

section

variable {R : Type u} [CommRing R]

local notation "π" => Ideal.Quotient.mk

namespace PrimeSpectrum

-- Proof sketch: apply Lemma `10.22.1` to the connected component of `p`, viewed as a closed union
-- of connected components, to obtain an idempotent-generated ideal whose zero locus is exactly
-- `connectedComponent p`.
/-- Lemma 10.22.2: for `p : Spec(R)`, there exists an ideal `I` generated by idempotents such that
the connected component of `p` is `V(I)`. -/
theorem exists_ideal_isGeneratedByIdempotents_connectedComponent_eq_zeroLocus
    (p : PrimeSpectrum R) :
    ∃ I : Ideal R, I.IsGeneratedByIdempotents ∧ connectedComponent p = zeroLocus I := sorry

-- Proof sketch: identify `Spec(R ⧸ I)` with `connectedComponent p` via the quotient-spectrum
-- homeomorphism, deduce connectedness of `Spec(R ⧸ I)`, and apply Lemma `10.21.4` to conclude that
-- every idempotent class in `R ⧸ I` is trivial.
/-- If `connectedComponent p = V(I)` for an idempotent-generated ideal `I`, then every idempotent
of `R` maps to `0` or `1` in `R ⧸ I`. -/
theorem idempotent_eq_zero_or_one_in_quotient_of_connectedComponent_eq_zeroLocus
    {p : PrimeSpectrum R} {I : Ideal R}
    (hI : I.IsGeneratedByIdempotents) (hzero : connectedComponent p = zeroLocus I) :
    ∀ ⦃e : R⦄, IsIdempotentElem e → π I e = 0 ∨ π I e = 1 := sorry

end PrimeSpectrum
end
