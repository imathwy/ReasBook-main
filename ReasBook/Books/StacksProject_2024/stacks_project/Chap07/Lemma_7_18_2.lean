import Mathlib
import StacksProject_2024.Chap07.Definition_7_13_1
import StacksProject_2024.Chap07.Situation_7_18_1

-- Declarations for this item will be appended below by the statement pipeline.

universe uI vI uC vC

namespace CategoryTheory

open Limits
open Opposite

noncomputable section

/- Domain-style sampling for Lemma 7.18.2:
- primary domain: source-facing sites presented by precoverages on colimits of cofiltered
  diagrams of sites;
- sampled owner API:
  `CategoryTheory.Precoverage`,
  `CategoryTheory.Precoverage.HasIsos`,
  `CategoryTheory.Precoverage.IsStableUnderBaseChange`,
  `CategoryTheory.Functor.IsContinuousSiteFunctor`;
- source/core/bridge triage:
  `source-facing`: `CofilteredSiteDiagram.colimitSite`, the explicit union-of-images covering
  families on the colimit category;
  `core/canonical`: the site-axiom typeclasses on `Precoverage` together with the chapter owner
  `Functor.IsContinuousSiteFunctor`;
  `bridge/view`: `colimitSiteTopology` and `CofilteredSiteDiagram.colimitTopology`, obtained by
  passing from the source-facing precoverage to the generated Grothendieck topology.

Primitive data are only the explicit covering families. The site axioms, cocone continuity at the
precoverage layer, and the topology-level continuity statements are derived API.
-/

variable {I : Type uI} [Category.{vI} I]
variable (F : I ⥤ Cat.{uC, vC}) (J : ∀ i : I, GrothendieckTopology (F.obj i))
variable [HasColimit F]

/-- The image on the colimit category of a stage covering family, after identifying its target
with an arbitrary colimit object `X`. This is an internal helper for the explicit colimit-site
precoverage. -/
private def stageCover
    {X : (colimit F : Cat.{uC, vC})}
    (i : I) (Y : F.obj i) (hX : ((colimit.ι F i).toFunctor.obj Y) = X) (R : Presieve Y) :
    Presieve X :=
  Presieve.ofArrows
    (fun a : (R.map (colimit.ι F i).toFunctor).uncurry ↦ a.1.1)
    (fun a ↦ a.1.2 ≫ eqToHom hX)

private theorem stageCover_rfl_eq_map
    (i : I) (Y : F.obj i) (R : Presieve Y) :
    stageCover F i Y rfl R = R.map (colimit.ι F i).toFunctor := by
  funext Z
  funext f
  apply propext
  constructor
  · rintro ⟨a⟩
    have ha : (R.map (colimit.ι F i).toFunctor) a.1.2 := a.2
    simpa using ha
  · intro hf
    change Presieve.ofArrows
      (fun a : (R.map (colimit.ι F i).toFunctor).uncurry ↦ a.1.1)
      (fun a ↦ a.1.2 ≫ eqToHom rfl) f
    let a : (R.map (colimit.ι F i).toFunctor).uncurry := ⟨⟨Z, f⟩, hf⟩
    have ha :
        Presieve.ofArrows
          (fun a : (R.map (colimit.ι F i).toFunctor).uncurry ↦ a.1.1)
          (fun a ↦ a.1.2 ≫ eqToHom rfl) (f ≫ eqToHom rfl) :=
      Presieve.ofArrows.mk a
    simpa using ha

/-- The source-facing colimit-site precoverage: its covering families are exactly the images of
stage covering families under the cocone functors. The stage coverings are taken from the canonical
precoverage associated to each stage Grothendieck topology. -/
def colimitSitePrecoverage : Precoverage (colimit F : Cat.{uC, vC}) where
  coverings X := {T | ∃ (i : I) (Y : F.obj i) (hX : ((colimit.ι F i).toFunctor.obj Y) = X)
    (R : Presieve Y),
    R ∈ (J i).toPrecoverage Y ∧ stageCover F i Y hX R = T}

/-- Any stage covering family becomes a covering family in the colimit-site precoverage after
applying the corresponding cocone functor. -/
theorem stageCover_mem_colimitSitePrecoverage
    (i : I) {Y : F.obj i} {R : Presieve Y} (hR : R ∈ (J i).toPrecoverage Y) :
    R.map (colimit.ι F i).toFunctor ∈
      colimitSitePrecoverage F J ((colimit.ι F i).toFunctor.obj Y) :=
  ⟨i, Y, rfl, R, hR, stageCover_rfl_eq_map F i Y R⟩

/-- The Grothendieck topology generated by the explicit colimit-site covering families. This is
the canonical bridge from the source-facing precoverage to mathlib's topology owner. -/
def colimitSiteTopology : GrothendieckTopology (colimit F : Cat.{uC, vC}) :=
  (colimitSitePrecoverage F J).toGrothendieck

/-- Each cocone functor from a stage site into the colimit site is cover-preserving for the
Grothendieck topology generated by the explicit colimit-site covering families. -/
theorem colimitSiteTopology_coverPreserving (i : I) :
    CoverPreserving (J i) (colimitSiteTopology F J) (colimit.ι F i).toFunctor := by
  constructor
  intro U S hS
  simpa [colimitSiteTopology, Sieve.generate_sieve, Sieve.generate_map_eq_functorPushforward] using
    (Precoverage.generate_mem_toGrothendieck
      (stageCover_mem_colimitSitePrecoverage F J i
        ((GrothendieckTopology.arrows_mem_toPrecoverage_iff (J i) S).2 hS)))

/-- For a filtered diagram of sites whose transition functors are continuous, the cocone functor
from each stage into the colimit category is continuous for the Grothendieck topology generated by
the explicit colimit-site precoverage. This is the topology-level bridge used by later sheaf
constructions. -/
theorem colimitSiteCocone_isContinuous
    {I : Type uI} [Category.{vI} I] [IsFiltered I]
    (F : I ⥤ Cat.{uC, vC})
    [HasColimit F]
    (J : ∀ i : I, GrothendieckTopology (F.obj i))
    [∀ ⦃i j : I⦄ (a : i ⟶ j), Functor.IsContinuous (F.map a).toFunctor (J i) (J j)]
    (i : I) :
    Functor.IsContinuous (colimit.ι F i).toFunctor (J i)
      (colimitSiteTopology F J : GrothendieckTopology (colimit F : Cat.{uC, vC})) := by
  sorry

/-- Lemma 7.18.2 (5): the Grothendieck topology generated by the explicit colimit-site covering
families is the smallest topology on the colimit category for which every cocone functor from a
stage site is cover-preserving. -/
theorem colimitSiteTopology_isLeast :
    IsLeast
      {Jcolim : GrothendieckTopology (colimit F : Cat.{uC, vC}) |
        ∀ i : I, CoverPreserving (J i) Jcolim (colimit.ι F i).toFunctor}
      (colimitSiteTopology F J) := by
  refine ⟨colimitSiteTopology_coverPreserving F J, ?_⟩
  intro Jcolim hJcolim
  rw [colimitSiteTopology, Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
  intro X T hT
  rcases hT with ⟨i, Y, hX, R, hR, rfl⟩
  subst hX
  simpa [GrothendieckTopology.mem_toPrecoverage_iff, stageCover_rfl_eq_map,
    Sieve.generate_map_eq_functorPushforward] using
    (hJcolim i).cover_preserve ((GrothendieckTopology.mem_toPrecoverage_iff (J i) R).1 hR)

namespace CofilteredSiteDiagram

/-- The stage Grothendieck topologies, viewed on the opposite indexing category of the colimit
diagram. This is the internal owner used by the generic colimit-site constructions. -/
private abbrev stageTopologies
    (S : CofilteredSiteDiagram.{uI, uC, vC}) :
    ∀ i : S.Iᵒᵖ, GrothendieckTopology (S.diagram.obj i) :=
  fun i ↦ S.stageTopology i.unop

/-- In Situation 7.18.1, the source-facing colimit site on `colim_i \mathcal C_i` has as covering
families exactly the images of the stage covering families under the cocone functors
`u_i : \mathcal C_i \to \mathop{\mathrm{colim}} \mathcal C_i`, using the canonical precoverage of
the stage Grothendieck topologies. -/
abbrev colimitSite
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] :
    Precoverage (colimit S.diagram : Cat.{vC, uC}) :=
  colimitSitePrecoverage S.diagram (stageTopologies S)

/-- Any stage covering family becomes a covering family in the colimit site after applying the
corresponding cocone functor. -/
theorem stageCover_mem_colimitSite
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram]
    (i : S.I) {Y : S.stage i} {R : Presieve Y}
    (hR : R ∈ (S.stageTopology i).toPrecoverage Y) :
    R.map (S.stageCoconeFunctor i) ∈
      colimitSite S ((S.stageCoconeFunctor i).obj Y) :=
  stageCover_mem_colimitSitePrecoverage S.diagram (stageTopologies S) (op i) hR

/-- Lemma 7.18.2 (1): in Situation 7.18.1, the explicit colimit covering families contain all
isomorphisms, as required for a site in the sense of Definition 7.6.2. -/
instance colimitSite_hasIsos
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] :
    (colimitSite S).HasIsos := by
  sorry

/-- Lemma 7.18.2 (2): in Situation 7.18.1, base change along arbitrary arrows exists for the
explicit colimit-site covering families. -/
instance colimitSite_hasPullbacks
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] :
    (colimitSite S).HasPullbacks := by
  sorry

/-- Lemma 7.18.2 (3): in Situation 7.18.1, the explicit colimit-site covering families are stable
under base change. -/
instance colimitSite_isStableUnderBaseChange
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] :
    (colimitSite S).IsStableUnderBaseChange := by
  sorry

/-- Lemma 7.18.2 (4): in Situation 7.18.1, the explicit colimit-site covering families are stable
under composition. -/
instance colimitSite_isStableUnderComposition
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] :
    (colimitSite S).IsStableUnderComposition := by
  sorry

/-- Each cocone functor from a stage site to the source-facing colimit site is continuous in the
Stacks Project precoverage sense. -/
instance stageCocone_isContinuousSiteFunctor
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] (i : S.I) :
    Functor.IsContinuousSiteFunctor
      (S.stageCoconeFunctor i)
      (S.stageTopology i).toPrecoverage
      (colimitSite S) := by
  sorry

/-- The Grothendieck topology on the colimit category in Situation 7.18.1, expressed directly via
the generic colimit-site owner attached to the stage topologies. -/
abbrev colimitTopology
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] :
    GrothendieckTopology (colimit S.diagram : Cat.{vC, uC}) :=
  colimitSiteTopology S.diagram (stageTopologies S)

/-- The stage cocone functor is continuous for the colimit Grothendieck topology. -/
instance stageCoconeFunctor_isContinuous
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] (i : S.I) :
    Functor.IsContinuous (S.stageCoconeFunctor i) (S.stageTopology i) (colimitTopology S) := by
  let _ : ∀ ⦃i j : S.Iᵒᵖ⦄ (a : i ⟶ j),
      Functor.IsContinuous
        (S.diagram.map a).toFunctor
        (stageTopologies S i)
        (stageTopologies S j) :=
    fun {i j} a ↦ by
      simpa [stageTopologies, CofilteredSiteDiagram.stageFunctor] using
        S.stageFunctor_isContinuous a.unop
  simpa [colimitTopology, stageTopologies] using
    (colimitSiteCocone_isContinuous S.diagram (stageTopologies S) (op i))

private theorem stageCoconeFunctor_comp
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram]
    {i j : S.I} (a : j ⟶ i) :
    S.stageFunctor a ⋙ S.stageCoconeFunctor j = S.stageCoconeFunctor i :=
  congrArg Cat.Hom.toFunctor (colimit.w S.diagram a.op)

/-- Stage pullback followed by colimit-stage pullback is canonically the colimit-stage pullback
from the source stage. -/
noncomputable def colimitStageSheafPullbackCompIso
    (S : CofilteredSiteDiagram.{uI, uC, vC}) [HasColimit S.diagram] (A : Type*) [Category A]
    {i j : S.I} (a : j ⟶ i)
    [HasWeakSheafify (S.stageTopology j) A]
    [HasWeakSheafify (CofilteredSiteDiagram.colimitTopology S) A]
    [∀ F : (S.stage i)ᵒᵖ ⥤ A, (S.stageFunctor a).op.HasLeftKanExtension F]
    [∀ F : (S.stage j)ᵒᵖ ⥤ A, (S.stageCoconeFunctor j).op.HasLeftKanExtension F]
    [∀ F : (S.stage i)ᵒᵖ ⥤ A, (S.stageCoconeFunctor i).op.HasLeftKanExtension F] :
    (S.stageFunctor a).sheafPullback A (S.stageTopology i) (S.stageTopology j) ⋙
        (S.stageCoconeFunctor j).sheafPullback A (S.stageTopology j)
          (CofilteredSiteDiagram.colimitTopology S) ≅
      (S.stageCoconeFunctor i).sheafPullback A (S.stageTopology i)
        (CofilteredSiteDiagram.colimitTopology S) :=
  Adjunction.leftAdjointCompIso
    ((S.stageFunctor a).sheafAdjunctionContinuous A
      (S.stageTopology i) (S.stageTopology j))
    ((S.stageCoconeFunctor j).sheafAdjunctionContinuous A
      (S.stageTopology j) (CofilteredSiteDiagram.colimitTopology S))
    ((S.stageCoconeFunctor i).sheafAdjunctionContinuous A
      (S.stageTopology i) (CofilteredSiteDiagram.colimitTopology S))
    (Functor.sheafPushforwardContinuousComp'
      (eqToIso (stageCoconeFunctor_comp S a))
      A (S.stageTopology i) (S.stageTopology j) (CofilteredSiteDiagram.colimitTopology S))

end CofilteredSiteDiagram

end

end CategoryTheory
