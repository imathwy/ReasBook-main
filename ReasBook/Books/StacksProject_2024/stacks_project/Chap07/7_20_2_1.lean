import Mathlib
import StacksProject_2024.stacks_project.Chap07.Definition_7_8_1
import StacksProject_2024.stacks_project.Chap07.Definition_7_8_2
import StacksProject_2024.stacks_project.Chap25.Definition_25_3_1

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.Limits
open SemiRepresentableFamily
open SemiRepresentableFamily.Over

noncomputable section

universe uC vC uD vD w

section

/- Domain-style sampling for 7.20.2.1:
- primary domain: the coproduct-of-representables presentation attached to a fixed-target family
  and its pairwise overlaps, after pullback of representables along `u`;
- sampled owner declarations:
  `SemiRepresentableFamily.Over`,
  `SemiRepresentableFamily.toPresheaf`,
  `SemiRepresentableFamily.Over.augmentation`,
  `Cofork.ofπ`;
- best owner abstraction: the fixed-target family owner `SemiRepresentableFamily.Over V`, with the
  displayed cofork derived from the canonical presheaf map `augmentation 𝒰` and the two canonical
  family morphisms from the overlap family to `𝒰`;
- primitive data: the functor `u`, the family `𝒰 : SemiRepresentableFamily.Over V`, and pairwise
  pullbacks of its members over `V`, canonically packaged as
  `𝒰.toPresieve.HasPairwisePullbacks`;
- derived API: the overlap family, the two projection morphisms to `𝒰`, the induced parallel pair
  after applying `toPresheaf` and `u.op.whiskerLeft`, and finally the standard cofork
  `Cofork.ofπ`.

Source/core/bridge triage:
- `source-facing`: the displayed canonical cofork
  `∐ u^p h_{V_i ×_V V_j} ⇉ ∐ u^p h_{V_i} ⟶ u^p h_V`;
- `core/canonical`: `SemiRepresentableFamily.Over`, `SemiRepresentableFamily.toPresheaf`,
  `SemiRepresentableFamily.Over.augmentation`, and `Cofork.ofπ`;
- `bridge/view`: the private overlap family and its two projection morphisms into `𝒰`.

There is no earlier mathlib/project owner for this exact overlap-family cofork, so this file
stays at the `bridge/view` layer and keeps the overlap construction private while exposing the
main item only as direct use of the canonical owners above.
-/

attribute [local instance] Types.instFunLike Types.instConcreteCategory

variable {C : Type uC} [Category.{vC} C]
variable {D : Type uD} [Category.{vD} D]
variable (u : C ⥤ D)
variable {V : D}
variable (𝒰 : SemiRepresentableFamily.Over.{vD, uD, w} V)
variable [𝒰.toPresieve.HasPairwisePullbacks]

-- Proof sketch: apply the pairwise-pullback hypothesis on the presieve generated by `𝒰` to the
-- two arrows indexed by `i` and `j`.
private theorem hasPullback_obj_hom' (i j : 𝒰.index) :
    HasPullback (𝒰.obj i).hom (𝒰.obj j).hom := sorry

private instance hasPullback_obj_hom (i j : 𝒰.index) :
    HasPullback (𝒰.obj i).hom (𝒰.obj j).hom :=
  hasPullback_obj_hom' 𝒰 i j

private def overlapFamily :
    SemiRepresentableFamily.Over.{vD, uD, w} V :=
  ofArrows
    (fun ij : 𝒰.index × 𝒰.index ↦ pullback (𝒰.obj ij.1).hom (𝒰.obj ij.2).hom)
    (fun ij ↦ pullback.fst (𝒰.obj ij.1).hom (𝒰.obj ij.2).hom ≫ (𝒰.obj ij.1).hom)

private def overlapFstHom :
    forget.obj (overlapFamily 𝒰) ⟶ forget.obj 𝒰 where
  α := Prod.fst
  f ij := pullback.fst (𝒰.obj ij.1).hom (𝒰.obj ij.2).hom

private def overlapSndHom :
    forget.obj (overlapFamily 𝒰) ⟶ forget.obj 𝒰 where
  α := Prod.snd
  f ij := pullback.snd (𝒰.obj ij.1).hom (𝒰.obj ij.2).hom

-- Proof sketch: extensionality on the coproduct-of-representables presentation reduces the claim
-- to the pullback commutativity relation for each overlap object.
/-- The two overlap projection maps induce a parallel pair over the augmentation to `h_V`. -/
private theorem representableParallelPair :
    u.op.whiskerLeft (toPresheaf.map (overlapFstHom 𝒰)) ≫
        u.op.whiskerLeft (augmentation 𝒰) =
      u.op.whiskerLeft (toPresheaf.map (overlapSndHom 𝒰)) ≫
        u.op.whiskerLeft (augmentation 𝒰) := sorry

/- 7.20.2.1: for a fixed family `𝒰` over `V` with pairwise pullbacks, the canonical cofork in
presheaves
`∐ u^p h_{V_i ×_V V_j} ⇉ ∐ u^p h_{V_i} ⟶ u^p h_V`
is the standard `Cofork.ofπ` built from the overlap family of `𝒰`, the two overlap projection
maps, and the augmentation to the representable presheaf `h_V`. -/
#check
  (Cofork.ofπ
      (u.op.whiskerLeft (augmentation 𝒰))
      (representableParallelPair u 𝒰) :
    Cofork
      (u.op.whiskerLeft (toPresheaf.map (overlapFstHom 𝒰)))
      (u.op.whiskerLeft (toPresheaf.map (overlapSndHom 𝒰))))

end
