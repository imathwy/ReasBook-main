import Mathlib.Geometry.RingedSpace.LocallyRingedSpace
import StacksProject_2024.stacks_project.Chap17.Definition_17_13_1_Owner

-- Declarations for this item will be appended below by the statement pipeline.

namespace AlgebraicGeometry.LocallyRingedSpace

open CategoryTheory
open RingedSpace
open RingedSpace.Hom

universe u

/- Source/core/bridge triage:
- `source-facing`: the Stacks definition that a morphism of locally ringed spaces is a closed
  immersion.
- `core/canonical`: the Chapter 17 ringed-space owner
  `AlgebraicGeometry.RingedSpace.IsClosedImmersion`.
- `bridge/view`: the locally-ringed-space bridge
  `LocallyRingedSpace.IsClosedImmersion i := RingedSpace.IsClosedImmersion i.toShHom`, together
  with the source criterion unpacking the defining fields. -/

-- Semantic recall: the Chapter 17 source-facing owner is
-- `AlgebraicGeometry.RingedSpace.IsClosedImmersion`; in Chapter 26 the same notion for a morphism
-- of locally ringed spaces is obtained by viewing it as the underlying ringed-space morphism
-- `i.toShHom`.

/- Definition 26.4.1: the closed-immersion predicate for a morphism of locally ringed spaces is
the Chapter 17 ringed-space predicate specialized along `LocallyRingedSpace.Hom.toShHom`. -/
/-- Definition 26.4.1: a morphism of locally ringed spaces is a closed immersion if its
underlying morphism of ringed spaces is a closed immersion. -/
@[stacks 01HK]
abbrev IsClosedImmersion {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X) : Prop :=
  RingedSpace.IsClosedImmersion i.toShHom

/-- The canonical sheaf morphism `\mathcal O_X \to i_* \mathcal O_Z` attached to a morphism of
locally ringed spaces, obtained from the underlying ringed-space morphism. -/
noncomputable abbrev commRingSheafPushforwardMap {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X) :=
  RingedSpace.Hom.commRingSheafPushforwardMap i.toShHom

/-- The kernel ideal sheaf attached to a morphism of locally ringed spaces, obtained from the
underlying ringed-space morphism. -/
noncomputable abbrev closedImmersionIdealSheaf {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X) :=
  RingedSpace.closedImmersionIdealSheaf i.toShHom

section

variable {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X)

/-- Definition 26.4.1, canonical bridge: a morphism of locally ringed spaces is a closed
immersion exactly when its underlying morphism of ringed spaces is a closed immersion. -/
@[simp] theorem IsClosedImmersion.iff_toShHom_isClosedImmersion :
    IsClosedImmersion i ↔ RingedSpace.IsClosedImmersion i.toShHom :=
  Iff.rfl

/-- A closed immersion of locally ringed spaces has closed-embedding underlying map. -/
theorem IsClosedImmersion.isClosedEmbedding_base (h : IsClosedImmersion i) :
    Topology.IsClosedEmbedding i.base := by
  simpa using h.isClosedEmbedding

/-- A closed immersion of locally ringed spaces has locally surjective
`\mathcal O_X \to i_*\mathcal O_Z`. -/
theorem IsClosedImmersion.isLocallySurjective (h : IsClosedImmersion i) :
    Sheaf.IsLocallySurjective (commRingSheafPushforwardMap i) := by
  simpa [commRingSheafPushforwardMap] using h.toIsLocallySurjective

/-- A closed immersion of locally ringed spaces has locally generated kernel ideal sheaf. -/
theorem IsClosedImmersion.idealSheafLocallyGenerated (h : IsClosedImmersion i) :
    Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData := by
  simpa [closedImmersionIdealSheaf] using h.idealSheaf_locallyGenerated

/-- Definition 26.4.1, constructor bridge: the source closed-embedding, local-surjectivity, and
locally-generated ideal-sheaf conditions imply that a morphism of locally ringed spaces is a
closed immersion. -/
@[stacks 01HK]
theorem IsClosedImmersion.of_source_spec
    (hclosed : Topology.IsClosedEmbedding i.base)
    (hsurj : Sheaf.IsLocallySurjective (commRingSheafPushforwardMap i))
    (hgen : Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData) :
    IsClosedImmersion i := by
  exact
    { toIsLocallySurjective := by
        simpa [commRingSheafPushforwardMap] using hsurj
      isClosedEmbedding := by simpa using hclosed
      idealSheaf_locallyGenerated := by
        simpa [closedImmersionIdealSheaf] using hgen }

/-- Definition 26.4.1, source-facing criterion: a morphism of locally ringed spaces is a closed
immersion exactly when its underlying map is a closed embedding, the induced map
`\mathcal O_X \to i_*\mathcal O_Z` is locally surjective, and the kernel ideal sheaf is locally
generated by sections. -/
@[stacks 01HK]
theorem IsClosedImmersion.iff :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective (commRingSheafPushforwardMap i) ∧
          Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData := by
  constructor
  · intro h
    exact
      ⟨h.isClosedEmbedding_base, h.isLocallySurjective, h.idealSheafLocallyGenerated⟩
  · rintro ⟨hclosed, hsurj, hgen⟩
    exact IsClosedImmersion.of_source_spec i hclosed hsurj hgen

/-- A closed immersion of locally ringed spaces satisfies the source closed-embedding,
local-surjectivity, and locally-generated ideal-sheaf conditions. -/
theorem IsClosedImmersion.source_spec (h : IsClosedImmersion i) :
    Topology.IsClosedEmbedding i.base ∧
      Sheaf.IsLocallySurjective (commRingSheafPushforwardMap i) ∧
        Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData :=
  (IsClosedImmersion.iff i).1 h

end

end AlgebraicGeometry.LocallyRingedSpace
