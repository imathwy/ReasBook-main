import Mathlib.CategoryTheory.Subobject.Limits
import StacksProject_2024.Chap26.Definition_26_4_4

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.Limits
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace

section

variable {X Y Z Z' : LocallyRingedSpace.{u}}

local notation "ModX" => RingedSpace.Modules X.toRingedSpace
local notation "ModY" => RingedSpace.Modules Y.toRingedSpace
local notation "𝒪Y" => (SheafOfModules.unit Y.toRingedSpace.ringCatSheaf : ModY)

section

variable (f : X ⟶ Y) (𝓘 : Subobject 𝒪Y)

local notation "𝒥" => imageSubobject (pullbackIdealToStructureSheaf f 𝓘)

-- Semantic recall: `lean_leansearch` only surfaced the scheme-level subscheme pullback API
-- (`Scheme.IdealSheafData.comapIso`, `isPullback_of_isClosedImmersion`), so the locally-ringed-
-- space statement is written against the verified Chapter 17/26 owners
-- `SheafOfModules.LocalGeneratorsData`, `pullbackIdealToStructureSheaf`,
-- `IsClosedSubspaceAssociatedTo`, `CommSq`, and `IsPullback`.

/-- Lemma 26.4.7 (1): if `\mathcal I \subset \mathcal O_Y` is a sheaf of ideals locally generated
by sections and `\mathcal J` is the image of `f^* \mathcal I \to \mathcal O_X`, then
`\mathcal J` is locally generated by sections. -/
@[stacks 01HQ]
theorem nonempty_localGenerators_image_pullbackIdealToStructureSheaf
    (h𝓘 : Nonempty ((Subobject.underlying.obj 𝓘 : ModY).LocalGeneratorsData)) :
    Nonempty ((Subobject.underlying.obj 𝒥 : ModX).LocalGeneratorsData) := by
  let _ := h𝓘
  sorry

/-- Companion API: if `i : Z ⟶ Y` is the closed subspace associated to `\mathcal I`, then the
image ideal `\mathcal J` of `f^* \mathcal I \to \mathcal O_X` is locally generated by sections. -/
theorem nonempty_localGenerators_image_pullbackIdealToStructureSheaf_of_isClosedSubspaceAssociatedTo
    (i : Z ⟶ Y) [IsClosedSubspaceAssociatedTo i 𝓘] :
    Nonempty ((Subobject.underlying.obj 𝒥 : ModX).LocalGeneratorsData) :=
  let hi : IsClosedSubspaceAssociatedTo i 𝓘 := inferInstance
  nonempty_localGenerators_image_pullbackIdealToStructureSheaf f 𝓘 hi.ideal_locallyGenerated

variable (i : Z ⟶ Y) (i' : Z' ⟶ X)
/-- Lemma 26.4.7 (2): let `i : Z ⟶ Y` be the closed subspace associated to `\mathcal I`, and let
`i' : Z' ⟶ X` be the closed subspace associated to the image ideal of `f^* \mathcal I \to
\mathcal O_X`. Then there exists a unique morphism `f' : Z' ⟶ Z` making the induced square of
locally ringed spaces commute. -/
@[stacks 01HQ]
theorem existsUnique_lift_of_image_pullbackIdealToStructureSheaf
    [IsClosedSubspaceAssociatedTo i 𝓘]
    [IsClosedSubspaceAssociatedTo i' 𝒥] :
    ∃! f' : Z' ⟶ Z, CommSq i' f' f i := sorry

/-- Companion API: the pullback-image closed subspace admits a lift to the closed subspace
associated to `\mathcal I`. -/
theorem exists_lift_of_image_pullbackIdealToStructureSheaf
    [IsClosedSubspaceAssociatedTo i 𝓘]
    [IsClosedSubspaceAssociatedTo i' 𝒥]
    : ∃ f' : Z' ⟶ Z, CommSq i' f' f i :=
  (existsUnique_lift_of_image_pullbackIdealToStructureSheaf f 𝓘 i i').exists

/-- Companion API: any two lifts of the pullback-image closed subspace into the closed subspace
associated to `\mathcal I` are equal. -/
theorem eq_of_commSq_of_image_pullbackIdealToStructureSheaf
    [IsClosedSubspaceAssociatedTo i 𝓘]
    [IsClosedSubspaceAssociatedTo i' 𝒥]
    {f₁ f₂ : Z' ⟶ Z}
    (h₁ : CommSq i' f₁ f i) (h₂ : CommSq i' f₂ f i) : f₁ = f₂ :=
  let _ := h₁
  let _ := h₂
  (sorry : f₁ = f₂)

/-- Lemma 26.4.7 (3): with the notation above, the induced commutative square of locally ringed
spaces is a fibre square. -/
@[stacks 01HQ]
theorem isPullback_of_image_pullbackIdealToStructureSheaf
    [IsClosedSubspaceAssociatedTo i 𝓘]
    [IsClosedSubspaceAssociatedTo i' 𝒥]
    (f' : Z' ⟶ Z) (hcomm : CommSq i' f' f i) : IsPullback i' f' f i :=
  let _ := hcomm
  (sorry : IsPullback i' f' f i)

/-- Companion API: the pullback-image closed subspace fits into a cartesian square over `f`. -/
theorem exists_isPullback_of_image_pullbackIdealToStructureSheaf
    [IsClosedSubspaceAssociatedTo i 𝓘]
    [IsClosedSubspaceAssociatedTo i' 𝒥]
    : ∃ f' : Z' ⟶ Z, IsPullback i' f' f i :=
  match existsUnique_lift_of_image_pullbackIdealToStructureSheaf f 𝓘 i i' with
  | ⟨f', hcomm, _⟩ =>
      ⟨f', isPullback_of_image_pullbackIdealToStructureSheaf f 𝓘 i i' f' hcomm⟩

end

end

end AlgebraicGeometry.LocallyRingedSpace
