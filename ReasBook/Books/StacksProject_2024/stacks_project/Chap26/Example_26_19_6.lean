import Mathlib.AlgebraicGeometry.Morphisms.QuasiCompact
import Mathlib.Algebra.MvPolynomial.Eval

-- Declarations for this item will be appended below by the statement pipeline.

open TopologicalSpace
open PrimeSpectrum IsLocalRing
open scoped AlgebraicGeometry PrimeSpectrum

namespace AlgebraicGeometry

-- Semantic recall: `lean_leansearch` surfaced the canonical owners
-- `AlgebraicGeometry.Scheme.Opens.instIsOpenImmersionι`,
-- `AlgebraicGeometry.QuasiCompact`, and `PrimeSpectrum.isCompact_isOpen_iff_ideal`.
-- The textbook example is therefore formalized as an explicit open subscheme of an affine
-- spectrum, with the main source-facing statement asserting that its inclusion is not
-- quasi-compact.

universe u

noncomputable section

variable (k : Type u) [Field k]

abbrev infiniteAffineCoordinateRing : Type u :=
  MvPolynomial ℕ k

/-- The infinite affine scheme `\operatorname{Spec}(k[x_1, x_2, x_3, \ldots])`. -/
abbrev infiniteAffineSpectrum : Scheme :=
  Spec (CommRingCat.of (infiniteAffineCoordinateRing k))

/-- The coordinate function `x_n` on the infinite affine spectrum. -/
abbrev infiniteAffineCoordinate (n : ℕ) : infiniteAffineCoordinateRing k :=
  MvPolynomial.X n

/-- Evaluation at the origin of the infinite affine space, sending every coordinate `x_n` to `0`.
-/
abbrev infiniteAffineEvalAtOrigin : infiniteAffineCoordinateRing k →+* k :=
  MvPolynomial.eval₂Hom (algebraMap k k) (fun _ : ℕ ↦ (0 : k))

/-- The ideal of functions vanishing at the origin of the infinite affine space. -/
def infiniteAffineOriginIdeal : Ideal (infiniteAffineCoordinateRing k) :=
  Ideal.span
    (Set.range (infiniteAffineCoordinate k) : Set (infiniteAffineCoordinateRing k))

/-- The origin ideal is generated by the coordinate functions `(x_1, x_2, x_3, \ldots)`. -/
theorem infiniteAffineOriginIdeal_eq_span :
    infiniteAffineOriginIdeal k =
      Ideal.span
        (Set.range (infiniteAffineCoordinate k) : Set (infiniteAffineCoordinateRing k)) :=
  rfl

/-- The origin ideal is the kernel of evaluation at the origin. -/
theorem infiniteAffineOriginIdeal_eq_ker_evalAtOrigin :
    infiniteAffineOriginIdeal k = RingHom.ker (infiniteAffineEvalAtOrigin k) := by
  sorry

/-- The closed point corresponding to the maximal ideal `(x_1, x_2, x_3, \ldots)`. -/
def infiniteAffineOrigin : PrimeSpectrum (infiniteAffineCoordinateRing k) :=
  PrimeSpectrum.comap (infiniteAffineEvalAtOrigin k) (closedPoint k)

/-- The prime ideal underlying the origin point is `(x_1, x_2, x_3, \ldots)`. -/
@[simp] theorem infiniteAffineOrigin_asIdeal :
    (infiniteAffineOrigin k).asIdeal = infiniteAffineOriginIdeal k := sorry

/-- The open subscheme `\operatorname{Spec}(k[x_1, x_2, x_3, \ldots]) \setminus \{0\}`,
presented as the union of the basic opens `D(x_n)`. -/
abbrev infiniteAffinePuncture : (infiniteAffineSpectrum k).Opens :=
  ⨆ n : ℕ, PrimeSpectrum.basicOpen (infiniteAffineCoordinate k n)

/-- The punctured infinite affine spectrum is the complement of the origin. -/
theorem infiniteAffinePuncture_carrier_eq_compl_origin :
    (infiniteAffinePuncture k : Set (infiniteAffineSpectrum k)) =
      ({infiniteAffineOrigin k} : Set (infiniteAffineSpectrum k))ᶜ := sorry

/-- Membership in the punctured infinite affine spectrum means being distinct from the origin. -/
@[simp] theorem mem_infiniteAffinePuncture (x : infiniteAffineSpectrum k) :
    x ∈ infiniteAffinePuncture k ↔ x ≠ infiniteAffineOrigin k := by
  rw [← SetLike.mem_coe, infiniteAffinePuncture_carrier_eq_compl_origin]
  constructor <;> intro hx <;> simpa [Set.mem_singleton_iff] using hx

/-- The punctured infinite affine spectrum is not quasi-compact as an open subset. -/
theorem infiniteAffinePuncture_notIsCompact :
    ¬ IsCompact ((infiniteAffinePuncture k : (infiniteAffineSpectrum k).Opens) :
      Set (infiniteAffineSpectrum k)) := sorry

/-- Example 26.19.6: the inclusion
`\operatorname{Spec}(k[x_1, x_2, x_3, \ldots]) \setminus \{0\} \hookrightarrow
\operatorname{Spec}(k[x_1, x_2, x_3, \ldots])`
is not quasi-compact. Its open-immersion property is the canonical instance for
`Scheme.Opens.ι`. -/
@[stacks 01K8]
theorem infiniteAffinePuncture_notQuasiCompact :
    ¬ QuasiCompact (infiniteAffinePuncture k).ι := by
  intro hqc
  letI : QuasiCompact (infiniteAffinePuncture k).ι := hqc
  letI : CompactSpace (infiniteAffinePuncture k) :=
    QuasiCompact.compactSpace_of_compactSpace (infiniteAffinePuncture k).ι
  have hcompact :
      IsCompact ((infiniteAffinePuncture k : (infiniteAffineSpectrum k).Opens) :
        Set (infiniteAffineSpectrum k)) :=
    by simpa [Scheme.Opens.range_ι] using
      isCompact_range (infiniteAffinePuncture k).ι.continuous
  exact infiniteAffinePuncture_notIsCompact k hcompact

end

end AlgebraicGeometry
