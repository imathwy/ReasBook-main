import StacksProject_2024.Chap18.RingedSiteModuleCategoryBasic
import StacksProject_2024.Chap26.Definition_26_4_1

open AlgebraicGeometry
open CategoryTheory
open CategoryTheory.Limits
open SheafOfModules.RingedSite

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace

variable (X : LocallyRingedSpace.{u})
variable {𝒜 : TopCat.Sheaf CommRingCat.{u} X.toTopCat}

private abbrev ambientRingSheaf (X : LocallyRingedSpace.{u})
    (𝒜 : TopCat.Sheaf CommRingCat.{u} X.toTopCat) :=
  ringSheaf (Opens.grothendieckTopology X.toTopCat) 𝒜

private abbrev ambientRingSheafSupport (X : LocallyRingedSpace.{u})
    (𝒜 : TopCat.Sheaf CommRingCat.{u} X.toTopCat) : Set X :=
  { x : X |
      ¬ IsZero (TopCat.Presheaf.stalk
        ((ambientRingSheaf X 𝒜).obj ⋙ forget₂ RingCat AddCommGrpCat) x) }

private abbrev pushedForwardStructureSheaf
    {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X) :=
  (TopCat.Sheaf.pushforward RingCat i.base).obj Z.toRingedSpace.ringCatSheaf

-- Semantic recall: `ambientRingSheafSupport` is exactly the stalkwise nonvanishing support
-- subset for the ambient ring sheaf underlying `𝒜`. The source-facing support hypothesis is
-- that `i.base` identifies `Z` with that support subset, and
-- `kernel (SheafOfModules.unitToPushforwardObjUnit (ringedSiteStructureMap π))` is the canonical
-- kernel ideal sheaf of the same-site quotient map `π`.

section

variable (π : X.𝒪 ⟶ 𝒜)
variable {Z : LocallyRingedSpace.{u}} (i : Z ⟶ X)

variable (hπsurj : Sheaf.IsLocallySurjective π)
variable
  (hkerπ :
    Nonempty
      (kernel
        (SheafOfModules.unitToPushforwardObjUnit (ringedSiteStructureMap π))).LocalGeneratorsData)
variable (hbase : Topology.IsEmbedding i.base)
variable (hrange : Set.range i.base = ambientRingSheafSupport X 𝒜)
variable (e : pushedForwardStructureSheaf i ≅ ambientRingSheaf X 𝒜)
variable (hπ : RingedSpace.Hom.toRingCatSheafHom i.toShHom ≫ e.hom = ringSheafMap π)

/-- Example 26.4.3: let `π : \mathcal O_X \to \mathcal A` be a quotient sheaf of rings on a
locally ringed space `X`, and assume its kernel ideal sheaf is locally generated by sections. If
`\mathcal A` is the pushforward of the structure sheaf of a locally ringed space `Z` supported on
its own support subset in `X`, then the induced morphism `i : Z \to X` is a closed immersion. -/
@[stacks 01HM]
theorem isClosedImmersion_of_supported_quotient : IsClosedImmersion i := by
  sorry

/-- Closed-immersion source-spec companion: under the support-identification and quotient
compatibility hypotheses of Example 26.4.3, the induced morphism satisfies the canonical source
criterion for a closed immersion. -/
theorem isClosedImmersion_source_spec_of_supported_quotient :
    Topology.IsClosedEmbedding i.base ∧
      Sheaf.IsLocallySurjective (commRingSheafPushforwardMap i) ∧
      Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData :=
  (isClosedImmersion_of_supported_quotient π i hπsurj hkerπ hbase hrange e hπ).source_spec

end

end AlgebraicGeometry.LocallyRingedSpace
