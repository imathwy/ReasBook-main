import StacksProject_2024.Chap06.Definition_6_26_1
import StacksProject_2024.Chap26.Definition_26_4_1

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory
open CategoryTheory.Limits
open AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry.LocallyRingedSpace

-- Semantic recall: `lean_leansearch` surfaced the scheme-level closed-subscheme owners
-- `Scheme.IdealSheafData.subscheme`, `Scheme.IdealSheafData.ker_subschemeι`, and
-- `IsClosedImmersion.overEquivIdealSheafData`; the locally-ringed-space owner here uses the
-- Chapter 17/26 closed-immersion API and `closedImmersionIdealSubobject`.

/-- The ideal sheaf subobject cut out by a closed immersion of locally ringed spaces. -/
noncomputable abbrev closedImmersionIdealSubobject
    {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X) :
    Subobject
      (SheafOfModules.unit X.toRingedSpace.ringCatSheaf :
        RingedSpace.Modules X.toRingedSpace) :=
  Subobject.mk <|
    kernel.ι <|
      SheafOfModules.unitToPushforwardObjUnit
        (RingedSpace.Hom.toRingCatSheafHom i.toShHom)

/-- The pulled-back ideal-sheaf map `f^*\mathcal I \to \mathcal O_Y`. -/
noncomputable abbrev pullbackIdealToStructureSheaf
    {X Y : LocallyRingedSpace.{u}} (f : Y ⟶ X)
    (𝓘 :
      Subobject
        (SheafOfModules.unit X.toRingedSpace.ringCatSheaf :
          RingedSpace.Modules X.toRingedSpace)) :
  (RingedSpace.Hom.pullback f.toShHom).obj (𝓘 : RingedSpace.Modules X.toRingedSpace) ⟶
      (SheafOfModules.unit Y.toRingedSpace.ringCatSheaf :
        RingedSpace.Modules Y.toRingedSpace) :=
  (RingedSpace.Hom.pullback f.toShHom).map 𝓘.arrow ≫
    SheafOfModules.pullbackObjUnitToUnit (RingedSpace.Hom.toRingCatSheafHom f.toShHom)

/-- Definition 26.4.4: for a locally ringed space `X` and a sheaf of ideals `𝓘` on `X` locally
generated by sections, a morphism `i : Z ⟶ X` exhibits `Z` as the closed subspace of `X`
associated to `𝓘` if it is a closed immersion and its closed-immersion ideal sheaf is `𝓘`. -/
@[stacks 01HN]
class IsClosedSubspaceAssociatedTo {X Z : LocallyRingedSpace.{u}} (i : Z ⟶ X)
    (𝓘 : outParam
      (Subobject
        (SheafOfModules.unit X.toRingedSpace.ringCatSheaf :
          RingedSpace.Modules X.toRingedSpace))) :
    Prop extends IsClosedImmersion i where
  /-- The associated ideal sheaf is locally generated by sections, as in the source definition. -/
  ideal_locallyGenerated :
    Nonempty ((Subobject.underlying.obj 𝓘 : RingedSpace.Modules X.toRingedSpace).LocalGeneratorsData)
  /-- The ideal sheaf of the closed immersion is the source ideal sheaf `𝓘`. -/
  ideal_eq : closedImmersionIdealSubobject i = 𝓘

/-- A closed subspace associated to an ideal is a closed immersion. -/
instance instIsClosedImmersionOfIsClosedSubspaceAssociatedTo
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X}
    {𝓘 :
      Subobject
        (SheafOfModules.unit X.toRingedSpace.ringCatSheaf :
          RingedSpace.Modules X.toRingedSpace)}
    [h : IsClosedSubspaceAssociatedTo i 𝓘] :
    IsClosedImmersion i :=
  h.toIsClosedImmersion

/-- The defining conditions for being the closed subspace associated to an ideal sheaf. -/
theorem isClosedSubspaceAssociatedTo_iff
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X}
    {𝓘 :
      Subobject
        (SheafOfModules.unit X.toRingedSpace.ringCatSheaf :
          RingedSpace.Modules X.toRingedSpace)} :
    IsClosedSubspaceAssociatedTo i 𝓘 ↔
      IsClosedImmersion i ∧
        Nonempty ((Subobject.underlying.obj 𝓘 : RingedSpace.Modules X.toRingedSpace).LocalGeneratorsData) ∧
          closedImmersionIdealSubobject i = 𝓘 := by
  constructor
  · intro h
    exact ⟨h.toIsClosedImmersion, h.ideal_locallyGenerated, h.ideal_eq⟩
  · rintro ⟨hi, hloc, hideal⟩
    exact
      { toIsClosedImmersion := hi
        ideal_locallyGenerated := hloc
        ideal_eq := hideal }

/-- The source-facing specification exposes the local-generation and ideal-identification fields
of a closed subspace associated to an ideal sheaf. -/
@[stacks 01HN]
theorem IsClosedSubspaceAssociatedTo.source_spec
    {X Z : LocallyRingedSpace.{u}} {i : Z ⟶ X}
    {𝓘 :
      Subobject
        (SheafOfModules.unit X.toRingedSpace.ringCatSheaf :
          RingedSpace.Modules X.toRingedSpace)}
    (h : IsClosedSubspaceAssociatedTo i 𝓘) :
    Nonempty ((Subobject.underlying.obj 𝓘 : RingedSpace.Modules X.toRingedSpace).LocalGeneratorsData) ∧
      closedImmersionIdealSubobject i = 𝓘 := by
  exact ⟨h.ideal_locallyGenerated, h.ideal_eq⟩

end AlgebraicGeometry.LocallyRingedSpace
