import Mathlib
import StacksProject_2024.Chap26.Example_26_9_3

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open CategoryTheory
open PrimeSpectrum
open scoped AlgebraicGeometry PrimeSpectrum

namespace AlgebraicGeometry

noncomputable section

universe u

variable (k : Type u) [Field k] (n : ℕ)

-- Semantic recall: `lean_leansearch` surfaced `Scheme.GlueData`, `Scheme.GlueData.glued`,
-- `IsAffineOpen`, and `Scheme.ΓSpecIso` as the canonical scheme-gluing and affine-scheme API.
-- Local Chapter 26 precedent in Example 26.9.3 models punctured affine space by explicit
-- coordinate rings, origin points, and open subschemes.

/-- The coordinate ring `k[x_1, ..., x_n]` of affine `n`-space in
Example 26.14.3 (Affine space with zero doubled). -/
@[stacks 01JD]
abbrev affineSpaceWithZeroDoubledCoordinateRing : Type u :=
  MvPolynomial (Fin n) k

/-- Affine `n`-space `Spec(k[x_1, ..., x_n])`. -/
@[stacks 01JD]
abbrev affineSpaceWithZeroDoubledAffineSpace : Scheme.{u} :=
  Spec (CommRingCat.of (affineSpaceWithZeroDoubledCoordinateRing k n))

/-- The coordinate function `x_i` on affine `n`-space. -/
@[stacks 01JD]
abbrev affineSpaceWithZeroDoubledCoordinate
    (i : Fin n) : affineSpaceWithZeroDoubledCoordinateRing k n :=
  MvPolynomial.X i

/-- Evaluation at the origin of affine `n`-space. -/
@[stacks 01JD]
abbrev affineSpaceWithZeroDoubledEvalAtOrigin :
    affineSpaceWithZeroDoubledCoordinateRing k n →+* k :=
  MvPolynomial.eval₂Hom (algebraMap k k) (fun _ : Fin n ↦ (0 : k))

/-- The maximal ideal of functions vanishing at the origin. -/
@[stacks 01JD]
def affineSpaceWithZeroDoubledOriginIdeal :
    Ideal (affineSpaceWithZeroDoubledCoordinateRing k n) :=
  RingHom.ker (affineSpaceWithZeroDoubledEvalAtOrigin k n)

/-- The origin point of affine `n`-space. -/
@[stacks 01JD]
def affineSpaceWithZeroDoubledOrigin :
    PrimeSpectrum (affineSpaceWithZeroDoubledCoordinateRing k n) :=
  PrimeSpectrum.comap (affineSpaceWithZeroDoubledEvalAtOrigin k n) (IsLocalRing.closedPoint k)

/-- The origin ideal is generated by all coordinate functions. -/
@[stacks 01JD]
theorem affineSpaceWithZeroDoubledOriginIdeal_eq_span :
    affineSpaceWithZeroDoubledOriginIdeal k n =
      Ideal.span
        (Set.range (affineSpaceWithZeroDoubledCoordinate k n) :
          Set (affineSpaceWithZeroDoubledCoordinateRing k n)) := sorry

/-- The punctured affine `n`-space, represented as the union of the basic opens `D(x_i)`. -/
@[stacks 01JD]
abbrev affineSpaceWithZeroDoubledPuncturedOpen :
    (affineSpaceWithZeroDoubledAffineSpace k n).Opens :=
  ⨆ i : Fin n, PrimeSpectrum.basicOpen (affineSpaceWithZeroDoubledCoordinate k n i)

/-- The punctured open is the complement of the origin. -/
@[stacks 01JD]
theorem affineSpaceWithZeroDoubledPuncturedOpen_carrier_eq_compl_origin :
    (affineSpaceWithZeroDoubledPuncturedOpen k n :
        Set (affineSpaceWithZeroDoubledAffineSpace k n)) =
      ({affineSpaceWithZeroDoubledOrigin k n} :
        Set (affineSpaceWithZeroDoubledAffineSpace k n))ᶜ := sorry

/-- The transition isomorphism on the overlap is the identity map on punctured affine space,
corresponding to the `k`-algebra map carrying each target coordinate to the same source
coordinate. -/
@[stacks 01JD]
abbrev affineSpaceWithZeroDoubledTransition :
    (affineSpaceWithZeroDoubledPuncturedOpen k n).toScheme ⟶
      (affineSpaceWithZeroDoubledPuncturedOpen k n).toScheme :=
  𝟙 _

/-- The transition map on the punctured overlap is the identity. -/
@[stacks 01JD]
theorem affineSpaceWithZeroDoubledTransition_def :
    affineSpaceWithZeroDoubledTransition k n = 𝟙 _ := sorry

/-- A source-facing model of the scheme obtained by gluing two copies of affine `n`-space along
their common punctured affine open by the identity transition. -/
@[stacks 01JD]
structure AffineSpaceWithZeroDoubled where
  /-- The glued scheme `X`. -/
  X : Scheme.{u}
  /-- The two affine open charts corresponding to the two copies of affine space. -/
  chart : Fin 2 → X.Opens
  /-- The morphism from the doubled-origin affine space to ordinary affine `n`-space. -/
  toAffineSpace : X ⟶ affineSpaceWithZeroDoubledAffineSpace k n
  /-- The two origins `0_1` and `0_2` in the glued scheme. -/
  origin : Fin 2 → X
  /-- The two affine charts cover the glued scheme. -/
  chart_cover : chart 0 ⊔ chart 1 = ⊤
  /-- Each chart is an affine open of the glued scheme. -/
  chart_isAffineOpen : ∀ i, IsAffineOpen (chart i)
  /-- Each chart is identified with ordinary affine `n`-space. -/
  chart_iso : ∀ i, (chart i).toScheme ≅ affineSpaceWithZeroDoubledAffineSpace k n
  /-- The `i`-th origin lies in the `i`-th affine chart. -/
  origin_mem_chart : ∀ i, origin i ∈ chart i
  /-- The two origins remain distinct in the glued scheme. -/
  origin_distinct : origin 0 ≠ origin 1
  /-- Both origins map to the usual origin of affine `n`-space. -/
  origin_maps_to_zero : ∀ i, toAffineSpace.base (origin i) = affineSpaceWithZeroDoubledOrigin k n
  /-- The intersection of the two affine charts is the common punctured affine open. -/
  overlap_iso_punctured :
    (chart 0 ⊓ chart 1).toScheme ≅ (affineSpaceWithZeroDoubledPuncturedOpen k n).toScheme
  /-- The morphism to affine space identifies the ordinary coordinate ring with global sections
  of the doubled-origin scheme. -/
  globalSections_isIso :
    IsIso ((Scheme.ΓSpecIso
      (CommRingCat.of (affineSpaceWithZeroDoubledCoordinateRing k n))).inv ≫
        Scheme.Γ.map toAffineSpace.op)

/-- Each source chart of an affine space with zero doubled is an affine open. -/
@[stacks 01JD, instance]
instance AffineSpaceWithZeroDoubled.instIsAffineOpenChart
    (A : AffineSpaceWithZeroDoubled k n) (i : Fin 2) : IsAffineOpen (A.chart i) :=
  A.chart_isAffineOpen i

/-- The source-facing specification bundled by `AffineSpaceWithZeroDoubled`. -/
@[stacks 01JD]
theorem AffineSpaceWithZeroDoubled.spec (A : AffineSpaceWithZeroDoubled k n) :
    A.chart 0 ⊔ A.chart 1 = ⊤ ∧
      (∀ i, IsAffineOpen (A.chart i)) ∧
      (∀ i, A.origin i ∈ A.chart i) ∧
      A.origin 0 ≠ A.origin 1 ∧
      (∀ i, A.toAffineSpace.base (A.origin i) = affineSpaceWithZeroDoubledOrigin k n) ∧
      IsIso ((Scheme.ΓSpecIso
        (CommRingCat.of (affineSpaceWithZeroDoubledCoordinateRing k n))).inv ≫
          Scheme.Γ.map A.toAffineSpace.op) := sorry

/-- Example 26.14.3 (Affine space with zero doubled) (1): for every field `k` and `n ≥ 1`,
there is a source-facing affine `n`-space with zero doubled. -/
@[stacks 01JD]
theorem exists_affineSpaceWithZeroDoubled (hn : 1 ≤ n) :
    Nonempty (AffineSpaceWithZeroDoubled k n) := sorry

/-- Example 26.14.3 (Affine space with zero doubled) (2): the two origins have the same image in
ordinary affine space. -/
@[stacks 01JD]
theorem AffineSpaceWithZeroDoubled.origin_images_eq
    (A : AffineSpaceWithZeroDoubled k n) :
    A.toAffineSpace.base (A.origin 0) = A.toAffineSpace.base (A.origin 1) := sorry

/-- Example 26.14.3 (Affine space with zero doubled) (3): the doubled-origin affine space is not
affine. -/
@[stacks 01JD]
theorem AffineSpaceWithZeroDoubled.not_isAffine
    (hn : 1 ≤ n) (A : AffineSpaceWithZeroDoubled k n) :
    ¬ IsAffine A.X := sorry

/-- Example 26.14.3 (Affine space with zero doubled) (4): for `n = 2`, the punctured open used in
the doubled-origin construction is the punctured affine plane of Example 26.9.3. -/
@[stacks 01JD]
theorem affineSpaceWithZeroDoubledPuncturedOpen_two_eq_puncturedAffinePlane :
    affineSpaceWithZeroDoubledPuncturedOpen k 2 = puncturedAffinePlaneOpen k := sorry

/-- Example 26.14.3 (Affine space with zero doubled) (5): for `n = 2`, the intersection of the
two affine open charts is not affine. -/
@[stacks 01JD]
theorem AffineSpaceWithZeroDoubled.chart_inter_not_isAffine
    (A : AffineSpaceWithZeroDoubled k 2) :
    ¬ IsAffine (A.chart 0 ⊓ A.chart 1).toScheme := sorry

/-- Example 26.14.3 (Affine space with zero doubled) (6): for `n > 1`, there are infinitely many
irreducible closed subsets other than the two singleton origins. -/
@[stacks 01JD]
theorem AffineSpaceWithZeroDoubled.infinite_irreducibleClosedSubsets
    (hn : 1 < n) (A : AffineSpaceWithZeroDoubled k n) :
    Set.Infinite
      ({ T : Set A.X | IsClosed T } ∩
        { T : Set A.X | IsIrreducible T } ∩
        { T : Set A.X | T ≠ ({A.origin 0} : Set A.X) } ∩
        { T : Set A.X | T ≠ ({A.origin 1} : Set A.X) }) := sorry

/-- Example 26.14.3 (Affine space with zero doubled) (7): apart from the two singleton origins,
an irreducible closed subset contains one origin if and only if it contains the other. -/
@[stacks 01JD]
theorem AffineSpaceWithZeroDoubled.origin_mem_irreducibleClosed_iff
    (hn : 1 < n) (A : AffineSpaceWithZeroDoubled k n)
    {T : Set A.X} (hT_closed : IsClosed T) (hT_irreducible : IsIrreducible T)
    (hT_ne_origin0 : T ≠ ({A.origin 0} : Set A.X))
    (hT_ne_origin1 : T ≠ ({A.origin 1} : Set A.X)) :
    A.origin 0 ∈ T ↔ A.origin 1 ∈ T := sorry

end

end AlgebraicGeometry
