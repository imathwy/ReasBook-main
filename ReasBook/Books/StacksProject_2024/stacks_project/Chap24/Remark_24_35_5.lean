open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.ObjectProperty

noncomputable section

universe uR uQ vQ

attribute [local instance] HasDerivedCategory.standard

namespace CategoryTheory.DerivedCategory

-- Semantic recall note: `lean_leansearch` surfaced only mathlib's unrelated regular-sequence
-- API, so the owner choice here follows the local Chapter 15 powered-Koszul tower
-- `derivedCompletionKoszulPowersDerivedInverseSystem` and the Chapter 24 quotient-tower
-- equivalence surface from Proposition `24.35.4`.

section

variable {R : Type uR} [CommRing R] {r : ℕ}

local notation "DMod" => DerivedCategory (ModuleCat R)

/-- Remark 24.35.5 (1): let `f_1, \ldots, f_r` generate an ideal in a commutative ring `R`, and
for each `n` let `K_n` be the Koszul complex on
`f_1^n, \ldots, f_r^n`, viewed in the local stage convention where file index `n` corresponds to
the textbook stage `n + 1`. The sequence is weakly proregular if for every positive cohomological
degree and every stage there is a later stage whose transition map induces the zero map on that
cohomology group. In the current derived-category model this is recorded as eventual vanishing of
the transition maps on `H^{-p}` for every `p > 0`. -/
@[stacks 0H1E]
def isWeaklyProregular (f : Fin r → R) : Prop :=
  ∀ (p n : ℕ), 0 < p →
    ∃ m, ∃ hmn : n < m,
      (DerivedCategory.homologyFunctor (ModuleCat R) (-(p : ℤ))).map
          ((derivedCompletionKoszulPowersDerivedInverseSystem f).map
            (homOfLE (Nat.le_of_lt hmn)).op) =
        0

/-- The predicate `isWeaklyProregular` is exactly eventual vanishing of every positive-degree
transition map in the powered-Koszul tower. -/
theorem isWeaklyProregular_iff (f : Fin r → R) :
    isWeaklyProregular f ↔
      ∀ (p n : ℕ), 0 < p →
        ∃ m, ∃ hmn : n < m,
          (DerivedCategory.homologyFunctor (ModuleCat R) (-(p : ℤ))).map
              ((derivedCompletionKoszulPowersDerivedInverseSystem f).map
                (homOfLE (Nat.le_of_lt hmn)).op) =
            0 :=
  Iff.rfl

section

variable (I : Ideal R)

local notation "DComp" =>
  ObjectProperty.FullSubcategory (derivedCompleteObjectProperty I)

/-- Remark 24.35.5 (2): if an ideal `I ⊆ R` is generated by a weakly proregular sequence
`f_1, \ldots, f_r`, then the quotient-tower statement of Proposition `24.35.4` continues to hold
without a Noetherian hypothesis on `R`. Concretely, for the chosen functor from
`D_{comp}(R, I)` to `QC(\{R / I^n\})`, if there is a chosen right adjoint whose kernel is zero and
whose adjunction unit is an isomorphism on every derived-complete object, then that functor is an
equivalence. -/
@[stacks 0H1E]
theorem derivedCompleteToQuotientTowerQC_isEquivalence_of_isWeaklyProregular
    {r : ℕ} (f : Fin r → R) (hf : Ideal.span (Set.range f) = I)
    (hweak : isWeaklyProregular f)
    {QCA : Type uQ} [Category.{vQ} QCA]
    (quotientTowerPullback : DComp ⥤ QCA)
    (quotientTowerPushforward : QCA ⥤ DComp)
    (adj : quotientTowerPullback ⊣ quotientTowerPushforward)
    (hunit : ∀ K : DComp, IsIso (adj.unit.app K))
    (hkernel : quotientTowerPushforward.kernel ≤ CategoryTheory.Limits.IsZero) :
    Functor.IsEquivalence quotientTowerPullback := sorry

end

end

end CategoryTheory.DerivedCategory
