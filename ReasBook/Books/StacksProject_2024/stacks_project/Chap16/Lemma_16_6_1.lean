universe u v w y

namespace Algebra

section

variable {R : Type u} {Λ : Type v} {Cbar : Type w}
variable [CommRing R] [CommRing Λ] [CommRing Cbar] [Algebra R Λ]
variable (π : R)

local notation "Ipi" => Ideal.span ({(π : R)} : Set R)
local notation "IpiSq" => Ideal.span ({π ^ 2} : Set R)
local notation "IpiBar" => Ideal.span ({Ideal.Quotient.mk IpiSq π} : Set (R ⧸ IpiSq))
local notation "CbarPi" =>
  Cbar ⧸ Ideal.map (algebraMap (R ⧸ IpiSq) Cbar) IpiBar
local notation "AnnR[" x "]" => Ideal.torsionOf R R x
local notation "AnnΛ[" x "]" => Ideal.torsionOf Λ Λ x

/-
Domain-style sampling pass for Lemma 16.6.1.

Primary domain: smoothness for finitely presented quotient algebras over `R ⧸ π²R`, together with
the canonical torsion-ideal equalities `Ann_R(π) = Ann_R(π²)` and `Ann_Λ(π) = Ann_Λ(π²)`, the
reduction maps modulo `π`, and primewise smoothness over the induced map `C̄ / π C̄ → D / π D`.

Sampled owner declarations:
* `Ideal.torsionOf` from the chapter's annihilator/torsion API;
* `SmoothAtPrime` from the project's source-facing smooth-locus API;
* `AlgHom.SmoothAtPrime` for the induced smoothness condition on a target prime;
* `Algebra.IsSmoothAt` from mathlib's smooth-locus API;
* `Ideal.quotientMapₐ` for quotient maps induced by algebra maps;
* `Ideal.Quotient.liftₐ` for canonical descent along quotient ideals.

Best owner abstraction: the theorem is source-facing existential data, but its bridge layer should
use the canonical owners `Ideal.torsionOf`, `SmoothAtPrime`, and the quotient-map API above rather
than local annihilator presentations or local copies. The mod-`π` smoothness condition is
naturally a statement about an explicit `AlgHom` `C̄ / π C̄ → D / π D`, with `SmoothAtPrime` as
the source-facing primewise owner and `Algebra.IsSmoothAt` as its canonical local bridge.

Primitive-vs-derived split:
* primitive data: the torsion-ideal equalities `AnnR[π] = AnnR[π ^ 2]` and
  `AnnΛ[algebraMap R Λ π] = AnnΛ[algebraMap R Λ (π ^ 2)]`, the quotient ideals `πR`, `π²R`, the
  given map `C̄ → Λ / π²Λ`, and the comparison map `C̄ → D / πD`;
* derived API: the `(R ⧸ π²R)`-algebra structures on the quotient rings, the reduction
  compatibility maps to `Λ / πΛ`, the descended map `C̄ / π C̄ → D / πD` obtained from
  `Ideal.Quotient.liftₐ`, and the primewise smoothness predicates.

Source/core/bridge triage:
* `source-facing`: the existential lifting theorem below;
* `core/canonical`: `Ideal.torsionOf`, `SmoothAtPrime`, `Algebra.IsSmoothAt`,
  `Ideal.quotientMapₐ`, and `Ideal.Quotient.liftₐ`;
* `bridge/view`: the explicit reduction maps modulo `π` and the canonical descended map
  `C̄ / π C̄ → D / πD`.
-/

/-- The principal ideal generated by `π²` is contained in the principal ideal generated by `π`. -/
private theorem piSq_le_pi : IpiSq ≤ Ipi := by
  rw [Ideal.span_singleton_le_iff_mem]
  simpa [pow_two] using
    Ideal.mul_mem_left (Ideal.span ({(π : R)} : Set R)) π (Ideal.mem_span_singleton_self π)

private theorem map_pi_le_comap_map_pi {D : Type y} [CommRing D] [Algebra R D]
    (lift : D →ₐ[R] Λ) :
    Ideal.map (algebraMap R D) Ipi ≤
      Ideal.comap (lift : D →+* Λ) (Ideal.map (algebraMap R Λ) Ipi) := by
  simpa [Ideal.map_map] using
    (show Ideal.map (algebraMap R D) Ipi ≤
        Ideal.comap (lift : D →+* Λ) (Ideal.map (lift : D →+* Λ) (Ideal.map (algebraMap R D) Ipi))
      from Ideal.le_comap_map)

noncomputable local instance localizedAwayAlgebra {A : Type y} [CommRing A] [Algebra R A] :
    Algebra (Localization.Away π) (Localization.Away (algebraMap R A π)) := by
  letI : IsLocalization.Away ((Algebra.ofId R A) π) (Localization.Away (algebraMap R A π)) := by
    simpa using
      (inferInstance :
        IsLocalization.Away (algebraMap R A π) (Localization.Away (algebraMap R A π)))
  exact (Localization.awayMapₐ (Algebra.ofId R A) π).toAlgebra

local instance {A : Type y} [CommRing A] [Algebra R A] :
    Algebra (R ⧸ IpiSq) (A ⧸ Ideal.map (algebraMap R A) Ipi) :=
  Ideal.Quotient.algebraQuotientOfLEComap <| (piSq_le_pi π).trans Ideal.le_comap_map

/-- The reduction modulo `π` induced by an `R`-algebra map, viewed over `R / π²R`. -/
def piQuotientMap {D : Type y} [CommRing D] [Algebra R D]
    (lift : D →ₐ[R] Λ) :
    D ⧸ Ideal.map (algebraMap R D) Ipi →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) Ipi :=
  { toRingHom := (Ideal.quotientMapₐ (Ideal.map (algebraMap R Λ) Ipi) lift
        (map_pi_le_comap_map_pi π lift)).toRingHom
    commutes' := by
      intro r
      refine Quotient.inductionOn' r fun r ↦ ?_
      change Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) Ipi) (lift (algebraMap R D r)) =
        Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) Ipi) (algebraMap R Λ r)
      rw [lift.commutes] }

/-- Postcomposing with the canonical quotient map `Λ / π²Λ → Λ / πΛ`. -/
def factorToPiQuotient [Algebra (R ⧸ IpiSq) Cbar]
    (toLambda2 : Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) IpiSq) :
    Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) Ipi :=
  { toRingHom := (factorₐ R (Ideal.map_mono (piSq_le_pi π))).toRingHom.comp toLambda2.toRingHom
    commutes' := by
      intro r
      refine Quotient.inductionOn' r fun r ↦ ?_
      change
        (factorₐ R (Ideal.map_mono (piSq_le_pi π))).toRingHom
            (toLambda2 ((algebraMap (R ⧸ IpiSq) Cbar) (Ideal.Quotient.mk IpiSq r))) =
          algebraMap (R ⧸ IpiSq) (Λ ⧸ Ideal.map (algebraMap R Λ) Ipi)
            (Ideal.Quotient.mk IpiSq r)
      rw [toLambda2.commutes]
      rfl }

private theorem map_CbarPi_ideal_le_ker {D : Type y} [CommRing D] [Algebra R D]
    [Algebra (R ⧸ IpiSq) Cbar] (fbar : Cbar →ₐ[R ⧸ IpiSq] D ⧸ Ideal.map (algebraMap R D) Ipi) :
    Ideal.map (algebraMap (R ⧸ IpiSq) Cbar) IpiBar ≤ RingHom.ker fbar.toRingHom := by
  rw [Ideal.map_le_iff_le_comap, Ideal.span_singleton_le_iff_mem]
  rw [Ideal.mem_comap, RingHom.mem_ker]
  rw [show
      fbar.toRingHom ((algebraMap (R ⧸ IpiSq) Cbar) (Ideal.Quotient.mk IpiSq π)) =
        algebraMap (R ⧸ IpiSq) (D ⧸ Ideal.map (algebraMap R D) Ipi)
          (Ideal.Quotient.mk IpiSq π) from
      fbar.commutes (Ideal.Quotient.mk IpiSq π)]
  change Ideal.Quotient.mk (Ideal.map (algebraMap R D) Ipi) (algebraMap R D π) = 0
  rw [eq_zero_iff_mem]
  exact Ideal.mem_map_of_mem (algebraMap R D) (Ideal.mem_span_singleton_self π)

/-- The canonical descended map `C̄ / π C̄ → D / πD` induced by `fbar`. -/
def descendToPiQuotient {D : Type y} [CommRing D] [Algebra R D] [Algebra (R ⧸ IpiSq) Cbar]
    (fbar : Cbar →ₐ[R ⧸ IpiSq] D ⧸ Ideal.map (algebraMap R D) Ipi) :
    CbarPi →ₐ[R ⧸ IpiSq] D ⧸ Ideal.map (algebraMap R D) Ipi :=
  liftₐ (Ideal.map (algebraMap (R ⧸ IpiSq) Cbar) IpiBar) fbar
    fun _ ha ↦ RingHom.mem_ker.mp (map_CbarPi_ideal_le_ker π fbar ha)

/-- Helper for Lemma 16.6.1: the smooth locus of `Spec C̄` is covered by finitely many basic opens
cut out by elementary standard elements of `C̄` over `R / π²R`. -/
private theorem exists_finite_elementaryStandard_cover_of_smooth_locus
    [IsNoetherianRing R]
    [Algebra (R ⧸ IpiSq) Cbar] [FinitePresentation (R ⧸ IpiSq) Cbar] :
    ∃ t : Finset Cbar,
      (∀ a ∈ t, IsElementaryStandard (R ⧸ IpiSq) a) ∧
      ∀ q : PrimeSpectrum Cbar, SmoothAtPrime (R ⧸ IpiSq) Cbar q →
        ∃ a ∈ t, a ∉ q.asIdeal := by
  classical
  let U : Cbar → Set (PrimeSpectrum Cbar) := fun a ↦
    if IsElementaryStandard (R ⧸ IpiSq) a then PrimeSpectrum.basicOpen a else ∅
  -- Each chart in the auxiliary cover is open by construction.
  have hUopen : ∀ a, IsOpen (U a) := by
    intro a
    by_cases h : IsElementaryStandard (R ⧸ IpiSq) a
    · simpa [U, h] using
        (PrimeSpectrum.isOpen_basicOpen : IsOpen (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum Cbar)))
    · simp [U, h]
  -- Lemma `16.2.2` gives a basic-open elementary-standard neighborhood around every smooth point.
  have hcover : smoothLocus (R ⧸ IpiSq) Cbar ⊆ ⋃ a, U a := by
    intro q hq
    have hqIsSmooth : IsSmoothAt (R ⧸ IpiSq) q.asIdeal := by
      simpa [smoothLocus] using hq
    have hq' : SmoothAtPrime (R ⧸ IpiSq) Cbar q :=
      (smoothAtPrime_iff_isSmoothAt (R := R ⧸ IpiSq) (S := Cbar) q).2 hqIsSmooth
    obtain ⟨a, haq, ha⟩ :=
      smoothAtPrime_exists_not_mem_isElementaryStandard (R := R ⧸ IpiSq) (A := Cbar) q hq'
    refine Set.mem_iUnion.2 ⟨a, ?_⟩
    simp [U, ha, haq]
  letI : Algebra.FiniteType (R ⧸ IpiSq) Cbar := inferInstance
  letI : IsNoetherianRing Cbar :=
    Algebra.FiniteType.isNoetherianRing (R := R ⧸ IpiSq) (S := Cbar)
  -- Quasi-compactness of the smooth locus reduces the open cover to finitely many charts.
  have hcompact : IsCompact (smoothLocus (R ⧸ IpiSq) Cbar) :=
    TopologicalSpace.NoetherianSpace.isCompact _
  obtain ⟨t, ht⟩ := hcompact.elim_finite_subcover U hUopen hcover
  let t' : Finset Cbar := t.filter fun a ↦ IsElementaryStandard (R ⧸ IpiSq) a
  refine ⟨t', ?_, ?_⟩
  · intro a ha
    exact (Finset.mem_filter.1 ha).2
  · intro q hq
    have hq' : q ∈ smoothLocus (R ⧸ IpiSq) Cbar := by
      have hqIsSmooth : IsSmoothAt (R ⧸ IpiSq) q.asIdeal :=
        (smoothAtPrime_iff_isSmoothAt (R := R ⧸ IpiSq) (S := Cbar) q).1 hq
      simpa [smoothLocus] using hqIsSmooth
    have hmem : q ∈ ⋃ a ∈ t, U a := ht hq'
    rcases Set.mem_iUnion₂.1 hmem with ⟨a, hat, hqa⟩
    have ha : IsElementaryStandard (R ⧸ IpiSq) a := by
      by_cases h : IsElementaryStandard (R ⧸ IpiSq) a
      · exact h
      · simp [U, h] at hqa
    refine ⟨a, Finset.mem_filter.2 ⟨hat, ha⟩, ?_⟩
    simpa [U, ha] using hqa

/-- Helper for Lemma 16.6.1: freeze one finite presentation of `C̄` over `R / π²R`, and choose
explicit lifts of its defining relations to polynomials over `R` and of its generators to
elements of `Λ`. This matches the source proof's first step before refining the smooth cover to
that fixed presentation. -/
private theorem choose_common_presentation_with_relation_and_generator_lifts
    [Algebra (R ⧸ IpiSq) Cbar] [FinitePresentation (R ⧸ IpiSq) Cbar]
    (toLambda2 : Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) IpiSq) :
    ∃ n, ∃ m,
      ∃ P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m),
      ∃ relationLift : Fin m → MvPolynomial (Fin n) R,
      ∃ generatorLift : Fin n → Λ,
        (∀ j,
          MvPolynomial.map (Ideal.Quotient.mk IpiSq) (relationLift j) = P.relation j) ∧
        (∀ i,
          Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq) (generatorLift i) =
            toLambda2 (P.val i)) := by
  classical
  let n := Algebra.Presentation.ofFinitePresentationVars (R ⧸ IpiSq) Cbar
  let m := Algebra.Presentation.ofFinitePresentationRels (R ⧸ IpiSq) Cbar
  let P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m) :=
    Algebra.Presentation.ofFinitePresentation (R ⧸ IpiSq) Cbar
  let relationLift : Fin m → MvPolynomial (Fin n) R := fun j ↦
    Classical.choose <|
      MvPolynomial.map_surjective (Ideal.Quotient.mk IpiSq) Ideal.Quotient.mk_surjective
        (P.relation j)
  let generatorLift : Fin n → Λ := fun i ↦
    Classical.choose (Ideal.Quotient.mk_surjective (toLambda2 (P.val i)))
  refine ⟨n, m, P, relationLift, generatorLift, ?_, ?_⟩
  · intro j
    -- Each relation polynomial over `R / π²R` is lifted coefficientwise along the quotient map.
    exact Classical.choose_spec <|
      MvPolynomial.map_surjective (Ideal.Quotient.mk IpiSq) Ideal.Quotient.mk_surjective
        (P.relation j)
  · intro i
    -- Each chosen presentation generator is lifted along `Λ → Λ / π²Λ`.
    exact Classical.choose_spec (Ideal.Quotient.mk_surjective (toLambda2 (P.val i)))

/-- Helper for Lemma 16.6.1: a standard-smooth algebra admits a normalized finite submersive
presentation whose first `n` distinguished generators realize any prescribed finite family
`β : Fin n → A`, even when repetitions occur. This is the family-valued variant of the
prescribed-generator API needed for the frozen-presentation localization bridge. -/
theorem IsStandardSmooth.exists_submersivePresentation_with_prescribed_family
    {A : Type w} [CommRing A] [Algebra R A] {n : ℕ} [IsStandardSmooth R A]
    (β : Fin n → A) :
    ∃ (c m : ℕ) (P : SubmersivePresentation R A (Fin c ⊕ Fin m) (Fin c)) (h : n ≤ c),
      P.map = Sum.inl ∧ ∀ i : Fin n, P.val (.inl (Fin.castLE h i)) = β i := by
  classical
  obtain ⟨ι, σ, hσ, hι, ⟨P₀⟩⟩ := IsStandardSmooth.out (R := R) (S := A)
  letI : Finite σ := hσ
  letI : Finite ι := hι
  -- First normalize the chosen standard-smooth witness so that the Jacobian variables occupy
  -- the left `Fin c₀`-summand.
  obtain ⟨c₀, m₀, Pstd, hPstd_map⟩ :=
    SubmersivePresentation.exists_sum_fin_reindex (R := R) (A := A) P₀
  -- Then adjoin the linear presentation cutting out the prescribed family `β`.
  let Qβ : SubmersivePresentation A A (Fin n) (Fin n) := linearSubmersivePresentation β
  have hQβ_map : Qβ.map = (fun i ↦ i) := linearSubmersivePresentation_map β
  have hQβ_val : ∀ i : Fin n, Qβ.val i = β i := linearSubmersivePresentation_val β
  let eRel : Fin (n + c₀) ≃ Fin n ⊕ Fin c₀ := finSumFinEquiv.symm
  let eVar : Fin (n + c₀) ⊕ Fin m₀ ≃ Fin n ⊕ (Fin c₀ ⊕ Fin m₀) :=
    (Equiv.sumCongr (finSumFinEquiv.symm) (Equiv.refl _)).trans (Equiv.sumAssoc _ _ _)
  let P : SubmersivePresentation R A (Fin (n + c₀) ⊕ Fin m₀) (Fin (n + c₀)) :=
    (Qβ.comp Pstd).reindex eVar eRel
  refine ⟨n + c₀, m₀, P, Nat.le_add_right n c₀, ?_⟩
  constructor
  · -- Compute the normalized map by splitting along the adjoined linear summand.
    ext x
    change eVar.symm
        (Sum.elim (fun rq : Fin n ↦ Sum.inl (Qβ.map rq))
          (fun rp : Fin c₀ ↦ Sum.inr (Pstd.map rp)) (eRel x)) = Sum.inl x
    rw [hQβ_map, hPstd_map]
    cases h : eRel x with
    | inl i =>
        have hx : x = Fin.castAdd c₀ i := by
          simpa [eRel] using congrArg finSumFinEquiv h
        simp [eVar, hx]
    | inr j =>
        have hx : x = Fin.natAdd n j := by
          simpa [eRel] using congrArg finSumFinEquiv h
        simp [eVar, hx]
  · intro i
    -- The first `n` distinguished variables come from the linear presentation of `β`.
    rw [fin_castLE_le_add_right_eq_castAdd]
    change Sum.elim Qβ.val ((algebraMap A A) ∘ Pstd.val) (eVar (.inl (Fin.castAdd c₀ i))) = β i
    have hx : eVar (.inl (Fin.castAdd c₀ i)) = Sum.inl i := by
      simp [eVar, finSumFinEquiv]
    rw [hx]
    exact hQβ_val i

namespace Presentation

/-- Helper for Lemma 16.6.1: the canonical `σ`-tail data attached to one elementary-standard
chart in the fixed presentation `P`. This freezes the chart witness in the exact form needed
before the later denominator-clearing step. -/
private structure SigmaTailChartData
    {n m : ℕ} (P : Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m)) (a : Cbar) where
  c : ℕ
  hcₙ : c ≤ n
  hcₘ : c ≤ m
  a' : Cbar
  leading_eq :
    a = a' * algebraMap P.Ring Cbar (P.leadingJacobianDet hcₙ hcₘ)
  tail_mem :
    ∀ j : Fin (m - c),
      P.σ a * P.relation (tailRelationIndex hcₘ j) ∈
        P.leadingRelationIdeal hcₘ + P.ker ^ 2

/-- Helper for Lemma 16.6.1: every elementary-standard chart of the frozen presentation `P`
admits explicit `σ`-tail data. This isolates the part of the source proof already justified by
`Lemma 16.3.7`. -/
private theorem exists_sigmaTailChartData_of_isElementaryStandardElement
    {n m : ℕ} (P : Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m)) {a : Cbar}
    (h : P.IsElementaryStandardElement a) :
    Nonempty (SigmaTailChartData (R := R) (Cbar := Cbar) (π := π) P a) := by
  obtain ⟨c, hcₙ, hcₘ, a', ha, htail⟩ :=
    P.exists_elementaryStandard_data_with_sigma_tail h
  -- Repackage the existing witness as a reusable chart-data object.
  exact ⟨{
    c := c
    hcₙ := hcₙ
    hcₘ := hcₘ
    a' := a'
    leading_eq := ha
    tail_mem := htail
  }⟩

/-- Helper for Lemma 16.6.1: the fixed-presentation bridge from a standard-smooth localization to
an elementary-standard power in that same presentation. This is the denominator-clearing step from
the source proof; the remaining work is to compare the localization of `P` with a prescribed
submersive presentation and descend the Jacobian witness by a power of `a`. -/
private theorem exists_power_isElementaryStandardElement_of_isStandardSmoothAway
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ} (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m)) (a : Cbar)
    (h : IsStandardSmooth (R ⧸ IpiSq) (Localization.Away a)) :
    ∃ N : ℕ, 1 ≤ N ∧ P.IsElementaryStandardElement (a ^ N) := by
  obtain ⟨e0, he0⟩ :=
    P.exists_eventually_isElementaryStandardElement_of_isStandardSmooth_localizationAway a h
  refine ⟨max e0 1, le_max_right _ _, ?_⟩
  -- Any exponent past the eventual threshold gives the desired fixed-presentation witness.
  exact he0 _ (le_max_left _ _)

/-- Helper for Lemma 16.6.1: once `a` is known to be elementary standard abstractly, the
localized algebra `C̄[1/a]` is standard smooth, so the fixed-presentation bridge above upgrades a
positive power of `a` to an elementary-standard element for the frozen presentation `P`. -/
private theorem exists_power_isElementaryStandardElement_of_isElementaryStandard
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ} (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m)) (a : Cbar)
    (h : IsElementaryStandard (R ⧸ IpiSq) a) :
    ∃ N : ℕ, 1 ≤ N ∧ P.IsElementaryStandardElement (a ^ N) := by
  -- First pass from the abstract elementary-standard witness to standard smoothness away from `a`.
  letI : IsStandardSmooth (R ⧸ IpiSq) (Localization.Away a) :=
    isElementaryStandard_implies_standardSmoothAway (R := R ⧸ IpiSq) a h
  -- Then apply the source-faithful fixed-presentation bridge to descend a positive power to `P`.
  exact Presentation.exists_power_isElementaryStandardElement_of_isStandardSmoothAway
    (P := P) (a := a) (h := inferInstance)

end Presentation

/-- Helper for Lemma 16.6.1: once the smooth locus has been refined to fixed-presentation charts,
choose explicit `σ`-tail witnesses for every chart in that finite family. This freezes the
chartwise input data needed for the later global quotient construction. -/
private theorem exists_sigmaTailChartData_family_on_cover
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ} (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m))
    (t : Finset Cbar)
    (htElementary : ∀ a ∈ t, P.IsElementaryStandardElement a) :
    Nonempty (∀ a : { a // a ∈ t },
      Presentation.SigmaTailChartData (R := R) (Cbar := Cbar) (π := π) P a.1) := by
  classical
  refine ⟨fun a ↦ ?_⟩
  -- Choose the sigma-tail witness attached to this fixed chart.
  exact Classical.choice <|
    P.exists_sigmaTailChartData_of_isElementaryStandardElement (R := R) (Cbar := Cbar) (π := π)
      (htElementary a.1 a.2)

/-- Helper for Lemma 16.6.1: after freezing one presentation `P` of `C̄`, the smooth locus is
still covered by finitely many basic opens cut out by elements that are elementary standard in
that same presentation. This is the source proof's fixed-presentation refinement step. -/
private theorem exists_finite_fixed_presentation_chart_cover_of_smooth_locus
    [IsNoetherianRing R]
    [Algebra (R ⧸ IpiSq) Cbar] [FinitePresentation (R ⧸ IpiSq) Cbar]
    {n m : ℕ} (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m)) :
    ∃ t : Finset Cbar,
      (∀ a ∈ t, P.IsElementaryStandardElement a) ∧
      ∀ q : PrimeSpectrum Cbar, SmoothAtPrime (R ⧸ IpiSq) Cbar q →
        ∃ a ∈ t, a ∉ q.asIdeal := by
  classical
  obtain ⟨t, htElementary, htCover⟩ :=
    exists_finite_elementaryStandard_cover_of_smooth_locus (R := R) (Cbar := Cbar) (π := π)
  have hrefine :
      ∀ a ∈ t, ∃ N : ℕ, 1 ≤ N ∧ P.IsElementaryStandardElement (a ^ N) := by
    intro a ha
    -- Refine each abstract elementary-standard chart to one expressed in the frozen presentation.
    letI : IsStandardSmooth (R ⧸ IpiSq) (Localization.Away a) :=
      isElementaryStandard_implies_standardSmoothAway (R := R ⧸ IpiSq) a (htElementary a ha)
    exact Presentation.exists_power_isElementaryStandardElement_of_isStandardSmoothAway
      (P := P) (a := a) (h := inferInstance)
  let chosenPower : { a // a ∈ t } → ℕ := fun a ↦ Classical.choose (hrefine a.1 a.2)
  have hChosenPower :
      ∀ a : { a // a ∈ t }, P.IsElementaryStandardElement (a.1 ^ chosenPower a) := by
    intro a
    exact (Classical.choose_spec (hrefine a.1 a.2)).2
  let t' : Finset Cbar := t.attach.image fun a ↦ a.1 ^ chosenPower a
  refine ⟨t', ?_, ?_⟩
  · intro b hb
    rcases Finset.mem_image.mp hb with ⟨a, ha, rfl⟩
    -- Every element in the refined finite family comes from the chosen power witness.
    exact hChosenPower a
  · intro q hq
    obtain ⟨a, ha, haq⟩ := htCover q hq
    let a' : { a // a ∈ t } := ⟨a, ha⟩
    refine ⟨a ^ chosenPower a', ?_, ?_⟩
    · -- The covering element is exactly the chosen power attached to the original chart `a`.
      exact Finset.mem_image.mpr ⟨a', by simp [a'], rfl⟩
    · -- A prime containing the chosen power would contain `a`, contradicting the original cover.
      exact fun hpow ↦ haq ((inferInstance : q.asIdeal.IsPrime).mem_of_pow_mem _ hpow)

/-- Helper for Lemma 16.6.1: evaluating the lifted defining relations of the frozen presentation at
the chosen lifts of the generators lands in the principal ideal `(π²) ⊂ Λ`. This is the source
proof's first explicit error-term normalization before adjoining the variables `z_j`. -/
private theorem map_presentation_eval
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ}
    (toLambda2 : Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) IpiSq)
    (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m)) :
    ∀ p : MvPolynomial (Fin n) (R ⧸ IpiSq),
      MvPolynomial.aeval (fun i ↦ toLambda2 (P.val i)) p =
        toLambda2 (MvPolynomial.aeval P.val p) := by
  intro p
  induction p using MvPolynomial.induction_on with
  | C a =>
      -- Constants are preserved because `toLambda2` is an `(R / π²R)`-algebra map.
      simpa using (toLambda2.commutes a)
  | add p q hp hq =>
      -- Addition is handled termwise by the ring-homomorphism structure.
      simpa [map_add] using congrArg₂ (fun x y ↦ x + y) hp hq
  | mul_X p i hp =>
      -- Multiplication by a variable evaluates at the chosen image of that presentation generator.
      simpa [MvPolynomial.aeval_def, map_mul] using
        congrArg (fun x ↦ x * toLambda2 (P.val i)) hp

/-- Helper for Lemma 16.6.1: quotienting after evaluating a lifted polynomial over `R` agrees with
evaluating its reduction over `R / π²R` at the quotient classes of the chosen generator lifts. -/
private theorem quotient_evaluates_relationLift
    {n : ℕ} (generatorLift : Fin n → Λ) :
    ∀ p : MvPolynomial (Fin n) R,
      Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq)
          (MvPolynomial.aeval generatorLift p) =
        MvPolynomial.aeval
          (fun i ↦ Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq) (generatorLift i))
          (MvPolynomial.map (Ideal.Quotient.mk IpiSq) p) := by
  intro p
  induction p using MvPolynomial.induction_on with
  | C a =>
      -- Constants descend along the quotient map because the quotient carries the induced algebra.
      simp
  | add p q hp hq =>
      -- Addition commutes with evaluation and with the quotient map.
      simpa [map_add] using congrArg₂ (fun x y ↦ x + y) hp hq
  | mul_X p i hp =>
      -- Multiplication by a variable evaluates at the chosen quotient class of `generatorLift i`.
      simpa [MvPolynomial.aeval_def, map_mul] using
        congrArg
          (fun x ↦ x *
            Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq) (generatorLift i))
          hp

/-- Helper for Lemma 16.6.1: any polynomial over `R` whose reduction modulo `π²` lands in the
presentation kernel evaluates at the chosen generator lifts to a `π²`-multiple in `Λ`. This is
the kernel-valued version of the relation-error normalization used repeatedly in the source proof.
-/
private theorem lift_eval_eq_piSq_mul_of_mapped_mem_ker
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ}
    (toLambda2 : Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) IpiSq)
    (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m))
    (generatorLift : Fin n → Λ)
    (hGeneratorLift : ∀ i,
      Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq) (generatorLift i) =
        toLambda2 (P.val i))
    {p : MvPolynomial (Fin n) R}
    (hp : MvPolynomial.map (Ideal.Quotient.mk IpiSq) p ∈ P.ker) :
    ∃ μ : Λ,
      MvPolynomial.aeval generatorLift p =
        algebraMap R Λ (π ^ 2) * μ := by
  have hrel_zero :
      MvPolynomial.aeval (fun i ↦ toLambda2 (P.val i))
          (MvPolynomial.map (Ideal.Quotient.mk IpiSq) p) = 0 := by
    -- Elements of the presentation kernel evaluate to zero after mapping into `C̄`.
    rwa [P.ker_eq_ker_aeval_val, RingHom.mem_ker] at hp
  have hquot :
      Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq)
          (MvPolynomial.aeval generatorLift p) = 0 := by
    -- Move evaluation through the quotient and rewrite the variables using the chosen lifts.
    calc
      Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq)
          (MvPolynomial.aeval generatorLift p) =
        MvPolynomial.aeval
          (fun i ↦ Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq) (generatorLift i))
          (MvPolynomial.map (Ideal.Quotient.mk IpiSq) p) :=
            quotient_evaluates_relationLift (R := R) (Λ := Λ) (π := π) generatorLift p
      _ = MvPolynomial.aeval (fun i ↦ toLambda2 (P.val i))
            (MvPolynomial.map (Ideal.Quotient.mk IpiSq) p) := by
            simp [hGeneratorLift]
      _ = 0 := hrel_zero
  have hmem :
      MvPolynomial.aeval generatorLift p ∈
        Ideal.map (algebraMap R Λ) IpiSq := by
    exact Ideal.Quotient.eq_zero_iff_mem.mp hquot
  have hmem_span :
      MvPolynomial.aeval generatorLift p ∈
        Ideal.span ({algebraMap R Λ (π ^ 2)} : Set Λ) := by
    simpa [Ideal.map_span, Set.image_singleton] using hmem
  rcases Ideal.mem_span_singleton.mp hmem_span with ⟨μ, hμ⟩
  exact ⟨μ, hμ⟩

/-- Helper for Lemma 16.6.1: evaluating the lifted defining relations of the frozen presentation at
the chosen lifts of the generators lands in the principal ideal `(π²) ⊂ Λ`. This is the source
proof's first explicit error-term normalization before adjoining the variables `z_j`. -/
private theorem relationLift_eval_eq_piSq_mul
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ}
    (toLambda2 : Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) IpiSq)
    (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m))
    (relationLift : Fin m → MvPolynomial (Fin n) R)
    (generatorLift : Fin n → Λ)
    (hRelationLift : ∀ j,
      MvPolynomial.map (Ideal.Quotient.mk IpiSq) (relationLift j) = P.relation j)
    (hGeneratorLift : ∀ i,
      Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq) (generatorLift i) =
        toLambda2 (P.val i)) :
    ∀ j : Fin m, ∃ μ : Λ,
      MvPolynomial.aeval generatorLift (relationLift j) =
        algebraMap R Λ (π ^ 2) * μ := by
  intro j
  -- Each lifted defining relation reduces to an honest presentation relation, hence lies in the
  -- kernel after modding out by `π²`.
  apply lift_eval_eq_piSq_mul_of_mapped_mem_ker
    (R := R) (Λ := Λ) (Cbar := Cbar) (π := π) toLambda2 P generatorLift hGeneratorLift
  -- The mapped lift is exactly the `j`-th defining relation of the presentation.
  simpa [P.ker_eq_ker_aeval_val, RingHom.mem_ker, hRelationLift j]
    using P.relation_mem_ker j

/-- Helper for Lemma 16.6.1: the `σ`-tail relation of one frozen chart can be written as an
explicit linear combination of the leading relations, up to an error in `P.ker²`. This is the
first exact denominator-clearing normal form needed for the later global quotient construction.
-/
private theorem exists_sigmaTail_linearCombination_of_chartData
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ}
    (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m))
    {a : Cbar}
    (data : Presentation.SigmaTailChartData (R := R) (Cbar := Cbar) (π := π) P a) :
    ∀ j : Fin (m - data.c),
      ∃ coeff : Fin data.c → P.Ring,
        P.σ a * P.relation (tailRelationIndex data.hcₘ j) -
            ∑ i : Fin data.c, coeff i * P.relation (Fin.castLE data.hcₘ i) ∈
          P.ker ^ 2 := by
  intro j
  -- Split the tail witness into its leading-relation and `ker²` components.
  rcases Submodule.mem_sup.mp (data.tail_mem j) with ⟨y, hy, z, hz, hyz⟩
  obtain ⟨coeff, hcoeff⟩ :=
    Ideal.mem_span_range_iff_exists_fun.mp <| by
      simpa [Presentation.leadingRelationIdeal] using hy
  refine ⟨coeff, ?_⟩
  have hrewrite :
      P.σ a * P.relation (tailRelationIndex data.hcₘ j) -
          ∑ i : Fin data.c, coeff i * P.relation (Fin.castLE data.hcₘ i) = z := by
    rw [hyz, hcoeff]
    ring
  rw [hrewrite]
  exact hz

/-- Helper for Lemma 16.6.1: every element of `P.ker²` is an explicit finite quadratic
combination of the presentation relations. This is the missing bridge from the frozen
`σ`-tail congruence modulo `P.ker²` to a literal polynomial identity that can later be lifted
back to coefficients over `R`. -/
private theorem exists_relationQuadraticCombination_of_mem_kerSq
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ}
    (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m))
    {u : P.Ring} (hu : u ∈ P.ker ^ 2) :
    ∃ q : Fin m × Fin m → P.Ring,
      u = ∑ p : Fin m × Fin m, q p * (P.relation p.1 * P.relation p.2) := by
  let K : Ideal P.Ring :=
    Ideal.span (Set.range fun p : Fin m × Fin m ↦ P.relation p.1 * P.relation p.2)
  have hmul : P.ker ^ 2 ≤ K := by
    rw [← P.span_range_relation_eq_ker, pow_two]
    refine Ideal.mul_le.2 ?_
    intro x hx y hy
    obtain ⟨cx, hcx⟩ := Ideal.mem_span_range_iff_exists_fun.mp hx
    obtain ⟨cy, hcy⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy
    refine Ideal.mem_span_range_iff_exists_fun.mpr ⟨fun p ↦ cx p.1 * cy p.2, ?_⟩
    -- Expand both spanning witnesses and collect the product into one sum over pairs of indices.
    calc
      ∑ p : Fin m × Fin m, (cx p.1 * cy p.2) * (P.relation p.1 * P.relation p.2) =
          ∑ i : Fin m, ∑ j : Fin m,
            (cx i * cy j) * (P.relation i * P.relation j) := by
              simp [Fintype.sum_prod_type]
      _ = (∑ i : Fin m, cx i * P.relation i) * ∑ j : Fin m, cy j * P.relation j := by
            simp [Finset.mul_sum, Finset.sum_mul, mul_assoc, mul_left_comm, mul_comm]
      _ = x * y := by rw [hcx, hcy]
  obtain ⟨q, hq⟩ := Ideal.mem_span_range_iff_exists_fun.mp (hmul hu)
  -- Reorient the span witness so later rewrites can replace the `P.ker²` remainder directly.
  exact ⟨q, hq.symm⟩

/-- Helper for Lemma 16.6.1: the equality `Ann_Λ(π) = Ann_Λ(π²)` upgrades any `π²`-torsion
element of `Λ` to a `π`-torsion element. This is the exact torsion step used when checking that
the eventual map `D → Λ` kills the chart relations. -/
private theorem pi_mul_eq_zero_of_piSq_mul_eq_zero
    (hAnnΛ : AnnΛ[algebraMap R Λ π] = AnnΛ[algebraMap R Λ (π ^ 2)])
    {x : Λ}
    (hx : algebraMap R Λ (π ^ 2) * x = 0) :
    algebraMap R Λ π * x = 0 := by
  let p : Λ := algebraMap R Λ π
  have hAnn : AnnΛ[p] = AnnΛ[p ^ 2] := by
    simpa [p, map_pow] using hAnnΛ
  have hxmem : x ∈ AnnΛ[p ^ 2] := by
    rw [Ideal.mem_torsionOf_iff]
    calc
      x * p ^ 2 = p ^ 2 * x := by rw [mul_comm]
      _ = 0 := by simpa [p, map_pow] using hx
  have hxmem' : x ∈ AnnΛ[p] := by
    simpa [hAnn] using hxmem
  rw [Ideal.mem_torsionOf_iff] at hxmem'
  calc
    algebraMap R Λ π * x = p * x := by rfl
    _ = x * p := by rw [mul_comm]
    _ = 0 := by simpa [p] using hxmem'

/-- Helper for Lemma 16.6.1: flat base change transports the equality
`Ann_R(π) = Ann_R(π²)` to any flat `R`-algebra. This isolates the torsion comparison needed in the
final localization step, where the source proof uses flatness of the chosen chart ring over `R`. -/
private theorem torsionOf_pi_eq_torsionOf_piSq_of_flat_algebra
    {S : Type y} [CommRing S] [Algebra R S] [Module.Flat R S]
    (hAnnR : AnnR[π] = AnnR[π ^ 2]) :
    Ideal.torsionOf S S (algebraMap R S π) =
      Ideal.torsionOf S S (algebraMap R S (π ^ 2)) := by
  let e := TensorProduct.AlgebraTensorModule.rid R S S
  have htransport :
      ∀ r : R,
        Ideal.torsionOf S (TensorProduct R S R) ((1 : S) ⊗ₜ[R] r) =
          Ideal.torsionOf S S (algebraMap R S r) := by
    intro r
    ext x
    rw [Ideal.mem_torsionOf_iff, Ideal.mem_torsionOf_iff]
    constructor
    · intro hx
      -- Compare the tensor torsion equation with the scalar one through the right-unit isomorphism.
      have hx' := congrArg e hx
      simpa [e, TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def, mul_comm,
        mul_left_comm, mul_assoc] using hx'
    · intro hx
      -- The same comparison map transports scalar torsion back to the tensor-product model.
      apply e.injective
      simpa [e, TensorProduct.AlgebraTensorModule.rid_tmul, Algebra.smul_def, mul_comm,
        mul_left_comm, mul_assoc] using hx
  calc
    Ideal.torsionOf S S (algebraMap R S π) =
        Ideal.map (algebraMap R S) (AnnR[π]) := by
          symm
          calc
            Ideal.map (algebraMap R S) (AnnR[π]) =
                Ideal.torsionOf S (TensorProduct R S R) ((1 : S) ⊗ₜ[R] π) := by
                  simpa using
                    (Ideal.map_torsionOf_eq_torsionOf_baseChange_of_flat
                      (R := R) (S := S) (M := R) π)
            _ = Ideal.torsionOf S S (algebraMap R S π) := htransport π
    _ = Ideal.map (algebraMap R S) (AnnR[π ^ 2]) := by rw [hAnnR]
    _ = Ideal.torsionOf S S (algebraMap R S (π ^ 2)) := by
          calc
            Ideal.map (algebraMap R S) (AnnR[π ^ 2]) =
                Ideal.torsionOf S (TensorProduct R S R) ((1 : S) ⊗ₜ[R] (π ^ 2)) := by
                  simpa using
                    (Ideal.map_torsionOf_eq_torsionOf_baseChange_of_flat
                      (R := R) (S := S) (M := R) (π ^ 2))
            _ = Ideal.torsionOf S S (algebraMap R S (π ^ 2)) := htransport (π ^ 2)

/-- Helper for Lemma 16.6.1: the descended comparison map `C̄ / π C̄ → D / πD` extends the
original map `fbar : C̄ → D / πD`. This isolates the quotient-lift transport so later proofs can
rewrite through one named lemma instead of reopening the definition of `descendToPiQuotient`. -/
private theorem descendToPiQuotient_comp_mk
    [Algebra (R ⧸ IpiSq) Cbar]
    {D : Type y} [CommRing D] [Algebra R D]
    (fbar : Cbar →ₐ[R ⧸ IpiSq] D ⧸ Ideal.map (algebraMap R D) Ipi) :
    (descendToPiQuotient (R := R) (Cbar := Cbar) (π := π) fbar).comp
        (Ideal.Quotient.mkₐ (R ⧸ IpiSq) (Ideal.map (algebraMap (R ⧸ IpiSq) Cbar) IpiBar)) =
      fbar := by
  -- The descended map was defined by `Ideal.Quotient.liftₐ`, so composing with the quotient map
  -- returns the original comparison map.
  simpa [descendToPiQuotient] using
    (Ideal.Quotient.liftₐ_comp
      (R₁ := R ⧸ IpiSq)
      (Ideal.map (algebraMap (R ⧸ IpiSq) Cbar) IpiBar)
      fbar
      (fun _ ha ↦ RingHom.mem_ker.mp
        (map_CbarPi_ideal_le_ker (R := R) (Cbar := Cbar) (π := π) fbar ha)))

/-- Helper for Lemma 16.6.1: if a polynomial over `R` becomes zero after reducing its coefficients
modulo `π²`, then it is divisible by `C (π²)`. This is the normalization step that lifts a
quotient-level identity in `P.Ring` back to an explicit equality over `R`. -/
private theorem exists_piSq_polynomial_factor_of_map_zero
    {n : ℕ} {p : MvPolynomial (Fin n) R}
    (hp : MvPolynomial.map (Ideal.Quotient.mk IpiSq) p = 0) :
    ∃ g : MvPolynomial (Fin n) R, p = MvPolynomial.C (π ^ 2) * g := by
  have hdiv : MvPolynomial.C (π ^ 2) ∣ p := by
    -- Reduce divisibility by `C (π²)` to coefficientwise vanishing modulo the quotient map.
    exact
      (MvPolynomial.C_dvd_iff_map_hom_eq_zero
        (q := Ideal.Quotient.mk IpiSq)
        (r := π ^ 2)
        (hr := fun r ↦ by
          rw [Ideal.Quotient.eq_zero_iff_mem]
          simpa [Ideal.mem_span_singleton])
        (φ := p)).2 hp
  rcases hdiv with ⟨g, hg⟩
  exact ⟨g, hg⟩

/-- Helper for Lemma 16.6.1: a chartwise quadratic relation in `P.Ring` can be lifted to an
explicit polynomial identity over `R`, with the lift ambiguity absorbed into one final
`C (π²)`-multiple. This is the precise normalization step needed before adjoining the variables
`z_j` in the global quotient construction. -/
private theorem exists_chartTailLiftedEquation_of_quadraticLinearization
    [Algebra (R ⧸ IpiSq) Cbar]
    {n m : ℕ}
    (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m))
    (relationLift : Fin m → MvPolynomial (Fin n) R)
    (hRelationLift : ∀ j,
      MvPolynomial.map (Ideal.Quotient.mk IpiSq) (relationLift j) = P.relation j)
    {a : Cbar}
    (data : Presentation.SigmaTailChartData (R := R) (Cbar := Cbar) (π := π) P a)
    {j : Fin (m - data.c)}
    {coeff : Fin data.c → P.Ring}
    {q : Fin m × Fin m → P.Ring}
    (hquad :
      P.σ a * P.relation (tailRelationIndex data.hcₘ j) =
        ∑ i : Fin data.c, coeff i * P.relation (Fin.castLE data.hcₘ i) +
          ∑ p : Fin m × Fin m, q p * (P.relation p.1 * P.relation p.2)) :
    ∃ sigmaLift : MvPolynomial (Fin n) R,
      ∃ coeffLift : Fin data.c → MvPolynomial (Fin n) R,
      ∃ qLift : Fin m × Fin m → MvPolynomial (Fin n) R,
      ∃ g : MvPolynomial (Fin n) R,
        MvPolynomial.map (Ideal.Quotient.mk IpiSq) sigmaLift = P.σ a ∧
        (∀ i, MvPolynomial.map (Ideal.Quotient.mk IpiSq) (coeffLift i) = coeff i) ∧
        (∀ p, MvPolynomial.map (Ideal.Quotient.mk IpiSq) (qLift p) = q p) ∧
        sigmaLift * relationLift (tailRelationIndex data.hcₘ j) =
          ∑ i : Fin data.c, coeffLift i * relationLift (Fin.castLE data.hcₘ i) +
            ∑ p : Fin m × Fin m, qLift p * (relationLift p.1 * relationLift p.2) +
            MvPolynomial.C (π ^ 2) * g := by
  have hmk_surj : Function.Surjective (Ideal.Quotient.mk IpiSq : R →+* (R ⧸ IpiSq)) := by
    intro x
    refine Quotient.inductionOn' x ?_
    intro r
    exact ⟨r, rfl⟩
  have hmap_surj :
      Function.Surjective
        (MvPolynomial.map (Ideal.Quotient.mk IpiSq : R →+* (R ⧸ IpiSq))) := by
    -- Surjectivity of the coefficient quotient map lifts to the whole polynomial algebra.
    simpa using MvPolynomial.map_surjective (Ideal.Quotient.mk IpiSq : R →+* (R ⧸ IpiSq)) hmk_surj
  obtain ⟨sigmaLift, hSigmaLift⟩ := hmap_surj (P.σ a)
  let coeffLift : Fin data.c → MvPolynomial (Fin n) R :=
    fun i ↦ Classical.choose (hmap_surj (coeff i))
  have hCoeffLift :
      ∀ i, MvPolynomial.map (Ideal.Quotient.mk IpiSq) (coeffLift i) = coeff i := by
    intro i
    exact Classical.choose_spec (hmap_surj (coeff i))
  let qLift : Fin m × Fin m → MvPolynomial (Fin n) R :=
    fun p ↦ Classical.choose (hmap_surj (q p))
  have hQLift :
      ∀ p, MvPolynomial.map (Ideal.Quotient.mk IpiSq) (qLift p) = q p := by
    intro p
    exact Classical.choose_spec (hmap_surj (q p))
  let δ : MvPolynomial (Fin n) R :=
    sigmaLift * relationLift (tailRelationIndex data.hcₘ j) -
      ∑ i : Fin data.c, coeffLift i * relationLift (Fin.castLE data.hcₘ i) -
      ∑ p : Fin m × Fin m, qLift p * (relationLift p.1 * relationLift p.2)
  have hδ : MvPolynomial.map (Ideal.Quotient.mk IpiSq) δ = 0 := by
    -- Reducing the lifted relation modulo `π²` recovers the original chartwise quadratic identity.
    calc
      MvPolynomial.map (Ideal.Quotient.mk IpiSq) δ =
          P.σ a * P.relation (tailRelationIndex data.hcₘ j) -
            ∑ i : Fin data.c, coeff i * P.relation (Fin.castLE data.hcₘ i) -
            ∑ p : Fin m × Fin m, q p * (P.relation p.1 * P.relation p.2) := by
              simp [δ, hSigmaLift, hCoeffLift, hQLift, hRelationLift]
      _ = 0 := by
        rw [hquad]
        ring
  obtain ⟨g, hg⟩ :=
    exists_piSq_polynomial_factor_of_map_zero (R := R) (π := π) (p := δ) hδ
  refine ⟨sigmaLift, coeffLift, qLift, g, hSigmaLift, hCoeffLift, hQLift, ?_⟩
  -- Solve for the lifted chart equation, leaving only the canonical `C (π²)` correction term.
  calc
    sigmaLift * relationLift (tailRelationIndex data.hcₘ j) =
        δ + ∑ i : Fin data.c, coeffLift i * relationLift (Fin.castLE data.hcₘ i) +
          ∑ p : Fin m × Fin m, qLift p * (relationLift p.1 * relationLift p.2) := by
            simp [δ]
            ring
    _ = MvPolynomial.C (π ^ 2) * g +
          ∑ i : Fin data.c, coeffLift i * relationLift (Fin.castLE data.hcₘ i) +
          ∑ p : Fin m × Fin m, qLift p * (relationLift p.1 * relationLift p.2) := by
            rw [hg]
    _ = ∑ i : Fin data.c, coeffLift i * relationLift (Fin.castLE data.hcₘ i) +
          ∑ p : Fin m × Fin m, qLift p * (relationLift p.1 * relationLift p.2) +
          MvPolynomial.C (π ^ 2) * g := by
            ring

/-- Helper for Lemma 16.6.1: the enlarged `x,z` polynomial ring used in the final descent
construction. The `x`-variables come from the frozen presentation of `C̄`, and the `z`-variables
record the divided presentation relations. -/
private abbrev chartDescentRing (n m : ℕ) : Type u :=
  MvPolynomial (Fin n ⊕ Fin m) R

/-- Helper for Lemma 16.6.1: the basic relation generator identifying one lifted defining relation
with `π` times the corresponding `z`-variable inside the enlarged `x,z` polynomial ring. -/
private def relationZGenerator
    {n m : ℕ}
    (relationLift : Fin m → MvPolynomial (Fin n) R) (j : Fin m) :
    chartDescentRing (R := R) n m :=
  MvPolynomial.rename Sum.inl (relationLift j) -
    MvPolynomial.C π * MvPolynomial.X (Sum.inr j)

/-- Helper for Lemma 16.6.1: the lifted chart-tail polynomial in the enlarged `x,z` presentation.
Multiplying this polynomial by `π` will be shown to land in the ideal generated by the basic
relations `relationZGenerator`. -/
private def chartTailPolynomial
    {n m c : ℕ}
    (hcₘ : c ≤ m)
    (relationLift : Fin m → MvPolynomial (Fin n) R)
    (sigmaLift : MvPolynomial (Fin n) R)
    (coeffLift : Fin c → MvPolynomial (Fin n) R)
    (qLift : Fin m × Fin m → MvPolynomial (Fin n) R)
    (g : MvPolynomial (Fin n) R)
    (j : Fin (m - c)) :
    chartDescentRing (R := R) n m :=
  MvPolynomial.rename Sum.inl sigmaLift * MvPolynomial.X (Sum.inr (tailRelationIndex hcₘ j)) -
    ∑ i : Fin c,
      MvPolynomial.rename Sum.inl (coeffLift i) *
        MvPolynomial.X (Sum.inr (Fin.castLE hcₘ i)) -
    MvPolynomial.C π *
      ∑ p : Fin m × Fin m,
        MvPolynomial.rename Sum.inl (qLift p) *
          (MvPolynomial.X (Sum.inr p.1) * MvPolynomial.X (Sum.inr p.2)) -
    MvPolynomial.C π * MvPolynomial.rename Sum.inl g

/-- Helper for Lemma 16.6.1: a lifted chart equation over `R` becomes a relation in the enlarged
`x,z`-ring after multiplying by `π`. This is the exact bridge needed later both to kill the chart
ideal after inverting `π` and to kill the extra chart equations in the local comparison. -/
private theorem chartTailPolynomial_pi_mul_mem_relationZIdeal
    {n m c : ℕ}
    (hcₘ : c ≤ m)
    (relationLift : Fin m → MvPolynomial (Fin n) R)
    (sigmaLift : MvPolynomial (Fin n) R)
    (coeffLift : Fin c → MvPolynomial (Fin n) R)
    (qLift : Fin m × Fin m → MvPolynomial (Fin n) R)
    (g : MvPolynomial (Fin n) R)
    {j : Fin (m - c)}
    (hEq :
      sigmaLift * relationLift (tailRelationIndex hcₘ j) =
        ∑ i : Fin c, coeffLift i * relationLift (Fin.castLE hcₘ i) +
          ∑ p : Fin m × Fin m, qLift p * (relationLift p.1 * relationLift p.2) +
          MvPolynomial.C (π ^ 2) * g) :
    MvPolynomial.C π *
        chartTailPolynomial (R := R) (π := π) hcₘ relationLift sigmaLift coeffLift qLift g j ∈
      Ideal.span (Set.range (relationZGenerator (R := R) (π := π) relationLift)) := by
  let J : Ideal (chartDescentRing (R := R) n m) :=
    Ideal.span (Set.range (relationZGenerator (R := R) (π := π) relationLift))
  have hgen :
      ∀ k : Fin m,
        relationZGenerator (R := R) (π := π) relationLift k ∈ J := by
    intro k
    exact Ideal.subset_span ⟨k, rfl⟩
  have hEqRenamed :
      MvPolynomial.rename Sum.inl sigmaLift *
          MvPolynomial.rename Sum.inl (relationLift (tailRelationIndex hcₘ j)) =
        ∑ i : Fin c,
          MvPolynomial.rename Sum.inl (coeffLift i) *
            MvPolynomial.rename Sum.inl (relationLift (Fin.castLE hcₘ i)) +
          ∑ p : Fin m × Fin m,
            MvPolynomial.rename Sum.inl (qLift p) *
              (MvPolynomial.rename Sum.inl (relationLift p.1) *
                MvPolynomial.rename Sum.inl (relationLift p.2)) +
          MvPolynomial.C (π ^ 2) * MvPolynomial.rename Sum.inl g := by
    -- Move the lifted chart equation into the fixed `x,z` spelling world.
    simpa [MvPolynomial.rename_add, MvPolynomial.rename_mul] using
      congrArg (MvPolynomial.rename Sum.inl) hEq
  have hrewrite :
      MvPolynomial.C π *
          chartTailPolynomial (R := R) (π := π) hcₘ relationLift sigmaLift coeffLift qLift g j =
        -(MvPolynomial.rename Sum.inl sigmaLift) *
            relationZGenerator (R := R) (π := π) relationLift (tailRelationIndex hcₘ j) +
          ∑ i : Fin c,
            MvPolynomial.rename Sum.inl (coeffLift i) *
              relationZGenerator (R := R) (π := π) relationLift (Fin.castLE hcₘ i) +
          ∑ p : Fin m × Fin m,
            (MvPolynomial.rename Sum.inl (qLift p) *
                MvPolynomial.rename Sum.inl (relationLift p.1)) *
              relationZGenerator (R := R) (π := π) relationLift p.2 +
          ∑ p : Fin m × Fin m,
            (MvPolynomial.rename Sum.inl (qLift p) *
                (MvPolynomial.C π * MvPolynomial.X (Sum.inr p.2))) *
              relationZGenerator (R := R) (π := π) relationLift p.1 := by
    -- Rewrite each renamed relation as `π * z + relationZGenerator`, then expand once.
    rw [chartTailPolynomial, hEqRenamed]
    simp only [pow_two]
    simp [relationZGenerator]
    ring
  -- Every summand on the right is a generator multiple, so the whole expression lies in `J`.
  rw [hrewrite]
  refine Ideal.add_mem ?_ <| Ideal.add_mem ?_ <| Ideal.add_mem ?_ ?_
  · exact Ideal.neg_mem _ <|
      Ideal.mul_mem_left _ _ <|
        hgen (tailRelationIndex hcₘ j)
  · refine Ideal.sum_mem ?_
    intro i _
    exact Ideal.mul_mem_left _ _ <| hgen (Fin.castLE hcₘ i)
  · refine Ideal.sum_mem ?_
    intro p _
    exact Ideal.mul_mem_left _ _ <| hgen p.2
  · refine Ideal.sum_mem ?_
    intro p _
    exact Ideal.mul_mem_left _ _ <| hgen p.1

/-- Helper for Lemma 16.6.1: after freezing one presentation of `C̄`, choosing explicit lifts of
its relations and generators, and refining the smooth locus to a fixed-presentation chart cover,
the remaining blocker is the explicit global Elkik descent construction of `D` together with the
chartwise smoothness transfer. This packages that single structural step so the main theorem
reduces to verified setup lemmas plus one source-faithful descent lemma. -/
private theorem existsGlobalFinitePresentationDescentOfFixedPresentationData
    [IsNoetherianRing R]
    [Algebra (R ⧸ IpiSq) Cbar] [FinitePresentation (R ⧸ IpiSq) Cbar]
    {n m : ℕ}
    (toLambda2 : Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) IpiSq)
    (P : Algebra.Presentation (R ⧸ IpiSq) Cbar (Fin n) (Fin m))
    (relationLift : Fin m → MvPolynomial (Fin n) R)
    (generatorLift : Fin n → Λ)
    (hRelationLift : ∀ j,
      MvPolynomial.map (Ideal.Quotient.mk IpiSq) (relationLift j) = P.relation j)
    (hGeneratorLift : ∀ i,
      Ideal.Quotient.mk (Ideal.map (algebraMap R Λ) IpiSq) (generatorLift i) =
        toLambda2 (P.val i))
    (t : Finset Cbar)
    (htElementary : ∀ a ∈ t, P.IsElementaryStandardElement a)
    (htCover : ∀ q : PrimeSpectrum Cbar, SmoothAtPrime (R ⧸ IpiSq) Cbar q →
      ∃ a ∈ t, a ∉ q.asIdeal)
    (hRelationLiftError : ∀ j : Fin m, ∃ μ : Λ,
      MvPolynomial.aeval generatorLift (relationLift j) =
        algebraMap R Λ (π ^ 2) * μ)
    (hAnnR : AnnR[π] = AnnR[π ^ 2])
    (hAnnΛ : AnnΛ[algebraMap R Λ π] = AnnΛ[algebraMap R Λ (π ^ 2)]) :
    ∃ (D : Type (max u v w)) (_ : CommRing D) (_ : Algebra R D) (_ : FinitePresentation R D)
      (lift : D →ₐ[R] Λ),
        let Dpi : Ideal D := Ideal.map (algebraMap R D) Ipi
      ∃ (fbar : Cbar →ₐ[R ⧸ IpiSq] D ⧸ Dpi),
        (piQuotientMap π lift).comp fbar = factorToPiQuotient π toLambda2 ∧
        Smooth (Localization.Away π) (Localization.Away (algebraMap R D π)) ∧
        (∀ q : PrimeSpectrum (D ⧸ Dpi),
          SmoothAtPrime (R ⧸ IpiSq) Cbar (comap fbar.toRingHom q) →
            SmoothAtPrime R D (comap (Ideal.Quotient.mk Dpi) q)) ∧
        (∀ q : PrimeSpectrum (D ⧸ Dpi),
          SmoothAtPrime (R ⧸ IpiSq) Cbar (comap fbar.toRingHom q) →
            (descendToPiQuotient π fbar).SmoothAtPrime q) := by
  obtain ⟨chartData⟩ :=
    exists_sigmaTailChartData_family_on_cover
      (R := R) (Cbar := Cbar) (π := π) P t htElementary
  -- Route correction: the cover has now been frozen down to explicit `σ`-tail chart data.
  -- The remaining source-faithful blocker is no longer chart selection, but the denominator
  -- clearing that turns each `chartData a` into literal linear tail equations over `R`, followed
  -- by the global `x,z` quotient construction and its localized comparison with the chart
  -- quotients.
  -- TODO: the `P.ker²` remainder has now been rewritten as an explicit quadratic combination of
  -- presentation relations. The remaining step is to lift the chart coefficients from
  -- `P.Ring = MvPolynomial (Fin n) (R / π²R)` back to polynomials over `R`, absorb the quadratic
  -- relation terms into the adjoined `z`-variables, build the explicit global quotient `D`,
  -- define `lift : D →ₐ[R] Λ` using `hRelationLiftError` and
  -- `pi_mul_eq_zero_of_piSq_mul_eq_zero`, and then prove the localized comparison with the chosen
  -- chart quotient via
  -- `torsionOf_pi_eq_torsionOf_piSq_of_flat_algebra` and `descendToPiQuotient_comp_mk`.
  let _ := chartData
  let _ := hRelationLift
  let _ := hGeneratorLift
  let _ := htCover
  let _ := hRelationLiftError
  let _ := hAnnR
  let _ := hAnnΛ
  have hChartLinearization :
      ∀ a : { a // a ∈ t }, ∀ j : Fin (m - (chartData a).c),
        ∃ coeff : Fin (chartData a).c → P.Ring,
          P.σ a.1 * P.relation (tailRelationIndex (chartData a).hcₘ j) -
              ∑ i : Fin (chartData a).c,
                coeff i * P.relation (Fin.castLE (chartData a).hcₘ i) ∈
            P.ker ^ 2 := by
    intro a j
    -- The chartwise `σ`-tail clause has now been reduced to a literal linear combination modulo
    -- `P.ker²`; the remaining blocker is lifting these coefficients back to `R` and comparing the
    -- resulting quotient with the global Elkik algebra.
    exact exists_sigmaTail_linearCombination_of_chartData
      (R := R) (Cbar := Cbar) (π := π) P (chartData a) j
  let _ := hChartLinearization
  have hChartQuadraticLinearization :
      ∀ a : { a // a ∈ t }, ∀ j : Fin (m - (chartData a).c),
        ∃ coeff : Fin (chartData a).c → P.Ring,
          ∃ q : Fin m × Fin m → P.Ring,
            P.σ a.1 * P.relation (tailRelationIndex (chartData a).hcₘ j) =
              ∑ i : Fin (chartData a).c,
                coeff i * P.relation (Fin.castLE (chartData a).hcₘ i) +
              ∑ p : Fin m × Fin m, q p * (P.relation p.1 * P.relation p.2) := by
    intro a j
    obtain ⟨coeff, hcoeff⟩ := hChartLinearization a j
    obtain ⟨q, hq⟩ :=
      exists_relationQuadraticCombination_of_mem_kerSq
        (R := R) (Cbar := Cbar) (π := π) P hcoeff
    refine ⟨coeff, q, ?_⟩
    -- Rewrite the `P.ker²` remainder as an explicit quadratic relation sum.
    calc
      P.σ a.1 * P.relation (tailRelationIndex (chartData a).hcₘ j) =
          (P.σ a.1 * P.relation (tailRelationIndex (chartData a).hcₘ j) -
              ∑ i : Fin (chartData a).c,
                coeff i * P.relation (Fin.castLE (chartData a).hcₘ i)) +
            ∑ i : Fin (chartData a).c,
              coeff i * P.relation (Fin.castLE (chartData a).hcₘ i) := by
                ring
      _ =
          (∑ p : Fin m × Fin m, q p * (P.relation p.1 * P.relation p.2)) +
            ∑ i : Fin (chartData a).c,
              coeff i * P.relation (Fin.castLE (chartData a).hcₘ i) := by
                rw [hq]
      _ =
          ∑ i : Fin (chartData a).c,
            coeff i * P.relation (Fin.castLE (chartData a).hcₘ i) +
          ∑ p : Fin m × Fin m, q p * (P.relation p.1 * P.relation p.2) := by
            ring
  let _ := hChartQuadraticLinearization
  have hChartLiftedEquation :
      ∀ a : { a // a ∈ t }, ∀ j : Fin (m - (chartData a).c),
        ∃ sigmaLift : MvPolynomial (Fin n) R,
          ∃ coeffLift : Fin (chartData a).c → MvPolynomial (Fin n) R,
          ∃ qLift : Fin m × Fin m → MvPolynomial (Fin n) R,
          ∃ g : MvPolynomial (Fin n) R,
            sigmaLift * relationLift (tailRelationIndex (chartData a).hcₘ j) =
              ∑ i : Fin (chartData a).c,
                coeffLift i * relationLift (Fin.castLE (chartData a).hcₘ i) +
              ∑ p : Fin m × Fin m, qLift p * (relationLift p.1 * relationLift p.2) +
              MvPolynomial.C (π ^ 2) * g := by
    intro a j
    obtain ⟨coeff, q, hq⟩ := hChartQuadraticLinearization a j
    -- The quotient-level chart identity now has an explicit lift to `R`, with the lift ambiguity
    -- isolated in one final `C (π²)` correction term.
    obtain ⟨sigmaLift, coeffLift, qLift, g, -, -, -, hEq⟩ :=
      exists_chartTailLiftedEquation_of_quadraticLinearization
      (R := R) (Cbar := Cbar) (π := π) P relationLift hRelationLift (chartData a) hq
    exact ⟨sigmaLift, coeffLift, qLift, g, hEq⟩
  let _ := hChartLiftedEquation
  have hChartRelationBridge :
      ∀ a : { a // a ∈ t }, ∀ j : Fin (m - (chartData a).c),
        ∃ sigmaLift : MvPolynomial (Fin n) R,
          ∃ coeffLift : Fin (chartData a).c → MvPolynomial (Fin n) R,
          ∃ qLift : Fin m × Fin m → MvPolynomial (Fin n) R,
          ∃ g : MvPolynomial (Fin n) R,
            MvPolynomial.C π *
                chartTailPolynomial (R := R) (π := π) (chartData a).hcₘ relationLift
                  sigmaLift coeffLift qLift g j ∈
              Ideal.span
                (Set.range (relationZGenerator (R := R) (π := π) relationLift)) := by
    intro a j
    obtain ⟨sigmaLift, coeffLift, qLift, g, hEq⟩ := hChartLiftedEquation a j
    -- Package each lifted chart equation in the exact `π * p ∈ Jrel` form needed later.
    refine ⟨sigmaLift, coeffLift, qLift, g, ?_⟩
    exact chartTailPolynomial_pi_mul_mem_relationZIdeal
      (R := R) (π := π) (chartData a).hcₘ relationLift sigmaLift coeffLift qLift g hEq
  let _ := hChartRelationBridge
  -- TODO: define the global quotient by the relation ideal generated by `relationZGenerator` and
  -- the chart ideal generated by the chosen `chartTailPolynomial`s, then use
  -- `hChartRelationBridge` both to kill the chart ideal after inverting `π` and to kill the extra
  -- chart generators in the chosen chart local ring.
  sorry

-- Proof sketch: formalize the Stacks construction of `D` by adjoining variables that divide the
-- chosen generators of the presentation relations by `π`, use the annihilator equalities to define
-- the map `D → Λ`, and verify the two primewise smoothness statements by the Jacobian-minor
-- argument on the smooth locus of `R / π²R → C̄`.
/-- Lemma 16.6.1: let `R` be Noetherian, let `Λ` be an `R`-algebra, let `π ∈ R`, and assume
`Ann_R(π) = Ann_R(π²)` and `Ann_Λ(π) = Ann_Λ(π²)`. For a finitely presented
`(R / π²R)`-algebra `C̄` equipped with an `(R / π²R)`-algebra map `C̄ → Λ / π²Λ`, there exists a
finitely presented `R`-algebra `D` with a lift `D → Λ` and a comparison
`(R / π²R)`-algebra map `C̄ → D / π D` such that the induced reduction to `Λ / πΛ` is compatible,
the localized map `R_π → D_π` is smooth, every prime of `D / πD` lying over the smooth locus of
`R / π²R → C̄` is smooth over `R`, and the canonical reduction map `C̄ / π C̄ → D / π D`
induced by `fbar` is smooth at primes over that same locus. -/
theorem exists_finitePresentation_lift_with_smooth_mod_pi
    [IsNoetherianRing R]
    [Algebra (R ⧸ IpiSq) Cbar] [FinitePresentation (R ⧸ IpiSq) Cbar]
    (toLambda2 : Cbar →ₐ[R ⧸ IpiSq] Λ ⧸ Ideal.map (algebraMap R Λ) IpiSq)
    (hAnnR : AnnR[π] = AnnR[π ^ 2])
    (hAnnΛ : AnnΛ[algebraMap R Λ π] = AnnΛ[algebraMap R Λ (π ^ 2)]) :
    ∃ (D : Type (max u v w)) (_ : CommRing D) (_ : Algebra R D) (_ : FinitePresentation R D)
      (lift : D →ₐ[R] Λ),
        let Dpi : Ideal D := Ideal.map (algebraMap R D) Ipi
      ∃ (fbar : Cbar →ₐ[R ⧸ IpiSq] D ⧸ Dpi),
        (piQuotientMap π lift).comp fbar = factorToPiQuotient π toLambda2 ∧
        Smooth (Localization.Away π) (Localization.Away (algebraMap R D π)) ∧
        (∀ q : PrimeSpectrum (D ⧸ Dpi),
          SmoothAtPrime (R ⧸ IpiSq) Cbar (comap fbar.toRingHom q) →
            SmoothAtPrime R D (comap (Ideal.Quotient.mk Dpi) q)) ∧
        (∀ q : PrimeSpectrum (D ⧸ Dpi),
          SmoothAtPrime (R ⧸ IpiSq) Cbar (comap fbar.toRingHom q) →
            (descendToPiQuotient π fbar).SmoothAtPrime q) := by
  -- Route correction: the earlier abstract-cover route drifted away from the source proof's fixed
  -- presentation. We first freeze one presentation and the chosen lifts before refining the cover.
  obtain ⟨n, m, P, relationLift, generatorLift, hRelationLift, hGeneratorLift⟩ :=
    choose_common_presentation_with_relation_and_generator_lifts
      (R := R) (Λ := Λ) (Cbar := Cbar) (π := π) toLambda2
  -- The source proof next refines the smooth cover so that every chart is expressed in the frozen
  -- presentation `P`; this is the precise input needed for the global Elkik algebra.
  obtain ⟨t, htElementary, htCover⟩ :=
    exists_finite_fixed_presentation_chart_cover_of_smooth_locus
      (R := R) (Cbar := Cbar) (π := π) P
  have hRelationLiftError :
      ∀ j : Fin m, ∃ μ : Λ,
        MvPolynomial.aeval generatorLift (relationLift j) =
          algebraMap R Λ (π ^ 2) * μ :=
    relationLift_eval_eq_piSq_mul
      (R := R) (Λ := Λ) (Cbar := Cbar) (π := π) toLambda2 P relationLift generatorLift
      hRelationLift hGeneratorLift
  -- All setup data are now explicit; the only missing step is the global Elkik descent from this
  -- frozen chart family.
  exact existsGlobalFinitePresentationDescentOfFixedPresentationData
    (R := R) (Λ := Λ) (Cbar := Cbar) (π := π)
    toLambda2 P relationLift generatorLift hRelationLift hGeneratorLift
    t htElementary htCover hRelationLiftError hAnnR hAnnΛ

end

