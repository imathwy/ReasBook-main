import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u v

namespace Algebra

open MvPolynomial

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]

section

variable {n : ℕ}

/-- Helper for Lemma 16.3.6: the linear relation forcing the variable `X i` to take the value
`β i`. -/
noncomputable abbrev linearRelation (β : Fin n → A) (i : Fin n) : MvPolynomial (Fin n) A :=
  X i - C (β i)

/-- Helper for Lemma 16.3.6: the ideal generated by the linear relations
`X i - C (β i)`. -/
noncomputable abbrev linearRelationIdeal (β : Fin n → A) : Ideal (MvPolynomial (Fin n) A) :=
  Ideal.span (Set.range (linearRelation β))

/-- Helper for Lemma 16.3.6: constants give a right inverse to evaluation at `β`. -/
lemma linear_aeval_C_rightInverse (β : Fin n → A) :
    Function.RightInverse (C : A → MvPolynomial (Fin n) A) (aeval β) := by
  intro a
  simp

/-- Helper for Lemma 16.3.6: every polynomial differs from its value at `β` by a combination of
the linear relations `X i - C (β i)`. -/
lemma sub_C_aeval_mem_linear_span (β : Fin n → A) (f : MvPolynomial (Fin n) A) :
    f - C (aeval β f) ∈ linearRelationIdeal β := by
  -- Induct on the polynomial so that the generators `X i - C (β i)` control each monomial step.
  induction f using MvPolynomial.induction_on with
  | C a =>
      simp [linearRelationIdeal]
  | add p q hp hq =>
    -- Addition preserves the linear span because the correction term is additive.
    simpa [linearRelationIdeal, map_add, sub_eq_add_neg, add_assoc, add_left_comm, add_comm]
      using Ideal.add_mem (linearRelationIdeal β) hp hq
  | mul_X p i hp =>
    -- Multiplying by a variable introduces exactly one new generator `X i - C (β i)`.
    have hgen : linearRelation β i ∈ linearRelationIdeal β := by
      exact Ideal.subset_span ⟨i, rfl⟩
    have hleft : p * linearRelation β i ∈ linearRelationIdeal β := by
      exact Ideal.mul_mem_left _ _ hgen
    have hright : (p - C (aeval β p)) * C (β i) ∈ linearRelationIdeal β := by
      exact Ideal.mul_mem_right _ _ hp
    have hrewrite :
        p * X i - C (aeval β (p * X i)) =
          p * linearRelation β i + (p - C (aeval β p)) * C (β i) := by
      calc
        p * X i - C (aeval β (p * X i))
            = p * X i - C (aeval β p) * C (β i) := by
                simp [map_mul, C_mul']
        _ = p * linearRelation β i + (p - C (aeval β p)) * C (β i) := by
              simp [linearRelation]
              ring
    rw [hrewrite]
    exact Ideal.add_mem _ hleft hright

/-- Helper for Lemma 16.3.6: the linear relations `X i - C (β i)` generate the kernel of the
evaluation map at `β`. -/
lemma linear_relations_span_ker_aeval (β : Fin n → A) :
    linearRelationIdeal β = RingHom.ker (aeval β) := by
  apply le_antisymm
  · -- Each generator evaluates to zero at `β`, so the whole span lies in the kernel.
    rw [Ideal.span_le]
    intro f hf
    rcases hf with ⟨i, rfl⟩
    change aeval β (linearRelation β i) = 0
    simp [linearRelation]
  · -- A polynomial in the kernel equals its correction term from `sub_C_aeval_mem_linear_span`.
    intro f hf
    rw [RingHom.mem_ker] at hf
    simpa [linearRelationIdeal, hf] using sub_C_aeval_mem_linear_span β f

/-- Helper for Lemma 16.3.6: the naive linear presentation has identity Jacobian. -/
lemma linear_naive_jacobian_isUnit (β : Fin n → A)
    (s : MvPolynomial (Fin n) A ⧸ linearRelationIdeal β → MvPolynomial (Fin n) A)
    (hs : ∀ x, Ideal.Quotient.mk (linearRelationIdeal β) (s x) = x) :
    IsUnit
      ((PreSubmersivePresentation.naive
          (R := A) (σ := Fin n) (ι := Fin n) (v := linearRelation β)
          (fun i ↦ i) Function.injective_id s hs).jacobian) := by
  classical
  -- The Jacobi matrix is the identity because `∂(X j - β j)/∂X i = δᵢⱼ`.
  rw [PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
  have hmatrix :
      (PreSubmersivePresentation.naive
          (R := A) (σ := Fin n) (ι := Fin n) (v := linearRelation β)
          (fun i ↦ i) Function.injective_id s hs).jacobiMatrix = 1 := by
    ext i j
    by_cases hij : i = j
    · subst hij
      simp [PreSubmersivePresentation.jacobiMatrix_naive, linearRelation,
        MvPolynomial.pderiv_X_self]
    · simp [PreSubmersivePresentation.jacobiMatrix_naive, linearRelation, hij]
  rw [hmatrix, Matrix.det_one]
  exact isUnit_one

/-- Helper for Lemma 16.3.6: a fixed section of the quotient by the linear relation ideal. -/
noncomputable def linearRelationSection (β : Fin n → A) :
    MvPolynomial (Fin n) A ⧸ linearRelationIdeal β → MvPolynomial (Fin n) A :=
  Function.surjInv Ideal.Quotient.mk_surjective

/-- Helper for Lemma 16.3.6: the chosen quotient section is a right inverse to the quotient map. -/
lemma linearRelationSection_spec (β : Fin n → A)
    (x : MvPolynomial (Fin n) A ⧸ linearRelationIdeal β) :
    Ideal.Quotient.mk (linearRelationIdeal β) (linearRelationSection β x) = x :=
  Function.surjInv_eq Ideal.Quotient.mk_surjective x

/-- Helper for Lemma 16.3.6: the naive quotient by the linear relations is already submersive. -/
noncomputable def linearNaiveSubmersivePresentation (β : Fin n → A) :
    SubmersivePresentation A (MvPolynomial (Fin n) A ⧸ linearRelationIdeal β) (Fin n) (Fin n) :=
  { toPreSubmersivePresentation :=
      PreSubmersivePresentation.naive
        (R := A) (σ := Fin n) (ι := Fin n) (v := linearRelation β)
        (fun i ↦ i) Function.injective_id (linearRelationSection β) (linearRelationSection_spec β)
    jacobian_isUnit :=
      linear_naive_jacobian_isUnit β (linearRelationSection β) (linearRelationSection_spec β) }

/-- Helper for Lemma 16.3.6: the quotient by the linear relations is canonically isomorphic to
`A` via evaluation at `β`. -/
noncomputable def linearRelationQuotientEquiv (β : Fin n → A) :
    (MvPolynomial (Fin n) A ⧸ linearRelationIdeal β) ≃ₐ[A] A :=
  (Ideal.quotientEquivAlgOfEq A (linear_relations_span_ker_aeval β)).trans
    (Ideal.quotientKerAlgEquivOfRightInverse
      (f := (aeval β : MvPolynomial (Fin n) A →ₐ[A] A))
      (g := (C : A → MvPolynomial (Fin n) A))
      (linear_aeval_C_rightInverse β))

/-- Helper for Lemma 16.3.6: the quotient-to-`A` equivalence sends the class of `X i` to `β i`.
-/
lemma linearRelationQuotientEquiv_mk_X (β : Fin n → A) (i : Fin n) :
    linearRelationQuotientEquiv β (Ideal.Quotient.mk (linearRelationIdeal β) (X i)) = β i := by
  -- Rewrite through the explicit quotient equivalence so the computation happens in `aeval β`.
  change (Ideal.quotientKerAlgEquivOfRightInverse
      (f := (aeval β : MvPolynomial (Fin n) A →ₐ[A] A))
      (g := (C : A → MvPolynomial (Fin n) A))
      (linear_aeval_C_rightInverse β))
      (Ideal.Quotient.mk (RingHom.ker (aeval β : MvPolynomial (Fin n) A →ₐ[A] A)) (X i)) = β i
  -- The kernel quotient evaluates `X i` to the prescribed element `β i`.
  change ((aeval β : MvPolynomial (Fin n) A →ₐ[A] A)) (X i) = β i
  simp

/-- Helper for Lemma 16.3.6: the canonical linear submersive presentation of `A` over `A`
with values `β i`. -/
noncomputable def linearSubmersivePresentation (β : Fin n → A) :
    SubmersivePresentation A A (Fin n) (Fin n) :=
  (linearNaiveSubmersivePresentation β).ofAlgEquiv (linearRelationQuotientEquiv β)

/-- Helper for Lemma 16.3.6: the linear submersive presentation has identity distinguished map. -/
lemma linearSubmersivePresentation_map (β : Fin n → A) :
    (linearSubmersivePresentation β).map = (fun i ↦ i) := by
  -- Transport by an algebra equivalence does not change the distinguished-variable embedding.
  rfl

/-- Helper for Lemma 16.3.6: the distinguished generators of the linear submersive presentation
evaluate to the prescribed elements `β i`. -/
lemma linearSubmersivePresentation_val (β : Fin n → A) (i : Fin n) :
    (linearSubmersivePresentation β).val i = β i := by
  -- Route correction: compute the transported generator via the explicit quotient equivalence
  -- instead of asking definitional reduction to cross the quotient transport on its own.
  simpa [linearSubmersivePresentation, linearNaiveSubmersivePresentation] using
    linearRelationQuotientEquiv_mk_X β i

/-- Helper for Lemma 16.3.6: a finite submersive presentation can be reindexed so that its
distinguished variables are exactly the left `Fin c`-summand. -/
lemma SubmersivePresentation.exists_sum_fin_reindex
    {ι σ : Type*} [Finite ι] [Finite σ] (P : SubmersivePresentation R A ι σ) :
    ∃ c m, ∃ P' : SubmersivePresentation R A (Fin c ⊕ Fin m) (Fin c), P'.map = Sum.inl := by
  classical
  letI : Fintype ι := Fintype.ofFinite ι
  letI : Fintype σ := Fintype.ofFinite σ
  let eRange : Set.range P.map ⊕ ↥((Set.range P.map)ᶜ) ≃ ι := Equiv.Set.sumCompl (Set.range P.map)
  let eRelRange : Set.range P.map ≃ σ := (Equiv.ofInjective P.map P.map_inj).symm
  let PRange :
      SubmersivePresentation R A (Set.range P.map ⊕ ↥((Set.range P.map)ᶜ))
        (Set.range P.map) :=
    P.reindex eRange eRelRange
  have hPRange_map : PRange.map = Sum.inl := by
    -- First normalize the distinguished range so the relations index the left summand.
    ext x
    change eRange.symm (P.map (eRelRange x)) = Sum.inl x
    have hx : P.map (eRelRange x) = x.1 := by
      exact congrArg Subtype.val ((Equiv.ofInjective P.map P.map_inj).apply_symm_apply x)
    rw [hx]
    simp [eRange]
  letI : Fintype (Set.range P.map) := Fintype.ofFinite (Set.range P.map)
  letI : Fintype ↥((Set.range P.map)ᶜ) := Fintype.ofFinite ↥((Set.range P.map)ᶜ)
  let c := Fintype.card (Set.range P.map)
  let m := Fintype.card ↥((Set.range P.map)ᶜ)
  let eVarFin : Fin c ⊕ Fin m ≃ Set.range P.map ⊕ ↥((Set.range P.map)ᶜ) :=
    Equiv.sumCongr (Fintype.equivFin (Set.range P.map)).symm
      (Fintype.equivFin ↥((Set.range P.map)ᶜ)).symm
  let eRelFin : Fin c ≃ Set.range P.map := (Fintype.equivFin (Set.range P.map)).symm
  let P' : SubmersivePresentation R A (Fin c ⊕ Fin m) (Fin c) := PRange.reindex eVarFin eRelFin
  refine ⟨c, m, P', ?_⟩
  -- Then replace the finite subtypes by `Fin` while preserving the left-summand form.
  ext x
  change eVarFin.symm (PRange.map (eRelFin x)) = Sum.inl x
  rw [hPRange_map]
  simp [eVarFin, eRelFin]

/-- Helper for Lemma 16.3.6: the theorem's inclusion `Fin n → Fin (n + m)` is the usual
left summand inclusion `Fin.castAdd m`. -/
lemma fin_castLE_le_add_right_eq_castAdd {m : ℕ} (i : Fin n) :
    Fin.castLE (Nat.le_add_right n m) i = Fin.castAdd m i := by
  ext
  rfl

/- Domain-style sampling for standard smooth presentations with prescribed generators:
* primary domain: standard smooth commutative algebra and submersive presentations;
* sampled owner declarations:
  `Algebra.IsStandardSmooth.out`,
  `Algebra.SubmersivePresentation.reindex`,
  `Algebra.SubmersivePresentation.comp`,
  `Algebra.IsStandardSmoothOfRelativeDimension.exists_etale_mvPolynomial`;
* best owner abstraction:
  `Algebra.IsStandardSmooth` is the ambient owner providing a chosen `SubmersivePresentation`, and
  `SubmersivePresentation.reindex` is the canonical bridge for normalizing the distinguished
  Jacobian variables to a `Fin c`-summand;
* primitive vs. derived:
  the primitive source-facing data are the standard smooth owner, the chosen finite family
  `e : Fin n ↪ A`, and the distinguished variable-selection map `P.map`. The inequality
  `n ≤ c` is auxiliary bookkeeping used only to identify the first `n` distinguished variables
  inside the chosen owner `P`.

Source/core/bridge triage:
* source-facing: a standard smooth presentation of `A` in which a prescribed finite family of
  elements of `A` appears among the distinguished Jacobian generators;
* core/canonical owner: `Algebra.IsStandardSmooth` and `SubmersivePresentation`;
* bridge/view: the coordinate presentation indexed by `Fin c ⊕ Fin m` with
  `P.map = Sum.inl` is the canonical reindexing of an arbitrary `SubmersivePresentation` along the
  distinguished range of `P.map`.

Primitive data are the standard smooth owner, the chosen finite family `e : Fin n ↪ A`, and the
distinguished variables selected by the primitive field `P.map`. The index inequality `n ≤ c` is
derived only after choosing the canonical `P.map = Sum.inl` presentation and is used solely to
place the prescribed family inside the first `c` distinguished variables.
-/
-- Proof sketch: choose a submersive presentation of `A` over `R`, enumerate the prescribed finite
-- subset by `e : Fin n ↪ A`, lift those elements to polynomials in the chosen generators, and
-- adjoin new variables `x₁, …, xₙ` together with relations `xᵢ - hᵢ`. Reindex the resulting
-- submersive presentation so that the Jacobian variables are exactly the `Fin c`-summand. Then
-- the first `n` of those distinguished variables map to the chosen elements.
/-- Lemma 16.3.6: if `R → A` is standard smooth and `e : Fin n ↪ A` enumerates a finite subset
of cardinality `n`, then `A` admits a submersive presentation
`R[x₁, ..., x_{c + m}] / (f₁, ..., f_c)` whose distinguished Jacobian variables are the first
`c`, with `n ≤ c`, and whose first `n` distinguished generators map to the prescribed
elements `e i`. This is a bridge theorem on the canonical owner `Algebra.IsStandardSmooth`,
not a second owner abstraction. -/
theorem IsStandardSmooth.exists_submersivePresentation_with_prescribed_generators
    [IsStandardSmooth R A] (e : Fin n ↪ A) :
    ∃ (c m : ℕ) (P : SubmersivePresentation R A (Fin c ⊕ Fin m) (Fin c)) (h : n ≤ c),
      P.map = Sum.inl ∧ ∀ i : Fin n, P.val (.inl (Fin.castLE h i)) = e i := by
  classical
  obtain ⟨ι, σ, hσ, hι, ⟨P₀⟩⟩ := IsStandardSmooth.out (R := R) (S := A)
  letI : Finite σ := hσ
  letI : Finite ι := hι
  -- First normalize the chosen standard-smooth witness so that its distinguished variables form
  -- a left `Fin c₀`-summand.
  obtain ⟨c₀, m₀, Pstd, hPstd_map⟩ :=
    SubmersivePresentation.exists_sum_fin_reindex (R := R) (A := A) P₀
  -- Next adjoin variables for the prescribed elements with the linear relations `X i - e i`.
  let Qe : SubmersivePresentation A A (Fin n) (Fin n) := linearSubmersivePresentation e
  have hQe_map : Qe.map = (fun i ↦ i) := linearSubmersivePresentation_map e
  have hQe_val : ∀ i : Fin n, Qe.val i = e i := linearSubmersivePresentation_val e
  let eRel : Fin (n + c₀) ≃ Fin n ⊕ Fin c₀ := finSumFinEquiv.symm
  let eVar : Fin (n + c₀) ⊕ Fin m₀ ≃ Fin n ⊕ (Fin c₀ ⊕ Fin m₀) :=
    (Equiv.sumCongr (finSumFinEquiv.symm) (Equiv.refl _)).trans (Equiv.sumAssoc _ _ _)
  let P : SubmersivePresentation R A (Fin (n + c₀) ⊕ Fin m₀) (Fin (n + c₀)) :=
    (Qe.comp Pstd).reindex eVar eRel
  refine ⟨n + c₀, m₀, P, Nat.le_add_right n c₀, ?_⟩
  constructor
  · -- Route correction: compute the final map by splitting along `finSumFinEquiv.symm` instead of
    -- leaving the composition and reindex transports to elaboration.
    ext x
    change eVar.symm
        (Sum.elim (fun rq : Fin n ↦ Sum.inl (Qe.map rq))
          (fun rp : Fin c₀ ↦ Sum.inr (Pstd.map rp)) (eRel x)) = Sum.inl x
    rw [hQe_map, hPstd_map]
    cases h : eRel x with
    | inl i =>
        have hx : x = Fin.castAdd c₀ i := by
          simpa [eRel] using congrArg finSumFinEquiv h
        simp [eVar, hx]
    | inr j =>
        have hx : x = Fin.natAdd n j := by
          simpa [eRel] using congrArg finSumFinEquiv h
        simp [eVar, hx]
  · intro i
    -- The first `n` distinguished variables come from the linear presentation `Qe`.
    rw [fin_castLE_le_add_right_eq_castAdd]
    change Sum.elim Qe.val ((algebraMap A A) ∘ Pstd.val) (eVar (.inl (Fin.castAdd c₀ i))) = e i
    have hx : eVar (.inl (Fin.castAdd c₀ i)) = Sum.inl i := by
      simp [eVar, finSumFinEquiv]
    rw [hx]
    exact hQe_val i

end

end Algebra
