    (p : ℕ) [Fact p.Prime] [CharP k p] [CharP Λ p] :=
  TensorProduct k (ResidueField Λ) (KaehlerDifferential (ZMod p) k)

/- Domain-style sampling for Lemma 16.11.1.

Primary domain: directed approximation of an Artinian local `k`-algebra by `k`-subalgebras inside
