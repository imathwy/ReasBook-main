/-- Helper for Lemma 16.11.1: quotienting by a positive power of the maximal ideal stays
nontrivial. -/
private lemma quotientPowMaximalIdeal_nontrivial (r : ℕ) :
    Nontrivial (Λ ⧸ maximalIdeal Λ ^ (r + 2)) := by
  exact
    Ideal.Quotient.nontrivial_iff.2 <|
      quotient_pow_maximalIdeal_ne_top (R := Λ) (r + 1)

local instance (r : ℕ) : IsLocalRing (Λ ⧸ maximalIdeal Λ ^ (r + 2)) := by
  letI : Nontrivial (Λ ⧸ maximalIdeal Λ ^ (r + 2)) :=
    quotientPowMaximalIdeal_nontrivial (Λ := Λ) r
  exact
    IsLocalRing.of_surjective'
      (Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))) Ideal.Quotient.mk_surjective

/-- Helper for Lemma 16.11.1: the source proof repeatedly uses the base change of
`Ω[k⁄ZMod p]` to the residue field. -/
abbrev residueFieldBaseChangedKaehler
