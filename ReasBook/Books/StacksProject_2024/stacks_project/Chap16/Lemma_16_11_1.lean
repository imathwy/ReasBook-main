-- Proof sketch: choose directed Artinian local `k`-subalgebras of `Λ` generated by finite pieces of
-- the residue field together with generators of the maximal ideal; use the finite-dimensionality of
-- `H_1(L_{K/k})` for `K = ResidueField Λ` to arrange compatible sections and descend the
-- coefficients to finitely generated intermediate fields; then apply the Artinian local criterion
-- for essential finite type over the residue field and take the directed union over all such
-- finitely generated intermediate fields.
/-- Helper for Lemma 16.11.1: an Artinian local algebra in characteristic `p` admits a ring
section of its residue map. -/
lemma exists_residueField_section_of_artinianLocal_charP :
    [CharP Λ p] →
    ∃ σ : ResidueField Λ →+* Λ, (residue Λ).comp σ = RingHom.id (ResidueField Λ) := by
  intro _
  -- Artinian local rings have nilpotent maximal ideal, so Lemma `15.116.10` applies directly.
  have hnil : IsNilpotent (maximalIdeal Λ) :=
    (isArtinianRing_iff_isNilpotent_maximalIdeal Λ).mp inferInstance
  exact
    exists_residueField_section_of_isNilpotent_maximalIdeal
      (A := Λ) (p := p) hnil

/-- Helper for Lemma 16.11.1: fix a seed intermediate field `F₀ ⊆ ResidueField Λ`; the later
stage family is naturally indexed by finitely generated intermediate fields containing `F₀`. -/
abbrev SeededFgIntermediateField (F₀ : IntermediateField k (ResidueField Λ)) :=
  {F : IntermediateField k (ResidueField Λ) // F₀ ≤ F ∧ F.FG}

/-- Helper for Lemma 16.11.1: the compositum of two finitely generated intermediate fields inside
`ResidueField Λ` is again finitely generated over `k`. -/
lemma fg_sup_intermediateField
    {F G : IntermediateField k (ResidueField Λ)} (hF : F.FG) (hG : G.FG) :
    (F ⊔ G).FG := by
  classical
  rcases hF with ⟨t, ht⟩
  rcases hG with ⟨u, hu⟩
  refine ⟨t ∪ u, ?_⟩
  -- The compositum is the field generated by the union of finite generating sets.
  calc
    IntermediateField.adjoin k (↑(t ∪ u) : Set (ResidueField Λ)) =
        IntermediateField.adjoin k (↑t : Set (ResidueField Λ)) ⊔
          IntermediateField.adjoin k (↑u : Set (ResidueField Λ)) := by
            simpa [Finset.coe_union] using
              (IntermediateField.adjoin_union
                (F := k)
                (E := ResidueField Λ)
                (S := (↑t : Set (ResidueField Λ)))
                (T := (↑u : Set (ResidueField Λ))))
    _ = F ⊔ G := by rw [ht, hu]

/-- Helper for Lemma 16.11.1: finitely generated intermediate fields containing a fixed seed field
are directed under compositum. -/
lemma directed_seededFgIntermediateField
    {F₀ : IntermediateField k (ResidueField Λ)} :
    Directed (· ≤ ·)
      (fun F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀ ↦
        (F : IntermediateField k (ResidueField Λ))) := by
  intro F G
  -- The source-proof index category closes under adjoining finitely many coefficient fields.
  refine ⟨⟨(F : IntermediateField k (ResidueField Λ)) ⊔
      (G : IntermediateField k (ResidueField Λ)), ?_, ?_⟩, ?_, ?_⟩
  · -- The new stage still contains the common seed field `F₀`.
    exact F.2.1.trans le_sup_left
  · -- Finite generation is stable under taking the compositum of finitely generated fields.
    exact fg_sup_intermediateField (k := k) (Λ := Λ) F.2.2 G.2.2
  · -- Every left stage embeds into the compositum stage.
    exact le_sup_left
  · -- Every right stage embeds into the compositum stage.
    exact le_sup_right

/-- Helper for Lemma 16.11.1: any finite residue-field coefficient set is already contained in a
finitely generated intermediate field above a chosen finitely generated seed field. -/
lemma exists_seededFgIntermediateField_of_finset
    {F₀ : IntermediateField k (ResidueField Λ)} (hF₀ : F₀.FG)
    (s : Finset (ResidueField Λ)) :
    ∃ F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀,
      (↑s : Set (ResidueField Λ)) ⊆ (F : IntermediateField k (ResidueField Λ)) := by
  -- Adjoin the finitely many requested coefficients to the seed field `F₀`.
  refine ⟨⟨F₀ ⊔ IntermediateField.adjoin k (↑s : Set (ResidueField Λ)), le_sup_left, ?_⟩, ?_⟩
  · have hsfg : (IntermediateField.adjoin k (↑s : Set (ResidueField Λ))).FG := by
      simpa using IntermediateField.fg_adjoin_finset s
    exact fg_sup_intermediateField (k := k) (Λ := Λ) hF₀ hsfg
  · intro x hx
    -- Each selected coefficient lies in the adjoin stage, hence in the compositum with `F₀`.
    have hxad : x ∈ IntermediateField.adjoin k (↑s : Set (ResidueField Λ)) := by
      exact
        IntermediateField.subset_adjoin
          (F := k) (E := ResidueField Λ) (S := (↑s : Set (ResidueField Λ))) hx
    exact
      (show IntermediateField.adjoin k (↑s : Set (ResidueField Λ)) ≤
          F₀ ⊔ IntermediateField.adjoin k (↑s : Set (ResidueField Λ)) from le_sup_right) <|
        hxad

/-- Helper for Lemma 16.11.1: if two maps to `Λ` agree modulo an ideal `I`, then their
pointwise difference lands in `I`. -/
lemma difference_algebraMap_mem_of_quotient_equal
    {I : Ideal Λ} (g : k →+* Λ)
    (hquot : (Ideal.Quotient.mk I).comp (algebraMap k Λ) = (Ideal.Quotient.mk I).comp g)
    (a : k) :
    algebraMap k Λ a - g a ∈ I := by
  -- Evaluate the quotient-level equality at `a` and subtract the two representatives upstairs.
  have hq : Ideal.Quotient.mk I (algebraMap k Λ a) = Ideal.Quotient.mk I (g a) := by
    exact DFunLike.congr_fun hquot a
  have hzero : Ideal.Quotient.mk I (algebraMap k Λ a - g a) = 0 := by
    rw [map_sub, hq, sub_self]
  exact Ideal.Quotient.eq_zero_iff_mem.1 hzero

/-- Helper for Lemma 16.11.1: over a square-zero ideal, the difference between the given
`k`-algebra map and another quotient-compatible map satisfies the ambient Leibniz formula. -/
lemma difference_algebraMap_mul_eq_of_square_zero
    {I : Ideal Λ} (hI2 : I ^ 2 = ⊥) (g : k →+* Λ)
    (hquot : (Ideal.Quotient.mk I).comp (algebraMap k Λ) = (Ideal.Quotient.mk I).comp g)
    (a b : k) :
    algebraMap k Λ (a * b) - g (a * b) =
      algebraMap k Λ a * (algebraMap k Λ b - g b) +
        algebraMap k Λ b * (algebraMap k Λ a - g a) := by
  -- Route correction: isolate the square-zero product computation in the ambient ring `Λ`
  -- before packaging it later as an `I`-valued derivation.
  have hδa : algebraMap k Λ a - g a ∈ I :=
    difference_algebraMap_mem_of_quotient_equal (k := k) (Λ := Λ) g hquot a
  have hδb : algebraMap k Λ b - g b ∈ I :=
    difference_algebraMap_mem_of_quotient_equal (k := k) (Λ := Λ) g hquot b
  have hsq0 : (algebraMap k Λ a - g a) * (algebraMap k Λ b - g b) = 0 := by
    -- The two difference terms lie in `I`, so their product lands in `I ^ 2 = 0`.
    have hmul_mem : (algebraMap k Λ a - g a) * (algebraMap k Λ b - g b) ∈ I ^ 2 := by
      simpa [pow_two] using Ideal.mul_mem_mul hδa hδb
    have hmul_bot : (algebraMap k Λ a - g a) * (algebraMap k Λ b - g b) ∈ (⊥ : Ideal Λ) := by
      simpa [hI2] using hmul_mem
    simpa using hmul_bot
  -- Rewrite the target as the vanishing of the square-zero correction term.
  apply sub_eq_zero.1
  calc
    algebraMap k Λ (a * b) - g (a * b) -
        (algebraMap k Λ a * (algebraMap k Λ b - g b) +
          algebraMap k Λ b * (algebraMap k Λ a - g a)) =
      -((algebraMap k Λ a - g a) * (algebraMap k Λ b - g b)) := by
        rw [RingHom.map_mul, RingHom.map_mul]
        ring
    _ = 0 := by simp [hsq0]

/-- Helper for Lemma 16.11.1: a quotient-compatible map differs from the given `k`-algebra map by
an `I`-valued derivation when `I² = 0`. -/
lemma difference_algebraMap_to_square_zero_derivation
    {I : Ideal Λ} (hI2 : I ^ 2 = ⊥) (g : k →+* Λ)
    (hquot : (Ideal.Quotient.mk I).comp (algebraMap k Λ) = (Ideal.Quotient.mk I).comp g) :
    ∃ θ : Derivation (ZMod p) k I,
      ∀ a : k, ((θ a : I) : Λ) = algebraMap k Λ a - g a := by
  let θlin : k →ₗ[ZMod p] I :=
    { toFun := fun a ↦
        ⟨algebraMap k Λ a - g a,
          difference_algebraMap_mem_of_quotient_equal (k := k) (Λ := Λ) g hquot a⟩
      map_add' := fun a b ↦ by
        -- The difference construction is additive before packaging it into the ideal.
        apply Subtype.ext
        change algebraMap k Λ (a + b) - g (a + b) =
          (algebraMap k Λ a - g a) + (algebraMap k Λ b - g b)
        rw [map_add, RingHom.map_add]
        ring
      map_smul' := fun c a ↦ by
        -- Over `𝔽_p`, both ring maps are scalar compatible, so the difference is `ZMod p`-linear.
        apply Subtype.ext
        change algebraMap k Λ (c • a) - g (c • a) =
          c • (algebraMap k Λ a - g a)
        rw [Algebra.smul_def, Algebra.smul_def, map_mul, RingHom.map_mul]
        have hk : algebraMap k Λ ((algebraMap (ZMod p) k) c) = algebraMap (ZMod p) Λ c := by
          exact
            congrArg (fun f : ZMod p →+* Λ ↦ f c)
              (RingHom.ext_zmod
                ((algebraMap k Λ).comp (algebraMap (ZMod p) k))
                (algebraMap (ZMod p) Λ))
        have hg : g ((algebraMap (ZMod p) k) c) = algebraMap (ZMod p) Λ c := by
          exact
            congrArg (fun f : ZMod p →+* Λ ↦ f c)
              (RingHom.ext_zmod
                (g.comp (algebraMap (ZMod p) k))
                (algebraMap (ZMod p) Λ))
        rw [hk, hg]
        ring }
  have hone : θlin 1 = 0 := by
    -- A derivation must kill `1`, and the difference vanishes there because both maps are unital.
    apply Subtype.ext
    change algebraMap k Λ (1 : k) - g 1 = 0
    simp
  have hmul : ∀ a b, θlin (a * b) = a • θlin b + b • θlin a := by
    intro a b
    -- Coerce the ideal-valued identity back to `Λ`, where the square-zero Leibniz formula is
    -- already available.
    apply Subtype.ext
    simpa [θlin, Algebra.smul_def] using
      difference_algebraMap_mul_eq_of_square_zero
        (k := k) (Λ := Λ) hI2 g hquot a b
  let θ : Derivation (ZMod p) k I := Derivation.mk θlin hone hmul
  refine ⟨θ, ?_⟩
  intro a
  rfl

/-- Helper for Lemma 16.11.1: perturbing a residue-field section by a derivation valued in a
square-zero ideal contained in the maximal ideal yields another section of the residue map. -/
lemma section_add_derivation_is_section
    [CharP Λ p]
    {I : Ideal Λ} (hI : I ≤ maximalIdeal Λ) (hI2 : I ^ 2 = ⊥)
    (σ : ResidueField Λ →+* Λ)
    (hσ : (residue Λ).comp σ = RingHom.id (ResidueField Λ))
    (D : ResidueField Λ →+ I)
    (hD_one : D 1 = 0)
    (hD_mul :
      let _ : Algebra (ResidueField Λ) Λ := σ.toAlgebra
      ∀ x y, D (x * y) = x • D y + y • D x) :
    ∃ σ' : ResidueField Λ →+* Λ,
      (∀ x, σ' x = σ x + D x) ∧
        (residue Λ).comp σ' = RingHom.id (ResidueField Λ) := by
  let _ : Algebra (ResidueField Λ) Λ := σ.toAlgebra
  let σ' : ResidueField Λ →+* Λ :=
    { toFun := fun x ↦ σ x + D x
      map_zero' := by
        -- Both the original section and the derivation vanish at zero.
        change σ 0 + (((D 0 : I) : Λ)) = 0
        simp
      map_one' := by
        -- A derivation kills `1`, so the perturbation still sends `1` to `1`.
        change σ 1 + (((D 1 : I) : Λ)) = 1
        simp [hD_one]
      map_add' := fun x y ↦ by
        -- Additivity is termwise because both `σ` and `D` are additive.
        change σ (x + y) + (((D (x + y) : I) : Λ)) =
          (σ x + (((D x : I) : Λ))) + (σ y + (((D y : I) : Λ)))
        rw [RingHom.map_add, D.map_add]
        simp [add_assoc, add_left_comm, add_comm]
      map_mul' := fun x y ↦ by
        -- The Leibniz rule gives the mixed terms, and the square-zero hypothesis kills `D x * D y`.
        have hDxDy : ((D x : I) : Λ) * ((D y : I) : Λ) = 0 := by
          have hmul_mem : ((D x : I) : Λ) * ((D y : I) : Λ) ∈ I ^ 2 := by
            simpa [pow_two] using Ideal.mul_mem_mul (D x).2 (D y).2
          have hmul_bot : ((D x : I) : Λ) * ((D y : I) : Λ) ∈ (⊥ : Ideal Λ) := by
            simpa [hI2] using hmul_mem
          simpa using hmul_bot
        -- Rewrite the perturbation of multiplication in the ambient ring `Λ`.
        change σ (x * y) + (((D (x * y) : I) : Λ)) =
          (σ x + (((D x : I) : Λ))) * (σ y + (((D y : I) : Λ)))
        rw [hD_mul, RingHom.map_mul]
        change σ x * σ y + (σ x * (((D y : I) : Λ)) + σ y * (((D x : I) : Λ))) =
          (σ x + (((D x : I) : Λ))) * (σ y + (((D y : I) : Λ)))
        simp only [mul_add, add_mul, add_assoc]
        rw [hDxDy, add_zero]
        simp [add_assoc, add_left_comm, add_comm, mul_comm, mul_left_comm, mul_assoc] }
  refine ⟨σ', ?_⟩
  constructor
  · intro x
    rfl
  · -- The added derivation lands in `maximalIdeal Λ`, so it vanishes in the residue field.
    ext x
    have hDx0 : residue Λ (((D x : I) : Λ)) = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.2 (hI (D x).2)
    have hσx : residue Λ (σ x) = x := DFunLike.congr_fun hσ x
    calc
      residue Λ (σ x + (((D x : I) : Λ))) = residue Λ (σ x) + residue Λ (((D x : I) : Λ)) := by
        simp
      _ = x + 0 := by
        rw [hσx, hDx0]
      _ = x := by simp

/-- Helper for Lemma 16.11.1: the Jacobi-Zariski exactness statement for
`𝔽_p → k → ResidueField Λ` identifies the kernel of base change on Kähler differentials with the
range of the connecting map on `H_1`. -/
lemma ker_mapBaseChange_eq_range_h1Cotangent_delta :
    LinearMap.ker (KaehlerDifferential.mapBaseChange (ZMod p) k (ResidueField Λ)) =
      LinearMap.range (Algebra.H1Cotangent.δ (ZMod p) k (ResidueField Λ)) := by
  let ε := KaehlerDifferential.mapBaseChange (ZMod p) k (ResidueField Λ)
  let δ := Algebra.H1Cotangent.δ (ZMod p) k (ResidueField Λ)
  have hExact : Function.Exact δ ε := by
    -- Keep the comparison in one spelling world so exactness rewrites directly to `ker = range`.
    simpa [δ, ε] using Algebra.H1Cotangent.exact_δ_mapBaseChange (ZMod p) k (ResidueField Λ)
  exact hExact.linearMap_ker_eq

/-- Helper for Lemma 16.11.1: finite-dimensionality of `H_1(L_{K/k})` forces the kernel of the
base-change map on Kähler differentials to be finite-dimensional as well. -/
lemma finiteDimensional_ker_mapBaseChange :
    [FiniteDimensional (ResidueField Λ) (Algebra.H1Cotangent k (ResidueField Λ))] →
    FiniteDimensional (ResidueField Λ)
      (LinearMap.ker (KaehlerDifferential.mapBaseChange (ZMod p) k (ResidueField Λ))) := by
  intro _
  -- Transport finite dimensionality across the exactness identification with `range δ`.
  rw [ker_mapBaseChange_eq_range_h1Cotangent_delta (k := k) (Λ := Λ) (p := p)]
  infer_instance

/-- Helper for Lemma 16.11.1: a finite-dimensional subspace of finitely supported coefficient
families is uniformly supported on one finite set of indices. -/
lemma exists_commonSupport_finset_of_finiteDimensional_submodule
    {K : Type*} [Field K] {ι : Type*} [DecidableEq ι]
    (W : Submodule K (ι →₀ K)) [FiniteDimensional K W] :
    ∃ s : Finset ι, ∀ w : W, w.1.support ⊆ s := by
  classical
  let b := Module.finBasis K W
  let s : Finset ι := Finset.univ.biUnion fun i ↦ ((b i : W).1.support)
  refine ⟨s, ?_⟩
  intro w a ha
  by_contra hnot
  let ev : W →ₗ[K] K :=
    { toFun := fun x ↦ x.1 a
      map_add' := fun x y ↦ by simp
      map_smul' := fun c x ↦ by simp }
  have hcoord_zero : ev (∑ i, (b.repr w i) • b i) = 0 := by
    -- Outside the support union, every basis vector has zero `a`-coordinate, so the whole sum does.
    rw [map_sum]
    refine Finset.sum_eq_zero ?_
    intro i hi
    have hbasis_not_mem : a ∉ ((b i : W).1.support) := by
      intro hmem
      exact hnot (Finset.mem_biUnion.2 ⟨i, Finset.mem_univ i, hmem⟩)
    have hbasis_zero : ((b i : W).1) a = 0 := by
      by_contra hbasis_zero
      exact hbasis_not_mem (Finsupp.mem_support_iff.mpr hbasis_zero)
    simp [ev, hbasis_zero]
  have hwa : w.1 a = 0 := by
    -- Read the `a`-coordinate of the basis expansion.
    calc
      w.1 a = ev (∑ i, (b.repr w i) • b i) := by
        simpa [ev] using congrArg ev (b.sum_repr w).symm
      _ = 0 := hcoord_zero
  exact (Finsupp.mem_support_iff.mp ha) hwa

/-- Helper for Lemma 16.11.1: once the kernel of the base-change map on Kähler differentials is
written in coordinates of a chosen basis, every kernel vector is supported on one finite index
set. -/
lemma existsFiniteKernelCoordinateSet
    {ι : Type*} [DecidableEq ι]
    (bK : Module.Basis ι (ResidueField Λ)
      (TensorProduct k (ResidueField Λ) (KaehlerDifferential (ZMod p) k)))
    (hfdKer :
      FiniteDimensional (ResidueField Λ)
        (LinearMap.ker (KaehlerDifferential.mapBaseChange (ZMod p) k (ResidueField Λ)))) :
    ∃ J : Finset ι,
      ∀ z : LinearMap.ker (KaehlerDifferential.mapBaseChange (ZMod p) k (ResidueField Λ)),
        ((bK.repr z.1).support : Set ι) ⊆ J := by
  classical
  let ε := KaehlerDifferential.mapBaseChange (ZMod p) k (ResidueField Λ)
  let W : Submodule (ResidueField Λ) (ι →₀ ResidueField Λ) :=
    (LinearMap.ker ε).map bK.repr.toLinearMap
  letI : FiniteDimensional (ResidueField Λ) W := by
    infer_instance
  obtain ⟨J, hJ⟩ := exists_commonSupport_finset_of_finiteDimensional_submodule W
  refine ⟨J, ?_⟩
  intro z
  have hzW : bK.repr z.1 ∈ W := by
    exact ⟨z.1, z.2, rfl⟩
  -- Move the kernel element into the mapped coordinate submodule and apply the common-support lemma.
  exact hJ ⟨bK.repr z.1, hzW⟩

/-- Helper for Lemma 16.11.1: after choosing a `p`-basis of `k` over `𝔽_p`, the kernel of the
base-change map on Kähler differentials is uniformly supported on finitely many of the canonical
`p`-basis coordinates. -/
lemma existsFiniteKernelCoordinateSetForPBasis
    [FiniteDimensional (ResidueField Λ) (Algebra.H1Cotangent k (ResidueField Λ))] :
    ∃ (ι : Type u) (_ : DecidableEq ι) (x : ι → k) (hx : IsPBasis p (ZMod p) k x)
      (J : Finset ι),
      let bOmega : Module.Basis ι k (KaehlerDifferential (ZMod p) k) :=
        Module.Basis.mk
          ((isPBasis_iff_differentials_formBasis (p := p) (k := ZMod p) (K := k) x).1 hx).1
          ((isPBasis_iff_differentials_formBasis (p := p) (k := ZMod p) (K := k) x).1 hx).2.ge
      let bK : Module.Basis ι (ResidueField Λ)
          (TensorProduct k (ResidueField Λ) (KaehlerDifferential (ZMod p) k)) :=
        Algebra.TensorProduct.basis (ResidueField Λ) bOmega
      ∀ z : LinearMap.ker (KaehlerDifferential.mapBaseChange (ZMod p) k (ResidueField Λ)),
        ((bK.repr z.1).support : Set ι) ⊆ J := by
  classical
  obtain ⟨ι, x, hx⟩ := exists_isPBasis (p := p) (k := ZMod p) (K := k)
  let hxBasis :=
    (isPBasis_iff_differentials_formBasis (p := p) (k := ZMod p) (K := k) x).1 hx
  let bOmega : Module.Basis ι k (KaehlerDifferential (ZMod p) k) :=
    Module.Basis.mk
      hxBasis.1
      hxBasis.2.ge
  let bK : Module.Basis ι (ResidueField Λ)
      (TensorProduct k (ResidueField Λ) (KaehlerDifferential (ZMod p) k)) :=
    Algebra.TensorProduct.basis (ResidueField Λ) bOmega
  have hfdKer :
      FiniteDimensional (ResidueField Λ)
        (LinearMap.ker (KaehlerDifferential.mapBaseChange (ZMod p) k (ResidueField Λ))) :=
    finiteDimensional_ker_mapBaseChange (k := k) (Λ := Λ) (p := p)
  obtain ⟨J, hJ⟩ :=
    existsFiniteKernelCoordinateSet (k := k) (Λ := Λ) (p := p) bK hfdKer
  refine ⟨ι, inferInstance, x, hx, J, ?_⟩
  -- The canonical tensor-product basis now packages the finite-support control exactly as needed.
  simpa [bOmega, bK] using hJ

/-- Helper for Lemma 16.11.1: a monotone family indexed by seeded finitely generated intermediate
fields is automatically directed, because the seed index category is directed under compositum. -/
lemma directed_subalgebraFamily_of_seededFgIntermediateField
    {F₀ : IntermediateField k (ResidueField Λ)}
    {S : SeededFgIntermediateField (k := k) (Λ := Λ) F₀ → Subalgebra k Λ}
    (hmono : Monotone S) :
    Directed (· ≤ ·) S := by
  intro F G
  -- Push the directedness of the residue-field indices forward along the monotone stage family.
  rcases
      directed_seededFgIntermediateField (k := k) (Λ := Λ) (F₀ := F₀) F G with
    ⟨H, hFH, hGH⟩
  exact ⟨H, hmono hFH, hmono hGH⟩

/-- Helper for Lemma 16.11.1: the `(r + 1)`st maximal-ideal layer inside the quotient
`Λ ⧸ maximalIdeal Λ ^ (r + 2)` still lies in the quotient maximal ideal. -/
lemma maximalIdealPowerQuotientLayer_le_maximalIdeal (r : ℕ) :
    Ideal.map (Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))) (maximalIdeal Λ ^ (r + 1)) ≤
      maximalIdeal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) := by
  have hpow :
      maximalIdeal Λ ^ (r + 1) ≤ maximalIdeal Λ := by
    -- Positive powers of the maximal ideal stay inside the maximal ideal itself.
    simpa using
      (Ideal.pow_le_pow_right (I := maximalIdeal Λ) (by omega : 1 ≤ r + 1))
  have hmap :
      Ideal.map (Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))) (maximalIdeal Λ) ≤
        maximalIdeal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) := by
    -- Quotient maps out of local rings carry the closed point into the quotient closed point.
    have hmax :
        Ideal.map (Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))) (maximalIdeal Λ) =
          maximalIdeal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) := by
      exact
        IsLocalRing.map_maximalIdeal_of_surjective
          (Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))) Ideal.Quotient.mk_surjective
    rw [hmax]
  exact le_trans (Ideal.map_mono hpow) hmap

/-- Helper for Lemma 16.11.1: the quotient-layer ideal coming from `maximalIdeal Λ ^ (r + 1)`
inside `Λ ⧸ maximalIdeal Λ ^ (r + 2)` is square-zero. -/
lemma maximalIdealPowerQuotientSquareZero (r : ℕ) :
    let q : Λ →+* (Λ ⧸ maximalIdeal Λ ^ (r + 2)) :=
      Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))
    let Iq : Ideal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) :=
      Ideal.map q (maximalIdeal Λ ^ (r + 1))
    Iq ^ 2 = ⊥ := by
  let q : Λ →+* (Λ ⧸ maximalIdeal Λ ^ (r + 2)) :=
    Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))
  let Iq : Ideal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) :=
    Ideal.map q (maximalIdeal Λ ^ (r + 1))
  -- The doubled layer maps to zero because `(r + 1) + (r + 1) ≥ r + 2`, so the product already
  -- lands in the quotient kernel.
  have hpow_le :
      maximalIdeal Λ ^ ((r + 1) + (r + 1)) ≤ maximalIdeal Λ ^ (r + 2) := by
    exact Ideal.pow_le_pow_right (by omega)
  have hmap_bot :
      Ideal.map q (maximalIdeal Λ ^ ((r + 1) + (r + 1))) =
        (⊥ : Ideal (Λ ⧸ maximalIdeal Λ ^ (r + 2))) := by
    exact (Ideal.map_eq_bot_iff_le_ker q).2 <| by
      simpa [q] using hpow_le
  calc
    Iq ^ 2 =
        Ideal.map q (maximalIdeal Λ ^ (r + 1)) *
          Ideal.map q (maximalIdeal Λ ^ (r + 1)) := by
            simp [Iq, pow_two]
    _ = Ideal.map q ((maximalIdeal Λ ^ (r + 1)) * (maximalIdeal Λ ^ (r + 1))) := by
          rw [← Ideal.map_mul]
    _ = Ideal.map q (maximalIdeal Λ ^ ((r + 1) + (r + 1))) := by
          rw [← pow_add]
    _ = ⊥ := hmap_bot

/-- Helper for Lemma 16.11.1: the canonical quotient layer
`maximalIdeal Λ ^ (r + 1) / maximalIdeal Λ ^ (r + 2)` is the square-zero correction ideal used in
the quotient-tower induction. -/
lemma maximalIdealPowerQuotientLayer_squareZeroData (r : ℕ) :
    let Iq : Ideal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) :=
      Ideal.map (Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))) (maximalIdeal Λ ^ (r + 1))
    Iq ≤ maximalIdeal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) ∧ Iq ^ 2 = ⊥ := by
  constructor
  · -- The layer ideal is still contained in the quotient maximal ideal.
    exact maximalIdealPowerQuotientLayer_le_maximalIdeal (Λ := Λ) r
  · -- The next quotient step is square-zero, matching the derivation-correction API.
    simpa using maximalIdealPowerQuotientSquareZero (Λ := Λ) r

/-- Helper for Lemma 16.11.1: quotienting `Λ` by a power of its maximal ideal does not change the
residue field. This keeps the quotient-stage induction in one fixed ambient residue field. -/
noncomputable def maximalIdealPowerQuotientResidueFieldEquiv (r : ℕ) :
    ResidueField (Λ ⧸ maximalIdeal Λ ^ (r + 2)) ≃+* ResidueField Λ :=
  residueField_quotient_pow_maximalIdeal_equiv (R := Λ) (r + 1)

/-- Helper for Lemma 16.11.1: under the quotient-stage residue-field equivalence, the residue
class of an element of `Λ` agrees with its original residue class. -/
lemma maximalIdealPowerQuotientResidueFieldEquiv_apply_residue (r : ℕ) (x : Λ) :
    maximalIdealPowerQuotientResidueFieldEquiv (r := r)
        (residue (Λ ⧸ maximalIdeal Λ ^ (r + 2))
          (Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2)) x)) =
      residue Λ x := by
  -- Delegate the quotient-stage residue comparison to the earlier maximal-ideal-power API.
  simpa [maximalIdealPowerQuotientResidueFieldEquiv] using
    residueField_quotient_pow_maximalIdeal_equiv_apply_residue (R := Λ) (r + 1) x

/-- Helper for Lemma 16.11.1: every quotient stage `Λ / maximalIdeal Λ^(r + 2)` admits a
residue-field section. This is the coefficient-field input for the successor step of the
source-proof induction. -/
lemma existsResidueFieldSection_maximalIdealPowerQuotient
    [CharP Λ p] (r : ℕ) :
    ∃ σq : ResidueField (Λ ⧸ maximalIdeal Λ ^ (r + 2)) →+*
        (Λ ⧸ maximalIdeal Λ ^ (r + 2)),
      (residue (Λ ⧸ maximalIdeal Λ ^ (r + 2))).comp σq =
        RingHom.id (ResidueField (Λ ⧸ maximalIdeal Λ ^ (r + 2))) := by
  -- The earlier Artinian-quotient section theorem applies directly to the `(r + 2)`nd quotient.
  simpa using
    exists_residueField_section_quotient_pow_maximalIdeal (R := Λ) (p := p) (r + 1)

/-- Helper for Lemma 16.11.1: if the maximal ideal of `Λ` vanishes, then `Λ` is canonically the
same `k`-algebra as its residue field. -/
noncomputable def residueFieldAlgEquivOfMaximalIdealEqBot
    (hmax : maximalIdeal Λ = ⊥) :
    Λ ≃ₐ[k] ResidueField Λ := by
  let eRing : Λ ≃+* ResidueField Λ :=
    RingEquiv.ofBijective (residue Λ) <| by
      constructor
      · -- The residue map becomes injective once its kernel `maximalIdeal Λ` vanishes.
        rw [RingHom.injective_iff_ker_eq_bot]
        simpa [hmax] using (IsLocalRing.ker_residue (R := Λ))
      · -- The residue map is always surjective by construction.
        simpa [IsLocalRing.residue] using
          (Ideal.Quotient.mk_surjective (R := Λ) (I := maximalIdeal Λ))
  -- Upgrade the residue-field ring equivalence to a `k`-algebra equivalence.
  exact AlgEquiv.ofRingEquiv (f := eRing) fun r ↦ by
    change residue Λ ((algebraMap k Λ) r) = algebraMap k (ResidueField Λ) r
    rfl

/-- Helper for Lemma 16.11.1: if each element of `Λ` is controlled by finitely many residue-field
coefficients, then a monotone seeded stage family has supremum `⊤`. -/
lemma iSup_seededFgIntermediateField_eq_top_of_coefficients
    {F₀ : IntermediateField k (ResidueField Λ)} (hF₀ : F₀.FG)
    (S : SeededFgIntermediateField (k := k) (Λ := Λ) F₀ → Subalgebra k Λ)
    (hmono : Monotone S)
    (hcoeff :
      ∀ x : Λ,
        ∃ s : Finset (ResidueField Λ),
          ∀ ⦃F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀⦄,
            (↑s : Set (ResidueField Λ)) ⊆ (F : IntermediateField k (ResidueField Λ)) →
              x ∈ S F) :
    iSup S = (⊤ : Subalgebra k Λ) := by
  let hdir :=
    directed_subalgebraFamily_of_seededFgIntermediateField (k := k) (Λ := Λ) (F₀ := F₀) hmono
  -- To show the supremum is `⊤`, place an arbitrary element of `Λ` in one sufficiently large
  -- finitely generated residue-field stage.
  refine top_unique ?_
  intro x hx
  rcases hcoeff x with ⟨s, hs⟩
  rcases
      exists_seededFgIntermediateField_of_finset (k := k) (Λ := Λ) hF₀ s with
    ⟨F, hFs⟩
  have hxF : x ∈ S F := hs hFs
  exact (le_iSup S F) hxF

/-- Helper for Lemma 16.11.1: if all coefficients of a residue-field polynomial already lie in an
intermediate field `F`, then the polynomial descends to coefficients in `F`. -/
noncomputable def mvPolynomialDescendToIntermediateField
    {σ : Type*} (F : IntermediateField k (ResidueField Λ))
    (p : MvPolynomial σ (ResidueField Λ))
    (hp : ∀ d, p.coeff d ∈ F) :
    MvPolynomial σ F :=
  p.support.sum fun d ↦ MvPolynomial.monomial d ⟨p.coeff d, hp d⟩

/-- Helper for Lemma 16.11.1: mapping a descended intermediate-field polynomial back to the
ambient residue field recovers the original polynomial. -/
lemma mvPolynomial_map_descendToIntermediateField
    {σ : Type*} (F : IntermediateField k (ResidueField Λ))
    (p : MvPolynomial σ (ResidueField Λ))
    (hp : ∀ d, p.coeff d ∈ F) :
    MvPolynomial.map (algebraMap F (ResidueField Λ))
        (mvPolynomialDescendToIntermediateField (k := k) (Λ := Λ) F p hp) = p := by
  -- Compare coefficients term-by-term; on and off the support, the descended polynomial has the
  -- same coefficients as the original one.
  ext d
  by_cases hd : d ∈ p.support
  · simp [mvPolynomialDescendToIntermediateField, hd]
  · have hcoeff_zero : p.coeff d = 0 := by
      by_contra hne
      exact hd ((MvPolynomial.mem_support_iff).2 hne)
    simp [mvPolynomialDescendToIntermediateField, hcoeff_zero]

/-- Helper for Lemma 16.11.1: if every coefficient of a residue-field polynomial lies in an
intermediate field `F`, then evaluating the polynomial in `Λ` already lands in the evaluation
range of the `F`-coefficient polynomial algebra. -/
lemma polynomialEval_mem_range_of_coefficients
    {d : ℕ} (σ : ResidueField Λ →+* Λ) (lambda : Fin d → Λ)
    (F : IntermediateField k (ResidueField Λ))
    (p : MvPolynomial (Fin d) (ResidueField Λ))
    (hp : ∀ m, p.coeff m ∈ F) :
    MvPolynomial.eval₂Hom σ lambda p ∈
      RingHom.range
        (MvPolynomial.eval₂Hom
          (σ.comp (algebraMap F (ResidueField Λ))) lambda) := by
  classical
  refine
    ⟨mvPolynomialDescendToIntermediateField (k := k) (Λ := Λ) F p hp, ?_⟩
  -- Evaluate after descending coefficients and compare with the original polynomial via `map`.
  have hmap :
      MvPolynomial.map (algebraMap F (ResidueField Λ))
          (mvPolynomialDescendToIntermediateField (k := k) (Λ := Λ) F p hp) =
        p :=
    mvPolynomial_map_descendToIntermediateField (k := k) (Λ := Λ) F p hp
  simpa [RingHom.comp_apply] using
    congrArg (MvPolynomial.eval₂Hom σ lambda) hmap

/-- Helper for Lemma 16.11.1: once the ambient residue-field polynomial evaluation map is
surjective, each element of `Λ` is controlled by finitely many residue-field coefficients. -/
lemma exists_coefficientFinset_for_surjectivePolynomialEval
    {d : ℕ} (σ : ResidueField Λ →+* Λ) (lambda : Fin d → Λ)
    (hsurj : Function.Surjective (MvPolynomial.eval₂Hom σ lambda))
    (x : Λ) :
    ∃ s : Finset (ResidueField Λ),
      ∀ {F : IntermediateField k (ResidueField Λ)},
        (↑s : Set (ResidueField Λ)) ⊆ F →
          x ∈ RingHom.range
            (MvPolynomial.eval₂Hom
              (σ.comp (algebraMap F (ResidueField Λ))) lambda) := by
  classical
  rcases hsurj x with ⟨p, rfl⟩
  let s : Finset (ResidueField Λ) :=
    p.support.image fun m ↦ p.coeff m
  refine ⟨s, ?_⟩
  intro F hs
  -- Off the support the coefficient is zero, while supported coefficients lie in the chosen set.
  refine
    polynomialEval_mem_range_of_coefficients
      (k := k) (Λ := Λ) (σ := σ) (lambda := lambda) F p ?_
  intro m
  by_cases hm : m ∈ p.support
  · exact hs (Finset.mem_image.2 ⟨m, hm, rfl⟩)
  · have hcoeff_zero : p.coeff m = 0 := by
      exact by
        contrapose! hm
        exact MvPolynomial.mem_support_iff.2 hm
    simpa [hcoeff_zero] using (show (0 : ResidueField Λ) ∈ F from F.zero_mem)

/-- Helper for Lemma 16.11.1: finitely many residue-field polynomials descend simultaneously to
one finitely generated intermediate field above a chosen seed field. -/
lemma exists_seededFgIntermediateField_of_polynomialFamily
    {F₀ : IntermediateField k (ResidueField Λ)} (hF₀ : F₀.FG)
    {σ : Type*} {n : ℕ} (g : Fin n → MvPolynomial σ (ResidueField Λ)) :
    ∃ F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀,
      ∃ gF : Fin n → MvPolynomial σ (F : IntermediateField k (ResidueField Λ)),
        ∀ i,
          MvPolynomial.map
              (algebraMap (F : IntermediateField k (ResidueField Λ)) (ResidueField Λ))
              (gF i) =
            g i := by
  classical
  let s : Finset (ResidueField Λ) :=
    Finset.univ.biUnion fun i : Fin n ↦ ((g i).support.image fun d ↦ (g i).coeff d)
  rcases
      exists_seededFgIntermediateField_of_finset (k := k) (Λ := Λ) hF₀ s with
    ⟨F, hFs⟩
  refine ⟨F, ?_⟩
  refine ⟨fun i ↦
      mvPolynomialDescendToIntermediateField (k := k) (Λ := Λ)
        (F : IntermediateField k (ResidueField Λ)) (g i) (fun d ↦ by
          by_cases hd : d ∈ (g i).support
          · -- Support coefficients were inserted into the global finite coefficient set `s`.
            exact
              hFs <|
                Finset.mem_biUnion.2 <|
                  ⟨i, Finset.mem_univ i, Finset.mem_image.2 ⟨d, hd, rfl⟩⟩
          · -- Off the support, the coefficient is zero, hence lies in every intermediate field.
            have hcoeff_zero : (g i).coeff d = 0 := by
              exact by
                contrapose! hd
                exact MvPolynomial.mem_support_iff.2 hd
            simpa [hcoeff_zero]), ?_⟩
  · intro i
    -- Each descended polynomial maps back to the original coefficient family by construction.
    exact
      mvPolynomial_map_descendToIntermediateField (k := k) (Λ := Λ)
        (F : IntermediateField k (ResidueField Λ)) (g i) _

/-- Helper for Lemma 16.11.1: once a polynomial evaluation map to `Λ` is fixed, its kernel ideal
is generated by finitely many residue-field polynomials, and those generators descend
simultaneously to one seeded finitely generated intermediate field. -/
lemma existsSeededPolynomialKernelData
    {F₀ : IntermediateField k (ResidueField Λ)} (hF₀ : F₀.FG)
    {d : ℕ} (σ : ResidueField Λ →+* Λ) (lambda : Fin d → Λ) :
    ∃ n : ℕ,
      ∃ g : Fin n → MvPolynomial (Fin d) (ResidueField Λ),
        Ideal.span (Set.range g) = RingHom.ker (MvPolynomial.eval₂Hom σ lambda) ∧
          ∃ F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀,
            ∃ gF : Fin n → MvPolynomial (Fin d) (F : IntermediateField k (ResidueField Λ)),
              ∀ i,
                MvPolynomial.map
                    (algebraMap (F : IntermediateField k (ResidueField Λ))
                      (ResidueField Λ))
                    (gF i) =
                  g i := by
  let Ψ : MvPolynomial (Fin d) (ResidueField Λ) →+* Λ :=
    MvPolynomial.eval₂Hom σ lambda
  have hker_fg : (RingHom.ker Ψ).FG := by
    -- The polynomial ring is Noetherian, so the evaluation kernel has a finite generating family.
    exact Ideal.fg_of_isNoetherianRing (RingHom.ker Ψ)
  rcases (Submodule.fg_iff_exists_fin_generating_family).mp hker_fg with ⟨n, gker, hgker⟩
  let g : Fin n → MvPolynomial (Fin d) (ResidueField Λ) := fun i ↦ (gker i : _)
  obtain ⟨F, gF, hgF⟩ :=
    exists_seededFgIntermediateField_of_polynomialFamily
      (k := k) (Λ := Λ) hF₀ g
  refine ⟨n, g, ?_, F, gF, hgF⟩
  -- Forget the kernel subtype after fixing the finite generating family.
  simpa [g, Ψ] using hgker

/-- Helper for Lemma 16.11.1: quotienting the residue-field polynomial algebra by the kernel of
the evaluation map identifies it with the corresponding image subring in `Λ`. This isolates the
first-isomorphism transport needed later when quotient presentations are compared with concrete
stages inside `Λ`. -/
noncomputable def polynomialEval_quotientKerRingEquivRange
    {d : ℕ} (σ : ResidueField Λ →+* Λ) (lambda : Fin d → Λ) :
    (MvPolynomial (Fin d) (ResidueField Λ) ⧸
        RingHom.ker (MvPolynomial.eval₂Hom σ lambda)) ≃+*
      RingHom.range (MvPolynomial.eval₂Hom σ lambda) := by
  -- The quotient-to-image comparison is the standard ring-homomorphism first isomorphism theorem.
  exact RingHom.quotientKerEquivRange (MvPolynomial.eval₂Hom σ lambda)

/-- Helper for Lemma 16.11.1: once the source-faithful coefficient-control step produces a
monotone seeded family of stages with the desired local properties, the final directed-union
theorem is just packaging. -/
lemma exists_artinianLocalSubalgebraApproximation_of_seededFamily
    {F₀ : IntermediateField k (ResidueField Λ)} (hF₀ : F₀.FG)
    (S : SeededFgIntermediateField (k := k) (Λ := Λ) F₀ → Subalgebra k Λ)
    (hmono : Monotone S)
    (hArtinian : ∀ F, IsArtinianRing (S F))
    (hLocal : ∀ F, IsLocalRing (S F))
    (hFlat : ∀ F, Module.Flat (S F) Λ)
    (hMaximal :
      ∀ F, let _ : IsLocalRing (S F) := hLocal F;
        Ideal.map (algebraMap (S F) Λ) (maximalIdeal (S F)) = maximalIdeal Λ)
    (hEssFiniteType : ∀ F, Algebra.EssFiniteType k (S F))
    (hcoeff :
      ∀ x : Λ,
        ∃ s : Finset (ResidueField Λ),
          ∀ ⦃F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀⦄,
            (↑s : Set (ResidueField Λ)) ⊆ (F : IntermediateField k (ResidueField Λ)) →
              x ∈ S F) :
    ∃ (ι : Type (max u v)) (S' : ι → Subalgebra k Λ) (hdir : Directed (· ≤ ·) S')
      (hArtinian' : ∀ i, IsArtinianRing (S' i))
      (hLocal' : ∀ i, IsLocalRing (S' i))
      (hFlat' : ∀ i, Module.Flat (S' i) Λ)
      (hMaximal' : ∀ i, let _ : IsLocalRing (S' i) := hLocal' i;
        Ideal.map (algebraMap (S' i) Λ) (maximalIdeal (S' i)) = maximalIdeal Λ)
      (hEssFiniteType' : ∀ i, Algebra.EssFiniteType k (S' i)),
      iSup S' = (⊤ : Subalgebra k Λ) := by
  let hdir :=
    directed_subalgebraFamily_of_seededFgIntermediateField (k := k) (Λ := Λ) (F₀ := F₀) hmono
  let S' : ULift (SeededFgIntermediateField (k := k) (Λ := Λ) F₀) → Subalgebra k Λ :=
    fun F ↦ S F.down
  have hdir' : Directed (· ≤ ·) S' := by
    intro F G
    rcases hdir F.down G.down with ⟨H, hFH, hGH⟩
    exact ⟨⟨H⟩, hFH, hGH⟩
  refine
    ⟨ULift (SeededFgIntermediateField (k := k) (Λ := Λ) F₀), S', hdir',
      (fun F ↦ hArtinian F.down), (fun F ↦ hLocal F.down), (fun F ↦ hFlat F.down),
      (fun F ↦ by
        let _ : IsLocalRing (S' F) := hLocal F.down
        simpa [S'] using hMaximal F.down),
      (fun F ↦ hEssFiniteType F.down), ?_⟩
  -- The remaining top-supremum statement is exactly the coefficient-control criterion above.
  refine top_unique ?_
  intro x hx
  rcases hcoeff x with ⟨s, hs⟩
  rcases
      exists_seededFgIntermediateField_of_finset (k := k) (Λ := Λ) hF₀ s with
    ⟨F, hFs⟩
  have hxF : x ∈ S' ⟨F⟩ := hs hFs
  exact (le_iSup S' ⟨F⟩) hxF

/-- Helper for Lemma 16.11.1: the remaining source-faithful step is to build one monotone seeded
family of finite-type Artinian local stages from the residue-field section and the
finite-dimensional cotangent-homology hypothesis. -/
lemma existsSeededApproximationFamily_of_maximalIdeal_eq_bot
    (hmax : maximalIdeal Λ = ⊥)
    (σ : ResidueField Λ →+* Λ)
    (hσ : (residue Λ).comp σ = RingHom.id (ResidueField Λ)) :
    ∃ F₀ : IntermediateField k (ResidueField Λ),
      F₀.FG ∧
        ∃ S : SeededFgIntermediateField (k := k) (Λ := Λ) F₀ → Subalgebra k Λ,
          Monotone S ∧
            (∀ F, IsArtinianRing (S F)) ∧
            ∃ hLocal : ∀ F, IsLocalRing (S F),
              (∀ F, Module.Flat (S F) Λ) ∧
              (∀ F, let _ : IsLocalRing (S F) := hLocal F;
                Ideal.map (algebraMap (S F) Λ) (maximalIdeal (S F)) = maximalIdeal Λ) ∧
              (∀ F, Algebra.EssFiniteType k (S F)) ∧
              ∀ x' : Λ,
                ∃ s : Finset (ResidueField Λ),
                  ∀ ⦃F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀⦄,
                    (↑s : Set (ResidueField Λ)) ⊆ (F : IntermediateField k (ResidueField Λ)) →
                      x' ∈ S F := by
  letI : Field Λ := IsField.toField <|
    (IsLocalRing.isField_iff_maximalIdeal_eq).mpr hmax
  let e := residueFieldAlgEquivOfMaximalIdealEqBot (k := k) (Λ := Λ) hmax
  let stage :
      SeededFgIntermediateField (k := k) (Λ := Λ) (⊥ : IntermediateField k (ResidueField Λ)) →
        IntermediateField k Λ :=
    fun F ↦ ((F : IntermediateField k (ResidueField Λ)).map e.symm.toAlgHom)
  refine ⟨⊥, ?_, ?_⟩
  · -- The bottom intermediate field is finitely generated: it is generated by the empty set.
    simpa using
      (IntermediateField.fg_adjoin_finset (F := k) (E := ResidueField Λ)
        (t := (∅ : Finset (ResidueField Λ))))
  · refine ⟨fun F ↦ (stage F).toSubalgebra, ?_⟩
    refine ⟨?_, ?_⟩
    · intro F G hFG
      intro x hx
      -- Move membership through the residue-field equivalence and enlarge the controlling field.
      change x ∈ ((G : IntermediateField k (ResidueField Λ)).toSubalgebra.map e.symm.toAlgHom)
      change x ∈ ((F : IntermediateField k (ResidueField Λ)).toSubalgebra.map e.symm.toAlgHom) at hx
      rcases Subalgebra.mem_map.mp hx with ⟨y, hy, rfl⟩
      exact Subalgebra.mem_map.mpr ⟨y, hFG hy, rfl⟩
    · refine ⟨?_, ?_⟩
      · intro F
        -- Each stage is a field, hence Artinian.
        let T : IntermediateField k Λ := stage F
        change IsArtinianRing ↥T
        infer_instance
      · refine ⟨?_, ?_⟩
        · intro F
          -- Each stage is a field, hence local.
          let T : IntermediateField k Λ := stage F
          change IsLocalRing ↥T
          infer_instance
        · refine ⟨?_, ?_, ?_, ?_⟩
          · intro F
            -- Modules over a field are flat, so the stage inclusion is flat.
            let T : IntermediateField k Λ := stage F
            change Module.Flat ↥T Λ
            infer_instance
          · intro F
            -- In the field case, both source and target maximal ideals are zero.
            let T : IntermediateField k Λ := stage F
            let _ : IsLocalRing ↥T := inferInstance
            change Ideal.map (algebraMap ↥T Λ) (maximalIdeal ↥T) = maximalIdeal Λ
            have hbotT : maximalIdeal ↥T = ⊥ := by
              exact IsLocalRing.isField_iff_maximalIdeal_eq.mp (Field.toIsField ↥T)
            rw [hbotT, hmax]
            simp
          · intro F
            -- The mapped stage is algebra-equivalent to the finitely generated field `F`.
            let T : IntermediateField k Λ := stage F
            let eT : ↥T ≃ₐ[k] ↥(F : IntermediateField k (ResidueField Λ)) :=
              (IntermediateField.equivMap (F : IntermediateField k (ResidueField Λ))
                e.symm.toAlgHom).symm
            change Algebra.EssFiniteType k ↥T
            exact
              (Algebra.EssFiniteType.iff_of_algEquiv eT).2
                ((IntermediateField.essFiniteType_iff).2 F.2.2)
          · intro x'
            -- A field stage containing the single residue coefficient `residue x'` already
            -- contains the element `x'`.
            refine ⟨{e x'}, ?_⟩
            intro F hs
            change x' ∈ ((F : IntermediateField k (ResidueField Λ)).toSubalgebra.map e.symm.toAlgHom)
            have hxF : e x' ∈ (F : IntermediateField k (ResidueField Λ)) := hs (by simp)
            exact Subalgebra.mem_map.mpr ⟨e x', hxF, by simp⟩

/-- Helper for Lemma 16.11.1: the maximal ideal of an Artinian local algebra admits a finite
generating family. -/
lemma existsFiniteMaximalIdealGeneratingFamily :
    ∃ d : ℕ, ∃ lambda : Fin d → Λ, Ideal.span (Set.range lambda) = maximalIdeal Λ := by
  -- Proof comment: Artinian rings are Noetherian, so the maximal ideal is finitely generated.
  exact
    Submodule.fg_iff_exists_fin_generating_family.mp
      (Ideal.fg_of_isNoetherianRing (maximalIdeal Λ))

/-- Helper for Lemma 16.11.1: the remaining blocker is the nonfield branch of the source-proof
induction, where one must build the seeded approximation family after fixing a residue-field
section. -/
lemma existsSeededApproximationFamily_of_nontrivialMaximalIdeal
    [FiniteDimensional (ResidueField Λ) (Algebra.H1Cotangent k (ResidueField Λ))]
    (hmax : maximalIdeal Λ ≠ ⊥)
    (σ : ResidueField Λ →+* Λ)
    (hσ : (residue Λ).comp σ = RingHom.id (ResidueField Λ)) :
    ∃ F₀ : IntermediateField k (ResidueField Λ),
      F₀.FG ∧
        ∃ S : SeededFgIntermediateField (k := k) (Λ := Λ) F₀ → Subalgebra k Λ,
          Monotone S ∧
            (∀ F, IsArtinianRing (S F)) ∧
            ∃ hLocal : ∀ F, IsLocalRing (S F),
              (∀ F, Module.Flat (S F) Λ) ∧
              (∀ F, let _ : IsLocalRing (S F) := hLocal F;
                Ideal.map (algebraMap (S F) Λ) (maximalIdeal (S F)) = maximalIdeal Λ) ∧
              (∀ F, Algebra.EssFiniteType k (S F)) ∧
              ∀ x' : Λ,
                ∃ s : Finset (ResidueField Λ),
                  ∀ ⦃F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀⦄,
                    (↑s : Set (ResidueField Λ)) ⊆ (F : IntermediateField k (ResidueField Λ)) →
                      x' ∈ S F := by
  -- Route correction: the old constant-stage proof used `S F = ⊤`, which cannot supply
  -- `Algebra.EssFiniteType k (S F)` in the nonfield case and was only a placeholder.
  obtain ⟨n, hn⟩ := (isArtinianRing_iff_isNilpotent_maximalIdeal Λ).mp inferInstance
  have hn_ne_zero : n ≠ 0 := by
    intro h0
    have htop : (⊤ : Ideal Λ) = ⊥ := by
      simpa [h0] using hn
    have hmax_bot : maximalIdeal Λ = ⊥ := by
      exact
        le_antisymm
          (by
            calc
              maximalIdeal Λ ≤ ⊤ := le_top
              _ = ⊥ := htop)
          bot_le
    exact hmax hmax_bot
  have hn_ne_one : n ≠ 1 := by
    intro h1
    exact hmax (by simpa [h1] using hn)
  have hr_ex : ∃ r : ℕ, n = r + 2 := by
    have htwo : 2 ≤ n := by
      omega
    have hr' : n = (n - 2) + 2 := by
      omega
    exact ⟨n - 2, hr'⟩
  rcases hr_ex with ⟨r, hr : n = r + 2⟩
  obtain ⟨d, lambda, hlambda⟩ :=
    existsFiniteMaximalIdealGeneratingFamily (Λ := Λ)
  obtain ⟨ι, _, x, hx, J, hJ⟩ :=
    existsFiniteKernelCoordinateSetForPBasis (k := k) (Λ := Λ)
  let F₀ : IntermediateField k (ResidueField Λ) :=
    IntermediateField.adjoin k (↑(J.image x) : Set (ResidueField Λ))
  have hF₀ : F₀.FG := by
    -- Proof comment: the finite kernel-support set from the Jacobi-Zariski argument generates
    -- the seed residue subfield used in the source proof.
    simpa [F₀] using
      (IntermediateField.fg_adjoin_finset
        (F := k) (E := ResidueField Λ) (t := J.image x))
  have hlayer :
      let Iq : Ideal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) :=
        Ideal.map (Ideal.Quotient.mk (maximalIdeal Λ ^ (r + 2))) (maximalIdeal Λ ^ (r + 1))
      Iq ≤ maximalIdeal (Λ ⧸ maximalIdeal Λ ^ (r + 2)) ∧ Iq ^ 2 = ⊥ := by
    -- Proof comment: the successor quotient step is square-zero, so the derivation-correction API
    -- above applies once the quotient-stage seeded family is constructed.
    exact maximalIdealPowerQuotientLayer_squareZeroData (Λ := Λ) r
  obtain ⟨σq, hσq⟩ :=
    existsResidueFieldSection_maximalIdealPowerQuotient (Λ := Λ) r
  -- TODO: finish the source-faithful induction step. The fixed data above isolate the true
  -- remaining work:
  -- 1. apply the theorem recursively to the quotient `Λ ⧸ maximalIdeal Λ ^ (r + 2)`,
  -- 2. use `hJ` to restrict the derivation correction to the finite seed field `F₀`,
  -- 3. descend finitely many kernel generators with `existsSeededPolynomialKernelData`,
  -- 4. package the resulting monotone family via
  --    `exists_artinianLocalSubalgebraApproximation_of_seededFamily`.
  let _ := hn
  let _ := hn_ne_one
  let _ := hr
  let _ := d
  let _ := lambda
  let _ := hlambda
  let _ := hx
  let _ := hJ
  let _ := hF₀
  let _ := hlayer
  let _ := σ
  let _ := hσ
  let _ := σq
  let _ := hσq
  sorry

/-- Helper for Lemma 16.11.1: the remaining source-faithful step is to build one monotone seeded
family of finite-type Artinian local stages from the residue-field section and the
finite-dimensional cotangent-homology hypothesis. -/
lemma existsSeededApproximationFamily
    [FiniteDimensional (ResidueField Λ) (Algebra.H1Cotangent k (ResidueField Λ))]
    (σ : ResidueField Λ →+* Λ)
    (hσ : (residue Λ).comp σ = RingHom.id (ResidueField Λ)) :
    ∃ F₀ : IntermediateField k (ResidueField Λ),
      F₀.FG ∧
        ∃ S : SeededFgIntermediateField (k := k) (Λ := Λ) F₀ → Subalgebra k Λ,
          Monotone S ∧
            (∀ F, IsArtinianRing (S F)) ∧
            ∃ hLocal : ∀ F, IsLocalRing (S F),
              (∀ F, Module.Flat (S F) Λ) ∧
              (∀ F, let _ : IsLocalRing (S F) := hLocal F;
                Ideal.map (algebraMap (S F) Λ) (maximalIdeal (S F)) = maximalIdeal Λ) ∧
              (∀ F, Algebra.EssFiniteType k (S F)) ∧
              ∀ x : Λ,
                ∃ s : Finset (ResidueField Λ),
                  ∀ ⦃F : SeededFgIntermediateField (k := k) (Λ := Λ) F₀⦄,
                    (↑s : Set (ResidueField Λ)) ⊆ (F : IntermediateField k (ResidueField Λ)) →
                      x ∈ S F := by
  by_cases hmax : maximalIdeal Λ = ⊥
  · -- In the field case, the earlier helper already builds the entire seeded family.
    exact existsSeededApproximationFamily_of_maximalIdeal_eq_bot
      (k := k) (Λ := Λ) hmax σ hσ
  · -- Route correction: isolate the unresolved source-faithful induction to the nonfield branch.
    exact existsSeededApproximationFamily_of_nontrivialMaximalIdeal
      (k := k) (Λ := Λ) hmax σ hσ

/-- Helper for Lemma 16.11.1: once the source-faithful coefficient-control induction is installed
for a chosen residue-field section, the remaining directed stage construction yields the required
Artinian local approximation family. -/
lemma exists_artinianLocalSubalgebraApproximation_of_residueField_section
    [FiniteDimensional (ResidueField Λ) (Algebra.H1Cotangent k (ResidueField Λ))]
    (σ : ResidueField Λ →+* Λ)
    (hσ : (residue Λ).comp σ = RingHom.id (ResidueField Λ)) :
    ∃ (ι : Type (max u v)) (S : ι → Subalgebra k Λ) (hdir : Directed (· ≤ ·) S)
      (hArtinian : ∀ i, IsArtinianRing (S i))
      (hLocal : ∀ i, IsLocalRing (S i))
      (hFlat : ∀ i, Module.Flat (S i) Λ)
      (hMaximal : ∀ i, let _ : IsLocalRing (S i) := hLocal i;
        Ideal.map (algebraMap (S i) Λ) (maximalIdeal (S i)) = maximalIdeal Λ)
      (hEssFiniteType : ∀ i, Algebra.EssFiniteType k (S i)),
      iSup S = (⊤ : Subalgebra k Λ) := by
  -- Route correction: the public helper now splits into a source-faithful existence statement for
  -- the seeded stage family, followed by a separate packaging lemma that turns coefficient control
  -- into the final directed approximation family.
  rcases
      existsSeededApproximationFamily (k := k) (Λ := Λ) σ hσ with
    ⟨F₀, hF₀, S', hmono, hArtinian, hLocal, hFlat, hMaximal, hEssFiniteType, hcoeff⟩
  -- Once the seeded family is available, the rest is just the directed-supremum packaging.
  exact
    exists_artinianLocalSubalgebraApproximation_of_seededFamily
      (k := k) (Λ := Λ) hF₀ S' hmono hArtinian hLocal hFlat hMaximal hEssFiniteType hcoeff

/-- Lemma 16.11.1: let `k` be a field of characteristic `p > 0` and let `Λ` be an Artinian local
`k`-algebra. If the first cotangent homology `H_1(L_{K/k})` of the residue field
`K = ResidueField Λ` is finite-dimensional over `K`, then `Λ` is the directed union, equivalently
the filtered colimit, of Artinian local `k`-subalgebras `A ⊆ Λ` such that each inclusion
`A → Λ` is flat, the extended maximal ideal of `A` is the maximal ideal of `Λ`, and `A` is
essentially of finite type over `k`. -/
theorem exists_artinianLocalSubalgebraApproximation
    [FiniteDimensional (ResidueField Λ) (Algebra.H1Cotangent k (ResidueField Λ))] :
    ∃ (ι : Type (max u v)) (S : ι → Subalgebra k Λ) (hdir : Directed (· ≤ ·) S)
      (hArtinian : ∀ i, IsArtinianRing (S i))
      (hLocal : ∀ i, IsLocalRing (S i))
      (hFlat : ∀ i, Module.Flat (S i) Λ)
      (hMaximal : ∀ i, let _ : IsLocalRing (S i) := hLocal i;
        Ideal.map (algebraMap (S i) Λ) (maximalIdeal (S i)) = maximalIdeal Λ)
      (hEssFiniteType : ∀ i, Algebra.EssFiniteType k (S i)),
      iSup S = (⊤ : Subalgebra k Λ) := by
  have hsection :
      ∃ σ : ResidueField Λ →+* Λ, (residue Λ).comp σ = RingHom.id (ResidueField Λ) := by
    by_cases hzero : ringChar k = 0
    · letI : CharZero k := (CharP.ringChar_zero_iff_CharZero k).1 hzero
      have hnil : IsNilpotent (maximalIdeal Λ) :=
        (isArtinianRing_iff_isNilpotent_maximalIdeal Λ).mp inferInstance
      rcases hnil with ⟨n, hn⟩
      have hcomplete :
          IsAdicComplete (maximalIdeal Λ) Λ := by
        -- Nilpotence of the maximal ideal forces the adic filtration to stabilize at zero.
        refine isAdicComplete_of_pow_smul_top_eq_bot (I := maximalIdeal Λ) (Q := Λ) n ?_
        calc
          maximalIdeal Λ ^ n • (⊤ : Submodule Λ Λ) =
              Submodule.restrictScalars Λ
                (Ideal.map (algebraMap Λ Λ) (maximalIdeal Λ ^ n)) := by
                  simpa using (Ideal.smul_top_eq_map (maximalIdeal Λ ^ n))
          _ = Ideal.map (algebraMap Λ Λ) (maximalIdeal Λ ^ n) := by
                rfl
          _ = maximalIdeal Λ ^ n := by
                simp
          _ = ⊥ := hn
      letI : IsCompleteLocalRing Λ := { toIsAdicComplete := hcomplete }
      letI : Algebra.IsSeparableOver k (ResidueField Λ) :=
        Algebra.isSeparableOver_of_charZero (k := k) (K := ResidueField Λ)
      obtain ⟨σ, hσ⟩ :=
        exists_residueField_section_of_isCompleteLocalRing_of_isSeparableOver (A := Λ) k
      exact ⟨σ.toRingHom, by simpa using hσ⟩
    · letI : CharP k (ringChar k) := inferInstance
      have hprime : (ringChar k).Prime := CharP.char_prime_of_ne_zero k hzero
      letI : Fact (ringChar k).Prime := ⟨hprime⟩
      letI : CharP Λ (ringChar k) :=
        charP_of_injective_algebraMap (algebraMap k Λ).injective (ringChar k)
      exact exists_residueField_section_of_artinianLocal_charP (Λ := Λ) (p := ringChar k)
  -- Route correction: isolate the genuinely missing source step to the coefficient-control
  -- induction. The residue-field section exists formally from nilpotence of the maximal ideal.
  obtain ⟨σ, hσ⟩ := hsection
  -- With a section fixed, the remainder is exactly the stage-construction package encoded in the
  -- helper above.
  exact
    exists_artinianLocalSubalgebraApproximation_of_residueField_section
      (k := k) (Λ := Λ) σ hσ

end

