/-- Helper for Lemma 16.10.2: multiplying each localized generator by an element inverted at `q`
does not change the parameter ideal. -/
lemma parameterIdeal_eq_of_rescaled_generators
    {d : ℕ}
    (x y : Fin d → maximalIdeal Λq)
    (hxy : ∀ i, ∃ s : q.asIdeal.primeCompl, (y i : Λq) = algebraMap Λ Λq (s : Λ) * x i) :
    parameterIdeal y = parameterIdeal x := by
  apply le_antisymm
  · -- Each rescaled generator of `y` already lies in the ideal generated by `x`.
    rw [parameterIdeal_eq_span, parameterIdeal_eq_span, Ideal.span_le]
    intro z hz
    rcases hz with ⟨i, rfl⟩
    rcases hxy i with ⟨s, hs⟩
    simpa [hs] using (parameterIdeal x).mul_mem_left (algebraMap Λ Λq (s : Λ)) <| by
      rw [parameterIdeal_eq_span]
      exact Ideal.subset_span ⟨i, rfl⟩
  · -- Because `s` becomes a unit after localization, the original generator lies in the ideal
    -- generated by the rescaled one as well.
    rw [parameterIdeal_eq_span, parameterIdeal_eq_span, Ideal.span_le]
    intro z hz
    rcases hz with ⟨i, rfl⟩
    rcases hxy i with ⟨s, hs⟩
    rcases IsLocalization.map_units Λq s with ⟨u, hu⟩
    have hy_mem : (y i : Λq) ∈ parameterIdeal y := by
      rw [parameterIdeal_eq_span]
      exact Ideal.subset_span ⟨i, rfl⟩
    have hu_mem : ((↑u⁻¹ : Λq) * (y i : Λq)) ∈ parameterIdeal y :=
      (parameterIdeal y).mul_mem_left _ hy_mem
    have hx_eq : (x i : Λq) = (↑u⁻¹ : Λq) * (y i : Λq) := by
      calc
        (x i : Λq) = (↑u⁻¹ : Λq) * ((u : Λq) * x i) := by
          simp
        _ = (↑u⁻¹ : Λq) * (y i : Λq) := by
          rw [hu, hs]
    simpa [hx_eq] using hu_mem

/-- Helper for Lemma 16.10.2: after choosing a regular system of parameters in the localization,
one can clear denominators so that the chosen lifts have their fixed `n`-th powers in `I`. -/
lemma exists_regular_parameters_with_pow_mem_ideal
    (I : Ideal Λ) (n d : ℕ)
    (hn : 0 < n)
    (hqpow : Ideal.map (algebraMap Λ Λq) (q.asIdeal ^ n) ≤ Ideal.map (algebraMap Λ Λq) I)
    [IsNoetherianRing Λ]
    [IsRegularLocalRing Λq]
    (hdim : ringKrullDim Λq = d) :
    ∃ (π : Fin d → Λ) (hπ : ∀ i, algebraMap Λ Λq (π i) ∈ maximalIdeal Λq),
      IsRegularSystemOfParameters (fun i ↦ ⟨algebraMap Λ Λq (π i), hπ i⟩) ∧
        ∀ i, π i ^ n ∈ I := by
  classical
  -- Choose a regular system of parameters in the localized regular local ring.
  obtain ⟨x, hx⟩ :=
    (isRegularLocalRing_iff_exists_regularSystemOfParameters
      (R := Λq) (d := d) hdim).1 inferInstance
  choose a s hs using fun i : Fin d ↦
    IsLocalization.exists_mk'_eq q.asIdeal.primeCompl (x i : Λq)
  have hxpowI :
      ∀ i,
        IsLocalization.mk' Λq (a i ^ n) (s i ^ n) ∈ Ideal.map (algebraMap Λ Λq) I := by
    intro i
    have hxpowq : (x i : Λq) ^ n ∈ Ideal.map (algebraMap Λ Λq) (q.asIdeal ^ n) := by
      rw [Ideal.map_pow, IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal Λq]
      exact Ideal.pow_mem_pow (x i).2 n
    have hxpowI' : (x i : Λq) ^ n ∈ Ideal.map (algebraMap Λ Λq) I := hqpow hxpowq
    have hpow_eq : IsLocalization.mk' Λq (a i ^ n) (s i ^ n) = (x i : Λq) ^ n := by
      rw [← hs i]
      rw [IsLocalization.mk'_pow]
    exact hpow_eq.symm ▸ hxpowI'
  have hclear :
      ∀ i, ∃ t : q.asIdeal.primeCompl, (t : Λ) * (a i ^ n) ∈ I := by
    intro i
    obtain ⟨t, ht, htI⟩ :=
      (IsLocalization.mk'_mem_map_algebraMap_iff
        q.asIdeal.primeCompl Λq I (a i ^ n) (s i ^ n)).1 (hxpowI i)
    exact ⟨⟨t, ht⟩, htI⟩
  choose t ht using hclear
  let π : Fin d → Λ := fun i ↦ (t i : Λ) * a i
  have hπ_factor :
      ∀ i, algebraMap Λ Λq (π i) = algebraMap Λ Λq ((t i : Λ) * (s i : Λ)) * x i := by
    intro i
    calc
      algebraMap Λ Λq (π i) = algebraMap Λ Λq (t i : Λ) * algebraMap Λ Λq (a i) := by
        simp [π]
      _ = algebraMap Λ Λq (t i : Λ) * (algebraMap Λ Λq (s i : Λ) * x i) := by
        rw [← hs i, IsLocalization.mk'_spec' Λq (a i) (s i)]
      _ = algebraMap Λ Λq ((t i : Λ) * (s i : Λ)) * x i := by
        simp [mul_left_comm, mul_comm]
  have hπ_mem : ∀ i, algebraMap Λ Λq (π i) ∈ maximalIdeal Λq := by
    intro i
    have hmem_param : algebraMap Λ Λq (π i) ∈ parameterIdeal x := by
      rw [hπ_factor i]
      exact (parameterIdeal x).mul_mem_left _ <| by
        rw [parameterIdeal_eq_span]
        exact Ideal.subset_span ⟨i, rfl⟩
    exact hx.2 ▸ hmem_param
  let y : Fin d → maximalIdeal Λq := fun i ↦ ⟨algebraMap Λ Λq (π i), hπ_mem i⟩
  have hy_eq :
      ∀ i, ∃ u : q.asIdeal.primeCompl, (y i : Λq) = algebraMap Λ Λq (u : Λ) * x i := by
    intro i
    refine ⟨t i * s i, ?_⟩
    simpa [y, hπ_factor i]
  have hy_param : parameterIdeal y = maximalIdeal Λq := by
    calc
      parameterIdeal y = parameterIdeal x :=
        parameterIdeal_eq_of_rescaled_generators (q := q) x y hy_eq
      _ = maximalIdeal Λq := hx.2
  have hy_reg : IsRegularSystemOfParameters y := by
    exact (isRegularSystemOfParameters_iff_of_ringKrullDim_eq hdim y).2 hy_param
  have hpow : ∀ i, π i ^ n ∈ I := by
    intro i
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
    have hbase : (t i : Λ) * a i ^ (m + 1) ∈ I := by
      simpa using ht i
    have hmul : (t i : Λ) ^ m * ((t i : Λ) * a i ^ (m + 1)) ∈ I :=
      I.mul_mem_left _ hbase
    have hpow_eq :
        (π i) ^ (m + 1) = (t i : Λ) ^ m * ((t i : Λ) * a i ^ (m + 1)) := by
      calc
        (π i) ^ (m + 1) = ((t i : Λ) * a i) ^ m * ((t i : Λ) * a i) := by
          simp [π, pow_succ]
        _ = ((t i : Λ) ^ m * a i ^ m) * ((t i : Λ) * a i) := by
          rw [mul_pow]
        _ = (t i : Λ) ^ m * ((t i : Λ) * a i ^ (m + 1)) := by
          ring
    rw [hpow_eq]
    exact hmul
  refine ⟨π, hπ_mem, ?_, hpow⟩
  simpa [y] using hy_reg

/-- Helper for Lemma 16.10.2: localizing the prefix-power ideal is the same as spanning the
corresponding powered localized prefix. -/
lemma localized_prefix_power_ideal_eq_span
    {d t e : ℕ} {π : Fin d → Λ} (ht : t ≤ d) :
    Ideal.map (algebraMap Λ Λq) (Algebra.piPowPrefixIdeal π e t ht) =
      Ideal.span (Set.range fun i : Fin t ↦ (algebraMap Λ Λq (π (Fin.castLE ht i))) ^ e) := by
  -- Rewrite the prefix ideal as a span and identify the termwise image of its generators.
  rw [Algebra.piPowPrefixIdeal_def, Ideal.map_span]
  have hrange :
      algebraMap Λ Λq '' Set.range (fun i : Fin t ↦ π (Fin.castLE ht i) ^ e) =
        Set.range (fun i : Fin t ↦ (algebraMap Λ Λq (π (Fin.castLE ht i))) ^ e) := by
    ext y
    constructor
    · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
      refine ⟨i, ?_⟩
      simp
    · rintro ⟨i, rfl⟩
      refine ⟨π (Fin.castLE ht i) ^ e, ⟨i, rfl⟩, ?_⟩
      simp
  rw [hrange]

/-- Helper for Lemma 16.10.2: the localized prefix-power ideal can be written in the canonical
`Ideal.ofList` form attached to the powered localized prefix. -/
lemma localized_prefix_power_ideal_eq_ofList_prefix
    {d t e : ℕ} {π : Fin d → Λ} (ht : t ≤ d) :
    Ideal.map (algebraMap Λ Λq) (Algebra.piPowPrefixIdeal π e t ht) =
      Ideal.ofList
        (List.ofFn fun i : Fin t ↦ (algebraMap Λ Λq (π (Fin.castLE ht i))) ^ e) := by
  -- Rewrite the localized prefix ideal to the finite-family span that the source quotient uses.
  rw [localized_prefix_power_ideal_eq_span (q := q) (π := π) ht]
  -- Then switch from `Set.range` to the canonical finite-list owner `Ideal.ofList`.
  ext y
  simp [Ideal.ofList, List.mem_ofFn', Set.range]

/-- Helper for Lemma 16.10.2: if `e` is positive, then the powered localized prefix still lands
in the maximal ideal. -/
lemma localized_prefix_power_mem_maximalIdeal
    {d t e : ℕ} {π : Fin d → Λ}
    (ht : t ≤ d) (he : 0 < e)
    (hπ : ∀ i, algebraMap Λ Λq (π i) ∈ maximalIdeal Λq)
    (i : Fin t) :
    (algebraMap Λ Λq (π (Fin.castLE ht i))) ^ e ∈ maximalIdeal Λq := by
  -- Positive powers of an element in the maximal ideal remain in the maximal ideal.
  exact (maximalIdeal Λq).pow_mem_of_mem (hπ (Fin.castLE ht i)) e he

/-- Helper for Lemma 16.10.2: for positive `e`, the localized prefix-power ideal is the parameter
ideal of the powered localized prefix. -/
lemma localized_prefix_power_ideal_eq_parameterIdeal
    {d t e : ℕ} {π : Fin d → Λ}
    (ht : t ≤ d) (he : 0 < e)
    (hπ : ∀ i, algebraMap Λ Λq (π i) ∈ maximalIdeal Λq) :
    Ideal.map (algebraMap Λ Λq) (Algebra.piPowPrefixIdeal π e t ht) =
      parameterIdeal
        (fun i : Fin t ↦
          ⟨(algebraMap Λ Λq (π (Fin.castLE ht i))) ^ e,
            localized_prefix_power_mem_maximalIdeal (q := q) (π := π) ht he hπ i⟩) := by
  -- Once the generators are known to lie in the maximal ideal, the span description is exactly
  -- the parameter-ideal owner.
  rw [localized_prefix_power_ideal_eq_span (q := q) (π := π) ht, parameterIdeal_eq_span]

/-- Helper for Lemma 16.10.2: localizing the quotient by a prefix-power ideal agrees with
quotienting the localization by the localized ideal. -/
noncomputable abbrev prefix_quotient_localization_algEquiv
    {d t e : ℕ} {π : Fin d → Λ} (ht : t ≤ d) :
    Localization
        (Algebra.algebraMapSubmonoid
          (Λ ⧸ Algebra.piPowPrefixIdeal π e t ht) q.asIdeal.primeCompl) ≃ₐ[Λ ⧸
            Algebra.piPowPrefixIdeal π e t ht]
        Λq ⧸ Ideal.map (algebraMap Λ Λq) (Algebra.piPowPrefixIdeal π e t ht) :=
  Localization.algEquiv _ _

/-- Helper for Lemma 16.10.2: powering exactly the initial localized parameters by `e` preserves
regularity of the full ordered list. -/
lemma localized_mixed_power_sequence_isRegular
    {d e : ℕ} {π : Fin d → Λ}
    (hπ : ∀ i, algebraMap Λ Λq (π i) ∈ maximalIdeal Λq)
    [IsRegularLocalRing Λq]
    (hreg : IsRegularSystemOfParameters (fun i ↦ ⟨algebraMap Λ Λq (π i), hπ i⟩))
    (he : 0 < e) (t : Fin d) :
    RingTheory.Sequence.IsRegular Λq
      ((List.ofFn fun j : Fin d ↦ algebraMap Λ Λq (π j)).zipWith (fun x m ↦ x ^ m)
        (List.ofFn fun j : Fin d ↦ if j.1 < t.1 then e else 1)) := by
  -- Start from the regular system of parameters and convert it to the regular ordered list.
  have hbase :
      RingTheory.Sequence.IsRegular Λq (List.ofFn fun j : Fin d ↦ algebraMap Λ Λq (π j)) := by
    simpa using hreg.isRegular
  have hpos :
      List.Forall₂ (fun (_ : Λq) m ↦ 0 < m)
        (List.ofFn fun j : Fin d ↦ algebraMap Λ Λq (π j))
        (List.ofFn fun j : Fin d ↦ if j.1 < t.1 then e else 1) := by
    -- The exponent list is positive termwise: `e` on the prefix and `1` afterwards.
    rw [List.forall₂_iff_get]
    constructor
    · simp
    · intro i _hi1 hi2
      have hi : i < d := by
        simpa using hi2
      have hpos_i : 0 < (if i < t.1 then e else 1) := by
        by_cases hij : i < t.1
        · simpa [hij] using he
        · simpa [hij] using Nat.one_pos
      simpa [List.getElem_ofFn, hi] using hpos_i
  -- Then apply the canonical regular-sequence invariance under positive powers.
  exact (RingTheory.Sequence.isRegular_iff_isRegular_pow hpos).mp hbase

/-- Helper for Lemma 16.10.2: regularity of `a` on `A ⧸ J` as an `A`-module gives regularity of
the quotient class of `a` for the self-action of `A ⧸ J`. -/
lemma quotient_class_isSMulRegular_of_base
    {A : Type*} [CommRing A] (J : Ideal A) (a : A)
    (ha : IsSMulRegular (A ⧸ J) a) :
    IsSMulRegular (A ⧸ J) (Ideal.Quotient.mk J a) := by
  -- Both scalar actions are represented by the same multiplication map on the quotient ring.
  rw [isSMulRegular_iff_right_eq_zero_of_smul] at ha ⊢
  intro x hx
  exact ha x <| by
    simpa using hx

/-- Helper for Lemma 16.10.2: in the regular self-module of a commutative ring, `I • ⊤` is just
the ideal `I` itself. -/
lemma ideal_smul_top_eq_self_submodule
    {A : Type*} [CommRing A] (I : Ideal A) :
    ((I • (⊤ : Submodule A A)) : Submodule A A) = (I : Submodule A A) := by
  -- Normalize the self-module smul by `I` to the image of `I` under the identity algebra map.
  ext x
  constructor
  · intro hx
    rw [Ideal.smul_top_eq_map] at hx
    simpa using hx
  · intro hx
    rw [Ideal.smul_top_eq_map]
    simpa using hx

/-- Helper for Lemma 16.10.2: if `rs ++ [a]` is a regular sequence in a commutative ring, then the
class of `a` is regular in the quotient by the ideal generated by `rs`. -/
lemma regular_append_singleton_quotientClass_isSMulRegular
    {A : Type*} [CommRing A] {rs : List A} {a : A}
    (hreg : RingTheory.Sequence.IsRegular A (rs ++ [a])) :
    IsSMulRegular (A ⧸ Ideal.ofList rs) (Ideal.Quotient.mk (Ideal.ofList rs) a) := by
  -- Route correction: extract the last-step regularity from the canonical append decomposition
  -- before rewriting the self-module quotient to the owner quotient ring.
  have hsplit :
      RingTheory.Sequence.IsWeaklyRegular A rs ∧
        RingTheory.Sequence.IsWeaklyRegular
          (A ⧸ (Ideal.ofList rs • (⊤ : Submodule A A))) [a] := by
    simpa using
      (RingTheory.Sequence.isWeaklyRegular_append_iff (M := A) rs [a]).mp
        hreg.toIsWeaklyRegular
  have hlast :
      IsSMulRegular (A ⧸ (Ideal.ofList rs • (⊤ : Submodule A A))) a := by
    -- The singleton tail says exactly that `a` is regular on the quotient by the prefix ideal.
    exact
      (RingTheory.Sequence.isWeaklyRegular_singleton_iff
        (M := A ⧸ (Ideal.ofList rs • (⊤ : Submodule A A))) a).mp hsplit.2
  have hlast' : IsSMulRegular (A ⧸ Ideal.ofList rs) a := by
    -- Replace the self-module quotient owner `Ideal.ofList rs • ⊤` by the ideal itself.
    let e :
        (A ⧸ (Ideal.ofList rs • (⊤ : Submodule A A))) ≃ₗ[A]
          A ⧸ Ideal.ofList rs :=
      Submodule.quotEquivOfEq _ _ (ideal_smul_top_eq_self_submodule (I := Ideal.ofList rs))
    exact (e.isSMulRegular_congr a).mp hlast
  -- Finally pass from regularity of scalar multiplication by `a` to regularity of its quotient
  -- class for the self-action of the quotient ring.
  exact quotient_class_isSMulRegular_of_base (J := Ideal.ofList rs) a hlast'

/-- Helper for Lemma 16.10.2: a regular scalar has the same first and second torsion stages. -/
lemma torsionBy_eq_square_of_isSMulRegular
    {A : Type*} [CommRing A] (a : A) (ha : IsSMulRegular A a) :
    Submodule.torsionBy A A a = Submodule.torsionBy A A (a ^ 2) := by
  -- Regularity forces each torsion stage to be trivial; compare both with `⊥`.
  have hbot : Submodule.torsionBy A A a = ⊥ :=
    (isSMulRegular_iff_torsionBy_eq_bot A a).mp ha
  have hsquare : IsSMulRegular A (a ^ 2) :=
    (IsSMulRegular.pow_iff (M := A) (n := 2) (by decide : 0 < 2)).2 ha
  have hbot2 : Submodule.torsionBy A A (a ^ 2) = ⊥ :=
    (isSMulRegular_iff_torsionBy_eq_bot A (a ^ 2)).mp hsquare
  rw [hbot, hbot2]

/-- Helper for Lemma 16.10.2: on the self-module of a commutative ring, the textbook annihilator
ideal of an element is exactly the corresponding torsion submodule. -/
lemma torsionOf_eq_torsionBy_self
    {A : Type*} [CommRing A] (x : A) :
    Ideal.torsionOf A A x = Submodule.torsionBy A A x := by
  -- Both owners encode the same equation `a * x = 0` for ring elements `a`.
  ext a
  rw [Ideal.mem_torsionOf_iff, Submodule.mem_torsionBy_iff]
  simpa [smul_eq_mul, mul_comm]

/-- Helper for Lemma 16.10.2: a localized torsion equality on a prefix quotient descends after
rescaling by one denominator coming from `q.asIdeal.primeCompl`. -/
lemma torsionOf_descent_of_prefix_localization_eq
    [IsNoetherianRing Λ]
    {J : Ideal Λ} {x : Λ}
    (htors :
      let S := Algebra.algebraMapSubmonoid (Λ ⧸ J) q.asIdeal.primeCompl
      let A := Localization S
      Submodule.torsionBy A A (algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J x)) =
        Submodule.torsionBy A A ((algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J x)) ^ 2)) :
    ∃ s : q.asIdeal.primeCompl,
      Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J ((s : Λ) * x)) =
        Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (((s : Λ) * x) ^ 2)) := by
  let S : Submonoid (Λ ⧸ J) := Algebra.algebraMapSubmonoid (Λ ⧸ J) q.asIdeal.primeCompl
  letI : IsNoetherianRing (Λ ⧸ J) := Ideal.Quotient.isNoetherianRing J
  -- Apply Ogoma in the quotient ring and then rewrite the resulting denominator back to `Λ`.
  obtain ⟨sbar, hs⟩ :=
    exists_mem_submonoid_torsionBy_eq_of_localized
      (A := Λ ⧸ J) (S := S) (M := Λ ⧸ J) (π := Ideal.Quotient.mk J x) htors
  rcases sbar with ⟨s, hsS⟩
  have hs_lift :
      ∃ a : Λ,
        a ∈ q.asIdeal.primeCompl ∧ algebraMap Λ (Λ ⧸ J) a = s := by
    simpa [S, Algebra.algebraMapSubmonoid, Submonoid.mem_map] using hsS
  rcases hs_lift with ⟨s₀, hs₀mem, hs₀eq⟩
  let s' : q.asIdeal.primeCompl := ⟨s₀, hs₀mem⟩
  refine ⟨s', ?_⟩
  have hs_mul :
      (s * Ideal.Quotient.mk J x) =
        Ideal.Quotient.mk J (((s' : Λ) * x)) := by
    calc
      s * Ideal.Quotient.mk J x =
          algebraMap Λ (Λ ⧸ J) (s' : Λ) * Ideal.Quotient.mk J x := by
            rw [hs₀eq]
      _ = Ideal.Quotient.mk J (((s' : Λ) * x)) := by
            simp [s', mul_comm]
  have htorsion :
      Submodule.torsionBy (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J ((s' : Λ) * x)) =
        Submodule.torsionBy (Λ ⧸ J) (Λ ⧸ J) ((Ideal.Quotient.mk J ((s' : Λ) * x)) ^ 2) := by
    -- Use Ogoma with `n = 1`, then rewrite the quotient element as the image of `s₀ * x`.
    simpa [pow_one, hs_mul] using hs 1
  -- Translate the self-module torsion equality back to the textbook `Ideal.torsionOf` owner.
  calc
    Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J ((s' : Λ) * x)) =
        Submodule.torsionBy (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J ((s' : Λ) * x)) := by
          simpa using
            torsionOf_eq_torsionBy_self
              (A := Λ ⧸ J) (Ideal.Quotient.mk J ((s' : Λ) * x))
    _ = Submodule.torsionBy (Λ ⧸ J) (Λ ⧸ J) ((Ideal.Quotient.mk J ((s' : Λ) * x)) ^ 2) :=
      htorsion
    _ =
        Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J)
          (Ideal.Quotient.mk J (((s' : Λ) * x) ^ 2)) := by
            simpa using
              (torsionOf_eq_torsionBy_self
                (A := Λ ⧸ J) (Ideal.Quotient.mk J (((s' : Λ) * x) ^ 2))).symm

/-- Helper for Lemma 16.10.2: updating the `i`-th coordinate does not change any earlier
prefix-power ideal. -/
lemma piPowPrefixIdeal_update_eq_of_lt
    {d e t : ℕ} {π : Fin d → Λ} {i : Fin d}
    (ht : t ≤ i.1) (hti : t ≤ d) (x : Λ) :
    Algebra.piPowPrefixIdeal (Function.update π i x) e t hti =
      Algebra.piPowPrefixIdeal π e t hti := by
  -- The first `t` coordinates never touch the updated index `i`.
  rw [Algebra.piPowPrefixIdeal_def, Algebra.piPowPrefixIdeal_def]
  have hrange :
      Set.range (fun j : Fin t ↦ Function.update π i x (Fin.castLE hti j) ^ e) =
        Set.range (fun j : Fin t ↦ π (Fin.castLE hti j) ^ e) := by
    ext y
    constructor
    · rintro ⟨j, rfl⟩
      refine ⟨j, ?_⟩
      have hne : Fin.castLE hti j ≠ i := by
        intro hEq
        have hjlt : (Fin.castLE hti j).1 < i.1 := Nat.lt_of_lt_of_le (by simpa using j.isLt) ht
        exact Nat.ne_of_lt hjlt (by simpa using congrArg Fin.val hEq)
      simp [Function.update, hne]
    · rintro ⟨j, rfl⟩
      refine ⟨j, ?_⟩
      have hne : Fin.castLE hti j ≠ i := by
        intro hEq
        have hjlt : (Fin.castLE hti j).1 < i.1 := Nat.lt_of_lt_of_le (by simpa using j.isLt) ht
        exact Nat.ne_of_lt hjlt (by simpa using congrArg Fin.val hEq)
      simp [Function.update, hne]
  rw [hrange]

/-- Helper for Lemma 16.10.2: if the exponent is zero and the prefix is nonempty, then the
prefix-power ideal is the unit ideal. -/
lemma piPowPrefixIdeal_zero_pos_eq_top
    {d t : ℕ} {π : Fin d → Λ} (ht : t ≤ d) (hpos : 0 < t) :
    Algebra.piPowPrefixIdeal π 0 t ht = ⊤ := by
  -- The generating family already contains `1 = π_j^0`.
  rw [Algebra.piPowPrefixIdeal_def]
  refine Ideal.eq_top_of_isUnit_mem _ ?_ (isUnit_one)
  exact Ideal.subset_span ⟨⟨0, hpos⟩, by simp⟩

/-- Helper for Lemma 16.10.2: ring equivalences preserve regularity of a scalar on the regular
self-module. -/
lemma isSMulRegular_iff_of_ringEquiv
    {A B : Type*} [CommRing A] [CommRing B] (e : A ≃+* B) (a : A) :
    IsSMulRegular A a ↔ IsSMulRegular B (e a) := by
  -- Transport the injectivity of multiplication by applying the ring equivalence to the equation.
  rw [isSMulRegular_iff_right_eq_zero_of_smul, isSMulRegular_iff_right_eq_zero_of_smul]
  constructor
  · intro ha x hx
    have hx' : a • e.symm x = 0 := by
      apply e.injective
      simpa [smul_eq_mul, map_mul] using hx
    have hzero : e.symm x = 0 := ha (e.symm x) hx'
    simpa using congrArg e hzero
  · intro hb x hx
    have hx' : (e a) • e x = 0 := by
      simpa [smul_eq_mul, map_mul] using congrArg e hx
    exact e.injective (by simpa using hb (e x) hx')

/-- Helper for Lemma 16.10.2: every finite prefix of a regular sequence is regular. -/
lemma sequenceIsRegular_take
    {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M] {xs : List R}
    (hreg : RingTheory.Sequence.IsRegular M xs) (n : ℕ) :
    RingTheory.Sequence.IsRegular M (xs.take n) := by
  induction xs generalizing M n with
  | nil =>
      haveI : Nontrivial M := hreg.nontrivial
      simpa using (RingTheory.Sequence.IsRegular.nil R M)
  | cons a xs ih =>
      cases n with
      | zero =>
          haveI : Nontrivial M := hreg.nontrivial
          simpa using (RingTheory.Sequence.IsRegular.nil R M)
      | succ n =>
          simp at ⊢
          rw [RingTheory.Sequence.isRegular_cons_iff] at hreg
          -- Proof comment: one step of `isRegular_cons_iff` peels off the head and reduces the
          -- remaining prefix to the quotient module.
          simpa using And.intro hreg.1 (ih hreg.2 n)

/-- Helper for Lemma 16.10.2: truncating the mixed power list at `i + 1` leaves exactly the
powered prefix together with the current unpowered term. -/
lemma localizedMixedPowerSequence_take_eq_prefixAppendCurrent
    {d e : ℕ} {π : Fin d → Λ} (i : Fin d) :
    let mixed :=
      ((List.ofFn fun j : Fin d ↦ algebraMap Λ Λq (π j)).zipWith (fun x m ↦ x ^ m)
        (List.ofFn fun j : Fin d ↦ if j.1 < i.1 then e else 1))
    mixed.take (i.1 + 1) =
      (List.ofFn fun j : Fin i.1 ↦
        (algebraMap Λ Λq (π (Fin.castLE (Nat.le_of_lt i.isLt) j))) ^ e) ++
          [algebraMap Λ Λq (π i)] := by
  classical
  let mixed :=
    ((List.ofFn fun j : Fin d ↦ algebraMap Λ Λq (π j)).zipWith (fun x m ↦ x ^ m)
      (List.ofFn fun j : Fin d ↦ if j.1 < i.1 then e else 1))
  let rs :=
    List.ofFn fun j : Fin i.1 ↦
      (algebraMap Λ Λq (π (Fin.castLE (Nat.le_of_lt i.isLt) j))) ^ e
  have hmixed_len : mixed.length = d := by
    simp [mixed]
  have htake : mixed.take i.1 = rs := by
    symm
    rw [← Fin.ofFn_take_get mixed (by simpa [hmixed_len] using Nat.le_of_lt i.isLt)]
    unfold rs
    rw [List.ofFn_inj]
    ext j
    -- Proof comment: rewrite the lifted prefix index into the concrete `Fin` constructor so
    -- the comparison with `i` simplifies to the visible prefix inequality `j < i`.
    let j' : Fin d := ⟨j.1, Nat.lt_trans j.isLt i.isLt⟩
    have hcast : (Fin.castLE (Nat.le_of_lt i.isLt) j : Fin d) = j' := by
      rfl
    have hlt : j' < i := by
      exact j.isLt
    simp [mixed, Fin.take_apply, j', hcast, hlt]
  have hi_mixed : i.1 < mixed.length := by
    simpa [hmixed_len] using i.isLt
  have hget : mixed[i.1]'hi_mixed = algebraMap Λ Λq (π i) := by
    simp [mixed]
  -- Proof comment: compare both lists entrywise; before index `i` the exponent is `e`, and at
  -- the final index the exponent switches to `1`.
  calc
    mixed.take (i.1 + 1) = mixed.take i.1 ++ [mixed[i.1]'hi_mixed] := by
      symm
      exact List.take_concat_get' mixed i.1 hi_mixed
    _ = rs ++ [algebraMap Λ Λq (π i)] := by rw [htake, hget]

/-- Helper for Lemma 16.10.2: in the canonical quotient owner, the next quotient class is
regular after quotienting by the earlier positive powers. -/
lemma localizedPrefixQuotientClass_isSMulRegular
    {d e : ℕ} {π : Fin d → Λ}
    (hπ : ∀ j, algebraMap Λ Λq (π j) ∈ maximalIdeal Λq)
    [IsRegularLocalRing Λq]
    (hreg : IsRegularSystemOfParameters (fun j ↦ ⟨algebraMap Λ Λq (π j), hπ j⟩))
    (he : 0 < e) (i : Fin d) :
    let J := Algebra.piPowPrefixIdeal π e i.1 (Nat.le_of_lt i.isLt)
    IsSMulRegular (Λq ⧸ Ideal.map (algebraMap Λ Λq) J)
      (Ideal.Quotient.mk (Ideal.map (algebraMap Λ Λq) J) (algebraMap Λ Λq (π i))) := by
  classical
  let mixed :=
    ((List.ofFn fun j : Fin d ↦ algebraMap Λ Λq (π j)).zipWith (fun x m ↦ x ^ m)
      (List.ofFn fun j : Fin d ↦ if j.1 < i.1 then e else 1))
  let rs :=
    List.ofFn fun j : Fin i.1 ↦
      (algebraMap Λ Λq (π (Fin.castLE (Nat.le_of_lt i.isLt) j))) ^ e
  have hmixed : RingTheory.Sequence.IsRegular Λq mixed :=
    localized_mixed_power_sequence_isRegular (q := q) (π := π) hπ hreg he i
  have hprefix : RingTheory.Sequence.IsRegular Λq (mixed.take (i.1 + 1)) :=
    sequenceIsRegular_take hmixed (i.1 + 1)
  have hshape :
      mixed.take (i.1 + 1) = rs ++ [algebraMap Λ Λq (π i)] := by
    simpa [mixed, rs] using
      localizedMixedPowerSequence_take_eq_prefixAppendCurrent (q := q) (π := π) (e := e) i
  have hquot :
      IsSMulRegular (Λq ⧸ Ideal.ofList rs)
        (Ideal.Quotient.mk (Ideal.ofList rs) (algebraMap Λ Λq (π i))) := by
    -- Proof comment: once the truncated list is normalized to `rs ++ [current]`, the last-step
    -- quotient regularity is the dedicated append-singleton lemma.
    apply regular_append_singleton_quotientClass_isSMulRegular
    simpa [hshape] using hprefix
  let J := Algebra.piPowPrefixIdeal π e i.1 (Nat.le_of_lt i.isLt)
  have hJ :
      Ideal.map (algebraMap Λ Λq) J = Ideal.ofList rs := by
    simpa [J, rs] using
      localized_prefix_power_ideal_eq_ofList_prefix (q := q) (π := π)
        (ht := Nat.le_of_lt i.isLt) (e := e)
  have htransport :
      IsSMulRegular (Λq ⧸ Ideal.map (algebraMap Λ Λq) J)
        ((Ideal.Quotient.mk (Ideal.map (algebraMap Λ Λq) J)) (algebraMap Λ Λq (π i))) := by
    -- Proof comment: move the canonical quotient regularity across the quotient equivalence
    -- coming from `localized_prefix_power_ideal_eq_ofList_prefix`.
    refine
      (isSMulRegular_iff_of_ringEquiv
        (Ideal.quotEquivOfEq hJ)
        ((Ideal.Quotient.mk (Ideal.map (algebraMap Λ Λq) J))
          (algebraMap Λ Λq (π i)))).2 ?_
    rw [Ideal.quotEquivOfEq_mk]
    simpa using hquot
  simpa [J] using htransport

/-- Helper for Lemma 16.10.2: the quotient/localization equivalence sends the quotient class of
`π i` to the corresponding quotient class in the localized quotient owner. -/
lemma prefixQuotientLocalization_algEquiv_mk
    {d e : ℕ} {π : Fin d → Λ} (i : Fin d) :
    let J := Algebra.piPowPrefixIdeal π e i.1 (Nat.le_of_lt i.isLt)
    let S := Algebra.algebraMapSubmonoid (Λ ⧸ J) q.asIdeal.primeCompl
    let A := Localization S
    (prefix_quotient_localization_algEquiv (q := q) (π := π) (e := e)
        (ht := Nat.le_of_lt i.isLt)).toRingEquiv
      (algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (π i))) =
        Ideal.Quotient.mk (Ideal.map (algebraMap Λ Λq) J) (algebraMap Λ Λq (π i)) := by
  classical
  let J := Algebra.piPowPrefixIdeal π e i.1 (Nat.le_of_lt i.isLt)
  let S := Algebra.algebraMapSubmonoid (Λ ⧸ J) q.asIdeal.primeCompl
  let A := Localization S
  -- Proof comment: this is the standard `IsLocalization.algEquiv_apply` computation specialized
  -- to the canonical quotient-localization equivalence of the prefix ideal.
  simpa [prefix_quotient_localization_algEquiv, J, S, A] using
    (IsLocalization.algEquiv_apply S
      (Localization S)
      (Λq ⧸ Ideal.map (algebraMap Λ Λq) J)
      (Ideal.Quotient.mk J (π i)))

/-- Helper for Lemma 16.10.2: rescaling a single coordinate by an element inverted at `q`
preserves the parameter-system data needed in the main induction. -/
lemma rescaledCoordinateFamily_preserves_parameterData
    {d n : ℕ} {I : Ideal Λ} {π : Fin d → Λ}
    (hπ : ∀ j, algebraMap Λ Λq (π j) ∈ maximalIdeal Λq)
    (hreg : IsRegularSystemOfParameters (fun j ↦ ⟨algebraMap Λ Λq (π j), hπ j⟩))
    (hpow : ∀ j, π j ^ n ∈ I)
    (hdim : ringKrullDim Λq = d)
    (i : Fin d) (s : q.asIdeal.primeCompl) :
    let π' := Function.update π i ((s : Λ) * π i)
    ∃ hπ' : ∀ j, algebraMap Λ Λq (π' j) ∈ maximalIdeal Λq,
      IsRegularSystemOfParameters (fun j ↦ ⟨algebraMap Λ Λq (π' j), hπ' j⟩) ∧
        (∀ j, π' j ^ n ∈ I) := by
  classical
  let π' : Fin d → Λ := Function.update π i ((s : Λ) * π i)
  have hπ' : ∀ j, algebraMap Λ Λq (π' j) ∈ maximalIdeal Λq := by
    intro j
    by_cases hji : j = i
    · subst j
      simpa [π'] using (maximalIdeal Λq).mul_mem_left (algebraMap Λ Λq (s : Λ)) (hπ i)
    · simpa [π', Function.update, hji] using hπ j
  let x : Fin d → maximalIdeal Λq := fun j ↦ ⟨algebraMap Λ Λq (π j), hπ j⟩
  let y : Fin d → maximalIdeal Λq := fun j ↦ ⟨algebraMap Λ Λq (π' j), hπ' j⟩
  have hy_eq :
      ∀ j, ∃ u : q.asIdeal.primeCompl, (y j : Λq) = algebraMap Λ Λq (u : Λ) * x j := by
    intro j
    by_cases hji : j = i
    · subst hji
      refine ⟨s, ?_⟩
      simp [x, y, π']
    · refine ⟨1, ?_⟩
      simp [x, y, π', hji]
  have hy_param : parameterIdeal y = maximalIdeal Λq := by
    calc
      parameterIdeal y = parameterIdeal x :=
        parameterIdeal_eq_of_rescaled_generators (q := q) x y hy_eq
      _ = maximalIdeal Λq := hreg.2
  have hreg' : IsRegularSystemOfParameters y := by
    exact (isRegularSystemOfParameters_iff_of_ringKrullDim_eq hdim y).2 hy_param
  have hpow' : ∀ j, π' j ^ n ∈ I := by
    intro j
    by_cases hji : j = i
    · subst j
      simpa [π', mul_pow] using I.mul_mem_left ((s : Λ) ^ n) (hpow i)
    · simpa [π', Function.update, hji] using hpow j
  refine ⟨hπ', ?_, hpow'⟩
  simpa [x, y] using hreg'

/-- Helper for Lemma 16.10.2: after localizing the quotient by an earlier positive-power prefix,
the next quotient class has equal first and second torsion stages. -/
lemma localizedPrefixTorsion_eq_square
    {d e : ℕ} {π : Fin d → Λ}
    (hπ : ∀ j, algebraMap Λ Λq (π j) ∈ maximalIdeal Λq)
    [IsRegularLocalRing Λq]
    (hreg : IsRegularSystemOfParameters (fun j ↦ ⟨algebraMap Λ Λq (π j), hπ j⟩))
    (he : 0 < e) (i : Fin d) :
    let J := Algebra.piPowPrefixIdeal π e i.1 (Nat.le_of_lt i.isLt)
    let S := Algebra.algebraMapSubmonoid (Λ ⧸ J) q.asIdeal.primeCompl
    let A := Localization S
    Submodule.torsionBy A A (algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (π i))) =
      Submodule.torsionBy A A ((algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (π i))) ^ 2) := by
  classical
  let J := Algebra.piPowPrefixIdeal π e i.1 (Nat.le_of_lt i.isLt)
  let S := Algebra.algebraMapSubmonoid (Λ ⧸ J) q.asIdeal.primeCompl
  let A := Localization S
  have hcanon :
      IsSMulRegular (Λq ⧸ Ideal.map (algebraMap Λ Λq) J)
        (Ideal.Quotient.mk (Ideal.map (algebraMap Λ Λq) J) (algebraMap Λ Λq (π i))) := by
    -- Proof comment: first prove regularity in the canonical quotient owner over `Λq`.
    simpa [J] using
      localizedPrefixQuotientClass_isSMulRegular
        (q := q) (π := π) hπ hreg he i
  have hlocal :
      IsSMulRegular A (algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (π i))) := by
    -- Proof comment: then transport that regularity across the quotient-localization
    -- equivalence specialized to the current prefix ideal.
    refine
      (isSMulRegular_iff_of_ringEquiv
        (prefix_quotient_localization_algEquiv
          (q := q) (π := π) (e := e) (ht := Nat.le_of_lt i.isLt)).toRingEquiv
        (algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (π i)))).2 ?_
    convert hcanon using 1
    exact prefixQuotientLocalization_algEquiv_mk (q := q) (π := π) (e := e) i
  -- Proof comment: finally compare the first and second torsion stages of a regular scalar.
  simpa [J, S, A] using
    torsionBy_eq_square_of_isSMulRegular
      (A := A) (algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (π i))) hlocal

-- Proof sketch: choose `d` generators of the maximal ideal of the regular local ring
-- `Λq`, clear denominators so that their `n`-th powers lie in `I`,
-- and then inductively multiply later generators by elements outside `q` using Ogoma's lemma so
-- that the annihilator equality holds in each successive quotient.
/-- Lemma 16.10.2: let `Λ` be a Noetherian ring, let `I` be an ideal and `q` a prime, and let
`n`, `e`, `d` be integers. Assume that `I ≤ q.asIdeal`, that `q^n` becomes contained in `I`
after localizing at `q`, and that `Λq` is a regular local ring of dimension `d`. Then there are
elements `π₁, …, π_d` of `Λ` whose localized images form a regular system of parameters of `Λ_q`,
whose `n`-th powers lie in `I`, and whose images in each successive quotient by the earlier
`e`-th powers have the same annihilator as the squares of those images. -/
theorem exists_parameters_generating_localized_prime_pow_mem_ideal_and_annihilator_stable
    (I : Ideal Λ) (n e d : ℕ)
    (hIq : I ≤ q.asIdeal)
    (hqpow : Ideal.map (algebraMap Λ Λq) (q.asIdeal ^ n) ≤ Ideal.map (algebraMap Λ Λq) I)
    [IsNoetherianRing Λ]
    [IsRegularLocalRing Λq]
    (hdim : ringKrullDim Λq = d) :
    ∃ (π : Fin d → Λ) (hπ : ∀ i, algebraMap Λ Λq (π i) ∈ maximalIdeal Λq),
      IsRegularSystemOfParameters (fun i ↦ ⟨algebraMap Λ Λq (π i), hπ i⟩) ∧
        (∀ i, π i ^ n ∈ I) ∧
        ∀ i : Fin d,
          let J := Algebra.piPowPrefixIdeal π e i.1 (Nat.le_of_lt i.isLt)
          Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (π i)) =
            Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (π i ^ 2)) := by
  classical
  by_cases hn : n = 0
  · -- The omitted positivity hypothesis makes `n = 0` contradictory to the localized containment.
    have hmapI_top : Ideal.map (algebraMap Λ Λq) I = ⊤ := by
      have htop_le :
          Ideal.map (algebraMap Λ Λq) (⊤ : Ideal Λ) ≤ Ideal.map (algebraMap Λ Λq) I := by
        simpa [hn] using hqpow
      have htop_le' : (⊤ : Ideal Λq) ≤ Ideal.map (algebraMap Λ Λq) I := by
        simpa [Ideal.map_top] using htop_le
      exact le_antisymm le_top htop_le'
    have hmapI_le : Ideal.map (algebraMap Λ Λq) I ≤ maximalIdeal Λq := by
      have hmapI_le' :
          Ideal.map (algebraMap Λ Λq) I ≤ Ideal.map (algebraMap Λ Λq) q.asIdeal :=
        Ideal.map_mono hIq
      simpa [IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal Λq] using hmapI_le'
    have hfalse : False := by
      have htop : (maximalIdeal Λq : Ideal Λq) = ⊤ := top_le_iff.mp <| hmapI_top ▸ hmapI_le
      exact (maximalIdeal.isMaximal Λq).ne_top htop
    exact False.elim hfalse
  · have hn_pos : 0 < n := Nat.pos_of_ne_zero hn
    obtain ⟨π, hπ, hreg, hpow⟩ :=
      exists_regular_parameters_with_pow_mem_ideal
        (q := q) I n d hn_pos hqpow hdim
    by_cases he0 : e = 0
    · subst e
      by_cases hd0 : d = 0
      · subst hd0
        refine ⟨π, hπ, hreg, hpow, ?_⟩
        intro i
        exact Fin.elim0 i
      · have hd_pos : 0 < d := Nat.pos_of_ne_zero hd0
        let i0 : Fin d := ⟨0, hd_pos⟩
        have hJ00 :
            Algebra.piPowPrefixIdeal π 0 i0.1 (Nat.le_of_lt i0.isLt) = ⊥ := by
          simp [i0, Algebra.piPowPrefixIdeal_def]
        have hJ10 :
            Algebra.piPowPrefixIdeal π 1 i0.1 (Nat.le_of_lt i0.isLt) = ⊥ := by
          simp [i0, Algebra.piPowPrefixIdeal_def]
        have hloc0 :
            let J := Algebra.piPowPrefixIdeal π 0 i0.1 (Nat.le_of_lt i0.isLt)
            let S := Algebra.algebraMapSubmonoid (Λ ⧸ J) q.asIdeal.primeCompl
            let A := Localization S
            Submodule.torsionBy A A (algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (π i0))) =
              Submodule.torsionBy A A ((algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (π i0))) ^ 2) := by
          -- Proof comment: for the initial index, the prefix ideal is empty, so the localized
          -- helper with exponent `1` specializes to the desired `e = 0` statement.
          have hJ01 :
              Algebra.piPowPrefixIdeal π 0 i0.1 (Nat.le_of_lt i0.isLt) =
                Algebra.piPowPrefixIdeal π 1 i0.1 (Nat.le_of_lt i0.isLt) := by
            rw [hJ00, hJ10]
          have hloc1 :=
            localizedPrefixTorsion_eq_square
              (q := q) (π := π) (e := 1) hπ hreg Nat.one_pos i0
          rw [hJ01]
          exact hloc1
        obtain ⟨s, hs0⟩ :=
          torsionOf_descent_of_prefix_localization_eq
            (q := q)
            (J := Algebra.piPowPrefixIdeal π 0 i0.1 (Nat.le_of_lt i0.isLt))
            (x := π i0) hloc0
        let π' : Fin d → Λ := Function.update π i0 ((s : Λ) * π i0)
        have hupdated :
            ∃ hπ' : ∀ j, algebraMap Λ Λq (π' j) ∈ maximalIdeal Λq,
              IsRegularSystemOfParameters (fun j ↦ ⟨algebraMap Λ Λq (π' j), hπ' j⟩) ∧
                (∀ j, π' j ^ n ∈ I) := by
          -- Proof comment: rescaling one coordinate by a denominator outside `q` preserves the
          -- parameter-system data and the `n`-th-power containment in `I`.
          simpa [π'] using
            (rescaledCoordinateFamily_preserves_parameterData
              (q := q) (I := I) (π := π) hπ hreg hpow hdim i0 s)
        rcases hupdated with ⟨hπ', hreg', hpow'⟩
        refine ⟨π', hπ', hreg', hpow', ?_⟩
        intro j
        by_cases hj0 : j.1 = 0
        · have hjEq : j = i0 := by
            apply Fin.ext
            simpa [i0] using hj0
          subst hjEq
          have hJ0 :
              Algebra.piPowPrefixIdeal π' 0 i0.1 (Nat.le_of_lt i0.isLt) =
                Algebra.piPowPrefixIdeal π 0 i0.1 (Nat.le_of_lt i0.isLt) :=
            piPowPrefixIdeal_update_eq_of_lt
              (π := π) (i := i0) (e := 0) (t := i0.1)
              le_rfl (Nat.le_of_lt i0.isLt) ((s : Λ) * π i0)
          -- Proof comment: the descended equality is exactly the new current-coordinate equality
          -- because the index-zero prefix ideal is unchanged by updating `π₀`.
          dsimp
          rw [hJ0]
          simpa [π', Function.update] using hs0
        · have hjpos : 0 < j.1 := Nat.pos_of_ne_zero hj0
          have htop :
              Algebra.piPowPrefixIdeal π' 0 j.1 (Nat.le_of_lt j.isLt) = ⊤ :=
            piPowPrefixIdeal_zero_pos_eq_top
              (π := π') (ht := Nat.le_of_lt j.isLt) hjpos
          -- Proof comment: once the prefix is nonempty and `e = 0`, the quotient ring is
          -- trivial, so the annihilator equality is automatic.
          dsimp
          rw [htop]
          exact Subsingleton.elim _ _
    · let GoodPrefix : ℕ → (Fin d → Λ) → Prop :=
        fun t π' =>
          ∃ hπ' : ∀ j, algebraMap Λ Λq (π' j) ∈ maximalIdeal Λq,
            IsRegularSystemOfParameters (fun j ↦ ⟨algebraMap Λ Λq (π' j), hπ' j⟩) ∧
              (∀ j, π' j ^ n ∈ I) ∧
                ∀ j : Fin d, j.1 < t →
                  let J := Algebra.piPowPrefixIdeal π' e j.1 (Nat.le_of_lt j.isLt)
                  Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (π' j)) =
                    Ideal.torsionOf (Λ ⧸ J) (Λ ⧸ J) (Ideal.Quotient.mk J (π' j ^ 2))
      have hbase : GoodPrefix 0 π := by
        refine ⟨hπ, hreg, hpow, ?_⟩
        intro j hj
        exact False.elim (Nat.not_lt_zero _ hj)
      have hsucc :
          ∀ t, t < d → ∀ {πt : Fin d → Λ},
            GoodPrefix t πt → ∃ πu : Fin d → Λ, GoodPrefix (t + 1) πu := by
        intro t htlt πt hGood
        rcases hGood with ⟨hπt, hregt, hpowt, hprevt⟩
        let i : Fin d := ⟨t, htlt⟩
        have hloc :
            let J := Algebra.piPowPrefixIdeal πt e i.1 (Nat.le_of_lt i.isLt)
            let S := Algebra.algebraMapSubmonoid (Λ ⧸ J) q.asIdeal.primeCompl
            let A := Localization S
            Submodule.torsionBy A A (algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (πt i))) =
              Submodule.torsionBy A A ((algebraMap (Λ ⧸ J) A (Ideal.Quotient.mk J (πt i))) ^ 2) := by
          -- Proof comment: the new localized helper gives the current-step torsion equality on
          -- the localized prefix quotient.
          exact
            localizedPrefixTorsion_eq_square
              (q := q) (π := πt) hπt hregt (Nat.pos_of_ne_zero he0) i
        obtain ⟨s, hs⟩ :=
          torsionOf_descent_of_prefix_localization_eq
            (q := q)
            (J := Algebra.piPowPrefixIdeal πt e i.1 (Nat.le_of_lt i.isLt))
            (x := πt i) hloc
        let πu : Fin d → Λ := Function.update πt i ((s : Λ) * πt i)
        have hupdated :
            ∃ hπu : ∀ j, algebraMap Λ Λq (πu j) ∈ maximalIdeal Λq,
              IsRegularSystemOfParameters (fun j ↦ ⟨algebraMap Λ Λq (πu j), hπu j⟩) ∧
                (∀ j, πu j ^ n ∈ I) := by
          -- Proof comment: rescaling the current coordinate preserves all global parameter data.
          simpa [πu] using
            (rescaledCoordinateFamily_preserves_parameterData
              (q := q) (I := I) (π := πt) hπt hregt hpowt hdim i s)
        rcases hupdated with ⟨hπu, hregu, hpowu⟩
        refine ⟨πu, hπu, hregu, hpowu, ?_⟩
        intro j hjlt
        by_cases hprev : j.1 < t
        · have hne : j ≠ i := by
            intro hEq
            have hval : j.1 = t := by
              simpa [i] using congrArg Fin.val hEq
            exact Nat.ne_of_lt hprev hval
          have hJprev :
              Algebra.piPowPrefixIdeal πu e j.1 (Nat.le_of_lt j.isLt) =
                Algebra.piPowPrefixIdeal πt e j.1 (Nat.le_of_lt j.isLt) :=
            piPowPrefixIdeal_update_eq_of_lt
              (π := πt) (i := i) (e := e) (t := j.1)
              (Nat.le_of_lt hprev) (Nat.le_of_lt j.isLt) ((s : Λ) * πt i)
          -- Proof comment: earlier prefix ideals and earlier coordinates are unchanged by the
          -- current update, so the already-established equalities persist unchanged.
          dsimp
          rw [hJprev]
          simpa [πu, Function.update, hne] using hprevt j hprev
        · have hval : j.1 = t := by
            exact le_antisymm (Nat.lt_succ_iff.mp hjlt) (Nat.le_of_not_lt hprev)
          have hjEq : j = i := by
            apply Fin.ext
            simpa [i] using hval
          subst hjEq
          have hJcurr :
              Algebra.piPowPrefixIdeal πu e i.1 (Nat.le_of_lt i.isLt) =
                Algebra.piPowPrefixIdeal πt e i.1 (Nat.le_of_lt i.isLt) :=
            piPowPrefixIdeal_update_eq_of_lt
              (π := πt) (i := i) (e := e) (t := i.1)
              le_rfl (Nat.le_of_lt i.isLt) ((s : Λ) * πt i)
          -- Proof comment: the descended equality becomes the new current-coordinate equality
          -- because the current prefix ideal depends only on earlier coordinates.
          dsimp
          rw [hJcurr]
          simpa [πu, Function.update] using hs
      have hind : ∀ t, t ≤ d → ∃ πt : Fin d → Λ, GoodPrefix t πt := by
        intro t
        induction t with
        | zero =>
            intro _ht
            exact ⟨π, hbase⟩
        | succ t ih =>
            intro ht
            obtain ⟨πt, hGoodt⟩ := ih (Nat.le_of_succ_le ht)
            exact hsucc t (Nat.lt_of_succ_le ht) hGoodt
      obtain ⟨πf, hGoodf⟩ := hind d le_rfl
      rcases hGoodf with ⟨hπf, hregf, hpowf, hprefixf⟩
      refine ⟨πf, hπf, hregf, hpowf, ?_⟩
      intro i
      exact hprefixf i i.isLt

end
