open AlgebraicGeometry
open scoped AlgebraicGeometry TensorProduct

noncomputable section

universe u

namespace AlgebraicGeometry

/-- The stalk of `Ω[X/S]` at `x`, viewed as an `𝒪_{X,x}`-module, needs no more generators
than the local dimension of the fibre through `x`. -/
private def differentialsStalkGeneratedByFiberDimension
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  ((⊤ : Submodule (X.presheaf.stalk x)
      ↑(RingedSpace.stalkModuleCat (Ω[f.toShHom]) x)).spanFinrank : WithBot ℕ∞) ≤
    f.fiberDimensionAt x

/-- Both cotangent spaces in the displayed base-change identification,
from `Ω[X_s/s]` at `f.asFiber x` and from `Ω[X/S]` at `x`, need no more generators than the local
dimension of the fibre through `x`. -/
private def fiberAndRelativeCotangentSpacesGeneratedByFiberDimension
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  ((⊤ : Submodule
      (IsLocalRing.ResidueField ((Scheme.Hom.fiber f (f x)).presheaf.stalk (f.asFiber x)))
      (IsLocalRing.ResidueField ((Scheme.Hom.fiber f (f x)).presheaf.stalk (f.asFiber x)) ⊗[
        (Scheme.Hom.fiber f (f x)).presheaf.stalk (f.asFiber x)]
        ↑(RingedSpace.stalkModuleCat
          (Ω[(Scheme.Hom.fiberToSpecResidueField f (f x)).toShHom])
          (f.asFiber x)))).spanFinrank : WithBot ℕ∞) ≤ f.fiberDimensionAt x ∧
    ((⊤ : Submodule (IsLocalRing.ResidueField (X.presheaf.stalk x))
        (IsLocalRing.ResidueField (X.presheaf.stalk x) ⊗[X.presheaf.stalk x]
        ↑(RingedSpace.stalkModuleCat (Ω[f.toShHom]) x))).spanFinrank : WithBot ℕ∞) ≤
      f.fiberDimensionAt x

/-- The local flatness and smooth fibre condition in the TFAE statement. -/
private def flatStalkMapAndSmoothFiberAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  (f.stalkMap x).hom.Flat ∧
    (Scheme.Hom.fiberToSpecResidueField f (f x)).SmoothAt (f.asFiber x)

/-- The local flatness and relative-differentials generator bound condition in the TFAE
statement. -/
private def flatStalkMapAndDifferentialsGeneratedAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  (f.stalkMap x).hom.Flat ∧ differentialsStalkGeneratedByFiberDimension f x

/-- The local flatness and base-change cotangent-space generator bound condition in the TFAE
statement. -/
private def flatStalkMapAndCotangentSpacesGeneratedAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  (f.stalkMap x).hom.Flat ∧
    fiberAndRelativeCotangentSpacesGeneratedByFiberDimension f x

/-- Affine neighbourhoods around `x` and `f x` on which the induced coordinate-ring map is
standard smooth. -/
private def existsAffineOpenStandardSmoothAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  ∃ U : X.affineOpens, x ∈ (U : X.Opens) ∧
    ∃ V : S.affineOpens,
      ∃ e : (U : X.Opens) ≤ f ⁻¹ᵁ (V : S.Opens),
        (f.appLE (V : S.Opens) (U : X.Opens) e).hom.IsStandardSmooth

/-- Affine neighbourhoods around `x` and `f x` carrying a finite Jacobian presentation whose
Jacobian determinant avoids the prime corresponding to `x`. -/
private def existsAffineOpenJacobianPresentationAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) : Prop :=
  ∃ U : X.affineOpens, ∃ hxU : x ∈ (U : X.Opens),
    ∃ V : S.affineOpens,
      ∃ e : (U : X.Opens) ≤ f ⁻¹ᵁ (V : S.Opens),
        let R := Γ(S, (V : S.Opens))
        let A := Γ(X, (U : X.Opens))
        letI : Algebra R A := (f.appLE (V : S.Opens) (U : X.Opens) e).hom.toAlgebra
        ∃ n c : ℕ, ∃ P : Algebra.PreSubmersivePresentation R A (Fin n) (Fin c),
          P.jacobian ∉ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal

/- Semantic recall / analogue check:
- `lean_leansearch` surfaced mathlib smoothness and standard-smooth affine-neighbourhood owners;
- local Chapter 29 precedent fixes `Scheme.Hom.fiberDimensionAt`, `Ω[f.toShHom]`, and
  `f.asFiber x` as the relevant fibre and differential surfaces.
-/

/-- Lemma 29.34.14: for a locally finitely presented morphism `f : X ⟶ S` and a point
`x : X`, with `s = f x`, the following are equivalent: `f` is smooth at `x`; the local ring map
`𝒪_{S,s} → 𝒪_{X,x}` is flat and the fibre over `s` is smooth at `x`; the same flatness holds and
the stalk `Ω[X/S]_x` is generated by at most `dim_x X_s` elements; the same flatness holds and the
two cotangent spaces in the displayed base-change identification for `Ω[X_s/s]` and `Ω[X/S]` are
generated by at most `dim_x X_s` elements; there are affine neighbourhoods on which the restricted
morphism is standard smooth; and there is an affine finite Jacobian presentation whose determinant
avoids the prime corresponding to `x`. -/
@[stacks 01V9]
theorem smoothAt_tfae_flat_stalkMap_smoothFiber_differentials_standardSmooth
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFinitePresentation f] (x : X) :
    List.TFAE
      [ f.SmoothAt x
      , flatStalkMapAndSmoothFiberAt f x
      , flatStalkMapAndDifferentialsGeneratedAt f x
      , flatStalkMapAndCotangentSpacesGeneratedAt f x
      , existsAffineOpenStandardSmoothAt f x
      , existsAffineOpenJacobianPresentationAt f x
      ] := sorry

end AlgebraicGeometry
