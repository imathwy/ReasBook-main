namespace Example29385

/-- The weighted polynomial variables `U`, `V`, and `Z` used in the double-cover algebra of
Stacks Example 29.39.5. -/
inductive WeightedVar
  | U
  | V
  | Z
  deriving DecidableEq

/-- The binary variables `U` and `V` for the source polynomial ring `k[U,V]`. -/
inductive BinaryVar
  | U
  | V
  deriving DecidableEq

/-- The polynomial ring `k[U,V,Z]` used for the weighted double-cover algebra. -/
abbrev PolynomialRing (k : Type u) [CommRing k] := MvPolynomial WeightedVar k

/-- The polynomial ring `k[U,V]` of binary forms. -/
abbrev BinaryFormRing (k : Type u) [CommRing k] := MvPolynomial BinaryVar k

/-- The weighted grading for the double-cover algebra: `deg(U)=deg(V)=1` and `deg(Z)=d`. -/
def weight (d : ℕ) : WeightedVar → ℤ
  | .U ↦ 1
  | .V ↦ 1
  | .Z ↦ d

/-- The standard degree-one grading on the binary-form ring `k[U,V]`. -/
def binaryWeight : BinaryVar → ℤ
  | .U ↦ 1
  | .V ↦ 1

section

variable {k : Type u} [CommRing k]

local notation "P" => PolynomialRing k
local notation "B" => BinaryFormRing k

/-- The distinguished weighted variable `U` in `k[U,V,Z]`. -/
abbrev U : P :=
  X WeightedVar.U

/-- The distinguished weighted variable `V` in `k[U,V,Z]`. -/
abbrev V : P :=
  X WeightedVar.V

/-- The distinguished weighted variable `Z` in `k[U,V,Z]`. -/
abbrev Z : P :=
  X WeightedVar.Z

/-- The inclusion of binary forms into the weighted polynomial ring, sending `U` and `V` to the
variables with the same names. -/
def binaryInclusion : B →ₐ[k] P :=
  MvPolynomial.rename fun
    | .U ↦ WeightedVar.U
    | .V ↦ WeightedVar.V

@[simp] theorem binaryInclusion_U :
    binaryInclusion (X BinaryVar.U : B) = (U : P) := by
  simp [binaryInclusion, U, MvPolynomial.rename_X]

@[simp] theorem binaryInclusion_V :
    binaryInclusion (X BinaryVar.V : B) = (V : P) := by
  simp [binaryInclusion, V, MvPolynomial.rename_X]

/-- The defining relation `Z^2 - ∏ (U - λ_i V)` of the weighted double-cover algebra. -/
def relation (d : ℕ) (lam : Fin (2 * d) → k) : P :=
  Z ^ 2 - ∏ i, (U - C (lam i) * V)

/-- The principal ideal generated by the double-cover relation. -/
def ideal (d : ℕ) (lam : Fin (2 * d) → k) : Ideal P :=
  Ideal.span ({relation d lam} : Set P)

/-- The weighted graded `k`-algebra
`A_d = k[U,V,Z]/(Z^2 - \prod_{i=1}^{2d}(U - \lambda_i V))` from Stacks Example 29.39.5. -/
abbrev Ring (d : ℕ) (lam : Fin (2 * d) → k) : Type u := P ⧸ ideal d lam

/-- The quotient map from `k[U,V,Z]` to the weighted double-cover algebra. -/
def quotientMap (d : ℕ) (lam : Fin (2 * d) → k) : P →ₐ[k] Ring d lam :=
  Ideal.Quotient.mkₐ k (ideal d lam)

/-- The defining relation of the weighted double-cover algebra vanishes in the quotient ring. -/
@[simp] theorem quotientMap_relation_eq_zero (d : ℕ) (lam : Fin (2 * d) → k) :
    quotientMap d lam (relation d lam) = 0 := by
  exact Ideal.Quotient.eq_zero_iff_mem.2 <|
    Ideal.subset_span (by simp : relation d lam ∈ ({relation d lam} : Set P))

/-- The degree-`n` subspace of binary forms in `k[U,V]`. -/
def binaryDegreePiece (n : ℤ) : Submodule k B :=
  weightedHomogeneousSubmodule k binaryWeight n

section

variable (d : ℕ) (lam : Fin (2 * d) → k)

local notation "A" => Ring d lam

/-- The weighted degree-`n` subspace of `k[U,V,Z]`. This is the polynomial-ring owner that the
quotient degree pieces are built from. -/
def polynomialDegreePiece (n : ℤ) : Submodule k P :=
  weightedHomogeneousSubmodule k (weight d) n

/-- The weighted degree-`n` piece of `A_d`, defined as the image of the weighted-homogeneous
degree-`n` submodule of `k[U,V,Z]` in the quotient. -/
def degreePiece (n : ℤ) : Submodule k A :=
  (polynomialDegreePiece d n).map (quotientMap d lam).toLinearMap

/-- The algebra map from binary forms to the weighted double-cover algebra obtained by including
`k[U,V]` into `k[U,V,Z]` and then quotienting by the relation. -/
def binaryToRing : B →ₐ[k] A :=
  (quotientMap d lam).comp binaryInclusion

@[simp] theorem binaryToRing_U :
    binaryToRing d lam (X BinaryVar.U) = quotientMap d lam U := by
  simpa [binaryToRing] using congrArg (quotientMap d lam) binaryInclusion_U

@[simp] theorem binaryToRing_V :
    binaryToRing d lam (X BinaryVar.V) = quotientMap d lam V := by
  simpa [binaryToRing] using congrArg (quotientMap d lam) binaryInclusion_V

/-- The image in `A_d` of the degree-`n` binary forms. This is the source's `k[U,V]_n` viewed
inside the quotient algebra. -/
def binaryDegreePieceImage (n : ℤ) : Submodule k A :=
  (binaryDegreePiece n).map (binaryToRing d lam).toLinearMap

/-- The defining relation of the weighted double-cover algebra is homogeneous of weighted degree
`2d`. -/
theorem relation_mem_weightedDegree :
    relation d lam ∈ polynomialDegreePiece d (2 * d : ℤ) := sorry

/- Companion algebraic obstruction: for the weighted double-cover algebra
`A_d = k[U,V,Z]/(Z^2 - \prod_{i=1}^{2d}(U - \lambda_i V))`, every weighted degree-`n` piece with
`n < d` is already represented by binary forms in `U` and `V`. This is the explicit algebraic
obstruction used in the source proof that `\mathcal O_{X_d}(n)` is not very ample for `n < d`. -/
theorem degreePiece_eq_binaryForms_of_lt {n : ℕ} (hn : n < d) :
    degreePiece d lam n = binaryDegreePieceImage d lam n := sorry

/-- For `n < d`, membership in the weighted degree-`n` piece of `A_d` is equivalent to being
represented by the image of a degree-`n` binary form. This is the pointwise source-facing form of
`degreePiece_eq_binaryForms_of_lt`. -/
theorem mem_degreePiece_iff_mem_binaryDegreePieceImage_of_lt {n : ℕ} (hn : n < d) {x : A} :
    x ∈ degreePiece d lam n ↔ x ∈ binaryDegreePieceImage d lam n := by
  rw [degreePiece_eq_binaryForms_of_lt d lam hn]

end

end

section RelativeVeryAmpleBridge

variable {k : Type u} [Field k]

local notation "S" => Spec (CommRingCat.of k)

/-- A source-model realization of Stacks Example 29.39.5 on an invertible sheaf `L`: for every
`m < d`, the global sections of `L^{\otimes m}` identify with the weighted degree-`m` piece of the
double-cover algebra. This is the bridge from the explicit graded-ring computation to the Chapter
29 sheaf-theoretic owner. -/
def MatchesDoubleCoverModel
    {X : Scheme.{u}} (L : X.Modules) [Scheme.Modules.Invertible L]
    (d : ℕ) (lam : Fin (2 * d) → k) : Prop :=
  ∀ {m : ℕ}, m < d → Γ((inferInstance : Scheme.Modules.Invertible L) m, ⊤) ≃ degreePiece d lam m

/-- If the tensor powers of an invertible sheaf over `\operatorname{Spec}(k)` realize the weighted
double-cover model of Stacks Example 29.39.5, then for `n < d` the twist `L^{\otimes n}` is not
relatively very ample. This is the source-facing Chapter 29 endpoint corresponding to the
companion graded-ring obstruction above. -/
@[stacks 01VP]
theorem tensorPower_not_relativelyVeryAmple_of_lt
    (d : ℕ) (lam : Fin (2 * d) → k) {X : Scheme.{u}} (f : X ⟶ S) (L : X.Modules)
    [f.FiniteType]
    [Scheme.Modules.Invertible L]
    (hmodel : MatchesDoubleCoverModel L d lam)
    {n : ℕ} (hn : n < d) :
    ¬ RelativelyVeryAmple f ((inferInstance : Scheme.Modules.Invertible L) n) := sorry

end RelativeVeryAmpleBridge

