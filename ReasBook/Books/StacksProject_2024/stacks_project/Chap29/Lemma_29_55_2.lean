/-- Lemma 29.55.2: let `A → B` be a ring map inducing a dominant morphism
`Spec(B) → Spec(A)`. For any multiplicative subset `S ⊆ A`, formation of the subalgebra
`B' ⊆ B` from Lemma 29.55.1 commutes with localization: the `S⁻¹A`-subalgebra of `S⁻¹B`
generated by the image of `B'` is the subalgebra obtained by applying Lemma 29.55.1 to the
localized map `S⁻¹A → S⁻¹B`. -/
@[stacks 0H3K]
theorem weakNormalizationSubalgebra_localization_eq
    (hAB : IsDominant (Spec.map (CommRingCat.ofHom (algebraMap A B))))
    (B' : Subalgebra A B)
    (hBprimeUniversalHomeomorphism :
      UniversalHomeomorphism (Spec.map (CommRingCat.ofHom (algebraMap A B'))))
    (hBprimeMaximal :
      ∀ {C : Type u} [CommRing C] [Algebra A C] [Algebra C B] [IsScalarTower A C B],
        UniversalHomeomorphism (Spec.map (CommRingCat.ofHom (algebraMap A C))) →
        ∀ c : C, algebraMap C B c ∈ B')
    (Bₛ' : Subalgebra Aₛ Bₛ)
    (hBsPrimeUniversalHomeomorphism :
      UniversalHomeomorphism (Spec.map (CommRingCat.ofHom (algebraMap Aₛ Bₛ'))))
    (hBsPrimeMaximal :
      ∀ {C : Type u} [CommRing C] [Algebra Aₛ C] [Algebra C Bₛ] [IsScalarTower Aₛ C Bₛ],
        UniversalHomeomorphism (Spec.map (CommRingCat.ofHom (algebraMap Aₛ C))) →
        ∀ c : C, algebraMap C Bₛ c ∈ Bₛ') :
    Algebra.adjoin Aₛ ((algebraMap B Bₛ) '' (B' : Set B)) = Bₛ' := sorry

end

end AlgebraicGeometry
