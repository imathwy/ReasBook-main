open AlgebraicGeometry CategoryTheory
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry

variable {B : Type u} [CommRing B]

-- Semantic recall: `lean_leansearch` surfaced `PrimeSpectrum.isHomeomorph_comap` as the affine
-- spectrum homeomorphism criterion; local Section 29.46 precedent supplies the scheme-level
-- `UniversalHomeomorphism` owner and the subring-adjoin tower shape. The Stacks tag evidence is
-- consistent: item tag `0CNE` agrees with the source URL ending in `/tag/0CNE`.

/-- The finite square-cube-or-prime-power adjoining condition: every finite subset of `B` is
contained in a subalgebra generated by a finite sequence `b`, where at each step either the square
and cube of `b i` already lie in the subalgebra generated by the earlier entries, or for some prime
number `p` both `p * b i` and `(b i) ^ p` lie there. -/
@[stacks 0CNE]
def EveryFiniteSubsetContainedInSqCubeOrPrimePowerAdjoinTower (A : Subring B) : Prop :=
  letI : Algebra A B := A.subtype.toAlgebra
  ∀ E : Finset B, ∃ (n : ℕ) (b : Fin n → B),
    (∀ i : Fin n,
      (b i ^ 2 ∈
            Algebra.adjoin A
              (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩)) ∧
          b i ^ 3 ∈
            Algebra.adjoin A
              (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩))) ∨
        ∃ p : ℕ, Nat.Prime p ∧
          (p : B) * b i ∈
              Algebra.adjoin A
                (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩)) ∧
            b i ^ p ∈
              Algebra.adjoin A
                (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩))) ∧
      ∀ e ∈ E, e ∈ Algebra.adjoin A (Set.range b)

/-- Unfolding form of the finite square-cube-or-prime-power adjoining condition. -/
theorem everyFiniteSubsetContainedInSqCubeOrPrimePowerAdjoinTower_iff (A : Subring B) :
    EveryFiniteSubsetContainedInSqCubeOrPrimePowerAdjoinTower A ↔
      letI : Algebra A B := A.subtype.toAlgebra
      ∀ E : Finset B, ∃ (n : ℕ) (b : Fin n → B),
        (∀ i : Fin n,
          (b i ^ 2 ∈
                Algebra.adjoin A
                  (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩)) ∧
              b i ^ 3 ∈
                Algebra.adjoin A
                  (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩))) ∨
            ∃ p : ℕ, Nat.Prime p ∧
              (p : B) * b i ∈
                  Algebra.adjoin A
                    (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩)) ∧
                b i ^ p ∈
                  Algebra.adjoin A
                    (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩))) ∧
          ∀ e ∈ E, e ∈ Algebra.adjoin A (Set.range b) := sorry

/-- Proposition 29.46.8: for a ring extension `A ⊆ B`, the affine spectrum map
`Spec(B) → Spec(A)` is a universal homeomorphism iff every finite subset of `B` is contained in a
finite tower obtained by adjoining elements where each new generator satisfies either the
square-cube condition or a prime-power condition over the previously generated subalgebra. -/
@[stacks 0CNE]
theorem universalHomeomorphism_iff_everyFiniteSubset_sqCubeOrPrimePowerAdjoinTower
    (A : Subring B) :
    UniversalHomeomorphism (Spec.map (CommRingCat.ofHom A.subtype)) ↔
      EveryFiniteSubsetContainedInSqCubeOrPrimePowerAdjoinTower A := sorry

end AlgebraicGeometry
