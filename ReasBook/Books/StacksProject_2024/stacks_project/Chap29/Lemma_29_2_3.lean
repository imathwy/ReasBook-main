import Mathlib
import StacksProject_2024.Chap26.Definition_26_4_4
import StacksProject_2024.Chap26.Lemma_26_10_1

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open CategoryTheory

universe u

namespace AlgebraicGeometry

section

variable {X : Scheme.{u}}

local notation "ModX" => X.Modules
local notation "𝒪X" => (SheafOfModules.unit X.ringCatSheaf : ModX)

/- Bridge/view: Lemma 29.2.3 is source-facing about ideal subsheaves of `\mathcal O_X`, but the
canonical closed-subscheme owner in the repository is `X.IdealSheafData`, and the canonical
closed-immersion ideal-sheaf bridge is `closedImmersionIdealSubobject i`, while the closed
subscheme owner is `X.IdealSheafData`. The realization and comparison clauses therefore use the
underlying ideal subsheaf of `𝒪_X` directly. -/

-- Semantic recall / owner check:
-- the earlier Chapter 26 bridge `schemeIdealSheaf_locallyGenerated_iff_isQuasicoherent` already
-- fixes the canonical owners `SheafOfModules.LocalGeneratorsData` and
-- `SheafOfModules.IsQuasicoherent` for an ideal subsheaf `I : Subobject 𝒪X`, viewed as the module
-- `(I : ModX)`. The closed-immersion realization clauses use the canonical scheme-level kernel
-- ideal owner `i.ker`, viewed as a subobject of `𝒪_X`, rather than a duplicate local wrapper.

/-- Lemma 29.2.3 (1): for a scheme `X` and an ideal sheaf `\mathcal I \subset \mathcal O_X`,
`\mathcal I` is locally generated by sections as an `\mathcal O_X`-module if and only if it is
quasi-coherent as an `\mathcal O_X`-module. -/
theorem idealSheaf_locallyGenerated_iff_isQuasicoherent
    (I : Subobject 𝒪X) :
    Nonempty ((Subobject.underlying.obj I : ModX).LocalGeneratorsData) ↔
      (Subobject.underlying.obj I : ModX).IsQuasicoherent := by
  simpa using schemeIdealSheaf_locallyGenerated_iff_isQuasicoherent (X := X) I

/-- Lemma 29.2.3 (2): if an ideal sheaf `\mathcal I \subset \mathcal O_X` is locally generated by
sections as an `\mathcal O_X`-module, then it is the kernel ideal sheaf of some closed immersion
of schemes into `X`. -/
theorem exists_closedImmersion_of_idealSheaf_locallyGenerated
    (I : Subobject 𝒪X)
    (hI : Nonempty ((Subobject.underlying.obj I : ModX).LocalGeneratorsData)) :
    ∃ J : X.IdealSheafData,
      closedImmersionIdealSubobject J.subschemeι = I := sorry

/-- Lemma 29.2.3 (3): if an ideal sheaf `\mathcal I \subset \mathcal O_X` is the kernel ideal
sheaf of a closed immersion `i : Z \to X`, then `\mathcal I` is quasi-coherent as an
`\mathcal O_X`-module. -/
theorem idealSheaf_isQuasicoherent_of_closedImmersion_kernel_eq
    (I : Subobject 𝒪X) {Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (hker : closedImmersionIdealSubobject i = I) :
    (Subobject.underlying.obj I : ModX).IsQuasicoherent := sorry

end

end AlgebraicGeometry
