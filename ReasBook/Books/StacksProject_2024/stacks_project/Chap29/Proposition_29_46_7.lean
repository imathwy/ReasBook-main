variable {B : Type u} [CommRing B]

-- Semantic recall: `lean_leansearch` surfaced `Scheme.Hom.residueFieldMap` as the canonical
-- residue-field map API, and local Section 29.46 files use the source-facing
-- `UniversalHomeomorphism` owner for affine spectra. The Stacks tag evidence is consistent:
-- item tag `0CND` agrees with the source URL ending in `/tag/0CND`.

/-- The finite square-cube adjoining condition: every finite subset of `B` is contained in a
subalgebra generated by a finite sequence `b`, where each square and cube of `b i` already lies in
the subalgebra generated by the earlier entries. -/
def EveryFiniteSubsetContainedInSqCubeAdjoinTower (A : Subring B) : Prop :=
  letI : Algebra A B := A.subtype.toAlgebra
  ∀ E : Finset B, ∃ (n : ℕ) (b : Fin n → B),
    (∀ i : Fin n,
      b i ^ 2 ∈
          Algebra.adjoin A
            (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩)) ∧
        b i ^ 3 ∈
          Algebra.adjoin A
            (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩))) ∧
      ∀ e ∈ E, e ∈ Algebra.adjoin A (Set.range b)

/-- Unfolding form of the finite square-cube adjoining condition. -/
theorem everyFiniteSubsetContainedInSqCubeAdjoinTower_iff (A : Subring B) :
    EveryFiniteSubsetContainedInSqCubeAdjoinTower A ↔
      letI : Algebra A B := A.subtype.toAlgebra
      ∀ E : Finset B, ∃ (n : ℕ) (b : Fin n → B),
        (∀ i : Fin n,
          b i ^ 2 ∈
              Algebra.adjoin A
                (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩)) ∧
            b i ^ 3 ∈
              Algebra.adjoin A
                (Set.range (fun j : Fin i.val ↦ b ⟨j, Nat.lt_trans j.isLt i.isLt⟩))) ∧
          ∀ e ∈ E, e ∈ Algebra.adjoin A (Set.range b) := sorry

/-- Proposition 29.46.7: for a ring extension `A ⊆ B`, the affine spectrum map
`Spec(B) → Spec(A)` is a universal homeomorphism inducing isomorphisms on residue fields iff
every finite subset of `B` is contained in a finite tower obtained by adjoining elements whose
squares and cubes lie in the previously generated subalgebra. -/
@[stacks 0CND]
theorem universalHomeomorphism_residueFieldMap_isIso_iff_everyFiniteSubset_sqCubeAdjoinTower
    (A : Subring B) :
    (UniversalHomeomorphism (Spec.map (CommRingCat.ofHom A.subtype)) ∧
      ∀ x : Spec (CommRingCat.of B),
        IsIso ((Spec.map (CommRingCat.ofHom A.subtype)).residueFieldMap x)) ↔
      EveryFiniteSubsetContainedInSqCubeAdjoinTower A := sorry

end AlgebraicGeometry
