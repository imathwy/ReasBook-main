/-- Lemma 29.55.4: let `A → B` be a ring map inducing a dominant morphism
`Spec(B) → Spec(A)`. For any multiplicative subset `S ⊆ A`, formation of the
`A`-subalgebra `B' ⊆ B` from Lemma 29.55.3 commutes with localization: the
`S⁻¹A`-subalgebra of `S⁻¹B` generated by the image of `B'` is the subalgebra obtained by
applying Lemma 29.55.3 to the localized map `S⁻¹A → S⁻¹B`. -/
@[stacks 0H3M]
theorem weakNormalizationSubalgebra_residueFieldMap_localization_eq
    (hAB : IsDominant (Spec.map (CommRingCat.ofHom (algebraMap A B))))
    (B' : Subalgebra A B) (hB' : IsWeakNormalizationSubalgebra A B B')
    (Bₛ' : Subalgebra Aₛ Bₛ) (hBₛ' : IsWeakNormalizationSubalgebra Aₛ Bₛ Bₛ') :
    Algebra.adjoin Aₛ ((algebraMap B Bₛ) '' (B' : Set B)) = Bₛ' := sorry

end

