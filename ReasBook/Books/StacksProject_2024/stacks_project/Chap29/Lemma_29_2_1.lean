import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
import StacksProject_2024.stacks_project.Chap17.Definition_17_13_1_Owner

-- Declarations for this item will be appended below by the statement pipeline.

open AlgebraicGeometry
open CategoryTheory
open scoped AlgebraicGeometry

noncomputable section

universe u

namespace AlgebraicGeometry

-- Semantic recall: `lean_leansearch` surfaced the canonical affine criterion
-- `AlgebraicGeometry.isClosedImmersion_iff_isAffineHom` and the local affine owner
-- `AlgebraicGeometry.IsClosedImmersion.Spec_iff`. The remaining source equivalences here stay as
-- source-faithful companion theorems around the existing scheme-level closed-immersion owner and
-- the Chapter 17 ringed-space kernel-ideal-sheaf side conditions.

section

variable {X Z : Scheme.{u}} (i : Z ⟶ X)

open RingedSpace

local notation "φi" => Hom.commRingSheafPushforwardMap i.toShHom
local notation "𝓘" => closedImmersionIdealSheaf i.toShHom

/- Lemma 29.2.1 (1): a morphism of schemes is a closed immersion if and only if it is affine and,
for every affine open `U ⊆ X`, the induced map on sections `Γ(X, U) → Γ(Z, i^{-1}(U))` is
surjective. This is exactly the canonical affine-local quotient presentation
`AlgebraicGeometry.isClosedImmersion_iff_isAffineHom`. -/
#check AlgebraicGeometry.isClosedImmersion_iff_isAffineHom

/-- Lemma 29.2.1 (2): a morphism of schemes is a closed immersion if and only if there exists an
affine open covering of `X` such that over each covering member the inverse-image scheme is affine
and the induced map on global sections is surjective. This is the affine-cover version of the
source quotient presentation `i^{-1}(U_j) = Spec(R_j / I_j)` over `U_j = Spec(R_j)`. -/
theorem isClosedImmersion_iff_exists_affineOpenCover_preimageAffine_and_appTopSurjective :
    IsClosedImmersion i ↔
      ∃ 𝒰 : X.AffineOpenCover,
        ∀ j : 𝒰.I₀,
          IsAffineOpen (i ⁻¹ᵁ (𝒰.f j).opensRange) ∧
            Function.Surjective ((i ∣_ (𝒰.f j).opensRange).appTop) := sorry

/-- Lemma 29.2.1 (3): a morphism of schemes is a closed immersion if and only if the underlying
map of spaces is a closed embedding and the structure-sheaf map
`\mathcal O_X \to i_* \mathcal O_Z` is locally surjective. This is the canonical sheaf-theoretic
owner form of the source condition that `i` identify `Z` homeomorphically with a closed subset of
`X` and that `i^\sharp` be surjective. -/
theorem isClosedImmersion_iff_isClosedEmbedding_and_structureSheafMapLocallySurjective :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective φi := sorry

/-- Lemma 29.2.1 (4): a morphism of schemes is a closed immersion if and only if the underlying
map of spaces is a closed embedding, the structure-sheaf map
`\mathcal O_X \to i_* \mathcal O_Z` is locally surjective, and its kernel ideal sheaf is
quasi-coherent. -/
theorem
    isClosedImmersion_iff_isClosedEmbedding_and_structureSheafMapLocallySurjective_and_kernelIsQuasiCoherent :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective φi ∧
          𝓘.IsQuasicoherent := sorry

/-- Lemma 29.2.1 (5): a morphism of schemes is a closed immersion if and only if the underlying
map of spaces is a closed embedding, the structure-sheaf map
`\mathcal O_X \to i_* \mathcal O_Z` is locally surjective, and its kernel ideal sheaf is locally
generated by sections. The canonical owner for this condition is
`Nonempty 𝓘.LocalGeneratorsData`, whose pointwise reformulation is already owned by
`SheafOfModules.nonempty_localGeneratorsData_iff_pointwise`. -/
theorem
    isClosedImmersion_iff_isClosedEmbedding_and_structureSheafMapLocallySurjective_and_kernelLocallyGenerated :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.base ∧
        Sheaf.IsLocallySurjective φi ∧
          Nonempty 𝓘.LocalGeneratorsData := sorry

end

end AlgebraicGeometry
