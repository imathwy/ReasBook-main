/-- Helper for Lemma 22.38.1: evaluating the factorization of a one-step extension on a
homogeneous element of the previous stage recovers the original target map. -/
theorem toTarget_comp_inclusion_apply (i : ℤ) (a : A.X i) :
    E.toTarget i (E.inclusion i a) = f i a := by
  -- Evaluate the structural factorization equality degreewise on the chosen homogeneous element.
  simpa using congrArg (fun g : CochainDGAlgebra.Hom A B ↦ g i a) E.toTarget_comp_inclusion

/-- Helper for Lemma 22.38.1: differentiating a newly adjoined generator and then mapping to the
target recovers the prescribed image of the killing cycle. -/
theorem map_d_adjoinedGenerator (i : ℤ) (s : δ.generators i) :
    E.toTarget (i + 1) (E.extension.d i (E.adjoinedGenerator i s)) =
      f (i + 1) (δ.cycle i s) := by
  -- Commute the differential through the target map and rewrite the generator image by the chosen
  -- primitive in `B`.
  rw [CochainDGAlgebra.map_d_apply, E.toTarget_adjoinedGenerator]
  exact δ.primitive_boundary i s

/-- Helper for Lemma 22.38.1: the prescribed differential formula for a new generator is
compatible with the factorization back to the original target map. -/
theorem toTarget_inclusion_cycle (i : ℤ) (s : δ.generators i) :
    E.toTarget (i + 1) (E.inclusion (i + 1) (δ.cycle i s)) =
      f (i + 1) (δ.cycle i s) := by
  -- Rewrite the inclusion image as the differential of the new generator, then use the previous
  -- target-compatibility computation.
  rw [← E.differential_adjoinedGenerator i s]
  exact E.map_d_adjoinedGenerator i s

/-- Helper for Lemma 22.38.1: once the explicit one-step constructor is available, its target map
restricts to the original stage map on the old generators and hence on every homogeneous element
of the previous stage. -/
theorem ofPresentation_toTarget_comp_inclusion_apply
    (P : FreeGradedAlgebraPresentation A) (δ : AdjoinGeneratorData (f := f))
    (i : ℤ) (a : A.X i) :
    (ofPresentation (f := f) P δ).toTarget i ((ofPresentation (f := f) P δ).inclusion i a) =
      f i a := by
  -- The general factorization lemma applies directly to the concrete constructor interface.
  simpa using
    (toTarget_comp_inclusion_apply (E := ofPresentation (f := f) P δ) i a)

/-- Helper for Lemma 22.38.1: in the explicit one-step constructor interface, the prescribed
cycle still maps to the same element of the target after passing through the inclusion. -/
theorem ofPresentation_toTarget_inclusion_cycle
    (P : FreeGradedAlgebraPresentation A) (δ : AdjoinGeneratorData (f := f))
    (i : ℤ) (s : δ.generators i) :
    (ofPresentation (f := f) P δ).toTarget (i + 1)
        ((ofPresentation (f := f) P δ).inclusion (i + 1) (δ.cycle i s)) =
      f (i + 1) (δ.cycle i s) := by
  -- The concrete constructor inherits the generic compatibility between the inclusion and the
  -- target map on the chosen killing cycle.
  simpa using
    (toTarget_inclusion_cycle (E := ofPresentation (f := f) P δ) i s)

end AdjoinGeneratorExtension

/-- Helper for Lemma 22.38.1: if a cochain differential graded algebra is already free as a
graded algebra and already K-flat, then it realizes the desired resolution via the identity map. -/
theorem FreeGradedAlgebraPresentation.selfResolution
    {B : CochainDGAlgebra R} (P : FreeGradedAlgebraPresentation.{u, v} B)
    (hB : B.IsKFlat) :
    ∃ (A : CochainDGAlgebra R) (f : CochainDGAlgebra.Hom A B)
      (_P : FreeGradedAlgebraPresentation.{u, v} A),
      QuasiIso f.toCochainMap ∧ A.IsKFlat := by
  refine ⟨B, CochainDGAlgebra.Hom.id B, P, ?_, hB⟩
  -- The identity map is a quasi-isomorphism, so no further homological work is needed once the
  -- free graded presentation and K-flatness are already available on `B`.
  have hIdQuasi : QuasiIso ((CochainDGAlgebra.Hom.id B).toCochainMap) := by
    -- Normalizing the identity DGA map reduces the goal to the standard identity quasi-isomorphism.
    dsimp [CochainDGAlgebra.Hom.id]
    infer_instance
  exact hIdQuasi

/-- Helper for Lemma 22.38.1: a bounded-above freely presented cochain differential graded
algebra satisfies the resolution conclusion by combining the bounded-above K-flat bridge with the
identity-map resolution. -/
theorem FreeGradedAlgebraPresentation.selfResolution_of_boundedAbove
    {B : CochainDGAlgebra R} (P : FreeGradedAlgebraPresentation.{u, v} B)
    [CategoryTheory.LocallySmall.{0, u, u + 1} (ModuleCat.{u} R)]
    [CategoryTheory.WellPowered.{0, u, u + 1} (ModuleCat.{u} R)]
    [CategoryTheory.Limits.HasWidePullbacks (ModuleCat.{u} R)]
    [CategoryTheory.Limits.HasCoproducts (ModuleCat.{u} R)]
    [CategoryTheory.Limits.InitialMonoClass (ModuleCat.{u} R)]
    (hbounded : CochainComplex.minus (ModuleCat R) B.toCochainComplex) :
    ∃ (A : CochainDGAlgebra R) (f : CochainDGAlgebra.Hom A B)
      (_P : FreeGradedAlgebraPresentation.{u, v} A),
      QuasiIso f.toCochainMap ∧ A.IsKFlat := by
  -- First upgrade bounded-above freeness to K-flatness on the underlying complex, then package
  -- the identity map as the required quasi-isomorphic free resolution.
  exact P.selfResolution (P.isKFlat_of_boundedAbove hbounded)

