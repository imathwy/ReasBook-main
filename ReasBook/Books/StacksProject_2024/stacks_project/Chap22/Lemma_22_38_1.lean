variable {R : Type u} [CommRing R]

/-- The total degree of a word in a graded set is the sum of the degrees of its letters. -/
def gradedWordDegree (S : ℤ → Type v) : List (Sigma S) → ℤ
  | [] => 0
  | x :: xs => x.1 + gradedWordDegree S xs

/-- Words in the graded set `S` whose total degree is exactly `n`. -/
def GradedWordsOfDegree (S : ℤ → Type v) (n : ℤ) : Type v :=
  { w : List (Sigma S) // gradedWordDegree S w = n }

/-- The empty word has total degree `0`. -/
theorem gradedWordDegree_nil (S : ℤ → Type v) :
    gradedWordDegree S ([] : List (Sigma S)) = 0 := rfl

/-- The total degree of a concatenated word is the sum of the total degrees. -/
theorem gradedWordDegree_append (S : ℤ → Type v) (u v : List (Sigma S)) :
    gradedWordDegree S (u ++ v) = gradedWordDegree S u + gradedWordDegree S v := by
  induction u with
  | nil =>
      simp [gradedWordDegree]
  | cons x xs ih =>
      simp [gradedWordDegree, ih, add_assoc]

/-- Concatenating words of degrees `n` and `m` produces a word of degree `n + m`. -/
theorem gradedWordDegree_append_subtype
    (S : ℤ → Type v) {n m : ℤ}
    (u : GradedWordsOfDegree S n) (v : GradedWordsOfDegree S m) :
    gradedWordDegree S (u.1 ++ v.1) = n + m := by
  calc
    gradedWordDegree S (u.1 ++ v.1) = gradedWordDegree S u.1 + gradedWordDegree S v.1 :=
      gradedWordDegree_append S u.1 v.1
    _ = n + m := by simpa [u.2, v.2]

/-- The empty word viewed as a word of degree `0`. -/
def emptyGradedWord (S : ℤ → Type v) : GradedWordsOfDegree S 0 :=
  ⟨[], gradedWordDegree_nil S⟩

/-- Concatenation of homogeneous words keeps track of the resulting total degree. -/
def appendGradedWords
    (S : ℤ → Type v) {n m : ℤ}
    (u : GradedWordsOfDegree S n) (v : GradedWordsOfDegree S m) :
    GradedWordsOfDegree S (n + m) :=
  ⟨u.1 ++ v.1, gradedWordDegree_append_subtype S u v⟩

/-- A concrete free graded algebra presentation of a cochain differential graded algebra: each
graded piece has the word basis on a graded set of generators, the unit is the empty word, and
multiplication is concatenation of words. -/
structure FreeGradedAlgebraPresentation (A : CochainDGAlgebra R) where
  /-- The graded set of algebra generators. -/
  generators : ℤ → Type v
  /-- The degree-`n` piece is freely generated by words of total degree `n`. -/
  basis (n : ℤ) : Module.Basis (GradedWordsOfDegree generators n) R (A.toCochainComplex.X n)
  /-- The algebra unit is the basis vector corresponding to the empty word. -/
  one_eq_basis : A.one = basis 0 (emptyGradedWord generators)
  /-- Multiplication of basis vectors is concatenation of the corresponding words. -/
  mul_eq_basis (n m : ℤ)
      (u : GradedWordsOfDegree generators n) (v : GradedWordsOfDegree generators m) :
      A.mul n m (basis n u) (basis m v) =
        basis (n + m) (appendGradedWords generators u v)

/-- Helper for Lemma 22.38.1: a free graded algebra presentation makes each homogeneous piece of
the underlying cochain complex a free `R`-module on homogeneous words. -/
theorem FreeGradedAlgebraPresentation.isTermwiseFree
    {A : CochainDGAlgebra R} (P : FreeGradedAlgebraPresentation A) :
    A.toCochainComplex.IsTermwiseFree := by
  -- Each degree already comes with the chosen word basis from the presentation.
  intro n
  exact Module.Free.of_basis (P.basis n)

/-- Helper for Lemma 22.38.1: a free graded algebra presentation makes each homogeneous piece of
the underlying cochain complex flat over `R`. -/
theorem FreeGradedAlgebraPresentation.isTermwiseFlat
    {A : CochainDGAlgebra R} (P : FreeGradedAlgebraPresentation A) :
    A.toCochainComplex.IsTermwiseFlat := by
  -- Free modules are flat, so the previous basis description upgrades degreewise to flatness.
  intro n
  let _ : Module.Free R (A.toCochainComplex.X n : Type u) := P.isTermwiseFree n
  exact Module.Flat.of_free

/-- Helper for Lemma 22.38.1: if a freely presented cochain differential graded algebra is
bounded above, then its underlying cochain complex is K-flat. The bounded-above hypothesis is the
extra source-faithful input needed to apply the Chapter 15 flat-implies-K-flat criterion. -/
theorem FreeGradedAlgebraPresentation.isKFlat_of_boundedAbove
    {A : CochainDGAlgebra R} (P : FreeGradedAlgebraPresentation A)
    [CategoryTheory.LocallySmall.{0, u, u + 1} (ModuleCat.{u} R)]
    [CategoryTheory.WellPowered.{0, u, u + 1} (ModuleCat.{u} R)]
    [CategoryTheory.Limits.HasWidePullbacks (ModuleCat.{u} R)]
    [CategoryTheory.Limits.HasCoproducts (ModuleCat.{u} R)]
    [CategoryTheory.Limits.InitialMonoClass (ModuleCat.{u} R)]
    (hbounded : CochainComplex.minus (ModuleCat R) A.toCochainComplex) :
    A.toCochainComplex.IsKFlat := by
  -- The presentation gives termwise flatness, and the Chapter 15 bounded-above bridge upgrades
  -- that termwise control to K-flatness on the underlying cochain complex.
  exact CochainComplex.isKFlat_of_boundedAbove_of_flat A.toCochainComplex hbounded
    P.isTermwiseFlat

namespace CochainDGAlgebra

/-- A cochain differential graded algebra is K-flat when its underlying cochain complex is
K-flat. This is the DGA-level bridge to the Chapter 15 canonical owner on cochain complexes. -/
abbrev IsKFlat (A : CochainDGAlgebra R) : Prop :=
  A.toCochainComplex.IsKFlat

/-- The DGA-level K-flatness bridge is exactly the Chapter 15 owner on the underlying cochain
complex. -/
theorem isKFlat_iff (A : CochainDGAlgebra R) :
    A.IsKFlat ↔ A.toCochainComplex.IsKFlat :=
  Iff.rfl

end CochainDGAlgebra

/-- Helper for Lemma 22.38.1: the data needed to adjoin new free generators to a map of cochain
differential graded algebras. For a new generator of degree `i`, we record the prescribed
differential in the source algebra and a primitive in the target algebra witnessing that this
cycle dies after mapping to the target. -/
structure AdjoinGeneratorData
    {A B : CochainDGAlgebra R} (f : CochainDGAlgebra.Hom A B) where
  /-- The new generators grouped by their intended cochain degree. -/
  generators : ℤ → Type v
  /-- The chosen differential of a degree-`i` generator lands in degree `i + 1` of `A`. -/
  cycle : ∀ i : ℤ, generators i → A.X (i + 1)
  /-- The chosen differential is already closed in `A`. -/
  cycle_closed : ∀ i : ℤ, ∀ s : generators i, A.d (i + 1) (cycle i s) = 0
  /-- The image of the chosen differential in `B` is recorded as a boundary. -/
  primitive : ∀ i : ℤ, generators i → B.X i
  /-- The chosen primitive in `B` has boundary equal to the image of the chosen cycle. -/
  primitive_d : ∀ i : ℤ, ∀ s : generators i, B.d i (primitive i s) = f (i + 1) (cycle i s)

namespace AdjoinGeneratorData

variable {A B : CochainDGAlgebra R} {f : CochainDGAlgebra.Hom A B}

/-- Helper for Lemma 22.38.1: the chosen primitive in the target really has boundary equal to the
image of the prescribed cycle. This is the source-facing boundary condition used in the kernel
killing step. -/
theorem primitive_boundary
    (δ : AdjoinGeneratorData (f := f)) (i : ℤ) (s : δ.generators i) :
    B.d i (δ.primitive i s) = f (i + 1) (δ.cycle i s) :=
  δ.primitive_d i s

/-- Helper for Lemma 22.38.1: the image in `B` of a prescribed generator differential is still a
cycle. This is the compatibility needed before turning the adjoin-generator data into an actual
one-step DGA extension. -/
theorem map_cycle_closed
    (δ : AdjoinGeneratorData (f := f)) (i : ℤ) (s : δ.generators i) :
    B.d (i + 1) (f (i + 1) (δ.cycle i s)) = 0 := by
  -- Commute the source differential through `f` and then use that the prescribed cycle is closed.
  have hmap := CochainDGAlgebra.map_d_apply f (i + 1) (δ.cycle i s)
  rw [δ.cycle_closed i s] at hmap
  simpa using hmap.symm

/-- Helper for Lemma 22.38.1: applying the differential twice to the chosen primitive in `B`
vanishes because its first differential is the image of a closed source cycle. -/
theorem primitive_boundary_closed
    (δ : AdjoinGeneratorData (f := f)) (i : ℤ) (s : δ.generators i) :
    B.d (i + 1) (B.d i (δ.primitive i s)) = 0 := by
  -- Rewrite the first boundary using the chosen adjoin-generator data and close the result by the
  -- previous cycle lemma.
  rw [δ.primitive_boundary i s]
  exact δ.map_cycle_closed i s

end AdjoinGeneratorData

/-- Helper for Lemma 22.38.1: a one-step semi-free extension attached to adjoin-generator data.
It packages the extended cochain differential graded algebra, the inclusion of the previous
stage, the map to the target algebra, a free graded presentation of the extension, and chosen new
homogeneous generators realizing the prescribed differential and target primitive. -/
structure AdjoinGeneratorExtension
    {A B : CochainDGAlgebra R} {f : CochainDGAlgebra.Hom A B}
    (δ : AdjoinGeneratorData (f := f)) where
  /-- The extended cochain differential graded algebra obtained by adjoining the new generators. -/
  extension : CochainDGAlgebra R
  /-- The previous stage includes into the extension. -/
  inclusion : CochainDGAlgebra.Hom A extension
  /-- The extension maps to the fixed target algebra. -/
  toTarget : CochainDGAlgebra.Hom extension B
  /-- The extension remains free as a graded algebra on a chosen graded set of generators. -/
  presentation : FreeGradedAlgebraPresentation extension
  /-- The chosen new homogeneous generators inside the extension. -/
  adjoinedGenerator : ∀ i : ℤ, δ.generators i → extension.X i
  /-- The differential of a new generator is the prescribed cycle from the previous stage. -/
  differential_adjoinedGenerator :
    ∀ i : ℤ, ∀ s : δ.generators i,
      extension.d i (adjoinedGenerator i s) = inclusion (i + 1) (δ.cycle i s)
  /-- The target map sends each new generator to the chosen primitive in `B`. -/
  toTarget_adjoinedGenerator :
    ∀ i : ℤ, ∀ s : δ.generators i,
      toTarget i (adjoinedGenerator i s) = δ.primitive i s
  /-- Restricting the target map along the inclusion recovers the previous-stage map. -/
  toTarget_comp_inclusion :
    CochainDGAlgebra.Hom.comp toTarget inclusion = f

namespace AdjoinGeneratorExtension

variable {A B : CochainDGAlgebra R} {f : CochainDGAlgebra.Hom A B}
