open CategoryTheory
open CategoryTheory.Limits
open CategoryTheory.ObjectProperty

noncomputable section

universe w v u

namespace CategoryTheory

-- Semantic recall note: mathlib already packages the closure conditions on an `ObjectProperty`
-- through `IsClosedUnderColimitsOfShape (Discrete ι)` and
-- `IsTriangulatedClosed₁`/`₂`/`₃`. The source-facing recursive closure generated by the shifts
-- `A[k]` remains local to this remark, while the companion theorem below exposes the induction
-- step through those canonical owner classes for downstream reuse.

section

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasZeroObject D]
variable [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
variable [HasCoproducts.{w} D]

/-- The closure of a chosen shifted family under arbitrary coproducts and two-out-of-three for
distinguished triangles. In the source application, `Ashift k` is the object `A[k]` of
`D(A, d)`. -/
inductive ShiftCoproductTriangleClosure (Ashift : ℤ → D) : D → Prop
  | shift (k : ℤ) :
      ShiftCoproductTriangleClosure Ashift (Ashift k)
  | coproduct {ι : Type w} (K : ι → D)
      (hK : ∀ i, ShiftCoproductTriangleClosure Ashift (K i)) :
      ShiftCoproductTriangleClosure Ashift (∐ fun i ↦ K i)
  | triangle₁ {Δ : Pretriangulated.Triangle D}
      (hΔ : Δ ∈ Pretriangulated.distinguishedTriangles)
      (h₂ : ShiftCoproductTriangleClosure Ashift Δ.obj₂)
      (h₃ : ShiftCoproductTriangleClosure Ashift Δ.obj₃) :
      ShiftCoproductTriangleClosure Ashift Δ.obj₁
  | triangle₂ {Δ : Pretriangulated.Triangle D}
      (hΔ : Δ ∈ Pretriangulated.distinguishedTriangles)
      (h₁ : ShiftCoproductTriangleClosure Ashift Δ.obj₁)
      (h₃ : ShiftCoproductTriangleClosure Ashift Δ.obj₃) :
      ShiftCoproductTriangleClosure Ashift Δ.obj₂
  | triangle₃ {Δ : Pretriangulated.Triangle D}
      (hΔ : Δ ∈ Pretriangulated.distinguishedTriangles)
      (h₁ : ShiftCoproductTriangleClosure Ashift Δ.obj₁)
      (h₂ : ShiftCoproductTriangleClosure Ashift Δ.obj₂) :
      ShiftCoproductTriangleClosure Ashift Δ.obj₃

namespace ShiftCoproductTriangleClosure

section

variable {Ashift : ℤ → D}

/-- The chosen shifted family is contained in the closure it generates. -/
theorem ofObj_le : ObjectProperty.ofObj Ashift ≤ ShiftCoproductTriangleClosure Ashift := by
  intro X hX
  rcases hX with ⟨k⟩
  simpa using (ShiftCoproductTriangleClosure.shift k : ShiftCoproductTriangleClosure Ashift (Ashift k))

/-- The generated closure satisfies the first triangulated two-out-of-three implication. -/
instance isTriangulatedClosed₁ :
    ObjectProperty.IsTriangulatedClosed₁
      (ShiftCoproductTriangleClosure Ashift : ObjectProperty D) where
  ext₁' _ hΔ h₂ h₃ :=
    ObjectProperty.le_isoClosure (ShiftCoproductTriangleClosure Ashift) _
      (.triangle₁ hΔ h₂ h₃)

/-- The generated closure satisfies the second triangulated two-out-of-three implication. -/
instance isTriangulatedClosed₂ :
    ObjectProperty.IsTriangulatedClosed₂
      (ShiftCoproductTriangleClosure Ashift : ObjectProperty D) where
  ext₂' _ hΔ h₁ h₃ :=
    ObjectProperty.le_isoClosure (ShiftCoproductTriangleClosure Ashift) _
      (.triangle₂ hΔ h₁ h₃)

/-- The generated closure satisfies the third triangulated two-out-of-three implication. -/
instance isTriangulatedClosed₃ :
    ObjectProperty.IsTriangulatedClosed₃
      (ShiftCoproductTriangleClosure Ashift : ObjectProperty D) where
  ext₃' _ hΔ h₁ h₂ :=
    ObjectProperty.le_isoClosure (ShiftCoproductTriangleClosure Ashift) _
      (.triangle₃ hΔ h₁ h₂)

/-- Any object property containing the chosen shifts, closed under arbitrary coproducts, and
satisfying two-out-of-three on distinguished triangles contains the generated closure. -/
theorem le {T : ObjectProperty D}
    (hcoproduct : ∀ {ι : Type w} (K : ι → D), (∀ i, T (K i)) → T (∐ fun i ↦ K i))
    (hTriangle₁ :
      ∀ {Δ : Pretriangulated.Triangle D}, Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₂ → T Δ.obj₃ → T Δ.obj₁)
    (hTriangle₂ :
      ∀ {Δ : Pretriangulated.Triangle D}, Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₁ → T Δ.obj₃ → T Δ.obj₂)
    (hTriangle₃ :
      ∀ {Δ : Pretriangulated.Triangle D}, Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₁ → T Δ.obj₂ → T Δ.obj₃)
    (hshift : ObjectProperty.ofObj Ashift ≤ T) :
    ShiftCoproductTriangleClosure Ashift ≤ T := by
  intro X hX
  induction hX with
  | shift k =>
      exact hshift _ (ofObj_apply Ashift k)
  | coproduct K hK ih =>
      exact hcoproduct K ih
  | triangle₁ hΔ h₂ h₃ ih₂ ih₃ =>
      exact hTriangle₁ hΔ ih₂ ih₃
  | triangle₂ hΔ h₁ h₃ ih₁ ih₃ =>
      exact hTriangle₂ hΔ ih₁ ih₃
  | triangle₃ hΔ h₁ h₂ ih₁ ih₂ =>
      exact hTriangle₃ hΔ ih₁ ih₂

/-- Companion API: the same universal property packaged through the canonical `ObjectProperty`
closure classes for arbitrary coproducts and distinguished triangles. -/
theorem le_of_closed {T : ObjectProperty D}
    [T.IsClosedUnderIsomorphisms]
    [∀ ι : Type w, T.IsClosedUnderColimitsOfShape (Discrete ι)]
    [T.IsTriangulatedClosed₁] [T.IsTriangulatedClosed₂] [T.IsTriangulatedClosed₃]
    (hshift : ObjectProperty.ofObj Ashift ≤ T) :
    ShiftCoproductTriangleClosure Ashift ≤ T := by
  refine le ?_ ?_ ?_ ?_ hshift
  · intro ι K hK
    exact T.prop_colimit (Discrete.functor K) (fun i ↦ hK i.as)
  · intro Δ hΔ h₂ h₃
    exact T.ext_of_isTriangulatedClosed₁ _ hΔ h₂ h₃
  · intro Δ hΔ h₁ h₃
    exact T.ext_of_isTriangulatedClosed₂ _ hΔ h₁ h₃
  · intro Δ hΔ h₁ h₂
    exact T.ext_of_isTriangulatedClosed₃ _ hΔ h₁ h₂

end

end ShiftCoproductTriangleClosure

/-- Abstract closure lemma: if every object already lies in the closure generated from a chosen
shifted family by arbitrary coproducts and two-out-of-three for distinguished triangles, then any
object property containing that family and closed under those operations holds for every object. -/
theorem holds_for_all_of_shiftCoproductTriangleClosure
    {Ashift : ℤ → D} {T : ObjectProperty D}
    (hcoproduct : ∀ {ι : Type w} (K : ι → D), (∀ i, T (K i)) → T (∐ fun i ↦ K i))
    (hTriangle₁ :
      ∀ {Δ : Pretriangulated.Triangle D}, Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₂ → T Δ.obj₃ → T Δ.obj₁)
    (hTriangle₂ :
      ∀ {Δ : Pretriangulated.Triangle D}, Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₁ → T Δ.obj₃ → T Δ.obj₂)
    (hTriangle₃ :
      ∀ {Δ : Pretriangulated.Triangle D}, Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₁ → T Δ.obj₂ → T Δ.obj₃)
    (hshift : ∀ k : ℤ, T (Ashift k))
    (hgenerate : ∀ X : D, ShiftCoproductTriangleClosure Ashift X) :
    ∀ X : D, T X := by
  have hshift' : ObjectProperty.ofObj Ashift ≤ T := by
    intro X hX
    rcases hX with ⟨k⟩
    simpa using hshift k
  have hclosure : ShiftCoproductTriangleClosure Ashift ≤ T :=
    ShiftCoproductTriangleClosure.le hcoproduct hTriangle₁ hTriangle₂ hTriangle₃ hshift'
  intro X
  exact hclosure _ (hgenerate X)

end

section DerivedCategoryOfModules

variable {A : Type u} [Ring A]

local instance :
    HasCoproducts.{u} (DerivedCategory (ModuleCat.{u, u} A)) := fun J ↦
  (CategoryTheory.derivedCategory_hasCoproductsOfShape :
    HasCoproductsOfShape J (DerivedCategory (ModuleCat.{u, u} A)))

/-- Bridge from the Chapter 22 property `(P)` resolutions to the local closure generated by the
regular shifts `A[k]` in `D(A, d)`. This is the source-facing input supplied by Lemmas `22.20.1`
and `22.20.4` for Remark `22.22.5`. -/
theorem q_obj_mem_shiftCoproductTriangleClosure_of_hasPropertyP
    {P : CochainComplex (ModuleCat.{u, u} A) ℤ} (hP : CochainComplex.HasPropertyP P) :
    ShiftCoproductTriangleClosure
      (fun k ↦
        (DerivedCategory.Q :
          CochainComplex (ModuleCat.{u, u} A) ℤ ⥤
            DerivedCategory (ModuleCat.{u, u} A)).obj
          (CochainComplex.shiftedFreeDGModule A k))
      ((DerivedCategory.Q :
          CochainComplex (ModuleCat.{u, u} A) ℤ ⥤
            DerivedCategory (ModuleCat.{u, u} A)).obj P) := by
  sorry

/-- Remark 22.22.5: let `T` be a property of objects of `D(A, d)`. If `T` is closed under
arbitrary direct sums, if `T` satisfies two-out-of-three for distinguished triangles, and if
`T(A[k])` holds for every `k : ℤ`, then `T` holds for every object of `D(A, d)`. Here the source
objects `A[k]` are represented in the canonical cochain-complex model by
`Q.obj (CochainComplex.shiftedFreeDGModule A k)`. -/
@[stacks 0FQE]
theorem holds_for_all_of_shiftCoproductTriangleGeneration
    {T : ObjectProperty (DerivedCategory (ModuleCat.{u, u} A))}
    (hcoproduct :
      ∀ {ι : Type u} (K : ι → DerivedCategory (ModuleCat.{u, u} A)),
        (∀ i, T (K i)) → T (∐ fun i ↦ K i))
    (hTriangle₁ :
      ∀ {Δ : Pretriangulated.Triangle (DerivedCategory (ModuleCat.{u, u} A))},
        Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₂ → T Δ.obj₃ → T Δ.obj₁)
    (hTriangle₂ :
      ∀ {Δ : Pretriangulated.Triangle (DerivedCategory (ModuleCat.{u, u} A))},
        Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₁ → T Δ.obj₃ → T Δ.obj₂)
    (hTriangle₃ :
      ∀ {Δ : Pretriangulated.Triangle (DerivedCategory (ModuleCat.{u, u} A))},
        Δ ∈ Pretriangulated.distinguishedTriangles →
        T Δ.obj₁ → T Δ.obj₂ → T Δ.obj₃)
    (hshift :
      ∀ k : ℤ,
        T ((DerivedCategory.Q :
            CochainComplex (ModuleCat.{u, u} A) ℤ ⥤
              DerivedCategory (ModuleCat.{u, u} A)).obj
            (CochainComplex.shiftedFreeDGModule A k))) :
    ∀ X : DerivedCategory (ModuleCat.{u, u} A), T X := by
  let Q :
      CochainComplex (ModuleCat.{u, u} A) ℤ ⥤
        DerivedCategory (ModuleCat.{u, u} A) := DerivedCategory.Q
  let Ashift : ℤ → DerivedCategory (ModuleCat.{u, u} A) := fun k ↦
    Q.obj (CochainComplex.shiftedFreeDGModule A k)
  have hshift' : ObjectProperty.ofObj Ashift ≤ T := by
    intro X hX
    rcases hX with ⟨k⟩
    simpa using hshift k
  intro X
  let M := DerivedCategory.Q.objPreimage X
  obtain ⟨P, π, hπ, hP⟩ := CochainComplex.exists_quasiIso_from_hasPropertyP M
  have hQP : ShiftCoproductTriangleClosure Ashift (Q.obj P) :=
    q_obj_mem_shiftCoproductTriangleClosure_of_hasPropertyP hP
  have hTQP : T (Q.obj P) :=
    ShiftCoproductTriangleClosure.le hcoproduct hTriangle₁ hTriangle₂ hTriangle₃ hshift' _ hQP
  have hTiso {Y Z : DerivedCategory (ModuleCat.{u, u} A)} (e : Y ≅ Z) (hY : T Y) : T Z := by
    sorry
  have hQπ : IsIso (Q.map π) :=
    (DerivedCategory.isIso_Q_map_iff_quasiIso (ModuleCat.{u, u} A) π).2 hπ
  exact hTiso (asIso (Q.map π) ≪≫ Q.objObjPreimageIso X) hTQP

end DerivedCategoryOfModules

end CategoryTheory
