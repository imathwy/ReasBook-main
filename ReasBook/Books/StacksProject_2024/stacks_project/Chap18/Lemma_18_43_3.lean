section MainStatements

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

open Opposite

/-- Helper for Lemma 18.43.3: the sieve on `U` generated by a slice-site family is the sieve
generated by the corresponding underlying arrows in the ambient site. -/
private theorem overSieveOfObjectsEqOfArrows
    {U : C} {ι : Type (max u v)} (X : ι → Over U) :
    (Sieve.overEquiv (Over.mk (𝟙 U)))
        (Sieve.ofObjects X (Over.mk (𝟙 U))) =
      Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) := by
  -- A factorization in the slice category forgets to the same factorization in the ambient site.
  ext W g
  constructor
  · intro hg
    rw [Sieve.overEquiv_iff] at hg
    rw [Sieve.mem_ofObjects_iff] at hg
    rcases hg with ⟨i, ⟨a⟩⟩
    rw [Sieve.mem_ofArrows_iff]
    exact ⟨i, a.left, by simpa using a.w.symm⟩
  · intro hg
    -- Conversely, any ambient factorization lifts uniquely to the slice category.
    rw [Sieve.overEquiv_iff]
    rw [Sieve.mem_ofArrows_iff] at hg
    rcases hg with ⟨i, a, ha⟩
    rw [Sieve.mem_ofObjects_iff]
    exact ⟨i, ⟨Over.homMk a (by simpa using ha.symm)⟩⟩

/-- Helper for Lemma 18.43.3: a slice-site `CoversTop` hypothesis yields the corresponding
covering sieve on the base object. -/
private theorem coveringSieve_of_coversTopOver
    {U : C} {ι : Type (max u v)} (X : ι → Over U)
    (hcover : (J.over U).CoversTop X) :
    Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈ J U := by
  -- Rewrite the slice cover of the terminal object into the corresponding base-site sieve.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal (J := J.over U) (X := Over.mk (𝟙 U))
    (hX := Over.mkIdTerminal)] at hcover
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows (X := X)] at hcover
  exact hcover

/-- Helper for Lemma 18.43.3: a covering sieve on the family of arrows underlying `X` converts
back into the corresponding slice-site `CoversTop` statement. -/
private theorem coversTopOver_of_coveringSieve
    {U : C} {ι : Type (max u v)} (X : ι → Over U)
    (hcover : Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈ J U) :
    (J.over U).CoversTop X := by
  -- Rewrite the ambient covering sieve back into the slice-site cover of the terminal object.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal (J := J.over U) (X := Over.mk (𝟙 U))
    (hX := Over.mkIdTerminal)]
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows (X := X)]
  exact hcover

/-- Helper for Lemma 18.43.3: composing a slice-site cover of `U` with slice-site covers of each
member yields a sigma-indexed slice-site cover of `U`. -/
private theorem coversTopSigmaComp
    {U : C} {ι : Type (max u v)} {X : ι → Over U}
    (hX : (J.over U).CoversTop X)
    {κ : ι → Type (max u v)} {Y : ∀ i : ι, κ i → Over (X i).left}
    (hY : ∀ i : ι, (J.over (X i).left).CoversTop (Y i)) :
    (J.over U).CoversTop
      (fun a : Sigma κ ↦ Over.mk ((Y a.1 a.2).hom ≫ (X a.1).hom)) := by
  -- Convert both slice covers to ambient covering sieves and compose them using `bindOfArrows`.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal
    (J := J.over U) (X := Over.mk (𝟙 U)) (hX := Over.mkIdTerminal)]
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows]
  have hX' :
      Sieve.ofArrows (fun i ↦ (X i).left) (fun i ↦ (X i).hom) ∈ J U := by
    have hXTerminal :
        Sieve.ofObjects X (Over.mk (𝟙 U)) ∈ (J.over U) (Over.mk (𝟙 U)) :=
      (GrothendieckTopology.coversTop_iff_of_isTerminal
        (J := J.over U) (X := Over.mk (𝟙 U)) (hX := Over.mkIdTerminal) X).1 hX
    rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows] at hXTerminal
    exact hXTerminal
  have hY' :
      ∀ i : ι,
        Sieve.ofArrows (fun a : κ i ↦ (Y i a).left) (fun a ↦ (Y i a).hom) ∈ J (X i).left := by
    intro i
    have hYTerminal :
        Sieve.ofObjects (Y i) (Over.mk (𝟙 (X i).left)) ∈
          (J.over (X i).left) (Over.mk (𝟙 (X i).left)) :=
      (GrothendieckTopology.coversTop_iff_of_isTerminal
        (J := J.over (X i).left) (X := Over.mk (𝟙 (X i).left))
        (hX := Over.mkIdTerminal) (Y i)).1 (hY i)
    rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows] at hYTerminal
    exact hYTerminal
  simpa [Presieve.bindOfArrows_ofArrows] using
    J.bindOfArrows
      (h := hX')
      (R := fun i ↦ Presieve.ofArrows (fun a : κ i ↦ (Y i a).left) (fun a ↦ (Y i a).hom))
      (fun i ↦ by simpa using hY' i)

/-- Helper for Lemma 18.43.3: slice-site covering data over every object can be repackaged as one
ambient covering family. -/
theorem exists_coversTop_of_over_cover_data
    (P : C → Prop)
    (hP : ∀ U : C,
      ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
        ∀ i : I, P (X i).left) :
    ∃ (I : Type (max u v)) (Y : I → C), J.CoversTop Y ∧
      ∀ i : I, P (Y i) := by
  classical
  choose I X hX hprop using hP
  refine ⟨Sigma I, fun a ↦ (X a.1 a.2).left, ?_, ?_⟩
  · intro U
    -- The slice cover chosen over `U` gives a covering sieve on `U`, and every generator lands
    -- in the sigma-indexed ambient family.
    have hcover :
        Sieve.ofArrows (fun i ↦ (X U i).left) (fun i ↦ (X U i).hom) ∈ J U := by
      exact coveringSieve_of_coversTopOver (J := J) (X := X U) (hX U)
    refine J.superset_covering ?_ hcover
    intro V f hf
    rw [Sieve.mem_ofArrows_iff] at hf
    rw [Sieve.mem_ofObjects_iff]
    rcases hf with ⟨i, g, hg⟩
    exact ⟨⟨U, i⟩, ⟨g⟩⟩
  · intro a
    exact hprop a.1 a.2

/-- Helper for Lemma 18.43.3: restricting a chosen constant chart along a slice object can be
described directly on the smaller slice site without passing through an iterated slice model. -/
private noncomputable def restrictConstantChartAlongOver
    {D : Type w} [Category D]
    {FD : D → D → Type*} {CD : D → Type*}
    [∀ X Y, FunLike (FD X Y) (CD X) (CD Y)] [ConcreteCategory D FD]
    [HasWeakSheafify J D]
    [∀ T : C, HasWeakSheafify (J.over T) D]
    [J.WEqualsLocallyBijective D]
    [∀ T : C, (J.over T).WEqualsLocallyBijective D]
    {H : Sheaf J D} {U : C} {A : D}
    (e : H.over U ≅ (constantSheaf (J.over U) D).obj A)
    {V : Over U} :
    H.over V.left ≅ (constantSheaf (J.over V.left) D).obj A := by
  -- Route correction: transport the chart by comparing direct restriction to the slice pullback,
  -- then bridge both constant models using the ambient `constantSheafOverObjIso`.
  let f : V.left ⟶ U := V.hom
  let hH :
      ((J.overMapPullback D f).obj (H.over U)) ≅ H.over V.left :=
    (Functor.sheafPushforwardContinuousComp' (Over.mapForget f) D
      (J.over V.left) (J.over U) J).app H
  let hConstU :
      ((J.overMapPullback D f).obj ((constantSheaf (J.over U) D).obj A)) ≅
        ((constantSheaf J D).obj A).over V.left := by
    -- First rewrite the constant source chart back to the ambient constant sheaf over `U`.
    let h₁ :
        ((J.overMapPullback D f).obj ((constantSheaf (J.over U) D).obj A)) ≅
          ((J.overMapPullback D f).obj (((constantSheaf J D).obj A).over U)) :=
      (J.overMapPullback D f).mapIso
        (constantSheafOverObjIso (J := J) (D := D) U A).symm
    -- Then identify the iterated restriction with the direct restriction to `V.left`.
    let h₂ :
        ((J.overMapPullback D f).obj (((constantSheaf J D).obj A).over U)) ≅
          ((constantSheaf J D).obj A).over V.left :=
      (Functor.sheafPushforwardContinuousComp' (Over.mapForget f) D
        (J.over V.left) (J.over U) J).app ((constantSheaf J D).obj A)
    exact h₁ ≪≫ h₂
  -- Compose the restriction comparison with the ambient constant-sheaf comparison at `V.left`.
  exact hH.symm ≪≫ (J.overMapPullback D f).mapIso e ≪≫ hConstU ≪≫
    constantSheafOverObjIso (J := J) (D := D) V.left A

/-- Helper for Lemma 18.43.3: every object of the slice category `Over U` carries its canonical
arrow to the terminal object `Over.mk (𝟙 U)`. -/
private def overTerminalHom {U : C} (X : Over U) : X ⟶ Over.mk (𝟙 U) :=
  Over.homMk X.hom (by simp)

/-- Helper for Lemma 18.43.3: a section of a constant set-valued sheaf on the slice site
`J.over U` becomes a literal constant after passing to a slice-site cover. -/
private theorem exists_coversTop_lift_constantTypeSection
    [HasWeakSheafify J (Type w)]
    [∀ T : C, HasWeakSheafify (J.over T) (Type w)]
    [J.WEqualsLocallyBijective (Type w)]
    [∀ T : C, (J.over T).WEqualsLocallyBijective (Type w)]
    {U : C} {B : Type w}
    (s : ((((constantSheaf J (Type w)).obj B).over U).obj.obj (op (Over.mk (𝟙 U))))) :
    ∃ (I : Type (max u v)) (X : I → Over U), (J.over U).CoversTop X ∧
      ∀ i : I, ∃ b : B,
        (constant_presheaf_over_comparison (J := J) (D := Type w) U B).app (op (X i)) b =
          ((((constantSheaf J (Type w)).obj B).over U).obj.map
            (overTerminalHom (X i)).op) s := by
  let α := constant_presheaf_over_comparison (J := J) (D := Type w) U B
  letI : Presheaf.IsLocallySurjective (J.over U) α :=
    (constant_presheaf_over_comparison_is_W
      (J := J) (D := Type w) (FD := fun X Y ↦ X ⟶ Y) (CD := fun X ↦ X) U B).isLocallySurjective
  let R : Sieve (Over.mk (𝟙 U)) := Presheaf.imageSieve α s
  have hR : R ∈ (J.over U) (Over.mk (𝟙 U)) := by
    simpa [R] using Presheaf.imageSieve_mem (J := J.over U) α s
  let I : Type (max u v) := { X : Over U // R.arrows (overTerminalHom X) }
  refine ⟨I, fun i ↦ i.1, ?_, ?_⟩
  · -- The image sieve of the section itself gives the required slice-site covering family.
    have hObjects : Sieve.ofObjects (fun i : I ↦ i.1) (Over.mk (𝟙 U)) = R := by
      ext W g
      constructor
      · intro hg
        rw [Sieve.mem_ofObjects_iff] at hg
        rcases hg with ⟨i, ⟨a⟩⟩
        have hg' : a ≫ overTerminalHom i.1 = g := by
          ext
          simpa [overTerminalHom] using (g.w.trans a.w.symm).symm
        rw [← hg']
        exact R.downward_closed i.2 a
      · intro hg
        rw [Sieve.mem_ofObjects_iff]
        refine ⟨⟨W, ?_⟩, ⟨𝟙 W⟩⟩
        have hg' : g = overTerminalHom W := by
          ext
          simpa [overTerminalHom] using g.w
        simpa [hg'] using hg
    rw [GrothendieckTopology.coversTop_iff_of_isTerminal (J := J.over U) (X := Over.mk (𝟙 U))
      (hX := Over.mkIdTerminal)]
    rw [hObjects]
    exact hR
  · intro i
    have hi : (Presheaf.imageSieve α s).arrows (overTerminalHom i.1) := by
      simpa [R] using i.2
    refine ⟨Presheaf.localPreimage (U := Opposite.op (Over.mk (𝟙 U)))
      α s (overTerminalHom i.1) hi, ?_⟩
    -- The local preimage computes the restriction of the chosen section by construction.
    simpa [α] using
      Presheaf.app_localPreimage (U := Opposite.op (Over.mk (𝟙 U)))
        α s (overTerminalHom i.1) hi

