import Mathlib
import StacksProject_2024.stacks_project.Chap07.Definition_7_17_1
import StacksProject_2024.stacks_project.Chap18.Lemma_18_30_1

-- Declarations for this item will be appended below by the statement pipeline.

open CategoryTheory Opposite
open CategoryTheory.Limits
open CategoryTheory.SemiRepresentableFamily.Over
open SheafOfModules.RingedSite

noncomputable section

universe u w

section

variable {C : Type u} [Category.{u} C] [HasPullbacks C]
variable (J : GrothendieckTopology C)
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable (𝒪 : Sheaf J CommRingCat.{u})
variable {I : Type w} {U : C} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U)

/-- Helper for Lemma 18.30.2: the sieve on `U` generated by the slice-site family
`fun i ↦ Over.mk (π i)` is exactly the ordinary sieve generated by the arrows `π i`. -/
private theorem overSieveOfObjectsEqOfArrows :
    (Sieve.overEquiv (Over.mk (𝟙 U)))
        (Sieve.ofObjects (fun i : I ↦ Over.mk (π i)) (Over.mk (𝟙 U))) =
      Sieve.ofArrows Uᵢ π := by
  -- A factorization in the slice over `U` is exactly the same factorization in the base site.
  ext V f
  constructor
  · intro hf
    rw [Sieve.overEquiv_iff] at hf
    rw [Sieve.mem_ofObjects_iff] at hf
    rcases hf with ⟨i, ⟨g⟩⟩
    rw [Sieve.mem_ofArrows_iff]
    exact ⟨i, g.left, by simpa using g.w.symm⟩
  · intro hf
    rw [Sieve.overEquiv_iff]
    rw [Sieve.mem_ofArrows_iff] at hf
    rcases hf with ⟨i, g, hg⟩
    rw [Sieve.mem_ofObjects_iff]
    exact ⟨i, ⟨Over.homMk g (by simpa using hg.symm)⟩⟩

/-- Helper for Lemma 18.30.2: a slice-site cover of the terminal object yields the corresponding
ordinary covering sieve on `U`. -/
private theorem coveringSieve_of_coversTopOver
    (hcover : (J.over U).CoversTop (fun i : I ↦ Over.mk (π i))) :
    Sieve.ofArrows Uᵢ π ∈ J U := by
  -- Rewrite the slice cover of `Over.mk (𝟙 U)` into the ordinary covering sieve on `U`.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal (J := J.over U) (X := Over.mk (𝟙 U))
    (hX := Over.mkIdTerminal)] at hcover
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows (Uᵢ := Uᵢ) (π := π)] at hcover
  exact hcover

/-- Helper for Lemma 18.30.2: if a covering refinement lands in a subfamily indexed by the image
of its index map, then that restricted family still covers `U`. -/
private theorem restrictedRangeFamilyCovering
    {𝒱 : SemiRepresentableFamily.Over U}
    (h𝒱 : 𝒱.toSieve ∈ J U)
    (φ : 𝒱 ⟶ ofArrows Uᵢ π) :
    Sieve.ofArrows (fun i : Set.range φ.α ↦ Uᵢ i.1) (fun i ↦ π i.1) ∈ J U := by
  -- Route correction: pass through a morphism into the subtype-indexed family, then use sieve
  -- monotonicity instead of manually rebuilding the covering sieve.
  let ψ : 𝒱 ⟶ ofArrows (fun i : Set.range φ.α ↦ Uᵢ i.1) (fun i ↦ π i.1) :=
    { α := fun i ↦ ⟨φ.α i, ⟨i, rfl⟩⟩
      f := fun i ↦ φ.f i }
  -- The restricted family covers because the original covering refinement factors through it.
  have hrestricted :
      (ofArrows (fun i : Set.range φ.α ↦ Uᵢ i.1) (fun i ↦ π i.1)).toSieve ∈ J U := by
    exact J.superset_covering (toSieve_le_of_hom ψ) h𝒱
  simpa using hrestricted

/-- Helper for Lemma 18.30.2: a covering sieve on a restricted family converts back to the slice
site cover needed by `coverSectionCechExact`. -/
private theorem coversTopOver_of_coveringSieve
    {S : Set I}
    (hcover : Sieve.ofArrows (fun i : S ↦ Uᵢ i.1) (fun i ↦ π i.1) ∈ J U) :
    (J.over U).CoversTop (fun i : S ↦ Over.mk (π i.1)) := by
  -- Rewrite the ordinary covering sieve back into the slice-site covering condition.
  rw [GrothendieckTopology.coversTop_iff_of_isTerminal (J := J.over U) (X := Over.mk (𝟙 U))
    (hX := Over.mkIdTerminal)]
  rw [GrothendieckTopology.mem_over_iff, overSieveOfObjectsEqOfArrows
    (Uᵢ := fun i : S ↦ Uᵢ i.1) (π := fun i ↦ π i.1)]
  exact hcover

-- Proof sketch: use quasi-compactness of `U` to refine the given covering family by a covering
-- whose image in the original index set is finite. Let `S ⊆ I` be that finite image. By Sites,
-- Lemma `7.8.6`, the sheaf condition descends from the refining cover to the restricted family
-- indexed by `S`, which gives exactness of the corresponding Čech section sequence. Lemma
-- `18.30.1` identifies this with the exactness of the displayed extension-by-zero sequence.
/-- Lemma 18.30.2: if `U` is quasi-compact and `\{U_i \to U\}_{i \in I}` is a covering family of a
ringed site `(\mathcal C, \mathcal O)`, then there is a finite subset `S ⊆ I` such that the
restricted Čech sequence on sections over `S` is exact for every `\mathcal O`-module. By Lemma
18.30.1, this is equivalent to exactness of the finite direct-sum sequence
`\bigoplus_{i,i' \in S} j_{U_i \times_U U_{i'}!}\mathcal O_{U_i \times_U U_{i'}} \to
\bigoplus_{i \in S} j_{U_i!}\mathcal O_{U_i} \to j_{U!}\mathcal O_U \to 0`. -/
theorem quasiCompactObject_exists_finite_subfamily_section_cech_exact
    (hU : J.QuasiCompactObject U)
    (hcover : (J.over U).CoversTop (fun i : I ↦ Over.mk (π i))) :
    ∃ S : Set I, S.Finite ∧
      ∀ ℱ : ringedSiteModuleCategory J 𝒪,
        let restriction :
            (SheafOfModules.evaluation (ringSheaf J 𝒪) (op U)).obj ℱ →
              ∀ i : S, (SheafOfModules.evaluation (ringSheaf J 𝒪) (op (Uᵢ i.1))).obj ℱ :=
          fun s i ↦
            ConcreteCategory.hom
              (((SheafOfModules.toSheaf (ringSheaf J 𝒪)).obj ℱ).1.map (π i.1).op) s
        let compatibility :
            (∀ i : S, (SheafOfModules.evaluation (ringSheaf J 𝒪) (op (Uᵢ i.1))).obj ℱ) →
              ∀ i j : S,
                (SheafOfModules.evaluation (ringSheaf J 𝒪)
                  (op (Limits.pullback (π i.1) (π j.1)))).obj ℱ :=
          fun s i j ↦
            ConcreteCategory.hom
                (((SheafOfModules.toSheaf (ringSheaf J 𝒪)).obj ℱ).1.map
                  (Limits.pullback.fst (π i.1) (π j.1)).op) (s i) -
              ConcreteCategory.hom
                (((SheafOfModules.toSheaf (ringSheaf J 𝒪)).obj ℱ).1.map
                  (Limits.pullback.snd (π i.1) (π j.1)).op) (s j)
        Function.Injective restriction ∧ Function.Exact restriction compatibility := by
  -- Convert the slice-site cover into an ordinary covering sieve so quasi-compactness applies.
  have hsieve : Sieve.ofArrows Uᵢ π ∈ J U :=
    coveringSieve_of_coversTopOver (J := J) (Uᵢ := Uᵢ) (π := π) hcover
  -- Extract a covering refinement whose image in the original index set is finite.
  obtain ⟨𝒱, h𝒱, φ, hfinite⟩ :=
    GrothendieckTopology.quasiCompactObject_finite_image_refinement_ofArrows
      (J := J) (U := U) hU Uᵢ π hsieve
  have hrestrictedCover :
      (J.over U).CoversTop (fun i : Set.range φ.α ↦ Over.mk (π i.1)) := by
    -- The refining family factors through the subtype-indexed subfamily determined by its image.
    apply coversTopOver_of_coveringSieve (J := J) (Uᵢ := Uᵢ) (π := π)
    exact restrictedRangeFamilyCovering (J := J) (Uᵢ := Uᵢ) (π := π) h𝒱 φ
  refine ⟨Set.range φ.α, hfinite, ?_⟩
  intro ℱ
  -- Apply the exactness theorem already proved for arbitrary covering families.
  simpa [coverSectionRestriction, coverSectionCompatibility] using
    coverSectionCechExact (J := J) (𝒪 := 𝒪) (U := U)
      (Uᵢ := fun i : Set.range φ.α ↦ Uᵢ i.1)
      (π := fun i ↦ π i.1) hrestrictedCover ℱ

end
