open CategoryTheory.Limits
open CategoryTheory.Pretriangulated

universe v u v₁ u₁ v₂ u₂

namespace CategoryTheory

namespace TriangulatedK0

section

variable (C : Type u) [Category.{v} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C]

/- Domain-style sampling for Definition 13.28.1:
- primary domain: Grothendieck groups of pretriangulated categories;
- sampled mathlib/project owner-style declarations:
  `FreeAbelianGroup.lift`,
  `QuotientAddGroup.lift`,
  `AbelianK0.of`,
  `AbelianK0.of_shortExact`;
- source-facing layer: Definition 13.28.1 defines the triangulated zeroth `K`-group itself;
- core/canonical owner in this chapter: the quotient of `FreeAbelianGroup C` by the subgroup
  generated by distinguished-triangle relations;
- bridge/view: the class map `of`, the quotient universal property `lift`, the exact-functoriality
  map `map`, and the additivity theorem `of_distinguished`.

Primitive data are the objects of `C` together with its distinguished triangles. The quotient
presentation and its universal property are derived from that owner abstraction, so they belong in
this definition file rather than in a later lemma file. There is no upstream mathlib/project owner
for triangulated `K₀` to recall directly, so this file remains the owner rather than a bridge.
We also intentionally do not introduce a second global `K₀[...]` notation here: Chapter 12 already
uses that notation for abelian `K₀`, and Chapter 13 routinely mixes the abelian and triangulated
owners in the same statements.
-/

/-- The Grothendieck relation `[Y] - [X] - [Z]` attached to a distinguished triangle
`X ⟶ Y ⟶ Z ⟶ X[1]`. -/
private def relation (T : { T : Triangle C // T ∈ distTriang C }) : FreeAbelianGroup C :=
  FreeAbelianGroup.of T.1.obj₂ - FreeAbelianGroup.of T.1.obj₁ - FreeAbelianGroup.of T.1.obj₃

/-- The subgroup of the free abelian group on the objects of `C` generated by distinguished
triangle relations. -/
def relations : AddSubgroup (FreeAbelianGroup C) :=
  AddSubgroup.closure (Set.range (relation C))

/-- The Grothendieck relation attached to a distinguished triangle lies in
`TriangulatedK0.relations`. -/
private theorem sub_mem_relations_of_distinguished (T : Triangle C) (hT : T ∈ distTriang C) :
    FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃ ∈
      relations C :=
  AddSubgroup.subset_closure <| Set.mem_range.2 ⟨⟨T, hT⟩, rfl⟩

end

end TriangulatedK0

/-- Definition 13.28.1: the zeroth `K`-group `K₀(C)` of a pretriangulated category `C` is the
quotient of the free abelian group on the objects of `C` by the relations `[Y] = [X] + [Z]`
coming from distinguished triangles `X ⟶ Y ⟶ Z ⟶ X[1]`. -/
abbrev TriangulatedK0
    (C : Type u) [Category.{v} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
    [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C] : Type u :=
  FreeAbelianGroup C ⧸ TriangulatedK0.relations C

namespace TriangulatedK0

section

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C]

/-- The class of an object of a pretriangulated category in its triangulated zeroth `K`-group. -/
abbrev of (X : C) : TriangulatedK0 C :=
  QuotientAddGroup.mk' (relations C) (FreeAbelianGroup.of X)

/-- An additive invariant on objects of a pretriangulated category descends to `K₀` as soon as it
kills the distinguished-triangle relations. -/
def lift {M : Type _} [AddCommGroup M] (f : C → M)
    (hf : relations C ≤ (FreeAbelianGroup.lift f).ker) :
    TriangulatedK0 C →+ M :=
  QuotientAddGroup.lift (relations C) (FreeAbelianGroup.lift f) hf

/-- The descended additive invariant evaluates on the class of an object by the original
function. -/
@[simp] theorem lift_of {M : Type _} [AddCommGroup M] (f : C → M)
    (hf : relations C ≤ (FreeAbelianGroup.lift f).ker) (X : C) :
    lift f hf (of X) = f X := by
  simp [lift, of]

/-- The class map to `K₀(C)` is additive on distinguished triangles in `C`. -/
theorem of_distinguished (T : Triangle C) (hT : T ∈ distTriang C) :
    of T.obj₂ = of T.obj₁ + of T.obj₃ := by
  have hrelation₀ :
      QuotientAddGroup.mk' (relations C)
          (FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃) = 0 :=
    (QuotientAddGroup.eq_zero_iff
      (FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃)).2
      (sub_mem_relations_of_distinguished C T hT)
  have hrelation : of T.obj₂ - of T.obj₁ - of T.obj₃ = 0 := by
    simpa [of] using hrelation₀
  simpa [add_comm] using eq_add_of_sub_eq (sub_eq_zero.mp hrelation)

end

section Functoriality

variable {C₁ : Type u₁} [Category.{v₁} C₁] [Preadditive C₁] [HasZeroObject C₁] [HasShift C₁ ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C₁ n)] [Pretriangulated C₁]
variable {C₂ : Type u₂} [Category.{v₂} C₂] [Preadditive C₂] [HasZeroObject C₂] [HasShift C₂ ℤ]
  [∀ n : ℤ, Functor.Additive (shiftFunctor C₂ n)] [Pretriangulated C₂]

/-- The distinguished-triangle relations in `C₁` lie in the kernel of the raw map induced by an
exact functor. -/
private theorem relations_le_ker_map
    (F : C₁ ⥤ C₂) [F.CommShift ℤ] [F.IsTriangulated] :
    relations C₁ ≤ (FreeAbelianGroup.lift (of ∘ F.obj)).ker := by
  rw [relations, AddSubgroup.closure_le]
  rintro _ ⟨T, rfl⟩
  rcases T with ⟨T, hT⟩
  change
    (FreeAbelianGroup.lift (of ∘ F.obj))
        (FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃) = 0
  simp only [FreeAbelianGroup.lift_apply_of, map_sub]
  simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using
    sub_eq_zero.mpr (of_distinguished (F.mapTriangle.obj T) (F.map_distinguished T hT))

/-- An exact functor between pretriangulated categories induces a homomorphism on zeroth
`K`-groups. -/
def map (F : C₁ ⥤ C₂) [F.CommShift ℤ] [F.IsTriangulated] :
    TriangulatedK0 C₁ →+ TriangulatedK0 C₂ :=
  lift (of ∘ F.obj) (relations_le_ker_map F)

/-- The `K₀` map induced by an exact functor sends the class of `X` to the class of `F(X)`. -/
@[simp] theorem map_of (F : C₁ ⥤ C₂) [F.CommShift ℤ] [F.IsTriangulated] (X : C₁) :
    map F (of X) = of (F.obj X) := by
  simpa using lift_of (of ∘ F.obj) (relations_le_ker_map F) X

end Functoriality

end TriangulatedK0

end CategoryTheory

