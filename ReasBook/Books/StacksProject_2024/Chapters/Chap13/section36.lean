  `source-facing`: `IsWeakGenerator`, `IsGeneratingFamily`, `IsClassicalGenerator`,
  `IsStrongGenerator`;
  `core/canonical`: `ofObj`, `shiftClosure`, `rightOrthogonal`, and `objectGeneratedProperty`;
  `bridge/view`: the equivalences expressing weak and family generation by vanishing right
  orthogonals of the canonical shift-closure owners.

The only duplicate-wheel risk here is the raw "family of shifts" presentation. The refined owners
remain the canonical shift-closures of `singleton E` and `ofObj E`, with the source-facing weak
generator definition kept as the public entry and the orthogonal reformulations as bridges. -/

section

variable {D : Type u} [Category.{v} D] [HasZeroMorphisms D] [HasShift D ℤ]

/-- A family `E : I → D` generates `D` if the only object right-orthogonal to all shifts of all
`E i` is the zero object. -/
def IsGeneratingFamily {I : Type*} (E : I → D) : Prop :=
  ((ofObj E).shiftClosure ℤ).rightOrthogonal = IsZero

/-- Definition 13.36.3 (3): an object `E` is a weak generator if every nonzero object receives a
nonzero morphism from some shift of `E`, equivalently if there is a nonzero map `E ⟶ K⟦n⟧` for
some integer `n`. -/
def IsWeakGenerator (E : D) : Prop :=
  ∀ ⦃K : D⦄, ¬ IsZero K → ∃ (n : ℤ) (f : E ⟶ K⟦n⟧), f ≠ 0

/-- A weak generator is equivalently characterized by the vanishing of the right orthogonal of
all shifts of `E`. -/
-- Proof sketch: the canonical owner for "all shifts of `E`" is the shift-closure of the singleton
-- object property generated by `E`, and an object lies in its right orthogonal exactly when every
-- map from every shift of `E` into that object vanishes.
theorem isWeakGenerator_iff_rightOrthogonal_shifts_eq_isZero (E : D) :
    IsWeakGenerator E ↔
      ((singleton E).shiftClosure ℤ).rightOrthogonal = IsZero := by
  let P : ObjectProperty D := (singleton E).shiftClosure ℤ
  constructor
  · intro hE
    ext K
    constructor
    · intro hK
      by_contra hK0
      rcases hE hK0 with ⟨n, f, hf⟩
      have hKn : P.rightOrthogonal (K⟦n⟧) := P.rightOrthogonal.le_shift n K hK
      have : f = 0 := hKn f ⟨E, 0, (shiftFunctorZero D ℤ).symm.app E, by simp⟩
      exact hf this
    · intro hK X f hX
      exact hK.eq_zero_of_tgt f
  · intro hP K hK
    by_contra hEK
    push Not at hEK
    have hK' : P.rightOrthogonal K := by
      intro X f hX
      rcases hX with ⟨Y, n, e, hY⟩
      rw [singleton_iff] at hY
      subst Y
      have hef : e.inv ≫ f = 0 := by
        obtain ⟨g, hg⟩ :=
          ((shiftEquiv D n).toAdjunction.homEquiv E K).symm.surjective (e.inv ≫ f)
        have hg0 : ((shiftEquiv D n).toAdjunction.homEquiv E K).symm g = 0 := by
          rw [hEK (-n) g]
          rw [Adjunction.homEquiv_counit]
          change
            (shiftEquiv D n).functor.map (0 : E ⟶ (shiftEquiv D n).inverse.obj K) ≫
              (shiftEquiv D n).toAdjunction.counit.app K = 0
          rw [Functor.map_zero (shiftEquiv D n).functor E ((shiftEquiv D n).inverse.obj K),
            Limits.zero_comp]
        exact hg.symm.trans hg0
      calc
        f = e.hom ≫ (e.inv ≫ f) := by simp
        _ = 0 := by simp [hef]
    exact hK (hP ▸ hK')

/-- A weak generator is the same as a generating family indexed by the canonical singleton owner
`singleton E = ofObj (fun _ : Unit ↦ E)`. -/
theorem isWeakGenerator_iff_isGeneratingFamily_unit (E : D) :
    IsWeakGenerator E ↔ IsGeneratingFamily (fun _ : Unit ↦ E) := by
  rw [isWeakGenerator_iff_rightOrthogonal_shifts_eq_isZero, IsGeneratingFamily]

end

section

variable {D : Type u} [Category.{v} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, Functor.Additive (shiftFunctor D n)] [Pretriangulated D]
  [CategoryTheory.IsTriangulated D]

/-- Definition 13.36.3 (1): an object `E` is a classical generator if every saturated
triangulated subcategory containing `E` is the whole triangulated category. -/
def IsClassicalGenerator (E : D) : Prop :=
  ⟨E⟩ = ⊤

/-- Owner-level reformulation of `IsClassicalGenerator`: every saturated triangulated object
property containing the singleton object property on `E` is all of `D`. -/
theorem isClassicalGenerator_iff_singleton_le (E : D) :
    IsClassicalGenerator E ↔
      ∀ (P : ObjectProperty D) [P.IsTriangulated] [P.IsStableUnderRetracts],
        singleton E ≤ P → P = ⊤ :=
  by
    rw [IsClassicalGenerator]
    constructor
    · intro hP P _ _ hPE
      exact top_unique <| by
        rw [← hP]
        exact (objectGeneratedProperty_le_iff E P).2 hPE
    · intro hP
      exact hP ⟨E⟩ (singleton_le_objectGeneratedProperty E)

/-- Definition 13.36.3 (2): an object `E` is a strong generator if every object is obtained from
finitely many extensions of shifts of `E` after closing under retracts. -/
def IsStrongGenerator (E : D) : Prop :=
  ∃ n : ℕ+, (⟨E⟩_n) = (⊤ : ObjectProperty D)

end

end CategoryTheory

/-! ### Lemma_13_36_4 (from Chap13) -/
open CategoryTheory Limits
open CategoryTheory.ObjectProperty
open scoped CategoryTheory.ObjectProperty.GeneratedNotation

universe v u

section

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ]
  [Preadditive C] [∀ n : ℤ, Functor.Additive (shiftFunctor C n)] [Pretriangulated C]
  [IsTriangulated C] {E K : C}

/- Domain-style sampling for Lemma 13.36.4:
- primary domain: generated triangulated subcategories and orthogonality in a triangulated
  category;
- sampled owner declarations:
  `ObjectProperty.rightOrthogonal`,
  `ObjectProperty.shiftClosure`,
  `CategoryTheory.ObjectProperty.objectGeneratedProperty`,
  `CategoryTheory.ObjectProperty.objectGeneratedProperty_le_iff`;
- best owner abstraction: the generated thick subcategory `⟨E⟩` and its canonical orthogonal
  owner `⟨E⟩.rightOrthogonal`;
- primitive data: the generating object `E`, the target object `K`, and the generated object
  property `⟨E⟩`;
- derived API: the explicit quantified restatement over objects `E'` with `⟨E⟩ E'`.

Source/core/bridge triage:
- `source-facing`: the vanishing equivalence from the Stacks lemma;
- `core/canonical`: `⟨E⟩` and `ObjectProperty.rightOrthogonal`;
- `bridge/view`: the final theorem below, which expands `⟨E⟩.rightOrthogonal K` back into the
  pointwise quantified source wording.

The local predicate `in_triangulated_subcategory_generated_by` was a duplicate wheel: the chapter
already owns the generated triangulated subcategory as `⟨E⟩`, so this file should reuse that
owner rather than re-encoding the same universal property locally. -/

/-- Helper for Lemma 13.36.4: the object `K` belongs to the shift-closure of the singleton
property generated by `K`. -/
theorem self_mem_singleton_shiftClosure : ((singleton K).shiftClosure ℤ) K := by
  have hsingleton : (singleton K) K := by
    simp [singleton_iff]
  -- The zero shift places `K` back into the shift-closure of its singleton property.
  exact (singleton K).le_shiftClosure K hsingleton

/-- Helper for Lemma 13.36.4: the left orthogonal to the shift-closure of `K` is closed under
retracts. -/
theorem shiftClosure_singleton_leftOrthogonal_isStableUnderRetracts :
    (((singleton K).shiftClosure ℤ).leftOrthogonal).IsStableUnderRetracts := by
  refine ⟨?_⟩
  intro X Y r hY Z f hZ
  -- Precompose with the retraction onto `Y`, where orthogonality is already known.
  have hrf : r.r ≫ f = 0 := hY (r.r ≫ f) hZ
  calc
    f = r.i ≫ (r.r ≫ f) := by simp
    _ = 0 := by simp [hrf]

/-- Helper for Lemma 13.36.4: if every morphism `E ⟶ K⟦i⟧` vanishes, then `E` lies in the left
orthogonal to the shift-closure of `K`. -/
theorem generator_mem_shiftClosure_leftOrthogonal_of_hom_shift_vanishes
    (h : ∀ (i : ℤ) (f : E ⟶ K⟦i⟧), f = 0) :
    (((singleton K).shiftClosure ℤ).leftOrthogonal) E := by
  intro Y f hY
  -- Unpack `Y` as a shift of `K` and transport the map across the displayed isomorphism.
  rcases hY with ⟨Y', i, e, hY'⟩
  rw [singleton_iff] at hY'
  subst Y'
  have hcomp : f ≫ e.hom = 0 := h i (f ≫ e.hom)
  calc
    f = (f ≫ e.hom) ≫ e.inv := by simp [Category.assoc]
    _ = 0 := by simp [hcomp]

-- Proof sketch: the objects `X` satisfying `Hom(X, K[i]) = 0` for all `i` form the left
-- orthogonal of the shift-closure of `K`, hence a retract-stable triangulated object property.
-- The forward implication applies the minimality of `⟨E⟩` to that orthogonal owner. For the
-- reverse implication, use that `⟨E⟩` is stable under shifts and contains `E`.
/-- Lemma 13.36.4, canonical form: vanishing of all `Hom(E, K[i])` is equivalent to saying that
`K` lies in the right orthogonal of the triangulated subcategory `⟨E⟩` generated by `E`. -/
theorem hom_shift_vanishes_iff_rightOrthogonal_objectGeneratedProperty :
    (∀ (i : ℤ) (f : E ⟶ K⟦i⟧), f = 0) ↔ (⟨E⟩).rightOrthogonal K := by
  let P : ObjectProperty C := ((singleton K).shiftClosure ℤ).leftOrthogonal
  letI : P.IsStableUnderRetracts :=
    shiftClosure_singleton_leftOrthogonal_isStableUnderRetracts (K := K)
  constructor
  · intro h
    -- First show that the generator `E` is already orthogonal to every shift of `K`.
    have hE : P E := by
      simpa [P] using
        generator_mem_shiftClosure_leftOrthogonal_of_hom_shift_vanishes (E := E) (K := K) h
    -- Minimality of `⟨E⟩` upgrades orthogonality from the generator to every generated object.
    have hle : ⟨E⟩ ≤ P := objectGeneratedProperty_le_of_mem E P hE
    -- Evaluate the resulting orthogonality statement at `K`, viewed as the zero shift of itself.
    intro X f hX
    exact hle X hX f (self_mem_singleton_shiftClosure (K := K))
  · intro h i f
    -- Shift-stability of the right orthogonal moves orthogonality of `K` to orthogonality of
    -- each shift `K⟦i⟧`.
    have hshift : (⟨E⟩).rightOrthogonal (K⟦i⟧) := (⟨E⟩).rightOrthogonal.le_shift i K h
    exact hshift f (objectGeneratedProperty_contains E)

/-- Lemma 13.36.4: vanishing of all `Hom(E, K[i])` is equivalent to vanishing of
`Hom(E', K)` for every object `E'` in the triangulated subcategory generated by `E`. -/
theorem hom_shift_vanishes_iff_vanishes_on_triangulated_subcategory_generated_by :
    (∀ (i : ℤ) (f : E ⟶ K⟦i⟧), f = 0) ↔
      ∀ ⦃E' : C⦄ (f : E' ⟶ K), ⟨E⟩ E' → f = 0 := by
  -- Unpack membership in the canonical right orthogonal into the source-facing quantifier form.
  rw [hom_shift_vanishes_iff_rightOrthogonal_objectGeneratedProperty]
  exact (⟨E⟩).rightOrthogonal_iff K

end

/-! ### Lemma_13_36_5 (from Chap13) -/
open CategoryTheory
open CategoryTheory.Limits
open scoped CategoryTheory.ObjectProperty.GeneratedNotation

universe v u

section

variable {D : Type u} [Category.{v} D] [Limits.HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, Functor.Additive (shiftFunctor D n)] [Pretriangulated D]
  [CategoryTheory.IsTriangulated D]

/- Domain-style sampling for Lemma 13.36.5:
- primary domain: generators in triangulated categories, organized through generated object
  properties and orthogonality;
- sampled owner declarations:
  `IsClassicalGenerator`,
  `IsWeakGenerator`,
  `isWeakGenerator_iff_rightOrthogonal_shifts_eq_isZero`,
  `hom_shift_vanishes_iff_rightOrthogonal_objectGeneratedProperty`;
- best owner abstraction: the canonical core is the generated triangulated object property `⟨E⟩`
  together with its right orthogonal;
- primitive data: the object `E` and the classical-generator equality `⟨E⟩ = ⊤`;
- derived API: the weak-generator conclusion, expressed through the vanishing of the right
  orthogonal of all shifts of `E`;
- source/core/bridge triage:
  `source-facing`: `weak_generator_of_classical_generator`;
  `core/canonical`: `⟨E⟩`, `rightOrthogonal`, and `IsZero`;
  `bridge/view`: the shift-vanishing criterion from Lemma `13.36.4`.

This file should reuse the Chapter 13 owner-level orthogonality bridge rather than introduce a
parallel "objects orthogonal to all shifts of `E`" predicate. -/

-- Proof sketch: to show that `E` is a weak generator, let `K` be right-orthogonal to all shifts of
-- `E`. Lemma 13.36.4 shows that every object in the triangulated subcategory generated by `E` is
-- right-orthogonal to `K`; since `E` is a classical generator, that subcategory is all of `D`, so
-- `𝟙 K = 0` and hence `K` is zero.
/-- Lemma 13.36.5: if `E` is a classical generator of a triangulated category, then `E` is a weak
generator. -/
theorem weak_generator_of_classical_generator {E : D}
    (hE : IsClassicalGenerator E) :
    IsWeakGenerator E := by
  rw [IsClassicalGenerator] at hE
  intro K hK
  by_contra hvanish
  push Not at hvanish
  have horth : (⟨E⟩).rightOrthogonal K :=
    hom_shift_vanishes_iff_rightOrthogonal_objectGeneratedProperty.1 hvanish
  have hmem : ⟨E⟩ K := by
    rw [hE]
    trivial
  exact hK <| (IsZero.iff_id_eq_zero K).2 <|
    horth (𝟙 K) hmem

end

/-! ### Lemma_13_36_6 (from Chap13) -/
open CategoryTheory
open CategoryTheory.ObjectProperty
open CategoryTheory.Pretriangulated
open scoped CategoryTheory.ObjectProperty.GeneratedNotation

universe v u

namespace CategoryTheory

section

variable {D : Type u} [Category.{v} D] [Limits.HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, Functor.Additive (shiftFunctor D n)] [Pretriangulated D]
  [CategoryTheory.IsTriangulated D]

/- Domain-style sampling for Lemma 13.36.6:
- primary domain: strong and classical generators in triangulated categories, expressed through the
  chapter owners `⟨E⟩` and `⟨E⟩_n` on `ObjectProperty`;
- sampled owner declarations:
  `IsClassicalGenerator`,
  `IsStrongGenerator`,
  `objectGeneratedStage_one_eq`,
  `objectGeneratedStage_add`;
- best owner abstraction: the proof should run entirely through the generated-stage owner
  `⟨E⟩_n`, not through a parallel wrapper for “objects obtained from `E` in finitely many steps”;
- primitive data: a strong generator witness `⟨E'⟩_n = ⊤`, a classical-generator equality
  `⟨E⟩ = ⊤`, and the stage-membership witness `E' ∈ ⟨E⟩_m`;
- derived API: the stage-one comparison `⟨E'⟩_1 ≤ ⟨E⟩_m` and its iteration to higher stages.

Source/core/bridge triage:
- `source-facing`: `strong_generator_of_classical_generator`;
- `core/canonical`: `⟨E⟩`, `⟨E⟩_n`, `objectGeneratedStage_one_eq`, and `objectGeneratedStage_add`;
- `bridge/view`: the local proof-only shift/additive/retract-closure instances used to show that a
  stage containing `E'` already contains the first stage generated by `E'`.
-/

-- Proof sketch: choose a strong generator `E'` with `D = ⟨E'⟩ₙ` for some `n`. Since `E` is a
-- classical generator, Lemma `objectGeneratedProperty_le_iff` forces the triangulated subcategory
-- `⟨E⟩` generated by `E` to be all of `D`, so `E' ∈ ⟨E⟩ₘ` for some `m`. Then
-- `⟨E'⟩₁ ⊆ ⟨E⟩ₘ`, and Lemma `objectGeneratedStage_add` together with the stage description from
-- Lemma `13.36.1` yields `D = ⟨E'⟩ₙ ⊆ ⟨E⟩ₙₘ`, proving that `E` is a strong generator.
omit [CategoryTheory.IsTriangulated D] in
/-- Helper for Lemma 13.36.6: if `E` is a classical generator, then every object lies in some
finite stage generated by `E`. -/
theorem stage_membership_of_classical_generator {E E' : D} (hE : IsClassicalGenerator E) :
    ∃ m : ℕ+, (⟨E⟩_m) E' := by
  -- Rewrite classical generation as `⟨E⟩ = ⊤`.
  rw [IsClassicalGenerator] at hE
  have hmem : ⟨E⟩ E' := by
    rw [hE]
    trivial
  -- Unfold the supremum presentation of `⟨E⟩` and extract a finite stage containing `E'`.
  rw [objectGeneratedProperty, prop_iSup_iff] at hmem
  exact hmem

omit [CategoryTheory.IsTriangulated D] in
/-- Helper for Lemma 13.36.6: if `E'` belongs to the `m`-th stage generated by `E`, then the first
stage generated by `E'` is already contained in that same stage of `E`. -/
theorem objectGeneratedStage_one_le_of_mem {E E' : D} {m : ℕ+}
    (hEm : (⟨E⟩_m) E') :
    (⟨E'⟩_1) ≤ ⟨E⟩_m := by
  let Pm : ObjectProperty D := additiveExtensionStage ((ObjectProperty.singleton E).shiftClosure ℤ) m
  -- Rewrite the target owner into the additive-extension form used by the stage API.
  rw [objectGeneratedStage_eq_additiveExtensionStage E m]
  change (⟨E'⟩_1) ≤ Pm
  rw [objectGeneratedStage_one_eq, retractClosure_le_iff]
  -- It remains to show that the additive closure of the shifts of `E'` sits inside `Pm`.
  let _ : Pm.IsClosedUnderBinaryCoproducts := inferInstance
  let _ : Pm.IsClosedUnderFiniteCoproducts := ObjectProperty.IsClosedUnderFiniteCoproducts.mk'
  refine colimitsClosure_le ?_
  rw [shiftClosure_le_iff, singleton_le_iff]
  simpa [Pm] using
    (show additiveExtensionStage ((ObjectProperty.singleton E).shiftClosure ℤ) m E' from by
      rwa [← objectGeneratedStage_eq_additiveExtensionStage E m])

/-- Helper for Lemma 13.36.6: once the first stage of `E'` is bounded by the `m`-th stage of `E`,
the same bound propagates to every higher stage with multiplicative index growth. -/
theorem objectGeneratedStage_le_mul_stage {E E' : D} {m : ℕ+}
    (h1 : (⟨E'⟩_1) ≤ ⟨E⟩_m) :
    ∀ k : ℕ+, (⟨E'⟩_k) ≤ ⟨E⟩_(k * m) := by
  intro k
  refine PNat.recOn k ?_ ?_
  · simpa using h1
  · intro k ih
    -- Rewrite the successor stage using the canonical addition formula for generated stages.
    rw [objectGeneratedStage_add E' k 1]
    have hstep :
        ((⟨E'⟩_k).extensionProduct ⟨E'⟩_1).retractClosure ≤
          ((⟨E⟩_(k * m)).extensionProduct ⟨E⟩_m).retractClosure := by
      -- Monotonicity on both extension-product factors propagates the inductive bound.
      rw [retractClosure_le_iff]
      exact ((monotone_extensionProduct_left (⟨E'⟩_1) ih).trans <|
        monotone_extensionProduct_right (⟨E⟩_(k * m)) h1).trans (le_retractClosure _)
    -- Identify the right-hand extension product with the `(k + 1) * m` stage of `E`.
    exact hstep.trans <| by
      simpa [add_mul] using le_of_eq (objectGeneratedStage_add E (k * m) m).symm

/-- Lemma 13.36.6: in a triangulated category admitting a strong generator, every classical
generator is a strong generator. -/
theorem strong_generator_of_classical_generator (E : D)
    (hD : ∃ E' : D, IsStrongGenerator E')
    (hE : IsClassicalGenerator E) :
    IsStrongGenerator E := by
  rcases hD with ⟨E', n, hn⟩
  -- First place the known strong generator `E'` into a finite stage generated by `E`.
  rcases stage_membership_of_classical_generator (E' := E') hE with ⟨m, hEm⟩
  -- Then the whole first stage of `E'` is already controlled by that stage of `E`.
  have h1 : (⟨E'⟩_1) ≤ ⟨E⟩_m := objectGeneratedStage_one_le_of_mem hEm
  -- Iterate that stage-one bound through the strong-generation length `n`.
  have hpow : (⟨E'⟩_n) ≤ ⟨E⟩_(n * m) := objectGeneratedStage_le_mul_stage h1 n
  -- Replace `⟨E'⟩_n` by `⊤` and package the resulting finite-stage witness for `E`.
  refine ⟨n * m, top_unique ?_⟩
  simpa [hn] using hpow

end

end CategoryTheory

