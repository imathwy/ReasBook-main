/-! ### Definition_8_4_1 (from Chap08) -/
universe w v₁ v₂ u₁ u₂

namespace CategoryTheory

variable {C : Type u₁} [Category.{v₁} C]
variable {S : Type u₂} [Category.{v₂} S]

/- Domain-style sampling for Definition 8.4.1:
- primary domain: stack conditions on a site for a category over the base, expressed through the
  canonical fiber pseudofunctor;
- inspected owner-level declarations:
  `Pseudofunctor.IsStack`,
  `canonicalFiberPseudofunctor`,
  `Pseudofunctor.sheafHom`,
  `Pseudofunctor.isEquivalence_toDescentData`;
- best owner abstraction: the source-facing owner `IsStackOnSite J p` should extend the canonical
  owner `Pseudofunctor.IsStack (canonicalFiberPseudofunctor p) J`, with `p.IsFibered` as the
  only additional primitive data needed to talk about the canonical fibers;
- primitive data: a fibred projection `p : S ⥤ C` and the stack condition on its canonical fiber
  pseudofunctor;
- derived API: the canonical Hom-sheaf object
  `(canonicalFiberPseudofunctor p).sheafHom J x y`; effective descent for covering families is
  reused directly from the parent owner
  `Pseudofunctor.IsStack (canonicalFiberPseudofunctor p) J`; the introduction theorem from these
  two parent owners to `IsStackOnSite J p` is derived and should not be rebuilt manually
  downstream.

Source/core/bridge triage:
- `source-facing`: `IsStackOnSite J p`;
- `core/canonical`: `p.IsFibered` and
  `Pseudofunctor.IsStack (canonicalFiberPseudofunctor p) J`;
- `bridge/view`: direct reuse of the canonical fiberwise Hom sheaf
  `(canonicalFiberPseudofunctor p).sheafHom J x y`. -/

/-- Definition 8.4.1: a stack over the site `(C, J)` is a category over `C` whose projection is
fibred and whose canonical pseudofunctor of fibers is a stack for `J`; this packages both the
sheaf condition on the presheaves `Mor(x, y)` and the effectiveness of descent data. -/
class IsStackOnSite (J : GrothendieckTopology C) (p : S ⥤ C) : Prop
    extends p.IsFibered, Pseudofunctor.IsStack (canonicalFiberPseudofunctor p) J

/-- A fibred category whose canonical fiber pseudofunctor is already a stack for `J` is
canonically a stack over the site `(C, J)`. -/
instance isStackOnSite_of_isStack (J : GrothendieckTopology C) (p : S ⥤ C) [p.IsFibered]
    [Pseudofunctor.IsStack (canonicalFiberPseudofunctor p) J] : IsStackOnSite J p where
  toIsFibered := inferInstance
  toIsStack := inferInstance

end CategoryTheory

/-! ### Lemma_8_4_2 (from Chap08) -/
universe u₁ u₂ v₁ v₂ vDesc

namespace CategoryTheory

open GrothendieckTopology.Cover

section

variable {C : Type u₁} {X : Type u₂} [Category.{v₁} C] [Category.{v₂} X]
variable (J : GrothendieckTopology C) (p : X ⥤ C) [p.IsFibered]

/- Domain-style sampling for Lemma 8.4.2:
- primary domain: stacks over a site, expressed through the canonical fiber pseudofunctor and
  descent-data equivalences for covering families.
- inspected owner-level declarations:
  `IsStackOnSite`,
  `Pseudofunctor.IsStackFor`,
  `Pseudofunctor.isStackFor'`,
  `Pseudofunctor.isStackFor_ofArrows_iff`,
  `Pseudofunctor.IsStack.of_isStackFor`.
- best owner abstraction: the source-facing owner is `IsStackOnSite J p`; the chosen-pullback
  system underlying `canonicalFiberPseudofunctor p` is not new public data here.
- primitive data: a fibred projection `p` together with the stack condition on
  `canonicalFiberPseudofunctor p`.
- derived API: the fixed-cover stack condition for `((S : Sieve U).arrows)` and the equivalent
  cover-indexed descent-data functor.

Source/core/bridge triage:
- `source-facing`: `IsStackOnSite J p` and Lemma 8.4.2.
- `core/canonical`: `Pseudofunctor.IsStack (canonicalFiberPseudofunctor p) J`.
- `bridge/view`: the cover-to-presieve identification `S.ofArrows_eq`, used to pass between a
  `J.Cover U` and the canonical `IsStackFor` owner for the underlying covering sieve. -/

/-- Helper for Lemma 8.4.2: the owner-level stack condition on the covering sieve attached to `S`
is equivalent to the descent-data functor for the family of cover arrows being an equivalence. -/
theorem canonicalFiberPseudofunctor_isStackFor_cover_iff {U : C} (S : J.Cover U) :
    (canonicalFiberPseudofunctor p).IsStackFor ((S : Sieve U).arrows) ↔
      ((canonicalFiberPseudofunctor p).toDescentData (fun I : S.Arrow ↦ I.f)).IsEquivalence := by
  let F := canonicalFiberPseudofunctor p
  let f : ∀ I : S.Arrow, I.Y ⟶ U := fun I ↦ I.f
  -- First replace the covering sieve by the presieve generated by the cover arrows.
  have hsieve :
      F.IsStackFor ((S : Sieve U).arrows) ↔
        F.IsStackFor (Presieve.ofArrows Arrow.Y f) := by
    exact F.isStackFor_iff_of_sieve_eq <| by
      simpa [f, Sieve.ofArrows] using S.ofArrows_eq.symm
  -- Then invoke the canonical `ofArrows` descent criterion for the same family.
  have hofArrows :
      F.IsStackFor (Presieve.ofArrows Arrow.Y f) ↔ (F.toDescentData f).IsEquivalence := by
    exact F.isStackFor_ofArrows_iff f
  simpa [F, f] using hsieve.trans hofArrows

/-- Lemma 8.4.2: a fibred category over `(C, J)` is a stack exactly when, for every cover
`S : J.Cover U`, the canonical functor from the fiber over `U` to the corresponding category of
descent data is an equivalence. -/
theorem isStackOnSite_iff_coverwise_canonicalDescentFunctor_isEquivalence :
    IsStackOnSite J p ↔
      ∀ (U : C) (S : J.Cover U),
        ((canonicalFiberPseudofunctor p).toDescentData (fun I : S.Arrow ↦ I.f)).IsEquivalence := by
  let F := canonicalFiberPseudofunctor p
  constructor
  · intro hp U S
    -- The site-level stack owner gives `IsStackFor` for every covering sieve.
    let _ : IsStackOnSite J p := hp
    exact (canonicalFiberPseudofunctor_isStackFor_cover_iff J p S).1 <| by
      simpa [F] using F.isStackFor' (S : Sieve U) S.condition
  · intro h
    -- Rebuild the canonical stack owner by checking `IsStackFor` on an arbitrary covering sieve.
    letI : Pseudofunctor.IsStack F J := by
      refine Pseudofunctor.IsStack.of_isStackFor ?_
      intro U R hR
      let S : J.Cover U := ⟨R, hR⟩
      simpa [F] using (canonicalFiberPseudofunctor_isStackFor_cover_iff J p S).2 (h U S)
    exact isStackOnSite_of_isStack J p

end

end CategoryTheory

/-! ### Lemma_8_4_2_Core (from Chap08) -/
universe u₁ u₂ v₁ v₂ vDesc

namespace CategoryTheory

open GrothendieckTopology.Cover

section

variable {C : Type u₁} {X : Type u₂} [Category.{v₁} C] [Category.{v₂} X]
variable (J : GrothendieckTopology C) (p : X ⥤ C) [p.IsFibered]

/-- Helper for Lemma 8.4.2 core: the owner-level stack condition on the covering sieve attached
to `S` is equivalent to the descent-data functor for the family of cover arrows being an
equivalence. This small core file isolates the criterion needed by Lemma 8.5.3. -/
theorem canonicalFiberPseudofunctor_isStackFor_cover_iff {U : C} (S : J.Cover U) :
    (canonicalFiberPseudofunctor p).IsStackFor ((S : Sieve U).arrows) ↔
      ((canonicalFiberPseudofunctor p).toDescentData (fun I : S.Arrow ↦ I.f)).IsEquivalence := by
  let F := canonicalFiberPseudofunctor p
  let f : ∀ I : S.Arrow, I.Y ⟶ U := fun I ↦ I.f
  have hcover : Sieve.ofArrows Arrow.Y f = (S : Sieve U) := by
    -- Identify the sieve generated by the cover arrows with the underlying covering sieve.
    ext Y g
    rw [Sieve.mem_ofArrows_iff]
    constructor
    · rintro ⟨I, h, rfl⟩
      exact S.1.downward_closed I.hf h
    · intro hg
      exact ⟨⟨Y, g, hg⟩, 𝟙 _, by simp [f]⟩
  -- First replace the covering sieve by the presieve generated by the cover arrows.
  have hsieve :
      F.IsStackFor ((S : Sieve U).arrows) ↔
        F.IsStackFor (Presieve.ofArrows Arrow.Y f) := by
    exact F.isStackFor_iff_of_sieve_eq <| by
      simpa [f] using hcover.symm
  -- Then invoke the canonical `ofArrows` descent criterion for the same family.
  have hofArrows :
      F.IsStackFor (Presieve.ofArrows Arrow.Y f) ↔ (F.toDescentData f).IsEquivalence := by
    exact F.isStackFor_ofArrows_iff f
  simpa [F, f] using hsieve.trans hofArrows

/-- Lemma 8.4.2 core: a fibred category over `(C, J)` is a stack exactly when, for every cover
`S : J.Cover U`, the canonical functor from the fiber over `U` to the corresponding category of
descent data is an equivalence. -/
theorem isStackOnSite_iff_coverwise_canonicalDescentFunctor_isEquivalence :
    IsStackOnSite J p ↔
      ∀ (U : C) (S : J.Cover U),
        ((canonicalFiberPseudofunctor p).toDescentData (fun I : S.Arrow ↦ I.f)).IsEquivalence := by
  let F := canonicalFiberPseudofunctor p
  constructor
  · intro hp U S
    -- The site-level stack owner gives `IsStackFor` for every covering sieve.
    let _ : IsStackOnSite J p := hp
    exact (canonicalFiberPseudofunctor_isStackFor_cover_iff J p S).1 <| by
      simpa [F] using F.isStackFor' (S : Sieve U) S.condition
  · intro h
    -- Rebuild the canonical stack owner by checking `IsStackFor` on an arbitrary covering sieve.
    letI : Pseudofunctor.IsStack F J := by
      refine Pseudofunctor.IsStack.of_isStackFor ?_
      intro U R hR
      let S : J.Cover U := ⟨R, hR⟩
      simpa [F] using (canonicalFiberPseudofunctor_isStackFor_cover_iff J p S).2 (h U S)
    exact isStackOnSite_of_isStack J p

end

end CategoryTheory
