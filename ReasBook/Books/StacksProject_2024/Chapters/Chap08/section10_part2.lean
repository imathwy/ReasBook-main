/-- Helper for Lemma 8.10.5: isolate the object-level part of the downstairs forgetting functor.
This is the literal-base `DescentData` package that still needs the counit-induced reindexing
isomorphisms on overlaps over `C`. -/
private noncomputable def inherited_basis_forget_to_source_descent_obj
    (F : Xₛ ⟶ Yₛ)
    [IsFibredInGroupoids (G F)]
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (D : ((canonicalFiberPseudofunctor (G F)).DescentData g)) :
    ((canonicalFiberPseudofunctor Xₛ.p).DescentData (fun i ↦ Yₛ.p.map (g i))) :=
  { obj := fun i ↦ inherited_source_fiber_obj (F := F) (D.obj i)
    hom := fun {Z} q {i₁ i₂} f₁ f₂ hf₁ hf₂ ↦
      inherited_basis_forget_to_source_descent_hom
        (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) F D q f₁ f₂ hf₁ hf₂
    pullHom_hom := by
      intro Z' Z k q q' hq i₁ i₂ f₁ f₂ hf₁ hf₂ kf₁ kf₂ hkf₁ hkf₂
      simpa using
        inherited_basis_forget_to_source_descent_hom_pullHom_hom
          (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) F D k q q' hq
          f₁ f₂ hf₁ hf₂ kf₁ kf₂ hkf₁ hkf₂
    hom_self := by
      intro Z q i f hf
      simpa using
        inherited_basis_forget_to_source_descent_hom_self
          (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) F D q f hf
    hom_comp := by
      intro Z q i₁ i₂ i₃ f₁ f₂ f₃ hf₁ hf₂ hf₃
      simpa using
        inherited_basis_forget_to_source_descent_hom_comp
          (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) F D q f₁ f₂ f₃ hf₁ hf₂ hf₃ }

/-- Helper for Lemma 8.10.5: assemble the objectwise literal-base forgetting construction into a
functor on descent data. The remaining work is the transported componentwise compatibility square. -/
private noncomputable def inherited_basis_forget_to_source_descent
    (F : Xₛ ⟶ Yₛ)
    [IsFibredInGroupoids (G F)]
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y} :
    ((canonicalFiberPseudofunctor (G F)).DescentData g) ⥤
      ((canonicalFiberPseudofunctor Xₛ.p).DescentData (fun i ↦ Yₛ.p.map (g i))) :=
  { obj := fun D ↦
      inherited_basis_forget_to_source_descent_obj
        (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) F D
    map := fun {D₁ D₂} φ ↦
      { hom := fun i ↦ by
          change inherited_source_fiber_obj (F := F) (D₁.obj i) ⟶
            inherited_source_fiber_obj (F := F) (D₂.obj i)
          exact (inherited_source_fiber_forget (F := F) (Y i)).map (φ.hom i)
        comm := by
          intro Z q i₁ i₂ f₁ f₂ hf₁ hf₂
          simpa [inherited_basis_forget_to_source_descent_obj] using
            inherited_basis_forget_to_source_descent_literal_comm
              (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) (F := F) φ q f₁ f₂ hf₁ hf₂ }
    map_id := by
      intro D
      ext i
      rfl
    map_comp := by
      intro D₁ D₂ D₃ φ ψ
      ext i
      rfl }

