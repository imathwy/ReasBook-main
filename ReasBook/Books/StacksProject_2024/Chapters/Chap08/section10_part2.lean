        (J := J) (Yₛ := Yₛ) (y := y) (Y := Y) (g := g) q f₃ hf₃)
      (inherited_basis_target_slice_inverse_leg_w
        (J := J) (Yₛ := Yₛ) (y := y) (Y := Y) (g := g) q f₁ hf₁)
      (inherited_basis_target_slice_inverse_leg_w
        (J := J) (Yₛ := Yₛ) (y := y) (Y := Y) (g := g) q f₂ hf₂)
      (inherited_basis_target_slice_inverse_leg_w
