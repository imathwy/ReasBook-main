    inherited_basis_forget_to_source_descent_hom
        (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) F D q f₁ f₃ hf₁ hf₃ := by
  have hmid :=
    inherited_basis_forget_to_source_descent_hom_comp_middle
      (J := J) (Xₛ := Xₛ) (Yₛ := Yₛ) F D q f₁ f₂ f₃ hf₁ hf₂ hf₃
