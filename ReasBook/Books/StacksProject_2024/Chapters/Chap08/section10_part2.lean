    ((canonicalFiberPseudofunctor Xₛ.p).mapComp'
      c.op.toLoc cInv.op.toLoc (𝟙 Z).op.toLoc hc_comp)).app M₁
  let A₂ := (Cat.Hom.toNatIso
    ((canonicalFiberPseudofunctor Xₛ.p).mapComp'
      c.op.toLoc cInv.op.toLoc (𝟙 Z).op.toLoc hc_comp)).app M₂
  let A₃ := (Cat.Hom.toNatIso
    ((canonicalFiberPseudofunctor Xₛ.p).mapComp'
      c.op.toLoc cInv.op.toLoc (𝟙 Z).op.toLoc hc_comp)).app M₃
  let ρ₁ := T.mapIso
