/-- Helper for Lemma 8.10.5: the raw right `mapComp'` boundary matches the strict `kf₂`-shell
after passing through the forgotten source comparison on the common refinement. -/
private theorem inherited_basis_descent_hom_pullHom_right_boundary_postcompose_target
    (F : Xₛ ⟶ Yₛ)
    [IsFibredInGroupoids (G F)]
    {ι : Type*} {y : Yₛ.S} {Y : ι → Yₛ.S} {g : ∀ i, Y i ⟶ y}
    (D : ((canonicalFiberPseudofunctor (G F)).DescentData g))
