import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.


/-! ### Lemma_10_114_1 (from Chap10) -/
universe u

section

variable {k : Type u} [Field k]
variable {n : ℕ}

variable (m : MaximalSpectrum (MvPolynomial (Fin n) k))

/-- Helper for Lemma 10.114.1: the image of a `Fin n`-indexed generating family remains a
`Fin n`-indexed generating family after localizing at the corresponding prime, so the maximal
ideal of the localization has `spanFinrank` at most `n`. -/
lemma localized_maximalIdeal_spanFinrank_le_card
    {x : Fin n → MvPolynomial (Fin n) k}
    (hx : Ideal.span (Set.range x) = m.asIdeal) :
    (IsLocalRing.maximalIdeal (Localization.AtPrime m.asIdeal)).spanFinrank ≤ n := by
  classical
  -- First rewrite the maximal ideal of the localization as the image of `m.asIdeal`.
  have hmap :
      Ideal.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime m.asIdeal)) m.asIdeal =
        IsLocalRing.maximalIdeal (Localization.AtPrime m.asIdeal) := by
    simpa using (Localization.AtPrime.map_eq_maximalIdeal (I := m.asIdeal))
  suffices hspan :
      (Ideal.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime m.asIdeal))
        m.asIdeal).spanFinrank ≤ n by
    simpa [hmap] using hspan
  -- Then transport the chosen generating family across the localization map.
  have hspan_eq :
      (Ideal.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime m.asIdeal))
        m.asIdeal).spanFinrank =
      (Ideal.span (Set.range fun i : Fin n ↦ algebraMap (MvPolynomial (Fin n) k)
        (Localization.AtPrime m.asIdeal) (x i))).spanFinrank := by
    calc
      (Ideal.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime m.asIdeal))
        m.asIdeal).spanFinrank
          =
            (Ideal.map (algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime m.asIdeal))
              (Ideal.span (Set.range x))).spanFinrank := by
              simpa [hx]
      _ =
          (Ideal.span (((algebraMap (MvPolynomial (Fin n) k)
            (Localization.AtPrime m.asIdeal)) '' Set.range x))).spanFinrank := by
            rw [Ideal.map_span]
      _ =
          (Ideal.span (Set.range fun i : Fin n ↦ algebraMap (MvPolynomial (Fin n) k)
            (Localization.AtPrime m.asIdeal) (x i))).spanFinrank := by
            have himage :
                ((algebraMap (MvPolynomial (Fin n) k) (Localization.AtPrime m.asIdeal)) ''
                  Set.range x) =
                  Set.range fun i : Fin n ↦ algebraMap (MvPolynomial (Fin n) k)
                    (Localization.AtPrime m.asIdeal) (x i) := by
              ext y
              constructor
              · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
                exact ⟨i, rfl⟩
              · rintro ⟨i, rfl⟩
                exact ⟨x i, ⟨i, rfl⟩, rfl⟩
            exact congrArg (fun s : Set (Localization.AtPrime m.asIdeal) =>
              (Ideal.span s).spanFinrank) himage
  -- The localized ideal is still spanned by a `Fin n`-indexed family, hence needs at most `n`
  -- generators.
  rw [hspan_eq]
  refine le_trans (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)) ?_
  let s : Finset (Localization.AtPrime m.asIdeal) :=
    Finset.univ.image fun i : Fin n ↦ algebraMap (MvPolynomial (Fin n) k)
      (Localization.AtPrime m.asIdeal) (x i)
  have hs :
      Set.range (fun i : Fin n ↦ algebraMap (MvPolynomial (Fin n) k)
        (Localization.AtPrime m.asIdeal) (x i)) = (s : Set (Localization.AtPrime m.asIdeal)) := by
    ext y
    simp [s]
  rw [hs, Set.ncard_coe_finset]
  simpa [s] using
    (Finset.card_image_le
      (s := (Finset.univ : Finset (Fin n)))
      (f := fun i : Fin n ↦ algebraMap (MvPolynomial (Fin n) k)
        (Localization.AtPrime m.asIdeal) (x i)))

/-- Helper for Lemma 10.114.1: every maximal localization of the polynomial ring has Krull
dimension at most `n`. -/
lemma ringKrullDim_localizationAtMaximal_mvPolynomial_le :
    ringKrullDim (Localization.AtPrime m.asIdeal) ≤ n := by
  -- The localization dimension is the height of `m.asIdeal`.
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height m.asIdeal
    (Localization.AtPrime m.asIdeal)]
  -- Any prime height is bounded by the ambient polynomial-ring dimension.
  refine le_trans (Ideal.height_le_ringKrullDim_of_ne_top Ideal.IsPrime.ne_top') ?_
  -- The ambient polynomial ring has dimension `n` because the base field has dimension `0`.
  simpa [ringKrullDim_eq_zero_of_field] using
    (MvPolynomial.ringKrullDim_of_isNoetherianRing (R := k) (ι := Fin n))

/-- Helper for Lemma 10.114.1: if the image of an ideal in a quotient polynomial ring is
principal, then the original ideal is generated by the quotient ideal together with one lift of
that principal generator. -/
lemma polynomial_ideal_eq_sup_span_of_quotient_generator
    {A : Type*} [CommRing A] {I J : Ideal (Polynomial A)} (hIJ : I ≤ J) {g : Polynomial A}
    (hg : Ideal.map (Ideal.Quotient.mk I) J =
      Ideal.span ({Ideal.Quotient.mk I g} : Set (Polynomial A ⧸ I))) :
    J = I ⊔ Ideal.span ({g} : Set (Polynomial A)) := by
  -- Pull the quotient-side equality back along the quotient map.
  have hcomap := congrArg (Ideal.comap (Ideal.Quotient.mk I)) hg
  -- The left-hand side recovers `J` because `I ≤ J`.
  have hker :
      Ideal.comap (Ideal.Quotient.mk I) (⊥ : Ideal (Polynomial A ⧸ I)) = I := by
    rw [← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
  rw [Ideal.comap_map_of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective J,
    hker, sup_eq_left.mpr hIJ] at hcomap
  -- The right-hand side becomes the quotient ideal plus the lifted singleton generator.
  have hspan :
      Ideal.comap (Ideal.Quotient.mk I)
        (Ideal.span ({Ideal.Quotient.mk I g} : Set (Polynomial A ⧸ I))) =
        I ⊔ Ideal.span ({g} : Set (Polynomial A)) := by
    ext f
    rw [Ideal.mem_comap]
    simpa [Ideal.map_span, Set.image_singleton, sup_comm] using
      (Ideal.mem_quotient_iff_mem_sup (I := I) (J := Ideal.span ({g} : Set (Polynomial A)))
        (x := f))
  rw [hspan] at hcomap
  exact hcomap

-- Proof sketch: identify `m.asIdeal` with the kernel of the quotient map to the residue field
-- `(MvPolynomial (Fin n) k) ⧸ m.asIdeal`, use Zariski's lemma to see that this residue field is a
-- finite `k`-algebra, and then apply the cotangent-space presentation of the maximal ideal to
-- obtain a generating family of length `n`.
/-- Lemma 10.114.1 (1): for a maximal ideal `m` of `k[x_1, \ldots, x_n]`, formalized as
`m : MaximalSpectrum (MvPolynomial (Fin n) k)`, the ideal `m.asIdeal` is generated by `n`
elements. -/
theorem exists_fin_generators_maximalIdeal_mvPolynomial :
    ∃ x : Fin n → MvPolynomial (Fin n) k, Ideal.span (Set.range x) = m.asIdeal := by
  induction n with
  | zero =>
      classical
      let e : MvPolynomial (Fin 0) k ≃ₐ[k] k :=
        MvPolynomial.isEmptyAlgEquiv k (Fin 0)
      let x : Fin 0 → MvPolynomial (Fin 0) k := Fin.elim0
      refine ⟨x, ?_⟩
      -- In zero variables the polynomial ring is just the field `k`, so the maximal ideal is
      -- forced to be zero and hence generated by the empty family.
      have hmap_max : (Ideal.map e.toRingHom m.asIdeal).IsMaximal := by
        exact (Ideal.isMaximal_map_iff_of_bijective (f := e.toRingHom) e.bijective).2 inferInstance
      have hbot_max : (⊥ : Ideal k).IsMaximal := Ideal.bot_isMaximal
      have hmap_bot : Ideal.map e.toRingHom m.asIdeal = (⊥ : Ideal k) := by
        exact (hbot_max.eq_of_le hmap_max.1.1 bot_le).symm
      have hm_le_ker : m.asIdeal ≤ RingHom.ker e.toRingHom :=
        (Ideal.map_eq_bot_iff_le_ker e.toRingHom).mp hmap_bot
      have hker_bot : RingHom.ker e.toRingHom = (⊥ : Ideal (MvPolynomial (Fin 0) k)) := by
        rw [RingHom.ker_eq_comap_bot]
        exact Ideal.comap_bot_of_injective (f := e.toRingHom) e.injective
      have hm_bot : m.asIdeal = (⊥ : Ideal (MvPolynomial (Fin 0) k)) := by
        exact le_antisymm ((hker_bot ▸ hm_le_ker).trans bot_le) bot_le
      simpa [x, hm_bot]
  | succ n ih =>
      classical
      -- Route correction: we execute the source proof one variable at a time by rewriting
      -- `k[x₁, …, xₙ₊₁]` as `A[X]`, contracting along `C : A → A[X]`, and then lifting one
      -- generator from the maximal ideal of the quotient polynomial ring over `A ⧸ p`.
      let A := MvPolynomial (Fin n) k
      let e : MvPolynomial (Fin (n + 1)) k ≃ₐ[k] Polynomial A :=
        MvPolynomial.finSuccEquiv k n
      let M : Ideal (Polynomial A) := Ideal.map e.toRingHom m.asIdeal
      have hMmax : M.IsMaximal := by
        simpa [M] using
          (Ideal.isMaximal_map_iff_of_bijective (f := e.toRingHom) e.bijective).2 inferInstance
      letI : M.IsMaximal := hMmax
      let p : Ideal A := Ideal.comap Polynomial.C M
      have hpmax : p.IsMaximal := by
        simpa [p] using (Polynomial.isMaximal_comap_C_of_isJacobsonRing (P := M))
      letI : p.IsMaximal := hpmax
      let mp : MaximalSpectrum A := ⟨p, hpmax⟩
      obtain ⟨y, hy⟩ := ih (m := mp)
      let I : Ideal (Polynomial A) := Ideal.map Polynomial.C p
      have hI_le_M : I ≤ M := by
        change Ideal.map (Polynomial.C : A →+* Polynomial A) p ≤ M
        exact Ideal.map_le_of_le_comap (show p ≤ Ideal.comap (Polynomial.C : A →+* Polynomial A) M by
          simpa [p])
      let Iquot : Ideal (Polynomial A ⧸ I) := Ideal.map (Ideal.Quotient.mk I) M
      let K := A ⧸ p
      letI : Field K := Ideal.Quotient.field p
      let qequiv : Polynomial K ≃+* Polynomial A ⧸ I :=
        Ideal.polynomialQuotientEquivQuotientPolynomial p
      let J : Ideal (Polynomial K) := Ideal.map qequiv.symm.toRingHom Iquot
      letI : IsPrincipalIdealRing (Polynomial K) := inferInstance
      have hJprincipal :
          @Submodule.IsPrincipal (Polynomial K) (Polynomial K) _ _ (Semiring.toModule) J :=
        IsPrincipalIdealRing.principal J
      let gbar : Polynomial K :=
        @Submodule.IsPrincipal.generator (Polynomial K) (Polynomial K) _ _ (Semiring.toModule) J
          hJprincipal
      have hJspan : Ideal.span ({gbar} : Set (Polynomial K)) = J := by
        simpa [gbar] using
          (@Submodule.IsPrincipal.span_singleton_generator (Polynomial K) (Polynomial K) _ _
            (Semiring.toModule) J hJprincipal)
      obtain ⟨g, hg⟩ := Ideal.Quotient.mk_surjective (qequiv gbar)
      have hquot :
          Ideal.map (Ideal.Quotient.mk I) M =
            Ideal.span ({Ideal.Quotient.mk I g} : Set (Polynomial A ⧸ I)) := by
        -- The quotient ideal is principal over the field `A ⧸ p`; transport that generator back
        -- across the polynomial-quotient equivalence and the quotient map `Polynomial A → A[X]/I`.
        have hJmap : Ideal.map qequiv.toRingHom J = Iquot := by
          change Ideal.map qequiv.toRingHom (Ideal.map qequiv.symm.toRingHom Iquot) = Iquot
          rw [Ideal.map_map]
          simp
        calc
          Ideal.map (Ideal.Quotient.mk I) M = Ideal.map qequiv.toRingHom J := by
            simpa [Iquot] using hJmap.symm
          _ = Ideal.map qequiv.toRingHom (Ideal.span ({gbar} : Set (Polynomial K))) := by
            rw [hJspan.symm]
          _ = Ideal.span ({qequiv gbar} : Set (Polynomial A ⧸ I)) := by
            rw [Ideal.map_span, Set.image_singleton]
            rfl
          _ = Ideal.span ({Ideal.Quotient.mk I g} : Set (Polynomial A ⧸ I)) := by
            rw [hg]
      have hM_eq : M = I ⊔ Ideal.span ({g} : Set (Polynomial A)) :=
        polynomial_ideal_eq_sup_span_of_quotient_generator (I := I) (J := M) hI_le_M hquot
      have hI_eq :
          I = Ideal.span (Set.range fun i : Fin n ↦ Polynomial.C (y i)) := by
        -- The induction generators of `p` stay generators after applying `C`.
        calc
          I = Ideal.map Polynomial.C p := rfl
          _ = Ideal.map Polynomial.C (Ideal.span (Set.range y)) := by rw [hy]
          _ = Ideal.span (Polynomial.C '' Set.range y) := by rw [Ideal.map_span]
          _ = Ideal.span (Set.range fun i : Fin n ↦ Polynomial.C (y i)) := by
            congr 1
            ext f
            constructor
            · rintro ⟨z, ⟨i, rfl⟩, rfl⟩
              exact ⟨i, rfl⟩
            · rintro ⟨i, rfl⟩
              exact ⟨y i, ⟨i, rfl⟩, rfl⟩
      let z : Fin (n + 1) → Polynomial A := Fin.snoc (fun i : Fin n ↦ Polynomial.C (y i)) g
      have hz :
          Ideal.span (Set.range z) = M := by
        -- Appending the lifted polynomial generator to the contracted generators recovers `M`.
        calc
          Ideal.span (Set.range z) =
              Ideal.span (insert g (Set.range fun i : Fin n ↦ Polynomial.C (y i))) := by
                simp [z, Fin.range_snoc]
          _ = Ideal.span ({g} : Set (Polynomial A)) ⊔
              Ideal.span (Set.range fun i : Fin n ↦ Polynomial.C (y i)) := by
                rw [Ideal.span_insert]
          _ = Ideal.span ({g} : Set (Polynomial A)) ⊔ I := by rw [hI_eq.symm]
          _ = M := by rw [sup_comm, hM_eq]
      let x : Fin (n + 1) → MvPolynomial (Fin (n + 1)) k := fun i ↦ e.symm (z i)
      refine ⟨x, ?_⟩
      have hmap_x :
          Ideal.map e.toRingHom (Ideal.span (Set.range x)) = M := by
        -- Transport the generating family back across `MvPolynomial.finSuccEquiv`.
        calc
          Ideal.map e.toRingHom (Ideal.span (Set.range x)) =
              Ideal.span (e.toRingHom '' Set.range x) := by
                rw [Ideal.map_span]
          _ = Ideal.span (Set.range z) := by
            have himage : e.toRingHom '' Set.range x = Set.range z := by
              ext f
              constructor
              · rintro ⟨u, ⟨i, rfl⟩, rfl⟩
                exact ⟨i, by simp [x, z]⟩
              · rintro ⟨i, rfl⟩
                exact ⟨x i, ⟨i, rfl⟩, by simp [x, z]⟩
            exact congrArg (fun s : Set (Polynomial A) ↦ Ideal.span s) himage
          _ = M := hz
      have hcomap_x := congrArg (Ideal.comap e.toRingHom) hmap_x
      have hcomap_bot :
          Ideal.comap e.toRingHom (⊥ : Ideal (Polynomial A)) =
            (⊥ : Ideal (MvPolynomial (Fin (n + 1)) k)) :=
        Ideal.comap_bot_of_injective (f := e.toRingHom) e.injective
      have hcomap_coe_bot :
          Ideal.comap (↑e : MvPolynomial (Fin (n + 1)) k →+* Polynomial A)
            (⊥ : Ideal (Polynomial A)) =
            (⊥ : Ideal (MvPolynomial (Fin (n + 1)) k)) :=
        Ideal.comap_bot_of_injective
          (f := (↑e : MvPolynomial (Fin (n + 1)) k →+* Polynomial A)) e.injective
      -- Since `e` is an equivalence, pulling the equality back removes no extra kernel.
      rw [Ideal.comap_map_of_surjective e.toRingHom e.surjective,
        Ideal.comap_map_of_surjective e.toRingHom e.surjective] at hcomap_x
      simpa [hcomap_coe_bot] using hcomap_x

-- Proof sketch: build a strict chain of prime ideals of length `n`, giving the lower bound. For the upper
-- bound, combine `MvPolynomial.ringKrullDim_of_isNoetherianRing` with
-- `ringKrullDim_eq_zero_of_field` and identify the localized dimension with the height of `m.asIdeal`
-- via `IsLocalization.AtPrime.ringKrullDim_eq_height`.
/-- Lemma 10.114.1 (2): the localization of `k[x_1, \ldots, x_n]` at a maximal ideal has Krull
dimension `n`. -/
theorem ringKrullDim_localizationAtMaximal_mvPolynomial :
    ringKrullDim (Localization.AtPrime m.asIdeal) = n := by
  induction n with
  | zero =>
      -- In zero variables the upper bound already forces the local dimension to vanish.
      apply le_antisymm
      · simpa using ringKrullDim_localizationAtMaximal_mvPolynomial_le (m := m)
      · simpa using ringKrullDim_nonneg_of_nontrivial (R := Localization.AtPrime m.asIdeal)
  | succ n ih =>
      -- Route correction: instead of rebuilding the whole prime chain here, pass to the
      -- one-variable presentation `A[X]` of `k[x₁, …, xₙ₊₁]` and use the standard height
      -- formula for maximal ideals in a polynomial ring over a Jacobson base.
      let e : MvPolynomial (Fin (n + 1)) k ≃+* Polynomial (MvPolynomial (Fin n) k) :=
        (MvPolynomial.finSuccEquiv k n).toRingEquiv
      let M : Ideal (Polynomial (MvPolynomial (Fin n) k)) := Ideal.map e m.asIdeal
      let p : Ideal (MvPolynomial (Fin n) k) := Ideal.comap Polynomial.C M
      let mp : MaximalSpectrum (MvPolynomial (Fin n) k) := ⟨p, by
        simpa [p, M] using
          (Polynomial.isMaximal_comap_C_of_isJacobsonRing (P := M))⟩
      have hp_height : ((p.height : ℕ∞) : WithBot ℕ∞) = n := by
        -- The contracted maximal ideal on the `n`-variable subring has local dimension `n`
        -- by the induction hypothesis, hence height `n`.
        exact (IsLocalization.AtPrime.ringKrullDim_eq_height p
          (Localization.AtPrime p)).symm.trans <| by
            simpa [mp, p, M] using ih (m := mp)
      have hlie : M.LiesOver p := ⟨by
        change Ideal.comap (Polynomial.C : MvPolynomial (Fin n) k →+*
          Polynomial (MvPolynomial (Fin n) k)) M = p
        rfl⟩
      let _ : M.LiesOver p := hlie
      have hM_height : ((M.height : ℕ∞) : WithBot ℕ∞) = n + 1 := by
        -- The maximal ideal in `A[X]` has height one more than its contraction to `A`.
        calc
          ((M.height : ℕ∞) : WithBot ℕ∞) = p.height + 1 := by
            simpa using congrArg (fun x : ℕ∞ ↦ (x : WithBot ℕ∞))
              (Polynomial.height_eq_height_add_one (p := p) (P := M))
          _ = n + 1 := by
            simpa [hp_height]
      have hm_height : ((m.asIdeal.height : ℕ∞) : WithBot ℕ∞) = n + 1 := by
        -- Transport the height computation back across the polynomial equivalence.
        calc
          ((m.asIdeal.height : ℕ∞) : WithBot ℕ∞) = M.height := by
            symm
            simpa [M] using congrArg (fun x : ℕ∞ ↦ (x : WithBot ℕ∞)) (e.height_map m.asIdeal)
          _ = n + 1 := hM_height
      -- For a maximal localization, Krull dimension is exactly the height of the maximal ideal.
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height m.asIdeal
        (Localization.AtPrime m.asIdeal)]
      exact hm_height

-- Proof sketch: localize the `n` generators of `m.asIdeal` from
-- `exists_fin_generators_maximalIdeal_mvPolynomial`, identify their span with the maximal ideal of
-- `Localization.AtPrime m.asIdeal` via `Localization.AtPrime.map_eq_maximalIdeal`, and combine the
-- resulting generator bound with `ringKrullDim_localizationAtMaximal_mvPolynomial` and the
-- characterization `isRegularLocalRing_iff`.
/-- Lemma 10.114.1 (3): for a maximal ideal `m` of `k[x_1, \ldots, x_n]`, the local ring
`k[x_1, \ldots, x_n]_m`, formalized as `Localization.AtPrime m.asIdeal`, is a regular local ring. -/
theorem isRegularLocalRing_localizationAtMaximal_mvPolynomial :
    IsRegularLocalRing (Localization.AtPrime m.asIdeal) := by
  obtain ⟨x, hx⟩ := exists_fin_generators_maximalIdeal_mvPolynomial (m := m)
  -- Route correction: once theorem `(1)` supplies `n` generators, regularity is the standard
  -- spanFinrank bound plus the dimension identity from theorem `(2)`.
  have hspan :
      (IsLocalRing.maximalIdeal (Localization.AtPrime m.asIdeal)).spanFinrank ≤ n :=
    localized_maximalIdeal_spanFinrank_le_card (m := m) hx
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
    (R := Localization.AtPrime m.asIdeal) ?_
  -- Rewrite the target dimension by theorem `(2)` and conclude from the generator bound.
  simpa [ringKrullDim_localizationAtMaximal_mvPolynomial (m := m)] using hspan

end

/-! ### Proposition_10_114_2 (from Chap10) -/
universe u

section

variable {k : Type u} [Field k]
variable {n : ℕ}

local notation "A" => MvPolynomial (Fin n) k

/-
Domain-style sampling:
* primary domain: regularity and global dimension of polynomial rings over a field, expressed via
  maximal-local regularity data;
* sampled owner declarations:
  `IsRegularRing`,
  `IsFiniteGlobalDimensionRing`,
  `globalDimension`,
  `finiteGlobalDimension_regularRing_localizations_tfae`;
* best owner abstraction: Proposition `10.114.2` is a `source-facing` specialization of the
  canonical owner theorem `finiteGlobalDimension_regularRing_localizations_tfae`, with the
  maximal-local input supplied by Lemma `10.114.1`;
* primitive data vs. derived API: the primitive input is the family of maximal-local statements
  `IsRegularLocalRing (Localization.AtPrime m.asIdeal)` and
  `ringKrullDim (Localization.AtPrime m.asIdeal) = n`; the regular-ring instance, finite-global-
  dimension instance, and the equality `globalDimension A = n` are derived API owned by the
  chapter declarations above;
* source/core/bridge triage:
  `source-facing`: the three declarations in this file;
  `core/canonical`: `IsRegularRing A`, `IsFiniteGlobalDimensionRing A`, `globalDimension A`;
  `bridge/view`: the maximal-local clause in `finiteGlobalDimension_regularRing_localizations_tfae`.

This file should therefore reuse the owner theorem from `10.110.8` directly instead of keeping a
parallel local regularity/global-dimension proof interface.
-/

private theorem mvPolynomial_finiteGlobalDimension_regularRing_localizations_tfae :
    List.TFAE
      [ ∃ _ : IsFiniteGlobalDimensionRing A, globalDimension A = n
      , IsRegularRing A ∧ ringKrullDim A = n
      , (∀ m : MaximalSpectrum A,
            IsRegularLocalRing (Localization.AtPrime m.asIdeal) ∧
              ringKrullDim (Localization.AtPrime m.asIdeal) ≤ n) ∧
          ∃ m : MaximalSpectrum A, ringKrullDim (Localization.AtPrime m.asIdeal) = n
      , (∀ p : PrimeSpectrum A,
            IsRegularLocalRing (Localization.AtPrime p.asIdeal) ∧
              ringKrullDim (Localization.AtPrime p.asIdeal) ≤ n) ∧
          ∃ p : PrimeSpectrum A, ringKrullDim (Localization.AtPrime p.asIdeal) = n ] :=
  by
    exact
      (@finiteGlobalDimension_regularRing_localizations_tfae A inferInstance inferInstance n :
        List.TFAE
          [ ∃ _ : IsFiniteGlobalDimensionRing A, globalDimension A = n
          , IsRegularRing A ∧ ringKrullDim A = n
          , (∀ m : MaximalSpectrum A,
                IsRegularLocalRing (Localization.AtPrime m.asIdeal) ∧
                  ringKrullDim (Localization.AtPrime m.asIdeal) ≤ n) ∧
              ∃ m : MaximalSpectrum A, ringKrullDim (Localization.AtPrime m.asIdeal) = n
          , (∀ p : PrimeSpectrum A,
                IsRegularLocalRing (Localization.AtPrime p.asIdeal) ∧
                  ringKrullDim (Localization.AtPrime p.asIdeal) ≤ n) ∧
              ∃ p : PrimeSpectrum A, ringKrullDim (Localization.AtPrime p.asIdeal) = n ])

