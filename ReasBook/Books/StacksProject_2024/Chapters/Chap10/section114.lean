theorem topologicalKrullDimAt_eq_iInf_ringKrullDim_localizationAtMaximal_over
    (x : PrimeSpectrum S) :
    topologicalKrullDimAt x =
      ⨅ m : { m : MaximalSpectrum S // x.asIdeal ≤ m.asIdeal },
        ringKrullDim (Localization.AtPrime m.1.asIdeal) := sorry

end

