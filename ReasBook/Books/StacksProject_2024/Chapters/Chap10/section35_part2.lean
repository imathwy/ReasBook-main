import Mathlib
import Mathlib.Data.Finsupp.Encodable
import Mathlib.RingTheory.Extension.Generators
import Mathlib.RingTheory.Jacobson.Ring
import Mathlib.RingTheory.Spectrum.Prime.Jacobson
import Mathlib.Tactic.Recall

-- Declarations for this item will be appended below by the statement pipeline.


/-! ### Example_10_35_13 (from Chap10) -/
open MvPolynomial

universe u

noncomputable section

section

variable (k : Type u) [Field k]

/- Domain triage:
* primary domain: commutative-algebra counterexamples built from quotient polynomial rings and
  their maximal-ideal residue fields;
* source-facing: the relations `f(x) x_f - 1`, the ideal they generate, the quotient ring, and the
  existence of a maximal ideal with residue field `k(x)`;
* core/canonical owners: `Ideal.span`, quotient-algebra instances, `MaximalSpectrum`,
  `IsFractionRing`, and `FractionRing.algEquiv`;
* bridge/view: the quotient inherits its `Polynomial k`-algebra structure from the ambient
  `MvPolynomial` ring, so there is no separate quotient-specific owner API here.
-/

local notation "NonzeroPoly" => {f : Polynomial k // f ≠ 0}
local notation "Vars" => Option NonzeroPoly
local notation "Rcount" => MvPolynomial Vars k
local notation "xVar" => (X (none : Vars) : Rcount)

/-- The defining relations `f(x) x_f - 1` in the countable-field counterexample to the
Jacobson-ring argument. -/
def countableFieldCounterexampleRelations : Set Rcount :=
  Set.range fun f : NonzeroPoly ↦
    ((Polynomial.aeval xVar f.1 : Rcount) * X (some f) - 1 : Rcount)

/-- The ideal generated by the relations `f(x) x_f - 1` in the polynomial ring
`k[x, {x_f}_{f ≠ 0}]`. -/
def countableFieldCounterexampleIdeal : Ideal Rcount :=
  Ideal.span (countableFieldCounterexampleRelations k)

/-- The quotient ring `k[x, {x_f}_{f ≠ 0}] / (f(x) x_f - 1)` from Example 10.35.13. -/
abbrev countableFieldCounterexampleRing : Type u :=
  Rcount ⧸ countableFieldCounterexampleIdeal k

local notation "Scount" => countableFieldCounterexampleRing k

private noncomputable instance : Algebra (Polynomial k) Rcount :=
  (Polynomial.aeval xVar).toRingHom.toAlgebra

/-- Helper for Example 10.35.13: the residue field at the bottom ideal of a field is the field
itself, so algebraicity of that residue field transports back to the field. -/
private theorem isAlgebraic_of_bot_residueField
    {L : Type u} [Field L] [Algebra k L]
    [Algebra.IsAlgebraic k ((⊥ : Ideal L).ResidueField)] :
    Algebra.IsAlgebraic k L := by
  let eQuot :
      (L ⧸ (⊥ : Ideal L)) ≃ₐ[L] ((⊥ : Ideal L).ResidueField) :=
    AlgEquiv.ofBijective
      (IsScalarTower.toAlgHom L (L ⧸ (⊥ : Ideal L)) ((⊥ : Ideal L).ResidueField))
      (Ideal.bijective_algebraMap_quotient_residueField (⊥ : Ideal L))
  let e :
      ((⊥ : Ideal L).ResidueField) ≃ₐ[k] L :=
    (eQuot.symm.trans (AlgEquiv.quotientBot L L)).restrictScalars k
  -- Replace the bottom residue field with the field itself via the canonical quotient equivalence.
  exact e.isAlgebraic

/-- Helper for Example 10.35.13: a polynomial ring over a countable field is countable. -/
private theorem countable_polynomial_over_countable_field [Countable k] :
    Countable (Polynomial k) := by
  -- Encode polynomials by finitely supported coefficient functions.
  letI : Countable (AddMonoidAlgebra k ℕ) := by
    change Countable (ℕ →₀ k)
    infer_instance
  exact Function.Injective.countable (f := (Polynomial.toFinsupp : Polynomial k → AddMonoidAlgebra k ℕ))
    Polynomial.toFinsupp_injective

/-- The defining relations are indexed by the nonzero polynomials of `k[x]`, so they form a
countable set when `k` is countable. -/

-- Proof sketch: `Polynomial k` is countable when `k` is countable, hence the subtype of nonzero
-- polynomials is countable; the image of a countable set under the indexing map is countable.
theorem countableFieldCounterexampleRelations_countable [Countable k] :
    (countableFieldCounterexampleRelations k).Countable := by
  letI : Countable (Polynomial k) := countable_polynomial_over_countable_field (k := k)
  letI : Countable NonzeroPoly :=
    Function.Injective.countable (fun _ _ h ↦ Subtype.ext h)
  -- The relations are a range indexed by the countable subtype of nonzero polynomials.
  simpa [countableFieldCounterexampleRelations] using
    (Set.countable_range fun f : NonzeroPoly ↦
      ((Polynomial.aeval xVar f.1 : Rcount) * X (some f) - 1 : Rcount))

local notation "Rnorm" => MvPolynomial NonzeroPoly (Polynomial k)

/-- Helper for Example 10.35.13: the normalized presentation over `Polynomial k` uses the relations
`C f * X f - 1` indexed by nonzero polynomials. -/
private def countableFieldCounterexampleNormalizedIdeal : Ideal Rnorm :=
  Ideal.span
    (Set.range fun f : NonzeroPoly ↦ ((C f.1 : Rnorm) * X f - 1 : Rnorm))

local notation "Inorm" => countableFieldCounterexampleNormalizedIdeal k
local notation "Snorm" => Rnorm ⧸ countableFieldCounterexampleNormalizedIdeal k

/-- Helper for Example 10.35.13: normalizing the distinguished variable turns `f(x)` into the
coefficient polynomial `C f`. -/
private theorem optionEquivRight_aeval_xVar (f : Polynomial k) :
    MvPolynomial.optionEquivRight k NonzeroPoly (Polynomial.aeval xVar f : Rcount) =
      (C f : Rnorm) := by
  -- Route correction: compare `aeval` through the algebra equivalence instead of unfolding
  -- `Polynomial.aeval` under `optionEquivRight`.
  calc
    MvPolynomial.optionEquivRight k NonzeroPoly (Polynomial.aeval xVar f : Rcount) =
        Polynomial.aeval (MvPolynomial.optionEquivRight k NonzeroPoly xVar) f := by
          symm
          exact congrArg
            (fun φ : Polynomial k →ₐ[k] Rnorm => φ f)
            (Polynomial.aeval_algEquiv (MvPolynomial.optionEquivRight k NonzeroPoly) xVar)
    _ = Polynomial.aeval (C Polynomial.X : Rnorm) f := by
          rw [MvPolynomial.optionEquivRight_X_none (R := k) (S₁ := NonzeroPoly)]
    _ = Polynomial.aeval
          ((IsScalarTower.toAlgHom k (Polynomial k) Rnorm) Polynomial.X) f := by
          rfl
    _ = algebraMap (Polynomial k) Rnorm (Polynomial.aeval Polynomial.X f) := by
          exact Polynomial.aeval_algHom_apply
            (IsScalarTower.toAlgHom k (Polynomial k) Rnorm) Polynomial.X f
    _ = (C f : Rnorm) := by
          simp

/-- Helper for Example 10.35.13: under `MvPolynomial.optionEquivRight`, the original relation ideal
becomes the normalized ideal generated by `C f * X f - 1`. -/
-- The `none` variable turns into the coefficient-ring variable `Polynomial.X`, while the `some f`
-- variables stay as genuine `MvPolynomial` variables.
theorem countableFieldCounterexampleIdeal_map_optionEquivRight :
    (countableFieldCounterexampleIdeal k).map
        (MvPolynomial.optionEquivRight k NonzeroPoly).toRingHom = Inorm := by
  -- Route correction: map the source span first, then identify the image generator family
  -- term-by-term under `optionEquivRight`.
  rw [countableFieldCounterexampleIdeal, countableFieldCounterexampleNormalizedIdeal,
    Ideal.map_span]
  congr 1
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    rcases hx with ⟨f, rfl⟩
    refine ⟨f, ?_⟩
    have hpoly :
        (MvPolynomial.optionEquivRight k NonzeroPoly).toRingHom
            (Polynomial.aeval xVar f.1 : Rcount) = (C f.1 : Rnorm) := by
      simpa using optionEquivRight_aeval_xVar (k := k) f.1
    have hvar :
        (MvPolynomial.optionEquivRight k NonzeroPoly).toRingHom
            (X (some f) : Rcount) = (X f : Rnorm) := by
      simpa using
        (MvPolynomial.optionEquivRight_X_some (R := k) (S₁ := NonzeroPoly) f)
    -- Rewrite the mapped generator into the normalized generator for the same index.
    symm
    simpa [map_sub, map_mul, hpoly, hvar]
  · rintro ⟨f, rfl⟩
    refine ⟨((Polynomial.aeval xVar f.1 : Rcount) * X (some f) - 1 : Rcount), ?_, ?_⟩
    · exact ⟨f, rfl⟩
    have hpoly :
        (MvPolynomial.optionEquivRight k NonzeroPoly).toRingHom
            (Polynomial.aeval xVar f.1 : Rcount) = (C f.1 : Rnorm) := by
      simpa using optionEquivRight_aeval_xVar (k := k) f.1
    have hvar :
        (MvPolynomial.optionEquivRight k NonzeroPoly).toRingHom
            (X (some f) : Rcount) = (X f : Rnorm) := by
      simpa using
        (MvPolynomial.optionEquivRight_X_some (R := k) (S₁ := NonzeroPoly) f)
    · -- The chosen original generator maps to the normalized generator with the same index.
      simpa [map_sub, map_mul, hpoly, hvar]

/-- Helper for Example 10.35.13: the normalized quotient maps to `k(x)` by sending each auxiliary
variable `X f` to the inverse of `f`. -/
-- Each defining relation is sent to zero because it becomes `f * f⁻¹ - 1`.
private noncomputable def countableFieldCounterexampleNormalizedQuotientToRatFunc :
    Snorm →ₐ[Polynomial k] RatFunc k :=
  Ideal.Quotient.liftₐ Inorm
    (aeval fun f : NonzeroPoly ↦
      ((algebraMap (Polynomial k) (RatFunc k) f.1)⁻¹ : RatFunc k)) <| by
    intro p hp
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hp
    · rintro p ⟨f, rfl⟩
      -- Each generator becomes `f * f⁻¹ - 1`.
      have hf : algebraMap (Polynomial k) (RatFunc k) f.1 ≠ 0 := by
        intro h
        have h' :
            algebraMap (Polynomial k) (RatFunc k) f.1 =
              algebraMap (Polynomial k) (RatFunc k) 0 := by
          simpa using h
        exact f.2 ((IsFractionRing.injective (Polynomial k) (RatFunc k)) h')
      simp [hf]
    · simp
    · intro p q _ _ hp hq
      simp [hp, hq]
    · intro a x _ hx
      simp [hx]

/-- Helper for Example 10.35.13: the normalized relation ideal is proper because its quotient
already maps to the nontrivial field `k(x)`. -/
-- If the quotient were trivial, its `0 = 1` identity would transport along the quotient map to
-- the impossible equality `0 = 1` in `RatFunc k`.
private theorem countableFieldCounterexampleNormalizedIdeal_ne_top :
    (Inorm : Ideal Rnorm) ≠ ⊤ := by
  let φ := countableFieldCounterexampleNormalizedQuotientToRatFunc (k := k)
  have hnontrivial : Nontrivial Snorm := by
    refine ⟨⟨0, 1, ?_⟩⟩
    intro h01
    have : (0 : RatFunc k) = 1 := by
      simpa using congrArg φ h01
    exact zero_ne_one this
  exact Ideal.Quotient.nontrivial_iff.mp hnontrivial

/-- The relation ideal in the countable-field example is proper. -/
-- Proof sketch: compose the inclusion `k[x] ↪ k(x)` with the map sending each variable `x_f` to
-- the inverse of `f(x)` in `RatFunc k`; every generator `f(x) x_f - 1` maps to zero, so the ideal
-- lies in the kernel of a homomorphism to the nontrivial ring `RatFunc k`.
private theorem countableFieldCounterexampleIdeal_ne_top :
    countableFieldCounterexampleIdeal k ≠ ⊤ := by
  -- The normalized presentation is proper, and `optionEquivRight` preserves that property.
  intro htop
  have hmap : (Inorm : Ideal Rnorm) = ⊤ := by
    rw [← countableFieldCounterexampleIdeal_map_optionEquivRight (k := k), htop, Ideal.map_top]
  exact countableFieldCounterexampleNormalizedIdeal_ne_top (k := k) hmap

/-- Helper for Example 10.35.13: in the normalized quotient, each adjoined variable is an inverse
to the corresponding nonzero polynomial. -/
-- This is the quotient-level form of the defining relation `f X_f - 1 = 0`.
private theorem countableFieldCounterexampleNormalizedGenerator_mul_eq_one
    (f : NonzeroPoly) :
    algebraMap (Polynomial k) Snorm f.1 * Ideal.Quotient.mk Inorm (X f : Rnorm) = 1 := by
  -- Push the chosen generator of the ideal into the quotient and simplify.
  have hrel :
      Ideal.Quotient.mk Inorm (((C f.1 : Rnorm) * X f - 1 : Rnorm)) = 0 := by
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨f, rfl⟩)
  exact sub_eq_zero.mp <| by
    simpa using hrel

/-- Helper for Example 10.35.13: every nonzero polynomial becomes a unit in the normalized
quotient. -/
-- The quotient explicitly adjoins an inverse for each nonzero polynomial.
private theorem countableFieldCounterexampleNormalized_polynomial_isUnit
    (f : Polynomial k) (hf : f ≠ 0) :
    IsUnit (algebraMap (Polynomial k) Snorm f) := by
  let f' : NonzeroPoly := ⟨f, hf⟩
  -- Use the corresponding generator as the inverse witness.
  rw [isUnit_iff_exists_inv]
  refine ⟨Ideal.Quotient.mk Inorm (X f' : Rnorm), ?_⟩
  simpa [f'] using countableFieldCounterexampleNormalizedGenerator_mul_eq_one (k := k) f'

/-- Helper for Example 10.35.13: the `Polynomial k`-algebra map into the normalized quotient is
injective. -/
-- A nonzero polynomial maps to a unit, hence cannot map to zero in the nontrivial quotient.
private theorem countableFieldCounterexampleNormalized_algebraMap_injective :
    Function.Injective (algebraMap (Polynomial k) Snorm) := by
  let _ : Nontrivial Snorm :=
    Ideal.Quotient.nontrivial_iff.mpr
      (countableFieldCounterexampleNormalizedIdeal_ne_top (k := k))
  intro p q hpq
  by_contra hpq'
  have hunit :
      IsUnit (algebraMap (Polynomial k) Snorm (p - q)) :=
    countableFieldCounterexampleNormalized_polynomial_isUnit (k := k) (p - q)
      (sub_ne_zero.mpr hpq')
  have hzero : algebraMap (Polynomial k) Snorm (p - q) = 0 := by
    simpa [map_sub, hpq]
  exact hunit.ne_zero hzero

/-- Helper for Example 10.35.13: the universal property of the fraction field gives a map from
`k(x)` back to the normalized quotient. -/
-- Injectivity of the polynomial map is the only input needed for `IsFractionRing.liftAlgHom`.
private noncomputable def countableFieldCounterexampleNormalizedQuotientFromRatFunc :
    RatFunc k →ₐ[Polynomial k] Snorm :=
  IsLocalization.liftAlgHom
    (A := Polynomial k) (R := Polynomial k) (M := nonZeroDivisors (Polynomial k))
    (S := RatFunc k) (P := Snorm) (f := Algebra.ofId (Polynomial k) Snorm)
    (fun y ↦
      countableFieldCounterexampleNormalized_polynomial_isUnit (k := k) y.1
        (mem_nonZeroDivisors_iff_ne_zero.mp y.2))

/-- Helper for Example 10.35.13: the fraction-field lift is a right inverse to the quotient map
to `RatFunc k`. -/
private theorem countableFieldCounterexampleNormalized_to_comp_from :
    (countableFieldCounterexampleNormalizedQuotientToRatFunc (k := k)).comp
        (countableFieldCounterexampleNormalizedQuotientFromRatFunc (k := k)) =
      AlgHom.id (Polynomial k) (RatFunc k) := by
  -- The fraction field is generated by `Polynomial k`, so it is enough to compare the two maps
  -- on the canonical localization algebra map.
  apply IsLocalization.algHom_ext (W := nonZeroDivisors (Polynomial k))
  ext

/-- Helper for Example 10.35.13: the fraction-field lift also inverts the normalized quotient map
on the quotient generators. -/
private theorem countableFieldCounterexampleNormalized_from_comp_to :
    (countableFieldCounterexampleNormalizedQuotientFromRatFunc (k := k)).comp
        (countableFieldCounterexampleNormalizedQuotientToRatFunc (k := k)) =
      AlgHom.id (Polynomial k) Snorm := by
  -- The quotient is generated by the `X f`, so it is enough to show that the composite fixes
  -- each generator by canceling the corresponding polynomial factor.
  refine Ideal.Quotient.algHom_ext (Polynomial k) ?_
  refine MvPolynomial.algHom_ext fun f ↦ ?_
  change
    ((countableFieldCounterexampleNormalizedQuotientFromRatFunc (k := k)).comp
        (countableFieldCounterexampleNormalizedQuotientToRatFunc (k := k)))
      (Ideal.Quotient.mk Inorm (X f : Rnorm)) =
      Ideal.Quotient.mk Inorm (X f : Rnorm)
  let x : Snorm := Ideal.Quotient.mk Inorm (X f : Rnorm)
  have hf_rat : algebraMap (Polynomial k) (RatFunc k) f.1 ≠ 0 := by
    intro h
    exact f.2 ((IsFractionRing.injective (Polynomial k) (RatFunc k)) (by simpa using h))
  have hcomp_mul :
      algebraMap (Polynomial k) Snorm f.1 *
          ((countableFieldCounterexampleNormalizedQuotientFromRatFunc (k := k)).comp
            (countableFieldCounterexampleNormalizedQuotientToRatFunc (k := k))) x = 1 := by
    have hrat :
        algebraMap (Polynomial k) (RatFunc k) f.1 *
            countableFieldCounterexampleNormalizedQuotientToRatFunc (k := k) x = 1 := by
      simp [x, countableFieldCounterexampleNormalizedQuotientToRatFunc, hf_rat]
    -- Apply the localization lift to the relation already true in `RatFunc k`.
    simpa [AlgHom.comp_apply, x, countableFieldCounterexampleNormalizedQuotientFromRatFunc,
      map_mul] using
      congrArg (countableFieldCounterexampleNormalizedQuotientFromRatFunc (k := k)) hrat
  have hgen_mul :
      algebraMap (Polynomial k) Snorm f.1 * x = 1 :=
    countableFieldCounterexampleNormalizedGenerator_mul_eq_one (k := k) f
  have hunit : IsUnit (algebraMap (Polynomial k) Snorm f.1) :=
    countableFieldCounterexampleNormalized_polynomial_isUnit (k := k) f.1 f.2
  exact IsUnit.mul_left_cancel hunit (hcomp_mul.trans hgen_mul.symm)

/-- Helper for Example 10.35.13: the normalized quotient is `k(x)` as a `Polynomial k`-algebra. -/
-- The forward map is determined by the auxiliary inverses, and the inverse is the fraction-field
-- lift back into the quotient.
private noncomputable def countableFieldCounterexampleNormalizedRing_algEquiv_ratFunc :
    Snorm ≃ₐ[Polynomial k] RatFunc k := by
  -- The two algebra maps were constructed as inverse by localization uniqueness on one side and
  -- by the quotient relations on the other.
  exact AlgEquiv.ofAlgHom
    (countableFieldCounterexampleNormalizedQuotientToRatFunc (k := k))
    (countableFieldCounterexampleNormalizedQuotientFromRatFunc (k := k))
    (countableFieldCounterexampleNormalized_to_comp_from (k := k))
    (countableFieldCounterexampleNormalized_from_comp_to (k := k))

/-- Helper for Example 10.35.13: the original quotient ring is `k(x)` as a `k`-algebra. -/
-- We first normalize the presentation with `optionEquivRight`, then apply the quotient-to-field
-- algebra equivalence proved above.
private noncomputable def countableFieldCounterexampleRing_algEquiv_ratFunc :
    Scount ≃ₐ[k] RatFunc k := by
  -- Transport the normalized quotient presentation back across `optionEquivRight`, then compose
  -- with the normalized quotient equivalence to `RatFunc k`.
  let eQuot :
      Scount ≃ₐ[k] Snorm :=
    Ideal.quotientEquivAlg (countableFieldCounterexampleIdeal k) Inorm
      (MvPolynomial.optionEquivRight k NonzeroPoly)
      (countableFieldCounterexampleIdeal_map_optionEquivRight (k := k)).symm
  exact eQuot.trans
    ((countableFieldCounterexampleNormalizedRing_algEquiv_ratFunc (k := k)).restrictScalars k)

/-- Example 10.35.13: for a countable field `k`, the defining relations `f(x) x_f - 1` form a
countable set in `k[x, {x_f}_{f ∈ k[x] - {0}}]`, and the quotient ring by the ideal they generate
has a maximal ideal whose residue field is `k`-isomorphic to `k(x)`, hence not algebraic over
`k`. -/
-- Proof sketch: the relation ideal is proper, so the quotient ring is nontrivial and therefore
-- has a maximal ideal `m`. The private fraction-field instance above puts the owner object
-- `m.asIdeal.ResidueField` in the canonical `IsFractionRing (Polynomial k)` interface, so
-- `FractionRing.algEquiv` gives the required `k`-algebra isomorphism with `RatFunc k`; the final
-- conclusion follows from
-- `not_isAlgebraic_bot_residueField_countableFieldCounterexample`.
theorem exists_maximal_ideal_with_ratFunc_residueField_over_countable_field [Countable k] :
    (countableFieldCounterexampleRelations k).Countable ∧
      ∃ m : MaximalSpectrum Scount,
        ∃ _ : RatFunc k ≃ₐ[k] m.asIdeal.ResidueField,
          ¬ Algebra.IsAlgebraic k m.asIdeal.ResidueField := by
  refine ⟨countableFieldCounterexampleRelations_countable (k := k), ?_⟩
  let eField : Scount ≃ₐ[k] RatFunc k := countableFieldCounterexampleRing_algEquiv_ratFunc (k := k)
  let hField : IsField Scount :=
    eField.toRingEquiv.isField (Field.toIsField (RatFunc k))
  letI : Field Scount := hField.toField
  let hmax : (⊥ : Ideal Scount).IsMaximal := Ideal.bot_isMaximal
  let m : MaximalSpectrum Scount := ⟨⊥, hmax⟩
  let eQuot :
      (Scount ⧸ (⊥ : Ideal Scount)) ≃ₐ[k] ((⊥ : Ideal Scount).ResidueField) :=
    AlgEquiv.ofBijective
      (IsScalarTower.toAlgHom k (Scount ⧸ (⊥ : Ideal Scount))
        ((⊥ : Ideal Scount).ResidueField))
      (Ideal.bijective_algebraMap_quotient_residueField (⊥ : Ideal Scount))
  let eResidue : ((⊥ : Ideal Scount).ResidueField) ≃ₐ[k] Scount :=
    eQuot.symm.trans (AlgEquiv.quotientBot k Scount)
  refine ⟨m, ?_⟩
  refine ⟨eField.symm.trans ?_, ?_⟩
  · simpa [m] using eResidue.symm
  · intro halg
    have hbot_alg : Algebra.IsAlgebraic k ((⊥ : Ideal Scount).ResidueField) := by
      simpa [m] using halg
    let _ : Algebra.IsAlgebraic k ((⊥ : Ideal Scount).ResidueField) := hbot_alg
    have hScount_alg : Algebra.IsAlgebraic k Scount :=
      isAlgebraic_of_bot_residueField (k := k)
    let _ : Algebra.IsAlgebraic k Scount := hScount_alg
    have hRat_alg : Algebra.IsAlgebraic k (RatFunc k) := eField.isAlgebraic
    have hRat_not_alg : ¬ Algebra.IsAlgebraic k (RatFunc k) := by
      simpa [Algebra.transcendental_iff_not_isAlgebraic] using
        (inferInstance : Algebra.Transcendental k (RatFunc k))
    exact hRat_not_alg hRat_alg

end

/-! ### Lemma_10_35_14 (from Chap10) -/
universe u v

section

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] (f : R)

/- Domain triage:
* primary domain: Jacobson rings and maximal ideals under away-localization;
* source-facing layer: the textbook statements specialize to `Localization.Away f`;
* core/canonical owner: mathlib's away-localization API
  `isJacobsonRing_localization` and `IsLocalization.orderIsoOfMaximal`;
* primitive data vs. derived API: `f` and the ambient away-localization `S` are the only
  parameters, while the Jacobson-ring structure and maximal-ideal correspondence are recalled
  directly from the owner abstraction rather than repackaged in local wrapper declarations.
-/

/- Lemma 10.35.14 (1): if `R` is a Jacobson ring and `f ∈ R`, then the localization
`Localization.Away f` is again a Jacobson ring. Mathlib owns this at the more canonical
away-localization level `S` with `[IsLocalization.Away f S]`; the textbook statement is the
special case `S = Localization.Away f`. -/
recall isJacobsonRing_localization [Algebra R S] [IsLocalization.Away f S] [IsJacobsonRing R] :
    IsJacobsonRing S

/- Lemma 10.35.14 (2): maximal ideals of `Localization.Away f` correspond order-isomorphically to
maximal ideals of `R` that do not contain `f`. Mathlib owns this at the same canonical
away-localization level `S` with `[IsLocalization.Away f S]`; the textbook statement is the
special case `S = Localization.Away f`. -/
recall IsLocalization.orderIsoOfMaximal [Algebra R S] [IsLocalization.Away f S]
    [IsJacobsonRing R] :
    { p : Ideal S // p.IsMaximal } ≃o { p : Ideal R // p.IsMaximal ∧ f ∉ p }

end

/-! ### Example_10_35_15 (from Chap10) -/
open PrimeSpectrum IsLocalRing IsLocalization IsFractionRing

/- Domain triage:
* `source-facing`: the example identifies the localization of `ℤ_(2)` away from `2` with `ℚ`
  and describes the induced map on spectra.
* `core/canonical`: the owner abstractions are `Localization.AtPrime`, `Localization.Away`,
  `PrimeSpectrum.basicOpen`, `IsLocalization`, and `IsFractionRing`.
* `bridge/view`: identify `D(2)` in `Spec(ℤ_(2))` with the singleton generic point, so
  localizing away from `2` is the same as localizing at `(0)`, hence the fraction ring. -/

private abbrev twoIdeal : Ideal ℤ := Ideal.span ({(2 : ℤ)} : Set ℤ)

local instance : twoIdeal.IsPrime := by
  simpa [twoIdeal] using
    (Ideal.span_singleton_prime (show (2 : ℤ) ≠ 0 by norm_num)).2 Int.prime_two

local notation "ZLocalTwo" => Localization.AtPrime twoIdeal
local notation "twoInZLocalTwo" => (algebraMap ℤ ZLocalTwo (2 : ℤ))
local notation "ZLocalTwoAwayTwo" => Localization.Away twoInZLocalTwo
local notation "ZLocalTwoFrac" => Localization.AtPrime (⊥ : Ideal ZLocalTwo)
local notation "ZFrac" => Localization.AtPrime (⊥ : Ideal ℤ)
private lemma twoInZLocalTwo_ne_zero : twoInZLocalTwo ≠ 0 := by
  exact (map_ne_zero_iff (algebraMap ℤ ZLocalTwo)
    (IsLocalization.injective ZLocalTwo twoIdeal.primeCompl_le_nonZeroDivisors)).2 (by norm_num)

private lemma primeComap_eq_bot_of_two_not_mem (p : PrimeSpectrum ZLocalTwo)
    (hp : twoInZLocalTwo ∉ p.asIdeal) :
    Ideal.comap (algebraMap ℤ ZLocalTwo) p.asIdeal = ⊥ := by
  let J : Ideal ℤ := Ideal.comap (algebraMap ℤ ZLocalTwo) p.asIdeal
  have hJprime : J.IsPrime := by
    dsimp [J]
    exact Ideal.comap_isPrime (algebraMap ℤ ZLocalTwo) p.asIdeal
  have hJle : J ≤ twoIdeal := by
    simpa [J] using
      ((IsLocalization.AtPrime.orderIsoOfPrime ZLocalTwo twoIdeal
        ⟨p.asIdeal, p.isPrime⟩).2.2)
  have h2not : (2 : ℤ) ∉ J := by
    simpa [J] using hp
  by_cases hbot : J = ⊥
  · simpa [J] using hbot
  · letI : J.IsPrime := hJprime
    letI : NeZero J := ⟨hbot⟩
    have hnormPrime : Nat.Prime (Ideal.absNorm J) := by
      simpa [Ideal.under_def] using Nat.absNorm_under_prime J
    have habsNorm_mem : (Ideal.absNorm J : ℤ) ∈ twoIdeal :=
      hJle (by simpa [Ideal.under_def] using Int.absNorm_under_mem J)
    have htwo_dvd_absNorm_int : (2 : ℤ) ∣ (Ideal.absNorm J : ℤ) := by
      simpa [twoIdeal, Ideal.mem_span_singleton] using habsNorm_mem
    have htwo_dvd_absNorm : 2 ∣ Ideal.absNorm J := by
      exact_mod_cast htwo_dvd_absNorm_int
    have hnorm_eq_two : Ideal.absNorm J = 2 := by
      exact (Nat.prime_dvd_prime_iff_eq Nat.prime_two hnormPrime).mp htwo_dvd_absNorm |>.symm
    have htwo_mem : (2 : ℤ) ∈ J :=
      (Int.cast_mem_ideal_iff : (2 : ℤ) ∈ J ↔ _).2 (by simp [Ideal.under_def, hnorm_eq_two])
    exact (h2not htwo_mem).elim

private lemma prime_eq_bot_of_two_not_mem (p : PrimeSpectrum ZLocalTwo)
    (hp : twoInZLocalTwo ∉ p.asIdeal) : p = ⊥ := by
  have hcomap : Ideal.comap (algebraMap ℤ ZLocalTwo) p.asIdeal = ⊥ :=
    primeComap_eq_bot_of_two_not_mem p hp
  let e := IsLocalization.orderIsoOfPrime twoIdeal.primeCompl ZLocalTwo
  have hEq :
      e ⟨p.asIdeal, p.isPrime⟩ = e ⟨(⊥ : Ideal ZLocalTwo), Ideal.isPrime_bot⟩ := by
    apply Subtype.ext
    simp [e, hcomap]
  exact PrimeSpectrum.ext (congrArg Subtype.val (e.injective hEq))

private lemma basicOpen_twoInZLocalTwo_eq_singleton_genericPoint :
    (PrimeSpectrum.basicOpen twoInZLocalTwo : Set (PrimeSpectrum ZLocalTwo)) = {⊥} := by
  ext p
  constructor
  · exact fun hp ↦ prime_eq_bot_of_two_not_mem p hp
  · rintro rfl
    simpa [Ideal.mem_bot] using twoInZLocalTwo_ne_zero

private instance : IsFractionRing ZLocalTwo ZLocalTwoFrac := by
  convert (inferInstance :
    IsLocalization (⊥ : Ideal ZLocalTwo).primeCompl ZLocalTwoFrac)
  ext x
  simp [Ideal.primeCompl]

private instance : IsFractionRing ℤ ZFrac := by
  convert (inferInstance :
    IsLocalization (⊥ : Ideal ℤ).primeCompl ZFrac)
  ext x
  simp [Ideal.primeCompl]

private theorem isLocalizationAwayTwoToFrac : IsLocalization.Away twoInZLocalTwo ZLocalTwoFrac := by
  exact
    (PrimeSpectrum.isLocalization_away_iff_atPrime_of_basicOpen_eq_singleton
      basicOpen_twoInZLocalTwo_eq_singleton_genericPoint).2 inferInstance

private noncomputable def awayTwoToFrac : ZLocalTwoAwayTwo ≃ₐ[ZLocalTwo] ZLocalTwoFrac := by
  letI := isLocalizationAwayTwoToFrac
  exact IsLocalization.algEquiv (Submonoid.powers twoInZLocalTwo) ZLocalTwoAwayTwo ZLocalTwoFrac

/-- Localizing `ℤ_(2)` at the image of `2` gives its fraction ring. -/
instance : IsFractionRing ZLocalTwo ZLocalTwoAwayTwo := by
  letI := isLocalizationAwayTwoToFrac
  exact IsLocalization.isLocalization_of_algEquiv (nonZeroDivisors ZLocalTwo) awayTwoToFrac.symm

/-- Example 10.35.15: localizing `R = ℤ_(2)` at the image of `2` canonically identifies
`R[1 / 2]` with `ℚ`. -/
noncomputable def zLocalTwoAwayTwoAlgEquivRat : ZLocalTwoAwayTwo ≃ₐ[ℤ] ℚ :=
  letI := isLocalizationAwayTwoToFrac
  let eFrac :
      ZLocalTwoFrac ≃ₐ[ℤ] FractionRing ℤ :=
    let hbot :
        Ideal.comap (algebraMap ℤ ZLocalTwo) (⊥ : Ideal ZLocalTwo) = (⊥ : Ideal ℤ) :=
      Ideal.comap_bot_of_injective (algebraMap ℤ ZLocalTwo)
        (IsLocalization.injective ZLocalTwo twoIdeal.primeCompl_le_nonZeroDivisors)
    let eRaw :=
      IsLocalization.localizationLocalizationAtPrimeIsoLocalization twoIdeal.primeCompl
        (⊥ : Ideal ZLocalTwo)
    let eBot :
        ZFrac ≃ₐ[ℤ] ZLocalTwoFrac := by
      change Localization (Ideal.primeCompl (⊥ : Ideal ℤ)) ≃ₐ[ℤ] ZLocalTwoFrac
      have hprimeCompl :
          (Ideal.comap (algebraMap ℤ ZLocalTwo) (⊥ : Ideal ZLocalTwo)).primeCompl =
            (⊥ : Ideal ℤ).primeCompl := by
        simp [hbot]
      exact hprimeCompl ▸ eRaw
    (FractionRing.algEquiv ℤ ZFrac).trans eBot |>.symm
  ((awayTwoToFrac.restrictScalars ℤ).trans eFrac).trans (FractionRing.algEquiv ℤ ℚ)

-- Proof sketch: This is the standard `AlgEquiv.commutes` property for the canonical
-- `ℤ`-algebra equivalence `zLocalTwoAwayTwoAlgEquivRat`.
/-- The canonical equivalence `R[1 / 2] ≃ₐ[ℤ] ℚ` is compatible with the `ℤ`-algebra structure maps. -/
theorem zLocalTwoAwayTwoAlgEquivRat_commutes (n : ℤ) :
    zLocalTwoAwayTwoAlgEquivRat (algebraMap ℤ ZLocalTwoAwayTwo n) = algebraMap ℤ ℚ n := sorry

noncomputable instance : Field ZLocalTwoAwayTwo :=
  IsFractionRing.toField ZLocalTwo

-- Proof sketch: `R[1 / 2]` is a field by the preceding fraction-ring instance, so its unique
-- point is `(0)`. Contracting `(0)` along the injective localization map `R → R[1 / 2]` gives
-- `(0)`, the generic point of `Spec(R)`.
/-- In Example 10.35.15, the unique point of `Spec(R[1 / 2])` maps to the generic point of
`Spec(R)` for `R = ℤ_(2)`. -/
theorem zLocalTwo_comap_closedPoint_eq_genericPoint :
    comap (algebraMap ZLocalTwo ZLocalTwoAwayTwo) (closedPoint ZLocalTwoAwayTwo) =
      (⊥ : PrimeSpectrum ZLocalTwo) := by
  rw [show closedPoint ZLocalTwoAwayTwo = (⊥ : PrimeSpectrum ZLocalTwoAwayTwo) by
    ext x
    simp [IsLocalRing.closedPoint]]
  ext x
  simp [Ideal.comap_bot_of_injective, IsFractionRing.injective ZLocalTwo ZLocalTwoAwayTwo]

/-! ### Example_10_35_16 (from Chap10) -/
open PrimeSpectrum IsLocalRing

/-- Example 10.35.16: under the localization map `ℤ → ℚ`, identifying `ℚ` with the localization
of `ℤ` at all nonzero integers, the closed point of `Spec(ℚ)` maps to the generic point of
`Spec(ℤ)`. -/
theorem int_to_rat_comap_closedPoint_eq_genericPoint :
    comap (algebraMap ℤ ℚ) (closedPoint ℚ) = (⊥ : PrimeSpectrum ℤ) := by
  rw [show closedPoint ℚ = (⊥ : PrimeSpectrum ℚ) by
    exact Subsingleton.elim _ _]
  simpa [PrimeSpectrum.ext_iff] using
    (Ideal.comap_bot_of_injective (algebraMap ℤ ℚ) (IsFractionRing.injective ℤ ℚ) :
      Ideal.comap (algebraMap ℤ ℚ) ⊥ = (⊥ : Ideal ℤ))

/-! ### Lemma_10_35_17 (from Chap10) -/
universe u

section

variable {R : Type u} [CommRing R]
variable (I : Ideal R)

/- Domain triage:
* primary domain: commutative algebra of ideals in quotient rings;
* source-facing layer: the textbook quotient statement for Jacobson rings and maximal ideals;
* core/canonical owner: mathlib's quotient ideal correspondence
  `Ideal.relIsoOfSurjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective`;
* bridge/view layer: the maximal-ideal statement is the restriction of that owner order isomorphism
  along `Ideal.isMaximal_def`, with `OrderIso.isCoatom_iff` transporting maximality.
* sampled owner/style declarations in this domain:
  - `Ideal.relIsoOfSurjective`;
  - `Ideal.mk_ker`;
  - `Ideal.isMaximal_def`;
  - `isJacobsonRing_quotient`.
* primitive data vs. derived API: the only primitive datum is the ideal `I`; both the quotient
  ideal correspondence and the maximal-ideal restriction are derived from the owner abstraction.
-/

/- Lemma 10.35.17 (1): if `R` is a Jacobson ring and `I` is an ideal, then the quotient ring
`R ⧸ I` is again Jacobson. This is the canonical mathlib instance
`isJacobsonRing_quotient`. -/
recall isJacobsonRing_quotient

namespace Ideal.Quotient

/- Lemma 10.35.17 (2): maximal ideals of `R ⧸ I` correspond order-isomorphically to maximal
ideals of `R` containing `I`. This is the maximal-ideal restriction of the canonical quotient
ideal correspondence `Ideal.relIsoOfSurjective` for `Ideal.Quotient.mk I`. -/
def orderIsoOfMaximal (I : Ideal R) :
    { J : Ideal (R ⧸ I) // J.IsMaximal } ≃o { K : Ideal R // I ≤ K ∧ K.IsMaximal } :=
  let e : Ideal (R ⧸ I) ≃o Set.Ici I :=
    (Ideal.relIsoOfSurjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective).trans <|
      OrderIso.setCongr _ _ <| by
        ext K
        change (RingHom.ker (Ideal.Quotient.mk I) ≤ K) ↔ I ≤ K
        rw [Ideal.mk_ker]
  { toFun := fun J ↦
      ⟨(e J.1).1, (e J.1).2,
        Ideal.isMaximal_def.2 <|
          IsCoatom.of_isCoatom_coe_Ici <| (OrderIso.isCoatom_iff e J.1).2 <|
            Ideal.isMaximal_def.1 J.2⟩
    invFun := fun K ↦
      ⟨e.symm ⟨K.1, K.2.1⟩,
        Ideal.isMaximal_def.2 <|
          (OrderIso.isCoatom_iff e.symm ⟨K.1, K.2.1⟩).2 <|
            IsCoatom.Ici (Ideal.isMaximal_def.1 K.2.2) K.2.1⟩
    left_inv := fun J ↦ by
      apply Subtype.ext
      simp [e]
    right_inv := fun K ↦ by
      apply Subtype.ext
      simpa [e] using congrArg Subtype.val (e.right_inv ⟨K.1, K.2.1⟩)
    map_rel_iff' := fun {J J'} ↦ e.map_rel_iff }

end Ideal.Quotient

end

/-! ### Lemma_10_35_18 (from Chap10) -/
universe u v

section

variable {R : Type u} {K : Type v} [CommRing R] [Field K] [Algebra R K]
variable [IsJacobsonRing R] [Algebra.FiniteType R K]

/- Domain triage:
* primary domain: Jacobson rings and finite type field-valued algebras;
* source-facing layer: the Stacks lemma asserting that a finite type field over a Jacobson ring is
  module-finite over the base;
* core/canonical owner: mathlib's theorem `finite_of_finite_type_of_isJacobsonRing`;
* bridge/view layer: none is needed here, since the source statement already matches the owner
  theorem exactly;
* primitive data vs. derived API: the primitive inputs are the Jacobson base ring `R`, the
  field-valued `R`-algebra `K`, and the finite type hypothesis; `Module.Finite R K` is derived
  directly from the owner theorem, so there is no local wrapper API to keep.
-/

/- Lemma 10.35.18 (Stacks tag `0CY7`): if `R` is a Jacobson ring and `K` is a field of finite
type over `R`, then `K` is finite as an `R`-module. This is exactly the canonical theorem
`finite_of_finite_type_of_isJacobsonRing`. -/
recall finite_of_finite_type_of_isJacobsonRing

