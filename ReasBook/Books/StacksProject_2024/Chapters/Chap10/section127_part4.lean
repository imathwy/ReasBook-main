/-- Helper for Lemma 10.127.7: the lifted literal tensor cocone is colimiting in the under
category. -/
noncomputable abbrev tensor_base_change_lifted_under_cocone_isColimit
    (S : Type u) [CommRing S] [Algebra A S] :
    IsColimit (tensor_base_change_lifted_under_cocone (A := A) (J := J) F S) := by
  -- Proof comment: once the literal tensor cocone is colimiting in commutative rings, the lifted
  -- cocone in `Under (CommRingCat.of S)` is colimiting by the generic `Under` lifting lemma.
  let _ : Nonempty J := tensor_base_change_index_nonempty (J := J)
  exact Under.isColimitLiftCocone
    (tensor_base_change_diagram (A := A) (J := J) F S)
    (tensor_base_change_left_natTrans (A := A) (F := F) S)
    (tensor_base_change_cocone (A := A) (J := J) F S)
    (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : S →+* S ⊗[A] ↑(colimit F)))
    (tensor_base_change_lifted_under_cocone_factor (A := A) (F := F) S)
    (tensor_base_change_cocone_isColimit (A := A) (J := J) F S)

/-- Lemma 10.127.7 (1): if `B` is of finite type over `A` and two `A`-algebra maps
`u, u' : B → C` induce the same map from `B` into the colimit base change `C ⊗[A] colimit F`,
then they already induce the same map into `C ⊗[A] F.obj j` for some stage `j`. -/
theorem finite_type_map_equality_descends
    [Algebra.FiniteType A B]
    (u u' : B →ₐ[A] C)
    (h :
      (includeLeft : C →ₐ[A] C ⊗[A] ↑(colimit F)).comp u =
        (includeLeft : C →ₐ[A] C ⊗[A] ↑(colimit F)).comp u') :
    ∃ j : J,
      (includeLeft : C →ₐ[A] C ⊗[A] ↑(F.obj j)).comp u =
        (includeLeft : C →ₐ[A] C ⊗[A] ↑(F.obj j)).comp u' := by
  classical
  let G := tensor_base_change_diagram (A := A) (J := J) F C
  let c := tensor_base_change_cocone (A := A) (J := J) F C
  obtain ⟨j₀⟩ := tensor_base_change_index_nonempty (J := J)
  let s : Finset B := Algebra.EssFiniteType.finset A B
  have hcolim (x : s) :
      ((forget CommRingCat).mapCocone c).ι.app j₀ (u x ⊗ₜ[A] (1 : ↑(F.obj j₀))) =
        ((forget CommRingCat).mapCocone c).ι.app j₀ (u' x ⊗ₜ[A] (1 : ↑(F.obj j₀))) := by
    -- Proof comment: the colimit hypothesis says the two tensor maps agree on every generator.
    simpa [c, tensor_base_change_cocone] using congrArg
      (fun f : B →ₐ[A] C ⊗[A] ↑(colimit F) ↦ f x) h
  choose j hj hEq using fun x : s ↦
    (Types.FilteredColimit.isColimit_eq_iff'
      (tensor_base_change_cocone_forget_isColimit (A := A) (J := J) F C)
      (u x ⊗ₜ[A] (1 : ↑(F.obj j₀)))
      (u' x ⊗ₜ[A] (1 : ↑(F.obj j₀)))).1 (hcolim x)
  obtain ⟨j', hj'⟩ := IsFiltered.sup_objs_exists (Finset.univ.image j)
  let hTo : ∀ x : s, j x ⟶ j' := fun x ↦
    Classical.choice (hj' (Finset.mem_image_of_mem j (Finset.mem_univ x)))
  refine ⟨j', ?_⟩
  -- Proof comment: after moving every generator equality to one common later stage, the two
  -- algebra maps agree by finite-type extensionality.
  apply Algebra.EssFiniteType.algHom_ext (R := A) (S := B)
      (T := C ⊗[A] ↑(F.obj j'))
  intro x hx
  let xs : s := ⟨x, hx⟩
  have hx' := congrArg
    (fun z : G.obj (j xs) ↦ ((G.map (hTo xs)) z))
    (hEq xs)
  simpa [G, tensor_base_change_diagram, hTo] using hx'

/-- Helper for Lemma 10.127.7: if finitely many equalities in one tensor stage hold after passing
to the colimit tensor stage, then they already hold after one common transition map out of that
stage. -/
lemma tensor_stage_finite_family_stabilizes
    {S : Type u} [CommRing S] [Algebra A S]
    (j₀ : J)
    {ι : Type u}
    (s : Finset ι)
    (lhs rhs : ι → S ⊗[A] ↑(F.obj j₀))
    (h :
      ∀ i ∈ s,
        (Algebra.TensorProduct.map (AlgHom.id A S) (colimit.ι F j₀).hom) (lhs i) =
          (Algebra.TensorProduct.map (AlgHom.id A S) (colimit.ι F j₀).hom) (rhs i)) :
    ∃ (j : J) (f : j₀ ⟶ j), ∀ i ∈ s,
      (Algebra.TensorProduct.map (AlgHom.id A S) (F.map f).hom) (lhs i) =
        (Algebra.TensorProduct.map (AlgHom.id A S) (F.map f).hom) (rhs i) := by
  classical
  let G := tensor_base_change_diagram (A := A) (J := J) F S
  let c := tensor_base_change_cocone (A := A) (J := J) F S
  choose j hj hEq using fun i : s ↦
    (Types.FilteredColimit.isColimit_eq_iff'
      (tensor_base_change_cocone_forget_isColimit (A := A) (J := J) F S)
      (lhs i) (rhs i)).1 (h i i.2)
  let O : Finset J := insert j₀ (Finset.univ.image j)
  let edges :
      Finset (Σ' (X Y : J) (_ : X ∈ O) (_ : Y ∈ O), X ⟶ Y) :=
    Finset.univ.image fun i : s ↦
      ⟨j₀, j i, by simp [O], by
        exact Finset.mem_insert_of_mem (Finset.mem_image_of_mem j (Finset.mem_univ i)), hj i⟩
  obtain ⟨j', toStage, htoStage⟩ := IsFiltered.sup_exists O edges
  let f : j₀ ⟶ j' := toStage (by simp [O])
  refine ⟨j', f, ?_⟩
  intro i hi
  let is : s := ⟨i, hi⟩
  have mem_j0 : j₀ ∈ O := by simp [O]
  have mem_j : j is ∈ O := by
    exact Finset.mem_insert_of_mem (Finset.mem_image_of_mem j (Finset.mem_univ is))
  have hedge :
      (⟨j₀, j is, mem_j0, mem_j, hj is⟩ : Σ' (X Y : J) (_ : X ∈ O) (_ : Y ∈ O), X ⟶ Y) ∈ edges := by
    exact Finset.mem_image_of_mem _ (Finset.mem_univ is)
  have hcomm : hj is ≫ toStage mem_j = f := by
    simpa [f] using htoStage mem_j0 mem_j hedge
  -- Proof comment: each chosen equality first holds after `hj is`, and then the filtered
  -- comparison maps force all of those witnesses to factor through the same `f : j₀ ⟶ j'`.
  have hmap :
      Algebra.TensorProduct.map (AlgHom.id A S) (F.map f).hom =
        (Algebra.TensorProduct.map (AlgHom.id A S) (F.map (toStage mem_j)).hom).comp
          (Algebra.TensorProduct.map (AlgHom.id A S) (F.map (hj is)).hom) := by
    rw [← hcomm]
    apply tensor_base_change_algHom_ext (A := A)
    · ext x
      simp
    · ext r
      simp
  have his := congrArg
    (fun z : G.obj (j is) ↦ G.map (toStage mem_j) z)
    (hEq is)
  calc
    (Algebra.TensorProduct.map (AlgHom.id A S) (F.map f).hom) (lhs i) =
        ((Algebra.TensorProduct.map (AlgHom.id A S) (F.map (toStage mem_j)).hom).comp
          (Algebra.TensorProduct.map (AlgHom.id A S) (F.map (hj is)).hom)) (lhs i) := by
            simpa [hmap]
    _ = ((Algebra.TensorProduct.map (AlgHom.id A S) (F.map (toStage mem_j)).hom).comp
          (Algebra.TensorProduct.map (AlgHom.id A S) (F.map (hj is)).hom)) (rhs i) := by
            simpa [G, tensor_base_change_diagram] using his
    _ = (Algebra.TensorProduct.map (AlgHom.id A S) (F.map f).hom) (rhs i) := by
            simpa [hmap]

/-- Lemma 10.127.7 (2): if `C` is of finite type over `A` and the base change of
`u : B → C` to the filtered colimit algebra `colimit F` is surjective, then the base change of
`u` to some stage `F.obj j` is already surjective. -/
theorem finite_type_surjectivity_descends
    [Algebra.FiniteType A C]
    (u : B →ₐ[A] C)
    (h : Function.Surjective (Algebra.TensorProduct.map u (AlgHom.id A ↑(colimit F)))) :
    ∃ j : J, Function.Surjective (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j))) := by
  classical
  let G := tensor_base_change_diagram (A := A) (J := J) F B
  let c := tensor_base_change_cocone (A := A) (J := J) F B
  letI : Algebra B C := u.toRingHom.toAlgebra
  letI : Algebra.FiniteType B C :=
    Algebra.FiniteType.of_restrictScalars_finiteType (R := A) (S := B) (A := C)
  let hBC : Algebra.FiniteType B C := inferInstance
  let s : Finset C := hBC.out.choose
  have hs : Algebra.adjoin B (s : Set C) = ⊤ := by
    -- Proof comment: after restricting scalars along `u`, the same finite-type algebra `C`
    -- still has a finite generating set over `B`.
    exact hBC.out.choose_spec
  let uInf := Algebra.TensorProduct.map u (AlgHom.id A ↑(colimit F))
  choose y hy using fun x : s ↦ h (x ⊗ₜ[A] (1 : ↑(colimit F)))
  choose j z hz using fun x : s ↦
    Types.jointly_surjective_of_isColimit
      (tensor_base_change_cocone_forget_isColimit (A := A) (J := J) F B) (y x)
  obtain ⟨j₀, hj₀⟩ := IsFiltered.sup_objs_exists (Finset.univ.image j)
  let toStage : ∀ x : s, j x ⟶ j₀ := fun x ↦
    Classical.choice (hj₀ (Finset.mem_image_of_mem j (Finset.mem_univ x)))
  let z₀ : s → B ⊗[A] ↑(F.obj j₀) := fun x ↦ G.map (toStage x) (z x)
  have hpreimage_colim (x : s) :
      uInf (((forget CommRingCat).mapCocone c).ι.app j₀ (z₀ x)) =
        (x : C) ⊗ₜ[A] (1 : ↑(colimit F)) := by
    have hstage :
        ((forget CommRingCat).mapCocone c).ι.app j₀ (z₀ x) = y x := by
      have hmove :
          ((forget CommRingCat).mapCocone c).ι.app j₀ (z₀ x) =
            ((forget CommRingCat).mapCocone c).ι.app (j x) (z x) := by
          simpa [z₀] using ConcreteCategory.congr_hom (c.w (toStage x)) (z x)
      exact hmove.trans (hz x)
    calc
      uInf (((forget CommRingCat).mapCocone c).ι.app j₀ (z₀ x)) = uInf (y x) := by
        rw [hstage]
      _ = (x : C) ⊗ₜ[A] (1 : ↑(colimit F)) := hy x
  have hdefect (x : s) :
      (Algebra.TensorProduct.map (AlgHom.id A C) (colimit.ι F j₀).hom)
          ((Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₀))) (z₀ x)) =
        (x : C) ⊗ₜ[A] (1 : ↑(colimit F)) := by
    -- Proof comment: after moving each chosen preimage to the common stage `j₀`, the tensor map
    -- compatibility identifies its colimit image with the target generator.
    have hexchange := congrArg
      (fun g : B ⊗[A] ↑(F.obj j₀) →ₐ[A] C ⊗[A] ↑(colimit F) ↦ g (z₀ x))
      (tensor_map_exchange (A := A) (S := B) (S' := C)
        (R' := ↑(F.obj j₀)) (R'' := ↑(colimit F))
        u (colimit.ι F j₀).hom)
    calc
      (Algebra.TensorProduct.map (AlgHom.id A C) (colimit.ι F j₀).hom)
          ((Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₀))) (z₀ x)) =
        uInf (((forget CommRingCat).mapCocone c).ι.app j₀ (z₀ x)) := by
          simpa [uInf, c, tensor_base_change_cocone] using hexchange
      _ = (x : C) ⊗ₜ[A] (1 : ↑(colimit F)) := hpreimage_colim x
  let lhs : C → C ⊗[A] ↑(F.obj j₀) := fun x ↦
    if hx : x ∈ s then
      (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₀))) (z₀ ⟨x, hx⟩)
    else
      0
  obtain ⟨j, f, hf⟩ :=
    tensor_stage_finite_family_stabilizes (A := A) (J := J) (F := F) (S := C) j₀
      s
      lhs
      (fun x ↦ (x : C) ⊗ₜ[A] (1 : ↑(F.obj j₀)))
      (fun x hx ↦ by simpa [lhs, hx] using hdefect ⟨x, hx⟩)
  refine ⟨j, ?_⟩
  -- Proof comment: once the finitely many generator defects vanish at one later stage, the
  -- descended preimages force surjectivity by the generator criterion.
  refine tensor_map_surjective_of_generator_preimages (A := A) (B := B) (C := C)
    (R' := ↑(F.obj j)) u s hs ?_
  intro x hx
  let xs : s := ⟨x, hx⟩
  refine ⟨(Algebra.TensorProduct.map (AlgHom.id A B) (F.map f).hom) (z₀ xs), ?_⟩
  have hexchange := congrArg
    (fun g : B ⊗[A] ↑(F.obj j₀) →ₐ[A] C ⊗[A] ↑(F.obj j) ↦ g (z₀ xs))
    (tensor_map_exchange (A := A) (S := B) (S' := C)
      (R' := ↑(F.obj j₀)) (R'' := ↑(F.obj j))
      u (F.map f).hom)
  calc
    (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j)))
        ((Algebra.TensorProduct.map (AlgHom.id A B) (F.map f).hom) (z₀ xs)) =
      (Algebra.TensorProduct.map (AlgHom.id A C) (F.map f).hom)
        ((Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₀))) (z₀ xs)) := by
          simpa using hexchange.symm
    _ = (Algebra.TensorProduct.map (AlgHom.id A C) (F.map f).hom)
          (x ⊗ₜ[A] (1 : ↑(F.obj j₀))) := by
          simpa [lhs, hx] using hf x hx
    _ = x ⊗ₜ[A] (1 : ↑(F.obj j)) := by
          simp

/-- Helper for Lemma 10.127.7: if two maps into a fixed tensor stage become equal after passing
to the colimit stage, then they agree after moving to one later stage. -/
lemma finite_type_stage_map_equality_stabilizes
    {X S : Type u} [CommRing X] [CommRing S]
    [Algebra A X] [Algebra A S] [Algebra.FiniteType A X]
    (j₀ : J)
    (φ ψ : X →ₐ[A] S ⊗[A] ↑(F.obj j₀))
    (h :
      (Algebra.TensorProduct.map (AlgHom.id A S) (colimit.ι F j₀).hom).comp φ =
        (Algebra.TensorProduct.map (AlgHom.id A S) (colimit.ι F j₀).hom).comp ψ) :
    ∃ (j : J) (f : j₀ ⟶ j),
      (Algebra.TensorProduct.map (AlgHom.id A S) (F.map f).hom).comp φ =
        (Algebra.TensorProduct.map (AlgHom.id A S) (F.map f).hom).comp ψ := by
  classical
  let s : Finset X := Algebra.EssFiniteType.finset A X
  obtain ⟨j, f, hf⟩ :=
    tensor_stage_finite_family_stabilizes (A := A) (J := J) (F := F) (S := S) j₀
      s (fun x ↦ φ x) (fun x ↦ ψ x) (fun x hx ↦ by
        -- Proof comment: the colimit equality of algebra maps gives equality on every chosen
        -- finite-type generator.
        simpa using congrArg
          (fun g : X →ₐ[A] S ⊗[A] ↑(colimit F) ↦ g x) h)
  refine ⟨j, f, ?_⟩
  -- Proof comment: equality on the finite generating set upgrades to equality of algebra maps.
  apply Algebra.EssFiniteType.algHom_ext (R := A) (S := X)
      (T := S ⊗[A] ↑(F.obj j))
  intro x hx
  exact hf x hx

/-- Helper for Lemma 10.127.7: the inverse to the colimit tensor map restricts to a two-sided
inverse on the left tensor factor. -/
lemma tensor_colimit_inverse_comp_includeLeft
    (u : B →ₐ[A] C)
    (h : Function.Bijective (Algebra.TensorProduct.map u (AlgHom.id A ↑(colimit F)))) :
    let uInf := Algebra.TensorProduct.map u (AlgHom.id A ↑(colimit F))
    let e := AlgEquiv.ofBijective uInf h
    let v : C →ₐ[A] B ⊗[A] ↑(colimit F) := e.symm.toAlgHom.comp includeLeft
    v.comp u = includeLeft ∧ uInf.comp v = includeLeft := by
  -- Proof comment: `AlgEquiv.ofBijective` gives a genuine inverse on the colimit tensor product,
  -- and restricting along `includeLeft` records the two left-factor identities we need later.
  let uInf := Algebra.TensorProduct.map u (AlgHom.id A ↑(colimit F))
  let e := AlgEquiv.ofBijective uInf h
  let v : C →ₐ[A] B ⊗[A] ↑(colimit F) := e.symm.toAlgHom.comp includeLeft
  change v.comp u = includeLeft ∧ uInf.comp v = includeLeft
  constructor
  · ext b
    change e.symm (u b ⊗ₜ[A] (1 : ↑(colimit F))) = b ⊗ₜ[A] (1 : ↑(colimit F))
    calc
      e.symm (u b ⊗ₜ[A] (1 : ↑(colimit F))) =
        e.symm (uInf (b ⊗ₜ[A] (1 : ↑(colimit F)))) := by
          simp [uInf]
      _ = b ⊗ₜ[A] (1 : ↑(colimit F)) := by
          rw [AlgEquiv.ofBijective_symm_apply_apply]
  · ext c
    change uInf (e.symm (c ⊗ₜ[A] (1 : ↑(colimit F)))) = c ⊗ₜ[A] (1 : ↑(colimit F))
    rw [AlgEquiv.ofBijective_apply_symm_apply]

/-- Lemma 10.127.7 (3): if `C` is finitely presented over `A`, then every `A`-algebra map
`v : C → B ⊗[A] colimit F` descends to some stage `F.obj j`. -/
theorem finite_presentation_hom_descends
    [Algebra.FinitePresentation A C]
    (v : C →ₐ[A] B ⊗[A] ↑(colimit F)) :
    ∃ (j : J) (v_j : C →ₐ[A] B ⊗[A] ↑(F.obj j)),
      (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j).hom).comp v_j = v := by
  let G := tensor_base_change_diagram (A := A) (J := J) F B
  let α := tensor_base_change_scalar_natTrans (A := A) (F := F) B
  let c := tensor_base_change_cocone (A := A) (J := J) F B
  let hc := tensor_base_change_cocone_isColimit (A := A) (J := J) F B
  letI : PreservesColimit G (forget CommRingCat) :=
    preservesColimit_of_preserves_colimit_cocone
      hc
      (tensor_base_change_cocone_forget_isColimit (A := A) (J := J) F B)
  have hfp : (algebraMap A C).FinitePresentation := by
    -- Proof comment: the algebra-level finite-presentation instance is exactly the ring-hom
    -- finite-presentation hypothesis needed by the owner theorem.
    exact (RingHom.finitePresentation_algebraMap (A := A) (B := C)).2 inferInstance
  have hv :
      ∀ j,
        CommRingCat.ofHom (algebraMap A C) ≫ CommRingCat.ofHom v.toRingHom =
          α.app j ≫ c.ι.app j := by
    -- Proof comment: the descended map `v` is `A`-linear, so it agrees with the scalar legs of
    -- the tensor cocone on the base ring.
    intro j
    apply CommRingCat.hom_ext
    ext a
    simpa [α, c, tensor_base_change_scalar_natTrans, tensor_base_change_cocone] using v.commutes a
  obtain ⟨j, g, hg, hfac⟩ :=
    RingHom.EssFiniteType.exists_eq_comp_ι_app_of_isColimit
      (R := CommRingCat.of A) (F := G) (α := α)
      (f := CommRingCat.ofHom (algebraMap A C))
      (c := c) (hc := hc) hfp
      (CommRingCat.ofHom v.toRingHom) hv
  have hcomm :
      ∀ a : A,
        g.hom (algebraMap A C a) = algebraMap A (B ⊗[A] ↑(F.obj j)) a := by
    -- Proof comment: the stage map is an `A`-algebra map because its restriction to `A`
    -- coincides with the scalar natural transformation at stage `j`.
    intro a
    have hga := congrArg
      (fun k : CommRingCat.of A ⟶ G.obj j ↦ k.hom a) hg
    simpa [G, α, tensor_base_change_diagram, tensor_base_change_scalar_natTrans] using hga
  let v_j : C →ₐ[A] B ⊗[A] ↑(F.obj j) :=
    { toRingHom := g.hom
      commutes' := hcomm }
  refine ⟨j, v_j, ?_⟩
  apply DFunLike.ext
  intro x
  have hx := congrArg
    (fun k : CommRingCat.of C ⟶ c.pt ↦ k.hom x)
    hfac
  simpa [v_j, c, G, tensor_base_change_cocone, tensor_base_change_diagram] using hx.symm

/-- Lemma 10.127.7 (4): if `B` is of finite type over `A`, `C` is finitely presented over `A`,
and the base change of `u : B → C` to the filtered colimit algebra `colimit F` is bijective, then
the base change of `u` to some stage `F.obj j` is already bijective. -/
theorem finite_type_finite_presentation_bijective_descends
    [Algebra.FiniteType A B] [Algebra.FinitePresentation A C]
    (u : B →ₐ[A] C)
    (h : Function.Bijective (Algebra.TensorProduct.map u (AlgHom.id A ↑(colimit F)))) :
    ∃ j : J, Function.Bijective (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j))) := by
  classical
  let uInf := Algebra.TensorProduct.map u (AlgHom.id A ↑(colimit F))
  let e := AlgEquiv.ofBijective uInf h
  let v : C →ₐ[A] B ⊗[A] ↑(colimit F) := e.symm.toAlgHom.comp includeLeft
  have hInv : v.comp u = includeLeft ∧ uInf.comp v = includeLeft := by
    -- Proof comment: the colimit-stage inverse already restricts to a two-sided inverse on the
    -- left tensor factor, which is exactly the data the source proof descends.
    simpa [uInf, e, v] using
      (tensor_colimit_inverse_comp_includeLeft (A := A) (J := J) (F := F)
        (B := B) (C := C) u h)
  obtain ⟨j₀, v₀, hv₀⟩ :=
    finite_presentation_hom_descends (A := A) (J := J) (F := F) (B := B) (C := C) v
  have hleft :
      (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₀).hom).comp (v₀.comp u) =
        (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₀).hom).comp includeLeft := by
    -- Proof comment: after descending `v`, the left inverse identity still holds after passing
    -- back up to the colimit stage.
    calc
      (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₀).hom).comp (v₀.comp u) =
          v.comp u := by
            simpa [AlgHom.comp_assoc] using congrArg
              (fun g : C →ₐ[A] B ⊗[A] ↑(colimit F) ↦ g.comp u) hv₀
      _ = includeLeft := hInv.1
      _ =
          (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₀).hom).comp includeLeft := by
            symm
            simpa using
              (tensor_map_id_comp_includeLeft (A := A) (S := B)
                (R' := ↑(F.obj j₀)) (R'' := ↑(colimit F)) (colimit.ι F j₀).hom)
  obtain ⟨j₁, f₁, hf₁⟩ :=
    finite_type_stage_map_equality_stabilizes (A := A) (J := J) (F := F)
      (X := B) (S := B) j₀ (v₀.comp u) includeLeft hleft
  let v₁ : C →ₐ[A] B ⊗[A] ↑(F.obj j₁) :=
    (Algebra.TensorProduct.map (AlgHom.id A B) (F.map f₁).hom).comp v₀
  have hv₁u : v₁.comp u = includeLeft := by
    -- Proof comment: the first stabilization enlarges the stage until the left inverse identity
    -- already holds there.
    simpa [v₁, AlgHom.comp_assoc] using hf₁
  have hcolim_comp_f₁ :
      (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₁).hom).comp
          (Algebra.TensorProduct.map (AlgHom.id A B) (F.map f₁).hom) =
        (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₀).hom) := by
    -- Proof comment: this is the tensor-level cocone relation for the transition `f₁`.
    apply tensor_base_change_algHom_ext (A := A)
    · ext b
      simp
    · ext r
      simp [Functor.map_comp, Algebra.TensorProduct.map_comp]
  have hv₁ :
      (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₁).hom).comp v₁ = v := by
    -- Proof comment: moving `v₀` from `j₀` to `j₁` does not change its colimit image.
    calc
      (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₁).hom).comp v₁ =
          ((Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₁).hom).comp
            (Algebra.TensorProduct.map (AlgHom.id A B) (F.map f₁).hom)).comp v₀ := by
              rfl
      _ = (Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₀).hom).comp v₀ := by
            rw [hcolim_comp_f₁]
      _ = v := hv₀
  have hright :
      (Algebra.TensorProduct.map (AlgHom.id A C) (colimit.ι F j₁).hom).comp
          ((Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₁))).comp v₁) =
        (Algebra.TensorProduct.map (AlgHom.id A C) (colimit.ι F j₁).hom).comp includeLeft := by
    -- Proof comment: the same descended inverse also satisfies the right inverse identity after
    -- passing to the colimit stage.
    have hexchange := congrArg
      (fun g : B ⊗[A] ↑(F.obj j₁) →ₐ[A] C ⊗[A] ↑(colimit F) ↦ g.comp v₁)
      (tensor_map_exchange (A := A) (S := B) (S' := C)
        (R' := ↑(F.obj j₁)) (R'' := ↑(colimit F))
        u (colimit.ι F j₁).hom)
    calc
      (Algebra.TensorProduct.map (AlgHom.id A C) (colimit.ι F j₁).hom).comp
          ((Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₁))).comp v₁) =
        uInf.comp ((Algebra.TensorProduct.map (AlgHom.id A B) (colimit.ι F j₁).hom).comp v₁) := by
          simpa [uInf, AlgHom.comp_assoc] using hexchange
      _ = uInf.comp v := by rw [hv₁]
      _ = includeLeft := hInv.2
      _ =
          (Algebra.TensorProduct.map (AlgHom.id A C) (colimit.ι F j₁).hom).comp includeLeft := by
            symm
            simpa using
              (tensor_map_id_comp_includeLeft (A := A) (S := C)
                (R' := ↑(F.obj j₁)) (R'' := ↑(colimit F)) (colimit.ι F j₁).hom)
  obtain ⟨j₂, f₂, hf₂⟩ :=
    finite_type_stage_map_equality_stabilizes (A := A) (J := J) (F := F)
      (X := C) (S := C) j₁
      ((Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₁))).comp v₁)
      includeLeft hright
  let v₂ : C →ₐ[A] B ⊗[A] ↑(F.obj j₂) :=
    (Algebra.TensorProduct.map (AlgHom.id A B) (F.map f₂).hom).comp v₁
  have hv₂u : v₂.comp u = includeLeft := by
    -- Proof comment: enlarging the stage again preserves the already-stable left inverse
    -- identity.
    calc
      v₂.comp u =
          (Algebra.TensorProduct.map (AlgHom.id A B) (F.map f₂).hom).comp (v₁.comp u) := by
            rfl
      _ = (Algebra.TensorProduct.map (AlgHom.id A B) (F.map f₂).hom).comp includeLeft := by
            rw [hv₁u]
      _ = includeLeft := by
            simpa using
              (tensor_map_id_comp_includeLeft (A := A) (S := B)
                (R' := ↑(F.obj j₁)) (R'' := ↑(F.obj j₂)) (F.map f₂).hom)
  have hv₂right :
      (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₂))).comp v₂ = includeLeft := by
    -- Proof comment: the second stabilization was chosen precisely so that the right inverse
    -- identity also holds at the final stage.
    have hexchange := congrArg
      (fun g : B ⊗[A] ↑(F.obj j₁) →ₐ[A] C ⊗[A] ↑(F.obj j₂) ↦ g.comp v₁)
      (tensor_map_exchange (A := A) (S := B) (S' := C)
        (R' := ↑(F.obj j₁)) (R'' := ↑(F.obj j₂))
        u (F.map f₂).hom)
    calc
      (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₂))).comp v₂ =
          (Algebra.TensorProduct.map (AlgHom.id A C) (F.map f₂).hom).comp
            ((Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₁))).comp v₁) := by
              simpa [v₂, AlgHom.comp_assoc] using hexchange.symm
      _ = (Algebra.TensorProduct.map (AlgHom.id A C) (F.map f₂).hom).comp includeLeft := hf₂
      _ = includeLeft := by
            simpa using
              (tensor_map_id_comp_includeLeft (A := A) (S := C)
                (R' := ↑(F.obj j₁)) (R'' := ↑(F.obj j₂)) (F.map f₂).hom)
  let w : C ⊗[A] ↑(F.obj j₂) →ₐ[A] B ⊗[A] ↑(F.obj j₂) :=
    Algebra.TensorProduct.productMap v₂ includeRight
  have hw :
      w.comp (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₂))) = AlgHom.id A _ ∧
        (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₂))).comp w = AlgHom.id A _ := by
    -- Proof comment: once both identities hold on the left tensor factor, `productMap` upgrades
    -- them to a genuine two-sided inverse on the whole tensor product.
    simpa [w] using
      (tensor_base_change_productMap_two_sided_inverse (A := A) (B := B) (C := C)
        (R' := ↑(F.obj j₂)) u v₂ hv₂u hv₂right)
  rcases hw with ⟨hw_left, hw_right⟩
  refine ⟨j₂, ?_⟩
  refine ⟨?_, ?_⟩
  · -- Proof comment: the constructed inverse is a right inverse, hence the tensor map is
    -- injective.
    exact Function.RightInverse.injective (f := Algebra.TensorProduct.map u
      (AlgHom.id A ↑(F.obj j₂))) (g := w) (fun x ↦ by
        change (w.comp (Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₂)))) x = x
        simpa using congrArg
          (fun g : B ⊗[A] ↑(F.obj j₂) →ₐ[A] B ⊗[A] ↑(F.obj j₂) ↦ g x) hw_left)
  · -- Proof comment: the same inverse is also a left inverse, hence the tensor map is
    -- surjective.
    exact Function.LeftInverse.surjective (f := Algebra.TensorProduct.map u
      (AlgHom.id A ↑(F.obj j₂))) (g := w) (fun x ↦ by
        change ((Algebra.TensorProduct.map u (AlgHom.id A ↑(F.obj j₂))).comp w) x = x
        simpa using congrArg
          (fun g : C ⊗[A] ↑(F.obj j₂) →ₐ[A] C ⊗[A] ↑(F.obj j₂) ↦ g x) hw_right)

end
