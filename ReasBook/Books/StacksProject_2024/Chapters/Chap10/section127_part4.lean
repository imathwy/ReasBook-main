/-- Helper for Lemma 10.127.7: the `CommRingCat` universe-lift functor fixes identities after
forgetting to the underlying `ULift`ed carrier. -/
lemma commRingCat_uliftFunctor_map_id (R : CommRingCat.{u}) :
    CommRingCat.ofHom
        (RingHom.ulift (RingHom.id R) : ULift.{v} R →+* ULift.{v} R) =
      𝟙 (CommRingCat.of (ULift.{v} R)) := by
  -- Proof comment: on elements, the lifted identity map is literally the identity function.
  ext x
  simp [RingHom.ulift_apply]

/-- Helper for Lemma 10.127.7: the `CommRingCat` universe-lift functor sends compositions to
compositions on the nose after forgetting to the `ULift`ed carriers. -/
lemma commRingCat_uliftFunctor_map_comp
    {R S T : CommRingCat.{u}} (f : R ⟶ S) (g : S ⟶ T) :
    CommRingCat.ofHom
        (RingHom.ulift (g.hom.comp f.hom) : ULift.{v} R →+* ULift.{v} T) =
      CommRingCat.ofHom
          (RingHom.ulift f.hom : ULift.{v} R →+* ULift.{v} S) ≫
        CommRingCat.ofHom
          (RingHom.ulift g.hom : ULift.{v} S →+* ULift.{v} T) := by
  -- Proof comment: both sides act by `x ↦ ULift.up (g (f x.down))`, so function extensionality
  -- closes the categorical equality.
  ext x
  simp [RingHom.ulift_apply]

/-- Helper for Lemma 10.127.7: the literal universe-lift functor on `CommRingCat`. -/
abbrev commRingCat_uliftFunctor : CommRingCat.{u} ⥤ CommRingCat.{max u v} where
  obj R := CommRingCat.of (ULift.{v} R)
  map f := CommRingCat.ofHom (RingHom.ulift f.hom)
  map_id := commRingCat_uliftFunctor_map_id
  map_comp := commRingCat_uliftFunctor_map_comp

/-- Helper for Lemma 10.127.7: after forgetting rings to types, the `CommRingCat` universe-lift
functor agrees with the ordinary `Type`-level `uliftFunctor`. -/
abbrev commRingCat_uliftFunctor_forget_iso :
    commRingCat_uliftFunctor.{u, v} ⋙ forget CommRingCat.{max u v} ≅
      forget CommRingCat.{u} ⋙ CategoryTheory.uliftFunctor.{max u v, u} := by
  -- Proof comment: both composite functors have the same objects and send a ring map
  -- `f : R →+* S` to `x ↦ ULift.up (f x.down)`.
  refine NatIso.ofComponents (fun R ↦ ?_) ?_
  · refine
      { hom := fun x ↦ ⟨x.down⟩
        inv := fun x ↦ ⟨x.down⟩ }
  · intro R S f
    ext x
    rfl

/-- Helper for Lemma 10.127.7: the tensor-stage diagram after lifting every carrier by `ULift`. -/
abbrev tensor_base_change_diagram_ulift
    (S : Type u) [CommRing S] [Algebra A S] :
    J ⥤ CommRingCat.{max u v} :=
  tensor_base_change_diagram (A := A) (J := J) F S ⋙ commRingCat_uliftFunctor

/-- Helper for Lemma 10.127.7: the canonical tensor cocone after lifting every carrier by
`ULift`. -/
abbrev tensor_base_change_cocone_ulift
    (S : Type u) [CommRing S] [Algebra A S] :
    Cocone (tensor_base_change_diagram_ulift (A := A) (J := J) F S) :=
  commRingCat_uliftFunctor.mapCocone (tensor_base_change_cocone (A := A) (J := J) F S)

/-- Helper for Lemma 10.127.7: once the forgotten tensor cocone is known to be colimiting in the
small universe of types, applying `uliftFunctor` preserves that colimit in the larger universe. -/
noncomputable abbrev tensor_base_change_cocone_small_ulift_isColimit
    (S : Type u) [CommRing S] [Algebra A S]
    (hsmall :
      IsColimit ((forget CommRingCat).mapCocone (tensor_base_change_cocone (A := A) (J := J) F S))) :
    IsColimit (((forget CommRingCat) ⋙ CategoryTheory.uliftFunctor.{max u v, u}).mapCocone
      (tensor_base_change_cocone (A := A) (J := J) F S)) := by
  -- Proof comment: the only work here is functorial: `uliftFunctor` preserves all colimits of
  -- types, so it transports any small-universe colimit witness to the larger universe.
  exact isColimitOfPreserves CategoryTheory.uliftFunctor.{max u v, u} hsmall

/-- Helper for Lemma 10.127.7: forgetting the tensor-base-change cocone to types still gives a
filtered colimit. -/
noncomputable abbrev tensor_base_change_cocone_forget_isColimit
    (S : Type u) [CommRing S] [Algebra A S] :
