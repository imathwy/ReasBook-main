import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.


/-! ### Definition_10_32_1 (from Chap10) -/
universe u

section

variable {R : Type u} [CommSemiring R]

namespace Ideal

/-
Definition 10.32.1 (1), source-facing layer: the chapter vocabulary "locally nilpotent ideal"
names the canonical containment `I ≤ nilradical R`.

Primitive data: only the ideal `I`.
Core/canonical owner: the raw proposition `I ≤ nilradical R`.
Bridge/view: `isLocallyNilpotent_iff` below rewrites this to the textbook elementwise form.
-/
abbrev IsLocallyNilpotent (I : Ideal R) : Prop :=
  I ≤ nilradical R

/-- Definition 10.32.1 (1), textbook wording: an ideal is locally nilpotent exactly when every
element of it is nilpotent. -/
@[simp] theorem isLocallyNilpotent_iff (I : Ideal R) :
    I.IsLocallyNilpotent ↔ ∀ x ∈ I, IsNilpotent x := by
  simp [IsLocallyNilpotent, SetLike.le_def, mem_nilradical]

end Ideal

/- Definition 10.32.1 (2): nilpotent ideals are governed by the canonical predicate
`IsNilpotent : Ideal R → Prop`; for an ideal `I`, this is definitionally the assertion that some
power `I ^ n` is zero. -/
#check (IsNilpotent : Ideal R → Prop)

end

/-! ### Example_10_32_2 (from Chap10) -/
open MvPolynomial

universe u

noncomputable section

section

variable (k : Type u) [CommSemiring k]

/-- The ideal of `k[X_n \mid n ∈ ℕ+]` generated by the powers `X_n^n`. -/
def variablePowerIdeal : Ideal (MvPolynomial ℕ+ k) :=
  Ideal.span (Set.range fun n : ℕ+ ↦ X n ^ (n : ℕ))

end

section

variable (k : Type u) [CommSemiring k]

/-- The quotient of `k[X_n \mid n ∈ ℕ+]` by `variablePowerIdeal k`, modeled via `RingQuot` so it
is available over commutative semirings. -/
abbrev variablePowerQuotient :=
  RingQuot (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0)

/-- The image of the owner ideal `idealOfVars ℕ+ k` in the quotient by `variablePowerIdeal k`. -/
def quotientVariableIdeal : Ideal (variablePowerQuotient k) :=
  Ideal.map
    (RingQuot.mkRingHom (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0))
    (idealOfVars ℕ+ k)

section

variable [Nontrivial k]

local instance :
    MulAction (variablePowerQuotient k) (variablePowerQuotient k) :=
  Monoid.toMulAction _

local notation "q" =>
  RingQuot.mkRingHom
    (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0)

/-- Helper for Example 10.32.2: each variable class in `variablePowerQuotient k` is nilpotent. -/
lemma quotient_variable_generator_isNilpotent (i : ℕ+) :
    IsNilpotent (q (X i : MvPolynomial ℕ+ k)) := by
  -- The defining relation kills the prescribed power `X i ^ i` in the quotient.
  refine ⟨(i : ℕ), ?_⟩
  have hrel :
      (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0)
        ((X i : MvPolynomial ℕ+ k) ^ (i : ℕ)) 0 := by
    exact ⟨Ideal.subset_span ⟨i, rfl⟩, rfl⟩
  calc
    (q (X i : MvPolynomial ℕ+ k)) ^ (i : ℕ) = q ((X i : MvPolynomial ℕ+ k) ^ (i : ℕ)) := by
      rw [map_pow]
    _ = 0 := by
      simpa using
        (RingQuot.mkRingHom_rel
          (r := fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0) hrel)

/-- Helper for Example 10.32.2: any quotient monomial with a variable factor is nilpotent. -/
lemma quotient_monomial_isNilpotent_of_support {m : ℕ+ →₀ ℕ} {a : k} {i : ℕ+}
    (hi : i ∈ m.support) :
    IsNilpotent (q (monomial m a : MvPolynomial ℕ+ k)) := by
  -- Removing one copy of `X i` exposes the nilpotent generator factor.
  let m' : ℕ+ →₀ ℕ := m - Finsupp.single i 1
  have hm : m' + Finsupp.single i 1 = m := by
    dsimp [m']
    exact Finsupp.sub_add_single_one_cancel <| by
      simpa [Finsupp.mem_support_iff] using hi
  have hmonomial : monomial m a = monomial m' a * X i := by
    rw [← hm, monomial_add_single, pow_one]
  rw [hmonomial, map_mul]
  exact (Commute.all _ _).isNilpotent_mul_left
    (quotient_variable_generator_isNilpotent (k := k) i)

/-- Helper for Example 10.32.2: membership in `variablePowerIdeal k` is detected monomial by
support monomial. -/
lemma variablePowerIdeal_mem_iff_support (p : MvPolynomial ℕ+ k) :
    p ∈ variablePowerIdeal k ↔
      ∀ d ∈ p.support, ∃ i : ℕ+, (i : ℕ) ≤ d i := by
  -- Rewrite the ideal as a monomial ideal and apply the standard support criterion.
  have hspan :
      variablePowerIdeal k =
        Ideal.span
          ((fun d : (ℕ+ →₀ ℕ) ↦ monomial d (1 : k)) ''
            Set.range (fun i : ℕ+ ↦ Finsupp.single i (i : ℕ))) := by
    rw [variablePowerIdeal]
    congr 1
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      refine ⟨Finsupp.single i (i : ℕ), ⟨i, rfl⟩, ?_⟩
      simp [X_pow_eq_monomial]
    · rintro ⟨d, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, by simp [X_pow_eq_monomial]⟩
  rw [hspan, MvPolynomial.mem_ideal_span_monomial_image]
  constructor
  · intro hp d hd
    obtain ⟨s, ⟨i, rfl⟩, hs⟩ := hp d hd
    exact ⟨i, by simpa using hs i⟩
  · intro hp d hd
    obtain ⟨i, hi⟩ := hp d hd
    refine ⟨Finsupp.single i (i : ℕ), ⟨i, rfl⟩, ?_⟩
    intro j
    by_cases hj : j = i
    · subst hj
      simpa using hi
    · simp [hj]

/-- Helper for Example 10.32.2: the monomial `X_(n+1)^n` is not killed by `variablePowerIdeal k`. -/
lemma succ_variable_pow_not_mem_variablePowerIdeal (n : ℕ) :
    ((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n) ∉ variablePowerIdeal k := by
  intro hmem
  have hsupport :=
    (variablePowerIdeal_mem_iff_support (k := k)
      ((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n)).1 hmem
  have hsingle :
      Finsupp.single (Nat.succPNat n) n ∈
        (((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n).support) := by
    simpa [X_pow_eq_monomial, one_ne_zero]
  obtain ⟨i, hi⟩ := hsupport (Finsupp.single (Nat.succPNat n) n) hsingle
  by_cases hni : i = Nat.succPNat n
  · subst hni
    simpa [Nat.succPNat_coe] using hi
  · have hizero : (i : ℕ) ≤ 0 := by
      simpa [Finsupp.single_apply, hni] using hi
    have hipos : 0 < (i : ℕ) := i.2
    omega

/-- Helper for Example 10.32.2: an exponent survives exactly when each coordinate stays below
its killing power. -/
def variablePowerIdeal_survives (d : ℕ+ →₀ ℕ) : Prop :=
  ∀ i : ℕ+, d i < (i : ℕ)

/-- Helper for Example 10.32.2: keep only the monomials whose exponents survive the defining
ideal. -/
def variablePowerIdeal_survivorPart (p : MvPolynomial ℕ+ k) : MvPolynomial ℕ+ k :=
  letI : DecidablePred variablePowerIdeal_survives := Classical.decPred _
  ∑ d ∈ p.support,
    if variablePowerIdeal_survives d then monomial d (p.coeff d) else 0

/-- Helper for Example 10.32.2: a surviving exponent keeps its original coefficient. -/
lemma variablePowerIdeal_survivorPart_coeff_of_survives
    (p : MvPolynomial ℕ+ k) {d : ℕ+ →₀ ℕ} (hd : variablePowerIdeal_survives d) :
    coeff d (variablePowerIdeal_survivorPart (k := k) p) = p.coeff d := by
  classical
  -- Compute the coefficient from the defining support sum and isolate the unique matching monomial.
  dsimp [variablePowerIdeal_survivorPart]
  rw [MvPolynomial.coeff_sum]
  by_cases hdp : d ∈ p.support
  · rw [Finset.sum_eq_single d]
    · simp [hd]
    · intro e he hed
      by_cases hs : variablePowerIdeal_survives e
      · simp [hs, hed]
      · simp [hs]
    · intro hd_not_mem
      exact (hd_not_mem hdp).elim
  · have hcoeff : p.coeff d = 0 := by
      simpa using (MvPolynomial.notMem_support_iff.mp hdp)
    rw [hcoeff]
    refine Finset.sum_eq_zero ?_
    intro e he
    by_cases hed : e = d
    · exact (hdp <| by simpa [hed] using he).elim
    · by_cases hs : variablePowerIdeal_survives e
      · simp [hs, hed]
      · simp [hs]

/-- Helper for Example 10.32.2: a non-surviving exponent is deleted by the survivor projection. -/
lemma variablePowerIdeal_survivorPart_coeff_of_not_survives
    (p : MvPolynomial ℕ+ k) {d : ℕ+ →₀ ℕ} (hd : ¬ variablePowerIdeal_survives d) :
    coeff d (variablePowerIdeal_survivorPart (k := k) p) = 0 := by
  classical
  -- Every monomial contributing to the `d`-coefficient is either indexed by `d` and killed, or
  -- indexed by another exponent and has zero `d`-coefficient.
  dsimp [variablePowerIdeal_survivorPart]
  rw [MvPolynomial.coeff_sum]
  refine Finset.sum_eq_zero ?_
  intro e he
  by_cases hed : e = d
  · subst hed
    simp [hd]
  · by_cases hs : variablePowerIdeal_survives e
    · simp [hs, hed]
    · simp [hs]

/-- Helper for Example 10.32.2: the survivor projection of zero is zero. -/
lemma variablePowerIdeal_survivorPart_zero :
    variablePowerIdeal_survivorPart (k := k) (0 : MvPolynomial ℕ+ k) = 0 := by
  classical
  simp [variablePowerIdeal_survivorPart]

/-- Helper for Example 10.32.2: the survivor projection vanishes exactly on the defining ideal. -/
lemma variablePowerIdeal_survivorPart_eq_zero_iff (p : MvPolynomial ℕ+ k) :
    variablePowerIdeal_survivorPart (k := k) p = 0 ↔ p ∈ variablePowerIdeal k := by
  constructor
  · intro hzero
    -- A support monomial with nonzero coefficient cannot survive if the survivor projection is zero.
    rw [variablePowerIdeal_mem_iff_support]
    intro d hd
    have hd_coeff : p.coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
    have hcoeff_zero :
        coeff d (variablePowerIdeal_survivorPart (k := k) p) = 0 := by
      simpa [hzero] using congrArg (MvPolynomial.coeff d) hzero
    have hnot_survives : ¬ variablePowerIdeal_survives d := by
      intro hsurvives
      have : p.coeff d = 0 := by
        simpa [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p hsurvives] using
          hcoeff_zero
      exact hd_coeff this
    by_contra hno_witness
    apply hnot_survives
    intro i
    exact lt_of_not_ge fun hi ↦ hno_witness ⟨i, hi⟩
  · intro hmem
    -- If every support monomial violates the survivor condition, every survivor coefficient is zero.
    apply MvPolynomial.ext
    intro d
    by_cases hd : variablePowerIdeal_survives d
    · rw [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p hd]
      by_contra hcoeff
      have hd_mem : d ∈ p.support := MvPolynomial.mem_support_iff.mpr hcoeff
      obtain ⟨i, hi⟩ :=
        (variablePowerIdeal_mem_iff_support (k := k) p).1 hmem d hd_mem
      exact (Nat.not_le_of_lt (hd i)) hi
    · rw [variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) p hd,
        MvPolynomial.coeff_zero]

/-- Helper for Example 10.32.2: a surviving sum forces both summands to survive. -/
lemma survivor_of_add {u v d : ℕ+ →₀ ℕ}
    (hadd : u + v = d) (hd : variablePowerIdeal_survives d) :
    variablePowerIdeal_survives u ∧ variablePowerIdeal_survives v := by
  constructor
  · intro i
    have hsum : (u + v) i < (i : ℕ) := by
      simpa [hadd] using hd i
    have hsum' : u i + v i < (i : ℕ) := by
      simpa [Finsupp.add_apply] using hsum
    exact lt_of_le_of_lt (Nat.le_add_right (u i) (v i)) hsum'
  · intro i
    have hsum : (u + v) i < (i : ℕ) := by
      simpa [hadd] using hd i
    have hsum' : u i + v i < (i : ℕ) := by
      simpa [Finsupp.add_apply] using hsum
    exact lt_of_le_of_lt (by simpa [add_comm] using Nat.le_add_right (v i) (u i)) hsum'

/-- Helper for Example 10.32.2: the survivor projection is additive. -/
lemma variablePowerIdeal_survivorPart_add (p₁ p₂ : MvPolynomial ℕ+ k) :
    variablePowerIdeal_survivorPart (k := k) (p₁ + p₂) =
      variablePowerIdeal_survivorPart (k := k) p₁ + variablePowerIdeal_survivorPart (k := k) p₂ := by
  -- Compare coefficients: the survivor projection keeps the same survivor test on each summand.
  apply MvPolynomial.ext
  intro d
  by_cases hd : variablePowerIdeal_survives d
  · rw [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) (p₁ + p₂) hd,
      MvPolynomial.coeff_add, MvPolynomial.coeff_add,
      variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p₁ hd,
      variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p₂ hd]
  · rw [variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) (p₁ + p₂) hd,
      MvPolynomial.coeff_add,
      variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) p₁ hd,
      variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) p₂ hd]
    simp

/-- Helper for Example 10.32.2: multiplying on the left only depends on the survivor part of the
right factor. -/
lemma variablePowerIdeal_survivorPart_mul_congr {p₁ p₂ a : MvPolynomial ℕ+ k}
    (h : variablePowerIdeal_survivorPart (k := k) p₁ =
      variablePowerIdeal_survivorPart (k := k) p₂) :
    variablePowerIdeal_survivorPart (k := k) (a * p₁) =
      variablePowerIdeal_survivorPart (k := k) (a * p₂) := by
  -- Route correction: instead of a coarse quotient argument, compare survivor coefficients of the
  -- product directly and use that a surviving output exponent has surviving right summands.
  apply MvPolynomial.ext
  intro d
  by_cases hd : variablePowerIdeal_survives d
  · rw [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) (a * p₁) hd,
      variablePowerIdeal_survivorPart_coeff_of_survives (k := k) (a * p₂) hd]
    rw [MvPolynomial.coeff_mul, MvPolynomial.coeff_mul]
    refine Finset.sum_congr rfl ?_
    intro uv huv
    have huv_eq : uv.1 + uv.2 = d := by
      simpa [Finset.mem_antidiagonal] using huv
    have huv_survives : variablePowerIdeal_survives uv.2 :=
      (survivor_of_add (hadd := huv_eq) hd).2
    have hcoeff := congrArg (MvPolynomial.coeff uv.2) h
    rw [variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p₁ huv_survives,
      variablePowerIdeal_survivorPart_coeff_of_survives (k := k) p₂ huv_survives] at hcoeff
    simp [hcoeff]
  · rw [variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) (a * p₁) hd,
      variablePowerIdeal_survivorPart_coeff_of_not_survives (k := k) (a * p₂) hd]

/-- Helper for Example 10.32.2: the survivor projection is constant along the generated quotient
relation. -/
lemma variablePowerIdeal_survivorPart_congr_rel
    {p₁ p₂ : MvPolynomial ℕ+ k}
    (h :
      RingConGen.Rel
        (fun f g : MvPolynomial ℕ+ k ↦ f ∈ variablePowerIdeal k ∧ g = 0) p₁ p₂) :
    variablePowerIdeal_survivorPart (k := k) p₁ =
      variablePowerIdeal_survivorPart (k := k) p₂ := by
  -- Induct over the generated congruence and discharge each constructor with the survivor API.
  induction h
  case of x y hxy =>
      rcases hxy with ⟨hx, hy⟩
      subst hy
      have hx_zero : variablePowerIdeal_survivorPart (k := k) x = 0 :=
        (variablePowerIdeal_survivorPart_eq_zero_iff (k := k) x).2 hx
      simpa [variablePowerIdeal_survivorPart_zero (k := k)] using hx_zero
  case refl x =>
      rfl
  case symm h ih =>
      exact ih.symm
  case trans h₁ h₂ ih₁ ih₂ =>
      exact ih₁.trans ih₂
  case add w x y z h₁ h₂ ih₁ ih₂ =>
      calc
        variablePowerIdeal_survivorPart (k := k) (w + y) =
            variablePowerIdeal_survivorPart (k := k) w +
              variablePowerIdeal_survivorPart (k := k) y :=
          variablePowerIdeal_survivorPart_add (k := k) w y
        _ =
            variablePowerIdeal_survivorPart (k := k) x +
              variablePowerIdeal_survivorPart (k := k) z := by rw [ih₁, ih₂]
        _ = variablePowerIdeal_survivorPart (k := k) (x + z) :=
          (variablePowerIdeal_survivorPart_add (k := k) x z).symm
  case mul w x y z h₁ h₂ ih₁ ih₂ =>
      have hleft :
          variablePowerIdeal_survivorPart (k := k) (w * y) =
            variablePowerIdeal_survivorPart (k := k) (x * y) := by
        simpa [mul_comm] using
          variablePowerIdeal_survivorPart_mul_congr (k := k) (a := y) ih₁
      have hright :
          variablePowerIdeal_survivorPart (k := k) (x * y) =
            variablePowerIdeal_survivorPart (k := k) (x * z) :=
          variablePowerIdeal_survivorPart_mul_congr (k := k) (a := x) ih₂
      exact hleft.trans hright

/-- Helper for Example 10.32.2: the class of `X_(n+1)^n` survives in the quotient. -/
lemma succ_variable_pow_class_ne_zero (n : ℕ) :
    q (((X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n)) ≠ 0 := by
  intro hzero
  let p : MvPolynomial ℕ+ k := (X (Nat.succPNat n) : MvPolynomial ℕ+ k) ^ n
  let r : MvPolynomial ℕ+ k → MvPolynomial ℕ+ k → Prop :=
    fun f g ↦ f ∈ variablePowerIdeal k ∧ g = 0
  -- Convert quotient equality to the generated congruence and then to vanishing survivor part.
  have hrel_eqv : Relation.EqvGen (RingQuot.Rel r) p 0 := by
    exact Quot.eqvGen_exact (by simpa [p, r, RingQuot.mkRingHom_def] using congrArg RingQuot.toQuot hzero)
  have hrel : RingConGen.Rel r p 0 := by
    rw [← RingQuot.eqvGen_rel_eq]
    exact hrel_eqv
  have hsurvivor :
      variablePowerIdeal_survivorPart (k := k) p =
        variablePowerIdeal_survivorPart (k := k) 0 :=
    variablePowerIdeal_survivorPart_congr_rel (k := k) hrel
  have hp_mem : p ∈ variablePowerIdeal k := by
    rw [← variablePowerIdeal_survivorPart_eq_zero_iff (k := k) p]
    simpa [variablePowerIdeal_survivorPart_zero (k := k)] using hsurvivor
  exact succ_variable_pow_not_mem_variablePowerIdeal (k := k) n hp_mem

-- Proof sketch: each generator of `quotientVariableIdeal k` is nilpotent in the quotient, so
-- `quotientVariableIdeal k` is a locally nilpotent ideal. But the image of `X (n + 1)` has
-- nonzero `n`th power for every `n`, so no power of `quotientVariableIdeal k` is zero.
/-- Example 10.32.2: if `R = k[X_n | n ∈ ℕ+]`, `I` is generated by the powers `X n ^ n`, and
`J` is the ideal of `R ⧸ I` generated by the images of the variables, then `J` is locally
nilpotent but not nilpotent. -/
theorem quotient_variable_ideal_locally_nilpotent_not_nilpotent :
    (quotientVariableIdeal k).IsLocallyNilpotent ∧ ¬ IsNilpotent (quotientVariableIdeal k) :=
  by
  constructor
  · -- Pull an element of the image ideal back to `idealOfVars`, then decompose it into support
    -- monomials, each of which carries a nilpotent variable factor.
    rw [Ideal.isLocallyNilpotent_iff]
    intro z hz
    obtain ⟨p, hp, rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective q (RingQuot.mkRingHom_surjective _)).mp hz
    have hp' : p ∈ Ideal.span (X '' (Set.univ : Set ℕ+)) := by
      simpa [idealOfVars, Set.image_univ] using hp
    have hsupport : ∀ m ∈ p.support, ∃ i : ℕ+, m i ≠ 0 := by
      simpa using
        (MvPolynomial.mem_ideal_span_X_image (R := k) (σ := ℕ+) (x := p) (s := Set.univ)).mp hp'
    rw [p.as_sum, map_sum]
    apply isNilpotent_sum
    intro m hm
    obtain ⟨i, hi⟩ := hsupport m hm
    exact quotient_monomial_isNilpotent_of_support (k := k)
      (m := m) (a := p.coeff m) (i := i) <| by
        simpa [Finsupp.mem_support_iff] using hi
  · -- The class of `X_(n+1)^n` lies in `J^n` and stays nonzero for every `n`.
    intro hnil
    obtain ⟨n, hn⟩ := hnil
    let i : ℕ+ := Nat.succPNat n
    have hxJ : q (X i : MvPolynomial ℕ+ k) ∈ quotientVariableIdeal k := by
      exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
    have hpowmem : q ((X i : MvPolynomial ℕ+ k) ^ n) ∈ quotientVariableIdeal k ^ n := by
      simpa [map_pow] using Ideal.pow_mem_pow hxJ n
    have hzero : q ((X i : MvPolynomial ℕ+ k) ^ n) = 0 := by
      simpa [hn] using hpowmem
    exact succ_variable_pow_class_ne_zero (k := k) n hzero

end

end

/-! ### Lemma_10_32_3 (from Chap10) -/
universe u v

section

variable {R : Type u} {R' : Type v} [CommSemiring R] [CommSemiring R']

namespace Ideal

/-
Domain triage:
- primary domain: commutative algebra of ideals, nilradicals, and extension along ring maps;
- sampled owner declarations: `Ideal.IsLocallyNilpotent`, `Ideal.map_radical_le`,
  `Ideal.map_mono`;
- best owner abstraction: local nilpotence is the canonical containment `I ≤ nilradical R`, so the
  source-facing statement here is a `bridge/view` theorem transporting that containment across
  `Ideal.map`;
- primitive data: a ring homomorphism `f : R →+* R'` and an ideal `I : Ideal R`;
  derived API: `I.IsLocallyNilpotent`.
-/
/-- Lemma 10.32.3: the extension of a locally nilpotent ideal along a ring map is again locally
nilpotent. This is a `bridge/view` theorem from the chapter vocabulary
`Ideal.IsLocallyNilpotent` to the canonical owner lemma `Ideal.map_radical_le`. -/
theorem map_isLocallyNilpotent (f : R →+* R') {I : Ideal R}
    (hI : I.IsLocallyNilpotent) : (I.map f).IsLocallyNilpotent :=
  (map_mono hI).trans <| by
    simpa using (⊥ : Ideal R).map_radical_le f

end Ideal

end

/-! ### Lemma_10_32_4 (from Chap10) -/
universe u

section

variable {R : Type u} [CommRing R]

/-- Lemma 10.32.4: if `I` is locally nilpotent, then an element of `R` is a unit exactly when
its image in the quotient ring `R ⧸ I` is a unit.

This is a `bridge/view` theorem: the source-facing hypothesis `I.IsLocallyNilpotent` supplies the
owner abstraction `IsLocalHom (Ideal.Quotient.mk I)` via the Jacobson-radical criterion, and the
statement then follows from `isUnit_map_iff`. -/
theorem isUnit_iff_isUnit_quotient_mk_of_isLocallyNilpotent (I : Ideal R)
    (hI : I.IsLocallyNilpotent) {x : R} :
    IsUnit x ↔ IsUnit (Ideal.Quotient.mk I x) := by
  have hIjac : I ≤ Ideal.jacobson ⊥ := by
    simpa [Ideal.jacobson_bot] using le_trans hI (nilradical_le_jacobson R)
  let _ : IsLocalHom (Ideal.Quotient.mk I) :=
    isLocalHom_of_le_jacobson_bot I hIjac
  exact (isUnit_map_iff (Ideal.Quotient.mk I) x).symm

end

/-! ### Lemma_10_32_5 (from Chap10) -/
universe u

section

variable {R : Type u} [CommSemiring R] [IsNoetherianRing R]

namespace Ideal

/-- Lemma 10.32.5 (1): in a Noetherian ring, the owner theorem
`Ideal.exists_pow_le_of_le_radical_of_fg` applies to every ideal. -/
theorem exists_pow_le_of_le_radical_of_isNoetherianRing {I J : Ideal R} (hJI : J ≤ I.radical) :
    ∃ n : ℕ, J ^ n ≤ I :=
  exists_pow_le_of_le_radical_of_fg hJI J.fg_of_isNoetherianRing

/-- Lemma 10.32.5 (2), textbook wording: in a Noetherian ring, each element of an ideal is
nilpotent if and only if the ideal itself is nilpotent. This is the source-facing bridge from the
chapter notion `I.IsLocallyNilpotent` to the owner theorem `FG.isNilpotent_iff_le_nilradical`. -/
theorem forall_mem_isNilpotent_iff_isNilpotent (I : Ideal R) :
    (∀ x ∈ I, IsNilpotent x) ↔ IsNilpotent I := by
  rw [← isLocallyNilpotent_iff I]
  simpa [IsLocallyNilpotent] using
    (FG.isNilpotent_iff_le_nilradical I.fg_of_isNoetherianRing).symm

end Ideal

end

/-! ### Lemma_10_32_6 (from Chap10) -/
universe u

section

variable {R : Type u} [CommRing R]

namespace RingHom

/-- If the kernel of a ring map is locally nilpotent, then every idempotent in the image lifts
uniquely to an idempotent in the source. This is the chapter-level `bridge/view` from the
source-facing kernel condition `(ker f).IsLocallyNilpotent` to the canonical mathlib owner theorem
`existsUnique_isIdempotentElem_eq_of_ker_isNilpotent`. -/
theorem existsUnique_isIdempotentElem_eq_of_ker_isLocallyNilpotent
    {S : Type u} [Ring S] (f : R →+* S) (hker : (ker f).IsLocallyNilpotent)
    (e : S) (he : e ∈ f.range) (he' : IsIdempotentElem e) :
    ∃! e' : R, IsIdempotentElem e' ∧ f e' = e := by
  refine existsUnique_isIdempotentElem_eq_of_ker_isNilpotent f ?_ e he he'
  simpa [Ideal.mk_ker] using (Ideal.isLocallyNilpotent_iff (ker f)).mp hker

end RingHom

/-- Lemma 10.32.6: if `I` is locally nilpotent, then the quotient map `R → R ⧸ I` induces a
bijection on idempotents. This is the `source-facing` quotient statement; the unique-lift
formulation is a companion obtained by unpacking this induced map on the canonical idempotent
subtype. -/
theorem quotientMap_idempotents_bijective_of_isLocallyNilpotent {I : Ideal R}
    (hI : I.IsLocallyNilpotent) :
    Function.Bijective (Ideal.Quotient.mk I).idempotentMap := by
  constructor
  · intro e₁ e₂ h
    apply Subtype.ext
    obtain ⟨e, he, huniq⟩ :=
      RingHom.existsUnique_isIdempotentElem_eq_of_ker_isLocallyNilpotent
        (Ideal.Quotient.mk I) (by simpa [Ideal.mk_ker] using hI) (Ideal.Quotient.mk I e₁.1)
        (Ideal.Quotient.mk_surjective _) (e₁.2.map (Ideal.Quotient.mk I))
    exact (huniq _ ⟨e₁.2, rfl⟩).trans
      (huniq _ ⟨e₂.2, by simpa using (congrArg Subtype.val h).symm⟩).symm
  · intro e
    obtain ⟨e', he', -⟩ :=
      RingHom.existsUnique_isIdempotentElem_eq_of_ker_isLocallyNilpotent
        (Ideal.Quotient.mk I) (by simpa [Ideal.mk_ker] using hI) e.1
        (Ideal.Quotient.mk_surjective _) e.2
    refine ⟨⟨e', he'.1⟩, ?_⟩
    exact Subtype.ext he'.2

/-- Companion formulation of Lemma 10.32.6: bijectivity of the quotient-induced map on
idempotents means precisely that every idempotent of `R ⧸ I` has a unique idempotent lift to
`R`. -/
theorem existsUnique_idempotent_lift_quotient_of_isLocallyNilpotent {I : Ideal R}
    (hI : I.IsLocallyNilpotent) (e : R ⧸ I) (he : IsIdempotentElem e) :
    ∃! e' : R, IsIdempotentElem e' ∧ Ideal.Quotient.mk I e' = e := by
  have hbij : Function.Bijective (Ideal.Quotient.mk I).idempotentMap :=
    quotientMap_idempotents_bijective_of_isLocallyNilpotent hI
  obtain ⟨e', he'⟩ := hbij.2 ⟨e, he⟩
  refine ⟨e'.1, ⟨e'.2, by simpa using congrArg Subtype.val he'⟩, ?_⟩
  intro y hy
  have hy' : (Ideal.Quotient.mk I).idempotentMap ⟨y, hy.1⟩ = ⟨e, he⟩ := by
    exact Subtype.ext hy.2
  exact (congrArg Subtype.val <| hbij.1 (he'.trans hy'.symm)).symm

end

/-! ### Lemma_10_32_7 (from Chap10) -/
open Polynomial

universe u

section

variable {A : Type u} [Ring A]

/-- Helper for Lemma 10.32.7: in a commutative ring, the principal ideal generated by a nilpotent
element is locally nilpotent. -/
lemma span_singleton_isLocallyNilpotent_of_isNilpotent {R : Type*} [CommRing R] {x : R}
    (hx : IsNilpotent x) : (Ideal.span ({x} : Set R)).IsLocallyNilpotent := by
  -- Local nilpotence is checked elementwise, and every element of a principal ideal is a multiple
  -- of the generator.
  rw [Ideal.isLocallyNilpotent_iff]
  intro y hy
  obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton.mp hy
  obtain ⟨n, hn⟩ := hx
  refine ⟨n, ?_⟩
  simp [mul_pow, hn]

/-- Helper for Lemma 10.32.7: in the universal quotient by `((X^2 - X)^n)`, the defect class of
`X` is nilpotent. -/
lemma universal_idempotency_defect_nilpotent (n : ℕ) :
    let P : ℤ[X] := X ^ 2 - X
    let J : Ideal ℤ[X] := Ideal.span ({P ^ n} : Set ℤ[X])
    (Ideal.Quotient.mk J P : ℤ[X] ⧸ J) ^ n = 0 := by
  intro P J
  -- The quotient relation is exactly the vanishing of `(X^2 - X)^n`.
  calc
    (Ideal.Quotient.mk J P : ℤ[X] ⧸ J) ^ n = Ideal.Quotient.mk J (P ^ n) := by
      simp
    _ = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))

/-- Helper for Lemma 10.32.7: modulo the principal ideal generated by its defect `e^2 - e`, an
element becomes idempotent. -/
lemma quotient_mk_isIdempotentElem_of_span_idempotency_defect {R : Type*} [CommRing R] (e : R) :
    IsIdempotentElem (Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) e) := by
  -- The idempotency defect vanishes in the quotient by the ideal it generates.
  rw [IsIdempotentElem]
  apply sub_eq_zero.mp
  calc
    Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) e *
        Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) e -
        Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) e =
      Ideal.Quotient.mk (Ideal.span ({e ^ 2 - e} : Set R)) (e ^ 2 - e) := by
        simp [pow_two]
    _ = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)

/-- Lemma 10.32.7: if `x = e^2 - e` is nilpotent in a possibly noncommutative ring, then `e` can
be corrected to an idempotent by adding `x` times an integer polynomial in `e`.

Layer triage:
- `source-facing`: the corrected element is exhibited explicitly as `e + (e^2 - e) q(e)`.
- `core/canonical`: idempotent lifting across a nilpotent kernel, owned upstream by
  `RingHom.exists_isIdempotentElem_eq_of_ker_isNilpotent` and exposed in this chapter through
  [Lemma_10_32_6](/volume/math/AI4M/users/zcwang/StacksProject_2024/StacksProject_2024/Items/Chap10/Lemma_10_32_6.lean).
- `bridge/view`: this theorem converts the canonical lift into the textbook polynomial-correction
  form, using the owner polynomial ring `ℤ[X]` with its canonical evaluation map `aeval` rather
  than a bespoke package of coefficients. -/
-- Proof sketch: if `x := e^2 - e` is nilpotent, choose `n` with `x ^ n = 0` and quotient by the
-- nilpotent ideal generated by `x`. The image of `e` is idempotent in that quotient, so Lemma
-- `10.32.6` lifts it to an idempotent lying over the same class. Since the lift differs from `e`
-- by an element of the ideal generated by `x`, it has the form `e + x * q(e)` for some
-- `q : ℤ[X]`.
theorem exists_idempotent_eq_add_idempotency_defect_polynomial (e : A)
    (hx : IsNilpotent (e ^ 2 - e)) :
    ∃ q : ℤ[X], IsIdempotentElem (e + (e ^ 2 - e) * aeval e q) := by
  obtain ⟨n, hxn⟩ := hx
  let P : ℤ[X] := X ^ 2 - X
  let J : Ideal ℤ[X] := Ideal.span ({P ^ n} : Set ℤ[X])
  let ebar : ℤ[X] ⧸ J := Ideal.Quotient.mk J X
  let xbar : ℤ[X] ⧸ J := Ideal.Quotient.mk J P
  let I : Ideal (ℤ[X] ⧸ J) := Ideal.span ({xbar} : Set (ℤ[X] ⧸ J))
  have hxbar_nilpotent : IsNilpotent xbar := by
    -- The universal quotient imposes the relation `(X^2 - X)^n = 0`.
    refine ⟨n, ?_⟩
    simpa [P, J, xbar] using universal_idempotency_defect_nilpotent n
  have hI : I.IsLocallyNilpotent := by
    -- The defect ideal in the universal commutative quotient is principal and generated by a
    -- nilpotent element.
    simpa [I] using
      span_singleton_isLocallyNilpotent_of_isNilpotent (x := xbar) hxbar_nilpotent
  have hebar_mod : IsIdempotentElem (Ideal.Quotient.mk I ebar) := by
    -- Modding out by the defect ideal makes the class of `X` idempotent.
    simpa [I, xbar, P, ebar] using
      quotient_mk_isIdempotentElem_of_span_idempotency_defect (e := ebar)
  obtain ⟨ebar', hebar', -⟩ :=
    existsUnique_idempotent_lift_quotient_of_isLocallyNilpotent hI
      (Ideal.Quotient.mk I ebar) hebar_mod
  have hdiff_mem : ebar' - ebar ∈ I := by
    -- The lifted idempotent has the same image as `ebar`, so their difference lies in the defect
    -- ideal.
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem ebar' ebar).mp hebar'.2
  obtain ⟨qbar, hqbar⟩ := Ideal.mem_span_singleton.mp hdiff_mem
  obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective qbar
  let ψ : ℤ[X] →+* A := (aeval e).toRingHom
  have hJzero : ∀ p : ℤ[X], p ∈ J → ψ p = 0 := by
    -- Evaluation at `e` kills the universal relation because `(e^2 - e)^n = 0`.
    intro p hp
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton.mp hp
    simp [ψ, P, hxn]
  let φ : ℤ[X] ⧸ J →+* A := Ideal.Quotient.lift J ψ hJzero
  have hφ_ebar : φ ebar = e := by
    -- The factor map agrees with evaluation on the class of `X`.
    simp [φ, ebar, ψ]
  have hφ_xbar : φ xbar = e ^ 2 - e := by
    -- The factor map also agrees with evaluation on the idempotency defect polynomial.
    simp [φ, xbar, P, ψ]
  have hebar'_eq : ebar' = ebar + xbar * qbar := by
    -- The difference computation rewrites the lifted idempotent into the required correction form.
    rw [sub_eq_iff_eq_add] at hqbar
    simpa [add_comm, add_left_comm, add_assoc] using hqbar
  have hφ_ebar' : φ ebar' = e + (e ^ 2 - e) * aeval e q := by
    -- Evaluating the universal correction polynomial gives the desired explicit element of `A`.
    calc
      φ ebar' = φ (ebar + xbar * qbar) := by rw [hebar'_eq]
      _ = φ ebar + φ xbar * φ qbar := by simp
      _ = e + (e ^ 2 - e) * aeval e q := by
        rw [hφ_ebar, hφ_xbar, ← hq]
        simp [φ, ψ]
  refine ⟨q, ?_⟩
  -- The universal idempotent stays idempotent after applying the factor map.
  simpa [hφ_ebar'] using hebar'.1.map φ

end

/-! ### Lemma_10_32_8 (from Chap10) -/
universe u

section

open Ideal.Quotient

variable {R : Type u} [CommRing R]

private theorem exists_pow_eq_iff_exists_pow_eq_unit {A : Type u} [CommRing A]
    {n : ℕ} (hn : 1 ≤ n) {a : A} (ha : IsUnit a) :
    (∃ b : A, b ^ n = a) ↔ ∃ u : Aˣ, u ^ n = ha.unit := by
  constructor
  · rintro ⟨b, hb⟩
    have hb_pow_unit : IsUnit (b ^ n) := by
      simpa [hb] using ha
    have hb_unit : IsUnit b :=
      (isUnit_pow_iff (Nat.one_le_iff_ne_zero.mp hn)).mp hb_pow_unit
    refine ⟨hb_unit.unit, ?_⟩
    apply Units.ext
    change ((hb_unit.unit : A) ^ n) = a
    simp [hb]
  · rintro ⟨u, hu⟩
    refine ⟨(u : A), ?_⟩
    simpa [ha.unit_spec] using congrArg (fun v : Aˣ ↦ (v : A)) hu

private theorem one_add_pow_sub_one_mem (I : Ideal R) (n : ℕ) (x : I) :
    (1 + (x : R)) ^ n - 1 ∈ I := by
  rw [← eq_zero_iff_mem]
  have hx0 : mk I (x : R) = 0 := eq_zero_iff_mem.mpr x.property
  simp [hx0]

/-- Helper for Lemma 10.32.8: if `n` becomes a unit modulo a locally nilpotent ideal, then `n`
is already a unit in the ambient ring. -/
private theorem nat_cast_isUnit_of_isUnit_quotient_nat_cast (I : Ideal R)
    (hI : I.IsLocallyNilpotent) {n : ℕ} (hn_unit : IsUnit (n : R ⧸ I)) :
    IsUnit (n : R) :=
  (isUnit_iff_isUnit_quotient_mk_of_isLocallyNilpotent I hI).2 hn_unit

/-- Helper for Lemma 10.32.8: elements of the form `1 + x` with `x ∈ I` lie in `I.oneAdd`. -/
private theorem one_add_mem_oneAdd (I : Ideal R) (x : I) :
    1 + (x : R) ∈ I.oneAdd :=
  (Ideal.mem_oneAdd_iff).2 ⟨x, x.property, rfl⟩

/-- Helper for Lemma 10.32.8: if `u ∈ 1 + I`, then `u - 1` lies in `I`. -/
private theorem sub_one_mem_of_mem_oneAdd (I : Ideal R) {u : R} (hu : u ∈ I.oneAdd) :
    u - 1 ∈ I := by
  rcases (Ideal.mem_oneAdd_iff).1 hu with ⟨x, hx, rfl⟩
  simpa using hx

/-- Helper for Lemma 10.32.8: an element whose difference from `1` lies in `I` belongs to
`I.oneAdd`. -/
private theorem mem_oneAdd_of_sub_one_mem (I : Ideal R) {u : R} (hu : u - 1 ∈ I) :
    u ∈ I.oneAdd := by
  have hu_eq : u = 1 + (u - 1) := by
    ring
  exact (Ideal.mem_oneAdd_iff).2 ⟨u - 1, hu, hu_eq⟩

/-- Helper for Lemma 10.32.8: if the quotient of `u` is `1`, then `u` lies in `1 + I`. -/
private theorem mem_oneAdd_of_quotient_eq_one (I : Ideal R) {u : R}
    (hu : mk I u = 1) : u ∈ I.oneAdd := by
  have hu_sub : u - 1 ∈ I := by
    apply (Ideal.Quotient.eq_zero_iff_mem).mp
    simpa [map_sub, hu]
  exact mem_oneAdd_of_sub_one_mem I hu_sub

/-- Helper for Lemma 10.32.8: elements of `1 + I` map to `1` in the quotient. -/
private theorem quotient_mk_eq_one_of_mem_oneAdd (I : Ideal R) {u : R} (hu : u ∈ I.oneAdd) :
    mk I u = 1 := by
  rcases (Ideal.mem_oneAdd_iff).1 hu with ⟨x, hx, rfl⟩
  have hx0 : mk I x = 0 := (Ideal.Quotient.eq_zero_iff_mem).2 hx
  simp [hx0]

/-- Helper for Lemma 10.32.8: elements of `1 + I` are nilpotently close to `1`. -/
private theorem isNilpotent_one_sub_of_mem_oneAdd (I : Ideal R)
    (hI : I.IsLocallyNilpotent) {u : R} (hu : u ∈ I.oneAdd) :
    IsNilpotent (1 - u) := by
  rcases (Ideal.mem_oneAdd_iff).1 hu with ⟨x, hx, rfl⟩
  have hxnil : IsNilpotent x := (Ideal.isLocallyNilpotent_iff I).1 hI x hx
  simpa using hxnil.neg

/-- Helper for Lemma 10.32.8: in the quotient, an `n`th root of `1` that is nilpotently close to
`1` must equal `1`. -/
private theorem quotient_eq_one_of_pow_eq_one_of_isNilpotent_sub_one (I : Ideal R)
    {n : ℕ} (_hn : 1 ≤ n) (hn_unit : IsUnit (n : R ⧸ I)) {q : R ⧸ I}
    (hqpow : q ^ n = 1) (hqnil : IsNilpotent (1 - q)) :
    q = 1 := by
  let P : Polynomial (R ⧸ I) := Polynomial.X ^ n - Polynomial.C (1 : R ⧸ I)
  -- Apply the Newton uniqueness theorem at the base point `1`.
  have hnil : IsNilpotent ((Polynomial.aeval (1 : R ⧸ I)) P) := by
    simpa [P, Polynomial.aeval_X_pow] using (isNilpotent_zero : IsNilpotent (0 : R ⧸ I))
  have hderiv : IsUnit ((Polynomial.aeval (1 : R ⧸ I)) (Polynomial.derivative P)) := by
    simpa [P, Polynomial.derivative_X_pow, Polynomial.aeval_X_pow] using hn_unit
  obtain ⟨r, hr, huniq⟩ :=
    Polynomial.existsUnique_nilpotent_sub_and_aeval_eq_zero (x := (1 : R ⧸ I)) (P := P) hnil
      hderiv
  have hqroot : IsNilpotent (1 - q) ∧ Polynomial.aeval q P = 0 := by
    refine ⟨hqnil, ?_⟩
    simpa [P, hqpow] using (sub_eq_zero.mpr hqpow)
  have hone : IsNilpotent (1 - (1 : R ⧸ I)) ∧ Polynomial.aeval (1 : R ⧸ I) P = 0 := by
    refine ⟨?_, ?_⟩
    · simpa using (isNilpotent_zero : IsNilpotent (0 : R ⧸ I))
    · simp [P]
  exact (huniq q hqroot).trans (huniq 1 hone).symm

/-- Helper for Lemma 10.32.8: every element of `1 + I` has a unique `n`th root that still lies in
`1 + I`. -/
private theorem existsUnique_nth_root_mem_oneAdd_of_mem_oneAdd (I : Ideal R)
    (hI : I.IsLocallyNilpotent) {n : ℕ} (hn : 1 ≤ n)
    (hn_unit : IsUnit (n : R ⧸ I)) {u : R} (hu : u ∈ I.oneAdd) :
    ∃! v : R, v ^ n = u ∧ v ∈ I.oneAdd := by
  let P : Polynomial R := Polynomial.X ^ n - Polynomial.C u
  have hnR : IsUnit (n : R) :=
    nat_cast_isUnit_of_isUnit_quotient_nat_cast I hI hn_unit
  -- Newton produces a unique root that is nilpotently close to `1`.
  have hnil : IsNilpotent ((Polynomial.aeval (1 : R)) P) := by
    simpa [P, Polynomial.aeval_X_pow] using isNilpotent_one_sub_of_mem_oneAdd I hI hu
  have hderiv : IsUnit ((Polynomial.aeval (1 : R)) (Polynomial.derivative P)) := by
    simpa [P, Polynomial.derivative_X_pow, Polynomial.aeval_X_pow] using hnR
  obtain ⟨r, hr, huniq⟩ :=
    Polynomial.existsUnique_nilpotent_sub_and_aeval_eq_zero (x := (1 : R)) (P := P) hnil hderiv
  have hrpow : r ^ n = u := by
    exact sub_eq_zero.mp (by simpa [P] using hr.2)
  have hrmem : r ∈ I.oneAdd := by
    -- Route correction: the Newton theorem only gives `r` nilpotently close to `1`; to show
    -- `r ∈ 1 + I`, force its image in the quotient to equal `1` by the same uniqueness argument.
    have hqpow : mk I r ^ n = (1 : R ⧸ I) := by
      rw [← map_pow, hrpow, quotient_mk_eq_one_of_mem_oneAdd I hu]
    have hqnil : IsNilpotent (1 - mk I r) := by
      simpa [map_sub] using hr.1.map (mk I)
    have hqeq : mk I r = 1 :=
      quotient_eq_one_of_pow_eq_one_of_isNilpotent_sub_one I hn hn_unit hqpow hqnil
    exact mem_oneAdd_of_quotient_eq_one I hqeq
  refine ⟨r, ⟨hrpow, hrmem⟩, ?_⟩
  intro v hv
  -- Any competing root in `1 + I` is also nilpotently close to `1`, so Newton uniqueness applies.
  have hvnil : IsNilpotent (1 - v) := isNilpotent_one_sub_of_mem_oneAdd I hI hv.2
  have hvroot : Polynomial.aeval v P = 0 := by
    simpa [P, hv.1]
  exact huniq v ⟨hvnil, hvroot⟩

/-- Helper for Lemma 10.32.8: if a unit of `R` has an `n`th root modulo `I`, then it already has
an `n`th root in `R`. -/
private theorem exists_pow_eq_iff_exists_pow_eq_quotient_of_isLocallyNilpotent_aux
    (I : Ideal R) (hI : I.IsLocallyNilpotent) {n : ℕ} (hn : 1 ≤ n)
    (hn_unit : IsUnit (n : R ⧸ I)) {a : R} (ha : IsUnit a) :
    (∃ b : R, b ^ n = a) ↔ ∃ bbar : R ⧸ I, bbar ^ n = mk I a := by
  constructor
  · rintro ⟨b, hb⟩
    exact ⟨mk I b, by simpa [map_pow] using congrArg (mk I) hb⟩
  · rintro ⟨bbar, hbbar⟩
    obtain ⟨b0, rfl⟩ := Ideal.Quotient.mk_surjective bbar
    have hquot_unit : IsUnit (mk I b0) := by
      have hpow_unit : IsUnit ((mk I b0) ^ n) := by
        simpa [hbbar] using ha.map (mk I)
      exact (isUnit_pow_iff (Nat.one_le_iff_ne_zero.mp hn)).1 hpow_unit
    have hb0_unit : IsUnit b0 :=
      (isUnit_iff_isUnit_quotient_mk_of_isLocallyNilpotent I hI).2 hquot_unit
    let b : Rˣ := hb0_unit.unit
    have hb_eq : (b : R) = b0 := hb0_unit.unit_spec
    have hdiff : a - (b : R) ^ n ∈ I := by
      apply (Ideal.Quotient.eq_zero_iff_mem).mp
      simpa [map_sub, map_pow, hb_eq] using (sub_eq_zero.mpr hbbar.symm)
    let g : R := a * ↑((b⁻¹) ^ n)
    have hcancel_right : (b : R) ^ n * ↑((b⁻¹) ^ n) = 1 := by
      have hbase : (b : R) * ↑(b⁻¹) = 1 := by
        simp
      have hpow_eq : ((b : R) * ↑(b⁻¹)) ^ n = 1 := by
        simpa using congrArg (fun z : R ↦ z ^ n) hbase
      calc
        (b : R) ^ n * ↑((b⁻¹) ^ n) = ((b : R) * ↑(b⁻¹)) ^ n := by
          symm
          rw [mul_pow]
          rfl
        _ = 1 := hpow_eq
    have hcancel_left : ↑((b⁻¹) ^ n) * (b : R) ^ n = 1 := by
      have hbase : ↑(b⁻¹) * (b : R) = 1 := by
        simp
      have hpow_eq : (↑(b⁻¹) * (b : R)) ^ n = 1 := by
        simpa using congrArg (fun z : R ↦ z ^ n) hbase
      calc
        ↑((b⁻¹) ^ n) * (b : R) ^ n = (↑(b⁻¹) * (b : R)) ^ n := by
          symm
          rw [mul_pow]
          rfl
        _ = 1 := hpow_eq
    have hg_sub : g - 1 ∈ I := by
      have hg_eq : g - 1 = (a - (b : R) ^ n) * ↑((b⁻¹) ^ n) := by
        calc
          g - 1 = g - ((b : R) ^ n * ↑((b⁻¹) ^ n)) := by rw [hcancel_right]
          _ = (a - (b : R) ^ n) * ↑((b⁻¹) ^ n) := by
            simp [g]
            ring
      rw [hg_eq]
      exact I.mul_mem_right _ hdiff
    have hg_mem : g ∈ I.oneAdd := mem_oneAdd_of_sub_one_mem I hg_sub
    obtain ⟨c, hc, _⟩ :=
      existsUnique_nth_root_mem_oneAdd_of_mem_oneAdd I hI hn hn_unit hg_mem
    have hcpow : c ^ n = g := hc.1
    refine ⟨c * (b : R), ?_⟩
    -- Reassemble the root using the lifted quotient root and the root in `1 + I`.
    calc
      (c * (b : R)) ^ n = c ^ n * (b : R) ^ n := by
        rw [mul_pow]
      _ = g * (b : R) ^ n := by rw [hcpow]
      _ = a := by
        calc
          g * (b : R) ^ n = (a * ↑((b⁻¹) ^ n)) * (b : R) ^ n := by rfl
          _ = a * (↑((b⁻¹) ^ n) * (b : R) ^ n) := by ring
          _ = a := by rw [hcancel_left, mul_one]

-- Proof sketch: construct the inverse by the truncated binomial series for `(1 + x)^(1 / n)`;
-- local nilpotence makes the series finite, and `n` is invertible in `R` because it is
-- invertible in `R ⧸ I` and units lift across locally nilpotent ideals by Lemma 10.32.4.
/-- Lemma 10.32.8 (1), canonical form: if `I` is locally nilpotent and `n ≥ 1` is invertible in
`R ⧸ I`, then the `n`th-power map on the canonical owner object `1 + I` is bijective. -/
theorem bijective_pow_one_add_of_isLocallyNilpotent (I : Ideal R)
    (hI : I.IsLocallyNilpotent) {n : ℕ} (hn : 1 ≤ n)
    (hn_unit : IsUnit (n : R ⧸ I)) :
    Function.Bijective (fun x : Ideal.oneAdd I ↦ x ^ n) := by
  constructor
  · intro x y hxy
    -- Compare two roots of the same element of `1 + I` and use uniqueness.
    have hpow : (x : R) ^ n = (y : R) ^ n := by
      simpa [SubmonoidClass.coe_pow] using congrArg Subtype.val hxy
    have hxpow_mem : (x : R) ^ n ∈ I.oneAdd := by
      simpa [SubmonoidClass.coe_pow] using (x ^ n).2
    obtain ⟨r, hr, huniq⟩ :=
      existsUnique_nth_root_mem_oneAdd_of_mem_oneAdd I hI hn hn_unit hxpow_mem
    have hxroot : (x : R) ^ n = (x : R) ^ n ∧ (x : R) ∈ I.oneAdd := ⟨rfl, x.2⟩
    have hyroot : (y : R) ^ n = (x : R) ^ n ∧ (y : R) ∈ I.oneAdd := ⟨hpow.symm, y.2⟩
    exact Subtype.ext ((huniq x hxroot).trans (huniq y hyroot).symm)
  · intro u
    -- Surjectivity is the existence half of the unique-root statement.
    obtain ⟨v, hv, _⟩ :=
      existsUnique_nth_root_mem_oneAdd_of_mem_oneAdd I hI hn hn_unit u.2
    refine ⟨⟨v, hv.2⟩, ?_⟩
    exact Subtype.ext (by simpa [SubmonoidClass.coe_pow] using hv.1)

/-- Ideal-subtype bridge: under the coordinate identification `x ↦ 1 + x` between `I` and `1 + I`,
the canonical power map on `1 + I` is the textbook map `x ↦ (1 + x)^n - 1` on `I`. -/
theorem bijective_one_add_pow_sub_one_of_isLocallyNilpotent (I : Ideal R)
    (hI : I.IsLocallyNilpotent) {n : ℕ} (hn : 1 ≤ n)
    (hn_unit : IsUnit (n : R ⧸ I)) :
    Function.Bijective fun x : I ↦
      show I from ⟨(1 + (x : R)) ^ n - 1, one_add_pow_sub_one_mem I n x⟩ := by
  have hbij := bijective_pow_one_add_of_isLocallyNilpotent I hI hn hn_unit
  constructor
  · intro x y hxy
    -- Translate equality in the textbook coordinates to equality in `1 + I`.
    have hpow : (1 + (x : R)) ^ n = (1 + (y : R)) ^ n := by
      simpa using congrArg (fun z : R ↦ z + 1) (congrArg Subtype.val hxy)
    have hpow_eq :
        (⟨1 + (x : R), one_add_mem_oneAdd I x⟩ : Ideal.oneAdd I) ^ n =
          (⟨1 + (y : R), one_add_mem_oneAdd I y⟩ : Ideal.oneAdd I) ^ n := by
      apply Subtype.ext
      simpa [SubmonoidClass.coe_pow] using hpow
    have hbase :=
      hbij.1 hpow_eq
    apply Subtype.ext
    exact add_left_cancel (congrArg Subtype.val hbase)
  · intro y
    -- Solve surjectivity in `1 + I` first, then subtract `1` to return to the ideal.
    let u : Ideal.oneAdd I := ⟨1 + (y : R), one_add_mem_oneAdd I y⟩
    obtain ⟨v, hv⟩ := hbij.2 u
    let x : I := ⟨(v : R) - 1, sub_one_mem_of_mem_oneAdd I v.2⟩
    refine ⟨x, ?_⟩
    apply Subtype.ext
    have hvpow : (v : R) ^ n = 1 + (y : R) := by
      simpa [SubmonoidClass.coe_pow] using congrArg Subtype.val hv
    have hx_eq : 1 + (x : R) = (v : R) := by
      change 1 + ((v : R) - 1) = (v : R)
      ring
    calc
      (1 + (x : R)) ^ n - 1 = (v : R) ^ n - 1 := by rw [hx_eq]
      _ = y := by rw [hvpow]; simp

-- Proof sketch: pass between roots in `R` and roots in `R ⧸ I` through the unit groups, then use
-- the owner-level bijectivity statement on `1 + I` from part (1).
/-- Lemma 10.32.8 (2), canonical form: for a locally nilpotent ideal `I`, an `n`th root of a
unit of `R` exists if and only if an `n`th root exists after mapping that unit to `(R ⧸ I)ˣ`. -/
theorem units_exists_pow_eq_iff_exists_pow_eq_quotient_of_isLocallyNilpotent
    (I : Ideal R) (hI : I.IsLocallyNilpotent) {n : ℕ} (hn : 1 ≤ n)
    (hn_unit : IsUnit (n : R ⧸ I))
    (a : Rˣ) :
    (∃ b : Rˣ, b ^ n = a) ↔
      ∃ bbar : (R ⧸ I)ˣ, bbar ^ n = Units.map (mk I).toMonoidHom a := by
  have hqa : IsUnit (mk I (a : R)) := a.isUnit.map (mk I)
  have hleft : a.isUnit.unit = a := by
    apply Units.ext
    simp
  have hmap : hqa.unit = Units.map (mk I).toMonoidHom a := by
    apply Units.ext
    simp
  -- Reduce both sides to the ring-level root criterion and reuse the auxiliary theorem.
  calc
    (∃ b : Rˣ, b ^ n = a) ↔ ∃ b : R, b ^ n = (a : R) := by
      simpa [hleft] using (exists_pow_eq_iff_exists_pow_eq_unit hn a.isUnit).symm
    _ ↔ ∃ bbar : R ⧸ I, bbar ^ n = mk I (a : R) :=
      exists_pow_eq_iff_exists_pow_eq_quotient_of_isLocallyNilpotent_aux I hI hn hn_unit a.isUnit
    _ ↔ ∃ bbar : (R ⧸ I)ˣ, bbar ^ n = Units.map (mk I).toMonoidHom a := by
      simpa [hmap] using exists_pow_eq_iff_exists_pow_eq_unit hn hqa

-- Proof sketch: if `a = b^n`, then its image in `R ⧸ I` is the `n`th power of the image of `b`.
-- Conversely, if the image of `a` is `b̄^n`, lift `b̄` to `b : R`, use Lemma 10.32.4 to see that
-- `b` is a unit, and then apply part (1) to the element `a * b⁻n` lying in `1 + I`.
/-- Unit-valued bridge: a unit of `R` is an `n`th power if and only if its image in `R ⧸ I` is an
`n`th power. -/
theorem isUnit_exists_pow_eq_iff_exists_pow_eq_quotient_of_isLocallyNilpotent
    (I : Ideal R) (hI : I.IsLocallyNilpotent) {n : ℕ} (hn : 1 ≤ n)
    (hn_unit : IsUnit (n : R ⧸ I))
    {a : R} (ha : IsUnit a) :
    (∃ b : R, b ^ n = a) ↔ ∃ bbar : R ⧸ I, bbar ^ n = mk I a := by
  have hqa : IsUnit (mk I a) := ha.map (mk I)
  have hmap : hqa.unit = Units.map (mk I).toMonoidHom ha.unit := by
    apply Units.ext
    simp
  rw [exists_pow_eq_iff_exists_pow_eq_unit hn ha,
    exists_pow_eq_iff_exists_pow_eq_unit hn hqa]
  simpa [hmap] using
    units_exists_pow_eq_iff_exists_pow_eq_quotient_of_isLocallyNilpotent I hI hn hn_unit ha.unit

end
