/-! ### Definition_10_60_10 (from Chap10) -/
universe u

open IsLocalRing

section

variable {R : Type u} [CommRing R] [IsLocalRing R]

namespace IsLocalRing

/-- The ideal generated by a finite sequence in the maximal ideal of a local ring. -/
def parameterIdeal {d : ℕ} (x : Fin d → maximalIdeal R) : Ideal R :=
  Ideal.span (Set.range fun i ↦ (x i : R))

/-- Unfolding `parameterIdeal` as the ideal spanned by the underlying sequence in `R`. -/
@[simp] theorem parameterIdeal_eq_span {d : ℕ} (x : Fin d → maximalIdeal R) :
    parameterIdeal x = Ideal.span (Set.range fun i ↦ (x i : R)) :=
  rfl

/-- Definition 10.60.10 (1): a system of parameters is a length-`d` sequence in the maximal ideal
whose generated ideal is an ideal of definition. -/
def IsSystemOfParameters {d : ℕ} (x : Fin d → maximalIdeal R) : Prop :=
  ringKrullDim R = d ∧ (parameterIdeal x).IsIdealOfDefinition

/-- A sequence in the maximal ideal is a system of parameters exactly when its generated ideal is
an ideal of definition. -/
@[simp] theorem isSystemOfParameters_iff {d : ℕ} (x : Fin d → maximalIdeal R) :
    IsSystemOfParameters x ↔
      (ringKrullDim R = d ∧ (parameterIdeal x).IsIdealOfDefinition) :=
  Iff.rfl

/-- In a local ring whose Krull dimension is already identified with `d`, a length-`d` sequence in
the maximal ideal is a system of parameters exactly when its generated ideal is an ideal of
definition. -/
@[simp] theorem isSystemOfParameters_iff_of_ringKrullDim_eq {d : ℕ}
    (hdim : ringKrullDim R = d) (x : Fin d → maximalIdeal R) :
    IsSystemOfParameters x ↔ (parameterIdeal x).IsIdealOfDefinition := by
  rw [isSystemOfParameters_iff]
  simp [hdim]

/-- Definition 10.60.10 (2), bridge/view form: a regular system of parameters is a system of
parameters whose generated ideal is the maximal ideal itself. This keeps the chosen-family owner
abstraction `IsSystemOfParameters` primitive, while the ambient regularity owner abstraction is
`IsRegularLocalRing R`. -/
def IsRegularSystemOfParameters {d : ℕ} (x : Fin d → maximalIdeal R) : Prop :=
  IsSystemOfParameters x ∧ parameterIdeal x = maximalIdeal R

/-- A length-`c` sequence in the maximal ideal is part of a regular system of parameters of total
length `d` if it extends to a regular system of parameters after adjoining `d - c` further
elements. This is the source-facing existential owner for "part of a regular system" while
`IsRegularSystemOfParameters` remains the chosen-family bridge. -/
def IsPartOfRegularSystemOfParameters (d : ℕ) {c : ℕ} (x : Fin c → maximalIdeal R) : Prop :=
  ∃ y : Fin (d - c) → maximalIdeal R, IsRegularSystemOfParameters (Fin.append x y)

/-- Unfolding `IsRegularSystemOfParameters` into its dimension and maximal-ideal-generation
clauses. -/
@[simp] theorem isRegularSystemOfParameters_iff {d : ℕ} (x : Fin d → maximalIdeal R) :
    IsRegularSystemOfParameters x ↔
      (ringKrullDim R = d ∧ parameterIdeal x = maximalIdeal R) := by
  constructor
  · rintro ⟨hx, hmax⟩
    exact ⟨hx.1, hmax⟩
  · rintro ⟨hdim, hmax⟩
    exact ⟨
      (isSystemOfParameters_iff_of_ringKrullDim_eq hdim x).2 <|
        hmax ▸ Ideal.maximalIdeal_isIdealOfDefinition,
      hmax
    ⟩

/-- Unfolding `IsPartOfRegularSystemOfParameters` into the existence of a complementary tail. -/
@[simp] theorem isPartOfRegularSystemOfParameters_iff (d : ℕ) {c : ℕ}
    (x : Fin c → maximalIdeal R) :
    IsPartOfRegularSystemOfParameters d x ↔
      ∃ y : Fin (d - c) → maximalIdeal R, IsRegularSystemOfParameters (Fin.append x y) :=
  Iff.rfl

/-- With the dimension fixed in advance, a regular system of parameters is exactly a generating
family of the maximal ideal. -/
@[simp] theorem isRegularSystemOfParameters_iff_of_ringKrullDim_eq {d : ℕ}
    (hdim : ringKrullDim R = d) (x : Fin d → maximalIdeal R) :
    IsRegularSystemOfParameters x ↔ parameterIdeal x = maximalIdeal R := by
  rw [isRegularSystemOfParameters_iff]
  simp [hdim]

/-- A regular system of parameters is, in particular, a system of parameters. -/
theorem IsRegularSystemOfParameters.isSystemOfParameters {d : ℕ} {x : Fin d → maximalIdeal R}
    (hx : IsRegularSystemOfParameters x) :
    IsSystemOfParameters x :=
  hx.1

end IsLocalRing

/- Core/canonical owner for the ambient regularity clause: `IsRegularLocalRing R` says that the
maximal ideal can be generated by `dim R` elements. The local predicate
`IsRegularSystemOfParameters` is the source-facing chosen-family bridge built on
`IsSystemOfParameters`. -/
#check IsRegularLocalRing

variable [IsNoetherianRing R]

-- Proof sketch: use the canonical characterization `isRegularLocalRing_iff` of regular local
-- rings by the minimal number of generators of the maximal ideal. A regular system of parameters
-- gives a generating family of length `d = dim R`, while a minimal generating family of the
-- maximal ideal can be reindexed by `Fin d`.
/-- Definition 10.60.10 (2), bridge/view form: for a Noetherian local ring of dimension `d`, the
canonical owner `IsRegularLocalRing R` is equivalent to the existence of a regular system of
parameters indexed by `Fin d`. -/
theorem isRegularLocalRing_iff_exists_regularSystemOfParameters {d : ℕ}
    (hdim : ringKrullDim R = d) :
    IsRegularLocalRing R ↔
      ∃ x : Fin d → maximalIdeal R, IsRegularSystemOfParameters x := by
  classical
  constructor
  · intro hregular
    -- A regular local ring has exactly `d` minimal generators of the maximal ideal.
    have hspan : (maximalIdeal R).spanFinrank = d := by
      simpa [hdim] using (isRegularLocalRing_iff (R := R)).1 hregular
    let hfg : (maximalIdeal R).FG := IsNoetherian.noetherian (maximalIdeal R)
    let s : Finset R := (Submodule.FG.finite_generators hfg).toFinset
    have hs_generators : (s : Set R) = (maximalIdeal R).generators := by
      exact (Submodule.FG.finite_generators hfg).coe_toFinset
    have hs_card : s.card = d := by
      have hs_ncard : (s : Set R).ncard = d := by
        calc
          (s : Set R).ncard = ((maximalIdeal R).generators).ncard := by rw [hs_generators]
          _ = (maximalIdeal R).spanFinrank := Submodule.FG.generators_ncard hfg
          _ = d := hspan
      calc
        s.card = (s : Set R).ncard := by
          simpa using (Set.ncard_eq_toFinset_card (s := (s : Set R))).symm
        _ = d := hs_ncard
    have hmem_generators : (maximalIdeal R).generators ⊆ maximalIdeal R :=
      Submodule.FG.generators_mem (p := maximalIdeal R)
    -- Reindex the chosen minimal generators by `Fin d`.
    let e : Fin d ≃ s := (Finset.equivFinOfCardEq hs_card).symm
    have generator_in_generators : ∀ i : Fin d, ((e i : s) : R) ∈ (maximalIdeal R).generators := by
      intro i
      have hi : ((e i : s) : R) ∈ (s : Set R) := by
        exact (e i).2
      rwa [hs_generators] at hi
    have generator_mem : ∀ i : Fin d, ((e i : s) : R) ∈ maximalIdeal R := by
      intro i
      exact hmem_generators (generator_in_generators i)
    let x : Fin d → maximalIdeal R := fun i ↦ ⟨(e i : R), generator_mem i⟩
    have hx_range :
        Set.range (fun i ↦ ((x i : maximalIdeal R) : R)) = (maximalIdeal R).generators := by
      ext r
      constructor
      · rintro ⟨i, rfl⟩
        exact generator_in_generators i
      · intro hr
        have hr' : r ∈ (s : Set R) := by
          rwa [← hs_generators] at hr
        let rs : s := ⟨r, hr'⟩
        obtain ⟨i, hi⟩ := e.surjective rs
        refine ⟨i, ?_⟩
        exact congrArg Subtype.val hi
    have hx_parameter : parameterIdeal x = maximalIdeal R := by
      -- The reindexed generators span exactly the maximal ideal.
      rw [parameterIdeal_eq_span, hx_range]
      simpa using (maximalIdeal R).span_generators
    -- Generating the maximal ideal identifies the family as a regular system of parameters.
    exact ⟨x, (isRegularSystemOfParameters_iff_of_ringKrullDim_eq (R := R) hdim x).2 hx_parameter⟩
  · rintro ⟨x, hx⟩
    -- A regular system of parameters already generates the maximal ideal.
    have hx_parameter : parameterIdeal x = maximalIdeal R := by
      exact (isRegularSystemOfParameters_iff_of_ringKrullDim_eq (R := R) hdim x).1 hx
    have hrange_ncard :
        (Set.range fun i : Fin d ↦ ((x i : maximalIdeal R) : R)).ncard ≤ d := by
      let s : Finset R := Finset.univ.image fun i : Fin d ↦ ((x i : maximalIdeal R) : R)
      have hs_range : (Set.range fun i : Fin d ↦ ((x i : maximalIdeal R) : R)) = (s : Set R) := by
        ext r
        constructor
        · rintro ⟨i, rfl⟩
          simp [s]
        · intro hr
          simp only [s, Finset.mem_coe, Finset.mem_image, Finset.mem_univ, true_and] at hr
          rcases hr with ⟨i, rfl⟩
          exact ⟨i, rfl⟩
      rw [hs_range, Set.ncard_coe_finset]
      simpa [s] using
        (Finset.card_image_le
          (s := (Finset.univ : Finset (Fin d)))
          (f := fun i : Fin d ↦ ((x i : maximalIdeal R) : R)))
    have hspan_le : (maximalIdeal R).spanFinrank ≤ d := by
      -- The maximal ideal is spanned by the image of a `Fin d`-indexed family, so it needs at
      -- most `d` generators.
      calc
        (maximalIdeal R).spanFinrank = (parameterIdeal x).spanFinrank := by rw [hx_parameter]
        _ = (Ideal.span (Set.range fun i : Fin d ↦ ((x i : maximalIdeal R) : R))).spanFinrank := by
          rw [parameterIdeal_eq_span]
        _ ≤ (Set.range fun i : Fin d ↦ ((x i : maximalIdeal R) : R)).ncard := by
          exact Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)
        _ ≤ d := hrange_ncard
    -- The canonical regular-local criterion now closes the reverse implication.
    exact IsRegularLocalRing.of_spanFinrank_maximalIdeal_le (R := R) <|
      by simpa [hdim] using hspan_le

end

/-! ### Lemma_10_60_11 (from Chap10) -/
universe u

open Ideal
open PrimeSpectrum

section

variable {R : Type u} [CommRing R] [IsNoetherianRing R]

/- Domain sampling:
* Primary domain: commutative algebra on `Spec R`, viewed as the specialization preorder on
  `PrimeSpectrum R`.
* Owner declarations inspected in this domain:
  - `Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes`
  - `Ideal.map_height_le_one_of_mem_minimalPrimes`
  - `PrimeSpectrum.exist_mem_one_of_mem_two`
  - `WCovBy` / `WCovBy.Ioo_eq`
* Best owner abstraction: clause `(2)` is intrinsically a weak-cover statement in the
  specialization order; the textbook negated-existence sentence is derived API.
* Primitive vs. derived: the primitive input is only membership in
  `(p.asIdeal ⊔ span {x}).minimalPrimes`; both `p ⩿ q` and “no prime strictly between” are
  consequences, not extra primitive data.
-/

/- Lemma 10.60.11 (1): the source statement is the specialization of Krull's principal ideal
theorem to the principal ideal `span {x}`. The canonical owner theorem is the more general
`Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes`. -/
recall Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes

-- Source/core/bridge triage:
-- * source-facing: the textbook sentence is that no prime lies strictly between `p` and `q`;
-- * core/canonical: this is the weak cover relation `p ⩿ q` in the specialization order;
-- * bridge/view: the source-facing negated-existence statement is a direct companion theorem below.
/-- Lemma 10.60.11 (2), core/canonical form: if `q` is minimal over the ideal generated by a prime
`p` together with `x`, then `q` weakly covers `p` in the specialization order on `Spec R`. -/
theorem wcovBy_of_mem_minimalPrimes_sup_span_singleton
    (p q : PrimeSpectrum R) (x : R)
    (hq : q.asIdeal ∈ (p.asIdeal ⊔ span {x}).minimalPrimes) :
    p ⩿ q := by
  refine wcovBy_of_eq_or_eq (le_sup_left.trans hq.1.2) fun r hpr hrq ↦ ?_
  by_cases hpr' : r = p
  · exact Or.inl hpr'
  by_cases hrq' : r = q
  · exact Or.inr hrq'
  have hpr_lt : p < r := lt_of_le_of_ne hpr fun h ↦ hpr' h.symm
  have hrq_lt : r < q := lt_of_le_of_ne hrq hrq'
  have hxq : x ∈ q.asIdeal := le_sup_right.trans hq.1.2 <| mem_span_singleton_self x
  obtain ⟨s, hxs, hps, hsq⟩ := exist_mem_one_of_mem_two hpr_lt hrq_lt hxq
  have hs_mem : p.asIdeal ⊔ span {x} ≤ s.asIdeal := by
    refine sup_le hps.le ?_
    exact (span_singleton_le_iff_mem s.asIdeal).2 hxs
  have hqs : q.asIdeal ≤ s.asIdeal := hq.2 ⟨s.isPrime, hs_mem⟩ hsq.le
  exact False.elim <| hsq.not_ge <| (asIdeal_le_asIdeal q s).1 hqs

/-- Lemma 10.60.11 (2), source-facing form: if `q` is minimal over the ideal generated by a prime
`p` together with `x`, then there is no point of `Spec R` strictly between `p` and `q` in the
specialization order. -/
theorem no_prime_strictly_between_of_mem_minimalPrimes_sup_span_singleton
    (p q : PrimeSpectrum R) (x : R)
    (hq : q.asIdeal ∈ (p.asIdeal ⊔ span {x}).minimalPrimes) :
    ¬ ∃ r : PrimeSpectrum R, p < r ∧ r < q := by
  rintro ⟨r, hpr, hrq⟩
  rcases (wcovBy_of_mem_minimalPrimes_sup_span_singleton p q x hq).eq_or_eq hpr.le hrq.le with
    rfl | rfl
  · exact hpr.ne rfl
  · exact hrq.ne rfl

end

/-! ### Lemma_10_60_12 (from Chap10) -/
universe u

open Ideal PrimeSpectrum

section

variable {R : Type u} [CommRing R] [IsNoetherianRing R]

/- Domain sampling:
* Primary domain: commutative algebra on `Spec R`, using the specialization-order notions
  `Ideal.height` and `LTSeries`.
* Owner declarations inspected in this domain:
  - `Ideal.height_le_card_of_mem_minimalPrimes_span`
  - `Ideal.primeSpectrumQuotientOrderIsoZeroLocus`
  - `Ideal.height_eq_primeHeight`
  - `Order.length_le_height`
* Best owner abstraction: the ambient owner API is the height/minimal-primes package on ideals,
  together with the quotient-order identification `Spec (R ⧸ I) ≃o V(I)`.
* Primitive vs. derived: the primitive input here is only minimal-prime membership over a finitely
  generated ideal; the bounded-length statement for chains is derived by passing to the quotient.
* Source/core/bridge triage: both numbered items remain source-facing reformulations, while their
  proofs reuse the core/canonical owner API above rather than introducing parallel local notions.
-/

/-- Lemma 10.60.12 (1): if `p` is minimal over an ideal generated by `r` elements, then the height
of `p` is at most `r`. -/
theorem height_le_card_of_mem_minimalPrimes_span_range
    (r : ℕ) (f : Fin r → R) (p : PrimeSpectrum R)
    (hp : p.asIdeal ∈ (span (Set.range f)).minimalPrimes) :
    p.asIdeal.height ≤ r := by
  have hcard : (f '' (Set.univ : Set (Fin r))).ncard ≤ ((Set.univ : Set (Fin r)).ncard) :=
    Set.ncard_image_le
  exact (Ideal.height_le_card_of_mem_minimalPrimes_span (Set.finite_range f) hp).trans <| by
    simpa [Set.image_univ] using hcard

/-- Lemma 10.60.12 (2): if `q` is minimal over the ideal generated by `p` together with `r`
elements, then every strict chain of prime ideals between `p` and `q` has length at most `r`. -/
-- Proof sketch: pass to the quotient `R ⧸ p`, where the image of `q` is minimal over the ideal
-- generated by the images of `f`; part (1) gives height at most `r`, and any chain between `p` and
-- `q` corresponds to a chain of primes below that quotient prime.
theorem length_le_of_ltSeries_between_of_mem_minimalPrimes_sup_span_range
    (r : ℕ) (f : Fin r → R) (p q : PrimeSpectrum R)
    (hq : q.asIdeal ∈ (p.asIdeal ⊔ span (Set.range f)).minimalPrimes)
    (c : LTSeries (Set.Icc p q)) :
    c.length ≤ r := by
  let π : R →+* R ⧸ p.asIdeal := Ideal.Quotient.mk p.asIdeal
  let e : PrimeSpectrum (R ⧸ p.asIdeal) ≃o zeroLocus (p.asIdeal : Set R) :=
    p.asIdeal.primeSpectrumQuotientOrderIsoZeroLocus
  let ψ : Set.Icc p q → PrimeSpectrum (R ⧸ p.asIdeal) := fun x ↦ e.symm ⟨x.1, x.2.1⟩
  have hψ : StrictMono ψ := fun _ _ h ↦ e.symm.strictMono h
  let fbar : Fin r → R ⧸ p.asIdeal := fun i ↦ π (f i)
  let qbar : PrimeSpectrum (R ⧸ p.asIdeal) :=
    ⟨q.asIdeal.map π, Ideal.isPrime_map_quotientMk_of_isPrime (le_sup_left.trans hq.1.2)⟩
  have hspan_map : (span (Set.range f)).map π = span (Set.range fbar) := by
    rw [map_span]
    simpa [Function.comp] using congrArg span (Set.range_comp π f).symm
  have hqbar_min : qbar.asIdeal ∈ (span (Set.range fbar)).minimalPrimes := by
    rw [← hspan_map]
    rw [Ideal.minimalPrimes_map_of_surjective Ideal.Quotient.mk_surjective (span (Set.range f))]
    refine ⟨q.asIdeal, ?_, ?_⟩
    · simpa [π, Ideal.mk_ker, sup_comm] using hq
    · rfl
  have hqbar_ideal_height : qbar.asIdeal.height ≤ r :=
    height_le_card_of_mem_minimalPrimes_span_range r fbar qbar hqbar_min
  letI : qbar.asIdeal.IsPrime := qbar.isPrime
  have hqbar_order_height : Order.height qbar ≤ r := by
    simpa [qbar, Ideal.height_eq_primeHeight, Ideal.primeHeight] using hqbar_ideal_height
  let cbar : LTSeries (PrimeSpectrum (R ⧸ p.asIdeal)) := c.map ψ hψ
  have hlength : cbar.length ≤ Order.height cbar.last := Order.length_le_height_last
  have hcbar_last : cbar.last ≤ qbar := by
    change ψ c.last ≤ e.symm ⟨q, le_sup_left.trans hq.1.2⟩
    exact e.symm.monotone c.last.2.2
  simpa [cbar] using
    hlength.trans ((Order.height_mono hcbar_last).trans hqbar_order_height)

end

/-! ### Lemma_10_60_13 (from Chap10) -/
universe u

open IsLocalRing
open Pointwise
open scoped nonZeroDivisors

section

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/- Domain triage:
* source-facing: the textbook statements are about the quotient `R / (x)`, written in Lean as
  `R ⧸ Ideal.span {x}`;
* core/canonical: the owner abstractions are the root theorem
  `ringKrullDim_le_ringKrullDim_quotSMulTop_succ` and the module theorem
  `Module.supportDim_quotSMulTop_succ_eq_of_notMem_minimalPrimes_of_mem_maximalIdeal`;
* bridge/view: the only extra work in this file is to identify `Ideal.span {x}` with the owner
  ideal `x • ⊤` and specialize the module theorem to `M = R`.
-/

-- Proof sketch: identify `Ideal.span {x}` with the owner ideal `x • ⊤` and apply the canonical
-- one-step dimension bound `ringKrullDim_le_ringKrullDim_quotSMulTop_succ`.
/-- Lemma 10.60.13: if `R` is a Noetherian local ring and `x` lies in the maximal ideal, then
`dim R ≤ dim (R / (x)) + 1`, written canonically as
`ringKrullDim R ≤ ringKrullDim (R ⧸ Ideal.span {x}) + 1`. -/
theorem ringKrullDim_le_ringKrullDim_quotient_span_singleton_add_one (x : R)
    (hx : x ∈ maximalIdeal R) :
    ringKrullDim R ≤ ringKrullDim (R ⧸ Ideal.span {x}) + 1 := by
  have hspan : Ideal.span {x} = x • (⊤ : Ideal R) := by
    simp [← Submodule.ideal_span_singleton_smul]
  rw [ringKrullDim_eq_of_ringEquiv (Ideal.quotientEquivAlgOfEq R hspan).toRingEquiv]
  exact ringKrullDim_le_ringKrullDim_quotSMulTop_succ hx

-- Proof sketch: identify `dim R` with `supportDim R R`, note that `annihilator R R = ⊥`, and
-- apply the equality case `supportDim_quotSMulTop_succ_eq_of_notMem_minimalPrimes_of_mem_maximalIdeal`
-- for the module `R`.
/-- If `x` is in the maximal ideal and avoids every minimal prime of `R`, then quotienting by the
principal ideal `(x)` lowers the Krull dimension by exactly one. -/
theorem ringKrullDim_eq_ringKrullDim_quotient_span_singleton_add_one_of_not_mem_minimalPrimes
    (x : R) (hx : x ∈ maximalIdeal R) (hmin : ∀ p ∈ minimalPrimes R, x ∉ p) :
    ringKrullDim R = ringKrullDim (R ⧸ Ideal.span {x}) + 1 := by
  have hspan : Ideal.span {x} = x • (⊤ : Ideal R) := by
    simp [← Submodule.ideal_span_singleton_smul]
  have hann : Module.annihilator R R = ⊥ :=
    Module.annihilator_eq_bot.mpr inferInstance
  have hmin' : ∀ p ∈ (Module.annihilator R R).minimalPrimes, x ∉ p := by
    simpa [hann, minimalPrimes] using hmin
  symm
  rw [ringKrullDim_eq_of_ringEquiv (Ideal.quotientEquivAlgOfEq R hspan).toRingEquiv,
    ← Module.supportDim_quotient_eq_ringKrullDim, ← Module.supportDim_self_eq_ringKrullDim]
  exact Module.supportDim_quotSMulTop_succ_eq_of_notMem_minimalPrimes_of_mem_maximalIdeal
    hmin' hx

/- Companion recall: the nonzerodivisor case is already the canonical mathlib theorem
`ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors`, stated with
the standard submonoid notation `x ∈ R⁰`. -/
recall ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors

end

/-! ### Lemma_10_60_14 (from Chap10) -/
universe u

open IsLocalRing

section

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- Helper for Lemma 10.60.14: the ideal generated by the head parameter of a system. -/
def headParameterIdeal {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal A) : Ideal A :=
  Ideal.span ({((x 0 : maximalIdeal A) : A)} : Set A)

/-- Helper for Lemma 10.60.14: the head parameter ideal lies in the maximal ideal. -/
lemma headParameterIdeal_le_maximalIdeal {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal A) :
    headParameterIdeal x ≤ maximalIdeal A := by
  -- The head ideal is generated by an element already lying in the maximal ideal.
  dsimp [headParameterIdeal]
  exact (Ideal.span_singleton_le_iff_mem (I := maximalIdeal A) (x := ((x 0 : maximalIdeal A) : A))).2
    (x 0).2

/-- Helper for Lemma 10.60.14: the quotient by the head parameter remains nontrivial. -/
lemma headParameterIdeal_ne_top {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal A) :
    headParameterIdeal x ≠ ⊤ := by
  -- An ideal contained in the maximal ideal cannot be the whole ring.
  intro htop
  have hmax : maximalIdeal A = ⊤ := top_le_iff.mp (htop ▸ headParameterIdeal_le_maximalIdeal x)
  exact (maximalIdeal.isMaximal A).ne_top hmax

/-- Helper for Lemma 10.60.14: in the head quotient, each remaining parameter still lies in the
quotient maximal ideal. -/
lemma tail_image_mem_maximalIdeal {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal A)
    [IsLocalRing (A ⧸ headParameterIdeal x)] (i : Fin d) :
    Ideal.Quotient.mk (headParameterIdeal x) (((x i.succ : maximalIdeal A) : A)) ∈
      maximalIdeal (A ⧸ headParameterIdeal x) := by
  let I : Ideal A := headParameterIdeal x
  let S := A ⧸ I
  have hmap :
      Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A) = maximalIdeal S := by
    exact IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
  have hmem :
      Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)) ∈
        Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A) := by
    refine (Ideal.mem_map_iff_of_surjective (f := Ideal.Quotient.mk I)
      (hf := Ideal.Quotient.mk_surjective) (I := maximalIdeal A)
      (y := Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)))).2 ?_
    exact ⟨((x i.succ : maximalIdeal A) : A), (x i.succ).2, rfl⟩
  simpa [I, S, hmap] using hmem

/-- Helper for Lemma 10.60.14: the image of the full parameter ideal in the head quotient is the
parameter ideal generated by the quotient images of the tail. -/
lemma map_parameterIdeal_eq_tail_parameterIdeal {A : Type u} [CommRing A] [IsLocalRing A]
    {d : ℕ} (x : Fin (d + 1) → maximalIdeal A)
    [IsLocalRing (A ⧸ headParameterIdeal x)] :
    let xbar : Fin d → maximalIdeal (A ⧸ headParameterIdeal x) := fun i ↦
      ⟨Ideal.Quotient.mk (headParameterIdeal x) (((x i.succ : maximalIdeal A) : A)),
        tail_image_mem_maximalIdeal x i⟩
    Ideal.map (Ideal.Quotient.mk (headParameterIdeal x)) (parameterIdeal x) = parameterIdeal xbar := by
  let I : Ideal A := headParameterIdeal x
  let S := A ⧸ I
  let xbar : Fin d → maximalIdeal S := fun i ↦
    ⟨Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)), tail_image_mem_maximalIdeal x i⟩
  -- Map the span of the full parameter family and note that the head generator dies in the quotient.
  suffices
      hspan :
        Ideal.map (Ideal.Quotient.mk I) (Ideal.span (Set.range fun i ↦ ((x i : maximalIdeal A) : A))) =
          Ideal.span (Set.range fun i ↦ ((xbar i : maximalIdeal S) : S)) by
    simpa [parameterIdeal_eq_span, xbar] using hspan
  rw [Ideal.map_span]
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨y, ⟨i, rfl⟩, rfl⟩
    refine Fin.cases ?_ ?_ i
    · have hx0 : Ideal.Quotient.mk I (((x 0 : maximalIdeal A) : A)) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem]
        dsimp [I, headParameterIdeal]
        exact Ideal.subset_span (by simp)
      simpa [hx0]
    · intro j
      exact Ideal.subset_span ⟨j, rfl⟩
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨((x i.succ : maximalIdeal A) : A), ⟨i.succ, rfl⟩, rfl⟩

/-- Helper for Lemma 10.60.14: after killing the head parameter, the remaining images still
generate an ideal of definition. -/
lemma quotient_tail_parameterIdeal_isIdealOfDefinition {A : Type u} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {d : ℕ} (x : Fin (d + 1) → maximalIdeal A)
    (hx : IsSystemOfParameters x) :
    let I : Ideal A := headParameterIdeal x
    let S := A ⧸ I
    letI : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr (headParameterIdeal_ne_top x)
    letI : IsLocalRing S :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    let xbar : Fin d → maximalIdeal S := fun i ↦
      ⟨Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)),
        tail_image_mem_maximalIdeal x i⟩
    (parameterIdeal xbar).IsIdealOfDefinition := by
  let I : Ideal A := headParameterIdeal x
  let S := A ⧸ I
  letI : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr (headParameterIdeal_ne_top x)
  letI : IsLocalRing S :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let xbar : Fin d → maximalIdeal S := fun i ↦
    ⟨Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)), tail_image_mem_maximalIdeal x i⟩
  have hker_le_parameter : RingHom.ker (Ideal.Quotient.mk I) ≤ parameterIdeal x := by
    -- The kernel of the quotient map is exactly the head parameter ideal, which lies in the full
    -- parameter ideal.
    rw [Ideal.mk_ker]
    dsimp [I, headParameterIdeal]
    exact (Ideal.span_singleton_le_iff_mem (I := parameterIdeal x) (x := ((x 0 : maximalIdeal A) : A))).2 <|
      by
        rw [parameterIdeal_eq_span]
        exact Ideal.subset_span ⟨0, rfl⟩
  have hmap :
      Ideal.map (Ideal.Quotient.mk I) (parameterIdeal x) = parameterIdeal xbar := by
    -- Modding out by the head kills only the first generator and leaves the mapped tail family.
    simpa [I, S, xbar] using map_parameterIdeal_eq_tail_parameterIdeal (A := A) x
  have hmap_max :
      Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A) = maximalIdeal S := by
    exact IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
  -- Radicals commute with the quotient map because the quotient map is surjective.
  calc
    (parameterIdeal xbar).radical
        = (Ideal.map (Ideal.Quotient.mk I) (parameterIdeal x)).radical := by rw [hmap.symm]
    _ = Ideal.map (Ideal.Quotient.mk I) (parameterIdeal x).radical := by
          symm
          exact Ideal.map_radical_of_surjective Ideal.Quotient.mk_surjective hker_le_parameter
    _ = Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A) := by rw [hx.2]
    _ = maximalIdeal S := hmap_max

/-- Helper for Lemma 10.60.14: quotienting by the head parameter lowers the Krull dimension by
exactly one. -/
lemma ringKrullDim_quotient_head_eq_of_systemOfParameters {A : Type u} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {d : ℕ} (x : Fin (d + 1) → maximalIdeal A)
    (hx : IsSystemOfParameters x) :
    ringKrullDim (A ⧸ headParameterIdeal x) = d := by
  let I : Ideal A := headParameterIdeal x
  let S := A ⧸ I
  letI : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr (headParameterIdeal_ne_top x)
  letI : IsLocalRing S :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let xbar : Fin d → maximalIdeal S := fun i ↦
    ⟨Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)), tail_image_mem_maximalIdeal x i⟩
  have hupper : ringKrullDim S ≤ d := by
    -- The quotient tail family is still a `d`-generated ideal of definition upstairs.
    exact ringKrullDim_le_of_exists_parameterIdeal (R := S) ⟨xbar,
      quotient_tail_parameterIdeal_isIdealOfDefinition (A := A) x hx⟩
  rcases ringKrullDim_eq_nat_of_le (R := S) hupper with ⟨n, hnle, hdimS⟩
  have hlower_succ : ((d + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim S + 1 := by
    -- Lemma 10.60.13 gives the one-step lower bound in the head quotient.
    simpa [I, S, headParameterIdeal, hx.1] using
      (ringKrullDim_le_ringKrullDim_quotient_span_singleton_add_one
        (R := A) (((x 0 : maximalIdeal A) : A)) (x 0).2)
  have hdle : d ≤ n := by
    have hsucc : (d + 1 : ℕ∞) ≤ n + 1 := by
      exact WithBot.coe_le_coe.mp <| by simpa [hdimS] using hlower_succ
    exact Nat.succ_le_succ_iff.mp <| by exact_mod_cast hsucc
  have hnd : n = d := le_antisymm hnle hdle
  -- The upper and lower bounds pin the quotient dimension down exactly.
  simpa [S, hnd] using hdimS

/-- Helper for Lemma 10.60.14: reassociating a family indexed by `Fin (m + 1 + n)` as a family
indexed by `Fin ((m + n) + 1)` does not change its entries. -/
def reassocParameterFamily {A : Type u} [CommRing A] [IsLocalRing A] {m n : ℕ}
    (x : Fin (m + 1 + n) → maximalIdeal A) : Fin ((m + n) + 1) → maximalIdeal A :=
  x ∘ Fin.cast (Nat.add_right_comm m 1 n).symm

/-- Helper for Lemma 10.60.14: the tail of a family indexed by `Fin (m + 1 + n)` is obtained by
shifting a `Fin (m + n)` index and then reassociating the sum. -/
def tailParameterIndex {m n : ℕ} : Fin (m + n) → Fin (m + 1 + n) :=
  fun i ↦ Fin.cast (Nat.add_right_comm m 1 n).symm i.succ

/-- Helper for Lemma 10.60.14: the quotient images of the reassociated tail still lie in the
quotient maximal ideal. -/
lemma tailParameterIndex_mem_maximalIdeal {A : Type u} [CommRing A] [IsLocalRing A] {m n : ℕ}
    (x : Fin (m + 1 + n) → maximalIdeal A)
    [IsLocalRing (A ⧸ headParameterIdeal (reassocParameterFamily x))] (i : Fin (m + n)) :
    Ideal.Quotient.mk (headParameterIdeal (reassocParameterFamily x))
        (((x (tailParameterIndex i) : maximalIdeal A) : A)) ∈
      maximalIdeal (A ⧸ headParameterIdeal (reassocParameterFamily x)) := by
  simpa [reassocParameterFamily, tailParameterIndex] using
    (tail_image_mem_maximalIdeal (x := reassocParameterFamily x) i)

/-- Helper for Lemma 10.60.14: after shifting past the head parameter, the first `m` remaining
indices are the original nonzero prefix indices. -/
lemma tailParameterIndex_castAdd_eq {m n : ℕ} (i : Fin m) :
    tailParameterIndex (m := m) (n := n) (Fin.castAdd n i) = Fin.castAdd n i.succ := by
  ext
  simp [tailParameterIndex]

/-- Helper for Lemma 10.60.14: reassociating the index set of a parameter family does not change
its generated ideal. -/
lemma parameterIdeal_reassoc_eq {A : Type u} [CommRing A] [IsLocalRing A] {m n : ℕ}
    (x : Fin (m + 1 + n) → maximalIdeal A) :
    parameterIdeal (reassocParameterFamily x) = parameterIdeal x := by
  rw [parameterIdeal_eq_span, parameterIdeal_eq_span]
  congr 1
  ext r
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast (Nat.add_right_comm m 1 n).symm i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast (Nat.add_right_comm m 1 n) i, by simp [reassocParameterFamily]⟩

/-- Helper for Lemma 10.60.14: after quotienting by the head parameter, the image of a longer
prefix ideal is exactly the prefix ideal generated by the quotient images of the tail. -/
lemma map_parameterIdeal_prefix_eq_tail_prefix {A : Type u} [CommRing A] [IsLocalRing A]
    {m n : ℕ} (x : Fin (m + 1 + n) → maximalIdeal A)
    [IsLocalRing (A ⧸ headParameterIdeal (reassocParameterFamily x))] :
    let y : Fin ((m + n) + 1) → maximalIdeal A := reassocParameterFamily x
    let I : Ideal A := headParameterIdeal y
    let S := A ⧸ I
    let xbar : Fin (m + n) → maximalIdeal S := fun i ↦
      ⟨Ideal.Quotient.mk I (((x (tailParameterIndex i) : maximalIdeal A) : A)),
        tailParameterIndex_mem_maximalIdeal x i⟩
    parameterIdeal (xbar ∘ Fin.castAdd n) =
      Ideal.map (Ideal.Quotient.mk I) (parameterIdeal (x ∘ Fin.castAdd n)) := by
  let y : Fin ((m + n) + 1) → maximalIdeal A := reassocParameterFamily x
  let I : Ideal A := headParameterIdeal y
  let S := A ⧸ I
  let xbar : Fin (m + n) → maximalIdeal S := fun i ↦
    ⟨Ideal.Quotient.mk I (((x (tailParameterIndex i) : maximalIdeal A) : A)),
      tailParameterIndex_mem_maximalIdeal x i⟩
  -- The longer prefix still contains the head generator, so the same map computation works after
  -- restricting to that prefix.
  suffices
      hspan :
        Ideal.span (Set.range fun i ↦ (((xbar ∘ Fin.castAdd n) i : maximalIdeal S) : S)) =
          Ideal.map (Ideal.Quotient.mk I)
            (Ideal.span (Set.range fun i ↦ (((x ∘ Fin.castAdd n) i : maximalIdeal A) : A))) by
    simpa [parameterIdeal_eq_span] using hspan
  rw [Ideal.map_span]
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    simpa [xbar, Function.comp, tailParameterIndex_castAdd_eq] using
      (Ideal.subset_span ⟨(((x ∘ Fin.castAdd n) i.succ : maximalIdeal A) : A), ⟨i.succ, rfl⟩, rfl⟩ :
        Ideal.Quotient.mk I ((((x ∘ Fin.castAdd n) i.succ : maximalIdeal A) : A)) ∈
          Ideal.span ((Ideal.Quotient.mk I) '' Set.range fun j ↦
            (((x ∘ Fin.castAdd n) j : maximalIdeal A) : A)))
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨y, ⟨i, rfl⟩, rfl⟩
    refine Fin.cases ?_ ?_ i
    · have hx0 : Ideal.Quotient.mk I (((x ∘ Fin.castAdd n) 0 : maximalIdeal A) : A) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem]
        dsimp [I, y, reassocParameterFamily, headParameterIdeal]
        simpa [reassocParameterFamily, Function.comp, Fin.castAdd_zero] using
          (Ideal.subset_span
            (by simp : (((y 0 : maximalIdeal A) : A)) ∈ ({((y 0 : maximalIdeal A) : A)} : Set A)))
      have hx0'' : (Ideal.Quotient.mk I) ((fun i ↦ (((x ∘ Fin.castAdd n) i : maximalIdeal A) : A)) 0) = 0 := by
        simpa [Function.comp] using hx0
      rw [hx0'']
      exact Ideal.zero_mem _
    · intro j
      simpa [xbar, Function.comp, tailParameterIndex_castAdd_eq] using
        (Ideal.subset_span ⟨j, rfl⟩ :
          (((xbar ∘ Fin.castAdd n) j : maximalIdeal S) : S) ∈
            Ideal.span (Set.range fun i ↦ (((xbar ∘ Fin.castAdd n) i : maximalIdeal S) : S)))

/-- Helper for Lemma 10.60.14: in a system of parameters of length `m + n`, quotienting by the
first `m` parameters leaves Krull dimension `n`. -/
lemma ringKrullDim_quotient_parameterIdeal_castAdd_eq_aux :
    ∀ m : ℕ, ∀ {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] {n : ℕ},
      (x : Fin (m + n) → maximalIdeal A) → IsSystemOfParameters x →
        ringKrullDim (A ⧸ parameterIdeal (x ∘ Fin.castAdd n)) = n
  | 0, A, _, _, _, n, x, hx => by
      -- The empty prefix generates the zero ideal, so the quotient is just the original ring.
      have hbot : parameterIdeal (x ∘ Fin.castAdd n) = (⊥ : Ideal A) := by
        rw [parameterIdeal_eq_span]
        simp
      calc
        ringKrullDim (A ⧸ parameterIdeal (x ∘ Fin.castAdd n))
            = ringKrullDim (A ⧸ (⊥ : Ideal A)) := by rw [hbot]
        _ = ringKrullDim A := ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot A)
        _ = n := by simpa using hx.1
  | m + 1, A, _, _, _, n, x, hx => by
      let y : Fin ((m + n) + 1) → maximalIdeal A := reassocParameterFamily x
      let I : Ideal A := headParameterIdeal y
      let S := A ⧸ I
      letI : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr (headParameterIdeal_ne_top y)
      letI : IsLocalRing S :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      let xbar : Fin (m + n) → maximalIdeal S := fun i ↦
        ⟨Ideal.Quotient.mk I (((x (tailParameterIndex i) : maximalIdeal A) : A)),
          tailParameterIndex_mem_maximalIdeal x i⟩
      have hy : IsSystemOfParameters y := by
        refine (isSystemOfParameters_iff_of_ringKrullDim_eq ?_ y).2 ?_
        · simpa [y, Nat.add_right_comm m 1 n] using hx.1
        · have hparam : parameterIdeal y = parameterIdeal x := by
            simpa [y] using parameterIdeal_reassoc_eq (A := A) x
          exact hparam.symm ▸ hx.2
      have hdimS : ringKrullDim S = m + n := by
        -- The head quotient has exactly one less dimension.
        simpa [I, S, y] using ringKrullDim_quotient_head_eq_of_systemOfParameters (A := A) y hy
      have hsysbar : IsSystemOfParameters xbar := by
        -- The quotient tail is again a system of parameters in the head quotient.
        exact (isSystemOfParameters_iff_of_ringKrullDim_eq hdimS xbar).2 <|
          by
            simpa [xbar, y, reassocParameterFamily, tailParameterIndex] using
              quotient_tail_parameterIdeal_isIdealOfDefinition (A := A) y hy
      have hI_le_prefix : I ≤ parameterIdeal (x ∘ Fin.castAdd n) := by
        -- The longer prefix ideal still contains the head generator.
        dsimp [I, y, reassocParameterFamily, headParameterIdeal]
        exact (Ideal.span_singleton_le_iff_mem
          (I := parameterIdeal (x ∘ Fin.castAdd n)) (x := ((x 0 : maximalIdeal A) : A))).2 <|
          by
            rw [parameterIdeal_eq_span]
            exact Ideal.subset_span ⟨0, rfl⟩
      have hmap :
          parameterIdeal (xbar ∘ Fin.castAdd n) =
            Ideal.map (Ideal.Quotient.mk I) (parameterIdeal (x ∘ Fin.castAdd n)) := by
        -- Passing to the quotient only removes the head generator from the chosen prefix family.
        simpa [I, S, xbar, y, reassocParameterFamily, tailParameterIndex] using
          map_parameterIdeal_prefix_eq_tail_prefix (A := A) x
      let e :
          (S ⧸ parameterIdeal (xbar ∘ Fin.castAdd n)) ≃+*
            A ⧸ parameterIdeal (x ∘ Fin.castAdd n) :=
        (Ideal.quotEquivOfEq hmap).trans (DoubleQuot.quotQuotEquivQuotOfLE hI_le_prefix)
      calc
        ringKrullDim (A ⧸ parameterIdeal (x ∘ Fin.castAdd n))
            = ringKrullDim (S ⧸ parameterIdeal (xbar ∘ Fin.castAdd n)) := by
                symm
                exact ringKrullDim_eq_of_ringEquiv e
        _ = n := ringKrullDim_quotient_parameterIdeal_castAdd_eq_aux m xbar hsysbar

/-- Helper for Lemma 10.60.14: the `castAdd` induction statement specialized to the current ring. -/
lemma ringKrullDim_quotient_parameterIdeal_castAdd_eq {m n : ℕ}
    (x : Fin (m + n) → maximalIdeal R) (hx : IsSystemOfParameters x) :
    ringKrullDim (R ⧸ parameterIdeal (x ∘ Fin.castAdd n)) = n := by
  -- This is the fixed-ring specialization of the ambient induction theorem.
  exact ringKrullDim_quotient_parameterIdeal_castAdd_eq_aux m x hx

/-- Helper for Lemma 10.60.14: reindexing a parameter family along a `Fin`-cast does not change
its generated ideal. -/
lemma parameterIdeal_cast_eq {A : Type u} [CommRing A] [IsLocalRing A] {d e : ℕ}
    (h : e = d) (x : Fin d → maximalIdeal A) :
    parameterIdeal (x ∘ Fin.cast h) = parameterIdeal x := by
  -- A cast along an equality only reindexes the same finite family.
  rw [parameterIdeal_eq_span, parameterIdeal_eq_span]
  congr 1
  ext r
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast h i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast h.symm i, by simp⟩

/-- Helper for Lemma 10.60.14: after reindexing a length-`d` family as a family of length
`i + (d - i)`, the `castAdd` prefix is the original `castLE` prefix. -/
lemma parameterIdeal_castLE_eq_parameterIdeal_castAdd {A : Type u} [CommRing A] [IsLocalRing A]
    {d i : ℕ} (x : Fin d → maximalIdeal A) (hi : i ≤ d) :
    let x' : Fin (i + (d - i)) → maximalIdeal A := x ∘ Fin.cast (Nat.add_sub_of_le hi)
    parameterIdeal (x ∘ Fin.castLE hi) = parameterIdeal (x' ∘ Fin.castAdd (d - i)) := by
  let x' : Fin (i + (d - i)) → maximalIdeal A := x ∘ Fin.cast (Nat.add_sub_of_le hi)
  -- The two prefixes pick the same first `i` entries after the obvious length identification.
  suffices
      hspan :
        Ideal.span (Set.range fun j ↦ (((x ∘ Fin.castLE hi) j : maximalIdeal A) : A)) =
          Ideal.span (Set.range fun j ↦ (((x' ∘ Fin.castAdd (d - i)) j : maximalIdeal A) : A)) by
    simpa [parameterIdeal_eq_span, x', Function.comp] using hspan
  congr 1

-- Source/core/bridge triage:
-- * source-facing: `ringKrullDim_quotient_parameterIdeal_eq_sub` states Lemma 10.60.14 for a
--   chosen system of parameters and the parameter ideals of its prefixes;
-- * core/canonical: `IsSystemOfParameters` together with `parameterIdeal` is the owner abstraction
--   for a chosen parameter family in `maximalIdeal R`, so the prefix ideal is derived as
--   `parameterIdeal (x ∘ Fin.castLE hi)` rather than stored as extra primitive data;
-- * bridge/view: `ringKrullDim_quotient_initialSegmentIdeal_eq_sub` converts an unbundled
--   sequence `x : Fin d → R` with the source generated-ideal hypothesis into that owner theorem.
-- Proof sketch: for `i > 0` one argues by induction on `i`. The step uses the one-element
-- dimension drop from Lemma 10.60.13 inside the quotient by the
-- first `i` generators and the fact that ideals of definition remain ideals of definition after
-- passing to successive quotients.
/-- Lemma 10.60.14, owner-level form: if `x : Fin d → maximalIdeal R` is a system of parameters,
then quotienting by the parameter ideal of its first `i` entries lowers the Krull dimension to
`d - i`. -/
theorem ringKrullDim_quotient_parameterIdeal_eq_sub {d i : ℕ} (x : Fin d → maximalIdeal R)
    (hx : IsSystemOfParameters x) (hi : i ≤ d) :
    ringKrullDim (R ⧸ parameterIdeal (x ∘ Fin.castLE hi)) = d - i := by
  let x' : Fin (i + (d - i)) → maximalIdeal R := x ∘ Fin.cast (Nat.add_sub_of_le hi)
  have hsys' : IsSystemOfParameters x' := by
    -- Reindex the full family first so the induction can run on a clean `castAdd` prefix.
    refine (isSystemOfParameters_iff_of_ringKrullDim_eq ?_ x').2 ?_
    · simpa [x', Nat.add_sub_of_le hi] using hx.1
    · have hparam : parameterIdeal x' = parameterIdeal x := by
        simpa [x'] using parameterIdeal_cast_eq (A := R) (Nat.add_sub_of_le hi) x
      exact hparam.symm ▸ hx.2
  have hprefix :
      parameterIdeal (x ∘ Fin.castLE hi) = parameterIdeal (x' ∘ Fin.castAdd (d - i)) := by
    -- This is the only remaining interface adjustment between `castLE` and `castAdd`.
    simpa [x'] using parameterIdeal_castLE_eq_parameterIdeal_castAdd (A := R) x hi
  -- The clean `castAdd` induction statement now closes the source-facing `castLE` theorem.
  calc
    ringKrullDim (R ⧸ parameterIdeal (x ∘ Fin.castLE hi))
        = ringKrullDim (R ⧸ parameterIdeal (x' ∘ Fin.castAdd (d - i))) := by rw [hprefix]
    _ = d - i := ringKrullDim_quotient_parameterIdeal_castAdd_eq x' hsys'

/-- Lemma 10.60.14 in bridge/view form: for an unbundled sequence `x : Fin d → R`, quotienting by
the ideal generated by any initial segment of a system of parameters lowers the dimension by its
length. The source's positive-length case is the corresponding specialization. -/
theorem ringKrullDim_quotient_initialSegmentIdeal_eq_sub {d i : ℕ} (x : Fin d → R)
    (hdef : Ideal.IsIdealOfDefinition (Ideal.span (Set.range x))) (hdim : ringKrullDim R = d)
    (hi : i ≤ d) :
    ringKrullDim (R ⧸ Ideal.span (Set.range (x ∘ Fin.castLE hi))) = d - i := by
  have hx : ∀ j, x j ∈ maximalIdeal R := fun j ↦ by
    rw [← hdef]
    exact Ideal.le_radical (Ideal.subset_span ⟨j, rfl⟩)
  let x' : Fin d → maximalIdeal R := fun j ↦ ⟨x j, hx j⟩
  have hsys : IsSystemOfParameters x' :=
    (isSystemOfParameters_iff_of_ringKrullDim_eq hdim x').2 <|
      by simpa [x', parameterIdeal_eq_span] using hdef
  simpa [x', parameterIdeal_eq_span] using
    ringKrullDim_quotient_parameterIdeal_eq_sub x' hsys hi

end
