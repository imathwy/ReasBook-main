/-! ### Definition_10_67_1 (from Chap10) -/
universe u v

section

variable (R : Type u) (M : Type v) [CommRing R] [AddCommGroup M] [Module R M]

/- Domain triage: this item lies in commutative algebra of associated primes of modules.
Sampled declarations in this domain are the chapter's source-facing `associatedPrimesOfModule`,
the chapter bridge `associatedPrimesOfModule_eq_associatedPrimes`, and mathlib's owner
`associatedPrimes` / `IsAssociatedPrime`. The numbered item has two `source-facing` layers:
the module-level owner `embeddedAssociatedPrimes R M`, and the ring-level specialization
`embeddedPrimes R := embeddedAssociatedPrimes R R`. Both are derived data on top of the owner set
of associated primes rather than primitive module data. -/

/-- Definition 10.67.1: the embedded associated primes of the `R`-module `M` are the associated
primes of `M` that are not minimal among the associated primes of `M`. -/
def embeddedAssociatedPrimes : Set (Ideal R) :=
  { p |
      p ∈ associatedPrimesOfModule R M ∧
        ¬ Minimal (· ∈ associatedPrimesOfModule R M) p }

/-- A prime ideal is an embedded associated prime exactly when it is associated to `M` and is not
minimal among the associated primes of `M`. -/
@[simp] theorem mem_embeddedAssociatedPrimes_iff (p : Ideal R) :
    p ∈ embeddedAssociatedPrimes R M ↔
      p ∈ associatedPrimesOfModule R M ∧
        ¬ Minimal (· ∈ associatedPrimesOfModule R M) p :=
  Iff.rfl

/-- Over a Noetherian ring, the embedded associated primes of `M` can be read using mathlib's
`associatedPrimes R M`. -/
theorem mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes [IsNoetherianRing R]
    (p : Ideal R) :
    p ∈ embeddedAssociatedPrimes R M ↔
      p ∈ associatedPrimes R M ∧
        ¬ Minimal (· ∈ associatedPrimes R M) p := by
  simp [embeddedAssociatedPrimes, associatedPrimesOfModule_eq_associatedPrimes R M]

/-- Over a Noetherian ring, `M` has no embedded associated primes exactly when every associated
prime of `M` is minimal among the associated primes of `M`. -/
theorem embeddedAssociatedPrimes_eq_empty_iff [IsNoetherianRing R] :
    embeddedAssociatedPrimes R M = ∅ ↔
      ∀ p ∈ associatedPrimes R M, Minimal (· ∈ associatedPrimes R M) p := by
  constructor
  · intro h p hp
    by_contra hp_min
    have hp_emb : p ∈ embeddedAssociatedPrimes R M := by
      rw [mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes]
      exact ⟨hp, hp_min⟩
    simp [h] at hp_emb
  · intro h
    ext p
    constructor
    · intro hp
      rw [mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes] at hp
      exact (hp.2 (h p hp.1)).elim
    · intro hp
      exact hp.elim

end

section

variable (R : Type u) [CommRing R]

/-- Definition 10.67.1, ring specialization: the embedded primes of `R` are the embedded
associated primes of `R` viewed as an `R`-module. -/
abbrev embeddedPrimes : Set (Ideal R) :=
  embeddedAssociatedPrimes R R

/-- A prime ideal is an embedded prime of `R` exactly when it is an embedded associated prime of
`R` as a module over itself. -/
@[simp] theorem mem_embeddedPrimes_iff (p : Ideal R) :
    p ∈ embeddedPrimes R ↔ p ∈ embeddedAssociatedPrimes R R :=
  Iff.rfl

/-- A prime ideal is an embedded prime of `R` exactly when it is associated to `R` and is not
minimal among the associated primes of `R`. -/
@[simp] theorem mem_embeddedPrimes_iff_mem_associatedPrimes [IsNoetherianRing R] (p : Ideal R) :
    p ∈ embeddedPrimes R ↔
      p ∈ associatedPrimes R R ∧
        ¬ Minimal (· ∈ associatedPrimes R R) p := by
  exact mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes R R p

/-- The ring `R` has no embedded primes exactly when every associated prime of `R` is minimal
among the associated primes of `R`. -/
theorem embeddedPrimes_eq_empty_iff [IsNoetherianRing R] :
    embeddedPrimes R = ∅ ↔
      ∀ p ∈ associatedPrimes R R, Minimal (· ∈ associatedPrimes R R) p := by
  exact embeddedAssociatedPrimes_eq_empty_iff R R

end

/-! ### Lemma_10_67_2 (from Chap10) -/
universe u v

open PrimeSpectrum Module.associatedPrimes TopologicalSpace

section

variable (R : Type u) [CommRing R]
variable (M : Type v) [AddCommGroup M] [Module R M]

/-- The support of a cyclic submodule generated by an element of `N` is contained in the support of
`N`. -/
private theorem support_cyclic_subset_of_submodule {N : Submodule R M} {m : M} (hm : m ∈ N) :
    Module.support R (R ∙ m) ⊆ Module.support R N := by
  exact Module.support_subset_of_injective (Submodule.inclusion <|
    (Submodule.span_singleton_le_iff_mem m N).2 hm) (Submodule.inclusion_injective _)

/-- The support of a product of modules is the union of the supports of its factors. -/
private theorem support_prod_eq_union (N P : Submodule R M) :
    Module.support R (N × P) = Module.support R N ∪ Module.support R P := by
  have hExact : Function.Exact (LinearMap.inl R N P) (LinearMap.snd R N P) :=
    Function.Exact.inl_snd
  simpa using
    (Module.support_of_exact hExact LinearMap.inl_injective LinearMap.snd_surjective)

/-- The support of a supremum of two submodules is contained in the union of their supports. -/
private theorem support_sup_subset_union (N P : Submodule R M) :
    Module.support R ↥(N ⊔ P) ⊆ Module.support R N ∪ Module.support R P := by
  let φ : N × P →ₗ[R] ↥(N ⊔ P) :=
    (N.subtype.coprod P.subtype).codRestrict (N ⊔ P) fun z ↦
      Submodule.mem_sup.2 ⟨z.1, z.1.2, z.2, z.2.2, rfl⟩
  have hφ : Function.Surjective φ := by
    intro z
    rcases Submodule.mem_sup.mp z.2 with ⟨x, hx, y, hy, hxy⟩
    refine ⟨(⟨x, hx⟩, ⟨y, hy⟩), ?_⟩
    ext
    exact hxy
  exact (Module.support_subset_of_surjective φ hφ).trans <| by
    simp [support_prod_eq_union R M N P]

/-- The canonical submodule from Lemma 10.67.2: the elements whose cyclic support is contained in
the union of the zero loci of the embedded associated primes of `M`. -/
def embeddedPrimeFreeSubmodule : Submodule R M where
  carrier := { m | Module.support R (R ∙ m) ⊆
    ⋃ p ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus p }
  zero_mem' := by
    intro p hp
    letI : Subsingleton ↥(R ∙ (0 : M)) :=
      (Submodule.subsingleton_iff_eq_bot.2 <| Submodule.span_singleton_eq_bot.2 rfl)
    have hsupp : Module.support R ↥(R ∙ (0 : M)) = ∅ := Module.support_eq_empty
    rw [hsupp] at hp
    exact hp.elim
  add_mem' := by
    intro m n hm hn
    exact (support_cyclic_subset_of_submodule R M <|
        Submodule.mem_sup.2 ⟨m, Submodule.mem_span_singleton_self m, n,
          Submodule.mem_span_singleton_self n, rfl⟩).trans <|
      (support_sup_subset_union R M (R ∙ m) (R ∙ n)).trans <|
        Set.union_subset hm hn
  smul_mem' := by
    intro r m hm
    exact (support_cyclic_subset_of_submodule R M <|
      Submodule.smul_mem (R ∙ m) r (Submodule.mem_span_singleton_self m)).trans hm

/-- An element lies in the canonical submodule from Lemma 10.67.2 exactly when the support of its
cyclic submodule is contained in the embedded-prime locus. This is the source-text definition of
the construction. -/
theorem mem_embeddedPrimeFreeSubmodule_iff (m : M) :
    m ∈ embeddedPrimeFreeSubmodule R M ↔
      Module.support R (R ∙ m) ⊆
        ⋃ p ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus p :=
  Iff.rfl

end

section

variable (R : Type u) [CommRing R] [IsNoetherianRing R]
variable (M : Type v) [AddCommGroup M] [Module R M] [Module.Finite R M]

/-- Helper for Lemma 10.67.2: the support of a submodule, viewed as a subset of `Supp(M)`. -/
private abbrev supportWithin (K : Submodule R M) : Set (Module.support R M) :=
  { p | (p : PrimeSpectrum R) ∈ Module.support R K }

/-- Helper for Lemma 10.67.2: the relative support of a finite submodule is closed in
`Supp(M)`. -/
private theorem isClosed_supportWithin (K : Submodule R M) :
    IsClosed (supportWithin R M K) := by
  -- The relative support is just the inverse image of the ambient support under the subtype map.
  simpa [supportWithin] using
    (Module.isClosed_support (R := R) (M := ↥K)).preimage continuous_subtype_val

/-- Helper for Lemma 10.67.2: a prime point is minimal in `Supp(M)` exactly when its ideal is a
minimal prime of `Ann(M)`. -/
private theorem minimal_support_iff_mem_annihilator_minimalPrimes
    (p : PrimeSpectrum R) :
    Minimal (· ∈ Module.support R M) p ↔
      p.asIdeal ∈ (Module.annihilator R M).minimalPrimes := by
  constructor
  · intro hp
    refine ⟨⟨p.2, (Module.mem_support_iff_of_finite (R := R) (M := M) (p := p)).mp hp.1⟩, ?_⟩
    intro q hq hqp
    have hqSupport : (⟨q, hq.1⟩ : PrimeSpectrum R) ∈ Module.support R M := by
      exact Module.mem_support_iff_of_finite.mpr hq.2
    exact hp.2 hqSupport hqp
  · intro hp
    refine ⟨Module.mem_support_iff_of_finite.mpr hp.1.2, ?_⟩
    intro q hq hqp
    obtain ⟨r, hr, hrq⟩ := Ideal.exists_minimalPrimes_le
      ((Module.mem_support_iff_of_finite (R := R) (M := M) (p := q)).mp hq)
    have hpr : p.asIdeal ≤ r := hp.2 hr.1 (hrq.trans hqp)
    exact hpr.trans hrq

/-- Helper for Lemma 10.67.2: a minimal support point admits a principal neighborhood inside
`Supp(M)` that stays inside its irreducible component. -/
private theorem exists_basicOpen_inter_support_subset_zeroLocus_of_minimal_support
    {p : PrimeSpectrum R} (hp : Minimal (· ∈ Module.support R M) p) :
    ∃ f : R,
      f ∉ p.asIdeal ∧
        Module.support R M ∩ PrimeSpectrum.basicOpen f ⊆ PrimeSpectrum.zeroLocus p.asIdeal := by
  classical
  have hpMin :
      p.asIdeal ∈ (Module.annihilator R M).minimalPrimes :=
    (minimal_support_iff_mem_annihilator_minimalPrimes (R := R) (M := M) p).mp hp
  let minimalPrimesFinset : Finset (Ideal R) :=
    (Ideal.finite_minimalPrimes_of_isNoetherianRing R (Module.annihilator R M)).toFinset
  let others : Finset (Ideal R) := minimalPrimesFinset.erase p.asIdeal
  have hchoose :
      ∀ q ∈ others, ∃ a : R, a ∈ q ∧ a ∉ p.asIdeal := by
    intro q hq
    have hqMin : q ∈ (Module.annihilator R M).minimalPrimes := by
      have hqFinset : q ∈ minimalPrimesFinset := (Finset.mem_erase.mp hq).2
      simpa [minimalPrimesFinset] using hqFinset
    have hqne : q ≠ p.asIdeal := by
      simpa [others] using Finset.mem_erase.mp hq |>.1
    have hnotle : ¬ q ≤ p.asIdeal := by
      intro hle
      exact hqne (le_antisymm hle (hpMin.2 hqMin.1 hle))
    exact Set.not_subset.mp hnotle
  choose a ha_mem ha_not_mem using hchoose
  let g : Ideal R → R := fun q ↦ if h : q ∈ others then a q h else 1
  let f : R := others.prod g
  refine ⟨f, ?_, ?_⟩
  · -- The product avoids `p` because each factor was chosen outside `p`.
    exact p.asIdeal.primeCompl.prod_mem fun q hq ↦ by
      simpa [g, hq] using ha_not_mem q hq
  · intro r hr
    rcases hr with ⟨hrSupport, hrBasic⟩
    obtain ⟨q, hqMin, hqr⟩ := Ideal.exists_minimalPrimes_le
      ((Module.mem_support_iff_of_finite (R := R) (M := M) (p := r)).mp hrSupport)
    by_cases hqp : q = p.asIdeal
    · simpa [PrimeSpectrum.mem_zeroLocus, hqp] using hqr
    · have hqOthers : q ∈ others := by
        have hqFinset : q ∈ minimalPrimesFinset := by
          simpa [minimalPrimesFinset] using hqMin
        simpa [others, hqp] using Finset.mem_erase.mpr ⟨hqp, hqFinset⟩
      have haq : a q hqOthers ∈ q := ha_mem q hqOthers
      have haf : f ∈ q := by
        have hgq : g q ∈ q := by
          simpa [g, hqOthers] using haq
        exact Ideal.mem_of_dvd _ (Finset.dvd_prod_of_mem g hqOthers) hgq
      have hfq : f ∉ r.asIdeal := (PrimeSpectrum.mem_basicOpen f r).mp hrBasic
      exact (hfq <| hqr haf).elim

/-- Helper for Lemma 10.67.2: the relative support of a submodule is nowhere dense in `Supp(M)`
exactly when it misses every minimal support point of `M`. -/
private theorem submodule_support_nowhereDense_iff_avoids_minimal_support
    (K : Submodule R M) :
    IsNowhereDense (supportWithin R M K) ↔
      ∀ p : PrimeSpectrum R, Minimal (· ∈ Module.support R M) p → p ∉ Module.support R K := by
  constructor
  · intro hK p hp hpK
    obtain ⟨f, hf, hsubset⟩ :=
      exists_basicOpen_inter_support_subset_zeroLocus_of_minimal_support
        (R := R) (M := M) hp
    have hzeroSubset : PrimeSpectrum.zeroLocus p.asIdeal ⊆ Module.support R K := by
      intro q hq
      exact Module.mem_support_iff_of_finite.mpr <|
        ((Module.mem_support_iff_of_finite (R := R) (M := ↥K) (p := p)).mp hpK).trans <|
          (PrimeSpectrum.mem_zeroLocus q p.asIdeal).mp hq
    let U : Set (Module.support R M) :=
      { q | (q : PrimeSpectrum R) ∈ PrimeSpectrum.basicOpen f }
    have hUopen : IsOpen U := by
      change IsOpen (Subtype.val ⁻¹' (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R)))
      exact (PrimeSpectrum.isOpen_basicOpen (a := f)).preimage continuous_subtype_val
    have hUnonempty : U.Nonempty := by
      refine ⟨⟨p, hp.1⟩, ?_⟩
      simpa [U, PrimeSpectrum.mem_basicOpen] using hf
    have hUsub : U ⊆ supportWithin R M K := by
      intro q hq
      have hqZero :
          (q : PrimeSpectrum R) ∈ PrimeSpectrum.zeroLocus p.asIdeal := by
        exact hsubset ⟨q.2, hq⟩
      exact hzeroSubset hqZero
    rcases hUnonempty with ⟨q, hqU⟩
    have hqInterior : q ∈ interior (supportWithin R M K) := by
      exact mem_interior_iff_mem_nhds.mpr <|
        Filter.mem_of_superset (IsOpen.mem_nhds hUopen hqU) hUsub
    have hInteriorEmpty :
        interior (supportWithin R M K) = ∅ :=
      (isClosed_supportWithin (R := R) (M := M) K).isNowhereDense_iff.mp hK
    rw [hInteriorEmpty] at hqInterior
    exact hqInterior.elim
  · intro havoid
    have hclosed := isClosed_supportWithin (R := R) (M := M) K
    rw [hclosed.isNowhereDense_iff]
    apply Set.Subset.antisymm
    · intro x hx
      -- Any nonempty relative open subset of `Supp(M)` contains a minimal support point.
      let U : Set (Module.support R M) := interior (supportWithin R M K)
      have hUopen : IsOpen U := isOpen_interior
      have hxU : x ∈ U := hx
      rcases hUopen with ⟨V, hVopen, hVeq⟩
      have hxV : (x : PrimeSpectrum R) ∈ V := by
        have : x ∈ Subtype.val ⁻¹' V := by simpa [hVeq] using hxU
        simpa [U] using this
      obtain ⟨q, hqMin, hqx⟩ := Ideal.exists_minimalPrimes_le
        ((Module.mem_support_iff_of_finite (R := R) (M := M) (p := (x : PrimeSpectrum R))).mp x.2)
      let q' : PrimeSpectrum R := ⟨q, hqMin.1.1⟩
      have hqMinSupport :
          Minimal (· ∈ Module.support R M) q' :=
        (minimal_support_iff_mem_annihilator_minimalPrimes (R := R) (M := M) q').mpr hqMin
      have hqV : q' ∈ V := by
        exact ((PrimeSpectrum.le_iff_specializes q' (x : PrimeSpectrum R)).mp hqx).mem_open hVopen hxV
      have hqU : (⟨q', hqMinSupport.1⟩ : Module.support R M) ∈ U := by
        simpa [hVeq] using
          show (⟨q', hqMinSupport.1⟩ : Module.support R M) ∈ Subtype.val ⁻¹' V from hqV
      have hqK : q' ∈ Module.support R K := by
        have hqInterior : (⟨q', hqMinSupport.1⟩ : Module.support R M) ∈
            interior (supportWithin R M K) := by
          simpa [U] using hqU
        exact (show (⟨q', hqMinSupport.1⟩ : Module.support R M) ∈ supportWithin R M K from
          interior_subset hqInterior)
      exact havoid q' hqMinSupport hqK
    · exact Set.empty_subset _

/-- Helper for Lemma 10.67.2: an element of a nowhere-dense submodule has cyclic support contained
in the embedded-prime locus of the ambient module. -/
private theorem cyclic_support_subset_embedded_locus_of_mem_nowhereDense_submodule
    {K : Submodule R M}
    (hK : IsNowhereDense (supportWithin R M K)) {m : M} (hm : m ∈ K) :
    Module.support R (R ∙ m) ⊆
      ⋃ p ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus p := by
  intro p hp
  obtain ⟨q, hqMin, hqp⟩ := Ideal.exists_minimalPrimes_le
    ((Module.mem_support_iff_of_finite (R := R) (M := ↥(R ∙ m)) (p := p)).mp hp)
  let q' : PrimeSpectrum R := ⟨q, hqMin.1.1⟩
  have hqMinSupportSpan :
      Minimal (· ∈ Module.support R ↥(R ∙ m)) q' :=
    (minimal_support_iff_mem_annihilator_minimalPrimes (R := R) (M := ↥(R ∙ m)) q').mpr hqMin
  have hqSupportK : q' ∈ Module.support R K := by
    exact (support_cyclic_subset_of_submodule (R := R) (M := M) hm) hqMinSupportSpan.1
  have hqNotMinM : ¬ Minimal (· ∈ Module.support R M) q' := by
    intro hqMinM
    exact
      ((submodule_support_nowhereDense_iff_avoids_minimal_support (R := R) (M := M) K).mp hK
        q' hqMinM) hqSupportK
  have hqAssocSpan : q ∈ associatedPrimes R ↥(R ∙ m) := by
    simpa using
      (Module.minimal_support_mem_associatedPrimes (R := R) (M := ↥(R ∙ m)) q'
        hqMinSupportSpan)
  have hqAssocM : q ∈ associatedPrimes R M :=
    associatedPrimes.subset_of_injective (R ∙ m).subtype_injective hqAssocSpan
  have hqEmb : q ∈ embeddedAssociatedPrimes R M := by
    rw [mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes]
    refine ⟨hqAssocM, ?_⟩
    intro hqMinAssoc
    exact hqNotMinM
      ((minimal_support_iff_minimal_associatedPrimes (R := R) (M := M) q').2 hqMinAssoc)
  exact Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hqEmb, (PrimeSpectrum.mem_zeroLocus p q).2 hqp⟩⟩

/-- Helper for Lemma 10.67.2: every associated prime of the canonical submodule is embedded in the
ambient module. -/
private theorem associatedPrimes_embeddedPrimeFreeSubmodule_subset_embedded :
    associatedPrimes R (embeddedPrimeFreeSubmodule R M) ⊆ embeddedAssociatedPrimes R M := by
  intro p hp
  have hpAssocM : p ∈ associatedPrimes R M :=
    associatedPrimes.subset_of_injective (embeddedPrimeFreeSubmodule R M).subtype_injective hp
  rw [AssociatedPrimes.mem_iff, isAssociatedPrime_iff] at hp
  rcases hp with ⟨hpPrime, x, hxAnn⟩
  let N : Submodule R ↥(embeddedPrimeFreeSubmodule R M) := R ∙ x
  have hNAnn : Module.annihilator R N = p := by
    ext r
    simpa [N, Submodule.annihilator_span_singleton] using
      (congrArg (fun I ↦ r ∈ I) hxAnn).symm
  have hpMinN : p ∈ (Module.annihilator R N).minimalPrimes := by
    simpa [hNAnn] using
      (show p ∈ p.minimalPrimes by
        rw [Ideal.minimalPrimes_eq_subsingleton_self]
        simp)
  have hpAssocN : p ∈ associatedPrimes R N :=
    Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes R N hpMinN
  have hpAssocSpan : p ∈ associatedPrimes R ↥(R ∙ (x : M)) := by
    have hpAssocMap : p ∈ associatedPrimes R ↥(N.map (embeddedPrimeFreeSubmodule R M).subtype) := by
      rw [← LinearEquiv.AssociatedPrimes.eq ((embeddedPrimeFreeSubmodule R M).equivSubtypeMap N)]
      exact hpAssocN
    rw [Submodule.map_subtype_span_singleton] at hpAssocMap
    simpa [N] using hpAssocMap
  have hpAssocPoint :
      (⟨p, hpPrime⟩ : PrimeSpectrum R) ∈
        PrimeSpectrum.asIdeal ⁻¹' associatedPrimes R ↥(R ∙ (x : M)) := by
    simpa using hpAssocSpan
  have hpSupportSpan : (⟨p, hpPrime⟩ : PrimeSpectrum R) ∈ Module.support R ↥(R ∙ (x : M)) :=
    Module.associatedPrimes_subset_support hpAssocPoint
  have hxSupportSubset :
      Module.support R (R ∙ (x : M)) ⊆
        ⋃ q ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus q :=
    (mem_embeddedPrimeFreeSubmodule_iff (R := R) (M := M) (x : M)).mp x.2
  have hpInUnion :
      (⟨p, hpPrime⟩ : PrimeSpectrum R) ∈
        ⋃ q ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus q :=
    hxSupportSubset hpSupportSpan
  rcases Set.mem_iUnion.1 hpInUnion with ⟨q, hq⟩
  rcases Set.mem_iUnion.1 hq with ⟨hqEmb, hpZero⟩
  rw [mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes]
  refine ⟨hpAssocM, ?_⟩
  intro hpMinAssoc
  have hqAssocM : q ∈ associatedPrimes R M :=
    (mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes (R := R) (M := M) q).mp hqEmb |>.1
  have hpLeQ : p ≤ q := hpMinAssoc.2 hqAssocM ((PrimeSpectrum.mem_zeroLocus ⟨p, hpPrime⟩ q).mp hpZero)
  have hqEq : q = p := le_antisymm ((PrimeSpectrum.mem_zeroLocus ⟨p, hpPrime⟩ q).mp hpZero) hpLeQ
  have hpEmb : p ∈ embeddedAssociatedPrimes R M := by
    simpa [hqEq] using hqEmb
  exact
    ((mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes (R := R) (M := M) p).mp hpEmb).2
      hpMinAssoc

/-- Helper for Lemma 10.67.2: the support of the canonical submodule lies in the embedded-prime
locus. -/
private theorem support_embeddedPrimeFreeSubmodule_subset_embedded_locus :
    Module.support R (embeddedPrimeFreeSubmodule R M) ⊆
      ⋃ p ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus p := by
  intro q hq
  obtain ⟨p, hpMin, hpq⟩ := Ideal.exists_minimalPrimes_le
    ((Module.mem_support_iff_of_finite (R := R) (M := ↥(embeddedPrimeFreeSubmodule R M)) (p := q)).mp hq)
  have hpAssoc :
      p ∈ associatedPrimes R (embeddedPrimeFreeSubmodule R M) :=
    Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes R
      (embeddedPrimeFreeSubmodule R M) hpMin
  have hpEmb : p ∈ embeddedAssociatedPrimes R M :=
    associatedPrimes_embeddedPrimeFreeSubmodule_subset_embedded (R := R) (M := M) hpAssoc
  exact Set.mem_iUnion.2 ⟨p, Set.mem_iUnion.2 ⟨hpEmb, (PrimeSpectrum.mem_zeroLocus q p).2 hpq⟩⟩

/-- Helper for Lemma 10.67.2: a closed subset of `Supp(M)` that contains every minimal support
point is all of `Supp(M)`. -/
private theorem closed_subset_eq_support_of_contains_minimal_support
    {s : Set (PrimeSpectrum R)} (hsClosed : IsClosed s) (hsSubset : s ⊆ Module.support R M)
    (hmin : ∀ p : PrimeSpectrum R, Minimal (· ∈ Module.support R M) p → p ∈ s) :
    s = Module.support R M := by
  refine Set.Subset.antisymm hsSubset ?_
  intro p hpSupport
  by_contra hpNot
  obtain ⟨q, hqMin, hqp⟩ := Ideal.exists_minimalPrimes_le
    ((Module.mem_support_iff_of_finite (R := R) (M := M) (p := p)).mp hpSupport)
  let q' : PrimeSpectrum R := ⟨q, hqMin.1.1⟩
  have hqMinSupport :
      Minimal (· ∈ Module.support R M) q' :=
    (minimal_support_iff_mem_annihilator_minimalPrimes (R := R) (M := M) q').mpr hqMin
  have hqNotS : q' ∉ s := by
    exact ((PrimeSpectrum.le_iff_specializes q' p).mp hqp).mem_open hsClosed.isOpen_compl hpNot
  exact hqNotS (hmin q' hqMinSupport)

/-- Helper for Lemma 10.67.2: if a localization of the kernel submodule is trivial, then the
localized quotient map is injective. -/
private theorem localized_mkQ_injective_of_subsingleton {S : Submonoid R}
    (K : Submodule R M) (hsub : Subsingleton (LocalizedModule S K)) :
    Function.Injective (LocalizedModule.map S K.mkQ) := by
  have hzero : LocalizedModule.map S K.subtype = 0 := by
    -- A linear map out of a subsingleton source is zero.
    ext x
    have hx : x = 0 := Subsingleton.elim x 0
    simpa [hx]
  have hExact :
      Function.Exact (LocalizedModule.map S K.subtype) (LocalizedModule.map S K.mkQ) :=
    LocalizedModule.map_exact S K.subtype K.mkQ (LinearMap.exact_subtype_mkQ K)
  have hker :
      LinearMap.ker (LocalizedModule.map S K.mkQ) = ⊥ := by
    calc
      LinearMap.ker (LocalizedModule.map S K.mkQ) =
          LinearMap.range (LocalizedModule.map S K.subtype) := hExact.linearMap_ker_eq
      _ = LinearMap.range (0 : LocalizedModule S K →ₗ[Localization S] LocalizedModule S M) := by
        rw [hzero]
      _ = ⊥ := LinearMap.range_zero
  exact LinearMap.ker_eq_bot.mp hker

/-- The canonical submodule from Lemma 10.67.2 is maximal among the submodules whose support is
nowhere dense in the support of `M`. -/
theorem embeddedPrimeFreeSubmodule_isMaximal_nowhereDense :
    Maximal
      (fun K : Submodule R M ↦
        IsNowhereDense { p : Module.support R M | (p : PrimeSpectrum R) ∈ Module.support R K })
      (embeddedPrimeFreeSubmodule R M) := by
  refine (maximal_iff).2 ?_
  constructor
  · -- The canonical submodule avoids every minimal support point because its associated primes are embedded.
    refine (submodule_support_nowhereDense_iff_avoids_minimal_support
      (R := R) (M := M) (embeddedPrimeFreeSubmodule R M)).2 ?_
    intro p hpMin hpSupportK
    obtain ⟨q, hqMin, hqp⟩ := Ideal.exists_minimalPrimes_le
      ((Module.mem_support_iff_of_finite (R := R) (M := ↥(embeddedPrimeFreeSubmodule R M))
        (p := p)).mp hpSupportK)
    have hqAssoc :
        q ∈ associatedPrimes R (embeddedPrimeFreeSubmodule R M) :=
      Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes R
        (embeddedPrimeFreeSubmodule R M) hqMin
    have hqEmb : q ∈ embeddedAssociatedPrimes R M :=
      associatedPrimes_embeddedPrimeFreeSubmodule_subset_embedded (R := R) (M := M) hqAssoc
    have hqAssocM : q ∈ associatedPrimes R M :=
      (mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes (R := R) (M := M) q).mp hqEmb |>.1
    have hpMinAssoc :
        Minimal (· ∈ associatedPrimes R M) p.asIdeal :=
      (minimal_support_iff_minimal_associatedPrimes (R := R) (M := M) p).mp hpMin
    have hpLeQ : p.asIdeal ≤ q := hpMinAssoc.2 hqAssocM hqp
    have hqEq : q = p.asIdeal := le_antisymm hqp hpLeQ
    have hpEmb : p.asIdeal ∈ embeddedAssociatedPrimes R M := by
      simpa [hqEq] using hqEmb
    exact
      ((mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes (R := R) (M := M) p.asIdeal).mp hpEmb).2
        hpMinAssoc
  · intro K hK hle
    apply le_antisymm hle
    intro m hm
    exact
      (mem_embeddedPrimeFreeSubmodule_iff (R := R) (M := M) m).2
        (cyclic_support_subset_embedded_locus_of_mem_nowhereDense_submodule
          (R := R) (M := M) hK hm)

/-- The quotient by the canonical submodule from Lemma 10.67.2 has the same support as `M`. -/
theorem support_quotient_embeddedPrimeFreeSubmodule :
    Module.support R (M ⧸ embeddedPrimeFreeSubmodule R M) =
      Module.support R M := by
  let K : Submodule R M := embeddedPrimeFreeSubmodule R M
  have hExactSupport :
      Module.support R M = Module.support R K ∪ Module.support R (M ⧸ K) := by
    simpa [K] using
      (Module.support_of_exact (LinearMap.exact_subtype_mkQ K) K.subtype_injective
        (Submodule.mkQ_surjective K))
  refine closed_subset_eq_support_of_contains_minimal_support
    (R := R) (M := M) (s := Module.support R (M ⧸ K)) Module.isClosed_support
    (Module.support_subset_of_surjective K.mkQ (Submodule.mkQ_surjective K)) ?_
  intro p hpMin
  have hpNotK :
      p ∉ Module.support R K :=
    (submodule_support_nowhereDense_iff_avoids_minimal_support
      (R := R) (M := M) K).mp
      (embeddedPrimeFreeSubmodule_isMaximal_nowhereDense (R := R) (M := M)).1 p hpMin
  have hpUnion : p ∈ Module.support R K ∪ Module.support R (M ⧸ K) := by
    rw [← hExactSupport]
    exact hpMin.1
  rcases hpUnion with hpK | hpQ
  · exact (hpNotK hpK).elim
  · exact hpQ

/-- The quotient by the canonical submodule from Lemma 10.67.2 has no embedded associated
primes. -/
theorem embeddedAssociatedPrimes_quotient_embeddedPrimeFreeSubmodule :
    embeddedAssociatedPrimes R (M ⧸ embeddedPrimeFreeSubmodule R M) = ∅ := by
  let K : Submodule R M := embeddedPrimeFreeSubmodule R M
  let Q : Type v := M ⧸ K
  rw [embeddedAssociatedPrimes_eq_empty_iff]
  intro p hp
  have hpPrime : p.IsPrime := (AssociatedPrimes.mem_iff.mp hp).isPrime
  let p' : PrimeSpectrum R := ⟨p, hpPrime⟩
  have hpAssocPoint : p' ∈ PrimeSpectrum.asIdeal ⁻¹' associatedPrimes R Q := by
    simpa [p'] using hp
  have hpSupportQ : p' ∈ Module.support R Q := Module.associatedPrimes_subset_support hpAssocPoint
  rw [AssociatedPrimes.mem_iff, isAssociatedPrime_iff] at hp
  rcases hp with ⟨_, mbar, hmbarAnn⟩
  obtain ⟨m, hmbar_eq⟩ := Submodule.mkQ_surjective K mbar
  have hmbar_ne : mbar ≠ 0 := by
    intro hmbar_zero
    have hpTop : p = ⊤ := by
      ext r
      simpa [hmbar_zero, Submodule.annihilator_span_singleton] using congrArg (fun I ↦ r ∈ I) hmbarAnn
    exact hpPrime.ne_top hpTop
  have hm_notK : m ∉ K := by
    intro hmK
    have hmbar_zero : mbar = 0 := by
      rw [← hmbar_eq]
      simpa [Submodule.Quotient.mk_eq_zero] using hmK
    exact hmbar_ne hmbar_zero
  have hm_support_not_subset :
      ¬ Module.support R (R ∙ m) ⊆
        ⋃ q ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus q := by
    simpa [mem_embeddedPrimeFreeSubmodule_iff] using hm_notK
  obtain ⟨q₀, hq₀Support, hq₀Out⟩ := Set.not_subset.mp hm_support_not_subset
  obtain ⟨q, hqMin, hqq₀⟩ := Ideal.exists_minimalPrimes_le
    ((Module.mem_support_iff_of_finite (R := R) (M := ↥(R ∙ m)) (p := q₀)).mp hq₀Support)
  let q' : PrimeSpectrum R := ⟨q, hqMin.1.1⟩
  have hqMinSupportSpan :
      Minimal (· ∈ Module.support R ↥(R ∙ m)) q' :=
    (minimal_support_iff_mem_annihilator_minimalPrimes (R := R) (M := ↥(R ∙ m)) q').mpr hqMin
  have hqAssocSpan : q ∈ associatedPrimes R ↥(R ∙ m) := by
    simpa using
      (Module.minimal_support_mem_associatedPrimes (R := R) (M := ↥(R ∙ m)) q'
        hqMinSupportSpan)
  have hqAssocM : q ∈ associatedPrimes R M :=
    associatedPrimes.subset_of_injective (R ∙ m).subtype_injective hqAssocSpan
  have hqOut :
      q' ∉ ⋃ q ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus q := by
    intro hqIn
    rcases Set.mem_iUnion.1 hqIn with ⟨r, hr⟩
    rcases Set.mem_iUnion.1 hr with ⟨hrEmb, hqZero⟩
    have hq₀Zero : q₀ ∈ PrimeSpectrum.zeroLocus r := by
      exact (PrimeSpectrum.mem_zeroLocus q₀ r).2
        ((PrimeSpectrum.mem_zeroLocus q' r).mp hqZero |>.trans hqq₀)
    exact hq₀Out <| Set.mem_iUnion.2 ⟨r, Set.mem_iUnion.2 ⟨hrEmb, hq₀Zero⟩⟩
  have hqMinAssocM : Minimal (· ∈ associatedPrimes R M) q := by
    refine ⟨hqAssocM, ?_⟩
    intro r hr hrg
    by_contra hqNotMin
    have hqEmb : q ∈ embeddedAssociatedPrimes R M := by
      rw [mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes]
      refine ⟨hqAssocM, ?_⟩
      intro hqMin
      exact hqNotMin (hqMin.2 hr hrg)
    exact hqOut <| Set.mem_iUnion.2 ⟨q, Set.mem_iUnion.2 ⟨hqEmb, (PrimeSpectrum.mem_zeroLocus q' q).2 le_rfl⟩⟩
  have hqMinSupportM : Minimal (· ∈ Module.support R M) q' :=
    (minimal_support_iff_minimal_associatedPrimes (R := R) (M := M) q').2 hqMinAssocM
  have hqNotSupportK : q' ∉ Module.support R K := by
    intro hqK
    exact hqOut <|
      support_embeddedPrimeFreeSubmodule_subset_embedded_locus (R := R) (M := M) hqK
  letI : q.IsPrime := hqMin.1.1
  have hqSub : Subsingleton (LocalizedModule q.primeCompl K) :=
    (Module.notMem_support_iff).mp hqNotSupportK
  have hlocInj :
      Function.Injective (LocalizedModule.map q.primeCompl K.mkQ) :=
    localized_mkQ_injective_of_subsingleton (R := R) (M := M) K hqSub
  have hmLocNonzero : LocalizedModule.mkLinearMap q.primeCompl M m ≠ 0 := by
    intro hmLocZero
    have hmKer : m ∈ LinearMap.ker (LocalizedModule.mkLinearMap q.primeCompl M) := by
      simpa [LinearMap.mem_ker] using hmLocZero
    rcases (LocalizedModule.mem_ker_mkLinearMap_iff (S := q.primeCompl) (m := m)).mp hmKer with
      ⟨s, hs, hsm⟩
    have hsAnn : s ∈ Module.annihilator R ↥(R ∙ m) := by
      simpa [Submodule.annihilator_span_singleton] using hsm
    exact hs (((Module.mem_support_iff_of_finite (R := R) (M := ↥(R ∙ m)) (p := q')).mp
      hqMinSupportSpan.1) hsAnn)
  have hmbarLocNonzero : LocalizedModule.mkLinearMap q.primeCompl Q mbar ≠ 0 := by
    intro hmbarLocZero
    have hmapZero :
        LocalizedModule.map q.primeCompl K.mkQ
          (LocalizedModule.mkLinearMap q.primeCompl M m) = 0 := by
      simpa [hmbar_eq, LocalizedModule.map_mk] using hmbarLocZero
    have hmLocZero : LocalizedModule.mkLinearMap q.primeCompl M m = 0 := by
      exact hlocInj (by simpa using hmapZero)
    exact hmLocNonzero hmLocZero
  have hpLeQ : p ≤ q := by
    intro r hrp
    by_contra hrnot
    have hrZero : r • mbar = 0 := by
      simpa [hmbarAnn, Submodule.annihilator_span_singleton] using hrp
    have hmbarKer : mbar ∈ LinearMap.ker (LocalizedModule.mkLinearMap q.primeCompl Q) := by
      rw [LocalizedModule.mem_ker_mkLinearMap_iff]
      exact ⟨r, hrnot, hrZero⟩
    exact hmbarLocNonzero (by simpa [LinearMap.mem_ker] using hmbarKer)
  have hpSupportM : p' ∈ Module.support R M := by
    simpa [Q, K, support_quotient_embeddedPrimeFreeSubmodule (R := R) (M := M)] using hpSupportQ
  have hqLeP : q ≤ p := hqMinSupportM.2 hpSupportM hpLeQ
  have hpEqQ : p = q := le_antisymm hpLeQ hqLeP
  have hpMinSupportQ : Minimal (· ∈ Module.support R Q) p' := by
    simpa [Q, K, p', hpEqQ, support_quotient_embeddedPrimeFreeSubmodule (R := R) (M := M)] using hqMinSupportM
  exact (minimal_support_iff_minimal_associatedPrimes (R := R) (M := Q) p').mp hpMinSupportQ

private theorem localizedMap_bijective_embeddedPrimeFreeSubmodule (f : R)
    (hf : ∀ p ∈ embeddedAssociatedPrimes R M, f ∈ p) :
    Function.Bijective
      (LocalizedModule.map (.powers f)
        (embeddedPrimeFreeSubmodule R M).mkQ) := by
  let K : Submodule R M := embeddedPrimeFreeSubmodule R M
  have hsub : Subsingleton (LocalizedModule (.powers f) K) := by
    rw [LocalizedModule.subsingleton_iff_support_subset]
    intro p hpSupport
    rcases Set.mem_iUnion.1
        (support_embeddedPrimeFreeSubmodule_subset_embedded_locus (R := R) (M := M) hpSupport) with
      ⟨q, hq⟩
    rcases Set.mem_iUnion.1 hq with ⟨hqEmb, hpZero⟩
    exact (PrimeSpectrum.mem_zeroLocus p ({f} : Set R)).2 <| by
      rw [Set.singleton_subset_iff]
      exact (PrimeSpectrum.mem_zeroLocus p q).mp hpZero (hf q hqEmb)
  refine ⟨localized_mkQ_injective_of_subsingleton (R := R) (M := M) K hsub, ?_⟩
  exact LocalizedModule.map_surjective (.powers f) K.mkQ (Submodule.mkQ_surjective K)

-- Proof sketch: let `K` be the submodule of elements whose cyclic support is contained in the
-- union of the embedded associated primes of `M`. This submodule is maximal among those whose
-- support is nowhere dense in `Supp(M)`. The minimal points of `Supp(M)` survive in `M ⧸ K`,
-- giving equal support and removing embedded associated primes. After localizing away from an
-- element contained in every embedded associated prime, the localized submodule vanishes, so the
-- canonical localized quotient map is bijective.
/-- Lemma 10.67.2: a finite module over a Noetherian ring admits a maximal submodule whose
support is nowhere dense in the support of the ambient module, and the resulting quotient has the
same support, no embedded associated primes, and agrees with the original module after localizing
away from any element contained in every embedded associated prime. -/
theorem exists_maximal_nowhereDense_support_submodule_with_embeddedPrimeFree_quotient
    :
    ∃ K : Submodule R M,
      Maximal
        (fun K : Submodule R M ↦
          IsNowhereDense { p : Module.support R M | (p : PrimeSpectrum R) ∈ Module.support R K })
        K ∧
      Module.support R (M ⧸ K) = Module.support R M ∧
      embeddedAssociatedPrimes R (M ⧸ K) = ∅ ∧
      ∀ f : R,
        (∀ p ∈ embeddedAssociatedPrimes R M, f ∈ p) →
          Function.Bijective (LocalizedModule.map (.powers f) K.mkQ) := by
  refine ⟨embeddedPrimeFreeSubmodule R M, ?_, ?_, ?_, ?_⟩
  · exact embeddedPrimeFreeSubmodule_isMaximal_nowhereDense R M
  · exact support_quotient_embeddedPrimeFreeSubmodule R M
  · exact embeddedAssociatedPrimes_quotient_embeddedPrimeFreeSubmodule R M
  · intro f hf
    exact localizedMap_bijective_embeddedPrimeFreeSubmodule R M f hf

end

/-! ### Lemma_10_67_3 (from Chap10) -/
universe u v

open scoped TensorProduct

section

variable (R : Type u) [CommRing R]
variable (M : Type v) [AddCommGroup M] [Module R M]

/- Layering for this item.
Sampled declarations in this localization/quotient domain:
* `embeddedPrimeFreeSubmodule` from `Lemma_10_67_2` is the source-facing submodule.
* `localizedQuotientEquiv` is the owner equivalence for localizing quotients.
* `Submodule.quotEquivOfEq` is the canonical rewrite once the localized submodule is identified.
* `Lemma_10_9_13` already recalls the same owner pattern for localized quotients in this chapter.
Target triage:
* source-facing: the quotient identification
  `LocalizedModule.Away f (M ⧸ embeddedPrimeFreeSubmodule R M) ≃ₗ[Localization.Away f]
    (LocalizedModule.Away f M ⧸
      embeddedPrimeFreeSubmodule (Localization.Away f) (LocalizedModule.Away f M))`.
* core/canonical owner: `localizedQuotientEquiv`.
* bridge/view: the supporting equality
  `(embeddedPrimeFreeSubmodule R M).localized (.powers f) =
    embeddedPrimeFreeSubmodule (Localization.Away f) (LocalizedModule.Away f M)`
  rewrites the owner equivalence into the source-facing quotient statement.
-/

/- Core/canonical owner recall: localization of quotients is controlled by
`localizedQuotientEquiv`. -/
recall localizedQuotientEquiv

variable (f : R)

local notation "Rloc" => Localization.Away f
local notation "Mloc" => LocalizedModule.Away f M

/-- Helper for Lemma 10.67.3: localizing a cyclic submodule away from `f` gives the cyclic
submodule generated by the localized image of the generator. -/
private theorem away_span_singleton_eq (m : M) :
    (R ∙ m).localized (.powers f) = (Rloc) ∙ LocalizedModule.mkLinearMap (.powers f) M m := by
  -- Identify the localized span with the span of the image of its single generator.
  simpa [Submodule.localized, Set.image_singleton] using
    (Submodule.localized'_span (Localization.Away f) (.powers f)
      (LocalizedModule.mkLinearMap (.powers f) M) ({m} : Set M))

/-- Helper for Lemma 10.67.3: the support of a cyclic submodule generated by `m` commutes with
away localization along `Spec(R_f) → Spec(R)`. -/
private theorem cyclic_support_away_preimage_comap (m : M) :
    Module.support Rloc ((Rloc) ∙ LocalizedModule.mkLinearMap (.powers f) M m) =
      PrimeSpectrum.comap (algebraMap R Rloc) ⁻¹' Module.support R (R ∙ m) := by
  -- Rewrite the localized cyclic submodule as the localized module of `R ∙ m`.
  calc
    Module.support Rloc ((Rloc) ∙ LocalizedModule.mkLinearMap (.powers f) M m) =
        Module.support Rloc ↥((R ∙ m).localized (.powers f)) := by
          rw [away_span_singleton_eq (R := R) (M := M) (f := f) m]
    _ = Module.support Rloc (LocalizedModule.Away f ↥(R ∙ m)) := by
          -- `Submodule.localizedEquiv` removes the ambient-submodule presentation.
          simpa using
            (LinearEquiv.support_eq (R := Rloc)
              (Submodule.localizedEquiv (.powers f) (R ∙ m)))
    _ = Module.support Rloc (Rloc ⊗[R] ↥(R ∙ m)) := by
          -- Rewrite the localized module as the tensor-product base change used by Lemma 10.40.6.
          simpa using
            (LinearEquiv.support_eq (R := Rloc)
              (LocalizedModule.equivTensorProduct (.powers f) ↥(R ∙ m)))
    _ = PrimeSpectrum.comap (algebraMap R Rloc) ⁻¹' Module.support R (R ∙ m) := by
          -- The cyclic module is finite, so the standard support/base-change theorem applies.
          simpa using
            (Module.Lemma_10_40_6 (R := R) (R' := Rloc) (M := ↥(R ∙ m)))

/-- Helper for Lemma 10.67.3: if an associated prime of `M` avoids the powers of `f`, then its
extension to `R_f` is associated to `M_f`. -/
private theorem associatedPrimesOfModule_away_map_of_disjoint {p : Ideal R}
    (hp : p ∈ associatedPrimesOfModule R M)
    (hp_disj : Disjoint ((.powers f : Submonoid R) : Set R) (p : Set R)) :
    Ideal.map (algebraMap R Rloc) p ∈ associatedPrimesOfModule Rloc Mloc := by
  -- First view `p` as an associated prime of `M_f` over the original ring `R`.
  have hp_range : p ∈ Set.range (Ideal.comap (algebraMap R Rloc)) := by
    refine ⟨Ideal.map (algebraMap R Rloc) p, ?_⟩
    exact IsLocalization.comap_map_of_isPrime_disjoint (.powers f) Rloc hp.1 hp_disj
  have hp_localized_over_R : p ∈ associatedPrimesOfModule R Mloc :=
    associatedPrimesOfModule_inter_localization_range_subset
      (R := R) (S := .powers f) (M := M) ⟨hp, hp_range⟩
  -- Then use injectivity of `Spec(R_f) → Spec(R)` to identify the unique prime above `p`.
  rw [← associatedPrimesOfModule_localizedModule_eq_image_comap
    (R := R) (S := .powers f) (M := M)] at hp_localized_over_R
  rcases hp_localized_over_R with ⟨J, hJ, hJcomap⟩
  let qJ : PrimeSpectrum Rloc := ⟨J, hJ.1⟩
  let qp : PrimeSpectrum Rloc := ⟨Ideal.map (algebraMap R Rloc) p,
    IsLocalization.isPrime_of_isPrime_disjoint (.powers f) Rloc p hp.1 hp_disj⟩
  have hq_comap :
      PrimeSpectrum.comap (algebraMap R Rloc) qJ =
        PrimeSpectrum.comap (algebraMap R Rloc) qp := by
    ext1
    exact hJcomap.trans
      (IsLocalization.comap_map_of_isPrime_disjoint (.powers f) Rloc hp.1 hp_disj).symm
  have hq_eq : qJ = qp :=
    (PrimeSpectrum.localization_comap_injective (S := Rloc) (.powers f)) hq_comap
  have hJ_eq : J = Ideal.map (algebraMap R Rloc) p := by
    simpa [qJ, qp] using congrArg PrimeSpectrum.asIdeal hq_eq
  simpa [hJ_eq] using hJ

/-- Helper for Lemma 10.67.3: an embedded associated prime of `M` that survives away from `f`
remains embedded after localizing away from `f`. -/
private theorem embeddedAssociatedPrimes_away_map_of_disjoint {p : Ideal R}
    (hp : p ∈ embeddedAssociatedPrimes R M)
    (hp_disj : Disjoint ((.powers f : Submonoid R) : Set R) (p : Set R)) :
    Ideal.map (algebraMap R Rloc) p ∈ embeddedAssociatedPrimes Rloc Mloc := by
  rw [mem_embeddedAssociatedPrimes_iff] at hp ⊢
  refine ⟨associatedPrimesOfModule_away_map_of_disjoint
    (R := R) (M := M) (f := f) hp.1 hp_disj, ?_⟩
  -- Minimality descends because every smaller associated prime of `p` also avoids `f`.
  intro hmin
  apply hp.2
  refine ⟨hp.1, ?_⟩
  intro p' hp' hp'le
  have hp'_disj : Disjoint ((.powers f : Submonoid R) : Set R) (p' : Set R) := by
    rw [Set.disjoint_left] at hp_disj ⊢
    intro x hxS hxp'
    exact hp_disj hxS (hp'le hxp')
  have hp'_map_assoc :
      Ideal.map (algebraMap R Rloc) p' ∈ associatedPrimesOfModule Rloc Mloc :=
    associatedPrimesOfModule_away_map_of_disjoint
      (R := R) (M := M) (f := f) hp' hp'_disj
  have hp_map_le :
      Ideal.map (algebraMap R Rloc) p ≤ Ideal.map (algebraMap R Rloc) p' :=
    hmin.2 hp'_map_assoc (Ideal.map_mono hp'le)
  simpa [IsLocalization.comap_map_of_isPrime_disjoint (.powers f) Rloc hp'.1 hp'_disj] using
    (Ideal.map_le_iff_le_comap.mp hp_map_le)

/-- Helper for Lemma 10.67.3: the embedded-prime locus of `M` pulls back into the embedded-prime
locus of `M_f`. -/
private theorem embedded_locus_away_preimage_comap_subset :
    PrimeSpectrum.comap (algebraMap R Rloc) ⁻¹'
      (⋃ p ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus p) ⊆
        ⋃ p ∈ embeddedAssociatedPrimes Rloc Mloc, PrimeSpectrum.zeroLocus p := by
  intro q hq
  change PrimeSpectrum.comap (algebraMap R Rloc) q ∈
    ⋃ p ∈ embeddedAssociatedPrimes R M, PrimeSpectrum.zeroLocus p at hq
  rcases Set.mem_iUnion.mp hq with ⟨p, hp⟩
  rcases Set.mem_iUnion.mp hp with ⟨hp_emb, hp_zero⟩
  have hp_le : p ≤ Ideal.comap (algebraMap R Rloc) q.asIdeal :=
    (PrimeSpectrum.mem_zeroLocus _ _).mp hp_zero
  have hq_disj :
      Disjoint ((.powers f : Submonoid R) : Set R)
        (Ideal.comap (algebraMap R Rloc) q.asIdeal : Set R) := by
    exact (IsLocalization.disjoint_comap_iff (.powers f) Rloc q.asIdeal).2 q.2.ne_top
  have hp_disj : Disjoint ((.powers f : Submonoid R) : Set R) (p : Set R) := by
    rw [Set.disjoint_left] at hq_disj ⊢
    intro x hxS hxp
    exact hq_disj hxS (hp_le hxp)
  refine Set.mem_iUnion.2 ⟨Ideal.map (algebraMap R Rloc) p, Set.mem_iUnion.2 ⟨?_, ?_⟩⟩
  · exact embeddedAssociatedPrimes_away_map_of_disjoint
      (R := R) (M := M) (f := f) hp_emb hp_disj
  · exact (PrimeSpectrum.mem_zeroLocus q _).2 <| by
      exact Ideal.map_le_iff_le_comap.mpr hp_le

/-- Helper for Lemma 10.67.3: the localized canonical submodule is contained in the canonical
submodule of the localized module. -/
private theorem embeddedPrimeFreeSubmodule_localized_le :
    (embeddedPrimeFreeSubmodule R M).localized (.powers f) ≤
      embeddedPrimeFreeSubmodule Rloc Mloc := by
  -- It is enough to check the generators of the localized span.
  rw [Submodule.localized, Submodule.localized'_eq_span]
  refine Submodule.span_le.2 ?_
  rintro _ ⟨m, hm, rfl⟩
  -- The cyclic support localizes by preimage, and the embedded locus only grows after
  -- localization along `R → R_f`.
  exact (mem_embeddedPrimeFreeSubmodule_iff
    (R := Rloc) (M := Mloc) (LocalizedModule.mkLinearMap (.powers f) M m)).2 <|
      (cyclic_support_away_preimage_comap (R := R) (M := M) (f := f) m).symm ▸
        (Set.preimage_mono ((mem_embeddedPrimeFreeSubmodule_iff
          (R := R) (M := M) m).mp hm)).trans
          (embedded_locus_away_preimage_comap_subset (R := R) (M := M) (f := f))

/-- Helper for Lemma 10.67.3: an embedded associated prime of an away localization descends to an
embedded associated prime before localizing. -/
private theorem embeddedAssociatedPrimes_away_comap_of_mem
    [IsNoetherianRing R] {N : Type v} [AddCommGroup N] [Module R N] [Module.Finite R N]
    {q : Ideal Rloc} (hq : q ∈ embeddedAssociatedPrimes Rloc (LocalizedModule.Away f N)) :
    Ideal.comap (algebraMap R Rloc) q ∈ embeddedAssociatedPrimes R N := by
  -- First contract the associated prime from the localized module back to `R`.
  rw [mem_embeddedAssociatedPrimes_iff] at hq ⊢
  let p : Ideal R := Ideal.comap (algebraMap R Rloc) q
  have hp_assoc_localized :
      p ∈ associatedPrimesOfModule R (LocalizedModule.Away f N) := by
    rw [← associatedPrimesOfModule_localizedModule_eq_image_comap
      (R := R) (S := .powers f) (M := N)]
    exact ⟨q, hq.1, rfl⟩
  have hp_assoc :
      p ∈ associatedPrimesOfModule R N := by
    rw [← associatedPrimesOfModule_inter_localization_range_eq
      (R := R) (S := .powers f) (M := N)] at hp_assoc_localized
    exact hp_assoc_localized.1
  refine ⟨hp_assoc, ?_⟩
  -- Route correction: instead of rebuilding the localized quotient contradiction here, reflect
  -- minimality along the injective map `Spec(R_f) → Spec(R)`.
  intro hp_min
  apply hq.2
  refine ⟨hq.1, ?_⟩
  intro q' hq' hq'le
  let p' : Ideal R := Ideal.comap (algebraMap R Rloc) q'
  have hp'_assoc_localized :
      p' ∈ associatedPrimesOfModule R (LocalizedModule.Away f N) := by
    rw [← associatedPrimesOfModule_localizedModule_eq_image_comap
      (R := R) (S := .powers f) (M := N)]
    exact ⟨q', hq', rfl⟩
  have hp'_assoc :
      p' ∈ associatedPrimesOfModule R N := by
    rw [← associatedPrimesOfModule_inter_localization_range_eq
      (R := R) (S := .powers f) (M := N)] at hp'_assoc_localized
    exact hp'_assoc_localized.1
  have hp_le : p ≤ p' :=
    hp_min.2 hp'_assoc (Ideal.comap_mono hq'le)
  let qPoint : PrimeSpectrum Rloc := ⟨q, hq.1.1⟩
  let qPoint' : PrimeSpectrum Rloc := ⟨q', hq'.1⟩
  have hcomap_eq :
      PrimeSpectrum.comap (algebraMap R Rloc) qPoint =
        PrimeSpectrum.comap (algebraMap R Rloc) qPoint' := by
    ext1
    exact le_antisymm hp_le (Ideal.comap_mono hq'le)
  have hq_eq : qPoint = qPoint' :=
    (PrimeSpectrum.localization_comap_injective (S := Rloc) (.powers f)) hcomap_eq
  simpa [qPoint, qPoint'] using (congrArg PrimeSpectrum.asIdeal hq_eq).le

/-- Helper for Lemma 10.67.3: localizing the quotient by the canonical submodule introduces no
embedded associated primes. -/
private theorem localized_embeddedPrimeFree_quotient_has_no_embedded
    [IsNoetherianRing R] [Module.Finite R M] :
    embeddedAssociatedPrimes Rloc
      (LocalizedModule.Away f (M ⧸ embeddedPrimeFreeSubmodule R M)) = ∅ := by
  -- Descend any hypothetical localized embedded prime to the quotient before localization.
  ext q
  constructor
  · intro hq
    have hp :
        Ideal.comap (algebraMap R Rloc) q ∈
          embeddedAssociatedPrimes R (M ⧸ embeddedPrimeFreeSubmodule R M) :=
      embeddedAssociatedPrimes_away_comap_of_mem (R := R) (f := f)
        (N := M ⧸ embeddedPrimeFreeSubmodule R M) hq
    simpa [embeddedAssociatedPrimes_quotient_embeddedPrimeFreeSubmodule (R := R) (M := M)] using hp
  · intro hq
    exact hq.elim

/-- Helper for Lemma 10.67.3: the localized quotient by the canonical submodule has the same
support as the localized ambient module. -/
private theorem localized_embeddedPrimeFree_quotient_support_eq
    [IsNoetherianRing R] [Module.Finite R M] :
    Module.support Rloc
        (LocalizedModule.Away f (M ⧸ embeddedPrimeFreeSubmodule R M)) =
      Module.support Rloc Mloc := by
  -- Rewrite both localized modules as the tensor-product base change from Lemma 10.40.6.
  calc
    Module.support Rloc
        (LocalizedModule.Away f (M ⧸ embeddedPrimeFreeSubmodule R M)) =
        Module.support Rloc
          (Rloc ⊗[R] (M ⧸ embeddedPrimeFreeSubmodule R M)) := by
            simpa using
              (LinearEquiv.support_eq (R := Rloc)
                (LocalizedModule.equivTensorProduct (.powers f)
                  (M ⧸ embeddedPrimeFreeSubmodule R M)))
    _ = PrimeSpectrum.comap (algebraMap R Rloc) ⁻¹'
          Module.support R (M ⧸ embeddedPrimeFreeSubmodule R M) := by
            simpa using
              (Module.Lemma_10_40_6
                (R := R) (R' := Rloc) (M := M ⧸ embeddedPrimeFreeSubmodule R M))
    _ = PrimeSpectrum.comap (algebraMap R Rloc) ⁻¹' Module.support R M := by
          rw [support_quotient_embeddedPrimeFreeSubmodule (R := R) (M := M)]
    _ = Module.support Rloc (Rloc ⊗[R] M) := by
          simpa using
            (Module.Lemma_10_40_6 (R := R) (R' := Rloc) (M := M)).symm
    _ = Module.support Rloc Mloc := by
          simpa using
            (LinearEquiv.support_eq (R := Rloc)
              (LocalizedModule.equivTensorProduct (.powers f) M)).symm

/-- Helper for Lemma 10.67.3: the cyclic support of the image of an element under a linear map is
contained in the cyclic support of the original element. -/
private theorem support_cyclic_image_subset
    {P : Type*} [AddCommGroup P] [Module Rloc P]
    (g : Mloc →ₗ[Rloc] P) (x : Mloc) :
    Module.support Rloc (Rloc ∙ g x) ⊆ Module.support Rloc (Rloc ∙ x) := by
  -- Restrict `g` to the cyclic submodule generated by `x` and use support monotonicity for the
  -- induced surjection onto its range.
  let gSpan : (Rloc ∙ x) →ₗ[Rloc] P := g.domRestrict (Rloc ∙ x)
  let gRange : (Rloc ∙ x) →ₗ[Rloc] LinearMap.range gSpan := gSpan.rangeRestrict
  have hg_surj : Function.Surjective gRange := LinearMap.surjective_rangeRestrict gSpan
  have hsupp :
      Module.support Rloc (LinearMap.range gSpan) ⊆ Module.support Rloc (Rloc ∙ x) :=
    Module.support_subset_of_surjective gRange hg_surj
  have hrange : LinearMap.range gSpan = (Rloc ∙ g x) := by
    calc
      LinearMap.range gSpan = (Rloc ∙ x).map g := by
        simp [gSpan]
      _ = (Rloc ∙ g x) := by
        simpa [Set.image_singleton] using (Submodule.map_span g ({x} : Set Mloc))
  calc
    Module.support Rloc (Rloc ∙ g x) = Module.support Rloc ↥(LinearMap.range gSpan) := by
      rw [hrange]
    _ ⊆ Module.support Rloc (Rloc ∙ x) := hsupp

/-- Helper for Lemma 10.67.3: a canonical localized element maps to zero in the localized quotient
by the canonical submodule from Lemma 10.67.2. -/
private theorem localized_quotient_map_eq_zero_of_mem_embeddedPrimeFreeSubmodule
    [IsNoetherianRing R] [Module.Finite R M] {x : Mloc}
    (hx : x ∈ embeddedPrimeFreeSubmodule Rloc Mloc) :
    LocalizedModule.map (.powers f) (embeddedPrimeFreeSubmodule R M).mkQ x = 0 := by
  let K : Submodule R M := embeddedPrimeFreeSubmodule R M
  let Q : Type v := M ⧸ K
  let π : Mloc →ₗ[Rloc] LocalizedModule.Away f Q := LocalizedModule.map (.powers f) K.mkQ
  let y : LocalizedModule.Away f Q := π x
  -- If the image were nonzero, a minimal associated prime of its cyclic span would become an
  -- embedded associated prime of the localized quotient, contradicting the previous helper.
  by_contra hy
  have hy_ne : y ≠ 0 := hy
  let Ny : Submodule Rloc (LocalizedModule.Away f Q) := Rloc ∙ y
  have hNy_ne_bot : Ny ≠ ⊥ := by
    simpa [Ny, Submodule.span_singleton_eq_bot] using hy_ne
  letI : Nontrivial ↥Ny := Submodule.nontrivial_iff_ne_bot.mpr hNy_ne_bot
  obtain ⟨p, hp_assocNy⟩ := associatedPrimes.nonempty Rloc ↥Ny
  have hp_assocQ :
      p ∈ associatedPrimes Rloc (LocalizedModule.Away f Q) :=
    associatedPrimes.subset_of_injective Ny.subtype_injective hp_assocNy
  let pPoint : PrimeSpectrum Rloc := ⟨p, (AssociatedPrimes.mem_iff.mp hp_assocNy).isPrime⟩
  have hp_supportNy : pPoint ∈ Module.support Rloc ↥Ny := by
    exact Module.associatedPrimes_subset_support (by simpa [pPoint] using hp_assocNy)
  have hp_supportY : pPoint ∈ Module.support Rloc (Rloc ∙ π x) := by
    simpa [Ny, y, π] using hp_supportNy
  have hp_supportMx : pPoint ∈ Module.support Rloc (Rloc ∙ x) :=
    (support_cyclic_image_subset (R := R) (M := M) (f := f)
      (P := LocalizedModule.Away f Q) π x) hp_supportY
  have hx_support_subset :
      Module.support Rloc (Rloc ∙ x) ⊆
        ⋃ q ∈ embeddedAssociatedPrimes Rloc Mloc, PrimeSpectrum.zeroLocus q :=
    (mem_embeddedPrimeFreeSubmodule_iff (R := Rloc) (M := Mloc) x).mp hx
  have hp_embedded_locus :
      pPoint ∈ ⋃ q ∈ embeddedAssociatedPrimes Rloc Mloc, PrimeSpectrum.zeroLocus q :=
    hx_support_subset hp_supportMx
  rcases Set.mem_iUnion.1 hp_embedded_locus with ⟨q, hq⟩
  rcases Set.mem_iUnion.1 hq with ⟨hq_emb, hp_zero⟩
  let qPoint : PrimeSpectrum Rloc := ⟨q, hq_emb.1.1⟩
  have hq_le_p : q ≤ p := (PrimeSpectrum.mem_zeroLocus pPoint q).mp hp_zero
  have hp_embeddedQ :
      p ∈ embeddedAssociatedPrimes Rloc (LocalizedModule.Away f Q) := by
    rw [mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes]
    refine ⟨hp_assocQ, ?_⟩
    intro hp_min
    have hsupport_eq :
        Module.support Rloc (LocalizedModule.Away f Q) = Module.support Rloc Mloc := by
      simpa [K, Q] using
        localized_embeddedPrimeFree_quotient_support_eq (R := R) (M := M) (f := f)
    have hp_min_supportQ :
        Minimal (· ∈ Module.support Rloc (LocalizedModule.Away f Q)) pPoint :=
      (minimal_support_iff_minimal_associatedPrimes
        (R := Rloc) (M := LocalizedModule.Away f Q) pPoint).2 hp_min
    have hp_min_supportM :
        Minimal (· ∈ Module.support Rloc Mloc) pPoint := by
      simpa [hsupport_eq] using hp_min_supportQ
    have hq_emb_assoc :
        q ∈ associatedPrimes Rloc Mloc ∧
          ¬ Minimal (· ∈ associatedPrimes Rloc Mloc) q := by
      exact
        (mem_embeddedAssociatedPrimes_iff_mem_associatedPrimes
          (R := Rloc) (M := Mloc) q).mp hq_emb
    have hq_supportM : qPoint ∈ Module.support Rloc Mloc := by
      exact Module.associatedPrimes_subset_support (by simpa [qPoint] using hq_emb_assoc.1)
    have hp_le_q : p ≤ q := hp_min_supportM.2 hq_supportM hq_le_p
    have hp_eq_q : p = q := le_antisymm hp_le_q hq_le_p
    have hp_min_assocM :
        Minimal (· ∈ associatedPrimes Rloc Mloc) p :=
      (minimal_support_iff_minimal_associatedPrimes (R := Rloc) (M := Mloc) pPoint).mp
        hp_min_supportM
    exact hq_emb_assoc.2 (by simpa [hp_eq_q] using hp_min_assocM)
  have hno_embedded :
      embeddedAssociatedPrimes Rloc (LocalizedModule.Away f Q) = ∅ :=
    localized_embeddedPrimeFree_quotient_has_no_embedded (R := R) (M := M) (f := f)
  simpa [Q, hno_embedded] using hp_embeddedQ

/-- Supporting bridge: the canonical submodule from Lemma 10.67.2 is compatible with away
localization. -/
theorem embeddedPrimeFreeSubmodule_localized_eq
    [IsNoetherianRing R] [Module.Finite R M] :
    (embeddedPrimeFreeSubmodule R M).localized (.powers f) =
      embeddedPrimeFreeSubmodule Rloc Mloc := by
  -- Route correction: the forward inclusion only needs the one-sided localization theorem for
  -- textbook associated primes, so we record that verified prefix explicitly.
  have hle :
      (embeddedPrimeFreeSubmodule R M).localized (.powers f) ≤
        embeddedPrimeFreeSubmodule Rloc Mloc :=
    embeddedPrimeFreeSubmodule_localized_le (R := R) (M := M) (f := f)
  apply le_antisymm hle
  intro x hx
  let K : Submodule R M := embeddedPrimeFreeSubmodule R M
  let Q : Type v := M ⧸ K
  let π : Mloc →ₗ[Rloc] LocalizedModule.Away f Q := LocalizedModule.map (.powers f) K.mkQ
  -- The reverse inclusion is a kernel computation once the localized quotient image is known to
  -- vanish on the canonical localized submodule.
  have hx_zero : π x = 0 :=
    localized_quotient_map_eq_zero_of_mem_embeddedPrimeFreeSubmodule
      (R := R) (M := M) (f := f) hx
  have hx_ker : x ∈ LinearMap.ker π := by
    simpa [π, LinearMap.mem_ker] using hx_zero
  have hker :
      K.localized (.powers f) = LinearMap.ker π := by
    simpa [K, Q, π] using
      (LinearMap.localized'_ker_eq_ker_localizedMap (S := Localization (.powers f))
        (p := .powers f)
        (f := LocalizedModule.mkLinearMap (.powers f) M)
        (f' := LocalizedModule.mkLinearMap (.powers f) Q) K.mkQ)
  rw [← hker] at hx_ker
  simpa [K] using hx_ker

/-- Lemma 10.67.3: after inverting `f`, the quotient by the canonical submodule from
Lemma 10.67.2 agrees with the canonical quotient of the localized module. -/
noncomputable def away_embeddedPrimeFreeQuotientEquiv
    [IsNoetherianRing R] [Module.Finite R M] :
    LocalizedModule.Away f (M ⧸ embeddedPrimeFreeSubmodule R M) ≃ₗ[Localization.Away f]
      Mloc ⧸ embeddedPrimeFreeSubmodule Rloc Mloc :=
  (localizedQuotientEquiv (.powers f) (embeddedPrimeFreeSubmodule R M)).symm ≪≫ₗ
    Submodule.quotEquivOfEq _ _ (embeddedPrimeFreeSubmodule_localized_eq R M f)

-- Proof sketch: unfold `away_embeddedPrimeFreeQuotientEquiv`; the statement is exactly its
-- defining composition of the canonical localized quotient equivalence with the quotient rewrite
-- coming from `embeddedPrimeFreeSubmodule_localized_eq`.
/-- The equivalence in Lemma 10.67.3 is defined by composing the canonical localization-of-quotient
equivalence with the quotient rewrite induced by
`embeddedPrimeFreeSubmodule_localized_eq`. -/
theorem away_embeddedPrimeFreeQuotientEquiv_def
    [IsNoetherianRing R] [Module.Finite R M] :
    away_embeddedPrimeFreeQuotientEquiv R M f =
      (localizedQuotientEquiv (.powers f) (embeddedPrimeFreeSubmodule R M)).symm ≪≫ₗ
        Submodule.quotEquivOfEq _ _ (embeddedPrimeFreeSubmodule_localized_eq R M f) :=
  rfl

end

/-! ### Lemma_10_67_4 (from Chap10) -/
universe u v

section

open scoped Pointwise

variable {R : Type u} [CommRing R] [IsNoetherianRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]

local notation "I" => Module.annihilator R M
local notation "A" => R ⧸ Module.annihilator R M

-- Source/core/bridge triage:
-- * source-facing layer: the statement is about embedded primes of the faithful quotient
--   `R ⧸ Ann_R(M)`.
-- * core/canonical owner layer: `associatedPrimes`, `Module.annihilator`, and contraction along
--   `R → R ⧸ Ann_R(M)`.
-- * bridge/view layer: `embeddedAssociatedPrimes` remains the source-facing wrapper, but the proof
--   is carried entirely by the owner theorems `associatedPrimes_restrictScalars_eq_image_comap`,
--   `Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes`, and
--   `IsAssociatedPrime.map_of_injective`.
/-- Lemma 10.67.4: if the finite `R`-module `M` has no embedded associated primes, then the quotient
ring `R ⧸ Ann_R(M)` has no embedded primes. -/
-- Proof sketch: replace `R` by `R ⧸ Ann_R(M)` so that `M` is faithful. By Lemma 10.40.5, the
-- support of `M` is then all of `Spec R`. If `R` had an embedded prime `𝔭`, choose an element of
-- `R` whose annihilator is `𝔭` and consider the nonzero submodule obtained by multiplying `M` by
-- that element. Any associated prime of this submodule is also an associated prime of `M` lying
-- above `𝔭`, hence would be embedded, contradicting the hypothesis.
theorem quotient_annihilator_has_no_embedded_primes_of_no_embedded_associated_primes
    (hM : embeddedAssociatedPrimes R M = ∅) :
    embeddedPrimes A = ∅ := by
  letI : Module A M := Module.quotientAnnihilator
  letI : IsScalarTower R A M :=
    Module.IsTorsionBySet.isScalarTower (Module.isTorsionBySet_annihilator R M)
  letI : IsNoetherianRing A := Ideal.Quotient.isNoetherianRing I
  letI : Module.Finite A M := Module.Finite.of_restrictScalars_finite R A M
  have hrestrict : Ideal.comap (algebraMap R A) '' associatedPrimes A M = associatedPrimes R M :=
    associatedPrimes_restrictScalars_eq_image_comap
  have hsurj_mk : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
  have hsurj : Function.Surjective (algebraMap R A) := by
    simpa [Ideal.Quotient.algebraMap_eq] using hsurj_mk
  have hM_min : ∀ p : Ideal R, p ∈ associatedPrimes R M → Minimal (· ∈ associatedPrimes R M) p := by
    let hiff :
        embeddedAssociatedPrimes R M = ∅ ↔
          ∀ p ∈ associatedPrimes R M, Minimal (· ∈ associatedPrimes R M) p :=
      embeddedAssociatedPrimes_eq_empty_iff R M
    exact hiff.1 hM
  have hA_M_min : ∀ p : Ideal A, p ∈ associatedPrimes A M → Minimal (· ∈ associatedPrimes A M) p := by
    intro p hp
    have hpR : Ideal.comap (algebraMap R A) p ∈ associatedPrimes R M := by
      rw [← hrestrict]
      exact ⟨p, hp, rfl⟩
    have hpR_min : Minimal (· ∈ associatedPrimes R M) (Ideal.comap (algebraMap R A) p) :=
      hM_min _ hpR
    refine ⟨hp, fun q hq hqp ↦ ?_⟩
    have hqR : Ideal.comap (algebraMap R A) q ∈ associatedPrimes R M := by
      rw [← hrestrict]
      exact ⟨q, hq, rfl⟩
    have hcomap_eq : Ideal.comap (algebraMap R A) p = Ideal.comap (algebraMap R A) q := by
      refine le_antisymm ?_ ?_
      · exact hpR_min.2 hqR (Ideal.comap_mono hqp)
      · exact Ideal.comap_mono hqp
    exact (Ideal.comap_injective_of_surjective (algebraMap R A) hsurj hcomap_eq).le
  have hfaithful : Module.annihilator A M = ⊥ := by
    refine le_antisymm ?_ bot_le
    intro x hx
    obtain ⟨r, rfl⟩ := hsurj_mk x
    rw [Ideal.mem_bot, Ideal.Quotient.eq_zero_iff_mem]
    change r ∈ Module.annihilator R M
    rw [Module.mem_annihilator] at hx ⊢
    intro m
    simpa [Module.IsTorsionBySet.mk_smul (Module.isTorsionBySet_annihilator R M) r m] using hx m
  have hA_ring_subset_module : associatedPrimes A A ⊆ associatedPrimes A M := by
    intro p hp
    rw [AssociatedPrimes.mem_iff, isAssociatedPrime_iff] at hp
    rcases hp with ⟨hp_prime, a, ha⟩
    let N : Submodule A M := a • (⊤ : Submodule A M)
    have hN_ann : N.annihilator = p := by
      ext r
      rw [Submodule.mem_annihilator, ha, Submodule.mem_colon_singleton, Submodule.mem_bot]
      constructor
      · intro hr
        have hra : r * a ∈ Module.annihilator A M := by
          rw [Module.mem_annihilator]
          intro m
          have ham : a • m ∈ N := by
            exact Submodule.smul_mem_pointwise_smul m a ⊤ (by simp)
          simpa [N, smul_smul] using hr (a • m) ham
        simpa [hfaithful, Algebra.smul_def] using hra
      · intro hr n hn
        rcases Submodule.mem_smul_pointwise_iff_exists n a (⊤ : Submodule A M) |>.mp
            (by simpa [N] using hn) with
          ⟨m, -, rfl⟩
        simpa [smul_smul] using congrArg (fun x ↦ x • m) hr
    have hp_min : p ∈ N.annihilator.minimalPrimes := by
      simpa [hN_ann] using
        (show p ∈ p.minimalPrimes by
          rw [Ideal.minimalPrimes_eq_subsingleton_self]
          simp)
    have hp_assoc_N : p ∈ associatedPrimes A N := by
      simpa [Submodule.annihilator] using
        Module.associatedPrimes.minimalPrimes_annihilator_subset_associatedPrimes A N hp_min
    exact associatedPrimes.subset_of_injective N.subtype_injective hp_assoc_N
  have hA_ring_min : ∀ p ∈ associatedPrimes A A, Minimal (· ∈ associatedPrimes A A) p := by
    intro p hp
    refine ⟨hp, fun q hq hqp ↦ ?_⟩
    exact (hA_M_min p (hA_ring_subset_module hp)).2 (hA_ring_subset_module hq) hqp
  exact (embeddedPrimes_eq_empty_iff A).2 hA_ring_min

end
