/-! ### Definition_10_68_1 (from Chap10) -/
universe u v

section

open RingTheory
open RingTheory.Sequence

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/- Definition 10.68.1: the canonical mathlib notion of an `M`-regular sequence `rs` is
`Sequence.IsRegular M rs`; it says that each term is a nonzerodivisor on the quotient by the
previous terms, and that the final quotient is nonzero. -/
recall Sequence.IsRegular

namespace Ideal

/-- The ideal generated by a list `rs` is contained in `I` exactly when every term of `rs`
lies in `I`. -/
theorem ofList_le_iff (I : Ideal R) (rs : List R) :
    Ideal.ofList rs ≤ I ↔ ∀ r ∈ rs, r ∈ I := by
  change Ideal.span {r | r ∈ rs} ≤ I ↔ _
  rw [Ideal.span_le]
  rfl

end Ideal

namespace RingTheory.Sequence

/-- Definition 10.68.1, in canonical ideal-theoretic form: a sequence `rs` is `M`-regular in the
ideal `I` exactly when `Sequence.IsRegular M rs` and the ideal generated by its entries is
contained in `I`. Equivalently, every term of `rs` lies in `I`. -/
theorem isRegular_in_ideal_iff (I : Ideal R) (rs : List R) :
    (IsRegular M rs ∧ Ideal.ofList rs ≤ I) ↔ IsRegular M rs ∧ ∀ r ∈ rs, r ∈ I := by
  refine and_congr_right fun _ ↦ ?_
  exact Ideal.ofList_le_iff I rs

end Sequence
end RingTheory

end

/-! ### Example_10_68_2 (from Chap10) -/
universe u

open MvPolynomial RingTheory.Sequence

section

variable (k : Type u) [CommRing k] [Nontrivial k]

/-
Domain triage:
* primary domain: regular sequences in commutative polynomial rings;
* sampled owner API: `RingTheory.Sequence.IsRegular`,
  `RingTheory.Sequence.isRegular_cons_iff`,
  `RingTheory.Sequence.isRegular_in_ideal_iff`,
  `IsLocalRing.isRegular_of_perm`;
* core/canonical owner: `RingTheory.Sequence.IsRegular A rs`;
* primitive vs derived split: the primitive data are the ring `k[x, y, z]` and the two explicit
  lists `[x, y * (1 - x), z * (1 - x)]` and `[y * (1 - x), z * (1 - x), x]`; the example theorem
  is the derived source-facing comparison of their regularity behavior;
* layer classification for this file: `source-facing`.
-/

local notation "A" => MvPolynomial (Fin 3) k
local notation "x" => (X (0 : Fin 3) : A)
local notation "y" => (X (1 : Fin 3) : A)
local notation "z" => (X (2 : Fin 3) : A)

-- Proof sketch: use the inductive characterization of regular sequences in
-- `isRegular_cons_iff`. First `x` is a non-zero-divisor in the polynomial ring
-- over a nontrivial commutative ring, and then the images of `y * (1 - x)` and
-- `z * (1 - x)` remain non-zero-divisors after quotienting successively by the
-- preceding elements.
private theorem example10682_isRegular :
    IsRegular A [x, y * (1 - x), z * (1 - x)] := by
  sorry

-- Proof sketch: after quotienting by `y * (1 - x)`, the class of `z * (1 - x)`
-- becomes a zero-divisor, so the reordered list fails the inductive criterion
-- for regularity.
private theorem example10682_reordered_not_regular :
    ¬ IsRegular A [y * (1 - x), z * (1 - x), x] := by
  sorry

/-- Example 10.68.2 (Stacks, Tag `00LG`): in the polynomial ring `k[x, y, z]`,
the sequence `x, y(1 - x), z(1 - x)` is regular, but the reordered sequence
`y(1 - x), z(1 - x), x` is not. -/
theorem example10682_regularSequence_and_reordered_not_regular :
    IsRegular A [x, y * (1 - x), z * (1 - x)] ∧
      ¬ IsRegular A [y * (1 - x), z * (1 - x), x] :=
  ⟨example10682_isRegular k, example10682_reordered_not_regular k⟩

end

/-! ### Example_10_68_3 (from Chap10) -/
universe u

open MvPolynomial
open Ideal.Quotient (eq_zero_iff_mem)
open scoped nonZeroDivisors
open RingTheory RingTheory.Sequence

attribute [local instance high] Semiring.toModule Algebra.toModule

noncomputable section

variable (k : Type u) [Field k]

/-- Variables for the quotient presentation in Example 10.68.3. -/
inductive Example10683Var
  | x
  | y
  | w : ℕ → Example10683Var
  deriving DecidableEq

open Example10683Var

/-- The ambient polynomial ring `k[x, y, w_0, w_1, \ldots]` of Example 10.68.3. -/
abbrev example10683PolynomialRing :=
  MvPolynomial Example10683Var k

/-- The defining relation `y w_i`. -/
def example10683YMulWRelation (i : ℕ) : example10683PolynomialRing k :=
  X y * X (w i)

/-- The defining relation `w_i - x w_{i+1}`. -/
def example10683WRecurrenceRelation (i : ℕ) : example10683PolynomialRing k :=
  X (w i) - X x * X (w (i + 1))

/-- The full family of defining relations for Example 10.68.3. -/
def example10683Relations : Set (example10683PolynomialRing k) :=
  Set.range (example10683YMulWRelation k) ∪ Set.range (example10683WRecurrenceRelation k)

/-- The defining ideal
`(y w_i, w_i - x w_{i+1} \mid i \ge 0)` of Example 10.68.3. -/
def example10683Ideal : Ideal (example10683PolynomialRing k) :=
  Ideal.span (example10683Relations k)

/-- Each relation `y w_i` lies in the defining ideal. -/
private theorem example10683YMulWRelation_mem_ideal (i : ℕ) :
    example10683YMulWRelation k i ∈ example10683Ideal k :=
  Ideal.subset_span <| Or.inl ⟨i, rfl⟩

/-- Each relation `w_i - x w_{i+1}` lies in the defining ideal. -/
private theorem example10683WRecurrenceRelation_mem_ideal (i : ℕ) :
    example10683WRecurrenceRelation k i ∈ example10683Ideal k :=
  Ideal.subset_span <| Or.inr ⟨i, rfl⟩

/-- The quotient ring
`k[x, y, w_0, w_1, ...] / (y w_i, w_i - x w_{i+1} \mid i \ge 0)` from the example. -/
abbrev example10683Ring :=
  example10683PolynomialRing k ⧸ example10683Ideal k

/-- The distinguished element `x` in the example ring. -/
def example10683x : example10683Ring k :=
  Ideal.Quotient.mk (example10683Ideal k) (X x)

/-- The distinguished element `y` in the example ring. -/
def example10683y : example10683Ring k :=
  Ideal.Quotient.mk (example10683Ideal k) (X y)

/-- The distinguished elements `w_i` in the example ring. -/
def example10683w (i : ℕ) : example10683Ring k :=
  Ideal.Quotient.mk (example10683Ideal k) (X (w i))

/-- In the quotient ring of Example 10.68.3, the defining relation `y w_i = 0` holds. -/
theorem example10683_y_mul_w_eq_zero (i : ℕ) :
    example10683y k * example10683w k i = 0 := by
  simpa [example10683y, example10683w, example10683YMulWRelation] using
    eq_zero_iff_mem.mpr (example10683YMulWRelation_mem_ideal k i)

/-- In the quotient ring of Example 10.68.3, the defining relation `w_i = x w_{i+1}` holds. -/
theorem example10683_w_eq_x_mul_w_succ (i : ℕ) :
    example10683w k i = example10683x k * example10683w k (i + 1) := by
  simpa [example10683x, example10683w, example10683WRecurrenceRelation, sub_eq_zero] using
    eq_zero_iff_mem.mpr (example10683WRecurrenceRelation_mem_ideal k i)

/-- The maximal ideal `(x, y, w_i)` of the example ring. -/
noncomputable def example10683MaximalIdeal : Ideal (example10683Ring k) :=
  Ideal.span (Set.insert (example10683x k) (Set.insert (example10683y k) (Set.range (example10683w k))))

/-- The generator `x` lies in the maximal ideal `(x, y, w_i)`. -/
private theorem example10683x_mem_maximalIdeal :
    example10683x k ∈ example10683MaximalIdeal k :=
  Ideal.subset_span <| Set.mem_insert _ _

/-- The generator `y` lies in the maximal ideal `(x, y, w_i)`. -/
private theorem example10683y_mem_maximalIdeal :
    example10683y k ∈ example10683MaximalIdeal k :=
  Ideal.subset_span <| Set.mem_insert_of_mem _ <| Set.mem_insert _ _

-- Proof sketch: modding out by the ideal generated by all variable classes kills every generator,
-- leaving only the coefficient field `k`, so the quotient by this ideal is a field.
/-- The distinguished ideal `(x, y, w_i)` in Example 10.68.3 is maximal. -/
theorem example10683MaximalIdeal_isMaximal :
    (example10683MaximalIdeal k).IsMaximal := sorry

/-- The distinguished maximal ideal of Example 10.68.3, viewed as a point of the maximal
spectrum. -/
def example10683MaximalPoint : MaximalSpectrum (example10683Ring k) :=
  ⟨example10683MaximalIdeal k, example10683MaximalIdeal_isMaximal k⟩

private abbrev example10683LocalizedIdeal : Ideal (example10683Ring k) :=
  (example10683MaximalPoint k).asIdeal

local instance : (example10683LocalizedIdeal k).IsPrime :=
  Ideal.IsMaximal.isPrime (example10683MaximalIdeal_isMaximal k)

noncomputable local instance : DistribMulAction (example10683Ring k) (example10683Ring k) :=
  (Semiring.toModule : Module (example10683Ring k) (example10683Ring k)).toDistribMulAction

private abbrev example10683LocalRing :=
  Localization.AtPrime (example10683LocalizedIdeal k)

noncomputable local instance : DistribMulAction (example10683LocalRing k) (example10683LocalRing k) :=
  (Semiring.toModule : Module (example10683LocalRing k) (example10683LocalRing k)).toDistribMulAction

local notation "xₘ" =>
  algebraMap (example10683Ring k) (example10683LocalRing k) (example10683x k)

local notation "yₘ" =>
  algebraMap (example10683Ring k) (example10683LocalRing k) (example10683y k)

-- Proof sketch: the quotient relations imply that `x` is a nonzerodivisor and that the image of
-- `y` in the quotient by `x` acts injectively on the surviving `w_i`-tower, while `y` itself
-- kills `w_0`, so `y` is a zerodivisor in the ambient ring.
private theorem example10683_regularSequence :
    Sequence.IsRegular (example10683Ring k) [example10683x k, example10683y k] := sorry

private theorem example10683_y_zeroDivisor :
    example10683y k ∉ nonZeroDivisors (example10683Ring k) := sorry

/-- Example 10.68.3: in the ring
`k[x, y, w_0, w_1, w_2, \ldots] / (y w_i, w_i - x w_{i+1} \mid i \ge 0)`, the sequence `x, y` is
regular, but `y` is a zerodivisor. -/
theorem example10683_regularSequence_and_y_zeroDivisor :
    Sequence.IsRegular (example10683Ring k) [example10683x k, example10683y k] ∧
      example10683y k ∉ nonZeroDivisors (example10683Ring k) :=
  ⟨example10683_regularSequence k, example10683_y_zeroDivisor k⟩

-- Proof sketch: first identify `(x, y, w_i)` as a maximal ideal. Then apply the owner theorem
-- `IsWeaklyRegular.isRegular_of_isLocalization_of_mem` to the weakly regular part of the ambient
-- regular sequence, using that both `x` and `y` lie in the chosen maximal ideal. The same
-- zero-divisor witness for `y` survives after passing to the local ring.
private theorem example10683_localized_y_zeroDivisor :
    yₘ ∉ nonZeroDivisors (example10683LocalRing k) := sorry

/-- Localizing the example ring at the maximal ideal `(x, y, w_i)` again yields a ring where
`x, y` is a regular sequence and `y` is a zerodivisor. -/
theorem example10683_localized_regularSequence_and_y_zeroDivisor :
    Sequence.IsRegular (Localization.AtPrime (example10683MaximalPoint k).asIdeal) [xₘ, yₘ] ∧
      yₘ ∉ nonZeroDivisors (Localization.AtPrime (example10683MaximalPoint k).asIdeal) :=
  by
    refine ⟨?_, example10683_localized_y_zeroDivisor k⟩
    simpa only [List.map] using
      (example10683_regularSequence k).toIsWeaklyRegular.isRegular_of_isLocalization_of_mem
        (example10683LocalRing k) (example10683LocalizedIdeal k) (fun r hr ↦ by
          have hr' : r = example10683x k ∨ r = example10683y k := by
            simpa using hr
          rcases hr' with rfl | rfl
          · exact example10683x_mem_maximalIdeal k
          · exact example10683y_mem_maximalIdeal k)

end

