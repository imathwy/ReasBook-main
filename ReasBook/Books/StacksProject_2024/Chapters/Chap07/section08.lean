/-! ### Definition_7_8_2 (from Chap07) -/
universe w₂ w₁ w v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] {U : C}

namespace SemiRepresentableFamily

/-- Definition 7.8.2's owner object: a family of arrows with fixed target `U` is an indexed family
of objects in the slice category `C / U`. -/
structure Over (U : C) where
  index : Type w
  obj : index → CategoryTheory.Over U

namespace Over

/-- Helper for Definition 7.8.2: a morphism of fixed-target families is a reindexing together with
componentwise maps in the slice category. -/
structure Hom {U : C} (𝒰 𝒱 : SemiRepresentableFamily.Over.{w} U) where
  α : 𝒰.index → 𝒱.index
  f : ∀ i : 𝒰.index, 𝒰.obj i ⟶ 𝒱.obj (α i)

/-- Helper for Definition 7.8.2: fixed-target families carry the expected componentwise morphism
type. -/
instance instQuiver {U : C} : Quiver (SemiRepresentableFamily.Over.{w} U) where
  Hom 𝒰 𝒱 := Hom 𝒰 𝒱

/-- Helper for Definition 7.8.2: the indexed-arrow presentation of a fixed-target family. -/
def ofArrows {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    SemiRepresentableFamily.Over.{w₁} U where
  index := I
  obj := fun i ↦ CategoryTheory.Over.mk (π i)

/- Domain-style sampling for Definition 7.8.2:
- primary domain: fixed-target families of arrows, viewed as objects of
  `SemiRepresentableFamily.Over U`, together with the presieves and sieves they generate;
- sampled owner declarations:
  `SemiRepresentableFamily.Over` from `Definition_7_8_1`,
  `Presieve.ofArrows_comp_eq_of_surjective`,
  `Sieve.ofArrows`,
  `CategoryTheory.Over.isoMk`;
- best owner abstraction: the source-facing owner remains `SemiRepresentableFamily.Over U`;
  `toPresieve` and `toSieve` are bridge/view API from that owner to the canonical mathlib presieve
  and sieve constructions on indexed arrow families;
- primitive data: a fixed-target family `𝒰 : Over U`;
- derived API: the generated presieve/sieve and the equivalence relations defined in terms of those
  canonical generated objects.

Source/core/bridge triage:
- `source-facing`: `CombinatoriallyEquivalent`, `TautologicallyEquivalent`;
- `core/canonical`: `SemiRepresentableFamily.Over U`;
- `bridge/view`: `toPresieve`, `toSieve`.
-/

/-- The canonical presieve on `U` generated by a fixed-target family. -/
abbrev toPresieve (𝒰 : Over.{w} U) : Presieve U :=
  Presieve.ofArrows (fun i ↦ (𝒰.obj i).left) fun i ↦ (𝒰.obj i).hom

@[simp]
theorem toPresieve_ofArrows {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    toPresieve (ofArrows Uᵢ π) = Presieve.ofArrows Uᵢ π :=
  rfl

@[simp]
theorem toPresieve_ofArrows_ulift {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    toPresieve (ofArrows (fun i : ULift.{w₂} I ↦ Uᵢ i.down) fun i ↦ π i.down) =
      Presieve.ofArrows Uᵢ π := by
  -- Compare the two indexed presentations through the surjective map `ULift.down`.
  simpa [ofArrows, toPresieve] using
    (Presieve.ofArrows_comp_eq_of_surjective π ULift.down_surjective)

/-- The canonical sieve on `U` generated by a fixed-target family. -/
abbrev toSieve (𝒰 : Over.{w} U) : Sieve U :=
  Sieve.generate (toPresieve 𝒰)

@[simp]
theorem toSieve_ofArrows {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    toSieve (ofArrows Uᵢ π) = Sieve.ofArrows Uᵢ π :=
  rfl

@[simp]
theorem toSieve_ofArrows_ulift {I : Type w₁} (Uᵢ : I → C) (π : ∀ i : I, Uᵢ i ⟶ U) :
    toSieve (ofArrows (fun i : ULift.{w₂} I ↦ Uᵢ i.down) fun i ↦ π i.down) =
      Sieve.ofArrows Uᵢ π := by
  -- The sieve comparison is just the generated-sieve image of the presieve comparison.
  simpa [toSieve, Sieve.ofArrows] using
    congrArg Sieve.generate (toPresieve_ofArrows_ulift Uᵢ π)

/-- A fixed-target family is covering for a precoverage precisely when the presieve it generates as
an indexed family belongs to that precoverage. This applies in particular to pretopologies. -/
abbrev IsCovering (K : Precoverage C) (𝒰 : Over.{w} U) : Prop :=
  toPresieve 𝒰 ∈ K U

/-- Definition 7.8.2 (1): in canonical form, two families of morphisms with fixed target `U` are
combinatorially equivalent when they determine the same presieve on `U`, equivalently when each
member of either family is literally one of the members of the other family after a reindexing. -/
def CombinatoriallyEquivalent
    (𝒰 𝒱 : Over.{w} U) : Prop :=
  toPresieve 𝒰 = toPresieve 𝒱

/-- Definition 7.8.2 (2): two families of morphisms with fixed target `U` are tautologically
equivalent if they admit reindexings in both directions whose component maps are isomorphisms in
the slice category `C / U`. -/
def TautologicallyEquivalent
    (𝒰 𝒱 : Over.{w} U) : Prop :=
  ∃ f : 𝒰 ⟶ 𝒱, ∃ g : 𝒱 ⟶ 𝒰,
    (∀ i : 𝒰.index, IsIso (f.f i)) ∧ ∀ j : 𝒱.index, IsIso (g.f j)

/-- Helper for Definition 7.8.2: rewrite the commutativity witness for an equality of slice
objects into the shape expected by `Over.isoMk`. -/
private theorem eqToIso_hom_comp_hom
    {A B : CategoryTheory.Over U}
    (hleft : B.left = A.left)
    (hhom : A.hom = eqToHom hleft.symm ≫ B.hom) :
    (eqToIso hleft.symm).hom ≫ B.hom = A.hom := by
  -- This is just the same triangle equation with the coercion from `eqToIso`.
  simpa using hhom.symm

/-- Helper for Definition 7.8.2: an equality of underlying slice arrows produces an isomorphism of
slice objects. -/
private def over_iso_of_left_eq_hom
    {A B : CategoryTheory.Over U}
    (hleft : B.left = A.left)
    (hhom : A.hom = eqToHom hleft.symm ≫ B.hom) :
    A ≅ B :=
  CategoryTheory.Over.isoMk (eqToIso hleft.symm) (eqToIso_hom_comp_hom hleft hhom)

/-- Helper for Definition 7.8.2: the previous witness recovers literal equality of slice objects. -/
private theorem over_obj_eq_of_left_eq_hom
    {A B : CategoryTheory.Over U}
    (hleft : B.left = A.left)
    (hhom : A.hom = eqToHom hleft.symm ≫ B.hom) :
    A = B := by
  -- Extensionality in the slice category reduces object equality to equality of domains and maps.
  simpa using
    (CostructuredArrow.obj_ext A B hleft.symm hhom.symm)

/-- Helper for Definition 7.8.2: equality of slice objects gives the `eqToHom` presentation needed
for `Presieve.ofArrows.mk'`. -/
private theorem over_hom_eq_eqToHom_comp_hom
    {A B : CategoryTheory.Over U} (h : A = B) :
    A.hom = eqToHom (congrArg (fun X : CategoryTheory.Over U ↦ X.left) h) ≫ B.hom := by
  -- After reducing to reflexivity, the statement becomes the trivial identity triangle.
  cases h
  simp

/-- Companion source-facing formulation of combinatorial equivalence: two fixed-target families are
combinatorially equivalent exactly when each is obtained from the other by reindexing its members
without changing the corresponding objects of the slice category. -/
theorem combinatoriallyEquivalent_iff_exists_reindexings
    {𝒰 𝒱 : Over.{w} U} :
    CombinatoriallyEquivalent 𝒰 𝒱 ↔
      ∃ α : 𝒰.index → 𝒱.index, ∃ β : 𝒱.index → 𝒰.index,
        (∀ i : 𝒰.index, 𝒰.obj i = 𝒱.obj (α i)) ∧
          ∀ j : 𝒱.index, 𝒱.obj j = 𝒰.obj (β j) := by
  constructor
  · intro h
    -- Equality of presieves lets us read off, for each component of `𝒰`, a matching component of
    -- `𝒱`, and conversely.
    have hα :
        ∀ i : 𝒰.index, ∃ j : 𝒱.index, 𝒰.obj i = 𝒱.obj j := by
      intro i
      have hi₀ : toPresieve 𝒰 ((𝒰.obj i).hom) := Presieve.ofArrows.mk i
      obtain ⟨j, hobj, hhom⟩ := Presieve.ofArrows_surj
        (fun j : 𝒱.index ↦ (𝒱.obj j).hom) ((𝒰.obj i).hom) (h.le _ _ hi₀)
      refine ⟨j, ?_⟩
      exact over_obj_eq_of_left_eq_hom hobj hhom
    have hβ :
        ∀ j : 𝒱.index, ∃ i : 𝒰.index, 𝒱.obj j = 𝒰.obj i := by
      intro j
      have hj₀ : toPresieve 𝒱 ((𝒱.obj j).hom) := Presieve.ofArrows.mk j
      obtain ⟨i, hobj, hhom⟩ := Presieve.ofArrows_surj
        (fun i : 𝒰.index ↦ (𝒰.obj i).hom) ((𝒱.obj j).hom) (h.ge _ _ hj₀)
      refine ⟨i, ?_⟩
      exact over_obj_eq_of_left_eq_hom hobj hhom
    choose α hα using hα
    choose β hβ using hβ
    exact ⟨α, β, hα, hβ⟩
  · rintro ⟨α, β, hα, hβ⟩
    -- The reindexing data shows that each generator on one side is literally a generator on the
    -- other side, so the presieves agree by antisymmetry.
    change toPresieve 𝒰 = toPresieve 𝒱
    apply le_antisymm
    · rw [Presieve.ofArrows_le_iff]
      intro i
      refine Presieve.ofArrows.mk' (α i) ?_ ?_
      · exact congrArg (fun X : CategoryTheory.Over U ↦ X.left) (hα i)
      · simpa using over_hom_eq_eqToHom_comp_hom (hα i)
    · rw [Presieve.ofArrows_le_iff]
      intro j
      refine Presieve.ofArrows.mk' (β j) ?_ ?_
      · exact congrArg (fun X : CategoryTheory.Over U ↦ X.left) (hβ j)
      · simpa using over_hom_eq_eqToHom_comp_hom (hβ j)

/-- Helper for Definition 7.8.2: a presieve witness gives an isomorphism on the corresponding
slice component. -/
private theorem over_hom_isIso_of_left_eq_hom
    {A B : CategoryTheory.Over U}
    (hleft : B.left = A.left)
    (hhom : A.hom = eqToHom hleft.symm ≫ B.hom) :
    IsIso (over_iso_of_left_eq_hom hleft hhom).hom := by
  -- The component map is the hom of an explicit slice isomorphism.
  infer_instance

/-- A presieve inclusion between fixed-target families yields a refinement whose components are
isomorphisms in the slice category. -/
private theorem exists_componentwiseIso_hom_of_toPresieve_le
    {𝒰 𝒱 : Over.{w} U} (h : toPresieve 𝒰 ≤ toPresieve 𝒱) :
    ∃ f : 𝒰 ⟶ 𝒱, ∀ i : 𝒰.index, IsIso (f.f i) := by
  classical
  -- For each component of `𝒰`, use the presieve inclusion to choose a matching component of `𝒱`.
  have hi :
      ∀ i : 𝒰.index,
        ∃ j : 𝒱.index,
          ∃ hobj : (𝒱.obj j).left = (𝒰.obj i).left,
            (𝒰.obj i).hom = eqToHom hobj.symm ≫ (𝒱.obj j).hom := by
    intro i
    exact Presieve.ofArrows_surj (fun j : 𝒱.index ↦ (𝒱.obj j).hom) ((𝒰.obj i).hom)
      (h _ _ (Presieve.ofArrows.mk i))
  choose α hαobj hαhom using hi
  refine ⟨
    { α := α
      f := fun i ↦ (over_iso_of_left_eq_hom (hαobj i) (hαhom i)).hom },
    ?_⟩
  intro i
  -- Each chosen component map is the hom of the explicit slice isomorphism above.
  exact over_hom_isIso_of_left_eq_hom (hαobj i) (hαhom i)

-- Proof sketch: a combinatorial equivalence is equality of the canonical presieves, so each
-- direction gives a refinement whose components are slice isomorphisms.
/-- Lemma 7.8.3 (1): combinatorially equivalent families of morphisms with fixed target are
tautologically equivalent. -/
theorem combinatoriallyEquivalent_implies_tautologicallyEquivalent
    {𝒰 𝒱 : Over.{w} U}
    (h : CombinatoriallyEquivalent 𝒰 𝒱) :
    TautologicallyEquivalent 𝒰 𝒱 := by
  -- Use the common presieve to build reindexing morphisms in both directions.
  rcases exists_componentwiseIso_hom_of_toPresieve_le h.le with ⟨f, hf⟩
  rcases exists_componentwiseIso_hom_of_toPresieve_le h.ge with ⟨g, hg⟩
  exact ⟨f, g, hf, hg⟩

/-- A morphism of fixed-target families induces inclusion of the generated sieves. -/
theorem toSieve_le_of_hom {𝒰 𝒱 : Over.{w} U} (φ : 𝒰 ⟶ 𝒱) :
    toSieve 𝒰 ≤ toSieve 𝒱 := by
  rw [toSieve, toSieve, Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  intro i
  -- Each generator of `𝒰` factors through the corresponding chosen generator of `𝒱`.
  refine ⟨_, (φ.f i).left, _, Presieve.ofArrows.mk (φ.α i), ?_⟩
  simpa using CategoryTheory.Over.w (φ.f i)

-- Proof sketch: a tautological equivalence supplies morphisms in both directions, and any
-- morphism of fixed-target families induces inclusion of the generated sieves.
/-- Tautologically equivalent fixed-target families generate the same sieve. -/
theorem toSieve_eq_of_tautologicallyEquivalent
    {𝒰 𝒱 : Over.{w} U} (h : TautologicallyEquivalent 𝒰 𝒱) :
    toSieve 𝒰 = toSieve 𝒱 := by
  -- Antisymmetry reduces the result to the two sieve inclusions coming from the comparison maps.
  rcases h with ⟨f, g, -, -⟩
  exact le_antisymm (toSieve_le_of_hom f) (toSieve_le_of_hom g)

end Over
end SemiRepresentableFamily

end CategoryTheory

/-! ### Lemma_7_8_3 (from Chap07) -/
universe w v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] {U : C}

namespace SemiRepresentableFamily

/-- Helper for Lemma 7.8.3: a fixed-target family is an indexed family of objects of the slice
category `C / U`. -/
structure Over (U : C) where
  index : Type w
  obj : index → CategoryTheory.Over U

namespace Over

/-- Helper for Lemma 7.8.3: a morphism of fixed-target families reindexes the components and gives
slice morphisms to the reindexed targets. -/
structure Hom {U : C}
    (𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U) where
  α : 𝒰.index → 𝒱.index
  f : ∀ i : 𝒰.index, 𝒰.obj i ⟶ 𝒱.obj (α i)

instance {U : C} : Category (CategoryTheory.SemiRepresentableFamily.Over U) where
  Hom 𝒰 𝒱 := Hom 𝒰 𝒱
  id 𝒰 :=
    { α := fun i ↦ i
      f := fun i ↦ 𝟙 (𝒰.obj i) }
  comp f g :=
    { α := fun i ↦ g.α (f.α i)
      f := fun i ↦ f.f i ≫ g.f (f.α i) }
  id_comp := by
    intro 𝒰 𝒱 f
    cases f
    simp
  comp_id := by
    intro 𝒰 𝒱 f
    cases f
    simp
  assoc := by
    intro 𝒰 𝒱 𝒲 𝒳 f g h
    cases f
    cases g
    cases h
    simp [Category.assoc]

/-- Helper for Lemma 7.8.3: refinement means the existence of a morphism of fixed-target
families. -/
abbrev Refines {U : C}
    (𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U) : Prop :=
  Nonempty (𝒰 ⟶ 𝒱)

/-- Helper for Lemma 7.8.3: the canonical presieve generated by a fixed-target family. -/
abbrev toPresieve (𝒰 : CategoryTheory.SemiRepresentableFamily.Over U) : Presieve U :=
  Presieve.ofArrows (fun i ↦ (𝒰.obj i).left) fun i ↦ (𝒰.obj i).hom

/-- Helper for Lemma 7.8.3: two fixed-target families are combinatorially equivalent when they
generate the same presieve on the target object. -/
def CombinatoriallyEquivalent
    (𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U) : Prop :=
  𝒰.toPresieve = 𝒱.toPresieve

/-- Helper for Lemma 7.8.3: two fixed-target families are tautologically equivalent when they
admit morphisms in both directions whose components are isomorphisms in the slice category. -/
def TautologicallyEquivalent
    (𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U) : Prop :=
  ∃ f : 𝒰 ⟶ 𝒱, ∃ g : 𝒱 ⟶ 𝒰,
    (∀ i : 𝒰.index, IsIso (f.f i)) ∧ ∀ j : 𝒱.index, IsIso (g.f j)

/-- Helper for Lemma 7.8.3: a presieve inclusion between fixed-target families yields a
refinement whose components are isomorphisms in the slice category. -/
private theorem exists_componentwise_iso_hom_of_toPresieve_le
    {𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U}
    (h : 𝒰.toPresieve ≤ 𝒱.toPresieve) :
    ∃ f : 𝒰 ⟶ 𝒱, ∀ i : 𝒰.index, IsIso (f.f i) := by
  classical
  -- Each component arrow of `𝒰` belongs to the presieve of `𝒱`, so it coincides with a chosen
  -- component of `𝒱` up to an explicit slice isomorphism.
  have hi :
      ∀ i : 𝒰.index,
        ∃ j : 𝒱.index,
          ∃ hobj : (𝒱.obj j).left = (𝒰.obj i).left,
            (𝒰.obj i).hom = eqToHom hobj.symm ≫ (𝒱.obj j).hom := by
    intro i
    exact Presieve.ofArrows_surj (fun j : 𝒱.index ↦ (𝒱.obj j).hom) ((𝒰.obj i).hom)
      (h _ _ (Presieve.ofArrows.mk i))
  choose α hαobj hαhom using hi
  -- Package those chosen componentwise identifications into a morphism of families.
  refine ⟨
    { α := α
      f := fun i ↦
        (CategoryTheory.Over.isoMk
          (eqToIso (hαobj i).symm)
          (by simpa using (hαhom i).symm)).hom },
    ?_⟩
  intro i
  -- Each component map is an isomorphism because it is the hom of an explicit slice isomorphism.
  change IsIso
    ((CategoryTheory.Over.isoMk
      (eqToIso (hαobj i).symm)
      (by simpa using (hαhom i).symm)).hom)
  infer_instance

-- Route correction: the imported chapter prefix does not currently expose the fixed-target family
-- owner API, so this file proves Lemma 7.8.3 directly from the canonical presieve and slice data.

-- Proof sketch: a combinatorial equivalence is equality of the canonical presieves, so each
-- direction gives a family morphism whose components are slice isomorphisms.
/-- Lemma 7.8.3 (0): combinatorially equivalent families of morphisms with fixed target are
tautologically equivalent. -/
theorem combinatoriallyEquivalent_implies_tautologicallyEquivalent
    {𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U}
    (h : CombinatoriallyEquivalent 𝒰 𝒱) :
    TautologicallyEquivalent 𝒰 𝒱 := by
  -- Apply the presieve-inclusion bridge in both directions and package the two witnesses.
  rcases exists_componentwise_iso_hom_of_toPresieve_le h.le with ⟨f, hf⟩
  rcases exists_componentwise_iso_hom_of_toPresieve_le h.ge with ⟨g, hg⟩
  exact ⟨f, g, hf, hg⟩

/-- Helper for Lemma 7.8.3: a tautological equivalence forgets to a refinement. -/
theorem TautologicallyEquivalent.refines
    {𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U}
    (h : TautologicallyEquivalent 𝒰 𝒱) :
    Refines 𝒰 𝒱 := by
  -- Forget the componentwise isomorphism data and keep only the forward family morphism.
  rcases h with ⟨f, _, _, _⟩
  exact ⟨f⟩

/-- Helper for Lemma 7.8.3: tautological equivalence is reflexive. -/
theorem TautologicallyEquivalent.refl
    (𝒰 : CategoryTheory.SemiRepresentableFamily.Over U) :
    TautologicallyEquivalent 𝒰 𝒰 := by
  -- The identity morphisms witness the two directions, and each identity component is an
  -- isomorphism in the slice category.
  refine ⟨𝟙 𝒰, 𝟙 𝒰, ?_, ?_⟩
  · intro i
    change IsIso (𝟙 (𝒰.obj i))
    infer_instance
  · intro i
    change IsIso (𝟙 (𝒰.obj i))
    infer_instance

/-- Helper for Lemma 7.8.3: tautological equivalence is symmetric. -/
theorem TautologicallyEquivalent.symm
    {𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U}
    (h : TautologicallyEquivalent 𝒰 𝒱) :
    TautologicallyEquivalent 𝒱 𝒰 := by
  -- Swap the two witness morphisms and their componentwise isomorphism data.
  rcases h with ⟨f, g, hf, hg⟩
  exact ⟨g, f, hg, hf⟩

/-- Helper for Lemma 7.8.3: tautological equivalence is transitive. -/
theorem TautologicallyEquivalent.trans
    {𝒰 𝒱 𝒲 : CategoryTheory.SemiRepresentableFamily.Over U}
    (h𝒰𝒱 : TautologicallyEquivalent 𝒰 𝒱)
    (h𝒱𝒲 : TautologicallyEquivalent 𝒱 𝒲) :
    TautologicallyEquivalent 𝒰 𝒲 := by
  -- Compose the witness morphisms in both directions; composition preserves slice isomorphisms.
  rcases h𝒰𝒱 with ⟨f, g, hf, hg⟩
  rcases h𝒱𝒲 with ⟨f', g', hf', hg'⟩
  refine ⟨f ≫ f', g' ≫ g, ?_, ?_⟩
  · intro i
    change IsIso (f.f i ≫ f'.f (f.α i))
    infer_instance
  · intro i
    change IsIso (g'.f i ≫ g.f (g'.α i))
    infer_instance

/-- Helper for Lemma 7.8.3: refinement is reflexive. -/
theorem Refines.refl
    (𝒰 : CategoryTheory.SemiRepresentableFamily.Over U) : Refines 𝒰 𝒰 :=
  ⟨𝟙 𝒰⟩

/-- Helper for Lemma 7.8.3: refinement is transitive by composition of family morphisms. -/
theorem Refines.trans
    {𝒰 𝒱 𝒲 : CategoryTheory.SemiRepresentableFamily.Over U}
    (h𝒰𝒱 : Refines 𝒰 𝒱) (h𝒱𝒲 : Refines 𝒱 𝒲) :
    Refines 𝒰 𝒲 :=
  Nonempty.map2 (· ≫ ·) h𝒰𝒱 h𝒱𝒲

-- Proof sketch: a tautological equivalence already contains family morphisms in both directions,
-- so forgetting the componentwise isomorphism data gives mutual refinement.
/-- Lemma 7.8.3 (1): tautologically equivalent families of morphisms with fixed target refine each
other. -/
theorem tautologicallyEquivalent_implies_refines_in_both_directions
    {𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U}
    (h : TautologicallyEquivalent 𝒰 𝒱) :
    Refines 𝒰 𝒱 ∧ Refines 𝒱 𝒰 := by
  -- Use the forward witness directly and symmetry for the reverse refinement.
  exact ⟨h.refines, h.symm.refines⟩

-- Proof sketch: `CombinatoriallyEquivalent` is equality of the canonical presieves attached to the
-- two families, so its relation laws are exactly the equality laws transported along `toPresieve`.
/-- Lemma 7.8.3 (2): combinatorial equivalence is an equivalence relation on families of
morphisms with fixed target `U`. -/
theorem combinatoriallyEquivalent_isEquivalence :
    _root_.Equivalence
      (CombinatoriallyEquivalent :
        CategoryTheory.SemiRepresentableFamily.Over U →
          CategoryTheory.SemiRepresentableFamily.Over U → Prop) := by
  -- This relation is equality after applying the generated-presieve map.
  simpa [CombinatoriallyEquivalent] using
    eq_equivalence.comap
      (fun 𝒰 : CategoryTheory.SemiRepresentableFamily.Over U ↦ 𝒰.toPresieve)

-- Proof sketch: reflexivity uses identity morphisms, symmetry swaps the two witness morphisms,
-- and transitivity composes them while preserving componentwise isomorphisms.
/-- Lemma 7.8.3 (3): tautological equivalence is an equivalence relation on families of morphisms
with fixed target `U`. -/
theorem tautologicallyEquivalent_isEquivalence :
    _root_.Equivalence
      (TautologicallyEquivalent :
        CategoryTheory.SemiRepresentableFamily.Over U →
          CategoryTheory.SemiRepresentableFamily.Over U → Prop) := by
  -- Assemble the relation API proved above.
  exact ⟨TautologicallyEquivalent.refl, TautologicallyEquivalent.symm,
    TautologicallyEquivalent.trans⟩

-- Proof sketch: reflexivity is identity, symmetry swaps the two refinements, and transitivity
-- composes the refinement morphisms in each direction.
/-- Lemma 7.8.3 (4): refining each other is an equivalence relation on families of morphisms with
fixed target `U`. -/
theorem refines_in_both_directions_isEquivalence :
    _root_.Equivalence
      (fun 𝒰 𝒱 : CategoryTheory.SemiRepresentableFamily.Over U ↦
        Refines 𝒰 𝒱 ∧ Refines 𝒱 𝒰) := by
  -- Package the reflexive, symmetric, and transitive structure of mutual refinement.
  refine ⟨?_, ?_, ?_⟩
  · intro 𝒰
    exact ⟨Refines.refl 𝒰, Refines.refl 𝒰⟩
  · intro 𝒰 𝒱 h
    exact ⟨h.2, h.1⟩
  · intro 𝒰 𝒱 𝒲 h𝒰𝒱 h𝒱𝒲
    exact ⟨h𝒰𝒱.1.trans h𝒱𝒲.1, h𝒱𝒲.2.trans h𝒰𝒱.2⟩

end Over
end SemiRepresentableFamily

end CategoryTheory

/-! ### Lemma_7_8_4 (from Chap07) -/
universe u v w t s

namespace CategoryTheory

variable {C : Type u} [Category.{v} C]
variable {U : C}
variable {I : Type t} {J : Type s}
variable (Ui : I → C) (π : ∀ i, Ui i ⟶ U)
variable (Vj : J → C) (ψ : ∀ j, Vj j ⟶ U)
variable (F : Cᵒᵖ ⥤ Type w)

/-- Helper for Lemma 7.8.4: componentwise slice isomorphisms force inclusion of the generated
sieves. -/
private theorem sieve_ofArrows_le_of_componentwise_iso
    (α : I → J)
    (hα : ∀ i, Over.mk (π i) ≅ Over.mk (ψ (α i))) :
    Sieve.ofArrows Ui π ≤ Sieve.ofArrows Vj ψ := by
  -- Each generator `π i` factors through the corresponding generator `ψ (α i)` in the slice.
  rw [Sieve.ofArrows]
  refine (Sieve.generate_le_iff (R := Presieve.ofArrows Ui π) (S := Sieve.ofArrows Vj ψ)).2 ?_
  rw [Presieve.ofArrows_le_iff]
  intro i
  refine ⟨Vj (α i), (hα i).hom.left, ψ (α i), Presieve.ofArrows.mk (α i), ?_⟩
  simpa using (Over.w ((hα i).hom))

/-- Helper for Lemma 7.8.4: comparison data in both directions identify the generated sieves. -/
private theorem sieve_ofArrows_eq_of_tautological_data
    (α : I → J) (β : J → I)
    (hα : ∀ i, Over.mk (π i) ≅ Over.mk (ψ (α i)))
    (hβ : ∀ j, Over.mk (ψ j) ≅ Over.mk (π (β j))) :
    Sieve.ofArrows Ui π = Sieve.ofArrows Vj ψ := by
  -- The two inclusions come from factoring each generator through an isomorphic one.
  exact le_antisymm
    (sieve_ofArrows_le_of_componentwise_iso Ui π Vj ψ α hα)
    (sieve_ofArrows_le_of_componentwise_iso Vj ψ Ui π β hβ)

/-- Lemma 7.8.4: tautologically equivalent indexed families of morphisms with the same fixed
target impose equivalent sheaf conditions on any presheaf. -/
theorem isSheafFor_ofArrows_iff_of_tautological_equivalence
    (α : I → J) (β : J → I)
    (hα : ∀ i, Over.mk (π i) ≅ Over.mk (ψ (α i)))
    (hβ : ∀ j, Over.mk (ψ j) ≅ Over.mk (π (β j))) :
    (Presieve.ofArrows Ui π).IsSheafFor F ↔ (Presieve.ofArrows Vj ψ).IsSheafFor F := by
  -- Step 1: replace each indexed-family sheaf condition by the equivalent generated-sieve form.
  calc
    (Presieve.ofArrows Ui π).IsSheafFor F ↔ (Sieve.ofArrows Ui π).arrows.IsSheafFor F := by
      simpa [Sieve.ofArrows] using
        (Presieve.isSheafFor_iff_generate (P := F) (Presieve.ofArrows Ui π))
    _ ↔ (Sieve.ofArrows Vj ψ).arrows.IsSheafFor F := by
      -- Step 2: tautological comparison identifies the generated sieves on `U`.
      rw [sieve_ofArrows_eq_of_tautological_data Ui π Vj ψ α β hα hβ]
    _ ↔ (Presieve.ofArrows Vj ψ).IsSheafFor F := by
      simpa [Sieve.ofArrows] using
        (Presieve.isSheafFor_iff_generate (P := F) (Presieve.ofArrows Vj ψ)).symm

end CategoryTheory

/-! ### Lemma_7_8_5 (from Chap07) -/
open Opposite

universe w v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C]

/- Domain-style sampling for Lemma 7.8.5:
- primary domain: separatedness of set-valued presheaves for presieves, and fixed-target families
  viewed through the presieves they generate;
- inspected owner declarations:
  `Presieve.IsSeparatedFor`,
  `Presieve.IsSeparatedFor.ext`,
  `Presieve.FactorsThru`,
  `SemiRepresentableFamily.Over.Refines`;
- best owner abstraction: the core separatedness statement lives on the canonical presieve owner
  `Presieve.IsSeparatedFor`, and refinement of fixed-target families is a bridge/view statement via
  the induced factorization relation `Presieve.FactorsThru` between the generated presieves;
- primitive data: a presieve `R`, a presieve `S`, a factorization witness `R.FactorsThru S`, and a
  fixed-target family morphism `𝒱 ⟶ 𝒰`;
- derived API here: the owner-level monotonicity theorem
  `Presieve.IsSeparatedFor.of_factorsThru`, the bridge theorem
  `SemiRepresentableFamily.Over.toPresieve_factorsThru_of_hom`, the family-morphism theorem
  `SemiRepresentableFamily.Over.isSeparatedFor_of_hom`, and the source-facing refinement corollary
  `SemiRepresentableFamily.Over.isSeparatedFor_of_refines`.

Source/core/bridge triage:
- `source-facing`: `SemiRepresentableFamily.Over.isSeparatedFor_of_refines`;
- `core/canonical`: `Presieve.IsSeparatedFor` together with `Presieve.FactorsThru`;
- `bridge/view`: `SemiRepresentableFamily.Over.toPresieve_factorsThru_of_hom`.
-/

namespace Presieve

/-- If every arrow of `R` factors through an arrow of `S`, then separatedness for `R` implies
separatedness for `S`. -/
theorem IsSeparatedFor.of_factorsThru {U : C} {ℱ : Cᵒᵖ ⥤ Type w} {R S : Presieve U}
    (hR : R.IsSeparatedFor ℱ) (hRS : R.FactorsThru S) :
    S.IsSeparatedFor ℱ := by
  intro x t₁ t₂ ht₁ ht₂
  apply hR.ext
  intro Y f hf
  rcases hRS hf with ⟨Z, i, g, hg, rfl⟩
  simp_rw [op_comp, FunctorToTypes.map_comp_apply]
  rw [ht₁ _ hg, ht₂ _ hg]

end Presieve

namespace Over

/-- Helper for Lemma 7.8.5: the presieve generated by the single arrow carried by an object of
`Over U`. -/
abbrev toPresieve {U : C} (𝒰 : Over U) : Presieve U :=
  Presieve.singleton (show 𝒰.left ⟶ U from 𝒰.hom)

end Over

namespace SemiRepresentableFamily
namespace Over

/-- Helper for Lemma 7.8.5: a morphism of fixed-target arrows makes the source-generated presieve
factor through the target-generated presieve. -/
theorem toPresieve_factorsThru_of_hom {U : C} {𝒱 𝒰 : Over U} (φ : 𝒱 ⟶ 𝒰) :
    𝒱.toPresieve.FactorsThru 𝒰.toPresieve := by
  -- Every arrow in the singleton presieve of `𝒱` is the distinguished arrow itself.
  intro Y f hf
  cases hf
  -- The refinement morphism `φ.left` gives the needed factorization through `𝒰.hom`.
  refine ⟨𝒰.left, φ.left, (show 𝒰.left ⟶ U from 𝒰.hom), Presieve.singleton.mk, ?_⟩
  simpa using Over.w φ

/-- Helper for Lemma 7.8.5: separatedness descends along an explicit morphism of fixed-target
arrows. -/
theorem isSeparatedFor_of_hom {U : C} (ℱ : Cᵒᵖ ⥤ Type w)
    {𝒱 𝒰 : Over U} (φ : 𝒱 ⟶ 𝒰)
    (h𝒱 : 𝒱.toPresieve.IsSeparatedFor ℱ) :
    𝒰.toPresieve.IsSeparatedFor ℱ := by
  -- Apply the core presieve monotonicity lemma to the factorization induced by `φ`.
  exact h𝒱.of_factorsThru (toPresieve_factorsThru_of_hom φ)

/-- Lemma 7.8.5: if a fixed-target family `𝒱` refines `𝒰` and `ℱ` is separated for `𝒱`, then
`ℱ` is separated for `𝒰`. -/
theorem isSeparatedFor_of_refines {U : C} (ℱ : Cᵒᵖ ⥤ Type w)
    {𝒱 𝒰 : Over U} (h : Refines 𝒱 𝒰)
    (h𝒱 : 𝒱.toPresieve.IsSeparatedFor ℱ) :
    𝒰.toPresieve.IsSeparatedFor ℱ := by
  -- Unpack the refinement witness and reduce to the explicit-hom form.
  exact h.elim fun φ ↦ isSeparatedFor_of_hom ℱ φ h𝒱

end Over
end SemiRepresentableFamily

end CategoryTheory

