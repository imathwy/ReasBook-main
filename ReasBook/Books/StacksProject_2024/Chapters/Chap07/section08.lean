    obtain ⟨j, rfl, rfl⟩ := Presieve.ofArrows_surj (fun j : 𝒱.index ↦ (𝒱.obj j).hom) f hf
    refine ⟨(𝒰.obj (φ.α j)).left, (φ.f j).left, (𝒰.obj (φ.α j)).hom,
