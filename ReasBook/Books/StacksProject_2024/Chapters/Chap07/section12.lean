/-! ### Definition_7_12_1 (from Chap07) -/
universe w v u

namespace CategoryTheory

open Limits
open Equalizer.Presieve.Arrows

variable {C : Type u} [Category.{v} C]

namespace SemiRepresentableFamily
namespace Over

open CategoryTheory.Over (pullbackId)

variable {U : C}

/- Domain-style sampling for Definition 7.12.1:
- primary domain: effective epimorphic families in slice categories, expressed through the owner
  `SemiRepresentableFamily.Over U` and the canonical presieve generated by such a family;
- sampled owner declarations:
  `SemiRepresentableFamily.Over`,
  `SemiRepresentableFamily.Over.toPresieve`,
  `Presieve.EffectiveEpimorphic`,
  `(𝟭 C).relativelyRepresentable`;
- best owner abstraction:
  the source-facing owner remains `SemiRepresentableFamily.Over U`, while the canonical
  foundational notions are the generated-presieve owner `K.toPresieve.EffectiveEpimorphic` and
  the componentwise morphism property `(𝟭 C).relativelyRepresentable`;
- primitive-vs-derived split:
  primitive data: a fixed-target family `K : Over U`;
  derived API: effective-epimorphicity of the generated presieve, the induced
  `EffectiveEpiFamily` instance, pullback existence along each component, the Yoneda equalizer
  criterion, and the universal base-change stability predicate;
- source/core/bridge triage:
  `source-facing`: `IsEffectiveEpimorphism`, `IsUniversalEffectiveEpimorphism`;
  `core/canonical`: `K.toPresieve.EffectiveEpimorphic`, `(𝟭 C).relativelyRepresentable`;
  `bridge/view`: `baseChange`, which keeps only the pullbacks of the listed family members and so
  is more general than the ambient owner `Over.pullback f`, which would require
  `HasPullbacksAlong f`; under that stronger owner hypothesis, the companion bridge theorem
  `baseChange_eq_map_pullback` identifies it with `SemiRepresentableFamily.map
  (CategoryTheory.Over.pullback f)`. -/

/-- The componentwise slice pullback of a fixed-target family along a morphism `f : V ⟶ U`. -/
noncomputable abbrev baseChange (K : Over U) {V : C} (f : V ⟶ U)
    [∀ i : K.index, Limits.HasPullback (K.obj i).hom f] : Over V :=
  ofArrows
    (fun i : K.index ↦ Limits.pullback (K.obj i).hom f)
    (fun i ↦ Limits.pullback.snd (K.obj i).hom f)

/-- The `i`th component of `baseChange K f` is the pullback object over the new target. -/
@[simp] theorem baseChange_obj_hom (K : Over U) {V : C} (f : V ⟶ U)
    [∀ i : K.index, Limits.HasPullback (K.obj i).hom f] (i : K.index) :
    ((baseChange K f).obj i).hom = Limits.pullback.snd (K.obj i).hom f := rfl

private instance hasPullback_of_hasPullbacksAlong
    (K : Over U) {V : C} (f : V ⟶ U) [Limits.HasPullbacksAlong f] (i : K.index) :
    Limits.HasPullback (K.obj i).hom f :=
  (inferInstance : Limits.HasPullbacksAlong f) (K.obj i).hom

attribute [instance 100] hasPullback_of_hasPullbacksAlong

/-- Definition 7.12.1 (1): a fixed-target family is an effective epimorphism when each component
arrow is representable and the presieve generated by the family is effective epimorphic. By
`Presieve.EffectiveEpimorphic.iff_forall_isSheafFor_yoneda` and
`Equalizer.Presieve.Arrows.sheaf_condition`, this is equivalent to the textbook equalizer
condition on representable presheaves. -/
class IsEffectiveEpimorphism (K : Over U) : Prop where
  /-- Every component arrow of the family is representable. -/
  representable (i : K.index) : (𝟭 C).relativelyRepresentable (K.obj i).hom
  /-- The canonical presieve generated by the family is effective epimorphic. -/
  effectiveEpimorphic : K.toPresieve.EffectiveEpimorphic

instance (K : Over U) [hK : IsEffectiveEpimorphism K] :
    EffectiveEpiFamily (fun i : K.index ↦ (K.obj i).left) (fun i ↦ (K.obj i).hom) :=
  (Sieve.effectiveEpimorphic_family
      (fun i : K.index ↦ (K.obj i).left)
      (fun i : K.index ↦ (K.obj i).hom)).mp
    hK.effectiveEpimorphic

private theorem toPresieveHasPairwisePullbacks (K : Over U)
    (hK : ∀ i : K.index, Limits.HasPullbacksAlong (K.obj i).hom) :
    K.toPresieve.HasPairwisePullbacks where
  has_pullbacks := by
    intro Y Z f hf g hg
    obtain ⟨i, hi, rfl⟩ :=
      Presieve.ofArrows_surj (fun i : K.index ↦ (K.obj i).hom) f hf
    obtain ⟨j, hj, rfl⟩ :=
      Presieve.ofArrows_surj (fun i : K.index ↦ (K.obj i).hom) g hg
    subst hi
    subst hj
    simpa using hK j (K.obj i).hom

instance (K : Over U) [hK : IsEffectiveEpimorphism K] (i : K.index) :
    Limits.HasPullbacksAlong (K.obj i).hom :=
  (relativelyRepresentable_iff_hasPullbacksAlong _).mp (hK.representable i)

private theorem hasPullback_of_representable {V W : C} (f : V ⟶ U) {g : W ⟶ U}
    (hg : (𝟭 C).relativelyRepresentable g) : Limits.HasPullback g f := by
  haveI : Limits.HasPullback f g := (relativelyRepresentable_iff_hasPullbacksAlong _).mp hg f
  exact Limits.hasPullback_symmetry f g

instance (K : Over U) [hK : IsEffectiveEpimorphism K] {V : C} (f : V ⟶ U) (i : K.index) :
    Limits.HasPullback (K.obj i).hom f :=
  hasPullback_of_representable f (hK.representable i)

instance (K : Over U) [hK : IsEffectiveEpimorphism K] :
    K.toPresieve.HasPairwisePullbacks :=
  toPresieveHasPairwisePullbacks K fun i ↦
    (inferInstance : Limits.HasPullbacksAlong (K.obj i).hom)

private instance ofArrowsHasPairwisePullbacks (K : Over U) [IsEffectiveEpimorphism K] :
    (Presieve.ofArrows (fun i : K.index ↦ (K.obj i).left)
      fun i ↦ (K.obj i).hom).HasPairwisePullbacks := by
  simpa [toPresieve] using (inferInstance : K.toPresieve.HasPairwisePullbacks)

/-- The textbook equalizer fork on `Hom_{\mathcal C}(-, X)` attached to an effective epimorphism
family `K`. -/
noncomputable abbrev yonedaEqualizerFork
    (K : Over U) [IsEffectiveEpimorphism K] (X : C) :
    Fork
      (firstMap (yoneda.obj X)
        (fun i : K.index ↦ (K.obj i).left)
        (fun i ↦ (K.obj i).hom))
      (secondMap (yoneda.obj X)
        (fun i : K.index ↦ (K.obj i).left)
        (fun i ↦ (K.obj i).hom)) :=
  Limits.Fork.ofι
    (forkMap (yoneda.obj X)
      (fun i : K.index ↦ (K.obj i).left)
      (fun i ↦ (K.obj i).hom))
    (w (yoneda.obj X)
      (fun i : K.index ↦ (K.obj i).left)
      (fun i ↦ (K.obj i).hom))

-- Proof sketch: apply `sheaf_condition` to the representable presheaf
-- `yoneda.obj X` and the presieve generated by the component arrows of `K`; the pairwise pullbacks
-- come from the representability of the component arrows.
private theorem isEffectiveEpimorphism_yoneda_equalizer_nonempty (K : Over U)
    [hK : IsEffectiveEpimorphism K] (X : C) :
    Nonempty (Limits.IsLimit (yonedaEqualizerFork K X)) := by
  have hSheaf : K.toPresieve.IsSheafFor (yoneda.obj X) :=
    Presieve.EffectiveEpimorphic.isSheafFor_of_isRepresentable
      hK.effectiveEpimorphic (yoneda.obj X)
  simpa [toPresieve] using
    (sheaf_condition
      (yoneda.obj X)
      (fun i : K.index ↦ (K.obj i).left)
      (fun i ↦ (K.obj i).hom)).mp hSheaf

/-- An effective epimorphism family satisfies the textbook equalizer diagram on
`Hom_{\mathcal C}(-, X)` for every object `X`. -/
noncomputable def IsEffectiveEpimorphism.yonedaEqualizerIsLimit (K : Over U)
    [IsEffectiveEpimorphism K] (X : C) :
    Limits.IsLimit (yonedaEqualizerFork K X) :=
  (isEffectiveEpimorphism_yoneda_equalizer_nonempty K X).some

private instance hasPullbacksAlong_id : Limits.HasPullbacksAlong (𝟙 U) := by
  intro W g
  exact (IsPullback.id_horiz g).hasPullback

/-- Helper for Definition 7.12.1: the identity base change has a canonical comparison map from the
pulled-back component back to the original slice object. -/
private noncomputable abbrev baseChangeIdHom (K : Over U) (i : K.index) :
    ((baseChange K (𝟙 U)).obj i) ⟶ K.obj i :=
  -- The pullback over the identity maps back to the original arrow by the first projection.
  CategoryTheory.Over.homMk (Limits.pullback.fst (K.obj i).hom (𝟙 U)) (by
    simpa using
      (Limits.pullback.condition :
        Limits.pullback.fst (K.obj i).hom (𝟙 U) ≫ (K.obj i).hom =
          Limits.pullback.snd (K.obj i).hom (𝟙 U) ≫ 𝟙 U))

/-- Helper for Definition 7.12.1: the comparison map from the identity base change is an
isomorphism on the underlying object. -/
private instance baseChangeIdHom_left_isIso (K : Over U) (i : K.index) :
    IsIso ((baseChangeIdHom K i).left) := by
  letI : Limits.HasPullback (K.obj i).hom (𝟙 U) :=
    (IsPullback.id_horiz (K.obj i).hom).hasPullback
  change IsIso (Limits.pullback.fst (K.obj i).hom (𝟙 U))
  have hIsoId : IsIso (𝟙 U) := by
    exact ⟨⟨𝟙 U, by simp, by simp⟩⟩
  exact @Limits.pullback_fst_iso_of_right_iso _ _ _ _ _ (K.obj i).hom (𝟙 U) hIsoId

/-- Helper for Definition 7.12.1: the comparison map from the identity base change is epi on the
underlying object because it is an isomorphism. -/
private instance baseChangeIdHom_left_epi (K : Over U) (i : K.index) :
    Epi ((baseChangeIdHom K i).left) := by
  infer_instance

private theorem isEffectiveEpimorphism_of_baseChangeId (K : Over U)
    (hK : IsEffectiveEpimorphism (baseChange K (𝟙 U))) :
    IsEffectiveEpimorphism K where
  representable i := by
    -- Route correction: transport representability along the concrete pullback projection rather
    -- than through a nonexistent category structure on fixed-target families.
    have hw :
        (baseChangeIdHom K i).left ≫ (K.obj i).hom =
          ((baseChange K (𝟙 U)).obj i).hom :=
      Over.w (baseChangeIdHom K i)
    exact
      (((𝟭 C).relativelyRepresentable).cancel_left_of_respectsIso
          ((baseChangeIdHom K i).left) ((K.obj i).hom)).mp
        (hw ▸ hK.representable i)
  effectiveEpimorphic := by
    -- The base-changed family is effective with composite arrows equal to the original pullback
    -- family, so composing by the epi comparison maps preserves effective epimorphicity.
    let g : (i : K.index) → ((baseChange K (𝟙 U)).obj i).left ⟶ (K.obj i).left :=
      fun i ↦ (baseChangeIdHom K i).left
    have hcomp :
        (fun i ↦ g i ≫ (K.obj i).hom) =
          fun i ↦ ((baseChange K (𝟙 U)).obj i).hom := by
      funext i
      exact Over.w (baseChangeIdHom K i)
    have hEffective :
        EffectiveEpiFamily
          (fun i : K.index ↦ ((baseChange K (𝟙 U)).obj i).left)
          (fun i ↦ g i ≫ (K.obj i).hom) := by
      let hEffective' :
          EffectiveEpiFamily
            (fun i : K.index ↦ ((baseChange K (𝟙 U)).obj i).left)
            (fun i : K.index ↦ ((baseChange K (𝟙 U)).obj i).hom) :=
        (Sieve.effectiveEpimorphic_family
          (fun i : K.index ↦ ((baseChange K (𝟙 U)).obj i).left)
          (fun i : K.index ↦ ((baseChange K (𝟙 U)).obj i).hom)).mp hK.effectiveEpimorphic
      exact hcomp.symm ▸ hEffective'
    letI :
        ∀ i : K.index, Epi (g i) :=
      fun i ↦ by
        simpa [g] using (inferInstance : Epi ((baseChangeIdHom K i).left))
    letI :
        EffectiveEpiFamily
          (fun i : K.index ↦ ((baseChange K (𝟙 U)).obj i).left)
          (fun i ↦ g i ≫ (K.obj i).hom) :=
      hEffective
    let hFinal :
        EffectiveEpiFamily (fun i : K.index ↦ (K.obj i).left)
          (fun i ↦ (K.obj i).hom) :=
      @effectiveEpiFamily_of_effectiveEpi_epi_comp _ _ _ _ _ _
        (fun i ↦ (K.obj i).hom)
        g
        (fun i ↦ by
          simpa [g] using (inferInstance : Epi ((baseChangeIdHom K i).left)))
        hEffective
    simpa [toPresieve] using
      (Sieve.effectiveEpimorphic_family
        (fun i : K.index ↦ (K.obj i).left)
        (fun i : K.index ↦ (K.obj i).hom)).mpr hFinal

/-- Definition 7.12.1 (2): a fixed-target family is a universal effective epimorphism when every
base change of the family is again an effective epimorphism. -/
class IsUniversalEffectiveEpimorphism (K : Over U) : Prop where
  /-- Pulling back the family along any morphism into the target yields another effective
  epimorphism family. -/
  effective_baseChange {V : C} (f : V ⟶ U)
      [∀ i : K.index, Limits.HasPullback (K.obj i).hom f] :
      IsEffectiveEpimorphism (baseChange K f)

theorem IsUniversalEffectiveEpimorphism.representable {K : Over U}
    (hK : IsUniversalEffectiveEpimorphism K) (i : K.index) :
    (𝟭 C).relativelyRepresentable (K.obj i).hom :=
  (isEffectiveEpimorphism_of_baseChangeId K (hK.effective_baseChange (𝟙 U))).representable i

instance (K : Over U) [hK : IsUniversalEffectiveEpimorphism K] {V : C} (f : V ⟶ U)
    (i : K.index) : Limits.HasPullback (K.obj i).hom f :=
  hasPullback_of_representable f (hK.representable i)

instance (K : Over U) [hK : IsUniversalEffectiveEpimorphism K] :
    IsEffectiveEpimorphism K :=
  isEffectiveEpimorphism_of_baseChangeId K (hK.effective_baseChange (𝟙 U))

instance (K : Over U) [hK : IsUniversalEffectiveEpimorphism K] {V : C} (f : V ⟶ U) :
    IsEffectiveEpimorphism (baseChange K f) :=
  hK.effective_baseChange f

end Over
end SemiRepresentableFamily

end CategoryTheory

/-! ### Definition_7_12_2 (from Chap07) -/
universe v u

namespace CategoryTheory.GrothendieckTopology

open CategoryTheory

variable {C : Type u} [Category.{v} C]

/- Domain-style sampling for Definition 7.12.2:
- primary domain: subcanonical Grothendieck topologies and representable sheaves;
- sampled owner API:
  `GrothendieckTopology.Subcanonical`,
  `GrothendieckTopology.Subcanonical.of_isSheaf_yoneda_obj`,
  `GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable`,
  `GrothendieckTopology.le_canonical`;
- source/core/bridge triage:
  `source-facing`: the Stacks criterion that a topology is subcanonical exactly when every
  representable presheaf is a sheaf;
  `core/canonical`: `J.Subcanonical`;
  `bridge/view`: the two direction theorems
  `Subcanonical.of_isSheaf_yoneda_obj` and `Subcanonical.isSheaf_of_isRepresentable`, together
  with the order-theoretic consequence `le_canonical`.

Primitive data are only the Grothendieck topology `J`. The representable-sheaf criterion and the
comparison `J ≤ canonicalTopology C` are derived API from the owner class `Subcanonical`, so this
file should recall that owner directly and keep only the thin source-facing equivalence as a
companion theorem.
-/
/- Definition 7.12.2: a subcanonical topology on a site is the canonical mathlib class
`GrothendieckTopology.Subcanonical` on a Grothendieck topology. -/
recall Subcanonical

-- Proof sketch: `Subcanonical.isSheaf_of_isRepresentable` gives the forward implication, and
-- `Subcanonical.of_isSheaf_yoneda_obj` reconstructs
-- subcanonicality from the sheaf condition on every representable presheaf.
/-- Definition 7.12.2, source-facing form: a Grothendieck topology is subcanonical exactly when
every representable presheaf is a sheaf for it. -/
theorem subcanonical_iff_forall_isSheaf_yoneda_obj (J : GrothendieckTopology C) :
    J.Subcanonical ↔ ∀ X : C, Presieve.IsSheaf J (CategoryTheory.yoneda.obj X) := by
  constructor
  · intro hJ X
    letI : J.Subcanonical := hJ
    simpa using Subcanonical.isSheaf_of_isRepresentable (CategoryTheory.yoneda.obj X)
  · exact Subcanonical.of_isSheaf_yoneda_obj J

/- Companion recall: the order-theoretic formulation that a subcanonical topology is weaker than
the canonical topology is the theorem `GrothendieckTopology.le_canonical`. -/
recall le_canonical

end CategoryTheory.GrothendieckTopology

/-! ### Definition_7_12_3 (from Chap07) -/
universe v u

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) [J.Subcanonical]

/- Domain-style sampling for Definition 7.12.3:
- primary domain: representable sheaves on a subcanonical site, organized by the sheaf-valued
  Yoneda embedding;
- sampled owner API:
  `GrothendieckTopology.Subcanonical`,
  `GrothendieckTopology.yoneda`,
  `GrothendieckTopology.yonedaCompSheafToPresheaf`,
  `GrothendieckTopology.yonedaFullyFaithful`;
- best owner abstraction: the sheaf-valued Yoneda functor `J.yoneda`;
- primitive data: only the subcanonical topology `J` and the induced functor `J.yoneda`, whose
  objects are the representable sheaves and whose morphism map is inherited from ordinary Yoneda;
- derived API: the forgetful comparison `J.yonedaCompSheafToPresheaf` and the full-faithfulness
  witness `J.yonedaFullyFaithful`.

Source/core/bridge triage:
- `source-facing`: for each `U : C`, the representable sheaf attached to `U`;
- `core/canonical`: the owner functor `J.yoneda`;
- `bridge/view`: `J.yonedaCompSheafToPresheaf`, identifying the underlying presheaf of
  `J.yoneda.obj U` with the ordinary representable presheaf.

This file is targeting the `core/canonical` layer: the source notion is already owned upstream by
`J.yoneda`, so the correct refinement is a direct recall of that owner and its thin canonical
companions, not a new local wrapper around representable sheaves.
-/
/- Definition 7.12.3: on a site with subcanonical topology, the representable sheaf attached to
`U : C` is the sheaf `J.yoneda.obj U`; after forgetting to presheaves this is the usual
representable presheaf `yoneda.obj U`, sometimes denoted `\underline{U}` in the textbook. -/
recall yoneda

/- Companion recall: the sheaf-valued Yoneda embedding on a subcanonical site is fully faithful,
so it exhibits `C` as a full subcategory of `Sheaf J (Type v)`. -/
recall yonedaFullyFaithful

/- Companion recall: forgetting a representable sheaf back to presheaves recovers the ordinary
Yoneda embedding. -/
recall yonedaCompSheafToPresheaf

end CategoryTheory.GrothendieckTopology

/-! ### Lemma_7_12_4 (from Chap07) -/
open CategoryTheory
open CategoryTheory.Limits
open Opposite
open GrothendieckTopology.Cover

universe w u v

namespace CategoryTheory.GrothendieckTopology

attribute [local instance] Types.instFunLike Types.instConcreteCategory

noncomputable section

namespace Cover

section

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {U : C}

/-- The family of arrows indexed by `S.Arrow` generates exactly the sieve underlying `S`. -/
theorem ofArrows_eq (S : J.Cover U) :
    Sieve.ofArrows Arrow.Y (fun I : S.Arrow ↦ I.f) = (S : Sieve U) := by
  ext Y f
  rw [Sieve.mem_ofArrows_iff]
  constructor
  · rintro ⟨I, g, rfl⟩
    exact S.1.downward_closed I.hf g
  · intro hf
    exact ⟨⟨Y, f, hf⟩, 𝟙 _, by simp⟩

end

end Cover

section

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/- Domain-style sampling for the 7.12 sheafified-representable owner layer:
- primary domain: sheafification of representable presheaves on a site, organized by the sheafified
  Yoneda functor and its induced morphisms;
- sampled owner declarations:
  `GrothendieckTopology.yoneda`,
  `sheafificationAdjunction`,
  `Presheaf.isLocallySurjective_presheafToSheaf_map_iff`,
  `GrothendieckTopology.ofArrows_mem_iff_isLocallySurjective_sigmaDesc_uliftYoneda_map`;
- best owner abstraction: the functor `J.uliftSheafifiedRepresentableFunctor`, with the
  default-universe owner `J.sheafifiedRepresentableFunctor` and its induced maps;
- primitive data: the site `(C, J)` together with an object, morphism, or covering family in `C`;
- derived API: the objects `J.sheafifiedRepresentable U`, the morphisms
  `J.sheafifiedRepresentableMap f`, the Yoneda-style equivalence
  `J.uliftSheafifiedRepresentableHomEquiv`, and the covering coproduct map
  `J.sheafifiedRepresentableCoverMap S`.

Source/core/bridge triage:
- `core/canonical`: the sheafified-representable functor and its induced maps;
- `bridge/view`: the cover coproduct map `J.sheafifiedRepresentableCoverMap S`;
- `source-facing`: Lemma `7.12.4`, asserting that this canonical cover map is locally surjective.

This file owns the `core/canonical` sheafified-representable API for the 7.12 cluster, and the
later chapter files should import and reuse that owner layer rather than recreating it downstream.
-/

/-- The sheafified representable sheaf `h_U^#` on the site `(C, J)`. -/
abbrev uliftSheafifiedRepresentable [HasWeakSheafify J (Type (max w u v))] (U : C) :
    Sheaf J (Type (max w u v)) :=
  (presheafToSheaf J (Type (max w u v))).obj (CategoryTheory.uliftYoneda.{max w u v}.obj U)

/-- The default-universe sheafified representable sheaf `h_U^#` on the site `(C, J)`. -/
abbrev sheafifiedRepresentable [HasWeakSheafify J (Type (max u v))] (U : C) :
    Sheaf J (Type (max u v)) :=
  J.uliftSheafifiedRepresentable U

namespace SheafifiedRepresentable

/- Textbook notation for the sheafified representable `h_U^#`. Since Lean does not support the
subscripted binder directly as notation, we write this reusable surface form as `h[U]^#[J]`. -/
scoped notation:max "h[" U "]^#[" J "]" =>
  CategoryTheory.GrothendieckTopology.sheafifiedRepresentable J U

end SheafifiedRepresentable

open scoped SheafifiedRepresentable

/-- The sheafified-representable functor `U ↦ h_U^#` on the site `(C, J)`. -/
abbrev uliftSheafifiedRepresentableFunctor [HasWeakSheafify J (Type (max w u v))] :
    C ⥤ Sheaf J (Type (max w u v)) :=
  CategoryTheory.uliftYoneda.{max w u v} ⋙ presheafToSheaf J (Type (max w u v))

/-- The default-universe sheafified-representable functor `U ↦ h[U]^#[J]`. -/
abbrev sheafifiedRepresentableFunctor [HasWeakSheafify J (Type (max u v))] :
    C ⥤ Sheaf J (Type (max u v)) :=
  J.uliftSheafifiedRepresentableFunctor

/-- The morphism `h_V^# ⟶ h_U^#` induced by a morphism `V ⟶ U`. -/
abbrev sheafifiedRepresentableMap [HasWeakSheafify J (Type (max u v))] {U V : C} (f : V ⟶ U) :
    h[V]^#[J] ⟶ h[U]^#[J] :=
  (J.sheafifiedRepresentableFunctor).map f

/-- The canonical equivalence `Hom(h_U^#, ℱ) ≃ ℱ(U)` for the sheafified representable sheaf. -/
abbrev uliftSheafifiedRepresentableHomEquiv
    [HasWeakSheafify J (Type (max w u v))]
    (ℱ : Sheaf J (Type (max w u v))) (U : C) :
    (J.uliftSheafifiedRepresentable U ⟶ ℱ) ≃ ℱ.obj.obj (op U) :=
  (((sheafificationAdjunction J (Type (max w u v))).homEquiv
    (CategoryTheory.uliftYoneda.{max w u v}.obj U) ℱ).trans
      CategoryTheory.uliftYonedaEquiv.{max w u v})

/-- Naturality in `U` of the canonical equivalence `Hom(h_U^#, ℱ) ≃ ℱ(U)`. -/
theorem uliftSheafifiedRepresentableHomEquiv_naturality
    [HasWeakSheafify J (Type (max w u v))]
    {U V : C} (f : V ⟶ U) (ℱ : Sheaf J (Type (max w u v)))
    (α : J.uliftSheafifiedRepresentable U ⟶ ℱ) :
    J.uliftSheafifiedRepresentableHomEquiv ℱ V
        (J.uliftSheafifiedRepresentableFunctor.map f ≫ α) =
      ℱ.obj.map f.op (J.uliftSheafifiedRepresentableHomEquiv ℱ U α) := by
  dsimp [uliftSheafifiedRepresentableHomEquiv]
  rw [CategoryTheory.uliftYonedaEquiv_naturality.{max w u v}]
  exact congrArg CategoryTheory.uliftYonedaEquiv.{max w u v}
    ((sheafificationAdjunction J (Type (max w u v))).homEquiv_naturality_left
      (CategoryTheory.uliftYoneda.{max w u v}.map f) α)

/-- Naturality in `ℱ` of the canonical equivalence `Hom(h_U^#, ℱ) ≃ ℱ(U)`. -/
theorem uliftSheafifiedRepresentableHomEquiv_comp
    [HasWeakSheafify J (Type (max w u v))]
    {U : C} {ℱ 𝒢 : Sheaf J (Type (max w u v))}
    (α : J.uliftSheafifiedRepresentable U ⟶ ℱ) (β : ℱ ⟶ 𝒢) :
    J.uliftSheafifiedRepresentableHomEquiv 𝒢 U (α ≫ β) =
      β.hom.app (op U) (J.uliftSheafifiedRepresentableHomEquiv ℱ U α) := by
  dsimp [uliftSheafifiedRepresentableHomEquiv]
  calc
    CategoryTheory.uliftYonedaEquiv
        (((sheafificationAdjunction J (Type (max w u v))).homEquiv
          (CategoryTheory.uliftYoneda.{max w u v}.obj U) 𝒢) (α ≫ β)) =
      CategoryTheory.uliftYonedaEquiv
        ((((sheafificationAdjunction J (Type (max w u v))).homEquiv
          (CategoryTheory.uliftYoneda.{max w u v}.obj U) ℱ) α) ≫ β.hom) := by
          exact congrArg CategoryTheory.uliftYonedaEquiv
            ((sheafificationAdjunction J (Type (max w u v))).homEquiv_naturality_right α β)
    _ = β.hom.app (op U)
        (CategoryTheory.uliftYonedaEquiv
          (((sheafificationAdjunction J (Type (max w u v))).homEquiv
            (CategoryTheory.uliftYoneda.{max w u v}.obj U) ℱ) α)) := by
      rw [CategoryTheory.uliftYonedaEquiv_comp]
      rfl

/-- The canonical sheafified morphism from the coproduct of a covering family to `h_U^#`. -/
instance [HasWeakSheafify J (Type (max u v))] {U : C} (S : J.Cover U) :
    HasCoproduct (fun I : S.Arrow ↦ h[I.Y]^#[J]) := by
  let _ : HasColimitsOfShape (Discrete S.Arrow) (Type (max u v)) := inferInstance
  let _ : HasColimitsOfShape (Discrete S.Arrow) (Sheaf J (Type (max u v))) :=
    Sheaf.instHasColimitsOfShape
  infer_instance

/-- The canonical sheafified morphism from the coproduct of a covering family to `h_U^#`. -/
abbrev sheafifiedRepresentableCoverMap
    [HasWeakSheafify J (Type (max u v))] {U : C} (S : J.Cover U) :
    ∐ (fun I : S.Arrow ↦ h[I.Y]^#[J]) ⟶ h[U]^#[J] :=
  Limits.Sigma.desc (fun I : S.Arrow ↦ J.sheafifiedRepresentableMap I.f)

/-- The sigma-desc map built from sheafified representable morphisms is locally surjective exactly
when the underlying sigma-desc map of representable presheaves is locally surjective before
sheafification. -/
theorem isLocallySurjective_sigmaDesc_sheafifiedRepresentableMap_iff
    [HasWeakSheafify J (Type (max u v))]
    {ι : Type*} [Small.{max u v} ι] {U : C} (Y : ι → C) (f : ∀ i : ι, Y i ⟶ U)
    [HasCoproduct (fun i : ι ↦ h[Y i]^#[J])] :
    Sheaf.IsLocallySurjective
        (Limits.Sigma.desc (fun i : ι ↦ J.sheafifiedRepresentableMap (f i))) ↔
      Presheaf.IsLocallySurjective J
        (Limits.Sigma.desc (fun i : ι ↦ CategoryTheory.uliftYoneda.{max u v}.map (f i))) := by
  let G := presheafToSheaf J (Type (max u v))
  let F : ι → Cᵒᵖ ⥤ Type (max u v) := fun i ↦ CategoryTheory.uliftYoneda.{max u v}.obj (Y i)
  let gPres :
      ∐ F ⟶ CategoryTheory.uliftYoneda.{max u v}.obj U :=
    Limits.Sigma.desc (fun i : ι ↦ CategoryTheory.uliftYoneda.{max u v}.map (f i))
  let _ : HasCoproduct F := inferInstance
  let _ : HasCoproduct (fun i : ι ↦ G.obj (F i)) := by
    simpa [F, G, sheafifiedRepresentable, uliftSheafifiedRepresentable] using
      (inferInstance : HasCoproduct (fun i : ι ↦ h[Y i]^#[J]))
  constructor
  · intro hdesc
    have hcomp :
        Sheaf.IsLocallySurjective (Limits.sigmaComparison G F ≫ G.map gPres) := by
      simpa [F, G, gPres, sheafifiedRepresentableMap, sheafifiedRepresentableFunctor,
        uliftSheafifiedRepresentableFunctor, Limits.sigmaComparison_map_desc] using hdesc
    have hmap :
        Sheaf.IsLocallySurjective (G.map gPres) := by
      rw [← Sheaf.isLocallySurjective_sheafToPresheaf_map_iff]
      have hcomp'' :
          Presheaf.IsLocallySurjective J
            ((sheafToPresheaf J (Type (max u v))).map
              (Limits.sigmaComparison G F ≫ G.map gPres)) := by
        exact hcomp
      have hcomp' :
          Presheaf.IsLocallySurjective J
            (((sheafToPresheaf J (Type (max u v))).map (Limits.sigmaComparison G F)) ≫
              (sheafToPresheaf J (Type (max u v))).map (G.map gPres)) := by
        rw [Functor.map_comp] at hcomp''
        exact hcomp''
      let _ :
          Presheaf.IsLocallySurjective J
            ((sheafToPresheaf J (Type (max u v))).map (Limits.sigmaComparison G F)) := by
        infer_instance
      let _ :
          Presheaf.IsLocallyInjective J
            ((sheafToPresheaf J (Type (max u v))).map (Limits.sigmaComparison G F)) := by
        infer_instance
      exact
        (Presheaf.comp_isLocallySurjective_iff J
          ((sheafToPresheaf J (Type (max u v))).map (Limits.sigmaComparison G F))
          ((sheafToPresheaf J (Type (max u v))).map (G.map gPres))).1 hcomp'
    rw [Presheaf.isLocallySurjective_presheafToSheaf_map_iff] at hmap
    exact hmap
  · intro hpres
    have hmap :
        Sheaf.IsLocallySurjective (G.map gPres) := by
      rw [Presheaf.isLocallySurjective_presheafToSheaf_map_iff]
      exact hpres
    let _ : Sheaf.IsLocallySurjective (G.map gPres) := hmap
    simpa [F, G, gPres, sheafifiedRepresentableMap, sheafifiedRepresentableFunctor,
      uliftSheafifiedRepresentableFunctor, Limits.sigmaComparison_map_desc] using
      (show Sheaf.IsLocallySurjective (Limits.sigmaComparison G F ≫ G.map gPres) by
        infer_instance)

end

