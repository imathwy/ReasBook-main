/-! ### Lemma_19_9_1 (from Chap19) -/
open CategoryTheory Limits

universe v u

namespace CategoryTheory

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- Lemma 19.9.1: the singleton presieves generated by epimorphisms define a pretopology on an
abelian category, i.e. the site whose coverings are single surjective morphisms. -/
def singletonEpiPretopology : Pretopology A where
  coverings X := {S | ∃ (Y : A) (f : Y ⟶ X), Epi f ∧ S = Presieve.singleton f}
  has_isos := by
    intro X Y f _
    exact ⟨Y, f, inferInstance, rfl⟩
  -- Proof sketch: if `S = Presieve.singleton f` with `f` epi, then
  -- `Presieve.pullbackArrows g S = Presieve.singleton (pullback.snd f g)` by
  -- `Presieve.pullback_singleton`, and `pullback.snd f g` is epi by
  -- `Abelian.epi_pullback_of_epi_f`.
  pullbacks := by
    rintro X Y f S ⟨Z, g, hg, rfl⟩
    letI : Epi g := hg
    refine ⟨pullback g f, pullback.snd g f, inferInstance, ?_⟩
    simpa using (Presieve.pullback_singleton f g)
  -- Proof sketch: if `S = Presieve.singleton f` and `Ti f _ = Presieve.singleton h` with both `f`
  -- and `h` epi, then `S.bind Ti = Presieve.singleton (h ≫ f)` using the singleton bind formula,
  -- and the composite of epimorphisms is epi.
  transitive := by
    rintro X S Ti ⟨Z, g, hg, rfl⟩ hTi
    rcases hTi g (Presieve.singleton_self g) with ⟨Y, f, hf, hTi⟩
    letI : Epi g := hg
    letI : Epi f := hf
    refine ⟨Y, f ≫ g, inferInstance, ?_⟩
    funext W
    ext k
    constructor
    · rintro ⟨V, h, k, ⟨_⟩, hk, rfl⟩
      rw [hTi] at hk
      cases hk
      exact Presieve.singleton.mk
    · rintro ⟨_⟩
      refine Presieve.bind_comp g Presieve.singleton.mk ?_
      rw [hTi]
      exact Presieve.singleton.mk

-- Proof sketch: this is exactly the defining membership condition of
-- `singletonEpiPretopology`.
/-- A cover in `singletonEpiPretopology` is exactly a singleton presieve generated by an epimorphism. -/
theorem mem_singletonEpiPretopology_iff {X : A} {S : Presieve X} :
    S ∈ singletonEpiPretopology X ↔
      ∃ (Y : A) (f : Y ⟶ X), Epi f ∧ S = Presieve.singleton f :=
  Iff.rfl

end CategoryTheory

