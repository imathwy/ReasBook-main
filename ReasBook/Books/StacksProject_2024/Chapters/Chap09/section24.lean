/- Lemma 9.24.1 (Kummer extensions): if `L/K` is a finite Galois extension with cyclic Galois
group and `K` contains a primitive `[L : K]`-th root of unity, then `L = K[α]` for some `α`
whose `[L : K]`-th power lies in the image of `K`. For a finite Galois extension,
`|Gal(L/K)| = [L : K]`, so this is the canonical mathlib form of the Stacks lemma
`Gal(L/K) ≃ ZMod n` with `L = K[z]` and `z ^ n ∈ K`. -/
recall exists_root_adjoin_eq_top_of_isCyclic

/-! ### Lemma_9_24_2 (from Chap09) -/
open IsCyclotomicExtension
open Module
open scoped IntermediateField

universe u v

section

variable {K : Type u} [Field K] {L : Type v} [Field L] [Algebra K L]
variable {p : ℕ} [Fact p.Prime] {ζ : L}

/- Domain-style sampling:
* primary domain: cyclotomic simple extensions generated by a primitive prime root of unity;
* sampled owner declarations:
  `IsPrimitiveRoot.adjoin_isCyclotomicExtension`,
  `IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic`,
  `IsCyclotomicExtension.isGalois`,
  `IsCyclotomicExtension.finiteDimensional`,
  `IsPrimitiveRoot.autToPow_injective`,
  `IsGalois.card_aut_eq_finrank`;
* best owner abstraction: the canonical cyclotomic-extension instance
  `IsCyclotomicExtension {p} K K⟮ζ⟯` on the intrinsic simple extension generated by the primitive
  root;
* primitive data: a field extension `L / K`, a prime `p`, and a primitive root
  `hζ : IsPrimitiveRoot ζ p`;
* derived API: Galoisness and finite dimensionality come from the owner theorems
  `IsCyclotomicExtension.isGalois` and `IsCyclotomicExtension.finiteDimensional`, and the degree
  divisibility is obtained from the canonical automorphism-to-power map on that owner extension.

Layer triage:
* `source-facing`: Lemma 9.24.2 is the textbook statement about `K(ζ) / K`;
* `core/canonical`: `IsCyclotomicExtension {p} K K⟮ζ⟯`;
* `bridge/view`: this file specializes the cyclotomic owner API to the adjoined primitive root.

So the public API should keep the single source-facing lemma, not parallel public wrappers for the
specialized Galois and cardinality steps.
-/

/-- Lemma 9.24.2: if `ζ` is a primitive `p`th root of unity in a field extension of `K`, then the
simple extension `K(ζ) / K` is Galois and its degree divides `p - 1`. The characteristic
assumption from the source text, and any ambient integrality hypothesis on `L / K`, are redundant
once such a primitive root is fixed. -/
theorem adjoin_primitiveRoot_isGalois_and_finrank_dvd_prime_sub_one
    (hζ : IsPrimitiveRoot ζ p) :
    IsGalois K K⟮ζ⟯ ∧ finrank K K⟮ζ⟯ ∣ p - 1 := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  haveI : IsCyclotomicExtension {p} K K⟮ζ⟯ :=
    (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin
      p K L (K⟮ζ⟯ : IntermediateField K L) hζ).2 rfl
  haveI : IsGalois K K⟮ζ⟯ := isGalois {p} K K⟮ζ⟯
  refine ⟨inferInstance, ?_⟩
  haveI : FiniteDimensional K K⟮ζ⟯ := finiteDimensional {p} K K⟮ζ⟯
  have hcard : Nat.card Gal(K⟮ζ⟯/K) ∣ Nat.card (ZMod p)ˣ := by
    let hμ := zeta_spec p K K⟮ζ⟯
    exact Subgroup.card_dvd_of_injective (hμ.autToPow K) (hμ.autToPow_injective K)
  rw [← IsGalois.card_aut_eq_finrank K K⟮ζ⟯]
  simpa [Nat.card_eq_fintype_card, ZMod.card_units p] using hcard

end

