noncomputable section

universe u

namespace AlgebraicGeometry.RingedSpace

/- Domain-style sampling for Definition 17.13.1:
- primary domain: closed immersions of ringed spaces and the canonical structure-sheaf map
  `𝒪_X ⟶ i_* 𝒪_Z`;
- inspected owner declarations:
  `AlgebraicGeometry.RingedSpace.Modules`,
  `AlgebraicGeometry.RingedSpace.Hom.commRingSheafPushforwardMap`,
  `AlgebraicGeometry.RingedSpace.Hom.toRingCatSheafHom`,
  `SheafOfModules.LocalGeneratorsData`;
- best owner abstraction: the ambient ringed-space module owner `X.Modules` from Chapter 6,
  together with the
  canonical owner `LocalGeneratorsData` for local generation;
- primitive data: a morphism `i : Z ⟶ X`, the closed-embedding condition on `i.hom.base`, local
  surjectivity of `i^♯`, and local generators data for the kernel module sheaf;
- derived API: the kernel ideal sheaf attached to `i` and its inherited local-generators instance.

Source/core/bridge triage:
- `source-facing`: `RingedSpace.IsClosedImmersion`;
- `core/canonical`: `RingedSpace.Hom.commRingSheafPushforwardMap i`,
  `RingedSpace.Hom.toRingCatSheafHom i`, and `LocalGeneratorsData`;
- `bridge/view`: `closedImmersionIdealSheaf i` as the kernel module sheaf of the canonical map.
-/

/-- The ideal sheaf attached to a morphism of ringed spaces, viewed as the kernel of the canonical
`\mathcal O_X`-linear map `\mathcal O_X \to i_*\mathcal O_Z`. -/
noncomputable abbrev closedImmersionIdealSheaf
    {X Z : RingedSpace.{u}} (i : Z ⟶ X) : X.Modules :=
  kernel (SheafOfModules.unitToPushforwardObjUnit (Hom.toRingCatSheafHom i))

/-- Definition 17.13.1: a morphism `i : (Z, \mathcal O_Z) \to (X, \mathcal O_X)` of ringed
spaces is a closed immersion if the underlying map of topological spaces is a closed embedding, the
associated map `\mathcal O_X \to i_*\mathcal O_Z` is locally surjective as a sheaf morphism, and
its kernel ideal sheaf is locally generated by sections. -/
class IsClosedImmersion
    {X Z : RingedSpace.{u}} (i : Z ⟶ X) : Prop
    extends Sheaf.IsLocallySurjective (Hom.commRingSheafPushforwardMap i) where
  /-- The underlying continuous map of a closed immersion of ringed spaces is a closed embedding. -/
  isClosedEmbedding : Topology.IsClosedEmbedding i.hom.base
  /-- The kernel ideal sheaf of a closed immersion is locally generated by sections. -/
  nonempty_localGeneratorsData : Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData

instance {X Z : RingedSpace.{u}} {i : Z ⟶ X} [hi : IsClosedImmersion i] :
    Topology.IsClosedEmbedding i.hom.base :=
  hi.isClosedEmbedding

/-- For a closed immersion, the kernel ideal sheaf is locally generated by sections. -/
instance {X Z : RingedSpace.{u}} {i : Z ⟶ X} [hi : IsClosedImmersion i] :
    Nonempty (closedImmersionIdealSheaf i).LocalGeneratorsData := by
  exact hi.nonempty_localGeneratorsData

end AlgebraicGeometry.RingedSpace

