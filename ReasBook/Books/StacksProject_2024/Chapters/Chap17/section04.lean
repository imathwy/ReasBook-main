/-
Domain-style sampling for tensor products of globally generated sheaves of modules:
- inspected owner declarations:
  `SheafOfModules.GeneratingSections`,
  `SheafOfModules.GeneratingSections.π`,
  `SheafOfModules.GeneratingSections.ofEpi`,
  `moduleTensor`,
  `ringedSiteModuleCategory`
- best owner abstraction:
  the owner is the generic `SheafOfModules.GeneratingSections`, and the tensor object is the
  canonical sheaf tensor product `moduleTensor ℱ 𝒢`; the ringed-space statement is a specialization
- primitive data:
  the two generating families `σ : ℱ.GeneratingSections` and `τ : 𝒢.GeneratingSections`
- derived API:
  the induced generating family on `moduleTensor ℱ 𝒢`, with the existential source-facing theorem
  as a thin corollary

Layer triage:
- `source-facing`: the existence statement that `ℱ ⊗ 𝒢` is generated by global sections
- `core/canonical`: the owner-level construction on `GeneratingSections`
- `bridge/view`: the `Nonempty` corollary obtained by forgetting the chosen generating families
-/

namespace SheafOfModules

variable {C : Type u} [Category C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable {𝒪 : Sheaf J CommRingCat.{u}}
variable {ℱ 𝒢 : ringedSiteModuleCategory J 𝒪}

local infixr:70 " ⊗ " => moduleTensor

/-- The section of the presheaf tensor product induced by two global sections. -/
private noncomputable def tensorPresheafSection (s : ℱ.sections) (t : 𝒢.sections) :
    (PresheafOfModules.Monoidal.tensorObj ℱ.val 𝒢.val).sections :=
  PresheafOfModules.sectionsMk
    (fun U ↦ s.1 U ⊗ₜ t.1 U)
    (fun U V i ↦ by
      erw [PresheafOfModules.Monoidal.tensorObj_map_tmul]
      rw [PresheafOfModules.sections_property, PresheafOfModules.sections_property]
      rfl)

/-- The tensor product of two global sections as a global section of the sheaf tensor product. -/
private noncomputable def tensorProductSection
    [HasWeakSheafify J AddCommGrpCat.{u}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    (s : ℱ.sections) (t : 𝒢.sections) :
    (ℱ ⊗ 𝒢).sections :=
  PresheafOfModules.sectionsMap
    ((PresheafOfModules.sheafificationAdjunction (𝟙 (ringSheaf J 𝒪).obj)).unit.app
      (PresheafOfModules.Monoidal.tensorObj ℱ.val 𝒢.val))
    (tensorPresheafSection s t)

end SheafOfModules

namespace SheafOfModules.GeneratingSections

variable {C : Type u} [Category C] {J : GrothendieckTopology C}
variable [J.HasSheafCompose (forget₂ CommRingCat RingCat)]
variable [HasWeakSheafify J AddCommGrpCat.{u}]
variable [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
variable {𝒪 : Sheaf J CommRingCat.{u}}
variable {ℱ 𝒢 : ringedSiteModuleCategory J 𝒪}

local infixr:70 " ⊗ " => moduleTensor

-- Proof sketch: the generators are the pairwise tensor products `σ.s i ⊗ τ.s j`; the associated
-- free map factors through `σ.π ⊗ₘ τ.π`, and tensoring epimorphisms remains epimorphic after the
-- free-basis identification for the tensor product of two free sheaves.
/-- The generating family on the tensor product induced by generating families on each factor. -/
noncomputable def tensor (σ : ℱ.GeneratingSections) (τ : 𝒢.GeneratingSections) :
    (ℱ ⊗ 𝒢).GeneratingSections :=
  { I := σ.I × τ.I
    s := fun ij ↦ SheafOfModules.tensorProductSection (σ.s ij.1) (τ.s ij.2)
    epi := by
      sorry }

end SheafOfModules.GeneratingSections

namespace AlgebraicGeometry.RingedSpace

variable {X : RingedSpace.{u}} {ℱ 𝒢 : (RingedSpace.Modules X)}

local infixr:70 " ⊗ " => moduleTensor

-- Proof sketch: choose generating families for `ℱ` and `𝒢`, then apply
-- `SheafOfModules.GeneratingSections.tensor`.
/-- Lemma 17.4.3: if two `\mathcal O_X`-modules are generated by global sections, then their
sheaf tensor product is also generated by global sections. -/
theorem nonempty_generatingSections_tensor
    (hℱ : Nonempty ℱ.GeneratingSections) (h𝒢 : Nonempty 𝒢.GeneratingSections) :
    Nonempty ((ℱ ⊗ 𝒢).GeneratingSections) := by
  rcases hℱ with ⟨σ⟩
  rcases h𝒢 with ⟨τ⟩
  exact ⟨σ.tensor τ⟩

end AlgebraicGeometry.RingedSpace

