/-! ### Definition_15_32_1 (from Chap15) -/
universe u

open RingTheory
open RingTheory.Sequence

section

variable {R : Type u} [CommRing R]

namespace Ideal

/- Domain triage:
- primary domain: Zariski-local regularity conditions on ideals in commutative algebra;
- sampled owner declarations: `Ideal.IsGeneratedByRegularSequence`, `Sequence.IsRegular`,
  `Sequence.IsKoszulRegularSequence`, and `Sequence.IsH1RegularSequence`;
- layer: `source-facing`; Definition `15.32.1` introduces ideal-level predicates, but their core
  mathematical data is already owned by the localized ideal predicate
  `Ideal.IsGeneratedByRegularSequence` and the finite-sequence predicates above after passing to
  `Localization.Away g`;
- primitive vs derived split: for the regular branch the primitive localized datum is the owner
  predicate `(Ideal.map (algebraMap R (Localization.Away g)) I).IsGeneratedByRegularSequence`,
  while the explicit `Fin`-indexed generating family is only companion specification API. -/
private def IsGeneratedByFiniteAwaySequence (I : Ideal R)
    (P : ∀ g : R, {r : ℕ} → (Fin r → Localization.Away g) → Prop) : Prop :=
  ∀ p : Ideal R, p.IsPrime → I ≤ p →
    ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
      P g f ∧
        Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f)

private theorem ofList_ofFn_eq_span_range {S : Type*} [CommRing S] {r : ℕ} (f : Fin r → S) :
    Ideal.ofList (List.ofFn f) = Ideal.span (Set.range f) := by
  ext x
  simp [Ideal.ofList, List.mem_ofFn', Set.range]

/-- Definition 15.32.1 (1): an ideal `I` is regular if for every prime ideal `p` containing `I`
there is an element `g ∉ p` such that after localizing away from `g`, the localized ideal is
generated by a finite regular sequence. -/
def IsRegularIdeal (I : Ideal R) : Prop :=
  ∀ p : Ideal R, p.IsPrime → I ≤ p →
    ∃ g : R, g ∉ p ∧
      (Ideal.map (algebraMap R (Localization.Away g)) I).IsGeneratedByRegularSequence

-- Proof sketch: the owner predicate `Ideal.IsGeneratedByRegularSequence` is equivalent to the
-- existence of a regular list of generators, and `List.ofFn` converts that owner theorem to the
-- textbook finite-family formulation.
/-- The predicate `I.IsRegularIdeal` is equivalent to the stated local generation criterion by a
finite regular sequence on each basic neighborhood meeting `V(I)`. -/
theorem isRegularIdeal_iff (I : Ideal R) :
    I.IsRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsRegular (Localization.Away g) (List.ofFn f) ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) := by
  constructor
  · intro h p hp hIp
    rcases h p hp hIp with ⟨g, hg, hgen⟩
    rcases (Ideal.isGeneratedByRegularSequence_iff _).1 hgen with ⟨ys, hreg, hys⟩
    refine ⟨g, hg, ys.length, ys.get, ?_, ?_⟩
    · simpa [List.ofFn_get] using hreg
    · simpa [List.ofFn_get, ofList_ofFn_eq_span_range ys.get] using hys.symm
  · intro h p hp hIp
    rcases h p hp hIp with ⟨g, hg, r, f, hf, hspan⟩
    refine ⟨g, hg, (Ideal.isGeneratedByRegularSequence_iff _).2 ?_⟩
    refine ⟨List.ofFn f, by simpa using hf, ?_⟩
    simpa [ofList_ofFn_eq_span_range f] using hspan.symm

/-- Definition 15.32.1 (2): an ideal `I` is Koszul-regular if for every prime ideal `p`
containing `I` there is an element `g ∉ p` such that after localizing away from `g`, the localized
ideal is generated by a finite Koszul-regular sequence. -/
def IsKoszulRegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I (fun _ {_} f ↦ IsKoszulRegularSequence f)

-- Proof sketch: unfold `Ideal.IsKoszulRegularIdeal`; the statement is precisely the local
-- generation condition by a finite Koszul-regular sequence in the localization away from `g`.
/-- The predicate `I.IsKoszulRegularIdeal` is equivalent to the stated local generation criterion
by a finite Koszul-regular sequence on each basic neighborhood meeting `V(I)`. -/
theorem isKoszulRegularIdeal_iff (I : Ideal R) :
    I.IsKoszulRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsKoszulRegularSequence f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) :=
  Iff.rfl

/-- Definition 15.32.1 (3): an ideal `I` is `H_1`-regular if for every prime ideal `p`
containing `I` there is an element `g ∉ p` such that after localizing away from `g`, the localized
ideal is generated by a finite `H_1`-regular sequence. -/
def IsH1RegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I (fun _ {_} f ↦ IsH1RegularSequence f)

-- Proof sketch: unfold `Ideal.IsH1RegularIdeal`; this is exactly the localized generation
-- condition by a finite `H_1`-regular sequence over each basic neighborhood meeting `V(I)`.
/-- The predicate `I.IsH1RegularIdeal` is equivalent to the stated local generation criterion by a
finite `H_1`-regular sequence on each basic neighborhood meeting `V(I)`. -/
theorem isH1RegularIdeal_iff (I : Ideal R) :
    I.IsH1RegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsH1RegularSequence f ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) :=
  Iff.rfl

/-- Definition 15.32.1 (4): an ideal `I` is quasi-regular if for every prime ideal `p`
containing `I` there is an element `g ∉ p` such that after localizing away from `g`, the localized
ideal is generated by a finite quasi-regular sequence. -/
def IsQuasiRegularIdeal (I : Ideal R) : Prop :=
  IsGeneratedByFiniteAwaySequence I
    (fun g {_} f ↦ IsQuasiRegular (Localization.Away g) (List.ofFn f))

-- Proof sketch: unfold `Ideal.IsQuasiRegularIdeal`; the statement is precisely the localized
-- generation criterion by a finite quasi-regular sequence on each basic neighborhood meeting
-- `V(I)`.
/-- The predicate `I.IsQuasiRegularIdeal` is equivalent to the stated local generation criterion by
a finite quasi-regular sequence on each basic neighborhood meeting `V(I)`. -/
theorem isQuasiRegularIdeal_iff (I : Ideal R) :
    I.IsQuasiRegularIdeal ↔
      ∀ p : Ideal R, p.IsPrime → I ≤ p →
        ∃ g : R, g ∉ p ∧ ∃ r : ℕ, ∃ f : Fin r → Localization.Away g,
          IsQuasiRegular (Localization.Away g) (List.ofFn f) ∧
            Ideal.map (algebraMap R (Localization.Away g)) I = Ideal.span (Set.range f) :=
  Iff.rfl

end Ideal

end

/-! ### Lemma_15_32_2 (from Chap15) -/
open RingTheory
open PrimeSpectrum

universe u

section

variable {R : Type u} [CommRing R]

namespace Ideal

/- Domain triage:
- primary domain: Zariski-local finiteness descent for quasi-regular ideals in commutative
  algebra;
- sampled owner declarations: `Ideal.IsQuasiRegularIdeal`,
  `PrimeSpectrum.iSup_basicOpen_eq_top_iff'`,
  `Ideal.fg_of_localizationSpan`,
  `Submodule.fg_span`;
- layer split:
  `source-facing`: the local quasi-regularity predicate `Ideal.IsQuasiRegularIdeal`;
  `core/canonical`: finite generation `Ideal.FG`;
  `bridge/view`: a basic-open cover of `Spec R` together with localized finite generation of the
  mapped ideal. -/

-- Proof sketch: unfold `I.IsQuasiRegularIdeal` to obtain, near each prime containing `I`, a
-- localization in which `I` is generated by a finite quasi-regular sequence, hence by finitely
-- many elements. Let `s = {g | I_g is finitely generated}`. The localized quasi-regularity covers
-- `V(I)`, while for primes outside `V(I)` any `x ∈ I` not in the prime gives `I_x = ⊤`, hence
-- `x ∈ s`. Therefore the basic opens `D(g)` for `g ∈ s` cover `Spec R`, so
-- `PrimeSpectrum.iSup_basicOpen_eq_top_iff'` gives `Ideal.span s = ⊤`, and the owner theorem
-- `Ideal.fg_of_localizationSpan` concludes.
/-- Lemma 15.32.2: a quasi-regular ideal is finitely generated. -/
theorem fg_of_isQuasiRegularIdeal {I : Ideal R} (hI : I.IsQuasiRegularIdeal) :
    I.FG := by
  classical
  let J : (g : R) → Ideal (Localization.Away g) :=
    fun g ↦ I.map (algebraMap R (Localization.Away g))
  let s : Set R := {g | (J g).FG}
  have hs_mem {g : R} (hg : g ∈ s) :
      (basicOpen g : TopologicalSpace.Opens (PrimeSpectrum R)) ≤ ⨆ r ∈ s, basicOpen r :=
    le_iSup_of_le g <| le_iSup_of_le hg le_rfl
  have hs_cover : (⨆ r ∈ s, basicOpen r) = ⊤ := by
    apply SetLike.ext'
    change (↑(⨆ r ∈ s, basicOpen r) : Set (PrimeSpectrum R)) = Set.univ
    rw [Set.eq_univ_iff_forall]
    intro p
    by_cases hpI : I ≤ p.asIdeal
    · rcases (isQuasiRegularIdeal_iff I).1 hI p.asIdeal p.2 hpI with ⟨g, hg, r, f, -, hJg⟩
      have hgfg : g ∈ s := by
        simpa [J, s, hJg] using
          (Submodule.fg_span (Set.finite_range f) : (Ideal.span (Set.range f)).FG)
      have hpg : p ∈ (basicOpen g : Set (PrimeSpectrum R)) := by
        simpa [mem_basicOpen] using hg
      exact hs_mem hgfg hpg
    · have hpI' : ∃ x, x ∈ I ∧ x ∉ p.asIdeal := by
          simpa [SetLike.le_def] using hpI
      rcases hpI' with ⟨x, hxI, hxp⟩
      have hxfg : x ∈ s := by
        have hxmap : algebraMap R (Localization.Away x) x ∈ J x := Ideal.mem_map_of_mem _ hxI
        have hxtop : J x = ⊤ :=
          (J x).eq_top_of_isUnit_mem hxmap
            (IsLocalization.map_units (Localization.Away x) ⟨x, Submonoid.mem_powers x⟩)
        simpa [J, s, hxtop] using Ideal.fg_top (Localization.Away x)
      have hpx : p ∈ (basicOpen x : Set (PrimeSpectrum R)) := by
        simpa [mem_basicOpen] using hxp
      exact hs_mem hxfg hpx
  have hs_span : Ideal.span s = ⊤ :=
    iSup_basicOpen_eq_top_iff'.mp hs_cover
  refine Ideal.fg_of_localizationSpan s hs_span ?_
  intro g
  change (J g.1).FG
  exact g.2

end Ideal

end

/-! ### Lemma_15_32_3 (from Chap15) -/
universe u

section

namespace Ideal

open RingTheory

variable {R : Type u} [CommRing R] {I : Ideal R}

/- Domain triage:
- primary domain: quasi-regular ideals and their conormal module `I / I²` in commutative algebra;
- sampled owner declarations of the same kind:
  `Ideal.IsQuasiRegularIdeal`,
  `Ideal.Cotangent`,
  `Module.FiniteProjective`,
  `fg_of_isQuasiRegularIdeal`;
- best owner abstraction in this file: the source-facing theorem should use the canonical owner
  predicate `Module.FiniteProjective` for the conormal module `I.Cotangent`;
- layer triage:
  `source-facing`: the finite-projective statement for `I.Cotangent`;
  `core/canonical`: `Ideal.Cotangent` and `Module.FiniteProjective`;
- primitive data: the ideal `I`, the source-facing hypothesis `hI : I.IsQuasiRegularIdeal`, and
  the canonical cotangent owner `I.Cotangent`;
- derived API: finite generation of `I` comes from `fg_of_isQuasiRegularIdeal`, while the theorem
  below packages the resulting finiteness and projectivity of `I.Cotangent` in the owner
  predicate `Module.FiniteProjective`. -/

-- Proof sketch: combine Lemma `15.32.2` with the canonical cotangent owner `I.Cotangent` to show
-- that `I / I²` is finite and projective over `R ⧸ I`, then package the result in
-- `Module.FiniteProjective`.
/-- Lemma 15.32.3: if `I` is a quasi-regular ideal of a commutative ring `R`, then the cotangent
module `I.Cotangent = I / I²` is a finite projective `(R ⧸ I)`-module. -/
theorem cotangent_finite_projective_of_isQuasiRegularIdeal
    (hI : I.IsQuasiRegularIdeal) :
    Module.FiniteProjective (R ⧸ I) I.Cotangent := by
  sorry

end Ideal

end

/-! ### Lemma_15_32_4 (from Chap15) -/
universe u v

section

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]

namespace Ideal

/-
Domain-style sampling:
* primary domain: faithfully flat descent for local ideal-regularity predicates in commutative
  algebra;
* sampled owner declarations:
  `Ideal.IsKoszulRegularIdeal`,
  `Ideal.IsH1RegularIdeal`,
  `Ideal.IsQuasiRegularIdeal`,
  `RingHom.FaithfullyFlat`,
  `RingHom.faithfullyFlat_algebraMap_iff`;
* best owner abstraction: the chapter owner predicates
  `Ideal.IsKoszulRegularIdeal`, `Ideal.IsH1RegularIdeal`, and `Ideal.IsQuasiRegularIdeal` from
  `Definition_15_32_1`, together with the canonical faithfully flat owner
  `(algebraMap A B).FaithfullyFlat`; the mapped ideal `I.map (algebraMap A B)` and the localized
  generating sequences in the proof sketches are derived bridge data, not new public owners;
* primitive vs. derived split:
  the primitive inputs are the faithfully flatness witness `hff : (algebraMap A B).FaithfullyFlat`
  and the owner predicate on `I.map (algebraMap A B)`;
  lying-over primes, localizations, and descended finite generating sequences are derived proof
  data;
* layer: `bridge/view`, because this file transports existing owner predicates along a faithfully
  flat algebra map rather than defining a new notion.
-/

namespace IsKoszulRegularIdeal

-- Proof sketch: unwind `IsKoszulRegularIdeal` on the extended ideal `I.map (algebraMap A B)`.
-- For a prime `p ⊇ I`, choose a prime of `B` above `p` by faithful flatness, use the local
-- generation of the extended ideal by a finite Koszul-regular sequence near that prime, and then
-- descend the localized sequence back along the induced faithfully flat local map.
/-- Lemma 15.32.4 (1): if `A → B` is faithfully flat and the extended ideal `IB` is
Koszul-regular in `B`, then `I` is Koszul-regular in `A`. -/
theorem of_faithfullyFlat {I : Ideal A} (hff : (algebraMap A B).FaithfullyFlat)
    (hIB : (I.map (algebraMap A B)).IsKoszulRegularIdeal) : I.IsKoszulRegularIdeal := by
  rw [RingHom.faithfullyFlat_algebraMap_iff] at hff
  letI : Module.FaithfullyFlat A B := hff
  sorry

end IsKoszulRegularIdeal

namespace IsH1RegularIdeal

-- Proof sketch: as in the Koszul-regular case, work primewise on `Spec A`, lift a prime
-- containing `I` to one of `B`, obtain a local finite `H_1`-regular generating sequence for the
-- extended ideal, and descend `H_1`-regularity through the resulting faithfully flat local map.
/-- Lemma 15.32.4 (2): if `A → B` is faithfully flat and the extended ideal `IB` is
`H_1`-regular in `B`, then `I` is `H_1`-regular in `A`. -/
theorem of_faithfullyFlat {I : Ideal A} (hff : (algebraMap A B).FaithfullyFlat)
    (hIB : (I.map (algebraMap A B)).IsH1RegularIdeal) : I.IsH1RegularIdeal := by
  rw [RingHom.faithfullyFlat_algebraMap_iff] at hff
  letI : Module.FaithfullyFlat A B := hff
  sorry

end IsH1RegularIdeal

namespace IsQuasiRegularIdeal

-- Proof sketch: first use faithful flat descent of finite generation and finite projectivity on
-- the conormal module to obtain local generators of `I`. Then descend the defining symmetric-power
-- isomorphisms for quasi-regularity from the faithfully flat base change `B`, again working
-- Zariski-locally near each prime of `A` containing `I`.
/-- Lemma 15.32.4 (3): if `A → B` is faithfully flat and the extended ideal `IB` is
quasi-regular in `B`, then `I` is quasi-regular in `A`. -/
theorem of_faithfullyFlat {I : Ideal A} (hff : (algebraMap A B).FaithfullyFlat)
    (hIB : (I.map (algebraMap A B)).IsQuasiRegularIdeal) : I.IsQuasiRegularIdeal := by
  rw [RingHom.faithfullyFlat_algebraMap_iff] at hff
  letI : Module.FaithfullyFlat A B := hff
  sorry

end IsQuasiRegularIdeal

end Ideal

end

/-! ### Lemma_15_32_5 (from Chap15) -/
universe u

namespace Ideal

variable {A : Type u} [CommRing A]

/- Domain triage:
- primary domain: commutative algebra of quotient ideals and local `H₁`-regularity;
- sampled owner declarations:
  `Ideal.IsH1RegularIdeal`,
  `Ideal.isH1RegularIdeal_iff`,
  `Ideal.inf_sq_eq_mul_of_quotient_generated_by_h1RegularSequence`;
- layer split:
  `source-facing`: the quotient ideal `J / I` is `H₁`-regular;
  `core/canonical`: the ideal owner predicate `Ideal.IsH1RegularIdeal`;
  `bridge/view`: the finite-sequence bridge from Lemma `15.30.9`, used after unpacking the owner
  predicate on the quotient ring.
- primitive vs derived split: the only primitive data are the ideals `I ≤ J` and the owner
  hypothesis on `J.map (Ideal.Quotient.mk I)`; any localized finite generating sequences belong to
  the derived bridge API, not to the public theorem surface.
-/

-- Proof sketch: localize the quotient ring `A ⧸ I` at each prime containing the quotient ideal
-- `J.map (Ideal.Quotient.mk I)`; the `H₁`-regularity hypothesis gives a basic neighborhood where
-- that localized ideal is generated by a finite `H₁`-regular sequence. Apply Lemma `15.30.9` in
-- the localization and descend the resulting equality to `A`.
/-- Lemma 15.32.5: if the quotient ideal `J / I` in `A ⧸ I` is an `H_1`-regular ideal, then
`I ∩ J^2 = IJ`. -/
theorem inf_sq_eq_mul_of_quotient_isH1RegularIdeal (I J : Ideal A) (hIJ : I ≤ J)
    (hreg : (J.map (Ideal.Quotient.mk I)).IsH1RegularIdeal) :
    I ⊓ J ^ 2 = I * J := sorry

end Ideal
