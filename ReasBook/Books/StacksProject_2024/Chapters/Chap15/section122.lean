/-! ### Lemma_15_122_1 (from Chap15) -/
universe u

section

/- Domain-style sampling:
- primary domain: Picard groups of commutative rings under factorization hypotheses, specialized
  here to a localization of a regular local ring;
- sampled owner declarations:
  `CommRing.Pic.instSubsingletonOfIsLocalRing`,
  `nagataCriterionForFactoriality`,
  `Submonoid.closure_le`,
  `Submonoid.powers_eq_closure`,
  `regularLocalRing_uniqueFactorizationMonoid`,
  `IsLocalization.isDomain_of_le_nonZeroDivisors`;
- best owner abstraction: the canonical Picard owner is still `CommRing.Pic`, but the relevant
  upstream bridge for the nontrivial localization branch is the Chapter 10 Nagata owner for
  factoriality of localizations at multiplicative subsets generated by
  `Submonoid.closure {p | Prime p}`; the local-ring Picard owner applies only in the
  unit-localization branch;
- primitive vs. derived:
  the primitive data is the regular-local structure on `R` and the chosen element `f`; the
  source-facing theorem remains about `Localization.Away f`, while the factoriality of the
  nonunit branch and the Picard triviality of the unit branch are both derived from upstream owner
  abstractions rather than from any local wrapper API;
- source/core/bridge triage:
  `source-facing`: the theorem below for `Localization.Away f`;
  `core/canonical`: the upstream `Subsingleton (CommRing.Pic S)` owner;
  `bridge/view`: Nagata's factoriality bridge for localizations and the unit-localization
  equivalence `IsLocalization.atUnit`.
-/
/-- In a unique factorization domain, the powers of a nonzero nonunit element lie in the canonical
submonoid closure of the prime elements. -/
private theorem powers_le_closure_primes_of_ne_zero_of_not_isUnit
    {R : Type u} [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R] {f : R}
    (hf : f ≠ 0) (hfu : ¬ IsUnit f) :
    Submonoid.powers f ≤ Submonoid.closure {p : R | Prime p} := by
  have hf_closure : f ∈ Submonoid.closure {p : R | Prime p} := by
    rcases (WfDvdMonoid.not_unit_iff_exists_factors_eq f hf).mp hfu with ⟨g, hg, hprod, -⟩
    rw [← hprod]
    exact Submonoid.multiset_prod_mem _ _ fun p hp ↦
      Submonoid.subset_closure <|
        UniqueFactorizationMonoid.irreducible_iff_prime.mp (hg p hp)
  rw [Submonoid.powers_eq_closure]
  exact Submonoid.closure_le.2 (Set.singleton_subset_iff.2 hf_closure)

/-- Lemma 15.122.1: if `R` is a regular local ring and `f ∈ R`, then the localization `R_f`,
realized as `Localization.Away f`, has trivial Picard group. -/
theorem subsingleton_picardGroup_localizationAway_of_isRegularLocalRing
    {R : Type u} [CommRing R] [IsRegularLocalRing R] (f : R) :
    Subsingleton (CommRing.Pic (Localization.Away f)) := by
  by_cases hf : f = 0
  · subst hf
    let _ : Subsingleton (Localization.Away (0 : R)) :=
      IsLocalization.subsingleton
        (show (0 : R) ∈ Submonoid.powers (0 : R) from ⟨1, by simp⟩)
    infer_instance
  · by_cases hfu : IsUnit f
    · let e := IsLocalization.atUnit R (Localization.Away f) f hfu
      let _ : IsLocalRing (Localization.Away f) := e.toRingEquiv.isLocalRing
      exact CommRing.Pic.instSubsingletonOfIsLocalRing (Localization.Away f)
    · let _ : IsDomain (Localization.Away f) :=
        IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away f)
          (powers_le_nonZeroDivisors_of_noZeroDivisors hf)
      let _ : UniqueFactorizationMonoid (Localization.Away f) :=
        (nagataCriterionForFactoriality
          (powers_le_closure_primes_of_ne_zero_of_not_isUnit hf hfu)).mp inferInstance |>.2
      infer_instance

end

/-! ### Lemma_15_122_2 (from Chap15) -/
universe u

section

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/- Domain-style sampling for Lemma 15.122.2:
- primary domain: commutative algebra of regular local rings, height-one prime ideals, and the
  canonical factoriality owner `UniqueFactorizationMonoid`;
- sampled owner declarations:
  `regularLocalRing_isDomain`,
  `uniqueFactorizationMonoid_iff_forall_height_one_prime_isPrincipal`,
  `UniqueFactorizationMonoid`,
  `IsRegularLocalRing`;
- best owner abstraction: the public owner is `UniqueFactorizationMonoid R`; the height-one-prime
  principal criterion is derived bridge API imported from Chapter 10 rather than primitive local
  data for this file;
- primitive vs. derived:
  the primitive data are only the ambient regular-local hypotheses on `R`;
  the height-one-principal criterion used in the proof is derived from the Chapter 10 owner bridge.

Source/core/bridge triage:
- `source-facing`: the instance below expressing that a regular local ring is factorial;
- `core/canonical`: `UniqueFactorizationMonoid R`;
- `bridge/view`: `uniqueFactorizationMonoid_iff_forall_height_one_prime_isPrincipal`. -/

-- Proof sketch: by Lemma `10.120.6`, it is enough to prove that every height-one prime ideal of a
-- regular local ring is principal. Proceed by induction on the dimension. Choose
-- `x ∈ maximalIdeal R \ maximalIdeal R ^ 2`; then `R ⧸ (x)` is again regular, hence a domain, so
-- `x` is a prime element. For a height-one prime `p`, either `x ∈ p`, in which case `p = (x)`, or
-- after localizing away from `x`, the localizations at nonmaximal primes are regular local rings
-- of smaller dimension, so the induction hypothesis shows `p` becomes invertible and hence
-- principal on `Rₓ`. A generator coming from a factor of an element of `p` is then prime in `R`
-- by Nagata's criterion, and its principal ideal equals `p`.
/-- Lemma 15.122.2: a regular local ring is a unique factorization domain. -/
instance regularLocalRing_uniqueFactorizationMonoid : UniqueFactorizationMonoid R := by
  refine (uniqueFactorizationMonoid_iff_forall_height_one_prime_isPrincipal).2 ?_
  intro p hp hheight
  sorry

end

