/-! ### Definition_15_8_3 (from Chap15) -/
universe u v

open Matrix

/-
Domain-style sampling for Definition 15.8.3:
- primary domain: determinantal/Fitting ideals of modules over a commutative ring, built from
  finite free presentations;
- sampled owner-level declarations:
  `Matrix.minorIdeal`,
  `presentationFittingIdeal`,
  `fittingIdeal`,
  `fittingIdealNegOne`,
  `fittingIdeal_eq_presentationFittingIdeal`;
- best owner abstraction: `presentationFittingIdeal` is the presentation-level owner attached to a
  chosen surjective finite free presentation, while `fittingIdeal` is the source-facing intrinsic
  finite-module owner obtained by taking the infimum over all such presentations, together with the
  source convention `Fit_{-1}(M) = 0`;
- primitive data: a surjective finite free presentation `π : R^n → M` for the presentation-level
  owner;
- derived API: presentation independence, the induced intrinsic module-level Fitting ideal, and
  the owner-side predecessor helper `precedingFittingIdeal`.

Source/core/bridge triage:
- `source-facing`: `fittingIdeal`, `fittingIdealNegOne`;
- `core/canonical`: `presentationFittingIdeal`;
- `bridge/view`: `fittingIdeal_eq_presentationFittingIdeal`, `precedingFittingIdeal`. -/

section

variable (R : Type u) [CommRing R]

/-- Definition 15.8.3 also fixes the convention `Fit_{-1}(M) = 0`. -/
abbrev fittingIdealNegOne : Ideal R :=
  (⊥ : Ideal R)

@[simp] theorem fittingIdealNegOne_eq_bot :
    fittingIdealNegOne R = (⊥ : Ideal R) :=
  rfl

end

section

variable (R : Type u) [CommRing R]
variable (M : Type v) [AddCommGroup M] [Module R M]

/-- The `k`th Fitting ideal attached to a finite free presentation map `R^n → M`, using the
kernel-vector matrix and the chapter's determinantal-ideal owner `Matrix.minorIdeal`. Surjectivity
is imposed only when relating this presentation-level construction to the intrinsic Fitting ideal
of `M`. -/
def presentationFittingIdeal (k : ℕ) {n : ℕ} (π : (Fin n → R) →ₗ[R] M) : Ideal R :=
  I_((n - k))((fun i x ↦ x.1 i : Matrix (Fin n) (LinearMap.ker π) R))

-- Proof sketch: stabilize two surjective finite free presentations by adding trivial summands and
-- compare the resulting kernel-vector determinant ideals after changing bases in the source free
-- modules. The determinant ideals are invariant under these operations, so the presentation ideal
-- depends only on `M` and `k`.
/-- Any two surjective finite free presentations of `M` determine the same presentation Fitting
ideal. -/
theorem presentationFittingIdeal_eq_of_surjective {n n' k : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (π' : (Fin n' → R) →ₗ[R] M)
    (hπ : Function.Surjective π) (hπ' : Function.Surjective π') :
    presentationFittingIdeal R M k π = presentationFittingIdeal R M k π' := sorry

section

variable [Module.Finite R M]

private abbrev SurjectivePresentation :=
  Σ n : ℕ, { π : (Fin n → R) →ₗ[R] M // Function.Surjective π }

/-- Definition 15.8.3: for a finite `R`-module `M`, the `k`th Fitting ideal is the intrinsic
ideal obtained from the presentation-independent construction of Lemma 15.8.2; concretely, it is
the infimum of `presentationFittingIdeal k π` over all surjective maps `π : R^n → M`. -/
def fittingIdeal : ℕ → Ideal R := fun k ↦
  sInf <| Set.range fun P : SurjectivePresentation R M ↦ presentationFittingIdeal R M k P.2.1

namespace FittingIdeal

scoped notation "Fit[" R "]_(" k ")(" M ")" => fittingIdeal R M k

end FittingIdeal

open scoped FittingIdeal

/-- The Fitting ideal one step below `Fit_r(M)`, using the owner convention `Fit_{-1}(M) = 0`. -/
abbrev precedingFittingIdeal (r : ℕ) : Ideal R :=
  if r = 0 then fittingIdealNegOne R else Fit[R]_(r - 1)(M)

@[simp] theorem precedingFittingIdeal_zero :
    precedingFittingIdeal R M 0 = ⊥ := by
  simp [precedingFittingIdeal]

@[simp] theorem precedingFittingIdeal_succ (r : ℕ) :
    precedingFittingIdeal R M (r + 1) = Fit[R]_(r)(M) := by
  simp [precedingFittingIdeal]

-- Proof sketch: a surjective presentation `π` contributes the ideal
-- `presentationFittingIdeal k π` to the defining family for `fittingIdeal`. Any other
-- surjective presentation contributes the same ideal by
-- `presentationFittingIdeal_eq_of_surjective`, so the infimum of the family is exactly this
-- common value.
/-- The intrinsic Fitting ideal agrees with the Fitting ideal computed from any surjective finite
free presentation. -/
theorem fittingIdeal_eq_presentationFittingIdeal (k : ℕ) {n : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π) :
    Fit[R]_(k)(M) = presentationFittingIdeal R M k π := sorry

/-- The intrinsic Fitting ideal is invariant under linear equivalence of finite modules. -/
theorem fittingIdeal_eq_of_linearEquiv {M' : Type*} [AddCommGroup M'] [Module R M']
    (k : ℕ) (e : M ≃ₗ[R] M') :
    let _ : Module.Finite R M' := Module.Finite.of_surjective (e : M →ₗ[R] M') e.surjective
    Fit[R]_(k)(M) = Fit[R]_(k)(M') := sorry

end

end

/-! ### Lemma_15_8_4 (from Chap15) -/
universe u v w

open scoped TensorProduct

section

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M]

/-- The `k`th Fitting ideal attached to a surjection `R^n → M`, computed from `(n - k)` kernel
vectors as in the intrinsic reformulation of the minors construction. -/
def freePresentationFittingIdeal (k : ℕ) {n : ℕ} (π : (Fin n → R) →ₗ[R] M) : Ideal R :=
  Ideal.span (Set.range fun p : (Fin (n - k) ↪ Fin n) × (Fin (n - k) → LinearMap.ker π) ↦
    Matrix.det (fun i j ↦ (((p.2 j : LinearMap.ker π) : Fin n → R) (p.1 i))))

variable (R) (M)

/-- The canonical `k`th Fitting ideal of a module, defined as the infimum of the Fitting ideals
coming from all finite free presentations. -/
def moduleFittingIdeal (k : ℕ) : Ideal R :=
  sInf { I : Ideal R | ∃ n : ℕ, ∃ π : (Fin n → R) →ₗ[R] M, Function.Surjective π ∧
    I = freePresentationFittingIdeal k π }

variable {R M}

/-- The canonical Fitting ideal is bounded above by the Fitting ideal of any chosen finite free
presentation. -/
-- Proof sketch: `moduleFittingIdeal` is the infimum of the set of all presentation ideals, so it
-- is below every member coming from a surjective finite free presentation.
theorem moduleFittingIdeal_le_freePresentationFittingIdeal (k : ℕ) {n : ℕ}
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π) :
    moduleFittingIdeal R M k ≤ freePresentationFittingIdeal k π := sorry

variable {M' : Type w} [AddCommGroup M'] [Module R M']

-- Proof sketch: choose a surjection `R^n → M`; the intrinsic presentation formula shows that all
-- `(n - n) × (n - n)` minors generate the unit ideal, and then compare with the canonical infimum
-- definition.
/-- Lemma 15.8.4 (1): if `M` is generated by `n` elements, then its `n`th Fitting ideal is the
unit ideal. -/
theorem moduleFittingIdeal_eq_top_of_exists_surjective_fin (n : ℕ)
    (π : (Fin n → R) →ₗ[R] M) (hπ : Function.Surjective π) :
    moduleFittingIdeal R M n = ⊤ := sorry

-- Proof sketch: apply the block-diagonal formula for presentation matrices to the direct-sum
-- presentation of `M ⊕ M'`, and then specialize the antidiagonal sum at `l = 0`.
/-- Lemma 15.8.4 (2): the zeroth Fitting ideal of a direct sum is the product of the zeroth
Fitting ideals. -/
theorem moduleFittingIdeal_zero_directSum [Module.Finite R M] [Module.Finite R M'] :
    moduleFittingIdeal R (M × M') 0 =
      moduleFittingIdeal R M 0 * moduleFittingIdeal R M' 0 := sorry

-- Proof sketch: use finite free presentations of `M` and `M'`, form the block-diagonal
-- presentation of `M ⊕ M'`, and invoke the corresponding minors formula from the matrix-level
-- statement.
/-- Lemma 15.8.4 (3): the `l`th Fitting ideal of a direct sum is the sum of the products of the
`k`th and `k'`th Fitting ideals over all decompositions `k + k' = l`. -/
theorem moduleFittingIdeal_directSum [Module.Finite R M] [Module.Finite R M'] (l : ℕ) :
    moduleFittingIdeal R (M × M') l =
      Finset.sum (Finset.antidiagonal l) fun p ↦
        moduleFittingIdeal R M p.1 * moduleFittingIdeal R M' p.2 := sorry

-- Proof sketch: tensor a finite free presentation of `M` with `R'`; tensor product preserves
-- right exactness, and the minors in the base-changed presentation generate the image ideal.
/-- Lemma 15.8.4 (4): after base change along `R → R'`, the `k`th Fitting ideal is the ideal of
`R'` generated by the image of the `k`th Fitting ideal over `R`. -/
theorem moduleFittingIdeal_baseChange {R' : Type w} [CommRing R'] [Algebra R R']
    [Module R' (M ⊗[R] R')] [Module.Finite R M] (k : ℕ) :
    moduleFittingIdeal R' (M ⊗[R] R') k =
      Ideal.map (algebraMap R R') (moduleFittingIdeal R M k) := sorry

-- Proof sketch: start from a finite presentation of `M`; the relevant ideal is generated by a
-- finite set of minors of a finite presentation matrix, hence is finitely generated.
/-- Lemma 15.8.4 (5): if `M` is finitely presented, then each Fitting ideal of `M` is finitely
generated. -/
theorem moduleFittingIdeal_fg_of_finitePresentation [Module.FinitePresentation R M] (k : ℕ) :
    (moduleFittingIdeal R M k).FG := sorry

-- Proof sketch: compose a finite free presentation of `M` with the surjection `M → M'`. Every
-- presentation of `M` induces one of `M'`, so the defining presentation ideals for `M` lie below
-- those for `M'`.
/-- Lemma 15.8.4 (6): a surjection `M → M'` makes the `k`th Fitting ideal of `M` contained in the
`k`th Fitting ideal of `M'`. -/
theorem moduleFittingIdeal_mono_of_surjective [Module.Finite R M] [Module.Finite R M']
    (f : M →ₗ[R] M') (hf : Function.Surjective f) (k : ℕ) :
    moduleFittingIdeal R M k ≤ moduleFittingIdeal R M' k := sorry

-- Proof sketch: use a finite presentation of `M` and the determinant trick on the maximal minors
-- of a presentation matrix to show that every generator of `Fit₀(M)` annihilates `M`.
/-- Lemma 15.8.4 (7): the zeroth Fitting ideal of `M` is contained in the annihilator ideal of
`M`. -/
theorem moduleFittingIdeal_zero_le_annihilator [Module.Finite R M] :
    moduleFittingIdeal R M 0 ≤ Module.annihilator R M := sorry

-- Proof sketch: combine the previous annihilator containment with the characterization of support
-- of a finite module as the zero locus of its annihilator, and compare with the determinant
-- criterion after reducing modulo a prime.
/-- Lemma 15.8.4 (8): the zero locus of the zeroth Fitting ideal of `M` is the support of `M`. -/
theorem zeroLocus_moduleFittingIdeal_zero_eq_support [Module.Finite R M] :
    PrimeSpectrum.zeroLocus (moduleFittingIdeal R M 0) = Module.support R M := sorry

-- Proof sketch: use the standard one-generator presentation of `R ⧸ I`; its `1 × 1` minors are
-- exactly the elements of `I`, so the zeroth Fitting ideal recovers `I`.
/-- Lemma 15.8.4 (9): the zeroth Fitting ideal of the quotient module `R ⧸ I` is `I`. -/
theorem moduleFittingIdeal_zero_quotient (I : Ideal R) :
    moduleFittingIdeal R (R ⧸ I) 0 = I := sorry

end

/-! ### Example_15_8_5 (from Chap15) -/
open scoped FittingIdeal

/-
Domain-style sampling for Example 15.8.5:
- primary domain: intrinsic Fitting ideals of finite free modules over a commutative ring;
- sampled owner-level declarations:
  `fittingIdeal`,
  `fittingIdeal_eq_presentationFittingIdeal`,
  `presentationFittingIdeal`,
  `presentationFittingIdeal_eq_of_surjective`;
- best owner abstraction: the source-facing owner `fittingIdeal`; in this file the presentation
  formula is only bridge/view API used to compute that owner on the identity presentation of the
  free module;
- primitive data: the intrinsic ideal `fittingIdeal R M k`;
- derived API: the computation from a surjective presentation, here the identity map of the free
  module `Fin n → R`.

Source/core/bridge triage:
- `source-facing`: `fittingIdeal_free_eq_zero_or_top`;
- `core/canonical`: `fittingIdeal`;
- `bridge/view`: `fittingIdeal_eq_presentationFittingIdeal` together with the identity-presentation
  computation below. -/

universe u

section

variable (R : Type u) [CommRing R]

private theorem presentationFittingIdeal_id_eq_zero_or_top (n k : ℕ) :
    presentationFittingIdeal R (Fin n → R) k
        (LinearMap.id : (Fin n → R) →ₗ[R] (Fin n → R)) =
      if k < n then ⊥ else ⊤ := by
  let π : (Fin n → R) →ₗ[R] (Fin n → R) := LinearMap.id
  by_cases hk : k < n
  · have hnk : 0 < n - k := Nat.sub_pos_of_lt hk
    rw [if_pos hk]
    change presentationFittingIdeal R (Fin n → R) k π = ⊥
    rw [presentationFittingIdeal, Matrix.minorIdeal, Ideal.span_eq_bot]
    rintro _ ⟨⟨e₁, e₂⟩, rfl⟩
    let i : Fin (n - k) := ⟨0, hnk⟩
    exact Matrix.det_eq_zero_of_row_eq_zero i fun j ↦ by
      have he₂j : (((e₂ j : LinearMap.ker π) : Fin n → R)) = 0 :=
        LinearMap.mem_ker.mp (e₂ j).property
      simpa [he₂j]
  · have hk' : n ≤ k := Nat.le_of_not_gt hk
    rw [if_neg hk]
    change presentationFittingIdeal R (Fin n → R) k π = ⊤
    rw [presentationFittingIdeal, Matrix.minorIdeal, Nat.sub_eq_zero_of_le hk']
    refine Ideal.eq_top_of_isUnit_mem _ ?_ isUnit_one
    have hmem :
        (1 : R) ∈
          Set.range
            (fun p :
              (Fin 0 ↪ Fin n) × (Fin 0 ↪ LinearMap.ker π) ↦
                Matrix.det
                  (Matrix.submatrix
                    (fun i x ↦ x.1 i : Matrix (Fin n) (LinearMap.ker π) R) p.1 p.2)) := by
      let e₁ : Fin 0 ↪ Fin n := ⟨Fin.elim0, fun i ↦ Fin.elim0 i⟩
      let e₂ : Fin 0 ↪ LinearMap.ker π := ⟨Fin.elim0, fun i ↦ Fin.elim0 i⟩
      refine ⟨⟨e₁, e₂⟩, ?_⟩
      simp [e₁, e₂, Matrix.det_fin_zero]
    exact Ideal.subset_span hmem

-- Proof sketch: apply `fittingIdeal_eq_presentationFittingIdeal` to the identity presentation
-- `(Fin n → R) →ₗ[R] (Fin n → R)`, then evaluate the resulting presentation ideal using the
-- private identity-presentation computation above.
/-- Example 15.8.5: the Fitting ideals of the finite free module `R^{\oplus n}` are `0` for
`k < n` and `R` for `k ≥ n`. -/
theorem fittingIdeal_free_eq_zero_or_top (n k : ℕ) :
    Fit[R]_(k)(Fin n → R) = if k < n then ⊥ else ⊤ := by
  rw [fittingIdeal_eq_presentationFittingIdeal R (Fin n → R) k
      (LinearMap.id : (Fin n → R) →ₗ[R] (Fin n → R)) Function.surjective_id]
  simpa using presentationFittingIdeal_id_eq_zero_or_top R n k

/-- For a free module of rank `n`, the `k`th Fitting ideal vanishes when `k < n`. -/
theorem fittingIdeal_free_eq_bot_of_lt {n k : ℕ} (hk : k < n) :
    Fit[R]_(k)(Fin n → R) = ⊥ := by
  simpa [if_pos hk] using fittingIdeal_free_eq_zero_or_top R n k

/-- For a free module of rank `n`, the `k`th Fitting ideal is the unit ideal when `n ≤ k`. -/
theorem fittingIdeal_free_eq_top_of_le {n k : ℕ} (hk : n ≤ k) :
    Fit[R]_(k)(Fin n → R) = ⊤ := by
  simpa [if_neg (Nat.not_lt.mpr hk)] using fittingIdeal_free_eq_zero_or_top R n k

end

/-! ### Example_15_8_6 (from Chap15) -/
open scoped FittingIdeal

/-
Domain-style sampling for Example 15.8.6:
- primary domain: Fitting ideals of finite modules, especially quotient modules and direct sums;
- sampled owner-level declarations:
  `fittingIdeal`,
  `fittingIdeal_zero_quotient`,
  `fittingIdeal_zero_directSum`,
  `fittingIdeal_directSum`;
- best owner abstraction: the source-facing owner is `fittingIdeal`, and the quotient/direct-sum
  examples should reuse that owner directly;
- primitive data: the intrinsic ideal `fittingIdeal R M k`;
- derived API: the quotient and direct-sum formulas supplied by `Lemma 15.8.4`.

Source/core/bridge triage:
- `source-facing`: the three example computations of `fittingIdeal`;
- `core/canonical`: `fittingIdeal`;
- `bridge/view`: `fittingIdeal_zero_quotient` and `fittingIdeal_directSum`. -/

universe u

section

variable {R : Type u} [CommRing R]

private theorem fittingIdeal_one_quotient_eq_top (I : Ideal R) :
    Fit[R]_(1)(R ⧸ I) = ⊤ := by
  let π : (Fin 1 → R) →ₗ[R] R ⧸ I :=
    (Ideal.Quotient.mkₐ R I).toLinearMap.comp (LinearEquiv.funUnique (Fin 1) R R).toLinearMap
  have hπ : Function.Surjective π := by
    intro x
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective x
    refine ⟨(LinearEquiv.funUnique (Fin 1) R R).symm r, ?_⟩
    simp [π]
  exact fittingIdeal_eq_top_of_exists_surjective_fin 1 ⟨π, hπ⟩

/- Example 15.8.6 (1): the zeroth Fitting ideal of the quotient module `R ⧸ I` is `I`. -/
recall fittingIdeal_zero_quotient

/-- Example 15.8.6 (2): the zeroth Fitting ideal of `R ⧸ I ⊕ R ⧸ J` is the product ideal `IJ`. -/
theorem fittingIdeal_zero_quotient_directSum (I J : Ideal R) :
    Fit[R]_(0)((R ⧸ I) × (R ⧸ J)) = I * J := by
  have h :
      Fit[R]_(0)((R ⧸ I) × (R ⧸ J)) = Fit[R]_(0)(R ⧸ I) * Fit[R]_(0)(R ⧸ J) :=
    fittingIdeal_zero_directSum
  simpa [fittingIdeal_zero_quotient] using h

/-- Example 15.8.6 (3): the first Fitting ideal of `R ⧸ I ⊕ R ⧸ J` is the sum ideal `I + J`. -/
theorem fittingIdeal_one_quotient_directSum (I J : Ideal R) :
    Fit[R]_(1)((R ⧸ I) × (R ⧸ J)) = I + J := by
  have h :
      Fit[R]_(1)((R ⧸ I) × (R ⧸ J)) =
        Finset.sum (Finset.antidiagonal 1) fun p ↦
          Fit[R]_(p.1)(R ⧸ I) * Fit[R]_(p.2)(R ⧸ J) :=
    fittingIdeal_directSum 1
  rw [h]
  norm_num [Finset.antidiagonal]
  rw [fittingIdeal_zero_quotient I,
    fittingIdeal_zero_quotient J,
    fittingIdeal_one_quotient_eq_top I,
    fittingIdeal_one_quotient_eq_top J]
  simp

end

/-! ### Lemma_15_8_7 (from Chap15) -/
open scoped FittingIdeal TensorProduct

universe u v

/-
Domain-style sampling for Lemma 15.8.7:
- primary domain: commutative algebra of finite modules, Fitting ideals, residue-field fibers, and
  local generation after localization;
- sampled owner-level declarations:
  `fittingIdeal`,
  `fittingIdeal_baseChange`,
  `Module.finrank`,
  `exists_sub_one_mem_and_span_localized_eq_top_of_quotient_span_eq_top`;
- best owner abstraction: clause (1) should use the chapter owner `fittingIdeal` directly, via the
  canonical notation `Fit[R]_(k)(M)`, while clauses (3) and (4) use the intrinsic generation
  owner `Submodule.span ... = ⊤` rather than introducing a parallel wrapper for "generated by
  `k` elements";
- primitive data: the finite module `M`, the integer `k`, and the prime ideal `p`;
- derived API: the residue-field finrank criterion, the at-prime generation criterion, and the
  away-local generation criterion linked by base change and Nakayama.

Source/core/bridge triage:
- `source-facing`: the four equivalent conditions of Lemma 15.8.7;
- `core/canonical`: `fittingIdeal` and the canonical localization/base-change objects;
- `bridge/view`: the residue-field finrank test and the localized generation clauses. -/

section

variable {R : Type u} [CommRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]

-- Proof sketch: use `fittingIdeal_baseChange` from Lemma `15.8.4` to reduce clause (1) to
-- the case over the residue field `κ(p)`, where Example `15.8.5` computes the relevant Fitting
-- ideal of a finite-dimensional vector space. The equivalence of clauses (2), (3), and (4) is the
-- usual local-generation criterion via Nakayama's lemma, passing between `M ⊗[R] κ(p)`,
-- `M_p`, and an open neighborhood `D(f)` of `p`.
/-- Lemma 15.8.7: for a finite `R`-module `M`, a nonnegative integer `k`, and a prime ideal `p`,
the following are equivalent: the `k`th Fitting ideal of `M` is not contained in `p`; the
residue-field fiber `M ⊗[R] κ(p)` has dimension at most `k`; the localization `M_p` is generated
by `k` elements over `R_p`; and some localization `M_f` with `f ∉ p` is generated by `k`
elements over `R_f`. -/
theorem fittingIdeal_not_le_prime_tfae_residueField_finrank_and_local_generators
    (k : ℕ) (p : Ideal R) [p.IsPrime] :
    List.TFAE
      [ ¬ Fit[R]_(k)(M) ≤ p
      , Module.finrank p.ResidueField (p.ResidueField ⊗[R] M) ≤ k
      , ∃ v : Fin k → LocalizedModule.AtPrime p M,
          Submodule.span (Localization.AtPrime p) (Set.range v) = ⊤
      , ∃ f : R, f ∉ p ∧ ∃ v : Fin k → LocalizedModule.Away f M,
          Submodule.span (Localization.Away f) (Set.range v) = ⊤
      ] := sorry

end

/-! ### Lemma_15_8_8 (from Chap15) -/
open scoped FittingIdeal

universe u v

section

variable (R : Type u) [CommRing R]
variable (M : Type v) [AddCommGroup M] [Module R M]

section

variable [Module.Finite R M]

-- Proof sketch: clause (2) is equivalent to clause (3) because Fitting ideals form an increasing
-- sequence. For `(1) → (2)`, localize on a standard-open cover on which `M` is free of rank `r`,
-- use the explicit computation of Fitting ideals for a free module, and descend the equalities by
-- base change. For `(2) → (1)`, use the local generation criterion coming from the previous lemma
-- to reduce locally to a presentation by `r` generators; the vanishing of `Fit_{r-1}(M)` then
-- forces the presentation matrix to vanish, so the localized module is free of rank `r`.
/-- Lemma 15.8.8: for a finite `R`-module `M` and `r : ℕ`, the following are equivalent: `M` is
finite locally free of rank `r`; `Fit_{r-1}(M) = 0` (with the convention `Fit_{-1}(M) = 0`) and
`Fit_r(M) = R`; and `Fit_k(M) = 0` for `k < r` while `Fit_k(M) = R` for `k ≥ r`. -/
theorem finiteLocallyFreeOfRank_tfae_fittingIdeal_conditions (r : ℕ) :
    List.TFAE
      [ Module.FiniteLocallyFreeOfRank R M r
      , precedingFittingIdeal R M r = ⊥ ∧ Fit[R]_(r)(M) = ⊤
      , (∀ k, k < r → Fit[R]_(k)(M) = ⊥) ∧ ∀ k, r ≤ k → Fit[R]_(k)(M) = ⊤
      ] := sorry

end

end

/-! ### Lemma_15_8_9 (from Chap15) -/
open scoped FittingIdeal

/-
Domain-style sampling for Lemma 15.8.9:
- primary domain: local commutative algebra of finite modules, intrinsic Fitting ideals, and
  quotients by `f`-torsion;
- sampled owner-level declarations:
  `fittingIdeal`,
  `principalIdeal`,
  `Submodule.torsionBy`,
  `Submodule.span`,
  `span_range_eq_top_iff_surjective_fintypeLinearCombination`;
- best owner abstraction: the theorem is `source-facing`, and its main hypothesis should use the
  intrinsic owner `fittingIdeal` together with the chapter owner `principalIdeal`; the canonical
  "generated by `k` elements" conclusion is the
  intrinsic span statement for a family `Fin k → N`, while the surjective
  `Fintype.linearCombination` map is the operational bridge view;
- primitive data: the finite module `M`, the integer `k`, and the intrinsic Fitting-ideal
  equality `fittingIdeal R M k = principalIdeal f`;
- derived API: the surjective `Fintype.linearCombination` view obtained from the source-facing span
  theorem via `span_range_eq_top_iff_surjective_fintypeLinearCombination`.

Source/core/bridge triage:
- `source-facing`: `quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal`;
- `core/canonical`: `fittingIdeal`, `principalIdeal`, `Submodule.torsionBy`, `Submodule.span`;
- `bridge/view`:
  `quotient_torsionBy_fintypeLinearCombination_surjective_of_fittingIdeal_eq_principalIdeal`. -/

universe u v

section

variable {R : Type u} [CommRing R] [IsLocalRing R]
variable {M : Type v} [AddCommGroup M] [Module R M] [Module.Finite R M]
variable {k : ℕ} {f : R}

/-- Lemma 15.8.9: over a local ring, if the chapter `k`th Fitting ideal of a finite module `M` is
the principal ideal `(f)`, then the quotient of `M` by its `f`-torsion is generated by `k`
elements. -/
-- Proof sketch: choose a finite free presentation of `M` computing `fittingIdeal R M k`,
-- apply the local determinantal normal-form argument to the resulting presentation matrix. Passing
-- to the quotient by `Submodule.torsionBy R M f` kills the `f`-torsion part, and the images of
-- the remaining `k` generators span the quotient module.
theorem quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal
    (hfit : Fit[R]_(k)(M) = principalIdeal f) :
    ∃ v : Fin k → M ⧸ Submodule.torsionBy R M f,
      Submodule.span R (Set.range v) = ⊤ := sorry

/-- Companion surjective linear-combination formulation of
`quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal`. -/
theorem quotient_torsionBy_fintypeLinearCombination_surjective_of_fittingIdeal_eq_principalIdeal
    (hfit : Fit[R]_(k)(M) = principalIdeal f) :
    ∃ v : Fin k → M ⧸ Submodule.torsionBy R M f,
      Function.Surjective (Fintype.linearCombination R v) := by
  rcases quotient_torsionBy_span_eq_top_of_fittingIdeal_eq_principalIdeal hfit with ⟨v, hv⟩
  exact ⟨v, by
    simpa using (span_range_eq_top_iff_surjective_fintypeLinearCombination R v).1 hv⟩

end

