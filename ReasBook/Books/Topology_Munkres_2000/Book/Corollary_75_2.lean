module

public import Topology_Munkres_2000.Book.Theorem_75_1
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.GroupTheory.FreeGroup.GeneratorEquiv

public section

universe u

namespace FreeAbelianGroup

/-- Corollary 75.2 (1). The canonical basis vector of the free abelian group on `Fin n`
is the image of the corresponding free generator. -/
theorem basis_apply (n : ℕ) (i : Fin n) :
    basis (Fin n) i = of i := by
  change Finsupp.toFreeAbelianGroup (Finsupp.single i 1) = of i
  simp

end FreeAbelianGroup

namespace Abelianization

/-- The image in the abelianization of the normal closure of one element is the cyclic
subgroup generated by the image of that element. -/
theorem mapNormalClosureSingleton {F : Type u} [Group F] (x : F) :
    (Subgroup.normalClosure ({x} : Set F)).map (of : F →* Abelianization F) =
      Subgroup.zpowers (of x) := by
  have hof : Function.Surjective (of : F →* Abelianization F) := QuotientGroup.mk'_surjective _
  rw [Subgroup.map_normalClosure _ _ hof, Set.image_singleton, Subgroup.zpowers_eq_closure]
  apply le_antisymm
  · exact Subgroup.normalClosure_le_normal (by simp)
  · exact (Subgroup.closure_le_normalClosure :
      Subgroup.closure ({of x} : Set (Abelianization F)) ≤ Subgroup.normalClosure {of x})

/-- Corollary 75.2 (2). The abelianization of the quotient of the free group on `Fin n`
by the normal closure of `x` is isomorphic to the quotient of its abelianization by the
cyclic subgroup generated by the image of `x`. -/
def oneRelatorQuotientAbelianization (n : ℕ) (x : FreeGroup (Fin n)) :
    Abelianization (FreeGroup (Fin n) ⧸ Subgroup.normalClosure ({x} : Set _)) ≃*
      Abelianization (FreeGroup (Fin n)) ⧸ Subgroup.zpowers (of x) :=
  (quotientComparisonEquiv (Subgroup.normalClosure ({x} : Set _))).trans
    (QuotientGroup.quotientMulEquivOfEq (mapNormalClosureSingleton x))

end Abelianization

end
