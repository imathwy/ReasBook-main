module

public import Mathlib.Topology.Bases

public section

universe u v

namespace Pi

/-- The family of products of coordinatewise open sets from Definition 19.1. -/
def boxBasis {ι : Type u} (X : ι → Type v) [(i : ι) → TopologicalSpace (X i)] :
    Set (Set ((i : ι) → X i)) :=
  {s | ∃ U : (i : ι) → Set (X i), (∀ i, IsOpen (U i)) ∧ s = Set.pi Set.univ U}

/-- The box topology from Definition 19.1 on a dependent product, generated by all products of
coordinatewise open sets. -/
abbrev boxTopologicalSpace {ι : Type u} (X : ι → Type v)
    [(i : ι) → TopologicalSpace (X i)] : TopologicalSpace ((i : ι) → X i) :=
  TopologicalSpace.generateFrom (boxBasis X)

/-- The neighborhood filter at a point for the box topology from Definition 19.1. -/
abbrev boxNhds {ι : Type u} {X : ι → Type v} [(i : ι) → TopologicalSpace (X i)]
    (x : (i : ι) → X i) : Filter ((i : ι) → X i) :=
  @nhds _ (boxTopologicalSpace X) x

/-- Helper for Definition 19.1: membership in `Pi.boxBasis X` characterizes open boxes. -/
theorem mem_boxBasis {ι : Type u} {X : ι → Type v}
    [(i : ι) → TopologicalSpace (X i)] (s : Set ((i : ι) → X i)) :
    s ∈ boxBasis X ↔
      ∃ U : (i : ι) → Set (X i), (∀ i, IsOpen (U i)) ∧ s = Set.pi Set.univ U := Iff.rfl

/-- Helper for Definition 19.1: the whole dependent product is an open box. -/
theorem univ_mem_boxBasis {ι : Type u} (X : ι → Type v)
    [(i : ι) → TopologicalSpace (X i)] :
    Set.univ ∈ boxBasis X := by
  refine ⟨fun _ ↦ Set.univ, fun i ↦ isOpen_univ, ?_⟩
  exact (Set.pi_univ Set.univ).symm

/-- Helper for Definition 19.1: intersections of open boxes are open boxes. -/
theorem inter_mem_boxBasis {ι : Type u} {X : ι → Type v}
    [(i : ι) → TopologicalSpace (X i)] {s t : Set ((i : ι) → X i)}
    (hs : s ∈ boxBasis X) (ht : t ∈ boxBasis X) :
    s ∩ t ∈ boxBasis X := by
  obtain ⟨U, hU, rfl⟩ := hs
  obtain ⟨V, hV, rfl⟩ := ht
  refine ⟨fun i ↦ U i ∩ V i, fun i ↦ (hU i).inter (hV i), ?_⟩
  exact Set.pi_inter_distrib.symm

/-- Definition 19.1: a product of coordinatewise open sets is open in the box topology. -/
theorem isOpen_box {ι : Type u} {X : ι → Type v}
    [(i : ι) → TopologicalSpace (X i)] (U : (i : ι) → Set (X i))
    (hU : ∀ i, IsOpen (U i)) :
    (boxTopologicalSpace X).IsOpen (Set.pi Set.univ U) := by
  -- The box itself is one of the generators of the generated topology.
  apply TopologicalSpace.isOpen_generateFrom_of_mem
  exact (mem_boxBasis (Set.pi Set.univ U)).mpr ⟨U, hU, rfl⟩

end Pi
