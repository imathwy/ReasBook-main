module

public import Topology_Munkres_2000.Book.Definition_19_9.ProductTopology

public section

/-- Remark 19.1: The topology generated by inverse images of open sets under the
coordinate projections is the product topology on a dependent function type. -/
theorem TopologicalSpace.pi_eq_generateFrom_projections {ι : Type u} {X : ι → Type v}
    [∀ i, TopologicalSpace (X i)] :
    (Pi.topologicalSpace : TopologicalSpace ((i : ι) → X i)) =
      TopologicalSpace.generateFrom
        {s | ∃ (i : ι) (U : Set (X i)), IsOpen U ∧ Function.eval i ⁻¹' U = s} := by
  rw [Pi.topologicalSpace_eq_generateFrom]
  congr 1
  ext s
  exact Pi.mem_productSubbasis X
