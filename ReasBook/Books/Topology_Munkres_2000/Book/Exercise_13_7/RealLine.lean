module

public import Topology_Munkres_2000.Book.Definition_13_3.RealLine
public import Mathlib.Topology.Bases

public section

open Set

namespace RealTopology

/-- The family of half-open intervals `(a, b]` generating the upper-limit topology on `ℝ`. -/
def upperLimitBasis : Set (Set ℝ) :=
  {s | ∃ a b : ℝ, a < b ∧ s = Ioc a b}

/-- Helper for Exercise 13.7: membership in `upperLimitBasis` is membership as a
half-open interval `(a, b]`. -/
lemma mem_upperLimitBasis_iff (s : Set ℝ) :
    s ∈ upperLimitBasis ↔ ∃ a b : ℝ, a < b ∧ s = Ioc a b := by
  -- Unfold the named basis once in its owner module to expose its public membership API.
  rfl

/-- The upper-limit topology on `ℝ`, generated by half-open intervals `(a, b]`. -/
@[reducible]
def upperLimit : TopologicalSpace ℝ :=
  TopologicalSpace.generateFrom upperLimitBasis

/-- Helper for Exercise 13.7: `upperLimit` is generated by `upperLimitBasis`. -/
lemma upperLimit_eq_generateFrom :
    upperLimit = TopologicalSpace.generateFrom upperLimitBasis := by
  -- Unfold the named topology once in its owner module to record its generating family.
  rfl

-- Local instance justification (noncanonical choice): `ℝ` already has its standard topology,
-- while this theorem states the basis property for the competing upper-limit topology.
local instance instUpperLimitTopology : TopologicalSpace ℝ := upperLimit

/-- The intervals in `upperLimitBasis` form a basis for `upperLimit`. -/
theorem upperLimitBasis_isTopologicalBasis :
    TopologicalSpace.IsTopologicalBasis upperLimitBasis := by
  -- Half-open intervals refine intersections and cover every real point.
  refine TopologicalSpace.IsTopologicalBasis.mk ?_ ?_ upperLimit_eq_generateFrom
  · intro s hs t ht x hx
    obtain ⟨a, b, hab, rfl⟩ := (mem_upperLimitBasis_iff s).mp hs
    obtain ⟨c, d, hcd, rfl⟩ := (mem_upperLimitBasis_iff t).mp ht
    have hLower : max a c < x := max_lt hx.1.1 hx.2.1
    have hUpper : x ≤ min b d := le_min hx.1.2 hx.2.2
    have hBounds : max a c < min b d := hLower.trans_le hUpper
    refine ⟨Ioc (max a c) (min b d), ?_, ⟨hLower, hUpper⟩, ?_⟩
    · exact (mem_upperLimitBasis_iff _).mpr ⟨max a c, min b d, hBounds, rfl⟩
    · intro y hy
      exact ⟨⟨(le_max_left _ _).trans_lt hy.1, hy.2.trans (min_le_left _ _)⟩,
        ⟨(le_max_right _ _).trans_lt hy.1, hy.2.trans (min_le_right _ _)⟩⟩
  · apply Set.eq_univ_of_forall
    intro x
    apply Set.mem_sUnion_of_mem (t := Ioc (x - 1) x)
    · exact ⟨sub_lt_self x zero_lt_one, le_rfl⟩
    · exact (mem_upperLimitBasis_iff _).mpr ⟨x - 1, x, sub_lt_self x zero_lt_one, rfl⟩

end RealTopology
