public import Mathlib.Topology.Homeomorph.Lemmas

universe u

public section

open Set Filter Function Topology
open scoped Pointwise

namespace IsTopologicalGroup

/-- Helper for Remark 41.3: a symmetric set containing `1` generates the union of its finite
powers. -/
lemma closure_eq_iUnion_pow_of_one_mem_inv {G : Type u} [Group G] (s : Set G)
    (_hone : 1 ∈ s) (hinv : s⁻¹ = s) :
    (Subgroup.closure s : Set G) = ⋃ n : ℕ, s ^ n := by
  -- Closure induction records a finite word length for each generated element.
  ext x
  constructor
  · intro hx
    induction hx using Subgroup.closure_induction with
    | mem x hx =>
        exact mem_iUnion.2 ⟨1, by simpa using hx⟩
    | one =>
        exact mem_iUnion.2 ⟨0, by simp⟩
    | mul x y _ _ hx hy =>
        obtain ⟨m, hm⟩ := mem_iUnion.1 hx
        obtain ⟨n, hn⟩ := mem_iUnion.1 hy
        refine mem_iUnion.2 ⟨m + n, ?_⟩
        rw [pow_add]
        exact ⟨x, hm, y, hn, rfl⟩
    | inv x _ hx =>
        obtain ⟨n, hn⟩ := mem_iUnion.1 hx
        refine mem_iUnion.2 ⟨n, ?_⟩
        have hxinv : x⁻¹ ∈ (s ^ n)⁻¹ := by
          exact Set.mem_inv.mpr (by simpa using hn)
        rw [← inv_pow, hinv] at hxinv
        exact hxinv
  · intro hx
    obtain ⟨n, hn⟩ := mem_iUnion.1 hx
    exact Subgroup.pow_subset Subgroup.subset_closure hn

/-- Helper for Remark 41.3: the subgroup generated by a compact identity neighborhood is
σ-compact. -/
lemma isSigmaCompact_subgroupClosure_of_isCompact_mem_nhds {G : Type u}
    [TopologicalSpace G] [Group G] [IsTopologicalGroup G] (K : Set G)
    (hK : IsCompact K) (hKnhds : K ∈ 𝓝 (1 : G)) :
    IsSigmaCompact (Subgroup.closure (K ∪ K⁻¹) : Set G) := by
  -- Symmetrization preserves compactness and makes finite powers stable under inversion.
  have honeK : (1 : G) ∈ K := mem_of_mem_nhds hKnhds
  have hone : (1 : G) ∈ K ∪ K⁻¹ := Or.inl honeK
  have hinv : (K ∪ K⁻¹)⁻¹ = K ∪ K⁻¹ := by
    simp [union_comm]
  have hcompact : IsCompact (K ∪ K⁻¹) := hK.union hK.inv
  have hcompactPow : ∀ n : ℕ, IsCompact ((K ∪ K⁻¹) ^ n) := by
    intro n
    induction n with
    | zero =>
        rw [pow_zero]
        exact isCompact_singleton
    | succ n ih =>
        rw [pow_succ]
        exact ih.mul hcompact
  rw [closure_eq_iUnion_pow_of_one_mem_inv (K ∪ K⁻¹) hone hinv]
  exact isSigmaCompact_iUnion_of_isCompact _ hcompactPow

/-- Helper for Remark 41.3: a topological sum of paracompact spaces is paracompact. -/
lemma paracompactSpace_sigma {ι : Type u} {X : ι → Type u}
    [∀ i, TopologicalSpace (X i)] [∀ i, ParacompactSpace (X i)] :
    ParacompactSpace (Σ i, X i) := by
  -- Refine the cover independently on each open summand.
  constructor
  intro α S hSopen hScovers
  have hcomponentOpen (i : ι) (a : α) : IsOpen (Sigma.mk i ⁻¹' S a) :=
    (hSopen a).preimage continuous_sigmaMk
  have hcomponentCovers (i : ι) : ⋃ a, Sigma.mk i ⁻¹' S a = univ := by
    rw [← preimage_iUnion, hScovers, preimage_univ]
  choose β T hTopen hTcovers hTfinite hTsub using fun i ↦
    ParacompactSpace.locallyFinite_refinement α (fun a ↦ Sigma.mk i ⁻¹' S a)
      (hcomponentOpen i) (hcomponentCovers i)
  refine ⟨Σ i, β i, fun b ↦ Sigma.mk b.1 '' T b.1 b.2, ?_, ?_, ?_, ?_⟩
  · intro b
    exact isOpenMap_sigmaMk _ (hTopen b.1 b.2)
  · ext x
    constructor
    · intro hx
      exact mem_univ x
    · intro _
      have hxcover : x.2 ∈ ⋃ b, T x.1 b := by
        rw [hTcovers x.1]
        exact mem_univ _
      obtain ⟨b, hb⟩ := mem_iUnion.1 hxcover
      exact mem_iUnion.2 ⟨⟨x.1, b⟩, ⟨x.2, hb, rfl⟩⟩
  · rintro ⟨i, x⟩
    obtain ⟨U, hU, hUfinite⟩ := hTfinite i x
    obtain ⟨V, hVU, hVopen, hxV⟩ := mem_nhds_iff.mp hU
    refine ⟨Sigma.mk i '' V, ?_, ?_⟩
    · exact ((isOpenMap_sigmaMk : IsOpenMap (@Sigma.mk ι X i)) V hVopen).mem_nhds
        ⟨x, hxV, rfl⟩
    have hsubset :
        {b : Σ j, β j | ((Sigma.mk b.1 '' T b.1 b.2) ∩ Sigma.mk i '' V).Nonempty} ⊆
          Sigma.mk i '' {b : β i | ((T i b) ∩ U).Nonempty} := by
      rintro ⟨j, b⟩ ⟨z, ⟨y, hy, rfl⟩, w, hw, hzw⟩
      cases hzw
      exact ⟨b, ⟨y, hy, hVU hw⟩, rfl⟩
    exact (hUfinite.image (Sigma.mk i)).subset hsubset
  · rintro ⟨i, b⟩
    obtain ⟨a, hsub⟩ := hTsub i b
    refine ⟨a, ?_⟩
    rintro _ ⟨x, hx, rfl⟩
    exact hsub hx

/-- Helper for Remark 41.3: the canonical map from the sum of the left cosets of an open subgroup
to the ambient group is bijective. -/
lemma sigmaLeftCoset_bijective {G : Type u} [Group G] (H : Subgroup G) :
    Bijective (fun x : Σ q : G ⧸ H, (q.out • (H : Set G) : Set G) ↦ (x.2 : G)) := by
  -- Each element belongs to the coset indexed by its quotient class, and that index is unique.
  constructor
  · rintro ⟨q, x, hx⟩ ⟨r, y, hy⟩ hxy
    have hq : q = QuotientGroup.mk x := by
      rw [← QuotientGroup.out_eq' q]
      exact QuotientGroup.eq.mpr ((mem_leftCoset_iff q.out).mp hx)
    have hr : r = QuotientGroup.mk y := by
      rw [← QuotientGroup.out_eq' r]
      exact QuotientGroup.eq.mpr ((mem_leftCoset_iff r.out).mp hy)
    change x = y at hxy
    subst y
    have hqr : q = r := hq.trans hr.symm
    cases hqr
    rfl
  · intro x
    let q : G ⧸ H := QuotientGroup.mk x
    have hx : x ∈ q.out • (H : Set G) := by
      rw [mem_leftCoset_iff]
      exact QuotientGroup.eq.mp (QuotientGroup.out_eq' q)
    exact ⟨⟨q, x, hx⟩, rfl⟩

/-- Helper for Remark 41.3: the canonical map from the sum of the left cosets of an open subgroup
to the ambient group is continuous. -/
lemma continuous_sigmaLeftCoset {G : Type u} [TopologicalSpace G] [Group G]
    (H : Subgroup G) :
    Continuous (fun x : Σ q : G ⧸ H, (q.out • (H : Set G) : Set G) ↦ (x.2 : G)) := by
  -- On every summand the map is simply the continuous subtype inclusion.
  exact continuous_sigma fun _ ↦ continuous_subtype_val

/-- Helper for Remark 41.3: the canonical map from the sum of the left cosets of an open subgroup
to the ambient group is open. -/
lemma isOpenMap_sigmaLeftCoset {G : Type u} [TopologicalSpace G] [Group G]
    [IsTopologicalGroup G] (H : Subgroup G) (hH : IsOpen (H : Set G)) :
    IsOpenMap (fun x : Σ q : G ⧸ H, (q.out • (H : Set G) : Set G) ↦ (x.2 : G)) := by
  -- An open set is the union of its open images in the open coset summands.
  intro U hU
  have hcosetOpen (q : G ⧸ H) : IsOpen (q.out • (H : Set G)) := by
    exact (Homeomorph.mulLeft q.out).isOpenMap _ hH
  have hbranchOpen (q : G ⧸ H) : IsOpen (Sigma.mk q ⁻¹' U) :=
    isOpen_sigma_iff.mp hU q
  rw [show (fun x : Σ q : G ⧸ H, (q.out • (H : Set G) : Set G) ↦ (x.2 : G)) '' U =
      ⋃ q : G ⧸ H, ((fun x : (q.out • (H : Set G) : Set G) ↦ (x : G)) ''
        ((@Sigma.mk (G ⧸ H) (fun q ↦ (q.out • (H : Set G) : Set G)) q) ⁻¹' U)) by
    ext x
    constructor
    · rintro ⟨⟨q, y⟩, hy, rfl⟩
      exact mem_iUnion.2 ⟨q, ⟨y, hy, rfl⟩⟩
    · rintro hx
      obtain ⟨q, y, hy, rfl⟩ := mem_iUnion.1 hx
      exact ⟨⟨q, y⟩, hy, rfl⟩]
  exact isOpen_iUnion fun q ↦ (hcosetOpen q).isOpenMap_subtype_val _ (hbranchOpen q)

/-- Helper for Remark 41.3: an open subgroup decomposes the ambient group as the topological sum
of its left cosets. -/
noncomputable def sigmaLeftCosetHomeomorph {G : Type u} [TopologicalSpace G] [Group G]
    [IsTopologicalGroup G] (H : Subgroup G) (hH : IsOpen (H : Set G)) :
    (Σ q : G ⧸ H, (q.out • (H : Set G) : Set G)) ≃ₜ G :=
  (Equiv.ofBijective _ (sigmaLeftCoset_bijective H)).toHomeomorphOfContinuousOpen
    (continuous_sigmaLeftCoset H) (isOpenMap_sigmaLeftCoset H hH)

end IsTopologicalGroup
