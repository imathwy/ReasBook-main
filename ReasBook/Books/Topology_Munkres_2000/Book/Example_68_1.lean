module

public import Topology_Munkres_2000.Book.Definition_68_3.FreeProduct
public import Mathlib.SetTheory.Cardinal.Finite
public import Mathlib.Data.ZMod.QuotientGroup
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.Perm.ClosureSwap
public import Mathlib.GroupTheory.Perm.Sign

public section

open scoped Subgroup.FreeProduct

/-- The adjacent transposition indexed by `i : Fin 2` in the permutation group of `Fin 3`. -/
def fin3AdjacentSwap (i : Fin 2) : Equiv.Perm (Fin 3) :=
  Equiv.swap i.castSucc i.succ

/-- The subgroup generated by the adjacent transposition indexed by `i : Fin 2`. -/
def fin3AdjacentSubgroup (i : Fin 2) : Subgroup (Equiv.Perm (Fin 3)) :=
  Subgroup.zpowers (fin3AdjacentSwap i)

/-- Helper for Example 68.1: an adjacent transposition of `Fin 3` is nonidentity. -/
lemma fin3AdjacentSwap_ne_one (i : Fin 2) : fin3AdjacentSwap i ≠ 1 := by
  -- Equality with the identity would force the two adjacent points to coincide.
  intro h
  have heq : i.castSucc = i.succ := Equiv.swap_eq_one_iff.mp h
  exact (Fin.ne_of_lt Fin.castSucc_lt_succ) heq

/-- Helper for Example 68.1: every adjacent transposition of `Fin 3` has order two. -/
lemma fin3AdjacentSwap_orderOf (i : Fin 2) : orderOf (fin3AdjacentSwap i) = 2 := by
  -- The swap is a nontrivial involution, so its prime order is exactly two.
  apply orderOf_eq_prime
  · unfold fin3AdjacentSwap
    simpa only [pow_two] using Equiv.swap_mul_self i.castSucc i.succ
  · exact fin3AdjacentSwap_ne_one i

/-- Helper for Example 68.1: membership in an adjacent cyclic subgroup has a two-element
normal form. -/
lemma mem_fin3AdjacentSubgroup_iff (i : Fin 2) (x : Equiv.Perm (Fin 3)) :
    x ∈ fin3AdjacentSubgroup i ↔ x = 1 ∨ x = fin3AdjacentSwap i := by
  -- Enumerate the powers below the order of the generator.
  unfold fin3AdjacentSubgroup
  rw [mem_zpowers_iff_mem_range_orderOf, fin3AdjacentSwap_orderOf]
  simp only [Finset.mem_image, Finset.mem_range, Nat.lt_succ_iff,
    Nat.le_one_iff_eq_zero_or_eq_one]
  constructor
  · rintro ⟨a, ha, rfl⟩
    rcases ha with rfl | rfl
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨0, Or.inl rfl, rfl⟩
    · exact ⟨1, Or.inr rfl, rfl⟩

/-- Helper for Example 68.1: the two adjacent swaps of `Fin 3` are distinct. -/
lemma fin3AdjacentSwap_zero_ne_one : fin3AdjacentSwap 0 ≠ fin3AdjacentSwap 1 := by
  -- The finite computation compares their action on the three points.
  decide

/-- Helper for Example 68.1: the adjacent-swap indexing map is injective. -/
lemma fin3AdjacentSwap_injective : Function.Injective fin3AdjacentSwap := by
  -- There are only the two adjacent swaps, already known to be distinct.
  intro i j h
  fin_cases i <;> fin_cases j
  · rfl
  · exact (fin3AdjacentSwap_zero_ne_one h).elim
  · exact (fin3AdjacentSwap_zero_ne_one h.symm).elim
  · rfl

/-- Helper for Example 68.1: distinct adjacent cyclic subgroups intersect trivially. -/
lemma fin3AdjacentSubgroup_pairwise_disjoint :
    Pairwise (fun i j : Fin 2 ↦ Disjoint (fin3AdjacentSubgroup i) (fin3AdjacentSubgroup j)) := by
  -- Reduce common membership to the two-element normal forms in both cyclic subgroups.
  intro i j hij
  rw [Subgroup.disjoint_def]
  intro x hxi hxj
  rw [mem_fin3AdjacentSubgroup_iff] at hxi hxj
  rcases hxi with rfl | hxi
  · rfl
  rcases hxj with rfl | hxj
  · rfl
  exfalso
  apply hij
  apply fin3AdjacentSwap_injective
  exact hxi.symm.trans hxj

/-- Helper for Example 68.1: every letter in an alternating adjacent-swap triple belongs to
one of the generated cyclic subgroups. -/
lemma fin3AlternatingTriple_mem (i j : Fin 2) :
    ∀ x ∈ [fin3AdjacentSwap i, fin3AdjacentSwap j, fin3AdjacentSwap i],
      ∃ k, x ∈ fin3AdjacentSubgroup k := by
  -- Inspect the three possible positions and use generator membership.
  intro x hx
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl
  · exact ⟨i, Subgroup.mem_zpowers _⟩
  · exact ⟨j, Subgroup.mem_zpowers _⟩
  · exact ⟨i, Subgroup.mem_zpowers _⟩

/-- Helper for Example 68.1: every letter in an alternating adjacent-swap triple is
nonidentity. -/
lemma fin3AlternatingTriple_ne_one (i j : Fin 2) :
    ∀ x ∈ [fin3AdjacentSwap i, fin3AdjacentSwap j, fin3AdjacentSwap i], x ≠ 1 := by
  -- Inspect the three possible positions and use nontriviality of each swap.
  intro x hx
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl
  · exact fin3AdjacentSwap_ne_one i
  · exact fin3AdjacentSwap_ne_one j
  · exact fin3AdjacentSwap_ne_one i

/-- Helper for Example 68.1: two distinct adjacent swaps cannot lie in one adjacent cyclic
subgroup. -/
lemma fin3AdjacentSwaps_separated {i j : Fin 2} (hij : i ≠ j) :
    ∀ k, ¬ (fin3AdjacentSwap i ∈ fin3AdjacentSubgroup k ∧
      fin3AdjacentSwap j ∈ fin3AdjacentSubgroup k) := by
  -- The membership normal form forces both letters to equal the same generator.
  intro k h
  rcases h with ⟨hik, hjk⟩
  rw [mem_fin3AdjacentSubgroup_iff] at hik hjk
  rcases hik with hik | hik
  · exact fin3AdjacentSwap_ne_one i hik
  rcases hjk with hjk | hjk
  · exact fin3AdjacentSwap_ne_one j hjk
  apply hij
  apply fin3AdjacentSwap_injective
  exact hik.trans hjk.symm

/-- Helper for Example 68.1: a singleton adjacent-swap list satisfies every chain relation. -/
lemma fin3AdjacentSwap_singleton_chain (i : Fin 2) :
    [fin3AdjacentSwap i].IsChain
      (fun x y ↦ ∀ k, ¬ (x ∈ fin3AdjacentSubgroup k ∧ y ∈ fin3AdjacentSubgroup k)) := by
  -- A singleton list has no adjacent pair to check.
  simp

/-- Helper for Example 68.1: an alternating triple of distinct adjacent swaps satisfies the
reduced-word chain condition. -/
lemma fin3AlternatingTriple_chain {i j : Fin 2} (hij : i ≠ j) :
    [fin3AdjacentSwap i, fin3AdjacentSwap j, fin3AdjacentSwap i].IsChain
      (fun x y ↦ ∀ k, ¬ (x ∈ fin3AdjacentSubgroup k ∧ y ∈ fin3AdjacentSubgroup k)) := by
  -- Verify the two adjacent pairs and finish with the singleton tail.
  rw [List.isChain_cons_cons, List.isChain_cons_cons]
  exact ⟨fin3AdjacentSwaps_separated hij, fin3AdjacentSwaps_separated hij.symm,
    fin3AdjacentSwap_singleton_chain i⟩

/-- Helper for Example 68.1: the two indices of adjacent transpositions are distinct. -/
lemma fin3Index_zero_ne_one : (0 : Fin 2) ≠ 1 := by
  -- The finite index values are definitionally different.
  decide

/-- Helper for Example 68.1: the second adjacent-transposition index differs from the first. -/
lemma fin3Index_one_ne_zero : (1 : Fin 2) ≠ 0 := by
  -- Reverse the already established inequality.
  exact fin3Index_zero_ne_one.symm

/-- The explicit reduced word formed by the first, second, and first adjacent transpositions. -/
def fin3LeftRightLeft : Subgroup.ReducedWord fin3AdjacentSubgroup :=
  Subgroup.ReducedWord.ofList fin3AdjacentSubgroup
    [fin3AdjacentSwap 0, fin3AdjacentSwap 1, fin3AdjacentSwap 0]
    (fin3AlternatingTriple_mem 0 1) (fin3AlternatingTriple_ne_one 0 1)
    (fin3AlternatingTriple_chain fin3Index_zero_ne_one)

/-- The explicit reduced word formed by the second, first, and second adjacent transpositions. -/
def fin3RightLeftRight : Subgroup.ReducedWord fin3AdjacentSubgroup :=
  Subgroup.ReducedWord.ofList fin3AdjacentSubgroup
    [fin3AdjacentSwap 1, fin3AdjacentSwap 0, fin3AdjacentSwap 1]
    (fin3AlternatingTriple_mem 1 0) (fin3AlternatingTriple_ne_one 1 0)
    (fin3AlternatingTriple_chain fin3Index_one_ne_zero)

/-- Example 68.1 (1): Each adjacent transposition generates a subgroup of order two. -/
theorem fin3AdjacentSubgroup_card (i : Fin 2) : Nat.card (fin3AdjacentSubgroup i) = 2 := by
  -- Cardinality of a cyclic subgroup equals the order of its generator.
  rw [fin3AdjacentSubgroup, Nat.card_zpowers, fin3AdjacentSwap_orderOf]

/-- Helper for Example 68.1: the transposition of `0` and `1` lies in the generated supremum. -/
lemma fin3Swap_zero_one_mem :
    Equiv.swap (0 : Fin 3) 1 ∈ ⨆ i, fin3AdjacentSubgroup i := by
  -- This is the generator of the first adjacent cyclic subgroup.
  exact Subgroup.mem_iSup_of_mem 0 (Subgroup.mem_zpowers _)

/-- Helper for Example 68.1: the transposition of `1` and `2` lies in the generated supremum. -/
lemma fin3Swap_one_two_mem :
    Equiv.swap (1 : Fin 3) 2 ∈ ⨆ i, fin3AdjacentSubgroup i := by
  -- This is the generator of the second adjacent cyclic subgroup.
  exact Subgroup.mem_iSup_of_mem 1 (Subgroup.mem_zpowers _)

/-- Helper for Example 68.1: the transposition of `0` and `2` lies in the generated supremum. -/
lemma fin3Swap_zero_two_mem :
    Equiv.swap (0 : Fin 3) 2 ∈ ⨆ i, fin3AdjacentSubgroup i := by
  -- Compose the two adjacent transpositions through the intermediate point `1`.
  exact SubmonoidClass.swap_mem_trans (⨆ i, fin3AdjacentSubgroup i)
    fin3Swap_zero_one_mem fin3Swap_one_two_mem

/-- Example 68.1 (2): The two adjacent-transposition subgroups generate every permutation of
`Fin 3`. -/
theorem fin3AdjacentSubgroup_iSup_eq_top : ⨆ i, fin3AdjacentSubgroup i = ⊤ := by
  -- Transpositions generate the full finite symmetric group, so it suffices to contain each swap.
  rw [eq_top_iff, ← Equiv.Perm.closure_isSwap, Subgroup.closure_le]
  intro σ hσ
  rcases hσ with ⟨a, b, hab, rfl⟩
  fin_cases a <;> fin_cases b
  · exact (hab rfl).elim
  · exact fin3Swap_zero_one_mem
  · exact fin3Swap_zero_two_mem
  · rw [Equiv.swap_comm]
    exact fin3Swap_zero_one_mem
  · exact (hab rfl).elim
  · exact fin3Swap_one_two_mem
  · rw [Equiv.swap_comm]
    exact fin3Swap_zero_two_mem
  · rw [Equiv.swap_comm]
    exact fin3Swap_one_two_mem
  · exact (hab rfl).elim

/-- Helper for Example 68.1: the two alternating products of adjacent swaps are equal. -/
lemma fin3AdjacentSwap_braid :
    fin3AdjacentSwap 0 * fin3AdjacentSwap 1 * fin3AdjacentSwap 0 =
      fin3AdjacentSwap 1 * fin3AdjacentSwap 0 * fin3AdjacentSwap 1 := by
  -- Evaluate the two permutations on the finite set `Fin 3`.
  decide

/-- Example 68.1 (3): The permutation group of `Fin 3` is not the internal free product of its
two adjacent-transposition subgroups. -/
theorem fin3AdjacentSubgroup_not_isFreeProduct :
    ¬ (Equiv.Perm (Fin 3) = *ᵢ fin3AdjacentSubgroup) := by
  -- Equal evaluated products would force the two reduced words themselves to coincide.
  intro hfree
  have hprod : fin3LeftRightLeft.prod = fin3RightLeftRight.prod := by
    rw [Subgroup.ReducedWord.prod_def, Subgroup.ReducedWord.prod_def]
    exact fin3AdjacentSwap_braid
  have hwords : fin3LeftRightLeft = fin3RightLeftRight := hfree.prod_bijective.1 hprod
  have hlists := congrArg Subgroup.Word.toList
    (congrArg Subgroup.ReducedWord.toWord hwords)
  have hheads : fin3AdjacentSwap 0 = fin3AdjacentSwap 1 := by
    have hlistComponents : fin3AdjacentSwap 0 = fin3AdjacentSwap 1 ∧
        fin3AdjacentSwap 1 = fin3AdjacentSwap 0 ∧
          fin3AdjacentSwap 0 = fin3AdjacentSwap 1 ∧ True := by
      simpa only [fin3LeftRightLeft, fin3RightLeftRight,
        Subgroup.ReducedWord.toList_ofList, List.cons.injEq] using hlists
    exact hlistComponents.1
  exact fin3AdjacentSwap_zero_ne_one hheads

/-- Example 68.1 (4): The two displayed alternating reduced words represent the same permutation. -/
theorem fin3_braid : fin3LeftRightLeft.prod = fin3RightLeftRight.prod := by
  -- Rewrite evaluation to the explicit lists, then apply the permutation braid relation.
  rw [Subgroup.ReducedWord.prod_def, Subgroup.ReducedWord.prod_def]
  exact fin3AdjacentSwap_braid
