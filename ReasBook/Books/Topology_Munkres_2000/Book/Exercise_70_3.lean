module

public import Topology_Munkres_2000.Book.Theorem_70_2
import Topology_Munkres_2000.Book.Theorem_70_1.Pushout
public import Mathlib.GroupTheory.FinitelyPresentedGroup

public section

universe u

open CategoryTheory

/- Exercise 70.3 (1): The free product of finitely presented groups is finitely presented. -/
#check Group.IsFinitelyPresented.instCoprod

/-- Helper for Exercise 70.3: a defect `(f x)⁻¹ * g x` lies in a normal subgroup exactly
when `f` and `g` have the same value at `x` after passage to the quotient. -/
private lemma inv_mul_mem_iff_quotient_comp_eq {G H : Type*} [Group G] [Group H]
    (N : Subgroup H) [N.Normal] (f g : G →* H) (x : G) :
    (f x)⁻¹ * g x ∈ N ↔
      ((QuotientGroup.mk' N).comp f) x = ((QuotientGroup.mk' N).comp g) x := by
  -- Turn subgroup membership into an equation and normalize the quotient homomorphism.
  rw [← QuotientGroup.eq_one_iff]
  simp only [QuotientGroup.mk_mul, QuotientGroup.mk_inv, MonoidHom.comp_apply,
    inv_mul_eq_one, QuotientGroup.mk'_apply]

/-- Helper for Exercise 70.3: defects indexed by a generating set normally generate all
defects between two group homomorphisms. -/
private lemma normalClosure_invMul_image_eq_range {G H : Type*} [Group G] [Group H]
    (f g : G →* H) (S : Set G) (hS : Subgroup.closure S = ⊤) :
    Subgroup.normalClosure ((fun x ↦ (f x)⁻¹ * g x) '' S) =
      Subgroup.normalClosure (Set.range fun x ↦ (f x)⁻¹ * g x) := by
  -- The generator-indexed defects are among all defects, giving the forward inclusion.
  apply le_antisymm
  · exact Subgroup.normalClosure_mono (Set.image_subset_range _ _)
  -- In the quotient by the generator defects, the two homomorphisms agree on the generators.
  · apply Subgroup.normalClosure_le_normal
    rintro _ ⟨x, rfl⟩
    apply (inv_mul_mem_iff_quotient_comp_eq _ f g x).mpr
    apply MonoidHom.eqOn_closure
    · intro y hy
      exact (inv_mul_mem_iff_quotient_comp_eq _ f g y).mp
        (Subgroup.subset_normalClosure ⟨y, hy, rfl⟩)
    · rw [hS]
      exact trivial

/-- Helper for Exercise 70.3: the kernel of the map from a free product to a group
pushout is normally generated by the defects of the two maps from the common group. -/
private lemma ker_eq_normalClosure_invMul_range_of_isPushout
    {A B D P : Type u} [Group A] [Group B] [Group D] [Group P]
    (left : D →* A) (right : D →* B) (toPLeft : A →* P) (toPRight : B →* P)
    (pushout : CategoryTheory.IsPushout (GrpCat.ofHom left) (GrpCat.ofHom right)
      (GrpCat.ofHom toPLeft) (GrpCat.ofHom toPRight))
    (coprodToP : Monoid.Coprod A B →* P)
    (hcoprodLeft : coprodToP.comp Monoid.Coprod.inl = toPLeft)
    (hcoprodRight : coprodToP.comp Monoid.Coprod.inr = toPRight) :
    coprodToP.ker = Subgroup.normalClosure
      (Set.range fun x ↦
        ((Monoid.Coprod.inl.comp left) x)⁻¹ * (Monoid.Coprod.inr.comp right) x) := by
  classical
  let N : Subgroup (Monoid.Coprod A B) := Subgroup.normalClosure
    (Set.range fun x ↦
      ((Monoid.Coprod.inl.comp left) x)⁻¹ * (Monoid.Coprod.inr.comp right) x)
  let quotientLeft := (QuotientGroup.mk' N).comp Monoid.Coprod.inl
  let quotientRight := (QuotientGroup.mk' N).comp Monoid.Coprod.inr
  -- The pushout square first identifies the two maps into `P`.
  have hmaps : toPLeft.comp left = toPRight.comp right := by
    have hmapsCategory := congrArg GrpCat.Hom.hom pushout.w
    simpa only [GrpCat.hom_comp, GrpCat.hom_ofHom] using hmapsCategory
  -- Modulo the normal closure of the defects, the coproduct inclusions are compatible.
  have hquotient : quotientLeft.comp left = quotientRight.comp right := by
    rw [MonoidHom.comp_assoc, MonoidHom.comp_assoc]
    apply MonoidHom.ext
    intro x
    exact (inv_mul_mem_iff_quotient_comp_eq N
      (Monoid.Coprod.inl.comp left) (Monoid.Coprod.inr.comp right) x).mp
      (Subgroup.subset_normalClosure ⟨x, rfl⟩)
  have hquotientCategory :
      GrpCat.ofHom left ≫ GrpCat.ofHom quotientLeft =
        GrpCat.ofHom right ≫ GrpCat.ofHom quotientRight := by
    rw [← GrpCat.ofHom_comp, ← GrpCat.ofHom_comp]
    exact congrArg GrpCat.ofHom hquotient
  let inverse : P →* Monoid.Coprod A B ⧸ N :=
    (pushout.desc (GrpCat.ofHom quotientLeft) (GrpCat.ofHom quotientRight)
      hquotientCategory).hom
  have hinverseLeft : inverse.comp toPLeft = quotientLeft := by
    apply GrpCat.ofHom_injective
    simpa only [GrpCat.ofHom_comp, GrpCat.ofHom_hom, inverse] using
      pushout.inl_desc (GrpCat.ofHom quotientLeft) (GrpCat.ofHom quotientRight)
        hquotientCategory
  have hinverseRight : inverse.comp toPRight = quotientRight := by
    apply GrpCat.ofHom_injective
    simpa only [GrpCat.ofHom_comp, GrpCat.ofHom_hom, inverse] using
      pushout.inr_desc (GrpCat.ofHom quotientLeft) (GrpCat.ofHom quotientRight)
        hquotientCategory
  -- Every defining defect is killed by the coproduct map.
  have hnormalClosure_le : N ≤ coprodToP.ker := by
    apply Subgroup.normalClosure_le_normal
    rintro _ ⟨x, rfl⟩
    have hleftValue := DFunLike.congr_fun hcoprodLeft (left x)
    have hrightValue := DFunLike.congr_fun hcoprodRight (right x)
    have hmapsValue := DFunLike.congr_fun hmaps x
    simp only [MonoidHom.comp_apply] at hleftValue hrightValue hmapsValue
    apply MonoidHom.mem_ker.mpr
    simp only [MonoidHom.comp_apply]
    rw [map_mul, map_inv, hleftValue, hrightValue, inv_mul_eq_one]
    exact hmapsValue
  -- The pushout-induced inverse shows that no further element lies in the kernel.
  have hinverseComp : inverse.comp coprodToP = QuotientGroup.mk' N := by
    apply Monoid.Coprod.hom_ext
    · rw [MonoidHom.comp_assoc, hcoprodLeft, hinverseLeft]
    · rw [MonoidHom.comp_assoc, hcoprodRight, hinverseRight]
  have hker_le : coprodToP.ker ≤ N := by
    intro x hx
    apply (QuotientGroup.eq_one_iff x).mp
    have hcoprodValue : coprodToP x = 1 := MonoidHom.mem_ker.mp hx
    have hinverseValue := DFunLike.congr_fun hinverseComp x
    calc
      (x : Monoid.Coprod A B ⧸ N) = (QuotientGroup.mk' N) x :=
        (QuotientGroup.mk'_apply N x).symm
      _ = inverse (coprodToP x) := hinverseValue.symm
      _ = inverse 1 := congrArg inverse hcoprodValue
      _ = 1 := map_one inverse
  exact le_antisymm hker_le hnormalClosure_le

/-- Helper for Exercise 70.3: the inclusion-induced map from `π₁(U ∩ V, x₀)` to
`π₁(U, x₀)`. -/
private noncomputable def vanKampenLeftIntersectionMap {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V) :
    FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩ →*
      FundamentalGroup U ⟨x₀, hx₀.1⟩ :=
  FundamentalGroup.mapOfSubset Set.inter_subset_left ⟨x₀, hx₀⟩

/-- Helper for Exercise 70.3: the inclusion-induced map from `π₁(U ∩ V, x₀)` to
`π₁(V, x₀)`. -/
private noncomputable def vanKampenRightIntersectionMap {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V) :
    FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩ →*
      FundamentalGroup V ⟨x₀, hx₀.2⟩ :=
  FundamentalGroup.mapOfSubset Set.inter_subset_right ⟨x₀, hx₀⟩

/-- Helper for Exercise 70.3: the left intersection map followed by the left free-product
inclusion. -/
private noncomputable def vanKampenLeftCoprodMap {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V) :
    FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩ →*
      Monoid.Coprod (FundamentalGroup U ⟨x₀, hx₀.1⟩)
        (FundamentalGroup V ⟨x₀, hx₀.2⟩) :=
  Monoid.Coprod.inl.comp (vanKampenLeftIntersectionMap U V x₀ hx₀)

/-- Helper for Exercise 70.3: the right intersection map followed by the right free-product
inclusion. -/
private noncomputable def vanKampenRightCoprodMap {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V) :
    FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩ →*
      Monoid.Coprod (FundamentalGroup U ⟨x₀, hx₀.1⟩)
        (FundamentalGroup V ⟨x₀, hx₀.2⟩) :=
  Monoid.Coprod.inr.comp (vanKampenRightIntersectionMap U V x₀ hx₀)

/-- Helper for Exercise 70.3: the two named intersection maps and the two ambient
inclusion maps form the van Kampen pushout square. -/
private lemma vanKampenIntersectionMaps_isPushout {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace (U ∩ V : Set X)] :
    CategoryTheory.IsPushout
      (GrpCat.ofHom (vanKampenLeftIntersectionMap U V x₀ hx₀))
      (GrpCat.ofHom (vanKampenRightIntersectionMap U V x₀ hx₀))
      (GrpCat.ofHom (FundamentalGroup.mapOfSubtype U ⟨x₀, hx₀.1⟩))
      (GrpCat.ofHom (FundamentalGroup.mapOfSubtype V ⟨x₀, hx₀.2⟩)) := by
  -- Rewrite the imported square through the exposed computation rule for subset maps.
  simpa only [vanKampenLeftIntersectionMap, vanKampenRightIntersectionMap,
    FundamentalGroup.mapOfSubset_eq_map_inclusion] using
    FundamentalGroup.isPushoutOfOpenUnion U V x₀ hx₀ hU hV hcover

/-- Helper for Exercise 70.3: the explicit free-product defect associated to a loop in
`U ∩ V` compares its images in `U` and `V`. -/
private noncomputable def vanKampenDefect {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (g : FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩) :
    Monoid.Coprod (FundamentalGroup U ⟨x₀, hx₀.1⟩)
      (FundamentalGroup V ⟨x₀, hx₀.2⟩) :=
  (vanKampenLeftCoprodMap U V x₀ hx₀ g)⁻¹ *
    vanKampenRightCoprodMap U V x₀ hx₀ g

/-- Helper for Exercise 70.3: the kernel of the canonical van Kampen map is the normal
closure of the explicit free-product defects. -/
private lemma vanKampenMap_ker_eq_normalClosure_defects {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace (U ∩ V : Set X)] :
    (FundamentalGroup.vanKampenMap U V x₀ hx₀).ker =
      Subgroup.normalClosure (Set.range (vanKampenDefect U V x₀ hx₀)) := by
  -- The named intersection maps make the pushout kernel formula syntactically stable.
  unfold vanKampenDefect vanKampenLeftCoprodMap vanKampenRightCoprodMap
  simpa only using
    ker_eq_normalClosure_invMul_range_of_isPushout
      (vanKampenLeftIntersectionMap U V x₀ hx₀)
      (vanKampenRightIntersectionMap U V x₀ hx₀)
      (FundamentalGroup.mapOfSubtype U ⟨x₀, hx₀.1⟩)
      (FundamentalGroup.mapOfSubtype V ⟨x₀, hx₀.2⟩)
      (vanKampenIntersectionMaps_isPushout U V x₀ hx₀ hU hV hcover)
      (FundamentalGroup.vanKampenMap U V x₀ hx₀)
      (FundamentalGroup.vanKampenMap_comp_inl U V x₀ hx₀)
      (FundamentalGroup.vanKampenMap_comp_inr U V x₀ hx₀)

/-- Helper for Exercise 70.3: defects indexed by generators of `π₁(U ∩ V, x₀)` have
the same normal closure as all van Kampen defects. -/
private lemma normalClosure_vanKampenDefect_image_eq_range
    {X : Type u} [TopologicalSpace X] (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (S : Set (FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩))
    (hS : Subgroup.closure S = ⊤) :
    Subgroup.normalClosure (vanKampenDefect U V x₀ hx₀ '' S) =
      Subgroup.normalClosure (Set.range (vanKampenDefect U V x₀ hx₀)) := by
  -- Both sides now use the same named intersection maps.
  unfold vanKampenDefect
  simpa only using
    normalClosure_invMul_image_eq_range
      (vanKampenLeftCoprodMap U V x₀ hx₀)
      (vanKampenRightCoprodMap U V x₀ hx₀)
      S hS

/-- Exercise 70.3: Under the Seifert–van Kampen hypotheses, finite generation of the
fundamental group of `U ∩ V` implies that the kernel of the canonical free-product
homomorphism is finitely normally generated. -/
theorem vanKampenMap_ker_isFinitelyNormallyGenerated {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace U] [PathConnectedSpace V]
    [PathConnectedSpace (U ∩ V : Set X)]
    [Group.FG (FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩)] :
    (FundamentalGroup.vanKampenMap U V x₀ hx₀).ker.IsFinitelyNormallyGenerated := by
  -- Choose finitely many loops generating the intersection fundamental group.
  obtain ⟨S, hSclosure, hSfinite⟩ :=
    Group.fg_iff.mp (inferInstance : Group.FG (FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩))
  -- Their van Kampen defects form the desired finite set of normal generators.
  refine ⟨vanKampenDefect U V x₀ hx₀ '' S, hSfinite.image _, ?_⟩
  rw [vanKampenMap_ker_eq_normalClosure_defects U V x₀ hx₀ hU hV hcover]
  exact normalClosure_vanKampenDefect_image_eq_range U V x₀ hx₀ S hSclosure

/-- Helper for Exercise 70.3: If `X = U ∪ V`, where `U`, `V`, and `U ∩ V` are path
connected open sets containing `x₀`, and the fundamental group of `U ∩ V` is finitely
generated while the fundamental groups of `U` and `V` are finitely presented, then the
fundamental group of `X` is finitely presented. -/
theorem fundamentalGroupIsFinitelyPresentedOfOpenUnion {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace U] [PathConnectedSpace V]
    [PathConnectedSpace (U ∩ V : Set X)]
    [Group.FG (FundamentalGroup (U ∩ V : Set X) ⟨x₀, hx₀⟩)]
    [Group.IsFinitelyPresented (FundamentalGroup U ⟨x₀, hx₀.1⟩)]
    [Group.IsFinitelyPresented (FundamentalGroup V ⟨x₀, hx₀.2⟩)] :
    Group.IsFinitelyPresented (FundamentalGroup X x₀) :=
  Group.IsFinitelyPresented.of_surjective (FundamentalGroup.vanKampenMap U V x₀ hx₀)
    (vanKampenMap_surjective U V x₀ hx₀ hU hV hcover)
    (vanKampenMap_ker_isFinitelyNormallyGenerated U V x₀ hx₀ hU hV hcover)
