module

public import Topology_Munkres_2000.Book.Example_74_8.TorusCollarRadial

public section

universe u v w

namespace Relation

/-- Helper for Example 74.8: the equivalence relation generated by the graph of two
injective maps into opposite summands has only equality and one graph edge in either
direction. -/
lemma eqvGen_sumGraph_iff_of_injective {A : Type u} {X : Type v} {Y : Type w}
    (g : A → X) (f : A → Y) (hg : Function.Injective g)
    (hf : Function.Injective f) (x y : X ⊕ Y) :
    Relation.EqvGen
        (fun p q ↦ ∃ a : A, p = Sum.inl (g a) ∧ q = Sum.inr (f a)) x y ↔
      x = y ∨
        (∃ a : A, x = Sum.inl (g a) ∧ y = Sum.inr (f a)) ∨
        ∃ a : A, y = Sum.inl (g a) ∧ x = Sum.inr (f a) := by
  constructor
  · intro hxy
    -- The two injectivities collapse the only composable forward/reverse graph pairs.
    induction hxy with
    | rel x y hxy =>
        exact Or.inr (Or.inl hxy)
    | refl x =>
        exact Or.inl rfl
    | symm x y hxy ih =>
        rcases ih with hxy | hxy | hxy
        · exact Or.inl hxy.symm
        · exact Or.inr (Or.inr hxy)
        · exact Or.inr (Or.inl hxy)
    | trans x y z hxy hyz ihxy ihyz =>
        rcases ihxy with hxy | hxy | hxy
        · subst y
          exact ihyz
        · rcases ihyz with hyz | hyz | hyz
          · subst z
            exact Or.inr (Or.inl hxy)
          · rcases hxy with ⟨a, hxa, hya⟩
            rcases hyz with ⟨b, hyb, hzb⟩
            cases hya.symm.trans hyb
          · rcases hxy with ⟨a, hxa, hya⟩
            rcases hyz with ⟨b, hzb, hyb⟩
            have hab : a = b := hf (Sum.inr.inj (hya.symm.trans hyb))
            subst b
            exact Or.inl (hxa.trans hzb.symm)
        · rcases ihyz with hyz | hyz | hyz
          · subst z
            exact Or.inr (Or.inr hxy)
          · rcases hxy with ⟨a, hya, hxa⟩
            rcases hyz with ⟨b, hyb, hzb⟩
            have hab : a = b := hg (Sum.inl.inj (hya.symm.trans hyb))
            subst b
            exact Or.inl (hxa.trans hzb.symm)
          · rcases hxy with ⟨a, hya, hxa⟩
            rcases hyz with ⟨b, hzb, hyb⟩
            cases hya.symm.trans hyb
  · intro hxy
    -- Equality and the two graph orientations are constructors of `EqvGen`.
    rcases hxy with hxy | hxy | hxy
    · subst y
      exact Relation.EqvGen.refl x
    · exact Relation.EqvGen.rel x y hxy
    · exact Relation.EqvGen.symm y x (Relation.EqvGen.rel y x hxy)

end Relation

namespace AdjunctionSpace

variable {X : Type u} {Y : Type v}
  [TopologicalSpace X] [TopologicalSpace Y]

/-- Helper for Example 74.8: the adjunction setoid is the equivalence closure of its
explicit attaching graph. -/
lemma setoid_eqvGen_attach_iff (A : Set X) (f : C(A, Y)) (x y : X ⊕ Y) :
    setoid A f x y ↔
      Relation.EqvGen
        (fun p q ↦ ∃ a : A, p = Sum.inl a.1 ∧ q = Sum.inr (f a)) x y := by
  -- TODO: add this directed unfolding theorem at `AdjunctionSpace`'s owner. The public
  -- definitions `setoid` and `identifies` are both opaque in downstream modules, so this
  -- bridge cannot be derived in the item-owned support module.
  sorry

/-- Helper for Example 74.8: when the attaching map is injective, the generated
adjunction relation consists only of equality and one attachment in either direction. -/
lemma setoid_iff_of_injective (A : Set X) (f : C(A, Y))
    (hf : Function.Injective f) (x y : X ⊕ Y) :
    setoid A f x y ↔
      x = y ∨
        (∃ a : A, x = Sum.inl a.1 ∧ y = Sum.inr (f a)) ∨
        ∃ a : A, y = Sum.inl a.1 ∧ x = Sum.inr (f a) := by
  -- Cross the sole opaque owner boundary, then apply the proved graph normal form with the
  -- subtype inclusion and the attaching map as the two injective legs.
  rw [setoid_eqvGen_attach_iff]
  exact Relation.eqvGen_sumGraph_iff_of_injective
    Subtype.val f Subtype.val_injective hf x y

end AdjunctionSpace

namespace ProjectivePlaneTorus

noncomputable section

/-- Helper for Example 74.8: two interval parameters are endpoint-identified exactly when
they are both endpoint-identified with one common parameter. -/
lemma exists_common_endpointSetoid_iff (s t : unitInterval) :
    (∃ r : unitInterval,
      unitInterval.endpointSetoid s r ∧ unitInterval.endpointSetoid t r) ↔
      unitInterval.endpointSetoid s t := by
  constructor
  · rintro ⟨r, hsr, htr⟩
    -- Transitivity through the common point uses symmetry on the second relation.
    exact unitInterval.endpointSetoid.trans hsr
      (unitInterval.endpointSetoid.symm htr)
  · intro hst
    -- The second parameter itself is a common representative.
    exact ⟨t, hst, unitInterval.endpointSetoid.refl t⟩

/-- Helper for Example 74.8: the inner torus-collar representative has both square
coordinates strictly between the endpoints. -/
lemma torusRadialSquarePoint_zero_mem_Ioo
    (point : DiscBoundaryGluing.BoundaryCircle) :
    (torusRadialSquarePoint point 0).1 ∈ Set.Ioo 0 1 ∧
      (torusRadialSquarePoint point 0).2 ∈ Set.Ioo 0 1 := by
  have hcoordinateNorm :
      ‖torusModelCoordinates (point : ModelPlane)‖ ≤ (1 / 8 : ℝ) := by
    -- Rewrite the proved gauge estimate through its owner-level norm formula.
    rw [← torusBoundaryGauge_eq_norm]
    exact torusBoundaryGauge_le_eighth point
  have hfirstAbs :
      |(torusModelCoordinates (point : ModelPlane)).1| ≤ (1 / 8 : ℝ) := by
    rw [← Real.norm_eq_abs]
    exact (norm_fst_le _).trans hcoordinateNorm
  have hsecondAbs :
      |(torusModelCoordinates (point : ModelPlane)).2| ≤ (1 / 8 : ℝ) := by
    rw [← Real.norm_eq_abs]
    exact (norm_snd_le _).trans hcoordinateNorm
  have hfirstOpen :
      (torusModelCoordinates (point : ModelPlane)).1 + 1 / 2 ∈
        Set.Ioo (0 : ℝ) 1 := by
    -- Translating a coordinate of absolute value at most one eighth places it strictly
    -- inside the unit interval.
    rcases (abs_le.mp hfirstAbs) with ⟨hlower, hupper⟩
    constructor <;> linarith
  have hsecondOpen :
      (torusModelCoordinates (point : ModelPlane)).2 + 1 / 2 ∈
        Set.Ioo (0 : ℝ) 1 := by
    rcases (abs_le.mp hsecondAbs) with ⟨hlower, hupper⟩
    constructor <;> linarith
  have hfirstClosed :
      (torusModelCoordinates (point : ModelPlane)).1 + 1 / 2 ∈
        Set.Icc (0 : ℝ) 1 := ⟨hfirstOpen.1.le, hfirstOpen.2.le⟩
  have hsecondClosed :
      (torusModelCoordinates (point : ModelPlane)).2 + 1 / 2 ∈
        Set.Icc (0 : ℝ) 1 := ⟨hsecondOpen.1.le, hsecondOpen.2.le⟩
  -- At radius zero the projections are inert, so the strict real inequalities lift to
  -- strict inequalities in `unitInterval`.
  rw [torusRadialSquarePoint_apply, torusRadialScale_zero, one_smul,
    Set.projIcc_of_mem zero_le_one hfirstClosed,
    Set.projIcc_of_mem zero_le_one hsecondClosed]
  exact ⟨⟨Subtype.mk_lt_mk.mpr hfirstOpen.1,
      Subtype.mk_lt_mk.mpr hfirstOpen.2⟩,
    ⟨Subtype.mk_lt_mk.mpr hsecondOpen.1,
      Subtype.mk_lt_mk.mpr hsecondOpen.2⟩⟩

/-- Helper for Example 74.8: a torus collar point lies over a specified attaching boundary
point exactly at radius zero with the same circle parameter. -/
lemma torusCollarMap_eq_boundary_iff (x : CollarSquare) (s : unitInterval) :
    torusCollarMap x =
        standardGluing.rightBoundary (boundaryCircleParam s) ↔
      x.2 = 0 ∧ unitInterval.endpointSetoid x.1 s := by
  rw [← torusCollarMap_inner]
  constructor
  · intro hxy
    have hidentified := (torusCollarMap_eq_iff x (s, 0)).mp hxy
    have hrelations := (TorusSquare.identified_iff
      (torusCollarRadialMap x).1 (torusCollarRadialMap (s, 0)).1).mp hidentified
    have hinterior :
        ((torusCollarRadialMap (s, 0)).1).1 ∈ Set.Ioo 0 1 ∧
          ((torusCollarRadialMap (s, 0)).1).2 ∈ Set.Ioo 0 1 := by
      -- The radial coercion theorem identifies this representative with the strict interior
      -- point established above.
      simpa only [torusCollarRadialMap_coe, Prod.fst, Prod.snd] using
        torusRadialSquarePoint_zero_mem_Ioo (boundaryCircleParam s)
    have hfirst :
        ((torusCollarRadialMap x).1).1 =
          ((torusCollarRadialMap (s, 0)).1).1 := by
      rcases (unitInterval.endpointSetoid_iff _ _).mp hrelations.1 with
        hsame | hzeroOne | honeZero
      · exact hsame
      · exact (ne_of_lt hinterior.1.2 hzeroOne.2).elim
      · exact (ne_of_gt hinterior.1.1 honeZero.2).elim
    have hsecond :
        ((torusCollarRadialMap x).1).2 =
          ((torusCollarRadialMap (s, 0)).1).2 := by
      rcases (unitInterval.endpointSetoid_iff _ _).mp hrelations.2 with
        hsame | hzeroOne | honeZero
      · exact hsame
      · exact (ne_of_lt hinterior.2.2 hzeroOne.2).elim
      · exact (ne_of_gt hinterior.2.1 honeZero.2).elim
    have hradial : torusCollarRadialMap x = torusCollarRadialMap (s, 0) := by
      -- Equality of the two square coordinates lifts through the complement subtype.
      apply Subtype.ext
      exact Prod.ext hfirst hsecond
    simpa only [Prod.fst, Prod.snd] using
      (torusCollarRadialMap_eq_iff x (s, 0)).mp hradial
  · intro hparameters
    apply (torusCollarMap_eq_iff x (s, 0)).mpr
    have hparameters' :
        x.2 = (s, 0).2 ∧ unitInterval.endpointSetoid x.1 (s, 0).1 := by
      simpa only [Prod.fst, Prod.snd] using hparameters
    have hradial : torusCollarRadialMap x = torusCollarRadialMap (s, 0) :=
      (torusCollarRadialMap_eq_iff x (s, 0)).mpr hparameters'
    -- Equal radial representatives are related by reflexivity of the torus-square setoid.
    rw [hradial]

end

end ProjectivePlaneTorus
