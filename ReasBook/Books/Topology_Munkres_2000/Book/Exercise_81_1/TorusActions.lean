module

public import Topology_Munkres_2000.Book.Definition_53_4.Torus
public import Topology_Munkres_2000.Book.Exercise_74_3.Quotient
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
import all Topology_Munkres_2000.Book.Exercise_74_3.Quotient
import Mathlib.Topology.Algebra.Group.Basic
import Mathlib.Topology.Constructions.SumProd

public section

noncomputable section

/-- The fixed-point-free involution of the torus given by `(z, w) ↦ (-z, w)`. -/
def torusTranslationInvolution : Torus ≃ₜ Torus :=
  (Homeomorph.mulLeft (-1 : Circle)).prodCongr (Homeomorph.refl Circle)

/-- Evaluation of the torus translation involution on a point. -/
@[simp] theorem torusTranslationInvolution_apply (point : Torus) :
    torusTranslationInvolution point = (-point.1, point.2) := by
  rcases point with ⟨z, w⟩
  simp [torusTranslationInvolution]

/-- The order-two transformation group generated by the torus translation involution. -/
def torusTranslationGroup : Subgroup (Torus ≃ₜ Torus) :=
  Subgroup.zpowers torusTranslationInvolution

/-- The standard Klein-bottle involution of the torus, bundled as a homeomorphism. -/
def kleinBottleInvolutionHomeomorph : Torus ≃ₜ Torus :=
  (Homeomorph.mulLeft (-1 : Circle)).prodCongr (Homeomorph.inv Circle)

/-- Evaluation of the bundled Klein-bottle involution agrees with `KleinBottle.involution`. -/
@[simp] theorem kleinBottleInvolutionHomeomorph_apply (point : Torus) :
    kleinBottleInvolutionHomeomorph point = KleinBottle.involution point := by
  -- Both bundled coordinate homeomorphisms compute to the defining involution.
  rcases point with ⟨z, w⟩
  simp [kleinBottleInvolutionHomeomorph, KleinBottle.involution]

/-- The order-two transformation group generated by the standard Klein-bottle involution. -/
def kleinBottleQuotientGroup : Subgroup (Torus ≃ₜ Torus) :=
  Subgroup.zpowers kleinBottleInvolutionHomeomorph
