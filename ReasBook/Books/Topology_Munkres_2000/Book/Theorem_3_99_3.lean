module

public import Topology_Munkres_2000.Book.Lemma_3_99_1.ClusterPoint

public section

universe u v

/-- Helper for Theorem 3.99.3: the reverse-inclusion order on a lifted filter basis
is directed. -/
private lemma filterBasisIndexIsDirected {α : Type u} (B : FilterBasis α) :
    IsDirectedOrder (ULift.{v} (OrderDual B.sets)) := by
  -- A basis set contained in an intersection is an upper bound in reverse inclusion.
  refine ⟨fun a b ↦ ?_⟩
  obtain ⟨s, hs, hsub⟩ := B.inter_sets a.down.2 b.down.2
  refine ⟨ULift.up (OrderDual.toDual ⟨s, hs⟩), ?_, ?_⟩
  · exact hsub.trans Set.inter_subset_left
  · exact hsub.trans Set.inter_subset_right

/-- Helper for Theorem 3.99.3: every nontrivial filter is the limit of a net
indexed by the reverse-inclusion order on its members. -/
private lemma existsTendstoNetFromFilterBasis {α : Type u} (l : Filter α) [Filter.NeBot l] :
    ∃ net : ULift.{v} (OrderDual l.asBasis.sets) → α,
      Filter.Tendsto net Filter.atTop l := by
  classical
  -- Choose one point from every nonempty member of the filter.
  have hnonempty (i : ULift.{v} (OrderDual l.asBasis.sets)) :
      (i.down.1 : Set α).Nonempty :=
    Filter.nonempty_of_mem i.down.2
  choose net hnet using hnonempty
  refine ⟨net, ?_⟩
  rw [Filter.tendsto_iff_forall_eventually_mem]
  intro s hs
  -- Beyond the index represented by `s`, every chosen point lies in `s`.
  refine (Filter.eventually_ge_atTop
    (ULift.up (OrderDual.toDual ⟨s, hs⟩))).mono ?_
  intro i hi
  exact hi (hnet i)

/-- Helper for Theorem 3.99.3: an ultrafilter approached by a net also approaches
every limit of a subnet of that net. -/
private lemma Ultrafilter.le_nhds_of_tendsto_subnet {X : Type u} [TopologicalSpace X]
    {J : Type v} [Preorder J] (F : Ultrafilter X) (net : J → X)
    (hnet : Filter.Tendsto net Filter.atTop (F : Filter X))
    (subnet : Net.Subnet net) (x : X)
    (hsubnet : Filter.Tendsto subnet.values Filter.atTop (nhds x)) :
    (F : Filter X) ≤ nhds x := by
  -- Cofinality puts the filter generated by subnet values below `F`.
  have hvalues : Filter.Tendsto subnet.values Filter.atTop (F : Filter X) := by
    simpa only [Net.Subnet.values] using hnet.comp subnet.tendsto_map
  have hvalues_le : Filter.map subnet.values Filter.atTop ≤ (F : Filter X) := by
    simpa only [Filter.Tendsto] using hvalues
  -- This value filter is nontrivial, so ultrafilter maximality identifies it with `F`.
  have heq : Filter.map subnet.values Filter.atTop = (F : Filter X) :=
    F.unique hvalues_le
  rw [← heq]
  exact hsubnet

/-- Theorem 3.99.3: A space `X` is compact if and only if every net in `X` has a
convergent subnet. -/
theorem compactSpace_iff_exists_tendsto_subnet (X : Type u) [TopologicalSpace X] :
    CompactSpace X ↔
      ∀ {J : Type (max u v)} [Nonempty J] [Preorder J] [IsDirectedOrder J]
        (net : J → X),
        ∃ (subnet : Net.Subnet net) (x : X),
          Filter.Tendsto subnet.values Filter.atTop (nhds x) := by
  constructor
  · intro hcompact J _ _ _ net
    -- Compactness gives a cluster point of the net in the universal compact set.
    have hmap : Filter.map net Filter.atTop ≤ Filter.principal (Set.univ : Set X) := by
      rw [Filter.principal_univ]
      exact le_top
    obtain ⟨x, _, hx⟩ := hcompact.isCompact_univ.exists_mapClusterPt hmap
    -- The earlier cluster-point characterization packages a convergent subnet.
    obtain ⟨subnet, hsubnet⟩ :=
      (Net.mapClusterPt_iff_exists_tendsto_subnet net x).mp hx
    exact ⟨subnet, x, hsubnet⟩
  · intro hnets
    rw [← isCompact_univ_iff, isCompact_iff_ultrafilter_le_nhds]
    intro F _
    letI : IsDirectedOrder (ULift.{v} (OrderDual (F : Filter X).asBasis.sets)) :=
      filterBasisIndexIsDirected (F : Filter X).asBasis
    -- Realize the arbitrary ultrafilter as the limit of its canonical basis net.
    obtain ⟨net, hnet⟩ :=
      existsTendstoNetFromFilterBasis (F : Filter X)
    obtain ⟨subnet, x, hsubnet⟩ := hnets net
    -- A convergent subnet forces the original ultrafilter to converge to the same point.
    exact ⟨x, Set.mem_univ x,
      F.le_nhds_of_tendsto_subnet net hnet subnet x hsubnet⟩

/-- Every net in a compact space has a convergent subnet. -/
theorem CompactSpace.exists_tendsto_subnet {X : Type u} [TopologicalSpace X]
    [CompactSpace X] {J : Type (max u v)} [Nonempty J] [Preorder J]
    [IsDirectedOrder J]
    (net : J → X) :
    ∃ (subnet : Net.Subnet net) (x : X),
      Filter.Tendsto subnet.values Filter.atTop (nhds x) :=
  (compactSpace_iff_exists_tendsto_subnet X).mp inferInstance net
