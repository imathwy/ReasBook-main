module

public import Mathlib.Topology.Instances.Real.Lemmas

public section

open Set

namespace RealTopology

/-- The family of open intervals generating the standard topology on `ℝ`. -/
def standardBasis : Set (Set ℝ) :=
  {s | ∃ a b : ℝ, a < b ∧ s = Ioo a b}

/-- The set `K = {1 / n | n ∈ ℕ, 0 < n}` used to define the `K`-topology on `ℝ`. -/
def positiveReciprocals : Set ℝ :=
  {x | ∃ n : ℕ, 0 < n ∧ x = (n : ℝ)⁻¹}

/-- The family of half-open intervals `[a, b)` generating the lower-limit topology on `ℝ`. -/
@[expose]
def lowerLimitBasis : Set (Set ℝ) :=
  {s | ∃ a b : ℝ, a < b ∧ s = Ico a b}

/-- The family of open intervals and open intervals with `positiveReciprocals` removed. -/
def kBasis : Set (Set ℝ) :=
  {s | ∃ a b : ℝ, a < b ∧ (s = Ioo a b ∨ s = Ioo a b \ positiveReciprocals)}

/-- The lower-limit topology on `ℝ`, generated by half-open intervals `[a, b)`. -/
@[reducible]
def lowerLimit : TopologicalSpace ℝ :=
  TopologicalSpace.generateFrom lowerLimitBasis

/-- Helper for Lemma 13.4: the lower-limit topology is generated by its canonical basis. -/
theorem lowerLimit_eq_generateFrom :
    lowerLimit = TopologicalSpace.generateFrom lowerLimitBasis := by
  -- Expose the defining equation without requiring downstream unfolding.
  rfl

/-- The `K`-topology on `ℝ`, generated by `kBasis`. -/
@[reducible]
def k : TopologicalSpace ℝ :=
  TopologicalSpace.generateFrom kBasis

/-- The `K`-topology is generated by the canonical `K`-basis. -/
theorem k_eq_generateFrom :
    k = TopologicalSpace.generateFrom kBasis := by
  -- Expose the defining equation without requiring downstream unfolding.
  rfl

/-- Membership in the canonical `K`-basis is the interval-or-removed-interval condition. -/
theorem mem_kBasis_iff (s : Set ℝ) :
    s ∈ kBasis ↔ ∃ a b : ℝ, a < b ∧
      (s = Ioo a b ∨ s = Ioo a b \ positiveReciprocals) := by
  -- Expose the defining membership condition for downstream basis arguments.
  rfl

/-- The open intervals form a basis for the standard topology on `ℝ`. -/
theorem isTopologicalBasis_standardBasis :
    TopologicalSpace.IsTopologicalBasis standardBasis := by
  apply TopologicalSpace.isTopologicalBasis_of_isOpen_of_nhds
  · rintro _ ⟨a, b, _, rfl⟩
    exact isOpen_Ioo
  · intro x u hxu hu
    obtain ⟨a, b, hxab, hab⟩ :=
      mem_nhds_iff_exists_Ioo_subset.mp (hu.mem_nhds hxu)
    exact ⟨Ioo a b, ⟨a, b, hxab.1.trans hxab.2, rfl⟩, hxab, hab⟩

/-- The standard topology on `ℝ` is generated by its open intervals. -/
theorem standard_eq_generateFrom :
    (inferInstance : TopologicalSpace ℝ) = TopologicalSpace.generateFrom standardBasis :=
  isTopologicalBasis_standardBasis.eq_generateFrom

/-- Membership in `positiveReciprocals` is membership in the positive reciprocal sequence. -/
theorem mem_positiveReciprocals (x : ℝ) :
    x ∈ positiveReciprocals ↔ ∃ n : ℕ, 0 < n ∧ x = (n : ℝ)⁻¹ := Iff.rfl

end RealTopology
