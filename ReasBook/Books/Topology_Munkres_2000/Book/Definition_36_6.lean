module

public import Topology_Munkres_2000.Book.Definition_36_6.LineWithTwoOrigins

public section

namespace LineWithTwoOrigins

/-- Definition 36.6: The line with two origins is the punctured real line together with
two distinct origins, equipped with the topology generated by ordinary intervals avoiding
zero and punctured symmetric intervals containing exactly one chosen origin. The designated
sets form a topological basis for this topology. -/
theorem basis_isTopologicalBasis : TopologicalSpace.IsTopologicalBasis basis := by
  -- The refinement and cover criteria identify the installed generated topology.
  exact ⟨basis_exists_subset_inter, basis_sUnion_eq, topology_eq_generateFrom⟩

end LineWithTwoOrigins
