module

public import Topology_Munkres_2000.Book.Example_17_6
public import Topology_Munkres_2000.Book.Example_31_1.Separation
public import Topology_Munkres_2000.Book.Exercise_13_7
public import Topology_Munkres_2000.Book.Exercise_17_16.UpperLimitLine
public import Topology_Munkres_2000.Book.Exercise_17_16.Separation
public import Mathlib.Topology.Order.LowerUpperTopology

public section

open Set
open scoped Topology

namespace RealTopology

/- Exercise 17.16 (1): In the standard topology on `ℝ`, the closure of the positive
reciprocal set is the set together with its limit point `0`. -/
#check closure_positiveReciprocals

/-- Exercise 17.16 (2): In the `K`-topology, the positive reciprocal set is closed. -/
theorem kClosurePositiveReciprocals :
    closure[k] positiveReciprocals = positiveReciprocals := by
  change ⋂₀ {s | IsClosed[k] s ∧ positiveReciprocals ⊆ s} = positiveReciprocals
  apply Subset.antisymm
  · exact sInter_subset_of_mem ⟨positiveReciprocalsClosed, subset_rfl⟩
  · exact subset_sInter fun _ h ↦ h.2

/-- Helper for Exercise 17.16: the positive reciprocal set is infinite. -/
lemma positiveReciprocalsInfinite : positiveReciprocals.Infinite := by
  -- Embed the naturals by the distinct reciprocals of their positive successors.
  let f : ℕ → ℝ := fun n ↦ (((n + 1 : ℕ) : ℝ)⁻¹)
  have hInjective : Function.Injective f := by
    intro m n hmn
    have hSuccessors : m + 1 = n + 1 := Nat.cast_injective (inv_injective hmn)
    exact Nat.add_right_cancel hSuccessors
  apply (Set.infinite_range_of_injective hInjective).mono
  rintro _ ⟨n, rfl⟩
  exact (mem_positiveReciprocals _).mpr ⟨n + 1, Nat.succ_pos n, rfl⟩

/-- Exercise 17.16 (3): In the finite-complement topology on `ℝ`, the closure of the
infinite positive reciprocal set is all of `ℝ`. -/
theorem cofiniteClosurePositiveReciprocals :
    closure[TopologicalSpace.cofinite] positiveReciprocals = Set.univ := by
  -- Every nonempty cofinite neighborhood meets the infinite reciprocal set.
  apply Set.Subset.antisymm (Set.subset_univ _)
  intro x _
  rw [@mem_closure_iff ℝ TopologicalSpace.cofinite x positiveReciprocals]
  intro u hu hxu
  by_contra hIntersection
  have hFiniteComplement : uᶜ.Finite := hu ⟨x, hxu⟩
  have hReciprocalsSubset : positiveReciprocals ⊆ uᶜ := by
    intro y hyReciprocal hyu
    exact hIntersection ⟨y, hyu, hyReciprocal⟩
  exact positiveReciprocalsInfinite (hFiniteComplement.subset hReciprocalsSubset)

/-- Exercise 17.16 (4): In the upper-limit topology, the positive reciprocal set is closed. -/
theorem upperLimitClosurePositiveReciprocals :
    closure[upperLimit] positiveReciprocals = positiveReciprocals := by
  -- A set already known to be upper-limit closed equals its closure.
  exact @IsClosed.closure_eq ℝ upperLimit positiveReciprocals
    positiveReciprocals_isClosed_upperLimit

/-- Exercise 17.16 (5): In the topology generated by the rays `(-∞, a)`, the closure of
the positive reciprocal set is `Set.Ici 0`, corresponding to `[0, ∞)`. -/
theorem lowerTopologyClosurePositiveReciprocals :
    closure[Topology.lower ℝ] positiveReciprocals = Set.Ici 0 := by
  -- Bound the closure above by the closed ray containing every positive reciprocal.
  have hRayClosed : @IsClosed ℝ (Topology.lower ℝ) (Set.Ici 0) := by
    apply (@isOpen_compl_iff ℝ (Set.Ici 0) (Topology.lower ℝ)).mp
    rw [Topology.lower]
    exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨0, rfl⟩
  have hReciprocalsSubset : positiveReciprocals ⊆ Set.Ici 0 := by
    intro x hx
    obtain ⟨n, hn, rfl⟩ := (mem_positiveReciprocals x).mp hx
    have hnReal : (0 : ℝ) < (n : ℝ) := Nat.cast_pos.mpr hn
    exact (inv_pos.mpr hnReal).le
  have hClosureSubset : closure[Topology.lower ℝ] positiveReciprocals ⊆ Set.Ici 0 :=
    @closure_minimal ℝ (Topology.lower ℝ) positiveReciprocals (Set.Ici 0)
      hReciprocalsSubset hRayClosed
  -- Transport the standard limit point zero into the coarser lower topology.
  have hZeroStandard : (0 : ℝ) ∈ closure positiveReciprocals := by
    rw [closure_positiveReciprocals]
    exact Set.mem_insert 0 positiveReciprocals
  have hZeroLower : (0 : ℝ) ∈ closure[Topology.lower ℝ] positiveReciprocals :=
    closure.mono standard_lt_lower.le hZeroStandard
  -- Lower-topology closed sets are upper sets, so containing zero forces the whole ray.
  have hClosureClosed :
      @IsClosed ℝ (Topology.lower ℝ) (closure[Topology.lower ℝ] positiveReciprocals) :=
    @isClosed_closure ℝ (Topology.lower ℝ) positiveReciprocals
  have hLowerComplement :
      IsLowerSet (closure[Topology.lower ℝ] positiveReciprocals)ᶜ :=
    isLowerSet_of_isOpen_lower hClosureClosed.isOpen_compl
  have hClosureUpper : IsUpperSet (closure[Topology.lower ℝ] positiveReciprocals) := by
    simpa only [compl_compl] using hLowerComplement.compl
  exact Set.Subset.antisymm hClosureSubset (hClosureUpper.Ici_subset hZeroLower)

/- Exercise 17.16 (6): The standard topology and the `K`-topology on `ℝ` are
Hausdorff, and hence satisfy the `T₁` axiom. -/
#synth T2Space ℝ

#check kT2Space

/- Exercise 17.16 (7): The finite-complement topology on `ℝ` satisfies the `T₁`
axiom but is not Hausdorff. -/
#synth T1Space (CofiniteTopology ℝ)

/- The finite-complement topology on `ℝ` is not Hausdorff. -/
#check cofiniteNotT2Space

/- Exercise 17.16 (8): The upper-limit topology on `ℝ` is Hausdorff, and hence
`T₁`; the topology generated by the rays `(-∞, a)` is neither `T₁` nor Hausdorff. -/
#check UpperLimitLine.topology_eq_upperLimit

#synth T2Space UpperLimitLine

#synth T1Space UpperLimitLine

/-- The topology on `ℝ` generated by the rays `(-∞, a)` is not `T₁`. -/
theorem lowerTopologyNotT1Space :
    ¬ T1Space (Topology.WithLower ℝ) := by
  -- A closed singleton would have to be upward closed, despite containing zero but not one.
  intro hT1
  have hSingletonClosed :
      IsClosed ({Topology.WithLower.toLower (0 : ℝ)} : Set (Topology.WithLower ℝ)) :=
    hT1.t1 _
  have hSingletonUpper :
      IsUpperSet ({Topology.WithLower.toLower (0 : ℝ)} : Set (Topology.WithLower ℝ)) :=
    Topology.IsLower.isUpperSet_of_isClosed hSingletonClosed
  have hZeroLeOne :
      Topology.WithLower.toLower (0 : ℝ) ≤ Topology.WithLower.toLower (1 : ℝ) := by
    norm_num
  have hOneMem :
      Topology.WithLower.toLower (1 : ℝ) ∈
        ({Topology.WithLower.toLower (0 : ℝ)} : Set (Topology.WithLower ℝ)) :=
    hSingletonUpper hZeroLeOne (Set.mem_singleton _)
  have hOneEqZero : (1 : ℝ) = 0 := by
    simpa only [Set.mem_singleton_iff, Topology.WithLower.toLower_inj] using hOneMem
  norm_num at hOneEqZero

/-- The topology on `ℝ` generated by the rays `(-∞, a)` is not Hausdorff. -/
theorem lowerTopologyNotT2Space :
    ¬ T2Space (Topology.WithLower ℝ) := by
  intro h
  exact lowerTopologyNotT1Space h.t1Space

end RealTopology
