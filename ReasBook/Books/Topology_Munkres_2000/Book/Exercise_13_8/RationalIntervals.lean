module

public import Topology_Munkres_2000.Book.Definition_13_3.RealLine
public import Mathlib.Data.Rat.Encodable
public import Mathlib.NumberTheory.Real.Irrational
public import Mathlib.Topology.Bases

public section

namespace Real

/-- The family of open intervals in `ℝ` with rational endpoints. -/
def rationalOpenIntervals : Set (Set ℝ) :=
  {s | ∃ a b : ℚ, a < b ∧ s = Set.Ioo (a : ℝ) (b : ℝ)}

/-- Membership in `Real.rationalOpenIntervals` is witnessed by two ordered rational endpoints. -/
theorem mem_rationalOpenIntervals (s : Set ℝ) :
    s ∈ rationalOpenIntervals ↔
      ∃ a b : ℚ, a < b ∧ s = Set.Ioo (a : ℝ) (b : ℝ) := Iff.rfl

/-- The family `Real.rationalOpenIntervals` is countable. -/
theorem rationalOpenIntervals_countable : rationalOpenIntervals.Countable := by
  -- Forgetting the endpoint inequality embeds the family in a countable range.
  refine (Set.countable_range fun p : ℚ × ℚ ↦
    Set.Ioo (p.1 : ℝ) (p.2 : ℝ)).mono ?_
  intro s hs
  obtain ⟨a, b, _, rfl⟩ := (mem_rationalOpenIntervals s).mp hs
  exact ⟨(a, b), rfl⟩

/-- Rational-endpoint open intervals form a basis for the standard topology on `ℝ`. -/
theorem rationalOpenIntervals_isTopologicalBasis :
    TopologicalSpace.IsTopologicalBasis rationalOpenIntervals := by
  refine TopologicalSpace.isTopologicalBasis_of_isOpen_of_nhds ?_ ?_
  · -- Each rational-endpoint interval is an ordinary open interval.
    intro s hs
    obtain ⟨a, b, _, rfl⟩ := (mem_rationalOpenIntervals s).mp hs
    exact isOpen_Ioo
  · intro x u hxu hu
    obtain ⟨l, r, hxlr, hlru⟩ :=
      mem_nhds_iff_exists_Ioo_subset.mp (hu.mem_nhds hxu)
    obtain ⟨a, hla, hax⟩ := exists_rat_btwn hxlr.1
    obtain ⟨b, hxb, hbr⟩ := exists_rat_btwn hxlr.2
    -- Rational density gives a smaller basis interval around `x`.
    refine ⟨Set.Ioo (a : ℝ) (b : ℝ), ?_, ⟨hax, hxb⟩, ?_⟩
    · exact (mem_rationalOpenIntervals _).mpr
        ⟨a, b, Rat.cast_lt.mp (hax.trans hxb), rfl⟩
    · exact (Set.Ioo_subset_Ioo hla.le hbr.le).trans hlru

end Real

namespace RealTopology

/-- The family of half-open intervals `[a, b)` with rational endpoints. -/
def rationalLowerLimitBasis : Set (Set ℝ) :=
  {s | ∃ a b : ℚ, a < b ∧ s = Set.Ico (a : ℝ) (b : ℝ)}

/-- Membership in `rationalLowerLimitBasis` is witnessed by two ordered rational endpoints. -/
theorem mem_rationalLowerLimitBasis (s : Set ℝ) :
    s ∈ rationalLowerLimitBasis ↔
      ∃ a b : ℚ, a < b ∧ s = Set.Ico (a : ℝ) (b : ℝ) := Iff.rfl

/-- The topology generated by half-open intervals with rational endpoints. -/
@[reducible]
def rationalLowerLimit : TopologicalSpace ℝ :=
  TopologicalSpace.generateFrom rationalLowerLimitBasis

local instance instRationalLowerLimitTopology : TopologicalSpace ℝ := rationalLowerLimit

/-- Rational-endpoint half-open intervals form a basis for `rationalLowerLimit`. -/
theorem rationalLowerLimitBasis_isTopologicalBasis :
    rationalLowerLimit.IsTopologicalBasis rationalLowerLimitBasis := by
  refine TopologicalSpace.IsTopologicalBasis.mk ?_ ?_ rfl
  · intro s hs t ht x hx
    obtain ⟨a, b, hab, rfl⟩ := (mem_rationalLowerLimitBasis s).mp hs
    obtain ⟨c, d, hcd, rfl⟩ := (mem_rationalLowerLimitBasis t).mp ht
    -- Rational maxima and minima refine two intersecting basis intervals.
    have hmaxMinReal : ((max a c : ℚ) : ℝ) < ((min b d : ℚ) : ℝ) := by
      simpa only [Rat.cast_max, Rat.cast_min] using
        (max_le hx.1.1 hx.2.1).trans_lt (lt_min hx.1.2 hx.2.2)
    have hmaxMin : max a c < min b d := Rat.cast_lt.mp hmaxMinReal
    refine ⟨Set.Ico (max a c : ℚ) (min b d : ℚ), ?_, ?_, ?_⟩
    · exact (mem_rationalLowerLimitBasis _).mpr ⟨max a c, min b d, hmaxMin, rfl⟩
    · simpa only [Set.mem_Ico, Rat.cast_max, Rat.cast_min] using
        ⟨max_le hx.1.1 hx.2.1, lt_min hx.1.2 hx.2.2⟩
    · intro y hy
      constructor
      · constructor
        · calc
            (a : ℝ) ≤ max (a : ℝ) (c : ℝ) := le_max_left _ _
            _ = ((max a c : ℚ) : ℝ) := (Rat.cast_max a c).symm
            _ ≤ y := hy.1
        · calc
            y < ((min b d : ℚ) : ℝ) := hy.2
            _ = min (b : ℝ) (d : ℝ) := Rat.cast_min b d
            _ ≤ (b : ℝ) := min_le_left _ _
      · constructor
        · calc
            (c : ℝ) ≤ max (a : ℝ) (c : ℝ) := le_max_right _ _
            _ = ((max a c : ℚ) : ℝ) := (Rat.cast_max a c).symm
            _ ≤ y := hy.1
        · calc
            y < ((min b d : ℚ) : ℝ) := hy.2
            _ = min (b : ℝ) (d : ℝ) := Rat.cast_min b d
            _ ≤ (d : ℝ) := min_le_right _ _
  · -- Rational density supplies a half-open basis interval through every real point.
    apply Set.sUnion_eq_univ_iff.mpr
    intro x
    obtain ⟨a, _, hax⟩ := exists_rat_btwn (sub_lt_self x zero_lt_one)
    obtain ⟨b, hxb, _⟩ := exists_rat_btwn (lt_add_of_pos_right x zero_lt_one)
    refine ⟨Set.Ico (a : ℝ) (b : ℝ), ?_, ⟨hax.le, hxb⟩⟩
    exact (mem_rationalLowerLimitBasis _).mpr
      ⟨a, b, Rat.cast_lt.mp (hax.trans hxb), rfl⟩

/-- The rational lower-limit topology differs from the lower-limit topology on `ℝ`. -/
theorem rationalLowerLimit_ne_lowerLimit : rationalLowerLimit ≠ lowerLimit := by
  intro htop
  obtain ⟨ξ, hξirr, hξpos, hξone⟩ := exists_irrational_btwn zero_lt_one
  have hOneTwo : (1 : ℝ) < 2 := by
    norm_num
  have hξtwo : ξ < (2 : ℝ) := hξone.trans hOneTwo
  -- The full lower-limit topology contains the generator with irrational left endpoint.
  have hopenLower : @IsOpen ℝ lowerLimit (Set.Ico ξ 2) := by
    rw [lowerLimit_eq_generateFrom]
    exact TopologicalSpace.GenerateOpen.basic _ ⟨ξ, 2, hξtwo, rfl⟩
  have hopenRational : @IsOpen ℝ rationalLowerLimit (Set.Ico ξ 2) := by
    rw [htop]
    exact hopenLower
  have hξTarget : ξ ∈ Set.Ico ξ 2 := ⟨le_rfl, hξtwo⟩
  obtain ⟨s, hs, hξs, hsSubset⟩ :=
    rationalLowerLimitBasis_isTopologicalBasis.exists_subset_of_mem_open
      hξTarget hopenRational
  obtain ⟨a, b, hab, rfl⟩ := (mem_rationalLowerLimitBasis s).mp hs
  -- Containment forces the irrational endpoint to equal the rational left endpoint.
  have haTarget : (a : ℝ) ∈ Set.Ico ξ 2 :=
    hsSubset ⟨le_rfl, Rat.cast_lt.mpr hab⟩
  exact hξirr.ne_rat a (le_antisymm haTarget.1 hξs.1)

end RealTopology
