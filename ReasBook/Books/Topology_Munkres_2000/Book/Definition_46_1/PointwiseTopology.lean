module

public import Mathlib.Topology.Bases
import Topology_Munkres_2000.Book.Remark_19_1

public section

universe u v

/-- For `x : X` and `U ⊆ Y`, `pointwiseSubbasicSet x U` is the set of functions whose
value at `x` belongs to `U`. -/
@[expose]
def pointwiseSubbasicSet {X : Type u} {Y : Type v} (x : X) (U : Set Y) : Set (X → Y) :=
  {f | f x ∈ U}

/-- Membership in `pointwiseSubbasicSet x U` is evaluation membership in `U`. -/
lemma mem_pointwiseSubbasicSet {X : Type u} {Y : Type v} {x : X} {U : Set Y} (f : X → Y) :
    f ∈ pointwiseSubbasicSet x U ↔ f x ∈ U :=
  Iff.rfl

/-- The set `pointwiseSubbasicSet x U` is the preimage of `U` under evaluation at `x`. -/
lemma pointwiseSubbasicSet_eq_preimage {X : Type u} {Y : Type v} (x : X) (U : Set Y) :
    pointwiseSubbasicSet x U = Function.eval x ⁻¹' U :=
  rfl

/-- The topology of pointwise convergence, also called the point-open topology, is generated by
the sets `pointwiseSubbasicSet x U` with `U` open. -/
theorem pointwiseTopology_eq_generateFrom (X : Type u) (Y : Type v) [TopologicalSpace Y] :
    (Pi.topologicalSpace : TopologicalSpace (X → Y)) =
      TopologicalSpace.generateFrom
        {s | ∃ x U, IsOpen U ∧ s = pointwiseSubbasicSet x U} := by
  rw [TopologicalSpace.pi_eq_generateFrom_projections]
  congr 1
  ext s
  simp only [Set.mem_setOf_eq]
  constructor
  · rintro ⟨x, U, hU, rfl⟩
    exact ⟨x, U, hU, pointwiseSubbasicSet_eq_preimage x U⟩
  · rintro ⟨x, U, hU, rfl⟩
    exact ⟨x, U, hU, pointwiseSubbasicSet_eq_preimage x U |>.symm⟩
