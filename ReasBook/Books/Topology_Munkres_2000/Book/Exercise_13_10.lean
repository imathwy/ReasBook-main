module

import Mathlib.Topology.Order

universe u

/-
Exercise 13.10. In the topology generated by a basis, the intersection of two
open sets is open.
-/
#check fun {X : Type u} {𝓑 : Set (Set X)} {U₁ U₂ : Set X}
    (hU₁ : (TopologicalSpace.generateFrom 𝓑).IsOpen U₁)
    (hU₂ : (TopologicalSpace.generateFrom 𝓑).IsOpen U₂) ↦
  (TopologicalSpace.generateFrom 𝓑).isOpen_inter U₁ U₂ hU₁ hU₂
