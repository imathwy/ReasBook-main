module

public import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Algebra.Group.Submonoid.BigOperators

public section

namespace Subgroup

universe u v

variable {G : Type u} {ι : Type v} [Group G]

/-- A finite ordered word whose letters belong to an indexed family of subgroups. -/
structure Word (H : ι → Subgroup G) where
  /-- The ordered list of letters in the word. -/
  toList : List G
  /-- Every letter belongs to at least one of the specified subgroups. -/
  mem_subgroup (x : G) (hx : x ∈ toList) : ∃ i, x ∈ H i

namespace Word

variable (H : ι → Subgroup G)

/-- The empty word in an indexed family of subgroups. -/
@[expose]
def empty : Word H where
  toList := []
  mem_subgroup := by simp

/-- The list underlying the empty word is empty. -/
@[simp]
theorem toList_empty : (empty H).toList = [] := rfl

/-- The one-letter word determined by an element of a specified subgroup. -/
def singleton (i : ι) (x : G) (hx : x ∈ H i) : Word H where
  toList := [x]
  mem_subgroup := by
    simp only [List.mem_singleton, forall_eq]
    exact ⟨i, hx⟩

/-- Helper for Definition 68.1: Concatenation of two words in the same family of subgroups. -/
def append (w₁ w₂ : Word H) : Word H where
  toList := w₁.toList ++ w₂.toList
  -- Membership in either input word supplies the required subgroup witness.
  mem_subgroup := List.forall_mem_append.2 ⟨w₁.mem_subgroup, w₂.mem_subgroup⟩

/-- The ordered product of the letters of a word. -/
@[expose]
def prod {H : ι → Subgroup G} (w : Word H) : G :=
  w.toList.prod

/-- Evaluation of a word is the product of its underlying list. -/
theorem prod_def {H : ι → Subgroup G} (w : Word H) : w.prod = w.toList.prod := rfl

/-- The empty word evaluates to the identity element. -/
@[simp]
theorem prod_empty : (empty H).prod = 1 := rfl

/-- Helper for Definition 68.1: A singleton word evaluates to its unique letter. -/
@[simp]
theorem prod_singleton (i : ι) (x : G) (hx : x ∈ H i) :
    (singleton H i x hx).prod = x := by
  -- Reduce word evaluation to the product of the one-element underlying list.
  simp only [prod_def, singleton, List.prod_singleton]

/-- Helper for Definition 68.1: Evaluation carries word concatenation to multiplication. -/
@[simp]
theorem prod_append (w₁ w₂ : Word H) :
    (append H w₁ w₂).prod = w₁.prod * w₂.prod := by
  -- Expose only the underlying append, then use multiplicativity of `List.prod`.
  simp only [prod_def, append, List.prod_append]

/-- The proposition that a word evaluates to a specified group element. -/
def Represents {H : ι → Subgroup G} (w : Word H) (x : G) : Prop :=
  w.prod = x

/-- A word represents an element exactly when its product equals that element. -/
theorem represents_iff {H : ι → Subgroup G} (w : Word H) (x : G) :
    w.Represents x ↔ w.prod = x := Iff.rfl

/-- Helper for Definition 68.1: The product represented by a word lies in the subgroup
supremum generated by its letters. -/
theorem prod_mem_iSup (w : Word H) : w.prod ∈ ⨆ i, H i := by
  -- It suffices to place each individual letter in the subgroup supremum.
  rw [prod_def]
  apply list_prod_mem
  intro x hx
  obtain ⟨i, hi⟩ := w.mem_subgroup x hx
  exact Subgroup.mem_iSup_of_mem i hi

end Word

end Subgroup
