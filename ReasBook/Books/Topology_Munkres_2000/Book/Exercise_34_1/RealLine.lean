module

public import Topology_Munkres_2000.Book.Example_31_1
public import Topology_Munkres_2000.Book.Exercise_22_6.RealKLine
public import Topology_Munkres_2000.Book.Lemma_13_4
public import Mathlib.Topology.Bases
public import Mathlib.Topology.Metrizable.Basic

public section

open Set
open TopologicalSpace

namespace RealKLine

/-- `RealKLine` is Hausdorff. -/
instance instT2Space : T2Space RealKLine := RealTopology.kT2Space

/-- Helper for Exercise 34.1: a countable subbasis generating the `K`-topology. -/
private def countableSubbasis : Set (Set ℝ) :=
  countableBasis ℝ ∪ {RealTopology.positiveReciprocalsᶜ}

/-- Helper for Exercise 34.1: the chosen subbasis of the `K`-topology is countable. -/
private lemma countable_countableSubbasis : countableSubbasis.Countable := by
  -- Combine the standard countable basis with the one exceptional open set.
  exact (countable_countableBasis ℝ).union (Set.countable_singleton _)

/-- Helper for Exercise 34.1: the `K`-topology is finer than the standard real topology. -/
private lemma k_le_standardTopology :
    RealTopology.k ≤ (inferInstance : TopologicalSpace ℝ) := by
  -- Reuse the earlier strict comparison and forget strictness.
  exact RealTopology.k_lt_standard.le

/-- Helper for Exercise 34.1: the topology generated by the chosen subbasis is finer than the
standard real topology. -/
private lemma generateFrom_countableSubbasis_le_standardTopology :
    generateFrom countableSubbasis ≤ (inferInstance : TopologicalSpace ℝ) := by
  -- Each standard countable-basis set is explicitly among the generators.
  rw [eq_generateFrom_countableBasis ℝ]
  apply le_generateFrom_iff_subset_isOpen.2
  intro s hs
  exact isOpen_generateFrom_of_mem (Or.inl hs)

/-- Helper for Exercise 34.1: the chosen countable subbasis generates the `K`-topology. -/
private lemma k_eq_generateFrom_countableSubbasis :
    RealTopology.k = generateFrom countableSubbasis := by
  -- Compare the two generated topologies in both directions.
  apply le_antisymm
  · apply le_generateFrom_iff_subset_isOpen.2
    intro s hs
    rcases hs with hs | hs
    · exact k_le_standardTopology s (isOpen_of_mem_countableBasis hs)
    · rw [Set.mem_singleton_iff] at hs
      subst s
      exact RealTopology.positiveReciprocalsClosed.isOpen_compl
  · rw [RealTopology.k_eq_generateFrom]
    apply le_generateFrom_iff_subset_isOpen.2
    intro s hs
    obtain ⟨a, b, hab, hs | hs⟩ := (RealTopology.mem_kBasis_iff s).mp hs
    · subst s
      exact generateFrom_countableSubbasis_le_standardTopology _ isOpen_Ioo
    · subst s
      rw [Set.sdiff_eq_compl_inter]
      have hcomp : @IsOpen ℝ (generateFrom countableSubbasis)
          RealTopology.positiveReciprocalsᶜ :=
        isOpen_generateFrom_of_mem (Or.inr (Set.mem_singleton _))
      have hinterval : @IsOpen ℝ (generateFrom countableSubbasis) (Ioo a b) :=
        generateFrom_countableSubbasis_le_standardTopology _ isOpen_Ioo
      exact @IsOpen.inter ℝ (generateFrom countableSubbasis) _ _ hcomp hinterval

/-- `RealKLine` has a countable basis. -/
instance instSecondCountableTopology : SecondCountableTopology RealKLine :=
  -- Present the topology by the countable generating family proved above.
  ⟨⟨countableSubbasis, countable_countableSubbasis,
    topology_eq_k.trans k_eq_generateFrom_countableSubbasis⟩⟩

end RealKLine
