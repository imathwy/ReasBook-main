module

public import Mathlib.Topology.Constructions
public import Mathlib.Topology.ContinuousMap.Basic

public section

universe u v w

namespace Topology.IndexedPointedWedge

variable {I : Type u} (X : I → Type v) [∀ i, TopologicalSpace (X i)] (p : ∀ i, X i)

/-- Two points in the disjoint union are directly related when both are designated
points of their factors. -/
def Related (x y : Σ i, X i) : Prop :=
  ∃ i j, x = ⟨i, p i⟩ ∧ y = ⟨j, p j⟩

/-- The equivalence relation generated by identifying all designated factor points. -/
def setoid : Setoid (Σ i, X i) :=
  Relation.EqvGen.setoid (Related X p)

/-- The pointed wedge of an indexed family of topological spaces. -/
abbrev Space := Quotient (setoid X p)

/-- The canonical quotient map to the pointed wedge. -/
def quotientMap : (Σ i, X i) → Space X p :=
  Quotient.mk (setoid X p)

/-- The canonical inclusion of one factor into the pointed wedge. -/
def inclusion (i : I) : X i → Space X p :=
  fun x ↦ quotientMap X p ⟨i, x⟩

/-- The wedge point represented using a specified factor. -/
def point (i : I) : Space X p :=
  inclusion X p i (p i)

omit [∀ i, TopologicalSpace (X i)] in
/-- The wedge point is independent of the factor used to represent it. -/
theorem point_eq (i j : I) : point X p i = point X p j := by
  -- The generating relation directly identifies all designated factor points.
  apply Quotient.sound
  exact Relation.EqvGen.rel _ _ ⟨i, j, rfl, rfl⟩

end Topology.IndexedPointedWedge

namespace Topology.PointedWedge

/-- The two-factor family used to realize a binary pointed wedge as an indexed wedge. -/
abbrev Family (X : Type u) (Y : Type v) : Bool → Type (max u v)
  | false => ULift.{max u v, u} X
  | true => ULift.{max u v, v} Y

/-- The canonical topology on the two-factor family of a binary pointed wedge. -/
instance instTopologicalSpaceFamily {X : Type u} {Y : Type v}
    [TopologicalSpace X] [TopologicalSpace Y] (i : Bool) :
    TopologicalSpace (Family X Y i) := by
  cases i <;> infer_instance

/-- The two selected points as an indexed family. -/
abbrev points {X : Type u} (x₀ : X) {Y : Type v} (y₀ : Y) : ∀ i, Family X Y i
  | false => ULift.up x₀
  | true => ULift.up y₀

end Topology.PointedWedge

/-- The wedge of two spaces at specified points, realized as a two-factor indexed wedge. -/
abbrev Topology.PointedWedge (X : Type u) (x₀ : X) (Y : Type v) (y₀ : Y) :
    Type (max u v) :=
  IndexedPointedWedge.Space (PointedWedge.Family X Y) (PointedWedge.points x₀ y₀)

namespace Topology.PointedWedge

/-- The canonical inclusion of the left summand into a pointed wedge. -/
def left {X : Type u} (x₀ : X) {Y : Type v} (y₀ : Y) (x : X) :
    PointedWedge X x₀ Y y₀ :=
  IndexedPointedWedge.inclusion (Family X Y) (points x₀ y₀) false (ULift.up x)

/-- The canonical inclusion of the right summand into a pointed wedge. -/
def right {X : Type u} (x₀ : X) {Y : Type v} (y₀ : Y) (y : Y) :
    PointedWedge X x₀ Y y₀ :=
  IndexedPointedWedge.inclusion (Family X Y) (points x₀ y₀) true (ULift.up y)

/-- The common point of a pointed wedge. -/
def basepoint {X : Type u} (x₀ : X) {Y : Type v} (y₀ : Y) : PointedWedge X x₀ Y y₀ :=
  IndexedPointedWedge.point (Family X Y) (points x₀ y₀) false

/-- The two selected points have the same image in their pointed wedge. -/
theorem left_basepoint_eq_right_basepoint {X : Type u} (x₀ : X) {Y : Type v} (y₀ : Y) :
    left x₀ y₀ x₀ = right x₀ y₀ y₀ := by
  -- This is the two-factor specialization of independence of the indexed wedge point.
  exact IndexedPointedWedge.point_eq (Family X Y) (points x₀ y₀) false true

variable {X : Type u} {Y : Type v} [TopologicalSpace X] [TopologicalSpace Y]

/-- The canonical inclusion of the left summand into a pointed wedge is continuous. -/
theorem continuous_left (x₀ : X) (y₀ : Y) : Continuous (left x₀ y₀) := by
  exact continuous_quot_mk.comp (continuous_sigmaMk.comp continuous_uliftUp)

/-- The canonical inclusion of the right summand into a pointed wedge is continuous. -/
theorem continuous_right (x₀ : X) (y₀ : Y) : Continuous (right x₀ y₀) := by
  exact continuous_quot_mk.comp (continuous_sigmaMk.comp continuous_uliftUp)

/-- The canonical continuous map from the left summand into a pointed wedge. -/
def leftMap (x₀ : X) (y₀ : Y) : C(X, PointedWedge X x₀ Y y₀) :=
  ⟨left x₀ y₀, continuous_left x₀ y₀⟩

/-- The canonical continuous map from the right summand into a pointed wedge. -/
def rightMap (x₀ : X) (y₀ : Y) : C(Y, PointedWedge X x₀ Y y₀) :=
  ⟨right x₀ y₀, continuous_right x₀ y₀⟩

end Topology.PointedWedge
