module

public import Topology_Munkres_2000.Book.Definition_81_5.HomeomorphGroup
public import Mathlib.Analysis.Complex.Circle
public import Mathlib.Topology.UnitInterval

public section

open scoped unitInterval

noncomputable section

/-- The cylinder `S¹ × I`. -/
abbrev Cylinder := Circle × unitInterval

/-- The homeomorphism of the cylinder given by `(x, t) ↦ (-x, t)`. -/
def cylinderHalfTurnHomeomorph : Cylinder ≃ₜ Cylinder :=
  (Homeomorph.mulLeft (-1 : Circle)).prodCongr (Homeomorph.refl unitInterval)

/-- Evaluation of the cylinder half-turn on a point. -/
theorem cylinderHalfTurnHomeomorph_apply (point : Cylinder) :
    cylinderHalfTurnHomeomorph point = (-point.1, point.2) := by
  rcases point with ⟨x, t⟩
  simp [cylinderHalfTurnHomeomorph]

/-- The homeomorphism of the cylinder given by `(x, t) ↦ (-x, 1 - t)`. -/
def cylinderGlideReflectionHomeomorph : Cylinder ≃ₜ Cylinder :=
  (Homeomorph.mulLeft (-1 : Circle)).prodCongr unitInterval.symmHomeomorph

/-- Evaluation of the cylinder glide reflection on a point. -/
theorem cylinderGlideReflectionHomeomorph_apply (point : Cylinder) :
    cylinderGlideReflectionHomeomorph point = (-point.1, unitInterval.symm point.2) := by
  rcases point with ⟨x, t⟩
  simp [cylinderGlideReflectionHomeomorph]

/-- The transformation group generated by the cylinder half-turn. -/
def cylinderHalfTurnGroup : Subgroup (Cylinder ≃ₜ Cylinder) :=
  Subgroup.zpowers cylinderHalfTurnHomeomorph

/-- The transformation group generated by the cylinder glide reflection. -/
def cylinderGlideReflectionGroup : Subgroup (Cylinder ≃ₜ Cylinder) :=
  Subgroup.zpowers cylinderGlideReflectionHomeomorph
