open Set
open scoped HomeomorphGroup Topology

noncomputable section

/-- Helper for Example 81.3: the cylinder half-turn has order two. -/
private lemma cylinderHalfTurnHomeomorph_orderOf :
    orderOf cylinderHalfTurnHomeomorph = 2 := by
  -- Squaring negates the circle coordinate twice and fixes the interval coordinate.
  apply orderOf_eq_prime
  · apply Homeomorph.ext
    intro point
    rw [pow_two, Homeomorph.mul_apply, cylinderHalfTurnHomeomorph_apply,
      cylinderHalfTurnHomeomorph_apply]
    simp
  · intro heq
    -- Evaluation at any circle point contradicts the absence of fixed points of negation.
    have hpoint := DFunLike.congr_fun heq ((1 : Circle), (0 : unitInterval))
    have hfirst := congrArg Prod.fst hpoint
    have hneg : -(1 : Circle) = 1 := by
      simpa [cylinderHalfTurnHomeomorph_apply] using hfirst
    exact Circle.neg_ne_self (1 : Circle) hneg

/-- Helper for Example 81.3: the cylinder glide reflection has order two. -/
private lemma cylinderGlideReflectionHomeomorph_orderOf :
    orderOf cylinderGlideReflectionHomeomorph = 2 := by
  -- Both circle negation and interval reflection are involutions.
  apply orderOf_eq_prime
  · apply Homeomorph.ext
    intro point
    rw [pow_two, Homeomorph.mul_apply, cylinderGlideReflectionHomeomorph_apply,
      cylinderGlideReflectionHomeomorph_apply, unitInterval.symm_symm]
    simp
  · intro heq
    -- The negated circle coordinate again rules out the identity homeomorphism.
    have hpoint := DFunLike.congr_fun heq ((1 : Circle), (0 : unitInterval))
    have hfirst := congrArg Prod.fst hpoint
    have hneg : -(1 : Circle) = 1 := by
      simpa [cylinderGlideReflectionHomeomorph_apply] using hfirst
    exact Circle.neg_ne_self (1 : Circle) hneg

/-- Example 81.3 (1): The group generated by `(x, t) ↦ (-x, t)` consists exactly
of the identity and that half-turn. -/
theorem mem_cylinderHalfTurnGroup_iff (g : Cylinder ≃ₜ Cylinder) :
    g ∈ cylinderHalfTurnGroup ↔ g = 1 ∨ g = cylinderHalfTurnHomeomorph := by
  -- The powers of an element of order two are represented by exponents zero and one.
  classical
  unfold cylinderHalfTurnGroup
  have hfinite : IsOfFinOrder cylinderHalfTurnHomeomorph := by
    rw [← orderOf_ne_zero_iff, cylinderHalfTurnHomeomorph_orderOf]
    norm_num
  rw [hfinite.mem_zpowers_iff_mem_range_orderOf, cylinderHalfTurnHomeomorph_orderOf]
  simp only [Finset.mem_image, Finset.mem_range, Nat.lt_succ_iff]
  constructor
  · rintro ⟨exponent, hexponent, rfl⟩
    interval_cases exponent
    · exact Or.inl (pow_zero _)
    · exact Or.inr (pow_one _)
  · rintro (rfl | rfl)
    · exact ⟨0, Nat.zero_le 1, pow_zero _⟩
    · exact ⟨1, le_rfl, pow_one _⟩

/-- Companion for Example 81.3 (2): The group generated by `(x, t) ↦ (-x, 1 - t)` consists
exactly of the identity and that glide reflection. -/
theorem mem_cylinderGlideReflectionGroup_iff (g : Cylinder ≃ₜ Cylinder) :
    g ∈ cylinderGlideReflectionGroup ↔
      g = 1 ∨ g = cylinderGlideReflectionHomeomorph := by
  -- The powers of the glide reflection have the same two-element normal form.
  classical
  unfold cylinderGlideReflectionGroup
  have hfinite : IsOfFinOrder cylinderGlideReflectionHomeomorph := by
    rw [← orderOf_ne_zero_iff, cylinderGlideReflectionHomeomorph_orderOf]
    norm_num
  rw [hfinite.mem_zpowers_iff_mem_range_orderOf,
    cylinderGlideReflectionHomeomorph_orderOf]
  simp only [Finset.mem_image, Finset.mem_range, Nat.lt_succ_iff]
  constructor
  · rintro ⟨exponent, hexponent, rfl⟩
    interval_cases exponent
    · exact Or.inl (pow_zero _)
    · exact Or.inr (pow_one _)
  · rintro (rfl | rfl)
    · exact ⟨0, Nat.zero_le 1, pow_zero _⟩
    · exact ⟨1, le_rfl, pow_one _⟩

/-- Companion for Example 81.3 (3): The half-turn transformation group is cyclic of order two. -/
theorem cylinderHalfTurnGroup_isomorphic_modTwo :
    Nonempty (cylinderHalfTurnGroup ≃* Multiplicative (ZMod 2)) := by
  -- Both cyclic groups have prime cardinality two.
  refine ⟨mulEquivOfPrimeCardEq (p := 2) ?_ ?_⟩
  · unfold cylinderHalfTurnGroup
    rw [Nat.card_zpowers, cylinderHalfTurnHomeomorph_orderOf]
  · exact Nat.card_zmod 2

/-- Companion for Example 81.3 (4): The glide-reflection transformation group is cyclic of
order two. -/
theorem cylinderGlideReflectionGroup_isomorphic_modTwo :
    Nonempty (cylinderGlideReflectionGroup ≃* Multiplicative (ZMod 2)) := by
  -- Cardinality two likewise identifies the glide-reflection group with `ZMod 2`.
  refine ⟨mulEquivOfPrimeCardEq (p := 2) ?_ ?_⟩
  · unfold cylinderGlideReflectionGroup
    rw [Nat.card_zpowers, cylinderGlideReflectionHomeomorph_orderOf]
  · exact Nat.card_zmod 2

/-- Helper for Example 81.3: the cylinder half-turn group is finite. -/
private instance instFiniteCylinderHalfTurnGroup : Finite cylinderHalfTurnGroup := by
  -- Transfer finiteness across the explicit equivalence with `ZMod 2`.
  exact Finite.of_injective cylinderHalfTurnGroup_isomorphic_modTwo.some
    cylinderHalfTurnGroup_isomorphic_modTwo.some.injective

/-- Helper for Example 81.3: the cylinder glide-reflection group is finite. -/
private instance instFiniteCylinderGlideReflectionGroup :
    Finite cylinderGlideReflectionGroup := by
  -- Transfer finiteness across the explicit equivalence with `ZMod 2`.
  exact Finite.of_injective cylinderGlideReflectionGroup_isomorphic_modTwo.some
    cylinderGlideReflectionGroup_isomorphic_modTwo.some.injective

/-- Companion for Example 81.3 (5): The half-turn group acts properly discontinuously on the
cylinder. -/
instance cylinderHalfTurnGroup_properlyDiscontinuous :
    ProperlyDiscontinuousMulAction cylinderHalfTurnGroup Cylinder := by
  refine { exists_nhds_disjoint_image := ?_ }
  intro point
  -- Finiteness supplies a neighborhood disjoint from every translate moving the point.
  obtain ⟨U, hU, hdisjoint⟩ :=
    ProperlyDiscontinuousSMul.exists_nhds_disjoint_image cylinderHalfTurnGroup point
  refine ⟨U, hU, ?_⟩
  intro g hg
  apply hdisjoint g
  intro hfixed
  -- The two-element normal form reduces freeness to circle negation.
  have hclass := mem_cylinderHalfTurnGroup_iff (g : Cylinder ≃ₜ Cylinder) |>.mp g.property
  rcases hclass with hid | hturn
  · exact hg (Subtype.ext hid)
  · change (g : Cylinder ≃ₜ Cylinder) point = point at hfixed
    rw [hturn, cylinderHalfTurnHomeomorph_apply] at hfixed
    exact Circle.neg_ne_self point.1 (congrArg Prod.fst hfixed)

/-- Companion for Example 81.3 (6): The glide-reflection group acts properly discontinuously on
the cylinder. -/
instance cylinderGlideReflectionGroup_properlyDiscontinuous :
    ProperlyDiscontinuousMulAction cylinderGlideReflectionGroup Cylinder := by
  refine { exists_nhds_disjoint_image := ?_ }
  intro point
  -- Finiteness supplies the compact-action neighborhood as above.
  obtain ⟨U, hU, hdisjoint⟩ :=
    ProperlyDiscontinuousSMul.exists_nhds_disjoint_image cylinderGlideReflectionGroup point
  refine ⟨U, hU, ?_⟩
  intro g hg
  apply hdisjoint g
  intro hfixed
  -- Every nonidentity element is the glide reflection, which negates the circle coordinate.
  have hclass :=
    mem_cylinderGlideReflectionGroup_iff (g : Cylinder ≃ₜ Cylinder) |>.mp g.property
  rcases hclass with hid | hglide
  · exact hg (Subtype.ext hid)
  · change (g : Cylinder ≃ₜ Cylinder) point = point at hfixed
    rw [hglide, cylinderGlideReflectionHomeomorph_apply] at hfixed
    exact Circle.neg_ne_self point.1 (congrArg Prod.fst hfixed)

/-- Helper for Example 81.3: the half-turn generator belongs to its generated group. -/
private lemma cylinderHalfTurnHomeomorph_mem_group :
    cylinderHalfTurnHomeomorph ∈ cylinderHalfTurnGroup := by
  -- This is the distinguished generator of the named `zpowers` subgroup.
  unfold cylinderHalfTurnGroup
  exact Subgroup.mem_zpowers cylinderHalfTurnHomeomorph

/-- Helper for Example 81.3: square the circle coordinate of a cylinder point. -/
private def cylinderSquareMap : Cylinder → Cylinder :=
  fun point ↦ (point.1 ^ 2, point.2)

/-- Helper for Example 81.3: the cylinder square map is continuous. -/
private lemma continuous_cylinderSquareMap : Continuous cylinderSquareMap := by
  -- Continuity follows componentwise from continuity of powers and projections.
  exact Continuous.prodMk (continuous_fst.pow 2) continuous_snd

/-- Helper for Example 81.3: the cylinder square map is surjective. -/
private lemma cylinderSquareMap_surjective : Function.Surjective cylinderSquareMap := by
  intro point
  -- Lift an argument of the circle coordinate and halve it to obtain a square root.
  obtain ⟨theta, htheta⟩ := Circle.exp_surjective point.1
  let root : Circle := Circle.exp (theta / 2)
  refine ⟨(root, point.2), ?_⟩
  apply Prod.ext
  · dsimp only [cylinderSquareMap, root]
    have hdouble : (2 : ℝ) * (theta / 2) = theta := by
      ring
    calc
      Circle.exp (theta / 2) ^ 2 = Circle.exp ((2 : ℕ) * (theta / 2)) :=
        (Circle.exp_natCast_mul (theta / 2) 2).symm
      _ = Circle.exp theta := congrArg Circle.exp hdouble
      _ = point.1 := htheta
  · rfl

/-- Helper for Example 81.3: the cylinder square map presents its codomain as a quotient. -/
private lemma cylinderSquareMap_isQuotientMap :
    Topology.IsQuotientMap cylinderSquareMap := by
  -- A continuous surjection from the compact cylinder to the Hausdorff cylinder is quotient.
  exact Topology.IsQuotientMap.of_surjective_continuous
    cylinderSquareMap_surjective continuous_cylinderSquareMap

/-- Helper for Example 81.3: equal squares on the circle mean equality or antipodality. -/
private lemma circle_sq_eq_sq_iff (x y : Circle) :
    x ^ 2 = y ^ 2 ↔ x = y ∨ x = -y := by
  constructor
  · intro hsquare
    -- Coerce to the complex numbers, where the standard integral-domain factorization applies.
    have hcomplex : (x : ℂ) ^ 2 = (y : ℂ) ^ 2 := by
      simpa only [Circle.coe_pow] using congrArg Subtype.val hsquare
    rw [sq_eq_sq_iff_eq_or_eq_neg] at hcomplex
    rcases hcomplex with hsame | hneg
    · exact Or.inl (Circle.ext hsame)
    · apply Or.inr
      apply Circle.ext
      simpa only [Circle.coe_neg] using hneg
  · rintro (rfl | hneg)
    · rfl
    · rw [hneg]
      simp

/-- Helper for Example 81.3: square-map fibers are exactly half-turn orbits. -/
private lemma cylinderHalfTurnOrbit_iff_squareMap_eq (x y : Cylinder) :
    y ∈ MulAction.orbit cylinderHalfTurnGroup x ↔
      cylinderSquareMap x = cylinderSquareMap y := by
  constructor
  · rw [HomeomorphGroup.mem_orbit_iff]
    rintro ⟨g, hg⟩
    -- Classify the acting element as the identity or the half-turn.
    have hclass := mem_cylinderHalfTurnGroup_iff (g : Cylinder ≃ₜ Cylinder) |>.mp g.property
    rcases hclass with hid | hturn
    · have hxy : x = y := by
        simpa [hid] using hg
      exact congrArg cylinderSquareMap hxy
    · rw [← hg, hturn, cylinderHalfTurnHomeomorph_apply]
      apply Prod.ext
      · simp [cylinderSquareMap]
      · rfl
  · intro hsquare
    -- Equality of squares gives equality or antipodality in the circle coordinate.
    have hfirstRaw := congrArg Prod.fst hsquare
    have hfirst : x.1 ^ 2 = y.1 ^ 2 := by
      simpa only [cylinderSquareMap] using hfirstRaw
    have hsecondRaw := congrArg Prod.snd hsquare
    have hsecond : x.2 = y.2 := by
      simpa only [cylinderSquareMap] using hsecondRaw
    rw [circle_sq_eq_sq_iff] at hfirst
    rw [HomeomorphGroup.mem_orbit_iff]
    rcases hfirst with hsame | hneg
    · have hxy : x = y := Prod.ext hsame hsecond
      refine ⟨1, ?_⟩
      simpa using hxy
    · have hantipodal : -x.1 = y.1 := by
        simpa only [neg_neg] using congrArg Neg.neg hneg
      refine ⟨⟨cylinderHalfTurnHomeomorph,
        cylinderHalfTurnHomeomorph_mem_group⟩, ?_⟩
      rw [cylinderHalfTurnHomeomorph_apply]
      exact Prod.ext hantipodal hsecond

/-- Helper for Example 81.3: the half-turn orbit projection and square map have the same fibers. -/
private lemma cylinderHalfTurnProjection_eq_iff (x y : Cylinder) :
    HomeomorphGroup.mk cylinderHalfTurnGroup x =
        HomeomorphGroup.mk cylinderHalfTurnGroup y ↔
      cylinderSquareMap x = cylinderSquareMap y := by
  -- Orbit-projection equality is orbit membership, classified by the preceding fiber theorem.
  rw [HomeomorphGroup.mk_eq_mk_iff, cylinderHalfTurnOrbit_iff_squareMap_eq]

/-- Companion for Example 81.3 (7): The quotient by the half-turn action is homeomorphic to the
cylinder. -/
theorem cylinderHalfTurnQuotient_homeomorphic :
    Nonempty (Cylinder / cylinderHalfTurnGroup ≃ₜ Cylinder) := by
  -- Compare the orbit projection with the square map through their identical kernels.
  let orbitProjection : C(Cylinder, Cylinder / cylinderHalfTurnGroup) :=
    ⟨HomeomorphGroup.mk cylinderHalfTurnGroup,
      HomeomorphGroup.isQuotientMap_mk cylinderHalfTurnGroup |>.continuous⟩
  let squareMap : C(Cylinder, Cylinder) :=
    ⟨cylinderSquareMap, continuous_cylinderSquareMap⟩
  obtain ⟨homeomorphism, _⟩ := CyclicPolygon.existsHomeomorphOfQuotientPresentations
    orbitProjection squareMap (HomeomorphGroup.isQuotientMap_mk cylinderHalfTurnGroup)
      cylinderSquareMap_isQuotientMap (Homeomorph.refl Cylinder)
      cylinderHalfTurnProjection_eq_iff
  exact ⟨homeomorphism⟩

/-- Helper for Example 81.3: the upper semicircle is the canonical path from `1` to `-1`. -/
private def cylinderUpperSemicircle : unitInterval → Circle :=
  fun t ↦ Circle.path 1 (-1) t

/-- Helper for Example 81.3: the upper-semicircle parametrization is continuous. -/
private lemma continuous_cylinderUpperSemicircle : Continuous cylinderUpperSemicircle := by
  -- It is the underlying map of the canonical circle path.
  exact (Circle.path (1 : Circle) (-1)).continuous

/-- Helper for Example 81.3: the upper-semicircle parametrization is injective. -/
private lemma cylinderUpperSemicircle_injective :
    Function.Injective cylinderUpperSemicircle := by
  -- The endpoints `1` and `-1` are distinct, so the canonical arc is injective.
  have hendpoints : (1 : Circle) ≠ -1 := (Circle.neg_ne_self 1).symm
  exact Circle.path_injective_of_ne hendpoints

/-- Helper for Example 81.3: the upper semicircle starts at `1`. -/
private lemma cylinderUpperSemicircle_zero : cylinderUpperSemicircle 0 = 1 := by
  -- This is the source endpoint of the canonical path.
  exact (Circle.path (1 : Circle) (-1)).source

/-- Helper for Example 81.3: the upper semicircle ends at `-1`. -/
private lemma cylinderUpperSemicircle_one : cylinderUpperSemicircle 1 = -1 := by
  -- This is the target endpoint of the canonical path.
  exact (Circle.path (1 : Circle) (-1)).target

/-- Helper for Example 81.3: the upper semicircle has the standard exponential formula. -/
private lemma cylinderUpperSemicircle_eq_exp (t : unitInterval) :
    cylinderUpperSemicircle t = Circle.exp (Real.pi * (t : ℝ)) := by
  -- Evaluate the canonical path after normalizing the endpoint arguments.
  unfold cylinderUpperSemicircle
  rw [Circle.path_apply]
  apply congrArg Circle.exp
  have honeArg : Complex.arg ((1 : Circle) : ℂ) = 0 := by
    simpa only [Circle.coe_one] using Complex.arg_one
  have hnegOneArg : Complex.arg (((-1 : Circle) : ℂ)) = Real.pi := by
    simpa only [Circle.coe_neg, Circle.coe_one] using Complex.arg_neg_one
  unfold Circle.angleDiff
  rw [honeArg, hnegOneArg, if_pos Real.pi_pos.le]
  unfold Path.segment
  simp only [Path.coe_mk_mk]
  rw [AffineMap.lineMap_apply]
  simp only [vsub_eq_sub, smul_eq_mul, vadd_eq_add]
  ring

/-- Helper for Example 81.3: the complementary lower path has its standard exponential formula. -/
private lemma cylinderLowerSemicircle_eq_exp (t : unitInterval) :
    Circle.path (-1) 1 t = Circle.exp (Real.pi + Real.pi * (t : ℝ)) := by
  -- The lower path runs from angle `π` to angle `2π`.
  rw [Circle.path_apply]
  apply congrArg Circle.exp
  have honeArg : Complex.arg ((1 : Circle) : ℂ) = 0 := by
    simpa only [Circle.coe_one] using Complex.arg_one
  have hnegOneArg : Complex.arg (((-1 : Circle) : ℂ)) = Real.pi := by
    simpa only [Circle.coe_neg, Circle.coe_one] using Complex.arg_neg_one
  have hpi : ¬Real.pi ≤ 0 := not_le_of_gt Real.pi_pos
  unfold Circle.angleDiff
  rw [hnegOneArg, honeArg, if_neg hpi]
  unfold Path.segment
  simp only [Path.coe_mk_mk]
  rw [AffineMap.lineMap_apply]
  simp only [vsub_eq_sub, smul_eq_mul, vadd_eq_add]
  ring

/-- Helper for Example 81.3: the circle exponential at `π` is `-1`. -/
private lemma circleExp_pi_eq_neg_one : Circle.exp Real.pi = (-1 : Circle) := by
  -- Coercion to `ℂ` reduces this to Euler's formula at `π`.
  apply Circle.ext
  simp [Circle.coe_exp, Complex.exp_pi_mul_I]

/-- Helper for Example 81.3: negating the upper arc gives the complementary lower arc. -/
private lemma neg_cylinderUpperSemicircle_eq_lower (t : unitInterval) :
    -cylinderUpperSemicircle t = Circle.path (-1) 1 t := by
  -- Multiplication by `-1 = exp π` shifts the angular parametrization by `π`.
  rw [cylinderUpperSemicircle_eq_exp, cylinderLowerSemicircle_eq_exp]
  calc
    -Circle.exp (Real.pi * (t : ℝ)) =
        Circle.exp Real.pi * Circle.exp (Real.pi * (t : ℝ)) := by
          rw [circleExp_pi_eq_neg_one, neg_one_mul]
    _ = Circle.exp (Real.pi + Real.pi * (t : ℝ)) :=
      (Circle.exp_add Real.pi (Real.pi * (t : ℝ))).symm

/-- Helper for Example 81.3: a negated upper-arc point returns to the upper arc only at
endpoints. -/
private lemma neg_cylinderUpperSemicircle_eq_iff (s t : unitInterval) :
    -cylinderUpperSemicircle s = cylinderUpperSemicircle t ↔
      (s = 0 ∧ t = 1) ∨ (s = 1 ∧ t = 0) := by
  constructor
  · intro heq
    -- The common point lies in both complementary canonical arcs.
    have hlower : Circle.path (-1) 1 s = cylinderUpperSemicircle t :=
      (neg_cylinderUpperSemicircle_eq_lower s).symm.trans heq
    have hintersection : cylinderUpperSemicircle t ∈
        Set.range (Circle.path (1 : Circle) (-1)) ∩
          Set.range (Circle.path (-1) 1) := by
      exact ⟨⟨t, rfl⟩, ⟨s, hlower⟩⟩
    have hendpoints : (1 : Circle) ≠ -1 := (Circle.neg_ne_self 1).symm
    rw [Circle.range_path_inter_range_path hendpoints] at hintersection
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hintersection
    rcases hintersection with htone | htnegone
    · have ht : t = 0 := cylinderUpperSemicircle_injective
        (htone.trans cylinderUpperSemicircle_zero.symm)
      have hsvalue : cylinderUpperSemicircle s = -1 := by
        calc
          cylinderUpperSemicircle s = -cylinderUpperSemicircle t := by
            simpa only [neg_neg] using congrArg Neg.neg heq
          _ = -1 := congrArg Neg.neg htone
      have hs : s = 1 := cylinderUpperSemicircle_injective
        (hsvalue.trans cylinderUpperSemicircle_one.symm)
      exact Or.inr ⟨hs, ht⟩
    · have ht : t = 1 := cylinderUpperSemicircle_injective
        (htnegone.trans cylinderUpperSemicircle_one.symm)
      have hsvalue : cylinderUpperSemicircle s = 1 := by
        calc
          cylinderUpperSemicircle s = -cylinderUpperSemicircle t := by
            simpa only [neg_neg] using congrArg Neg.neg heq
          _ = 1 := by simpa only [neg_neg] using congrArg Neg.neg htnegone
      have hs : s = 0 := cylinderUpperSemicircle_injective
        (hsvalue.trans cylinderUpperSemicircle_zero.symm)
      exact Or.inl ⟨hs, ht⟩
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · rw [cylinderUpperSemicircle_zero, cylinderUpperSemicircle_one]
    · rw [cylinderUpperSemicircle_one, cylinderUpperSemicircle_zero]
      simp

/-- Helper for Example 81.3: every circle point is on the upper arc or its negative. -/
private lemma exists_cylinderUpperSemicircle_eq_or_neg_eq (z : Circle) :
    ∃ t : unitInterval,
      z = cylinderUpperSemicircle t ∨ z = -cylinderUpperSemicircle t := by
  -- The two complementary canonical paths cover the circle.
  have hendpoints : (1 : Circle) ≠ -1 := (Circle.neg_ne_self 1).symm
  have hcover := Circle.range_path_union_range_path hendpoints
  have hz : z ∈ Set.range (Circle.path (1 : Circle) (-1)) ∪
      Set.range (Circle.path (-1) 1) := by
    rw [hcover]
    exact Set.mem_univ z
  rcases hz with ⟨t, ht⟩ | ⟨t, ht⟩
  · exact ⟨t, Or.inl ht.symm⟩
  · refine ⟨t, Or.inr ?_⟩
    exact ht.symm.trans (neg_cylinderUpperSemicircle_eq_lower t).symm

/-- Helper for Example 81.3: the glide-reflection generator belongs to its generated group. -/
private lemma cylinderGlideReflectionHomeomorph_mem_group :
    cylinderGlideReflectionHomeomorph ∈ cylinderGlideReflectionGroup := by
  -- This is the distinguished generator of the named `zpowers` subgroup.
  unfold cylinderGlideReflectionGroup
  exact Subgroup.mem_zpowers cylinderGlideReflectionHomeomorph

/-- Helper for Example 81.3: the upper semicircle gives a fundamental-domain map to glide orbits. -/
private def cylinderGlideFundamentalMap :
    UnitSquare → Cylinder / cylinderGlideReflectionGroup :=
  fun point ↦ HomeomorphGroup.mk cylinderGlideReflectionGroup
    (cylinderUpperSemicircle point.1, point.2)

/-- Helper for Example 81.3: the glide fundamental-domain map is continuous. -/
private lemma continuous_cylinderGlideFundamentalMap :
    Continuous cylinderGlideFundamentalMap := by
  -- Combine the continuous upper arc with the orbit projection.
  apply (HomeomorphGroup.isQuotientMap_mk cylinderGlideReflectionGroup).continuous.comp
  exact Continuous.prodMk
    (continuous_cylinderUpperSemicircle.comp continuous_fst) continuous_snd

/-- Helper for Example 81.3: the glide fundamental-domain map is surjective. -/
private lemma cylinderGlideFundamentalMap_surjective :
    Function.Surjective cylinderGlideFundamentalMap := by
  intro orbitPoint
  -- Choose a cylinder representative, then move it into the upper-semicircle domain.
  obtain ⟨point, rfl⟩ :=
    (HomeomorphGroup.isQuotientMap_mk cylinderGlideReflectionGroup).surjective orbitPoint
  obtain ⟨s, hupper | hnegative⟩ :=
    exists_cylinderUpperSemicircle_eq_or_neg_eq point.1
  · refine ⟨(s, point.2), ?_⟩
    have hpoint : (cylinderUpperSemicircle s, point.2) = point :=
      Prod.ext hupper.symm rfl
    exact congrArg (HomeomorphGroup.mk cylinderGlideReflectionGroup) hpoint
  · refine ⟨(s, unitInterval.symm point.2), ?_⟩
    unfold cylinderGlideFundamentalMap
    rw [HomeomorphGroup.mk_eq_mk_iff, HomeomorphGroup.mem_orbit_iff]
    refine ⟨⟨cylinderGlideReflectionHomeomorph,
      cylinderGlideReflectionHomeomorph_mem_group⟩, ?_⟩
    rw [cylinderGlideReflectionHomeomorph_apply, unitInterval.symm_symm]
    exact Prod.ext hnegative.symm rfl

/-- Helper for Example 81.3: the glide fundamental-domain map is a quotient map. -/
private lemma cylinderGlideFundamentalMap_isQuotientMap :
    Topology.IsQuotientMap cylinderGlideFundamentalMap := by
  -- A continuous surjection from the compact square to the Hausdorff orbit space is quotient.
  exact Topology.IsQuotientMap.of_surjective_continuous
    cylinderGlideFundamentalMap_surjective continuous_cylinderGlideFundamentalMap

/-- Helper for Example 81.3: equality of glide fundamental-domain images is Möbius gluing. -/
private lemma cylinderGlideFundamentalMap_eq_iff (p q : UnitSquare) :
    cylinderGlideFundamentalMap p = cylinderGlideFundamentalMap q ↔
      p = q ∨ mobiusBandGlue p q ∨ mobiusBandGlue q p := by
  constructor
  · intro heq
    -- Orbit equality is witnessed by either the identity or the glide reflection.
    rw [cylinderGlideFundamentalMap, cylinderGlideFundamentalMap,
      HomeomorphGroup.mk_eq_mk_iff, HomeomorphGroup.mem_orbit_iff] at heq
    obtain ⟨g, hg⟩ := heq
    have hclass :=
      mem_cylinderGlideReflectionGroup_iff (g : Cylinder ≃ₜ Cylinder) |>.mp g.property
    rcases hclass with hid | hglide
    · have hpoints : (cylinderUpperSemicircle p.1, p.2) =
          (cylinderUpperSemicircle q.1, q.2) := by
        simpa [hid] using hg
      have hfirst : p.1 = q.1 := cylinderUpperSemicircle_injective
        (congrArg Prod.fst hpoints)
      have hsecond : p.2 = q.2 :=
        congrArg (fun point : Cylinder ↦ point.2) hpoints
      exact Or.inl (Prod.ext hfirst hsecond)
    · rw [hglide, cylinderGlideReflectionHomeomorph_apply] at hg
      have hcircle : -cylinderUpperSemicircle p.1 =
          cylinderUpperSemicircle q.1 := congrArg Prod.fst hg
      have hinterval : unitInterval.symm p.2 = q.2 := congrArg Prod.snd hg
      rw [neg_cylinderUpperSemicircle_eq_iff] at hcircle
      rcases hcircle with ⟨hpzero, hqone⟩ | ⟨hpone, hqzero⟩
      · apply Or.inr
        apply Or.inl
        rw [mobiusBandGlue_iff]
        refine ⟨hpzero, hqone, ?_⟩
        have hreflected := congrArg unitInterval.symm hinterval
        simpa only [unitInterval.symm_symm] using hreflected
      · apply Or.inr
        apply Or.inr
        rw [mobiusBandGlue_iff]
        exact ⟨hqzero, hpone, hinterval.symm⟩
  · intro hrelation
    -- Each allowed square relation is realized by the identity or by one glide reflection.
    rcases hrelation with rfl | hpq | hqp
    · rfl
    · rw [cylinderGlideFundamentalMap, cylinderGlideFundamentalMap,
        HomeomorphGroup.mk_eq_mk_iff, HomeomorphGroup.mem_orbit_iff]
      rw [mobiusBandGlue_iff] at hpq
      refine ⟨⟨cylinderGlideReflectionHomeomorph,
        cylinderGlideReflectionHomeomorph_mem_group⟩, ?_⟩
      rw [cylinderGlideReflectionHomeomorph_apply]
      apply Prod.ext
      · rw [hpq.1, hpq.2.1, cylinderUpperSemicircle_zero,
          cylinderUpperSemicircle_one]
      · have hreflected := congrArg unitInterval.symm hpq.2.2
        simpa only [unitInterval.symm_symm] using hreflected
    · rw [cylinderGlideFundamentalMap, cylinderGlideFundamentalMap,
        HomeomorphGroup.mk_eq_mk_iff, HomeomorphGroup.mem_orbit_iff]
      rw [mobiusBandGlue_iff] at hqp
      refine ⟨⟨cylinderGlideReflectionHomeomorph,
        cylinderGlideReflectionHomeomorph_mem_group⟩, ?_⟩
      rw [cylinderGlideReflectionHomeomorph_apply]
      apply Prod.ext
      · rw [hqp.1, hqp.2.1, cylinderUpperSemicircle_one,
          cylinderUpperSemicircle_zero]
        simp
      · exact hqp.2.2.symm

/-- Helper for Example 81.3: the glide fundamental domain and Möbius projection have equal
fibers. -/
private lemma cylinderGlideKernel_eq_mobiusKernel (p q : UnitSquare) :
    cylinderGlideFundamentalMap p = cylinderGlideFundamentalMap q ↔
      (Quotient.mk (Relation.EqvGen.setoid mobiusBandGlue) p : MobiusBand) =
        Quotient.mk (Relation.EqvGen.setoid mobiusBandGlue) q := by
  -- Both kernels are equality or one directed boundary gluing in either direction.
  rw [cylinderGlideFundamentalMap_eq_iff, mobiusBandQuotient_mk_eq_iff]

/-- Companion for Example 81.3 (8): The quotient by the glide-reflection action is homeomorphic
to the Möbius band. -/
theorem cylinderGlideReflectionQuotient_homeomorphic :
    Nonempty (Cylinder / cylinderGlideReflectionGroup ≃ₜ MobiusBand) := by
  -- Compare the fundamental-domain quotient with the standard Möbius-band presentation.
  let glideMap : C(UnitSquare, Cylinder / cylinderGlideReflectionGroup) :=
    ⟨cylinderGlideFundamentalMap, continuous_cylinderGlideFundamentalMap⟩
  let mobiusMap : C(UnitSquare, MobiusBand) :=
    ⟨fun point ↦ Quotient.mk (Relation.EqvGen.setoid mobiusBandGlue) point,
      mobiusBandQuotientMap_isQuotientMap.continuous⟩
  obtain ⟨homeomorphism, _⟩ := CyclicPolygon.existsHomeomorphOfQuotientPresentations
    glideMap mobiusMap cylinderGlideFundamentalMap_isQuotientMap
      mobiusBandQuotientMap_isQuotientMap (Homeomorph.refl UnitSquare)
      cylinderGlideKernel_eq_mobiusKernel
  exact ⟨homeomorphism⟩
