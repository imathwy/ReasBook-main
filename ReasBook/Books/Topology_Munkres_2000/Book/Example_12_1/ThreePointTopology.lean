module

public import Mathlib.Topology.Order

public section

open Set

namespace ThreePointTopology

/-- The labeled three-element set `X = {a, b, c}` used in Figure 12.1. -/
inductive ThreePoint where
  | a
  | b
  | c
  deriving DecidableEq

/-- The nine topologies displayed in Figure 12.1, named by their nontrivial open sets. -/
inductive Displayed where
  | indiscrete
  | aAndAB
  | bAndABAndBC
  | bOnly
  | aAndBC
  | bAndCAndAB
  | abOnly
  | aAndB
  | discrete
  deriving DecidableEq

/-- The explicit family of open sets represented by each diagram in Figure 12.1. -/
def openSets : Displayed → Set (Set ThreePoint)
  | .indiscrete => {s | s = ∅ ∨ s = Set.univ}
  | .aAndAB => {s | s = ∅ ∨ s = {.a} ∨ s = {.a, .b} ∨ s = Set.univ}
  | .bAndABAndBC =>
      {s | s = ∅ ∨ s = {.b} ∨ s = {.a, .b} ∨ s = {.b, .c} ∨ s = Set.univ}
  | .bOnly => {s | s = ∅ ∨ s = {.b} ∨ s = Set.univ}
  | .aAndBC => {s | s = ∅ ∨ s = {.a} ∨ s = {.b, .c} ∨ s = Set.univ}
  | .bAndCAndAB =>
      {s |
        s = ∅ ∨ s = {.b} ∨ s = {.c} ∨ s = {.a, .b} ∨ s = {.b, .c} ∨
          s = Set.univ}
  | .abOnly => {s | s = ∅ ∨ s = {.a, .b} ∨ s = Set.univ}
  | .aAndB =>
      {s | s = ∅ ∨ s = {.a} ∨ s = {.b} ∨ s = {.a, .b} ∨ s = Set.univ}
  | .discrete => Set.univ

/-- Membership in any displayed open-set family reduces to its explicit branch. -/
lemma mem_openSets_iff (t : Displayed) (s : Set ThreePoint) :
    s ∈ openSets t ↔
      match t with
      | .indiscrete => s = ∅ ∨ s = Set.univ
      | .aAndAB => s = ∅ ∨ s = {.a} ∨ s = {.a, .b} ∨ s = Set.univ
      | .bAndABAndBC =>
          s = ∅ ∨ s = {.b} ∨ s = {.a, .b} ∨ s = {.b, .c} ∨ s = Set.univ
      | .bOnly => s = ∅ ∨ s = {.b} ∨ s = Set.univ
      | .aAndBC => s = ∅ ∨ s = {.a} ∨ s = {.b, .c} ∨ s = Set.univ
      | .bAndCAndAB =>
          s = ∅ ∨ s = {.b} ∨ s = {.c} ∨ s = {.a, .b} ∨ s = {.b, .c} ∨
            s = Set.univ
      | .abOnly => s = ∅ ∨ s = {.a, .b} ∨ s = Set.univ
      | .aAndB => s = ∅ ∨ s = {.a} ∨ s = {.b} ∨ s = {.a, .b} ∨ s = Set.univ
      | .discrete => True := by
  -- Eliminate the displayed topology while the defining equations remain available.
  cases t <;> rfl

/-- Helper for Exercise 13.4: membership in the first displayed family has its listed form. -/
lemma mem_openSets_aAndAB_iff (s : Set ThreePoint) :
    s ∈ openSets .aAndAB ↔ s = ∅ ∨ s = {.a} ∨ s = {.a, .b} ∨ s = Set.univ := by
  -- Reduce the selected branch of `openSets` to its explicit set-builder predicate.
  rfl

/-- Helper for Example 17.9: membership in the Figure 17.3 family has its listed form. -/
lemma mem_openSets_bAndABAndBC_iff (s : Set ThreePoint) :
    s ∈ openSets .bAndABAndBC ↔
      s = ∅ ∨ s = {.b} ∨ s = {.a, .b} ∨ s = {.b, .c} ∨ s = Set.univ := by
  -- Reduce the selected branch of `openSets` to its explicit set-builder predicate.
  rfl

/-- Helper for Exercise 13.4: membership in the second displayed family has its listed form. -/
lemma mem_openSets_aAndBC_iff (s : Set ThreePoint) :
    s ∈ openSets .aAndBC ↔ s = ∅ ∨ s = {.a} ∨ s = {.b, .c} ∨ s = Set.univ := by
  -- Reduce the selected branch of `openSets` to its explicit set-builder predicate.
  rfl

/-- The topology represented by a diagram in Figure 12.1. -/
@[reducible]
def topology (t : Displayed) : TopologicalSpace ThreePoint :=
  TopologicalSpace.generateFrom (openSets t)

/-- Helper for Exercise 13.4: a displayed topology is generated by its displayed open family. -/
lemma topology_eq_generateFrom (t : Displayed) :
    topology t = TopologicalSpace.generateFrom (openSets t) := by
  -- Expose the defining equation once inside the canonical owner module.
  rfl

/-- Mathlib's neighborhood filter for the topology represented by a diagram in Figure 12.1. -/
abbrev Displayed.neighborhoods (t : Displayed) (x : ThreePoint) : Filter ThreePoint :=
  @_root_.nhds ThreePoint (topology t) x

/-- The displayed neighborhood filter is the canonical neighborhood filter for its topology. -/
@[simp]
theorem Displayed.neighborhoods_eq (t : Displayed) (x : ThreePoint) :
    t.neighborhoods x = @_root_.nhds ThreePoint (topology t) x := rfl

/-- Helper for Example 12.1: a proposition on `ThreePoint` holds everywhere exactly when it
holds at `a`, `b`, and `c`. -/
@[simp]
private lemma forall_threePoint (p : ThreePoint → Prop) :
    (∀ x, p x) ↔ p .a ∧ p .b ∧ p .c := by
  constructor
  · intro h
    exact ⟨h .a, h .b, h .c⟩
  · rintro ⟨ha, hb, hc⟩ x
    cases x
    · exact ha
    · exact hb
    · exact hc

/-- Helper for Example 12.1: each displayed open-set family is finite. -/
private lemma openSets_finite (t : Displayed) : (openSets t).Finite := by
  -- Rewrite each explicit predicate as a finite set of subsets.
  cases t
  · rw [show openSets .indiscrete = {∅, Set.univ} by ext s; simp [openSets]]
    exact Set.toFinite _
  · rw [show openSets .aAndAB = {∅, {.a}, {.a, .b}, Set.univ} by ext s; simp [openSets]]
    exact Set.toFinite _
  · rw [show openSets .bAndABAndBC = {∅, {.b}, {.a, .b}, {.b, .c}, Set.univ} by
      ext s
      simp [openSets]]
    exact Set.toFinite _
  · rw [show openSets .bOnly = {∅, {.b}, Set.univ} by ext s; simp [openSets]]
    exact Set.toFinite _
  · rw [show openSets .aAndBC = {∅, {.a}, {.b, .c}, Set.univ} by ext s; simp [openSets]]
    exact Set.toFinite _
  · rw [show openSets .bAndCAndAB = {∅, {.b}, {.c}, {.a, .b}, {.b, .c}, Set.univ} by
      ext s
      simp [openSets]]
    exact Set.toFinite _
  · rw [show openSets .abOnly = {∅, {.a, .b}, Set.univ} by ext s; simp [openSets]]
    exact Set.toFinite _
  · rw [show openSets .aAndB = {∅, {.a}, {.b}, {.a, .b}, Set.univ} by
      ext s
      simp [openSets]]
    exact Set.toFinite _
  · rw [show openSets .discrete =
        {∅, {.a}, {.b}, {.c}, {.a, .b}, {.a, .c}, {.b, .c}, Set.univ} by
      ext s
      simp [openSets, Set.ext_iff]
      tauto]
    exact Set.toFinite _

/-- Helper for Example 12.1: the two overlapping displayed pairs cover all three points. -/
@[simp]
private lemma pair_union_pair :
    ({ThreePoint.a, ThreePoint.b} : Set ThreePoint) ∪ {ThreePoint.b, ThreePoint.c} = Set.univ := by
  -- Check membership at each of the three constructors.
  ext x
  cases x <;> simp

/-- Helper for Example 12.1: the two overlapping displayed pairs meet at `b`. -/
@[simp]
private lemma pair_inter_pair :
    ({ThreePoint.a, ThreePoint.b} : Set ThreePoint) ∩ {ThreePoint.b, ThreePoint.c} = {.b} := by
  -- Check membership at each of the three constructors.
  ext x
  cases x <;> simp

/-- Helper for Example 12.1: the empty set belongs to every displayed open-set family. -/
private lemma openSets_empty_mem (t : Displayed) : (∅ : Set ThreePoint) ∈ openSets t := by
  -- The empty set is the first listed member in every non-discrete branch.
  cases t <;> simp only [mem_openSets_iff] <;> simp

/-- Helper for Example 12.1: each displayed open-set family is closed under unions. -/
private lemma openSets_union_mem (t : Displayed) {s u : Set ThreePoint}
    (hs : s ∈ openSets t) (hu : u ∈ openSets t) : s ∪ u ∈ openSets t := by
  -- Substitute the finitely many listed open sets and normalize their unions.
  cases t <;> simp only [mem_openSets_iff] at hs hu ⊢ <;>
    rcases hs with rfl | rfl | rfl | rfl | rfl | rfl <;>
    rcases hu with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [Set.ext_iff]

/-- Helper for Example 12.1: each displayed open-set family is closed under intersections. -/
private lemma openSets_inter_mem (t : Displayed) {s u : Set ThreePoint}
    (hs : s ∈ openSets t) (hu : u ∈ openSets t) : s ∩ u ∈ openSets t := by
  -- Substitute the finitely many listed open sets and normalize their intersections.
  cases t <;> simp only [mem_openSets_iff] at hs hu ⊢ <;>
    rcases hs with rfl | rfl | rfl | rfl | rfl | rfl <;>
    rcases hu with rfl | rfl | rfl | rfl | rfl | rfl <;>
    simp [Set.ext_iff]

/-- Helper for Example 12.1: each displayed open-set family is closed under arbitrary unions. -/
private lemma openSets_sUnion_mem (t : Displayed) {S : Set (Set ThreePoint)}
    (hS : ∀ s ∈ S, s ∈ openSets t) : ⋃₀ S ∈ openSets t := by
  -- The family is finite because it is contained in the finite displayed family.
  have hSfinite : S.Finite := (openSets_finite t).subset fun s hs ↦ hS s hs
  -- Fold the arbitrary union using empty-set and binary-union closure.
  induction S, hSfinite using Set.Finite.induction_on with
  | empty => simpa using openSets_empty_mem t
  | insert s S ih =>
      simp only [Set.sUnion_insert, Set.mem_insert_iff, forall_eq_or_imp] at hS ⊢
      exact openSets_union_mem t hS.1 (ih hS.2)

/-- A subset is open in a displayed topology exactly when it belongs to its listed family. -/
theorem isOpen_iff (t : Displayed) (s : Set ThreePoint) :
    (topology t).IsOpen s ↔ s ∈ openSets t := by
  constructor
  · intro hs
    -- Follow the generation of an open set, using the two closure properties above.
    induction hs with
    | basic s hs => exact hs
    | univ =>
        cases t <;> simp only [mem_openSets_iff] <;> simp
    | inter s u _ _ hs hu => exact openSets_inter_mem t hs hu
    | sUnion S _ hS => exact openSets_sUnion_mem t hS
  · intro hs
    -- Every listed set is a basic open of the generated topology.
    exact TopologicalSpace.GenerateOpen.basic s hs

/-- The displayed indiscrete topology is the canonical top topology. -/
@[simp]
theorem topology_indiscrete : topology .indiscrete = (⊤ : TopologicalSpace ThreePoint) := by
  ext s
  change (topology .indiscrete).IsOpen s ↔ (⊤ : TopologicalSpace ThreePoint).IsOpen s
  rw [isOpen_iff]
  change (s = ∅ ∨ s = Set.univ) ↔ (⊤ : TopologicalSpace ThreePoint).IsOpen s
  exact (TopologicalSpace.isOpen_top_iff s).symm

/-- The displayed discrete topology is the canonical bottom topology. -/
@[simp]
theorem topology_discrete : topology .discrete = (⊥ : TopologicalSpace ThreePoint) := by
  ext s
  change (topology .discrete).IsOpen s ↔ (⊥ : TopologicalSpace ThreePoint).IsOpen s
  rw [isOpen_iff]
  exact Iff.rfl

end ThreePointTopology
