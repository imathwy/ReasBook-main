module

public import Topology_Munkres_2000.Book.Example_71_1.Earring
public import Mathlib.Analysis.Convex.Segment

public section

open Set

namespace InfiniteEarring.Cone

/-- The Euclidean three-space containing the cone on the infinite earring. -/
abbrev Ambient := EuclideanSpace ℝ (Fin 3)

/-- The height-zero embedding of the plane containing the infinite earring. -/
noncomputable def base (x : InfiniteEarring.Plane) : Ambient :=
  WithLp.toLp 2 ![x 0, x 1, 0]

/-- The apex `(0, 0, 1)` of the cone on the infinite earring. -/
noncomputable def apex : Ambient :=
  WithLp.toLp 2 ![0, 0, 1]

/-- The union of the line segments from the infinite earring at height zero to the apex. -/
def carrier : Set Ambient :=
  ⋃ x : InfiniteEarring.Space, segment ℝ (base x) apex

/-- The cone on the infinite earring, with its subspace topology from Euclidean three-space. -/
abbrev Space := carrier

/-- A point lies in the cone carrier exactly when it lies on a generating segment. -/
theorem mem_carrier_iff (q : Ambient) :
    q ∈ carrier ↔ ∃ x : InfiniteEarring.Space, q ∈ segment ℝ (base x) apex := by
  -- Membership in the indexed union is existential membership in a generating segment.
  simp only [carrier, Set.mem_iUnion]

/-- The ambient origin belongs to the cone carrier. -/
theorem zero_mem_carrier : (0 : Ambient) ∈ carrier := by
  -- The origin is the base endpoint of the segment generated by the earring origin.
  rw [mem_carrier_iff]
  refine ⟨InfiniteEarring.origin, ?_⟩
  have hbase : base InfiniteEarring.origin = 0 := by
    ext i
    fin_cases i
    · simp [base, InfiniteEarring.origin_coe]
    · simp [base, InfiniteEarring.origin_coe]
    · simp [base, InfiniteEarring.origin_coe]
  rw [← hbase]
  exact left_mem_segment ℝ (base InfiniteEarring.origin) apex

/-- The distinguished origin of the cone on the infinite earring. -/
@[expose]
def origin : Space := ⟨0, zero_mem_carrier⟩

/-- The ambient point underlying the cone origin is `(0, 0, 0)`. -/
theorem origin_coe : (origin : Ambient) = 0 := rfl

end InfiniteEarring.Cone
