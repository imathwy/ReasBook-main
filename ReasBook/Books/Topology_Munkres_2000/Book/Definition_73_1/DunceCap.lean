module

public import Mathlib.Analysis.Complex.Circle
public import Mathlib.Topology.Constructions

public section

namespace DunceCap

/-- The closed complex unit disk. -/
abbrev Disk := Metric.closedBall (0 : ℂ) 1

/-- A point of the complex unit circle lies in the closed unit disk. -/
theorem boundary_mem (z : Circle) : (z : ℂ) ∈ Disk := by
  simp [Disk]

/-- The canonical inclusion of the complex unit circle into the closed unit disk. -/
@[expose] def boundary (z : Circle) : Disk :=
  ⟨z, boundary_mem z⟩

/-- Coercing a boundary point back to the complex plane recovers the circle point. -/
@[simp] theorem coe_boundary (z : Circle) : ((boundary z : Disk) : ℂ) = z := rfl

/-- Rotation of the complex unit circle through the angle `2 * π / n`. -/
noncomputable def rotation (n : ℕ) : Circle ≃ₜ Circle :=
  Homeomorph.mulLeft (Circle.exp (2 * Real.pi / n))

/-- Applying `rotation n` adds the angle `2 * π / n`. -/
theorem rotation_apply_exp (n : ℕ) (θ : ℝ) :
    rotation n (Circle.exp θ) = Circle.exp (θ + 2 * Real.pi / n) := by
  simp [rotation, Circle.exp_add, mul_comm]

/-- Two disk points are directly related when they are boundary points in one finite
rotation orbit. -/
def Related (n : ℕ) (x y : Disk) : Prop :=
  ∃ (z : Circle) (k : Fin n),
    x = boundary z ∧ y = boundary ((rotation n ^ (k : ℕ)) z)

/-- The equivalence relation generated by the finite rotation-orbit identifications. -/
def Identified (n : ℕ) : Setoid Disk :=
  Relation.EqvGen.setoid (Related n)

/-- The generated identification lies below a setoid exactly when that setoid
contains every indexed boundary rotation. -/
theorem identified_le_iff_boundary_rotations (n : ℕ) (s : Setoid Disk) :
    Identified n ≤ s ↔
      ∀ (z : Circle) (k : Fin n),
        s (boundary z) (boundary ((rotation n ^ (k : ℕ)) z)) := by
  -- Direct generators belong to `Identified`, so any upper bound contains them.
  constructor
  · intro h z k
    apply h
    apply Relation.EqvGen.rel
    exact ⟨z, k, rfl, rfl⟩
  · intro h
    -- Conversely, containment of every direct rotation extends to its equivalence closure.
    apply Setoid.eqvGen_le
    intro x y hxy
    obtain ⟨z, k, rfl, rfl⟩ := hxy
    exact h z k

/-- The `n`-fold dunce cap as the closed unit disk modulo finite boundary rotations. -/
def Space (n : ℕ) :=
  Quotient (Identified n)

/-- The canonical quotient topology on the `n`-fold dunce cap. -/
instance instTopologicalSpaceSpace (n : ℕ) : TopologicalSpace (Space n) :=
  inferInstanceAs (TopologicalSpace (Quotient (Identified n)))

/-- The canonical map from the closed unit disk to the `n`-fold dunce cap. -/
def quotientMap (n : ℕ) : Disk → Space n :=
  Quotient.mk (Identified n)

/-- The basepoint of the `n`-fold dunce cap, represented by the center of the disk. -/
noncomputable def basepoint (n : ℕ) : Space n :=
  quotientMap n 0

/-- Two disk points have the same quotient image exactly when the generated setoid
identifies them. -/
theorem quotientMap_eq_iff (n : ℕ) (x y : Disk) :
    quotientMap n x = quotientMap n y ↔ Identified n x y :=
  Quotient.eq

/-- The quotient map identifies every boundary point with each point of its finite
rotation orbit. -/
theorem quotientMap_rotate (n : ℕ) (z : Circle) (k : Fin n) :
    quotientMap n (boundary z) =
      quotientMap n (boundary ((rotation n ^ (k : ℕ)) z)) := by
  apply Quotient.sound
  apply Relation.EqvGen.rel
  exact ⟨z, k, rfl, rfl⟩

/-- The canonical map gives the `n`-fold dunce cap its quotient topology. -/
theorem quotientMap_isQuotientMap (n : ℕ) :
    Topology.IsQuotientMap (quotientMap n) :=
  isQuotientMap_quotient_mk'


end DunceCap
