public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import Topology_Munkres_2000.Book.Theorem_54_6

universe u

public section

variable {X : Type u} [TopologicalSpace X]

/-- Helper for Theorem 63.1: iterating a group element that translates an integer-indexed
orbit by `d` translates it by `m * d` after the integer power `m`. -/
private lemma integerTranslation_zpow_apply {G E : Type*} [Group G] [MulAction G E]
    (g : G) (e : ℤ → E) (d : ℤ) (hshift : ∀ n, g • e n = e (n + d)) (m n : ℤ) :
    (g ^ m) • e n = e (n + m * d) := by
  -- Integer induction propagates the translation law through positive and negative powers.
  induction m using Int.induction_on with
  | zero => simp
  | succ m ih =>
      rw [Int.add_comm (m : ℤ) 1, zpow_one_add, mul_smul, ih, hshift]
      congr 1
      ring
  | pred m ih =>
      have hpower : g ^ (-(m : ℤ) - 1) = g⁻¹ * g ^ (-(m : ℤ)) := by
        calc
          g ^ (-(m : ℤ) - 1) = g ^ ((-1 : ℤ) + -(m : ℤ)) := by
            congr 1
            ring
          _ = g ^ (-1 : ℤ) * g ^ (-(m : ℤ)) := zpow_add g (-1) (-(m : ℤ))
          _ = g⁻¹ * g ^ (-(m : ℤ)) := by rw [zpow_neg_one]
      rw [hpower, mul_smul, ih]
      apply inv_smul_eq_iff.mpr
      rw [hshift]
      congr 1
      ring

/-- Helper for Theorem 63.1: a group element acting as a unit translation on an injectively
integer-indexed orbit has infinite order. -/
private lemma orderOf_eq_zero_of_integerShift {G E : Type*} [Group G] [MulAction G E]
    (g : G) (e : ℤ → E) (he : Function.Injective e)
    (hshift : ∀ n, g • e n = e (n + 1)) : orderOf g = 0 := by
  -- A nonzero natural power moves sheet zero to a distinct integer-indexed sheet.
  rw [orderOf_eq_zero_iff']
  intro n hn hpower
  have hmove : (g ^ n) • e 0 = e (0 + (n : ℤ) * 1) := by
    simpa only [zpow_natCast] using
      integerTranslation_zpow_apply g e 1 hshift (n : ℤ) 0
  have hfixed : (g ^ n) • e 0 = e 0 := by
    rw [hpower, one_smul]
  have hindex : 0 + (n : ℤ) * 1 = 0 := he (hmove.symm.trans hfixed)
  omega

/-- Helper for Theorem 63.1: in a cyclic group, a bijective integer orbit on which `g` acts
by unit translation is generated by `g`. -/
private lemma zpowers_eq_top_of_cyclic_integerShift {G E : Type*} [Group G] [MulAction G E]
    [IsCyclic G] (g : G) (e : ℤ → E) (he : Function.Bijective e)
    (hshift : ∀ n, g • e n = e (n + 1)) : Subgroup.zpowers g = ⊤ := by
  -- Compare `g` with a cyclic generator and read both actions on the integer orbit.
  obtain ⟨c, hc⟩ := IsCyclic.exists_generator (α := G)
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hc g)
  obtain ⟨r, hr⟩ := he.2 (c • e 0)
  have hcommute : Commute c g := IsCyclic.isMulCommutative.is_comm.comm c g
  have hcShift : ∀ n, c • e n = e (n + r) := by
    intro n
    have horbit : (g ^ n) • e 0 = e n := by
      simpa only [zero_add, mul_one] using
        integerTranslation_zpow_apply g e 1 hshift n 0
    calc
      c • e n = c • (g ^ n • e 0) := congrArg (c • ·) horbit.symm
      _ = (c * g ^ n) • e 0 := by rw [mul_smul]
      _ = (g ^ n * c) • e 0 := by rw [hcommute.zpow_right n]
      _ = (g ^ n) • (c • e 0) := by rw [mul_smul]
      _ = (g ^ n) • e r := congrArg ((g ^ n) • ·) hr.symm
      _ = e (r + n) := by
        simpa only [mul_one] using integerTranslation_zpow_apply g e 1 hshift n r
      _ = e (n + r) := by rw [Int.add_comm]
  have hgeneratorMove : (c ^ k) • e 0 = e (0 + k * r) :=
    integerTranslation_zpow_apply c e r hcShift k 0
  have hgMove : g • e 0 = e 1 := by simpa using hshift 0
  have hkr : k * r = 1 := by
    apply he.1
    calc
      e (k * r) = (c ^ k) • e 0 := by simpa using hgeneratorMove.symm
      _ = g • e 0 := congrArg (· • e 0) hk
      _ = e 1 := hgMove
  have hcPower : c = g ^ r := by
    calc
      c = c ^ (k * r) := by rw [hkr, zpow_one]
      _ = (c ^ k) ^ r := zpow_mul c k r
      _ = g ^ r := congrArg (· ^ r) hk
  -- Every element is a power of `c`, and `c` itself is a power of `g`.
  apply top_unique
  intro x _
  obtain ⟨s, hs⟩ := Subgroup.mem_zpowers_iff.mp (hc x)
  rw [← hs]
  exact (Subgroup.zpowers_le.mpr (hcPower ▸ Subgroup.zpow_mem_zpowers g r))
    (Subgroup.zpow_mem_zpowers c s)

/-- Helper for Theorem 63.1: the powers of a unit translation and the powers of an element
fixing sheet zero have trivial intersection. -/
private lemma zpowers_disjoint_of_integerShift_fixed {G E : Type*} [Group G] [MulAction G E]
    (f g : G) (e : ℤ → E) (he : Function.Injective e)
    (hshift : ∀ n, f • e n = e (n + 1)) (hfixed : g • e 0 = e 0) :
    Disjoint (Subgroup.zpowers f) (Subgroup.zpowers g) := by
  -- A common power fixes sheet zero, so the translation exponent must vanish.
  rw [Subgroup.disjoint_def]
  intro x hxf hxg
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.mp hxf
  have hcommonFixed : (f ^ m) • e 0 = e 0 :=
    smul_eq_self_of_mem_zpowers hxg hfixed
  have hmove : (f ^ m) • e 0 = e (0 + m * 1) :=
    integerTranslation_zpow_apply f e 1 hshift m 0
  have hm : m = 0 := by
    have hindex : 0 + m * 1 = 0 := he (hmove.symm.trans hcommonFixed)
    simpa using hindex
  rw [hm, zpow_zero]

/-- Helper for Theorem 63.1: the two charts of the alternating cover have base sets `U` and
`V`, respectively. -/
private def alternatingBaseSet (U V : Set X) : Bool → Set X
  | false => V
  | true => U

/-- Helper for Theorem 63.1: choose the `U` chart wherever possible and otherwise the `V`
chart. -/
private noncomputable def alternatingChartIndex (U : Set X) (x : X) : Bool :=
  @ite Bool (x ∈ U) (Classical.propDecidable _) true false

/-- Helper for Theorem 63.1: changing from the `U` coordinate to the `V` coordinate subtracts
one over `A`, while the reverse coordinate change adds one. -/
private noncomputable def alternatingCoordChange (A : Set X) :
    Bool → Bool → X → ℤ → ℤ
  | true, false, x, n => @ite ℤ (x ∈ A) (Classical.propDecidable _) (n - 1) n
  | false, true, x, n => @ite ℤ (x ∈ A) (Classical.propDecidable _) (n + 1) n
  | _, _, _, n => n

/-- Helper for Theorem 63.1: each base set of the two-chart alternating bundle is open. -/
private lemma alternatingBaseSet_isOpen (U V : Set X) (hU : IsOpen U) (hV : IsOpen V)
    (i : Bool) : IsOpen (alternatingBaseSet U V i) := by
  -- Split between the two chart indices and use the corresponding openness hypothesis.
  cases i
  · exact hV
  · exact hU

omit [TopologicalSpace X] in
/-- Helper for Theorem 63.1: the preferred chart selected at each point contains that point. -/
private lemma mem_alternatingBaseSet_chartIndex
    (U V : Set X) (hcover : U ∪ V = Set.univ) (x : X) :
    x ∈ alternatingBaseSet U V (alternatingChartIndex U x) := by
  -- Points outside `U` lie in `V` because the two sets cover the base.
  by_cases hx : x ∈ U
  · simp [alternatingChartIndex, alternatingBaseSet, hx]
  · have hxV : x ∈ V := by
      have hxCover : x ∈ U ∪ V := by rw [hcover]; exact Set.mem_univ x
      exact hxCover.resolve_left hx
    simp [alternatingChartIndex, alternatingBaseSet, hx, hxV]

omit [TopologicalSpace X] in
/-- Helper for Theorem 63.1: changing coordinates within either alternating chart is the
identity. -/
private lemma alternatingCoordChange_self
    (A : Set X) (i : Bool) (x : X) (n : ℤ) :
    alternatingCoordChange A i i x n = n := by
  -- Both diagonal cases are definitionally the identity coordinate change.
  cases i <;> rfl

/-- Helper for Theorem 63.1: the alternating coordinate changes are continuous on every chart
overlap. -/
private lemma alternatingCoordChange_continuousOn
    (U V A B : Set X) (hA : IsOpen A) (hB : IsOpen B)
    (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B) (i j : Bool) :
    ContinuousOn
      (fun p : X × ℤ ↦ alternatingCoordChange A i j p.1 p.2)
      ((alternatingBaseSet U V i ∩ alternatingBaseSet U V j) ×ˢ Set.univ) := by
  -- On a mixed overlap, the coordinate formula is continuous separately over the open pieces
  -- `A` and `B`; on a diagonal overlap it is simply the second projection.
  cases i <;> cases j
  · simpa [alternatingCoordChange] using
      (continuous_snd.continuousOn : ContinuousOn (fun p : X × ℤ ↦ p.2) _)
  · have hdomain :
        ((alternatingBaseSet U V false ∩ alternatingBaseSet U V true) ×ˢ
            (Set.univ : Set ℤ)) =
          (A ×ˢ (Set.univ : Set ℤ)) ∪ (B ×ˢ (Set.univ : Set ℤ)) := by
      rw [alternatingBaseSet, alternatingBaseSet, Set.inter_comm V U, hoverlap, Set.union_prod]
    rw [hdomain]
    apply ContinuousOn.union_of_isOpen
    · have hadd : Continuous (fun p : X × ℤ ↦ p.2 + (1 : ℤ)) :=
        continuous_snd.add continuous_const
      refine hadd.continuousOn.congr ?_
      intro p hp
      simp [alternatingCoordChange, hp.1]
    · refine continuous_snd.continuousOn.congr ?_
      intro p hp
      have hpA : p.1 ∉ A := fun hpA ↦ Set.disjoint_left.1 hAB hpA hp.1
      simp [alternatingCoordChange, hpA]
    · exact hA.prod isOpen_univ
    · exact hB.prod isOpen_univ
  · have hdomain :
        ((alternatingBaseSet U V true ∩ alternatingBaseSet U V false) ×ˢ
            (Set.univ : Set ℤ)) =
          (A ×ˢ (Set.univ : Set ℤ)) ∪ (B ×ˢ (Set.univ : Set ℤ)) := by
      rw [alternatingBaseSet, alternatingBaseSet, hoverlap, Set.union_prod]
    rw [hdomain]
    apply ContinuousOn.union_of_isOpen
    · have hsub : Continuous (fun p : X × ℤ ↦ p.2 - (1 : ℤ)) :=
        continuous_snd.sub continuous_const
      refine hsub.continuousOn.congr ?_
      intro p hp
      simp [alternatingCoordChange, hp.1]
    · refine continuous_snd.continuousOn.congr ?_
      intro p hp
      have hpA : p.1 ∉ A := fun hpA ↦ Set.disjoint_left.1 hAB hpA hp.1
      simp [alternatingCoordChange, hpA]
    · exact hA.prod isOpen_univ
    · exact hB.prod isOpen_univ
  · simpa [alternatingCoordChange] using
      (continuous_snd.continuousOn : ContinuousOn (fun p : X × ℤ ↦ p.2) _)

omit [TopologicalSpace X] in
/-- Helper for Theorem 63.1: the alternating coordinate changes satisfy the cocycle law. -/
private lemma alternatingCoordChange_comp
    (A : Set X) (i j k : Bool) (x : X) (n : ℤ) :
    alternatingCoordChange A j k x (alternatingCoordChange A i j x n) =
      alternatingCoordChange A i k x n := by
  -- There are only two charts; the two nontrivial changes add and subtract one.
  by_cases hx : x ∈ A
  · cases i <;> cases j <;> cases k <;> simp [alternatingCoordChange, hx]
  · cases i <;> cases j <;> cases k <;> simp [alternatingCoordChange, hx]

/-- Helper for Theorem 63.1: the two open charts and their integer translations form the
fiber-bundle core of the alternating cover. -/
private noncomputable def alternatingCoverCore
    (U V A B : Set X)
    (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B) :
    FiberBundleCore Bool X ℤ :=
  { baseSet := alternatingBaseSet U V
    isOpen_baseSet := alternatingBaseSet_isOpen U V hU hV
    indexAt := alternatingChartIndex U
    mem_baseSet_at := mem_alternatingBaseSet_chartIndex U V hcover
    coordChange := alternatingCoordChange A
    coordChange_self := fun i x _ n ↦ alternatingCoordChange_self A i x n
    continuousOn_coordChange :=
      alternatingCoordChange_continuousOn U V A B hA hB hoverlap hAB
    coordChange_comp := fun i j k x _ n ↦ alternatingCoordChange_comp A i j k x n }

/-- Helper for Theorem 63.1: a point of the total space over `a` lies in the fiber over `a`. -/
private lemma alternatingTotalPoint_mem_fiber
    (Z : FiberBundleCore Bool X ℤ) (a : X) (n : ℤ) : Z.proj ⟨a, n⟩ ∈ ({a} : Set X) := by
  -- The bundle projection is the first projection of the total-space pair.
  rfl

/-- Helper for Theorem 63.1: the canonical integer-indexed point in the fiber over `a`. -/
private def alternatingFiberPoint (Z : FiberBundleCore Bool X ℤ) (a : X) (n : ℤ) :
    Z.proj ⁻¹' {a} :=
  ⟨⟨a, n⟩, alternatingTotalPoint_mem_fiber Z a n⟩

/-- Helper for Theorem 63.1: a path upstairs whose projection is a prescribed base path
computes the monodromy endpoint. -/
private lemma monodromy_eq_endpoint_of_projectedPath
    {E B : Type*} [TopologicalSpace E] [TopologicalSpace B]
    {p : E → B} (hp : IsCoveringMap p) {e₀ e₁ : E} {b₀ b₁ : B}
    (he₀ : p e₀ = b₀) (he₁ : p e₁ = b₁) (Γ : Path e₀ e₁) (γ : Path b₀ b₁)
    (hproj : ∀ t, p (Γ t) = γ t) :
    hp.monodromy (.mk γ) ⟨e₀, he₀⟩ = ⟨e₁, he₁⟩ := by
  -- After aligning endpoints, the projected lifted path is literally the prescribed path.
  subst b₀
  subst b₁
  refine hp.monodromy_eq_of_map_eq (.mk Γ) ?_
  simp only [Path.Homotopic.Quotient.cast_rfl_rfl, ← Path.Homotopic.Quotient.mk_map]
  congr 1
  ext t
  exact hproj t

/-- Helper for Theorem 63.1: a local-trivialization lift of `y` belongs to the fiber over `y`. -/
private lemma trivializationLift_mem_fiber
    {E B F : Type*} [TopologicalSpace E] [TopologicalSpace B] [TopologicalSpace F]
    {p : E → B} (T : Bundle.Trivialization F p) (z : E) {y : B} (hy : y ∈ T.baseSet) :
    p (T.lift z y) ∈ ({y} : Set B) := by
  -- A local lift projects to its chosen base point.
  exact T.proj_lift hy

/-- Helper for Theorem 63.1: the endpoint in a fiber obtained by lifting through one local
trivialization. -/
private def trivializationLiftFiberPoint
    {E B F : Type*} [TopologicalSpace E] [TopologicalSpace B] [TopologicalSpace F]
    {p : E → B} (T : Bundle.Trivialization F p) (z : E) (y : B) (hy : y ∈ T.baseSet) :
    p ⁻¹' {y} :=
  ⟨T.lift z y, trivializationLift_mem_fiber T z hy⟩

/-- Helper for Theorem 63.1: monodromy along a path contained in one trivializing base set is
the endpoint of its constant-coordinate local lift. -/
private lemma monodromy_mk_eq_trivializationLift
    {E B F : Type*} [TopologicalSpace E] [TopologicalSpace B] [TopologicalSpace F]
    {p : E → B} (hp : IsCoveringMap p) (T : Bundle.Trivialization F p)
    {x y : B} (γ : Path x y) (z : p ⁻¹' {x})
    (hx : x ∈ T.baseSet) (hy : y ∈ T.baseSet) (hγ : ∀ t, γ t ∈ T.baseSet) :
    hp.monodromy (.mk γ) z = trivializationLiftFiberPoint T z.1 y hy := by
  -- Restrict the inverse trivialization to the path and keep its fiber coordinate constant.
  have hzBase : p z.1 ∈ T.baseSet := by
    rw [z.2]
    exact hx
  have hstart : T.lift z.1 x = z.1 := by
    calc
      T.lift z.1 x = T.lift z.1 (p z.1) := congrArg (T.lift z.1) z.2.symm
      _ = z.1 := T.lift_self hzBase
  have hcontinuous : ContinuousOn (T.lift z.1) (Set.range γ) := by
    apply T.continuousOn_invFun.comp
    · exact (continuous_id.prodMk continuous_const).continuousOn
    · rintro b ⟨t, rfl⟩
      exact T.mem_target.mpr (hγ t)
  let endpoint := trivializationLiftFiberPoint T z.1 y hy
  have hendpoint : (endpoint : E) = T.lift z.1 y := rfl
  let Γ : Path z.1 endpoint := (γ.map' hcontinuous).cast hstart.symm hendpoint
  have hproj : ∀ t, p (Γ t) = γ t := by
    intro t
    exact T.proj_lift (hγ t)
  exact monodromy_eq_endpoint_of_projectedPath hp z.2 endpoint.2 Γ γ hproj

/-- Helper for Theorem 63.1: lifting inside the `U` chart keeps the integer coordinate fixed. -/
private lemma alternatingLocalTriv_true_lift
    (U V A B : Set X) (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B)
    {x y : X} (hxU : x ∈ U) (hyU : y ∈ U) (n : ℤ) :
    let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
    (Z.localTriv true).lift (⟨x, n⟩ : Z.TotalSpace) y = ⟨y, n⟩ := by
  -- Both endpoints select the `U` chart, so both coordinate changes are diagonal.
  let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
  change (Z.localTriv true).lift (⟨x, n⟩ : Z.TotalSpace) y = ⟨y, n⟩
  rw [Bundle.Trivialization.lift]
  change (Z.localTriv true).toOpenPartialHomeomorph.symm
    (y, ((Z.localTriv true) (⟨x, n⟩ : Z.TotalSpace)).2) = ⟨y, n⟩
  rw [Z.localTriv_symm_apply, Z.localTriv_apply]
  simp [Z, alternatingCoverCore, alternatingChartIndex, alternatingCoordChange, hxU, hyU]

/-- Helper for Theorem 63.1: lifting in the `V` chart from `B` to `A` raises the stored
`U`-chart integer coordinate by one. -/
private lemma alternatingLocalTriv_false_lift_B_A
    (U V A B : Set X) (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B)
    {x y : X} (hxB : x ∈ B) (hyA : y ∈ A) (n : ℤ) :
    let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
    (Z.localTriv false).lift (⟨x, n⟩ : Z.TotalSpace) y = ⟨y, n + 1⟩ := by
  -- The `V` coordinate agrees with `n` over `B`, then converts to `n + 1` over `A`.
  have hxOverlap : x ∈ U ∩ V := by
    rw [hoverlap]
    exact Or.inr hxB
  have hyOverlap : y ∈ U ∩ V := by
    rw [hoverlap]
    exact Or.inl hyA
  have hxA : x ∉ A := fun hxA ↦ Set.disjoint_left.1 hAB hxA hxB
  let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
  change (Z.localTriv false).lift (⟨x, n⟩ : Z.TotalSpace) y = ⟨y, n + 1⟩
  rw [Bundle.Trivialization.lift]
  change (Z.localTriv false).toOpenPartialHomeomorph.symm
    (y, ((Z.localTriv false) (⟨x, n⟩ : Z.TotalSpace)).2) = ⟨y, n + 1⟩
  rw [Z.localTriv_symm_apply, Z.localTriv_apply]
  simp [Z, alternatingCoverCore, alternatingChartIndex, alternatingCoordChange,
    hxOverlap.1, hyOverlap.1, hxA, hyA]
  rfl

/-- Helper for Theorem 63.1: lifting in the `V` chart between two points of `A` preserves the
stored `U`-chart integer coordinate. -/
private lemma alternatingLocalTriv_false_lift_A_A
    (U V A B : Set X) (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B)
    {x y : X} (hxA : x ∈ A) (hyA : y ∈ A) (n : ℤ) :
    let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
    (Z.localTriv false).lift (⟨x, n⟩ : Z.TotalSpace) y = ⟨y, n⟩ := by
  -- Subtracting one on entry to the `V` coordinate and adding it back on exit cancel.
  have hxOverlap : x ∈ U ∩ V := by
    rw [hoverlap]
    exact Or.inl hxA
  have hyOverlap : y ∈ U ∩ V := by
    rw [hoverlap]
    exact Or.inl hyA
  let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
  change (Z.localTriv false).lift (⟨x, n⟩ : Z.TotalSpace) y = ⟨y, n⟩
  rw [Bundle.Trivialization.lift]
  change (Z.localTriv false).toOpenPartialHomeomorph.symm
    (y, ((Z.localTriv false) (⟨x, n⟩ : Z.TotalSpace)).2) = ⟨y, n⟩
  rw [Z.localTriv_symm_apply, Z.localTriv_apply]
  simp [Z, alternatingCoverCore, alternatingChartIndex, alternatingCoordChange,
    hxOverlap.1, hyOverlap.1, hxA, hyA]

/-- Helper for Theorem 63.1: monodromy of the alternating bundle shifts the crossing loop by
one and fixes sheet zero for a loop whose two transition points both lie in `A`. -/
private theorem alternatingCover_monodromy_specs
    (U V A B : Set X) {a b : X} (α : Path a b) (β : Path b a)
    (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B)
    (ha : a ∈ A) (hb : b ∈ B)
    (hα : ∀ t, α t ∈ U) (hβ : ∀ t, β t ∈ V) :
    let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
    let hp : IsCoveringMap Z.proj := FiberBundle.isCoveringMap
    (∀ n, hp.monodromy (.mk (α.trans β)) (alternatingFiberPoint Z a n) =
      alternatingFiberPoint Z a (n + 1)) ∧
    (∀ {a' : X} (γ : Path a a') (δ : Path a' a), a' ∈ A →
      (∀ t, γ t ∈ U) → (∀ t, δ t ∈ V) →
      hp.monodromy (.mk (γ.trans δ)) (alternatingFiberPoint Z a 0) =
        alternatingFiberPoint Z a 0) :=
  -- Lift each half of the loop through its chart, then compose the two monodromy computations.
  by
    classical
    let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
    let hp : IsCoveringMap Z.proj := FiberBundle.isCoveringMap
    change
      (∀ n, hp.monodromy (.mk (α.trans β)) (alternatingFiberPoint Z a n) =
        alternatingFiberPoint Z a (n + 1)) ∧
      (∀ {a' : X} (γ : Path a a') (δ : Path a' a), a' ∈ A →
        (∀ t, γ t ∈ U) → (∀ t, δ t ∈ V) →
        hp.monodromy (.mk (γ.trans δ)) (alternatingFiberPoint Z a 0) =
          alternatingFiberPoint Z a 0)
    have haOverlap : a ∈ U ∩ V := by
      rw [hoverlap]
      exact Or.inl ha
    have hbOverlap : b ∈ U ∩ V := by
      rw [hoverlap]
      exact Or.inr hb
    have haTrue : a ∈ (Z.localTriv true).baseSet := by
      rw [← Z.baseSet_at]
      exact haOverlap.1
    have haFalse : a ∈ (Z.localTriv false).baseSet := by
      rw [← Z.baseSet_at]
      exact haOverlap.2
    have hbTrue : b ∈ (Z.localTriv true).baseSet := by
      rw [← Z.baseSet_at]
      exact hbOverlap.1
    have hbFalse : b ∈ (Z.localTriv false).baseSet := by
      rw [← Z.baseSet_at]
      exact hbOverlap.2
    have hαTrue : ∀ t, α t ∈ (Z.localTriv true).baseSet := by
      intro t
      rw [← Z.baseSet_at]
      exact hα t
    have hβFalse : ∀ t, β t ∈ (Z.localTriv false).baseSet := by
      intro t
      rw [← Z.baseSet_at]
      exact hβ t
    constructor
    · intro n
      have hαEndpoint :
          trivializationLiftFiberPoint (Z.localTriv true)
              (alternatingFiberPoint Z a n).1 b hbTrue =
            alternatingFiberPoint Z b n := by
        apply Subtype.ext
        exact alternatingLocalTriv_true_lift U V A B hU hV hA hB hcover hoverlap hAB
          haOverlap.1 hbOverlap.1 n
      have hαMonodromy :
          hp.monodromy (.mk α) (alternatingFiberPoint Z a n) =
            alternatingFiberPoint Z b n :=
        (monodromy_mk_eq_trivializationLift hp (Z.localTriv true) α
          (alternatingFiberPoint Z a n) haTrue hbTrue hαTrue).trans hαEndpoint
      have hβEndpoint :
          trivializationLiftFiberPoint (Z.localTriv false)
              (alternatingFiberPoint Z b n).1 a haFalse =
            alternatingFiberPoint Z a (n + 1) := by
        apply Subtype.ext
        exact alternatingLocalTriv_false_lift_B_A U V A B hU hV hA hB hcover hoverlap hAB
          hb ha n
      have hβMonodromy :
          hp.monodromy (.mk β) (alternatingFiberPoint Z b n) =
            alternatingFiberPoint Z a (n + 1) :=
        (monodromy_mk_eq_trivializationLift hp (Z.localTriv false) β
          (alternatingFiberPoint Z b n) hbFalse haFalse hβFalse).trans hβEndpoint
      rw [Path.Homotopic.Quotient.mk_trans, hp.monodromy_trans_apply,
        hαMonodromy, hβMonodromy]
    · intro a' γ δ ha' hγ hδ
      have ha'Overlap : a' ∈ U ∩ V := by
        rw [hoverlap]
        exact Or.inl ha'
      have ha'True : a' ∈ (Z.localTriv true).baseSet := by
        rw [← Z.baseSet_at]
        exact ha'Overlap.1
      have ha'False : a' ∈ (Z.localTriv false).baseSet := by
        rw [← Z.baseSet_at]
        exact ha'Overlap.2
      have hγTrue : ∀ t, γ t ∈ (Z.localTriv true).baseSet := by
        intro t
        rw [← Z.baseSet_at]
        exact hγ t
      have hδFalse : ∀ t, δ t ∈ (Z.localTriv false).baseSet := by
        intro t
        rw [← Z.baseSet_at]
        exact hδ t
      have hγEndpoint :
          trivializationLiftFiberPoint (Z.localTriv true)
              (alternatingFiberPoint Z a 0).1 a' ha'True =
            alternatingFiberPoint Z a' 0 := by
        apply Subtype.ext
        exact alternatingLocalTriv_true_lift U V A B hU hV hA hB hcover hoverlap hAB
          haOverlap.1 ha'Overlap.1 0
      have hγMonodromy :
          hp.monodromy (.mk γ) (alternatingFiberPoint Z a 0) =
            alternatingFiberPoint Z a' 0 :=
        (monodromy_mk_eq_trivializationLift hp (Z.localTriv true) γ
          (alternatingFiberPoint Z a 0) haTrue ha'True hγTrue).trans hγEndpoint
      have hδEndpoint :
          trivializationLiftFiberPoint (Z.localTriv false)
              (alternatingFiberPoint Z a' 0).1 a haFalse =
            alternatingFiberPoint Z a 0 := by
        apply Subtype.ext
        exact alternatingLocalTriv_false_lift_A_A U V A B hU hV hA hB hcover hoverlap hAB
          ha' ha 0
      have hδMonodromy :
          hp.monodromy (.mk δ) (alternatingFiberPoint Z a' 0) =
            alternatingFiberPoint Z a 0 :=
        (monodromy_mk_eq_trivializationLift hp (Z.localTriv false) δ
          (alternatingFiberPoint Z a' 0) ha'False haFalse hδFalse).trans hδEndpoint
      rw [Path.Homotopic.Quotient.mk_trans, hp.monodromy_trans_apply,
        hγMonodromy, hδMonodromy]

/-- Helper for Theorem 63.1: the alternating integer-sheeted cover enumerates the fiber over
`a`, shifts its sheets along `α.trans β`, and fixes sheet zero along every `A`-to-`A` loop of
the indicated form. -/
private theorem existsIntegerSheetedAlternatingCover
    (U V A B : Set X) {a b : X} (α : Path a b) (β : Path b a)
    (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B)
    (ha : a ∈ A) (hb : b ∈ B)
    (hα : ∀ t, α t ∈ U) (hβ : ∀ t, β t ∈ V) :
    ∃ (E : TopCat.{u}) (p : E ⟶ TopCat.of X) (hp : IsCoveringMap p)
      (e : ℤ → p ⁻¹' {a}),
      Function.Bijective e ∧
      (∀ n, hp.monodromy (.mk (α.trans β)) (e n) = e (n + 1)) ∧
      (∀ {a' : X} (γ : Path a a') (δ : Path a' a), a' ∈ A →
        (∀ t, γ t ∈ U) → (∀ t, δ t ∈ V) →
        hp.monodromy (.mk (γ.trans δ)) (e 0) = e 0) := by
  -- The fiber-bundle core supplies the covering map; its total-space fibers are literally `ℤ`.
  classical
  let Z := alternatingCoverCore U V A B hU hV hA hB hcover hoverlap hAB
  let E : TopCat.{u} := TopCat.of Z.TotalSpace
  let p : E ⟶ TopCat.of X := TopCat.ofHom ⟨Z.proj, Z.continuous_proj⟩
  have hp : IsCoveringMap p := FiberBundle.isCoveringMap
  let e : ℤ → p ⁻¹' {a} := alternatingFiberPoint Z a
  have he : Function.Bijective e := by
    constructor
    · intro m n hmn
      exact congrArg (fun z : p ⁻¹' {a} ↦ z.1.2) hmn
    · rintro ⟨⟨x, n⟩, hx⟩
      have hxa : x = a := hx
      subst x
      refine ⟨n, ?_⟩
      apply Subtype.ext
      exact Bundle.TotalSpace.mk_inj.mpr rfl
  have hspec := alternatingCover_monodromy_specs
    U V A B α β hU hV hA hB hcover hoverlap hAB ha hb hα hβ
  exact ⟨E, p, hp, e, he, hspec.1, hspec.2⟩

/-- Theorem 63.1 (a): if `α` crosses from `A` to `B` through `U` and `β` returns
through `V`, then the loop `α.trans β` has infinite order in `π₁(X, a)`. Hence its
`Subgroup.zpowers` subgroup is infinite and is cyclic by `Subgroup.isCyclic_zpowers`. -/
theorem crossingLoopClass_orderOf_eq_zero
    (U V A B : Set X) {a b : X} (α : Path a b) (β : Path b a)
    (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B)
    (ha : a ∈ A) (hb : b ∈ B)
    (hα : ∀ t, α t ∈ U) (hβ : ∀ t, β t ∈ V) :
    orderOf (FundamentalGroup.fromPath (.mk (α.trans β))) = 0 := by
  -- Route correction: use the existing bundle interface for this exact declaration, rather than
  -- the earlier raw-quotient route aimed at a nonexistent aggregate declaration.
  -- Use the alternating cover to turn the crossing loop into translation of its integer fiber.
  obtain ⟨E, p, hp, e, he, hshift, _⟩ := existsIntegerSheetedAlternatingCover
    U V A B α β hU hV hA hB hcover hoverlap hAB ha hb hα hβ
  letI := hp.fundamentalGroupMulAction a
  have hshiftAction : ∀ n,
      FundamentalGroup.fromPath (.mk (α.trans β)) • e n = e (n + 1) := hshift
  exact orderOf_eq_zero_of_integerShift _ e he.1 hshiftAction

/-- Part (b) of Theorem 63.1: if `π₁(X, a)` is infinite cyclic, then the class of the
crossing loop `α.trans β` generates the whole fundamental group. -/
theorem crossingLoopClass_zpowers_eq_top
    (U V A B : Set X) {a b : X} (α : Path a b) (β : Path b a)
    [Infinite (FundamentalGroup X a)] [IsCyclic (FundamentalGroup X a)]
    (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B)
    (ha : a ∈ A) (hb : b ∈ B)
    (hα : ∀ t, α t ∈ U) (hβ : ∀ t, β t ∈ V) :
    Subgroup.zpowers (FundamentalGroup.fromPath (.mk (α.trans β))) = ⊤ := by
  -- The integer fiber is a transitive orbit, so cyclicity forces the crossing class to generate.
  obtain ⟨E, p, hp, e, he, hshift, _⟩ := existsIntegerSheetedAlternatingCover
    U V A B α β hU hV hA hB hcover hoverlap hAB ha hb hα hβ
  letI := hp.fundamentalGroupMulAction a
  have hshiftAction : ∀ n,
      FundamentalGroup.fromPath (.mk (α.trans β)) • e n = e (n + 1) := hshift
  exact zpowers_eq_top_of_cyclic_integerShift _ e he hshiftAction

/-- Part (c) of Theorem 63.1: the cyclic subgroups generated by the crossing loops
`α.trans β` and `γ.trans δ` are disjoint, meaning their intersection contains only
the identity element. -/
theorem crossingLoopClasses_disjoint
    (U V A B : Set X) {a b a' : X}
    (α : Path a b) (β : Path b a) (γ : Path a a') (δ : Path a' a)
    (hU : IsOpen U) (hV : IsOpen V) (hA : IsOpen A) (hB : IsOpen B)
    (hcover : U ∪ V = Set.univ) (hoverlap : U ∩ V = A ∪ B) (hAB : Disjoint A B)
    (ha : a ∈ A) (hb : b ∈ B) (ha' : a' ∈ A)
    (hα : ∀ t, α t ∈ U) (hβ : ∀ t, β t ∈ V)
    (hγ : ∀ t, γ t ∈ U) (hδ : ∀ t, δ t ∈ V) :
    Disjoint
      (Subgroup.zpowers (FundamentalGroup.fromPath (.mk (α.trans β))))
      (Subgroup.zpowers (FundamentalGroup.fromPath (.mk (γ.trans δ)))) := by
  -- In the alternating cover the first loop translates sheets, while the second fixes sheet zero.
  obtain ⟨E, p, hp, e, he, hshift, hsame⟩ := existsIntegerSheetedAlternatingCover
    U V A B α β hU hV hA hB hcover hoverlap hAB ha hb hα hβ
  letI := hp.fundamentalGroupMulAction a
  have hshiftAction : ∀ n,
      FundamentalGroup.fromPath (.mk (α.trans β)) • e n = e (n + 1) := hshift
  have hfixedAction : FundamentalGroup.fromPath (.mk (γ.trans δ)) • e 0 = e 0 :=
    hsame γ δ ha' hγ hδ
  exact zpowers_disjoint_of_integerShift_fixed _ _ e he.1 hshiftAction hfixedAction

end
