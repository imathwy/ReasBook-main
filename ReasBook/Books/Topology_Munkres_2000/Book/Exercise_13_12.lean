module

public import Mathlib.Topology.Bases

public section

open Set

universe u

namespace TopologicalSpace

/-- Helper for Exercise 13.12: a finite intersection containing a point can be refined
to a nonempty finite intersection when the family covers the space. -/
lemma exists_nonemptyFinite_sInter_subset {X : Type u} {S F : Set (Set X)} {x : X}
    (h_cover : ⋃₀ S = Set.univ) (hF : F.Finite) (hFS : F ⊆ S) (hx : x ∈ ⋂₀ F) :
    ∃ G : Set (Set X),
      G.Finite ∧ G.Nonempty ∧ G ⊆ S ∧ x ∈ ⋂₀ G ∧ ⋂₀ G ⊆ ⋂₀ F := by
  -- A nonempty indexing family already gives the required refinement.
  rcases F.eq_empty_or_nonempty with rfl | hF_nonempty
  · -- For the empty intersection, choose one covering member through the point.
    obtain ⟨U, hUS, hxU⟩ := sUnion_eq_univ_iff.mp h_cover x
    refine ⟨{U}, finite_singleton U, singleton_nonempty U, singleton_subset_iff.mpr hUS, ?_, ?_⟩
    · simpa only [sInter_singleton]
    · simpa only [sInter_empty] using subset_univ (⋂₀ {U})
  · exact ⟨F, hF, hF_nonempty, hFS, hx, Subset.rfl⟩

/-- Exercise 13.12: If `S` covers `X`, then the nonempty finite intersections of
members of `S` form a basis for the topology generated by `S`. -/
theorem isTopologicalBasis_of_coveringSubbasis {X : Type u} [t : TopologicalSpace X]
    (S : Set (Set X)) (h_generate : t = generateFrom S) (h_cover : ⋃₀ S = Set.univ) :
    IsTopologicalBasis
      ((fun F : Set (Set X) ↦ ⋂₀ F) '' {F | F.Finite ∧ F.Nonempty ∧ F ⊆ S}) := by
  -- Start from mathlib's basis of all finite intersections of subbasic sets.
  refine (isTopologicalBasis_of_subbasis h_generate).isTopologicalBasis_of_exists_subset ?_ ?_
  · -- Nonempty finite intersections are open because they belong to the standard basis.
    rintro _ ⟨F, ⟨hF_finite, _, hFS⟩, rfl⟩
    exact (isTopologicalBasis_of_subbasis h_generate).isOpen
      ⟨F, ⟨hF_finite, hFS⟩, rfl⟩
  · -- Refine the possible empty intersection using the covering hypothesis.
    rintro _ ⟨F, ⟨hF_finite, hFS⟩, rfl⟩ x hx
    obtain ⟨G, hG_finite, hG_nonempty, hGS, hxG, hGF⟩ :=
      exists_nonemptyFinite_sInter_subset h_cover hF_finite hFS hx
    exact ⟨⋂₀ G, ⟨G, ⟨hG_finite, hG_nonempty, hGS⟩, rfl⟩, hxG, hGF⟩

end TopologicalSpace
