module

public import Topology_Munkres_2000.Book.Exercise_70_1.NormalClosure
import Topology_Munkres_2000.Book.Theorem_70_2
import all Topology_Munkres_2000.Book.Theorem_70_2.Presentation
public import Mathlib.AlgebraicTopology.FundamentalGroupoid.SimplyConnected
public import Mathlib.GroupTheory.QuotientGroup.Basic

public section

universe u

/-- Helper for Corollary 70.4: if the right factor of a group coproduct is trivial,
surjectivity of a lifted homomorphism implies surjectivity of its left component. -/
private lemma coprodLeft_surjective_of_subsingleton_right
    {A B P : Type*} [Group A] [Group B] [Group P] [Subsingleton B]
    (f : A →* P) (g : B →* P)
    (hlift : Function.Surjective (Monoid.Coprod.lift f g)) :
    Function.Surjective f := by
  -- The homomorphism from the subsingleton factor has trivial range.
  have hg : g = 1 := by
    ext b
    have hb : b = 1 := Subsingleton.elim _ _
    simp only [hb, map_one]
  -- Hence the range of the coproduct lift is exactly the range of its left component.
  apply MonoidHom.range_eq_top.mp
  have hliftRange := MonoidHom.range_eq_top.mpr hlift
  simpa only [Monoid.Coprod.range_lift, hg, MonoidHom.range_one, sup_bot_eq] using hliftRange

/-- Helper for Corollary 70.4: when the right factor is trivial, a coproduct kernel
normally generated by comparison defects restricts to the normal closure of the left map. -/
private lemma coprodLeft_ker_eq_normalClosure_of_subsingleton_right
    {A B D P : Type*} [Group A] [Group B] [Group D] [Group P] [Subsingleton B]
    (left : D →* A) (right : D →* B) (f : A →* P) (g : B →* P)
    (hker : (Monoid.Coprod.lift f g).ker = Subgroup.normalClosure
      (Set.range fun d ↦
        ((Monoid.Coprod.inl.comp left) d)⁻¹ * (Monoid.Coprod.inr.comp right) d)) :
    f.ker = Subgroup.normalClosure (Set.range left) := by
  apply le_antisymm
  · -- Project a left-factor kernel element through the coproduct presentation.
    intro a ha
    have hinlKer : Monoid.Coprod.inl a ∈ (Monoid.Coprod.lift f g).ker := by
      apply MonoidHom.mem_ker.mpr
      simpa only [Monoid.Coprod.lift_apply_inl] using MonoidHom.mem_ker.mp ha
    have hinlNormal : Monoid.Coprod.inl a ∈ Subgroup.normalClosure
        (Set.range fun d ↦
          ((Monoid.Coprod.inl.comp left) d)⁻¹ * (Monoid.Coprod.inr.comp right) d) := by
      rw [← hker]
      exact hinlKer
    have hnormalLe : Subgroup.normalClosure
        (Set.range fun d ↦
          ((Monoid.Coprod.inl.comp left) d)⁻¹ * (Monoid.Coprod.inr.comp right) d) ≤
        (Subgroup.normalClosure (Set.range left)).comap
          (Monoid.Coprod.lift (MonoidHom.id A) (1 : B →* A)) := by
      apply Subgroup.normalClosure_le_normal
      rintro _ ⟨d, rfl⟩
      apply Subgroup.mem_comap.mpr
      simp only [map_mul, map_inv, MonoidHom.comp_apply,
        Monoid.Coprod.lift_apply_inl, Monoid.Coprod.lift_apply_inr,
        MonoidHom.id_apply, MonoidHom.one_apply, mul_one]
      exact (Subgroup.normalClosure (Set.range left)).inv_mem
        (Subgroup.subset_normalClosure ⟨d, rfl⟩)
    have haProjected := hnormalLe hinlNormal
    simpa only [Subgroup.mem_comap, Monoid.Coprod.lift_apply_inl,
      MonoidHom.id_apply] using haProjected
  · -- Each left generator is killed because its coproduct defect is in the given kernel.
    apply Subgroup.normalClosure_le_normal
    rintro _ ⟨d, rfl⟩
    apply MonoidHom.mem_ker.mpr
    have hdefectKer :
        ((Monoid.Coprod.inl.comp left) d)⁻¹ * (Monoid.Coprod.inr.comp right) d ∈
          (Monoid.Coprod.lift f g).ker := by
      rw [hker]
      exact Subgroup.subset_normalClosure ⟨d, rfl⟩
    have hdefectValue := MonoidHom.mem_ker.mp hdefectKer
    have hright : right d = 1 := Subsingleton.elim _ _
    simpa only [map_mul, map_inv, MonoidHom.comp_apply,
      Monoid.Coprod.lift_apply_inl, Monoid.Coprod.lift_apply_inr,
      hright, map_one, mul_one, inv_eq_one] using hdefectValue

/-- Helper for Corollary 70.4: the van Kampen relation function is the inverse-product
defect of the two inclusion maps from the intersection fundamental group. -/
private lemma vanKampenRelation_eq_leftRightDefect
    {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V) :
    FundamentalGroup.vanKampenRelation U V x₀ hx₀ = fun g ↦
      ((Monoid.Coprod.inl.comp
        (FundamentalGroup.mapOfSubset Set.inter_subset_left ⟨x₀, hx₀⟩)) g)⁻¹ *
      (Monoid.Coprod.inr.comp
        (FundamentalGroup.mapOfSubset Set.inter_subset_right ⟨x₀, hx₀⟩)) g := by
  -- Compare the functions pointwise and expose the presentation formula once.
  funext g
  simp only [FundamentalGroup.vanKampenRelation.eq_def, MonoidHom.comp_apply]

/-- Under the Seifert–van Kampen hypotheses and simple connectedness of `V`, inclusion
of `U` into `X` induces a surjection on fundamental groups. -/
theorem vanKampenLeftInclusion_surjective {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace U] [PathConnectedSpace (U ∩ V : Set X)]
    [SimplyConnectedSpace V] :
    Function.Surjective (FundamentalGroup.mapOfSubtype U ⟨x₀, hx₀.1⟩) := by
  -- Collapse the simply connected `V` factor in the surjective van Kampen map.
  apply coprodLeft_surjective_of_subsingleton_right
    (FundamentalGroup.mapOfSubtype U ⟨x₀, hx₀.1⟩)
    (FundamentalGroup.mapOfSubtype V ⟨x₀, hx₀.2⟩)
  simpa only [FundamentalGroup.vanKampenMap.eq_def] using
    vanKampenMap_surjective U V x₀ hx₀ hU hV hcover

/-- Under the Seifert–van Kampen hypotheses and simple connectedness of `V`, the kernel
of the inclusion-induced map from `π₁(U, x₀)` is the normal closure of the image from
`π₁(U ∩ V, x₀)`. -/
theorem vanKampenLeftInclusion_ker {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace U] [PathConnectedSpace (U ∩ V : Set X)]
    [SimplyConnectedSpace V] :
    (FundamentalGroup.mapOfSubtype U ⟨x₀, hx₀.1⟩).ker =
      vanKampenLeftNormalClosure U V x₀ hx₀ := by
  -- Project the van Kampen kernel presentation onto the nontrivial `U` factor.
  apply coprodLeft_ker_eq_normalClosure_of_subsingleton_right
    (FundamentalGroup.mapOfSubset Set.inter_subset_left ⟨x₀, hx₀⟩)
    (FundamentalGroup.mapOfSubset Set.inter_subset_right ⟨x₀, hx₀⟩)
    (FundamentalGroup.mapOfSubtype U ⟨x₀, hx₀.1⟩)
    (FundamentalGroup.mapOfSubtype V ⟨x₀, hx₀.2⟩)
  simpa only [FundamentalGroup.vanKampenMap.eq_def,
    FundamentalGroup.vanKampenNormalClosure.eq_def,
    FundamentalGroup.vanKampenRelations.eq_def,
    vanKampenRelation_eq_leftRightDefect, MonoidHom.comp_apply] using
    vanKampenMap_ker U V x₀ hx₀ hU hV hcover

/-- The homomorphism induced by inclusion from the quotient of `π₁(U, x₀)` by the
normal closure of the image from `π₁(U ∩ V, x₀)`. -/
noncomputable def vanKampenLeftQuotientInclusion
    {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace U] [PathConnectedSpace (U ∩ V : Set X)]
    [SimplyConnectedSpace V] :
    FundamentalGroup U ⟨x₀, hx₀.1⟩ ⧸ vanKampenLeftNormalClosure U V x₀ hx₀ →*
      FundamentalGroup X x₀ :=
  QuotientGroup.lift (vanKampenLeftNormalClosure U V x₀ hx₀)
    (FundamentalGroup.mapOfSubtype U ⟨x₀, hx₀.1⟩)
    (vanKampenLeftInclusion_ker U V x₀ hx₀ hU hV hcover ▸ le_rfl)

/-- The quotient homomorphism agrees with the inclusion-induced homomorphism on
representatives. -/
@[simp]
theorem vanKampenLeftQuotientInclusion_mk
    {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace U] [PathConnectedSpace (U ∩ V : Set X)]
    [SimplyConnectedSpace V]
    (g : FundamentalGroup U ⟨x₀, hx₀.1⟩) :
    vanKampenLeftQuotientInclusion U V x₀ hx₀ hU hV hcover g =
      FundamentalGroup.mapOfSubtype U ⟨x₀, hx₀.1⟩ g := by
  simp [vanKampenLeftQuotientInclusion]

/-- Corollary 70.4: Under the Seifert–van Kampen hypotheses, if `V` is simply
connected, there is an isomorphism from `π₁(U, x₀)` modulo the least normal subgroup
containing the image of `π₁(U ∩ V, x₀) → π₁(U, x₀)` to `π₁(X, x₀)`, induced by
inclusion of `U` into `X`. -/
theorem exists_vanKampenLeftQuotientEquiv
    {X : Type u} [TopologicalSpace X]
    (U V : Set X) (x₀ : X) (hx₀ : x₀ ∈ U ∩ V)
    (hU : IsOpen U) (hV : IsOpen V) (hcover : U ∪ V = Set.univ)
    [PathConnectedSpace U] [PathConnectedSpace (U ∩ V : Set X)]
    [SimplyConnectedSpace V] :
    ∃ k : FundamentalGroup U ⟨x₀, hx₀.1⟩ ⧸ vanKampenLeftNormalClosure U V x₀ hx₀ ≃*
        FundamentalGroup X x₀,
      k.toMonoidHom = vanKampenLeftQuotientInclusion U V x₀ hx₀ hU hV hcover := by
  let k := QuotientGroup.liftEquiv (vanKampenLeftNormalClosure U V x₀ hx₀)
    (vanKampenLeftInclusion_surjective U V x₀ hx₀ hU hV hcover)
    (vanKampenLeftInclusion_ker U V x₀ hx₀ hU hV hcover).symm
  refine ⟨k, ?_⟩
  -- Both quotient homomorphisms agree on every representative from `π₁(U, x₀)`.
  apply MonoidHom.ext
  intro q
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective
    (vanKampenLeftNormalClosure U V x₀ hx₀) q
  exact (QuotientGroup.liftEquiv_mk (vanKampenLeftNormalClosure U V x₀ hx₀)
    (vanKampenLeftInclusion_surjective U V x₀ hx₀ hU hV hcover)
    (vanKampenLeftInclusion_ker U V x₀ hx₀ hU hV hcover).symm g).trans
      (vanKampenLeftQuotientInclusion_mk U V x₀ hx₀ hU hV hcover g).symm
