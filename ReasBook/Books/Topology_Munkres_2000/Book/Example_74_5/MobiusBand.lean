module

public import Mathlib.Topology.UnitInterval

public section

open scoped unitInterval

/-- The rectangle used in the quotient presentation of the Möbius band. -/
abbrev UnitSquare := unitInterval × unitInterval

/-- The generating identification `(0, t) ∼ (1, 1 - t)` for the Möbius band. -/
def mobiusBandGlue (point point' : UnitSquare) : Prop :=
  point.1 = 0 ∧ point'.1 = 1 ∧ point.2 = unitInterval.symm point'.2

/-- The Möbius band as the rectangle quotient generated by `(0, t) ∼ (1, 1 - t)`. -/
abbrev MobiusBand := Quotient (Relation.EqvGen.setoid mobiusBandGlue)
