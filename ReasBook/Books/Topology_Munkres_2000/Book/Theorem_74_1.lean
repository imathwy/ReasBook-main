module

public import Topology_Munkres_2000.Book.Definition_74_3.Pasting
public import Topology_Munkres_2000.Book.Lemma_73_3
public import Mathlib.Topology.Compactness.Compact
public import Topology_Munkres_2000.Book.Proposition_74_1
import all Topology_Munkres_2000.Book.Definition_74_3

public section

open Set

universe u v

variable {ι : Type u} [Fintype ι] {S : Type v}

/-- Helper for Theorem 74.1: a finite family of cyclic polygonal regions with labelled,
oriented edges to paste. -/
structure PolygonalPasting (ι : Type u) [Fintype ι] (S : Type v) where
  /-- The number of sides of each polygonal region. -/
  sides : ι → ℕ
  /-- The cyclic polygon presenting each region. -/
  polygon : ∀ i, CyclicPolygon (sides i)
  /-- The edge labels and orientations on each region. -/
  pasting : ∀ i, (polygon i).EdgePasting S

/-- Helper for Theorem 74.1: the explicit and implicit-setoid quotient constructors
define the same projection function. -/
private lemma quotientMk_eq_quotientMk' {X : Type*} (setoid : Setoid X) :
    Quotient.mk setoid = @Quotient.mk' X setoid := by
  -- Both constructors represent the same point, hence are equal by reflexivity of the setoid.
  funext x
  exact Quotient.sound (setoid.refl x)

namespace PolygonalPasting

/-- Helper for Theorem 74.1: the disjoint union of the polygonal regions in a finite
presentation. -/
abbrev Source (presentation : PolygonalPasting ι S) :=
  (i : ι) × (presentation.polygon i).region

/-- Helper for Theorem 74.1: two source points are directly paired when equally labelled
oriented edges produce them at a common affine parameter. -/
def Related (presentation : PolygonalPasting ι S)
    (x y : presentation.Source) : Prop :=
  ∃ (i j : ι) (edgeᵢ : Fin (presentation.sides i))
      (edgeⱼ : Fin (presentation.sides j)) (t : unitInterval),
    (presentation.pasting i).label edgeᵢ = (presentation.pasting j).label edgeⱼ ∧
      x = ⟨i, (presentation.pasting i).orientedPoint edgeᵢ t⟩ ∧
      y = ⟨j, (presentation.pasting j).orientedPoint edgeⱼ t⟩

/-- Helper for Theorem 74.1: the equivalence relation generated by all equally labelled
edge pairings. -/
abbrev Identified (presentation : PolygonalPasting ι S) : Setoid presentation.Source :=
  Relation.EqvGen.setoid presentation.Related

/-- Helper for Theorem 74.1: the topological space obtained by pasting all equally
labelled oriented edges. -/
abbrev Realization (presentation : PolygonalPasting ι S) :=
  Quotient presentation.Identified

/-- Helper for Theorem 74.1: the realization carries its canonical quotient topology. -/
instance instTopologicalSpaceRealization (presentation : PolygonalPasting ι S) :
    TopologicalSpace presentation.Realization :=
  inferInstanceAs (TopologicalSpace (Quotient presentation.Identified))

/-- Helper for Theorem 74.1: the canonical map from the finite family of regions to its
pasted realization. -/
def quotientMap (presentation : PolygonalPasting ι S) :
    presentation.Source → presentation.Realization :=
  Quotient.mk presentation.Identified

/-- Helper for Theorem 74.1: the canonical map to the pasted realization is a quotient
map. -/
theorem isQuotientMap_quotientMap (presentation : PolygonalPasting ι S) :
    Topology.IsQuotientMap presentation.quotientMap := by
  -- Identify the explicit setoid constructor with the canonical quotient projection.
  rw [quotientMap, quotientMk_eq_quotientMk' presentation.Identified]
  exact isQuotientMap_quotient_mk'

end PolygonalPasting

namespace CyclicPolygon

/-- Helper for Theorem 74.1: every cyclic polygonal region is compact. -/
instance instCompactSpaceRegion {n : ℕ} (poly : CyclicPolygon n) :
    CompactSpace poly.region := by
  -- The region is the convex hull of the finite range of its cyclic vertices.
  apply isCompact_iff_compactSpace.mp
  rw [poly.region_eq_convexHull]
  exact (Set.finite_range poly.toPolygon.vertices).isCompact_convexHull ℝ

/-- Helper for Theorem 74.1: reversing a unit-interval parameter stays in the unit interval. -/
private lemma oneSub_mem_unitInterval (t : unitInterval) :
    1 - (t : ℝ) ∈ unitInterval := by
  -- Reverse the two endpoint inequalities of `t ∈ [0, 1]`.
  constructor
  · linarith [t.property.2]
  · linarith [t.property.1]

/-- Helper for Theorem 74.1: the parameter obtained by reversing the unit interval. -/
private def reverseParameter (t : unitInterval) : unitInterval :=
  ⟨1 - (t : ℝ), oneSub_mem_unitInterval t⟩

/-- Helper for Theorem 74.1: reversing the unit interval exchanges zero and one. -/
private lemma reverseParameter_eq_zero_iff (t : unitInterval) :
    reverseParameter t = 0 ↔ t = 1 := by
  -- Equality of interval points is equality of their real coordinates.
  constructor
  · intro h
    apply Subtype.ext
    have hval := congrArg Subtype.val h
    dsimp [reverseParameter] at hval
    exact (sub_eq_zero.mp hval).symm
  · intro h
    subst t
    apply Subtype.ext
    norm_num [reverseParameter]

/-- Helper for Theorem 74.1: reversing the unit interval exchanges one and zero. -/
private lemma reverseParameter_eq_one_iff (t : unitInterval) :
    reverseParameter t = 1 ↔ t = 0 := by
  -- Equality of interval points is equality of their real coordinates.
  constructor
  · intro h
    apply Subtype.ext
    have hval := congrArg Subtype.val h
    dsimp [reverseParameter] at hval
    norm_num at hval
    exact congrArg Subtype.val hval
  · intro h
    subst t
    apply Subtype.ext
    norm_num [reverseParameter]

namespace EdgePasting

variable {n : ℕ} {poly : CyclicPolygon n}

/-- Helper for Theorem 74.1: convert the chosen edge orientation's parameter to the
counterclockwise cyclic parameter. -/
private def cyclicParameter (pasting : poly.EdgePasting S) (edge : Fin n)
    (t : unitInterval) : unitInterval :=
  if pasting.sign edge then t else reverseParameter t

/-- Helper for Theorem 74.1: the chosen oriented edge point is the corresponding cyclic
edge point with its orientation-normalized parameter. -/
private lemma orientedPoint_eq_boundaryToRegion_edgePoint
    (pasting : poly.EdgePasting S) (edge : Fin n) (t : unitInterval) :
    pasting.orientedPoint edge t =
      poly.boundaryToRegion (poly.edgePoint edge (cyclicParameter pasting edge t)) := by
  -- Split on the sign; reversal changes `t` to `1 - t` in the cyclic parameterization.
  apply Subtype.ext
  rw [pasting.orientedPoint_apply, pasting.includePoint_coe,
    poly.boundaryToRegion_coe, poly.edgePoint_coe_eq_lineMap, pasting.orientation_eq,
    OrientedSegment.point_coe]
  cases hsign : pasting.sign edge
  · simp only [cyclicParameter, hsign, Bool.false_eq_true, if_false, signedOrientation,
      OrientedSegment.reverse_initial, OrientedSegment.reverse_final, cyclicOrientation,
      reverseParameter, Subtype.coe_mk]
    exact (AffineMap.lineMap_apply_one_sub _ _ _).symm
  · simp only [cyclicParameter, hsign, if_true, signedOrientation, cyclicOrientation]

/-- Helper for Theorem 74.1: orientation normalization is injective in the edge parameter. -/
private lemma cyclicParameter_injective (pasting : poly.EdgePasting S) (edge : Fin n) :
    Function.Injective (cyclicParameter pasting edge) := by
  -- For a positive sign this is the identity; for a negative sign compare real coordinates.
  intro s t hst
  cases hsign : pasting.sign edge
  · apply Subtype.ext
    have hval := congrArg Subtype.val hst
    simp only [cyclicParameter, hsign, Bool.false_eq_true, if_false, reverseParameter,
      Subtype.coe_mk] at hval
    linarith
  · simpa only [cyclicParameter, hsign, if_true] using hst

/-- Helper for Theorem 74.1: normalization preserves exactly the two endpoint parameters. -/
private lemma cyclicParameter_isEndpoint_iff (pasting : poly.EdgePasting S)
    (edge : Fin n) (t : unitInterval) :
    cyclicParameter pasting edge t = 0 ∨ cyclicParameter pasting edge t = 1 ↔
      t = 0 ∨ t = 1 := by
  -- A negative orientation exchanges the endpoints, while a positive orientation fixes them.
  cases hsign : pasting.sign edge
  · simp only [cyclicParameter, hsign, Bool.false_eq_true, if_false,
      reverseParameter_eq_zero_iff, reverseParameter_eq_one_iff, or_comm]
  · simp only [cyclicParameter, hsign, if_true]

/-- Helper for Theorem 74.1: two oriented polygon-edge parameters give the same point only
on the same edge at the same parameter, or at endpoints of both edges. -/
private lemma orientedPoint_eq_or_endpoints (pasting : poly.EdgePasting S)
    (first second : Fin n) (s t : unitInterval)
    (hpoint : pasting.orientedPoint first s = pasting.orientedPoint second t) :
    (first = second ∧ s = t) ∨
      ((s = 0 ∨ s = 1) ∧ (t = 0 ∨ t = 1)) := by
  -- Normalize both chosen orientations to the canonical cyclic edge parameterization.
  have hregion :
      poly.boundaryToRegion (poly.edgePoint first (cyclicParameter pasting first s)) =
        poly.boundaryToRegion (poly.edgePoint second (cyclicParameter pasting second t)) := by
    rw [← pasting.orientedPoint_eq_boundaryToRegion_edgePoint,
      ← pasting.orientedPoint_eq_boundaryToRegion_edgePoint]
    exact hpoint
  have hedgePoint :
      poly.edgePoint first (cyclicParameter pasting first s) =
        poly.edgePoint second (cyclicParameter pasting second t) := by
    apply Subtype.ext
    have hval := congrArg Subtype.val hregion
    simpa only [poly.boundaryToRegion_coe] using hval
  -- Proposition 74.1 classifies intersections of two cyclic polygon edges.
  rcases (poly.edgePoint_eq_iff first second _ _).mp hedgePoint with
      ⟨hedge, hparameter⟩ | ⟨hfirst, hsecond, hedge⟩ | ⟨hfirst, hsecond, hedge⟩
  · subst second
    exact Or.inl ⟨rfl, pasting.cyclicParameter_injective first hparameter⟩
  · exact Or.inr ⟨
      (pasting.cyclicParameter_isEndpoint_iff first s).mp (Or.inl hfirst),
      (pasting.cyclicParameter_isEndpoint_iff second t).mp (Or.inr hsecond)⟩
  · exact Or.inr ⟨
      (pasting.cyclicParameter_isEndpoint_iff first s).mp (Or.inr hfirst),
      (pasting.cyclicParameter_isEndpoint_iff second t).mp (Or.inl hsecond)⟩

/-- Helper for Theorem 74.1: oriented edge parameterization is continuous. -/
private lemma continuous_orientedPoint (pasting : poly.EdgePasting S) (edge : Fin n) :
    Continuous (pasting.orientedPoint edge) := by
  -- Continuity is checked after coercion to the ambient Euclidean plane.
  refine continuous_induced_rng.2 ?_
  have hcontinuous : Continuous (fun t : unitInterval ↦
      ((pasting.orientation edge).point t : EuclideanSpace ℝ (Fin 2))) :=
    continuous_subtype_val.comp (pasting.orientation edge).continuous_point
  have hcoe : ∀ t : unitInterval,
      ((pasting.orientedPoint edge t : poly.region) : EuclideanSpace ℝ (Fin 2)) =
        (pasting.orientation edge).point t := by
    intro t
    rw [pasting.orientedPoint_apply, pasting.includePoint_coe]
  exact hcontinuous.congr fun t ↦ (hcoe t).symm

end EdgePasting

end CyclicPolygon

namespace PolygonalPasting

variable (presentation : PolygonalPasting ι S)

/-- Helper for Theorem 74.1: the finite disjoint union of presenting polygonal regions is
compact. -/
private instance compactSpaceSource : CompactSpace presentation.Source :=
  inferInstance

/-- Helper for Theorem 74.1: choose parameter zero or one according to a Boolean endpoint. -/
private def endpointParameter (endpoint : Bool) : unitInterval :=
  if endpoint then 1 else 0

/-- Helper for Theorem 74.1: a finite endpoint index determines a source vertex. -/
private noncomputable def sourceVertex
    (vertex : (Σ i, Fin (presentation.sides i)) × Bool) : presentation.Source :=
  ⟨vertex.1.1,
    (presentation.pasting vertex.1.1).orientedPoint vertex.1.2
      (endpointParameter vertex.2)⟩

/-- Helper for Theorem 74.1: source vertices are endpoints of the finitely many oriented edges. -/
private def IsVertex (x : presentation.Source) : Prop :=
  x ∈ Set.range presentation.sourceVertex

/-- Helper for Theorem 74.1: the source vertex locus is finite. -/
private lemma finite_isVertex :
    {x : presentation.Source | presentation.IsVertex x}.Finite := by
  -- The locus is the range of a map from a finite sigma type times `Bool`.
  simpa only [IsVertex, Set.setOf_mem_eq] using Set.finite_range presentation.sourceVertex

/-- Helper for Theorem 74.1: a source edge point at parameter zero or one is a source vertex. -/
private lemma isVertex_orientedPoint_of_endpoint (i : ι)
    (edge : Fin (presentation.sides i)) (t : unitInterval) (ht : t = 0 ∨ t = 1) :
    presentation.IsVertex
      ⟨i, (presentation.pasting i).orientedPoint edge t⟩ := by
  -- Record the endpoint by the corresponding Boolean in the finite vertex range.
  rcases ht with rfl | rfl
  · refine ⟨⟨⟨i, edge⟩, false⟩, ?_⟩
    rfl
  · refine ⟨⟨⟨i, edge⟩, true⟩, ?_⟩
    rfl

/-- Helper for Theorem 74.1: direct edge pairing is symmetric. -/
private lemma related_symm {x y : presentation.Source}
    (hxy : presentation.Related x y) : presentation.Related y x := by
  -- Swap the two equally labelled edge occurrences while keeping their common parameter.
  obtain ⟨i, j, edgeᵢ, edgeⱼ, t, hlabel, hx, hy⟩ := hxy
  exact ⟨j, i, edgeⱼ, edgeᵢ, t, hlabel.symm, hy, hx⟩

/-- Helper for Theorem 74.1: each Boolean-selected endpoint parameter is zero or one. -/
private lemma endpointParameter_isEndpoint (endpoint : Bool) :
    endpointParameter endpoint = 0 ∨ endpointParameter endpoint = 1 := by
  -- The two Boolean cases select the two endpoints definitionally.
  cases endpoint <;> simp only [endpointParameter, Bool.false_eq_true, if_false, if_true,
    Or.inl, Or.inr]

/-- Helper for Theorem 74.1: a parameterized edge point in the finite vertex locus must
occur at an endpoint parameter. -/
private lemma orientedParameter_isEndpoint_of_isVertex (i : ι)
    (edge : Fin (presentation.sides i)) (t : unitInterval)
    (hvertex : presentation.IsVertex
      ⟨i, (presentation.pasting i).orientedPoint edge t⟩) :
    t = 0 ∨ t = 1 := by
  -- Compare the given edge expression with the endpoint expression witnessing vertexhood.
  obtain ⟨⟨⟨j, otherEdge⟩, endpoint⟩, hpoint⟩ := hvertex
  have hindex : j = i := congrArg Sigma.fst hpoint
  subst j
  have hedgePoint :
      (presentation.pasting i).orientedPoint otherEdge
          (endpointParameter endpoint) =
        (presentation.pasting i).orientedPoint edge t :=
    eq_of_heq (Sigma.mk.inj_iff.mp hpoint).2
  rcases (presentation.pasting i).orientedPoint_eq_or_endpoints
      otherEdge edge (endpointParameter endpoint) t hedgePoint with
    ⟨_, hparameter⟩ | ⟨_, ht⟩
  · rcases endpointParameter_isEndpoint endpoint with hzero | hone
    · exact Or.inl (hparameter.symm.trans hzero)
    · exact Or.inr (hparameter.symm.trans hone)
  · exact ht

/-- Helper for Theorem 74.1: direct identification transports vertexhood from its target
to its source. -/
private lemma related_isVertex_left_of_right {x y : presentation.Source}
    (hxy : presentation.Related x y) (hy : presentation.IsVertex y) :
    presentation.IsVertex x := by
  -- The common relation parameter is an endpoint because its target is a source vertex.
  obtain ⟨i, j, edgeᵢ, edgeⱼ, t, _, hx, hyPoint⟩ := hxy
  subst x
  subst y
  exact presentation.isVertex_orientedPoint_of_endpoint i edgeᵢ t
    (presentation.orientedParameter_isEndpoint_of_isVertex j edgeⱼ t hy)

/-- Helper for Theorem 74.1: direct identification transports vertexhood from its source
to its target. -/
private lemma related_isVertex_right_of_left {x y : presentation.Source}
    (hxy : presentation.Related x y) (hx : presentation.IsVertex x) :
    presentation.IsVertex y := by
  -- Reverse the symmetric direct pairing and use the preceding endpoint argument.
  exact presentation.related_isVertex_left_of_right
    (presentation.related_symm hxy) hx

/-- Helper for Theorem 74.1: two composable direct identifications collapse to one direct
identification unless their outer points are both vertices. -/
private lemma related_compose_or_vertices {x y z : presentation.Source}
    (hxy : presentation.Related x y) (hyz : presentation.Related y z) :
    presentation.Related x z ∨
      (presentation.IsVertex x ∧ presentation.IsVertex z) := by
  -- Compare the two edge parameterizations of the common middle point.
  obtain ⟨i, j, edgeᵢ, edgeⱼ, t, hlabel₁, hx, hy₁⟩ := hxy
  obtain ⟨k, l, edgeₖ, edgeₗ, u, hlabel₂, hy₂, hz⟩ := hyz
  have hmiddle :
      (⟨j, (presentation.pasting j).orientedPoint edgeⱼ t⟩ : presentation.Source) =
        ⟨k, (presentation.pasting k).orientedPoint edgeₖ u⟩ :=
    hy₁.symm.trans hy₂
  have hindex : j = k := congrArg Sigma.fst hmiddle
  subst k
  have hedgePoint :
      (presentation.pasting j).orientedPoint edgeⱼ t =
        (presentation.pasting j).orientedPoint edgeₖ u :=
    eq_of_heq (Sigma.mk.inj_iff.mp hmiddle).2
  rcases (presentation.pasting j).orientedPoint_eq_or_endpoints
      edgeⱼ edgeₖ t u hedgePoint with
    ⟨hedge, hparameter⟩ | ⟨ht, hu⟩
  · subst edgeₖ
    subst u
    exact Or.inl ⟨i, l, edgeᵢ, edgeₗ, t, hlabel₁.trans hlabel₂,
      hx, hz⟩
  · exact Or.inr ⟨
      hx ▸ presentation.isVertex_orientedPoint_of_endpoint i edgeᵢ t ht,
      hz ▸ presentation.isVertex_orientedPoint_of_endpoint l edgeₗ u hu⟩

/-- Helper for Theorem 74.1: generated identifications are equality, one direct pairing,
or a pair of source vertices. -/
private lemma identified_eqOrRelatedOrVertices {x y : presentation.Source}
    (hxy : presentation.Identified x y) :
    x = y ∨ presentation.Related x y ∨
      (presentation.IsVertex x ∧ presentation.IsVertex y) := by
  -- Induct on the generated equivalence relation, using vertexhood as the stable remainder.
  induction hxy with
  | rel x y hxy => exact Or.inr (Or.inl hxy)
  | refl x => exact Or.inl rfl
  | symm x y _ ih =>
      rcases ih with hxy | hxy | hvertices
      · exact Or.inl hxy.symm
      · exact Or.inr (Or.inl (presentation.related_symm hxy))
      · exact Or.inr (Or.inr hvertices.symm)
  | trans x y z _ _ ihxy ihyz =>
      rcases ihxy with hxy | hxy | hxy
      · subst x
        exact ihyz
      · rcases ihyz with hyz | hyz | hyz
        · subst z
          exact Or.inr (Or.inl hxy)
        · rcases presentation.related_compose_or_vertices hxy hyz with hxz | hxz
          · exact Or.inr (Or.inl hxz)
          · exact Or.inr (Or.inr hxz)
        · exact Or.inr (Or.inr
            ⟨presentation.related_isVertex_left_of_right hxy hyz.1, hyz.2⟩)
      · rcases ihyz with hyz | hyz | hyz
        · subst z
          exact Or.inr (Or.inr hxy)
        · exact Or.inr (Or.inr
            ⟨hxy.1, presentation.related_isVertex_right_of_left hyz hxy.2⟩)
        · exact Or.inr (Or.inr ⟨hxy.1, hyz.2⟩)

/-- Helper for Theorem 74.1: the graph of direct edge pairing. -/
private def relatedGraph : Set (presentation.Source × presentation.Source) :=
  {pair | presentation.Related pair.1 pair.2}

/-- Helper for Theorem 74.1: each fixed edge-pair parameterization is continuous. -/
private lemma continuous_pairedPoint (i j : ι)
    (edgeᵢ : Fin (presentation.sides i)) (edgeⱼ : Fin (presentation.sides j)) :
    Continuous (fun t : unitInterval ↦
      ((⟨i, (presentation.pasting i).orientedPoint edgeᵢ t⟩,
          ⟨j, (presentation.pasting j).orientedPoint edgeⱼ t⟩) :
        presentation.Source × presentation.Source)) := by
  -- Pair the two continuous oriented-edge maps after inserting their sigma indices.
  exact ((continuous_sigmaMk
      (σ := fun i ↦ (presentation.polygon i).region) (i := i)).comp
      ((presentation.pasting i).continuous_orientedPoint edgeᵢ)).prodMk
    ((continuous_sigmaMk
      (σ := fun i ↦ (presentation.polygon i).region) (i := j)).comp
      ((presentation.pasting j).continuous_orientedPoint edgeⱼ))

/-- Helper for Theorem 74.1: the direct-relation graph is a finite union of ranges of
common-parameter edge-pair maps. -/
private lemma relatedGraph_eq_iUnion :
    presentation.relatedGraph =
      ⋃ (i : ι) (j : ι)
        (edgeᵢ : Fin (presentation.sides i))
        (edgeⱼ : Fin (presentation.sides j))
        (_ : (presentation.pasting i).label edgeᵢ =
          (presentation.pasting j).label edgeⱼ),
        Set.range (fun t : unitInterval ↦
          ((⟨i, (presentation.pasting i).orientedPoint edgeᵢ t⟩,
              ⟨j, (presentation.pasting j).orientedPoint edgeⱼ t⟩) :
            presentation.Source × presentation.Source)) := by
  -- Expand direct pairing and package its common parameter as membership in a range.
  ext pair
  simp only [relatedGraph, Set.mem_setOf_eq, Set.mem_iUnion, Set.mem_range]
  constructor
  · rintro ⟨i, j, edgeᵢ, edgeⱼ, t, hlabel, hfirst, hsecond⟩
    refine ⟨i, j, edgeᵢ, edgeⱼ, hlabel, t, ?_⟩
    apply Prod.ext
    · exact hfirst.symm
    · exact hsecond.symm
  · rintro ⟨i, j, edgeᵢ, edgeⱼ, hlabel, t, hpair⟩
    refine ⟨i, j, edgeᵢ, edgeⱼ, t, hlabel, ?_, ?_⟩
    · exact (congrArg Prod.fst hpair).symm
    · exact (congrArg Prod.snd hpair).symm

/-- Helper for Theorem 74.1: the graph of direct edge pairing is compact. -/
private lemma isCompact_relatedGraph : IsCompact presentation.relatedGraph := by
  -- Each range is compact, and all five indexing families are finite.
  rw [presentation.relatedGraph_eq_iUnion]
  exact isCompact_iUnion fun i ↦
    isCompact_iUnion fun j ↦
      isCompact_iUnion fun edgeᵢ ↦
        isCompact_iUnion fun edgeⱼ ↦
          isCompact_iUnion fun _ ↦
            isCompact_range (presentation.continuous_pairedPoint i j edgeᵢ edgeⱼ)

/-- Helper for Theorem 74.1: the graph of direct edge pairing is closed. -/
private lemma isClosed_relatedGraph : IsClosed presentation.relatedGraph := by
  -- Compact subsets of the Hausdorff source product are closed.
  exact presentation.isCompact_relatedGraph.isClosed

/-- Helper for Theorem 74.1: the graph of the generated identification relation. -/
private def identifiedGraph : Set (presentation.Source × presentation.Source) :=
  {pair | presentation.Identified pair.1 pair.2}

/-- Helper for Theorem 74.1: the generated graph is the diagonal, the direct graph,
and a residual graph supported on the finite vertex locus. -/
private lemma identifiedGraph_eq_union :
    presentation.identifiedGraph =
      diagonal presentation.Source ∪
        (presentation.relatedGraph ∪
          {pair | presentation.Identified pair.1 pair.2 ∧
            presentation.IsVertex pair.1 ∧ presentation.IsVertex pair.2}) := by
  -- Apply the generated-relation classification in one direction; the reverse inclusions
  -- are reflexivity, one generated step, and the retained identification hypothesis.
  ext pair
  change presentation.Identified pair.1 pair.2 ↔
    pair ∈ diagonal presentation.Source ∨
      (presentation.Related pair.1 pair.2 ∨
        (presentation.Identified pair.1 pair.2 ∧
          presentation.IsVertex pair.1 ∧ presentation.IsVertex pair.2))
  rw [mem_diagonal_iff]
  constructor
  · intro hidentified
    rcases presentation.identified_eqOrRelatedOrVertices hidentified with
      heq | hrelated | hvertices
    · exact Or.inl heq
    · exact Or.inr (Or.inl hrelated)
    · exact Or.inr (Or.inr ⟨hidentified, hvertices⟩)
  · rintro (heq | hrelated | hidentified)
    · exact heq ▸ Relation.EqvGen.refl pair.1
    · exact Relation.EqvGen.rel pair.1 pair.2 hrelated
    · exact hidentified.1

/-- Helper for Theorem 74.1: the residual identified vertex-pair graph is finite. -/
private lemma finite_identifiedVertexGraph :
    {pair : presentation.Source × presentation.Source |
      presentation.Identified pair.1 pair.2 ∧
        presentation.IsVertex pair.1 ∧ presentation.IsVertex pair.2}.Finite := by
  -- Forget the identification condition and embed the residual graph in the finite product.
  apply ((presentation.finite_isVertex).prod presentation.finite_isVertex).subset
  intro pair hpair
  exact ⟨hpair.2.1, hpair.2.2⟩

/-- Helper for Theorem 74.1: the generated identification relation has closed graph. -/
private lemma isClosed_identifiedGraph : IsClosed presentation.identifiedGraph := by
  -- Close the three-piece decomposition: diagonal, direct graph, and finite vertex remainder.
  rw [presentation.identifiedGraph_eq_union]
  exact isClosed_diagonal.union
    (presentation.isClosed_relatedGraph.union
      presentation.finite_identifiedVertexGraph.isClosed)

end PolygonalPasting

/-- Helper for Theorem 74.1: a quotient of a compact Hausdorff space by a closed
equivalence relation has a closed quotient map. -/
private lemma isClosedMap_quotientMk_of_isClosed_rel
    {X : Type*} [TopologicalSpace X] [CompactSpace X] [T2Space X]
    (setoid : Setoid X)
    (hrelation : IsClosed {pair : X × X | setoid pair.1 pair.2}) :
    IsClosedMap (Quotient.mk setoid) := by
  -- Test closedness in the quotient by pulling the image back to its saturation.
  rw [quotientMk_eq_quotientMk' setoid]
  intro C hC
  rw [← isQuotientMap_quotient_mk'.isClosed_preimage]
  have hsaturation :
      (@Quotient.mk' X setoid) ⁻¹' ((@Quotient.mk' X setoid) '' C) =
        Prod.fst ''
          ({pair : X × X | setoid pair.1 pair.2} ∩ (Set.univ ×ˢ C)) := by
    ext x
    constructor
    · rintro ⟨y, hy, heq⟩
      refine ⟨(x, y), ⟨Quotient.exact heq.symm, Set.mem_prod.2 ⟨Set.mem_univ x, hy⟩⟩, rfl⟩
    · rintro ⟨⟨x', y⟩, ⟨hxy, _, hy⟩, hx'⟩
      have hx : x' = x := hx'
      have hrelation_xy : setoid x' y := hxy
      have hyC : y ∈ C := hy
      subst x'
      exact ⟨y, hyC, (Quotient.sound hrelation_xy).symm⟩
  rw [hsaturation]
  -- The saturation is the continuous first projection of a closed subset of a compact product.
  exact ((hrelation.inter (isClosed_univ.prod hC)).isCompact.image continuous_fst).isClosed

namespace PolygonalPasting

variable (presentation : PolygonalPasting ι S)

/-- Helper for Theorem 74.1: the polygonal quotient map is closed, obtained from the
closed graph of the generated edge-identification relation. -/
theorem isClosedMap_quotientMap :
    IsClosedMap presentation.quotientMap := by
  -- Apply the generic compact closed-relation criterion to the generated identification.
  simpa only [quotientMap, identifiedGraph] using
    isClosedMap_quotientMk_of_isClosed_rel presentation.Identified
      presentation.isClosed_identifiedGraph

/-- Helper for Theorem 74.1: the realization of a finite polygonal pasting is compact. -/
instance instCompactSpaceRealization :
    CompactSpace presentation.Realization :=
  Quotient.compactSpace

/-- Helper for Theorem 74.1: the Hausdorff instance for a finite polygonal pasting
realization. -/
instance instT4SpaceRealization :
    T4Space presentation.Realization := by
  -- Lemma 73.3 transfers normal Hausdorff separation along the verified closed quotient map.
  exact presentation.isQuotientMap_quotientMap.t4Space
    presentation.isClosedMap_quotientMap

/-- Theorem 74.1: the realization of a finite collection of polygonal regions pasted
along equally labelled edges is compact and Hausdorff. -/
theorem compact_and_t2Space_realization :
    CompactSpace presentation.Realization ∧ T2Space presentation.Realization := by
  -- Route correction: the compact and T4 declarations are supporting instances; this
  -- conjunction is the label-associated theorem that packages their consequences.
  -- Package the compact and Hausdorff structures supplied by the verified instances.
  constructor
  · infer_instance
  · infer_instance

end PolygonalPasting
