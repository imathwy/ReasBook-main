module

public import Mathlib.Topology.Bases
public import Mathlib.Topology.Instances.Real.Lemmas

public section

open Set

/-- The concrete carrier of the Prüfer manifold: points `(x, y, z)` with either
`0 < x` and `z = 0`, or `x ≤ 0`. -/
structure PruferManifold where
  /-- The first real coordinate. -/
  x : ℝ
  /-- The second real coordinate. -/
  y : ℝ
  /-- The sheet coordinate. -/
  z : ℝ
  /-- The coordinate triple belongs to the upper half-plane or a nonpositive sheet. -/
  valid : (0 < x ∧ z = 0) ∨ x ≤ 0

namespace PruferManifold

/-- Prüfer-manifold points are equal when their three real coordinates are equal. -/
@[ext]
theorem ext {p q : PruferManifold} (hx : p.x = q.x) (hy : p.y = q.y) (hz : p.z = q.z) :
    p = q := by
  cases p
  cases q
  simp_all

/-- A point `(x, y, 0)` of the positive-`x` upper half-plane. -/
def upper (x y : ℝ) (hx : 0 < x) : PruferManifold :=
  ⟨x, y, 0, Or.inl ⟨hx, rfl⟩⟩

/-- A point `(x, y, c)` of the sheet indexed by `c`, where `x ≤ 0`. -/
def sheet (c x y : ℝ) (hx : x ≤ 0) : PruferManifold :=
  ⟨x, y, c, Or.inr hx⟩

/-- The first coordinate of an upper-half-plane point. -/
@[simp]
theorem upper_x (x y : ℝ) (hx : 0 < x) : (upper x y hx).x = x := by
  simp [upper]

/-- The second coordinate of an upper-half-plane point. -/
@[simp]
theorem upper_y (x y : ℝ) (hx : 0 < x) : (upper x y hx).y = y := by
  simp [upper]

/-- The sheet coordinate of an upper-half-plane point is zero. -/
@[simp]
theorem upper_z (x y : ℝ) (hx : 0 < x) : (upper x y hx).z = 0 := by
  simp [upper]

/-- The first coordinate of a point on a sheet. -/
@[simp]
theorem sheet_x (c x y : ℝ) (hx : x ≤ 0) : (sheet c x y hx).x = x := by
  simp [sheet]

/-- The second coordinate of a point on a sheet. -/
@[simp]
theorem sheet_y (c x y : ℝ) (hx : x ≤ 0) : (sheet c x y hx).y = y := by
  simp [sheet]

/-- The sheet coordinate of a point on the sheet indexed by `c`. -/
@[simp]
theorem sheet_z (c x y : ℝ) (hx : x ≤ 0) : (sheet c x y hx).z = c := by
  simp [sheet]

/-- The part of an ambient coordinate set lying in the positive-`x` upper half-plane. -/
def upperOpen (U : Set (ℝ × ℝ)) : Set PruferManifold :=
  {p | 0 < p.x ∧ (p.x, p.y) ∈ U}

/-- Membership in an upper-half-plane coordinate set. -/
theorem mem_upperOpen_iff {p : PruferManifold} {U : Set (ℝ × ℝ)} :
    p ∈ upperOpen U ↔ 0 < p.x ∧ (p.x, p.y) ∈ U := Iff.rfl

/-- The part of an ambient coordinate set lying in the negative-`x` interior of one sheet. -/
def sheetInteriorOpen (c : ℝ) (U : Set (ℝ × ℝ)) : Set PruferManifold :=
  {p | p.z = c ∧ p.x < 0 ∧ (p.x, p.y) ∈ U}

/-- Membership in an interior coordinate set on a sheet. -/
theorem mem_sheetInteriorOpen_iff {p : PruferManifold} {c : ℝ}
    {U : Set (ℝ × ℝ)} :
    p ∈ sheetInteriorOpen c U ↔ p.z = c ∧ p.x < 0 ∧ (p.x, p.y) ∈ U := Iff.rfl

/-- The upper-half-plane wedge `A_c((a,b), ε)` used in a gluing neighborhood. -/
def upperWedge (c a b ε : ℝ) : Set PruferManifold :=
  {p | 0 < p.x ∧ p.x < ε ∧ c + a * p.x < p.y ∧ p.y < c + b * p.x}

/-- Membership in an upper-half-plane wedge. -/
theorem mem_upperWedge_iff {p : PruferManifold} {c a b ε : ℝ} :
    p ∈ upperWedge c a b ε ↔
      0 < p.x ∧ p.x < ε ∧ c + a * p.x < p.y ∧ p.y < c + b * p.x := Iff.rfl

/-- The sheet strip `B_c((a,b), ε)` used in a gluing neighborhood. -/
def sheetStrip (c a b ε : ℝ) : Set PruferManifold :=
  {p | p.z = c ∧ -ε < p.x ∧ p.x ≤ 0 ∧ a < p.y ∧ p.y < b}

/-- Membership in a sheet strip. -/
theorem mem_sheetStrip_iff {p : PruferManifold} {c a b ε : ℝ} :
    p ∈ sheetStrip c a b ε ↔
      p.z = c ∧ -ε < p.x ∧ p.x ≤ 0 ∧ a < p.y ∧ p.y < b := Iff.rfl

/-- The union `A_c((a,b), ε) ∪ B_c((a,b), ε)` forming a gluing neighborhood. -/
def gluingNeighborhood (c a b ε : ℝ) : Set PruferManifold :=
  upperWedge c a b ε ∪ sheetStrip c a b ε

/-- Membership in a gluing neighborhood is membership in its wedge or sheet strip. -/
theorem mem_gluingNeighborhood_iff {p : PruferManifold} {c a b ε : ℝ} :
    p ∈ gluingNeighborhood c a b ε ↔
      p ∈ upperWedge c a b ε ∨ p ∈ sheetStrip c a b ε := Iff.rfl

/-- The three designated families of basis sets for the Prüfer manifold. -/
def basis : Set (Set PruferManifold) :=
  {s | (∃ U : Set (ℝ × ℝ), IsOpen U ∧ s = upperOpen U) ∨
    (∃ c : ℝ, ∃ U : Set (ℝ × ℝ), IsOpen U ∧ s = sheetInteriorOpen c U) ∨
      ∃ c a b ε : ℝ, a < b ∧ 0 < ε ∧ s = gluingNeighborhood c a b ε}

/-- A set belongs to the designated basis exactly when it is one of the three source families. -/
theorem mem_basis_iff {s : Set PruferManifold} :
    s ∈ basis ↔
      (∃ U : Set (ℝ × ℝ), IsOpen U ∧ s = upperOpen U) ∨
      (∃ c : ℝ, ∃ U : Set (ℝ × ℝ), IsOpen U ∧ s = sheetInteriorOpen c U) ∨
        ∃ c a b ε : ℝ, a < b ∧ 0 < ε ∧ s = gluingNeighborhood c a b ε := Iff.rfl

/-- The topology on the Prüfer manifold generated by its three designated basis families. -/
instance instTopologicalSpace : TopologicalSpace PruferManifold :=
  TopologicalSpace.generateFrom basis

/-- The installed topology is generated by the designated basis sets. -/
theorem topology_eq_generateFrom :
    (inferInstance : TopologicalSpace PruferManifold) =
      TopologicalSpace.generateFrom basis := rfl

/-- Helper for Definition 8.99.3: a basis set containing a positive-`x` point contains
an upper-half-plane coordinate neighborhood of that point. -/
lemma exists_upperOpen_subset_of_mem_basis {s : Set PruferManifold} {p : PruferManifold}
    (hs : s ∈ basis) (hp : p ∈ s) (hx : 0 < p.x) :
    ∃ U : Set (ℝ × ℝ), IsOpen U ∧ (p.x, p.y) ∈ U ∧
      upperOpen U ∈ basis ∧ upperOpen U ⊆ s := by
  -- Split according to the source family containing `s`.
  rcases mem_basis_iff.mp hs with ⟨U, hUOpen, rfl⟩ | ⟨c, U, hUOpen, rfl⟩ |
    ⟨c, a, b, ε, hab, hε, rfl⟩
  · exact ⟨U, hUOpen, (mem_upperOpen_iff.mp hp).2,
      mem_basis_iff.mpr (Or.inl ⟨U, hUOpen, rfl⟩), Subset.rfl⟩
  · exact False.elim (not_lt_of_ge (le_of_lt hx) (mem_sheetInteriorOpen_iff.mp hp).2.1)
  · let U : Set (ℝ × ℝ) :=
      {q | 0 < q.1 ∧ q.1 < ε ∧ c + a * q.1 < q.2 ∧ q.2 < c + b * q.1}
    have hUOpen : IsOpen U := by
      -- Each wedge inequality is open in the Euclidean coordinate plane.
      exact ((isOpen_lt continuous_const continuous_fst).inter
        ((isOpen_lt continuous_fst continuous_const).inter
          ((isOpen_lt
            (continuous_const.add (continuous_const.mul continuous_fst)) continuous_snd).inter
            (isOpen_lt continuous_snd
              (continuous_const.add (continuous_const.mul continuous_fst))))))
    have hpU : (p.x, p.y) ∈ U := by
      rcases mem_gluingNeighborhood_iff.mp hp with hpWedge | hpStrip
      · exact mem_upperWedge_iff.mp hpWedge
      · exact False.elim (not_lt_of_ge (mem_sheetStrip_iff.mp hpStrip).2.2.1 hx)
    refine ⟨U, hUOpen, hpU, mem_basis_iff.mpr (Or.inl ⟨U, hUOpen, rfl⟩), ?_⟩
    -- The coordinate neighborhood is precisely contained in the upper wedge.
    intro q hq
    exact mem_gluingNeighborhood_iff.mpr (Or.inl (mem_upperWedge_iff.mpr hq.2))

/-- Helper for Definition 8.99.3: a basis set containing a negative-`x` point contains
an interior coordinate neighborhood on the same sheet. -/
lemma exists_sheetInteriorOpen_subset_of_mem_basis {s : Set PruferManifold}
    {p : PruferManifold} (hs : s ∈ basis) (hp : p ∈ s) (hx : p.x < 0) :
    ∃ U : Set (ℝ × ℝ), IsOpen U ∧ (p.x, p.y) ∈ U ∧
      sheetInteriorOpen p.z U ∈ basis ∧ sheetInteriorOpen p.z U ⊆ s := by
  -- Split according to the source family containing `s`.
  rcases mem_basis_iff.mp hs with ⟨U, hUOpen, rfl⟩ | ⟨c, U, hUOpen, rfl⟩ |
    ⟨c, a, b, ε, hab, hε, rfl⟩
  · exact False.elim (not_lt_of_ge (le_of_lt (mem_upperOpen_iff.mp hp).1) hx)
  · have hpc : p.z = c := (mem_sheetInteriorOpen_iff.mp hp).1
    subst c
    exact ⟨U, hUOpen, (mem_sheetInteriorOpen_iff.mp hp).2.2,
      mem_basis_iff.mpr (Or.inr (Or.inl ⟨p.z, U, hUOpen, rfl⟩)), Subset.rfl⟩
  · let U : Set (ℝ × ℝ) :=
      {q | -ε < q.1 ∧ q.1 < 0 ∧ a < q.2 ∧ q.2 < b}
    have hUOpen : IsOpen U := by
      -- The negative-side trace of a gluing neighborhood is an open rectangle.
      exact ((isOpen_lt continuous_const continuous_fst).inter
        ((isOpen_lt continuous_fst continuous_const).inter
          ((isOpen_lt continuous_const continuous_snd).inter
            (isOpen_lt continuous_snd continuous_const))))
    rcases mem_gluingNeighborhood_iff.mp hp with hpWedge | hpStrip
    · exact False.elim (not_lt_of_ge (le_of_lt (mem_upperWedge_iff.mp hpWedge).1) hx)
    · have hpc : p.z = c := (mem_sheetStrip_iff.mp hpStrip).1
      subst c
      have hpU : (p.x, p.y) ∈ U := by
        exact ⟨(mem_sheetStrip_iff.mp hpStrip).2.1, hx,
          (mem_sheetStrip_iff.mp hpStrip).2.2.2.1,
          (mem_sheetStrip_iff.mp hpStrip).2.2.2.2⟩
      refine ⟨U, hUOpen, hpU,
        mem_basis_iff.mpr (Or.inr (Or.inl ⟨p.z, U, hUOpen, rfl⟩)), ?_⟩
      -- Every point of the rectangle lies in the original sheet strip.
      intro q hq
      have hqData := mem_sheetInteriorOpen_iff.mp hq
      exact mem_gluingNeighborhood_iff.mpr (Or.inr (mem_sheetStrip_iff.mpr
        ⟨hqData.1, hqData.2.2.1, le_of_lt hqData.2.1,
          hqData.2.2.2.2.1, hqData.2.2.2.2.2⟩))

/-- Helper for Definition 8.99.3: a basis set containing a point with first coordinate
zero is a gluing neighborhood on that point's sheet. -/
lemma exists_gluingParameters_of_mem_basis_of_x_eq_zero {s : Set PruferManifold}
    {p : PruferManifold} (hs : s ∈ basis) (hp : p ∈ s) (hx : p.x = 0) :
    ∃ a b ε : ℝ, a < b ∧ 0 < ε ∧ s = gluingNeighborhood p.z a b ε ∧
      a < p.y ∧ p.y < b := by
  -- Upper and sheet-interior basis sets cannot contain a boundary point.
  rcases mem_basis_iff.mp hs with ⟨U, hUOpen, rfl⟩ | ⟨c, U, hUOpen, rfl⟩ |
    ⟨c, a, b, ε, hab, hε, rfl⟩
  · exact False.elim (by linarith [(mem_upperOpen_iff.mp hp).1])
  · exact False.elim (by linarith [(mem_sheetInteriorOpen_iff.mp hp).2.1])
  · rcases mem_gluingNeighborhood_iff.mp hp with hpWedge | hpStrip
    · exact False.elim (by linarith [(mem_upperWedge_iff.mp hpWedge).1])
    · have hpc : p.z = c := (mem_sheetStrip_iff.mp hpStrip).1
      subst c
      exact ⟨a, b, ε, hab, hε, rfl, (mem_sheetStrip_iff.mp hpStrip).2.2.2.1,
        (mem_sheetStrip_iff.mp hpStrip).2.2.2.2⟩

/-- Helper for Definition 8.99.3: two basis sets meeting at a boundary point contain a
common gluing neighborhood there. -/
lemma exists_gluingNeighborhood_subset_inter_of_x_eq_zero {s t : Set PruferManifold}
    {p : PruferManifold} (hs : s ∈ basis) (ht : t ∈ basis) (hp : p ∈ s ∩ t)
    (hx : p.x = 0) :
    ∃ a b ε : ℝ, a < b ∧ 0 < ε ∧ p ∈ gluingNeighborhood p.z a b ε ∧
      gluingNeighborhood p.z a b ε ⊆ s ∩ t := by
  -- Normalize both basis sets to gluing neighborhoods on the common sheet.
  obtain ⟨a₁, b₁, ε₁, ha₁b₁, hε₁, rfl, ha₁p, hpb₁⟩ :=
    exists_gluingParameters_of_mem_basis_of_x_eq_zero hs hp.1 hx
  obtain ⟨a₂, b₂, ε₂, ha₂b₂, hε₂, rfl, ha₂p, hpb₂⟩ :=
    exists_gluingParameters_of_mem_basis_of_x_eq_zero ht hp.2 hx
  have hab : max a₁ a₂ < min b₁ b₂ :=
    max_lt (lt_min ha₁b₁ (ha₁p.trans hpb₂)) (lt_min (ha₂p.trans hpb₁) ha₂b₂)
  have hε : 0 < min ε₁ ε₂ := lt_min hε₁ hε₂
  have hpRefined : p ∈ gluingNeighborhood p.z (max a₁ a₂) (min b₁ b₂) (min ε₁ ε₂) := by
    -- At `x = 0`, the refined neighborhood contains the point through its sheet strip.
    rw [mem_gluingNeighborhood_iff, mem_sheetStrip_iff]
    exact Or.inr ⟨rfl, by linarith, by linarith, max_lt ha₁p ha₂p, lt_min hpb₁ hpb₂⟩
  refine ⟨max a₁ a₂, min b₁ b₂, min ε₁ ε₂, hab, hε, hpRefined, ?_⟩
  -- Compare the refined slopes, interval, and radius with both original neighborhoods.
  intro q hq
  rcases mem_gluingNeighborhood_iff.mp hq with hqWedge | hqStrip
  · have hqData := mem_upperWedge_iff.mp hqWedge
    have hxNonneg : 0 ≤ q.x := le_of_lt hqData.1
    have hLower₁ : a₁ * q.x ≤ max a₁ a₂ * q.x :=
      mul_le_mul_of_nonneg_right (le_max_left a₁ a₂) hxNonneg
    have hLower₂ : a₂ * q.x ≤ max a₁ a₂ * q.x :=
      mul_le_mul_of_nonneg_right (le_max_right a₁ a₂) hxNonneg
    have hUpper₁ : min b₁ b₂ * q.x ≤ b₁ * q.x :=
      mul_le_mul_of_nonneg_right (min_le_left b₁ b₂) hxNonneg
    have hUpper₂ : min b₁ b₂ * q.x ≤ b₂ * q.x :=
      mul_le_mul_of_nonneg_right (min_le_right b₁ b₂) hxNonneg
    constructor
    · rw [mem_gluingNeighborhood_iff, mem_upperWedge_iff]
      exact Or.inl ⟨hqData.1, lt_of_lt_of_le hqData.2.1 (min_le_left ε₁ ε₂),
        lt_of_le_of_lt (add_le_add_right hLower₁ p.z) hqData.2.2.1,
        lt_of_lt_of_le hqData.2.2.2 (add_le_add_right hUpper₁ p.z)⟩
    · rw [mem_gluingNeighborhood_iff, mem_upperWedge_iff]
      exact Or.inl ⟨hqData.1, lt_of_lt_of_le hqData.2.1 (min_le_right ε₁ ε₂),
        lt_of_le_of_lt (add_le_add_right hLower₂ p.z) hqData.2.2.1,
        lt_of_lt_of_le hqData.2.2.2 (add_le_add_right hUpper₂ p.z)⟩
  · have hqData := mem_sheetStrip_iff.mp hqStrip
    constructor
    · rw [mem_gluingNeighborhood_iff, mem_sheetStrip_iff]
      exact Or.inr ⟨hqData.1, by linarith [min_le_left ε₁ ε₂], hqData.2.2.1,
        lt_of_le_of_lt (le_max_left a₁ a₂) hqData.2.2.2.1,
        lt_of_lt_of_le hqData.2.2.2.2 (min_le_left b₁ b₂)⟩
    · rw [mem_gluingNeighborhood_iff, mem_sheetStrip_iff]
      exact Or.inr ⟨hqData.1, by linarith [min_le_right ε₁ ε₂], hqData.2.2.1,
        lt_of_le_of_lt (le_max_right a₁ a₂) hqData.2.2.2.1,
        lt_of_lt_of_le hqData.2.2.2.2 (min_le_right b₁ b₂)⟩

/-- Helper for Definition 8.99.3: the designated basis sets cover the Prüfer manifold. -/
lemma sUnion_basis_eq_univ : ⋃₀ basis = (Set.univ : Set PruferManifold) := by
  -- Choose a basis neighborhood according to the sign of the first coordinate.
  refine sUnion_eq_univ_iff.mpr fun p ↦ ?_
  rcases lt_trichotomy p.x 0 with hx | hx | hx
  · refine ⟨sheetInteriorOpen p.z Set.univ, ?_, ?_⟩
    · exact mem_basis_iff.mpr (Or.inr (Or.inl ⟨p.z, Set.univ, isOpen_univ, rfl⟩))
    · exact mem_sheetInteriorOpen_iff.mpr ⟨rfl, hx, Set.mem_univ _⟩
  · refine ⟨gluingNeighborhood p.z (p.y - 1) (p.y + 1) 1, ?_, ?_⟩
    · exact mem_basis_iff.mpr (Or.inr (Or.inr
        ⟨p.z, p.y - 1, p.y + 1, 1, by linarith, by norm_num, rfl⟩))
    · rw [mem_gluingNeighborhood_iff, mem_sheetStrip_iff]
      exact Or.inr ⟨rfl, by linarith, by linarith, by linarith, by linarith⟩
  · refine ⟨upperOpen Set.univ, ?_, ?_⟩
    · exact mem_basis_iff.mpr (Or.inl ⟨Set.univ, isOpen_univ, rfl⟩)
    · exact mem_upperOpen_iff.mpr ⟨hx, Set.mem_univ _⟩

end PruferManifold
