module

import Mathlib.Topology.Order

universe u v

/-
Exercise 13.9. For the topology generated by a basis, `∅` and the whole space
are open, and arbitrary indexed unions of open sets are open.
-/
#check fun {X : Type u} (𝓑 : Set (Set X)) ↦ by
  simpa only [Set.sUnion_empty] using
    (TopologicalSpace.generateFrom 𝓑).isOpen_sUnion ∅ (by simp)
#check fun {X : Type u} (𝓑 : Set (Set X)) ↦
  (TopologicalSpace.generateFrom 𝓑).isOpen_univ
#check fun {X : Type u} (𝓑 : Set (Set X)) {J : Type v} (U : J → Set X)
    (hU : ∀ j, (TopologicalSpace.generateFrom 𝓑).IsOpen (U j)) ↦ by
  simpa only [Set.sUnion_range] using
    (TopologicalSpace.generateFrom 𝓑).isOpen_sUnion (Set.range U) (by
      rintro _ ⟨j, rfl⟩
      exact hU j)
