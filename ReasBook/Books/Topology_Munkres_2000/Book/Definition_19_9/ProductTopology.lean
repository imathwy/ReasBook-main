module

public import Mathlib.Topology.Constructions
import Mathlib.Data.Set.Lattice
import Mathlib.Topology.Order

public section

universe u v

namespace Pi

variable {ι : Type u} (X : ι → Type v) [(i : ι) → TopologicalSpace (X i)]

/-- The subbasis family obtained from the projection to the `i`th coordinate. -/
def projectionSubbasis (i : ι) : Set (Set ((j : ι) → X j)) :=
  (fun U : Set (X i) ↦ Function.eval i ⁻¹' U) '' {U | IsOpen U}

/-- The union of the coordinate projection subbases for a dependent product. -/
def productSubbasis : Set (Set ((i : ι) → X i)) :=
  ⋃ i, projectionSubbasis X i

/-- Membership in the subbasis associated with one coordinate projection. -/
theorem mem_projectionSubbasis {i : ι} {s : Set ((j : ι) → X j)} :
    s ∈ projectionSubbasis X i ↔
      ∃ U : Set (X i), IsOpen U ∧ Function.eval i ⁻¹' U = s := by
  simp [projectionSubbasis]

/-- Membership in the product subbasis means being the inverse image of an open
set under one coordinate projection. -/
theorem mem_productSubbasis {s : Set ((i : ι) → X i)} :
    s ∈ productSubbasis X ↔
      ∃ (i : ι) (U : Set (X i)), IsOpen U ∧ Function.eval i ⁻¹' U = s := by
  simp [productSubbasis, mem_projectionSubbasis]

/-- The topology generated by the coordinate projection subbasis is the product topology. -/
theorem topologicalSpace_eq_generateFrom :
    (Pi.topologicalSpace : TopologicalSpace ((i : ι) → X i)) =
      TopologicalSpace.generateFrom (productSubbasis X) := by
  rw [Pi.topologicalSpace, ← generateFrom_iUnion_isOpen]
  congr 1

end Pi
