module

public import Topology_Munkres_2000.Book.Proposition_54_1.Extension

public section

universe u v

/-- Helper for Proposition 54.1: homomorphisms from a group generated by `x` are equal
when they agree on `x`. -/
lemma MonoidHom.ext_of_zpowers_eq_top
    {G : Type u} {H : Type v} [Group G] [Group H]
    {x : G} {f g : G →* H} (hx : Subgroup.zpowers x = ⊤) (hfg : f x = g x) :
    f = g := by
  -- Reduce extensionality to integer powers of the chosen generator.
  ext z
  have hz : z ∈ Subgroup.zpowers x :=
    (Subgroup.eq_top_iff' (Subgroup.zpowers x)).mp hx z
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hz
  -- Both homomorphisms carry the same generator image through the same power.
  rw [← hn, map_zpow, map_zpow, hfg]

/-- Helper for Proposition 54.1: the canonical extension is the only homomorphism
sending `x` to `y`. -/
lemma MonoidHom.ofInfiniteCyclicGenerator_unique
    {G : Type u} {H : Type v} [Group G] [Group H] [Infinite G]
    (x : G) (h_generator : Subgroup.zpowers x = ⊤) (y : H)
    (h : G →* H) (hh : h x = y) :
    h = MonoidHom.ofInfiniteCyclicGenerator x h_generator y := by
  -- Agreement on the generator follows from the prescribed image and its specification.
  apply MonoidHom.ext_of_zpowers_eq_top h_generator
  rw [hh, MonoidHom.ofInfiniteCyclicGenerator_apply_generator]

/-- Proposition 54.1: An arbitrary image of a generator of an infinite cyclic group
extends uniquely to a homomorphism. -/
theorem existsUniqueMonoidHomOfInfiniteGenerator
    {G : Type u} {H : Type v} [Group G] [Group H] [Infinite G]
    (x : G) (h_generator : Subgroup.zpowers x = ⊤) (y : H) :
    ∃! h : G →* H, h x = y := by
  -- Assemble existence and uniqueness solely from the canonical extension's interface.
  exact ExistsUnique.intro
    (MonoidHom.ofInfiniteCyclicGenerator x h_generator y)
    (MonoidHom.ofInfiniteCyclicGenerator_apply_generator x h_generator y)
    (MonoidHom.ofInfiniteCyclicGenerator_unique x h_generator y)
