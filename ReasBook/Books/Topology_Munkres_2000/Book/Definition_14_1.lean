module

import Mathlib.Topology.Order.Basic

universe u

/- Definition 14.1: A simply ordered set, represented in Lean by a `LinearOrder`,
carries the canonical topology generated by the open rays `Set.Ioi a` and `Set.Iio a`.
This order topology is `Preorder.topology` specialized to a linear order. -/
#check fun (X : Type u) [LinearOrder X] ↦ Preorder.topology X

/- An already active topology is the order topology precisely through this mixin. -/
#check OrderTopology

/- The mixin records equality with the canonical topology above. -/
#check OrderTopology.topology_eq_generate_intervals
