module

public import Mathlib.Topology.Bases
public import Mathlib.Topology.MetricSpace.UniformConvergence

universe u v

public section

/-- Continuous maps equipped with the fine topology. -/
@[expose]
def FineContinuousMap (X : Type u) (Y : Type v) [TopologicalSpace X]
    [PseudoMetricSpace Y] := C(X, Y)

namespace FineContinuousMap

variable (X : Type u) (Y : Type v) [TopologicalSpace X] [PseudoMetricSpace Y]

/-- The canonical equivalence between fine continuous maps and ordinary continuous maps. -/
def equivContinuousMap : FineContinuousMap X Y ≃ C(X, Y) :=
  Equiv.refl _

/-- A fine continuous map evaluates as its underlying continuous map. -/
instance instCoeFun : CoeFun (FineContinuousMap X Y) (fun _ ↦ X → Y) where
  coe f := equivContinuousMap X Y f

/-- Helper for Exercise 46.11: the canonical equivalence preserves pointwise evaluation. -/
@[simp]
theorem equivContinuousMap_apply (f : FineContinuousMap X Y) (x : X) :
    equivContinuousMap X Y f x = f x := by
  -- Both sides evaluate the same underlying continuous map.
  rfl

/-- Helper for Exercise 46.11: the canonical equivalence returns the underlying bundled map. -/
@[simp]
theorem equivContinuousMap_eq (f : FineContinuousMap X Y) :
    equivContinuousMap X Y f = f := by
  -- The exposed fine-map type is definitionally the bundled continuous-map type.
  rfl

/-- The variable-radius ball about a fine continuous map. -/
def ball (f : FineContinuousMap X Y) (δ : C(X, ℝ)) : Set (FineContinuousMap X Y) :=
  {g | ∀ x, dist (f x) (g x) < δ x}

/-- Membership in a variable-radius ball is the pointwise strict distance bound. -/
theorem mem_ball (f g : FineContinuousMap X Y) (δ : C(X, ℝ)) :
    g ∈ ball X Y f δ ↔ ∀ x, dist (f x) (g x) < δ x := by
  rfl

/-- The family of variable-radius balls with positive continuous radii. -/
def basis : Set (Set (FineContinuousMap X Y)) :=
  {U | ∃ f : FineContinuousMap X Y, ∃ δ : C(X, ℝ),
    (∀ x, 0 < δ x) ∧ U = ball X Y f δ}

/-- A set belongs to the fine basis exactly when it is a positive variable-radius ball. -/
theorem mem_basis_iff (U : Set (FineContinuousMap X Y)) :
    U ∈ basis X Y ↔ ∃ f : FineContinuousMap X Y, ∃ δ : C(X, ℝ),
      (∀ x, 0 < δ x) ∧ U = ball X Y f δ := by
  rfl

/-- The fine topology generated by positive continuous variable-radius balls. -/
@[reducible]
def topologicalSpace : TopologicalSpace (FineContinuousMap X Y) :=
  TopologicalSpace.generateFrom (basis X Y)

/-- The canonical fine topology on `FineContinuousMap X Y`. -/
instance instTopologicalSpace : TopologicalSpace (FineContinuousMap X Y) :=
  topologicalSpace X Y

/-- The installed fine topology is generated by the positive variable-radius balls. -/
theorem topology_eq_generateFrom :
    (inferInstance : TopologicalSpace (FineContinuousMap X Y)) =
      TopologicalSpace.generateFrom (basis X Y) := by
  rfl

/-- On a discrete domain, fine continuous maps are equivalent to all functions. -/
def equivFnOfDiscrete [DiscreteTopology X] : FineContinuousMap X Y ≃ (X → Y) :=
  (equivContinuousMap X Y).trans ContinuousMap.equivFnOfDiscrete

/-- On a discrete domain, the canonical equivalence preserves pointwise evaluation. -/
@[simp]
theorem equivFnOfDiscrete_apply [DiscreteTopology X] (f : FineContinuousMap X Y) (x : X) :
    equivFnOfDiscrete X Y f x = f x := by
  rfl

end FineContinuousMap
