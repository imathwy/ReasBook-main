module

public import Topology_Munkres_2000.Book.Definition_81_5.HomeomorphGroup
public import Topology_Munkres_2000.Book.Exercise_81_1.TorusActions
public import Mathlib.Data.ZMod.QuotientGroup
public import Mathlib.Topology.Homeomorph.Quotient
import all Topology_Munkres_2000.Book.Exercise_74_3.Quotient
import all Topology_Munkres_2000.Book.Exercise_81_1.TorusActions

public section

open scoped HomeomorphGroup

noncomputable section

/-- Helper for Exercise 81.1: a cyclic subgroup generated by an element of order two consists
exactly of the identity and its generator. -/
private lemma mem_zpowers_iff_eq_one_or_eq_of_orderOf_eq_two {G : Type*} [Group G]
    {a g : G} (ha : orderOf a = 2) :
    g ∈ Subgroup.zpowers a ↔ g = 1 ∨ g = a := by
  -- Finite-order powers have representatives with exponents below the order.
  classical
  have hfinite : IsOfFinOrder a := by
    rw [← orderOf_ne_zero_iff, ha]
    norm_num
  rw [hfinite.mem_zpowers_iff_mem_range_orderOf, ha]
  simp only [Finset.mem_image, Finset.mem_range, Nat.lt_succ_iff]
  constructor
  · rintro ⟨exponent, hexponent, rfl⟩
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hexponent with rfl | rfl
    · exact Or.inl (pow_zero _)
    · exact Or.inr (pow_one _)
  · rintro (rfl | rfl)
    · exact ⟨0, Nat.zero_le 1, pow_zero _⟩
    · exact ⟨1, le_rfl, pow_one _⟩

/-- Helper for Exercise 81.1: a quotient map whose fibers are precisely the orbits identifies
the orbit space with its codomain. -/
private lemma orbitSpaceHomeomorphicOfIsQuotientMap
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    (G : Subgroup (X ≃ₜ X)) (f : C(X, Y))
    (hf : Topology.IsQuotientMap f)
    (hkernel : ∀ x y : X, MulAction.orbitRel G X x y ↔ f x = f y) :
    Nonempty (X / G ≃ₜ Y) := by
  -- First change the orbit relation to the kernel relation, then use the quotient-map theorem.
  exact ⟨(Homeomorph.Quotient.congrRight hkernel).trans hf.homeomorph⟩

/-- Helper for Exercise 81.1: the torus translation involution has order two. -/
private lemma torusTranslationInvolution_orderOf :
    orderOf torusTranslationInvolution = 2 := by
  apply orderOf_eq_prime
  · -- Applying the translation twice negates the first coordinate twice.
    apply Homeomorph.ext
    intro point
    rw [pow_two, Homeomorph.mul_apply, torusTranslationInvolution_apply,
      torusTranslationInvolution_apply]
    simp
  · intro heq
    -- Evaluation at `(1, 1)` shows that the translation is not the identity.
    have hpoint := DFunLike.congr_fun heq ((1 : Circle), (1 : Circle))
    have hfirst := congrArg Prod.fst hpoint
    have hneg : -(1 : Circle) = 1 := by
      simpa [torusTranslationInvolution_apply] using hfirst
    exact Circle.neg_ne_self (1 : Circle) hneg

/-- Helper for Exercise 81.1: the translation generator belongs to its generated subgroup. -/
private lemma torusTranslationInvolution_mem_group :
    torusTranslationInvolution ∈ torusTranslationGroup := by
  -- This is the canonical generator-membership property of `Subgroup.zpowers`.
  simpa only [torusTranslationGroup] using
    Subgroup.mem_zpowers torusTranslationInvolution

/-- Helper for Exercise 81.1: the continuous torus map `(z, w) ↦ (z ^ 2, w)`. -/
private def torusSquaringMap : C(Torus, Torus) :=
  ContinuousMap.prodMap
    ⟨(fun z : Circle ↦ z ^ 2), (Circle.isQuotientCoveringMap_npow 2).continuous⟩
    (ContinuousMap.id Circle)

/-- Helper for Exercise 81.1: evaluation of the torus squaring map is coordinatewise. -/
@[simp] private lemma torusSquaringMap_apply (point : Torus) :
    torusSquaringMap point = (point.1 ^ 2, point.2) := by
  -- Unpack the product map only at this stable computation interface.
  rcases point with ⟨z, w⟩
  rfl

/-- Helper for Exercise 81.1: the torus squaring map is a quotient map. -/
private lemma torusSquaringMap_isQuotientMap :
    Topology.IsQuotientMap torusSquaringMap := by
  -- Circle squaring is an open quotient map, and this property is stable under products.
  exact ((Circle.isQuotientCoveringMap_npow 2).isOpenQuotientMap.prodMap
    IsOpenQuotientMap.id).isQuotientMap

/-- Helper for Exercise 81.1: equal squares on `Circle` mean equality or antipodality. -/
private lemma circle_sq_eq_sq_iff (x y : Circle) :
    x ^ 2 = y ^ 2 ↔ x = y ∨ x = -y := by
  constructor
  · intro hsquare
    -- Coerce to `ℂ`, where equality of squares factors in an integral domain.
    have hcomplex : (x : ℂ) ^ 2 = (y : ℂ) ^ 2 := by
      simpa only [Circle.coe_pow] using congrArg Subtype.val hsquare
    rw [sq_eq_sq_iff_eq_or_eq_neg] at hcomplex
    rcases hcomplex with hsame | hneg
    · exact Or.inl (Circle.ext hsame)
    · apply Or.inr
      apply Circle.ext
      simpa only [Circle.coe_neg] using hneg
  · rintro (rfl | hneg)
    · rfl
    · rw [hneg]
      simp

/-- The torus translation group has order two. -/
theorem torusTranslationGroup_card : Nat.card torusTranslationGroup = 2 := by
  -- The cardinality of a generated cyclic subgroup is the order of its generator.
  rw [torusTranslationGroup, Nat.card_zpowers, torusTranslationInvolution_orderOf]

/-- Helper for Exercise 81.1: the fibers of torus squaring are exactly the translation orbits. -/
private lemma torusTranslationOrbitRel_iff_squaring_eq (x y : Torus) :
    MulAction.orbitRel torusTranslationGroup Torus x y ↔
      torusSquaringMap x = torusSquaringMap y := by
  constructor
  · -- Reverse orbit membership so that the acting homeomorphism carries `x` to `y`.
    rw [MulAction.orbitRel_apply, MulAction.mem_orbit_symm,
      HomeomorphGroup.mem_orbit_iff]
    rintro ⟨g, hg⟩
    have hmember : (g : Torus ≃ₜ Torus) ∈
        Subgroup.zpowers torusTranslationInvolution := by
      simpa only [torusTranslationGroup] using g.property
    have hclass :=
      (mem_zpowers_iff_eq_one_or_eq_of_orderOf_eq_two
        torusTranslationInvolution_orderOf).mp hmember
    rcases hclass with hid | htranslation
    · have hxy : x = y := by
        simpa [hid] using hg
      exact congrArg torusSquaringMap hxy
    · rw [← hg, htranslation, torusTranslationInvolution_apply]
      simp only [torusSquaringMap_apply, neg_sq]
  · intro hsquare
    -- Equality under the product map separates into square equality and equality of coordinates.
    have hfirstRaw := congrArg Prod.fst hsquare
    have hfirst : x.1 ^ 2 = y.1 ^ 2 := by
      simpa only [torusSquaringMap_apply] using hfirstRaw
    have hsecondRaw := congrArg Prod.snd hsquare
    have hsecond : x.2 = y.2 := by
      simpa only [torusSquaringMap_apply] using hsecondRaw
    rw [circle_sq_eq_sq_iff] at hfirst
    rw [MulAction.orbitRel_apply, MulAction.mem_orbit_symm,
      HomeomorphGroup.mem_orbit_iff]
    rcases hfirst with hsame | hneg
    · have hxy : x = y := Prod.ext hsame hsecond
      refine ⟨1, ?_⟩
      simpa using hxy
    · have hantipodal : -x.1 = y.1 := by
        simpa only [neg_neg] using congrArg Neg.neg hneg
      refine ⟨⟨torusTranslationInvolution,
        torusTranslationInvolution_mem_group⟩, ?_⟩
      rw [torusTranslationInvolution_apply]
      exact Prod.ext hantipodal hsecond

/-- The orbit space of the torus translation group is homeomorphic to the torus. -/
theorem torusTranslationQuotient_homeomorphic :
    Nonempty (Torus / torusTranslationGroup ≃ₜ Torus) := by
  -- The orbit relation is the kernel of the quotient torus-squaring map.
  exact orbitSpaceHomeomorphicOfIsQuotientMap torusTranslationGroup torusSquaringMap
    torusSquaringMap_isQuotientMap torusTranslationOrbitRel_iff_squaring_eq

/-- Exercise 81.1 (a). The torus translation group has order two, and its orbit space is
homeomorphic to the torus. -/
theorem torusTranslationGroup_spec :
    Nat.card torusTranslationGroup = 2 ∧
      Nonempty (Torus / torusTranslationGroup ≃ₜ Torus) :=
  ⟨torusTranslationGroup_card, torusTranslationQuotient_homeomorphic⟩

/-- Helper for Exercise 81.1: the bundled Klein-bottle involution has order two. -/
private lemma kleinBottleInvolutionHomeomorph_orderOf :
    orderOf kleinBottleInvolutionHomeomorph = 2 := by
  apply orderOf_eq_prime
  · -- The underlying Klein-bottle involution squares to the identity.
    apply Homeomorph.ext
    intro point
    rw [pow_two, Homeomorph.mul_apply, kleinBottleInvolutionHomeomorph_apply,
      kleinBottleInvolutionHomeomorph_apply]
    exact KleinBottle.involution_involutive point
  · intro heq
    -- Its first coordinate negates `1`, so it cannot be the identity.
    have hpoint := DFunLike.congr_fun heq ((1 : Circle), (1 : Circle))
    have hfirst := congrArg Prod.fst hpoint
    have hneg : -(1 : Circle) = 1 := by
      simpa [kleinBottleInvolutionHomeomorph] using hfirst
    exact Circle.neg_ne_self (1 : Circle) hneg

/-- Helper for Exercise 81.1: the Klein-bottle generator belongs to its generated subgroup. -/
private lemma kleinBottleInvolutionHomeomorph_mem_group :
    kleinBottleInvolutionHomeomorph ∈ kleinBottleQuotientGroup := by
  -- This is again the generator-membership property of `Subgroup.zpowers`.
  simpa only [kleinBottleQuotientGroup] using
    Subgroup.mem_zpowers kleinBottleInvolutionHomeomorph

/-- The standard Klein-bottle quotient group has order two. -/
theorem kleinBottleQuotientGroup_card : Nat.card kleinBottleQuotientGroup = 2 := by
  -- The cardinality of this generated subgroup is the order of its involution.
  rw [kleinBottleQuotientGroup, Nat.card_zpowers,
    kleinBottleInvolutionHomeomorph_orderOf]

/-- Helper for Exercise 81.1: the fibers of `KleinBottle.quotientMap` are exactly the
Klein-bottle involution orbits. -/
private lemma kleinBottleOrbitRel_iff_quotientMap_eq (x y : Torus) :
    MulAction.orbitRel kleinBottleQuotientGroup Torus x y ↔
      KleinBottle.quotientMap x = KleinBottle.quotientMap y := by
  constructor
  · -- Classify a homeomorphism carrying `x` to `y` as identity or the involution.
    rw [MulAction.orbitRel_apply, MulAction.mem_orbit_symm,
      HomeomorphGroup.mem_orbit_iff]
    rintro ⟨g, hg⟩
    have hmember : (g : Torus ≃ₜ Torus) ∈
        Subgroup.zpowers kleinBottleInvolutionHomeomorph := by
      simpa only [kleinBottleQuotientGroup] using g.property
    have hclass :=
      (mem_zpowers_iff_eq_one_or_eq_of_orderOf_eq_two
        kleinBottleInvolutionHomeomorph_orderOf).mp hmember
    rcases hclass with hid | hinvolution
    · have hxy : x = y := by
        simpa [hid] using hg
      exact congrArg KleinBottle.quotientMap hxy
    · have hy : y = KleinBottle.involution x := by
        simpa [hinvolution] using hg.symm
      exact (KleinBottle.quotientMap_eq_iff x y).mpr (Or.inr hy)
  · intro hquotient
    -- The canonical quotient relation supplies either the identity or involution witness.
    rw [KleinBottle.quotientMap_eq_iff] at hquotient
    rw [MulAction.orbitRel_apply, MulAction.mem_orbit_symm,
      HomeomorphGroup.mem_orbit_iff]
    rcases hquotient with hy | hy
    · refine ⟨1, ?_⟩
      simpa using hy.symm
    · refine ⟨⟨kleinBottleInvolutionHomeomorph,
        kleinBottleInvolutionHomeomorph_mem_group⟩, ?_⟩
      rw [kleinBottleInvolutionHomeomorph_apply]
      exact hy.symm

/-- Helper for Exercise 81.1: the canonical torus-to-Klein-bottle map is a quotient map. -/
private lemma kleinBottleQuotientMap_isQuotientMap :
    Topology.IsQuotientMap KleinBottle.quotientMap := by
  -- Its underlying function is the canonical map to a quotient type.
  have hmap : (KleinBottle.quotientMap : Torus → KleinBottle) =
      @Quotient.mk' Torus KleinBottle.identified := by
    funext point
    rfl
  rw [hmap]
  exact isQuotientMap_quotient_mk'

/-- The orbit space of the standard Klein-bottle quotient group is homeomorphic to the Klein
bottle. -/
theorem kleinBottleQuotient_homeomorphic :
    Nonempty (Torus / kleinBottleQuotientGroup ≃ₜ KleinBottle) := by
  -- The orbit relation is the kernel of the canonical Klein-bottle quotient map.
  exact orbitSpaceHomeomorphicOfIsQuotientMap kleinBottleQuotientGroup
    KleinBottle.quotientMap kleinBottleQuotientMap_isQuotientMap
    kleinBottleOrbitRel_iff_quotientMap_eq

/-- Exercise 81.1 (b). The standard Klein-bottle quotient group has order two, and its orbit
space is homeomorphic to the Klein bottle. -/
theorem kleinBottleQuotientGroup_spec :
    Nat.card kleinBottleQuotientGroup = 2 ∧
      Nonempty (Torus / kleinBottleQuotientGroup ≃ₜ KleinBottle) :=
  ⟨kleinBottleQuotientGroup_card, kleinBottleQuotient_homeomorphic⟩
