module

public import Mathlib.Topology.Constructions

public section

open scoped Topology

universe u v w z

namespace TopologicalSpace

variable {A : Type u} {ι : Type v} {X : ι → Type w}
  [∀ i, TopologicalSpace (X i)]

/-- Helper for Exercise 19.10: The initial topology on `A` induced by a family of maps
`f i : A → X i` is the infimum of their induced topologies. -/
@[reducible]
def initialFamily (f : ∀ i, A → X i) : TopologicalSpace A :=
  ⨅ i, TopologicalSpace.induced (f i) inferInstance

/-- The initial topology of a family is equivalently induced by the assembled
map into the dependent product. -/
theorem initialFamily_eq_induced (f : ∀ i, A → X i) :
    initialFamily f = TopologicalSpace.induced (fun a i ↦ f i a) inferInstance :=
  (induced_to_pi _).symm

/-- Helper for Exercise 19.10: Every coordinate map is continuous from the topology
induced by the family. -/
theorem continuous_initialFamily (f : ∀ i, A → X i) (i : ι) :
    Continuous[initialFamily f, inferInstance] (f i) := by
  -- The infimum topology lies below each coordinate-induced topology.
  exact continuous_iff_le_induced.2 (iInf_le _ i)

/-- Helper for Exercise 19.10: A topology on `A` lies below the initial topology in
Mathlib's order exactly when every coordinate map is continuous from it. -/
theorem le_initialFamily_iff (f : ∀ i, A → X i) (t : TopologicalSpace A) :
    t ≤ initialFamily f ↔ ∀ i, Continuous[t, inferInstance] (f i) := by
  -- Comparing with the infimum is exactly the coordinatewise continuity condition.
  simp only [initialFamily, le_iInf_iff, continuous_iff_le_induced]

/-- Helper for Exercise 19.10: The coordinate inverse images of open sets form a
subbasis for the topology induced by the family. -/
theorem initialFamily_eq_generateFrom (f : ∀ i, A → X i) :
    initialFamily f = TopologicalSpace.generateFrom
      {s | ∃ (i : ι) (U : Set (X i)), IsOpen U ∧ s = f i ⁻¹' U} := by
  -- Replace each coordinate topology by the topology generated by open preimages.
  calc
    initialFamily f = ⨅ i, TopologicalSpace.induced (f i)
        (TopologicalSpace.generateFrom {U : Set (X i) | IsOpen U}) := by
      unfold initialFamily
      congr 1
      funext i
      rw [generateFrom_setOf_isOpen]
    _ = ⨅ i, TopologicalSpace.generateFrom
        (Set.preimage (f i) '' {U : Set (X i) | IsOpen U}) := by
      congr 1
      funext i
      exact induced_generateFrom_eq
    _ = TopologicalSpace.generateFrom
        (⋃ i, Set.preimage (f i) '' {U : Set (X i) | IsOpen U}) :=
      generateFrom_iUnion.symm
    _ = TopologicalSpace.generateFrom
        {s | ∃ (i : ι) (U : Set (X i)), IsOpen U ∧ s = f i ⁻¹' U} := by
      -- The indexed union is precisely the stated family of coordinate preimages.
      congr 1
      ext s
      simp only [Set.mem_iUnion, Set.mem_image, Set.mem_setOf_eq]
      constructor
      · rintro ⟨i, U, hU, rfl⟩
        exact ⟨i, U, hU, rfl⟩
      · rintro ⟨i, U, hU, rfl⟩
        exact ⟨i, U, hU, rfl⟩

/-- Helper for Exercise 19.10: A map into `A` with its initial topology is continuous
exactly when all its coordinate composites are continuous. -/
theorem continuous_to_initialFamily_iff {Y : Type z} [TopologicalSpace Y]
    (f : ∀ i, A → X i) (g : Y → A) :
    Continuous[inferInstance, initialFamily f] g ↔ ∀ i, Continuous (f i ∘ g) := by
  -- Composition preserves coordinate continuity.
  -- Conversely, continuous coordinates assemble into a continuous product map.
  letI : TopologicalSpace A := initialFamily f
  constructor
  · intro hg i
    exact (continuous_initialFamily f i).comp hg
  · intro h
    rw [initialFamily_eq_induced]
    exact continuous_induced_rng.2 (continuous_pi fun i ↦ h i)

/-- Helper for Exercise 19.10: the image under a range factorization is the
preimage in the range subtype of any ambient set cutting out the ordinary image. -/
lemma rangeFactorization_image_eq_preimage {α : Type*} {β : Type*} (p : α → β)
    (s : Set α) (V : Set β) (h : p '' s = V ∩ Set.range p) :
    Set.rangeFactorization p '' s = ((↑) : Set.range p → β) ⁻¹' V := by
  -- Compare membership after coercing a range element back to the ambient space.
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    have hp : p x ∈ p '' s := ⟨x, hx, rfl⟩
    rw [h] at hp
    exact hp.1
  · intro hy
    have hyrange : (y : β) ∈ Set.range p := y.property
    have hyimage : (y : β) ∈ p '' s := by
      rw [h]
      exact ⟨hy, hyrange⟩
    obtain ⟨x, hx, hpx⟩ := hyimage
    refine ⟨x, hx, ?_⟩
    exact Set.rangeFactorization_eq_iff x y |>.2 hpx

/-- Exercise 19.10: The diagonal map sends every open set of the initial
topology to an open set of its range in the product space. -/
theorem isOpen_rangeFactorization_image (f : ∀ i, A → X i) (U : Set A)
    (hU : IsOpen[(initialFamily f)] U) :
    IsOpen (Set.rangeFactorization (fun a i ↦ f i a) '' U) := by
  -- Equip the domain with the initial topology so the assembled product map is inducing.
  letI : TopologicalSpace A := initialFamily f
  have hinducing : Topology.IsInducing (fun a i ↦ f i a) :=
    ⟨initialFamily_eq_induced f⟩
  -- An inducing map sends an open set to an ambient open set intersected with its range.
  obtain ⟨V, hV, himage⟩ := hinducing.image_eq_isOpen_inter_range hU
  rw [rangeFactorization_image_eq_preimage _ _ _ himage]
  exact hV.preimage continuous_subtype_val

end TopologicalSpace
