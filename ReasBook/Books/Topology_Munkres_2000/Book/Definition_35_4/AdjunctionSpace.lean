module

public import Mathlib.Topology.Constructions

public section

universe u v w

namespace AdjunctionSpace

variable {X : Type u} {Y : Type v}
  [TopologicalSpace X] [TopologicalSpace Y]

/-- The elementary relation attaching each point of `A` to its image under `f`. -/
def identifies (A : Set X) (f : C(A, Y)) : (X ⊕ Y) → (X ⊕ Y) → Prop :=
  fun x y ↦ ∃ a : A, x = Sum.inl a.1 ∧ y = Sum.inr (f a)

/-- The setoid generated by attaching each `a : A` to `f a`. -/
def setoid (A : Set X) (f : C(A, Y)) : Setoid (X ⊕ Y) :=
  Relation.EqvGen.setoid (identifies A f)

end AdjunctionSpace

/-- The quotient of `X ⊕ Y` obtained by attaching each `a : A` to `f a`. -/
abbrev AdjunctionSpace {X : Type u} {Y : Type v}
    [TopologicalSpace X] [TopologicalSpace Y] (A : Set X) (f : C(A, Y)) :
    Type (max u v) :=
  Quotient (AdjunctionSpace.setoid A f)

namespace AdjunctionSpace

variable {X : Type u} {Y : Type v}
  [TopologicalSpace X] [TopologicalSpace Y]
  (A : Set X) (f : C(A, Y))

/-- The canonical quotient map from the disjoint union to the adjunction space. -/
def quotientMap : X ⊕ Y → AdjunctionSpace A f :=
  Quotient.mk (setoid A f)

/-- The canonical map from `X` to the adjunction space. -/
def includeX : X → AdjunctionSpace A f :=
  quotientMap A f ∘ Sum.inl

/-- The canonical map from `Y` to the adjunction space. -/
def includeY : Y → AdjunctionSpace A f :=
  quotientMap A f ∘ Sum.inr

/-- Helper for Proposition 76.2: the adjunction quotient computes to the left
canonical inclusion on the left summand. -/
theorem quotientMap_inl (x : X) : quotientMap A f (Sum.inl x) = includeX A f x := by
  rfl

/-- Helper for Proposition 76.2: the adjunction quotient computes to the right
canonical inclusion on the right summand. -/
theorem quotientMap_inr (y : Y) : quotientMap A f (Sum.inr y) = includeY A f y := by
  rfl

/-- Two points of the disjoint union have equal quotient images exactly when the generated
setoid relates them. -/
theorem quotientMap_eq_iff (x y : X ⊕ Y) :
    quotientMap A f x = quotientMap A f y ↔ setoid A f x y := by
  -- Reduce equality of canonical representatives to the defining setoid relation.
  simpa only [quotientMap] using (Quotient.eq :
    Quotient.mk (setoid A f) x = Quotient.mk (setoid A f) y ↔ setoid A f x y)

/-- The adjunction-space quotient identifies each attaching point with its image. -/
theorem glue (a : A) : includeX A f a = includeY A f (f a) := by
  -- Insert the elementary attachment into its generated equivalence relation.
  apply Quotient.sound
  apply Relation.EqvGen.rel
  exact ⟨a, rfl, rfl⟩

/-- Attaching points in the same fiber of `f` have the same image in the adjunction space. -/
theorem sameFiber {a b : A} (h : f a = f b) :
    includeX A f a = includeX A f b := by
  -- Pass through the common image in the canonical copy of `Y`.
  calc
    includeX A f a = includeY A f (f a) := glue A f a
    _ = includeY A f (f b) := congrArg (includeY A f) h
    _ = includeX A f b := (glue A f b).symm

/-- The canonical map gives the adjunction space its quotient topology. -/
theorem quotientMap_isQuotientMap :
    Topology.IsQuotientMap (quotientMap A f) := by
  -- The adjunction-space topology is the canonical quotient topology.
  exact isQuotientMap_quotient_mk'

/-- The canonical quotient map to the adjunction space is continuous. -/
theorem continuous_quotientMap : Continuous (quotientMap A f) := by
  -- Continuity is part of the canonical quotient-map structure.
  exact (quotientMap_isQuotientMap A f).continuous

/-- The canonical map from `X` to the adjunction space is continuous. -/
theorem continuous_includeX : Continuous (includeX A f) := by
  -- Compose the continuous left coproduct injection with the quotient map.
  exact (continuous_quotientMap A f).comp continuous_inl

/-- The canonical map from `Y` to the adjunction space is continuous. -/
theorem continuous_includeY : Continuous (includeY A f) := by
  -- Compose the continuous right coproduct injection with the quotient map.
  exact (continuous_quotientMap A f).comp continuous_inr

/-- A pair of maps agreeing along the attaching map respects the generated setoid. -/
theorem lift_respects {Z : Type w} (gX : X → Z) (gY : Y → Z)
    (h : ∀ a : A, gX a = gY (f a)) (x y : X ⊕ Y) (hxy : setoid A f x y) :
    Sum.elim gX gY x = Sum.elim gX gY y := by
  -- Equality contains the elementary attachments and is closed under equivalence generation.
  change Relation.EqvGen (identifies A f) x y at hxy
  induction hxy with
  | rel x y hxy =>
      rcases hxy with ⟨a, rfl, rfl⟩
      exact h a
  | refl x =>
      rfl
  | symm x y hxy ih =>
      exact ih.symm
  | trans x y z hxy hyz ihxy ihyz =>
      exact ihxy.trans ihyz

/-- A pair of maps agreeing along the attaching map descends to the adjunction space. -/
def lift {Z : Type w} (gX : X → Z) (gY : Y → Z)
    (h : ∀ a : A, gX a = gY (f a)) : AdjunctionSpace A f → Z :=
  Quotient.lift (Sum.elim gX gY) (lift_respects A f gX gY h)

/-- Helper for Theorem 58.1: a descended map computes on every representative of the
canonical quotient map. -/
@[simp]
theorem lift_quotientMap {Z : Type w} (gX : X → Z) (gY : Y → Z)
    (h : ∀ a : A, gX a = gY (f a)) (q : X ⊕ Y) :
    lift A f gX gY h (quotientMap A f q) = Sum.elim gX gY q := by
  -- Both the quotient constructor and its eliminator are transparent in this owner module.
  rfl

/-- Helper for Theorem 58.1: every point of an adjunction space belongs to one of the
two canonical families of quotient representatives. -/
theorem exists_eq_includeX_or_eq_includeY (q : AdjunctionSpace A f) :
    (∃ x : X, q = includeX A f x) ∨ (∃ y : Y, q = includeY A f y) := by
  -- Induct on a quotient representative and then split its coproduct summand.
  refine Quotient.inductionOn q ?_
  intro r
  rcases r with x | y
  · exact Or.inl ⟨x, rfl⟩
  · exact Or.inr ⟨y, rfl⟩

/-- The descended map agrees with `gX` on the canonical copy of `X`. -/
theorem lift_includeX {Z : Type w} (gX : X → Z) (gY : Y → Z)
    (h : ∀ a : A, gX a = gY (f a)) (x : X) :
    lift A f gX gY h (includeX A f x) = gX x := by
  -- Compute the quotient lift on a representative from the left summand.
  rfl

/-- The descended map agrees with `gY` on the canonical copy of `Y`. -/
theorem lift_includeY {Z : Type w} (gX : X → Z) (gY : Y → Z)
    (h : ∀ a : A, gX a = gY (f a)) (y : Y) :
    lift A f gX gY h (includeY A f y) = gY y := by
  -- Compute the quotient lift on a representative from the right summand.
  rfl

/-- A quotient lift of continuous maps that agree on the attaching set is continuous. -/
theorem continuous_lift {Z : Type w} [TopologicalSpace Z]
    (gX : C(X, Z)) (gY : C(Y, Z))
    (h : ∀ a : A, gX a = gY (f a)) :
    Continuous (lift A f gX gY h) := by
  -- Test continuity after the quotient map, where the lift is the coproduct eliminator.
  rw [(quotientMap_isQuotientMap A f).continuous_iff]
  have hComposition :
      lift A f gX gY h ∘ quotientMap A f = Sum.elim gX gY := by
    funext q
    exact lift_quotientMap A f gX gY h q
  rw [hComposition]
  exact gX.continuous.sumElim gY.continuous

/-- A self-homeomorphism of the first summand that fixes the attaching set induces a
self-homeomorphism of the adjunction space, acting identically on the second summand. -/
theorem existsSelfHomeomorphOfFixesAttaching (e : X ≃ₜ X)
    (hfix : ∀ a : A, e a = a) :
    ∃ E : AdjunctionSpace A f ≃ₜ AdjunctionSpace A f,
      (∀ x : X, E (includeX A f x) = includeX A f (e x)) ∧
        ∀ y : Y, E (includeY A f y) = includeY A f y := by
  let forwardX : C(X, AdjunctionSpace A f) :=
    ⟨fun x ↦ includeX A f (e x), (continuous_includeX A f).comp e.continuous⟩
  let backwardX : C(X, AdjunctionSpace A f) :=
    ⟨fun x ↦ includeX A f (e.symm x),
      (continuous_includeX A f).comp e.symm.continuous⟩
  let stationaryY : C(Y, AdjunctionSpace A f) :=
    ⟨includeY A f, continuous_includeY A f⟩
  have hforward : ∀ a : A, forwardX a = stationaryY (f a) := by
    intro a
    -- Pointwise fixation turns compatibility into the defining gluing equality.
    rw [show forwardX a = includeX A f (e a) from rfl, hfix a]
    exact glue A f a
  have hfixInverse : ∀ a : A, e.symm a = a := by
    intro a
    -- Inject the forward fixation through the inverse homeomorphism.
    apply e.injective
    rw [e.apply_symm_apply, hfix a]
  have hbackward : ∀ a : A, backwardX a = stationaryY (f a) := by
    intro a
    -- The inverse fixes the attaching set as well, so its lift also descends.
    rw [show backwardX a = includeX A f (e.symm a) from rfl, hfixInverse a]
    exact glue A f a
  let forward : C(AdjunctionSpace A f, AdjunctionSpace A f) :=
    ⟨lift A f forwardX stationaryY hforward,
      continuous_lift A f forwardX stationaryY hforward⟩
  let backward : C(AdjunctionSpace A f, AdjunctionSpace A f) :=
    ⟨lift A f backwardX stationaryY hbackward,
      continuous_lift A f backwardX stationaryY hbackward⟩
  have hleft : Function.LeftInverse backward forward := by
    intro q
    -- Check the inverse law only on the two canonical kinds of representatives.
    rcases exists_eq_includeX_or_eq_includeY A f q with ⟨x, rfl⟩ | ⟨y, rfl⟩
    · calc
        backward (forward (includeX A f x)) = backward (forwardX x) :=
          congrArg backward (lift_includeX A f forwardX stationaryY hforward x)
        _ = backwardX (e x) :=
          lift_includeX A f backwardX stationaryY hbackward (e x)
        _ = includeX A f x := congrArg (includeX A f) (e.symm_apply_apply x)
    · calc
        backward (forward (includeY A f y)) = backward (stationaryY y) :=
          congrArg backward (lift_includeY A f forwardX stationaryY hforward y)
        _ = stationaryY y := lift_includeY A f backwardX stationaryY hbackward y
        _ = includeY A f y := rfl
  have hright : Function.RightInverse backward forward := by
    intro q
    -- The opposite inverse law is identical after swapping `e` and `e.symm`.
    rcases exists_eq_includeX_or_eq_includeY A f q with ⟨x, rfl⟩ | ⟨y, rfl⟩
    · calc
        forward (backward (includeX A f x)) = forward (backwardX x) :=
          congrArg forward (lift_includeX A f backwardX stationaryY hbackward x)
        _ = forwardX (e.symm x) :=
          lift_includeX A f forwardX stationaryY hforward (e.symm x)
        _ = includeX A f x := congrArg (includeX A f) (e.apply_symm_apply x)
    · calc
        forward (backward (includeY A f y)) = forward (stationaryY y) :=
          congrArg forward (lift_includeY A f backwardX stationaryY hbackward y)
        _ = stationaryY y := lift_includeY A f forwardX stationaryY hforward y
        _ = includeY A f y := rfl
  let E : AdjunctionSpace A f ≃ₜ AdjunctionSpace A f :=
    Homeomorph.mk (Equiv.mk forward backward hleft hright)
      forward.continuous backward.continuous
  refine ⟨E, ?_, ?_⟩
  · intro x
    -- The forward lift records the prescribed action on the first summand.
    exact lift_includeX A f forwardX stationaryY hforward x
  · intro y
    -- The same lift is stationary on the second summand.
    exact lift_includeY A f forwardX stationaryY hforward y

end AdjunctionSpace
