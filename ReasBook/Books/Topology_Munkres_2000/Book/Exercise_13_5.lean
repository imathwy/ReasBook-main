module

public import Mathlib.Topology.Bases

public section

open Set

universe u

/-- Exercise 13.5 (2): the topology generated by a subbasis is the intersection of all
topologies containing that subbasis. The `sSup` reflects mathlib's reverse ordering on
topologies. -/
theorem TopologicalSpace.generateFrom_eq_sSup_containing
    {X : Type u} (𝒜 : Set (Set X)) :
    TopologicalSpace.generateFrom 𝒜 =
      sSup {t : TopologicalSpace X | 𝒜 ⊆ {U | t.IsOpen U}} := by
  rw [show {t : TopologicalSpace X | 𝒜 ⊆ {U | t.IsOpen U}} =
      Iic (TopologicalSpace.generateFrom 𝒜) by
    ext t
    exact TopologicalSpace.le_generateFrom_iff_subset_isOpen.symm]
  exact csSup_Iic.symm

/-- Exercise 13.5 (1): a topology generated by a basis is the intersection of all
topologies containing that basis. -/
theorem TopologicalSpace.IsTopologicalBasis.eq_sSup_containing
    {X : Type u} [TopologicalSpace X] {𝒜 : Set (Set X)}
    (h𝒜 : TopologicalSpace.IsTopologicalBasis 𝒜) :
    (inferInstance : TopologicalSpace X) =
      sSup {t : TopologicalSpace X | 𝒜 ⊆ {U | t.IsOpen U}} := by
  rw [h𝒜.eq_generateFrom]
  exact TopologicalSpace.generateFrom_eq_sSup_containing 𝒜
