public section

open Filter Set

namespace InfiniteEarring.Cone

/-- Helper for Exercise 82.2: the cone carrier is star-convex about its apex. -/
private lemma carrierStarConvexAtApex : StarConvex ℝ apex carrier := by
  -- Keep the imported carrier opaque and work through its membership interface.
  intro q hq a b ha hb hab
  obtain ⟨x, hx⟩ := (mem_carrier_iff q).mp hq
  apply (mem_carrier_iff _).mpr
  refine ⟨x, ?_⟩
  exact (convex_segment (base x) apex)
    (right_mem_segment ℝ (base x) apex) hx ha hb hab

/-- Exercise 82.2 (1): The cone on the infinite earring is simply connected. -/
instance instSimplyConnectedSpace : SimplyConnectedSpace Space := by
  -- Contract the star-convex carrier along its generating segments to the apex.
  exact @SimplyConnectedSpace.ofContractible Space _
    (carrierStarConvexAtApex.contractibleSpace ⟨0, zero_mem_carrier⟩)

/-- Helper for Exercise 82.2: the cone origin and apex are distinct ambient points. -/
private lemma origin_ne_apex : (origin : Ambient) ≠ apex := by
  -- Their third coordinates are respectively zero and one.
  intro h
  have hheight := congrArg (fun q : Ambient ↦ q 2) h
  simp [origin_coe, apex] at hheight

/-- Helper for Exercise 82.2: the cone with its apex removed. -/
private def puncturedCarrier : Set Space :=
  {q | (q : Ambient) ≠ apex}

/-- Helper for Exercise 82.2: deleting the apex leaves a neighborhood of the cone origin. -/
private lemma puncturedCarrierMemNhdsOrigin : puncturedCarrier ∈ nhds origin := by
  -- Pull back the open complement of the apex singleton along the subtype inclusion.
  have hapexComplement : ({apex} : Set Ambient)ᶜ ∈ nhds (origin : Ambient) :=
    isClosed_singleton.compl_mem_nhds origin_ne_apex
  have hset :
      puncturedCarrier = Subtype.val ⁻¹' ({apex} : Set Ambient)ᶜ := by
    ext q
    simp only [puncturedCarrier, mem_setOf_eq, mem_preimage, mem_compl_iff,
      mem_singleton_iff]
  rw [hset]
  exact continuousAt_subtype_val.preimage_mem_nhds hapexComplement

/-- Helper for Exercise 82.2: every base point lies in the cone carrier. -/
private lemma base_mem_carrier (x : InfiniteEarring.Space) : base x ∈ carrier := by
  -- Select the segment generated by `x` and take its left endpoint.
  exact (mem_carrier_iff (base x)).mpr
    ⟨x, left_mem_segment ℝ (base x) apex⟩

/-- Helper for Exercise 82.2: a height-zero base point is never the apex. -/
private lemma base_ne_apex (x : InfiniteEarring.Space) : base x ≠ apex := by
  -- Distinguish the endpoints by their third coordinates.
  intro h
  have hheight := congrArg (fun q : Ambient ↦ q 2) h
  simp [base, apex] at hheight

/-- Helper for Exercise 82.2: the height-zero embedding of the earring is continuous. -/
private lemma continuous_base :
    Continuous (fun x : InfiniteEarring.Space ↦ base (x : InfiniteEarring.Plane)) := by
  -- The two planar coordinates and the constant height coordinate are continuous.
  fun_prop (disch := aesop) [base]

/-- Helper for Exercise 82.2: the base inclusion with codomain the punctured cone. -/
private noncomputable def baseInclusionPuncturedValue
    (x : InfiniteEarring.Space) : puncturedCarrier :=
  ⟨⟨base x, base_mem_carrier x⟩, base_ne_apex x⟩

/-- Helper for Exercise 82.2: the base inclusion into the punctured cone is continuous. -/
private lemma continuous_baseInclusionPuncturedValue :
    Continuous baseInclusionPuncturedValue := by
  -- Package the continuous ambient base map through the two subtype layers.
  exact (continuous_base.subtype_mk base_mem_carrier).subtype_mk base_ne_apex

/-- Helper for Exercise 82.2: the bundled inclusion of the earring into the punctured cone. -/
private noncomputable def baseInclusionPunctured :
    C(InfiniteEarring.Space, puncturedCarrier) :=
  ⟨baseInclusionPuncturedValue, continuous_baseInclusionPuncturedValue⟩

/-- Helper for Exercise 82.2: the cone origin regarded as a point of the punctured cone. -/
private def puncturedOrigin : puncturedCarrier :=
  ⟨origin, origin_ne_apex⟩

/-- Helper for Exercise 82.2: base inclusion carries the earring origin to the cone origin. -/
private lemma baseInclusionPunctured_origin :
    baseInclusionPunctured InfiniteEarring.origin = puncturedOrigin := by
  -- Compare the nested subtypes at the ambient coordinate level.
  apply Subtype.ext
  apply Subtype.ext
  simp [baseInclusionPunctured, baseInclusionPuncturedValue, puncturedOrigin,
    base, InfiniteEarring.origin_coe, origin_coe]

/-- Helper for Exercise 82.2: away from the apex, one minus the height never vanishes. -/
private lemma one_sub_height_ne_zero (q : puncturedCarrier) :
    1 - (q : Ambient) 2 ≠ 0 := by
  -- A segment point of height one has zero base coefficient and hence is the apex.
  obtain ⟨x, hx⟩ := (mem_carrier_iff (q : Ambient)).mp q.1.property
  obtain ⟨a, b, ha, hb, hab, hq⟩ := hx
  have hheight := congrArg (fun z : Ambient ↦ z 2) hq
  have hheight' : b = (q : Ambient) 2 := by
    simpa [base, apex] using hheight
  intro hzero
  have hbOne : b = 1 := by linarith
  have haZero : a = 0 := by linarith
  apply q.property
  calc
    (q : Ambient) = a • base x + b • apex := hq.symm
    _ = apex := by rw [haZero, hbOne, zero_smul, one_smul, zero_add]

/-- Helper for Exercise 82.2: radial normalization of a punctured cone point in the base plane. -/
private noncomputable def radialPoint (q : puncturedCarrier) : InfiniteEarring.Plane :=
  WithLp.toLp 2
    ![(q : Ambient) 0 / (1 - (q : Ambient) 2),
      (q : Ambient) 1 / (1 - (q : Ambient) 2)]

/-- Helper for Exercise 82.2: radial normalization recovers the segment's base endpoint. -/
private lemma radialPoint_eq_of_mem_segment (q : puncturedCarrier)
    (x : InfiniteEarring.Space) (hx : (q : Ambient) ∈ segment ℝ (base x) apex) :
    radialPoint q = (x : InfiniteEarring.Plane) := by
  -- Read the common base coefficient from height and cancel it horizontally.
  obtain ⟨a, b, ha, hb, hab, hq⟩ := hx
  have hheight := congrArg (fun z : Ambient ↦ z 2) hq
  have hcoordZero := congrArg (fun z : Ambient ↦ z 0) hq
  have hcoordOne := congrArg (fun z : Ambient ↦ z 1) hq
  have hheight' : b = (q : Ambient) 2 := by
    simpa [base, apex] using hheight
  have hcoordZero' : a * (x : InfiniteEarring.Plane) 0 = (q : Ambient) 0 := by
    simpa [base, apex, smul_eq_mul] using hcoordZero
  have hcoordOne' : a * (x : InfiniteEarring.Plane) 1 = (q : Ambient) 1 := by
    simpa [base, apex, smul_eq_mul] using hcoordOne
  have hdenominator : 1 - (q : Ambient) 2 = a := by linarith
  have haNonzero : a ≠ 0 := by
    rw [← hdenominator]
    exact one_sub_height_ne_zero q
  ext i
  fin_cases i
  · simp [radialPoint, hdenominator, ← hcoordZero', haNonzero]
  · simp [radialPoint, hdenominator, ← hcoordOne', haNonzero]

/-- Helper for Exercise 82.2: radial normalization lands back in the infinite earring. -/
private lemma radialPoint_mem_carrier (q : puncturedCarrier) :
    radialPoint q ∈ InfiniteEarring.carrier := by
  -- Choose the generating segment and use the normalization computation.
  obtain ⟨x, hx⟩ := (mem_carrier_iff (q : Ambient)).mp q.1.property
  rw [radialPoint_eq_of_mem_segment q x hx]
  exact x.property

/-- Helper for Exercise 82.2: radial normalization is continuous on the punctured cone. -/
private lemma continuous_radialPoint : Continuous radialPoint := by
  -- Coordinatewise division is continuous because the height denominator is nonzero.
  have hzero : Continuous
      (fun q : puncturedCarrier ↦
        (q : Ambient) 0 / (1 - (q : Ambient) 2)) := by
    apply Continuous.div
    · fun_prop
    · fun_prop
    · exact one_sub_height_ne_zero
  have hone : Continuous
      (fun q : puncturedCarrier ↦
        (q : Ambient) 1 / (1 - (q : Ambient) 2)) := by
    apply Continuous.div
    · fun_prop
    · fun_prop
    · exact one_sub_height_ne_zero
  have hcoordinates : Continuous
      (fun q : puncturedCarrier ↦
        ![(q : Ambient) 0 / (1 - (q : Ambient) 2),
          (q : Ambient) 1 / (1 - (q : Ambient) 2)]) := by
    apply continuous_pi
    intro i
    fin_cases i
    · exact hzero
    · exact hone
  exact (PiLp.continuous_toLp 2 _).comp hcoordinates

/-- Helper for Exercise 82.2: the radial projection as an earring-valued function. -/
private noncomputable def puncturedConeProjectionValue
    (q : puncturedCarrier) : InfiniteEarring.Space :=
  ⟨radialPoint q, radialPoint_mem_carrier q⟩

/-- Helper for Exercise 82.2: the earring-valued radial projection is continuous. -/
private lemma continuous_puncturedConeProjectionValue :
    Continuous puncturedConeProjectionValue := by
  -- Restrict the continuous planar normalization to the earring subtype.
  exact continuous_radialPoint.subtype_mk radialPoint_mem_carrier

/-- Helper for Exercise 82.2: radial projection from the punctured cone to its base. -/
private noncomputable def puncturedConeProjection :
    C(puncturedCarrier, InfiniteEarring.Space) :=
  ⟨puncturedConeProjectionValue, continuous_puncturedConeProjectionValue⟩

/-- Helper for Exercise 82.2: radial projection is a left inverse to base inclusion. -/
private lemma puncturedConeProjectionLeftInverse :
    Function.LeftInverse puncturedConeProjection baseInclusionPunctured := by
  -- A base point is the left endpoint of its own generating segment.
  intro x
  apply Subtype.ext
  exact radialPoint_eq_of_mem_segment (baseInclusionPunctured x) x
    (left_mem_segment ℝ (base x) apex)

universe u v w

/-- Helper for Exercise 82.2: a map factoring through a space with trivial fundamental
group induces the trivial homomorphism. -/
private lemma fundamentalGroupMapEqOneOfFactorization
    {X : Type u} {Y : Type v} {Z : Type w}
    [TopologicalSpace X] [TopologicalSpace Y] [TopologicalSpace Z]
    (f : C(X, Y)) (g : C(Y, Z)) (i : C(X, Z)) (x : X)
    (hfactor : g.comp f = i) [Subsingleton (FundamentalGroup Y (f x))] :
    FundamentalGroup.map i x = 1 := by
  -- Substitute the continuous-map factorization before reducing the middle loop to one.
  subst i
  ext q
  have hmiddle : FundamentalGroup.map f x q = 1 := Subsingleton.elim _ _
  calc
    FundamentalGroup.map (g.comp f) x q =
        FundamentalGroup.map g (f x) (FundamentalGroup.map f x q) := by
      rw [FundamentalGroup.map_apply, FundamentalGroup.map_apply,
        FundamentalGroup.map_apply]
      exact Path.Homotopic.Quotient.map_comp
    _ = FundamentalGroup.map g (f x) 1 :=
      congrArg (fun z ↦ FundamentalGroup.map g (f x) z) hmiddle
    _ = 1 := (FundamentalGroup.map g (f x)).map_one
    _ = (1 : FundamentalGroup X x →* FundamentalGroup Z (g (f x))) q := rfl

/-- Companion for Exercise 82.2 (2): The cone on the infinite earring is not locally simply
connected at its ambient origin. -/
theorem notLocallySimplyConnectedAtOrigin :
    ¬ IsLocallySimplyConnectedAt origin := by
  -- A hypothetical simply connected neighborhood inside the punctured cone pulls back
  -- to an earring neighborhood whose inclusion factors through that neighborhood.
  intro hlocal
  rw [isLocallySimplyConnectedAt_iff] at hlocal
  obtain ⟨V, hVnhds, hVsimply, hVsub⟩ :=
    hlocal puncturedCarrier puncturedCarrierMemNhdsOrigin
  let baseInclusion : C(InfiniteEarring.Space, Space) :=
    (⟨Subtype.val, continuous_subtype_val⟩ : C(puncturedCarrier, Space)).comp
      baseInclusionPunctured
  have hbaseOrigin : baseInclusion InfiniteEarring.origin = origin := by
    exact congrArg Subtype.val baseInclusionPunctured_origin
  let W : Set InfiniteEarring.Space := baseInclusion ⁻¹' V
  have hWnhds : W ∈ nhds InfiniteEarring.origin := by
    apply baseInclusion.continuous.continuousAt.preimage_mem_nhds
    rwa [hbaseOrigin]
  let wOrigin : W :=
    ⟨InfiniteEarring.origin, mem_of_mem_nhds hWnhds⟩
  let throughV : C(W, V) := baseInclusion.restrictPreimage V
  have hcontinuousToPunctured : Continuous
      (fun y : V ↦ (⟨y.1, hVsub y.2⟩ : puncturedCarrier)) := by
    exact continuous_subtype_val.subtype_mk (fun y ↦ hVsub y.2)
  let toPunctured : C(V, puncturedCarrier) :=
    ⟨fun y ↦ ⟨y.1, hVsub y.2⟩, hcontinuousToPunctured⟩
  let fromV : C(V, InfiniteEarring.Space) :=
    puncturedConeProjection.comp toPunctured
  let directInclusion : C(W, InfiniteEarring.Space) :=
    ⟨Subtype.val, continuous_subtype_val⟩
  have hfactor : fromV.comp throughV = directInclusion := by
    apply ContinuousMap.ext
    intro y
    exact puncturedConeProjectionLeftInverse y.1
  letI : SimplyConnectedSpace V := hVsimply.simplyConnectedSpace
  have htrivial : FundamentalGroup.map directInclusion wOrigin = 1 :=
    fundamentalGroupMapEqOneOfFactorization throughV fromV directInclusion
      wOrigin hfactor
  -- Example 80.1 says that no earring neighborhood has trivial inclusion map.
  apply InfiniteEarring.inclusionMap_ne_one W hWnhds
  simpa only [FundamentalGroup.mapOfSubtype, directInclusion, wOrigin] using htrivial

end InfiniteEarring.Cone
