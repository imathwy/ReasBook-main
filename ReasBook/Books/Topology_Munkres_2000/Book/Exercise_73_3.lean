module

public import Mathlib.Algebra.Group.Subgroup.Basic

public section

universe u v w

namespace Subgroup

/-- The preimage under a surjective homomorphism of the normal closure of an image is normally
generated by the original set together with the kernel. -/
theorem comap_normalClosure_image {G : Type u} {H : Type v} [Group G] [Group H]
    (f : G →* H) (hf : Function.Surjective f) (s : Set G) :
    (normalClosure (f '' s)).comap f = normalClosure ((f.ker : Set G) ∪ s) := by
  rw [← map_normalClosure s f hf, comap_map_eq, normalClosure_union,
    normalClosure_eq_self, sup_comm]

end Subgroup

namespace MonoidHom

/-- Exercise 73.3. If the kernel of a homomorphism `g` is normally generated by
`f x₀`, where `f` is surjective, then the kernel of `g.comp f` is normally generated
by `f.ker` together with `x₀`. -/
theorem ker_comp_eq_normalClosure_union {G : Type u} {H : Type v} {K : Type w}
    [Group G] [Group H] [MulOneClass K] (f : G →* H) (g : H →* K)
    (hf : Function.Surjective f) (x₀ : G)
    (hg : g.ker = Subgroup.normalClosure ({f x₀} : Set H)) :
    (g.comp f).ker = Subgroup.normalClosure ((f.ker : Set G) ∪ {x₀}) := by
  rw [← comap_ker, hg, ← Set.image_singleton, Subgroup.comap_normalClosure_image f hf]

end MonoidHom
