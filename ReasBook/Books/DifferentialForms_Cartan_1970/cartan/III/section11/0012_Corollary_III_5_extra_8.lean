import Mathlib
import DifferentialForms_Cartan_1970.III.section11.PeriodLattice

-- Declarations for this item will be appended below by the statement pipeline.

-- Semantic recall note: boundedness comes from `IsZLattice.isCompact_range_of_periodic` for the
-- core owner `PeriodPair.lattice`. The primitive period data here is the chapter owner
-- `HasPeriodLattice`; the exact-period-group formulation is only a derived companion.

/-- Corollary III.5-extra-8: a holomorphic function on `ℂ` that is periodic with respect to every
element of the lattice generated by the period pair `L` is constant. -/
theorem differentiable_eq_const_of_has_period_lattice (L : PeriodPair) {f : ℂ → ℂ}
    (hf : Differentiable ℂ f)
    (hperiods : HasPeriodLattice L f) :
    ∃ c : ℂ, ∀ z : ℂ, f z = c := by
  refine hf.exists_const_forall_eq_of_bounded ?_
  exact
    (IsZLattice.isCompact_range_of_periodic L.lattice f hf.continuous
      fun z w hw ↦ hperiods w hw z).isBounded

/-- Derived exact-period reformulation of Corollary III.5-extra-8. -/
theorem differentiable_eq_const_of_periods_eq_lattice (L : PeriodPair) {f : ℂ → ℂ}
    (hf : Differentiable ℂ f)
    (hperiods : ∀ ω : ℂ, Function.Periodic f ω ↔ ω ∈ L.lattice.toAddSubgroup) :
    ∃ c : ℂ, ∀ z : ℂ, f z = c :=
  differentiable_eq_const_of_has_period_lattice L hf fun ω hω ↦ (hperiods ω).2 hω
