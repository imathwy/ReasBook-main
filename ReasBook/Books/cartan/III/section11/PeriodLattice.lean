import Mathlib

universe u

/-- For a period pair `L`, a function on `ℂ` has the lattice `Ω = L.lattice` as a group of
periods when every `ω ∈ Ω` is a period of `f`. -/
def HasPeriodLattice {α : Type u} (L : PeriodPair) (f : ℂ → α) : Prop :=
  ∀ ω ∈ L.lattice, Function.Periodic f ω

/-- A function has the lattice generated by a period pair `L` as a group of periods if and only
if `L.ω₁` and `L.ω₂` are both periods of the function. -/
theorem hasPeriodLattice_iff_periodic_generators {α : Type u} (L : PeriodPair) (f : ℂ → α) :
    HasPeriodLattice L f ↔ Function.Periodic f L.ω₁ ∧ Function.Periodic f L.ω₂ := by
  refine ⟨fun h ↦ ⟨h L.ω₁ L.ω₁_mem_lattice, h L.ω₂ L.ω₂_mem_lattice⟩, fun h ω hω ↦ ?_⟩
  rcases L.mem_lattice.mp hω with ⟨m, n, rfl⟩
  simpa using (h.1.int_mul m).add_period (h.2.int_mul n)
