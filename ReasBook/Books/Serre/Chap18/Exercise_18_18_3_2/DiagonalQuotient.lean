import Mathlib
import Serre.Chap18.Exercise_18_18_3_2.RegularClasses

noncomputable section

universe u x

namespace Representation

section DiagonalIntegerQuotient

variable {p : ℕ}
variable {G : Type u} [Group G] [Finite G]
variable [Fact p.Prime]

local instance :
    Fintype (PRegularConjClass G p) :=
  Fintype.ofFinite (PRegularConjClass G p)

/-- Helper for Exercise 18-18.3-2: the coordinatewise integer lattice generated by the centralizer
`p`-parts on the canonical owner `PRegularConjClass G p`. -/
noncomputable def regularIntegerDiagonalSubmodule :
    Submodule ℤ (PRegularConjClass G p → ℤ) :=
  Submodule.pi Set.univ fun c ↦
    Submodule.span ℤ ({(ConjClasses.centralizerPPart p c.1 : ℤ)} : Set ℤ)

/-- Helper for Exercise 18-18.3-2: the scaled integer point mass at a `p`-regular conjugacy
class, supported at that class with value equal to the corresponding centralizer `p`-part. -/
noncomputable def scaled_regular_integer_indicator
    (c : PRegularConjClass G p) : PRegularConjClass G p → ℤ := by
  classical
  exact Pi.single c (ConjClasses.centralizerPPart p c.1 : ℤ)

/-- Helper for Exercise 18-18.3-2: membership in the regular integer diagonal lattice is the same
as coordinatewise divisibility by the corresponding centralizer `p`-part. -/
theorem mem_regularIntegerDiagonalSubmodule_iff
    (f : PRegularConjClass G p → ℤ) :
    f ∈ regularIntegerDiagonalSubmodule (p := p) (G := G) ↔
      ∀ c : PRegularConjClass G p,
        ∃ a : ℤ, f c = (ConjClasses.centralizerPPart p c.1 : ℤ) * a := by
  constructor
  · intro hf c
    have hpi :
        ∀ c' ∈ Set.univ,
          f c' ∈
            Submodule.span ℤ ({(ConjClasses.centralizerPPart p c'.1 : ℤ)} : Set ℤ) := by
      simpa [regularIntegerDiagonalSubmodule] using hf
    rcases Submodule.mem_span_singleton.mp (hpi c (by simp)) with ⟨a, ha⟩
    refine ⟨a, ?_⟩
    calc
      f c = a • (ConjClasses.centralizerPPart p c.1 : ℤ) := ha.symm
      _ = (ConjClasses.centralizerPPart p c.1 : ℤ) * a := by
            simpa [zsmul_eq_mul, mul_comm]
  · intro hf
    have hpi :
        ∀ c' ∈ Set.univ,
          f c' ∈
            Submodule.span ℤ ({(ConjClasses.centralizerPPart p c'.1 : ℤ)} : Set ℤ) := by
      intro c' _
      rcases hf c' with ⟨a, ha⟩
      rw [Submodule.mem_span_singleton]
      refine ⟨a, ?_⟩
      simpa [zsmul_eq_mul, mul_comm] using ha.symm
    simpa [regularIntegerDiagonalSubmodule] using hpi

/-- Helper for Exercise 18-18.3-2: the regular integer diagonal lattice is spanned by the scaled
integer point masses on `PRegularConjClass G p`. -/
theorem regularIntegerDiagonalSubmodule_eq_span_scaled_regular_integer_indicator :
    regularIntegerDiagonalSubmodule (p := p) (G := G) =
      Submodule.span ℤ
        (Set.range (fun c : PRegularConjClass G p ↦ scaled_regular_integer_indicator c)) := by
  classical
  letI : Fintype (PRegularConjClass G p) := Fintype.ofFinite (PRegularConjClass G p)
  apply le_antisymm
  · intro f hf
    rcases (mem_regularIntegerDiagonalSubmodule_iff (p := p) (G := G) f).1 hf with hcoeff
    choose a ha using hcoeff
    have hsum :
        (∑ c : PRegularConjClass G p, a c • scaled_regular_integer_indicator (p := p) (G := G) c) =
          f := by
      ext c
      simp [scaled_regular_integer_indicator, ha c, Pi.single_apply, zsmul_eq_mul, mul_comm,
        mul_left_comm, mul_assoc]
    rw [← hsum]
    exact Submodule.sum_mem _ fun c _ ↦
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨c, rfl⟩)
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨c, rfl⟩
    refine (mem_regularIntegerDiagonalSubmodule_iff (p := p) (G := G) _).2 ?_
    intro c'
    by_cases h : c' = c
    · subst h
      refine ⟨1, ?_⟩
      simp [scaled_regular_integer_indicator]
    · refine ⟨0, ?_⟩
      simp [scaled_regular_integer_indicator, h]

/-- Helper for Exercise 18-18.3-2: the quotient by the coordinatewise centralizer-`p`-part lattice
splits into the product of the corresponding cyclic groups. -/
noncomputable def regularIntegerQuotient_addEquiv_pi_centralizerPPart :
    ((PRegularConjClass G p → ℤ) ⧸ regularIntegerDiagonalSubmodule (p := p) (G := G)) ≃+
      ∀ c : PRegularConjClass G p, ZMod (ConjClasses.centralizerPPart p c.1) := by
  classical
  letI : Fintype (PRegularConjClass G p) := Fintype.ofFinite (PRegularConjClass G p)
  letI : DecidableEq (PRegularConjClass G p) := Classical.decEq (PRegularConjClass G p)
  let e₁ :
      ((PRegularConjClass G p → ℤ) ⧸ regularIntegerDiagonalSubmodule (p := p) (G := G)) ≃ₗ[ℤ]
        ∀ c : PRegularConjClass G p,
          ℤ ⧸ Submodule.span ℤ ({(ConjClasses.centralizerPPart p c.1 : ℤ)} : Set ℤ) :=
    Submodule.quotientPi
      (fun c : PRegularConjClass G p ↦
        Submodule.span ℤ ({(ConjClasses.centralizerPPart p c.1 : ℤ)} : Set ℤ))
  let e₂ :
      (∀ c : PRegularConjClass G p,
          ℤ ⧸ Submodule.span ℤ ({(ConjClasses.centralizerPPart p c.1 : ℤ)} : Set ℤ)) ≃+
        ∀ c : PRegularConjClass G p, ZMod (ConjClasses.centralizerPPart p c.1) :=
    AddEquiv.piCongrRight fun c ↦ by
      simpa using
        (Int.quotientSpanEquivZMod (ConjClasses.centralizerPPart p c.1 : ℤ)).toAddEquiv
  exact e₁.toAddEquiv.trans e₂

/-- Helper for Exercise 18-18.3-2: the diagonal quotient on regular classes has cardinality equal
to the product of the centralizer `p`-parts. -/
theorem card_regularIntegerQuotient_eq_prod_centralizerPPart :
    Nat.card
        ((PRegularConjClass G p → ℤ) ⧸
          regularIntegerDiagonalSubmodule (p := p) (G := G)) =
      ∏ c : PRegularConjClass G p, ConjClasses.centralizerPPart p c.1 := by
  classical
  let e :=
    regularIntegerQuotient_addEquiv_pi_centralizerPPart (p := p) (G := G)
  calc
    Nat.card
        ((PRegularConjClass G p → ℤ) ⧸
          regularIntegerDiagonalSubmodule (p := p) (G := G)) =
      Nat.card (∀ c : PRegularConjClass G p, ZMod (ConjClasses.centralizerPPart p c.1)) := by
        exact Nat.card_congr e.toEquiv
    _ = ∏ c : PRegularConjClass G p, Nat.card (ZMod (ConjClasses.centralizerPPart p c.1)) := by
        simpa using (Nat.card_pi : Nat.card
          (∀ c : PRegularConjClass G p, ZMod (ConjClasses.centralizerPPart p c.1)) =
            ∏ c : PRegularConjClass G p, Nat.card (ZMod (ConjClasses.centralizerPPart p c.1)))
    _ = ∏ c : PRegularConjClass G p, ConjClasses.centralizerPPart p c.1 := by
        simp [Nat.card_zmod]

end DiagonalIntegerQuotient

end Representation
