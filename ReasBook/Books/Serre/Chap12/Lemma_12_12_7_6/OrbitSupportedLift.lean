import Serre.Chap12.Lemma_12_12_7_5.AssociatedElementaryCore

noncomputable section

open Representation
open PrimeSpectrum
open scoped Representation SubgroupInduction

universe u v w

namespace Representation

open IsCyclotomicExtension.Rat

section

variable {G : Type u} [Group G] [Finite G]
variable {A : Type v} [CommRing A] [IsDomain A]
variable {L : Type w} [Field L] [NumberField L]
variable [IsCyclotomicExtension {Monoid.exponent G} ℚ L]
variable (K : IntermediateField ℚ L)
variable [Algebra A K] [IsFractionRing A K]
variable {p : ℕ} [Fact p.Prime]

local instance instFintypeAmbientGroupOrbitSupportedLift : Fintype G := Fintype.ofFinite G
local instance instFintypeSubgroupOrbitSupportedLift
    {H : Type*} [Group H] [Finite H] (S : Subgroup H) : Fintype S := Fintype.ofFinite S
attribute [local instance] Classical.propDecidable
local notation "ΓK" => Γ[K](G)

/-- Helper for Lemma 12-12.7-6: the exponent of the cyclic subgroup `C = ⟨x⟩` divides the
ambient exponent. This is the concrete reduction map needed to compare intrinsic powers on `C`
with ambient `Γ_K`-powers on `G`. -/
lemma exponent_zpowers_dvd_ambient_local
    (x : G) :
    Monoid.exponent (Subgroup.zpowers x) ∣ Monoid.exponent G := by
  simpa [Subgroup.exponent_toSubmonoid] using
    Monoid.exponent_submonoid_dvd (Subgroup.zpowers x).toSubmonoid

/-- Helper for Lemma 12-12.7-6: Serre's arithmetic subgroup on `C = ⟨x⟩` should be obtained by
reducing ambient exponents modulo `exp(C)`. This is the correct theorem-local substitute for the
ill-typed literal notation `Γ[K](Subgroup.zpowers x)` in the current workspace. -/
def reducedAmbientGammaSubgroupOnZpowers
    (x : G) :
    Subgroup (ZMod (Monoid.exponent (Subgroup.zpowers x)))ˣ :=
  Subgroup.map (ZMod.unitsMap (exponent_zpowers_dvd_ambient_local (G := G) x)) ΓK

/-- Helper for Lemma 12-12.7-6: an element of the reduced ambient arithmetic subgroup on
`C = ⟨x⟩` is exactly the restriction of an ambient cyclotomic Galois exponent coming from an
automorphism fixing `K`. This makes the source-faithful arithmetic content of
`reducedAmbientGammaSubgroupOnZpowers` explicit without pretending that `L` is itself generated by
`exp(C)`-th roots of unity. -/
lemma mem_reducedAmbientGammaSubgroupOnZpowers_iff
    (x : G) (u : (ZMod (Monoid.exponent (Subgroup.zpowers x)))ˣ) :
    u ∈ reducedAmbientGammaSubgroupOnZpowers K x ↔
      ∃ σ : Gal(L / ℚ), σ ∈ K.fixingSubgroup ∧
        ZMod.unitsMap (exponent_zpowers_dvd_ambient_local (G := G) x)
          (galEquivZMod (Monoid.exponent G) L σ) = u := by
  constructor
  · intro hu
    rcases Subgroup.mem_map.mp hu with ⟨t, ht, rfl⟩
    rcases Subgroup.mem_map.mp ht with ⟨σ, hσ, rfl⟩
    exact ⟨σ, hσ, rfl⟩
  · rintro ⟨σ, hσ, rfl⟩
    refine Subgroup.mem_map.mpr ?_
    refine ⟨galEquivZMod (Monoid.exponent G) L σ, ?_, rfl⟩
    exact Subgroup.mem_map.mpr ⟨σ, hσ, rfl⟩

/-- Helper for Lemma 12-12.7-6: the source `A`-valued function on `C = ⟨x⟩`, supported on the
ambient `Γ_K`-orbit of the generator `x`. -/
def orbit_supported_zpowers_function (x : G) :
    Subgroup.zpowers x → A :=
  fun c ↦ by
    classical
    exact
      if ∃ t : ΓK, (c : G) = x ^ t then
        (Nat.card (Subgroup.zpowers x) : A)
      else
        0

/-- Helper for Lemma 12-12.7-6: every value of the cyclic source function on `C = ⟨x⟩` already
comes from `A` after applying the scalar-extension map `A → K`. -/
lemma orbit_supported_zpowers_function_apply_mem_range
    (x : G) (c : Subgroup.zpowers x) :
    ((algebraMap A K) ∘ orbit_supported_zpowers_function (K := K) (A := A) x) c ∈
      Set.range (algebraMap A K) := by
  refine ⟨orbit_supported_zpowers_function (K := K) (A := A) x c, rfl⟩

/-- Helper for Lemma 12-12.7-6: the orbit-supported source function on `C = ⟨x⟩` only takes the
two source values `0` and `|C|`, so every value lies in the principal ideal generated by `|C|`. -/
lemma orbit_supported_zpowers_function_mem_span_card
    (x : G) (c : Subgroup.zpowers x) :
    orbit_supported_zpowers_function K x c ∈
      Ideal.span ({(Nat.card (Subgroup.zpowers x) : A)} : Set A) := by
  classical
  by_cases hc : ∃ t : ΓK, (c : G) = x ^ t
  · rw [orbit_supported_zpowers_function, if_pos hc]
    exact Ideal.subset_span (by simp)
  · rw [orbit_supported_zpowers_function, if_neg hc]
    exact zero_mem (Ideal.span ({(Nat.card (Subgroup.zpowers x) : A)} : Set A))

/-- Helper for Lemma 12-12.7-6: composing two ambient `Γ_K`-power operations multiplies the
underlying exponent units. This is the local arithmetic identity used when the cyclic source
support is transported along power maps. -/
lemma gamma_pow_mul_local
    (x : G) (t u : ΓK) :
    (x ^ t) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) = x ^ (t * u) := by
  rw [pow_subgroup_eq_pow_nat, ← pow_mul, pow_subgroup_eq_pow_nat]
  rw [Monoid.pow_eq_mod_exponent]
  congr
  exact
    (ZMod.val_mul
      (((t : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)))
      (((u : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)))).symm

/-- Helper for Lemma 12-12.7-6: composing two intrinsic `Γ`-power operations in any finite group
multiplies the corresponding exponent units. -/
lemma gamma_pow_mul_aux
    {H : Type*} [Group H] [Finite H]
    {ΓH : Subgroup (ZMod (Monoid.exponent H))ˣ}
    (y : H) (t u : ΓH) :
    (y ^ t) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent H))ˣ) = y ^ (t * u) := by
  rw [pow_subgroup_eq_pow_nat, ← pow_mul, pow_subgroup_eq_pow_nat]
  rw [Monoid.pow_eq_mod_exponent]
  congr
  exact
    (ZMod.val_mul
      (((t : (ZMod (Monoid.exponent H))ˣ) : ZMod (Monoid.exponent H)))
      (((u : (ZMod (Monoid.exponent H))ˣ) : ZMod (Monoid.exponent H)))).symm

/-- Helper for Lemma 12-12.7-6: an intrinsic `Γ`-power followed by its inverse returns the
original element. -/
lemma gamma_pow_inv_aux
    {H : Type*} [Group H] [Finite H]
    {ΓH : Subgroup (ZMod (Monoid.exponent H))ˣ}
    (y : H) (t : ΓH) :
    (y ^ t) ^ galoisPowerExponentUnit ((t⁻¹ : ΓH) : (ZMod (Monoid.exponent H))ˣ) = y := by
  calc
    (y ^ t) ^ galoisPowerExponentUnit ((t⁻¹ : ΓH) : (ZMod (Monoid.exponent H))ˣ) =
        y ^ (t * t⁻¹) := gamma_pow_mul_aux y t t⁻¹
    _ = y ^ (1 : ΓH) := by simp
    _ = y := by
      rw [pow_subgroup_eq_pow_nat]
      change y ^ ((1 : ZMod (Monoid.exponent H)).val) = y
      have hpow : y ^ (1 % Monoid.exponent H) = y ^ 1 := by
        simpa using (Eq.symm (@Monoid.pow_eq_mod_exponent H _ 1 y))
      simpa [ZMod.val_one_eq_one_mod] using hpow

/-- Helper for Lemma 12-12.7-6: an ambient `Γ_K`-power followed by its inverse returns the
original element. -/
lemma gamma_pow_inv_local
    (x : G) (t : ΓK) :
    (x ^ t) ^ galoisPowerExponentUnit ((t⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ) = x := by
  simpa using gamma_pow_inv_aux (H := G) (ΓH := ΓK) x t

/-- Helper for Lemma 12-12.7-6: on the cyclic factor `C = ⟨x⟩`, the ambient `Γ_K`-orbit support
predicate defining Serre's source function is invariant under ambient `Γ_K`-power maps. -/
lemma ambient_orbit_predicate_zpowers_pow_iff
    (x : G) (c : Subgroup.zpowers x) (u : ΓK) :
    (∃ t : ΓK, (c : G) ^ u = x ^ t) ↔
      ∃ t : ΓK, (c : G) = x ^ t := by
  constructor
  · rintro ⟨t, ht⟩
    refine ⟨t * u⁻¹, ?_⟩
    calc
      (c : G) =
          ((c : G) ^ u) ^
            galoisPowerExponentUnit ((u⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
            simpa using (gamma_pow_inv_local (K := K) ((c : G)) u).symm
      _ = (x ^ t) ^
            galoisPowerExponentUnit ((u⁻¹ : ΓK) : (ZMod (Monoid.exponent G))ˣ) := by
            rw [ht]
      _ = x ^ (t * u⁻¹) := by
            simpa using gamma_pow_mul_local (K := K) x t u⁻¹
  · rintro ⟨t, ht⟩
    refine ⟨t * u, ?_⟩
    calc
      (c : G) ^ u = (x ^ t) ^ u := by rw [ht]
      _ = x ^ (t * u) := by
            change (x ^ t) ^ galoisPowerExponentUnit (u : (ZMod (Monoid.exponent G))ˣ) =
              x ^ (t * u)
            exact gamma_pow_mul_local (K := K) x t u

/-- Helper for Lemma 12-12.7-6: Serre's orbit-supported source function on `C = ⟨x⟩` is
unchanged after applying an ambient `Γ_K`-power map to its argument. -/
lemma orbit_supported_zpowers_function_pow_eq
    (x : G) (c : Subgroup.zpowers x) (u : ΓK) :
    orbit_supported_zpowers_function (K := K) (A := A) x
        ⟨(c : G) ^ u, by
          rw [pow_subgroup_eq_pow_nat]
          exact Subgroup.pow_mem (Subgroup.zpowers x) c.2 _⟩ =
      orbit_supported_zpowers_function (K := K) (A := A) x c := by
  classical
  let cu : Subgroup.zpowers x := ⟨(c : G) ^ u, by
    rw [pow_subgroup_eq_pow_nat]
    exact Subgroup.pow_mem (Subgroup.zpowers x) c.2 _⟩
  change orbit_supported_zpowers_function (K := K) (A := A) x cu =
    orbit_supported_zpowers_function (K := K) (A := A) x c
  by_cases hc : ∃ t : ΓK, (c : G) = x ^ t
  · have hcu : ∃ t : ΓK, (cu : G) = x ^ t := by
      simpa [cu] using (ambient_orbit_predicate_zpowers_pow_iff (K := K) x c u).2 hc
    rw [orbit_supported_zpowers_function, orbit_supported_zpowers_function, if_pos hcu, if_pos hc]
  · have hcu : ¬ ∃ t : ΓK, (cu : G) = x ^ t := by
      intro hcu
      exact hc <|
        (ambient_orbit_predicate_zpowers_pow_iff (K := K) x c u).1 <| by
          simpa [cu] using hcu
    rw [orbit_supported_zpowers_function, orbit_supported_zpowers_function, if_neg hcu, if_neg hc]

/-- Helper for Lemma 12-12.7-6: an intrinsic power on `C = ⟨x⟩` by an element of the reduced
ambient arithmetic subgroup is realized by an ambient `Γ_K`-power on the same element. This is
the arithmetic bridge behind the source-faithful support comparison on the cyclic factor. -/
lemma zpowers_pow_eq_ambient_gamma_pow_of_mem_reducedAmbient_local
    (x : G) (c : Subgroup.zpowers x)
    (u : reducedAmbientGammaSubgroupOnZpowers K x) :
    ∃ t : ΓK, ((c ^ u : Subgroup.zpowers x) : G) = (c : G) ^ t := by
  let hdiv : Monoid.exponent (Subgroup.zpowers x) ∣ Monoid.exponent G :=
    exponent_zpowers_dvd_ambient_local (G := G) x
  rcases Subgroup.mem_map.mp u.2 with ⟨t, ht, hu⟩
  let tΓ : ΓK := ⟨t, ht⟩
  refine ⟨tΓ, ?_⟩
  -- Compare the intrinsic power on `C` with the ambient `Γ_K`-power using the common exponent
  -- representative modulo `exp(C)`.
  have hmod :
      galoisPowerExponentUnit
          ((u : (ZMod (Monoid.exponent (Subgroup.zpowers x)))ˣ)) ≡
        galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)
          [MOD Monoid.exponent (Subgroup.zpowers x)] := by
    rw [← ZMod.natCast_eq_natCast_iff]
    calc
      ((galoisPowerExponentUnit
            ((u : (ZMod (Monoid.exponent (Subgroup.zpowers x)))ˣ)) : ℕ) :
          ZMod (Monoid.exponent (Subgroup.zpowers x))) =
        (((u : reducedAmbientGammaSubgroupOnZpowers K x) :
            (ZMod (Monoid.exponent (Subgroup.zpowers x)))ˣ) :
          ZMod (Monoid.exponent (Subgroup.zpowers x))) := by
            simp [galoisPowerExponentUnit]
      _ =
        (((ZMod.unitsMap hdiv (t : (ZMod (Monoid.exponent G))ˣ)) :
            (ZMod (Monoid.exponent (Subgroup.zpowers x)))ˣ) :
          ZMod (Monoid.exponent (Subgroup.zpowers x))) := by
            rw [hu]
      _ =
        ((((t : (ZMod (Monoid.exponent G))ˣ) : ZMod (Monoid.exponent G)).cast) :
          ZMod (Monoid.exponent (Subgroup.zpowers x))) := by
            symm
            exact ZMod.unitsMap_val hdiv (t : (ZMod (Monoid.exponent G))ˣ)
      _ =
        ((galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ) : ℕ) :
          ZMod (Monoid.exponent (Subgroup.zpowers x))) := by
            simp [galoisPowerExponentUnit]
  simpa [pow_subgroup_eq_pow_nat] using
    (pow_eq_pow_of_modEq hmod (Subgroup.pow_exponent_eq_one (H := Subgroup.zpowers x) c.2) :
      (c : G) ^
          galoisPowerExponentUnit
            ((u : (ZMod (Monoid.exponent (Subgroup.zpowers x)))ˣ)) =
        (c : G) ^ galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ))

/-- Helper for Lemma 12-12.7-6: any reduced ambient arithmetic power on `C = ⟨x⟩` acts on
Serre's cyclic source exactly like some ambient `Γ_K`-power, so the source function is unchanged
after such a power map. -/
lemma orbit_supported_zpowers_function_pow_eq_of_reducedAmbientGamma_local
    (x : G) (c : Subgroup.zpowers x)
    (u : reducedAmbientGammaSubgroupOnZpowers K x) :
    orbit_supported_zpowers_function (K := K) (A := A) x (c ^ u) =
      orbit_supported_zpowers_function (K := K) (A := A) x c := by
  obtain ⟨t, ht⟩ :=
    zpowers_pow_eq_ambient_gamma_pow_of_mem_reducedAmbient_local
      (K := K) x c u
  let cu : Subgroup.zpowers x := ⟨(c : G) ^ t, by
    rw [pow_subgroup_eq_pow_nat]
    exact Subgroup.pow_mem (Subgroup.zpowers x) c.2 _⟩
  have hpow : (c ^ u : Subgroup.zpowers x) = cu := by
    apply Subtype.ext
    exact ht
  calc
    orbit_supported_zpowers_function (K := K) (A := A) x (c ^ u) =
        orbit_supported_zpowers_function (K := K) (A := A) x cu := by
          rw [hpow]
    _ = orbit_supported_zpowers_function (K := K) (A := A) x c := by
          simpa [cu] using
            orbit_supported_zpowers_function_pow_eq (K := K) (A := A) x c t

/-- Helper for Lemma 12-12.7-6: the cyclic source on `C = ⟨x⟩` is constant on the power classes
cut out by the reduced ambient arithmetic subgroup on `C`. This is the source-faithful quotient
constancy that survives from ambient `Γ_K` to the cyclic factor. -/
lemma orbit_supported_zpowers_function_isConstantOnGaloisPowerClasses_local
    (x : G) :
    IsConstantOnGaloisPowerClasses
      (reducedAmbientGammaSubgroupOnZpowers K x)
      (orbit_supported_zpowers_function (K := K) (A := A) x) := by
  letI : IsMulCommutative (Subgroup.zpowers x) := Subgroup.zpowers_isMulCommutative x
  have hfClass : _root_.IsClassFunction
      (orbit_supported_zpowers_function (K := K) (A := A) x) := by
    refine ⟨?_⟩
    intro c d hcd
    have hEq : c = d := by
      rcases isConj_iff.mp (ConjClasses.mk_eq_mk_iff_isConj.mp hcd) with ⟨a, ha⟩
      have hd_val : (d : G) = c := by
        have hcomm :
            ((a : Subgroup.zpowers x) : G) * c = (c : G) * a := by
          exact setLike_mul_comm a.2 c.2
        calc
          (d : G) = ((a : G) * c) * (a⁻¹ : G) := by
            exact congrArg Subtype.val ha.symm
          _ = ((c : G) * a) * (a⁻¹ : G) := by rw [hcomm]
          _ = (c : G) * ((a : G) * (a⁻¹ : G)) := by rw [mul_assoc]
          _ = c := by simp
      exact (Subtype.ext hd_val).symm
    simpa [hEq]
  refine (isConstantOnGaloisPowerClasses_iff_forall_pow_eq hfClass).2 ?_
  intro c u
  -- Route correction: the ambient source support only sees reduced ambient `Γ_K`-powers on
  -- `C`, not a separate literal cyclotomic subgroup `Γ[K](C)`.
  symm
  exact orbit_supported_zpowers_function_pow_eq_of_reducedAmbientGamma_local
    (K := K) (A := A) x c u

/-- Helper for Lemma 12-12.7-6: Serre's cyclic source on `C = ⟨x⟩` belongs to
`A ⊗ R_K(C)` once the reduced ambient arithmetic subgroup is identified with the intrinsic
arithmetic subgroup on `C`. This is the direct source-faithful application of Lemma `15` to the
cyclic group `C`. -/
lemma orbit_supported_zpowers_mem_characterRingOverFieldAlgebraScalarExtension_of_reducedAmbientGamma_local
    (x : G) :
    ((algebraMap A K) ∘ orbit_supported_zpowers_function (K := K) (A := A) x) ∈
      A ⊗R[K](Subgroup.zpowers x) := by
  -- TODO for Lemma 12-12.7-6: specialize the cyclic-descent infrastructure to the reduced ambient
  -- arithmetic subgroup `reducedAmbientGammaSubgroupOnZpowers K x` on `C = ⟨x⟩`.
  -- The closed ingredients already show Serre's source function is constant on those reduced
  -- ambient power classes and takes values in the principal ideal generated by `|C|`; the missing
  -- bridge is the theorem-local descent step that converts those two facts into membership in
  -- `A ⊗ R_K(C)` without requiring an intrinsic `Γ[K](C)` cyclotomic instance on `L`.
  admit

/-- Helper for Lemma 12-12.7-6: the target orbit-supported `K`-valued formula on the associated
subgroup `H = associatedGammaPElementarySubgroup ΓK x P`. -/
def associated_orbit_supported_function
    (x : G) (P : Sylow p N[ΓK](x)) :
    associatedGammaPElementarySubgroup ΓK x P → K :=
  fun h ↦
    if ∃ t : ΓK, h.1 = x ^ t then
      algebraMap A K (Nat.card (Subgroup.zpowers x))
    else
      0

/-- Helper for Lemma 12-12.7-6: the orbit-supported source formula on the associated subgroup
`H = associatedGammaPElementarySubgroup ΓK x P` is pointwise `A`-valued. -/
lemma associated_orbit_supported_function_apply_mem_range
    (x : G) (P : Sylow p N[ΓK](x))
    (h : associatedGammaPElementarySubgroup ΓK x P) :
    associated_orbit_supported_function (K := K) (A := A) x P h ∈
      Set.range (algebraMap A K) := by
  by_cases hpow : ∃ t : ΓK, h.1 = x ^ t
  · refine ⟨Nat.card (Subgroup.zpowers x), ?_⟩
    rw [associated_orbit_supported_function, if_pos hpow]
  · refine ⟨0, ?_⟩
    rw [associated_orbit_supported_function, if_neg hpow]
    simp

end

end Representation
