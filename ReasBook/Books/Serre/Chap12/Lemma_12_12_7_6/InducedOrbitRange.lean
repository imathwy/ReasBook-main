omit [IsDomain A] in
/-- Helper for Lemma 12-12.7-6: a natural number coprime to `p` stays outside every prime ideal
of `A` containing the principal ideal generated by `p`. -/
lemma nat_cast_not_mem_primeIdealOverPrime_of_coprime
    (p m : ℕ) (hcop : Nat.Coprime p m) (Q : PrimeSpectrum A)
    (hQ : Ideal.span {(p : A)} ≤ Q.asIdeal) :
    (m : A) ∉ Q.asIdeal := by
  have hp_mem : (p : A) ∈ Q.asIdeal := by
    exact hQ (Ideal.subset_span (by simp))
  intro hm_mem
  have hbezZ :
      (1 : ℤ) = p * Nat.gcdA p m + m * Nat.gcdB p m := by
    simpa [hcop.gcd_eq_one] using (Nat.gcd_eq_gcd_ab p m)
  have hbezA :
      (1 : A) = (p : A) * (Nat.gcdA p m : A) + (m : A) * (Nat.gcdB p m : A) := by
    simpa using congrArg (fun z : ℤ ↦ (z : A)) hbezZ
  have h1_mem : (1 : A) ∈ Q.asIdeal := by
    rw [hbezA]
    refine Q.asIdeal.add_mem ?_ ?_
    · exact Q.asIdeal.mul_mem_right _ hp_mem
    · exact Q.asIdeal.mul_mem_right _ hm_mem
  have htop : Q.asIdeal = ⊤ :=
    Ideal.eq_top_of_isUnit_mem Q.asIdeal h1_mem (by simp)
  exact Q.isPrime.ne_top htop

/-- Helper for Lemma 12-12.7-6: every element of the cyclic factor `C = ⟨x⟩` is `p`-regular as
soon as the generator `x` is `p`-regular. -/
lemma isPRegular_of_mem_zpowers_local
    (x : G) (hx : IsPRegular p x) {c : G} (hc : c ∈ Subgroup.zpowers x) :
    IsPRegular p c := by
  simpa [IsPRegular] using Nat.Coprime.of_dvd_right (orderOf_dvd_of_mem_zpowers hc) hx

/-- Helper for Lemma 12-12.7-6: inside the associated subgroup `H = ⟨x⟩ ⋅ P`, every
`p`-regular element already lies in the cyclic factor `⟨x⟩`. Equivalently, an element outside
`⟨x⟩` cannot be `p`-regular. -/
lemma not_isPRegular_of_not_mem_zpowers_in_associatedGammaPElementary_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    {h : associatedGammaPElementarySubgroup ΓK x P}
    (hz : h.1 ∉ Subgroup.zpowers x) :
    ¬ IsPRegular p h.1 := by
  intro hh
  obtain ⟨c, hc⟩ :=
    pregular_eq_inclusion_zpowers_of_mem_associatedGammaPElementarySubgroup
      (K := K) (p := p) x hx P h hh
  have hc_val : (c : G) = h.1 := congrArg Subtype.val hc
  exact hz (hc_val ▸ c.2)

/-- Helper for Lemma 12-12.7-6: the orbit-supported formula on the associated subgroup takes the
source value `|⟨x⟩|` exactly on ambient `Γ_K`-powers of `x`. -/
lemma associated_orbit_supported_function_eq_card_of_exists_power
    (x : G) (P : Sylow p N[ΓK](x))
    (h : associatedGammaPElementarySubgroup ΓK x P)
    (hpow : ∃ t : ΓK, h.1 = x ^ t) :
    associated_orbit_supported_function (K := K) (A := A) x P h =
      algebraMap A K (Nat.card (Subgroup.zpowers x)) := by
  rw [associated_orbit_supported_function, if_pos hpow]

/-- Helper for Lemma 12-12.7-6: on `p`-regular elements of the associated subgroup, the
orbit-supported formula vanishes away from the `p`-regular `Γ_K`-class of `x`. -/
lemma associated_orbit_supported_function_eq_zero_of_pregular_class_ne
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    {h : associatedGammaPElementarySubgroup ΓK x P}
    (hh : IsPRegular p h.1)
    (hneq : pRegularGaloisPowerClassMk ΓK p ⟨h.1, hh⟩ ≠
      pRegularGaloisPowerClassMk ΓK p ⟨x, hx⟩) :
    associated_orbit_supported_function (K := K) (A := A) x P h = 0 := by
  classical
  by_cases hpow : ∃ t : ΓK, h.1 = x ^ t
  · exfalso
    apply hneq
    rcases hpow with ⟨t, ht⟩
    have hh' : IsPRegular p (x ^ t) := by
      simpa [ht] using hh
    have hsub : (⟨h.1, hh⟩ : {x : G // IsPRegular p x}) = ⟨x ^ t, hh'⟩ := by
      apply Subtype.ext
      exact ht
    calc
      pRegularGaloisPowerClassMk ΓK p ⟨h.1, hh⟩ =
          pRegularGaloisPowerClassMk ΓK p ⟨x ^ t, hh'⟩ := by
            rw [hsub]
      _ = pRegularGaloisPowerClassMk ΓK p ⟨x, hx⟩ := by
            apply Quotient.sound
            change PRegularConjClass.ofSubtype p ⟨x ^ t, hh'⟩ ∈
              MulAction.orbit ΓK (PRegularConjClass.ofSubtype p ⟨x, hx⟩)
            exact ⟨t, by
              apply Subtype.ext
              change ConjClasses.pow
                  (galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ))
                  (ConjClasses.mk x) =
                ConjClasses.mk (x ^ t)
              rw [ConjClasses.pow_mk, pow_subgroup_eq_pow_nat]⟩
  · unfold associated_orbit_supported_function
    change ite (∃ t : ΓK, h.1 = x ^ t)
        (algebraMap A K (Nat.card (Subgroup.zpowers x))) 0 = 0
    rw [if_neg hpow]

/-- Helper for Lemma 12-12.7-6: the orbit-supported source function on the associated subgroup
vanishes automatically on non-`p`-regular elements, because every ambient `Γ_K`-power of `x` is
still `p`-regular. -/
lemma associated_orbit_supported_function_eq_zero_of_not_isPRegular
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    {h : associatedGammaPElementarySubgroup ΓK x P}
    (hh : ¬ IsPRegular p h.1) :
    associated_orbit_supported_function (K := K) (A := A) x P h = 0 := by
  by_cases hpow : ∃ t : ΓK, h.1 = x ^ t
  · rcases hpow with ⟨t, ht⟩
    have hreg_pow_nat :
        IsPRegular p (x ^ galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) := by
      have hcop :
          Nat.Coprime (orderOf x)
            (galoisPowerExponentUnit (t : (ZMod (Monoid.exponent G))ˣ)) :=
        (Nat.Coprime.of_dvd_right (Monoid.order_dvd_exponent x)
          (ZMod.val_coe_unit_coprime (t : (ZMod (Monoid.exponent G))ˣ))).symm
      simpa [IsPRegular, hcop.orderOf_pow] using hx
    have hreg_pow : IsPRegular p (x ^ t) := by
      simpa [pow_subgroup_eq_pow_nat] using hreg_pow_nat
    exact (hh <| by simpa [ht] using hreg_pow).elim
  · rw [associated_orbit_supported_function, if_neg hpow]

/-- Helper for Lemma 12-12.7-6: conjugating a `p`-regular element does not change its
`p`-regular `Γ_K`-power class. -/
lemma pRegularGaloisPowerClassMk_conj_eq_local
    (s y : G) (hs : IsPRegular p s) :
    pRegularGaloisPowerClassMk ΓK p
        ⟨y⁻¹ * s * y, by simpa using isPRegular_conj p s y⁻¹ hs⟩ =
      pRegularGaloisPowerClassMk ΓK p ⟨s, hs⟩ := by
  apply Quotient.sound
  have hEq :
      PRegularConjClass.ofSubtype p ⟨y⁻¹ * s * y, by simpa using isPRegular_conj p s y⁻¹ hs⟩ =
        PRegularConjClass.ofSubtype p ⟨s, hs⟩ := by
    apply Subtype.ext
    exact ConjClasses.mk_eq_mk_iff_isConj.mpr <| isConj_iff.mpr ⟨y, by group⟩
  rw [hEq]

/-- Helper for Lemma 12-12.7-6: equality of `p`-regular `Γ_K`-power classes implies equality of
the ambient `Γ_K`-power classes. -/
lemma galoisPowerClassMk_eq_of_pRegularGaloisPowerClassMk_eq
    {s t : G} (hs : IsPRegular p s) (ht : IsPRegular p t)
    (hclass : pRegularGaloisPowerClassMk ΓK p ⟨s, hs⟩ =
      pRegularGaloisPowerClassMk ΓK p ⟨t, ht⟩) :
    galoisPowerClassMk ΓK s = galoisPowerClassMk ΓK t := by
  change Quotient.mk'' (ConjClasses.mk s) = Quotient.mk'' (ConjClasses.mk t)
  apply Quotient.sound
  rcases Quotient.exact hclass with ⟨u, hu⟩
  exact ⟨u, by simpa using congrArg Subtype.val hu⟩

/-- Helper for Lemma 12-12.7-6: once the lifted witness `ψ` on
`H = associatedGammaPElementarySubgroup ΓK x P` agrees with the orbit-supported source formula on
`p`-regular elements of `H`, its induced function on `G` vanishes on every `p`-regular element
whose `Γ_K`-power class is different from that of `x`. -/
lemma induced_lifted_orbit_supported_eq_zero_of_pregular_class_ne_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, IsPRegular p h.1 →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h =
          associated_orbit_supported_function (K := K) (A := A) x P h)
    (s : G) (hs : IsPRegular p s)
    (hneq : pRegularGaloisPowerClassMk ΓK p ⟨s, hs⟩ ≠
      pRegularGaloisPowerClassMk ΓK p ⟨x, hx⟩) :
    ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
        (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
        G → K) s = 0 := by
  let H := associatedGammaPElementarySubgroup ΓK x P
  rw [Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction_apply,
    Subgroup.inducedClassFunction]
  have hsum :
      (∑ y : G,
          if hyH : y⁻¹ * s * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * s * y, hyH⟩
          else
            0) = 0 := by
    refine Finset.sum_eq_zero ?_
    intro y hy
    by_cases hyH : y⁻¹ * s * y ∈ H
    · have hyReg : IsPRegular p (y⁻¹ * s * y) := by
        simpa using isPRegular_conj p s y⁻¹ hs
      let h : H := ⟨y⁻¹ * s * y, hyH⟩
      have hneq' :
          pRegularGaloisPowerClassMk ΓK p ⟨h.1, hyReg⟩ ≠
            pRegularGaloisPowerClassMk ΓK p ⟨x, hx⟩ := by
        intro hhx
        apply hneq
        exact (pRegularGaloisPowerClassMk_conj_eq_local (K := K) (p := p) s y hs).symm.trans hhx
      have hval : (ψ : H → K) h = 0 := by
        rw [hψ h hyReg]
        exact
          associated_orbit_supported_function_eq_zero_of_pregular_class_ne
            (K := K) (A := A) (p := p) x hx P hyReg hneq'
      have hsummand :
          (if hyH' : y⁻¹ * s * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * s * y, hyH'⟩
          else 0) = 0 := by
        have hsummand_eq :
            (if hyH' : y⁻¹ * s * y ∈ H then
              (ψ : H → K) ⟨y⁻¹ * s * y, hyH'⟩
            else 0) =
              (ψ : H → K) h := by
          by_cases hyH'' : y⁻¹ * s * y ∈ H
          · have hs :
                (ψ : H → K) ⟨y⁻¹ * s * y, hyH''⟩ = (ψ : H → K) h := by
              exact congrArg (fun z : H ↦ (ψ : H → K) z) (Subtype.ext rfl)
            simpa [hyH''] using hs
          · exact (hyH'' hyH).elim
        rw [hsummand_eq]
        exact hval
      exact hsummand
    · have hsummand :
          (if hyH' : y⁻¹ * s * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * s * y, hyH'⟩
          else 0) = 0 := by
        simp [hyH]
      exact hsummand
  simpa [hsum]

/-- Helper for Lemma 12-12.7-6: at the distinguished source element `x`, the induced
orbit-supported witness has the normalizer-quotient value appearing in Serre's formula. -/
lemma induced_lifted_orbit_supported_summand_at_x_eq_gammaNormalizer_indicator_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, IsPRegular p h.1 →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h =
          associated_orbit_supported_function (K := K) (A := A) x P h)
    (y : G) :
    (if hyH : y⁻¹ * x * y ∈ associatedGammaPElementarySubgroup ΓK x P then
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) ⟨y⁻¹ * x * y, hyH⟩
      else 0) =
      if hyN : y ∈ N[ΓK](x) then
        algebraMap A K (Nat.card (Subgroup.zpowers x))
      else 0 := by
  let H := associatedGammaPElementarySubgroup ΓK x P
  change
    (if hyH : y⁻¹ * x * y ∈ H then
        (ψ : H → K) ⟨y⁻¹ * x * y, hyH⟩
      else 0) =
      if hyN : y ∈ N[ΓK](x) then
        algebraMap A K (Nat.card (Subgroup.zpowers x))
      else 0
  by_cases hyN : y ∈ N[ΓK](x)
  · have hyInvN : y⁻¹ ∈ N[ΓK](x) := (N[ΓK](x)).inv_mem hyN
    rcases gammaNormalizer_conjugates_zpowers_by_power_local (K := K) x y⁻¹ hyInvN with
        ⟨t, ht⟩
    have hyx_eq_pow : y⁻¹ * x * y = x ^ t := by
      simpa using ht ⟨x, Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩⟩
    have hyx_mem_zpowers : y⁻¹ * x * y ∈ Subgroup.zpowers x := by
      rw [hyx_eq_pow]
      rw [pow_subgroup_eq_pow_nat]
      exact Subgroup.pow_mem (Subgroup.zpowers x)
        (Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩) _
    have hyH : y⁻¹ * x * y ∈ H := by
      exact zpowers_le_associatedGammaPElementarySubgroup ΓK p x P hyx_mem_zpowers
    have hyReg : IsPRegular p (y⁻¹ * x * y) := by
      simpa using isPRegular_conj p x y⁻¹ hx
    let h : H := ⟨y⁻¹ * x * y, hyH⟩
    have hval :
        (ψ : H → K) h = algebraMap A K (Nat.card (Subgroup.zpowers x)) := by
      rw [hψ h hyReg]
      exact
        associated_orbit_supported_function_eq_card_of_exists_power
          (K := K) (A := A) x P h ⟨t, hyx_eq_pow⟩
    have hsummand_eq :
        (if hyH' : y⁻¹ * x * y ∈ H then
          (ψ : H → K) ⟨y⁻¹ * x * y, hyH'⟩
        else 0) =
          (ψ : H → K) h := by
      by_cases hyH'' : y⁻¹ * x * y ∈ H
      · have hs :
            (ψ : H → K) ⟨y⁻¹ * x * y, hyH''⟩ = (ψ : H → K) h := by
          exact congrArg (fun z : H ↦ (ψ : H → K) z) (Subtype.ext rfl)
        simpa [hyH''] using hs
      · exact (hyH'' hyH).elim
    calc
      (if hyH' : y⁻¹ * x * y ∈ H then
          (ψ : H → K) ⟨y⁻¹ * x * y, hyH'⟩
        else 0) = (ψ : H → K) h := hsummand_eq
      _ = algebraMap A K (Nat.card (Subgroup.zpowers x)) := hval
      _ = if hyN' : y ∈ N[ΓK](x) then
            algebraMap A K (Nat.card (Subgroup.zpowers x))
          else 0 := by exact (if_pos hyN).symm
  · by_cases hyH : y⁻¹ * x * y ∈ H
    · have hyReg : IsPRegular p (y⁻¹ * x * y) := by
        simpa using isPRegular_conj p x y⁻¹ hx
      let h : H := ⟨y⁻¹ * x * y, hyH⟩
      have hpow_false : ¬ ∃ t : ΓK, y⁻¹ * x * y = x ^ t := by
        intro hpow
        rcases hpow with ⟨t, ht⟩
        have hyInvN : y⁻¹ ∈ N[ΓK](x) := by
          exact ⟨t, by simpa using ht⟩
        have hyN' : y ∈ N[ΓK](x) := by
          simpa using (N[ΓK](x)).inv_mem hyInvN
        exact hyN hyN'
      have hval : (ψ : H → K) h = 0 := by
        rw [hψ h hyReg]
        rw [associated_orbit_supported_function, if_neg hpow_false]
      have hsummand_eq :
          (if hyH' : y⁻¹ * x * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * x * y, hyH'⟩
          else 0) =
            (ψ : H → K) h := by
        by_cases hyH'' : y⁻¹ * x * y ∈ H
        · have hs :
              (ψ : H → K) ⟨y⁻¹ * x * y, hyH''⟩ = (ψ : H → K) h := by
            exact congrArg (fun z : H ↦ (ψ : H → K) z) (Subtype.ext rfl)
          simpa [hyH''] using hs
        · exact (hyH'' hyH).elim
      calc
        (if hyH' : y⁻¹ * x * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * x * y, hyH'⟩
          else 0) = (ψ : H → K) h := hsummand_eq
        _ = 0 := hval
        _ = if hyN' : y ∈ N[ΓK](x) then
              algebraMap A K (Nat.card (Subgroup.zpowers x))
            else 0 := by exact (if_neg hyN).symm
    · calc
        (if hyH' : y⁻¹ * x * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * x * y, hyH'⟩
          else 0) = 0 := by simp [hyH]
        _ = if hyN' : y ∈ N[ΓK](x) then
              algebraMap A K (Nat.card (Subgroup.zpowers x))
            else 0 := by exact (if_neg hyN).symm

/-- Helper for Lemma 12-12.7-6: at the distinguished source element `x`, the induced
orbit-supported witness has the normalizer-quotient value appearing in Serre's formula. -/
lemma associatedGammaPElementary_card_eq_zpowers_card_mul_card_P_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x)) :
    Nat.card (associatedGammaPElementarySubgroup ΓK x P) =
      Nat.card (Subgroup.zpowers x) * Nat.card (P : Subgroup N[ΓK](x)) := by
  let H := associatedGammaPElementarySubgroup ΓK x P
  let C₀ : Subgroup H := (Subgroup.zpowers x).subgroupOf H
  let Pimg : Subgroup G := Subgroup.map N[ΓK](x).subtype (P : Subgroup N[ΓK](x))
  let P₀ : Subgroup H := Pimg.subgroupOf H
  let hdecomp :
      Subgroup.IsGammaPElementaryDecomposition ΓK p C₀ P₀ :=
    associatedGammaPElementarySubgroup_decomposition ΓK p x hx P
  haveI : C₀.Normal := by
    simpa [H, C₀] using associatedGammaPElementary_zpowers_normal (K := K) (p := p) x P
  have hcard_prod : Nat.card H = Nat.card C₀ * Nat.card P₀ := by
    let e : H ⧸ C₀ ≃* P₀ := hdecomp.isComplement.symm.QuotientMulEquiv
    calc
      Nat.card H = Nat.card (H ⧸ C₀) * Nat.card C₀ := by
        exact Subgroup.card_eq_card_quotient_mul_card_subgroup (α := H) C₀
      _ = Nat.card P₀ * Nat.card C₀ := by
        rw [Nat.card_congr e.toEquiv]
      _ = Nat.card C₀ * Nat.card P₀ := by
        rw [Nat.mul_comm]
  have hcard_cyclic : Nat.card C₀ = Nat.card (Subgroup.zpowers x) := by
    have hz : Subgroup.zpowers x ≤ H := zpowers_le_associatedGammaPElementarySubgroup ΓK p x P
    simpa [C₀] using
      (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hz).toEquiv)
  have hcard_image : Nat.card Pimg = Nat.card (P : Subgroup N[ΓK](x)) := by
    let eP : P ≃* Pimg :=
      MulEquiv.ofBijective
        (N[ΓK](x).subtype.subgroupMap (P : Subgroup N[ΓK](x))) <|
          ⟨by
              intro a b hab
              apply Subtype.ext
              apply Subtype.ext
              exact congrArg (fun z : Pimg ↦ (z : G)) hab,
            N[ΓK](x).subtype.subgroupMap_surjective (P : Subgroup N[ΓK](x))⟩
    exact (Nat.card_congr eP.toEquiv).symm
  have hcard_pgroup : Nat.card P₀ = Nat.card (P : Subgroup N[ΓK](x)) := by
    have hPimg_le : Pimg ≤ H := le_sup_right
    have hcard_subgroupOf : Nat.card P₀ = Nat.card Pimg := by
      exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hPimg_le).toEquiv
    exact hcard_subgroupOf.trans hcard_image
  calc
    Nat.card H = Nat.card C₀ * Nat.card P₀ := hcard_prod
    _ = Nat.card (Subgroup.zpowers x) * Nat.card (P : Subgroup N[ΓK](x)) := by
      rw [hcard_cyclic, hcard_pgroup]

/-- Helper for Lemma 12-12.7-6: the quotient `|N[Γ_K](x)| / |P|` is prime to `p` for a Sylow
`p`-subgroup `P` of the arithmetic normalizer `N[Γ_K](x)`. -/
lemma associatedGammaPElementary_index_coprime_p
    (x : G) (P : Sylow p N[ΓK](x)) :
    Nat.Coprime p (Nat.card N[ΓK](x) / Nat.card (P : Subgroup N[ΓK](x))) := by
  have hindex :
      (P : Subgroup N[ΓK](x)).index =
        Nat.card N[ΓK](x) / Nat.card (P : Subgroup N[ΓK](x)) := by
    exact Nat.eq_div_of_mul_eq_right Nat.card_pos.ne' (P : Subgroup N[ΓK](x)).card_mul_index
  have hcop_index : Nat.Coprime p (P : Subgroup N[ΓK](x)).index := by
    exact (Fact.out : Nat.Prime p).coprime_iff_not_dvd.mpr P.not_dvd_index
  rw [← hindex]
  exact hcop_index

/-- Helper for Lemma 12-12.7-6: every owner element of `A ⊗ R_K(G)` is constant on the ambient
arithmetic `Γ_K`-power classes. -/
lemma isConstantOnGaloisPowerClasses_of_mem_characterRingOverFieldAlgebraScalarExtension_local
    {f : G → K}
    (hf : f ∈ characterRingOverFieldAlgebraScalarExtension A K G) :
    IsConstantOnGaloisPowerClasses ΓK f := by
  have hfClass : _root_.IsClassFunction f := by
    induction hf using Submodule.span_induction with
    | mem ψ hψ =>
        exact isClassFunction_of_mem_characterRingOverField ψ (by simpa using hψ)
    | zero =>
        simpa using (inferInstance : _root_.IsClassFunction (fun _ : G ↦ (0 : K)))
    | add f g _ _ hf hg =>
        letI : _root_.IsClassFunction f := hf
        letI : _root_.IsClassFunction g := hg
        simpa using (inferInstance : _root_.IsClassFunction (f + g))
    | smul a f _ hf =>
        letI : _root_.IsClassFunction f := hf
        simpa using (inferInstance : _root_.IsClassFunction (a • f))
  refine (isConstantOnGaloisPowerClasses_iff_forall_pow_eq hfClass).2 ?_
  let φ : classFunctionSubmodule K G :=
    ⟨f, (mem_classFunctionSubmodule_iff K f).2 hfClass⟩
  have hscalar :
      f ∈ characterRingOverFieldAlgebraScalarExtension K K G := by
    have hle :
        characterRingOverFieldAlgebraScalarExtension A K G ≤
          (characterRingOverFieldAlgebraScalarExtension K K G).restrictScalars A := by
      refine Submodule.span_le.2 ?_
      intro ψ hψ
      exact mem_characterRingOverFieldAlgebraScalarExtension_of_mem_characterRingOverField
        (A := K) (K := K) (G := G) (by simpa using hψ)
    exact hle hf
  simpa using
    (classFunction_mem_characterRingOverFieldScalarExtension_iff_gammaSubgroup_invariant
      (G := G) (L := L) K φ).1 hscalar

/-- Helper for Lemma 12-12.7-6: at the distinguished source element `x`, the induced
orbit-supported witness has the normalizer-quotient value appearing in Serre's formula. -/
lemma induced_lifted_orbit_supported_at_x_eq_normalizer_quotient_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, IsPRegular p h.1 →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h =
          associated_orbit_supported_function (K := K) (A := A) x P h) :
    ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
        (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
        G → K) x =
      algebraMap A K (Nat.card N[ΓK](x) / Nat.card (P : Subgroup N[ΓK](x))) := by
  let H := associatedGammaPElementarySubgroup ΓK x P
  let c : ℕ := Nat.card (Subgroup.zpowers x)
  let q : ℕ := Nat.card (P : Subgroup N[ΓK](x))
  let n : ℕ := Nat.card N[ΓK](x)
  have hcardH_nat :
      Nat.card H = c * q := by
    change Nat.card (associatedGammaPElementarySubgroup ΓK x P) = c * q
    dsimp [c, q]
    exact
      associatedGammaPElementary_card_eq_zpowers_card_mul_card_P_local
        (K := K) (p := p) x hx P
  have hcardH_cast : (Nat.card H : K) = (c : K) * (q : K) := by
    exact_mod_cast hcardH_nat
  have hc_nat_ne : c ≠ 0 := by
    dsimp [c]
    exact Nat.card_pos.ne'
  have hc_ne : (c : K) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr hc_nat_ne
  have hq_nat_ne : q ≠ 0 := by
    dsimp [q]
    exact Nat.ne_of_gt <| (Nat.card_pos_iff.2 ⟨⟨1, (P : Subgroup N[ΓK](x)).one_mem⟩, inferInstance⟩)
  have hq_ne : (q : K) ≠ 0 := by
    exact Nat.cast_ne_zero.mpr hq_nat_ne
  have hn_nat : n = (n / q) * q := by
    exact (Nat.div_mul_cancel (Subgroup.card_subgroup_dvd_card (P : Subgroup N[ΓK](x)))).symm
  have hn_cast : (n : K) = ((n / q : ℕ) : K) * (q : K) := by
    simpa [Nat.cast_mul] using congrArg (fun m : ℕ ↦ (m : K)) hn_nat
  have hsummand :
      ∀ y : G,
        (if hyH : y⁻¹ * x * y ∈ H then
          (ψ : H → K) ⟨y⁻¹ * x * y, hyH⟩
        else 0) =
          if hyN : y ∈ N[ΓK](x) then (c : K) else 0 := by
    intro y
    simpa [H, c] using
      induced_lifted_orbit_supported_summand_at_x_eq_gammaNormalizer_indicator_local
        (K := K) (A := A) (p := p) x hx P ψ hψ y
  have hsum_rewrite :
      (∑ y : G,
          if hyH : y⁻¹ * x * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * x * y, hyH⟩
          else 0) =
        ∑ y : G, if hyN : y ∈ N[ΓK](x) then (c : K) else 0 := by
    refine Finset.sum_congr rfl ?_
    intro y hy
    exact hsummand y
  have hsum_normalizer :
      ∑ y : G, (if hyN : y ∈ N[ΓK](x) then (c : K) else 0) = (n : K) * (c : K) := by
    classical
    calc
      ∑ y : G, (if hyN : y ∈ N[ΓK](x) then (c : K) else 0) =
          ∑ y ∈ Finset.univ ∩ Finset.univ.filter (fun y : G ↦ y ∈ N[ΓK](x)), (c : K) := by
            simpa using
              (Finset.sum_ite_mem (s := Finset.univ)
                (t := Finset.univ.filter (fun y : G ↦ y ∈ N[ΓK](x)))
                (f := fun _ : G ↦ (c : K)))
      _ =
          Finset.sum (Finset.univ.filter (fun y : G ↦ y ∈ N[ΓK](x))) (fun _ : G ↦ (c : K)) := by
            simp
      _ = ∑ y : N[ΓK](x), (c : K) := by
            simpa using
              (Finset.sum_subtype
                (s := Finset.univ.filter (fun y : G ↦ y ∈ N[ΓK](x)))
                (h := by
                  intro y
                  simp)
                (f := fun _ : G ↦ (c : K)))
      _ = (n : K) * (c : K) := by
            simp [n, Nat.card_eq_fintype_card, mul_comm]
  have hmain :
      ((Nat.card H : K)⁻¹) *
          (∑ y : G,
            if hyH : y⁻¹ * x * y ∈ H then
              (ψ : H → K) ⟨y⁻¹ * x * y, hyH⟩
            else 0) =
        algebraMap A K (n / q) := by
    rw [hsum_rewrite, hsum_normalizer]
    rw [hcardH_cast, hn_cast]
    have hcq_ne : ((c : K) * (q : K)) ≠ 0 := mul_ne_zero hc_ne hq_ne
    calc
      ((c : K) * (q : K))⁻¹ * ((((n / q : ℕ) : K) * (q : K)) * (c : K)) =
          (((c : K) * (q : K))⁻¹ * ((c : K) * (q : K))) * (((n / q : ℕ) : K)) := by
            ring
      _ = ((n / q : ℕ) : K) := by
            rw [inv_mul_cancel₀ hcq_ne, one_mul]
      _ = algebraMap A K (n / q) := by
            simpa using (map_natCast (algebraMap A K) (n / q))
  calc
    ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
          (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
          G → K) x =
        ((Nat.card H : K)⁻¹) *
          (∑ y : G,
            if hyH : y⁻¹ * x * y ∈ H then
              (ψ : H → K) ⟨y⁻¹ * x * y, hyH⟩
            else 0) := by
          rfl
    _ = algebraMap A K (n / q) := hmain
    _ = algebraMap A K (Nat.card N[ΓK](x) / Nat.card (P : Subgroup N[ΓK](x))) := by
          rfl

/-- Helper for Lemma 12-12.7-6: for the induced witness on `G`, the value on a `p`-regular
element depends only on its `p`-regular `Γ_K`-power class. -/
lemma induced_character_eq_of_pRegularGaloisPowerClass_eq_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    {s : G} (hs : IsPRegular p s)
    (hclass : pRegularGaloisPowerClassMk ΓK p ⟨s, hs⟩ =
      pRegularGaloisPowerClassMk ΓK p ⟨x, hx⟩) :
    ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
        (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
        G → K) s =
      ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
        (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
        G → K) x := by
  let χA : A ⊗R[K](G) :=
    Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
      (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ
  let χ : G → K := χA
  have hχconst : IsConstantOnGaloisPowerClasses ΓK χ := by
    exact
      isConstantOnGaloisPowerClasses_of_mem_characterRingOverFieldAlgebraScalarExtension_local
        (K := K) (A := A) χA.2
  have hmk :
      galoisPowerClassMk ΓK s = galoisPowerClassMk ΓK x := by
    exact galoisPowerClassMk_eq_of_pRegularGaloisPowerClassMk_eq (K := K) (p := p) hs hx hclass
  simpa [χ, χA] using hχconst.eq_of_mk_eq hmk

/-- Helper for Lemma 12-12.7-6: on every `p`-regular element of `G`, the induced orbit-supported
separator already has an `A`-valued lift. This matches the source proof, which only controls the
`p'`-locus. -/
lemma induced_lifted_orbit_supported_value_mem_range_of_isPRegular_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, IsPRegular p h.1 →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h =
          associated_orbit_supported_function (K := K) (A := A) x P h)
    (s : G) (hs : IsPRegular p s) :
    ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
        (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
        G → K) s ∈
      Set.range (algebraMap A K) := by
  by_cases hclass : pRegularGaloisPowerClassMk ΓK p ⟨s, hs⟩ =
      pRegularGaloisPowerClassMk ΓK p ⟨x, hx⟩
  · refine ⟨Nat.card N[ΓK](x) / Nat.card (P : Subgroup N[ΓK](x)), ?_⟩
    have hsx :
        ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
            (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ :
              A ⊗R[K](G)) : G → K) s
          =
        ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
            (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ :
              A ⊗R[K](G)) : G → K) x :=
      induced_character_eq_of_pRegularGaloisPowerClass_eq_local
        (K := K) (A := A) (p := p) x hx P ψ hs hclass
    exact (hsx.trans <|
      induced_lifted_orbit_supported_at_x_eq_normalizer_quotient_local
        (K := K) (A := A) (p := p) x hx P ψ hψ).symm
  · refine ⟨0, ?_⟩
    simpa using
      (induced_lifted_orbit_supported_eq_zero_of_pregular_class_ne_local
        (K := K) (A := A) (p := p) x hx P ψ hψ s hs hclass).symm

/-- Helper for Lemma 12-12.7-6: the proved `p`-regular range statement applies in particular to
the `p`-regular component of any ambient element. This isolates the already-closed frontier before
the missing Chapter `12.7.4` comparison from `g` to `pRegularComponent p g`. -/
lemma induced_lifted_orbit_supported_value_mem_range_at_pRegularComponent_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, IsPRegular p h.1 →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h =
          associated_orbit_supported_function (K := K) (A := A) x P h)
    (g : G) :
    ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
        (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
        G → K) (pRegularComponent p g) ∈
      Set.range (algebraMap A K) := by
  exact
    induced_lifted_orbit_supported_value_mem_range_of_isPRegular_local
      (K := K) (A := A) (p := p) x hx P ψ hψ
      (pRegularComponent p g) (isPRegular_pRegularComponent (p := p) g)

/-- Helper for Lemma 12-12.7-6: any ambient `Γ_K`-power of `x` already lies in the cyclic factor
`⟨x⟩`. This is the source-level bridge from the ambient orbit notation back to the subgroup
`C = ⟨x⟩`. -/
lemma mem_zpowers_of_exists_gamma_power_local
    (x : G) (P : Sylow p N[ΓK](x))
    {h : associatedGammaPElementarySubgroup ΓK x P}
    (hpow : ∃ t : ΓK, h.1 = x ^ t) :
    h.1 ∈ Subgroup.zpowers x := by
  rcases hpow with ⟨t, ht⟩
  rw [ht, pow_subgroup_eq_pow_nat]
  exact Subgroup.pow_mem (Subgroup.zpowers x)
    (Subgroup.mem_zpowers_iff.mpr ⟨1, by simp⟩) _

/-- Helper for Lemma 12-12.7-6: restricting the orbit-supported formula on
`H = associatedGammaPElementarySubgroup ΓK x P` back to the cyclic factor `C = ⟨x⟩` recovers the
original cyclic source function `ψ_C`. -/
lemma associated_orbit_supported_function_inclusion_eq_orbit_supported_zpowers_local
    (x : G) (P : Sylow p N[ΓK](x)) (c : Subgroup.zpowers x) :
    associated_orbit_supported_function (K := K) (A := A) x P
        (Subgroup.inclusion (zpowers_le_associatedGammaPElementarySubgroup ΓK p x P) c) =
      ((algebraMap A K) ∘ orbit_supported_zpowers_function (K := K) (A := A) x) c := by
  by_cases hpow : ∃ t : ΓK, (c : G) = x ^ t
  · have hpow_incl :
        ∃ t : ΓK,
          (Subgroup.inclusion (zpowers_le_associatedGammaPElementarySubgroup ΓK p x P) c).1 =
            x ^ t := by
      simpa using hpow
    rw [associated_orbit_supported_function, if_pos hpow_incl]
    change
      algebraMap A K (Nat.card (Subgroup.zpowers x)) =
        algebraMap A K
          (if ∃ t : ΓK, (c : G) = x ^ t then
            (Nat.card (Subgroup.zpowers x) : A)
          else 0)
    rw [if_pos hpow]
  · have hpow_incl :
        ¬ ∃ t : ΓK,
          (Subgroup.inclusion (zpowers_le_associatedGammaPElementarySubgroup ΓK p x P) c).1 =
            x ^ t := by
      simpa using hpow
    rw [associated_orbit_supported_function, if_neg hpow_incl]
    change
      0 =
        algebraMap A K
          (if ∃ t : ΓK, (c : G) = x ^ t then
            (Nat.card (Subgroup.zpowers x) : A)
          else 0)
    rw [if_neg hpow]
    rw [map_zero]

/-- Helper for Lemma 12-12.7-6: the orbit-supported formula on
`H = associatedGammaPElementarySubgroup ΓK x P` vanishes off the cyclic factor `C = ⟨x⟩`. This is
the exact support statement used in Serre's source proof. -/
lemma associated_orbit_supported_function_eq_zero_of_not_mem_zpowers_local
    (x : G) (P : Sylow p N[ΓK](x))
    {h : associatedGammaPElementarySubgroup ΓK x P}
    (hz : h.1 ∉ Subgroup.zpowers x) :
    associated_orbit_supported_function (K := K) (A := A) x P h = 0 := by
  have hpow_false : ¬ ∃ t : ΓK, h.1 = x ^ t := by
    intro hpow
    exact hz <|
      mem_zpowers_of_exists_gamma_power_local (K := K) (p := p) x P hpow
  rw [associated_orbit_supported_function, if_neg hpow_false]

/-- Helper for Lemma 12-12.7-6: any lift that agrees with Serre's orbit-supported formula on the
`p`-regular locus of `H = associatedGammaPElementarySubgroup ΓK x P` already vanishes on
`p`-regular elements outside the cyclic factor `C = ⟨x⟩`. -/
lemma lifted_orbit_supported_eq_zero_of_not_mem_zpowers_of_isPRegular_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, IsPRegular p h.1 →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h =
          associated_orbit_supported_function (K := K) (A := A) x P h)
    {h : associatedGammaPElementarySubgroup ΓK x P}
    (hh : IsPRegular p h.1)
    (hz : h.1 ∉ Subgroup.zpowers x) :
    (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h = 0 := by
  rw [hψ h hh]
  exact associated_orbit_supported_function_eq_zero_of_not_mem_zpowers_local
    (K := K) (A := A) (p := p) x P hz

/-- Helper for Lemma 12-12.7-6: once the chosen lift on
`H = associatedGammaPElementarySubgroup ΓK x P` is zero on the non-`p`-regular locus of `H`,
its induced function on `G` is also zero on every non-`p`-regular element. -/
lemma induced_lifted_orbit_supported_eq_zero_of_not_isPRegular_local
    (x : G) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ_zero :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, ¬ IsPRegular p h.1 →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h = 0)
    (s : G) (hs : ¬ IsPRegular p s) :
    ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
        (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
        G → K) s = 0 := by
  let H := associatedGammaPElementarySubgroup ΓK x P
  rw [Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction_apply,
    Subgroup.inducedClassFunction]
  have hsum :
      (∑ y : G,
          if hyH : y⁻¹ * s * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * s * y, hyH⟩
          else
            0) = 0 := by
    refine Finset.sum_eq_zero ?_
    intro y hy
    by_cases hyH : y⁻¹ * s * y ∈ H
    · have hy_not_reg : ¬ IsPRegular p (y⁻¹ * s * y) := by
        intro hy_reg
        apply hs
        simpa [mul_assoc] using isPRegular_conj p (y⁻¹ * s * y) y hy_reg
      let h : H := ⟨y⁻¹ * s * y, hyH⟩
      have hval : (ψ : H → K) h = 0 := hψ_zero h hy_not_reg
      have hsummand :
          (if hyH' : y⁻¹ * s * y ∈ H then
            (ψ : H → K) ⟨y⁻¹ * s * y, hyH'⟩
          else 0) = 0 := by
        have hsummand_eq :
            (if hyH' : y⁻¹ * s * y ∈ H then
              (ψ : H → K) ⟨y⁻¹ * s * y, hyH'⟩
            else 0) =
              (ψ : H → K) h := by
          by_cases hyH'' : y⁻¹ * s * y ∈ H
          · have hs :
                (ψ : H → K) ⟨y⁻¹ * s * y, hyH''⟩ = (ψ : H → K) h := by
              exact congrArg (fun z : H ↦ (ψ : H → K) z) (Subtype.ext rfl)
            simpa [hyH''] using hs
          · exact (hyH'' hyH).elim
        rw [hsummand_eq]
        exact hval
      exact hsummand
    · simp [hyH]
  simpa [hsum]

/-- Helper for Lemma 12-12.7-6: if the lifted witness on
`H = associatedGammaPElementarySubgroup ΓK x P` vanishes off the cyclic factor `⟨x⟩`, then it is
automatically zero on the non-`p`-regular locus of `H`. This isolates the exact point where a
stronger source-faithful `H`-lift would discharge the remaining non-`p`-regular arithmetic. -/
lemma lifted_orbit_supported_eq_zero_of_not_isPRegular_of_zero_off_not_mem_zpowers_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ_off :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, h.1 ∉ Subgroup.zpowers x →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h = 0)
    {h : associatedGammaPElementarySubgroup ΓK x P}
    (hh : ¬ IsPRegular p h.1) :
    (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h = 0 := by
  have hz : h.1 ∉ Subgroup.zpowers x := by
    intro hz
    exact hh <| isPRegular_of_mem_zpowers_local (p := p) x hx hz
  exact hψ_off h hz

/-- Helper for Lemma 12-12.7-6: under the stronger support-zero hypothesis on the chosen lift on
`H = associatedGammaPElementarySubgroup ΓK x P`, the induced function is already `A`-valued on
every non-`p`-regular element of `G`. This records the exact source-faithful reduction available
once the lift is tightened to vanish off `⟨x⟩`. -/
lemma induced_lifted_orbit_supported_value_mem_range_of_zero_off_not_mem_zpowers_local
    (x : G) (hx : IsPRegular p x) (P : Sylow p N[ΓK](x))
    (ψ : A ⊗R[K](associatedGammaPElementarySubgroup ΓK x P))
    (hψ_off :
      ∀ h : associatedGammaPElementarySubgroup ΓK x P, h.1 ∉ Subgroup.zpowers x →
        (ψ : associatedGammaPElementarySubgroup ΓK x P → K) h = 0)
    (s : G) (hs : ¬ IsPRegular p s) :
    ((Subgroup.characterRingOverFieldAlgebraScalarExtensionInduction
        (A := A) (K := K) (H := associatedGammaPElementarySubgroup ΓK x P) ψ : A ⊗R[K](G)) :
        G → K) s ∈
      Set.range (algebraMap A K) := by
  refine ⟨0, ?_⟩
  simpa using
    (induced_lifted_orbit_supported_eq_zero_of_not_isPRegular_local
      (K := K) (A := A) (p := p) x P ψ
      (fun h hh ↦
        lifted_orbit_supported_eq_zero_of_not_isPRegular_of_zero_off_not_mem_zpowers_local
          (K := K) (A := A) (p := p) x hx P ψ hψ_off hh)
      s hs).symm

end

end Representation
