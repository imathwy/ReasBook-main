open MeasureTheory ProbabilityTheory

noncomputable section

universe u

namespace ProbabilityTheory

variable {Ω : Type u} [MeasurableSpace Ω]

-- Proof sketch: work at the chapter owner layer
-- `[IsMarkovProcessRealization (fun n ↦ dirac_convolution_kernel (ν : Measure ℤ) ^ n) P X]`.
-- The mean-zero direction is exactly
-- `ProbabilityTheory.integerRandomWalk_recurrent_of_integrable_mean_zero`, and the converse is
-- the classical one-dimensional drift criterion.
/-- Theorem 17.40: a one-dimensional random walk on `ℤ` with step law `ν` and finite first moment
is recurrent exactly when the drift of `ν` vanishes. The public statement is organized around the
chapter owner abstraction of a Markov-process realization of the convolution semigroup generated by
`ν`; increment presentations belong to the bridge layer rather than the main interface. -/
theorem integerRandomWalk_recurrent_iff_zero_stepLawMean
    (ν : ProbabilityMeasure ℤ) (P : ℤ → ProbabilityMeasure Ω) (X : ℕ → Ω → ℤ)
    (hfirstMoment : Integrable (fun z : ℤ ↦ (z : ℝ)) (ν : Measure ℤ))
    [IsMarkovProcessRealization
      (fun n : ℕ ↦ dirac_convolution_kernel (ν : Measure ℤ) ^ n) P X] :
    IsRecurrentMarkovChain P X ↔ ∫ z, (z : ℝ) ∂(ν : Measure ℤ) = 0 := by
  constructor
  · intro hrec
    sorry
  · intro hmean
    exact integerRandomWalk_recurrent_of_integrable_mean_zero P X ν hfirstMoment hmean

end ProbabilityTheory
