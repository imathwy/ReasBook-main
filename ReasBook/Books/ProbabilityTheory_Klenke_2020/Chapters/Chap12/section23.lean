/-! ### Example_12_23 (from Items/Chap12) -/
open MeasureTheory ProbabilityTheory
open scoped ProbabilityTheory

universe u

variable {Ω : Type u} [mΩ : MeasurableSpace Ω] [StandardBorelSpace Ω]
variable {P : Measure Ω} [IsFiniteMeasure P]

-- Proof sketch: ordinary independence upgrades to conditional independence over `⊥` by the
-- chapter/mathlib conditional-independence owner API. The inclusion `σ(X + Y) ≤ σ(X, Y)` is the
-- measurability statement that `X + Y` factors through `(X, Y)`, and conditioning on `σ(X, Y)`
-- gives conditional independence by the owner lemma `condIndepFun_of_measurable_left`. If both
-- variables are nontrivial, the conditional product formula fails on a positive-measure fiber of
-- `X + Y`, so conditional independence does not persist when passing to the smaller conditioning
-- `σ`-algebra generated by `X + Y`.
/-- Example 12.23: conditional independence is not monotone in the conditioning `σ`-algebra.
If `X` and `Y` are independent and nontrivial, then they are conditionally independent given
`⊥` and given `σ(X, Y)`, the inclusion `σ(X + Y) ≤ σ(X, Y)` holds, but they are not conditionally
independent given `σ(X + Y)`. -/
theorem condIndepFun_given_bot_and_pair_not_given_sum_of_indepFun
    {X Y : Ω → ℝ} (hX : Measurable X) (hY : Measurable Y)
    (h_indep : X ⟂ᵢ[P] Y)
    (hX_nontrivial : ¬ ∃ c : ℝ, X =ᵐ[P] fun _ ↦ c)
    (hY_nontrivial : ¬ ∃ c : ℝ, Y =ᵐ[P] fun _ ↦ c) :
    CondIndepFun (⊥ : MeasurableSpace Ω) bot_le X Y P ∧
      MeasurableSpace.comap (X + Y) inferInstance ≤
        MeasurableSpace.comap (fun ω ↦ (X ω, Y ω)) inferInstance ∧
      X ⟂ᵢ[fun ω ↦ (X ω, Y ω), hX.prodMk hY; P] Y ∧
      ¬ (X ⟂ᵢ[X + Y, hX.add hY; P] Y) := sorry
