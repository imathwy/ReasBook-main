import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.


/-! ### Theorem_14_12 (from Items/Chap14) -/
open MeasureTheory MeasurableSpace Set

universe u v

variable {I : Type u} {Ω : I → Type v} [mΩ : ∀ i, MeasurableSpace (Ω i)]
variable {E : ∀ i, Set (Set (Ω i))}

/- Layering: `generateFrom_eq_pi` and `MeasureTheory.generateFrom_squareCylinders` are the core
owner theorems for product `σ`-algebras generated by boxes and rectangular cylinders. Theorem
14.12 (1) stays source-facing because it keeps the textbook finite-index-set formulation without
adding countable-spanning hypotheses, while (2) and (3) are bridge/view consequences for the
textbook square-cylinder family. No primitive data is introduced here. -/

/- Canonical recall: for finite index types, countably spanning generating boxes already give the
product `σ`-algebra via the owner theorem `generateFrom_eq_pi`. -/
recall generateFrom_eq_pi

-- Proof sketch: argue as in the textbook by showing that every generating box belongs to the
-- finite product measurable space and that every coordinate pullback of a generator belongs to the
-- `σ`-algebra generated by those boxes, then conclude by minimality of `generateFrom`.
/-- Theorem 14.12 (1): for every finite index set `J`, the product `σ`-algebra on
`(j : J) → Ω j` is generated by the rectangles whose coordinate sections lie in the generators
`E j`. -/
theorem generateFrom_boxes_eq_finite_product (J : Finset I)
    (hE : ∀ j : J, generateFrom (E j.1) = mΩ j.1) :
    generateFrom (pi univ '' pi univ (fun j : J ↦ E j.1)) =
      (MeasurableSpace.pi : MeasurableSpace ((j : J) → Ω j)) := sorry

/- Canonical recall: the product `σ`-algebra on `∀ i, Ω i` is generated by the measurable
rectangular cylinders, i.e. by the textbook family `\mathcal Z^R`. -/
recall MeasureTheory.generateFrom_squareCylinders

-- Proof sketch: the inclusion from `squareCylinders E` into the product `σ`-algebra is immediate
-- from measurability of coordinate pullbacks, while the reverse inclusion follows because the
-- one-coordinate cylinders coming from `E i` already generate each factor `σ`-algebra.
/-- Theorem 14.12 (2): if each `E i` generates the factor `σ`-algebra, then the product
`σ`-algebra on `∀ i, Ω i` is also generated by the square cylinders built from the sets `E i`,
namely the textbook family `\mathcal Z^{\mathcal E, R}`. -/
theorem generateFrom_squareCylinders_eq_product
    (hE : ∀ i, generateFrom (E i) = mΩ i)
    :
    generateFrom (squareCylinders E) =
      (MeasurableSpace.pi : MeasurableSpace ((i : I) → Ω i)) := sorry

-- Proof sketch: combine the previous generation theorem with the π-system hypothesis on the
-- square cylinders and apply the extensionality theorem `FiniteSpanningSetsIn.ext` for measures.
/-- Theorem 14.12 (3): if the factor generators `E i` are π-systems and `μ` has a countable
finite-measure spanning family inside the square cylinders `\mathcal Z^{\mathcal E, R}`, then `μ`
is uniquely determined by its values on those square cylinders. -/
theorem measure_eq_of_agree_on_squareCylinders
    {μ ν : Measure ((i : I) → Ω i)}
    (hE : ∀ i, generateFrom (E i) = mΩ i)
    (hE_pi : ∀ i, IsPiSystem (E i))
    (hμ : μ.FiniteSpanningSetsIn (squareCylinders E))
    (h_eq : ∀ s ∈ squareCylinders E, μ s = ν s) :
    μ = ν := sorry
