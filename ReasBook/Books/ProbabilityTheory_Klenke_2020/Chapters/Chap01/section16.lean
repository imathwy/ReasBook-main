/-! ### Theorem_1_16 (from Items/Chap01) -/
universe u

/-- Theorem 1.16: `MeasurableSpace.generateFrom E` is the least σ-algebra on `Ω` containing the
generator `E`. -/
-- Proof sketch: show every set in `E` is measurable in `MeasurableSpace.generateFrom E` by the
-- basic constructor, then use `MeasurableSpace.generateFrom_le` to prove minimality among all
-- measurable spaces containing `E`.
theorem generateFrom_isLeast {Ω : Type u} (E : Set (Set Ω)) :
    IsLeast {m : MeasurableSpace Ω | E ⊆ {s | @MeasurableSet Ω m s}}
      (MeasurableSpace.generateFrom E) := by
  refine ⟨?_, ?_⟩
  · -- Every generator set is measurable in the σ-algebra generated from `E`.
    intro s hs
    exact MeasurableSpace.measurableSet_generateFrom hs
  · -- Any measurable space containing `E` lies above `MeasurableSpace.generateFrom E`.
    intro m hm
    exact MeasurableSpace.generateFrom_le hm

/-- The Dynkin system generated by `E` is the least λ-system on `Ω` containing `E`. -/
-- Proof sketch: membership of each generator is given by the `basic` constructor for
-- `MeasurableSpace.DynkinSystem.generate`, and minimality follows from
-- `MeasurableSpace.DynkinSystem.generate_le`.
theorem dynkinSystem_generate_isLeast {Ω : Type u} (E : Set (Set Ω)) :
    IsLeast {d : MeasurableSpace.DynkinSystem Ω | E ⊆ d.Has}
      (MeasurableSpace.DynkinSystem.generate E) := by
  refine ⟨?_, ?_⟩
  · -- Every generator set belongs to the Dynkin system generated from `E`.
    intro s hs
    exact MeasurableSpace.DynkinSystem.GenerateHas.basic s hs
  · -- Any Dynkin system containing `E` lies above `DynkinSystem.generate E`.
    intro d hd
    exact MeasurableSpace.DynkinSystem.generate_le (d := d) hd
