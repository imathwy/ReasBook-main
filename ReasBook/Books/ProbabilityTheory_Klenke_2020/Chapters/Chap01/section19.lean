/-! ### Theorem_1_19 (from Items/Chap01) -/
open Set MeasureTheory MeasurableSpace

universe u

variable {Ω : Type u}

-- Proof sketch: Mathlib's `DynkinSystem.generateFrom_eq` identifies the measurable space
-- `generateFrom E` with the measurable space obtained from the generated Dynkin system of `E`.
-- Applying `DynkinSystem.ofMeasurableSpace` to that equality and then simplifying with
-- `DynkinSystem.ofMeasurableSpace_toMeasurableSpace` yields the desired equality of Dynkin systems.
/-- Theorem 1.19: Dynkin's `π`-`λ` theorem states that if `E` is a `π`-system, then the
Dynkin system generated by `E` coincides with the `σ`-algebra generated by `E`. -/
theorem dynkinSystem_generate_eq_of_isPiSystem {E : Set (Set Ω)} (hE : IsPiSystem E) :
    DynkinSystem.ofMeasurableSpace (generateFrom E) = DynkinSystem.generate E := by
  -- Transport mathlib's measurable-space π-λ theorem through `ofMeasurableSpace`.
  simpa [DynkinSystem.ofMeasurableSpace_toMeasurableSpace] using
    congrArg DynkinSystem.ofMeasurableSpace (DynkinSystem.generateFrom_eq hE)
