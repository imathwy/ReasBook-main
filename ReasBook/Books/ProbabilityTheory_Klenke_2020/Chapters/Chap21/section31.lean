/-! ### Theorem_21_31 (from Items/Chap21) -/
open MeasureTheory
open scoped Topology NNReal

noncomputable section

/-- The measurable space on the continuous path space is its Borel `σ`-algebra. -/
local instance : MeasurableSpace BrownianPathSpace := borel _

/-- The continuous path space carries its canonical Borel-space structure. -/
local instance : BorelSpace BrownianPathSpace := ⟨rfl⟩

-- Proof sketch: the compact-open topology on `C(NNReal, ℝ)` is the path-space topology used in
-- the chapter, and its Borel `σ`-algebra is generated by the time-evaluation maps. This
-- identifies the Borel `σ`-algebra with the restriction of the product Borel `σ`-algebra.
/-- Theorem 21.31: on the continuous path space `C(ℝ≥0, ℝ)`, the restriction of the product
Borel `σ`-algebra from `ℝ≥0 → ℝ` agrees with the Borel `σ`-algebra of the path-space topology. -/
theorem continuousPathSpace_comap_pi_eq_borel :
    MeasurableSpace.comap ((↑) : BrownianPathSpace → NNReal → ℝ) MeasurableSpace.pi =
      borel BrownianPathSpace := sorry
