/-! ### Example_9_31 (from Items/Chap09) -/
open MeasureTheory ProbabilityTheory
open scoped BigOperators ProbabilityTheory

universe u

variable {Ω : Type u} [MeasurableSpace Ω]

/- The source-facing factor process generating the textbook filtration
`σ(Y₁, ..., Y_t)`, written in Lean by adjoining the constant `1` at time `0`. -/
def multiplicativeFactorProcess (Y : ℕ → Ω → ℝ) : ℕ → Ω → ℝ
  | 0 => fun _ ↦ 1
  | n + 1 => Y (n + 1)

/-- If the factors `Y₁, Y₂, ...` are measurable, then the source-facing factor process
`1, Y₁, Y₂, ...` is strongly measurable. -/
theorem stronglyMeasurable_multiplicativeFactorProcess {Y : ℕ → Ω → ℝ}
    (hY : ∀ n, Measurable (Y (n + 1))) :
    ∀ n, StronglyMeasurable (multiplicativeFactorProcess Y n)
  | 0 => by simpa [multiplicativeFactorProcess] using stronglyMeasurable_const
  | n + 1 => by
      simpa [multiplicativeFactorProcess] using (hY n).stronglyMeasurable

-- Proof sketch: induct on `n`; the recursive step rewrites `X (n + 1)` using
-- `multiplicativeProcess_succ` and then expands the product over `Finset.range (n + 1)`.
/-- The multiplicative process agrees with the textbook formula
`X_t = ∏_{s=1}^t Y_s`, encoded in Lean as a product over `Finset.range t`. -/
theorem multiplicativeProcess_eq_prod {Y : ℕ → Ω → ℝ} (n : ℕ) (ω : Ω) :
    multiplicativeProcess Y n ω =
      Finset.prod (Finset.range n) (fun s ↦ Y (s + 1) ω) := sorry

-- Proof sketch: derive `Integrable (Y (n + 1)) μ` from `μ[Y (n + 1)] = 1` via
-- `MeasureTheory.integrable_of_integral_eq_one`, observe that the product process is adapted to
-- the natural filtration generated by `1, Y_1, ..., Y_t`, and then apply
-- `MeasureTheory.martingale_nat` to the one-step identity
-- `μ[X (n + 1) | 𝓕 n] = X n * μ[Y (n + 1) | 𝓕 n] = X n`.
/-- Example 9.31: if `(Y_{n+1})` is an independent sequence of real random variables with
expectation `1` (hence integrable), then the multiplicative partial-product process
`X_t = ∏_{s=1}^t Y_s` is a martingale with respect to the filtration generated by
`Y_1, ..., Y_t`. -/
theorem multiplicativeProcess_martingale_of_iIndepFun_mean_one
    {μ : Measure Ω} [IsProbabilityMeasure μ] {Y : ℕ → Ω → ℝ}
    (hY_meas : ∀ n, Measurable (Y (n + 1)))
    (hY_indep : iIndepFun (fun n ↦ Y (n + 1)) μ)
    (hY_mean_one : ∀ n, μ[(Y (n + 1))] = 1) :
    Martingale (multiplicativeProcess Y)
      (Filtration.natural (multiplicativeFactorProcess Y)
        (stronglyMeasurable_multiplicativeFactorProcess hY_meas))
      μ := sorry
