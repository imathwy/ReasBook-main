/-! ### Theorem_24_2 (from Items/Chap24) -/
universe u

open MeasureTheory
open scoped CompactlySupported

variable {E : Type u} [PseudoMetricSpace E] [MeasurableSpace E]

namespace BoundedlyFiniteMeasure

/-- Integration against a compactly supported continuous real-valued test function. -/
noncomputable def vagueIntegral (f : C_c(E, ℝ)) : BoundedlyFiniteMeasure E → ℝ :=
  fun μ ↦ ∫ x, f x ∂(μ : Measure E)

/-- Integration against a compactly supported continuous nonnegative test function, viewed in
`ℝ`. -/
noncomputable def nonnegativeVagueIntegral (f : C_c(E, NNReal)) : BoundedlyFiniteMeasure E → ℝ :=
  fun μ ↦ ∫ x, (f x : ℝ) ∂(μ : Measure E)

@[simp] theorem vagueIntegral_apply (f : C_c(E, ℝ)) (μ : BoundedlyFiniteMeasure E) :
    vagueIntegral f μ = ∫ x, f x ∂(μ : Measure E) :=
  rfl

@[simp] theorem nonnegativeVagueIntegral_apply (f : C_c(E, NNReal))
    (μ : BoundedlyFiniteMeasure E) :
    nonnegativeVagueIntegral f μ = ∫ x, (f x : ℝ) ∂(μ : Measure E) :=
  rfl

/-- The vague topology on boundedly finite measures is the initial topology generated by
compactly supported continuous real-valued test integrals. -/
@[reducible] noncomputable def vagueTopology (E : Type u) [PseudoMetricSpace E] [MeasurableSpace E] :
    TopologicalSpace (BoundedlyFiniteMeasure E) :=
  ⨅ f : C_c(E, ℝ),
    TopologicalSpace.induced (vagueIntegral f) inferInstance

noncomputable instance instTopologicalSpace : TopologicalSpace (BoundedlyFiniteMeasure E) :=
  vagueTopology E

end BoundedlyFiniteMeasure

variable {E : Type u} [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E]
  [LocallyCompactSpace E]

/-- The sigma-algebra generated by the vague integral maps `μ ↦ ∫ f dμ` for all compactly
supported continuous real-valued test functions `f : C_c(E, ℝ)`. -/
noncomputable abbrev compactlySupportedContinuousIntegralMeasurableSpace (E : Type u)
    [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E] [LocallyCompactSpace E] :
    MeasurableSpace (BoundedlyFiniteMeasure E) :=
  ⨆ f : C_c(E, ℝ),
    MeasurableSpace.comap (BoundedlyFiniteMeasure.vagueIntegral f) (borel ℝ)

/-- The sigma-algebra generated by the vague integral maps `μ ↦ ∫ f dμ` for all nonnegative
compactly supported continuous test functions `f : C_c(E, NNReal)`. -/
noncomputable abbrev nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace (E : Type u)
    [PseudoMetricSpace E] [MeasurableSpace E] [BorelSpace E] [LocallyCompactSpace E] :
    MeasurableSpace (BoundedlyFiniteMeasure E) :=
  ⨆ f : C_c(E, NNReal),
    MeasurableSpace.comap (BoundedlyFiniteMeasure.nonnegativeVagueIntegral f) (borel ℝ)

-- Proof sketch: unfold `BoundedlyFiniteMeasure.vagueTopology` as the infimum of the induced
-- topologies from the maps
-- `μ ↦ ∫ f dμ`, use `borel_comap` for each induced topology, and identify the Borel sigma-algebra
-- of the initial topology with the sigma-algebra generated by those coordinate maps.
/-- Theorem 24.2: the sigma-algebra `𝕄` on boundedly finite measures agrees with the Borel
sigma-algebra of the vague topology. -/
theorem randomMeasureMeasurableSpace_eq_borel_vagueTopology :
    randomMeasureMeasurableSpace E =
      borel (BoundedlyFiniteMeasure E) := sorry

-- Proof sketch: unfold `vagueTopology`; its subbasic open sets are inverse images of open subsets
-- of `ℝ` under the maps `μ ↦ ∫ f dμ`, so the Borel sigma-algebra is exactly the sigma-algebra
-- generated by these real-valued coordinate maps.
/-- The Borel sigma-algebra of the vague topology is generated by the real-valued vague integral
maps indexed by `C_c(E, ℝ)`. -/
theorem borel_vagueTopology_eq_compactlySupportedContinuousIntegralMeasurableSpace :
    borel (BoundedlyFiniteMeasure E) =
      compactlySupportedContinuousIntegralMeasurableSpace E := sorry

-- Proof sketch: every real-valued compactly supported continuous function is the difference of two
-- nonnegative compactly supported continuous functions, so the sigma-algebra generated by all
-- real-valued test integrals agrees with the one generated by the nonnegative tests alone.
/-- The sigma-algebra generated by all compactly supported continuous real test integrals agrees
with the one generated by the nonnegative test integrals. -/
theorem compactlySupportedContinuousIntegralMeasurableSpace_eq_nonnegative :
    compactlySupportedContinuousIntegralMeasurableSpace E =
      nonnegativeCompactlySupportedContinuousIntegralMeasurableSpace E := sorry

/-! ### Exercise_24_2_3 (from Items/Chap24) -/
open MeasureTheory

noncomputable section

namespace ProbabilityTheory

/-- The negative-binomial point-mass formula with shape parameter `r` and success parameter `p`.
-/
noncomputable def negativeBinomialMass (r p : ℝ) (k : ℕ) : ℝ :=
  Ring.choose (-r) k * (-1 : ℝ) ^ k * p ^ r * (1 - p) ^ k

-- Proof sketch: sum the generalized-binomial series for `negativeBinomialMass r p` and then
-- coerce the resulting real-valued normalization identity to `ENNReal`.
/-- The negative-binomial point masses sum to `1` as an `ENNReal` series for admissible
parameters. -/
theorem negativeBinomialMass_hasSum_ennreal
    (r p : ℝ) (hr : 0 < r) (hp : 0 < p) (hp_le_one : p ≤ 1) :
    HasSum (fun k : ℕ ↦ ENNReal.ofReal (negativeBinomialMass r p k)) 1 := sorry

/-- The negative-binomial law on `ℕ` with shape parameter `r` and success parameter `p ∈ (0,1]`,
realized as a probability mass function. -/
noncomputable def negativeBinomialPMF
    (r p : ℝ) (hr : 0 < r) (hp : 0 < p) (hp_le_one : p ≤ 1) : PMF ℕ :=
  ⟨fun k ↦ ENNReal.ofReal (negativeBinomialMass r p k),
    negativeBinomialMass_hasSum_ennreal r p hr hp hp_le_one⟩

-- Proof sketch: unfold `negativeBinomialPMF`; its values are defined directly from
-- `negativeBinomialMass`.
/-- The values of `negativeBinomialPMF` are given by the textbook point-mass formula. -/
theorem negativeBinomialPMF_apply
    (r p : ℝ) (hr : 0 < r) (hp : 0 < p) (hp_le_one : p ≤ 1) (k : ℕ) :
    negativeBinomialPMF r p hr hp hp_le_one k =
      ENNReal.ofReal (negativeBinomialMass r p k) := sorry

/-- The negative-binomial law with parameters `r` and `p`, viewed as a measure on `ℕ`. -/
noncomputable abbrev negativeBinomialMeasure
    (r p : ℝ) (hr : 0 < r) (hp : 0 < p) (hp_le_one : p ≤ 1) : Measure ℕ :=
  (negativeBinomialPMF r p hr hp hp_le_one).toMeasure

-- Proof sketch: necessity comes from stochastic domination of the upper tails together with the
-- atom at `0`, which equals `pᵢ ^ rᵢ`. For sufficiency, one can use the compound-Poisson
-- representation of negative-binomial laws together with the Chapter 24 stochastic-order
-- criterion for subordinators, or equivalently construct the standard monotone coupling.
/-- Exercise 24.2.3: the negative-binomial law `b^-_{r₁,p₁}` is stochastically dominated by
`b^-_{r₂,p₂}` if and only if `p₁ ≥ p₂` and `p₁ ^ r₁ ≥ p₂ ^ r₂`. -/
theorem negativeBinomial_stochasticLE_iff
    (r₁ r₂ p₁ p₂ : ℝ)
    (hr₁ : 0 < r₁) (hr₂ : 0 < r₂)
    (hp₁ : 0 < p₁) (hp₂ : 0 < p₂)
    (hp₁_le_one : p₁ ≤ 1) (hp₂_le_one : p₂ ≤ 1) :
    StochasticLE
        (ProbabilityMeasure.toFin1Real
          (⟨negativeBinomialMeasure r₁ p₁ hr₁ hp₁ hp₁_le_one, inferInstance⟩ :
            ProbabilityMeasure ℕ))
        (ProbabilityMeasure.toFin1Real
          (⟨negativeBinomialMeasure r₂ p₂ hr₂ hp₂ hp₂_le_one, inferInstance⟩ :
            ProbabilityMeasure ℕ)) ↔
      p₁ ≥ p₂ ∧ p₁ ^ r₁ ≥ p₂ ^ r₂ := sorry

end ProbabilityTheory
