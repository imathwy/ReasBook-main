import Mathlib
import ProbabilityTheory_Klenke_2020.Chap22.Theorem_22_5

-- Declarations for this item will be appended below by the statement pipeline.

open MeasureTheory ProbabilityTheory
open scoped NNReal ProbabilityTheory

universe u

namespace ProbabilityTheory

variable {Ω : Type u} [MeasurableSpace Ω]

/-- If the auxiliary variable in a Skorohod embedding is constant, then the embedding time is a
stopping time for the natural filtration of the Brownian motion. -/
theorem stopping_natural
    {law : ProbabilityMeasure Ω} {B : NNReal → Ω → ℝ} {τ : Ω → NNReal}
    (hB : IsBrownianMotion (law : Measure Ω) B)
    (hτ : IsStoppingTime (processFiltration (fun s ω ↦ ((0 : ℝ), B s ω)))
      (fun ω ↦ (τ ω : ENNReal))) :
    IsStoppingTime (Filtration.natural B hB.stronglyMeasurable) (fun ω ↦ (τ ω : ENNReal)) := sorry

-- Proof sketch: start from Skorohod's embedding and replace the auxiliary σ-algebra
-- `σ(Ξ, (B_s)_{s ≤ t})` by the sharper construction mentioned in the text, producing a stopping
-- time for the natural filtration generated by `B`. The stopped-law and expected-time
-- conclusions are the same as in Theorem 22.5; Remark 22.6 only sharpens the filtration of the
-- stopping time by eliminating the auxiliary random variable.
/-- Remark 22.6: every centered square-integrable real probability law admits a Skorohod embedding
with auxiliary variable `0`, so the embedding time may be chosen with respect to the natural
filtration generated by the Brownian motion. -/
theorem exists_skorohod_embedding_in_natural_filtration
    (μ : ProbabilityMeasure ℝ)
    (hμ_mean_zero : ∫ x, x ∂(μ : Measure ℝ) = 0)
    (hμ_memLp : MemLp id 2 (μ : Measure ℝ)) :
    ∃ (space : Type u) (_mSpace : MeasurableSpace space) (law : ProbabilityMeasure space)
      (B : NNReal → space → ℝ) (hB : IsBrownianMotion (law : Measure space) B)
      (τ : space → NNReal),
      IsStoppingTime
        (Filtration.natural B hB.stronglyMeasurable)
        (fun ω ↦ (τ ω : ENNReal)) ∧
      HasLaw (stoppedValue B (fun ω ↦ (τ ω : ENNReal))) (μ : Measure ℝ)
        (law : Measure space) ∧
      (law : Measure space)[fun ω ↦ (τ ω : ℝ)] =
        Var[id; (μ : Measure ℝ)] := sorry

end ProbabilityTheory
