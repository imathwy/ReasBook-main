import Mathlib
import Mathlib.Dynamics.Ergodic.Ergodic
import ProbabilityTheory_Klenke_2020.Items.Chap20.Definition_20_5

open MeasureTheory ProbabilityTheory
open scoped Pointwise

variable (n r : ℕ) [NeZero n]

/-- Example 20.8: `A_i = i + ⟨r⟩` is the coset of the additive subgroup of `ZMod n` generated by
`r` through the point `i`. -/
def A_i (i : ZMod n) : Set (ZMod n) :=
  {x | x - i ∈ AddSubgroup.zmultiples (r : ZMod n)}

/-- This rewrites `A_i` in the textbook coset form `i + ⟨r⟩`. -/
theorem A_i_eq_vadd_zmultiples (i : ZMod n) :
    A_i n r i = i +ᵥ ((AddSubgroup.zmultiples (r : ZMod n)) : Set (ZMod n)) := sorry

/-- The sets `A_i` are exactly the fibers of the quotient map modulo the subgroup generated by
`r`. -/
theorem A_i_eq_fiber_quotientMk (i : ZMod n) :
    A_i n r i = {x : ZMod n | (x : ZMod n ⧸ AddSubgroup.zmultiples (r : ZMod n)) = i} := sorry

/-- Two sets `A_i` and `A_j` agree exactly when `i` and `j` define the same class modulo the
subgroup generated by `r`. -/
theorem A_i_eq_A_j_iff (i j : ZMod n) :
    A_i n r i = A_i n r j ↔
      (i : ZMod n ⧸ AddSubgroup.zmultiples (r : ZMod n)) = j := sorry

/-- Distinct quotient classes give disjoint cosets `A_i`. -/
theorem A_i_disjoint_of_ne (i j : ZMod n)
    (hij : (i : ZMod n ⧸ AddSubgroup.zmultiples (r : ZMod n)) ≠ j) :
    Disjoint (A_i n r i) (A_i n r j) := sorry

/-- Every invariant set for translation by `r` is a union of some of the cosets `A_i`. -/
theorem is_invariant_event_iff_eq_iUnion_A_i (A : Set (ZMod n)) :
    is_invariant_event ((· + (r : ZMod n)) : ZMod n → ZMod n) A ↔
      ∃ s : Set (ZMod n), A = ⋃ i ∈ s, A_i n r i := sorry

/-- The subgroup generated by `r` is all of `ZMod n` exactly when `r` and `n` are coprime. -/
theorem zmultiples_eq_top_iff_coprime :
    AddSubgroup.zmultiples (r : ZMod n) = ⊤ ↔ Nat.Coprime r n := sorry

-- Proof sketch: translation by a fixed residue class is a permutation of the finite set `ZMod n`,
-- so it preserves the uniform measure.
/-- Translation on `ZMod n` preserves the uniform probability measure. -/
theorem zmodTranslation_measurePreserving :
    MeasurePreserving ((· + (r : ZMod n)) : ZMod n → ZMod n)
      (uniformOn (Set.univ : Set (ZMod n)))
      (uniformOn (Set.univ : Set (ZMod n))) := sorry

-- Proof sketch: combine the source-facing decomposition of invariant sets into the cosets `A_i`
-- with the criterion `AddSubgroup.zmultiples (r : ZMod n) = ⊤ ↔ Nat.Coprime r n`.
/-- Example 20.8: for the translation `x ↦ x + r` on `ZMod n` with the uniform probability
measure, ergodicity is equivalent to `r` being coprime to `n`. -/
theorem zmodTranslation_ergodic_iff_coprime :
    Ergodic ((· + (r : ZMod n)) : ZMod n → ZMod n)
      (uniformOn (Set.univ : Set (ZMod n))) ↔
      Nat.Coprime r n := sorry
