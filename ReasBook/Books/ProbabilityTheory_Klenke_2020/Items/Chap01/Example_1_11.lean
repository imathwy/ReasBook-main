import Mathlib
import ProbabilityTheory_Klenke_2020.Items.Chap01.Definition_1_8

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open MeasureTheory MeasurableSpace Set
open scoped MeasureTheory

/-- The two-set family consisting only of `∅` and the whole space. -/
def trivialTwoSetFamily (Ω : Type u) : Set (Set Ω) :=
  {∅, univ}

/-- The family consisting only of the empty set. -/
def emptySetFamily (Ω : Type u) : Set (Set Ω) :=
  ({∅} : Set (Set Ω))

/-- The family of countable subsets of `ℝ`. -/
def countableSubsetFamily : Set (Set ℝ) :=
  {s : Set ℝ | s.Countable}

/-- The family of right-closed bounded intervals `(a, b]` in `ℝ`. -/
def rightClosedIntervalFamily : Set (Set ℝ) :=
  {s : Set ℝ | ∃ a b : ℝ, a ≤ b ∧ s = Ioc a b}

/-- The family of finite unions of bounded intervals in `ℝ`, expressed as finite unions of bounded
order-connected sets. -/
def finiteUnionBoundedIntervalFamily : Set (Set ℝ) :=
  {s : Set ℝ |
    ∃ S : Finset (Set ℝ),
      (∀ t ∈ S, t.OrdConnected ∧ BddBelow t ∧ BddAbove t) ∧
        s = ⋃₀ (↑S : Set (Set ℝ))}

/-- The family of finite unions of arbitrary intervals in `ℝ`, expressed as finite unions of
order-connected sets. -/
def finiteUnionIntervalFamily : Set (Set ℝ) :=
  {s : Set ℝ |
    ∃ S : Finset (Set ℝ),
      (∀ t ∈ S, t.OrdConnected) ∧ s = ⋃₀ (↑S : Set (Set ℝ))}

/-- The family consisting of `∅` together with all positive-length cylinder sets in `E^ℕ`. -/
def sequenceCylinderFamily (E : Type u) : Set (Set (ℕ → E)) :=
  {s : Set (ℕ → E) |
    s = ∅ ∨
      ∃ n : ℕ, ∃ x : Fin (n + 1) → E, s = {ω | ∀ i : Fin (n + 1), ω i = x i}}

/-- The family of finite or cofinite subsets of `Ω`. -/
def finiteOrCofiniteFamily (Ω : Type u) : Set (Set Ω) :=
  {s : Set Ω | s.Finite ∨ sᶜ.Finite}

/-- The family of countable or cocountable subsets of `Ω`. -/
def countableOrCocountableFamily (Ω : Type u) : Set (Set Ω) :=
  {s : Set Ω | s.Countable ∨ sᶜ.Countable}

/-- The explicit six-set family on the four-point space `Fin 4`, corresponding to the textbook
example on `{1,2,3,4}` up to relabeling. -/
def fourPointLambdaFamily : Set (Set (Fin 4)) :=
  {∅, ({0, 1} : Set (Fin 4)), ({0, 3} : Set (Fin 4)), ({1, 2} : Set (Fin 4)),
    ({2, 3} : Set (Fin 4)), (univ : Set (Fin 4))}

-- Proof sketch: the sigma-algebra generated by `{∅, Ω}` adds no new sets.
/-- Example 1.11 (1): Item (i). The family `{∅, Ω}` is already the sigma-algebra it generates,
hence in particular a trivial algebra of sets. -/
theorem trivialTwoSetFamily_isSetSigmaAlgebra (Ω : Type u) :
    {s : Set Ω | MeasurableSet[generateFrom (trivialTwoSetFamily Ω)] s} =
      trivialTwoSetFamily Ω := sorry

-- Proof sketch: the sigma-algebra generated by the full powerset is the full powerset itself.
/-- Example 1.11 (2): Item (i). The full powerset is already the sigma-algebra it generates. -/
theorem powerset_isSetSigmaAlgebra (Ω : Type u) :
    {s : Set Ω | MeasurableSet[generateFrom (univ : Set (Set Ω))] s} = (univ : Set (Set Ω)) :=
  sorry

-- Proof sketch: check directly that `{∅}` is closed under the sigma-ring operations.
/-- Example 1.11 (3): Item (i). The family `{∅}` is a sigma-ring, hence also a ring and a
semiring of sets. -/
theorem emptySetFamily_isSetSigmaRing (Ω : Type u) :
    IsSetSigmaRing (emptySetFamily Ω) := sorry

-- Proof sketch: use the canonical sigma-ring structure on the full powerset.
/-- Example 1.11 (4): Item (i). The full powerset is a sigma-ring. -/
theorem powerset_isSetSigmaRing (Ω : Type u) :
    IsSetSigmaRing (univ : Set (Set Ω)) := sorry

-- Proof sketch: countable subsets of `ℝ` are closed under `∅`, difference, and countable union.
/-- Example 1.11 (5): Item (ii). The countable subsets of `ℝ` form a sigma-ring. -/
theorem countableSubsetFamily_isSetSigmaRing :
    IsSetSigmaRing countableSubsetFamily := sorry

-- Proof sketch: apply mathlib's semiring-of-sets result for half-open intervals `(a, b]`.
/-- Example 1.11 (6): Item (iii). The family of intervals `(a, b]` with `a ≤ b` is a semiring on
`ℝ`. -/
theorem rightClosedIntervalFamily_isSetSemiring :
    IsSetSemiring rightClosedIntervalFamily := sorry

-- Proof sketch: exhibit two right-closed intervals whose union is not another right-closed
-- interval `(a, b]`.
/-- Example 1.11 (7): Item (iii). The family of intervals `(a, b]` is not a ring of sets. -/
theorem rightClosedIntervalFamily_not_isSetRing :
    ¬ IsSetRing rightClosedIntervalFamily := sorry

-- Proof sketch: finite unions of bounded intervals are closed under `∅`, binary unions, and set
-- differences by refining interval decompositions.
/-- Example 1.11 (8): Item (iv). The finite unions of bounded intervals form a ring on `ℝ`. -/
theorem finiteUnionBoundedIntervalFamily_isSetRing :
    IsSetRing finiteUnionBoundedIntervalFamily := sorry

-- Proof sketch: the complement of a bounded interval union can contain an unbounded interval and so
-- leave the family.
/-- Example 1.11 (9): Item (iv). The finite unions of bounded intervals do not form an algebra of
sets. -/
theorem finiteUnionBoundedIntervalFamily_not_isSetAlgebra :
    ¬ IsSetAlgebra finiteUnionBoundedIntervalFamily := sorry

-- Proof sketch: finite unions of order-connected sets are closed under complement in `ℝ` and under
-- finite unions.
/-- Example 1.11 (10): Item (v). The finite unions of arbitrary intervals form an algebra on
`ℝ`. -/
theorem finiteUnionIntervalFamily_isSetAlgebra :
    IsSetAlgebra finiteUnionIntervalFamily := sorry

-- Proof sketch: the sigma-algebra generated by finite interval unions contains additional sets,
-- for instance suitable countable unions of separated intervals.
/-- Example 1.11 (11): Item (v). The finite unions of arbitrary intervals do not form a
sigma-algebra. -/
theorem finiteUnionIntervalFamily_not_isSetSigmaAlgebra :
    {s : Set ℝ | MeasurableSet[generateFrom finiteUnionIntervalFamily] s} ≠
      finiteUnionIntervalFamily := sorry

-- Proof sketch: intersections of cylinders are cylinders, and differences split into finitely many
-- disjoint finer cylinders.
/-- Example 1.11 (12): Item (vi). The cylinder family on `E^ℕ` is a semiring of sets. -/
theorem sequenceCylinderFamily_isSetSemiring {E : Type u} :
    IsSetSemiring (sequenceCylinderFamily E) := sorry

-- Proof sketch: when `E` has at least two elements, the union of two incompatible cylinders is not
-- again a cylinder or `∅`.
/-- Example 1.11 (13): Item (vi). If `E` has more than one element, the cylinder family on `E^ℕ`
is not a ring of sets. -/
theorem sequenceCylinderFamily_not_isSetRing {E : Type u} [Nontrivial E] :
    ¬ IsSetRing (sequenceCylinderFamily E) := sorry

-- Proof sketch: finite and cofinite sets are stable under complements and finite unions.
/-- Example 1.11 (14): Item (vii). The finite-or-cofinite subsets of `Ω` form an algebra of
sets. -/
theorem finiteOrCofiniteFamily_isSetAlgebra (Ω : Type u) :
    IsSetAlgebra (finiteOrCofiniteFamily Ω) := sorry

-- Proof sketch: on an infinite space, a countable union of finite sets can be infinite and
-- coinfinite, so the sigma-algebra generated by the family is strictly larger than the family.
/-- Example 1.11 (15): Item (vii). On an infinite space, the finite-or-cofinite family is not a
sigma-algebra. -/
theorem finiteOrCofiniteFamily_not_isSetSigmaAlgebra (Ω : Type u) [Infinite Ω] :
    {s : Set Ω | MeasurableSet[generateFrom (finiteOrCofiniteFamily Ω)] s} ≠
      finiteOrCofiniteFamily Ω := sorry

-- Proof sketch: countable and cocountable sets are stable under complements and countable unions,
-- so the sigma-algebra they generate adds no new sets.
/-- Example 1.11 (16): Item (viii). The countable-or-cocountable subsets of `Ω` form a
sigma-algebra. -/
theorem countableOrCocountableFamily_isSetSigmaAlgebra (Ω : Type u) :
    {s : Set Ω | MeasurableSet[generateFrom (countableOrCocountableFamily Ω)] s} =
      countableOrCocountableFamily Ω := sorry

-- Proof sketch: turn a measurable space into its canonical Dynkin system using
-- `MeasurableSpace.DynkinSystem.ofMeasurableSpace`.
/-- Example 1.11 (17): Item (ix). If a family is already the sigma-algebra it generates, then the
canonical Dynkin system attached to that generated sigma-algebra has the same underlying family. -/
theorem isSetLambdaSystem_of_isSetSigmaAlgebra {Ω : Type u} {A : Set (Set Ω)}
    (hA : {s : Set Ω | MeasurableSet[generateFrom A] s} = A) :
    {s : Set Ω | (DynkinSystem.ofMeasurableSpace (generateFrom A)).Has s} = A := sorry

-- Proof sketch: verify directly that the six-set family is fixed by the canonical λ-generation
-- operator.
/-- Example 1.11 (18): Item (x). The explicit six-set family on a four-point space is a
lambda-system. -/
theorem fourPointLambdaFamily_isSetLambdaSystem :
    {s : Set (Fin 4) | (DynkinSystem.generate fourPointLambdaFamily).Has s} =
      fourPointLambdaFamily := sorry

-- Proof sketch: one checks that this family is not closed under complements, so it cannot be an
-- algebra of sets.
/-- Example 1.11 (19): Item (x). The explicit six-set family on a four-point space is not an
algebra of sets. -/
theorem fourPointLambdaFamily_not_isSetAlgebra :
    ¬ IsSetAlgebra fourPointLambdaFamily := sorry
