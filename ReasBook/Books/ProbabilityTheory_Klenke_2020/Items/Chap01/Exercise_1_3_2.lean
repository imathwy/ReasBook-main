import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open Set
open MeasureTheory

universe u

variable {Ω : Type u}

/-- The sets relevant for Exercise 1.3.2 are those that are either countable and avoid the marked
point, or contain the marked point and have countable complement. -/
def countableOrCocountableAtPoint (ω₀ : Ω) (s : Set Ω) : Prop :=
  (s.Countable ∧ ω₀ ∉ s) ∨ (ω₀ ∈ s ∧ sᶜ.Countable)

/-- The generating family in Exercise 1.3.2: all singletons away from the distinguished point. -/
def singletonsAwayFrom (ω₀ : Ω) : Set (Set Ω) :=
  {s | ∃ ω : Ω, ω ≠ ω₀ ∧ s = ({ω} : Set Ω)}

@[simp]
theorem mem_singletonsAwayFrom_iff {ω₀ : Ω} {s : Set Ω} :
    s ∈ singletonsAwayFrom ω₀ ↔ ∃ ω : Ω, ω ≠ ω₀ ∧ s = ({ω} : Set Ω) :=
  Iff.rfl

-- Proof sketch: for the forward implication, use induction on `MeasurableSpace.generateFrom`,
-- observing that the target predicate defines a measurable space containing every singleton away
-- from `ω₀`; for the reverse implication, write countable subsets of `Ω \ {ω₀}` as countable
-- unions of generating singletons and obtain the cocountable-through-`ω₀` sets by taking
-- complements.
/-- Exercise 1.3.2 (1): a set is measurable in the `σ`-algebra generated by the singletons away
from `ω₀` if and only if it is countable and avoids `ω₀`, or it contains `ω₀` and has countable
complement. -/
theorem measurableSet_countable_or_countable_compl_at_point_iff
    (ω₀ : Ω) {s : Set Ω} :
    MeasurableSet[MeasurableSpace.generateFrom (singletonsAwayFrom ω₀)] s ↔
      countableOrCocountableAtPoint ω₀ s := by
  sorry

-- Proof sketch: use `Measure.isComplete_iff`; if `δ_{ω₀} s = 0`, then `s` cannot contain `ω₀`,
-- and an uncountable set avoiding `ω₀` would force every measurable superset to contain `ω₀`,
-- hence have Dirac mass `1`; therefore every null set is countable and avoids `ω₀`, so it is
-- measurable by construction.
/-- Exercise 1.3.2 (2): with the σ-algebra generated by the singletons away from `ω₀`, the Dirac
measure `δ_{ω₀}` is complete. -/
theorem dirac_isComplete_countable_or_countable_compl_at_point
    (ω₀ : Ω) :
    let _ : MeasurableSpace Ω :=
      MeasurableSpace.generateFrom (singletonsAwayFrom ω₀)
    (Measure.dirac ω₀).IsComplete := by
  sorry
