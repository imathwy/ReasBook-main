import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open scoped ENNReal MeasureTheory

universe u

open MeasureTheory

section

variable {Ω : Type u} {mΩ : MeasurableSpace Ω} {μ : Measure Ω} {ℱ : Filtration ℕ mΩ}
variable [SigmaFiniteFiltration μ ℱ]

/-- The filtration obtained from an increasing sequence of stopping times by taking the associated
stopping-time σ-algebras. -/
def stoppingTimeSequenceFiltration (ℱ : Filtration ℕ mΩ) (τ : ℕ → Ω → ℕ∞)
    (hτ : ∀ n, IsStoppingTime ℱ (τ n)) (hmono : Monotone τ) : Filtration ℕ mΩ :=
  { seq := fun n ↦ (hτ n).measurableSpace
    mono' := fun i j hij ↦ (hτ i).measurableSpace_mono (hτ j) (hmono hij)
    le' := fun n ↦ (hτ n).measurableSpace_le }

/-- At time `n`, the stopping-time-sequence filtration is the σ-algebra generated by `τ n`. -/
@[simp] theorem stoppingTimeSequenceFiltration_apply (τ : ℕ → Ω → ℕ∞)
    (hτ : ∀ n, IsStoppingTime ℱ (τ n)) (hmono : Monotone τ) (n : ℕ) :
    stoppingTimeSequenceFiltration ℱ τ hτ hmono n = (hτ n).measurableSpace :=
  rfl

/-- Corollary 10.12 (1): sampling a martingale along a monotone increasing sequence of bounded
stopping times yields a martingale with respect to the filtration formed by the corresponding
stopping-time σ-algebras. -/
-- Proof sketch: use optional sampling in the form of Theorem 10.11 to identify, for `m ≤ n`, the
-- conditional expectation of `X` stopped at `τ n` with respect to `𝓕_(τ m)` with `X` stopped at
-- `τ m`; monotonicity of the stopping times makes the σ-algebras `𝓕_(τ n)` into a filtration.
theorem stoppedValue_martingale_of_monotone_stopping_times {X : ℕ → Ω → ℝ}
    (hX : Martingale X ℱ μ) {τ : ℕ → Ω → ℕ∞} (hτ : ∀ n, IsStoppingTime ℱ (τ n))
    (hmono : Monotone τ) (hbdd : ∀ n, ∃ T : ℕ, ∀ ω, τ n ω ≤ T) :
    Martingale (fun n ↦ stoppedValue X (τ n)) (stoppingTimeSequenceFiltration ℱ τ hτ hmono) μ :=
  sorry

/-- Corollary 10.12 (2): sampling a submartingale along a monotone increasing sequence of bounded
stopping times yields a submartingale with respect to the filtration formed by the corresponding
stopping-time σ-algebras. -/
-- Proof sketch: apply Theorem 10.11 to the bounded stopping times `τ m ≤ τ n` to obtain the
-- conditional-expectation inequality for the sampled process, and use the monotonicity of `τ` to
-- view the stopping-time σ-algebras as an increasing filtration.
theorem stoppedValue_submartingale_of_monotone_stopping_times {X : ℕ → Ω → ℝ}
    (hX : Submartingale X ℱ μ) {τ : ℕ → Ω → ℕ∞} (hτ : ∀ n, IsStoppingTime ℱ (τ n))
    (hmono : Monotone τ) (hbdd : ∀ n, ∃ T : ℕ, ∀ ω, τ n ω ≤ T) :
    Submartingale (fun n ↦ stoppedValue X (τ n))
      (stoppingTimeSequenceFiltration ℱ τ hτ hmono) μ :=
  sorry

end
