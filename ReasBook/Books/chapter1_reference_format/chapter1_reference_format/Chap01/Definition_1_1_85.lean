import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

section

variable {G : Type u} [Group G]

open Subgroup

/- Definition 1.1.85: for a subset `A` of a group `G`, the subgroup generated by `A` is the least
subgroup of `G` containing `A`; in mathlib this canonical owner is `Subgroup.closure`. A group
generated by one element is expressed by `IsCyclic G`, and for finite groups this matches the
textbook notion of a cyclic group. -/
#check (closure : Set G → Subgroup G)

/-- A group is generated by a single element exactly when it is cyclic in mathlib's sense; for
finite groups this is the textbook notion of a cyclic group. -/
-- Proof sketch: rewrite `closure ({g} : Set G)` as `zpowers g` using `zpowers_eq_closure`, then
-- apply `isCyclic_iff_exists_zpowers_eq_top`.
theorem isCyclic_iff_exists_closure_singleton_eq_top :
    IsCyclic G ↔ ∃ g : G, closure ({g} : Set G) = ⊤ := by
  simpa [zpowers_eq_closure] using
    (isCyclic_iff_exists_zpowers_eq_top : IsCyclic G ↔ ∃ g : G, zpowers g = ⊤)

end
