import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

open scoped NNReal

/- Theorem 1.2.21: the product formula on `ℚ` is the specialization of the canonical number-field
owner theorem `NumberField.prod_abs_eq_one` to `ℚ`. At the core/canonical layer, the product runs
over the infinite and finite places of `ℚ`. -/
#check
  (NumberField.prod_abs_eq_one :
    ∀ {x : ℚ}, x ≠ 0 →
      (∏ w : NumberField.InfinitePlace ℚ, w x ^ w.mult) *
        ∏ᶠ w : NumberField.FinitePlace ℚ, w x = 1)

-- Proof sketch: start from `NumberField.prod_abs_eq_one` for `ℚ`. The unique infinite place gives
-- the usual absolute value by `Rat.infinitePlace_apply`, and the finite-place factor can be
-- transported along `NumberField.FinitePlace.equivHeightOneSpectrum` and
-- `Rat.HeightOneSpectrum.primesEquiv` to a `finprod` over primes. This keeps the source-facing
-- product-over-primes formulation while avoiding numerator/denominator support bookkeeping in the
-- main theorem surface.
/-- Helper for Theorem 1.2.21: the finite place attached to a height-one prime of `𝓞 ℚ` evaluates
to the `p`-adic norm at the corresponding prime `p`. -/
lemma rat_finite_place_apply_eq_padic_norm
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) (x : ℚ) :
    ((NumberField.FinitePlace.equivHeightOneSpectrum (K := ℚ)).symm v) x =
      (padicNorm (Rat.HeightOneSpectrum.primesEquiv v) x : ℝ) := by
  -- Rewrite the finite place as the canonical `v`-adic absolute value on `ℚ`.
  rw [NumberField.FinitePlace.equivHeightOneSpectrum_symm_apply,
    NumberField.FinitePlace.norm_embedding]
  -- Route correction: stay on `ℚ` and normalize the source absolute value directly,
  -- instead of going through the completion equivalence.
  let p : Nat.Primes := Rat.HeightOneSpectrum.primesEquiv v
  let _ : Fact p.1.Prime := ⟨p.2⟩
  -- First identify the height-one ideal with the principal ideal generated by its prime.
  have hspan :
      v.asIdeal = Ideal.span {(p : NumberField.RingOfIntegers ℚ)} := by
    let e := Rat.IsIntegralClosure.intEquiv (NumberField.RingOfIntegers ℚ)
    have h := Rat.HeightOneSpectrum.span_natGenerator
      (R := NumberField.RingOfIntegers ℚ) v
    have h' := congrArg (Ideal.comap e) h
    rw [Ideal.comap_map_of_bijective e e.bijective] at h'
    apply Ideal.ext
    intro y
    rw [← h']
    constructor
    · intro hy
      rw [Ideal.mem_comap, Ideal.mem_span_singleton] at hy
      rw [Ideal.mem_span_singleton]
      rcases hy with ⟨z, hz⟩
      refine ⟨e.symm z, ?_⟩
      apply_fun e
      simpa [e, p, Rat.HeightOneSpectrum.primesEquiv] using hz
    · intro hy
      rw [Ideal.mem_comap, Ideal.mem_span_singleton]
      rw [Ideal.mem_span_singleton] at hy
      rcases hy with ⟨z, hz⟩
      refine ⟨e z, ?_⟩
      simpa [e, p, Rat.HeightOneSpectrum.primesEquiv] using congrArg e hz
  -- Then compute the norm of this ideal, which is the underlying prime number.
  have habs : Ideal.absNorm v.asIdeal = (p : ℕ) := by
    rw [hspan, Ideal.absNorm_span_singleton]
    let e := Rat.IsIntegralClosure.intEquiv (NumberField.RingOfIntegers ℚ)
    have hnorm :
        Algebra.norm ℤ ((p : ℕ) : NumberField.RingOfIntegers ℚ) =
          Algebra.norm ℤ (e (((p : ℕ) : NumberField.RingOfIntegers ℚ))) := by
      simpa [e] using
        (Algebra.norm_eq_of_equiv_equiv
          (A₁ := ℤ) (B₁ := NumberField.RingOfIntegers ℚ)
          (A₂ := ℤ) (B₂ := ℤ) (RingEquiv.refl ℤ) e
          (by
            ext z
            simp [e])
          (((p : ℕ) : NumberField.RingOfIntegers ℚ)))
    rw [hnorm]
    norm_num [e]
  -- This pins down the `v`-adic absolute value at the distinguished prime generator.
  have hprime_value :
      NumberField.HeightOneSpectrum.adicAbv ℚ v (p : ℚ) = ((p : ℝ))⁻¹ := by
    rw [NumberField.HeightOneSpectrum.adicAbv_def]
    have hcoe :
        (IsDedekindDomain.HeightOneSpectrum.valuation ℚ v) (p : ℚ) =
          v.intValuation ((p : ℕ) : NumberField.RingOfIntegers ℚ) := by
      simpa using
        (IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap (K := ℚ) v
          (((p : ℕ) : NumberField.RingOfIntegers ℚ)))
    rw [hcoe]
    have hval :
        v.intValuation ((p : ℕ) : NumberField.RingOfIntegers ℚ) = WithZero.exp (-1 : ℤ) := by
      refine IsDedekindDomain.HeightOneSpectrum.intValuation_singleton v ?_ hspan
      exact_mod_cast p.2.ne_zero
    have hpow :
        ((WithZeroMulInt.toNNReal (NumberField.HeightOneSpectrum.absNorm_ne_zero v)
            (WithZero.exp (-1 : ℤ)) : ℝ≥0) : ℝ) = ((p : ℝ))⁻¹ := by
      rw [WithZeroMulInt.toNNReal_neg_apply (hx := WithZero.exp_ne_zero)]
      change (((Ideal.absNorm v.asIdeal : ℝ≥0) ^ (-1 : ℤ) : ℝ≥0) : ℝ) = ((p : ℝ))⁻¹
      simp [habs]
    simpa [hval] using hpow
  -- The prime generator has absolute value strictly less than one, so the absolute value is
  -- nontrivial and Ostrowski identifies it with a unique `q`-adic absolute value.
  have hp_lt_one : NumberField.HeightOneSpectrum.adicAbv ℚ v (p : ℚ) < 1 := by
    rw [hprime_value]
    exact inv_lt_one_iff₀.mpr (Or.inr (by exact_mod_cast p.2.one_lt))
  have hv_nontriv : (NumberField.HeightOneSpectrum.adicAbv ℚ v).IsNontrivial := by
    by_contra hv_triv
    have hp_ne_zero : (p : ℚ) ≠ 0 := by
      exact_mod_cast p.2.ne_zero
    have h_eq_one := AbsoluteValue.not_isNontrivial_apply hv_triv hp_ne_zero
    rw [h_eq_one] at hp_lt_one
    norm_num at hp_lt_one
  have hbdd : ∀ n : ℕ, NumberField.HeightOneSpectrum.adicAbv ℚ v (n : ℚ) ≤ 1 := by
    intro n
    simpa using
      (IsDedekindDomain.HeightOneSpectrum.adicAbv_coe_le_one v
        (NumberField.HeightOneSpectrum.one_lt_absNorm_nnreal v)
        ((n : ℕ) : NumberField.RingOfIntegers ℚ))
  obtain ⟨q, ⟨hq_prime, hq_equiv⟩, _⟩ :=
    Rat.AbsoluteValue.equiv_padic_of_bounded hv_nontriv hbdd
  -- The unique `q` is forced to be `p` because both absolute values are `< 1` exactly there.
  have hqdvd : q ∣ (p : ℕ) := by
    have hlt_real : Rat.AbsoluteValue.padic q (p : ℚ) < 1 :=
      (hq_equiv.lt_one_iff (x := (p : ℚ))).mp hp_lt_one
    have hlt_rat : padicNorm q (p : ℚ) < 1 := by
      exact_mod_cast
        (show ((padicNorm q (p : ℚ) : ℝ) < 1) by
          simpa [Rat.AbsoluteValue.padic_eq_padicNorm] using hlt_real)
    simpa using (padicNorm.nat_lt_one_iff (p := q) (p : ℕ)).mp hlt_rat
  have hq : q = (p : ℕ) := by
    exact ((Nat.Prime.dvd_iff_eq p.2 hq_prime.1.ne_one).mp hqdvd).symm
  have hp_equiv :
      (NumberField.HeightOneSpectrum.adicAbv ℚ v).IsEquiv (Rat.AbsoluteValue.padic (p : ℕ)) := by
    simpa [hq] using hq_equiv
  -- Finally, compare both equivalent absolute values at `p` to force the exponent to be `1`.
  obtain ⟨c, hc, hc_eq⟩ := AbsoluteValue.isEquiv_iff_exists_rpow_eq.mp hp_equiv
  have hc_one : c = 1 := by
    have h_at_p := congrFun hc_eq (p : ℚ)
    have hpadic_p : Rat.AbsoluteValue.padic (p : ℕ) (p : ℚ) = ((p : ℝ))⁻¹ := by
      rw [Rat.AbsoluteValue.padic_eq_padicNorm]
      have hpadicQ : padicNorm (p : ℕ) (p : ℚ) = ((p : ℚ))⁻¹ := by
        exact padicNorm.padicNorm_p_of_prime (p := (p : ℕ))
      norm_num [hpadicQ]
    rw [hprime_value, hpadic_p] at h_at_p
    have hp_inv_pos : 0 < ((p : ℝ)⁻¹) := by
      exact inv_pos.mpr (by exact_mod_cast p.2.pos)
    have hlog := congrArg Real.log h_at_p
    rw [Real.log_rpow hp_inv_pos] at hlog
    have hneq : Real.log ((p : ℝ)⁻¹) ≠ 0 := by
      rw [Real.log_inv]
      exact neg_ne_zero.mpr (ne_of_gt (Real.log_pos (by exact_mod_cast p.2.one_lt)))
    exact mul_right_cancel₀ hneq (by simpa using hlog)
  have hpointwise :
      NumberField.HeightOneSpectrum.adicAbv ℚ v x = Rat.AbsoluteValue.padic (p : ℕ) x := by
    have hx := congrFun hc_eq x
    simpa [hc_one] using hx
  simpa [Rat.AbsoluteValue.padic_eq_padicNorm, p] using hpointwise

/-- Helper for Theorem 1.2.21: the finite-place factor in the canonical product formula on `ℚ`
reindexes to the source-facing `finprod` over prime numbers. -/
lemma rat_finprod_finite_places_eq_finprod_primes (x : ℚ) :
    (∏ᶠ w : NumberField.FinitePlace ℚ, w x) = ∏ᶠ p : Nat.Primes, (padicNorm p x : ℝ) := by
  -- First pass to height-one primes, then pass from height-one primes to ordinary primes.
  calc
    ∏ᶠ w : NumberField.FinitePlace ℚ, w x
        = ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ),
            ((NumberField.FinitePlace.equivHeightOneSpectrum (K := ℚ)).symm v) x := by
          simpa using
            (finprod_comp_equiv (NumberField.FinitePlace.equivHeightOneSpectrum (K := ℚ)).symm
              (f := fun w : NumberField.FinitePlace ℚ => w x)).symm
    _ = ∏ᶠ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ),
          (padicNorm (Rat.HeightOneSpectrum.primesEquiv v) x : ℝ) := by
          refine finprod_congr ?_
          intro v
          exact rat_finite_place_apply_eq_padic_norm v x
    _ = ∏ᶠ p : Nat.Primes, (padicNorm p x : ℝ) := by
          simpa using
            (finprod_comp_equiv (Rat.HeightOneSpectrum.primesEquiv
              (R := NumberField.RingOfIntegers ℚ)) (f := fun p : Nat.Primes =>
                (padicNorm p x : ℝ)))

/-- Helper for Theorem 1.2.21: the canonical number-field product formula on `ℚ`, rewritten in
the real codomain and indexed by primes. -/
lemma rat_product_formula_real {x : ℚ} (hx : x ≠ 0) :
    (↑|x| : ℝ) * ∏ᶠ p : Nat.Primes, (padicNorm p x : ℝ) = 1 := by
  -- The infinite part is the usual absolute value, and the finite part is the prime-indexed
  -- `finprod` proved above.
  simpa [rat_finprod_finite_places_eq_finprod_primes x, Rat.infinitePlace_apply] using
    (NumberField.prod_abs_eq_one (K := ℚ) hx)

/-- Theorem 1.2.21 in source-facing form: for a nonzero rational number `x`, the usual absolute
value together with the `p`-adic norms over all primes has product `1`, viewed as a finite product
through `finprod`. -/
theorem rat_product_formula (x : ℚ) (hx : x ≠ 0) :
    |x| * ∏ᶠ p : Nat.Primes, padicNorm p x = 1 := by
  -- Cast the real-valued product formula back to `ℚ`.
  refine Rat.cast_injective (α := ℝ) ?_
  have hfinprod :
      ((∏ᶠ p : Nat.Primes, padicNorm p x : ℚ) : ℝ) =
        ∏ᶠ p : Nat.Primes, (padicNorm p x : ℝ) := by
    simpa using
      (MonoidHom.map_finprod_of_injective (g := (Rat.castHom ℝ).toMonoidHom)
        Rat.cast_injective (fun p : Nat.Primes ↦ padicNorm p x))
  -- After commuting the rational cast past the `finprod`, the real helper closes the goal.
  simpa [Rat.cast_mul, Rat.cast_abs, hfinprod] using rat_product_formula_real hx
