import Mathlib

universe u

-- Declarations for this item will be appended below by the statement pipeline.

/- Definition 1.4.46: in the polynomial principal-ideal setting, the textbook criterion that an
ideal is generated by a prime polynomial is exactly the polynomial specialization of the canonical
owner theorem `Ideal.span_singleton_prime`. -/
recall Ideal.span_singleton_prime {α : Type u} [CommSemiring α] {p : α} (hp : p ≠ 0) :
  (Ideal.span ({p} : Set α)).IsPrime ↔ Prime p
