import Mathlib
import FirstOrderMethodsOptimization_Beck_2017.FirstOrderMethodsinOptimization.Chap13.Lemma_13_19.TrajectoryCore
import FirstOrderMethodsOptimization_Beck_2017.FirstOrderMethodsinOptimization.Chap13.Lemma_13_19.SimplexWeights

-- Theorem-local exact-line-search weight helpers for Lemma 13.19.

noncomputable section

open Matrix
open scoped BigOperators

section

variable {n l : ℕ}

local notation "E" => Fin n → ℝ

variable {Q : positiveDefiniteMatrices n} {b : E} {a : Fin l → E}
variable {x : ℕ → polytope_quadratic_feasible_set a} {i : ℕ → Fin l}

local notation "d[" k "]" =>
  polytope_quadratic_conditional_gradient_direction a (x k) (i k)
local notation "λ[" k "]" =>
  polytope_quadratic_exact_line_search_ratio Q b (x k) (d[k])

section

variable {v0 : stdSimplex ℝ (Fin l)}

/-- Helper for Lemma 13.19: the barycentric weights generated by the exact-line-search trajectory
follow the textbook recursion `v^{k+1} = (1 - λ_k) v^k + λ_k e_{i_k}` with `v^0 = v0`. -/
abbrev polytope_quadratic_exact_line_search_weights
    (w0 : Fin l → ℝ) : ℕ → Fin l → ℝ :=
  simplex_vertex_weight_recursion (fun k ↦ λ[k]) i w0

local notation "v[" k "]" =>
  polytope_quadratic_exact_line_search_weights (v0 : Fin l → ℝ) k

namespace Lemma_13_19_TrajectoryWeights

/-- Helper for Lemma 13.19: the exact-line-search ratio is nonnegative along the trajectory. -/
theorem polytope_quadratic_exact_line_search_ratio_nonneg
    (htraj :
      is_polytope_quadratic_conditional_gradient_exact_line_search_trajectory Q b a x i)
    (k : ℕ) :
    0 ≤ λ[k] := by
  have hd : d[k] ≠ 0 := by
    -- A zero direction would force the directional derivative to vanish, contradicting the
    -- nonterminal branch of the exact-line-search trajectory.
    intro hd
    have hnot :
        ¬ polytope_quadratic_conditional_gradient_directional_derivative Q b a (x k) (i k) < 0 := by
      simp [polytope_quadratic_conditional_gradient_directional_derivative_eq,
        polytope_quadratic_conditional_gradient_direction_eq, hd]
    exact hnot (htraj.directional_derivative_neg k)
  have hden :
      0 < dotProduct d[k] (Q *ᵥ d[k]) := by
    -- Positive definiteness makes the curvature strictly positive on nonzero directions.
    simpa using Q.2.dotProduct_mulVec_pos hd
  have hnum :
      0 ≤ -dotProduct d[k] (Q *ᵥ (x k : E) + b) := by
    -- Negating the negative directional derivative yields a nonnegative numerator.
    have hneg := htraj.directional_derivative_neg k
    simpa [polytope_quadratic_conditional_gradient_directional_derivative_eq,
      polytope_quadratic_conditional_gradient_direction_eq] using neg_nonneg.mpr hneg.le
  rw [polytope_quadratic_exact_line_search_ratio_eq]
  exact div_nonneg hnum hden.le

/-- Helper for Lemma 13.19: the exact-line-search ratio stays strictly below `1` along the
trajectory once Assumption 13.18 makes the clip inactive. -/
theorem polytope_quadratic_exact_line_search_ratio_lt_one
    (hinit :
      IsStrictVertexSublevelInitialPoint
        (polytope_quadratic_objective Q b) a (x 0 : E) v0)
    (htraj :
      is_polytope_quadratic_conditional_gradient_exact_line_search_trajectory Q b a x i)
    (k : ℕ) :
    λ[k] < 1 := by
  -- Rewrite the clipped stepsize using the core inactive-clip identity and inherit its strict
  -- bound away from the endpoint.
  rw [← Lemma_13_19_TrajectoryCore.polytope_quadratic_exact_line_search_stepsize_eq_ratio
    (Q := Q) (b := b) (a := a) (x := x) (i := i) (v0 := v0) hinit htraj k]
  exact
    Lemma_13_19_TrajectoryCore.polytope_quadratic_exact_line_search_clipped_stepsize_lt_one
      (Q := Q) (b := b) (a := a) (x := x) (i := i) (v0 := v0) hinit htraj k

/-- Helper for Lemma 13.19: every barycentric weight vector along the exact-line-search trajectory
remains in the standard simplex. -/
theorem polytope_quadratic_exact_line_search_weights_mem_stdSimplex
    (hinit :
      IsStrictVertexSublevelInitialPoint
        (polytope_quadratic_objective Q b) a (x 0 : E) v0)
    (htraj :
      is_polytope_quadratic_conditional_gradient_exact_line_search_trajectory Q b a x i) :
    ∀ k, v[k] ∈ stdSimplex ℝ (Fin l)
  := by
  -- Route correction: the recursive simplex proof is moved to the theorem-local helper file, and
  -- this chapter-specific theorem now only supplies the exact-line-search bounds `0 ≤ λ_k < 1`.
  exact
    simplex_vertex_weight_recursion_mem_stdSimplex
      (lam := fun k ↦ λ[k]) (i := i) (v0 := v0)
      (fun k ↦
        polytope_quadratic_exact_line_search_ratio_nonneg
          (Q := Q) (b := b) (a := a) (x := x) (i := i) htraj k)
      (fun k ↦
        (polytope_quadratic_exact_line_search_ratio_lt_one
          (Q := Q) (b := b) (a := a) (x := x) (i := i) (v0 := v0) hinit htraj k).le)

/-- Helper for Lemma 13.19: every iterate is the weighted sum of the vertices with the recursively
generated barycentric coefficients `v[k]`. -/
theorem polytope_quadratic_exact_line_search_iterate_eq_weighted_sum
    (hinit :
      IsStrictVertexSublevelInitialPoint
        (polytope_quadratic_objective Q b) a (x 0 : E) v0)
    (htraj :
      is_polytope_quadratic_conditional_gradient_exact_line_search_trajectory Q b a x i) :
    ∀ k, (x k : E) = ∑ j, v[k] j • a j
  | 0 => by
      -- The initial point already comes with its barycentric representation from Assumption 13.18.
      simpa [polytope_quadratic_exact_line_search_weights] using hinit.eq_weighted_sum
  | k + 1 => by
      have hk :=
        polytope_quadratic_exact_line_search_iterate_eq_weighted_sum hinit htraj k
      calc
        (x (k + 1) : E) = (1 - λ[k]) • (x k : E) + λ[k] • a (i k) := by
          -- Route correction: rewrite the update using the already-proved inactive-clip identity.
          rw [htraj.step_eq k, polytope_quadratic_conditional_gradient_update_eq,
            Lemma_13_19_TrajectoryCore.polytope_quadratic_exact_line_search_stepsize_eq_ratio
              (Q := Q) (b := b) (a := a) (x := x) (i := i) (v0 := v0) hinit htraj k,
            polytope_quadratic_conditional_gradient_direction_eq]
          ring
        _ = (1 - λ[k]) • (∑ j, v[k] j • a j) + λ[k] • a (i k) := by
          rw [hk]
        _ = ∑ j, ((1 - λ[k]) * v[k] j) • a j + λ[k] • a (i k) := by
          rw [Finset.smul_sum]
          congr 1
          apply Finset.sum_congr rfl
          intro j hj
          simp [smul_smul, mul_comm, mul_left_comm, mul_assoc]
        _ = ∑ j, ((1 - λ[k]) * v[k] j) • a j +
              ∑ j, (λ[k] * if j = i k then 1 else 0) • a j := by
          congr 1
          simp [smul_smul]
        _ = ∑ j, (((1 - λ[k]) * v[k] j) + λ[k] * if j = i k then 1 else 0) • a j := by
          rw [← Finset.sum_add_distrib]
          apply Finset.sum_congr rfl
          intro j hj
          rw [add_smul]
        _ = ∑ j, v[k + 1] j • a j := by
          simp [polytope_quadratic_exact_line_search_weights]

/-- Helper for Lemma 13.19: every barycentric coordinate stays above the initial coordinate times
the complementary product `∏_{n<k} (1 - λ[n])`. -/
theorem polytope_quadratic_exact_line_search_weights_prod_lower_bound
    (hinit :
      IsStrictVertexSublevelInitialPoint
        (polytope_quadratic_objective Q b) a (x 0 : E) v0)
    (htraj :
      is_polytope_quadratic_conditional_gradient_exact_line_search_trajectory Q b a x i) :
    ∀ k j, (∏ n ∈ Finset.range k, (1 - λ[n])) * v0 j ≤ v[k] j
  := by
  -- Route correction: the product lower bound is now the generic recursion lemma specialized to
  -- the exact-line-search weights.
  exact
    simplex_vertex_weight_recursion_prod_lower_bound
      (lam := fun k ↦ λ[k]) (i := i) (v0 := v0)
      (fun k ↦
        polytope_quadratic_exact_line_search_ratio_nonneg
          (Q := Q) (b := b) (a := a) (x := x) (i := i) htraj k)
      (fun k ↦
        (polytope_quadratic_exact_line_search_ratio_lt_one
          (Q := Q) (b := b) (a := a) (x := x) (i := i) (v0 := v0) hinit htraj k).le)

/-- Helper for Lemma 13.19: if the exact-line-search ratios were summable, then every barycentric
coordinate would stay uniformly positive along the trajectory. -/
theorem polytope_quadratic_exact_line_search_weights_lower_bound_of_summable
    (hinit :
      IsStrictVertexSublevelInitialPoint
        (polytope_quadratic_objective Q b) a (x 0 : E) v0)
    (htraj :
      is_polytope_quadratic_conditional_gradient_exact_line_search_trajectory Q b a x i)
    (hs : Summable (fun k ↦ λ[k])) :
    ∃ δ > 0, ∀ k j, δ * v0 j ≤ v[k] j := by
  -- Route correction: the full infinite-product argument is now carried by the generic helper
  -- file, and this theorem specializes it to the exact-line-search ratios.
  exact
    simplex_vertex_weight_recursion_lower_bound_of_summable
      (lam := fun k ↦ λ[k]) (i := i) (v0 := v0)
      (fun k ↦
        polytope_quadratic_exact_line_search_ratio_nonneg
          (Q := Q) (b := b) (a := a) (x := x) (i := i) htraj k)
      (fun k ↦
        polytope_quadratic_exact_line_search_ratio_lt_one
          (Q := Q) (b := b) (a := a) (x := x) (i := i) (v0 := v0) hinit htraj k)
      hs

end Lemma_13_19_TrajectoryWeights

end

end
