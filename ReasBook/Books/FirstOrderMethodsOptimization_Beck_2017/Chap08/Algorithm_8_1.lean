import Mathlib

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open scoped Gradient

noncomputable section

section

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]

/-- Algorithm 8.1: for a differentiable objective `f` on an abstract Euclidean space `E`, the
gradient method with stepsizes `t_k` and initial point `x0` is the sequence generated by the
update `x^{k+1} = x^k - t_k ∇ f(x^k)` from equation (8.1). -/
def beckGradientMethod (f : E → ℝ) (t : ℕ → ℝ) (x0 : E) : ℕ → E
  | 0 => x0
  | k + 1 => beckGradientMethod f t x0 k - t k • ∇ f (beckGradientMethod f t x0 k)

-- Proof sketch: unfold the recursive definition of `beckGradientMethod` at `0`.
/-- The gradient-method sequence starts at the prescribed initial point. -/
theorem gradient_method_zero (f : E → ℝ) (t : ℕ → ℝ) (x0 : E) :
    beckGradientMethod f t x0 0 = x0 := by
  -- Unfold the recursive definition at the base index.
  rfl

-- Proof sketch: unfold the recursive definition of `beckGradientMethod` at `k + 1`.
/-- One step of the gradient method subtracts the current stepsize times the gradient evaluated at
the current iterate. -/
theorem gradient_method_succ (f : E → ℝ) (t : ℕ → ℝ) (x0 : E) (k : ℕ) :
    beckGradientMethod f t x0 (k + 1) =
      beckGradientMethod f t x0 k - t k • ∇ f (beckGradientMethod f t x0 k) := by
  -- Unfold the recursive definition at the successor index.
  rfl

end
