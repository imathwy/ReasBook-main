import Mathlib

universe u

section

variable {E : Type u} [AddCommGroup E] [Module ℝ E]
variable {n : ℕ} (v : Fin n → E)

/- Definition 1.3: a finite family of vectors spans `E` when the submodule generated by that
family is the whole space. -/
#check (Submodule.span ℝ (Set.range v) = ⊤)

/- For a finite family, the textbook criterion that every vector is a linear combination of the
family is the canonical theorem `Submodule.top_le_span_range_iff_forall_exists_fun`; together with
`eq_top_iff`, it recovers the `span = ⊤` formulation above. -/
recall Submodule.top_le_span_range_iff_forall_exists_fun

end
