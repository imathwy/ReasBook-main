section

variable [∀ i, PseudoMetricSpace (Ei i)]

/-- Helper for Theorem 14.3: the `n`-th Gauss-Seidel prefix state uses the next iterate in blocks
with index `< n` and the old iterate in the remaining blocks. -/
abbrev alternating_minimization_prefix_state
    (x : ℕ → (i : Fin p) → Ei i) (k n : ℕ) : (i : Fin p) → Ei i :=
  fun j ↦ if j.1 < n then x (k + 1) j else x k j

/-- Helper for Theorem 14.3: the initial prefix state is the current outer iterate. -/
@[simp] theorem alternating_minimization_prefix_state_zero
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) :
    alternating_minimization_prefix_state x k 0 = x k := by
  -- At stage `0`, no block has been updated yet.
  funext j
  simp [alternating_minimization_prefix_state]

/-- Helper for Theorem 14.3: the terminal prefix state is the next outer iterate. -/
@[simp] theorem alternating_minimization_prefix_state_last
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) :
    alternating_minimization_prefix_state x k p = x (k + 1) := by
  -- At stage `p`, every block index is already below the cutoff.
  funext j
  simp [alternating_minimization_prefix_state, j.2]

/-- Helper for Theorem 14.3: the stage-`i` prefix state is the Algorithm 14.1 mixed state with the
old block value inserted at the active block. -/
theorem alternating_minimization_prefix_state_old_eq_partial_state
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) (i : Fin p) :
    alternating_minimization_prefix_state x k i.1 =
      alternating_minimization_partial_state (x k) (x (k + 1)) i (x k i) := by
  -- Compare the two mixed states coordinatewise.
  funext j
  by_cases hj : j.1 < i.1
  · simp [alternating_minimization_prefix_state, alternating_minimization_partial_state, hj]
  · by_cases hji : j = i
    · subst hji
      simp [alternating_minimization_prefix_state, alternating_minimization_partial_state,
        Function.update]
    · simp [alternating_minimization_prefix_state, alternating_minimization_partial_state, hj,
        Function.update, hji]

/-- Helper for Theorem 14.3: the stage-`i+1` prefix state is the Algorithm 14.1 mixed state with
the new minimizing block value inserted at the active block. -/
theorem alternating_minimization_prefix_state_new_eq_partial_state
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) (i : Fin p) :
    alternating_minimization_prefix_state x k (i.1 + 1) =
      alternating_minimization_partial_state (x k) (x (k + 1)) i (x (k + 1) i) := by
  -- Compare the two mixed states coordinatewise.
  funext j
  by_cases hj : j.1 < i.1
  · simp [alternating_minimization_prefix_state, alternating_minimization_partial_state, hj,
      Nat.lt_succ_of_lt hj]
  · by_cases hji : j = i
    · subst hji
      simp [alternating_minimization_prefix_state, alternating_minimization_partial_state,
        Function.update]
    · have hnot : ¬ j.1 < i.1 + 1 := by
        intro hj_succ
        have hij : i.1 ≤ j.1 := Nat.le_of_not_lt hj
        have hji_le : j.1 ≤ i.1 := Nat.lt_succ_iff.mp hj_succ
        exact hji (Fin.ext (le_antisymm hji_le hij))
      simp [alternating_minimization_prefix_state, alternating_minimization_partial_state, hj,
        hji, hnot, Function.update]

/-- Helper for Theorem 14.3: every prefix state produced during one outer iteration stays in the
effective domain and never raises the objective above the current iterate. -/
theorem alternating_minimization_prefix_state_mem_effective_domain_and_le
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) :
    ∀ k : ℕ, x k ∈ effective_domain F →
      ∀ n ≤ p,
        alternating_minimization_prefix_state x k n ∈ effective_domain F ∧
          F (alternating_minimization_prefix_state x k n) ≤ F (x k) := by
  intro k hxk n hn
  induction n with
  | zero =>
      -- The zeroth prefix state is exactly `x k`.
      constructor
      · simpa using hxk
      · simp
  | succ n ihn =>
      have hn_lt : n < p := Nat.lt_of_succ_le hn
      let i : Fin p := ⟨n, hn_lt⟩
      have hold :=
        ihn (Nat.le_of_lt hn_lt)
      rcases hold with ⟨hold_dom, hold_le⟩
      have hold_old_dom :
          alternating_minimization_partial_state (x k) (x (k + 1)) i (x k i) ∈
            effective_domain F := by
        -- The previous prefix state is the old-candidate mixed state.
        rw [← alternating_minimization_prefix_state_old_eq_partial_state (x := x) (k := k) i]
        exact hold_dom
      have hstep_compare :
          F (alternating_minimization_partial_state (x k) (x (k + 1)) i (x (k + 1) i)) ≤
            F (alternating_minimization_partial_state (x k) (x (k + 1)) i (x k i)) := by
        -- The trajectory minimizes the active block against every candidate, in particular `x k i`.
        simpa [alternating_minimization_block_objective_apply] using
          (isMinOn_iff.mp (is_alternating_minimization_trajectory_step htraj k i))
            (x k i) (by simp)
      have hnew_dom :
          alternating_minimization_partial_state (x k) (x (k + 1)) i (x (k + 1) i) ∈
            effective_domain F := by
        -- Finite objective value propagates through the descent inequality.
        exact mem_effective_domain.mpr <|
          lt_of_le_of_lt hstep_compare (mem_effective_domain.mp hold_old_dom)
      have hold_old_le :
          F (alternating_minimization_partial_state (x k) (x (k + 1)) i (x k i)) ≤ F (x k) := by
        -- The previous prefix state already satisfies the inductive objective bound.
        rw [← alternating_minimization_prefix_state_old_eq_partial_state (x := x) (k := k) i]
        exact hold_le
      have hnew_le :
          F (alternating_minimization_partial_state (x k) (x (k + 1)) i (x (k + 1) i)) ≤
            F (x k) :=
        le_trans hstep_compare hold_old_le
      -- Rewrite the new prefix state as the minimizing mixed state.
      rw [alternating_minimization_prefix_state_new_eq_partial_state (x := x) (k := k) i]
      exact ⟨hnew_dom, hnew_le⟩

/-- Helper for Theorem 14.3: every outer iterate of an alternating-minimization trajectory remains
in the effective domain. -/
theorem alternating_minimization_iterate_mem_effective_domain
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) :
    ∀ k : ℕ, x k ∈ effective_domain F := by
  intro k
  induction k with
  | zero =>
      -- The trajectory owner stores the initial domain condition.
      simpa using is_alternating_minimization_trajectory_zero htraj
  | succ k ih =>
      -- The terminal prefix state of step `k` is the next iterate.
      simpa using
        (alternating_minimization_prefix_state_mem_effective_domain_and_le
          (F := F) (x := x) htraj k ih p (le_rfl : p ≤ p)).1

/-- Helper for Theorem 14.3: one outer alternating-minimization step never increases the
objective. -/
theorem alternating_minimization_objective_nonincreasing
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) (k : ℕ) :
    F (x (k + 1)) ≤ F (x k) := by
  -- The last prefix state of step `k` is exactly `x (k + 1)`.
  simpa using
    (alternating_minimization_prefix_state_mem_effective_domain_and_le
      (F := F) (x := x) htraj k
      (alternating_minimization_iterate_mem_effective_domain (F := F) (x := x) htraj k)
      p (le_rfl : p ≤ p)).2

/-- Helper for Theorem 14.3: every trajectory objective value is bounded above by the initial
objective value. -/
theorem alternating_minimization_objective_le_initial
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) :
    ∀ k : ℕ, F (x k) ≤ F (x 0) := by
  intro k
  induction k with
  | zero =>
      exact le_rfl
  | succ k ih =>
      -- Chain one-step descent with the inductive bound to the initial iterate.
      exact le_trans
        (alternating_minimization_objective_nonincreasing (F := F) (x := x) htraj k)
        ih

-- Proof sketch: monotonicity of the alternating-minimization steps keeps the whole trajectory in
-- the initial sublevel set. Bounded level sets then force `Set.range x` to be bounded.
/-- Theorem 14.3 (1): if every real sublevel set of `F` is bounded and `x` is an
alternating-minimization trajectory for `F`, then the trajectory range is bounded. -/
theorem alternating_minimization_trajectory_range_bounded
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x) :
    Bornology.IsBounded (Set.range x) := by
  have hx0_dom : x 0 ∈ effective_domain F :=
    is_alternating_minimization_trajectory_zero htraj
  have hx0_top : F (x 0) ≠ ⊤ := (mem_effective_domain.mp hx0_dom).ne
  -- Every iterate stays in the real sublevel set cut out by the initial objective value.
  refine (hlevel (F (x 0)).toReal).subset ?_
  rintro _ ⟨k, rfl⟩
  exact le_trans
    (alternating_minimization_objective_le_initial (F := F) (x := x) htraj k)
    (EReal.le_coe_toReal hx0_top)

section

variable [ProperSpace ((i : Fin p) → Ei i)]

/-- Helper for Theorem 14.3: rewriting the mixed state against the stage-`i` prefix state turns
the varying-block trajectory slice into a fixed-base `Function.update`. -/
theorem alternating_minimization_partial_state_eq_update_prefix_state
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) (i : Fin p) (yi : Ei i) :
    alternating_minimization_partial_state (x k) (x (k + 1)) i yi =
      Function.update (alternating_minimization_prefix_state x k i.1) i yi := by
  -- Compare the mixed state and the updated prefix state coordinatewise.
  funext j
  by_cases hji : j = i
  · subst hji
    simp [alternating_minimization_partial_state, alternating_minimization_prefix_state,
      Function.update]
  · by_cases hj : j.1 < i.1
    · simp [alternating_minimization_partial_state, alternating_minimization_prefix_state, hj, hji,
        Function.update]
    · simp [alternating_minimization_partial_state, alternating_minimization_prefix_state, hj, hji,
        Function.update]

/-- Helper for Theorem 14.3: off the active block, the stage-`i` and stage-`i+1` prefix states
coincide. -/
theorem alternating_minimization_prefix_state_succ_eq_of_ne
    (x : ℕ → (i : Fin p) → Ei i) (k : ℕ) (i j : Fin p) (hji : j ≠ i) :
    alternating_minimization_prefix_state x k (i.1 + 1) j =
      alternating_minimization_prefix_state x k i.1 j := by
  -- Only the active block changes between the two adjacent prefix states.
  by_cases hj : j.1 < i.1
  · simp [alternating_minimization_prefix_state, hj, Nat.lt_succ_of_lt hj]
  · have hnot : ¬ j.1 < i.1 + 1 := by
      intro hj_succ
      have hij : i.1 ≤ j.1 := Nat.le_of_not_lt hj
      have hji_le : j.1 ≤ i.1 := Nat.lt_succ_iff.mp hj_succ
      exact hji (Fin.ext (le_antisymm hji_le hij))
    simp [alternating_minimization_prefix_state, hj, hnot]

/-- Helper for Theorem 14.3: if the stage-`i` and stage-`i+1` prefix states converge, then the
limit of the latter differs from the former only in block `i`. -/
theorem alternating_minimization_prefix_state_limit_eq_update
    (x : ℕ → (i : Fin p) → Ei i) (ψ : ℕ → ℕ) (i : Fin p)
    {xBar y : (j : Fin p) → Ei j}
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar))
    (hnext :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1)) atTop (𝓝 y)) :
    y = Function.update xBar i (y i) := by
  -- TODO: the source-faithful proof compares the `j ≠ i` coordinates of the stage-`i` and
  -- stage-`i+1` prefix states and then uses uniqueness of limits. In the current file the ambient
  -- assumptions are only `PseudoMetricSpace`, so neither the coordinate spaces nor the product are
  -- known to be `T2Space`; this uniqueness step is therefore unavailable without an added
  -- separation hypothesis matching the Euclidean source setting.
  sorry

/-- Helper for Theorem 14.3: continuity on the effective domain turns a convergent domain-valued
sequence into convergence of objective values. -/
theorem alternating_minimization_tendsto_objective_of_tendsto
    (F : ((i : Fin p) → Ei i) → EReal)
    (hcont : ContinuousOn F (effective_domain F))
    {u : ℕ → (i : Fin p) → Ei i} {xBar : (i : Fin p) → Ei i}
    (hxBar : xBar ∈ effective_domain F)
    (hu : Tendsto u atTop (𝓝 xBar))
    (hu_dom : ∀ n, u n ∈ effective_domain F) :
    Tendsto (fun n ↦ F (u n)) atTop (𝓝 (F xBar)) := by
  -- Package the pointwise domain membership as convergence within the effective domain.
  have hu_within : Tendsto u atTop (𝓝[effective_domain F] xBar) := by
    rw [tendsto_nhdsWithin_iff]
    exact ⟨hu, Filter.Eventually.of_forall hu_dom⟩
  exact (hcont xBar hxBar).tendsto.comp hu_within

/-- Helper for Theorem 14.3: each single block update during an outer iteration decreases the
prefix-state objective. -/
theorem alternating_minimization_prefix_state_succ_objective_le
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    (k n : ℕ) (hn : n < p) :
    F (alternating_minimization_prefix_state x k (n + 1)) ≤
      F (alternating_minimization_prefix_state x k n) := by
  let i : Fin p := ⟨n, hn⟩
  -- Compare the new block value with the old block value in the same mixed state.
  rw [alternating_minimization_prefix_state_new_eq_partial_state (x := x) (k := k) i,
    alternating_minimization_prefix_state_old_eq_partial_state (x := x) (k := k) i]
  exact
    (isMinOn_iff.mp (is_alternating_minimization_trajectory_step htraj k i))
      (x k i) (by simp)

/-- Helper for Theorem 14.3: the prefix-state objective is antitone in the stage index and becomes
constant after stage `p`. -/
theorem alternating_minimization_prefix_state_objective_antitone
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    (k : ℕ) :
    Antitone fun n ↦ F (alternating_minimization_prefix_state x k n) := by
  -- Adjacent prefix stages decrease while `n < p`, and all later stages equal `x (k + 1)`.
  refine antitone_nat_of_succ_le fun n ↦ ?_
  by_cases hn : n < p
  · exact alternating_minimization_prefix_state_succ_objective_le
      (F := F) (x := x) htraj k n hn
  · have hn_ge : p ≤ n := Nat.le_of_not_lt hn
    have hstate_n :
        alternating_minimization_prefix_state x k n = x (k + 1) := by
      funext j
      have hjn : j.1 < n := lt_of_lt_of_le j.2 hn_ge
      simp [alternating_minimization_prefix_state, hjn]
    have hstate_succ :
        alternating_minimization_prefix_state x k (n + 1) = x (k + 1) := by
      funext j
      have hjn : j.1 < n + 1 := by
        exact lt_of_lt_of_le j.2 (Nat.le_trans hn_ge (Nat.le_succ n))
      simp [alternating_minimization_prefix_state, hjn]
    simpa [hstate_n, hstate_succ]

/-- Helper for Theorem 14.3: every intermediate prefix state dominates the final outer iterate in
objective value. -/
theorem alternating_minimization_next_iterate_objective_le_prefix_state
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    (k n : ℕ) :
    F (x (k + 1)) ≤ F (alternating_minimization_prefix_state x k n) := by
  -- The terminal prefix state is `x (k + 1)`, and the prefix objectives are antitone in `n`.
  by_cases hn : n ≤ p
  · have hantitone :=
      alternating_minimization_prefix_state_objective_antitone (F := F) (x := x) htraj k
    simpa [alternating_minimization_prefix_state_last] using hantitone hn
  · have hn_ge : p ≤ n := Nat.le_of_not_ge hn
    have hstate_n :
        alternating_minimization_prefix_state x k n = x (k + 1) := by
      funext j
      have hjn : j.1 < n := lt_of_lt_of_le j.2 hn_ge
      simp [alternating_minimization_prefix_state, hjn]
    simp [hstate_n]

/-- Helper for Theorem 14.3: the outer-iterate objective sequence is antitone. -/
theorem alternating_minimization_objective_antitone
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x) :
    Antitone fun k ↦ F (x k) :=
  antitone_nat_of_succ_le
    (alternating_minimization_objective_nonincreasing (F := F) (x := x) htraj)

/-- Helper for Theorem 14.3: if the objective values along a subsequence converge, then the same
limit is seen along the shifted subsequence `k_j + 1`. -/
theorem alternating_minimization_shifted_objective_tendsto
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (htraj : is_alternating_minimization_trajectory F x)
    {ψ : ℕ → ℕ} (hψ : StrictMono ψ) {ℓ : EReal}
    (hFx :
      Tendsto (fun m ↦ F (x (ψ m))) atTop (𝓝 ℓ)) :
    Tendsto (fun m ↦ F (x (ψ m + 1))) atTop (𝓝 ℓ) := by
  let hanti := alternating_minimization_objective_antitone (F := F) (x := x) htraj
  have hFx_succ :
      Tendsto (fun m ↦ F (x (ψ (m + 1)))) atTop (𝓝 ℓ) := by
    exact hFx.comp (tendsto_add_atTop_nat 1)
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le hFx_succ hFx ?_ ?_
  · intro m
    exact hanti (Nat.succ_le_of_lt (hψ (Nat.lt_succ_self m)))
  · intro m
    exact hanti (Nat.le_add_right (ψ m) 1)

/-- Helper for Theorem 14.3: once the limit block update belongs to the fixed-base argmin set and
attains the same objective value as `xBar`, uniqueness of that argmin set forces the limit state
to equal `xBar`. -/
theorem alternating_minimization_limit_block_eq_cluster_point
    (F : ((i : Fin p) → Ei i) → EReal)
    (xBar y : (j : Fin p) → Ei j) (i : Fin p)
    (hxBar : xBar ∈ effective_domain F)
    (hyUpdate : y = Function.update xBar i (y i))
    (hyArgmin : y i ∈ alternating_minimization_argmin F xBar i)
    (hFy : F y = F xBar)
    (hunique :
      ∀ xBar ∈ effective_domain F, ∀ i : Fin p,
        Set.Subsingleton (alternating_minimization_argmin F xBar i)) :
    y = xBar := by
  -- Route correction: uniqueness applies only after showing that `xBar i` lies in the same fixed-base
  -- argmin set, which follows from `F y = F xBar` and the update description of `y`.
  have hy_isMin :
      IsMinOn (fun yi ↦ F (Function.update xBar i yi)) Set.univ (y i) :=
    (mem_alternating_minimization_argmin_update_iff).1 hyArgmin
  have hxBar_argmin : xBar i ∈ alternating_minimization_argmin F xBar i := by
    refine (mem_alternating_minimization_argmin_update_iff).2 ?_
    rw [isMinOn_iff]
    intro z hz
    have hy_min :
        F (Function.update xBar i (y i)) ≤ F (Function.update xBar i z) := by
      exact (isMinOn_iff.mp hy_isMin) z hz
    have hvalue :
        F (Function.update xBar i (xBar i)) = F (Function.update xBar i (y i)) := by
      calc
        F (Function.update xBar i (xBar i)) = F xBar := by simp
        _ = F y := hFy.symm
        _ = F (Function.update xBar i (y i)) := congrArg F hyUpdate
    calc
      F (Function.update xBar i (xBar i)) = F (Function.update xBar i (y i)) := hvalue
      _ ≤ F (Function.update xBar i z) := hy_min
  have hyi : y i = xBar i :=
    hunique xBar hxBar i hyArgmin hxBar_argmin
  -- Once the active coordinate matches, the update description collapses to `xBar`.
  rw [hyUpdate]
  ext j
  by_cases hji : j = i
  · subst hji
    simpa [Function.update] using hyi
  · simp [Function.update, hji]

/-- Helper for Theorem 14.3: a fixed-base block minimizer produces an updated point that still
lies in the effective domain. -/
lemma alternating_minimization_argmin_update_mem_effective_domain_of_base_mem
    (F : ((i : Fin p) → Ei i) → EReal)
    {xBar : (j : Fin p) → Ei j} (i : Fin p)
    (hxBar : xBar ∈ effective_domain F) {yi : Ei i}
    (hyArgmin : yi ∈ alternating_minimization_argmin F xBar i) :
    Function.update xBar i yi ∈ effective_domain F := by
  rw [mem_alternating_minimization_argmin_update_iff, isMinOn_iff] at hyArgmin
  -- Compare the minimizing update with the unchanged block value `xBar i`.
  have hy_le : F (Function.update xBar i yi) ≤ F xBar := by
    simpa using hyArgmin (xBar i) (by simp)
  exact mem_effective_domain.mpr <|
    lt_of_le_of_lt hy_le (mem_effective_domain.mp hxBar)

/-- Helper for Theorem 14.3: if a limit of updated prefix states attains the objective limit
`F xBar`, then its active coordinate lies in the fixed-base block argmin set at `xBar`. -/
theorem alternating_minimization_limit_block_argmin
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (hcont : ContinuousOn F (effective_domain F))
    (htraj : is_alternating_minimization_trajectory F x)
    (xBar y : (j : Fin p) → Ei j) (i : Fin p)
    {ψ : ℕ → ℕ}
    (hxBar : xBar ∈ effective_domain F)
    (hyUpdate : y = Function.update xBar i (y i))
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar))
    (hnext :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1)) atTop (𝓝 y))
    (hFnext :
      Tendsto (fun m ↦ F (alternating_minimization_prefix_state x (ψ m) (i.1 + 1)))
        atTop (𝓝 (F xBar))) :
    y i ∈ alternating_minimization_argmin F xBar i := by
  -- TODO: to pass the comparison inequality to the limit in the `hzEff` branch, we need a
  -- source-faithful bridge showing that if `Function.update xBar i z ∈ effective_domain F` and
  -- `alternating_minimization_prefix_state x (ψ m) i.1 → xBar`, then the comparison sequence
  -- `Function.update (alternating_minimization_prefix_state x (ψ m) i.1) i z` stays in
  -- `effective_domain F` eventually (or an equivalent continuity/closed-graph replacement).
  -- Without that domain-stability input, continuity on `effective_domain F` does not identify the
  -- right-hand limit value needed for the textbook fixed-block limit passage.
  sorry

/-- Helper for Theorem 14.3: a cluster point of the trajectory lies in the effective domain
because the whole trajectory stays in the closed initial real sublevel. -/
lemma alternating_minimization_cluster_point_mem_effective_domain_of_initial_sublevel
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (htraj : is_alternating_minimization_trajectory F x)
    {xBar : (i : Fin p) → Ei i}
    (hxBar : MapClusterPt xBar atTop x) :
    xBar ∈ effective_domain F := by
  have hx0_dom : x 0 ∈ effective_domain F :=
    is_alternating_minimization_trajectory_zero htraj
  have hx0_top : F (x 0) ≠ ⊤ := (mem_effective_domain.mp hx0_dom).ne
  have hsublevel_closed :
      IsClosed {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} :=
    hclosed.isClosed_preimage (((F (x 0)).toReal : ℝ) : EReal)
  have hxBar_sublevel :
      xBar ∈ {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)} := by
    -- Descent keeps every iterate in the initial real sublevel, so the cluster point stays there.
    refine hsublevel_closed.mem_of_mapClusterPt hxBar ?_
    exact Filter.Eventually.of_forall fun n ↦
      le_trans
        (alternating_minimization_objective_le_initial (F := F) (x := x) htraj n)
        (EReal.le_coe_toReal hx0_top)
  exact mem_effective_domain.mpr <|
    lt_of_le_of_lt hxBar_sublevel (by simp)

/-- Helper for Theorem 14.3: for any strict subsequence and any stage `n < p`, the next prefix
states admit a further convergent refinement inside the initial bounded real sublevel. -/
lemma alternating_minimization_prefix_state_stage_succ_has_convergent_refinement
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x)
    {ψ : ℕ → ℕ} (_hψ : StrictMono ψ) {n : ℕ} (hn : n < p) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧
      ∃ y : (i : Fin p) → Ei i,
        Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ (φ m)) (n + 1))
          atTop (𝓝 y) := by
  have hx0_dom : x 0 ∈ effective_domain F :=
    is_alternating_minimization_trajectory_zero htraj
  have hx0_top : F (x 0) ≠ ⊤ := (mem_effective_domain.mp hx0_dom).ne
  let C : Set ((i : Fin p) → Ei i) := {z | F z ≤ (((F (x 0)).toReal : ℝ) : EReal)}
  have hC_closed : IsClosed C := by
    simpa [C] using hclosed.isClosed_preimage ((((F (x 0)).toReal : ℝ) : EReal))
  have hC_bounded : Bornology.IsBounded C := by
    simpa [C] using hlevel ((F (x 0)).toReal)
  have hC_compact : IsCompact C :=
    Metric.isCompact_of_isClosed_isBounded hC_closed hC_bounded
  let u : ℕ → (i : Fin p) → Ei i :=
    fun m ↦ alternating_minimization_prefix_state x (ψ m) (n + 1)
  have huC : ∀ m, u m ∈ C := by
    intro m
    have hu_pair :
        alternating_minimization_prefix_state x (ψ m) (n + 1) ∈ effective_domain F ∧
          F (alternating_minimization_prefix_state x (ψ m) (n + 1)) ≤ F (x (ψ m)) := by
      exact alternating_minimization_prefix_state_mem_effective_domain_and_le
        (F := F) (x := x) htraj (ψ m)
        (alternating_minimization_iterate_mem_effective_domain (F := F) (x := x) htraj (ψ m))
        (n + 1) (Nat.succ_le_of_lt hn)
    have hu_le :
        F (u m) ≤ (((F (x 0)).toReal : ℝ) : EReal) := by
      calc
        F (u m) ≤ F (x (ψ m)) := hu_pair.2
        _ ≤ F (x 0) := alternating_minimization_objective_le_initial (F := F) (x := x) htraj (ψ m)
        _ ≤ (((F (x 0)).toReal : ℝ) : EReal) := EReal.le_coe_toReal hx0_top
    exact hu_le
  have hfreq : ∃ᶠ m in atTop, u m ∈ C :=
    (Filter.Eventually.of_forall huC).frequently
  rcases hC_compact.exists_mapClusterPt_of_frequently hfreq with ⟨y, -, hyCluster⟩
  rcases MapClusterPt.tendsto_subseq hyCluster with ⟨φ, hφ, hφtendsto⟩
  exact ⟨φ, hφ, y, by simpa [u] using hφtendsto⟩

/-- Helper for Theorem 14.3: once the stage-`i+1` limit is known to solve the fixed-base block
subproblem, continuity and the objective squeeze identify its objective value with `F xBar`. -/
lemma alternating_minimization_prefix_state_limit_value_eq_cluster_value
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hcont : ContinuousOn F (effective_domain F))
    (htraj : is_alternating_minimization_trajectory F x)
    {ψ : ℕ → ℕ} (hψ : StrictMono ψ) (i : Fin p)
    {xBar y : (j : Fin p) → Ei j}
    (hxBar : xBar ∈ effective_domain F)
    (hiter : Tendsto (fun m ↦ x (ψ m)) atTop (𝓝 xBar))
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar))
    (hnext :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1)) atTop (𝓝 y))
    (hyUpdate : y = Function.update xBar i (y i))
    (hyArgmin : y i ∈ alternating_minimization_argmin F xBar i) :
    F y = F xBar := by
  have hyDomUpdate :
      Function.update xBar i (y i) ∈ effective_domain F :=
    alternating_minimization_argmin_update_mem_effective_domain_of_base_mem
      (F := F) i hxBar hyArgmin
  have hyDom : y ∈ effective_domain F := by
    simpa [← hyUpdate] using hyDomUpdate
  have hFiter :
      Tendsto (fun m ↦ F (x (ψ m))) atTop (𝓝 (F xBar)) := by
    exact alternating_minimization_tendsto_objective_of_tendsto
      F
      hcont
      hxBar
      hiter
      (fun m ↦ alternating_minimization_iterate_mem_effective_domain (F := F) (x := x) htraj (ψ m))
  have hFshift :
      Tendsto (fun m ↦ F (x (ψ m + 1))) atTop (𝓝 (F xBar)) := by
    exact alternating_minimization_shifted_objective_tendsto (F := F) (x := x) htraj hψ hFiter
  have hstage_dom :
      ∀ m, alternating_minimization_prefix_state x (ψ m) i.1 ∈ effective_domain F := by
    intro m
    exact (alternating_minimization_prefix_state_mem_effective_domain_and_le
      (F := F) (x := x) htraj (ψ m)
      (alternating_minimization_iterate_mem_effective_domain (F := F) (x := x) htraj (ψ m))
      i.1 (Nat.le_of_lt i.is_lt)).1
  have hnext_dom :
      ∀ m, alternating_minimization_prefix_state x (ψ m) (i.1 + 1) ∈ effective_domain F := by
    intro m
    exact (alternating_minimization_prefix_state_mem_effective_domain_and_le
      (F := F) (x := x) htraj (ψ m)
      (alternating_minimization_iterate_mem_effective_domain (F := F) (x := x) htraj (ψ m))
      (i.1 + 1) (Nat.succ_le_of_lt i.is_lt)).1
  have hFstage :
      Tendsto (fun m ↦ F (alternating_minimization_prefix_state x (ψ m) i.1))
        atTop (𝓝 (F xBar)) := by
    exact alternating_minimization_tendsto_objective_of_tendsto
      F hcont hxBar hstage hstage_dom
  have hFnext_cluster :
      Tendsto (fun m ↦ F (alternating_minimization_prefix_state x (ψ m) (i.1 + 1)))
        atTop (𝓝 (F xBar)) := by
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le hFshift hFstage ?_ ?_
    · intro m
      exact alternating_minimization_next_iterate_objective_le_prefix_state
        (F := F) (x := x) htraj (ψ m) (i.1 + 1)
    · intro m
      exact alternating_minimization_prefix_state_succ_objective_le
        (F := F) (x := x) htraj (ψ m) i.1 i.is_lt
  have hFnext_y :
      Tendsto (fun m ↦ F (alternating_minimization_prefix_state x (ψ m) (i.1 + 1)))
        atTop (𝓝 (F y)) := by
    exact alternating_minimization_tendsto_objective_of_tendsto
      F hcont hyDom hnext hnext_dom
  -- The same stage-`i+1` objective sequence converges both to `F y` and to `F xBar`.
  exact tendsto_nhds_unique hFnext_y hFnext_cluster

/-- Helper for Theorem 14.3: a convergent stage-`i+1` prefix-state subsequence lands at an update
of the cluster point whose active block lies in the fixed-base argmin set and attains the same
objective value. -/
lemma alternating_minimization_prefix_state_limit_update_argmin_and_value
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (hcont : ContinuousOn F (effective_domain F))
    (htraj : is_alternating_minimization_trajectory F x)
    {ψ : ℕ → ℕ} (hψ : StrictMono ψ) (i : Fin p)
    {xBar y : (j : Fin p) → Ei j}
    (hxBar : xBar ∈ effective_domain F)
    (hiter : Tendsto (fun m ↦ x (ψ m)) atTop (𝓝 xBar))
    (hstage :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) i.1) atTop (𝓝 xBar))
    (hnext :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) (i.1 + 1)) atTop (𝓝 y)) :
    y = Function.update xBar i (y i) ∧
      y i ∈ alternating_minimization_argmin F xBar i ∧
      F y = F xBar := by
  have hyUpdate :
      y = Function.update xBar i (y i) :=
    alternating_minimization_prefix_state_limit_eq_update
      (x := x) (ψ := ψ) i hstage hnext
  have hFiter :
      Tendsto (fun m ↦ F (x (ψ m))) atTop (𝓝 (F xBar)) := by
    exact alternating_minimization_tendsto_objective_of_tendsto
      F
      hcont
      hxBar
      hiter
      (fun m ↦ alternating_minimization_iterate_mem_effective_domain (F := F) (x := x) htraj (ψ m))
  have hFshift :
      Tendsto (fun m ↦ F (x (ψ m + 1))) atTop (𝓝 (F xBar)) := by
    exact alternating_minimization_shifted_objective_tendsto (F := F) (x := x) htraj hψ hFiter
  have hstage_dom :
      ∀ m, alternating_minimization_prefix_state x (ψ m) i.1 ∈ effective_domain F := by
    intro m
    exact (alternating_minimization_prefix_state_mem_effective_domain_and_le
      (F := F) (x := x) htraj (ψ m)
      (alternating_minimization_iterate_mem_effective_domain (F := F) (x := x) htraj (ψ m))
      i.1 (Nat.le_of_lt i.is_lt)).1
  have hFstage :
      Tendsto (fun m ↦ F (alternating_minimization_prefix_state x (ψ m) i.1))
        atTop (𝓝 (F xBar)) := by
    exact alternating_minimization_tendsto_objective_of_tendsto
      F hcont hxBar hstage hstage_dom
  have hFnext_cluster :
      Tendsto (fun m ↦ F (alternating_minimization_prefix_state x (ψ m) (i.1 + 1)))
        atTop (𝓝 (F xBar)) := by
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le hFshift hFstage ?_ ?_
    · intro m
      exact alternating_minimization_next_iterate_objective_le_prefix_state
        (F := F) (x := x) htraj (ψ m) (i.1 + 1)
    · intro m
      exact alternating_minimization_prefix_state_succ_objective_le
        (F := F) (x := x) htraj (ψ m) i.1 i.is_lt
  have hyArgmin :
      y i ∈ alternating_minimization_argmin F xBar i :=
    alternating_minimization_limit_block_argmin
      (F := F) (x := x) hclosed hcont htraj xBar y i hxBar hyUpdate hstage hnext hFnext_cluster
  have hFy :
      F y = F xBar :=
    alternating_minimization_prefix_state_limit_value_eq_cluster_value
      (F := F) (x := x) hcont htraj hψ i hxBar hiter hstage hnext hyUpdate hyArgmin
  exact ⟨hyUpdate, hyArgmin, hFy⟩

/-- Helper for Theorem 14.3: the stage-`n → n+1` refinement preserves convergence to the cluster
point and records block-`n` argmin membership there. -/
lemma alternating_minimization_prefix_state_stage_succ_refine_to_cluster_point
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (hcont : ContinuousOn F (effective_domain F))
    (hunique :
      ∀ xBar ∈ effective_domain F, ∀ i : Fin p,
        Set.Subsingleton (alternating_minimization_argmin F xBar i))
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x)
    {xBar : (i : Fin p) → Ei i}
    (hxBar : MapClusterPt xBar atTop x)
    {ψ : ℕ → ℕ} (hψ : StrictMono ψ) {n : ℕ} (hn : n < p)
    (hiter : Tendsto (fun m ↦ x (ψ m)) atTop (𝓝 xBar))
    (hstage : Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) n)
      atTop (𝓝 xBar)) :
    ∃ ψ' : ℕ → ℕ, StrictMono ψ' ∧
      Tendsto (fun m ↦ x (ψ' m)) atTop (𝓝 xBar) ∧
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ' m) (n + 1))
        atTop (𝓝 xBar) ∧
      xBar ⟨n, hn⟩ ∈ alternating_minimization_argmin F xBar ⟨n, hn⟩ := by
  let i : Fin p := ⟨n, hn⟩
  have hxBar_eff :
      xBar ∈ effective_domain F :=
    alternating_minimization_cluster_point_mem_effective_domain_of_initial_sublevel
      (F := F) (x := x) hclosed htraj hxBar
  rcases alternating_minimization_prefix_state_stage_succ_has_convergent_refinement
      (F := F) (x := x) hclosed hlevel htraj hψ hn with ⟨φ, hφ, y, hnext⟩
  let ψ' : ℕ → ℕ := ψ ∘ φ
  have hψ' : StrictMono ψ' := by
    intro a b hab
    exact hψ (hφ hab)
  have hiter' :
      Tendsto (fun m ↦ x (ψ' m)) atTop (𝓝 xBar) := by
    simpa [ψ', Function.comp] using hiter.comp hφ.tendsto_atTop
  have hstage' :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ' m) n)
        atTop (𝓝 xBar) := by
    simpa [ψ', Function.comp] using hstage.comp hφ.tendsto_atTop
  have hnext' :
      Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ' m) (n + 1))
        atTop (𝓝 y) := by
    simpa [ψ', Function.comp] using hnext
  have hlimit_pkg :
      y = Function.update xBar i (y i) ∧
        y i ∈ alternating_minimization_argmin F xBar i ∧
        F y = F xBar :=
    alternating_minimization_prefix_state_limit_update_argmin_and_value
      (F := F) (x := x) hclosed hcont htraj hψ' i hxBar_eff hiter' hstage' hnext'
  rcases hlimit_pkg with ⟨hyUpdate, hyArgmin, hFy⟩
  have hy : y = xBar :=
    alternating_minimization_limit_block_eq_cluster_point
      (F := F) xBar y i hxBar_eff hyUpdate hyArgmin hFy hunique
  have hargmin_i :
      xBar i ∈ alternating_minimization_argmin F xBar i := by
    simpa [i, hy] using hyArgmin
  exact ⟨ψ', hψ', hiter', by simpa [ψ', hy] using hnext', hargmin_i⟩

/-- Helper for Theorem 14.3: the source proof inducts over the Gauss-Seidel stage index while
keeping both the iterate subsequence and the stage-`n` prefix states convergent to the same
cluster point and accumulating the already-certified block argmin facts. -/
lemma alternating_minimization_prefix_state_stage_induction_invariant
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hclosed : LowerSemicontinuous F)
    (hcont : ContinuousOn F (effective_domain F))
    (hunique :
      ∀ xBar ∈ effective_domain F, ∀ i : Fin p,
        Set.Subsingleton (alternating_minimization_argmin F xBar i))
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x)
    {xBar : (i : Fin p) → Ei i}
    (hxBar : MapClusterPt xBar atTop x) :
    ∀ n ≤ p, ∃ ψ : ℕ → ℕ,
      StrictMono ψ ∧
        Tendsto (fun m ↦ x (ψ m)) atTop (𝓝 xBar) ∧
        Tendsto (fun m ↦ alternating_minimization_prefix_state x (ψ m) n)
          atTop (𝓝 xBar) ∧
        ∀ j : Fin p, j.1 < n → xBar j ∈ alternating_minimization_argmin F xBar j := by
  intro n hn
  induction n with
  | zero =>
      rcases MapClusterPt.tendsto_subseq hxBar with ⟨ψ, hψ, hiter⟩
      refine ⟨ψ, hψ, hiter, ?_, ?_⟩
      · -- At stage `0`, the prefix state is the current iterate itself.
        simpa using hiter
      · intro j hj
        exact (Nat.not_lt_zero _ hj).elim
  | succ n ihn =>
      have hn_le : n ≤ p := Nat.le_trans (Nat.le_succ n) hn
      have hn_lt : n < p := Nat.lt_of_succ_le hn
      rcases ihn hn_le with ⟨ψ, hψ, hiter, hstage, hblocks⟩
      rcases alternating_minimization_prefix_state_stage_succ_refine_to_cluster_point
          (F := F) (x := x) hclosed hcont hunique hlevel htraj hxBar hψ hn_lt hiter hstage with
        ⟨ψ', hψ', hiter', hstage', hargmin⟩
      refine ⟨ψ', hψ', hiter', hstage', ?_⟩
      intro j hj
      rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj' | hj'
      · exact hblocks j hj'
      · have hji : j = ⟨n, hn_lt⟩ := Fin.ext hj'
        subst hji
        simpa using hargmin

-- Proof sketch: for a cluster point `xBar`, pass to a convergent subsequence `x (k_j) → xBar`;
-- boundedness of the trajectory and properness of the ambient product space allow repeated
-- subsequence extraction for the intermediate one-block-updated states. Use lower
-- semicontinuity, continuity on the effective domain, and uniqueness of each block minimizer to
-- identify the limiting block updates with the corresponding coordinates of `xBar`, yielding the
-- one-block minimality inequalities for every coordinate.
/-- Theorem 14.3 (2): under the alternating-minimization hypotheses of Theorem 14.3, every
sequential limit point of `x` is a coordinate-wise minimum of `F`; effective-domain membership is
part of that owner predicate, so the only remaining properness input is that `F` never takes the
value `-∞`. -/
theorem alternating_minimization_cluster_points_coordinatewise_minima
    (F : ((i : Fin p) → Ei i) → EReal)
    (x : ℕ → (i : Fin p) → Ei i)
    (hne_bot : ∀ z, F z ≠ ⊥)
    (hclosed : LowerSemicontinuous F)
    (hcont : ContinuousOn F (effective_domain F))
    (hunique :
      ∀ xBar ∈ effective_domain F, ∀ i : Fin p,
        Set.Subsingleton (alternating_minimization_argmin F xBar i))
    (hlevel : ∀ α : ℝ, Bornology.IsBounded {x | F x ≤ (α : EReal)})
    (htraj : is_alternating_minimization_trajectory F x)
    (xBar : (i : Fin p) → Ei i)
    (hxBar : MapClusterPt xBar atTop x) :
    is_coordinatewise_minimum F xBar := by
  have hxBar_dom :
      xBar ∈ effective_domain F :=
    alternating_minimization_cluster_point_mem_effective_domain_of_initial_sublevel
      (F := F) (x := x) hclosed htraj hxBar
  rcases alternating_minimization_prefix_state_stage_induction_invariant
      (F := F) (x := x) hclosed hcont hunique hlevel htraj hxBar p (le_rfl : p ≤ p) with
    ⟨ψ, hψ, hiter, hstage, hblocks⟩
  refine ⟨hxBar_dom, ?_⟩
  intro i
  -- The stage-`p` invariant already records every fixed-base block argmin fact.
  exact (mem_alternating_minimization_argmin_iff).1 (hblocks i i.is_lt)

end
end

