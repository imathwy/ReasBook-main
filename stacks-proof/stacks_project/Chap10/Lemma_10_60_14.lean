import Mathlib
import stacks_project.Chap10.Definition_10_59_1
import stacks_project.Chap10.Definition_10_60_10
import stacks_project.Chap10.Proposition_10_60_9
import stacks_project.Chap10.Lemma_10_60_13

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open IsLocalRing

section

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]

/-- Helper for Lemma 10.60.14: the ideal generated by the head parameter of a system. -/
def headParameterIdeal {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal A) : Ideal A :=
  Ideal.span ({((x 0 : maximalIdeal A) : A)} : Set A)

/-- Helper for Lemma 10.60.14: the head parameter ideal lies in the maximal ideal. -/
lemma headParameterIdeal_le_maximalIdeal {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal A) :
    headParameterIdeal x ≤ maximalIdeal A := by
  -- The head ideal is generated by an element already lying in the maximal ideal.
  dsimp [headParameterIdeal]
  exact (Ideal.span_singleton_le_iff_mem (I := maximalIdeal A) (x := ((x 0 : maximalIdeal A) : A))).2
    (x 0).2

/-- Helper for Lemma 10.60.14: the quotient by the head parameter remains nontrivial. -/
lemma headParameterIdeal_ne_top {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal A) :
    headParameterIdeal x ≠ ⊤ := by
  -- An ideal contained in the maximal ideal cannot be the whole ring.
  intro htop
  have hmax : maximalIdeal A = ⊤ := top_le_iff.mp (htop ▸ headParameterIdeal_le_maximalIdeal x)
  exact (maximalIdeal.isMaximal A).ne_top hmax

/-- Helper for Lemma 10.60.14: in the head quotient, each remaining parameter still lies in the
quotient maximal ideal. -/
lemma tail_image_mem_maximalIdeal {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}
    (x : Fin (d + 1) → maximalIdeal A)
    [IsLocalRing (A ⧸ headParameterIdeal x)] (i : Fin d) :
    Ideal.Quotient.mk (headParameterIdeal x) (((x i.succ : maximalIdeal A) : A)) ∈
      maximalIdeal (A ⧸ headParameterIdeal x) := by
  let I : Ideal A := headParameterIdeal x
  let S := A ⧸ I
  have hmap :
      Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A) = maximalIdeal S := by
    exact IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
  have hmem :
      Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)) ∈
        Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A) := by
    refine (Ideal.mem_map_iff_of_surjective (f := Ideal.Quotient.mk I)
      (hf := Ideal.Quotient.mk_surjective) (I := maximalIdeal A)
      (y := Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)))).2 ?_
    exact ⟨((x i.succ : maximalIdeal A) : A), (x i.succ).2, rfl⟩
  simpa [I, S, hmap] using hmem

/-- Helper for Lemma 10.60.14: the image of the full parameter ideal in the head quotient is the
parameter ideal generated by the quotient images of the tail. -/
lemma map_parameterIdeal_eq_tail_parameterIdeal {A : Type u} [CommRing A] [IsLocalRing A]
    {d : ℕ} (x : Fin (d + 1) → maximalIdeal A)
    [IsLocalRing (A ⧸ headParameterIdeal x)] :
    let xbar : Fin d → maximalIdeal (A ⧸ headParameterIdeal x) := fun i ↦
      ⟨Ideal.Quotient.mk (headParameterIdeal x) (((x i.succ : maximalIdeal A) : A)),
        tail_image_mem_maximalIdeal x i⟩
    Ideal.map (Ideal.Quotient.mk (headParameterIdeal x)) (parameterIdeal x) = parameterIdeal xbar := by
  let I : Ideal A := headParameterIdeal x
  let S := A ⧸ I
  let xbar : Fin d → maximalIdeal S := fun i ↦
    ⟨Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)), tail_image_mem_maximalIdeal x i⟩
  -- Map the span of the full parameter family and note that the head generator dies in the quotient.
  suffices
      hspan :
        Ideal.map (Ideal.Quotient.mk I) (Ideal.span (Set.range fun i ↦ ((x i : maximalIdeal A) : A))) =
          Ideal.span (Set.range fun i ↦ ((xbar i : maximalIdeal S) : S)) by
    simpa [parameterIdeal_eq_span, xbar] using hspan
  rw [Ideal.map_span]
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨y, ⟨i, rfl⟩, rfl⟩
    refine Fin.cases ?_ ?_ i
    · have hx0 : Ideal.Quotient.mk I (((x 0 : maximalIdeal A) : A)) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem]
        dsimp [I, headParameterIdeal]
        exact Ideal.subset_span (by simp)
      simpa [hx0]
    · intro j
      exact Ideal.subset_span ⟨j, rfl⟩
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    exact Ideal.subset_span ⟨((x i.succ : maximalIdeal A) : A), ⟨i.succ, rfl⟩, rfl⟩

/-- Helper for Lemma 10.60.14: after killing the head parameter, the remaining images still
generate an ideal of definition. -/
lemma quotient_tail_parameterIdeal_isIdealOfDefinition {A : Type u} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {d : ℕ} (x : Fin (d + 1) → maximalIdeal A)
    (hx : IsSystemOfParameters x) :
    let I : Ideal A := headParameterIdeal x
    let S := A ⧸ I
    letI : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr (headParameterIdeal_ne_top x)
    letI : IsLocalRing S :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    let xbar : Fin d → maximalIdeal S := fun i ↦
      ⟨Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)),
        tail_image_mem_maximalIdeal x i⟩
    (parameterIdeal xbar).IsIdealOfDefinition := by
  let I : Ideal A := headParameterIdeal x
  let S := A ⧸ I
  letI : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr (headParameterIdeal_ne_top x)
  letI : IsLocalRing S :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let xbar : Fin d → maximalIdeal S := fun i ↦
    ⟨Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)), tail_image_mem_maximalIdeal x i⟩
  have hker_le_parameter : RingHom.ker (Ideal.Quotient.mk I) ≤ parameterIdeal x := by
    -- The kernel of the quotient map is exactly the head parameter ideal, which lies in the full
    -- parameter ideal.
    rw [Ideal.mk_ker]
    dsimp [I, headParameterIdeal]
    exact (Ideal.span_singleton_le_iff_mem (I := parameterIdeal x) (x := ((x 0 : maximalIdeal A) : A))).2 <|
      by
        rw [parameterIdeal_eq_span]
        exact Ideal.subset_span ⟨0, rfl⟩
  have hmap :
      Ideal.map (Ideal.Quotient.mk I) (parameterIdeal x) = parameterIdeal xbar := by
    -- Modding out by the head kills only the first generator and leaves the mapped tail family.
    simpa [I, S, xbar] using map_parameterIdeal_eq_tail_parameterIdeal (A := A) x
  have hmap_max :
      Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A) = maximalIdeal S := by
    exact IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
      Ideal.Quotient.mk_surjective
  -- Radicals commute with the quotient map because the quotient map is surjective.
  calc
    (parameterIdeal xbar).radical
        = (Ideal.map (Ideal.Quotient.mk I) (parameterIdeal x)).radical := by rw [hmap.symm]
    _ = Ideal.map (Ideal.Quotient.mk I) (parameterIdeal x).radical := by
          symm
          exact Ideal.map_radical_of_surjective Ideal.Quotient.mk_surjective hker_le_parameter
    _ = Ideal.map (Ideal.Quotient.mk I) (maximalIdeal A) := by rw [hx.2]
    _ = maximalIdeal S := hmap_max

/-- Helper for Lemma 10.60.14: quotienting by the head parameter lowers the Krull dimension by
exactly one. -/
lemma ringKrullDim_quotient_head_eq_of_systemOfParameters {A : Type u} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing A] {d : ℕ} (x : Fin (d + 1) → maximalIdeal A)
    (hx : IsSystemOfParameters x) :
    ringKrullDim (A ⧸ headParameterIdeal x) = d := by
  let I : Ideal A := headParameterIdeal x
  let S := A ⧸ I
  letI : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr (headParameterIdeal_ne_top x)
  letI : IsLocalRing S :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let xbar : Fin d → maximalIdeal S := fun i ↦
    ⟨Ideal.Quotient.mk I (((x i.succ : maximalIdeal A) : A)), tail_image_mem_maximalIdeal x i⟩
  have hupper : ringKrullDim S ≤ d := by
    -- The quotient tail family is still a `d`-generated ideal of definition upstairs.
    exact ringKrullDim_le_of_exists_parameterIdeal (R := S) ⟨xbar,
      quotient_tail_parameterIdeal_isIdealOfDefinition (A := A) x hx⟩
  rcases ringKrullDim_eq_nat_of_le (R := S) hupper with ⟨n, hnle, hdimS⟩
  have hlower_succ : ((d + 1 : ℕ) : WithBot ℕ∞) ≤ ringKrullDim S + 1 := by
    -- Lemma 10.60.13 gives the one-step lower bound in the head quotient.
    simpa [I, S, headParameterIdeal, hx.1] using
      (ringKrullDim_le_ringKrullDim_quotient_span_singleton_add_one
        (R := A) (((x 0 : maximalIdeal A) : A)) (x 0).2)
  have hdle : d ≤ n := by
    have hsucc : (d + 1 : ℕ∞) ≤ n + 1 := by
      exact WithBot.coe_le_coe.mp <| by simpa [hdimS] using hlower_succ
    exact Nat.succ_le_succ_iff.mp <| by exact_mod_cast hsucc
  have hnd : n = d := le_antisymm hnle hdle
  -- The upper and lower bounds pin the quotient dimension down exactly.
  simpa [S, hnd] using hdimS

/-- Helper for Lemma 10.60.14: reassociating a family indexed by `Fin (m + 1 + n)` as a family
indexed by `Fin ((m + n) + 1)` does not change its entries. -/
def reassocParameterFamily {A : Type u} [CommRing A] [IsLocalRing A] {m n : ℕ}
    (x : Fin (m + 1 + n) → maximalIdeal A) : Fin ((m + n) + 1) → maximalIdeal A :=
  x ∘ Fin.cast (Nat.add_right_comm m 1 n).symm

/-- Helper for Lemma 10.60.14: the tail of a family indexed by `Fin (m + 1 + n)` is obtained by
shifting a `Fin (m + n)` index and then reassociating the sum. -/
def tailParameterIndex {m n : ℕ} : Fin (m + n) → Fin (m + 1 + n) :=
  fun i ↦ Fin.cast (Nat.add_right_comm m 1 n).symm i.succ

/-- Helper for Lemma 10.60.14: the quotient images of the reassociated tail still lie in the
quotient maximal ideal. -/
lemma tailParameterIndex_mem_maximalIdeal {A : Type u} [CommRing A] [IsLocalRing A] {m n : ℕ}
    (x : Fin (m + 1 + n) → maximalIdeal A)
    [IsLocalRing (A ⧸ headParameterIdeal (reassocParameterFamily x))] (i : Fin (m + n)) :
    Ideal.Quotient.mk (headParameterIdeal (reassocParameterFamily x))
        (((x (tailParameterIndex i) : maximalIdeal A) : A)) ∈
      maximalIdeal (A ⧸ headParameterIdeal (reassocParameterFamily x)) := by
  simpa [reassocParameterFamily, tailParameterIndex] using
    (tail_image_mem_maximalIdeal (x := reassocParameterFamily x) i)

/-- Helper for Lemma 10.60.14: after shifting past the head parameter, the first `m` remaining
indices are the original nonzero prefix indices. -/
lemma tailParameterIndex_castAdd_eq {m n : ℕ} (i : Fin m) :
    tailParameterIndex (m := m) (n := n) (Fin.castAdd n i) = Fin.castAdd n i.succ := by
  ext
  simp [tailParameterIndex]

/-- Helper for Lemma 10.60.14: reassociating the index set of a parameter family does not change
its generated ideal. -/
lemma parameterIdeal_reassoc_eq {A : Type u} [CommRing A] [IsLocalRing A] {m n : ℕ}
    (x : Fin (m + 1 + n) → maximalIdeal A) :
    parameterIdeal (reassocParameterFamily x) = parameterIdeal x := by
  rw [parameterIdeal_eq_span, parameterIdeal_eq_span]
  congr 1
  ext r
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast (Nat.add_right_comm m 1 n).symm i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast (Nat.add_right_comm m 1 n) i, by simp [reassocParameterFamily]⟩

/-- Helper for Lemma 10.60.14: after quotienting by the head parameter, the image of a longer
prefix ideal is exactly the prefix ideal generated by the quotient images of the tail. -/
lemma map_parameterIdeal_prefix_eq_tail_prefix {A : Type u} [CommRing A] [IsLocalRing A]
    {m n : ℕ} (x : Fin (m + 1 + n) → maximalIdeal A)
    [IsLocalRing (A ⧸ headParameterIdeal (reassocParameterFamily x))] :
    let y : Fin ((m + n) + 1) → maximalIdeal A := reassocParameterFamily x
    let I : Ideal A := headParameterIdeal y
    let S := A ⧸ I
    let xbar : Fin (m + n) → maximalIdeal S := fun i ↦
      ⟨Ideal.Quotient.mk I (((x (tailParameterIndex i) : maximalIdeal A) : A)),
        tailParameterIndex_mem_maximalIdeal x i⟩
    parameterIdeal (xbar ∘ Fin.castAdd n) =
      Ideal.map (Ideal.Quotient.mk I) (parameterIdeal (x ∘ Fin.castAdd n)) := by
  let y : Fin ((m + n) + 1) → maximalIdeal A := reassocParameterFamily x
  let I : Ideal A := headParameterIdeal y
  let S := A ⧸ I
  let xbar : Fin (m + n) → maximalIdeal S := fun i ↦
    ⟨Ideal.Quotient.mk I (((x (tailParameterIndex i) : maximalIdeal A) : A)),
      tailParameterIndex_mem_maximalIdeal x i⟩
  -- The longer prefix still contains the head generator, so the same map computation works after
  -- restricting to that prefix.
  suffices
      hspan :
        Ideal.span (Set.range fun i ↦ (((xbar ∘ Fin.castAdd n) i : maximalIdeal S) : S)) =
          Ideal.map (Ideal.Quotient.mk I)
            (Ideal.span (Set.range fun i ↦ (((x ∘ Fin.castAdd n) i : maximalIdeal A) : A))) by
    simpa [parameterIdeal_eq_span] using hspan
  rw [Ideal.map_span]
  apply le_antisymm
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    simpa [xbar, Function.comp, tailParameterIndex_castAdd_eq] using
      (Ideal.subset_span ⟨(((x ∘ Fin.castAdd n) i.succ : maximalIdeal A) : A), ⟨i.succ, rfl⟩, rfl⟩ :
        Ideal.Quotient.mk I ((((x ∘ Fin.castAdd n) i.succ : maximalIdeal A) : A)) ∈
          Ideal.span ((Ideal.Quotient.mk I) '' Set.range fun j ↦
            (((x ∘ Fin.castAdd n) j : maximalIdeal A) : A)))
  · refine Ideal.span_le.2 ?_
    rintro _ ⟨y, ⟨i, rfl⟩, rfl⟩
    refine Fin.cases ?_ ?_ i
    · have hx0 : Ideal.Quotient.mk I (((x ∘ Fin.castAdd n) 0 : maximalIdeal A) : A) = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem]
        dsimp [I, y, reassocParameterFamily, headParameterIdeal]
        simpa [reassocParameterFamily, Function.comp, Fin.castAdd_zero] using
          (Ideal.subset_span
            (by simp : (((y 0 : maximalIdeal A) : A)) ∈ ({((y 0 : maximalIdeal A) : A)} : Set A)))
      have hx0'' : (Ideal.Quotient.mk I) ((fun i ↦ (((x ∘ Fin.castAdd n) i : maximalIdeal A) : A)) 0) = 0 := by
        simpa [Function.comp] using hx0
      rw [hx0'']
      exact Ideal.zero_mem _
    · intro j
      simpa [xbar, Function.comp, tailParameterIndex_castAdd_eq] using
        (Ideal.subset_span ⟨j, rfl⟩ :
          (((xbar ∘ Fin.castAdd n) j : maximalIdeal S) : S) ∈
            Ideal.span (Set.range fun i ↦ (((xbar ∘ Fin.castAdd n) i : maximalIdeal S) : S)))

/-- Helper for Lemma 10.60.14: in a system of parameters of length `m + n`, quotienting by the
first `m` parameters leaves Krull dimension `n`. -/
lemma ringKrullDim_quotient_parameterIdeal_castAdd_eq_aux :
    ∀ m : ℕ, ∀ {A : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A] {n : ℕ},
      (x : Fin (m + n) → maximalIdeal A) → IsSystemOfParameters x →
        ringKrullDim (A ⧸ parameterIdeal (x ∘ Fin.castAdd n)) = n
  | 0, A, _, _, _, n, x, hx => by
      -- The empty prefix generates the zero ideal, so the quotient is just the original ring.
      have hbot : parameterIdeal (x ∘ Fin.castAdd n) = (⊥ : Ideal A) := by
        rw [parameterIdeal_eq_span]
        simp
      calc
        ringKrullDim (A ⧸ parameterIdeal (x ∘ Fin.castAdd n))
            = ringKrullDim (A ⧸ (⊥ : Ideal A)) := by rw [hbot]
        _ = ringKrullDim A := ringKrullDim_eq_of_ringEquiv (RingEquiv.quotientBot A)
        _ = n := by simpa using hx.1
  | m + 1, A, _, _, _, n, x, hx => by
      let y : Fin ((m + n) + 1) → maximalIdeal A := reassocParameterFamily x
      let I : Ideal A := headParameterIdeal y
      let S := A ⧸ I
      letI : Nontrivial S := Ideal.Quotient.nontrivial_iff.mpr (headParameterIdeal_ne_top y)
      letI : IsLocalRing S :=
        IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
      let xbar : Fin (m + n) → maximalIdeal S := fun i ↦
        ⟨Ideal.Quotient.mk I (((x (tailParameterIndex i) : maximalIdeal A) : A)),
          tailParameterIndex_mem_maximalIdeal x i⟩
      have hy : IsSystemOfParameters y := by
        refine (isSystemOfParameters_iff_of_ringKrullDim_eq ?_ y).2 ?_
        · simpa [y, Nat.add_right_comm m 1 n] using hx.1
        · have hparam : parameterIdeal y = parameterIdeal x := by
            simpa [y] using parameterIdeal_reassoc_eq (A := A) x
          exact hparam.symm ▸ hx.2
      have hdimS : ringKrullDim S = m + n := by
        -- The head quotient has exactly one less dimension.
        simpa [I, S, y] using ringKrullDim_quotient_head_eq_of_systemOfParameters (A := A) y hy
      have hsysbar : IsSystemOfParameters xbar := by
        -- The quotient tail is again a system of parameters in the head quotient.
        exact (isSystemOfParameters_iff_of_ringKrullDim_eq hdimS xbar).2 <|
          by
            simpa [xbar, y, reassocParameterFamily, tailParameterIndex] using
              quotient_tail_parameterIdeal_isIdealOfDefinition (A := A) y hy
      have hI_le_prefix : I ≤ parameterIdeal (x ∘ Fin.castAdd n) := by
        -- The longer prefix ideal still contains the head generator.
        dsimp [I, y, reassocParameterFamily, headParameterIdeal]
        exact (Ideal.span_singleton_le_iff_mem
          (I := parameterIdeal (x ∘ Fin.castAdd n)) (x := ((x 0 : maximalIdeal A) : A))).2 <|
          by
            rw [parameterIdeal_eq_span]
            exact Ideal.subset_span ⟨0, rfl⟩
      have hmap :
          parameterIdeal (xbar ∘ Fin.castAdd n) =
            Ideal.map (Ideal.Quotient.mk I) (parameterIdeal (x ∘ Fin.castAdd n)) := by
        -- Passing to the quotient only removes the head generator from the chosen prefix family.
        simpa [I, S, xbar, y, reassocParameterFamily, tailParameterIndex] using
          map_parameterIdeal_prefix_eq_tail_prefix (A := A) x
      let e :
          (S ⧸ parameterIdeal (xbar ∘ Fin.castAdd n)) ≃+*
            A ⧸ parameterIdeal (x ∘ Fin.castAdd n) :=
        (Ideal.quotEquivOfEq hmap).trans (DoubleQuot.quotQuotEquivQuotOfLE hI_le_prefix)
      calc
        ringKrullDim (A ⧸ parameterIdeal (x ∘ Fin.castAdd n))
            = ringKrullDim (S ⧸ parameterIdeal (xbar ∘ Fin.castAdd n)) := by
                symm
                exact ringKrullDim_eq_of_ringEquiv e
        _ = n := ringKrullDim_quotient_parameterIdeal_castAdd_eq_aux m xbar hsysbar

/-- Helper for Lemma 10.60.14: the `castAdd` induction statement specialized to the current ring. -/
lemma ringKrullDim_quotient_parameterIdeal_castAdd_eq {m n : ℕ}
    (x : Fin (m + n) → maximalIdeal R) (hx : IsSystemOfParameters x) :
    ringKrullDim (R ⧸ parameterIdeal (x ∘ Fin.castAdd n)) = n := by
  -- This is the fixed-ring specialization of the ambient induction theorem.
  exact ringKrullDim_quotient_parameterIdeal_castAdd_eq_aux m x hx

/-- Helper for Lemma 10.60.14: reindexing a parameter family along a `Fin`-cast does not change
its generated ideal. -/
lemma parameterIdeal_cast_eq {A : Type u} [CommRing A] [IsLocalRing A] {d e : ℕ}
    (h : e = d) (x : Fin d → maximalIdeal A) :
    parameterIdeal (x ∘ Fin.cast h) = parameterIdeal x := by
  -- A cast along an equality only reindexes the same finite family.
  rw [parameterIdeal_eq_span, parameterIdeal_eq_span]
  congr 1
  ext r
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast h i, rfl⟩
  · rintro ⟨i, rfl⟩
    exact ⟨Fin.cast h.symm i, by simp⟩

/-- Helper for Lemma 10.60.14: after reindexing a length-`d` family as a family of length
`i + (d - i)`, the `castAdd` prefix is the original `castLE` prefix. -/
lemma parameterIdeal_castLE_eq_parameterIdeal_castAdd {A : Type u} [CommRing A] [IsLocalRing A]
    {d i : ℕ} (x : Fin d → maximalIdeal A) (hi : i ≤ d) :
    let x' : Fin (i + (d - i)) → maximalIdeal A := x ∘ Fin.cast (Nat.add_sub_of_le hi)
    parameterIdeal (x ∘ Fin.castLE hi) = parameterIdeal (x' ∘ Fin.castAdd (d - i)) := by
  let x' : Fin (i + (d - i)) → maximalIdeal A := x ∘ Fin.cast (Nat.add_sub_of_le hi)
  -- The two prefixes pick the same first `i` entries after the obvious length identification.
  suffices
      hspan :
        Ideal.span (Set.range fun j ↦ (((x ∘ Fin.castLE hi) j : maximalIdeal A) : A)) =
          Ideal.span (Set.range fun j ↦ (((x' ∘ Fin.castAdd (d - i)) j : maximalIdeal A) : A)) by
    simpa [parameterIdeal_eq_span, x', Function.comp] using hspan
  congr 1

-- Source/core/bridge triage:
-- * source-facing: `ringKrullDim_quotient_parameterIdeal_eq_sub` states Lemma 10.60.14 for a
--   chosen system of parameters and the parameter ideals of its prefixes;
-- * core/canonical: `IsSystemOfParameters` together with `parameterIdeal` is the owner abstraction
--   for a chosen parameter family in `maximalIdeal R`, so the prefix ideal is derived as
--   `parameterIdeal (x ∘ Fin.castLE hi)` rather than stored as extra primitive data;
-- * bridge/view: `ringKrullDim_quotient_initialSegmentIdeal_eq_sub` converts an unbundled
--   sequence `x : Fin d → R` with the source generated-ideal hypothesis into that owner theorem.
-- Proof sketch: for `i > 0` one argues by induction on `i`. The step uses the one-element
-- dimension drop from Lemma 10.60.13 inside the quotient by the
-- first `i` generators and the fact that ideals of definition remain ideals of definition after
-- passing to successive quotients.
/-- Lemma 10.60.14, owner-level form: if `x : Fin d → maximalIdeal R` is a system of parameters,
then quotienting by the parameter ideal of its first `i` entries lowers the Krull dimension to
`d - i`. -/
theorem ringKrullDim_quotient_parameterIdeal_eq_sub {d i : ℕ} (x : Fin d → maximalIdeal R)
    (hx : IsSystemOfParameters x) (hi : i ≤ d) :
    ringKrullDim (R ⧸ parameterIdeal (x ∘ Fin.castLE hi)) = d - i := by
  let x' : Fin (i + (d - i)) → maximalIdeal R := x ∘ Fin.cast (Nat.add_sub_of_le hi)
  have hsys' : IsSystemOfParameters x' := by
    -- Reindex the full family first so the induction can run on a clean `castAdd` prefix.
    refine (isSystemOfParameters_iff_of_ringKrullDim_eq ?_ x').2 ?_
    · simpa [x', Nat.add_sub_of_le hi] using hx.1
    · have hparam : parameterIdeal x' = parameterIdeal x := by
        simpa [x'] using parameterIdeal_cast_eq (A := R) (Nat.add_sub_of_le hi) x
      exact hparam.symm ▸ hx.2
  have hprefix :
      parameterIdeal (x ∘ Fin.castLE hi) = parameterIdeal (x' ∘ Fin.castAdd (d - i)) := by
    -- This is the only remaining interface adjustment between `castLE` and `castAdd`.
    simpa [x'] using parameterIdeal_castLE_eq_parameterIdeal_castAdd (A := R) x hi
  -- The clean `castAdd` induction statement now closes the source-facing `castLE` theorem.
  calc
    ringKrullDim (R ⧸ parameterIdeal (x ∘ Fin.castLE hi))
        = ringKrullDim (R ⧸ parameterIdeal (x' ∘ Fin.castAdd (d - i))) := by rw [hprefix]
    _ = d - i := ringKrullDim_quotient_parameterIdeal_castAdd_eq x' hsys'

/-- Lemma 10.60.14 in bridge/view form: for an unbundled sequence `x : Fin d → R`, quotienting by
the ideal generated by any initial segment of a system of parameters lowers the dimension by its
length. The source's positive-length case is the corresponding specialization. -/
theorem ringKrullDim_quotient_initialSegmentIdeal_eq_sub {d i : ℕ} (x : Fin d → R)
    (hdef : Ideal.IsIdealOfDefinition (Ideal.span (Set.range x))) (hdim : ringKrullDim R = d)
    (hi : i ≤ d) :
    ringKrullDim (R ⧸ Ideal.span (Set.range (x ∘ Fin.castLE hi))) = d - i := by
  have hx : ∀ j, x j ∈ maximalIdeal R := fun j ↦ by
    rw [← hdef]
    exact Ideal.le_radical (Ideal.subset_span ⟨j, rfl⟩)
  let x' : Fin d → maximalIdeal R := fun j ↦ ⟨x j, hx j⟩
  have hsys : IsSystemOfParameters x' :=
    (isSystemOfParameters_iff_of_ringKrullDim_eq hdim x').2 <|
      by simpa [x', parameterIdeal_eq_span] using hdef
  simpa [x', parameterIdeal_eq_span] using
    ringKrullDim_quotient_parameterIdeal_eq_sub x' hsys hi

end
