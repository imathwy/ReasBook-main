import Mathlib
import stacks_project.Chap10.Lemma_10_97_7
import stacks_project.Chap10.Lemma_10_153_4

-- Declarations for this item will be appended below by the statement pipeline.

/-
Domain-style sampling pass for Example 10.119.5.

Primary domain: coefficient-generated purely inseparable extensions for formal power series,
together with the induced coefficient subring, its adic completion, and its fraction field.

Sampled owner declarations:
* `(_root_.frobenius k p).fieldRange`;
* `IntermediateField.adjoin`;
* `Subring.closure`;
* `maximalIdealCompletionMap`;
* `AdicCompletion.ofAlgEquiv`.

Owner abstraction: the source-facing coefficient ring is a `Subring (PowerSeries k)`, with the
coefficient field carried by the canonical owner `IntermediateField.adjoin` over `k^[p]`.
Completion and fraction-field statements should therefore stay directly on `AdicCompletion` and
`FractionRing`, and the subtype carriers should remain a bridge/view layer only.

Source/core/bridge triage:
* `source-facing`: `HasFinitePthPowerCoefficientField`, `finitePthPowerCoefficientSubring`, and
  `finitePthPowerCoefficientAdjoinSubring`;
* `core/canonical`: `IntermediateField.adjoin`, `Subring`, `AdicCompletion`, and `FractionRing`;
* `bridge/view`: subtype carriers such as `↥(finitePthPowerCoefficientSubring k p)` and the
  completion/fraction-field comparison maps.

Primitive vs derived:
* primitive data are the coefficient-generated intermediate field and the resulting source-facing
  subrings;
* discrete-valuation, completion, and fraction-field properties are derived API on those owners.
-/

noncomputable section

universe u

open PowerSeries IsLocalRing
open AdicCompletion

variable (k : Type u) [Field k] (p : ℕ) [Fact p.Prime] [ExpChar k p]

/-- The subfield `k^p` of `p`th powers inside `k`. -/
abbrev pthPowerSubfield : Subfield k :=
  (_root_.frobenius k p).fieldRange

namespace PthPowerSubfield

/- Textbook notation for the subfield `k^p` of `k`. -/
scoped notation:max K "^[" p "]" => pthPowerSubfield K p

end PthPowerSubfield

open scoped PthPowerSubfield

/-- The field generated over `k^p` by the coefficients of a power series. -/
abbrev coefficientAdjoinOverPthPowers (f : PowerSeries k) :
    IntermediateField (k^[p]) k :=
  IntermediateField.adjoin (k^[p]) (Set.range fun n : ℕ ↦ coeff n f)

/-- A power series whose coefficients generate a finite extension of `k^p`. -/
def HasFinitePthPowerCoefficientField (f : PowerSeries k) : Prop :=
  FiniteDimensional (k^[p]) (coefficientAdjoinOverPthPowers k p f)

-- Proof sketch: the zero series has all coefficients equal to `0`, so the coefficient field is
-- just `k^p`, hence finite over itself.
/-- The zero power series has finite coefficient field over `k^p`. -/
lemma hasFinitePthPowerCoefficientField_zero :
    HasFinitePthPowerCoefficientField k p (0 : PowerSeries k) := sorry

-- Proof sketch: the coefficients of `1` are `1, 0, 0, ...`, so adjoining them to `k^p` gives the
-- finite extension generated by the single element `1`.
/-- The constant series `1` has finite coefficient field over `k^p`. -/
lemma hasFinitePthPowerCoefficientField_one :
    HasFinitePthPowerCoefficientField k p (1 : PowerSeries k) := sorry

-- Proof sketch: the coefficients of `f + g` lie in the compositum of the two finite coefficient
-- fields attached to `f` and `g`, and a compositum of finite extensions is again finite.
/-- The finite-coefficient-field condition is closed under addition. -/
lemma hasFinitePthPowerCoefficientField_add {f g : PowerSeries k}
    (hf : HasFinitePthPowerCoefficientField k p f)
    (hg : HasFinitePthPowerCoefficientField k p g) :
    HasFinitePthPowerCoefficientField k p (f + g) := sorry

-- Proof sketch: each coefficient of `f * g` is a finite `k`-linear combination of products of
-- coefficients of `f` and `g`, so all coefficients lie in the same finite compositum field.
/-- The finite-coefficient-field condition is closed under multiplication. -/
lemma hasFinitePthPowerCoefficientField_mul {f g : PowerSeries k}
    (hf : HasFinitePthPowerCoefficientField k p f)
    (hg : HasFinitePthPowerCoefficientField k p g) :
    HasFinitePthPowerCoefficientField k p (f * g) := sorry

-- Proof sketch: negating a power series does not enlarge the field generated by its coefficients.
/-- The finite-coefficient-field condition is closed under negation. -/
lemma hasFinitePthPowerCoefficientField_neg {f : PowerSeries k}
    (hf : HasFinitePthPowerCoefficientField k p f) :
    HasFinitePthPowerCoefficientField k p (-f) := sorry

/-- The subring `A ⊆ k[[x]]` of power series whose coefficients generate a finite extension of
`k^p`. -/
def finitePthPowerCoefficientSubring : Subring (PowerSeries k) where
  carrier := {f | HasFinitePthPowerCoefficientField k p f}
  zero_mem' := hasFinitePthPowerCoefficientField_zero k p
  add_mem' := fun hf hg ↦ hasFinitePthPowerCoefficientField_add k p hf hg
  one_mem' := hasFinitePthPowerCoefficientField_one k p
  mul_mem' := fun hf hg ↦ hasFinitePthPowerCoefficientField_mul k p hf hg
  neg_mem' := fun hf ↦ hasFinitePthPowerCoefficientField_neg k p hf

/-- The subring `R = A[f]` generated by `A` and one extra power series `f`. -/
def finitePthPowerCoefficientAdjoinSubring (f : PowerSeries k) : Subring (PowerSeries k) :=
  Subring.closure (Set.insert f (finitePthPowerCoefficientSubring k p : Set (PowerSeries k)))

local notation "A" => finitePthPowerCoefficientSubring k p

-- Proof sketch: in characteristic `p`, the coefficientwise Frobenius sends `f.expand p` to `f^p`,
-- so every coefficient of `f^p` is a `p`th power in `k`, hence belongs to `k^p`.
/-- Every `p`th power in `k[[x]]` already lies in the coefficient subring `A`. -/
theorem pow_mem_finitePthPowerCoefficientSubring (f : PowerSeries k) :
    f ^ p ∈ A := sorry

/-- The coefficient subring `A` is contained in each adjoined ring `A[f]`. -/
theorem finitePthPowerCoefficientSubring_le_adjoinSubring (f : PowerSeries k) :
    A ≤ finitePthPowerCoefficientAdjoinSubring k p f := by
  intro g hg
  exact Subring.subset_closure (Set.mem_insert_of_mem f hg)

/-- The source-facing subring `A[f]` is exactly the canonical `A`-subalgebra generated by `f`,
viewed as a subring of `k[[x]]`. -/
theorem finitePthPowerCoefficientAdjoinSubring_eq_adjoin_toSubring (f : PowerSeries k) :
    (Algebra.adjoin ↥A ({f} : Set (PowerSeries k))).toSubring =
      finitePthPowerCoefficientAdjoinSubring k p f := sorry

/-- The canonical inclusion `A ⊆ A[f]` equips `A[f]` with its natural `A`-algebra structure. -/
instance finitePthPowerCoefficientAdjoinSubring_algebra (f : PowerSeries k) :
    Algebra ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f) :=
  RingHom.toAlgebra <|
    Subring.inclusion (finitePthPowerCoefficientSubring_le_adjoinSubring k p f)

-- Proof sketch: `f^p ∈ A`, so `f` satisfies the monic polynomial `X^p - f^p` over `A`.
/-- The adjoined generator `f` is integral over the coefficient subring `A`. -/
theorem finitePthPowerCoefficientAdjoinSubring_isIntegral (f : PowerSeries k) :
    IsIntegral ↥A f := sorry

-- Proof sketch: `A[f]` is the canonical simple `A`-algebra generated by the integral element `f`,
-- so it is module-finite over `A`.
/-- The extension `A ⊆ A[f]` is finite. -/
theorem finitePthPowerCoefficientAdjoinSubring_moduleFinite (f : PowerSeries k) :
    Module.Finite ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f) := sorry

/-- The induced fraction-field algebra `Frac(A) → Frac(A[f])`. -/
noncomputable instance finitePthPowerCoefficientAdjoinSubring_fractionRingAlgebra
    (f : PowerSeries k) :
    Algebra (FractionRing ↥A)
      (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) :=
  RingHom.toAlgebra
    (IsFractionRing.map
      (show Function.Injective
          (algebraMap ↥A ↥(finitePthPowerCoefficientAdjoinSubring k p f)) from by
        intro x y h
        cases x
        cases y
        cases h
        rfl))

-- Proof sketch: the fraction field of `A[f]` is generated over `Frac(A)` by the image of `f`,
-- and that generator has its `p`th power in `Frac(A)`.
/-- The induced fraction-field extension `Frac(A) ⊆ Frac(A[f])` is purely inseparable. -/
theorem finitePthPowerCoefficientAdjoinSubring_fractionRing_isPurelyInseparable
    (f : PowerSeries k) :
    IsPurelyInseparable (FractionRing ↥A)
      (FractionRing ↥(finitePthPowerCoefficientAdjoinSubring k p f)) := sorry

-- Proof sketch: choose coefficients in `k` whose `k^p`-span has unbounded finite-dimensional
-- subextensions, then package them into a formal power series.
/-- If `k` has infinite degree over `k^p`, then some power series does not belong to `A`. -/
lemma exists_not_mem_finitePthPowerCoefficientSubring
    (hnfd : ¬ FiniteDimensional (k^[p]) k) :
    ∃ f : PowerSeries k, f ∉ A := sorry

-- Proof sketch: use the `x`-adic valuation on `k[[x]]`; the coefficient-field finiteness
-- condition is preserved under the valuation-ring operations, and the resulting subring is exactly
-- the valuation ring of the induced discrete valuation.
/-- The coefficient subring `A` is a discrete valuation ring. -/
theorem finitePthPowerCoefficientSubring_isDiscreteValuationRing :
    IsDiscreteValuationRing ↥A := sorry

/-- The coefficient subring inherits its canonical discrete valuation ring structure. -/
instance : IsDiscreteValuationRing ↥A :=
  finitePthPowerCoefficientSubring_isDiscreteValuationRing k p

/-- The induced fraction-field algebra `Frac(A) → Frac(k[[x]])`. -/
noncomputable instance finitePthPowerCoefficientSubring_fractionRingAlgebra :
    Algebra (FractionRing ↥A) (FractionRing (PowerSeries k)) :=
  RingHom.toAlgebra
    (IsFractionRing.map
      (show Function.Injective (algebraMap ↥A (PowerSeries k)) from fun _ _ h ↦ Subtype.ext h))

section SourceFacing

local instance :
    IsLocalHom (algebraMap ↥A (PowerSeries k)) :=
  by
    sorry

local instance : IsAdicComplete (maximalIdeal (PowerSeries k)) (PowerSeries k) :=
  by
    sorry

-- Proof sketch: `A` is a discrete valuation subring of `k[[x]]` with the same uniformizer `x`,
-- so the maximal-ideal adic topology on `A` is the one induced from the `x`-adic topology on the
-- ambient complete DVR `k[[x]]`; completeness of `k[[x]]` then identifies it with the completion
-- of `A`.
/-- The maximal-ideal adic completion of the coefficient ring `A` is canonically `A`-algebra
isomorphic to `k[[x]]`. -/
noncomputable def finitePthPowerCoefficientSubringCompletionAlgEquivPowerSeries :
    AdicCompletion (maximalIdeal ↥A) ↥A ≃ₐ[↥A]
      PowerSeries k :=
  let φ :
      AdicCompletion (maximalIdeal ↥A) ↥A →ₐ[↥A] PowerSeries k :=
    { toRingHom :=
        ((AdicCompletion.ofAlgEquiv (maximalIdeal (PowerSeries k))).symm.toRingHom.comp
          (maximalIdealCompletionMap (algebraMap ↥A (PowerSeries k))))
      commutes' := by
        sorry }
  AlgEquiv.ofBijective φ <| by
    sorry

/-- The canonical completion comparison sends the image of `a : A` to the same power series in
`k[[x]]`. -/
@[simp]
theorem finitePthPowerCoefficientSubringCompletionAlgEquivPowerSeries_of
    (a : ↥A) :
    finitePthPowerCoefficientSubringCompletionAlgEquivPowerSeries k p
      (AdicCompletion.of (maximalIdeal ↥A) ↥A a) = a := sorry

-- Proof sketch: every element of `Frac(k[[x]])` becomes a `p^n`th power over `Frac(A)` after
-- clearing coefficients, because `A` contains exactly the power series whose coefficient field is
-- finite over `k^p`; choosing coefficients with unbounded `k^p`-degree forces the induced
-- fraction-field extension to be non-finite-dimensional.
/-- If `k` has infinite degree over `k^p`, then the inclusion
`Frac(A) ⊂ Frac(k[[x]])` is an infinite purely inseparable extension. -/
theorem finitePthPowerCoefficientSubring_fractionRing_infinite_purelyInseparable
    (hnfd : ¬ FiniteDimensional (k^[p]) k) :
    IsPurelyInseparable (FractionRing ↥A) (FractionRing (PowerSeries k)) ∧
      ¬ FiniteDimensional (FractionRing ↥A) (FractionRing (PowerSeries k)) := sorry

end SourceFacing

-- Proof sketch: if `f ∈ A` then `R = A`, so the result comes from the DVR structure on `A`;
-- otherwise apply the one-dimensional Krull-Akizuki argument to the overring `R`.
/-- The adjoined ring `R = A[f]` is Noetherian. -/
theorem finitePthPowerCoefficientAdjoinSubring_isNoetherianRing
    (f : PowerSeries k) :
    IsNoetherianRing ↥(finitePthPowerCoefficientAdjoinSubring k p f) := sorry

-- Proof sketch: if `f ∈ A` then `R = A`, and otherwise `R` still sits between the DVR `A` and
-- the complete local ring `k[[x]]`, with maximal ideal induced by the `x`-adic valuation.
/-- The adjoined ring `R = A[f]` is local. -/
theorem finitePthPowerCoefficientAdjoinSubring_isLocal
    (f : PowerSeries k) :
    IsLocalRing ↥(finitePthPowerCoefficientAdjoinSubring k p f) := sorry

instance
    (f : PowerSeries k) :
    IsLocalRing ↥(finitePthPowerCoefficientAdjoinSubring k p f) :=
  finitePthPowerCoefficientAdjoinSubring_isLocal k p f

section AdjoinedRing

variable (f : PowerSeries k)

local notation "R" => finitePthPowerCoefficientAdjoinSubring k p f
local notation "ACompletion" => AdicCompletion (maximalIdeal ↥A) ↥A
local notation "RCompletion" => AdicCompletion (maximalIdeal ↥R) ↥R

/-- Helper for Example 10.119.5: the integral inclusion `A → A[f]` is a local homomorphism, so it
induces a map on maximal-ideal completions. -/
local instance : IsLocalHom (algebraMap ↥A ↥R) := by
  -- Use the finite-local bridge once, instead of leaving instance search to rediscover it in
  -- every completion map.
  letI : Module.Finite ↥A ↥R :=
    finitePthPowerCoefficientAdjoinSubring_moduleFinite k p f
  exact algebraMap_isLocalHom_of_finite_local

/-- A nonzero element with a vanishing power certifies that the ambient ring is not reduced. -/
lemma not_isReduced_of_exists_ne_zero_pow_eq_zero
    {S : Type*} [MonoidWithZero S] {z : S} {n : ℕ}
    (hz : z ≠ 0) (hzpow : z ^ n = 0) :
    ¬ IsReduced S := by
  -- In a reduced ring, every nilpotent element must vanish.
  intro hred
  exact hz (eq_zero_of_pow_eq_zero hzpow)

/-- Helper for Example 10.119.5: the distinguished completed generator coming from the adjoined
power series `f`. -/
private noncomputable def adjoined_completion_generator :
    RCompletion :=
  AdicCompletion.of (maximalIdeal ↥R) ↥R
    ⟨f, Subring.subset_closure (Set.mem_insert f (finitePthPowerCoefficientSubring k p))⟩

/-- Helper for Example 10.119.5: the element of `A^` corresponding to the ambient series `f`
under the completion comparison `A^ ≃ k[[x]]`. -/
private noncomputable def completion_base_series_lift :
    ACompletion :=
  (finitePthPowerCoefficientSubringCompletionAlgEquivPowerSeries k p).symm f

/-- Helper for Example 10.119.5: the lift of the ambient series `f` from `A^` into `R^`. -/
private noncomputable def adjoined_completion_base_lift :
    RCompletion :=
  maximalIdealCompletionMap (algebraMap ↥A ↥R)
    (completion_base_series_lift (k := k) (p := p) (f := f))

/-- Helper for Example 10.119.5: the completed generator and the base lift have the same `p`th
power, so their difference is `p`-nilpotent. -/
lemma completion_generator_minus_baseLift_pow_eq_zero :
    (adjoined_completion_generator (k := k) (p := p) (f := f) -
        adjoined_completion_base_lift (k := k) (p := p) (f := f)) ^ p = 0 := by
  -- TODO: compare both `p`th powers with the common image of `f ^ p ∈ A`, then check the
  -- equality on every completion quotient where the characteristic-`p` Frobenius identity
  -- applies.
  sorry

/-- Helper for Example 10.119.5: if the completed generator equals the base lift, then the
original series `f` already lies in `A`. -/
lemma completion_generator_eq_baseLift_imp_mem_base
    (hEq :
      adjoined_completion_generator (k := k) (p := p) (f := f) =
        adjoined_completion_base_lift (k := k) (p := p) (f := f)) :
    f ∈ A := by
  -- Route correction: the old route jumped directly from equality in the completion to
  -- `f ∈ A`; the missing step is a source-faithful descent argument showing that the completion
  -- comparison `A^ → R^` is surjective and then reflecting that surjectivity back to `A → R`.
  -- TODO: prove surjectivity of `maximalIdealCompletionMap (algebraMap ↥A ↥R)` from `hEq` using
  -- the tensor-product description of the completion of the finite `A`-algebra `R`, then descend
  -- surjectivity of `algebraMap ↥A ↥R` by faithful flatness of `A → A^`.
  sorry

/-- Helper for Example 10.119.5: if `f ∉ A`, then the maximal-ideal completion of `A[f]`
contains a nonzero element whose `p`th power is zero. -/
lemma completion_exists_nonzero_p_nilpotent_of_not_mem
    (hf : f ∉ A) :
    ∃ z : AdicCompletion (maximalIdeal ↥R) ↥R, z ≠ 0 ∧ z ^ p = 0 := by
  let z : RCompletion :=
    adjoined_completion_generator (k := k) (p := p) (f := f) -
      adjoined_completion_base_lift (k := k) (p := p) (f := f)
  refine ⟨z, ?_, ?_⟩
  · -- If the witness vanished, the completed generator would come from the base completion.
    intro hz
    apply hf
    exact completion_generator_eq_baseLift_imp_mem_base (k := k) (p := p) (f := f) <| by
      simpa [z, sub_eq_zero] using hz
  · -- The explicit witness is `p`-nilpotent by the Frobenius computation above.
    simpa [z] using completion_generator_minus_baseLift_pow_eq_zero
      (k := k) (p := p) (f := f)

-- Proof sketch: if `f ∈ A` then `R = A`, whose Krull dimension is `1`; otherwise apply the
-- one-dimensional Krull-Akizuki argument to the overring `R` of the DVR `A`.
/-- The adjoined ring `R = A[f]` has Krull dimension `1`. -/
theorem finitePthPowerCoefficientAdjoinSubring_ringKrullDim_eq_one
    : ringKrullDim ↥R = 1 := sorry

-- Proof sketch: after `x`-adic completion, the adjoined element satisfies a purely inseparable
-- polynomial over the completion of `A`, so the completed algebra acquires nilpotents and cannot
-- be reduced.
/-- Example 10.119.5: if `A ⊆ k[[x]]` is the coefficient subring above and `f ∉ A`, then the ring
`R = A[f]` has nonreduced completion at its maximal ideal. -/
theorem finitePthPowerCoefficientAdjoinSubring_completion_not_reduced
    (hf : f ∉ A) :
    ¬ IsReduced (AdicCompletion (maximalIdeal ↥R) ↥R) := by
  -- The source proof produces an explicit nonzero `p`-nilpotent in the completed ring.
  obtain ⟨z, hz, hzpow⟩ := completion_exists_nonzero_p_nilpotent_of_not_mem
    (k := k) (p := p) (f := f) hf
  -- Any reduced ring kills nilpotents, so this witness excludes reducedness.
  exact not_isReduced_of_exists_ne_zero_pow_eq_zero hz hzpow

end AdjoinedRing
