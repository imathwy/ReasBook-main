import Mathlib.Algebra.MvPolynomial.Basic
import Mathlib.Data.List.OfFn
import Mathlib.Data.List.TFAE
import Mathlib.RingTheory.Regular.RegularSequence
import Mathlib.Tactic.TFAE

-- Declarations for this item will be appended below by the statement pipeline.

universe u

open scoped Pointwise

open RingTheory.Sequence MvPolynomial
open Ideal

section

variable {R : Type u} [CommRing R]

/-- Helper for Lemma 10.68.10: if an appended list is regular, then its left prefix is already
regular. -/
lemma isRegular_left_of_isRegular_append {M : Type*} [AddCommGroup M] [Module R M]
    {rs ts : List R} (hreg : IsRegular M (rs ++ ts)) :
    IsRegular M rs := by
  refine ⟨((isWeaklyRegular_append_iff (M := M) rs ts).mp hreg.toIsWeaklyRegular).1, ?_⟩
  intro htop
  -- The larger ideal contains the prefix ideal, so prefix-triviality would force total triviality.
  have hle :
      Ideal.ofList rs • (⊤ : Submodule R M) ≤
        Ideal.ofList (rs ++ ts) • (⊤ : Submodule R M) := by
    rw [Ideal.ofList_append]
    exact Submodule.smul_mono_left le_sup_left
  have htop_le :
      (⊤ : Submodule R M) ≤ Ideal.ofList (rs ++ ts) • (⊤ : Submodule R M) := by
    calc
      (⊤ : Submodule R M) = Ideal.ofList rs • (⊤ : Submodule R M) := htop
      _ ≤ Ideal.ofList (rs ++ ts) • (⊤ : Submodule R M) := hle
  have htop' : (⊤ : Submodule R M) = Ideal.ofList (rs ++ ts) • (⊤ : Submodule R M) := by
    exact (le_antisymm le_top htop_le).symm
  exact hreg.top_ne_smul htop'

/-- Helper for Lemma 10.68.10: if every permutation of `fs` is regular, then every ordered
sublist of `fs` is regular. -/
lemma isRegular_of_sublist_of_forall_perm_regular {fs : List R}
    (hperm : ∀ gs : List R, List.Perm gs fs → IsRegular R gs)
    {gs : List R} (hsub : List.Sublist gs fs) :
    IsRegular R gs := by
  -- Extend the ordered sublist to a permutation of the ambient list, then forget the tail.
  rcases List.Sublist.exists_perm_append hsub with ⟨ts, hts⟩
  exact isRegular_left_of_isRegular_append (M := R) (hperm (gs ++ ts) hts.symm)

/-- Helper for Lemma 10.68.10: permuting a list does not change the ideal generated by its
entries. -/
lemma ofList_eq_of_perm {rs ts : List R} (hperm : List.Perm rs ts) :
    Ideal.ofList rs = Ideal.ofList ts := by
  -- The spanning set only depends on element membership, which is permutation-invariant.
  refine congrArg Ideal.span <| Set.ext fun r => by
    simpa using hperm.mem_iff

/-- Helper for Lemma 10.68.10: an ordered sublist generates an ideal contained in the ideal of the
ambient list. -/
lemma ofList_le_of_sublist {rs ts : List R} (hsub : List.Sublist rs ts) :
    Ideal.ofList rs ≤ Ideal.ofList ts := by
  -- Every generator of the sublist ideal is also a generator of the ambient ideal.
  refine Ideal.span_le.mpr ?_
  intro r hr
  exact Ideal.subset_span (hsub.subset hr)

/-- Helper for Lemma 10.68.10: an ordered sublist of a proper list still generates a proper
ideal. -/
lemma ofList_ne_top_of_sublist {rs ts : List R} (hts : Ideal.ofList ts ≠ ⊤)
    (hsub : List.Sublist rs ts) :
    Ideal.ofList rs ≠ ⊤ := by
  -- If the sublist ideal were the whole ring, the ambient ideal would be too by monotonicity.
  intro hrs
  apply hts
  refine le_antisymm le_top ?_
  calc
    (⊤ : Ideal R) = Ideal.ofList rs := hrs.symm
    _ ≤ Ideal.ofList ts := ofList_le_of_sublist hsub

/-- Helper for Lemma 10.68.10: weak regularity plus properness of the generated ideal upgrades to
regularity over `R`. -/
lemma isRegular_of_isWeaklyRegular_of_ofList_ne_top {rs : List R}
    (hweak : IsWeaklyRegular R rs) (hrs : Ideal.ofList rs ≠ ⊤) :
    IsRegular R rs := by
  -- Over the module `R`, the final quotient is nontrivial exactly when the generated ideal is
  -- proper.
  refine ⟨hweak, ?_⟩
  simpa [smul_eq_mul] using hrs.symm

/-- Helper for Lemma 10.68.10: a length-two weakly regular sequence can be swapped when the
second element is already regular on the ambient module. -/
lemma isWeaklyRegular_pair_swap_of_second_regular {M : Type*} [AddCommGroup M] [Module R M]
    {a b : R} (hpair : IsWeaklyRegular M [a, b]) (hb : IsSMulRegular M b) :
    IsWeaklyRegular M [b, a] := by
  -- Follow the mathlib prototype swap argument; ambient regularity of `b` supplies the
  -- saturation conclusion needed in the kernel comparison.
  have hsaturates :
      Submodule.torsionBy R M b = a • Submodule.torsionBy R M b →
        Submodule.torsionBy R M b = ⊥ := by
    intro _
    rwa [← isSMulRegular_iff_torsionBy_eq_bot M b]
  rw [isWeaklyRegular_cons_iff, isWeaklyRegular_singleton_iff] at hpair ⊢
  obtain ⟨ha, hab⟩ := hpair
  rw [← isSMulRegular_iff_torsionBy_eq_bot M b] at hsaturates
  specialize hsaturates
    (le_antisymm ?_ (Submodule.smul_le_self_of_tower a (Submodule.torsionBy R M b)))
  · refine le_of_eq_of_le ?_ <| smul_top_inf_eq_smul_of_isSMulRegular_on_quot <|
        ha.of_injective _ <| LinearMap.ker_eq_bot.mp <|
          Submodule.ker_liftQ_eq_bot' _ (LinearMap.lsmul R M b) rfl
    rw [← (isSMulRegular_on_quot_iff_lsmul_comap_eq _ _).mp hab]
    exact (inf_eq_right.mpr (LinearMap.ker_le_comap _)).symm
  · rwa [ha.isSMulRegular_on_quot_iff_smul_top_inf_eq_smul, inf_comm, smul_comm,
      ← hsaturates.isSMulRegular_on_quot_iff_smul_top_inf_eq_smul, and_iff_left hab]

/-- Helper for Lemma 10.68.10: a length-two regular sequence can be swapped once the second
element is known to be a non-zero-divisor on the ambient module. -/
lemma isRegular_pair_swap_of_second_regular {M : Type*} [AddCommGroup M] [Module R M]
    {a b : R} (hpair : IsRegular M [a, b]) (hb : IsSMulRegular M b) :
    IsRegular M [b, a] := by
  refine ⟨isWeaklyRegular_pair_swap_of_second_regular hpair.toIsWeaklyRegular hb, ?_⟩
  -- The final quotient only depends on the generated ideal, which is unchanged by swapping.
  intro htop
  apply hpair.top_ne_smul
  have hswap : Ideal.ofList [b, a] = Ideal.ofList [a, b] := by
    refine congrArg Ideal.span <| Set.ext fun x => by
      simp [List.mem_cons, or_comm]
  simpa [hswap] using htop

/-- Helper for Lemma 10.68.10: a permutation of two snoc decompositions either keeps the same
final element, or the left final element occurs earlier in the right list. -/
lemma perm_append_singleton_cases {hs ts : List R} {a b : R}
    (hperm : List.Perm (hs ++ [a]) (ts ++ [b])) :
    (a = b ∧ List.Perm hs ts) ∨
      ∃ ls ms, ts = ls ++ a :: ms ∧ List.Perm hs (ls ++ ms ++ [b]) := by
  classical
  -- Track where the final element `a` lands in the right-hand list.
  have hmem : a ∈ ts ++ [b] := by
    exact hperm.mem_iff.mp (by simp)
  by_cases hab : a = b
  · left
    subst a
    constructor
    · rfl
    · -- Move the common final element to the front on both sides and cancel it.
      have hleft : List.Perm (hs ++ [b]) (b :: hs) := by
        simpa using
          (List.perm_middle : List.Perm (hs ++ b :: []) (b :: (hs ++ [])))
      have hright : List.Perm (ts ++ [b]) (b :: ts) := by
        simpa using
          (List.perm_middle : List.Perm (ts ++ b :: []) (b :: (ts ++ [])))
      have hmid : List.Perm (b :: hs) (b :: ts) := hleft.symm.trans (hperm.trans hright)
      exact hmid.cons_inv
  · right
    have hmem_ts : a ∈ ts := by
      simpa [hab] using hmem
    rcases List.mem_iff_getElem.mp hmem_ts with ⟨n, hn, hna⟩
    let ls : List R := ts.take n
    let ms : List R := ts.drop (n + 1)
    have hts : ts = ls ++ a :: ms := by
      calc
        ts = ts.take n ++ ts.drop n := (List.take_append_drop n ts).symm
        _ = ts.take n ++ ts[n] :: ts.drop (n + 1) := by
          rw [List.drop_eq_getElem_cons hn]
        _ = ts.take n ++ a :: ts.drop (n + 1) := by rw [hna]
        _ = ls ++ a :: ms := by rfl
    refine ⟨ls, ms, hts, ?_⟩
    -- Move the common element `a` to the front and cancel it.
    have hleft : List.Perm (hs ++ [a]) (a :: hs) := by
      simpa using
        (List.perm_middle : List.Perm (hs ++ a :: []) (a :: (hs ++ [])))
    rw [hts, List.append_assoc] at hperm
    have hright : List.Perm (ls ++ (a :: ms ++ [b])) (a :: (ls ++ ms ++ [b])) := by
      simpa [List.append_assoc] using
        (List.perm_middle : List.Perm (ls ++ a :: (ms ++ [b])) (a :: (ls ++ (ms ++ [b]))))
    have hmid : List.Perm (a :: hs) (a :: (ls ++ ms ++ [b])) :=
      hleft.symm.trans (hperm.trans hright)
    exact hmid.cons_inv

/-- Helper for Lemma 10.68.10: if `rs ++ [r]` is regular, then after quotienting by the prefix
ideal the singleton tail `[r]` is already a regular sequence. -/
lemma isRegular_singleton_on_prefix_quotient_of_isRegular_append_singleton {M : Type*}
    [AddCommGroup M] [Module R M] {rs : List R} {r : R}
    (hreg : IsRegular M (rs ++ [r])) :
    IsRegular (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) [r] := by
  have hr :
      IsSMulRegular (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) r := by
    -- The append decomposition isolates the singleton tail on the prefix quotient.
    have htail :
        IsWeaklyRegular (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)))
          ([r].map (Ideal.Quotient.mk (Ideal.ofList rs))) := by
      exact ((isWeaklyRegular_append_iff' (M := M) rs [r]).mp hreg.toIsWeaklyRegular).2
    simpa using
      (isWeaklyRegular_singleton_iff
        (M := M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)))
        (Ideal.Quotient.mk (Ideal.ofList rs) r)).mp htail
  have hnontrivial_full :
      Nontrivial (M ⧸ (Ideal.ofList (rs ++ [r]) • (⊤ : Submodule R M))) := by
    -- The final quotient for `rs ++ [r]` stays nontrivial because the original list is regular.
    exact Submodule.Quotient.nontrivial_iff.mpr hreg.top_ne_smul.symm
  have hEq :
      Ideal.ofList (rs ++ [r]) • (⊤ : Submodule R M) =
        Ideal.ofList (r :: rs) • (⊤ : Submodule R M) := by
    -- Reordering generators does not change the ideal acting on the ambient module.
    simp [Ideal.ofList_append, Ideal.ofList_cons, sup_comm]
  let efull :
      (M ⧸ (Ideal.ofList (rs ++ [r]) • (⊤ : Submodule R M))) ≃ₗ[R]
        ((M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ⧸
          (r • (⊤ : Submodule R (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)))))) :=
    (Submodule.quotEquivOfEq _ _ hEq).trans
      (Submodule.quotOfListConsSMulTopEquivQuotSMulTopOuter (M := M) r rs)
  have hnontrivial_q :
      Nontrivial
        ((M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ⧸
          (r • (⊤ : Submodule R (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)))))) :=
    -- Transport the nontriviality of the full quotient to the quotient-by-`r` of the prefix one.
    (efull.toEquiv.nontrivial_congr).1 hnontrivial_full
  have hnil :
      IsRegular
        ((M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) ⧸
          (r • (⊤ : Submodule R (M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M)))))) ([] : List R) := by
    -- The empty sequence is regular on any nontrivial quotient module.
    letI := hnontrivial_q
    exact IsRegular.nil R _
  -- Reassemble the singleton regularity from regularity of `r` and the nontrivial final quotient.
  exact (isRegular_cons_iff (M := M ⧸ (Ideal.ofList rs • (⊤ : Submodule R M))) r []).2
    ⟨hr, hnil⟩

/-- Helper for Lemma 10.68.10: if both reordered prefixes from the source proof are regular, then
the common quotient by the shared earlier prefix sees `[a, b]` as a regular sequence. -/
lemma regular_pair_in_common_quotient_of_regular_reordered_prefix
    {ls ms : List R} {a b : R}
    (ha : IsRegular R (ls ++ ms ++ [a]))
    (hab : IsRegular R (ls ++ a :: ms ++ [b])) :
    IsRegular (R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R))) [a, b] := by
  have ha_single :
      IsRegular (R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R))) [a] :=
    -- First isolate `a` on the quotient by the common earlier prefix.
    isRegular_singleton_on_prefix_quotient_of_isRegular_append_singleton (M := R)
      (rs := ls ++ ms) (r := a) ha
  have hb_single :
      IsRegular (R ⧸ (Ideal.ofList (ls ++ a :: ms) • (⊤ : Ideal R))) [b] :=
    -- Then isolate `b` on the quotient by the reordered prefix from the source snoc step.
    isRegular_singleton_on_prefix_quotient_of_isRegular_append_singleton (M := R)
      (rs := ls ++ a :: ms) (r := b) hab
  have hEq :
      Ideal.ofList (ls ++ a :: ms) • (⊤ : Ideal R) =
        Ideal.ofList (a :: (ls ++ ms)) • (⊤ : Ideal R) := by
    -- The two prefixes generate the same ideal, so their quotient modules are canonically equal.
    have hIdeals : Ideal.ofList (ls ++ a :: ms) = Ideal.ofList (a :: (ls ++ ms)) := by
      simp [Ideal.ofList_append, Ideal.ofList_cons, sup_assoc, sup_comm]
    exact congrArg (fun I : Ideal R ↦ I • (⊤ : Ideal R)) hIdeals
  let e :
      (R ⧸ (Ideal.ofList (ls ++ a :: ms) • (⊤ : Ideal R))) ≃ₗ[R]
        ((R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R))) ⧸
          (a • (⊤ : Submodule R (R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R)))))) :=
    (Submodule.quotEquivOfEq _ _ hEq).trans
      (Submodule.quotOfListConsSMulTopEquivQuotSMulTopOuter (M := R) a (ls ++ ms))
  have hb_tail :
      IsRegular
        ((R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R))) ⧸
          (a • (⊤ : Submodule R (R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R)))))) [b] := by
    -- Transport the singleton regularity of `b` to the quotient after first modding out by `a`.
    exact (e.isRegular_congr [b]).1 hb_single
  have ha_reg : IsSMulRegular (R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R))) a := by
    -- The head element `a` is regular on the common quotient because `[a]` is already regular there.
    simpa using
      ((isRegular_cons_iff (M := R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R))) a []).1
        ha_single).1
  -- Reassemble `[a, b]` from the regularity of `a` and the regular singleton tail of `b`.
  exact (isRegular_cons_iff (M := R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R))) a [b]).2
    ⟨ha_reg, hb_tail⟩

/-- Helper for Lemma 10.68.10: if `Ideal.ofList fs` is proper, then `R` is nontrivial. -/
lemma nontrivial_of_ofList_ne_top {fs : List R} (hfs : Ideal.ofList fs ≠ ⊤) : Nontrivial R := by
  rcases subsingleton_or_nontrivial R with hR | hR
  · exact False.elim <| hfs <| Subsingleton.elim _ _
  · exact hR

/-- Helper for Lemma 10.68.10: regularity of the last element in `us ++ [a]` transports across a
permutation of the prefix. -/
lemma isSMulRegular_of_regular_append_singleton_on_permuted_prefix {M : Type*}
    [AddCommGroup M] [Module R M] {ts us : List R} {a : R}
    (hperm : List.Perm ts us) (hreg : IsRegular M (us ++ [a])) :
    IsSMulRegular (M ⧸ (Ideal.ofList ts • (⊤ : Submodule R M))) a := by
  have hsingle :
      IsRegular (M ⧸ (Ideal.ofList us • (⊤ : Submodule R M))) [a] :=
    -- Peel the last singleton off the ordered list before transporting the quotient.
    isRegular_singleton_on_prefix_quotient_of_isRegular_append_singleton (M := M)
      (rs := us) (r := a) hreg
  have ha :
      IsSMulRegular (M ⧸ (Ideal.ofList us • (⊤ : Submodule R M))) a := by
    -- A regular singleton is exactly a regular element on the prefix quotient.
    simpa using
      ((isRegular_cons_iff (M := M ⧸ (Ideal.ofList us • (⊤ : Submodule R M))) a []).mp
        hsingle).1
  have hEq :
      Ideal.ofList ts • (⊤ : Submodule R M) =
        Ideal.ofList us • (⊤ : Submodule R M) := by
    -- Permuting the prefix does not change the submodule generated by its coefficients.
    exact congrArg (fun I : Ideal R ↦ I • (⊤ : Submodule R M)) (ofList_eq_of_perm hperm)
  exact ((Submodule.quotEquivOfEq _ _ hEq).isSMulRegular_congr a).mpr ha

/-- Helper for Lemma 10.68.10: the swapped common-quotient pair regularity from the source proof
implies regularity of `a` modulo any permuted shorter prefix. -/
lemma isSMulRegular_of_regular_reordered_prefix_pair_on_permuted_shorter_prefix
    {ls ms ts : List R} {a b : R}
    (hperm : List.Perm ts (ls ++ ms ++ [b]))
    (ha : IsRegular R (ls ++ ms ++ [a]))
    (hab : IsRegular R (ls ++ a :: ms ++ [b]))
    (hb : IsRegular R (ls ++ ms ++ [b])) :
    IsSMulRegular (R ⧸ (Ideal.ofList ts • (⊤ : Ideal R))) a := by
  let Q : Type u := R ⧸ (Ideal.ofList (ls ++ ms) • (⊤ : Ideal R))
  have hab_common : IsRegular Q [a, b] :=
    -- First move to the common quotient by the shared earlier prefix.
    regular_pair_in_common_quotient_of_regular_reordered_prefix ha hab
  have hb_common : IsSMulRegular Q b := by
    -- The ordered list `ls ++ ms ++ [b]` already shows that `b` is regular on the common quotient.
    simpa [Q] using
      isSMulRegular_of_regular_append_singleton_on_permuted_prefix (M := R)
        (ts := ls ++ ms) (us := ls ++ ms) (a := b) (List.Perm.refl _) hb
  have hswap_common : IsRegular Q [b, a] :=
    -- Swap the length-two regular pair once `b` is known to be ambient-regular.
    isRegular_pair_swap_of_second_regular hab_common hb_common
  have ha_after_b_common :
      IsSMulRegular (Q ⧸ (Ideal.ofList [b] • (⊤ : Submodule R Q))) a := by
    -- Isolate `a` after first quotienting by `b` inside the common quotient.
    simpa [Q] using
      isSMulRegular_of_regular_append_singleton_on_permuted_prefix (M := Q)
        (ts := [b]) (us := [b]) (a := a) (List.Perm.refl _) hswap_common
  have hEq_single :
      Ideal.ofList [b] • (⊤ : Submodule R Q) = b • (⊤ : Submodule R Q) := by
    -- The singleton list `[b]` generates the same acting submodule as scalar multiplication by `b`.
    simpa [Ideal.ofList_cons, Ideal.ofList_nil] using
      (Submodule.ideal_span_singleton_smul b (⊤ : Submodule R Q))
  have ha_after_b_outer : IsSMulRegular (QuotSMulTop b Q) a := by
    -- Convert the singleton-list quotient to the standard `QuotSMulTop` quotient by `b`.
    exact ((Submodule.quotEquivOfEq _ _ hEq_single).isSMulRegular_congr a).mp ha_after_b_common
  have hperm_ordered :
      List.Perm (ls ++ ms ++ [b]) (b :: (ls ++ ms)) := by
    simpa [List.append_assoc] using
      (List.perm_middle : List.Perm ((ls ++ ms) ++ b :: ([] : List R))
        (b :: ((ls ++ ms) ++ ([] : List R))))
  have hEq_ordered :
      Ideal.ofList (ls ++ ms ++ [b]) • (⊤ : Ideal R) =
        Ideal.ofList (b :: (ls ++ ms)) • (⊤ : Ideal R) := by
    -- Reorder the generators so the quotient-by-`b` equivalence applies directly.
    exact congrArg (fun I : Ideal R ↦ I • (⊤ : Ideal R)) (ofList_eq_of_perm hperm_ordered)
  let eOrdered :
      (R ⧸ (Ideal.ofList (ls ++ ms ++ [b]) • (⊤ : Ideal R))) ≃ₗ[R]
        QuotSMulTop b Q :=
    (Submodule.quotEquivOfEq _ _ hEq_ordered).trans
      (Submodule.quotOfListConsSMulTopEquivQuotSMulTopOuter (M := R) b (ls ++ ms))
  have ha_ordered :
      IsSMulRegular (R ⧸ (Ideal.ofList (ls ++ ms ++ [b]) • (⊤ : Ideal R))) a := by
    -- Transport the quotient-by-`b` regularity back to the ordered shorter prefix.
    exact (eOrdered.isSMulRegular_congr a).mpr ha_after_b_outer
  have hEq_perm :
      Ideal.ofList ts • (⊤ : Ideal R) =
        Ideal.ofList (ls ++ ms ++ [b]) • (⊤ : Ideal R) := by
    -- Finally move from the ordered shorter prefix to the arbitrary permuted shorter prefix.
    exact congrArg (fun I : Ideal R ↦ I • (⊤ : Ideal R)) (ofList_eq_of_perm hperm)
  exact ((Submodule.quotEquivOfEq _ _ hEq_perm).isSMulRegular_congr a).mpr ha_ordered

/-- Helper for Lemma 10.68.10: `constantCoeff` kills every generator `C (fs[i]) * X i`, so the
ideal they generate is proper in the polynomial ring. -/
lemma ofList_C_mul_X_ne_top {fs : List R} [Nontrivial R] :
    (Ideal.ofList (List.ofFn fun i : Fin fs.length ↦ C (fs[i]) * X i) :
      Ideal (MvPolynomial (Fin fs.length) R)) ≠ ⊤ := by
  intro htop
  have hker :
      (Ideal.ofList (List.ofFn fun i : Fin fs.length ↦ C (fs[i]) * X i) :
        Ideal (MvPolynomial (Fin fs.length) R)) ≤
        RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin fs.length) R →+* R) := by
    refine Ideal.span_le.mpr ?_
    intro p hp
    rcases List.mem_ofFn.mp hp with ⟨i, rfl⟩
    -- Each generator has zero constant coefficient because of the `X i` factor.
    simp [RingHom.mem_ker]
  have hone :
      (1 : MvPolynomial (Fin fs.length) R) ∈
        RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin fs.length) R →+* R) := by
    have hone_in_span :
        (1 : MvPolynomial (Fin fs.length) R) ∈
          (Ideal.ofList (List.ofFn fun i : Fin fs.length ↦ C (fs[i]) * X i) :
            Ideal (MvPolynomial (Fin fs.length) R)) := by
      rw [htop]
      simp
    exact hker hone_in_span
  -- Applying `constantCoeff` to `1` yields the contradiction `1 = 0`.
  simp [RingHom.mem_ker] at hone

/-- Helper for Lemma 10.68.10: the support ideal attached to the prefix `i` and exponent vector
`e` is generated by those earlier coefficients `fs[j]` whose variable actually appears in `e`. -/
abbrev prefixSupportIdeal (fs : List R) (i : Fin fs.length) (e : Fin fs.length →₀ ℕ) : Ideal R :=
  Ideal.span {r | ∃ j : Fin fs.length, j.1 < i.1 ∧ j ∈ e.support ∧ fs[j] = r}

/-- Helper for Lemma 10.68.10: the prefix `fs.take i` is the list of coefficients obtained by
reading `fs` along the prefix index list `finRange i`. -/
lemma take_eq_map_prefix_indices {fs : List R} (i : Fin fs.length) :
    (List.finRange i.1).map (fun j => fs[Fin.castLT j (lt_trans j.2 i.2)]) = fs.take i.1 := by
  -- Rewrite the prefix list as `List.ofFn`, so both sides are indexed by the same `Fin i.1`.
  rw [← List.ofFn_eq_map]
  calc
    List.ofFn (fun j : Fin i.1 => fs[Fin.castLT j (lt_trans j.2 i.2)]) =
        List.ofFn (fun j : Fin i.1 => (fs.take i.1)[(j : Nat)]) := by
      -- Taking the first `i` entries does not change any coefficient in those positions.
      congr
      funext j
      simpa using
        (List.getElem_take' (l := fs) (n := i.1) (i := (j : Nat)) (hj := j.2)).symm
    _ = (fs.take i.1).map id := by
      simpa using (List.ofFn_getElem_eq_map (l := fs.take i.1) (f := id))
    _ = fs.take i.1 := by
      simp

/-- Helper for Lemma 10.68.10: every support ideal `prefixSupportIdeal fs i e` is generated by an
ordered sublist of the prefix `fs.take i`. -/
lemma exists_sublist_take_eq_prefixSupportIdeal {fs : List R} (i : Fin fs.length)
    (e : Fin fs.length →₀ ℕ) :
    ∃ gs : List R, List.Sublist gs (fs.take i.1) ∧
      Ideal.ofList gs = prefixSupportIdeal fs i e := by
  classical
  let js : List (Fin i.1) :=
    (List.finRange i.1).filter fun j => Fin.castLT j (lt_trans j.2 i.2) ∈ e.support
  let gs : List R := js.map fun j => fs[Fin.castLT j (lt_trans j.2 i.2)]
  refine ⟨gs, ?_, ?_⟩
  · -- Filter the prefix-index list and then read off the corresponding coefficients.
    have hjs : List.Sublist js (List.finRange i.1) := by
      simpa [js] using (List.filter_sublist : List.Sublist js (List.finRange i.1))
    have hgs :
        List.Sublist gs ((List.finRange i.1).map fun j => fs[Fin.castLT j (lt_trans j.2 i.2)]) := by
      simpa [gs, js] using hjs.map (fun j => fs[Fin.castLT j (lt_trans j.2 i.2)])
    have htake : ((List.finRange i.1).map fun j : Fin i.1 => fs[(j : Nat)]) = fs.take i.1 := by
      simpa using (take_eq_map_prefix_indices (fs := fs) i)
    simpa [gs] using htake ▸ hgs
  · -- The filtered prefix indices generate exactly the earlier active coefficients of `e`.
    dsimp [gs, js, prefixSupportIdeal]
    change
      Ideal.span {r | r ∈ List.map (fun j : Fin i.1 => fs[Fin.castLT j (lt_trans j.2 i.2)])
        (List.filter (fun j : Fin i.1 => Fin.castLT j (lt_trans j.2 i.2) ∈ e.support)
          (List.finRange i.1))} =
      Ideal.span {r | ∃ j : Fin fs.length, j.1 < i.1 ∧ j ∈ e.support ∧ fs[j] = r}
    apply le_antisymm
    · refine Ideal.span_le.mpr ?_
      intro r hr
      rcases List.mem_map.mp hr with ⟨j, hj, rfl⟩
      have hje : Fin.castLT j (lt_trans j.2 i.2) ∈ e.support := by
        simpa using (List.mem_filter.mp hj).2
      exact Ideal.subset_span ⟨Fin.castLT j (lt_trans j.2 i.2), by simpa using j.2, hje, rfl⟩
    · refine Ideal.span_le.mpr ?_
      intro r hr
      rcases hr with ⟨j, hj, hje, rfl⟩
      let j' : Fin i.1 := ⟨j.1, hj⟩
      have hj'mem :
          j' ∈ List.filter (fun k : Fin i.1 => Fin.castLT k (lt_trans k.2 i.2) ∈ e.support)
            (List.finRange i.1) := by
        refine List.mem_filter.mpr ?_
        constructor
        · simpa [j'] using (List.mem_finRange j')
        · simpa [j'] using hje
      have hmem :
          fs[j] ∈ List.map (fun k : Fin i.1 => fs[Fin.castLT k (lt_trans k.2 i.2)])
            (List.filter (fun k : Fin i.1 => Fin.castLT k (lt_trans k.2 i.2) ∈ e.support)
              (List.finRange i.1)) := by
        exact List.mem_map.mpr ⟨j', hj'mem, by simp [j']⟩
      exact Ideal.subset_span hmem

/-- Helper for Lemma 10.68.10: every ordered sublist of the prefix `fs.take i` arises from a
support ideal `prefixSupportIdeal fs i e`. -/
lemma exists_exponent_eq_prefixSupportIdeal_of_sublist_take {fs : List R} (i : Fin fs.length)
    {gs : List R} (hsub : List.Sublist gs (fs.take i.1)) :
    ∃ e : Fin fs.length →₀ ℕ, prefixSupportIdeal fs i e = Ideal.ofList gs := by
  classical
  let e : Fin fs.length →₀ ℕ :=
    Finsupp.onFinset Finset.univ (fun j => if fs[j] ∈ gs then 1 else 0) (by
      intro j _
      simp)
  refine ⟨e, ?_⟩
  -- This exponent vector records exactly which coefficients of `fs` occur in `gs`.
  dsimp [prefixSupportIdeal]
  change
    Ideal.span {r | ∃ j : Fin fs.length, j.1 < i.1 ∧ j ∈ e.support ∧ fs[j] = r} =
      Ideal.span {r | r ∈ gs}
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    intro r hr
    rcases hr with ⟨j, hj, hje, rfl⟩
    have hmem : fs[j] ∈ gs := by
      rw [Finsupp.mem_support_iff] at hje
      simpa [e] using hje
    exact Ideal.subset_span hmem
  · refine Ideal.span_le.mpr ?_
    intro r hr
    rcases List.mem_iff_getElem.mp (hsub.subset hr) with ⟨n, hn, hnr⟩
    have hn' : n < i.1 := by
      simpa [List.length_take, Nat.min_eq_left (Nat.le_of_lt i.2)] using hn
    let j : Fin fs.length := ⟨n, lt_trans hn' i.2⟩
    have hfj : fs[j] = r := by
      -- Reading the `n`th entry of the prefix recovers the same coefficient in `fs`.
      calc
        fs[j] = (fs.take i.1)[n] := by
          simpa [j] using
            (List.getElem_take' (l := fs) (n := i.1) (i := n) (hj := hn')).symm
        _ = r := hnr
    have hje : j ∈ e.support := by
      -- The chosen index is marked active because its coefficient lies in `gs`.
      rw [Finsupp.mem_support_iff]
      have hmem : fs[j] ∈ gs := by
        simpa [hfj] using hr
      simpa [e] using hmem
    exact Ideal.subset_span ⟨j, by simpa [j] using hn', hje, hfj⟩

/-- Helper for Lemma 10.68.10: an earlier active coefficient belongs to the corresponding support
ideal. -/
lemma mem_prefixSupportIdeal_of_lt_of_mem_support {fs : List R} {i : Fin fs.length}
    {e : Fin fs.length →₀ ℕ} {j : Fin fs.length} (hj : j.1 < i.1) (hje : j ∈ e.support) :
    fs[j] ∈ prefixSupportIdeal fs i e := by
  -- The generator `fs[j]` is literally one of the defining generators of the support ideal.
  exact Ideal.subset_span ⟨j, hj, hje, rfl⟩

/-- Helper for Lemma 10.68.10: enlarging the exponent vector can only enlarge the support ideal. -/
lemma prefixSupportIdeal_mono {fs : List R} {i : Fin fs.length}
    {d e : Fin fs.length →₀ ℕ} (hde : d ≤ e) :
    prefixSupportIdeal fs i d ≤ prefixSupportIdeal fs i e := by
  -- Any generator active for `d` stays active for `e`, so the span only grows.
  refine Ideal.span_le.mpr ?_
  intro r hr
  rcases hr with ⟨j, hj, hjd, rfl⟩
  have hje : j ∈ e.support := by
    rw [Finsupp.mem_support_iff] at hjd ⊢
    exact Nat.ne_of_gt <| lt_of_lt_of_le (Nat.pos_of_ne_zero hjd) (hde j)
  exact Ideal.subset_span ⟨j, hj, hje, rfl⟩

/-- Helper for Lemma 10.68.10: multiplying by one prefix generator forces every coefficient into
the corresponding support ideal. -/
lemma coeff_mem_prefixSupportIdeal_mul_generator_of_lt {fs : List R} {i : Fin fs.length}
    {e : Fin fs.length →₀ ℕ} {j : Fin fs.length}
    (hj : j.1 < i.1) (q : MvPolynomial (Fin fs.length) R) :
    (q * (C (fs[j]) * X j)).coeff e ∈ prefixSupportIdeal fs i e := by
  by_cases hje : j ∈ e.support
  · -- If `X j` appears in the target monomial, the coefficient is a multiple of `fs[j]`.
    have hmem : fs[j] ∈ prefixSupportIdeal fs i e :=
      mem_prefixSupportIdeal_of_lt_of_mem_support (fs := fs) (i := i) (e := e) hj hje
    have hcoeff : (((q * C (fs[j])) * X j).coeff e) ∈ prefixSupportIdeal fs i e := by
      rw [MvPolynomial.coeff_mul_X']
      simp only [hje, ite_true]
      rw [show q * C (fs[j]) = C (fs[j]) * q by rw [mul_comm], MvPolynomial.coeff_C_mul]
      exact Ideal.mul_mem_right _ _ hmem
    simpa [mul_assoc] using hcoeff
  · -- If `X j` does not appear, the coefficient vanishes.
    have hcoeff : (((q * C (fs[j])) * X j).coeff e) ∈ prefixSupportIdeal fs i e := by
      rw [MvPolynomial.coeff_mul_X']
      simp [hje]
    simpa [mul_assoc] using hcoeff

/-- Helper for Lemma 10.68.10: coefficientwise support-ideal control is stable under polynomial
multiplication on the left. -/
lemma coeff_mem_prefixSupportIdeal_mul_of_forall_coeff {fs : List R} {i : Fin fs.length}
    {p q : MvPolynomial (Fin fs.length) R}
    (hq : ∀ d, q.coeff d ∈ prefixSupportIdeal fs i d) :
    ∀ e, (p * q).coeff e ∈ prefixSupportIdeal fs i e := by
  intro e
  -- Expand the coefficient of the product and enlarge each summand from its own support ideal to
  -- the target support ideal indexed by `e`.
  rw [MvPolynomial.coeff_mul]
  refine Submodule.sum_mem _ fun x hx ↦ ?_
  have hle : x.2 ≤ e := by
    rw [Finset.mem_antidiagonal] at hx
    exact hx ▸ le_add_left le_rfl
  exact Ideal.mul_mem_left _ _ <| (prefixSupportIdeal_mono (fs := fs) (i := i) hle) (hq x.2)

/-- Helper for Lemma 10.68.10: every coefficient of a polynomial in the prefix ideal generated by
`C (fs[j]) * X j` for `j < i` lies in the corresponding support ideal. -/
lemma coeff_mem_prefixSupportIdeal_of_mem_prefix_C_mul_X_ideal {fs : List R}
    (i : Fin fs.length) {p : MvPolynomial (Fin fs.length) R}
    (hp :
      p ∈ Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j}) :
    ∀ e, p.coeff e ∈ prefixSupportIdeal fs i e := by
  -- Prove the coefficientwise statement on the whole ideal by span induction over its generators.
  refine Submodule.span_induction (p := fun q _ ↦ ∀ e, q.coeff e ∈ prefixSupportIdeal fs i e)
    ?_ ?_ ?_ ?_ hp
  · intro q hq e
    rcases hq with ⟨j, hj, rfl⟩
    simpa [one_mul] using
      coeff_mem_prefixSupportIdeal_mul_generator_of_lt (fs := fs) (i := i) (e := e)
        (j := j) hj (1 : MvPolynomial (Fin fs.length) R)
  · intro e
    simp [prefixSupportIdeal]
  · intro q₁ q₂ _ _ hq₁ hq₂ e
    simpa [MvPolynomial.coeff_add] using Ideal.add_mem _ (hq₁ e) (hq₂ e)
  · intro a q _ hq e
    simpa [smul_eq_mul] using
      coeff_mem_prefixSupportIdeal_mul_of_forall_coeff (fs := fs) (i := i) (p := a) hq e

/-- Helper for Lemma 10.68.10: if an earlier variable occurs in the monomial support, then the
corresponding coefficient monomial already lies in the prefix polynomial ideal. -/
lemma monomial_mem_prefix_C_mul_X_ideal_of_lt_of_mem_support {fs : List R}
    {i : Fin fs.length} {e : Fin fs.length →₀ ℕ} {j : Fin fs.length}
    (hj : j.1 < i.1) (hje : j ∈ e.support) :
    MvPolynomial.monomial e (fs[j]) ∈
      Ideal.span {g | ∃ k : Fin fs.length, k.1 < i.1 ∧ g = C (fs[k]) * X k} := by
  let e' : Fin fs.length →₀ ℕ := e - Finsupp.single j 1
  have hsplit : e' + Finsupp.single j 1 = e := by
    -- Remove one copy of `X j` from the monomial and then add it back.
    dsimp [e']
    exact Finsupp.sub_add_single_one_cancel <| by
      simpa [Finsupp.mem_support_iff] using hje
  have hmonomial :
      MvPolynomial.monomial e (fs[j]) =
        MvPolynomial.monomial e' (1 : R) * (C (fs[j]) * X j) := by
    have hcoeff :
        MvPolynomial.monomial e' (fs[j]) =
          C (fs[j]) * MvPolynomial.monomial e' (1 : R) := by
      -- Pull the coefficient out as a constant polynomial.
      simpa using
        (MvPolynomial.C_mul_monomial (s := e') (a := fs[j]) (a' := (1 : R))).symm
    -- Rewrite the target monomial as a product of a smaller monomial and the generator
    -- `C (fs[j]) * X j`.
    calc
      MvPolynomial.monomial e (fs[j]) =
          MvPolynomial.monomial e' (fs[j]) * X j := by
        rw [← hsplit, MvPolynomial.monomial_add_single, pow_one]
      _ = (C (fs[j]) * MvPolynomial.monomial e' (1 : R)) * X j := by rw [hcoeff]
      _ = MvPolynomial.monomial e' (1 : R) * (C (fs[j]) * X j) := by
        simp [mul_left_comm, mul_comm]
  have hgen :
      C (fs[j]) * X j ∈
        Ideal.span {g | ∃ k : Fin fs.length, k.1 < i.1 ∧ g = C (fs[k]) * X k} := by
    exact Ideal.subset_span ⟨j, hj, rfl⟩
  -- Close by ideal stability under left multiplication.
  rw [hmonomial]
  exact
    Ideal.mul_mem_left
      (Ideal.span {g | ∃ k : Fin fs.length, k.1 < i.1 ∧ g = C (fs[k]) * X k})
      (MvPolynomial.monomial e' (1 : R)) hgen

/-- Helper for Lemma 10.68.10: any monomial whose coefficient lies in the support ideal belongs to
the prefix polynomial ideal. -/
lemma monomial_mem_prefix_C_mul_X_ideal_of_coeff_mem_prefixSupportIdeal {fs : List R}
    (i : Fin fs.length) {e : Fin fs.length →₀ ℕ} {c : R}
    (hc : c ∈ prefixSupportIdeal fs i e) :
    MvPolynomial.monomial e c ∈
      Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j} := by
  -- Induct on coefficient membership in the support ideal, keeping the exponent vector fixed.
  refine Submodule.span_induction (p := fun c _ ↦
      MvPolynomial.monomial e c ∈
        Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j}) ?_ ?_ ?_ ?_ hc
  · intro r hr
    rcases hr with ⟨j, hj, hje, rfl⟩
    exact monomial_mem_prefix_C_mul_X_ideal_of_lt_of_mem_support (fs := fs) hj hje
  · simp
  · intro a b _ _ ha hb
    -- The monomial map is additive in its coefficient argument.
    simpa [MvPolynomial.monomial, Finsupp.single_add] using Ideal.add_mem _ ha hb
  · intro a b _ hb
    -- Scalar multiplication of the coefficient becomes left multiplication by `C a`.
    simpa [smul_eq_mul, MvPolynomial.C_mul_monomial] using
      Ideal.mul_mem_left
        (Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j})
        (C a) hb

/-- Helper for Lemma 10.68.10: membership in the prefix polynomial ideal is equivalent to
coefficientwise membership in the corresponding support ideals. -/
lemma mem_prefix_C_mul_X_ideal_iff_coeff_mem_prefixSupportIdeal {fs : List R}
    (i : Fin fs.length) (p : MvPolynomial (Fin fs.length) R) :
    p ∈ Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j} ↔
      ∀ e, p.coeff e ∈ prefixSupportIdeal fs i e := by
  constructor
  · -- This is the coefficient-extraction direction already proved above.
    exact coeff_mem_prefixSupportIdeal_of_mem_prefix_C_mul_X_ideal (fs := fs) i
  · intro hp
    -- Rebuild the polynomial from its monomials and place each summand in the prefix ideal.
    rw [MvPolynomial.as_sum p]
    exact Submodule.sum_mem _ fun e he ↦
      monomial_mem_prefix_C_mul_X_ideal_of_coeff_mem_prefixSupportIdeal
        (fs := fs) i (hc := hp e)

/-- Helper for Lemma 10.68.10: adding one copy of the `i`th variable does not change the support
ideal, because the support ideal only records indices strictly before `i`. -/
lemma prefixSupportIdeal_add_single_self {fs : List R} (i : Fin fs.length)
    (e : Fin fs.length →₀ ℕ) :
    prefixSupportIdeal fs i (e + Finsupp.single i 1) = prefixSupportIdeal fs i e := by
  -- The defining span ignores the `i`th index, so the active earlier generators are unchanged.
  dsimp [prefixSupportIdeal]
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    intro r hr
    rcases hr with ⟨j, hj, hjmem, rfl⟩
    have hji : j ≠ i := by
      intro hji
      exact (Nat.lt_irrefl i.1) <| by simpa [hji] using hj
    have hje : j ∈ e.support := by
      rw [Finsupp.mem_support_iff] at hjmem ⊢
      simpa [Finsupp.add_apply, Finsupp.single_apply, hji] using hjmem
    exact Ideal.subset_span ⟨j, hj, hje, rfl⟩
  · refine Ideal.span_le.mpr ?_
    intro r hr
    rcases hr with ⟨j, hj, hjmem, rfl⟩
    have hji : j ≠ i := by
      intro hji
      exact (Nat.lt_irrefl i.1) <| by simpa [hji] using hj
    have hjmem' : j ∈ (e + Finsupp.single i 1).support := by
      rw [Finsupp.mem_support_iff] at hjmem ⊢
      simpa [Finsupp.add_apply, Finsupp.single_apply, hji] using hjmem
    exact Ideal.subset_span ⟨j, hj, hjmem', rfl⟩

/-- Helper for Lemma 10.68.10: the polynomial ideal generated by the first `i` entries of
`C (fs[j]) * X j` is exactly the prefix polynomial ideal indexed by `j < i`. -/
lemma ofList_take_C_mul_X_eq_prefix_C_mul_X_ideal {fs : List R} (i : Fin fs.length) :
    Ideal.ofList ((List.ofFn fun j : Fin fs.length ↦ C (fs[j]) * X j).take i.1) =
      Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j} := by
  -- The prefix list and the prefix index-set enumerate the same generators.
  change
    Ideal.span
        {g | g ∈ ((List.ofFn fun j : Fin fs.length ↦ C (fs[j]) * X j).take i.1)} =
      Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j}
  apply le_antisymm
  · refine Ideal.span_le.mpr ?_
    intro g hg
    rcases List.mem_iff_getElem.mp hg with ⟨n, hn, hgn⟩
    have hn' : n < i.1 := by
      simpa [List.length_take, Nat.min_eq_left (Nat.le_of_lt i.2)] using hn
    have hnlen : n < (List.ofFn fun k : Fin fs.length ↦ C (fs[k]) * X k).length := by
      simpa using (lt_trans hn' i.2)
    let j : Fin fs.length := ⟨n, lt_trans hn' i.2⟩
    refine Ideal.subset_span ⟨j, ?_, ?_⟩
    · simpa [j] using hn'
    · calc
        g = ((List.ofFn fun k : Fin fs.length ↦ C (fs[k]) * X k).take i.1)[n] := by
          simpa using hgn.symm
        _ = (List.ofFn fun k : Fin fs.length ↦ C (fs[k]) * X k)[n]'hnlen := by
          simpa using (List.getElem_take' (l := List.ofFn fun k : Fin fs.length ↦
            C (fs[k]) * X k) (n := i.1) (i := n) (hj := hn'))
        _ = C (fs[j]) * X j := by
          simp [j]
  · refine Ideal.span_le.mpr ?_
    intro g hg
    rcases hg with ⟨j, hj, rfl⟩
    have hj' : j.1 < (List.ofFn fun k : Fin fs.length ↦ C (fs[k]) * X k).length := by
      simpa using j.2
    have hjtake : j.1 < ((List.ofFn fun k : Fin fs.length ↦ C (fs[k]) * X k).take i.1).length := by
      simpa [List.length_take, Nat.min_eq_left (Nat.le_of_lt i.2)] using hj
    have hmem :
        C (fs[j]) * X j ∈ ((List.ofFn fun k : Fin fs.length ↦ C (fs[k]) * X k).take i.1) := by
      refine List.mem_iff_getElem.mpr ?_
      refine ⟨j.1, hjtake, ?_⟩
      · calc
          ((List.ofFn fun k : Fin fs.length ↦ C (fs[k]) * X k).take i.1)[j.1] =
              (List.ofFn fun k : Fin fs.length ↦ C (fs[k]) * X k)[j.1]'hj' := by
                simpa using
                  (List.getElem_take' (l := List.ofFn fun k : Fin fs.length ↦
                    C (fs[k]) * X k) (n := i.1) (i := j.1) (hj := hj))
          _ = C (fs[j]) * X j := by
            simpa using
              (List.getElem_ofFn (f := fun k : Fin fs.length ↦ C (fs[k]) * X k) ⟨j.1, hj'⟩)
    exact Ideal.subset_span hmem

/-- Helper for Lemma 10.68.10: an ordered sublist of `fs.take i` stays an ordered sublist after
adjoining the next coefficient `fs[i]` at the end. -/
lemma append_singleton_sublist_of_sublist_take {fs : List R} (i : Fin fs.length)
    {gs : List R} (hsub : List.Sublist gs (fs.take i.1)) :
    List.Sublist (gs ++ [fs[i]]) fs := by
  -- Append the same singleton to the prefix sublist and then identify the ambient prefix.
  have hsnoc : List.Sublist (gs ++ [fs[i]]) (fs.take i.1 ++ [fs[i]]) := by
    simpa using hsub.append (List.Sublist.refl [fs[i]])
  have hprefix : List.Sublist (fs.take i.1 ++ [fs[i]]) fs := by
    let hEq : fs.take i.1 ++ [fs[i]] = fs.take (i.1 + 1) :=
      List.take_concat_get' fs i.1 i.2
    exact hEq ▸ List.take_sublist (i.1 + 1) fs
  exact hsnoc.trans hprefix

/-- Helper for Lemma 10.68.10: if `gs ++ [a]` is an ordered sublist of `fs`, then the last
element `a` occurs at some concrete index of `fs`, and `gs` already lies in the preceding prefix.
-/
lemma exists_index_of_snoc_sublist {gs fs : List R} {a : R}
    (hsub : List.Sublist (gs ++ [a]) fs) :
    ∃ i : Fin fs.length, fs[i] = a ∧ List.Sublist gs (fs.take i.1) := by
  -- Reverse the sublist relation so the last matched element becomes the head, which lets
  -- `cons_sublist_cons'` split the “matched at the end” and “matched earlier” cases cleanly.
  induction fs using List.reverseRecOn generalizing gs with
  | nil =>
      cases gs <;> cases hsub
  | append_singleton fs b ih =>
      have hrev : List.Sublist (a :: gs.reverse) (b :: fs.reverse) := by
        simpa using (List.reverse_sublist.mpr hsub)
      rcases (List.cons_sublist_cons').mp hrev with hskip | ⟨hab, htail⟩
      · -- If the last sublist element appears earlier, recurse on the shorter ambient list.
        have hsub' : List.Sublist (gs ++ [a]) fs := by
          have hskip' : List.Sublist ((gs ++ [a]).reverse) fs.reverse := by
            simpa using hskip
          exact List.reverse_sublist.mp hskip'
        rcases ih hsub' with ⟨i, hia, hprefix⟩
        let i' : Fin (fs ++ [b]).length := ⟨i.1, by simpa [i.2]⟩
        refine ⟨i', ?_, ?_⟩
        · -- The chosen earlier index still points to the same ambient element after appending `b`.
          simpa [i', i.2] using hia
        · -- Prefixes below the old length are unchanged by appending a singleton on the right.
          simpa [i', List.take_append, Nat.sub_eq_zero_of_le (Nat.le_of_lt i.2)] using hprefix
      · -- If the last ambient element matches `a`, the whole earlier sublist lies in the prefix.
        let i : Fin (fs ++ [b]).length := ⟨fs.length, by simp⟩
        have hprefix : List.Sublist gs fs := by
          exact List.reverse_sublist.mp htail
        refine ⟨i, ?_, ?_⟩
        · simpa [i, hab]
        · simpa [i] using hprefix

/-- Helper for Lemma 10.68.10: a regular prefix and a regular last element on the prefix quotient
reassemble into a regular snoc sequence once the generated ideal is known to stay proper. -/
lemma isRegular_append_singleton_of_regular_prefix_and_smulRegular {hs : List R} {a : R}
    (hprefix : IsRegular R hs)
    (ha :
      IsSMulRegular (R ⧸ (Ideal.ofList hs • (⊤ : Ideal R))) a)
    (hproper : Ideal.ofList (hs ++ [a]) ≠ ⊤) :
    IsRegular R (hs ++ [a]) := by
  -- Build weak regularity of the snoc list from the prefix and the singleton tail, then upgrade
  -- using properness of the ideal generated by the whole list.
  refine isRegular_of_isWeaklyRegular_of_ofList_ne_top ?_ hproper
  rw [isWeaklyRegular_append_iff' (M := R) hs [a]]
  constructor
  · exact hprefix.toIsWeaklyRegular
  · simpa using
      (isWeaklyRegular_singleton_iff
        (M := R ⧸ (Ideal.ofList hs • (⊤ : Ideal R)))
        (Ideal.Quotient.mk (Ideal.ofList hs) a)).mpr ha

/-- Helper for Lemma 10.68.10: if every ordered sublist of `fs` is regular and `Ideal.ofList fs`
is proper, then every permutation of `fs` is regular. -/
lemma isRegular_of_perm_of_forall_sublist_regular {fs gs : List R}
    (hfs : Ideal.ofList fs ≠ ⊤)
    (hsub : ∀ hs : List R, List.Sublist hs fs → IsRegular R hs)
    (hperm : List.Perm gs fs) :
    IsRegular R gs := by
  classical
  -- Run the textbook argument by strong induction on the ambient length so both shorter
  -- permutations occurring in the snoc case are available simultaneously.
  have hmain :
      ∀ n : ℕ,
        ∀ {fs gs : List R}, fs.length = n →
          Ideal.ofList fs ≠ ⊤ →
          (∀ hs : List R, List.Sublist hs fs → IsRegular R hs) →
          List.Perm gs fs → IsRegular R gs := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro fs gs hlen hproper hsub_all hperm_fs
        cases fs using List.reverseRecOn with
        | nil =>
            have hgs : gs = [] := by
              simpa using hperm_fs
            subst hgs
            letI : Nontrivial R := nontrivial_of_ofList_ne_top hproper
            -- The empty regular sequence is allowed once the ring is known to be nontrivial.
            simpa using (IsRegular.nil R R)
        | append_singleton fs b =>
            induction gs using List.reverseRecOn with
            | nil =>
                exfalso
                simpa using hperm_fs.length_eq
            | append_singleton ts a =>
                have hcases := perm_append_singleton_cases hperm_fs
                cases hcases with
                | inl hsame =>
                    rcases hsame with ⟨hba, hts⟩
                    subst a
                    have hfs_sub : List.Sublist fs (fs ++ [b]) := by
                      simpa using (List.sublist_append_left fs [b])
                    have hproper_fs : Ideal.ofList fs ≠ ⊤ :=
                      ofList_ne_top_of_sublist hproper hfs_sub
                    have hsub_fs :
                        ∀ hs : List R, List.Sublist hs fs → IsRegular R hs := by
                      intro hs hhs
                      exact hsub_all hs (hhs.trans hfs_sub)
                    have hlen_fs : fs.length < n := by
                      rw [← hlen]
                      simpa using Nat.lt_succ_self fs.length
                    have hprefix : IsRegular R ts := by
                      exact ih fs.length hlen_fs rfl hproper_fs hsub_fs hts
                    have hambient : IsRegular R (fs ++ [b]) := by
                      exact hsub_all (fs ++ [b]) (List.Sublist.refl _)
                    have hb_tail :
                        IsSMulRegular (R ⧸ (Ideal.ofList ts • (⊤ : Ideal R))) b := by
                      -- The easy snoc branch only transports tail regularity across a permuted
                      -- shorter prefix.
                      exact isSMulRegular_of_regular_append_singleton_on_permuted_prefix
                        (M := R) (ts := ts) (us := fs) (a := b) hts hambient
                    have hproper_final : Ideal.ofList (ts ++ [b]) ≠ ⊤ := by
                      simpa [ofList_eq_of_perm hperm_fs] using hproper
                    exact
                      isRegular_append_singleton_of_regular_prefix_and_smulRegular
                        hprefix hb_tail hproper_final
                | inr hsplit =>
                    rcases hsplit with ⟨ls, ms, hfs_eq, hts⟩
                    subst hfs_eq
                    have hsub_drop_last :
                        List.Sublist (ls ++ a :: ms) (ls ++ a :: ms ++ [b]) := by
                      simpa using (List.sublist_append_left (ls ++ a :: ms) [b])
                    have hproper_drop_last : Ideal.ofList (ls ++ a :: ms) ≠ ⊤ :=
                      ofList_ne_top_of_sublist hproper hsub_drop_last
                    have hsub_drop_last_all :
                        ∀ hs : List R, List.Sublist hs (ls ++ a :: ms) → IsRegular R hs := by
                      intro hs hhs
                      exact hsub_all hs (hhs.trans hsub_drop_last)
                    have hlen_drop_last : (ls ++ a :: ms).length < n := by
                      rw [← hlen]
                      simpa [List.length_append, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
                        Nat.lt_succ_self (List.length (ls ++ a :: ms))
                    have hperm_middle_left :
                        List.Perm (ls ++ ms ++ [a]) (a :: (ls ++ ms)) := by
                      simpa [List.append_assoc] using
                        (List.perm_middle :
                          List.Perm ((ls ++ ms) ++ a :: ([] : List R))
                            (a :: ((ls ++ ms) ++ ([] : List R))))
                    have hperm_middle_right :
                        List.Perm (ls ++ a :: ms) (a :: (ls ++ ms)) := by
                      simpa [List.append_assoc] using
                        (List.perm_middle : List.Perm (ls ++ a :: ms) (a :: (ls ++ ms)))
                    have hperm_rotate :
                        List.Perm (ls ++ ms ++ [a]) (ls ++ a :: ms) :=
                      hperm_middle_left.trans hperm_middle_right.symm
                    have hreg_rotate : IsRegular R (ls ++ ms ++ [a]) := by
                      -- This is the smaller permutation from the source proof that moves `a` to
                      -- the end before comparing the pair `[a, b]`.
                      exact ih (ls ++ a :: ms).length hlen_drop_last rfl hproper_drop_last
                        hsub_drop_last_all hperm_rotate
                    have hsub_drop_middle :
                        List.Sublist (ls ++ ms ++ [b]) (ls ++ a :: ms ++ [b]) := by
                      have hmid : List.Sublist (ms ++ [b]) (a :: ms ++ [b]) :=
                        (List.Sublist.refl (ms ++ [b])).cons a
                      simpa [List.append_assoc] using (List.Sublist.refl ls).append hmid
                    have hproper_drop_middle : Ideal.ofList (ls ++ ms ++ [b]) ≠ ⊤ :=
                      ofList_ne_top_of_sublist hproper hsub_drop_middle
                    have hsub_drop_middle_all :
                        ∀ hs : List R, List.Sublist hs (ls ++ ms ++ [b]) → IsRegular R hs := by
                      intro hs hhs
                      exact hsub_all hs (hhs.trans hsub_drop_middle)
                    have hlen_drop_middle : (ls ++ ms ++ [b]).length < n := by
                      rw [← hlen]
                      simpa [List.length_append, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
                        Nat.lt_succ_self (List.length (ls ++ ms ++ [b]))
                    have hprefix : IsRegular R ts := by
                      -- The shorter permuted prefix is handled by the induction hypothesis on the
                      -- list with `a` removed.
                      exact ih (ls ++ ms ++ [b]).length hlen_drop_middle rfl
                        hproper_drop_middle hsub_drop_middle_all hts
                    have hambient : IsRegular R (ls ++ a :: ms ++ [b]) := by
                      exact hsub_all (ls ++ a :: ms ++ [b]) (List.Sublist.refl _)
                    have hordered_drop_middle : IsRegular R (ls ++ ms ++ [b]) := by
                      exact hsub_all (ls ++ ms ++ [b]) hsub_drop_middle
                    have ha_tail :
                        IsSMulRegular (R ⧸ (Ideal.ofList ts • (⊤ : Ideal R))) a := by
                      -- This is the nontrivial snoc branch: obtain the swapped pair in the common
                      -- quotient and then transport regularity of `a` to the permuted shorter
                      -- prefix.
                      exact
                        isSMulRegular_of_regular_reordered_prefix_pair_on_permuted_shorter_prefix
                          (ls := ls) (ms := ms) (ts := ts) (a := a) (b := b) hts
                          hreg_rotate hambient hordered_drop_middle
                    have hproper_final : Ideal.ofList (ts ++ [a]) ≠ ⊤ := by
                      simpa [ofList_eq_of_perm hperm_fs] using hproper
                    exact
                      isRegular_append_singleton_of_regular_prefix_and_smulRegular
                        hprefix ha_tail hproper_final
  exact hmain fs.length rfl hfs hsub hperm

/-- Helper for Lemma 10.68.10: regularity of the polynomial generator `C (fs[i]) * X i` modulo
the earlier polynomial generators is equivalent to regularity of `fs[i]` on every quotient by a
support ideal coming from a monomial exponent. -/
lemma isSMulRegular_C_mul_X_prefix_iff_forall_supportIdeal {fs : List R} (i : Fin fs.length) :
    IsSMulRegular ((MvPolynomial (Fin fs.length) R) ⧸
        Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j})
      (C (fs[i]) * X i) ↔
    ∀ e : Fin fs.length →₀ ℕ, IsSMulRegular (R ⧸ prefixSupportIdeal fs i e) (fs[i]) := by
  let I : Ideal (MvPolynomial (Fin fs.length) R) :=
    Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j}
  constructor
  · intro hpoly e
    -- Test polynomial regularity on a single monomial with coefficient in the support quotient.
    rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
    intro c hc
    have hmul :
        (C (fs[i]) * X i) * MvPolynomial.monomial e c ∈ I := by
      have hc' : fs[i] * c ∈ prefixSupportIdeal fs i (e + Finsupp.single i 1) := by
        simpa [prefixSupportIdeal_add_single_self (fs := fs) i e] using hc
      have hmono :
          MvPolynomial.monomial (e + Finsupp.single i 1) (fs[i] * c) ∈ I := by
        exact
          monomial_mem_prefix_C_mul_X_ideal_of_coeff_mem_prefixSupportIdeal
            (fs := fs) i hc'
      -- Rewrite the product as the corresponding shifted monomial.
      simpa [I, X, add_comm, MvPolynomial.C_mul_monomial, MvPolynomial.monomial_mul] using hmono
    have hmem :
        MvPolynomial.monomial e c ∈ I :=
      (isSMulRegular_quotient_iff_mem_of_smul_mem (N := I) (r := C (fs[i]) * X i)).mp hpoly
        (MvPolynomial.monomial e c) hmul
    have hcoeff :
        (MvPolynomial.monomial e c).coeff e ∈ prefixSupportIdeal fs i e :=
      (mem_prefix_C_mul_X_ideal_iff_coeff_mem_prefixSupportIdeal (fs := fs) i
        (MvPolynomial.monomial e c)).mp hmem e
    simpa using hcoeff
  · intro hsupp
    -- Extract each coefficient from the product and use regularity in the corresponding support
    -- quotient.
    rw [isSMulRegular_quotient_iff_mem_of_smul_mem]
    intro p hp
    rw [mem_prefix_C_mul_X_ideal_iff_coeff_mem_prefixSupportIdeal (fs := fs) i] at hp ⊢
    intro e
    have hcoeff :
        fs[i] * p.coeff e ∈ prefixSupportIdeal fs i e := by
      have hp' := hp (e + Finsupp.single i 1)
      rw [prefixSupportIdeal_add_single_self (fs := fs) i e] at hp'
      have hcoeff' :
          (((C (fs[i]) * X i) • p).coeff (e + Finsupp.single i 1)) =
            fs[i] * p.coeff e := by
        simpa [smul_eq_mul, X, add_comm, MvPolynomial.C_mul_monomial] using
          (MvPolynomial.coeff_monomial_mul (m := e) (s := Finsupp.single i 1)
            (r := fs[i]) (p := p))
      rw [hcoeff'] at hp'
      exact hp'
    exact
      (isSMulRegular_quotient_iff_mem_of_smul_mem (N := prefixSupportIdeal fs i e)
        (r := fs[i])).mp (hsupp e) (p.coeff e) hcoeff

/-- Helper for Lemma 10.68.10: prefix polynomial regularity at index `i` transports to regularity
of `fs[i]` on the quotient by any ordered sublist of the earlier prefix `fs.take i`. -/
lemma isSMulRegular_of_polynomial_prefix_regular_of_sublist_take {fs : List R}
    (i : Fin fs.length) {hs : List R}
    (hsub : List.Sublist hs (fs.take i.1))
    (hpoly :
      IsSMulRegular ((MvPolynomial (Fin fs.length) R) ⧸
          Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j})
        (C (fs[i]) * X i)) :
    IsSMulRegular (R ⧸ (Ideal.ofList hs • (⊤ : Ideal R))) (fs[i]) := by
  -- Realize the ordered prefix sublist as one of the support ideals already controlled by the
  -- polynomial regularity criterion, then transport across the resulting quotient equality.
  rcases exists_exponent_eq_prefixSupportIdeal_of_sublist_take (fs := fs) i hsub with ⟨e, he⟩
  have hsupport :
      IsSMulRegular (R ⧸ prefixSupportIdeal fs i e) (fs[i]) := by
    exact (isSMulRegular_C_mul_X_prefix_iff_forall_supportIdeal (fs := fs) i).mp hpoly e
  have hEq : Ideal.ofList hs • (⊤ : Ideal R) = prefixSupportIdeal fs i e := by
    simpa [smul_eq_mul] using he.symm
  exact ((Submodule.quotEquivOfEq _ _ hEq).isSMulRegular_congr (fs[i])).mpr hsupport

/-
Domain triage:
* primary domain: regular sequences in commutative algebra, together with their polynomial and
  quasi-regular comparison constructions;
* sampled owner API:
  `RingTheory.Sequence.IsRegular`,
  `RingTheory.Sequence.isRegular_cons_iff`,
  `IsLocalRing.isRegular_of_perm`,
  `RingTheory.Sequence.IsRegular.isQuasiRegular`;
* core/canonical owner: `RingTheory.Sequence.IsRegular M rs`;
* primitive vs derived split: the regular-sequence predicate and `Ideal.ofList fs` are primitive
  owner data, while permutation invariance, passage to subsequences, and the polynomial-ring test
  are derived source-facing/bridge statements;
* layer classification for this file: the theorem below is `source-facing`; it should stay a local
  `List.TFAE` rather than being repackaged into a second owner abstraction.
-/

-- Proof sketch: prove `(1) → (2)` by restricting a permutation-regular family to ordered
-- subsequences in
-- the given order; prove `(2) → (1)` by induction on the length and reduction to the case of length
-- two; prove `(2) ↔ (3)` by decomposing the polynomial quotient into the direct sum indexed by
-- monomials, so regularity of `C (fᵢ) * Xᵢ` is equivalent to regularity of `fᵢ` on the relevant
-- quotient modules.
/-- Lemma 10.68.10: if a list `fs` does not generate the unit ideal, then the following are
equivalent: every permutation of `fs` is a regular sequence, every ordered subsequence of `fs` is
a regular sequence, and the sequence `C (fᵢ) * Xᵢ` is regular in the polynomial ring with one
variable for each entry of `fs`. -/
theorem regular_permutations_subsequences_polynomial_tfae
    {fs : List R} (hfs : ofList fs ≠ ⊤) :
    List.TFAE
      [ (∀ gs : List R, List.Perm gs fs → IsRegular R gs),
        (∀ gs : List R, List.Sublist gs fs → IsRegular R gs),
        IsRegular (MvPolynomial (Fin fs.length) R)
          (List.ofFn fun i ↦ C (fs[i]) * X i) ] := by
  classical
  -- We organize the equivalence around the ordered-subsequence clause, following the source proof.
  tfae_have 1 → 2 := by
    intro hperm gs hsub
    exact isRegular_of_sublist_of_forall_perm_regular hperm hsub
  tfae_have 2 → 1 := by
    intro hsub gs hperm
    -- Route correction: the remaining work must follow the source induction on `fs.length`,
    -- reducing permutations to the length-two swap on the final pair after quotienting by the
    -- common earlier prefix.
    exact isRegular_of_perm_of_forall_sublist_regular hfs hsub hperm
  tfae_have 2 → 3 := by
    intro hsub
    haveI : Nontrivial R := nontrivial_of_ofList_ne_top hfs
    refine ⟨?_, ?_⟩
    · -- Build polynomial weak regularity one prefix at a time from the realized support ideals.
      rw [isWeaklyRegular_iff_Fin]
      intro i
      let i' : Fin fs.length := ⟨i.1, by simpa using i.2⟩
      have hsupport :
          ∀ e : Fin fs.length →₀ ℕ, IsSMulRegular (R ⧸ prefixSupportIdeal fs i' e) (fs[i']) := by
        intro e
        rcases exists_sublist_take_eq_prefixSupportIdeal (fs := fs) i' e with
          ⟨gs, hgs, hIdeal⟩
        have hsub' : List.Sublist (gs ++ [fs[i']]) fs :=
          append_singleton_sublist_of_sublist_take (fs := fs) i' hgs
        have hreg : IsRegular R (gs ++ [fs[i']]) := hsub (gs ++ [fs[i']]) hsub'
        have hsingle :
            IsRegular (R ⧸ (Ideal.ofList gs • (⊤ : Ideal R))) [fs[i']] :=
          -- Peel off the tail singleton from the realized prefix quotient.
          isRegular_singleton_on_prefix_quotient_of_isRegular_append_singleton (M := R)
            (rs := gs) (r := fs[i']) hreg
        have hregular :
            IsSMulRegular (R ⧸ (Ideal.ofList gs • (⊤ : Ideal R))) (fs[i']) := by
          -- A singleton regular sequence is exactly a regular element on that quotient.
          simpa using
            ((isRegular_cons_iff (M := R ⧸ (Ideal.ofList gs • (⊤ : Ideal R))) (fs[i']) []).mp
              hsingle).1
        have hIdeal' : Ideal.ofList gs • (⊤ : Ideal R) = prefixSupportIdeal fs i' e := by
          simpa [smul_eq_mul] using hIdeal
        exact
          ((Submodule.quotEquivOfEq _ _ hIdeal').isSMulRegular_congr (fs[i'])).mp hregular
      have hprefix :
          IsSMulRegular ((MvPolynomial (Fin fs.length) R) ⧸
              Ideal.span {g | ∃ j : Fin fs.length, j.1 < i'.1 ∧ g = C (fs[j]) * X j})
            (C (fs[i']) * X i') :=
        (isSMulRegular_C_mul_X_prefix_iff_forall_supportIdeal (fs := fs) i').2 hsupport
      -- Replace the set-indexed prefix ideal by the `Ideal.ofList` prefix expected by `IsRegular`.
      have hIdeal' :
          Ideal.ofList ((List.ofFn fun j : Fin fs.length ↦ C (fs[j]) * X j).take i'.1) •
              (⊤ : Ideal (MvPolynomial (Fin fs.length) R)) =
            Ideal.span {g | ∃ j : Fin fs.length, j.1 < i'.1 ∧ g = C (fs[j]) * X j} := by
        simpa [smul_eq_mul] using
          (ofList_take_C_mul_X_eq_prefix_C_mul_X_ideal (fs := fs) i')
      have htarget :
          IsSMulRegular ((MvPolynomial (Fin fs.length) R) ⧸
              (Ideal.ofList ((List.ofFn fun j : Fin fs.length ↦ C (fs[j]) * X j).take i'.1) •
                (⊤ : Ideal (MvPolynomial (Fin fs.length) R))))
            (C (fs[i']) * X i') :=
        ((Submodule.quotEquivOfEq _ _ hIdeal').isSMulRegular_congr
          (C (fs[i']) * X i')).mpr hprefix
      exact by
        simpa [i'] using htarget
    · -- The `constantCoeff` map sends every generator `C (fs[i]) * X i` to `0`, so the ideal is
      -- proper and the final quotient is nontrivial.
      intro htop
      exact ofList_C_mul_X_ne_top (R := R) (fs := fs) <| by
        simpa using htop.symm
  tfae_have 3 → 2 := by
    intro hpoly gs hsub
    haveI : Nontrivial R := nontrivial_of_ofList_ne_top hfs
    -- Follow the source proof by reverse induction on the ordered sublist itself.
    induction gs using List.reverseRecOn with
    | nil =>
        exact IsRegular.nil R R
    | append_singleton hs a ih =>
        have hindex :
            ∃ i : Fin fs.length, fs[i] = a ∧ List.Sublist hs (fs.take i.1) :=
          exists_index_of_snoc_sublist hsub
        rcases hindex with ⟨i, hia, hprefix⟩
        have hhs : IsRegular R hs := by
          exact ih (hprefix.trans (List.take_sublist _ _))
        have hweak_poly : IsWeaklyRegular (MvPolynomial (Fin fs.length) R)
            (List.ofFn fun j : Fin fs.length ↦ C (fs[j]) * X j) :=
          hpoly.toIsWeaklyRegular
        have hpoly_i :
            IsSMulRegular ((MvPolynomial (Fin fs.length) R) ⧸
                (Ideal.ofList ((List.ofFn fun j : Fin fs.length ↦ C (fs[j]) * X j).take i.1) •
                  (⊤ : Ideal (MvPolynomial (Fin fs.length) R))))
              (C (fs[i]) * X i) := by
          rw [isWeaklyRegular_iff_Fin] at hweak_poly
          let i' : Fin (List.ofFn fun j : Fin fs.length ↦ C (fs[j]) * X j).length := ⟨i.1, by
            simpa using i.2⟩
          simpa [i'] using hweak_poly i'
        have hIdeal_poly :
            Ideal.ofList ((List.ofFn fun j : Fin fs.length ↦ C (fs[j]) * X j).take i.1) •
                (⊤ : Ideal (MvPolynomial (Fin fs.length) R)) =
              Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j} := by
          simpa [smul_eq_mul] using
            (ofList_take_C_mul_X_eq_prefix_C_mul_X_ideal (fs := fs) i)
        have hprefix_regular :
            IsSMulRegular ((MvPolynomial (Fin fs.length) R) ⧸
                Ideal.span {g | ∃ j : Fin fs.length, j.1 < i.1 ∧ g = C (fs[j]) * X j})
              (C (fs[i]) * X i) := by
          exact ((Submodule.quotEquivOfEq _ _ hIdeal_poly).isSMulRegular_congr
            (C (fs[i]) * X i)).mp hpoly_i
        have ha_regular :
            IsSMulRegular (R ⧸ (Ideal.ofList hs • (⊤ : Ideal R))) a := by
          -- Convert the polynomial prefix regularity to the corresponding quotient over `R`.
          simpa [hia] using
            isSMulRegular_of_polynomial_prefix_regular_of_sublist_take
              (fs := fs) i hprefix hprefix_regular
        have hproper : Ideal.ofList (hs ++ [a]) ≠ ⊤ := by
          exact ofList_ne_top_of_sublist hfs hsub
        exact
          isRegular_append_singleton_of_regular_prefix_and_smulRegular
            hhs ha_regular hproper
  tfae_finish

end
