{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasbook.local/schemas/project-lifecycle.schema.json",
  "title": "ReasBook project lifecycle evidence",
  "type": "object",
  "required": ["schema_version", "migration_status", "projects"],
  "properties": {
    "schema_version": {"const": 1},
    "migration_status": {"enum": ["in-progress", "complete"]},
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project", "run_id", "run_result", "session_state", "project_state"
        ],
        "properties": {
          "project": {"pattern": "^(book|paper):[^:]+$"},
          "run_id": {"type": "string", "minLength": 1},
          "run_result": {
            "enum": [
              "full-pass", "repair-incomplete", "infrastructure-failure",
              "manually-degraded"
            ]
          },
          "session_state": {
            "enum": ["active", "checkpointed", "blocked", "completed"]
          },
          "project_state": {
            "enum": [
              "repair-pending", "repair-active", "repair-checkpointed",
              "repair-blocked", "full-pass"
            ]
          },
          "resume": {"type": "object"},
          "blocker": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
