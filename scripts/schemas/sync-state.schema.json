{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reasbook.local/schemas/sync-state.schema.json",
  "title": "ReasBook ALLBOOKS synchronization provenance",
  "type": "object",
  "required": ["schema_version", "source", "projects"],
  "properties": {
    "schema_version": {"const": 1},
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": {"const": "ALLBOOKS"},
        "url": {"type": "string", "minLength": 1}
      }
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "source_directory", "accepted_upstream_commit", "normalization_profile",
          "normalizer_commit", "normalized_tree_sha256", "accepted_in_reasbook_commit",
          "last_sync_report"
        ]
      }
    }
  },
  "additionalProperties": false
}
